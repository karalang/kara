// mini_esprima: esprima-python 4.0.1, the ECMAScript 2017 parser, without
// its JSX extension. The scanner, the parser with its cover grammars and
// tolerant mode, the comment handler that attaches comments to nodes,
// and the standalone tokenizer are ports of the Python package, and the
// tree is written the way its toDict() and json.dumps write it.
//
// esprima-python runs regular expression literals through Python's re
// module, so the regex checks and the compiled patterns left in the tree
// come from the mini_re port, which is included below (Python 3.13's
// re parser and compiler).
//
// The jobs come from data/jobs.tsv: each parses or tokenizes one of the
// JavaScript files under data/src/ (a small web service, a library, a
// report script, legacy scripts and snippets) and prints the tree,
// a digest of it, the tokens, an outline of the declarations, statistics,
// or the import graph of several modules.
//
// Strings are handled as code points, with lone surrogates (which
// Python's str keeps) carried in a private-use range. Identifier
// characters outside ASCII use `char.is_alphabetic()` and
// `is_alphanumeric()` with the Other_ID_Start and Other_ID_Continue
// lists, which agree with Python's tables on the letters the data uses.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    // noncharacters: U+FDD0..U+FDEF and the last two code points of each plane
    if (c >= 0xFDD0 and c <= 0xFDEF) or (c & 0xFFFE) == 0xFFFE {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn re_tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn re_tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn re_tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct ReTokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl ReTokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = re_tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if re_tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if re_tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, re_tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_re_tokenizer(s: ref Vec[i64]) -> Result[ReTokenizer, ReErr] {
    let mut t = ReTokenizer { s: s.clone(), index: 0, next: re_tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref ReTokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref ReTokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref ReTokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = re_tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref ReTokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = re_tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref ReTokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref ReTokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not re_tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if re_tok_is(ch, 41) or re_tok_is(ch, 45) or re_tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if re_tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if re_tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if re_tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref ReTokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if re_tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if re_tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(re_tok_text(this))}-{to_string(re_tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(c));
            } else {
                out.push(Node.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref ReTokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if re_tok_is(this, 63) {
        max = 1;
    } else if re_tok_is(this, 43) {
        min = 1;
    } else if re_tok_is(this, 123) {
        if re_tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref ReTokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or re_tok_is(this, 124) or re_tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if re_tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or re_tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref ReTokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if re_tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(re_tok_text(c2))}", c2.n + 2));
            }
        } else if re_tok_is(ch, 58) {
            capture = false;
        } else if re_tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if re_tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if re_tok_is(ch, 61) or re_tok_is(ch, 33) or re_tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if re_tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (re_tok_is(kind, 61) or re_tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(re_tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if re_tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if re_tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if re_tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if re_tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or re_tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(re_tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct ReParsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[ReParsed, ReErr] {
    let mut src = new_re_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(ReParsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref ReParsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref ReParsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}
// ------------------------------------------------------------- values
//
// A Python value as esprima's objects hold it. Every esprima Object
// (nodes, RegExp, SourceLocation, Position, TemplateElement.Value,
// comments, token entries, error dicts) lives in the heap as an Obj:
// its class name and its attributes in the order Python's __dict__
// keeps them, so setting a new attribute appends it, setting an old one
// keeps its place, and deleting one removes it. Lists live in the heap
// too, because esprima shares and mutates them.
//
// A JavaScript string is a Python str, which can hold lone surrogates
// (from escapes such as \uD83D). A String cannot, so a surrogate code
// unit u is kept as the private-use character U+F0000 + (u - 0xD800),
// and the JSON writer turns it back into \uXXXX.

#[derive(Clone)]
enum Val {
    Null,
    Bool(bool),
    Int(i64),
    // an int too large for i64, as its decimal digits
    Big(String),
    Float(f64),
    Str(String),
    Obj(i64),
    List(i64),
    // a compiled re.Pattern, as its repr
    Pat(String),
}

fn vs(s: Str) -> Val {
    Val.Str(s.to_string())
}

fn vstr(s: ref String) -> Val {
    Val.Str(s.clone())
}

fn vobj(n: i64) -> Val {
    if n < 0 {
        return Val.Null;
    }
    Val.Obj(n)
}

// Python truthiness.
fn truthy(h: ref Heap, v: ref Val) -> bool {
    match v {
        Val.Null => false,
        Val.Bool(b) => b,
        Val.Int(n) => n != 0,
        Val.Big(_) => true,
        Val.Float(x) => x != 0.0,
        Val.Str(s) => not s.is_empty(),
        Val.Obj(_) => true,
        Val.List(l) => h.lists[l].len() > 0,
        Val.Pat(_) => true,
    }
}

// str() of a value, for error messages.
fn py_str(v: ref Val) -> String {
    match v {
        Val.Null => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Big(s) => s.clone(),
        Val.Float(x) => f"{x}",
        Val.Str(s) => s.clone(),
        Val.Obj(_) => "<object>".to_string(),
        Val.List(_) => "[...]".to_string(),
        Val.Pat(r) => r.clone(),
    }
}

fn val_is_str(v: ref Val, s: Str) -> bool {
    match v {
        Val.Str(x) => x == s,
        _ => false,
    }
}

fn as_obj(v: ref Val) -> i64 {
    match v {
        Val.Obj(n) => n,
        _ => -1,
    }
}

fn as_list(v: ref Val) -> i64 {
    match v {
        Val.List(n) => n,
        _ => -1,
    }
}

fn as_int(v: ref Val) -> i64 {
    match v {
        Val.Int(n) => n,
        _ => 0,
    }
}

fn as_text(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => String.new(),
    }
}

struct Obj {
    cls: String,
    keys: Vec[String],
    vals: Vec[Val],
}

struct Heap {
    objs: Vec[Obj],
    lists: Vec[Vec[Val]],
}

fn new_heap() -> Heap {
    Heap { objs: Vec.new(), lists: Vec.new() }
}

impl Heap {
    fn obj(mut ref self, cls: Str) -> i64 {
        self.objs.push(Obj { cls: cls.to_string(), keys: Vec.new(), vals: Vec.new() });
        self.objs.len() - 1
    }

    fn find(ref self, n: i64, key: Str) -> i64 {
        let mut i = 0;
        while i < self.objs[n].keys.len() {
            if self.objs[n].keys[i] == key {
                return i;
            }
            i += 1;
        }
        -1
    }

    // setattr
    fn put(mut ref self, n: i64, key: Str, v: own Val) {
        let i = self.find(n, key);
        if i >= 0 {
            self.objs[n].vals[i] = v;
        } else {
            self.objs[n].keys.push(key.to_string());
            self.objs[n].vals.push(v);
        }
    }

    // getattr, with Object.__getattr__'s None for a missing attribute
    fn get(ref self, n: i64, key: Str) -> Val {
        let i = self.find(n, key);
        if i < 0 {
            return Val.Null;
        }
        self.objs[n].vals[i].clone()
    }

    fn has(ref self, n: i64, key: Str) -> bool {
        self.find(n, key) >= 0
    }

    // delattr
    fn del(mut ref self, n: i64, key: Str) {
        let i = self.find(n, key);
        if i >= 0 {
            self.objs[n].keys.remove(i);
            self.objs[n].vals.remove(i);
        }
    }

    fn text(ref self, n: i64, key: Str) -> String {
        as_text(self.get(n, key))
    }

    fn node(ref self, n: i64, key: Str) -> i64 {
        as_obj(self.get(n, key))
    }

    fn ty(ref self, n: i64) -> String {
        self.text(n, "type")
    }

    fn ty_is(ref self, n: i64, t: Str) -> bool {
        n >= 0 and self.text(n, "type") == t
    }

    fn cls_is(ref self, n: i64, c: Str) -> bool {
        n >= 0 and self.objs[n].cls == c
    }

    fn list(mut ref self, items: own Vec[Val]) -> i64 {
        self.lists.push(items);
        self.lists.len() - 1
    }

    fn list_of(mut ref self, ids: ref Vec[i64]) -> i64 {
        let mut items: Vec[Val] = Vec.new();
        for n in ids {
            items.push(vobj(n));
        }
        self.list(items)
    }

    fn len(ref self, l: i64) -> i64 {
        self.lists[l].len()
    }

    fn at(ref self, l: i64, i: i64) -> Val {
        self.lists[l][i].clone()
    }

    fn at_obj(ref self, l: i64, i: i64) -> i64 {
        as_obj(self.lists[l][i])
    }

    fn push(mut ref self, l: i64, v: own Val) {
        self.lists[l].push(v);
    }

    // the object ids in a list attribute, None items as -1
    fn kids(ref self, n: i64, key: Str) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        let l = as_list(self.get(n, key));
        if l < 0 {
            return out;
        }
        for v in self.lists[l].iter() {
            out.push(as_obj(v));
        }
        out
    }

    fn pair(mut ref self, a: i64, b: i64) -> Val {
        Val.List(self.list(vec![Val.Int(a), Val.Int(b)]))
    }

    // Position(line=, column=, offset=)
    fn position(mut ref self, line: i64, column: i64) -> i64 {
        let p = self.obj("Position");
        self.put(p, "line", Val.Int(line));
        self.put(p, "column", Val.Int(column));
        self.put(p, "offset", Val.Null);
        p
    }

    // SourceLocation(start=, end=, source=)
    fn location(mut ref self, l1: i64, c1: i64, l2: i64, c2: i64) -> i64 {
        let s = self.position(l1, c1);
        let e = self.position(l2, c2);
        let loc = self.obj("SourceLocation");
        self.put(loc, "start", Val.Obj(s));
        self.put(loc, "end", Val.Obj(e));
        self.put(loc, "source", Val.Null);
        loc
    }

    fn regexp(mut ref self, pattern: ref String, flags: ref String) -> i64 {
        let r = self.obj("RegExp");
        self.put(r, "pattern", vstr(pattern));
        self.put(r, "flags", vstr(flags));
        r
    }
}

// --------------------------------------------------------------- JSON
//
// ToDictVisitor then json.dumps(separators=(",", ":")): None attributes
// are left out (None list items are kept), attributes starting with _
// too, isAsync is written as async, and a compiled pattern (which json
// cannot encode) is written as its repr.

fn hex4(n: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(n >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// json.dumps of a str, with ensure_ascii.
fn json_str(s: ref String, out: mut ref String) {
    out.push('"');
    for c in s.chars() {
        let n = c as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if n == 8 {
            out.push_str("\\b");
        } else if n == 12 {
            out.push_str("\\f");
        } else if n < 0x20 or (n >= 0x7F and n < 0x10000) {
            out.push_str("\\u");
            out.push_str(hex4(n));
        } else if n < 0x7F {
            out.push(c);
        } else if n >= 0xF0000 and n < 0xF0800 {
            // a lone surrogate
            out.push_str("\\u");
            out.push_str(hex4(n - 0xF0000 + 0xD800));
        } else {
            let v = n - 0x10000;
            out.push_str("\\u");
            out.push_str(hex4(0xD800 + (v >> 10)));
            out.push_str("\\u");
            out.push_str(hex4(0xDC00 + (v & 0x3FF)));
        }
    }
    out.push('"');
}

fn is_inf(x: f64) -> bool {
    x > 1.7976931348623157e308 or x < -1.7976931348623157e308
}

fn json_float(x: f64) -> String {
    if is_inf(x) {
        return if x > 0.0 { "Infinity".to_string() } else { "-Infinity".to_string() };
    }
    if x != x {
        return "NaN".to_string();
    }
    f"{x}"
}

fn json_key(k: ref String) -> String {
    if k == "isAsync" {
        return "async".to_string();
    }
    if k == "allowAwait" {
        return "await".to_string();
    }
    k.clone()
}

fn write_json(h: ref Heap, v: ref Val, out: mut ref String) {
    match v {
        Val.Null => out.push_str("null"),
        Val.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        Val.Int(n) => out.push_str(f"{n}"),
        Val.Big(s) => out.push_str(s),
        Val.Float(x) => out.push_str(json_float(x)),
        Val.Str(s) => json_str(s, mut out),
        Val.Pat(r) => out.push_str(r),
        Val.List(l) => {
            out.push('[');
            let mut i = 0;
            while i < h.lists[l].len() {
                if i > 0 {
                    out.push(',');
                }
                write_json(h, h.lists[l][i], mut out);
                i += 1;
            }
            out.push(']');
        }
        Val.Obj(n) => {
            out.push('{');
            let o = ref h.objs[n];
            let mut first = true;
            let mut i = 0;
            while i < o.keys.len() {
                let skip = match o.vals[i] {
                    Val.Null => true,
                    _ => o.keys[i].starts_with("_"),
                };
                if not skip {
                    if not first {
                        out.push(',');
                    }
                    first = false;
                    json_str(json_key(o.keys[i]), mut out);
                    out.push(':');
                    write_json(h, o.vals[i], mut out);
                }
                i += 1;
            }
            out.push('}');
        }
    }
}

fn to_json(h: ref Heap, v: ref Val) -> String {
    let mut out = String.new();
    write_json(h, v, mut out);
    out
}

fn fnv(text: ref String) -> String {
    let mut h: i64 = 0x811C9DC5;
    for b in text.bytes() {
        h = ((h ^ (b as i64)) * 0x01000193) & 0xFFFFFFFF;
    }
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 28;
    while shift >= 0 {
        out.push(digits[(h >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// ------------------------------------------------------------ numbers

// int(digits, base) for a run of digits of any length, as a value.
fn int_value(digits: ref Vec[char], base: i64) -> Val {
    // little-endian base 10^9 limbs
    let mut limbs: Vec[i64] = vec![0];
    for c in digits {
        let d = hex_value(c);
        let mut carry = d;
        let mut i = 0;
        while i < limbs.len() {
            let x = limbs[i] * base + carry;
            limbs[i] = x % 1000000000;
            carry = x / 1000000000;
            i += 1;
        }
        if carry > 0 {
            limbs.push(carry);
        }
    }
    limbs_value(limbs)
}

fn limbs_value(limbs: ref Vec[i64]) -> Val {
    let mut k = limbs.len() - 1;
    while k > 0 and limbs[k] == 0 {
        k -= 1;
    }
    if k <= 1 {
        let v = if k == 1 { limbs[1] * 1000000000 + limbs[0] } else { limbs[0] };
        return Val.Int(v);
    }
    if k == 2 and limbs[2] < 9 {
        return Val.Int(limbs[2] * 1000000000000000000 + limbs[1] * 1000000000 + limbs[0]);
    }
    let mut s = f"{limbs[k]}";
    while k > 0 {
        k -= 1;
        let part = f"{limbs[k]}";
        let mut pad = 9 - part.len();
        while pad > 0 {
            s.push('0');
            pad -= 1;
        }
        s.push_str(part);
    }
    Val.Big(s)
}

// int(x) for a float that is an integer: exact, however large.
fn float_int(x: f64) -> Val {
    if x < 9.0e18 {
        return Val.Int(x as i64);
    }
    // x is m * 2**e with m below 2**53; halving is exact
    let mut m = x;
    let mut e = 0;
    while m >= 9007199254740992.0 {
        m = m / 2.0;
        e += 1;
    }
    let mut limbs: Vec[i64] = Vec.new();
    let mut n = m as i64;
    while n > 0 {
        limbs.push(n % 1000000000);
        n = n / 1000000000;
    }
    while e > 0 {
        let mut carry = 0;
        let mut i = 0;
        while i < limbs.len() {
            let v = limbs[i] * 2 + carry;
            limbs[i] = v % 1000000000;
            carry = v / 1000000000;
            i += 1;
        }
        if carry > 0 {
            limbs.push(carry);
        }
        e -= 1;
    }
    limbs_value(limbs)
}

// float(text), then int() when it is a whole number, as the scanner does.
fn decimal_value(text: ref String) -> Val {
    let x = match f64.parse(text.as_str()) {
        Ok(v) => v,
        Err(_) => 0.0,
    };
    if is_inf(x) or x != x {
        return Val.Float(x);
    }
    if x == x.floor() {
        return float_int(x);
    }
    Val.Float(x)
}
// --------------------------------------------------------- characters
//
// character.py builds its identifier sets from unicodedata. ASCII is
// exact here; elsewhere a letter is `char.is_alphabetic()` and a digit or
// mark `char.is_alphanumeric()`, plus the Other_ID_Start and
// Other_ID_Continue lists character.py spells out.

fn is_white_space(c: char) -> bool {
    let n = c as i64;
    n == 0x09 or n == 0x0B or n == 0x0C or n == 0x20 or n == 0xA0 or n == 0x1680 or n == 0x180E
        or (n >= 0x2000 and n <= 0x200A) or n == 0x202F or n == 0x205F or n == 0x3000 or n == 0xFEFF
}

fn is_line_terminator(c: char) -> bool {
    let n = c as i64;
    n == 0x0A or n == 0x0D or n == 0x2028 or n == 0x2029
}

fn other_id_start(n: i64) -> bool {
    n == 0x1885 or n == 0x1886 or n == 0x2118 or n == 0x212E or n == 0x309B or n == 0x309C
        or n == 0x08B3 or n == 0x0AF9 or n == 0x13F8 or n == 0x9FCD or n == 0xAB60 or n == 0x10CC0
        or n == 0x108E0 or n == 0x2B820 or n == 0x1C80 or n == 0x104DB or n == 0x1E922
        or n == 0x1EE00 or n == 0x1EE06 or n == 0x1EE0A
}

fn other_id_continue(n: i64) -> bool {
    n == 0xB7 or n == 0x0387 or (n >= 0x1369 and n <= 0x1371) or n == 0x19DA or n == 0x08E3
        or n == 0xA69E or n == 0x11730 or n == 0x08D4 or n == 0x1DFB or n == 0xA8C5 or n == 0x11450
        or n == 0x1EE03 or n == 0x1EE0B
}

fn is_identifier_start(c: char) -> bool {
    let n = c as i64;
    if n < 0x80 {
        return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '$' or c == '_' or c == '\\';
    }
    if n >= 0xF0000 {
        return false;
    }
    c.is_alphabetic() or other_id_start(n)
}

fn is_identifier_part(c: char) -> bool {
    let n = c as i64;
    if n < 0x80 {
        return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '$'
            or c == '_' or c == '\\';
    }
    if n >= 0xF0000 {
        return false;
    }
    c.is_alphanumeric() or n == 0x200C or n == 0x200D or other_id_start(n) or other_id_continue(n)
        or n == 0x203F or n == 0x2040 or n == 0x2054 or n == 0xFE33 or n == 0xFE34
        or (n >= 0xFE4D and n <= 0xFE4F) or n == 0xFF3F
}

fn is_decimal_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_hex_digit(c: char) -> bool {
    (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn is_octal_digit(c: char) -> bool {
    c >= '0' and c <= '7'
}

fn hex_value(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        return (c as i64) - 48;
    }
    if c >= 'a' and c <= 'f' {
        return (c as i64) - 87;
    }
    (c as i64) - 55
}

// chr(), with a surrogate kept as its private-use stand-in.
fn py_chr(cp: i64) -> char {
    let n = if cp >= 0xD800 and cp <= 0xDFFF { cp - 0xD800 + 0xF0000 } else { cp };
    match char.try_from(n as u32) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

// A str's code points, surrogates included.
fn code_points(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        let n = c as i64;
        if n >= 0xF0000 and n < 0xF0800 {
            out.push(n - 0xF0000 + 0xD800);
        } else {
            out.push(n);
        }
    }
    out
}

fn char_count(s: ref String) -> i64 {
    s.chars().count()
}

fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}

// ------------------------------------------------------------- errors

#[derive(Clone)]
struct JsErr {
    message: String,
    index: i64,
    line: i64,
    column: i64,
}

// What a parse can raise: esprima's Error, or another Python exception
// (`Type: message`) that esprima lets through.
enum Fail {
    Js(JsErr),
    Crash(String),
}

fn index_error() -> Fail {
    Fail.Crash("IndexError: list index out of range".to_string())
}

// Error.toDict(): the attributes that are not None, with the message as
// toString() gives it.
fn error_obj(h: mut ref Heap, e: ref JsErr) -> i64 {
    let d = h.obj("dict");
    h.put(d, "message", Val.Str(f"Error: {e.message}"));
    h.put(d, "index", Val.Int(e.index));
    h.put(d, "lineNumber", Val.Int(e.line));
    h.put(d, "column", Val.Int(e.column));
    d
}

struct ErrorHandler {
    errors: Vec[JsErr],
    tolerant: bool,
}

impl ErrorHandler {
    fn create_error(ref self, index: i64, line: i64, col: i64, description: ref String) -> JsErr {
        JsErr { message: f"Line {line}: {description}", index: index, line: line, column: col }
    }

    fn tolerate(mut ref self, e: own JsErr) -> Result[(), Fail] {
        if self.tolerant {
            self.errors.push(e);
            return Ok(());
        }
        Err(Fail.Js(e))
    }

    fn tolerate_error(mut ref self, index: i64, line: i64, col: i64, description: ref String) -> Result[(), Fail] {
        let e = self.create_error(index, line, col, description);
        self.tolerate(e)
    }
}

// utils.format: each %N in turn takes the next argument.
fn fmt_msg(text: Str, args: ref Vec[String]) -> String {
    let cs: Vec[char] = text.chars().collect();
    let mut out = String.new();
    let mut k = 0;
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '%' and i + 1 < cs.len() and is_decimal_digit(cs[i + 1]) {
            if k < args.len() {
                out.push_str(args[k]);
            }
            k += 1;
            i += 2;
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

// ------------------------------------------------------------ scanner

const T_BOOLEAN: i64 = 1;
const T_EOF: i64 = 2;
const T_IDENTIFIER: i64 = 3;
const T_KEYWORD: i64 = 4;
const T_NULL: i64 = 5;
const T_NUMERIC: i64 = 6;
const T_PUNCTUATOR: i64 = 7;
const T_STRING: i64 = 8;
const T_REGEX: i64 = 9;
const T_TEMPLATE: i64 = 10;

fn token_name(t: i64) -> Str {
    if t == T_BOOLEAN {
        return "Boolean";
    }
    if t == T_EOF {
        return "<end>";
    }
    if t == T_IDENTIFIER {
        return "Identifier";
    }
    if t == T_KEYWORD {
        return "Keyword";
    }
    if t == T_NULL {
        return "Null";
    }
    if t == T_NUMERIC {
        return "Numeric";
    }
    if t == T_PUNCTUATOR {
        return "Punctuator";
    }
    if t == T_STRING {
        return "String";
    }
    if t == T_REGEX {
        return "RegularExpression";
    }
    "Template"
}

#[derive(Clone)]
struct RawToken {
    kind: i64,
    value: Val,
    pattern: String,
    flags: String,
    // the compiled pattern's repr; None when it did not compile
    regex: Option[String],
    octal: bool,
    cooked: String,
    head: bool,
    tail: bool,
    line: i64,
    line_start: i64,
    start: i64,
    end: i64,
}

fn raw_token(kind: i64, value: own Val, line: i64, line_start: i64, start: i64, end: i64) -> RawToken {
    RawToken {
        kind: kind, value: value, pattern: String.new(), flags: String.new(), regex: None, octal: false,
        cooked: String.new(), head: false, tail: false, line: line, line_start: line_start, start: start,
        end: end,
    }
}

fn tok_is(t: ref RawToken, s: Str) -> bool {
    val_is_str(t.value, s)
}

fn tok_text(t: ref RawToken) -> String {
    as_text(t.value)
}

// A comment the scanner saw: slice is its text, range the whole of it.
#[derive(Clone)]
struct ScanComment {
    multi_line: bool,
    slice0: i64,
    slice1: i64,
    range0: i64,
    range1: i64,
    l1: i64,
    c1: i64,
    l2: i64,
    c2: i64,
}

#[derive(Copy, Clone)]
struct ScanState {
    index: i64,
    line: i64,
    line_start: i64,
}

fn is_future_reserved(id: ref String) -> bool {
    id == "enum" or id == "export" or id == "import" or id == "super"
}

fn is_strict_reserved(id: ref String) -> bool {
    id == "implements" or id == "interface" or id == "package" or id == "private" or id == "protected"
        or id == "public" or id == "static" or id == "yield" or id == "let"
}

fn is_restricted(id: ref String) -> bool {
    id == "eval" or id == "arguments"
}

fn is_keyword(id: ref String) -> bool {
    let kws = vec![
        "if", "in", "do", "var", "for", "new", "try", "let", "this", "else", "case", "void", "with", "enum",
        "while", "break", "catch", "throw", "const", "yield", "class", "super", "return", "typeof",
        "delete", "switch", "export", "import", "default", "finally", "extends", "function", "continue",
        "debugger", "instanceof",
    ];
    for k in kws {
        if id == k {
            return true;
        }
    }
    false
}

struct Scanner {
    source: Vec[char],
    eh: ErrorHandler,
    track_comment: bool,
    is_module: bool,
    length: i64,
    index: i64,
    line_number: i64,
    line_start: i64,
    curly_stack: Vec[String],
}

fn new_scanner(code: ref String, tolerant: bool) -> Scanner {
    let mut source: Vec[char] = code.chars().collect();
    let length = source.len();
    source.push('\0');
    Scanner {
        source: source, eh: ErrorHandler { errors: Vec.new(), tolerant: tolerant }, track_comment: false,
        is_module: false, length: length, index: 0, line_number: if length > 0 { 1 } else { 0 },
        line_start: 0, curly_stack: Vec.new(),
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> char {
        if i < 0 or i >= self.source.len() {
            return '\0';
        }
        self.source[i]
    }

    // source[a:b]
    fn slice(ref self, a: i64, b: i64) -> String {
        let mut out = String.new();
        let mut i = if a < 0 { 0 } else { a };
        let end = if b > self.source.len() { self.source.len() } else { b };
        while i < end {
            out.push(self.source[i]);
            i += 1;
        }
        out
    }

    fn save_state(ref self) -> ScanState {
        ScanState { index: self.index, line: self.line_number, line_start: self.line_start }
    }

    fn restore_state(mut ref self, s: ScanState) {
        self.index = s.index;
        self.line_number = s.line;
        self.line_start = s.line_start;
    }

    fn eof(ref self) -> bool {
        self.index >= self.length
    }

    fn unexpected(ref self, message: Str) -> Fail {
        Fail.Js(self.eh.create_error(self.index, self.line_number, self.index - self.line_start + 1, message.to_string()))
    }

    fn tolerate_unexpected(mut ref self, message: Str) -> Result[(), Fail] {
        let (i, l, c) = (self.index, self.line_number, self.index - self.line_start + 1);
        self.eh.tolerate_error(i, l, c, message.to_string())
    }

    // https://tc39.github.io/ecma262/#sec-comments

    fn skip_single_line_comment(mut ref self, offset: i64) -> Vec[ScanComment] {
        let mut comments: Vec[ScanComment] = Vec.new();
        let start = self.index - offset;
        let l1 = self.line_number;
        let c1 = self.index - self.line_start - offset;
        while not self.eof() {
            let ch = self.source[self.index];
            self.index += 1;
            if is_line_terminator(ch) {
                if self.track_comment {
                    comments.push(ScanComment {
                        multi_line: false, slice0: start + offset, slice1: self.index - 1, range0: start,
                        range1: self.index - 1, l1: l1, c1: c1, l2: self.line_number,
                        c2: self.index - self.line_start - 1,
                    });
                }
                if ch == '\r' and self.at(self.index) == '\n' {
                    self.index += 1;
                }
                self.line_number += 1;
                self.line_start = self.index;
                return comments;
            }
        }
        if self.track_comment {
            comments.push(ScanComment {
                multi_line: false, slice0: start + offset, slice1: self.index, range0: start, range1: self.index,
                l1: l1, c1: c1, l2: self.line_number, c2: self.index - self.line_start,
            });
        }
        comments
    }

    fn skip_multi_line_comment(mut ref self) -> Result[Vec[ScanComment], Fail] {
        let mut comments: Vec[ScanComment] = Vec.new();
        let start = self.index - 2;
        let l1 = self.line_number;
        let c1 = self.index - self.line_start - 2;
        while not self.eof() {
            let ch = self.source[self.index];
            if is_line_terminator(ch) {
                if ch == '\r' and self.at(self.index + 1) == '\n' {
                    self.index += 1;
                }
                self.line_number += 1;
                self.index += 1;
                self.line_start = self.index;
            } else if ch == '*' {
                // Block comment ends with '*/'.
                if self.at(self.index + 1) == '/' {
                    self.index += 2;
                    if self.track_comment {
                        comments.push(ScanComment {
                            multi_line: true, slice0: start + 2, slice1: self.index - 2, range0: start,
                            range1: self.index, l1: l1, c1: c1, l2: self.line_number,
                            c2: self.index - self.line_start,
                        });
                    }
                    return Ok(comments);
                }
                self.index += 1;
            } else {
                self.index += 1;
            }
        }
        // Ran off the end of the file - the whole thing is a comment
        if self.track_comment {
            comments.push(ScanComment {
                multi_line: true, slice0: start + 2, slice1: self.index, range0: start, range1: self.index,
                l1: l1, c1: c1, l2: self.line_number, c2: self.index - self.line_start,
            });
        }
        self.tolerate_unexpected("Unexpected token ILLEGAL")?;
        Ok(comments)
    }

    fn scan_comments(mut ref self) -> Result[Vec[ScanComment], Fail] {
        let mut comments: Vec[ScanComment] = Vec.new();
        let mut start = self.index == 0;
        while not self.eof() {
            let ch = self.source[self.index];
            if is_white_space(ch) {
                self.index += 1;
            } else if is_line_terminator(ch) {
                self.index += 1;
                if ch == '\r' and self.at(self.index) == '\n' {
                    self.index += 1;
                }
                self.line_number += 1;
                self.line_start = self.index;
                start = true;
            } else if ch == '/' {
                let next = self.at(self.index + 1);
                if next == '/' {
                    self.index += 2;
                    let c = self.skip_single_line_comment(2);
                    if self.track_comment {
                        comments.extend(c);
                    }
                    start = true;
                } else if next == '*' {
                    self.index += 2;
                    let c = self.skip_multi_line_comment()?;
                    if self.track_comment {
                        comments.extend(c);
                    }
                } else {
                    break;
                }
            } else if start and ch == '-' {
                if self.at(self.index + 1) == '-' and self.at(self.index + 2) == '>' {
                    // '-->' is a single-line comment
                    self.index += 3;
                    let c = self.skip_single_line_comment(3);
                    if self.track_comment {
                        comments.extend(c);
                    }
                } else {
                    break;
                }
            } else if ch == '<' and not self.is_module {
                if self.at(self.index + 1) == '!' and self.at(self.index + 2) == '-' and self.at(self.index + 3) == '-' {
                    self.index += 4;
                    let c = self.skip_single_line_comment(4);
                    if self.track_comment {
                        comments.extend(c);
                    }
                } else {
                    break;
                }
            } else {
                break;
            }
        }
        Ok(comments)
    }

    fn scan_hex_escape(mut ref self, prefix: char) -> Option[char] {
        let len = if prefix == 'u' { 4 } else { 2 };
        let mut code = 0;
        let mut i = 0;
        while i < len {
            if not self.eof() and is_hex_digit(self.source[self.index]) {
                let ch = self.source[self.index];
                self.index += 1;
                code = code * 16 + hex_value(ch);
            } else {
                return None;
            }
            i += 1;
        }
        Some(py_chr(code))
    }

    fn scan_unicode_code_point_escape(mut ref self) -> Result[char, Fail] {
        let mut ch = self.source[self.index];
        let mut code = 0;
        // At least, one hex digit is required.
        if ch == '}' {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        while not self.eof() {
            ch = self.source[self.index];
            self.index += 1;
            if not is_hex_digit(ch) {
                break;
            }
            code = code * 16 + hex_value(ch);
            if code > 0x7FFFFFFF {
                code = 0x7FFFFFFF;
            }
        }
        if code > 0x10FFFF or ch != '}' {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        Ok(py_chr(code))
    }

    fn get_identifier(mut ref self) -> Result[String, Fail] {
        let start = self.index;
        self.index += 1;
        while not self.eof() {
            let ch = self.source[self.index];
            if ch == '\\' {
                // Backslash (U+005C) marks Unicode escape sequence.
                self.index = start;
                return self.get_complex_identifier();
            }
            // (A str from a file holds no surrogates, so the surrogate-pair
            // branch never runs.)
            if is_identifier_part(ch) {
                self.index += 1;
            } else {
                break;
            }
        }
        Ok(self.slice(start, self.index))
    }

    fn escaped_char(mut ref self, part: bool) -> Result[char, Fail] {
        if self.at(self.index) != 'u' {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        self.index += 1;
        if self.at(self.index) == '{' {
            self.index += 1;
            return self.scan_unicode_code_point_escape();
        }
        match self.scan_hex_escape('u') {
            Some(c) => {
                let ok = if part { is_identifier_part(c) } else { is_identifier_start(c) };
                if c == '\\' or not ok {
                    return Err(self.unexpected("Unexpected token ILLEGAL"));
                }
                Ok(c)
            }
            None => Err(self.unexpected("Unexpected token ILLEGAL")),
        }
    }

    fn get_complex_identifier(mut ref self) -> Result[String, Fail] {
        let first = self.source[self.index];
        let mut id = String.new();
        self.index += 1;
        // '\u' (U+005C, U+0075) denotes an escaped character.
        if first == '\\' {
            id.push(self.escaped_char(false)?);
        } else {
            id.push(first);
        }
        while not self.eof() {
            let ch = self.source[self.index];
            if not is_identifier_part(ch) {
                break;
            }
            self.index += 1;
            if ch == '\\' {
                id.push(self.escaped_char(true)?);
            } else {
                id.push(ch);
            }
        }
        Ok(id)
    }

    fn scan_identifier(mut ref self) -> Result[RawToken, Fail] {
        let start = self.index;
        // Backslash (U+005C) starts an escaped character.
        let id = if self.source[start] == '\\' { self.get_complex_identifier()? } else { self.get_identifier()? };
        // There is no keyword or literal with only one character.
        // Thus, it must be an identifier.
        let n = char_count(id);
        let kind = if n == 1 {
            T_IDENTIFIER
        } else if is_keyword(id) {
            T_KEYWORD
        } else if id == "null" {
            T_NULL
        } else if id == "true" or id == "false" {
            T_BOOLEAN
        } else {
            T_IDENTIFIER
        };
        if kind != T_IDENTIFIER and start + n != self.index {
            let restore = self.index;
            self.index = start;
            self.tolerate_unexpected("Keyword must not contain escaped characters")?;
            self.index = restore;
        }
        Ok(raw_token(kind, Val.Str(id), self.line_number, self.line_start, start, self.index))
    }

    // https://tc39.github.io/ecma262/#sec-punctuators

    fn scan_punctuator(mut ref self) -> Result[RawToken, Fail] {
        let start = self.index;
        let c = self.source[self.index];
        let mut s = String.new();
        s.push(c);
        if c == '(' or c == '{' {
            if c == '{' {
                self.curly_stack.push("{".to_string());
            }
            self.index += 1;
        } else if c == '.' {
            self.index += 1;
            if self.at(self.index) == '.' and self.at(self.index + 1) == '.' {
                // Spread operator: ...
                self.index += 2;
                s = "...".to_string();
            }
        } else if c == '}' {
            self.index += 1;
            if self.curly_stack.len() > 0 {
                self.curly_stack.pop();
            }
        } else if c == ')' or c == ';' or c == ',' or c == '[' or c == ']' or c == ':' or c == '?' or c == '~' {
            self.index += 1;
        } else {
            // 4-character punctuator.
            s = self.slice(self.index, self.index + 4);
            if s == ">>>=" {
                self.index += 4;
            } else {
                // 3-character punctuators.
                s = self.slice(self.index, self.index + 3);
                if s == "===" or s == "!==" or s == ">>>" or s == "<<=" or s == ">>=" or s == "**=" {
                    self.index += 3;
                } else {
                    // 2-character punctuators.
                    s = self.slice(self.index, self.index + 2);
                    let twos = vec![
                        "&&", "||", "==", "!=", "+=", "-=", "*=", "/=", "++", "--", "<<", ">>", "&=", "|=", "^=",
                        "%=", "<=", ">=", "=>", "**",
                    ];
                    let mut hit = false;
                    for t in twos {
                        if s == t {
                            hit = true;
                        }
                    }
                    if hit {
                        self.index += 2;
                    } else {
                        // 1-character punctuators.
                        s = String.new();
                        s.push(c);
                        if "<>=!+-*%&|^/".contains(s.as_str()) {
                            self.index += 1;
                        }
                    }
                }
            }
        }
        if self.index == start {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        Ok(raw_token(T_PUNCTUATOR, Val.Str(s), self.line_number, self.line_start, start, self.index))
    }

    // https://tc39.github.io/ecma262/#sec-literals-numeric-literals

    fn scan_hex_literal(mut ref self, start: i64) -> Result[RawToken, Fail] {
        let mut num: Vec[char] = Vec.new();
        while not self.eof() {
            if not is_hex_digit(self.source[self.index]) {
                break;
            }
            num.push(self.source[self.index]);
            self.index += 1;
        }
        if num.len() == 0 {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        if is_identifier_start(self.at(self.index)) {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        Ok(raw_token(T_NUMERIC, int_value(num, 16), self.line_number, self.line_start, start, self.index))
    }

    fn scan_binary_literal(mut ref self, start: i64) -> Result[RawToken, Fail] {
        let mut num: Vec[char] = Vec.new();
        while not self.eof() {
            let ch = self.source[self.index];
            if ch != '0' and ch != '1' {
                break;
            }
            num.push(ch);
            self.index += 1;
        }
        if num.len() == 0 {
            // only 0b or 0B
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        if not self.eof() {
            let ch = self.source[self.index];
            if is_identifier_start(ch) or is_decimal_digit(ch) {
                return Err(self.unexpected("Unexpected token ILLEGAL"));
            }
        }
        Ok(raw_token(T_NUMERIC, int_value(num, 2), self.line_number, self.line_start, start, self.index))
    }

    fn scan_octal_literal(mut ref self, prefix: char, start: i64) -> Result[RawToken, Fail] {
        let mut num: Vec[char] = Vec.new();
        let mut octal = false;
        if is_octal_digit(prefix) {
            octal = true;
            num.push('0');
            num.push(self.source[self.index]);
        }
        self.index += 1;
        while not self.eof() {
            if not is_octal_digit(self.source[self.index]) {
                break;
            }
            num.push(self.source[self.index]);
            self.index += 1;
        }
        if not octal and num.len() == 0 {
            // only 0o or 0O
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        if is_identifier_start(self.at(self.index)) or is_decimal_digit(self.at(self.index)) {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        let mut t = raw_token(T_NUMERIC, int_value(num, 8), self.line_number, self.line_start, start, self.index);
        t.octal = octal;
        Ok(t)
    }

    fn is_implicit_octal_literal(ref self) -> bool {
        // Implicit octal, unless there is a non-octal digit.
        // (Annex B.1.1 on Numeric Literals)
        let mut i = self.index + 1;
        while i < self.length {
            let ch = self.source[i];
            if ch == '8' or ch == '9' {
                return false;
            }
            if not is_octal_digit(ch) {
                return true;
            }
            i += 1;
        }
        true
    }

    fn scan_numeric_literal(mut ref self) -> Result[RawToken, Fail] {
        let start = self.index;
        let mut ch = self.source[start];
        let mut num = String.new();
        if ch != '.' {
            num.push(self.source[self.index]);
            self.index += 1;
            ch = self.at(self.index);
            // Hex number starts with '0x'.
            // Octal number starts with '0'.
            // Octal number in ES6 starts with '0o'.
            // Binary number in ES6 starts with '0b'.
            if num == "0" {
                if ch == 'x' or ch == 'X' {
                    self.index += 1;
                    return self.scan_hex_literal(start);
                }
                if ch == 'b' or ch == 'B' {
                    self.index += 1;
                    return self.scan_binary_literal(start);
                }
                if ch == 'o' or ch == 'O' {
                    return self.scan_octal_literal(ch, start);
                }
                if is_octal_digit(ch) {
                    if self.is_implicit_octal_literal() {
                        return self.scan_octal_literal(ch, start);
                    }
                }
            }
            while is_decimal_digit(self.at(self.index)) {
                num.push(self.source[self.index]);
                self.index += 1;
            }
            ch = self.at(self.index);
        }
        if ch == '.' {
            num.push('.');
            self.index += 1;
            while is_decimal_digit(self.at(self.index)) {
                num.push(self.source[self.index]);
                self.index += 1;
            }
            ch = self.at(self.index);
        }
        if ch == 'e' or ch == 'E' {
            num.push(ch);
            self.index += 1;
            ch = self.at(self.index);
            if ch == '+' or ch == '-' {
                num.push(ch);
                self.index += 1;
            }
            if is_decimal_digit(self.at(self.index)) {
                while is_decimal_digit(self.at(self.index)) {
                    num.push(self.source[self.index]);
                    self.index += 1;
                }
            } else {
                return Err(self.unexpected("Unexpected token ILLEGAL"));
            }
        }
        if is_identifier_start(self.at(self.index)) {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        Ok(raw_token(T_NUMERIC, decimal_value(num), self.line_number, self.line_start, start, self.index))
    }

    fn octal_to_decimal(mut ref self, ch: char) -> (bool, i64) {
        // \0 is not octal escape sequence
        let mut octal = ch != '0';
        let mut code = hex_value(ch);
        if not self.eof() and is_octal_digit(self.source[self.index]) {
            octal = true;
            code = code * 8 + hex_value(self.source[self.index]);
            self.index += 1;
            // 3 digits are only allowed when string starts
            // with 0, 1, 2, 3
            if ch >= '0' and ch <= '3' and not self.eof() and is_octal_digit(self.source[self.index]) {
                code = code * 8 + hex_value(self.source[self.index]);
                self.index += 1;
            }
        }
        (octal, code)
    }

    // https://tc39.github.io/ecma262/#sec-literals-string-literals

    fn scan_string_literal(mut ref self) -> Result[RawToken, Fail] {
        let start = self.index;
        let mut quote = self.source[start];
        let mut closed = false;
        self.index += 1;
        let mut octal = false;
        let mut s = String.new();
        while not self.eof() {
            let mut ch = self.source[self.index];
            self.index += 1;
            if ch == quote {
                closed = true;
                break;
            } else if ch == '\\' {
                ch = self.at(self.index);
                self.index += 1;
                if not is_line_terminator(ch) {
                    if ch == 'u' {
                        if self.at(self.index) == '{' {
                            self.index += 1;
                            s.push(self.scan_unicode_code_point_escape()?);
                        } else {
                            match self.scan_hex_escape(ch) {
                                Some(c) => s.push(c),
                                None => return Err(self.unexpected("Unexpected token ILLEGAL")),
                            }
                        }
                    } else if ch == 'x' {
                        match self.scan_hex_escape(ch) {
                            Some(c) => s.push(c),
                            None => return Err(self.unexpected("Invalid hexadecimal escape sequence")),
                        }
                    } else if ch == 'n' {
                        s.push('\n');
                    } else if ch == 'r' {
                        s.push('\r');
                    } else if ch == 't' {
                        s.push('\t');
                    } else if ch == 'b' {
                        s.push(py_chr(8));
                    } else if ch == 'f' {
                        s.push(py_chr(12));
                    } else if ch == 'v' {
                        s.push(py_chr(11));
                    } else if ch == '8' or ch == '9' {
                        s.push(ch);
                        self.tolerate_unexpected("Unexpected token ILLEGAL")?;
                    } else if is_octal_digit(ch) {
                        let (o, code) = self.octal_to_decimal(ch);
                        octal = o or octal;
                        s.push(py_chr(code));
                    } else {
                        s.push(ch);
                    }
                } else {
                    self.line_number += 1;
                    if ch == '\r' and self.at(self.index) == '\n' {
                        self.index += 1;
                    }
                    self.line_start = self.index;
                }
            } else if is_line_terminator(ch) {
                break;
            } else {
                s.push(ch);
            }
        }
        if not closed {
            self.index = start;
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        let mut t = raw_token(T_STRING, Val.Str(s), self.line_number, self.line_start, start, self.index);
        t.octal = octal;
        Ok(t)
    }

    // https://tc39.github.io/ecma262/#sec-template-literal-lexical-components

    fn scan_template(mut ref self) -> Result[RawToken, Fail] {
        let mut cooked = String.new();
        let mut terminated = false;
        let start = self.index;
        let head = self.source[start] == '`';
        let mut tail = false;
        let mut raw_offset = 2;
        self.index += 1;
        while not self.eof() {
            let mut ch = self.source[self.index];
            self.index += 1;
            if ch == '`' {
                raw_offset = 1;
                tail = true;
                terminated = true;
                break;
            } else if ch == '$' {
                if self.at(self.index) == '{' {
                    self.curly_stack.push("${".to_string());
                    self.index += 1;
                    terminated = true;
                    break;
                }
                cooked.push(ch);
            } else if ch == '\\' {
                ch = self.at(self.index);
                self.index += 1;
                if not is_line_terminator(ch) {
                    if ch == 'n' {
                        cooked.push('\n');
                    } else if ch == 'r' {
                        cooked.push('\r');
                    } else if ch == 't' {
                        cooked.push('\t');
                    } else if ch == 'u' {
                        if self.at(self.index) == '{' {
                            self.index += 1;
                            cooked.push(self.scan_unicode_code_point_escape()?);
                        } else {
                            let restore = self.index;
                            match self.scan_hex_escape(ch) {
                                Some(c) => cooked.push(c),
                                None => {
                                    self.index = restore;
                                    cooked.push(ch);
                                }
                            }
                        }
                    } else if ch == 'x' {
                        match self.scan_hex_escape(ch) {
                            Some(c) => cooked.push(c),
                            None => return Err(self.unexpected("Invalid hexadecimal escape sequence")),
                        }
                    } else if ch == 'b' {
                        cooked.push(py_chr(8));
                    } else if ch == 'f' {
                        cooked.push(py_chr(12));
                    } else if ch == 'v' {
                        cooked.push(py_chr(11));
                    } else if ch == '0' {
                        if is_decimal_digit(self.at(self.index)) {
                            // Illegal: \01 \02 and so on
                            return Err(self.unexpected("Octal literals are not allowed in template strings."));
                        }
                        cooked.push('\0');
                    } else if is_octal_digit(ch) {
                        // Illegal: \1 \2
                        return Err(self.unexpected("Octal literals are not allowed in template strings."));
                    } else {
                        cooked.push(ch);
                    }
                } else {
                    self.line_number += 1;
                    if ch == '\r' and self.at(self.index) == '\n' {
                        self.index += 1;
                    }
                    self.line_start = self.index;
                }
            } else if is_line_terminator(ch) {
                self.line_number += 1;
                if ch == '\r' and self.at(self.index) == '\n' {
                    self.index += 1;
                }
                self.line_start = self.index;
                cooked.push('\n');
            } else {
                cooked.push(ch);
            }
        }
        if not terminated {
            return Err(self.unexpected("Unexpected token ILLEGAL"));
        }
        if not head {
            if self.curly_stack.len() > 0 {
                self.curly_stack.pop();
            }
        }
        let value = self.slice(start + 1, self.index - raw_offset);
        let mut t = raw_token(T_TEMPLATE, Val.Str(value), self.line_number, self.line_start, start, self.index);
        t.cooked = cooked;
        t.head = head;
        t.tail = tail;
        Ok(t)
    }

    // https://tc39.github.io/ecma262/#sec-literals-regular-expression-literals

    // re.compile(pattern, flags) on the pattern made Python-friendly, as
    // the compiled pattern's repr; None (after tolerating the error) when
    // Python's re refuses it.
    fn test_reg_exp(mut ref self, pattern: ref String, flags: ref String) -> Result[Option[String], Fail] {
        // Replace every Unicode escape sequence with the equivalent BMP
        // character, or U+FFFF for an astral one (re.sub over
        // \\u\{([0-9a-fA-F]+)\}|\\u([a-fA-F0-9]{4}), left to right).
        let p = code_points(pattern);
        let mut q: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < p.len() {
            let mut matched = -1;
            let mut code = 0;
            if p[i] == 92 and i + 1 < p.len() and p[i + 1] == 117 {
                if i + 2 < p.len() and p[i + 2] == 123 {
                    let mut j = i + 3;
                    while j < p.len() and is_hex_cp(p[j]) {
                        code = code * 16 + hex_cp(p[j]);
                        if code > 0x7FFFFFFF {
                            code = 0x7FFFFFFF;
                        }
                        j += 1;
                    }
                    if j > i + 3 and j < p.len() and p[j] == 125 {
                        matched = j + 1;
                    }
                }
                if matched < 0 and i + 5 < p.len() and is_hex_cp(p[i + 2]) and is_hex_cp(p[i + 3])
                    and is_hex_cp(p[i + 4]) and is_hex_cp(p[i + 5]) {
                    code = hex_cp(p[i + 2]) * 4096 + hex_cp(p[i + 3]) * 256 + hex_cp(p[i + 4]) * 16 + hex_cp(p[i + 5]);
                    matched = i + 6;
                }
            }
            if matched < 0 {
                q.push(p[i]);
                i += 1;
            } else {
                if code > 0x10FFFF {
                    self.tolerate_unexpected("Invalid regular expression")?;
                    q.push(0xFFFF);
                } else if code <= 0xFFFF {
                    q.push(code);
                } else {
                    q.push(0xFFFF);
                }
                i = matched;
            }
        }
        // Replace each paired surrogate with a single ASCII symbol to
        // avoid throwing on regular expressions that are only valid in
        // combination with the "u" flag.
        let mut r: Vec[i64] = Vec.new();
        i = 0;
        while i < q.len() {
            if q[i] >= 0xD800 and q[i] <= 0xDBFF and i + 1 < q.len() and q[i + 1] >= 0xDC00 and q[i + 1] <= 0xDFFF {
                r.push(0xFFFF);
                i += 2;
            } else {
                r.push(q[i]);
                i += 1;
            }
        }
        let pyflags = if flags.contains("m") { flag_m() } else if flags.contains("i") { flag_i() } else { 0 };
        match compiled_flags(r, pyflags) {
            Ok(f) => Ok(Some(pattern_repr(r, f))),
            Err(_) => {
                self.tolerate_unexpected("Invalid regular expression")?;
                Ok(None)
            }
        }
    }

    fn scan_reg_exp_body(mut ref self) -> Result[String, Fail] {
        let mut s = String.new();
        s.push(self.source[self.index]);
        self.index += 1;
        let mut class_marker = false;
        let mut terminated = false;
        while not self.eof() {
            let mut ch = self.source[self.index];
            self.index += 1;
            s.push(ch);
            if ch == '\\' {
                ch = self.at(self.index);
                self.index += 1;
                // https://tc39.github.io/ecma262/#sec-literals-regular-expression-literals
                if is_line_terminator(ch) {
                    return Err(self.unexpected("Invalid regular expression: missing /"));
                }
                s.push(ch);
            } else if is_line_terminator(ch) {
                return Err(self.unexpected("Invalid regular expression: missing /"));
            } else if class_marker {
                if ch == ']' {
                    class_marker = false;
                }
            } else if ch == '/' {
                terminated = true;
                break;
            } else if ch == '[' {
                class_marker = true;
            }
        }
        if not terminated {
            return Err(self.unexpected("Invalid regular expression: missing /"));
        }
        // Exclude leading and trailing slash.
        let cs: Vec[char] = s.chars().collect();
        let mut out = String.new();
        let mut k = 1;
        while k + 1 < cs.len() {
            out.push(cs[k]);
            k += 1;
        }
        Ok(out)
    }

    fn scan_reg_exp_flags(mut ref self) -> Result[String, Fail] {
        let mut flags = String.new();
        while not self.eof() {
            let mut ch = self.source[self.index];
            if not is_identifier_part(ch) {
                break;
            }
            self.index += 1;
            if ch == '\\' and not self.eof() {
                ch = self.source[self.index];
                if ch == 'u' {
                    self.index += 1;
                    let restore = self.index;
                    match self.scan_hex_escape('u') {
                        Some(c) => flags.push(c),
                        None => {
                            self.index = restore;
                            flags.push('u');
                        }
                    }
                    self.tolerate_unexpected("Unexpected token ILLEGAL")?;
                } else {
                    self.tolerate_unexpected("Unexpected token ILLEGAL")?;
                }
            } else {
                flags.push(ch);
            }
        }
        Ok(flags)
    }

    fn scan_reg_exp(mut ref self) -> Result[RawToken, Fail] {
        let start = self.index;
        let pattern = self.scan_reg_exp_body()?;
        let flags = self.scan_reg_exp_flags()?;
        let value = self.test_reg_exp(pattern, flags)?;
        let mut t = raw_token(T_REGEX, vs(""), self.line_number, self.line_start, start, self.index);
        t.pattern = pattern;
        t.flags = flags;
        t.regex = value;
        Ok(t)
    }

    fn lex(mut ref self) -> Result[RawToken, Fail] {
        if self.eof() {
            return Ok(raw_token(T_EOF, vs(""), self.line_number, self.line_start, self.index, self.index));
        }
        let ch = self.source[self.index];
        if is_identifier_start(ch) {
            return self.scan_identifier();
        }
        // Very common: ( and ) and ;
        if ch == '(' or ch == ')' or ch == ';' {
            return self.scan_punctuator();
        }
        // String literal starts with single quote (U+0027) or double quote (U+0022).
        if ch == '\'' or ch == '"' {
            return self.scan_string_literal();
        }
        // Dot (.) U+002E can also start a floating-point number, hence the need
        // to check the next character.
        if ch == '.' {
            if is_decimal_digit(self.at(self.index + 1)) {
                return self.scan_numeric_literal();
            }
            return self.scan_punctuator();
        }
        if is_decimal_digit(ch) {
            return self.scan_numeric_literal();
        }
        // Template literals start with ` (U+0060) for template head
        // or } (U+007D) for template middle or template tail.
        if ch == '`' or (ch == '}' and self.curly_stack.len() > 0 and self.curly_stack[self.curly_stack.len() - 1] == "${") {
            return self.scan_template();
        }
        self.scan_punctuator()
    }
}

fn is_hex_cp(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

fn hex_cp(c: i64) -> i64 {
    if c <= 57 {
        return c - 48;
    }
    if c >= 97 {
        return c - 87;
    }
    c - 55
}

// re.compile on mini_re's parser and compiler, giving the pattern's
// flags as Pattern.flags has them.
fn compiled_flags(pattern: ref Vec[i64], flags: i64) -> Result[i64, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    let mut f = p.flags;
    if (f & flag_a()) == 0 {
        f = f | flag_u();
    }
    Ok(f)
}

// repr(re.Pattern): re.compile(%.200R) with the flags but re.UNICODE.
fn pattern_repr(pattern: ref Vec[i64], flags: i64) -> String {
    let mut r: Vec[i64] = Vec.new();
    str_repr(pattern, mut r);
    if r.len() > 200 {
        r.truncate(200);
    }
    let mut out = "re.compile(".to_string();
    out.push_str(to_string(r));
    let mut f = flags;
    if (f & (flag_l() | flag_u() | flag_a())) == flag_u() {
        f = f & (0x7FFFFFFF ^ flag_u());
    }
    if f != 0 {
        let names = vec![
            ("re.IGNORECASE", 2), ("re.LOCALE", 4), ("re.MULTILINE", 8), ("re.DOTALL", 16), ("re.UNICODE", 32),
            ("re.VERBOSE", 64), ("re.DEBUG", 128), ("re.ASCII", 256),
        ];
        let mut parts: Vec[String] = Vec.new();
        for (name, bit) in names {
            if (f & bit) != 0 {
                parts.push(name.to_string());
                f = f & (0x7FFFFFFF ^ bit);
            }
        }
        if f != 0 {
            parts.push(f"0x{f:x}");
        }
        out.push_str(", ");
        let mut k = 0;
        while k < parts.len() {
            if k > 0 {
                out.push('|');
            }
            out.push_str(parts[k]);
            k += 1;
        }
    }
    out.push(')');
    out
}
// -------------------------------------------------------------- nodes
//
// nodes.py: each class sets its attributes in this order. A node
// argument of -1 is None; a list argument is a heap list.

fn nd(h: mut ref Heap, cls: Str, ty: Str) -> i64 {
    let n = h.obj(cls);
    h.put(n, "type", vs(ty));
    n
}

fn vlist(l: i64) -> Val {
    Val.List(l)
}

fn n_array_expression(h: mut ref Heap, elements: i64) -> i64 {
    let n = nd(mut h, "ArrayExpression", "ArrayExpression");
    h.put(n, "elements", vlist(elements));
    n
}

fn n_arrow_function_expression(h: mut ref Heap, params: i64, body: i64, expression: bool, is_async: bool) -> i64 {
    let cls = if is_async { "AsyncArrowFunctionExpression" } else { "ArrowFunctionExpression" };
    let n = nd(mut h, cls, "ArrowFunctionExpression");
    h.put(n, "generator", Val.Bool(false));
    h.put(n, "isAsync", Val.Bool(is_async));
    h.put(n, "params", vlist(params));
    h.put(n, "body", vobj(body));
    h.put(n, "expression", Val.Bool(expression));
    n
}

fn n_assignment_expression(h: mut ref Heap, operator: ref String, left: i64, right: i64) -> i64 {
    let n = nd(mut h, "AssignmentExpression", "AssignmentExpression");
    h.put(n, "operator", vstr(operator));
    h.put(n, "left", vobj(left));
    h.put(n, "right", vobj(right));
    n
}

fn n_assignment_pattern(h: mut ref Heap, left: i64, right: i64) -> i64 {
    let n = nd(mut h, "AssignmentPattern", "AssignmentPattern");
    h.put(n, "left", vobj(left));
    h.put(n, "right", vobj(right));
    n
}

fn n_async_function(h: mut ref Heap, cls: Str, ty: Str, id: i64, params: i64, body: i64) -> i64 {
    let n = nd(mut h, cls, ty);
    h.put(n, "generator", Val.Bool(false));
    h.put(n, "expression", Val.Bool(false));
    h.put(n, "isAsync", Val.Bool(true));
    h.put(n, "id", vobj(id));
    h.put(n, "params", vlist(params));
    h.put(n, "body", vobj(body));
    n
}

fn n_function(h: mut ref Heap, cls: Str, id: i64, params: i64, body: i64, generator: bool) -> i64 {
    let n = nd(mut h, cls, cls);
    h.put(n, "expression", Val.Bool(false));
    h.put(n, "isAsync", Val.Bool(false));
    h.put(n, "id", vobj(id));
    h.put(n, "params", vlist(params));
    h.put(n, "body", vobj(body));
    h.put(n, "generator", Val.Bool(generator));
    n
}

fn n_one(h: mut ref Heap, cls: Str, key: Str, v: own Val) -> i64 {
    let n = nd(mut h, cls, cls);
    h.put(n, key, v);
    n
}

fn n_two(h: mut ref Heap, cls: Str, k1: Str, v1: own Val, k2: Str, v2: own Val) -> i64 {
    let n = nd(mut h, cls, cls);
    h.put(n, k1, v1);
    h.put(n, k2, v2);
    n
}

fn n_three(h: mut ref Heap, cls: Str, k1: Str, v1: own Val, k2: Str, v2: own Val, k3: Str, v3: own Val) -> i64 {
    let n = nd(mut h, cls, cls);
    h.put(n, k1, v1);
    h.put(n, k2, v2);
    h.put(n, k3, v3);
    n
}

fn n_binary_expression(h: mut ref Heap, operator: ref String, left: i64, right: i64) -> i64 {
    let ty = if operator == "||" or operator == "&&" { "LogicalExpression" } else { "BinaryExpression" };
    let n = nd(mut h, "BinaryExpression", ty);
    h.put(n, "operator", vstr(operator));
    h.put(n, "left", vobj(left));
    h.put(n, "right", vobj(right));
    n
}

fn n_class(h: mut ref Heap, cls: Str, id: i64, super_class: i64, body: i64) -> i64 {
    n_three(mut h, cls, "id", vobj(id), "superClass", vobj(super_class), "body", vobj(body))
}

fn n_member(h: mut ref Heap, computed: bool, object: i64, property: i64) -> i64 {
    let cls = if computed { "ComputedMemberExpression" } else { "StaticMemberExpression" };
    let n = nd(mut h, cls, "MemberExpression");
    h.put(n, "computed", Val.Bool(computed));
    h.put(n, "object", vobj(object));
    h.put(n, "property", vobj(property));
    n
}

fn n_directive(h: mut ref Heap, expression: i64, directive: ref String) -> i64 {
    let n = nd(mut h, "Directive", "ExpressionStatement");
    h.put(n, "expression", vobj(expression));
    h.put(n, "directive", vstr(directive));
    n
}

fn n_export_specifier(h: mut ref Heap, local: i64, exported: i64) -> i64 {
    let n = nd(mut h, "ExportSpecifier", "ExportSpecifier");
    h.put(n, "exported", vobj(exported));
    h.put(n, "local", vobj(local));
    n
}

fn n_for_in_statement(h: mut ref Heap, left: i64, right: i64, body: i64) -> i64 {
    let n = nd(mut h, "ForInStatement", "ForInStatement");
    h.put(n, "each", Val.Bool(false));
    h.put(n, "left", vobj(left));
    h.put(n, "right", vobj(right));
    h.put(n, "body", vobj(body));
    n
}

fn n_for_statement(h: mut ref Heap, init: i64, test: i64, update: i64, body: i64) -> i64 {
    let n = nd(mut h, "ForStatement", "ForStatement");
    h.put(n, "init", vobj(init));
    h.put(n, "test", vobj(test));
    h.put(n, "update", vobj(update));
    h.put(n, "body", vobj(body));
    n
}

fn n_identifier(h: mut ref Heap, name: ref String) -> i64 {
    n_one(mut h, "Identifier", "name", vstr(name))
}

fn n_literal(h: mut ref Heap, value: own Val, raw: ref String) -> i64 {
    n_two(mut h, "Literal", "value", value, "raw", vstr(raw))
}

fn n_method(h: mut ref Heap, cls: Str, key: i64, computed: bool, value: i64, kind: ref String, is_static: bool) -> i64 {
    let n = nd(mut h, cls, cls);
    h.put(n, "key", vobj(key));
    h.put(n, "computed", Val.Bool(computed));
    h.put(n, "value", vobj(value));
    h.put(n, "kind", vstr(kind));
    h.put(n, "static", Val.Bool(is_static));
    n
}

fn n_program(h: mut ref Heap, module: bool, body: i64) -> i64 {
    let n = nd(mut h, if module { "Module" } else { "Script" }, "Program");
    h.put(n, "sourceType", vs(if module { "module" } else { "script" }));
    h.put(n, "body", vlist(body));
    n
}

fn n_property(h: mut ref Heap, kind: Str, key: i64, computed: bool, value: i64, method: bool, shorthand: bool) -> i64 {
    let n = nd(mut h, "Property", "Property");
    h.put(n, "key", vobj(key));
    h.put(n, "computed", Val.Bool(computed));
    h.put(n, "value", vobj(value));
    h.put(n, "kind", vs(kind));
    h.put(n, "method", Val.Bool(method));
    h.put(n, "shorthand", Val.Bool(shorthand));
    n
}

fn n_regex_literal(h: mut ref Heap, value: own Val, raw: ref String, pattern: ref String, flags: ref String) -> i64 {
    let n = nd(mut h, "RegexLiteral", "Literal");
    h.put(n, "value", value);
    h.put(n, "raw", vstr(raw));
    let r = h.regexp(pattern, flags);
    h.put(n, "regex", Val.Obj(r));
    n
}

fn n_template_element(h: mut ref Heap, raw: ref String, cooked: ref String, tail: bool) -> i64 {
    let n = nd(mut h, "TemplateElement", "TemplateElement");
    let v = h.obj("Value");
    h.put(v, "raw", vstr(raw));
    h.put(v, "cooked", vstr(cooked));
    h.put(n, "value", Val.Obj(v));
    h.put(n, "tail", Val.Bool(tail));
    n
}

fn n_unary_expression(h: mut ref Heap, operator: ref String, argument: i64) -> i64 {
    let n = nd(mut h, "UnaryExpression", "UnaryExpression");
    h.put(n, "prefix", Val.Bool(true));
    h.put(n, "operator", vstr(operator));
    h.put(n, "argument", vobj(argument));
    n
}

fn n_update_expression(h: mut ref Heap, operator: ref String, argument: i64, prefix: bool) -> i64 {
    n_three(mut h, "UpdateExpression", "operator", vstr(operator), "argument", vobj(argument), "prefix", Val.Bool(prefix))
}

fn n_placeholder(h: mut ref Heap, params: i64, is_async: bool) -> i64 {
    let cls = if is_async { "AsyncArrowParameterPlaceHolder" } else { "ArrowParameterPlaceHolder" };
    let n = nd(mut h, cls, "ArrowParameterPlaceHolder");
    h.put(n, "params", vlist(params));
    h.put(n, "isAsync", Val.Bool(is_async));
    n
}
// ---------------------------------------------------- comment handler
//
// comment_handler.py. It sees every node finalize() makes, including
// the ones the parser then drops, and every comment, in source order.
// leading and trailing hold the same entries; insertInnerComments
// clears them by index in both, which raises IndexError once trailing
// has been emptied and leading has not.

struct CommentEntry {
    comment: i64,
    start: i64,
}

struct CommentHandler {
    attach: bool,
    comments: Vec[i64],
    // (node, start offset)
    stack: Vec[(i64, i64)],
    entries: Vec[CommentEntry],
    // entry ids, -1 where Python has None
    leading: Vec[i64],
    trailing: Vec[i64],
}

fn new_comment_handler(attach: bool) -> CommentHandler {
    CommentHandler {
        attach: attach, comments: Vec.new(), stack: Vec.new(), entries: Vec.new(), leading: Vec.new(),
        trailing: Vec.new(),
    }
}

fn without_none(v: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for x in v {
        if x >= 0 {
            out.push(x);
        }
    }
    out
}

fn comment_range(h: ref Heap, c: i64, k: i64) -> i64 {
    as_int(h.at(as_list(h.get(c, "range")), k))
}

impl CommentHandler {
    fn insert_inner_comments(mut ref self, h: mut ref Heap, node: i64, end: i64) -> Result[(), Fail] {
        if h.ty_is(node, "BlockStatement") and h.len(as_list(h.get(node, "body"))) == 0 {
            let mut inner: Vec[i64] = Vec.new();
            let mut i = 0;
            while i < self.leading.len() {
                let e = self.leading[i];
                if end >= self.entries[e].start {
                    inner.push(self.entries[e].comment);
                    self.leading[i] = -1;
                    if i >= self.trailing.len() {
                        return Err(Fail.Crash("IndexError: list assignment index out of range".to_string()));
                    }
                    self.trailing[i] = -1;
                }
                i += 1;
            }
            if inner.len() > 0 {
                let l = h.list_of(inner);
                h.put(node, "innerComments", Val.List(l));
                self.leading = without_none(self.leading);
                self.trailing = without_none(self.trailing);
            }
        }
        Ok(())
    }

    fn find_trailing_comments(mut ref self, h: mut ref Heap, end: i64) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        if self.trailing.len() > 0 {
            for e in self.trailing.iter() {
                if self.entries[*e].start >= end {
                    out.push(self.entries[*e].comment);
                }
            }
            if out.len() > 0 {
                self.trailing = Vec.new();
            }
            return out;
        }
        if self.stack.len() > 0 {
            let (last, _) = self.stack[self.stack.len() - 1];
            let tc = h.kids(last, "trailingComments");
            if tc.len() > 0 {
                let first = tc[0];
                if first >= 0 and comment_range(h, first, 0) >= end {
                    out = tc;
                    h.del(last, "trailingComments");
                }
            }
        }
        out
    }

    fn find_leading_comments(mut ref self, h: mut ref Heap, start: i64) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        let mut target = -1;
        while self.stack.len() > 0 {
            let (node, s) = self.stack[self.stack.len() - 1];
            if s >= start {
                target = node;
                self.stack.pop();
            } else {
                break;
            }
        }
        if target >= 0 {
            let mut lc = h.kids(target, "leadingComments");
            if lc.len() > 0 {
                let mut i = 0;
                while i < lc.len() {
                    if comment_range(h, lc[i], 1) <= start {
                        out.push(lc[i]);
                        lc[i] = -1;
                    }
                    i += 1;
                }
            }
            if out.len() > 0 {
                let kept = without_none(lc);
                if kept.len() > 0 {
                    let l = h.list_of(kept);
                    h.put(target, "leadingComments", Val.List(l));
                } else {
                    h.del(target, "leadingComments");
                }
            }
            return out;
        }
        let mut i = 0;
        while i < self.leading.len() {
            let e = self.leading[i];
            if self.entries[e].start <= start {
                out.push(self.entries[e].comment);
                self.leading[i] = -1;
            }
            i += 1;
        }
        if out.len() > 0 {
            self.leading = without_none(self.leading);
        }
        out
    }

    fn visit_node(mut ref self, h: mut ref Heap, node: i64, start: i64, end: i64) -> Result[(), Fail] {
        if h.ty_is(node, "Program") and h.len(as_list(h.get(node, "body"))) > 0 {
            return Ok(());
        }
        self.insert_inner_comments(h, node, end)?;
        let trailing = self.find_trailing_comments(h, end);
        let leading = self.find_leading_comments(h, start);
        if leading.len() > 0 {
            let l = h.list_of(leading);
            h.put(node, "leadingComments", Val.List(l));
        }
        if trailing.len() > 0 {
            let l = h.list_of(trailing);
            h.put(node, "trailingComments", Val.List(l));
        }
        self.stack.push((node, start));
        Ok(())
    }

    fn visit_comment(mut ref self, h: mut ref Heap, node: i64, start: i64, end: i64) {
        let kind = if h.ty(node).starts_with("L") { "Line" } else { "Block" };
        let value = h.get(node, "value");
        let range = h.get(node, "range");
        let loc = h.get(node, "loc");
        let c = h.obj("Comment");
        h.put(c, "type", vs(kind));
        h.put(c, "value", value.clone());
        h.put(c, "range", Val.Null);
        h.put(c, "loc", Val.Null);
        if truthy(h, range) {
            h.put(c, "range", range);
        }
        if truthy(h, loc) {
            h.put(c, "loc", loc.clone());
        }
        self.comments.push(c);
        if self.attach {
            let ec = h.obj("Comment");
            h.put(ec, "type", vs(kind));
            h.put(ec, "value", value);
            let r = h.pair(start, end);
            h.put(ec, "range", r);
            h.put(ec, "loc", Val.Null);
            if truthy(h, loc) {
                h.put(ec, "loc", loc);
            }
            h.put(node, "type", vs(kind));
            self.entries.push(CommentEntry { comment: ec, start: start });
            let id = self.entries.len() - 1;
            self.leading.push(id);
            self.trailing.push(id);
        }
    }

    fn visit(mut ref self, h: mut ref Heap, node: i64, start: i64, end: i64) -> Result[(), Fail] {
        let t = h.ty(node);
        if t == "LineComment" or t == "BlockComment" {
            self.visit_comment(h, node, start, end);
        } else if self.attach {
            self.visit_node(h, node, start, end)?;
        }
        Ok(())
    }
}
// ------------------------------------------------------------- parser

#[derive(Copy, Clone)]
struct Marker {
    index: i64,
    line: i64,
    column: i64,
}

struct Config {
    range: bool,
    loc: bool,
    // "" is None
    source: String,
    tokens: bool,
    comment: bool,
    tolerant: bool,
    class_properties: bool,
}

struct Context {
    is_module: bool,
    allow_await: bool,
    allow_in: bool,
    allow_strict_directive: bool,
    allow_yield: bool,
    first_cover_initialized_name_error: Option[RawToken],
    is_assignment_target: bool,
    is_binding_element: bool,
    in_function_body: bool,
    in_iteration: bool,
    in_switch: bool,
    label_set: Vec[String],
    strict: bool,
}

// The "token" an error is reported at: a token, a node (which has no
// lineNumber, so the last marker's position is used), or none.
#[derive(Clone)]
enum Culprit {
    NoTok,
    Tok(RawToken),
    NodeRef(i64),
}

fn culprit_set(c: ref Culprit) -> bool {
    match c {
        Culprit.NoTok => false,
        _ => true,
    }
}

struct Params {
    simple: bool,
    // "" is None
    message: String,
    stricted: Culprit,
    first_restricted: Culprit,
    in_for: bool,
    param_set: Vec[String],
    params: Vec[i64],
}

fn new_params() -> Params {
    Params {
        simple: true, message: String.new(), stricted: Culprit.NoTok, first_restricted: Culprit.NoTok,
        in_for: false, param_set: Vec.new(), params: Vec.new(),
    }
}

fn in_for(v: bool) -> Params {
    let mut p = new_params();
    p.in_for = v;
    p
}

// The parse functions isolateCoverGrammar and inheritCoverGrammar take.
enum Pf {
    Assignment,
    Expression,
    Unary,
    Exponentiation,
    Binary,
    LhsAllowCall,
    Lhs,
    Primary,
    New,
    Group,
    ArrayInit,
    ObjectInit,
    Statement,
    AsyncArgument,
}

fn contains(set: ref Vec[String], key: ref String) -> bool {
    for k in set {
        if k == key {
            return true;
        }
    }
    false
}

fn binary_operator_precedence(op: ref String) -> i64 {
    if op == "||" {
        return 1;
    }
    if op == "&&" {
        return 2;
    }
    if op == "|" {
        return 3;
    }
    if op == "^" {
        return 4;
    }
    if op == "&" {
        return 5;
    }
    if op == "==" or op == "!=" or op == "===" or op == "!==" {
        return 6;
    }
    if op == "<" or op == ">" or op == "<=" or op == ">=" or op == "instanceof" or op == "in" {
        return 7;
    }
    if op == "<<" or op == ">>" or op == ">>>" {
        return 8;
    }
    if op == "+" or op == "-" {
        return 9;
    }
    if op == "*" or op == "/" or op == "%" {
        return 11;
    }
    0
}

fn replace_first(s: ref String, pat: Str, with: ref String) -> String {
    match s.find(pat) {
        Some(i) => {
            let mut out = s.substring(0, i);
            out.push_str(with);
            out.push_str(s.substring(i + pat.len()));
            out
        }
        None => s.clone(),
    }
}

// A binary-expression stack entry: a node or an operator.
#[derive(Clone)]
enum Sv {
    Expr(i64),
    Op(String),
}

struct JsParser {
    cfg: Config,
    h: Heap,
    sc: Scanner,
    ch: CommentHandler,
    // a delegate is installed when comments are collected or attached
    delegate: bool,
    lookahead: RawToken,
    has_line_terminator: bool,
    ctx: Context,
    tokens: Vec[i64],
    start_marker: Marker,
    last_marker: Marker,
}

fn new_parser(code: ref String, cfg: own Config, attach: bool) -> Result[JsParser, Fail] {
    let delegate = cfg.comment;
    let mut sc = new_scanner(code, cfg.tolerant);
    sc.track_comment = cfg.comment;
    let line = sc.line_number;
    let mut p = JsParser {
        cfg: cfg, h: new_heap(), sc: sc, ch: new_comment_handler(attach), delegate: delegate,
        lookahead: raw_token(T_EOF, vs(""), line, 0, 0, 0), has_line_terminator: false,
        ctx: Context {
            is_module: false, allow_await: false, allow_in: true, allow_strict_directive: true,
            allow_yield: true, first_cover_initialized_name_error: None, is_assignment_target: false,
            is_binding_element: false, in_function_body: false, in_iteration: false, in_switch: false,
            label_set: Vec.new(), strict: false,
        },
        tokens: Vec.new(), start_marker: Marker { index: 0, line: line, column: 0 },
        last_marker: Marker { index: 0, line: line, column: 0 },
    };
    p.next_token()?;
    p.last_marker = Marker { index: p.sc.index, line: p.sc.line_number, column: p.sc.index - p.sc.line_start };
    Ok(p)
}

impl JsParser {
    // ------------------------------------------------------- errors

    fn throw_error(ref self, fmt: Str, args: ref Vec[String]) -> Fail {
        let msg = fmt_msg(fmt, args);
        let m = self.last_marker;
        Fail.Js(self.sc.eh.create_error(m.index, m.line, m.column + 1, msg))
    }

    fn tolerate_error(mut ref self, fmt: Str, args: ref Vec[String]) -> Result[(), Fail] {
        let msg = fmt_msg(fmt, args);
        let m = self.last_marker;
        let line = self.sc.line_number;
        self.sc.eh.tolerate_error(m.index, line, m.column + 1, msg)
    }

    // Throw an exception because of the token. message "" is None.
    fn unexpected_token_error(ref self, token: ref Culprit, message: Str) -> JsErr {
        let mut msg = if message.is_empty() { "Unexpected token".to_string() } else { message.to_string() };
        if message.is_empty() {
            msg = "Unexpected token %0".to_string();
        }
        let mut value = "ILLEGAL".to_string();
        match token {
            Culprit.Tok(t) => {
                if message.is_empty() {
                    let k = t.kind;
                    if k == T_EOF {
                        msg = "Unexpected end of input".to_string();
                    } else if k == T_IDENTIFIER {
                        msg = "Unexpected identifier".to_string();
                    } else if k == T_NUMERIC {
                        msg = "Unexpected number".to_string();
                    } else if k == T_STRING {
                        msg = "Unexpected string".to_string();
                    } else if k == T_TEMPLATE {
                        msg = "Unexpected quasi %0".to_string();
                    } else if k == T_KEYWORD {
                        if is_future_reserved(tok_text(t)) {
                            msg = "Unexpected reserved word".to_string();
                        } else if self.ctx.strict and is_strict_reserved(tok_text(t)) {
                            msg = "Use of future reserved word in strict mode".to_string();
                        }
                    } else {
                        msg = "Unexpected token %0".to_string();
                    }
                }
                value = py_str(t.value);
            }
            Culprit.NodeRef(n) => {
                if message.is_empty() {
                    msg = "Unexpected token %0".to_string();
                }
                value = py_str(self.h.get(n, "value"));
            }
            Culprit.NoTok => {}
        }
        msg = replace_first(msg, "%0", value);
        match token {
            Culprit.Tok(t) => {
                let last_line_start = self.last_marker.index - self.last_marker.column;
                self.sc.eh.create_error(t.start, t.line, t.start - last_line_start + 1, msg)
            }
            _ => {
                let m = self.last_marker;
                self.sc.eh.create_error(m.index, m.line, m.column + 1, msg)
            }
        }
    }

    fn throw_unexpected_token(ref self, token: ref Culprit, message: Str) -> Fail {
        Fail.Js(self.unexpected_token_error(token, message))
    }

    fn unexpected(ref self, t: ref RawToken) -> Fail {
        self.throw_unexpected_token(Culprit.Tok(t.clone()), "")
    }

    fn tolerate_unexpected_token(mut ref self, token: ref Culprit, message: Str) -> Result[(), Fail] {
        let e = self.unexpected_token_error(token, message);
        self.sc.eh.tolerate(e)
    }

    fn tolerate_unexpected(mut ref self, t: ref RawToken, message: Str) -> Result[(), Fail] {
        self.tolerate_unexpected_token(Culprit.Tok(t.clone()), message)
    }

    // ------------------------------------------------------- tokens

    fn collect_comments(mut ref self) -> Result[(), Fail] {
        if not self.cfg.comment {
            self.sc.scan_comments()?;
            return Ok(());
        }
        let comments = self.sc.scan_comments()?;
        for e in comments {
            let value = self.sc.slice(e.slice0, e.slice1);
            let node = if e.multi_line {
                n_one(mut self.h, "BlockComment", "value", Val.Str(value))
            } else {
                n_one(mut self.h, "LineComment", "value", Val.Str(value))
            };
            if self.cfg.range {
                let r = self.h.pair(e.range0, e.range1);
                self.h.put(node, "range", r);
            }
            if self.cfg.loc {
                let loc = self.h.location(e.l1, e.c1, e.l2, e.c2);
                self.h.put(node, "loc", Val.Obj(loc));
            }
            if self.delegate {
                self.ch.visit(mut self.h, node, e.range0, e.range1)?;
            }
        }
        Ok(())
    }

    // From internal representation to an external structure
    fn get_token_raw(ref self, t: ref RawToken) -> String {
        self.sc.slice(t.start, t.end)
    }

    fn convert_token(mut ref self, t: ref RawToken) -> i64 {
        let raw = self.get_token_raw(t);
        let e = self.h.obj("TokenEntry");
        self.h.put(e, "type", vs(token_name(t.kind)));
        self.h.put(e, "value", Val.Str(raw));
        self.h.put(e, "regex", Val.Null);
        self.h.put(e, "range", Val.Null);
        self.h.put(e, "loc", Val.Null);
        if self.cfg.range {
            let r = self.h.pair(t.start, t.end);
            self.h.put(e, "range", r);
        }
        if self.cfg.loc {
            let (l1, c1) = (self.start_marker.line, self.start_marker.column);
            let (l2, c2) = (self.sc.line_number, self.sc.index - self.sc.line_start);
            let loc = self.h.location(l1, c1, l2, c2);
            self.h.put(e, "loc", Val.Obj(loc));
        }
        if t.kind == T_REGEX {
            let r = self.h.regexp(t.pattern, t.flags);
            self.h.put(e, "regex", Val.Obj(r));
        }
        e
    }

    fn next_token(mut ref self) -> Result[RawToken, Fail] {
        let token = self.lookahead.clone();
        self.last_marker.index = self.sc.index;
        self.last_marker.line = self.sc.line_number;
        self.last_marker.column = self.sc.index - self.sc.line_start;
        self.collect_comments()?;
        if self.sc.index != self.start_marker.index {
            self.start_marker.index = self.sc.index;
            self.start_marker.line = self.sc.line_number;
            self.start_marker.column = self.sc.index - self.sc.line_start;
        }
        let mut next = self.sc.lex()?;
        self.has_line_terminator = token.line != next.line;
        if self.ctx.strict and next.kind == T_IDENTIFIER {
            if is_strict_reserved(tok_text(next)) {
                next.kind = T_KEYWORD;
            }
        }
        self.lookahead = next.clone();
        if self.cfg.tokens and next.kind != T_EOF {
            let e = self.convert_token(next);
            self.tokens.push(e);
        }
        Ok(token)
    }

    fn next_regex_token(mut ref self) -> Result[RawToken, Fail] {
        self.collect_comments()?;
        let token = self.sc.scan_reg_exp()?;
        if self.cfg.tokens {
            // Pop the previous token, '/' or '/='
            // self is added from the lookahead token.
            self.tokens.pop();
            let e = self.convert_token(token);
            self.tokens.push(e);
        }
        // Prime the next lookahead.
        self.lookahead = token.clone();
        self.next_token()?;
        Ok(token)
    }

    fn create_node(ref self) -> Marker {
        self.start_marker
    }

    fn start_node(ref self, t: ref RawToken, last_line_start: i64) -> Marker {
        let mut column = t.start - t.line_start;
        let mut line = t.line;
        if column < 0 {
            column += last_line_start;
            line -= 1;
        }
        Marker { index: t.start, line: line, column: column }
    }

    fn finalize(mut ref self, marker: Marker, node: i64) -> Result[i64, Fail] {
        if self.cfg.range {
            let r = self.h.pair(marker.index, self.last_marker.index);
            self.h.put(node, "range", r);
        }
        if self.cfg.loc {
            let m = self.last_marker;
            let loc = self.h.location(marker.line, marker.column, m.line, m.column);
            if not self.cfg.source.is_empty() {
                self.h.put(loc, "source", vstr(self.cfg.source));
            }
            self.h.put(node, "loc", Val.Obj(loc));
        }
        if self.delegate {
            let end = self.last_marker.index;
            self.ch.visit(mut self.h, node, marker.index, end)?;
        }
        Ok(node)
    }

    // Expect the next token to match the specified punctuator.
    // If not, an exception will be thrown.
    fn expect(mut ref self, value: Str) -> Result[(), Fail] {
        let token = self.next_token()?;
        if token.kind != T_PUNCTUATOR or not tok_is(token, value) {
            return Err(self.unexpected(token));
        }
        Ok(())
    }

    // Quietly expect a comma when in tolerant mode, otherwise delegates to expect().
    fn expect_comma_separator(mut ref self) -> Result[(), Fail] {
        if self.cfg.tolerant {
            let token = self.lookahead.clone();
            if token.kind == T_PUNCTUATOR and tok_is(token, ",") {
                self.next_token()?;
            } else if token.kind == T_PUNCTUATOR and tok_is(token, ";") {
                self.next_token()?;
                self.tolerate_unexpected(token, "")?;
            } else {
                self.tolerate_unexpected(token, "Unexpected token %0")?;
            }
            return Ok(());
        }
        self.expect(",")
    }

    // Expect the next token to match the specified keyword.
    // If not, an exception will be thrown.
    fn expect_keyword(mut ref self, keyword: Str) -> Result[(), Fail] {
        let token = self.next_token()?;
        if token.kind != T_KEYWORD or not tok_is(token, keyword) {
            return Err(self.unexpected(token));
        }
        Ok(())
    }

    // Return true if the next token matches the specified punctuator.
    fn is(ref self, value: Str) -> bool {
        self.lookahead.kind == T_PUNCTUATOR and tok_is(self.lookahead, value)
    }

    // Return true if the next token matches the specified keyword
    fn is_kw(ref self, keyword: Str) -> bool {
        self.lookahead.kind == T_KEYWORD and tok_is(self.lookahead, keyword)
    }

    // Return true if the next token matches the specified contextual keyword
    // (where an identifier is sometimes a keyword depending on the context)
    fn is_contextual(ref self, keyword: Str) -> bool {
        self.lookahead.kind == T_IDENTIFIER and tok_is(self.lookahead, keyword)
    }

    // Return true if the next token is an assignment operator
    fn match_assign(ref self) -> bool {
        if self.lookahead.kind != T_PUNCTUATOR {
            return false;
        }
        let op = tok_text(self.lookahead);
        op == "=" or op == "*=" or op == "**=" or op == "/=" or op == "%=" or op == "+=" or op == "-="
            or op == "<<=" or op == ">>=" or op == ">>>=" or op == "&=" or op == "^=" or op == "|="
    }

    // ------------------------------------------------ cover grammar

    fn call(mut ref self, f: Pf) -> Result[i64, Fail] {
        match f {
            Pf.Assignment => self.parse_assignment_expression(),
            Pf.Expression => self.parse_expression(),
            Pf.Unary => self.parse_unary_expression(),
            Pf.Exponentiation => self.parse_exponentiation_expression(),
            Pf.Binary => self.parse_binary_expression(),
            Pf.LhsAllowCall => self.parse_left_hand_side_expression_allow_call(),
            Pf.Lhs => self.parse_left_hand_side_expression(),
            Pf.Primary => self.parse_primary_expression(),
            Pf.New => self.parse_new_expression(),
            Pf.Group => self.parse_group_expression(),
            Pf.ArrayInit => self.parse_array_initializer(),
            Pf.ObjectInit => self.parse_object_initializer(),
            Pf.Statement => self.parse_statement(),
            Pf.AsyncArgument => self.parse_async_argument(),
        }
    }

    fn isolate(mut ref self, f: Pf) -> Result[i64, Fail] {
        let previous_is_binding_element = self.ctx.is_binding_element;
        let previous_is_assignment_target = self.ctx.is_assignment_target;
        let previous_first = self.ctx.first_cover_initialized_name_error.clone();
        self.ctx.is_binding_element = true;
        self.ctx.is_assignment_target = true;
        self.ctx.first_cover_initialized_name_error = None;
        let result = self.call(f)?;
        if let Some(t) = self.ctx.first_cover_initialized_name_error.clone() {
            return Err(self.unexpected(t));
        }
        self.ctx.is_binding_element = previous_is_binding_element;
        self.ctx.is_assignment_target = previous_is_assignment_target;
        self.ctx.first_cover_initialized_name_error = previous_first;
        Ok(result)
    }

    fn inherit(mut ref self, f: Pf) -> Result[i64, Fail] {
        let previous_is_binding_element = self.ctx.is_binding_element;
        let previous_is_assignment_target = self.ctx.is_assignment_target;
        let previous_first = self.ctx.first_cover_initialized_name_error.clone();
        self.ctx.is_binding_element = true;
        self.ctx.is_assignment_target = true;
        self.ctx.first_cover_initialized_name_error = None;
        let result = self.call(f)?;
        self.ctx.is_binding_element = self.ctx.is_binding_element and previous_is_binding_element;
        self.ctx.is_assignment_target = self.ctx.is_assignment_target and previous_is_assignment_target;
        if previous_first.is_some() {
            self.ctx.first_cover_initialized_name_error = previous_first;
        }
        Ok(result)
    }

    fn consume_semicolon(mut ref self) -> Result[(), Fail] {
        if self.is(";") {
            self.next_token()?;
        } else if not self.has_line_terminator {
            if self.lookahead.kind != T_EOF and not self.is("}") {
                return Err(self.unexpected(self.lookahead));
            }
            self.last_marker.index = self.start_marker.index;
            self.last_marker.line = self.start_marker.line;
            self.last_marker.column = self.start_marker.column;
        }
        Ok(())
    }

    // https://tc39.github.io/ecma262/#sec-primary-expression

    fn parse_primary_expression(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let typ = self.lookahead.kind;
        if typ == T_IDENTIFIER {
            if (self.ctx.is_module or self.ctx.allow_await) and tok_is(self.lookahead, "await") {
                self.tolerate_unexpected(self.lookahead.clone(), "")?;
            }
            if self.match_async_function()? {
                return self.parse_function_expression();
            }
            let t = self.next_token()?;
            let id = n_identifier(mut self.h, tok_text(t));
            return self.finalize(node, id);
        }
        if typ == T_NUMERIC or typ == T_STRING {
            if self.ctx.strict and self.lookahead.octal {
                self.tolerate_unexpected(self.lookahead.clone(), "Octal literals are not allowed in strict mode.")?;
            }
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            let token = self.next_token()?;
            let raw = self.get_token_raw(token);
            let lit = n_literal(mut self.h, token.value.clone(), raw);
            return self.finalize(node, lit);
        }
        if typ == T_BOOLEAN {
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            let token = self.next_token()?;
            let raw = self.get_token_raw(token);
            let lit = n_literal(mut self.h, Val.Bool(tok_is(token, "true")), raw);
            return self.finalize(node, lit);
        }
        if typ == T_NULL {
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            let token = self.next_token()?;
            let raw = self.get_token_raw(token);
            let lit = n_literal(mut self.h, Val.Null, raw);
            return self.finalize(node, lit);
        }
        if typ == T_TEMPLATE {
            return self.parse_template_literal();
        }
        if typ == T_PUNCTUATOR {
            let value = tok_text(self.lookahead);
            if value == "(" {
                self.ctx.is_binding_element = false;
                return self.inherit(Pf.Group);
            }
            if value == "[" {
                return self.inherit(Pf.ArrayInit);
            }
            if value == "{" {
                return self.inherit(Pf.ObjectInit);
            }
            if value == "/" or value == "/=" {
                self.ctx.is_assignment_target = false;
                self.ctx.is_binding_element = false;
                self.sc.index = self.start_marker.index;
                let token = self.next_regex_token()?;
                let raw = self.get_token_raw(token);
                let value = match token.regex {
                    Some(r) => Val.Pat(r.clone()),
                    None => Val.Null,
                };
                let lit = n_regex_literal(mut self.h, value, raw, token.pattern, token.flags);
                return self.finalize(node, lit);
            }
            let t = self.next_token()?;
            return Err(self.unexpected(t));
        }
        if typ == T_KEYWORD {
            if not self.ctx.strict and self.ctx.allow_yield and self.is_kw("yield") {
                return self.parse_identifier_name();
            }
            if not self.ctx.strict and self.is_kw("let") {
                let t = self.next_token()?;
                let id = n_identifier(mut self.h, tok_text(t));
                return self.finalize(node, id);
            }
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            if self.is_kw("function") {
                return self.parse_function_expression();
            }
            if self.is_kw("this") {
                self.next_token()?;
                let n = nd(mut self.h, "ThisExpression", "ThisExpression");
                return self.finalize(node, n);
            }
            if self.is_kw("class") {
                return self.parse_class_expression();
            }
            if self.match_import_call()? {
                return self.parse_import_call();
            }
            let t = self.next_token()?;
            return Err(self.unexpected(t));
        }
        let t = self.next_token()?;
        Err(self.unexpected(t))
    }

    // https://tc39.github.io/ecma262/#sec-array-initializer

    fn parse_spread_element(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("...")?;
        let arg = self.inherit(Pf.Assignment)?;
        let n = n_one(mut self.h, "SpreadElement", "argument", vobj(arg));
        self.finalize(node, n)
    }

    fn parse_array_initializer(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut elements: Vec[Val] = Vec.new();
        self.expect("[")?;
        while not self.is("]") {
            if self.is(",") {
                self.next_token()?;
                elements.push(Val.Null);
            } else if self.is("...") {
                let element = self.parse_spread_element()?;
                if not self.is("]") {
                    self.ctx.is_assignment_target = false;
                    self.ctx.is_binding_element = false;
                    self.expect(",")?;
                }
                elements.push(Val.Obj(element));
            } else {
                elements.push(Val.Obj(self.inherit(Pf.Assignment)?));
                if not self.is("]") {
                    self.expect(",")?;
                }
            }
        }
        self.expect("]")?;
        let l = self.h.list(elements);
        let n = n_array_expression(mut self.h, l);
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-object-initializer

    fn parse_property_method(mut ref self, params: ref Params) -> Result[i64, Fail] {
        self.ctx.is_assignment_target = false;
        self.ctx.is_binding_element = false;
        let previous_strict = self.ctx.strict;
        let previous_allow_strict_directive = self.ctx.allow_strict_directive;
        self.ctx.allow_strict_directive = params.simple;
        let body = self.isolate_function_source_elements()?;
        if self.ctx.strict and culprit_set(params.first_restricted) {
            self.tolerate_unexpected_token(params.first_restricted, params.message)?;
        }
        if self.ctx.strict and culprit_set(params.stricted) {
            self.tolerate_unexpected_token(params.stricted, params.message)?;
        }
        self.ctx.strict = previous_strict;
        self.ctx.allow_strict_directive = previous_allow_strict_directive;
        Ok(body)
    }

    // isolateCoverGrammar(parseFunctionSourceElements)
    fn isolate_function_source_elements(mut ref self) -> Result[i64, Fail] {
        let previous_is_binding_element = self.ctx.is_binding_element;
        let previous_is_assignment_target = self.ctx.is_assignment_target;
        let previous_first = self.ctx.first_cover_initialized_name_error.clone();
        self.ctx.is_binding_element = true;
        self.ctx.is_assignment_target = true;
        self.ctx.first_cover_initialized_name_error = None;
        let result = self.parse_function_source_elements()?;
        if let Some(t) = self.ctx.first_cover_initialized_name_error.clone() {
            return Err(self.unexpected(t));
        }
        self.ctx.is_binding_element = previous_is_binding_element;
        self.ctx.is_assignment_target = previous_is_assignment_target;
        self.ctx.first_cover_initialized_name_error = previous_first;
        Ok(result)
    }

    fn parse_property_method_function(mut ref self) -> Result[i64, Fail] {
        let is_generator = false;
        let node = self.create_node();
        let previous_allow_yield = self.ctx.allow_yield;
        self.ctx.allow_yield = true;
        let params = self.parse_formal_parameters(Culprit.NoTok)?;
        let method = self.parse_property_method(params)?;
        self.ctx.allow_yield = previous_allow_yield;
        let l = self.h.list_of(params.params);
        let n = n_function(mut self.h, "FunctionExpression", -1, l, method, is_generator);
        self.finalize(node, n)
    }

    fn parse_property_method_async_function(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let previous_allow_yield = self.ctx.allow_yield;
        let previous_await = self.ctx.allow_await;
        self.ctx.allow_yield = false;
        self.ctx.allow_await = true;
        let params = self.parse_formal_parameters(Culprit.NoTok)?;
        let method = self.parse_property_method(params)?;
        self.ctx.allow_yield = previous_allow_yield;
        self.ctx.allow_await = previous_await;
        let l = self.h.list_of(params.params);
        let n = n_async_function(mut self.h, "AsyncFunctionExpression", "FunctionExpression", -1, l, method);
        self.finalize(node, n)
    }

    fn parse_object_property_key(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let token = self.next_token()?;
        let typ = token.kind;
        if typ == T_STRING or typ == T_NUMERIC {
            if self.ctx.strict and token.octal {
                self.tolerate_unexpected(token, "Octal literals are not allowed in strict mode.")?;
            }
            let raw = self.get_token_raw(token);
            let key = n_literal(mut self.h, token.value.clone(), raw);
            return self.finalize(node, key);
        }
        if typ == T_IDENTIFIER or typ == T_BOOLEAN or typ == T_NULL or typ == T_KEYWORD {
            let key = n_identifier(mut self.h, tok_text(token));
            return self.finalize(node, key);
        }
        if typ == T_PUNCTUATOR {
            if tok_is(token, "[") {
                let key = self.isolate(Pf.Assignment)?;
                self.expect("]")?;
                return Ok(key);
            }
            return Err(self.unexpected(token));
        }
        Err(self.unexpected(token))
    }

    fn is_property_key(ref self, key: i64, value: Str) -> bool {
        (self.h.ty_is(key, "Identifier") and self.h.text(key, "name") == value)
            or (self.h.ty_is(key, "Literal") and val_is_str(self.h.get(key, "value"), value))
    }

    fn parse_object_property(mut ref self, has_proto: mut ref bool) -> Result[i64, Fail] {
        let node = self.create_node();
        let token = self.lookahead.clone();
        let mut key = -1;
        let mut value = -1;
        let mut computed = false;
        let mut method = false;
        let mut shorthand = false;
        let mut is_async = false;
        if token.kind == T_IDENTIFIER {
            let id = tok_text(token);
            self.next_token()?;
            computed = self.is("[");
            is_async = not self.has_line_terminator and id == "async"
                and not (self.is(":") or self.is("(") or self.is("*") or self.is(","));
            if is_async {
                key = self.parse_object_property_key()?;
            } else {
                let n = n_identifier(mut self.h, id);
                key = self.finalize(node, n)?;
            }
        } else if self.is("*") {
            self.next_token()?;
        } else {
            computed = self.is("[");
            key = self.parse_object_property_key()?;
        }
        let lookahead_property_key = self.qualified_property_name(self.lookahead);
        let mut kind = "init";
        if token.kind == T_IDENTIFIER and not is_async and tok_is(token, "get") and lookahead_property_key {
            kind = "get";
            computed = self.is("[");
            key = self.parse_object_property_key()?;
            self.ctx.allow_yield = false;
            value = self.parse_getter_method()?;
        } else if token.kind == T_IDENTIFIER and not is_async and tok_is(token, "set") and lookahead_property_key {
            kind = "set";
            computed = self.is("[");
            key = self.parse_object_property_key()?;
            value = self.parse_setter_method()?;
        } else if token.kind == T_PUNCTUATOR and tok_is(token, "*") and lookahead_property_key {
            kind = "init";
            computed = self.is("[");
            key = self.parse_object_property_key()?;
            value = self.parse_generator_method()?;
            method = true;
        } else {
            if key < 0 {
                return Err(self.unexpected(self.lookahead));
            }
            kind = "init";
            if self.is(":") and not is_async {
                if not computed and self.is_property_key(key, "__proto__") {
                    if *has_proto {
                        self.tolerate_error("Duplicate __proto__ fields are not allowed in object literals", Vec.new())?;
                    }
                    *has_proto = true;
                }
                self.next_token()?;
                value = self.inherit(Pf.Assignment)?;
            } else if self.is("(") {
                value = if is_async { self.parse_property_method_async_function()? } else { self.parse_property_method_function()? };
                method = true;
            } else if token.kind == T_IDENTIFIER {
                let n = n_identifier(mut self.h, tok_text(token));
                let id = self.finalize(node, n)?;
                if self.is("=") {
                    self.ctx.first_cover_initialized_name_error = Some(self.lookahead.clone());
                    self.next_token()?;
                    shorthand = true;
                    let init = self.isolate(Pf.Assignment)?;
                    let ap = n_assignment_pattern(mut self.h, id, init);
                    value = self.finalize(node, ap)?;
                } else {
                    shorthand = true;
                    value = id;
                }
            } else {
                let t = self.next_token()?;
                return Err(self.unexpected(t));
            }
        }
        let p = n_property(mut self.h, kind, key, computed, value, method, shorthand);
        self.finalize(node, p)
    }

    fn parse_object_initializer(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("{")?;
        let mut properties: Vec[i64] = Vec.new();
        let mut has_proto = false;
        while not self.is("}") {
            let p = if self.is("...") { self.parse_spread_element()? } else { self.parse_object_property(mut has_proto)? };
            properties.push(p);
            if not self.is("}") {
                self.expect_comma_separator()?;
            }
        }
        self.expect("}")?;
        let l = self.h.list_of(properties);
        let n = n_one(mut self.h, "ObjectExpression", "properties", vlist(l));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-template-literals

    fn parse_template_head(mut ref self) -> Result[i64, Fail] {
        if not self.lookahead.head {
            return Err(Fail.Crash("AssertionError: Template literal must start with a template head".to_string()));
        }
        let node = self.create_node();
        let token = self.next_token()?;
        let n = n_template_element(mut self.h, tok_text(token), token.cooked, token.tail);
        self.finalize(node, n)
    }

    fn parse_template_element(mut ref self) -> Result[i64, Fail] {
        if self.lookahead.kind != T_TEMPLATE {
            return Err(self.throw_unexpected_token(Culprit.NoTok, ""));
        }
        let node = self.create_node();
        let token = self.next_token()?;
        let n = n_template_element(mut self.h, tok_text(token), token.cooked, token.tail);
        self.finalize(node, n)
    }

    fn parse_template_literal(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut expressions: Vec[i64] = Vec.new();
        let mut quasis: Vec[i64] = Vec.new();
        let mut quasi = self.parse_template_head()?;
        quasis.push(quasi);
        while not truthy(self.h, self.h.get(quasi, "tail")) {
            expressions.push(self.parse_expression()?);
            quasi = self.parse_template_element()?;
            quasis.push(quasi);
        }
        let q = self.h.list_of(quasis);
        let e = self.h.list_of(expressions);
        let n = n_two(mut self.h, "TemplateLiteral", "quasis", vlist(q), "expressions", vlist(e));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-grouping-operator

    fn reinterpret_expression_as_pattern(mut ref self, expr: i64) {
        let typ = self.h.ty(expr);
        if typ == "SpreadElement" {
            self.h.put(expr, "type", vs("RestElement"));
            let a = self.h.node(expr, "argument");
            self.reinterpret_expression_as_pattern(a);
        } else if typ == "ArrayExpression" {
            self.h.put(expr, "type", vs("ArrayPattern"));
            for elem in self.h.kids(expr, "elements") {
                if elem >= 0 {
                    self.reinterpret_expression_as_pattern(elem);
                }
            }
        } else if typ == "ObjectExpression" {
            self.h.put(expr, "type", vs("ObjectPattern"));
            for prop in self.h.kids(expr, "properties") {
                let target = if self.h.ty_is(prop, "SpreadElement") { prop } else { self.h.node(prop, "value") };
                self.reinterpret_expression_as_pattern(target);
            }
        } else if typ == "AssignmentExpression" {
            self.h.put(expr, "type", vs("AssignmentPattern"));
            self.h.del(expr, "operator");
            let l = self.h.node(expr, "left");
            self.reinterpret_expression_as_pattern(l);
        }
        // Identifier, MemberExpression, RestElement, AssignmentPattern, and
        // any other node type (for tolerant parsing), stay as they are.
    }

    fn parse_group_expression(mut ref self) -> Result[i64, Fail] {
        self.expect("(")?;
        if self.is(")") {
            self.next_token()?;
            if not self.is("=>") {
                self.expect("=>")?;
            }
            let l = self.h.list(Vec.new());
            return Ok(n_placeholder(mut self.h, l, false));
        }
        let start_token = self.lookahead.clone();
        let mut params: Vec[RawToken] = Vec.new();
        if self.is("...") {
            let rest = self.parse_rest_element(mut params)?;
            self.expect(")")?;
            if not self.is("=>") {
                self.expect("=>")?;
            }
            let l = self.h.list_of(vec![rest]);
            return Ok(n_placeholder(mut self.h, l, false));
        }
        let mut arrow = false;
        self.ctx.is_binding_element = true;
        let mut expr = self.inherit(Pf.Assignment)?;
        if self.is(",") {
            let mut expressions: Vec[i64] = Vec.new();
            self.ctx.is_assignment_target = false;
            expressions.push(expr);
            while self.lookahead.kind != T_EOF {
                if not self.is(",") {
                    break;
                }
                self.next_token()?;
                if self.is(")") {
                    self.next_token()?;
                    for e in expressions.iter() {
                        self.reinterpret_expression_as_pattern(*e);
                    }
                    arrow = true;
                    let l = self.h.list_of(expressions);
                    expr = n_placeholder(mut self.h, l, false);
                } else if self.is("...") {
                    if not self.ctx.is_binding_element {
                        return Err(self.unexpected(self.lookahead));
                    }
                    expressions.push(self.parse_rest_element(mut params)?);
                    self.expect(")")?;
                    if not self.is("=>") {
                        self.expect("=>")?;
                    }
                    self.ctx.is_binding_element = false;
                    for e in expressions.iter() {
                        self.reinterpret_expression_as_pattern(*e);
                    }
                    arrow = true;
                    let l = self.h.list_of(expressions);
                    expr = n_placeholder(mut self.h, l, false);
                } else {
                    expressions.push(self.inherit(Pf.Assignment)?);
                }
                if arrow {
                    break;
                }
            }
            if not arrow {
                let m = self.start_node(start_token, 0);
                let l = self.h.list_of(expressions);
                let seq = n_one(mut self.h, "SequenceExpression", "expressions", vlist(l));
                expr = self.finalize(m, seq)?;
            }
        }
        if not arrow {
            self.expect(")")?;
            if self.is("=>") {
                if self.h.ty_is(expr, "Identifier") and self.h.text(expr, "name") == "yield" {
                    arrow = true;
                    let l = self.h.list_of(vec![expr]);
                    expr = n_placeholder(mut self.h, l, false);
                }
                if not arrow {
                    if not self.ctx.is_binding_element {
                        return Err(self.unexpected(self.lookahead));
                    }
                    if self.h.ty_is(expr, "SequenceExpression") {
                        for e in self.h.kids(expr, "expressions") {
                            self.reinterpret_expression_as_pattern(e);
                        }
                    } else {
                        self.reinterpret_expression_as_pattern(expr);
                    }
                    let parameters = if self.h.ty_is(expr, "SequenceExpression") {
                        as_list(self.h.get(expr, "expressions"))
                    } else {
                        self.h.list_of(vec![expr])
                    };
                    expr = n_placeholder(mut self.h, parameters, false);
                }
            }
            self.ctx.is_binding_element = false;
        }
        Ok(expr)
    }

    // https://tc39.github.io/ecma262/#sec-left-hand-side-expressions

    fn parse_arguments_with(mut ref self, is_async: bool) -> Result[Vec[i64], Fail] {
        self.expect("(")?;
        let mut args: Vec[i64] = Vec.new();
        if not self.is(")") {
            loop {
                let e = if self.is("...") {
                    self.parse_spread_element()?
                } else if is_async {
                    self.isolate(Pf.AsyncArgument)?
                } else {
                    self.isolate(Pf.Assignment)?
                };
                args.push(e);
                if self.is(")") {
                    break;
                }
                self.expect_comma_separator()?;
                if self.is(")") {
                    break;
                }
            }
        }
        self.expect(")")?;
        Ok(args)
    }

    fn is_identifier_name(ref self, t: ref RawToken) -> bool {
        t.kind == T_IDENTIFIER or t.kind == T_KEYWORD or t.kind == T_BOOLEAN or t.kind == T_NULL
    }

    fn parse_identifier_name(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let token = self.next_token()?;
        if not self.is_identifier_name(token) {
            return Err(self.unexpected(token));
        }
        let n = n_identifier(mut self.h, tok_text(token));
        self.finalize(node, n)
    }

    fn parse_new_expression(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let id = self.parse_identifier_name()?;
        let expr = if self.is(".") {
            self.next_token()?;
            if self.lookahead.kind == T_IDENTIFIER and self.ctx.in_function_body and tok_is(self.lookahead, "target") {
                let property = self.parse_identifier_name()?;
                n_two(mut self.h, "MetaProperty", "meta", vobj(id), "property", vobj(property))
            } else {
                return Err(self.unexpected(self.lookahead));
            }
        } else if self.is_kw("import") {
            return Err(self.unexpected(self.lookahead));
        } else {
            let callee = self.isolate(Pf.Lhs)?;
            let args = if self.is("(") { self.parse_arguments_with(false)? } else { Vec.new() };
            let l = self.h.list_of(args);
            let n = n_two(mut self.h, "NewExpression", "callee", vobj(callee), "arguments", vlist(l));
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            n
        };
        self.finalize(node, expr)
    }

    fn parse_async_argument(mut ref self) -> Result[i64, Fail] {
        let arg = self.parse_assignment_expression()?;
        self.ctx.first_cover_initialized_name_error = None;
        Ok(arg)
    }

    fn match_import_call(mut ref self) -> Result[bool, Fail] {
        let mut m = self.is_kw("import");
        if m {
            let state = self.sc.save_state();
            self.sc.scan_comments()?;
            let next = self.sc.lex()?;
            self.sc.restore_state(state);
            m = next.kind == T_PUNCTUATOR and tok_is(next, "(");
        }
        Ok(m)
    }

    fn parse_import_call(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("import")?;
        let n = nd(mut self.h, "Import", "Import");
        self.finalize(node, n)
    }

    fn parse_left_hand_side_expression_allow_call(mut ref self) -> Result[i64, Fail] {
        let start_token = self.lookahead.clone();
        let maybe_async = self.is_contextual("async");
        let previous_allow_in = self.ctx.allow_in;
        self.ctx.allow_in = true;
        let mut expr = -1;
        if self.is_kw("super") and self.ctx.in_function_body {
            let node = self.create_node();
            self.next_token()?;
            let s = nd(mut self.h, "Super", "Super");
            expr = self.finalize(node, s)?;
            if not self.is("(") and not self.is(".") and not self.is("[") {
                return Err(self.unexpected(self.lookahead));
            }
        } else {
            expr = self.inherit(if self.is_kw("new") { Pf.New } else { Pf.Primary })?;
        }
        loop {
            if self.is(".") {
                self.ctx.is_binding_element = false;
                self.ctx.is_assignment_target = true;
                self.expect(".")?;
                let property = self.parse_identifier_name()?;
                let m = self.start_node(start_token, 0);
                let n = n_member(mut self.h, false, expr, property);
                expr = self.finalize(m, n)?;
            } else if self.is("(") {
                let async_arrow = maybe_async and start_token.line == self.lookahead.line;
                self.ctx.is_binding_element = false;
                self.ctx.is_assignment_target = false;
                let args = self.parse_arguments_with(async_arrow)?;
                if self.h.ty_is(expr, "Import") and args.len() != 1 {
                    self.tolerate_error("Unexpected token", Vec.new())?;
                }
                let m = self.start_node(start_token, 0);
                let l = self.h.list_of(args);
                let n = n_two(mut self.h, "CallExpression", "callee", vobj(expr), "arguments", vlist(l));
                expr = self.finalize(m, n)?;
                if async_arrow and self.is("=>") {
                    for a in args.iter() {
                        self.reinterpret_expression_as_pattern(*a);
                    }
                    let l2 = self.h.list_of(args);
                    expr = n_placeholder(mut self.h, l2, true);
                }
            } else if self.is("[") {
                self.ctx.is_binding_element = false;
                self.ctx.is_assignment_target = true;
                self.expect("[")?;
                let property = self.isolate(Pf.Expression)?;
                self.expect("]")?;
                let m = self.start_node(start_token, 0);
                let n = n_member(mut self.h, true, expr, property);
                expr = self.finalize(m, n)?;
            } else if self.lookahead.kind == T_TEMPLATE and self.lookahead.head {
                let quasi = self.parse_template_literal()?;
                let m = self.start_node(start_token, 0);
                let n = n_two(mut self.h, "TaggedTemplateExpression", "tag", vobj(expr), "quasi", vobj(quasi));
                expr = self.finalize(m, n)?;
            } else {
                break;
            }
        }
        self.ctx.allow_in = previous_allow_in;
        Ok(expr)
    }

    fn parse_super(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("super")?;
        if not self.is("[") and not self.is(".") {
            return Err(self.unexpected(self.lookahead));
        }
        let s = nd(mut self.h, "Super", "Super");
        self.finalize(node, s)
    }

    fn parse_left_hand_side_expression(mut ref self) -> Result[i64, Fail] {
        if not self.ctx.allow_in {
            return Err(Fail.Crash("AssertionError: callee of new expression always allow in keyword.".to_string()));
        }
        let node = self.start_node(self.lookahead, 0);
        let mut expr = if self.is_kw("super") and self.ctx.in_function_body {
            self.parse_super()?
        } else {
            self.inherit(if self.is_kw("new") { Pf.New } else { Pf.Primary })?
        };
        loop {
            if self.is("[") {
                self.ctx.is_binding_element = false;
                self.ctx.is_assignment_target = true;
                self.expect("[")?;
                let property = self.isolate(Pf.Expression)?;
                self.expect("]")?;
                let n = n_member(mut self.h, true, expr, property);
                expr = self.finalize(node, n)?;
            } else if self.is(".") {
                self.ctx.is_binding_element = false;
                self.ctx.is_assignment_target = true;
                self.expect(".")?;
                let property = self.parse_identifier_name()?;
                let n = n_member(mut self.h, false, expr, property);
                expr = self.finalize(node, n)?;
            } else if self.lookahead.kind == T_TEMPLATE and self.lookahead.head {
                let quasi = self.parse_template_literal()?;
                let n = n_two(mut self.h, "TaggedTemplateExpression", "tag", vobj(expr), "quasi", vobj(quasi));
                expr = self.finalize(node, n)?;
            } else {
                break;
            }
        }
        Ok(expr)
    }

    // https://tc39.github.io/ecma262/#sec-update-expressions

    fn parse_update_expression(mut ref self) -> Result[i64, Fail] {
        let start_token = self.lookahead.clone();
        let mut expr = -1;
        if self.is("++") or self.is("--") {
            let node = self.start_node(start_token, 0);
            let token = self.next_token()?;
            expr = self.inherit(Pf.Unary)?;
            if self.ctx.strict and self.h.ty_is(expr, "Identifier") and is_restricted(self.h.text(expr, "name")) {
                self.tolerate_error("Prefix increment/decrement may not have eval or arguments operand in strict mode", Vec.new())?;
            }
            if not self.ctx.is_assignment_target {
                self.tolerate_error("Invalid left-hand side in assignment", Vec.new())?;
            }
            let prefix = true;
            let n = n_update_expression(mut self.h, tok_text(token), expr, prefix);
            expr = self.finalize(node, n)?;
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
        } else {
            expr = self.inherit(Pf.LhsAllowCall)?;
            if not self.has_line_terminator and self.lookahead.kind == T_PUNCTUATOR {
                if self.is("++") or self.is("--") {
                    if self.ctx.strict and self.h.ty_is(expr, "Identifier") and is_restricted(self.h.text(expr, "name")) {
                        self.tolerate_error("Postfix increment/decrement may not have eval or arguments operand in strict mode", Vec.new())?;
                    }
                    if not self.ctx.is_assignment_target {
                        self.tolerate_error("Invalid left-hand side in assignment", Vec.new())?;
                    }
                    self.ctx.is_assignment_target = false;
                    self.ctx.is_binding_element = false;
                    let operator = tok_text(self.next_token()?);
                    let prefix = false;
                    let m = self.start_node(start_token, 0);
                    let n = n_update_expression(mut self.h, operator, expr, prefix);
                    expr = self.finalize(m, n)?;
                }
            }
        }
        Ok(expr)
    }

    // https://tc39.github.io/ecma262/#sec-unary-operators

    fn parse_await_expression(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.next_token()?;
        let argument = self.parse_unary_expression()?;
        let n = n_one(mut self.h, "AwaitExpression", "argument", vobj(argument));
        self.finalize(node, n)
    }

    fn parse_unary_expression(mut ref self) -> Result[i64, Fail] {
        if self.is("+") or self.is("-") or self.is("~") or self.is("!") or self.is_kw("delete")
            or self.is_kw("void") or self.is_kw("typeof") {
            let node = self.start_node(self.lookahead, 0);
            let token = self.next_token()?;
            let arg = self.inherit(Pf.Unary)?;
            let n = n_unary_expression(mut self.h, tok_text(token), arg);
            let expr = self.finalize(node, n)?;
            if self.ctx.strict and self.h.text(expr, "operator") == "delete" and self.h.ty_is(self.h.node(expr, "argument"), "Identifier") {
                self.tolerate_error("Delete of an unqualified identifier in strict mode.", Vec.new())?;
            }
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            return Ok(expr);
        }
        if self.ctx.allow_await and self.is_contextual("await") {
            return self.parse_await_expression();
        }
        self.parse_update_expression()
    }

    fn parse_exponentiation_expression(mut ref self) -> Result[i64, Fail] {
        let start_token = self.lookahead.clone();
        let mut expr = self.inherit(Pf.Unary)?;
        if not self.h.ty_is(expr, "UnaryExpression") and self.is("**") {
            self.next_token()?;
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            let left = expr;
            let right = self.isolate(Pf.Exponentiation)?;
            let m = self.start_node(start_token, 0);
            let n = n_binary_expression(mut self.h, "**".to_string(), left, right);
            expr = self.finalize(m, n)?;
        }
        Ok(expr)
    }

    fn binary_precedence(ref self, t: ref RawToken) -> i64 {
        let op = tok_text(t);
        if t.kind == T_PUNCTUATOR {
            if op == "instanceof" or op == "in" {
                return 0;
            }
            return binary_operator_precedence(op);
        }
        if t.kind == T_KEYWORD {
            return if op == "instanceof" or (self.ctx.allow_in and op == "in") { 7 } else { 0 };
        }
        0
    }

    fn parse_binary_expression(mut ref self) -> Result[i64, Fail] {
        let start_token = self.lookahead.clone();
        let mut expr = self.inherit(Pf.Exponentiation)?;
        let token = self.lookahead.clone();
        let mut prec = self.binary_precedence(token);
        if prec > 0 {
            self.next_token()?;
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            let mut markers: Vec[RawToken] = vec![start_token, self.lookahead.clone()];
            let left = expr;
            let right = self.isolate(Pf.Exponentiation)?;
            let mut stack: Vec[Sv] = vec![Sv.Expr(left), Sv.Op(tok_text(token)), Sv.Expr(right)];
            let mut precedences: Vec[i64] = vec![prec];
            loop {
                prec = self.binary_precedence(self.lookahead);
                if prec <= 0 {
                    break;
                }
                // Reduce: make a binary expression from the three topmost entries.
                while stack.len() > 2 and prec <= precedences[precedences.len() - 1] {
                    let r = sv_expr(stack.pop().unwrap());
                    let operator = sv_op(stack.pop().unwrap());
                    precedences.pop();
                    let l = sv_expr(stack.pop().unwrap());
                    markers.pop();
                    let m = self.start_node(markers[markers.len() - 1], 0);
                    let n = n_binary_expression(mut self.h, operator, l, r);
                    stack.push(Sv.Expr(self.finalize(m, n)?));
                }
                // Shift.
                stack.push(Sv.Op(tok_text(self.next_token()?)));
                precedences.push(prec);
                markers.push(self.lookahead.clone());
                stack.push(Sv.Expr(self.isolate(Pf.Exponentiation)?));
            }
            // Final reduce to clean-up the stack.
            let mut i = stack.len() - 1;
            expr = sv_expr(stack[i].clone());
            let mut last_marker = markers.pop().unwrap();
            while i > 1 {
                let marker = markers.pop().unwrap();
                let last_line_start = last_marker.line_start;
                let m = self.start_node(marker, last_line_start);
                let operator = sv_op(stack[i - 1].clone());
                let l = sv_expr(stack[i - 2].clone());
                let n = n_binary_expression(mut self.h, operator, l, expr);
                expr = self.finalize(m, n)?;
                i -= 2;
                last_marker = marker;
            }
        }
        Ok(expr)
    }

    // https://tc39.github.io/ecma262/#sec-conditional-operator

    fn parse_conditional_expression(mut ref self) -> Result[i64, Fail] {
        let start_token = self.lookahead.clone();
        let mut expr = self.inherit(Pf.Binary)?;
        if self.is("?") {
            self.next_token()?;
            let previous_allow_in = self.ctx.allow_in;
            self.ctx.allow_in = true;
            let consequent = self.isolate(Pf.Assignment)?;
            self.ctx.allow_in = previous_allow_in;
            self.expect(":")?;
            let alternate = self.isolate(Pf.Assignment)?;
            let m = self.start_node(start_token, 0);
            let n = n_three(mut self.h, "ConditionalExpression", "test", vobj(expr), "consequent", vobj(consequent), "alternate", vobj(alternate));
            expr = self.finalize(m, n)?;
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
        }
        Ok(expr)
    }

    // https://tc39.github.io/ecma262/#sec-assignment-operators

    fn check_pattern_param(mut ref self, options: mut ref Params, param: i64) {
        let typ = self.h.ty(param);
        if typ == "Identifier" {
            let name = self.h.text(param, "name");
            self.validate_param(options, Culprit.NodeRef(param), name);
        } else if typ == "RestElement" {
            let a = self.h.node(param, "argument");
            self.check_pattern_param(options, a);
        } else if typ == "AssignmentPattern" {
            let l = self.h.node(param, "left");
            self.check_pattern_param(options, l);
        } else if typ == "ArrayPattern" {
            for element in self.h.kids(param, "elements") {
                if element >= 0 {
                    self.check_pattern_param(options, element);
                }
            }
        } else if typ == "ObjectPattern" {
            for prop in self.h.kids(param, "properties") {
                let target = if self.h.ty_is(prop, "RestElement") { prop } else { self.h.node(prop, "value") };
                self.check_pattern_param(options, target);
            }
        }
        options.simple = options.simple and self.h.cls_is(param, "Identifier");
    }

    fn reinterpret_as_cover_formals_list(mut ref self, expr: i64) -> Result[Option[Params], Fail] {
        let mut params: Vec[i64] = vec![expr];
        let mut async_arrow = false;
        let typ = self.h.ty(expr);
        if typ == "Identifier" {
            // as it is
        } else if typ == "ArrowParameterPlaceHolder" {
            params = self.h.kids(expr, "params");
            async_arrow = truthy(self.h, self.h.get(expr, "isAsync"));
        } else {
            return Ok(None);
        }
        let mut options = new_params();
        for param in params.iter() {
            let p = *param;
            if self.h.ty_is(p, "AssignmentPattern") {
                let right = self.h.node(p, "right");
                if self.h.ty_is(right, "YieldExpression") {
                    if truthy(self.h, self.h.get(right, "argument")) {
                        return Err(self.unexpected(self.lookahead));
                    }
                    self.h.put(right, "type", vs("Identifier"));
                    self.h.put(right, "name", vs("yield"));
                    self.h.del(right, "argument");
                    self.h.del(right, "delegate");
                }
            } else if async_arrow and self.h.ty_is(p, "Identifier") and self.h.text(p, "name") == "await" {
                return Err(self.unexpected(self.lookahead));
            }
            self.check_pattern_param(mut options, p);
        }
        if self.ctx.strict or not self.ctx.allow_yield {
            for param in params.iter() {
                if self.h.ty_is(*param, "YieldExpression") {
                    return Err(self.unexpected(self.lookahead));
                }
            }
        }
        if options.message == "Strict mode function may not have duplicate parameter names" {
            let token = if self.ctx.strict { options.stricted.clone() } else { options.first_restricted.clone() };
            return Err(self.throw_unexpected_token(token, options.message));
        }
        let mut out = new_params();
        out.simple = options.simple;
        out.params = params;
        out.stricted = options.stricted;
        out.first_restricted = options.first_restricted;
        out.message = options.message;
        Ok(Some(out))
    }

    fn parse_assignment_expression(mut ref self) -> Result[i64, Fail] {
        if not self.ctx.allow_yield and self.is_kw("yield") {
            return self.parse_yield_expression();
        }
        let start_token = self.lookahead.clone();
        let mut token = start_token.clone();
        let mut expr = self.parse_conditional_expression()?;
        if token.kind == T_IDENTIFIER and token.line == self.lookahead.line and tok_is(token, "async") {
            if self.lookahead.kind == T_IDENTIFIER or self.is_kw("yield") {
                let arg = self.parse_primary_expression()?;
                self.reinterpret_expression_as_pattern(arg);
                let l = self.h.list_of(vec![arg]);
                expr = n_placeholder(mut self.h, l, true);
            }
        }
        if self.h.ty_is(expr, "ArrowParameterPlaceHolder") or self.is("=>") {
            // https://tc39.github.io/ecma262/#sec-arrow-function-definitions
            self.ctx.is_assignment_target = false;
            self.ctx.is_binding_element = false;
            let is_async = truthy(self.h, self.h.get(expr, "isAsync"));
            if let Some(list) = self.reinterpret_as_cover_formals_list(expr)? {
                if self.has_line_terminator {
                    self.tolerate_unexpected(self.lookahead.clone(), "")?;
                }
                self.ctx.first_cover_initialized_name_error = None;
                let previous_strict = self.ctx.strict;
                let previous_allow_strict_directive = self.ctx.allow_strict_directive;
                self.ctx.allow_strict_directive = list.simple;
                let previous_allow_yield = self.ctx.allow_yield;
                let previous_await = self.ctx.allow_await;
                self.ctx.allow_yield = true;
                self.ctx.allow_await = is_async;
                let node = self.start_node(start_token, 0);
                self.expect("=>")?;
                let mut body = -1;
                if self.is("{") {
                    let previous_allow_in = self.ctx.allow_in;
                    self.ctx.allow_in = true;
                    body = self.parse_function_source_elements()?;
                    self.ctx.allow_in = previous_allow_in;
                } else {
                    body = self.isolate(Pf.Assignment)?;
                }
                let expression = not self.h.ty_is(body, "BlockStatement");
                if self.ctx.strict and culprit_set(list.first_restricted) {
                    return Err(self.throw_unexpected_token(list.first_restricted, list.message));
                }
                if self.ctx.strict and culprit_set(list.stricted) {
                    self.tolerate_unexpected_token(list.stricted, list.message)?;
                }
                let l = self.h.list_of(list.params);
                let n = n_arrow_function_expression(mut self.h, l, body, expression, is_async);
                expr = self.finalize(node, n)?;
                self.ctx.strict = previous_strict;
                self.ctx.allow_strict_directive = previous_allow_strict_directive;
                self.ctx.allow_yield = previous_allow_yield;
                self.ctx.allow_await = previous_await;
            }
        } else if self.match_assign() {
            if not self.ctx.is_assignment_target {
                self.tolerate_error("Invalid left-hand side in assignment", Vec.new())?;
            }
            if self.ctx.strict and self.h.ty_is(expr, "Identifier") {
                let name = self.h.text(expr, "name");
                if is_restricted(name) {
                    self.tolerate_unexpected(token, "Assignment to eval or arguments is not allowed in strict mode")?;
                }
                if is_strict_reserved(name) {
                    self.tolerate_unexpected(token, "Use of future reserved word in strict mode")?;
                }
            }
            if not self.is("=") {
                self.ctx.is_assignment_target = false;
                self.ctx.is_binding_element = false;
            } else {
                self.reinterpret_expression_as_pattern(expr);
            }
            token = self.next_token()?;
            let operator = tok_text(token);
            let right = self.isolate(Pf.Assignment)?;
            let m = self.start_node(start_token, 0);
            let n = n_assignment_expression(mut self.h, operator, expr, right);
            expr = self.finalize(m, n)?;
            self.ctx.first_cover_initialized_name_error = None;
        }
        Ok(expr)
    }

    // https://tc39.github.io/ecma262/#sec-comma-operator

    fn parse_expression(mut ref self) -> Result[i64, Fail] {
        let start_token = self.lookahead.clone();
        let mut expr = self.isolate(Pf.Assignment)?;
        if self.is(",") {
            let mut expressions: Vec[i64] = vec![expr];
            while self.lookahead.kind != T_EOF {
                if not self.is(",") {
                    break;
                }
                self.next_token()?;
                expressions.push(self.isolate(Pf.Assignment)?);
            }
            let m = self.start_node(start_token, 0);
            let l = self.h.list_of(expressions);
            let n = n_one(mut self.h, "SequenceExpression", "expressions", vlist(l));
            expr = self.finalize(m, n)?;
        }
        Ok(expr)
    }
}

fn sv_expr(v: own Sv) -> i64 {
    match v {
        Sv.Expr(n) => n,
        Sv.Op(_) => -1,
    }
}

fn sv_op(v: own Sv) -> String {
    match v {
        Sv.Op(s) => s,
        Sv.Expr(_) => String.new(),
    }
}
// ------------------------------------------------- parser: statements

fn str_in(s: ref String, set: ref Vec[Str]) -> bool {
    for k in set {
        if s == *k {
            return true;
        }
    }
    false
}

// Python's s[1:-1] on a token's raw text.
fn strip_quotes(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut out = String.new();
    let mut i = 1;
    while i < cs.len() - 1 {
        out.push(cs[i]);
        i += 1;
    }
    out
}

fn remove_label(set: ref Vec[String], key: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for k in set {
        if k != key {
            out.push(k.clone());
        }
    }
    out
}

impl JsParser {
    // https://tc39.github.io/ecma262/#sec-block

    fn parse_statement_list_item(mut ref self) -> Result[i64, Fail] {
        self.ctx.is_assignment_target = true;
        self.ctx.is_binding_element = true;
        if self.lookahead.kind == T_KEYWORD {
            let value = tok_text(self.lookahead);
            if value == "export" {
                if not self.ctx.is_module {
                    self.tolerate_unexpected(self.lookahead.clone(), "Unexpected token")?;
                }
                return self.parse_export_declaration();
            }
            if value == "import" {
                if self.match_import_call()? {
                    return self.parse_expression_statement();
                }
                if not self.ctx.is_module {
                    self.tolerate_unexpected(self.lookahead.clone(), "Unexpected token")?;
                }
                return self.parse_import_declaration();
            }
            if value == "const" {
                return self.parse_lexical_declaration(in_for(false));
            }
            if value == "function" {
                return self.parse_function_declaration(false);
            }
            if value == "class" {
                return self.parse_class_declaration(false);
            }
            if value == "let" {
                if self.is_lexical_declaration()? {
                    return self.parse_lexical_declaration(in_for(false));
                }
                return self.parse_statement();
            }
            return self.parse_statement();
        }
        self.parse_statement()
    }

    fn parse_block(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("{")?;
        let mut block: Vec[i64] = Vec.new();
        loop {
            if self.is("}") {
                break;
            }
            block.push(self.parse_statement_list_item()?);
        }
        self.expect("}")?;
        let l = self.h.list_of(block);
        let n = n_one(mut self.h, "BlockStatement", "body", vlist(l));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-let-and-const-declarations

    fn parse_lexical_binding(mut ref self, kind: ref String, options: ref Params) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut params: Vec[RawToken] = Vec.new();
        let id = self.parse_pattern(mut params, kind)?;
        if self.ctx.strict and self.h.ty_is(id, "Identifier") {
            if is_restricted(self.h.text(id, "name")) {
                self.tolerate_error("Variable name may not be eval or arguments in strict mode", Vec.new())?;
            }
        }
        let mut init = -1;
        if kind == "const" {
            if not self.is_kw("in") and not self.is_contextual("of") {
                if self.is("=") {
                    self.next_token()?;
                    init = self.isolate(Pf.Assignment)?;
                } else {
                    return Err(self.throw_error("Missing initializer in %0 declaration", vec!["const".to_string()]));
                }
            }
        } else if (not options.in_for and not self.h.ty_is(id, "Identifier")) or self.is("=") {
            self.expect("=")?;
            init = self.isolate(Pf.Assignment)?;
        }
        let n = n_two(mut self.h, "VariableDeclarator", "id", vobj(id), "init", vobj(init));
        self.finalize(node, n)
    }

    fn parse_binding_list(mut ref self, kind: ref String, options: ref Params) -> Result[Vec[i64], Fail] {
        let mut lst: Vec[i64] = vec![self.parse_lexical_binding(kind, options)?];
        while self.is(",") {
            self.next_token()?;
            lst.push(self.parse_lexical_binding(kind, options)?);
        }
        Ok(lst)
    }

    fn is_lexical_declaration(mut ref self) -> Result[bool, Fail] {
        let state = self.sc.save_state();
        self.sc.scan_comments()?;
        let next = self.sc.lex()?;
        self.sc.restore_state(state);
        Ok(next.kind == T_IDENTIFIER
            or (next.kind == T_PUNCTUATOR and tok_is(next, "["))
            or (next.kind == T_PUNCTUATOR and tok_is(next, "{"))
            or (next.kind == T_KEYWORD and tok_is(next, "let"))
            or (next.kind == T_KEYWORD and tok_is(next, "yield")))
    }

    fn parse_lexical_declaration(mut ref self, options: own Params) -> Result[i64, Fail] {
        let node = self.create_node();
        let kind = tok_text(self.next_token()?);
        if kind != "let" and kind != "const" {
            return Err(Fail.Crash("AssertionError: Lexical declaration must be either or const".to_string()));
        }
        let declarations = self.parse_binding_list(kind, options)?;
        self.consume_semicolon()?;
        let l = self.h.list_of(declarations);
        let n = n_two(mut self.h, "VariableDeclaration", "declarations", vlist(l), "kind", vstr(kind));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-destructuring-binding-patterns

    fn parse_binding_rest_element(mut ref self, params: mut ref Vec[RawToken], kind: ref String) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("...")?;
        let arg = self.parse_pattern(params, kind)?;
        let n = n_one(mut self.h, "RestElement", "argument", vobj(arg));
        self.finalize(node, n)
    }

    fn parse_array_pattern(mut ref self, params: mut ref Vec[RawToken], kind: ref String) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("[")?;
        let mut elements: Vec[Val] = Vec.new();
        while not self.is("]") {
            if self.is(",") {
                self.next_token()?;
                elements.push(Val.Null);
            } else {
                if self.is("...") {
                    elements.push(Val.Obj(self.parse_binding_rest_element(params, kind)?));
                    break;
                } else {
                    elements.push(Val.Obj(self.parse_pattern_with_default(params, kind)?));
                }
                if not self.is("]") {
                    self.expect(",")?;
                }
            }
        }
        self.expect("]")?;
        let l = self.h.list(elements);
        let n = n_one(mut self.h, "ArrayPattern", "elements", vlist(l));
        self.finalize(node, n)
    }

    fn parse_property_pattern(mut ref self, params: mut ref Vec[RawToken], kind: ref String) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut computed = false;
        let mut shorthand = false;
        let method = false;
        let mut key = -1;
        let mut value = -1;
        if self.lookahead.kind == T_IDENTIFIER {
            let key_token = self.lookahead.clone();
            key = self.parse_variable_identifier("".to_string())?;
            let n = n_identifier(mut self.h, tok_text(key_token));
            let init = self.finalize(node, n)?;
            if self.is("=") {
                params.push(key_token.clone());
                shorthand = true;
                self.next_token()?;
                let expr = self.parse_assignment_expression()?;
                let m = self.start_node(key_token, 0);
                let ap = n_assignment_pattern(mut self.h, init, expr);
                value = self.finalize(m, ap)?;
            } else if not self.is(":") {
                params.push(key_token);
                shorthand = true;
                value = init;
            } else {
                self.expect(":")?;
                value = self.parse_pattern_with_default(params, kind)?;
            }
        } else {
            computed = self.is("[");
            key = self.parse_object_property_key()?;
            self.expect(":")?;
            value = self.parse_pattern_with_default(params, kind)?;
        }
        let p = n_property(mut self.h, "init", key, computed, value, method, shorthand);
        self.finalize(node, p)
    }

    fn parse_rest_property(mut ref self, params: mut ref Vec[RawToken]) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("...")?;
        let arg = self.parse_pattern(params, "".to_string())?;
        if self.is("=") {
            return Err(self.throw_error("Unexpected token =", Vec.new()));
        }
        if not self.is("}") {
            return Err(self.throw_error("Unexpected token", Vec.new()));
        }
        let n = n_one(mut self.h, "RestElement", "argument", vobj(arg));
        self.finalize(node, n)
    }

    fn parse_object_pattern(mut ref self, params: mut ref Vec[RawToken], kind: ref String) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut properties: Vec[i64] = Vec.new();
        self.expect("{")?;
        while not self.is("}") {
            let p = if self.is("...") { self.parse_rest_property(params)? } else { self.parse_property_pattern(params, kind)? };
            properties.push(p);
            if not self.is("}") {
                self.expect(",")?;
            }
        }
        self.expect("}")?;
        let l = self.h.list_of(properties);
        let n = n_one(mut self.h, "ObjectPattern", "properties", vlist(l));
        self.finalize(node, n)
    }

    // kind "" is None
    fn parse_pattern(mut ref self, params: mut ref Vec[RawToken], kind: ref String) -> Result[i64, Fail] {
        if self.is("[") {
            return self.parse_array_pattern(params, kind);
        }
        if self.is("{") {
            return self.parse_object_pattern(params, kind);
        }
        if self.is_kw("let") and (kind == "const" or kind == "let") {
            self.tolerate_unexpected(self.lookahead.clone(), "let is disallowed as a lexically bound name")?;
        }
        params.push(self.lookahead.clone());
        self.parse_variable_identifier(kind.clone())
    }

    fn parse_pattern_with_default(mut ref self, params: mut ref Vec[RawToken], kind: ref String) -> Result[i64, Fail] {
        let start_token = self.lookahead.clone();
        let mut pattern = self.parse_pattern(params, kind)?;
        if self.is("=") {
            self.next_token()?;
            let previous_allow_yield = self.ctx.allow_yield;
            self.ctx.allow_yield = true;
            let right = self.isolate(Pf.Assignment)?;
            self.ctx.allow_yield = previous_allow_yield;
            let m = self.start_node(start_token, 0);
            let ap = n_assignment_pattern(mut self.h, pattern, right);
            pattern = self.finalize(m, ap)?;
        }
        Ok(pattern)
    }

    // https://tc39.github.io/ecma262/#sec-variable-statement

    fn parse_variable_identifier(mut ref self, kind: own String) -> Result[i64, Fail] {
        let node = self.create_node();
        let token = self.next_token()?;
        if token.kind == T_KEYWORD and tok_is(token, "yield") {
            if self.ctx.strict {
                self.tolerate_unexpected(token, "Use of future reserved word in strict mode")?;
            } else if not self.ctx.allow_yield {
                return Err(self.unexpected(token));
            }
        } else if token.kind != T_IDENTIFIER {
            if self.ctx.strict and token.kind == T_KEYWORD and is_strict_reserved(tok_text(token)) {
                self.tolerate_unexpected(token, "Use of future reserved word in strict mode")?;
            } else {
                if self.ctx.strict or not tok_is(token, "let") or kind != "var" {
                    return Err(self.unexpected(token));
                }
            }
        } else if (self.ctx.is_module or self.ctx.allow_await) and token.kind == T_IDENTIFIER and tok_is(token, "await") {
            self.tolerate_unexpected(token, "")?;
        }
        let n = n_identifier(mut self.h, tok_text(token));
        self.finalize(node, n)
    }

    fn parse_variable_declaration(mut ref self, options: ref Params) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut params: Vec[RawToken] = Vec.new();
        let id = self.parse_pattern(mut params, "var".to_string())?;
        if self.ctx.strict and self.h.ty_is(id, "Identifier") {
            if is_restricted(self.h.text(id, "name")) {
                self.tolerate_error("Variable name may not be eval or arguments in strict mode", Vec.new())?;
            }
        }
        let mut init = -1;
        if self.is("=") {
            self.next_token()?;
            init = self.isolate(Pf.Assignment)?;
        } else if not self.h.ty_is(id, "Identifier") and not options.in_for {
            self.expect("=")?;
        }
        let n = n_two(mut self.h, "VariableDeclarator", "id", vobj(id), "init", vobj(init));
        self.finalize(node, n)
    }

    fn parse_variable_declaration_list(mut ref self, options: own Params) -> Result[Vec[i64], Fail] {
        let opt = in_for(options.in_for);
        let mut lst: Vec[i64] = Vec.new();
        lst.push(self.parse_variable_declaration(opt)?);
        while self.is(",") {
            self.next_token()?;
            lst.push(self.parse_variable_declaration(opt)?);
        }
        Ok(lst)
    }

    fn parse_variable_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("var")?;
        let declarations = self.parse_variable_declaration_list(in_for(false))?;
        self.consume_semicolon()?;
        let l = self.h.list_of(declarations);
        let n = n_two(mut self.h, "VariableDeclaration", "declarations", vlist(l), "kind", vs("var"));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-empty-statement

    fn parse_empty_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect(";")?;
        let n = nd(mut self.h, "EmptyStatement", "EmptyStatement");
        self.finalize(node, n)
    }

    fn empty_after_tolerated(mut ref self) -> Result[i64, Fail] {
        let t = self.next_token()?;
        self.tolerate_unexpected(t, "")?;
        let m = self.create_node();
        let n = nd(mut self.h, "EmptyStatement", "EmptyStatement");
        self.finalize(m, n)
    }

    // https://tc39.github.io/ecma262/#sec-expression-statement

    fn parse_expression_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let expr = self.parse_expression()?;
        self.consume_semicolon()?;
        let n = n_one(mut self.h, "ExpressionStatement", "expression", vobj(expr));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-if-statement

    fn parse_if_clause(mut ref self) -> Result[i64, Fail] {
        if self.ctx.strict and self.is_kw("function") {
            self.tolerate_error("In strict mode code, functions can only be declared at top level or inside a block", Vec.new())?;
        }
        self.parse_statement()
    }

    fn parse_if_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut alternate = -1;
        let mut consequent = -1;
        self.expect_keyword("if")?;
        self.expect("(")?;
        let test = self.parse_expression()?;
        if not self.is(")") and self.cfg.tolerant {
            consequent = self.empty_after_tolerated()?;
        } else {
            self.expect(")")?;
            consequent = self.parse_if_clause()?;
            if self.is_kw("else") {
                self.next_token()?;
                alternate = self.parse_if_clause()?;
            }
        }
        let n = n_three(mut self.h, "IfStatement", "test", vobj(test), "consequent", vobj(consequent), "alternate", vobj(alternate));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-do-while-statement

    fn parse_do_while_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("do")?;
        let previous_in_iteration = self.ctx.in_iteration;
        self.ctx.in_iteration = true;
        let body = self.parse_statement()?;
        self.ctx.in_iteration = previous_in_iteration;
        self.expect_keyword("while")?;
        self.expect("(")?;
        let test = self.parse_expression()?;
        if not self.is(")") and self.cfg.tolerant {
            let t = self.next_token()?;
            self.tolerate_unexpected(t, "")?;
        } else {
            self.expect(")")?;
            if self.is(";") {
                self.next_token()?;
            }
        }
        let n = n_two(mut self.h, "DoWhileStatement", "body", vobj(body), "test", vobj(test));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-while-statement

    fn parse_while_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("while")?;
        self.expect("(")?;
        let test = self.parse_expression()?;
        let mut body = -1;
        if not self.is(")") and self.cfg.tolerant {
            body = self.empty_after_tolerated()?;
        } else {
            self.expect(")")?;
            let previous_in_iteration = self.ctx.in_iteration;
            self.ctx.in_iteration = true;
            body = self.parse_statement()?;
            self.ctx.in_iteration = previous_in_iteration;
        }
        let n = n_two(mut self.h, "WhileStatement", "test", vobj(test), "body", vobj(body));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-for-statement
    // https://tc39.github.io/ecma262/#sec-for-in-and-for-of-statements

    fn declaration(mut ref self, marker: Marker, declarations: ref Vec[i64], kind: ref String) -> Result[i64, Fail] {
        let l = self.h.list_of(declarations);
        let n = n_two(mut self.h, "VariableDeclaration", "declarations", vlist(l), "kind", vstr(kind));
        self.finalize(marker, n)
    }

    fn init_is_none(ref self, decl: i64) -> bool {
        match self.h.get(decl, "init") {
            Val.Null => true,
            _ => false,
        }
    }

    fn parse_for_statement(mut ref self) -> Result[i64, Fail] {
        let mut init = -1;
        let mut test = -1;
        let mut update = -1;
        let mut for_in = true;
        let mut left = -1;
        let mut right = -1;
        let node = self.create_node();
        self.expect_keyword("for")?;
        self.expect("(")?;
        if self.is(";") {
            self.next_token()?;
        } else {
            if self.is_kw("var") {
                let init_marker = self.create_node();
                self.next_token()?;
                let previous_allow_in = self.ctx.allow_in;
                self.ctx.allow_in = false;
                let declarations = self.parse_variable_declaration_list(in_for(true))?;
                self.ctx.allow_in = previous_allow_in;
                let var = "var".to_string();
                if declarations.len() == 1 and self.is_kw("in") {
                    let decl = declarations[0];
                    let did = self.h.node(decl, "id");
                    if truthy(self.h, self.h.get(decl, "init"))
                        and (self.h.ty_is(did, "ArrayPattern") or self.h.ty_is(did, "ObjectPattern") or self.ctx.strict) {
                        self.tolerate_error("%0 loop variable declaration may not have an initializer", vec!["for-in".to_string()])?;
                    }
                    init = self.declaration(init_marker, declarations, var)?;
                    self.next_token()?;
                    left = init;
                    right = self.parse_expression()?;
                    init = -1;
                } else if declarations.len() == 1 and self.init_is_none(declarations[0]) and self.is_contextual("of") {
                    init = self.declaration(init_marker, declarations, var)?;
                    self.next_token()?;
                    left = init;
                    right = self.parse_assignment_expression()?;
                    init = -1;
                    for_in = false;
                } else {
                    init = self.declaration(init_marker, declarations, var)?;
                    self.expect(";")?;
                }
            } else if self.is_kw("const") or self.is_kw("let") {
                let init_marker = self.create_node();
                let kind = tok_text(self.next_token()?);
                if not self.ctx.strict and val_is_str(self.lookahead.value, "in") {
                    let id = n_identifier(mut self.h, kind);
                    init = self.finalize(init_marker, id)?;
                    self.next_token()?;
                    left = init;
                    right = self.parse_expression()?;
                    init = -1;
                } else {
                    let previous_allow_in = self.ctx.allow_in;
                    self.ctx.allow_in = false;
                    let declarations = self.parse_binding_list(kind, in_for(true))?;
                    self.ctx.allow_in = previous_allow_in;
                    if declarations.len() == 1 and self.init_is_none(declarations[0]) and self.is_kw("in") {
                        init = self.declaration(init_marker, declarations, kind)?;
                        self.next_token()?;
                        left = init;
                        right = self.parse_expression()?;
                        init = -1;
                    } else if declarations.len() == 1 and self.init_is_none(declarations[0]) and self.is_contextual("of") {
                        init = self.declaration(init_marker, declarations, kind)?;
                        self.next_token()?;
                        left = init;
                        right = self.parse_assignment_expression()?;
                        init = -1;
                        for_in = false;
                    } else {
                        self.consume_semicolon()?;
                        init = self.declaration(init_marker, declarations, kind)?;
                    }
                }
            } else {
                let init_start_token = self.lookahead.clone();
                let previous_allow_in = self.ctx.allow_in;
                self.ctx.allow_in = false;
                init = self.inherit(Pf.Assignment)?;
                self.ctx.allow_in = previous_allow_in;
                if self.is_kw("in") {
                    if not self.ctx.is_assignment_target or self.h.ty_is(init, "AssignmentExpression") {
                        self.tolerate_error("Invalid left-hand side in for-in", Vec.new())?;
                    }
                    self.next_token()?;
                    self.reinterpret_expression_as_pattern(init);
                    left = init;
                    right = self.parse_expression()?;
                    init = -1;
                } else if self.is_contextual("of") {
                    if not self.ctx.is_assignment_target or self.h.ty_is(init, "AssignmentExpression") {
                        self.tolerate_error("Invalid left-hand side in for-loop", Vec.new())?;
                    }
                    self.next_token()?;
                    self.reinterpret_expression_as_pattern(init);
                    left = init;
                    right = self.parse_assignment_expression()?;
                    init = -1;
                    for_in = false;
                } else {
                    if self.is(",") {
                        let mut init_seq: Vec[i64] = vec![init];
                        while self.is(",") {
                            self.next_token()?;
                            init_seq.push(self.isolate(Pf.Assignment)?);
                        }
                        let m = self.start_node(init_start_token, 0);
                        let l = self.h.list_of(init_seq);
                        let seq = n_one(mut self.h, "SequenceExpression", "expressions", vlist(l));
                        init = self.finalize(m, seq)?;
                    }
                    self.expect(";")?;
                }
            }
        }
        if left < 0 {
            if not self.is(";") {
                test = self.parse_expression()?;
            }
            self.expect(";")?;
            if not self.is(")") {
                update = self.parse_expression()?;
            }
        }
        let mut body = -1;
        if not self.is(")") and self.cfg.tolerant {
            body = self.empty_after_tolerated()?;
        } else {
            self.expect(")")?;
            let previous_in_iteration = self.ctx.in_iteration;
            self.ctx.in_iteration = true;
            body = self.isolate(Pf.Statement)?;
            self.ctx.in_iteration = previous_in_iteration;
        }
        if left < 0 {
            let n = n_for_statement(mut self.h, init, test, update, body);
            return self.finalize(node, n);
        }
        if for_in {
            let n = n_for_in_statement(mut self.h, left, right, body);
            return self.finalize(node, n);
        }
        let n = n_three(mut self.h, "ForOfStatement", "left", vobj(left), "right", vobj(right), "body", vobj(body));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-continue-statement

    fn parse_continue_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("continue")?;
        let mut label = -1;
        if self.lookahead.kind == T_IDENTIFIER and not self.has_line_terminator {
            let id = self.parse_variable_identifier("".to_string())?;
            label = id;
            let name = self.h.text(id, "name");
            if not contains(self.ctx.label_set, name) {
                return Err(self.throw_error("Undefined label '%0'", vec![name]));
            }
        }
        self.consume_semicolon()?;
        if label < 0 and not self.ctx.in_iteration {
            return Err(self.throw_error("Illegal continue statement", Vec.new()));
        }
        let n = n_one(mut self.h, "ContinueStatement", "label", vobj(label));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-break-statement

    fn parse_break_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("break")?;
        let mut label = -1;
        if self.lookahead.kind == T_IDENTIFIER and not self.has_line_terminator {
            let id = self.parse_variable_identifier("".to_string())?;
            let name = self.h.text(id, "name");
            if not contains(self.ctx.label_set, name) {
                return Err(self.throw_error("Undefined label '%0'", vec![name]));
            }
            label = id;
        }
        self.consume_semicolon()?;
        if label < 0 and not self.ctx.in_iteration and not self.ctx.in_switch {
            return Err(self.throw_error("Illegal break statement", Vec.new()));
        }
        let n = n_one(mut self.h, "BreakStatement", "label", vobj(label));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-return-statement

    fn parse_return_statement(mut ref self) -> Result[i64, Fail] {
        if not self.ctx.in_function_body {
            self.tolerate_error("Illegal return statement", Vec.new())?;
        }
        let node = self.create_node();
        self.expect_keyword("return")?;
        let has_argument = (not self.is(";") and not self.is("}") and not self.has_line_terminator
            and self.lookahead.kind != T_EOF)
            or self.lookahead.kind == T_STRING
            or self.lookahead.kind == T_TEMPLATE;
        let argument = if has_argument { self.parse_expression()? } else { -1 };
        self.consume_semicolon()?;
        let n = n_one(mut self.h, "ReturnStatement", "argument", vobj(argument));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-with-statement

    fn parse_with_statement(mut ref self) -> Result[i64, Fail] {
        if self.ctx.strict {
            self.tolerate_error("Strict mode code may not include a with statement", Vec.new())?;
        }
        let node = self.create_node();
        self.expect_keyword("with")?;
        self.expect("(")?;
        let object = self.parse_expression()?;
        let mut body = -1;
        if not self.is(")") and self.cfg.tolerant {
            body = self.empty_after_tolerated()?;
        } else {
            self.expect(")")?;
            body = self.parse_statement()?;
        }
        let n = n_two(mut self.h, "WithStatement", "object", vobj(object), "body", vobj(body));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-switch-statement

    fn parse_switch_case(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut test = -1;
        if self.is_kw("default") {
            self.next_token()?;
        } else {
            self.expect_keyword("case")?;
            test = self.parse_expression()?;
        }
        self.expect(":")?;
        let mut consequent: Vec[i64] = Vec.new();
        loop {
            if self.is("}") or self.is_kw("default") or self.is_kw("case") {
                break;
            }
            consequent.push(self.parse_statement_list_item()?);
        }
        let l = self.h.list_of(consequent);
        let n = n_two(mut self.h, "SwitchCase", "test", vobj(test), "consequent", vlist(l));
        self.finalize(node, n)
    }

    fn parse_switch_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("switch")?;
        self.expect("(")?;
        let discriminant = self.parse_expression()?;
        self.expect(")")?;
        let previous_in_switch = self.ctx.in_switch;
        self.ctx.in_switch = true;
        let mut cases: Vec[i64] = Vec.new();
        let mut default_found = false;
        self.expect("{")?;
        loop {
            if self.is("}") {
                break;
            }
            let clause = self.parse_switch_case()?;
            if self.init_is_none_key(clause, "test") {
                if default_found {
                    return Err(self.throw_error("More than one default clause in switch statement", Vec.new()));
                }
                default_found = true;
            }
            cases.push(clause);
        }
        self.expect("}")?;
        self.ctx.in_switch = previous_in_switch;
        let l = self.h.list_of(cases);
        let n = n_two(mut self.h, "SwitchStatement", "discriminant", vobj(discriminant), "cases", vlist(l));
        self.finalize(node, n)
    }

    fn init_is_none_key(ref self, n: i64, key: Str) -> bool {
        match self.h.get(n, key) {
            Val.Null => true,
            _ => false,
        }
    }

    // https://tc39.github.io/ecma262/#sec-labelled-statements

    fn parse_labelled_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let expr = self.parse_expression()?;
        let mut statement = -1;
        if self.h.ty_is(expr, "Identifier") and self.is(":") {
            self.next_token()?;
            let id = expr;
            let key = self.h.text(id, "name");
            if contains(self.ctx.label_set, key) {
                return Err(self.throw_error("%0 '%1' has already been declared", vec!["Label".to_string(), key]));
            }
            self.ctx.label_set.push(key.clone());
            let mut body = -1;
            if self.is_kw("class") {
                self.tolerate_unexpected(self.lookahead.clone(), "")?;
                body = self.parse_class_declaration(false)?;
            } else if self.is_kw("function") {
                let token = self.lookahead.clone();
                let declaration = self.parse_function_declaration(false)?;
                if self.ctx.strict {
                    self.tolerate_unexpected(token, "In strict mode code, functions can only be declared at top level or inside a block")?;
                } else if truthy(self.h, self.h.get(declaration, "generator")) {
                    self.tolerate_unexpected(token, "Generator declarations are not allowed in legacy contexts")?;
                }
                body = declaration;
            } else {
                body = self.parse_statement()?;
            }
            self.ctx.label_set = remove_label(self.ctx.label_set, key);
            statement = n_two(mut self.h, "LabeledStatement", "label", vobj(id), "body", vobj(body));
        } else {
            self.consume_semicolon()?;
            statement = n_one(mut self.h, "ExpressionStatement", "expression", vobj(expr));
        }
        self.finalize(node, statement)
    }

    // https://tc39.github.io/ecma262/#sec-throw-statement

    fn parse_throw_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("throw")?;
        if self.has_line_terminator {
            return Err(self.throw_error("Illegal newline after throw", Vec.new()));
        }
        let argument = self.parse_expression()?;
        self.consume_semicolon()?;
        let n = n_one(mut self.h, "ThrowStatement", "argument", vobj(argument));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-try-statement

    fn parse_catch_clause(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("catch")?;
        self.expect("(")?;
        if self.is(")") {
            return Err(self.unexpected(self.lookahead));
        }
        let mut params: Vec[RawToken] = Vec.new();
        let param = self.parse_pattern(mut params, "".to_string())?;
        let mut param_map: Vec[String] = Vec.new();
        for p in params.iter() {
            let key = py_str(p.value);
            if contains(param_map, key) {
                self.tolerate_error("Duplicate binding %0", vec![key.clone()])?;
            }
            param_map.push(key);
        }
        if self.ctx.strict and self.h.ty_is(param, "Identifier") {
            if is_restricted(self.h.text(param, "name")) {
                self.tolerate_error("Catch variable may not be eval or arguments in strict mode", Vec.new())?;
            }
        }
        self.expect(")")?;
        let body = self.parse_block()?;
        let n = n_two(mut self.h, "CatchClause", "param", vobj(param), "body", vobj(body));
        self.finalize(node, n)
    }

    fn parse_finally_clause(mut ref self) -> Result[i64, Fail] {
        self.expect_keyword("finally")?;
        self.parse_block()
    }

    fn parse_try_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("try")?;
        let block = self.parse_block()?;
        let handler = if self.is_kw("catch") { self.parse_catch_clause()? } else { -1 };
        let finalizer = if self.is_kw("finally") { self.parse_finally_clause()? } else { -1 };
        if handler < 0 and finalizer < 0 {
            return Err(self.throw_error("Missing catch or finally after try", Vec.new()));
        }
        let n = n_three(mut self.h, "TryStatement", "block", vobj(block), "handler", vobj(handler), "finalizer", vobj(finalizer));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-debugger-statement

    fn parse_debugger_statement(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("debugger")?;
        self.consume_semicolon()?;
        let n = nd(mut self.h, "DebuggerStatement", "DebuggerStatement");
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-ecmascript-language-statements-and-declarations

    fn parse_statement(mut ref self) -> Result[i64, Fail] {
        let typ = self.lookahead.kind;
        if typ == T_BOOLEAN or typ == T_NULL or typ == T_NUMERIC or typ == T_STRING or typ == T_TEMPLATE or typ == T_REGEX {
            return self.parse_expression_statement();
        }
        if typ == T_PUNCTUATOR {
            let value = tok_text(self.lookahead);
            if value == "{" {
                return self.parse_block();
            }
            if value == ";" {
                return self.parse_empty_statement();
            }
            return self.parse_expression_statement();
        }
        if typ == T_IDENTIFIER {
            if self.match_async_function()? {
                return self.parse_function_declaration(false);
            }
            return self.parse_labelled_statement();
        }
        if typ == T_KEYWORD {
            let value = tok_text(self.lookahead);
            if value == "break" {
                return self.parse_break_statement();
            }
            if value == "continue" {
                return self.parse_continue_statement();
            }
            if value == "debugger" {
                return self.parse_debugger_statement();
            }
            if value == "do" {
                return self.parse_do_while_statement();
            }
            if value == "for" {
                return self.parse_for_statement();
            }
            if value == "function" {
                return self.parse_function_declaration(false);
            }
            if value == "if" {
                return self.parse_if_statement();
            }
            if value == "return" {
                return self.parse_return_statement();
            }
            if value == "switch" {
                return self.parse_switch_statement();
            }
            if value == "throw" {
                return self.parse_throw_statement();
            }
            if value == "try" {
                return self.parse_try_statement();
            }
            if value == "var" {
                return self.parse_variable_statement();
            }
            if value == "while" {
                return self.parse_while_statement();
            }
            if value == "with" {
                return self.parse_with_statement();
            }
            return self.parse_expression_statement();
        }
        Err(self.unexpected(self.lookahead))
    }

    // https://tc39.github.io/ecma262/#sec-function-definitions

    fn parse_function_source_elements(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("{")?;
        let mut body = self.parse_directive_prologues()?;
        let previous_label_set = self.ctx.label_set.clone();
        let previous_in_iteration = self.ctx.in_iteration;
        let previous_in_switch = self.ctx.in_switch;
        let previous_in_function_body = self.ctx.in_function_body;
        self.ctx.label_set = Vec.new();
        self.ctx.in_iteration = false;
        self.ctx.in_switch = false;
        self.ctx.in_function_body = true;
        while self.lookahead.kind != T_EOF {
            if self.is("}") {
                break;
            }
            body.push(self.parse_statement_list_item()?);
        }
        self.expect("}")?;
        self.ctx.label_set = previous_label_set;
        self.ctx.in_iteration = previous_in_iteration;
        self.ctx.in_switch = previous_in_switch;
        self.ctx.in_function_body = previous_in_function_body;
        let l = self.h.list_of(body);
        let n = n_one(mut self.h, "BlockStatement", "body", vlist(l));
        self.finalize(node, n)
    }

    fn validate_param(mut ref self, options: mut ref Params, param: own Culprit, name: ref String) {
        if self.ctx.strict {
            if is_restricted(name) {
                options.stricted = param.clone();
                options.message = "Parameter name eval or arguments is not allowed in strict mode".to_string();
            }
            if contains(options.param_set, name) {
                options.stricted = param.clone();
                options.message = "Strict mode function may not have duplicate parameter names".to_string();
            }
        } else if not culprit_set(options.first_restricted) {
            if is_restricted(name) {
                options.first_restricted = param.clone();
                options.message = "Parameter name eval or arguments is not allowed in strict mode".to_string();
            } else if is_strict_reserved(name) {
                options.first_restricted = param.clone();
                options.message = "Use of future reserved word in strict mode".to_string();
            } else if contains(options.param_set, name) {
                options.stricted = param.clone();
                options.message = "Strict mode function may not have duplicate parameter names".to_string();
            }
        }
        options.param_set.push(name.clone());
    }

    fn parse_rest_element(mut ref self, params: mut ref Vec[RawToken]) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("...")?;
        let arg = self.parse_pattern(params, "".to_string())?;
        if self.is("=") {
            return Err(self.throw_error("Unexpected token =", Vec.new()));
        }
        if not self.is(")") {
            return Err(self.throw_error("Rest parameter must be last formal parameter", Vec.new()));
        }
        let n = n_one(mut self.h, "RestElement", "argument", vobj(arg));
        self.finalize(node, n)
    }

    fn parse_formal_parameter(mut ref self, options: mut ref Params) -> Result[(), Fail] {
        let mut params: Vec[RawToken] = Vec.new();
        let param = if self.is("...") {
            self.parse_rest_element(mut params)?
        } else {
            self.parse_pattern_with_default(mut params, "".to_string())?
        };
        for p in params.iter() {
            self.validate_param(options, Culprit.Tok(p.clone()), tok_text(p));
        }
        options.simple = options.simple and self.h.cls_is(param, "Identifier");
        options.params.push(param);
        Ok(())
    }

    fn parse_formal_parameters(mut ref self, first_restricted: own Culprit) -> Result[Params, Fail] {
        let mut options = new_params();
        options.first_restricted = first_restricted;
        self.expect("(")?;
        if not self.is(")") {
            while self.lookahead.kind != T_EOF {
                self.parse_formal_parameter(mut options)?;
                if self.is(")") {
                    break;
                }
                self.expect(",")?;
                if self.is(")") {
                    break;
                }
            }
        }
        self.expect(")")?;
        let mut out = new_params();
        out.simple = options.simple;
        out.params = options.params;
        out.stricted = options.stricted;
        out.first_restricted = options.first_restricted;
        out.message = options.message;
        Ok(out)
    }

    fn match_async_function(mut ref self) -> Result[bool, Fail] {
        let mut m = self.is_contextual("async");
        if m {
            let state = self.sc.save_state();
            let line = state.line;
            self.sc.scan_comments()?;
            let next = self.sc.lex()?;
            self.sc.restore_state(state);
            m = line == next.line and next.kind == T_KEYWORD and tok_is(next, "function");
        }
        Ok(m)
    }

    // The function name's restriction, as parseFunctionDeclaration and
    // parseFunctionExpression record it.
    fn name_restriction(mut ref self, token: ref RawToken, first_restricted: mut ref Culprit, message: mut ref String) -> Result[(), Fail] {
        let name = py_str(token.value);
        if self.ctx.strict {
            if is_restricted(name) {
                self.tolerate_unexpected(token, "Function name may not be eval or arguments in strict mode")?;
            }
        } else {
            if is_restricted(name) {
                *first_restricted = Culprit.Tok(token.clone());
                *message = "Function name may not be eval or arguments in strict mode".to_string();
            } else if is_strict_reserved(name) {
                *first_restricted = Culprit.Tok(token.clone());
                *message = "Use of future reserved word in strict mode".to_string();
            }
        }
        Ok(())
    }

    // The shared tail of a function declaration or expression: the body
    // and the strict-mode checks on the name and parameters.
    fn function_body(mut ref self, formal: ref Params, name_message: ref String) -> Result[i64, Fail] {
        let message = if formal.message.is_empty() { name_message.clone() } else { formal.message.clone() };
        let previous_strict = self.ctx.strict;
        let previous_allow_strict_directive = self.ctx.allow_strict_directive;
        self.ctx.allow_strict_directive = formal.simple;
        let body = self.parse_function_source_elements()?;
        if self.ctx.strict and culprit_set(formal.first_restricted) {
            return Err(self.throw_unexpected_token(formal.first_restricted, message));
        }
        if self.ctx.strict and culprit_set(formal.stricted) {
            self.tolerate_unexpected_token(formal.stricted, message)?;
        }
        self.ctx.strict = previous_strict;
        self.ctx.allow_strict_directive = previous_allow_strict_directive;
        Ok(body)
    }

    fn parse_function_declaration(mut ref self, identifier_is_optional: bool) -> Result[i64, Fail] {
        let node = self.create_node();
        let is_async = self.is_contextual("async");
        if is_async {
            self.next_token()?;
        }
        self.expect_keyword("function")?;
        let is_generator = if is_async { false } else { self.is("*") };
        if is_generator {
            self.next_token()?;
        }
        let mut id = -1;
        let mut first_restricted = Culprit.NoTok;
        let mut message = String.new();
        if not identifier_is_optional or not self.is("(") {
            let token = self.lookahead.clone();
            id = self.parse_variable_identifier("".to_string())?;
            self.name_restriction(token, mut first_restricted, mut message)?;
        }
        let previous_allow_await = self.ctx.allow_await;
        let previous_allow_yield = self.ctx.allow_yield;
        self.ctx.allow_await = is_async;
        self.ctx.allow_yield = not is_generator;
        let formal = self.parse_formal_parameters(first_restricted)?;
        let body = self.function_body(formal, message)?;
        self.ctx.allow_await = previous_allow_await;
        self.ctx.allow_yield = previous_allow_yield;
        let l = self.h.list_of(formal.params);
        if is_async {
            let n = n_async_function(mut self.h, "AsyncFunctionDeclaration", "FunctionDeclaration", id, l, body);
            return self.finalize(node, n);
        }
        let n = n_function(mut self.h, "FunctionDeclaration", id, l, body, is_generator);
        self.finalize(node, n)
    }

    fn parse_function_expression(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let is_async = self.is_contextual("async");
        if is_async {
            self.next_token()?;
        }
        self.expect_keyword("function")?;
        let is_generator = if is_async { false } else { self.is("*") };
        if is_generator {
            self.next_token()?;
        }
        let mut id = -1;
        let mut first_restricted = Culprit.NoTok;
        let mut message = String.new();
        let previous_allow_await = self.ctx.allow_await;
        let previous_allow_yield = self.ctx.allow_yield;
        self.ctx.allow_await = is_async;
        self.ctx.allow_yield = not is_generator;
        if not self.is("(") {
            let token = self.lookahead.clone();
            id = if not self.ctx.strict and not is_generator and self.is_kw("yield") {
                self.parse_identifier_name()?
            } else {
                self.parse_variable_identifier("".to_string())?
            };
            self.name_restriction(token, mut first_restricted, mut message)?;
        }
        let formal = self.parse_formal_parameters(first_restricted)?;
        let body = self.function_body(formal, message)?;
        self.ctx.allow_await = previous_allow_await;
        self.ctx.allow_yield = previous_allow_yield;
        let l = self.h.list_of(formal.params);
        if is_async {
            let n = n_async_function(mut self.h, "AsyncFunctionExpression", "FunctionExpression", id, l, body);
            return self.finalize(node, n);
        }
        let n = n_function(mut self.h, "FunctionExpression", id, l, body, is_generator);
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-directive-prologues-and-the-use-strict-directive

    fn parse_directive(mut ref self) -> Result[i64, Fail] {
        let token = self.lookahead.clone();
        let node = self.create_node();
        let expr = self.parse_expression()?;
        let directive = if self.h.ty_is(expr, "Literal") { strip_quotes(self.get_token_raw(token)) } else { String.new() };
        self.consume_semicolon()?;
        let n = if not directive.is_empty() {
            n_directive(mut self.h, expr, directive)
        } else {
            n_one(mut self.h, "ExpressionStatement", "expression", vobj(expr))
        };
        self.finalize(node, n)
    }

    fn parse_directive_prologues(mut ref self) -> Result[Vec[i64], Fail] {
        let mut first_restricted: Option[RawToken] = None;
        let mut body: Vec[i64] = Vec.new();
        loop {
            let token = self.lookahead.clone();
            if token.kind != T_STRING {
                break;
            }
            let statement = self.parse_directive()?;
            body.push(statement);
            if not self.h.cls_is(statement, "Directive") {
                break;
            }
            let directive = self.h.text(statement, "directive");
            if directive == "use strict" {
                self.ctx.strict = true;
                if let Some(t) = first_restricted.clone() {
                    self.tolerate_unexpected(t, "Octal literals are not allowed in strict mode.")?;
                }
                if not self.ctx.allow_strict_directive {
                    self.tolerate_unexpected(token, "Illegal 'use strict' directive in function with non-simple parameter list")?;
                }
            } else {
                if first_restricted.is_none() and token.octal {
                    first_restricted = Some(token.clone());
                }
            }
        }
        Ok(body)
    }

    // https://tc39.github.io/ecma262/#sec-method-definitions

    fn qualified_property_name(ref self, token: ref RawToken) -> bool {
        let typ = token.kind;
        if typ == T_IDENTIFIER or typ == T_STRING or typ == T_BOOLEAN or typ == T_NULL or typ == T_NUMERIC or typ == T_KEYWORD {
            return true;
        }
        if typ == T_PUNCTUATOR {
            return tok_is(token, "[");
        }
        false
    }

    fn parse_getter_method(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let is_generator = false;
        let previous_allow_yield = self.ctx.allow_yield;
        self.ctx.allow_yield = not is_generator;
        let formal = self.parse_formal_parameters(Culprit.NoTok)?;
        if formal.params.len() > 0 {
            self.tolerate_error("Getter must not have any formal parameters", Vec.new())?;
        }
        let method = self.parse_property_method(formal)?;
        self.ctx.allow_yield = previous_allow_yield;
        let l = self.h.list_of(formal.params);
        let n = n_function(mut self.h, "FunctionExpression", -1, l, method, is_generator);
        self.finalize(node, n)
    }

    fn parse_setter_method(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let is_generator = false;
        let previous_allow_yield = self.ctx.allow_yield;
        self.ctx.allow_yield = not is_generator;
        let formal = self.parse_formal_parameters(Culprit.NoTok)?;
        if formal.params.len() != 1 {
            self.tolerate_error("Setter must have exactly one formal parameter", Vec.new())?;
        } else if self.h.cls_is(formal.params[0], "RestElement") {
            self.tolerate_error("Setter function argument must not be a rest parameter", Vec.new())?;
        }
        let method = self.parse_property_method(formal)?;
        self.ctx.allow_yield = previous_allow_yield;
        let l = self.h.list_of(formal.params);
        let n = n_function(mut self.h, "FunctionExpression", -1, l, method, is_generator);
        self.finalize(node, n)
    }

    fn parse_generator_method(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let is_generator = true;
        let previous_allow_yield = self.ctx.allow_yield;
        self.ctx.allow_yield = true;
        let params = self.parse_formal_parameters(Culprit.NoTok)?;
        self.ctx.allow_yield = false;
        let method = self.parse_property_method(params)?;
        self.ctx.allow_yield = previous_allow_yield;
        let l = self.h.list_of(params.params);
        let n = n_function(mut self.h, "FunctionExpression", -1, l, method, is_generator);
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-generator-function-definitions

    fn is_start_of_expression(ref self) -> bool {
        let mut start = true;
        let value = tok_text(self.lookahead);
        let typ = self.lookahead.kind;
        if typ == T_PUNCTUATOR {
            start = str_in(value, vec!["[", "(", "{", "+", "-", "!", "~", "++", "--", "/", "/="]);
        } else if typ == T_KEYWORD {
            start = str_in(value, vec!["class", "delete", "function", "let", "new", "super", "this", "typeof", "void", "yield"]);
        }
        start
    }

    fn parse_yield_expression(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect_keyword("yield")?;
        let mut argument = -1;
        let mut delegate = false;
        if not self.has_line_terminator {
            let previous_allow_yield = self.ctx.allow_yield;
            self.ctx.allow_yield = false;
            delegate = self.is("*");
            if delegate {
                self.next_token()?;
                argument = self.parse_assignment_expression()?;
            } else if self.is_start_of_expression() {
                argument = self.parse_assignment_expression()?;
            }
            self.ctx.allow_yield = previous_allow_yield;
        }
        let n = n_two(mut self.h, "YieldExpression", "argument", vobj(argument), "delegate", Val.Bool(delegate));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-class-definitions

    fn parse_class_element(mut ref self, has_constructor: mut ref bool) -> Result[i64, Fail] {
        let mut token = self.lookahead.clone();
        let node = self.create_node();
        let mut kind = "";
        let mut key = -1;
        let mut value = -1;
        let mut computed = false;
        let mut is_static = false;
        let mut is_async = false;
        if self.is("*") {
            self.next_token()?;
        } else {
            computed = self.is("[");
            key = self.parse_object_property_key()?;
            let id = key;
            if val_is_str(self.h.get(id, "name"), "static") and (self.qualified_property_name(self.lookahead) or self.is("*")) {
                token = self.lookahead.clone();
                is_static = true;
                computed = self.is("[");
                if self.is("*") {
                    self.next_token()?;
                } else {
                    key = self.parse_object_property_key()?;
                }
            }
            if token.kind == T_IDENTIFIER and not self.has_line_terminator and tok_is(token, "async") {
                let punctuator = self.lookahead.value.clone();
                if not val_is_str(punctuator, ":") and not val_is_str(punctuator, "(") and not val_is_str(punctuator, "*") {
                    is_async = true;
                    token = self.lookahead.clone();
                    key = self.parse_object_property_key()?;
                    if token.kind == T_IDENTIFIER and tok_is(token, "constructor") {
                        self.tolerate_unexpected(token, "Class constructor may not be an async method")?;
                    }
                }
            }
        }
        let lookahead_property_key = self.qualified_property_name(self.lookahead);
        if token.kind == T_IDENTIFIER {
            if tok_is(token, "get") and lookahead_property_key {
                kind = "get";
                computed = self.is("[");
                key = self.parse_object_property_key()?;
                self.ctx.allow_yield = false;
                value = self.parse_getter_method()?;
            } else if tok_is(token, "set") and lookahead_property_key {
                kind = "set";
                computed = self.is("[");
                key = self.parse_object_property_key()?;
                value = self.parse_setter_method()?;
            } else if self.cfg.class_properties and not self.is("(") {
                kind = "init";
                let n = n_identifier(mut self.h, tok_text(token));
                self.finalize(node, n)?;
                if self.is("=") {
                    self.next_token()?;
                    value = self.parse_assignment_expression()?;
                }
            }
        } else if token.kind == T_PUNCTUATOR and tok_is(token, "*") and lookahead_property_key {
            kind = "method";
            computed = self.is("[");
            key = self.parse_object_property_key()?;
            value = self.parse_generator_method()?;
        }
        if kind.is_empty() and key >= 0 and self.is("(") {
            kind = "method";
            value = if is_async { self.parse_property_method_async_function()? } else { self.parse_property_method_function()? };
        }
        if kind.is_empty() {
            return Err(self.unexpected(self.lookahead));
        }
        if not computed {
            if is_static and self.is_property_key(key, "prototype") {
                return Err(self.throw_unexpected_token(Culprit.Tok(token), "Classes may not have static property named prototype"));
            }
            if not is_static and self.is_property_key(key, "constructor") {
                if kind != "method" or (value >= 0 and truthy(self.h, self.h.get(value, "generator"))) {
                    return Err(self.throw_unexpected_token(Culprit.Tok(token), "Class constructor may not be an accessor"));
                }
                if *has_constructor {
                    return Err(self.throw_unexpected_token(Culprit.Tok(token), "A class may only have one constructor"));
                }
                *has_constructor = true;
                kind = "constructor";
            }
        }
        let k = kind.to_string();
        let n = if kind == "constructor" or kind == "method" or kind == "get" or kind == "set" {
            n_method(mut self.h, "MethodDefinition", key, computed, value, k, is_static)
        } else {
            n_method(mut self.h, "FieldDefinition", key, computed, value, k, is_static)
        };
        self.finalize(node, n)
    }

    fn parse_class_element_list(mut ref self) -> Result[Vec[i64], Fail] {
        let mut body: Vec[i64] = Vec.new();
        let mut has_constructor = false;
        self.expect("{")?;
        while not self.is("}") {
            if self.is(";") {
                self.next_token()?;
            } else {
                body.push(self.parse_class_element(mut has_constructor)?);
            }
        }
        self.expect("}")?;
        Ok(body)
    }

    fn parse_class_body(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let element_list = self.parse_class_element_list()?;
        let l = self.h.list_of(element_list);
        let n = n_one(mut self.h, "ClassBody", "body", vlist(l));
        self.finalize(node, n)
    }

    fn parse_class_declaration(mut ref self, identifier_is_optional: bool) -> Result[i64, Fail] {
        let node = self.create_node();
        let previous_strict = self.ctx.strict;
        self.ctx.strict = true;
        self.expect_keyword("class")?;
        let id = if identifier_is_optional and self.lookahead.kind != T_IDENTIFIER {
            -1
        } else {
            self.parse_variable_identifier("".to_string())?
        };
        let mut super_class = -1;
        if self.is_kw("extends") {
            self.next_token()?;
            super_class = self.isolate(Pf.LhsAllowCall)?;
        }
        let class_body = self.parse_class_body()?;
        self.ctx.strict = previous_strict;
        let n = n_class(mut self.h, "ClassDeclaration", id, super_class, class_body);
        self.finalize(node, n)
    }

    fn parse_class_expression(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let previous_strict = self.ctx.strict;
        self.ctx.strict = true;
        self.expect_keyword("class")?;
        let id = if self.lookahead.kind == T_IDENTIFIER { self.parse_variable_identifier("".to_string())? } else { -1 };
        let mut super_class = -1;
        if self.is_kw("extends") {
            self.next_token()?;
            super_class = self.isolate(Pf.LhsAllowCall)?;
        }
        let class_body = self.parse_class_body()?;
        self.ctx.strict = previous_strict;
        let n = n_class(mut self.h, "ClassExpression", id, super_class, class_body);
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-scripts
    // https://tc39.github.io/ecma262/#sec-modules

    fn parse_module(mut ref self) -> Result[i64, Fail] {
        self.ctx.strict = true;
        self.ctx.is_module = true;
        self.sc.is_module = true;
        let node = self.create_node();
        let mut body = self.parse_directive_prologues()?;
        while self.lookahead.kind != T_EOF {
            body.push(self.parse_statement_list_item()?);
        }
        let l = self.h.list_of(body);
        let n = n_program(mut self.h, true, l);
        self.finalize(node, n)
    }

    fn parse_script(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut body = self.parse_directive_prologues()?;
        while self.lookahead.kind != T_EOF {
            body.push(self.parse_statement_list_item()?);
        }
        let l = self.h.list_of(body);
        let n = n_program(mut self.h, false, l);
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-imports

    fn parse_module_specifier(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        if self.lookahead.kind != T_STRING {
            return Err(self.throw_error("Unexpected token", Vec.new()));
        }
        let token = self.next_token()?;
        let raw = self.get_token_raw(token);
        let n = n_literal(mut self.h, token.value.clone(), raw);
        self.finalize(node, n)
    }

    // import {<foo as bar>} ...
    fn parse_import_specifier(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let mut imported = -1;
        let mut local = -1;
        if self.lookahead.kind == T_IDENTIFIER {
            imported = self.parse_variable_identifier("".to_string())?;
            local = imported;
            if self.is_contextual("as") {
                self.next_token()?;
                local = self.parse_variable_identifier("".to_string())?;
            }
        } else {
            imported = self.parse_identifier_name()?;
            local = imported;
            if self.is_contextual("as") {
                self.next_token()?;
                local = self.parse_variable_identifier("".to_string())?;
            } else {
                let t = self.next_token()?;
                return Err(self.unexpected(t));
            }
        }
        let n = n_two(mut self.h, "ImportSpecifier", "local", vobj(local), "imported", vobj(imported));
        self.finalize(node, n)
    }

    // {foo, bar as bas
    fn parse_named_imports(mut ref self) -> Result[Vec[i64], Fail] {
        self.expect("{")?;
        let mut specifiers: Vec[i64] = Vec.new();
        while not self.is("}") {
            specifiers.push(self.parse_import_specifier()?);
            if not self.is("}") {
                self.expect(",")?;
            }
        }
        self.expect("}")?;
        Ok(specifiers)
    }

    // import <foo> ...
    fn parse_import_default_specifier(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let local = self.parse_identifier_name()?;
        let n = n_one(mut self.h, "ImportDefaultSpecifier", "local", vobj(local));
        self.finalize(node, n)
    }

    // import <* as foo> ...
    fn parse_import_namespace_specifier(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        self.expect("*")?;
        if not self.is_contextual("as") {
            return Err(self.throw_error("Unexpected token", Vec.new()));
        }
        self.next_token()?;
        let local = self.parse_identifier_name()?;
        let n = n_one(mut self.h, "ImportNamespaceSpecifier", "local", vobj(local));
        self.finalize(node, n)
    }

    // The error for a missing `from`: the message depends on whether the
    // lookahead's value is truthy.
    fn missing_from(ref self) -> Fail {
        let value = self.lookahead.value.clone();
        let message = if truthy(self.h, value) { "Unexpected token %0" } else { "Unexpected token" };
        self.throw_error(message, vec![py_str(value)])
    }

    fn parse_import_declaration(mut ref self) -> Result[i64, Fail] {
        if self.ctx.in_function_body {
            return Err(self.throw_error("Unexpected token", Vec.new()));
        }
        let node = self.create_node();
        self.expect_keyword("import")?;
        let mut specifiers: Vec[i64] = Vec.new();
        let mut src = -1;
        if self.lookahead.kind == T_STRING {
            // import 'foo'
            src = self.parse_module_specifier()?;
        } else {
            if self.is("{") {
                // import {bar
                for s in self.parse_named_imports()? {
                    specifiers.push(s);
                }
            } else if self.is("*") {
                // import * as foo
                specifiers.push(self.parse_import_namespace_specifier()?);
            } else if self.is_identifier_name(self.lookahead) and not self.is_kw("default") {
                // import foo
                specifiers.push(self.parse_import_default_specifier()?);
                if self.is(",") {
                    self.next_token()?;
                    if self.is("*") {
                        // import foo, * as foo
                        specifiers.push(self.parse_import_namespace_specifier()?);
                    } else if self.is("{") {
                        // import foo, {bar
                        for s in self.parse_named_imports()? {
                            specifiers.push(s);
                        }
                    } else {
                        return Err(self.unexpected(self.lookahead));
                    }
                }
            } else {
                let t = self.next_token()?;
                return Err(self.unexpected(t));
            }
            if not self.is_contextual("from") {
                return Err(self.missing_from());
            }
            self.next_token()?;
            src = self.parse_module_specifier()?;
        }
        self.consume_semicolon()?;
        let l = self.h.list_of(specifiers);
        let n = n_two(mut self.h, "ImportDeclaration", "specifiers", vlist(l), "source", vobj(src));
        self.finalize(node, n)
    }

    // https://tc39.github.io/ecma262/#sec-exports

    fn parse_export_specifier(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let local = self.parse_identifier_name()?;
        let mut exported = local;
        if self.is_contextual("as") {
            self.next_token()?;
            exported = self.parse_identifier_name()?;
        }
        let n = n_export_specifier(mut self.h, local, exported);
        self.finalize(node, n)
    }

    fn parse_export_default_specifier(mut ref self) -> Result[i64, Fail] {
        let node = self.create_node();
        let local = self.parse_identifier_name()?;
        let n = n_one(mut self.h, "ExportDefaultSpecifier", "local", vobj(local));
        self.finalize(node, n)
    }

    fn export_default(mut ref self, node: Marker, declaration: i64) -> Result[i64, Fail] {
        let n = n_one(mut self.h, "ExportDefaultDeclaration", "declaration", vobj(declaration));
        self.finalize(node, n)
    }

    fn export_named(mut ref self, node: Marker, declaration: i64, specifiers: ref Vec[i64], source: i64) -> Result[i64, Fail] {
        let l = self.h.list_of(specifiers);
        let n = n_three(mut self.h, "ExportNamedDeclaration", "declaration", vobj(declaration), "specifiers", vlist(l), "source", vobj(source));
        self.finalize(node, n)
    }

    fn parse_export_declaration(mut ref self) -> Result[i64, Fail] {
        if self.ctx.in_function_body {
            return Err(self.throw_error("Unexpected token", Vec.new()));
        }
        let node = self.create_node();
        self.expect_keyword("export")?;
        if self.is_kw("default") {
            // export default ...
            self.next_token()?;
            if self.is_kw("function") {
                // export default function foo (:
                // export default function (:
                let declaration = self.parse_function_declaration(true)?;
                return self.export_default(node, declaration);
            }
            if self.is_kw("class") {
                // export default class foo {
                let declaration = self.parse_class_declaration(true)?;
                return self.export_default(node, declaration);
            }
            if self.is_contextual("async") {
                // export default async function f (:
                // export default async function (:
                // export default async x => x
                let declaration = if self.match_async_function()? {
                    self.parse_function_declaration(true)?
                } else {
                    self.parse_assignment_expression()?
                };
                return self.export_default(node, declaration);
            }
            if self.is_contextual("from") {
                return Err(self.throw_error("Unexpected token %0", vec![py_str(self.lookahead.value)]));
            }
            // export default {}
            // export default []
            // export default (1 + 2)
            let declaration = if self.is("{") {
                self.parse_object_initializer()?
            } else if self.is("[") {
                self.parse_array_initializer()?
            } else {
                self.parse_assignment_expression()?
            };
            self.consume_semicolon()?;
            return self.export_default(node, declaration);
        }
        if self.is("*") {
            // export * from 'foo'
            self.next_token()?;
            if not self.is_contextual("from") {
                return Err(self.missing_from());
            }
            self.next_token()?;
            let src = self.parse_module_specifier()?;
            self.consume_semicolon()?;
            let n = n_one(mut self.h, "ExportAllDeclaration", "source", vobj(src));
            return self.finalize(node, n);
        }
        if self.lookahead.kind == T_KEYWORD {
            // export var f = 1
            let value = tok_text(self.lookahead);
            let declaration = if value == "let" or value == "const" {
                self.parse_lexical_declaration(in_for(false))?
            } else if value == "var" or value == "class" or value == "function" {
                self.parse_statement_list_item()?
            } else {
                return Err(self.unexpected(self.lookahead));
            };
            return self.export_named(node, declaration, Vec.new(), -1);
        }
        if self.match_async_function()? {
            let declaration = self.parse_function_declaration(false)?;
            return self.export_named(node, declaration, Vec.new(), -1);
        }
        let mut specifiers: Vec[i64] = Vec.new();
        let mut source = -1;
        let mut is_export_from_identifier = false;
        let mut expect_specifiers = true;
        if self.lookahead.kind == T_IDENTIFIER {
            specifiers.push(self.parse_export_default_specifier()?);
            if self.is(",") {
                self.next_token()?;
            } else {
                expect_specifiers = false;
            }
        }
        if expect_specifiers {
            self.expect("{")?;
            while not self.is("}") {
                is_export_from_identifier = is_export_from_identifier or self.is_kw("default");
                specifiers.push(self.parse_export_specifier()?);
                if not self.is("}") {
                    self.expect(",")?;
                }
            }
            self.expect("}")?;
        }
        if self.is_contextual("from") {
            // export {default} from 'foo'
            // export {foo} from 'foo'
            self.next_token()?;
            source = self.parse_module_specifier()?;
            self.consume_semicolon()?;
        } else if is_export_from_identifier {
            // export {default}; # missing fromClause
            return Err(self.missing_from());
        } else {
            // export {foo}
            self.consume_semicolon()?;
        }
        self.export_named(node, -1, specifiers, source)
    }
}
// ---------------------------------------------------------- tokenizer
//
// tokenizer.py. The Reader keeps the values of the tokens so far (None
// for anything but a punctuator or keyword) and indexes them the way
// Python indexes a list: a negative index counts from the end, and one
// out of range raises IndexError.

struct Reader {
    values: Vec[Option[String]],
    curly: i64,
    paren: i64,
}

fn py_at(v: ref Vec[Option[String]], i: i64) -> Result[Option[String], Fail] {
    let n = v.len();
    let j = if i < 0 { i + n } else { i };
    if j < 0 or j >= n {
        return Err(index_error());
    }
    Ok(v[j].clone())
}

fn opt_is(v: ref Option[String], s: Str) -> bool {
    match v {
        Some(x) => x == s,
        None => false,
    }
}

// A function following one of those tokens is an expression.
fn before_function_expression(t: ref String) -> bool {
    str_in(t, vec![
        "(", "{", "[", "in", "typeof", "instanceof", "new", "return", "case", "delete", "throw", "void",
        // assignment operators
        "=", "+=", "-=", "*=", "**=", "/=", "%=", "<<=", ">>=", ">>>=", "&=", "|=", "^=", ",",
        // binary/unary operators
        "+", "-", "*", "**", "/", "%", "++", "--", "<<", ">>", ">>>", "&", "|", "^", "!", "~", "&&",
        "||", "?", ":", "===", "==", ">=", "<=", "<", ">", "!=", "!==",
    ])
}

// `not before(check) if check else other`
fn after_function(check: ref Option[String], other: bool) -> bool {
    match check {
        Some(c) => if c.is_empty() { other } else { not before_function_expression(c) },
        None => other,
    }
}

impl Reader {
    // Determine if forward slash (/) is an operator or part of a regular expression
    // https://github.com/mozilla/sweet.js/wiki/design
    fn is_regex_start(ref self) -> Result[bool, Fail] {
        if self.values.len() == 0 {
            return Ok(true);
        }
        let previous = self.values[self.values.len() - 1].clone();
        let mut regex = previous.is_some();
        if opt_is(previous, "this") or opt_is(previous, "]") {
            regex = false;
        } else if opt_is(previous, ")") {
            let keyword = py_at(self.values, self.paren - 1)?;
            regex = opt_is(keyword, "if") or opt_is(keyword, "while") or opt_is(keyword, "for") or opt_is(keyword, "with");
        } else if opt_is(previous, "}") {
            // Dividing a function by anything makes little sense,
            // but we have to check for that.
            regex = true;
            if self.values.len() >= 3 and opt_is(py_at(self.values, self.curly - 3)?, "function") {
                // Anonymous function, e.g. function(){} /42
                let check = py_at(self.values, self.curly - 4)?;
                regex = after_function(check, false);
            } else if self.values.len() >= 4 and opt_is(py_at(self.values, self.curly - 4)?, "function") {
                // Named function, e.g. function f(){} /42/
                let check = py_at(self.values, self.curly - 5)?;
                regex = after_function(check, true);
            }
        }
        Ok(regex)
    }

    fn append(mut ref self, token: ref RawToken) {
        if token.kind == T_PUNCTUATOR or token.kind == T_KEYWORD {
            if tok_is(token, "{") {
                self.curly = self.values.len();
            } else if tok_is(token, "(") {
                self.paren = self.values.len();
            }
            self.values.push(Some(tok_text(token)));
        } else {
            self.values.push(None);
        }
    }
}

struct JsTokenizer {
    sc: Scanner,
    h: Heap,
    track_range: bool,
    track_loc: bool,
    // a deque: entries before `head` have been taken
    buffer: Vec[i64],
    head: i64,
    reader: Reader,
}

fn new_tokenizer(code: ref String, tolerant: bool, comment: bool, range: bool, loc: bool) -> JsTokenizer {
    let mut sc = new_scanner(code, tolerant);
    sc.track_comment = comment;
    JsTokenizer {
        sc: sc, h: new_heap(), track_range: range, track_loc: loc, buffer: Vec.new(), head: 0,
        reader: Reader { values: Vec.new(), curly: -1, paren: -1 },
    }
}

impl JsTokenizer {
    fn entry(mut ref self, ty: Str, value: own String) -> i64 {
        let e = self.h.obj("BufferEntry");
        self.h.put(e, "type", vs(ty));
        self.h.put(e, "value", Val.Str(value));
        self.h.put(e, "regex", Val.Null);
        self.h.put(e, "range", Val.Null);
        self.h.put(e, "loc", Val.Null);
        e
    }

    // The next entry, or -1 where Python returns None.
    fn get_next_token(mut ref self) -> Result[i64, Fail] {
        if self.head >= self.buffer.len() {
            let comments = self.sc.scan_comments()?;
            if self.sc.track_comment {
                for e in comments {
                    let value = self.sc.slice(e.slice0, e.slice1);
                    let comment = self.entry(if e.multi_line { "BlockComment" } else { "LineComment" }, value);
                    if self.track_range {
                        let r = self.h.pair(e.range0, e.range1);
                        self.h.put(comment, "range", r);
                    }
                    if self.track_loc {
                        let l = self.h.location(e.l1, e.c1, e.l2, e.c2);
                        self.h.put(comment, "loc", Val.Obj(l));
                    }
                    self.buffer.push(comment);
                }
            }
            if not self.sc.eof() {
                let line = self.sc.line_number;
                let column = self.sc.index - self.sc.line_start;
                let maybe_regex = self.sc.at(self.sc.index) == '/' and self.reader.is_regex_start()?;
                let token = if maybe_regex {
                    let state = self.sc.save_state();
                    match self.sc.scan_reg_exp() {
                        Ok(t) => t,
                        Err(_) => {
                            self.sc.restore_state(state);
                            self.sc.lex()?
                        }
                    }
                } else {
                    self.sc.lex()?
                };
                self.reader.append(token);
                let raw = self.sc.slice(token.start, token.end);
                let entry = self.entry(token_name(token.kind), raw);
                if self.track_range {
                    let r = self.h.pair(token.start, token.end);
                    self.h.put(entry, "range", r);
                }
                if self.track_loc {
                    let l = self.h.location(line, column, self.sc.line_number, self.sc.index - self.sc.line_start);
                    self.h.put(entry, "loc", Val.Obj(l));
                }
                if token.kind == T_REGEX {
                    let r = self.h.regexp(token.pattern, token.flags);
                    self.h.put(entry, "regex", Val.Obj(r));
                }
                self.buffer.push(entry);
            }
        }
        if self.head < self.buffer.len() {
            let e = self.buffer[self.head];
            self.head += 1;
            return Ok(e);
        }
        Ok(-1)
    }
}

struct Tokens {
    h: Heap,
    tokens: Vec[i64],
    // tolerant: the errors list
    errors: Option[Vec[JsErr]],
}

fn tokenize(code: ref String, tolerant: bool, comment: bool, range: bool, loc: bool) -> Result[Tokens, Fail] {
    let mut t = new_tokenizer(code, tolerant, comment, range, loc);
    let mut tokens: Vec[i64] = Vec.new();
    loop {
        match t.get_next_token() {
            Ok(e) => {
                if e < 0 {
                    break;
                }
                tokens.push(e);
            }
            Err(Fail.Js(e)) => {
                t.sc.eh.tolerate(e)?;
                break;
            }
            Err(f) => return Err(f),
        }
    }
    let errors = if t.sc.eh.tolerant { Some(t.sc.eh.errors.clone()) } else { None };
    Ok(Tokens { h: t.h, tokens: tokens, errors: errors })
}
// --------------------------------------------------------------- jobs
//
// What each job prints, as oracle.py prints it from esprima's toDict()
// tree: the whole tree as JSON, a digest of it, the tokens, an outline
// of the declarations, statistics, or the import graph of several
// modules.

struct Opts {
    range: bool,
    loc: bool,
    tokens: bool,
    comment: bool,
    attach: bool,
    tolerant: bool,
    class_props: bool,
    source: bool,
}

fn parse_opts(text: ref String) -> Opts {
    let mut o = Opts {
        range: false, loc: false, tokens: false, comment: false, attach: false, tolerant: false,
        class_props: false, source: false,
    };
    for name in text.split(",") {
        if name == "range" {
            o.range = true;
        } else if name == "loc" {
            o.loc = true;
        } else if name == "tokens" {
            o.tokens = true;
        } else if name == "comment" {
            o.comment = true;
        } else if name == "attach" {
            o.attach = true;
        } else if name == "tolerant" {
            o.tolerant = true;
        } else if name == "classProps" {
            o.class_props = true;
        } else if name == "source" {
            o.source = true;
        }
    }
    o
}

struct Parsed {
    h: Heap,
    root: i64,
}

// esprima.parse(): the parser, then the comments, tokens and errors the
// options ask for, set on the Program node.
fn parse_code(code: ref String, module: bool, o: ref Opts, path: ref String) -> Result[Parsed, Fail] {
    let cfg = Config {
        range: o.range, loc: o.loc, source: if o.source { path.clone() } else { String.new() }, tokens: o.tokens,
        comment: o.comment or o.attach, tolerant: o.tolerant, class_properties: o.class_props,
    };
    let mut p = new_parser(code, cfg, o.attach)?;
    let root = if module { p.parse_module()? } else { p.parse_script()? };
    if o.comment {
        let l = p.h.list_of(p.ch.comments);
        p.h.put(root, "comments", vlist(l));
    }
    if o.tokens {
        let l = p.h.list_of(p.tokens);
        p.h.put(root, "tokens", vlist(l));
    }
    if o.tolerant {
        let mut ids: Vec[i64] = Vec.new();
        for e in p.sc.eh.errors.iter() {
            ids.push(error_obj(mut p.h, e));
        }
        let l = p.h.list_of(ids);
        p.h.put(root, "errors", vlist(l));
    }
    Ok(Parsed { h: p.h, root: root })
}

fn read_src(path: ref String) -> Result[String, Fail] {
    match fs.read_to_string(f"data/src/{path}") {
        Ok(t) => Ok(t),
        Err(e) => Err(Fail.Crash(f"FileNotFoundError: {path}: {e}")),
    }
}

fn parse_file(path: ref String, mode: ref String, opts: ref String) -> Result[Parsed, Fail] {
    let code = read_src(path)?;
    let o = parse_opts(opts);
    parse_code(code, mode == "module", o, path)
}

// ------------------------------------------------------------ walking

// The value is there and not None (toDict leaves None out).
fn present(h: ref Heap, n: i64, key: Str) -> bool {
    match h.get(n, key) {
        Val.Null => false,
        _ => true,
    }
}

// Every object with a "type", in document order.
fn walk_nodes(h: ref Heap, v: ref Val, out: mut ref Vec[i64]) {
    match v {
        Val.Obj(n) => {
            if present(h, n, "type") {
                out.push(n);
            }
            for x in h.objs[n].vals.iter() {
                walk_nodes(h, x, mut out);
            }
        }
        Val.List(l) => {
            for x in h.lists[l].iter() {
                walk_nodes(h, x, mut out);
            }
        }
        _ => {}
    }
}

fn nodes_of(h: ref Heap, v: ref Val) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    walk_nodes(h, v, mut out);
    out
}

fn depth_of(h: ref Heap, v: ref Val) -> i64 {
    match v {
        Val.Obj(n) => {
            let mut d = 0;
            for x in h.objs[n].vals.iter() {
                let k = depth_of(h, x);
                if k > d {
                    d = k;
                }
            }
            1 + d
        }
        Val.List(l) => {
            let mut d = 0;
            for x in h.lists[l].iter() {
                let k = depth_of(h, x);
                if k > d {
                    d = k;
                }
            }
            d
        }
        _ => 0,
    }
}

#[derive(Clone)]
struct Count {
    name: String,
    n: i64,
}

// Counts, most frequent first, then by name.
fn tally(names: ref Vec[String]) -> Vec[Count] {
    let mut counts: Vec[Count] = Vec.new();
    for s in names {
        let mut found = false;
        let mut i = 0;
        while i < counts.len() {
            if counts[i].name == s {
                counts[i].n += 1;
                found = true;
                break;
            }
            i += 1;
        }
        if not found {
            counts.push(Count { name: s.clone(), n: 1 });
        }
    }
    let mut i = 1;
    while i < counts.len() {
        let mut j = i;
        while j > 0 and (counts[j].n > counts[j - 1].n or (counts[j].n == counts[j - 1].n and counts[j].name < counts[j - 1].name)) {
            let t = counts[j].clone();
            counts[j] = counts[j - 1].clone();
            counts[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
    counts
}

fn counted(pairs: ref Vec[Count], limit: i64) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < pairs.len() and i < limit {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{pairs[i].name} {pairs[i].n}");
        i += 1;
    }
    out
}

fn types_of(h: ref Heap, ids: ref Vec[i64]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for n in ids {
        out.push(h.ty(*n));
    }
    out
}

fn list_ids(h: ref Heap, n: i64, key: Str) -> Vec[i64] {
    match h.get(n, key) {
        Val.List(l) => {
            let mut out: Vec[i64] = Vec.new();
            for x in h.lists[l].iter() {
                out.push(as_obj(x));
            }
            out
        }
        _ => Vec.new(),
    }
}

const ALL: i64 = 1000000;

// ------------------------------------------------------------- digest

fn digest(h: ref Heap, root: i64, out: mut ref Vec[String]) {
    let body = h.get(root, "body");
    let statements = list_ids(h, root, "body");
    let all = nodes_of(h, body);
    let source_type = h.text(root, "sourceType");
    out.push(f"program: {source_type}, {statements.len()} statements, {all.len()} nodes, depth {depth_of(h, body)}");
    let text = to_json(h, Val.Obj(root));
    out.push(f"json: {text.len()} bytes, fnv {fnv(text)}");
    out.push(f"statements: {counted(tally(types_of(h, statements)), ALL)}");
    if h.has(root, "comments") {
        let cs = list_ids(h, root, "comments");
        out.push(f"comments: {cs.len()} ({counted(tally(types_of(h, cs)), ALL)})");
    }
    let mut attached = 0;
    for x in all.iter() {
        attached += list_ids(h, *x, "leadingComments").len();
        attached += list_ids(h, *x, "trailingComments").len();
        attached += list_ids(h, *x, "innerComments").len();
    }
    if attached > 0 {
        out.push(f"attached comments: {attached}");
    }
    if h.has(root, "tokens") {
        let ts = list_ids(h, root, "tokens");
        out.push(f"tokens: {ts.len()} ({counted(tally(types_of(h, ts)), ALL)})");
    }
    for e in list_ids(h, root, "errors") {
        out.push(f"error: {to_json(h, Val.Obj(e))}");
    }
}

// ------------------------------------------------------------ outline

fn expr_text(h: ref Heap, e: i64) -> String {
    if e < 0 {
        return String.new();
    }
    let t = h.ty(e);
    if t == "Identifier" {
        return h.text(e, "name");
    }
    if t == "Literal" {
        return h.text(e, "raw");
    }
    if t == "ThisExpression" {
        return "this".to_string();
    }
    if t == "MemberExpression" {
        let o = expr_text(h, h.node(e, "object"));
        let p = expr_text(h, h.node(e, "property"));
        if truthy(h, h.get(e, "computed")) {
            return f"{o}[{p}]";
        }
        return f"{o}.{p}";
    }
    if t == "CallExpression" {
        let mut args: Vec[String] = Vec.new();
        for a in list_ids(h, e, "arguments") {
            args.push(expr_text(h, a));
        }
        return f"{expr_text(h, h.node(e, "callee"))}({args.join(", ")})";
    }
    f"<{t}>"
}

fn param_text(h: ref Heap, p: i64) -> String {
    let t = h.ty(p);
    if t == "Identifier" {
        return h.text(p, "name");
    }
    if t == "AssignmentPattern" {
        return f"{param_text(h, h.node(p, "left"))}=";
    }
    if t == "RestElement" {
        return f"...{param_text(h, h.node(p, "argument"))}";
    }
    if t == "ObjectPattern" {
        return "{…}".to_string();
    }
    if t == "ArrayPattern" {
        return "[…]".to_string();
    }
    f"<{t}>"
}

fn params_text(h: ref Heap, f: i64) -> String {
    let mut ps: Vec[String] = Vec.new();
    for p in list_ids(h, f, "params") {
        ps.push(param_text(h, p));
    }
    f"({ps.join(", ")})"
}

fn key_text(h: ref Heap, key: i64, computed: bool) -> String {
    if computed {
        return f"[{expr_text(h, key)}]";
    }
    expr_text(h, key)
}

fn is_func(h: ref Heap, n: i64) -> bool {
    h.ty_is(n, "FunctionExpression") or h.ty_is(n, "ArrowFunctionExpression")
}

fn flag(h: ref Heap, n: i64, key: Str) -> bool {
    truthy(h, h.get(n, key))
}

fn fn_kind(h: ref Heap, f: i64) -> String {
    let word = if h.ty_is(f, "ArrowFunctionExpression") {
        "arrow"
    } else if flag(h, f, "generator") {
        "function*"
    } else {
        "function"
    };
    if flag(h, f, "isAsync") {
        return f"async {word}";
    }
    word.to_string()
}

fn outline_entry(h: ref Heap, n: i64) -> Option[String] {
    let t = h.ty(n);
    if t == "FunctionDeclaration" {
        let name = if present(h, n, "id") { h.text(h.node(n, "id"), "name") } else { "(anonymous)".to_string() };
        return Some(f"{fn_kind(h, n)} {name}{params_text(h, n)}");
    }
    if t == "ClassDeclaration" or t == "ClassExpression" {
        let name = if present(h, n, "id") { h.text(h.node(n, "id"), "name") } else { "(anonymous)".to_string() };
        let mut s = f"class {name}";
        if present(h, n, "superClass") {
            s.push_str(f" extends {expr_text(h, h.node(n, "superClass"))}");
        }
        return Some(s);
    }
    if t == "MethodDefinition" {
        let f = h.node(n, "value");
        let mut prefix = if flag(h, n, "static") { "static ".to_string() } else { String.new() };
        let kind = h.text(n, "kind");
        if kind == "get" or kind == "set" {
            prefix.push_str(f"{kind} ");
        } else if flag(h, f, "isAsync") {
            prefix.push_str("async ");
        } else if flag(h, f, "generator") {
            prefix.push_str("*");
        }
        return Some(f"{prefix}{key_text(h, h.node(n, "key"), flag(h, n, "computed"))}{params_text(h, f)}");
    }
    if t == "FieldDefinition" {
        let prefix = if flag(h, n, "static") { "static " } else { "" };
        return Some(f"{prefix}field {key_text(h, h.node(n, "key"), flag(h, n, "computed"))}");
    }
    if t == "VariableDeclarator" and present(h, n, "init") and is_func(h, h.node(n, "init")) {
        let f = h.node(n, "init");
        return Some(f"{param_text(h, h.node(n, "id"))} = {fn_kind(h, f)}{params_text(h, f)}");
    }
    if t == "Property" and is_func(h, h.node(n, "value")) {
        let f = h.node(n, "value");
        let kind = h.text(n, "kind");
        let key = key_text(h, h.node(n, "key"), flag(h, n, "computed"));
        if kind == "get" or kind == "set" {
            return Some(f"{kind} {key}{params_text(h, f)}");
        }
        return Some(f"{key}: {fn_kind(h, f)}{params_text(h, f)}");
    }
    if t == "AssignmentExpression" and is_func(h, h.node(n, "right")) {
        let f = h.node(n, "right");
        return Some(f"{expr_text(h, h.node(n, "left"))} = {fn_kind(h, f)}{params_text(h, f)}");
    }
    None
}

fn indent(level: i64) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < level {
        s.push_str("  ");
        i += 1;
    }
    s
}

fn start_line(h: ref Heap, n: i64) -> i64 {
    as_int(h.get(h.node(h.node(n, "loc"), "start"), "line"))
}

fn end_line(h: ref Heap, n: i64) -> i64 {
    as_int(h.get(h.node(h.node(n, "loc"), "end"), "line"))
}

fn outline(h: ref Heap, v: ref Val, level: i64, out: mut ref Vec[String]) {
    match v {
        Val.Obj(n) => {
            let mut inner = level;
            if present(h, n, "type") {
                if let Some(entry) = outline_entry(h, n) {
                    out.push(f"{indent(level)}L{start_line(h, n)} {entry}");
                    inner = level + 1;
                }
            }
            for x in h.objs[n].vals.iter() {
                outline(h, x, inner, mut out);
            }
        }
        Val.List(l) => {
            for x in h.lists[l].iter() {
                outline(h, x, level, mut out);
            }
        }
        _ => {}
    }
}

// -------------------------------------------------------------- stats

fn distinct_sorted(items: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for s in items {
        if not contains(out, s) {
            out.push(s.clone());
        }
    }
    let mut i = 1;
    while i < out.len() {
        let mut j = i;
        while j > 0 and out[j] < out[j - 1] {
            let t = out[j].clone();
            out[j] = out[j - 1].clone();
            out[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
    out
}

fn stats(h: ref Heap, root: i64, out: mut ref Vec[String]) {
    let all = nodes_of(h, h.get(root, "body"));
    out.push(f"node types: {counted(tally(types_of(h, all)), 12)}");
    let mut names: Vec[String] = Vec.new();
    let mut strings = 0;
    let mut string_chars = 0;
    let mut nums: Vec[String] = Vec.new();
    let mut regexes: Vec[String] = Vec.new();
    let mut funcs: Vec[i64] = Vec.new();
    for n in all.iter() {
        let t = h.ty(*n);
        if t == "Identifier" {
            names.push(h.text(*n, "name"));
        }
        if t == "Literal" {
            match h.get(*n, "value") {
                Val.Str(s) => {
                    strings += 1;
                    string_chars += char_count(s);
                }
                Val.Int(_) => nums.push(h.text(*n, "raw")),
                Val.Big(_) => nums.push(h.text(*n, "raw")),
                Val.Float(_) => nums.push(h.text(*n, "raw")),
                _ => {}
            }
        }
        if present(h, *n, "regex") {
            let r = h.node(*n, "regex");
            regexes.push(f"{h.text(r, "pattern")}/{h.text(r, "flags")}");
        }
        if t == "FunctionDeclaration" or t == "FunctionExpression" or t == "ArrowFunctionExpression" {
            funcs.push(*n);
        }
    }
    let distinct = distinct_sorted(names).len();
    out.push(f"identifiers: {names.len()}, {distinct} distinct; top: {counted(tally(names), 8)}");
    out.push(f"string literals: {strings}, {string_chars} characters");
    out.push(f"numeric literals: {nums.len()}; distinct raw: {distinct_sorted(nums).join(" ")}");
    let mut line = f"regular expressions: {regexes.len()}";
    for r in regexes.iter() {
        line.push_str(f"\n  /{r}");
    }
    out.push(line);
    let mut longest = 0;
    let mut arrows = 0;
    let mut asyncs = 0;
    let mut generators = 0;
    for f in funcs.iter() {
        let lines = end_line(h, *f) - start_line(h, *f) + 1;
        if lines > longest {
            longest = lines;
        }
        if h.ty_is(*f, "ArrowFunctionExpression") {
            arrows += 1;
        }
        if flag(h, *f, "isAsync") {
            asyncs += 1;
        }
        if flag(h, *f, "generator") {
            generators += 1;
        }
    }
    out.push(f"functions: {funcs.len()} ({arrows} arrow, {asyncs} async, {generators} generator); longest {longest} lines");
}

// -------------------------------------------------------------- graph

// A relative specifier against the importing file's directory; None
// for a bare one.
fn resolve(base: ref String, spec: ref String) -> Result[Option[String], Fail] {
    if not spec.starts_with("./") and not spec.starts_with("../") {
        return Ok(None);
    }
    let mut parts: Vec[String] = Vec.new();
    for p in base.split("/") {
        parts.push(p.to_string());
    }
    parts.pop();
    for p in spec.split("/") {
        if p == ".." {
            if parts.len() == 0 {
                return Err(Fail.Crash("IndexError: pop from empty list".to_string()));
            }
            parts.pop();
        } else if p != "." {
            parts.push(p.to_string());
        }
    }
    Ok(Some(parts.join("/")))
}

fn spec_text(h: ref Heap, s: i64) -> String {
    let t = h.ty(s);
    let local = h.text(h.node(s, "local"), "name");
    if t == "ImportDefaultSpecifier" {
        return f"default {local}";
    }
    if t == "ImportNamespaceSpecifier" {
        return f"* as {local}";
    }
    let imported = h.text(h.node(s, "imported"), "name");
    if imported == local {
        return local;
    }
    f"{imported} as {local}"
}

fn declared_names(h: ref Heap, decl: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if h.ty_is(decl, "VariableDeclaration") {
        for d in list_ids(h, decl, "declarations") {
            out.push(param_text(h, h.node(d, "id")));
        }
        return out;
    }
    out.push(h.text(h.node(decl, "id"), "name"));
    out
}

fn graph(paths: ref Vec[String], trees: ref Vec[Parsed], out: mut ref Vec[String]) -> Result[(), Fail] {
    let mut deps: Vec[Vec[String]] = Vec.new();
    let mut k = 0;
    while k < paths.len() {
        let p = ref paths[k];
        let h = ref trees[k].h;
        out.push(p.clone());
        let mut ds: Vec[String] = Vec.new();
        let mut exports: Vec[String] = Vec.new();
        for s in list_ids(h, trees[k].root, "body") {
            let t = h.ty(s);
            if t == "ImportDeclaration" {
                let src = h.text(h.node(s, "source"), "value");
                let mut specs: Vec[String] = Vec.new();
                for x in list_ids(h, s, "specifiers") {
                    specs.push(spec_text(h, x));
                }
                let joined = specs.join(", ");
                let tail = if joined.is_empty() { String.new() } else { f" ({joined})" };
                out.push(f"  imports {src}{tail}");
                if let Some(target) = resolve(p, src)? {
                    ds.push(target);
                }
            } else if t == "ExportNamedDeclaration" {
                if present(h, s, "declaration") {
                    for name in declared_names(h, h.node(s, "declaration")) {
                        exports.push(name.clone());
                    }
                }
                for x in list_ids(h, s, "specifiers") {
                    exports.push(h.text(h.node(x, "exported"), "name"));
                }
                if present(h, s, "source") {
                    out.push(f"  re-exports from {h.text(h.node(s, "source"), "value")}");
                }
            } else if t == "ExportDefaultDeclaration" {
                exports.push("default".to_string());
            } else if t == "ExportAllDeclaration" {
                out.push(f"  re-exports * from {h.text(h.node(s, "source"), "value")}");
            }
        }
        let list = if exports.len() > 0 { exports.join(", ") } else { "nothing".to_string() };
        out.push(f"  exports {list}");
        deps.push(ds);
        k += 1;
    }
    let mut missing: Vec[String] = Vec.new();
    for ds in deps.iter() {
        for t in ds.iter() {
            if not contains(paths, t) {
                missing.push(t.clone());
            }
        }
    }
    for m in distinct_sorted(missing) {
        out.push(f"unresolved: {m}");
    }
    // dependencies first; ties in path order
    let mut order: Vec[String] = Vec.new();
    let mut left: Vec[String] = paths.clone();
    while left.len() > 0 {
        let mut ready: Vec[String] = Vec.new();
        for p in left.iter() {
            let mut i = 0;
            while i < paths.len() and paths[i] != *p {
                i += 1;
            }
            let mut ok = true;
            for d in deps[i].iter() {
                if contains(paths, d) and not contains(order, d) {
                    ok = false;
                }
            }
            if ok {
                ready.push(p.clone());
            }
        }
        if ready.len() == 0 {
            out.push(f"cycle among: {distinct_sorted(left).join(", ")}");
            break;
        }
        let first = distinct_sorted(ready)[0].clone();
        order.push(first.clone());
        left = remove_label(left, first);
    }
    out.push(f"load order: {order.join(" -> ")}");
    Ok(())
}

// --------------------------------------------------------------- jobs

fn token_list_json(t: ref Tokens) -> String {
    let mut s = "[".to_string();
    let mut i = 0;
    while i < t.tokens.len() {
        if i > 0 {
            s.push(',');
        }
        s.push_str(to_json(t.h, Val.Obj(t.tokens[i])));
        i += 1;
    }
    s.push(']');
    s
}

fn run_tokenize(path: ref String, opts: ref String) -> Result[Tokens, Fail] {
    let code = read_src(path)?;
    let o = parse_opts(opts);
    tokenize(code, o.tolerant, o.comment, o.range, o.loc)
}

fn run_job(op: ref String, path: ref String, mode: ref String, opts: ref String, out: mut ref Vec[String]) -> Result[(), Fail] {
    if op == "tree" {
        let p = parse_file(path, mode, opts)?;
        out.push(to_json(p.h, Val.Obj(p.root)));
    } else if op == "digest" {
        let p = parse_file(path, mode, opts)?;
        digest(p.h, p.root, mut out);
    } else if op == "tokens" {
        let mut t = run_tokenize(path, opts)?;
        out.push(token_list_json(t));
        if let Some(errors) = t.errors.clone() {
            let mut ids: Vec[i64] = Vec.new();
            for e in errors.iter() {
                ids.push(error_obj(mut t.h, e));
            }
            let l = t.h.list_of(ids);
            out.push(f"errors: {to_json(t.h, Val.List(l))}");
        }
    } else if op == "tokens-digest" {
        let t = run_tokenize(path, opts)?;
        let text = token_list_json(t);
        out.push(f"tokens: {t.tokens.len()} ({counted(tally(types_of(t.h, t.tokens)), ALL)})");
        out.push(f"json: {text.len()} bytes, fnv {fnv(text)}");
    } else if op == "outline" {
        let p = parse_file(path, mode, "loc,classProps".to_string())?;
        outline(p.h, p.h.get(p.root, "body"), 0, mut out);
    } else if op == "stats" {
        let p = parse_file(path, mode, "loc,classProps".to_string())?;
        stats(p.h, p.root, mut out);
    } else if op == "graph" {
        let mut paths: Vec[String] = Vec.new();
        for s in path.split("+") {
            paths.push(s.to_string());
        }
        let mut trees: Vec[Parsed] = Vec.new();
        for p in paths.iter() {
            trees.push(parse_file(p, "module".to_string(), "classProps".to_string())?);
        }
        graph(paths, trees, mut out)?;
    }
    Ok(())
}

fn run_jobs() -> Result[(), String] {
    let jobs = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read jobs.tsv: {e}"),
    };
    for line in jobs.lines() {
        if line.starts_with("#") {
            continue;
        }
        let f: Vec[String] = line.split("\t").map(|s| s.to_string()).collect();
        let opts = if f.len() > 4 { f[4].clone() } else { String.new() };
        let shown = if opts.is_empty() { String.new() } else { f" [{opts}]" };
        println(f"== job {f[0]}: {f[1]} {f[2]} {f[3]}{shown}");
        let mut out: Vec[String] = Vec.new();
        match run_job(f[1], f[2], f[3], opts, mut out) {
            Ok(()) => {}
            Err(Fail.Js(e)) => {
                let mut h = new_heap();
                let d = error_obj(mut h, e);
                out.push(f"error: {to_json(h, Val.Obj(d))}");
            }
            Err(Fail.Crash(s)) => out.push(f"crash: {s}"),
        }
        for l in out.iter() {
            println(l);
        }
    }
    Ok(())
}

// --------------------------------------------------------------- data

struct DataFile {
    path: String,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    if fs.exists("data") {
        if fs.remove_dir_all("data").is_err() {
            return Err("cannot remove the old data/".to_string());
        }
    }
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run_jobs() {
        eprintln(e);
    }
    let _ = fs.remove_dir_all("data");
}

// ------------------------------------------------------------- data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    data_part_7(mut v);
    data_part_8(mut v);
    v
}

