// An expanded AES key: the round keys, 16 bytes each, and the rounds.
struct Aes {
    rk: Vec[u8],
    rounds: i64,
}

fn aes_new(key: ref Vec[u8]) -> Result[Aes, String] {
    let nk = key.len() / 4;
    if key.len() != 16 and key.len() != 24 and key.len() != 32 {
        return Err(f"ValueError: Invalid key size ({key.len() * 8}) for AES.");
    }
    let rounds = nk + 6;
    let mut rk = key.clone();
    let mut rcon: u8 = 1;
    let mut i = nk;
    while i < 4 * (rounds + 1) {
        let mut t: Vec[u8] = slice(rk, 4 * (i - 1), 4 * i);
        if i % nk == 0 {
            let t0 = t[0];
            t[0] = SBOX[t[1] as i64] ^ rcon;
            t[1] = SBOX[t[2] as i64];
            t[2] = SBOX[t[3] as i64];
            t[3] = SBOX[t0 as i64];
            rcon = xtime(rcon);
        } else if nk > 6 and i % nk == 4 {
            for k in 0..4 {
                t[k] = SBOX[t[k] as i64];
            }
        }
        for k in 0..4 {
            let b = rk[4 * (i - nk) + k] ^ t[k];
            rk.push(b);
        }
        i += 1;
    }
    Ok(Aes { rk: rk, rounds: rounds })
}

fn xtime(x: u8) -> u8 {
    let s = ((x as i64) << 1) & 0xFF;
    (if x >= 0x80 { s ^ 0x1b } else { s }) as u8
}

fn gmul(a: u8, b: u8) -> u8 {
    let mut x = a;
    let mut y = b;
    let mut p: u8 = 0;
    while y != 0 {
        if (y & 1) != 0 {
            p = p ^ x;
        }
        x = xtime(x);
        y = y >> 1;
    }
    p
}

fn add_round_key(s: mut ref Vec[u8], a: ref Aes, round: i64) {
    for k in 0..16 {
        s[k] = s[k] ^ a.rk[16 * round + k];
    }
}

// The state is column-major: byte 4c+r is row r of column c.
fn aes_encrypt(a: ref Aes, block: ref Vec[u8], at: i64) -> Vec[u8] {
    let mut s = slice(block, at, at + 16);
    add_round_key(mut s, a, 0);
    for round in 1..a.rounds + 1 {
        let mut t: Vec[u8] = zeros(16);
        for c in 0..4 {
            for r in 0..4 {
                t[4 * c + r] = SBOX[s[4 * ((c + r) % 4) + r] as i64];
            }
        }
        if round < a.rounds {
            for c in 0..4 {
                let a0 = t[4 * c];
                let a1 = t[4 * c + 1];
                let a2 = t[4 * c + 2];
                let a3 = t[4 * c + 3];
                t[4 * c] = xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3;
                t[4 * c + 1] = a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3;
                t[4 * c + 2] = a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3);
                t[4 * c + 3] = (xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3);
            }
        }
        s = t;
        add_round_key(mut s, a, round);
    }
    s
}

fn aes_decrypt(a: ref Aes, block: ref Vec[u8], at: i64) -> Vec[u8] {
    let mut s = slice(block, at, at + 16);
    add_round_key(mut s, a, a.rounds);
    let mut round = a.rounds - 1;
    while round >= 0 {
        let mut t: Vec[u8] = zeros(16);
        for c in 0..4 {
            for r in 0..4 {
                t[4 * ((c + r) % 4) + r] = INV_SBOX[s[4 * c + r] as i64];
            }
        }
        add_round_key(mut t, a, round);
        if round > 0 {
            for c in 0..4 {
                let a0 = t[4 * c];
                let a1 = t[4 * c + 1];
                let a2 = t[4 * c + 2];
                let a3 = t[4 * c + 3];
                t[4 * c] = gmul(a0, 14) ^ gmul(a1, 11) ^ gmul(a2, 13) ^ gmul(a3, 9);
                t[4 * c + 1] = gmul(a0, 9) ^ gmul(a1, 14) ^ gmul(a2, 11) ^ gmul(a3, 13);
                t[4 * c + 2] = gmul(a0, 13) ^ gmul(a1, 9) ^ gmul(a2, 14) ^ gmul(a3, 11);
                t[4 * c + 3] = gmul(a0, 11) ^ gmul(a1, 13) ^ gmul(a2, 9) ^ gmul(a3, 14);
            }
        }
        s = t;
        round -= 1;
    }
    s
}

// ------------------------------------------------------------ block modes

const NOT_BLOCKS: Str = "ValueError: The length of the provided data is not a multiple of the block length.";

fn ecb_encrypt(a: ref Aes, data: ref Vec[u8]) -> Result[Vec[u8], String] {
    if data.len() % 16 != 0 {
        return Err(NOT_BLOCKS.to_string());
    }
    let mut out: Vec[u8] = Vec.new();
    let mut at: i64 = 0;
    while at < data.len() {
        for x in aes_encrypt(a, data, at) {
            out.push(x);
        }
        at += 16;
    }
    Ok(out)
}

fn cbc_encrypt(a: ref Aes, iv: ref Vec[u8], data: ref Vec[u8]) -> Result[Vec[u8], String] {
    if iv.len() != 16 {
        return Err(f"ValueError: Invalid IV size ({iv.len()}) for CBC.");
    }
    if data.len() % 16 != 0 {
        return Err(NOT_BLOCKS.to_string());
    }
    let mut out: Vec[u8] = Vec.new();
    let mut prev = iv.clone();
    let mut at: i64 = 0;
    while at < data.len() {
        let mut x: Vec[u8] = Vec.new();
        for k in 0..16 {
            x.push(data[at + k] ^ prev[k]);
        }
        prev = aes_encrypt(a, x, 0);
        for b in prev {
            out.push(b);
        }
        at += 16;
    }
    Ok(out)
}

fn cbc_decrypt(a: ref Aes, iv: ref Vec[u8], data: ref Vec[u8]) -> Result[Vec[u8], String] {
    if iv.len() != 16 {
        return Err(f"ValueError: Invalid IV size ({iv.len()}) for CBC.");
    }
    if data.len() % 16 != 0 {
        return Err(NOT_BLOCKS.to_string());
    }
    let mut out: Vec[u8] = Vec.new();
    let mut at: i64 = 0;
    while at < data.len() {
        let p = aes_decrypt(a, data, at);
        for k in 0..16 {
            let prev = if at == 0 { iv[k] } else { data[at - 16 + k] };
            out.push(p[k] ^ prev);
        }
        at += 16;
    }
    Ok(out)
}

// Adds one to the big-endian counter in the last `width` bytes of block.
fn increment(block: mut ref Vec[u8], width: i64) {
    let mut k: i64 = 15;
    while k >= 16 - width {
        if block[k] == 0xff {
            block[k] = 0;
            k -= 1;
        } else {
            block[k] = block[k] + 1;
            return;
        }
    }
}

// CTR mode from the counter block `ctr`, carrying through `width` bytes:
// all 16 for CTR mode, the last 4 for GCM.
fn ctr_xor(a: ref Aes, ctr: ref Vec[u8], width: i64, data: ref Vec[u8]) -> Vec[u8] {
    let mut c = ctr.clone();
    let mut out: Vec[u8] = Vec.new();
    let mut at: i64 = 0;
    while at < data.len() {
        let ks = aes_encrypt(a, c, 0);
        let mut k: i64 = 0;
        while k < 16 and at + k < data.len() {
            out.push(data[at + k] ^ ks[k]);
            k += 1;
        }
        increment(mut c, width);
        at += 16;
    }
    out
}

fn ctr_crypt(a: ref Aes, nonce: ref Vec[u8], data: ref Vec[u8]) -> Result[Vec[u8], String] {
    if nonce.len() != 16 {
        return Err(f"ValueError: Invalid nonce size ({nonce.len()}) for CTR.");
    }
    Ok(ctr_xor(a, nonce, 16, data))
}

// ------------------------------------------------------------ AES-GCM

// GF(2^128) multiplication in GCM's bit order, on two 64-bit halves.
fn gf_mul(xh: u64, xl: u64, yh: u64, yl: u64) -> (u64, u64) {
    let mut zh: u64 = 0;
    let mut zl: u64 = 0;
    let mut vh = yh;
    let mut vl = yl;
    for i in 0..128 {
        let bit = if i < 64 { (xh >> ((63 - i) as u64)) & 1u64 } else { (xl >> ((127 - i) as u64)) & 1u64 };
        if bit == 1u64 {
            zh = zh ^ vh;
            zl = zl ^ vl;
        }
        let lsb = vl & 1u64;
        vl = (vl >> 1u64) | ((vh & 1u64) << 63u64);
        vh = vh >> 1u64;
        if lsb == 1u64 {
            vh = vh ^ 0xE100000000000000u64;
        }
    }
    (zh, zl)
}

fn be64_at(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    for k in 0..8 {
        v = (v << 8u64) | (b[i + k] as u64);
    }
    v
}

struct Ghash {
    hh: u64,
    hl: u64,
    yh: u64,
    yl: u64,
}

// Absorbs data zero-padded to whole blocks.
fn ghash_update(g: mut ref Ghash, data: ref Vec[u8]) {
    let mut at: i64 = 0;
    while at < data.len() {
        let mut blk: Vec[u8] = Vec.new();
        for k in 0..16 {
            blk.push(if at + k < data.len() { data[at + k] } else { 0 });
        }
        let (zh, zl) = gf_mul(g.yh ^ be64_at(blk, 0), g.yl ^ be64_at(blk, 8), g.hh, g.hl);
        g.yh = zh;
        g.yl = zl;
        at += 16;
    }
}

fn ghash(hkey: ref Vec[u8], aad: ref Vec[u8], ct: ref Vec[u8]) -> Vec[u8] {
    let mut g = Ghash { hh: be64_at(hkey, 0), hl: be64_at(hkey, 8), yh: 0u64, yl: 0u64 };
    ghash_update(mut g, aad);
    ghash_update(mut g, ct);
    let mut lens: Vec[u8] = Vec.new();
    push_be64(mut lens, (aad.len() * 8) as u64);
    push_be64(mut lens, (ct.len() * 8) as u64);
    ghash_update(mut g, lens);
    let mut out: Vec[u8] = Vec.new();
    push_be64(mut out, g.yh);
    push_be64(mut out, g.yl);
    out
}

fn gcm_key(key: ref Vec[u8]) -> Result[Aes, String] {
    if key.len() != 16 and key.len() != 24 and key.len() != 32 {
        return Err("ValueError: AESGCM key must be 128, 192, or 256 bits.".to_string());
    }
    aes_new(key)
}

// The pre-counter block J0 and the tag of (aad, ct).
fn gcm_tag(a: ref Aes, nonce: ref Vec[u8], aad: ref Vec[u8], ct: ref Vec[u8]) -> (Vec[u8], Vec[u8]) {
    let hkey = aes_encrypt(a, zeros(16), 0);
    let j0 = if nonce.len() == 12 {
        let mut j = nonce.clone();
        for x in [0u8, 0u8, 0u8, 1u8] {
            j.push(x);
        }
        j
    } else {
        ghash(hkey, Vec.new(), nonce)
    };
    let s = ghash(hkey, aad, ct);
    let ek = aes_encrypt(a, j0, 0);
    let mut tag: Vec[u8] = Vec.new();
    for k in 0..16 {
        tag.push(s[k] ^ ek[k]);
    }
    (j0, tag)
}

fn gcm_nonce(nonce: ref Vec[u8]) -> Result[(), String] {
    if nonce.len() < 8 or nonce.len() > 128 {
        return Err("ValueError: Nonce must be between 8 and 128 bytes".to_string());
    }
    Ok(())
}

fn gcm_seal(key: ref Vec[u8], nonce: ref Vec[u8], aad: ref Vec[u8], pt: ref Vec[u8]) -> Result[Vec[u8], String] {
    let a = gcm_key(key)?;
    gcm_nonce(nonce)?;
    let (j0, _) = gcm_tag(a, nonce, Vec.new(), Vec.new());
    let mut ctr = j0.clone();
    increment(mut ctr, 4);
    let ct = ctr_xor(a, ctr, 4, pt);
    let (_, tag) = gcm_tag(a, nonce, aad, ct);
    Ok(concat(ct, tag))
}

fn gcm_open(key: ref Vec[u8], nonce: ref Vec[u8], aad: ref Vec[u8], data: ref Vec[u8]) -> Result[Vec[u8], String] {
    let a = gcm_key(key)?;
    gcm_nonce(nonce)?;
    if data.len() < 16 {
        return Err("InvalidTag".to_string());
    }
    let ct = slice(data, 0, data.len() - 16);
    let (j0, tag) = gcm_tag(a, nonce, aad, ct);
    if not same_bytes(tag, slice(data, data.len() - 16, data.len())) {
        return Err("InvalidTag".to_string());
    }
    let mut ctr = j0.clone();
    increment(mut ctr, 4);
    Ok(ctr_xor(a, ctr, 4, ct))
}

// ------------------------------------------------------------ ChaCha20-Poly1305

fn quarter(s: mut ref Vec[u32], a: i64, b: i64, c: i64, d: i64) {
    s[a] = s[a].wrapping_add(s[b]);
    s[d] = (s[d] ^ s[a]).rotate_left(16);
    s[c] = s[c].wrapping_add(s[d]);
    s[b] = (s[b] ^ s[c]).rotate_left(12);
    s[a] = s[a].wrapping_add(s[b]);
    s[d] = (s[d] ^ s[a]).rotate_left(8);
    s[c] = s[c].wrapping_add(s[d]);
    s[b] = (s[b] ^ s[c]).rotate_left(7);
}

fn chacha_block(key: ref Vec[u8], counter: u32, nonce: ref Vec[u8]) -> Vec[u8] {
    let mut init: Vec[u32] = Vec.new();
    for x in [0x61707865u32, 0x3320646eu32, 0x79622d32u32, 0x6b206574u32] {
        init.push(x);
    }
    for k in 0..8 {
        init.push(le32(key, 4 * k));
    }
    init.push(counter);
    for k in 0..3 {
        init.push(le32(nonce, 4 * k));
    }
    let mut s = init.clone();
    for _ in 0..10 {
        quarter(mut s, 0, 4, 8, 12);
        quarter(mut s, 1, 5, 9, 13);
        quarter(mut s, 2, 6, 10, 14);
        quarter(mut s, 3, 7, 11, 15);
        quarter(mut s, 0, 5, 10, 15);
        quarter(mut s, 1, 6, 11, 12);
        quarter(mut s, 2, 7, 8, 13);
        quarter(mut s, 3, 4, 9, 14);
    }
    let mut out: Vec[u8] = Vec.new();
    for k in 0..16 {
        push_le32(mut out, s[k].wrapping_add(init[k]));
    }
    out
}

fn chacha_xor(key: ref Vec[u8], counter: u32, nonce: ref Vec[u8], data: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut n = counter;
    let mut at: i64 = 0;
    while at < data.len() {
        let ks = chacha_block(key, n, nonce);
        let mut k: i64 = 0;
        while k < 64 and at + k < data.len() {
            out.push(data[at + k] ^ ks[k]);
            k += 1;
        }
        n = n.wrapping_add(1u32);
        at += 64;
    }
    out
}

fn le32i(b: ref Vec[u8], i: i64) -> i64 {
    le32(b, i) as i64
}

// Poly1305 in five 26-bit limbs, as poly1305-donna does it.
fn poly1305(key: ref Vec[u8], msg: ref Vec[u8]) -> Vec[u8] {
    let mask: i64 = 0x3ffffff;
    let r0 = le32i(key, 0) & 0x3ffffff;
    let r1 = (le32i(key, 3) >> 2) & 0x3ffff03;
    let r2 = (le32i(key, 6) >> 4) & 0x3ffc0ff;
    let r3 = (le32i(key, 9) >> 6) & 0x3f03fff;
    let r4 = (le32i(key, 12) >> 8) & 0x00fffff;
    let s1 = r1 * 5;
    let s2 = r2 * 5;
    let s3 = r3 * 5;
    let s4 = r4 * 5;
    let mut h0: i64 = 0;
    let mut h1: i64 = 0;
    let mut h2: i64 = 0;
    let mut h3: i64 = 0;
    let mut h4: i64 = 0;
    let mut at: i64 = 0;
    while at < msg.len() {
        let mut m: Vec[u8] = Vec.new();
        let mut k: i64 = 0;
        while k < 16 and at + k < msg.len() {
            m.push(msg[at + k]);
            k += 1;
        }
        let hibit: i64 = if m.len() == 16 { 1 << 24 } else { 0 };
        if m.len() < 16 {
            m.push(1);
            while m.len() < 16 {
                m.push(0);
            }
        }
        h0 += le32i(m, 0) & mask;
        h1 += (le32i(m, 3) >> 2) & mask;
        h2 += (le32i(m, 6) >> 4) & mask;
        h3 += (le32i(m, 9) >> 6) & mask;
        h4 += (le32i(m, 12) >> 8) | hibit;
        let d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
        let mut d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2;
        let mut d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3;
        let mut d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4;
        let mut d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;
        let mut c = d0 >> 26;
        h0 = d0 & mask;
        d1 += c;
        c = d1 >> 26;
        h1 = d1 & mask;
        d2 += c;
        c = d2 >> 26;
        h2 = d2 & mask;
        d3 += c;
        c = d3 >> 26;
        h3 = d3 & mask;
        d4 += c;
        c = d4 >> 26;
        h4 = d4 & mask;
        h0 += c * 5;
        c = h0 >> 26;
        h0 = h0 & mask;
        h1 += c;
        at += 16;
    }
    let mut c = h1 >> 26;
    h1 = h1 & mask;
    h2 += c;
    c = h2 >> 26;
    h2 = h2 & mask;
    h3 += c;
    c = h3 >> 26;
    h3 = h3 & mask;
    h4 += c;
    c = h4 >> 26;
    h4 = h4 & mask;
    h0 += c * 5;
    c = h0 >> 26;
    h0 = h0 & mask;
    h1 += c;
    // h - p, kept when it does not go negative.
    let mut g0 = h0 + 5;
    c = g0 >> 26;
    g0 = g0 & mask;
    let mut g1 = h1 + c;
    c = g1 >> 26;
    g1 = g1 & mask;
    let mut g2 = h2 + c;
    c = g2 >> 26;
    g2 = g2 & mask;
    let mut g3 = h3 + c;
    c = g3 >> 26;
    g3 = g3 & mask;
    let g4 = h4 + c - (1 << 26);
    if g4 >= 0 {
        h0 = g0;
        h1 = g1;
        h2 = g2;
        h3 = g3;
        h4 = g4;
    }
    let m32: i64 = 0xffffffff;
    let w0 = (h0 | (h1 << 26)) & m32;
    let w1 = ((h1 >> 6) | (h2 << 20)) & m32;
    let w2 = ((h2 >> 12) | (h3 << 14)) & m32;
    let w3 = ((h3 >> 18) | (h4 << 8)) & m32;
    let mut out: Vec[u8] = Vec.new();
    let mut f = w0 + le32i(key, 16);
    push_le32(mut out, (f & m32) as u32);
    f = w1 + le32i(key, 20) + (f >> 32);
    push_le32(mut out, (f & m32) as u32);
    f = w2 + le32i(key, 24) + (f >> 32);
    push_le32(mut out, (f & m32) as u32);
    f = w3 + le32i(key, 28) + (f >> 32);
    push_le32(mut out, (f & m32) as u32);
    out
}

fn pad16(v: mut ref Vec[u8]) {
    while v.len() % 16 != 0 {
        v.push(0);
    }
}

fn chacha_tag(key: ref Vec[u8], nonce: ref Vec[u8], aad: ref Vec[u8], ct: ref Vec[u8]) -> Vec[u8] {
    let otk = slice(chacha_block(key, 0u32, nonce), 0, 32);
    let mut m = aad.clone();
    pad16(mut m);
    for x in ct {
        m.push(x);
    }
    pad16(mut m);
    push_le64(mut m, aad.len() as u64);
    push_le64(mut m, ct.len() as u64);
    poly1305(otk, m)
}

fn chacha_check(key: ref Vec[u8], nonce: ref Vec[u8]) -> Result[(), String] {
    if key.len() != 32 {
        return Err("ValueError: ChaCha20Poly1305 key must be 32 bytes.".to_string());
    }
    if nonce.len() != 12 {
        return Err("ValueError: Nonce must be 12 bytes".to_string());
    }
    Ok(())
}

fn chacha_seal(key: ref Vec[u8], nonce: ref Vec[u8], aad: ref Vec[u8], pt: ref Vec[u8]) -> Result[Vec[u8], String] {
    chacha_check(key, nonce)?;
    let ct = chacha_xor(key, 1u32, nonce, pt);
    let tag = chacha_tag(key, nonce, aad, ct);
    Ok(concat(ct, tag))
}

fn chacha_open(key: ref Vec[u8], nonce: ref Vec[u8], aad: ref Vec[u8], data: ref Vec[u8]) -> Result[Vec[u8], String] {
    chacha_check(key, nonce)?;
    if data.len() < 16 {
        return Err("InvalidTag".to_string());
    }
    let ct = slice(data, 0, data.len() - 16);
    if not same_bytes(chacha_tag(key, nonce, aad, ct), slice(data, data.len() - 16, data.len())) {
        return Err("InvalidTag".to_string());
    }
    Ok(chacha_xor(key, 1u32, nonce, ct))
}

// ------------------------------------------------------------ base64

const URLSAFE: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

fn b64_encode_urlsafe(b: ref Vec[u8]) -> String {
    let alpha = to_bytes(URLSAFE);
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let n = b.len() - i;
        let x0 = b[i] as i64;
        let x1 = if n > 1 { b[i + 1] as i64 } else { 0 };
        let x2 = if n > 2 { b[i + 2] as i64 } else { 0 };
        let v = (x0 << 16) | (x1 << 8) | x2;
        out.push(alpha[(v >> 18) & 63] as char);
        out.push(alpha[(v >> 12) & 63] as char);
        out.push(if n > 1 { alpha[(v >> 6) & 63] as char } else { '=' });
        out.push(if n > 2 { alpha[v & 63] as char } else { '=' });
        i += 3;
    }
    out
}

// A base64 digit of either alphabet, as urlsafe_b64decode reads them.
fn b64_value(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        (c - b'A') as i64
    } else if c >= b'a' and c <= b'z' {
        (c - b'a') as i64 + 26
    } else if c >= b'0' and c <= b'9' {
        (c - b'0') as i64 + 52
    } else if c == b'+' or c == b'-' {
        62
    } else if c == b'/' or c == b'_' {
        63
    } else {
        -1
    }
}

// Python's base64.urlsafe_b64decode, which is binascii's lenient decoder:
// characters outside the alphabet are skipped, and enough `=` after at
// least two digits of a group ends the input.
fn b64_decode_loose(s: ref String) -> Option[Vec[u8]] {
    let mut out: Vec[u8] = Vec.new();
    let mut quad: i64 = 0;
    let mut left: i64 = 0;
    let mut pads: i64 = 0;
    for c in s.bytes() {
        if c == b'=' {
            if quad >= 2 {
                pads += 1;
                if quad + pads >= 4 {
                    return Some(out);
                }
            }
            continue;
        }
        let v = b64_value(c);
        if v < 0 {
            continue;
        }
        pads = 0;
        if quad == 0 {
            left = v;
            quad = 1;
        } else if quad == 1 {
            out.push(((left << 2) | (v >> 4)) as u8);
            left = v & 0x0f;
            quad = 2;
        } else if quad == 2 {
            out.push(((left << 4) | (v >> 2)) as u8);
            left = v & 3;
            quad = 3;
        } else {
            out.push(((left << 6) | v) as u8);
            quad = 0;
        }
    }
    if quad != 0 {
        return None;
    }
    Some(out)
}

// ------------------------------------------------------------ Fernet

// A Fernet key: a signing key and an encryption key of 16 bytes each.
struct Fernet {
    sign: Hmac,
    enc: Aes,
}

fn fernet_new(key: ref String) -> Result[Fernet, String] {
    let bad = "ValueError: Fernet key must be 32 url-safe base64-encoded bytes.".to_string();
    let k = match b64_decode_loose(key) {
        Some(k) => k,
        None => return Err(bad),
    };
    if k.len() != 32 {
        return Err(bad);
    }
    let enc = aes_new(slice(k, 16, 32))?;
    Ok(Fernet { sign: hmac_key(slice(k, 0, 16)), enc: enc })
}

fn fernet_seal(f: ref Fernet, now: i64, iv: ref Vec[u8], pt: ref Vec[u8]) -> Result[String, String] {
    let mut padded = pt.clone();
    let n = 16 - pt.len() % 16;
    for _ in 0..n {
        padded.push(n as u8);
    }
    let ct = cbc_encrypt(f.enc, iv, padded)?;
    let mut data: Vec[u8] = Vec.new();
    data.push(0x80);
    push_be64(mut data, now as u64);
    for x in iv {
        data.push(x);
    }
    for x in ct {
        data.push(x);
    }
    let mac = hmac_with(f.sign, data);
    Ok(b64_encode_urlsafe(concat(data, mac)))
}

fn fernet_open(f: ref Fernet, token: ref String, ttl: i128, now: i128) -> Result[Vec[u8], String] {
    let bad: Result[Vec[u8], String] = Err("InvalidToken".to_string());
    let data = match b64_decode_loose(token) {
        Some(d) => d,
        None => return bad,
    };
    if data.is_empty() or data[0] != 0x80 or data.len() < 9 {
        return bad;
    }
    let mut ts: i128 = 0;
    for k in 1..9 {
        ts = ts * 256 + (data[k] as i128);
    }
    if ts + ttl < now or now + 60 < ts {
        return bad;
    }
    let split = if data.len() >= 32 { data.len() - 32 } else { 0 };
    let mac = hmac_with(f.sign, slice(data, 0, split));
    if not same_bytes(mac, slice(data, split, data.len())) {
        return bad;
    }
    let iv = slice(data, 9, 25);
    let ct = slice(data, 25, split);
    let padded = cbc_decrypt(f.enc, iv, ct)?;
    if padded.is_empty() {
        return bad;
    }
    let n = padded[padded.len() - 1] as i64;
    if n == 0 or n > 16 {
        return bad;
    }
    for k in padded.len() - n..padded.len() {
        if padded[k] as i64 != n {
            return bad;
        }
    }
    Ok(slice(padded, 0, padded.len() - n))
}

fn cbc_or_token(r: own Result[Vec[u8], String]) -> Result[Vec[u8], String] {
    match r {
        Ok(v) => Ok(v),
        Err(e) => if e == NOT_BLOCKS { Err("InvalidToken".to_string()) } else { Err(e) },
    }
}

// ------------------------------------------------------------ the vault

// A vault file: the KDF's parameters, a check value sealed under the key
// (so that a wrong passphrase is told apart from a damaged entry), and the
// entries in name order, each sealed with its name as associated data.
struct Secret {
    name: String,
    nonce: Vec[u8],
    ct: Vec[u8],
}

struct Vault {
    path: String,
    iters: i64,
    salt: Vec[u8],
    check_nonce: Vec[u8],
    check_ct: Vec[u8],
    entries: Vec[Secret],
}

fn not_found(path: ref String) -> String {
    f"FileNotFoundError: [Errno 2] No such file or directory: '{path}'"
}

fn vault_err(msg: String) -> String {
    f"VaultError: {msg}"
}

fn to_int(s: ref String) -> i64 {
    i64.parse(s.clone()).unwrap_or(0)
}

fn vault_load(name: ref String) -> Result[Vault, String] {
    let path = f"data/{name}";
    let text = match fs.read_to_string(path.clone()) {
        Ok(t) => t,
        Err(_) => return Err(not_found(path)),
    };
    let lines: Vec[String] = text.split("\n").map(|p| p.to_string()).collect();
    if lines.len() < 4 or lines[0] != "kvault 1" {
        return Err(vault_err("not a vault file".to_string()));
    }
    let kdf: Vec[String] = lines[1].split(" ").map(|p| p.to_string()).collect();
    let check: Vec[String] = lines[2].split(" ").map(|p| p.to_string()).collect();
    let mut entries: Vec[Secret] = Vec.new();
    for i in 3..lines.len() - 1 {
        let p: Vec[String] = lines[i].split(" ").map(|p| p.to_string()).collect();
        entries.push(Secret { name: p[1].clone(), nonce: unhex(p[2]), ct: unhex(p[3]) });
    }
    Ok(Vault {
        path: path,
        iters: to_int(kdf[2]),
        salt: unhex(kdf[3]),
        check_nonce: unhex(check[1]),
        check_ct: unhex(check[2]),
        entries: entries,
    })
}

fn vault_save(v: ref Vault) -> Result[(), String] {
    let mut out = String.new();
    out.push_str("kvault 1\n");
    out.push_str(f"kdf pbkdf2-sha256 {v.iters} {hex_of(v.salt)}\n");
    out.push_str(f"check {hex_of(v.check_nonce)} {hex_of(v.check_ct)}\n");
    for e in v.entries {
        out.push_str(f"entry {e.name} {hex_of(e.nonce)} {hex_of(e.ct)}\n");
    }
    match fs.write(v.path.clone(), out) {
        Ok(_) => Ok(()),
        Err(e) => Err(f"OSError: {e}"),
    }
}

fn vault_kdf(pw: ref Vec[u8], salt: ref Vec[u8], iters: i64) -> Vec[u8] {
    pbkdf2(pw, salt, iters, 32)
}

const CHECK_TEXT: Str = "kvault-check";

fn vault_unlock(v: ref Vault, pw: ref Vec[u8]) -> Result[Vec[u8], String] {
    let key = vault_kdf(pw, v.salt, v.iters);
    match gcm_open(key, v.check_nonce, to_bytes("check"), v.check_ct) {
        Ok(_) => Ok(key),
        Err(_) => Err(vault_err("wrong passphrase".to_string())),
    }
}

fn find_entry(v: ref Vault, name: ref String) -> i64 {
    for i in 0..v.entries.len() {
        if v.entries[i].name == name {
            return i;
        }
    }
    -1
}

fn open_entry(key: ref Vec[u8], e: ref Secret) -> Result[Vec[u8], String] {
    match gcm_open(key, e.nonce, to_bytes(e.name), e.ct) {
        Ok(p) => Ok(p),
        Err(_) => Err(vault_err(f"entry {e.name} is corrupt")),
    }
}

// The nonces a rekey uses: the first 12 bytes of HMAC(seed, i).
fn entry_nonce(seed: ref Vec[u8], i: i64) -> Vec[u8] {
    slice(hmac(seed, to_bytes(f"{i}")), 0, 12)
}

fn vault_job(f: ref Vec[String]) -> Result[String, String] {
    let kind = f[0].clone();
    if kind == "vault-init" {
        let pw = arg(f[2])?;
        let salt = arg(f[3])?;
        let iters = to_int(f[4]);
        let nonce = arg(f[5])?;
        let key = vault_kdf(pw, salt, iters);
        let ct = gcm_seal(key, nonce, to_bytes("check"), to_bytes(CHECK_TEXT))?;
        let v = Vault { path: f"data/{f[1]}", iters: iters, salt: salt, check_nonce: nonce, check_ct: ct, entries: Vec.new() };
        vault_save(v)?;
        return Ok(f"  created {f[1]}, {iters} iterations");
    }
    let mut v = vault_load(f[1])?;
    if kind == "vault-list" {
        if v.entries.is_empty() {
            return Ok("  (no entries)".to_string());
        }
        let names: Vec[String] = v.entries.iter().map(|e| f"  {e.name}").collect();
        return Ok(names.join("\n"));
    }
    if kind == "vault-cat" {
        let text = match fs.read_to_string(v.path.clone()) {
            Ok(t) => t,
            Err(_) => return Err(not_found(v.path)),
        };
        let lines: Vec[String] = text.lines().map(|l| f"  {l}").collect();
        return Ok(lines.join("\n"));
    }
    if kind == "vault-flip" {
        let i = find_entry(v, f[2]);
        if i < 0 {
            return Err(vault_err(f"no entry {f[2]}"));
        }
        let at = to_int(f[3]);
        v.entries[i].ct[at] = v.entries[i].ct[at] ^ 1;
        vault_save(v)?;
        return Ok(f"  flipped a bit of {f[2]}");
    }
    let key = vault_unlock(v, arg(f[2])?)?;
    if kind == "vault-put" {
        let name = f[3].clone();
        let value = arg(f[4])?;
        let nonce = arg(f[5])?;
        let ct = gcm_seal(key, nonce, to_bytes(name), value)?;
        let i = find_entry(v, name);
        if i >= 0 {
            v.entries[i].nonce = nonce;
            v.entries[i].ct = ct;
            vault_save(v)?;
            return Ok(f"  replaced {name} ({value.len()} bytes)");
        }
        let mut at: i64 = 0;
        while at < v.entries.len() and v.entries[at].name < name {
            at += 1;
        }
        v.entries.insert(at, Secret { name: name.clone(), nonce: nonce, ct: ct });
        vault_save(v)?;
        return Ok(f"  added {name} ({value.len()} bytes)");
    }
    if kind == "vault-get" {
        let i = find_entry(v, f[3]);
        if i < 0 {
            return Err(vault_err(f"no entry {f[3]}"));
        }
        return Ok(shown(open_entry(key, v.entries[i])?));
    }
    if kind == "vault-del" {
        let i = find_entry(v, f[3]);
        if i < 0 {
            return Err(vault_err(f"no entry {f[3]}"));
        }
        let _ = v.entries.remove(i);
        vault_save(v)?;
        return Ok(f"  deleted {f[3]}");
    }
    if kind == "vault-rekey" {
        let new_pw = arg(f[3])?;
        let salt = arg(f[4])?;
        let iters = to_int(f[5]);
        let seed = arg(f[6])?;
        let mut plain: Vec[Vec[u8]] = Vec.new();
        for e in v.entries {
            plain.push(open_entry(key, e)?);
        }
        let nkey = vault_kdf(new_pw, salt, iters);
        let n0 = entry_nonce(seed, 0);
        v.check_ct = gcm_seal(nkey, n0, to_bytes("check"), to_bytes(CHECK_TEXT))?;
        v.check_nonce = n0;
        v.salt = salt;
        v.iters = iters;
        for i in 0..v.entries.len() {
            let n = entry_nonce(seed, i + 1);
            v.entries[i].ct = gcm_seal(nkey, n, to_bytes(v.entries[i].name), plain[i])?;
            v.entries[i].nonce = n;
        }
        vault_save(v)?;
        return Ok(f"  rekeyed {plain.len()} entries, {iters} iterations");
    }
    Err(f"ValueError: {kind}")
}

// ------------------------------------------------------------ jobs

// A job's byte argument: x:<hex>, t:<text> with \n and \t escaped,
// f:<file in data/>, or - for nothing.
fn arg(s: ref String) -> Result[Vec[u8], String] {
    if s == "-" {
        return Ok(Vec.new());
    }
    let b = s.bytes();
    let rest = slice(b.to_vec(), 2, b.len());
    if s.starts_with("x:") {
        return Ok(unhex(String.from_utf8(rest).unwrap_or("".to_string())));
    }
    if s.starts_with("t:") {
        let mut out: Vec[u8] = Vec.new();
        let mut i: i64 = 0;
        while i < rest.len() {
            if rest[i] == b'\\' and i + 1 < rest.len() and rest[i + 1] == b'n' {
                out.push(b'\n');
                i += 2;
            } else {
                out.push(rest[i]);
                i += 1;
            }
        }
        let mut out2: Vec[u8] = Vec.new();
        i = 0;
        while i < out.len() {
            if out[i] == b'\\' and i + 1 < out.len() and out[i + 1] == b't' {
                out2.push(b'\t');
                i += 2;
            } else {
                out2.push(out[i]);
                i += 1;
            }
        }
        return Ok(out2);
    }
    if s.starts_with("f:") {
        let path = f"data/{String.from_utf8(rest).unwrap_or("".to_string())}";
        return match fs.read_bytes(path.clone()) {
            Ok(b) => Ok(b),
            Err(_) => Err(not_found(path)),
        };
    }
    Err(f"ValueError: bad argument {s}")
}

fn hexlines(b: ref Vec[u8]) -> String {
    if b.is_empty() {
        return "  (0 bytes)".to_string();
    }
    let mut lines: Vec[String] = Vec.new();
    let mut at: i64 = 0;
    while at < b.len() {
        let end = if at + 32 < b.len() { at + 32 } else { b.len() };
        lines.push(f"  {hex_of(slice(b, at, end))}");
        at += 32;
    }
    lines.join("\n")
}

// Printable UTF-8 as its lines, anything else as hex.
fn shown(b: ref Vec[u8]) -> String {
    for x in b {
        if x < 0x20 and x != b'\n' {
            return hexlines(b);
        }
    }
    match String.from_utf8(b.clone()) {
        Ok(s) => {
            let lines: Vec[String] = s.split("\n").map(|l| f"  | {l}").collect();
            lines.join("\n")
        }
        Err(_) => hexlines(b),
    }
}

fn run(f: ref Vec[String]) -> Result[String, String] {
    let kind = f[0].clone();
    if kind.starts_with("vault-") {
        return vault_job(f);
    }
    if kind == "pbkdf2" {
        return Ok(hexlines(pbkdf2(arg(f[1])?, arg(f[2])?, to_int(f[3]), to_int(f[4]))));
    }
    if kind == "hkdf" {
        return Ok(hexlines(hkdf(arg(f[1])?, arg(f[2])?, arg(f[3])?, to_int(f[4]))));
    }
    if kind == "fernet-seal" {
        let fk = fernet_new(f[1])?;
        return Ok(f"  {fernet_seal(fk, to_int(f[2]), arg(f[3])?, arg(f[4])?)?}");
    }
    if kind == "fernet-open" {
        let fk = fernet_new(f[1])?;
        let p = cbc_or_token(fernet_open(fk, f[2], to_int(f[3]) as i128, to_int(f[4]) as i128))?;
        return Ok(shown(p));
    }
    if kind == "fernet-multi" {
        let mut keys: Vec[Fernet] = Vec.new();
        for k in f[1].split(",") {
            keys.push(fernet_new(k.to_string())?);
        }
        for fk in keys {
            if let Ok(p) = cbc_or_token(fernet_open(fk, f[2], to_int(f[3]) as i128, to_int(f[4]) as i128)) {
                return Ok(shown(p));
            }
        }
        return Err("InvalidToken".to_string());
    }
    let mut a: Vec[Vec[u8]] = Vec.new();
    for i in 1..f.len() {
        a.push(arg(f[i])?);
    }
    if kind == "sha256" {
        return Ok(f"  {hex_of(sha256(a[0]))}");
    }
    if kind == "hmac" {
        return Ok(f"  {hex_of(hmac(a[0], a[1]))}");
    }
    if kind == "aes-ecb" {
        let k = aes_new(a[0])?;
        return Ok(hexlines(ecb_encrypt(k, a[1])?));
    }
    if kind == "aes-cbc" {
        let k = aes_new(a[0])?;
        return Ok(hexlines(cbc_encrypt(k, a[1], a[2])?));
    }
    if kind == "aes-ctr" {
        let k = aes_new(a[0])?;
        return Ok(hexlines(ctr_crypt(k, a[1], a[2])?));
    }
    if kind == "gcm-seal" {
        return Ok(hexlines(gcm_seal(a[0], a[1], a[2], a[3])?));
    }
    if kind == "gcm-open" {
        return Ok(shown(gcm_open(a[0], a[1], a[2], a[3])?));
    }
    if kind == "chacha-seal" {
        return Ok(hexlines(chacha_seal(a[0], a[1], a[2], a[3])?));
    }
    if kind == "chacha-open" {
        return Ok(shown(chacha_open(a[0], a[1], a[2], a[3])?));
    }
    Err(f"ValueError: {kind}")
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    for file in data_files() {
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.tsv: {e}");
            return;
        }
    };
    for job in jobs.lines() {
        let f: Vec[String] = job.split("\t").map(|p| p.to_string()).collect();
        println(f"== {f.join(" ")}");
        match run(f) {
            Ok(out) => println(out),
            Err(e) => println(f"  {e}"),
        }
    }
}

// ------------------------------------------------------------------ data
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    v
}

