// mini_vault: an encrypted secrets store for a deployment's keys and
// passwords, in the style of `ansible-vault` or a `pass` store, with every
// primitive written here from its specification:
// - SHA-256 (FIPS 180-4), HMAC (RFC 2104), PBKDF2 (RFC 8018) and HKDF
//   (RFC 5869);
// - AES-128/192/256 (FIPS 197) in ECB, CBC and CTR modes, AES-GCM
//   (SP 800-38D) with any nonce length, and ChaCha20-Poly1305 (RFC 8439);
// - Fernet tokens and key rotation with MultiFernet;
// - a vault file whose entries are each sealed with AES-GCM under a key
//   derived from a passphrase, with put, get, delete and rekey.
//
// The jobs are in data/jobs.tsv. expected.out is the output of oracle.py,
// which runs them with Python's `cryptography` library.

// ------------------------------------------------------------ bytes

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' {
        c - b'a' + 10
    } else if c >= b'A' {
        c - b'A' + 10
    } else {
        c - b'0'
    }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b {
        s.push_str(f"{x:02x}");
    }
    s
}

fn slice(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    v
}

fn concat(a: ref Vec[u8], b: ref Vec[u8]) -> Vec[u8] {
    let mut v = a.clone();
    for x in b {
        v.push(x);
    }
    v
}

// Compares in time that depends only on the lengths, as a MAC check must.
fn same_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut diff: u8 = 0;
    for i in 0..a.len() {
        diff = diff | (a[i] ^ b[i]);
    }
    diff == 0
}

fn be32(b: ref Vec[u8], i: i64) -> u32 {
    ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32)
}

fn le32(b: ref Vec[u8], i: i64) -> u32 {
    (b[i] as u32) | ((b[i + 1] as u32) << 8) | ((b[i + 2] as u32) << 16) | ((b[i + 3] as u32) << 24)
}

fn push_be32(out: mut ref Vec[u8], x: u32) {
    let mut k: i64 = 3;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
        k -= 1;
    }
}

fn push_le32(out: mut ref Vec[u8], x: u32) {
    for k in 0..4 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
    }
}

fn push_be64(out: mut ref Vec[u8], x: u64) {
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u64)) & 0xFFu64) as u8);
        k -= 1;
    }
}

fn push_le64(out: mut ref Vec[u8], x: u64) {
    for k in 0..8 {
        out.push(((x >> ((8 * k) as u64)) & 0xFFu64) as u8);
    }
}

// ------------------------------------------------------------ SHA-256

const SHA256_K: Array[u32, 64] = [
    0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32, 0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
    0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32, 0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
    0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32, 0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
    0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32, 0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
    0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32, 0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
    0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32, 0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
    0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32, 0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
    0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32, 0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32,
];

fn sha_init() -> Vec[u32] {
    let mut h: Vec[u32] = Vec.new();
    for x in [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32, 0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32] {
        h.push(x);
    }
    h
}

// Runs the compression function on the 64 bytes of m at `at`.
fn sha_compress(h: mut ref Vec[u32], w: mut ref Vec[u32], m: ref Vec[u8], at: i64) {
    for t in 0..16 {
        w[t] = be32(m, at + 4 * t);
    }
    for t in 16..64 {
        let s0 = w[t - 15].rotate_right(7) ^ w[t - 15].rotate_right(18) ^ (w[t - 15] >> 3u32);
        let s1 = w[t - 2].rotate_right(17) ^ w[t - 2].rotate_right(19) ^ (w[t - 2] >> 10u32);
        w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
    }
    let mut a = h[0];
    let mut b = h[1];
    let mut c = h[2];
    let mut d = h[3];
    let mut e = h[4];
    let mut f = h[5];
    let mut g = h[6];
    let mut hh = h[7];
    for t in 0..64 {
        let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
        let ch = (e & f) ^ ((e ^ 0xFFFFFFFFu32) & g);
        let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA256_K[t]).wrapping_add(w[t]);
        let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = s0.wrapping_add(maj);
        hh = g;
        g = f;
        f = e;
        e = d.wrapping_add(t1);
        d = c;
        c = b;
        b = a;
        a = t1.wrapping_add(t2);
    }
    h[0] = h[0].wrapping_add(a);
    h[1] = h[1].wrapping_add(b);
    h[2] = h[2].wrapping_add(c);
    h[3] = h[3].wrapping_add(d);
    h[4] = h[4].wrapping_add(e);
    h[5] = h[5].wrapping_add(f);
    h[6] = h[6].wrapping_add(g);
    h[7] = h[7].wrapping_add(hh);
}

fn new_schedule() -> Vec[u32] {
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..64 {
        w.push(0u32);
    }
    w
}

// Finishes a hash whose state has already taken `done` bytes (a whole
// number of blocks) with the rest of the message.
fn sha_finish(state: ref Vec[u32], done: i64, msg: ref Vec[u8]) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = ((done + msg.len()) * 8) as u64;
    m.push(0x80);
    while m.len() % 64 != 56 {
        m.push(0);
    }
    push_be64(mut m, bits);
    let mut h = state.clone();
    let mut w = new_schedule();
    let mut at: i64 = 0;
    while at < m.len() {
        sha_compress(mut h, mut w, m, at);
        at += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_be32(mut out, x);
    }
    out
}

fn sha256(msg: ref Vec[u8]) -> Vec[u8] {
    sha_finish(sha_init(), 0, msg)
}

// ------------------------------------------------------------ HMAC and KDFs

// HMAC-SHA256 with the key's two padded blocks already hashed, so that
// PBKDF2's thousands of HMACs cost two compressions each.
struct Hmac {
    inner: Vec[u32],
    outer: Vec[u32],
}

fn hmac_key(key: ref Vec[u8]) -> Hmac {
    let mut k = if key.len() > 64 { sha256(key) } else { key.clone() };
    while k.len() < 64 {
        k.push(0);
    }
    let mut ipad: Vec[u8] = Vec.new();
    let mut opad: Vec[u8] = Vec.new();
    for x in k {
        ipad.push(x ^ 0x36);
        opad.push(x ^ 0x5c);
    }
    let mut w = new_schedule();
    let mut inner = sha_init();
    sha_compress(mut inner, mut w, ipad, 0);
    let mut outer = sha_init();
    sha_compress(mut outer, mut w, opad, 0);
    Hmac { inner: inner, outer: outer }
}

fn hmac_with(h: ref Hmac, msg: ref Vec[u8]) -> Vec[u8] {
    let ih = sha_finish(h.inner, 64, msg);
    sha_finish(h.outer, 64, ih)
}

fn hmac(key: ref Vec[u8], msg: ref Vec[u8]) -> Vec[u8] {
    hmac_with(hmac_key(key), msg)
}

fn pbkdf2(pw: ref Vec[u8], salt: ref Vec[u8], iters: i64, len: i64) -> Vec[u8] {
    let h = hmac_key(pw);
    let mut out: Vec[u8] = Vec.new();
    let mut block: u32 = 1;
    while out.len() < len {
        let mut s = salt.clone();
        push_be32(mut s, block);
        let mut u = hmac_with(h, s);
        let mut t = u.clone();
        for _ in 1..iters {
            u = hmac_with(h, u);
            for i in 0..32 {
                t[i] = t[i] ^ u[i];
            }
        }
        for x in t {
            if out.len() < len {
                out.push(x);
            }
        }
        block += 1u32;
    }
    out
}

fn hkdf(ikm: ref Vec[u8], salt: ref Vec[u8], info: ref Vec[u8], len: i64) -> Vec[u8] {
    let s = if salt.is_empty() { slice(zeros(32), 0, 32) } else { salt.clone() };
    let prk = hmac_key(hmac(s, ikm));
    let mut out: Vec[u8] = Vec.new();
    let mut t: Vec[u8] = Vec.new();
    let mut i: u8 = 1;
    while out.len() < len {
        let mut m = concat(t, info);
        m.push(i);
        t = hmac_with(prk, m);
        for x in t {
            if out.len() < len {
                out.push(x);
            }
        }
        i += 1;
    }
    out
}

fn zeros(n: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for _ in 0..n {
        v.push(0);
    }
    v
}

// ------------------------------------------------------------ AES

