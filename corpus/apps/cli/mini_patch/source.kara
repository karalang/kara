fn patches_bad_patch() -> String {
    """
diff -u a/app.py b/app.py
--- a/app.py
+++ b/app.py
@@ -1,3 +1,4 @@
 import json
+import sys
 import logging
import os

"""
}

fn patches_notes_patch() -> String {
    """
Release notes for 1.9:
- faster checkout
- fewer timeouts

"""
}

fn write_trees() -> Result[(), String] {
    let dirs: Array[Str, 4] = ["before", "after", "drifted", "patches"];
    for i in 0..4 {
        let d = dirs[i];
        if let Err(e) = fs.create_dir_all(d.to_string()) {
            return Err(f"cannot create {d}: {e}");
        }
    }
    put("before/README.md", before_readme_md())?;
    put("before/app.py", before_app_py())?;
    put("before/legacy.ini", before_legacy_ini())?;
    put("before/nginx.conf", before_nginx_conf())?;
    put("before/schema.sql", before_schema_sql())?;
    put("after/README.md", after_readme_md())?;
    put("after/app.py", after_app_py())?;
    put("after/deploy.sh", after_deploy_sh())?;
    put("after/nginx.conf", after_nginx_conf())?;
    put("after/schema.sql", after_schema_sql())?;
    put("drifted/README.md", drifted_readme_md())?;
    put("drifted/app.py", drifted_app_py())?;
    put("drifted/legacy.ini", drifted_legacy_ini())?;
    put("drifted/nginx.conf", drifted_nginx_conf())?;
    put("drifted/schema.sql", drifted_schema_sql())?;
    put("patches/bad.patch", patches_bad_patch())?;
    put("patches/notes.patch", patches_notes_patch())?;
    Ok(())
}

// ------------------------------------------------------------ the runs

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// Prints how `tree` differs from `want`, then each reject file in it.
fn compare(tree: Str, want: Str) -> Result[(), String] {
    let d = tree_diff(want, tree, "want/", "got/")?;
    if d.len() == 0 {
        println(f"identical to {want}");
    } else {
        print(d);
    }
    let names = list_files(tree);
    for i in 0..names.len() {
        let n = ref names[i];
        if ends_with(n, ".rej") {
            println(f"-- {n}");
            let text = match fs.read_to_string(f"{tree}/{n}") {
                Ok(t) => t,
                Err(e) => return Err(f"cannot read {tree}/{n}: {e}"),
            };
            print(text);
        }
    }
    Ok(())
}

// One `patch -p1` run in `tree`, reading the patch from `pfile`.
fn run_patch(tree: Str, pfile: Str, reverse: bool) -> Result[(), String] {
    let text = match fs.read_to_string(pfile.to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read {pfile}: {e}"),
    };
    let mut out = String.new();
    let status = apply_patch(tree, text, reverse, mut out)?;
    print(out);
    println(f"[exit {status}]");
    Ok(())
}

fn run() -> Result[(), String] {
    write_trees()?;
    let p = tree_diff("before", "after", "a/", "b/")?;
    put("changes.patch", p.clone())?;
    println("== mini_patch diff before after > changes.patch");
    print(p);

    copy_tree("before", "work")?;
    println("== mini_patch apply -p1 work < changes.patch");
    run_patch("work", "changes.patch", false)?;
    compare("work", "after")?;
    println("== mini_patch apply -R -p1 work < changes.patch");
    run_patch("work", "changes.patch", true)?;
    compare("work", "before")?;

    copy_tree("drifted", "work")?;
    println("== mini_patch apply -p1 drifted < changes.patch");
    run_patch("work", "changes.patch", false)?;
    compare("work", "after")?;

    let broken: Array[Str, 2] = ["bad.patch", "notes.patch"];
    for i in 0..2 {
        let name = broken[i];
        copy_tree("before", "work")?;
        println(f"== mini_patch apply -p1 before < {name}");
        run_patch("work", f"patches/{name}", false)?;
        compare("work", "before")?;
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_patch: {e}");
    }
}
