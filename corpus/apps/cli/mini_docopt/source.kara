    t.push_str("    -v, --verbose         be more verbose\n");
    t.push_str("    -q, --quiet           be more quiet\n");
    t.push_str("    --progress            force progress reporting\n");
    t.push_str("    -n, --no-checkout     don't create a checkout\n");
