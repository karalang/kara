    t.push_str("    --recursive           initialize submodules in the clone\n");
    t.push_str("    --recurse-submodules  initialize submodules in the clone\n");
    t.push_str("    --template <template-directory>\n");
    t.push_str("                          directory from which templates will be used\n");
