// mini_docopt: docopt 0.6.2, the library that builds a command-line parser
// from the usage message itself, as Python 3.13 runs it. It ports how the
// usage section and the option descriptions are found in the text, the
// pattern parser with its language errors, the argv tokenizer with prefix
// matching of long options and stacked short ones, the [options]
// shortcut, the rewrite that makes repeated elements count or collect,
// and the backtracking matcher. Matching mutates the parsed objects as it
// goes, as docopt's does, so values can leak from one alternative into the
// next; the port keeps objects in an arena to get the same results.
//
// The jobs in data/jobs.jsonl run the programs from docopt's examples/
// directory and some made-up tools (docker run, curl, ssh, tar, kubectl,
// pip, a backup tool) over many command lines, docopt's git example
// dispatching to its subcommands, a Naval Fate session that carries out
// what it parses, and small cases that each test one rule.

// ------------------------------------------------------------ text helpers

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn slice(v: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    let mut i = a;
    while i < b and i < v.len() {
        out.push(v[i]);
        i += 1;
    }
    out
}

// str.isspace() for one character, which is also what `\s` matches.
fn py_space(c: char) -> bool {
    let n = c as u32;
    (n >= 9 and n <= 13) or (n >= 0x1C and n <= 0x20) or n == 0x85 or n == 0xA0 or n == 0x1680
        or (n >= 0x2000 and n <= 0x200A) or n == 0x2028 or n == 0x2029 or n == 0x202F or n == 0x205F
        or n == 0x3000
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut a = 0;
    let mut b = v.len();
    while a < b and py_space(v[a]) {
        a += 1;
    }
    while b > a and py_space(v[b - 1]) {
        b -= 1;
    }
    slice(v, a, b)
}

fn py_rstrip(s: ref String) -> String {
    let v = chars(s);
    let mut b = v.len();
    while b > 0 and py_space(v[b - 1]) {
        b -= 1;
    }
    slice(v, 0, b)
}

fn py_lstrip(s: ref String) -> String {
    let v = chars(s);
    let mut a = 0;
    while a < v.len() and py_space(v[a]) {
        a += 1;
    }
    slice(v, a, v.len())
}

fn hex_digits(n: u32, width: i64) -> String {
    let digits = chars("0123456789abcdef".to_string());
    let mut out: Vec[char] = Vec.new();
    let mut k = 0;
    let mut x = n;
    while k < width {
        out.push(digits[(x % 16) as i64]);
        x = x / 16;
        k += 1;
    }
    out.reverse();
    text(out)
}

// Whether repr() prints a character as it is.
fn printable(c: char) -> bool {
    let n = c as u32;
    if n < 0x20 or (n >= 0x7F and n <= 0xA0) or n == 0xAD {
        return false;
    }
    if (n >= 0x2000 and n <= 0x200F) or (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) {
        return false;
    }
    not (n == 0x1680 or n == 0x3000 or n == 0xFEFF or (n >= 0xD800 and n <= 0xDFFF))
}

// repr() of a str.
fn py_repr(s: ref String) -> String {
    let quote = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in s.chars() {
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if printable(c) {
            out.push(c);
        } else {
            let n = c as u32;
            if n < 0x100 {
                out.push_str("\\x");
                out.push_str(hex_digits(n, 2).as_str());
            } else if n < 0x10000 {
                out.push_str("\\u");
                out.push_str(hex_digits(n, 4).as_str());
            } else {
                out.push_str("\\U");
                out.push_str(hex_digits(n, 8).as_str());
            }
        }
    }
    out.push(quote);
    out
}

// str.splitlines(keepends=True), which is how codecs' readline cuts a file.
fn split_lines(s: ref String) -> Vec[String] {
    let v = chars(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        cur.push(c);
        let n = c as u32;
        let mut ends = (n >= 10 and n <= 13) or (n >= 0x1C and n <= 0x1E) or n == 0x85 or n == 0x2028
            or n == 0x2029;
        if c == '\r' and i + 1 < v.len() and v[i + 1] == '\n' {
            cur.push('\n');
            i += 1;
            ends = true;
        }
        if ends {
            out.push(cur.clone());
            cur = String.new();
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// ------------------------------------------------------------ JSON in

// The jobs file holds arrays, strings, small objects, booleans and null.
#[derive(Clone)]
enum J {
    S(String),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and py_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc = chars(w.to_string());
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else if c >= 'a' and c <= 'f' {
                (c as u32) - ('a' as u32) + 10
            } else {
                (c as u32) - ('A' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: chars(l), pos: 0 };
    p.value()
}

fn j_str(j: ref J) -> String {
    match j {
        J.S(s) => s.clone(),
        _ => String.new(),
    }
}

fn j_opt_str(j: ref J) -> Option[String] {
    match j {
        J.S(s) => Some(s.clone()),
        _ => None,
    }
}

fn j_strs(j: ref J) -> Vec[String] {
    match j {
        J.A(items) => items.iter().map(|x| j_str(x)).collect(),
        _ => Vec.new(),
    }
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_bool(j: ref J, default: bool) -> bool {
    match j {
        J.B(b) => b,
        _ => default,
    }
}

// json.dumps(s, ensure_ascii=False)
fn json_quote(s: ref String) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if (c as u32) < 0x20 {
            out.push_str("\\u");
            out.push_str(hex_digits(c as u32, 4).as_str());
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

// ------------------------------------------------------------ values and objects

// A value docopt stores on a pattern element. Lists live in the arena, so
// two elements can share one, as Python objects do.
#[derive(Clone)]
enum Pv {
    Nothing,
    Flag(bool),
    Count(i64),
    Text(String),
    List(i64),
}

// The three kinds of leaf: Argument, Command and Option.
#[derive(Clone)]
struct Leaf {
    kind: i64,
    name: Option[String],
    short: Option[String],
    long: Option[String],
    argcount: i64,
    value: Pv,
}

fn is_arg(l: ref Leaf) -> bool {
    l.kind == 0
}

fn is_cmd(l: ref Leaf) -> bool {
    l.kind == 1
}

fn is_opt(l: ref Leaf) -> bool {
    l.kind == 2
}

#[derive(Clone)]
enum Pat {
    Leaf(i64),
    Required(Vec[Pat]),
    Optional(Vec[Pat]),
    AnyOptions(Vec[Pat]),
    OneOrMore(Vec[Pat]),
    Either(Vec[Pat]),
}

// The objects one docopt() call makes.
struct World {
    leaves: Vec[Leaf],
    lists: Vec[Vec[String]],
}

fn opt_repr(o: ref Option[String]) -> String {
    match o {
        Some(s) => py_repr(s),
        None => "None".to_string(),
    }
}

// What a docopt() call ends with when it does not return a dict.
enum Stop {
    // a DocoptLanguageError, which the caller does not catch
    Lang(String),
    // DocoptExit: the message and usage, on stderr with status 1
    Exit(String),
    // help or version, printed with status 0
    Print(String),
}

impl World {
    fn add(mut ref self, l: own Leaf) -> i64 {
        self.leaves.push(l);
        self.leaves.len() - 1
    }

    fn new_list(mut ref self, items: own Vec[String]) -> i64 {
        self.lists.push(items);
        self.lists.len() - 1
    }

    fn argument(mut ref self, name: own Option[String], value: own Pv) -> i64 {
        self.add(Leaf { kind: 0, name: name, short: None, long: None, argcount: 0, value: value })
    }

    fn command(mut ref self, name: own Option[String], value: own Pv) -> i64 {
        self.add(Leaf { kind: 1, name: name, short: None, long: None, argcount: 0, value: value })
    }

    // Option(short, long, argcount, value): a False value of an option
    // with an argument becomes None.
    fn option(mut ref self, short: own Option[String], long: own Option[String], argcount: i64, value: own Pv) -> i64 {
        let v = match value {
            Pv.Flag(false) => if argcount > 0 { Pv.Nothing } else { Pv.Flag(false) },
            other => other.clone(),
        };
        self.add(Leaf { kind: 2, name: None, short: short, long: long, argcount: argcount, value: v })
    }

    fn copy_option(mut ref self, id: i64) -> i64 {
        let o = self.leaves[id].clone();
        self.option(o.short, o.long, o.argcount, o.value)
    }

    // The element's name: an option's long name or else its short one.
    fn name(ref self, id: i64) -> Option[String] {
        if self.leaves[id].kind == 2 {
            if self.leaves[id].long.is_some() {
                return self.leaves[id].long.clone();
            }
            return self.leaves[id].short.clone();
        }
        self.leaves[id].name.clone()
    }

    fn value_repr(ref self, v: ref Pv) -> String {
        match v {
            Pv.Nothing => "None".to_string(),
            Pv.Flag(b) => if b { "True".to_string() } else { "False".to_string() },
            Pv.Count(n) => f"{n}",
            Pv.Text(s) => py_repr(s),
            Pv.List(id) => {
                let parts: Vec[String] = self.lists[id].iter().map(|s| py_repr(s)).collect();
                let joined = parts.join(", ");
                f"[{joined}]"
            }
        }
    }

    fn truthy(ref self, v: ref Pv) -> bool {
        match v {
            Pv.Nothing => false,
            Pv.Flag(b) => b,
            Pv.Count(n) => n != 0,
            Pv.Text(s) => not s.is_empty(),
            Pv.List(id) => not self.lists[id].is_empty(),
        }
    }

    // repr() of a leaf, which is also how docopt compares them.
    fn repr(ref self, id: i64) -> String {
        let v = self.value_repr(self.leaves[id].value);
        let kind = self.leaves[id].kind;
        if kind == 2 {
            let s = opt_repr(self.leaves[id].short);
            let g = opt_repr(self.leaves[id].long);
            let n = self.leaves[id].argcount;
            return f"Option({s}, {g}, {n}, {v})";
        }
        let n = opt_repr(self.leaves[id].name);
        if kind == 1 { f"Command({n}, {v})" } else { f"Argument({n}, {v})" }
    }

    fn reprs_equal(ref self, a: ref Vec[i64], b: ref Vec[i64]) -> bool {
        if a.len() != b.len() {
            return false;
        }
        let mut i = 0;
        while i < a.len() {
            if a[i] != b[i] and self.repr(a[i]) != self.repr(b[i]) {
                return false;
            }
            i += 1;
        }
        true
    }
}

// ------------------------------------------------------------ the pattern tree

fn flat_into(p: ref Pat, out: mut ref Vec[i64]) {
    match p {
        Pat.Leaf(id) => out.push(id),
        Pat.Required(c) => flat_all(c, mut out),
        Pat.Optional(c) => flat_all(c, mut out),
        Pat.AnyOptions(c) => flat_all(c, mut out),
        Pat.OneOrMore(c) => flat_all(c, mut out),
        Pat.Either(c) => flat_all(c, mut out),
    }
}

fn flat_all(c: ref Vec[Pat], out: mut ref Vec[i64]) {
    for p in c.iter() {
        flat_into(p, mut out);
    }
}

fn flat(p: ref Pat) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    flat_into(p, mut out);
    out
}

fn count_any(p: ref Pat) -> i64 {
    match p {
        Pat.Leaf(_) => 0,
        Pat.AnyOptions(c) => 1 + count_all(c),
        Pat.Required(c) => count_all(c),
        Pat.Optional(c) => count_all(c),
        Pat.OneOrMore(c) => count_all(c),
        Pat.Either(c) => count_all(c),
    }
}

fn count_all(c: ref Vec[Pat]) -> i64 {
    let mut n = 0;
    for p in c.iter() {
        n += count_any(p);
    }
    n
}

// Gives every [options] its children: the documented options the pattern
// does not mention, a fresh set of objects for each one, copied from the
// options parse_defaults() found (nothing has changed them yet).
fn fill_any(p: own Pat, w: mut ref World, doc: ref Vec[i64], pattern_options: ref Vec[String]) -> Pat {
    match p {
        Pat.Leaf(id) => Pat.Leaf(id),
        Pat.AnyOptions(_) => {
            let mut kids: Vec[Pat] = Vec.new();
            let mut seen: Vec[String] = Vec.new();
            for d in doc.iter() {
                // parse_defaults(doc) again: a fresh object for each option.
                let id = w.copy_option(*d);
                let r = w.repr(id);
                if pattern_options.contains(r) or seen.contains(r) {
                    continue;
                }
                seen.push(r);
                kids.push(Pat.Leaf(id));
            }
            Pat.AnyOptions(kids)
        }
        Pat.Required(c) => Pat.Required(fill_list(c, mut w, doc, pattern_options)),
        Pat.Optional(c) => Pat.Optional(fill_list(c, mut w, doc, pattern_options)),
        Pat.OneOrMore(c) => Pat.OneOrMore(fill_list(c, mut w, doc, pattern_options)),
        Pat.Either(c) => Pat.Either(fill_list(c, mut w, doc, pattern_options)),
    }
}

fn fill_list(c: own Vec[Pat], w: mut ref World, doc: ref Vec[i64], pattern_options: ref Vec[String]) -> Vec[Pat] {
    let mut out: Vec[Pat] = Vec.new();
    for p in c.into_iter() {
        out.push(fill_any(p, mut w, doc, pattern_options));
    }
    out
}

// fix_identities(): equal leaves become one object, the first of them.
fn unify(p: own Pat, w: ref World, uniq: ref Vec[(String, i64)]) -> Pat {
    match p {
        Pat.Leaf(id) => {
            let r = w.repr(id);
            for (ur, uid) in uniq.iter() {
                if *ur == r {
                    return Pat.Leaf(uid);
                }
            }
            Pat.Leaf(id)
        }
        Pat.Required(c) => Pat.Required(unify_list(c, w, uniq)),
        Pat.Optional(c) => Pat.Optional(unify_list(c, w, uniq)),
        Pat.AnyOptions(c) => Pat.AnyOptions(unify_list(c, w, uniq)),
        Pat.OneOrMore(c) => Pat.OneOrMore(unify_list(c, w, uniq)),
        Pat.Either(c) => Pat.Either(unify_list(c, w, uniq)),
    }
}

fn unify_list(c: own Vec[Pat], w: ref World, uniq: ref Vec[(String, i64)]) -> Vec[Pat] {
    let mut out: Vec[Pat] = Vec.new();
    for p in c.into_iter() {
        out.push(unify(p, w, uniq));
    }
    out
}

fn kind_rank(p: ref Pat) -> i64 {
    match p {
        Pat.Either(_) => 0,
        Pat.Required(_) => 1,
        Pat.Optional(_) => 2,
        Pat.AnyOptions(_) => 3,
        Pat.OneOrMore(_) => 4,
        Pat.Leaf(_) => 5,
    }
}

fn kids(p: ref Pat) -> Vec[Pat] {
    match p {
        Pat.Leaf(_) => Vec.new(),
        Pat.Required(c) => c.clone(),
        Pat.Optional(c) => c.clone(),
        Pat.AnyOptions(c) => c.clone(),
        Pat.OneOrMore(c) => c.clone(),
        Pat.Either(c) => c.clone(),
    }
}

// The `either` property: every way through the pattern as a list of leaves.
fn either_cases(p: ref Pat) -> Vec[Vec[i64]] {
    let mut ret: Vec[Vec[i64]] = Vec.new();
    let mut groups: Vec[Vec[Pat]] = vec![vec![p.clone()]];
    let mut head = 0;
    while head < groups.len() {
        let children = groups[head].clone();
        head += 1;
        // The kind to expand: Either first, then Required, Optional,
        // [options] and OneOrMore, each time the first of that kind.
        let mut best = 5;
        for c in children.iter() {
            let r = kind_rank(c);
            if r < best {
                best = r;
            }
        }
        if best == 5 {
            let mut leaves: Vec[i64] = Vec.new();
            for c in children.iter() {
                if let Pat.Leaf(id) = c {
                    leaves.push(id);
                }
            }
            ret.push(leaves);
            continue;
        }
        let mut at = 0;
        while kind_rank(children[at]) != best {
            at += 1;
        }
        let picked = children[at].clone();
        let mut rest: Vec[Pat] = Vec.new();
        let mut k = 0;
        while k < children.len() {
            if k != at {
                rest.push(children[k].clone());
            }
            k += 1;
        }
        let inner = kids(picked);
        if best == 0 {
            for c in inner.iter() {
                let mut g: Vec[Pat] = vec![c.clone()];
                for r in rest.iter() {
                    g.push(r.clone());
                }
                groups.push(g);
            }
        } else {
            let mut g: Vec[Pat] = inner.clone();
            if best == 4 {
                for c in inner.iter() {
                    g.push(c.clone());
                }
            }
            for r in rest.iter() {
                g.push(r.clone());
            }
            groups.push(g);
        }
    }
    ret
}

fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if py_space(c) {
            if not cur.is_empty() {
                out.push(cur.clone());
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// fix_repeating_arguments(): an element that can occur twice in one way
// through the pattern collects a list or counts.
fn fix_repeating(p: ref Pat, w: mut ref World) {
    for case in either_cases(p).iter() {
        let mut repeated: Vec[i64] = Vec.new();
        for e in case.iter() {
            let mut n = 0;
            for f in case.iter() {
                if *f == *e {
                    n += 1;
                }
            }
            if n > 1 {
                repeated.push(*e);
            }
        }
        for e in repeated.iter() {
            let l = w.leaves[*e].clone();
            if is_arg(l) or (is_opt(l) and l.argcount > 0) {
                match l.value.clone() {
                    Pv.Nothing => {
                        let id = w.new_list(Vec.new());
                        w.leaves[*e].value = Pv.List(id);
                    }
                    Pv.List(_) => {}
                    Pv.Text(s) => {
                        let id = w.new_list(split_ws(s));
                        w.leaves[*e].value = Pv.List(id);
                    }
                    _ => {}
                }
            }
            if is_cmd(l) or (is_opt(l) and l.argcount == 0) {
                w.leaves[*e].value = Pv.Count(0);
            }
        }
    }
}

// ------------------------------------------------------------ matching

struct M {
    ok: bool,
    left: Vec[i64],
    collected: Vec[i64],
}

fn single_match(w: mut ref World, id: i64, left: ref Vec[i64]) -> Option[(i64, i64)] {
    let my_kind = w.leaves[id].kind;
    let my_name = w.name(id);
    let mut n = 0;
    while n < left.len() {
        let p = left[n];
        if my_kind == 2 {
            if my_name == w.name(p) {
                return Some((n, p));
            }
        } else if w.leaves[p].kind == 0 {
            let value = w.leaves[p].value.clone();
            if my_kind == 0 {
                let m = w.argument(my_name, value);
                return Some((n, m));
            }
            let same = match value {
                Pv.Text(s) => Some(s) == my_name,
                _ => false,
            };
            if same {
                let m = w.command(my_name, Pv.Flag(true));
                return Some((n, m));
            }
            return None;
        }
        n += 1;
    }
    None
}

fn match_leaf(w: mut ref World, id: i64, left: ref Vec[i64], collected: ref Vec[i64]) -> M {
    let (pos, m) = match single_match(mut w, id, left) {
        Some(r) => r,
        None => return M { ok: false, left: left.clone(), collected: collected.clone() },
    };
    let mut left2: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < left.len() {
        if k != pos {
            left2.push(left[k]);
        }
        k += 1;
    }
    let my_name = w.name(id);
    let mut same: Option[i64] = None;
    for c in collected.iter() {
        if w.name(*c) == my_name {
            same = Some(*c);
            break;
        }
    }
    let mut out = collected.clone();
    let increment = match w.leaves[id].value.clone() {
        Pv.Count(_) => Pv.Count(1),
        Pv.List(_) => match w.leaves[m].value.clone() {
            Pv.Text(s) => Pv.List(w.new_list(vec![s])),
            other => other.clone(),
        },
        _ => {
            out.push(m);
            return M { ok: true, left: left2, collected: out };
        }
    };
    match same {
        None => {
            w.leaves[m].value = increment;
            out.push(m);
        }
        Some(s) => {
            match (w.leaves[s].value.clone(), increment) {
                (Pv.Count(a), Pv.Count(b)) => w.leaves[s].value = Pv.Count(a + b),
                (Pv.Flag(a), Pv.Count(b)) => w.leaves[s].value = Pv.Count(if a { 1 + b } else { b }),
                (Pv.List(a), Pv.List(b)) => {
                    let more = w.lists[b].clone();
                    for x in more.into_iter() {
                        w.lists[a].push(x);
                    }
                }
                _ => {}
            }
        }
    }
    M { ok: true, left: left2, collected: out }
}

fn do_match(w: mut ref World, p: ref Pat, left: ref Vec[i64], collected: ref Vec[i64]) -> M {
    match p {
        Pat.Leaf(id) => match_leaf(mut w, id, left, collected),
        Pat.Required(c) => {
            let mut l = left.clone();
            let mut col = collected.clone();
            for q in c.iter() {
                let r = do_match(mut w, q, l, col);
                if not r.ok {
                    return M { ok: false, left: left.clone(), collected: collected.clone() };
                }
                l = r.left;
                col = r.collected;
            }
            M { ok: true, left: l, collected: col }
        }
        Pat.Optional(c) => match_optional(mut w, c, left, collected),
        Pat.AnyOptions(c) => match_optional(mut w, c, left, collected),
        Pat.OneOrMore(c) => {
            let mut l = left.clone();
            let mut col = collected.clone();
            let mut prev: Option[Vec[i64]] = None;
            let mut times = 0;
            loop {
                let r = do_match(mut w, c[0], l, col);
                if r.ok {
                    times += 1;
                }
                l = r.left;
                col = r.collected;
                if let Some(pl) = prev.clone() {
                    if w.reprs_equal(pl, l) {
                        break;
                    }
                }
                prev = Some(l.clone());
                if not r.ok {
                    break;
                }
            }
            if times >= 1 {
                return M { ok: true, left: l, collected: col };
            }
            M { ok: false, left: left.clone(), collected: collected.clone() }
        }
        Pat.Either(c) => {
            let mut best: Option[M] = None;
            let mut best_len = -1;
            for q in c.iter() {
                let r = do_match(mut w, q, left, collected);
                if r.ok and (best_len < 0 or r.left.len() < best_len) {
                    best_len = r.left.len();
                    best = Some(r);
                }
            }
            match best {
                Some(b) => b,
                None => M { ok: false, left: left.clone(), collected: collected.clone() },
            }
        }
    }
}

fn match_optional(w: mut ref World, c: ref Vec[Pat], left: ref Vec[i64], collected: ref Vec[i64]) -> M {
    let mut l = left.clone();
    let mut col = collected.clone();
    for q in c.iter() {
        let r = do_match(mut w, q, l, col);
        l = r.left;
        col = r.collected;
    }
    M { ok: true, left: l, collected: col }
}

// ------------------------------------------------------------ parsing

struct Tokens {
    items: Vec[String],
    pos: i64,
    // DocoptExit when parsing argv, DocoptLanguageError for the usage
    exit: bool,
}

impl Tokens {
    fn current(ref self) -> Option[String] {
        if self.pos < self.items.len() { Some(self.items[self.pos].clone()) } else { None }
    }

    fn is(ref self, s: Str) -> bool {
        self.pos < self.items.len() and self.items[self.pos] == s
    }

    fn step(mut ref self) {
        self.pos += 1;
    }

    fn take(mut ref self) -> Option[String] {
        let t = self.current();
        if t.is_some() {
            self.pos += 1;
        }
        t
    }

    fn error(ref self, msg: own String) -> Stop {
        if self.exit { Stop.Exit(msg) } else { Stop.Lang(msg) }
    }

    fn rest(ref self) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        let mut i = self.pos;
        while i < self.items.len() {
            out.push(self.items[i].clone());
            i += 1;
        }
        out
    }
}

fn find_char(v: ref Vec[char], c: char) -> i64 {
    let mut i = 0;
    while i < v.len() {
        if v[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn parse_long(t: mut ref Tokens, options: mut ref Vec[i64], w: mut ref World) -> Result[Vec[i64], Stop] {
    let tok = t.take().unwrap_or(String.new());
    let v = chars(tok);
    let eq_at = find_char(v, '=');
    let mut (long, has_eq, value) = if eq_at < 0 {
        (tok.clone(), false, None)
    } else {
        (slice(v, 0, eq_at), true, Some(slice(v, eq_at + 1, v.len())))
    };
    let mut similar: Vec[i64] = Vec.new();
    for o in options.iter() {
        if w.leaves[*o].long == Some(long.clone()) {
            similar.push(*o);
        }
    }
    if t.exit and similar.is_empty() {
        for o in options.iter() {
            if let Some(l) = w.leaves[*o].long.clone() {
                if l.starts_with(long.as_str()) {
                    similar.push(*o);
                }
            }
        }
    }
    if similar.len() > 1 {
        let names: Vec[String] = similar.iter().map(|o| w.leaves[*o].long.clone().unwrap_or(String.new())).collect();
        let joined = names.join(", ");
        return Err(t.error(f"{long} is not a unique prefix: {joined}?"));
    }
    if similar.is_empty() {
        let argcount = if has_eq { 1 } else { 0 };
        let o = w.option(None, Some(long.clone()), argcount, Pv.Flag(false));
        options.push(o);
        if t.exit {
            let val = if argcount > 0 { Pv.Text(value.unwrap_or(String.new())) } else { Pv.Flag(true) };
            return Ok(vec![w.option(None, Some(long), argcount, val)]);
        }
        return Ok(vec![o]);
    }
    let o = w.copy_option(similar[0]);
    let olong = w.leaves[o].long.clone().unwrap_or(String.new());
    if w.leaves[o].argcount == 0 {
        if value.is_some() {
            return Err(t.error(f"{olong} must not have an argument"));
        }
    } else if value.is_none() {
        if t.current().is_none() {
            return Err(t.error(f"{olong} requires argument"));
        }
        value = t.take();
    }
    if t.exit {
        w.leaves[o].value = match value {
            Some(s) => Pv.Text(s),
            None => Pv.Flag(true),
        };
    }
    Ok(vec![o])
}

fn parse_shorts(t: mut ref Tokens, options: mut ref Vec[i64], w: mut ref World) -> Result[Vec[i64], Stop] {
    let tok = t.take().unwrap_or(String.new());
    let v = chars(tok);
    let mut i = 0;
    while i < v.len() and v[i] == '-' {
        i += 1;
    }
    let mut parsed: Vec[i64] = Vec.new();
    while i < v.len() {
        let short = f"-{v[i]}";
        i += 1;
        let mut similar: Vec[i64] = Vec.new();
        for o in options.iter() {
            if w.leaves[*o].short == Some(short.clone()) {
                similar.push(*o);
            }
        }
        if similar.len() > 1 {
            return Err(t.error(f"{short} is specified ambiguously {similar.len()} times"));
        }
        if similar.is_empty() {
            let o = w.option(Some(short.clone()), None, 0, Pv.Flag(false));
            options.push(o);
            if t.exit {
                parsed.push(w.option(Some(short), None, 0, Pv.Flag(true)));
            } else {
                parsed.push(o);
            }
            continue;
        }
        let o = w.copy_option(similar[0]);
        let mut value: Option[String] = None;
        if w.leaves[o].argcount != 0 {
            if i >= v.len() {
                if t.current().is_none() {
                    return Err(t.error(f"{short} requires argument"));
                }
                value = t.take();
            } else {
                value = Some(slice(v, i, v.len()));
                i = v.len();
            }
        }
        if t.exit {
            w.leaves[o].value = match value {
                Some(s) => Pv.Text(s),
                None => Pv.Flag(true),
            };
        }
        parsed.push(o);
    }
    Ok(parsed)
}

// str.isupper()
fn py_isupper(s: ref String) -> bool {
    let mut cased = false;
    for c in s.chars() {
        let one = f"{c}";
        let lo = one.to_lowercase();
        let up = one.to_uppercase();
        if lo != up {
            cased = true;
            if one != up {
                return false;
            }
        }
    }
    cased
}

fn parse_atom(t: mut ref Tokens, options: mut ref Vec[i64], w: mut ref World) -> Result[Vec[Pat], Stop] {
    let token = t.current().unwrap_or(String.new());
    if token == "(" or token == "[" {
        t.step();
        let inner = parse_expr(mut t, mut options, mut w)?;
        let closing = if token == "(" { ")" } else { "]" };
        let got = t.take();
        if got != Some(closing.to_string()) {
            return Err(t.error(f"unmatched '{token}'"));
        }
        return Ok(vec![if token == "(" { Pat.Required(inner) } else { Pat.Optional(inner) }]);
    }
    if token == "options" {
        t.step();
        return Ok(vec![Pat.AnyOptions(Vec.new())]);
    }
    if token.starts_with("--") and token != "--" {
        let ids = parse_long(mut t, mut options, mut w)?;
        return Ok(ids.iter().map(|i| Pat.Leaf(*i)).collect());
    }
    if token.starts_with("-") and token != "-" and token != "--" {
        let ids = parse_shorts(mut t, mut options, mut w)?;
        return Ok(ids.iter().map(|i| Pat.Leaf(*i)).collect());
    }
    t.step();
    if (token.starts_with("<") and token.ends_with(">")) or py_isupper(token) {
        return Ok(vec![Pat.Leaf(w.argument(Some(token), Pv.Nothing))]);
    }
    Ok(vec![Pat.Leaf(w.command(Some(token), Pv.Flag(false)))])
}

fn parse_seq(t: mut ref Tokens, options: mut ref Vec[i64], w: mut ref World) -> Result[Vec[Pat], Stop] {
    let mut result: Vec[Pat] = Vec.new();
    loop {
        match t.current() {
            None => break,
            Some(c) => {
                if c == "]" or c == ")" or c == "|" {
                    break;
                }
            }
        }
        let mut atom = parse_atom(mut t, mut options, mut w)?;
        if t.is("...") {
            atom = vec![Pat.OneOrMore(atom)];
            t.step();
        }
        for a in atom.into_iter() {
            result.push(a);
        }
    }
    Ok(result)
}

fn parse_expr(t: mut ref Tokens, options: mut ref Vec[i64], w: mut ref World) -> Result[Vec[Pat], Stop] {
    let seq = parse_seq(mut t, mut options, mut w)?;
    if not t.is("|") {
        return Ok(seq);
    }
    let mut result: Vec[Pat] = if seq.len() > 1 { vec![Pat.Required(seq)] } else { seq };
    while t.is("|") {
        t.step();
        let s = parse_seq(mut t, mut options, mut w)?;
        if s.len() > 1 {
            result.push(Pat.Required(s));
        } else {
            for x in s.into_iter() {
                result.push(x);
            }
        }
    }
    if result.len() > 1 {
        return Ok(vec![Pat.Either(result)]);
    }
    Ok(result)
}

fn parse_pattern(source: ref String, options: mut ref Vec[i64], w: mut ref World) -> Result[Pat, Stop] {
    // re.sub(r'([\[\]\(\)\|]|\.\.\.)', r' \1 ', source)
    let v = chars(source);
    let mut spaced = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if c == '[' or c == ']' or c == '(' or c == ')' or c == '|' {
            spaced.push(' ');
            spaced.push(c);
            spaced.push(' ');
            i += 1;
        } else if c == '.' and i + 2 < v.len() and v[i + 1] == '.' and v[i + 2] == '.' {
            spaced.push_str(" ... ");
            i += 3;
        } else {
            spaced.push(c);
            i += 1;
        }
    }
    let mut t = Tokens { items: split_ws(spaced), pos: 0, exit: false };
    let result = parse_expr(mut t, mut options, mut w)?;
    if t.current().is_some() {
        let joined = py_repr(t.rest().join(" "));
        return Err(t.error(f"unexpected ending: {joined}"));
    }
    Ok(Pat.Required(result))
}

fn parse_argv(t: mut ref Tokens, options: mut ref Vec[i64], w: mut ref World, options_first: bool)
    -> Result[Vec[i64], Stop] {
    let mut parsed: Vec[i64] = Vec.new();
    loop {
        let cur = match t.current() {
            Some(c) => c,
            None => break,
        };
        if cur == "--" or (options_first and not cur.starts_with("-")) or (options_first and cur == "-") {
            for v in t.rest().into_iter() {
                parsed.push(w.argument(None, Pv.Text(v)));
            }
            return Ok(parsed);
        }
        if cur.starts_with("--") {
            for o in parse_long(mut t, mut options, mut w)? {
                parsed.push(o);
            }
        } else if cur.starts_with("-") and cur != "-" {
            for o in parse_shorts(mut t, mut options, mut w)? {
                parsed.push(o);
            }
        } else {
            t.step();
            parsed.push(w.argument(None, Pv.Text(cur)));
        }
    }
    Ok(parsed)
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' { char.try_from((c as u32) + 32).unwrap_or(c) } else { c }
}

// `\[default: (.*)\]` with re.I over v[a..b]: the first match's group.
fn find_default(v: ref Vec[char], a: i64, b: i64) -> Option[String] {
    let lead = chars("[default: ".to_string());
    let mut i = a;
    while i + lead.len() <= b {
        if v[i] == '[' {
            let mut ok = true;
            let mut k = 1;
            while k < lead.len() {
                if ascii_lower(v[i + k]) != lead[k] {
                    ok = false;
                    break;
                }
                k += 1;
            }
            if ok {
                let start = i + lead.len();
                let mut end = start;
                while end < b and v[end] != '\n' {
                    end += 1;
                }
                let mut j = end - 1;
                while j >= start {
                    if v[j] == ']' {
                        return Some(slice(v, start, j));
                    }
                    j -= 1;
                }
            }
        }
        i += 1;
    }
    None
}

// Option.parse() of the text v[a..b].
fn parse_option(v: ref Vec[char], a0: i64, b0: i64, w: mut ref World) -> i64 {
    let mut a = a0;
    let mut b = b0;
    while a < b and py_space(v[a]) {
        a += 1;
    }
    while b > a and py_space(v[b - 1]) {
        b -= 1;
    }
    // partition('  ')
    let mut cut = b;
    let mut i = a;
    while i + 1 < b {
        if v[i] == ' ' and v[i + 1] == ' ' {
            cut = i;
            break;
        }
        i += 1;
    }
    let mut cleaned = String.new();
    let mut k = a;
    while k < cut {
        let c = v[k];
        cleaned.push(if c == ',' or c == '=' { ' ' } else { c });
        k += 1;
    }
    let mut short: Option[String] = None;
    let mut long: Option[String] = None;
    let mut argcount = 0;
    for part in split_ws(cleaned).into_iter() {
        if part.starts_with("--") {
            long = Some(part);
        } else if part.starts_with("-") {
            short = Some(part);
        } else {
            argcount = 1;
        }
    }
    let mut value = Pv.Flag(false);
    if argcount > 0 {
        value = if cut + 2 <= b {
            match find_default(v, cut + 2, b) {
                Some(d) => Pv.Text(d),
                None => Pv.Nothing,
            }
        } else {
            Pv.Nothing
        };
    }
    w.option(short, long, argcount, value)
}

// parse_defaults(): re.split('\n *(<\S+?>|-\S+?)', doc), each piece that
// starts with `-` read as an option. A piece runs from its matched token to
// the next match.
fn parse_defaults(doc: ref String, w: mut ref World) -> Vec[i64] {
    let v = chars(doc);
    let mut starts: Vec[i64] = Vec.new();
    let mut ends: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < v.len() {
        let mut hit = -1;
        let mut j = i + 1;
        if v[i] == '\n' {
            while j < v.len() and v[j] == ' ' {
                j += 1;
            }
            // `<\S+?>`: at least one character, then up to the first `>`,
            // with no whitespace on the way.
            if j + 1 < v.len() and v[j] == '<' and not py_space(v[j + 1]) {
                let mut k = j + 2;
                while k < v.len() and not py_space(v[k]) and v[k] != '>' {
                    k += 1;
                }
                if k < v.len() and v[k] == '>' {
                    hit = k + 1;
                }
            }
            if hit < 0 and j + 1 < v.len() and v[j] == '-' and not py_space(v[j + 1]) {
                hit = j + 2;
            }
        }
        if hit >= 0 {
            if not starts.is_empty() {
                ends.push(i);
            }
            starts.push(j);
            i = hit;
        } else {
            i += 1;
        }
    }
    if not starts.is_empty() {
        ends.push(v.len());
    }
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < starts.len() {
        if v[starts[k]] == '-' {
            out.push(parse_option(v, starts[k], ends[k], mut w));
        }
        k += 1;
    }
    out
}

fn is_usage_at(v: ref Vec[char], i: i64) -> bool {
    if i + 6 > v.len() or ascii_lower(v[i]) != 'u' {
        return false;
    }
    ascii_lower(v[i + 1]) == 's' and ascii_lower(v[i + 2]) == 'a' and ascii_lower(v[i + 3]) == 'g'
        and ascii_lower(v[i + 4]) == 'e' and v[i + 5] == ':'
}

fn printable_usage(doc: ref String) -> Result[String, Stop] {
    let v = chars(doc);
    let mut starts: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < v.len() {
        if is_usage_at(v, i) {
            starts.push(i);
            i += 6;
        } else {
            i += 1;
        }
    }
    if starts.is_empty() {
        return Err(Stop.Lang("\"usage:\" (case-insensitive) not found.".to_string()));
    }
    if starts.len() > 1 {
        return Err(Stop.Lang("More than one \"usage:\" (case-insensitive).".to_string()));
    }
    // Up to the first `\n\s*\n`.
    let mut end = v.len();
    let mut k = starts[0];
    while k < v.len() {
        if v[k] == '\n' {
            let mut j = k + 1;
            let mut blank = false;
            while j < v.len() and py_space(v[j]) {
                if v[j] == '\n' {
                    blank = true;
                    break;
                }
                j += 1;
            }
            if blank {
                end = k;
                break;
            }
        }
        k += 1;
    }
    Ok(py_strip(slice(v, starts[0], end)))
}

fn formal_usage(usage: ref String) -> String {
    let words = split_ws(usage);
    let mut out = "( ".to_string();
    let mut parts: Vec[String] = Vec.new();
    let mut k = 2;
    while k < words.len() {
        parts.push(if words[k] == words[1] { ") | (".to_string() } else { words[k].clone() });
        k += 1;
    }
    out.push_str(parts.join(" ").as_str());
    out.push_str(" )");
    out
}

fn strip_newlines(s: ref String) -> String {
    let v = chars(s);
    let mut a = 0;
    let mut b = v.len();
    while a < b and v[a] == '\n' {
        a += 1;
    }
    while b > a and v[b - 1] == '\n' {
        b -= 1;
    }
    slice(v, a, b)
}

struct Parsed {
    w: World,
    items: Vec[(String, Pv)],
}

impl Parsed {
    fn get(ref self, key: Str) -> Pv {
        for (k, v) in self.items.iter() {
            if k == key {
                return v.clone();
            }
        }
        Pv.Nothing
    }

    fn text(ref self, key: Str) -> Option[String] {
        match self.get(key) {
            Pv.Text(s) => Some(s),
            _ => None,
        }
    }

    fn list(ref self, key: Str) -> Vec[String] {
        match self.get(key) {
            Pv.List(id) => self.w.lists[id].clone(),
            _ => Vec.new(),
        }
    }

    fn flag(ref self, key: Str) -> bool {
        self.w.truthy(self.get(key))
    }

    // repr() of the Dict docopt returns: its items sorted, one per line.
    fn repr(ref self) -> String {
        let mut keys: Vec[String] = self.items.iter().map(|kv| kv.0.clone()).collect();
        keys.sort();
        let mut parts: Vec[String] = Vec.new();
        for k in keys.iter() {
            let v = self.get(k.as_str());
            let kr = py_repr(k);
            let vr = self.w.value_repr(v);
            parts.push(f"{kr}: {vr}");
        }
        let mut out = "{".to_string();
        out.push_str(parts.join(",\n ").as_str());
        out.push('}');
        out
    }
}

struct Opts {
    help: bool,
    version: Option[String],
    options_first: bool,
}

// docopt(doc, argv, help, version, options_first)
fn docopt(doc: ref String, argv: ref Vec[String], o: ref Opts) -> Result[Parsed, Stop] {
    let mut w = World { leaves: Vec.new(), lists: Vec.new() };
    let usage = printable_usage(doc)?;
    let mut options = parse_defaults(doc, mut w);
    let documented = options.clone();
    let mut pattern = parse_pattern(formal_usage(usage), mut options, mut w)?;
    let mut opts_copy = options.clone();
    let mut t = Tokens { items: argv.clone(), pos: 0, exit: true };
    let parsed = match parse_argv(mut t, mut opts_copy, mut w, o.options_first) {
        Ok(p) => p,
        Err(Stop.Exit(msg)) => return Err(Stop.Exit(py_strip(f"{msg}\n{usage}"))),
        Err(e) => return Err(e),
    };
    let mut pattern_options: Vec[String] = Vec.new();
    for id in flat(pattern).iter() {
        if is_opt(w.leaves[*id]) {
            pattern_options.push(w.repr(*id));
        }
    }
    if count_any(pattern) > 0 {
        pattern = fill_any(pattern, mut w, documented, pattern_options);
    }
    if o.help {
        for id in parsed.iter() {
            let n = w.name(*id);
            if (n == Some("-h".to_string()) or n == Some("--help".to_string())) and w.truthy(w.leaves[*id].value) {
                return Err(Stop.Print(strip_newlines(doc)));
            }
        }
    }
    if let Some(ver) = o.version.clone() {
        for id in parsed.iter() {
            if w.name(*id) == Some("--version".to_string()) and w.truthy(w.leaves[*id].value) {
                return Err(Stop.Print(ver));
            }
        }
    }
    // fix(): one object per distinct leaf, then the repeating rules.
    let mut uniq: Vec[(String, i64)] = Vec.new();
    for id in flat(pattern).iter() {
        let r = w.repr(*id);
        let mut seen = false;
        for (ur, _) in uniq.iter() {
            if *ur == r {
                seen = true;
                break;
            }
        }
        if not seen {
            uniq.push((r, *id));
        }
    }
    pattern = unify(pattern, w, uniq);
    fix_repeating(pattern, mut w);
    let empty: Vec[i64] = Vec.new();
    let r = do_match(mut w, pattern, parsed, empty);
    if not r.ok or not r.left.is_empty() {
        return Err(Stop.Exit(py_strip(f"\n{usage}")));
    }
    let mut items: Vec[(String, Pv)] = Vec.new();
    let mut all = flat(pattern);
    for c in r.collected.iter() {
        all.push(*c);
    }
    for id in all.iter() {
        let name = w.name(*id).unwrap_or(String.new());
        let value = w.leaves[*id].value.clone();
        let mut found = false;
        let mut k = 0;
        while k < items.len() {
            if items[k].0 == name {
                items[k].1 = value.clone();
                found = true;
                break;
            }
            k += 1;
        }
        if not found {
            items.push((name, value));
        }
    }
    Ok(Parsed { w: w, items: items })
}

// ------------------------------------------------------------ jobs

// str.splitlines()
fn lines_of(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for l in split_lines(s).iter() {
        let v = chars(l);
        let mut end = v.len();
        if end >= 2 and v[end - 2] == '\r' and v[end - 1] == '\n' {
            end -= 2;
        } else if end >= 1 {
            let n = v[end - 1] as u32;
            if (n >= 10 and n <= 13) or (n >= 0x1C and n <= 0x1E) or n == 0x85 or n == 0x2028 or n == 0x2029 {
                end -= 1;
            }
        }
        out.push(slice(v, 0, end));
    }
    out
}

fn show(r: ref Result[Parsed, Stop], out: mut ref Vec[String]) {
    match r {
        Ok(args) => {
            for l in lines_of(args.repr()).iter() {
                out.push(l.clone());
            }
        }
        Err(Stop.Print(text)) => {
            for l in lines_of(text).iter() {
                out.push(l.clone());
            }
        }
        Err(Stop.Exit(msg)) => {
            for l in lines_of(msg).iter() {
                out.push(f"stderr: {l}");
            }
            out.push("exit 1".to_string());
        }
        Err(Stop.Lang(msg)) => {
            out.push(f"uncaught DocoptLanguageError: {msg}");
            out.push("exit 1".to_string());
        }
    }
}

fn read_doc(name: ref String) -> Result[String, String] {
    match fs.read_to_string(f"data/docs/{name}.txt") {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {name}: {e}"),
    }
}

fn argv_json(argv: ref Vec[String]) -> String {
    let parts: Vec[String] = argv.iter().map(|a| json_quote(a)).collect();
    let joined = parts.join(", ");
    f"[{joined}]"
}

fn opts_of(j: ref J) -> Opts {
    Opts { help: j_bool(j_get(j, "help"), true), version: j_opt_str(j_get(j, "version")),
           options_first: j_bool(j_get(j, "options_first"), false) }
}

fn plain() -> Opts {
    Opts { help: true, version: None, options_first: false }
}

fn git_opts() -> Opts {
    Opts { help: true, version: Some("git version 1.7.4.4".to_string()), options_first: true }
}

fn job_git(argv: ref Vec[String], out: mut ref Vec[String]) -> Result[(), String] {
    let aj = argv_json(argv);
    out.push(f"== git {aj}");
    let r = docopt(read_doc("git".to_string())?, argv, git_opts());
    let args = match r {
        Ok(a) => a,
        Err(_) => {
            show(r, mut out);
            return Ok(());
        }
    };
    let cmd = args.text("<command>");
    let subs = vec!["add", "branch", "checkout", "clone", "commit", "push", "remote"];
    match cmd {
        Some(c) => {
            if subs.iter().any(|x| x == c.as_str()) {
                let mut sub = vec![c.clone()];
                for a in args.list("<args>").into_iter() {
                    sub.push(a);
                }
                let sj = argv_json(sub);
                out.push(f"-> git_{c} {sj}");
                let r2 = docopt(read_doc(f"git_{c}")?, sub, plain());
                show(r2, mut out);
            } else if c == "help" {
                out.push("-> git --help".to_string());
                let r2 = docopt(read_doc("git".to_string())?, vec!["--help".to_string()], git_opts());
                show(r2, mut out);
            } else {
                let q = py_repr(c);
                out.push(f"stderr: {q} is not a git.py command. See 'git help'.");
                out.push("exit 1".to_string());
            }
        }
        None => {
            out.push("-> git --help".to_string());
            let r2 = docopt(read_doc("git".to_string())?, vec!["--help".to_string()], git_opts());
            show(r2, mut out);
        }
    }
    Ok(())
}

// int() of a str: optional whitespace and sign, digits with single
// underscores between them.
fn py_int_parse(s: ref String) -> Option[i64] {
    let v = chars(py_strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < v.len() and (v[i] == '+' or v[i] == '-') {
        neg = v[i] == '-';
        i += 1;
    }
    if i >= v.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut last_digit = false;
    while i < v.len() {
        let c = v[i];
        if c >= '0' and c <= '9' {
            n = n * 10 + ((c as u32) - ('0' as u32)) as i64;
            last_digit = true;
        } else if c == '_' and last_digit and i + 1 < v.len() {
            last_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if not last_digit {
        return None;
    }
    Some(if neg { -n } else { n })
}

fn abs_i(n: i64) -> i64 {
    if n < 0 { -n } else { n }
}

struct Ship {
    name: String,
    x: i64,
    y: i64,
}

struct Mine {
    x: i64,
    y: i64,
    kind: String,
}

fn job_naval(lines: ref Vec[String], out: mut ref Vec[String]) -> Result[(), String] {
    out.push(f"== naval session ({lines.len()} commands)");
    let doc = read_doc("naval_fate".to_string())?;
    let mut ships: Vec[Ship] = Vec.new();
    let mut mines: Vec[Mine] = Vec.new();
    let opts = Opts { help: true, version: Some("Naval Fate 2.0".to_string()), options_first: false };
    for line in lines.iter() {
        out.push(f"$ naval_fate.py {line}");
        let r = docopt(doc, split_ws(line), opts);
        let args = match r {
            Ok(a) => a,
            Err(_) => {
                show(r, mut out);
                continue;
            }
        };
        let xs = args.text("<x>");
        let ys = args.text("<y>");
        let mut x = 0;
        let mut y = 0;
        let mut bad = false;
        if let Some(s) = xs.clone() {
            match py_int_parse(s) {
                Some(n) => x = n,
                None => bad = true,
            }
        }
        if let Some(s) = ys.clone() {
            match py_int_parse(s) {
                Some(n) => y = n,
                None => bad = true,
            }
        }
        if bad {
            let a = xs.unwrap_or("None".to_string());
            let b = ys.unwrap_or("None".to_string());
            out.push(f"  bad coordinates: {a} {b}");
            continue;
        }
        if args.flag("ship") and args.flag("new") {
            for n in args.list("<name>").into_iter() {
                let mut exists = false;
                for s in ships.iter() {
                    if s.name == n {
                        exists = true;
                    }
                }
                if exists {
                    out.push(f"  ship {n} already exists");
                } else {
                    out.push(f"  launched {n} at (0, 0)");
                    ships.push(Ship { name: n, x: 0, y: 0 });
                }
            }
        } else if args.flag("ship") and args.flag("move") {
            let names = args.list("<name>");
            let n = names[0].clone();
            let mut at = -1;
            let mut k = 0;
            while k < ships.len() {
                if ships[k].name == n {
                    at = k;
                    break;
                }
                k += 1;
            }
            if at < 0 {
                out.push(f"  no ship named {n}");
                continue;
            }
            let sp = args.text("--speed").unwrap_or(String.new());
            let speed = match py_int_parse(sp) {
                Some(v) => v,
                None => {
                    out.push(f"  bad speed: {sp}");
                    continue;
                }
            };
            let (ox, oy) = (ships[at].x, ships[at].y);
            let dist = abs_i(x - ox) + abs_i(y - oy);
            out.push(f"  {n} moves from ({ox}, {oy}) to ({x}, {y}) at {speed} knots, {dist} miles");
            ships[at].x = x;
            ships[at].y = y;
            let mut hit = -1;
            let mut m = 0;
            while m < mines.len() {
                if mines[m].x == x and mines[m].y == y {
                    hit = m;
                    break;
                }
                m += 1;
            }
            if hit >= 0 {
                let kind = mines[hit].kind.clone();
                out.push(f"  {n} hits a {kind} mine at ({x}, {y}) and sinks");
                ships.remove(at);
                mines.remove(hit);
            }
        } else if args.flag("ship") and args.flag("shoot") {
            let mut sunk: Vec[String] = Vec.new();
            let mut kept: Vec[Ship] = Vec.new();
            for s in ships.into_iter() {
                if s.x == x and s.y == y {
                    sunk.push(s.name.clone());
                } else {
                    kept.push(s);
                }
            }
            ships = kept;
            if sunk.is_empty() {
                out.push(f"  shot at ({x}, {y}) hits nothing");
            } else {
                let names = sunk.join(", ");
                out.push(f"  shot at ({x}, {y}) sinks {names}");
            }
        } else if args.flag("mine") {
            let mut here = -1;
            let mut m = 0;
            while m < mines.len() {
                if mines[m].x == x and mines[m].y == y {
                    here = m;
                    break;
                }
                m += 1;
            }
            if args.flag("set") {
                let kind = if args.flag("--drifting") { "drifting" } else { "moored" };
                if here >= 0 {
                    out.push(f"  a mine is already at ({x}, {y})");
                } else {
                    mines.push(Mine { x: x, y: y, kind: kind.to_string() });
                    out.push(f"  {kind} mine set at ({x}, {y})");
                }
            } else if here >= 0 {
                mines.remove(here);
                out.push(f"  mine removed from ({x}, {y})");
            } else {
                out.push(f"  no mine at ({x}, {y})");
            }
        }
    }
    let fleet: Vec[String] = ships.iter().map(|s| f"{s.name} ({s.x}, {s.y})").collect();
    let laid: Vec[String] = mines.iter().map(|m| f"({m.x}, {m.y}) {m.kind}").collect();
    let f = if fleet.is_empty() { "none".to_string() } else { fleet.join(", ") };
    let g = if laid.is_empty() { "none".to_string() } else { laid.join(", ") };
    out.push(f"fleet: {f}");
    out.push(f"mines: {g}");
    Ok(())
}

fn run() -> Result[(), String] {
    let jobs = match fs.read_to_string("data/jobs.jsonl") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read jobs.jsonl: {e}"),
    };
    let mut out: Vec[String] = Vec.new();
    for l in jobs.lines() {
        if l.trim().is_empty() {
            continue;
        }
        let items = match json_line(l.to_string())? {
            J.A(items) => items,
            _ => return Err(f"bad job line: {l}"),
        };
        let kind = j_str(items[0]);
        if kind == "docopt" {
            let name = j_str(items[1]);
            let argv = j_strs(items[2]);
            let aj = argv_json(argv);
            out.push(f"== {name} {aj}");
            let r = docopt(read_doc(name)?, argv, opts_of(items[3]));
            show(r, mut out);
        } else if kind == "case" {
            let label = json_quote(j_str(items[1]));
            let doc = j_str(items[2]);
            let argv = j_strs(items[3]);
            let aj = argv_json(argv);
            out.push(f"== case {label} {aj}");
            let r = docopt(doc, argv, opts_of(items[4]));
            show(r, mut out);
        } else if kind == "git" {
            job_git(j_strs(items[1]), mut out)?;
        } else if kind == "naval" {
            job_naval(j_strs(items[1]), mut out)?;
        }
    }
    let mut text = out.join("\n");
    text.push('\n');
    print(text);
    Ok(())
}

// ------------------------------------------------------------ data

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("Usage: arguments_example.py [-vqrh] [FILE] ...\n");
    t.push_str("          arguments_example.py (--left | --right) CORRECTION FILE\n");
    t.push_str("\n");
    t.push_str("Process FILE and optionally apply correction to either left-hand side or\n");
    t.push_str("right-hand side.\n");
    t.push_str("\n");
    t.push_str("Arguments:\n");
    t.push_str("  FILE        optional input file\n");
    t.push_str("  CORRECTION  correction angle, needs FILE, --left or --right to be present\n");
    t.push_str("\n");
    t.push_str("Options:\n");
    t.push_str("  -h --help\n");
    t.push_str("  -v       verbose mode\n");
    t.push_str("  -q       quiet mode\n");
    t.push_str("  -r       make report\n");
    t.push_str("  --left   use left-hand side\n");
    t.push_str("  --right  use right-hand side\n");
    t.push_str("\n");
    v.push(DataFile { path: "docs/arguments.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("backup -- snapshot directories to a repository.\n");
    t.push_str("\n");
    t.push_str("USAGE:\n");
    t.push_str("    backup init <repo>\n");
    t.push_str("    backup snapshot <repo> <path>... [--tag=<tag>]... [--exclude=<glob>]... [--dry-run]\n");
    t.push_str("    backup restore <repo> <snapshot> [--target=<dir>] [--include=<glob>]...\n");
    t.push_str("    backup forget <repo> (--keep-last=<n> | --keep-daily=<n> | --keep-weekly=<n>)... [--prune]\n");
    t.push_str("    backup (ls | stats) <repo> [<snapshot>]\n");
    t.push_str("    backup --version\n");
    t.push_str("\n");
    t.push_str("Options:\n");
    t.push_str("    --tag=<tag>          Tag the snapshot.\n");
    t.push_str("    --exclude=<glob>     Leave out matching files.\n");
    t.push_str("    --dry-run            Only say what would be done.\n");
    t.push_str("    --target=<dir>       Where to restore to [default: .].\n");
    t.push_str("    --include=<glob>     Restore only matching files.\n");
    t.push_str("    --keep-last=<n>      Keep the last n snapshots.\n");
    t.push_str("    --keep-daily=<n>     Keep one snapshot a day for n days.\n");
    t.push_str("    --keep-weekly=<n>    Keep one snapshot a week for n weeks.\n");
    t.push_str("    --prune              Delete data nothing refers to any more.\n");
    v.push(DataFile { path: "docs/backup.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Not a serious example.\n");
    t.push_str("\n");
    t.push_str("Usage:\n");
    t.push_str("  calculator_example.py <value> ( ( + | - | * | / ) <value> )...\n");
    t.push_str("  calculator_example.py <function> <value> [( , <value> )]...\n");
    t.push_str("  calculator_example.py (-h | --help)\n");
    t.push_str("\n");
    t.push_str("Examples:\n");
    t.push_str("  calculator_example.py 1 + 2 + 3 + 4 + 5\n");
    t.push_str("  calculator_example.py 1 + 2 '*' 3 / 4 - 5    # note quotes around '*'\n");
    t.push_str("  calculator_example.py sum 10 , 20 , 30 , 40\n");
    t.push_str("\n");
    t.push_str("Options:\n");
    t.push_str("  -h, --help\n");
    t.push_str("\n");
    v.push(DataFile { path: "docs/calculator.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Usage: counted_example.py --help\n");
    t.push_str("       counted_example.py -v...\n");
    t.push_str("       counted_example.py go [go]\n");
    t.push_str("       counted_example.py (--path=<path>)...\n");
    t.push_str("       counted_example.py <file> <file>\n");
    t.push_str("\n");
    t.push_str("Try: counted_example.py -vvvvvvvvvv\n");
