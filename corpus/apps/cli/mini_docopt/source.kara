    let mut t = String.new();
    t.push_str("Usage:\n");
    t.push_str("  quick_example.py tcp <host> <port> [--timeout=<seconds>]\n");
    t.push_str("  quick_example.py serial <port> [--baud=9600] [--timeout=<seconds>]\n");
    t.push_str("  quick_example.py -h | --help | --version\n");
    t.push_str("\n");
    v.push(DataFile { path: "docs/quick.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("OpenSSH client, in docopt's words.\n");
    t.push_str("\n");
    t.push_str("Usage:\n");
    t.push_str("  ssh [-46AaCNqT] [-v]... [-p <port>] [-i <identity>]... [-L <spec>]... [-o <option>]... <destination> [<command>...]\n");
    t.push_str("  ssh -V\n");
    t.push_str("\n");
    t.push_str("Options:\n");
    t.push_str("  -4             Use IPv4 addresses only.\n");
    t.push_str("  -6             Use IPv6 addresses only.\n");
    t.push_str("  -A             Enable forwarding of the authentication agent.\n");
    t.push_str("  -a             Disable forwarding of the authentication agent.\n");
    t.push_str("  -C             Request compression of all data.\n");
    t.push_str("  -N             Do not execute a remote command.\n");
    t.push_str("  -q             Quiet mode.\n");
    t.push_str("  -T             Disable pseudo-terminal allocation.\n");
    t.push_str("  -v             Verbose mode; give it several times for more.\n");
    t.push_str("  -p <port>      Port to connect to on the remote host [default: 22].\n");
    t.push_str("  -i <identity>  Identity (private key) file.\n");
    t.push_str("  -L <spec>      Local port forwarding, [bind_address:]port:host:hostport.\n");
    t.push_str("  -o <option>    Options in the format used in the configuration file.\n");
    t.push_str("  -V             Display the version number and exit.\n");
    v.push(DataFile { path: "docs/ssh.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Usage: tar (-c | -x | -t) [-vzjp] [-f ARCHIVE] [-C DIR] [--exclude=PATTERN]... [FILE...]\n");
    t.push_str("       tar --help\n");
    t.push_str("\n");
    t.push_str("  -c             create a new archive\n");
    t.push_str("  -x             extract files from an archive\n");
    t.push_str("  -t             list the contents of an archive\n");
    t.push_str("  -v             verbosely list files processed\n");
    t.push_str("  -z             filter the archive through gzip\n");
    t.push_str("  -j             filter the archive through bzip2\n");
    t.push_str("  -p             preserve permissions\n");
    t.push_str("  -f ARCHIVE     use archive file ARCHIVE [default: -]\n");
    t.push_str("  -C DIR         change to directory DIR\n");
    t.push_str("  --exclude=PATTERN  exclude files matching PATTERN\n");
    t.push_str("  --help         give this help list\n");
    v.push(DataFile { path: "docs/tar.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Usage: prog.py [--count=N] PATH FILE...\n");
    t.push_str("\n");
    t.push_str("Arguments:\n");
    t.push_str("  FILE     input file\n");
    t.push_str("  PATH     out directory\n");
    t.push_str("\n");
    t.push_str("Options:\n");
    t.push_str("  --count=N   number of operations\n");
    t.push_str("\n");
    v.push(DataFile { path: "docs/validation.txt".to_string(), hex: false, body: t });
}

