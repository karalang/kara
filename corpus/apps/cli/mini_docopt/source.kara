    t.push_str("                          use <branch> instead of 'origin' to track upstream\n");
    t.push_str("    -b, --branch <branch>\n");
    t.push_str("                          checkout <branch> instead of the remote's HEAD\n");
    t.push_str("    -u, --upload-pack <path>\n");
    t.push_str("                          path to git-upload-pack on the remote\n");
    t.push_str("    --depth <depth>       create a shallow clone of that depth\n");
    t.push_str("\n");
