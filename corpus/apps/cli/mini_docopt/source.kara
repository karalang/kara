    t.push_str("  -h, --help          Show help.\n");
    t.push_str("  --isolated          Run pip in an isolated mode.\n");
    t.push_str("  -v, --verbose       Give more output.\n");
    t.push_str("  -q, --quiet         Give less output.\n");
