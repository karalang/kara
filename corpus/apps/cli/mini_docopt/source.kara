fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("Example of program which uses [options] shortcut in pattern.\n");
    t.push_str("\n");
    t.push_str("Usage:\n");
    t.push_str("  options_shortcut_example.py [options] <port>\n");
    t.push_str("\n");
