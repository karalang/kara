// mini_iso3166 — a port of iso3166 3.0.0 (MIT, Mike Spindel): standalone
// ISO 3166-1 country definitions with lookup by alpha-2, alpha-3, numeric
// code, name and apolitical_name.
//
// The 250 records and the jobs come from rows() and jobs_text(), appended by
// gen_kara.py. Each row is "name|alpha2|alpha3|numeric|apolitical|NAME_UP|
// APOLITICAL_UP"; the two *_UP fields are Python's str.upper() of the name and
// apolitical_name (the keys the library's name indexes use), computed in the
// generator so the port never uppercases non-ASCII stored data at run time.

struct Db {
    name: Vec[String],
    a2: Vec[String],
    a3: Vec[String],
    num: Vec[String],
    apol: Vec[String],
    nameup: Vec[String],
    apolup: Vec[String],
}

fn bytes_of(s: String) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() { v.push(b as i64); }
    v
}

fn blen(s: String) -> i64 { bytes_of(s).len() }

fn split_on(s: String, sep: i64) -> Vec[String] {
    let b = bytes_of(s.clone());
    let mut parts: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i < b.len() {
        if b[i] == sep {
            parts.push(s.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    parts.push(s.substring(start, b.len()));
    parts
}

fn byte_to_char(b: i64) -> String {
    let print = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    print.substring(b - 32, b - 32 + 1)
}

fn is_digit_str(s: String) -> bool {
    let b = bytes_of(s);
    if b.len() == 0 { return false; }
    let mut i = 0;
    while i < b.len() {
        if b[i] < 48 or b[i] > 57 { return false; }
        i = i + 1;
    }
    true
}

fn str_to_int(s: String) -> i64 {
    let b = bytes_of(s);
    let mut v = 0;
    let mut i = 0;
    while i < b.len() { v = v * 10 + (b[i] - 48); i = i + 1; }
    v
}

fn int_to_str(n: i64) -> String {
    if n == 0 { return "0"; }
    let mut m = n;
    let mut out = String.new();
    while m > 0 {
        let d = m % 10;
        out = byte_to_char(48 + d) + out;
        m = m / 10;
    }
    out
}

// Python f"{n:03d}" for non-negative n.
fn pad3(n: i64) -> String {
    let mut s = int_to_str(n);
    while blen(s.clone()) < 3 { s = "0" + s; }
    s
}

// ASCII-only upper-casing, matching Python str.upper() for ASCII input (the
// only input that reaches this: lookup keys are always ASCII).
fn ascii_upper(s: String) -> String {
    let b = bytes_of(s);
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let mut c = b[i];
        if c >= 97 and c <= 122 { c = c - 32; }
        out.push_str(byte_to_char(c));
        i = i + 1;
    }
    out
}

fn find(v: ref Vec[String], key: String) -> i64 {
    let mut i = 0;
    while i < v.len() {
        if v[i].clone() == key { return i; }
        i = i + 1;
    }
    0 - 1
}

// countries.get(str) dispatch: 2 chars -> alpha-2; 3 all-digit chars other
// than "000" -> numeric (before alpha-3); 3 chars -> alpha-3; else name, then
// apolitical_name. Returns the record index or -1.
fn lookup(db: ref Db, key: String) -> i64 {
    let ku = ascii_upper(key);
    let n = blen(ku.clone());
    if n == 2 { return find(db.a2, ku); }
    if n == 3 and is_digit_str(ku.clone()) and ku != "000" { return find(db.num, ku); }
    if n == 3 { return find(db.a3, ku); }
    let bi = find(db.nameup, ku.clone());
    if bi >= 0 { return bi; }
    return find(db.apolup, ku);
}

// countries.get(int): zero-pad to three digits, look up as numeric.
fn lookup_int(db: ref Db, n: i64) -> i64 {
    let k = pad3(n);
    return find(db.num, k);
}

fn country_repr(db: ref Db, i: i64) -> String {
    let mut s = String.new();
    s.push_str("Country(name='");
    s.push_str(db.name[i].clone());
    s.push_str("', alpha2='");
    s.push_str(db.a2[i].clone());
    s.push_str("', alpha3='");
    s.push_str(db.a3[i].clone());
    s.push_str("', numeric='");
    s.push_str(db.num[i].clone());
    s.push_str("', apolitical_name='");
    s.push_str(db.apol[i].clone());
    s.push_str("')");
    s
}

fn build_db() -> Db {
    let rs = rows();
    let mut name: Vec[String] = Vec.new();
    let mut a2: Vec[String] = Vec.new();
    let mut a3: Vec[String] = Vec.new();
    let mut num: Vec[String] = Vec.new();
    let mut apol: Vec[String] = Vec.new();
    let mut nameup: Vec[String] = Vec.new();
    let mut apolup: Vec[String] = Vec.new();
    let mut i = 0;
    while i < rs.len() {
        let parts = split_on(rs[i].clone(), 124);
        name.push(parts[0].clone());
        a2.push(parts[1].clone());
        a3.push(parts[2].clone());
        num.push(parts[3].clone());
        apol.push(parts[4].clone());
        nameup.push(parts[5].clone());
        apolup.push(parts[6].clone());
        i = i + 1;
    }
    Db {
        name: name,
        a2: a2,
        a3: a3,
        num: num,
        apol: apol,
        nameup: nameup,
        apolup: apolup,
    }
}

fn run(db: ref Db, op: String, arg: String) -> String {
    if op == "len" { return int_to_str(db.name.len()); }
    if op == "contains" {
        let idx = lookup(db, arg);
        if idx >= 0 { return "True"; }
        return "False";
    }
    if op == "getint" {
        let n = str_to_int(arg);
        let idx = lookup_int(db, n);
        if idx >= 0 { return country_repr(db, idx); }
        return "error: KeyError " + int_to_str(n);
    }
    let idx = lookup(db, arg.clone());
    if idx >= 0 { return country_repr(db, idx); }
    return "error: KeyError '" + arg + "'";
}

fn main() {
    let db = build_db();
    let jt = jobs_text();
    let lines = split_on(jt, 10);
    let mut out = String.new();
    let mut li = 0;
    while li < lines.len() {
        let line = lines[li].clone();
        if blen(line.clone()) > 0 {
            let fields = split_on(line, 9);
            let op = fields[0].clone();
            let mut arg = String.new();
            if fields.len() > 1 { arg = fields[1].clone(); }
            out.push_str("== ");
            out.push_str(op.clone());
            out.push_str(" | ");
            out.push_str(arg.clone());
            out.push_str("\n  ");
            out.push_str(run(db, op, arg));
            out.push_str("\n");
        }
        li = li + 1;
    }
    print(out);
}

