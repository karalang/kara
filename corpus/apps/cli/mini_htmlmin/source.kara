// mini_htmlmin: a port of htmlmin 0.1.12 (BSD-3-Clause; Dave Mankoff), the
// pure-Python HTML minifier. It collapses whitespace between and inside
// tags, drops comments (keeping `<!--! ... -->` ones), removes optional
// attribute quotes and the values of empty and boolean attributes, leaves
// <pre>, <textarea>, <script> and <style> alone, honours the `pre`
// attribute and `pre-` attribute prefixes, and drops the closing tags
// HTML lets a document leave out.
//
// htmlmin's parser is a subclass of its own copy of Python's
// html.parser.HTMLParser (python3html) over _markupbase.ParserBase, so
// both are ported here too. Their regular expressions run on the
// regular-expression engine from mini_re, with the library's own pattern
// text (data/patterns.txt), and the entity table and html.escape /
// html.unescape come from mini_htmlparser.
//
// data/jobs.tsv (see mk.py) is a list of commands: `minify` runs a page
// through htmlmin.minify with a set of options, `snippet` a short document
// written in the job, and `chunks` feeds a page to one Minifier in pieces
// before finalize(). `attr_value`, `ambiguous`, `unescape` and
// `escape_tag` call the escaping helpers, `cli` runs the htmlmin command,
// and `site` minifies the pages a manifest lists into an output tree.
// oracle.py runs the same commands against the real library.

// ============================================================ mini_re

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// ============================================================ html.escape / html.unescape (mini_htmlparser)

fn hp_is_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{c}'
}

fn hp_is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn hp_is_hex(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn is_alnum(c: char) -> bool {
    hp_is_alpha(c) or is_digit(c)
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        match char.try_from(c as i64 + 32) {
            Ok(l) => l,
            Err(_) => c,
        }
    } else {
        c
    }
}

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

// raw[i..] starts with s.
fn at(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or raw[k] != c {
            return false;
        }
        k += 1;
    }
    true
}

// raw[i..] starts with s, ignoring ASCII case.
fn at_nocase(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or ascii_lower(raw[k]) != ascii_lower(c) {
            return false;
        }
        k += 1;
    }
    true
}

fn find_char(raw: ref Vec[char], c: char, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if raw[k] == c {
            return k;
        }
        k += 1;
    }
    -1
}

fn find_str(raw: ref Vec[char], s: ref String, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if at(raw, k, s) {
            return k;
        }
        k += 1;
    }
    -1
}

// ---------------------------------------------------------------- html.escape / html.unescape

fn html_escape(s: ref String, quote: bool) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else if quote and c == '"' {
            out.push_str("&quot;");
        } else if quote and c == '\'' {
            out.push_str("&#x27;");
        } else {
            out.push(c);
        }
    }
    out
}

// The numeric-character-reference-end-state table of html/__init__.py.
fn invalid_charref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn invalid_codepoint(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

fn push_code(out: mut ref String, num: i64) {
    match char.try_from(num) {
        Ok(c) => out.push(c),
        Err(_) => out.push('\u{fffd}'),
    }
}

fn numeric_ref(num: i64, out: mut ref String) {
    match invalid_charref(num) {
        Some(v) => {
            push_code(mut out, v);
            return;
        }
        None => {}
    }
    if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
        out.push('\u{fffd}');
        return;
    }
    if invalid_codepoint(num) {
        return;
    }
    push_code(mut out, num);
}

// The digits raw[lo..hi] in base 10 or 16, held at 0x110000 once past
// the last code point, as int() then the range check would decide.
fn ref_number(raw: ref Vec[char], lo: i64, hi: i64, base: i64) -> i64 {
    let mut n = 0;
    let mut k = lo;
    while k < hi {
        let c = raw[k];
        let d = if is_digit(c) {
            c as i64 - '0' as i64
        } else {
            ascii_lower(c) as i64 - 'a' as i64 + 10
        };
        n = n * base + d;
        if n > 0x10ffff {
            n = 0x110000;
        }
        k += 1;
    }
    n
}

// A named reference's text, the name possibly ending in ';'.
fn named_ref(name: ref Vec[char], ents: ref Map[String, String], out: mut ref String) {
    let whole = text(name, 0, name.len());
    match ents.get(whole.clone()) {
        Some(v) => {
            out.push_str(v);
            return;
        }
        None => {}
    }
    // The longest name the standard allows as a prefix.
    let mut x = name.len() - 1;
    while x > 1 {
        match ents.get(text(name, 0, x)) {
            Some(v) => {
                out.push_str(v);
                out.push_str(text(name, x, name.len()));
                return;
            }
            None => {}
        }
        x -= 1;
    }
    out.push('&');
    out.push_str(whole);
}

fn named_class(c: char) -> bool {
    not (c == '\t' or c == '\n' or c == '\u{c}' or c == ' ' or c == '<' or c == '&' or c == '#' or c == ';')
}

// html.unescape over raw[lo..hi].
fn unescape_chars(raw: ref Vec[char], lo: i64, hi: i64, ents: ref Map[String, String]) -> String {
    let mut out = String.new();
    let mut p = lo;
    while p < hi {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        if p + 1 < hi and raw[p + 1] == '#' {
            if p + 2 < hi and is_digit(raw[p + 2]) {
                let mut q = p + 2;
                while q < hi and is_digit(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 2, q, 10), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else if p + 3 < hi and (raw[p + 2] == 'x' or raw[p + 2] == 'X') and hp_is_hex(raw[p + 3]) {
                let mut q = p + 3;
                while q < hi and hp_is_hex(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 3, q, 16), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else {
                out.push('&');
                p += 1;
            }
            continue;
        }
        let mut q = p + 1;
        while q < hi and q - (p + 1) < 32 and named_class(raw[q]) {
            q += 1;
        }
        if q == p + 1 {
            out.push('&');
            p += 1;
            continue;
        }
        if q < hi and raw[q] == ';' {
            q += 1;
        }
        let name: Vec[char] = raw[p + 1..q].iter().collect();
        named_ref(name, ents, mut out);
        p = q;
    }
    out
}

fn html_unescape(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    unescape_chars(raw, 0, raw.len(), ents)
}


// ------------------------------------------------------------ helpers

struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

fn index_error() -> Exc {
    exc("IndexError", "string index out of range".to_string())
}

fn hex_digit(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        0
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        out.push((hex_digit(cs[k]) * 16 + hex_digit(cs[k + 1])) as u8);
        k += 2;
    }
    out
}

fn hex_string(s: ref String) -> String {
    String.from_utf8(hex_bytes(s)).unwrap_or(String.new())
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn join_strs(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs.iter() {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn dirname_of(path: ref String) -> String {
    let cs: Vec[char] = path.chars().collect();
    let mut cut = -1;
    let mut k = 0;
    while k < cs.len() {
        if cs[k] == '/' {
            cut = k;
        }
        k += 1;
    }
    let mut out = String.new();
    k = 0;
    while k < cut {
        out.push(cs[k]);
        k += 1;
    }
    out
}

fn char_count(s: ref String) -> i64 {
    let mut n = 0;
    for _ in s.chars() {
        n += 1;
    }
    n
}

fn repr(s: ref String) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(cps(s), mut out);
    to_string(out)
}

fn cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn sub_text(s: ref Vec[i64], lo: i64, hi: i64) -> String {
    to_string(slice(s, lo, hi))
}

fn starts_at(s: ref Vec[i64], i: i64, lit: Str) -> bool {
    let mut k = i;
    for c in lit.chars() {
        if k >= s.len() or s[k] != c as i64 {
            return false;
        }
        k += 1;
    }
    true
}

fn find_cp(s: ref Vec[i64], c: char, from: i64) -> i64 {
    let mut k = from;
    while k < s.len() {
        if s[k] == c as i64 {
            return k;
        }
        k += 1;
    }
    -1
}

// str.isspace: the Unicode white space Python's strip() removes.
fn py_space(c: i64) -> bool {
    (c >= 9 and c <= 13) or (c >= 0x1c and c <= 0x20) or c == 0x85 or c == 0xa0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200a) or c == 0x2028 or c == 0x2029 or c == 0x202f or c == 0x205f or c == 0x3000
}

fn py_strip(s: ref Vec[i64]) -> Vec[i64] {
    let mut lo = 0;
    let mut hi = s.len();
    while lo < hi and py_space(s[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(s[hi - 1]) {
        hi -= 1;
    }
    slice(s, lo, hi)
}

fn last_char(s: ref String) -> Result[char, Exc] {
    let mut last: Option[char] = None;
    for c in s.chars() {
        last = Some(c);
    }
    match last {
        Some(c) => Ok(c),
        None => Err(index_error()),
    }
}

fn first_char(s: ref String) -> Option[char] {
    for c in s.chars() {
        return Some(c);
    }
    None
}

fn drop_first(s: ref String) -> String {
    let mut out = String.new();
    let mut first = true;
    for c in s.chars() {
        if not first {
            out.push(c);
        }
        first = false;
    }
    out
}

fn opt_eq(a: ref Option[String], b: ref Option[String]) -> bool {
    match (a, b) {
        (None, None) => true,
        (Some(x), Some(y)) => x == y,
        _ => false,
    }
}

fn contains_str(xs: ref Vec[String], s: ref String) -> bool {
    for x in xs.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ the patterns

// data/patterns.txt in the order mk.py writes it.
const P_INTERESTING: i64 = 0;
const P_INCOMPLETE: i64 = 1;
const P_ENTITYREF: i64 = 2;
const P_CHARREF: i64 = 3;
const P_STARTTAGOPEN: i64 = 4;
const P_PICLOSE: i64 = 5;
const P_TAGFIND: i64 = 6;
const P_ATTRFIND: i64 = 7;
const P_LOCATESTARTTAGEND: i64 = 8;
const P_ENDENDTAG: i64 = 9;
const P_ENDTAGFIND: i64 = 10;
const P_REF_END: i64 = 11;
const P_CDATA_END: i64 = 12;
const P_DECLNAME: i64 = 13;
const P_COMMENTCLOSE: i64 = 14;
const P_MARKEDSECTIONCLOSE: i64 = 15;
const P_MSMARKEDSECTIONCLOSE: i64 = 16;
const P_KEEP_COMMENT: i64 = 17;
const P_CHARS_TO_QUOTE: i64 = 18;

const PATTERN_NAMES: Str = "interesting_normal incomplete entityref charref starttagopen piclose tagfind_tolerant attrfind_tolerant locatestarttagend_tolerant endendtag endtagfind ref_end cdata_end declname commentclose markedsectionclose msmarkedsectionclose keep_comment chars_to_quote";

struct World {
    pats: Vec[Program],
    // set_cdata_mode's pattern for <script> and for <style>
    cdata_script: Program,
    cdata_style: Program,
    ents: Map[String, String],
}

fn load_world() -> Result[World, String] {
    let text = match fs.read_to_string("data/patterns.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read patterns.txt: {e}"),
    };
    let names = split_on(PATTERN_NAMES.to_string(), ' ');
    let mut pats: Vec[Program] = Vec.new();
    let mut cdata_text = String.new();
    let mut cdata_flags = 0;
    for line in split_on(text, '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let k = pats.len();
        if k >= names.len() or f[0] != names[k] {
            return Err(f"patterns.txt: expected {names[k]}, found {f[0]}");
        }
        let flags = dec_int(f[1]);
        let pattern = hex_string(f[2]);
        if k == P_CDATA_END {
            cdata_text = pattern.clone();
            cdata_flags = flags;
        }
        match compile(cps(pattern), flags) {
            Ok(p) => pats.push(p),
            Err(e) => return Err(f"cannot compile {f[0]}: {err_text(e)}"),
        }
    }
    let script = match compile(cps(cdata_text.replace("ELEM", "script")), cdata_flags) {
        Ok(p) => p,
        Err(e) => return Err(f"cannot compile the script end: {err_text(e)}"),
    };
    let style = match compile(cps(cdata_text.replace("ELEM", "style")), cdata_flags) {
        Ok(p) => p,
        Err(e) => return Err(f"cannot compile the style end: {err_text(e)}"),
    };
    Ok(World { pats: pats, cdata_script: script, cdata_style: style, ents: html5_entities() })
}

// A matcher made ready for another pattern, over the same subject.
fn retarget(m: mut ref Matcher, prog: ref Program) {
    m.marks.clear();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        m.marks.push(-1);
        k += 1;
    }
    m.counts.clear();
    m.lasts.clear();
    k = 0;
    while k < prog.repeats {
        m.counts.push(-1);
        m.lasts.push(-1);
        k += 1;
    }
}

// pattern.match(subject, pos) (mode 1) or pattern.search(subject, pos)
// (mode 0) on the matcher's subject.
fn rx(m: mut ref Matcher, prog: ref Program, pos: i64, mode: i64) -> Option[Found] {
    retarget(mut m, prog);
    find(mut m, prog, pos, false, mode)
}

fn rx_str(prog: ref Program, s: ref String, mode: i64) -> Option[Found] {
    let subject = cps(s);
    let mut m = new_matcher(prog, subject);
    find(mut m, prog, 0, false, mode)
}

fn group_text(s: ref Vec[i64], f: ref Found, g: i64) -> Option[String] {
    let (a, b) = f.spans[g - 1];
    if a < 0 {
        return None;
    }
    Some(sub_text(s, a, b))
}

// ------------------------------------------------------------ htmlmin.escape

const NO_QUOTES: i64 = 0;
const SINGLE_QUOTE: i64 = 1;
const DOUBLE_QUOTE: i64 = 2;

fn is_ascii_alnum(c: char) -> bool {
    (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9')
}

fn is_ascii_hex(c: char) -> bool {
    (c >= 'A' and c <= 'F') or (c >= 'a' and c <= 'f') or (c >= '0' and c <= '9')
}

fn escape_ambiguous_ampersand(val: ref String) -> String {
    if not val.contains("&") {
        return val.clone();
    }
    let mut state = 0;
    let mut result = String.new();
    let mut amp_buff = String.new();
    for c in val.chars() {
        if state == 0 {
            if c == '&' {
                state = 1;
            } else {
                result.push(c);
            }
        } else if state == 1 {
            if is_ascii_alnum(c) {
                amp_buff.push(c);
            } else if c == '#' {
                state = 2;
            } else if c == ';' {
                if amp_buff.len() > 0 {
                    result.push('&');
                    result.push_str(amp_buff);
                    result.push(';');
                } else {
                    result.push_str("&;");
                }
                state = 0;
                amp_buff = String.new();
            } else if c == '&' {
                if amp_buff.len() > 0 {
                    result.push_str("&amp;");
                    result.push_str(amp_buff);
                } else {
                    result.push('&');
                }
                amp_buff = String.new();
            } else {
                result.push('&');
                result.push_str(amp_buff);
                result.push(c);
                state = 0;
                amp_buff = String.new();
            }
        } else if state == 2 {
            if c == 'x' or c == 'X' {
                state = 3;
            } else if c >= '0' and c <= '9' {
                amp_buff.push(c);
            } else if c == ';' {
                if amp_buff.len() > 0 {
                    result.push_str("&#");
                    result.push_str(amp_buff);
                    result.push(';');
                } else {
                    result.push_str("&#;");
                }
                state = 0;
                amp_buff = String.new();
            } else if c == '&' {
                if amp_buff.len() > 0 {
                    result.push_str("&amp;#");
                    result.push_str(amp_buff);
                } else {
                    result.push_str("&#");
                }
                state = 1;
                amp_buff = String.new();
            } else {
                if amp_buff.len() > 0 {
                    result.push_str("&amp;#");
                    result.push_str(amp_buff);
                    result.push(c);
                } else {
                    result.push_str("&#");
                    result.push(c);
                }
                state = 0;
                amp_buff = String.new();
            }
        } else {
            if is_ascii_hex(c) {
                amp_buff.push(c);
            } else if c == ';' {
                if amp_buff.len() > 0 {
                    result.push_str("&#x");
                    result.push_str(amp_buff);
                    result.push(';');
                } else {
                    result.push_str("&#x;");
                }
                state = 0;
                amp_buff = String.new();
            } else if c == '&' {
                if amp_buff.len() > 0 {
                    result.push_str("&amp;#x");
                    result.push_str(amp_buff);
                } else {
                    result.push_str("&#x");
                }
                state = 1;
                amp_buff = String.new();
            } else {
                if amp_buff.len() > 0 {
                    result.push_str("&amp;#x");
                    result.push_str(amp_buff);
                    result.push(c);
                } else {
                    result.push_str("&#x");
                    result.push(c);
                }
                state = 0;
                amp_buff = String.new();
            }
        }
    }
    if state == 1 {
        result.push_str("&amp;");
        result.push_str(amp_buff);
    } else if state == 2 {
        result.push_str("&amp;#");
        result.push_str(amp_buff);
    } else if state == 3 {
        result.push_str("&amp;#x");
        result.push_str(amp_buff);
    }
    result
}

fn escape_attr_value(w: ref World, val0: ref String, double_quote: bool) -> (String, i64) {
    let val = escape_ambiguous_ampersand(val0);
    if double_quote {
        return (val.replace("\"", "&#34;"), DOUBLE_QUOTE);
    }
    let mut double_quote_count = 0;
    let mut single_quote_count = 0;
    for ch in val.chars() {
        if ch == '"' {
            double_quote_count += 1;
        } else if ch == '\'' {
            single_quote_count += 1;
        }
    }
    if double_quote_count > single_quote_count {
        return (val.replace("'", "&#39;"), SINGLE_QUOTE);
    } else if single_quote_count > 0 {
        return (val.replace("\"", "&#34;"), DOUBLE_QUOTE);
    }
    if val.len() == 0 or rx_str(w.pats[P_CHARS_TO_QUOTE], val, 0).is_some() {
        return (val, DOUBLE_QUOTE);
    }
    (val, NO_QUOTES)
}

// ------------------------------------------------------------ htmlmin.parser tables

fn no_close_tag(tag: ref String) -> bool {
    let tags = ["area", "base", "br", "col", "command", "embed", "hr", "img", "input", "keygen", "link", "meta", "param", "source", "track", "wbr"];
    for t in tags {
        if tag == t {
            return true;
        }
    }
    false
}

fn strs(xs: ref Vec[Str]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for x in xs.iter() {
        out.push(x.to_string());
    }
    out
}

// BOOLEAN_ATTRIBUTES.get(tag, BOOLEAN_ATTRIBUTES['*'])
fn boolean_attributes(tag: ref String) -> Vec[String] {
    let t = tag.as_str();
    let names: Vec[Str] = if t == "audio" {
        vec!["autoplay", "controls", "hidden", "loop", "muted"]
    } else if t == "button" {
        vec!["autofocus", "disabled", "formnovalidate", "hidden"]
    } else if t == "command" {
        vec!["checked", "disabled", "hidden"]
    } else if t == "dialog" {
        vec!["hidden", "open"]
    } else if t == "fieldset" {
        vec!["disabled", "hidden"]
    } else if t == "form" {
        vec!["hidden", "novalidate"]
    } else if t == "iframe" {
        vec!["hidden", "seamless"]
    } else if t == "img" {
        vec!["hidden", "ismap"]
    } else if t == "input" {
        vec!["autofocus", "checked", "disabled", "formnovalidate", "hidden", "multiple", "readonly", "required"]
    } else if t == "keygen" {
        vec!["autofocus", "disabled", "hidden"]
    } else if t == "object" {
        vec!["hidden", "typesmustmatch"]
    } else if t == "ol" {
        vec!["hidden", "reversed"]
    } else if t == "optgroup" {
        vec!["disabled", "hidden"]
    } else if t == "option" {
        vec!["disabled", "hidden", "selected"]
    } else if t == "script" {
        vec!["async", "defer", "hidden"]
    } else if t == "select" {
        vec!["autofocus", "disabled", "hidden", "multiple", "required"]
    } else if t == "style" {
        vec!["hidden", "scoped"]
    } else if t == "textarea" {
        vec!["autofocus", "disabled", "hidden", "readonly", "required"]
    } else if t == "track" {
        vec!["default", "hidden"]
    } else if t == "video" {
        vec!["autoplay", "controls", "hidden", "loop", "muted"]
    } else {
        vec!["hidden"]
    };
    strs(names)
}

// TAG_SETS.get(tag): the tags that close it, or ["*"] for any tag.
fn tag_sets(tag: ref String) -> Option[Vec[String]] {
    let t = tag.as_str();
    let names: Vec[Str] = if t == "li" {
        vec!["li"]
    } else if t == "dd" or t == "dt" {
        vec!["dd", "dt"]
    } else if t == "rp" or t == "rt" {
        vec!["rp", "rt"]
    } else if t == "p" {
        vec!["address", "article", "aside", "blockquote", "dir", "div", "dl", "fieldset", "footer", "form", "h1", "h2", "h3", "h4", "h5", "h6", "header", "hgroup", "hr", "menu", "nav", "ol", "p", "pre", "section", "table", "ul"]
    } else if t == "optgroup" {
        vec!["optgroup"]
    } else if t == "option" {
        vec!["option", "optgroup"]
    } else if t == "colgroup" {
        vec!["*"]
    } else if t == "tbody" or t == "thead" {
        vec!["tbody", "tfoot"]
    } else if t == "tfoot" {
        vec!["tbody"]
    } else if t == "tr" {
        vec!["tr"]
    } else if t == "td" or t == "th" {
        vec!["td", "th"]
    } else {
        return None;
    };
    Some(strs(names))
}

// The five white-space patterns of htmlmin.parser, over
// [\x20\x09\x0a\x0c\x0d]: plain character classes, so written as scans.
fn html_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\u{c}' or c == '\r'
}

// HTML_ALL_SPACE_RE.match(s)
fn all_space(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not html_space(c) {
            return false;
        }
    }
    true
}

// HTML_SPACE_RE.sub(' ', s)
fn collapse_space(s: ref String) -> String {
    let mut out = String.new();
    let mut in_run = false;
    for c in s.chars() {
        if html_space(c) {
            if not in_run {
                out.push(' ');
            }
            in_run = true;
        } else {
            out.push(c);
            in_run = false;
        }
    }
    out
}

// HTML_LEADING_TRAILING_SPACE_RE.sub(repl, s)
fn sub_lead_trail(s: ref String, repl: Str) -> String {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len();
    let mut lead = 0;
    while lead < n and html_space(cs[lead]) {
        lead += 1;
    }
    if n > 0 and lead == n {
        return repl.to_string();
    }
    let mut trail = n;
    while trail > lead and html_space(cs[trail - 1]) {
        trail -= 1;
    }
    let mut out = String.new();
    if lead > 0 {
        out.push_str(repl);
    }
    let mut k = lead;
    while k < trail {
        out.push(cs[k]);
        k += 1;
    }
    if trail < n {
        out.push_str(repl);
    }
    out
}

// HTML_TRAILING_SPACE_RE.sub('', s)
fn strip_trailing(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut hi = cs.len();
    while hi > 0 and html_space(cs[hi - 1]) {
        hi -= 1;
    }
    let mut out = String.new();
    let mut k = 0;
    while k < hi {
        out.push(cs[k]);
        k += 1;
    }
    out
}

// ------------------------------------------------------------ the parser

struct Opts {
    remove_comments: bool,
    remove_empty_space: bool,
    remove_all_empty_space: bool,
    reduce_empty_attributes: bool,
    reduce_boolean_attributes: bool,
    remove_optional_attribute_quotes: bool,
    convert_charrefs: bool,
    keep_pre: bool,
    pre_tags: Vec[String],
    pre_attr: String,
}

fn default_opts() -> Opts {
    Opts {
        remove_comments: false,
        remove_empty_space: false,
        remove_all_empty_space: false,
        reduce_empty_attributes: true,
        reduce_boolean_attributes: false,
        remove_optional_attribute_quotes: true,
        convert_charrefs: true,
        keep_pre: false,
        pre_tags: vec!["pre".to_string(), "textarea".to_string()],
        pre_attr: "pre".to_string(),
    }
}

impl Clone for Opts {
    fn clone(ref self) -> Opts {
        Opts {
            remove_comments: self.remove_comments,
            remove_empty_space: self.remove_empty_space,
            remove_all_empty_space: self.remove_all_empty_space,
            reduce_empty_attributes: self.reduce_empty_attributes,
            reduce_boolean_attributes: self.reduce_boolean_attributes,
            remove_optional_attribute_quotes: self.remove_optional_attribute_quotes,
            convert_charrefs: self.convert_charrefs,
            keep_pre: self.keep_pre,
            pre_tags: self.pre_tags.clone(),
            pre_attr: self.pre_attr.clone(),
        }
    }
}

struct OpenTag {
    tag: String,
    pre: bool,
    lang: Option[String],
}

// HTMLMinParser over python3html.HTMLParser over _markupbase.ParserBase.
// getpos()'s line and column are not kept: nothing in htmlmin reads them.
struct MinParser {
    opts: Opts,
    rawdata: Vec[i64],
    // "script" or "style" while inside one, else ""
    cdata_elem: String,
    data_buffer: Vec[String],
    in_pre_tag: i64,
    in_head: bool,
    in_title: bool,
    after_doctype: bool,
    // the innermost tag first, as htmlmin inserts at 0
    tag_stack: Vec[OpenTag],
    title_newly_opened: bool,
    title_trailing_whitespace: bool,
}

fn new_parser(opts: own Opts) -> MinParser {
    MinParser {
        opts: opts,
        rawdata: Vec.new(),
        cdata_elem: String.new(),
        data_buffer: Vec.new(),
        in_pre_tag: 0,
        in_head: false,
        in_title: false,
        after_doctype: false,
        tag_stack: Vec.new(),
        title_newly_opened: false,
        title_trailing_whitespace: false,
    }
}

fn reset(p: mut ref MinParser) {
    p.data_buffer.clear();
    p.in_pre_tag = 0;
    p.in_head = false;
    p.in_title = false;
    p.after_doctype = false;
    p.tag_stack.clear();
    p.title_newly_opened = false;
    p.title_trailing_whitespace = false;
    p.rawdata.clear();
    p.cdata_elem = String.new();
}

fn result(p: ref MinParser) -> String {
    join_strs(p.data_buffer, "")
}

fn tag_lang(p: ref MinParser) -> Option[String] {
    if p.tag_stack.len() > 0 {
        p.tag_stack[0].lang.clone()
    } else {
        None
    }
}

fn push(p: mut ref MinParser, s: own String) {
    p.data_buffer.push(s);
}

// build_tag: (has_pre, the tag's text, its lang)
fn build_tag(p: ref MinParser, w: ref World, tag: ref String, attrs: ref Vec[(String, Option[String])], close_tag: bool) -> Result[(bool, String, Option[String]), Exc] {
    let mut has_pre = false;
    let bool_attrs: Vec[String] = if p.opts.reduce_boolean_attributes { boolean_attributes(tag) } else { Vec.new() };
    let mut lang = tag_lang(p);
    let mut out: Vec[String] = Vec.new();
    let mut last_quoted = -1;
    let mut last_no_slash = -1;
    let prefix = f"{p.opts.pre_attr}-";
    for (k0, v0) in attrs.iter() {
        let mut k = k0.clone();
        let mut v = v0.clone();
        let pre_prefix = k.starts_with(prefix.as_str());
        if pre_prefix {
            k = drop_n(k, char_count(p.opts.pre_attr) + 1);
        }
        if k == p.opts.pre_attr {
            has_pre = true;
            if not p.opts.keep_pre and not pre_prefix {
                continue;
            }
        }
        let nonempty = match v {
            Some(ref t) => t.len() > 0,
            None => false,
        };
        if nonempty and p.opts.convert_charrefs and not pre_prefix {
            v = Some(html_unescape(v.clone().unwrap_or(String.new()), w.ents));
        }
        if k == "lang" {
            lang = v.clone();
            if opt_eq(v, tag_lang(p)) {
                continue;
            }
        }
        if not pre_prefix {
            k = html_escape(k, true);
        }
        let value = match v {
            Some(t) => t.clone(),
            None => {
                out.push(k);
                last_quoted = out.len() - 1;
                continue;
            }
        };
        if (value.len() == 0 and p.opts.reduce_empty_attributes) or (bool_attrs.len() > 0 and contains_str(bool_attrs, k)) {
            // boolean attributes count as quoted: they need no space before "/>"
            out.push(k);
            last_quoted = out.len() - 1;
            continue;
        }
        let mut val = value.clone();
        let mut q = DOUBLE_QUOTE;
        if pre_prefix {
            let has_double_quotes = value.contains("\"");
            let has_single_quotes = value.contains("'");
            if not has_double_quotes {
                if not has_single_quotes and p.opts.remove_optional_attribute_quotes {
                    q = NO_QUOTES;
                } else {
                    q = DOUBLE_QUOTE;
                }
            } else if not has_single_quotes {
                // escape.SINGLE_QUOTES: the library's own typo for SINGLE_QUOTE
                return Err(exc("AttributeError", "module 'htmlmin.escape' has no attribute 'SINGLE_QUOTES'".to_string()));
            } else {
                println("  log ERROR Unsafe content found in pre-attribute. Escaping.");
                let (v2, q2) = escape_attr_value(w, value, not p.opts.remove_optional_attribute_quotes);
                val = v2;
                q = q2;
            }
        } else {
            let (v2, q2) = escape_attr_value(w, value, not p.opts.remove_optional_attribute_quotes);
            val = v2;
            q = q2;
        }
        if q == NO_QUOTES {
            let ends_slash = last_char(val)? == '/';
            out.push(f"{k}={val}");
            if not ends_slash {
                last_no_slash = out.len() - 1;
            }
        } else {
            let qc = if q == DOUBLE_QUOTE { "\"" } else { "'" };
            out.push(f"{k}={qc}{val}{qc}");
            last_quoted = out.len() - 1;
        }
    }
    let mut space_maybe = "";
    if out.len() > 0 {
        let last = last_char(out[out.len() - 1])?;
        if needs_space(last, close_tag) {
            // if moving the attributes round helps, do it; else add the space
            let i = if last_quoted == -1 { last_no_slash } else { last_quoted };
            let move_it = if i == -1 { false } else { not needs_space(last_char(out[i])?, close_tag) };
            if not move_it {
                space_maybe = " ";
            } else {
                let moved = out.remove(i);
                out.push(moved);
            }
        }
    }
    let gap = if out.len() > 0 { " " } else { "" };
    let slash = if close_tag { "/" } else { "" };
    Ok((has_pre, f"<{html_escape(tag, true)}{gap}{join_strs(out, " ")}{space_maybe}{slash}>", lang))
}

fn needs_space(c: char, close_tag: bool) -> bool {
    c != '"' and c != '\'' and (close_tag or c == '/')
}

fn drop_n(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k = 0;
    for c in s.chars() {
        if k >= n {
            out.push(c);
        }
        k += 1;
    }
    out
}

fn handle_decl(p: mut ref MinParser, decl: ref String) {
    if p.data_buffer.len() == 1 {
        let first = first_char(p.data_buffer[0]);
        let space = match first {
            Some(c) => html_space(c),
            None => false,
        };
        if space {
            p.data_buffer.clear();
        }
    }
    push(mut p, f"<!{decl}>");
    p.after_doctype = true;
}

// _close_tags_up_to: Err(()) is OpenTagNotFoundError.
fn close_tags_up_to(p: mut ref MinParser, tag: ref String) -> Result[i64, ()] {
    let mut num_pres = 0;
    let mut i = 0;
    let mut k = 0;
    while k < p.tag_stack.len() {
        i = k;
        let t = p.tag_stack[k].tag.clone();
        if p.tag_stack[k].pre {
            num_pres += 1;
        }
        if t == *tag {
            break;
        }
        // only the html tag can close everything out
        if *tag != "html" and (t == "body" or t == "html" or t == "head") {
            return Err(());
        }
        k += 1;
    }
    let mut rest: Vec[OpenTag] = Vec.new();
    let mut j = i + 1;
    while j < p.tag_stack.len() {
        rest.push(OpenTag { tag: p.tag_stack[j].tag.clone(), pre: p.tag_stack[j].pre, lang: p.tag_stack[j].lang.clone() });
        j += 1;
    }
    p.tag_stack = rest;
    Ok(num_pres)
}

fn open_tag_not_found() -> Exc {
    exc("OpenTagNotFoundError", String.new())
}

fn handle_starttag(p: mut ref MinParser, w: ref World, tag: ref String, attrs: ref Vec[(String, Option[String])]) -> Result[(), Exc] {
    p.after_doctype = false;
    if tag == "head" {
        p.in_head = true;
    } else if p.in_head and tag == "title" {
        p.in_title = true;
        p.title_newly_opened = true;
    }
    let mut k = 0;
    while k < p.tag_stack.len() {
        let t = p.tag_stack[k].tag.clone();
        match tag_sets(t) {
            Some(closed_by) => {
                if (closed_by.len() == 1 and closed_by[0] == "*") or contains_str(closed_by, tag) {
                    match close_tags_up_to(mut p, t) {
                        Ok(n) => p.in_pre_tag -= n,
                        Err(_) => return Err(open_tag_not_found()),
                    }
                    break;
                }
            }
            None => {}
        }
        k += 1;
    }
    let (has_pre, data, lang) = build_tag(p, w, tag, attrs, false)?;
    let mut start_pre = false;
    if has_pre or p.in_pre_tag > 0 or tag == "script" or tag == "style" or contains_str(p.opts.pre_tags, tag) {
        p.in_pre_tag += 1;
        start_pre = true;
    }
    p.tag_stack.insert(0, OpenTag { tag: tag.clone(), pre: start_pre, lang: lang });
    push(mut p, data);
    Ok(())
}

fn handle_endtag(p: mut ref MinParser, tag: ref String) {
    // a </a> does not close a <p> opened inside the link
    if tag == "a" {
        let mut contains_p = false;
        let mut i = 0;
        let mut k = 0;
        while k < p.tag_stack.len() {
            i = k;
            if p.tag_stack[k].tag == "p" {
                contains_p = true;
            } else if p.tag_stack[k].tag == "a" {
                break;
            }
            k += 1;
        }
        if contains_p {
            let a_tag = p.tag_stack.remove(i);
            if a_tag.pre {
                p.in_pre_tag -= 1;
            }
        }
    } else {
        if tag == "head" {
            p.in_head = false;
        } else if tag == "title" {
            p.in_title = false;
            p.title_newly_opened = false;
        }
        // an end tag with no open tag stays: it changes how browsers render
        match close_tags_up_to(mut p, tag) {
            Ok(n) => p.in_pre_tag -= n,
            Err(_) => {}
        }
    }
    if not no_close_tag(tag) {
        push(mut p, "</".to_string());
        push(mut p, html_escape(tag, true));
        push(mut p, ">".to_string());
    }
}

fn handle_startendtag(p: mut ref MinParser, w: ref World, tag: ref String, attrs: ref Vec[(String, Option[String])]) -> Result[(), Exc] {
    p.after_doctype = false;
    let (_, data, _) = build_tag(p, w, tag, attrs, not no_close_tag(tag))?;
    push(mut p, data);
    Ok(())
}

fn handle_comment(p: mut ref MinParser, w: ref World, data: ref String) {
    if not p.opts.remove_comments or rx_str(w.pats[P_KEEP_COMMENT], data, 1).is_some() {
        let body = if first_char(data) == Some('!') { drop_first(data) } else { data.clone() };
        push(mut p, f"<!--{body}-->");
    }
}

fn handle_data(p: mut ref MinParser, data0: ref String) -> Result[(), Exc] {
    if p.in_pre_tag > 0 {
        push(mut p, data0.clone());
        return Ok(());
    }
    // remove_all_empty_space matches all of it, remove_empty_space only
    // space with a line break in it
    if p.opts.remove_all_empty_space or p.in_head or p.after_doctype {
        if all_space(data0) {
            return Ok(());
        }
    } else if p.opts.remove_empty_space and all_space(data0) and (data0.contains("\n") or data0.contains("\r")) {
        return Ok(());
    }
    let mut data = data0.clone();
    // in the title, leading and trailing space goes; the title can come in
    // pieces around references
    if p.in_title {
        if p.title_trailing_whitespace {
            push(mut p, " ".to_string());
        }
        p.title_trailing_whitespace = html_space(last_char(data)?);
        if p.title_newly_opened {
            p.title_newly_opened = false;
            data = sub_lead_trail(data, "");
        } else {
            data = strip_trailing(sub_lead_trail(data, " "));
        }
    }
    data = collapse_space(data);
    if data.len() == 0 {
        return Ok(());
    }
    if p.in_pre_tag == 0 and p.data_buffer.len() > 0 {
        // a removed comment between two runs of text would leave two spaces
        let prev = last_char(p.data_buffer[p.data_buffer.len() - 1])?;
        if first_char(data) == Some(' ') and prev == ' ' {
            data = drop_first(data);
            if data.len() == 0 {
                return Ok(());
            }
        }
    }
    push(mut p, data);
    Ok(())
}

fn handle_ref(p: mut ref MinParser, text: own String) {
    if p.in_title {
        if not p.title_newly_opened and p.title_trailing_whitespace {
            push(mut p, " ".to_string());
            p.title_trailing_whitespace = false;
        }
        p.title_newly_opened = false;
    }
    push(mut p, text);
}

// ------------------------------------------------------------ python3html.HTMLParser

fn feed(p: mut ref MinParser, w: ref World, data: ref String) -> Result[(), Exc] {
    for c in data.chars() {
        p.rawdata.push(c as i64);
    }
    goahead(mut p, w, false)
}

fn close(p: mut ref MinParser, w: ref World) -> Result[(), Exc] {
    goahead(mut p, w, true)
}

fn assertion(msg: own String) -> Exc {
    exc("AssertionError", msg)
}

// rawdata.rfind(c, lo)
fn rfind_cp(s: ref Vec[i64], c: char, lo: i64) -> i64 {
    let mut k = s.len() - 1;
    while k >= lo {
        if s[k] == c as i64 {
            return k;
        }
        k -= 1;
    }
    -1
}

fn cdata_prog(w: ref World, elem: ref String) -> ref Program {
    if elem == "script" { ref w.cdata_script } else { ref w.cdata_style }
}

fn goahead(p: mut ref MinParser, w: ref World, end: bool) -> Result[(), Exc] {
    let rawdata = p.rawdata.clone();
    let mut m = new_matcher(w.pats[P_INTERESTING], rawdata);
    let mut i = 0;
    let n = rawdata.len();
    while i < n {
        let convert = p.opts.convert_charrefs and p.cdata_elem.len() == 0;
        let mut j = 0;
        if convert {
            j = find_cp(rawdata, '<', i);
            if j < 0 {
                // no '<' yet: the text may end in a reference cut in half,
                // so look for an '&' near the end not followed by a space or ';'
                let lo = if i > n - 34 { i } else { n - 34 };
                let amppos = rfind_cp(rawdata, '&', lo);
                if amppos >= 0 and rx(mut m, w.pats[P_REF_END], amppos, 0).is_none() {
                    break;
                }
                j = n;
            }
        } else {
            let found = if p.cdata_elem.len() == 0 {
                rx(mut m, w.pats[P_INTERESTING], i, 0)
            } else {
                rx(mut m, cdata_prog(w, p.cdata_elem), i, 0)
            };
            match found {
                Some(f) => j = f.start,
                None => {
                    if p.cdata_elem.len() > 0 {
                        break;
                    }
                    j = n;
                }
            }
        }
        if i < j {
            // with convert_charrefs, HTMLMinParser.unescape leaves the text as it is
            handle_data(mut p, sub_text(rawdata, i, j))?;
        }
        i = j;
        if i == n {
            break;
        }
        if starts_at(rawdata, i, "<") {
            let mut k = 0;
            if rx(mut m, w.pats[P_STARTTAGOPEN], i, 1).is_some() {
                k = parse_starttag(mut p, w, mut m, rawdata, i)?;
            } else if starts_at(rawdata, i, "</") {
                k = parse_endtag(mut p, w, mut m, rawdata, i)?;
            } else if starts_at(rawdata, i, "<!--") {
                k = parse_comment(mut p, w, mut m, rawdata, i)?;
            } else if starts_at(rawdata, i, "<?") {
                k = parse_pi(mut p, w, mut m, rawdata, i);
            } else if starts_at(rawdata, i, "<!") {
                k = parse_html_declaration(mut p, w, mut m, rawdata, i)?;
            } else if i + 1 < n {
                handle_data(mut p, "<".to_string())?;
                k = i + 1;
            } else {
                break;
            }
            if k < 0 {
                if not end {
                    break;
                }
                k = find_cp(rawdata, '>', i + 1);
                if k < 0 {
                    k = find_cp(rawdata, '<', i + 1);
                    if k < 0 {
                        k = i + 1;
                    }
                } else {
                    k += 1;
                }
                handle_data(mut p, sub_text(rawdata, i, k))?;
            }
            i = k;
        } else if starts_at(rawdata, i, "&#") {
            match rx(mut m, w.pats[P_CHARREF], i, 1) {
                Some(f) => {
                    handle_ref(mut p, f"&#{sub_text(rawdata, f.start + 2, f.end - 1)};");
                    let mut k = f.end;
                    if rawdata[k - 1] != ';' as i64 {
                        k -= 1;
                    }
                    i = k;
                    continue;
                }
                None => {
                    if find_cp(rawdata, ';', i) >= 0 {
                        // bail by consuming "&#"
                        handle_data(mut p, sub_text(rawdata, i, i + 2))?;
                        i = i + 2;
                    }
                    break;
                }
            }
        } else if starts_at(rawdata, i, "&") {
            match rx(mut m, w.pats[P_ENTITYREF], i, 1) {
                Some(f) => {
                    let name = group_text(rawdata, f, 1).unwrap_or(String.new());
                    handle_ref(mut p, f"&{name};");
                    let mut k = f.end;
                    if rawdata[k - 1] != ';' as i64 {
                        k -= 1;
                    }
                    i = k;
                    continue;
                }
                None => {}
            }
            match rx(mut m, w.pats[P_INCOMPLETE], i, 1) {
                Some(f) => {
                    if end and f.end == n {
                        i = i + 1;
                    }
                    // incomplete
                    break;
                }
                None => {
                    if i + 1 < n {
                        // not the end of the buffer, and not some other construct
                        handle_data(mut p, "&".to_string())?;
                        i = i + 1;
                    } else {
                        break;
                    }
                }
            }
        } else {
            return Err(assertion("interesting.search() lied".to_string()));
        }
    }
    if end and i < n and p.cdata_elem.len() == 0 {
        handle_data(mut p, sub_text(rawdata, i, n))?;
        i = n;
    }
    p.rawdata = slice(rawdata, i, n);
    Ok(())
}

fn parse_html_declaration(p: mut ref MinParser, w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64) -> Result[i64, Exc] {
    if starts_at(rawdata, i, "<!--") {
        return parse_comment(mut p, w, mut m, rawdata, i);
    } else if starts_at(rawdata, i, "<![") {
        return parse_marked_section(mut p, w, mut m, rawdata, i);
    }
    let head = sub_text(rawdata, i, if i + 9 < rawdata.len() { i + 9 } else { rawdata.len() });
    if head.to_lowercase() == "<!doctype" {
        let gtpos = find_cp(rawdata, '>', i + 9);
        if gtpos == -1 {
            return Ok(-1);
        }
        handle_decl(mut p, sub_text(rawdata, i + 2, gtpos));
        return Ok(gtpos + 1);
    }
    Ok(parse_bogus_comment(mut p, w, rawdata, i))
}

fn parse_bogus_comment(p: mut ref MinParser, w: ref World, rawdata: ref Vec[i64], i: i64) -> i64 {
    let pos = find_cp(rawdata, '>', i + 2);
    if pos == -1 {
        return -1;
    }
    handle_comment(mut p, w, sub_text(rawdata, i + 2, pos));
    pos + 1
}

fn parse_pi(p: mut ref MinParser, w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64) -> i64 {
    match rx(mut m, w.pats[P_PICLOSE], i + 2, 0) {
        Some(f) => {
            push(mut p, f"<?{sub_text(rawdata, i + 2, f.start)}>");
            f.end
        }
        None => -1,
    }
}

fn parse_starttag(p: mut ref MinParser, w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64) -> Result[i64, Exc] {
    let endpos = check_for_whole_start_tag(w, mut m, rawdata, i)?;
    if endpos < 0 {
        return Ok(endpos);
    }
    let mut attrs: Vec[(String, Option[String])] = Vec.new();
    let found = match rx(mut m, w.pats[P_TAGFIND], i + 1, 1) {
        Some(f) => f,
        None => return Err(assertion("unexpected call to parse_starttag()".to_string())),
    };
    let mut k = found.end;
    let tag = group_text(rawdata, found, 1).unwrap_or(String.new()).to_lowercase();
    while k < endpos {
        let a = match rx(mut m, w.pats[P_ATTRFIND], k, 1) {
            Some(f) => f,
            None => break,
        };
        let attrname = group_text(rawdata, a, 1).unwrap_or(String.new());
        let rest = group_text(rawdata, a, 2).unwrap_or(String.new());
        let mut attrvalue = group_text(rawdata, a, 3);
        if rest.len() == 0 {
            attrvalue = None;
        } else {
            let v = attrvalue.clone().unwrap_or(String.new());
            let vs = cps(v);
            if vs.len() >= 1 {
                let q0 = vs[0];
                let q1 = vs[vs.len() - 1];
                if (q0 == 39 and q1 == 39) or (q0 == 34 and q1 == 34) {
                    attrvalue = Some(sub_text(vs, 1, vs.len() - 1));
                }
            }
        }
        // a non-empty value goes through HTMLMinParser.unescape, which keeps it
        attrs.push((attrname.to_lowercase(), attrvalue));
        k = a.end;
    }
    let end_text = to_string(py_strip(slice(rawdata, k, endpos)));
    if end_text != ">" and end_text != "/>" {
        handle_data(mut p, sub_text(rawdata, i, endpos))?;
        return Ok(endpos);
    }
    if end_text.ends_with("/>") {
        // XHTML-style empty tag: <span attr="value" />
        handle_startendtag(mut p, w, tag, attrs)?;
    } else {
        handle_starttag(mut p, w, tag, attrs)?;
        if tag == "script" or tag == "style" {
            p.cdata_elem = tag.clone();
        }
    }
    Ok(endpos)
}

fn is_tag_continue(c: i64) -> bool {
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 61 or c == 47
}

fn check_for_whole_start_tag(w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64) -> Result[i64, Exc] {
    let found = match rx(mut m, w.pats[P_LOCATESTARTTAGEND], i, 1) {
        Some(f) => f,
        None => return Err(assertion("we should not get here!".to_string())),
    };
    let j = found.end;
    if j >= rawdata.len() {
        // end of input
        return Ok(-1);
    }
    let next = rawdata[j];
    if next == 62 {
        return Ok(j + 1);
    }
    if next == 47 {
        if starts_at(rawdata, j, "/>") {
            return Ok(j + 2);
        }
        // buffer boundary
        return Ok(-1);
    }
    if is_tag_continue(next) {
        // end of input in or before an attribute value, or the '/' of '/>'
        return Ok(-1);
    }
    if j > i { Ok(j) } else { Ok(i + 1) }
}

fn parse_endtag(p: mut ref MinParser, w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64) -> Result[i64, Exc] {
    let close = match rx(mut m, w.pats[P_ENDENDTAG], i + 1, 0) {
        Some(f) => f,
        None => return Ok(-1),
    };
    let gtpos = close.end;
    match rx(mut m, w.pats[P_ENDTAGFIND], i, 1) {
        Some(f) => {
            let elem = group_text(rawdata, f, 1).unwrap_or(String.new()).to_lowercase();
            if p.cdata_elem.len() > 0 {
                if elem != p.cdata_elem {
                    handle_data(mut p, sub_text(rawdata, i, gtpos))?;
                    return Ok(gtpos);
                }
            }
            handle_endtag(mut p, elem.to_lowercase());
            p.cdata_elem = String.new();
            Ok(gtpos)
        }
        None => {
            if p.cdata_elem.len() > 0 {
                handle_data(mut p, sub_text(rawdata, i, gtpos))?;
                return Ok(gtpos);
            }
            // the name: w3.org/TR/html5/tokenization.html#tag-name-state
            match rx(mut m, w.pats[P_TAGFIND], i + 2, 1) {
                Some(nm) => {
                    let tagname = group_text(rawdata, nm, 1).unwrap_or(String.new()).to_lowercase();
                    // anything between the name and the '>' is ignored
                    let gt = find_cp(rawdata, '>', nm.end);
                    handle_endtag(mut p, tagname);
                    Ok(gt + 1)
                }
                None => {
                    if starts_at(rawdata, i, "</>") {
                        Ok(i + 3)
                    } else {
                        Ok(parse_bogus_comment(mut p, w, rawdata, i))
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------ _markupbase.ParserBase

fn scan_name(w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64, declstartpos: i64) -> Result[(Option[String], i64), Exc] {
    let n = rawdata.len();
    if i == n {
        return Ok((None, -1));
    }
    match rx(mut m, w.pats[P_DECLNAME], i, 1) {
        Some(f) => {
            let s = slice(rawdata, f.start, f.end);
            let name = to_string(py_strip(s));
            if i + s.len() == n {
                // end of buffer
                return Ok((None, -1));
            }
            Ok((Some(name.to_lowercase()), f.end))
        }
        None => {
            let hi = if declstartpos + 20 < n { declstartpos + 20 } else { n };
            Err(assertion(f"expected name token at {repr(sub_text(rawdata, declstartpos, hi))}"))
        }
    }
}

fn parse_marked_section(p: mut ref MinParser, w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64) -> Result[i64, Exc] {
    let (sect, j) = scan_name(w, mut m, rawdata, i + 3, i)?;
    if j < 0 {
        return Ok(j);
    }
    let name = sect.unwrap_or(String.new());
    let found = if name == "temp" or name == "cdata" or name == "ignore" or name == "include" or name == "rcdata" {
        rx(mut m, w.pats[P_MARKEDSECTIONCLOSE], i + 3, 0)
    } else if name == "if" or name == "else" or name == "endif" {
        rx(mut m, w.pats[P_MSMARKEDSECTIONCLOSE], i + 3, 0)
    } else {
        return Err(assertion(f"unknown status keyword {repr(sub_text(rawdata, i + 3, j))} in marked section"));
    };
    match found {
        Some(f) => {
            push(mut p, f"<![{sub_text(rawdata, i + 3, f.start)}]>");
            Ok(f.end)
        }
        None => Ok(-1),
    }
}

fn parse_comment(p: mut ref MinParser, w: ref World, m: mut ref Matcher, rawdata: ref Vec[i64], i: i64) -> Result[i64, Exc] {
    if not starts_at(rawdata, i, "<!--") {
        return Err(assertion("unexpected call to parse_comment()".to_string()));
    }
    match rx(mut m, w.pats[P_COMMENTCLOSE], i + 4, 0) {
        Some(f) => {
            handle_comment(mut p, w, sub_text(rawdata, i + 4, f.start));
            Ok(f.end)
        }
        None => Ok(-1),
    }
}

// ------------------------------------------------------------ htmlmin.main

fn minify(w: ref World, input: ref String, opts: ref Opts) -> Result[String, Exc] {
    let mut p = new_parser(opts.clone());
    feed(mut p, w, input)?;
    close(mut p, w)?;
    Ok(result(p))
}

// Minifier.finalize(): flush, take the result, reset for the next page.
fn finalize(p: mut ref MinParser, w: ref World) -> Result[String, Exc] {
    close(mut p, w)?;
    let r = result(p);
    reset(mut p);
    Ok(r)
}

// ------------------------------------------------------------ the jobs

fn dec_int(s: ref String) -> i64 {
    let mut v = 0;
    let mut neg = false;
    for c in s.chars() {
        if c == '-' {
            neg = true;
        } else if c >= '0' and c <= '9' {
            v = v * 10 + (c as i64 - 48);
        }
    }
    if neg { -v } else { v }
}

fn hex_cp(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        0
    }
}

// Job text uses \t, \n, \\ and \uXXXX escapes.
fn unesc(s: ref String) -> String {
    let cs = cps(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if c == '\\' as i64 and i + 1 < cs.len() {
            let n = cs[i + 1];
            if n == 't' as i64 {
                out.push(9);
            } else if n == 'n' as i64 {
                out.push(10);
            } else if n == 'u' as i64 {
                let mut v = 0;
                let mut k = i + 2;
                while k < i + 6 and k < cs.len() {
                    v = v * 16 + hex_cp(cs[k]);
                    k += 1;
                }
                out.push(v);
                i += 4;
            } else {
                out.push(n);
            }
            i += 2;
            continue;
        }
        out.push(c);
        i += 1;
    }
    to_string(out)
}

// The keyword arguments a job's option fields stand for.
fn parse_opts(fields: ref Vec[String], from: i64) -> Opts {
    let mut o = default_opts();
    let mut k = from;
    while k < fields.len() {
        let f = fields[k].clone();
        k += 1;
        let mut key = String.new();
        let mut v = String.new();
        let mut seen = false;
        for c in f.chars() {
            if not seen and c == '=' {
                seen = true;
            } else if seen {
                v.push(c);
            } else {
                key.push(c);
            }
        }
        if key == "keep_quotes" {
            o.remove_optional_attribute_quotes = false;
        } else if key == "charrefs" {
            o.convert_charrefs = v == "1";
        } else if key == "reduce_empty_attributes" {
            o.reduce_empty_attributes = v == "1";
        } else if key == "pre_tags" {
            let mut tags: Vec[String] = Vec.new();
            for t in split_on(v, ',').into_iter() {
                if t.len() > 0 {
                    tags.push(t);
                }
            }
            o.pre_tags = tags;
        } else if key == "pre_attr" {
            o.pre_attr = v;
        } else if key == "remove_comments" {
            o.remove_comments = true;
        } else if key == "remove_empty_space" {
            o.remove_empty_space = true;
        } else if key == "remove_all_empty_space" {
            o.remove_all_empty_space = true;
        } else if key == "reduce_boolean_attributes" {
            o.reduce_boolean_attributes = true;
        } else if key == "keep_pre" {
            o.keep_pre = true;
        }
    }
    o
}

// A carriage return prints as \r, so the output has one kind of line end.
fn show(html: ref String) {
    for line in split_on(html, '\n') {
        let shown = line.replace("\r", "\\r");
        println(f"  | {shown}");
    }
}

fn read_text(name: ref String) -> Result[String, Exc] {
    match fs.read_to_string(f"data/{name}") {
        Ok(t) => Ok(t),
        Err(_) => Err(exc("OSError", f"cannot read {name}")),
    }
}

fn write_text(name: ref String, text: ref String) -> Result[(), Exc] {
    let path = f"data/{name}";
    let _ = fs.create_dir_all(dirname_of(path));
    match fs.write(path, text.clone()) {
        Ok(_) => Ok(()),
        Err(_) => Err(exc("OSError", f"cannot write {name}")),
    }
}

fn cmd_minify(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let text = read_text(f"pages/{f[1]}.html")?;
    let res = minify(w, text, parse_opts(f, 2))?;
    let a = char_count(text);
    let b = char_count(res);
    println(f"  {a} -> {b} chars");
    show(res);
    Ok(())
}

fn cmd_snippet(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let res = minify(w, unesc(f[1]), parse_opts(f, 2))?;
    show(res);
    Ok(())
}

fn cmd_chunks(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let text = read_text(f"pages/{f[1]}.html")?;
    let size = dec_int(f[2]);
    let opts = parse_opts(f, 3);
    let cs = cps(text);
    let mut p = new_parser(opts.clone());
    let mut k = 0;
    while k < cs.len() {
        let hi = if k + size < cs.len() { k + size } else { cs.len() };
        feed(mut p, w, sub_text(cs, k, hi))?;
        k += size;
    }
    let res = finalize(mut p, w)?;
    let whole = minify(w, text, opts)?;
    let same = if res == whole { "True" } else { "False" };
    println(f"  same as one call: {same}");
    show(res);
    // finalize() resets the parser, so the Minifier is ready for the next page
    reset(mut p);
    feed(mut p, w, "<p>  again  </p>".to_string())?;
    let again = finalize(mut p, w)?;
    let shown = repr(again);
    println(f"  reused: {shown}");
    Ok(())
}

fn cmd_attr_value(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let (v, q) = escape_attr_value(w, unesc(f[1]), f[2] == "1");
    let shown = repr(v);
    println(f"  {shown} {q}");
    Ok(())
}

fn cmd_ambiguous(f: ref Vec[String]) -> Result[(), Exc] {
    let shown = repr(escape_ambiguous_ampersand(unesc(f[1])));
    println(f"  {shown}");
    Ok(())
}

fn cmd_unescape(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let shown = repr(html_unescape(unesc(f[1]), w.ents));
    println(f"  {shown}");
    Ok(())
}

fn cmd_escape_tag(f: ref Vec[String]) -> Result[(), Exc] {
    let shown = repr(html_escape(unesc(f[1]), true));
    println(f"  {shown}");
    Ok(())
}

// str.splitlines(keepends=True), which is what codecs' readlines() returns.
fn split_lines_keep(s: ref String) -> Vec[String] {
    let cs = cps(s);
    let mut out: Vec[String] = Vec.new();
    let mut lo = 0;
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        let mut end = -1;
        if c == 13 {
            end = if i + 1 < cs.len() and cs[i + 1] == 10 { i + 2 } else { i + 1 };
        } else if c == 10 or c == 11 or c == 12 or (c >= 0x1c and c <= 0x1e) or c == 0x85 or c == 0x2028 or c == 0x2029 {
            end = i + 1;
        }
        if end >= 0 {
            out.push(sub_text(cs, lo, end));
            lo = end;
            i = end;
        } else {
            i += 1;
        }
    }
    if lo < cs.len() {
        out.push(sub_text(cs, lo, cs.len()));
    }
    out
}

// htmlmin.command.main: the argparse options it declares, then the input
// fed line by line and the parser's result written out. It never calls
// close(), so text still held back at the end is not written; -H,
// --remove-all-empty-space and -e are parsed but not passed on.
fn cmd_cli(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let mut o = default_opts();
    let mut positionals: Vec[String] = Vec.new();
    let mut i = 1;
    let mut rest = false;
    while i < f.len() {
        let a = f[i].clone();
        i += 1;
        if rest or not a.starts_with("-") or a == "-" {
            positionals.push(a);
        } else if a == "--" {
            rest = true;
        } else if a == "-c" or a == "--remove-comments" {
            o.remove_comments = true;
        } else if a == "-s" or a == "--remove-empty-space" {
            o.remove_empty_space = true;
        } else if a == "--keep-optional-attribute-quotes" {
            o.remove_optional_attribute_quotes = false;
        } else if a == "-k" or a == "--keep-pre-attr" {
            o.keep_pre = true;
        } else if a == "-a" or a == "--pre-attr" {
            if i < f.len() {
                o.pre_attr = f[i].clone();
                i += 1;
            }
        } else if a == "-e" or a == "--encoding" {
            i += 1;
        } else if a == "-p" or a == "--pre-tags" {
            let mut tags: Vec[String] = Vec.new();
            while i < f.len() and not f[i].starts_with("-") {
                tags.push(f[i].clone());
                i += 1;
            }
            o.pre_tags = tags;
        } else if a == "-H" or a == "--in-head" or a == "--remove-all-empty-space" {
            // accepted and not used
        } else {
            return Err(exc("SystemExit", f"unrecognized arguments: {a}"));
        }
    }
    if positionals.len() != 2 {
        return Err(exc("SystemExit", "expected INPUT and OUTPUT".to_string()));
    }
    let text = read_text(positionals[0])?;
    let mut p = new_parser(o);
    for line in split_lines_keep(text) {
        feed(mut p, w, line)?;
    }
    write_text(positionals[1], result(p))?;
    show(read_text(positionals[1])?);
    Ok(())
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// A build step: minify each page the manifest lists into site/out and
// report the bytes saved.
fn cmd_site(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let manifest = read_text(f[1])?;
    let mut total_in = 0;
    let mut total_out = 0;
    for line in split_on(manifest, '\n') {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let fields = split_on(line, ' ');
        let name = fields[0].clone();
        let text = match read_text(f"site/src/{name}") {
            Ok(t) => t,
            Err(e) => {
                println(f"  {name} skipped: {e.msg}");
                continue;
            }
        };
        let res = minify(w, text, parse_opts(fields, 1))?;
        write_text(f"site/out/{name}", res)?;
        let size_in = text.len() as i64;
        let size_out = read_text(f"site/out/{name}")?.len() as i64;
        total_in += size_in;
        total_out += size_out;
        let saved = size_in - size_out;
        let pct = floor_div(saved * 100, size_in);
        println(f"  {name} {size_in} -> {size_out} bytes, saved {saved} ({pct}%)");
    }
    if total_in != 0 {
        let saved = total_in - total_out;
        let pct = floor_div(saved * 100, total_in);
        println(f"  total {total_in} -> {total_out} bytes, saved {saved} ({pct}%)");
    }
    Ok(())
}

fn run_job(w: ref World, f: ref Vec[String]) -> Result[(), Exc] {
    let cmd = f[0].clone();
    if cmd == "minify" {
        cmd_minify(w, f)
    } else if cmd == "snippet" {
        cmd_snippet(w, f)
    } else if cmd == "chunks" {
        cmd_chunks(w, f)
    } else if cmd == "attr_value" {
        cmd_attr_value(w, f)
    } else if cmd == "ambiguous" {
        cmd_ambiguous(f)
    } else if cmd == "unescape" {
        cmd_unescape(w, f)
    } else if cmd == "escape_tag" {
        cmd_escape_tag(f)
    } else if cmd == "cli" {
        cmd_cli(w, f)
    } else if cmd == "site" {
        cmd_site(w, f)
    } else {
        Err(exc("KeyError", repr(cmd)))
    }
}

fn write_inputs() -> Result[(), String] {
    let _ = fs.create_dir_all("data".to_string());
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let w = match load_world() {
        Ok(w) => w,
        Err(e) => {
            eprintln(e);
            return;
        }
    };
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let job = hex_string(line);
        if job.starts_with("#") {
            println(job);
            continue;
        }
        let shown = job.replace("\t", " ");
        println(f"> {shown}");
        let f = split_on(job, '\t');
        if let Err(e) = run_job(w, f) {
            println(f"  error {e.cls}: {e.msg}");
        }
    }
}

// html.entities.html5: each name (with or without its ';') and its text.
fn html5_entities() -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    add_entities_0(mut m);
    add_entities_1(mut m);
    add_entities_2(mut m);
    add_entities_3(mut m);
    add_entities_4(mut m);
    add_entities_5(mut m);
    add_entities_6(mut m);
    add_entities_7(mut m);
    add_entities_8(mut m);
    m
}

fn add_entities_0(m: mut ref Map[String, String]) {
    m.insert("AElig".to_string(), "\u{c6}".to_string());
    m.insert("AElig;".to_string(), "\u{c6}".to_string());
    m.insert("AMP".to_string(), "&".to_string());
    m.insert("AMP;".to_string(), "&".to_string());
    m.insert("Aacute".to_string(), "\u{c1}".to_string());
    m.insert("Aacute;".to_string(), "\u{c1}".to_string());
    m.insert("Abreve;".to_string(), "\u{102}".to_string());
    m.insert("Acirc".to_string(), "\u{c2}".to_string());
    m.insert("Acirc;".to_string(), "\u{c2}".to_string());
    m.insert("Acy;".to_string(), "\u{410}".to_string());
    m.insert("Afr;".to_string(), "\u{1d504}".to_string());
    m.insert("Agrave".to_string(), "\u{c0}".to_string());
    m.insert("Agrave;".to_string(), "\u{c0}".to_string());
    m.insert("Alpha;".to_string(), "\u{391}".to_string());
    m.insert("Amacr;".to_string(), "\u{100}".to_string());
    m.insert("And;".to_string(), "\u{2a53}".to_string());
    m.insert("Aogon;".to_string(), "\u{104}".to_string());
    m.insert("Aopf;".to_string(), "\u{1d538}".to_string());
    m.insert("ApplyFunction;".to_string(), "\u{2061}".to_string());
    m.insert("Aring".to_string(), "\u{c5}".to_string());
    m.insert("Aring;".to_string(), "\u{c5}".to_string());
    m.insert("Ascr;".to_string(), "\u{1d49c}".to_string());
    m.insert("Assign;".to_string(), "\u{2254}".to_string());
    m.insert("Atilde".to_string(), "\u{c3}".to_string());
    m.insert("Atilde;".to_string(), "\u{c3}".to_string());
    m.insert("Auml".to_string(), "\u{c4}".to_string());
    m.insert("Auml;".to_string(), "\u{c4}".to_string());
    m.insert("Backslash;".to_string(), "\u{2216}".to_string());
    m.insert("Barv;".to_string(), "\u{2ae7}".to_string());
    m.insert("Barwed;".to_string(), "\u{2306}".to_string());
    m.insert("Bcy;".to_string(), "\u{411}".to_string());
    m.insert("Because;".to_string(), "\u{2235}".to_string());
    m.insert("Bernoullis;".to_string(), "\u{212c}".to_string());
    m.insert("Beta;".to_string(), "\u{392}".to_string());
    m.insert("Bfr;".to_string(), "\u{1d505}".to_string());
    m.insert("Bopf;".to_string(), "\u{1d539}".to_string());
    m.insert("Breve;".to_string(), "\u{2d8}".to_string());
    m.insert("Bscr;".to_string(), "\u{212c}".to_string());
    m.insert("Bumpeq;".to_string(), "\u{224e}".to_string());
    m.insert("CHcy;".to_string(), "\u{427}".to_string());
    m.insert("COPY".to_string(), "\u{a9}".to_string());
    m.insert("COPY;".to_string(), "\u{a9}".to_string());
    m.insert("Cacute;".to_string(), "\u{106}".to_string());
    m.insert("Cap;".to_string(), "\u{22d2}".to_string());
    m.insert("CapitalDifferentialD;".to_string(), "\u{2145}".to_string());
    m.insert("Cayleys;".to_string(), "\u{212d}".to_string());
    m.insert("Ccaron;".to_string(), "\u{10c}".to_string());
    m.insert("Ccedil".to_string(), "\u{c7}".to_string());
    m.insert("Ccedil;".to_string(), "\u{c7}".to_string());
    m.insert("Ccirc;".to_string(), "\u{108}".to_string());
    m.insert("Cconint;".to_string(), "\u{2230}".to_string());
