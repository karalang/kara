// data/schemas/workflow.schema.json
fn file_37() -> String {
    """
{
  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",
  \"title\": \"GitHub Actions workflow (subset)\",
  \"type\": \"object\",
  \"required\": [
    \"on\",
    \"jobs\"
  ],
  \"properties\": {
    \"name\": {
      \"type\": \"string\"
    },
    \"on\": {
      \"oneOf\": [
        {
          \"$ref\": \"#/$defs/event\"
        },
        {
          \"type\": \"array\",
          \"items\": {
            \"$ref\": \"#/$defs/event\"
          },
          \"minItems\": 1
        },
        {
          \"type\": \"object\",
          \"propertyNames\": {
            \"$ref\": \"#/$defs/event\"
          },
          \"minProperties\": 1
        }
      ]
    },
    \"jobs\": {
      \"type\": \"object\",
      \"minProperties\": 1,
      \"patternProperties\": {
        \"^[_a-zA-Z][a-zA-Z0-9_-]*$\": {
          \"$ref\": \"#/$defs/job\"
        }
      },
      \"additionalProperties\": false
    }
  },
  \"$defs\": {
    \"event\": {
      \"enum\": [
        \"push\",
        \"pull_request\",
        \"schedule\",
        \"workflow_dispatch\",
        \"release\"
      ]
    },
    \"job\": {
      \"type\": \"object\",
      \"required\": [
        \"runs-on\",
        \"steps\"
      ],
      \"properties\": {
        \"runs-on\": {
          \"type\": [
            \"string\",
            \"array\"
          ]
        },
        \"timeout-minutes\": {
          \"type\": \"number\",
          \"exclusiveMinimum\": 0,
          \"maximum\": 360
        },
        \"needs\": {
          \"type\": [
            \"string\",
            \"array\"
          ],
          \"items\": {
            \"type\": \"string\"
          }
        },
        \"steps\": {
          \"type\": \"array\",
          \"minItems\": 1,
          \"items\": {
            \"$ref\": \"#/$defs/step\"
          }
        }
      }
    },
    \"step\": {
      \"type\": \"object\",
      \"properties\": {
        \"name\": {
          \"type\": \"string\"
        },
        \"uses\": {
          \"type\": \"string\",
          \"pattern\": \"^[\\\\w.-]+/[\\\\w.-]+(/[\\\\w./-]+)?@[\\\\w.-]+$|^docker://\"
        },
        \"run\": {
          \"type\": \"string\"
        },
        \"with\": {
          \"type\": \"object\"
        }
      },
      \"anyOf\": [
        {
          \"required\": [
            \"uses\"
          ]
        },
        {
          \"required\": [
            \"run\"
          ]
        }
      ],
      \"not\": {
        \"required\": [
          \"uses\",
          \"run\"
        ]
      },
      \"dependentSchemas\": {
        \"with\": {
          \"required\": [
            \"uses\"
          ]
        }
      }
    }
  }
}

"""
}

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

