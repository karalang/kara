// ------------------------------------------------------------ the jobs

fn run() -> Result[(), String] {
    write_data()?;
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    for line in lines_of(text) {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let w = split_on(line, b' ');
        let mut out = f"$ {line}\n";
        let mut body = String.new();
        let rest: Vec[String] = w[1..].to_vec();
        let rc = if w[0] == "validate" { validate(mut body, rest) } else { 127 };
        out.push_str(body);
        if rc != 0 {
            out.push_str(f"[exit status {rc}]\n");
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
