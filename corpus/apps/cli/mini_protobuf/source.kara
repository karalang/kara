    let mut t = String.new();
    t.push_str("/*\n");
    t.push_str(" * Metrics from a fleet of edge devices: every scalar type, packed and\n");
    t.push_str(" * unpacked repeated fields, maps, a oneof, proto3 optional, and a field\n");
    t.push_str(" * with its own JSON name.\n");
    t.push_str(" */\n");
    t.push_str("syntax = \"proto3\";\n");
    t.push_str("\n");
    t.push_str("package telemetry.v1;\n");
    t.push_str("\n");
    t.push_str("enum Severity {\n");
    t.push_str("  SEVERITY_UNSPECIFIED = 0;\n");
    t.push_str("  DEBUG = 1;\n");
    t.push_str("  INFO = 2;\n");
    t.push_str("  WARN = 3;\n");
    t.push_str("  ERROR = 4;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("message Point {\n");
    t.push_str("  double x = 1;\n");
    t.push_str("  double y = 2;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("message Sample {\n");
    t.push_str("  int32 i32 = 1;\n");
    t.push_str("  int64 i64 = 2;\n");
    t.push_str("  uint32 u32 = 3;\n");
    t.push_str("  uint64 u64 = 4;\n");
    t.push_str("  sint32 s32 = 5;\n");
    t.push_str("  sint64 s64 = 6;\n");
    t.push_str("  fixed32 f32 = 7;\n");
    t.push_str("  fixed64 f64 = 8;\n");
    t.push_str("  sfixed32 sf32 = 9;\n");
    t.push_str("  sfixed64 sf64 = 10;\n");
    t.push_str("  bool flag = 11;\n");
    t.push_str("  float ratio = 12;\n");
    t.push_str("  double value = 13;\n");
    t.push_str("  string label = 14 [json_name = \"displayLabel\"];\n");
    t.push_str("  bytes blob = 15;\n");
    t.push_str("  Severity severity = 16;\n");
    t.push_str("  repeated int32 counts = 17;\n");
    t.push_str("  repeated double readings = 18;\n");
    t.push_str("  repeated string tags = 19;\n");
    t.push_str("  map<string, int64> attrs = 20;\n");
    t.push_str("  optional int32 retries = 21;\n");
    t.push_str("  oneof payload {\n");
    t.push_str("    string text = 22;\n");
    t.push_str("    Point point = 23;\n");
    t.push_str("  }\n");
    t.push_str("  repeated Severity history = 24;\n");
    t.push_str("  map<int32, Point> by_id = 25;\n");
    t.push_str("  reserved 26 to 30;\n");
    t.push_str("  reserved \"legacy_id\";\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("message Batch {\n");
    t.push_str("  string host = 1;\n");
    t.push_str("  repeated Sample samples = 2;\n");
    t.push_str("  uint64 seq = 1000;\n");
    t.push_str("  map<string, string> labels = 3;\n");
    t.push_str("  Point origin = 4;\n");
    t.push_str("}\n");
    v.push(DataFile { path: "telemetry.proto".to_string(), hex: false, body: t });
}
