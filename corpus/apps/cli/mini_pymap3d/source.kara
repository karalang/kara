// mini_pymap3d — pymap3d 3.2.0 (SciVision, Felipe Geremia Nievinski,
// Michael Kleder), the coordinate-conversion library behind a good share of
// Python radar, GNSS, drone and satellite-tracking code: geodetic <-> ECEF,
// local East-North-Up, North-East-Down, azimuth-elevation-range and
// down-range/cross-range frames, n-vectors, geocentric and spherical
// coordinates, the auxiliary latitudes (isometric, conformal, rectifying,
// authalic, parametric, geocentric), radii of curvature and of the mean
// spheres, rhumb lines, Vincenty's inverse and direct geodesics, the
// haversine separation and the line-of-sight intersection with the
// ellipsoid, on any of the library's 37 built-in bodies or one given by its
// axes.
//
// It follows the pure-Python path a numpy-free install takes: each function
// works on scalars through the math module, and the library's try/except
// fallbacks (a float that has no item assignment, a NameError for a missing
// numpy name, a ZeroDivisionError on the pole or the axis) pick the branch
// they pick there. Every operation that raises in Python raises here too, as
// an Err carrying the same exception: the math module's domain errors
// (sqrt, asin, atanh and log out of range, sin, cos and tan of an infinity),
// float division and modulo by zero, and a power that overflows. Three
// primitives come from CPython rather than libm and are ported: math.hypot
// (CPython's scaled sum with a Dekker product), math.radians and
// math.degrees (a multiply by pi/180 and 180/pi), and the float % operator
// (fmod, then moved onto the divisor's sign). Formulas keep Python's
// evaluation order, and x ** y is pow. jobs_text() holds data/jobs.tsv.

const PI_F: f64 = 3.141592653589793;
const TAU_F: f64 = 6.283185307179586;
const DBL_MIN: f64 = 2.2250738585072014e-308;
const COS_EPS: f64 = 1e-09;

// ----------------------------------------------------------- CPython math

fn is_nan(x: f64) -> bool {
    x != x
}

fn finite(x: f64) -> bool {
    x == x and x.abs() != f64.INFINITY
}

fn radians(x: f64) -> f64 {
    x * (PI_F / 180.0)
}

fn degrees(x: f64) -> f64 {
    x * (180.0 / PI_F)
}

fn rd(x: f64, deg: bool) -> f64 {
    if deg { radians(x) } else { x }
}

fn dg(x: f64, deg: bool) -> f64 {
    if deg { degrees(x) } else { x }
}

fn dom_err() -> String {
    "ValueError: math domain error".to_string()
}

fn val_err(msg: Str) -> String {
    f"ValueError: {msg}"
}

// ArithmeticError: what an `except (ArithmeticError, ...)` catches.
fn arith(e: ref String) -> bool {
    e.starts_with("ZeroDivisionError") or e.starts_with("OverflowError")
}

fn sin_(x: f64) -> Result[f64, String] {
    if x.abs() == f64.INFINITY { Err(dom_err()) } else { Ok(x.sin()) }
}

fn cos_(x: f64) -> Result[f64, String] {
    if x.abs() == f64.INFINITY { Err(dom_err()) } else { Ok(x.cos()) }
}

fn tan_(x: f64) -> Result[f64, String] {
    if x.abs() == f64.INFINITY { Err(dom_err()) } else { Ok(x.tan()) }
}

fn sqrt_(x: f64) -> Result[f64, String] {
    if x < 0.0 { Err(dom_err()) } else { Ok(x.sqrt()) }
}

fn asin_(x: f64) -> Result[f64, String] {
    if x.abs() > 1.0 { Err(dom_err()) } else { Ok(x.asin()) }
}

fn atanh_(x: f64) -> Result[f64, String] {
    if x.abs() >= 1.0 { Err(dom_err()) } else { Ok(x.atanh()) }
}

fn log_(x: f64) -> Result[f64, String] {
    if x <= 0.0 { Err(dom_err()) } else { Ok(x.ln()) }
}

fn exp_(x: f64) -> Result[f64, String] {
    let r = x.exp();
    if finite(x) and r == f64.INFINITY {
        Err("OverflowError: math range error".to_string())
    } else {
        Ok(r)
    }
}

// float / float
fn dv(a: f64, b: f64) -> Result[f64, String] {
    if b == 0.0 {
        Err("ZeroDivisionError: float division by zero".to_string())
    } else {
        Ok(a / b)
    }
}

// float % float: fmod, then moved onto the divisor's sign.
fn pmod(a: f64, b: f64) -> Result[f64, String] {
    if b == 0.0 {
        return Err("ZeroDivisionError: float modulo by zero".to_string());
    }
    let m = a % b;
    if m != 0.0 {
        if (b < 0.0) != (m < 0.0) { Ok(m + b) } else { Ok(m) }
    } else {
        Ok(0.0.copysign(b))
    }
}

// float ** float. A negative base to a fractional power would be a complex
// number in Python; no job reaches one.
fn pw(x: f64, y: f64) -> Result[f64, String] {
    if x == 0.0 and y < 0.0 {
        return Err("ZeroDivisionError: 0.0 cannot be raised to a negative power".to_string());
    }
    if x < 0.0 and finite(x) and finite(y) and y != y.floor() {
        return Err("TypeError: complex result".to_string());
    }
    let r = x.pow(y);
    if finite(x) and finite(y) and r.abs() == f64.INFINITY {
        Err("OverflowError: (34, 'Numerical result out of range')".to_string())
    } else {
        Ok(r)
    }
}

// mathfun.sign without numpy.
fn sign(x: f64) -> f64 {
    if x < 0.0 {
        -1.0
    } else if x > 0.0 {
        1.0
    } else {
        0.0
    }
}

// Dekker's exact product: z + zz == x * y.
fn two_prod(x: f64, y: f64) -> (f64, f64) {
    let mut t = x * 134217729.0;
    let xh = t - (t - x);
    let xl = x - xh;
    t = y * 134217729.0;
    let yh = t - (t - y);
    let yl = y - yh;
    let p = xh * yh;
    let q = xh * yl + xl * yh;
    let z = p + q;
    let zz = p - z + q + xl * yl;
    (z, zz)
}

// The exponent e of m = f * 2^e with 0.5 <= f < 1 (m > 0, finite).
fn frexp_e(m: f64) -> i64 {
    let mut e = 0;
    let mut x = m;
    while x >= 1.0 {
        x *= 0.5;
        e += 1;
    }
    while x < 0.5 {
        x *= 2.0;
        e -= 1;
    }
    e
}

fn pow2(n: i64) -> f64 {
    let mut r = 1.0;
    let mut i = 0;
    if n >= 0 {
        while i < n {
            r *= 2.0;
            i += 1;
        }
    } else {
        while i < -n {
            r *= 0.5;
            i += 1;
        }
    }
    r
}

// CPython's vector_norm for two coordinates.
fn vector_norm2(a: f64, b: f64, mx: f64, nan: bool) -> f64 {
    if mx == f64.INFINITY {
        return mx;
    }
    if nan {
        return f64.NAN;
    }
    if mx == 0.0 {
        return mx;
    }
    let e = frexp_e(mx);
    if e < -1023 {
        return DBL_MIN * vector_norm2(a / DBL_MIN, b / DBL_MIN, mx / DBL_MIN, nan);
    }
    let scale = pow2(-e);
    let mut csum = 1.0;
    let mut f1 = 0.0;
    let mut f2 = 0.0;
    let mut k = 0;
    while k < 2 {
        let x = if k == 0 { a * scale } else { b * scale };
        let (hi, lo) = two_prod(x, x);
        let s = csum + hi;
        let y = (csum - s) + hi;
        csum = s;
        f1 += lo;
        f2 += y;
        k += 1;
    }
    let mut h = (csum - 1.0 + (f1 + f2)).sqrt();
    let (hi, lo) = two_prod(-h, h);
    let s = csum + hi;
    let y = (csum - s) + hi;
    csum = s;
    f1 += lo;
    f2 += y;
    let x = csum - 1.0 + (f1 + f2);
    h += x / (2.0 * h);
    h / scale
}

fn hypot(x: f64, y: f64) -> f64 {
    let ax = x.abs();
    let ay = y.abs();
    let nan = ax != ax or ay != ay;
    let mut mx = 0.0;
    if ax > mx {
        mx = ax;
    }
    if ay > mx {
        mx = ay;
    }
    vector_norm2(ax, ay, mx, nan)
}

// ----------------------------------------------------------- output

// Python's repr of a float: the shortest digits that read back, which is
// Kara's Display too, except that Python spells NaN "nan".
fn fmt(x: f64) -> String {
    if is_nan(x) {
        return "nan".to_string();
    }
    f"{x}"
}

fn split_on(s: String, sep: u8) -> Vec[String] {
    let b = s.bytes().to_vec();
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for c in b {
        if c == sep {
            out.push(String.from_utf8(cur).unwrap_or("?".to_string()));
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(String.from_utf8(cur).unwrap_or("?".to_string()));
    out
}

fn to_f64(s: String) -> f64 {
    if s == "nan" {
        return f64.NAN;
    }
    if s == "inf" {
        return f64.INFINITY;
    }
    if s == "-inf" {
        return -f64.INFINITY;
    }
    match f64.parse(s.clone()) {
        Ok(v) => v,
        Err(_) => 0.0,
    }
}

fn join_from(f: ref Vec[String], from: i64, upto: i64, sep: Str) -> String {
    let mut out = String.new();
    let mut i = from;
    while i < upto {
        if i > from {
            out.push_str(sep);
        }
        out.push_str(f[i]);
        i += 1;
    }
    out
}

// ----------------------------------------------------------- Ellipsoid

struct Ell {
    model: String,
    name: String,
    a: f64,
    b: f64,
    f: f64,
    n: f64,
    e: f64,
}

// Ellipsoid(a, b): flattening, third flattening and eccentricity are derived
// in that order, with the constructor's assert between the first two.
fn new_ell(a: f64, b: f64, name: Str, model: Str) -> Result[Ell, String] {
    let f = dv(a - b, a)?;
    if not (f >= 0.0) {
        return Err("AssertionError: flattening must be >= 0".to_string());
    }
    let n = dv(a - b, a + b)?;
    let e = sqrt_(2.0 * f - pw(f, 2.0)?)?;
    Ok(Ell { model: model.to_string(), name: name.to_string(), a: a, b: b, f: f, n: n, e: e })
}

// Ellipsoid.models: (display name, a, b).
fn model_entry(m: ref String) -> Option[(Str, f64, f64)] {
    if m == "maupertuis" {
        Some(("Maupertuis (1738)", 6397300.0, 6363806.283))
    } else if m == "plessis" {
        Some(("Plessis (1817)", 6376523.0, 6355862.9333))
    } else if m == "everest1830" {
        Some(("Everest (1830)", 6377299.365, 6356098.359))
    } else if m == "everest1830m" {
        Some(("Everest 1830 Modified (1967)", 6377304.063, 6356103.039))
    } else if m == "everest1967" {
        Some(("Everest 1830 (1967 Definition)", 6377298.556, 6356097.55))
    } else if m == "airy" {
        Some(("Airy (1830)", 6377563.396, 6356256.909))
    } else if m == "bessel" {
        Some(("Bessel (1841)", 6377397.155, 6356078.963))
    } else if m == "clarke1866" {
        Some(("Clarke (1866)", 6378206.4, 6356583.8))
    } else if m == "clarke1878" {
        Some(("Clarke (1878)", 6378190.0, 6356456.0))
    } else if m == "clarke1860" {
        Some(("Clarke (1880)", 6378249.145, 6356514.87))
    } else if m == "helmert" {
        Some(("Helmert (1906)", 6378200.0, 6356818.17))
    } else if m == "hayford" {
        Some(("Hayford (1910)", 6378388.0, 6356911.946))
    } else if m == "international1924" {
        Some(("International (1924)", 6378388.0, 6356911.946))
    } else if m == "krassovsky1940" {
        Some(("Krassovsky (1940)", 6378245.0, 6356863.019))
    } else if m == "wgs66" {
        Some(("WGS66 (1966)", 6378145.0, 6356759.769))
    } else if m == "australian" {
        Some(("Australian National (1966)", 6378160.0, 6356774.719))
    } else if m == "international1967" {
        Some(("New International (1967)", 6378157.5, 6356772.2))
    } else if m == "grs67" {
        Some(("GRS-67 (1967)", 6378160.0, 6356774.516))
    } else if m == "sa1969" {
        Some(("South American (1969)", 6378160.0, 6356774.719))
    } else if m == "wgs72" {
        Some(("WGS-72 (1972)", 6378135.0, 6356750.52001609))
    } else if m == "grs80" {
        Some(("GRS-80 (1979)", 6378137.0, 6356752.31414036))
    } else if m == "wgs84" {
        Some(("WGS-84 (1984)", 6378137.0, 6356752.31424518))
    } else if m == "wgs84_mean" {
        Some(("WGS-84 (1984) Mean", 6371008.7714, 6371008.7714))
    } else if m == "iers1989" {
        Some(("IERS (1989)", 6378136.0, 6356751.302))
    } else if m == "pz90.11" {
        Some(("ПЗ-90 (2011)", 6378136.0, 6356751.3618))
    } else if m == "iers2003" {
        Some(("IERS (2003)", 6378136.6, 6356751.9))
    } else if m == "gsk2011" {
        Some(("ГСК (2011)", 6378136.5, 6356751.758))
    } else if m == "mercury" {
        Some(("Mercury", 2440500.0, 2438300.0))
    } else if m == "venus" {
        Some(("Venus", 6051800.0, 6051800.0))
    } else if m == "moon" {
        Some(("Moon", 1738100.0, 1736000.0))
    } else if m == "mars" {
        Some(("Mars", 3396900.0, 3376097.80585952))
    } else if m == "jupyter" {
        Some(("Jupiter", 71492000.0, 66770054.3475922))
    } else if m == "io" {
        Some(("Io", 1829.7, 1815.8))
    } else if m == "saturn" {
        Some(("Saturn", 60268000.0, 54364301.5271271))
    } else if m == "uranus" {
        Some(("Uranus", 25559000.0, 24973000.0))
    } else if m == "neptune" {
        Some(("Neptune", 24764000.0, 24341000.0))
    } else if m == "pluto" {
        Some(("Pluto", 1188000.0, 1188000.0))
    } else {
        None
    }
}

fn from_name(m: ref String) -> Result[Ell, String] {
    match model_entry(m) {
        Some((name, a, b)) => new_ell(a, b, name, m.as_str()),
        None => Err(f"KeyError: '{m}'"),
    }
}

fn wgs84() -> Ell {
    from_name("wgs84".to_string()).unwrap()
}

fn ell_repr(g: ref Ell) -> String {
    f"Ellipsoid(model='{g.model}', name='{g.name}', semimajor_axis={fmt(g.a)}, semiminor_axis={fmt(g.b)}, flattening={fmt(g.f)}, thirdflattening={fmt(g.n)}, eccentricity={fmt(g.e)})"
}

// ----------------------------------------------------------- ecef

fn geodetic2ecef(lat0: f64, lon0: f64, alt: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat = rd(lat0, deg);
    let lon = rd(lon0, deg);
    let nn = dv(pw(ell.a, 2.0)?, hypot(ell.a * cos_(lat)?, ell.b * sin_(lat)?))?;
    let x = (nn + alt) * cos_(lat)? * cos_(lon)?;
    let y = (nn + alt) * cos_(lat)? * sin_(lon)?;
    let z = (nn * pw(dv(ell.b, ell.a)?, 2.0)? + alt) * sin_(lat)?;
    Ok((x, y, z))
}

// The numpy-free branch of ecef2geodetic's Beta: the two statements inside
// its try block.
fn ecef_beta(ell: ref Ell, u: f64, hxy: f64, hue: f64, z: f64, ee: f64) -> Result[f64, String] {
    let mut beta = dv(dv(hue, u)? * z, hxy)?.atan();
    let num = (ell.b * u - ell.a * hue + pw(ee, 2.0)?) * sin_(beta)?;
    let den = dv(ell.a * hue * 1.0, cos_(beta)?)? - pw(ee, 2.0)? * cos_(beta)?;
    beta += dv(num, den)?;
    Ok(beta)
}

fn ecef2geodetic(x: f64, y: f64, z: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let r = sqrt_(pw(x, 2.0)? + pw(y, 2.0)? + pw(z, 2.0)?)?;
    let ee = sqrt_(pw(ell.a, 2.0)? - pw(ell.b, 2.0)?)?;
    let r2e2 = pw(r, 2.0)? - pw(ee, 2.0)?;
    let u = sqrt_(0.5 * (pw(r, 2.0)? - pw(ee, 2.0)?) + 0.5 * hypot(r2e2, 2.0 * ee * z))?;
    let hxy = hypot(x, y);
    let hue = hypot(u, ee);
    let beta = match ecef_beta(ell, u, hxy, hue, z, ee) {
        Ok(b) => b,
        Err(e) => {
            if not arith(e) {
                return Err(e);
            }
            if z == 0.0 {
                0.0
            } else if z > 0.0 {
                PI_F / 2.0
            } else {
                -PI_F / 2.0
            }
        }
    };
    let mut lat = (dv(ell.a, ell.b)? * tan_(beta)?).atan();
    let mut lon = y.atan2(x);
    let cos_beta = cos_(beta)?;
    let mut alt = hypot(z - ell.b * sin_(beta)?, hxy - ell.a * cos_beta);
    let inside = dv(pw(x, 2.0)?, pw(ell.a, 2.0)?)? + dv(pw(y, 2.0)?, pw(ell.a, 2.0)?)? + dv(pw(z, 2.0)?, pw(ell.b, 2.0)?)? < 1.0;
    if inside {
        alt = -alt;
    }
    if deg {
        lat = degrees(lat);
        lon = degrees(lon);
    }
    Ok((lat, lon, alt))
}

fn ecef2enuv(u: f64, v: f64, w: f64, lat00: f64, lon00: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat0 = rd(lat00, deg);
    let lon0 = rd(lon00, deg);
    let t = cos_(lon0)? * u + sin_(lon0)? * v;
    let u_east = -sin_(lon0)? * u + cos_(lon0)? * v;
    let w_up = cos_(lat0)? * t + sin_(lat0)? * w;
    let v_north = -sin_(lat0)? * t + cos_(lat0)? * w;
    Ok((u_east, v_north, w_up))
}

fn ecef2enu(x: f64, y: f64, z: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (x0, y0, z0) = geodetic2ecef(lat0, lon0, h0, ell, deg)?;
    uvw2enu(x - x0, y - y0, z - z0, lat0, lon0, deg)
}

fn enu2uvw(east: f64, north: f64, up: f64, lat00: f64, lon00: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat0 = rd(lat00, deg);
    let lon0 = rd(lon00, deg);
    let t = cos_(lat0)? * up - sin_(lat0)? * north;
    let w = sin_(lat0)? * up + cos_(lat0)? * north;
    let u = cos_(lon0)? * t - sin_(lon0)? * east;
    let v = sin_(lon0)? * t + cos_(lon0)? * east;
    Ok((u, v, w))
}

fn uvw2enu(u: f64, v: f64, w: f64, lat00: f64, lon00: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat0 = rd(lat00, deg);
    let lon0 = rd(lon00, deg);
    let t = cos_(lon0)? * u + sin_(lon0)? * v;
    let east = -sin_(lon0)? * u + cos_(lon0)? * v;
    let up = cos_(lat0)? * t + sin_(lat0)? * w;
    let north = -sin_(lat0)? * t + cos_(lat0)? * w;
    Ok((east, north, up))
}

fn enu2ecef(e1: f64, n1: f64, u1: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (x0, y0, z0) = geodetic2ecef(lat0, lon0, h0, ell, deg)?;
    let (u, v, w) = enu2uvw(e1, n1, u1, lat0, lon0, deg)?;
    Ok((x0 + u, y0 + v, z0 + w))
}

// ----------------------------------------------------------- enu

fn enu2aer(e0: f64, n0: f64, u0: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let e = if e0.abs() < 0.001 { 0.0 } else { e0 };
    let n = if n0.abs() < 0.001 { 0.0 } else { n0 };
    let u = if u0.abs() < 0.001 { 0.0 } else { u0 };
    let r = hypot(e, n);
    let slant = hypot(r, u);
    let mut elev = u.atan2(r);
    let mut az = pmod(e.atan2(n), TAU_F)?;
    if deg {
        az = degrees(az);
        elev = degrees(elev);
    }
    Ok((az, elev, slant))
}

fn aer2enu(az0: f64, el0: f64, srange: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let el = rd(el0, deg);
    let az = rd(az0, deg);
    if srange < 0.0 {
        return Err(val_err("Slant range  [0, Infinity)"));
    }
    let r = srange * cos_(el)?;
    Ok((r * sin_(az)?, r * cos_(az)?, srange * sin_(el)?))
}

fn enu2geodetic(e: f64, n: f64, u: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (x, y, z) = enu2ecef(e, n, u, lat0, lon0, h0, ell, deg)?;
    ecef2geodetic(x, y, z, ell, deg)
}

fn geodetic2enu(lat: f64, lon: f64, h: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (x1, y1, z1) = geodetic2ecef(lat, lon, h, ell, deg)?;
    let (x2, y2, z2) = geodetic2ecef(lat0, lon0, h0, ell, deg)?;
    uvw2enu(x1 - x2, y1 - y2, z1 - z2, lat0, lon0, deg)
}

fn enu2ecefv(e: f64, n: f64, u: f64, lat00: f64, lon00: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat0 = rd(lat00, deg);
    let lon0 = rd(lon00, deg);
    let x = -sin_(lon0)? * e - sin_(lat0)? * cos_(lon0)? * n + cos_(lat0)? * cos_(lon0)? * u;
    let y = cos_(lon0)? * e - sin_(lat0)? * sin_(lon0)? * n + cos_(lat0)? * sin_(lon0)? * u;
    let z = cos_(lat0)? * n + sin_(lat0)? * u;
    Ok((x, y, z))
}

// ----------------------------------------------------------- aer

fn ecef2aer(x: f64, y: f64, z: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = ecef2enu(x, y, z, lat0, lon0, h0, ell, deg)?;
    enu2aer(e, n, u, deg)
}

fn geodetic2aer(lat: f64, lon: f64, h: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = geodetic2enu(lat, lon, h, lat0, lon0, h0, ell, deg)?;
    enu2aer(e, n, u, deg)
}

fn aer2geodetic(az: f64, el: f64, srange: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (x, y, z) = aer2ecef(az, el, srange, lat0, lon0, h0, ell, deg)?;
    ecef2geodetic(x, y, z, ell, deg)
}

fn aer2ecef(az: f64, el: f64, srange: f64, lat0: f64, lon0: f64, alt0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (x0, y0, z0) = geodetic2ecef(lat0, lon0, alt0, ell, deg)?;
    let (e1, n1, u1) = aer2enu(az, el, srange, deg)?;
    let (dx, dy, dz) = enu2uvw(e1, n1, u1, lat0, lon0, deg)?;
    Ok((x0 + dx, y0 + dy, z0 + dz))
}

// ----------------------------------------------------------- ned

fn aer2ned(az: f64, elev: f64, slant: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = aer2enu(az, elev, slant, deg)?;
    Ok((n, e, -u))
}

fn ned2aer(n: f64, e: f64, d: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    enu2aer(e, n, -d, deg)
}

fn ned2geodetic(n: f64, e: f64, d: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (x, y, z) = enu2ecef(e, n, -d, lat0, lon0, h0, ell, deg)?;
    ecef2geodetic(x, y, z, ell, deg)
}

fn ned2ecef(n: f64, e: f64, d: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    enu2ecef(e, n, -d, lat0, lon0, h0, ell, deg)
}

fn ecef2ned(x: f64, y: f64, z: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = ecef2enu(x, y, z, lat0, lon0, h0, ell, deg)?;
    Ok((n, e, -u))
}

fn geodetic2ned(lat: f64, lon: f64, h: f64, lat0: f64, lon0: f64, h0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = geodetic2enu(lat, lon, h, lat0, lon0, h0, ell, deg)?;
    Ok((n, e, -u))
}

fn ecef2nedv(x: f64, y: f64, z: f64, lat0: f64, lon0: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = ecef2enuv(x, y, z, lat0, lon0, deg)?;
    Ok((n, e, -u))
}

// ----------------------------------------------------------- dca

fn enu2dca(e: f64, n: f64, u: f64, heading0: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let heading = rd(heading0, deg);
    let dr = e * sin_(heading)? + n * cos_(heading)?;
    let cr = -e * cos_(heading)? + n * sin_(heading)?;
    Ok((dr, cr, u))
}

fn dca2enu(dr: f64, cr: f64, above: f64, heading0: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let heading = rd(heading0, deg);
    let e = dr * sin_(heading)? - cr * cos_(heading)?;
    let n = dr * cos_(heading)? + cr * sin_(heading)?;
    Ok((e, n, above))
}

fn dca2ned(dr: f64, cr: f64, above: f64, heading: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = dca2enu(dr, cr, above, heading, deg)?;
    Ok((n, e, -u))
}

fn ned2dca(n: f64, e: f64, d: f64, heading: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    enu2dca(e, n, -d, heading, deg)
}

fn ecef2dca(x: f64, y: f64, z: f64, lat0: f64, lon0: f64, h0: f64, heading: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = ecef2enu(x, y, z, lat0, lon0, h0, ell, deg)?;
    enu2dca(e, n, u, heading, deg)
}

fn dca2ecef(dr: f64, cr: f64, above: f64, lat0: f64, lon0: f64, h0: f64, heading: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = dca2enu(dr, cr, above, heading, deg)?;
    enu2ecef(e, n, u, lat0, lon0, h0, ell, deg)
}

fn geodetic2dca(lat: f64, lon: f64, h: f64, lat0: f64, lon0: f64, h0: f64, heading: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = geodetic2enu(lat, lon, h, lat0, lon0, h0, ell, deg)?;
    enu2dca(e, n, u, heading, deg)
}

fn dca2geodetic(dr: f64, cr: f64, above: f64, lat0: f64, lon0: f64, h0: f64, heading: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = dca2enu(dr, cr, above, heading, deg)?;
    enu2geodetic(e, n, u, lat0, lon0, h0, ell, deg)
}

fn aer2dca(az: f64, el: f64, srange: f64, heading: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = aer2enu(az, el, srange, deg)?;
    enu2dca(e, n, u, heading, deg)
}

fn dca2aer(dr: f64, cr: f64, above: f64, heading: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let (e, n, u) = dca2enu(dr, cr, above, heading, deg)?;
    enu2aer(e, n, u, deg)
}

// ----------------------------------------------------------- utils

fn cart2pol(x: f64, y: f64) -> (f64, f64) {
    (y.atan2(x), hypot(x, y))
}

fn pol2cart(theta: f64, rho: f64) -> Result[(f64, f64), String] {
    Ok((rho * cos_(theta)?, rho * sin_(theta)?))
}

fn cart2sph(x: f64, y: f64, z: f64) -> (f64, f64, f64) {
    let hxy = hypot(x, y);
    let r = hypot(hxy, z);
    let el = z.atan2(hxy);
    let az = y.atan2(x);
    (az, el, r)
}

fn sph2cart(az: f64, el: f64, r: f64) -> Result[(f64, f64, f64), String] {
    let rcos_theta = r * cos_(el)?;
    let x = rcos_theta * cos_(az)?;
    let y = rcos_theta * sin_(az)?;
    let z = r * sin_(el)?;
    Ok((x, y, z))
}

// ----------------------------------------------------------- nvector

fn geodetic2nvector(lat0: f64, lon0: f64, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat = rd(lat0, deg);
    let lon = rd(lon0, deg);
    let sin_lat = sin_(lat)?;
    let cos_lat = cos_(lat)?;
    let sin_lon = sin_(lon)?;
    let cos_lon = cos_(lon)?;
    Ok((cos_lat * cos_lon, cos_lat * sin_lon, sin_lat))
}

fn nvector2geodetic(n1: f64, n2: f64, n3: f64, deg: bool) -> Result[(f64, f64), String] {
    let lat = asin_(n3)?;
    let lon = n2.atan2(n1);
    Ok((dg(lat, deg), dg(lon, deg)))
}

fn ecef2nvector(x: f64, y: f64, z: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (lat, lon, _) = ecef2geodetic(x, y, z, ell, deg)?;
    geodetic2nvector(lat, lon, deg)
}

fn nvector2ecef(n1: f64, n2: f64, n3: f64, alt: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let (lat, lon) = nvector2geodetic(n1, n2, n3, deg)?;
    geodetic2ecef(lat, lon, alt, ell, deg)
}

// ----------------------------------------------------------- spherical

fn geodetic2spherical(lat0: f64, lon0: f64, alt: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat = rd(lat0, deg);
    let lon = rd(lon0, deg);
    let sinlat = sin_(lat)?;
    let coslat = sqrt_(1.0 - pw(sinlat, 2.0)?)?;
    let nn = dv(pw(ell.a, 2.0)?, hypot(ell.a * coslat, ell.b * sinlat))?;
    let xy_projection = (alt + nn) * coslat;
    let z_cartesian = (alt + (1.0 - pw(ell.e, 2.0)?) * nn) * sinlat;
    let radius = hypot(xy_projection, z_cartesian);
    let slat = asin_(dv(z_cartesian, radius)?)?;
    Ok((dg(slat, deg), dg(lon, deg), radius))
}

fn spherical2geodetic(lat0: f64, lon0: f64, radius: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    let lat = rd(lat0, deg);
    let lon = rd(lon0, deg);
    let e = ell.e;
    let sinlat = sin_(lat)?;
    let coslat = sqrt_(1.0 - pw(sinlat, 2.0)?)?;
    let zz = radius * sinlat;
    let p_0 = dv(pw(radius, 2.0)? * pw(coslat, 2.0)?, pw(ell.a, 2.0)?)?;
    let q_0 = dv(1.0 - pw(e, 2.0)?, pw(ell.a, 2.0)?)? * pw(zz, 2.0)?;
    let r_0 = (p_0 + q_0 - pw(e, 4.0)?) / 6.0;
    let s_0 = dv(pw(e, 4.0)? * p_0 * q_0 / 4.0, pw(r_0, 3.0)?)?;
    let t_0 = pw(1.0 + s_0 + sqrt_(2.0 * s_0 + pw(s_0, 2.0)?)?, 1.0 / 3.0)?;
    let u_0 = r_0 * (1.0 + t_0 + dv(1.0, t_0)?);
    let v_0 = sqrt_(pw(u_0, 2.0)? + q_0 * pw(e, 4.0)?)?;
    let w_0 = dv(pw(e, 2.0)? * (u_0 + v_0 - q_0) / 2.0, v_0)?;
    let k = sqrt_(u_0 + v_0 + pw(w_0, 2.0)?)? - w_0;
    let d = dv(k * radius * coslat, k + pw(e, 2.0)?)?;
    let hypot_dz = hypot(d, zz);
    let glat = 2.0 * zz.atan2(d + hypot_dz);
    let alt = dv(k + pw(e, 2.0)? - 1.0, k)? * hypot_dz;
    Ok((dg(glat, deg), dg(lon, deg), alt))
}

// ----------------------------------------------------------- latitude

fn geoc2geod(gc0: f64, dist: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let gc = rd(gc0, deg);
    let r = dv(dist, ell.a)?;
    let t1 = dv(sin_(2.0 * gc)?, r)? * ell.f;
    let t2 = (dv(1.0, pw(r, 2.0)?)? + dv(1.0, 4.0 * r)?) * sin_(4.0 * gc)? * pw(ell.f, 2.0)?;
    Ok(dg(gc + t1 + t2, deg))
}

fn geodetic2geocentric(lat0: f64, alt_m: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let r = transverse(lat, ell, false)?;
    let g = ((1.0 - pw(ell.e, 2.0)? * dv(r, r + alt_m)?) * tan_(lat)?).atan();
    Ok(dg(g, deg))
}

fn geocentric2geodetic(lat0: f64, alt_m: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let r = transverse(lat, ell, false)?;
    let t = tan_(lat)?;
    let g = dv(t, 1.0 - pw(ell.e, 2.0)? * dv(r, r + alt_m)?)?.atan();
    Ok(dg(g, deg))
}

fn geodetic2isometric(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let e = ell.e;
    let mut iso = tan_(lat)?.asinh() - e * atanh_(e * sin_(lat)?)?;
    let coslat = cos_(lat)?;
    if coslat.abs() <= COS_EPS {
        iso = sign(lat) * f64.INFINITY;
    }
    Ok(dg(iso, deg))
}

fn isometric2geodetic(iso0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let iso = rd(iso0, deg);
    let conformal = 2.0 * exp_(iso)?.atan() - PI_F / 2.0;
    let g = conformal2geodetic(conformal, ell, false)?;
    Ok(dg(g, deg))
}

fn conformal2geodetic(c0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let c = rd(c0, deg);
    let e = ell.e;
    let f1 = pw(e, 2.0)? / 2.0 + 5.0 * pw(e, 4.0)? / 24.0 + pw(e, 6.0)? / 12.0 + 13.0 * pw(e, 8.0)? / 360.0;
    let f2 = 7.0 * pw(e, 4.0)? / 48.0 + 29.0 * pw(e, 6.0)? / 240.0 + 811.0 * pw(e, 8.0)? / 11520.0;
    let f3 = 7.0 * pw(e, 6.0)? / 120.0 + 81.0 * pw(e, 8.0)? / 1120.0;
    let f4 = 4279.0 * pw(e, 8.0)? / 161280.0;
    let g = c + f1 * sin_(2.0 * c)? + f2 * sin_(4.0 * c)? + f3 * sin_(6.0 * c)? + f4 * sin_(8.0 * c)?;
    Ok(dg(g, deg))
}

fn conformal_try(f1: f64, f2: f64, f3: f64, f4: f64, e: f64) -> Result[f64, String] {
    Ok(2.0 * sqrt_(dv(f4, f3)? * pw(dv(f1, f2)?, e)?)?.atan() - PI_F / 2.0)
}

fn geodetic2conformal(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let e = ell.e;
    let f1 = 1.0 - e * sin_(lat)?;
    let f2 = 1.0 + e * sin_(lat)?;
    let f3 = 1.0 - sin_(lat)?;
    let f4 = 1.0 + sin_(lat)?;
    let c = match conformal_try(f1, f2, f3, f4, e) {
        Ok(v) => v,
        Err(err) => {
            if not arith(err) {
                return Err(err);
            }
            PI_F / 2.0
        }
    };
    Ok(dg(c, deg))
}

fn geodetic2rectifying(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let n = ell.n;
    let f1 = 3.0 * n / 2.0 - 9.0 * pw(n, 3.0)? / 16.0;
    let f2 = 15.0 * pw(n, 2.0)? / 16.0 - 15.0 * pw(n, 4.0)? / 32.0;
    let f3 = 35.0 * pw(n, 3.0)? / 48.0;
    let f4 = 315.0 * pw(n, 4.0)? / 512.0;
    let r = lat - f1 * sin_(2.0 * lat)? + f2 * sin_(4.0 * lat)? - f3 * sin_(6.0 * lat)? + f4 * sin_(8.0 * lat)?;
    Ok(dg(r, deg))
}

fn rectifying2geodetic(r0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let r = rd(r0, deg);
    let n = ell.n;
    let f1 = 3.0 * n / 2.0 - 27.0 * pw(n, 3.0)? / 32.0;
    let f2 = 21.0 * pw(n, 2.0)? / 16.0 - 55.0 * pw(n, 4.0)? / 32.0;
    let f3 = 151.0 * pw(n, 3.0)? / 96.0;
    let f4 = 1097.0 * pw(n, 4.0)? / 512.0;
    let g = r + f1 * sin_(2.0 * r)? + f2 * sin_(4.0 * r)? + f3 * sin_(6.0 * r)? + f4 * sin_(8.0 * r)?;
    Ok(dg(g, deg))
}

fn geodetic2authalic(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let e = ell.e;
    let f1 = pw(e, 2.0)? / 3.0 + 31.0 * pw(e, 4.0)? / 180.0 + 59.0 * pw(e, 6.0)? / 560.0;
    let f2 = 17.0 * pw(e, 4.0)? / 360.0 + 61.0 * pw(e, 6.0)? / 1260.0;
    let f3 = 383.0 * pw(e, 6.0)? / 45360.0;
    let a = lat - f1 * sin_(2.0 * lat)? + f2 * sin_(4.0 * lat)? - f3 * sin_(6.0 * lat)?;
    Ok(dg(a, deg))
}

fn authalic2geodetic(a0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let a = rd(a0, deg);
    let e = ell.e;
    let f1 = pw(e, 2.0)? / 3.0 + 31.0 * pw(e, 4.0)? / 180.0 + 517.0 * pw(e, 6.0)? / 5040.0;
    let f2 = 23.0 * pw(e, 4.0)? / 360.0 + 251.0 * pw(e, 6.0)? / 3780.0;
    let f3 = 761.0 * pw(e, 6.0)? / 45360.0;
    let g = a + f1 * sin_(2.0 * a)? + f2 * sin_(4.0 * a)? + f3 * sin_(6.0 * a)?;
    Ok(dg(g, deg))
}

fn geodetic2parametric(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let p = (sqrt_(1.0 - pw(ell.e, 2.0)?)? * tan_(lat)?).atan();
    Ok(dg(p, deg))
}

fn parametric2geodetic(p0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let p = rd(p0, deg);
    let t = tan_(p)?;
    let g = dv(t, sqrt_(1.0 - pw(ell.e, 2.0)?)?)?.atan();
    Ok(dg(g, deg))
}

// ----------------------------------------------------------- rcurve

fn geocentric_radius(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let num = pw(pw(ell.a, 2.0)? * cos_(lat)?, 2.0)? + pw(pw(ell.b, 2.0)? * sin_(lat)?, 2.0)?;
    let den = pw(ell.a * cos_(lat)?, 2.0)? + pw(ell.b * sin_(lat)?, 2.0)?;
    sqrt_(dv(num, den)?)
}

fn parallel(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let c = cos_(lat)?;
    Ok(c * transverse(lat, ell, false)?)
}

fn meridian(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let f1 = ell.a * (1.0 - pw(ell.e, 2.0)?);
    let f2 = 1.0 - pw(ell.e * sin_(lat)?, 2.0)?;
    dv(f1, sqrt_(pw(f2, 3.0)?)?)
}

fn transverse(lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    dv(ell.a, sqrt_(1.0 - pw(ell.e * sin_(lat)?, 2.0)?)?)
}

// ----------------------------------------------------------- rsphere

fn eqavol(ell: ref Ell) -> Result[f64, String] {
    let f = ell.f;
    Ok(ell.a * (1.0 - f / 3.0 - pw(f, 2.0)? / 9.0))
}

fn authalic(ell: ref Ell) -> Result[f64, String] {
    let e = ell.e;
    if e > 0.0 {
        let f1 = pw(ell.a, 2.0)? / 2.0;
        let f2 = dv(1.0 - pw(e, 2.0)?, 2.0 * e)?;
        let f3 = log_(dv(1.0 + e, 1.0 - e)?)?;
        sqrt_(f1 * (1.0 + f2 * f3))
    } else {
        Ok(ell.a)
    }
}

fn rectifying(ell: ref Ell) -> Result[f64, String] {
    pw((pw(ell.a, 3.0 / 2.0)? + pw(ell.b, 3.0 / 2.0)?) / 2.0, 2.0 / 3.0)
}

fn euler(lat10: f64, lon10: f64, lat20: f64, lon20: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat1 = if deg { lat10 } else { degrees(lat10) };
    let lon1 = if deg { lon10 } else { degrees(lon10) };
    let lat2 = if deg { lat20 } else { degrees(lat20) };
    let lon2 = if deg { lon20 } else { degrees(lon20) };
    let latmid = lat1 + (lat2 - lat1) / 2.0;
    let (_, az0) = vdist(lat1, lon1, lat2, lon2, ell, true)?;
    let rho = meridian(latmid, ell, true)?;
    let nu = transverse(latmid, ell, true)?;
    let az = radians(az0);
    let den = rho * pw(sin_(az)?, 2.0)? + nu * pw(cos_(az)?, 2.0)?;
    dv(rho * nu, den)
}

fn method_err() -> String {
    val_err("method must be mean or norm")
}

fn curve(lat0: f64, ell: ref Ell, deg: bool, method: ref String) -> Result[f64, String] {
    let lat = rd(lat0, deg);
    let rho = meridian(lat, ell, false)?;
    let nu = transverse(lat, ell, false)?;
    if method == "mean" {
        Ok((rho + nu) / 2.0)
    } else if method == "norm" {
        sqrt_(rho * nu)
    } else {
        Err(method_err())
    }
}

fn triaxial(ell: ref Ell, method: ref String) -> Result[f64, String] {
    if method == "mean" {
        Ok((2.0 * ell.a + ell.b) / 3.0)
    } else if method == "norm" {
        pw(pw(ell.a, 2.0)? * ell.b, 1.0 / 3.0)
    } else {
        Err(method_err())
    }
}

fn biaxial(ell: ref Ell, method: ref String) -> Result[f64, String] {
    if method == "mean" {
        Ok((ell.a + ell.b) / 2.0)
    } else if method == "norm" {
        sqrt_(ell.a * ell.b)
    } else {
        Err(method_err())
    }
}

// ----------------------------------------------------------- lox

fn meridian_arc(lat10: f64, lat20: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lat1 = rd(lat10, deg);
    let lat2 = rd(lat20, deg);
    let rlat1 = geodetic2rectifying(lat1, ell, false)?;
    let rlat2 = geodetic2rectifying(lat2, ell, false)?;
    Ok(rectifying(ell)? * (rlat2 - rlat1).abs())
}

fn loxodrome_inverse(lat10: f64, lon10: f64, lat20: f64, lon20: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64), String] {
    let lat1 = rd(lat10, deg);
    let lon1 = rd(lon10, deg);
    let lat2 = rd(lat20, deg);
    let lon2 = rd(lon20, deg);
    let disolat = geodetic2isometric(lat2, ell, false)? - geodetic2isometric(lat1, ell, false)?;
    let dlon = lon2 - lon1;
    let mut az12 = dlon.atan2(disolat);
    let aux = cos_(az12)?.abs();
    let mut dist = dv(meridian_arc(lat2, lat1, ell, false)?, aux)?;
    if aux < COS_EPS {
        dist = departure(lon2, lon1, lat1, ell, false)?;
    }
    if deg {
        az12 = pmod(degrees(az12), 360.0)?;
    }
    Ok((dist, az12))
}

fn loxodrome_direct(lat10: f64, lon10: f64, rng: f64, a120: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64), String] {
    let lat1 = rd(lat10, deg);
    let lon1 = rd(lon10, deg);
    let a12 = pmod(rd(a120, deg), TAU_F)?;
    if lat1.abs() > PI_F / 2.0 {
        return Err(val_err("-90 <= latitude <= 90"));
    }
    if rng < 0.0 {
        return Err(val_err("ground distance must be >= 0"));
    }
    let reclat = geodetic2rectifying(lat1, ell, false)?;
    let cosaz = cos_(a12)?;
    let lat2r = reclat + dv(rng, rectifying(ell)?)? * cosaz;
    let lat2 = rectifying2geodetic(lat2r, ell, false)?;
    let newiso = geodetic2isometric(lat2, ell, false)?;
    let iso = geodetic2isometric(lat1, ell, false)?;
    let i = cos_(a12)?.abs() < COS_EPS;
    let mut dlon = tan_(a12)? * (newiso - iso);
    if i {
        dlon = dv(sign(PI_F - a12) * rng, parallel(lat1, ell, false)?)?;
    }
    let lon2 = lon1 + dlon;
    Ok((dg(lat2, deg), dg(lon2, deg)))
}

fn departure(lon10: f64, lon20: f64, lat0: f64, ell: ref Ell, deg: bool) -> Result[f64, String] {
    let lon1 = rd(lon10, deg);
    let lon2 = rd(lon20, deg);
    let lat = rd(lat0, deg);
    Ok(parallel(lat, ell, false)? * pmod((lon2 - lon1).abs(), PI_F)?)
}

// meanm builds a numpy array, a NameError without numpy, once the authalic
// latitude has been taken.
fn meanm(lat0: f64, _lon0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64), String] {
    let lat = rd(lat0, deg);
    let _a = geodetic2authalic(lat, ell, false)?;
    Err("NameError: name 'array' is not defined".to_string())
}

// ----------------------------------------------------------- vincenty

fn vd_sin_alpha(u1: f64, u2: f64, lamb: f64, sigma: f64) -> Result[f64, String] {
    dv(cos_(u1)? * cos_(u2)? * sin_(lamb)?, sin_(sigma)?)
}

fn vdist(lat10: f64, lon10: f64, lat20: f64, lon20: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64), String] {
    let a = ell.a;
    let b = ell.b;
    let f = ell.f;
    let mut lat1 = rd(lat10, deg);
    let mut lon1 = rd(lon10, deg);
    let mut lat2 = rd(lat20, deg);
    let mut lon2 = rd(lon20, deg);
    if lat1.abs() > PI_F / 2.0 or lat2.abs() > PI_F / 2.0 {
        return Err(val_err("Input latitudes must be in [-90, 90] degrees."));
    }
    if (PI_F / 2.0 - lat1.abs()).abs() < 1e-10 {
        lat1 = sign(lat1) * (PI_F / 2.0 - 1e-10);
    }
    if (PI_F / 2.0 - lat2.abs()).abs() < 1e-10 {
        lat2 = sign(lat2) * (PI_F / 2.0 - 1e-10);
    }
    let u1 = ((1.0 - f) * tan_(lat1)?).atan();
    let u2 = ((1.0 - f) * tan_(lat2)?).atan();
    lon1 = pmod(lon1, 2.0 * PI_F)?;
    lon2 = pmod(lon2, 2.0 * PI_F)?;
    let mut ll = (lon2 - lon1).abs();
    if ll > PI_F {
        ll = 2.0 * PI_F - ll;
    }
    let mut lamb = ll;
    let mut itercount = 0;
    let mut notdone = true;
    let mut sigma = 0.0;
    let mut alpha = 0.0;
    let mut cos2sigmam = 0.0;
    while notdone {
        itercount += 1;
        if itercount > 50 {
            lamb = PI_F;
            break;
        }
        let mut lambdaold = lamb;
        let sinsigma = sqrt_(pw(cos_(u2)? * sin_(lamb)?, 2.0)? + pw(cos_(u1)? * sin_(u2)? - sin_(u1)? * cos_(u2)? * cos_(lamb)?, 2.0)?)?;
        let cossigma = sin_(u1)? * sin_(u2)? + cos_(u1)? * cos_(u2)? * cos_(lamb)?;
        sigma = sinsigma.atan2(cossigma);
        let sin_alpha = match vd_sin_alpha(u1, u2, lamb, sigma) {
            Ok(v) => v,
            Err(e) => {
                if not arith(e) {
                    return Err(e);
                }
                0.0
            }
        };
        alpha = if is_nan(sin_alpha) {
            0.0
        } else if sin_alpha > 1.0 or (sin_alpha - 1.0).abs() < 1e-16 {
            PI_F / 2.0
        } else {
            asin_(sin_alpha)?
        };
        cos2sigmam = cos_(sigma)? - dv(2.0 * sin_(u1)? * sin_(u2)?, pw(cos_(alpha)?, 2.0)?)?;
        let c = f / 16.0 * pw(cos_(alpha)?, 2.0)? * (4.0 + f * (4.0 - 3.0 * pw(cos_(alpha)?, 2.0)?));
        lamb = ll + (1.0 - c) * f * sin_(alpha)? * (sigma + c * sin_(sigma)? * (cos2sigmam + c * cos_(sigma)? * (-1.0 + 2.0 * pw(cos2sigmam, 2.0)?)));
        if lamb > PI_F {
            lambdaold = PI_F;
            lamb = PI_F;
        }
        notdone = (lamb - lambdaold).abs() > 1e-12;
    }
    let u2s = dv(pw(cos_(alpha)?, 2.0)? * (pw(a, 2.0)? - pw(b, 2.0)?), pw(b, 2.0)?)?;
    let aa = 1.0 + u2s / 16384.0 * (4096.0 + u2s * (-768.0 + u2s * (320.0 - 175.0 * u2s)));
    let bb = u2s / 1024.0 * (256.0 + u2s * (-128.0 + u2s * (74.0 - 47.0 * u2s)));
    let deltasigma = bb * sin_(sigma)? * (cos2sigmam + bb / 4.0 * (cos_(sigma)? * (-1.0 + 2.0 * pw(cos2sigmam, 2.0)?) - bb / 6.0 * cos2sigmam * (-3.0 + 4.0 * pw(sin_(sigma)?, 2.0)?) * (-3.0 + 4.0 * pw(cos2sigmam, 2.0)?)));
    let dist_m = b * aa * (sigma - deltasigma);
    lamb = lamb.abs();
    if sign(sin_(lon2 - lon1)?) * sign(sin_(lamb)?) < 0.0 {
        lamb = -lamb;
    }
    let numer = cos_(u2)? * sin_(lamb)?;
    let denom = cos_(u1)? * sin_(u2)? - sin_(u1)? * cos_(u2)? * cos_(lamb)?;
    let mut a12 = numer.atan2(denom);
    a12 = pmod(a12, TAU_F)?;
    Ok((dist_m, dg(a12, deg)))
}

fn vreckon(lat10: f64, lon10: f64, rng: f64, azim0: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64), String] {
    if rng < 0.0 {
        return Err(val_err("Ground distance must be positive"));
    }
    let a = ell.a;
    let b = ell.b;
    let f = ell.f;
    let mut lat1 = rd(lat10, deg);
    let lon1 = rd(lon10, deg);
    let azim = rd(azim0, deg);
    if lat1.abs() > PI_F / 2.0 {
        return Err(val_err("Input lat. must be between -90 and 90 deg., inclusive."));
    }
    if (PI_F / 2.0 - lat1.abs()).abs() < 1e-10 {
        lat1 = sign(lat1) * (PI_F / 2.0 - 1e-10);
    }
    let alpha1 = azim;
    let sin_alpha1 = sin_(alpha1)?;
    let cos_alpha1 = cos_(alpha1)?;
    let tan_u1 = (1.0 - f) * tan_(lat1)?;
    let cos_u1 = dv(1.0, sqrt_(1.0 + pw(tan_u1, 2.0)?)?)?;
    let sin_u1 = tan_u1 * cos_u1;
    let sigma1 = tan_u1.atan2(cos_alpha1);
    let sin_alpha = cos_u1 * sin_alpha1;
    let cos_sq_alpha = 1.0 - sin_alpha * sin_alpha;
    let u_sq = dv(cos_sq_alpha * (pw(a, 2.0)? - pw(b, 2.0)?), pw(b, 2.0)?)?;
    let aa = 1.0 + u_sq / 16384.0 * (4096.0 + u_sq * (-768.0 + u_sq * (320.0 - 175.0 * u_sq)));
    let bb = u_sq / 1024.0 * (256.0 + u_sq * (-128.0 + u_sq * (74.0 - 47.0 * u_sq)));
    let mut sigma = dv(rng, b * aa)?;
    let mut sigma_p = 2.0 * PI_F;
    let mut sin_sigma = f64.NAN;
    let mut cos_sigma = f64.NAN;
    let mut cos2_sigma_m = f64.NAN;
    let mut i = (sigma - sigma_p).abs() > 1e-12;
    while i {
        cos2_sigma_m = cos_(2.0 * sigma1 + sigma)?;
        sin_sigma = sin_(sigma)?;
        cos_sigma = cos_(sigma)?;
        let delta_sigma = bb * sin_sigma * (cos2_sigma_m + bb / 4.0 * (cos_sigma * (-1.0 + 2.0 * cos2_sigma_m * cos2_sigma_m) - bb / 6.0 * cos2_sigma_m * (-3.0 + 4.0 * sin_sigma * sin_sigma) * (-3.0 + 4.0 * cos2_sigma_m * cos2_sigma_m)));
        sigma_p = sigma;
        sigma = dv(rng, b * aa)? + delta_sigma;
        i = (sigma - sigma_p).abs() > 1e-12;
    }
    let tmp = sin_u1 * sin_sigma - cos_u1 * cos_sigma * cos_alpha1;
    let lat2 = (sin_u1 * cos_sigma + cos_u1 * sin_sigma * cos_alpha1).atan2((1.0 - f) * sqrt_(sin_alpha * sin_alpha + pw(tmp, 2.0)?)?);
    let lamb = (sin_sigma * sin_alpha1).atan2(cos_u1 * cos_sigma - sin_u1 * sin_sigma * cos_alpha1);
    let c = f / 16.0 * cos_sq_alpha * (4.0 + f * (4.0 - 3.0 * cos_sq_alpha));
    let ll = lamb - f * (1.0 - c) * sin_alpha * (sigma + c * sin_sigma * (cos2_sigma_m + c * cos_sigma * (-1.0 + 2.0 * cos2_sigma_m * cos2_sigma_m)));
    let lon2 = pmod(lon1 + ll, TAU_F)?;
    Ok((dg(lat2, deg), dg(lon2, deg)))
}

// track2 hands vreckon the list of distances, and without numpy its first
// comparison `Rng < 0.0` is a TypeError.
fn track2(lat10: f64, lon10: f64, lat20: f64, lon20: f64, ell: ref Ell, npts: i64, deg: bool) -> Result[String, String] {
    if npts < 2 {
        return Err(val_err("npts must be greater than 1"));
    }
    if npts == 2 {
        return Ok(f"([{fmt(lat10)}, {fmt(lat20)}], [{fmt(lon10)}, {fmt(lon20)}])");
    }
    let lat1 = rd(lat10, deg);
    let lon1 = rd(lon10, deg);
    let lat2 = rd(lat20, deg);
    let lon2 = rd(lon20, deg);
    let h = pw(sin_((lat1 - lat2) / 2.0)?, 2.0)? + cos_(lat1)? * cos_(lat2)? * pw(sin_((lon1 - lon2) / 2.0)?, 2.0)?;
    let gcarclen = 2.0 * asin_(sqrt_(h)?)?;
    if (gcarclen - PI_F).abs() < 1e-12 {
        return Err(val_err("cannot compute intermediate points on a great circle whose endpoints are antipodal"));
    }
    let _ = vdist(lat1, lon1, lat2, lon2, ell, false)?;
    Err("TypeError: '<' not supported between instances of 'list' and 'float'".to_string())
}

// ----------------------------------------------------------- haversine

fn haversine(theta: f64) -> Result[f64, String] {
    Ok((1.0 - cos_(theta)?) / 2.0)
}

fn anglesep_meeus(lon00: f64, lat00: f64, lon10: f64, lat10: f64, deg: bool) -> Result[f64, String] {
    let lon0 = rd(lon00, deg);
    let lat0 = rd(lat00, deg);
    let lon1 = rd(lon10, deg);
    let lat1 = rd(lat10, deg);
    let sep = 2.0 * asin_(sqrt_(haversine(lat0 - lat1)? + cos_(lat0)? * cos_(lat1)? * haversine(lon0 - lon1)?)?)?;
    Ok(dg(sep, deg))
}

// Without astropy loaded, anglesep is anglesep_meeus on radians.
fn anglesep(lon00: f64, lat00: f64, lon10: f64, lat10: f64, deg: bool) -> Result[f64, String] {
    let sep = anglesep_meeus(rd(lon00, deg), rd(lat00, deg), rd(lon10, deg), rd(lat10, deg), false)?;
    Ok(dg(sep, deg))
}

// ----------------------------------------------------------- los

fn look_at_spheroid(lat0: f64, lon0: f64, h0: f64, az: f64, tilt: f64, ell: ref Ell, deg: bool) -> Result[(f64, f64, f64), String] {
    if h0 < 0.0 {
        return Err(val_err("Intersection calculation requires altitude  [0, Infinity)"));
    }
    let a = ell.a;
    let b = ell.a;
    let c = ell.b;
    let el = if deg { tilt - 90.0 } else { tilt - PI_F / 2.0 };
    let (e, n, u0) = aer2enu(az, el, 1.0, deg)?;
    let (u, v, w) = enu2uvw(e, n, u0, lat0, lon0, deg)?;
    let w84 = wgs84();
    let (x, y, z) = geodetic2ecef(lat0, lon0, h0, w84, deg)?;
    let a2 = pw(a, 2.0)?;
    let b2 = pw(b, 2.0)?;
    let c2 = pw(c, 2.0)?;
    let value = -a2 * b2 * w * z - a2 * c2 * v * y - b2 * c2 * u * x;
    let mut radical = pw(a, 2.0)? * pw(b, 2.0)? * pw(w, 2.0)? + pw(a, 2.0)? * pw(c, 2.0)? * pw(v, 2.0)? - pw(a, 2.0)? * pw(v, 2.0)? * pw(z, 2.0)?
        + 2.0 * pw(a, 2.0)? * v * w * y * z - pw(a, 2.0)? * pw(w, 2.0)? * pw(y, 2.0)? + pw(b, 2.0)? * pw(c, 2.0)? * pw(u, 2.0)?
        - pw(b, 2.0)? * pw(u, 2.0)? * pw(z, 2.0)? + 2.0 * pw(b, 2.0)? * u * w * x * z - pw(b, 2.0)? * pw(w, 2.0)? * pw(x, 2.0)?
        - pw(c, 2.0)? * pw(u, 2.0)? * pw(y, 2.0)? + 2.0 * pw(c, 2.0)? * u * v * x * y - pw(c, 2.0)? * pw(v, 2.0)? * pw(x, 2.0)?;
    let magnitude = pw(a, 2.0)? * pw(b, 2.0)? * pw(w, 2.0)? + pw(a, 2.0)? * pw(c, 2.0)? * pw(v, 2.0)? + pw(b, 2.0)? * pw(c, 2.0)? * pw(u, 2.0)?;
    if radical < 0.0 {
        radical = f64.NAN;
    }
    let mut d = dv(value - a * b * c * sqrt_(radical)?, magnitude)?;
    if d < 0.0 {
        d = f64.NAN;
    }
    let (lat, lon, _) = ecef2geodetic(x + d * u, y + d * v, z + d * w, w84, deg)?;
    Ok((lat, lon, d))
}

// ----------------------------------------------------------- jobs

fn t2(r: Result[(f64, f64), String]) -> String {
    match r {
        Ok((a, b)) => f"({fmt(a)}, {fmt(b)})",
        Err(e) => e.clone(),
    }
}

fn t3(r: Result[(f64, f64, f64), String]) -> String {
    match r {
        Ok((a, b, c)) => f"({fmt(a)}, {fmt(b)}, {fmt(c)})",
        Err(e) => e.clone(),
    }
}

fn t1(r: Result[f64, String]) -> String {
    match r {
        Ok(a) => fmt(a),
        Err(e) => e.clone(),
    }
}

fn ell_of(s: ref String) -> Result[Ell, String] {
    let p = split_on(s.clone(), b':');
    if p.len() == 2 {
        new_ell(to_f64(p[0].clone()), to_f64(p[1].clone()), "", "")
    } else {
        from_name(s)
    }
}

fn after(s: ref String, n: i64) -> String {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = n;
    while i < b.len() {
        out.push(b[i]);
        i += 1;
    }
    String.from_utf8(out).unwrap_or("?".to_string())
}

fn to_i64(s: String) -> i64 {
    match i64.parse(s) {
        Ok(v) => v,
        Err(_) => 0,
    }
}

fn run_job(f: ref Vec[String]) -> String {
    let name = f[0].clone();
    if name == "ellipsoid" {
        return match ell_of(f[1]) {
            Ok(g) => ell_repr(g),
            Err(e) => e,
        };
    }
    let mut p: Vec[f64] = Vec.new();
    let mut ell = wgs84();
    let mut deg = true;
    let mut method = "mean".to_string();
    let mut npts = 100;
    let mut alt = 0.0;
    let mut i = 1;
    while i < f.len() {
        let tok = f[i].clone();
        if tok.starts_with("ell=") {
            match ell_of(after(tok, 4)) {
                Ok(g) => {
                    ell = g;
                }
                Err(e) => {
                    return e;
                }
            }
        } else if tok == "deg=False" {
            deg = false;
        } else if tok.starts_with("method=") {
            method = after(tok, 7);
        } else if tok.starts_with("npts=") {
            npts = to_i64(after(tok, 5));
        } else if tok.starts_with("alt=") {
            alt = to_f64(after(tok, 4));
        } else {
            p.push(to_f64(tok));
        }
        i += 1;
    }
    let n = p.len();
    let x0 = if n > 0 { p[0] } else { 0.0 };
    let x1 = if n > 1 { p[1] } else { 0.0 };
    let x2 = if n > 2 { p[2] } else { 0.0 };
    let x3 = if n > 3 { p[3] } else { 0.0 };
    let x4 = if n > 4 { p[4] } else { 0.0 };
    let x5 = if n > 5 { p[5] } else { 0.0 };
    let x6 = if n > 6 { p[6] } else { 0.0 };
    if name == "geodetic2ecef" {
        t3(geodetic2ecef(x0, x1, x2, ell, deg))
    } else if name == "ecef2geodetic" {
        t3(ecef2geodetic(x0, x1, x2, ell, deg))
    } else if name == "ecef2enuv" {
        t3(ecef2enuv(x0, x1, x2, x3, x4, deg))
    } else if name == "ecef2enu" {
        t3(ecef2enu(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "enu2uvw" {
        t3(enu2uvw(x0, x1, x2, x3, x4, deg))
    } else if name == "uvw2enu" {
        t3(uvw2enu(x0, x1, x2, x3, x4, deg))
    } else if name == "enu2ecef" {
        t3(enu2ecef(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "enu2aer" {
        t3(enu2aer(x0, x1, x2, deg))
    } else if name == "aer2enu" {
        t3(aer2enu(x0, x1, x2, deg))
    } else if name == "enu2geodetic" {
        t3(enu2geodetic(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "geodetic2enu" {
        t3(geodetic2enu(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "enu2ecefv" {
        t3(enu2ecefv(x0, x1, x2, x3, x4, deg))
    } else if name == "ecef2aer" {
        t3(ecef2aer(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "geodetic2aer" {
        t3(geodetic2aer(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "aer2geodetic" {
        t3(aer2geodetic(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "aer2ecef" {
        t3(aer2ecef(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "aer2ned" {
        t3(aer2ned(x0, x1, x2, deg))
    } else if name == "ned2aer" {
        t3(ned2aer(x0, x1, x2, deg))
    } else if name == "ned2geodetic" {
        t3(ned2geodetic(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "ned2ecef" {
        t3(ned2ecef(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "ecef2ned" {
        t3(ecef2ned(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "geodetic2ned" {
        t3(geodetic2ned(x0, x1, x2, x3, x4, x5, ell, deg))
    } else if name == "ecef2nedv" {
        t3(ecef2nedv(x0, x1, x2, x3, x4, deg))
    } else if name == "enu2dca" {
        t3(enu2dca(x0, x1, x2, x3, deg))
    } else if name == "dca2enu" {
        t3(dca2enu(x0, x1, x2, x3, deg))
    } else if name == "dca2ned" {
        t3(dca2ned(x0, x1, x2, x3, deg))
    } else if name == "ned2dca" {
        t3(ned2dca(x0, x1, x2, x3, deg))
    } else if name == "ecef2dca" {
        t3(ecef2dca(x0, x1, x2, x3, x4, x5, x6, ell, deg))
    } else if name == "dca2ecef" {
        t3(dca2ecef(x0, x1, x2, x3, x4, x5, x6, ell, deg))
    } else if name == "geodetic2dca" {
        t3(geodetic2dca(x0, x1, x2, x3, x4, x5, x6, ell, deg))
    } else if name == "dca2geodetic" {
        t3(dca2geodetic(x0, x1, x2, x3, x4, x5, x6, ell, deg))
    } else if name == "aer2dca" {
        t3(aer2dca(x0, x1, x2, x3, deg))
    } else if name == "dca2aer" {
        t3(dca2aer(x0, x1, x2, x3, deg))
    } else if name == "geodetic2nvector" {
        t3(geodetic2nvector(x0, x1, deg))
    } else if name == "nvector2geodetic" {
        t2(nvector2geodetic(x0, x1, x2, deg))
    } else if name == "ecef2nvector" {
        t3(ecef2nvector(x0, x1, x2, ell, deg))
    } else if name == "nvector2ecef" {
        t3(nvector2ecef(x0, x1, x2, alt, ell, deg))
    } else if name == "lookAtSpheroid" {
        t3(look_at_spheroid(x0, x1, x2, x3, x4, ell, deg))
    } else if name == "utils.cart2pol" {
        t2(Ok(cart2pol(x0, x1)))
    } else if name == "utils.pol2cart" {
        t2(pol2cart(x0, x1))
    } else if name == "utils.cart2sph" {
        t3(Ok(cart2sph(x0, x1, x2)))
    } else if name == "utils.sph2cart" {
        t3(sph2cart(x0, x1, x2))
    } else if name == "latitude.geoc2geod" {
        t1(geoc2geod(x0, x1, ell, deg))
    } else if name == "latitude.geodetic2geocentric" {
        t1(geodetic2geocentric(x0, x1, ell, deg))
    } else if name == "latitude.geocentric2geodetic" {
        t1(geocentric2geodetic(x0, x1, ell, deg))
    } else if name == "latitude.geodetic2isometric" {
        t1(geodetic2isometric(x0, ell, deg))
    } else if name == "latitude.isometric2geodetic" {
        t1(isometric2geodetic(x0, ell, deg))
    } else if name == "latitude.conformal2geodetic" {
        t1(conformal2geodetic(x0, ell, deg))
    } else if name == "latitude.geodetic2conformal" {
        t1(geodetic2conformal(x0, ell, deg))
    } else if name == "latitude.geodetic2rectifying" {
        t1(geodetic2rectifying(x0, ell, deg))
    } else if name == "latitude.rectifying2geodetic" {
        t1(rectifying2geodetic(x0, ell, deg))
    } else if name == "latitude.geodetic2authalic" {
        t1(geodetic2authalic(x0, ell, deg))
    } else if name == "latitude.authalic2geodetic" {
        t1(authalic2geodetic(x0, ell, deg))
    } else if name == "latitude.geodetic2parametric" {
        t1(geodetic2parametric(x0, ell, deg))
    } else if name == "latitude.parametric2geodetic" {
        t1(parametric2geodetic(x0, ell, deg))
    } else if name == "rcurve.geocentric_radius" {
        t1(geocentric_radius(x0, ell, deg))
    } else if name == "rcurve.parallel" {
        t1(parallel(x0, ell, deg))
    } else if name == "rcurve.meridian" {
        t1(meridian(x0, ell, deg))
    } else if name == "rcurve.transverse" {
        t1(transverse(x0, ell, deg))
    } else if name == "rsphere.eqavol" {
        t1(eqavol(ell))
    } else if name == "rsphere.authalic" {
        t1(authalic(ell))
    } else if name == "rsphere.rectifying" {
        t1(rectifying(ell))
    } else if name == "rsphere.euler" {
        t1(euler(x0, x1, x2, x3, ell, deg))
    } else if name == "rsphere.curve" {
        t1(curve(x0, ell, deg, method))
    } else if name == "rsphere.triaxial" {
        t1(triaxial(ell, method))
    } else if name == "rsphere.biaxial" {
        t1(biaxial(ell, method))
    } else if name == "lox.meridian_dist" {
        t1(meridian_arc(0.0, x0, ell, deg))
    } else if name == "lox.meridian_arc" {
        t1(meridian_arc(x0, x1, ell, deg))
    } else if name == "lox.loxodrome_inverse" {
        t2(loxodrome_inverse(x0, x1, x2, x3, ell, deg))
    } else if name == "lox.loxodrome_direct" {
        t2(loxodrome_direct(x0, x1, x2, x3, ell, deg))
    } else if name == "lox.departure" {
        t1(departure(x0, x1, x2, ell, deg))
    } else if name == "lox.meanm" {
        t2(meanm(x0, x1, ell, deg))
    } else if name == "vincenty.vdist" {
        t2(vdist(x0, x1, x2, x3, ell, deg))
    } else if name == "vincenty.vreckon" {
        t2(vreckon(x0, x1, x2, x3, ell, deg))
    } else if name == "vincenty.track2" {
        match track2(x0, x1, x2, x3, ell, npts, deg) {
            Ok(s) => s,
            Err(e) => e,
        }
    } else if name == "haversine.anglesep_meeus" {
        t1(anglesep_meeus(x0, x1, x2, x3, deg))
    } else if name == "haversine.anglesep" {
        t1(anglesep(x0, x1, x2, x3, deg))
    } else if name == "haversine.haversine" {
        t1(haversine(x0))
    } else if name == "spherical.geodetic2spherical" {
        t3(geodetic2spherical(x0, x1, x2, ell, deg))
    } else if name == "spherical.spherical2geodetic" {
        t3(spherical2geodetic(x0, x1, x2, ell, deg))
    } else {
        f"unknown function {name}"
    }
}

fn main_run() -> String {
    let mut out = String.new();
    for line in split_on(jobs_text(), b'\n') {
        if line.len() > 0 {
            let f = split_on(line, b'\t');
            out.push_str(f"{f[0]}({join_from(f, 1, f.len(), ", ")}) => {run_job(f)}\n");
        }
    }
    out
}

fn main() {
    print(main_run());
}

