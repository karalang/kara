    let mut t = String.new();
    t.push_str("#!/usr/bin/env python3\n");
    t.push_str("\"\"\"Command line for the inventory service.\"\"\"\n");
    t.push_str("import argparse\n");
    t.push_str("import logging\n");
    t.push_str("\n");
    t.push_str("from .db import connect, fetch_rows\n");
    t.push_str("from .report import report\n");
    t.push_str("\n");
    t.push_str("log = logging.getLogger(__name__)\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def build_parser():\n");
    t.push_str("    p = argparse.ArgumentParser(prog=\"inv\")\n");
    t.push_str("    p.add_argument(\"db\", nargs=\"?\", default=\"inventory.sqlite3\")\n");
    t.push_str("    p.add_argument(\"-v\", \"--verbose\", action=\"count\", default=0)\n");
    t.push_str("    p.add_argument(\"--format\", choices=(\"text\", \"json\", \"csv\"), default=\"text\", help=\"report format\")\n");
    t.push_str("    sub = p.add_subparsers(dest=\"cmd\", required=True)\n");
    t.push_str("    sub.add_parser(\"report\").add_argument(\"--low\", action=\"store_true\")\n");
    t.push_str("    s = sub.add_parser(\"show\")\n");
    t.push_str("    s.add_argument(\"sku\")\n");
    t.push_str("    return p\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def main(argv=None):\n");
    t.push_str("    args = build_parser().parse_args(argv)\n");
    t.push_str("    logging.basicConfig(level=logging.WARNING - 10 * args.verbose)\n");
    t.push_str("    if args.cmd == \"report\":\n");
    t.push_str("        report(args.db, low_only=args.low)\n");
    t.push_str("    elif args.cmd == \"show\":\n");
    t.push_str("        with connect(args.db) as conn:\n");
    t.push_str("            for row in fetch_rows(conn):\n");
    t.push_str("                if row[\"sku\"] == args.sku:\n");
    t.push_str("                    print(f\"{row}\")\n");
    t.push_str("                    break\n");
    t.push_str("            else:\n");
    t.push_str("                log.error(\"no such sku: %s\", args.sku)\n");
    t.push_str("                return 1\n");
    t.push_str("    return 0\n");
    v.push(DataFile { path: "project/inventory/cli.py".to_string(), hex: false, body: t });
}

fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("import sqlite3\n");
    t.push_str("import contextlib\n");
    t.push_str("\n");
    t.push_str("SCHEMA = \"\"\"\n");
    t.push_str("CREATE TABLE IF NOT EXISTS items (\n");
    t.push_str("    sku   TEXT PRIMARY KEY,\n");
    t.push_str("    name  TEXT NOT NULL,\n");
    t.push_str("    price TEXT NOT NULL,\n");
    t.push_str("    qty   INTEGER DEFAULT 0\n");
    t.push_str(");\n");
    t.push_str("\"\"\"\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("@contextlib.contextmanager\n");
    t.push_str("def connect(path=\":memory:\"):\n");
    t.push_str("    conn = sqlite3.connect(path)\n");
    t.push_str("    try:\n");
    t.push_str("        conn.executescript(SCHEMA)\n");
    t.push_str("        yield conn\n");
    t.push_str("    finally:\n");
    t.push_str("        conn.close()\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def fetch_rows(conn, low_only=False):\n");
    t.push_str("    sql = \"SELECT sku, name, price, qty FROM items\"\n");
    t.push_str("    if low_only:\n");
    t.push_str("        sql += \" WHERE qty < ?\"  # FIXME: use the LOW_STOCK constant\n");
    t.push_str("    rows = conn.execute(sql, (5,) if low_only else ()).fetchall()\n");
    t.push_str("    return [dict(zip((\"sku\", \"name\", \"price\", \"qty\"), r)) for r in rows]\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def count(conn):\n");
    t.push_str("    (n,), = conn.execute(\"SELECT count(*) FROM items\")\n");
    t.push_str("    return n\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("async def fetch_rows_async(pool, low_only=False):\n");
    t.push_str("    async with pool.acquire() as conn:\n");
    t.push_str("        return await conn.run_sync(lambda c: fetch_rows(c, low_only))\n");
    v.push(DataFile { path: "project/inventory/db.py".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("\"\"\"Data model for the inventory service.\"\"\"\n");
    t.push_str("from __future__ import annotations\n");
    t.push_str("\n");
    t.push_str("import dataclasses\n");
    t.push_str("from decimal import Decimal\n");
    t.push_str("from typing import Optional\n");
    t.push_str("\n");
    t.push_str("LOW_STOCK = 5  # reorder below this\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("@dataclasses.dataclass(frozen=True)\n");
    t.push_str("class Item:\n");
    t.push_str("    \"\"\"One stock-keeping unit.\"\"\"\n");
    t.push_str("\n");
    t.push_str("    sku: str\n");
    t.push_str("    name: str\n");
    t.push_str("    price: Decimal\n");
    t.push_str("    qty: int = 0\n");
    t.push_str("    tags: tuple[str, ...] = ()\n");
    t.push_str("\n");
    t.push_str("    @property\n");
    t.push_str("    def low(self) -> bool:\n");
    t.push_str("        return self.qty < LOW_STOCK\n");
    t.push_str("\n");
    t.push_str("    def label(self, width: int = 30) -> str:\n");
    t.push_str("        # TODO: truncate long names with an ellipsis\n");
    t.push_str("        return f\"{self.sku:<8} {self.name:{width}.{width}} {self.price:>8.2f}\"\n");
    t.push_str("\n");
    t.push_str("    def __repr__(self) -> str:\n");
    t.push_str("        return f\"Item({self.sku!r}, qty={self.qty})\"\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("class Store:\n");
    t.push_str("    def __init__(self, items: Optional[list[Item]] = None):\n");
    t.push_str("        self.items = {i.sku: i for i in items or []}\n");
    t.push_str("\n");
    t.push_str("    def total(self) -> Decimal:\n");
    t.push_str("        return sum((i.price * i.qty for i in self.items.values()),\n");
    t.push_str("                   Decimal(\"0\"))\n");
    t.push_str("\n");
    t.push_str("    def restock(self, sku: str, n: int) -> Item:\n");
    t.push_str("        item = self.items[sku]\n");
    t.push_str("        if n <= 0:\n");
    t.push_str("            raise ValueError(f\"bad quantity {n} for {sku}\")\n");
    t.push_str("        self.items[sku] = dataclasses.replace(item, qty=item.qty + n)\n");
    t.push_str("        return self.items[sku]\n");
