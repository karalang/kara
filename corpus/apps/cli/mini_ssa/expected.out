$ live swap.ir early
entry: in n; out n, v
loop: in n, v; out n, v
step: in n, v; out n, v
done: in v; out -
$ ssa swap.ir early
func early(n.0) {
entry:
  v.0 = 0
  jmp loop
loop:
  n.1 = phi [n.0, entry], [n.2, step]
  v.1 = phi [v.0, entry], [v.2, step]
  stop.0 = n.1 == 0
  br stop.0, done, step
step:
  v.2 = v.1 + n.1
  n.2 = n.1 - 1
  big.0 = v.2 > 20
  br big.0, done, loop
done:
  n.3 = phi [n.1, loop], [n.2, step]
  v.3 = phi [v.1, loop], [v.2, step]
  ret v.3
}
$ opt swap.ir early
func early(n.0) {
entry:
  jmp loop
loop:
  n.1 = phi [n.0, entry], [n.2, step]
  v.1 = phi [0, entry], [v.2, step]
  stop.0 = n.1 == 0
  br stop.0, done, step
step:
  v.2 = v.1 + n.1
  n.2 = n.1 - 1
  big.0 = v.2 > 20
  br big.0, done, loop
done:
  v.3 = phi [v.1, loop], [v.2, step]
  ret v.3
}
; folded 1, branches 0, copies 0, dead 1, blocks 0
$ out swap.ir early
func early(n.0) {
entry:
  n.1 = n.0
  v.1 = 0
  jmp loop
loop:
  stop.0 = n.1 == 0
  br stop.0, loop_done, step
loop_done:
  v.3 = v.1
  jmp done
step:
  v.2 = v.1 + n.1
  n.2 = n.1 - 1
  big.0 = v.2 > 20
  br big.0, step_done, step_loop
step_done:
  v.3 = v.2
  jmp done
step_loop:
  n.1 = n.2
  v.1 = v.2
  jmp loop
done:
  ret v.3
}
$ ssa arith.ir pow
func pow(base.0, e.0) {
entry:
  r.0 = 1
  jmp loop
loop:
  base.1 = phi [base.0, entry], [base.2, sq]
