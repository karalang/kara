loop up: back edges from upb; body up, upb
loop down: back edges from downb; body down, downb
$ live loops.ir two_phase
entry: in n; out acc, i, n
up: in acc, i, n; out acc, i, n
turn: in acc, i; out acc, i
down: in acc, i; out acc, i
out: in acc; out -
downb: in acc, i; out acc, i
upb: in acc, i, n; out acc, i, n
$ ssa loops.ir two_phase
func two_phase(n.0) {
entry:
  i.0 = 0
  acc.0 = 0
  jmp up
up:
  acc.1 = phi [acc.0, entry], [acc.4, upb]
  i.1 = phi [i.0, entry], [i.4, upb]
  cu.0 = i.1 < n.0
  br cu.0, upb, turn
upb:
  acc.4 = acc.1 + i.1
  i.4 = i.1 + 1
  jmp up
turn:
  jmp down
down:
  acc.2 = phi [acc.1, turn], [acc.3, downb]
  i.2 = phi [i.1, turn], [i.3, downb]
  cd.0 = i.2 > 0
  br cd.0, downb, out
downb:
  i.3 = i.2 - 1
  acc.3 = acc.2 - 1
  jmp down
out:
  ret acc.2
}
$ opt loops.ir two_phase
func two_phase(n.0) {
entry:
  jmp up
up:
  acc.1 = phi [0, entry], [acc.4, upb]
  i.1 = phi [0, entry], [i.4, upb]
  cu.0 = i.1 < n.0
  br cu.0, upb, turn
upb:
  acc.4 = acc.1 + i.1
  i.4 = i.1 + 1
  jmp up
turn:
  jmp down
down:
  acc.2 = phi [acc.1, turn], [acc.3, downb]
  i.2 = phi [i.1, turn], [i.3, downb]
  cd.0 = i.2 > 0
  br cd.0, downb, out
downb:
  i.3 = i.2 - 1
  acc.3 = acc.2 - 1
  jmp down
out:
  ret acc.2
}
; folded 2, branches 0, copies 0, dead 0, blocks 0
$ out loops.ir two_phase
func two_phase(n.0) {
entry:
  acc.1 = 0
  i.1 = 0
  jmp up
up:
  cu.0 = i.1 < n.0
  br cu.0, upb, turn
upb:
  acc.4 = acc.1 + i.1
  i.4 = i.1 + 1
  acc.1 = acc.4
  i.1 = i.4
  jmp up
turn:
  acc.2 = acc.1
  i.2 = i.1
  jmp down
down:
  cd.0 = i.2 > 0
  br cd.0, downb, out
downb:
  i.3 = i.2 - 1
  acc.3 = acc.2 - 1
  acc.2 = acc.3
  i.2 = i.3
  jmp down
out:
  ret acc.2
}
