$ snip cfg func g(a) {\nentry:\n  ret a\n}\nfunc f() {\nentry:\n  x = call g(1, 2)\n  ret\n}
snip.ir:7: error: g takes 1 argument(s), given 2
$ snip cfg func f() {\nentry:\n  x = call g 1\n  ret\n}
snip.ir:3: error: a call is written call f(args)
$ snip cfg func f() {\nentry:\n  frob x\n  ret\n}
snip.ir:3: error: unknown instruction 'frob'
$ snip cfg func f() {\nentry:\n  ret\n9lbl:\n  ret\n}
snip.ir:4: error: bad label '9lbl'
$ snip cfg func f() {\nentry:  # a comment\n  ret   # and another\n}  # trailing
