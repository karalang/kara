$ ssa swap.ir lost
func lost(n.0) {
entry:
  x.0 = 0
  jmp loop
loop:
  x.1 = phi [x.0, entry], [x.2, loop]
  y.0 = phi [undef, entry], [y.1, loop]
  y.1 = x.1
  x.2 = x.1 + 1
  c.0 = x.2 < n.0
  br c.0, loop, done
done:
  ret y.1
}
$ opt swap.ir lost
func lost(n.0) {
entry:
  jmp loop
loop:
  x.1 = phi [0, entry], [x.2, loop]
  x.2 = x.1 + 1
  c.0 = x.2 < n.0
  br c.0, loop, done
done:
  ret x.1
}
