$ cfg arith.ir gcd
rpo: entry test step done
entry: preds -; succs test
test: preds entry, step; succs done, step
step: preds test; succs test
done: preds test; succs -
$ dom arith.ir gcd
entry: idom -; df -
test: idom entry; df test
step: idom test; df test
done: idom test; df -
tree:
  entry
    test
      step
      done
loop test: back edges from step; body test, step
$ live arith.ir gcd
entry: in a, b; out a, b
test: in a, b; out a, b
step: in a, b; out a, b
done: in a; out -
$ ssa arith.ir gcd
func gcd(a.0, b.0) {
entry:
  jmp test
test:
  a.1 = phi [a.0, entry], [a.2, step]
  b.1 = phi [b.0, entry], [b.2, step]
  z.0 = b.1 == 0
  br z.0, done, step
step:
  t.0 = a.1 % b.1
  a.2 = b.1
  b.2 = t.0
  jmp test
done:
  ret a.1
}
$ opt arith.ir gcd
func gcd(a.0, b.0) {
entry:
  jmp test
test:
  a.1 = phi [a.0, entry], [b.1, step]
  b.1 = phi [b.0, entry], [t.0, step]
  z.0 = b.1 == 0
  br z.0, done, step
step:
  t.0 = a.1 % b.1
  jmp test
done:
  ret a.1
}
; folded 0, branches 0, copies 2, dead 0, blocks 0
$ out arith.ir gcd
func gcd(a.0, b.0) {
entry:
  a.1 = a.0
  b.1 = b.0
  jmp test
test:
  z.0 = b.1 == 0
  br z.0, done, step
step:
  t.0 = a.1 % b.1
  a.1 = b.1
  b.1 = t.0
  jmp test
done:
  ret a.1
}
$ cfg arith.ir collatz
rpo: entry head body even odd next done
entry: preds -; succs head
head: preds entry, next; succs done, body
body: preds head; succs odd, even
even: preds body; succs next
odd: preds body; succs next
next: preds even, odd; succs head
done: preds head; succs -
$ dom arith.ir collatz
entry: idom -; df -
head: idom entry; df head
body: idom head; df head
even: idom body; df next
odd: idom body; df next
next: idom body; df head
done: idom head; df -
tree:
  entry
    head
      body
        even
        odd
        next
      done
loop head: back edges from next; body head, body, even, odd, next
$ live arith.ir collatz
entry: in n; out n, steps
head: in n, steps; out n, steps
body: in n, steps; out n, steps
even: in n, steps; out n, steps
odd: in n, steps; out n, steps
next: in n, steps; out n, steps
done: in steps; out -
$ ssa arith.ir collatz
func collatz(n.0) {
entry:
  steps.0 = 0
  jmp head
head:
  n.1 = phi [n.0, entry], [n.4, next]
  steps.1 = phi [steps.0, entry], [steps.2, next]
  one.0 = n.1 == 1
  br one.0, done, body
body:
  rem.0 = n.1 % 2
  br rem.0, odd, even
even:
  n.2 = n.1 / 2
  jmp next
odd:
  t.0 = n.1 * 3
  n.3 = t.0 + 1
  jmp next
next:
  n.4 = phi [n.2, even], [n.3, odd]
  steps.2 = steps.1 + 1
  jmp head
done:
  ret steps.1
}
$ opt arith.ir collatz
func collatz(n.0) {
entry:
  jmp head
head:
  n.1 = phi [n.0, entry], [n.4, next]
  steps.1 = phi [0, entry], [steps.2, next]
  one.0 = n.1 == 1
  br one.0, done, body
body:
  rem.0 = n.1 % 2
  br rem.0, odd, even
even:
  n.2 = n.1 / 2
  jmp next
odd:
  t.0 = n.1 * 3
  n.3 = t.0 + 1
  jmp next
next:
  n.4 = phi [n.2, even], [n.3, odd]
  steps.2 = steps.1 + 1
  jmp head
done:
  ret steps.1
}
; folded 1, branches 0, copies 0, dead 0, blocks 0
$ out arith.ir collatz
func collatz(n.0) {
entry:
  n.1 = n.0
  steps.1 = 0
  jmp head
head:
  one.0 = n.1 == 1
  br one.0, done, body
body:
  rem.0 = n.1 % 2
  br rem.0, odd, even
even:
  n.2 = n.1 / 2
  n.4 = n.2
  jmp next
odd:
  t.0 = n.1 * 3
  n.3 = t.0 + 1
  n.4 = n.3
  jmp next
next:
  steps.2 = steps.1 + 1
  n.1 = n.4
  steps.1 = steps.2
  jmp head
done:
  ret steps.1
}
$ cfg arith.ir classify
rpo: entry check positive huge isz negative out
entry: preds -; succs negative, check
negative: preds entry; succs out
check: preds entry; succs isz, positive
isz: preds check; succs out
positive: preds check; succs huge, out
huge: preds positive; succs out
out: preds negative, isz, positive, huge; succs -
$ dom arith.ir classify
entry: idom -; df -
check: idom entry; df out
positive: idom check; df out
huge: idom positive; df out
isz: idom check; df out
negative: idom entry; df out
out: idom entry; df -
tree:
  entry
    check
      positive
        huge
      isz
    negative
    out
loops: none
$ live arith.ir classify
entry: in n; out n
check: in n; out n
positive: in n; out r
huge: in -; out r
isz: in -; out r
negative: in -; out r
out: in r; out -
$ ssa arith.ir classify
func classify(n.0) {
entry:
  neg.0 = n.0 < 0
  br neg.0, negative, check
negative:
  r.3 = -1
  jmp out
check:
  zero.0 = n.0 == 0
  br zero.0, isz, positive
isz:
  r.2 = 0
  jmp out
positive:
  big.0 = n.0 > 100
  r.0 = 1
  br big.0, huge, out
huge:
  r.1 = 2
  jmp out
out:
  r.4 = phi [r.3, negative], [r.2, isz], [r.0, positive], [r.1, huge]
  ret r.4
}
$ opt arith.ir classify
func classify(n.0) {
entry:
  neg.0 = n.0 < 0
  br neg.0, negative, check
negative:
  jmp out
check:
  zero.0 = n.0 == 0
  br zero.0, isz, positive
isz:
  jmp out
positive:
  big.0 = n.0 > 100
  br big.0, huge, out
huge:
  jmp out
out:
  r.4 = phi [-1, negative], [0, isz], [1, positive], [2, huge]
  ret r.4
}
; folded 4, branches 0, copies 0, dead 0, blocks 0
$ out arith.ir classify
func classify(n.0) {
entry:
  neg.0 = n.0 < 0
  br neg.0, negative, check
negative:
  r.4 = -1
  jmp out
check:
  zero.0 = n.0 == 0
  br zero.0, isz, positive
isz:
  r.4 = 0
  jmp out
positive:
  big.0 = n.0 > 100
  br big.0, huge, positive_out
positive_out:
  r.4 = 1
  jmp out
huge:
  r.4 = 2
  jmp out
out:
  ret r.4
}
$ cfg loops.ir grid
rpo: entry outer done init inner next cell
entry: preds -; succs outer
outer: preds entry, next; succs init, done
init: preds outer; succs inner
inner: preds init, cell; succs cell, next
cell: preds inner; succs inner
next: preds inner; succs outer
done: preds outer; succs -
$ dom loops.ir grid
entry: idom -; df -
outer: idom entry; df outer
done: idom outer; df -
init: idom outer; df outer
inner: idom init; df outer, inner
next: idom inner; df outer
cell: idom inner; df inner
tree:
  entry
    outer
      done
      init
        inner
          next
          cell
loop outer: back edges from next; body outer, init, inner, next, cell
loop inner: back edges from cell; body inner, cell
$ live loops.ir grid
entry: in n; out i, n, total
outer: in i, n, total; out i, n, total
done: in total; out -
init: in i, n, total; out i, j, n, total
inner: in i, j, n, total; out i, j, n, total
next: in i, n, total; out i, n, total
cell: in i, j, n, total; out i, j, n, total
$ ssa loops.ir grid
func grid(n.0) {
entry:
  total.0 = 0
  i.0 = 0
  jmp outer
outer:
  i.1 = phi [i.0, entry], [i.2, next]
  j.0 = phi [undef, entry], [j.2, next]
  total.1 = phi [total.0, entry], [total.2, next]
  ci.0 = i.1 < n.0
  br ci.0, init, done
init:
  j.1 = 0
  jmp inner
inner:
  j.2 = phi [j.1, init], [j.3, cell]
  total.2 = phi [total.1, init], [total.3, cell]
  cj.0 = j.2 < n.0
  br cj.0, cell, next
cell:
  p.0 = i.1 * j.2
  total.3 = total.2 + p.0
  j.3 = j.2 + 1
  jmp inner
next:
  i.2 = i.1 + 1
  jmp outer
done:
  ret total.1
}
$ opt loops.ir grid
func grid(n.0) {
entry:
  jmp outer
outer:
  i.1 = phi [0, entry], [i.2, next]
  total.1 = phi [0, entry], [total.2, next]
  ci.0 = i.1 < n.0
  br ci.0, init, done
init:
  jmp inner
inner:
  j.2 = phi [0, init], [j.3, cell]
  total.2 = phi [total.1, init], [total.3, cell]
  cj.0 = j.2 < n.0
  br cj.0, cell, next
cell:
  p.0 = i.1 * j.2
  total.3 = total.2 + p.0
  j.3 = j.2 + 1
  jmp inner
next:
  i.2 = i.1 + 1
  jmp outer
done:
  ret total.1
}
; folded 3, branches 0, copies 0, dead 1, blocks 0
$ out loops.ir grid
func grid(n.0) {
entry:
  i.1 = 0
  total.1 = 0
  jmp outer
outer:
  ci.0 = i.1 < n.0
  br ci.0, init, done
init:
  j.2 = 0
  total.2 = total.1
  jmp inner
inner:
  cj.0 = j.2 < n.0
  br cj.0, cell, next
cell:
  p.0 = i.1 * j.2
  total.3 = total.2 + p.0
  j.3 = j.2 + 1
  j.2 = j.3
  total.2 = total.3
  jmp inner
next:
  i.2 = i.1 + 1
  i.1 = i.2
  total.1 = total.2
  jmp outer
done:
  ret total.1
}
$ cfg loops.ir primes
rpo: entry outer done start trial test bump prime composite
entry: preds -; succs outer
outer: preds entry, composite; succs start, done
start: preds outer; succs trial
trial: preds start, bump; succs prime, test
test: preds trial; succs composite, bump
bump: preds test; succs trial
prime: preds trial; succs composite
composite: preds test, prime; succs outer
done: preds outer; succs -
$ dom loops.ir primes
entry: idom -; df -
outer: idom entry; df outer
done: idom outer; df -
start: idom outer; df outer
trial: idom start; df outer, trial
test: idom trial; df trial, composite
bump: idom test; df trial
prime: idom trial; df composite
composite: idom trial; df outer
tree:
  entry
    outer
      done
      start
        trial
          test
            bump
          prime
          composite
loop outer: back edges from composite; body outer, start, trial, test, bump, prime, composite
loop trial: back edges from bump; body trial, test, bump
$ live loops.ir primes
entry: in n; out count, k, n
outer: in count, k, n; out count, k, n
done: in count; out -
start: in count, k, n; out count, d, k, n
trial: in count, d, k, n; out count, d, k, n
test: in count, d, k, n; out count, d, k, n
bump: in count, d, k, n; out count, d, k, n
prime: in count, k, n; out count, k, n
composite: in count, k, n; out count, k, n
$ ssa loops.ir primes
func primes(n.0) {
entry:
  count.0 = 0
  k.0 = 2
  jmp outer
outer:
  count.1 = phi [count.0, entry], [count.3, composite]
  d.0 = phi [undef, entry], [d.2, composite]
  k.1 = phi [k.0, entry], [k.2, composite]
  more.0 = k.1 <= n.0
  br more.0, start, done
start:
  d.1 = 2
  jmp trial
trial:
  d.2 = phi [d.1, start], [d.3, bump]
  dd.0 = d.2 * d.2
  past.0 = dd.0 > k.1
  br past.0, prime, test
test:
  m.0 = k.1 % d.2
  divides.0 = m.0 == 0
  br divides.0, composite, bump
bump:
  d.3 = d.2 + 1
  jmp trial
prime:
  count.2 = count.1 + 1
  jmp composite
composite:
  count.3 = phi [count.1, test], [count.2, prime]
  k.2 = k.1 + 1
  jmp outer
done:
  ret count.1
}
$ opt loops.ir primes
func primes(n.0) {
entry:
  jmp outer
outer:
  count.1 = phi [0, entry], [count.3, composite]
  k.1 = phi [2, entry], [k.2, composite]
  more.0 = k.1 <= n.0
  br more.0, start, done
start:
  jmp trial
trial:
  d.2 = phi [2, start], [d.3, bump]
  dd.0 = d.2 * d.2
  past.0 = dd.0 > k.1
  br past.0, prime, test
test:
  m.0 = k.1 % d.2
  divides.0 = m.0 == 0
  br divides.0, composite, bump
bump:
  d.3 = d.2 + 1
  jmp trial
prime:
  count.2 = count.1 + 1
  jmp composite
composite:
  count.3 = phi [count.1, test], [count.2, prime]
  k.2 = k.1 + 1
  jmp outer
done:
  ret count.1
}
; folded 3, branches 0, copies 0, dead 1, blocks 0
$ out loops.ir primes
func primes(n.0) {
entry:
  count.1 = 0
  k.1 = 2
  jmp outer
outer:
  more.0 = k.1 <= n.0
  br more.0, start, done
start:
  d.2 = 2
  jmp trial
trial:
  dd.0 = d.2 * d.2
  past.0 = dd.0 > k.1
  br past.0, prime, test
test:
  m.0 = k.1 % d.2
  divides.0 = m.0 == 0
  br divides.0, test_composite, bump
test_composite:
  count.3 = count.1
  jmp composite
bump:
  d.3 = d.2 + 1
  d.2 = d.3
  jmp trial
prime:
  count.2 = count.1 + 1
  count.3 = count.2
  jmp composite
composite:
  k.2 = k.1 + 1
  count.1 = count.3
  k.1 = k.2
  jmp outer
done:
  ret count.1
}
$ cfg loops.ir two_phase
