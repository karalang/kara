$ out swap.ir lost
func lost(n.0) {
entry:
  x.1 = 0
  jmp loop
loop:
  x.2 = x.1 + 1
  c.0 = x.2 < n.0
  br c.0, loop_loop, done
loop_loop:
  x.1 = x.2
  jmp loop
done:
  ret x.1
}
