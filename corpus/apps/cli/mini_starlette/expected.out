# compile_path
'/' -> '^/$' '/' []
'/books' -> '^/books$' '/books' []
'/books/{book_id:int}' -> '^/books/(?P<book_id>[0-9]+)$' '/books/{book_id}' [book_id=IntegerConvertor]
'/books/{book_id:int}/price/{currency}' -> '^/books/(?P<book_id>[0-9]+)/price/(?P<currency>[^/]+)$' '/books/{book_id}/price/{currency}' [book_id=IntegerConvertor, currency=StringConvertor]
'/users/{username}' -> '^/users/(?P<username>[^/]+)$' '/users/{username}' [username=StringConvertor]
'/users/{username:str}/repos/{repo}' -> '^/users/(?P<username>[^/]+)/repos/(?P<repo>[^/]+)$' '/users/{username}/repos/{repo}' [username=StringConvertor, repo=StringConvertor]
'/files/{path:path}' -> '^/files/(?P<path>.*)$' '/files/{path}' [path=PathConvertor]
'/rates/{rate:float}' -> '^/rates/(?P<rate>[0-9]+(\\.[0-9]+)?)$' '/rates/{rate}' [rate=FloatConvertor]
'/orders/{order_id:uuid}' -> '^/orders/(?P<order_id>[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12})$' '/orders/{order_id}' [order_id=UUIDConvertor]
'/static/{path:path}' -> '^/static/(?P<path>.*)$' '/static/{path}' [path=PathConvertor]
'/a.b/c+d/{x}' -> '^/a\\.b/c\\+d/(?P<x>[^/]+)$' '/a.b/c+d/{x}' [x=StringConvertor]
'/v1.0/(legacy)/{item}' -> '^/v1\\.0/\\(legacy\\)/(?P<item>[^/]+)$' '/v1.0/(legacy)/{item}' [item=StringConvertor]
'/price/$/{amount:float}' -> '^/price/\\$/(?P<amount>[0-9]+(\\.[0-9]+)?)$' '/price/$/{amount}' [amount=FloatConvertor]
'/tilde~/{x}#frag' -> '^/tilde\\~/(?P<x>[^/]+)\\#frag$' '/tilde~/{x}#frag' [x=StringConvertor]
'/{a}{b}' -> '^/(?P<a>[^/]+)(?P<b>[^/]+)$' '/{a}{b}' [a=StringConvertor, b=StringConvertor]
'/{a}-{b:int}-{c}' -> '^/(?P<a>[^/]+)\\-(?P<b>[0-9]+)\\-(?P<c>[^/]+)$' '/{a}-{b}-{c}' [a=StringConvertor, b=IntegerConvertor, c=StringConvertor]
'/{x}/{x}' -> ! ValueError: Duplicated param name x at path /{x}/{x}
'/{x}/{y}/{x}/{y}' -> ! ValueError: Duplicated param names x, y at path /{x}/{y}/{x}/{y}
'/{x:int}/{x:float}' -> ! ValueError: Duplicated param name x at path /{x:int}/{x:float}
'/{name:slug}' -> ! AssertionError: Unknown path convertor 'slug'
'/{name:Int}' -> ! AssertionError: Unknown path convertor 'Int'
'/{1bad}/{good}' -> '^/\\{1bad\\}/(?P<good>[^/]+)$' '/{1bad}/{good}' [good=StringConvertor]
'/{bad-name}' -> '^/\\{bad\\-name\\}$' '/{bad-name}' []
'/{:int}' -> '^/\\{:int\\}$' '/{:int}' []
'/{_private}/{CamelCase9}' -> '^/(?P<_private>[^/]+)/(?P<CamelCase9>[^/]+)$' '/{_private}/{CamelCase9}' [_private=StringConvertor, CamelCase9=StringConvertor]
'/{a:path}/{b:path}' -> '^/(?P<a>.*)/(?P<b>.*)$' '/{a}/{b}' [a=PathConvertor, b=PathConvertor]
'/space here/{x}' -> '^/space\\ here/(?P<x>[^/]+)$' '/space here/{x}' [x=StringConvertor]
'/café/{x}' -> '^/café/(?P<x>[^/]+)$' '/café/{x}' [x=StringConvertor]
'/brace{/{x}' -> '^/brace\\{/(?P<x>[^/]+)$' '/brace{/{x}' [x=StringConvertor]
'/brace}/{x}' -> '^/brace\\}/(?P<x>[^/]+)$' '/brace}/{x}' [x=StringConvertor]
'{subdomain}.shop.example' -> '^(?P<subdomain>[^/]+)\\.shop\\.example$' '{subdomain}.shop.example' [subdomain=StringConvertor]
'{subdomain}.shop.example:8080' -> '^(?P<subdomain>[^/]+)\\.shop\\.example$' '{subdomain}.shop.example:8080' [subdomain=StringConvertor]
'api.shop.example' -> '^api\\.shop\\.example$' 'api.shop.example' []
'{a}.{b}.example' -> '^(?P<a>[^/]+)\\.(?P<b>[^/]+)\\.example$' '{a}.{b}.example' [a=StringConvertor, b=StringConvertor]
'{tenant:int}.example' -> '^(?P<tenant>[0-9]+)\\.example$' '{tenant}.example' [tenant=IntegerConvertor]
'localhost:{port}' -> '^localhost:(?P<port>[^/]+)$' 'localhost:{port}' [port=StringConvertor]
'' -> '^$' '' []
'/{x:str}' -> '^/(?P<x>[^/]+)$' '/{x}' [x=StringConvertor]
'/q?{x}' -> '^/q\\?(?P<x>[^/]+)$' '/q?{x}' [x=StringConvertor]
'/*.{ext}' -> '^/\\*\\.(?P<ext>[^/]+)$' '/*.{ext}' [ext=StringConvertor]
