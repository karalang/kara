# routes
Route(path='/', name='homepage', methods=['GET', 'HEAD'])
Route(path='/books', name='books', methods=['GET', 'HEAD'])
Route(path='/books', name='create_book', methods=['POST'])
Route(path='/books/{book_id:int}', name='book', methods=['GET', 'HEAD'])
Route(path='/books/{book_id:int}', name='update_book', methods=['PATCH', 'PUT'])
Route(path='/books/{book_id:int}', name='delete_book', methods=['DELETE'])
Route(path='/books/{book_id:int}/price/{currency}', name='price', methods=['GET', 'HEAD'])
Route(path='/rates/{rate:float}', name='rate', methods=['GET', 'HEAD'])
Route(path='/orders/{order_id:uuid}', name='order', methods=['DELETE', 'GET', 'HEAD', 'POST'])
Route(path='/files/{path:path}', name='files', methods=['GET', 'HEAD'])
Route(path='/search/', name='search', methods=['GET', 'HEAD'])
Route(path='/old-catalog', name='old_catalog', methods=['GET', 'HEAD'])
Route(path='/go', name='go', methods=['GET', 'HEAD'])
Route(path='/echo', name='echo', methods=['DELETE', 'GET', 'HEAD', 'PATCH', 'POST', 'PUT'])
Route(path='/login', name='login', methods=['POST'])
Route(path='/logout', name='logout', methods=['POST'])
Route(path='/whoami', name='whoami', methods=['GET', 'HEAD'])
Route(path='/teapot', name='teapot', methods=['BREW', 'GET', 'HEAD', 'POST'])
Route(path='/boom', name='boom', methods=['GET', 'HEAD'])
Route(path='/stock/{sku}', name='stock', methods=['GET', 'HEAD'])
Route(path='/cache/{key}', name='cache', methods=['GET', 'HEAD'])
