# descriptions on type system definitions
> parse cases/descriptions.graphql
  | """A user of the shop."""
  | type User {
  |   "The primary key."
  |   id: ID!
  |   """Display name, as entered."""
  |   name(
  |     "Shorten it."
  |     short: Boolean = false
  |   ): String
  | }
  |
  | "Ways to sort."
  | enum Sort {
  |   "cheapest first"
  |   PRICE_ASC
  |   PRICE_DESC
  | }
  |
  | """Money, in cents."""
  | scalar Cents @specifiedBy(url: "https://example.com/cents")
