    s.push_str("add\t10\n");
    s.push_str("add\t12\n");
    s.push_str("add\t31\n");
    s.push_str("add\t7\n");
    s.push_str("add\t1\n");
    s.push_str("add\t2\n");
    s.push_str("add\t3\n");
    s.push_str("add\t63\n");
    s.push_str("add\t100\n");
    s.push_str("add\t127\n");
    s.push_str("add\t200\n");
    s.push_str("add\t255\n");
    s.push_str("iter\n");
    s.push_str("len\n");
    s.push_str("find\t13\t0\n");
    s.push_str("find\t13\t1\n");
    s.push_str("find\t13\t2\n");
    s.push_str("find\t13\t3\n");
    s.push_str("find\t0\t1000\n");
    s.push_str("find\t255\t1\n");
    s.push_str("find\t200\t2\n");
    s.push_str("find\t7\t2\n");
    s.push_str("find\t1\t1\n");
    s.push_str("find\t64\t0\n");
    s.push_str("find\t100\t0\n");
    s.push_str("find\t999\t2\n");
    s.push_str("find\t15\t4\n");
    s.push_str("find\t0\t0\n");
    s.push_str("dist\t0\t15\n");
    s.push_str("dist\t8\t15\n");
    s.push_str("dist\t13\t5\n");
    s.push_str("dist\t255\t0\n");
    s.push_str("dist\t127\t128\n");
    s.push_str("dist\t1023\t0\n");
    s
}
