// mini_crcmod: crcmod 1.7, Ray Buvel and Craig McQueen's CRC generator,
// as Python tools that check file formats, serial protocols and storage
// use it (gsutil checks CRC-32C with it). It reads the job list from
// data/jobs.tsv: crcmod's catalogue of predefined CRCs, custom and broken
// definitions, streams fed in pieces, C code generation, and programs
// that check the CRCs of real formats.
//
// CRC values and polynomials are u128, which holds the 65-bit
// polynomials of the 64-bit CRCs; crcmod's Python ints never need more.
// Python's exceptions are Exc values: the class name and str(exc).

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn hex_digit(v: u128, upper: bool) -> char {
    let d = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" };
    let cs: Vec[char] = d.chars().collect();
    cs[v as i64]
}

// '%0<width>X' (or x).
fn hex_of(v: u128, width: i64, upper: bool) -> String {
    let mut out: Vec[char] = Vec.new();
    let mut x = v;
    while x > 0 {
        out.push(hex_digit(x % 16, upper));
        x = x / 16;
    }
    while out.len() < width or out.len() == 0 {
        out.push('0');
    }
    out.reverse();
    let mut s = String.new();
    for c in out {
        s.push(c);
    }
    s
}

fn hx(v: u128) -> String {
    hex_of(v, 0, true)
}

fn bytes_hex(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b {
        s.push_str(hex_of(*x as u128, 2, false));
    }
    s
}

fn bool_repr(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// ------------------------------------------------------------- crcmod

fn mask_of(n: i64) -> u128 {
    (1 as u128 << n) - 1
}

fn verify_poly(poly: u128) -> Result[i64, Exc] {
    for n in [8, 16, 24, 32, 64] {
        let low = 1 as u128 << n;
        let high = low * 2;
        if low <= poly and poly < high {
            return Ok(n);
        }
    }
    Err(exc("ValueError", "The degree of the polynomial must be 8, 16, 24, 32 or 64".to_string()))
}

fn bitrev(x0: u128, n: i64) -> u128 {
    let mut x = x0;
    let mut y: u128 = 0;
    for _ in 0..n {
        y = (y << 1) | (x & 1);
        x = x >> 1;
    }
    y
}

fn bytecrc(c0: u128, poly: u128, n: i64) -> u128 {
    let mut crc = c0;
    let top = 1 as u128 << (n - 1);
    for _ in 0..8 {
        if crc & top != 0 {
            crc = (crc << 1) ^ poly;
        } else {
            crc = crc << 1;
        }
    }
    crc & mask_of(n)
}

fn bytecrc_r(c0: u128, poly: u128, n: i64) -> u128 {
    let mut crc = c0;
    for _ in 0..8 {
        if crc & 1 != 0 {
            crc = (crc >> 1) ^ poly;
        } else {
            crc = crc >> 1;
        }
    }
    crc & mask_of(n)
}

fn mk_table(poly: u128, n: i64) -> Vec[u128] {
    let p = poly & mask_of(n);
    let mut t: Vec[u128] = Vec.new();
    for i in 0..256 {
        t.push(bytecrc((i as u128) << (n - 8), p, n));
    }
    t
}

fn mk_table_r(poly: u128, n: i64) -> Vec[u128] {
    let p = bitrev(poly & mask_of(n), n);
    let mut t: Vec[u128] = Vec.new();
    for i in 0..256 {
        t.push(bytecrc_r(i as u128, p, n));
    }
    t
}

// _crcfunpy's _crc<n> and _crc<n>r.
fn raw_crc(data: ref Vec[u8], c0: u128, table: ref Vec[u128], n: i64, rev: bool) -> u128 {
    let m = mask_of(n);
    let mut crc = c0 & m;
    if n == 8 {
        for x in data {
            crc = table[((*x as u128) ^ crc) as i64];
        }
        return crc;
    }
    if rev {
        for x in data {
            crc = table[((*x as u128) ^ (crc & 255)) as i64] ^ (crc >> 8);
        }
    } else {
        let keep = m - 255;
        for x in data {
            crc = table[((*x as u128) ^ ((crc >> (n - 8)) & 255)) as i64] ^ ((crc << 8) & keep);
        }
    }
    crc
}

// A CRC function from mkCrcFun, and the state of a Crc object.
#[derive(Clone)]
struct Crc {
    poly: u128,
    size_bits: i64,
    digest_size: i64,
    init_crc: u128,
    xor_out: u128,
    reverse: bool,
    table: Vec[u128],
    crc_value: u128,
}

// initCrc and xorOut as Python ints: ~0 and other negatives are two's
// complement, which the mask cuts down.
fn new_crc(poly: u128, init: i128, rev: bool, xor_out: i128) -> Result[Crc, Exc] {
    let size_bits = verify_poly(poly)?;
    let m = mask_of(size_bits);
    let init_crc = (init as u128) & m;
    let xo = (xor_out as u128) & m;
    let table = if rev { mk_table_r(poly, size_bits) } else { mk_table(poly, size_bits) };
    Ok(Crc {
        poly: poly,
        size_bits: size_bits,
        digest_size: size_bits / 8,
        init_crc: init_crc,
        xor_out: xo,
        reverse: rev,
        table: table,
        crc_value: init_crc,
    })
}

impl Crc {
    // The function mkCrcFun returns, from a starting value.
    fn fun_from(ref self, data: ref Vec[u8], crc: u128) -> u128 {
        if self.xor_out == 0 {
            raw_crc(data, crc, self.table, self.size_bits, self.reverse)
        } else {
            self.xor_out ^ raw_crc(data, self.xor_out ^ crc, self.table, self.size_bits, self.reverse)
        }
    }

    fn fun(ref self, data: ref Vec[u8]) -> u128 {
        self.fun_from(data, self.init_crc)
    }

    fn update(mut ref self, data: ref Vec[u8]) {
        self.crc_value = self.fun_from(data, self.crc_value);
    }

    fn fresh(ref self) -> Crc {
        let mut n = self.clone();
        n.crc_value = self.init_crc;
        n
    }

    fn copy(ref self) -> Crc {
        self.clone()
    }

    fn digest(ref self) -> Vec[u8] {
        let mut out: Vec[u8] = Vec.new();
        let mut crc = self.crc_value;
        for _ in 0..self.digest_size {
            out.push((crc & 255) as u8);
            crc = crc >> 8;
        }
        out.reverse();
        out
    }

    fn hexdigest(ref self) -> String {
        let mut s = String.new();
        for b in self.digest() {
            s.push_str(hex_of(b as u128, 2, true));
        }
        s
    }

    fn str(ref self) -> String {
        let w = self.digest_size * 2;
        let mut lines: Vec[String] = Vec.new();
        lines.push(f"poly = 0x{hx(self.poly)}");
        lines.push(f"reverse = {bool_repr(self.reverse)}");
        lines.push(f"initCrc  = 0x{hex_of(self.init_crc, w, true)}");
        lines.push(f"xorOut   = 0x{hex_of(self.xor_out, w, true)}");
        lines.push(f"crcValue = 0x{hex_of(self.crc_value, w, true)}");
        lines.join("\n")
    }

    fn generate_code(ref self, name: ref String, data_type: ref Option[String], crc_type: ref Option[String]) -> String {
        let dt = match data_type {
            Some(ref t) => t.clone(),
            None => "UINT8".to_string(),
        };
        let ct = match crc_type {
            Some(ref t) => t.clone(),
            None => {
                let size = if self.digest_size == 3 { 32 } else { 8 * self.digest_size };
                f"UINT{size}"
            }
        };
        let algor = if self.digest_size == 1 {
            f"table[*data ^ ({dt})crc]"
        } else if self.reverse {
            f"table[*data ^ ({dt})crc] ^ (crc >> 8)"
        } else {
            f"table[*data ^ ({dt})(crc >> {8 * (self.digest_size - 1)})] ^ (crc << 8)"
        };
        let w = 2 * self.digest_size;
        let suffix = if self.digest_size <= 4 { "U" } else { "ULL" };
        let per_line = if self.digest_size <= 2 { 8 } else if self.digest_size <= 4 { 4 } else { 2 };
        let mut table = String.new();
        for i in 0..256 {
            if i % per_line == 0 {
                table.push_str("\n    ");
            }
            table.push_str(f"0x{hex_of(self.table[i], w, true)}{suffix},");
        }
        let mut poly = f"polynomial: 0x{hx(self.poly)}";
        if self.reverse {
            poly.push_str(", bit reverse algorithm");
        }
        let mut pre = String.new();
        let mut post = String.new();
        if self.xor_out != 0 {
            pre = f"\n    crc = crc ^ 0x{hex_of(self.xor_out, w, true)}{suffix};";
            post = pre.clone();
        }
        if self.digest_size == 3 {
            if self.reverse {
                pre.push_str("\n    crc = crc & 0xFFFFFFU;");
            } else {
                post.push_str("\n    crc = crc & 0xFFFFFFU;");
            }
        }
        let mut out = String.new();
        out.push_str(f"// Automatically generated CRC function\n// {poly}\n{ct}\n{name}({dt} *data, int len, {ct} crc)\n{{\n");
        out.push_str(f"    static const {ct} table[256] = {{{table}\n    }};\n    {pre}\n");
        out.push_str(f"    while (len > 0)\n    {{\n        crc = {algor};\n        data++;\n        len--;\n    }}{post}\n    return crc;\n}}\n");
        out
    }
}

// ------------------------------------------------------- predefined

#[derive(Clone)]
struct Def {
    name: String,
    identifier: String,
    poly: u128,
    reverse: bool,
    init: u128,
    xor_out: u128,
    check: u128,
}

fn def(name: Str, identifier: Str, poly: u128, reverse: bool, init: u128, xor_out: u128, check: u128) -> Def {
    Def {
        name: name.to_string(),
        identifier: identifier.to_string(),
        poly: poly,
        reverse: reverse,
        init: init,
        xor_out: xor_out,
        check: check,
    }
}

