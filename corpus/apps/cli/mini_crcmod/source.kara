}

fn simplify_name(name: ref String) -> String {
    let n = name.to_lowercase().replace("-", "").replace(" ", "");
    if n.starts_with("crc") { n[3..].to_string() } else { n }
}

// repr() of a str, as KeyError's str() shows its message.
fn str_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { "\"" } else { "'" };
    f"{q}{s}{q}"
}

fn definition(name: ref String) -> Result[Def, Exc] {
    let want = simplify_name(name);
    let defs = definitions();
    for d in defs {
        if simplify_name(d.name) == want {
            return Ok(d.clone());
        }
    }
    for d in defs {
        if d.identifier == name {
            return Ok(d.clone());
        }
    }
    Err(exc("KeyError", str_repr(f"Unkown CRC name '{name}'")))
}

fn predefined_crc(name: ref String) -> Result[Crc, Exc] {
    let d = definition(name)?;
    new_crc(d.poly, d.init as i128, d.reverse, d.xor_out as i128)
}

// mkPredefinedCrcFun, for names the jobs know are there.
fn known(name: Str) -> Crc {
    match predefined_crc(name.to_string()) {
        Ok(c) => c,
        Err(_) => panic("unknown CRC"),
    }
}

// ------------------------------------------------------------ helpers

fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push_str("\n");
}

fn err_line(e: ref Exc) -> String {
    f"error: {e.kind}: {e.msg}"
}

// str.splitlines() for files whose lines end in \n.
fn lines_of(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for l in s.split("\n") {
        out.push(l.to_string());
    }
    if out.len() > 0 and out[out.len() - 1] == "" {
        out.pop();
    }
    out
}

fn read_bin(rel: ref String) -> Vec[u8] {
    match fs.read_bytes(f"data/{rel}") {
        Ok(b) => b,
        Err(_) => Vec.new(),
    }
}

// data[a:b], clamped the way Python slices are.
fn sub(data: ref Vec[u8], a: i64, b: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = a;
    let end = if b > data.len() { data.len() } else { b };
    while i < end {
        out.push(data[i]);
        i += 1;
    }
    out
}

fn str_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn hex_val(c: u8) -> i64 {
    if c >= b'0' and c <= b'9' {
        (c - b'0') as i64
    } else if c >= b'a' and c <= b'f' {
        (c - b'a') as i64 + 10
    } else {
        (c - b'A') as i64 + 10
    }
}

// bytes.fromhex: pairs of hex digits, spaces between them allowed.
fn unhex(s: ref String) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if c != b' ' {
            digits.push(c);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < digits.len() {
        out.push((hex_val(digits[i]) * 16 + hex_val(digits[i + 1])) as u8);
        i += 2;
    }
    out
}

// The \r \n \t \\ \xNN escapes of streams.txt.
fn unesc(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'\\' {
            let n = b[i + 1];
            if n == b'x' {
                out.push((hex_val(b[i + 2]) * 16 + hex_val(b[i + 3])) as u8);
                i += 4;
                continue;
            }
            let v = if n == b'r' { 13 } else if n == b'n' { 10 } else if n == b't' { 9 } else { 92 };
            out.push(v as u8);
            i += 2;
            continue;
        }
        out.push(c);
        i += 1;
    }
    out
}

// int(s, 0), and ~0 for -1.
fn num(s: ref String) -> i128 {
    if s == "~0" {
        return -1;
    }
    let neg = s.starts_with("-");
    let t = if neg { s[1..].to_string() } else { s.clone() };
    let mut v: i128 = 0;
    if t.starts_with("0x") or t.starts_with("0X") {
        for c in t[2..].bytes() {
            v = v * 16 + hex_val(c) as i128;
        }
    } else {
        for c in t.bytes() {
            v = v * 10 + (c - b'0') as i128;
        }
    }
    if neg { -v } else { v }
}

fn b64_val(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        (c - b'A') as i64
    } else if c >= b'a' and c <= b'z' {
        (c - b'a') as i64 + 26
    } else if c >= b'0' and c <= b'9' {
        (c - b'0') as i64 + 52
    } else if c == b'+' {
        62
    } else if c == b'/' {
        63
    } else {
        -1
    }
}

// base64.b64decode of well-formed, padded input.
fn b64decode(s: ref String) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut acc: i64 = 0;
    let mut bits = 0;
    for c in s.bytes() {
        let v = b64_val(c);
        if v < 0 {
            continue;
        }
        acc = (acc << 6) | v;
        bits += 6;
        if bits >= 8 {
            bits -= 8;
            out.push(((acc >> bits) & 255) as u8);
        }
    }
    out
}

fn be(data: ref Vec[u8], at: i64, n: i64) -> u128 {
    let mut v: u128 = 0;
    for k in 0..n {
        v = (v << 8) | data[at + k] as u128;
    }
    v
}

fn le(data: ref Vec[u8], at: i64, n: i64) -> u128 {
    let mut v: u128 = 0;
    for k in 0..n {
        v = (v << 8) | data[at + n - 1 - k] as u128;
    }
    v
}

fn latin1(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b {
        s.push(char.try_from(*x as u32).unwrap_or('?'));
    }
    s
}

// ------------------------------------------------------------ catalog

fn catalog_job(out: mut ref String) {
    let data = str_bytes("123456789");
    for d in definitions() {
        let mut crc = known(d.name);
        crc.update(data);
        let ok = if crc.crc_value == d.check { "ok" } else { "WRONG" };
        emit(mut out, f"{d.name} ({d.identifier}): poly=0x{hx(d.poly)} reverse={bool_repr(d.reverse)} init=0x{hx(d.init)} xor_out=0x{hx(d.xor_out)} check=0x{hx(crc.crc_value)} {ok} digest={bytes_hex(crc.digest())}");
    }
}

fn custom_job(rel: ref String, out: mut ref String) {
    for line in lines_of(read_text(rel)) {
        let p: Vec[String] = line.split(" ").map(|x| x.to_string()).collect();
        emit(mut out, f"> {line}");
        let made = new_crc(num(p[0]) as u128, num(p[1]), p[2] == "1", num(p[3]));
        let mut crc = match made {
            Ok(c) => c,
            Err(e) => {
                emit(mut out, f"  {err_line(e)}");
                continue;
            }
        };
        let fun = crc.fresh();
        for s in crc.str().split("\n") {
            emit(mut out, f"  {s}");
        }
        emit(mut out, f"  digest_size={crc.digest_size} table[1]=0x{hx(crc.table[1])} table[255]=0x{hx(crc.table[255])}");
        crc.update(str_bytes("123456789"));
        emit(mut out, f"  check=0x{hx(crc.crc_value)} fun=0x{hx(fun.fun(str_bytes("123456789")))} hexdigest={crc.hexdigest()}");
        let first = fun.fun(str_bytes("1234"));
        emit(mut out, f"  continued=0x{hx(fun.fun_from(str_bytes("56789"), first))} empty=0x{hx(fun.fun(Vec.new()))}");
    }
}

fn streams_job(rel: ref String, out: mut ref String) {
    for line in lines_of(read_text(rel)) {
        let p: Vec[String] = line.split("|").map(|x| x.to_string()).collect();
        let name = p[0].clone();
        let data = unesc(p[1]);
        let cuts = p[2].clone();
        let shown = if cuts == "" { "-".to_string() } else { cuts.clone() };
        emit(mut out, f"> {name} {data.len()} bytes, pieces {shown}");
        let mut crc = match predefined_crc(name) {
            Ok(c) => c,
            Err(e) => {
                emit(mut out, f"  {err_line(e)}");
                continue;
            }
        };
        let one = crc.fun(data);
        let mut pos = 0;
        let mut snaps: Vec[String] = Vec.new();
        if cuts != "" {
            for c in cuts.split(",") {
                let n = num(c.to_string()) as i64;
                crc.update(sub(data, pos, pos + n));
                pos += n;
                snaps.push(crc.copy().hexdigest());
            }
        }
        crc.update(sub(data, pos, data.len()));
        let mut fresh = crc.fresh();
        fresh.update(data);
        let same = if one == crc.crc_value and crc.crc_value == fresh.crc_value { "same" } else { "DIFFER" };
        emit(mut out, f"  whole=0x{hx(one)} pieces=0x{hx(crc.crc_value)} new=0x{hx(fresh.crc_value)} {same}");
        emit(mut out, f"  snapshots: {snaps.join(" ")}");
        emit(mut out, f"  digest={bytes_hex(crc.digest())}");
    }
}

fn opt(s: ref String) -> Option[String] {
    if s == "-" { None } else { Some(s.clone()) }
}

fn code_job(crc: ref Crc, name: ref String, dt: ref String, ct: ref String, out: mut ref String) {
    let code = crc.generate_code(name, opt(dt), opt(ct));
    for line in code.split("\n") {
        emit(mut out, f"| {line}");
    }
}

// ------------------------------------------------------------ formats

fn png_job(names: ref Vec[String], out: mut ref String) {
    let crc32 = known("crc-32");
    let magic: Vec[u8] = [137 as u8, 80, 78, 71, 13, 10, 26, 10];
    for name in names {
        let data = read_bin(name);
        emit(mut out, f"{name}: {data.len()} bytes");
        if sub(data, 0, 8) != magic {
            emit(mut out, "  not a PNG");
            continue;
        }
        let mut pos = 8;
        let mut good = true;
        while pos < data.len() {
            if pos + 12 > data.len() {
                emit(mut out, f"  truncated at {pos}");
                good = false;
                break;
            }
            let n = be(data, pos, 4) as i64;
            let kind = latin1(sub(data, pos + 4, pos + 8));
            if pos + 12 + n > data.len() {
                emit(mut out, f"  {kind}: {n} bytes, truncated");
                good = false;
                break;
            }
            let stored = be(data, pos + 8 + n, 4);
            let got = crc32.fun(sub(data, pos + 4, pos + 8 + n));
            let verdict = if got == stored { "ok".to_string() } else { f"BAD (computed {hex_of(got, 8, false)})" };
            emit(mut out, f"  {kind}: {n} bytes, crc {hex_of(stored, 8, false)} {verdict}");
            good = good and got == stored;
            pos += 12 + n;
        }
        emit(mut out, if good { "  ok" } else { "  CORRUPT" });
    }
}

fn gzip_job(names: ref Vec[String], out: mut ref String) {
    let crc32 = known("crc-32");
    for name in names {
        let data = read_bin(name);
        let flags = data[3];
        let mtime = le(data, 4, 4);
        let mut pos = 10;
        if flags & 8 != 0 {
            while data[pos] != 0 {
                pos += 1;
            }
            pos += 1;
        }
        let mut body: Vec[u8] = Vec.new();
        let mut compressed = false;
        loop {
            let hdr = data[pos];
            let last = hdr & 1;
            if (hdr >> 1) & 3 != 0 {
                emit(mut out, f"{name}: compressed blocks are not read here");
                compressed = true;
                break;
            }
            let n = le(data, pos + 1, 2) as i64;
            for b in sub(data, pos + 5, pos + 5 + n) {
                body.push(b);
            }
            pos += 5 + n;
            if last != 0 {
                break;
            }
        }
        if compressed {
            continue;
        }
        let stored = le(data, pos, 4);
        let size = le(data, pos + 4, 4) as i64;
        let got = crc32.fun(body);
        let size_ok = if size == body.len() { "ok" } else { "WRONG" };
        let crc_ok = if got == stored { "ok" } else { "CRC MISMATCH" };
        emit(mut out, f"{name}: mtime={mtime} {body.len()} bytes, crc32 {hex_of(got, 8, false)}, stored {hex_of(stored, 8, false)}, size {size_ok}: {crc_ok}");
    }
}

fn modbus_job(rel: ref String, out: mut ref String) {
    let fun = known("modbus");
    for line in lines_of(read_text(rel)) {
        let frame = unhex(line);
        if frame.len() < 4 {
            emit(mut out, f"{line}: too short");
            continue;
        }
        let body = sub(frame, 0, frame.len() - 2);
        let got = fun.fun(body);
        let stored = le(frame, frame.len() - 2, 2);
        let kind = if body[1] & 128 != 0 {
            f"exception {body[2]}"
        } else {
            f"function {body[1]}, {body.len() - 2} data bytes"
        };
        let verdict = if got == stored { "ok".to_string() } else { f"BAD (want {hex_of(got, 4, true)})" };
        emit(mut out, f"{line}: unit {body[0]} {kind}, crc {hex_of(stored, 4, true)} {verdict}");
    }
}

fn rstrip_pad(b: ref Vec[u8]) -> Vec[u8] {
    let mut n = b.len();
    while n > 0 and b[n - 1] == 26 {
        n -= 1;
    }
    sub(b, 0, n)
}

fn xmodem_job(names: ref Vec[String], out: mut ref String) {
    let fun = known("xmodem");
    let crc32 = known("crc-32");
    for name in names {
        let data = read_bin(name);
        let mut pos = 0;
        let mut good = 0;
        let mut received: Vec[u8] = Vec.new();
        while pos < data.len() {
            if data[pos] == 4 {
                emit(mut out, f"{name}: EOT after {pos / 133} blocks, {good} good, {received.len()} bytes");
                break;
            }
            let blk = data[pos + 1] as i64;
            let comp = data[pos + 2] as i64;
            let block = sub(data, pos + 3, pos + 131);
            let stored = be(data, pos + 131, 2);
            let got = fun.fun(block);
            if blk + comp != 255 {
                emit(mut out, f"  block {blk}: bad sequence complement");
            } else if got != stored {
                emit(mut out, f"  block {blk}: crc {hex_of(stored, 4, true)}, computed {hex_of(got, 4, true)}: NAK");
            } else {
                good += 1;
                for b in block {
                    received.push(b);
                }
                emit(mut out, f"  block {blk}: ok");
            }
            pos += 133;
        }
        let payload = rstrip_pad(received);
        emit(mut out, f"  payload crc-32 {hex_of(crc32.fun(payload), 8, false)}, trailing pad {received.len() - payload.len()}");
    }
}

fn armor_job(names: ref Vec[String], out: mut ref String) {
    let fun = known("crc-24");
    for name in names {
        let lines = lines_of(read_text(name));
        let first = lines[0].clone();
        let kind = first["-----BEGIN PGP ".len()..first.len() - 5].to_string();
        let mut i = 1;
        let mut headers: Vec[String] = Vec.new();
        while lines[i] != "" {
            headers.push(lines[i].clone());
            i += 1;
        }
        let mut body = String.new();
        i += 1;
        while not lines[i].starts_with("=") {
            body.push_str(lines[i]);
            i += 1;
        }
        let data = b64decode(body);
        let sum = b64decode(lines[i][1..].to_string());
        let stored = be(sum, 0, sum.len());
        let got = fun.fun(data);
        let verdict = if got == stored { "ok".to_string() } else { f"BAD (computed {hex_of(got, 6, true)})" };
        emit(mut out, f"{name}: {kind}, {headers.join("; ")}, {data.len()} bytes, crc24 {hex_of(stored, 6, true)} {verdict}");
    }
}

fn family(b: u8) -> String {
    if b == 40 {
        "DS18B20 thermometer".to_string()
    } else if b == 16 {
        "DS18S20 thermometer".to_string()
    } else if b == 1 {
        "DS2401 serial number".to_string()
    } else {
        "unknown".to_string()
    }
}

fn onewire_job(rel: ref String, out: mut ref String) {
    let fun = known("crc-8-maxim");
    for line in lines_of(read_text(rel)) {
        let b = unhex(line);
        let got = fun.fun(sub(b, 0, 7));
        let mut serial = String.new();
        let mut k = 6;
        while k >= 1 {
            serial.push_str(hex_of(b[k] as u128, 2, true));
            k -= 1;
        }
        let ok = if got == b[7] as u128 { "ok" } else { "BAD" };
        emit(mut out, f"{line}: family {hex_of(b[0] as u128, 2, true)} ({family(b[0])}) serial {serial} crc {hex_of(b[7] as u128, 2, true)} {ok}; whole code crc {hex_of(fun.fun(b), 2, true)}");
    }
}

fn count_of(hay: ref Vec[u8], needle: ref Vec[u8]) -> i64 {
    let mut n = 0;
    let mut i = 0;
    while i + needle.len() <= hay.len() {
        if sub(hay, i, i + needle.len()) == *needle {
            n += 1;
            i += needle.len();
        } else {
            i += 1;
        }
    }
    n
}

fn rdb_job(names: ref Vec[String], out: mut ref String) {
    let fun = known("crc-64-jones");
    let needle = str_bytes("user:");
    for name in names {
        let data = read_bin(name);
        let body = sub(data, 0, data.len() - 8);
        let stored = le(data, data.len() - 8, 8);
        let got = fun.fun(body);
        let keys = count_of(body, needle);
        let verdict = if got == stored { "ok".to_string() } else { f"BAD (computed {hex_of(got, 16, false)})" };
        emit(mut out, f"{name}: {latin1(sub(body, 0, 9))}, {keys} keys, crc64 {hex_of(stored, 16, false)} {verdict}");
    }
}

fn rest(job: ref Vec[String]) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for k in 1..job.len() {
        v.push(job[k].clone());
    }
    v
}

fn run_job(job: ref Vec[String], out: mut ref String) {
    let k = job[0].clone();
    if k == "catalog" {
        catalog_job(mut out);
    } else if k == "custom" {
        custom_job(job[1], mut out);
    } else if k == "streams" {
        streams_job(job[1], mut out);
    } else if k == "code" {
        match predefined_crc(job[1]) {
            Ok(c) => code_job(c, job[2], job[3], job[4], mut out),
            Err(e) => emit(mut out, err_line(e)),
        }
    } else if k == "code_custom" {
        match new_crc(num(job[1]) as u128, num(job[2]), job[3] == "1", num(job[4])) {
            Ok(c) => code_job(c, job[5], job[6], job[7], mut out),
            Err(e) => emit(mut out, err_line(e)),
        }
    } else if k == "png" {
        png_job(rest(job), mut out);
    } else if k == "gzip" {
        gzip_job(rest(job), mut out);
    } else if k == "modbus" {
        modbus_job(job[1], mut out);
    } else if k == "xmodem" {
        xmodem_job(rest(job), mut out);
    } else if k == "armor" {
        armor_job(rest(job), mut out);
    } else if k == "onewire" {
        onewire_job(job[1], mut out);
    } else {
        rdb_job(rest(job), mut out);
    }
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())) {
        let job: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        emit(mut out, f"== {job.join(" ")}");
        run_job(job, mut out);
    }
    print(out);
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    v
}

