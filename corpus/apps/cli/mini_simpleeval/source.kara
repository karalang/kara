fn file_shop_pricing_tsv_0(t: mut ref String) {
    t.push_str("subtotal\tround(sum(i.qty * i.price for i in items), 2)\n");
    t.push_str("units\tsum(i.qty for i in items)\n");
    t.push_str("tier_discount\t{'gold': 0.1, 'silver': 0.05}.get(customer.tier, 0)\n");
    t.push_str("coupon_off\t{'SPRING10': 10, 'BULK': 15}[coupon] if coupon else 0\n");
    t.push_str("bulk\tany(i.qty >= 10 for i in items)\n");
    t.push_str("shipping\t0 if shipping.country == 'DE' and not shipping.express else round(4.9 + shipping.weight_kg * 1.2 + (9 if shipping.express else 0), 2)\n");
    t.push_str("eu\tshipping.country in ('DE', 'FR', 'IE', 'NL')\n");
    t.push_str("vat\t{'DE': 0.19, 'FR': 0.2, 'GB': 0.2}[shipping.country]\n");
    t.push_str("loyal\tcustomer.orders >= 10 or customer.tier == 'gold'\n");
    t.push_str("first_sku\titems[0].sku\n");
    t.push_str("cheapest\tmin(i.price for i in items)\n");
    t.push_str("label\tf'{customer.tier.upper()}-{len(items)}-{\"X\" if shipping.express else \"S\"}'\n");
}
