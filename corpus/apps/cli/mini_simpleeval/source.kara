fn file_sheet_tsv_0(t: mut ref String) {
    t.push_str("A1\t1200\n");
    t.push_str("A2\tA1 * 1.05\n");
    t.push_str("A3\tA2 * 1.05\n");
    t.push_str("B1\tround(A1 + A2 + A3, 2)\n");
    t.push_str("B2\tB1 / 3\n");
    t.push_str("C1\t'growth' if A3 > A1 else 'flat'\n");
    t.push_str("C2\tf'{B2:,.2f}'\n");
    t.push_str("D1\tZ9 + 1\n");
    t.push_str("D2\tA1 + undefined_name\n");
    t.push_str("E1\tE2 + 1\n");
    t.push_str("E2\tE1 + 1\n");
    t.push_str("F1\tA2 > A1 and B1\n");
    t.push_str("F2\tA1 + nope + B1\n");
    t.push_str("G1\tC2.replace(',', '')\n");
}

