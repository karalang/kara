    t.push_str("mem\twarning\tmem.used_mb / mem.total_mb > 0.9\n");
    t.push_str("disk\tcritical\tany(p >= 90 for p in disk.values())\n");
    t.push_str("error_rate\tcritical\terrors / requests > 0.01\n");
    t.push_str("replica_lag\twarning\trole == 'replica' and lag_s > 10\n");
    t.push_str("down\tcritical\tnot up\n");
    t.push_str("quiet\tinfo\trequests == 0 and role in ('web', 'primary')\n");
    t.push_str("full_mounts\tinfo\t[m for m, p in disk.items() if p > 85]\n");
}

