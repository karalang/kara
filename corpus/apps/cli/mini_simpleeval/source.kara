    }
    {
        let mut t = String.new();
        file_jobs_tsv_0(mut t);
        file_jobs_tsv_1(mut t);
        file_jobs_tsv_2(mut t);
        file_jobs_tsv_3(mut t);
        v.push(DataFile { path: "jobs.tsv".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_mail_templates_tsv_0(mut t);
        v.push(DataFile { path: "mail/templates.tsv".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_mail_users_json_0(mut t);
        v.push(DataFile { path: "mail/users.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_ops_alerts_tsv_0(mut t);
        v.push(DataFile { path: "ops/alerts.tsv".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_ops_hosts_json_0(mut t);
        v.push(DataFile { path: "ops/hosts.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_sheet_tsv_0(mut t);
        v.push(DataFile { path: "sheet.tsv".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_shop_orders_json_0(mut t);
        v.push(DataFile { path: "shop/orders.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_shop_pricing_tsv_0(mut t);
        v.push(DataFile { path: "shop/pricing.tsv".to_string(), body: t });
    }
    v
}

