// mini_simpleeval: simpleeval 1.0.3 in Kara, the safe expression
// evaluator web apps and rule engines hand user-written formulas to.
// SimpleEval and EvalWithCompoundTypes walk the tree Python's ast.parse
// builds (here the port of CPython 3.13's parser from mini_ast), with
// Python's values and the TypeErrors it raises, simpleeval's limits and
// its exceptions. Jobs evaluate single expressions; the programs price
// orders, fire monitoring alerts, render notification templates and
// compute a spreadsheet whose names are other cells.
// ------------------------------------------------------------ text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

// Text with no surrogates in it, as a String.
fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in s {
        if c < 0x80 {
            out.push(c as u8);
        } else if c < 0x800 {
            out.push((0xC0 | (c >> 6)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else if c < 0x10000 {
            out.push((0xE0 | (c >> 12)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (c >> 18)) as u8);
            out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts_with(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    if p.len() > s.len() {
        return false;
    }
    for i in 0..p.len() {
        if s[i] != p[i] {
            return false;
        }
    }
    true
}

fn hex_n(c: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(c >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_val(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 102 {
        return c - 87;
    }
    if c >= 65 and c <= 70 {
        return c - 55;
    }
    -1
}

fn split_cp(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn split_tabs(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\t' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// the lines of a file, without their \n, as Python's iteration gives
// them
fn text_lines(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn sort_strings(v: mut ref Vec[String]) {
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and v[j] < v[j - 1] {
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn is_surrogate(c: i64) -> bool {
    c >= 0xD800 and c <= 0xDFFF
}

// ------------------------------------------------------------ reprs

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

// repr() of a str
fn repr_of(s: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
    to_string(out)
}

fn pr(s: ref String) -> String {
    repr_of(cps(s))
}

// ------------------------------------------------------------ the tokenizer
//
// A port of Parser/lexer/lexer.c as Python 3.13 runs it for the tokenize
// module (extra tokens on), and of the token building in
// Python/Python-tokenize.c. The source is held whole; `inp` is the end
// of the last line read, as the C readline buffer has it, so line
// numbers and columns come out where the C code puts them.

const EOF: i64 = -1;
const BAD: i64 = -2;

const E_OK: i64 = 0;
const E_EOF: i64 = 1;
const E_DEDENT: i64 = 2;
const E_TABSPACE: i64 = 3;
const E_LINECONT: i64 = 4;
const E_ERROR: i64 = 5;

const T_ERROR: i64 = 0;
const T_NAME: i64 = 1;
const T_NUMBER: i64 = 2;
const T_STRING: i64 = 3;
const T_OP: i64 = 4;
const T_NEWLINE: i64 = 5;
const T_NL: i64 = 6;
const T_COMMENT: i64 = 7;
const T_INDENT: i64 = 8;
const T_DEDENT: i64 = 9;
const T_ENDMARKER: i64 = 10;
const T_FSTART: i64 = 11;
const T_FMIDDLE: i64 = 12;
const T_FEND: i64 = 13;
const T_ENCODING: i64 = 14;

fn type_name(t: i64) -> String {
    let names = vec!["ERRORTOKEN", "NAME", "NUMBER", "STRING", "OP", "NEWLINE", "NL", "COMMENT", "INDENT", "DEDENT", "ENDMARKER", "FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END", "ENCODING"];
    names[t].to_string()
}

// token.EXACT_TOKEN_TYPES
fn exact_name(s: ref String) -> String {
    let table = vec![
        ("!", "EXCLAMATION"), ("!=", "NOTEQUAL"), ("%", "PERCENT"), ("%=", "PERCENTEQUAL"),
        ("&", "AMPER"), ("&=", "AMPEREQUAL"), ("(", "LPAR"), (")", "RPAR"), ("*", "STAR"),
        ("**", "DOUBLESTAR"), ("**=", "DOUBLESTAREQUAL"), ("*=", "STAREQUAL"), ("+", "PLUS"),
        ("+=", "PLUSEQUAL"), (",", "COMMA"), ("-", "MINUS"), ("-=", "MINEQUAL"), ("->", "RARROW"),
        (".", "DOT"), ("...", "ELLIPSIS"), ("/", "SLASH"), ("//", "DOUBLESLASH"),
        ("//=", "DOUBLESLASHEQUAL"), ("/=", "SLASHEQUAL"), (":", "COLON"), (":=", "COLONEQUAL"),
        (";", "SEMI"), ("<", "LESS"), ("<<", "LEFTSHIFT"), ("<<=", "LEFTSHIFTEQUAL"),
        ("<=", "LESSEQUAL"), ("=", "EQUAL"), ("==", "EQEQUAL"), (">", "GREATER"),
        (">=", "GREATEREQUAL"), (">>", "RIGHTSHIFT"), (">>=", "RIGHTSHIFTEQUAL"), ("@", "AT"),
        ("@=", "ATEQUAL"), ("[", "LSQB"), ("]", "RSQB"), ("^", "CIRCUMFLEX"),
        ("^=", "CIRCUMFLEXEQUAL"), ("{", "LBRACE"), ("|", "VBAR"), ("|=", "VBAREQUAL"),
        ("}", "RBRACE"), ("~", "TILDE"),
    ];
    for (k, v) in table {
        if s == k {
            return v.to_string();
        }
    }
    "OP".to_string()
}

fn is_two(a: i64, b: i64) -> bool {
    let s = to_string(vec![a, b]);
    let pairs = vec!["!=", "%=", "&=", "**", "*=", "+=", "-=", "->", "//", "/=", ":=", "<<", "<=", "==", ">=", ">>", "@=", "^=", "|="];
    for p in pairs {
        if s == p {
            return true;
        }
    }
    false
}

fn is_three(a: i64, b: i64, c: i64) -> bool {
    let s = to_string(vec![a, b, c]);
    s == "**=" or s == "//=" or s == "<<=" or s == ">>="
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn is_xdigit(c: i64) -> bool {
    is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

fn is_id_start(c: i64) -> bool {
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 or c >= 128
}

fn is_id_char(c: i64) -> bool {
    is_id_start(c) or is_digit(c)
}

fn lower(c: i64) -> i64 {
    if c >= 65 and c <= 90 { c + 32 } else { c }
}

// One entry of the C tokenizer's mode stack. The bottom entry is the
// regular mode; each f-string pushes one, which flips between reading
// its literal text (`fstring`) and reading an expression.
#[derive(Clone)]
struct Mode {
    fstring: bool,
    quote: i64,
    quote_size: i64,
    raw: bool,
    start: i64,
    multi_line_start: i64,
    line_no: i64,
    depth: i64,
    expr_depth: i64,
    in_spec: bool,
    debug: bool,
}

fn regular_mode() -> Mode {
    Mode { fstring: false, quote: 0, quote_size: 0, raw: false, start: 0, multi_line_start: 0, line_no: 0, depth: 0, expr_depth: 0, in_spec: false, debug: false }
}

#[derive(Clone)]
struct Tok {
    ty: i64,
    text: Vec[i64],
    sr: i64,
    sc: i64,
    er: i64,
    ec: i64,
    scb: i64,
    ecb: i64,
}

#[derive(Clone)]
struct TokErr {
    kind: String,
    msg: String,
    line: i64,
    col: i64,
}

struct Lexed {
    toks: Vec[Tok],
    failed: bool,
    err: TokErr,
}

struct Lx {
    s: Vec[i64],
    n: i64,
    line_ends: Vec[i64],
    implicit: bool,
    implicit_now: bool,
    cur: i64,
    inp: i64,
    buf: i64,
    start: i64,
    lineno: i64,
    line_start: i64,
    first_lineno: i64,
    multi_line_start: i64,
    done: i64,
    atbol: bool,
    level: i64,
    indstack: Vec[i64],
    altindstack: Vec[i64],
    pendin: i64,
    comment_newline: bool,
    modes: Vec[Mode],
    ps: i64,
    pe: i64,
    err: TokErr,
    parse_mode: bool,
    parens: Vec[i64],
    paren_lines: Vec[i64],
    paren_cols: Vec[i64],
}

fn new_lexer(text: ref Vec[i64], parse_mode: bool) -> Lx {
    let mut s = text.clone();
    let mut implicit = false;
    if s.len() > 0 and s[s.len() - 1] != 10 {
        s.push(10);
        implicit = true;
    }
    let mut ends: Vec[i64] = Vec.new();
    for i in 0..s.len() {
        if s[i] == 10 {
            ends.push(i + 1);
        }
    }
    let n = s.len();
    Lx {
        s: s, n: n, line_ends: ends, implicit: implicit, implicit_now: false,
        cur: 0, inp: 0, buf: 0, start: -1, lineno: 0, line_start: 0,
        first_lineno: 0, multi_line_start: 0, done: E_OK, atbol: true, level: 0,
        indstack: vec![0], altindstack: vec![0], pendin: 0, comment_newline: false,
        modes: vec![regular_mode()], ps: -1, pe: -1,
        err: TokErr { kind: String.new(), msg: String.new(), line: 0, col: 0 },
        parse_mode: parse_mode, parens: Vec.new(), paren_lines: Vec.new(), paren_cols: Vec.new(),
    }
}

// tok_nextc: the next character, reading the next line when the current
// one is used up.
fn nextc(lx: mut ref Lx) -> i64 {
    if lx.cur != lx.inp {
        lx.cur += 1;
        return lx.s[lx.cur - 1];
    }
    if lx.done != E_OK {
        return EOF;
    }
    if lx.start < 0 and lx.modes.len() == 1 {
        lx.buf = lx.inp;
    }
    if lx.inp >= lx.n {
        lx.done = E_EOF;
        lx.cur = lx.inp;
        return EOF;
    }
    lx.lineno += 1;
    lx.line_start = lx.cur;
    lx.inp = lx.line_ends[lx.lineno - 1];
    if lx.implicit and lx.lineno == lx.line_ends.len() {
        lx.implicit_now = true;
    }
    lx.cur += 1;
    lx.s[lx.cur - 1]
}

fn backup(lx: mut ref Lx, c: i64) {
    if c != EOF {
        lx.cur -= 1;
    }
}

fn syntax_error(lx: mut ref Lx, msg: own String) -> i64 {
    let col = lx.cur - lx.line_start;
    syntax_error_at(mut lx, msg, col)
}

// The tokenize module reports an unterminated triple-quoted string in
// its own words; the parser keeps the tokenizer's.
fn syntax_error_at(lx: mut ref Lx, msg: own String, col: i64) -> i64 {
    let m = if not lx.parse_mode and msg.starts_with("unterminated triple-quoted string literal") { "EOF in multi-line string".to_string() } else { msg };
    let kind = if lx.parse_mode { "SyntaxError" } else { "TokenError" };
    lx.err = TokErr { kind: kind.to_string(), msg: m, line: lx.lineno, col: col };
    lx.done = E_ERROR;
    T_ERROR
}

fn indent_error(lx: mut ref Lx) -> i64 {
    lx.done = E_TABSPACE;
    lx.cur = lx.inp;
    T_ERROR
}

// tok_continuation_line: a backslash must end its line, and a line must
// follow it.
fn continuation_line(lx: mut ref Lx) -> i64 {
    let mut c = nextc(mut lx);
    if c == 13 {
        c = nextc(mut lx);
    }
    if c != 10 {
        lx.done = E_LINECONT;
        return BAD;
    }
    c = nextc(mut lx);
    if c == EOF {
        lx.done = E_EOF;
        lx.cur = lx.inp;
        return BAD;
    }
    backup(mut lx, c);
    c
}

fn tok_out(lx: mut ref Lx, ty: i64) -> i64 {
    lx.ps = lx.start;
    lx.pe = lx.cur;
    ty
}

// ------------------------------------------------------------ numbers

fn decimal_tail(lx: mut ref Lx) -> i64 {
    loop {
        let mut c = nextc(mut lx);
        while is_digit(c) {
            c = nextc(mut lx);
        }
        if c != 95 {
            return c;
        }
        c = nextc(mut lx);
        if not is_digit(c) {
            backup(mut lx, c);
            syntax_error(mut lx, "invalid decimal literal".to_string());
            return BAD;
        }
    }
}

fn finish_number(lx: mut ref Lx, c: i64) -> i64 {
    backup(mut lx, c);
    tok_out(mut lx, T_NUMBER)
}

fn num_imaginary(lx: mut ref Lx, c: i64) -> i64 {
    if c == 106 or c == 74 {
        let d = nextc(mut lx);
        return finish_number(mut lx, d);
    }
    finish_number(mut lx, c)
}

fn num_exponent(lx: mut ref Lx, e: i64) -> i64 {
    let mut c = nextc(mut lx);
    if c == 43 or c == 45 {
        c = nextc(mut lx);
        if not is_digit(c) {
            backup(mut lx, c);
            return syntax_error(mut lx, "invalid decimal literal".to_string());
        }
    } else if not is_digit(c) {
        backup(mut lx, c);
        backup(mut lx, e);
        return tok_out(mut lx, T_NUMBER);
    }
    c = decimal_tail(mut lx);
    if c == BAD {
        return T_ERROR;
    }
    num_imaginary(mut lx, c)
}

fn num_exp_part(lx: mut ref Lx, c: i64) -> i64 {
    if c == 101 or c == 69 {
        return num_exponent(mut lx, c);
    }
    num_imaginary(mut lx, c)
}

fn num_fraction(lx: mut ref Lx, c0: i64) -> i64 {
    let mut c = c0;
    if is_digit(c) {
        c = decimal_tail(mut lx);
        if c == BAD {
            return T_ERROR;
        }
    }
    num_exp_part(mut lx, c)
}

fn num_after_int(lx: mut ref Lx, c: i64) -> i64 {
    if c == 46 {
        let d = nextc(mut lx);
        return num_fraction(mut lx, d);
    }
    num_exp_part(mut lx, c)
}

fn digit_text(c: i64) -> String {
    to_string(vec![c])
}

// Hex, octal and binary: `bits` names the kind, `ok` says which digits
// it takes.
fn based_number(lx: mut ref Lx, kind: Str, base: i64) -> i64 {
    let mut c = nextc(mut lx);
    loop {
        if c == 95 {
            c = nextc(mut lx);
        }
        if not digit_in(c, base) {
            if base != 16 and is_digit(c) {
                return syntax_error(mut lx, f"invalid digit '{digit_text(c)}' in {kind} literal");
            }
            backup(mut lx, c);
            return syntax_error(mut lx, f"invalid {kind} literal");
        }
        c = nextc(mut lx);
        while digit_in(c, base) {
            c = nextc(mut lx);
        }
        if c != 95 {
            break;
        }
    }
    if base != 16 and is_digit(c) {
        return syntax_error(mut lx, f"invalid digit '{digit_text(c)}' in {kind} literal");
    }
    finish_number(mut lx, c)
}

fn digit_in(c: i64, base: i64) -> bool {
    if base == 16 {
        is_xdigit(c)
    } else {
        c >= 48 and c < 48 + base
    }
}

fn lex_number(lx: mut ref Lx, c0: i64) -> i64 {
    let mut c = c0;
    if c == 48 {
        c = nextc(mut lx);
        if c == 120 or c == 88 {
            return based_number(mut lx, "hexadecimal", 16);
        }
        if c == 111 or c == 79 {
            return based_number(mut lx, "octal", 8);
        }
        if c == 98 or c == 66 {
            return based_number(mut lx, "binary", 2);
        }
        loop {
            if c == 95 {
                c = nextc(mut lx);
                if not is_digit(c) {
                    backup(mut lx, c);
                    return syntax_error(mut lx, "invalid decimal literal".to_string());
                }
            }
            if c != 48 {
                break;
            }
            c = nextc(mut lx);
        }
        let mut nonzero = false;
        if is_digit(c) {
            nonzero = true;
            c = decimal_tail(mut lx);
            if c == BAD {
                return T_ERROR;
            }
        }
        if nonzero and lx.parse_mode and c != 46 and c != 101 and c != 69 and c != 106 and c != 74 {
            backup(mut lx, c);
            let col = lx.start + 1 - lx.line_start;
            return syntax_error_at(mut lx, "leading zeros in decimal integer literals are not permitted; use an 0o prefix for octal integers".to_string(), col);
        }
        return num_after_int(mut lx, c);
    }
    c = decimal_tail(mut lx);
    if c == BAD {
        return T_ERROR;
    }
    num_after_int(mut lx, c)
}

// ------------------------------------------------------------ regular mode

fn get_normal(lx: mut ref Lx) -> i64 {
    // nextline
    lx.start = -1;
    let mut blankline = false;
    if lx.atbol {
        let mut col = 0;
        let mut altcol = 0;
        lx.atbol = false;
        let mut cont_line_col = 0;
        let mut c = 0;
        loop {
            c = nextc(mut lx);
            if c == 32 {
                col += 1;
                altcol += 1;
            } else if c == 9 {
                col = (col / 8 + 1) * 8;
                altcol += 1;
            } else if c == 12 {
                col = 0;
                altcol = 0;
            } else if c == 92 {
                if cont_line_col == 0 {
                    cont_line_col = col;
                }
                if continuation_line(mut lx) == BAD {
                    return T_ERROR;
                }
            } else {
                break;
            }
        }
        backup(mut lx, c);
        if c == 35 or c == 10 or c == 13 {
            blankline = true;
        }
        if not blankline and lx.level == 0 {
            if cont_line_col != 0 {
                col = cont_line_col;
                altcol = cont_line_col;
            }
            let k = lx.indstack.len() - 1;
            if col == lx.indstack[k] {
                if altcol != lx.altindstack[k] {
                    return indent_error(mut lx);
                }
            } else if col > lx.indstack[k] {
                if altcol <= lx.altindstack[k] {
                    return indent_error(mut lx);
                }
                lx.pendin += 1;
                lx.indstack.push(col);
                lx.altindstack.push(altcol);
            } else {
                while lx.indstack.len() > 1 and col < lx.indstack[lx.indstack.len() - 1] {
                    lx.pendin -= 1;
                    lx.indstack.pop();
                    lx.altindstack.pop();
                }
                let j = lx.indstack.len() - 1;
                if col != lx.indstack[j] {
                    lx.done = E_DEDENT;
                    lx.cur = lx.inp;
                    return T_ERROR;
                }
                if altcol != lx.altindstack[j] {
                    return indent_error(mut lx);
                }
            }
        }
    }

    lx.start = lx.cur;
    if lx.pendin != 0 {
        if lx.pendin < 0 {
            lx.pendin += 1;
            lx.ps = lx.cur;
            lx.pe = lx.cur;
            return T_DEDENT;
        }
        lx.pendin -= 1;
        lx.ps = lx.buf;
        lx.pe = lx.cur;
        return T_INDENT;
    }

    let peek = nextc(mut lx);
    backup(mut lx, peek);

    loop {
        // again
        lx.start = -1;
        let mut c = nextc(mut lx);
        while c == 32 or c == 9 or c == 12 {
            c = nextc(mut lx);
        }
        lx.start = lx.cur - 1;

        if c == 35 {
            while c != EOF and c != 10 and c != 13 {
                c = nextc(mut lx);
            }
            let p = lx.start;
            backup(mut lx, c);
            lx.ps = p;
            lx.pe = lx.cur;
            lx.comment_newline = blankline;
            return T_COMMENT;
        }

        if c == EOF {
            if lx.level > 0 {
                return T_ERROR;
            }
            lx.ps = -1;
            lx.pe = -1;
            return if lx.done == E_EOF { T_ENDMARKER } else { T_ERROR };
        }

        // identifiers, and the prefixes of string literals
        let mut go = 0;
        if is_id_start(c) {
            let mut saw_b = false;
            let mut saw_r = false;
            let mut saw_u = false;
            let mut saw_f = false;
            loop {
                if not (saw_b or saw_u or saw_f) and (c == 98 or c == 66) {
                    saw_b = true;
                } else if not (saw_b or saw_u or saw_r or saw_f) and (c == 117 or c == 85) {
                    saw_u = true;
                } else if not (saw_r or saw_u) and (c == 114 or c == 82) {
                    saw_r = true;
                } else if not (saw_f or saw_b or saw_u) and (c == 102 or c == 70) {
                    saw_f = true;
                } else {
                    break;
                }
                c = nextc(mut lx);
                if c == 34 or c == 39 {
                    go = if saw_f { 1 } else { 2 };
                    break;
                }
            }
            if go == 0 {
                while is_id_char(c) {
                    c = nextc(mut lx);
                }
                backup(mut lx, c);
                return tok_out(mut lx, T_NAME);
            }
        }

        if go == 0 {
            if c == 13 {
                c = nextc(mut lx);
            }
            if c == 10 {
                lx.atbol = true;
                if blankline or lx.level > 0 {
                    lx.comment_newline = false;
                    return tok_out(mut lx, T_NL);
                }
                if lx.comment_newline {
                    lx.comment_newline = false;
                    return tok_out(mut lx, T_NL);
                }
                lx.ps = lx.start;
                lx.pe = lx.cur - 1;
                return T_NEWLINE;
            }

            if c == 46 {
                c = nextc(mut lx);
                if is_digit(c) {
                    return num_fraction(mut lx, c);
                }
                if c == 46 {
                    c = nextc(mut lx);
                    if c == 46 {
                        return tok_out(mut lx, T_OP);
                    }
                    backup(mut lx, c);
                    backup(mut lx, 46);
                } else {
                    backup(mut lx, c);
                }
                return tok_out(mut lx, T_OP);
            }

            if is_digit(c) {
                return lex_number(mut lx, c);
            }
        }

        if go == 1 {
            return fstring_start(mut lx, c);
        }

        if c == 39 or c == 34 {
            return lex_string(mut lx, c);
        }

        if c == 92 {
            if continuation_line(mut lx) == BAD {
                return T_ERROR;
            }
            continue;
        }

        return punctuation(mut lx, c);
    }
}

fn fstring_start(lx: mut ref Lx, quote: i64) -> i64 {
    let mut quote_size = 1;
    lx.first_lineno = lx.lineno;
    lx.multi_line_start = lx.line_start;
    let after = nextc(mut lx);
    if after == quote {
        let after2 = nextc(mut lx);
        if after2 == quote {
            quote_size = 3;
        } else {
            backup(mut lx, after2);
            backup(mut lx, after);
        }
    }
    if after != quote {
        backup(mut lx, after);
    }
    lx.ps = lx.start;
    lx.pe = lx.cur;
    let first = lower(lx.s[lx.start]);
    let raw = if first == 102 { lower(lx.s[lx.start + 1]) == 114 } else { true };
    lx.modes.push(Mode {
        fstring: true, quote: quote, quote_size: quote_size, raw: raw, start: lx.start,
        multi_line_start: lx.line_start, line_no: lx.lineno, depth: 0, expr_depth: -1,
        in_spec: false, debug: false,
    });
    T_FSTART
}

fn lex_string(lx: mut ref Lx, quote: i64) -> i64 {
    let mut quote_size = 1;
    let mut end_quote_size = 0;
    let mut has_escaped_quote = false;
    lx.first_lineno = lx.lineno;
    lx.multi_line_start = lx.line_start;
    let mut c = nextc(mut lx);
    if c == quote {
        c = nextc(mut lx);
        if c == quote {
            quote_size = 3;
        } else {
            end_quote_size = 1;
        }
    }
    if c != quote {
        backup(mut lx, c);
    }
    while end_quote_size != quote_size {
        c = nextc(mut lx);
        if c == EOF or (quote_size == 1 and c == 10) {
            lx.cur = lx.start + 1;
            lx.line_start = lx.multi_line_start;
            let at = lx.lineno;
            lx.lineno = lx.first_lineno;
            let top = lx.modes.len() - 1;
            if top > 0 and lx.modes[top].quote == quote and lx.modes[top].quote_size == quote_size {
                return syntax_error(mut lx, "f-string: expecting '}'".to_string());
            }
            if quote_size == 3 {
                return syntax_error(mut lx, f"unterminated triple-quoted string literal (detected at line {at})");
            }
            if has_escaped_quote {
                return syntax_error(mut lx, f"unterminated string literal (detected at line {at}); perhaps you escaped the end quote?");
            }
            return syntax_error(mut lx, f"unterminated string literal (detected at line {at})");
        }
        if c == quote {
            end_quote_size += 1;
        } else {
            end_quote_size = 0;
            if c == 92 {
                c = nextc(mut lx);
                if c == quote {
                    has_escaped_quote = true;
                }
                if c == 13 {
                    c = nextc(mut lx);
                }
            }
        }
    }
    tok_out(mut lx, T_STRING)
}

fn punctuation(lx: mut ref Lx, c: i64) -> i64 {
    let top = lx.modes.len() - 1;
    let inside = top > 0;
    if inside and (c == 58 or c == 125 or c == 33 or c == 123) and lx.modes[top].expr_depth >= 0 {
        let cursor = lx.modes[top].depth - (if c != 123 { 1 } else { 0 });
        if c == 58 and cursor == lx.modes[top].expr_depth {
            lx.modes[top].fstring = true;
            lx.modes[top].in_spec = true;
            return tok_out(mut lx, T_OP);
        }
    }

    let c2 = nextc(mut lx);
    if is_two(c, c2) {
        let c3 = nextc(mut lx);
        if not is_three(c, c2, c3) {
            backup(mut lx, c3);
        }
        return tok_out(mut lx, T_OP);
    }
    backup(mut lx, c2);

    if c == 40 or c == 91 or c == 123 {
        lx.level += 1;
        lx.parens.push(c);
        lx.paren_lines.push(lx.lineno);
        lx.paren_cols.push(lx.start - lx.line_start);
        if inside {
            lx.modes[top].depth += 1;
        }
    } else if c == 41 or c == 93 or c == 125 {
        if inside and lx.modes[top].depth == 0 and c == 125 {
            return syntax_error(mut lx, "f-string: single '}' is not allowed".to_string());
        }
        if lx.parse_mode and lx.level == 0 {
            return syntax_error(mut lx, f"unmatched '{digit_text(c)}'");
        }
        if lx.level > 0 {
            lx.level -= 1;
            let opening = lx.parens.pop().unwrap();
            let line = lx.paren_lines.pop().unwrap();
            lx.paren_cols.pop();
            let fits = (opening == 40 and c == 41) or (opening == 91 and c == 93) or (opening == 123 and c == 125);
            if lx.parse_mode and not fits {
                if inside and opening == 123 and lx.modes[top].depth - 1 == lx.modes[top].expr_depth {
                    return syntax_error(mut lx, f"f-string: unmatched '{digit_text(c)}'");
                }
                if line != lx.lineno {
                    return syntax_error(mut lx, f"closing parenthesis '{digit_text(c)}' does not match opening parenthesis '{digit_text(opening)}' on line {line}");
                }
                return syntax_error(mut lx, f"closing parenthesis '{digit_text(c)}' does not match opening parenthesis '{digit_text(opening)}'");
            }
        }
        if inside {
            lx.modes[top].depth -= 1;
            if lx.modes[top].depth < 0 {
                return syntax_error(mut lx, f"f-string: unmatched '{digit_text(c)}'");
            }
            if c == 125 and lx.modes[top].depth == lx.modes[top].expr_depth {
                lx.modes[top].expr_depth -= 1;
                lx.modes[top].fstring = true;
                lx.modes[top].in_spec = false;
                lx.modes[top].debug = false;
            }
        }
    }

    if not is_printable(c) {
        return syntax_error(mut lx, f"invalid non-printable character U+{hex_n(c, 4).to_uppercase()}");
    }
    if c == 61 and inside and lx.modes[top].expr_depth >= 0 {
        lx.modes[top].debug = true;
    }
    tok_out(mut lx, T_OP)
}

// ------------------------------------------------------------ f-string mode

fn get_fstring(lx: mut ref Lx) -> i64 {
    let top = lx.modes.len() - 1;
    lx.start = lx.cur;
    lx.first_lineno = lx.lineno;

    let start_char = nextc(mut lx);
    if start_char == 123 {
        let peek1 = nextc(mut lx);
        backup(mut lx, peek1);
        backup(mut lx, start_char);
        if peek1 != 123 {
            lx.modes[top].expr_depth += 1;
            lx.modes[top].fstring = false;
            return get_normal(mut lx);
        }
    } else {
        backup(mut lx, start_char);
    }

    let q = lx.modes[top].quote;
    let qs = lx.modes[top].quote_size;
    let mut at_end = true;
    for _ in 0..qs {
        let c = nextc(mut lx);
        if c != q {
            backup(mut lx, c);
            at_end = false;
            break;
        }
    }
    if at_end {
        lx.ps = lx.start;
        lx.pe = lx.cur;
        lx.modes.pop();
        return T_FEND;
    }

    lx.multi_line_start = lx.line_start;
    let mut end_quote_size = 0;
    let mut unicode_escape = false;
    while end_quote_size != qs {
        let c = nextc(mut lx);
        let in_spec = lx.modes[top].in_spec and lx.modes[top].expr_depth >= 0;
        if c == EOF or (qs == 1 and c == 10) {
            if in_spec and c == 10 {
                if qs == 1 {
                    return syntax_error(mut lx, "f-string: newlines are not allowed in format specifiers for single quoted f-strings".to_string());
                }
                backup(mut lx, c);
                lx.modes[top].fstring = false;
                lx.modes[top].in_spec = false;
                return tok_out(mut lx, T_FMIDDLE);
            }
            lx.cur = lx.modes[top].start + 1;
            lx.line_start = lx.modes[top].multi_line_start;
            let at = lx.lineno;
            lx.lineno = lx.modes[top].line_no;
            if qs == 3 {
                return syntax_error(mut lx, f"unterminated triple-quoted f-string literal (detected at line {at})");
            }
            return syntax_error(mut lx, f"unterminated f-string literal (detected at line {at})");
        }
        if c == q {
            end_quote_size += 1;
            continue;
        }
        end_quote_size = 0;
        if c == 123 {
            let peek = nextc(mut lx);
            if peek != 123 or in_spec {
                backup(mut lx, peek);
                backup(mut lx, c);
                lx.modes[top].expr_depth += 1;
                lx.modes[top].fstring = false;
                lx.modes[top].in_spec = false;
                return tok_out(mut lx, T_FMIDDLE);
            }
            lx.ps = lx.start;
            lx.pe = lx.cur - 1;
            return T_FMIDDLE;
        } else if c == 125 {
            if unicode_escape {
                return tok_out(mut lx, T_FMIDDLE);
            }
            let peek = nextc(mut lx);
            if peek == 125 and not in_spec and lx.modes[top].depth == 0 {
                lx.ps = lx.start;
                lx.pe = lx.cur - 1;
                return T_FMIDDLE;
            }
            backup(mut lx, peek);
            backup(mut lx, c);
            lx.modes[top].fstring = false;
            lx.modes[top].in_spec = false;
            return tok_out(mut lx, T_FMIDDLE);
        } else if c == 92 {
            let mut peek = nextc(mut lx);
            if peek == 13 {
                peek = nextc(mut lx);
            }
            if peek == 123 or peek == 125 {
                backup(mut lx, peek);
                continue;
            }
            if not lx.modes[top].raw and peek == 78 {
                peek = nextc(mut lx);
                if peek == 123 {
                    unicode_escape = true;
                } else {
                    backup(mut lx, peek);
                }
            }
        }
    }
    for _ in 0..qs {
        backup(mut lx, q);
    }
    tok_out(mut lx, T_FMIDDLE)
}

fn tok_get(lx: mut ref Lx) -> i64 {
    let top = lx.modes.len() - 1;
    if lx.modes[top].fstring {
        get_fstring(mut lx)
    } else {
        get_normal(mut lx)
    }
}

// ------------------------------------------------------------ tokens

// The token as Python-tokenize.c builds it: string literals take their
// start line from where they began, the end is on the last line read,
// and the tokens at the end of the file go on the line after it.
fn make_tok(lx: ref Lx, ty: i64) -> Tok {
    let trailing = ty == T_ENDMARKER or (ty == T_DEDENT and lx.done == E_EOF);
    let mut text: Vec[i64] = if lx.ps < 0 { Vec.new() } else { slice(lx.s, lx.ps, lx.pe) };
    let strlit = ty == T_STRING or ty == T_FMIDDLE;
    let ls = if strlit { lx.multi_line_start } else { lx.line_start };
    let mut sr = if strlit { lx.first_lineno } else { lx.lineno };
    let mut er = lx.lineno;
    let mut sc = if lx.ps >= 0 and lx.ps >= ls { lx.ps - ls } else { -1 };
    let mut ec = if lx.pe >= 0 and lx.pe >= lx.line_start { lx.pe - lx.line_start } else { -1 };
    let mut scb = if sc >= 0 { utf8_width(lx.s, ls, lx.ps) } else { -1 };
    let mut ecb = if ec >= 0 { utf8_width(lx.s, lx.line_start, lx.pe) } else { -1 };
    if trailing {
        sr += 1;
        er = sr;
        sc = 0;
        ec = 0;
        scb = 0;
        ecb = 0;
    }
    if ty == T_NEWLINE {
        if not lx.implicit_now {
            text = if lx.s[lx.start] == 13 { cp("\r\n") } else { cp("\n") };
        }
        ec += 1;
        ecb += 1;
    } else if ty == T_NL and lx.implicit_now {
        text = Vec.new();
    }
    Tok { ty: ty, text: text, sr: sr, sc: sc, er: er, ec: ec, scb: scb, ecb: ecb }
}

// _tokenizer_error, for the errors that are not syntax errors
fn state_error(lx: ref Lx) -> TokErr {
    if lx.done == E_ERROR {
        return lx.err.clone();
    }
    let col = if lx.inp - lx.buf < 0 { 0 } else { lx.inp - lx.buf };
    if lx.done == E_EOF {
        return TokErr { kind: "TokenError".to_string(), msg: "unexpected EOF in multi-line statement".to_string(), line: lx.lineno, col: col };
    }
    if lx.done == E_DEDENT {
        return TokErr { kind: "IndentationError".to_string(), msg: "unindent does not match any outer indentation level".to_string(), line: lx.lineno, col: col };
    }
    if lx.done == E_TABSPACE {
        return TokErr { kind: "TabError".to_string(), msg: "inconsistent use of tabs and spaces in indentation".to_string(), line: lx.lineno, col: col };
    }
    if lx.done == E_LINECONT {
        return TokErr { kind: "TokenError".to_string(), msg: "unexpected character after line continuation character".to_string(), line: lx.lineno, col: col };
    }
    TokErr { kind: "TokenError".to_string(), msg: "unknown tokenization error".to_string(), line: lx.lineno, col: col }
}

// How many bytes s[from..to] takes in UTF-8.
fn utf8_width(s: ref Vec[i64], from: i64, to: i64) -> i64 {
    let mut n = 0;
    let mut i = from;
    while i < to {
        let c = s[i];
        n += if c < 0x80 { 1 } else if c < 0x800 { 2 } else if c < 0x10000 { 3 } else { 4 };
        i += 1;
    }
    n
}

// ------------------------------------------------------------ the tree
//
// The nodes live in one arena and refer to each other by index. A node
// has its type name and its fields in the order of the class's _fields,
// so that dump can walk them as they are; a field is a child, a list of
// children (-1 for a None in it), an identifier, an int, a constant, a
// list of identifiers, or absent.

const K_NODE: i64 = 0;
const K_LIST: i64 = 1;
const K_STR: i64 = 2;
const K_INT: i64 = 3;
const K_NONE: i64 = 4;
const K_CONST: i64 = 5;
const K_STRS: i64 = 6;

#[derive(Clone)]
struct Fld {
    name: String,
    k: i64,
    kids: Vec[i64],
    s: String,
    n: i64,
    strs: Vec[String],
}

#[derive(Clone)]
struct N {
    ty: String,
    f: Vec[Fld],
    pos: bool,
    l1: i64,
    c1: i64,
    l2: i64,
    c2: i64,
}

// The kinds of constant: the value a Constant node holds.
const C_INT: i64 = 0;
const C_FLOAT: i64 = 1;
const C_COMPLEX: i64 = 2;
const C_STR: i64 = 3;
const C_BYTES: i64 = 4;
const C_TRUE: i64 = 5;
const C_FALSE: i64 = 6;
const C_NONE: i64 = 7;
const C_ELL: i64 = 8;

// An int is its decimal digits, with a sign when it is negative; a
// float or a complex's imaginary part is `x`; a str or bytes is `s`.
#[derive(Clone)]
struct Cv {
    ck: i64,
    s: Vec[i64],
    num: String,
    x: f64,
}

struct Ast {
    nodes: Vec[N],
    consts: Vec[Cv],
}

fn new_ast() -> Ast {
    Ast { nodes: Vec.new(), consts: Vec.new() }
}

fn cv_of(ck: i64) -> Cv {
    Cv { ck: ck, s: Vec.new(), num: String.new(), x: 0.0 }
}

fn mk(a: mut ref Ast, ty: Str) -> i64 {
    a.nodes.push(N { ty: ty.to_string(), f: Vec.new(), pos: false, l1: 0, c1: 0, l2: 0, c2: 0 });
    a.nodes.len() - 1
}

fn new_fld(name: Str, k: i64) -> Fld {
    Fld { name: name.to_string(), k: k, kids: Vec.new(), s: String.new(), n: 0, strs: Vec.new() }
}

fn add_node(a: mut ref Ast, id: i64, name: Str, child: i64) {
    if child < 0 {
        a.nodes[id].f.push(new_fld(name, K_NONE));
    } else {
        let mut f = new_fld(name, K_NODE);
        f.kids.push(child);
        a.nodes[id].f.push(f);
    }
}

fn add_list(a: mut ref Ast, id: i64, name: Str, kids: ref Vec[i64]) {
    let mut f = new_fld(name, K_LIST);
    f.kids = kids.clone();
    a.nodes[id].f.push(f);
}

fn add_str(a: mut ref Ast, id: i64, name: Str, s: ref String) {
    let mut f = new_fld(name, K_STR);
    f.s = s.clone();
    a.nodes[id].f.push(f);
}

fn add_none(a: mut ref Ast, id: i64, name: Str) {
    a.nodes[id].f.push(new_fld(name, K_NONE));
}

fn add_int(a: mut ref Ast, id: i64, name: Str, n: i64) {
    let mut f = new_fld(name, K_INT);
    f.n = n;
    a.nodes[id].f.push(f);
}

fn add_strs(a: mut ref Ast, id: i64, name: Str, v: ref Vec[String]) {
    let mut f = new_fld(name, K_STRS);
    f.strs = v.clone();
    a.nodes[id].f.push(f);
}

fn set_pos(a: mut ref Ast, id: i64, l1: i64, c1: i64, l2: i64, c2: i64) {
    a.nodes[id].pos = true;
    a.nodes[id].l1 = l1;
    a.nodes[id].c1 = c1;
    a.nodes[id].l2 = l2;
    a.nodes[id].c2 = c2;
}

fn copy_pos(a: mut ref Ast, to: i64, from: i64) {
    let l1 = a.nodes[from].l1;
    let c1 = a.nodes[from].c1;
    let l2 = a.nodes[from].l2;
    let c2 = a.nodes[from].c2;
    set_pos(mut a, to, l1, c1, l2, c2);
}

fn is(a: ref Ast, id: i64, ty: Str) -> bool {
    id >= 0 and a.nodes[id].ty == ty
}

fn ty_of(a: ref Ast, id: i64) -> String {
    a.nodes[id].ty.clone()
}

fn field_at(a: ref Ast, id: i64, name: Str) -> i64 {
    let n = ref a.nodes[id];
    let mut k = 0;
    while k < n.f.len() {
        if n.f[k].name == name {
            return k;
        }
        k += 1;
    }
    -1
}

// The child in a node field, or -1 when it is None.
fn kid(a: ref Ast, id: i64, name: Str) -> i64 {
    let k = field_at(a, id, name);
    if k < 0 or a.nodes[id].f[k].k != K_NODE {
        return -1;
    }
    a.nodes[id].f[k].kids[0]
}

fn kids(a: ref Ast, id: i64, name: Str) -> Vec[i64] {
    let k = field_at(a, id, name);
    if k < 0 or a.nodes[id].f[k].k != K_LIST {
        return Vec.new();
    }
    a.nodes[id].f[k].kids.clone()
}

fn sval(a: ref Ast, id: i64, name: Str) -> String {
    let k = field_at(a, id, name);
    if k < 0 or a.nodes[id].f[k].k != K_STR {
        return String.new();
    }
    a.nodes[id].f[k].s.clone()
}

fn has_str(a: ref Ast, id: i64, name: Str) -> bool {
    let k = field_at(a, id, name);
    k >= 0 and a.nodes[id].f[k].k == K_STR
}

fn ival(a: ref Ast, id: i64, name: Str) -> i64 {
    let k = field_at(a, id, name);
    if k < 0 {
        return 0;
    }
    a.nodes[id].f[k].n
}

fn strs(a: ref Ast, id: i64, name: Str) -> Vec[String] {
    let k = field_at(a, id, name);
    if k < 0 {
        return Vec.new();
    }
    a.nodes[id].f[k].strs.clone()
}

fn set_kid(a: mut ref Ast, id: i64, name: Str, child: i64) {
    let k = field_at(a, id, name);
    a.nodes[id].f[k].k = K_NODE;
    a.nodes[id].f[k].kids = vec![child];
}

fn set_kids(a: mut ref Ast, id: i64, name: Str, v: ref Vec[i64]) {
    let k = field_at(a, id, name);
    a.nodes[id].f[k].kids = v.clone();
}

// The constant a Constant node holds.
fn cv(a: ref Ast, id: i64) -> Cv {
    let k = field_at(a, id, "value");
    a.consts[a.nodes[id].f[k].n].clone()
}

fn const_kind(a: ref Ast, id: i64) -> i64 {
    let k = field_at(a, id, "value");
    a.consts[a.nodes[id].f[k].n].ck
}

// A node with no fields: an expression context or an operator.
fn leaf(a: mut ref Ast, ty: Str) -> i64 {
    mk(mut a, ty)
}

fn constant(a: mut ref Ast, v: own Cv, kind_u: bool) -> i64 {
    let id = mk(mut a, "Constant");
    a.consts.push(v);
    let mut f = new_fld("value", K_CONST);
    f.n = a.consts.len() - 1;
    a.nodes[id].f.push(f);
    if kind_u {
        add_str(mut a, id, "kind", "u".to_string());
    } else {
        add_none(mut a, id, "kind");
    }
    id
}

fn str_const(a: mut ref Ast, s: ref Vec[i64]) -> i64 {
    let mut v = cv_of(C_STR);
    v.s = s.clone();
    constant(mut a, v, false)
}

fn name_node(a: mut ref Ast, id: ref String, ctx: Str) -> i64 {
    let n = mk(mut a, "Name");
    add_str(mut a, n, "id", id);
    let c = leaf(mut a, ctx);
    add_node(mut a, n, "ctx", c);
    n
}

// ------------------------------------------------------------ reprs

// The imaginary part as complex's repr writes it: no `.0` on a whole
// number.
fn imag_repr(x: f64) -> String {
    let s = float_repr(x);
    if s.ends_with(".0") {
        let v = cps(s);
        return to_string(slice(v, 0, v.len() - 2));
    }
    s
}

fn bytes_repr(s: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(98);
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c >= 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    to_string(out)
}

fn const_repr(v: ref Cv) -> String {
    if v.ck == C_INT {
        v.num.clone()
    } else if v.ck == C_FLOAT {
        float_repr(v.x)
    } else if v.ck == C_COMPLEX {
        f"{imag_repr(v.x)}j"
    } else if v.ck == C_STR {
        repr_of(v.s)
    } else if v.ck == C_BYTES {
        bytes_repr(v.s)
    } else if v.ck == C_TRUE {
        "True".to_string()
    } else if v.ck == C_FALSE {
        "False".to_string()
    } else if v.ck == C_NONE {
        "None".to_string()
    } else {
        "Ellipsis".to_string()
    }
}

// ------------------------------------------------------------ dump

// ast.dump: fields that are None or empty lists are left out, except a
// Constant's value; with `attrs`, the positions follow.
fn dump(a: ref Ast, id: i64, attrs: bool) -> String {
    if id < 0 {
        return "None".to_string();
    }
    let n = ref a.nodes[id];
    let mut parts: Vec[String] = Vec.new();
    let mut k = 0;
    while k < n.f.len() {
        let f = ref n.f[k];
        k += 1;
        if f.k == K_NONE {
            continue;
        }
        if f.k == K_NODE {
            parts.push(f"{f.name}={dump(a, f.kids[0], attrs)}");
        } else if f.k == K_LIST {
            if f.kids.len() == 0 {
                continue;
            }
            let mut items: Vec[String] = Vec.new();
            for c in f.kids {
                items.push(dump(a, c, attrs));
            }
            parts.push(f"{f.name}=[{join(items, ", ")}]");
        } else if f.k == K_STR {
            parts.push(f"{f.name}={pr(f.s)}");
        } else if f.k == K_INT {
            parts.push(f"{f.name}={f.n}");
        } else if f.k == K_CONST {
            parts.push(f"{f.name}={const_repr(a.consts[f.n])}");
        } else {
            if f.strs.len() == 0 {
                continue;
            }
            let mut items: Vec[String] = Vec.new();
            for s in f.strs {
                items.push(pr(s));
            }
            parts.push(f"{f.name}=[{join(items, ", ")}]");
        }
    }
    if attrs and n.pos {
        parts.push(f"lineno={n.l1}");
        parts.push(f"col_offset={n.c1}");
        parts.push(f"end_lineno={n.l2}");
        parts.push(f"end_col_offset={n.c2}");
    }
    f"{n.ty}({join(parts, ", ")})"
}

fn join(v: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for s in v {
        if not first {
            out.push_str(sep);
        }
        first = false;
        out.push_str(s);
    }
    out
}

// The children of a node, in field order, as ast.iter_child_nodes
// gives them.
fn children(a: ref Ast, id: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let n = ref a.nodes[id];
    let mut k = 0;
    while k < n.f.len() {
        let f = ref n.f[k];
        if f.k == K_NODE or f.k == K_LIST {
            for c in f.kids {
                if c >= 0 {
                    out.push(c);
                }
            }
        }
        k += 1;
    }
    out
}

// ast.walk: breadth first from the node.
fn walk(a: ref Ast, id: i64) -> Vec[i64] {
    let mut out: Vec[i64] = vec![id];
    let mut i = 0;
    while i < out.len() {
        let next = children(a, out[i]);
        for c in next {
            out.push(c);
        }
        i += 1;
    }
    out
}

// ------------------------------------------------------------ literals

// A str or bytes literal as the parser decodes it: the prefix, the
// quotes, and the escapes unless it is raw. `is_u` says it had a u
// prefix.
struct Lit {
    bytes: bool,
    is_u: bool,
    raw: bool,
    body: Vec[i64],
}

fn split_literal(t: ref Vec[i64]) -> Lit {
    let mut i = 0;
    let mut bytes = false;
    let mut raw = false;
    let mut is_u = false;
    while t[i] != 39 and t[i] != 34 {
        let c = lower(t[i]);
        if c == 98 {
            bytes = true;
        } else if c == 114 {
            raw = true;
        } else if c == 117 {
            is_u = true;
        }
        i += 1;
    }
    let q = t[i];
    let size = if i + 2 < t.len() and t[i + 1] == q and t[i + 2] == q and t.len() - i >= 6 { 3 } else { 1 };
    let body = slice(t, i + size, t.len() - size);
    Lit { bytes: bytes, is_u: is_u, raw: raw, body: body }
}

// decode_unicode_with_escapes and its bytes twin. An escape Python does
// not know stays as it is, backslash and all.
fn decode_escapes(s: ref Vec[i64], bytes: bool) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    let end = s.len();
    while i < end {
        let c = s[i];
        if c != 92 or i + 1 >= end {
            out.push(c);
            i += 1;
            continue;
        }
        let e = s[i + 1];
        i += 2;
        if e == 110 {
            out.push(10);
        } else if e == 116 {
            out.push(9);
        } else if e == 114 {
            out.push(13);
        } else if e == 97 {
            out.push(7);
        } else if e == 98 {
            out.push(8);
        } else if e == 102 {
            out.push(12);
        } else if e == 118 {
            out.push(11);
        } else if e >= 48 and e <= 55 {
            let mut x = e - 48;
            let mut k = 0;
            while k < 2 and i < end and s[i] >= 48 and s[i] <= 55 {
                x = x * 8 + s[i] - 48;
                i += 1;
                k += 1;
            }
            out.push(if bytes { x & 0xFF } else { x });
        } else if e == 120 or (not bytes and (e == 117 or e == 85)) {
            let count = if e == 120 { 2 } else if e == 117 { 4 } else { 8 };
            let mut x = 0;
            for _ in 0..count {
                if i < end {
                    x = x * 16 + hex_val(s[i]);
                }
                i += 1;
            }
            out.push(x);
        } else if e == 92 or e == 39 or e == 34 {
            out.push(e);
        } else if e == 10 {
            // a line continuation inside the literal
        } else {
            out.push(92);
            out.push(e);
        }
    }
    out
}

fn decode_literal(t: ref Vec[i64]) -> Lit {
    let mut l = split_literal(t);
    if not l.raw {
        l.body = decode_escapes(l.body, l.bytes);
    }
    l
}

// ------------------------------------------------------------ numbers

// The digits of `digits` in `base`, as a decimal string.
fn to_decimal(digits: ref Vec[i64], base: i64) -> String {
    let mut d: Vec[i64] = vec![0];
    for c in digits {
        let mut carry = hex_val(c);
        let mut i = 0;
        while i < d.len() {
            let t = d[i] * base + carry;
            d[i] = t % 10;
            carry = t / 10;
            i += 1;
        }
        while carry > 0 {
            d.push(carry % 10);
            carry = carry / 10;
        }
    }
    while d.len() > 1 and d[d.len() - 1] == 0 {
        d.pop();
    }
    let mut out = String.new();
    let mut i = d.len() - 1;
    while i >= 0 {
        out.push_str(f"{d[i]}");
        i -= 1;
    }
    out
}

// A NUMBER token as a constant.
fn number_value(text: ref Vec[i64]) -> Cv {
    let mut t: Vec[i64] = Vec.new();
    for c in text {
        if c != 95 {
            t.push(c);
        }
    }
    if t.len() > 1 and t[0] == 48 {
        let b = lower(t[1]);
        let base = if b == 120 { 16 } else if b == 111 { 8 } else if b == 98 { 2 } else { 0 };
        if base > 0 {
            let mut v = cv_of(C_INT);
            v.num = to_decimal(slice(t, 2, t.len()), base);
            return v;
        }
    }
    let last = lower(t[t.len() - 1]);
    if last == 106 {
        let mut v = cv_of(C_COMPLEX);
        v.x = parse_float(slice(t, 0, t.len() - 1));
        return v;
    }
    for c in t {
        if c == 46 or c == 101 or c == 69 {
            let mut v = cv_of(C_FLOAT);
            v.x = parse_float(t);
            return v;
        }
    }
    let mut v = cv_of(C_INT);
    v.num = to_decimal(t, 10);
    v
}

fn parse_float(t: ref Vec[i64]) -> f64 {
    match f64.parse(to_string(t)) {
        Ok(x) => x,
        Err(_) => 0.0,
    }
}

// ------------------------------------------------------------ the parser
//
// A recursive-descent port of the PEG grammar of Python 3.13
// (Grammar/python.gram) for the statements and expressions in it other
// than match and type parameters. Tokens come from the lexer above in
// its parse mode, one at a time as the parser asks for them, so a
// tokenizer error surfaces when the parser first looks at the token, as
// it does in CPython.
//
// Errors are sticky: the first one wins, except that a specific message
// (one of the grammar's invalid_* rules) replaces a plain "invalid
// syntax". The plain one names the furthest token the parser looked at,
// as the first pass of the C parser does.

#[derive(Clone)]
struct Pt {
    ty: i64,
    s: String,
    text: Vec[i64],
    l1: i64,
    c1: i64,
    b1: i64,
    l2: i64,
    b2: i64,
    a1: i64,
    a2: i64,
    cur_col: i64,
}

struct P {
    lx: Lx,
    toks: Vec[Pt],
    pos: i64,
    lexdone: bool,
    ast: Ast,
    ek: i64,
    etype: String,
    emsg: String,
    eline: i64,
    ecol: i64,
    gen_tok: i64,
}

const EK_NONE: i64 = 0;
const EK_GENERIC: i64 = 1;
const EK_SPECIFIC: i64 = 2;
const EK_TOKEN: i64 = 3;

fn new_parser(src: ref Vec[i64]) -> P {
    P {
        lx: new_lexer(src, true), toks: Vec.new(), pos: 0, lexdone: false, ast: new_ast(),
        ek: EK_NONE, etype: String.new(), emsg: String.new(), eline: 0, ecol: 0, gen_tok: 0,
    }
}

fn is_keyword(s: ref String) -> bool {
    let kws = vec!["False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield"];
    for k in kws {
        if s == k {
            return true;
        }
    }
    false
}

// The token the tokenizer fails on, with the error it raises: what
// _PyPegen_tokenizer_error makes of the tokenizer's state.
fn tokenizer_error(p: mut ref P) {
    let lx = ref p.lx;
    let mut etype = "SyntaxError".to_string();
    let mut msg = String.new();
    let mut line = lx.lineno;
    let mut col = 0;
    if lx.done == E_ERROR {
        etype = lx.err.kind.clone();
        msg = lx.err.msg.clone();
        line = lx.err.line;
        col = lx.err.col;
    } else if lx.done == E_EOF {
        if lx.level > 0 {
            let k = lx.parens.len() - 1;
            msg = f"'{digit_text(lx.parens[k])}' was never closed";
            line = lx.paren_lines[k];
            col = lx.paren_cols[k] + 1;
        } else {
            msg = "unexpected EOF while parsing".to_string();
        }
    } else if lx.done == E_DEDENT {
        etype = "IndentationError".to_string();
        msg = "unindent does not match any outer indentation level".to_string();
        col = lx.cur - lx.line_start;
    } else if lx.done == E_TABSPACE {
        etype = "TabError".to_string();
        msg = "inconsistent use of tabs and spaces in indentation".to_string();
        col = 1;
    } else if lx.done == E_LINECONT {
        msg = "unexpected character after line continuation character".to_string();
        col = lx.cur - lx.buf;
    } else {
        msg = "unknown parsing error".to_string();
    }
    p.ek = EK_TOKEN;
    p.etype = etype;
    p.emsg = msg;
    p.eline = line;
    p.ecol = col;
}

fn fetch(p: mut ref P) {
    if p.lexdone {
        let last = p.toks[p.toks.len() - 1].clone();
        p.toks.push(last);
        return;
    }
    loop {
        let ty = tok_get(mut p.lx);
        if ty == T_COMMENT or ty == T_NL {
            continue;
        }
        let cur_col = p.lx.cur - p.lx.line_start;
        if ty == T_ERROR {
            if p.ek != EK_TOKEN {
                tokenizer_error(mut p);
            }
            p.lexdone = true;
            p.toks.push(Pt { ty: T_ERROR, s: String.new(), text: Vec.new(), l1: p.lx.lineno, c1: -1, b1: -1, l2: p.lx.lineno, b2: -1, a1: 0, a2: 0, cur_col: cur_col });
            return;
        }
        let t = make_tok(p.lx, ty);
        let s = to_string(t.text);
        let mut pt = Pt { ty: ty, s: s, text: t.text, l1: t.sr, c1: t.sc, b1: t.scb, l2: t.er, b2: t.ecb, a1: p.lx.ps, a2: p.lx.pe, cur_col: cur_col };
        if ty == T_INDENT or ty == T_DEDENT or ty == T_ENDMARKER {
            pt.l1 = p.lx.lineno;
            pt.l2 = p.lx.lineno;
            pt.c1 = -1;
            pt.b1 = -1;
            pt.b2 = -1;
        }
        p.toks.push(pt);
        if ty == T_ENDMARKER {
            p.lexdone = true;
        }
        return;
    }
}

fn ti(p: mut ref P, k: i64) -> i64 {
    let i = p.pos + k;
    while i >= p.toks.len() {
        fetch(mut p);
    }
    i
}

fn tty(p: mut ref P, k: i64) -> i64 {
    let i = ti(mut p, k);
    p.toks[i].ty
}

fn is_op(p: mut ref P, k: i64, s: Str) -> bool {
    let i = ti(mut p, k);
    p.toks[i].ty == T_OP and p.toks[i].s == s
}

fn is_kw(p: mut ref P, k: i64, s: Str) -> bool {
    let i = ti(mut p, k);
    p.toks[i].ty == T_NAME and p.toks[i].s == s
}

fn is_name(p: mut ref P, k: i64) -> bool {
    let i = ti(mut p, k);
    p.toks[i].ty == T_NAME and not is_keyword(p.toks[i].s)
}

fn tok_text(p: mut ref P, k: i64) -> String {
    let i = ti(mut p, k);
    p.toks[i].s.clone()
}

fn adv(p: mut ref P) {
    p.pos += 1;
}

// ------------------------------------------------------------ errors

fn failed(p: ref P) -> bool {
    p.ek != EK_NONE
}

// A plain "invalid syntax": it names the furthest token looked at.
fn fail(p: mut ref P) -> i64 {
    if p.ek == EK_NONE {
        p.ek = EK_GENERIC;
        p.gen_tok = p.toks.len() - 1;
    }
    -1
}

fn raise_at(p: mut ref P, etype: Str, msg: own String, line: i64, col: i64) -> i64 {
    if p.ek == EK_NONE or p.ek == EK_GENERIC {
        p.ek = EK_SPECIFIC;
        p.etype = etype.to_string();
        p.emsg = msg;
        p.eline = line;
        p.ecol = col;
    }
    -1
}

// The column a token's error names, one-based, in characters.
fn tok_err_col(p: ref P, i: i64) -> i64 {
    if p.toks[i].c1 < 0 { p.toks[i].cur_col } else { p.toks[i].c1 + 1 }
}

// RAISE_SYNTAX_ERROR: at the last token fetched.
fn raise_last(p: mut ref P, etype: Str, msg: own String) -> i64 {
    let i = p.toks.len() - 1;
    let line = p.toks[i].l1;
    let col = tok_err_col(p, i);
    raise_at(mut p, etype, msg, line, col)
}

fn raise_tok(p: mut ref P, i: i64, msg: own String) -> i64 {
    let line = p.toks[i].l1;
    let col = tok_err_col(p, i);
    raise_at(mut p, "SyntaxError", msg, line, col)
}

// A known location on a node: its start, as a one-based character
// column.
fn raise_node(p: mut ref P, id: i64, msg: own String) -> i64 {
    let line = p.ast.nodes[id].l1;
    let b = p.ast.nodes[id].c1;
    let col = char_col(p.lx.s, p.lx.line_ends, line, b) + 1;
    raise_at(mut p, "SyntaxError", msg, line, col)
}

// A byte column on a line as a character column.
fn char_col(s: ref Vec[i64], ends: ref Vec[i64], line: i64, b: i64) -> i64 {
    let mut i = if line >= 2 { ends[line - 2] } else { 0 };
    let mut bytes = 0;
    let mut chars = 0;
    while bytes < b and i < s.len() {
        let c = s[i];
        bytes += if c < 0x80 { 1 } else if c < 0x800 { 2 } else if c < 0x10000 { 3 } else { 4 };
        chars += 1;
        i += 1;
    }
    chars
}

// The final error, as _Pypegen_set_syntax_error leaves it: a plain
// error at an INDENT or DEDENT is an IndentationError, and after any
// error from the parser the rest of the source is tokenized, so that a
// tokenizer error further on wins.
fn finish_error(p: mut ref P) {
    if p.ek == EK_GENERIC {
        let i = p.gen_tok;
        let t = p.toks[i].clone();
        if t.ty == T_INDENT or t.ty == T_DEDENT {
            p.etype = "IndentationError".to_string();
            p.emsg = if t.ty == T_INDENT { "unexpected indent".to_string() } else { "unexpected unindent".to_string() };
            p.eline = t.l1;
            p.ecol = t.cur_col;
        } else {
            p.etype = "SyntaxError".to_string();
            p.emsg = "invalid syntax".to_string();
            p.eline = t.l1;
            p.ecol = if t.c1 < 0 { 0 } else { t.c1 + 1 };
        }
    }
    if p.ek == EK_TOKEN {
        return;
    }
    let err_line = p.eline;
    let etype = p.etype.clone();
    let emsg = p.emsg.clone();
    let ecol = p.ecol;
    while not p.lexdone {
        fetch(mut p);
    }
    if p.ek != EK_TOKEN {
        return;
    }
    let keep = if p.lx.done == E_EOF {
        not (p.lx.level > 0 and err_line > p.lx.paren_lines[p.lx.parens.len() - 1])
    } else {
        p.lx.modes.len() > 1
    };
    p.ek = EK_SPECIFIC;
    if keep {
        p.etype = etype;
        p.emsg = emsg;
        p.eline = err_line;
        p.ecol = ecol;
    }
}

// ------------------------------------------------------------ positions

// The rule's start token to the last token it took that is not a
// NEWLINE, INDENT or DEDENT (_PyPegen_get_last_nonnwhitespace_token).
fn finish(p: mut ref P, id: i64, s: i64) -> i64 {
    let mut m = p.pos - 1;
    while m > s {
        let ty = p.toks[m].ty;
        if ty != T_NEWLINE and ty != T_INDENT and ty != T_DEDENT and ty != T_ENDMARKER {
            break;
        }
        m -= 1;
    }
    let l1 = p.toks[s].l1;
    let c1 = p.toks[s].b1;
    let l2 = p.toks[m].l2;
    let c2 = p.toks[m].b2;
    set_pos(mut p.ast, id, l1, c1, l2, c2);
    id
}

fn tok_pos(p: mut ref P, id: i64, i: i64) -> i64 {
    let l1 = p.toks[i].l1;
    let c1 = p.toks[i].b1;
    let l2 = p.toks[i].l2;
    let c2 = p.toks[i].b2;
    set_pos(mut p.ast, id, l1, c1, l2, c2);
    id
}

// ------------------------------------------------------------ targets

const TG_STAR: i64 = 0;
const TG_DEL: i64 = 1;
const TG_FOR: i64 = 2;

// _PyPegen_get_invalid_target
fn invalid_target(a: ref Ast, e: i64, kind: i64) -> i64 {
    if e < 0 {
        return -1;
    }
    if is(a, e, "List") or is(a, e, "Tuple") {
        for c in kids(a, e, "elts") {
            let r = invalid_target(a, c, kind);
            if r >= 0 {
                return r;
            }
        }
        return -1;
    }
    if is(a, e, "Starred") {
        if kind == TG_DEL {
            return e;
        }
        return invalid_target(a, kid(a, e, "value"), kind);
    }
    if is(a, e, "Compare") {
        if kind == TG_FOR {
            let ops = kids(a, e, "ops");
            if is(a, ops[0], "In") {
                return invalid_target(a, kid(a, e, "left"), kind);
            }
            return -1;
        }
        return e;
    }
    if is(a, e, "Name") or is(a, e, "Subscript") or is(a, e, "Attribute") {
        return -1;
    }
    e
}

// _PyPegen_get_expr_name
fn expr_name(a: ref Ast, e: i64) -> String {
    let t = ty_of(a, e);
    if t == "Constant" {
        let k = const_kind(a, e);
        return if k == C_NONE { "None" } else if k == C_TRUE { "True" } else if k == C_FALSE { "False" } else if k == C_ELL { "ellipsis" } else { "literal" }.to_string();
    }
    let table = vec![
        ("Attribute", "attribute"), ("Subscript", "subscript"), ("Starred", "starred"), ("Name", "name"),
        ("List", "list"), ("Tuple", "tuple"), ("Lambda", "lambda"), ("Call", "function call"),
        ("BoolOp", "expression"), ("BinOp", "expression"), ("UnaryOp", "expression"),
        ("GeneratorExp", "generator expression"), ("Yield", "yield expression"),
        ("YieldFrom", "yield expression"), ("Await", "await expression"), ("ListComp", "list comprehension"),
        ("SetComp", "set comprehension"), ("DictComp", "dict comprehension"), ("Dict", "dict literal"),
        ("Set", "set display"), ("JoinedStr", "f-string expression"), ("FormattedValue", "f-string expression"),
        ("Compare", "comparison"), ("IfExp", "conditional expression"), ("NamedExpr", "named expression"),
    ];
    for (k, v) in table {
        if t == k {
            return v.to_string();
        }
    }
    "expression".to_string()
}

fn set_ctx(a: mut ref Ast, e: i64, ctx: Str) {
    if field_at(a, e, "ctx") >= 0 {
        let c = leaf(mut a, ctx);
        set_kid(mut a, e, "ctx", c);
    }
    if is(a, e, "Starred") {
        let v = kid(a, e, "value");
        set_ctx(mut a, v, ctx);
    } else if is(a, e, "List") or is(a, e, "Tuple") {
        for c in kids(a, e, "elts") {
            set_ctx(mut a, c, ctx);
        }
    }
}

// ------------------------------------------------------------ nodes

fn op_node(a: mut ref Ast, ty: Str) -> i64 {
    leaf(mut a, ty)
}

fn binop(p: mut ref P, s: i64, l: i64, op: Str, r: i64) -> i64 {
    let id = mk(mut p.ast, "BinOp");
    add_node(mut p.ast, id, "left", l);
    let o = op_node(mut p.ast, op);
    add_node(mut p.ast, id, "op", o);
    add_node(mut p.ast, id, "right", r);
    finish(mut p, id, s)
}

fn tuple_node(p: mut ref P, s: i64, elts: ref Vec[i64]) -> i64 {
    let id = mk(mut p.ast, "Tuple");
    add_list(mut p.ast, id, "elts", elts);
    let c = leaf(mut p.ast, "Load");
    add_node(mut p.ast, id, "ctx", c);
    finish(mut p, id, s)
}

fn starred(p: mut ref P, s: i64, v: i64) -> i64 {
    let id = mk(mut p.ast, "Starred");
    add_node(mut p.ast, id, "value", v);
    let c = leaf(mut p.ast, "Load");
    add_node(mut p.ast, id, "ctx", c);
    finish(mut p, id, s)
}

// Can the next token start an expression?
fn starts_expr(p: mut ref P) -> bool {
    let i = ti(mut p, 0);
    let t = ref p.toks[i];
    if t.ty == T_NAME {
        return not is_keyword(t.s) or t.s == "not" or t.s == "lambda" or t.s == "await" or t.s == "True" or t.s == "False" or t.s == "None";
    }
    if t.ty == T_NUMBER or t.ty == T_STRING or t.ty == T_FSTART {
        return true;
    }
    if t.ty == T_OP {
        return t.s == "(" or t.s == "[" or t.s == "{" or t.s == "-" or t.s == "+" or t.s == "~" or t.s == "...";
    }
    false
}

fn starts_star_expr(p: mut ref P) -> bool {
    is_op(mut p, 0, "*") or starts_expr(mut p)
}

// ------------------------------------------------------------ expressions

fn star_expressions(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let e = star_expression(mut p);
    if e < 0 or not is_op(mut p, 0, ",") {
        return e;
    }
    let mut elts = vec![e];
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if not starts_star_expr(mut p) {
            break;
        }
        let x = star_expression(mut p);
        if x < 0 {
            return -1;
        }
        elts.push(x);
    }
    tuple_node(mut p, s, elts)
}

fn star_expression(p: mut ref P) -> i64 {
    if is_op(mut p, 0, "*") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    expression(mut p)
}

fn star_named_expression(p: mut ref P) -> i64 {
    if is_op(mut p, 0, "*") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    named_expression(mut p)
}

fn named_expression(p: mut ref P) -> i64 {
    if is_name(mut p, 0) and is_op(mut p, 1, ":=") {
        let s = ti(mut p, 0);
        let target = name_node(mut p.ast, tok_text(mut p, 0), "Store");
        tok_pos(mut p, target, s);
        adv(mut p);
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "NamedExpr");
        add_node(mut p.ast, id, "target", target);
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    expression(mut p)
}

fn expression(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "lambda") {
        return lambdef(mut p);
    }
    let s = ti(mut p, 0);
    let a = disjunction(mut p);
    if a < 0 {
        return -1;
    }
    if is_kw(mut p, 0, "if") {
        adv(mut p);
        let b = disjunction(mut p);
        if b < 0 {
            return -1;
        }
        if not is_kw(mut p, 0, "else") {
            if is_op(mut p, 0, ":") {
                return fail(mut p);
            }
            return raise_node(mut p, a, "expected 'else' after 'if' expression".to_string());
        }
        adv(mut p);
        let c = expression(mut p);
        if c < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "IfExp");
        add_node(mut p.ast, id, "test", b);
        add_node(mut p.ast, id, "body", a);
        add_node(mut p.ast, id, "orelse", c);
        return finish(mut p, id, s);
    }
    a
}

fn yield_expr(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    if is_kw(mut p, 0, "from") {
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "YieldFrom");
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    let mut v = -1;
    if starts_star_expr(mut p) {
        v = star_expressions(mut p);
        if v < 0 {
            return -1;
        }
    }
    let id = mk(mut p.ast, "Yield");
    add_node(mut p.ast, id, "value", v);
    finish(mut p, id, s)
}

fn boolop(p: mut ref P, word: Str, op: Str) -> i64 {
    let s = ti(mut p, 0);
    let first = if word == "or" { conjunction(mut p) } else { inversion(mut p) };
    if first < 0 or not is_kw(mut p, 0, word) {
        return first;
    }
    let mut values = vec![first];
    while is_kw(mut p, 0, word) {
        adv(mut p);
        let v = if word == "or" { conjunction(mut p) } else { inversion(mut p) };
        if v < 0 {
            return -1;
        }
        values.push(v);
    }
    let id = mk(mut p.ast, "BoolOp");
    let o = op_node(mut p.ast, op);
    add_node(mut p.ast, id, "op", o);
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

fn disjunction(p: mut ref P) -> i64 {
    boolop(mut p, "or", "Or")
}

fn conjunction(p: mut ref P) -> i64 {
    boolop(mut p, "and", "And")
}

fn inversion(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "not") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = inversion(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "UnaryOp");
        let o = op_node(mut p.ast, "Not");
        add_node(mut p.ast, id, "op", o);
        add_node(mut p.ast, id, "operand", v);
        return finish(mut p, id, s);
    }
    comparison(mut p)
}

// The comparison operator at the cursor, and how many tokens it takes.
fn compare_op(p: mut ref P) -> (String, i64) {
    if is_kw(mut p, 0, "not") and is_kw(mut p, 1, "in") {
        return ("NotIn".to_string(), 2);
    }
    if is_kw(mut p, 0, "in") {
        return ("In".to_string(), 1);
    }
    if is_kw(mut p, 0, "is") {
        if is_kw(mut p, 1, "not") {
            return ("IsNot".to_string(), 2);
        }
        return ("Is".to_string(), 1);
    }
    let i = ti(mut p, 0);
    if p.toks[i].ty == T_OP {
        let table = vec![("==", "Eq"), ("!=", "NotEq"), ("<=", "LtE"), ("<", "Lt"), (">=", "GtE"), (">", "Gt")];
        for (k, v) in table {
            if p.toks[i].s == k {
                return (v.to_string(), 1);
            }
        }
    }
    (String.new(), 0)
}

fn comparison(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let left = bitwise_or(mut p);
    if left < 0 {
        return -1;
    }
    let mut ops: Vec[i64] = Vec.new();
    let mut comps: Vec[i64] = Vec.new();
    loop {
        let (op, n) = compare_op(mut p);
        if n == 0 {
            break;
        }
        for _ in 0..n {
            adv(mut p);
        }
        let r = bitwise_or(mut p);
        if r < 0 {
            return -1;
        }
        let o = op_node(mut p.ast, op.as_str());
        ops.push(o);
        comps.push(r);
    }
    if ops.len() == 0 {
        return left;
    }
    let id = mk(mut p.ast, "Compare");
    add_node(mut p.ast, id, "left", left);
    add_list(mut p.ast, id, "ops", ops);
    add_list(mut p.ast, id, "comparators", comps);
    finish(mut p, id, s)
}

// The binary operator levels from `|` down to `*`: level 0 is `|`.
fn level_op(p: mut ref P, level: i64) -> String {
    let i = ti(mut p, 0);
    if p.toks[i].ty != T_OP {
        return String.new();
    }
    let s = p.toks[i].s.clone();
    if level == 0 and s == "|" {
        return "BitOr".to_string();
    }
    if level == 1 and s == "^" {
        return "BitXor".to_string();
    }
    if level == 2 and s == "&" {
        return "BitAnd".to_string();
    }
    if level == 3 {
        if s == "<<" {
            return "LShift".to_string();
        }
        if s == ">>" {
            return "RShift".to_string();
        }
    }
    if level == 4 {
        if s == "+" {
            return "Add".to_string();
        }
        if s == "-" {
            return "Sub".to_string();
        }
    }
    if level == 5 {
        let table = vec![("*", "Mult"), ("/", "Div"), ("//", "FloorDiv"), ("%", "Mod"), ("@", "MatMult")];
        for (k, v) in table {
            if s == k {
                return v.to_string();
            }
        }
    }
    String.new()
}

fn binary(p: mut ref P, level: i64) -> i64 {
    if level == 6 {
        return factor(mut p);
    }
    let s = ti(mut p, 0);
    let mut e = binary(mut p, level + 1);
    if e < 0 {
        return -1;
    }
    loop {
        let op = level_op(mut p, level);
        if op.is_empty() {
            break;
        }
        adv(mut p);
        let r = binary(mut p, level + 1);
        if r < 0 {
            return -1;
        }
        e = binop(mut p, s, e, op.as_str(), r);
    }
    e
}

fn bitwise_or(p: mut ref P) -> i64 {
    binary(mut p, 0)
}

fn factor(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut op = "";
    if is_op(mut p, 0, "+") {
        op = "UAdd";
    } else if is_op(mut p, 0, "-") {
        op = "USub";
    } else if is_op(mut p, 0, "~") {
        op = "Invert";
    }
    if op != "" {
        adv(mut p);
        let v = factor(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "UnaryOp");
        let o = op_node(mut p.ast, op);
        add_node(mut p.ast, id, "op", o);
        add_node(mut p.ast, id, "operand", v);
        return finish(mut p, id, s);
    }
    power(mut p)
}

fn power(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let a = await_primary(mut p);
    if a < 0 {
        return -1;
    }
    if is_op(mut p, 0, "**") {
        adv(mut p);
        let b = factor(mut p);
        if b < 0 {
            return -1;
        }
        return binop(mut p, s, a, "Pow", b);
    }
    a
}

fn await_primary(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "await") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = primary(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "Await");
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    primary(mut p)
}

fn primary(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut e = atom(mut p);
    if e < 0 {
        return -1;
    }
    loop {
        if is_op(mut p, 0, ".") {
            adv(mut p);
            if not is_name(mut p, 0) {
                return fail(mut p);
            }
            let attr = tok_text(mut p, 0);
            adv(mut p);
            let id = mk(mut p.ast, "Attribute");
            add_node(mut p.ast, id, "value", e);
            add_str(mut p.ast, id, "attr", attr);
            let c = leaf(mut p.ast, "Load");
            add_node(mut p.ast, id, "ctx", c);
            e = finish(mut p, id, s);
        } else if is_op(mut p, 0, "(") {
            let mut args: Vec[i64] = Vec.new();
            let mut kws: Vec[i64] = Vec.new();
            if call_args(mut p, true, mut args, mut kws) < 0 {
                return -1;
            }
            let id = mk(mut p.ast, "Call");
            add_node(mut p.ast, id, "func", e);
            add_list(mut p.ast, id, "args", args);
            add_list(mut p.ast, id, "keywords", kws);
            e = finish(mut p, id, s);
        } else if is_op(mut p, 0, "[") {
            adv(mut p);
            let sl = slices(mut p);
            if sl < 0 {
                return -1;
            }
            if not is_op(mut p, 0, "]") {
                return fail(mut p);
            }
            adv(mut p);
            let id = mk(mut p.ast, "Subscript");
            add_node(mut p.ast, id, "value", e);
            add_node(mut p.ast, id, "slice", sl);
            let c = leaf(mut p.ast, "Load");
            add_node(mut p.ast, id, "ctx", c);
            e = finish(mut p, id, s);
        } else {
            break;
        }
    }
    e
}

fn slices(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let first_starred = is_op(mut p, 0, "*");
    let first = slice_item(mut p);
    if first < 0 {
        return -1;
    }
    if not is_op(mut p, 0, ",") and not first_starred {
        return first;
    }
    let mut elts = vec![first];
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, "]") {
            break;
        }
        let x = slice_item(mut p);
        if x < 0 {
            return -1;
        }
        elts.push(x);
    }
    tuple_node(mut p, s, elts)
}

fn slice_item(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    if is_op(mut p, 0, "*") {
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    let mut lower = -1;
    if not is_op(mut p, 0, ":") {
        lower = named_expression(mut p);
        if lower < 0 {
            return -1;
        }
        if not is_op(mut p, 0, ":") {
            return lower;
        }
    }
    adv(mut p);
    let mut upper = -1;
    let mut step = -1;
    if starts_expr(mut p) {
        upper = expression(mut p);
        if upper < 0 {
            return -1;
        }
    }
    if is_op(mut p, 0, ":") {
        adv(mut p);
        if starts_expr(mut p) {
            step = expression(mut p);
            if step < 0 {
                return -1;
            }
        }
    }
    let id = mk(mut p.ast, "Slice");
    add_node(mut p.ast, id, "lower", lower);
    add_node(mut p.ast, id, "upper", upper);
    add_node(mut p.ast, id, "step", step);
    finish(mut p, id, s)
}

fn keyword_node(p: mut ref P, s: i64, name: Option[String], v: i64) -> i64 {
    let id = mk(mut p.ast, "keyword");
    match name {
        Some(n) => add_str(mut p.ast, id, "arg", n),
        None => add_none(mut p.ast, id, "arg"),
    }
    add_node(mut p.ast, id, "value", v);
    finish(mut p, id, s)
}

fn starts_comprehension(p: mut ref P) -> bool {
    is_kw(mut p, 0, "for") or (is_kw(mut p, 0, "async") and is_kw(mut p, 1, "for"))
}

// The arguments of a call or a class, from its `(` to its `)`. A call
// takes a bare generator expression as its only argument; the
// generator expression then spans the parentheses.
fn call_args(p: mut ref P, allow_genexp: bool, args: mut ref Vec[i64], kws: mut ref Vec[i64]) -> i64 {
    let lp = ti(mut p, 0);
    adv(mut p);
    let mut seen_kw = false;
    let mut seen_unpack = false;
    let mut first = true;
    loop {
        if is_op(mut p, 0, ")") {
            break;
        }
        let s = ti(mut p, 0);
        if is_op(mut p, 0, "*") {
            adv(mut p);
            let v = expression(mut p);
            if v < 0 {
                return -1;
            }
            let st = starred(mut p, s, v);
            args.push(st);
        } else if is_op(mut p, 0, "**") {
            adv(mut p);
            let v = expression(mut p);
            if v < 0 {
                return -1;
            }
            let k = keyword_node(mut p, s, None, v);
            kws.push(k);
            seen_unpack = true;
        } else if is_name(mut p, 0) and is_op(mut p, 1, "=") {
            let name = tok_text(mut p, 0);
            adv(mut p);
            adv(mut p);
            let v = expression(mut p);
            if v < 0 {
                return -1;
            }
            let k = keyword_node(mut p, s, Some(name), v);
            kws.push(k);
            seen_kw = true;
        } else {
            let e = named_expression(mut p);
            if e < 0 {
                return -1;
            }
            if starts_comprehension(mut p) {
                if not allow_genexp {
                    return fail(mut p);
                }
                let gens = for_if_clauses(mut p);
                if failed(p) {
                    return -1;
                }
                if not first or not is_op(mut p, 0, ")") {
                    return raise_node(mut p, e, "Generator expression must be parenthesized".to_string());
                }
                adv(mut p);
                let g = mk(mut p.ast, "GeneratorExp");
                add_node(mut p.ast, g, "elt", e);
                add_list(mut p.ast, g, "generators", gens);
                finish(mut p, g, lp);
                args.push(g);
                return 0;
            }
            if seen_kw or seen_unpack {
                let msg = if seen_unpack { "positional argument follows keyword argument unpacking" } else { "positional argument follows keyword argument" };
                return raise_last(mut p, "SyntaxError", msg.to_string());
            }
            args.push(e);
        }
        first = false;
        if is_op(mut p, 0, ",") {
            adv(mut p);
            continue;
        }
        if is_op(mut p, 0, ")") {
            break;
        }
        return fail(mut p);
    }
    adv(mut p);
    0
}

fn for_targets(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let first = target_elem(mut p);
    if first < 0 {
        return -1;
    }
    let mut e = first;
    if is_op(mut p, 0, ",") {
        let mut elts = vec![first];
        while is_op(mut p, 0, ",") {
            adv(mut p);
            if not starts_star_expr(mut p) {
                break;
            }
            let x = target_elem(mut p);
            if x < 0 {
                return -1;
            }
            elts.push(x);
        }
        e = tuple_node(mut p, s, elts);
    }
    let bad = invalid_target(p.ast, e, TG_FOR);
    if bad >= 0 {
        let name = expr_name(p.ast, bad);
        return raise_node(mut p, bad, f"cannot assign to {name}");
    }
    set_ctx(mut p.ast, e, "Store");
    e
}

fn target_elem(p: mut ref P) -> i64 {
    if is_op(mut p, 0, "*") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    bitwise_or(mut p)
}

fn for_if_clauses(p: mut ref P) -> Vec[i64] {
    let mut gens: Vec[i64] = Vec.new();
    while starts_comprehension(mut p) {
        let mut is_async = 0;
        if is_kw(mut p, 0, "async") {
            is_async = 1;
            adv(mut p);
        }
        adv(mut p);
        let target = for_targets(mut p);
        if target < 0 {
            return gens;
        }
        if not is_kw(mut p, 0, "in") {
            fail(mut p);
            return gens;
        }
        adv(mut p);
        let iter = disjunction(mut p);
        if iter < 0 {
            return gens;
        }
        let mut ifs: Vec[i64] = Vec.new();
        while is_kw(mut p, 0, "if") {
            adv(mut p);
            let c = disjunction(mut p);
            if c < 0 {
                return gens;
            }
            ifs.push(c);
        }
        let id = mk(mut p.ast, "comprehension");
        add_node(mut p.ast, id, "target", target);
        add_node(mut p.ast, id, "iter", iter);
        add_list(mut p.ast, id, "ifs", ifs);
        add_int(mut p.ast, id, "is_async", is_async);
        gens.push(id);
    }
    gens
}

fn comp_node(p: mut ref P, s: i64, ty: Str, elt: i64, gens: ref Vec[i64]) -> i64 {
    let id = mk(mut p.ast, ty);
    add_node(mut p.ast, id, "elt", elt);
    add_list(mut p.ast, id, "generators", gens);
    finish(mut p, id, s)
}

fn atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let t = p.toks[s].clone();
    if t.ty == T_NAME {
        if not is_keyword(t.s) {
            adv(mut p);
            let id = name_node(mut p.ast, t.s, "Load");
            return tok_pos(mut p, id, s);
        }
        if t.s == "True" or t.s == "False" or t.s == "None" {
            adv(mut p);
            let ck = if t.s == "True" { C_TRUE } else if t.s == "False" { C_FALSE } else { C_NONE };
            let id = constant(mut p.ast, cv_of(ck), false);
            return tok_pos(mut p, id, s);
        }
        return fail(mut p);
    }
    if t.ty == T_NUMBER {
        adv(mut p);
        let id = constant(mut p.ast, number_value(t.text), false);
        return tok_pos(mut p, id, s);
    }
    if t.ty == T_STRING or t.ty == T_FSTART {
        return strings(mut p);
    }
    if t.ty == T_OP {
        if t.s == "(" {
            return paren_atom(mut p);
        }
        if t.s == "[" {
            return list_atom(mut p);
        }
        if t.s == "{" {
            return brace_atom(mut p);
        }
        if t.s == "..." {
            adv(mut p);
            let id = constant(mut p.ast, cv_of(C_ELL), false);
            return tok_pos(mut p, id, s);
        }
    }
    fail(mut p)
}

fn paren_atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    if is_op(mut p, 0, ")") {
        adv(mut p);
        return tuple_node(mut p, s, Vec.new());
    }
    if is_kw(mut p, 0, "yield") {
        let y = yield_expr(mut p);
        if y < 0 {
            return -1;
        }
        if not is_op(mut p, 0, ")") {
            return fail(mut p);
        }
        adv(mut p);
        return y;
    }
    let first = star_named_expression(mut p);
    if first < 0 {
        return -1;
    }
    if starts_comprehension(mut p) {
        let gens = for_if_clauses(mut p);
        if failed(p) {
            return -1;
        }
        if not is_op(mut p, 0, ")") {
            return fail(mut p);
        }
        adv(mut p);
        return comp_node(mut p, s, "GeneratorExp", first, gens);
    }
    if is_op(mut p, 0, ")") {
        adv(mut p);
        return first;
    }
    if not is_op(mut p, 0, ",") {
        return fail(mut p);
    }
    let mut elts = vec![first];
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, ")") {
            break;
        }
        let x = star_named_expression(mut p);
        if x < 0 {
            return -1;
        }
        elts.push(x);
    }
    if not is_op(mut p, 0, ")") {
        return fail(mut p);
    }
    adv(mut p);
    tuple_node(mut p, s, elts)
}

// The elements of a display up to its closing bracket, after the first.
fn more_elements(p: mut ref P, elts: mut ref Vec[i64], close: Str) -> bool {
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, close) {
            break;
        }
        let x = star_named_expression(mut p);
        if x < 0 {
            return false;
        }
        elts.push(x);
    }
    if not is_op(mut p, 0, close) {
        fail(mut p);
        return false;
    }
    adv(mut p);
    true
}

fn list_atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut elts: Vec[i64] = Vec.new();
    if is_op(mut p, 0, "]") {
        adv(mut p);
    } else {
        let first = star_named_expression(mut p);
        if first < 0 {
            return -1;
        }
        if starts_comprehension(mut p) {
            let gens = for_if_clauses(mut p);
            if failed(p) {
                return -1;
            }
            if not is_op(mut p, 0, "]") {
                return fail(mut p);
            }
            adv(mut p);
            return comp_node(mut p, s, "ListComp", first, gens);
        }
        elts.push(first);
        if not more_elements(mut p, mut elts, "]") {
            return -1;
        }
    }
    let id = mk(mut p.ast, "List");
    add_list(mut p.ast, id, "elts", elts);
    let c = leaf(mut p.ast, "Load");
    add_node(mut p.ast, id, "ctx", c);
    finish(mut p, id, s)
}

fn brace_atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut keys: Vec[i64] = Vec.new();
    let mut values: Vec[i64] = Vec.new();
    if is_op(mut p, 0, "}") {
        adv(mut p);
        return dict_node(mut p, s, keys, values);
    }
    if is_op(mut p, 0, "**") {
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        keys.push(-1);
        values.push(v);
        return dict_rest(mut p, s, mut keys, mut values);
    }
    let first = star_named_expression(mut p);
    if first < 0 {
        return -1;
    }
    if is_op(mut p, 0, ":") and not is(p.ast, first, "Starred") {
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        if starts_comprehension(mut p) {
            let gens = for_if_clauses(mut p);
            if failed(p) {
                return -1;
            }
            if not is_op(mut p, 0, "}") {
                return fail(mut p);
            }
            adv(mut p);
            let id = mk(mut p.ast, "DictComp");
            add_node(mut p.ast, id, "key", first);
            add_node(mut p.ast, id, "value", v);
            add_list(mut p.ast, id, "generators", gens);
            return finish(mut p, id, s);
        }
        keys.push(first);
        values.push(v);
        return dict_rest(mut p, s, mut keys, mut values);
    }
    if starts_comprehension(mut p) {
        let gens = for_if_clauses(mut p);
        if failed(p) {
            return -1;
        }
        if not is_op(mut p, 0, "}") {
            return fail(mut p);
        }
        adv(mut p);
        return comp_node(mut p, s, "SetComp", first, gens);
    }
    let mut elts = vec![first];
    if not more_elements(mut p, mut elts, "}") {
        return -1;
    }
    let id = mk(mut p.ast, "Set");
    add_list(mut p.ast, id, "elts", elts);
    finish(mut p, id, s)
}

fn dict_rest(p: mut ref P, s: i64, keys: mut ref Vec[i64], values: mut ref Vec[i64]) -> i64 {
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, "}") {
            break;
        }
        if is_op(mut p, 0, "**") {
            adv(mut p);
            let v = bitwise_or(mut p);
            if v < 0 {
                return -1;
            }
            keys.push(-1);
            values.push(v);
            continue;
        }
        let k = expression(mut p);
        if k < 0 {
            return -1;
        }
        if not is_op(mut p, 0, ":") {
            return fail(mut p);
        }
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        keys.push(k);
        values.push(v);
    }
    if not is_op(mut p, 0, "}") {
        return fail(mut p);
    }
    adv(mut p);
    dict_node(mut p, s, keys, values)
}

fn dict_node(p: mut ref P, s: i64, keys: ref Vec[i64], values: ref Vec[i64]) -> i64 {
    let id = mk(mut p.ast, "Dict");
    add_list(mut p.ast, id, "keys", keys);
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

fn lambdef(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let args = params(mut p, true);
    if args < 0 {
        return -1;
    }
    if not is_op(mut p, 0, ":") {
        return fail(mut p);
    }
    adv(mut p);
    if tty(mut p, 0) == T_FMIDDLE {
        return raise_tok(mut p, s, "f-string: lambda expressions are not allowed without parentheses".to_string());
    }
    let body = expression(mut p);
    if body < 0 {
        return -1;
    }
    let id = mk(mut p.ast, "Lambda");
    add_node(mut p.ast, id, "args", args);
    add_node(mut p.ast, id, "body", body);
    finish(mut p, id, s)
}

fn param(p: mut ref P, is_lambda: bool) -> i64 {
    let s = ti(mut p, 0);
    if not is_name(mut p, 0) {
        return fail(mut p);
    }
    let name = tok_text(mut p, 0);
    adv(mut p);
    let mut ann = -1;
    if not is_lambda and is_op(mut p, 0, ":") {
        adv(mut p);
        ann = expression(mut p);
        if ann < 0 {
            return -1;
        }
    }
    let id = mk(mut p.ast, "arg");
    add_str(mut p.ast, id, "arg", name);
    add_node(mut p.ast, id, "annotation", ann);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

// The parameters of a def (up to its `)`) or of a lambda (up to its
// `:`), as an arguments node.
fn params(p: mut ref P, is_lambda: bool) -> i64 {
    let close = if is_lambda { ":" } else { ")" };
    let mut posonly: Vec[i64] = Vec.new();
    let mut args: Vec[i64] = Vec.new();
    let mut defaults: Vec[i64] = Vec.new();
    let mut kwonly: Vec[i64] = Vec.new();
    let mut kwdefaults: Vec[i64] = Vec.new();
    let mut vararg = -1;
    let mut kwarg = -1;
    let mut seen_star = false;
    let mut seen_default = false;
    loop {
        if is_op(mut p, 0, close) {
            break;
        }
        if is_op(mut p, 0, "/") {
            if seen_star or args.len() == 0 or posonly.len() > 0 {
                return fail(mut p);
            }
            adv(mut p);
            posonly = args;
            args = Vec.new();
        } else if is_op(mut p, 0, "*") {
            if seen_star {
                return fail(mut p);
            }
            adv(mut p);
            seen_star = true;
            if not is_op(mut p, 0, ",") {
                vararg = param(mut p, is_lambda);
                if vararg < 0 {
                    return -1;
                }
            }
        } else if is_op(mut p, 0, "**") {
            adv(mut p);
            kwarg = param(mut p, is_lambda);
            if kwarg < 0 {
                return -1;
            }
            if is_op(mut p, 0, ",") {
                adv(mut p);
            }
            if not is_op(mut p, 0, close) {
                return fail(mut p);
            }
            break;
        } else {
            let a = param(mut p, is_lambda);
            if a < 0 {
                return -1;
            }
            let mut d = -1;
            if is_op(mut p, 0, "=") {
                adv(mut p);
                d = expression(mut p);
                if d < 0 {
                    return -1;
                }
            }
            if seen_star {
                kwonly.push(a);
                kwdefaults.push(d);
            } else {
                if d >= 0 {
                    defaults.push(d);
                    seen_default = true;
                } else if seen_default {
                    return raise_node(mut p, a, "parameter without a default follows parameter with a default".to_string());
                }
                args.push(a);
            }
        }
        if is_op(mut p, 0, ",") {
            adv(mut p);
            continue;
        }
        if is_op(mut p, 0, close) {
            break;
        }
        return fail(mut p);
    }
    let id = mk(mut p.ast, "arguments");
    add_list(mut p.ast, id, "posonlyargs", posonly);
    add_list(mut p.ast, id, "args", args);
    add_node(mut p.ast, id, "vararg", vararg);
    add_list(mut p.ast, id, "kwonlyargs", kwonly);
    add_list(mut p.ast, id, "kw_defaults", kwdefaults);
    add_node(mut p.ast, id, "kwarg", kwarg);
    add_list(mut p.ast, id, "defaults", defaults);
    id
}

// ------------------------------------------------------------ strings

fn string_const(p: mut ref P, i: i64) -> i64 {
    let l = decode_literal(p.toks[i].text);
    let mut v = cv_of(if l.bytes { C_BYTES } else { C_STR });
    v.s = l.body;
    let id = constant(mut p.ast, v, l.is_u);
    tok_pos(mut p, id, i)
}

fn is_str_const(a: ref Ast, id: i64) -> bool {
    is(a, id, "Constant") and const_kind(a, id) == C_STR
}

fn is_empty_str(a: ref Ast, id: i64) -> bool {
    is_str_const(a, id) and cv(a, id).s.len() == 0
}

// An f-string's literal part, decoded unless the f-string is raw.
fn middle_const(p: mut ref P, i: i64, raw: bool) -> i64 {
    let text = p.toks[i].text.clone();
    let body = if raw { text } else { decode_escapes(text, false) };
    let id = str_const(mut p.ast, body);
    tok_pos(mut p, id, i)
}

fn strings(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut parts: Vec[i64] = Vec.new();
    loop {
        let ty = tty(mut p, 0);
        if ty == T_STRING {
            let i = ti(mut p, 0);
            let c = string_const(mut p, i);
            parts.push(c);
            adv(mut p);
        } else if ty == T_FSTART {
            let f = fstring(mut p);
            if f < 0 {
                return -1;
            }
            parts.push(f);
        } else {
            break;
        }
    }
    concatenate(mut p, parts, s)
}

fn fstring(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut raw = false;
    for c in p.toks[s].text.clone() {
        if c == 114 or c == 82 {
            raw = true;
        }
    }
    adv(mut p);
    let mut vals: Vec[i64] = Vec.new();
    loop {
        let ty = tty(mut p, 0);
        if ty == T_FMIDDLE {
            let i = ti(mut p, 0);
            let c = middle_const(mut p, i, raw);
            vals.push(c);
            adv(mut p);
        } else if is_op(mut p, 0, "{") {
            let f = replacement_field(mut p);
            if f < 0 {
                return -1;
            }
            vals.push(f);
        } else if ty == T_FEND {
            adv(mut p);
            break;
        } else {
            return fail(mut p);
        }
    }
    // _PyPegen_joined_str: the debug text's JoinedStr is opened up, and
    // the empty literal parts go.
    let mut values: Vec[i64] = Vec.new();
    for v in vals {
        if is(p.ast, v, "JoinedStr") {
            for x in kids(p.ast, v, "values") {
                values.push(x);
            }
        } else if not is_empty_str(p.ast, v) {
            values.push(v);
        }
    }
    let id = mk(mut p.ast, "JoinedStr");
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

fn replacement_field(p: mut ref P) -> i64 {
    let lb = ti(mut p, 0);
    adv(mut p);
    let e = if is_kw(mut p, 0, "yield") { yield_expr(mut p) } else { star_expressions(mut p) };
    if e < 0 {
        return -1;
    }
    let mut debug = false;
    if is_op(mut p, 0, "=") {
        debug = true;
        adv(mut p);
    }
    let after_eq = ti(mut p, 0);
    let mut conv = -1;
    let mut conv_tok = -1;
    if is_op(mut p, 0, "!") {
        adv(mut p);
        if not is_name(mut p, 0) {
            return fail(mut p);
        }
        conv_tok = ti(mut p, 0);
        let name = p.toks[conv_tok].text.clone();
        adv(mut p);
        conv = name[0];
    }
    let mut spec = -1;
    let mut spec_tok = -1;
    if is_op(mut p, 0, ":") {
        spec_tok = ti(mut p, 0);
        spec = format_spec(mut p);
        if spec < 0 {
            return -1;
        }
    }
    if not is_op(mut p, 0, "}") {
        return fail(mut p);
    }
    let rb = ti(mut p, 0);
    adv(mut p);
    if debug and conv < 0 and spec < 0 {
        conv = 114;
    }
    let fv = mk(mut p.ast, "FormattedValue");
    add_node(mut p.ast, fv, "value", e);
    add_int(mut p.ast, fv, "conversion", conv);
    add_node(mut p.ast, fv, "format_spec", spec);
    finish(mut p, fv, lb);
    if not debug {
        return fv;
    }
    // The text of the expression up to the token after `=`, as a
    // constant in front.
    let text = slice(p.lx.s, p.toks[lb].a2, p.toks[after_eq].a1);
    let body = decode_escapes(text, false);
    let d = str_const(mut p.ast, body);
    let end = if conv_tok >= 0 { conv_tok - 1 } else if spec_tok >= 0 { spec_tok } else { rb };
    let l1 = p.toks[lb].l1;
    let c1 = p.toks[lb].b1 + 1;
    let l2 = p.toks[end].l1;
    let c2 = p.toks[end].b1;
    set_pos(mut p.ast, d, l1, c1, l2, c2);
    let j = mk(mut p.ast, "JoinedStr");
    add_list(mut p.ast, j, "values", vec![d, fv]);
    j
}

fn format_spec(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut items: Vec[i64] = Vec.new();
    loop {
        if tty(mut p, 0) == T_FMIDDLE {
            let i = ti(mut p, 0);
            let text = p.toks[i].text.clone();
            let id = str_const(mut p.ast, decode_escapes(text, false));
            tok_pos(mut p, id, i);
            if not is_empty_str(p.ast, id) {
                items.push(id);
            }
            adv(mut p);
        } else if is_op(mut p, 0, "{") {
            let f = replacement_field(mut p);
            if f < 0 {
                return -1;
            }
            items.push(f);
        } else {
            break;
        }
    }
    if items.len() == 0 or (items.len() == 1 and is(p.ast, items[0], "Constant")) {
        let id = mk(mut p.ast, "JoinedStr");
        add_list(mut p.ast, id, "values", items);
        return finish(mut p, id, s);
    }
    concatenate(mut p, items, s)
}

// _PyPegen_concatenate_strings: adjacent literals fold into one, which
// takes the kind of the first; with an f-string among them the result
// is a JoinedStr without empty literals.
fn concatenate(p: mut ref P, parts: ref Vec[i64], s: i64) -> i64 {
    let mut f_found = false;
    let mut bytes_found = false;
    let mut uni_found = false;
    for x in parts {
        if is(p.ast, x, "Constant") {
            if const_kind(p.ast, x) == C_BYTES {
                bytes_found = true;
            } else {
                uni_found = true;
            }
        } else {
            f_found = true;
        }
    }
    if bytes_found and (uni_found or f_found) {
        return raise_last(mut p, "SyntaxError", "cannot mix bytes and nonbytes literals".to_string());
    }
    if bytes_found {
        let mut v = cv_of(C_BYTES);
        let mut kind_u = false;
        let mut first = true;
        for x in parts {
            if first {
                kind_u = has_str(p.ast, x, "kind");
                first = false;
            }
            for c in cv(p.ast, x).s {
                v.s.push(c);
            }
        }
        let id = constant(mut p.ast, v, kind_u);
        return finish(mut p, id, s);
    }
    if not f_found and parts.len() == 1 {
        return parts[0];
    }
    let mut flat: Vec[i64] = Vec.new();
    for x in parts {
        if is(p.ast, x, "JoinedStr") {
            for y in kids(p.ast, x, "values") {
                flat.push(y);
            }
        } else {
            flat.push(x);
        }
    }
    let mut values: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < flat.len() {
        let mut elem = flat[i];
        if is(p.ast, elem, "Constant") {
            if i + 1 < flat.len() and is(p.ast, flat[i + 1], "Constant") {
                let first = elem;
                let mut last = elem;
                let mut text: Vec[i64] = Vec.new();
                let mut j = i;
                while j < flat.len() and is(p.ast, flat[j], "Constant") {
                    for c in cv(p.ast, flat[j]).s {
                        text.push(c);
                    }
                    last = flat[j];
                    j += 1;
                }
                i = j - 1;
                let mut v = cv_of(C_STR);
                v.s = text;
                let kind_u = has_str(p.ast, first, "kind");
                elem = constant(mut p.ast, v, kind_u);
                let l1 = p.ast.nodes[first].l1;
                let c1 = p.ast.nodes[first].c1;
                let l2 = p.ast.nodes[last].l2;
                let c2 = p.ast.nodes[last].c2;
                set_pos(mut p.ast, elem, l1, c1, l2, c2);
            }
            if f_found and is_empty_str(p.ast, elem) {
                i += 1;
                continue;
            }
        }
        values.push(elem);
        i += 1;
    }
    if not f_found {
        return values[0];
    }
    let id = mk(mut p.ast, "JoinedStr");
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

// ------------------------------------------------------------ statements

fn parse_module(p: mut ref P) -> i64 {
    let mut body: Vec[i64] = Vec.new();
    while tty(mut p, 0) != T_ENDMARKER {
        statement(mut p, mut body);
        if failed(p) {
            return -1;
        }
    }
    let id = mk(mut p.ast, "Module");
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "type_ignores", Vec.new());
    id
}

// mode='eval': an expression, then the end.
fn parse_eval(p: mut ref P) -> i64 {
    let e = star_expressions(mut p);
    if e < 0 {
        return -1;
    }
    while tty(mut p, 0) == T_NEWLINE {
        adv(mut p);
    }
    if tty(mut p, 0) != T_ENDMARKER {
        return fail(mut p);
    }
    let id = mk(mut p.ast, "Expression");
    add_node(mut p.ast, id, "body", e);
    id
}

fn statement(p: mut ref P, out: mut ref Vec[i64]) {
    let i = ti(mut p, 0);
    let t = p.toks[i].clone();
    if t.ty == T_NAME {
        let w = t.s.as_str();
        let mut st = -2;
        if w == "if" {
            st = if_stmt(mut p);
        } else if w == "while" {
            st = while_stmt(mut p);
        } else if w == "for" {
            st = for_stmt(mut p);
        } else if w == "try" {
            st = try_stmt(mut p);
        } else if w == "with" {
            st = with_stmt(mut p);
        } else if w == "def" or w == "class" {
            st = def_or_class(mut p, Vec.new());
        } else if w == "async" and (is_kw(mut p, 1, "def") or is_kw(mut p, 1, "for") or is_kw(mut p, 1, "with")) {
            if is_kw(mut p, 1, "def") {
                st = def_or_class(mut p, Vec.new());
            } else if is_kw(mut p, 1, "for") {
                st = for_stmt(mut p);
            } else {
                st = with_stmt(mut p);
            }
        }
        if st != -2 {
            if st >= 0 {
                out.push(st);
            }
            return;
        }
    }
    if t.ty == T_OP and t.s == "@" {
        let mut decos: Vec[i64] = Vec.new();
        while is_op(mut p, 0, "@") {
            adv(mut p);
            let d = named_expression(mut p);
            if d < 0 {
                return;
            }
            if tty(mut p, 0) != T_NEWLINE {
                fail(mut p);
                return;
            }
            adv(mut p);
            decos.push(d);
        }
        let st = def_or_class(mut p, decos);
        if st >= 0 {
            out.push(st);
        }
        return;
    }
    simple_stmts(mut p, mut out);
}

fn simple_stmts(p: mut ref P, out: mut ref Vec[i64]) {
    loop {
        let st = simple_stmt(mut p);
        if st < 0 {
            return;
        }
        out.push(st);
        if is_op(mut p, 0, ";") {
            adv(mut p);
            if tty(mut p, 0) == T_NEWLINE {
                adv(mut p);
                return;
            }
            continue;
        }
        if tty(mut p, 0) == T_NEWLINE {
            adv(mut p);
            return;
        }
        fail(mut p);
        return;
    }
}

fn simple_kw(p: mut ref P, ty: Str) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let id = mk(mut p.ast, ty);
    tok_pos(mut p, id, s)
}

fn names_list(p: mut ref P) -> Vec[String] {
    let mut names: Vec[String] = Vec.new();
    loop {
        if not is_name(mut p, 0) {
            fail(mut p);
            return names;
        }
        names.push(tok_text(mut p, 0));
        adv(mut p);
        if not is_op(mut p, 0, ",") {
            return names;
        }
        adv(mut p);
    }
}

fn simple_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    if is_kw(mut p, 0, "pass") {
        return simple_kw(mut p, "Pass");
    }
    if is_kw(mut p, 0, "break") {
        return simple_kw(mut p, "Break");
    }
    if is_kw(mut p, 0, "continue") {
        return simple_kw(mut p, "Continue");
    }
    if is_kw(mut p, 0, "return") {
        adv(mut p);
        let mut v = -1;
        if starts_star_expr(mut p) {
            v = star_expressions(mut p);
            if v < 0 {
                return -1;
            }
        }
        let id = mk(mut p.ast, "Return");
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "raise") {
        adv(mut p);
        let mut exc = -1;
        let mut cause = -1;
        if starts_expr(mut p) {
            exc = expression(mut p);
            if exc < 0 {
                return -1;
            }
            if is_kw(mut p, 0, "from") {
                adv(mut p);
                cause = expression(mut p);
                if cause < 0 {
                    return -1;
                }
            }
        }
        let id = mk(mut p.ast, "Raise");
        add_node(mut p.ast, id, "exc", exc);
        add_node(mut p.ast, id, "cause", cause);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "global") or is_kw(mut p, 0, "nonlocal") {
        let ty = if is_kw(mut p, 0, "global") { "Global" } else { "Nonlocal" };
        adv(mut p);
        let names = names_list(mut p);
        if failed(p) {
            return -1;
        }
        let id = mk(mut p.ast, ty);
        add_strs(mut p.ast, id, "names", names);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "del") {
        return del_stmt(mut p);
    }
    if is_kw(mut p, 0, "assert") {
        adv(mut p);
        let test = expression(mut p);
        if test < 0 {
            return -1;
        }
        let mut msg = -1;
        if is_op(mut p, 0, ",") {
            adv(mut p);
            msg = expression(mut p);
            if msg < 0 {
                return -1;
            }
        }
        let id = mk(mut p.ast, "Assert");
        add_node(mut p.ast, id, "test", test);
        add_node(mut p.ast, id, "msg", msg);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "import") {
        return import_name(mut p);
    }
    if is_kw(mut p, 0, "from") {
        return import_from(mut p);
    }
    if is_kw(mut p, 0, "yield") {
        let y = yield_expr(mut p);
        if y < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "Expr");
        add_node(mut p.ast, id, "value", y);
        return finish(mut p, id, s);
    }
    expr_or_assign(mut p)
}

fn del_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut targets: Vec[i64] = Vec.new();
    loop {
        let e = star_expression(mut p);
        if e < 0 {
            return -1;
        }
        targets.push(e);
        if not is_op(mut p, 0, ",") {
            break;
        }
        adv(mut p);
        if not starts_star_expr(mut p) {
            break;
        }
    }
    for e in targets {
        let bad = invalid_target(p.ast, e, TG_DEL);
        if bad >= 0 {
            let name = expr_name(p.ast, bad);
            return raise_node(mut p, bad, f"cannot delete {name}");
        }
    }
    for e in targets {
        set_ctx(mut p.ast, e, "Del");
    }
    let id = mk(mut p.ast, "Delete");
    add_list(mut p.ast, id, "targets", targets);
    finish(mut p, id, s)
}

fn dotted_name(p: mut ref P) -> String {
    let mut out = String.new();
    loop {
        if not is_name(mut p, 0) {
            fail(mut p);
            return out;
        }
        out.push_str(tok_text(mut p, 0));
        adv(mut p);
        if not is_op(mut p, 0, ".") {
            return out;
        }
        out.push('.');
        adv(mut p);
    }
}

fn alias_node(p: mut ref P, s: i64, name: ref String, asname: Option[String]) -> i64 {
    let id = mk(mut p.ast, "alias");
    add_str(mut p.ast, id, "name", name);
    match asname {
        Some(a) => add_str(mut p.ast, id, "asname", a),
        None => add_none(mut p.ast, id, "asname"),
    }
    finish(mut p, id, s)
}

fn as_name(p: mut ref P) -> Option[String] {
    if not is_kw(mut p, 0, "as") {
        return None;
    }
    adv(mut p);
    if not is_name(mut p, 0) {
        fail(mut p);
        return None;
    }
    let n = tok_text(mut p, 0);
    adv(mut p);
    Some(n)
}

fn import_name(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    if tty(mut p, 0) == T_NEWLINE {
        let i = ti(mut p, 0);
        return raise_tok(mut p, i, "Expected one or more names after 'import'".to_string());
    }
    let mut names: Vec[i64] = Vec.new();
    loop {
        let a = ti(mut p, 0);
        let name = dotted_name(mut p);
        if failed(p) {
            return -1;
        }
        let asname = as_name(mut p);
        if failed(p) {
            return -1;
        }
        let al = alias_node(mut p, a, name, asname);
        names.push(al);
        if not is_op(mut p, 0, ",") {
            break;
        }
        adv(mut p);
    }
    let id = mk(mut p.ast, "Import");
    add_list(mut p.ast, id, "names", names);
    finish(mut p, id, s)
}

fn import_from(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut level = 0;
    loop {
        if is_op(mut p, 0, ".") {
            level += 1;
        } else if is_op(mut p, 0, "...") {
            level += 3;
        } else {
            break;
        }
        adv(mut p);
    }
    let mut module: Option[String] = None;
    if not is_kw(mut p, 0, "import") or level == 0 {
        let m = dotted_name(mut p);
        if failed(p) {
            return -1;
        }
        module = Some(m);
    }
    if not is_kw(mut p, 0, "import") {
        return fail(mut p);
    }
    adv(mut p);
    let mut names: Vec[i64] = Vec.new();
    if is_op(mut p, 0, "*") {
        let a = ti(mut p, 0);
        adv(mut p);
        let al = alias_node(mut p, a, "*".to_string(), None);
        names.push(al);
    } else {
        let paren = is_op(mut p, 0, "(");
        if paren {
            adv(mut p);
        }
        loop {
            let a = ti(mut p, 0);
            if not is_name(mut p, 0) {
                return fail(mut p);
            }
            let name = tok_text(mut p, 0);
            adv(mut p);
            let asname = as_name(mut p);
            if failed(p) {
                return -1;
            }
            let al = alias_node(mut p, a, name, asname);
            names.push(al);
            if not is_op(mut p, 0, ",") {
                break;
            }
            adv(mut p);
            if paren and is_op(mut p, 0, ")") {
                break;
            }
        }
        if paren {
            if not is_op(mut p, 0, ")") {
                return fail(mut p);
            }
            adv(mut p);
        }
    }
    let id = mk(mut p.ast, "ImportFrom");
    match module {
        Some(m) => add_str(mut p.ast, id, "module", m),
        None => add_none(mut p.ast, id, "module"),
    }
    add_list(mut p.ast, id, "names", names);
    add_int(mut p.ast, id, "level", level);
    finish(mut p, id, s)
}

fn is_single_target(a: ref Ast, e: i64) -> bool {
    is(a, e, "Name") or is(a, e, "Attribute") or is(a, e, "Subscript")
}

fn augassign_op(p: mut ref P) -> String {
    let i = ti(mut p, 0);
    if p.toks[i].ty != T_OP {
        return String.new();
    }
    let table = vec![
        ("+=", "Add"), ("-=", "Sub"), ("*=", "Mult"), ("@=", "MatMult"), ("/=", "Div"), ("%=", "Mod"),
        ("&=", "BitAnd"), ("|=", "BitOr"), ("^=", "BitXor"), ("<<=", "LShift"), (">>=", "RShift"),
        ("**=", "Pow"), ("//=", "FloorDiv"),
    ];
    for (k, v) in table {
        if p.toks[i].s == k {
            return v.to_string();
        }
    }
    String.new()
}

fn rhs(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "yield") {
        yield_expr(mut p)
    } else {
        star_expressions(mut p)
    }
}

// Is the node a bitwise_or as the grammar has it, and so a candidate
// for "Maybe you meant '=='"?
fn is_bitwise_or_level(a: ref Ast, e: i64) -> bool {
    let bad = vec!["Compare", "BoolOp", "IfExp", "Lambda", "NamedExpr", "Starred", "Yield", "YieldFrom", "List", "Tuple", "GeneratorExp"];
    for b in bad {
        if is(a, e, b) {
            return false;
        }
    }
    if is(a, e, "UnaryOp") and is(a, kid(a, e, "op"), "Not") {
        return false;
    }
    if is(a, e, "Constant") {
        let k = const_kind(a, e);
        if k == C_TRUE or k == C_FALSE or k == C_NONE {
            return false;
        }
    }
    true
}

fn expr_or_assign(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    if is_name(mut p, 0) and is_op(mut p, 1, ":") {
        let target = name_node(mut p.ast, tok_text(mut p, 0), "Store");
        tok_pos(mut p, target, s);
        adv(mut p);
        return ann_assign(mut p, s, target, 1);
    }
    let e = star_expressions(mut p);
    if e < 0 {
        return -1;
    }
    if is_op(mut p, 0, ":") {
        if not is_single_target(p.ast, e) {
            return fail(mut p);
        }
        set_ctx(mut p.ast, e, "Store");
        return ann_assign(mut p, s, e, 0);
    }
    let op = augassign_op(mut p);
    if not op.is_empty() {
        if not is_single_target(p.ast, e) {
            let name = expr_name(p.ast, e);
            return raise_node(mut p, e, f"'{name}' is an illegal expression for augmented assignment");
        }
        set_ctx(mut p.ast, e, "Store");
        adv(mut p);
        let v = rhs(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "AugAssign");
        add_node(mut p.ast, id, "target", e);
        let o = op_node(mut p.ast, op.as_str());
        add_node(mut p.ast, id, "op", o);
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    if not is_op(mut p, 0, "=") {
        let id = mk(mut p.ast, "Expr");
        add_node(mut p.ast, id, "value", e);
        return finish(mut p, id, s);
    }
    let mut targets = vec![e];
    let mut value = -1;
    let mut rhs_start = -1;
    loop {
        adv(mut p);
        if rhs_start < 0 {
            rhs_start = ti(mut p, 0);
        }
        let v = rhs(mut p);
        if v < 0 {
            return -1;
        }
        if is_op(mut p, 0, "=") {
            targets.push(v);
            continue;
        }
        value = v;
        break;
    }
    let mut k = 0;
    while k < targets.len() {
        let t = targets[k];
        let bad = invalid_target(p.ast, t, TG_STAR);
        if bad >= 0 {
            let rt = p.toks[rhs_start].clone();
            let rhs_ok = not (rt.ty == T_NAME and (rt.s == "not" or rt.s == "lambda" or rt.s == "yield")) and not (rt.ty == T_OP and rt.s == "*");
            if k == 0 and targets.len() == 1 and rhs_ok and is_bitwise_or_level(p.ast, t) {
                let name = expr_name(p.ast, t);
                return raise_node(mut p, t, f"cannot assign to {name} here. Maybe you meant '==' instead of '='?");
            }
            let name = expr_name(p.ast, bad);
            return raise_node(mut p, bad, f"cannot assign to {name}");
        }
        k += 1;
    }
    for t in targets {
        set_ctx(mut p.ast, t, "Store");
    }
    let id = mk(mut p.ast, "Assign");
    add_list(mut p.ast, id, "targets", targets);
    add_node(mut p.ast, id, "value", value);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

fn ann_assign(p: mut ref P, s: i64, target: i64, simple: i64) -> i64 {
    adv(mut p);
    let ann = expression(mut p);
    if ann < 0 {
        return -1;
    }
    let mut v = -1;
    if is_op(mut p, 0, "=") {
        adv(mut p);
        v = rhs(mut p);
        if v < 0 {
            return -1;
        }
    }
    let id = mk(mut p.ast, "AnnAssign");
    add_node(mut p.ast, id, "target", target);
    add_node(mut p.ast, id, "annotation", ann);
    add_node(mut p.ast, id, "value", v);
    add_int(mut p.ast, id, "simple", simple);
    finish(mut p, id, s)
}

// `:` after a compound statement's header. A forced one (`&&':'`)
// reports "expected ':'" at whatever follows; the others only before a
// line end.
fn expect_colon(p: mut ref P, forced: bool) -> bool {
    if is_op(mut p, 0, ":") {
        adv(mut p);
        return true;
    }
    let i = ti(mut p, 0);
    if forced or p.toks[i].ty == T_NEWLINE {
        raise_tok(mut p, i, "expected ':'".to_string());
    } else {
        fail(mut p);
    }
    false
}

// A block after a `:`: an indented suite, or simple statements on the
// same line.
fn block(p: mut ref P, what: Str, line: i64) -> Vec[i64] {
    let mut body: Vec[i64] = Vec.new();
    if tty(mut p, 0) == T_NEWLINE {
        adv(mut p);
        if tty(mut p, 0) != T_INDENT {
            raise_last(mut p, "IndentationError", f"expected an indented block after {what} on line {line}");
            return body;
        }
        adv(mut p);
        while tty(mut p, 0) != T_DEDENT {
            statement(mut p, mut body);
            if failed(p) {
                return body;
            }
        }
        adv(mut p);
        return body;
    }
    simple_stmts(mut p, mut body);
    body
}

fn kw_line(p: mut ref P) -> i64 {
    let i = ti(mut p, 0);
    p.toks[i].l1
}

fn else_block(p: mut ref P) -> Vec[i64] {
    if not is_kw(mut p, 0, "else") {
        return Vec.new();
    }
    let line = kw_line(mut p);
    adv(mut p);
    if not expect_colon(mut p, true) {
        return Vec.new();
    }
    block(mut p, "'else' statement", line)
}

fn if_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    let what = if is_kw(mut p, 0, "elif") { "'elif' statement" } else { "'if' statement" };
    adv(mut p);
    let test = named_expression(mut p);
    if test < 0 {
        return -1;
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, what, line);
    if failed(p) {
        return -1;
    }
    let mut orelse: Vec[i64] = Vec.new();
    if is_kw(mut p, 0, "elif") {
        let e = if_stmt(mut p);
        if e < 0 {
            return -1;
        }
        orelse.push(e);
    } else {
        orelse = else_block(mut p);
        if failed(p) {
            return -1;
        }
    }
    let id = mk(mut p.ast, "If");
    add_node(mut p.ast, id, "test", test);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "orelse", orelse);
    finish(mut p, id, s)
}

fn while_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    adv(mut p);
    let test = named_expression(mut p);
    if test < 0 {
        return -1;
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, "'while' statement", line);
    if failed(p) {
        return -1;
    }
    let orelse = else_block(mut p);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, "While");
    add_node(mut p.ast, id, "test", test);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "orelse", orelse);
    finish(mut p, id, s)
}

fn for_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    let is_async = is_kw(mut p, 0, "async");
    if is_async {
        adv(mut p);
    }
    adv(mut p);
    let target = for_targets(mut p);
    if target < 0 {
        return -1;
    }
    if not is_kw(mut p, 0, "in") {
        return fail(mut p);
    }
    adv(mut p);
    let iter = star_expressions(mut p);
    if iter < 0 {
        return -1;
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, "'for' statement", line);
    if failed(p) {
        return -1;
    }
    let orelse = else_block(mut p);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, if is_async { "AsyncFor" } else { "For" });
    add_node(mut p.ast, id, "target", target);
    add_node(mut p.ast, id, "iter", iter);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "orelse", orelse);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

fn try_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    adv(mut p);
    if not expect_colon(mut p, true) {
        return -1;
    }
    let body = block(mut p, "'try' statement", line);
    if failed(p) {
        return -1;
    }
    let mut handlers: Vec[i64] = Vec.new();
    let mut star = false;
    while is_kw(mut p, 0, "except") {
        let hs = ti(mut p, 0);
        let hline = kw_line(mut p);
        adv(mut p);
        let mut what = "'except' statement";
        if is_op(mut p, 0, "*") {
            star = true;
            what = "'except*' statement";
            adv(mut p);
        }
        let mut typ = -1;
        let mut name: Option[String] = None;
        if not is_op(mut p, 0, ":") {
            typ = expression(mut p);
            if typ < 0 {
                return -1;
            }
            name = as_name(mut p);
            if failed(p) {
                return -1;
            }
        }
        if not expect_colon(mut p, false) {
            return -1;
        }
        let hb = block(mut p, what, hline);
        if failed(p) {
            return -1;
        }
        let h = mk(mut p.ast, "ExceptHandler");
        add_node(mut p.ast, h, "type", typ);
        match name {
            Some(n) => add_str(mut p.ast, h, "name", n),
            None => add_none(mut p.ast, h, "name"),
        }
        add_list(mut p.ast, h, "body", hb);
        finish(mut p, h, hs);
        handlers.push(h);
    }
    let orelse = if handlers.len() > 0 { else_block(mut p) } else { Vec.new() };
    if failed(p) {
        return -1;
    }
    let mut finalbody: Vec[i64] = Vec.new();
    if is_kw(mut p, 0, "finally") {
        let fline = kw_line(mut p);
        adv(mut p);
        if not expect_colon(mut p, true) {
            return -1;
        }
        finalbody = block(mut p, "'finally' statement", fline);
        if failed(p) {
            return -1;
        }
    }
    if handlers.len() == 0 and finalbody.len() == 0 {
        return fail(mut p);
    }
    let id = mk(mut p.ast, if star { "TryStar" } else { "Try" });
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "handlers", handlers);
    add_list(mut p.ast, id, "orelse", orelse);
    add_list(mut p.ast, id, "finalbody", finalbody);
    finish(mut p, id, s)
}

fn with_item(p: mut ref P) -> i64 {
    let e = expression(mut p);
    if e < 0 {
        return -1;
    }
    let mut t = -1;
    if is_kw(mut p, 0, "as") {
        adv(mut p);
        t = target_elem(mut p);
        if t < 0 {
            return -1;
        }
        if not (is_op(mut p, 0, ",") or is_op(mut p, 0, ")") or is_op(mut p, 0, ":")) {
            return fail(mut p);
        }
        let bad = invalid_target(p.ast, t, TG_STAR);
        if bad >= 0 {
            let name = expr_name(p.ast, bad);
            return raise_node(mut p, bad, f"cannot assign to {name}");
        }
        set_ctx(mut p.ast, t, "Store");
    }
    let id = mk(mut p.ast, "withitem");
    add_node(mut p.ast, id, "context_expr", e);
    add_node(mut p.ast, id, "optional_vars", t);
    id
}

fn with_items(p: mut ref P, paren: bool) -> Vec[i64] {
    let mut items: Vec[i64] = Vec.new();
    loop {
        let it = with_item(mut p);
        if it < 0 {
            return items;
        }
        items.push(it);
        if not is_op(mut p, 0, ",") {
            return items;
        }
        adv(mut p);
        if paren and is_op(mut p, 0, ")") {
            return items;
        }
    }
}

fn with_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    let is_async = is_kw(mut p, 0, "async");
    if is_async {
        adv(mut p);
    }
    adv(mut p);
    let mut items: Vec[i64] = Vec.new();
    let mut done = false;
    if is_op(mut p, 0, "(") {
        // `with (a as b, c):`, tried first; on failure the parenthesis
        // is read again as the start of an expression.
        let save = p.pos;
        adv(mut p);
        items = with_items(mut p, true);
        if not failed(p) and is_op(mut p, 0, ")") and is_op(mut p, 1, ":") {
            adv(mut p);
            done = true;
        } else if p.ek == EK_TOKEN {
            return -1;
        } else {
            p.ek = EK_NONE;
            p.pos = save;
        }
    }
    if not done {
        items = with_items(mut p, false);
        if failed(p) {
            return -1;
        }
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, "'with' statement", line);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, if is_async { "AsyncWith" } else { "With" });
    add_list(mut p.ast, id, "items", items);
    add_list(mut p.ast, id, "body", body);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

fn def_or_class(p: mut ref P, decos: own Vec[i64]) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    if is_kw(mut p, 0, "class") {
        adv(mut p);
        if not is_name(mut p, 0) {
            return fail(mut p);
        }
        let name = tok_text(mut p, 0);
        adv(mut p);
        let mut bases: Vec[i64] = Vec.new();
        let mut kws: Vec[i64] = Vec.new();
        if is_op(mut p, 0, "(") {
            if call_args(mut p, false, mut bases, mut kws) < 0 {
                return -1;
            }
        }
        if not expect_colon(mut p, false) {
            return -1;
        }
        let body = block(mut p, "class definition", line);
        if failed(p) {
            return -1;
        }
        let id = mk(mut p.ast, "ClassDef");
        add_str(mut p.ast, id, "name", name);
        add_list(mut p.ast, id, "bases", bases);
        add_list(mut p.ast, id, "keywords", kws);
        add_list(mut p.ast, id, "body", body);
        add_list(mut p.ast, id, "decorator_list", decos);
        add_list(mut p.ast, id, "type_params", Vec.new());
        return finish(mut p, id, s);
    }
    let is_async = is_kw(mut p, 0, "async");
    if is_async {
        adv(mut p);
    }
    if not is_kw(mut p, 0, "def") {
        return fail(mut p);
    }
    adv(mut p);
    if not is_name(mut p, 0) {
        return fail(mut p);
    }
    let name = tok_text(mut p, 0);
    adv(mut p);
    if not is_op(mut p, 0, "(") {
        return fail(mut p);
    }
    adv(mut p);
    let args = params(mut p, false);
    if args < 0 {
        return -1;
    }
    if not is_op(mut p, 0, ")") {
        return fail(mut p);
    }
    adv(mut p);
    let mut returns = -1;
    if is_op(mut p, 0, "->") {
        adv(mut p);
        returns = expression(mut p);
        if returns < 0 {
            return -1;
        }
    }
    if not expect_colon(mut p, true) {
        return -1;
    }
    let body = block(mut p, "function definition", line);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, if is_async { "AsyncFunctionDef" } else { "FunctionDef" });
    add_str(mut p.ast, id, "name", name);
    add_node(mut p.ast, id, "args", args);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "decorator_list", decos);
    add_node(mut p.ast, id, "returns", returns);
    add_none(mut p.ast, id, "type_comment");
    add_list(mut p.ast, id, "type_params", Vec.new());
    finish(mut p, id, s)
}

// ------------------------------------------------------------ entry

struct Parsed {
    ast: Ast,
    root: i64,
    ok: bool,
    etype: String,
    emsg: String,
    eline: i64,
    ecol: i64,
}

fn run_parser(src: ref Vec[i64], eval_mode: bool) -> Parsed {
    let mut p = new_parser(src);
    let root = if eval_mode { parse_eval(mut p) } else { parse_module(mut p) };
    if root >= 0 and not failed(p) {
        return Parsed { ast: p.ast, root: root, ok: true, etype: String.new(), emsg: String.new(), eline: 0, ecol: 0 };
    }
    finish_error(mut p);
    Parsed { ast: p.ast, root: -1, ok: false, etype: p.etype, emsg: p.emsg, eline: p.eline, ecol: p.ecol }
}

// ------------------------------------------------------------ values
//
// Python's values, as far as an expression can make or meet them. A
// dict keeps its keys in insertion order; a set keeps its elements in
// insertion order and is written in CPython's order where that is
// known (small non-negative ints, which sit in their own slots).

#[derive(Clone)]
struct Dct {
    ks: Vec[V],
    vs: Vec[V],
}

#[derive(Clone)]
enum V {
    Nil,
    Bool(bool),
    Int(i128),
    Float(f64),
    Str(String),
    List(Vec[V]),
    Tuple(Vec[V]),
    Dict(Dct),
    Set(Vec[V]),
    // a builtin function or class, by its name
    Func(String),
    // a bound method: the receiver and the method's name
    Method(Vec[V], String),
    Range(i128, i128, i128),
    // a dict view: 0 keys, 1 values, 2 items
    View(i64, Dct),
    // a slice object: start, stop, step
    Slice(Vec[V]),
    // complex, bytes and Ellipsis, which an expression can only hand back:
    // the type's name and the repr
    Raw(String, String),
}

struct PyErr {
    kind: String,
    msg: String,
}

fn perr(kind: Str, msg: ref String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg.clone() }
}

fn terr(msg: ref String) -> PyErr {
    perr("TypeError", msg)
}

fn verr(msg: ref String) -> PyErr {
    perr("ValueError", msg)
}

fn new_dict() -> Dct {
    Dct { ks: Vec.new(), vs: Vec.new() }
}

fn s_val(s: Str) -> V {
    V.Str(s.to_string())
}

fn is_class(n: ref String) -> bool {
    n == "int" or n == "float" or n == "str" or n == "list" or n == "tuple" or n == "dict" or n == "set" or n == "range"
}

fn tname(v: ref V) -> String {
    match v {
        V.Nil => "NoneType".to_string(),
        V.Bool(_) => "bool".to_string(),
        V.Int(_) => "int".to_string(),
        V.Float(_) => "float".to_string(),
        V.Str(_) => "str".to_string(),
        V.List(_) => "list".to_string(),
        V.Tuple(_) => "tuple".to_string(),
        V.Dict(_) => "dict".to_string(),
        V.Set(_) => "set".to_string(),
        V.Func(n) => {
            if is_class(n) {
                "type".to_string()
            } else if n == "randint" {
                "function".to_string()
            } else {
                "builtin_function_or_method".to_string()
            }
        }
        V.Method(_, _) => "builtin_function_or_method".to_string(),
        V.Range(_, _, _) => "range".to_string(),
        V.View(k, _) => {
            if k == 0 {
                "dict_keys".to_string()
            } else if k == 1 {
                "dict_values".to_string()
            } else {
                "dict_items".to_string()
            }
        }
        V.Slice(_) => "slice".to_string(),
        V.Raw(t, _) => t.clone(),
    }
}

// ------------------------------------------------------------ float text

// repr(x) of a float
fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == f64.INFINITY {
        return "inf".to_string();
    }
    if x == -f64.INFINITY {
        return "-inf".to_string();
    }
    f"{x}"
}

// The exact decimal value of |x|: its digits and where the point goes.
// Every double's expansion ends within 1074 places.
struct Exact {
    d: Vec[i64],
    point: i64,
}

fn exact_digits(x: f64) -> Exact {
    let ax = if is_neg(x) { -x } else { x };
    let text = f"{ax:.1100}";
    let mut d: Vec[i64] = Vec.new();
    let mut point = -1;
    for c in text.bytes() {
        let n = c as i64;
        if n == 46 {
            point = d.len();
        } else {
            d.push(n - 48);
        }
    }
    if point < 0 {
        point = d.len();
    }
    Exact { d: d, point: point }
}

// The first `keep` digits of `d`, rounded half to even on what follows.
// The result may be one digit longer when the rounding carries out.
fn round_digits(d: ref Vec[i64], keep: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < keep {
        out.push(if k < d.len() { d[k] } else { 0 });
        k += 1;
    }
    if keep < 0 or keep >= d.len() {
        return out;
    }
    let first = d[keep];
    let mut rest = false;
    let mut j = keep + 1;
    while j < d.len() {
        if d[j] != 0 {
            rest = true;
            break;
        }
        j += 1;
    }
    let prev_odd = keep > 0 and d[keep - 1] % 2 == 1;
    let up = first > 5 or (first == 5 and (rest or prev_odd));
    if up {
        let mut i = keep - 1;
        let mut carry = true;
        while i >= 0 and carry {
            if out[i] == 9 {
                out[i] = 0;
                i -= 1;
            } else {
                out[i] += 1;
                carry = false;
            }
        }
        if carry {
            let mut grown: Vec[i64] = vec![1];
            for v in out.iter() {
                grown.push(v);
            }
            return grown;
        }
    }
    out
}

fn digits_str(d: ref Vec[i64], from: i64, to: i64) -> String {
    let mut s = String.new();
    let mut k = from;
    while k < to {
        let c = if k >= 0 and k < d.len() { d[k] } else { 0 };
        s.push(((c + 48) as u8) as char);
        k += 1;
    }
    s
}

// |x| with `prec` places after the point, correctly rounded
fn fixed_text(x: f64, prec: i64, alt: bool) -> String {
    let e = exact_digits(x);
    let keep = e.point + prec;
    if keep < 0 {
        return if prec > 0 { f"0.{digits_str(Vec.new(), 0, prec)}" } else if alt { "0.".to_string() } else { "0".to_string() };
    }
    let r = round_digits(e.d, keep);
    let point = e.point + (r.len() - keep);
    // the whole part without its leading zeros, keeping one
    let mut lead = 0;
    while lead + 1 < point and r[lead] == 0 {
        lead += 1;
    }
    let ip = if point <= 0 { "0".to_string() } else { digits_str(r, lead, point) };
    if prec > 0 {
        return f"{ip}.{digits_str(r, point, r.len())}";
    }
    if alt { f"{ip}." } else { ip }
}

// |x| as d.ddde+XX with `prec` digits after the point
fn exp_text(x: f64, prec: i64, upper: bool, alt: bool) -> String {
    let e = exact_digits(x);
    let mut first = -1;
    let mut k = 0;
    while k < e.d.len() {
        if e.d[k] != 0 {
            first = k;
            break;
        }
        k += 1;
    }
    let mut digits: Vec[i64] = Vec.new();
    let mut ex = 0;
    if first < 0 {
        let mut j = 0;
        while j <= prec {
            digits.push(0);
            j += 1;
        }
    } else {
        let mut tail: Vec[i64] = Vec.new();
        let mut j = first;
        while j < e.d.len() {
            tail.push(e.d[j]);
            j += 1;
        }
        ex = e.point - first - 1;
        digits = round_digits(tail, prec + 1);
        if digits.len() > prec + 1 {
            digits.pop();
            ex += 1;
        }
    }
    let mut s = digits_str(digits, 0, 1);
    if prec > 0 or alt {
        s.push('.');
    }
    s.push_str(digits_str(digits, 1, digits.len()));
    s.push(if upper { 'E' } else { 'e' });
    s.push(if ex < 0 { '-' } else { '+' });
    let a = if ex < 0 { -ex } else { ex };
    if a < 10 {
        s.push('0');
    }
    s.push_str(f"{a}");
    s
}

fn is_neg(x: f64) -> bool {
    x < 0.0 or (x == 0.0 and 1.0 / x < 0.0)
}

// ------------------------------------------------------------ repr and str

fn set_order(v: ref Vec[V]) -> Vec[V] {
    if v.len() > 4 {
        return v.clone();
    }
    let mut small: Vec[i64] = Vec.new();
    for x in v.iter() {
        let n = match x {
            V.Int(n) => n as i64,
            V.Bool(b) => if b { 1 } else { 0 },
            _ => return v.clone(),
        };
        if n < 0 or n >= 8 {
            return v.clone();
        }
        small.push(n);
    }
    let mut out: Vec[V] = Vec.new();
    for want in 0..8 {
        let mut k = 0;
        while k < small.len() {
            if small[k] == want {
                out.push(v[k].clone());
            }
            k += 1;
        }
    }
    out
}

fn join_reprs(v: ref Vec[V]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in v.iter() {
        parts.push(repr(x));
    }
    join(parts, ", ")
}

fn repr(v: ref V) -> String {
    match v {
        V.Nil => "None".to_string(),
        V.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        V.Int(n) => f"{n}",
        V.Float(x) => float_repr(x),
        V.Str(s) => pr(s),
        V.List(xs) => f"[{join_reprs(xs)}]",
        V.Tuple(xs) => {
            if xs.len() == 1 {
                f"({repr(xs[0])},)"
            } else {
                f"({join_reprs(xs)})"
            }
        }
        V.Dict(d) => dict_repr(d),
        V.Set(xs) => {
            if xs.len() == 0 {
                "set()".to_string()
            } else {
                f"{{{join_reprs(set_order(xs))}}}"
            }
        }
        V.Func(n) => {
            if is_class(n) {
                f"<class '{n}'>"
            } else if n == "rand" {
                "<built-in method random of Random object>".to_string()
            } else if n == "randint" {
                "<function random_int>".to_string()
            } else {
                f"<built-in function {n}>"
            }
        }
        V.Method(r, n) => f"<built-in method {n} of {tname(r[0])} object>",
        V.Range(a, b, s) => {
            if s == 1 {
                f"range({a}, {b})"
            } else {
                f"range({a}, {b}, {s})"
            }
        }
        V.View(k, d) => {
            let items = view_items(k, d);
            f"{tname(v)}([{join_reprs(items)}])"
        }
        V.Slice(p) => f"slice({repr(p[0])}, {repr(p[1])}, {repr(p[2])})",
        V.Raw(_, r) => r.clone(),
    }
}

fn dict_repr(d: ref Dct) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut k = 0;
    while k < d.ks.len() {
        parts.push(f"{repr(d.ks[k])}: {repr(d.vs[k])}");
        k += 1;
    }
    f"{{{join(parts, ", ")}}}"
}

fn view_items(k: i64, d: ref Dct) -> Vec[V] {
    if k == 0 {
        return d.ks.clone();
    }
    if k == 1 {
        return d.vs.clone();
    }
    let mut out: Vec[V] = Vec.new();
    let mut i = 0;
    while i < d.ks.len() {
        out.push(V.Tuple(vec![d.ks[i].clone(), d.vs[i].clone()]));
        i += 1;
    }
    out
}

// str(v)
fn to_str(v: ref V) -> String {
    match v {
        V.Str(s) => s.clone(),
        _ => repr(v),
    }
}

fn truthy(v: ref V) -> bool {
    match v {
        V.Nil => false,
        V.Bool(b) => b,
        V.Int(n) => n != 0,
        V.Float(x) => x != 0.0,
        V.Str(s) => s.len() > 0,
        V.List(xs) => xs.len() > 0,
        V.Tuple(xs) => xs.len() > 0,
        V.Dict(d) => d.ks.len() > 0,
        V.Set(xs) => xs.len() > 0,
        V.Range(a, b, s) => range_len(a, b, s) > 0,
        V.View(_, d) => d.ks.len() > 0,
        _ => true,
    }
}

fn range_len(a: i128, b: i128, s: i128) -> i128 {
    if s > 0 {
        if b <= a { 0 } else { (b - a + s - 1) / s }
    } else {
        if b >= a { 0 } else { (a - b - s - 1) / (-s) }
    }
}

// The length when the value has one (hasattr(v, '__len__')).
fn len_of(v: ref V) -> Option[i128] {
    match v {
        V.Str(s) => Some(cps(s).len() as i128),
        V.List(xs) => Some(xs.len() as i128),
        V.Tuple(xs) => Some(xs.len() as i128),
        V.Dict(d) => Some(d.ks.len() as i128),
        V.Set(xs) => Some(xs.len() as i128),
        V.Range(a, b, s) => Some(range_len(a, b, s)),
        V.View(_, d) => Some(d.ks.len() as i128),
        V.Raw(t, r) => {
            if t == "bytes" {
                Some((r.len() - 3) as i128)
            } else {
                None
            }
        }
        _ => None,
    }
}

// ------------------------------------------------------------ equality and hashing

// A number's value as a float, for comparing across int, float and bool.
fn num_of(v: ref V) -> Option[f64] {
    match v {
        V.Bool(b) => Some(if b { 1.0 } else { 0.0 }),
        V.Int(n) => Some(n as f64),
        V.Float(x) => Some(x),
        _ => None,
    }
}

fn int_of(v: ref V) -> Option[i128] {
    match v {
        V.Bool(b) => Some(if b { 1 } else { 0 }),
        V.Int(n) => Some(n),
        _ => None,
    }
}

fn is_num(v: ref V) -> bool {
    match v {
        V.Bool(_) => true,
        V.Int(_) => true,
        V.Float(_) => true,
        _ => false,
    }
}

fn seq_eq(a: ref Vec[V], b: ref Vec[V]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut k = 0;
    while k < a.len() {
        if not py_eq(a[k], b[k]) {
            return false;
        }
        k += 1;
    }
    true
}

fn contains_eq(xs: ref Vec[V], x: ref V) -> bool {
    for y in xs.iter() {
        if py_eq(y, x) {
            return true;
        }
    }
    false
}

fn py_eq(a: ref V, b: ref V) -> bool {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => return x == y,
        _ => {}
    }
    if is_num(a) and is_num(b) {
        return num_of(a).unwrap_or(0.0) == num_of(b).unwrap_or(0.0);
    }
    match (a, b) {
        (V.Nil, V.Nil) => true,
        (V.Str(x), V.Str(y)) => x == y,
        (V.List(x), V.List(y)) => seq_eq(x, y),
        (V.Tuple(x), V.Tuple(y)) => seq_eq(x, y),
        (V.Dict(x), V.Dict(y)) => {
            if x.ks.len() != y.ks.len() {
                return false;
            }
            let mut k = 0;
            while k < x.ks.len() {
                match dict_find(y, x.ks[k]) {
                    Some(i) => {
                        if not py_eq(x.vs[k], y.vs[i]) {
                            return false;
                        }
                    }
                    None => return false,
                }
                k += 1;
            }
            true
        }
        (V.Set(x), V.Set(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for e in x.iter() {
                if not contains_eq(y, e) {
                    return false;
                }
            }
            true
        }
        (V.Func(x), V.Func(y)) => x == y,
        (V.Range(a1, b1, s1), V.Range(a2, b2, s2)) => a1 == a2 and b1 == b2 and s1 == s2,
        _ => false,
    }
}

// The unhashable type inside a value, if any (a list, dict or set).
fn unhashable(v: ref V) -> Option[String] {
    match v {
        V.List(_) => Some("list".to_string()),
        V.Dict(_) => Some("dict".to_string()),
        V.Set(_) => Some("set".to_string()),
        V.View(_, _) => Some(tname(v)),
        V.Slice(_) => Some("slice".to_string()),
        V.Tuple(xs) => {
            for x in xs.iter() {
                if let Some(t) = unhashable(x) {
                    return Some(t);
                }
            }
            None
        }
        _ => None,
    }
}

fn check_hash(v: ref V) -> Result[(), PyErr] {
    match unhashable(v) {
        Some(t) => Err(terr(f"unhashable type: '{t}'")),
        None => Ok(()),
    }
}

fn dict_find(d: ref Dct, k: ref V) -> Option[i64] {
    let mut i = 0;
    while i < d.ks.len() {
        if py_eq(d.ks[i], k) {
            return Some(i);
        }
        i += 1;
    }
    None
}

fn dict_set(d: mut ref Dct, k: own V, v: own V) -> Result[(), PyErr] {
    check_hash(k)?;
    match dict_find(d, k) {
        Some(i) => d.vs[i] = v,
        None => {
            d.ks.push(k);
            d.vs.push(v);
        }
    }
    Ok(())
}

fn dict_get(d: ref Dct, k: ref V) -> Result[Option[V], PyErr] {
    check_hash(k)?;
    match dict_find(d, k) {
        Some(i) => Ok(Some(d.vs[i].clone())),
        None => Ok(None),
    }
}

fn set_add(xs: mut ref Vec[V], v: own V) -> Result[(), PyErr] {
    check_hash(v)?;
    if not contains_eq(xs, v) {
        xs.push(v);
    }
    Ok(())
}

// ------------------------------------------------------------ iteration

fn chars_of(s: ref String) -> Vec[V] {
    let mut out: Vec[V] = Vec.new();
    for c in s.chars() {
        out.push(V.Str(f"{c}"));
    }
    out
}

// iter(v), drained: what a for loop over the value sees
fn iterate(v: ref V) -> Result[Vec[V], PyErr] {
    match v {
        V.Str(s) => Ok(chars_of(s)),
        V.List(xs) => Ok(xs.clone()),
        V.Tuple(xs) => Ok(xs.clone()),
        V.Set(xs) => Ok(set_order(xs)),
        V.Dict(d) => Ok(d.ks.clone()),
        V.View(k, d) => Ok(view_items(k, d)),
        V.Range(a, b, s) => {
            let mut out: Vec[V] = Vec.new();
            let n = range_len(a, b, s);
            let mut i: i128 = 0;
            while i < n {
                out.push(V.Int(a + i * s));
                i += 1;
            }
            Ok(out)
        }
        _ => Err(terr(f"'{tname(v)}' object is not iterable")),
    }
}
// ------------------------------------------------------------ operators
//
// The `operator` functions simpleeval maps the AST's operators to, with
// the TypeErrors Python raises when a type does not support one. An
// int is 128 bits here; going past that is an OverflowError naming the
// port, which no job reaches.

fn unsupported(sym: Str, a: ref V, b: ref V) -> PyErr {
    terr(f"unsupported operand type(s) for {sym}: '{tname(a)}' and '{tname(b)}'")
}

fn big(r: Option[i128]) -> Result[V, PyErr] {
    match r {
        Some(n) => Ok(V.Int(n)),
        None => Err(perr("OverflowError", "the port's ints stop at 128 bits")),
    }
}

fn is_seq(v: ref V) -> bool {
    match v {
        V.Str(_) => true,
        V.List(_) => true,
        V.Tuple(_) => true,
        _ => false,
    }
}

fn op_add(a: ref V, b: ref V) -> Result[V, PyErr] {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => return big(x.checked_add(y)),
        _ => {}
    }
    if is_num(a) and is_num(b) {
        return Ok(V.Float(num_of(a).unwrap_or(0.0) + num_of(b).unwrap_or(0.0)));
    }
    match (a, b) {
        (V.Str(x), V.Str(y)) => return Ok(V.Str(f"{x}{y}")),
        (V.List(x), V.List(y)) => {
            let mut out = x.clone();
            for e in y.iter() {
                out.push(e.clone());
            }
            return Ok(V.List(out));
        }
        (V.Tuple(x), V.Tuple(y)) => {
            let mut out = x.clone();
            for e in y.iter() {
                out.push(e.clone());
            }
            return Ok(V.Tuple(out));
        }
        _ => {}
    }
    match a {
        V.Str(_) => Err(terr(f"can only concatenate str (not \"{tname(b)}\") to str")),
        V.List(_) => Err(terr(f"can only concatenate list (not \"{tname(b)}\") to list")),
        V.Tuple(_) => Err(terr(f"can only concatenate tuple (not \"{tname(b)}\") to tuple")),
        _ => Err(unsupported("+", a, b)),
    }
}

fn op_sub(a: ref V, b: ref V) -> Result[V, PyErr] {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => return big(x.checked_sub(y)),
        _ => {}
    }
    if is_num(a) and is_num(b) {
        return Ok(V.Float(num_of(a).unwrap_or(0.0) - num_of(b).unwrap_or(0.0)));
    }
    match (a, b) {
        (V.Set(x), V.Set(y)) => {
            let mut out: Vec[V] = Vec.new();
            for e in x.iter() {
                if not contains_eq(y, e) {
                    out.push(e.clone());
                }
            }
            Ok(V.Set(out))
        }
        _ => Err(unsupported("-", a, b)),
    }
}

fn repeat(a: ref V, n: i128) -> Result[V, PyErr] {
    let mut k: i128 = 0;
    match a {
        V.Str(s) => {
            let mut out = String.new();
            while k < n {
                out.push_str(s);
                k += 1;
            }
            Ok(V.Str(out))
        }
        V.List(xs) => {
            let mut out: Vec[V] = Vec.new();
            while k < n {
                for e in xs.iter() {
                    out.push(e.clone());
                }
                k += 1;
            }
            Ok(V.List(out))
        }
        V.Tuple(xs) => {
            let mut out: Vec[V] = Vec.new();
            while k < n {
                for e in xs.iter() {
                    out.push(e.clone());
                }
                k += 1;
            }
            Ok(V.Tuple(out))
        }
        _ => Ok(V.Nil),
    }
}

fn op_mul(a: ref V, b: ref V) -> Result[V, PyErr] {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => return big(x.checked_mul(y)),
        _ => {}
    }
    if is_num(a) and is_num(b) {
        return Ok(V.Float(num_of(a).unwrap_or(0.0) * num_of(b).unwrap_or(0.0)));
    }
    if is_seq(a) {
        return match int_of(b) {
            Some(n) => repeat(a, n),
            None => Err(terr(f"can't multiply sequence by non-int of type '{tname(b)}'")),
        };
    }
    if is_seq(b) {
        return match int_of(a) {
            Some(n) => repeat(b, n),
            None => Err(terr(f"can't multiply sequence by non-int of type '{tname(a)}'")),
        };
    }
    Err(unsupported("*", a, b))
}

fn op_truediv(a: ref V, b: ref V) -> Result[V, PyErr] {
    if not (is_num(a) and is_num(b)) {
        return Err(unsupported("/", a, b));
    }
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => {
            if y == 0 {
                return Err(perr("ZeroDivisionError", "division by zero"));
            }
            return Ok(V.Float((x as f64) / (y as f64)));
        }
        _ => {}
    }
    let y = num_of(b).unwrap_or(0.0);
    if y == 0.0 {
        return Err(perr("ZeroDivisionError", "float division by zero"));
    }
    Ok(V.Float(num_of(a).unwrap_or(0.0) / y))
}

fn copysign0(of: f64) -> f64 {
    if is_neg(of) { -0.0 } else { 0.0 }
}

// floatobject.c's float_divmod: (floor quotient, remainder)
fn float_divmod(vx: f64, wx: f64) -> (f64, f64) {
    let mut m = vx % wx;
    let mut div = (vx - m) / wx;
    if m != 0.0 {
        if (wx < 0.0) != (m < 0.0) {
            m += wx;
            div -= 1.0;
        }
    } else {
        m = copysign0(wx);
    }
    let mut fd = 0.0;
    if div != 0.0 {
        fd = div.floor();
        if div - fd > 0.5 {
            fd += 1.0;
        }
    } else {
        fd = copysign0(vx / wx);
    }
    (fd, m)
}

fn op_floordiv(a: ref V, b: ref V) -> Result[V, PyErr] {
    if not (is_num(a) and is_num(b)) {
        return Err(unsupported("//", a, b));
    }
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => {
            if y == 0 {
                return Err(perr("ZeroDivisionError", "integer division or modulo by zero"));
            }
            let mut q = x / y;
            if x % y != 0 and ((x < 0) != (y < 0)) {
                q -= 1;
            }
            return Ok(V.Int(q));
        }
        _ => {}
    }
    let y = num_of(b).unwrap_or(0.0);
    if y == 0.0 {
        return Err(perr("ZeroDivisionError", "float floor division by zero"));
    }
    let (q, _) = float_divmod(num_of(a).unwrap_or(0.0), y);
    Ok(V.Float(q))
}

fn op_mod(a: ref V, b: ref V) -> Result[V, PyErr] {
    if let V.Str(s) = a {
        return printf(s, b);
    }
    if not (is_num(a) and is_num(b)) {
        return Err(unsupported("%", a, b));
    }
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => {
            if y == 0 {
                return Err(perr("ZeroDivisionError", "integer modulo by zero"));
            }
            let mut r = x % y;
            if r != 0 and ((r < 0) != (y < 0)) {
                r += y;
            }
            return Ok(V.Int(r));
        }
        _ => {}
    }
    let wx = num_of(b).unwrap_or(0.0);
    if wx == 0.0 {
        return Err(perr("ZeroDivisionError", "float modulo by zero"));
    }
    let vx = num_of(a).unwrap_or(0.0);
    let mut m = vx % wx;
    if m != 0.0 {
        if (wx < 0.0) != (m < 0.0) {
            m += wx;
        }
    } else {
        m = copysign0(wx);
    }
    Ok(V.Float(m))
}

fn int_pow(x: i128, y: i128) -> Result[V, PyErr] {
    let mut result: i128 = 1;
    let mut base = x;
    let mut e = y;
    while e > 0 {
        if e % 2 == 1 {
            result = match result.checked_mul(base) {
                Some(r) => r,
                None => return big(None),
            };
        }
        e = e / 2;
        if e > 0 {
            base = match base.checked_mul(base) {
                Some(r) => r,
                None => return big(None),
            };
        }
    }
    Ok(V.Int(result))
}

fn float_pow(iv: f64, iw: f64) -> Result[V, PyErr] {
    if iw == 0.0 {
        return Ok(V.Float(1.0));
    }
    if iv == 0.0 and iw < 0.0 {
        return Err(perr("ZeroDivisionError", "0.0 cannot be raised to a negative power"));
    }
    if iv < 0.0 and iw != iw.floor() and iw == iw and iw != f64.INFINITY and iw != -f64.INFINITY {
        return Err(perr("NotImplementedError", "complex results are not in the port"));
    }
    let r = iv.pow(iw);
    let finite_in = iv == iv and iw == iw and iv != f64.INFINITY and iv != -f64.INFINITY and iw != f64.INFINITY and iw != -f64.INFINITY;
    if finite_in and (r == f64.INFINITY or r == -f64.INFINITY) {
        return Err(perr("OverflowError", "(34, 'Numerical result out of range')"));
    }
    Ok(V.Float(r))
}

fn op_pow(a: ref V, b: ref V) -> Result[V, PyErr] {
    if not (is_num(a) and is_num(b)) {
        return Err(unsupported("** or pow()", a, b));
    }
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => {
            if y >= 0 {
                return int_pow(x, y);
            }
            return float_pow(x as f64, y as f64);
        }
        _ => {}
    }
    float_pow(num_of(a).unwrap_or(0.0), num_of(b).unwrap_or(0.0))
}

fn op_shift(a: ref V, b: ref V, left: bool) -> Result[V, PyErr] {
    let sym = if left { "<<" } else { ">>" };
    match (int_of(a), int_of(b)) {
        (Some(x), Some(n)) => {
            if n < 0 {
                return Err(verr("negative shift count"));
            }
            if not left {
                if n >= 127 {
                    return Ok(V.Int(if x < 0 { -1 } else { 0 }));
                }
                return Ok(V.Int(x >> n));
            }
            if x == 0 {
                return Ok(V.Int(0));
            }
            if n >= 127 {
                return big(None);
            }
            let r = x << n;
            if (r >> n) != x {
                return big(None);
            }
            Ok(V.Int(r))
        }
        _ => Err(unsupported(sym, a, b)),
    }
}

fn op_bits(a: ref V, b: ref V, sym: Str) -> Result[V, PyErr] {
    match (a, b) {
        (V.Bool(x), V.Bool(y)) => {
            return Ok(V.Bool(if sym == "&" { x and y } else if sym == "|" { x or y } else { x != y }));
        }
        _ => {}
    }
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => {
            return Ok(V.Int(if sym == "&" { x & y } else if sym == "|" { x | y } else { x ^ y }));
        }
        _ => {}
    }
    match (a, b) {
        (V.Set(x), V.Set(y)) => {
            let mut out: Vec[V] = Vec.new();
            if sym == "&" {
                for e in x.iter() {
                    if contains_eq(y, e) {
                        out.push(e.clone());
                    }
                }
            } else if sym == "|" {
                out = x.clone();
                for e in y.iter() {
                    if not contains_eq(out, e) {
                        out.push(e.clone());
                    }
                }
            } else {
                for e in x.iter() {
                    if not contains_eq(y, e) {
                        out.push(e.clone());
                    }
                }
                for e in y.iter() {
                    if not contains_eq(x, e) {
                        out.push(e.clone());
                    }
                }
            }
            Ok(V.Set(out))
        }
        (V.Dict(x), V.Dict(y)) => {
            if sym != "|" {
                return Err(unsupported(sym, a, b));
            }
            let mut out = x.clone();
            let mut k = 0;
            while k < y.ks.len() {
                dict_set(mut out, y.ks[k].clone(), y.vs[k].clone())?;
                k += 1;
            }
            Ok(V.Dict(out))
        }
        _ => Err(unsupported(sym, a, b)),
    }
}

fn op_neg(v: ref V) -> Result[V, PyErr] {
    match v {
        V.Bool(b) => Ok(V.Int(if b { -1 } else { 0 })),
        V.Int(n) => big(n.checked_neg()),
        V.Float(x) => Ok(V.Float(-x)),
        _ => Err(terr(f"bad operand type for unary -: '{tname(v)}'")),
    }
}

fn op_pos(v: ref V) -> Result[V, PyErr] {
    match v {
        V.Bool(b) => Ok(V.Int(if b { 1 } else { 0 })),
        V.Int(n) => Ok(V.Int(n)),
        V.Float(x) => Ok(V.Float(x)),
        _ => Err(terr(f"bad operand type for unary +: '{tname(v)}'")),
    }
}

fn op_invert(v: ref V) -> Result[V, PyErr] {
    match int_of(v) {
        Some(n) => Ok(V.Int(-n - 1)),
        None => Err(terr(f"bad operand type for unary ~: '{tname(v)}'")),
    }
}

// ------------------------------------------------------------ comparisons

fn ord_of(c: i64, op: Str) -> bool {
    // c is -1, 0 or 1, for a < b, a == b and a > b
    if op == "<" {
        c < 0
    } else if op == "<=" {
        c <= 0
    } else if op == ">" {
        c > 0
    } else {
        c >= 0
    }
}

fn cmp_cps(x: ref Vec[i64], y: ref Vec[i64]) -> i64 {
    let mut k = 0;
    while k < x.len() and k < y.len() {
        if x[k] != y[k] {
            return if x[k] < y[k] { -1 } else { 1 };
        }
        k += 1;
    }
    if x.len() < y.len() {
        -1
    } else if x.len() > y.len() {
        1
    } else {
        0
    }
}

fn seq_order(x: ref Vec[V], y: ref Vec[V], op: Str) -> Result[bool, PyErr] {
    let mut k = 0;
    while k < x.len() and k < y.len() {
        if not py_eq(x[k], y[k]) {
            return py_order(x[k], y[k], op);
        }
        k += 1;
    }
    let c = if x.len() < y.len() { -1 } else if x.len() > y.len() { 1 } else { 0 };
    Ok(ord_of(c, op))
}

fn subset(x: ref Vec[V], y: ref Vec[V]) -> bool {
    for e in x.iter() {
        if not contains_eq(y, e) {
            return false;
        }
    }
    true
}

// a < b, a <= b, a > b or a >= b
fn py_order(a: ref V, b: ref V, op: Str) -> Result[bool, PyErr] {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => {
            return Ok(ord_of(if x < y { -1 } else if x > y { 1 } else { 0 }, op));
        }
        _ => {}
    }
    if is_num(a) and is_num(b) {
        let x = num_of(a).unwrap_or(0.0);
        let y = num_of(b).unwrap_or(0.0);
        return Ok(if op == "<" { x < y } else if op == "<=" { x <= y } else if op == ">" { x > y } else { x >= y });
    }
    match (a, b) {
        (V.Str(x), V.Str(y)) => Ok(ord_of(cmp_cps(cps(x), cps(y)), op)),
        (V.List(x), V.List(y)) => seq_order(x, y, op),
        (V.Tuple(x), V.Tuple(y)) => seq_order(x, y, op),
        (V.Set(x), V.Set(y)) => {
            let sub = subset(x, y);
            let sup = subset(y, x);
            Ok(if op == "<" {
                sub and x.len() < y.len()
            } else if op == "<=" {
                sub
            } else if op == ">" {
                sup and x.len() > y.len()
            } else {
                sup
            })
        }
        _ => Err(terr(f"'{op}' not supported between instances of '{tname(a)}' and '{tname(b)}'")),
    }
}

// item in container
fn py_contains(container: ref V, item: ref V) -> Result[bool, PyErr] {
    match container {
        V.Str(s) => match item {
            V.Str(t) => Ok(s.contains(t)),
            _ => Err(terr(f"'in <string>' requires string as left operand, not {tname(item)}")),
        },
        V.List(xs) => Ok(contains_eq(xs, item)),
        V.Tuple(xs) => Ok(contains_eq(xs, item)),
        V.Set(xs) => {
            check_hash(item)?;
            Ok(contains_eq(xs, item))
        }
        V.Dict(d) => {
            check_hash(item)?;
            Ok(dict_find(d, item).is_some())
        }
        V.View(k, d) => {
            if k == 0 {
                check_hash(item)?;
                return Ok(dict_find(d, item).is_some());
            }
            Ok(contains_eq(view_items(k, d), item))
        }
        V.Range(_, _, _) => Ok(contains_eq(iterate(container)?, item)),
        _ => Err(terr(f"argument of type '{tname(container)}' is not iterable")),
    }
}

// `a is b`, for the values whose identity Python fixes: None, the bools,
// the cached small ints and the builtins
fn py_is(a: ref V, b: ref V) -> bool {
    match (a, b) {
        (V.Nil, V.Nil) => true,
        (V.Bool(x), V.Bool(y)) => x == y,
        (V.Int(x), V.Int(y)) => x == y and x >= -5 and x <= 256,
        (V.Func(x), V.Func(y)) => x == y,
        _ => false,
    }
}
// ------------------------------------------------------------ format()
//
// format(value, spec), as an f-string's `{x:spec}` runs it: the format
// mini-language of int, float and str (the presentation types the jobs
// meet; `g`, `n` and a float's bare precision are left out).

struct Spec {
    fill: i64,
    align: i64,
    sign: i64,
    z: bool,
    alt: bool,
    width: i64,
    group: i64,
    prec: i64,
    ty: i64,
}

fn spec_error(spec: ref Vec[i64], t: ref String) -> PyErr {
    verr(f"Invalid format specifier '{to_string(spec)}' for object of type '{t}'")
}

fn is_align_c(c: i64) -> bool {
    c == 60 or c == 62 or c == 61 or c == 94
}

fn parse_spec(spec: ref Vec[i64], t: ref String) -> Result[Spec, PyErr] {
    let mut s = Spec { fill: 32, align: 0, sign: 0, z: false, alt: false, width: -1, group: 0, prec: -1, ty: 0 };
    let n = spec.len();
    let mut i = 0;
    if n >= 2 and is_align_c(spec[1]) {
        s.fill = spec[0];
        s.align = spec[1];
        i = 2;
    } else if n >= 1 and is_align_c(spec[0]) {
        s.align = spec[0];
        i = 1;
    }
    if i < n and (spec[i] == 43 or spec[i] == 45 or spec[i] == 32) {
        s.sign = spec[i];
        i += 1;
    }
    if i < n and spec[i] == 122 {
        s.z = true;
        i += 1;
    }
    if i < n and spec[i] == 35 {
        s.alt = true;
        i += 1;
    }
    if i < n and spec[i] == 48 {
        if s.align == 0 {
            s.fill = 48;
            s.align = 61;
        }
        i += 1;
    }
    let mut w = -1;
    while i < n and is_digit(spec[i]) {
        w = (if w < 0 { 0 } else { w }) * 10 + spec[i] - 48;
        i += 1;
    }
    s.width = w;
    if i < n and (spec[i] == 44 or spec[i] == 95) {
        s.group = spec[i];
        i += 1;
    }
    if i < n and spec[i] == 46 {
        i += 1;
        let mut p = -1;
        while i < n and is_digit(spec[i]) {
            p = (if p < 0 { 0 } else { p }) * 10 + spec[i] - 48;
            i += 1;
        }
        if p < 0 {
            return Err(verr("Format specifier missing precision"));
        }
        s.prec = p;
    }
    if n - i > 1 {
        return Err(spec_error(spec, t));
    }
    if i < n {
        s.ty = spec[i];
    }
    Ok(s)
}

fn ch(c: i64) -> String {
    to_string(vec![c])
}

fn pad_to(body: ref String, prefix: ref String, s: ref Spec, default_align: i64) -> String {
    let len = cps(body).len() + cps(prefix).len();
    if s.width <= len {
        return f"{prefix}{body}";
    }
    let gap = s.width - len;
    let align = if s.align == 0 { default_align } else { s.align };
    let mut fill = String.new();
    let mut k = 0;
    while k < gap {
        fill.push_str(ch(s.fill));
        k += 1;
    }
    if align == 60 {
        return f"{prefix}{body}{fill}";
    }
    if align == 62 {
        return f"{fill}{prefix}{body}";
    }
    if align == 61 {
        return f"{prefix}{fill}{body}";
    }
    let left = gap / 2;
    let mut lf = String.new();
    let mut rf = String.new();
    k = 0;
    while k < gap {
        if k < left {
            lf.push_str(ch(s.fill));
        } else {
            rf.push_str(ch(s.fill));
        }
        k += 1;
    }
    f"{lf}{prefix}{body}{rf}"
}

// digits with a separator every `every` from the right
fn group_digits(d: ref String, sep: i64, every: i64) -> String {
    let c = cps(d);
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < c.len() {
        if k > 0 and (c.len() - k) % every == 0 {
            out.push(sep);
        }
        out.push(c[k]);
        k += 1;
    }
    to_string(out)
}

fn sign_of(neg: bool, s: ref Spec) -> String {
    if neg {
        "-".to_string()
    } else if s.sign == 43 {
        "+".to_string()
    } else if s.sign == 32 {
        " ".to_string()
    } else {
        String.new()
    }
}

fn base_digits(n: i128, base: i128, upper: bool) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let digits = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" };
    let dc = cps(digits.to_string());
    let mut out: Vec[i64] = Vec.new();
    let mut v = n;
    while v > 0 {
        out.push(dc[(v % base) as i64]);
        v = v / base;
    }
    out.reverse();
    to_string(out)
}

fn format_int(n: i128, s: ref Spec) -> Result[String, PyErr] {
    let t = s.ty;
    if t == 101 or t == 69 or t == 102 or t == 70 or t == 37 {
        return format_float(n as f64, s);
    }
    if not (t == 0 or t == 100 or t == 98 or t == 111 or t == 120 or t == 88) {
        return Err(verr(f"Unknown format code '{ch(t)}' for object of type 'int'"));
    }
    if s.prec >= 0 {
        return Err(verr("Precision not allowed in integer format specifier"));
    }
    if s.group == 44 and t != 0 and t != 100 {
        return Err(verr(f"Cannot specify ',' with '{ch(t)}'."));
    }
    let a = if n < 0 { -n } else { n };
    let base: i128 = if t == 98 { 2 } else if t == 111 { 8 } else if t == 120 or t == 88 { 16 } else { 10 };
    let mut body = base_digits(a, base, t == 88);
    if s.group != 0 {
        body = group_digits(body, s.group, if base == 10 { 3 } else { 4 });
    }
    let mut prefix = sign_of(n < 0, s);
    if s.alt {
        prefix.push_str(if t == 98 { "0b" } else if t == 111 { "0o" } else if t == 120 { "0x" } else if t == 88 { "0X" } else { "" });
    }
    Ok(pad_to(body, prefix, s, 62))
}

fn format_float(x: f64, s: ref Spec) -> Result[String, PyErr] {
    let t = s.ty;
    if not (t == 0 or t == 101 or t == 69 or t == 102 or t == 70 or t == 37) {
        return Err(verr(f"Unknown format code '{ch(t)}' for object of type 'float'"));
    }
    if t == 0 and s.prec >= 0 {
        return Err(perr("NotImplementedError", "a float's bare precision is not in the port"));
    }
    let mut neg = is_neg(x);
    let upper = t == 69 or t == 70;
    let mut body = String.new();
    if x != x {
        neg = false;
        body = if upper { "NAN".to_string() } else { "nan".to_string() };
        if t == 37 {
            body.push('%');
        }
    } else if x == f64.INFINITY or x == -f64.INFINITY {
        body = if upper { "INF".to_string() } else { "inf".to_string() };
        if t == 37 {
            body.push('%');
        }
    } else {
        let p = if s.prec < 0 { 6 } else { s.prec };
        if t == 0 {
            body = float_repr(if x < 0.0 { -x } else { x });
            if body.starts_with("-") {
                body = "0.0".to_string();
            }
        } else if t == 101 or t == 69 {
            body = exp_text(x, p, upper, s.alt);
        } else if t == 37 {
            body = fixed_text(x * 100.0, p, s.alt);
            body.push('%');
        } else {
            body = fixed_text(x, p, s.alt);
        }
        if s.z and neg {
            let mut zero = true;
            for c in body.chars() {
                if c >= '1' and c <= '9' {
                    zero = false;
                }
            }
            if zero {
                neg = false;
            }
        }
        if s.group != 0 {
            let c = cps(body);
            let mut k = 0;
            while k < c.len() and is_digit(c[k]) {
                k += 1;
            }
            let whole = to_string(slice(c, 0, k));
            let rest = to_string(slice(c, k, c.len()));
            body = f"{group_digits(whole, s.group, 3)}{rest}";
        }
    }
    Ok(pad_to(body, sign_of(neg, s), s, 62))
}

fn format_str(text: ref String, s: ref Spec) -> Result[String, PyErr] {
    if s.ty != 0 and s.ty != 115 {
        return Err(verr(f"Unknown format code '{ch(s.ty)}' for object of type 'str'"));
    }
    if s.sign != 0 {
        return Err(verr("Sign not allowed in string format specifier"));
    }
    if s.alt {
        return Err(verr("Alternate form (#) not allowed in string format specifier"));
    }
    if s.align == 61 {
        return Err(verr("'=' alignment not allowed in string format specifier"));
    }
    if s.group != 0 {
        return Err(verr(f"Cannot specify '{ch(s.group)}' with 's'."));
    }
    let mut body = text.clone();
    if s.prec >= 0 {
        let c = cps(text);
        if c.len() > s.prec {
            body = to_string(slice(c, 0, s.prec));
        }
    }
    Ok(pad_to(body, String.new(), s, 60))
}

// format(v, spec)
fn py_format(v: ref V, spec: ref String) -> Result[String, PyErr] {
    let sp = cps(spec);
    if sp.len() == 0 {
        return Ok(to_str(v));
    }
    match v {
        V.Bool(b) => format_int(if b { 1 } else { 0 }, parse_spec(sp, tname(v))?),
        V.Int(n) => format_int(n, parse_spec(sp, tname(v))?),
        V.Float(x) => format_float(x, parse_spec(sp, tname(v))?),
        V.Str(s) => format_str(s, parse_spec(sp, tname(v))?),
        _ => Err(terr(f"unsupported format string passed to {tname(v)}.__format__")),
    }
}

// "{:" + spec + "}".format(v): the spec runs to the first '}', and a
// '{' in it is a field of its own, which no job writes
fn format_via_str(v: ref V, spec: ref String) -> Result[String, PyErr] {
    let c = cps(spec);
    for x in c.iter() {
        if x == 123 or x == 125 {
            return Err(perr("NotImplementedError", "a brace in a format spec is not in the port"));
        }
    }
    py_format(v, spec)
}

// ------------------------------------------------------------ str % args
//
// printf-style formatting: %s, %r, %d, %i, %u, %x, %X, %o, %f, %F, %e,
// %E and %%, with flags, a width and a precision.

fn printf(fmt: ref String, args: ref V) -> Result[V, PyErr] {
    let items: Vec[V] = match args {
        V.Tuple(xs) => xs.clone(),
        _ => vec![args.clone()],
    };
    let c = cps(fmt);
    let mut out = String.new();
    let mut next = 0;
    let mut i = 0;
    while i < c.len() {
        if c[i] != 37 {
            out.push_str(ch(c[i]));
            i += 1;
            continue;
        }
        i += 1;
        if i >= c.len() {
            return Err(verr("incomplete format"));
        }
        if c[i] == 37 {
            out.push('%');
            i += 1;
            continue;
        }
        let mut left = false;
        let mut plus = false;
        let mut space = false;
        let mut zero = false;
        let mut alt = false;
        while i < c.len() and (c[i] == 45 or c[i] == 43 or c[i] == 32 or c[i] == 48 or c[i] == 35) {
            if c[i] == 45 {
                left = true;
            } else if c[i] == 43 {
                plus = true;
            } else if c[i] == 32 {
                space = true;
            } else if c[i] == 48 {
                zero = true;
            } else {
                alt = true;
            }
            i += 1;
        }
        let mut width = 0;
        while i < c.len() and is_digit(c[i]) {
            width = width * 10 + c[i] - 48;
            i += 1;
        }
        let mut prec = -1;
        if i < c.len() and c[i] == 46 {
            i += 1;
            prec = 0;
            while i < c.len() and is_digit(c[i]) {
                prec = prec * 10 + c[i] - 48;
                i += 1;
            }
        }
        if i >= c.len() {
            return Err(verr("incomplete format"));
        }
        let conv = c[i];
        i += 1;
        if next >= items.len() {
            return Err(terr("not enough arguments for format string"));
        }
        let arg = items[next].clone();
        next += 1;
        let mut sign = String.new();
        let mut body = String.new();
        let numeric = not (conv == 115 or conv == 114 or conv == 97);
        if conv == 115 {
            body = to_str(arg);
        } else if conv == 114 {
            body = repr(arg);
        } else if conv == 100 or conv == 105 or conv == 117 {
            let n: i128 = match arg {
                V.Bool(b) => if b { 1 } else { 0 },
                V.Int(n) => n,
                V.Float(x) => x as i128,
                _ => return Err(terr(f"%{ch(conv)} format: a real number is required, not {tname(arg)}")),
            };
            if n < 0 {
                sign = "-".to_string();
            }
            body = f"{if n < 0 { -n } else { n }}";
        } else if conv == 120 or conv == 88 or conv == 111 {
            let n = match int_of(arg) {
                Some(n) => n,
                None => return Err(terr(f"%{ch(conv)} format: an integer is required, not {tname(arg)}")),
            };
            if n < 0 {
                sign = "-".to_string();
            }
            let base: i128 = if conv == 111 { 8 } else { 16 };
            body = base_digits(if n < 0 { -n } else { n }, base, conv == 88);
            if alt {
                body = f"{if conv == 111 { "0o" } else if conv == 120 { "0x" } else { "0X" }}{body}";
            }
        } else if conv == 102 or conv == 70 or conv == 101 or conv == 69 {
            let x = match num_of(arg) {
                Some(x) => x,
                None => return Err(terr(f"must be real number, not {tname(arg)}")),
            };
            if is_neg(x) {
                sign = "-".to_string();
            }
            let p = if prec < 0 { 6 } else { prec };
            body = if x != x {
                "nan".to_string()
            } else if x == f64.INFINITY or x == -f64.INFINITY {
                "inf".to_string()
            } else if conv == 101 or conv == 69 {
                exp_text(x, p, conv == 69, alt)
            } else {
                fixed_text(x, p, alt)
            };
        } else {
            return Err(verr(f"unsupported format character '{ch(conv)}' (0x{base_digits(conv as i128, 16, false)}) at index {i - 1}"));
        }
        if not numeric and prec >= 0 {
            let bc = cps(body);
            if bc.len() > prec {
                body = to_string(slice(bc, 0, prec));
            }
        }
        if numeric and sign.len() == 0 {
            if plus {
                sign = "+".to_string();
            } else if space {
                sign = " ".to_string();
            }
        }
        let len = cps(body).len() + cps(sign).len();
        let mut fill = String.new();
        let mut k = len;
        let zero_pad = zero and numeric and not left;
        while k < width {
            fill.push(if zero_pad { '0' } else { ' ' });
            k += 1;
        }
        if left {
            out.push_str(f"{sign}{body}{fill}");
        } else if zero_pad {
            out.push_str(f"{sign}{fill}{body}");
        } else {
            out.push_str(f"{fill}{sign}{body}");
        }
    }
    if next < items.len() {
        return Err(terr("not all arguments converted during string formatting"));
    }
    Ok(V.Str(out))
}
// ------------------------------------------------------------ attributes
//
// getattr(v, name) for the types an expression meets: their methods
// (bound to the value) and their data attributes. A method that exists
// but is not ported can still be looked up; calling it says so.

fn has_name(names: Str, name: ref String) -> bool {
    for n in names.split(" ") {
        if n == name {
            return true;
        }
    }
    false
}

const STR_METHODS: Str = "capitalize casefold center count encode endswith expandtabs find format format_map index isalnum isalpha isascii isdecimal isdigit isidentifier islower isnumeric isprintable isspace istitle isupper join ljust lower lstrip maketrans partition removeprefix removesuffix replace rfind rindex rjust rpartition rsplit rstrip split splitlines startswith strip swapcase title translate upper zfill";
const DICT_METHODS: Str = "clear copy fromkeys get items keys pop popitem setdefault update values";
const LIST_METHODS: Str = "append clear copy count extend index insert pop remove reverse sort";
const SET_METHODS: Str = "add clear copy difference difference_update discard intersection intersection_update isdisjoint issubset issuperset pop remove symmetric_difference symmetric_difference_update union update";
const INT_METHODS: Str = "as_integer_ratio bit_count bit_length conjugate from_bytes is_integer to_bytes";
const FLOAT_METHODS: Str = "as_integer_ratio conjugate fromhex hex is_integer";

fn bound(v: ref V, name: ref String) -> Option[V] {
    Some(V.Method(vec![v.clone()], name.clone()))
}

fn get_attr(v: ref V, name: ref String) -> Option[V] {
    match v {
        V.Str(_) => if has_name(STR_METHODS, name) { bound(v, name) } else { None },
        V.Dict(_) => if has_name(DICT_METHODS, name) { bound(v, name) } else { None },
        V.List(_) => if has_name(LIST_METHODS, name) { bound(v, name) } else { None },
        V.Tuple(_) => if has_name("count index", name) { bound(v, name) } else { None },
        V.Set(_) => if has_name(SET_METHODS, name) { bound(v, name) } else { None },
        V.Bool(_) => int_attr(v, int_of(v).unwrap_or(0), name),
        V.Int(n) => int_attr(v, n, name),
        V.Float(x) => {
            if name == "real" {
                Some(V.Float(x))
            } else if name == "imag" {
                Some(V.Float(0.0))
            } else if has_name(FLOAT_METHODS, name) {
                bound(v, name)
            } else {
                None
            }
        }
        V.Range(a, b, s) => {
            if name == "start" {
                Some(V.Int(a))
            } else if name == "stop" {
                Some(V.Int(b))
            } else if name == "step" {
                Some(V.Int(s))
            } else if has_name("count index", name) {
                bound(v, name)
            } else {
                None
            }
        }
        _ => None,
    }
}

fn int_attr(v: ref V, n: i128, name: ref String) -> Option[V] {
    if name == "real" or name == "numerator" {
        Some(V.Int(n))
    } else if name == "imag" {
        Some(V.Int(0))
    } else if name == "denominator" {
        Some(V.Int(1))
    } else if has_name(INT_METHODS, name) {
        bound(v, name)
    } else {
        None
    }
}

// ------------------------------------------------------------ calls

struct Kw {
    // None for a `**x`, whose key is None in simpleeval's keyword dict
    name: Option[String],
    v: V,
}

fn kw_get(kw: ref Vec[Kw], name: Str) -> Option[V] {
    for k in kw.iter() {
        if let Some(n) = k.name {
            if n == name {
                return Some(k.v.clone());
            }
        }
    }
    None
}

// an argument's index (operator.index): an int or a bool
fn as_index(v: ref V) -> Result[i128, PyErr] {
    match int_of(v) {
        Some(n) => Ok(n),
        None => Err(terr(f"'{tname(v)}' object cannot be interpreted as an integer")),
    }
}

fn want_str(v: ref V, msg: Str) -> Result[String, PyErr] {
    match v {
        V.Str(s) => Ok(s.clone()),
        _ => Err(terr(f"{msg}{tname(v)}")),
    }
}

fn no_args(t: Str, name: ref String, args: ref Vec[V]) -> Result[(), PyErr] {
    if args.len() > 0 {
        return Err(terr(f"{t}.{name}() takes no arguments ({args.len()} given)"));
    }
    Ok(())
}

fn not_ported(t: ref String, name: ref String) -> PyErr {
    perr("NotImplementedError", f"{t}.{name}() is not in the port")
}

fn call_method(recv: ref V, name: ref String, args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    match recv {
        V.Str(s) => str_method(s, name, args, kw),
        V.Dict(d) => {
            if name == "get" {
                if args.len() < 1 {
                    return Err(terr(f"get expected at least 1 argument, got {args.len()}"));
                }
                let dflt = if args.len() > 1 { args[1].clone() } else { V.Nil };
                return match dict_get(d, args[0])? {
                    Some(v) => Ok(v),
                    None => Ok(dflt),
                };
            }
            if name == "keys" or name == "values" or name == "items" {
                no_args("dict", name, args)?;
                let k = if name == "keys" { 0 } else if name == "values" { 1 } else { 2 };
                return Ok(V.View(k, d.clone()));
            }
            if name == "copy" {
                return Ok(V.Dict(d.clone()));
            }
            Err(not_ported("dict", name))
        }
        V.List(xs) => seq_method("list", xs, name, args),
        V.Tuple(xs) => seq_method("tuple", xs, name, args),
        V.Bool(_) => int_method(recv, name, args),
        V.Int(_) => int_method(recv, name, args),
        V.Float(x) => {
            if name == "is_integer" {
                no_args("float", name, args)?;
                return Ok(V.Bool(x == x.floor()));
            }
            Err(not_ported("float", name))
        }
        _ => Err(not_ported(tname(recv), name)),
    }
}

fn int_method(recv: ref V, name: ref String, args: ref Vec[V]) -> Result[V, PyErr] {
    let n = int_of(recv).unwrap_or(0);
    if name == "bit_length" {
        no_args("int", name, args)?;
        let mut a = if n < 0 { -n } else { n };
        let mut bits = 0;
        while a > 0 {
            bits += 1;
            a = a >> 1;
        }
        return Ok(V.Int(bits));
    }
    if name == "is_integer" {
        no_args("int", name, args)?;
        return Ok(V.Bool(true));
    }
    if name == "conjugate" {
        no_args("int", name, args)?;
        return Ok(V.Int(n));
    }
    Err(not_ported("int", name))
}

fn seq_method(t: Str, xs: ref Vec[V], name: ref String, args: ref Vec[V]) -> Result[V, PyErr] {
    if name == "count" {
        if args.len() != 1 {
            return Err(terr(f"{t}.count() takes exactly one argument ({args.len()} given)"));
        }
        let mut n = 0;
        for x in xs.iter() {
            if py_eq(x, args[0]) {
                n += 1;
            }
        }
        return Ok(V.Int(n));
    }
    if name == "index" {
        if args.len() < 1 {
            return Err(terr(f"index expected at least 1 argument, got {args.len()}"));
        }
        let mut k = 0;
        while k < xs.len() {
            if py_eq(xs[k], args[0]) {
                return Ok(V.Int(k as i128));
            }
            k += 1;
        }
        if t == "list" {
            return Err(verr(f"{repr(args[0])} is not in list"));
        }
        return Err(verr("tuple.index(x): x not in tuple"));
    }
    if name == "copy" and t == "list" {
        return Ok(V.List(xs.clone()));
    }
    Err(not_ported(t.to_string(), name))
}

// ------------------------------------------------------------ str methods

// str.isspace
fn is_py_space(c: i64) -> bool {
    (c >= 9 and c <= 13) or (c >= 28 and c <= 32) or c == 0x85 or c == 0xA0 or c == 0x1680
        or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn drop_cp(chars: ref Option[Vec[i64]], x: i64) -> bool {
    match chars {
        Some(cs) => {
            for y in cs.iter() {
                if y == x {
                    return true;
                }
            }
            false
        }
        None => is_py_space(x),
    }
}

fn py_strip_cps(c: ref Vec[i64], chars: ref Option[Vec[i64]], left: bool, right: bool) -> Vec[i64] {
    let mut a = 0;
    let mut b = c.len();
    if left {
        while a < b and drop_cp(chars, c[a]) {
            a += 1;
        }
    }
    if right {
        while b > a and drop_cp(chars, c[b - 1]) {
            b -= 1;
        }
    }
    slice(c, a, b)
}

fn py_strip(s: ref String) -> String {
    to_string(py_strip_cps(cps(s), None, true, true))
}

fn find_cps(h: ref Vec[i64], n: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i + n.len() <= h.len() {
        let mut k = 0;
        while k < n.len() and h[i + k] == n[k] {
            k += 1;
        }
        if k == n.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn str_list(parts: ref Vec[Vec[i64]]) -> V {
    let mut out: Vec[V] = Vec.new();
    for p in parts.iter() {
        out.push(V.Str(to_string(p)));
    }
    V.List(out)
}

fn split_ws(c: ref Vec[i64], maxsplit: i128) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    let n = c.len();
    let mut splits: i128 = 0;
    while i < n {
        while i < n and is_py_space(c[i]) {
            i += 1;
        }
        if i >= n {
            break;
        }
        if maxsplit >= 0 and splits >= maxsplit {
            let mut j = n;
            while j > i and is_py_space(c[j - 1]) {
                j -= 1;
            }
            out.push(slice(c, i, j));
            break;
        }
        let start = i;
        while i < n and not is_py_space(c[i]) {
            i += 1;
        }
        out.push(slice(c, start, i));
        splits += 1;
    }
    out
}

fn split_sep(c: ref Vec[i64], sep: ref Vec[i64], maxsplit: i128) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut start = 0;
    let mut splits: i128 = 0;
    loop {
        if maxsplit >= 0 and splits >= maxsplit {
            break;
        }
        let at = find_cps(c, sep, start);
        if at < 0 {
            break;
        }
        out.push(slice(c, start, at));
        start = at + sep.len();
        splits += 1;
    }
    out.push(slice(c, start, c.len()));
    out
}

fn upper_cp(s: ref String) -> String {
    s.to_uppercase()
}

fn lower_cp(s: ref String) -> String {
    s.to_lowercase()
}

fn title_case(s: ref String) -> String {
    let mut out = String.new();
    let mut prev_cased = false;
    for c in s.chars() {
        let t = f"{c}";
        let cased = t.to_uppercase() != t.to_lowercase();
        if cased {
            out.push_str(if prev_cased { t.to_lowercase() } else { t.to_uppercase() });
        } else {
            out.push_str(t);
        }
        prev_cased = cased;
    }
    out
}

fn prefix_match(c: ref Vec[i64], p: ref Vec[i64], at_end: bool) -> bool {
    if p.len() > c.len() {
        return false;
    }
    let off = if at_end { c.len() - p.len() } else { 0 };
    let mut k = 0;
    while k < p.len() {
        if c[off + k] != p[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn str_method(s: ref String, name: ref String, args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    let c = cps(s);
    if name == "upper" or name == "lower" or name == "title" or name == "capitalize" or name == "isdigit" or name == "isalpha" or name == "isspace" {
        no_args("str", name, args)?;
        if name == "upper" {
            return Ok(V.Str(upper_cp(s)));
        }
        if name == "lower" {
            return Ok(V.Str(lower_cp(s)));
        }
        if name == "title" {
            return Ok(V.Str(title_case(s)));
        }
        if name == "capitalize" {
            if c.len() == 0 {
                return Ok(s_val(""));
            }
            let head = upper_cp(to_string(slice(c, 0, 1)));
            let tail = lower_cp(to_string(slice(c, 1, c.len())));
            return Ok(V.Str(f"{head}{tail}"));
        }
        let mut all = c.len() > 0;
        for x in c.iter() {
            let ok = if name == "isdigit" {
                x >= 48 and x <= 57
            } else if name == "isspace" {
                is_py_space(x)
            } else {
                (x >= 65 and x <= 90) or (x >= 97 and x <= 122) or (x >= 0xC0 and x != 0xD7 and x != 0xF7 and x < 0x2000)
            };
            if not ok {
                all = false;
            }
        }
        return Ok(V.Bool(all));
    }
    if name == "strip" or name == "lstrip" or name == "rstrip" {
        let chars: Option[Vec[i64]] = if args.len() > 0 {
            match args[0] {
                V.Nil => None,
                V.Str(t) => Some(cps(t)),
                _ => return Err(terr(f"{name} arg must be None or str")),
            }
        } else {
            None
        };
        return Ok(V.Str(to_string(py_strip_cps(c, chars, name != "rstrip", name != "lstrip"))));
    }
    if name == "split" {
        let sep_v = if args.len() > 0 { Some(args[0].clone()) } else { kw_get(kw, "sep") };
        let max_v = if args.len() > 1 { Some(args[1].clone()) } else { kw_get(kw, "maxsplit") };
        let maxsplit = match max_v {
            Some(m) => as_index(m)?,
            None => -1,
        };
        return match sep_v {
            None => Ok(str_list(split_ws(c, maxsplit))),
            Some(V.Nil) => Ok(str_list(split_ws(c, maxsplit))),
            Some(V.Str(t)) => {
                let sep = cps(t);
                if sep.len() == 0 {
                    return Err(verr("empty separator"));
                }
                Ok(str_list(split_sep(c, sep, maxsplit)))
            }
            Some(other) => Err(terr(f"must be str or None, not {tname(other)}")),
        };
    }
    if name == "startswith" or name == "endswith" {
        if args.len() < 1 {
            return Err(terr(f"{name}() takes at least 1 argument (0 given)"));
        }
        let at_end = name == "endswith";
        return match args[0] {
            V.Str(p) => Ok(V.Bool(prefix_match(c, cps(p), at_end))),
            V.Tuple(ps) => {
                for p in ps.iter() {
                    match p {
                        V.Str(t) => {
                            if prefix_match(c, cps(t), at_end) {
                                return Ok(V.Bool(true));
                            }
                        }
                        _ => return Err(terr(f"tuple for {name} must only contain str, not {tname(p)}")),
                    }
                }
                Ok(V.Bool(false))
            }
            _ => Err(terr(f"{name} first arg must be str or a tuple of str, not {tname(args[0])}")),
        };
    }
    if name == "replace" {
        if args.len() < 2 {
            return Err(terr(f"replace() takes at least 2 positional arguments ({args.len()} given)"));
        }
        let old = cps(want_str(args[0], "replace() argument 1 must be str, not ")?);
        let new = cps(want_str(args[1], "replace() argument 2 must be str, not ")?);
        let count = if args.len() > 2 { as_index(args[2])? } else { -1 };
        let mut out: Vec[i64] = Vec.new();
        let mut done: i128 = 0;
        if old.len() == 0 {
            let mut k = 0;
            while k <= c.len() {
                if count < 0 or done < count {
                    push_all(mut out, new);
                    done += 1;
                }
                if k < c.len() {
                    out.push(c[k]);
                }
                k += 1;
            }
            return Ok(V.Str(to_string(out)));
        }
        let mut i = 0;
        while i < c.len() {
            if (count < 0 or done < count) and prefix_match(slice(c, i, c.len()), old, false) {
                push_all(mut out, new);
                i += old.len();
                done += 1;
            } else {
                out.push(c[i]);
                i += 1;
            }
        }
        return Ok(V.Str(to_string(out)));
    }
    if name == "join" {
        if args.len() != 1 {
            return Err(terr(f"str.join() takes exactly one argument ({args.len()} given)"));
        }
        let items = iterate(args[0])?;
        let mut out = String.new();
        let mut k = 0;
        while k < items.len() {
            match items[k] {
                V.Str(t) => {
                    if k > 0 {
                        out.push_str(s);
                    }
                    out.push_str(t);
                }
                _ => return Err(terr(f"sequence item {k}: expected str instance, {tname(items[k])} found")),
            }
            k += 1;
        }
        return Ok(V.Str(out));
    }
    if name == "find" or name == "count" {
        if args.len() < 1 {
            return Err(terr(f"{name} expected at least 1 argument, got 0"));
        }
        let sub = match args[0] {
            V.Str(t) => cps(t),
            _ => {
                return Err(terr(if name == "count" {
                    f"count() argument 1 must be str, not {tname(args[0])}"
                } else {
                    f"must be str, not {tname(args[0])}"
                }));
            }
        };
        if name == "find" {
            return Ok(V.Int(find_cps(c, sub, 0) as i128));
        }
        if sub.len() == 0 {
            return Ok(V.Int((c.len() + 1) as i128));
        }
        let mut n = 0;
        let mut at = find_cps(c, sub, 0);
        while at >= 0 {
            n += 1;
            at = find_cps(c, sub, at + sub.len());
        }
        return Ok(V.Int(n));
    }
    if name == "zfill" or name == "ljust" or name == "rjust" or name == "center" {
        if args.len() < 1 {
            return Err(terr(f"{name} expected at least 1 argument, got 0"));
        }
        let width = as_index(args[0])? as i64;
        let fill = if args.len() > 1 {
            let f = cps(want_str(args[1], "The fill character must be a unicode character, not ")?);
            if f.len() != 1 {
                return Err(terr("The fill character must be exactly one character long"));
            }
            f[0]
        } else if name == "zfill" {
            48
        } else {
            32
        };
        if width <= c.len() {
            return Ok(V.Str(s.clone()));
        }
        let pad = width - c.len();
        let mut fills: Vec[i64] = Vec.new();
        let mut k = 0;
        while k < pad {
            fills.push(fill);
            k += 1;
        }
        let mut out: Vec[i64] = Vec.new();
        if name == "ljust" {
            push_all(mut out, c);
            push_all(mut out, fills);
        } else if name == "rjust" {
            push_all(mut out, fills);
            push_all(mut out, c);
        } else if name == "zfill" {
            if c.len() > 0 and (c[0] == 43 or c[0] == 45) {
                out.push(c[0]);
                push_all(mut out, fills);
                push_all(mut out, slice(c, 1, c.len()));
            } else {
                push_all(mut out, fills);
                push_all(mut out, c);
            }
        } else {
            let left = pad / 2 + (pad & width & 1);
            push_all(mut out, slice(fills, 0, left));
            push_all(mut out, c);
            push_all(mut out, slice(fills, left, pad));
        }
        return Ok(V.Str(to_string(out)));
    }
    if name == "removeprefix" or name == "removesuffix" {
        if args.len() != 1 {
            return Err(terr(f"str.{name}() takes exactly one argument ({args.len()} given)"));
        }
        let p = match args[0] {
            V.Str(t) => cps(t),
            _ => return Err(terr(f"{name}() argument must be str, not {tname(args[0])}")),
        };
        let end = name == "removesuffix";
        if p.len() > 0 and prefix_match(c, p, end) {
            return Ok(V.Str(to_string(if end { slice(c, 0, c.len() - p.len()) } else { slice(c, p.len(), c.len()) })));
        }
        return Ok(V.Str(s.clone()));
    }
    Err(not_ported("str", name))
}
// ------------------------------------------------------------ builtins
//
// The functions an evaluator is given: simpleeval's defaults (rand,
// randint, int, float, str), the containers EvalWithCompoundTypes adds
// (list, tuple, dict, set), and the builtins the programs here pass in.

struct Rng {
    state: u64,
}

impl Rng {
    // rand() and randint() draw from a fixed-seed generator, so a run
    // is repeatable; no job prints a draw
    fn next(mut ref self) -> f64 {
        let mut x = self.state;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        self.state = x;
        ((x >> 11) as f64) / 9007199254740992.0
    }
}

fn no_kw(name: Str, kw: ref Vec[Kw]) -> Result[(), PyErr] {
    if kw.len() > 0 {
        return Err(terr(f"{name}() takes no keyword arguments"));
    }
    Ok(())
}

fn check_kw(name: Str, kw: ref Vec[Kw], allowed: Str) -> Result[(), PyErr] {
    for k in kw.iter() {
        match k.name {
            Some(n) => {
                if not has_name(allowed, n) {
                    return Err(terr(f"{name}() got an unexpected keyword argument '{n}'"));
                }
            }
            None => return Err(terr("keywords must be strings")),
        }
    }
    Ok(())
}

// int(s, base): whitespace around, a sign, the base's prefix where the
// base allows it, and single underscores between digits
fn int_bad(base: i128, s: ref String) -> PyErr {
    verr(f"invalid literal for int() with base {base}: {pr(s)}")
}

fn parse_int_str(s: ref String, base0: i128) -> Result[V, PyErr] {
    let c = py_strip_cps(cps(s), None, true, true);
    let mut i = 0;
    let mut neg = false;
    if i < c.len() and (c[i] == 43 or c[i] == 45) {
        neg = c[i] == 45;
        i += 1;
    }
    let mut base = base0;
    if i + 1 < c.len() and c[i] == 48 {
        let p = lower(c[i + 1]);
        let pb: i128 = if p == 120 { 16 } else if p == 111 { 8 } else if p == 98 { 2 } else { 0 };
        if pb != 0 and (base == 0 or base == pb) {
            base = pb;
            i += 2;
            if i < c.len() and c[i] == 95 {
                i += 1;
            }
        }
    }
    if base == 0 {
        // a decimal literal: a leading zero only in a run of zeros
        base = 10;
        if i < c.len() and c[i] == 48 {
            let mut k = i;
            while k < c.len() {
                if c[k] != 48 and c[k] != 95 {
                    return Err(int_bad(base0, s));
                }
                k += 1;
            }
        }
    }
    if i >= c.len() {
        return Err(int_bad(base0, s));
    }
    let mut n: i128 = 0;
    let mut prev_digit = false;
    while i < c.len() {
        let x = c[i];
        if x == 95 {
            if not prev_digit or i + 1 >= c.len() {
                return Err(int_bad(base0, s));
            }
            prev_digit = false;
            i += 1;
            continue;
        }
        let d = if x >= 48 and x <= 57 { x - 48 } else if lower(x) >= 97 and lower(x) <= 122 { lower(x) - 87 } else { 99 };
        if (d as i128) >= base {
            return Err(int_bad(base0, s));
        }
        n = match n.checked_mul(base) {
            Some(v) => match v.checked_add(d as i128) {
                Some(w) => w,
                None => return big(None),
            },
            None => return big(None),
        };
        prev_digit = true;
        i += 1;
    }
    if not prev_digit {
        return Err(int_bad(base0, s));
    }
    Ok(V.Int(if neg { -n } else { n }))
}

fn float_to_int(x: f64) -> Result[V, PyErr] {
    if x != x {
        return Err(verr("cannot convert float NaN to integer"));
    }
    if x == f64.INFINITY or x == -f64.INFINITY {
        return Err(perr("OverflowError", "cannot convert float infinity to integer"));
    }
    if x >= 1.7e38 or x <= -1.7e38 {
        return big(None);
    }
    Ok(V.Int(x as i128))
}

fn b_int(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    check_kw("int", kw, "base")?;
    if args.len() > 2 {
        return Err(terr(f"int() takes at most 2 arguments ({args.len()} given)"));
    }
    let base_v = if args.len() > 1 { Some(args[1].clone()) } else { kw_get(kw, "base") };
    if args.len() == 0 {
        if base_v.is_some() {
            return Err(terr("int() missing string argument"));
        }
        return Ok(V.Int(0));
    }
    let x = args[0].clone();
    if let Some(b) = base_v {
        let base = as_index(b)?;
        if base != 0 and (base < 2 or base > 36) {
            return Err(verr("int() base must be >= 2 and <= 36, or 0"));
        }
        return match x {
            V.Str(s) => parse_int_str(s, base),
            _ => Err(terr("int() can't convert non-string with explicit base")),
        };
    }
    match x {
        V.Bool(b) => Ok(V.Int(if b { 1 } else { 0 })),
        V.Int(n) => Ok(V.Int(n)),
        V.Float(f) => float_to_int(f),
        V.Str(s) => parse_int_str(s, 10),
        _ => Err(terr(f"int() argument must be a string, a bytes-like object or a real number, not '{tname(x)}'")),
    }
}

// float(s): whitespace around, a sign, inf/infinity/nan in any case, or
// a decimal number with single underscores between digits
fn float_bad(s: ref String) -> PyErr {
    verr(f"could not convert string to float: {pr(s)}")
}

fn parse_float_str(s: ref String) -> Result[V, PyErr] {
    let c = py_strip_cps(cps(s), None, true, true);
    let mut i = 0;
    let mut neg = false;
    if i < c.len() and (c[i] == 43 or c[i] == 45) {
        neg = c[i] == 45;
        i += 1;
    }
    let mut word = String.new();
    let mut k = i;
    while k < c.len() {
        word.push_str(ch(lower(c[k])));
        k += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if word == "inf" or word == "infinity" {
        return Ok(V.Float(sign * f64.INFINITY));
    }
    if word == "nan" {
        return Ok(V.Float(f64.INFINITY - f64.INFINITY));
    }
    let mut body: Vec[i64] = Vec.new();
    let mut digits = false;
    let mut point = false;
    let mut exp = false;
    let mut exp_digits = false;
    while i < c.len() {
        let x = c[i];
        if is_digit(x) {
            if exp {
                exp_digits = true;
            } else {
                digits = true;
            }
        } else if x == 95 {
            if i == 0 or i + 1 >= c.len() or not is_digit(c[i - 1]) or not is_digit(c[i + 1]) {
                return Err(float_bad(s));
            }
            i += 1;
            continue;
        } else if x == 46 and not point and not exp {
            point = true;
        } else if (x == 101 or x == 69) and digits and not exp {
            exp = true;
        } else if (x == 43 or x == 45) and exp and (c[i - 1] == 101 or c[i - 1] == 69) {
        } else {
            return Err(float_bad(s));
        }
        body.push(x);
        i += 1;
    }
    if not digits or (exp and not exp_digits) {
        return Err(float_bad(s));
    }
    match f64.parse(to_string(body)) {
        Ok(v) => Ok(V.Float(sign * v)),
        Err(_) => Err(float_bad(s)),
    }
}

fn b_float(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    no_kw("float", kw)?;
    if args.len() > 1 {
        return Err(terr(f"float expected at most 1 argument, got {args.len()}"));
    }
    if args.len() == 0 {
        return Ok(V.Float(0.0));
    }
    match args[0] {
        V.Str(s) => parse_float_str(s),
        _ => match num_of(args[0]) {
            Some(x) => Ok(V.Float(x)),
            None => Err(terr(f"float() argument must be a string or a real number, not '{tname(args[0])}'")),
        },
    }
}

fn b_abs(v: ref V) -> Result[V, PyErr] {
    match v {
        V.Bool(b) => Ok(V.Int(if b { 1 } else { 0 })),
        V.Int(n) => Ok(V.Int(if n < 0 { -n } else { n })),
        V.Float(x) => Ok(V.Float(if x < 0.0 { -x } else if x == 0.0 { 0.0 } else { x })),
        _ => Err(terr(f"bad operand type for abs(): '{tname(v)}'")),
    }
}

fn round_half_even(x: f64) -> f64 {
    let r = x.floor();
    let diff = x - r;
    if diff > 0.5 {
        r + 1.0
    } else if diff < 0.5 {
        r
    } else if r % 2.0 == 0.0 {
        r
    } else {
        r + 1.0
    }
}

// round(x, n) for a float: the decimal string correctly rounded to n
// places, read back (floatobject.c's double_round)
fn round_float(x: f64, n: i128) -> V {
    if x != x or x == f64.INFINITY or x == -f64.INFINITY or x == 0.0 {
        return V.Float(x);
    }
    if n > 323 {
        return V.Float(x);
    }
    if n < -308 {
        return V.Float(0.0 * x);
    }
    let neg = is_neg(x);
    let text = if n >= 0 {
        fixed_text(x, n as i64, false)
    } else {
        // round to a multiple of 10**-n: the digits before the point,
        // rounded at -n places from the end
        let e = exact_digits(x);
        let keep = e.point + (n as i64);
        if keep < 0 {
            "0".to_string()
        } else {
            let r = round_digits(e.d, keep);
            let mut t = digits_str(r, 0, r.len());
            let mut k: i128 = 0;
            while k < -n {
                t.push('0');
                k += 1;
            }
            if t.len() == 0 { "0".to_string() } else { t }
        }
    };
    let v = f64.parse(text).unwrap_or(0.0);
    V.Float(if neg { -v } else { v })
}

fn b_round(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    check_kw("round", kw, "number ndigits")?;
    let x = if args.len() > 0 { args[0].clone() } else {
        match kw_get(kw, "number") {
            Some(v) => v,
            None => return Err(terr("round() missing required argument 'number' (pos 1)")),
        }
    };
    let nd = if args.len() > 1 { Some(args[1].clone()) } else { kw_get(kw, "ndigits") };
    let nd = match nd {
        Some(V.Nil) => None,
        other => other,
    };
    match x {
        V.Float(f) => match nd {
            None => float_to_int(round_half_even(f)),
            Some(n) => Ok(round_float(f, as_index(n)?)),
        },
        V.Int(_) => round_int(x, nd),
        V.Bool(_) => round_int(x, nd),
        _ => Err(terr(f"type {tname(x)} doesn't define __round__ method")),
    }
}

fn round_int(x: ref V, nd: ref Option[V]) -> Result[V, PyErr] {
    let v = int_of(x).unwrap_or(0);
    let n = match nd {
        None => return Ok(V.Int(v)),
        Some(d) => as_index(d)?,
    };
    if n >= 0 {
        return Ok(V.Int(v));
    }
    if n < -38 {
        return Ok(V.Int(0));
    }
    let mut p: i128 = 1;
    let mut k: i128 = 0;
    while k < -n {
        p = p * 10;
        k += 1;
    }
    let a = if v < 0 { -v } else { v };
    let mut q = a / p;
    let r = a % p;
    if r * 2 > p or (r * 2 == p and q % 2 == 1) {
        q += 1;
    }
    let out = q * p;
    Ok(V.Int(if v < 0 { -out } else { out }))
}

fn b_minmax(is_max: bool, args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    let name = if is_max { "max" } else { "min" };
    check_kw(name, kw, "default key")?;
    if args.len() == 0 {
        return Err(terr(f"{name} expected at least 1 argument, got 0"));
    }
    let dflt = kw_get(kw, "default");
    let items = if args.len() == 1 { iterate(args[0])? } else { args.clone() };
    if items.len() == 0 {
        return match dflt {
            Some(d) => Ok(d),
            None => Err(verr(f"{name}() iterable argument is empty")),
        };
    }
    let mut best = items[0].clone();
    let mut k = 1;
    while k < items.len() {
        if py_order(items[k], best, if is_max { ">" } else { "<" })? {
            best = items[k].clone();
        }
        k += 1;
    }
    Ok(best)
}

fn is_finite(x: f64) -> bool {
    x == x and x != f64.INFINITY and x != -f64.INFINITY
}

// bltinmodule.c's sum: a C long while the items are ints, then a
// compensated float sum while they are floats, then plain addition
fn b_sum(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    check_kw("sum", kw, "start")?;
    if args.len() == 0 {
        return Err(terr("sum() takes at least 1 positional argument (0 given)"));
    }
    let items = iterate(args[0])?;
    let mut result = if args.len() > 1 { args[1].clone() } else { kw_get(kw, "start").unwrap_or(V.Int(0)) };
    if let V.Str(_) = result {
        return Err(terr("sum() can't sum strings [use ''.join(seq) instead]"));
    }
    let mut k = 0;
    if let V.Int(start) = result {
        let mut acc = start;
        let mut done = true;
        while k < items.len() {
            let item = items[k].clone();
            k += 1;
            if let Some(b) = int_of(item) {
                acc += b;
                continue;
            }
            result = op_add(V.Int(acc), item)?;
            done = false;
            break;
        }
        if done {
            return Ok(V.Int(acc));
        }
    }
    if let V.Float(start) = result {
        let mut f = start;
        let mut c = 0.0;
        let mut done = true;
        while k < items.len() {
            let item = items[k].clone();
            k += 1;
            if let V.Float(x) = item {
                let t = f + x;
                if f.abs() >= x.abs() {
                    c += (f - t) + x;
                } else {
                    c += (x - t) + f;
                }
                f = t;
                continue;
            }
            if let Some(n) = int_of(item) {
                f += n as f64;
                continue;
            }
            if c != 0.0 and is_finite(c) {
                f += c;
            }
            result = op_add(V.Float(f), item)?;
            done = false;
            break;
        }
        if done {
            if c != 0.0 and is_finite(c) {
                f += c;
            }
            return Ok(V.Float(f));
        }
    }
    while k < items.len() {
        result = op_add(result, items[k])?;
        k += 1;
    }
    Ok(result)
}

// listobject.c for a list shorter than 64: count_run, then a binary
// insertion sort over the rest, comparing with < only
fn lt(a: ref V, b: ref V) -> Result[bool, PyErr] {
    py_order(a, b, "<")
}

fn reverse_range(v: mut ref Vec[V], lo: i64, hi: i64) {
    let mut a = lo;
    let mut b = hi - 1;
    while a < b {
        let t = v[a].clone();
        v[a] = v[b].clone();
        v[b] = t;
        a += 1;
        b -= 1;
    }
}

fn count_run(v: mut ref Vec[V]) -> Result[i64, PyErr] {
    let total = v.len();
    let mut n = 1;
    while n < total {
        if lt(v[n], v[n - 1])? {
            break;
        }
        n += 1;
    }
    if n == total {
        return Ok(n);
    }
    if n > 1 {
        if lt(v[0], v[n - 1])? {
            return Ok(n);
        }
        reverse_range(mut v, 0, n);
    }
    n += 1;
    let mut neq = 0;
    while n < total {
        if lt(v[n], v[n - 1])? {
            if neq > 0 {
                neq += 1;
                reverse_range(mut v, n - neq, n);
                neq = 0;
            }
        } else if lt(v[n - 1], v[n])? {
            break;
        } else {
            neq += 1;
        }
        n += 1;
    }
    if neq > 0 {
        neq += 1;
        reverse_range(mut v, n - neq, n);
    }
    reverse_range(mut v, 0, n);
    while n < total {
        if lt(v[n], v[n - 1])? {
            break;
        }
        n += 1;
    }
    Ok(n)
}

fn binary_sort(v: mut ref Vec[V], ok0: i64) -> Result[(), PyErr] {
    let mut ok = if ok0 == 0 { 1 } else { ok0 };
    while ok < v.len() {
        let pivot = v[ok].clone();
        let mut l = 0;
        let mut r = ok;
        while l < r {
            let m = (l + r) / 2;
            if lt(pivot, v[m])? {
                r = m;
            } else {
                l = m + 1;
            }
        }
        let mut m = ok;
        while m > l {
            v[m] = v[m - 1].clone();
            m -= 1;
        }
        v[l] = pivot;
        ok += 1;
    }
    Ok(())
}

fn py_sort(v: mut ref Vec[V], reverse: bool) -> Result[(), PyErr] {
    if reverse {
        v.reverse();
    }
    if v.len() > 1 {
        let n = count_run(mut v)?;
        if n < v.len() {
            binary_sort(mut v, n)?;
        }
    }
    if reverse {
        v.reverse();
    }
    Ok(())
}

fn b_sorted(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    check_kw("sort", kw, "reverse")?;
    if args.len() != 1 {
        return Err(terr(f"sorted expected 1 argument, got {args.len()}"));
    }
    let mut items = iterate(args[0])?;
    let reverse = match kw_get(kw, "reverse") {
        Some(r) => as_index(r)? != 0,
        None => false,
    };
    py_sort(mut items, reverse)?;
    Ok(V.List(items))
}

fn b_range(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    no_kw("range", kw)?;
    if args.len() == 0 or args.len() > 3 {
        return Err(terr(f"range expected at least 1 argument, got {args.len()}"));
    }
    let mut ns: Vec[i128] = Vec.new();
    for a in args.iter() {
        ns.push(as_index(a)?);
    }
    if ns.len() == 1 {
        return Ok(V.Range(0, ns[0], 1));
    }
    let step = if ns.len() > 2 { ns[2] } else { 1 };
    if step == 0 {
        return Err(verr("range() arg 3 must not be zero"));
    }
    Ok(V.Range(ns[0], ns[1], step))
}

// dict.update(x): a dict's pairs, or an iterable of pairs
fn dict_update(d: mut ref Dct, x: ref V) -> Result[(), PyErr] {
    if let V.Dict(src) = x {
        let mut k = 0;
        while k < src.ks.len() {
            dict_set(mut d, src.ks[k].clone(), src.vs[k].clone())?;
            k += 1;
        }
        return Ok(());
    }
    let items = iterate(x)?;
    let mut i = 0;
    while i < items.len() {
        let pair = match iterate(items[i]) {
            Ok(p) => p,
            Err(_) => return Err(terr(f"cannot convert dictionary update sequence element #{i} to a sequence")),
        };
        if pair.len() != 2 {
            return Err(verr(f"dictionary update sequence element #{i} has length {pair.len()}; 2 is required"));
        }
        dict_set(mut d, pair[0].clone(), pair[1].clone())?;
        i += 1;
    }
    Ok(())
}

fn b_container(name: ref String, args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    if name == "dict" {
        if args.len() > 1 {
            return Err(terr(f"dict expected at most 1 argument, got {args.len()}"));
        }
        let mut d = new_dict();
        if args.len() == 1 {
            dict_update(mut d, args[0])?;
        }
        for k in kw.iter() {
            match k.name {
                Some(n) => dict_set(mut d, V.Str(n.clone()), k.v.clone())?,
                None => return Err(terr("keywords must be strings")),
            }
        }
        return Ok(V.Dict(d));
    }
    if kw.len() > 0 {
        return Err(terr(f"{name}() takes no keyword arguments"));
    }
    if args.len() > 1 {
        return Err(terr(f"{name} expected at most 1 argument, got {args.len()}"));
    }
    let items = if args.len() == 0 { Vec.new() } else { iterate(args[0])? };
    if name == "list" {
        return Ok(V.List(items));
    }
    if name == "tuple" {
        return Ok(V.Tuple(items));
    }
    let mut out: Vec[V] = Vec.new();
    for x in items.iter() {
        set_add(mut out, x.clone())?;
    }
    Ok(V.Set(out))
}

fn b_len(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    no_kw("len", kw)?;
    if args.len() != 1 {
        return Err(terr(f"len() takes exactly one argument ({args.len()} given)"));
    }
    match len_of(args[0]) {
        Some(n) => Ok(V.Int(n)),
        None => Err(terr(f"object of type '{tname(args[0])}' has no len()")),
    }
}

fn b_str(args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    check_kw("str", kw, "object")?;
    if args.len() > 1 {
        return Err(perr("NotImplementedError", "str() with an encoding is not in the port"));
    }
    if args.len() == 0 {
        return Ok(match kw_get(kw, "object") {
            Some(v) => V.Str(to_str(v)),
            None => s_val(""),
        });
    }
    Ok(V.Str(to_str(args[0])))
}

fn b_anyall(is_any: bool, args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
    let name = if is_any { "any" } else { "all" };
    no_kw(name, kw)?;
    if args.len() != 1 {
        return Err(terr(f"{name}() takes exactly one argument ({args.len()} given)"));
    }
    for x in iterate(args[0])?.iter() {
        if truthy(x) == is_any {
            return Ok(V.Bool(is_any));
        }
    }
    Ok(V.Bool(not is_any))
}
// ------------------------------------------------------------ the evaluator
//
// SimpleEval and EvalWithCompoundTypes over the tree mini_ast's parser
// builds. A handler per node type, as simpleeval's `nodes` dict maps
// them; anything else is FeatureNotAvailable. The limits are the
// module's: strings of 100000, 10000 comprehension elements, ** up to
// 4000000 and shifts up to 10000.

const MAX_STRING_LENGTH: i128 = 100000;
const MAX_COMPREHENSION_LENGTH: i64 = 10000;
const MAX_POWER: i128 = 4000000;
const MAX_SHIFT: i128 = 10000;

fn feature(msg: ref String) -> PyErr {
    perr("FeatureNotAvailable", msg)
}

// The cells of a spreadsheet, for the evaluator whose names are a
// function that evaluates the cell a name refers to.
struct Sheet {
    refs: Vec[String],
    exprs: Vec[String],
    visiting: Vec[String],
}

struct Ev {
    expr: String,
    compound: bool,
    names: Dct,
    // names is a function over a sheet, instead of `names`
    use_sheet: bool,
    sheet: Sheet,
    funcs: Vec[String],
    // the comprehensions' own names, innermost last
    scopes: Vec[Dct],
    max_count: i64,
    warns: Vec[String],
    rng: Rng,
}

fn default_names() -> Dct {
    let mut d = new_dict();
    d.ks.push(s_val("True"));
    d.vs.push(V.Bool(true));
    d.ks.push(s_val("False"));
    d.vs.push(V.Bool(false));
    d.ks.push(s_val("None"));
    d.vs.push(V.Nil);
    d
}

fn words(s: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in s.split(" ") {
        out.push(w.to_string());
    }
    out
}

const DEFAULT_FUNCTIONS: Str = "rand randint int float str";

fn new_ev(compound: bool, names: own Dct, funcs: Str) -> Ev {
    let mut fs = words(funcs);
    if compound {
        for f in words("list tuple dict set").iter() {
            fs.push(f.clone());
        }
    }
    Ev {
        expr: String.new(),
        compound: compound,
        names: names,
        use_sheet: false,
        sheet: Sheet { refs: Vec.new(), exprs: Vec.new(), visiting: Vec.new() },
        funcs: fs,
        scopes: Vec.new(),
        max_count: 0,
        warns: Vec.new(),
        rng: Rng { state: 0x9E3779B97F4A7C15 },
    }
}

fn op_symbol_ok(t: ref String) -> bool {
    has_name("Add Sub Mult Div FloorDiv RShift LShift Pow Mod Eq NotEq Gt Lt GtE LtE Not USub UAdd BitXor BitOr BitAnd Invert In NotIn Is IsNot", t)
}

fn too_long(v: ref V, b: i128) -> Result[bool, PyErr] {
    py_order(v, V.Int(b), ">")
}

impl Ev {
    fn has_func(ref self, name: ref String) -> bool {
        for f in self.funcs.iter() {
            if f == name {
                return true;
            }
        }
        false
    }

    // SimpleEval.eval
    fn eval(mut ref self, expr: ref String) -> Result[V, PyErr] {
        self.expr = expr.clone();
        if self.compound {
            self.max_count = 0;
        }
        let src = py_strip(expr);
        let p = run_parser(cps(src), false);
        if not p.ok {
            return Err(PyErr { kind: p.etype.clone(), msg: f"{p.emsg} (<unknown>, line {p.eline})" });
        }
        let body = kids(p.ast, p.root, "body");
        if body.len() == 0 {
            return Err(perr("InvalidExpression", "Sorry, cannot evaluate empty string"));
        }
        if body.len() > 1 {
            self.warns.push(f"MultipleExpressions: '{expr}' contains multiple expressions. Only the first will be used.");
        }
        self.node(p.ast, body[0])
    }

    fn node(mut ref self, a: ref Ast, id: i64) -> Result[V, PyErr] {
        let t = ty_of(a, id);
        if t == "Expr" or t == "keyword" {
            return self.node(a, kid(a, id, "value"));
        }
        if t == "Assign" or t == "AugAssign" {
            self.warns.push(f"AssignmentAttempted: Assignment ({self.expr}) attempted, but this is ignored");
            return self.node(a, kid(a, id, "value"));
        }
        if t == "Import" {
            return Err(feature("Sorry, 'import' is not allowed."));
        }
        if t == "Name" {
            return self.name(sval(a, id, "id"));
        }
        if t == "Constant" {
            return constant_value(a, id);
        }
        if t == "UnaryOp" {
            return self.unaryop(a, id);
        }
        if t == "BinOp" {
            return self.binop(a, id);
        }
        if t == "BoolOp" {
            let is_and = is(a, kid(a, id, "op"), "And");
            let mut r = V.Bool(false);
            for v in kids(a, id, "values").iter() {
                r = self.node(a, v)?;
                if truthy(r) != is_and {
                    break;
                }
            }
            return Ok(r);
        }
        if t == "Compare" {
            return self.compare(a, id);
        }
        if t == "IfExp" {
            let test = self.node(a, kid(a, id, "test"))?;
            return self.node(a, kid(a, id, if truthy(test) { "body" } else { "orelse" }));
        }
        if t == "Call" {
            return self.call(a, id);
        }
        if t == "Subscript" {
            let container = self.node(a, kid(a, id, "value"))?;
            let key = self.node(a, kid(a, id, "slice"))?;
            return subscript(container, key);
        }
        if t == "Attribute" {
            return self.attribute(a, id);
        }
        if t == "Slice" {
            let mut parts: Vec[V] = Vec.new();
            for f in words("lower upper step").iter() {
                let k = kid(a, id, f);
                parts.push(if k < 0 { V.Nil } else { self.node(a, k)? });
            }
            return Ok(V.Slice(parts));
        }
        if t == "JoinedStr" {
            let mut out = String.new();
            for n in kids(a, id, "values").iter() {
                let val = to_str(self.node(a, n)?);
                if (cps(val).len() as i128) > MAX_STRING_LENGTH {
                    return Err(perr("IterableTooLong", "Sorry, I will not evaluate something this long."));
                }
                out.push_str(val);
            }
            return Ok(V.Str(out));
        }
        if t == "FormattedValue" {
            let spec = kid(a, id, "format_spec");
            if spec < 0 {
                return self.node(a, kid(a, id, "value"));
            }
            let sv = self.node(a, spec)?;
            let spec_text = match sv {
                V.Str(s) => s,
                _ => return Err(terr(f"can only concatenate str (not \"{tname(sv)}\") to str")),
            };
            let v = self.node(a, kid(a, id, "value"))?;
            return Ok(V.Str(format_via_str(v, spec_text)?));
        }
        if self.compound {
            if t == "Dict" {
                return self.dict_node(a, id);
            }
            if t == "List" {
                let mut out: Vec[V] = Vec.new();
                for e in kids(a, id, "elts").iter() {
                    if is(a, e, "Starred") {
                        let v = self.node(a, kid(a, e, "value"))?;
                        for x in iterate(v)?.iter() {
                            out.push(x.clone());
                        }
                    } else {
                        out.push(self.node(a, e)?);
                    }
                }
                return Ok(V.List(out));
            }
            if t == "Tuple" {
                let mut out: Vec[V] = Vec.new();
                for e in kids(a, id, "elts").iter() {
                    out.push(self.node(a, e)?);
                }
                return Ok(V.Tuple(out));
            }
            if t == "Set" {
                let mut out: Vec[V] = Vec.new();
                for e in kids(a, id, "elts").iter() {
                    let v = self.node(a, e)?;
                    set_add(mut out, v)?;
                }
                return Ok(V.Set(out));
            }
            if t == "ListComp" or t == "GeneratorExp" or t == "DictComp" {
                return self.comprehension(a, id, t == "DictComp");
            }
        }
        Err(feature(f"Sorry, {t} is not available in this evaluator"))
    }

    // _eval_name: the comprehensions' names, then `names` (a dict, or the
    // sheet's function), then the functions
    fn name(mut ref self, id: ref String) -> Result[V, PyErr] {
        let mut k = self.scopes.len() - 1;
        while k >= 0 {
            if let Some(i) = dict_find(self.scopes[k], V.Str(id.clone())) {
                return Ok(self.scopes[k].vs[i].clone());
            }
            k -= 1;
        }
        if self.use_sheet {
            match self.cell(id) {
                Ok(v) => return Ok(v),
                Err(e) => {
                    if e.kind != "NameNotDefined" {
                        return Err(e);
                    }
                }
            }
        } else if let Some(i) = dict_find(self.names, V.Str(id.clone())) {
            return Ok(self.names.vs[i].clone());
        }
        if self.has_func(id) {
            return Ok(V.Func(id.clone()));
        }
        Err(perr("NameNotDefined", f"'{id}' is not defined for expression '{self.expr}'"))
    }

    // the sheet's names function: a cell's value, by evaluating the cell
    // on this same evaluator
    fn cell(mut ref self, id: ref String) -> Result[V, PyErr] {
        let mut at = -1;
        let mut k = 0;
        while k < self.sheet.refs.len() {
            if self.sheet.refs[k] == id {
                at = k;
            }
            k += 1;
        }
        if at < 0 {
            return Err(perr("NameNotDefined", f"'{id}' is not defined for expression '{self.expr}'"));
        }
        for v in self.sheet.visiting.iter() {
            if v == id {
                let mut path = self.sheet.visiting.clone();
                path.push(id.clone());
                return Err(perr("InvalidExpression", f"circular reference: {join(path, " -> ")}"));
            }
        }
        self.sheet.visiting.push(id.clone());
        let expr = self.sheet.exprs[at].clone();
        let r = self.eval(expr);
        self.sheet.visiting.pop();
        r
    }

    fn unaryop(mut ref self, a: ref Ast, id: i64) -> Result[V, PyErr] {
        let op = ty_of(a, kid(a, id, "op"));
        let v = self.node(a, kid(a, id, "operand"))?;
        if op == "Not" {
            return Ok(V.Bool(not truthy(v)));
        }
        if op == "USub" {
            return op_neg(v);
        }
        if op == "UAdd" {
            return op_pos(v);
        }
        op_invert(v)
    }

    fn binop(mut ref self, a: ref Ast, id: i64) -> Result[V, PyErr] {
        let op = ty_of(a, kid(a, id, "op"));
        if not op_symbol_ok(op) {
            return Err(perr("OperatorNotDefined", f"Operator '<ast.{op} object>' does not exist in expression '{self.expr}'"));
        }
        let l = self.node(a, kid(a, id, "left"))?;
        let r = self.node(a, kid(a, id, "right"))?;
        if op == "Add" {
            if let (Some(x), Some(y)) = (len_of(l), len_of(r)) {
                if x + y > MAX_STRING_LENGTH {
                    return Err(perr("IterableTooLong", "Sorry, adding those two together would make something too long."));
                }
            }
            return op_add(l, r);
        }
        if op == "Sub" {
            return op_sub(l, r);
        }
        if op == "Mult" {
            // safe_mult
            if let Some(n) = len_of(l) {
                if too_long(op_mul(r, V.Int(n))?, MAX_STRING_LENGTH)? {
                    return Err(perr("IterableTooLong", "Sorry, I will not evaluate something that long."));
                }
            }
            if let Some(n) = len_of(r) {
                if too_long(op_mul(l, V.Int(n))?, MAX_STRING_LENGTH)? {
                    return Err(perr("IterableTooLong", "Sorry, I will not evaluate something that long."));
                }
            }
            return op_mul(l, r);
        }
        if op == "Div" {
            return op_truediv(l, r);
        }
        if op == "FloorDiv" {
            return op_floordiv(l, r);
        }
        if op == "Mod" {
            return op_mod(l, r);
        }
        if op == "Pow" {
            if too_long(b_abs(l)?, MAX_POWER)? or too_long(b_abs(r)?, MAX_POWER)? {
                return Err(perr("NumberTooHigh", f"Sorry! I don't want to evaluate {to_str(l)} ** {to_str(r)}"));
            }
            return op_pow(l, r);
        }
        if op == "LShift" or op == "RShift" {
            let sym = if op == "LShift" { "<<" } else { ">>" };
            // abs(b) > MAX_SHIFT or abs(a) > int(sys.float_info.max)
            let mut high = too_long(b_abs(r)?, MAX_SHIFT)?;
            if not high {
                high = match b_abs(l)? {
                    V.Float(x) => x == f64.INFINITY,
                    _ => false,
                };
            }
            if high {
                return Err(perr("NumberTooHigh", f"Sorry! I don't want to evaluate {to_str(l)} {sym} {to_str(r)}"));
            }
            return op_shift(l, r, op == "LShift");
        }
        let sym = if op == "BitAnd" { "&" } else if op == "BitOr" { "|" } else { "^" };
        op_bits(l, r, sym)
    }

    fn compare(mut ref self, a: ref Ast, id: i64) -> Result[V, PyErr] {
        let mut right = self.node(a, kid(a, id, "left"))?;
        let mut result = V.Bool(true);
        let ops = kids(a, id, "ops");
        let comps = kids(a, id, "comparators");
        let mut k = 0;
        while k < ops.len() and k < comps.len() {
            if not truthy(result) {
                break;
            }
            let left = right;
            right = self.node(a, comps[k])?;
            let op = ty_of(a, ops[k]);
            result = V.Bool(if op == "Eq" {
                py_eq(left, right)
            } else if op == "NotEq" {
                not py_eq(left, right)
            } else if op == "Lt" {
                py_order(left, right, "<")?
            } else if op == "LtE" {
                py_order(left, right, "<=")?
            } else if op == "Gt" {
                py_order(left, right, ">")?
            } else if op == "GtE" {
                py_order(left, right, ">=")?
            } else if op == "In" {
                py_contains(right, left)?
            } else if op == "NotIn" {
                not py_contains(right, left)?
            } else if op == "Is" {
                py_is(left, right)
            } else {
                not py_is(left, right)
            });
            k += 1;
        }
        Ok(result)
    }

    // _eval_call: the keywords are evaluated before the positional
    // arguments, because the argument generator only runs when the call
    // unpacks it
    fn call(mut ref self, a: ref Ast, id: i64) -> Result[V, PyErr] {
        let f = kid(a, id, "func");
        let func = if is(a, f, "Attribute") {
            self.node(a, f)?
        } else if is(a, f, "Name") {
            let name = sval(a, f, "id");
            if not self.has_func(name) {
                return Err(perr("FunctionNotDefined", f"Function '{name}' not defined, for expression '{self.expr}'."));
            }
            V.Func(name)
        } else {
            return Err(feature("Lambda Functions not implemented"));
        };
        let mut kw: Vec[Kw] = Vec.new();
        for k in kids(a, id, "keywords").iter() {
            let v = self.node(a, kid(a, k, "value"))?;
            let name = if has_str(a, k, "arg") { Some(sval(a, k, "arg")) } else { None };
            // dict(): a repeated keyword keeps its last value
            let mut found = false;
            let mut j = 0;
            while j < kw.len() {
                if kw[j].name == name {
                    kw[j].v = v.clone();
                    found = true;
                }
                j += 1;
            }
            if not found {
                kw.push(Kw { name: name, v: v });
            }
        }
        let mut args: Vec[V] = Vec.new();
        for x in kids(a, id, "args").iter() {
            args.push(self.node(a, x)?);
        }
        self.call_value(func, args, kw)
    }

    fn call_value(mut ref self, func: ref V, args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
        for k in kw.iter() {
            if k.name.is_none() {
                return Err(terr("keywords must be strings"));
            }
        }
        match func {
            V.Func(n) => self.builtin(n, args, kw),
            V.Method(r, n) => call_method(r[0], n, args, kw),
            _ => Err(terr(f"'{tname(func)}' object is not callable")),
        }
    }

    fn builtin(mut ref self, n: ref String, args: ref Vec[V], kw: ref Vec[Kw]) -> Result[V, PyErr] {
        if n == "int" {
            return b_int(args, kw);
        }
        if n == "float" {
            return b_float(args, kw);
        }
        if n == "str" {
            return b_str(args, kw);
        }
        if n == "rand" {
            no_kw("random", kw)?;
            if args.len() > 0 {
                return Err(terr(f"Random.random() takes no arguments ({args.len()} given)"));
            }
            return Ok(V.Float(self.rng.next()));
        }
        if n == "randint" {
            check_kw("random_int", kw, "top")?;
            if args.len() != 1 {
                return Err(terr(f"random_int() takes 1 positional argument but {args.len()} were given"));
            }
            let r = V.Float(self.rng.next());
            let x = op_mul(r, args[0])?;
            return b_int(vec![x], Vec.new());
        }
        if n == "len" {
            return b_len(args, kw);
        }
        if n == "round" {
            return b_round(args, kw);
        }
        if n == "min" or n == "max" {
            return b_minmax(n == "max", args, kw);
        }
        if n == "abs" {
            no_kw("abs", kw)?;
            if args.len() != 1 {
                return Err(terr(f"abs() takes exactly one argument ({args.len()} given)"));
            }
            return b_abs(args[0]);
        }
        if n == "sum" {
            return b_sum(args, kw);
        }
        if n == "sorted" {
            return b_sorted(args, kw);
        }
        if n == "any" or n == "all" {
            return b_anyall(n == "any", args, kw);
        }
        if n == "range" {
            return b_range(args, kw);
        }
        b_container(n, args, kw)
    }

    fn attribute(mut ref self, a: ref Ast, id: i64) -> Result[V, PyErr] {
        let attr = sval(a, id, "attr");
        if attr.starts_with("_") or attr.starts_with("func_") {
            return Err(feature(f"Sorry, access to __attributes  or func_ attributes is not available. ({attr})"));
        }
        if has_name("format format_map mro tb_frame gi_frame ag_frame cr_frame exec", attr) {
            return Err(feature(f"Sorry, this method is not available. ({attr})"));
        }
        let v = self.node(a, kid(a, id, "value"))?;
        if let Some(x) = get_attr(v, attr) {
            return Ok(x);
        }
        // ATTR_INDEX_FALLBACK: v[attr], when v is a dict that has it
        if let V.Dict(d) = v {
            if let Some(i) = dict_find(d, V.Str(attr.clone())) {
                return Ok(d.vs[i].clone());
            }
        }
        Err(perr("AttributeDoesNotExist", f"Attribute '{attr}' does not exist in expression '{self.expr}'"))
    }

    fn dict_node(mut ref self, a: ref Ast, id: i64) -> Result[V, PyErr] {
        let mut d = new_dict();
        let ks = kids(a, id, "keys");
        let vs = kids(a, id, "values");
        let mut k = 0;
        while k < ks.len() and k < vs.len() {
            if ks[k] < 0 {
                // {**x}: result.update(x)
                let x = self.node(a, vs[k])?;
                dict_update(mut d, x)?;
            } else {
                // result[key] = value: the value first
                let v = self.node(a, vs[k])?;
                let key = self.node(a, ks[k])?;
                dict_set(mut d, key, v)?;
            }
            k += 1;
        }
        Ok(V.Dict(d))
    }

    // _eval_comprehension: its names in a scope of its own, which
    // shadows the outer names until it finishes
    fn comprehension(mut ref self, a: ref Ast, id: i64, is_dict: bool) -> Result[V, PyErr] {
        self.scopes.push(new_dict());
        let mut out: Vec[V] = Vec.new();
        let mut d = new_dict();
        let r = self.generator(a, id, 0, is_dict, mut out, mut d);
        self.scopes.pop();
        r?;
        if is_dict {
            return Ok(V.Dict(d));
        }
        Ok(V.List(out))
    }

    fn generator(mut ref self, a: ref Ast, id: i64, gi: i64, is_dict: bool, out: mut ref Vec[V], d: mut ref Dct) -> Result[(), PyErr] {
        let gens = kids(a, id, "generators");
        let g = gens[gi];
        let it = self.node(a, kid(a, g, "iter"))?;
        for item in iterate(it)?.iter() {
            self.max_count += 1;
            if self.max_count > MAX_COMPREHENSION_LENGTH {
                return Err(perr("IterableTooLong", "Comprehension generates too many elements"));
            }
            self.bind(a, kid(a, g, "target"), item)?;
            let mut pass = true;
            for cond in kids(a, g, "ifs").iter() {
                if not truthy(self.node(a, cond)?) {
                    pass = false;
                    break;
                }
            }
            if not pass {
                continue;
            }
            if gi + 1 < gens.len() {
                self.generator(a, id, gi + 1, is_dict, mut out, mut d)?;
            } else if is_dict {
                let v = self.node(a, kid(a, id, "value"))?;
                let k = self.node(a, kid(a, id, "key"))?;
                dict_set(mut d, k, v)?;
            } else {
                out.push(self.node(a, kid(a, id, "elt"))?);
            }
        }
        Ok(())
    }

    // recurse_targets: a name binds; anything else zips its elts with
    // the value, so extra values are dropped
    fn bind(mut ref self, a: ref Ast, target: i64, value: ref V) -> Result[(), PyErr] {
        let t = ty_of(a, target);
        if t == "Name" {
            let top = self.scopes.len() - 1;
            dict_set(mut self.scopes[top], V.Str(sval(a, target, "id")), value.clone())?;
            return Ok(());
        }
        if t != "Tuple" and t != "List" {
            return Err(perr("AttributeError", f"'{t}' object has no attribute 'elts'"));
        }
        let elts = kids(a, target, "elts");
        let vals = iterate(value)?;
        let mut k = 0;
        while k < elts.len() and k < vals.len() {
            self.bind(a, elts[k], vals[k])?;
            k += 1;
        }
        Ok(())
    }
}

fn constant_value(a: ref Ast, id: i64) -> Result[V, PyErr] {
    let c = cv(a, id);
    if c.ck == C_INT {
        return match i128.parse(c.num.clone()) {
            Ok(n) => Ok(V.Int(n)),
            Err(_) => big(None),
        };
    }
    if c.ck == C_FLOAT {
        return Ok(V.Float(c.x));
    }
    if c.ck == C_COMPLEX {
        return Ok(V.Raw("complex".to_string(), f"{imag_repr(c.x)}j"));
    }
    if c.ck == C_STR {
        if (c.s.len() as i128) > MAX_STRING_LENGTH {
            return Err(perr("IterableTooLong", f"Literal in statement is too long! ({c.s.len()}, when {MAX_STRING_LENGTH} is max)"));
        }
        return Ok(V.Str(to_string(c.s)));
    }
    if c.ck == C_BYTES {
        return Ok(V.Raw("bytes".to_string(), bytes_repr(c.s)));
    }
    if c.ck == C_TRUE {
        return Ok(V.Bool(true));
    }
    if c.ck == C_FALSE {
        return Ok(V.Bool(false));
    }
    if c.ck == C_NONE {
        return Ok(V.Nil);
    }
    Ok(V.Raw("ellipsis".to_string(), "Ellipsis".to_string()))
}

// ------------------------------------------------------------ subscripts

fn slice_part(v: ref V) -> Result[Option[i128], PyErr] {
    match v {
        V.Nil => Ok(None),
        _ => match int_of(v) {
            Some(n) => Ok(Some(n)),
            None => Err(terr("slice indices must be integers or None or have an __index__ method")),
        },
    }
}

fn slice_fix(x: Option[i128], dflt: i128, n: i128, step: i128) -> i128 {
    match x {
        None => dflt,
        Some(v) => {
            if v < 0 {
                let w = v + n;
                if w < 0 { if step < 0 { -1 } else { 0 } } else { w }
            } else if v >= n {
                if step < 0 { n - 1 } else { n }
            } else {
                v
            }
        }
    }
}

// PySlice_GetIndicesEx: the indices a slice picks out of n items
fn slice_indices(p: ref Vec[V], n: i128) -> Result[Vec[i64], PyErr] {
    let step = slice_part(p[2])?.unwrap_or(1);
    if step == 0 {
        return Err(verr("slice step cannot be zero"));
    }
    let lo_default: i128 = if step < 0 { n - 1 } else { 0 };
    let hi_default: i128 = if step < 0 { -1 } else { n };
    let start = slice_fix(slice_part(p[0])?, lo_default, n, step);
    let stop = slice_fix(slice_part(p[1])?, hi_default, n, step);
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    if step > 0 {
        while i < stop {
            out.push(i as i64);
            i += step;
        }
    } else {
        while i > stop {
            out.push(i as i64);
            i += step;
        }
    }
    Ok(out)
}

fn index_of(i: i128, n: i64) -> Option[i64] {
    let k = if i < 0 { i + (n as i128) } else { i };
    if k < 0 or k >= (n as i128) {
        None
    } else {
        Some(k as i64)
    }
}

fn subscript(container: ref V, key: ref V) -> Result[V, PyErr] {
    match container {
        V.Dict(d) => match dict_get(d, key)? {
            Some(v) => Ok(v),
            None => Err(perr("KeyError", repr(key))),
        },
        V.Str(s) => {
            let c = cps(s);
            if let V.Slice(p) = key {
                let mut out: Vec[i64] = Vec.new();
                for i in slice_indices(p, c.len() as i128)?.iter() {
                    out.push(c[i]);
                }
                return Ok(V.Str(to_string(out)));
            }
            match int_of(key) {
                Some(i) => match index_of(i, c.len()) {
                    Some(k) => Ok(V.Str(to_string(vec![c[k]]))),
                    None => Err(perr("IndexError", "string index out of range")),
                },
                None => Err(terr(f"string indices must be integers, not '{tname(key)}'")),
            }
        }
        V.List(xs) => seq_index("list", xs, key),
        V.Tuple(xs) => seq_index("tuple", xs, key),
        V.Range(_, _, _) => {
            let items = iterate(container)?;
            match int_of(key) {
                Some(i) => match index_of(i, items.len()) {
                    Some(k) => Ok(items[k].clone()),
                    None => Err(perr("IndexError", "range object index out of range")),
                },
                None => Err(terr(f"range indices must be integers or slices, not {tname(key)}")),
            }
        }
        _ => Err(terr(f"'{tname(container)}' object is not subscriptable")),
    }
}

fn seq_index(t: Str, xs: ref Vec[V], key: ref V) -> Result[V, PyErr] {
    if let V.Slice(p) = key {
        let mut out: Vec[V] = Vec.new();
        for i in slice_indices(p, xs.len() as i128)?.iter() {
            out.push(xs[i].clone());
        }
        return Ok(if t == "list" { V.List(out) } else { V.Tuple(out) });
    }
    match int_of(key) {
        Some(i) => match index_of(i, xs.len()) {
            Some(k) => Ok(xs[k].clone()),
            None => Err(perr("IndexError", f"{t} index out of range")),
        },
        None => Err(terr(f"{t} indices must be integers or slices, not {tname(key)}")),
    }
}
// ------------------------------------------------------------ JSON
//
// The documents, read the way json.loads builds them: objects as dicts
// in key order, arrays as lists, numbers with a fraction or an exponent
// as floats.

struct Jr {
    c: Vec[i64],
    pos: i64,
}

impl Jr {
    fn skip(mut ref self) {
        while self.pos < self.c.len() and (self.c[self.pos] == 32 or self.c[self.pos] == 10 or self.c[self.pos] == 9 or self.c[self.pos] == 13) {
            self.pos += 1;
        }
    }

    fn peek(ref self) -> i64 {
        if self.pos < self.c.len() { self.c[self.pos] } else { -1 }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc = cps(w.to_string());
        let mut k = 0;
        while k < wc.len() {
            if self.pos + k >= self.c.len() or self.c[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> i64 {
        let mut n = 0;
        let mut k = 0;
        while k < 4 {
            n = n * 16 + hex_val(self.c[self.pos]);
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn string(mut ref self) -> String {
        self.pos += 1;
        let mut out: Vec[i64] = Vec.new();
        while self.pos < self.c.len() and self.c[self.pos] != 34 {
            let x = self.c[self.pos];
            if x != 92 {
                out.push(x);
                self.pos += 1;
                continue;
            }
            let e = self.c[self.pos + 1];
            self.pos += 2;
            if e == 117 {
                let mut u = self.hex4();
                if u >= 0xD800 and u < 0xDC00 and self.pos + 1 < self.c.len() and self.c[self.pos] == 92 and self.c[self.pos + 1] == 117 {
                    self.pos += 2;
                    let lo = self.hex4();
                    u = 0x10000 + (u - 0xD800) * 0x400 + (lo - 0xDC00);
                }
                out.push(u);
            } else {
                out.push(if e == 110 { 10 } else if e == 116 { 9 } else if e == 114 { 13 } else if e == 98 { 8 } else if e == 102 { 12 } else { e });
            }
        }
        self.pos += 1;
        to_string(out)
    }

    fn number(mut ref self) -> V {
        let start = self.pos;
        let mut is_float = false;
        while self.pos < self.c.len() {
            let x = self.c[self.pos];
            if x == 46 or x == 101 or x == 69 {
                is_float = true;
            } else if not (is_digit(x) or x == 45 or x == 43) {
                break;
            }
            self.pos += 1;
        }
        let text = to_string(slice(self.c, start, self.pos));
        if is_float {
            V.Float(f64.parse(text).unwrap_or(0.0))
        } else {
            V.Int(i128.parse(text).unwrap_or(0))
        }
    }

    fn value(mut ref self) -> V {
        self.skip();
        let x = self.peek();
        if x == 123 {
            self.pos += 1;
            let mut d = new_dict();
            self.skip();
            if self.peek() == 125 {
                self.pos += 1;
                return V.Dict(d);
            }
            loop {
                self.skip();
                let k = self.string();
                self.skip();
                self.pos += 1;
                let v = self.value();
                d.ks.push(V.Str(k));
                d.vs.push(v);
                self.skip();
                let sep = self.peek();
                self.pos += 1;
                if sep != 44 {
                    break;
                }
            }
            return V.Dict(d);
        }
        if x == 91 {
            self.pos += 1;
            let mut out: Vec[V] = Vec.new();
            self.skip();
            if self.peek() == 93 {
                self.pos += 1;
                return V.List(out);
            }
            loop {
                out.push(self.value());
                self.skip();
                let sep = self.peek();
                self.pos += 1;
                if sep != 44 {
                    break;
                }
            }
            return V.List(out);
        }
        if x == 34 {
            return V.Str(self.string());
        }
        if self.word("true") {
            return V.Bool(true);
        }
        if self.word("false") {
            return V.Bool(false);
        }
        if self.word("null") {
            return V.Nil;
        }
        self.number()
    }
}

fn load_json(text: ref String) -> V {
    let mut r = Jr { c: cps(text), pos: 0 };
    r.value()
}

fn as_dict(v: ref V) -> Dct {
    match v {
        V.Dict(d) => d.clone(),
        _ => new_dict(),
    }
}

fn dict_str(d: ref Dct, key: Str) -> String {
    match dict_find(d, s_val(key)) {
        Some(i) => to_str(d.vs[i]),
        None => String.new(),
    }
}

// ------------------------------------------------------------ files

struct DataFile {
    path: String,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_data(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

// a TSV column with its \\, \n and \t escapes undone
fn unescape(s: ref String) -> String {
    let c = cps(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < c.len() {
        if c[i] == 92 and i + 1 < c.len() {
            let n = c[i + 1];
            out.push(if n == 110 { 10 } else if n == 116 { 9 } else { n });
            i += 2;
        } else {
            out.push(c[i]);
            i += 1;
        }
    }
    to_string(out)
}

fn tsv(rel: Str) -> Vec[Vec[String]] {
    let mut rows: Vec[Vec[String]] = Vec.new();
    for line in read_data(rel.to_string()).split("\n") {
        if line.len() > 0 {
            let cols: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
            rows.push(cols);
        }
    }
    rows
}

// ------------------------------------------------------------ the jobs and programs

const CTX_FUNCTIONS: Str = "rand randint int float str len round min max abs";
const CCTX_FUNCTIONS: Str = "rand randint int float str len round min max abs sum sorted any all range";

fn failure(e: ref PyErr) -> String {
    f"! {e.kind}: {e.msg}"
}

fn shown(r: ref Result[V, PyErr]) -> String {
    match r {
        Ok(v) => repr(v),
        Err(e) => failure(e),
    }
}

fn evaluator(profile: ref String, doc: ref String) -> Ev {
    if profile == "basic" {
        return new_ev(false, default_names(), DEFAULT_FUNCTIONS);
    }
    if profile == "compound" {
        return new_ev(true, default_names(), DEFAULT_FUNCTIONS);
    }
    let names = as_dict(load_json(read_data(f"docs/{doc}.json")));
    if profile == "ctx" {
        return new_ev(false, names, CTX_FUNCTIONS);
    }
    new_ev(true, names, CCTX_FUNCTIONS)
}

fn run_jobs() {
    for row in tsv("jobs.tsv") {
        if row[0] == "==" {
            println(f"== {row[1]}");
            continue;
        }
        let expr = unescape(row[1]);
        let at = if row[2] == "-" { String.new() } else { f" @{row[2]}" };
        println(f"-- {row[0]} {row[1]}{at}");
        let mut ev = evaluator(row[0], row[2]);
        let r = ev.eval(expr);
        for w in ev.warns.iter() {
            println(f"warning: {w}");
        }
        println(shown(r));
    }
}

fn pricing() {
    println("== pricing");
    let rules = tsv("shop/pricing.tsv");
    for order in iterate(load_json(read_data("shop/orders.json".to_string()))).unwrap_or(Vec.new()) {
        let d = as_dict(order);
        let id = dict_str(d, "id");
        let mut ev = new_ev(true, d, CCTX_FUNCTIONS);
        for rule in rules.iter() {
            let r = ev.eval(unescape(rule[1]));
            println(f"{id} {rule[0]} {shown(r)}");
        }
    }
}

fn alerts() {
    println("== alerts");
    let rules = tsv("ops/alerts.tsv");
    let mut sevs: Vec[String] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    for host in iterate(load_json(read_data("ops/hosts.json".to_string()))).unwrap_or(Vec.new()) {
        let d = as_dict(host);
        let name = dict_str(d, "host");
        let mut ev = new_ev(true, d, CCTX_FUNCTIONS);
        let mut fired: Vec[String] = Vec.new();
        for rule in rules.iter() {
            match ev.eval(unescape(rule[2])) {
                Err(e) => fired.push(f"  {rule[0]} {failure(e)}"),
                Ok(v) => {
                    if truthy(v) {
                        fired.push(f"  FIRE {rule[1]} {rule[0]} {repr(v)}");
                        let mut found = false;
                        let mut k = 0;
                        while k < sevs.len() {
                            if sevs[k] == rule[1] {
                                counts[k] += 1;
                                found = true;
                            }
                            k += 1;
                        }
                        if not found {
                            sevs.push(rule[1].clone());
                            counts.push(1);
                        }
                    }
                }
            }
        }
        println(f"{name}: {fired.len()}");
        for line in fired.iter() {
            println(line);
        }
    }
    let mut order = sevs.clone();
    sort_strings(mut order);
    let mut parts: Vec[String] = Vec.new();
    for s in order.iter() {
        let mut k = 0;
        while k < sevs.len() {
            if sevs[k] == s {
                parts.push(f"{s}={counts[k]}");
            }
            k += 1;
        }
    }
    println(f"total: {join(parts, ", ")}");
}

fn notify() {
    println("== notify");
    let templates = tsv("mail/templates.tsv");
    for user in iterate(load_json(read_data("mail/users.json".to_string()))).unwrap_or(Vec.new()) {
        let d = as_dict(user);
        println(f"To: {dict_str(d, "email")}");
        let mut ev = new_ev(false, d, "rand randint int float str len");
        for t in templates.iter() {
            match ev.eval(unescape(t[1])) {
                Err(e) => println(f"  [{t[0]}] {failure(e)}"),
                Ok(v) => {
                    if truthy(v) {
                        println(f"  {to_str(v)}");
                    }
                }
            }
        }
    }
}

fn sheet() {
    println("== sheet");
    let rows = tsv("sheet.tsv");
    let mut ev = new_ev(false, default_names(), "rand randint int float str round");
    ev.use_sheet = true;
    for row in rows.iter() {
        ev.sheet.refs.push(row[0].clone());
        ev.sheet.exprs.push(unescape(row[1]));
    }
    for row in rows.iter() {
        ev.sheet.visiting = vec![row[0].clone()];
        let r = ev.eval(unescape(row[1]));
        println(f"{row[0]} = {shown(r)}");
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    run_jobs();
    pricing();
    alerts();
    notify();
    sheet();
}
