fn file_mail_templates_tsv_0(t: mut ref String) {
    t.push_str("greeting\tf'Hi {name.split()[0]},'\n");
    t.push_str("seats\tf'You are using {used} of {seats} seats ({used / seats:.0%}).'\n");
    t.push_str("renewal\tf'Your {plan} plan renews in {renews_in} days.' if renews_in > 0 else f'Your {plan} plan lapsed {-renews_in} days ago.'\n");
    t.push_str("balance\tf'Balance: {balance:+.2f} EUR' if balance else 'No balance due.'\n");
    t.push_str("upsell\t'Upgrade to pro for more seats.' if plan == 'free' else ''\n");
    t.push_str("over\tf'{used - seats} seat(s) over the limit!' if used > seats else 'ok'\n");
    t.push_str("tags\t', '.join(tags) or '(none)'\n");
    t.push_str("domain\temail.split('@')[1].upper()\n");
    t.push_str("lang\tlocale[:2] + (' (EU)' if locale[-2:] in ('GB', 'AT', 'DE') else '')\n");
    t.push_str("broken\tf'{nickname}'\n");
}

