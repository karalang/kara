// mini_cantools: cantools 39.4.5, Erik Moqvist's CAN bus toolkit, as a
// vehicle team uses it: a DBC file that describes an electric car's
// powertrain bus is loaded, its messages are encoded and decoded, a few
// broken DBC files are rejected with cantools's own errors, and a
// one-minute candump log of a drive and a charge is decoded frame by
// frame, checked and summed up.
//
// The port follows cantools's DBC path end to end: textparser's
// tokenizer and grammar combinators (Sequence, Choice, ChoiceDict,
// ZeroOrMore, DelimitedList, Optional, AnyUntil), the dbc.py loaders for
// comments, attribute definitions, attributes, value tables, choices and
// messages, the conversion classes (Identity, LinearInteger, Linear,
// NamedSignal), Message's codec tree with multiplexers, its overlap and
// fit checks, gather_signals and the range checks, and the bit packing
// that bitstruct does for encode_data and decode_data.

// ------------------------------------------------------------ values

// A Python number as cantools sees it: int or float.
#[derive(Clone)]
enum Num {
    I(i64),
    F(f64),
}

// A signal value: a number, a NamedSignalValue (value and name), or a
// plain string handed to encode.
#[derive(Clone)]
enum Val {
    I(i64),
    F(f64),
    Named(i64, String),
    Str(String),
}

#[derive(Clone)]
struct Fail {
    kind: String,
    msg: String,
}

fn fail(kind: Str, msg: own String) -> Fail {
    Fail { kind: kind.to_string(), msg: msg }
}

fn show_fail(e: ref Fail) -> String {
    f"{e.kind}: {e.msg}"
}

fn key_error(name: ref String) -> Fail {
    fail("KeyError", py_repr(name))
}

fn join(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..xs.len() as i64 {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(xs[i]);
    }
    out
}

fn from_chars(c: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    for i in lo..hi {
        s.push(c[i]);
    }
    s
}

fn chars_of(s: ref String) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for c in s.chars() {
        out.push(c);
    }
    out
}

fn float_str(x: f64) -> String {
    f"{x}"
}

fn num_str(n: ref Num) -> String {
    match n {
        Num.I(v) => f"{v}",
        Num.F(v) => float_str(v),
    }
}

fn num_f(n: ref Num) -> f64 {
    match n {
        Num.I(v) => v as f64,
        Num.F(v) => v,
    }
}

fn opt_num_str(n: ref Option[Num]) -> String {
    match n {
        Some(v) => num_str(v),
        None => "None".to_string(),
    }
}

// Python's repr() of a str.
fn py_repr(s: ref String) -> String {
    let mut q = '\'';
    if s.contains("'") and not s.contains("\"") {
        q = '"';
    }
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn opt_repr(s: ref Option[String]) -> String {
    match s {
        Some(v) => py_repr(v),
        None => "None".to_string(),
    }
}

fn list_repr(xs: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs.iter() {
        parts.push(py_repr(x));
    }
    f"[{join(parts, ", ")}]"
}

fn ints_repr(xs: ref Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs.iter() {
        parts.push(f"{x}");
    }
    f"[{join(parts, ", ")}]"
}

fn val_str(v: ref Val) -> String {
    match v {
        Val.I(x) => f"{x}",
        Val.F(x) => float_str(x),
        Val.Named(_, name) => name.clone(),
        Val.Str(s) => s.clone(),
    }
}

fn val_repr(v: ref Val) -> String {
    match v {
        Val.I(x) => f"{x}",
        Val.F(x) => float_str(x),
        Val.Named(_, name) => f"'{name}'",
        Val.Str(s) => py_repr(s),
    }
}

fn bool_str(b: bool) -> String {
    if b {
        "True".to_string()
    } else {
        "False".to_string()
    }
}

// utils.format_or
fn format_or(items: ref Vec[String]) -> String {
    if items.len() == 1 {
        return items[0].clone();
    }
    let mut head: Vec[String] = Vec.new();
    for i in 0..items.len() - 1 {
        head.push(items[i].clone());
    }
    f"{join(head, ", ")} or {items[items.len() - 1]}"
}

// Python's round() of a float: half to even.
fn round_half_even(x: f64) -> i64 {
    let fl = x.floor();
    let diff = x - fl;
    let mut r = fl;
    if diff > 0.5 {
        r = fl + 1.0;
    } else if diff == 0.5 {
        let half = fl / 2.0;
        if half.floor() != half {
            r = fl + 1.0;
        }
    }
    r as i64
}

fn py_round(v: ref Num) -> i64 {
    match v {
        Num.I(x) => x,
        Num.F(x) => round_half_even(x),
    }
}

// Arithmetic with Python's int/float rules.
fn num_add(a: ref Num, b: ref Num) -> Num {
    match (a, b) {
        (Num.I(x), Num.I(y)) => Num.I(x + y),
        _ => Num.F(num_f(a) + num_f(b)),
    }
}

fn num_sub(a: ref Num, b: ref Num) -> Num {
    match (a, b) {
        (Num.I(x), Num.I(y)) => Num.I(x - y),
        _ => Num.F(num_f(a) - num_f(b)),
    }
}

fn num_mul(a: ref Num, b: ref Num) -> Num {
    match (a, b) {
        (Num.I(x), Num.I(y)) => Num.I(x * y),
        _ => Num.F(num_f(a) * num_f(b)),
    }
}

// a / b, which is always a float in Python 3.
fn num_div(a: ref Num, b: ref Num) -> f64 {
    num_f(a) / num_f(b)
}

fn num_lt(a: ref Num, b: ref Num) -> bool {
    match (a, b) {
        (Num.I(x), Num.I(y)) => x < y,
        _ => num_f(a) < num_f(b),
    }
}

fn num_eq_int(a: ref Num, b: i64) -> bool {
    match a {
        Num.I(x) => x == b,
        Num.F(x) => x == (b as f64),
    }
}

fn num_abs(a: ref Num) -> Num {
    match a {
        Num.I(x) => if x < 0 { Num.I(-x) } else { Num.I(x) },
        Num.F(x) => if x < 0.0 { Num.F(-x) } else { Num.F(x) },
    }
}

// divmod(a, b) for b > 0: the floored quotient, and whether the
// remainder is zero.
fn num_divmod(a: ref Num, b: ref Num) -> (Num, bool) {
    match (a, b) {
        (Num.I(x), Num.I(y)) => {
            let mut q = x / y;
            let r = x - q * y;
            if r != 0 and ((r < 0) != (y < 0)) {
                q -= 1;
            }
            (Num.I(q), r == 0)
        },
        _ => {
            let vx = num_f(a);
            let wx = num_f(b);
            let m = vx % wx;
            let div = (vx - m) / wx;
            let mut fl = div.floor();
            if div - fl > 0.5 {
                fl += 1.0;
            }
            (Num.F(fl), m == 0.0)
        },
    }
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_hex_upper(c: char) -> bool {
    is_digit(c) or (c >= 'A' and c <= 'F')
}

fn hex_val(c: char) -> i64 {
    if is_digit(c) {
        (c as i64) - 48
    } else if c >= 'a' and c <= 'f' {
        (c as i64) - 87
    } else {
        (c as i64) - 55
    }
}

fn parse_hex(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_val(c);
    }
    v
}

fn bytes_from_hex(s: ref String) -> Vec[i64] {
    let cs = chars_of(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push(hex_val(cs[i]) * 16 + hex_val(cs[i + 1]));
        i += 2;
    }
    out
}

fn hex_of(data: ref Vec[i64]) -> String {
    let mut out = String.new();
    for b in data.iter() {
        out.push_str(f"{*b:02x}");
    }
    out
}

// int() of a decimal digit string with an optional sign.
fn parse_int_text(s: ref String) -> Option[i64] {
    let cs = chars_of(s);
    let mut i = 0;
    let mut neg = false;
    if cs.len() > 0 and (cs[0] == '+' or cs[0] == '-') {
        neg = cs[0] == '-';
        i = 1;
    }
    if i >= cs.len() {
        return None;
    }
    let mut v = 0;
    while i < cs.len() {
        if not is_digit(cs[i]) {
            return None;
        }
        v = v * 10 + ((cs[i] as i64) - 48);
        i += 1;
    }
    if neg {
        Some(-v)
    } else {
        Some(v)
    }
}

// formats/utils.num: int if it parses as one, else float.
fn num_of(s: ref String) -> Num {
    match parse_int_text(s) {
        Some(v) => Num.I(v),
        None => Num.F(f64.parse(s.clone()).unwrap_or(0.0)),
    }
}

// int(Decimal(s)): the value truncated toward zero.
fn decimal_int(s: ref String) -> i64 {
    match parse_int_text(s) {
        Some(v) => v,
        None => {
            let x = f64.parse(s.clone()).unwrap_or(0.0);
            if x < 0.0 {
                -((-x).floor() as i64)
            } else {
                x.floor() as i64
            }
        },
    }
}

// ------------------------------------------------------------ textparser

#[derive(Clone)]
struct Tok {
    kind: String,
    value: String,
    offset: i64,
}

// textparser's _Tokens: a cursor, a stack of saved positions and the
// furthest position any failed match reached, which is where a syntax
// error is reported.
struct Toks {
    toks: Vec[Tok],
    pos: i64,
    stack: Vec[i64],
    max_pos: i64,
}

fn tok_at(t: ref Toks, pos: i64) -> i64 {
    if pos < 0 {
        0
    } else if pos >= t.toks.len() {
        t.toks.len() - 1
    } else {
        pos
    }
}

fn peek_kind(t: ref Toks) -> String {
    t.toks[tok_at(t, t.pos)].kind.clone()
}

fn get_value(t: mut ref Toks) -> String {
    let v = t.toks[tok_at(t, t.pos)].value.clone();
    t.pos += 1;
    v
}

fn t_save(t: mut ref Toks) {
    t.stack.push(t.pos);
}

fn t_restore(t: mut ref Toks) {
    t.pos = t.stack.pop().unwrap_or(0);
}

fn t_update(t: mut ref Toks) {
    let n = t.stack.len();
    t.stack[n - 1] = t.pos;
}

fn t_mark_max_restore(t: mut ref Toks) {
    if t.pos > t.max_pos {
        t.max_pos = t.pos;
    }
    t.pos = t.stack.pop().unwrap_or(0);
}

fn t_mark_max_load(t: mut ref Toks) {
    if t.pos > t.max_pos {
        t.max_pos = t.pos;
    }
    t.pos = t.stack[t.stack.len() - 1];
}

fn t_drop(t: mut ref Toks) {
    t.stack.pop();
}

// A parse tree: a token value, a list, or (for the dict repetitions) a
// list of entries, each a key in `value` with its matches in `items`.
#[derive(Clone)]
struct Tree {
    leaf: bool,
    value: String,
    items: Vec[Tree],
}

fn leaf(v: own String) -> Tree {
    Tree { leaf: true, value: v, items: Vec.new() }
}

fn node(items: own Vec[Tree]) -> Tree {
    Tree { leaf: false, value: String.new(), items: items }
}

fn tv(t: ref Tree, i: i64) -> String {
    t.items[i].value.clone()
}

fn dict_get(t: ref Tree, key: Str) -> Vec[Tree] {
    for e in t.items.iter() {
        if e.value == key {
            return e.items.clone();
        }
    }
    Vec.new()
}

const P_STR: i64 = 0;
const P_SEQ: i64 = 1;
const P_CHOICE: i64 = 2;
const P_CHOICE_DICT: i64 = 3;
const P_REPEAT: i64 = 4;
const P_REPEAT_DICT: i64 = 5;
const P_DELIM: i64 = 6;
const P_OPT: i64 = 7;
const P_ANY: i64 = 8;
const P_ANY_UNTIL: i64 = 9;

#[derive(Clone)]
struct Pat {
    kind: i64,
    text: String,
    kids: Vec[Pat],
    min: i64,
    keys: Vec[String],
    key_kid: Vec[i64],
}

fn pat(kind: i64, kids: own Vec[Pat]) -> Pat {
    Pat { kind: kind, text: String.new(), kids: kids, min: 0, keys: Vec.new(), key_kid: Vec.new() }
}

fn ps(kind: Str) -> Pat {
    Pat { kind: P_STR, text: kind.to_string(), kids: Vec.new(), min: 0, keys: Vec.new(), key_kid: Vec.new() }
}

// A Sequence of plain token kinds, written as one space-separated string.
fn seq_of(kinds: Str) -> Pat {
    let mut kids: Vec[Pat] = Vec.new();
    for k in kinds.split(" ") {
        kids.push(ps(k));
    }
    pat(P_SEQ, kids)
}

fn seq(kids: own Vec[Pat]) -> Pat {
    pat(P_SEQ, kids)
}

fn zero_or_more(p: own Pat) -> Pat {
    pat(P_REPEAT, [p].to_vec())
}

fn one_or_more(p: own Pat) -> Pat {
    let mut r = pat(P_REPEAT, [p].to_vec());
    r.min = 1;
    r
}

fn one_or_more_dict(p: own Pat) -> Pat {
    let mut r = pat(P_REPEAT_DICT, [p].to_vec());
    r.min = 1;
    r
}

fn delimited(p: own Pat) -> Pat {
    pat(P_DELIM, [p, ps(",")].to_vec())
}

fn optional(p: own Pat) -> Pat {
    pat(P_OPT, [p].to_vec())
}

fn any_until(p: own Pat) -> Pat {
    pat(P_ANY_UNTIL, [p].to_vec())
}

fn any_tok() -> Pat {
    pat(P_ANY, Vec.new())
}

// The first token kinds ChoiceDict would key a pattern on; None where it
// raises (any pattern that is not a string, a Sequence or a ChoiceDict).
fn first_kinds(p: ref Pat) -> Option[Vec[String]] {
    if p.kind == P_STR {
        return Some([p.text.clone()].to_vec());
    }
    if p.kind == P_SEQ {
        return first_kinds(p.kids[0]);
    }
    if p.kind == P_CHOICE_DICT {
        return Some(p.keys.clone());
    }
    None
}

// textparser.choice(): a ChoiceDict when every alternative starts with
// its own token kind, else an ordered Choice.
fn choice(kids: own Vec[Pat]) -> Pat {
    let mut keys: Vec[String] = Vec.new();
    let mut key_kid: Vec[i64] = Vec.new();
    let mut ok = true;
    for i in 0..kids.len() {
        match first_kinds(kids[i]) {
            Some(ks) => {
                for k in ks.iter() {
                    if keys.contains(k) {
                        ok = false;
                    }
                    keys.push(k.clone());
                    key_kid.push(i);
                }
            },
            None => {
                ok = false;
            },
        }
    }
    if ok {
        let mut r = pat(P_CHOICE_DICT, kids);
        r.keys = keys;
        r.key_kid = key_kid;
        r
    } else {
        pat(P_CHOICE, kids)
    }
}

fn pmatch(p: ref Pat, t: mut ref Toks) -> Option[Tree] {
    let k = p.kind;
    if k == P_STR {
        if peek_kind(t) == p.text {
            return Some(leaf(get_value(mut t)));
        }
        return None;
    }
    if k == P_SEQ {
        let mut out: Vec[Tree] = Vec.new();
        for kid in p.kids.iter() {
            match pmatch(kid, mut t) {
                Some(mo) => out.push(mo),
                None => return None,
            }
        }
        return Some(node(out));
    }
    if k == P_CHOICE {
        t_save(mut t);
        for kid in p.kids.iter() {
            t_mark_max_load(mut t);
            if let Some(mo) = pmatch(kid, mut t) {
                t_drop(mut t);
                return Some(mo);
            }
        }
        t_restore(mut t);
        return None;
    }
    if k == P_CHOICE_DICT {
        let kind = peek_kind(t);
        for i in 0..p.keys.len() {
            if p.keys[i] == kind {
                return pmatch(p.kids[p.key_kid[i]], mut t);
            }
        }
        return None;
    }
    if k == P_REPEAT {
        let mut out: Vec[Tree] = Vec.new();
        t_save(mut t);
        loop {
            match pmatch(p.kids[0], mut t) {
                Some(mo) => {
                    out.push(mo);
                    t_update(mut t);
                },
                None => {
                    t_mark_max_restore(mut t);
                    break;
                },
            }
        }
        if out.len() >= p.min {
            return Some(node(out));
        }
        return None;
    }
    if k == P_REPEAT_DICT {
        let mut entries: Vec[Tree] = Vec.new();
        t_save(mut t);
        loop {
            match pmatch(p.kids[0], mut t) {
                Some(mo) => {
                    let key = mo.items[0].value.clone();
                    let mut found = false;
                    for e in entries.iter_mut() {
                        if e.value == key {
                            e.items.push(mo.clone());
                            found = true;
                        }
                    }
                    if not found {
                        entries.push(Tree { leaf: false, value: key, items: [mo].to_vec() });
                    }
                    t_update(mut t);
                },
                None => {
                    t_mark_max_restore(mut t);
                    break;
                },
            }
        }
        if entries.len() >= p.min {
            return Some(node(entries));
        }
        return None;
    }
    if k == P_DELIM {
        let first = pmatch(p.kids[0], mut t)?;
        let mut out: Vec[Tree] = [first].to_vec();
        t_save(mut t);
        loop {
            if pmatch(p.kids[1], mut t).is_none() {
                break;
            }
            match pmatch(p.kids[0], mut t) {
                Some(mo) => {
                    out.push(mo);
                    t_update(mut t);
                },
                None => break,
            }
        }
        t_restore(mut t);
        return Some(node(out));
    }
    if k == P_OPT {
        t_save(mut t);
        match pmatch(p.kids[0], mut t) {
            Some(mo) => {
                t_drop(mut t);
                return Some(node([mo].to_vec()));
            },
            None => {
                t_mark_max_restore(mut t);
                return Some(node(Vec.new()));
            },
        }
    }
    if k == P_ANY {
        if peek_kind(t) == "__EOF__" {
            return None;
        }
        return Some(leaf(get_value(mut t)));
    }
    // P_ANY_UNTIL
    let mut out: Vec[Tree] = Vec.new();
    loop {
        t_save(mut t);
        if pmatch(p.kids[0], mut t).is_some() {
            break;
        }
        t_restore(mut t);
        if t.pos >= t.toks.len() {
            t_save(mut t);
            break;
        }
        out.push(leaf(get_value(mut t)));
    }
    t_restore(mut t);
    Some(node(out))
}

// ------------------------------------------------------------ tokenizer

fn line_of(text: ref Vec[char], offset: i64) -> i64 {
    let mut n = 1;
    for i in 0..offset {
        if text[i] == '\n' {
            n += 1;
        }
    }
    n
}

// textparser's 'Invalid syntax at line L, column C: "<line with >>!<<>"'.
fn invalid_syntax(text: ref Vec[char], offset: i64) -> String {
    let mut begin = offset;
    while begin > 0 and text[begin - 1] != '\n' {
        begin -= 1;
    }
    let mut end = offset;
    while end < text.len() and text[end] != '\n' {
        end += 1;
    }
    let column = offset - begin + 1;
    let marked = from_chars(text, begin, offset) + ">>!<<".to_string() + from_chars(text, offset, end);
    f"Invalid syntax at line {line_of(text, offset)}, column {column}: \"{marked}\""
}

fn is_word_char(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

const KEYWORDS: Str = "BA_ BA_DEF_ BA_DEF_DEF_ BA_DEF_DEF_REL_ BA_DEF_REL_ BA_DEF_SGTYPE_ BA_REL_ BA_SGTYPE_ BO_ BO_TX_BU_ BS_ BU_ BU_BO_REL_ BU_EV_REL_ BU_SG_REL_ CAT_ CAT_DEF_ CM_ ENVVAR_DATA_ EV_ EV_DATA_ FILTER NS_ NS_DESC_ SG_ SG_MUL_VAL_ SGTYPE_ SGTYPE_VAL_ SIG_GROUP_ SIG_TYPE_REF_ SIG_VALTYPE_ SIGTYPE_VALTYPE_ VAL_ VAL_TABLE_ VERSION";

// The length of the NUMBER regex's match at i, [-+]?\d+\.?\d*([eE][+-]?\d+)?,
// or 0.
fn number_len(c: ref Vec[char], i: i64) -> i64 {
    let n = c.len();
    let mut j = i;
    if j < n and (c[j] == '+' or c[j] == '-') {
        j += 1;
    }
    let digits = j;
    while j < n and is_digit(c[j]) {
        j += 1;
    }
    if j == digits {
        return 0;
    }
    if j < n and c[j] == '.' {
        j += 1;
    }
    while j < n and is_digit(c[j]) {
        j += 1;
    }
    if j < n and (c[j] == 'e' or c[j] == 'E') {
        let mut k = j + 1;
        if k < n and (c[k] == '+' or c[k] == '-') {
            k += 1;
        }
        let ds = k;
        while k < n and is_digit(c[k]) {
            k += 1;
        }
        if k > ds {
            j = k;
        }
    }
    j - i
}

// The end (exclusive) of the STRING regex's lazy match "(\\"|[^"])*?" at
// i, or -1. An escaped quote is taken as part of the string unless the
// string has no other end, when the regex backtracks to the last one.
fn string_end(c: ref Vec[char], i: i64) -> i64 {
    let n = c.len();
    let mut j = i + 1;
    let mut last_escape = -1;
    while j < n {
        if c[j] == '"' {
            return j + 1;
        }
        if c[j] == '\\' and j + 1 < n and c[j + 1] == '"' {
            last_escape = j + 1;
            j += 2;
        } else {
            j += 1;
        }
    }
    if last_escape >= 0 {
        return last_escape + 1;
    }
    -1
}

fn tokenize(c: ref Vec[char]) -> Result[Vec[Tok], i64] {
    let keywords: Vec[String] = KEYWORDS.split(" ").map(|w| w.to_string()).collect();
    let mut toks: Vec[Tok] = Vec.new();
    let n = c.len();
    let mut i = 0;
    while i < n {
        let ch = c[i];
        if ch == ' ' or ch == '\r' or ch == '\n' or ch == '\t' {
            i += 1;
            continue;
        }
        if ch == '/' and i + 1 < n and c[i + 1] == '/' {
            let mut j = i + 2;
            while j < n and c[j] != '\n' {
                j += 1;
            }
            if j < n {
                i = j + 1;
                continue;
            }
        }
        let nl = number_len(c, i);
        if nl > 0 {
            let v = from_chars(c, i, i + nl);
            toks.push(Tok { kind: "NUMBER".to_string(), value: v, offset: i });
            i += nl;
            continue;
        }
        if is_word_char(ch) {
            let mut j = i;
            while j < n and is_word_char(c[j]) {
                j += 1;
            }
            let v = from_chars(c, i, j);
            let kind = if keywords.contains(v) { v.clone() } else { "WORD".to_string() };
            toks.push(Tok { kind: kind, value: v, offset: i });
            i = j;
            continue;
        }
        if ch == '"' {
            let e = string_end(c, i);
            if e > 0 {
                let v = from_chars(c, i + 1, e - 1).replace("\\\"", "\"");
                toks.push(Tok { kind: "STRING".to_string(), value: v, offset: i });
                i = e;
                continue;
            }
        }
        if ch == '(' or ch == ')' or ch == '[' or ch == ']' or ch == ',' or ch == '|' or ch == '@' or ch == ';' or ch == ':' {
            let s = ch.to_string();
            toks.push(Tok { kind: s.clone(), value: s, offset: i });
            i += 1;
            continue;
        }
        if ch == '+' or ch == '-' {
            toks.push(Tok { kind: "+/-".to_string(), value: ch.to_string(), offset: i });
            i += 1;
            continue;
        }
        return Err(i);
    }
    Ok(toks)
}

// ------------------------------------------------------------ DBC grammar

fn dbc_grammar() -> Pat {
    let version = seq_of("VERSION STRING");
    let ns = seq([ps("NS_"), ps(":"), any_until(seq([any_tok(), ps(":")].to_vec()))].to_vec());
    let bs = seq_of("BS_ :");
    let nodes = seq([ps("BU_"), ps(":"), zero_or_more(ps("WORD"))].to_vec());
    let signal = seq([
        ps("SG_"),
        choice([seq_of("WORD WORD"), seq_of("WORD")].to_vec()),
        ps(":"), ps("NUMBER"), ps("|"), ps("NUMBER"), ps("@"), ps("NUMBER"), ps("+/-"),
        ps("("), ps("NUMBER"), ps(","), ps("NUMBER"), ps(")"),
        ps("["), ps("NUMBER"), ps("|"), ps("NUMBER"), ps("]"),
        ps("STRING"),
        delimited(ps("WORD")),
    ].to_vec());
    let message = seq([ps("BO_"), ps("NUMBER"), ps("WORD"), ps(":"), ps("NUMBER"), ps("WORD"), zero_or_more(signal)].to_vec());
    let environment_variable = seq_of("EV_ WORD : NUMBER [ NUMBER | NUMBER ] STRING NUMBER NUMBER WORD WORD ;");
    let comment = seq([
        ps("CM_"),
        choice([
            seq_of("SG_ NUMBER WORD STRING"),
            seq_of("BO_ NUMBER STRING"),
            seq_of("EV_ WORD STRING"),
            seq_of("BU_ WORD STRING"),
            ps("STRING"),
        ].to_vec()),
        ps(";"),
    ].to_vec());
    let attribute_definition = seq([
        ps("BA_DEF_"),
        optional(choice([ps("SG_"), ps("BO_"), ps("EV_"), ps("BU_")].to_vec())),
        ps("STRING"),
        ps("WORD"),
        optional(choice([delimited(ps("STRING")), zero_or_more(ps("NUMBER"))].to_vec())),
        ps(";"),
    ].to_vec());
    let attribute_definition_default = seq([ps("BA_DEF_DEF_"), ps("STRING"), choice([ps("NUMBER"), ps("STRING")].to_vec()), ps(";")].to_vec());
    let attribute = seq([
        ps("BA_"),
        ps("STRING"),
        zero_or_more(choice([
            seq_of("BO_ NUMBER"),
            seq_of("SG_ NUMBER WORD"),
            seq_of("BU_ WORD"),
            seq_of("EV_ WORD"),
        ].to_vec())),
        choice([ps("NUMBER"), ps("STRING")].to_vec()),
        ps(";"),
    ].to_vec());
    let attribute_definition_rel = seq([
        ps("BA_DEF_REL_"),
        optional(choice([ps("BU_SG_REL_"), ps("BU_BO_REL_")].to_vec())),
        ps("STRING"),
        ps("WORD"),
        optional(choice([delimited(ps("STRING")), one_or_more(ps("NUMBER"))].to_vec())),
        ps(";"),
    ].to_vec());
    let attribute_definition_default_rel = seq([ps("BA_DEF_DEF_REL_"), ps("STRING"), choice([ps("NUMBER"), ps("STRING")].to_vec()), ps(";")].to_vec());
    let attribute_rel_sg = seq([
        ps("BA_REL_"), ps("STRING"), ps("BU_SG_REL_"), ps("WORD"), ps("SG_"), ps("NUMBER"), ps("WORD"),
        choice([ps("NUMBER"), ps("STRING")].to_vec()), ps(";"),
    ].to_vec());
    let attribute_rel_bo = seq([
        ps("BA_REL_"), ps("STRING"), ps("BU_BO_REL_"), ps("WORD"), ps("NUMBER"),
        choice([ps("NUMBER"), ps("STRING")].to_vec()), ps(";"),
    ].to_vec());
    let choice_ = seq([ps("VAL_"), optional(ps("NUMBER")), ps("WORD"), zero_or_more(seq_of("NUMBER STRING")), ps(";")].to_vec());
    let value_table = seq([ps("VAL_TABLE_"), ps("WORD"), zero_or_more(seq_of("NUMBER STRING")), ps(";")].to_vec());
    let signal_type = seq_of("SIG_VALTYPE_ NUMBER WORD : NUMBER ;");
    let signal_multiplexer_values = seq([ps("SG_MUL_VAL_"), ps("NUMBER"), ps("WORD"), ps("WORD"), delimited(seq_of("NUMBER NUMBER")), ps(";")].to_vec());
    let message_add_sender = seq([ps("BO_TX_BU_"), ps("NUMBER"), ps(":"), delimited(ps("WORD")), ps(";")].to_vec());
    let signal_group = seq([ps("SIG_GROUP_"), ps("NUMBER"), ps("WORD"), ps("NUMBER"), ps(":"), zero_or_more(ps("WORD")), ps(";")].to_vec());
    one_or_more_dict(choice([
        message,
        comment,
        attribute_definition,
        value_table,
        choice_,
        attribute,
        attribute_rel_sg,
        attribute_rel_bo,
        attribute_definition_rel,
        attribute_definition_default,
        attribute_definition_default_rel,
        signal_group,
        signal_type,
        signal_multiplexer_values,
        message_add_sender,
        environment_variable,
        nodes,
        ns,
        bs,
        version,
    ].to_vec()))
}

// Parser().parse(string): the token tree, or ParseError's message.
fn parse_dbc(text: ref Vec[char]) -> Result[Tree, String] {
    let mut toks = match tokenize(text) {
        Ok(ts) => ts,
        Err(off) => return Err(invalid_syntax(text, off)),
    };
    toks.push(Tok { kind: "__EOF__".to_string(), value: "__EOF__".to_string(), offset: text.len() });
    let mut t = Toks { toks: toks, pos: 0, stack: Vec.new(), max_pos: -1 };
    let grammar = dbc_grammar();
    let parsed = pmatch(grammar, mut t);
    let mp = tok_at(t, t.max_pos);
    match parsed {
        Some(tree) => {
            if t.toks[mp].kind == "__EOF__" {
                return Ok(tree);
            }
            Err(invalid_syntax(text, t.toks[mp].offset))
        },
        None => Err(invalid_syntax(text, t.toks[mp].offset)),
    }
}

// ------------------------------------------------------------ conversions

const C_IDENTITY: i64 = 0;
const C_LINEAR_INT: i64 = 1;
const C_LINEAR: i64 = 2;
const C_NAMED: i64 = 3;

// conversion.py: BaseConversion.factory picks one of the four. A named
// conversion keeps the conversion it would have had without choices in
// `inner`.
#[derive(Clone)]
struct Conv {
    kind: i64,
    inner: i64,
    scale: Num,
    offset: Num,
    choices: Vec[(i64, String)],
}

fn num_is_integer(n: ref Num) -> bool {
    match n {
        Num.I(_) => true,
        Num.F(x) => x == x.floor(),
    }
}

fn num_to_int(n: ref Num) -> Num {
    match n {
        Num.I(x) => Num.I(x),
        Num.F(x) => Num.I(x as i64),
    }
}

fn plain_kind(scale: ref Num, offset: ref Num) -> i64 {
    if num_eq_int(scale, 1) and num_eq_int(offset, 0) {
        C_IDENTITY
    } else if num_is_integer(scale) and num_is_integer(offset) {
        C_LINEAR_INT
    } else {
        C_LINEAR
    }
}

fn make_conv(scale: own Num, offset: own Num, choices: ref Option[Vec[(i64, String)]]) -> Conv {
    let k = plain_kind(scale, offset);
    match choices {
        Some(cs) => Conv { kind: C_NAMED, inner: k, scale: scale, offset: offset, choices: cs.clone() },
        None => {
            if k == C_IDENTITY {
                Conv { kind: k, inner: k, scale: Num.I(1), offset: Num.I(0), choices: Vec.new() }
            } else if k == C_LINEAR_INT {
                Conv { kind: k, inner: k, scale: num_to_int(scale), offset: num_to_int(offset), choices: Vec.new() }
            } else {
                Conv { kind: k, inner: k, scale: scale, offset: offset, choices: Vec.new() }
            }
        },
    }
}

// The conversion a NamedSignalConversion delegates numbers to.
fn plain_of(c: ref Conv) -> Conv {
    if c.kind == C_NAMED {
        make_conv(c.scale.clone(), c.offset.clone(), None)
    } else {
        c.clone()
    }
}

fn conv_repr(c: ref Conv) -> String {
    if c.kind == C_IDENTITY {
        return "IdentityConversion(is_float=False)".to_string();
    }
    if c.kind == C_LINEAR_INT {
        return f"LinearIntegerConversion(scale={num_str(c.scale)}, offset={num_str(c.offset)})";
    }
    if c.kind == C_LINEAR {
        return f"LinearConversion(scale={num_str(c.scale)}, offset={num_str(c.offset)}, is_float=False)";
    }
    let mut parts: Vec[String] = Vec.new();
    for (v, name) in c.choices.iter() {
        parts.push(f"{v}: '{name}'");
    }
    let list = join(parts, ", ");
    f"NamedSignalConversion(scale={num_str(c.scale)}, offset={num_str(c.offset)}, choices={{{list}}}, is_float=False)"
}

fn choice_name(c: ref Conv, raw: i64) -> Option[String] {
    if c.kind != C_NAMED {
        return None;
    }
    for (v, name) in c.choices.iter() {
        if v == raw {
            return Some(name.clone());
        }
    }
    None
}

fn has_choice(c: ref Conv, raw: ref Num) -> bool {
    if c.kind != C_NAMED {
        return false;
    }
    for (v, _) in c.choices.iter() {
        if num_eq_int(raw, v) {
            return true;
        }
    }
    false
}

// choice_to_number(str(choice)): _inverse_choices keeps the last value
// of a repeated name. A conversion without choices raises a bare
// KeyError.
fn choice_to_number(c: ref Conv, text: ref String) -> Result[i64, Fail] {
    if c.kind != C_NAMED {
        return Err(fail("KeyError", String.new()));
    }
    let mut found: Option[i64] = None;
    for (v, name) in c.choices.iter() {
        if name == text {
            found = Some(v);
        }
    }
    match found {
        Some(v) => Ok(v),
        None => Err(key_error(text)),
    }
}

// raw_to_scaled for a number.
fn raw_to_scaled_num(c: ref Conv, raw: ref Num) -> Num {
    let k = if c.kind == C_NAMED { c.inner } else { c.kind };
    if k == C_IDENTITY {
        return raw.clone();
    }
    let p = plain_of(c);
    num_add(num_mul(raw, p.scale), p.offset)
}

fn raw_to_scaled(c: ref Conv, raw: i64, decode_choices: bool) -> Val {
    if decode_choices {
        if let Some(name) = choice_name(c, raw) {
            return Val.Named(raw, name);
        }
    }
    match raw_to_scaled_num(c, Num.I(raw)) {
        Num.I(x) => Val.I(x),
        Num.F(x) => Val.F(x),
    }
}

// numeric_scaled_to_raw: always an int for these integer signals.
fn scaled_to_raw(c: ref Conv, v: ref Num) -> i64 {
    let p = plain_of(c);
    if p.kind == C_IDENTITY {
        return py_round(v);
    }
    if p.kind == C_LINEAR_INT {
        let r = num_sub(v, p.offset);
        let (q, exact) = num_divmod(r, p.scale);
        if exact {
            return py_round(q);
        }
        return round_half_even(num_div(r, p.scale));
    }
    round_half_even(num_div(num_sub(v, p.offset), p.scale))
}

// ------------------------------------------------------------ the database

#[derive(Clone)]
enum AVal {
    I(i64),
    F(f64),
    S(String),
}

fn aval_repr(v: ref AVal) -> String {
    match v {
        AVal.I(x) => f"{x}",
        AVal.F(x) => float_str(x),
        AVal.S(s) => py_repr(s),
    }
}

#[derive(Clone)]
struct AttrDef {
    name: String,
    type_name: String,
    choices: Option[Vec[String]],
    default: Option[AVal],
}

// One BA_ line: scope 0 database, 1 node, 2 message, 3 signal, 4 envvar.
#[derive(Clone)]
struct AttrRow {
    scope: i64,
    owner: String,
    frame: i64,
    signal: String,
    name: String,
    value: AVal,
}

#[derive(Clone)]
struct Sig {
    name: String,
    start: i64,
    length: i64,
    little: bool,
    signed: bool,
    receivers: Vec[String],
    initial: Option[AVal],
    conv: Conv,
    minimum: Option[Num],
    maximum: Option[Num],
    unit: Option[String],
    comment: Option[String],
    is_mux: bool,
    mux_ids: Option[Vec[i64]],
    mux_signal: Option[String],
}

// A codec node: its signals (indices into Msg.signals) and, for each
// multiplexer among them, the child node of every multiplexer id.
#[derive(Clone)]
struct Codec {
    sigs: Vec[i64],
    muxes: Vec[MuxNode],
}

#[derive(Clone)]
struct MuxNode {
    sig: i64,
    ids: Vec[i64],
    nodes: Vec[Codec],
}

#[derive(Clone)]
struct Msg {
    frame_id: i64,
    extended: bool,
    name: String,
    length: i64,
    senders: Vec[String],
    send_type: Option[String],
    cycle: Option[i64],
    comment: Option[String],
    signals: Vec[Sig],
    codec: Codec,
}

#[derive(Clone)]
struct DbNode {
    name: String,
    comment: Option[String],
    address: Option[AVal],
}

struct Db {
    version: Option[String],
    bus: Option[(String, Option[String])],
    nodes: Vec[DbNode],
    value_tables: Vec[(String, Vec[(i64, String)])],
    messages: Vec[Msg],
}

// cantools's start_bit(): the network bit number of a big-endian
// signal's most significant bit, the start of a little-endian one.
fn start_bit(s: ref Sig) -> i64 {
    if s.little {
        s.start
    } else {
        8 * (s.start / 8) + 7 - s.start % 8
    }
}

fn opt_str_eq(a: ref Option[String], b: ref Option[String]) -> bool {
    match (a, b) {
        (Some(x), Some(y)) => x == y,
        (None, None) => true,
        _ => false,
    }
}

// Message._create_codec, recursively.
fn create_codec(sigs: ref Vec[Sig], parent: ref Option[String], mux_id: Option[i64]) -> Codec {
    let mut out: Vec[i64] = Vec.new();
    let mut muxes: Vec[MuxNode] = Vec.new();
    for i in 0..sigs.len() {
        let s = sigs[i].clone();
        if not opt_str_eq(s.mux_signal, parent) {
            continue;
        }
        if let Some(id) = mux_id {
            let listed = match s.mux_ids {
                Some(ids) => ids.contains(id),
                None => false,
            };
            if not listed {
                continue;
            }
        }
        if s.is_mux {
            // A Python set of small ints, which iterates in order.
            let mut children: Vec[i64] = Vec.new();
            for c in sigs.iter() {
                let under = match c.mux_signal {
                    Some(m) => *m == s.name,
                    None => false,
                };
                if not under {
                    continue;
                }
                if let Some(ids) = c.mux_ids {
                    for id in ids.iter() {
                        if not children.contains(*id) {
                            children.push(*id);
                        }
                    }
                }
            }
            for (v, _) in s.conv.choices.iter() {
                if not children.contains(v) {
                    children.push(v);
                }
            }
            children.sort();
            let mut nodes: Vec[Codec] = Vec.new();
            for id in children.iter() {
                nodes.push(create_codec(sigs, Some(s.name.clone()), Some(*id)));
            }
            muxes.push(MuxNode { sig: i, ids: children, nodes: nodes });
        }
        out.push(i);
    }
    Codec { sigs: out, muxes: muxes }
}

fn mux_of(c: ref Codec, sig: i64) -> Option[i64] {
    for k in 0..c.muxes.len() {
        if c.muxes[k].sig == sig {
            return Some(k);
        }
    }
    None
}

fn tree_repr(m: ref Msg, c: ref Codec) -> String {
    let mut parts: Vec[String] = Vec.new();
    for i in c.sigs.iter() {
        let name = m.signals[*i].name.clone();
        match mux_of(c, *i) {
            Some(k) => {
                let mn = c.muxes[k].clone();
                let mut subs: Vec[String] = Vec.new();
                for j in 0..mn.ids.len() {
                    subs.push(f"{mn.ids[j]}: {tree_repr(m, mn.nodes[j])}");
                }
                parts.push(f"{{'{name}': {{{join(subs, ", ")}}}}}");
            },
            None => parts.push(py_repr(name)),
        }
    }
    f"[{join(parts, ", ")}]"
}

// Message._check_signal: lay the signal's bits out the way cantools
// does, then refuse a signal that sticks out or lands on another one.
fn check_signal(m: ref Msg, bits: mut ref Vec[i64], idx: i64) -> Result[(), Fail] {
    let s = m.signals[idx].clone();
    let mut sb: Vec[i64] = Vec.new();
    if not s.little {
        for _ in 0..start_bit(s) {
            sb.push(-1);
        }
        for _ in 0..s.length {
            sb.push(idx);
        }
    } else {
        let mut r: Vec[i64] = Vec.new();
        for _ in 0..s.length {
            r.push(idx);
        }
        for _ in 0..s.start {
            r.push(-1);
        }
        let mut padded: Vec[i64] = Vec.new();
        if r.len() < bits.len() {
            for _ in 0..bits.len() - r.len() {
                padded.push(-1);
            }
        }
        for x in r.iter() {
            padded.push(*x);
        }
        let mut chunks: Vec[Vec[i64]] = Vec.new();
        let mut i = 0;
        while i < padded.len() {
            let mut chunk: Vec[i64] = Vec.new();
            let mut j = i;
            while j < i + 8 and j < padded.len() {
                chunk.push(padded[j]);
                j += 1;
            }
            chunks.push(chunk);
            i += 8;
        }
        let mut k = chunks.len() - 1;
        while k >= 0 {
            for x in chunks[k].iter() {
                sb.push(*x);
            }
            k -= 1;
        }
    }
    if sb.len() > bits.len() {
        return Err(fail("Error", f"The signal {s.name} does not fit in message {m.name}."));
    }
    for off in 0..sb.len() {
        if sb[off] >= 0 {
            if bits[off] >= 0 {
                let other = m.signals[bits[off]].name.clone();
                return Err(fail("Error", f"The signals {s.name} and {other} are overlapping in message {m.name}."));
            }
            bits[off] = idx;
        }
    }
    Ok(())
}

fn check_tree(m: ref Msg, bits: mut ref Vec[i64], c: ref Codec) -> Result[(), Fail] {
    for i in c.sigs.iter() {
        check_signal(m, mut bits, *i)?;
        if let Some(k) = mux_of(c, *i) {
            let mn = c.muxes[k].clone();
            let base = bits.clone();
            // _check_mux walks sorted(children); the ids already are.
            for j in 0..mn.ids.len() {
                let mut child = base.clone();
                check_tree(m, mut child, mn.nodes[j])?;
                for b in 0..child.len() {
                    if child[b] >= 0 {
                        bits[b] = child[b];
                    }
                }
            }
        }
    }
    Ok(())
}

// Message.__init__ and refresh(): the frame id check, the signals in
// start-bit order (a stable sort), the codec, and with strict the
// length, fit and overlap checks.
fn build_message(frame_dbc: i64, name: own String, length: i64, senders: own Vec[String], send_type: own Option[String], cycle: Option[i64], comment: own Option[String], signals: own Vec[Sig], strict: bool) -> Result[Msg, Fail] {
    let frame_id = frame_dbc & 2147483647;
    let extended = (frame_dbc & 2147483648) != 0;
    let mut bl = 0;
    while (frame_id >> bl) > 0 {
        bl += 1;
    }
    if extended and bl > 29 {
        return Err(fail("Error", f"Extended frame id 0x{frame_id:x} is more than 29 bits in message {name}."));
    }
    if not extended and bl > 11 {
        return Err(fail("Error", f"Standard frame id 0x{frame_id:x} is more than 11 bits in message {name}."));
    }
    let mut keyed: Vec[(i64, i64)] = Vec.new();
    for i in 0..signals.len() {
        keyed.push((start_bit(signals[i]), i));
    }
    keyed.sort();
    let mut sorted: Vec[Sig] = Vec.new();
    for (_, i) in keyed.iter() {
        sorted.push(signals[i].clone());
    }
    for s in sorted.iter() {
        if s.length <= 0 {
            return Err(fail("Error", f"The signal {s.name} length {s.length} is not greater than 0 in message {name}."));
        }
    }
    // The root node has no parent multiplexer.
    let codec = create_codec(sorted, None, None);
    let m = Msg {
        frame_id: frame_id,
        extended: extended,
        name: name,
        length: length,
        senders: senders,
        send_type: send_type,
        cycle: cycle,
        comment: comment,
        signals: sorted,
        codec: codec,
    };
    if strict {
        let mut bits: Vec[i64] = Vec.filled(8 * m.length, -1);
        check_tree(m, mut bits, m.codec)?;
    }
    Ok(m)
}

// ------------------------------------------------------------ dbc.py loaders

fn find_def(defs: ref Vec[AttrDef], name: ref String) -> Option[AttrDef] {
    for d in defs.iter() {
        if d.name == *name {
            return Some(d.clone());
        }
    }
    None
}

fn convert_value(type_name: ref String, value: ref String, enum_too: bool) -> AVal {
    if type_name == "INT" or type_name == "HEX" or (enum_too and type_name == "ENUM") {
        return AVal.I(decimal_int(value));
    }
    if type_name == "FLOAT" {
        return AVal.F(f64.parse(value.clone()).unwrap_or(0.0));
    }
    AVal.S(value.clone())
}

fn find_attr(rows: ref Vec[AttrRow], scope: i64, owner: ref String, frame: i64, signal: ref String, name: Str) -> Option[AVal] {
    let mut out: Option[AVal] = None;
    for r in rows.iter() {
        if r.scope == scope and r.name == name and r.owner == *owner and r.frame == frame and r.signal == *signal {
            out = Some(r.value.clone());
        }
    }
    out
}

struct Comments {
    bus: Option[String],
    nodes: Vec[(String, String)],
    messages: Vec[(i64, String)],
    signals: Vec[(i64, String, String)],
}

fn last_comment_node(c: ref Comments, name: ref String) -> Option[String] {
    let mut out: Option[String] = None;
    for (n, t) in c.nodes.iter() {
        if n == name {
            out = Some(t.clone());
        }
    }
    out
}

fn last_comment_message(c: ref Comments, frame: i64) -> Option[String] {
    let mut out: Option[String] = None;
    for (f, t) in c.messages.iter() {
        if f == frame {
            out = Some(t.clone());
        }
    }
    out
}

fn last_comment_signal(c: ref Comments, frame: i64, sig: ref String) -> Option[String] {
    let mut out: Option[String] = None;
    for (f, s, t) in c.signals.iter() {
        if f == frame and s == sig {
            out = Some(t.clone());
        }
    }
    out
}

fn load_comments(tokens: ref Tree) -> Comments {
    let mut c = Comments { bus: None, nodes: Vec.new(), messages: Vec.new(), signals: Vec.new() };
    for cm in dict_get(tokens, "CM_").iter() {
        let item = cm.items[1].clone();
        if item.leaf {
            let prev = match c.bus {
                Some(b) => b.clone(),
                None => String.new(),
            };
            c.bus = Some(prev + item.value.clone());
            continue;
        }
        let kind = tv(item, 0);
        if kind == "SG_" {
            c.signals.push((decimal_int(tv(item, 1)), tv(item, 2), tv(item, 3)));
        } else if kind == "BO_" {
            c.messages.push((decimal_int(tv(item, 1)), tv(item, 2)));
        } else if kind == "BU_" or kind == "EV_" {
            c.nodes.push((tv(item, 1), tv(item, 2)));
        }
    }
    c
}

// _load_choices and _load_value_tables: an OrderedDict, so a repeated
// number keeps its first place and takes the last name.
fn choice_pairs(pairs: ref Tree) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    for p in pairs.items.iter() {
        let v = decimal_int(tv(p, 0));
        let name = tv(p, 1);
        let mut replaced = false;
        for e in out.iter_mut() {
            if e.0 == v {
                e.1 = name.clone();
                replaced = true;
            }
        }
        if not replaced {
            out.push((v, name));
        }
    }
    out
}

fn load_string(text: ref String, strict: bool) -> Result[Db, Fail] {
    match load_inner(text, strict) {
        Ok(db) => Ok(db),
        Err(e) => {
            Err(fail("UnsupportedDatabaseFormatError", f"DBC: \"{e.msg}\""))
        },
    }
}

fn load_inner(text: ref String, strict: bool) -> Result[Db, Fail] {
    let chars = chars_of(text);
    let tokens = match parse_dbc(chars) {
        Ok(t) => t,
        Err(msg) => return Err(fail("ParseError", msg)),
    };
    let comments = load_comments(tokens);

    // get_definitions_dict
    let mut defaults: Vec[(String, String)] = Vec.new();
    for d in dict_get(tokens, "BA_DEF_DEF_").iter() {
        defaults.push((tv(d, 1), d.items[2].value.clone()));
    }
    let mut defs: Vec[AttrDef] = Vec.new();
    for item in dict_get(tokens, "BA_DEF_").iter() {
        let name = tv(item, 2);
        let type_name = tv(item, 3);
        let values = item.items[4].items[0].clone();
        let mut choices: Option[Vec[String]] = None;
        if values.items.len() > 0 and type_name == "ENUM" {
            let mut cs: Vec[String] = Vec.new();
            for v in values.items.iter() {
                cs.push(v.value.clone());
            }
            choices = Some(cs);
        }
        let mut default: Option[AVal] = None;
        for (k, v) in defaults.iter() {
            if *k == name {
                default = Some(convert_value(type_name, v, false));
            }
        }
        let def = AttrDef { name: name.clone(), type_name: type_name, choices: choices, default: default };
        let mut replaced = false;
        for e in defs.iter_mut() {
            if e.name == name {
                *e = def.clone();
                replaced = true;
            }
        }
        if not replaced {
            defs.push(def);
        }
    }

    // _load_attributes
    let mut rows: Vec[AttrRow] = Vec.new();
    for a in dict_get(tokens, "BA_").iter() {
        let name = tv(a, 1);
        let def = match find_def(defs, name) {
            Some(d) => d,
            None => return Err(key_error(name)),
        };
        let value = convert_value(def.type_name, a.items[3].value, true);
        let scopes = a.items[2].clone();
        let mut row = AttrRow { scope: 0, owner: String.new(), frame: -1, signal: String.new(), name: name, value: value };
        if scopes.items.len() > 0 {
            let item = scopes.items[0].clone();
            let kind = tv(item, 0);
            if kind == "SG_" {
                row.scope = 3;
                row.frame = decimal_int(tv(item, 1));
                row.signal = tv(item, 2);
            } else if kind == "BO_" {
                row.scope = 2;
                row.frame = decimal_int(tv(item, 1));
            } else if kind == "BU_" {
                row.scope = 1;
                row.owner = tv(item, 1);
            } else {
                row.scope = 4;
                row.owner = tv(item, 1);
            }
        }
        rows.push(row);
    }
    let empty = String.new();

    // _load_bus
    let bus_name = match find_attr(rows, 0, empty, -1, empty, "DBName") {
        Some(AVal.S(s)) => s,
        Some(v) => aval_repr(v),
        None => String.new(),
    };
    let baudrate = find_attr(rows, 0, empty, -1, empty, "Baudrate");
    let bus = if bus_name.len() > 0 or baudrate.is_some() or comments.bus.is_some() {
        Some((bus_name.clone(), comments.bus.clone()))
    } else {
        None
    };

    let mut value_tables: Vec[(String, Vec[(i64, String)])] = Vec.new();
    for vt in dict_get(tokens, "VAL_TABLE_").iter() {
        value_tables.push((tv(vt, 1), choice_pairs(vt.items[2])));
    }

    // _load_choices: (frame, signal) -> choices; a later VAL_ replaces.
    let mut choices: Vec[(i64, String, Vec[(i64, String)])] = Vec.new();
    for ch in dict_get(tokens, "VAL_").iter() {
        if ch.items[1].items.len() == 0 {
            continue;
        }
        let od = choice_pairs(ch.items[3]);
        if od.len() == 0 {
            continue;
        }
        let frame = decimal_int(ch.items[1].items[0].value);
        let sig = tv(ch, 2);
        let mut replaced = false;
        for e in choices.iter_mut() {
            if e.0 == frame and e.1 == sig {
                e.2 = od.clone();
                replaced = true;
            }
        }
        if not replaced {
            choices.push((frame, sig, od));
        }
    }

    // _load_message_senders
    let mut extra_senders: Vec[(i64, String)] = Vec.new();
    for s in dict_get(tokens, "BO_TX_BU_").iter() {
        let frame = decimal_int(tv(s, 1));
        for w in s.items[3].items.iter() {
            extra_senders.push((frame, w.value.clone()));
        }
    }

    let cycle_def = find_def(defs, "GenMsgCycleTime".to_string());
    let send_def = find_def(defs, "GenMsgSendType".to_string());

    // _load_messages
    let mut messages: Vec[Msg] = Vec.new();
    for message in dict_get(tokens, "BO_").iter() {
        let mname = tv(message, 2);
        if mname == "VECTOR__INDEPENDENT_SIG_MSG" {
            continue;
        }
        let frame_dbc = decimal_int(tv(message, 1));
        let mut senders: Vec[String] = [tv(message, 5)].to_vec();
        for (f, n) in extra_senders.iter() {
            if f == frame_dbc and not senders.contains(n) {
                senders.push(n.clone());
            }
        }
        if senders.len() == 1 and senders[0] == "Vector__XXX" {
            senders = Vec.new();
        }
        let send_type = match find_attr(rows, 2, empty, frame_dbc, empty, "GenMsgSendType") {
            Some(v) => match send_def {
                Some(ref d) => match d.choices {
                    Some(cs) => {
                        let idx = match v {
                            AVal.I(x) => x,
                            _ => 0,
                        };
                        Some(cs[idx].clone())
                    },
                    None => Some(val_text(v)),
                },
                None => Some(val_text(v)),
            },
            None => match send_def {
                Some(ref d) => match d.default {
                    Some(v) => Some(val_text(v)),
                    None => None,
                },
                None => None,
            },
        };
        let cycle = match cycle_def {
            None => None,
            Some(ref d) => {
                let explicit = match find_attr(rows, 2, empty, frame_dbc, empty, "GenMsgCycleTime") {
                    Some(AVal.I(x)) => Some(x),
                    _ => None,
                };
                match explicit {
                    Some(x) => if x == 0 { None } else { Some(x) },
                    None => match d.default {
                        Some(AVal.I(x)) => if x == 0 { None } else { Some(x) },
                        _ => None,
                    },
                }
            },
        };

        // The message's multiplexer: the one signal flagged M, if only one is.
        let mut mux_signal: Option[String] = None;
        for sg in message.items[6].items.iter() {
            let names = sg.items[1].clone();
            if names.items.len() == 2 and tv(names, 1).ends_with("M") {
                if mux_signal.is_none() {
                    mux_signal = Some(tv(names, 0));
                } else {
                    mux_signal = None;
                    break;
                }
            }
        }

        let mut signals: Vec[Sig] = Vec.new();
        for sg in message.items[6].items.iter() {
            let names = sg.items[1].clone();
            let sname = tv(names, 0);
            let two = names.items.len() == 2;
            let is_mux = two and tv(names, 1).ends_with("M");
            let mut ids: Vec[i64] = Vec.new();
            if mux_signal.is_some() and two and not tv(names, 1).ends_with("M") {
                let flag = tv(names, 1);
                let digits = from_chars(chars_of(flag), 1, flag.len());
                ids.push(decimal_int(digits));
            }
            let mux_ids = if ids.len() > 0 { Some(ids) } else { None };
            let sig_mux = match mux_signal {
                Some(ref ms) => if two and sname != *ms { Some(ms.clone()) } else { None },
                None => None,
            };
            let mut receivers: Vec[String] = Vec.new();
            for r in sg.items[20].items.iter() {
                receivers.push(r.value.clone());
            }
            if receivers.len() == 1 and receivers[0] == "Vector__XXX" {
                receivers = Vec.new();
            }
            let lo = tv(sg, 15);
            let hi = tv(sg, 17);
            let (minimum, maximum) = if lo == "0" and hi == "0" {
                (None, None)
            } else {
                (Some(num_of(lo)), Some(num_of(hi)))
            };
            let unit = tv(sg, 19);
            let mut sig_choices: Option[Vec[(i64, String)]] = None;
            for (f, s, cs) in choices.iter() {
                if f == frame_dbc and *s == sname {
                    sig_choices = Some(cs.clone());
                }
            }
            signals.push(Sig {
                name: sname.clone(),
                start: decimal_int(tv(sg, 3)),
                length: decimal_int(tv(sg, 5)),
                little: tv(sg, 7) != "0",
                signed: tv(sg, 8) == "-",
                receivers: receivers,
                initial: find_attr(rows, 3, empty, frame_dbc, sname, "GenSigStartValue"),
                conv: make_conv(num_of(tv(sg, 10)), num_of(tv(sg, 12)), sig_choices),
                minimum: minimum,
                maximum: maximum,
                unit: if unit.len() == 0 { None } else { Some(unit) },
                comment: last_comment_signal(comments, frame_dbc, sname),
                is_mux: is_mux,
                mux_ids: mux_ids,
                mux_signal: sig_mux,
            });
        }
        let m = build_message(
            frame_dbc,
            mname,
            decimal_int(tv(message, 4)),
            senders,
            send_type,
            cycle,
            last_comment_message(comments, frame_dbc),
            signals,
            strict,
        )?;
        messages.push(m);
    }

    // _load_nodes: the last BU_ line names them.
    let mut nodes: Vec[DbNode] = Vec.new();
    for bu in dict_get(tokens, "BU_").iter() {
        nodes = Vec.new();
        for w in bu.items[2].items.iter() {
            let n = w.value.clone();
            nodes.push(DbNode {
                name: n.clone(),
                comment: last_comment_node(comments, n),
                address: find_attr(rows, 1, n, -1, empty, "ECUAddress"),
            });
        }
    }

    let versions = dict_get(tokens, "VERSION");
    let version = if versions.len() > 0 { Some(tv(versions[0], 1)) } else { None };
    Ok(Db { version: version, bus: bus, nodes: nodes, value_tables: value_tables, messages: messages })
}

fn val_text(v: ref AVal) -> String {
    match v {
        AVal.I(x) => f"{x}",
        AVal.F(x) => float_str(x),
        AVal.S(s) => s.clone(),
    }
}

fn msg_by_name(db: ref Db, name: ref String) -> Result[Msg, Fail] {
    let mut out: Option[Msg] = None;
    for m in db.messages.iter() {
        if m.name == *name {
            out = Some(m.clone());
        }
    }
    match out {
        Some(m) => Ok(m),
        None => Err(key_error(name)),
    }
}

fn msg_by_frame(db: ref Db, frame: i64) -> Result[Msg, Fail] {
    let mut out: Option[Msg] = None;
    for m in db.messages.iter() {
        if m.frame_id == frame {
            out = Some(m.clone());
        }
    }
    match out {
        Some(m) => Ok(m),
        None => Err(fail("KeyError", f"{frame}")),
    }
}

// ------------------------------------------------------------ encode / decode

// A signal dict: names to values in insertion order, as a Python dict.
fn dget(d: ref Vec[(String, Val)], k: ref String) -> Option[Val] {
    for (n, v) in d.iter() {
        if n == k {
            return Some(v.clone());
        }
    }
    None
}

fn dset(d: mut ref Vec[(String, Val)], k: ref String, v: ref Val) {
    for e in d.iter_mut() {
        if e.0 == *k {
            e.1 = v.clone();
            return;
        }
    }
    d.push((k.clone(), v.clone()));
}

fn sig_by_name(m: ref Msg, name: ref String) -> i64 {
    let mut out = -1;
    for i in 0..m.signals.len() {
        if m.signals[i].name == *name {
            out = i;
        }
    }
    out
}

fn val_num(v: ref Val) -> Option[Num] {
    match v {
        Val.I(x) => Some(Num.I(x)),
        Val.F(x) => Some(Num.F(x)),
        _ => None,
    }
}

fn num_val(n: ref Num) -> Val {
    match n {
        Num.I(x) => Val.I(x),
        Num.F(x) => Val.F(x),
    }
}

// Message._get_mux_number
fn mux_number(m: ref Msg, d: ref Vec[(String, Val)], name: ref String) -> Result[i64, Fail] {
    let v = match dget(d, name) {
        Some(v) => v,
        None => return Err(key_error(name)),
    };
    match v {
        Val.I(x) => Ok(x),
        Val.F(x) => Ok(x as i64),
        _ => {
            let s = m.signals[sig_by_name(m, name)].clone();
            match choice_to_number(s.conv, val_str(v)) {
                Ok(n) => Ok(n),
                Err(_) => Err(fail("EncodeError", String.new())),
            }
        },
    }
}

fn ids_text(ids: ref Vec[i64]) -> String {
    let mut items: Vec[String] = Vec.new();
    for id in ids.iter() {
        items.push(f"{id}");
    }
    format_or(items)
}

// Message.gather_signals
fn gather(m: ref Msg, d: ref Vec[(String, Val)], c: ref Codec, out: mut ref Vec[(String, Val)]) -> Result[(), Fail] {
    for i in c.sigs.iter() {
        let name = m.signals[*i].name.clone();
        match dget(d, name) {
            Some(v) => dset(mut out, name, v),
            None => return Err(fail("EncodeError", f"The signal \"{name}\" is required for encoding.")),
        }
    }
    for mn in c.muxes.iter() {
        let name = m.signals[mn.sig].name.clone();
        let num = mux_number(m, d, name)?;
        let mut found = -1;
        for j in 0..mn.ids.len() {
            if mn.ids[j] == num {
                found = j;
            }
        }
        if found < 0 {
            let given = match dget(d, name) {
                Some(v) => val_str(v),
                None => String.new(),
            };
            return Err(fail("EncodeError", f"A valid value for the multiplexer selector signal \"{name}\" is required: Expected one of {{{ids_text(mn.ids)}}}, but got {given}"));
        }
        gather(m, d, mn.nodes[found], mut out)?;
    }
    Ok(())
}

// Message.assert_signals_encodable, with assert_values_valid and
// assert_all_known.
fn assert_encodable(m: ref Msg, d: ref Vec[(String, Val)], scaling: bool) -> Result[(), Fail] {
    let mut used: Vec[(String, Val)] = Vec.new();
    gather(m, d, m.codec, mut used)?;
    let mut extra: Vec[String] = Vec.new();
    for (n, _) in d.iter() {
        if dget(used, n).is_none() {
            extra.push(py_repr(n));
        }
    }
    // Python prints a set here, in no fixed order; one name has one order.
    if extra.len() > 0 or used.len() != d.len() {
        extra.sort();
        let shown = if extra.len() == 0 { "set()".to_string() } else { f"{{{join(extra, ", ")}}}" };
        return Err(fail("EncodeError", f"The following signals were specified but are not required to encode the message:{shown}"));
    }
    for (name, v) in used.iter() {
        let s = m.signals[sig_by_name(m, name)].clone();
        let n = match val_num(v) {
            Some(n) => n,
            None => {
                choice_to_number(s.conv, val_str(v))?;
                continue;
            },
        };
        let (scaled, raw) = if scaling {
            (n.clone(), Num.I(scaled_to_raw(s.conv, n)))
        } else {
            (raw_to_scaled_num(s.conv, n), n.clone())
        };
        if has_choice(s.conv, raw) {
            continue;
        }
        let slack = num_mul(num_abs(s.conv.scale), Num.F(0.000001));
        if let Some(lo) = s.minimum {
            if num_lt(scaled, num_sub(lo, slack)) {
                return Err(fail("EncodeError", f"Expected signal \"{s.name}\" value greater than or equal to {num_str(lo)} in message \"{m.name}\", but got {num_str(scaled)}."));
            }
        }
        if let Some(hi) = s.maximum {
            if num_lt(num_add(hi, slack), scaled) {
                return Err(fail("EncodeError", f"Expected signal \"{s.name}\" value smaller than or equal to {num_str(hi)} in message \"{m.name}\", but got {num_str(scaled)}."));
            }
        }
    }
    Ok(())
}

// bitstruct's range check on pack.
fn check_fits(s: ref Sig, raw: i64) -> Result[(), Fail] {
    let l = s.length;
    if s.signed {
        let lo = -(1 << (l - 1));
        let hi = (1 << (l - 1)) - 1;
        if raw < lo or raw > hi {
            return Err(fail("Error", f"\"s{l}\" requires {lo} <= integer <= {hi} (got {raw})"));
        }
    } else {
        let hi = (1 << l) - 1;
        if raw < 0 or raw > hi {
            return Err(fail("Error", f"\"u{l}\" requires 0 <= integer <= {hi} (got {raw})"));
        }
    }
    Ok(())
}

fn set_bit(buf: mut ref Vec[i64], byte: i64, bit: i64) {
    buf[byte] = buf[byte] | (1 << bit);
}

fn place(s: ref Sig, raw: i64, bytes: mut ref Vec[i64], used: mut ref Vec[i64]) {
    let l = s.length;
    let u = if raw < 0 { raw + (1 << l) } else { raw };
    if s.little {
        for i in 0..l {
            let b = s.start + i;
            set_bit(mut used, b / 8, b % 8);
            if (u >> i) & 1 == 1 {
                set_bit(mut bytes, b / 8, b % 8);
            }
        }
    } else {
        let nb = start_bit(s);
        for i in 0..l {
            let n = nb + i;
            set_bit(mut used, n / 8, 7 - n % 8);
            if (u >> (l - 1 - i)) & 1 == 1 {
                set_bit(mut bytes, n / 8, 7 - n % 8);
            }
        }
    }
}

// Message._encode over one codec node: encode_data's raw values, the
// big-endian signals packed in network order and the little-endian ones
// last to first (bitstruct's order, which decides which overflow is
// reported), then each multiplexer's chosen child.
fn encode_node(m: ref Msg, c: ref Codec, d: ref Vec[(String, Val)], scaling: bool, bytes: mut ref Vec[i64], used: mut ref Vec[i64]) -> Result[(), Fail] {
    let mut raws: Vec[i64] = Vec.new();
    for i in c.sigs.iter() {
        let s = m.signals[*i].clone();
        let v = match dget(d, s.name) {
            Some(v) => v,
            None => return Err(key_error(s.name)),
        };
        let raw = match val_num(v) {
            Some(n) => if scaling { scaled_to_raw(s.conv, n) } else { py_round(n) },
            None => choice_to_number(s.conv, val_str(v))?,
        };
        raws.push(raw);
    }
    let mut big: Vec[(i64, i64)] = Vec.new();
    for k in 0..c.sigs.len() {
        let s = m.signals[c.sigs[k]].clone();
        if not s.little {
            big.push((start_bit(s), k));
        }
    }
    big.sort();
    for (_, k) in big.iter() {
        check_fits(m.signals[c.sigs[k]], raws[k])?;
    }
    let mut k = c.sigs.len() - 1;
    while k >= 0 {
        let s = m.signals[c.sigs[k]].clone();
        if s.little {
            check_fits(s, raws[k])?;
        }
        k -= 1;
    }
    for k in 0..c.sigs.len() {
        place(m.signals[c.sigs[k]], raws[k], mut bytes, mut used);
    }
    for mn in c.muxes.iter() {
        let name = m.signals[mn.sig].name.clone();
        let num = mux_number(m, d, name)?;
        let mut found = -1;
        for j in 0..mn.ids.len() {
            if mn.ids[j] == num {
                found = j;
            }
        }
        if found < 0 {
            return Err(fail("EncodeError", f"Expected multiplexer id in {{{ids_text(mn.ids)}}}, for multiplexer \"{name}\" but got {num}"));
        }
        encode_node(m, mn.nodes[found], d, scaling, mut bytes, mut used)?;
    }
    Ok(())
}

// Message.encode
fn encode(m: ref Msg, d: ref Vec[(String, Val)], scaling: bool, padding: bool, strict: bool) -> Result[Vec[i64], Fail] {
    if strict {
        assert_encodable(m, d, scaling)?;
    }
    let mut bytes: Vec[i64] = Vec.filled(m.length, 0);
    let mut used: Vec[i64] = Vec.filled(m.length, 0);
    encode_node(m, m.codec, d, scaling, mut bytes, mut used)?;
    if padding {
        for i in 0..m.length {
            bytes[i] = bytes[i] | (255 ^ used[i]);
        }
    }
    Ok(bytes)
}

fn unpack(s: ref Sig, data: ref Vec[i64]) -> i64 {
    let l = s.length;
    let mut u = 0;
    if s.little {
        for i in 0..l {
            let b = s.start + i;
            if (data[b / 8] >> (b % 8)) & 1 == 1 {
                u = u | (1 << i);
            }
        }
    } else {
        let nb = start_bit(s);
        for i in 0..l {
            let n = nb + i;
            u = u << 1;
            if (data[n / 8] >> (7 - n % 8)) & 1 == 1 {
                u = u | 1;
            }
        }
    }
    if s.signed and (u >> (l - 1)) & 1 == 1 {
        u -= 1 << l;
    }
    u
}

// utils.decode_data, then Message._decode's multiplexers.
fn decode_node(m: ref Msg, c: ref Codec, data: ref Vec[i64], decode_choices: bool, scaling: bool, truncated: bool) -> Result[Vec[(String, Val)], Fail] {
    let actual = data.len();
    let mut buf = data.clone();
    if actual != m.length {
        if truncated {
            while buf.len() < m.length {
                buf.push(255);
            }
        }
        while buf.len() > m.length {
            buf.pop();
        }
        if buf.len() != m.length {
            return Err(fail("DecodeError", f"Wrong data size: {actual} instead of {m.length} bytes"));
        }
    }
    let mut out: Vec[(String, Val)] = Vec.new();
    for i in c.sigs.iter() {
        let s = m.signals[*i].clone();
        if actual < m.length and truncated and start_bit(s) + s.length > actual * 8 {
            continue;
        }
        let raw = unpack(s, buf);
        let v = if scaling {
            raw_to_scaled(s.conv, raw, decode_choices)
        } else {
            match if decode_choices { choice_name(s.conv, raw) } else { None } {
                Some(name) => Val.Named(raw, name),
                None => Val.I(raw),
            }
        };
        dset(mut out, s.name, v);
    }
    for mn in c.muxes.iter() {
        let name = m.signals[mn.sig].name.clone();
        if truncated and dget(out, name).is_none() {
            continue;
        }
        let num = mux_number(m, out, name)?;
        let mut found = -1;
        for j in 0..mn.ids.len() {
            if mn.ids[j] == num {
                found = j;
            }
        }
        if found < 0 {
            return Err(fail("DecodeError", f"expected multiplexer id {ids_text(mn.ids)}, but got {num}"));
        }
        let sub = decode_node(m, mn.nodes[found], data, decode_choices, scaling, truncated)?;
        for (k, v) in sub.iter() {
            dset(mut out, k, v);
        }
    }
    Ok(out)
}

fn decode(m: ref Msg, data: ref Vec[i64], decode_choices: bool, scaling: bool, truncated: bool) -> Result[Vec[(String, Val)], Fail] {
    decode_node(m, m.codec, data, decode_choices, scaling, truncated)
}

fn dict_repr(d: ref Vec[(String, Val)]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for (k, v) in d.iter() {
        parts.push(f"{py_repr(k)}: {val_repr(v)}");
    }
    f"{{{join(parts, ", ")}}}"
}

// ------------------------------------------------------------ the program

fn opt_int_str(v: ref Option[i64]) -> String {
    match v {
        Some(x) => f"{x}",
        None => "None".to_string(),
    }
}

fn opt_aval_repr(v: ref Option[AVal]) -> String {
    match v {
        Some(x) => aval_repr(x),
        None => "None".to_string(),
    }
}

fn summary(db: ref Db) {
    println(f"version {opt_repr(db.version)}");
    if let Some((name, comment)) = db.bus {
        println(f"bus {py_repr(name)}: {opt_repr(comment)}");
    }
    for n in db.nodes.iter() {
        println(f"node {n.name}: comment {opt_repr(n.comment)}, address {opt_aval_repr(n.address)}");
    }
    for (name, table) in db.value_tables.iter() {
        let mut items: Vec[String] = Vec.new();
        for (k, v) in table.iter() {
            items.push(f"{k}={v}");
        }
        println(f"value table {name}: {join(items, ", ")}");
    }
    for m in db.messages.iter() {
        let kind = if m.extended { "extended" } else { "standard" };
        let send = match m.send_type {
            Some(s) => py_repr(s),
            None => "None".to_string(),
        };
        println(f"message {m.name} 0x{m.frame_id:x} {kind}, {m.length} bytes, senders {list_repr(m.senders)}, cycle {opt_int_str(m.cycle)}, send type {send}");
        if let Some(c) = m.comment {
            println(f"  comment {py_repr(c)}");
        }
        let mut receivers: Vec[String] = Vec.new();
        for s in m.signals.iter() {
            for r in s.receivers.iter() {
                if not receivers.contains(r) {
                    receivers.push(r.clone());
                }
            }
        }
        receivers.sort();
        println(f"  receivers {list_repr(receivers)}, multiplexed {bool_str(m.codec.muxes.len() > 0)}");
        println(f"  tree {tree_repr(m, m.codec)}");
        for s in m.signals.iter() {
            let order = if s.little { "little" } else { "big" };
            let sign = if s.signed { "signed" } else { "unsigned" };
            println(f"  {s.name}: {s.start}|{s.length} {order} {sign}, range [{opt_num_str(s.minimum)}, {opt_num_str(s.maximum)}], unit {opt_repr(s.unit)}, receivers {list_repr(s.receivers)}, initial {opt_aval_repr(s.initial)}");
            println(f"    {conv_repr(s.conv)}, scale {num_str(s.conv.scale)}, offset {num_str(s.conv.offset)}");
            if s.is_mux {
                println("    multiplexer");
            }
            if let Some(ms) = s.mux_signal {
                let ids = match s.mux_ids {
                    Some(v) => ints_repr(v),
                    None => "None".to_string(),
                };
                println(f"    under {ms} for {ids}");
            }
            if let Some(c) = s.comment {
                println(f"    comment {py_repr(c)}");
            }
        }
    }
}

fn parse_value(text: ref String) -> Val {
    if text.starts_with("'") {
        let cs = chars_of(text);
        return Val.Str(from_chars(cs, 1, cs.len() - 1));
    }
    if text.contains(".") or text.contains("e") or text.contains("E") {
        return Val.F(f64.parse(text.clone()).unwrap_or(0.0));
    }
    Val.I(parse_int_text(text).unwrap_or(0))
}

fn run_job(db: ref Db, line: ref String) -> String {
    let words: Vec[String] = line.split(" ").filter(|w| w.len() > 0).map(|w| w.to_string()).collect();
    let opts: Vec[String] = words.iter().skip(2).filter(|w| w.starts_with("-")).map(|w| w.clone()).collect();
    if words[0] == "encode" {
        let mut values: Vec[(String, Val)] = Vec.new();
        for i in 2..words.len() {
            let w = words[i].clone();
            if w.starts_with("-") {
                continue;
            }
            if let Some((k, v)) = w.split_once("=") {
                dset(mut values, k.to_string(), parse_value(v.to_string()));
            }
        }
        let m = match msg_by_name(db, words[1]) {
            Ok(m) => m,
            Err(e) => return show_fail(e),
        };
        return match encode(m, values, not opts.contains("-noscale"), opts.contains("-pad"), not opts.contains("-loose")) {
            Ok(data) => hex_of(data),
            Err(e) => show_fail(e),
        };
    }
    let looked = if words[1].starts_with("0x") {
        let cs = chars_of(words[1]);
        msg_by_frame(db, parse_hex(from_chars(cs, 2, cs.len())))
    } else {
        msg_by_name(db, words[1])
    };
    let m = match looked {
        Ok(m) => m,
        Err(e) => return show_fail(e),
    };
    match decode(m, bytes_from_hex(words[2]), not opts.contains("-nochoices"), not opts.contains("-noscale"), opts.contains("-trunc")) {
        Ok(d) => dict_repr(d),
        Err(e) => show_fail(e),
    }
}

fn secs(us: i64) -> String {
    f"{us / 1000000}.{us % 1000000:06}"
}

fn rel(us: i64, t0: i64) -> String {
    let d = us - t0;
    f"{d / 1000000}.{d % 1000000 / 1000:03}"
}

fn ms3(us: i64) -> String {
    f"{us / 1000}.{us % 1000:03}"
}

// One candump -L line: "(<sec>.<usec>) <iface> <id>#<data>", the id three
// or eight hex digits, the data up to eight bytes. None for anything else.
fn parse_line(line: ref String) -> Option[(i64, String, Vec[i64])] {
    let c = chars_of(line);
    let n = c.len();
    if n == 0 or c[0] != '(' {
        return None;
    }
    let mut i = 1;
    let mut secs = 0;
    let st = i;
    while i < n and is_digit(c[i]) {
        secs = secs * 10 + ((c[i] as i64) - 48);
        i += 1;
    }
    if i == st or i >= n or c[i] != '.' {
        return None;
    }
    i += 1;
    let mut us = 0;
    for _ in 0..6 {
        if i >= n or not is_digit(c[i]) {
            return None;
        }
        us = us * 10 + ((c[i] as i64) - 48);
        i += 1;
    }
    if i + 1 >= n or c[i] != ')' or c[i + 1] != ' ' {
        return None;
    }
    i += 2;
    let st = i;
    while i < n and (is_digit(c[i]) or (c[i] >= 'a' and c[i] <= 'z')) {
        i += 1;
    }
    if i == st or i >= n or c[i] != ' ' {
        return None;
    }
    i += 1;
    let st = i;
    while i < n and is_hex_upper(c[i]) {
        i += 1;
    }
    let idlen = i - st;
    if (idlen != 3 and idlen != 8) or i >= n or c[i] != '#' {
        return None;
    }
    let ident = from_chars(c, st, i);
    i += 1;
    let ds = i;
    while i < n and is_hex_upper(c[i]) {
        i += 1;
    }
    let dl = i - ds;
    if i != n or dl % 2 != 0 or dl > 16 {
        return None;
    }
    Some((secs * 1000000 + us, ident, bytes_from_hex(from_chars(c, ds, n))))
}

#[derive(Clone)]
struct Stat {
    name: String,
    count: i64,
    lo: Option[Val],
    hi: Option[Val],
    last: Val,
    names: Vec[(String, i64)],
}

fn val_lt(a: ref Val, b: ref Val) -> bool {
    match (val_num(a), val_num(b)) {
        (Some(x), Some(y)) => num_lt(x, y),
        _ => false,
    }
}

fn stat_add(st: mut ref Stat, v: ref Val) {
    st.last = v.clone();
    if let Val.Named(_, name) = v {
        for e in st.names.iter_mut() {
            if e.0 == *name {
                e.1 += 1;
                return;
            }
        }
        st.names.push((name.clone(), 1));
        return;
    }
    st.count += 1;
    let lower = match st.lo {
        Some(lo) => val_lt(v, lo),
        None => true,
    };
    if lower {
        st.lo = Some(v.clone());
    }
    let higher = match st.hi {
        Some(hi) => val_lt(hi, v),
        None => true,
    };
    if higher {
        st.hi = Some(v.clone());
    }
}

#[derive(Clone)]
struct Seen {
    name: String,
    count: i64,
    first: i64,
    last: i64,
    gap: i64,
    gap_at: i64,
    stats: Vec[Stat],
}

fn val_f(v: ref Val) -> f64 {
    match val_num(v) {
        Some(n) => num_f(n),
        None => 0.0,
    }
}

fn val_i(v: ref Val) -> i64 {
    match v {
        Val.I(x) => x,
        Val.F(x) => x as i64,
        Val.Named(x, _) => x,
        Val.Str(_) => 0,
    }
}

fn opt_val_str(v: ref Option[Val]) -> String {
    match v {
        Some(x) => val_str(x),
        None => "None".to_string(),
    }
}

fn analyse(db: ref Db, text: ref String) {
    let mut lines: Vec[String] = text.split("\n").map(|l| l.to_string()).collect();
    if lines.len() > 0 and lines[lines.len() - 1].len() == 0 {
        lines.pop();
    }
    let mut bad_lines: Vec[i64] = Vec.new();
    let mut unknown: Vec[(String, i64)] = Vec.new();
    let mut seen: Vec[Seen] = Vec.new();
    let mut decode_errors: Vec[String] = Vec.new();
    let mut encode_errors: Vec[(String, i64, String)] = Vec.new();
    let mut mismatches: Vec[String] = Vec.new();
    let mut checksum_bad: Vec[String] = Vec.new();
    let mut counter_gaps: Vec[String] = Vec.new();
    let mut transitions: Vec[String] = Vec.new();
    let mut prev_named: Vec[(String, String)] = Vec.new();
    let mut t0 = -1;
    let mut dist_km = 0.0;
    let mut prev_speed: Option[(i64, f64)] = None;
    let mut energy_wh = 0.0;
    let mut prev_pack: Option[(i64, f64)] = None;
    let mut peak_kw = 0.0;
    let mut regen_kw = 0.0;
    let mut cell_lo: Option[(i64, String, String)] = None;
    let mut cell_hi: Option[(i64, String, String)] = None;
    let mut prev_counter = -1;
    let mut derate_frames = 0;
    let mut total = 0;
    for li in 0..lines.len() {
        let (ts, ident, data) = match parse_line(lines[li]) {
            Some(p) => p,
            None => {
                bad_lines.push(li + 1);
                continue;
            },
        };
        total += 1;
        if t0 < 0 {
            t0 = ts;
        }
        let m = match msg_by_frame(db, parse_hex(ident)) {
            Ok(m) => m,
            Err(_) => {
                let mut found = false;
                for e in unknown.iter_mut() {
                    if e.0 == ident {
                        e.1 += 1;
                        found = true;
                    }
                }
                if not found {
                    unknown.push((ident, 1));
                }
                continue;
            },
        };
        let mut si = -1;
        for k in 0..seen.len() {
            if seen[k].name == m.name {
                si = k;
            }
        }
        if si < 0 {
            seen.push(Seen { name: m.name.clone(), count: 0, first: ts, last: ts, gap: 0, gap_at: ts, stats: Vec.new() });
            si = seen.len() - 1;
        }
        if seen[si].count > 0 and ts - seen[si].last > seen[si].gap {
            seen[si].gap = ts - seen[si].last;
            seen[si].gap_at = ts;
        }
        seen[si].count += 1;
        seen[si].last = ts;
        let decoded = match decode(m, data, true, true, false) {
            Ok(d) => d,
            Err(e) => {
                decode_errors.push(f"{rel(ts, t0)} {m.name} [{hex_of(data)}]: {show_fail(e)}");
                continue;
            },
        };
        for (name, v) in decoded.iter() {
            let mut k = -1;
            for j in 0..seen[si].stats.len() {
                if seen[si].stats[j].name == *name {
                    k = j;
                }
            }
            if k < 0 {
                seen[si].stats.push(Stat { name: name.clone(), count: 0, lo: None, hi: None, last: v.clone(), names: Vec.new() });
                k = seen[si].stats.len() - 1;
            }
            stat_add(mut seen[si].stats[k], v);
            if name == "Gear" or name == "PackState" or name == "FaultCode" or name == "ChargeState" {
                let text_v = val_str(v);
                let mut found = false;
                for e in prev_named.iter_mut() {
                    if e.0 == *name {
                        if e.1 != text_v {
                            transitions.push(f"{rel(ts, t0)} {name} {e.1} -> {text_v}");
                        }
                        e.1 = text_v.clone();
                        found = true;
                    }
                }
                if not found {
                    prev_named.push((name.clone(), text_v));
                }
            }
        }
        match encode(m, decoded, true, false, true) {
            Ok(again) => {
                if hex_of(again) != hex_of(data) {
                    mismatches.push(f"{rel(ts, t0)} {m.name} [{hex_of(data)}] re-encodes as [{hex_of(again)}]");
                }
            },
            Err(e) => {
                let key = f"{m.name}: {show_fail(e)}";
                let mut found = false;
                for x in encode_errors.iter_mut() {
                    if x.0 == key {
                        x.1 += 1;
                        found = true;
                    }
                }
                if not found {
                    encode_errors.push((key, 1, rel(ts, t0)));
                }
            },
        }
        if m.name == "VCU_Status" {
            let mut sum = 0;
            for i in 0..7 {
                sum += data[i];
            }
            let want = (sum ^ 255) & 255;
            let got = val_i(dget(decoded, "Checksum".to_string()).unwrap());
            if got != want {
                checksum_bad.push(f"{rel(ts, t0)} checksum 0x{got:02x}, bytes say 0x{want:02x}");
            }
            let c = val_i(dget(decoded, "Counter".to_string()).unwrap());
            if prev_counter >= 0 and c != (prev_counter + 1) % 16 {
                counter_gaps.push(f"{rel(ts, t0)} counter {prev_counter} -> {c}");
            }
            prev_counter = c;
            let sp = val_f(dget(decoded, "VehicleSpeed".to_string()).unwrap());
            if let Some((pt, pv)) = prev_speed {
                dist_km += pv * (((ts - pt) as f64) / 3600000000.0);
            }
            prev_speed = Some((ts, sp));
        } else if m.name == "BMS_Pack" {
            let p = val_f(dget(decoded, "PackVoltage".to_string()).unwrap()) * val_f(dget(decoded, "PackCurrent".to_string()).unwrap());
            if let Some((pt, pp)) = prev_pack {
                energy_wh += pp * (((ts - pt) as f64) / 3600000000.0);
            }
            prev_pack = Some((ts, p));
            if p / 1000.0 > peak_kw {
                peak_kw = p / 1000.0;
            }
            if p / 1000.0 < regen_kw {
                regen_kw = p / 1000.0;
            }
        } else if m.name == "BMS_Cells" {
            for (name, v) in decoded.iter() {
                if name.starts_with("CellVolt") {
                    let cell = from_chars(chars_of(name), 8, name.len());
                    let x = val_i(v);
                    let lower = match cell_lo {
                        Some((lo, _, _)) => x < lo,
                        None => true,
                    };
                    if lower {
                        cell_lo = Some((x, cell.clone(), rel(ts, t0)));
                    }
                    let higher = match cell_hi {
                        Some((hi, _, _)) => x > hi,
                        None => true,
                    };
                    if higher {
                        cell_hi = Some((x, cell.clone(), rel(ts, t0)));
                    }
                }
            }
        } else if m.name == "MCU_Motor" {
            if val_i(dget(decoded, "DeratePct".to_string()).unwrap()) > 0 {
                derate_frames += 1;
            }
        }
    }

    println(f"{lines.len()} lines, {total} frames from {secs(t0)}, {bad_lines.len()} unreadable lines: {ints_repr(bad_lines)}");
    unknown.sort();
    for (ident, n) in unknown.iter() {
        println(f"unknown id {ident}: {n} frames");
    }
    for m in db.messages.iter() {
        let mut si = -1;
        for k in 0..seen.len() {
            if seen[k].name == m.name {
                si = k;
            }
        }
        if si < 0 {
            println(f"{m.name}: no frames");
            continue;
        }
        let s = seen[si].clone();
        let period = if s.count > 1 { (s.last - s.first) / (s.count - 1) } else { 0 };
        println(f"{m.name}: {s.count} frames, mean period {ms3(period)} ms (cycle {opt_int_str(m.cycle)}), longest gap {ms3(s.gap)} ms before {rel(s.gap_at, t0)}");
        for st in s.stats.iter() {
            let mut parts: Vec[String] = Vec.new();
            if st.count > 0 {
                parts.push(f"{st.count} values in [{opt_val_str(st.lo)}, {opt_val_str(st.hi)}]");
            }
            if st.names.len() > 0 {
                let mut items: Vec[String] = Vec.new();
                for (k, v) in st.names.iter() {
                    items.push(f"{k} x{v}");
                }
                parts.push(join(items, ", "));
            }
            println(f"  {st.name}: {join(parts, "; ")}; last {val_repr(st.last)}");
        }
    }
    println(f"decode errors: {decode_errors.len()}");
    for e in decode_errors.iter() {
        println(f"  {e}");
    }
    let mut n_enc = 0;
    for (_, n, _) in encode_errors.iter() {
        n_enc += n;
    }
    println(f"re-encode errors: {n_enc}");
    for (e, n, first) in encode_errors.iter() {
        println(f"  x{n} from {first} {e}");
    }
    println(f"re-encode mismatches: {mismatches.len()}");
    for e in mismatches.iter() {
        println(f"  {e}");
    }
    println(f"checksum failures: {checksum_bad.len()}");
    for e in checksum_bad.iter() {
        println(f"  {e}");
    }
    println(f"counter gaps: {counter_gaps.len()}");
    for e in counter_gaps.iter() {
        println(f"  {e}");
    }
    println(f"state changes: {transitions.len()}");
    for e in transitions.iter() {
        println(f"  {e}");
    }
    println(f"distance {dist_km:.4} km, pack energy {energy_wh:.3} Wh, peak {peak_kw:.2} kW, regen {regen_kw:.2} kW, derated in {derate_frames} motor frames");
    if let (Some((lv, lc, lt)), Some((hv, hc, ht))) = (cell_lo, cell_hi) {
        println(f"lowest cell {lc} {lv} mV at {lt}, highest cell {hc} {hv} mV at {ht}, spread {hv - lv} mV");
    }
    for s in seen.iter() {
        if s.name == "DASH_Odometer" {
            for st in s.stats.iter() {
                if st.name == "Odometer" {
                    let lo = val_f(st.lo.clone().unwrap());
                    let hi = val_f(st.hi.clone().unwrap());
                    let d = hi - lo;
                    println(f"odometer {opt_val_str(st.lo)} -> {opt_val_str(st.hi)} km, {d:.1} km on the dash");
                }
            }
        }
    }
}

fn read_back(path: Str, text: ref String) -> Result[String, String] {
    if let Err(e) = fs.write(path.to_string(), text.clone()) {
        return Err(f"cannot write {path}: {e}");
    }
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn run() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    println("== vehicle.dbc");
    let dbc = read_back("data/vehicle.dbc", vehicle_dbc())?;
    let db = match load_string(dbc, true) {
        Ok(db) => db,
        Err(e) => return Err(show_fail(e)),
    };
    summary(db);

    println("== broken files");
    for (name, text) in broken_files().iter() {
        let path = f"data/{name}";
        let back = read_back(path.as_str(), text)?;
        match load_string(back, true) {
            Ok(bad) => println(f"{name}: {bad.messages.len()} messages"),
            Err(e) => {
                println(f"{name}: {show_fail(e)}");
                match load_string(back, false) {
                    Ok(loose) => {
                        let m = loose.messages[0].clone();
                        println(f"  not strict: {m.name} {tree_repr(m, m.codec)}");
                    },
                    Err(e2) => println(f"  not strict: {show_fail(e2)}"),
                }
            },
        }
        let _ = fs.remove_file(path);
    }

    println("== jobs");
    let jobs = read_back("data/jobs.txt", jobs_text())?;
    for line in jobs.split("\n") {
        if line.len() > 0 {
            println(f"> {line}");
            println(f"  {run_job(db, line.to_string())}");
        }
    }

    println("== drive.log");
    let log = read_back("data/drive.log", drive_log())?;
    analyse(db, log);
    for p in ["data/vehicle.dbc", "data/jobs.txt", "data/drive.log"] {
        let _ = fs.remove_file(p.to_string());
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(f"error: {e}");
    }
}

