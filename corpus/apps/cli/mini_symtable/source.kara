// mini_symtable: a port of CPython 3.13's symbol table (Python/symtable.c)
// with the `symtable` module's view of it (Lib/symtable.py), over a
// tokenizer and recursive-descent parser for the Python 3.13 grammar.
// The jobs in data/jobs.txt print each table and its symbols, the
// `python -m symtable` listing, a pyflakes-style lint built on the
// tables, and the SyntaxErrors the symbol table raises.

// ------------------------------------------------------------ tokens

#[derive(Copy, Clone, PartialEq, Eq)]
enum Tk {
    Name,
    Number,
    Str,
    Op,
    Newline,
    Indent,
    Dedent,
    End,
}

#[derive(Copy, Clone)]
struct Pos {
    line: i64,
    col: i64,
    eline: i64,
    ecol: i64,
}

#[derive(Clone)]
struct Tok {
    kind: Tk,
    text: String,
    pos: Pos,
}

fn span(a: Pos, b: Pos) -> Pos {
    Pos { line: a.line, col: a.col, eline: b.eline, ecol: b.ecol }
}

fn is_dig(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_id_start(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or c == b'_' or c >= 128
}

fn is_id_char(c: u8) -> bool {
    is_id_start(c) or is_dig(c)
}

struct Lx {
    b: Vec[u8],
    pos: i64,
    line: i64,
    line_start: i64,
    depth: i64,
    indents: Vec[i64],
    toks: Vec[Tok],
}

fn lx_at(lx: ref Lx, k: i64) -> u8 {
    let i = lx.pos + k;
    if i < lx.b.len() { lx.b[i] } else { 0 }
}

fn lx_col(lx: ref Lx) -> i64 {
    lx.pos - lx.line_start
}

fn lx_text(lx: ref Lx, a: i64, b: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    for i in a..b {
        out.push(lx.b[i]);
    }
    String.from_utf8(out).unwrap_or(String.new())
}

fn lx_push(lx: mut ref Lx, kind: Tk, text: own String, line: i64, col: i64) {
    let p = Pos { line: line, col: col, eline: lx.line, ecol: lx_col(lx) };
    lx.toks.push(Tok { kind: kind, text: text, pos: p });
}

// A newline inside a string or a continuation: the next line starts here.
fn lx_newline(lx: mut ref Lx) {
    lx.line += 1;
    lx.line_start = lx.pos;
}

fn ops3() -> Vec[String] {
    ["**=", "//=", ">>=", "<<=", "..."].to_vec()
}

fn ops2() -> Vec[String] {
    ["**", "//", ">>", "<<", "<=", ">=", "==", "!=", "->", ":=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "@="].to_vec()
}

fn lx_op(lx: ref Lx) -> i64 {
    let end = if lx.pos + 3 <= lx.b.len() { lx.pos + 3 } else { lx.b.len() };
    let rest = lx_text(lx, lx.pos, end);
    for o in ops3().iter() {
        if rest.starts_with(*o) {
            return 3;
        }
    }
    for o in ops2().iter() {
        if rest.starts_with(*o) {
            return 2;
        }
    }
    match lx_at(lx, 0) {
        b'+' | b'-' | b'*' | b'/' | b'%' | b'@' | b'&' | b'|' | b'^' | b'~' | b'<' | b'>' => 1,
        b'(' | b')' | b'[' | b']' | b'{' | b'}' | b',' | b':' | b';' | b'.' | b'=' | b'!' => 1,
        _ => 0,
    }
}

// The body of a string after its opening quote, up to and including the
// closing one. In an f-string a quote inside a replacement field belongs
// to a nested string.
fn lx_string_body(lx: mut ref Lx, q: u8, triple: bool, fstr: bool) -> Result[(), String] {
    let mut braces: i64 = 0;
    loop {
        let c = lx_at(lx, 0);
        if c == 0 {
            return Err(f"unterminated string at line {lx.line}");
        }
        if c == b'\\' {
            lx.pos += 1;
            if lx_at(lx, 0) == b'\n' {
                lx.pos += 1;
                lx_newline(mut lx);
            } else {
                lx.pos += 1;
            }
            continue;
        }
        if c == b'\n' {
            if not triple and braces == 0 {
                return Err(f"unterminated string at line {lx.line}");
            }
            lx.pos += 1;
            lx_newline(mut lx);
            continue;
        }
        if fstr and c == b'{' {
            if braces == 0 and lx_at(lx, 1) == b'{' {
                lx.pos += 2;
                continue;
            }
            braces += 1;
            lx.pos += 1;
            continue;
        }
        if fstr and c == b'}' {
            if braces == 0 {
                lx.pos += if lx_at(lx, 1) == b'}' { 2 } else { 1 };
                continue;
            }
            braces -= 1;
            lx.pos += 1;
            continue;
        }
        if braces > 0 and (c == b'\'' or c == b'"') {
            let t2 = lx_at(lx, 1) == c and lx_at(lx, 2) == c;
            lx.pos += if t2 { 3 } else { 1 };
            lx_string_body(mut lx, c, t2, false)?;
            continue;
        }
        if c == q {
            if not triple {
                lx.pos += 1;
                return Ok(());
            }
            if lx_at(lx, 1) == q and lx_at(lx, 2) == q {
                lx.pos += 3;
                return Ok(());
            }
        }
        lx.pos += 1;
    }
}

fn is_prefix(s: Str) -> bool {
    let l = s.to_lowercase();
    match l.as_str() {
        "r" | "u" | "b" | "f" | "br" | "rb" | "fr" | "rf" => true,
        _ => false,
    }
}

// Indentation of the line starting at lx.pos, or -1 for a blank or
// comment-only line (which the tokenizer skips).
fn lx_indent(lx: mut ref Lx) -> i64 {
    let mut col: i64 = 0;
    loop {
        let c = lx_at(lx, 0);
        if c == b' ' {
            col += 1;
        } else if c == b'\t' {
            col = (col / 8 + 1) * 8;
        } else if c == b'\x0c' {
            col = 0;
        } else {
            break;
        }
        lx.pos += 1;
    }
    let c = lx_at(lx, 0);
    if c == b'#' or c == b'\n' or c == b'\r' or c == 0 {
        return -1;
    }
    col
}

fn tokenize(src: Str) -> Result[Vec[Tok], String] {
    let mut lx = Lx { b: src.bytes().to_vec(), pos: 0, line: 1, line_start: 0, depth: 0, indents: vec![0], toks: Vec.new() };
    let mut at_bol = true;
    loop {
        if at_bol and lx.depth == 0 {
            let start = lx.pos;
            let ind = lx_indent(mut lx);
            if ind < 0 {
                // Skip the rest of a blank or comment line.
                while lx_at(lx, 0) != b'\n' and lx_at(lx, 0) != 0 {
                    lx.pos += 1;
                }
                if lx_at(lx, 0) == 0 {
                    break;
                }
                lx.pos += 1;
                lx_newline(mut lx);
                continue;
            }
            let top = lx.indents[lx.indents.len() - 1];
            if ind > top {
                lx.indents.push(ind);
                let p = Pos { line: lx.line, col: 0, eline: lx.line, ecol: lx_col(lx) };
                lx.toks.push(Tok { kind: Tk.Indent, text: String.new(), pos: p });
            } else {
                while ind < lx.indents[lx.indents.len() - 1] {
                    lx.indents.pop();
                    let p = Pos { line: lx.line, col: lx_col(lx), eline: lx.line, ecol: lx_col(lx) };
                    lx.toks.push(Tok { kind: Tk.Dedent, text: String.new(), pos: p });
                }
                if ind != lx.indents[lx.indents.len() - 1] {
                    return Err(f"unindent does not match any outer indentation level at line {lx.line}");
                }
            }
            let _ = start;
            at_bol = false;
        }
        let c = lx_at(lx, 0);
        if c == 0 {
            break;
        }
        if c == b' ' or c == b'\t' or c == b'\x0c' or c == b'\r' {
            lx.pos += 1;
            continue;
        }
        if c == b'#' {
            while lx_at(lx, 0) != b'\n' and lx_at(lx, 0) != 0 {
                lx.pos += 1;
            }
            continue;
        }
        if c == b'\\' and lx_at(lx, 1) == b'\n' {
            lx.pos += 2;
            lx_newline(mut lx);
            continue;
        }
        if c == b'\n' {
            if lx.depth == 0 {
                let line = lx.line;
                let col = lx_col(lx);
                lx.pos += 1;
                let p = Pos { line: line, col: col, eline: line, ecol: col + 1 };
                lx.toks.push(Tok { kind: Tk.Newline, text: String.new(), pos: p });
                lx_newline(mut lx);
                at_bol = true;
            } else {
                lx.pos += 1;
                lx_newline(mut lx);
            }
            continue;
        }
        let line = lx.line;
        let col = lx_col(lx);
        let start = lx.pos;
        if is_id_start(c) {
            while is_id_char(lx_at(lx, 0)) {
                lx.pos += 1;
            }
            let word = lx_text(lx, start, lx.pos);
            let q = lx_at(lx, 0);
            if (q == b'\'' or q == b'"') and is_prefix(word) {
                let triple = lx_at(lx, 1) == q and lx_at(lx, 2) == q;
                lx.pos += if triple { 3 } else { 1 };
                let fstr = word.to_lowercase().contains("f");
                lx_string_body(mut lx, q, triple, fstr)?;
                let t = lx_text(lx, start, lx.pos);
                lx_push(mut lx, Tk.Str, t, line, col);
            } else {
                lx_push(mut lx, Tk.Name, word, line, col);
            }
            continue;
        }
        if is_dig(c) or (c == b'.' and is_dig(lx_at(lx, 1))) {
            let hex = c == b'0' and (lx_at(lx, 1) == b'x' or lx_at(lx, 1) == b'X');
            loop {
                let d = lx_at(lx, 0);
                if is_id_char(d) or d == b'.' {
                    lx.pos += 1;
                    if not hex and (d == b'e' or d == b'E') and (lx_at(lx, 0) == b'+' or lx_at(lx, 0) == b'-') {
                        lx.pos += 1;
                    }
                } else {
                    break;
                }
            }
            let t = lx_text(lx, start, lx.pos);
            lx_push(mut lx, Tk.Number, t, line, col);
            continue;
        }
        if c == b'\'' or c == b'"' {
            let triple = lx_at(lx, 1) == c and lx_at(lx, 2) == c;
            lx.pos += if triple { 3 } else { 1 };
            lx_string_body(mut lx, c, triple, false)?;
            let t = lx_text(lx, start, lx.pos);
            lx_push(mut lx, Tk.Str, t, line, col);
            continue;
        }
        let n = lx_op(lx);
        if n == 0 {
            return Err(f"invalid character at {line}:{col + 1}");
        }
        lx.pos += n;
        let t = lx_text(lx, start, lx.pos);
        if t == "(" or t == "[" or t == "{" {
            lx.depth += 1;
        } else if t == ")" or t == "]" or t == "}" {
            lx.depth -= 1;
        }
        lx_push(mut lx, Tk.Op, t, line, col);
    }
    let n = lx.toks.len();
    if n > 0 and lx.toks[n - 1].kind != Tk.Newline and lx.toks[n - 1].kind != Tk.Dedent {
        let p = Pos { line: lx.line, col: lx_col(lx), eline: lx.line, ecol: lx_col(lx) + 1 };
        lx.toks.push(Tok { kind: Tk.Newline, text: String.new(), pos: p });
    }
    while lx.indents.len() > 1 {
        lx.indents.pop();
        let p = Pos { line: lx.line, col: 0, eline: lx.line, ecol: 0 };
        lx.toks.push(Tok { kind: Tk.Dedent, text: String.new(), pos: p });
    }
    let p = Pos { line: lx.line, col: 0, eline: lx.line, ecol: 0 };
    lx.toks.push(Tok { kind: Tk.End, text: String.new(), pos: p });
    Ok(lx.toks)
}

// ------------------------------------------------------------ ast
//
// Only what the symbol table visits. An expression the visitor treats as
// "its children, left to right" (BinOp, BoolOp, Compare, UnaryOp, Tuple,
// List, Set, Starred, Attribute, Subscript, Slice, JoinedStr, constants)
// is a Group whose kind names it; the rest keep CPython's field order,
// which is the order symtable.c visits them in.

shared enum Expr {
    Name { id: String, store: bool, pos: Pos },
    Named { target: Expr, value: Expr, pos: Pos },
    Group { kind: String, items: Vec[Expr], pos: Pos },
    Dict { keys: Vec[Option[Expr]], values: Vec[Expr], pos: Pos },
    IfExp { test: Expr, body: Expr, orelse: Expr, pos: Pos },
    Lambda { args: Params, body: Expr, pos: Pos },
    Comp { kind: String, elt: Expr, value: Option[Expr], gens: Vec[Gen], pos: Pos },
    Call { func: Expr, args: Vec[Expr], keywords: Vec[Expr], pos: Pos },
    Yield { value: Option[Expr], from: bool, pos: Pos },
    Await { value: Expr, pos: Pos },
}

#[derive(Clone)]
struct Param {
    name: String,
    ann: Option[Expr],
    pos: Pos,
}

#[derive(Clone)]
struct Params {
    posonly: Vec[Param],
    args: Vec[Param],
    vararg: Option[Param],
    kwonly: Vec[Param],
    kw_defaults: Vec[Option[Expr]],
    kwarg: Option[Param],
    defaults: Vec[Expr],
}

#[derive(Clone)]
struct Gen {
    target: Expr,
    iter: Expr,
    ifs: Vec[Expr],
    is_async: bool,
}

// TypeVar (kind 0), TypeVarTuple (1) or ParamSpec (2).
#[derive(Clone)]
struct TParam {
    kind: i64,
    name: String,
    bound: Option[Expr],
    default: Option[Expr],
    pos: Pos,
}

#[derive(Clone)]
struct Alias {
    name: String,
    asname: Option[String],
    pos: Pos,
}

shared enum Pat {
    Value { value: Expr, pos: Pos },
    Singleton { pos: Pos },
    Sequence { pats: Vec[Pat], pos: Pos },
    Star { name: Option[String], pos: Pos },
    Mapping { keys: Vec[Expr], pats: Vec[Pat], rest: Option[String], pos: Pos },
    Class { cls: Expr, pats: Vec[Pat], kwd_pats: Vec[Pat], pos: Pos },
    As { pat: Option[Pat], name: Option[String], pos: Pos },
    Or { pats: Vec[Pat], pos: Pos },
}

shared enum Stmt {
    FuncDef { name: String, args: Params, body: Vec[Stmt], decorators: Vec[Expr], returns: Option[Expr], tparams: Vec[TParam], is_async: bool, pos: Pos },
    ClassDef { name: String, bases: Vec[Expr], keywords: Vec[Expr], body: Vec[Stmt], decorators: Vec[Expr], tparams: Vec[TParam], pos: Pos },
    TypeAlias { name: Expr, tparams: Vec[TParam], value: Expr, pos: Pos },
    Return { value: Option[Expr], pos: Pos },
    Delete { targets: Vec[Expr], pos: Pos },
    Assign { targets: Vec[Expr], value: Expr, pos: Pos },
    AugAssign { target: Expr, value: Expr, pos: Pos },
    AnnAssign { target: Expr, ann: Expr, value: Option[Expr], simple: bool, pos: Pos },
    For { target: Expr, iter: Expr, body: Vec[Stmt], orelse: Vec[Stmt], is_async: bool, pos: Pos },
    While { test: Expr, body: Vec[Stmt], orelse: Vec[Stmt], pos: Pos },
    If { test: Expr, body: Vec[Stmt], orelse: Vec[Stmt], pos: Pos },
    With { items: Vec[(Expr, Option[Expr])], body: Vec[Stmt], pos: Pos },
    // B-2026-11-01-6: a struct variant named `Match` (like std.regex's
    // struct) is refused by the MIR builder; revert to `Match` when the row
    // is fixed.
    MatchStmt { subject: Expr, cases: Vec[Case], pos: Pos },
    Raise { exc: Option[Expr], cause: Option[Expr], pos: Pos },
    Try { body: Vec[Stmt], handlers: Vec[Handler], orelse: Vec[Stmt], finalbody: Vec[Stmt], pos: Pos },
    Assert { test: Expr, msg: Option[Expr], pos: Pos },
    Import { module: Option[String], names: Vec[Alias], pos: Pos },
    Global { names: Vec[String], pos: Pos },
    Nonlocal { names: Vec[String], pos: Pos },
    ExprStmt { value: Expr, pos: Pos },
    Simple { pos: Pos },
}

#[derive(Clone)]
struct Case {
    pattern: Pat,
    guard: Option[Expr],
    body: Vec[Stmt],
}

#[derive(Clone)]
struct Handler {
    ty: Option[Expr],
    name: Option[String],
    body: Vec[Stmt],
    pos: Pos,
}

fn expr_pos(e: ref Expr) -> Pos {
    match e {
        Expr.Name { pos, .. } => pos,
        Expr.Named { pos, .. } => pos,
        Expr.Group { pos, .. } => pos,
        Expr.Dict { pos, .. } => pos,
        Expr.IfExp { pos, .. } => pos,
        Expr.Lambda { pos, .. } => pos,
        Expr.Comp { pos, .. } => pos,
        Expr.Call { pos, .. } => pos,
        Expr.Yield { pos, .. } => pos,
        Expr.Await { pos, .. } => pos,
    }
}

fn group(kind: Str, items: own Vec[Expr], pos: Pos) -> Expr {
    Expr.Group { kind: kind.to_string(), items: items, pos: pos }
}

fn is_group(e: ref Expr, kind: Str) -> bool {
    match e {
        Expr.Group { kind: k, .. } => k == kind,
        _ => false,
    }
}

// The expression as an assignment target: names become Store, and a
// tuple, list or starred target passes that on to its elements.
// Attribute and subscript targets keep their parts as loads.
fn to_store(e: ref Expr) -> Expr {
    match e {
        Expr.Name { id, pos, .. } => Expr.Name { id: id.clone(), store: true, pos: pos },
        Expr.Group { kind, items, pos } => {
            if kind == "tuple" or kind == "list" or kind == "starred" {
                let mut out: Vec[Expr] = Vec.new();
                for it in items.iter() {
                    out.push(to_store(it));
                }
                Expr.Group { kind: kind.clone(), items: out, pos: pos }
            } else {
                e.clone()
            }
        }
        _ => e.clone(),
    }
}

// ------------------------------------------------------------ parser
//
// Recursive descent over the token list, after the PEG grammar of
// Python 3.13 (Grammar/python.gram), for programs that parse. Each node
// gets the location CPython's parser gives it, since the symbol table's
// errors and its tables' line numbers come from those.

struct Ps {
    toks: Vec[Tok],
    i: i64,
}

fn hard_keyword(s: Str) -> bool {
    match s {
        "False" | "None" | "True" | "and" | "as" | "assert" | "async" | "await" | "break" => true,
        "class" | "continue" | "def" | "del" | "elif" | "else" | "except" | "finally" | "for" => true,
        "from" | "global" | "if" | "import" | "in" | "is" | "lambda" | "nonlocal" | "not" => true,
        "or" | "pass" | "raise" | "return" | "try" | "while" | "with" | "yield" => true,
        _ => false,
    }
}

fn tk(p: ref Ps, k: i64) -> Tk {
    let i = p.i + k;
    if i < p.toks.len() { p.toks[i].kind } else { Tk.End }
}

fn tx(p: ref Ps, k: i64) -> String {
    let i = p.i + k;
    if i < p.toks.len() { p.toks[i].text.clone() } else { String.new() }
}

fn tpos(p: ref Ps, k: i64) -> Pos {
    let i = p.i + k;
    if i < p.toks.len() { p.toks[i].pos } else { p.toks[p.toks.len() - 1].pos }
}

// The end of the last token taken.
fn last_pos(p: ref Ps) -> Pos {
    p.toks[p.i - 1].pos
}

fn is_op(p: ref Ps, k: i64, s: Str) -> bool {
    tk(p, k) == Tk.Op and tx(p, k) == s
}

fn is_kw(p: ref Ps, k: i64, s: Str) -> bool {
    tk(p, k) == Tk.Name and tx(p, k) == s
}

fn is_ident(p: ref Ps, k: i64) -> bool {
    tk(p, k) == Tk.Name and not hard_keyword(tx(p, k))
}

fn perr(p: ref Ps, what: Str) -> String {
    let t = tpos(p, 0);
    f"parse error at {t.line}:{t.col + 1}: {what} (found '{tx(p, 0)}')"
}

fn expect_op(p: mut ref Ps, s: Str) -> Result[Pos, String] {
    if not is_op(p, 0, s) {
        return Err(perr(p, f"expected '{s}'"));
    }
    p.i += 1;
    Ok(last_pos(p))
}

fn expect_kw(p: mut ref Ps, s: Str) -> Result[Pos, String] {
    if not is_kw(p, 0, s) {
        return Err(perr(p, f"expected '{s}'"));
    }
    p.i += 1;
    Ok(last_pos(p))
}

fn accept_op(p: mut ref Ps, s: Str) -> bool {
    if is_op(p, 0, s) {
        p.i += 1;
        true
    } else {
        false
    }
}

fn ident(p: mut ref Ps) -> Result[(String, Pos), String] {
    if not is_ident(p, 0) {
        return Err(perr(p, "expected a name"));
    }
    p.i += 1;
    Ok((tx(p, -1), last_pos(p)))
}

// Can the current token start an expression?
fn starts_expr(p: ref Ps) -> bool {
    match tk(p, 0) {
        Tk.Name => {
            let t = tx(p, 0);
            not hard_keyword(t) or t == "None" or t == "True" or t == "False" or t == "not" or t == "lambda" or t == "await" or t == "yield"
        }
        Tk.Number | Tk.Str => true,
        Tk.Op => {
            let t = tx(p, 0);
            t == "(" or t == "[" or t == "{" or t == "-" or t == "+" or t == "~" or t == "..." or t == "*"
        }
        _ => false,
    }
}

// ---------------------------------------------- expressions

fn star_expressions(p: mut ref Ps) -> Result[Expr, String] {
    let first = star_expression(mut p)?;
    if not is_op(p, 0, ",") {
        return Ok(first);
    }
    let start = expr_pos(first);
    let mut items = vec![first];
    while accept_op(mut p, ",") {
        if not starts_expr(p) {
            break;
        }
        items.push(star_expression(mut p)?);
    }
    Ok(group("tuple", items, span(start, last_pos(p))))
}

fn star_expression(p: mut ref Ps) -> Result[Expr, String] {
    if is_op(p, 0, "*") {
        let start = tpos(p, 0);
        p.i += 1;
        let v = bitwise_or(mut p)?;
        return Ok(group("starred", vec![v], span(start, last_pos(p))));
    }
    expression(mut p)
}

fn star_named_expression(p: mut ref Ps) -> Result[Expr, String] {
    if is_op(p, 0, "*") {
        let start = tpos(p, 0);
        p.i += 1;
        let v = bitwise_or(mut p)?;
        return Ok(group("starred", vec![v], span(start, last_pos(p))));
    }
    named_expression(mut p)
}

fn named_expression(p: mut ref Ps) -> Result[Expr, String] {
    if is_ident(p, 0) and is_op(p, 1, ":=") {
        let (id, npos) = ident(mut p)?;
        p.i += 1;
        let value = expression(mut p)?;
        let target = Expr.Name { id: id, store: true, pos: npos };
        return Ok(Expr.Named { target: target, value: value, pos: span(npos, last_pos(p)) });
    }
    expression(mut p)
}

fn expression(p: mut ref Ps) -> Result[Expr, String] {
    if is_kw(p, 0, "lambda") {
        return lambdef(mut p);
    }
    let body = disjunction(mut p)?;
    if is_kw(p, 0, "if") {
        p.i += 1;
        let test = disjunction(mut p)?;
        expect_kw(mut p, "else")?;
        let orelse = expression(mut p)?;
        let pos = span(expr_pos(body), last_pos(p));
        return Ok(Expr.IfExp { test: test, body: body, orelse: orelse, pos: pos });
    }
    Ok(body)
}

fn lambdef(p: mut ref Ps) -> Result[Expr, String] {
    let start = tpos(p, 0);
    p.i += 1;
    let args = parameters(mut p, false, ":")?;
    expect_op(mut p, ":")?;
    let body = expression(mut p)?;
    Ok(Expr.Lambda { args: args, body: body, pos: span(start, last_pos(p)) })
}

fn disjunction(p: mut ref Ps) -> Result[Expr, String] {
    let first = conjunction(mut p)?;
    if not is_kw(p, 0, "or") {
        return Ok(first);
    }
    let start = expr_pos(first);
    let mut items = vec![first];
    while is_kw(p, 0, "or") {
        p.i += 1;
        items.push(conjunction(mut p)?);
    }
    Ok(group("boolop", items, span(start, last_pos(p))))
}

fn conjunction(p: mut ref Ps) -> Result[Expr, String] {
    let first = inversion(mut p)?;
    if not is_kw(p, 0, "and") {
        return Ok(first);
    }
    let start = expr_pos(first);
    let mut items = vec![first];
    while is_kw(p, 0, "and") {
        p.i += 1;
        items.push(inversion(mut p)?);
    }
    Ok(group("boolop", items, span(start, last_pos(p))))
}

fn inversion(p: mut ref Ps) -> Result[Expr, String] {
    if is_kw(p, 0, "not") {
        let start = tpos(p, 0);
        p.i += 1;
        let v = inversion(mut p)?;
        return Ok(group("unary", vec![v], span(start, last_pos(p))));
    }
    comparison(mut p)
}

// The length of a comparison operator here, in tokens, or 0.
fn comp_op(p: ref Ps) -> i64 {
    if tk(p, 0) == Tk.Op {
        let t = tx(p, 0);
        if t == "<" or t == ">" or t == "==" or t == ">=" or t == "<=" or t == "!=" {
            return 1;
        }
        return 0;
    }
    if is_kw(p, 0, "in") {
        return 1;
    }
    if is_kw(p, 0, "not") and is_kw(p, 1, "in") {
        return 2;
    }
    if is_kw(p, 0, "is") {
        return if is_kw(p, 1, "not") { 2 } else { 1 };
    }
    0
}

fn comparison(p: mut ref Ps) -> Result[Expr, String] {
    let first = bitwise_or(mut p)?;
    if comp_op(p) == 0 {
        return Ok(first);
    }
    let start = expr_pos(first);
    let mut items = vec![first];
    loop {
        let n = comp_op(p);
        if n == 0 {
            break;
        }
        p.i += n;
        items.push(bitwise_or(mut p)?);
    }
    Ok(group("compare", items, span(start, last_pos(p))))
}

fn bin_level(t: Str) -> i64 {
    match t {
        "|" => 1,
        "^" => 2,
        "&" => 3,
        "<<" | ">>" => 4,
        "+" | "-" => 5,
        "*" | "/" | "//" | "%" | "@" => 6,
        _ => 0,
    }
}

fn bitwise_or(p: mut ref Ps) -> Result[Expr, String] {
    binary(mut p, 1)
}

fn binary(p: mut ref Ps, level: i64) -> Result[Expr, String] {
    if level > 6 {
        return factor(mut p);
    }
    let mut left = binary(mut p, level + 1)?;
    while tk(p, 0) == Tk.Op and bin_level(tx(p, 0)) == level {
        p.i += 1;
        let right = binary(mut p, level + 1)?;
        let pos = span(expr_pos(left), last_pos(p));
        left = group("binop", vec![left, right], pos);
    }
    Ok(left)
}

fn factor(p: mut ref Ps) -> Result[Expr, String] {
    if is_op(p, 0, "+") or is_op(p, 0, "-") or is_op(p, 0, "~") {
        let start = tpos(p, 0);
        p.i += 1;
        let v = factor(mut p)?;
        return Ok(group("unary", vec![v], span(start, last_pos(p))));
    }
    power(mut p)
}

fn power(p: mut ref Ps) -> Result[Expr, String] {
    let base = await_primary(mut p)?;
    if is_op(p, 0, "**") {
        p.i += 1;
        let exp = factor(mut p)?;
        let pos = span(expr_pos(base), last_pos(p));
        return Ok(group("binop", vec![base, exp], pos));
    }
    Ok(base)
}

fn await_primary(p: mut ref Ps) -> Result[Expr, String] {
    if is_kw(p, 0, "await") {
        let start = tpos(p, 0);
        p.i += 1;
        let v = primary(mut p)?;
        return Ok(Expr.Await { value: v, pos: span(start, last_pos(p)) });
    }
    primary(mut p)
}

fn primary(p: mut ref Ps) -> Result[Expr, String] {
    let mut e = atom(mut p)?;
    loop {
        if is_op(p, 0, ".") {
            p.i += 1;
            ident(mut p)?;
            let pos = span(expr_pos(e), last_pos(p));
            e = group("attr", vec![e], pos);
        } else if is_op(p, 0, "(") {
            e = call(mut p, e)?;
        } else if is_op(p, 0, "[") {
            p.i += 1;
            let s = slices(mut p)?;
            expect_op(mut p, "]")?;
            let pos = span(expr_pos(e), last_pos(p));
            e = group("subscript", vec![e, s], pos);
        } else {
            break;
        }
    }
    Ok(e)
}

fn slices(p: mut ref Ps) -> Result[Expr, String] {
    let first = slice(mut p)?;
    if not is_op(p, 0, ",") {
        return Ok(first);
    }
    let start = expr_pos(first);
    let mut items = vec![first];
    while accept_op(mut p, ",") {
        if is_op(p, 0, "]") {
            break;
        }
        items.push(slice(mut p)?);
    }
    Ok(group("tuple", items, span(start, last_pos(p))))
}

fn slice(p: mut ref Ps) -> Result[Expr, String] {
    let start = tpos(p, 0);
    let mut parts: Vec[Expr] = Vec.new();
    if not is_op(p, 0, ":") {
        let e = star_named_expression(mut p)?;
        if not is_op(p, 0, ":") {
            return Ok(e);
        }
        parts.push(e);
    }
    // lower ':' [upper] [':' [step]]
    p.i += 1;
    if not is_op(p, 0, ":") and not is_op(p, 0, ",") and not is_op(p, 0, "]") {
        parts.push(expression(mut p)?);
    }
    if accept_op(mut p, ":") {
        if not is_op(p, 0, ",") and not is_op(p, 0, "]") {
            parts.push(expression(mut p)?);
        }
    }
    Ok(group("slice", parts, span(start, last_pos(p))))
}

// A call's arguments: positional (starred ones too) in `args`, keyword
// and `**` values in `keywords`. A generator expression as the only
// argument takes the call's parentheses.
fn call_args(p: mut ref Ps) -> Result[(Vec[Expr], Vec[Expr]), String] {
    let open = expect_op(mut p, "(")?;
    let mut args: Vec[Expr] = Vec.new();
    let mut kws: Vec[Expr] = Vec.new();
    while not is_op(p, 0, ")") {
        if is_op(p, 0, "**") {
            p.i += 1;
            kws.push(expression(mut p)?);
        } else if is_op(p, 0, "*") {
            let start = tpos(p, 0);
            p.i += 1;
            let v = expression(mut p)?;
            args.push(group("starred", vec![v], span(start, last_pos(p))));
        } else if is_ident(p, 0) and is_op(p, 1, "=") {
            p.i += 2;
            kws.push(expression(mut p)?);
        } else {
            let e = named_expression(mut p)?;
            if is_kw(p, 0, "for") or (is_kw(p, 0, "async") and is_kw(p, 1, "for")) {
                let gens = comp_for(mut p)?;
                let close = tpos(p, 0);
                let pos = span(open, close);
                args.push(Expr.Comp { kind: "genexpr".to_string(), elt: e, value: None, gens: gens, pos: pos });
            } else {
                args.push(e);
            }
        }
        if not accept_op(mut p, ",") {
            break;
        }
    }
    expect_op(mut p, ")")?;
    Ok((args, kws))
}

fn call(p: mut ref Ps, func: Expr) -> Result[Expr, String] {
    let (args, kws) = call_args(mut p)?;
    let pos = span(expr_pos(func), last_pos(p));
    Ok(Expr.Call { func: func, args: args, keywords: kws, pos: pos })
}

// The `for ... in ... if ...` clauses of a comprehension.
fn comp_for(p: mut ref Ps) -> Result[Vec[Gen], String] {
    let mut gens: Vec[Gen] = Vec.new();
    loop {
        let mut is_async = false;
        if is_kw(p, 0, "async") and is_kw(p, 1, "for") {
            p.i += 1;
            is_async = true;
        }
        if not is_kw(p, 0, "for") {
            break;
        }
        p.i += 1;
        let target = to_store(star_targets(mut p)?);
        expect_kw(mut p, "in")?;
        let iter = disjunction(mut p)?;
        let mut ifs: Vec[Expr] = Vec.new();
        while is_kw(p, 0, "if") {
            p.i += 1;
            ifs.push(disjunction(mut p)?);
        }
        gens.push(Gen { target: target, iter: iter, ifs: ifs, is_async: is_async });
    }
    Ok(gens)
}

// Assignment targets up to `in` (or `=`, `:`): starred and plain
// bitwise-or level expressions, a tuple when there is a comma.
fn star_targets(p: mut ref Ps) -> Result[Expr, String] {
    let first = star_target(mut p)?;
    if not is_op(p, 0, ",") {
        return Ok(first);
    }
    let start = expr_pos(first);
    let mut items = vec![first];
    while accept_op(mut p, ",") {
        if is_kw(p, 0, "in") or is_op(p, 0, "=") or is_op(p, 0, ")") or tk(p, 0) == Tk.Newline {
            break;
        }
        items.push(star_target(mut p)?);
    }
    Ok(group("tuple", items, span(start, last_pos(p))))
}

fn star_target(p: mut ref Ps) -> Result[Expr, String] {
    if is_op(p, 0, "*") {
        let start = tpos(p, 0);
        p.i += 1;
        let v = star_target(mut p)?;
        return Ok(group("starred", vec![v], span(start, last_pos(p))));
    }
    bitwise_or(mut p)
}

fn atom(p: mut ref Ps) -> Result[Expr, String] {
    let t = tpos(p, 0);
    match tk(p, 0) {
        Tk.Name => {
            let w = tx(p, 0);
            if w == "None" or w == "True" or w == "False" {
                p.i += 1;
                return Ok(group("const", Vec.new(), t));
            }
            if hard_keyword(w) {
                return Err(perr(p, "unexpected keyword"));
            }
            p.i += 1;
            Ok(Expr.Name { id: w, store: false, pos: t })
        }
        Tk.Number => {
            p.i += 1;
            Ok(group("const", Vec.new(), t))
        }
        Tk.Str => strings(mut p),
        Tk.Op => {
            let w = tx(p, 0);
            if w == "..." {
                p.i += 1;
                return Ok(group("const", Vec.new(), t));
            }
            if w == "(" {
                return paren(mut p);
            }
            if w == "[" {
                return list_display(mut p);
            }
            if w == "{" {
                return brace_display(mut p);
            }
            Err(perr(p, "expected an expression"))
        }
        _ => Err(perr(p, "expected an expression")),
    }
}

fn paren(p: mut ref Ps) -> Result[Expr, String] {
    let open = tpos(p, 0);
    p.i += 1;
    if is_op(p, 0, ")") {
        p.i += 1;
        return Ok(group("tuple", Vec.new(), span(open, last_pos(p))));
    }
    if is_kw(p, 0, "yield") {
        let y = yield_expr(mut p)?;
        expect_op(mut p, ")")?;
        return Ok(y);
    }
    let first = star_named_expression(mut p)?;
    if is_kw(p, 0, "for") or (is_kw(p, 0, "async") and is_kw(p, 1, "for")) {
        let gens = comp_for(mut p)?;
        expect_op(mut p, ")")?;
        return Ok(Expr.Comp { kind: "genexpr".to_string(), elt: first, value: None, gens: gens, pos: span(open, last_pos(p)) });
    }
    if not is_op(p, 0, ",") {
        expect_op(mut p, ")")?;
        return Ok(first);
    }
    let mut items = vec![first];
    while accept_op(mut p, ",") {
        if is_op(p, 0, ")") {
            break;
        }
        items.push(star_named_expression(mut p)?);
    }
    expect_op(mut p, ")")?;
    Ok(group("tuple", items, span(open, last_pos(p))))
}

fn list_display(p: mut ref Ps) -> Result[Expr, String] {
    let open = tpos(p, 0);
    p.i += 1;
    if is_op(p, 0, "]") {
        p.i += 1;
        return Ok(group("list", Vec.new(), span(open, last_pos(p))));
    }
    let first = star_named_expression(mut p)?;
    if is_kw(p, 0, "for") or (is_kw(p, 0, "async") and is_kw(p, 1, "for")) {
        let gens = comp_for(mut p)?;
        expect_op(mut p, "]")?;
        return Ok(Expr.Comp { kind: "listcomp".to_string(), elt: first, value: None, gens: gens, pos: span(open, last_pos(p)) });
    }
    let mut items = vec![first];
    while accept_op(mut p, ",") {
        if is_op(p, 0, "]") {
            break;
        }
        items.push(star_named_expression(mut p)?);
    }
    expect_op(mut p, "]")?;
    Ok(group("list", items, span(open, last_pos(p))))
}

fn brace_display(p: mut ref Ps) -> Result[Expr, String] {
    let open = tpos(p, 0);
    p.i += 1;
    if is_op(p, 0, "}") {
        p.i += 1;
        return Ok(Expr.Dict { keys: Vec.new(), values: Vec.new(), pos: span(open, last_pos(p)) });
    }
    let mut keys: Vec[Option[Expr]] = Vec.new();
    let mut values: Vec[Expr] = Vec.new();
    if is_op(p, 0, "**") {
        p.i += 1;
        keys.push(None);
        values.push(bitwise_or(mut p)?);
    } else {
        let first = star_named_expression(mut p)?;
        if not is_op(p, 0, ":") {
            // A set.
            if is_kw(p, 0, "for") or (is_kw(p, 0, "async") and is_kw(p, 1, "for")) {
                let gens = comp_for(mut p)?;
                expect_op(mut p, "}")?;
                return Ok(Expr.Comp { kind: "setcomp".to_string(), elt: first, value: None, gens: gens, pos: span(open, last_pos(p)) });
            }
            let mut items = vec![first];
            while accept_op(mut p, ",") {
                if is_op(p, 0, "}") {
                    break;
                }
                items.push(star_named_expression(mut p)?);
            }
            expect_op(mut p, "}")?;
            return Ok(group("set", items, span(open, last_pos(p))));
        }
        p.i += 1;
        let v = expression(mut p)?;
        if is_kw(p, 0, "for") or (is_kw(p, 0, "async") and is_kw(p, 1, "for")) {
            let gens = comp_for(mut p)?;
            expect_op(mut p, "}")?;
            return Ok(Expr.Comp { kind: "dictcomp".to_string(), elt: first, value: Some(v), gens: gens, pos: span(open, last_pos(p)) });
        }
        keys.push(Some(first));
        values.push(v);
    }
    while accept_op(mut p, ",") {
        if is_op(p, 0, "}") {
            break;
        }
        if is_op(p, 0, "**") {
            p.i += 1;
            keys.push(None);
            values.push(bitwise_or(mut p)?);
        } else {
            keys.push(Some(expression(mut p)?));
            expect_op(mut p, ":")?;
            values.push(expression(mut p)?);
        }
    }
    expect_op(mut p, "}")?;
    Ok(Expr.Dict { keys: keys, values: values, pos: span(open, last_pos(p)) })
}

fn yield_expr(p: mut ref Ps) -> Result[Expr, String] {
    let start = tpos(p, 0);
    p.i += 1;
    if is_kw(p, 0, "from") {
        p.i += 1;
        let v = expression(mut p)?;
        return Ok(Expr.Yield { value: Some(v), from: true, pos: span(start, last_pos(p)) });
    }
    if starts_expr(p) {
        let v = star_expressions(mut p)?;
        return Ok(Expr.Yield { value: Some(v), from: false, pos: span(start, last_pos(p)) });
    }
    Ok(Expr.Yield { value: None, from: false, pos: start })
}

// ---------------------------------------------- strings and f-strings

// Adjacent string literals concatenate; any f-string among them makes a
// JoinedStr, whose replacement fields are expressions.
fn strings(p: mut ref Ps) -> Result[Expr, String] {
    let start = tpos(p, 0);
    let mut fields: Vec[Expr] = Vec.new();
    let mut joined = false;
    while tk(p, 0) == Tk.Str {
        let text = tx(p, 0);
        let pos = tpos(p, 0);
        p.i += 1;
        let b = text.bytes().to_vec();
        let mut k: i64 = 0;
        let mut fstr = false;
        while b[k] != b'\'' and b[k] != b'"' {
            if b[k] == b'f' or b[k] == b'F' {
                fstr = true;
            }
            k += 1;
        }
        if fstr {
            joined = true;
            let q = b[k];
            let triple = k + 2 < b.len() and b[k + 1] == q and b[k + 2] == q;
            let qlen = if triple { 3 } else { 1 };
            fstring_fields(b, k + qlen, b.len() - qlen, pos, mut fields)?;
        }
    }
    let pos = span(start, last_pos(p));
    if joined {
        Ok(group("joined", fields, pos))
    } else {
        Ok(group("const", Vec.new(), pos))
    }
}

fn sub_text(b: ref Vec[u8], a: i64, e: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    for i in a..e {
        out.push(b[i]);
    }
    String.from_utf8(out).unwrap_or(String.new())
}

// The replacement fields of an f-string body b[a..e]: each `{expr!c:spec}`
// becomes a FormattedValue (a Group of the value and, when there is one,
// the spec, itself a JoinedStr of its own fields).
fn fstring_fields(b: ref Vec[u8], a: i64, e: i64, pos: Pos, out: mut ref Vec[Expr]) -> Result[(), String] {
    let mut i = a;
    while i < e {
        let c = b[i];
        if c == b'{' and i + 1 < e and b[i + 1] == b'{' {
            i += 2;
            continue;
        }
        if c == b'}' {
            i += 1;
            continue;
        }
        if c != b'{' {
            i += 1;
            continue;
        }
        // Find the end of the expression: a `!`, `:`, `=` or `}` at depth 0
        // outside nested strings.
        let start = i + 1;
        let mut j = start;
        let mut depth: i64 = 0;
        while j < e {
            let d = b[j];
            if d == b'\'' or d == b'"' {
                let q = d;
                j += 1;
                while j < e and b[j] != q {
                    j += 1;
                }
                j += 1;
                continue;
            }
            if d == b'(' or d == b'[' or d == b'{' {
                depth += 1;
            } else if d == b')' or d == b']' or (d == b'}' and depth > 0) {
                depth -= 1;
            } else if depth == 0 and (d == b'}' or d == b':' or (d == b'!' and j + 1 < e and b[j + 1] != b'=')) {
                break;
            }
            j += 1;
        }
        let src = sub_text(b, start, j);
        let mut toks = tokenize(src.trim())?;
        for t in toks.iter_mut() {
            t.pos = pos;
        }
        let mut sp = Ps { toks: toks, i: 0 };
        let value = star_expressions(mut sp)?;
        let mut parts = vec![value];
        // Conversion.
        if j < e and b[j] == b'!' {
            j += 2;
        }
        // Format spec, which may hold fields of its own.
        if j < e and b[j] == b':' {
            let spec_start = j + 1;
            let mut k = spec_start;
            let mut d2: i64 = 0;
            while k < e {
                if b[k] == b'{' {
                    d2 += 1;
                } else if b[k] == b'}' {
                    if d2 == 0 {
                        break;
                    }
                    d2 -= 1;
                }
                k += 1;
            }
            let mut spec: Vec[Expr] = Vec.new();
            fstring_fields(b, spec_start, k, pos, mut spec)?;
            parts.push(group("joined", spec, pos));
            j = k;
        }
        out.push(group("formatted", parts, pos));
        i = j + 1;
    }
    Ok(())
}

// ---------------------------------------------- parameters

fn param(p: mut ref Ps, with_ann: bool, star_ann: bool) -> Result[Param, String] {
    let (name, npos) = ident(mut p)?;
    let mut ann: Option[Expr] = None;
    if with_ann and is_op(p, 0, ":") {
        p.i += 1;
        ann = Some(if star_ann { star_expression(mut p)? } else { expression(mut p)? });
    }
    Ok(Param { name: name, ann: ann, pos: span(npos, last_pos(p)) })
}

// A parameter list up to `close` (`)` for def, `:` for lambda).
fn parameters(p: mut ref Ps, with_ann: bool, close: Str) -> Result[Params, String] {
    let mut a = Params { posonly: Vec.new(), args: Vec.new(), vararg: None, kwonly: Vec.new(), kw_defaults: Vec.new(), kwarg: None, defaults: Vec.new() };
    let mut kwmode = false;
    while not is_op(p, 0, close) {
        if is_op(p, 0, "/") {
            p.i += 1;
            for x in a.args.iter() {
                a.posonly.push(x.clone());
            }
            a.args = Vec.new();
        } else if is_op(p, 0, "**") {
            p.i += 1;
            a.kwarg = Some(param(mut p, with_ann, false)?);
        } else if is_op(p, 0, "*") {
            p.i += 1;
            kwmode = true;
            if is_ident(p, 0) {
                a.vararg = Some(param(mut p, with_ann, true)?);
            }
        } else {
            let arg = param(mut p, with_ann, false)?;
            let mut default: Option[Expr] = None;
            if accept_op(mut p, "=") {
                default = Some(expression(mut p)?);
            }
            if kwmode {
                a.kwonly.push(arg);
                a.kw_defaults.push(default);
            } else {
                a.args.push(arg);
                if let Some(d) = default {
                    a.defaults.push(d);
                }
            }
        }
        if not accept_op(mut p, ",") {
            break;
        }
    }
    Ok(a)
}

fn empty_args() -> Params {
    Params { posonly: Vec.new(), args: Vec.new(), vararg: None, kwonly: Vec.new(), kw_defaults: Vec.new(), kwarg: None, defaults: Vec.new() }
}

// `[T: bound = default, *Ts, **P]`
fn type_params(p: mut ref Ps) -> Result[Vec[TParam], String] {
    let mut out: Vec[TParam] = Vec.new();
    if not is_op(p, 0, "[") {
        return Ok(out);
    }
    p.i += 1;
    while not is_op(p, 0, "]") {
        let start = tpos(p, 0);
        let mut kind: i64 = 0;
        if accept_op(mut p, "**") {
            kind = 2;
        } else if accept_op(mut p, "*") {
            kind = 1;
        }
        let (name, _) = ident(mut p)?;
        let mut bound: Option[Expr] = None;
        if kind == 0 and accept_op(mut p, ":") {
            bound = Some(expression(mut p)?);
        }
        let mut default: Option[Expr] = None;
        if accept_op(mut p, "=") {
            default = Some(if kind == 1 { star_expression(mut p)? } else { expression(mut p)? });
        }
        out.push(TParam { kind: kind, name: name, bound: bound, default: default, pos: span(start, last_pos(p)) });
        if not accept_op(mut p, ",") {
            break;
        }
    }
    expect_op(mut p, "]")?;
    Ok(out)
}

// ---------------------------------------------- statements

fn at_line_end(p: ref Ps) -> bool {
    tk(p, 0) == Tk.Newline or is_op(p, 0, ";") or tk(p, 0) == Tk.End
}

fn stmt_pos(s: ref Stmt) -> Pos {
    match s {
        Stmt.FuncDef { pos, .. } => pos,
        Stmt.ClassDef { pos, .. } => pos,
        Stmt.TypeAlias { pos, .. } => pos,
        Stmt.Return { pos, .. } => pos,
        Stmt.Delete { pos, .. } => pos,
        Stmt.Assign { pos, .. } => pos,
        Stmt.AugAssign { pos, .. } => pos,
        Stmt.AnnAssign { pos, .. } => pos,
        Stmt.For { pos, .. } => pos,
        Stmt.While { pos, .. } => pos,
        Stmt.If { pos, .. } => pos,
        Stmt.With { pos, .. } => pos,
        Stmt.MatchStmt { pos, .. } => pos,
        Stmt.Raise { pos, .. } => pos,
        Stmt.Try { pos, .. } => pos,
        Stmt.Assert { pos, .. } => pos,
        Stmt.Import { pos, .. } => pos,
        Stmt.Global { pos, .. } => pos,
        Stmt.Nonlocal { pos, .. } => pos,
        Stmt.ExprStmt { pos, .. } => pos,
        Stmt.Simple { pos } => pos,
    }
}

// The statements of a file.
fn parse_module(p: mut ref Ps) -> Result[Vec[Stmt], String] {
    let mut body: Vec[Stmt] = Vec.new();
    while tk(p, 0) != Tk.End {
        if tk(p, 0) == Tk.Newline {
            p.i += 1;
            continue;
        }
        statement(mut p, mut body)?;
    }
    Ok(body)
}

// One statement line or compound statement, appended to `out` (a line
// of simple statements separated by `;` appends several).
fn statement(p: mut ref Ps, out: mut ref Vec[Stmt]) -> Result[(), String] {
    if tk(p, 0) == Tk.Name or is_op(p, 0, "@") {
        let w = tx(p, 0);
        if w == "@" {
            out.push(decorated(mut p)?);
            return Ok(());
        }
        if w == "def" {
            out.push(funcdef(mut p, Vec.new(), tpos(p, 0), false)?);
            return Ok(());
        }
        if w == "async" and is_kw(p, 1, "def") {
            let start = tpos(p, 0);
            p.i += 1;
            out.push(funcdef(mut p, Vec.new(), start, true)?);
            return Ok(());
        }
        if w == "class" {
            out.push(classdef(mut p, Vec.new())?);
            return Ok(());
        }
        if w == "if" {
            out.push(if_stmt(mut p)?);
            return Ok(());
        }
        if w == "while" {
            out.push(while_stmt(mut p)?);
            return Ok(());
        }
        if w == "for" {
            out.push(for_stmt(mut p, tpos(p, 0), false)?);
            return Ok(());
        }
        if w == "async" and is_kw(p, 1, "for") {
            let start = tpos(p, 0);
            p.i += 1;
            out.push(for_stmt(mut p, start, true)?);
            return Ok(());
        }
        if w == "with" {
            out.push(with_stmt(mut p, tpos(p, 0))?);
            return Ok(());
        }
        if w == "async" and is_kw(p, 1, "with") {
            let start = tpos(p, 0);
            p.i += 1;
            out.push(with_stmt(mut p, start)?);
            return Ok(());
        }
        if w == "try" {
            out.push(try_stmt(mut p)?);
            return Ok(());
        }
        if w == "match" and is_match_stmt(p) {
            out.push(match_stmt(mut p)?);
            return Ok(());
        }
    }
    simple_stmts(mut p, mut out)
}

fn simple_stmts(p: mut ref Ps, out: mut ref Vec[Stmt]) -> Result[(), String] {
    loop {
        out.push(simple_stmt(mut p)?);
        if not accept_op(mut p, ";") {
            break;
        }
        if tk(p, 0) == Tk.Newline {
            break;
        }
    }
    if tk(p, 0) == Tk.Newline {
        p.i += 1;
    } else if tk(p, 0) != Tk.End {
        return Err(perr(p, "expected the end of the statement"));
    }
    Ok(())
}

// A block after `:`: an indented suite, or simple statements on the
// same line.
fn block(p: mut ref Ps) -> Result[Vec[Stmt], String] {
    let mut body: Vec[Stmt] = Vec.new();
    if tk(p, 0) == Tk.Newline {
        p.i += 1;
        if tk(p, 0) != Tk.Indent {
            return Err(perr(p, "expected an indented block"));
        }
        p.i += 1;
        while tk(p, 0) != Tk.Dedent and tk(p, 0) != Tk.End {
            if tk(p, 0) == Tk.Newline {
                p.i += 1;
                continue;
            }
            statement(mut p, mut body)?;
        }
        if tk(p, 0) == Tk.Dedent {
            p.i += 1;
        }
    } else {
        simple_stmts(mut p, mut body)?;
    }
    Ok(body)
}

// The end of the last statement of a block, which ends the compound
// statement holding it.
fn body_end(start: Pos, body: ref Vec[Stmt]) -> Pos {
    if body.len() == 0 {
        return start;
    }
    span(start, stmt_pos(body[body.len() - 1]))
}

fn decorated(p: mut ref Ps) -> Result[Stmt, String] {
    let mut decos: Vec[Expr] = Vec.new();
    while is_op(p, 0, "@") {
        p.i += 1;
        decos.push(named_expression(mut p)?);
        if tk(p, 0) != Tk.Newline {
            return Err(perr(p, "expected a newline after the decorator"));
        }
        p.i += 1;
    }
    if is_kw(p, 0, "def") {
        return funcdef(mut p, decos, tpos(p, 0), false);
    }
    if is_kw(p, 0, "async") and is_kw(p, 1, "def") {
        let start = tpos(p, 0);
        p.i += 1;
        return funcdef(mut p, decos, start, true);
    }
    if is_kw(p, 0, "class") {
        return classdef(mut p, decos);
    }
    Err(perr(p, "expected a function or class after the decorator"))
}

// At `def`; `start` is where the statement starts (`async` when there is
// one).
fn funcdef(p: mut ref Ps, decorators: own Vec[Expr], start: Pos, is_async: bool) -> Result[Stmt, String] {
    p.i += 1;
    let (name, _) = ident(mut p)?;
    let tparams = type_params(mut p)?;
    expect_op(mut p, "(")?;
    let args = parameters(mut p, true, ")")?;
    expect_op(mut p, ")")?;
    let mut returns: Option[Expr] = None;
    if accept_op(mut p, "->") {
        returns = Some(expression(mut p)?);
    }
    expect_op(mut p, ":")?;
    let body = block(mut p)?;
    let pos = body_end(start, body);
    Ok(Stmt.FuncDef { name: name, args: args, body: body, decorators: decorators, returns: returns, tparams: tparams, is_async: is_async, pos: pos })
}

fn classdef(p: mut ref Ps, decorators: own Vec[Expr]) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    p.i += 1;
    let (name, _) = ident(mut p)?;
    let tparams = type_params(mut p)?;
    let mut bases: Vec[Expr] = Vec.new();
    let mut keywords: Vec[Expr] = Vec.new();
    if is_op(p, 0, "(") {
        let (a, k) = call_args(mut p)?;
        bases = a;
        keywords = k;
    }
    expect_op(mut p, ":")?;
    let body = block(mut p)?;
    let pos = body_end(start, body);
    Ok(Stmt.ClassDef { name: name, bases: bases, keywords: keywords, body: body, decorators: decorators, tparams: tparams, pos: pos })
}

// `if` and `elif`: an `elif` is an If inside the orelse.
fn if_stmt(p: mut ref Ps) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    p.i += 1;
    let test = named_expression(mut p)?;
    expect_op(mut p, ":")?;
    let body = block(mut p)?;
    let mut orelse: Vec[Stmt] = Vec.new();
    if is_kw(p, 0, "elif") {
        orelse.push(if_stmt(mut p)?);
    } else if is_kw(p, 0, "else") {
        p.i += 1;
        expect_op(mut p, ":")?;
        orelse = block(mut p)?;
    }
    let pos = if orelse.len() > 0 { body_end(start, orelse) } else { body_end(start, body) };
    Ok(Stmt.If { test: test, body: body, orelse: orelse, pos: pos })
}

fn else_block(p: mut ref Ps) -> Result[Vec[Stmt], String] {
    if is_kw(p, 0, "else") {
        p.i += 1;
        expect_op(mut p, ":")?;
        return block(mut p);
    }
    Ok(Vec.new())
}

fn while_stmt(p: mut ref Ps) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    p.i += 1;
    let test = named_expression(mut p)?;
    expect_op(mut p, ":")?;
    let body = block(mut p)?;
    let orelse = else_block(mut p)?;
    let pos = if orelse.len() > 0 { body_end(start, orelse) } else { body_end(start, body) };
    Ok(Stmt.While { test: test, body: body, orelse: orelse, pos: pos })
}

fn for_stmt(p: mut ref Ps, start: Pos, is_async: bool) -> Result[Stmt, String] {
    p.i += 1;
    let target = to_store(star_targets(mut p)?);
    expect_kw(mut p, "in")?;
    let iter = star_expressions(mut p)?;
    expect_op(mut p, ":")?;
    let body = block(mut p)?;
    let orelse = else_block(mut p)?;
    let pos = if orelse.len() > 0 { body_end(start, orelse) } else { body_end(start, body) };
    Ok(Stmt.For { target: target, iter: iter, body: body, orelse: orelse, is_async: is_async, pos: pos })
}

fn with_item(p: mut ref Ps) -> Result[(Expr, Option[Expr]), String] {
    let ctx = expression(mut p)?;
    if is_kw(p, 0, "as") {
        p.i += 1;
        let target = to_store(star_target(mut p)?);
        return Ok((ctx, Some(target)));
    }
    Ok((ctx, None))
}

// The items of a `with` written in parentheses, `with (a as b, c):`, or
// None when the parentheses belong to the first item's expression.
fn paren_with_items(p: mut ref Ps) -> Option[Vec[(Expr, Option[Expr])]] {
    let save = p.i;
    p.i += 1;
    let mut items: Vec[(Expr, Option[Expr])] = Vec.new();
    loop {
        match with_item(mut p) {
            Ok(it) => items.push(it),
            Err(_) => {
                p.i = save;
                return None;
            }
        }
        if not accept_op(mut p, ",") {
            break;
        }
        if is_op(p, 0, ")") {
            break;
        }
    }
    if is_op(p, 0, ")") and is_op(p, 1, ":") {
        p.i += 1;
        return Some(items);
    }
    p.i = save;
    None
}

fn with_stmt(p: mut ref Ps, start: Pos) -> Result[Stmt, String] {
    p.i += 1;
    let mut items: Vec[(Expr, Option[Expr])] = Vec.new();
    let mut done = false;
    if is_op(p, 0, "(") {
        if let Some(its) = paren_with_items(mut p) {
            items = its;
            done = true;
        }
    }
    if not done {
        loop {
            items.push(with_item(mut p)?);
            if not accept_op(mut p, ",") {
                break;
            }
        }
    }
    expect_op(mut p, ":")?;
    let body = block(mut p)?;
    let pos = body_end(start, body);
    Ok(Stmt.With { items: items, body: body, pos: pos })
}

fn try_stmt(p: mut ref Ps) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    p.i += 1;
    expect_op(mut p, ":")?;
    let body = block(mut p)?;
    let mut handlers: Vec[Handler] = Vec.new();
    while is_kw(p, 0, "except") {
        let hstart = tpos(p, 0);
        p.i += 1;
        accept_op(mut p, "*");
        let mut ty: Option[Expr] = None;
        let mut name: Option[String] = None;
        if not is_op(p, 0, ":") {
            ty = Some(expression(mut p)?);
            if is_kw(p, 0, "as") {
                p.i += 1;
                let (n, _) = ident(mut p)?;
                name = Some(n);
            }
        }
        expect_op(mut p, ":")?;
        let hbody = block(mut p)?;
        let hpos = body_end(hstart, hbody);
        handlers.push(Handler { ty: ty, name: name, body: hbody, pos: hpos });
    }
    let orelse = else_block(mut p)?;
    let mut finalbody: Vec[Stmt] = Vec.new();
    if is_kw(p, 0, "finally") {
        p.i += 1;
        expect_op(mut p, ":")?;
        finalbody = block(mut p)?;
    }
    let mut end = body_end(start, body);
    if handlers.len() > 0 {
        end = span(start, handlers[handlers.len() - 1].pos);
    }
    if orelse.len() > 0 {
        end = body_end(start, orelse);
    }
    if finalbody.len() > 0 {
        end = body_end(start, finalbody);
    }
    Ok(Stmt.Try { body: body, handlers: handlers, orelse: orelse, finalbody: finalbody, pos: end })
}

// ---------------------------------------------- simple statements

fn simple_stmt(p: mut ref Ps) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    if tk(p, 0) == Tk.Name {
        let w = tx(p, 0);
        if w == "pass" or w == "break" or w == "continue" {
            p.i += 1;
            return Ok(Stmt.Simple { pos: start });
        }
        if w == "return" {
            p.i += 1;
            let mut value: Option[Expr] = None;
            if not at_line_end(p) {
                value = Some(star_expressions(mut p)?);
            }
            return Ok(Stmt.Return { value: value, pos: span(start, last_pos(p)) });
        }
        if w == "raise" {
            p.i += 1;
            let mut exc: Option[Expr] = None;
            let mut cause: Option[Expr] = None;
            if not at_line_end(p) {
                exc = Some(expression(mut p)?);
                if is_kw(p, 0, "from") {
                    p.i += 1;
                    cause = Some(expression(mut p)?);
                }
            }
            return Ok(Stmt.Raise { exc: exc, cause: cause, pos: span(start, last_pos(p)) });
        }
        if w == "global" or w == "nonlocal" {
            p.i += 1;
            let mut names: Vec[String] = Vec.new();
            loop {
                let (n, _) = ident(mut p)?;
                names.push(n);
                if not accept_op(mut p, ",") {
                    break;
                }
            }
            let pos = span(start, last_pos(p));
            if w == "global" {
                return Ok(Stmt.Global { names: names, pos: pos });
            }
            return Ok(Stmt.Nonlocal { names: names, pos: pos });
        }
        if w == "del" {
            p.i += 1;
            let mut targets: Vec[Expr] = Vec.new();
            loop {
                targets.push(to_store(star_target(mut p)?));
                if not accept_op(mut p, ",") or at_line_end(p) {
                    break;
                }
            }
            return Ok(Stmt.Delete { targets: targets, pos: span(start, last_pos(p)) });
        }
        if w == "assert" {
            p.i += 1;
            let test = expression(mut p)?;
            let mut msg: Option[Expr] = None;
            if accept_op(mut p, ",") {
                msg = Some(expression(mut p)?);
            }
            return Ok(Stmt.Assert { test: test, msg: msg, pos: span(start, last_pos(p)) });
        }
        if w == "import" {
            return import_name(mut p);
        }
        if w == "from" {
            return import_from(mut p);
        }
        if w == "type" and is_ident(p, 1) and (is_op(p, 2, "=") or is_op(p, 2, "[")) {
            p.i += 1;
            let (n, npos) = ident(mut p)?;
            let tparams = type_params(mut p)?;
            expect_op(mut p, "=")?;
            let value = expression(mut p)?;
            let name = Expr.Name { id: n, store: true, pos: npos };
            return Ok(Stmt.TypeAlias { name: name, tparams: tparams, value: value, pos: span(start, last_pos(p)) });
        }
    }
    let parenthesized = is_op(p, 0, "(");
    let first = if is_kw(p, 0, "yield") { yield_expr(mut p)? } else { star_expressions(mut p)? };
    if is_op(p, 0, ":") {
        p.i += 1;
        let ann = expression(mut p)?;
        let mut value: Option[Expr] = None;
        if accept_op(mut p, "=") {
            value = Some(if is_kw(p, 0, "yield") { yield_expr(mut p)? } else { star_expressions(mut p)? });
        }
        let simple = not parenthesized and match first {
            Expr.Name { .. } => true,
            _ => false,
        };
        return Ok(Stmt.AnnAssign { target: to_store(first), ann: ann, value: value, simple: simple, pos: span(start, last_pos(p)) });
    }
    if tk(p, 0) == Tk.Op and tx(p, 0).len() >= 2 and tx(p, 0).ends_with("=") and tx(p, 0) != "==" and tx(p, 0) != "<=" and tx(p, 0) != ">=" and tx(p, 0) != "!=" {
        p.i += 1;
        let value = if is_kw(p, 0, "yield") { yield_expr(mut p)? } else { star_expressions(mut p)? };
        return Ok(Stmt.AugAssign { target: to_store(first), value: value, pos: span(start, last_pos(p)) });
    }
    if is_op(p, 0, "=") {
        let mut targets = vec![to_store(first)];
        let mut value = group("const", Vec.new(), start);
        while accept_op(mut p, "=") {
            let e = if is_kw(p, 0, "yield") { yield_expr(mut p)? } else { star_expressions(mut p)? };
            if is_op(p, 0, "=") {
                targets.push(to_store(e));
            } else {
                value = e;
            }
        }
        return Ok(Stmt.Assign { targets: targets, value: value, pos: span(start, last_pos(p)) });
    }
    Ok(Stmt.ExprStmt { value: first, pos: span(start, last_pos(p)) })
}

fn dotted_name(p: mut ref Ps) -> Result[String, String] {
    let (first, _) = ident(mut p)?;
    let mut name = first;
    while is_op(p, 0, ".") {
        p.i += 1;
        let (n, _) = ident(mut p)?;
        name = f"{name}.{n}";
    }
    Ok(name)
}

fn import_name(p: mut ref Ps) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    p.i += 1;
    let mut names: Vec[Alias] = Vec.new();
    loop {
        let astart = tpos(p, 0);
        let name = dotted_name(mut p)?;
        let mut asname: Option[String] = None;
        if is_kw(p, 0, "as") {
            p.i += 1;
            let (n, _) = ident(mut p)?;
            asname = Some(n);
        }
        names.push(Alias { name: name, asname: asname, pos: span(astart, last_pos(p)) });
        if not accept_op(mut p, ",") {
            break;
        }
    }
    Ok(Stmt.Import { module: None, names: names, pos: span(start, last_pos(p)) })
}

fn import_from(p: mut ref Ps) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    p.i += 1;
    let mut module = String.new();
    while is_op(p, 0, ".") or is_op(p, 0, "...") {
        module = f"{module}{tx(p, 0)}";
        p.i += 1;
    }
    if not is_kw(p, 0, "import") {
        let m = dotted_name(mut p)?;
        module = f"{module}{m}";
    }
    expect_kw(mut p, "import")?;
    let mut names: Vec[Alias] = Vec.new();
    if is_op(p, 0, "*") {
        let spos = tpos(p, 0);
        p.i += 1;
        names.push(Alias { name: "*".to_string(), asname: None, pos: spos });
        return Ok(Stmt.Import { module: Some(module), names: names, pos: span(start, last_pos(p)) });
    }
    let paren = accept_op(mut p, "(");
    loop {
        if paren and is_op(p, 0, ")") {
            break;
        }
        let (name, astart) = ident(mut p)?;
        let mut asname: Option[String] = None;
        if is_kw(p, 0, "as") {
            p.i += 1;
            let (n, _) = ident(mut p)?;
            asname = Some(n);
        }
        names.push(Alias { name: name, asname: asname, pos: span(astart, last_pos(p)) });
        if not accept_op(mut p, ",") {
            break;
        }
    }
    if paren {
        expect_op(mut p, ")")?;
    }
    Ok(Stmt.Import { module: Some(module), names: names, pos: span(start, last_pos(p)) })
}

// ---------------------------------------------- match

// `match` is a soft keyword: a match statement's line ends in `:` and is
// followed by an indented `case`.
fn is_match_stmt(p: ref Ps) -> bool {
    let mut k: i64 = 1;
    while tk(p, k) != Tk.Newline and tk(p, k) != Tk.End {
        k += 1;
    }
    k > 1 and is_op(p, k - 1, ":") and tk(p, k + 1) == Tk.Indent and is_kw(p, k + 2, "case")
}

fn match_stmt(p: mut ref Ps) -> Result[Stmt, String] {
    let start = tpos(p, 0);
    p.i += 1;
    let first = star_named_expression(mut p)?;
    let mut subject = first.clone();
    if is_op(p, 0, ",") {
        let mut items = vec![first];
        while accept_op(mut p, ",") {
            if is_op(p, 0, ":") {
                break;
            }
            items.push(star_named_expression(mut p)?);
        }
        subject = group("tuple", items, span(start, last_pos(p)));
    }
    expect_op(mut p, ":")?;
    if tk(p, 0) != Tk.Newline {
        return Err(perr(p, "expected a newline"));
    }
    p.i += 1;
    if tk(p, 0) != Tk.Indent {
        return Err(perr(p, "expected an indented block"));
    }
    p.i += 1;
    let mut cases: Vec[Case] = Vec.new();
    let mut end = start;
    while is_kw(p, 0, "case") {
        p.i += 1;
        let pattern = patterns(mut p)?;
        let mut guard: Option[Expr] = None;
        if is_kw(p, 0, "if") {
            p.i += 1;
            guard = Some(named_expression(mut p)?);
        }
        expect_op(mut p, ":")?;
        let body = block(mut p)?;
        end = body_end(start, body);
        cases.push(Case { pattern: pattern, guard: guard, body: body });
    }
    if tk(p, 0) == Tk.Dedent {
        p.i += 1;
    }
    Ok(Stmt.MatchStmt { subject: subject, cases: cases, pos: end })
}

fn pat_pos(pt: ref Pat) -> Pos {
    match pt {
        Pat.Value { pos, .. } => pos,
        Pat.Singleton { pos } => pos,
        Pat.Sequence { pos, .. } => pos,
        Pat.Star { pos, .. } => pos,
        Pat.Mapping { pos, .. } => pos,
        Pat.Class { pos, .. } => pos,
        Pat.As { pos, .. } => pos,
        Pat.Or { pos, .. } => pos,
    }
}

// The top of a case: an open sequence `a, *b` or one pattern.
fn patterns(p: mut ref Ps) -> Result[Pat, String] {
    let start = tpos(p, 0);
    let first = maybe_star_pattern(mut p)?;
    if not is_op(p, 0, ",") {
        return Ok(first);
    }
    let mut pats = vec![first];
    while accept_op(mut p, ",") {
        if is_op(p, 0, ":") or is_kw(p, 0, "if") {
            break;
        }
        pats.push(maybe_star_pattern(mut p)?);
    }
    Ok(Pat.Sequence { pats: pats, pos: span(start, last_pos(p)) })
}

fn maybe_star_pattern(p: mut ref Ps) -> Result[Pat, String] {
    if is_op(p, 0, "*") {
        let start = tpos(p, 0);
        p.i += 1;
        let (n, _) = ident(mut p)?;
        let name = if n == "_" { None } else { Some(n) };
        return Ok(Pat.Star { name: name, pos: span(start, last_pos(p)) });
    }
    pattern(mut p)
}

// or_pattern ['as' NAME]
fn pattern(p: mut ref Ps) -> Result[Pat, String] {
    let start = tpos(p, 0);
    let first = closed_pattern(mut p)?;
    let mut pat = first.clone();
    if is_op(p, 0, "|") {
        let mut pats = vec![first];
        while accept_op(mut p, "|") {
            pats.push(closed_pattern(mut p)?);
        }
        pat = Pat.Or { pats: pats, pos: span(start, last_pos(p)) };
    }
    if is_kw(p, 0, "as") {
        p.i += 1;
        let (n, _) = ident(mut p)?;
        return Ok(Pat.As { pat: Some(pat), name: Some(n), pos: span(start, last_pos(p)) });
    }
    Ok(pat)
}

fn closed_pattern(p: mut ref Ps) -> Result[Pat, String] {
    let start = tpos(p, 0);
    if tk(p, 0) == Tk.Number or tk(p, 0) == Tk.Str or is_op(p, 0, "-") {
        let v = bitwise_or(mut p)?;
        return Ok(Pat.Value { value: v, pos: span(start, last_pos(p)) });
    }
    if is_kw(p, 0, "None") or is_kw(p, 0, "True") or is_kw(p, 0, "False") {
        p.i += 1;
        return Ok(Pat.Singleton { pos: start });
    }
    if is_op(p, 0, "(") or is_op(p, 0, "[") {
        let close = if is_op(p, 0, "(") { ")" } else { "]" };
        let is_paren = close == ")";
        p.i += 1;
        let mut pats: Vec[Pat] = Vec.new();
        let mut comma = false;
        while not is_op(p, 0, close) {
            pats.push(maybe_star_pattern(mut p)?);
            if not accept_op(mut p, ",") {
                break;
            }
            comma = true;
        }
        expect_op(mut p, close)?;
        if is_paren and pats.len() == 1 and not comma {
            return Ok(pats[0].clone());
        }
        return Ok(Pat.Sequence { pats: pats, pos: span(start, last_pos(p)) });
    }
    if is_op(p, 0, "{") {
        p.i += 1;
        let mut keys: Vec[Expr] = Vec.new();
        let mut pats: Vec[Pat] = Vec.new();
        let mut rest: Option[String] = None;
        while not is_op(p, 0, "}") {
            if accept_op(mut p, "**") {
                let (n, _) = ident(mut p)?;
                rest = Some(n);
            } else {
                keys.push(bitwise_or(mut p)?);
                expect_op(mut p, ":")?;
                pats.push(pattern(mut p)?);
            }
            if not accept_op(mut p, ",") {
                break;
            }
        }
        expect_op(mut p, "}")?;
        return Ok(Pat.Mapping { keys: keys, pats: pats, rest: rest, pos: span(start, last_pos(p)) });
    }
    if is_ident(p, 0) {
        // A capture, the wildcard, a dotted value or a class pattern.
        let (n, npos) = ident(mut p)?;
        let mut e = Expr.Name { id: n.clone(), store: false, pos: npos };
        let mut dotted = false;
        while is_op(p, 0, ".") {
            p.i += 1;
            ident(mut p)?;
            e = group("attr", vec![e], span(npos, last_pos(p)));
            dotted = true;
        }
        if is_op(p, 0, "(") {
            p.i += 1;
            let mut pats: Vec[Pat] = Vec.new();
            let mut kwd: Vec[Pat] = Vec.new();
            while not is_op(p, 0, ")") {
                if is_ident(p, 0) and is_op(p, 1, "=") {
                    p.i += 2;
                    kwd.push(pattern(mut p)?);
                } else {
                    pats.push(pattern(mut p)?);
                }
                if not accept_op(mut p, ",") {
                    break;
                }
            }
            expect_op(mut p, ")")?;
            return Ok(Pat.Class { cls: e, pats: pats, kwd_pats: kwd, pos: span(start, last_pos(p)) });
        }
        if dotted {
            return Ok(Pat.Value { value: e, pos: span(start, last_pos(p)) });
        }
        if n == "_" {
            return Ok(Pat.As { pat: None, name: None, pos: npos });
        }
        return Ok(Pat.As { pat: None, name: Some(n), pos: npos });
    }
    Err(perr(p, "expected a pattern"))
}

// ------------------------------------------------------------ symbol table
//
// Python/symtable.c, pass for pass: the visitor records each name's raw
// flags in the block it occurs in, then the analysis decides each name's
// scope (local, cell, free, global) from the blocks around it.

const DEF_GLOBAL: i64 = 1;
const DEF_LOCAL: i64 = 2;
const DEF_PARAM: i64 = 4;
const DEF_NONLOCAL: i64 = 8;
const USE: i64 = 16;
const DEF_FREE_CLASS: i64 = 64;
const DEF_IMPORT: i64 = 128;
const DEF_ANNOT: i64 = 256;
const DEF_COMP_ITER: i64 = 512;
const DEF_TYPE_PARAM: i64 = 1024;
const DEF_COMP_CELL: i64 = 2048;
const DEF_BOUND: i64 = 134;

const SCOPE_OFFSET: i64 = 12;
const SCOPE_MASK: i64 = 15;
const LOCAL: i64 = 1;
const GLOBAL_EXPLICIT: i64 = 2;
const GLOBAL_IMPLICIT: i64 = 3;
const FREE: i64 = 4;
const CELL: i64 = 5;

// Block types.
const B_FUNCTION: i64 = 0;
const B_CLASS: i64 = 1;
const B_MODULE: i64 = 2;
const B_ANNOTATION: i64 = 3;
const B_TYPE_ALIAS: i64 = 4;
const B_TYPE_PARAMS: i64 = 5;
const B_TYPE_VAR: i64 = 6;

// Comprehension kinds.
const C_NONE: i64 = 0;
const C_LIST: i64 = 1;
const C_SET: i64 = 2;
const C_DICT: i64 = 3;
const C_GEN: i64 = 4;

#[derive(Clone)]
struct Ste {
    name: String,
    kind: i64,
    lineno: i64,
    // The symbols in the order they were first seen, which is the order
    // the analysis visits them in, and their flags.
    names: Vec[String],
    flags: Map[String, i64],
    varnames: Vec[String],
    children: Vec[i64],
    directives: Vec[(String, Pos)],
    has_mangled: bool,
    mangled: Set[String],
    scope_info: String,
    nested: bool,
    free: bool,
    child_free: bool,
    generator: bool,
    coroutine: bool,
    comprehension: i64,
    comp_inlined: bool,
    comp_iter_target: bool,
    can_see_class_scope: bool,
    comp_iter_expr: i64,
}

struct St {
    tabs: Vec[Ste],
    stack: Vec[i64],
    cur: i64,
    privname: Option[String],
    future_annotations: bool,
}

fn serr(msg: Str, pos: Pos) -> String {
    f"{msg} at {pos.line}:{pos.col + 1}-{pos.eline}:{pos.ecol + 1}"
}

fn function_like(kind: i64) -> bool {
    kind == B_FUNCTION or kind == B_TYPE_VAR or kind == B_TYPE_ALIAS or kind == B_TYPE_PARAMS
}

fn sym(t: ref Ste, name: Str) -> i64 {
    t.flags.get(name.to_string()) ?? 0
}

fn has_sym(t: ref Ste, name: Str) -> bool {
    t.flags.contains_key(name.to_string())
}

fn set_sym(t: mut ref Ste, name: Str, val: i64) {
    if not t.flags.contains_key(name.to_string()) {
        t.names.push(name.to_string());
    }
    t.flags.insert(name.to_string(), val);
}

fn del_sym(t: mut ref Ste, name: Str) {
    if t.flags.remove(name.to_string()).is_some() {
        t.names.retain(|n: ref String| n != name);
    }
}

fn scope_of(flags: i64) -> i64 {
    (flags >> SCOPE_OFFSET) & SCOPE_MASK
}

// _Py_Mangle: `__x` in class C becomes `_C__x`.
fn mangle(privname: ref Option[String], ident: Str) -> String {
    let p = match privname {
        Some(p) => p.clone(),
        None => return ident.to_string(),
    };
    let b = ident.bytes().to_vec();
    if b.len() < 2 or b[0] != b'_' or b[1] != b'_' {
        return ident.to_string();
    }
    if (b[b.len() - 1] == b'_' and b[b.len() - 2] == b'_') or ident.contains(".") {
        return ident.to_string();
    }
    let mut k: i64 = 0;
    while k < p.len() and p.bytes()[k] == b'_' {
        k += 1;
    }
    if k == p.len() {
        return ident.to_string();
    }
    f"_{p.substring(k)}{ident}"
}

// _Py_MaybeMangle: in the type-parameter block of a generic class only
// the type parameters themselves are mangled.
fn maybe_mangle(st: ref St, ste: i64, name: Str) -> String {
    let t = ref st.tabs[ste];
    if t.has_mangled and not t.mangled.contains(name.to_string()) {
        return name.to_string();
    }
    mangle(st.privname, name)
}

fn lookup_entry(st: ref St, ste: i64, name: Str) -> i64 {
    let m = maybe_mangle(st, ste, name);
    sym(st.tabs[ste], m)
}

fn lookup(st: ref St, name: Str) -> i64 {
    lookup_entry(st, st.cur, name)
}

fn add_def_helper(st: mut ref St, name: Str, flag: i64, ste: i64, pos: Pos) -> Result[(), String] {
    let mangled = maybe_mangle(st, st.cur, name);
    let mut val = flag;
    if has_sym(st.tabs[ste], mangled) {
        let old = sym(st.tabs[ste], mangled);
        if (flag & DEF_PARAM) != 0 and (old & DEF_PARAM) != 0 {
            return Err(serr(f"duplicate argument '{name}' in function definition", pos));
        }
        if (flag & DEF_TYPE_PARAM) != 0 and (old & DEF_TYPE_PARAM) != 0 {
            return Err(serr(f"duplicate type parameter '{name}'", pos));
        }
        val = old | flag;
    }
    if st.tabs[ste].comp_iter_target {
        if (val & (DEF_GLOBAL | DEF_NONLOCAL)) != 0 {
            return Err(serr(f"comprehension inner loop cannot rebind assignment expression target '{name}'", pos));
        }
        val = val | DEF_COMP_ITER;
    }
    set_sym(mut st.tabs[ste], mangled, val);
    if (flag & DEF_PARAM) != 0 {
        st.tabs[ste].varnames.push(mangled.clone());
    } else if (flag & DEF_GLOBAL) != 0 {
        let g = flag | sym(st.tabs[0], mangled);
        set_sym(mut st.tabs[0], mangled, g);
    }
    Ok(())
}

fn add_def(st: mut ref St, name: Str, flag: i64, pos: Pos) -> Result[(), String] {
    let c = st.cur;
    if (flag & DEF_TYPE_PARAM) != 0 and st.tabs[c].has_mangled {
        st.tabs[c].mangled.insert(name.to_string());
    }
    add_def_helper(mut st, name, flag, c, pos)
}

fn record_directive(st: mut ref St, name: Str, pos: Pos) {
    let c = st.cur;
    let m = maybe_mangle(st, c, name);
    st.tabs[c].directives.push((m, pos));
}

fn enter_block(st: mut ref St, name: Str, kind: i64, lineno: i64) {
    let prev = st.cur;
    let mut t = Ste {
        name: name.to_string(),
        kind: kind,
        lineno: lineno,
        names: Vec.new(),
        flags: Map.new(),
        varnames: Vec.new(),
        children: Vec.new(),
        directives: Vec.new(),
        has_mangled: false,
        mangled: Set.new(),
        scope_info: String.new(),
        nested: false,
        free: false,
        child_free: false,
        generator: false,
        coroutine: false,
        comprehension: C_NONE,
        comp_inlined: false,
        comp_iter_target: false,
        can_see_class_scope: false,
        comp_iter_expr: 0,
    };
    if prev >= 0 {
        let p = ref st.tabs[prev];
        if p.nested or function_like(p.kind) {
            t.nested = true;
        }
        t.comp_iter_expr = p.comp_iter_expr;
        if p.has_mangled and kind != B_CLASS {
            t.has_mangled = true;
            t.mangled = p.mangled.clone();
        }
    }
    let idx = st.tabs.len();
    st.tabs.push(t);
    st.stack.push(idx);
    st.cur = idx;
    // An annotation block (under `from __future__ import annotations`)
    // records its names but is no table's child.
    if kind == B_ANNOTATION {
        return;
    }
    if prev >= 0 {
        st.tabs[prev].children.push(idx);
    }
}

fn exit_block(st: mut ref St) {
    st.stack.pop();
    st.cur = if st.stack.len() > 0 { st.stack[st.stack.len() - 1] } else { -1 };
}

// ---------------------------------------------- the visitor

fn visit_body(st: mut ref St, body: ref Vec[Stmt]) -> Result[(), String] {
    for s in body.iter() {
        visit_stmt(mut st, s)?;
    }
    Ok(())
}

fn visit_exprs(st: mut ref St, es: ref Vec[Expr]) -> Result[(), String] {
    for e in es.iter() {
        visit_expr(mut st, e)?;
    }
    Ok(())
}

fn visit_opt(st: mut ref St, e: ref Option[Expr]) -> Result[(), String] {
    if let Some(x) = e {
        visit_expr(mut st, x)?;
    }
    Ok(())
}

fn visit_opts(st: mut ref St, es: ref Vec[Option[Expr]]) -> Result[(), String] {
    for e in es.iter() {
        visit_opt(mut st, e)?;
    }
    Ok(())
}

fn has_kwonly_defaults(a: ref Params) -> bool {
    for d in a.kw_defaults.iter() {
        if d.is_some() {
            return true;
        }
    }
    false
}

fn enter_type_param_block(st: mut ref St, name: Str, has_defaults: bool, has_kwdefaults: bool, is_class: bool, pos: Pos) -> Result[(), String] {
    let current = st.tabs[st.cur].kind;
    enter_block(mut st, name, B_TYPE_PARAMS, pos.line);
    if current == B_CLASS {
        let c = st.cur;
        st.tabs[c].can_see_class_scope = true;
        add_def(mut st, "__classdict__", USE, pos)?;
    }
    if is_class {
        add_def(mut st, ".type_params", DEF_LOCAL, pos)?;
        add_def(mut st, ".type_params", USE, pos)?;
        add_def(mut st, ".generic_base", DEF_LOCAL, pos)?;
        add_def(mut st, ".generic_base", USE, pos)?;
    }
    if has_defaults {
        add_def(mut st, ".defaults", DEF_PARAM, pos)?;
    }
    if has_kwdefaults {
        add_def(mut st, ".kwdefaults", DEF_PARAM, pos)?;
    }
    Ok(())
}

fn visit_type_params(st: mut ref St, tps: ref Vec[TParam]) -> Result[(), String] {
    for tp in tps.iter() {
        add_def(mut st, tp.name, DEF_TYPE_PARAM | DEF_LOCAL, tp.pos)?;
        if tp.kind == 0 {
            let info = match tp.bound {
                Some(b) => if is_group(b, "tuple") { "a TypeVar constraint" } else { "a TypeVar bound" },
                None => "",
            };
            visit_bound_or_default(mut st, tp.bound, tp.name, tp.pos, info)?;
            visit_bound_or_default(mut st, tp.default, tp.name, tp.pos, "a TypeVar default")?;
        } else if tp.kind == 1 {
            visit_bound_or_default(mut st, tp.default, tp.name, tp.pos, "a TypeVarTuple default")?;
        } else {
            visit_bound_or_default(mut st, tp.default, tp.name, tp.pos, "a ParamSpec default")?;
        }
    }
    Ok(())
}

fn visit_bound_or_default(st: mut ref St, e: ref Option[Expr], name: Str, tp_pos: Pos, info: Str) -> Result[(), String] {
    if name == "__classdict__" {
        return Err(serr(f"reserved name '{name}' cannot be used for type parameter", tp_pos));
    }
    if let Some(x) = e {
        let in_class = st.tabs[st.cur].can_see_class_scope;
        let p = expr_pos(x);
        enter_block(mut st, name, B_TYPE_VAR, p.line);
        let c = st.cur;
        st.tabs[c].can_see_class_scope = in_class;
        if in_class {
            add_def(mut st, "__classdict__", USE, p)?;
        }
        st.tabs[c].scope_info = info.to_string();
        visit_expr(mut st, x)?;
        exit_block(mut st);
    }
    Ok(())
}

fn visit_annotation(st: mut ref St, e: ref Expr) -> Result[(), String] {
    let fut = st.future_annotations;
    if fut {
        enter_block(mut st, "_annotation", B_ANNOTATION, expr_pos(e).line);
    }
    visit_expr(mut st, e)?;
    if fut {
        exit_block(mut st);
    }
    Ok(())
}

fn visit_arg_annotations(st: mut ref St, args: ref Vec[Param]) -> Result[(), String] {
    for a in args.iter() {
        visit_opt(mut st, a.ann)?;
    }
    Ok(())
}

fn visit_annotations(st: mut ref St, line: i64, a: ref Params, returns: ref Option[Expr]) -> Result[(), String] {
    let fut = st.future_annotations;
    if fut {
        enter_block(mut st, "_annotation", B_ANNOTATION, line);
    }
    visit_arg_annotations(mut st, a.posonly)?;
    visit_arg_annotations(mut st, a.args)?;
    if let Some(v) = a.vararg {
        visit_opt(mut st, v.ann)?;
    }
    if let Some(k) = a.kwarg {
        visit_opt(mut st, k.ann)?;
    }
    visit_arg_annotations(mut st, a.kwonly)?;
    if fut {
        exit_block(mut st);
    }
    if let Some(r) = returns {
        visit_annotation(mut st, r)?;
    }
    Ok(())
}

fn visit_params(st: mut ref St, args: ref Vec[Param]) -> Result[(), String] {
    for a in args.iter() {
        add_def(mut st, a.name, DEF_PARAM, a.pos)?;
    }
    Ok(())
}

fn visit_arguments(st: mut ref St, a: ref Params) -> Result[(), String] {
    visit_params(mut st, a.posonly)?;
    visit_params(mut st, a.args)?;
    visit_params(mut st, a.kwonly)?;
    if let Some(v) = a.vararg {
        add_def(mut st, v.name, DEF_PARAM, v.pos)?;
    }
    if let Some(k) = a.kwarg {
        add_def(mut st, k.name, DEF_PARAM, k.pos)?;
    }
    Ok(())
}

fn declaration(st: mut ref St, names: ref Vec[String], flag: i64, pos: Pos) -> Result[(), String] {
    let what = if flag == DEF_GLOBAL { "global" } else { "nonlocal" };
    for name in names.iter() {
        let cur = lookup(st, name);
        if (cur & (DEF_PARAM | DEF_LOCAL | USE | DEF_ANNOT)) != 0 {
            let msg = if (cur & DEF_PARAM) != 0 {
                f"name '{name}' is parameter and {what}"
            } else if (cur & USE) != 0 {
                f"name '{name}' is used prior to {what} declaration"
            } else if (cur & DEF_ANNOT) != 0 {
                f"annotated name '{name}' can't be {what}"
            } else {
                f"name '{name}' is assigned to before {what} declaration"
            };
            return Err(serr(msg, pos));
        }
        add_def(mut st, name, flag, pos)?;
        record_directive(mut st, name, pos);
    }
    Ok(())
}

fn visit_stmt(st: mut ref St, s: ref Stmt) -> Result[(), String] {
    match s {
        Stmt.FuncDef { name, args, body, decorators, returns, tparams, is_async, pos } => {
            add_def(mut st, name, DEF_LOCAL, pos)?;
            visit_exprs(mut st, args.defaults)?;
            visit_opts(mut st, args.kw_defaults)?;
            visit_exprs(mut st, decorators)?;
            let generic = tparams.len() > 0;
            if generic {
                enter_type_param_block(mut st, name, true, has_kwonly_defaults(args), false, pos)?;
                visit_type_params(mut st, tparams)?;
            }
            visit_annotations(mut st, pos.line, args, returns)?;
            enter_block(mut st, name, B_FUNCTION, pos.line);
            if is_async {
                let c = st.cur;
                st.tabs[c].coroutine = true;
            }
            visit_arguments(mut st, args)?;
            visit_body(mut st, body)?;
            exit_block(mut st);
            if generic {
                exit_block(mut st);
            }
        }
        Stmt.ClassDef { name, bases, keywords, body, decorators, tparams, pos } => {
            add_def(mut st, name, DEF_LOCAL, pos)?;
            visit_exprs(mut st, decorators)?;
            let saved = st.privname.clone();
            let generic = tparams.len() > 0;
            if generic {
                enter_type_param_block(mut st, name, false, false, true, pos)?;
                st.privname = Some(name.clone());
                let c = st.cur;
                st.tabs[c].has_mangled = true;
                st.tabs[c].mangled = Set.new();
                visit_type_params(mut st, tparams)?;
            }
            visit_exprs(mut st, bases)?;
            visit_exprs(mut st, keywords)?;
            enter_block(mut st, name, B_CLASS, pos.line);
            st.privname = Some(name.clone());
            if generic {
                add_def(mut st, "__type_params__", DEF_LOCAL, pos)?;
                add_def(mut st, ".type_params", USE, pos)?;
            }
            visit_body(mut st, body)?;
            exit_block(mut st);
            if generic {
                exit_block(mut st);
            }
            st.privname = saved;
        }
        Stmt.TypeAlias { name, tparams, value, pos } => {
            visit_expr(mut st, name)?;
            let id = match name {
                Expr.Name { id, .. } => id.clone(),
                _ => String.new(),
            };
            let in_class = st.tabs[st.cur].kind == B_CLASS;
            let generic = tparams.len() > 0;
            if generic {
                enter_type_param_block(mut st, id, false, false, false, pos)?;
                visit_type_params(mut st, tparams)?;
            }
            enter_block(mut st, id, B_TYPE_ALIAS, pos.line);
            let c = st.cur;
            st.tabs[c].can_see_class_scope = in_class;
            if in_class {
                add_def(mut st, "__classdict__", USE, expr_pos(value))?;
            }
            visit_expr(mut st, value)?;
            exit_block(mut st);
            if generic {
                exit_block(mut st);
            }
        }
        Stmt.Return { value, .. } => visit_opt(mut st, value)?,
        Stmt.Delete { targets, .. } => visit_exprs(mut st, targets)?,
        Stmt.Assign { targets, value, .. } => {
            visit_exprs(mut st, targets)?;
            visit_expr(mut st, value)?;
        }
        Stmt.AnnAssign { target, ann, value, simple, pos } => {
            match target {
                Expr.Name { id, pos: npos, .. } => {
                    let cur = lookup(st, id);
                    let at_module = st.cur == 0;
                    if (cur & (DEF_GLOBAL | DEF_NONLOCAL)) != 0 and not at_module and simple {
                        let what = if (cur & DEF_GLOBAL) != 0 { "global" } else { "nonlocal" };
                        return Err(serr(f"annotated name '{id}' can't be {what}", pos));
                    }
                    if simple {
                        add_def(mut st, id, DEF_ANNOT | DEF_LOCAL, npos)?;
                    } else if value.is_some() {
                        add_def(mut st, id, DEF_LOCAL, npos)?;
                    }
                }
                _ => visit_expr(mut st, target)?,
            }
            visit_annotation(mut st, ann)?;
            visit_opt(mut st, value)?;
        }
        Stmt.AugAssign { target, value, .. } => {
            visit_expr(mut st, target)?;
            visit_expr(mut st, value)?;
        }
        Stmt.For { target, iter, body, orelse, .. } => {
            visit_expr(mut st, target)?;
            visit_expr(mut st, iter)?;
            visit_body(mut st, body)?;
            visit_body(mut st, orelse)?;
        }
        Stmt.While { test, body, orelse, .. } => {
            visit_expr(mut st, test)?;
            visit_body(mut st, body)?;
            visit_body(mut st, orelse)?;
        }
        Stmt.If { test, body, orelse, .. } => {
            visit_expr(mut st, test)?;
            visit_body(mut st, body)?;
            visit_body(mut st, orelse)?;
        }
        Stmt.With { items, body, .. } => {
            for (ctx, vars) in items.iter() {
                visit_expr(mut st, ctx)?;
                visit_opt(mut st, vars)?;
            }
            visit_body(mut st, body)?;
        }
        Stmt.MatchStmt { subject, cases, .. } => {
            visit_expr(mut st, subject)?;
            for c in cases.iter() {
                visit_pattern(mut st, c.pattern)?;
                visit_opt(mut st, c.guard)?;
                visit_body(mut st, c.body)?;
            }
        }
        Stmt.Raise { exc, cause, .. } => {
            if exc.is_some() {
                visit_opt(mut st, exc)?;
                visit_opt(mut st, cause)?;
            }
        }
        Stmt.Try { body, handlers, orelse, finalbody, .. } => {
            visit_body(mut st, body)?;
            for h in handlers.iter() {
                visit_opt(mut st, h.ty)?;
                if let Some(n) = h.name {
                    add_def(mut st, n, DEF_LOCAL, h.pos)?;
                }
                visit_body(mut st, h.body)?;
            }
            visit_body(mut st, orelse)?;
            visit_body(mut st, finalbody)?;
        }
        Stmt.Assert { test, msg, .. } => {
            visit_expr(mut st, test)?;
            visit_opt(mut st, msg)?;
        }
        Stmt.Import { names, .. } => {
            for a in names.iter() {
                visit_alias(mut st, a)?;
            }
        }
        Stmt.Global { names, pos } => declaration(mut st, names, DEF_GLOBAL, pos)?,
        Stmt.Nonlocal { names, pos } => declaration(mut st, names, DEF_NONLOCAL, pos)?,
        Stmt.ExprStmt { value, .. } => visit_expr(mut st, value)?,
        Stmt.Simple { .. } => {}
    }
    Ok(())
}

fn visit_alias(st: mut ref St, a: ref Alias) -> Result[(), String] {
    let name = match a.asname {
        Some(n) => n.clone(),
        None => a.name.clone(),
    };
    if name == "*" {
        if st.tabs[st.cur].kind != B_MODULE {
            return Err(serr("import * only allowed at module level", a.pos));
        }
        return Ok(());
    }
    let store = match name.split_once(".") {
        Some((head, _)) => head.to_string(),
        None => name.clone(),
    };
    add_def(mut st, store, DEF_IMPORT, a.pos)
}

fn visit_pattern(st: mut ref St, pt: ref Pat) -> Result[(), String] {
    match pt {
        Pat.Value { value, .. } => visit_expr(mut st, value)?,
        Pat.Singleton { .. } => {}
        Pat.Sequence { pats, .. } => {
            for x in pats.iter() {
                visit_pattern(mut st, x)?;
            }
        }
        Pat.Star { name, pos } => {
            if let Some(n) = name {
                add_def(mut st, n, DEF_LOCAL, pos)?;
            }
        }
        Pat.Mapping { keys, pats, rest, pos } => {
            visit_exprs(mut st, keys)?;
            for x in pats.iter() {
                visit_pattern(mut st, x)?;
            }
            if let Some(n) = rest {
                add_def(mut st, n, DEF_LOCAL, pos)?;
            }
        }
        Pat.Class { cls, pats, kwd_pats, .. } => {
            visit_expr(mut st, cls)?;
            for x in pats.iter() {
                visit_pattern(mut st, x)?;
            }
            for x in kwd_pats.iter() {
                visit_pattern(mut st, x)?;
            }
        }
        Pat.As { pat, name, pos } => {
            if let Some(x) = pat {
                visit_pattern(mut st, x)?;
            }
            if let Some(n) = name {
                add_def(mut st, n, DEF_LOCAL, pos)?;
            }
        }
        Pat.Or { pats, .. } => {
            for x in pats.iter() {
                visit_pattern(mut st, x)?;
            }
        }
    }
    Ok(())
}

fn raise_if_annotation_block(st: ref St, what: Str, pos: Pos) -> Result[(), String] {
    let t = ref st.tabs[st.cur];
    if t.kind == B_ANNOTATION {
        return Err(serr(f"{what} cannot be used within an annotation", pos));
    }
    if t.kind == B_TYPE_VAR {
        return Err(serr(f"{what} cannot be used within {t.scope_info}", pos));
    }
    if t.kind == B_TYPE_ALIAS {
        return Err(serr(f"{what} cannot be used within a type alias", pos));
    }
    if t.kind == B_TYPE_PARAMS {
        return Err(serr(f"{what} cannot be used within the definition of a generic", pos));
    }
    Ok(())
}

fn visit_expr(st: mut ref St, e: ref Expr) -> Result[(), String] {
    match e {
        Expr.Name { id, store, pos } => {
            add_def(mut st, id, if store { DEF_LOCAL } else { USE }, pos)?;
            if not store and function_like(st.tabs[st.cur].kind) and id == "super" {
                add_def(mut st, "__class__", USE, pos)?;
            }
        }
        Expr.Named { target, value, pos } => {
            raise_if_annotation_block(st, "named expression", pos)?;
            if st.tabs[st.cur].comp_iter_expr > 0 {
                return Err(serr("assignment expression cannot be used in a comprehension iterable expression", pos));
            }
            if st.tabs[st.cur].comprehension != C_NONE {
                extend_namedexpr_scope(mut st, target)?;
            }
            visit_expr(mut st, value)?;
            visit_expr(mut st, target)?;
        }
        Expr.Group { items, .. } => visit_exprs(mut st, items)?,
        Expr.Dict { keys, values, .. } => {
            visit_opts(mut st, keys)?;
            visit_exprs(mut st, values)?;
        }
        Expr.IfExp { test, body, orelse, .. } => {
            visit_expr(mut st, test)?;
            visit_expr(mut st, body)?;
            visit_expr(mut st, orelse)?;
        }
        Expr.Lambda { args, body, pos } => {
            visit_exprs(mut st, args.defaults)?;
            visit_opts(mut st, args.kw_defaults)?;
            enter_block(mut st, "lambda", B_FUNCTION, pos.line);
            visit_arguments(mut st, args)?;
            visit_expr(mut st, body)?;
            exit_block(mut st);
        }
        Expr.Comp { kind, elt, value, gens, pos } => handle_comprehension(mut st, kind, elt, value, gens, pos)?,
        Expr.Call { func, args, keywords, .. } => {
            visit_expr(mut st, func)?;
            visit_exprs(mut st, args)?;
            visit_exprs(mut st, keywords)?;
        }
        Expr.Yield { value, pos, .. } => {
            raise_if_annotation_block(st, "yield expression", pos)?;
            visit_opt(mut st, value)?;
            let c = st.cur;
            st.tabs[c].generator = true;
            let comp = st.tabs[c].comprehension;
            if comp != C_NONE {
                let msg = if comp == C_LIST {
                    "'yield' inside list comprehension"
                } else if comp == C_SET {
                    "'yield' inside set comprehension"
                } else if comp == C_DICT {
                    "'yield' inside dict comprehension"
                } else {
                    "'yield' inside generator expression"
                };
                return Err(serr(msg, pos));
            }
        }
        Expr.Await { value, pos } => {
            raise_if_annotation_block(st, "await expression", pos)?;
            visit_expr(mut st, value)?;
            let c = st.cur;
            st.tabs[c].coroutine = true;
        }
    }
    Ok(())
}

fn visit_comprehension(st: mut ref St, g: ref Gen) -> Result[(), String] {
    let c = st.cur;
    st.tabs[c].comp_iter_target = true;
    visit_expr(mut st, g.target)?;
    st.tabs[c].comp_iter_target = false;
    st.tabs[c].comp_iter_expr += 1;
    visit_expr(mut st, g.iter)?;
    st.tabs[c].comp_iter_expr -= 1;
    visit_exprs(mut st, g.ifs)?;
    if g.is_async {
        st.tabs[c].coroutine = true;
    }
    Ok(())
}

fn handle_comprehension(st: mut ref St, kind: ref String, elt: ref Expr, value: ref Option[Expr], gens: ref Vec[Gen], pos: Pos) -> Result[(), String] {
    let is_generator = kind == "genexpr";
    let outer = ref gens[0];
    let parent = st.cur;
    st.tabs[parent].comp_iter_expr += 1;
    visit_expr(mut st, outer.iter)?;
    st.tabs[parent].comp_iter_expr -= 1;
    enter_block(mut st, kind, B_FUNCTION, pos.line);
    let c = st.cur;
    st.tabs[c].comprehension = if kind == "listcomp" {
        C_LIST
    } else if kind == "setcomp" {
        C_SET
    } else if kind == "dictcomp" {
        C_DICT
    } else {
        C_GEN
    };
    if outer.is_async {
        st.tabs[c].coroutine = true;
    }
    add_def(mut st, ".0", DEF_PARAM, pos)?;
    st.tabs[c].comp_iter_target = true;
    visit_expr(mut st, outer.target)?;
    st.tabs[c].comp_iter_target = false;
    visit_exprs(mut st, outer.ifs)?;
    for k in 1..gens.len() {
        visit_comprehension(mut st, gens[k])?;
    }
    visit_opt(mut st, value)?;
    visit_expr(mut st, elt)?;
    st.tabs[c].generator = is_generator;
    let is_async = st.tabs[c].coroutine and not is_generator;
    exit_block(mut st);
    if is_async {
        let p = st.cur;
        st.tabs[p].coroutine = true;
    }
    Ok(())
}

// A walrus inside a comprehension binds in the nearest enclosing
// function or module.
fn extend_namedexpr_scope(st: mut ref St, target: ref Expr) -> Result[(), String] {
    let (name, pos) = match target {
        Expr.Name { id, pos, .. } => (id.clone(), pos),
        _ => return Ok(()),
    };
    let mut i = st.stack.len() - 1;
    while i >= 0 {
        let ste = st.stack[i];
        let kind = st.tabs[ste].kind;
        if st.tabs[ste].comprehension != C_NONE {
            let t = lookup_entry(st, ste, name);
            if (t & DEF_COMP_ITER) != 0 and (t & DEF_LOCAL) != 0 {
                return Err(serr(f"assignment expression cannot rebind comprehension iteration variable '{name}'", pos));
            }
            i -= 1;
            continue;
        }
        if kind == B_FUNCTION {
            let t = lookup_entry(st, ste, name);
            if (t & DEF_GLOBAL) != 0 {
                add_def(mut st, name, DEF_GLOBAL, pos)?;
            } else {
                add_def(mut st, name, DEF_NONLOCAL, pos)?;
            }
            record_directive(mut st, name, pos);
            return add_def_helper(mut st, name, DEF_LOCAL, ste, pos);
        }
        if kind == B_MODULE {
            add_def(mut st, name, DEF_GLOBAL, pos)?;
            record_directive(mut st, name, pos);
            return add_def_helper(mut st, name, DEF_GLOBAL, ste, pos);
        }
        if kind == B_CLASS {
            return Err(serr("assignment expression within a comprehension cannot be used in a class body", pos));
        }
        if kind == B_TYPE_PARAMS {
            return Err(serr("assignment expression within a comprehension cannot be used within the definition of a generic", pos));
        }
        if kind == B_TYPE_ALIAS {
            return Err(serr("assignment expression within a comprehension cannot be used in a type alias", pos));
        }
        if kind == B_TYPE_VAR {
            return Err(serr("assignment expression within a comprehension cannot be used in a TypeVar bound", pos));
        }
        i -= 1;
    }
    Ok(())
}

// Builds the symbol table of a parsed module, analysed.
fn build_symtable(body: ref Vec[Stmt]) -> Result[St, String] {
    let mut st = St { tabs: Vec.new(), stack: Vec.new(), cur: -1, privname: None, future_annotations: future_annotations(body) };
    enter_block(mut st, "top", B_MODULE, 0);
    visit_body(mut st, body)?;
    exit_block(mut st);
    let mut free: SortedSet[String] = SortedSet.new();
    analyze_block(mut st, 0, None, mut free, SortedSet.new(), SortedSet.new(), -1)?;
    Ok(st)
}

// `from __future__ import annotations` among the future imports at the
// top of the module (after its docstring, if it has one).
fn future_annotations(body: ref Vec[Stmt]) -> bool {
    let mut k: i64 = 0;
    for s in body.iter() {
        match s {
            Stmt.ExprStmt { value, .. } => {
                if k > 0 or not is_group(value, "const") {
                    return false;
                }
            }
            Stmt.Import { module, names, .. } => {
                let m = module.clone() ?? String.new();
                if m != "__future__" {
                    return false;
                }
                for a in names.iter() {
                    if a.name == "annotations" {
                        return true;
                    }
                }
            }
            _ => return false,
        }
        k += 1;
    }
    false
}

// ---------------------------------------------- the analysis

fn error_at_directive(st: ref St, ste: i64, name: Str, msg: own String) -> String {
    for (n, pos) in st.tabs[ste].directives.iter() {
        if n == name {
            return serr(msg, *pos);
        }
    }
    msg
}

fn analyze_name(st: mut ref St, ste: i64, scopes: mut ref Map[String, i64], name: Str, flags: i64, bound: mut ref Option[SortedSet[String]], local: mut ref SortedSet[String], free: mut ref SortedSet[String], global: mut ref SortedSet[String], type_params: mut ref SortedSet[String], class_entry: i64) -> Result[(), String] {
    let n = name.to_string();
    if (flags & DEF_GLOBAL) != 0 {
        if (flags & DEF_NONLOCAL) != 0 {
            return Err(error_at_directive(st, ste, name, f"name '{name}' is nonlocal and global"));
        }
        scopes.insert(n.clone(), GLOBAL_EXPLICIT);
        global.insert(n.clone());
        if let Some(b) = bound {
            b.remove(n);
        }
        return Ok(());
    }
    if (flags & DEF_NONLOCAL) != 0 {
        let in_bound = match bound {
            None => return Err(error_at_directive(st, ste, name, "nonlocal declaration not allowed at module level".to_string())),
            Some(b) => b.contains(n.clone()),
        };
        if not in_bound {
            return Err(error_at_directive(st, ste, name, f"no binding for nonlocal '{name}' found"));
        }
        if type_params.contains(n.clone()) {
            return Err(error_at_directive(st, ste, name, f"nonlocal binding not allowed for type parameter '{name}'"));
        }
        scopes.insert(n.clone(), FREE);
        st.tabs[ste].free = true;
        free.insert(n);
        return Ok(());
    }
    if (flags & DEF_BOUND) != 0 {
        scopes.insert(n.clone(), LOCAL);
        local.insert(n.clone());
        global.remove(n.clone());
        if (flags & DEF_TYPE_PARAM) != 0 {
            type_params.insert(n);
        } else {
            type_params.remove(n);
        }
        return Ok(());
    }
    if class_entry >= 0 {
        let cf = sym(st.tabs[class_entry], name);
        if (cf & DEF_GLOBAL) != 0 {
            scopes.insert(n, GLOBAL_EXPLICIT);
            return Ok(());
        }
        if (cf & DEF_BOUND) != 0 and (cf & DEF_NONLOCAL) == 0 {
            scopes.insert(n, GLOBAL_IMPLICIT);
            return Ok(());
        }
    }
    let in_bound = match bound {
        Some(b) => b.contains(n.clone()),
        None => false,
    };
    if in_bound {
        scopes.insert(n.clone(), FREE);
        st.tabs[ste].free = true;
        free.insert(n);
        return Ok(());
    }
    if global.contains(n.clone()) {
        scopes.insert(n, GLOBAL_IMPLICIT);
        return Ok(());
    }
    if st.tabs[ste].nested {
        st.tabs[ste].free = true;
    }
    scopes.insert(n, GLOBAL_IMPLICIT);
    Ok(())
}

fn is_free_in_any_child(st: ref St, comp: i64, name: Str) -> bool {
    for c in st.tabs[comp].children.iter() {
        if scope_of(sym(st.tabs[*c], name)) == FREE {
            return true;
        }
    }
    false
}

fn inline_comprehension(st: mut ref St, ste: i64, comp: i64, scopes: mut ref Map[String, i64], comp_free: mut ref SortedSet[String], inlined_cells: mut ref SortedSet[String]) -> Result[(), String] {
    let mut remove: Vec[String] = Vec.new();
    let is_class = st.tabs[ste].kind == B_CLASS;
    for k in st.tabs[comp].names.clone().iter() {
        let comp_flags = sym(st.tabs[comp], k);
        if (comp_flags & DEF_PARAM) != 0 {
            continue;
        }
        let mut scope = scope_of(comp_flags);
        let only_flags = comp_flags & ((1 << SCOPE_OFFSET) - 1);
        if scope == CELL or (only_flags & DEF_COMP_CELL) != 0 {
            inlined_cells.insert(k.clone());
        }
        let existing = has_sym(st.tabs[ste], k);
        if scope == FREE and is_class and (k == "__class__" or k == "__classdict__" or k == "__conditional_annotations__") {
            scope = GLOBAL_IMPLICIT;
            comp_free.remove(k.clone());
            remove.push(k.clone());
        }
        if not existing {
            set_sym(mut st.tabs[ste], k, only_flags);
            scopes.insert(k.clone(), scope);
        } else if (sym(st.tabs[ste], k) & DEF_BOUND) != 0 {
            if not is_free_in_any_child(st, comp, k) and not is_class {
                comp_free.remove(k.clone());
            }
        }
    }
    st.tabs[comp].free = comp_free.len() > 0;
    for k in remove.iter() {
        del_sym(mut st.tabs[comp], k);
    }
    Ok(())
}

fn analyze_cells(scopes: mut ref Map[String, i64], free: mut ref SortedSet[String], inlined_cells: ref SortedSet[String]) {
    let mut names: Vec[String] = Vec.new();
    for (name, scope) in scopes.iter() {
        if *scope == LOCAL and (free.contains(name.clone()) or inlined_cells.contains(name.clone())) {
            names.push(name.clone());
        }
    }
    for name in names.iter() {
        scopes.insert(name.clone(), CELL);
        free.remove(name.clone());
    }
}

fn update_symbols(t: mut ref Ste, scopes: ref Map[String, i64], bound: ref Option[SortedSet[String]], free: ref SortedSet[String], inlined_cells: ref SortedSet[String], classflag: bool) {
    for name in t.names.clone().iter() {
        let mut flags = sym(t, name);
        if inlined_cells.contains(name.clone()) {
            flags = flags | DEF_COMP_CELL;
        }
        let scope = scopes.get(name.clone()) ?? 0;
        flags = flags | (scope << SCOPE_OFFSET);
        set_sym(mut t, name, flags);
    }
    for name in free.iter() {
        if has_sym(t, name) {
            if classflag {
                let f = sym(t, name) | DEF_FREE_CLASS;
                set_sym(mut t, name, f);
            }
            continue;
        }
        if let Some(ref b) = bound {
            if not b.contains(name.clone()) {
                continue;
            }
        }
        set_sym(mut t, name, FREE << SCOPE_OFFSET);
    }
}

fn analyze_block(st: mut ref St, ste: i64, bound: own Option[SortedSet[String]], free: mut ref SortedSet[String], global: own SortedSet[String], type_params: own SortedSet[String], class_entry: i64) -> Result[(), String] {
    let mut bound = bound;
    let mut global = global;
    let mut type_params = type_params;
    let mut local: SortedSet[String] = SortedSet.new();
    let mut scopes: Map[String, i64] = Map.new();
    let mut newglobal: SortedSet[String] = SortedSet.new();
    let mut newfree: SortedSet[String] = SortedSet.new();
    let mut newbound: SortedSet[String] = SortedSet.new();
    let mut inlined_cells: SortedSet[String] = SortedSet.new();
    let kind = st.tabs[ste].kind;
    if kind == B_CLASS {
        newglobal.extend(global.iter().cloned());
        if let Some(ref b) = bound {
            newbound.extend(b.iter().cloned());
        }
    }
    for name in st.tabs[ste].names.clone().iter() {
        let flags = sym(st.tabs[ste], name);
        analyze_name(mut st, ste, mut scopes, name, flags, mut bound, mut local, mut free, mut global, mut type_params, class_entry)?;
    }
    if kind != B_CLASS {
        if function_like(kind) {
            newbound.extend(local.iter().cloned());
        }
        if let Some(ref b) = bound {
            newbound.extend(b.iter().cloned());
        }
        newglobal.extend(global.iter().cloned());
    } else {
        newbound.insert("__class__".to_string());
        newbound.insert("__classdict__".to_string());
    }
    let children = st.tabs[ste].children.clone();
    for c in children.iter() {
        let entry = *c;
        let mut new_class_entry: i64 = -1;
        if st.tabs[entry].can_see_class_scope {
            if kind == B_CLASS {
                new_class_entry = ste;
            } else if class_entry >= 0 {
                new_class_entry = class_entry;
            }
        }
        let inline_comp = st.tabs[entry].comprehension != C_NONE and not st.tabs[entry].generator and not st.tabs[ste].can_see_class_scope;
        let mut child_free = newfree.clone();
        analyze_block(mut st, entry, Some(newbound.clone()), mut child_free, newglobal.clone(), type_params.clone(), new_class_entry)?;
        if inline_comp {
            inline_comprehension(mut st, ste, entry, mut scopes, mut child_free, mut inlined_cells)?;
            st.tabs[entry].comp_inlined = true;
        }
        newfree.extend(child_free.iter().cloned());
        if st.tabs[entry].free or st.tabs[entry].child_free {
            st.tabs[ste].child_free = true;
        }
    }
    // Splice the children of inlined comprehensions into our own.
    let mut spliced: Vec[i64] = Vec.new();
    for c in st.tabs[ste].children.iter() {
        if st.tabs[*c].comp_inlined {
            for g in st.tabs[*c].children.iter() {
                spliced.push(*g);
            }
        } else {
            spliced.push(*c);
        }
    }
    st.tabs[ste].children = spliced;
    if function_like(kind) {
        analyze_cells(mut scopes, mut newfree, inlined_cells);
    } else if kind == B_CLASS {
        newfree.remove("__class__".to_string());
        newfree.remove("__classdict__".to_string());
    }
    let classflag = kind == B_CLASS or st.tabs[ste].can_see_class_scope;
    update_symbols(mut st.tabs[ste], scopes, bound, newfree, inlined_cells, classflag);
    free.extend(newfree.iter().cloned());
    Ok(())
}

// ------------------------------------------------------------ reports
//
// What Lib/symtable.py shows of a table: its type, the Function and Class
// views, and each Symbol's is_* predicates. Symbols are listed in name
// order, since the order CPython keeps them in depends on its set hashes.

fn rep(s: Str, n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(s);
    }
    out
}

fn type_name(kind: i64) -> Str {
    match kind {
        0 => "function",
        1 => "class",
        2 => "module",
        3 => "annotation",
        4 => "type alias",
        5 => "type parameters",
        _ => "type variable",
    }
}

fn sorted_names(t: ref Ste) -> Vec[String] {
    let mut v = t.names.clone();
    v.sort();
    v
}

fn is_module_scope(t: ref Ste) -> bool {
    t.name == "top"
}

fn s_global(t: ref Ste, f: i64) -> bool {
    let sc = scope_of(f);
    sc == GLOBAL_IMPLICIT or sc == GLOBAL_EXPLICIT or (is_module_scope(t) and (f & DEF_BOUND) != 0)
}

fn s_local(t: ref Ste, f: i64) -> bool {
    let sc = scope_of(f);
    sc == LOCAL or sc == CELL or (is_module_scope(t) and (f & DEF_BOUND) != 0)
}

fn namespaces(st: ref St, t: ref Ste, name: Str) -> i64 {
    let mut n: i64 = 0;
    for c in t.children.iter() {
        if st.tabs[*c].name == name {
            n += 1;
        }
    }
    n
}

fn matching(t: ref Ste, want: i64) -> Vec[String] {
    // want: 0 parameters (in order), 1 locals, 2 frees, 3 globals, 4 nonlocals
    let mut out: Vec[String] = Vec.new();
    for n in t.names.iter() {
        let f = sym(t, n);
        let sc = scope_of(f);
        let hit = match want {
            0 => (f & DEF_PARAM) != 0,
            1 => sc == LOCAL or sc == CELL,
            2 => sc == FREE,
            3 => sc == GLOBAL_IMPLICIT or sc == GLOBAL_EXPLICIT,
            _ => (f & DEF_NONLOCAL) != 0,
        };
        if hit {
            out.push(n.clone());
        }
    }
    if want != 0 {
        out.sort();
    }
    out
}

fn get_methods(st: ref St, t: ref Ste) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for c in t.children.iter() {
        let ch = ref st.tabs[*c];
        if scope_of(sym(t, ch.name)) != LOCAL {
            continue;
        }
        if ch.kind == B_FUNCTION {
            if ch.name == "genexpr" and ch.varnames.contains(".0".to_string()) {
                continue;
            }
            if not out.contains(ch.name.clone()) {
                out.push(ch.name.clone());
            }
        } else if ch.kind == B_TYPE_PARAMS {
            for g in ch.children.iter() {
                let gc = ref st.tabs[*g];
                if gc.name == ch.name and gc.kind == B_FUNCTION {
                    if not out.contains(ch.name.clone()) {
                        out.push(ch.name.clone());
                    }
                    break;
                }
            }
        }
    }
    out
}

fn tables(st: ref St, idx: i64, depth: i64, out: mut ref Vec[String]) {
    let t = ref st.tabs[idx];
    let pad = rep("  ", depth);
    let mut head = f"{pad}{type_name(t.kind)} {t.name} line {t.lineno}";
    if t.nested {
        head = head + " nested";
    }
    if t.kind == B_FUNCTION {
        head = head + " optimized";
    }
    out.push(head);
    if t.kind == B_FUNCTION {
        let params = matching(t, 0);
        let ps = if params.len() == 0 { "-".to_string() } else { params.join(", ") };
        out.push(f"{pad}  params: {ps}");
        let labels = ["locals", "frees", "globals", "nonlocals"].to_vec();
        for k in 0..4 {
            let names = matching(t, k + 1);
            if names.len() > 0 {
                out.push(f"{pad}  {labels[k]}: {names.join(", ")}");
            }
        }
    }
    if t.kind == B_CLASS {
        let methods = get_methods(st, t);
        if methods.len() > 0 {
            out.push(f"{pad}  methods: {methods.join(", ")}");
        }
    }
    for n in sorted_names(t).iter() {
        let f = sym(t, n);
        let sc = scope_of(f);
        let ns = namespaces(st, t, n);
        let mut flags: Vec[String] = Vec.new();
        let checks = [
            ("referenced", (f & USE) != 0),
            ("assigned", (f & DEF_LOCAL) != 0),
            ("parameter", (f & DEF_PARAM) != 0),
            ("global", s_global(t, f)),
            ("declared_global", sc == GLOBAL_EXPLICIT),
            ("local", s_local(t, f)),
            ("free", sc == FREE),
            ("nonlocal", (f & DEF_NONLOCAL) != 0),
            ("imported", (f & DEF_IMPORT) != 0),
            ("annotated", (f & DEF_ANNOT) != 0),
            ("namespace", ns > 0),
        ].to_vec();
        for (label, on) in checks.iter() {
            if on {
                flags.push(label.to_string());
            }
        }
        let fs = if flags.len() == 0 { "-".to_string() } else { flags.join(" ") };
        let extra = if ns > 1 { f" ({ns} namespaces)" } else { String.new() };
        out.push(f"{pad}  {n}: {fs}{extra}");
    }
    for c in t.children.iter() {
        tables(st, *c, depth + 1, mut out);
    }
}

fn scope_str(f: i64) -> String {
    match scope_of(f) {
        1 => "local".to_string(),
        2 => "global_explicit".to_string(),
        3 => "global_implicit".to_string(),
        4 => "free".to_string(),
        5 => "cell".to_string(),
        n => f"{n}",
    }
}

// Symbol._flags_str: each flag whose bits are all set, in the order the
// module lists them.
fn flags_str(f: i64) -> String {
    let all = [
        ("use", USE),
        ("def_global", DEF_GLOBAL),
        ("def_nonlocal", DEF_NONLOCAL),
        ("def_local", DEF_LOCAL),
        ("def_param", DEF_PARAM),
        ("def_import", DEF_IMPORT),
        ("def_bound", DEF_BOUND),
        ("def_annot", DEF_ANNOT),
    ].to_vec();
    let mut out: Vec[String] = Vec.new();
    for (name, v) in all.iter() {
        if (f & v) == v {
            out.push(name.to_string());
        }
    }
    out.join(", ")
}

// `python -m symtable`.
fn dump(st: ref St, idx: i64, filename: Str, level: i64, out: mut ref Vec[String]) {
    let t = ref st.tabs[idx];
    let indent = rep("    ", level);
    let nested = if t.nested { "nested " } else { "" };
    let what = if t.kind == B_MODULE { f"from file '{filename}'" } else { f"'{t.name}'" };
    out.push(f"{indent}symbol table for {nested}{type_name(t.kind)} {what}:");
    for n in sorted_names(t).iter() {
        let f = sym(t, n);
        out.push(f"    {indent}{scope_str(f)} symbol '{n}': {flags_str(f)}");
    }
    out.push(String.new());
    for c in t.children.iter() {
        dump(st, *c, filename, level + 1, mut out);
    }
}

// ---------------------------------------------- lint

// Each table in pre-order, with the table it is nested in (-1 for the
// module).
fn walk(st: ref St, idx: i64, parent: i64, out: mut ref Vec[(i64, i64)]) {
    out.push((idx, parent));
    for c in st.tabs[idx].children.iter() {
        walk(st, *c, idx, mut out);
    }
}

fn frees_below(st: ref St, idx: i64) -> Set[String] {
    let mut names: Set[String] = Set.new();
    for c in st.tabs[idx].children.iter() {
        let mut sub: Vec[(i64, i64)] = Vec.new();
        walk(st, *c, idx, mut sub);
        for (t, _) in sub.iter() {
            let tt = ref st.tabs[t];
            for n in tt.names.iter() {
                if scope_of(sym(tt, n)) == FREE {
                    names.insert(n.clone());
                }
            }
        }
    }
    names
}

fn where_(t: ref Ste) -> String {
    if t.kind == B_MODULE {
        return "the module".to_string();
    }
    f"{type_name(t.kind)} '{t.name}'"
}

fn lint(st: ref St, filename: Str, builtins: ref Set[String], out: mut ref Vec[String]) {
    let mut problems: Vec[(i64, String)] = Vec.new();
    let mut module_bound: Set[String] = Set.new();
    let top = ref st.tabs[0];
    for n in top.names.iter() {
        let f = sym(top, n);
        if (f & DEF_LOCAL) != 0 or (f & DEF_IMPORT) != 0 {
            module_bound.insert(n.clone());
        }
    }
    let mut all: Vec[(i64, i64)] = Vec.new();
    walk(st, 0, -1, mut all);
    for (ti, _) in all.iter() {
        let t = ref st.tabs[ti];
        for n in t.names.iter() {
            let f = sym(t, n);
            if scope_of(f) == GLOBAL_EXPLICIT and (f & DEF_LOCAL) != 0 {
                module_bound.insert(n.clone());
            }
        }
    }
    for (ti, parent) in all.iter() {
        let t = ref st.tabs[ti];
        let line = t.lineno;
        let is_fn = t.kind == B_FUNCTION;
        let below = frees_below(st, ti);
        for name in sorted_names(t).iter() {
            if name.starts_with(".") {
                continue;
            }
            let f = sym(t, name);
            let sc = scope_of(f);
            let referenced = (f & USE) != 0;
            let param = (f & DEF_PARAM) != 0;
            let assigned = (f & DEF_LOCAL) != 0;
            if is_fn and sc == LOCAL and not referenced and not param and not name.starts_with("_") and not below.contains(name.clone()) {
                let what = if (f & DEF_IMPORT) != 0 { "import" } else { "local" };
                problems.push((line, f"unused {what} '{name}' in {where_(t)}"));
            }
            if referenced and sc == GLOBAL_IMPLICIT and not module_bound.contains(name.clone()) and not builtins.contains(name.clone()) {
                problems.push((line, f"undefined name '{name}' in {where_(t)}"));
            }
            if is_fn and sc == GLOBAL_EXPLICIT and not assigned {
                problems.push((line, f"'{name}' is declared global in {where_(t)} but never assigned there"));
            }
            if is_fn and (param or assigned) and s_local(t, f) and builtins.contains(name.clone()) {
                problems.push((line, f"'{name}' shadows a builtin in {where_(t)}"));
            }
            if is_fn and parent >= 0 and st.tabs[parent].kind == B_CLASS and referenced and sc == GLOBAL_IMPLICIT {
                let cls = ref st.tabs[parent];
                if has_sym(cls, name) and (sym(cls, name) & DEF_LOCAL) != 0 {
                    problems.push((line, f"{where_(t)} reads global '{name}', not class attribute {cls.name}.{name}"));
                }
            }
        }
    }
    problems.sort();
    for (line, msg) in problems.iter() {
        out.push(f"{filename}:{line}: {msg}");
    }
    out.push(f"{problems.len()} problems");
}

// ------------------------------------------------------------ jobs

fn run(mode: Str, source: Str, filename: Str, builtins: ref Set[String], out: mut ref Vec[String]) {
    let toks = match tokenize(source) {
        Ok(t) => t,
        Err(e) => {
            out.push(f"! ParseError: {e}");
            return;
        }
    };
    let mut p = Ps { toks: toks, i: 0 };
    let body = match parse_module(mut p) {
        Ok(b) => b,
        Err(e) => {
            out.push(f"! ParseError: {e}");
            return;
        }
    };
    let st = match build_symtable(body) {
        Ok(s) => s,
        Err(e) => {
            out.push(f"! SyntaxError: {e}");
            return;
        }
    };
    if mode == "tables" or mode == "error" {
        tables(st, 0, 0, mut out);
    } else if mode == "dump" {
        dump(st, 0, filename, 0, mut out);
    } else if mode == "lint" {
        lint(st, filename, builtins, mut out);
    } else {
        out.push(f"! unknown mode {mode}");
    }
}

fn transcript(job: String, builtins: Set[String]) -> String {
    let mut out: Vec[String] = Vec.new();
    out.push("$ " + job);
    let (mode, rest) = match job.split_once(" ") {
        Some((m, r)) => (m.to_string(), r.to_string()),
        None => (job.clone(), String.new()),
    };
    if mode == "snip" {
        let (m2, src) = match rest.split_once(" ") {
            Some((m, r)) => (m.to_string(), r.to_string()),
            None => (rest.clone(), String.new()),
        };
        let text = src.replace("\\n", "\n").replace("\\t", "\t") + "\n";
        run(m2, text, "snip.py", builtins, mut out);
    } else {
        match fs.read_to_string("data/" + rest) {
            Ok(text) => run(mode, text, rest, builtins, mut out),
            Err(e) => out.push(f"! cannot read {rest}: {e}"),
        }
    }
    out.join("\n") + "\n"
}

fn is_hexd(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let mut builtins: Set[String] = Set.new();
    match fs.read_to_string("data/builtins.txt".to_string()) {
        Ok(t) => {
            for w in t.split_whitespace() {
                builtins.insert(w.to_string());
            }
        }
        Err(e) => {
            eprintln(f"cannot read builtins.txt: {e}");
            return;
        }
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in jobs.split("\n") {
        let t = l.strip_suffix("\r") ?? l;
        if t.trim().len() > 0 {
            lines.push(t.to_string());
        }
    }
    // Every job in a task of its own; the transcript prints in job order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for line in lines {
        let b = builtins.clone();
        handles.push(group.spawn(|| transcript(line, b)));
    }
    for h in handles.into_iter() {
        print(h.join());
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/builtins.txt", unhex(file_0()))?;
    put_bytes("data/cli.py", unhex(file_1()))?;
    put_bytes("data/jobs.txt", unhex(file_2()))?;
    put_bytes("data/models.py", unhex(file_3()))?;
    put_bytes("data/pipeline.py", unhex(file_4()))?;
    put_bytes("data/smells.py", unhex(file_5()))?;
    put_bytes("data/webapp.py", unhex(file_6()))?;
    Ok(())
}

