// mini_lunr: a port of lunr.py 0.8.0 (MIT, Yeray Díaz Díaz), the
// Python port of lunr.js that static documentation sites use for search.
//
// It builds a search index over a documentation site's pages the way
// `lunr(ref, fields, documents)` does: the tokenizer, the trimmer, stop
// word filter and Porter stemmer pipeline, BM25 field vectors and the
// minimized token set of every term. Then it runs the readers' searches
// through lunr's query lexer and parser (fields, wildcards, edit
// distances, boosts, + and -), expands each term against the token set,
// and scores the pages by the cosine of query and field vectors, with
// the match positions of the best page. It serializes the index to the
// JSON lunr.js reads, loads it back and runs the searches again.

const BM25_K1: f64 = 1.2;
const BM25_B: f64 = 0.75;
const STAR: i64 = 42;

// ------------------------------------------------------------ helpers

fn byte_at(s: ref String, i: i64) -> i64 {
    s.bytes().to_vec()[i] as i64
}

fn from_bytes(b: ref Vec[u8]) -> String {
    match String.from_utf8(b.clone()) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

fn ch(c: i64) -> String {
    let b: Vec[u8] = [c as u8];
    from_bytes(b)
}

fn is_word(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

// The separators of lunr's tokenizer: whitespace, no-break space, hyphen.
fn is_sep(c: i64) -> bool {
    c == 32 or (c >= 9 and c <= 13) or c == 160 or c == 45
}

// Python's repr of a float that round(x, 3) made.
fn repr3(x: f64) -> String {
    let mut s = f"{x:.3}";
    while s.ends_with("0") and not s.ends_with(".0") {
        s = s.substring(0, s.len() - 1);
    }
    s
}

fn round3(x: f64) -> f64 {
    match f64.parse(f"{x:.3}") {
        Ok(v) => v,
        Err(_) => x,
    }
}

fn json_str(s: ref String) -> String {
    let mut out = "\"".to_string();
    for c in s.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else {
            out.push(c);
        }
    }
    out.push_str("\"");
    out
}

fn unpct(s: ref String) -> String {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() as i64 {
        if b[i] == 37 {
            let h = from_bytes(b[i + 1..i + 3].to_vec());
            match i64.from_str_radix(h, 16) {
                Some(v) => out.push(v as u8),
                None => out.push(63),
            }
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    from_bytes(out)
}

fn crc_table() -> Vec[i64] {
    let mut t: Vec[i64] = Vec.new();
    for n in 0..256 {
        let mut c = n;
        for _ in 0..8 {
            c = if c & 1 == 1 { 3988292384 ^ (c >> 1) } else { c >> 1 };
        }
        t.push(c);
    }
    t
}

fn crc32(s: ref String) -> i64 {
    let t = crc_table();
    let mut c = 4294967295;
    for b in s.bytes() {
        c = t[(c ^ (b as i64)) & 255] ^ (c >> 8);
    }
    c ^ 4294967295
}

// ------------------------------------------------------------ the pipeline

struct Tok {
    text: String,
    start: i64,
    len: i64,
}

fn tokenize(text: ref String) -> Vec[Tok] {
    let s = text.to_lowercase();
    let b = s.bytes().to_vec();
    let n = b.len() as i64;
    let mut out: Vec[Tok] = Vec.new();
    let mut start = 0;
    for end in 0..n + 1 {
        if end == n or is_sep(b[end] as i64) {
            if end - start > 0 {
                out.push(Tok { text: s.substring(start, end), start: start, len: end - start });
            }
            start = end + 1;
        }
    }
    out
}

// trimmer: ^\W*?([^\W]+)\W*?$, or the token unchanged.
fn trim(s: ref String) -> String {
    let b = s.bytes().to_vec();
    let n = b.len() as i64;
    let mut i = 0;
    while i < n and not is_word(b[i] as i64) {
        i += 1;
    }
    let mut j = i;
    while j < n and is_word(b[j] as i64) {
        j += 1;
    }
    if j == i {
        return s.clone();
    }
    for k in j..n {
        if is_word(b[k] as i64) {
            return s.clone();
        }
    }
    s.substring(i, j)
}

// The Porter stemmer as lunr.py has it, Python's negative indexes and all.
struct Porter {
    b: Vec[u8],
    k: i64,
    k0: i64,
    j: i64,
}

impl Porter {
    fn at(ref self, i: i64) -> i64 {
        let n = self.b.len() as i64;
        if i < 0 { self.b[n + i] as i64 } else { self.b[i] as i64 }
    }

    fn cons(ref self, i: i64) -> bool {
        let c = self.at(i);
        if c == 97 or c == 101 or c == 105 or c == 111 or c == 117 {
            return false;
        }
        if c == 121 {
            if i == self.k0 {
                return true;
            }
            return not self.cons(i - 1);
        }
        true
    }

    fn m(ref self) -> i64 {
        let mut n = 0;
        let mut i = self.k0;
        loop {
            if i > self.j {
                return n;
            }
            if not self.cons(i) {
                break;
            }
            i += 1;
        }
        i += 1;
        loop {
            loop {
                if i > self.j {
                    return n;
                }
                if self.cons(i) {
                    break;
                }
                i += 1;
            }
            i += 1;
            n += 1;
            loop {
                if i > self.j {
                    return n;
                }
                if not self.cons(i) {
                    break;
                }
                i += 1;
            }
            i += 1;
        }
    }

    fn vowelinstem(ref self) -> bool {
        for i in self.k0..self.j + 1 {
            if not self.cons(i) {
                return true;
            }
        }
        false
    }

    fn doublec(ref self, j: i64) -> bool {
        if j < self.k0 + 1 {
            return false;
        }
        if self.at(j) != self.at(j - 1) {
            return false;
        }
        self.cons(j)
    }

    fn cvc(ref self, i: i64) -> bool {
        if i < self.k0 + 2 or not self.cons(i) or self.cons(i - 1) or not self.cons(i - 2) {
            return false;
        }
        let c = self.at(i);
        not (c == 119 or c == 120 or c == 121)
    }

    fn ends(mut ref self, s: Str) -> bool {
        let sb = s.bytes().to_vec();
        let length = sb.len() as i64;
        if sb[length - 1] as i64 != self.at(self.k) {
            return false;
        }
        if length > self.k - self.k0 + 1 {
            return false;
        }
        for t in 0..length {
            if self.b[self.k - length + 1 + t] != sb[t] {
                return false;
            }
        }
        self.j = self.k - length;
        true
    }

    fn setto(mut ref self, s: Str) {
        let sb = s.bytes().to_vec();
        let length = sb.len() as i64;
        let mut nb: Vec[u8] = Vec.new();
        for t in 0..self.j + 1 {
            nb.push(self.b[t]);
        }
        for c in sb {
            nb.push(c);
        }
        for t in self.j + length + 1..self.b.len() as i64 {
            nb.push(self.b[t]);
        }
        self.b = nb;
        self.k = self.j + length;
    }

    fn r(mut ref self, s: Str) {
        if self.m() > 0 {
            self.setto(s);
        }
    }

    fn step1ab(mut ref self) {
        if self.at(self.k) == 115 {
            if self.ends("sses") {
                self.k -= 2;
            } else if self.ends("ies") {
                self.setto("i");
            } else if self.at(self.k - 1) != 115 {
                self.k -= 1;
            }
        }
        if self.ends("eed") {
            if self.m() > 0 {
                self.k -= 1;
            }
        } else if (self.ends("ed") or self.ends("ing")) and self.vowelinstem() {
            self.k = self.j;
            if self.ends("at") {
                self.setto("ate");
            } else if self.ends("bl") {
                self.setto("ble");
            } else if self.ends("iz") {
                self.setto("ize");
            } else if self.doublec(self.k) {
                self.k -= 1;
                let c = self.at(self.k);
                if c == 108 or c == 115 or c == 122 {
                    self.k += 1;
                }
            } else if self.m() == 1 and self.cvc(self.k) {
                self.setto("e");
            }
        }
    }

    fn step1c(mut ref self) {
        if self.ends("y") and self.vowelinstem() {
            let k = self.k;
            self.b[k] = 105;
        }
    }

    fn step2(mut ref self) {
        let c = self.at(self.k - 1);
        if c == 97 {
            if self.ends("ational") { self.r("ate"); } else if self.ends("tional") { self.r("tion"); }
        } else if c == 99 {
            if self.ends("enci") { self.r("ence"); } else if self.ends("anci") { self.r("ance"); }
        } else if c == 101 {
            if self.ends("izer") { self.r("ize"); }
        } else if c == 108 {
            if self.ends("bli") {
                self.r("ble");
            } else if self.ends("alli") {
                self.r("al");
            } else if self.ends("entli") {
                self.r("ent");
            } else if self.ends("eli") {
                self.r("e");
            } else if self.ends("ousli") {
                self.r("ous");
            }
        } else if c == 111 {
            if self.ends("ization") {
                self.r("ize");
            } else if self.ends("ation") {
                self.r("ate");
            } else if self.ends("ator") {
                self.r("ate");
            }
        } else if c == 115 {
            if self.ends("alism") {
                self.r("al");
            } else if self.ends("iveness") {
                self.r("ive");
            } else if self.ends("fulness") {
                self.r("ful");
            } else if self.ends("ousness") {
                self.r("ous");
            }
        } else if c == 116 {
            if self.ends("aliti") {
                self.r("al");
            } else if self.ends("iviti") {
                self.r("ive");
            } else if self.ends("biliti") {
                self.r("ble");
            }
        } else if c == 103 {
            if self.ends("logi") { self.r("log"); }
        }
    }

    fn step3(mut ref self) {
        let c = self.at(self.k);
        if c == 101 {
            if self.ends("icate") {
                self.r("ic");
            } else if self.ends("ative") {
                self.r("");
            } else if self.ends("alize") {
                self.r("al");
            }
        } else if c == 105 {
            if self.ends("iciti") { self.r("ic"); }
        } else if c == 108 {
            if self.ends("ical") { self.r("ic"); } else if self.ends("ful") { self.r(""); }
        } else if c == 115 {
            if self.ends("ness") { self.r(""); }
        }
    }

    fn step4(mut ref self) {
        let c = self.at(self.k - 1);
        let hit = if c == 97 {
            self.ends("al")
        } else if c == 99 {
            self.ends("ance") or self.ends("ence")
        } else if c == 101 {
            self.ends("er")
        } else if c == 105 {
            self.ends("ic")
        } else if c == 108 {
            self.ends("able") or self.ends("ible")
        } else if c == 110 {
            self.ends("ant") or self.ends("ement") or self.ends("ment") or self.ends("ent")
        } else if c == 111 {
            (self.ends("ion") and (self.at(self.j) == 115 or self.at(self.j) == 116)) or self.ends("ou")
        } else if c == 115 {
            self.ends("ism")
        } else if c == 116 {
            self.ends("ate") or self.ends("iti")
        } else if c == 117 {
            self.ends("ous")
        } else if c == 118 {
            self.ends("ive")
        } else if c == 122 {
            self.ends("ize")
        } else {
            false
        };
        if hit and self.m() > 1 {
            self.k = self.j;
        }
    }

    fn step5(mut ref self) {
        self.j = self.k;
        if self.at(self.k) == 101 {
            let a = self.m();
            if a > 1 or (a == 1 and not self.cvc(self.k - 1)) {
                self.k -= 1;
            }
        }
        if self.at(self.k) == 108 and self.doublec(self.k) and self.m() > 1 {
            self.k -= 1;
        }
    }
}

fn stem(p: ref String) -> String {
    let mut st = Porter { b: p.bytes().to_vec(), k: p.len() as i64 - 1, k0: 0, j: 0 };
    if st.k <= st.k0 + 1 {
        return p.clone();
    }
    st.step1ab();
    st.step1c();
    st.step2();
    st.step3();
    st.step4();
    st.step5();
    from_bytes(st.b[0..st.k + 1].to_vec())
}

struct Term {
    text: String,
    start: i64,
    len: i64,
}

// trimmer, stop word filter, stemmer.
fn run_pipeline(toks: ref Vec[Tok], stops: ref Set[String]) -> Vec[Term] {
    let mut out: Vec[Term] = Vec.new();
    for t in toks {
        let s = trim(t.text);
        if stops.contains(s) {
            continue;
        }
        out.push(Term { text: stem(s), start: t.start, len: t.len });
    }
    out
}

// ------------------------------------------------------------ token sets

// TokenSet nodes in an arena; a node's id is its slot plus one, the
// order lunr numbers them in while one builder makes them all.
struct Ts {
    fin: Vec[bool],
    labs: Vec[Vec[i64]],
    kids: Vec[Vec[i64]],
}

fn ts_new() -> Ts {
    Ts { fin: Vec.new(), labs: Vec.new(), kids: Vec.new() }
}

fn ts_node(t: mut ref Ts) -> i64 {
    t.fin.push(false);
    t.labs.push(Vec.new());
    t.kids.push(Vec.new());
    t.fin.len() as i64 - 1
}

fn ts_get(t: ref Ts, n: i64, lab: i64) -> i64 {
    let labs = ref t.labs[n];
    for i in 0..labs.len() as i64 {
        if labs[i] == lab {
            return t.kids[n][i];
        }
    }
    -1
}

// Set an edge; an existing label keeps its place, as a dict key does.
fn ts_set(t: mut ref Ts, n: i64, lab: i64, kid: i64) {
    for i in 0..t.labs[n].len() as i64 {
        if t.labs[n][i] == lab {
            t.kids[n][i] = kid;
            return;
        }
    }
    t.labs[n].push(lab);
    t.kids[n].push(kid);
}

// str(TokenSet) with the label and the child's id kept apart, which
// lunr's key does not do (it never collides on these pages).
fn ts_key(t: ref Ts, n: i64) -> String {
    let mut order: Vec[i64] = Vec.new();
    for i in 0..t.labs[n].len() as i64 {
        order.push(i);
    }
    order.sort_by(|a, b| t.labs[n][a].cmp(t.labs[n][b]));
    let mut s = if t.fin[n] { "1".to_string() } else { "0".to_string() };
    for i in order {
        s.push_str(f"{t.labs[n][i]}:{t.kids[n][i] + 1},");
    }
    s
}

struct Unchecked {
    parent: i64,
    lab: i64,
    child: i64,
}

struct TsBuilder {
    ts: Ts,
    prev: String,
    unchecked: Vec[Unchecked],
    minimized: Map[String, i64],
}

fn new_ts_builder() -> TsBuilder {
    let mut ts = ts_new();
    ts_node(mut ts);
    TsBuilder { ts: ts, prev: String.new(), unchecked: Vec.new(), minimized: Map.new() }
}

fn tsb_minimize(tb: mut ref TsBuilder, down_to: i64) {
    let mut i = tb.unchecked.len() as i64 - 1;
    while i >= down_to {
        let parent = tb.unchecked[i].parent;
        let lab = tb.unchecked[i].lab;
        let child = tb.unchecked[i].child;
        let key = ts_key(tb.ts, child);
        let found = *tb.minimized.get(key).unwrap_or(-1);
        if found >= 0 {
            ts_set(mut tb.ts, parent, lab, found);
        } else {
            tb.minimized.insert(key, child);
        }
        tb.unchecked.pop();
        i -= 1;
    }
}

fn tsb_insert(tb: mut ref TsBuilder, word: ref String) {
    let w = word.bytes().to_vec();
    let p = tb.prev.bytes().to_vec();
    let mut common = 0;
    let lim = if w.len() < p.len() { w.len() as i64 } else { p.len() as i64 };
    for i in 0..lim {
        if w[i] != p[i] {
            break;
        }
        common += 1;
    }
    tsb_minimize(mut tb, common);
    let mut node = if tb.unchecked.len() == 0 { 0 } else { tb.unchecked[tb.unchecked.len() as i64 - 1].child };
    for i in common..w.len() as i64 {
        let next = ts_node(mut tb.ts);
        ts_set(mut tb.ts, node, w[i] as i64, next);
        tb.unchecked.push(Unchecked { parent: node, lab: w[i] as i64, child: next });
        node = next;
    }
    tb.ts.fin[node] = true;
    tb.prev = word.clone();
}

fn ts_from_string(s: ref String) -> Ts {
    let mut t = ts_new();
    let mut node = ts_node(mut t);
    let b = s.bytes().to_vec();
    let n = b.len() as i64;
    for i in 0..n {
        let fin = i == n - 1;
        let c = b[i] as i64;
        if c == STAR {
            ts_set(mut t, node, c, node);
            t.fin[node] = fin;
        } else {
            let next = ts_node(mut t);
            t.fin[next] = fin;
            ts_set(mut t, node, c, next);
            node = next;
        }
    }
    t
}

struct Frame {
    node: i64,
    edits: i64,
    s: Vec[u8],
}

// From the top of the stack down to an existing edge, or a new node.
fn edge_or_new(t: mut ref Ts, n: i64, lab: i64) -> i64 {
    let e = ts_get(t, n, lab);
    if e >= 0 {
        return e;
    }
    let k = ts_node(mut t);
    ts_set(mut t, n, lab, k);
    k
}

fn ts_from_fuzzy(s: ref String, edit_distance: i64) -> Ts {
    let mut t = ts_new();
    let root = ts_node(mut t);
    let mut stack: Vec[Frame] = Vec.new();
    stack.push(Frame { node: root, edits: edit_distance, s: s.bytes().to_vec() });
    while stack.len() > 0 {
        let fr = stack.pop().unwrap();
        let n = fr.s.len() as i64;
        if n > 0 {
            let no_edit = edge_or_new(mut t, fr.node, fr.s[0] as i64);
            if n == 1 {
                t.fin[no_edit] = true;
            }
            stack.push(Frame { node: no_edit, edits: fr.edits, s: fr.s[1..].to_vec() });
        }
        if fr.edits == 0 {
            continue;
        }
        let insertion = edge_or_new(mut t, fr.node, STAR);
        if n == 0 {
            t.fin[insertion] = true;
        }
        stack.push(Frame { node: insertion, edits: fr.edits - 1, s: fr.s.clone() });
        if n > 1 {
            stack.push(Frame { node: fr.node, edits: fr.edits - 1, s: fr.s[1..].to_vec() });
        }
        if n == 1 {
            t.fin[fr.node] = true;
        }
        if n >= 1 {
            let substitution = edge_or_new(mut t, fr.node, STAR);
            if n == 1 {
                t.fin[substitution] = true;
            }
            stack.push(Frame { node: substitution, edits: fr.edits - 1, s: fr.s[1..].to_vec() });
        }
        if fr.edits > 0 and n > 1 {
            let transpose = edge_or_new(mut t, fr.node, fr.s[1] as i64);
            let mut rest: Vec[u8] = Vec.new();
            rest.push(fr.s[0]);
            for c in fr.s[2..].to_vec() {
                rest.push(c);
            }
            stack.push(Frame { node: transpose, edits: fr.edits - 1, s: rest });
        }
    }
    t
}

struct IFrame {
    node: i64,
    q: i64,
    out: i64,
}

fn ts_intersect(a: ref Ts, q: ref Ts) -> Ts {
    let mut o = ts_new();
    let root = ts_node(mut o);
    let mut stack: Vec[IFrame] = Vec.new();
    stack.push(IFrame { node: 0, q: 0, out: root });
    while stack.len() > 0 {
        let fr = stack.pop().unwrap();
        for qi in 0..q.labs[fr.q].len() as i64 {
            let q_edge = q.labs[fr.q][qi];
            for ni in 0..a.labs[fr.node].len() as i64 {
                let n_edge = a.labs[fr.node][ni];
                if n_edge == q_edge or q_edge == STAR {
                    let node = a.kids[fr.node][ni];
                    let q_node = q.kids[fr.q][qi];
                    let fin = a.fin[node] and q.fin[q_node];
                    let mut next = ts_get(o, fr.out, n_edge);
                    if next >= 0 {
                        o.fin[next] = o.fin[next] or fin;
                    } else {
                        next = ts_node(mut o);
                        o.fin[next] = fin;
                        ts_set(mut o, fr.out, n_edge, next);
                    }
                    stack.push(IFrame { node: node, q: q_node, out: next });
                }
            }
        }
    }
    o
}

struct LFrame {
    prefix: Vec[u8],
    node: i64,
}

fn ts_to_list(t: ref Ts) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    let mut stack: Vec[LFrame] = Vec.new();
    stack.push(LFrame { prefix: Vec.new(), node: 0 });
    while stack.len() > 0 {
        let fr = stack.pop().unwrap();
        if t.fin[fr.node] {
            words.push(from_bytes(fr.prefix));
        }
        for i in 0..t.labs[fr.node].len() as i64 {
            let mut p = fr.prefix.clone();
            p.push(t.labs[fr.node][i] as u8);
            stack.push(LFrame { prefix: p, node: t.kids[fr.node][i] });
        }
    }
    words
}

// ------------------------------------------------------------ the index

struct SparseVec {
    idx: Vec[i64],
    val: Vec[f64],
}

fn new_vector() -> SparseVec {
    SparseVec { idx: Vec.new(), val: Vec.new() }
}

fn position_for(v: ref SparseVec, index: i64) -> i64 {
    let mut lo = 0;
    let mut hi = v.idx.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v.idx[mid] < index { lo = mid + 1; } else { hi = mid; }
    }
    lo
}

// upsert with a + b; insert never meets an index twice.
fn upsert(v: mut ref SparseVec, index: i64, val: f64) {
    let p = position_for(v, index);
    if p < v.idx.len() as i64 and v.idx[p] == index {
        v.val[p] = v.val[p] + val;
    } else {
        v.idx.insert(p, index);
        v.val.insert(p, val);
    }
}

fn magnitude(v: ref SparseVec) -> f64 {
    let mut sum = 0.0;
    for x in v.val {
        sum += x * x;
    }
    sum.sqrt()
}

fn similarity(q: ref SparseVec, f: ref SparseVec) -> f64 {
    let m = magnitude(q);
    if m == 0.0 or magnitude(f) == 0.0 {
        return 0.0;
    }
    let mut dot = 0.0;
    let mut i = 0;
    let mut j = 0;
    while i < q.idx.len() as i64 and j < f.idx.len() as i64 {
        if q.idx[i] < f.idx[j] {
            i += 1;
        } else if q.idx[i] > f.idx[j] {
            j += 1;
        } else {
            dot += q.val[i] * f.val[j];
            i += 1;
            j += 1;
        }
    }
    dot / m
}

// A term's posting: per field, the documents in the order they came and
// each one's token positions as start, length pairs.
struct Posting {
    index: i64,
    docs: Vec[Vec[String]],
    pos: Vec[Vec[Vec[i64]]],
    slot: Vec[Map[String, i64]],
}

fn new_posting(index: i64, nf: i64) -> Posting {
    let mut p = Posting { index: index, docs: Vec.new(), pos: Vec.new(), slot: Vec.new() };
    for _ in 0..nf {
        p.docs.push(Vec.new());
        p.pos.push(Vec.new());
        p.slot.push(Map.new());
    }
    p
}

struct Index {
    fields: Vec[String],
    boosts: Vec[i64],
    terms: Vec[String],
    term_slot: Map[String, i64],
    posts: Vec[Posting],
    fv_refs: Vec[String],
    fv: Vec[SparseVec],
    fv_slot: Map[String, i64],
    ts: Ts,
}

struct Doc {
    reference: String,
    boost: i64,
    values: Vec[String],
}

fn field_of(field_ref: ref String) -> String {
    match field_ref.split_once("/") {
        Some((f, _)) => f.to_string(),
        None => String.new(),
    }
}

fn doc_of(field_ref: ref String) -> String {
    match field_ref.split_once("/") {
        Some((_, d)) => d.to_string(),
        None => String.new(),
    }
}

fn field_index(fields: ref Vec[String], name: ref String) -> i64 {
    for i in 0..fields.len() as i64 {
        if fields[i] == name {
            return i;
        }
    }
    -1
}

fn idf(p: ref Posting, n_docs: i64) -> f64 {
    let mut with_term = 0;
    for d in p.docs {
        with_term += d.len() as i64;
    }
    let x = ((n_docs - with_term) as f64 + 0.5) / (with_term as f64 + 0.5);
    (1.0 + x.abs()).ln()
}

fn build_index(fields: ref Vec[String], boosts: ref Vec[i64], docs: ref Vec[Doc], stops: ref Set[String]) -> Index {
    let nf = fields.len() as i64;
    let mut idx = Index { fields: fields.clone(), boosts: boosts.clone(), terms: Vec.new(), term_slot: Map.new(), posts: Vec.new(), fv_refs: Vec.new(), fv: Vec.new(), fv_slot: Map.new(), ts: ts_new() };
    // field ref -> its terms in order, their counts, and its length
    let mut fr_terms: Vec[Vec[String]] = Vec.new();
    let mut fr_counts: Vec[Vec[i64]] = Vec.new();
    let mut fr_len: Vec[i64] = Vec.new();
    let mut fr_doc_boost: Vec[i64] = Vec.new();
    for d in docs {
        for f in 0..nf {
            let terms = run_pipeline(tokenize(d.values[f]), stops);
            let fref = f"{fields[f]}/{d.reference}";
            idx.fv_slot.insert(fref.clone(), idx.fv_refs.len() as i64);
            idx.fv_refs.push(fref);
            let mut tl: Vec[String] = Vec.new();
            let mut tc: Vec[i64] = Vec.new();
            let mut seen: Map[String, i64] = Map.new();
            for t in terms {
                let s = *seen.get(t.text).unwrap_or(-1);
                if s >= 0 {
                    tc[s] += 1;
                } else {
                    seen.insert(t.text.clone(), tl.len() as i64);
                    tl.push(t.text.clone());
                    tc.push(1);
                }
                let mut ti = *idx.term_slot.get(t.text).unwrap_or(-1);
                if ti < 0 {
                    ti = idx.terms.len() as i64;
                    idx.term_slot.insert(t.text.clone(), ti);
                    idx.terms.push(t.text.clone());
                    idx.posts.push(new_posting(ti, nf));
                }
                let mut ds = *idx.posts[ti].slot[f].get(d.reference).unwrap_or(-1);
                if ds < 0 {
                    ds = idx.posts[ti].docs[f].len() as i64;
                    idx.posts[ti].slot[f].insert(d.reference.clone(), ds);
                    idx.posts[ti].docs[f].push(d.reference.clone());
                    idx.posts[ti].pos[f].push(Vec.new());
                }
                idx.posts[ti].pos[f][ds].push(t.start);
                idx.posts[ti].pos[f][ds].push(t.len);
            }
            fr_len.push(terms.len() as i64);
            fr_terms.push(tl);
            fr_counts.push(tc);
            fr_doc_boost.push(d.boost);
        }
    }
    let mut sums: Vec[i64] = Vec.filled(nf, 0);
    let mut counts: Vec[i64] = Vec.filled(nf, 0);
    for r in 0..idx.fv_refs.len() as i64 {
        let f = r % nf;
        counts[f] += 1;
        sums[f] += fr_len[r];
    }
    let mut avg: Vec[f64] = Vec.new();
    for f in 0..nf {
        avg.push(sums[f] as f64 / counts[f] as f64);
    }
    let n_docs = docs.len() as i64;
    for r in 0..idx.fv_refs.len() as i64 {
        let f = r % nf;
        let mut v = new_vector();
        for k in 0..fr_terms[r].len() as i64 {
            let ti = *idx.term_slot.get(fr_terms[r][k]).unwrap_or(-1);
            let tf = fr_counts[r][k] as f64;
            let w = idf(idx.posts[ti], n_docs);
            let mut score = w * ((BM25_K1 + 1.0) * tf) / (BM25_K1 * (1.0 - BM25_B + BM25_B * (fr_len[r] as f64 / avg[f])) + tf);
            score *= boosts[f] as f64;
            score *= fr_doc_boost[r] as f64;
            upsert(mut v, idx.posts[ti].index, round3(score));
        }
        idx.fv.push(v);
    }
    let mut sorted = idx.terms.clone();
    sorted.sort();
    let mut tb = new_ts_builder();
    for t in sorted {
        tsb_insert(mut tb, t);
    }
    tsb_minimize(mut tb, 0);
    idx.ts = tb.ts;
    idx
}

// ------------------------------------------------------------ queries

const L_FIELD: i64 = 1;
const L_TERM: i64 = 2;
const L_EDIT: i64 = 3;
const L_BOOST: i64 = 4;
const L_PRESENCE: i64 = 5;
const LEX_NAMES: Array[Str, 6] = ["EOS", "FIELD", "TERM", "EDIT_DISTANCE", "BOOST", "PRESENCE"];
const OPTIONAL: i64 = 1;
const REQUIRED: i64 = 2;
const PROHIBITED: i64 = 3;

struct Lexeme {
    kind: i64,
    s: String,
}

struct Lexer {
    b: Vec[u8],
    pos: i64,
    start: i64,
    escapes: Vec[i64],
    out: Vec[Lexeme],
}

// Python's s[a:b], clamped.
fn py_slice(b: ref Vec[u8], a: i64, e: i64) -> Vec[u8] {
    let n = b.len() as i64;
    let lo = if a < 0 { 0 } else if a > n { n } else { a };
    let hi = if e < 0 { 0 } else if e > n { n } else { e };
    if lo >= hi {
        return Vec.new();
    }
    b[lo..hi].to_vec()
}

impl Lexer {
    fn next(mut ref self) -> i64 {
        if self.pos >= self.b.len() as i64 {
            return -1;
        }
        let c = self.b[self.pos] as i64;
        self.pos += 1;
        c
    }

    fn ignore(mut ref self) {
        if self.start == self.pos {
            self.pos += 1;
        }
        self.start = self.pos;
    }

    fn emit(mut ref self, kind: i64) {
        let mut s: Vec[u8] = Vec.new();
        let mut from = self.start;
        for e in self.escapes.clone() {
            for c in py_slice(self.b, from, e) {
                s.push(c);
            }
            from = e + 1;
        }
        for c in py_slice(self.b, from, self.pos) {
            s.push(c);
        }
        self.escapes = Vec.new();
        self.out.push(Lexeme { kind: kind, s: from_bytes(s) });
        self.start = self.pos;
    }

    fn digits(mut ref self) {
        let mut c = self.next();
        while c != -1 and c > 47 and c < 58 {
            c = self.next();
        }
        if c != -1 {
            self.pos -= 1;
        }
    }
}

fn lex(q: ref String) -> Vec[Lexeme] {
    let mut lx = Lexer { b: q.bytes().to_vec(), pos: 0, start: 0, escapes: Vec.new(), out: Vec.new() };
    // 0 text, 1 field, 2 term, 3 edit distance, 4 boost, 5 end
    let mut state = 0;
    while state >= 0 {
        if state == 0 {
            loop {
                let c = lx.next();
                if c == -1 {
                    state = 5;
                    break;
                }
                if c == 92 {
                    lx.escapes.push(lx.pos - 1);
                    lx.pos += 1;
                    continue;
                }
                if c == 58 {
                    state = 1;
                    break;
                }
                if c == 126 or c == 94 {
                    lx.pos -= 1;
                    if lx.pos - lx.start > 0 {
                        lx.emit(L_TERM);
                    }
                    state = if c == 126 { 3 } else { 4 };
                    break;
                }
                if (c == 43 or c == 45) and lx.pos - lx.start == 1 {
                    lx.emit(L_PRESENCE);
                    continue;
                }
                if is_sep(c) {
                    state = 2;
                    break;
                }
            }
        } else if state == 1 {
            lx.pos -= 1;
            lx.emit(L_FIELD);
            lx.ignore();
            state = 0;
        } else if state == 2 {
            if lx.pos - lx.start > 1 {
                lx.pos -= 1;
                lx.emit(L_TERM);
            }
            lx.ignore();
            state = 0;
        } else if state == 3 or state == 4 {
            lx.ignore();
            lx.digits();
            lx.emit(if state == 3 { L_EDIT } else { L_BOOST });
            state = 0;
        } else {
            if lx.pos - lx.start > 0 {
                lx.emit(L_TERM);
            }
            state = -1;
        }
    }
    lx.out
}

#[derive(Clone)]
struct Clause {
    term: String,
    fields: Vec[String],
    edit: i64,
    use_pipeline: bool,
    boost: i64,
    presence: i64,
}

fn new_clause() -> Clause {
    Clause { term: String.new(), fields: Vec.new(), edit: 0, use_pipeline: true, boost: 1, presence: OPTIONAL }
}

fn small_number(s: ref String) -> Option[i64] {
    if s.len() == 0 or s.len() > 15 {
        return None;
    }
    match i64.parse(s) {
        Ok(v) => Some(v),
        Err(_) => None,
    }
}

fn parse_query(q: ref String, all: ref Vec[String]) -> Result[Vec[Clause], String] {
    let lx = lex(q);
    let n = lx.len() as i64;
    let mut out: Vec[Clause] = Vec.new();
    let mut cur = new_clause();
    let mut i = 0;
    // 0 clause, 1 field, 2 term, 3 presence, 4 edit, 5 boost, 6 after a term
    let mut state = 0;
    loop {
        if state == 0 {
            if i >= n {
                break;
            }
            let k = lx[i].kind;
            if k == L_FIELD {
                state = 1;
            } else if k == L_TERM {
                state = 2;
            } else if k == L_PRESENCE {
                state = 3;
            } else {
                let with = if lx[i].s.len() > 0 { f"with value \"{lx[i].s}\"" } else { String.new() };
                return Err(f"Expected either a field or a term, found {LEX_NAMES[k]}{with}");
            }
        } else if state == 1 {
            let s = lx[i].s.clone();
            i += 1;
            if field_index(all, s) < 0 {
                return Err(f"Unrecognized field \"{s}\", possible fields {all.join(", ")}");
            }
            cur.fields = [s];
            if i >= n {
                return Err("Expected term, found nothing".to_string());
            }
            if lx[i].kind != L_TERM {
                return Err(f"Expected term, found {LEX_NAMES[lx[i].kind]}");
            }
            state = 2;
        } else if state == 2 {
            cur.term = lx[i].s.to_lowercase();
            if lx[i].s.contains("*") {
                cur.use_pipeline = false;
            }
            i += 1;
            state = 6;
        } else if state == 3 {
            let s = lx[i].s.clone();
            i += 1;
            cur.presence = if s == "-" { PROHIBITED } else { REQUIRED };
            if i >= n {
                return Err("Expected either a field or a term, found nothing".to_string());
            }
            let k = lx[i].kind;
            if k == L_FIELD {
                state = 1;
            } else if k == L_TERM {
                state = 2;
            } else {
                return Err("Expected either a field or a term, found PRESENCE".to_string());
            }
        } else if state == 4 or state == 5 {
            match small_number(lx[i].s) {
                Some(v) => {
                    if state == 4 { cur.edit = v; } else { cur.boost = v; }
                }
                None => {
                    return Err(if state == 4 { "Edit distance must be numeric".to_string() } else { "Boost must be numeric".to_string() });
                }
            }
            i += 1;
            state = 6;
        } else {
            if i >= n {
                if cur.fields.len() == 0 { cur.fields = all.clone(); }
                out.push(cur.clone());
                break;
            }
            let k = lx[i].kind;
            if k == L_EDIT {
                state = 4;
            } else if k == L_BOOST {
                state = 5;
            } else {
                if cur.fields.len() == 0 { cur.fields = all.clone(); }
                out.push(cur.clone());
                cur = new_clause();
                state = if k == L_TERM { 2 } else if k == L_FIELD { 1 } else { 3 };
            }
        }
    }
    Ok(out)
}

// ------------------------------------------------------------ searching

// One field ref's match data: term, field and positions, in the order
// lunr's nested dicts would hold them.
struct Md {
    terms: Vec[String],
    fields: Vec[String],
    pos: Vec[Vec[i64]],
}

fn md_add(md: mut ref Md, term: ref String, field: ref String, pos: ref Vec[i64]) {
    for i in 0..md.terms.len() as i64 {
        if md.terms[i] == term and md.fields[i] == field {
            for p in pos {
                md.pos[i].push(p);
            }
            return;
        }
    }
    md.terms.push(term.clone());
    md.fields.push(field.clone());
    md.pos.push(pos.clone());
}

struct Hit {
    reference: String,
    score: f64,
    md: Md,
    order: i64,
}

fn search(idx: ref Index, clauses: ref Vec[Clause]) -> Vec[Hit] {
    let mut hits: Vec[Hit] = Vec.new();
    if clauses.len() == 0 {
        return hits;
    }
    let nf = idx.fields.len() as i64;
    let mut qv: Vec[SparseVec] = Vec.new();
    let mut req_has: Vec[bool] = Vec.filled(nf, false);
    let mut req_all: Vec[bool] = Vec.filled(nf, false);
    let mut req: Vec[Set[String]] = Vec.new();
    let mut proh: Vec[Set[String]] = Vec.new();
    for _ in 0..nf {
        qv.push(new_vector());
        req.push(Set.new());
        proh.push(Set.new());
    }
    let mut mf_refs: Vec[String] = Vec.new();
    let mut mf: Vec[Md] = Vec.new();
    let mut mf_slot: Map[String, i64] = Map.new();
    let mut cache: Set[String] = Set.new();
    for c in clauses {
        let term = if c.use_pipeline { stem(c.term) } else { c.term.clone() };
        let mut clause_matches: Set[String] = Set.new();
        let qts = if c.edit != 0 { ts_from_fuzzy(term, c.edit) } else { ts_from_string(term) };
        let expanded = ts_to_list(ts_intersect(idx.ts, qts));
        if expanded.len() == 0 and c.presence == REQUIRED {
            for f in c.fields {
                let fi = field_index(idx.fields, f);
                req_has[fi] = true;
                req_all[fi] = true;
            }
        } else {
            for e in expanded {
                let ti = *idx.term_slot.get(e).unwrap_or(-1);
                let p = ref idx.posts[ti];
                for f in c.fields {
                    let fi = field_index(idx.fields, f);
                    if c.presence == REQUIRED {
                        for d in p.docs[fi] {
                            clause_matches.insert(d.clone());
                        }
                        if not req_has[fi] {
                            req_has[fi] = true;
                            req_all[fi] = true;
                        }
                    } else if c.presence == PROHIBITED {
                        for d in p.docs[fi] {
                            proh[fi].insert(d.clone());
                        }
                        continue;
                    }
                    upsert(mut qv[fi], p.index, c.boost as f64);
                    let tf = f"{e}/{f}";
                    if cache.contains(tf) {
                        continue;
                    }
                    for k in 0..p.docs[fi].len() as i64 {
                        let fref = f"{f}/{p.docs[fi][k]}";
                        let s = *mf_slot.get(fref).unwrap_or(-1);
                        if s < 0 {
                            mf_slot.insert(fref.clone(), mf.len() as i64);
                            mf_refs.push(fref);
                            mf.push(Md { terms: [e.clone()], fields: [f.clone()], pos: [p.pos[fi][k].clone()] });
                        } else {
                            md_add(mut mf[s], e, f, p.pos[fi][k]);
                        }
                    }
                    cache.insert(tf);
                }
            }
        }
        if c.presence == REQUIRED {
            for f in c.fields {
                let fi = field_index(idx.fields, f);
                if req_all[fi] {
                    req[fi] = clause_matches.clone();
                    req_all[fi] = false;
                } else {
                    let mut keep: Set[String] = Set.new();
                    for d in req[fi] {
                        if clause_matches.contains(d) {
                            keep.insert(d.clone());
                        }
                    }
                    req[fi] = keep;
                }
            }
        }
    }
    let mut all_complete = true;
    let mut all_req: Set[String] = Set.new();
    let mut all_proh: Set[String] = Set.new();
    for fi in 0..nf {
        if req_has[fi] {
            if all_complete {
                all_req = req[fi].clone();
                all_complete = false;
            } else {
                let mut keep: Set[String] = Set.new();
                for d in all_req {
                    if req[fi].contains(d) {
                        keep.insert(d.clone());
                    }
                }
                all_req = keep;
            }
        }
        for d in proh[fi] {
            all_proh.insert(d.clone());
        }
    }
    let mut negated = true;
    for c in clauses {
        if c.presence != PROHIBITED {
            negated = false;
        }
    }
    if negated {
        mf_refs = idx.fv_refs.clone();
        mf = Vec.new();
        for _ in mf_refs {
            mf.push(Md { terms: Vec.new(), fields: Vec.new(), pos: Vec.new() });
        }
    }
    let mut hit_slot: Map[String, i64] = Map.new();
    for r in 0..mf_refs.len() as i64 {
        let fref = mf_refs[r].clone();
        let d = doc_of(fref);
        if (not all_complete and not all_req.contains(d)) or all_proh.contains(d) {
            continue;
        }
        let fi = field_index(idx.fields, field_of(fref));
        let v = *idx.fv_slot.get(fref).unwrap_or(-1);
        let score = similarity(qv[fi], idx.fv[v]);
        let h = *hit_slot.get(d).unwrap_or(-1);
        if h >= 0 {
            hits[h].score += score;
            for k in 0..mf[r].terms.len() as i64 {
                md_add(mut hits[h].md, mf[r].terms[k], mf[r].fields[k], mf[r].pos[k]);
            }
        } else {
            hit_slot.insert(d.clone(), hits.len() as i64);
            let order = hits.len() as i64;
            hits.push(Hit { reference: d, score: score, md: Md { terms: mf[r].terms.clone(), fields: mf[r].fields.clone(), pos: mf[r].pos.clone() }, order: order });
        }
    }
    hits.sort_by(|a, b| if a.score > b.score {
        Ordering.Less
    } else if a.score < b.score {
        Ordering.Greater
    } else {
        a.order.cmp(b.order)
    });
    hits
}

fn show(n: i64, q: ref String, idx: ref Index, out: mut ref Vec[String]) {
    let clauses = match parse_query(q, idx.fields) {
        Ok(c) => c,
        Err(e) => {
            out.push(f"q{n} {json_str(q)}: error: {e}");
            return;
        }
    };
    let hits = search(idx, clauses);
    out.push(f"q{n} {json_str(q)}: {hits.len()} results");
    let top = if hits.len() < 5 { hits.len() as i64 } else { 5 };
    for i in 0..top {
        let mut terms: Vec[String] = Vec.new();
        for t in hits[i].md.terms {
            if not terms.contains(t) {
                terms.push(t.clone());
            }
        }
        terms.sort();
        out.push(f"  {hits[i].reference} {hits[i].score:.6} {terms.join(",")}");
    }
    if hits.len() > 0 {
        let md = ref hits[0].md;
        let mut terms: Vec[String] = Vec.new();
        for t in md.terms {
            if not terms.contains(t) {
                terms.push(t.clone());
            }
        }
        terms.sort();
        for t in terms {
            for k in 0..md.terms.len() as i64 {
                if md.terms[k] == t {
                    let mut ps: Vec[String] = Vec.new();
                    let mut j = 0;
                    while j + 1 < md.pos[k].len() as i64 {
                        ps.push(f"{md.pos[k][j]}+{md.pos[k][j + 1]}");
                        j += 2;
                    }
                    out.push(f"    {t} {md.fields[k]} {ps.join(" ")}");
                }
            }
        }
    }
}

// ------------------------------------------------------------ JSON

fn serialize(idx: ref Index) -> String {
    let mut s = "{\"version\": \"2.3.9\", \"fields\": [".to_string();
    let mut fs: Vec[String] = Vec.new();
    for f in idx.fields {
        fs.push(json_str(f));
    }
    s.push_str(fs.join(", "));
    s.push_str("], \"fieldVectors\": [");
    let mut vs: Vec[String] = Vec.new();
    for r in 0..idx.fv_refs.len() as i64 {
        let v = ref idx.fv[r];
        let mut el: Vec[String] = Vec.new();
        for k in 0..v.idx.len() as i64 {
            el.push(f"{v.idx[k]}");
            el.push(repr3(round3(v.val[k])));
        }
        vs.push(f"[{json_str(idx.fv_refs[r])}, [{el.join(", ")}]]");
    }
    s.push_str(vs.join(", "));
    s.push_str("], \"invertedIndex\": [");
    let mut sorted = idx.terms.clone();
    sorted.sort();
    let mut ts: Vec[String] = Vec.new();
    for t in sorted {
        let p = ref idx.posts[*idx.term_slot.get(t).unwrap_or(-1)];
        let mut parts: Vec[String] = Vec.new();
        for f in 0..idx.fields.len() as i64 {
            let mut ds: Vec[String] = Vec.new();
            for k in 0..p.docs[f].len() as i64 {
                let mut ps: Vec[String] = Vec.new();
                let mut j = 0;
                while j + 1 < p.pos[f][k].len() as i64 {
                    ps.push(f"[{p.pos[f][k][j]}, {p.pos[f][k][j + 1]}]");
                    j += 2;
                }
                ds.push(f"{json_str(p.docs[f][k])}: {{\"position\": [{ps.join(", ")}]}}");
            }
            parts.push(f"{json_str(idx.fields[f])}: {{{ds.join(", ")}}}");
        }
        parts.push(f"\"_index\": {p.index}");
        ts.push(f"[{json_str(t)}, {{{parts.join(", ")}}}]");
    }
    s.push_str(ts.join(", "));
    s.push_str("], \"pipeline\": [\"stemmer\"]}");
    s
}

#[derive(Clone)]
enum Json {
    Num(String),
    Str(String),
    Arr(Vec[Json]),
    Obj(Vec[String], Vec[Json]),
}

struct JsonReader {
    b: Vec[u8],
    i: i64,
}

impl JsonReader {
    fn skip(mut ref self) {
        while self.i < self.b.len() as i64 and (self.b[self.i] == 32 or self.b[self.i] == 10) {
            self.i += 1;
        }
    }

    fn string(mut ref self) -> String {
        self.i += 1;
        let mut out: Vec[u8] = Vec.new();
        while self.b[self.i] != 34 {
            if self.b[self.i] == 92 {
                self.i += 1;
            }
            out.push(self.b[self.i]);
            self.i += 1;
        }
        self.i += 1;
        from_bytes(out)
    }

    fn value(mut ref self) -> Json {
        self.skip();
        let c = self.b[self.i];
        if c == 34 {
            return Json.Str(self.string());
        }
        if c == 91 {
            self.i += 1;
            let mut items: Vec[Json] = Vec.new();
            self.skip();
            if self.b[self.i] == 93 {
                self.i += 1;
                return Json.Arr(items);
            }
            loop {
                items.push(self.value());
                self.skip();
                let d = self.b[self.i];
                self.i += 1;
                if d == 93 {
                    break;
                }
            }
            return Json.Arr(items);
        }
        if c == 123 {
            self.i += 1;
            let mut keys: Vec[String] = Vec.new();
            let mut vals: Vec[Json] = Vec.new();
            self.skip();
            if self.b[self.i] == 125 {
                self.i += 1;
                return Json.Obj(keys, vals);
            }
            loop {
                self.skip();
                keys.push(self.string());
                self.skip();
                self.i += 1;
                vals.push(self.value());
                self.skip();
                let d = self.b[self.i];
                self.i += 1;
                if d == 125 {
                    break;
                }
            }
            return Json.Obj(keys, vals);
        }
        let start = self.i;
        while self.i < self.b.len() as i64 and self.b[self.i] != 44 and self.b[self.i] != 93 and self.b[self.i] != 125 {
            self.i += 1;
        }
        Json.Num(from_bytes(self.b[start..self.i].to_vec()))
    }
}

fn items(j: ref Json) -> Vec[Json] {
    match j {
        Json.Arr(v) => v.clone(),
        _ => Vec.new(),
    }
}

fn text(j: ref Json) -> String {
    match j {
        Json.Str(s) => s.clone(),
        Json.Num(s) => s.clone(),
        _ => String.new(),
    }
}

fn get(j: ref Json, key: Str) -> Json {
    match j {
        Json.Obj(ks, vs) => {
            for i in 0..ks.len() as i64 {
                if ks[i] == key {
                    return vs[i].clone();
                }
            }
            Json.Arr(Vec.new())
        }
        _ => Json.Arr(Vec.new()),
    }
}

fn int_of(s: ref String) -> i64 {
    match i64.parse(s) {
        Ok(v) => v,
        Err(_) => 0,
    }
}

fn load_index(text_in: ref String) -> Index {
    let mut rd = JsonReader { b: text_in.bytes().to_vec(), i: 0 };
    let root = rd.value();
    let mut fields: Vec[String] = Vec.new();
    for f in items(get(root, "fields")) {
        fields.push(text(f));
    }
    let nf = fields.len() as i64;
    let mut idx = Index { fields: fields.clone(), boosts: Vec.filled(nf, 1), terms: Vec.new(), term_slot: Map.new(), posts: Vec.new(), fv_refs: Vec.new(), fv: Vec.new(), fv_slot: Map.new(), ts: ts_new() };
    for pair in items(get(root, "fieldVectors")) {
        let pv = items(pair);
        let r = text(pv[0]);
        let el = items(pv[1]);
        let mut v = new_vector();
        let mut k = 0;
        while k + 1 < el.len() as i64 {
            v.idx.push(int_of(text(el[k])));
            let x = match f64.parse(text(el[k + 1])) {
                Ok(x) => x,
                Err(_) => 0.0,
            };
            v.val.push(x);
            k += 2;
        }
        idx.fv_slot.insert(r.clone(), idx.fv_refs.len() as i64);
        idx.fv_refs.push(r);
        idx.fv.push(v);
    }
    let mut tb = new_ts_builder();
    for pair in items(get(root, "invertedIndex")) {
        let pv = items(pair);
        let t = text(pv[0]);
        let mut p = new_posting(int_of(text(get(pv[1], "_index"))), nf);
        for f in 0..nf {
            match get(pv[1], fields[f].as_str()) {
                Json.Obj(ds, ms) => {
                    for k in 0..ds.len() as i64 {
                        p.slot[f].insert(ds[k].clone(), k);
                        p.docs[f].push(ds[k].clone());
                        let mut flat: Vec[i64] = Vec.new();
                        for pp in items(get(ms[k], "position")) {
                            for x in items(pp) {
                                flat.push(int_of(text(x)));
                            }
                        }
                        p.pos[f].push(flat);
                    }
                }
                _ => {}
            }
        }
        tsb_insert(mut tb, t);
        idx.term_slot.insert(t.clone(), idx.terms.len() as i64);
        idx.terms.push(t);
        idx.posts.push(p);
    }
    tsb_minimize(mut tb, 0);
    idx.ts = tb.ts;
    idx
}

// ------------------------------------------------------------ the job

fn main() {
    let mut stops: Set[String] = Set.new();
    for w in stop_word_spec().split(" ") {
        stops.insert(w.to_string());
    }
    let mut docs: Vec[Doc] = Vec.new();
    for line in docs_text().lines() {
        let f: Vec[String] = line.split("|").map(|x| x.to_string()).collect();
        docs.push(Doc { reference: f[0].clone(), boost: int_of(f[1]), values: [f[2].clone(), f[3].clone(), f[4].clone()] });
    }
    let mut queries: Vec[String] = Vec.new();
    for line in queries_text().lines() {
        queries.push(unpct(line.to_string()));
    }
    let fields = ["title".to_string(), "tags".to_string(), "body".to_string()];
    let boosts = [10, 1, 1];
    let idx = build_index(fields, boosts, docs, stops);
    println(f"index: {docs.len()} pages, {idx.terms.len()} terms, {idx.fv_refs.len()} field vectors");
    let mut out: Vec[String] = Vec.new();
    for n in 0..queries.len() as i64 {
        show(n + 1, queries[n], idx, mut out);
    }
    for line in out {
        println(line);
    }
    let js = serialize(idx);
    println(f"serialized: {js.len()} bytes, crc32 {crc32(js):08x}");
    let path = "mini_lunr_index.json";
    if fs.write(path, js).is_err() {
        println("cannot write the index");
        return;
    }
    let back = match fs.read_to_string(path) {
        Ok(t) => t,
        Err(_) => String.new(),
    };
    let _ = fs.remove_file(path);
    let loaded = load_index(back);
    let mut again: Vec[String] = Vec.new();
    for n in 0..queries.len() as i64 {
        show(n + 1, queries[n], loaded, mut again);
    }
    let mut same = 0;
    for i in 0..out.len() as i64 {
        if i < again.len() as i64 and out[i] == again[i] {
            same += 1;
        }
    }
    println(f"loaded index: {same} of {out.len()} lines agree");
}

