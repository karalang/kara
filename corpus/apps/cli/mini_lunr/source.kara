fn queries_text() -> String {
    let mut s = String.new();
    s.push_str("push\npushing images\nharbor push\nimage\nimages registry\nthe\ntitle:push\nbody:retention\ntags:security\ntitle:harbor body:denied\n+push +denied\n+signing -verify\n-scan\n-scan -sign\n+mirror cache\npush^10 pull\npull^0\ntoken^2 credential\nconfig*\n*tion\nre*ion\nsign*\n*\nharb*\nconf*~1\nregstry~1\nrepositry~2\npushd~1\ntken~1\nimgaes~2\nreplcation~1\nslow pulls\nwhy are my pulls slow\ndisk full\nmanifest unknown\nx509\ntls\nmax_retries\nharbor_token\ne.g.\ndon't\nv2.4\n8443\noci\ns3\nkubernetes\nupgrade\nupgrading\nupgraded\nupgrades\nzero downtime\nrelease notes\nsbom\nsboms\nrate limits\nrate-limited\nper-project\nself-signed\nci/cd\n--force\nforce\ninsecure\nall tags\nlatest\ngarbage collection\nprune\nquota\nquotas policy\nretention policies\nwebhook event\nnotifications\nusers api\npagination\nerror codes\nunauthorized\nforbidden\ncredential helpers\nenvironment variables\nconfiguration file\ntitle:configuring\ntitle:config*\nbody:conf*\ntags:cli +title:harbor\n+tags:faq\n-tags:cli\ntags:api -body:error\n+body:verify +body:signature\n+zzzz\n+zzzz push\nzzzz\n-zzzz\npush -zzzz\na\nan image\ntitle:\nnosuchfield:push\npush~\npush^\npush^x\npush~a\n+\n-\n:push\ntitle:+push\npush title:\nfoo%5C:bar\nfoo%5C%5Cbar\npush%5C\n%5C-scan\npush  pull\n  push  \nPUSH\nPush Pull\npu*sh\np*\n*s\n~1\n^2\npush~1^5\npush^5~1\ntitle:push~1^3\n+title:pull -body:push\nsign verify signature signing\nverification\nverified\nscanning scanner\nvulnerabilities\nvulnerability report\nlinux macos windows\narchitecture\njson output\nverbose quiet\ninstall package binary\nproxy connection timeout\nretry retries retrying\nmirror~1\ncaching~2\ncach*\n*ing\n*ed\nreplicat*\nweb*\npage*\nheader headers\nrequest response\n");
    s
}

fn stop_word_spec() -> String {
    let mut s = String.new();
    s.push_str("a able about across after all almost also am among an and any are as at be because been but by can cannot could dear did do does either else ever every for from get got had has have he her hers him his how however i if in into is it its just least let like likely may me might most must my neither no nor not of off often on only or other our own rather said say says she should since so some than that the their them then there these they this tis to too twas us wants was we were what when where which while who whom why will with would yet you your");
    s
}
