[servers]

[servers.alpha]
ip = "10.0.0.1"
role = "frontend"

[servers.beta]
ip = "10.0.0.2"
role = "backend"

[numbers]
hex = 0xDEAD_BEEF
oct = 0o755
bin = 0b1101_0110
million = 1_000_000
plus = +99
minus = -17
zero = 0
floats = [+1.0, 3.1415, -0.01, 5e+22, 1e06, -2E-2, 6.626e-34, 224_617.445_991_228]
special = [inf, -inf, nan, +inf]

[strings]
escapes = "tab\\tquote\\" backslash\\\\ e-acute \\u00E9 smile \\U0001F600"
winpath = 'C:\\Users\\nodejs\\templates'
regex = '<\\i\\c*\\s*>'
lines = \"\"\"
Roses are red
Violets are blue\"\"\"
quotes = \"\"\"Here are two quotation marks: "". Simple enough.\"\"\"
five = \"\"\"""five quotes\"\"\"""
raw = '''
The first newline is
trimmed in raw strings.
   All other whitespace
   is preserved.
'''
empty = ""

[dates]
odt1 = 1979-05-27T07:32:00Z
odt2 = 1979-05-27T00:32:00.999999-07:00
odt3 = 1979-05-27 07:32:00+05:30
ldt = 1979-05-27T07:32:00.5
ld = 1979-05-27
lt = 07:32:00
lt2 = 00:32:00.999999999

[keys]
"" = "blank"
"127.0.0.1" = "localhost"
site."google.com" = true
3.14159 = "pi"
fruit.apple.color = "red"
fruit.apple.taste.sweet = true

[[fruits]]
name = "apple"

[fruits.physical]
color = "red"
shape = "round"

[[fruits.varieties]]
name = "red delicious"

[[fruits.varieties]]
name = "granny smith"

[[fruits]]
name = "banana"

[[fruits.varieties]]
name = "plantain"

[a.b.c]
deep = 1

[a]
shallow = 2

"""
}

fn bad_cases() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("duplicate key", "a = 1\nb = 2\na = 3\n"));
    v.push(("table twice", "[a]\nx = 1\n[a]\ny = 2\n"));
    v.push(("dotted, then table", "a.b = 1\n[a]\n"));
    v.push(("table, then dotted redefinition", "[x]\ny.z = 1\n[x.y]\n"));
    v.push(("header into inline table", "a = { b = 1 }\n[a.c]\n"));
    v.push(("dotted into inline table", "a = { b = 1 }\na.c = 2\n"));
    v.push(("array of tables over a static array", "fruit = []\n[[fruit]]\n"));
    v.push(("table over a value", "a = 1\n[a]\n"));
    v.push(("leading zero", "n = 012\n"));
    v.push(("double underscore", "n = 1__2\n"));
    v.push(("leading underscore", "n = _1\n"));
    v.push(("bare fraction", "f = .5\n"));
    v.push(("trailing dot", "f = 5.\n"));
    v.push(("empty exponent", "f = 1e\n"));
    v.push(("unterminated string", "s = \"abc\n"));
    v.push(("bad escape", "s = \"a\\qb\"\n"));
    v.push(("surrogate escape", "s = \"\\uD800\"\n"));
    v.push(("month 13", "d = 1979-13-27\n"));
    v.push(("february 30", "d = 2023-02-30\n"));
    v.push(("missing value", "a =\n"));
    v.push(("newline in inline table", "a = { b = 1,\n c = 2 }\n"));
    v.push(("trailing comma in inline table", "a = { b = 1, }\n"));
    v.push(("key without value", "[t]\nkey\n"));
    v.push(("two values on a line", "a = 1 b = 2\n"));
    v.push(("unclosed array", "a = [1, 2\n"));
    v.push(("hex overflow", "n = 0x8000_0000_0000_0000\n"));
    v.push(("dotted into a value", "a = 1\na.b = 2\n"));
    v
}

fn main() {
    let names: Array[Str, 3] = ["Cargo.toml", "pyproject.toml", "tour.toml"];
    let texts: Array[String, 3] = [cargo_toml(), pyproject_toml(), tour_toml()];
    let bad = bad_cases();
    match fs.create_dir_all("conf".to_string()) {
        Ok(_) => {}
        Err(e) => {
            println(f"cannot create conf: {e}");
            return;
        }
    }
    for i in 0..3 {
        fs.write(f"conf/{names[i]}", texts[i].clone()).unwrap();
    }
    for i in 0..bad.len() {
        fs.write(f"conf/bad-{i:02}.toml", bad[i].1.clone()).unwrap();
    }
    let mut listing = match fs.read_dir("conf".to_string()) {
        Ok(v) => v,
        Err(e) => {
            println(f"cannot list conf: {e}");
            return;
        }
    };
    listing.sort();
    for name in listing.iter() {
        let src = match fs.read_to_string(f"conf/{name}") {
            Ok(s) => s,
            Err(e) => {
                println(f"== {name}: cannot read: {e}");
                continue;
            }
        };
        if name.starts_with("bad-") {
            let label = bad[digits_value(name, 4, 6)].0.clone();
            match parse(src) {
                Ok(_) => println(f"== {name} ({label}): ACCEPTED"),
                Err(e) => println(f"== {name} ({label}): {e}"),
            }
            continue;
        }
        match parse(src) {
            Ok(doc) => {
                let lines = render(doc);
                println(f"== {name}: {src.len()} bytes, {lines.len()} leaves");
                for ln in lines.iter() {
                    println(f"  {ln}");
                }
            }
            Err(e) => println(f"== {name}: {e}"),
        }
    }
}
