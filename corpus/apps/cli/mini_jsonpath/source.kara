// mini_jsonpath: jsonpath-ng 1.7.0 (with its ext package), the JSONPath
// library Python tools use to pull values out of JSON, and to change
// them: find, update, update_or_create, find_or_create and filter, over
// the base grammar (jsonpath_ng.parse) and the extended one
// (jsonpath_ng.ext.parse) with its filters, sorting, arithmetic and
// named operators, and the jsonpath command line.
//
// The lexer follows PLY's: the rules in the order PLY tries them, the
// quoted states, and the literal characters. The parser is PLY's LALR
// driver run over the tables PLY builds for the two grammars (the
// generated section at the end), so the precedence, the conflicts PLY
// resolves and the token an error is reported at are PLY's.
//
// Like Python, the documents are objects that several paths can reach:
// update and filter change them in place, and a datum's value can be
// swapped out under it. jsonpath-ng's quirks are kept, since its users
// meet them: `foo.bar | foo.baz` groups as foo.(bar | foo).baz, `true`
// at the start of a field name lexes as a boolean in the ext grammar,
// `/` is always a sort direction there, and an escape in a backquoted
// operator drops its backslash.
//
// Python's re module is mini_re's port; it runs the `=~` filter, `sub`,
// and the patterns ext uses to read `split(...)` and `sub(...)`.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = *g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if *g == 0 { (m.start, m.end) } else { m.spans[*g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}

// ------------------------------------------------------------ Python values

// The JSON a job loads, and every value jsonpath-ng makes from it, live
// in one heap and refer to each other by index, so that a list or dict
// two paths reach is the same object to both: update and filter change
// the document in place, the way Python does.
enum Obj {
    Nil,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    List(Vec[i64]),
    Dict(Vec[(i64, i64)]),
    // the key update_or_create files a new list under (LIST_KEY)
    ListKey,
}

// A Python exception: its class name and message.
struct PyErr {
    kind: String,
    msg: String,
}

fn pyerr(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn type_error(msg: own String) -> PyErr {
    pyerr("TypeError", msg)
}

fn not_implemented() -> PyErr {
    pyerr("NotImplementedError", String.new())
}

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

// repr(x) of a float
fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    let t = x as i64;
    if (t as f64) == x and x < 1.0e16 and x > -1.0e16 {
        if t == 0 and 1.0 / x < 0.0 {
            return "-0.0".to_string();
        }
        return f"{t}.0";
    }
    f"{x}"
}

fn py_strip(s: ref String) -> String {
    let c = cps(s);
    let mut a = 0;
    let mut b = c.len();
    while a < b and is_space(c[a], false) {
        a += 1;
    }
    while b > a and is_space(c[b - 1], false) {
        b -= 1;
    }
    to_string(slice(c, a, b))
}

// int(s): an optional sign and decimal digits, with whitespace around
// and single underscores between digits.
fn py_int_str(s: ref String) -> Option[i64] {
    let c0 = cps(py_strip(s));
    let mut neg = false;
    let mut i = 0;
    if c0.len() > 0 and (c0[0] == 43 or c0[0] == 45) {
        neg = c0[0] == 45;
        i = 1;
    }
    if i >= c0.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < c0.len() {
        let c = c0[i];
        if c == 95 {
            if not prev_digit or i + 1 >= c0.len() or not (c0[i + 1] >= 48 and c0[i + 1] <= 57) {
                return None;
            }
            prev_digit = false;
        } else if c >= 48 and c <= 57 {
            n = n * 10 + (c - 48);
            prev_digit = true;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -n } else { n })
}

// The documents a job reads, written into the heap.
struct JsonReader {
    cs: Vec[i64],
    pos: i64,
}

impl JsonReader {
    fn peek(ref self) -> i64 {
        if self.pos < self.cs.len() { self.cs[self.pos] } else { -1 }
    }

    fn ws(mut ref self) {
        while self.peek() == 32 or self.peek() == 10 or self.peek() == 9 or self.peek() == 13 {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let ws = cps(w.to_string());
        for k in 0..ws.len() {
            if self.pos + k >= self.cs.len() or self.cs[self.pos + k] != ws[k] {
                return false;
            }
        }
        self.pos += ws.len();
        true
    }

    fn hex4(mut ref self) -> i64 {
        let mut v = 0;
        for _ in 0..4 {
            let c = self.cs[self.pos];
            self.pos += 1;
            let d = if c >= 48 and c <= 57 { c - 48 } else if c >= 97 and c <= 102 { c - 87 } else { c - 55 };
            v = v * 16 + d;
        }
        v
    }

    fn string(mut ref self) -> String {
        self.pos += 1;
        let mut out: Vec[i64] = Vec.new();
        while self.cs[self.pos] != 34 {
            let c = self.cs[self.pos];
            self.pos += 1;
            if c != 92 {
                out.push(c);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 110 {
                out.push(10);
            } else if e == 116 {
                out.push(9);
            } else if e == 114 {
                out.push(13);
            } else if e == 98 {
                out.push(8);
            } else if e == 102 {
                out.push(12);
            } else if e == 117 {
                let mut cp = self.hex4();
                if cp >= 0xD800 and cp < 0xDC00 and self.peek() == 92 {
                    self.pos += 2;
                    let lo = self.hex4();
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                }
                out.push(cp);
            } else {
                out.push(e);
            }
        }
        self.pos += 1;
        to_string(out)
    }

    fn number(mut ref self) -> Obj {
        let start = self.pos;
        let mut float = false;
        while self.pos < self.cs.len() {
            let c = self.cs[self.pos];
            if c == 46 or c == 101 or c == 69 {
                float = true;
            } else if not (c == 45 or c == 43 or (c >= 48 and c <= 57)) {
                break;
            }
            self.pos += 1;
        }
        let t = to_string(slice(self.cs, start, self.pos));
        if float {
            Obj.Float(f64.parse(t).unwrap_or(0.0))
        } else {
            Obj.Int(i64.parse(t).unwrap_or(0))
        }
    }

    fn value(mut ref self, w: mut ref W) -> i64 {
        self.ws();
        let c = self.peek();
        if c == 123 {
            self.pos += 1;
            let mut d: Vec[(i64, i64)] = Vec.new();
            self.ws();
            if self.peek() == 125 {
                self.pos += 1;
                return w.alloc(Obj.Dict(d));
            }
            loop {
                self.ws();
                let k = w.alloc(Obj.Str(self.string()));
                self.ws();
                self.pos += 1;
                let v = self.value(mut w);
                w.dict_put(mut d, k, v);
                self.ws();
                let sep = self.peek();
                self.pos += 1;
                if sep == 125 {
                    break;
                }
            }
            w.alloc(Obj.Dict(d))
        } else if c == 91 {
            self.pos += 1;
            let mut xs: Vec[i64] = Vec.new();
            self.ws();
            if self.peek() == 93 {
                self.pos += 1;
                return w.alloc(Obj.List(xs));
            }
            loop {
                xs.push(self.value(mut w));
                self.ws();
                let sep = self.peek();
                self.pos += 1;
                if sep == 93 {
                    break;
                }
            }
            w.alloc(Obj.List(xs))
        } else if c == 34 {
            let s = self.string();
            w.alloc(Obj.Str(s))
        } else if self.word("null") {
            w.alloc(Obj.Nil)
        } else if self.word("true") {
            w.alloc(Obj.Bool(true))
        } else if self.word("false") {
            w.alloc(Obj.Bool(false))
        } else {
            let n = self.number();
            w.alloc(n)
        }
    }
}

impl W {
    fn alloc(mut ref self, o: own Obj) -> i64 {
        self.objs.push(o);
        self.objs.len() - 1
    }

    fn load_json(mut ref self, text: ref String) -> i64 {
        let mut r = JsonReader { cs: cps(text), pos: 0 };
        r.value(mut self)
    }

    fn type_name(ref self, id: i64) -> String {
        match self.objs[id] {
            Obj.Nil => "NoneType".to_string(),
            Obj.Bool(_) => "bool".to_string(),
            Obj.Int(_) => "int".to_string(),
            Obj.Float(_) => "float".to_string(),
            Obj.Str(_) => "str".to_string(),
            Obj.List(_) => "list".to_string(),
            Obj.Dict(_) => "dict".to_string(),
            Obj.ListKey => "object".to_string(),
        }
    }

    fn is_nil(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.Nil => true,
            _ => false,
        }
    }

    fn is_bool(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.Bool(_) => true,
            _ => false,
        }
    }

    // isinstance(x, int), which bools are too
    fn is_int(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.Bool(_) => true,
            Obj.Int(_) => true,
            _ => false,
        }
    }

    fn is_str(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.Str(_) => true,
            _ => false,
        }
    }

    fn is_list(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.List(_) => true,
            _ => false,
        }
    }

    fn is_dict(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.Dict(_) => true,
            _ => false,
        }
    }

    fn str_of(ref self, id: i64) -> String {
        match self.objs[id] {
            Obj.Str(s) => s.clone(),
            _ => String.new(),
        }
    }

    fn items(ref self, id: i64) -> Vec[i64] {
        match self.objs[id] {
            Obj.List(xs) => xs.clone(),
            _ => Vec.new(),
        }
    }

    fn entries(ref self, id: i64) -> Vec[(i64, i64)] {
        match self.objs[id] {
            Obj.Dict(d) => d.clone(),
            _ => Vec.new(),
        }
    }

    fn keys(ref self, id: i64) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for (k, _) in self.entries(id) {
            out.push(k);
        }
        out
    }

    fn values(ref self, id: i64) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for (_, v) in self.entries(id) {
            out.push(v);
        }
        out
    }

    fn set_items(mut ref self, id: i64, xs: own Vec[i64]) {
        self.objs[id] = Obj.List(xs);
    }

    fn set_entries(mut ref self, id: i64, d: own Vec[(i64, i64)]) {
        self.objs[id] = Obj.Dict(d);
    }

    // the number a bool, int or float stands for
    fn num(ref self, id: i64) -> Option[f64] {
        match self.objs[id] {
            Obj.Bool(b) => Some(if *b { 1.0 } else { 0.0 }),
            Obj.Int(n) => Some(*n as f64),
            Obj.Float(x) => Some(*x),
            _ => None,
        }
    }

    fn int_val(ref self, id: i64) -> Option[i64] {
        match self.objs[id] {
            Obj.Bool(b) => Some(if *b { 1 } else { 0 }),
            Obj.Int(n) => Some(*n),
            _ => None,
        }
    }

    fn is_float(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.Float(_) => true,
            _ => false,
        }
    }

    fn truthy(ref self, id: i64) -> bool {
        match self.objs[id] {
            Obj.Nil => false,
            Obj.Bool(b) => *b,
            Obj.Int(n) => *n != 0,
            Obj.Float(x) => *x != 0.0,
            Obj.Str(s) => s.len() > 0,
            Obj.List(xs) => xs.len() > 0,
            Obj.Dict(d) => d.len() > 0,
            Obj.ListKey => true,
        }
    }

    fn len_of(ref self, id: i64) -> Result[i64, PyErr] {
        match self.objs[id] {
            Obj.Str(s) => Ok(cps(s).len()),
            Obj.List(xs) => Ok(xs.len()),
            Obj.Dict(d) => Ok(d.len()),
            _ => Err(type_error(f"object of type '{self.type_name(id)}' has no len()")),
        }
    }

    fn eq(ref self, a: i64, b: i64) -> bool {
        if a == b {
            return true;
        }
        if let Some(x) = self.num(a) {
            if let Some(y) = self.num(b) {
                return x == y;
            }
            return false;
        }
        match self.objs[a] {
            Obj.Nil => self.is_nil(b),
            Obj.Str(s) => {
                match self.objs[b] {
                    Obj.Str(t) => s == t,
                    _ => false,
                }
            }
            Obj.List(xs) => {
                let ys = self.items(b);
                if not self.is_list(b) or xs.len() != ys.len() {
                    return false;
                }
                for i in 0..xs.len() {
                    if not self.eq(xs[i], ys[i]) {
                        return false;
                    }
                }
                true
            }
            Obj.Dict(d) => {
                if not self.is_dict(b) {
                    return false;
                }
                let e = self.entries(b);
                if d.len() != e.len() {
                    return false;
                }
                for (k, v) in d.iter() {
                    let i = self.dict_find(e, *k);
                    if i < 0 or not self.eq(*v, e[i].1) {
                        return false;
                    }
                }
                true
            }
            _ => false,
        }
    }

    fn dict_find(ref self, d: ref Vec[(i64, i64)], k: i64) -> i64 {
        for i in 0..d.len() {
            if self.eq(d[i].0, k) {
                return i;
            }
        }
        -1
    }

    fn dict_put(ref self, d: mut ref Vec[(i64, i64)], k: i64, v: i64) {
        let i = self.dict_find(d, k);
        if i >= 0 {
            d[i] = (d[i].0, v);
        } else {
            d.push((k, v));
        }
    }

    // a < b and the other orderings, with Python's TypeError when the
    // two cannot be ordered
    fn order(ref self, a: i64, b: i64, op: Str) -> Result[bool, PyErr] {
        if let Some(x) = self.num(a) {
            if let Some(y) = self.num(b) {
                return Ok(cmp_holds(if x < y { -1 } else if x > y { 1 } else { 0 }, op));
            }
        }
        if self.is_str(a) and self.is_str(b) {
            let s = self.str_of(a);
            let t = self.str_of(b);
            return Ok(cmp_holds(if s < t { -1 } else if s > t { 1 } else { 0 }, op));
        }
        if self.is_list(a) and self.is_list(b) {
            let xs = self.items(a);
            let ys = self.items(b);
            let mut i = 0;
            while i < xs.len() and i < ys.len() {
                if not self.eq(xs[i], ys[i]) {
                    return self.order(xs[i], ys[i], op);
                }
                i += 1;
            }
            let c = if xs.len() < ys.len() { -1 } else if xs.len() > ys.len() { 1 } else { 0 };
            return Ok(cmp_holds(c, op));
        }
        Err(type_error(f"'{op}' not supported between instances of '{self.type_name(a)}' and '{self.type_name(b)}'"))
    }

    fn repr(ref self, id: i64) -> String {
        match self.objs[id] {
            Obj.Nil => "None".to_string(),
            Obj.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
            Obj.Int(n) => f"{n}",
            Obj.Float(x) => float_repr(*x),
            Obj.Str(s) => repr_of(cps(s)),
            Obj.List(xs) => {
                let mut parts: Vec[String] = Vec.new();
                for x in xs.iter() {
                    parts.push(self.repr(*x));
                }
                f"[{join(parts, ", ")}]"
            }
            Obj.Dict(d) => {
                let mut parts: Vec[String] = Vec.new();
                for (k, v) in d.iter() {
                    parts.push(f"{self.repr(*k)}: {self.repr(*v)}");
                }
                f"{{{join(parts, ", ")}}}"
            }
            Obj.ListKey => "LIST_KEY".to_string(),
        }
    }

    // str(x)
    fn pstr(ref self, id: i64) -> String {
        match self.objs[id] {
            Obj.Str(s) => s.clone(),
            _ => self.repr(id),
        }
    }
}

fn cmp_holds(c: i64, op: Str) -> bool {
    if op == "<" {
        c < 0
    } else if op == "<=" {
        c <= 0
    } else if op == ">" {
        c > 0
    } else {
        c >= 0
    }
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}
// ------------------------------------------------------------ the syntax tree

// jsonpath-ng's JSONPath classes. Like the documents, the nodes live in
// one arena, since the library builds new ones while it finds (a Fields
// or Index for every step it takes) and filter rewrites an Index in
// place.
#[derive(Clone)]
enum Pn {
    Root,
    This,
    Parent,
    Child(i64, i64),
    Descendants(i64, i64),
    Where(i64, i64),
    WhereNot(i64, i64),
    Union(i64, i64),
    Intersect(i64, i64),
    // the field names, as values in the heap
    Fields(Vec[i64]),
    // the index, as a value in the heap
    Index(i64),
    // start, end and step, as values in the heap (None when absent)
    Slice(i64, i64, i64),
    // the ext classes
    Filter(Vec[i64]),
    // target, operator ("" for none) and value (-1 for none)
    Expression(i64, String, i64),
    Operation(Opnd, String, Opnd),
    // SortedThis: whether it has expressions, and (field, reverse) pairs
    Sorted(bool, Vec[(i64, bool)]),
    Len,
    Keys,
    Path,
    // compiled regex (an index into W.progs), expr, repl, method
    Sub(i64, String, String, String),
    // chars, segment, max_split, method
    Split(String, String, i64, String),
    StrOp(String),
}

// Operation's operands: a path, or a value given in the expression
#[derive(Clone)]
enum Opnd {
    Node(i64),
    Lit(i64),
}

// DatumInContext: a value, the path to it from its context, and the
// context (-1 for none).
struct Dat {
    value: i64,
    path: i64,
    context: i64,
}

// PLY's parse tables for one grammar
#[derive(Clone)]
struct Tables {
    prods: Vec[(String, i64, String)],
    actions: Vec[Vec[(String, i64)]],
    gotos: Vec[Vec[(String, i64)]],
    defaulted: Vec[i64],
    has_default: Vec[bool],
}

struct W {
    objs: Vec[Obj],
    pns: Vec[Pn],
    dats: Vec[Dat],
    progs: Vec[Program],
    base: Tables,
    ext: Tables,
    sub_prog: Program,
    split_prog: Program,
    str_prog: Program,
}

fn ensure_row(rows: mut ref Vec[Vec[(String, i64)]], st: i64) {
    while rows.len() <= st {
        rows.push(Vec.new());
    }
}

fn read_tables(text: ref String) -> Tables {
    let mut t = Tables { prods: Vec.new(), actions: Vec.new(), gotos: Vec.new(), defaulted: Vec.new(), has_default: Vec.new() };
    for line in text.split("\n") {
        let parts: Vec[String] = line.split(" ").map(|p| p.to_string()).collect();
        if parts.len() < 2 {
            continue;
        }
        if parts[0] == "P" {
            t.prods.push((parts[1].clone(), i64.parse(parts[2]).unwrap_or(0), parts[3].clone()));
            continue;
        }
        let st = i64.parse(parts[1]).unwrap_or(0);
        if parts[0] == "D" {
            while t.defaulted.len() <= st {
                t.defaulted.push(0);
                t.has_default.push(false);
            }
            t.defaulted[st] = i64.parse(parts[2]).unwrap_or(0);
            t.has_default[st] = true;
            continue;
        }
        let mut row: Vec[(String, i64)] = Vec.new();
        for k in 2..parts.len() {
            let item = cps(parts[k]);
            let mut eq = item.len() - 1;
            while eq > 0 and item[eq] != 61 {
                eq -= 1;
            }
            let name = to_string(slice(item, 0, eq));
            let n = i64.parse(to_string(slice(item, eq + 1, item.len()))).unwrap_or(0);
            row.push((name, n));
        }
        if parts[0] == "A" {
            ensure_row(mut t.actions, st);
            t.actions[st] = row;
        } else {
            ensure_row(mut t.gotos, st);
            t.gotos[st] = row;
        }
    }
    while t.has_default.len() < t.actions.len() {
        t.defaulted.push(0);
        t.has_default.push(false);
    }
    t
}

fn lookup(row: ref Vec[(String, i64)], name: ref String) -> Option[i64] {
    for (k, v) in row.iter() {
        if k == name {
            return Some(*v);
        }
    }
    None
}

fn must_compile(pattern: Str) -> Program {
    match compile(cps(pattern.to_string()), 0) {
        Ok(p) => p,
        Err(_) => compile(Vec.new(), 0).unwrap(),
    }
}

// ------------------------------------------------------------ the lexer

// a symbol's value on PLY's stacks
#[derive(Clone)]
enum Sym {
    None,
    Int(i64),
    Float(f64),
    Bool(bool),
    Str(String),
    Node(i64),
    Names(Vec[String]),
    Exprs(Vec[i64]),
    Sorts(Vec[(i64, bool)]),
    Sort(i64, bool),
}

struct Tok {
    ty: String,
    val: Sym,
    lineno: i64,
    lexpos: i64,
    col: i64,
}

fn lexer_error(msg: own String) -> PyErr {
    pyerr("JsonPathLexerError", msg)
}

fn parser_error(msg: own String) -> PyErr {
    pyerr("JsonPathParserError", msg)
}

// The literal characters each lexer has (jsonpath_ng.lexer and
// jsonpath_ng.ext.parser).
const BASE_LITERALS: Str = "*.[]()$,:|&~";
const EXT_LITERALS: Str = "*.[]()$,:|&~?@+*/-";

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn is_alpha_(c: i64) -> bool {
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
}

fn is_id_rest(c: i64) -> bool {
    is_alpha_(c) or is_digit(c) or c == 64 or c == 45
}

// What one of PLY's rules does at a position: give a token, move on
// without one, or not match.
enum Step {
    Give(Tok),
    Skip,
    NoMatch,
}

struct Lexer {
    cs: Vec[i64],
    pos: i64,
    lineno: i64,
    latest_newline: i64,
    state: String,
    stack: Vec[String],
    string_value: Option[Vec[i64]],
    ext: bool,
}

impl Lexer {
    fn at(ref self, i: i64) -> i64 {
        if i < self.cs.len() { self.cs[i] } else { -1 }
    }

    fn tok(ref self, ty: Str, val: own Sym, start: i64) -> Tok {
        Tok { ty: ty.to_string(), val: val, lineno: self.lineno, lexpos: start, col: 0 }
    }

    fn text(ref self, a: i64, b: i64) -> String {
        to_string(slice(self.cs, a, b))
    }

    fn digits_end(ref self, i: i64) -> i64 {
        let mut j = i;
        while is_digit(self.at(j)) {
            j += 1;
        }
        j
    }

    // -?\d+, or -1
    fn number_end(ref self, i: i64) -> i64 {
        let j = if self.at(i) == 45 { i + 1 } else { i };
        let k = self.digits_end(j);
        if k == j { -1 } else { k }
    }

    fn id_end(ref self, i: i64) -> i64 {
        let mut j = i;
        if self.ext {
            if self.at(j) == 64 and is_alpha_(self.at(j + 1)) {
                j += 1;
            }
            if not is_alpha_(self.at(j)) {
                return -1;
            }
        } else if not (is_alpha_(self.at(j)) or self.at(j) == 64) {
            return -1;
        }
        j += 1;
        while is_id_rest(self.at(j)) {
            j += 1;
        }
        j
    }

    fn word_at(ref self, i: i64, w: Str) -> bool {
        let ws = cps(w.to_string());
        for k in 0..ws.len() {
            if self.at(i + k) != ws[k] {
                return false;
            }
        }
        true
    }

    fn open(mut ref self, state: Str) {
        self.string_value = Some(Vec.new());
        self.stack.push(self.state.clone());
        self.state = state.to_string();
    }

    fn add(mut ref self, c: i64) {
        if let Some(v) = self.string_value.clone() {
            let mut w = v;
            w.push(c);
            self.string_value = Some(w);
        }
    }

    fn close(mut ref self, ty: Str, start: i64) -> Tok {
        let v = match self.string_value.clone() {
            Some(v) => v,
            None => Vec.new(),
        };
        self.string_value = None;
        self.state = match self.stack.pop() {
            Some(s) => s,
            None => "INITIAL".to_string(),
        };
        self.tok(ty, Sym.Str(to_string(v)), start)
    }

    // the INITIAL state's rules, in the order PLY tries them
    fn initial(mut ref self, i: i64) -> Step {
        let c = self.at(i);
        if self.ext {
            if self.word_at(i, "true") {
                self.pos = i + 4;
                return Step.Give(self.tok("BOOL", Sym.Bool(true), i));
            }
            if self.word_at(i, "false") {
                self.pos = i + 5;
                return Step.Give(self.tok("BOOL", Sym.Bool(false), i));
            }
            // ,?\s*(/|\\)
            let mut j = if c == 44 { i + 1 } else { i };
            while is_space(self.at(j), false) {
                j += 1;
            }
            if self.at(j) == 47 or self.at(j) == 92 {
                self.pos = j + 1;
                return Step.Give(self.tok("SORT_DIRECTION", Sym.Str(self.text(j, j + 1)), i));
            }
        }
        let e = self.id_end(i);
        if e >= 0 {
            let v = self.text(i, e);
            let ty = if v == "where" { "WHERE" } else if v == "wherenot" { "WHERENOT" } else { "ID" };
            self.pos = e;
            return Step.Give(self.tok(ty, Sym.Str(v), i));
        }
        if self.ext {
            let k = self.number_end(i);
            if k >= 0 and self.at(k) == 46 {
                let f = self.digits_end(k + 1);
                if f > k + 1 {
                    self.pos = f;
                    return Step.Give(self.tok("FLOAT", Sym.Float(f64.parse(self.text(i, f)).unwrap_or(0.0)), i));
                }
            }
        }
        let k = self.number_end(i);
        if k >= 0 {
            self.pos = k;
            return Step.Give(self.tok("NUMBER", Sym.Int(i64.parse(self.text(i, k)).unwrap_or(0)), i));
        }
        if c == 39 {
            self.pos = i + 1;
            self.open("singlequote");
            return Step.Skip;
        }
        if c == 34 {
            self.pos = i + 1;
            self.open("doublequote");
            return Step.Skip;
        }
        if c == 96 {
            self.pos = i + 1;
            self.open("backquote");
            return Step.Skip;
        }
        if c == 10 {
            self.pos = i + 1;
            self.lineno += 1;
            self.latest_newline = i;
            return Step.Skip;
        }
        if self.ext {
            let ops: Array[Str, 8] = ["=~", "==", "=", "<=", ">=", "!=", "<", ">"];
            for op in ops {
                if self.word_at(i, op) {
                    let n = cps(op.to_string()).len();
                    self.pos = i + n;
                    return Step.Give(self.tok("FILTER_OP", Sym.Str(op.to_string()), i));
                }
            }
        }
        if self.word_at(i, "..") {
            self.pos = i + 2;
            return Step.Give(self.tok("DOUBLEDOT", Sym.Str("..".to_string()), i));
        }
        Step.NoMatch
    }

    // the rules of the three quoted states
    fn quoted(mut ref self, i: i64) -> Step {
        let q = if self.state == "singlequote" { 39 } else if self.state == "doublequote" { 34 } else { 96 };
        let c = self.at(i);
        if c == 92 and self.at(i + 1) >= 0 and self.at(i + 1) != 10 {
            self.add(self.at(i + 1));
            self.pos = i + 2;
            return Step.Skip;
        }
        if c != q and c != 92 {
            let mut j = i;
            while j < self.cs.len() and self.cs[j] != q and self.cs[j] != 92 {
                self.add(self.cs[j]);
                j += 1;
            }
            self.pos = j;
            return Step.Skip;
        }
        if c == q {
            self.pos = i + 1;
            let ty = if q == 96 { "NAMED_OPERATOR" } else { "ID" };
            return Step.Give(self.close(ty, i));
        }
        Step.NoMatch
    }

    // ply.lex's token()
    fn ply_token(mut ref self) -> Result[Option[Tok], PyErr] {
        while self.pos < self.cs.len() {
            let i = self.pos;
            let c = self.cs[i];
            if self.state == "INITIAL" and (c == 32 or c == 9) {
                self.pos += 1;
                continue;
            }
            let step = if self.state == "INITIAL" { self.initial(i) } else { self.quoted(i) };
            match step {
                Step.Give(t) => return Ok(Some(t)),
                Step.Skip => continue,
                Step.NoMatch => {}
            }
            let lits = cps((if self.ext { EXT_LITERALS } else { BASE_LITERALS }).to_string());
            for l in lits {
                if l == c {
                    self.pos = i + 1;
                    let s = to_string(vec_of(c));
                    return Ok(Some(Tok { ty: s.clone(), val: Sym.Str(s), lineno: self.lineno, lexpos: i, col: 0 }));
                }
            }
            let what = if self.state == "singlequote" {
                " while lexing singlequoted field"
            } else if self.state == "doublequote" {
                " while lexing doublequoted field"
            } else if self.state == "backquote" {
                " while lexing backquoted operator"
            } else {
                ""
            };
            let ch = to_string(vec_of(c));
            return Err(lexer_error(f"Error on line {self.lineno}, col {i - self.latest_newline}{what}: Unexpected character: {ch} "));
        }
        Ok(None)
    }

    // JsonPathLexer.tokenize's next token
    fn next_token(mut ref self) -> Result[Option[Tok], PyErr] {
        match self.ply_token()? {
            Some(t) => {
                let mut t2 = t;
                t2.col = t2.lexpos - self.latest_newline;
                Ok(Some(t2))
            }
            None => {
                if self.string_value.is_some() {
                    return Err(lexer_error("Unexpected EOF in string literal or identifier".to_string()));
                }
                Ok(None)
            }
        }
    }
}

// '%s' % value, for a token's value
fn sv_text(v: ref Sym) -> String {
    match v {
        Sym.Int(n) => f"{n}",
        Sym.Float(x) => float_repr(*x),
        Sym.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Sym.Str(s) => s.clone(),
        _ => "None".to_string(),
    }
}

// ------------------------------------------------------------ the parser

impl W {
    fn node(mut ref self, n: own Pn) -> i64 {
        self.pns.push(n);
        self.pns.len() - 1
    }

    fn str_obj(mut ref self, s: ref String) -> i64 {
        self.alloc(Obj.Str(s.clone()))
    }

    fn fields_node(mut ref self, names: ref Vec[String]) -> i64 {
        let mut ids: Vec[i64] = Vec.new();
        for n in names.iter() {
            ids.push(self.str_obj(n));
        }
        self.node(Pn.Fields(ids))
    }

    fn opt_int(mut ref self, v: ref Sym) -> i64 {
        match v {
            Sym.Int(n) => self.alloc(Obj.Int(*n)),
            _ => self.alloc(Obj.Nil),
        }
    }

    fn lit_obj(mut ref self, v: ref Sym) -> i64 {
        match v {
            Sym.Int(n) => self.alloc(Obj.Int(*n)),
            Sym.Float(x) => self.alloc(Obj.Float(*x)),
            Sym.Bool(b) => self.alloc(Obj.Bool(*b)),
            Sym.Str(s) => self.alloc(Obj.Str(s.clone())),
            _ => self.alloc(Obj.Nil),
        }
    }

    // The jsonpath an Operation operand stands for, with a one-field
    // Fields taken as the string it names.
    fn operand(mut ref self, v: ref Sym) -> Opnd {
        if let Sym.Node(n) = v {
            if let Pn.Fields(fs) = self.pns[*n] {
                if fs.len() == 1 {
                    return Opnd.Lit(fs[0]);
                }
            }
            return Opnd.Node(*n);
        }
        Opnd.Lit(self.lit_obj(v))
    }

    // The match groups of a regex at the start of s, or None.
    fn match_groups(ref self, prog: ref Program, s: ref String) -> Option[Vec[Option[String]]] {
        let c = cps(s);
        let mut m = new_matcher(prog, c);
        match find(mut m, prog, 0, false, 1) {
            Some(f) => {
                let mut out: Vec[Option[String]] = Vec.new();
                for (a, b) in f.spans.iter() {
                    if *a < 0 {
                        out.push(None);
                    } else {
                        out.push(Some(to_string(slice(c, *a, *b))));
                    }
                }
                Some(out)
            }
            None => None,
        }
    }

    fn named_operator(mut ref self, name: ref String, lineno: i64, lexpos: i64, ext: bool) -> Result[i64, PyErr] {
        if ext {
            if name == "len" {
                return Ok(self.node(Pn.Len));
            }
            if name == "keys" {
                return Ok(self.node(Pn.Keys));
            }
            if name == "path" {
                return Ok(self.node(Pn.Path));
            }
            if name == "sorted" {
                return Ok(self.node(Pn.Sorted(false, Vec.new())));
            }
            let invalid = pyerr("DefintionInvalid", f"{name} is not valid");
            if name.starts_with("split(") {
                return match self.match_groups(self.split_prog, name) {
                    Some(g) => {
                        let chars = g[1].clone().unwrap_or(String.new());
                        let segment = g[2].clone().unwrap_or(String.new());
                        let max_split = py_int_str(g[3].clone().unwrap_or(String.new())).unwrap_or(0);
                        Ok(self.node(Pn.Split(chars, segment, max_split, name.clone())))
                    }
                    None => Err(invalid),
                };
            }
            if name.starts_with("sub(") {
                return match self.match_groups(self.sub_prog, name) {
                    Some(g) => {
                        let expr = py_strip(g[0].clone().unwrap_or(String.new()));
                        let repl = py_strip(g[1].clone().unwrap_or(String.new()));
                        let compiled = match compile(cps(expr), 0) {
                            Ok(p) => p,
                            Err(e) => return Err(pyerr("PatternError", err_text(e))),
                        };
                        self.progs.push(compiled);
                        let k = self.progs.len() - 1;
                        Ok(self.node(Pn.Sub(k, expr, repl, name.clone())))
                    }
                    None => Err(invalid),
                };
            }
            if name.starts_with("str(") {
                return match self.match_groups(self.str_prog, name) {
                    Some(_) => Ok(self.node(Pn.StrOp(name.clone()))),
                    None => Err(invalid),
                };
            }
        }
        if name == "this" {
            return Ok(self.node(Pn.This));
        }
        if name == "parent" {
            return Ok(self.node(Pn.Parent));
        }
        Err(parser_error(f"Unknown named operator `{name}` at {lineno}:{lexpos}"))
    }

    // One grammar rule's action, by its function's name; p[k - 1] is
    // the rule's p[k].
    fn action(mut ref self, func: ref String, p: ref Vec[Sym], pos: ref Vec[(i64, i64)], ext: bool) -> Result[Sym, PyErr] {
        let n = p.len();
        if func == "p_jsonpath_binop" {
            let (a, b) = (sv_node(p[0]), sv_node(p[2]));
            let op = sv_text(p[1]);
            let node = if op == "." {
                Pn.Child(a, b)
            } else if op == ".." {
                Pn.Descendants(a, b)
            } else if op == "where" {
                Pn.Where(a, b)
            } else if op == "wherenot" {
                Pn.WhereNot(a, b)
            } else if op == "|" {
                Pn.Union(a, b)
            } else {
                Pn.Intersect(a, b)
            };
            return Ok(Sym.Node(self.node(node)));
        }
        if func == "p_jsonpath_fields" or func == "p_jsonpath_fieldbrackets" {
            let at = if func == "p_jsonpath_fields" { 0 } else { 1 };
            let names = splat(p[at]);
            return Ok(Sym.Node(self.fields_node(names)));
        }
        if func == "p_jsonpath_named_operator" {
            let (lineno, lexpos) = pos[0];
            return Ok(Sym.Node(self.named_operator(sv_text(p[0]), lineno, lexpos, ext)?));
        }
        if func == "p_jsonpath_root" {
            return Ok(Sym.Node(self.node(Pn.Root)));
        }
        if func == "p_jsonpath_this" {
            return Ok(Sym.Node(self.node(Pn.This)));
        }
        if func == "p_jsonpath_idx" or func == "p_jsonpath_slice" or func == "p_jsonpath_parens" or func == "p_expressions_parens" {
            return Ok(p[1].clone());
        }
        if func == "p_jsonpath_child_fieldbrackets" {
            let f = self.fields_node(splat(p[2]));
            return Ok(Sym.Node(self.node(Pn.Child(sv_node(p[0]), f))));
        }
        if func == "p_jsonpath_child_idxbrackets" or func == "p_jsonpath_child_slicebrackets" or func == "p_jsonpath_filter" {
            return Ok(Sym.Node(self.node(Pn.Child(sv_node(p[0]), sv_node(p[2])))));
        }
        if func == "p_fields_or_any" {
            return Ok(match p[0] {
                Sym.Str(s) => if s == "*" { Sym.Names(vec_str("*")) } else { Sym.Str(s.clone()) },
                Sym.Int(k) => Sym.Str(f"{k}"),
                _ => p[0].clone(),
            });
        }
        if func == "p_fields_id" {
            let mut v: Vec[String] = Vec.new();
            v.push(sv_text(p[0]));
            return Ok(Sym.Names(v));
        }
        if func == "p_fields_comma" {
            let mut v = splat(p[0]);
            for x in splat(p[2]) {
                v.push(x.clone());
            }
            return Ok(Sym.Names(v));
        }
        if func == "p_idx" {
            let k = self.lit_obj(p[0]);
            return Ok(Sym.Node(self.node(Pn.Index(k))));
        }
        if func == "p_slice_any" {
            let a = self.alloc(Obj.Nil);
            let b = self.alloc(Obj.Nil);
            let c = self.alloc(Obj.Nil);
            return Ok(Sym.Node(self.node(Pn.Slice(a, b, c))));
        }
        if func == "p_slice" {
            let a = self.opt_int(p[0]);
            let b = self.opt_int(p[2]);
            let c = if n == 5 { self.opt_int(p[4]) } else { self.alloc(Obj.Nil) };
            return Ok(Sym.Node(self.node(Pn.Slice(a, b, c))));
        }
        if func == "p_maybe_int" or func == "p_operator" {
            return Ok(p[0].clone());
        }
        if func == "p_empty" {
            return Ok(Sym.None);
        }
        if func == "p_jsonpath_operator_jsonpath" {
            let a = self.operand(p[0]);
            let b = self.operand(p[2]);
            return Ok(Sym.Node(self.node(Pn.Operation(a, sv_text(p[1]), b))));
        }
        if func == "p_expression" {
            if n == 1 {
                return Ok(Sym.Node(self.node(Pn.Expression(sv_node(p[0]), String.new(), -1))));
            }
            let v = self.lit_obj(p[2]);
            return Ok(Sym.Node(self.node(Pn.Expression(sv_node(p[0]), sv_text(p[1]), v))));
        }
        if func == "p_expressions_expression" {
            let mut v: Vec[i64] = Vec.new();
            v.push(sv_node(p[0]));
            return Ok(Sym.Exprs(v));
        }
        if func == "p_expressions_and" {
            let mut v = sv_exprs(p[0]);
            for x in sv_exprs(p[2]) {
                v.push(x);
            }
            return Ok(Sym.Exprs(v));
        }
        if func == "p_filter" {
            return Ok(Sym.Node(self.node(Pn.Filter(sv_exprs(p[1])))));
        }
        if func == "p_sort" {
            return Ok(Sym.Sort(sv_node(p[1]), sv_text(p[0]) != "/"));
        }
        if func == "p_sorts_sort" {
            let mut v: Vec[(i64, bool)] = Vec.new();
            if let Sym.Sort(a, b) = p[0] {
                v.push((*a, *b));
            }
            return Ok(Sym.Sorts(v));
        }
        if func == "p_sorts_comma" {
            let mut v = sv_sorts(p[0]);
            for x in sv_sorts(p[1]) {
                v.push(x);
            }
            return Ok(Sym.Sorts(v));
        }
        if func == "p_jsonpath_sort" {
            let s = self.node(Pn.Sorted(true, sv_sorts(p[2])));
            return Ok(Sym.Node(self.node(Pn.Child(sv_node(p[0]), s))));
        }
        Ok(Sym.None)
    }

    // ply.yacc's parse loop (parseopt_notrack), with jsonpath-ng's
    // p_error, which raises on the first error.
    fn parse_path(mut ref self, text: ref String, ext: bool) -> Result[i64, PyErr] {
        let tables = if ext { self.ext.clone() } else { self.base.clone() };
        let mut lexer = Lexer {
            cs: cps(text),
            pos: 0,
            lineno: 1,
            latest_newline: 0,
            state: "INITIAL".to_string(),
            stack: Vec.new(),
            string_value: None,
            ext: ext,
        };
        let mut states: Vec[i64] = Vec.new();
        states.push(0);
        let mut syms: Vec[Sym] = Vec.new();
        syms.push(Sym.None);
        let mut poss: Vec[(i64, i64)] = Vec.new();
        poss.push((0, 0));
        let mut la = Tok { ty: "$end".to_string(), val: Sym.None, lineno: 0, lexpos: 0, col: 0 };
        let mut has_la = false;
        let mut state = 0;
        loop {
            let mut act: Option[i64] = None;
            if not tables.has_default[state] {
                if not has_la {
                    la = match lexer.next_token()? {
                        Some(t) => t,
                        None => Tok { ty: "$end".to_string(), val: Sym.None, lineno: 0, lexpos: 0, col: 0 },
                    };
                    has_la = true;
                }
                act = lookup(tables.actions[state], la.ty);
            } else {
                act = Some(tables.defaulted[state]);
            }
            let a = match act {
                Some(a) => a,
                None => {
                    if la.ty == "$end" {
                        return Err(parser_error("Parse error near the end of string!".to_string()));
                    }
                    return Err(parser_error(f"Parse error at {la.lineno}:{la.col} near token {sv_text(la.val)} ({la.ty})"));
                }
            };
            if a > 0 {
                states.push(a);
                state = a;
                syms.push(la.val.clone());
                poss.push((la.lineno, la.lexpos));
                has_la = false;
                continue;
            }
            if a < 0 {
                let (pname, plen, func) = tables.prods[-a].clone();
                let base = syms.len() - plen;
                let mut args: Vec[Sym] = Vec.new();
                let mut where_: Vec[(i64, i64)] = Vec.new();
                for k in base..syms.len() {
                    args.push(syms[k].clone());
                    where_.push(poss[k]);
                }
                while syms.len() > base {
                    syms.pop();
                    poss.pop();
                    states.pop();
                }
                let v = self.action(func, args, where_, ext)?;
                syms.push(v);
                poss.push((0, 0));
                state = lookup(tables.gotos[states[states.len() - 1]], pname).unwrap_or(0);
                states.push(state);
                continue;
            }
            return Ok(sv_node(syms[syms.len() - 1]));
        }
    }
}

fn sv_node(v: ref Sym) -> i64 {
    match v {
        Sym.Node(n) => *n,
        _ => -1,
    }
}

fn sv_exprs(v: ref Sym) -> Vec[i64] {
    match v {
        Sym.Exprs(xs) => xs.clone(),
        _ => Vec.new(),
    }
}

fn sv_sorts(v: ref Sym) -> Vec[(i64, bool)] {
    match v {
        Sym.Sorts(xs) => xs.clone(),
        _ => Vec.new(),
    }
}

fn vec_str(s: Str) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(s.to_string());
    v
}

// Fields(*x): a list of names, or the characters of a string
fn splat(v: ref Sym) -> Vec[String] {
    match v {
        Sym.Names(xs) => xs.clone(),
        Sym.Str(s) => {
            let mut out: Vec[String] = Vec.new();
            for c in cps(s) {
                out.push(to_string(vec_of(c)));
            }
            out
        }
        _ => Vec.new(),
    }
}
// ------------------------------------------------------------ find

// What a find is given: a datum (-1 for None), or a bare value.
enum In {
    D(i64),
    V(i64),
}

// What a find gives back: a list of datums (-1 for None), or, where
// SortedThis hands back its datum unchanged, a single one.
enum Hits {
    L(Vec[i64]),
    D(i64),
}

fn not_iterable() -> PyErr {
    type_error("'DatumInContext' object is not iterable".to_string())
}

fn attr_error(ty: ref String, name: Str) -> PyErr {
    pyerr("AttributeError", f"'{ty}' object has no attribute '{name}'")
}

impl W {
    fn dat(mut ref self, value: i64, path: i64, context: i64) -> i64 {
        self.dats.push(Dat { value: value, path: path, context: context });
        self.dats.len() - 1
    }

    fn int_obj(mut ref self, n: i64) -> i64 {
        self.alloc(Obj.Int(n))
    }

    fn index_node(mut ref self, i: i64) -> i64 {
        let k = self.int_obj(i);
        self.node(Pn.Index(k))
    }

    fn field_node(mut ref self, key: i64) -> i64 {
        let mut v: Vec[i64] = Vec.new();
        v.push(key);
        self.node(Pn.Fields(v))
    }

    // DatumInContext.wrap
    fn wrap(mut ref self, x: ref In) -> i64 {
        match x {
            In.D(d) => {
                if *d >= 0 {
                    return *d;
                }
                let nil = self.alloc(Obj.Nil);
                let p = self.node(Pn.This);
                self.dat(nil, p, -1)
            }
            In.V(v) => {
                let p = self.node(Pn.This);
                self.dat(*v, p, -1)
            }
        }
    }

    fn wrap_value(mut ref self, v: i64) -> i64 {
        self.wrap(In.V(v))
    }

    // datum.value
    fn dv(ref self, d: i64) -> Result[i64, PyErr] {
        if d < 0 {
            return Err(attr_error("NoneType".to_string(), "value"));
        }
        Ok(self.dats[d].value)
    }

    fn as_list(ref self, r: ref Hits) -> Result[Vec[i64], PyErr] {
        match r {
            Hits.L(v) => Ok(v.clone()),
            Hits.D(_) => Err(not_iterable()),
        }
    }

    fn fr_truthy(ref self, r: ref Hits) -> bool {
        match r {
            Hits.L(v) => v.len() > 0,
            Hits.D(_) => true,
        }
    }

    fn is_this_like(ref self, n: i64) -> bool {
        match self.pns[n] {
            Pn.This => true,
            Pn.Sorted(_, _) => true,
            Pn.Sub(_, _, _, _) => true,
            Pn.Split(_, _, _, _) => true,
            Pn.StrOp(_) => true,
            _ => false,
        }
    }

    fn is_root(ref self, n: i64) -> bool {
        match self.pns[n] {
            Pn.Root => true,
            _ => false,
        }
    }

    // JSONPath.child, with its canonicalization
    fn child(mut ref self, a: i64, b: i64) -> i64 {
        if self.is_this_like(a) or self.is_root(a) {
            b
        } else if self.is_this_like(b) {
            a
        } else if self.is_root(b) {
            b
        } else {
            self.node(Pn.Child(a, b))
        }
    }

    fn full_path(mut ref self, d: i64) -> i64 {
        let ctx = self.dats[d].context;
        let p = self.dats[d].path;
        if ctx < 0 {
            return p;
        }
        let up = self.full_path(ctx);
        self.child(up, p)
    }

    fn contains(ref self, c: i64, x: i64) -> Result[bool, PyErr] {
        match self.objs[c] {
            Obj.Dict(d) => Ok(self.dict_find(d, x) >= 0),
            Obj.List(xs) => {
                for y in xs.iter() {
                    if self.eq(*y, x) {
                        return Ok(true);
                    }
                }
                Ok(false)
            }
            Obj.Str(s) => {
                if not self.is_str(x) {
                    return Err(type_error(f"'in <string>' requires string as left operand, not {self.type_name(x)}"));
                }
                Ok(s.contains(self.str_of(x)))
            }
            _ => Err(type_error(f"argument of type '{self.type_name(c)}' is not iterable")),
        }
    }

    // x[k]
    fn getitem(mut ref self, c: i64, k: i64) -> Result[i64, PyErr] {
        match self.objs[c] {
            Obj.Dict(d) => {
                let i = self.dict_find(d, k);
                if i < 0 {
                    return Err(pyerr("KeyError", self.repr(k)));
                }
                Ok(d[i].1)
            }
            Obj.List(xs) => {
                let i = match self.int_val(k) {
                    Some(i) => i,
                    None => return Err(type_error(f"list indices must be integers or slices, not {self.type_name(k)}")),
                };
                let j = if i < 0 { i + xs.len() } else { i };
                if j < 0 or j >= xs.len() {
                    return Err(pyerr("IndexError", "list index out of range".to_string()));
                }
                Ok(xs[j])
            }
            Obj.Str(s) => {
                let i = match self.int_val(k) {
                    Some(i) => i,
                    None => return Err(type_error(f"string indices must be integers, not '{self.type_name(k)}'")),
                };
                let c2 = cps(s);
                let j = if i < 0 { i + c2.len() } else { i };
                if j < 0 or j >= c2.len() {
                    return Err(pyerr("IndexError", "string index out of range".to_string()));
                }
                let ch = to_string(vec_of(c2[j]));
                Ok(self.alloc(Obj.Str(ch)))
            }
            _ => Err(type_error(f"'{self.type_name(c)}' object is not subscriptable")),
        }
    }

    // x[k] = v
    fn setitem(mut ref self, c: i64, k: i64, v: i64) -> Result[(), PyErr] {
        if self.is_dict(c) {
            let mut d = self.entries(c);
            self.dict_put(mut d, k, v);
            self.set_entries(c, d);
            return Ok(());
        }
        if self.is_list(c) {
            let mut xs = self.items(c);
            let i = match self.int_val(k) {
                Some(i) => i,
                None => return Err(type_error(f"list indices must be integers or slices, not {self.type_name(k)}")),
            };
            let j = if i < 0 { i + xs.len() } else { i };
            if j < 0 or j >= xs.len() {
                return Err(pyerr("IndexError", "list assignment index out of range".to_string()));
            }
            xs[j] = v;
            self.set_items(c, xs);
            return Ok(());
        }
        Err(type_error(f"'{self.type_name(c)}' object does not support item assignment"))
    }

    // x.pop(k)
    fn pop_item(mut ref self, c: i64, k: i64) -> Result[(), PyErr] {
        if self.is_dict(c) {
            let d = self.entries(c);
            let i = self.dict_find(d, k);
            if i < 0 {
                return Err(pyerr("KeyError", self.repr(k)));
            }
            let mut out: Vec[(i64, i64)] = Vec.new();
            for j in 0..d.len() {
                if j != i {
                    out.push(d[j]);
                }
            }
            self.set_entries(c, out);
            return Ok(());
        }
        if self.is_list(c) {
            let xs = self.items(c);
            let i = match self.int_val(k) {
                Some(i) => i,
                None => return Err(type_error(f"'{self.type_name(k)}' object cannot be interpreted as an integer")),
            };
            let j = if i < 0 { i + xs.len() } else { i };
            if j < 0 or j >= xs.len() {
                return Err(pyerr("IndexError", "pop index out of range".to_string()));
            }
            let mut out: Vec[i64] = Vec.new();
            for m in 0..xs.len() {
                if m != j {
                    out.push(xs[m]);
                }
            }
            self.set_items(c, out);
            return Ok(());
        }
        Err(attr_error(self.type_name(c), "pop"))
    }

    // int(x)
    fn py_int(ref self, v: i64) -> Result[i64, PyErr] {
        match self.objs[v] {
            Obj.Bool(b) => Ok(if *b { 1 } else { 0 }),
            Obj.Int(n) => Ok(*n),
            Obj.Float(x) => {
                if *x != *x {
                    return Err(pyerr("ValueError", "cannot convert float NaN to integer".to_string()));
                }
                if *x == 1.0 / 0.0 or *x == -1.0 / 0.0 {
                    return Err(pyerr("OverflowError", "cannot convert float infinity to integer".to_string()));
                }
                Ok(*x as i64)
            }
            Obj.Str(s) => {
                match py_int_str(s) {
                    Some(n) => Ok(n),
                    None => Err(pyerr("ValueError", f"invalid literal for int() with base 10: {repr_of(cps(s))}")),
                }
            }
            _ => Err(type_error(f"int() argument must be a string, a bytes-like object or a real number, not '{self.type_name(v)}'")),
        }
    }

    // a + b and the other operators Operation has
    fn arith(mut ref self, op: ref String, a: i64, b: i64) -> Result[i64, PyErr] {
        let unsupported = type_error(f"unsupported operand type(s) for {op}: '{self.type_name(a)}' and '{self.type_name(b)}'");
        if let Some(x) = self.num(a) {
            if let Some(y) = self.num(b) {
                let ints = not self.is_float(a) and not self.is_float(b);
                if op == "/" {
                    if y == 0.0 {
                        return Err(pyerr("ZeroDivisionError", if ints { "division by zero".to_string() } else { "float division by zero".to_string() }));
                    }
                    return Ok(self.alloc(Obj.Float(x / y)));
                }
                if ints {
                    let (m, n) = (self.int_val(a).unwrap_or(0), self.int_val(b).unwrap_or(0));
                    let r = if op == "+" { m + n } else if op == "-" { m - n } else { m * n };
                    return Ok(self.int_obj(r));
                }
                let r = if op == "+" { x + y } else if op == "-" { x - y } else { x * y };
                return Ok(self.alloc(Obj.Float(r)));
            }
        }
        if op == "+" {
            if self.is_str(a) and self.is_str(b) {
                let s = f"{self.str_of(a)}{self.str_of(b)}";
                return Ok(self.alloc(Obj.Str(s)));
            }
            if self.is_list(a) and self.is_list(b) {
                let mut xs = self.items(a);
                for y in self.items(b) {
                    xs.push(y);
                }
                return Ok(self.alloc(Obj.List(xs)));
            }
        }
        if op == "*" {
            let (seq, count) = if self.int_val(b).is_some() and (self.is_str(a) or self.is_list(a)) {
                (a, self.int_val(b).unwrap_or(0))
            } else if self.int_val(a).is_some() and (self.is_str(b) or self.is_list(b)) {
                (b, self.int_val(a).unwrap_or(0))
            } else {
                (-1, 0)
            };
            if seq >= 0 {
                if self.is_str(seq) {
                    let mut s = String.new();
                    for _ in 0..count {
                        s.push_str(self.str_of(seq));
                    }
                    return Ok(self.alloc(Obj.Str(s)));
                }
                let mut xs: Vec[i64] = Vec.new();
                for _ in 0..count {
                    for y in self.items(seq) {
                        xs.push(y);
                    }
                }
                return Ok(self.alloc(Obj.List(xs)));
            }
        }
        Err(unsupported)
    }

    fn find(mut ref self, n: i64, x: ref In) -> Result[Hits, PyErr] {
        match self.pns[n].clone() {
            Pn.Root => {
                match x {
                    In.D(d) => {
                        if *d < 0 {
                            let nil = self.alloc(Obj.Nil);
                            let r = self.node(Pn.Root);
                            return Ok(Hits.L(vec1(self.dat(nil, r, -1))));
                        }
                        let ctx = self.dats[*d].context;
                        if ctx < 0 {
                            let v = self.dats[*d].value;
                            let r = self.node(Pn.Root);
                            return Ok(Hits.L(vec1(self.dat(v, r, -1))));
                        }
                        self.find(n, In.D(ctx))
                    }
                    In.V(v) => {
                        let r = self.node(Pn.Root);
                        Ok(Hits.L(vec1(self.dat(*v, r, -1))))
                    }
                }
            }
            Pn.This => Ok(Hits.L(vec1(self.wrap(x)))),
            Pn.Parent => {
                let d = self.wrap(x);
                Ok(Hits.L(vec1(self.dats[d].context)))
            }
            Pn.Child(l, r) => {
                let left = self.find(l, x)?;
                let mut out: Vec[i64] = Vec.new();
                for s in self.as_list(left)? {
                    let right = self.find(r, In.D(s))?;
                    for m in self.as_list(right)? {
                        out.push(m);
                    }
                }
                Ok(Hits.L(out))
            }
            Pn.Where(l, r) => self.where_find(l, r, x, true),
            Pn.WhereNot(l, r) => self.where_find(l, r, x, false),
            Pn.Descendants(l, r) => {
                let left = match self.find(l, x)? {
                    Hits.L(v) => v,
                    Hits.D(d) => vec1(d),
                };
                let mut out: Vec[i64] = Vec.new();
                for m in left {
                    for k in self.match_recursively(r, m)? {
                        out.push(k);
                    }
                }
                Ok(Hits.L(out))
            }
            Pn.Union(l, r) => {
                let a = self.find(l, x)?;
                let b = self.find(r, x)?;
                match a {
                    Hits.L(xs) => {
                        match b {
                            Hits.L(ys) => {
                                let mut out = xs.clone();
                                for y in ys {
                                    out.push(y);
                                }
                                Ok(Hits.L(out))
                            }
                            Hits.D(_) => Err(type_error("can only concatenate list (not \"DatumInContext\") to list".to_string())),
                        }
                    }
                    Hits.D(_) => {
                        let other = match b {
                            Hits.L(_) => "list",
                            Hits.D(_) => "DatumInContext",
                        };
                        Err(type_error(f"unsupported operand type(s) for +: 'DatumInContext' and '{other}'"))
                    }
                }
            }
            Pn.Intersect(_, _) => Err(not_implemented()),
            Pn.Fields(fs) => self.fields_find(fs, x, false),
            Pn.Index(_) => self.index_find(n, x, false),
            Pn.Slice(a, b, c) => self.slice_find(a, b, c, x),
            Pn.Filter(es) => self.filter_find(es, x),
            Pn.Expression(t, op, v) => self.expression_find(t, op, v, x),
            Pn.Operation(a, op, b) => self.operation_find(a, op, b, x),
            Pn.Sorted(has, exprs) => self.sorted_find(has, exprs, x),
            Pn.Len => {
                let d = self.wrap(x);
                let v = self.dats[d].value;
                match self.len_of(v) {
                    Ok(k) => {
                        let o = self.int_obj(k);
                        let p = self.node(Pn.Len);
                        Ok(Hits.L(vec1(self.dat(o, p, -1))))
                    }
                    Err(_) => Ok(Hits.L(Vec.new())),
                }
            }
            Pn.Keys => {
                let d = self.wrap(x);
                let v = self.dats[d].value;
                if not self.is_dict(v) {
                    return Ok(Hits.L(Vec.new()));
                }
                let mut out: Vec[i64] = Vec.new();
                for k in self.keys(v) {
                    let p = self.node(Pn.Keys);
                    out.push(self.dat(k, p, -1));
                }
                Ok(Hits.L(out))
            }
            Pn.Path => {
                let d = self.wrap(x);
                let p = self.dats[d].path;
                match self.path_str(p) {
                    Ok(s) => {
                        let o = self.alloc(Obj.Str(s));
                        let pp = self.node(Pn.Path);
                        Ok(Hits.L(vec1(self.dat(o, pp, d))))
                    }
                    Err(_) => Ok(Hits.L(Vec.new())),
                }
            }
            Pn.Sub(k, _, repl, _) => {
                let d = self.wrap(x);
                let v = self.dats[d].value;
                if not self.is_str(v) {
                    return Err(type_error(f"expected string or bytes-like object, got '{self.type_name(v)}'"));
                }
                let s = cps(self.str_of(v));
                let pieces = match parse_template(cps(repl), self.progs[k]) {
                    Ok(p) => p,
                    Err(e) => {
                        if e.kind == "error" {
                            return Err(pyerr("PatternError", err_text(e)));
                        }
                        return Err(PyErr { kind: e.kind.clone(), msg: e.msg.clone() });
                    }
                };
                let mut out: Vec[i64] = Vec.new();
                let mut last = 0;
                let found = all_matches(self.progs[k], s, 0);
                for m in found {
                    push_all(mut out, slice(s, last, m.start));
                    expand(pieces, s, m, mut out);
                    last = m.end;
                }
                push_all(mut out, slice(s, last, s.len()));
                if same(out, s) {
                    return Ok(Hits.L(Vec.new()));
                }
                let o = self.alloc(Obj.Str(to_string(out)));
                Ok(Hits.L(vec1(self.wrap_value(o))))
            }
            Pn.Split(chars, segment, max_split, _) => {
                let d = self.wrap(x);
                let v = self.dats[d].value;
                if not self.is_str(v) or chars.len() == 0 {
                    return Ok(Hits.L(Vec.new()));
                }
                let parts = py_split(self.str_of(v), chars, max_split);
                if segment == "*" {
                    let mut xs: Vec[i64] = Vec.new();
                    for p in parts {
                        xs.push(self.alloc(Obj.Str(p.clone())));
                    }
                    let o = self.alloc(Obj.List(xs));
                    return Ok(Hits.L(vec1(self.wrap_value(o))));
                }
                let i = match py_int_str(segment) {
                    Some(i) => i,
                    None => return Ok(Hits.L(Vec.new())),
                };
                let j = if i < 0 { i + parts.len() } else { i };
                if j < 0 or j >= parts.len() {
                    return Ok(Hits.L(Vec.new()));
                }
                let o = self.alloc(Obj.Str(parts[j].clone()));
                Ok(Hits.L(vec1(self.wrap_value(o))))
            }
            Pn.StrOp(_) => {
                let d = self.wrap(x);
                let v = self.dats[d].value;
                let o = self.alloc(Obj.Str(self.pstr(v)));
                Ok(Hits.L(vec1(self.wrap_value(o))))
            }
        }
    }

    fn where_find(mut ref self, l: i64, r: i64, x: ref In, keep: bool) -> Result[Hits, PyErr] {
        let left = self.find(l, x)?;
        let mut out: Vec[i64] = Vec.new();
        for s in self.as_list(left)? {
            let m = self.find(r, In.D(s))?;
            if self.fr_truthy(m) == keep {
                out.push(s);
            }
        }
        Ok(Hits.L(out))
    }

    fn match_recursively(mut ref self, r: i64, d: i64) -> Result[Vec[i64], PyErr] {
        let right = self.find(r, In.D(d))?;
        let v = self.dv(d)?;
        let mut rec: Vec[i64] = Vec.new();
        if self.is_list(v) {
            let xs = self.items(v);
            for i in 0..xs.len() {
                let p = self.index_node(i);
                let c = self.dat(xs[i], p, d);
                for m in self.match_recursively(r, c)? {
                    rec.push(m);
                }
            }
        } else if self.is_dict(v) {
            for (k, val) in self.entries(v) {
                let p = self.field_node(k);
                let c = self.dat(val, p, d);
                for m in self.match_recursively(r, c)? {
                    rec.push(m);
                }
            }
        }
        match right {
            Hits.L(xs) => {
                let mut out = xs.clone();
                for m in rec {
                    out.push(m);
                }
                Ok(out)
            }
            Hits.D(_) => Err(type_error("can only concatenate list (not \"DatumInContext\") to list".to_string())),
        }
    }

    // Fields.reified_fields
    fn reified(mut ref self, fs: ref Vec[i64], d: i64) -> Vec[i64] {
        let star = self.alloc(Obj.Str("*".to_string()));
        let mut has_star = false;
        for f in fs.iter() {
            if self.eq(*f, star) {
                has_star = true;
            }
        }
        if not has_star {
            return fs.clone();
        }
        let v = self.dats[d].value;
        if self.is_dict(v) {
            return self.keys(v);
        }
        Vec.new()
    }

    fn fields_find(mut ref self, fs: ref Vec[i64], x: ref In, create: bool) -> Result[Hits, PyErr] {
        let d = self.wrap(x);
        let mut out: Vec[i64] = Vec.new();
        for f in self.reified(fs, d) {
            let v = self.dats[d].value;
            if not self.is_dict(v) {
                continue;
            }
            let e = self.entries(v);
            let i = self.dict_find(e, f);
            let fv = if i >= 0 {
                e[i].1
            } else if create {
                let nd = self.alloc(Obj.Dict(Vec.new()));
                self.setitem(v, f, nd)?;
                nd
            } else {
                continue;
            };
            let p = self.field_node(f);
            out.push(self.dat(fv, p, d));
        }
        Ok(Hits.L(out))
    }

    fn index_of(ref self, n: i64) -> i64 {
        match self.pns[n] {
            Pn.Index(k) => *k,
            _ => -1,
        }
    }

    // len(x) > index
    fn longer_than(ref self, v: i64, k: i64) -> Result[bool, PyErr] {
        let n = self.len_of(v)?;
        match self.int_val(k) {
            Some(i) => Ok(n > i),
            None => Err(type_error(f"'>' not supported between instances of 'int' and '{self.type_name(k)}'")),
        }
    }

    fn is_empty_dict(ref self, v: i64) -> bool {
        self.is_dict(v) and self.entries(v).len() == 0
    }

    // _create_list_key
    fn create_list_key(mut ref self, d: i64) -> Result[i64, PyErr] {
        let e = self.alloc(Obj.Dict(Vec.new()));
        let xs = self.alloc(Obj.List(vec1(e)));
        self.setitem(d, 0, xs)?;
        Ok(xs)
    }

    // Index._pad_value
    fn pad_value(mut ref self, v: i64, k: i64) -> Result[(), PyErr] {
        let n = self.len_of(v)?;
        let i = match self.int_val(k) {
            Some(i) => i,
            None => return Err(type_error(f"'<=' not supported between instances of 'int' and '{self.type_name(k)}'")),
        };
        if n <= i {
            if not self.is_list(v) {
                return Err(type_error(f"unsupported operand type(s) for +=: '{self.type_name(v)}' and 'list'"));
            }
            let mut xs = self.items(v);
            for _ in 0..(i - n + 1) {
                xs.push(self.alloc(Obj.Dict(Vec.new())));
            }
            self.set_items(v, xs);
        }
        Ok(())
    }

    fn index_find(mut ref self, n: i64, x: ref In, create: bool) -> Result[Hits, PyErr] {
        let d = self.wrap(x);
        let k = self.index_of(n);
        if create {
            if self.is_empty_dict(self.dats[d].value) {
                let nl = self.create_list_key(self.dats[d].value)?;
                self.dats[d].value = nl;
            }
            self.pad_value(self.dats[d].value, k)?;
        }
        let v = self.dats[d].value;
        if self.truthy(v) and self.longer_than(v, k)? {
            let item = self.getitem(v, k)?;
            return Ok(Hits.L(vec1(self.dat(item, n, d))));
        }
        Ok(Hits.L(Vec.new()))
    }

    // the indices range(0, n)[start:end:step] holds
    fn slice_indices(ref self, n: i64, a: i64, b: i64, c: i64) -> Result[Vec[i64], PyErr] {
        let step = self.int_val(c).unwrap_or(1);
        if step == 0 {
            return Err(pyerr("ValueError", "slice step cannot be zero".to_string()));
        }
        let (lo_default, hi_default) = if step > 0 { (0, n) } else { (n - 1, -1) };
        let mut start = lo_default;
        if let Some(s) = self.int_val(a) {
            start = if s < 0 { s + n } else { s };
            if step > 0 {
                start = if start < 0 { 0 } else if start > n { n } else { start };
            } else {
                start = if start < 0 { -1 } else if start >= n { n - 1 } else { start };
            }
        }
        let mut stop = hi_default;
        if let Some(e) = self.int_val(b) {
            stop = if e < 0 { e + n } else { e };
            if step > 0 {
                stop = if stop < 0 { 0 } else if stop > n { n } else { stop };
            } else {
                stop = if stop < 0 { -1 } else if stop >= n { n - 1 } else { stop };
            }
        }
        let mut out: Vec[i64] = Vec.new();
        let mut i = start;
        while (step > 0 and i < stop) or (step < 0 and i > stop) {
            out.push(i);
            i += step;
        }
        Ok(out)
    }

    fn slice_find(mut ref self, a: i64, b: i64, c: i64, x: ref In) -> Result[Hits, PyErr] {
        let d = self.wrap(x);
        let v = self.dats[d].value;
        if not self.truthy(v) {
            return Ok(Hits.L(Vec.new()));
        }
        if self.is_dict(v) or self.is_int(v) or self.is_str(v) {
            let nl = self.alloc(Obj.List(vec1(v)));
            let nd = self.dat(nl, self.dats[d].path, self.dats[d].context);
            return self.slice_find(a, b, c, In.D(nd));
        }
        let n = self.len_of(v)?;
        let all_none = self.is_nil(a) and self.is_nil(b) and self.is_nil(c);
        let idx = if all_none {
            let mut r: Vec[i64] = Vec.new();
            for i in 0..n {
                r.push(i);
            }
            r
        } else {
            self.slice_indices(n, a, b, c)?
        };
        let xs = self.items(v);
        let mut out: Vec[i64] = Vec.new();
        for i in idx {
            let p = self.index_node(i);
            out.push(self.dat(xs[i], p, d));
        }
        Ok(Hits.L(out))
    }

    fn filter_find(mut ref self, es: ref Vec[i64], x: ref In) -> Result[Hits, PyErr] {
        let d = self.wrap(x);
        let v = self.dats[d].value;
        if self.is_dict(v) {
            let vals = self.values(v);
            let nl = self.alloc(Obj.List(vals));
            self.dats[d].value = nl;
        }
        let v2 = self.dats[d].value;
        if not self.is_list(v2) {
            return Ok(Hits.L(Vec.new()));
        }
        let xs = self.items(v2);
        let mut out: Vec[i64] = Vec.new();
        for i in 0..xs.len() {
            if self.all_hold(es, xs[i])? {
                let p = self.index_node(i);
                out.push(self.dat(xs[i], p, d));
            }
        }
        Ok(Hits.L(out))
    }

    // every expression finds something in the item
    fn all_hold(mut ref self, es: ref Vec[i64], item: i64) -> Result[bool, PyErr] {
        let mut n = 0;
        for e in es.iter() {
            let r = self.find(*e, In.V(item))?;
            if self.fr_truthy(r) {
                n += 1;
            }
        }
        Ok(n == es.len())
    }

    fn compare(mut ref self, op: ref String, a: i64, b: i64) -> Result[bool, PyErr] {
        if op == "==" or op == "=" {
            return Ok(self.eq(a, b));
        }
        if op == "!=" {
            return Ok(not self.eq(a, b));
        }
        if op == "=~" {
            if not self.is_str(a) {
                return Ok(false);
            }
            if not self.is_str(b) {
                return Err(type_error("first argument must be string or compiled pattern".to_string()));
            }
            let prog = match compile(cps(self.str_of(b)), 0) {
                Ok(p) => p,
                Err(e) => return Err(pyerr("PatternError", err_text(e))),
            };
            let s = cps(self.str_of(a));
            let mut m = new_matcher(prog, s);
            return Ok(find(mut m, prog, 0, false, 0).is_some());
        }
        self.order(a, b, op.as_str())
    }

    fn expression_find(mut ref self, t: i64, op: ref String, val: i64, x: ref In) -> Result[Hits, PyErr] {
        let w = self.wrap(x);
        let found = self.find(t, In.D(w))?;
        if not self.fr_truthy(found) {
            return Ok(Hits.L(Vec.new()));
        }
        if op.len() == 0 {
            return Ok(found);
        }
        let mut out: Vec[i64] = Vec.new();
        for d in self.as_list(found)? {
            let mut value = self.dv(d)?;
            if self.is_int(val) {
                match self.py_int(value) {
                    Ok(k) => value = self.int_obj(k),
                    Err(e) => {
                        if e.kind == "ValueError" {
                            continue;
                        }
                        return Err(e);
                    }
                }
            }
            if self.compare(op, value, val)? {
                out.push(d);
            }
        }
        Ok(Hits.L(out))
    }

    fn operation_find(mut ref self, a: ref Opnd, op: ref String, b: ref Opnd, x: ref In) -> Result[Hits, PyErr] {
        let mut results: Vec[i64] = Vec.new();
        match a {
            Opnd.Node(l) => {
                match b {
                    Opnd.Node(r) => {
                        let left = self.find(*l, x)?;
                        let right = self.find(*r, x)?;
                        if not self.fr_truthy(left) or not self.fr_truthy(right) {
                            return no_hits();
                        }
                        let ls = match left {
                            Hits.L(v) => v,
                            Hits.D(_) => return Err(type_error("object of type 'DatumInContext' has no len()".to_string())),
                        };
                        let rs = match right {
                            Hits.L(v) => v,
                            Hits.D(_) => return Err(type_error("object of type 'DatumInContext' has no len()".to_string())),
                        };
                        if ls.len() != rs.len() {
                            return no_hits();
                        }
                        for i in 0..ls.len() {
                            let lv = self.dv(ls[i])?;
                            let rv = self.dv(rs[i])?;
                            match self.arith(op, lv, rv) {
                                Ok(v) => results.push(v),
                                Err(e) => {
                                    if e.kind == "TypeError" {
                                        return no_hits();
                                    }
                                    return Err(e);
                                }
                            }
                        }
                    }
                    Opnd.Lit(r) => {
                        let left = self.find(*l, x)?;
                        for d in self.as_list(left)? {
                            let lv = self.dv(d)?;
                            match self.arith(op, lv, *r) {
                                Ok(v) => results.push(v),
                                Err(e) => {
                                    if e.kind == "TypeError" {
                                        return no_hits();
                                    }
                                    return Err(e);
                                }
                            }
                        }
                    }
                }
            }
            Opnd.Lit(l) => {
                match b {
                    Opnd.Node(r) => {
                        let right = self.find(*r, x)?;
                        for d in self.as_list(right)? {
                            let rv = self.dv(d)?;
                            match self.arith(op, *l, rv) {
                                Ok(v) => results.push(v),
                                Err(e) => {
                                    if e.kind == "TypeError" {
                                        return no_hits();
                                    }
                                    return Err(e);
                                }
                            }
                        }
                    }
                    Opnd.Lit(r) => {
                        match self.arith(op, *l, *r) {
                            Ok(v) => results.push(v),
                            Err(e) => {
                                if e.kind == "TypeError" {
                                    return no_hits();
                                }
                                return Err(e);
                            }
                        }
                    }
                }
            }
        }
        let mut out: Vec[i64] = Vec.new();
        for r in results {
            out.push(self.wrap_value(r));
        }
        Ok(Hits.L(out))
    }

    // SortedThis._compare
    fn sort_cmp(mut ref self, exprs: ref Vec[(i64, bool)], a: i64, b: i64) -> Result[i64, PyErr] {
        let l = self.wrap_value(a);
        let r = self.wrap_value(b);
        for (field, reverse) in exprs.iter() {
            let ld = self.find(*field, In.D(l))?;
            let rd = self.find(*field, In.D(r))?;
            if not self.fr_truthy(ld) or not self.fr_truthy(rd) {
                continue;
            }
            let ls = match ld {
                Hits.L(v) => v,
                Hits.D(_) => return Err(type_error("object of type 'DatumInContext' has no len()".to_string())),
            };
            let rs = match rd {
                Hits.L(v) => v,
                Hits.D(_) => return Err(type_error("object of type 'DatumInContext' has no len()".to_string())),
            };
            if ls.len() > 1 or rs.len() > 1 {
                continue;
            }
            let lv = self.dv(ls[0])?;
            let rv = self.dv(rs[0])?;
            if self.eq(lv, rv) {
                continue;
            }
            if self.order(lv, rv, "<")? {
                return Ok(if *reverse { 1 } else { -1 });
            }
            return Ok(if *reverse { -1 } else { 1 });
        }
        Ok(0)
    }

    fn sort_lt(mut ref self, has: bool, exprs: ref Vec[(i64, bool)], a: i64, b: i64) -> Result[bool, PyErr] {
        if has {
            return Ok(self.sort_cmp(exprs, a, b)? < 0);
        }
        self.order(a, b, "<")
    }

    // sorted(xs): a stable binary insertion sort, which is what
    // CPython's list.sort does with lists this short
    fn sort_values(mut ref self, has: bool, exprs: ref Vec[(i64, bool)], xs: ref Vec[i64]) -> Result[Vec[i64], PyErr] {
        let mut out: Vec[i64] = Vec.new();
        for x in xs.iter() {
            let mut lo = 0;
            let mut hi = out.len();
            while lo < hi {
                let mid = (lo + hi) / 2;
                if self.sort_lt(has, exprs, *x, out[mid])? {
                    hi = mid;
                } else {
                    lo = mid + 1;
                }
            }
            out.insert(lo, *x);
        }
        Ok(out)
    }

    fn sorted_find(mut ref self, has: bool, exprs: ref Vec[(i64, bool)], x: ref In) -> Result[Hits, PyErr] {
        let d = match x {
            In.D(d) => {
                if *d < 0 {
                    return Err(attr_error("NoneType".to_string(), "value"));
                }
                *d
            }
            In.V(v) => return Err(attr_error(self.type_name(*v), "value")),
        };
        let v = self.dats[d].value;
        if self.is_dict(v) and has {
            return Ok(Hits.D(d));
        }
        if self.is_dict(v) or self.is_list(v) {
            let elems = if self.is_dict(v) { self.keys(v) } else { self.items(v) };
            let sorted = self.sort_values(has, exprs, elems)?;
            let o = self.alloc(Obj.List(sorted));
            return Ok(Hits.L(vec1(self.wrap_value(o))));
        }
        Ok(Hits.D(d))
    }
}

fn no_hits() -> Result[Hits, PyErr] {
    Ok(Hits.L(Vec.new()))
}

fn vec1(x: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(x);
    v
}

// str.split(sep, maxsplit)
fn py_split(s: ref String, sep: ref String, maxsplit: i64) -> Vec[String] {
    let c = cps(s);
    let p = cps(sep);
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i + p.len() <= c.len() {
        if maxsplit >= 0 and out.len() >= maxsplit {
            break;
        }
        if same(slice(c, i, i + p.len()), p) {
            out.push(to_string(slice(c, start, i)));
            i += p.len();
            start = i;
        } else {
            i += 1;
        }
    }
    out.push(to_string(slice(c, start, c.len())));
    out
}
// ------------------------------------------------------------ update and filter

// What update is given: a value, or one of the app's functions (called
// with the old value, the container and the field).
enum NewVal {
    V(i64),
    F(String),
}

impl W {
    // the app's update functions
    fn call_update(mut ref self, name: ref String, old: i64, data: i64, field: i64) -> Result[i64, PyErr] {
        if name == "double" {
            let two = self.int_obj(2);
            return self.arith("*", old, two);
        }
        if name == "inc" {
            let one = self.int_obj(1);
            return self.arith("+", old, one);
        }
        if name == "upper" {
            if not self.is_str(old) {
                return Err(attr_error(self.type_name(old), "upper"));
            }
            let s = self.str_of(old).to_uppercase();
            return Ok(self.alloc(Obj.Str(s)));
        }
        if name == "label" {
            let s = f"{self.pstr(field)}: {self.pstr(old)}";
            return Ok(self.alloc(Obj.Str(s)));
        }
        if name == "mark" {
            let k = self.alloc(Obj.Str("bulk".to_string()));
            let t = self.alloc(Obj.Bool(true));
            self.setitem(old, k, t)?;
            return Ok(old);
        }
        Ok(old)
    }

    // the app's filter tests
    fn call_test(mut ref self, name: ref String, x: i64) -> Result[bool, PyErr] {
        if name == "any" {
            return Ok(true);
        }
        if name == "cheap" {
            let p = if self.is_dict(x) {
                let k = self.alloc(Obj.Str("price".to_string()));
                let e = self.entries(x);
                let i = self.dict_find(e, k);
                if i >= 0 { e[i].1 } else { self.alloc(Obj.Nil) }
            } else {
                x
            };
            let ten = self.int_obj(10);
            return self.order(p, ten, "<");
        }
        if name == "is_list" {
            return Ok(self.is_list(x));
        }
        if name == "unassigned" {
            if not self.is_dict(x) {
                return Err(attr_error(self.type_name(x), "get"));
            }
            let k = self.alloc(Obj.Str("assignee".to_string()));
            let e = self.entries(x);
            let i = self.dict_find(e, k);
            return Ok(i < 0 or self.is_nil(e[i].1));
        }
        if name == "is_none" {
            return Ok(self.is_nil(x));
        }
        if name == "big" {
            let n = self.int_obj(150);
            return self.order(x, n, ">");
        }
        Ok(false)
    }

    fn update(mut ref self, n: i64, data: i64, val: ref NewVal) -> Result[i64, PyErr] {
        if self.is_this_like(n) or self.is_root(n) {
            return Ok(match val {
                NewVal.V(v) => *v,
                NewVal.F(_) => data,
            });
        }
        match self.pns[n].clone() {
            Pn.Child(l, r) => {
                let left = self.find(l, In.V(data))?;
                for d in self.as_list(left)? {
                    let v = self.dv(d)?;
                    self.update(r, v, val)?;
                }
                Ok(data)
            }
            Pn.Where(_, _) => self.where_update(n, data, val),
            Pn.WhereNot(_, _) => self.where_update(n, data, val),
            Pn.Descendants(l, r) => {
                let left = match self.find(l, In.V(data))? {
                    Hits.L(v) => v,
                    Hits.D(d) => vec1(d),
                };
                for m in left {
                    let v = self.dv(m)?;
                    self.update_recursively(r, v, val)?;
                }
                Ok(data)
            }
            Pn.Fields(fs) => self.fields_update(fs, data, val, false),
            Pn.Index(k) => self.index_update(k, data, val, false),
            Pn.Slice(_, _, _) => self.where_update(n, data, val),
            Pn.Filter(es) => {
                if not self.is_list(data) {
                    return Ok(data);
                }
                let mut index = 0;
                while index < self.items(data).len() {
                    let item = self.items(data)[index];
                    if self.all_hold(es, item)? {
                        let k = self.int_obj(index);
                        match val {
                            NewVal.F(f) => {
                                self.call_update(f, item, data, k)?;
                            }
                            NewVal.V(v) => self.setitem(data, k, *v)?,
                        }
                    }
                    index += 1;
                }
                Ok(data)
            }
            _ => Err(not_implemented()),
        }
    }

    // Where.update and Slice.update: each match's own last step, applied
    // to the data
    fn where_update(mut ref self, n: i64, data: i64, val: ref NewVal) -> Result[i64, PyErr] {
        let found = self.find(n, In.V(data))?;
        for d in self.as_list(found)? {
            let p = self.dats[d].path;
            self.update(p, data, val)?;
        }
        Ok(data)
    }

    fn update_recursively(mut ref self, r: i64, data: i64, val: ref NewVal) -> Result[(), PyErr] {
        if not (self.is_list(data) or self.is_dict(data)) {
            return Ok(());
        }
        self.update(r, data, val)?;
        if self.is_list(data) {
            let n = self.items(data).len();
            for i in 0..n {
                let c = self.items(data)[i];
                self.update_recursively(r, c, val)?;
            }
        } else if self.is_dict(data) {
            for k in self.keys(data) {
                let c = self.getitem(data, k)?;
                self.update_recursively(r, c, val)?;
            }
        }
        Ok(())
    }

    fn fields_update(mut ref self, fs: ref Vec[i64], data: i64, val: ref NewVal, create: bool) -> Result[i64, PyErr] {
        if self.is_nil(data) {
            return Ok(data);
        }
        let w = self.wrap_value(data);
        for f in self.reified(fs, w) {
            if create and not self.contains(data, f)? {
                let nd = self.alloc(Obj.Dict(Vec.new()));
                self.setitem(data, f, nd)?;
            }
            if not self.is_bool(data) and self.contains(data, f)? {
                match val {
                    NewVal.F(name) => {
                        let old = self.getitem(data, f)?;
                        let nv = self.call_update(name, old, data, f)?;
                        self.setitem(data, f, nv)?;
                    }
                    NewVal.V(v) => self.setitem(data, f, *v)?,
                }
            }
        }
        Ok(data)
    }

    fn index_update(mut ref self, k: i64, data0: i64, val: ref NewVal, create: bool) -> Result[i64, PyErr] {
        let mut data = data0;
        if create {
            if self.is_empty_dict(data) {
                data = self.create_list_key(data)?;
            }
            self.pad_value(data, k)?;
        }
        match val {
            NewVal.F(name) => {
                let old = self.getitem(data, k)?;
                let nv = self.call_update(name, old, data, k)?;
                self.setitem(data, k, nv)?;
            }
            NewVal.V(v) => {
                if self.longer_than(data, k)? {
                    self.setitem(data, k, *v)?;
                }
            }
        }
        Ok(data)
    }

    fn find_or_create(mut ref self, n: i64, x: ref In) -> Result[Hits, PyErr] {
        match self.pns[n].clone() {
            Pn.Child(l, r) => {
                let d = self.wrap(x);
                let mut out: Vec[i64] = Vec.new();
                let left = self.find_or_create(l, In.D(d))?;
                for s in self.as_list(left)? {
                    let right = self.find_or_create(r, In.D(s))?;
                    for m in self.as_list(right)? {
                        out.push(m);
                    }
                }
                Ok(Hits.L(out))
            }
            Pn.Fields(fs) => self.fields_find(fs, x, true),
            Pn.Index(_) => self.index_find(n, x, true),
            _ => self.find(n, x),
        }
    }

    fn update_or_create(mut ref self, n: i64, data: i64, val: ref NewVal) -> Result[i64, PyErr] {
        match self.pns[n].clone() {
            Pn.Child(l, r) => {
                let left = self.find_or_create(l, In.V(data))?;
                for d in self.as_list(left)? {
                    let v = self.dv(d)?;
                    self.update_or_create(r, v, val)?;
                }
                Ok(self.clean_list_keys(data))
            }
            Pn.Fields(fs) => self.fields_update(fs, data, val, true),
            Pn.Index(k) => self.index_update(k, data, val, true),
            _ => self.update(n, data, val),
        }
    }

    // _clean_list_keys
    fn clean_list_keys(mut ref self, s: i64) -> i64 {
        if self.is_list(s) {
            let mut xs = self.items(s);
            for i in 0..xs.len() {
                xs[i] = self.clean_list_keys(xs[i]);
                self.set_items(s, xs.clone());
            }
            return s;
        }
        if self.is_dict(s) {
            let e = self.entries(s);
            let i = self.dict_find(e, 0);
            if i >= 0 {
                return self.clean_list_keys(e[i].1);
            }
            let mut out = e.clone();
            for j in 0..out.len() {
                out[j] = (out[j].0, self.clean_list_keys(out[j].1));
            }
            self.set_entries(s, out);
        }
        s
    }

    fn filter(mut ref self, n: i64, f: ref String, data: i64) -> Result[i64, PyErr] {
        if self.is_this_like(n) or self.is_root(n) {
            if self.call_test(f, data)? {
                return Ok(data);
            }
            return Ok(self.alloc(Obj.Nil));
        }
        match self.pns[n].clone() {
            Pn.Child(l, r) => {
                let left = self.find(l, In.V(data))?;
                for d in self.as_list(left)? {
                    let v = self.dv(d)?;
                    self.filter(r, f, v)?;
                }
                Ok(data)
            }
            Pn.Where(_, _) => self.where_filter(n, f, data),
            Pn.WhereNot(_, _) => self.where_filter(n, f, data),
            Pn.Descendants(l, r) => {
                let left = match self.find(l, In.V(data))? {
                    Hits.L(v) => v,
                    Hits.D(d) => vec1(d),
                };
                for m in left {
                    let v = self.dv(m)?;
                    self.filter_recursively(r, f, v)?;
                }
                Ok(data)
            }
            Pn.Fields(fs) => {
                if self.is_nil(data) {
                    return Ok(data);
                }
                let w = self.wrap_value(data);
                for k in self.reified(fs, w) {
                    if self.contains(data, k)? {
                        let item = self.getitem(data, k)?;
                        if self.call_test(f, item)? {
                            self.pop_item(data, k)?;
                        }
                    }
                }
                Ok(data)
            }
            Pn.Index(k) => {
                let item = self.getitem(data, k)?;
                if self.call_test(f, item)? {
                    self.pop_item(data, k)?;
                }
                Ok(data)
            }
            Pn.Slice(_, _, _) => {
                let mut d = data;
                loop {
                    let length = self.len_of(d)?;
                    let found = self.find(n, In.V(d))?;
                    for m in self.as_list(found)? {
                        let p = self.dats[m].path;
                        d = self.filter(p, f, d)?;
                        if self.len_of(d)? < length {
                            break;
                        }
                    }
                    if length == self.len_of(d)? {
                        break;
                    }
                }
                Ok(d)
            }
            Pn.Filter(_) => {
                let found = self.find(n, In.V(data))?;
                let ms = self.as_list(found)?;
                let mut i = ms.len();
                while i > 0 {
                    i -= 1;
                    let p = self.dats[ms[i]].path;
                    if self.is_dict(data) {
                        let at = self.int_val(self.index_of(p)).unwrap_or(0);
                        let key = self.keys(data)[at];
                        self.pns[p] = Pn.Index(key);
                    }
                    self.filter(p, f, data)?;
                }
                Ok(data)
            }
            _ => Err(not_implemented()),
        }
    }

    fn where_filter(mut ref self, n: i64, f: ref String, data: i64) -> Result[i64, PyErr] {
        let found = self.find(n, In.V(data))?;
        for d in self.as_list(found)? {
            let p = self.dats[d].path;
            let v = self.dv(d)?;
            self.filter(p, f, v)?;
        }
        Ok(data)
    }

    fn filter_recursively(mut ref self, r: i64, f: ref String, data: i64) -> Result[(), PyErr] {
        if not (self.is_list(data) or self.is_dict(data)) {
            return Ok(());
        }
        self.filter(r, f, data)?;
        if self.is_list(data) {
            let n = self.items(data).len();
            for i in 0..n {
                let c = self.items(data)[i];
                self.filter_recursively(r, f, c)?;
            }
        } else if self.is_dict(data) {
            for k in self.keys(data) {
                let c = self.getitem(data, k)?;
                self.filter_recursively(r, f, c)?;
            }
        }
        Ok(())
    }

    // ------------------------------------------------------------ str and repr of paths

    fn path_str(mut ref self, n: i64) -> Result[String, PyErr] {
        match self.pns[n].clone() {
            Pn.Root => Ok("$".to_string()),
            Pn.This => Ok("`this`".to_string()),
            Pn.Parent => Ok("`parent`".to_string()),
            Pn.Child(a, b) => Ok(f"{self.path_str(a)?}.{self.path_str(b)?}"),
            Pn.Descendants(a, b) => Ok(f"{self.path_str(a)?}..{self.path_str(b)?}"),
            Pn.Where(a, b) => Ok(f"{self.path_str(a)?} where {self.path_str(b)?}"),
            Pn.WhereNot(a, b) => Ok(f"{self.path_str(a)?} wherenot {self.path_str(b)?}"),
            Pn.Fields(fs) => {
                let lits = cps(BASE_LITERALS.to_string());
                let mut parts: Vec[String] = Vec.new();
                for f in fs {
                    if not self.is_str(f) {
                        return Err(type_error(f"argument of type '{self.type_name(f)}' is not iterable"));
                    }
                    let s = self.str_of(f);
                    let mut quote = false;
                    for c in cps(s) {
                        for l in lits.iter() {
                            if *l == c {
                                quote = true;
                            }
                        }
                    }
                    parts.push(if quote { f"'{s}'" } else { s });
                }
                Ok(join(parts, ","))
            }
            Pn.Index(k) => {
                match self.int_val(k) {
                    Some(i) => Ok(f"[{i}]"),
                    None => Err(type_error(f"%i format: a real number is required, not {self.type_name(k)}")),
                }
            }
            Pn.Slice(a, b, c) => {
                if self.is_nil(a) and self.is_nil(b) and self.is_nil(c) {
                    return Ok("[*]".to_string());
                }
                let s = if self.truthy(a) { self.pstr(a) } else { String.new() };
                let e = if self.truthy(b) { f":{self.pstr(b)}" } else { String.new() };
                let t = if self.truthy(c) { f":{self.pstr(c)}" } else { String.new() };
                Ok(f"[{s}{e}{t}]")
            }
            Pn.Len => Ok("`len`".to_string()),
            Pn.Keys => Ok("`keys`".to_string()),
            Pn.Path => Ok("`path`".to_string()),
            Pn.Filter(es) => {
                let mut parts: Vec[String] = Vec.new();
                for e in es {
                    parts.push(self.show(e));
                }
                Ok(f"[?[{join(parts, ", ")}]]")
            }
            Pn.Sorted(has, exprs) => Ok(f"[?{self.show_sorts(has, exprs)}]"),
            Pn.Sub(_, expr, repl, _) => Ok(f"`sub(/{expr}/, {repl})`"),
            Pn.Split(_, _, _, method) => Ok(f"`{method}`"),
            Pn.StrOp(_) => Ok("`str()`".to_string()),
            _ => Ok(self.show(n)),
        }
    }

    fn show_sorts(mut ref self, has: bool, exprs: ref Vec[(i64, bool)]) -> String {
        if not has {
            return "None".to_string();
        }
        let mut parts: Vec[String] = Vec.new();
        for (f, r) in exprs.iter() {
            let b = if *r { "True" } else { "False" };
            parts.push(f"({self.show(*f)}, {b})");
        }
        f"[{join(parts, ", ")}]"
    }

    fn show_opnd(mut ref self, o: ref Opnd) -> String {
        match o {
            Opnd.Node(n) => self.show(*n),
            Opnd.Lit(v) => self.repr(*v),
        }
    }

    // The tree a parse gives, as oracle.py's show() writes it.
    fn show(mut ref self, n: i64) -> String {
        match self.pns[n].clone() {
            Pn.Root => "Root()".to_string(),
            Pn.This => "This()".to_string(),
            Pn.Parent => "Parent()".to_string(),
            Pn.Child(a, b) => f"Child({self.show(a)}, {self.show(b)})",
            Pn.Descendants(a, b) => f"Descendants({self.show(a)}, {self.show(b)})",
            Pn.Where(a, b) => f"Where({self.show(a)}, {self.show(b)})",
            Pn.WhereNot(a, b) => f"WhereNot({self.show(a)}, {self.show(b)})",
            Pn.Union(a, b) => f"Union({self.show(a)}, {self.show(b)})",
            Pn.Intersect(a, b) => f"Intersect({self.show(a)}, {self.show(b)})",
            Pn.Fields(fs) => {
                let mut parts: Vec[String] = Vec.new();
                for f in fs {
                    parts.push(self.repr(f));
                }
                f"Fields({join(parts, ",")})"
            }
            Pn.Index(k) => f"Index(index={self.repr(k)})",
            Pn.Slice(a, b, c) => f"Slice(start={self.repr(a)},end={self.repr(b)},step={self.repr(c)})",
            Pn.Filter(es) => {
                let mut parts: Vec[String] = Vec.new();
                for e in es {
                    parts.push(self.show(e));
                }
                f"Filter([{join(parts, ", ")}])"
            }
            Pn.Expression(t, op, v) => {
                if op.len() == 0 {
                    return f"Expression({self.show(t)})";
                }
                f"Expression({self.show(t)} {op} {self.repr(v)})"
            }
            Pn.Operation(a, op, b) => {
                let name = if op == "+" { "add" } else if op == "-" { "sub" } else if op == "*" { "mul" } else { "truediv" };
                f"Operation({self.show_opnd(a)} {name} {self.show_opnd(b)})"
            }
            Pn.Sorted(has, exprs) => f"SortedThis({self.show_sorts(has, exprs)})",
            Pn.Len => "Len()".to_string(),
            Pn.Keys => "Keys()".to_string(),
            Pn.Path => "Path()".to_string(),
            Pn.Sub(_, _, _, m) => f"Sub({repr_of(cps(m))})",
            Pn.Split(_, _, _, m) => f"Split({repr_of(cps(m))})",
            Pn.StrOp(m) => f"Str({repr_of(cps(m))})",
        }
    }
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_data(rel: ref String) -> Option[String] {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => Some(s),
        Err(_) => None,
    }
}

// a jobs.tsv column with its \\, \n and \t escapes undone
fn unescape(s: ref String) -> String {
    let c = cps(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < c.len() {
        if c[i] == 92 and i + 1 < c.len() {
            let n = c[i + 1];
            out.push(if n == 110 { 10 } else if n == 116 { 9 } else { n });
            i += 2;
        } else {
            out.push(c[i]);
            i += 1;
        }
    }
    to_string(out)
}

fn failure(e: ref PyErr) -> String {
    f"! {e.kind}: {e.msg}"
}

fn col(cols: ref Vec[String], i: i64) -> String {
    if i < cols.len() { cols[i].clone() } else { String.new() }
}

impl W {
    fn load_doc(mut ref self, name: ref String) -> i64 {
        if name.starts_with("{") or name.starts_with("[") {
            return self.load_json(name);
        }
        let text = read_data(f"docs/{name}.json").unwrap_or(String.new());
        self.load_json(text)
    }

    fn show_matches(mut ref self, r: ref Hits, out: mut ref Vec[String]) -> Result[(), PyErr] {
        let ms = self.as_list(r)?;
        if ms.len() == 0 {
            out.push("(none)".to_string());
        }
        for m in ms {
            if m < 0 {
                return Err(attr_error("NoneType".to_string(), "full_path"));
            }
            let p = self.full_path(m);
            let s = self.path_str(p)?;
            let v = self.dats[m].value;
            out.push(f"{s} = {self.repr(v)}");
        }
        Ok(())
    }

    fn run_job(mut ref self, kind: ref String, tree: i64, data: i64, arg: ref String, out: mut ref Vec[String]) -> Result[(), PyErr] {
        if kind == "find" {
            let r = self.find(tree, In.V(data))?;
            return self.show_matches(r, mut out);
        }
        if kind == "update" or kind == "create" {
            let v = self.load_json(arg);
            let r = if kind == "update" { self.update(tree, data, NewVal.V(v))? } else { self.update_or_create(tree, data, NewVal.V(v))? };
            out.push(self.repr(r));
            return Ok(());
        }
        if kind == "updatefn" {
            let r = self.update(tree, data, NewVal.F(arg.clone()))?;
            out.push(self.repr(r));
            return Ok(());
        }
        if kind == "findcreate" {
            let r = self.find_or_create(tree, In.V(data))?;
            self.show_matches(r, mut out)?;
            out.push(f"data {self.repr(data)}");
            return Ok(());
        }
        if kind == "filter" {
            let r = self.filter(tree, arg, data)?;
            out.push(self.repr(r));
        }
        Ok(())
    }

    // jsonpath_ng/bin/jsonpath.py: the expression, then each file's
    // matches, one str(value) per line
    fn run_cli(mut ref self, expr: ref String, files: ref String, out: mut ref Vec[String]) {
        let tree = match self.parse_path(expr, false) {
            Ok(t) => t,
            Err(e) => {
                out.push(failure(e));
                return;
            }
        };
        for name in files.split(" ") {
            let text = match read_data(name.to_string()) {
                Some(t) => t,
                None => continue,
            };
            let data = self.load_json(text);
            let ms = match self.find(tree, In.V(data)) {
                Ok(r) => match self.as_list(r) {
                    Ok(v) => v,
                    Err(e) => {
                        out.push(failure(e));
                        return;
                    }
                },
                Err(e) => {
                    out.push(failure(e));
                    return;
                }
            };
            if ms.len() == 0 {
                out.push(String.new());
            }
            for m in ms {
                if m < 0 {
                    out.push(failure(attr_error("NoneType".to_string(), "value")));
                    return;
                }
                let v = self.dats[m].value;
                out.push(self.pstr(v));
            }
        }
    }

    fn run(mut ref self, cols: ref Vec[String], out: mut ref Vec[String]) {
        let kind = cols[0].clone();
        let ext = cols[1] == "ext";
        let expr = unescape(cols[2]);
        let doc = col(cols, 3);
        let arg = col(cols, 4);
        if kind == "cli" {
            self.run_cli(expr, arg, mut out);
            return;
        }
        let tree = match self.parse_path(expr, ext) {
            Ok(t) => t,
            Err(e) => {
                out.push(failure(e));
                return;
            }
        };
        if kind == "parse" {
            out.push(f"tree {self.show(tree)}");
            return;
        }
        let data = self.load_doc(doc);
        if let Err(e) = self.run_job(kind, tree, data, arg, mut out) {
            out.push(failure(e));
        }
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut w = W {
        objs: Vec.new(),
        pns: Vec.new(),
        dats: Vec.new(),
        progs: Vec.new(),
        base: read_tables(base_tables()),
        ext: read_tables(ext_tables()),
        sub_prog: must_compile("sub\\(/(.*)/,\\s+(.*)\\)"),
        split_prog: must_compile("split(?:\\s+)?\\((?:\\s+)?(?P<quote>(?:(?:'|\"))?)(.+)(?P=quote)(?:\\s+)?,(?:\\s+)?((?:(?:\\-)?\\d+|\\*))(?:\\s+)?,(?:\\s+)?((?:\\-)?\\d+)(?:\\s+)?\\)"),
        str_prog: must_compile("str\\(\\)"),
    };
    // the heap's first value is LIST_KEY
    w.alloc(Obj.ListKey);
    let mut out: Vec[String] = Vec.new();
    let jobs = read_data("jobs.tsv".to_string()).unwrap_or(String.new());
    for line in jobs.split("\n") {
        if line.len() == 0 {
            continue;
        }
        let cols: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        if cols[0] == "==" {
            out.push(f"== {cols[1]}");
            continue;
        }
        let mut head: Vec[String] = Vec.new();
        for c in cols.iter() {
            if c.len() > 0 {
                head.push(c.clone());
            }
        }
        out.push(f"-- {join(head, " ")}");
        w.run(cols, mut out);
    }
    for line in out {
        println(line);
    }
}
