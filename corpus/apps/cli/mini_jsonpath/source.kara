// PLY's LALR tables for the base grammar (jsonpath_ng.parser) and the
// extended one (jsonpath_ng.ext.parser): productions, actions, gotos and
// the states that reduce without reading a token.
fn base_tables() -> String {
    let mut t = String.new();
    base_tables_text_0(mut t);
    t
}

fn ext_tables() -> String {
    let mut t = String.new();
    ext_tables_text_0(mut t);
    ext_tables_text_1(mut t);
    t
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    {
        let mut t = String.new();
        file_docs_config_json_0(mut t);
        v.push(DataFile { path: "docs/config.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_geo_json_0(mut t);
        v.push(DataFile { path: "docs/geo.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_issues_json_0(mut t);
        v.push(DataFile { path: "docs/issues.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_log_json_0(mut t);
        v.push(DataFile { path: "docs/log.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_metrics_json_0(mut t);
        v.push(DataFile { path: "docs/metrics.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_orders_json_0(mut t);
        v.push(DataFile { path: "docs/orders.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_org_json_0(mut t);
        v.push(DataFile { path: "docs/org.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_package_json_0(mut t);
        v.push(DataFile { path: "docs/package.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_pods_json_0(mut t);
        v.push(DataFile { path: "docs/pods.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_docs_store_json_0(mut t);
        v.push(DataFile { path: "docs/store.json".to_string(), body: t });
    }
    {
        let mut t = String.new();
        file_jobs_tsv_0(mut t);
        file_jobs_tsv_1(mut t);
        file_jobs_tsv_2(mut t);
        v.push(DataFile { path: "jobs.tsv".to_string(), body: t });
    }
    v
}

fn base_tables_text_0(t: mut ref String) {
    t.push_str("P S' 1 -\n");
    t.push_str("P jsonpath 3 p_jsonpath_binop\n");
    t.push_str("P jsonpath 3 p_jsonpath_binop\n");
    t.push_str("P jsonpath 3 p_jsonpath_binop\n");
    t.push_str("P jsonpath 3 p_jsonpath_binop\n");
    t.push_str("P jsonpath 3 p_jsonpath_binop\n");
    t.push_str("P jsonpath 3 p_jsonpath_binop\n");
    t.push_str("P jsonpath 1 p_jsonpath_fields\n");
    t.push_str("P jsonpath 1 p_jsonpath_named_operator\n");
    t.push_str("P jsonpath 1 p_jsonpath_root\n");
    t.push_str("P jsonpath 3 p_jsonpath_idx\n");
    t.push_str("P jsonpath 3 p_jsonpath_slice\n");
    t.push_str("P jsonpath 3 p_jsonpath_fieldbrackets\n");
    t.push_str("P jsonpath 4 p_jsonpath_child_fieldbrackets\n");
    t.push_str("P jsonpath 4 p_jsonpath_child_idxbrackets\n");
    t.push_str("P jsonpath 4 p_jsonpath_child_slicebrackets\n");
    t.push_str("P jsonpath 3 p_jsonpath_parens\n");
    t.push_str("P fields_or_any 1 p_fields_or_any\n");
    t.push_str("P fields_or_any 1 p_fields_or_any\n");
    t.push_str("P fields_or_any 1 p_fields_or_any\n");
    t.push_str("P fields 1 p_fields_id\n");
    t.push_str("P fields 3 p_fields_comma\n");
    t.push_str("P idx 1 p_idx\n");
    t.push_str("P slice 1 p_slice_any\n");
    t.push_str("P slice 3 p_slice\n");
    t.push_str("P slice 5 p_slice\n");
    t.push_str("P maybe_int 1 p_maybe_int\n");
    t.push_str("P maybe_int 1 p_maybe_int\n");
    t.push_str("P empty 0 p_empty\n");
    t.push_str("A 0 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 1 $end=0 &=16 .=11 DOUBLEDOT=12 WHERE=13 WHERENOT=14 [=17 |=15\n");
    t.push_str("A 2 $end=-7 &=-7 )=-7 .=-7 DOUBLEDOT=-7 WHERE=-7 WHERENOT=-7 [=-7 |=-7\n");
    t.push_str("A 3 $end=-8 &=-8 )=-8 .=-8 DOUBLEDOT=-8 WHERE=-8 WHERENOT=-8 [=-8 |=-8\n");
    t.push_str("A 4 $end=-9 &=-9 )=-9 .=-9 DOUBLEDOT=-9 WHERE=-9 WHERENOT=-9 [=-9 |=-9\n");
    t.push_str("A 5 *=22 :=-28 ID=10 NUMBER=21\n");
    t.push_str("A 6 $end=-17 &=-17 )=-17 ,=25 .=-17 DOUBLEDOT=-17 WHERE=-17 WHERENOT=-17 [=-17 |=-17\n");
    t.push_str("A 7 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 8 $end=-18 &=-18 )=-18 .=-18 DOUBLEDOT=-18 WHERE=-18 WHERENOT=-18 [=-18 |=-18\n");
    t.push_str("A 9 $end=-19 &=-19 )=-19 .=-19 DOUBLEDOT=-19 WHERE=-19 WHERENOT=-19 [=-19 |=-19\n");
    t.push_str("A 10 $end=-20 &=-20 )=-20 ,=-20 .=-20 DOUBLEDOT=-20 WHERE=-20 WHERENOT=-20 [=-20 ]=-20 |=-20\n");
    t.push_str("A 11 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 12 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 13 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 14 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 15 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 16 $=4 (=7 *=8 ID=10 NAMED_OPERATOR=3 NUMBER=9 [=5\n");
    t.push_str("A 17 *=22 :=-28 ID=10 NUMBER=21\n");
    t.push_str("A 18 ]=36\n");
    t.push_str("A 19 ]=37\n");
    t.push_str("A 20 ,=25 ]=38\n");
    t.push_str("A 21 :=-26 ]=-22\n");
    t.push_str("A 22 ]=-23\n");
    t.push_str("A 23 :=39\n");
    t.push_str("A 24 :=-27 ]=-27\n");
    t.push_str("A 25 ID=10\n");
    t.push_str("A 26 &=16 )=41 .=11 DOUBLEDOT=12 WHERE=13 WHERENOT=14 [=17 |=15\n");
    t.push_str("A 27 $end=-1 &=16 )=-1 .=-1 DOUBLEDOT=-1 WHERE=13 WHERENOT=14 [=-1 |=15\n");
