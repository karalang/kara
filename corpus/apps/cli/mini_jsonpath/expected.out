== parse: the base grammar
-- parse base $.store.book[0].title
tree Child(Child(Child(Child(Root(), Fields('store')), Fields('book')), Index(index=0)), Fields('title'))
-- parse base store.book[*].author
tree Child(Child(Child(Fields('store'), Fields('book')), Slice(start=None,end=None,step=None)), Fields('author'))
-- parse base $..author
tree Descendants(Root(), Fields('author'))
-- parse base $.store.*
tree Child(Child(Root(), Fields('store')), Fields('*'))
-- parse base $.store..price
tree Descendants(Child(Root(), Fields('store')), Fields('price'))
-- parse base $..book[2]
tree Child(Descendants(Root(), Fields('book')), Index(index=2))
-- parse base $..book[-1:]
tree Child(Descendants(Root(), Fields('book')), Slice(start=-1,end=None,step=None))
-- parse base $..book[0,1]
! JsonPathParserError: Parse error at 1:9 near token , (,)
-- parse base $..book[:2]
tree Child(Descendants(Root(), Fields('book')), Slice(start=None,end=2,step=None))
-- parse base $.store.book[1:3]
tree Child(Child(Child(Root(), Fields('store')), Fields('book')), Slice(start=1,end=3,step=None))
-- parse base $.store.book[::2]
tree Child(Child(Child(Root(), Fields('store')), Fields('book')), Slice(start=None,end=None,step=2))
-- parse base $['store']['bicycle']
tree Child(Child(Root(), Fields('store')), Fields('bicycle'))
-- parse base $.store.book[?(@.isbn)]
! JsonPathLexerError: Error on line 1, col 13: Unexpected character: ? 
-- parse base foo.bar | foo.baz
tree Child(Child(Fields('foo'), Union(Fields('bar'), Fields('foo'))), Fields('baz'))
-- parse base a where b
tree Where(Fields('a'), Fields('b'))
-- parse base a wherenot b
tree WhereNot(Fields('a'), Fields('b'))
-- parse base (a.b).c
tree Child(Child(Fields('a'), Fields('b')), Fields('c'))
-- parse base a.`this`.b
tree Child(Child(Fields('a'), This()), Fields('b'))
-- parse base a.`parent`
tree Child(Fields('a'), Parent())
-- parse base a & b
tree Intersect(Fields('a'), Fields('b'))
-- parse base 'quoted.key'.x
tree Child(Fields('quoted.key'), Fields('x'))
-- parse base "dq key"[3]
tree Child(Fields('dq key'), Index(index=3))
-- parse base items[*].metadata.labels.'app.kubernetes.io/name'
tree Child(Child(Child(Child(Fields('items'), Slice(start=None,end=None,step=None)), Fields('metadata')), Fields('labels')), Fields('app.kubernetes.io/name'))
-- parse base a.b,c.d
tree Child(Child(Fields('a'), Fields('b','c')), Fields('d'))
-- parse base 1.2
tree Child(Fields('1'), Fields('2'))
-- parse base @
tree Fields('@')
-- parse base $.store.book[
! JsonPathParserError: Parse error near the end of string!
-- parse base $..
! JsonPathParserError: Parse error near the end of string!
-- parse base a.`len`
! JsonPathParserError: Unknown named operator `len` at 1:6
-- parse base `foo`
! JsonPathParserError: Unknown named operator `foo` at 1:4
-- parse base a.'unterminated
! JsonPathLexerError: Unexpected EOF in string literal or identifier
-- parse base $.store.book[0]]
! JsonPathParserError: Parse error at 1:15 near token ] (])
-- parse base a\n.b \t. c
tree Child(Child(Fields('a'), Fields('b')), Fields('c'))
-- parse base a\n.]
! JsonPathParserError: Parse error at 2:2 near token ] (])
-- parse base a.b#c
! JsonPathLexerError: Error on line 1, col 3: Unexpected character: # 
-- parse base $[*]
tree Child(Root(), Slice(start=None,end=None,step=None))
-- parse base [*]
tree Slice(start=None,end=None,step=None)
-- parse base [1:]
tree Slice(start=1,end=None,step=None)
-- parse base *.x
tree Child(Fields('*'), Fields('x'))
-- parse base a..b..c
tree Descendants(Descendants(Fields('a'), Fields('b')), Fields('c'))
== parse: the extended grammar
-- parse ext $.store.book[?(@.price < 10)].title
tree Child(Child(Child(Child(Root(), Fields('store')), Fields('book')), Filter([Expression(Child(This(), Fields('price')) < 10)])), Fields('title'))
-- parse ext $.store.book[?price > 10]
tree Child(Child(Child(Root(), Fields('store')), Fields('book')), Filter([Expression(Fields('price') > 10)]))
-- parse ext $.store.book[?(@.category == 'fiction' & @.price > 10)]
tree Child(Child(Child(Root(), Fields('store')), Fields('book')), Filter([Expression(Child(This(), Fields('category')) == 'fiction'), Expression(Child(This(), Fields('price')) > 10)]))
-- parse ext $.items[?status.phase = Running]
tree Child(Child(Root(), Fields('items')), Filter([Expression(Child(Fields('status'), Fields('phase')) = 'Running')]))
-- parse ext $.store.book[\\price]
tree Child(Child(Child(Root(), Fields('store')), Fields('book')), SortedThis([(Fields('price'), True)]))
-- parse ext $.store.book[/price,\\title]
tree Child(Child(Child(Root(), Fields('store')), Fields('book')), SortedThis([(Fields('price'), False), (Fields('title'), True)]))
-- parse ext $.store.book[\\category, /price]
tree Child(Child(Child(Root(), Fields('store')), Fields('book')), SortedThis([(Fields('category'), True), (Fields('price'), False)]))
-- parse ext $.orders[*].lines[*].qty * $.orders[*].lines[*].price
tree Operation(Child(Child(Child(Child(Child(Root(), Fields('orders')), Slice(start=None,end=None,step=None)), Fields('lines')), Slice(start=None,end=None,step=None)), Fields('qty')) mul Child(Child(Child(Child(Child(Root(), Fields('orders')), Slice(start=None,end=None,step=None)), Fields('lines')), Slice(start=None,end=None,step=None)), Fields('price')))
-- parse ext $.a + 2
tree Operation(Child(Root(), Fields('a')) add 2)
-- parse ext 3 - 1
tree Operation(3 sub 1)
-- parse ext 1.5 * 2.0
tree Operation(1.5 mul 2.0)
-- parse ext $.a / 2
! JsonPathParserError: Parse error at 1:4 near token / (SORT_DIRECTION)
-- parse ext a.`len`
tree Child(Fields('a'), Len())
-- parse ext a.`keys`
tree Child(Fields('a'), Keys())
-- parse ext a.`path`
tree Child(Fields('a'), Path())
-- parse ext a.`sorted`
tree Child(Fields('a'), SortedThis(None))
-- parse ext a.`split(-, 0, -1)`
tree Child(Fields('a'), Split('split(-, 0, -1)'))
-- parse ext a.`sub(/(\\d+)ms/, \\1 ms)`
tree Child(Fields('a'), Sub('sub(/(d+)ms/, 1 ms)'))
-- parse ext a.`str()`
tree Child(Fields('a'), Str('str()'))
-- parse ext a.`split(x)`
! DefintionInvalid: split(x) is not valid
-- parse ext a.`nope`
! JsonPathParserError: Unknown named operator `nope` at 1:7
-- parse ext $.trueValue
! JsonPathParserError: Parse error at 1:2 near token True (BOOL)
-- parse ext $.falseStart
! JsonPathParserError: Parse error at 1:2 near token False (BOOL)
-- parse ext $[?(@.x =~ 'ab+c')]
tree Child(Root(), Filter([Expression(Child(This(), Fields('x')) =~ 'ab+c')]))
-- parse ext $[?(@.a == true)]
tree Child(Root(), Filter([Expression(Child(This(), Fields('a')) == True)]))
-- parse ext $[?(@.a != 1.5)]
tree Child(Root(), Filter([Expression(Child(This(), Fields('a')) != 1.5)]))
-- parse ext $[?(@.a >= -3)]
tree Child(Root(), Filter([Expression(Child(This(), Fields('a')) >= -3)]))
-- parse ext $[?(@.a <= b)]
tree Child(Root(), Filter([Expression(Child(This(), Fields('a')) <= 'b')]))
-- parse ext $[?(@.a)]
tree Child(Root(), Filter([Expression(Child(This(), Fields('a')))]))
-- parse ext $[?((@.a) & (@.b))]
tree Child(Root(), Filter([Expression(Intersect(Child(This(), Fields('a')), Child(This(), Fields('b'))))]))
-- parse ext $[?@.a > ]
! JsonPathParserError: Parse error at 1:9 near token ] (])
-- parse ext $..[?(@.name)]
! JsonPathParserError: Parse error at 1:4 near token ? (?)
-- parse ext $.a.@b
tree Child(Child(Root(), Fields('a')), Fields('@b'))
-- parse ext $.a-b
tree Child(Root(), Fields('a-b'))
-- parse ext $.a - b
tree Operation(Child(Root(), Fields('a')) sub 'b')
-- parse ext x - y
tree Operation('x' sub 'y')
-- parse ext $.a[?(@.b == "q")]
tree Child(Child(Root(), Fields('a')), Filter([Expression(Child(This(), Fields('b')) == 'q')]))
-- parse ext $.a[?]
! JsonPathParserError: Parse error at 1:5 near token ] (])
-- parse ext $[?(@ > 1)]
tree Child(Root(), Filter([Expression(This() > 1)]))
-- parse ext a | b + 1
tree Operation(Union(Fields('a'), Fields('b')) add 1)
-- parse ext a + b . c
tree Operation('a' add Child(Fields('b'), Fields('c')))
-- parse ext $.a[?(@.b > 1)].c[\\d]
tree Child(Child(Child(Child(Root(), Fields('a')), Filter([Expression(Child(This(), Fields('b')) > 1)])), Fields('c')), SortedThis([(Fields('d'), True)]))
