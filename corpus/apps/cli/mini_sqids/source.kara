// mini_sqids — sqids 0.5.2 (sqids/sqids.py), the successor to Hashids: it
// turns lists of non-negative integers into short, URL-safe, reversible ids
// ("86Rf07" for [1, 2, 3]) for public-facing database keys, with a profanity
// blocklist so no id spells a rude word. It ports the Sqids constructor (its
// alphabet / min_length checks and the blocklist filtering), encode with the
// offset-rotated, shuffled alphabet, separators, min_length padding and the
// blocklist re-generation loop, and decode, with the library's exact
// ValueError messages.
//
// The alphabet is ASCII by the library's own rule, so it is a byte vector.
// The library keeps the filtered blocklist in sets; here they are vectors,
// which is the same thing for "does any word match", the only question asked
// of them. The library's default constructor uses a pre-filtered copy of
// DEFAULT_BLOCKLIST; filtering the default list at construction gives the
// same three sets (checked during development). blocklist_text() is that
// default list and jobs_text() holds data/jobs.tsv.

struct Sqids {
    alphabet: Vec[u8],
    min_length: i64,
    exact: Vec[String],
    ends: Vec[String],
    anywhere: Vec[String],
}

const MAXSIZE: i64 = 9223372036854775807;

// ----------------------------------------------------------- small helpers

fn split_on(s: String, sep: u8) -> Vec[String] {
    let b = s.bytes().to_vec();
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for c in b {
        if c == sep {
            out.push(String.from_utf8(cur).unwrap_or("?".to_string()));
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(String.from_utf8(cur).unwrap_or("?".to_string()));
    out
}

fn to_i64(s: String) -> i64 {
    let b = s.bytes().to_vec();
    let mut i = 0;
    let mut neg = false;
    if b.len() > 0 and b[0] == b'-' {
        neg = true;
        i = 1;
    }
    let mut v = 0;
    while i < b.len() {
        v = v * 10 + (b[i] - b'0') as i64;
        i += 1;
    }
    if neg { -v } else { v }
}

fn bytes_str(b: Vec[u8]) -> String {
    String.from_utf8(b).unwrap_or("?".to_string())
}

fn lower_bytes(b: Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for c in b {
        if c >= b'A' and c <= b'Z' {
            out.push(c + 32);
        } else {
            out.push(c);
        }
    }
    out
}

fn has_byte(v: Vec[u8], c: u8) -> bool {
    let mut i = 0;
    let mut found = false;
    while i < v.len() {
        if v[i] == c {
            found = true;
            i = v.len();
        }
        i += 1;
    }
    found
}

fn index_of(v: Vec[u8], c: u8) -> i64 {
    let mut i = 0;
    let mut at = -1;
    while i < v.len() {
        if v[i] == c {
            at = i;
            i = v.len();
        }
        i += 1;
    }
    at
}

fn has_str(v: Vec[String], s: String) -> bool {
    let mut found = false;
    for w in v {
        if w == s {
            found = true;
        }
    }
    found
}

fn add_unique(v: mut ref Vec[String], s: own String) {
    if not has_str(v, s) {
        v.push(s);
    }
}

// alphabet[start:end] followed by alphabet[0:start] — Python's
// a[offset:] + a[:offset].
fn rotate(a: Vec[u8], offset: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = offset;
    while i < a.len() {
        out.push(a[i]);
        i += 1;
    }
    i = 0;
    while i < offset {
        out.push(a[i]);
        i += 1;
    }
    out
}

fn reversed(a: Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = a.len() - 1;
    while i >= 0 {
        out.push(a[i]);
        i -= 1;
    }
    out
}

fn tail(a: Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 1;
    while i < a.len() {
        out.push(a[i]);
        i += 1;
    }
    out
}

// ------------------------------------------------------------ the algorithm

fn shuffle(alphabet: Vec[u8]) -> Vec[u8] {
    let mut chars = alphabet.clone();
    let n = chars.len();
    let mut i = 0;
    let mut j = n - 1;
    while j > 0 {
        let r = (i * j + chars[i] as i64 + chars[j] as i64) % n;
        let t = chars[i];
        chars[i] = chars[r];
        chars[r] = t;
        i += 1;
        j -= 1;
    }
    chars
}

fn to_id(num: i64, alphabet: Vec[u8]) -> Vec[u8] {
    let n = alphabet.len();
    let mut digits: Vec[u8] = Vec.new();
    let mut result = num;
    let mut going = true;
    while going {
        digits.push(alphabet[result % n]);
        result = result / n;
        if result == 0 {
            going = false;
        }
    }
    reversed(digits)
}

fn to_number(id: Vec[u8], alphabet: Vec[u8]) -> i64 {
    let n = alphabet.len();
    let mut v = 0;
    for c in id {
        v = v * n + index_of(alphabet.clone(), c);
    }
    v
}

fn new_sqids(alphabet: String, min_length: i64, blocklist: Vec[String]) -> Result[Sqids, String] {
    let a = alphabet.bytes().to_vec();
    for c in a.clone() {
        if c > 127 {
            return Err("ValueError: Alphabet cannot contain multibyte characters".to_string());
        }
    }
    if a.len() < 3 {
        return Err("ValueError: Alphabet length must be at least 3".to_string());
    }
    let mut i = 0;
    while i < a.len() {
        let mut j = i + 1;
        while j < a.len() {
            if a[i] == a[j] {
                return Err("ValueError: Alphabet must contain unique characters".to_string());
            }
            j += 1;
        }
        i += 1;
    }
    if min_length < 0 or min_length > 255 {
        return Err("ValueError: Minimum length has to be between 0 and 255".to_string());
    }
    let alphabet_lower = lower_bytes(a.clone());
    let mut exact: Vec[String] = Vec.new();
    let mut ends: Vec[String] = Vec.new();
    let mut anywhere: Vec[String] = Vec.new();
    for word in blocklist {
        let wb = word.bytes().to_vec();
        if wb.len() >= 3 {
            let wl = lower_bytes(wb.clone());
            let mut subset = true;
            let mut digit = false;
            for c in wl.clone() {
                if not has_byte(alphabet_lower.clone(), c) {
                    subset = false;
                }
                if c >= b'0' and c <= b'9' {
                    digit = true;
                }
            }
            if subset {
                if wb.len() == 3 {
                    add_unique(mut exact, bytes_str(wl));
                } else if digit {
                    add_unique(mut ends, bytes_str(wl));
                } else {
                    add_unique(mut anywhere, bytes_str(wl));
                }
            }
        }
    }
    Ok(Sqids { alphabet: shuffle(a), min_length: min_length, exact: exact, ends: ends, anywhere: anywhere })
}

fn is_blocked_id(sq: Sqids, id: String) -> bool {
    let lid = bytes_str(lower_bytes(id.bytes().to_vec()));
    if lid.len() == 3 {
        return has_str(sq.exact.clone(), lid);
    }
    let mut blocked = false;
    for w in sq.ends.clone() {
        if lid.starts_with(w.clone()) or lid.ends_with(w.clone()) {
            blocked = true;
        }
    }
    for w in sq.anywhere.clone() {
        if lid.contains(w.clone()) {
            blocked = true;
        }
    }
    blocked
}

fn encode_numbers(sq: Sqids, numbers: Vec[i64], increment: i64) -> Result[String, String] {
    let n = sq.alphabet.len();
    if increment > n {
        return Err("ValueError: Reached max attempts to re-generate the ID".to_string());
    }
    let mut offset = 0;
    let mut k = 0;
    while k < numbers.len() {
        offset += sq.alphabet[numbers[k] % n] as i64 + k;
        k += 1;
    }
    offset = (offset + numbers.len()) % n;
    offset = (offset + increment) % n;
    let rotated = rotate(sq.alphabet.clone(), offset);
    let prefix = rotated[0];
    let mut alphabet = reversed(rotated);
    let mut ret: Vec[u8] = Vec.new();
    ret.push(prefix);
    let mut i = 0;
    while i < numbers.len() {
        for c in to_id(numbers[i], tail(alphabet.clone())) {
            ret.push(c);
        }
        if i < numbers.len() - 1 {
            ret.push(alphabet[0]);
            alphabet = shuffle(alphabet);
        }
        i += 1;
    }
    if sq.min_length > ret.len() {
        ret.push(alphabet[0]);
        while sq.min_length - ret.len() > 0 {
            alphabet = shuffle(alphabet);
            let mut take = sq.min_length - ret.len();
            if alphabet.len() < take {
                take = alphabet.len();
            }
            let mut t = 0;
            while t < take {
                ret.push(alphabet[t]);
                t += 1;
            }
        }
    }
    let id = bytes_str(ret);
    if id.len() >= 3 and is_blocked_id(sq, id) {
        return encode_numbers(sq, numbers, increment + 1);
    }
    Ok(id)
}

fn encode(sq: Sqids, numbers: Vec[i64]) -> Result[String, String] {
    if numbers.len() == 0 {
        return Ok(String.new());
    }
    for v in numbers.clone() {
        if v < 0 or v > MAXSIZE {
            return Err(f"ValueError: Encoding supports numbers between 0 and {MAXSIZE}");
        }
    }
    encode_numbers(sq, numbers, 0)
}

fn decode(sq: Sqids, id_s: String) -> Vec[i64] {
    let mut ret: Vec[i64] = Vec.new();
    let mut id = id_s.bytes().to_vec();
    if id.len() == 0 {
        return ret;
    }
    for c in id.clone() {
        if not has_byte(sq.alphabet.clone(), c) {
            return ret;
        }
    }
    let offset = index_of(sq.alphabet.clone(), id[0]);
    let mut alphabet = reversed(rotate(sq.alphabet.clone(), offset));
    id = tail(id);
    while id.len() > 0 {
        let separator = alphabet[0];
        let at = index_of(id.clone(), separator);
        let mut chunk: Vec[u8] = Vec.new();
        let mut rest: Vec[u8] = Vec.new();
        let mut i = 0;
        while i < id.len() {
            if at < 0 or i < at {
                chunk.push(id[i]);
            } else if i > at {
                rest.push(id[i]);
            }
            i += 1;
        }
        if chunk.len() == 0 {
            return ret;
        }
        ret.push(to_number(chunk, tail(alphabet.clone())));
        if at >= 0 {
            alphabet = shuffle(alphabet);
        }
        id = rest;
    }
    ret
}

// --------------------------------------------------------------- the jobs

fn join_nums(v: Vec[i64]) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{v[i]}");
        i += 1;
    }
    out
}

fn main_run() -> String {
    let mut out = String.new();
    let mut defaults: Vec[String] = Vec.new();
    for w in split_on(blocklist_text(), b'\n') {
        if w.len() > 0 {
            defaults.push(w.clone());
        }
    }
    let default_alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".to_string();
    let mut cur = Sqids { alphabet: Vec.new(), min_length: 0, exact: Vec.new(), ends: Vec.new(), anywhere: Vec.new() };
    let mut have = false;
    for line in split_on(jobs_text(), b'\n') {
        if line.len() > 0 {
            let f = split_on(line, b'\t');
            if f[0] == "new" {
                let alphabet = if f[1] == "-" { default_alphabet.clone() } else { f[1].clone() };
                let mut blocklist: Vec[String] = Vec.new();
                if f[3] == "-" {
                    blocklist = defaults.clone();
                } else if f[3].len() > 0 {
                    blocklist = split_on(f[3].clone(), b',');
                }
                let res = match new_sqids(alphabet, to_i64(f[2].clone()), blocklist) {
                    Ok(sq) => {
                        cur = sq;
                        have = true;
                        "ok".to_string()
                    }
                    Err(e) => {
                        have = false;
                        e
                    }
                };
                out.push_str(f"new({f[1]}, {f[2]}, {f[3]}) => {res}\n");
            } else if f[0] == "enc" {
                let mut nums: Vec[i64] = Vec.new();
                if f[1].len() > 0 {
                    for x in split_on(f[1].clone(), b',') {
                        nums.push(to_i64(x));
                    }
                }
                let res = if not have {
                    "no Sqids".to_string()
                } else {
                    match encode(cur, nums) {
                        Ok(id) => f"[{id}]",
                        Err(e) => e,
                    }
                };
                out.push_str(f"encode({join_nums(nums)}) => {res}\n");
            } else if f[0] == "dec" {
                let res = if have { join_nums(decode(cur, f[1].clone())) } else { "no Sqids".to_string() };
                out.push_str(f"decode({f[1]}) => [{res}]\n");
            }
        }
    }
    out
}

fn main() {
    print(main_run());
}

