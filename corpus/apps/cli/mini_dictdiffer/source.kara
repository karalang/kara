fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("{\"name\": \"change a value\", \"steps\": [[\"val\", \"a\", {\"a\": \"b\"}], [\"val\", \"b\", {\"a\": \"c\"}], [\"diff\", \"d\", \"a\", \"b\", {}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
    t.push_str("{\"name\": \"add a nested dict\", \"steps\": [[\"val\", \"a\", {}], [\"val\", \"b\", {\"a\": {\"b\": \"c\"}}], [\"diff\", \"d\", \"a\", \"b\", {}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
    t.push_str("{\"name\": \"add a nested dict, path_limit empty\", \"steps\": [[\"val\", \"a\", {}], [\"val\", \"b\", {\"a\": {\"b\": \"c\"}}], [\"diff\", \"d\", \"a\", \"b\", {\"path_limit\": []}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
    t.push_str("{\"name\": \"add a nested dict, path_limit a\", \"steps\": [[\"val\", \"a\", {}], [\"val\", \"b\", {\"a\": {\"b\": \"c\"}}], [\"diff\", \"d\", \"a\", \"b\", {\"path_limit\": [[\"a\"]]}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
    t.push_str("{\"name\": \"add a nested dict, path_limit a.b\", \"steps\": [[\"val\", \"a\", {}], [\"val\", \"b\", {\"a\": {\"b\": \"c\"}}], [\"diff\", \"d\", \"a\", \"b\", {\"path_limit\": [[\"a\", \"b\"]]}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
    t.push_str("{\"name\": \"add to a list\", \"steps\": [[\"val\", \"a\", {\"fruits\": []}], [\"val\", \"b\", {\"fruits\": [\"apple\", \"mango\"]}], [\"diff\", \"d\", \"a\", \"b\", {}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
    t.push_str("{\"name\": \"add to a list, expanded\", \"steps\": [[\"val\", \"a\", {\"fruits\": []}], [\"val\", \"b\", {\"fruits\": [\"apple\", \"mango\"]}], [\"diff\", \"d\", \"a\", \"b\", {\"expand\": true}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
    t.push_str("{\"name\": \"shrink a list\", \"steps\": [[\"val\", \"a\", {\"n\": [1, 2, 3, 4]}], [\"val\", \"b\", {\"n\": [1]}], [\"diff\", \"d\", \"a\", \"b\", {}], [\"patch\", \"p\", \"d\", \"a\"], [\"eq\", \"p\", \"b\"], [\"swap\", \"s\", \"d\"], [\"revert\", \"r\", \"d\", \"b\"], [\"eq\", \"r\", \"a\"]]}\n");
