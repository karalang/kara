    t.push_str("    \"cid\": {\n");
    t.push_str("      \"role\": \"dev\",\n");
    t.push_str("      \"email\": \"cid@example.org\"\n");
    t.push_str("    }\n");
    t.push_str("  },\n");
    t.push_str("  \"telemetry\": true\n");
    t.push_str("}\n");
    v.push(DataFile { path: "merge/ours.json".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("s\n");
    t.push_str("f\n");
    v.push(DataFile { path: "merge/picks.txt".to_string(), hex: false, body: t });
}

fn data_part_3(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# path (dotted, * and + as wildcards) and who wins: f ours, s theirs,\n");
    t.push_str("# ask to leave it for picks.txt\n");
    t.push_str("users.* s\n");
    t.push_str("version s\n");
    t.push_str("plugins ask\n");
    t.push_str("editor.size ask\n");
    v.push(DataFile { path: "merge/policy.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("{\n");
    t.push_str("  \"version\": 4,\n");
    t.push_str("  \"theme\": \"dark\",\n");
    t.push_str("  \"editor\": {\n");
    t.push_str("    \"font\": \"Fira Code\",\n");
    t.push_str("    \"size\": 15,\n");
    t.push_str("    \"tabs\": 2,\n");
    t.push_str("    \"wrap\": false\n");
    t.push_str("  },\n");
    t.push_str("  \"plugins\": [\n");
    t.push_str("    \"git\",\n");
    t.push_str("    \"lint\",\n");
    t.push_str("    \"test\"\n");
    t.push_str("  ],\n");
    t.push_str("  \"users\": {\n");
    t.push_str("    \"ann\": {\n");
    t.push_str("      \"role\": \"admin\",\n");
    t.push_str("      \"email\": \"ann@example.org\"\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    v.push(DataFile { path: "merge/theirs.json".to_string(), hex: false, body: t });
}
