== merge a change below against a remove
  lca = {'a': {'b': 1}}
  first = {'a': {'b': 2}}
  second = {}
  unresolved: 1
    ('change', 'a.b', (1, 2)) vs ('remove', '', [('a', {'b': 1})])
  picks: s
  first patches: [('change', 'a.b', (1, 2))]
  second patches: [('remove', '', [('a', {'b': 1})])]
  conflict: ('change', 'a.b', (1, 2)) vs ('remove', '', [('a', {'b': 1})]), took s
  unified: [('remove', '', [('a', {'b': 1})])]
