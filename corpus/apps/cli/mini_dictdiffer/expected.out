== merge list additions
  lca = {'l': [1]}
  first = {'l': [1, 2]}
  second = {'l': [1, 3]}
  unresolved: 1
    ('add', 'l', [(1, 2)]) vs ('add', 'l', [(1, 3)])
  picks: f
  first patches: [('add', 'l', [(1, 2)])]
  second patches: [('add', 'l', [(1, 3)])]
  conflict: ('add', 'l', [(1, 2)]) vs ('add', 'l', [(1, 3)]), took f
  unified: [('add', 'l', [(1, 2)])]
