== merge list additions on both sides of a key
  lca = {'l': [1], 'm': [1]}
  first = {'l': [1, 2]}
  second = {'m': [1, 3], 'l': [1]}
  unresolved: 1
    ('remove', '', [('m', [1])]) vs ('add', 'm', [(1, 3)])
  merge stops
== merge wildcard actions
  lca = {'users': {'ann': {'role': 'dev'}, 'bob': {'role': 'dev'}}, 'theme': 'light'}
  first = {'users': {'ann': {'role': 'lead'}, 'bob': {'role': 'ops'}}, 'theme': 'dark'}
  second = {'users': {'ann': {'role': 'admin'}, 'bob': {'role': 'qa'}}, 'theme': 'blue'}
  first patches: [('change', 'users.ann.role', ('dev', 'lead')), ('change', 'users.bob.role', ('dev', 'ops')), ('change', 'theme', ('light', 'dark'))]
  second patches: [('change', 'users.ann.role', ('dev', 'admin')), ('change', 'users.bob.role', ('dev', 'qa')), ('change', 'theme', ('light', 'blue'))]
  conflict: ('change', 'users.ann.role', ('dev', 'lead')) vs ('change', 'users.ann.role', ('dev', 'admin')), took s
  conflict: ('change', 'users.bob.role', ('dev', 'ops')) vs ('change', 'users.bob.role', ('dev', 'qa')), took s
  conflict: ('change', 'theme', ('light', 'dark')) vs ('change', 'theme', ('light', 'blue')), took f
  unified: [('change', 'theme', ('light', 'dark')), ('change', 'users.ann.role', ('dev', 'admin')), ('change', 'users.bob.role', ('dev', 'qa'))]
  merged: {'users': {'ann': {'role': 'admin'}, 'bob': {'role': 'qa'}}, 'theme': 'dark'}
== merge plus wildcard
  lca = {'p': {'x': 1, 'y': {'z': 1}}}
  first = {'p': {'x': 2, 'y': {'z': 2}}}
  second = {'p': {'x': 3, 'y': {'z': 3}}}
  first patches: [('change', 'p.x', (1, 2)), ('change', 'p.y.z', (1, 2))]
  second patches: [('change', 'p.x', (1, 3)), ('change', 'p.y.z', (1, 3))]
  conflict: ('change', 'p.x', (1, 2)) vs ('change', 'p.x', (1, 3)), took f
  conflict: ('change', 'p.y.z', (1, 2)) vs ('change', 'p.y.z', (1, 3)), took f
  unified: [('change', 'p.x', (1, 2)), ('change', 'p.y.z', (1, 2))]
  merged: {'p': {'x': 2, 'y': {'z': 2}}}
== merge star at the root
  lca = {'a': 1, 'b': {'c': 1}}
  first = {'a': 2, 'b': {'c': 2}}
  second = {'a': 3, 'b': {'c': 3}}
  first patches: [('change', 'a', (1, 2)), ('change', 'b.c', (1, 2))]
  second patches: [('change', 'a', (1, 3)), ('change', 'b.c', (1, 3))]
  conflict: ('change', 'a', (1, 2)) vs ('change', 'a', (1, 3)), took s
  conflict: ('change', 'b.c', (1, 2)) vs ('change', 'b.c', (1, 3)), took s
  unified: [('change', 'a', (1, 3)), ('change', 'b.c', (1, 3))]
  merged: {'a': 3, 'b': {'c': 3}}
== merge with path limits
  lca = {'cfg': {'a': 1, 'b': 1}}
  first = {'cfg': {'a': 2, 'b': 1}}
