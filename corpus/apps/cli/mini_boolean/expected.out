== the tokenizer
> tokenize('a & b')
  - (8, 'a', 0)
  - (1, '&', 2)
  - (8, 'b', 4)
> tokenize('abc')
  - (8, 'abc', 2)
> tokenize('a.b:c_d')
  - (8, 'a.b:c_d', 6)
> tokenize('not x or y')
  - (3, 'not', 2)
  - (8, 'x', 4)
  - (2, 'or', 7)
  - (8, 'y', 9)
> tokenize('(a|b)&c')
  - (4, '(', 0)
  - (8, 'a', 1)
  - (2, '|', 2)
  - (8, 'b', 3)
  - (5, ')', 4)
  - (1, '&', 5)
  - (8, 'c', 6)
> tokenize('[x]')
  - (4, '[', 0)
  - (8, 'x', 1)
  - (5, ']', 2)
> tokenize('1 0 true FALSE none')
  - (6, '1', 0)
  - (7, '0', 2)
  - (6, 'true', 7)
  - (7, 'FALSE', 13)
  - (7, 'none', 18)
> tokenize('  spaced  out  ')
  - (8, 'spaced', 7)
  - (8, 'out', 12)
> tokenize('x1 & 2x')
  - (8, 'x1', 1)
  - (1, '&', 3)
  - (8, '2x', 6)
> tokenize('a\nb')
  - (8, 'a', 0)
  - (8, 'b', 2)
> tokenize('a - b')
  - (8, 'a', 0)
  error ParseError: Unknown token for token: "-" at position: 2
> tokenize('_x & y_')
  - (8, '_x', 1)
  - (1, '&', 3)
  - (8, 'y_', 6)
> tokenize('AnD oR NoT')
  - (1, 'AnD', 2)
  - (2, 'oR', 5)
  - (3, 'NoT', 9)
> tokenize('a&&b')
  - (8, 'a', 0)
  - (1, '&', 1)
  - (1, '&', 2)
  - (8, 'b', 3)
> tokenize('café')
  - (8, 'café', 3)
== simplifying
> parse('a & a')
  -> AND(Symbol('a'), Symbol('a'))
  str: a&a
> simplify()
  -> Symbol('a')
  str: a
> parse('a | a')
  -> OR(Symbol('a'), Symbol('a'))
  str: a|a
> simplify()
  -> Symbol('a')
  str: a
> parse('a & b & a')
  -> AND(Symbol('a'), Symbol('b'), Symbol('a'))
  str: a&b&a
> simplify()
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('a & ~a')
  -> AND(Symbol('a'), NOT(Symbol('a')))
  str: a&~a
> simplify()
  -> FALSE
  str: 0
> parse('a | ~a')
  -> OR(Symbol('a'), NOT(Symbol('a')))
  str: a|~a
> simplify()
  -> TRUE
  str: 1
> parse('a & 1')
  -> AND(Symbol('a'), TRUE)
  str: a&(1)
> simplify()
  -> Symbol('a')
  str: a
> parse('a & 0')
  -> AND(Symbol('a'), FALSE)
  str: a&(0)
> simplify()
  -> FALSE
  str: 0
> parse('a | 1')
  -> OR(Symbol('a'), TRUE)
  str: a|(1)
> simplify()
  -> TRUE
  str: 1
> parse('a | 0')
  -> OR(Symbol('a'), FALSE)
  str: a|(0)
> simplify()
  -> Symbol('a')
  str: a
> parse('~~a')
  -> NOT(NOT(Symbol('a')))
  str: ~(~a)
> simplify()
  -> Symbol('a')
  str: a
> parse('~~~a')
  -> NOT(NOT(NOT(Symbol('a'))))
  str: ~(~(~a))
> simplify()
  -> NOT(Symbol('a'))
  str: ~a
> parse('~(~a & ~b)')
  -> NOT(AND(NOT(Symbol('a')), NOT(Symbol('b'))))
  str: ~(~a&~b)
> simplify()
  -> NOT(AND(NOT(Symbol('a')), NOT(Symbol('b'))))
  str: ~(~a&~b)
> parse('~1')
  -> NOT(TRUE)
  str: ~(1)
> simplify()
  -> FALSE
  str: 0
> parse('~0')
  -> NOT(FALSE)
  str: ~(0)
> simplify()
  -> TRUE
  str: 1
> parse('~(1 & a)')
  -> NOT(AND(TRUE, Symbol('a')))
  str: ~((1)&a)
> simplify()
  -> NOT(Symbol('a'))
  str: ~a
> parse('a & (a | b)')
  -> AND(Symbol('a'), OR(Symbol('a'), Symbol('b')))
  str: a&(a|b)
> simplify()
  -> Symbol('a')
  str: a
> parse('a | (a & b)')
  -> OR(Symbol('a'), AND(Symbol('a'), Symbol('b')))
  str: a|(a&b)
> simplify()
  -> Symbol('a')
  str: a
> parse('a & (~a | b)')
  -> AND(Symbol('a'), OR(NOT(Symbol('a')), Symbol('b')))
  str: a&(~a|b)
> simplify()
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('a | (~a & b)')
  -> OR(Symbol('a'), AND(NOT(Symbol('a')), Symbol('b')))
  str: a|(~a&b)
> simplify()
  -> OR(Symbol('a'), Symbol('b'))
  str: a|b
> parse('(a & b) | (a & ~b)')
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('a'), NOT(Symbol('b'))))
  str: (a&b)|(a&~b)
> simplify()
  -> Symbol('a')
  str: a
> parse('(a | b) & (a | ~b)')
  -> AND(OR(Symbol('a'), Symbol('b')), OR(Symbol('a'), NOT(Symbol('b'))))
  str: (a|b)&(a|~b)
> simplify()
  -> Symbol('a')
  str: a
> parse('(a & b & c) | (a & b & ~c)')
  -> OR(AND(Symbol('a'), Symbol('b'), Symbol('c')), AND(Symbol('a'), Symbol('b'), NOT(Symbol('c'))))
  str: (a&b&c)|(a&b&~c)
> simplify()
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('c & b & a')
  -> AND(Symbol('c'), Symbol('b'), Symbol('a'))
  str: c&b&a
> simplify()
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'))
  str: a&b&c
> parse('c | b | a')
  -> OR(Symbol('c'), Symbol('b'), Symbol('a'))
  str: c|b|a
> simplify()
  -> OR(Symbol('a'), Symbol('b'), Symbol('c'))
  str: a|b|c
> parse('~c & b & ~a')
  -> AND(NOT(Symbol('c')), Symbol('b'), NOT(Symbol('a')))
  str: ~c&b&~a
> simplify()
  -> AND(NOT(Symbol('a')), Symbol('b'), NOT(Symbol('c')))
  str: ~a&b&~c
> parse('(b|a) & (d|c)')
  -> AND(OR(Symbol('b'), Symbol('a')), OR(Symbol('d'), Symbol('c')))
  str: (b|a)&(d|c)
> simplify()
  -> AND(OR(Symbol('a'), Symbol('b')), OR(Symbol('c'), Symbol('d')))
  str: (a|b)&(c|d)
> parse('a & (b & (c & d))')
  -> AND(Symbol('a'), AND(Symbol('b'), AND(Symbol('c'), Symbol('d'))))
  str: a&(b&(c&d))
> simplify()
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'), Symbol('d'))
  str: a&b&c&d
> parse('a | (b | (c | d))')
  -> OR(Symbol('a'), OR(Symbol('b'), OR(Symbol('c'), Symbol('d'))))
  str: a|(b|(c|d))
> simplify()
  -> OR(Symbol('a'), Symbol('b'), Symbol('c'), Symbol('d'))
  str: a|b|c|d
> parse('(a & b) | (c & d) | (a & b)')
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('c'), Symbol('d')), AND(Symbol('a'), Symbol('b')))
  str: (a&b)|(c&d)|(a&b)
> simplify()
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('c'), Symbol('d')))
  str: (a&b)|(c&d)
> parse('x & y | x & ~y | ~x & y')
  -> OR(AND(Symbol('x'), Symbol('y')), AND(Symbol('x'), NOT(Symbol('y'))), AND(NOT(Symbol('x')), Symbol('y')))
  str: (x&y)|(x&~y)|(~x&y)
> simplify()
  -> OR(Symbol('x'), Symbol('y'))
  str: x|y
> parse('(a | b) & (a | c) & (b | c)')
  -> AND(OR(Symbol('a'), Symbol('b')), OR(Symbol('a'), Symbol('c')), OR(Symbol('b'), Symbol('c')))
  str: (a|b)&(a|c)&(b|c)
> simplify()
  -> AND(OR(Symbol('a'), Symbol('b')), OR(Symbol('a'), Symbol('c')), OR(Symbol('b'), Symbol('c')))
  str: (a|b)&(a|c)&(b|c)
> parse('a & b | a & c | b & c')
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('a'), Symbol('c')), AND(Symbol('b'), Symbol('c')))
  str: (a&b)|(a&c)|(b&c)
> simplify()
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('a'), Symbol('c')), AND(Symbol('b'), Symbol('c')))
  str: (a&b)|(a&c)|(b&c)
> parse('~(a & b) | (a & b)')
  -> OR(NOT(AND(Symbol('a'), Symbol('b'))), AND(Symbol('a'), Symbol('b')))
  str: (~(a&b))|(a&b)
> simplify()
  -> OR(NOT(Symbol('a')), Symbol('b'), NOT(Symbol('b')))
  str: ~a|b|~b
> parse('(a|b)&~(a|b)')
  -> AND(OR(Symbol('a'), Symbol('b')), NOT(OR(Symbol('a'), Symbol('b'))))
  str: (a|b)&(~(a|b))
> simplify()
  -> AND(NOT(Symbol('a')), Symbol('b'), NOT(Symbol('b')))
  str: ~a&b&~b
> parse('a & (b | ~b)')
  -> AND(Symbol('a'), OR(Symbol('b'), NOT(Symbol('b'))))
  str: a&(b|~b)
> simplify()
  -> Symbol('a')
  str: a
> parse('(a & ~b) | (~a & b) | (a & b)')
  -> OR(AND(Symbol('a'), NOT(Symbol('b'))), AND(NOT(Symbol('a')), Symbol('b')), AND(Symbol('a'), Symbol('b')))
  str: (a&~b)|(~a&b)|(a&b)
> simplify()
  -> OR(Symbol('a'), Symbol('b'))
  str: a|b
> parse('~(a | ~(b & ~c))')
  -> NOT(OR(Symbol('a'), NOT(AND(Symbol('b'), NOT(Symbol('c'))))))
  str: ~(a|(~(b&~c)))
> simplify()
  -> NOT(OR(Symbol('a'), NOT(Symbol('b')), Symbol('c')))
  str: ~(a|~b|c)
> parse('(a | 0) & (b | 1)')
  -> AND(OR(Symbol('a'), FALSE), OR(Symbol('b'), TRUE))
  str: (a|(0))&(b|(1))
> simplify()
  -> Symbol('a')
  str: a
> parse('a & b & c & ~a')
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'), NOT(Symbol('a')))
  str: a&b&c&~a
> simplify()
  -> FALSE
  str: 0
> parse('a & (b | c)')
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> flags
  -> isliteral=False iscanonical=False
> simplify()
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> flags
  -> isliteral=False iscanonical=True
> simplify()
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> flags
  -> isliteral=False iscanonical=True
== normal forms
> parse('a & (b | c)')
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> keep as orig
> algebra.cnf(expr)
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> use orig
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> algebra.dnf(expr)
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('a'), Symbol('c')))
  str: (a&b)|(a&c)
> parse('a | (b & c)')
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')))
  str: a|(b&c)
> keep as orig
