== the methods one at a time
> parse('a & ~(b | c)')
  -> AND(Symbol('a'), NOT(OR(Symbol('b'), Symbol('c'))))
  str: a&(~(b|c))
> literalize()
  -> AND(Symbol('a'), AND(NOT(Symbol('b')), NOT(Symbol('c'))))
  str: a&(~b&~c)
> parse('~(~(a & b))')
  -> NOT(NOT(AND(Symbol('a'), Symbol('b'))))
  str: ~(~(a&b))
> cancel()
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('~~~(a | b)')
  -> NOT(NOT(NOT(OR(Symbol('a'), Symbol('b')))))
  str: ~(~(~(a|b)))
> cancel()
  -> NOT(OR(Symbol('a'), Symbol('b')))
  str: ~(a|b)
> demorgan()
  -> AND(NOT(Symbol('a')), NOT(Symbol('b')))
  str: ~a&~b
> parse('~(a | ~(b & c))')
  -> NOT(OR(Symbol('a'), NOT(AND(Symbol('b'), Symbol('c')))))
  str: ~(a|(~(b&c)))
> demorgan()
  -> AND(NOT(Symbol('a')), AND(Symbol('b'), Symbol('c')))
  str: ~a&(b&c)
> literalize()
  -> AND(NOT(Symbol('a')), AND(Symbol('b'), Symbol('c')))
  str: ~a&(b&c)
> parse('a & b')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> demorgan()
  error AttributeError: 'AND' object has no attribute 'demorgan'
> parse('a & (b & c) & (d & e)')
  -> AND(Symbol('a'), AND(Symbol('b'), Symbol('c')), AND(Symbol('d'), Symbol('e')))
  str: a&(b&c)&(d&e)
> flatten()
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'), Symbol('d'), Symbol('e'))
  str: a&b&c&d&e
> parse('a | (b & c) | (d | e)')
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')), OR(Symbol('d'), Symbol('e')))
  str: a|(b&c)|(d|e)
> flatten()
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')), Symbol('d'), Symbol('e'))
  str: a|(b&c)|d|e
> parse('a')
  -> Symbol('a')
  str: a
> flatten()
  error AttributeError: 'Symbol' object has no attribute 'flatten'
> parse('a & (b | c)')
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> distributive()
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('a'), Symbol('c')))
  str: (a&b)|(a&c)
> parse('(a | b) & (c | d)')
  -> AND(OR(Symbol('a'), Symbol('b')), OR(Symbol('c'), Symbol('d')))
  str: (a|b)&(c|d)
> distributive()
  -> OR(AND(Symbol('a'), Symbol('c')), AND(Symbol('a'), Symbol('d')), AND(Symbol('b'), Symbol('c')), AND(Symbol('b'), Symbol('d')))
  str: (a&c)|(a&d)|(b&c)|(b&d)
> parse('a | (b & c) | (d & e)')
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')), AND(Symbol('d'), Symbol('e')))
  str: a|(b&c)|(d&e)
> distributive()
  -> AND(OR(Symbol('a'), Symbol('b'), Symbol('d')), OR(Symbol('a'), Symbol('b'), Symbol('e')), OR(Symbol('a'), Symbol('c'), Symbol('d')), OR(Symbol('a'), Symbol('c'), Symbol('e')))
  str: (a|b|d)&(a|b|e)&(a|c|d)&(a|c|e)
> parse('a & b & c')
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'))
  str: a&b&c
> subtract('b', simplify=False)
  -> AND(Symbol('a'), Symbol('c'))
  str: a&c
> subtract('a', simplify=False)
  -> Symbol('c')
  str: c
> subtract('c', simplify=False)
  error AttributeError: 'Symbol' object has no attribute 'subtract'
> parse('a & b & c')
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'))
  str: a&b&c
> subtract('a & c', simplify=False)
  -> Symbol('b')
  str: b
> parse('a & b & c')
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'))
  str: a&b&c
> subtract('a & d', simplify=False)
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'))
  str: a&b&c
> parse('a & b')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> subtract('a & b', simplify=False)
  -> None
> parse('a & (b | c) & b')
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')), Symbol('b'))
  str: a&(b|c)&b
> subtract('b', simplify=True)
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> parse('~a')
  -> NOT(Symbol('a'))
  str: ~a
> subtract('a', simplify=False)
  error AttributeError: 'NOT' object has no attribute 'subtract'
> parse('1')
  -> TRUE
  str: 1
> demorgan()
  error AttributeError: '_TRUE' object has no attribute 'demorgan'
> parse('~1')
  -> NOT(TRUE)
  str: ~(1)
> demorgan()
  -> FALSE
  str: 0
