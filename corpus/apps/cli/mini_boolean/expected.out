> keep as e1
> or bc
  -> OR(AND(OR(Symbol('b'), Symbol('c')), Symbol('a')), OR(Symbol('b'), Symbol('c')))
  str: ((b|c)&a)|(b|c)
> invert
  -> NOT(OR(AND(OR(Symbol('b'), Symbol('c')), Symbol('a')), OR(Symbol('b'), Symbol('c'))))
  str: ~(((b|c)&a)|(b|c))
> simplify()
  -> NOT(OR(Symbol('b'), Symbol('c'), AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))))
  str: ~(b|c|(a&(b|c)))
> use e1
  -> AND(OR(Symbol('b'), Symbol('c')), Symbol('a'))
  str: (b|c)&a
> invert
  -> NOT(AND(OR(Symbol('b'), Symbol('c')), Symbol('a')))
  str: ~((b|c)&a)
> invert
  -> NOT(NOT(AND(OR(Symbol('b'), Symbol('c')), Symbol('a'))))
  str: ~(~((b|c)&a))
> simplify()
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
