== symbols and literals
> parse('a & b & ~a')
  -> AND(Symbol('a'), Symbol('b'), NOT(Symbol('a')))
  str: a&b&~a
> literals
  - NOT(Symbol('a'))
  - Symbol('a')
  - Symbol('b')
> symbols
  - Symbol('a')
  - Symbol('b')
> objects
  - 'a'
  - 'b'
> get_literals
  -> [Symbol('a'), Symbol('b'), NOT(Symbol('a'))]
> get_symbols
  -> [Symbol('a'), Symbol('b'), Symbol('a')]
> parse('x | ~y | ~~z')
  -> OR(Symbol('x'), NOT(Symbol('y')), NOT(NOT(Symbol('z'))))
  str: x|~y|(~(~z))
> literals
  - NOT(Symbol('y'))
  - NOT(Symbol('z'))
  - Symbol('x')
> symbols
  - Symbol('x')
  - Symbol('y')
  - Symbol('z')
