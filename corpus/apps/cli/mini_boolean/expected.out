== the documentation's examples
> parse('x & y')
  -> AND(Symbol('x'), Symbol('y'))
  str: x&y
> simplify()
  -> AND(Symbol('x'), Symbol('y'))
  str: x&y
> parse('(apple or banana and (orange or pineapple and (lemon or cherry)))')
  -> OR(Symbol('apple'), AND(Symbol('banana'), OR(Symbol('orange'), AND(Symbol('pineapple'), OR(Symbol('lemon'), Symbol('cherry'))))))
  str: apple|(banana&(orange|(pineapple&(lemon|cherry))))
> simplify()
  -> OR(Symbol('apple'), AND(Symbol('banana'), OR(Symbol('orange'), AND(Symbol('pineapple'), OR(Symbol('cherry'), Symbol('lemon'))))))
  str: apple|(banana&(orange|(pineapple&(cherry|lemon))))
> parse('x&~x')
  -> AND(Symbol('x'), NOT(Symbol('x')))
  str: x&~x
> simplify()
  -> FALSE
  str: 0
> parse('x|~x')
  -> OR(Symbol('x'), NOT(Symbol('x')))
  str: x|~x
> simplify()
  -> TRUE
  str: 1
> parse('x|x')
  -> OR(Symbol('x'), Symbol('x'))
  str: x|x
> simplify()
  -> Symbol('x')
  str: x
> parse('x&x')
  -> AND(Symbol('x'), Symbol('x'))
  str: x&x
> simplify()
  -> Symbol('x')
  str: x
> parse('x&(x|y)')
  -> AND(Symbol('x'), OR(Symbol('x'), Symbol('y')))
  str: x&(x|y)
> simplify()
  -> Symbol('x')
  str: x
> parse('(x&y) | (x&~y)')
  -> OR(AND(Symbol('x'), Symbol('y')), AND(Symbol('x'), NOT(Symbol('y'))))
  str: (x&y)|(x&~y)
> simplify()
  -> Symbol('x')
  str: x
> parse('(((x|y)&z)|x&y)')
  -> OR(AND(OR(Symbol('x'), Symbol('y')), Symbol('z')), AND(Symbol('x'), Symbol('y')))
  str: ((x|y)&z)|(x&y)
> simplify()
  -> OR(AND(Symbol('x'), Symbol('y')), AND(Symbol('z'), OR(Symbol('x'), Symbol('y'))))
  str: (x&y)|(z&(x|y))
> parse('apple and (banana or orange)')
  -> AND(Symbol('apple'), OR(Symbol('banana'), Symbol('orange')))
  str: apple&(banana|orange)
> simplify()
  -> AND(Symbol('apple'), OR(Symbol('banana'), Symbol('orange')))
  str: apple&(banana|orange)
> parse('not a and not b and not (a and ba and c) and c or c')
  -> OR(AND(NOT(Symbol('a')), NOT(Symbol('b')), NOT(AND(Symbol('a'), Symbol('ba'), Symbol('c'))), Symbol('c')), Symbol('c'))
  str: (~a&~b&(~(a&ba&c))&c)|c
> simplify()
  -> Symbol('c')
  str: c
> parse('apple and (oranges or banana) and not banana')
  -> AND(Symbol('apple'), OR(Symbol('oranges'), Symbol('banana')), NOT(Symbol('banana')))
  str: apple&(oranges|banana)&~banana
> simplify()
  -> AND(Symbol('apple'), NOT(Symbol('banana')), Symbol('oranges'))
  str: apple&~banana&oranges
> parse('apple and (oranges or banana) and not banana', simplify=True)
  -> AND(Symbol('apple'), NOT(Symbol('banana')), Symbol('oranges'))
  str: apple&~banana&oranges
> parse('~(a&b)')
  -> NOT(AND(Symbol('a'), Symbol('b')))
  str: ~(a&b)
> demorgan()
  -> OR(NOT(Symbol('a')), NOT(Symbol('b')))
  str: ~a|~b
> parse('a & (b | c)')
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> algebra.cnf(expr)
  -> AND(Symbol('a'), OR(Symbol('b'), Symbol('c')))
  str: a&(b|c)
> parse('a | (b & c)')
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')))
  str: a|(b&c)
> algebra.dnf(expr)
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')))
  str: a|(b&c)
> parse('(a|b)&(c|d)')
  -> AND(OR(Symbol('a'), Symbol('b')), OR(Symbol('c'), Symbol('d')))
  str: (a|b)&(c|d)
> algebra.dnf(expr)
  -> OR(AND(Symbol('a'), Symbol('c')), AND(Symbol('a'), Symbol('d')), AND(Symbol('b'), Symbol('c')), AND(Symbol('b'), Symbol('d')))
  str: (a&c)|(a&d)|(b&c)|(b&d)
== the grammar
> parse('a')
  -> Symbol('a')
  str: a
> parse('a and b')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('a AND b')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('a And b')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('a * b')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('a & b')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('a or b')
  -> OR(Symbol('a'), Symbol('b'))
  str: a|b
> parse('a OR b')
  -> OR(Symbol('a'), Symbol('b'))
  str: a|b
> parse('a + b')
  -> OR(Symbol('a'), Symbol('b'))
  str: a|b
> parse('a | b')
  -> OR(Symbol('a'), Symbol('b'))
  str: a|b
> parse('not a')
  -> NOT(Symbol('a'))
  str: ~a
> parse('NOT a')
  -> NOT(Symbol('a'))
  str: ~a
> parse('~a')
  -> NOT(Symbol('a'))
  str: ~a
> parse('!a')
  -> NOT(Symbol('a'))
  str: ~a
> parse('~~a')
  -> NOT(NOT(Symbol('a')))
  str: ~(~a)
> parse('not not not a')
  -> NOT(NOT(NOT(Symbol('a'))))
  str: ~(~(~a))
> parse('[a | b] & c')
  -> AND(OR(Symbol('a'), Symbol('b')), Symbol('c'))
  str: (a|b)&c
> parse('(a)')
  -> Symbol('a')
  str: a
> parse('((a))')
  -> Symbol('a')
  str: a
> parse('(((a & b)))')
  -> AND(Symbol('a'), Symbol('b'))
  str: a&b
> parse('true')
  -> TRUE
  str: 1
> parse('TRUE')
  -> TRUE
  str: 1
> parse('1')
  -> TRUE
  str: 1
> parse('false')
  -> FALSE
  str: 0
> parse('False')
  -> FALSE
  str: 0
> parse('0')
  -> FALSE
  str: 0
> parse('none')
  -> FALSE
  str: 0
> parse('None')
  -> FALSE
  str: 0
> parse('a & 1')
  -> AND(Symbol('a'), TRUE)
  str: a&(1)
> parse('a | 0')
  -> OR(Symbol('a'), FALSE)
  str: a|(0)
> parse('~1')
  -> NOT(TRUE)
  str: ~(1)
> parse('~0')
  -> NOT(FALSE)
  str: ~(0)
> parse('1 & 0')
  -> AND(TRUE, FALSE)
  str: (1)&(0)
> parse('1|0')
  -> OR(TRUE, FALSE)
  str: (1)|(0)
> parse('a & b & c & d')
  -> AND(Symbol('a'), Symbol('b'), Symbol('c'), Symbol('d'))
  str: a&b&c&d
> parse('a | b | c')
  -> OR(Symbol('a'), Symbol('b'), Symbol('c'))
  str: a|b|c
> parse('a & b | c & d')
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('c'), Symbol('d')))
  str: (a&b)|(c&d)
> parse('a | b & c | d')
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')), Symbol('d'))
  str: a|(b&c)|d
> parse('a & ~b | ~c & d')
  -> OR(AND(Symbol('a'), NOT(Symbol('b'))), AND(NOT(Symbol('c')), Symbol('d')))
  str: (a&~b)|(~c&d)
> parse('~(a | b) & c')
  -> AND(NOT(OR(Symbol('a'), Symbol('b'))), Symbol('c'))
  str: (~(a|b))&c
> parse('~a & (b | ~c)')
  -> AND(NOT(Symbol('a')), OR(Symbol('b'), NOT(Symbol('c'))))
  str: ~a&(b|~c)
> parse('a.b & c:d & e_f & _g')
  -> AND(Symbol('a.b'), Symbol('c:d'), Symbol('e_f'), Symbol('_g'))
  str: a.b&c:d&e_f&_g
> parse('x1 & 2x & 42')
  -> AND(Symbol('x1'), Symbol('2x'), Symbol('42'))
  str: x1&2x&42
> parse('foo.bar.baz | a:b:c')
  -> OR(Symbol('foo.bar.baz'), Symbol('a:b:c'))
  str: foo.bar.baz|a:b:c
> parse('a\nand\tb\r\nor c')
  -> OR(AND(Symbol('a'), Symbol('b')), Symbol('c'))
  str: (a&b)|c
> parse('  a   ')
  -> Symbol('a')
  str: a
> parse('café and thé')
  -> AND(Symbol('café'), Symbol('thé'))
  str: café&thé
> parse('apple AND NOT banana OR cherry')
  -> OR(AND(Symbol('apple'), NOT(Symbol('banana'))), Symbol('cherry'))
  str: (apple&~banana)|cherry
> parse('a & (b | (c & (d | (e & f))))')
  -> AND(Symbol('a'), OR(Symbol('b'), AND(Symbol('c'), OR(Symbol('d'), AND(Symbol('e'), Symbol('f'))))))
  str: a&(b|(c&(d|(e&f))))
> parse('a or b and c or d and e and f or g')
  -> OR(Symbol('a'), AND(Symbol('b'), Symbol('c')), AND(Symbol('d'), Symbol('e'), Symbol('f')), Symbol('g'))
  str: a|(b&c)|(d&e&f)|g
> parse('a & b | c & d', simplify=True)
  -> OR(AND(Symbol('a'), Symbol('b')), AND(Symbol('c'), Symbol('d')))
  str: (a&b)|(c&d)
> parse('~(a & ~b) | ~~c', simplify=True)
  -> OR(NOT(Symbol('a')), Symbol('b'), Symbol('c'))
  str: ~a|b|c
