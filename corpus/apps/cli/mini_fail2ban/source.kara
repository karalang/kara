fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("jail.local".to_string(), file_0()));
    v.push(("filter.d/common.conf".to_string(), file_1()));
    v.push(("filter.d/sshd.conf".to_string(), file_2()));
    v.push(("filter.d/nginx-http-auth.conf".to_string(), file_3()));
    v.push(("filter.d/postfix-sasl.conf".to_string(), file_4()));
    v.push(("filter.d/vsftpd.conf".to_string(), file_5()));
    v.push(("log/auth.log".to_string(), file_6()));
    v.push(("log/nginx/error.log".to_string(), file_7()));
    v.push(("log/mail.log".to_string(), file_8()));
    v
}

// ------------------------------------------------------------ jails

struct Ban {
    ip: String,
    end: i64,
}

fn log(t: i64, who: String, jail: Str, msg: String) {
    println(f"{stamp(t)} {who:<17}[{jail}] {msg}");
}

fn setting(cfg: ref Section, key: Str, default: i64) -> i64 {
    match cfg.get(key) {
        Some(v) => i64.parse(v).unwrap_or(default),
        None => default,
    }
}

fn first_host(res: ref Vec[Regex], rest: Str) -> Option[String] {
    for r in res {
        if let Some(c) = r.captures(rest) {
            if let Some(m) = c.name("host") {
                return Some(m.text);
            }
        }
    }
    None
}

fn run_jail(name: Str, cfg: ref Section, filter: ref Filter, dates: ref DateDetector) -> Result[Vec[Ban], String] {
    let maxretry = setting(cfg, "maxretry", 5);
    let findtime = setting(cfg, "findtime", 600);
    let bantime = setting(cfg, "bantime", 600);
    let increment = cfg.get("bantime.increment").unwrap_or("false".to_string()) == "true";
    let maxtime = setting(cfg, "bantime.maxtime", 0);
    let ignores: Vec[String] = cfg.get("ignoreip").unwrap_or(String.new()).split_whitespace().map(|p| p.to_string()).collect();
    let inc = if increment { f" (increment, max {maxtime}s)" } else { String.new() };
    println(f"Jail '{name}': {filter.fail.len()} failregex, {filter.ignore.len()} ignoreregex, maxretry {maxretry}, findtime {findtime}s, bantime {bantime}s{inc}");
    let mut fres: Vec[Regex] = Vec.new();
    for r in filter.fail {
        println(f"  failregex: {r}");
        match Regex.compile(r.as_str()) {
            Ok(re) => fres.push(re),
            Err(e) => return Err(e.message),
        }
    }
    let mut ires: Vec[Regex] = Vec.new();
    for r in filter.ignore {
        println(f"  ignoreregex: {r}");
        match Regex.compile(r.as_str()) {
            Ok(re) => ires.push(re),
            Err(e) => return Err(e.message),
        }
    }
    let logpath = cfg.get("logpath").unwrap_or(String.new());
    let text = read_file(logpath.as_str()).unwrap_or(String.new());

    // Failure times per address, in the order the addresses first failed.
    let mut hosts: Vec[String] = Vec.new();
    let mut failures: Vec[Vec[i64]] = Vec.new();
    let mut bans: Vec[Ban] = Vec.new();
    let mut bancount: Map[String, i64] = Map.new();
    let mut total_failed = 0;
    let mut total_banned = 0;
    let mut lines = 0;
    let mut nodate = 0;
    let mut ign_count = 0;
    for line in text.split("\n") {
        if line.is_empty() {
            continue;
        }
        lines += 1;
        let (t, rest) = match dates.detect(line.as_str()) {
            Some(d) => d,
            None => {
                nodate += 1;
                continue;
            }
        };
        // Bans that ran out before this line, earliest first.
        loop {
            let mut due: i64 = -1;
            for i in 0..bans.len() {
                if bans[i].end <= t {
                    if due < 0 or bans[i].end < bans[due].end or (bans[i].end == bans[due].end and bans[i].ip < bans[due].ip) {
                        due = i;
                    }
                }
            }
            if due < 0 {
                break;
            }
            let b = bans.remove(due);
            log(b.end, "fail2ban.actions".to_string(), name, f"Unban {b.ip}");
        }
        let host = match first_host(fres, rest.as_str()) {
            Some(h) => h,
            None => continue,
        };
        if ires.iter().any(|r| r.is_match(rest.as_str())) {
            ign_count += 1;
            continue;
        }
        if ignored(host.as_str(), ignores) {
            log(t, "fail2ban.filter".to_string(), name, f"Ignore {host} by ip");
            continue;
        }
        log(t, "fail2ban.filter".to_string(), name, f"Found {host}");
        total_failed += 1;
        if bans.iter().any(|b| b.ip == host) {
            log(t, "fail2ban.actions".to_string(), name, f"{host} already banned");
            continue;
        }
        let mut slot: i64 = -1;
        for i in 0..hosts.len() {
            if hosts[i] == host {
                slot = i;
            }
        }
        if slot < 0 {
            hosts.push(host.clone());
            failures.push(Vec.new());
            slot = hosts.len() - 1;
        }
        let mut kept: Vec[i64] = Vec.new();
        for x in failures[slot] {
            if x > t - findtime {
                kept.push(*x);
            }
        }
        kept.push(t);
        let count = kept.len();
        failures[slot] = kept;
        if count >= maxretry {
            let n = bancount.get(host).unwrap_or(0) + 1;
            bancount.insert(host.clone(), n);
            let mut dur = bantime;
            if increment {
                let shift = if n - 1 < 20 { n - 1 } else { 20 };
                dur = bantime * (1 << shift);
                if dur > maxtime {
                    dur = maxtime;
                }
            }
            failures[slot] = Vec.new();
            total_banned += 1;
            log(t, "fail2ban.actions".to_string(), name, f"Ban {host} for {dur}s (ban {n})");
            bans.push(Ban { ip: host, end: t + dur });
        }
    }
    let mut failed_now = 0;
    for f in failures {
        if not f.is_empty() {
            failed_now += 1;
        }
    }
    let mut list = String.new();
    for i in 0..bans.len() {
        if i > 0 {
            list.push_str(" ");
        }
        list.push_str(bans[i].ip.as_str());
    }
    println(f"Status for the jail: {name}");
    println("|- Filter");
    println(f"|  |- Currently failed:\t{failed_now}");
    println(f"|  |- Total failed:\t{total_failed}");
    println(f"|  `- File list:\t{logpath}");
    println("`- Actions");
    println(f"   |- Currently banned:\t{bans.len()}");
    println(f"   |- Total banned:\t{total_banned}");
    println(f"   `- Banned IP list:\t{list}");
    println(f"Lines: {lines} read, {nodate} without a date, {ign_count} ignored by ignoreregex");
    Ok(bans)
}

// ------------------------------------------------------------ the data

fn write_data() -> Result[(), String] {
    for (name, text) in data_files() {
        let path = f"data/{name}";
        let dir = parent(path.as_str());
        if let Err(e) = fs.create_dir_all(dir) {
            return Err(f"{e}");
        }
        if let Err(e) = fs.write(path, text) {
            return Err(f"{e}");
        }
    }
    Ok(())
}

// The directory part of a path (strings.md has no rfind, B-2026-10-15-15).
fn parent(path: Str) -> String {
    let b = path.bytes();
    let mut i = b.len() - 1;
    while i > 0 and b[i] != b'/' {
        i -= 1;
    }
    path[..i].to_string()
}

struct Active {
    name: String,
    bans: Vec[Ban],
}

fn run() -> Result[(), String] {
    write_data()?;
    let dates = match DateDetector.new() {
        Ok(d) => d,
        Err(e) => return Err(e.message),
    };
    let jails = read_conf(read_file("data/jail.local").unwrap_or(String.new()).as_str());
    let defaults = match jails.find("DEFAULT") {
        Some(i) => jails.sections[i].clone(),
        None => Section { name: "DEFAULT".to_string(), keys: Vec.new(), values: Vec.new() },
    };
    let mut active: Vec[Active] = Vec.new();
    for sec in jails.sections {
        if sec.name == "DEFAULT" {
            continue;
        }
        let mut cfg = defaults.clone();
        for j in 0..sec.keys.len() {
            cfg.set(sec.keys[j].clone(), sec.values[j].clone());
        }
        if cfg.get("enabled").unwrap_or("false".to_string()) != "true" {
            println(f"Jail '{sec.name}' is disabled");
            continue;
        }
        let filter_name = cfg.get("filter").unwrap_or(String.new());
        let filter = match load_filter(filter_name.as_str())? {
            Some(f) => f,
            None => {
                println(f"ERROR Found no accessible config files for 'filter.d/{filter_name}' under data/filter.d");
                continue;
            }
        };
        if read_file(cfg.get("logpath").unwrap_or(String.new()).as_str()).is_none() {
            println(f"ERROR Failed during configuration: Have not found any log file for {sec.name} jail");
            continue;
        }
        let bans = run_jail(sec.name.as_str(), cfg, filter, dates)?;
        active.push(Active { name: sec.name.clone(), bans: bans });
        println("");
    }
    if let Err(e) = fs.create_dir_all("data/action".to_string()) {
        return Err(f"{e}");
    }
    for a in active {
        let mut out = String.new();
        for b in a.bans {
            let tool = if b.ip.contains(":") { "ip6tables" } else { "iptables" };
            out.push_str(f"{tool} -I f2b-{a.name} 1 -s {b.ip} -j REJECT --reject-with icmp-port-unreachable\n");
        }
        if let Err(e) = fs.write(f"data/action/{a.name}.sh", out) {
            return Err(f"{e}");
        }
    }
    for a in active {
        let path = f"data/action/{a.name}.sh";
        let text = read_file(path.as_str()).unwrap_or(String.new());
        let rules = text.bytes().iter().filter(|b| *b == b'\n').count();
        println(f"{path}: {rules} rule(s), {text.len()} bytes");
        for l in text.split("\n") {
            if not l.is_empty() {
                println(f"  {l}");
            }
        }
    }
    println("Shutdown");
    for a in active {
        for b in a.bans {
            println(f"fail2ban.actions [{a.name}] Unban {b.ip} (stop)");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(f"error: {e}");
    }
}
