// mini_fail2ban: the intrusion-prevention daemon that watches server
// logs and bans the addresses that keep failing to log in, as fail2ban
// does it:
// - jail.local, with [DEFAULT] settings each jail overrides, and jails
//   that are disabled, name a missing filter, or name a missing log;
// - filter.d/*.conf, with [INCLUDES] before = common.conf, `%(name)s`
//   interpolation, multiline failregex, ignoreregex, and the <HOST> tag;
// - the date detector for syslog and nginx timestamps, which takes the
//   time off the front of each line before the filters see it;
// - the ban logic: failures inside findtime, maxretry, bans that expire,
//   bantime.increment doubling up to bantime.maxtime, "already banned",
//   and ignoreip with CIDR ranges;
// - `fail2ban-client status` for each jail, and the iptables/ip6tables
//   actions written to data/action/ and read back.
//
// The run writes the config and the logs into data/ first. expected.out
// is the output of oracle.py, the same jails run in Python with `re`.
//
// Workarounds for v2 gaps, each to revert once its row is fixed:
//   B-2026-10-15-15  no rfind: `parent` scans back for the last `/`

// ------------------------------------------------------------ time

const YEAR: i64 = 2026;
const HOST: Str = "(?P<host>(?:\\d{1,3}\\.){3}\\d{1,3}|[0-9a-fA-F]*:[0-9a-fA-F:]+)";

fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = if y >= 0 { y / 400 } else { (y - 399) / 400 };
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 };
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    (if m <= 2 { y + 1 } else { y }, m, d)
}

fn pad2(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn stamp(t: i64) -> String {
    let (y, m, d) = civil_from_days(t / 86400);
    let s = t % 86400;
    f"{y}-{pad2(m)}-{pad2(d)} {pad2(s / 3600)}:{pad2(s / 60 % 60)}:{pad2(s % 60)}"
}

fn epoch(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64) -> i64 {
    days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + s
}

// ------------------------------------------------------------ the date detector

struct DateDetector {
    syslog: Regex,
    nginx: Regex,
}

fn month_number(name: Str) -> i64 {
    let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    for i in 0..12 {
        if months[i] == name {
            return i + 1;
        }
    }
    0
}

fn group_int(c: ref Captures, i: i64) -> i64 {
    match c.get(i) {
        Some(m) => i64.parse(m.text).unwrap_or(0),
        None => 0,
    }
}

impl DateDetector {
    fn new() -> Result[DateDetector, RegexError] {
        let syslog = Regex.compile("^([A-Z][a-z]{2}) +(\\d{1,2}) (\\d{2}):(\\d{2}):(\\d{2}) ")?;
        let nginx = Regex.compile("^(\\d{4})/(\\d{2})/(\\d{2}) (\\d{2}):(\\d{2}):(\\d{2}) ")?;
        Ok(DateDetector { syslog: syslog, nginx: nginx })
    }

    // The time of a line and the rest of it, after the timestamp.
    fn detect(self, line: Str) -> Option[(i64, String)] {
        if let Some(c) = self.syslog.captures(line) {
            let mo = match c.get(1) {
                Some(m) => month_number(m.text.as_str()),
                None => 0,
            };
            if mo > 0 {
                let t = epoch(YEAR, mo, group_int(c, 2), group_int(c, 3), group_int(c, 4), group_int(c, 5));
                let end = c.get(0).unwrap().end;
                return Some((t, line[end..].to_string()));
            }
        }
        if let Some(c) = self.nginx.captures(line) {
            let t = epoch(group_int(c, 1), group_int(c, 2), group_int(c, 3), group_int(c, 4), group_int(c, 5), group_int(c, 6));
            let end = c.get(0).unwrap().end;
            return Some((t, line[end..].to_string()));
        }
        None
    }
}

// ------------------------------------------------------------ config files

#[derive(Clone)]
struct Section {
    name: String,
    keys: Vec[String],
    values: Vec[String],
}

impl Section {
    fn get(self, key: Str) -> Option[String] {
        for i in 0..self.keys.len() {
            if self.keys[i] == key {
                return Some(self.values[i].clone());
            }
        }
        None
    }

    fn set(mut ref self, key: own String, value: own String) {
        for i in 0..self.keys.len() {
            if self.keys[i] == key {
                self.values[i] = value;
                return;
            }
        }
        self.keys.push(key);
        self.values.push(value);
    }
}

struct Conf {
    sections: Vec[Section],
}

impl Conf {
    fn find(self, name: Str) -> Option[i64] {
        for i in 0..self.sections.len() {
            if self.sections[i].name == name {
                return Some(i);
            }
        }
        None
    }

    fn get(self, section: Str, key: Str) -> Option[String] {
        match self.find(section) {
            Some(i) => self.sections[i].get(key),
            None => None,
        }
    }
}

fn is_blank(c: u8) -> bool {
    c == b' ' or c == b'\t'
}

// Sections of key = value, in order. An indented line continues the
// value above it; `#` and `;` start comment lines.
fn read_conf(text: Str) -> Conf {
    let mut sections: Vec[Section] = Vec.new();
    let mut cur: i64 = -1;
    let mut key: Option[String] = None;
    for raw in text.split("\n") {
        let stripped = raw.trim().to_string();
        if stripped.is_empty() or stripped.starts_with("#") or stripped.starts_with(";") {
            key = None;
            continue;
        }
        if is_blank(raw.bytes()[0]) and cur >= 0 {
            if let Some(k) = key.clone() {
                let old = sections[cur].get(k.as_str()).unwrap_or(String.new());
                sections[cur].set(k, f"{old}\n{stripped}");
                continue;
            }
        }
        if stripped.starts_with("[") and stripped.ends_with("]") {
            let name = stripped[1..stripped.len() - 1].trim().to_string();
            let mut found = -1;
            for i in 0..sections.len() {
                if sections[i].name == name {
                    found = i;
                }
            }
            if found < 0 {
                sections.push(Section { name: name, keys: Vec.new(), values: Vec.new() });
                found = sections.len() - 1;
            }
            cur = found;
            key = None;
            continue;
        }
        match stripped.find("=") {
            Some(i) if cur >= 0 => {
                let k = stripped[..i].trim().to_lowercase();
                let v = stripped[i + 1..].trim().to_string();
                sections[cur].set(k.clone(), v);
                key = Some(k);
            }
            _ => {
                key = None;
            }
        }
    }
    Conf { sections: sections }
}

// `%(name)s` references, replaced from `defs` until none is left.
fn interpolate(value: Str, defs: ref Section, re: ref Regex, depth: i64) -> Result[String, String] {
    if depth > 10 {
        return Err("interpolation too deep".to_string());
    }
    let mut out = String.new();
    let mut pos = 0;
    for c in re.captures_all(value) {
        let whole = c.get(0).unwrap();
        out.push_str(value[pos..whole.start]);
        let name = c.get(1).unwrap().text;
        match defs.get(name.as_str()) {
            Some(v) => out.push_str(interpolate(v.as_str(), defs, re, depth + 1)?.as_str()),
            None => out.push_str(whole.text.as_str()),
        }
        pos = whole.end;
    }
    out.push_str(value[pos..]);
    Ok(out)
}

struct Filter {
    fail: Vec[String],
    ignore: Vec[String],
}

fn read_file(path: Str) -> Option[String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Some(t),
        Err(_) => None,
    }
}

fn load_filter(name: Str) -> Result[Option[Filter], String] {
    let text = match read_file(f"data/filter.d/{name}.conf".as_str()) {
        Some(t) => t,
        None => return Ok(None),
    };
    let conf = read_conf(text.as_str());
    let mut defs = Section { name: "defs".to_string(), keys: Vec.new(), values: Vec.new() };
    if let Some(before) = conf.get("INCLUDES", "before") {
        let inc_text = read_file(f"data/filter.d/{before}".as_str()).unwrap_or(String.new());
        let inc = read_conf(inc_text.as_str());
        if let Some(i) = inc.find("DEFAULT") {
            for j in 0..inc.sections[i].keys.len() {
                defs.set(inc.sections[i].keys[j].clone(), inc.sections[i].values[j].clone());
            }
        }
    }
    if let Some(i) = conf.find("Definition") {
        for j in 0..conf.sections[i].keys.len() {
            defs.set(conf.sections[i].keys[j].clone(), conf.sections[i].values[j].clone());
        }
    }
    let re = match Regex.compile("%\\((\\w+)\\)s") {
        Ok(r) => r,
        Err(e) => return Err(e.message),
    };
    let mut fail: Vec[String] = Vec.new();
    for l in defs.get("failregex").unwrap_or(String.new()).split("\n") {
        if not l.is_empty() {
            fail.push(interpolate(l.as_str(), defs, re, 0)?.replace("<HOST>", HOST));
        }
    }
    let mut ignore: Vec[String] = Vec.new();
    for l in defs.get("ignoreregex").unwrap_or(String.new()).split("\n") {
        if not l.is_empty() {
            ignore.push(interpolate(l.as_str(), defs, re, 0)?);
        }
    }
    Ok(Some(Filter { fail: fail, ignore: ignore }))
}

// ------------------------------------------------------------ addresses

fn parse_v4(s: Str) -> Option[i64] {
    let parts: Vec[Str] = s.split(".").collect();
    if parts.len() != 4 {
        return None;
    }
    let mut n: i64 = 0;
    for p in parts {
        if p.is_empty() or not p.bytes().iter().all(|b| *b >= b'0' and *b <= b'9') {
            return None;
        }
        let v = i64.parse(p).ok()?;
        if v > 255 {
            return None;
        }
        n = n * 256 + v;
    }
    Some(n)
}

fn in_network(ip: Str, net: Str, bits: i64) -> bool {
    match (parse_v4(ip), parse_v4(net)) {
        (Some(a), Some(b)) => {
            let mask = ((1 << 32) - 1) ^ ((1 << (32 - bits)) - 1);
            (a & mask) == (b & mask)
        }
        _ => false,
    }
}

fn ignored(ip: Str, ignores: ref Vec[String]) -> bool {
    for item in ignores {
        match item.find("/") {
            Some(i) => {
                let bits = i64.parse(item[i + 1..]).unwrap_or(32);
                if in_network(ip, item[..i], bits) {
                    return true;
                }
            }
            None => {
                if item == ip {
                    return true;
                }
            }
        }
    }
    false
}

