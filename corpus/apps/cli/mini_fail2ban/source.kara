    s.push_str("enabled  = true\n");
    s.push_str("filter   = nginx-http-auth\n");
    s.push_str("logpath  = data/log/nginx/error.log\n");
    s.push_str("findtime = 120\n");
    s.push_str("\n");
    s.push_str("[postfix-sasl]\n");
