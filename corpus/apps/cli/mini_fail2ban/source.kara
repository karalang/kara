    s
}

fn file_1() -> String {
    let mut s = String.new();
    s.push_str("# Shared by the filters that read syslog lines.\n");
    s.push_str("[DEFAULT]\n");
    s.push_str("_daemon = \\S*\n");
    s.push_str("__hostname = \\S+\n");
    s.push_str("__pid_re = (?:\\[\\d+\\])\n");
    s.push_str("__daemon_re = %(_daemon)s%(__pid_re)s?:\n");
    s.push_str("__prefix_line = %(__hostname)s %(__daemon_re)s\\s+\n");
    s
}

fn file_2() -> String {
    let mut s = String.new();
    s.push_str("[INCLUDES]\n");
    s.push_str("before = common.conf\n");
    s.push_str("\n");
    s.push_str("[Definition]\n");
    s.push_str("_daemon = sshd\n");
    s.push_str("failregex = ^%(__prefix_line)sFailed (?:password|publickey) for (?:invalid user )?\\S+ from <HOST> port \\d+\n");
    s.push_str("            ^%(__prefix_line)sInvalid user \\S+ from <HOST> port \\d+$\n");
    s.push_str("            ^%(__prefix_line)sConnection closed by authenticating user \\S+ <HOST> port \\d+ \\[preauth\\]$\n");
    s.push_str("ignoreregex = for backup from\n");
    s
}

fn file_3() -> String {
    let mut s = String.new();
    s.push_str("# Basic-auth failures in nginx's error log.\n");
    s.push_str("[Definition]\n");
    s.push_str("failregex = ^\\[error\\] \\d+#\\d+: \\*\\d+ user \"[^\"]*\":? (?:password mismatch|was not found in \"[^\"]*\"), client: <HOST>, server: \\S*, request: \"[^\"]*\", host: \"[^\"]*\"(?:, referrer: \"[^\"]*\")?$\n");
    s.push_str("ignoreregex =\n");
    s
}

fn file_4() -> String {
    let mut s = String.new();
    s.push_str("[INCLUDES]\n");
