    let mut s = String.new();
    s.push_str("# Jails for web1: ban after repeated failures, longer each time.\n");
    s.push_str("[DEFAULT]\n");
    s.push_str("bantime  = 600\n");
    s.push_str("findtime = 600\n");
    s.push_str("maxretry = 5\n");
    s.push_str("ignoreip = 127.0.0.1/8 10.0.0.0/8 192.168.1.50\n");
    s.push_str("bantime.increment = true\n");
    s.push_str("bantime.maxtime = 3600\n");
    s.push_str("\n");
    s.push_str("[sshd]\n");
    s.push_str("enabled  = true\n");
    s.push_str("filter   = sshd\n");
    s.push_str("logpath  = data/log/auth.log\n");
    s.push_str("maxretry = 3\n");
    s.push_str("\n");
