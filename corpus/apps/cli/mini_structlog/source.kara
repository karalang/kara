// mini_structlog: structlog 24.4.0, structured logging for Python:
// - make_filtering_bound_logger's loggers, with their levels, aliases,
//   log(), exception() and %-formatted arguments, and the generic
//   BoundLogger that takes any method name;
// - bind, unbind, try_unbind and new, the lazy proxies get_logger and
//   wrap_logger give, configure, reset_defaults and
//   cache_logger_on_first_use;
// - the processors: add_log_level, TimeStamper, MaybeTimeStamper,
//   KeyValueRenderer, LogfmtRenderer, JSONRenderer, EventRenamer,
//   format_exc_info, dict_tracebacks, set_exc_info, UnicodeEncoder,
//   UnicodeDecoder, merge_contextvars and the ConsoleRenderer, with and
//   without colors;
// - PrintLogger, WriteLogger, BytesLogger, ReturnLogger,
//   CapturingLogger, LogCapture and capture_logs, and the contextvars
//   functions;
// - an API's JSON access log and a task worker's logfmt log.
//
// The inputs are data/jobs.jsonl and the files beside it, made by mk.py.
// expected.out is the output of oracle.py, which runs the same jobs
// through structlog itself (the copy in structlog/) on a fake clock.
// ------------------------------------------------------------ Python values

// A value json.loads gives: integers keep their digits, so one past 64
// bits prints as Python prints it; objects keep their keys in order, and
// a repeated key keeps its first place and takes its last value.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(String),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

#[derive(Clone)]
struct Member {
    key: String,
    val: J,
}

// A raised exception: its class name and str().
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn failure(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

// ------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i] as u8);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}


// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(cps_string(text)), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and is_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
            if is_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, cps_string(key), val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own String, val: own J) {
    let mut j = 0;
    while j < members.len() {
        if members[j].key == key {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// A str from code points. A lone surrogate, which a str can hold but a
// Kara String cannot, becomes U+FFFD.
fn cps_string(cps: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in cps.iter() {
        if is_surrogate(*c) {
            push_utf8(mut out, 0xFFFD);
        } else {
            push_utf8(mut out, *c);
        }
    }
    String.from_utf8(out).unwrap()
}

fn string_cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

// json.loads on a str.
fn loads_cps(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}

fn loads_str(text: ref String) -> Result[J, Exc] {
    loads_cps(string_cps(text))
}

// The error bytes.decode("utf-8") raises: the bad byte, or the bytes from
// a sequence's start up to the one that does not fit.
fn utf8_error(b: ref Vec[u8], start: i64, end: i64, reason: Str) -> Exc {
    if end - start == 1 {
        return exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{b[start]:02x} in position {start}: {reason}");
    }
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {start}-{end - 1}: {reason}")
}

fn is_cont(c: u8) -> bool {
    c >= 0x80 and c <= 0xBF
}

// bytes.decode("utf-8", "surrogatepass"), as json.loads decodes bytes.
// An encoded surrogate (ED A0..BF 80..BF) is let through.
fn utf8_decode(b: ref Vec[u8]) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let c = b[i];
        if c < 0x80 {
            out.push(c as i64);
            i += 1;
            continue;
        }
        if c < 0xC2 or c > 0xF4 {
            return Err(utf8_error(b, i, i + 1, "invalid start byte"));
        }
        let need = if c < 0xE0 { 1 } else if c < 0xF0 { 2 } else { 3 };
        // The range the second byte must fall in.
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c == 0xE0 {
            lo = 0xA0;
        } else if c == 0xF0 {
            lo = 0x90;
        } else if c == 0xF4 {
            hi = 0x8F;
        }
        // ED A0..BF starts a surrogate, which strict UTF-8 rejects at the
        // second byte; when the third byte does not complete it, the error
        // is that one.
        let surrogate = c == 0xED and n > i + 1 and b[i + 1] >= 0xA0 and b[i + 1] <= 0xBF;
        if surrogate and (n <= i + 2 or not is_cont(b[i + 2])) {
            return Err(utf8_error(b, i, i + 1, "invalid continuation byte"));
        }
        let mut k = 1;
        while k <= need {
            if i + k >= n {
                return Err(utf8_error(b, i, n, "unexpected end of data"));
            }
            let d = b[i + k];
            let ok = if k == 1 { d >= lo and d <= hi } else { is_cont(d) };
            if not ok {
                return Err(utf8_error(b, i, i + k, "invalid continuation byte"));
            }
            k += 1;
        }
        let mut cp = if need == 1 { (c as i64) & 0x1F } else if need == 2 { (c as i64) & 0x0F } else { (c as i64) & 0x07 };
        for j in 1..(need + 1) {
            cp = (cp << 6) | ((b[i + j] as i64) & 0x3F);
        }
        out.push(cp);
        i += need + 1;
    }
    Ok(out)
}

// json.loads on bytes: the encoding is detected (only UTF-8, with or
// without its BOM, is handled here), the bytes are decoded, and the text
// is loaded. A decode error is a ValueError, as JSONDecodeError is.
fn loads_bytes(b: ref Vec[u8]) -> Result[J, Exc] {
    let mut body = b.clone();
    if b.len() >= 3 and b[0] == 0xEF and b[1] == 0xBB and b[2] == 0xBF {
        body = Vec.new();
        for i in 3..b.len() {
            body.push(b[i]);
        }
    }
    let cps = utf8_decode(body)?;
    loads_cps(cps)
}
// ------------------------------------------------------------ Python values

// A value an event dict can hold: what the jobs write, plus the bytes,
// tuples, objects and exceptions their tags stand for.
#[derive(Clone)]
enum V {
    Nothing,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[V]),
    Tuple(Vec[V]),
    Dict(Vec[Item]),
    Obj(ObjV),
    Err(ExcV),
}

#[derive(Clone)]
struct Item {
    k: V,
    v: V,
}

// An object with its own __repr__, maybe a __str__, and maybe a
// __structlog__ that returns `sl[0]`.
#[derive(Clone)]
struct ObjV {
    text_repr: String,
    text: Vec[String],
    sl: Vec[V],
}

// An exception instance: its class, the module the class is in, its
// args, and its __cause__, __context__ and notes. None of them has a
// traceback.
#[derive(Clone)]
struct ExcV {
    kind: String,
    module: String,
    args: Vec[V],
    cause: Vec[ExcV],
    context: Vec[ExcV],
    suppress: bool,
    notes: Vec[String],
}

fn sv(s: Str) -> V {
    V.Str(s.to_string())
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

// str.isprintable outside ASCII: controls, format characters, separators
// other than space, surrogates and private use are not printable.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x8E2 or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let quote = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for ch in s.chars() {
        let c = ch as i64;
        if ch == quote or ch == '\\' {
            out.push('\\');
            out.push(ch);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 0x20 or c == 0x7F {
            out.push_str(f"\\x{hex_n(c, 2)}");
        } else if c < 0x7F or is_printable(c) {
            out.push(ch);
        } else if c <= 0xFF {
            out.push_str(f"\\x{hex_n(c, 2)}");
        } else if c <= 0xFFFF {
            out.push_str(f"\\u{hex_n(c, 4)}");
        } else {
            out.push_str(f"\\U{hex_n(c, 8)}");
        }
    }
    out.push(quote);
    out
}

fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in b.iter() {
        if *c == 39 {
            has_single = true;
        } else if *c == 34 {
            has_double = true;
        }
    }
    let quote: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = "b".to_string();
    out.push(quote as char);
    for x in b.iter() {
        let c = *x;
        if c == quote or c == 92 {
            out.push('\\');
            out.push(c as char);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 0x20 or c >= 0x7F {
            out.push_str(f"\\x{hex_n(c as i64, 2)}");
        } else {
            out.push(c as char);
        }
    }
    out.push(quote as char);
    out
}

fn join_reprs(items: ref Vec[V]) -> String {
    let mut out = String.new();
    for i in 0..items.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(repr(items[i]));
    }
    out
}

fn tuple_repr(items: ref Vec[V]) -> String {
    if items.len() == 1 {
        return f"({repr(items[0])},)";
    }
    f"({join_reprs(items)})"
}

fn dict_repr(items: ref Vec[Item]) -> String {
    let mut out = "{".to_string();
    for i in 0..items.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(repr(items[i].k));
        out.push_str(": ");
        out.push_str(repr(items[i].v));
    }
    out.push('}');
    out
}

fn exc_repr(e: ref ExcV) -> String {
    if e.args.len() == 1 {
        return f"{e.kind}({repr(e.args[0])})";
    }
    f"{e.kind}{tuple_repr(e.args)}"
}

// str(e): KeyError shows its one argument's repr.
fn exc_str(e: ref ExcV) -> String {
    if e.args.len() == 0 {
        return String.new();
    }
    if e.args.len() == 1 {
        if e.kind == "KeyError" and e.module == "builtins" {
            return repr(e.args[0]);
        }
        return py_str(e.args[0]);
    }
    tuple_repr(e.args)
}

fn repr(v: ref V) -> String {
    match v {
        V.Nothing => "None".to_string(),
        V.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        V.Int(n) => f"{*n}",
        V.Float(x) => float_repr(*x),
        V.Str(s) => str_repr(s),
        V.Bytes(b) => bytes_repr(b),
        V.List(items) => f"[{join_reprs(items)}]",
        V.Tuple(items) => tuple_repr(items),
        V.Dict(items) => dict_repr(items),
        V.Obj(o) => o.text_repr.clone(),
        V.Err(e) => exc_repr(e),
    }
}

// str(v)
fn py_str(v: ref V) -> String {
    match v {
        V.Str(s) => s.clone(),
        V.Obj(o) => {
            if o.text.len() > 0 {
                return o.text[0].clone();
            }
            o.text_repr.clone()
        }
        V.Err(e) => exc_str(e),
        _ => repr(v),
    }
}

fn type_name(v: ref V) -> String {
    let n = match v {
        V.Nothing => "NoneType",
        V.Bool(_) => "bool",
        V.Int(_) => "int",
        V.Float(_) => "float",
        V.Str(_) => "str",
        V.Bytes(_) => "bytes",
        V.List(_) => "list",
        V.Tuple(_) => "tuple",
        V.Dict(_) => "dict",
        V.Obj(_) => "Obj",
        V.Err(e) => e.kind.as_str(),
    };
    n.to_string()
}

fn truthy(v: ref V) -> bool {
    match v {
        V.Nothing => false,
        V.Bool(b) => *b,
        V.Int(n) => *n != 0,
        V.Float(x) => *x != 0.0,
        V.Str(s) => s.len() > 0,
        V.Bytes(b) => b.len() > 0,
        V.List(items) => items.len() > 0,
        V.Tuple(items) => items.len() > 0,
        V.Dict(items) => items.len() > 0,
        _ => true,
    }
}

fn num_of(v: ref V) -> Option[f64] {
    match v {
        V.Bool(b) => Some(if *b { 1.0 } else { 0.0 }),
        V.Int(n) => Some(*n as f64),
        V.Float(x) => Some(*x),
        _ => None,
    }
}

fn is_none(v: ref V) -> bool {
    match v {
        V.Nothing => true,
        _ => false,
    }
}

fn seq_eq(a: ref Vec[V], b: ref Vec[V]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if not py_eq(a[i], b[i]) {
            return false;
        }
    }
    true
}

// a == b: True == 1 == 1.0, and dicts compare by their items, not their
// order.
fn py_eq(a: ref V, b: ref V) -> bool {
    if let V.Int(x) = a {
        if let V.Int(y) = b {
            return *x == *y;
        }
    }
    let na = num_of(a);
    let nb = num_of(b);
    if na.is_some() and nb.is_some() {
        return na.unwrap() == nb.unwrap();
    }
    match a {
        V.Nothing => is_none(b),
        V.Str(x) => match b {
            V.Str(y) => x == y,
            _ => false,
        },
        V.Bytes(x) => match b {
            V.Bytes(y) => x == y,
            _ => false,
        },
        V.List(xs) => match b {
            V.List(ys) => seq_eq(xs, ys),
            _ => false,
        },
        V.Tuple(xs) => match b {
            V.Tuple(ys) => seq_eq(xs, ys),
            _ => false,
        },
        V.Dict(xs) => match b {
            V.Dict(ys) => dict_eq(xs, ys),
            _ => false,
        },
        _ => false,
    }
}

fn dict_eq(xs: ref Vec[Item], ys: ref Vec[Item]) -> bool {
    if xs.len() != ys.len() {
        return false;
    }
    for it in xs.iter() {
        match item_find(ys, it.k) {
            Some(j) => {
                if not py_eq(it.v, ys[j].v) {
                    return false;
                }
            }
            None => return false,
        }
    }
    true
}

fn item_find(items: ref Vec[Item], k: ref V) -> Option[i64] {
    for i in 0..items.len() {
        if py_eq(items[i].k, k) {
            return Some(i);
        }
    }
    None
}

// d[k] = v: a key seen before keeps its place (and the key it was first
// given as).
fn item_put(items: mut ref Vec[Item], k: own V, v: own V) {
    match item_find(items, k) {
        Some(j) => {
            items[j].v = v;
        }
        None => items.push(Item { k: k, v: v }),
    }
}

// ------------------------------------------------------------ event dicts

fn d_find(d: ref Vec[Item], key: Str) -> Option[i64] {
    for i in 0..d.len() {
        if let V.Str(s) = d[i].k {
            if s == key {
                return Some(i);
            }
        }
    }
    None
}

fn d_has(d: ref Vec[Item], key: Str) -> bool {
    d_find(d, key).is_some()
}

fn d_get(d: ref Vec[Item], key: Str) -> Option[V] {
    match d_find(d, key) {
        Some(i) => Some(d[i].v.clone()),
        None => None,
    }
}

fn d_set(d: mut ref Vec[Item], key: Str, v: own V) {
    match d_find(d, key) {
        Some(i) => {
            d[i].v = v;
        }
        None => d.push(Item { k: sv(key), v: v }),
    }
}

// d.pop(key, None), with whether it was there.
fn d_pop(d: mut ref Vec[Item], key: Str) -> Option[V] {
    match d_find(d, key) {
        Some(i) => {
            let v = d[i].v.clone();
            d.remove(i);
            Some(v)
        }
        None => None,
    }
}

fn key_text(it: ref Item) -> String {
    match it.k {
        V.Str(s) => s.clone(),
        _ => repr(it.k),
    }
}

// sorted(d.items()) for str keys.
fn sorted_items(d: ref Vec[Item]) -> Vec[Item] {
    let mut out: Vec[Item] = Vec.new();
    for it in d.iter() {
        let k = key_text(it);
        let mut j = out.len();
        while j > 0 and key_text(out[j - 1]) > k {
            j -= 1;
        }
        out.insert(j, it.clone());
    }
    out
}

// ------------------------------------------------------------ errors

fn terr(msg: own String) -> Exc {
    Exc { kind: "TypeError".to_string(), msg: msg }
}

fn verr(msg: own String) -> Exc {
    Exc { kind: "ValueError".to_string(), msg: msg }
}

fn kerr(key: ref V) -> Exc {
    Exc { kind: "KeyError".to_string(), msg: repr(key) }
}

fn aerr(owner: ref String, name: ref String) -> Exc {
    Exc { kind: "AttributeError".to_string(), msg: f"'{owner}' object has no attribute '{name}'" }
}

// Something the jobs never do, should one ever do it.
fn unported(what: Str) -> Exc {
    Exc { kind: "NotImplementedError".to_string(), msg: f"{what} is not in the port" }
}

fn drop_event() -> Exc {
    Exc { kind: "DropEvent".to_string(), msg: String.new() }
}

fn is_drop(e: ref Exc) -> bool {
    e.kind == "DropEvent"
}

// The exception an instance raises, as the harness prints it.
fn raised(e: ref ExcV) -> Exc {
    Exc { kind: e.kind.clone(), msg: exc_str(e) }
}

// ------------------------------------------------------------ the data

fn j_int(v: ref J) -> i64 {
    match v {
        J.Int(d) => i64.parse(d).unwrap_or(0),
        _ => 0,
    }
}

fn j_str(v: ref J) -> String {
    match v {
        J.Str(s) => s.clone(),
        _ => String.new(),
    }
}

fn j_bool(v: ref J) -> bool {
    match v {
        J.Bool(b) => *b,
        _ => false,
    }
}

fn j_member(v: ref J, key: Str) -> Option[J] {
    if let J.Obj(members) = v {
        for m in members.iter() {
            if m.key == key {
                return Some(m.val.clone());
            }
        }
    }
    None
}

fn j_items(v: ref J) -> Vec[J] {
    match v {
        J.Arr(items) => items.clone(),
        _ => Vec.new(),
    }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push((hex_value(b[i] as i64) * 16 + hex_value(b[i + 1] as i64)) as u8);
        i += 2;
    }
    out
}

fn is_builtin_exc(k: ref String) -> bool {
    k == "Exception" or k == "ValueError" or k == "KeyError" or k == "RuntimeError" or k == "TypeError"
        or k == "OSError" or k == "ConnectionError" or k == "TimeoutError" or k == "PermissionError"
        or k == "ZeroDivisionError"
}

fn decode_exc(d: ref J) -> ExcV {
    let kind = j_str(j_member(d, "type").unwrap_or(J.Null));
    let module = match j_member(d, "module") {
        Some(m) => j_str(m),
        None => if is_builtin_exc(kind) { "builtins".to_string() } else { "app".to_string() },
    };
    let mut args: Vec[V] = Vec.new();
    if let Some(a) = j_member(d, "args") {
        for x in j_items(a).iter() {
            args.push(decode(x));
        }
    }
    let mut cause: Vec[ExcV] = Vec.new();
    if let Some(c) = j_member(d, "cause") {
        cause.push(decode_exc(c));
    }
    let mut context: Vec[ExcV] = Vec.new();
    if let Some(c) = j_member(d, "context") {
        context.push(decode_exc(c));
    }
    let suppress = match j_member(d, "suppress") {
        Some(s) => j_bool(s),
        None => cause.len() > 0,
    };
    let mut notes: Vec[String] = Vec.new();
    if let Some(n) = j_member(d, "notes") {
        for x in j_items(n).iter() {
            notes.push(j_str(x));
        }
    }
    ExcV { kind: kind, module: module, args: args, cause: cause, context: context, suppress: suppress, notes: notes }
}

fn decode(v: ref J) -> V {
    match v {
        J.Null => V.Nothing,
        J.Bool(b) => V.Bool(*b),
        J.Int(d) => V.Int(i64.parse(d).unwrap_or(0)),
        J.Float(x) => V.Float(*x),
        J.Str(s) => V.Str(s.clone()),
        J.Arr(items) => {
            let mut out: Vec[V] = Vec.new();
            for x in items.iter() {
                out.push(decode(x));
            }
            V.List(out)
        }
        J.Obj(members) => {
            if members.len() == 1 {
                let tag = members[0].key.clone();
                let body = members[0].val.clone();
                if tag == "$bytes" {
                    return V.Bytes(unhex(j_str(body)));
                }
                if tag == "$tuple" {
                    let mut out: Vec[V] = Vec.new();
                    for x in j_items(body).iter() {
                        out.push(decode(x));
                    }
                    return V.Tuple(out);
                }
                if tag == "$float" {
                    let s = j_str(body);
                    let inf = 1.0 / 0.0;
                    if s == "nan" {
                        return V.Float(inf - inf);
                    }
                    return V.Float(if s == "-inf" { -inf } else { inf });
                }
                if tag == "$dict" {
                    let mut items: Vec[Item] = Vec.new();
                    for p in j_items(body).iter() {
                        let kv = j_items(p);
                        item_put(mut items, decode(kv[0]), decode(kv[1]));
                    }
                    return V.Dict(items);
                }
                if tag == "$obj" {
                    let mut text: Vec[String] = Vec.new();
                    if let Some(s) = j_member(body, "str") {
                        text.push(j_str(s));
                    }
                    let mut sl: Vec[V] = Vec.new();
                    if let Some(s) = j_member(body, "structlog") {
                        sl.push(decode(s));
                    }
                    let r = j_str(j_member(body, "repr").unwrap_or(J.Null));
                    return V.Obj(ObjV { text_repr: r, text: text, sl: sl });
                }
                if tag == "$exc" {
                    return V.Err(decode_exc(body));
                }
            }
            let mut items: Vec[Item] = Vec.new();
            for m in members.iter() {
                items.push(Item { k: V.Str(m.key.clone()), v: decode(m.val) });
            }
            V.Dict(items)
        }
    }
}

// **kwargs from a JSON object.
fn kwargs(v: ref J) -> Vec[Item] {
    let mut items: Vec[Item] = Vec.new();
    if let J.Obj(members) = v {
        for m in members.iter() {
            items.push(Item { k: V.Str(m.key.clone()), v: decode(m.val) });
        }
    }
    items
}

fn values(v: ref J) -> Vec[V] {
    let mut out: Vec[V] = Vec.new();
    for x in j_items(v).iter() {
        out.push(decode(x));
    }
    out
}
// ------------------------------------------------------------ numbers

// round(|x| * 10**d), ties to even, on x's exact binary value: what
// "%.*f" starts from.
fn scaled_round(x: f64, d: i64) -> u128 {
    let bits = x.to_bits();
    let exp = ((bits >> 52) & 0x7ff) as i64;
    let frac = bits & 0xfffffffffffffu64;
    let mut m = frac;
    let mut e: i64 = -1074;
    if exp != 0 {
        m = frac | 0x10000000000000u64;
        e = exp - 1075;
    }
    let mut num = m as u128;
    for _ in 0..d {
        num = num * 10;
    }
    if e >= 0 {
        return num << e;
    }
    let s = -e;
    if s >= 127 {
        return 0;
    }
    let q = num >> s;
    let r = num - (q << s);
    let half = 1u128 << (s - 1);
    if r > half or (r == half and q % 2 == 1) { q + 1 } else { q }
}

// "%.{d}f" % |x|
fn fixed_abs(x: f64, d: i64) -> String {
    let n = scaled_round(x, d);
    let mut p: u128 = 1;
    for _ in 0..d {
        p = p * 10;
    }
    let mut out = f"{n / p}";
    if d > 0 {
        let mut frac = f"{n % p}";
        while frac.len() < d {
            frac = f"0{frac}";
        }
        out.push('.');
        out.push_str(frac);
    }
    out
}

fn is_neg(x: f64) -> bool {
    x.to_bits() >> 63 == 1
}

fn base_digits(n: i64, base: i64, upper: bool) -> String {
    let alphabet: Str = if upper { "0123456789ABCDEF" } else { "0123456789abcdef" };
    let digits = alphabet.bytes();
    if n == 0 {
        return "0".to_string();
    }
    let mut out: Vec[u8] = Vec.new();
    let mut m = n;
    while m > 0 {
        out.insert(0, digits[m % base]);
        m = m / base;
    }
    String.from_utf8(out).unwrap()
}

fn char_count(s: ref String) -> i64 {
    let mut n = 0;
    for _ in s.chars() {
        n += 1;
    }
    n
}

fn take_chars(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k = 0;
    for c in s.chars() {
        if k >= n {
            break;
        }
        out.push(c);
        k += 1;
    }
    out
}

// ------------------------------------------------------------ str % args

// printf-style formatting as a log method's positional arguments get it:
// %s, %r, %d, %i, %u, %x, %X, %o, %f, %F and %%, with flags, a width and
// a precision.
fn percent_format(fmt: ref String, items: ref Vec[V]) -> Result[String, Exc] {
    let mut c: Vec[char] = Vec.new();
    for ch in fmt.chars() {
        c.push(ch);
    }
    let mut out = String.new();
    let mut next = 0;
    let mut i = 0;
    while i < c.len() {
        if c[i] != '%' {
            out.push(c[i]);
            i += 1;
            continue;
        }
        i += 1;
        if i >= c.len() {
            return Err(verr("incomplete format".to_string()));
        }
        if c[i] == '%' {
            out.push('%');
            i += 1;
            continue;
        }
        if c[i] == '(' {
            return Err(terr("format requires a mapping".to_string()));
        }
        let mut left = false;
        let mut plus = false;
        let mut space = false;
        let mut zero = false;
        let mut alt = false;
        while i < c.len() and (c[i] == '-' or c[i] == '+' or c[i] == ' ' or c[i] == '0' or c[i] == '#') {
            if c[i] == '-' {
                left = true;
            } else if c[i] == '+' {
                plus = true;
            } else if c[i] == ' ' {
                space = true;
            } else if c[i] == '0' {
                zero = true;
            } else {
                alt = true;
            }
            i += 1;
        }
        let mut width = 0;
        while i < c.len() and c[i] >= '0' and c[i] <= '9' {
            width = width * 10 + (c[i] as i64) - 48;
            i += 1;
        }
        let mut prec = -1;
        if i < c.len() and c[i] == '.' {
            i += 1;
            prec = 0;
            while i < c.len() and c[i] >= '0' and c[i] <= '9' {
                prec = prec * 10 + (c[i] as i64) - 48;
                i += 1;
            }
        }
        if i >= c.len() {
            return Err(verr("incomplete format".to_string()));
        }
        let conv = c[i];
        i += 1;
        if next >= items.len() {
            return Err(terr("not enough arguments for format string".to_string()));
        }
        let arg = items[next].clone();
        next += 1;
        let mut sign = String.new();
        let mut body = String.new();
        let numeric = not (conv == 's' or conv == 'r');
        if conv == 's' {
            body = py_str(arg);
        } else if conv == 'r' {
            body = repr(arg);
        } else if conv == 'd' or conv == 'i' or conv == 'u' {
            let n: i64 = match arg {
                V.Bool(b) => if b { 1 } else { 0 },
                V.Int(n) => n,
                V.Float(x) => x.trunc() as i64,
                _ => return Err(terr(f"%{conv} format: a real number is required, not {type_name(arg)}")),
            };
            if n < 0 {
                sign = "-".to_string();
            }
            body = f"{if n < 0 { -n } else { n }}";
        } else if conv == 'x' or conv == 'X' or conv == 'o' {
            let n: i64 = match arg {
                V.Bool(b) => if b { 1 } else { 0 },
                V.Int(n) => n,
                _ => return Err(terr(f"%{conv} format: an integer is required, not {type_name(arg)}")),
            };
            if n < 0 {
                sign = "-".to_string();
            }
            body = base_digits(if n < 0 { -n } else { n }, if conv == 'o' { 8 } else { 16 }, conv == 'X');
            if alt {
                let prefix = if conv == 'o' { "0o" } else if conv == 'x' { "0x" } else { "0X" };
                body = f"{prefix}{body}";
            }
        } else if conv == 'f' or conv == 'F' {
            let x = match num_of(arg) {
                Some(x) => x,
                None => return Err(terr(f"must be real number, not {type_name(arg)}")),
            };
            if is_neg(x) {
                sign = "-".to_string();
            }
            let p = if prec < 0 { 6 } else { prec };
            body = if x != x {
                "nan".to_string()
            } else if x == 1.0 / 0.0 or x == -1.0 / 0.0 {
                "inf".to_string()
            } else {
                fixed_abs(x, p)
            };
        } else {
            return Err(verr(f"unsupported format character '{conv}' (0x{base_digits(conv as i64, 16, false)}) at index {i - 1}"));
        }
        if not numeric and prec >= 0 and char_count(body) > prec {
            body = take_chars(body, prec);
        }
        if numeric and sign.len() == 0 {
            if plus {
                sign = "+".to_string();
            } else if space {
                sign = " ".to_string();
            }
        }
        let len = char_count(body) + char_count(sign);
        let mut fill = String.new();
        let mut k = len;
        let zero_pad = zero and numeric and not left;
        while k < width {
            fill.push(if zero_pad { '0' } else { ' ' });
            k += 1;
        }
        if left {
            out.push_str(f"{sign}{body}{fill}");
        } else if zero_pad {
            out.push_str(f"{sign}{fill}{body}");
        } else {
            out.push_str(f"{fill}{sign}{body}");
        }
    }
    if next < items.len() {
        return Err(terr("not all arguments converted during string formatting".to_string()));
    }
    Ok(out)
}

// ------------------------------------------------------------ tracebacks

// The class as a traceback names it: builtins and __main__ are left out.
fn exc_type_line(e: ref ExcV) -> String {
    let name = if e.module == "builtins" or e.module == "__main__" {
        e.kind.clone()
    } else {
        f"{e.module}.{e.kind}"
    };
    let s = exc_str(e);
    if s.len() == 0 {
        return name;
    }
    f"{name}: {s}"
}

fn exc_lines(e: ref ExcV, out: mut ref Vec[String]) {
    if e.cause.len() > 0 {
        exc_lines(e.cause[0], mut out);
        out.push(String.new());
        out.push("The above exception was the direct cause of the following exception:".to_string());
        out.push(String.new());
    } else if e.context.len() > 0 and not e.suppress {
        exc_lines(e.context[0], mut out);
        out.push(String.new());
        out.push("During handling of the above exception, another exception occurred:".to_string());
        out.push(String.new());
    }
    out.push(exc_type_line(e));
    for n in e.notes.iter() {
        for line in n.split("\n") {
            out.push(line.to_string());
        }
    }
}

// traceback.print_exception for an exception with no frames, less the
// last newline.
fn format_exception(e: ref ExcV) -> String {
    let mut lines: Vec[String] = Vec.new();
    exc_lines(e, mut lines);
    let mut out = String.new();
    for i in 0..lines.len() {
        if i > 0 {
            out.push('\n');
        }
        out.push_str(lines[i]);
    }
    out
}

// ------------------------------------------------------------ json.dumps

#[derive(Clone)]
struct JsonOpts {
    sort_keys: bool,
    indent: i64,
    ensure_ascii: bool,
    item_sep: String,
    key_sep: String,
}

fn push_json_u(out: mut ref String, cp: i64) {
    out.push_str(f"\\u{hex4(cp)}");
}

fn json_str(s: ref String, ascii: bool, out: mut ref String) {
    out.push('"');
    for ch in s.chars() {
        let c = ch as i64;
        if ch == '"' {
            out.push_str("\\\"");
        } else if ch == '\\' {
            out.push_str("\\\\");
        } else if c == 8 {
            out.push_str("\\b");
        } else if c == 12 {
            out.push_str("\\f");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c == 9 {
            out.push_str("\\t");
        } else if c < 0x20 {
            push_json_u(mut out, c);
        } else if ascii and c >= 0x7F {
            if c >= 0x10000 {
                let v = c - 0x10000;
                push_json_u(mut out, 0xD800 | (v >> 10));
                push_json_u(mut out, 0xDC00 | (v & 0x3FF));
            } else {
                push_json_u(mut out, c);
            }
        } else {
            out.push(ch);
        }
    }
    out.push('"');
}

fn json_float(x: f64) -> String {
    if x != x {
        return "NaN".to_string();
    }
    if x == 1.0 / 0.0 {
        return "Infinity".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-Infinity".to_string();
    }
    float_repr(x)
}

fn json_newline(o: ref JsonOpts, level: i64, out: mut ref String) {
    out.push('\n');
    for _ in 0..(o.indent * level) {
        out.push(' ');
    }
}

// structlog's default= for json.dumps: __structlog__() if there is one,
// else repr().
fn json_fallback(v: ref V) -> V {
    if let V.Obj(o) = v {
        if o.sl.len() > 0 {
            return o.sl[0].clone();
        }
    }
    V.Str(repr(v))
}

fn json_key(k: ref V, ascii: bool, out: mut ref String) -> Result[(), Exc] {
    match k {
        V.Str(s) => json_str(s, ascii, mut out),
        V.Float(x) => out.push_str(json_str_of(json_float(*x), ascii)),
        V.Bool(b) => out.push_str(json_str_of(if *b { "true".to_string() } else { "false".to_string() }, ascii)),
        V.Nothing => out.push_str("\"null\""),
        V.Int(n) => out.push_str(f"\"{*n}\""),
        _ => return Err(terr(f"keys must be str, int, float, bool or None, not {type_name(k)}")),
    }
    Ok(())
}

fn json_str_of(s: own String, ascii: bool) -> String {
    let mut out = String.new();
    json_str(s, ascii, mut out);
    out
}

fn json_seq(o: ref JsonOpts, items: ref Vec[V], level: i64, out: mut ref String) -> Result[(), Exc] {
    if items.len() == 0 {
        out.push_str("[]");
        return Ok(());
    }
    out.push('[');
    if o.indent >= 0 {
        json_newline(o, level + 1, mut out);
    }
    for i in 0..items.len() {
        if i > 0 {
            out.push_str(o.item_sep);
            if o.indent >= 0 {
                json_newline(o, level + 1, mut out);
            }
        }
        json_enc(o, items[i], level + 1, mut out)?;
    }
    if o.indent >= 0 {
        json_newline(o, level, mut out);
    }
    out.push(']');
    Ok(())
}

fn json_enc(o: ref JsonOpts, v: ref V, level: i64, out: mut ref String) -> Result[(), Exc] {
    match v {
        V.Nothing => out.push_str("null"),
        V.Bool(b) => out.push_str(if *b { "true" } else { "false" }),
        V.Int(n) => out.push_str(f"{*n}"),
        V.Float(x) => out.push_str(json_float(*x)),
        V.Str(s) => json_str(s, o.ensure_ascii, mut out),
        V.List(items) => json_seq(o, items, level, mut out)?,
        V.Tuple(items) => json_seq(o, items, level, mut out)?,
        V.Dict(raw) => {
            if raw.len() == 0 {
                out.push_str("{}");
                return Ok(());
            }
            let items = if o.sort_keys { sorted_items(raw) } else { raw.clone() };
            out.push('{');
            if o.indent >= 0 {
                json_newline(o, level + 1, mut out);
            }
            for i in 0..items.len() {
                if i > 0 {
                    out.push_str(o.item_sep);
                    if o.indent >= 0 {
                        json_newline(o, level + 1, mut out);
                    }
                }
                json_key(items[i].k, o.ensure_ascii, mut out)?;
                out.push_str(o.key_sep);
                json_enc(o, items[i].v, level + 1, mut out)?;
            }
            if o.indent >= 0 {
                json_newline(o, level, mut out);
            }
            out.push('}');
        }
        _ => json_enc(o, json_fallback(v), level, mut out)?,
    }
    Ok(())
}

fn json_dumps(o: ref JsonOpts, v: ref V) -> Result[String, Exc] {
    let mut out = String.new();
    json_enc(o, v, 0, mut out)?;
    Ok(out)
}

// ------------------------------------------------------------ codecs

fn backslash_escape(c: i64) -> String {
    if c <= 0xFF {
        return f"\\x{hex_n(c, 2)}";
    }
    if c <= 0xFFFF {
        return f"\\u{hex_n(c, 4)}";
    }
    f"\\U{hex_n(c, 8)}"
}

// s.encode(encoding, errors) for utf-8 and ascii.
fn encode_text(s: ref String, encoding: ref String, errors: ref String) -> Result[Vec[u8], Exc] {
    if encoding == "utf-8" {
        let mut out: Vec[u8] = Vec.new();
        for b in s.bytes() {
            out.push(b);
        }
        return Ok(out);
    }
    if encoding != "ascii" {
        return Err(unported("an encoding other than utf-8 and ascii"));
    }
    let mut cps: Vec[i64] = Vec.new();
    for ch in s.chars() {
        cps.push(ch as i64);
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < cps.len() {
        let c = cps[i];
        if c < 128 {
            out.push(c as u8);
        } else if errors == "strict" {
            let mut j = i;
            while j < cps.len() and cps[j] >= 128 {
                j += 1;
            }
            if j - i == 1 {
                return Err(Exc { kind: "UnicodeEncodeError".to_string(), msg: f"'ascii' codec can't encode character '{backslash_escape(c)}' in position {i}: ordinal not in range(128)" });
            }
            return Err(Exc { kind: "UnicodeEncodeError".to_string(), msg: f"'ascii' codec can't encode characters in position {i}-{j - 1}: ordinal not in range(128)" });
        } else if errors == "backslashreplace" {
            for b in backslash_escape(c).bytes() {
                out.push(b);
            }
        } else if errors == "replace" {
            out.push(63);
        } else if errors != "ignore" {
            return Err(unported("that error handler"));
        }
        i += 1;
    }
    Ok(out)
}

// b.decode("utf-8", "replace"): each bad sequence, up to the byte that
// does not fit, is one U+FFFD.
fn decode_replace(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let c = b[i];
        if c < 0x80 {
            out.push(c);
            i += 1;
            continue;
        }
        if c < 0xC2 or c > 0xF4 {
            push_utf8(mut out, 0xFFFD);
            i += 1;
            continue;
        }
        let need = if c < 0xE0 { 1 } else if c < 0xF0 { 2 } else { 3 };
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c == 0xE0 {
            lo = 0xA0;
        } else if c == 0xED {
            hi = 0x9F;
        } else if c == 0xF0 {
            lo = 0x90;
        } else if c == 0xF4 {
            hi = 0x8F;
        }
        let mut k = 1;
        let mut bad = false;
        while k <= need {
            if i + k >= n {
                bad = true;
                break;
            }
            let d = b[i + k];
            let ok = if k == 1 { d >= lo and d <= hi } else { is_cont(d) };
            if not ok {
                bad = true;
                break;
            }
            k += 1;
        }
        if bad {
            push_utf8(mut out, 0xFFFD);
            i += k;
            continue;
        }
        for j in 0..(need + 1) {
            out.push(b[i + j]);
        }
        i += need + 1;
    }
    String.from_utf8(out).unwrap()
}

// ------------------------------------------------------------ dates

struct Civil {
    y: i64,
    m: i64,
    d: i64,
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// Howard Hinnant's civil_from_days.
fn civil_from_days(z0: i64) -> Civil {
    let z = z0 + 719468;
    let era = floor_div(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    Civil { y: if m <= 2 { y + 1 } else { y }, m: m, d: d }
}

fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = floor_div(y, 400);
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn pad2(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn pad_n(n: i64, w: i64) -> String {
    let mut s = f"{n}";
    while s.len() < w {
        s = f"0{s}";
    }
    s
}

fn month_name(m: i64) -> Str {
    if m == 1 { "January" } else if m == 2 { "February" } else if m == 3 { "March" }
    else if m == 4 { "April" } else if m == 5 { "May" } else if m == 6 { "June" }
    else if m == 7 { "July" } else if m == 8 { "August" } else if m == 9 { "September" }
    else if m == 10 { "October" } else if m == 11 { "November" } else { "December" }
}

fn day_name(wd: i64) -> Str {
    if wd == 0 { "Sunday" } else if wd == 1 { "Monday" } else if wd == 2 { "Tuesday" }
    else if wd == 3 { "Wednesday" } else if wd == 4 { "Thursday" } else if wd == 5 { "Friday" }
    else { "Saturday" }
}

fn short(name: Str) -> String {
    take_chars(name.to_string(), 3)
}

// A moment as datetime holds it: microseconds since 1970 on the wall
// clock it shows, and whether it is aware (UTC) or naive.
fn iso_format(us: i64) -> String {
    let days = floor_div(us, 86400000000);
    let rem = us - days * 86400000000;
    let c = civil_from_days(days);
    let secs = rem / 1000000;
    let micro = rem % 1000000;
    let mut out = f"{pad_n(c.y, 4)}-{pad2(c.m)}-{pad2(c.d)}T{pad2(secs / 3600)}:{pad2((secs / 60) % 60)}:{pad2(secs % 60)}";
    if micro != 0 {
        out.push_str(f".{pad_n(micro, 6)}");
    }
    out
}

fn strftime(us: i64, fmt: ref String, utc: bool) -> String {
    let days = floor_div(us, 86400000000);
    let rem = us - days * 86400000000;
    let c = civil_from_days(days);
    let secs = rem / 1000000;
    let micro = rem % 1000000;
    let h = secs / 3600;
    let wd = (days + 4) % 7;
    let wday = if wd < 0 { wd + 7 } else { wd };
    let yday = days - days_from_civil(c.y, 1, 1) + 1;
    let mut out = String.new();
    let mut pct = false;
    for ch in fmt.chars() {
        if not pct {
            if ch == '%' {
                pct = true;
            } else {
                out.push(ch);
            }
            continue;
        }
        pct = false;
        if ch == 'Y' {
            out.push_str(f"{c.y}");
        } else if ch == 'y' {
            out.push_str(pad2(c.y % 100));
        } else if ch == 'm' {
            out.push_str(pad2(c.m));
        } else if ch == 'd' {
            out.push_str(pad2(c.d));
        } else if ch == 'H' {
            out.push_str(pad2(h));
        } else if ch == 'I' {
            let h12 = if h % 12 == 0 { 12 } else { h % 12 };
            out.push_str(pad2(h12));
        } else if ch == 'p' {
            out.push_str(if h < 12 { "AM" } else { "PM" });
        } else if ch == 'M' {
            out.push_str(pad2((secs / 60) % 60));
        } else if ch == 'S' {
            out.push_str(pad2(secs % 60));
        } else if ch == 'f' {
            out.push_str(pad_n(micro, 6));
        } else if ch == 'j' {
            out.push_str(pad_n(yday, 3));
        } else if ch == 'a' {
            out.push_str(short(day_name(wday)));
        } else if ch == 'A' {
            out.push_str(day_name(wday));
        } else if ch == 'b' {
            out.push_str(short(month_name(c.m)));
        } else if ch == 'B' {
            out.push_str(month_name(c.m));
        } else if ch == 'z' {
            if utc {
                out.push_str("+0000");
            }
        } else if ch == 'Z' {
            if utc {
                out.push_str("UTC");
            }
        } else if ch == '%' {
            out.push('%');
        } else {
            out.push('%');
            out.push(ch);
        }
    }
    out
}
// ------------------------------------------------------------ processors

#[derive(Clone)]
struct KvOpts {
    sort_keys: bool,
    key_order: Vec[String],
    drop_missing: bool,
    repr_native: bool,
}

#[derive(Clone)]
struct LfOpts {
    sort_keys: bool,
    key_order: Vec[String],
    drop_missing: bool,
    bool_as_flag: bool,
}

#[derive(Clone)]
struct StampOpts {
    fmt: String,
    has_fmt: bool,
    utc: bool,
    key: String,
}

#[derive(Clone)]
struct RenameOpts {
    to: String,
    replace_by: String,
    has_replace: bool,
}

#[derive(Clone)]
struct EncOpts {
    encoding: String,
    errors: String,
}

#[derive(Clone)]
struct ConsoleCfg {
    colors: bool,
    pad_event: i64,
    repr_native: bool,
    styles: i64,
    sort_keys: bool,
    event_key: String,
    timestamp_key: String,
    level_width: i64,
}

#[derive(Clone)]
struct DropOpts {
    key: String,
    value: V,
}

#[derive(Clone)]
enum Proc {
    AddLevel,
    FormatExc,
    DictTb,
    SetExcInfo,
    MergeCtx,
    StackInfo,
    Kv(KvOpts),
    Logfmt(LfOpts),
    Json(JsonOpts),
    Stamp(StampOpts),
    MaybeStamp(StampOpts),
    Rename(RenameOpts),
    Encoder(EncOpts),
    Decoder,
    Console(ConsoleCfg),
    Capture(i64),
    Method,
    Add(Vec[Item]),
    AsTuple,
    Ret(V),
    DropIf(DropOpts),
    Sample(i64),
    Raise(ExcV),
    Encode,
    Redact(Vec[String]),
}

// ------------------------------------------------------------ the world

// What a wrapped logger is. Print, Write and Bytes loggers write to
// stdout or to a file; a CapturingLogger keeps its calls.
const PRINT: i64 = 0;
const WRITE: i64 = 1;
const BYTES: i64 = 2;
const RETURN: i64 = 3;
const CAPTURING: i64 = 4;

// The wrapper class: -1 is the generic BoundLogger, anything else is
// make_filtering_bound_logger(level).
const GENERIC: i64 = -1;
const NO_WRAPPER: i64 = -2;

#[derive(Clone)]
struct CallRec {
    name: String,
    args: Vec[V],
    kw: Vec[Item],
}

#[derive(Clone)]
struct Wrapped {
    kind: i64,
    file: i64,
    calls: Vec[CallRec],
}

#[derive(Clone)]
struct Bound {
    level: i64,
    wrapped: i64,
    procs: i64,
    ctx: Vec[Item],
}

// A BoundLoggerLazyProxy: -1 (or NO_WRAPPER) where it takes the
// configuration's value when it binds.
#[derive(Clone)]
struct Proxy {
    wrapped: i64,
    procs: i64,
    wrapper: i64,
    cache: i64,
    init: Vec[Item],
    cached: i64,
}

#[derive(Clone)]
struct CVar {
    name: String,
    set: bool,
    val: V,
}

struct FileBuf {
    path: String,
    text: String,
}

struct Sampler {
    event: String,
    every: i64,
    seen: i64,
    dropped: i64,
}

struct Named {
    name: String,
    idx: i64,
}

// A job's variable: a lazy proxy or a bound logger.
struct Var {
    name: String,
    proxy: bool,
    idx: i64,
}

struct World {
    wrapped: Vec[Wrapped],
    bounds: Vec[Bound],
    proxies: Vec[Proxy],
    lists: Vec[Vec[Proc]],
    styles: Vec[Vec[Item]],
    caps: Vec[Vec[V]],
    samplers: Vec[Sampler],
    cvars: Vec[CVar],
    files: Vec[FileBuf],
    clock: i64,
    handling: Vec[ExcV],
    cfg_procs: i64,
    cfg_wrapper: i64,
    cfg_factory_kind: i64,
    cfg_factory: i64,
    cfg_cache: bool,
    default_console: ConsoleCfg,
    stdout_print: i64,
    vars: Vec[Var],
    cap_names: Vec[Named],
    capturing_names: Vec[Named],
    style_names: Vec[Named],
}

const STEP: i64 = 250000;

fn tick(w: mut ref World) -> i64 {
    let us = w.clock;
    w.clock += STEP;
    us
}

fn new_wrapped(w: mut ref World, kind: i64, file: i64) -> i64 {
    w.wrapped.push(Wrapped { kind: kind, file: file, calls: Vec.new() });
    w.wrapped.len() - 1
}

fn new_list(w: mut ref World, procs: own Vec[Proc]) -> i64 {
    w.lists.push(procs);
    w.lists.len() - 1
}

fn default_level_styles(colors: bool) -> Vec[Item] {
    let red = if colors { "\u{1b}[31m" } else { "" };
    let yellow = if colors { "\u{1b}[33m" } else { "" };
    let green = if colors { "\u{1b}[32m" } else { "" };
    let red_back = if colors { "\u{1b}[41m" } else { "" };
    let mut d: Vec[Item] = Vec.new();
    d.push(Item { k: sv("critical"), v: sv(red) });
    d.push(Item { k: sv("exception"), v: sv(red) });
    d.push(Item { k: sv("error"), v: sv(red) });
    d.push(Item { k: sv("warn"), v: sv(yellow) });
    d.push(Item { k: sv("warning"), v: sv(yellow) });
    d.push(Item { k: sv("info"), v: sv(green) });
    d.push(Item { k: sv("debug"), v: sv(green) });
    d.push(Item { k: sv("notset"), v: sv(red_back) });
    d
}

fn new_styles(w: mut ref World, d: own Vec[Item]) -> i64 {
    w.styles.push(d);
    w.styles.len() - 1
}

struct ConsoleSpec {
    colors: bool,
    pad_event: i64,
    repr_native: bool,
    styles: i64,
    sort_keys: bool,
    event_key: String,
    timestamp_key: String,
    pad_level: bool,
}

fn console_spec() -> ConsoleSpec {
    ConsoleSpec { colors: true, pad_event: 30, repr_native: false, styles: -1, sort_keys: true,
                  event_key: "event".to_string(), timestamp_key: "timestamp".to_string(), pad_level: true }
}

// ConsoleRenderer.__init__: the level styles it is given are changed in
// place, each style getting `bright` on its end.
fn make_console(w: mut ref World, s: ref ConsoleSpec) -> Result[ConsoleCfg, Exc] {
    let idx = if s.styles >= 0 { s.styles } else { new_styles(mut w, default_level_styles(s.colors)) };
    let bright = if s.colors { "\u{1b}[1m" } else { "" };
    let n = w.styles[idx].len();
    for i in 0..n {
        let cur = py_str(w.styles[idx][i].v);
        w.styles[idx][i].v = V.Str(f"{cur}{bright}");
    }
    if n == 0 {
        return Err(verr("max() iterable argument is empty".to_string()));
    }
    let mut longest = 0;
    for it in w.styles[idx].iter() {
        let l = char_count(key_text(it));
        if l > longest {
            longest = l;
        }
    }
    Ok(ConsoleCfg { colors: s.colors, pad_event: s.pad_event, repr_native: s.repr_native, styles: idx,
                    sort_keys: s.sort_keys, event_key: s.event_key.clone(), timestamp_key: s.timestamp_key.clone(),
                    level_width: if s.pad_level { longest } else { 0 } })
}

fn default_stamp() -> StampOpts {
    StampOpts { fmt: String.new(), has_fmt: false, utc: true, key: "timestamp".to_string() }
}

fn check_stamp(o: ref StampOpts) -> Result[(), Exc] {
    if not o.has_fmt and not o.utc {
        return Err(verr("UNIX timestamps are always UTC.".to_string()));
    }
    Ok(())
}

// structlog's _BUILTIN_DEFAULT_PROCESSORS[:], a new list each time.
fn default_processors(w: ref World) -> Vec[Proc] {
    let mut procs: Vec[Proc] = Vec.new();
    procs.push(Proc.MergeCtx);
    procs.push(Proc.AddLevel);
    procs.push(Proc.StackInfo);
    procs.push(Proc.SetExcInfo);
    procs.push(Proc.Stamp(StampOpts { fmt: "%Y-%m-%d %H:%M:%S".to_string(), has_fmt: true, utc: false, key: "timestamp".to_string() }));
    procs.push(Proc.Console(w.default_console.clone()));
    procs
}

fn reset_defaults(w: mut ref World) {
    let procs = default_processors(w);
    w.cfg_procs = new_list(mut w, procs);
    w.cfg_wrapper = 0;
    w.cfg_factory_kind = PRINT;
    w.cfg_factory = w.stdout_print;
    w.cfg_cache = false;
}

fn new_world() -> World {
    let placeholder = ConsoleCfg { colors: false, pad_event: 30, repr_native: false, styles: 0, sort_keys: true,
                                   event_key: "event".to_string(), timestamp_key: "timestamp".to_string(), level_width: 9 };
    let mut w = World {
        wrapped: Vec.new(), bounds: Vec.new(), proxies: Vec.new(), lists: Vec.new(), styles: Vec.new(),
        caps: Vec.new(), samplers: Vec.new(), cvars: Vec.new(), files: Vec.new(), clock: 0,
        handling: Vec.new(), cfg_procs: 0, cfg_wrapper: 0, cfg_factory_kind: PRINT, cfg_factory: 0,
        cfg_cache: false, default_console: placeholder, stdout_print: 0, vars: Vec.new(),
        cap_names: Vec.new(), capturing_names: Vec.new(), style_names: Vec.new(),
    };
    w.stdout_print = new_wrapped(mut w, PRINT, -1);
    // The ConsoleRenderer the defaults hold, made once at import; stdout
    // is not a terminal, so it has no colors.
    let mut spec = console_spec();
    spec.colors = false;
    w.default_console = make_console(mut w, spec).unwrap();
    reset_defaults(mut w);
    w
}

fn named(list: ref Vec[Named], name: ref String) -> i64 {
    for n in list.iter() {
        if n.name == *name {
            return n.idx;
        }
    }
    -1
}

// ------------------------------------------------------------ output

fn write_line(w: mut ref World, file: i64, text: ref String) {
    if file < 0 {
        println(text);
    } else {
        w.files[file].text.push_str(text);
        w.files[file].text.push('\n');
    }
}

fn open_file(w: mut ref World, path: Str) -> i64 {
    w.files.push(FileBuf { path: path.to_string(), text: String.new() });
    w.files.len() - 1
}

fn close_file(w: ref World, f: i64) -> Result[(), Exc] {
    match fs.write(w.files[f].path.clone(), w.files[f].text.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(Exc { kind: "OSError".to_string(), msg: f"{w.files[f].path}: {e}" }),
    }
}

// ------------------------------------------------------------ calling

// Python's argument binding for def f(self, <names>, *args, **kw): the
// first `required` names have no default.
struct Params {
    vals: Vec[V],
    set: Vec[bool],
    extra: Vec[V],
    kw: Vec[Item],
}

fn plural(n: i64, word: Str) -> String {
    if n == 1 { f"{n} {word}" } else { f"{n} {word}s" }
}

fn bind_params(fname: Str, names: ref Vec[String], required: i64, args: ref Vec[V], kw: ref Vec[Item],
               varargs: bool, varkw: bool) -> Result[Params, Exc] {
    let mut vals: Vec[V] = Vec.new();
    let mut set: Vec[bool] = Vec.new();
    for i in 0..names.len() {
        if i < args.len() {
            vals.push(args[i].clone());
            set.push(true);
        } else {
            vals.push(V.Nothing);
            set.push(false);
        }
    }
    let mut extra: Vec[V] = Vec.new();
    let mut i = names.len();
    while i < args.len() {
        extra.push(args[i].clone());
        i += 1;
    }
    let mut rest: Vec[Item] = Vec.new();
    for it in kw.iter() {
        let k = key_text(it);
        let mut found = -1;
        for j in 0..names.len() {
            if names[j] == k {
                found = j;
            }
        }
        if found >= 0 {
            if set[found] {
                return Err(terr(f"{fname}() got multiple values for argument '{k}'"));
            }
            vals[found] = it.v.clone();
            set[found] = true;
        } else if varkw {
            rest.push(it.clone());
        } else {
            return Err(terr(f"{fname}() got an unexpected keyword argument '{k}'"));
        }
    }
    if not varargs and args.len() > names.len() {
        let given = args.len() + 1;
        if required == names.len() {
            return Err(terr(f"{fname}() takes {plural(names.len() + 1, "positional argument")} but {given} were given"));
        }
        return Err(terr(f"{fname}() takes from {required + 1} to {names.len() + 1} positional arguments but {given} were given"));
    }
    let mut missing: Vec[String] = Vec.new();
    for j in 0..required {
        if not set[j] {
            missing.push(f"'{names[j]}'");
        }
    }
    if missing.len() == 1 {
        return Err(terr(f"{fname}() missing 1 required positional argument: {missing[0]}"));
    }
    if missing.len() > 1 {
        let mut list = String.new();
        for j in 0..missing.len() {
            if j > 0 {
                list.push_str(if j == missing.len() - 1 { " and " } else { ", " });
            }
            list.push_str(missing[j]);
        }
        return Err(terr(f"{fname}() missing {missing.len()} required positional arguments: {list}"));
    }
    Ok(Params { vals: vals, set: set, extra: extra, kw: rest })
}

fn strs(xs: ref Vec[Str]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for x in xs.iter() {
        out.push(x.to_string());
    }
    out
}

fn level_name(n: i64) -> Option[String] {
    if n == 10 {
        Some("debug".to_string())
    } else if n == 20 {
        Some("info".to_string())
    } else if n == 30 {
        Some("warning".to_string())
    } else if n == 40 {
        Some("error".to_string())
    } else if n == 50 {
        Some("critical".to_string())
    } else {
        None
    }
}

fn class_name(level: i64) -> String {
    let n = if level == 0 { "Notset" } else if level == 10 { "Debug" } else if level == 20 { "Info" }
            else if level == 30 { "Warning" } else if level == 40 { "Error" } else { "Critical" };
    f"BoundLoggerFilteringAt{n}"
}

fn valid_level(n: i64) -> bool {
    n == 0 or n == 10 or n == 20 or n == 30 or n == 40 or n == 50
}

fn wrapped_name(kind: i64) -> String {
    let n = if kind == PRINT { "PrintLogger" } else if kind == WRITE { "WriteLogger" } else if kind == BYTES { "BytesLogger" }
            else if kind == RETURN { "ReturnLogger" } else { "CapturingLogger" };
    n.to_string()
}

// The names the stdlib-like loggers answer to.
fn is_log_method(m: ref String) -> bool {
    m == "msg" or m == "log" or m == "debug" or m == "info" or m == "warn" or m == "warning" or m == "fatal"
        or m == "failure" or m == "err" or m == "error" or m == "critical" or m == "exception"
}

fn map_method_name(m: ref String) -> String {
    if m == "warn" {
        return "warning".to_string();
    }
    if m == "exception" {
        return "error".to_string();
    }
    m.clone()
}

fn wrapped_call(w: mut ref World, wi: i64, m: ref String, args: own Vec[V], kw: own Vec[Item]) -> Result[V, Exc] {
    let kind = w.wrapped[wi].kind;
    if kind == CAPTURING {
        w.wrapped[wi].calls.push(CallRec { name: m.clone(), args: args, kw: kw });
        return Ok(V.Nothing);
    }
    if not is_log_method(m) {
        return Err(aerr(wrapped_name(kind), m));
    }
    if kind == RETURN {
        if args.len() == 1 and kw.len() == 0 {
            return Ok(args[0].clone());
        }
        return Ok(V.Tuple(vec![V.Tuple(args), V.Dict(kw)]));
    }
    let fname = f"{wrapped_name(kind)}.msg";
    let p = bind_params(fname.as_str(), strs(vec!["message"]), 1, args, kw, false, false)?;
    let file = w.wrapped[wi].file;
    let message = p.vals[0].clone();
    if kind == PRINT {
        write_line(mut w, file, py_str(message));
        return Ok(V.Nothing);
    }
    if kind == WRITE {
        match message {
            V.Str(s) => write_line(mut w, file, s),
            V.Bytes(_) => return Err(terr("can't concat str to bytes".to_string())),
            _ => return Err(unported("a WriteLogger message that is not a str")),
        }
        return Ok(V.Nothing);
    }
    match message {
        V.Bytes(b) => {
            let text = match String.from_utf8(b) {
                Ok(t) => t,
                Err(_) => return Err(unported("bytes that are not UTF-8 on stdout")),
            };
            write_line(mut w, file, text);
        }
        V.Str(_) => return Err(terr("can only concatenate str (not \"bytes\") to str".to_string())),
        _ => return Err(unported("a BytesLogger message that is not bytes")),
    }
    Ok(V.Nothing)
}

// BoundLoggerBase._process_event and _proxy_to_logger.
fn proxy_to_logger(w: mut ref World, bi: i64, m: ref String, event: own Option[V], kw: own Vec[Item]) -> Result[V, Exc] {
    match process_event(mut w, bi, m, event, kw) {
        Ok(v) => Ok(v),
        Err(e) => if is_drop(e) { Ok(V.Nothing) } else { Err(e) },
    }
}

fn process_event(w: mut ref World, bi: i64, m: ref String, event: own Option[V], kw: own Vec[Item]) -> Result[V, Exc] {
    let mut ed = w.bounds[bi].ctx.clone();
    for it in kw.iter() {
        item_put(mut ed, it.k.clone(), it.v.clone());
    }
    if let Some(e) = event {
        if not is_none(e) {
            d_set(mut ed, "event", e);
        }
    }
    let li = w.bounds[bi].procs;
    let procs = w.lists[li].clone();
    let mut val = V.Dict(ed);
    for p in procs.iter() {
        val = run_proc(mut w, p, m, val)?;
    }
    let wi = w.bounds[bi].wrapped;
    match val {
        V.Str(_) => wrapped_call(mut w, wi, m, vec![val.clone()], Vec.new()),
        V.Bytes(_) => wrapped_call(mut w, wi, m, vec![val.clone()], Vec.new()),
        V.Tuple(xs) => {
            if xs.len() > 2 {
                return Err(verr("too many values to unpack (expected 2)".to_string()));
            }
            if xs.len() < 2 {
                return Err(verr(f"not enough values to unpack (expected 2, got {xs.len()})"));
            }
            let args = match xs[0] {
                V.Tuple(a) => a.clone(),
                V.List(a) => a.clone(),
                _ => return Err(unported("args that are not a tuple")),
            };
            let kws = match xs[1] {
                V.Dict(d) => d.clone(),
                _ => return Err(unported("kwargs that are not a dict")),
            };
            wrapped_call(mut w, wi, m, args, kws)
        }
        V.Dict(items) => wrapped_call(mut w, wi, m, Vec.new(), items),
        _ => Err(verr("Last processor didn't return an appropriate value.  Valid return values are a dict, a tuple of (args, kwargs), bytes, or a str.".to_string())),
    }
}

// event % args when there are args.
fn emit(w: mut ref World, bi: i64, name: Str, event: own V, extra: own Vec[V], kw: own Vec[Item]) -> Result[V, Exc] {
    if extra.len() == 0 {
        return proxy_to_logger(mut w, bi, name.to_string(), Some(event), kw);
    }
    let text = match event {
        V.Str(s) => percent_format(s, extra)?,
        _ => return Err(unported("% on an event that is not a str")),
    };
    proxy_to_logger(mut w, bi, name.to_string(), Some(V.Str(text)), kw)
}

// (level, the method name the processors see), or None for a name the
// filtering logger has no method for. log and exception are apart.
fn filter_method(m: ref String) -> Option[(i64, String)] {
    if m == "debug" {
        Some((10, "debug".to_string()))
    } else if m == "info" or m == "msg" {
        Some((20, "info".to_string()))
    } else if m == "warning" or m == "warn" {
        Some((30, "warning".to_string()))
    } else if m == "error" or m == "fatal" {
        Some((40, "error".to_string()))
    } else if m == "critical" {
        Some((50, "critical".to_string()))
    } else {
        None
    }
}

fn bound_call(w: mut ref World, bi: i64, m: ref String, args: own Vec[V], kw: own Vec[Item]) -> Result[V, Exc] {
    let min = w.bounds[bi].level;
    if min == GENERIC {
        let mut a: Vec[V] = vec![V.Str(m.clone())];
        for x in args.iter() {
            a.push(x.clone());
        }
        let p = bind_params("BoundLoggerBase._proxy_to_logger", strs(vec!["method_name", "event"]), 1, a, kw, false, true)?;
        let event = if p.set[1] { Some(p.vals[1].clone()) } else { None };
        return proxy_to_logger(mut w, bi, m, event, p.kw);
    }
    if m == "log" {
        let p = bind_params("_make_filtering_bound_logger.<locals>.log", strs(vec!["level", "event"]), 2, args, kw, true, true)?;
        let n = match p.vals[0] {
            V.Int(n) => n,
            V.Bool(b) => if b { 1 } else { 0 },
            _ => return Err(terr(f"'<' not supported between instances of '{type_name(p.vals[0])}' and 'int'")),
        };
        if n < min {
            return Ok(V.Nothing);
        }
        let name = match level_name(n) {
            Some(x) => x,
            None => return Err(kerr(p.vals[0])),
        };
        return emit(mut w, bi, name.as_str(), p.vals[1].clone(), p.extra, p.kw);
    }
    if m == "exception" {
        let p = bind_params("exception", strs(vec!["event"]), 1, args, kw, true, true)?;
        let mut kw2 = p.kw.clone();
        if not d_has(kw2, "exc_info") {
            kw2.push(Item { k: sv("exc_info"), v: V.Bool(true) });
        }
        if 40 < min {
            return Ok(V.Nothing);
        }
        return emit(mut w, bi, "error", p.vals[0].clone(), p.extra, kw2);
    }
    let (lv, name) = match filter_method(m) {
        Some(x) => x,
        None => return Err(aerr(class_name(min), m)),
    };
    let fname = if lv < min { "_nop" } else { "_make_filtering_bound_logger.<locals>.make_method.<locals>.meth" };
    let p = bind_params(fname, strs(vec!["event"]), 1, args, kw, true, true)?;
    if lv < min {
        return Ok(V.Nothing);
    }
    emit(mut w, bi, name.as_str(), p.vals[0].clone(), p.extra, p.kw)
}

// ------------------------------------------------------------ binding

fn bound_bind(w: mut ref World, bi: i64, nv: ref Vec[Item]) -> i64 {
    let mut b = w.bounds[bi].clone();
    for it in nv.iter() {
        item_put(mut b.ctx, it.k.clone(), it.v.clone());
    }
    w.bounds.push(b);
    w.bounds.len() - 1
}

fn bound_new(w: mut ref World, bi: i64, nv: ref Vec[Item]) -> i64 {
    w.bounds[bi].ctx.clear();
    bound_bind(mut w, bi, nv)
}

fn bound_unbind(w: mut ref World, bi: i64, keys: ref Vec[String], strict: bool) -> Result[i64, Exc] {
    let nb = bound_bind(mut w, bi, Vec.new());
    for k in keys.iter() {
        if d_pop(mut w.bounds[nb].ctx, k.as_str()).is_none() and strict {
            return Err(kerr(V.Str(k.clone())));
        }
    }
    Ok(nb)
}

fn factory_make(w: mut ref World) -> i64 {
    w.cfg_factory
}

// BoundLoggerLazyProxy.bind
fn proxy_bind(w: mut ref World, pi: i64, nv: ref Vec[Item]) -> i64 {
    let cached = w.proxies[pi].cached;
    if cached >= 0 {
        if nv.len() == 0 {
            return cached;
        }
        return bound_bind(mut w, cached, nv);
    }
    let p = w.proxies[pi].clone();
    let wrapped = if p.wrapped >= 0 { p.wrapped } else { factory_make(mut w) };
    let procs = if p.procs >= 0 { p.procs } else { w.cfg_procs };
    let level = if p.wrapper != NO_WRAPPER { p.wrapper } else { w.cfg_wrapper };
    w.bounds.push(Bound { level: level, wrapped: wrapped, procs: procs, ctx: p.init.clone() });
    let bi = w.bounds.len() - 1;
    if p.cache == 1 or (p.cache == -1 and w.cfg_cache) {
        w.proxies[pi].cached = bi;
    }
    if nv.len() == 0 {
        return bi;
    }
    bound_bind(mut w, bi, nv)
}

fn new_proxy(w: mut ref World, wrapped: i64, procs: i64, wrapper: i64, cache: i64, init: own Vec[Item]) -> i64 {
    w.proxies.push(Proxy { wrapped: wrapped, procs: procs, wrapper: wrapper, cache: cache, init: init, cached: -1 });
    w.proxies.len() - 1
}

// A logger either kind: a lazy proxy binds first.
fn log_call(w: mut ref World, proxy: bool, idx: i64, m: ref String, args: own Vec[V], kw: own Vec[Item]) -> Result[V, Exc] {
    let bi = if proxy { proxy_bind(mut w, idx, Vec.new()) } else { idx };
    bound_call(mut w, bi, m, args, kw)
}

fn get_context(w: ref World, proxy: bool, idx: i64) -> Vec[Item] {
    if proxy {
        return w.proxies[idx].init.clone();
    }
    w.bounds[idx].ctx.clone()
}

// ------------------------------------------------------------ contextvars

fn ctx_bind(w: mut ref World, kw: ref Vec[Item]) {
    for it in kw.iter() {
        let k = key_text(it);
        let mut found = false;
        for c in w.cvars.iter_mut() {
            if c.name == k {
                c.set = true;
                c.val = it.v.clone();
                found = true;
            }
        }
        if not found {
            w.cvars.push(CVar { name: k, set: true, val: it.v.clone() });
        }
    }
}

fn ctx_unbind(w: mut ref World, keys: ref Vec[String]) {
    for c in w.cvars.iter_mut() {
        for k in keys.iter() {
            if c.name == *k {
                c.set = false;
            }
        }
    }
}

fn ctx_clear(w: mut ref World) {
    for c in w.cvars.iter_mut() {
        c.set = false;
    }
}

fn ctx_items(w: ref World) -> Vec[Item] {
    let mut out: Vec[Item] = Vec.new();
    for c in w.cvars.iter() {
        if c.set {
            out.push(Item { k: V.Str(c.name.clone()), v: c.val.clone() });
        }
    }
    out
}

// ------------------------------------------------------------ the processors

fn as_dict(v: own V, what: Str) -> Result[Vec[Item], Exc] {
    match v {
        V.Dict(items) => Ok(items),
        _ => Err(unported(what)),
    }
}

// _figure_out_exc_info, as an exception or None for (None, None, None).
fn figure_exc(w: ref World, v: ref V) -> Result[Option[ExcV], Exc] {
    match v {
        V.Err(e) => Ok(Some(e.clone())),
        V.Tuple(_) => Err(unported("an exc_info tuple")),
        _ => {
            if w.handling.len() > 0 {
                return Ok(Some(w.handling[0].clone()));
            }
            Ok(None)
        }
    }
}

fn kv_order(ed: own Vec[Item], sort: bool, order: ref Vec[String], drop_missing: bool) -> Vec[Item] {
    let mut d = ed;
    if order.len() > 0 {
        let mut items: Vec[Item] = Vec.new();
        for k in order.iter() {
            let v = d_pop(mut d, k.as_str()).unwrap_or(V.Nothing);
            if not is_none(v) or not drop_missing {
                items.push(Item { k: V.Str(k.clone()), v: v });
            }
        }
        let rest = if sort { sorted_items(d) } else { d };
        for it in rest.iter() {
            items.push(it.clone());
        }
        return items;
    }
    if sort {
        return sorted_items(d);
    }
    d
}

fn kv_render(o: ref KvOpts, ed: own Vec[Item]) -> String {
    let items = kv_order(ed, o.sort_keys, o.key_order, o.drop_missing);
    let mut out = String.new();
    for i in 0..items.len() {
        if i > 0 {
            out.push(' ');
        }
        out.push_str(key_text(items[i]));
        out.push('=');
        let text = if o.repr_native { repr(items[i].v) } else { match items[i].v {
            V.Str(s) => s.clone(),
            _ => repr(items[i].v),
        } };
        out.push_str(text);
    }
    out
}

fn logfmt_render(o: ref LfOpts, ed: own Vec[Item]) -> Result[String, Exc] {
    let items = kv_order(ed, o.sort_keys, o.key_order, o.drop_missing);
    let mut elements: Vec[String] = Vec.new();
    for it in items.iter() {
        let key = key_text(it);
        for ch in key.chars() {
            if (ch as i64) <= 32 {
                return Err(verr(f"Invalid key: \"{key}\""));
            }
        }
        if is_none(it.v) {
            elements.push(f"{key}=");
            continue;
        }
        let mut value = String.new();
        if let V.Bool(b) = it.v {
            if o.bool_as_flag and b {
                elements.push(key.clone());
                continue;
            }
            value = if b { "true".to_string() } else { "false".to_string() };
        } else {
            value = py_str(it.v);
        }
        let quote = value.contains(" ") or value.contains("=") or value.contains("\"");
        if quote and value.contains("\\") {
            value = value.replace("\\", "\\\\");
        }
        value = value.replace("\"", "\\\"").replace("\n", "\\n");
        if quote {
            value = f"\"{value}\"";
        }
        elements.push(f"{key}={value}");
    }
    let mut out = String.new();
    for i in 0..elements.len() {
        if i > 0 {
            out.push(' ');
        }
        out.push_str(elements[i]);
    }
    Ok(out)
}

fn stamp_value(w: mut ref World, o: ref StampOpts) -> V {
    let us = tick(mut w);
    if not o.has_fmt {
        return V.Float((us as f64) / 1000000.0);
    }
    let wall = if o.utc { us } else { us + 7200000000 };
    if o.fmt.to_uppercase() == "ISO" {
        let iso = iso_format(wall);
        return V.Str(if o.utc { f"{iso}Z" } else { iso });
    }
    V.Str(strftime(wall, o.fmt, o.utc))
}

struct Styles {
    reset: String,
    bright: String,
    timestamp: String,
    logger_name: String,
    kv_key: String,
    kv_value: String,
}

fn styles_for(colors: bool) -> Styles {
    if not colors {
        return Styles { reset: String.new(), bright: String.new(), timestamp: String.new(), logger_name: String.new(),
                        kv_key: String.new(), kv_value: String.new() };
    }
    Styles { reset: "\u{1b}[0m".to_string(), bright: "\u{1b}[1m".to_string(), timestamp: "\u{1b}[2m".to_string(),
             logger_name: "\u{1b}[34m".to_string(), kv_key: "\u{1b}[36m".to_string(), kv_value: "\u{1b}[35m".to_string() }
}

// s.rstrip(" ")
fn rstrip_spaces(s: ref String) -> String {
    let mut cs: Vec[char] = Vec.new();
    for c in s.chars() {
        cs.push(c);
    }
    let mut n = cs.len();
    while n > 0 and cs[n - 1] == ' ' {
        n -= 1;
    }
    let mut out = String.new();
    for i in 0..n {
        out.push(cs[i]);
    }
    out
}

fn pad(s: ref String, width: i64) -> String {
    let mut out = s.clone();
    let mut n = char_count(s);
    while n < width {
        out.push(' ');
        n += 1;
    }
    out
}

// KeyValueColumnFormatter with no key and no prefix.
fn value_col(style: ref String, reset: ref String, text: ref String, width: i64) -> String {
    f"{style}{pad(text, width)}{reset}"
}

fn console_render(w: ref World, c: ref ConsoleCfg, ed0: own Vec[Item]) -> Result[String, Exc] {
    let st = styles_for(c.colors);
    let mut ed = ed0;
    let stack = d_pop(mut ed, "stack");
    let exc = d_pop(mut ed, "exception");
    let exc_info = d_pop(mut ed, "exc_info");
    let mut kvs: Vec[String] = Vec.new();
    if let Some(v) = d_pop(mut ed, c.timestamp_key.as_str()) {
        kvs.push(value_col(st.timestamp, st.reset, py_str(v), 0));
    }
    if let Some(v) = d_pop(mut ed, "level") {
        let level = match v {
            V.Str(s) => s.clone(),
            _ => return Err(unported("a level that is not a str")),
        };
        let mut style = String.new();
        if let Some(s) = d_get(w.styles[c.styles], level.as_str()) {
            style = py_str(s);
        }
        kvs.push(f"[{style}{pad(level, c.level_width)}{st.reset}]");
    }
    if let Some(v) = d_pop(mut ed, c.event_key.as_str()) {
        kvs.push(value_col(st.bright, st.reset, py_str(v), c.pad_event));
    }
    for key in ["logger", "logger_name"].iter() {
        if let Some(v) = d_pop(mut ed, *key) {
            kvs.push(f"[{st.reset}{st.bright}{st.logger_name}{py_str(v)}{st.reset}]{st.reset}");
        }
    }
    let rest = if c.sort_keys { sorted_items(ed) } else { ed };
    for it in rest.iter() {
        let text = if c.repr_native { repr(it.v) } else { match it.v {
            V.Str(s) => s.clone(),
            _ => repr(it.v),
        } };
        kvs.push(f"{st.kv_key}{key_text(it)}{st.reset}={st.kv_value}{text}{st.reset}");
    }
    let mut line = String.new();
    let mut first = true;
    for kv in kvs.iter() {
        if kv.len() == 0 {
            continue;
        }
        if not first {
            line.push(' ');
        }
        line.push_str(kv);
        first = false;
    }
    let mut out = rstrip_spaces(line);
    if stack.is_some() {
        return Err(unported("a stack in the ConsoleRenderer"));
    }
    let mut shown = false;
    if let Some(v) = exc_info {
        if truthy(v) {
            shown = true;
            if let Some(e) = figure_exc(w, v)? {
                out.push('\n');
                out.push_str(format_exception(e));
            }
        }
    }
    if not shown {
        if let Some(e) = exc {
            out.push('\n');
            out.push_str(py_str(e));
        }
    }
    Ok(out)
}

fn exc_info_value(w: ref World, ed: mut ref Vec[Item], as_dict_tb: bool) -> Result[(), Exc] {
    if let Some(v) = d_pop(mut ed, "exc_info") {
        if truthy(v) {
            let e = figure_exc(w, v)?;
            if as_dict_tb {
                let ex = match e {
                    Some(x) => x,
                    None => return Err(Exc { kind: "AttributeError".to_string(), msg: "'NoneType' object has no attribute '__name__'".to_string() }),
                };
                let mut st: Vec[Item] = Vec.new();
                st.push(Item { k: sv("exc_type"), v: V.Str(ex.kind.clone()) });
                st.push(Item { k: sv("exc_value"), v: V.Str(exc_str(ex)) });
                st.push(Item { k: sv("syntax_error"), v: V.Nothing });
                st.push(Item { k: sv("is_cause"), v: V.Bool(false) });
                st.push(Item { k: sv("frames"), v: V.List(Vec.new()) });
                d_set(mut ed, "exception", V.List(vec![V.Dict(st)]));
            } else {
                let text = match e {
                    Some(x) => format_exception(x),
                    None => "MISSING".to_string(),
                };
                d_set(mut ed, "exception", V.Str(text));
            }
        }
    }
    Ok(())
}

fn run_proc(w: mut ref World, p: ref Proc, m: ref String, val: own V) -> Result[V, Exc] {
    match p {
        Proc.AddLevel => {
            let mut ed = as_dict(val, "add_log_level on a non-dict")?;
            d_set(mut ed, "level", V.Str(map_method_name(m)));
            Ok(V.Dict(ed))
        }
        Proc.FormatExc => {
            let mut ed = as_dict(val, "format_exc_info on a non-dict")?;
            exc_info_value(w, mut ed, false)?;
            Ok(V.Dict(ed))
        }
        Proc.DictTb => {
            let mut ed = as_dict(val, "dict_tracebacks on a non-dict")?;
            exc_info_value(w, mut ed, true)?;
            Ok(V.Dict(ed))
        }
        Proc.SetExcInfo => {
            let mut ed = as_dict(val, "set_exc_info on a non-dict")?;
            if m == "exception" and not d_has(ed, "exc_info") {
                d_set(mut ed, "exc_info", V.Bool(true));
            }
            Ok(V.Dict(ed))
        }
        Proc.MergeCtx => {
            let mut ed = as_dict(val, "merge_contextvars on a non-dict")?;
            for it in ctx_items(w).iter() {
                let k = key_text(it);
                if not d_has(ed, k.as_str()) {
                    d_set(mut ed, k.as_str(), it.v.clone());
                }
            }
            Ok(V.Dict(ed))
        }
        Proc.StackInfo => {
            let mut ed = as_dict(val, "StackInfoRenderer on a non-dict")?;
            if let Some(v) = d_pop(mut ed, "stack_info") {
                if truthy(v) {
                    return Err(unported("stack_info=True"));
                }
            }
            Ok(V.Dict(ed))
        }
        Proc.Kv(o) => {
            let ed = as_dict(val, "KeyValueRenderer on a non-dict")?;
            Ok(V.Str(kv_render(o, ed)))
        }
        Proc.Logfmt(o) => {
            let ed = as_dict(val, "LogfmtRenderer on a non-dict")?;
            Ok(V.Str(logfmt_render(o, ed)?))
        }
        Proc.Json(o) => Ok(V.Str(json_dumps(o, val)?)),
        Proc.Stamp(o) => {
            let mut ed = as_dict(val, "TimeStamper on a non-dict")?;
            let t = stamp_value(mut w, o);
            d_set(mut ed, o.key.as_str(), t);
            Ok(V.Dict(ed))
        }
        Proc.MaybeStamp(o) => {
            let mut ed = as_dict(val, "MaybeTimeStamper on a non-dict")?;
            if not d_has(ed, "timestamp") {
                let t = stamp_value(mut w, o);
                d_set(mut ed, o.key.as_str(), t);
            }
            Ok(V.Dict(ed))
        }
        Proc.Rename(o) => {
            let mut ed = as_dict(val, "EventRenamer on a non-dict")?;
            let event = match d_pop(mut ed, "event") {
                Some(e) => e,
                None => return Err(kerr(sv("event"))),
            };
            d_set(mut ed, o.to.as_str(), event);
            if o.has_replace {
                if let Some(r) = d_pop(mut ed, o.replace_by.as_str()) {
                    if not is_none(r) {
                        d_set(mut ed, "event", r);
                    }
                }
            }
            Ok(V.Dict(ed))
        }
        Proc.Encoder(o) => {
            let mut ed = as_dict(val, "UnicodeEncoder on a non-dict")?;
            for i in 0..ed.len() {
                if let V.Str(s) = ed[i].v {
                    let b = encode_text(s, o.encoding, o.errors)?;
                    ed[i].v = V.Bytes(b);
                }
            }
            Ok(V.Dict(ed))
        }
        Proc.Decoder => {
            let mut ed = as_dict(val, "UnicodeDecoder on a non-dict")?;
            for i in 0..ed.len() {
                if let V.Bytes(b) = ed[i].v {
                    let s = decode_replace(b);
                    ed[i].v = V.Str(s);
                }
            }
            Ok(V.Dict(ed))
        }
        Proc.Console(c) => {
            let ed = as_dict(val, "ConsoleRenderer on a non-dict")?;
            Ok(V.Str(console_render(w, c, ed)?))
        }
        Proc.Capture(ci) => {
            let mut ed = as_dict(val, "LogCapture on a non-dict")?;
            d_set(mut ed, "log_level", V.Str(map_method_name(m)));
            w.caps[*ci].push(V.Dict(ed));
            Err(drop_event())
        }
        Proc.Method => {
            let mut ed = as_dict(val, "a processor on a non-dict")?;
            d_set(mut ed, "method", V.Str(m.clone()));
            Ok(V.Dict(ed))
        }
        Proc.Add(items) => {
            let mut ed = as_dict(val, "a processor on a non-dict")?;
            for it in items.iter() {
                item_put(mut ed, it.k.clone(), it.v.clone());
            }
            Ok(V.Dict(ed))
        }
        Proc.AsTuple => {
            let mut ed = as_dict(val, "a processor on a non-dict")?;
            let event = match d_pop(mut ed, "event") {
                Some(e) => e,
                None => return Err(kerr(sv("event"))),
            };
            Ok(V.Tuple(vec![V.Tuple(vec![event]), V.Dict(ed)]))
        }
        Proc.Ret(v) => Ok(v.clone()),
        Proc.DropIf(o) => {
            let ed = as_dict(val, "a processor on a non-dict")?;
            if let Some(v) = d_get(ed, o.key.as_str()) {
                if py_eq(v, o.value) {
                    return Err(drop_event());
                }
            }
            Ok(V.Dict(ed))
        }
        Proc.Sample(si) => {
            let ed = as_dict(val, "a processor on a non-dict")?;
            if let Some(V.Str(e)) = d_get(ed, "event") {
                if e == w.samplers[*si].event {
                    w.samplers[*si].seen += 1;
                    if (w.samplers[*si].seen - 1) % w.samplers[*si].every != 0 {
                        w.samplers[*si].dropped += 1;
                        return Err(drop_event());
                    }
                }
            }
            Ok(V.Dict(ed))
        }
        Proc.Raise(e) => Err(raised(e)),
        Proc.Encode => match val {
            V.Str(s) => {
                let mut b: Vec[u8] = Vec.new();
                for x in s.bytes() {
                    b.push(x);
                }
                Ok(V.Bytes(b))
            }
            _ => Err(unported("encode on a non-str")),
        },
        Proc.Redact(keys) => {
            let mut ed = as_dict(val, "a processor on a non-dict")?;
            for k in keys.iter() {
                if d_has(ed, k.as_str()) {
                    d_set(mut ed, k.as_str(), sv("[redacted]"));
                }
            }
            Ok(V.Dict(ed))
        }
    }
}
// ------------------------------------------------------------ building

fn opt_bool(spec: ref J, key: Str, default: bool) -> bool {
    match j_member(spec, key) {
        Some(J.Bool(b)) => b,
        _ => default,
    }
}

fn opt_int(spec: ref J, key: Str, default: i64) -> i64 {
    match j_member(spec, key) {
        Some(J.Int(d)) => i64.parse(d).unwrap_or(default),
        _ => default,
    }
}

fn opt_str(spec: ref J, key: Str, default: Str) -> String {
    match j_member(spec, key) {
        Some(J.Str(s)) => s,
        _ => default.to_string(),
    }
}

fn opt_strs(spec: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let Some(v) = j_member(spec, key) {
        for x in j_items(v).iter() {
            out.push(j_str(x));
        }
    }
    out
}

fn stamp_opts(spec: ref J) -> Result[StampOpts, Exc] {
    let (fmt, has_fmt) = match j_member(spec, "fmt") {
        Some(J.Str(s)) => (s, true),
        _ => (String.new(), false),
    };
    let o = StampOpts { fmt: fmt, has_fmt: has_fmt, utc: opt_bool(spec, "utc", true), key: opt_str(spec, "key", "timestamp") };
    check_stamp(o)?;
    Ok(o)
}

fn build_proc(w: mut ref World, spec: ref J) -> Result[Proc, Exc] {
    if let J.Str(name) = spec {
        if name == "add_log_level" {
            return Ok(Proc.AddLevel);
        }
        if name == "format_exc_info" {
            return Ok(Proc.FormatExc);
        }
        if name == "dict_tracebacks" {
            return Ok(Proc.DictTb);
        }
        if name == "set_exc_info" {
            return Ok(Proc.SetExcInfo);
        }
        if name == "merge_contextvars" {
            return Ok(Proc.MergeCtx);
        }
        return Err(unported("that processor"));
    }
    let p = opt_str(spec, "p", "");
    if p == "KeyValueRenderer" {
        return Ok(Proc.Kv(KvOpts { sort_keys: opt_bool(spec, "sort_keys", false), key_order: opt_strs(spec, "key_order"),
                                   drop_missing: opt_bool(spec, "drop_missing", false),
                                   repr_native: opt_bool(spec, "repr_native_str", true) }));
    }
    if p == "LogfmtRenderer" {
        return Ok(Proc.Logfmt(LfOpts { sort_keys: opt_bool(spec, "sort_keys", false), key_order: opt_strs(spec, "key_order"),
                                       drop_missing: opt_bool(spec, "drop_missing", false),
                                       bool_as_flag: opt_bool(spec, "bool_as_flag", true) }));
    }
    if p == "JSONRenderer" {
        let indent = opt_int(spec, "indent", -1);
        let seps = opt_strs(spec, "separators");
        let (item_sep, key_sep) = if seps.len() == 2 {
            (seps[0].clone(), seps[1].clone())
        } else if indent >= 0 {
            (",".to_string(), ": ".to_string())
        } else {
            (", ".to_string(), ": ".to_string())
        };
        return Ok(Proc.Json(JsonOpts { sort_keys: opt_bool(spec, "sort_keys", false), indent: indent,
                                       ensure_ascii: opt_bool(spec, "ensure_ascii", true), item_sep: item_sep, key_sep: key_sep }));
    }
    if p == "TimeStamper" {
        return Ok(Proc.Stamp(stamp_opts(spec)?));
    }
    if p == "MaybeTimeStamper" {
        return Ok(Proc.MaybeStamp(stamp_opts(spec)?));
    }
    if p == "EventRenamer" {
        let (replace_by, has_replace) = match j_member(spec, "replace_by") {
            Some(J.Str(s)) => (s, true),
            _ => (String.new(), false),
        };
        return Ok(Proc.Rename(RenameOpts { to: opt_str(spec, "to", ""), replace_by: replace_by, has_replace: has_replace }));
    }
    if p == "UnicodeEncoder" {
        return Ok(Proc.Encoder(EncOpts { encoding: opt_str(spec, "encoding", "utf-8"), errors: opt_str(spec, "errors", "backslashreplace") }));
    }
    if p == "UnicodeDecoder" {
        return Ok(Proc.Decoder);
    }
    if p == "ConsoleRenderer" {
        let mut s = console_spec();
        s.colors = opt_bool(spec, "colors", true);
        s.pad_event = opt_int(spec, "pad_event", 30);
        s.repr_native = opt_bool(spec, "repr_native_str", false);
        s.sort_keys = opt_bool(spec, "sort_keys", true);
        s.event_key = opt_str(spec, "event_key", "event");
        s.timestamp_key = opt_str(spec, "timestamp_key", "timestamp");
        s.pad_level = opt_bool(spec, "pad_level", true);
        if let Some(J.Str(name)) = j_member(spec, "level_styles") {
            s.styles = named(w.style_names, name);
        }
        return Ok(Proc.Console(make_console(mut w, s)?));
    }
    if p == "LogCapture" {
        w.caps.push(Vec.new());
        let ci = w.caps.len() - 1;
        w.cap_names.push(Named { name: opt_str(spec, "name", ""), idx: ci });
        return Ok(Proc.Capture(ci));
    }
    if p == "method" {
        return Ok(Proc.Method);
    }
    if p == "add" {
        return Ok(Proc.Add(kwargs(j_member(spec, "kw").unwrap_or(J.Null))));
    }
    if p == "as_tuple" {
        return Ok(Proc.AsTuple);
    }
    if p == "return" {
        return Ok(Proc.Ret(decode(j_member(spec, "value").unwrap_or(J.Null))));
    }
    if p == "drop_if" {
        return Ok(Proc.DropIf(DropOpts { key: opt_str(spec, "key", ""), value: decode(j_member(spec, "value").unwrap_or(J.Null)) }));
    }
    if p == "sample" {
        w.samplers.push(Sampler { event: opt_str(spec, "event", ""), every: opt_int(spec, "every", 1), seen: 0, dropped: 0 });
        return Ok(Proc.Sample(w.samplers.len() - 1));
    }
    if p == "raise" {
        let e = match decode(j_member(spec, "exc").unwrap_or(J.Null)) {
            V.Err(e) => e,
            _ => return Err(unported("raise without an exception")),
        };
        return Ok(Proc.Raise(e));
    }
    if p == "encode" {
        return Ok(Proc.Encode);
    }
    Err(unported("that processor"))
}

fn build_procs(w: mut ref World, specs: ref J) -> Result[Vec[Proc], Exc] {
    let mut out: Vec[Proc] = Vec.new();
    for s in j_items(specs).iter() {
        out.push(build_proc(mut w, s)?);
    }
    Ok(out)
}

fn build_wrapper(spec: ref J) -> Result[i64, Exc] {
    let s = j_str(spec);
    if s == "generic" {
        return Ok(GENERIC);
    }
    let n = i64.parse(s.replace("filter:", "")).unwrap_or(-1);
    if not valid_level(n) {
        return Err(kerr(V.Int(n)));
    }
    Ok(n)
}

fn capturing_logger(w: mut ref World, name: ref String) -> i64 {
    let i = named(w.capturing_names, name);
    if i >= 0 {
        return i;
    }
    let c = new_wrapped(mut w, CAPTURING, -1);
    w.capturing_names.push(Named { name: name.clone(), idx: c });
    c
}

fn build_wrapped(w: mut ref World, spec: ref J) -> Result[i64, Exc] {
    let t = opt_str(spec, "t", "");
    if t == "return" {
        return Ok(new_wrapped(mut w, RETURN, -1));
    }
    if t == "print" {
        return Ok(new_wrapped(mut w, PRINT, -1));
    }
    if t == "write" {
        return Ok(new_wrapped(mut w, WRITE, -1));
    }
    if t == "bytes" {
        return Ok(new_wrapped(mut w, BYTES, -1));
    }
    if t == "capturing" {
        return Ok(capturing_logger(mut w, opt_str(spec, "name", "")));
    }
    Err(unported("that logger"))
}

// A logger factory: a ReturnLoggerFactory holds one ReturnLogger, a
// CapturingLoggerFactory one new CapturingLogger, and a
// PrintLoggerFactory makes PrintLoggers to stdout, which are all alike.
fn build_factory(w: mut ref World, spec: ref J) -> Result[(i64, i64), Exc] {
    let t = opt_str(spec, "t", "");
    if t == "return" {
        return Ok((RETURN, new_wrapped(mut w, RETURN, -1)));
    }
    if t == "print" {
        return Ok((PRINT, w.stdout_print));
    }
    if t == "capturing" {
        let c = new_wrapped(mut w, CAPTURING, -1);
        let name = opt_str(spec, "name", "");
        let mut found = false;
        for n in w.capturing_names.iter_mut() {
            if n.name == name {
                n.idx = c;
                found = true;
            }
        }
        if not found {
            w.capturing_names.push(Named { name: name, idx: c });
        }
        return Ok((CAPTURING, c));
    }
    Err(unported("that factory"))
}

// ------------------------------------------------------------ the jobs

fn find_var(w: ref World, name: ref String) -> Option[(bool, i64)] {
    for v in w.vars.iter() {
        if v.name == *name {
            return Some((v.proxy, v.idx));
        }
    }
    None
}

fn var(w: ref World, st: ref J, key: Str) -> Result[(bool, i64), Exc] {
    let name = opt_str(st, key, "");
    match find_var(w, name) {
        Some(x) => Ok(x),
        None => Err(Exc { kind: "NameError".to_string(), msg: f"name '{name}' is not defined" }),
    }
}

fn set_var(w: mut ref World, name: own String, proxy: bool, idx: i64) {
    for v in w.vars.iter_mut() {
        if v.name == name {
            v.proxy = proxy;
            v.idx = idx;
            return;
        }
    }
    w.vars.push(Var { name: name, proxy: proxy, idx: idx });
}

fn run_steps(w: mut ref World, steps: ref Vec[J]) {
    for st in steps.iter() {
        if let Err(e) = run_step(mut w, st) {
            println(f"!! {e.kind}: {e.msg}");
        }
    }
}

fn kw_of(st: ref J) -> Vec[Item] {
    kwargs(j_member(st, "kw").unwrap_or(J.Null))
}

fn body_of(st: ref J) -> Vec[J] {
    j_items(j_member(st, "body").unwrap_or(J.Null))
}

fn reset(w: mut ref World) {
    reset_defaults(mut w);
    ctx_clear(mut w);
}

fn run_step(w: mut ref World, st: ref J) -> Result[(), Exc] {
    let op = opt_str(st, "op", "");
    if op == "get" {
        let init = kwargs(j_member(st, "init").unwrap_or(J.Null));
        let p = new_proxy(mut w, -1, -1, NO_WRAPPER, -1, init);
        set_var(mut w, opt_str(st, "as", ""), true, p);
    } else if op == "wrap" {
        let procs = match j_member(st, "procs") {
            Some(ps) => {
                let built = build_procs(mut w, ps)?;
                new_list(mut w, built)
            }
            None => -1,
        };
        let wrapper = match j_member(st, "wrapper") {
            Some(s) => build_wrapper(s)?,
            None => NO_WRAPPER,
        };
        let wrapped = build_wrapped(mut w, j_member(st, "wrapped").unwrap_or(J.Null))?;
        let cache = match j_member(st, "cache") {
            Some(J.Bool(b)) => if b { 1 } else { 0 },
            _ => -1,
        };
        let init = kwargs(j_member(st, "init").unwrap_or(J.Null));
        let p = new_proxy(mut w, wrapped, procs, wrapper, cache, init);
        set_var(mut w, opt_str(st, "as", ""), true, p);
    } else if op == "configure" {
        let mut procs: Vec[Proc] = Vec.new();
        let has_procs = j_member(st, "procs").is_some();
        if let Some(ps) = j_member(st, "procs") {
            procs = build_procs(mut w, ps)?;
        }
        let wrapper = match j_member(st, "wrapper") {
            Some(s) => build_wrapper(s)?,
            None => NO_WRAPPER,
        };
        let factory = match j_member(st, "factory") {
            Some(f) => build_factory(mut w, f)?,
            None => (-1, -1),
        };
        if has_procs {
            w.cfg_procs = new_list(mut w, procs);
        }
        if wrapper != NO_WRAPPER {
            w.cfg_wrapper = wrapper;
        }
        if factory.0 >= 0 {
            w.cfg_factory_kind = factory.0;
            w.cfg_factory = factory.1;
        }
        if let Some(J.Bool(b)) = j_member(st, "cache") {
            w.cfg_cache = b;
        }
    } else if op == "reset" {
        reset_defaults(mut w);
    } else if op == "call" {
        let (proxy, idx) = var(w, st, "log")?;
        let m = opt_str(st, "m", "");
        let args = values(j_member(st, "args").unwrap_or(J.Null));
        let ret = log_call(mut w, proxy, idx, m, args, kw_of(st))?;
        if not is_none(ret) {
            println(f"-> {repr(ret)}");
        }
    } else if op == "bind" or op == "new" {
        let (proxy, idx) = var(w, st, "log")?;
        let nv = kw_of(st);
        let bi = if proxy {
            proxy_bind(mut w, idx, nv)
        } else if op == "bind" {
            bound_bind(mut w, idx, nv)
        } else {
            bound_new(mut w, idx, nv)
        };
        set_var(mut w, opt_str(st, "as", ""), false, bi);
    } else if op == "unbind" or op == "try_unbind" {
        let (proxy, idx) = var(w, st, "log")?;
        let bi = if proxy { proxy_bind(mut w, idx, Vec.new()) } else { idx };
        let nb = bound_unbind(mut w, bi, opt_strs(st, "keys"), op == "unbind")?;
        set_var(mut w, opt_str(st, "as", ""), false, nb);
    } else if op == "context" {
        let (proxy, idx) = var(w, st, "log")?;
        println(f"context {opt_str(st, "log", "")}: {dict_repr(get_context(w, proxy, idx))}");
    } else if op == "eq" {
        let (pa, a) = var(w, st, "a")?;
        let (pb, b) = var(w, st, "b")?;
        let same = dict_eq(get_context(w, pa, a), get_context(w, pb, b));
        println(f"{opt_str(st, "a", "")} == {opt_str(st, "b", "")}: {if same { "True" } else { "False" }}");
    } else if op == "print" {
        println(opt_str(st, "text", ""));
    } else if op == "clock" {
        w.clock = opt_int(st, "us", 0);
    } else if op == "try" {
        let e = decode_exc(j_member(st, "exc").unwrap_or(J.Null));
        w.handling = vec![e];
        run_steps(mut w, body_of(st));
        w.handling = Vec.new();
    } else if op == "capture" {
        let li = w.cfg_procs;
        let old = w.lists[li].clone();
        w.caps.push(Vec.new());
        let ci = w.caps.len() - 1;
        w.lists[li] = vec![Proc.Capture(ci)];
        run_steps(mut w, body_of(st));
        w.lists[li] = old;
        println(f"captured: {repr(V.List(w.caps[ci].clone()))}");
    } else if op == "calls" {
        let name = opt_str(st, "name", "");
        let c = named(w.capturing_names, name);
        println(f"{name}: {w.wrapped[c].calls.len()} call(s)");
        for call in w.wrapped[c].calls.iter() {
            println(f"  CapturedCall(method_name={str_repr(call.name)}, args={tuple_repr(call.args)}, kwargs={dict_repr(call.kw)})");
        }
        w.wrapped[c].calls.clear();
    } else if op == "entries" {
        let name = opt_str(st, "name", "");
        let c = named(w.cap_names, name);
        println(f"{name}: {repr(V.List(w.caps[c].clone()))}");
    } else if op == "ctx_bind" {
        ctx_bind(mut w, kw_of(st));
    } else if op == "ctx_unbind" {
        ctx_unbind(mut w, opt_strs(st, "keys"));
    } else if op == "ctx_clear" {
        ctx_clear(mut w);
    } else if op == "ctx_get" {
        println(f"contextvars: {pairs_repr(sorted_items(ctx_items(w)))}");
    } else if op == "ctx_bound" {
        let kw = kw_of(st);
        let current = ctx_items(w);
        let mut saved: Vec[Item] = Vec.new();
        for it in kw.iter() {
            if let Some(v) = d_get(current, key_text(it).as_str()) {
                saved.push(Item { k: it.k.clone(), v: v });
            }
        }
        ctx_bind(mut w, kw);
        run_steps(mut w, body_of(st));
        let mut keys: Vec[String] = Vec.new();
        for it in kw.iter() {
            keys.push(key_text(it));
        }
        ctx_unbind(mut w, keys);
        ctx_bind(mut w, saved);
    } else if op == "merged" {
        let (proxy, idx) = var(w, st, "log")?;
        let mut d = ctx_items(w);
        for it in get_context(w, proxy, idx).iter() {
            item_put(mut d, it.k.clone(), it.v.clone());
        }
        println(f"merged {opt_str(st, "log", "")}: {pairs_repr(sorted_items(d))}");
    } else if op == "styles" {
        let name = opt_str(st, "name", "");
        let d = match j_member(st, "map") {
            Some(m) => kwargs(m),
            None => default_level_styles(opt_bool(st, "colors", true)),
        };
        let i = new_styles(mut w, d);
        w.style_names.push(Named { name: name, idx: i });
    } else if op == "show" {
        let name = opt_str(st, "name", "");
        let i = named(w.style_names, name);
        println(f"{name}: {dict_repr(w.styles[i])}");
    } else {
        return Err(unported("that step"));
    }
    Ok(())
}

// sorted(d.items()) as a list of tuples.
fn pairs_repr(items: ref Vec[Item]) -> String {
    let mut out: Vec[V] = Vec.new();
    for it in items.iter() {
        out.push(V.Tuple(vec![it.k.clone(), it.v.clone()]));
    }
    repr(V.List(out))
}

fn run_job(w: mut ref World, spec: ref J) {
    reset(mut w);
    w.vars = Vec.new();
    w.cap_names = Vec.new();
    w.capturing_names = Vec.new();
    w.style_names = Vec.new();
    println(f"== {opt_str(spec, "name", "")} ==");
    run_steps(mut w, j_items(j_member(spec, "steps").unwrap_or(J.Null)));
}

// ------------------------------------------------------------ files

fn read_text(path: Str) -> Result[String, Exc] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(Exc { kind: "OSError".to_string(), msg: f"{path}: {e}" }),
    }
}

// str.splitlines() for text with \n line ends.
fn split_lines(text: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for l in text.split("\n") {
        out.push(l.to_string());
    }
    if out.len() > 0 and out[out.len() - 1].len() == 0 {
        let _ = out.pop();
    }
    out
}

fn field(row: ref Vec[Item], k: Str) -> String {
    py_str(d_get(row, k).unwrap_or(V.Nothing))
}

// s.split(sep, 1) for a sep that is there.
fn split_once(s: ref String, sep: char) -> (String, String) {
    let mut a = String.new();
    let mut b = String.new();
    let mut seen = false;
    for c in s.chars() {
        if not seen and c == sep {
            seen = true;
        } else if seen {
            b.push(c);
        } else {
            a.push(c);
        }
    }
    (a, b)
}

fn kw1(k: Str, v: own V) -> Item {
    Item { k: sv(k), v: v }
}

fn call(w: mut ref World, bi: i64, m: Str, event: Str, kw: own Vec[Item]) -> Result[(), Exc] {
    let _ = bound_call(mut w, bi, m.to_string(), vec![sv(event)], kw)?;
    Ok(())
}

struct Count {
    key: String,
    n: i64,
}

fn count(counts: mut ref Vec[Count], key: ref String) {
    for c in counts.iter_mut() {
        if c.key == *key {
            c.n += 1;
            return;
        }
    }
    counts.push(Count { key: key.clone(), n: 1 });
}

fn by_key(counts: ref Vec[Count]) -> Vec[Count] {
    let mut out: Vec[Count] = Vec.new();
    for c in counts.iter() {
        let mut j = out.len();
        while j > 0 and out[j - 1].key > c.key {
            j -= 1;
        }
        out.insert(j, Count { key: c.key.clone(), n: c.n });
    }
    out
}

fn counts_text(counts: ref Vec[Count]) -> String {
    let mut out = String.new();
    for i in 0..counts.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{counts[i].key}={counts[i].n}");
    }
    out
}

fn rec_str(r: ref J, key: Str) -> String {
    j_str(j_member(r, key).unwrap_or(J.Null))
}

fn rec_int(r: ref J, key: Str) -> i64 {
    j_int(j_member(r, key).unwrap_or(J.Null))
}

// ------------------------------------------------------------ an API's access log

fn upstream_error(msg: own String) -> ExcV {
    ExcV { kind: "UpstreamError".to_string(), module: "orders.upstream".to_string(), args: vec![V.Str(msg)],
           cause: Vec.new(), context: Vec.new(), suppress: false, notes: Vec.new() }
}

fn api(w: mut ref World) -> Result[(), Exc] {
    println("== program: an API's access log ==");
    reset(mut w);
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(Exc { kind: "OSError".to_string(), msg: f"data/out: {e}" });
    }
    let f = open_file(mut w, "data/out/api.jsonl");
    let mut procs: Vec[Proc] = Vec.new();
    procs.push(Proc.MergeCtx);
    procs.push(Proc.AddLevel);
    procs.push(Proc.Stamp(StampOpts { fmt: "iso".to_string(), has_fmt: true, utc: true, key: "timestamp".to_string() }));
    procs.push(Proc.Redact(vec!["authorization".to_string()]));
    procs.push(Proc.FormatExc);
    procs.push(Proc.Rename(RenameOpts { to: "message".to_string(), replace_by: String.new(), has_replace: false }));
    procs.push(Proc.Json(JsonOpts { sort_keys: true, indent: -1, ensure_ascii: true, item_sep: ", ".to_string(), key_sep: ": ".to_string() }));
    w.cfg_procs = new_list(mut w, procs);
    w.cfg_wrapper = 20;
    w.cfg_factory_kind = WRITE;
    w.cfg_factory = new_wrapped(mut w, WRITE, f);
    w.cfg_cache = true;
    let log = new_proxy(mut w, -1, -1, NO_WRAPPER, -1, vec![kw1("service", sv("orders-api")), kw1("version", sv("2.4.1"))]);
    let text = read_text("data/requests.csv")?;
    let lines = split_lines(text);
    let mut header: Vec[String] = Vec.new();
    for h in lines[0].split(",") {
        header.push(h.to_string());
    }
    for li in 1..lines.len() {
        let mut row: Vec[Item] = Vec.new();
        let mut col = 0;
        for x in lines[li].split(",") {
            row.push(kw1(header[col].as_str(), sv(x)));
            col += 1;
        }
        w.clock = i64.parse(field(row, "ts_us")).unwrap_or(0);
        ctx_clear(mut w);
        ctx_bind(mut w, vec![kw1("request_id", V.Str(field(row, "request_id"))), kw1("client_ip", V.Str(field(row, "ip")))]);
        let mut rlog = proxy_bind(mut w, log, vec![kw1("method", V.Str(field(row, "method"))), kw1("path", V.Str(field(row, "path")))]);
        let user = field(row, "user");
        if user.len() > 0 {
            rlog = bound_bind(mut w, rlog, vec![kw1("user", V.Str(user))]);
        }
        let auth = field(row, "authorization");
        if auth.len() > 0 {
            rlog = bound_bind(mut w, rlog, vec![kw1("authorization", V.Str(auth))]);
        }
        call(mut w, rlog, "debug", "request.received", Vec.new())?;
        let status = i64.parse(field(row, "status")).unwrap_or(0);
        let ms = i64.parse(field(row, "ms")).unwrap_or(0);
        let mut kw: Vec[Item] = vec![kw1("status", V.Int(status)), kw1("duration_ms", V.Int(ms)),
                                     kw1("bytes", V.Int(i64.parse(field(row, "bytes")).unwrap_or(0)))];
        if status >= 500 {
            kw.insert(0, kw1("exc_info", V.Err(upstream_error(f"upstream returned {status}"))));
            call(mut w, rlog, "error", "request.failed", kw)?;
        } else if status == 429 {
            let mut retry = 1;
            for _ in 0..(ms % 4) {
                retry = retry * 2;
            }
            kw.insert(0, kw1("retry_after", V.Int(retry)));
            call(mut w, rlog, "warning", "request.throttled", kw)?;
        } else if status >= 400 {
            call(mut w, rlog, "warning", "request.rejected", kw)?;
        } else {
            call(mut w, rlog, "info", "request.completed", kw)?;
        }
        if ms >= 1000 {
            call(mut w, rlog, "warning", "request.slow", vec![kw1("threshold_ms", V.Int(1000)), kw1("duration_ms", V.Int(ms))])?;
        }
    }
    close_file(w, f)?;
    ctx_clear(mut w);
    let written = split_lines(read_text("data/out/api.jsonl")?);
    println(f"wrote {written.len()} lines to data/out/api.jsonl, the first four:");
    for i in 0..4 {
        if i < written.len() {
            println(f"  {written[i]}");
        }
    }
    let mut recs: Vec[J] = Vec.new();
    for l in written.iter() {
        recs.push(loads_str(l)?);
    }
    let mut levels: Vec[Count] = Vec.new();
    let mut events: Vec[Count] = Vec.new();
    for r in recs.iter() {
        count(mut levels, rec_str(r, "level"));
        count(mut events, rec_str(r, "message"));
    }
    println(f"by level: {counts_text(by_key(levels))}");
    println(f"by message: {counts_text(by_key(events))}");
    let mut classes: Vec[Count] = Vec.new();
    let mut durations: Vec[i64] = Vec.new();
    let mut sent = 0;
    let mut users: Vec[Count] = Vec.new();
    let mut redacted = 0;
    for r in recs.iter() {
        if j_member(r, "status").is_some() {
            let status = rec_int(r, "status");
            count(mut classes, f"{status / 100}xx");
            durations.push(rec_int(r, "duration_ms"));
            if status < 400 {
                sent += rec_int(r, "bytes");
            }
            let u = if j_member(r, "user").is_some() { rec_str(r, "user") } else { "-".to_string() };
            count(mut users, u);
        }
        if rec_str(r, "authorization") == "[redacted]" {
            redacted += 1;
        }
    }
    println(f"by status: {counts_text(by_key(classes))}");
    durations.sort();
    let n = durations.len();
    for p in [50, 90, 99].iter() {
        let k = (*p * n + 99) / 100;
        println(f"p{*p}: {durations[k - 1]} ms");
    }
    println(f"bytes sent: {sent}");
    println(f"authorization redacted in {redacted} lines");
    let mut ranked: Vec[Count] = Vec.new();
    for c in users.iter() {
        let mut j = ranked.len();
        while j > 0 and (ranked[j - 1].n < c.n or (ranked[j - 1].n == c.n and ranked[j - 1].key > c.key)) {
            j -= 1;
        }
        ranked.insert(j, Count { key: c.key.clone(), n: c.n });
    }
    println(f"requests by user: {counts_text(ranked)}");
    let mut slow: Vec[J] = Vec.new();
    for r in recs.iter() {
        if rec_str(r, "message") != "request.slow" {
            continue;
        }
        let d = rec_int(r, "duration_ms");
        let id = rec_str(r, "request_id");
        let mut j = slow.len();
        while j > 0 {
            let pd = rec_int(slow[j - 1], "duration_ms");
            if pd < d or (pd == d and rec_str(slow[j - 1], "request_id") > id) {
                j -= 1;
            } else {
                break;
            }
        }
        slow.insert(j, r.clone());
    }
    for i in 0..3 {
        if i < slow.len() {
            let r = slow[i].clone();
            println(f"slow: {rec_str(r, "request_id")} {rec_str(r, "method")} {rec_str(r, "path")} {rec_int(r, "duration_ms")} ms at {rec_str(r, "timestamp")}");
        }
    }
    for r in recs.iter() {
        if rec_str(r, "message") == "request.failed" {
            println(f"failed: {rec_str(r, "request_id")} {rec_str(r, "path")} -> {rec_str(r, "exception")}");
        }
    }
    Ok(())
}

// ------------------------------------------------------------ a task worker

fn builtin_exc(kind: ref String, msg: own String) -> ExcV {
    ExcV { kind: kind.clone(), module: "builtins".to_string(), args: vec![V.Str(msg)],
           cause: Vec.new(), context: Vec.new(), suppress: false, notes: Vec.new() }
}

fn worker(w: mut ref World) -> Result[(), Exc] {
    println("== program: a task worker ==");
    reset(mut w);
    w.clock = 1714579200000000;
    let f = open_file(mut w, "data/out/worker.log");
    w.samplers.push(Sampler { event: "heartbeat".to_string(), every: 4, seen: 0, dropped: 0 });
    let si = w.samplers.len() - 1;
    let mut fprocs: Vec[Proc] = Vec.new();
    fprocs.push(Proc.AddLevel);
    fprocs.push(Proc.Stamp(StampOpts { fmt: "%Y-%m-%dT%H:%M:%S.%fZ".to_string(), has_fmt: true, utc: true, key: "ts".to_string() }));
    fprocs.push(Proc.Sample(si));
    fprocs.push(Proc.Redact(vec!["secret".to_string()]));
    fprocs.push(Proc.FormatExc);
    fprocs.push(Proc.Logfmt(LfOpts { sort_keys: false, key_order: strs(vec!["ts", "level", "event", "task"]),
                                     drop_missing: true, bool_as_flag: true }));
    let flist = new_list(mut w, fprocs);
    let fw = new_wrapped(mut w, PRINT, f);
    let flog = new_proxy(mut w, fw, flist, 10, -1, vec![kw1("worker", sv("w-1"))]);
    let mut cs = console_spec();
    cs.colors = false;
    cs.pad_event = 20;
    let console_cfg = make_console(mut w, cs)?;
    let mut cprocs: Vec[Proc] = Vec.new();
    cprocs.push(Proc.AddLevel);
    cprocs.push(Proc.Stamp(StampOpts { fmt: "%H:%M:%S".to_string(), has_fmt: true, utc: false, key: "timestamp".to_string() }));
    cprocs.push(Proc.Console(console_cfg));
    let clist = new_list(mut w, cprocs);
    let cw = new_wrapped(mut w, PRINT, -1);
    let console = new_proxy(mut w, cw, clist, 30, -1, Vec.new());
    let mut done = 0;
    let mut failed = 0;
    let mut retries = 0;
    for line in split_lines(read_text("data/tasks.jsonl")?).iter() {
        let task = loads_str(line)?;
        let id = rec_str(task, "id");
        let kind = rec_str(task, "kind");
        let tlog = proxy_bind(mut w, flog, vec![kw1("task", V.Str(id.clone())), kw1("kind", V.Str(kind.clone()))]);
        call(mut w, tlog, "debug", "task.received", kwargs(j_member(task, "payload").unwrap_or(J.Null)))?;
        let outcomes = j_items(j_member(task, "outcomes").unwrap_or(J.Null));
        let beats = rec_int(task, "heartbeats");
        let cost = rec_int(task, "cost_us");
        for ai in 0..outcomes.len() {
            let a = ai + 1;
            for hb in 0..beats {
                call(mut w, tlog, "debug", "heartbeat", vec![kw1("attempt", V.Int(a)), kw1("beat", V.Int(hb + 1))])?;
                w.clock += 1000000;
            }
            w.clock += cost;
            let outcome = j_str(outcomes[ai]);
            if outcome == "ok" {
                call(mut w, tlog, "info", "task.done", vec![kw1("attempt", V.Int(a)), kw1("elapsed_ms", V.Float((cost as f64) / 1000.0)),
                                                         kw1("retried", V.Bool(a > 1))])?;
                done += 1;
                break;
            }
            let (typ, msg) = split_once(outcome, ':');
            if a < outcomes.len() {
                call(mut w, tlog, "warning", "task.retry", vec![kw1("attempt", V.Int(a)), kw1("error", V.Str(typ.clone())),
                                                             kw1("will_retry", V.Bool(true))])?;
                retries += 1;
            } else {
                call(mut w, tlog, "error", "task.failed", vec![kw1("attempt", V.Int(a)), kw1("exc_info", V.Err(builtin_exc(typ, msg))),
                                                            kw1("will_retry", V.Bool(false))])?;
                let cb = proxy_bind(mut w, console, Vec.new());
                call(mut w, cb, "error", "task failed", vec![kw1("task", V.Str(id.clone())), kw1("kind", V.Str(kind.clone())),
                                                         kw1("error", V.Str(typ.clone()))])?;
                failed += 1;
            }
        }
    }
    close_file(w, f)?;
    let lines = split_lines(read_text("data/out/worker.log")?);
    println(f"data/out/worker.log, {lines.len()} lines:");
    for l in lines.iter() {
        println(f"  {l}");
    }
    let s = w.samplers[si].seen;
    let d = w.samplers[si].dropped;
    println(f"tasks: {done} done, {failed} failed, {retries} retries; heartbeats: {s} seen, {d} dropped");
    Ok(())
}

fn run() -> Result[(), String] {
    let text = match read_text("data/jobs.jsonl") {
        Ok(t) => t,
        Err(e) => return Err(failure(e)),
    };
    let mut w = new_world();
    for line in split_lines(text).iter() {
        let spec = match loads_str(line) {
            Ok(v) => v,
            Err(e) => return Err(failure(e)),
        };
        run_job(mut w, spec);
    }
    if let Err(e) = api(mut w) {
        return Err(failure(e));
    }
    if let Err(e) = worker(mut w) {
        return Err(failure(e));
    }
    Ok(())
}

struct DataFile {
    path: String,
    body: String,
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    for file in data_files() {
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
