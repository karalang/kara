// mini_sortedcontainers: sortedcontainers 2.4.0, Grant Jenks's sorted
// list, dict and set, as the order books, leaderboards, schedulers and
// sliding-window statistics in Python services use them.
//
// The containers keep their values in sublists of `load` values or so,
// with the largest key of each sublist in `maxes` and, built when a
// position is first asked for, a tree of sublist lengths in `index`.
// This port splits, merges and indexes the way sortedcontainers does, so
// the sublists come out the same; `shape` prints them.
//
// Python's exceptions are Exc values: the class name and str(exc).

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn index_error() -> Exc {
    exc("IndexError", "list index out of range".to_string())
}

fn not_implemented(msg: Str) -> Exc {
    exc("NotImplementedError", msg.to_string())
}

// bisect.bisect_left and bisect.bisect_right.
fn bisect_left[T: Ord](v: ref Vec[T], x: ref T) -> i64 {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v[mid] < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn bisect_right[T: Ord](v: ref Vec[T], x: ref T) -> i64 {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if x < v[mid] {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// slice(start, stop, step).indices(n).
fn slice_indices(start: Option[i64], stop: Option[i64], step: Option[i64], n: i64) -> Result[(i64, i64, i64), Exc] {
    let st = match step {
        Some(s) => s,
        None => 1,
    };
    if st == 0 {
        return Err(exc("ValueError", "slice step cannot be zero".to_string()));
    }
    let lower = if st < 0 { -1 } else { 0 };
    let upper = if st < 0 { n - 1 } else { n };
    let a = match start {
        None => if st < 0 { upper } else { lower },
        Some(s) => clamp_index(s, n, lower, upper),
    };
    let b = match stop {
        None => if st < 0 { lower } else { upper },
        Some(s) => clamp_index(s, n, lower, upper),
    };
    Ok((a, b, st))
}

fn clamp_index(i0: i64, n: i64, lower: i64, upper: i64) -> i64 {
    let mut i = i0;
    if i < 0 {
        i += n;
        if i < lower {
            i = lower;
        }
    } else if i > upper {
        i = upper;
    }
    i
}

// The values of range(start, stop, step).
fn range_values(start: i64, stop: i64, step: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    if step > 0 {
        while i < stop {
            out.push(i);
            i += step;
        }
    } else {
        while i > stop {
            out.push(i);
            i += step;
        }
    }
    out
}

// A stable sort by key, as sorted(values, key=key) does it.
fn sort_by_key_stable[V: Clone, K: Ord + Clone](values: own Vec[V], key: ref Fn(V) -> K) -> Vec[V] {
    let mut keyed: Vec[(K, i64)] = Vec.new();
    let mut i = 0;
    while i < values.len() {
        keyed.push((key(values[i]), i));
        i += 1;
    }
    keyed.sort();
    let mut out: Vec[V] = Vec.new();
    for p in keyed {
        out.push(values[p.1].clone());
    }
    out
}

// --------------------------------------------------------- SortedList

// SortedKeyList, and SortedList as the same thing with the identity key:
// with one key the two classes do the same splits and merges, and differ
// only in their repr, in what they print for shape, and in that
// SortedList.clear also resets the index's offset.
struct SortedKeyList[V, K] {
    key: Fn(V) -> K,
    show: Fn(V) -> String,
    kshow: Fn(K) -> String,
    key_name: String,
    keyed: bool,
    len: i64,
    load: i64,
    lists: Vec[Vec[V]],
    keys: Vec[Vec[K]],
    maxes: Vec[K],
    index: Vec[i64],
    offset: i64,
}

impl[V: Clone + PartialEq, K: Ord + Clone] SortedKeyList[V, K] {
    fn new(key: escaping Fn(V) -> K, show: escaping Fn(V) -> String, kshow: escaping Fn(K) -> String, key_name: Str, keyed: bool) -> SortedKeyList[V, K] {
        SortedKeyList {
            key: key,
            show: show,
            kshow: kshow,
            key_name: key_name.to_string(),
            keyed: keyed,
            len: 0,
            load: 1000,
            lists: Vec.new(),
            keys: Vec.new(),
            maxes: Vec.new(),
            index: Vec.new(),
            offset: 0,
        }
    }

    fn key_of(ref self, v: ref V) -> K {
        (self.key)(v)
    }

    fn repr_of(ref self, v: ref V) -> String {
        (self.show)(v)
    }

    fn not_in_list(ref self, v: ref V) -> Exc {
        exc("ValueError", f"{self.repr_of(v)} not in list")
    }

    fn is_not_in_list(ref self, v: ref V) -> Exc {
        exc("ValueError", f"{self.repr_of(v)} is not in list")
    }

    fn values(ref self) -> Vec[V] {
        let mut out: Vec[V] = Vec.new();
        for l in self.lists {
            for v in l {
                out.push(v.clone());
            }
        }
        out
    }

    fn reset(mut ref self, load: i64) {
        let values = self.values();
        self.clear();
        self.load = load;
        self.update(values);
    }

    fn clear(mut ref self) {
        self.len = 0;
        self.lists.clear();
        self.keys.clear();
        self.maxes.clear();
        self.index.clear();
        if not self.keyed {
            self.offset = 0;
        }
    }

    fn add(mut ref self, value: own V) {
        let key = self.key_of(value);
        if self.maxes.len() > 0 {
            let mut pos = bisect_right(self.maxes, key);
            if pos == self.maxes.len() {
                pos -= 1;
                self.lists[pos].push(value);
                self.keys[pos].push(key.clone());
                self.maxes[pos] = key;
            } else {
                let idx = bisect_right(self.keys[pos], key);
                self.lists[pos].insert(idx, value);
                self.keys[pos].insert(idx, key);
            }
            self.expand(pos);
        } else {
            let mut l: Vec[V] = Vec.new();
            l.push(value);
            self.lists.push(l);
            let mut k: Vec[K] = Vec.new();
            k.push(key.clone());
            self.keys.push(k);
            self.maxes.push(key);
        }
        self.len += 1;
    }

    fn expand(mut ref self, pos: i64) {
        let load = self.load;
        if self.keys[pos].len() > load * 2 {
            let half: Vec[V] = self.lists[pos][load..].to_vec();
            let half_keys: Vec[K] = self.keys[pos][load..].to_vec();
            self.lists[pos].truncate(load);
            self.keys[pos].truncate(load);
            let last = self.keys[pos][load - 1].clone();
            self.maxes[pos] = last;
            let top = half_keys[half_keys.len() - 1].clone();
            self.lists.insert(pos + 1, half);
            self.keys.insert(pos + 1, half_keys);
            self.maxes.insert(pos + 1, top);
            self.index.clear();
        } else if self.index.len() > 0 {
            let mut child = self.offset + pos;
            while child != 0 {
                self.index[child] += 1;
                child = (child - 1) >> 1;
            }
            self.index[0] += 1;
        }
    }

    fn update(mut ref self, items: own Vec[V]) {
        let mut values = sort_by_key_stable(items, self.key);
        if self.maxes.len() > 0 {
            if values.len() * 4 >= self.len {
                let mut all = self.values();
                for v in values.into_iter() {
                    all.push(v);
                }
                values = sort_by_key_stable(all, self.key);
                self.clear();
            } else {
                for v in values.into_iter() {
                    self.add(v);
                }
                return;
            }
        }
        let load = self.load;
        let mut pos = 0;
        while pos < values.len() {
            let end = if pos + load < values.len() { pos + load } else { values.len() };
            let chunk: Vec[V] = values[pos..end].to_vec();
            let mut ks: Vec[K] = Vec.new();
            for v in chunk {
                ks.push(self.key_of(v));
            }
            self.maxes.push(ks[ks.len() - 1].clone());
            self.lists.push(chunk);
            self.keys.push(ks);
            pos += load;
        }
        self.len = values.len();
        self.index.clear();
    }

    // The walk over equal keys that SortedKeyList's lookups share: the
    // place of the first value equal to `value`, if any.
    fn find(ref self, value: ref V) -> Option[(i64, i64)] {
        if self.maxes.len() == 0 {
            return None;
        }
        let key = self.key_of(value);
        let mut pos = bisect_left(self.maxes, key);
        if pos == self.maxes.len() {
            return None;
        }
        let mut idx = bisect_left(self.keys[pos], key);
        let len_keys = self.keys.len();
        let mut len_sublist = self.keys[pos].len();
        loop {
            if self.keys[pos][idx] != key {
                return None;
            }
            if self.lists[pos][idx] == value {
                return Some((pos, idx));
            }
            idx += 1;
            if idx == len_sublist {
                pos += 1;
                if pos == len_keys {
                    return None;
                }
                len_sublist = self.keys[pos].len();
                idx = 0;
            }
        }
    }

    fn contains(ref self, value: ref V) -> bool {
        self.find(value).is_some()
    }

    fn discard(mut ref self, value: ref V) {
        if let Some((pos, idx)) = self.find(value) {
            self.delete(pos, idx);
        }
    }

    fn remove(mut ref self, value: ref V) -> Result[(), Exc] {
        match self.find(value) {
            Some((pos, idx)) => {
                self.delete(pos, idx);
                Ok(())
            }
            None => Err(self.not_in_list(value)),
        }
    }

    fn delete(mut ref self, pos0: i64, idx: i64) {
        let mut pos = pos0;
        self.keys[pos].remove(idx);
        self.lists[pos].remove(idx);
        self.len -= 1;
        let len_keys_pos = self.keys[pos].len();
        if len_keys_pos > (self.load >> 1) {
            self.maxes[pos] = self.keys[pos][len_keys_pos - 1].clone();
            if self.index.len() > 0 {
                let mut child = self.offset + pos;
                while child > 0 {
                    self.index[child] -= 1;
                    child = (child - 1) >> 1;
                }
                self.index[0] -= 1;
            }
        } else if self.keys.len() > 1 {
            if pos == 0 {
                pos += 1;
            }
            let prev = pos - 1;
            let moved_keys = self.keys.remove(pos);
            let moved = self.lists.remove(pos);
            for k in moved_keys.into_iter() {
                self.keys[prev].push(k);
            }
            for v in moved.into_iter() {
                self.lists[prev].push(v);
            }
            let n = self.keys[prev].len();
            self.maxes[prev] = self.keys[prev][n - 1].clone();
            self.maxes.remove(pos);
            self.index.clear();
            self.expand(prev);
        } else if len_keys_pos > 0 {
            self.maxes[pos] = self.keys[pos][len_keys_pos - 1].clone();
        } else {
            self.lists.remove(pos);
            self.keys.remove(pos);
            self.maxes.remove(pos);
            self.index.clear();
        }
    }

    // _loc: the position in the whole list of lists[pos][idx].
    fn loc(mut ref self, pos0: i64, idx: i64) -> i64 {
        if pos0 == 0 {
            return idx;
        }
        if self.index.len() == 0 {
            self.build_index();
        }
        let mut total = 0;
        let mut pos = pos0 + self.offset;
        while pos != 0 {
            if (pos & 1) == 0 {
                total += self.index[pos - 1];
            }
            pos = (pos - 1) >> 1;
        }
        total + idx
    }

    // _pos: the sublist and place of position idx.
    fn pos_of(mut ref self, idx0: i64) -> Result[(i64, i64), Exc] {
        let mut idx = idx0;
        if idx < 0 {
            if self.lists.len() == 0 {
                return Err(index_error());
            }
            let last_len = self.lists[self.lists.len() - 1].len();
            if -idx <= last_len {
                return Ok((self.lists.len() - 1, last_len + idx));
            }
            idx += self.len;
            if idx < 0 {
                return Err(index_error());
            }
        } else if idx >= self.len {
            return Err(index_error());
        }
        if idx < self.lists[0].len() {
            return Ok((0, idx));
        }
        if self.index.len() == 0 {
            self.build_index();
        }
        let mut pos = 0;
        let mut child = 1;
        let len_index = self.index.len();
        while child < len_index {
            let index_child = self.index[child];
            if idx < index_child {
                pos = child;
            } else {
                idx -= index_child;
                pos = child + 1;
            }
            child = (pos << 1) + 1;
        }
        Ok((pos - self.offset, idx))
    }

    fn build_index(mut ref self) {
        let mut row0: Vec[i64] = Vec.new();
        for l in self.lists {
            row0.push(l.len());
        }
        if row0.len() == 1 {
            self.index = row0;
            self.offset = 0;
            return;
        }
        let mut row1: Vec[i64] = Vec.new();
        let mut i = 0;
        while i + 1 < row0.len() {
            row1.push(row0[i] + row0[i + 1]);
            i += 2;
        }
        if (row0.len() & 1) == 1 {
            row1.push(row0[row0.len() - 1]);
        }
        if row1.len() == 1 {
            let mut idx = row1;
            for x in row0 {
                idx.push(x);
            }
            self.index = idx;
            self.offset = 1;
            return;
        }
        // 2 ** (int(log(len(row1) - 1, 2)) + 1), with math.log's division.
        let lg = ((row1.len() - 1) as f64).ln() / (2.0).ln();
        let size = 1 << ((lg as i64) + 1);
        while row1.len() < size {
            row1.push(0);
        }
        let mut tree: Vec[Vec[i64]] = Vec.new();
        tree.push(row0);
        tree.push(row1);
        while tree[tree.len() - 1].len() > 1 {
            let last = tree[tree.len() - 1].clone();
            let mut row: Vec[i64] = Vec.new();
            let mut j = 0;
            while j + 1 < last.len() {
                row.push(last[j] + last[j + 1]);
                j += 2;
            }
            tree.push(row);
        }
        let mut idx: Vec[i64] = Vec.new();
        let mut t = tree.len();
        while t > 0 {
            t -= 1;
            for x in tree[t] {
                idx.push(x);
            }
        }
        self.index = idx;
        self.offset = size * 2 - 1;
    }

    fn get(mut ref self, index: i64) -> Result[V, Exc] {
        if self.len > 0 {
            if index == 0 {
                return Ok(self.lists[0][0].clone());
            } else if index == -1 {
                let last = self.lists.len() - 1;
                let n = self.lists[last].len();
                return Ok(self.lists[last][n - 1].clone());
            }
        } else {
            return Err(index_error());
        }
        if 0 <= index and index < self.lists[0].len() {
            return Ok(self.lists[0][index].clone());
        }
        let last = self.lists.len() - 1;
        let len_last = self.lists[last].len();
        if -len_last < index and index < 0 {
            return Ok(self.lists[last][len_last + index].clone());
        }
        let (pos, idx) = self.pos_of(index)?;
        Ok(self.lists[pos][idx].clone())
    }

    fn get_slice(mut ref self, start0: Option[i64], stop0: Option[i64], step0: Option[i64]) -> Result[Vec[V], Exc] {
        let (start, stop, step) = slice_indices(start0, stop0, step0, self.len)?;
        if step == 1 and start < stop {
            if start == 0 and stop == self.len {
                return Ok(self.values());
            }
            let (start_pos, start_idx) = self.pos_of(start)?;
            let stop_idx0 = start_idx + stop - start;
            if self.lists[start_pos].len() >= stop_idx0 {
                return Ok(self.lists[start_pos][start_idx..stop_idx0].to_vec());
            }
            let mut stop_pos = 0;
            let mut stop_idx = 0;
            if stop == self.len {
                stop_pos = self.lists.len() - 1;
                stop_idx = self.lists[stop_pos].len();
            } else {
                let (p, i) = self.pos_of(stop)?;
                stop_pos = p;
                stop_idx = i;
            }
            let n = self.lists[start_pos].len();
            let mut result: Vec[V] = self.lists[start_pos][start_idx..n].to_vec();
            let mut p = start_pos + 1;
            while p < stop_pos {
                for v in self.lists[p] {
                    result.push(v.clone());
                }
                p += 1;
            }
            for v in self.lists[stop_pos][0..stop_idx] {
                result.push(v.clone());
            }
            return Ok(result);
        }
        if step == -1 and start > stop {
            let mut result = self.get_slice(Some(stop + 1), Some(start + 1), None)?;
            result.reverse();
            return Ok(result);
        }
        let mut out: Vec[V] = Vec.new();
        for i in range_values(start, stop, step) {
            out.push(self.get(i)?);
        }
        Ok(out)
    }

    fn del_at(mut ref self, index: i64) -> Result[(), Exc] {
        let (pos, idx) = self.pos_of(index)?;
        self.delete(pos, idx);
        Ok(())
    }

    fn del_slice(mut ref self, start0: Option[i64], stop0: Option[i64], step0: Option[i64]) -> Result[(), Exc] {
        let (start, stop, step) = slice_indices(start0, stop0, step0, self.len)?;
        if step == 1 and start < stop {
            if start == 0 and stop == self.len {
                self.clear();
                return Ok(());
            } else if self.len <= 8 * (stop - start) {
                let mut values = self.get_slice(None, Some(start), None)?;
                if stop < self.len {
                    for v in self.get_slice(Some(stop), None, None)?.into_iter() {
                        values.push(v);
                    }
                }
                self.clear();
                self.update(values);
                return Ok(());
            }
        }
        let mut indices = range_values(start, stop, step);
        if step > 0 {
            indices.reverse();
        }
        for i in indices {
            let (pos, idx) = self.pos_of(i)?;
            self.delete(pos, idx);
        }
        Ok(())
    }

    fn reversed(ref self) -> Vec[V] {
        let mut out = self.values();
        out.reverse();
        out
    }

    // _islice: the values from lists[min_pos][min_idx] up to, not
    // including, lists[max_pos][max_idx].
    fn islice_pos(ref self, min_pos: i64, min_idx: i64, max_pos: i64, max_idx: i64, reverse: bool) -> Vec[V] {
        let mut out: Vec[V] = Vec.new();
        if min_pos > max_pos {
            return out;
        }
        if min_pos == max_pos {
            let mut i = min_idx;
            while i < max_idx {
                out.push(self.lists[min_pos][i].clone());
                i += 1;
            }
        } else {
            let mut i = min_idx;
            while i < self.lists[min_pos].len() {
                out.push(self.lists[min_pos][i].clone());
                i += 1;
            }
            let mut p = min_pos + 1;
            while p < max_pos {
                for v in self.lists[p] {
                    out.push(v.clone());
                }
                p += 1;
            }
            let mut j = 0;
            while j < max_idx {
                out.push(self.lists[max_pos][j].clone());
                j += 1;
            }
        }
        if reverse {
            out.reverse();
        }
        out
    }

    fn islice(mut ref self, start0: Option[i64], stop0: Option[i64], reverse: bool) -> Result[Vec[V], Exc] {
        let none: Vec[V] = Vec.new();
        if self.len == 0 {
            return Ok(none);
        }
        let (start, stop, _) = slice_indices(start0, stop0, None, self.len)?;
        if start >= stop {
            return Ok(none);
        }
        let (min_pos, min_idx) = self.pos_of(start)?;
        let mut max_pos = 0;
        let mut max_idx = 0;
        if stop == self.len {
            max_pos = self.lists.len() - 1;
            max_idx = self.lists[max_pos].len();
        } else {
            let (p, i) = self.pos_of(stop)?;
            max_pos = p;
            max_idx = i;
        }
        Ok(self.islice_pos(min_pos, min_idx, max_pos, max_idx, reverse))
    }

    fn irange_key(ref self, min_key: Option[K], max_key: Option[K], inclusive: (bool, bool), reverse: bool) -> Vec[V] {
        let none: Vec[V] = Vec.new();
        if self.maxes.len() == 0 {
            return none;
        }
        let mut min_pos = 0;
        let mut min_idx = 0;
        match min_key {
            None => {}
            Some(k) => {
                if inclusive.0 {
                    min_pos = bisect_left(self.maxes, k);
                    if min_pos == self.maxes.len() {
                        return none;
                    }
                    min_idx = bisect_left(self.keys[min_pos], k);
                } else {
                    min_pos = bisect_right(self.maxes, k);
                    if min_pos == self.maxes.len() {
                        return none;
                    }
                    min_idx = bisect_right(self.keys[min_pos], k);
                }
            }
        }
        let mut max_pos = self.maxes.len() - 1;
        let mut max_idx = self.keys[max_pos].len();
        match max_key {
            None => {}
            Some(k) => {
                if inclusive.1 {
                    max_pos = bisect_right(self.maxes, k);
                    if max_pos == self.maxes.len() {
                        max_pos -= 1;
                        max_idx = self.keys[max_pos].len();
                    } else {
                        max_idx = bisect_right(self.keys[max_pos], k);
                    }
                } else {
                    max_pos = bisect_left(self.maxes, k);
                    if max_pos == self.maxes.len() {
                        max_pos -= 1;
                        max_idx = self.keys[max_pos].len();
                    } else {
                        max_idx = bisect_left(self.keys[max_pos], k);
                    }
                }
            }
        }
        self.islice_pos(min_pos, min_idx, max_pos, max_idx, reverse)
    }

    fn irange(ref self, minimum: Option[V], maximum: Option[V], inclusive: (bool, bool), reverse: bool) -> Vec[V] {
        let min_key: Option[K] = match minimum {
            Some(v) => Some(self.key_of(v)),
            None => None,
        };
        let max_key: Option[K] = match maximum {
            Some(v) => Some(self.key_of(v)),
            None => None,
        };
        self.irange_key(min_key, max_key, inclusive, reverse)
    }

    fn bisect_key_left(mut ref self, key: ref K) -> i64 {
        if self.maxes.len() == 0 {
            return 0;
        }
        let pos = bisect_left(self.maxes, key);
        if pos == self.maxes.len() {
            return self.len;
        }
        let idx = bisect_left(self.keys[pos], key);
        self.loc(pos, idx)
    }

    fn bisect_key_right(mut ref self, key: ref K) -> i64 {
        if self.maxes.len() == 0 {
            return 0;
        }
        let pos = bisect_right(self.maxes, key);
        if pos == self.maxes.len() {
            return self.len;
        }
        let idx = bisect_right(self.keys[pos], key);
        self.loc(pos, idx)
    }

    fn bisect_left(mut ref self, value: ref V) -> i64 {
        let k = self.key_of(value);
        self.bisect_key_left(k)
    }

    fn bisect_right(mut ref self, value: ref V) -> i64 {
        let k = self.key_of(value);
        self.bisect_key_right(k)
    }

    fn count(mut ref self, value: ref V) -> i64 {
        if not self.keyed {
            return self.count_plain(value);
        }
        if self.maxes.len() == 0 {
            return 0;
        }
        let key = self.key_of(value);
        let mut pos = bisect_left(self.maxes, key);
        if pos == self.maxes.len() {
            return 0;
        }
        let mut idx = bisect_left(self.keys[pos], key);
        let mut total = 0;
        let len_keys = self.keys.len();
        let mut len_sublist = self.keys[pos].len();
        loop {
            if self.keys[pos][idx] != key {
                return total;
            }
            if self.lists[pos][idx] == value {
                total += 1;
            }
            idx += 1;
            if idx == len_sublist {
                pos += 1;
                if pos == len_keys {
                    return total;
                }
                len_sublist = self.keys[pos].len();
                idx = 0;
            }
        }
    }

    // SortedList.count, which finds both ends by position.
    fn count_plain(mut ref self, value: ref V) -> i64 {
        if self.maxes.len() == 0 {
            return 0;
        }
        let key = self.key_of(value);
        let pos_left = bisect_left(self.maxes, key);
        if pos_left == self.maxes.len() {
            return 0;
        }
        let idx_left = bisect_left(self.keys[pos_left], key);
        let pos_right = bisect_right(self.maxes, key);
        if pos_right == self.maxes.len() {
            return self.len - self.loc(pos_left, idx_left);
        }
        let idx_right = bisect_right(self.keys[pos_right], key);
        if pos_left == pos_right {
            return idx_right - idx_left;
        }
        let right = self.loc(pos_right, idx_right);
        let left = self.loc(pos_left, idx_left);
        right - left
    }

    fn index_of(mut ref self, value: ref V, start0: Option[i64], stop0: Option[i64]) -> Result[i64, Exc] {
        let n = self.len;
        if n == 0 {
            return Err(self.is_not_in_list(value));
        }
        let mut start = match start0 {
            Some(s) => s,
            None => 0,
        };
        if start < 0 {
            start += n;
        }
        if start < 0 {
            start = 0;
        }
        let mut stop = match stop0 {
            Some(s) => s,
            None => n,
        };
        if stop < 0 {
            stop += n;
        }
        if stop > n {
            stop = n;
        }
        if stop <= start {
            return Err(self.is_not_in_list(value));
        }
        if not self.keyed {
            return self.index_plain(value, start, stop);
        }
        let key = self.key_of(value);
        let mut pos = bisect_left(self.maxes, key);
        if pos == self.maxes.len() {
            return Err(self.is_not_in_list(value));
        }
        stop -= 1;
        let mut idx = bisect_left(self.keys[pos], key);
        let len_keys = self.keys.len();
        let mut len_sublist = self.keys[pos].len();
        loop {
            if self.keys[pos][idx] != key {
                return Err(self.is_not_in_list(value));
            }
            if self.lists[pos][idx] == value {
                let l = self.loc(pos, idx);
                if start <= l and l <= stop {
                    return Ok(l);
                } else if l > stop {
                    return Err(self.is_not_in_list(value));
                }
            }
            idx += 1;
            if idx == len_sublist {
                pos += 1;
                if pos == len_keys {
                    return Err(self.is_not_in_list(value));
                }
                len_sublist = self.keys[pos].len();
                idx = 0;
            }
        }
    }

    // The rest of SortedList.index, which finds the first and last
    // equal value by position rather than walking them.
    fn index_plain(mut ref self, value: ref V, start: i64, stop0: i64) -> Result[i64, Exc] {
        let key = self.key_of(value);
        let pos_left = bisect_left(self.maxes, key);
        if pos_left == self.maxes.len() {
            return Err(self.is_not_in_list(value));
        }
        let idx_left = bisect_left(self.keys[pos_left], key);
        if self.lists[pos_left][idx_left] != value {
            return Err(self.is_not_in_list(value));
        }
        let stop = stop0 - 1;
        let left = self.loc(pos_left, idx_left);
        if start <= left {
            if left <= stop {
                return Ok(left);
            }
        } else {
            let right = self.bisect_right(value) - 1;
            if start <= right {
                return Ok(start);
            }
        }
        Err(self.is_not_in_list(value))
    }

    fn pop(mut ref self, index: i64) -> Result[V, Exc] {
        if self.len == 0 {
            return Err(exc("IndexError", "pop index out of range".to_string()));
        }
        if index == 0 {
            let val = self.lists[0][0].clone();
            self.delete(0, 0);
            return Ok(val);
        }
        let last = self.lists.len() - 1;
        if index == -1 {
            let loc = self.lists[last].len() - 1;
            let val = self.lists[last][loc].clone();
            self.delete(last, loc);
            return Ok(val);
        }
        if 0 <= index and index < self.lists[0].len() {
            let val = self.lists[0][index].clone();
            self.delete(0, index);
            return Ok(val);
        }
        let len_last = self.lists[last].len();
        if -len_last < index and index < 0 {
            let loc = len_last + index;
            let val = self.lists[last][loc].clone();
            self.delete(last, loc);
            return Ok(val);
        }
        let (pos, idx) = self.pos_of(index)?;
        let val = self.lists[pos][idx].clone();
        self.delete(pos, idx);
        Ok(val)
    }

    fn repr(ref self) -> String {
        let body = list_repr(self.values(), self.show);
        if self.keyed {
            f"SortedKeyList({body}, key=<function {self.key_name}>)"
        } else {
            f"SortedList({body})"
        }
    }

    // _check, as a yes or no.
    fn check(ref self) -> bool {
        if self.load < 4 or self.maxes.len() != self.lists.len() or self.keys.len() != self.lists.len() {
            return false;
        }
        let mut total = 0;
        for l in self.lists {
            total += l.len();
        }
        if total != self.len {
            return false;
        }
        let mut p = 0;
        while p < self.keys.len() {
            let ks = self.keys[p].clone();
            if ks.len() != self.lists[p].len() {
                return false;
            }
            let mut i = 1;
            while i < ks.len() {
                if ks[i] < ks[i - 1] {
                    return false;
                }
                i += 1;
            }
            if p > 0 and ks[0] < self.keys[p - 1][self.keys[p - 1].len() - 1] {
                return false;
            }
            if self.maxes[p] != ks[ks.len() - 1] {
                return false;
            }
            let mut j = 0;
            while j < ks.len() {
                if self.key_of(self.lists[p][j]) != ks[j] {
                    return false;
                }
                j += 1;
            }
            if ks.len() > self.load * 2 {
                return false;
            }
            if p + 1 < self.lists.len() and ks.len() < (self.load >> 1) {
                return false;
            }
            p += 1;
        }
        if self.index.len() > 0 {
            if self.index[0] != self.len or self.index.len() != self.offset + self.lists.len() {
                return false;
            }
            let mut q = 0;
            while q < self.lists.len() {
                if self.index[self.offset + q] != self.lists[q].len() {
                    return false;
                }
                q += 1;
            }
            let mut r = 0;
            while r < self.offset {
                let child = (r << 1) + 1;
                if child >= self.index.len() {
                    if self.index[r] != 0 {
                        return false;
                    }
                } else if child + 1 == self.index.len() {
                    if self.index[r] != self.index[child] {
                        return false;
                    }
                } else if self.index[child] + self.index[child + 1] != self.index[r] {
                    return false;
                }
                r += 1;
            }
        }
        true
    }

    fn shape(ref self) -> String {
        let lists = nested_repr(self.lists, self.show);
        let index = list_repr(self.index, int_repr);
        if self.keyed {
            f"lists: {lists} keys: {self.keys_repr()} index: {index} offset: {self.offset}"
        } else {
            f"lists: {lists} index: {index} offset: {self.offset}"
        }
    }

    fn keys_repr(ref self) -> String {
        nested_repr(self.keys, self.kshow)
    }
}

// ------------------------------------------------------------ printing

fn int_repr(x: ref i64) -> String {
    f"{x}"
}

fn str_repr(s: ref String) -> String {
    let mut out = String.new();
    let q = if s.contains("'") and not s.contains("\"") { "\"" } else { "'" };
    out.push_str(q);
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\'' and q == "'" {
            out.push_str("\\'");
        } else {
            out.push(c);
        }
    }
    out.push_str(q);
    out
}

fn bool_repr(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn list_repr[T](v: ref Vec[T], show: ref Fn(T) -> String) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in v {
        parts.push(show(x));
    }
    f"[{parts.join(", ")}]"
}

fn nested_repr[T](v: ref Vec[Vec[T]], show: ref Fn(T) -> String) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in v {
        parts.push(list_repr(x, show));
    }
    f"[{parts.join(", ")}]"
}

// ------------------------------------------------------------- traces

fn ident(x: ref i64) -> i64 {
    *x
}

fn mod10(x: ref i64) -> i64 {
    x.rem_euclid(10)
}

fn neg(x: ref i64) -> i64 {
    -*x
}

fn none_repr() -> String {
    "None".to_string()
}

fn num(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn arg(s: ref String) -> Option[i64] {
    if s == "_" { None } else { Some(num(s)) }
}

fn ints(a: ref Vec[String]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for s in a {
        out.push(num(s));
    }
    out
}

fn words(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in s.split(" ") {
        if w.len() > 0 {
            out.push(w.to_string());
        }
    }
    out
}

fn lines_of(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for l in s.split("\n") {
        out.push(l.to_string());
    }
    if out.len() > 0 and out[out.len() - 1].len() == 0 {
        out.pop();
    }
    out
}

fn ints_repr(v: ref Vec[i64]) -> String {
    list_repr(v, int_repr)
}

// A new list with the same key and the default load: what
// self.__class__(values, key=...) makes.
fn fresh_like(sl: ref SortedKeyList[i64, i64], values: own Vec[i64]) -> SortedKeyList[i64, i64] {
    let mut out = if not sl.keyed {
        SortedKeyList.new(ident, int_repr, int_repr, "identity", false)
    } else if sl.key_name == "mod10" {
        SortedKeyList.new(mod10, int_repr, int_repr, "mod10", true)
    } else {
        SortedKeyList.new(neg, int_repr, int_repr, "neg", true)
    };
    out.update(values);
    out
}

fn new_list(head: ref Vec[String]) -> SortedKeyList[i64, i64] {
    if head[0] == "list" {
        let mut sl = SortedKeyList.new(ident, int_repr, int_repr, "identity", false);
        sl.reset(num(head[1]));
        sl
    } else {
        let name = head[1].clone();
        let mut sl = if name == "mod10" {
            SortedKeyList.new(mod10, int_repr, int_repr, "mod10", true)
        } else {
            SortedKeyList.new(neg, int_repr, int_repr, "neg", true)
        };
        sl.reset(num(head[2]));
        sl
    }
}

// The comparisons of a sorted list with a list, as Sequence does them.
fn cmp_seq(a: ref Vec[i64], b: ref Vec[i64], op: ref String) -> bool {
    if a.len() != b.len() {
        if op == "==" {
            return false;
        }
        if op == "!=" {
            return true;
        }
    }
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return cmp_op(a[i], b[i], op);
        }
        i += 1;
    }
    cmp_op(a.len(), b.len(), op)
}

fn cmp_op(x: i64, y: i64, op: ref String) -> bool {
    if op == "==" {
        x == y
    } else if op == "!=" {
        x != y
    } else if op == "<" {
        x < y
    } else if op == "<=" {
        x <= y
    } else if op == ">" {
        x > y
    } else {
        x >= y
    }
}

fn flag(s: ref String) -> bool {
    s == "1"
}

fn list_cmd(sl: mut ref SortedKeyList[i64, i64], c: ref String, a: ref Vec[String]) -> Result[String, Exc] {
    if c == "add" {
        sl.add(num(a[0]));
        return Ok(none_repr());
    }
    if c == "update" {
        sl.update(ints(a));
        return Ok(none_repr());
    }
    if c == "discard" {
        sl.discard(num(a[0]));
        return Ok(none_repr());
    }
    if c == "remove" {
        sl.remove(num(a[0]))?;
        return Ok(none_repr());
    }
    if c == "pop" {
        let i = if a.len() > 0 { num(a[0]) } else { -1 };
        let v = sl.pop(i)?;
        return Ok(f"{v}");
    }
    if c == "get" {
        let v = sl.get(num(a[0]))?;
        return Ok(f"{v}");
    }
    if c == "slice" {
        let v = sl.get_slice(arg(a[0]), arg(a[1]), arg(a[2]))?;
        return Ok(ints_repr(v));
    }
    if c == "del" {
        sl.del_at(num(a[0]))?;
        return Ok(none_repr());
    }
    if c == "delslice" {
        sl.del_slice(arg(a[0]), arg(a[1]), arg(a[2]))?;
        return Ok(none_repr());
    }
    if c == "contains" {
        return Ok(bool_repr(sl.contains(num(a[0]))));
    }
    if c == "count" {
        return Ok(f"{sl.count(num(a[0]))}");
    }
    if c == "index" {
        let start = if a.len() > 1 { Some(num(a[1])) } else { None };
        let stop = if a.len() > 2 { Some(num(a[2])) } else { None };
        let i = sl.index_of(num(a[0]), start, stop)?;
        return Ok(f"{i}");
    }
    if c == "bl" {
        return Ok(f"{sl.bisect_left(num(a[0]))}");
    }
    if c == "br" {
        return Ok(f"{sl.bisect_right(num(a[0]))}");
    }
    if c == "bkl" {
        return Ok(f"{sl.bisect_key_left(num(a[0]))}");
    }
    if c == "bkr" {
        return Ok(f"{sl.bisect_key_right(num(a[0]))}");
    }
    if c == "irange" or c == "irangekey" {
        let inc = (flag(a[2]), flag(a[3]));
        let v = if c == "irange" {
            sl.irange(arg(a[0]), arg(a[1]), inc, flag(a[4]))
        } else {
            sl.irange_key(arg(a[0]), arg(a[1]), inc, flag(a[4]))
        };
        return Ok(ints_repr(v));
    }
    if c == "islice" {
        let v = sl.islice(arg(a[0]), arg(a[1]), flag(a[2]))?;
        return Ok(ints_repr(v));
    }
    if c == "rev" {
        return Ok(ints_repr(sl.reversed()));
    }
    if c == "plus" {
        let mut values = sl.values();
        for x in ints(a) {
            values.push(x);
        }
        return Ok(fresh_like(sl, values).repr());
    }
    if c == "times" {
        let mut values: Vec[i64] = Vec.new();
        let mut k = 0;
        while k < num(a[0]) {
            for x in sl.values() {
                values.push(x);
            }
            k += 1;
        }
        return Ok(fresh_like(sl, values).repr());
    }
    if c == "cmp" {
        let other = ints(a[1..].to_vec());
        return Ok(bool_repr(cmp_seq(sl.values(), other, a[0])));
    }
    if c == "setitem" {
        return Err(not_implemented("use ``del sl[index]`` and ``sl.add(value)`` instead"));
    }
    if c == "append" or c == "insert" {
        return Err(not_implemented("use ``sl.add(value)`` instead"));
    }
    if c == "extend" {
        return Err(not_implemented("use ``sl.update(values)`` instead"));
    }
    if c == "reverse" {
        return Err(not_implemented("use ``reversed(sl)`` instead"));
    }
    if c == "reset" {
        sl.reset(num(a[0]));
        return Ok(none_repr());
    }
    if c == "clear" {
        sl.clear();
        return Ok(none_repr());
    }
    Ok(f"{sl.len}")
}

fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push_str("\n");
}

fn emit_result(out: mut ref String, line: ref String, r: ref Result[String, Exc]) {
    match r {
        Ok(s) => emit(mut out, f"{line}: {s}"),
        Err(e) => emit(mut out, f"{line}: error: {e.kind}: {e.msg}"),
    }
}

fn list_trace(lines: ref Vec[String], out: mut ref String) {
    let head = words(lines[0]);
    let mut sl = new_list(head);
    let mut i = 1;
    while i < lines.len() {
        let line = lines[i].clone();
        i += 1;
        let f = words(line);
        let c = f[0].clone();
        let a = f[1..].to_vec();
        if c == "shape" {
            emit(mut out, f"{line}: {sl.shape()}");
        } else if c == "check" {
            emit(mut out, if sl.check() { "check: ok" } else { "check: FAILED" });
        } else if c == "repr" {
            emit(mut out, f"repr: {sl.repr()}");
        } else {
            let r = list_cmd(mut sl, c, a);
            emit_result(mut out, line, r);
        }
    }
}

fn trace_job(rel: ref String, out: mut ref String) {
    let lines = lines_of(read_text(rel));
    let kind = words(lines[0])[0].clone();
    if kind == "dict" {
        dict_trace(lines, mut out);
    } else if kind == "set" {
        set_trace(lines, mut out);
    } else {
        list_trace(lines, mut out);
    }
}

// --------------------------------------------------------- SortedDict

// SortedDict: a dict, and a SortedList of its keys.
struct SortedDict {
    map: Map[i64, String],
    list: SortedKeyList[i64, i64],
}

fn key_error(k: i64) -> Exc {
    exc("KeyError", f"{k}")
}

fn item_repr(k: i64, v: ref String) -> String {
    f"({k}, {str_repr(v)})"
}

impl SortedDict {
    fn new() -> SortedDict {
        SortedDict { map: Map.new(), list: SortedKeyList.new(ident, int_repr, int_repr, "identity", false) }
    }

    // SortedDict(items): what copy, | and the reflected | make.
    fn from_items(items: ref Vec[(i64, String)]) -> SortedDict {
        let mut d = SortedDict.new();
        d.update(items);
        d
    }

    fn len(ref self) -> i64 {
        self.list.len
    }

    fn value(ref self, k: i64) -> String {
        match self.map.get(k) {
            Some(v) => v.clone(),
            None => "".to_string(),
        }
    }

    fn set(mut ref self, k: i64, v: own String) {
        if not self.map.contains_key(k) {
            self.list.add(k);
        }
        self.map.insert(k, v);
    }

    fn del(mut ref self, k: i64) -> Result[(), Exc] {
        if not self.map.contains_key(k) {
            return Err(key_error(k));
        }
        self.map.remove(k);
        self.list.remove(k)?;
        Ok(())
    }

    fn get(ref self, k: i64) -> Result[String, Exc] {
        match self.map.get(k) {
            Some(v) => Ok(v.clone()),
            None => Err(key_error(k)),
        }
    }

    fn items(ref self) -> Vec[(i64, String)] {
        let mut out: Vec[(i64, String)] = Vec.new();
        for k in self.list.values() {
            out.push((k, self.value(k)));
        }
        out
    }

    fn update(mut ref self, items: ref Vec[(i64, String)]) {
        // dict(items): each key once, where it first appears, with the
        // last value given for it.
        let mut keys: Vec[i64] = Vec.new();
        let mut pairs: Map[i64, String] = Map.new();
        for (k, v) in items {
            if not pairs.contains_key(k) {
                keys.push(k);
            }
            pairs.insert(k, v.clone());
        }
        let fresh = self.len() == 0;
        if fresh or 10 * keys.len() > self.len() {
            for k in keys {
                let v = match pairs.get(k) {
                    Some(v) => v.clone(),
                    None => "".to_string(),
                };
                self.map.insert(k, v);
            }
            if not fresh {
                self.list.clear();
            }
            let mut all: Vec[i64] = Vec.new();
            for (k, _) in self.map {
                all.push(k);
            }
            self.list.update(all);
        } else {
            for k in keys {
                let v = match pairs.get(k) {
                    Some(v) => v.clone(),
                    None => "".to_string(),
                };
                self.set(k, v);
            }
        }
    }

    fn clear(mut ref self) {
        self.map.clear();
        self.list.clear();
    }

    fn repr(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for k in self.list.values() {
            parts.push(f"{k}: {str_repr(self.value(k))}");
        }
        f"SortedDict({{{parts.join(", ")}}})"
    }

    fn check(ref self) -> bool {
        if not self.list.check() or self.map.len() != self.list.len {
            return false;
        }
        for k in self.list.values() {
            if not self.map.contains_key(k) {
                return false;
            }
        }
        true
    }

    // del d.keys()[index], and the items and values views: all three
    // pop the key from the list and then from the dict.
    fn del_view(mut ref self, index: i64) -> Result[(), Exc] {
        let k = self.list.pop(index)?;
        self.map.remove(k);
        Ok(())
    }

    fn del_view_slice(mut ref self, a: Option[i64], b: Option[i64], c: Option[i64]) -> Result[(), Exc] {
        let keys = self.list.get_slice(a, b, c)?;
        self.list.del_slice(a, b, c)?;
        for k in keys {
            self.map.remove(k);
        }
        Ok(())
    }
}

fn pairs_of(a: ref Vec[String]) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    let mut i = 0;
    while i + 1 < a.len() {
        out.push((num(a[i]), a[i + 1].clone()));
        i += 2;
    }
    out
}

fn dict_cmd(d: mut ref SortedDict, c: ref String, a: ref Vec[String]) -> Result[String, Exc] {
    if c == "set" {
        d.set(num(a[0]), a[1].clone());
        return Ok(none_repr());
    }
    if c == "del" {
        d.del(num(a[0]))?;
        return Ok(none_repr());
    }
    if c == "pop" {
        let k = num(a[0]);
        if d.map.contains_key(k) {
            let v = d.value(k);
            d.list.remove(k)?;
            d.map.remove(k);
            return Ok(str_repr(v));
        }
        if a.len() > 1 {
            return Ok(str_repr(a[1]));
        }
        return Err(key_error(k));
    }
    if c == "popitem" {
        if d.len() == 0 {
            return Err(exc("KeyError", "'popitem(): dictionary is empty'".to_string()));
        }
        let i = if a.len() > 0 { num(a[0]) } else { -1 };
        let k = d.list.pop(i)?;
        let v = d.value(k);
        d.map.remove(k);
        return Ok(item_repr(k, v));
    }
    if c == "peek" {
        let i = if a.len() > 0 { num(a[0]) } else { -1 };
        let k = d.list.get(i)?;
        return Ok(item_repr(k, d.value(k)));
    }
    if c == "setdefault" {
        let k = num(a[0]);
        if d.map.contains_key(k) {
            return Ok(str_repr(d.value(k)));
        }
        d.map.insert(k, a[1].clone());
        d.list.add(k);
        return Ok(str_repr(a[1]));
    }
    if c == "get" {
        return Ok(str_repr(d.get(num(a[0]))?));
    }
    if c == "in" {
        return Ok(bool_repr(d.map.contains_key(num(a[0]))));
    }
    if c == "keys" {
        let k = d.list.get(num(a[0]))?;
        return Ok(f"{k}");
    }
    if c == "items" {
        let k = d.list.get(num(a[0]))?;
        return Ok(item_repr(k, d.value(k)));
    }
    if c == "values" {
        let k = d.list.get(num(a[0]))?;
        return Ok(str_repr(d.value(k)));
    }
    if c == "keyslice" or c == "itemslice" or c == "valueslice" {
        let keys = d.list.get_slice(arg(a[0]), arg(a[1]), arg(a[2]))?;
        if c == "keyslice" {
            return Ok(ints_repr(keys));
        }
        let mut parts: Vec[String] = Vec.new();
        for k in keys {
            if c == "itemslice" {
                parts.push(item_repr(k, d.value(k)));
            } else {
                parts.push(str_repr(d.value(k)));
            }
        }
        return Ok(f"[{parts.join(", ")}]");
    }
    if c == "delkey" or c == "delitem" or c == "delvalue" {
        d.del_view(num(a[0]))?;
        return Ok(none_repr());
    }
    if c == "delkeyslice" {
        d.del_view_slice(arg(a[0]), arg(a[1]), arg(a[2]))?;
        return Ok(none_repr());
    }
    if c == "bl" {
        return Ok(f"{d.list.bisect_left(num(a[0]))}");
    }
    if c == "br" {
        return Ok(f"{d.list.bisect_right(num(a[0]))}");
    }
    if c == "index" {
        let i = d.list.index_of(num(a[0]), None, None)?;
        return Ok(f"{i}");
    }
    if c == "irange" {
        let v = d.list.irange(arg(a[0]), arg(a[1]), (flag(a[2]), flag(a[3])), flag(a[4]));
        return Ok(ints_repr(v));
    }
    if c == "islice" {
        let v = d.list.islice(arg(a[0]), arg(a[1]), flag(a[2]))?;
        return Ok(ints_repr(v));
    }
    if c == "update" {
        d.update(pairs_of(a));
        return Ok(none_repr());
    }
    if c == "or" or c == "ror" {
        let mut items: Vec[(i64, String)] = Vec.new();
        if c == "or" {
            items = d.items();
        }
        for p in pairs_of(a).into_iter() {
            items.push(p);
        }
        if c == "ror" {
            for p in d.items().into_iter() {
                items.push(p);
            }
        }
        return Ok(SortedDict.from_items(items).repr());
    }
    if c == "copy" {
        return Ok(SortedDict.from_items(d.items()).repr());
    }
    if c == "clear" {
        d.clear();
        return Ok(none_repr());
    }
    Ok(f"{d.len()}")
}

fn dict_trace(lines: ref Vec[String], out: mut ref String) {
    let head = words(lines[0]);
    let mut d = SortedDict.new();
    d.list.reset(num(head[1]));
    let mut i = 1;
    while i < lines.len() {
        let line = lines[i].clone();
        i += 1;
        let f = words(line);
        let c = f[0].clone();
        let a = f[1..].to_vec();
        if c == "shape" {
            emit(mut out, f"{line}: {d.list.shape()}");
        } else if c == "check" {
            emit(mut out, if d.check() { "check: ok" } else { "check: FAILED" });
        } else if c == "repr" {
            emit(mut out, f"repr: {d.repr()}");
        } else {
            let r = dict_cmd(mut d, c, a);
            emit_result(mut out, line, r);
        }
    }
}

// ---------------------------------------------------------- SortedSetPort

// SortedSetPort: a set, and a SortedList of its values. Which values are in
// the set is all this port needs of it: whenever sortedcontainers walks
// the set, it sorts what it finds.
struct SortedSetPort {
    set: Map[i64, bool],
    list: SortedKeyList[i64, i64],
}

impl SortedSetPort {
    // SortedSetPort._fromset(values): a new list with the default load.
    fn from_values(values: ref Vec[i64]) -> SortedSetPort {
        let mut s = SortedSetPort { set: Map.new(), list: SortedKeyList.new(ident, int_repr, int_repr, "identity", false) };
        for v in values {
            s.set.insert(v, true);
        }
        let members = s.members();
        s.list.update(members);
        s
    }

    fn members(ref self) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for (k, _) in self.set {
            out.push(k);
        }
        out.sort();
        out
    }

    fn has(ref self, v: i64) -> bool {
        self.set.contains_key(v)
    }

    fn add(mut ref self, v: i64) {
        if not self.has(v) {
            self.set.insert(v, true);
            self.list.add(v);
        }
    }

    fn discard(mut ref self, v: i64) {
        if self.has(v) {
            self.set.remove(v);
            self.list.discard(v);
        }
    }

    // _set changed wholesale: _list.clear() and _list.update(_set).
    fn rebuild(mut ref self) {
        self.list.clear();
        let members = self.members();
        self.list.update(members);
    }

    fn repr(ref self) -> String {
        f"SortedSet({ints_repr(self.list.values())})"
    }

    fn check(ref self) -> bool {
        if not self.list.check() or self.set.len() != self.list.len {
            return false;
        }
        for v in self.list.values() {
            if not self.has(v) {
                return false;
            }
        }
        true
    }
}

fn distinct(vs: ref Vec[i64]) -> Vec[i64] {
    let mut seen: Map[i64, bool] = Map.new();
    let mut out: Vec[i64] = Vec.new();
    for v in vs {
        if not seen.contains_key(v) {
            seen.insert(v, true);
            out.push(v);
        }
    }
    out
}

fn set_cmd(s: mut ref SortedSetPort, c: ref String, a: ref Vec[String]) -> Result[String, Exc] {
    if c == "add" {
        s.add(num(a[0]));
        return Ok(none_repr());
    }
    if c == "discard" {
        s.discard(num(a[0]));
        return Ok(none_repr());
    }
    if c == "remove" {
        let v = num(a[0]);
        if not s.has(v) {
            return Err(key_error(v));
        }
        s.set.remove(v);
        s.list.remove(v)?;
        return Ok(none_repr());
    }
    if c == "pop" {
        let i = if a.len() > 0 { num(a[0]) } else { -1 };
        let v = s.list.pop(i)?;
        s.set.remove(v);
        return Ok(f"{v}");
    }
    if c == "get" {
        let v = s.list.get(num(a[0]))?;
        return Ok(f"{v}");
    }
    if c == "slice" {
        let v = s.list.get_slice(arg(a[0]), arg(a[1]), arg(a[2]))?;
        return Ok(ints_repr(v));
    }
    if c == "del" {
        let v = s.list.get(num(a[0]))?;
        s.set.remove(v);
        s.list.del_at(num(a[0]))?;
        return Ok(none_repr());
    }
    if c == "delslice" {
        let vs = s.list.get_slice(arg(a[0]), arg(a[1]), arg(a[2]))?;
        for v in vs {
            s.set.remove(v);
        }
        s.list.del_slice(arg(a[0]), arg(a[1]), arg(a[2]))?;
        return Ok(none_repr());
    }
    if c == "in" {
        return Ok(bool_repr(s.has(num(a[0]))));
    }
    if c == "count" {
        return Ok(if s.has(num(a[0])) { "1".to_string() } else { "0".to_string() });
    }
    if c == "index" {
        let i = s.list.index_of(num(a[0]), None, None)?;
        return Ok(f"{i}");
    }
    if c == "bl" {
        return Ok(f"{s.list.bisect_left(num(a[0]))}");
    }
    if c == "br" {
        return Ok(f"{s.list.bisect_right(num(a[0]))}");
    }
    if c == "irange" {
        let v = s.list.irange(arg(a[0]), arg(a[1]), (flag(a[2]), flag(a[3])), flag(a[4]));
        return Ok(ints_repr(v));
    }
    if c == "islice" {
        let v = s.list.islice(arg(a[0]), arg(a[1]), flag(a[2]))?;
        return Ok(ints_repr(v));
    }
    let vs = distinct(ints(a));
    let mut other: Map[i64, bool] = Map.new();
    for v in vs {
        other.insert(v, true);
    }
    let mine = s.members();
    if c == "union" {
        let mut all = mine.clone();
        for v in vs {
            all.push(v);
        }
        return Ok(SortedSetPort.from_values(all).repr());
    }
    if c == "inter" or c == "diff" {
        let mut kept: Vec[i64] = Vec.new();
        for v in mine {
            if other.contains_key(v) == (c == "inter") {
                kept.push(v);
            }
        }
        return Ok(SortedSetPort.from_values(kept).repr());
    }
    if c == "symdiff" {
        return Ok(SortedSetPort.from_values(sym_diff(s, vs, other)).repr());
    }
    let sub = all_in(mine, other);
    let sup = all_in_set(vs, s);
    if c == "subset" or c == "le" {
        return Ok(bool_repr(sub));
    }
    if c == "superset" or c == "ge" {
        return Ok(bool_repr(sup));
    }
    if c == "disjoint" {
        let mut any = false;
        for v in vs {
            if s.has(v) {
                any = true;
            }
        }
        return Ok(bool_repr(not any));
    }
    if c == "eq" {
        return Ok(bool_repr(sub and sup));
    }
    if c == "lt" {
        return Ok(bool_repr(sub and not sup));
    }
    if c == "gt" {
        return Ok(bool_repr(sup and not sub));
    }
    if c == "update" {
        if 4 * vs.len() > s.set.len() {
            for v in vs {
                s.set.insert(v, true);
            }
            s.rebuild();
        } else {
            for v in vs {
                s.add(v);
            }
        }
        return Ok(s.repr());
    }
    if c == "diff_update" {
        if 4 * vs.len() > s.set.len() {
            for v in vs {
                s.set.remove(v);
            }
            s.rebuild();
        } else {
            for v in vs {
                s.discard(v);
            }
        }
        return Ok(s.repr());
    }
    if c == "inter_update" {
        for v in mine {
            if not other.contains_key(v) {
                s.set.remove(v);
            }
        }
        s.rebuild();
        return Ok(s.repr());
    }
    if c == "symdiff_update" {
        let next = sym_diff(s, vs, other);
        s.set.clear();
        for v in next {
            s.set.insert(v, true);
        }
        s.rebuild();
        return Ok(s.repr());
    }
    if c == "copy" {
        return Ok(SortedSetPort.from_values(mine).repr());
    }
    if c == "clear" {
        s.set.clear();
        s.list.clear();
        return Ok(none_repr());
    }
    Ok(f"{s.set.len()}")
}

fn sym_diff(s: ref SortedSetPort, vs: ref Vec[i64], other: ref Map[i64, bool]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for v in s.members() {
        if not other.contains_key(v) {
            out.push(v);
        }
    }
    for v in vs {
        if not s.has(v) {
            out.push(v);
        }
    }
    out
}

fn all_in(vs: ref Vec[i64], set: ref Map[i64, bool]) -> bool {
    for v in vs {
        if not set.contains_key(v) {
            return false;
        }
    }
    true
}

fn all_in_set(vs: ref Vec[i64], s: ref SortedSetPort) -> bool {
    for v in vs {
        if not s.has(v) {
            return false;
        }
    }
    true
}

fn set_trace(lines: ref Vec[String], out: mut ref String) {
    let head = words(lines[0]);
    let empty: Vec[i64] = Vec.new();
    let mut s = SortedSetPort.from_values(empty);
    s.list.reset(num(head[1]));
    let mut i = 1;
    while i < lines.len() {
        let line = lines[i].clone();
        i += 1;
        let f = words(line);
        let c = f[0].clone();
        let a = f[1..].to_vec();
        if c == "shape" {
            emit(mut out, f"{line}: {s.list.shape()}");
        } else if c == "check" {
            emit(mut out, if s.check() { "check: ok" } else { "check: FAILED" });
        } else if c == "repr" {
            emit(mut out, f"repr: {s.repr()}");
        } else {
            let r = set_cmd(mut s, c, a);
            emit_result(mut out, line, r);
        }
    }
}

// ---------------------------------------------------------- scenarios

// A SortedDict with int keys, for the programs below.
struct IntDict[V] {
    map: Map[i64, V],
    list: SortedKeyList[i64, i64],
}

impl[V: Clone] IntDict[V] {
    fn new() -> IntDict[V] {
        IntDict { map: Map.new(), list: SortedKeyList.new(ident, int_repr, int_repr, "identity", false) }
    }

    fn len(ref self) -> i64 {
        self.list.len
    }

    fn has(ref self, k: i64) -> bool {
        self.map.contains_key(k)
    }

    fn set(mut ref self, k: i64, v: own V) {
        if not self.map.contains_key(k) {
            self.list.add(k);
        }
        self.map.insert(k, v);
    }

    fn del(mut ref self, k: i64) {
        self.map.remove(k);
        self.list.discard(k);
    }

    fn at(ref self, k: i64) -> V {
        match self.map.get(k) {
            Some(v) => v.clone(),
            None => panic("missing key"),
        }
    }

    fn peek_key(mut ref self, index: i64) -> i64 {
        match self.list.get(index) {
            Ok(k) => k,
            Err(_) => panic("peekitem on an empty dict"),
        }
    }

    fn keys(ref self) -> Vec[i64] {
        self.list.values()
    }
}

// ----------------------------------------------------------- order book

fn depth(book: mut ref IntDict[Vec[(i64, i64)]], top: bool) -> String {
    let mut keys = if top {
        match book.list.get_slice(Some(-3), None, None) {
            Ok(v) => v,
            Err(_) => Vec.new(),
        }
    } else {
        match book.list.get_slice(None, Some(3), None) {
            Ok(v) => v,
            Err(_) => Vec.new(),
        }
    };
    if top {
        keys.reverse();
    }
    let mut parts: Vec[String] = Vec.new();
    for p in keys {
        let mut total = 0;
        for (_, q) in book.at(p) {
            total += q;
        }
        parts.push(f"{p} x {total}");
    }
    parts.join(" ")
}

fn level_repr(level: ref Vec[(i64, i64)]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for (o, q) in level {
        parts.push(f"[{o}, {q}]");
    }
    f"[{parts.join(", ")}]"
}

fn half_repr(sum: i64) -> String {
    if sum % 2 == 0 {
        f"{sum / 2}.0"
    } else {
        f"{sum / 2}.5"
    }
}

// Fill an order against the other side of the book: what is left of it.
fn match_order(bids: mut ref IntDict[Vec[(i64, i64)]], asks: mut ref IntDict[Vec[(i64, i64)]], resting: mut ref Map[i64, (bool, i64)], buy: bool, oid: i64, limit: Option[i64], qty0: i64, out: mut ref String) -> i64 {
    let mut qty = qty0;
    loop {
        let book_len = if buy { asks.len() } else { bids.len() };
        if qty <= 0 or book_len == 0 {
            break;
        }
        let price = if buy { asks.peek_key(0) } else { bids.peek_key(-1) };
        if let Some(l) = limit {
            if (buy and price > l) or (not buy and price < l) {
                break;
            }
        }
        let mut level = if buy { asks.at(price) } else { bids.at(price) };
        let (head_id, head_qty) = level[0];
        let take = if qty < head_qty { qty } else { head_qty };
        if buy {
            emit(mut out, f"  trade buy {oid} sell {head_id} {take} @ {price}");
        } else {
            emit(mut out, f"  trade buy {head_id} sell {oid} {take} @ {price}");
        }
        qty -= take;
        if head_qty - take == 0 {
            level.remove(0);
            resting.remove(head_id);
        } else {
            level[0] = (head_id, head_qty - take);
        }
        let empty = level.len() == 0;
        if buy {
            if empty { asks.del(price); } else { asks.set(price, level); }
        } else {
            if empty { bids.del(price); } else { bids.set(price, level); }
        }
    }
    qty
}

fn orderbook_job(rel: ref String, out: mut ref String) {
    let mut bids: IntDict[Vec[(i64, i64)]] = IntDict.new();
    let mut asks: IntDict[Vec[(i64, i64)]] = IntDict.new();
    let mut resting: Map[i64, (bool, i64)] = Map.new();
    let rows = lines_of(read_text(rel));
    let mut n = 0;
    while n + 1 < rows.len() {
        n += 1;
        let f: Vec[String] = rows[n].split(",").map(|p| p.to_string()).collect();
        let oid = num(f[0]);
        if f[1] == "cancel" {
            let target = num(f[2]);
            match resting.remove(target) {
                None => emit(mut out, f"#{oid} cancel {target}: not resting"),
                Some((is_buy, price)) => {
                    let mut level = if is_buy { bids.at(price) } else { asks.at(price) };
                    let mut i = 0;
                    while i < level.len() {
                        if level[i].0 == target {
                            emit(mut out, f"#{oid} cancel {target}: {level[i].1} left at {price}");
                            level.remove(i);
                            break;
                        }
                        i += 1;
                    }
                    let empty = level.len() == 0;
                    if is_buy {
                        if empty { bids.del(price); } else { bids.set(price, level); }
                    } else {
                        if empty { asks.del(price); } else { asks.set(price, level); }
                    }
                }
            }
        } else {
            let buy = f[1] == "buy";
            let qty = num(f[4]);
            if f[2] == "market" {
                emit(mut out, f"#{oid} market {f[1]} {qty}");
                let rest = match_order(mut bids, mut asks, mut resting, buy, oid, None, qty, mut out);
                if rest > 0 {
                    emit(mut out, f"  unfilled {rest}");
                }
            } else {
                let price = num(f[3]);
                emit(mut out, f"#{oid} limit {f[1]} {qty} @ {price}");
                let rest = match_order(mut bids, mut asks, mut resting, buy, oid, Some(price), qty, mut out);
                if rest > 0 {
                    if buy {
                        let mut level = if bids.has(price) { bids.at(price) } else { Vec.new() };
                        level.push((oid, rest));
                        bids.set(price, level);
                    } else {
                        let mut level = if asks.has(price) { asks.at(price) } else { Vec.new() };
                        level.push((oid, rest));
                        asks.set(price, level);
                    }
                    resting.insert(oid, (buy, price));
                    emit(mut out, f"  rests {rest}");
                }
            }
        }
        if n % 50 == 0 {
            emit(mut out, f"book after {n} orders");
            emit(mut out, f"  bids: {depth(mut bids, true)}");
            emit(mut out, f"  asks: {depth(mut asks, false)}");
            if bids.len() > 0 and asks.len() > 0 {
                let bb = bids.peek_key(-1);
                let ba = asks.peek_key(0);
                emit(mut out, f"  spread {ba - bb} mid {half_repr(bb + ba)}");
                let near_bids = bids.list.irange(Some(bb - 25), Some(bb), (true, true), false).len();
                let near_asks = asks.list.bisect_right(ba + 25);
                emit(mut out, f"  levels within 25 of mid: bids {near_bids} asks {near_asks}");
            }
        }
    }
    emit(mut out, f"resting orders: {resting.len()}");
    emit(mut out, f"bid levels: {ints_repr(bids.keys())}");
    emit(mut out, f"ask levels: {ints_repr(asks.keys())}");
    if bids.len() > 0 {
        let p = bids.peek_key(-1);
        emit(mut out, f"best bid: ({p}, {level_repr(bids.at(p))})");
    }
    if asks.len() > 0 {
        let p = asks.peek_key(0);
        emit(mut out, f"best ask: ({p}, {level_repr(asks.at(p))})");
    }
}

// ---------------------------------------------------------- leaderboard

fn rank_key(e: ref (String, i64)) -> (i64, String) {
    (-e.1, e.0.clone())
}

fn entry_repr(e: ref (String, i64)) -> String {
    f"({str_repr(e.0)}, {e.1})"
}

fn rank_repr(k: ref (i64, String)) -> String {
    f"({k.0}, {str_repr(k.1)})"
}

fn entries(v: ref Vec[(String, i64)]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for (name, pts) in v {
        parts.push(f"{name} {pts}");
    }
    parts.join(", ")
}

fn leaderboard_job(rel: ref String, out: mut ref String) {
    let mut totals: Map[String, i64] = Map.new();
    let mut board = SortedKeyList.new(rank_key, entry_repr, rank_repr, "rank_key", true);
    let mut n = 0;
    for line in lines_of(read_text(rel)) {
        n += 1;
        let f = words(line);
        let player = f[1].clone();
        let new = match totals.get(player) {
            Some(old) => {
                let o = *old;
                let _ = board.remove((player.clone(), o));
                o + num(f[2])
            }
            None => num(f[2]),
        };
        totals.insert(player.clone(), new);
        board.add((player.clone(), new));
        if n % 30 == 0 {
            emit(mut out, f"t={f[0]} after {n} events");
            let top = match board.get_slice(None, Some(5), None) {
                Ok(v) => v,
                Err(_) => Vec.new(),
            };
            emit(mut out, f"  top 5: {entries(top)}");
            let mut bottom = match board.get_slice(Some(-3), None, None) {
                Ok(v) => v,
                Err(_) => Vec.new(),
            };
            bottom.reverse();
            emit(mut out, f"  bottom 3: {entries(bottom)}");
            let rank = match board.index_of((player.clone(), new), None, None) {
                Ok(i) => i + 1,
                Err(_) => 0,
            };
            emit(mut out, f"  rank of {player}: {rank} of {board.len}");
            emit(mut out, f"  at 100 or more: {board.bisect_key_left((-99, "".to_string()))}");
            let band = board.irange_key(Some((-200, "".to_string())), Some((-100, "~".to_string())), (true, true), false);
            let mut names: Vec[String] = Vec.new();
            for e in band {
                names.push(e.0.clone());
            }
            emit(mut out, f"  between 100 and 200: {names.join(" ")}");
            let same = board.irange_key(Some((-new, "".to_string())), Some((-new, "~".to_string())), (true, true), false);
            emit(mut out, f"  same total as {player}: {same.len()}");
        }
    }
    emit(mut out, f"final: {board.repr()}");
}

// -------------------------------------------------------------- latency

fn plain_list() -> SortedKeyList[i64, i64] {
    SortedKeyList.new(ident, int_repr, int_repr, "identity", false)
}

fn at_or_zero(sl: mut ref SortedKeyList[i64, i64], i: i64) -> i64 {
    match sl.get(i) {
        Ok(v) => v,
        Err(_) => 0,
    }
}

fn latency_job(rel: ref String, out: mut ref String) {
    let mut window: Vec[i64] = Vec.new();
    let mut head = 0;
    let mut win = plain_list();
    let mut routes: Map[String, SortedKeyList[i64, i64]] = Map.new();
    let mut names: Vec[String] = Vec.new();
    let mut alerting = false;
    let mut n = 0;
    for line in lines_of(read_text(rel)) {
        n += 1;
        let f = words(line);
        let ms = num(f[2]);
        window.push(ms);
        win.add(ms);
        if window.len() - head > 50 {
            let old = window[head];
            head += 1;
            let _ = win.remove(old);
        }
        let route = f[1].clone();
        if not routes.contains_key(route) {
            routes.insert(route.clone(), plain_list());
            names.push(route.clone());
        }
        if let Some(sl) = routes.get_mut(route) {
            sl.add(ms);
        }
        if n % 25 == 0 {
            let k = win.len;
            let p50 = at_or_zero(mut win, k / 2);
            let p95 = at_or_zero(mut win, k * 95 / 100);
            let p99 = at_or_zero(mut win, k * 99 / 100);
            let slow = k - win.bisect_right(250);
            emit(mut out, f"{f[0]} n={n} p50={p50} p95={p95} p99={p99} max={at_or_zero(mut win, -1)} slow={slow}");
            if p95 > 400 and not alerting {
                alerting = true;
                emit(mut out, f"  ALERT p95 {p95} ms over 400");
            } else if p95 <= 400 and alerting {
                alerting = false;
                emit(mut out, "  resolved");
            }
        }
    }
    names.sort();
    for route in names {
        if let Some(sl) = routes.get_mut(route) {
            let k = sl.len;
            let p50 = at_or_zero(mut sl, k / 2);
            let p99 = at_or_zero(mut sl, k * 99 / 100);
            let mut top = match sl.get_slice(Some(-3), None, None) {
                Ok(v) => v,
                Err(_) => Vec.new(),
            };
            top.reverse();
            let under = sl.bisect_left(10);
            emit(mut out, f"{route.replace("_", " ")} count={k} p50={p50} p99={p99} top={ints_repr(top)} under10={under}");
        }
    }
}

// -------------------------------------------------------------- booking

fn two(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn hm(m: i64) -> String {
    f"{two(m / 60)}:{two(m % 60)}"
}

fn booking_job(rel: ref String, out: mut ref String) {
    let mut rooms: Map[String, IntDict[(i64, String)]] = Map.new();
    for line in lines_of(read_text(rel)) {
        let f = words(line);
        let room = f[1].clone();
        if not rooms.contains_key(room) {
            rooms.insert(room.clone(), IntDict.new());
        }
        let cal = match rooms.get_mut(room) {
            Some(c) => c,
            None => panic("no room"),
        };
        if f[0] == "book" {
            let s = num(f[2]);
            let e = num(f[3]);
            let who = f[4].clone();
            let i = cal.list.bisect_right(s);
            let mut clash: Option[(i64, i64, String)] = None;
            if i > 0 {
                let ps = cal.peek_key(i - 1);
                let (pe, pw) = cal.at(ps);
                if pe > s {
                    clash = Some((ps, pe, pw));
                }
            }
            if clash.is_none() and i < cal.len() {
                let ns = cal.peek_key(i);
                let (ne, nw) = cal.at(ns);
                if ns < e {
                    clash = Some((ns, ne, nw));
                }
            }
            match clash {
                Some((cs, ce, cw)) => emit(mut out, f"book {room} {hm(s)}-{hm(e)} {who}: clashes with {hm(cs)}-{hm(ce)} {cw}"),
                None => {
                    cal.set(s, (e, who.clone()));
                    let pos = match cal.list.index_of(s, None, None) {
                        Ok(p) => p + 1,
                        Err(_) => 0,
                    };
                    emit(mut out, f"book {room} {hm(s)}-{hm(e)} {who}: booked, #{pos} of the day");
                }
            }
        } else if f[0] == "cancel" {
            let s = num(f[2]);
            if cal.has(s) {
                let (e, who) = cal.at(s);
                cal.del(s);
                emit(mut out, f"cancel {room} {hm(s)}: {who}'s booking until {hm(e)}");
            } else {
                let later = cal.list.irange(Some(s), None, (false, true), false);
                let next = if later.len() > 0 { f"; next at {hm(later[0])}" } else { "".to_string() };
                emit(mut out, f"cancel {room} {hm(s)}: nothing starts then{next}");
            }
        } else if f[0] == "free" {
            let need = num(f[2]);
            let mut gaps: Vec[String] = Vec.new();
            let mut t = 480;
            for s in cal.keys() {
                if s - t >= need {
                    gaps.push(f"{hm(t)}-{hm(s)}");
                }
                let (e, _) = cal.at(s);
                if e > t {
                    t = e;
                }
            }
            if 1080 - t >= need {
                gaps.push(f"{hm(t)}-{hm(1080)}");
            }
            let shown = if gaps.len() == 0 {
                "none".to_string()
            } else {
                let end = if gaps.len() < 4 { gaps.len() } else { 4 };
                gaps[0..end].to_vec().join(" ")
            };
            emit(mut out, f"free {room} {need} min: {shown}");
        } else {
            emit(mut out, f"agenda {room} ({cal.len()})");
            for s in cal.keys() {
                let (e, who) = cal.at(s);
                emit(mut out, f"  {hm(s)}-{hm(e)} {who}");
            }
        }
    }
}

// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())) {
        let job: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        emit(mut out, f"== {job.join(" ")}");
        let rel = job[1].clone();
        if job[0] == "trace" {
            trace_job(rel, mut out);
        } else if job[0] == "orderbook" {
            orderbook_job(rel, mut out);
        } else if job[0] == "leaderboard" {
            leaderboard_job(rel, mut out);
        } else if job[0] == "latency" {
            latency_job(rel, mut out);
        } else {
            booking_job(rel, mut out);
        }
    }
    print(out);
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    data_part_7(mut v);
    data_part_8(mut v);
    data_part_9(mut v);
    v
}

