== join
join([]) -> ''
join(['ant']) -> 'ant'
join(['ant', 'bee']) -> 'ant and bee'
join(['ant', 'bee', 'fly']) -> 'ant, bee, and fly'
join(['ant', 'bee', 'fly', 'gnat']) -> 'ant, bee, fly, and gnat'
join(['Paris, France', 'Rome', 'Berlin']) -> 'Paris, France; Rome; and Berlin'
join(['a,b', 'c']) -> 'a,b and c'
join(['ant', 'bee', 'fly'], conj='or') -> 'ant, bee, or fly'
join(['ant', 'bee', 'fly'], conj='') -> 'ant, bee, fly'
join(['ant', 'bee', 'fly'], conj='', conj_spaced=False) -> 'ant, bee,fly'
join(['ant', 'bee', 'fly'], sep=';') -> 'ant; bee; and fly'
join(['ant', 'bee', 'fly'], sep='|', sep_spaced=False) -> 'ant|bee| and fly'
join(['ant', 'bee', 'fly'], final_sep='') -> 'ant, bee and fly'
join(['ant', 'bee', 'fly'], final_sep=' &', conj='', conj_spaced=False) -> 'ant, bee &fly'
join(['ant', 'bee'], conj='&', conj_spaced=False) -> 'ant&bee'
join(['Paris, France', 'Rome', 'Berlin'], sep=',') -> 'Paris, France, Rome, and Berlin'
join(['ant', 'bee', 'fly', 'gnat'], conj='and/or') -> 'ant, bee, fly, and/or gnat'
join(None) -> ''
== inflect
inflect("The plural of cat is plural('cat')") -> 'The plural of cat is cats'
inflect("plural_noun('mouse') and plural_verb('runs') and plural_adj('my')") -> 'mice and run and our'
inflect("I saw a('apple') and an('hour') and a('unicorn')") -> 'I saw an apple and an hour and a unicorn'
inflect("There num(3) plural_verb('is') no('error')") -> 'There 3 are 3 errors'
inflect("There num(1) plural_verb('is') no('error')") -> 'There 1 is 1 error'
inflect("num(0, False)There are no('error')") -> 'There are no errors'
inflect("She is ordinal(21) and ordinal('nine')") -> 'She is 21st and ninth'
inflect('We counted number_to_words(1234)') -> 'We counted one thousand, two hundred and thirty-four'
inflect("number_to_words(1234, group=1) and number_to_words(42, andword='')") -> 'one, two, three, four and forty-two'
inflect("Running present_participle('runs') and present_participle('sees')") -> 'Running running and seeing'
inflect("singular_noun('mice') and singular_noun('cats', gender='feminine')") -> 'mouse and cat'
inflect("plural('child', 2) vs plural('child', 1) vs plural('child', count=0)") -> 'children vs child vs children'
inflect('unknown(cat) stays as it is') -> 'unknown(cat) stays as it is'
inflect('plural(cat)') ! NameError: name 'cat' is not defined
inflect('x plural(-1) y') ! AttributeError: 'UnaryOp' object has no attribute 'id'
inflect("singular_noun('cat')") ! TypeError: sequence item 0: expected str instance, bool found
inflect('number_to_words(5, wantlist=True)') ! TypeError: sequence item 0: expected str instance, list found
inflect('plural(\'cat\') plural("dog") plural(\'ox\', "2")') -> 'cats dogs oxen'
inflect("no('cat', 0) no('cat', 1) no('cat', 5) no('cat', 'no')") -> 'no cats 1 cat 5 cats no cats'
inflect('plural(\'sheep\') and a("FBI agent") and plural(\'index\')') -> 'sheep and an FBI agent and indexes'
inflect("PLURAL('cat') and Plural('cat')") -> "PLURAL('cat') and Plural('cat')"
inflect("num(2)plural('cat') num(1)plural('cat') num()plural('cat')") -> '2cats 1cat cats'
inflect("plural('cat',)") -> 'cats'
inflect("a('cat', 3) and an('egg', 'some')") -> '3 cat and some egg'
inflect("plural('a\\tb')") -> 'a\tbs'
inflect("plural('caf\\u00e9')") -> 'cafés'
inflect("plural(['cat'])") ! TypeError: expected string or bytes-like object, got 'list'
inflect('ordinal(3.5) ordinal(-11) number_to_words(-0.5)') ! AttributeError: 'UnaryOp' object has no attribute 'id'
num(2) -> '2'
inflect("plural('cat') num(1)") -> 'cats 1'
plural('cat') -> 'cats'
