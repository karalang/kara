fn alts(v: ref Vec[String]) -> String {
    joined(v, "|".to_string())
}

fn new_tab(raw: ref Raw) -> Result[Tab, String] {
    let i = flag_i();
    let irregular_s = raw.d("pl_sb_irregular_s");
    let irregular = raw.d("pl_sb_irregular");
    let irregular_caps = raw.d("pl_sb_irregular_caps");
    let irregular_compound = raw.d("pl_sb_irregular_compound");

    let is_ides_complete = raw.l("pl_sb_C_is_ides_complete");
    let is_ides_endings = raw.l("pl_sb_C_is_ides_endings");
    let c_is_ides_stem = joinstem(2, concat(is_ides_complete, prefixed(".*", is_ides_endings)));
    let c_is_ides = make_pl_si(concat(is_ides_complete, is_ides_endings), "ides", 2);
    let c_a_ata = make_pl_si(raw.l("pl_sb_C_a_ata_list"), "ata", 1);
    let u_a_ae = make_pl_si(raw.l("pl_sb_U_a_ae_list"), "e", 0);
    let c_a_ae = make_pl_si(raw.l("pl_sb_C_a_ae_list"), "e", 0);
    let c_en_ina = make_pl_si(raw.l("pl_sb_C_en_ina_list"), "ina", 2);
    let u_um_a = make_pl_si(raw.l("pl_sb_U_um_a_list"), "a", 2);
    let c_um_a = make_pl_si(raw.l("pl_sb_C_um_a_list"), "a", 2);
    let u_us_i = make_pl_si(raw.l("pl_sb_U_us_i_list"), "i", 2);
    let c_us_i = make_pl_si(raw.l("pl_sb_C_us_i_list"), "i", 2);
    let c_us_us = raw.l("pl_sb_C_us_us");
    let u_on_a = make_pl_si(raw.l("pl_sb_U_on_a_list"), "a", 2);
    let c_on_a = make_pl_si(raw.l("pl_sb_C_on_a_list"), "a", 2);
    let c_o_i = raw.l("pl_sb_C_o_i");
    let mut si_c_o_i: Vec[String] = Vec.new();
    for w in c_o_i.iter() {
        si_c_o_i.push(f"{cut(w, 1)}i");
    }
    let u_o_os_complete = raw.l("pl_sb_U_o_os_complete");
    let u_o_os_endings = raw.l("pl_sb_U_o_os_endings");
    let c_ex_ices = make_pl_si(raw.l("pl_sb_C_ex_ices_list"), "ices", 2);
    let c_ix_ices = make_pl_si(raw.l("pl_sb_C_ix_ices_list"), "ices", 2);
    let c_i = make_pl_si(raw.l("pl_sb_C_i_list"), "i", 0);
    let c_im = make_pl_si(raw.l("pl_sb_C_im_list"), "im", 0);

    let uninflected_s = concat(raw.l("pl_sb_uninflected_s_complete"), prefixed(".*", raw.l("pl_sb_uninflected_s_endings")));
    let singular_s_complete = raw.l("pl_sb_singular_s_complete");
    let singular_s_endings = raw.l("pl_sb_singular_s_endings");
    let pl_sb_singular_s = enclose(alts(concat(concat(singular_s_complete, prefixed(".*", singular_s_endings)), raw.l("pl_sb_singular_s_es"))));

    let mut special_s: Vec[String] = Vec.new();
    special_s.push(pl_sb_singular_s);
    special_s = concat(special_s, uninflected_s);
    special_s = concat(special_s, keys_of(irregular_s));
    special_s.push("(.*[csx])is".to_string());
    special_s.push("(.*)ceps".to_string());
    special_s.push("[A-Z].*s".to_string());
    let plverb_special_s = enclose(alts(special_s));

    let mut postfix: Vec[String] = Vec.new();
    let defn: Vec[(Str, String)] = vec![
        ("general", enclose("(?!major|lieutenant|brigadier|adjutant|.*star)\\S+".to_string())),
        ("martial", enclose("court".to_string())),
        ("force", enclose("pound".to_string())),
    ];
    for (key, val) in defn.iter() {
        postfix.push(enclose(f"{val}(?=(?:-|\\s+){key})"));
    }
    let postfix_adj_stems = f"({alts(postfix)})(.*)";

    let prep_da = concat(raw.l("pl_prep_list"), vec!["de".to_string(), "du".to_string(), "da".to_string()]);
    let pl_prep = enclose(alts(prep_da));
    let prep_dual_compound = f"(.*?)((?:-|\\s+)(?:{pl_prep})(?:-|\\s+))a(?:-|\\s+)(.*)";

    let pron_nom = raw.d("pl_pron_nom");
    let pron_acc = raw.d("pl_pron_acc");
    let mut si_pron_nom: Map[String, SiPron] = Map.new();
    for (k, v) in pron_nom.iter() {
        si_pron_nom.insert(v.clone(), SiPron.One(k.clone()));
    }
    si_pron_nom.insert("we".to_string(), SiPron.One("I".to_string()));
    let mut si_pron_acc: Map[String, SiPron] = Map.new();
    let mut si_acc_keys: Vec[String] = Vec.new();
    for (k, v) in pron_acc.iter() {
        if not si_pron_acc.contains_key(v) {
            si_acc_keys.push(v.clone());
        }
        si_pron_acc.insert(v.clone(), SiPron.One(k.clone()));
    }
    si_pron_nom.insert("they".to_string(), genders6("it", "she", "he", "they", "she or he", "he or she"));
    si_pron_nom.insert("themselves".to_string(), genders6("itself", "herself", "himself", "themself", "herself or himself", "himself or herself"));
    si_pron_nom.insert("theirs".to_string(), genders6("its", "hers", "his", "theirs", "hers or his", "his or hers"));
    si_pron_acc.insert("them".to_string(), genders6("it", "her", "him", "them", "her or him", "him or her"));
    si_pron_acc.insert("themselves".to_string(), genders6("itself", "herself", "himself", "themself", "herself or himself", "himself or herself"));

    let ambiguous_pres = raw.d("plverb_ambiguous_pres");
    let adj_special = raw.d("pl_adj_special");
    let adj_poss = raw.d("pl_adj_poss");
    let mut nth: Map[i64, String] = Map.new();
    let mut nth_suff: Set[String] = Set.new();
    for (k, v) in raw.d("nth").iter() {
        nth.insert(i64.parse(k).unwrap_or(0), v.clone());
        nth_suff.insert(v.clone());
    }
    let ordinal = raw.d("ordinal");

    let mut indef: Vec[(Program, String)] = Vec.new();
    let a_abbrev = "\n^(?! FJO | [HLMNS]Y.  | RY[EO] | SQU\n  | ( F[LR]? | [HL] | MN? | N | RH? | S[CHKLMNPTVW]? | X(YL)?) [AEIOU])\n[FHLMNRSX][A-Z]\n";
    indef.push((rxs("^([bcdgjkpqtuvwyz]-?th)", i)?, "a".to_string()));
    indef.push((rxs("^([aefhilmnorsx]-?th)", i)?, "an".to_string()));
    indef.push((rxs("^((?:euler|hour(?!i)|heir|honest|hono[ur]|mpeg))", i)?, "an".to_string()));
    indef.push((rxs("^[aefhilmnorsx]$", i)?, "an".to_string()));
    indef.push((rxs("^[bcdgjkpqtuvwyz]$", i)?, "a".to_string()));
    indef.push((rxs(a_abbrev, flag_x())?, "an".to_string()));
    indef.push((rxs("^[aefhilmnorsx][.-]", i)?, "an".to_string()));
    indef.push((rxs("^[a-z][.-]", i)?, "a".to_string()));
    indef.push((rxs("^[^aeiouy]", i)?, "a".to_string()));
    indef.push((rxs("^e[uw]", i)?, "a".to_string()));
    indef.push((rxs("^onc?e\\b", i)?, "a".to_string()));
    indef.push((rxs("^onetime\\b", i)?, "a".to_string()));
    indef.push((rxs("^uni([^nmd]|mo)", i)?, "a".to_string()));
    indef.push((rxs("^u[bcfghjkqrst][aeiou]", i)?, "a".to_string()));
    indef.push((rxs("^ukr", i)?, "a".to_string()));
    indef.push((rxs("^((?:unabomber|unanimous|US))", i)?, "a".to_string()));
    indef.push((rxs("^U[NK][AIEO]?", 0)?, "a".to_string()));
    indef.push((rxs("^[aeiou]", i)?, "an".to_string()));
    indef.push((rxs("^(y(b[lor]|cl[ea]|fere|gg|p[ios]|rou|tt))", i)?, "an".to_string()));

    // _pl_check_plurals_N's stems and endings, compiled once.
    let stem_endings: Vec[(String, Str, Str)] = vec![
        (c_a_ata.stem.clone(), "as", "ata"),
        (c_is_ides_stem.clone(), "is", "ides"),
        (c_a_ae.stem.clone(), "s", "e"),
        (c_en_ina.stem.clone(), "ens", "ina"),
        (c_um_a.stem.clone(), "ums", "a"),
        (c_us_i.stem.clone(), "uses", "i"),
        (c_on_a.stem.clone(), "ons", "a"),
        (joinstem(1, c_o_i), "os", "i"),
        (c_ex_ices.stem.clone(), "exes", "ices"),
        (c_ix_ices.stem.clone(), "ixes", "ices"),
        (c_i.stem.clone(), "s", "i"),
        (c_im.stem.clone(), "s", "im"),
        (".*eau".to_string(), "s", "x"),
        (".*ieu".to_string(), "s", "x"),
        (".*tri".to_string(), "xes", "ces"),
        (".{2,}[yia]n".to_string(), "xes", "ges"),
    ];
    let mut reg_plurals: Vec[Program] = Vec.new();
    for (stems, e1, e2) in stem_endings.iter() {
        reg_plurals.push(rx(f"({stems})({e1}\\|\\1{e2}|{e2}\\|\\1{e1})", 0)?);
    }

    let mut participle: Vec[(Program, String)] = Vec.new();
    let pp: Vec[(Str, Str)] = vec![
        ("ie$", "y"),
        ("ue$", "u"),
        ("([auy])e$", "\\g<1>"),
        ("ski$", "ski"),
        ("[^b]i$", ""),
        ("^(are|were)$", "be"),
        ("^(had)$", "hav"),
        ("^(hoe)$", "\\g<1>"),
        ("([^e])e$", "\\g<1>"),
        ("er$", "er"),
        ("([^aeiou][aeiouy]([bdgmnprst]))$", "\\g<1>\\g<2>"),
    ];
    for (p, r) in pp.iter() {
        participle.push((rxs(*p, 0)?, r.to_string()));
    }

    Ok(Tab {
        irregular_s_values: values_set(irregular_s),
        irregular_s: map_of(irregular_s),
        irregular_values: values_set(irregular),
        si_irregular: invert_split(irregular),
        irregular: map_of(irregular),
        irregular_caps_values: values_set(irregular_caps),
        si_irregular_caps: invert(irregular_caps),
        irregular_caps: map_of(irregular_caps),
        si_irregular_compound: invert_split(irregular_compound),
        irregular_compound: map_of(irregular_compound),
        z_zes: bysize(raw.l("pl_sb_z_zes_list")),
        ze_zes: bysize(raw.l("pl_sb_ze_zes_list")),
        c_is_ides_stem: c_is_ides_stem,
        c_is_ides: c_is_ides,
        c_a_ata: c_a_ata,
        u_a_ae: u_a_ae,
        c_a_ae: c_a_ae,
        c_en_ina: c_en_ina,
        u_um_a: u_um_a,
        c_um_a: c_um_a,
        u_us_i: u_us_i,
        c_us_i: c_us_i,
        c_us_us_bs: bysize(c_us_us),
        c_us_us: set_of(c_us_us),
        u_on_a: u_on_a,
        c_on_a: c_on_a,
        c_o_i_bs: bysize(c_o_i),
        si_c_o_i_bs: bysize(si_c_o_i),
        c_o_i_stems: joinstem(1, c_o_i),
        si_u_o_os_complete: set_of(suffixed(u_o_os_complete, "s")),
        u_o_os_complete: set_of(u_o_os_complete),
        si_u_o_os_bs: bysize(suffixed(u_o_os_endings, "s")),
        u_o_os_bs: bysize(u_o_os_endings),
        u_ch_chs: make_pl_si(raw.l("pl_sb_U_ch_chs_list"), "s", 0),
        u_ex_ices: make_pl_si(raw.l("pl_sb_U_ex_ices_list"), "ices", 2),
        u_ix_ices: make_pl_si(raw.l("pl_sb_U_ix_ices_list"), "ices", 2),
        c_ex_ices: c_ex_ices,
        c_ix_ices: c_ix_ices,
        c_i: c_i,
        c_im: c_im,
        u_man_mans: make_pl_si(raw.l("pl_sb_U_man_mans_list"), "s", 0),
        u_man_mans_caps: make_pl_si(raw.l("pl_sb_U_man_mans_caps_list"), "s", 0),
        u_louse_lice: make_pl_si(raw.l("pl_sb_U_louse_lice_list"), "lice", 5),
        uninflected_herd: set_of(raw.l("pl_sb_uninflected_herd")),
        uninflected_complete: set_of(raw.l("pl_sb_uninflected_complete")),
        uninflected_caps: set_of(raw.l("pl_sb_uninflected_caps")),
        uninflected_bs: bysize(raw.l("pl_sb_uninflected_endings")),
        si_singular_s_complete: set_of(suffixed(singular_s_complete, "es")),
        si_singular_s_bs: bysize(suffixed(singular_s_endings, "es")),
        singular_s_complete: set_of(singular_s_complete),
        singular_s_bs: bysize(singular_s_endings),
        si_ois_oi_case: set_of(raw.l("si_sb_ois_oi_case")),
        si_uses_use_case: set_of(raw.l("si_sb_uses_use_case")),
        si_uses_use: set_of(raw.l("si_sb_uses_use")),
        si_ies_ie_case: set_of(raw.l("si_sb_ies_ie_case")),
        si_ies_ie: set_of(raw.l("si_sb_ies_ie")),
        si_oes_oe_case: set_of(raw.l("si_sb_oes_oe_case")),
        si_oes_oe: set_of(raw.l("si_sb_oes_oe")),
        si_z_zes: set_of(raw.l("si_sb_z_zes")),
        si_zzes_zz: set_of(raw.l("si_sb_zzes_zz")),
        si_ches_che_case: set_of(raw.l("si_sb_ches_che_case")),
        si_ches_che: set_of(raw.l("si_sb_ches_che")),
        si_xes_xe: set_of(raw.l("si_sb_xes_xe")),
        si_sses_sse_case: set_of(raw.l("si_sb_sses_sse_case")),
        si_sses_sse: set_of(raw.l("si_sb_sses_sse")),
        si_ves_ve_case: set_of(raw.l("si_sb_ves_ve_case")),
        si_ves_ve: set_of(raw.l("si_sb_ves_ve")),
        si_es_is: set_of(raw.l("si_sb_es_is")),
        prep_bs: bysize(prep_da),
        prep_da: set_of(prep_da),
        genders: set_of(raw.l("singular_pronoun_genders")),
        pron_acc_bs: bysize(keys_of(pron_acc)),
        pron_nom: map_of(pron_nom),
        pron_acc: map_of(pron_acc),
        si_pron_nom: si_pron_nom,
        si_pron_acc: si_pron_acc,
        si_pron_acc_bs: bysize(si_acc_keys),
        irregular_pres: map_of(raw.d("plverb_irregular_pres")),
        re_ambiguous_pres_keys: rx(f"^({enclose(alts(keys_of(ambiguous_pres)))})((\\s.*)?)$", i)?,
        ambiguous_pres: map_of(ambiguous_pres),
        irregular_non_pres: set_of(raw.l("plverb_irregular_non_pres")),
        v_oes_oe: set_of(raw.l("pl_v_oes_oe")),
        v_oes_oe_4: set_of(raw.l("pl_v_oes_oe_endings_size4")),
        v_oes_oe_5: set_of(raw.l("pl_v_oes_oe_endings_size5")),
        count_zero: set_of(raw.l("pl_count_zero")),
        count_one: set_of(raw.l("pl_count_one")),
        re_adj_special_keys: rx(f"^({enclose(alts(keys_of(adj_special)))})$", i)?,
        adj_special: map_of(adj_special),
        re_adj_poss_keys: rx(f"^({enclose(alts(keys_of(adj_poss)))})$", i)?,
        adj_poss: map_of(adj_poss),
        nth: nth,
        nth_suff: nth_suff,
        re_ordinal_suff: rx(f"({alts(keys_of(ordinal))})\\Z", 0)?,
        ordinal: map_of(ordinal),
        unit: raw.l("unit"),
        teen: raw.l("teen"),
        ten: raw.l("ten"),
        mill: raw.l("mill"),
        re_dollar_digits: rxs("\\$(\\d+)", 0)?,
        re_function_call: rxs("((\\w+)\\([^)]*\\)*)", i)?,
        re_partition_word: rxs("\\A(\\s*)(.+?)(\\s*)\\Z", 0)?,
        re_postfix_adj_stems: rx(f"^(?:{postfix_adj_stems})$", i)?,
        re_prep_dual_compound: rx(f"^(?:{prep_dual_compound})$", i)?,
        re_denominator: rxs("(?P<denominator>.+)( (per|a) .+)", 0)?,
        re_plverb_special_s: rx(f"^({plverb_special_s})$", 0)?,
        re_whitespace: rxs("\\s", 0)?,
        re_ends_with_s: rxs("^(.*[^s])s$", i)?,
        re_ends_with_apostrophe_s: rxs("^(.+)'s?$", 0)?,
        re_indefinite_article: rxs("\\A(\\s*)(?:an?\\s+)?(.+?)(\\s*)\\Z", i)?,
        re_ambiguous_non_pres: rxs("^((?:thought|saw|bent|will|might|cut))((\\s.*)?)$", i)?,
        indef_cases: indef,
        reg_plurals: reg_plurals,
        participle: participle,
        re_digit: rxs("\\d", 0)?,
        re_digit_group: rxs("(\\d)", 0)?,
        re_two_digits: rxs("(\\d)(\\d)", 0)?,
        re_three_digits: rxs("(\\d)(\\d)(\\d)", 0)?,
        re_three_digits_word: rxs("(\\d)(\\d)(\\d)(?=\\D*\\Z)", 0)?,
        re_two_digits_word: rxs("(\\d)(\\d)(?=\\D*\\Z)", 0)?,
        re_one_digit_word: rxs("(\\d)(?=\\D*\\Z)", 0)?,
        re_four_digit_comma: rxs("(\\d)(\\d{3}(?:,|\\Z))", 0)?,
        re_non_digit: rxs("\\D", 0)?,
        re_whitespaces_comma: rxs("\\s+,", 0)?,
        re_comma_word: rxs(", (\\S+)\\s+\\Z", 0)?,
        re_whitespaces: rxs("\\s+", 0)?,
    })
}

// ------------------------------------------------------------ values

// The Python values the jobs pass and the methods return. A float
// keeps the text Python's repr gives it.
#[derive(Clone)]
enum V {
    S(String),
    I(i64),
    F(String),
    B(bool),
    N,
    L(Vec[V]),
    T(Vec[V]),
}

fn v_of_json(j: ref J) -> V {
    match j {
        J.S(s) => V.S(s.clone()),
        J.N(t) => {
            if t.contains(".") or t.contains("e") or t.contains("E") {
                V.F(t.clone())
            } else {
                V.I(i64.parse(t).unwrap_or(0))
            }
        }
        J.F(f) => V.F(f"{f}"),
        J.B(b) => V.B(b),
        J.Null => V.N,
        J.A(items) => {
            let mut v: Vec[V] = Vec.new();
            for it in items.iter() {
                v.push(v_of_json(it));
            }
            V.L(v)
        }
        J.O(_) => V.N,
    }
}

fn v_repr(v: ref V) -> String {
    match v {
        V.S(s) => s_repr(s),
        V.I(n) => f"{n}",
        V.F(t) => t.clone(),
        V.B(b) => if b { "True".to_string() } else { "False".to_string() },
        V.N => "None".to_string(),
        V.L(items) => {
            let mut parts: Vec[String] = Vec.new();
            for it in items.iter() {
                parts.push(v_repr(it));
            }
            f"[{joined(parts, ", ".to_string())}]"
        }
        V.T(items) => {
            let mut parts: Vec[String] = Vec.new();
            for it in items.iter() {
                parts.push(v_repr(it));
            }
            if parts.len() == 1 {
                return f"({parts[0]},)";
            }
            f"({joined(parts, ", ".to_string())})"
        }
    }
}

// str(v)
fn v_str(v: ref V) -> String {
    match v {
        V.S(s) => s.clone(),
        _ => v_repr(v),
    }
}

fn v_type(v: ref V) -> Str {
    match v {
        V.S(_) => "str",
        V.I(_) => "int",
        V.F(_) => "float",
        V.B(_) => "bool",
        V.N => "NoneType",
        V.L(_) => "list",
        V.T(_) => "tuple",
    }
}

fn truthy(v: ref V) -> bool {
    match v {
        V.S(s) => s.len() > 0,
        V.I(n) => n != 0,
        V.F(t) => match f64.parse(t) {
            Ok(f) => f != 0.0,
            Err(_) => true,
        },
        V.B(b) => b,
        V.N => false,
        V.L(items) => items.len() > 0,
        V.T(items) => items.len() > 0,
    }
}

fn is_none(v: ref V) -> bool {
    match v {
        V.N => true,
        _ => false,
    }
}

fn py_mod(a: i64, b: i64) -> i64 {
    let r = a % b;
    if r != 0 and ((r < 0) != (b < 0)) { r + b } else { r }
}

fn is_ascii_digit_char(c: char) -> bool {
    c >= '0' and c <= '9'
}

// int(s) for a str, as far as the value mod 100: the sign, digits with
// single underscores between them, whitespace around.
fn py_int_mod100(s: ref String) -> Result[i64, PyErr] {
    let bad = py_err("ValueError", f"invalid literal for int() with base 10: {s_repr(s)}");
    let t = strip_ws(s);
    let cs: Vec[char] = t.chars().collect();
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    if i >= cs.len() {
        return Err(bad);
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < cs.len() {
        let c = cs[i];
        if is_ascii_digit_char(c) {
            v = (v * 10 + (c as i64 - 48)) % 100;
            prev_digit = true;
        } else if c == '_' and prev_digit and i + 1 < cs.len() and is_ascii_digit_char(cs[i + 1]) {
            prev_digit = false;
        } else {
            return Err(bad);
        }
        i += 1;
    }
    Ok(if neg { py_mod(-v, 100) } else { v })
}

// float(s) for a str.
fn py_float(s: ref String) -> Result[f64, PyErr] {
    let t = strip_ws(s);
    let mut plain = String.new();
    let cs: Vec[char] = t.chars().collect();
    let mut ok = cs.len() > 0;
    for k in 0..cs.len() {
        let c = cs[k];
        if c == '_' {
            if k == 0 or k + 1 >= cs.len() or not is_ascii_digit_char(cs[k - 1]) or not is_ascii_digit_char(cs[k + 1]) {
                ok = false;
            }
            continue;
        }
        if not (is_ascii_digit_char(c) or c == '.' or c == 'e' or c == 'E' or c == '+' or c == '-') {
            ok = false;
        }
        plain.push(c);
    }
    if ok {
        if let Ok(f) = f64.parse(plain) {
            return Ok(f);
        }
    }
    Err(py_err("ValueError", f"could not convert string to float: {s_repr(s)}"))
}

fn f64_of(v: ref V) -> f64 {
    match v {
        V.I(n) => n as f64,
        V.F(t) => f64.parse(t).unwrap_or(0.0),
        _ => 0.0,
    }
}

// ------------------------------------------------------------ engine

fn c_all() -> i64 { 0 }
fn c_zero() -> i64 { 1 }
fn c_herd() -> i64 { 2 }
fn c_names() -> i64 { 3 }
fn c_persons() -> i64 { 4 }
fn c_ancient() -> i64 { 5 }

fn classical_names() -> Vec[String] {
    vec!["all".to_string(), "zero".to_string(), "herd".to_string(), "names".to_string(), "persons".to_string(), "ancient".to_string()]
}

fn def_classical() -> Vec[bool] {
    vec![false, false, false, true, false, false]
}

fn all_classical() -> Vec[bool] {
    vec![true, true, true, true, true, true]
}

fn no_classical() -> Vec[bool] {
    vec![false, false, false, false, false, false]
}

struct Words {
    lowered: String,
    split_: Vec[String],
    first: String,
    last: String,
}

fn words_of(w: ref String) -> Result[Words, PyErr] {
    let split_ = split_ws(w);
    if split_.len() == 0 {
        return Err(index_error());
    }
    Ok(Words {
        lowered: lowr(w),
        first: split_[0].clone(),
        last: split_[split_.len() - 1].clone(),
        split_: split_,
    })
}

// What _plequal is handed as `pl`.
enum Norm {
    Plural,
    Noun,
    Verb,
    Adj,
}

struct Eng {
    classical: Vec[bool],
    persistent: Option[i64],
    mill_count: i64,
    ud_pl_sb: Vec[Option[String]],
    ud_pl_v: Vec[Option[String]],
    ud_pl_adj: Vec[Option[String]],
    ud_si_sb: Vec[Option[String]],
    ud_a: Vec[Option[String]],
    thegender: String,
    andword: String,
    zero: String,
    one: String,
}

fn new_eng() -> Eng {
    Eng {
        classical: def_classical(),
        persistent: None,
        mill_count: 0,
        ud_pl_sb: Vec.new(),
        ud_pl_v: Vec.new(),
        ud_pl_adj: Vec.new(),
        ud_si_sb: Vec.new(),
        ud_a: Vec.new(),
        thegender: "neuter".to_string(),
        andword: "and".to_string(),
        zero: "zero".to_string(),
        one: "one".to_string(),
    }
}

// A word in a user list: None is formatted into the pattern as "None".
fn ud_text(w: ref Option[String]) -> String {
    match w {
        Some(s) => s.clone(),
        None => "None".to_string(),
    }
}

fn sub_or_text(pick: ref Option[String], fallback: ref String) -> String {
    match pick {
        Some(s) => if s.len() > 0 { s.clone() } else { fallback.clone() },
        None => fallback.clone(),
    }
}

// x or y, where x is a str or False.
fn or_str(x: ref Option[String]) -> Option[String] {
    match x {
        Some(s) => if s.len() > 0 { Some(s.clone()) } else { None },
        None => None,
    }
}

fn opt_text(x: ref Option[String]) -> String {
    match x {
        Some(s) => s.clone(),
        None => "False".to_string(),
    }
}

impl Eng {
    fn cl(self, k: i64) -> bool {
        self.classical[k]
    }

    fn checkpat(self, pattern: ref Option[String]) -> Result[(), PyErr] {
        if let Some(p) = pattern {
            if let Err(_) = compile(cps_of(p), 0) {
                return Err(py_err("BadUserDefinedPatternError", p.clone()));
            }
        }
        Ok(())
    }

    fn ud_match(self, t: ref Tab, word: ref String, wordlist: ref Vec[Option[String]]) -> Result[Option[String], PyErr] {
        let mut i = wordlist.len() - 2;
        while i > -2 {
            let pat = f"^{ud_text(wordlist[i])}$";
            let prog = match compile(cps_of(pat), flag_i()) {
                Ok(p) => p,
                Err(e) => return Err(re_err(e)),
            };
            if let Some(mo) = search(prog, word) {
                let repl = match wordlist[i + 1].clone() {
                    Some(r) => r,
                    None => return Ok(None),
                };
                let (pl, _) = sub_tpl(t.re_dollar_digits, "\\\\1", repl, 0)?;
                let pieces = match parse_template(cps_of(pl), prog) {
                    Ok(p) => p,
                    Err(e) => return Err(re_err(e)),
                };
                let mut out: Vec[i64] = Vec.new();
                expand(pieces, mo.s, mo.f, mut out);
                return Ok(Some(to_string(out)));
            }
            i -= 2;
        }
        Ok(None)
    }

    fn get_count(self, t: ref Tab, count: ref V) -> i64 {
        let c = if is_none(count) {
            match self.persistent {
                Some(p) => V.I(p),
                None => V.N,
            }
        } else {
            count.clone()
        };
        if is_none(c) {
            return 0;
        }
        let s = v_str(c);
        if t.count_one.contains(s) or (self.cl(c_zero()) and t.count_zero.contains(lowr(s))) { 1 } else { 2 }
    }

    // ---------------------------------------------------- public words

    fn partition_word(self, t: ref Tab, text: ref String) -> (String, String, String) {
        match search(t.re_partition_word, text) {
            Some(mo) => (mo.g(1), mo.g(2), mo.g(3)),
            None => (String.new(), String.new(), String.new()),
        }
    }

    fn postprocess(self, orig: ref String, inflected: ref String) -> Result[String, PyErr] {
        let idx = if self.cl(c_all()) { 1 } else { 0 };
        let mut result: Vec[String] = Vec.new();
        if inflected.contains("|") {
            let opts = split_on(inflected, "|");
            if split_on(opts[0], " ").len() == split_on(opts[1], " ").len() {
                result = split_on(opts[idx], " ");
            } else {
                result = split_on(inflected, " ");
                for k in 0..result.len() {
                    if result[k].contains("|") {
                        result[k] = split_on(result[k], "|")[idx].clone();
                    }
                }
            }
        } else {
            result = split_on(inflected, " ");
        }
        let ws = split_on(orig, " ");
        for index in 0..ws.len() {
            let w = ws[index].clone();
            if w == "I" {
                continue;
            }
            if capz(w) == w {
                let r = pick(result, index)?;
                result[index] = capz(r);
            }
            if w == uppr(w) {
                let r = pick(result, index)?;
                result[index] = uppr(r);
            }
        }
        Ok(joined(result, " ".to_string()))
    }

    fn plural(mut ref self, t: ref Tab, text: ref String, count: ref V) -> Result[String, PyErr] {
        let (pre, word, post) = self.partition_word(t, text);
        if word.len() == 0 {
            return Ok(text.clone());
        }
        let mut inflected = or_str(self.pl_special_adjective(t, word, count)?);
        if inflected.is_none() {
            inflected = or_str(self.pl_special_verb(t, word, count)?);
        }
        let chosen = match inflected {
            Some(s) => s,
            None => self.plnoun(t, word, count)?,
        };
        let plural = self.postprocess(word, chosen)?;
        Ok(f"{pre}{plural}{post}")
    }

    fn plural_noun(mut ref self, t: ref Tab, text: ref String, count: ref V) -> Result[String, PyErr] {
        let (pre, word, post) = self.partition_word(t, text);
        if word.len() == 0 {
            return Ok(text.clone());
        }
        let n = self.plnoun(t, word, count)?;
        let plural = self.postprocess(word, n)?;
        Ok(f"{pre}{plural}{post}")
    }

    fn plural_verb(mut ref self, t: ref Tab, text: ref String, count: ref V) -> Result[String, PyErr] {
        let (pre, word, post) = self.partition_word(t, text);
        if word.len() == 0 {
            return Ok(text.clone());
        }
        let chosen = match or_str(self.pl_special_verb(t, word, count)?) {
            Some(s) => s,
            None => self.pl_general_verb(t, word, count)?,
        };
        let plural = self.postprocess(word, chosen)?;
        Ok(f"{pre}{plural}{post}")
    }

    fn plural_adj(mut ref self, t: ref Tab, text: ref String, count: ref V) -> Result[String, PyErr] {
        let (pre, word, post) = self.partition_word(t, text);
        if word.len() == 0 {
            return Ok(text.clone());
        }
        let chosen = match or_str(self.pl_special_adjective(t, word, count)?) {
            Some(s) => s,
            None => word.clone(),
        };
        let plural = self.postprocess(word, chosen)?;
        Ok(f"{pre}{plural}{post}")
    }

    fn norm(mut ref self, t: ref Tab, pl: ref Norm, w: ref String) -> Result[String, PyErr] {
        match pl {
            Norm.Plural => self.plural(t, w, V.N),
            Norm.Noun => self.plural_noun(t, w, V.N),
            Norm.Verb => self.plural_verb(t, w, V.N),
            Norm.Adj => self.plural_adj(t, w, V.N),
        }
    }

    fn compare(mut ref self, t: ref Tab, w1: ref String, w2: ref String) -> Result[Option[String], PyErr] {
        for pl in vec![Norm.Noun, Norm.Verb, Norm.Adj].iter() {
            if let Some(r) = self.plequal(t, w1, w2, pl)? {
                return Ok(Some(r));
            }
        }
        Ok(None)
    }

    fn singular_noun(mut ref self, t: ref Tab, text: ref String, count: ref V, gender: ref Option[String]) -> Result[Option[String], PyErr] {
        let (pre, word, post) = self.partition_word(t, text);
        if word.len() == 0 {
            return Ok(Some(text.clone()));
        }
        match self.sinoun(t, word, count, gender)? {
            Some(sing) => {
                let plural = self.postprocess(word, sing)?;
                Ok(Some(f"{pre}{plural}{post}"))
            }
            None => Ok(None),
        }
    }

    fn plequal(mut ref self, t: ref Tab, w1: ref String, w2: ref String, pl: ref Norm) -> Result[Option[String], PyErr] {
        let classval = self.classical.clone();
        for cd in vec![all_classical(), no_classical()].iter() {
            self.classical = cd.clone();
            if w1 == w2 {
                return Ok(Some("eq".to_string()));
            }
            if *w1 == self.norm(t, pl, w2)? {
                return Ok(Some("p:s".to_string()));
            }
            if self.norm(t, pl, w1)? == *w2 {
                return Ok(Some("s:p".to_string()));
            }
        }
        self.classical = classval;
        let is_noun = match pl {
            Norm.Plural => true,
            Norm.Noun => true,
            _ => false,
        };
        let is_adj = match pl {
            Norm.Plural => true,
            Norm.Adj => true,
            _ => false,
        };
        if is_noun {
            if self.check_plurals_n(t, w1, w2)? {
                return Ok(Some("p:p".to_string()));
            }
            if self.check_plurals_n(t, w2, w1)? {
                return Ok(Some("p:p".to_string()));
            }
        }
        if is_adj {
            if self.check_plurals_adj(t, w1, w2)? {
                return Ok(Some("p:p".to_string()));
            }
        }
        Ok(None)
    }

    fn check_plurals_n(self, t: ref Tab, w1: ref String, w2: ref String) -> Result[bool, PyErr] {
        let a = words_of(w1)?;
        let b = words_of(w2)?;
        let pair = f"{a.last}|{b.last}";
        if t.irregular_s_values.contains(pair) or t.irregular_values.contains(pair) or t.irregular_caps_values.contains(pair) {
            return Ok(true);
        }
        for prog in t.reg_plurals.iter() {
            if hits(prog, pair) {
                return Ok(true);
            }
        }
        Ok(false)
    }

    fn check_plurals_adj(self, t: ref Tab, w1: ref String, w2: ref String) -> Result[bool, PyErr] {
        let a = possessive_stem(w1);
        let b = possessive_stem(w2);
        Ok(a.len() > 0 and b.len() > 0 and (self.check_plurals_n(t, a, b)? or self.check_plurals_n(t, b, a)?))
    }

    // ------------------------------------------------------- nouns

    fn handle_long_compounds(mut ref self, t: ref Tab, word: ref Words, count: i64) -> Result[Option[String], PyErr] {
        let sp = word.split_.clone();
        let mut i = 0;
        while i + 2 <= sp.len() {
            let cand = sp[i].clone();
            let prep = sp[i + 1].clone();
            if t.prep_da.contains(prep) {
                let infl = if count == 1 {
                    match self.sinoun(t, cand, V.I(count), None)? {
                        Some(s) => s,
                        None => {
                            return Err(py_err("TypeError", f"sequence item {i}: expected str instance, bool found"));
                        }
                    }
                } else {
                    self.plnoun(t, cand, V.I(count))?
                };
                let mut parts: Vec[String] = Vec.new();
                for k in 0..i {
                    parts.push(sp[k].clone());
                }
                parts.push(infl);
                parts.push(prep);
                for k in i + 2..sp.len() {
                    parts.push(sp[k].clone());
                }
                return Ok(Some(joined(parts, " ".to_string())));
            }
            i += 1;
        }
        Ok(None)
    }

    // _handle_prepositional_phrase: None where it raises ValueError.
    // kind 0 is _plnoun(count=2), 1 is _sinoun(count=1, gender).
    fn prepositional(mut ref self, t: ref Tab, phrase: ref String, kind: i64, gender: ref Option[String], sep: Str) -> Result[Option[String], PyErr] {
        let parts = split_on(phrase, sep);
        if parts.len() < 3 {
            return Ok(None);
        }
        let mut pivot = -1;
        let mut k = 1;
        while k < parts.len() - 1 {
            if t.prep_da.contains(parts[k]) {
                pivot = k;
                break;
            }
            k += 1;
        }
        if pivot < 0 {
            return Ok(None);
        }
        let before = parts[pivot - 1].clone();
        let got = if kind == 0 {
            Some(self.plnoun(t, before, V.I(2))?)
        } else {
            self.sinoun(t, before, V.I(1), gender)?
        };
        let transformed = sub_or_text(got, before);
        let mut head: Vec[String] = Vec.new();
        for j in 0..pivot - 1 {
            head.push(parts[j].clone());
        }
        head.push(f"{transformed}{sep}{parts[pivot]}{sep}");
        let mut tail: Vec[String] = Vec.new();
        for j in pivot + 1..parts.len() {
            tail.push(parts[j].clone());
        }
        Ok(Some(f"{joined(head, " ".to_string())}{joined(tail, " ".to_string())}"))
    }

    fn plnoun(mut ref self, t: ref Tab, word0: ref String, count0: ref V) -> Result[String, PyErr] {
        let count = self.get_count(t, count0);
        if count == 1 {
            return Ok(word0.clone());
        }
        let ud = self.ud_pl_sb.clone();
        if let Some(v) = self.ud_match(t, word0, ud)? {
            return Ok(v);
        }
        if word0.len() == 0 {
            return Ok(word0.clone());
        }
        let word = word0.clone();
        let w = words_of(word)?;
        let lw = w.lowered.clone();
        if t.uninflected_complete.contains(lowr(w.last)) {
            if w.split_.len() >= 3 {
                return Ok(sub_or_text(self.handle_long_compounds(t, w, 2)?, word));
            }
            return Ok(word);
        }
        if t.uninflected_caps.contains(word) {
            return Ok(word);
        }
        if t.uninflected_bs.ends(lw) {
            return Ok(word);
        }
        if self.cl(c_herd()) and t.uninflected_herd.contains(lowr(w.last)) {
            return Ok(word);
        }

        // compounds
        if let Some(mo) = search(t.re_postfix_adj_stems, word) {
            if mo.g(2) != "" {
                return Ok(f"{self.plnoun(t, mo.g(1), V.I(2))?}{mo.g(2)}");
            }
        }
        if lw.contains(" a ") or lw.contains("-a-") {
            if let Some(mo) = search(t.re_prep_dual_compound, word) {
                if mo.g(2) != "" and mo.g(3) != "" {
                    let a = self.plnoun(t, mo.g(1), V.I(2))?;
                    let b = self.plnoun(t, mo.g(3), V.N)?;
                    return Ok(f"{a}{mo.g(2)}{b}");
                }
            }
        }
        if w.split_.len() >= 3 {
            if let Some(h) = self.handle_long_compounds(t, w, 2)? {
                return Ok(h);
            }
        }
        if let Some(mo) = search(t.re_denominator, lw) {
            let index = clen(mo.g(1));
            let a = self.plnoun(t, pys(word, 0, index), V.N)?;
            return Ok(f"{a}{pys(word, index, big())}");
        }
        if w.split_.len() >= 2 and w.split_[w.split_.len() - 2] == "degree" {
            let mut parts: Vec[String] = Vec.new();
            parts.push(self.plnoun(t, w.first, V.N)?);
            for k in 1..w.split_.len() {
                parts.push(w.split_[k].clone());
            }
            return Ok(joined(parts, " ".to_string()));
        }
        if let Some(r) = self.prepositional(t, lw, 0, None, "-")? {
            return Ok(r);
        }

        // pronouns
        for k in t.pron_acc_bs.keys.iter() {
            let tl = sfx(lw, *k);
            if t.pron_acc_bs.sets.get(*k).unwrap().contains(tl) {
                for pk in t.prep_bs.keys.iter() {
                    let hd = pys(lw, 0, *pk);
                    if t.prep_bs.sets.get(*pk).unwrap().contains(hd) {
                        let sp = split_ws(lw);
                        if sp.len() == 2 and sp[0] == hd and sp[1] == tl {
                            return Ok(f"{cut(lw, *k)}{t.pron_acc.get(tl).unwrap()}");
                        }
                    }
                }
            }
        }
        if let Some(v) = t.pron_nom.get(lw) {
            return Ok(v.clone());
        }
        if let Some(v) = t.pron_acc.get(lw) {
            return Ok(v.clone());
        }

        // isolated irregular plurals
        if let Some(v) = t.irregular_caps.get(w.last) {
            return Ok(f"{cut(word, clen(w.last))}{v}");
        }
        let lowered_last = lowr(w.last);
        if let Some(v) = t.irregular.get(lowered_last) {
            return Ok(f"{cut(word, clen(lowered_last))}{v}");
        }
        let dash_split = split_on(lw, "-");
        let key = lowr(last_two_joined(dash_split));
        if let Some(v) = t.irregular_compound.get(key) {
            return Ok(f"{cut(word, clen(last_two_joined(dash_split)))}{v}");
        }
        if sfx(lw, 3) == "quy" {
            return Ok(f"{cut(word, 1)}ies");
        }
        if sfx(lw, 6) == "person" {
            if self.cl(c_persons()) {
                return Ok(f"{word}s");
            }
            return Ok(f"{cut(word, 4)}ople");
        }

        // families of irregular plurals
        if sfx(lw, 3) == "man" {
            if t.u_man_mans.pl_bs.ends(lw) {
                return Ok(f"{word}s");
            }
            if t.u_man_mans_caps.pl_bs.ends(word) {
                return Ok(f"{word}s");
            }
            return Ok(f"{cut(word, 3)}men");
        }
        if sfx(lw, 5) == "mouse" {
            return Ok(f"{cut(word, 5)}mice");
        }
        if sfx(lw, 5) == "louse" {
            if t.u_louse_lice.pl_bs.at_len_has(clen(word), lw) {
                return Ok(f"{cut(word, 5)}lice");
            }
            return Ok(f"{word}s");
        }
        if sfx(lw, 5) == "goose" {
            return Ok(f"{cut(word, 5)}geese");
        }
        if sfx(lw, 5) == "tooth" {
            return Ok(f"{cut(word, 5)}teeth");
        }
        if sfx(lw, 4) == "foot" {
            return Ok(f"{cut(word, 4)}feet");
        }
        if sfx(lw, 4) == "taco" {
            return Ok(f"{cut(word, 5)}tacos");
        }
        if lw == "die" {
            return Ok("dice".to_string());
        }

        // unassimilated imports
        if sfx(lw, 4) == "ceps" {
            return Ok(word);
        }
        if sfx(lw, 4) == "zoon" {
            return Ok(f"{cut(word, 2)}a");
        }
        let l3 = sfx(lw, 3);
        if l3 == "cis" or l3 == "sis" or l3 == "xis" {
            return Ok(f"{cut(word, 2)}es");
        }
        let last_let = sfx(lw, 1);
        if let Some(r) = fam(word, lw, last_let, "h", t.u_ch_chs.pl_bs, 0, "s") {
            return Ok(r);
        }
        if let Some(r) = fam(word, lw, last_let, "x", t.u_ex_ices.pl_bs, 2, "ices") {
            return Ok(r);
        }
        if let Some(r) = fam(word, lw, last_let, "x", t.u_ix_ices.pl_bs, 2, "ices") {
            return Ok(r);
        }
        if let Some(r) = fam(word, lw, last_let, "m", t.u_um_a.pl_bs, 2, "a") {
            return Ok(r);
        }
        if let Some(r) = fam(word, lw, last_let, "s", t.u_us_i.pl_bs, 2, "i") {
            return Ok(r);
        }
        if let Some(r) = fam(word, lw, last_let, "n", t.u_on_a.pl_bs, 2, "a") {
            return Ok(r);
        }
        if let Some(r) = fam(word, lw, last_let, "a", t.u_a_ae.pl_bs, 0, "e") {
            return Ok(r);
        }

        // incompletely assimilated imports
        if self.cl(c_ancient()) {
            if sfx(lw, 4) == "trix" {
                return Ok(f"{cut(word, 1)}ces");
            }
            if l3 == "eau" or l3 == "ieu" {
                return Ok(f"{word}x");
            }
            if (l3 == "ynx" or l3 == "inx" or l3 == "anx") and clen(word) > 4 {
                return Ok(f"{cut(word, 1)}ges");
            }
            if let Some(r) = fam(word, lw, last_let, "n", t.c_en_ina.pl_bs, 2, "ina") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "x", t.c_ex_ices.pl_bs, 2, "ices") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "x", t.c_ix_ices.pl_bs, 2, "ices") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "m", t.c_um_a.pl_bs, 2, "a") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "s", t.c_us_i.pl_bs, 2, "i") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "s", t.c_us_us_bs, 0, "") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "a", t.c_a_ae.pl_bs, 0, "e") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "a", t.c_a_ata.pl_bs, 0, "ta") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "s", t.c_is_ides.pl_bs, 1, "des") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "o", t.c_o_i_bs, 1, "i") {
                return Ok(r);
            }
            if let Some(r) = fam(word, lw, last_let, "n", t.c_on_a.pl_bs, 2, "a") {
                return Ok(r);
            }
            if t.c_i.pl_bs.ends(lw) {
                return Ok(f"{word}i");
            }
            if t.c_im.pl_bs.ends(lw) {
                return Ok(f"{word}im");
            }
        }

        // singular nouns ending in ...s or other silibants
        if t.singular_s_complete.contains(lowered_last) {
            return Ok(f"{word}es");
        }
        if t.singular_s_bs.ends(lw) {
            return Ok(f"{word}es");
        }
        let f0 = first_char(word);
        if sfx(lw, 2) == "es" and f0 == uppr(f0) {
            return Ok(f"{word}es");
        }
        if last_let == "z" {
            if t.z_zes.ends(lw) {
                return Ok(f"{word}es");
            }
            if pys(lw, -2, -1) != "z" {
                return Ok(f"{word}zes");
            }
        }
        if sfx(lw, 2) == "ze" {
            if t.ze_zes.ends(lw) {
                return Ok(f"{word}s");
            }
        }
        let l2 = sfx(lw, 2);
        if l2 == "ch" or l2 == "sh" or l2 == "zz" or l2 == "ss" or last_let == "x" {
            return Ok(f"{word}es");
        }

        // ...f -> ...ves
        if l3 == "elf" or l3 == "alf" or l3 == "olf" {
            return Ok(f"{cut(word, 1)}ves");
        }
        if l3 == "eaf" and pys(lw, -4, -3) != "d" {
            return Ok(f"{cut(word, 1)}ves");
        }
        let l4 = sfx(lw, 4);
        if l4 == "nife" or l4 == "life" or l4 == "wife" {
            return Ok(f"{cut(word, 2)}ves");
        }
        if l3 == "arf" {
            return Ok(f"{cut(word, 1)}ves");
        }

        // ...y
        if last_let == "y" {
            if "aeiou".contains(pys(lw, -2, -1)) or clen(word) == 1 {
                return Ok(f"{word}s");
            }
            if self.cl(c_names()) {
                if f0 == uppr(f0) {
                    return Ok(f"{word}s");
                }
            }
            return Ok(f"{cut(word, 1)}ies");
        }

        // ...o
        if t.u_o_os_complete.contains(lowered_last) {
            return Ok(f"{word}s");
        }
        if t.u_o_os_bs.ends(lw) {
            return Ok(f"{word}s");
        }
        if l2 == "ao" or l2 == "eo" or l2 == "io" or l2 == "oo" or l2 == "uo" {
            return Ok(f"{word}s");
        }
        if last_let == "o" {
            return Ok(f"{word}es");
        }
        Ok(f"{word}s")
    }

    // ------------------------------------------------------- verbs

    fn pl_special_verb(mut ref self, t: ref Tab, word: ref String, count0: ref V) -> Result[Option[String], PyErr] {
        if self.cl(c_zero()) and t.count_zero.contains(lowr(v_str(count0))) {
            return Ok(None);
        }
        let count = self.get_count(t, count0);
        if count == 1 {
            return Ok(Some(word.clone()));
        }
        let ud = self.ud_pl_v.clone();
        if let Some(v) = self.ud_match(t, word, ud)? {
            return Ok(Some(v));
        }
        let w = match words_of(word) {
            Ok(w) => w,
            Err(_) => return Ok(None),
        };
        let flen = clen(w.first);
        if let Some(v) = t.irregular_pres.get(w.first) {
            return Ok(Some(f"{v}{pys(word, flen, big())}"));
        }
        if t.irregular_non_pres.contains(w.first) {
            return Ok(Some(word.clone()));
        }
        if w.first.ends_with("n't") {
            if let Some(v) = t.irregular_pres.get(cut(w.first, 3)) {
                return Ok(Some(f"{v}n't{pys(word, flen, big())}"));
            }
            return Ok(Some(word.clone()));
        }
        if hits(t.re_plverb_special_s, word) {
            return Ok(None);
        }
        if hits(t.re_whitespace, word) {
            return Ok(None);
        }
        let lw = w.lowered.clone();
        if lw == "quizzes" {
            return Ok(Some("quiz".to_string()));
        }
        let l4 = sfx(lw, 4);
        if l4 == "ches" or l4 == "shes" or l4 == "zzes" or l4 == "sses" or sfx(lw, 3) == "xes" {
            return Ok(Some(cut(word, 2)));
        }
        if sfx(lw, 3) == "ies" and clen(word) > 3 {
            return Ok(Some(f"{cut(lw, 3)}y"));
        }
        if t.v_oes_oe.contains(lowr(w.last)) or t.v_oes_oe_4.contains(l4) or t.v_oes_oe_5.contains(sfx(lw, 5)) {
            return Ok(Some(cut(word, 1)));
        }
        if lw.ends_with("oes") and clen(word) > 3 {
            return Ok(Some(cut(lw, 2)));
        }
        if let Some(mo) = search(t.re_ends_with_s, word) {
            return Ok(Some(mo.g(1)));
        }
        Ok(None)
    }

    fn pl_general_verb(self, t: ref Tab, word: ref String, count0: ref V) -> Result[String, PyErr] {
        let count = self.get_count(t, count0);
        if count == 1 {
            return Ok(word.clone());
        }
        if let Some(mo) = search(t.re_ambiguous_pres_keys, word) {
            return Ok(f"{t.ambiguous_pres.get(lowr(mo.g(1))).unwrap()}{mo.g(2)}");
        }
        Ok(word.clone())
    }

    fn pl_special_adjective(mut ref self, t: ref Tab, word: ref String, count0: ref V) -> Result[Option[String], PyErr] {
        let count = self.get_count(t, count0);
        if count == 1 {
            return Ok(Some(word.clone()));
        }
        let ud = self.ud_pl_adj.clone();
        if let Some(v) = self.ud_match(t, word, ud)? {
            return Ok(Some(v));
        }
        if let Some(mo) = search(t.re_adj_special_keys, word) {
            return Ok(Some(t.adj_special.get(lowr(mo.g(1))).unwrap().clone()));
        }
        if let Some(mo) = search(t.re_adj_poss_keys, word) {
            return Ok(Some(t.adj_poss.get(lowr(mo.g(1))).unwrap().clone()));
        }
        if let Some(mo) = search(t.re_ends_with_apostrophe_s, word) {
            let pl = self.plural_noun(t, mo.g(1), V.N)?;
            if pl.len() == 0 {
                return Err(py_err("IndexError", "string index out of range".to_string()));
            }
            let trailing = if sfx(pl, 1) == "s" { "" } else { "s" };
            return Ok(Some(f"{pl}'{trailing}"));
        }
        Ok(None)
    }

    // ------------------------------------------------------ singular

    fn si_pron(self, t: ref Tab, acc: bool, word: ref String, gender: ref String) -> Option[String] {
        let found = if acc { t.si_pron_acc.get(word) } else { t.si_pron_nom.get(word) };
        match found {
            Some(SiPron.One(s)) => Some(s.clone()),
            Some(SiPron.ByGender(v)) => {
                for (g, s) in v.iter() {
                    if g == gender {
                        return Some(s.clone());
                    }
                }
                None
            }
            None => None,
        }
    }

    fn sinoun(mut ref self, t: ref Tab, word0: ref String, count0: ref V, gender0: ref Option[String]) -> Result[Option[String], PyErr] {
        let count = self.get_count(t, count0);
        if count == 2 {
            return Ok(Some(word0.clone()));
        }
        let gender = match gender0 {
            None => self.thegender.clone(),
            Some(g) => {
                if not t.genders.contains(g) {
                    return Err(py_err("BadGenderError", String.new()));
                }
                g.clone()
            }
        };
        let gsome = Some(gender.clone());
        let ud = self.ud_si_sb.clone();
        if let Some(v) = self.ud_match(t, word0, ud)? {
            return Ok(Some(v));
        }
        if word0.len() == 0 {
            return Ok(Some(word0.clone()));
        }
        let word = word0.clone();
        if t.si_ois_oi_case.contains(word) {
            return Ok(Some(cut(word, 1)));
        }
        let w = words_of(word)?;
        let lw = w.lowered.clone();
        let ll = lowr(w.last);
        if t.uninflected_complete.contains(ll) {
            if w.split_.len() >= 3 {
                return Ok(Some(sub_or_text(self.handle_long_compounds(t, w, 1)?, word)));
            }
            return Ok(Some(word));
        }
        if t.uninflected_caps.contains(word) {
            return Ok(Some(word));
        }
        if t.uninflected_bs.ends(lw) {
            return Ok(Some(word));
        }
        if self.cl(c_herd()) and t.uninflected_herd.contains(ll) {
            return Ok(Some(word));
        }
        if t.c_us_us.contains(ll) {
            return Ok(if self.cl(c_ancient()) { Some(word) } else { None });
        }

        // compounds
        if let Some(mo) = search(t.re_postfix_adj_stems, word) {
            if mo.g(2) != "" {
                let s = self.sinoun(t, mo.g(1), V.I(1), gsome)?;
                return Ok(Some(f"{opt_text(s)}{mo.g(2)}"));
            }
        }
        if let Some(r) = self.prepositional(t, lw, 1, gsome, " ")? {
            return Ok(Some(r));
        }
        if let Some(r) = self.prepositional(t, lw, 1, gsome, "-")? {
            return Ok(Some(r));
        }

        // pronouns
        for k in t.si_pron_acc_bs.keys.iter() {
            let tl = sfx(lw, *k);
            if t.si_pron_acc_bs.sets.get(*k).unwrap().contains(tl) {
                for pk in t.prep_bs.keys.iter() {
                    let hd = pys(lw, 0, *pk);
                    if t.prep_bs.sets.get(*pk).unwrap().contains(hd) {
                        let sp = split_ws(lw);
                        if sp.len() == 2 and sp[0] == hd and sp[1] == tl {
                            if let Some(s) = self.si_pron(t, true, tl, gender) {
                                return Ok(Some(f"{cut(lw, *k)}{s}"));
                            }
                            return Err(py_err("KeyError", s_repr(gender)));
                        }
                    }
                }
            }
        }
        if let Some(s) = self.si_pron(t, false, lw, gender) {
            return Ok(Some(s));
        }
        if let Some(s) = self.si_pron(t, true, lw, gender) {
            return Ok(Some(s));
        }

        // isolated irregular plurals
        if let Some(v) = t.si_irregular_caps.get(w.last) {
            return Ok(Some(f"{cut(word, clen(w.last))}{v}"));
        }
        if let Some(v) = t.si_irregular.get(ll) {
            return Ok(Some(f"{cut(word, clen(ll))}{v}"));
        }
        let dash_split = split_on(lw, "-");
        let key = lowr(last_two_joined(dash_split));
        if let Some(v) = t.si_irregular_compound.get(key) {
            return Ok(Some(f"{cut(word, clen(last_two_joined(dash_split)))}{v}"));
        }
        if sfx(lw, 5) == "quies" {
            return Ok(Some(f"{cut(word, 3)}y"));
        }
        if sfx(lw, 7) == "persons" {
            return Ok(Some(cut(word, 1)));
        }
        if sfx(lw, 6) == "people" {
            return Ok(Some(f"{cut(word, 4)}rson"));
        }

        // families of irregular plurals
        if sfx(lw, 4) == "mans" {
            if t.u_man_mans.si_bs.ends(lw) {
                return Ok(Some(cut(word, 1)));
            }
            if t.u_man_mans_caps.si_bs.ends(word) {
                return Ok(Some(cut(word, 1)));
            }
        }
        if sfx(lw, 3) == "men" {
            return Ok(Some(f"{cut(word, 3)}man"));
        }
        if sfx(lw, 4) == "mice" {
            return Ok(Some(f"{cut(word, 4)}mouse"));
        }
        if sfx(lw, 4) == "lice" {
            if t.u_louse_lice.si_bs.at_len_has(clen(word), lw) {
                return Ok(Some(f"{cut(word, 4)}louse"));
            }
        }
        if sfx(lw, 5) == "geese" {
            return Ok(Some(f"{cut(word, 5)}goose"));
        }
        if sfx(lw, 5) == "teeth" {
            return Ok(Some(f"{cut(word, 5)}tooth"));
        }
        if sfx(lw, 4) == "feet" {
            return Ok(Some(f"{cut(word, 4)}foot"));
        }
        if lw == "dice" {
            return Ok(Some("die".to_string()));
        }

        // unassimilated imports
        if sfx(lw, 4) == "ceps" {
            return Ok(Some(word));
        }
        if sfx(lw, 3) == "zoa" {
            return Ok(Some(f"{cut(word, 1)}on"));
        }
        let last_let = sfx(lw, 1);
        if let Some(r) = fam(word, lw, last_let, "s", t.u_ch_chs.si_bs, 1, "") {
            return Ok(Some(r));
        }
        if let Some(r) = fam(word, lw, last_let, "s", t.u_ex_ices.si_bs, 4, "ex") {
            return Ok(Some(r));
        }
        if let Some(r) = fam(word, lw, last_let, "s", t.u_ix_ices.si_bs, 4, "ix") {
            return Ok(Some(r));
        }
        if let Some(r) = fam(word, lw, last_let, "a", t.u_um_a.si_bs, 1, "um") {
            return Ok(Some(r));
        }
        if let Some(r) = fam(word, lw, last_let, "i", t.u_us_i.si_bs, 1, "us") {
            return Ok(Some(r));
        }
        if let Some(r) = fam(word, lw, last_let, "a", t.u_on_a.si_bs, 1, "on") {
            return Ok(Some(r));
        }
        if let Some(r) = fam(word, lw, last_let, "e", t.u_a_ae.si_bs, 1, "") {
            return Ok(Some(r));
        }

        // incompletely assimilated imports
        if self.cl(c_ancient()) {
            if sfx(lw, 6) == "trices" {
                return Ok(Some(f"{cut(word, 3)}x"));
            }
            let l4 = sfx(lw, 4);
            if l4 == "eaux" or l4 == "ieux" {
                return Ok(Some(cut(word, 1)));
            }
            let l5 = sfx(lw, 5);
            if (l5 == "ynges" or l5 == "inges" or l5 == "anges") and clen(word) > 6 {
                return Ok(Some(f"{cut(word, 3)}x"));
            }
            if let Some(r) = fam(word, lw, last_let, "a", t.c_en_ina.si_bs, 3, "en") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "s", t.c_ex_ices.si_bs, 4, "ex") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "s", t.c_ix_ices.si_bs, 4, "ix") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "a", t.c_um_a.si_bs, 1, "um") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "i", t.c_us_i.si_bs, 1, "us") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "s", t.c_us_us_bs, 0, "") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "e", t.c_a_ae.si_bs, 1, "") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "a", t.c_a_ata.si_bs, 2, "") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "s", t.c_is_ides.si_bs, 3, "s") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "i", t.si_c_o_i_bs, 1, "o") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "a", t.c_on_a.si_bs, 1, "on") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "m", t.c_im.si_bs, 2, "") {
                return Ok(Some(r));
            }
            if let Some(r) = fam(word, lw, last_let, "i", t.c_i.si_bs, 1, "") {
                return Ok(Some(r));
            }
        }

        // ...uses -> use
        if sfx(lw, 6) == "houses" or t.si_uses_use_case.contains(word) or t.si_uses_use.contains(ll) {
            return Ok(Some(cut(word, 1)));
        }
        // ...ies -> ie
        if t.si_ies_ie_case.contains(word) or t.si_ies_ie.contains(ll) {
            return Ok(Some(cut(word, 1)));
        }
        // ...oes -> oe
        if sfx(lw, 5) == "shoes" or t.si_oes_oe_case.contains(word) or t.si_oes_oe.contains(ll) {
            return Ok(Some(cut(word, 1)));
        }
        // ...s and other silibants
        if t.si_sses_sse_case.contains(word) or t.si_sses_sse.contains(ll) {
            return Ok(Some(cut(word, 1)));
        }
        if t.si_singular_s_complete.contains(ll) {
            return Ok(Some(cut(word, 2)));
        }
        if t.si_singular_s_bs.ends(lw) {
            return Ok(Some(cut(word, 2)));
        }
        let f0 = first_char(word);
        if sfx(lw, 4) == "eses" and f0 == uppr(f0) {
            return Ok(Some(cut(word, 2)));
        }
        if t.si_z_zes.contains(ll) {
            return Ok(Some(cut(word, 2)));
        }
        if t.si_zzes_zz.contains(ll) {
            return Ok(Some(cut(word, 2)));
        }
        if sfx(lw, 4) == "zzes" {
            return Ok(Some(cut(word, 3)));
        }
        if t.si_ches_che_case.contains(word) or t.si_ches_che.contains(ll) {
            return Ok(Some(cut(word, 1)));
        }
        let l4 = sfx(lw, 4);
        if l4 == "ches" or l4 == "shes" {
            return Ok(Some(cut(word, 2)));
        }
        if t.si_xes_xe.contains(ll) {
            return Ok(Some(cut(word, 1)));
        }
        if sfx(lw, 3) == "xes" {
            return Ok(Some(cut(word, 2)));
        }
        // ...ves -> ...f
        if t.si_ves_ve_case.contains(word) or t.si_ves_ve.contains(ll) {
            return Ok(Some(cut(word, 1)));
        }
        if sfx(lw, 3) == "ves" {
            let mid = pys(lw, -5, -3);
            if mid == "el" or mid == "al" or mid == "ol" {
                return Ok(Some(f"{cut(word, 3)}f"));
            }
            if mid == "ea" and pys(word, -6, -5) != "d" {
                return Ok(Some(f"{cut(word, 3)}f"));
            }
            if mid == "ni" or mid == "li" or mid == "wi" {
                return Ok(Some(f"{cut(word, 3)}fe"));
            }
            if mid == "ar" {
                return Ok(Some(f"{cut(word, 3)}f"));
            }
        }
        // ...y
        if sfx(lw, 2) == "ys" {
            if clen(lw) > 2 and "aeiou".contains(pys(lw, -3, -2)) {
                return Ok(Some(cut(word, 1)));
            }
            if self.cl(c_names()) {
                if f0 == uppr(f0) {
                    return Ok(Some(cut(word, 1)));
                }
            }
        }
        if sfx(lw, 3) == "ies" {
            return Ok(Some(f"{cut(word, 3)}y"));
        }
        // ...o
        if sfx(lw, 2) == "os" {
            if t.si_u_o_os_complete.contains(ll) {
                return Ok(Some(cut(word, 1)));
            }
            if t.si_u_o_os_bs.ends(lw) {
                return Ok(Some(cut(word, 1)));
            }
            let l3 = sfx(lw, 3);
            if l3 == "aos" or l3 == "eos" or l3 == "ios" or l3 == "oos" or l3 == "uos" {
                return Ok(Some(cut(word, 1)));
            }
        }
        if sfx(lw, 3) == "oes" {
            return Ok(Some(cut(word, 2)));
        }
        if t.si_es_is.contains(word) {
            return Ok(Some(f"{cut(word, 2)}is"));
        }
        if last_let == "s" {
            return Ok(Some(cut(word, 1)));
        }
        Ok(None)
    }
}

// word[:-n], or the whole word for None (0).
fn cut_or_all(w: ref String, n: i64) -> String {
    if n == 0 { w.clone() } else { cut(w, n) }
}

// " ".join(parts[-2:])
fn last_two_joined(parts: ref Vec[String]) -> String {
    let mut v: Vec[String] = Vec.new();
    let start = if parts.len() >= 2 { parts.len() - 2 } else { 0 };
    for k in start..parts.len() {
        v.push(parts[k].clone());
    }
    joined(v, " ".to_string())
}

// word[: word.rfind("'")] if word.endswith(("'s", "'")) else ""
fn possessive_stem(w: ref String) -> String {
    if not (w.ends_with("'s") or w.ends_with("'")) {
        return String.new();
    }
    let cs: Vec[char] = w.chars().collect();
    let mut k = cs.len() - 1;
    while k >= 0 and cs[k] != '\'' {
        k -= 1;
    }
    str_of(sub_chars(cs, 0, k))
}

// One row of a family table: if the word ends in lastlet and one of
// the family, word[:numend] + post.
fn fam(word: ref String, lw: ref String, last_let: ref String, lastlet: Str, d: ref BySize, numend: i64, post: Str) -> Option[String] {
    if *last_let == lastlet and d.ends(lw) {
        return Some(f"{cut_or_all(word, numend)}{post}");
    }
    None
}

// ------------------------------------------- articles, numbers, join

fn type_error_text(v: ref V) -> PyErr {
    py_err("TypeError", f"expected string or bytes-like object, got '{v_type(v)}'")
}

impl Eng {
    fn a(mut ref self, t: ref Tab, text: ref String, count: ref V) -> Result[String, PyErr] {
        match search(t.re_indefinite_article, text) {
            Some(mo) => {
                let word = mo.g(2);
                if word.len() == 0 {
                    return Ok(text.clone());
                }
                let result = self.indef_article(t, word, count)?;
                Ok(f"{mo.g(1)}{result}{mo.g(3)}")
            }
            None => Ok(String.new()),
        }
    }

    fn indef_article(mut ref self, t: ref Tab, word: ref String, count: ref V) -> Result[String, PyErr] {
        if self.get_count(t, count) != 1 {
            return Ok(f"{v_str(count)} {word}");
        }
        let ud = self.ud_a.clone();
        if let Some(v) = self.ud_match(t, word, ud)? {
            return Ok(f"{v} {word}");
        }
        for (prog, article) in t.indef_cases.iter() {
            if hits(prog, word) {
                return Ok(f"{article} {word}");
            }
        }
        Ok(f"a {word}")
    }

    fn no(mut ref self, t: ref Tab, text: ref String, count0: ref V) -> Result[String, PyErr] {
        let mut count = count0.clone();
        if is_none(count) {
            if let Some(p) = self.persistent {
                count = V.I(p);
            }
        }
        if is_none(count) {
            count = V.I(0);
        }
        let (pre, word, post) = match search(t.re_partition_word, text) {
            Some(mo) => (mo.g(1), mo.g(2), mo.g(3)),
            None => (String.new(), String.new(), String.new()),
        };
        if t.count_zero.contains(lowr(v_str(count))) {
            count = V.S("no".to_string());
        }
        let pl = self.plural(t, word, count)?;
        Ok(f"{pre}{v_str(count)} {pl}{post}")
    }

    fn present_participle(mut ref self, t: ref Tab, word: ref String) -> Result[String, PyErr] {
        let plv = self.plural_verb(t, word, V.I(2))?;
        let mut ans = plv.clone();
        for (prog, repl) in t.participle.iter() {
            let (out, n) = sub_tpl(prog, repl.as_str(), plv, 0)?;
            ans = out;
            if n > 0 {
                return Ok(f"{ans}ing");
            }
        }
        Ok(f"{ans}ing")
    }

    fn ordinal(mut ref self, t: ref Tab, num: ref V) -> Result[String, PyErr] {
        let s = v_str(num);
        if rmatch(t.re_digit, s).is_some() {
            let mut n100 = 0;
            let mut whole = false;
            match num {
                V.I(n) => {
                    n100 = py_mod(n, 100);
                    whole = true;
                }
                V.F(_) => {
                    let f = f64_of(num);
                    if f == f.floor() {
                        n100 = py_mod(f as i64, 100);
                        whole = true;
                    }
                }
                _ => {}
            }
            if not whole {
                if s.contains(".") {
                    n100 = match py_int_mod100(sfx(s, 1)) {
                        Ok(v) => v,
                        Err(_) => py_int_mod100(cut(s, 1))?,
                    };
                } else {
                    n100 = match num {
                        V.F(_) => py_mod(f64_of(num) as i64, 100),
                        _ => py_int_mod100(s)?,
                    };
                }
            }
            let post = match t.nth.get(n100) {
                Some(p) => p.clone(),
                None => t.nth.get(py_mod(n100, 10)).unwrap().clone(),
            };
            return Ok(f"{s}{post}");
        }
        match num {
            V.S(text) => Ok(self.sub_ord(t, text)),
            _ => Err(type_error_text(num)),
        }
    }

    fn sub_ord(self, t: ref Tab, val: ref String) -> String {
        let ms = matches_of(t.re_ordinal_suff, val, 0);
        let gs = gaps(val, ms);
        let mut out = String.new();
        for k in 0..ms.len() {
            out.push_str(gs[k]);
            out.push_str(t.ordinal.get(ms[k].g(1)).unwrap());
        }
        out.push_str(gs[ms.len()]);
        if out == *val {
            out.push_str("th");
        }
        out
    }

    fn millfn(self, t: ref Tab, ind: i64) -> Result[String, PyErr] {
        if ind > t.mill.len() - 1 {
            return Err(py_err("NumOutOfRangeError", String.new()));
        }
        Ok(t.mill[ind].clone())
    }

    fn unitfn(self, t: ref Tab, units: i64, mindex: i64) -> Result[String, PyErr] {
        Ok(f"{t.unit[units]}{self.millfn(t, mindex)?}")
    }

    fn tenfn(self, t: ref Tab, tens: i64, units: i64, mindex: i64) -> Result[String, PyErr] {
        if tens != 1 {
            let hyphen = if tens != 0 and units != 0 { "-" } else { "" };
            return Ok(f"{t.ten[tens]}{hyphen}{t.unit[units]}{self.millfn(t, mindex)?}");
        }
        Ok(f"{t.teen[units]}{pick(t.mill, mindex)?}")
    }

    fn hundfn(self, t: ref Tab, hundreds: i64, tens: i64, units: i64, mindex: i64) -> Result[String, PyErr] {
        if hundreds != 0 {
            let andword = if tens != 0 or units != 0 { f" {self.andword} " } else { String.new() };
            return Ok(f"{t.unit[hundreds]} hundred{andword}{self.tenfn(t, tens, units, 0)?}{self.millfn(t, mindex)?}, ");
        }
        if tens != 0 or units != 0 {
            return Ok(f"{self.tenfn(t, tens, units, 0)?}{self.millfn(t, mindex)?}, ");
        }
        Ok(String.new())
    }

    // The callbacks enword's subs use: 1 group1sub, 2 group1bsub,
    // 3 group2sub, 4 group3sub, 5 hundsub, 6 tensub, 7 unitsub.
    fn callback(mut ref self, t: ref Tab, kind: i64, mo: ref Mt) -> Result[String, PyErr] {
        if kind == 1 {
            let units = dg(mo, 1);
            if units == 1 {
                return Ok(f" {self.one}, ");
            }
            if units != 0 {
                return Ok(f"{t.unit[units]}, ");
            }
            return Ok(f" {self.zero}, ");
        }
        if kind == 2 {
            let units = dg(mo, 1);
            if units != 0 {
                return Ok(f"{t.unit[units]}, ");
            }
            return Ok(f" {self.zero}, ");
        }
        if kind == 3 {
            let tens = dg(mo, 1);
            let units = dg(mo, 2);
            if tens != 0 {
                return Ok(f"{self.tenfn(t, tens, units, 0)?}, ");
            }
            if units != 0 {
                return Ok(f" {self.zero} {t.unit[units]}, ");
            }
            return Ok(f" {self.zero} {self.zero}, ");
        }
        if kind == 4 {
            let hundreds = dg(mo, 1);
            let tens = dg(mo, 2);
            let units = dg(mo, 3);
            let hunword = if hundreds == 1 {
                f" {self.one}"
            } else if hundreds != 0 {
                t.unit[hundreds].clone()
            } else {
                f" {self.zero}"
            };
            let tenword = if tens != 0 {
                self.tenfn(t, tens, units, 0)?
            } else if units != 0 {
                f" {self.zero} {t.unit[units]}"
            } else {
                f" {self.zero} {self.zero}"
            };
            return Ok(f"{hunword} {tenword}, ");
        }
        if kind == 5 {
            let r = self.hundfn(t, dg(mo, 1), dg(mo, 2), dg(mo, 3), self.mill_count)?;
            self.mill_count += 1;
            return Ok(r);
        }
        if kind == 6 {
            return Ok(f"{self.tenfn(t, dg(mo, 1), dg(mo, 2), self.mill_count)?}, ");
        }
        Ok(f"{self.unitfn(t, dg(mo, 1), self.mill_count)?}, ")
    }

    // pattern.sub(callback, s, count)
    fn sub_cb(mut ref self, t: ref Tab, prog: ref Program, kind: i64, s: ref String, count: i64) -> Result[String, PyErr] {
        let ms = matches_of(prog, s, count);
        let gs = gaps(s, ms);
        let mut out = String.new();
        for k in 0..ms.len() {
            out.push_str(gs[k]);
            out.push_str(self.callback(t, kind, ms[k])?);
        }
        out.push_str(gs[ms.len()]);
        Ok(out)
    }

    fn enword(mut ref self, t: ref Tab, num0: ref String, group: i64) -> Result[String, PyErr] {
        let mut num = num0.clone();
        if group == 1 {
            num = self.sub_cb(t, t.re_digit_group, 1, num, 0)?;
        } else if group == 2 {
            num = self.sub_cb(t, t.re_two_digits, 3, num, 0)?;
            num = self.sub_cb(t, t.re_digit_group, 2, num, 1)?;
        } else if group == 3 {
            num = self.sub_cb(t, t.re_three_digits, 4, num, 0)?;
            num = self.sub_cb(t, t.re_two_digits, 3, num, 1)?;
            num = self.sub_cb(t, t.re_digit_group, 1, num, 1)?;
        } else {
            let digits = lstrip_char(strip_ws(num), '0');
            if digits.len() == 0 {
                return Ok(self.zero.clone());
            }
            if digits == "1" {
                return Ok(self.one.clone());
            }
            num = lstrip_char(lstrip_ws(num), '0');
            self.mill_count = 0;
            while hits(t.re_three_digits_word, num) {
                num = self.sub_cb(t, t.re_three_digits_word, 5, num, 1)?;
            }
            num = self.sub_cb(t, t.re_two_digits_word, 6, num, 1)?;
            num = self.sub_cb(t, t.re_one_digit_word, 7, num, 1)?;
        }
        Ok(num)
    }

    fn number_to_words(mut ref self, t: ref Tab, num0: ref V, wantlist: bool, group: i64, comma: ref String, andword: ref String, zero: ref String, one: ref String, decimal: ref Option[String], threshold: ref Option[i64]) -> Result[V, PyErr] {
        self.andword = andword.clone();
        self.zero = zero.clone();
        self.one = one.clone();
        let mut num = v_str(num0);

        if let Some(th) = threshold {
            if py_float(num)? > th as f64 {
                let mut spnum = split_once_on(num, ".");
                if comma.len() > 0 {
                    loop {
                        let (out, n) = sub_tpl(t.re_four_digit_comma, "\\1,\\2", spnum[0], 0)?;
                        spnum[0] = out;
                        if n == 0 {
                            break;
                        }
                    }
                }
                if spnum.len() > 1 {
                    return Ok(V.S(f"{spnum[0]}.{spnum[1]}"));
                }
                return Ok(V.S(spnum[0].clone()));
            }
        }
        if group < 0 or group > 3 {
            return Err(py_err("BadChunkingOptionError", String.new()));
        }
        let lead = lstrip_ws(num);
        if lead.len() == 0 {
            return Err(py_err("IndexError", "string index out of range".to_string()));
        }
        let c0 = first_char(lead);
        let sign = if c0 == "+" { "plus" } else if c0 == "-" { "minus" } else { "" };
        if t.nth_suff.contains(num) {
            num = zero.clone();
        }
        let myord = t.nth_suff.contains(sfx(num, 2));
        if myord {
            num = cut(num, 2);
        }
        // _chunk_num
        let dec_text = match decimal {
            Some(d) => d.clone(),
            None => String.new(),
        };
        let mut chunks: Vec[String] = Vec.new();
        if dec_text.len() > 0 {
            if group != 0 {
                chunks = split_on(num, ".");
            } else {
                chunks = split_once_on(num, ".");
            }
        } else {
            chunks.push(num.clone());
        }
        let finalpoint = chunks[chunks.len() - 1] == "";
        if finalpoint {
            chunks.pop();
        }
        if chunks.len() == 0 {
            return Err(index_error());
        }
        let loopstart = if chunks[0] == "" { 1 } else { 0 };
        // first: 1 True, 0 False, 2 None
        let mut first = if loopstart == 1 { 0 } else { 1 };
        for k in loopstart..chunks.len() {
            let mut chunk = chunks[k].clone();
            chunk = sub_tpl(t.re_non_digit, "", chunk, 0)?.0;
            if chunk == "" {
                chunk = "0".to_string();
            }
            if group == 0 and first != 1 {
                chunk = self.enword(t, chunk, 1)?;
            } else {
                chunk = self.enword(t, chunk, group)?;
            }
            if sfx(chunk, 2) == ", " {
                chunk = cut(chunk, 2);
            }
            chunk = sub_tpl(t.re_whitespaces_comma, ",", chunk, 0)?.0;
            if group == 0 and first == 1 {
                chunk = sub_tpl(t.re_comma_word, f" {andword} \\1".as_str(), chunk, 0)?.0;
            }
            chunk = sub_tpl(t.re_whitespaces, " ", chunk, 0)?.0;
            chunk = strip_ws(chunk);
            if first == 1 {
                first = 2;
            }
            chunks[k] = chunk;
        }
        let sep = f"{comma} ";
        let mut numchunks: Vec[String] = Vec.new();
        if first != 0 {
            numchunks = split_on(chunks[0], sep.as_str());
        }
        if myord and numchunks.len() > 0 {
            let last = numchunks.len() - 1;
            numchunks[last] = self.sub_ord(t, numchunks[last]);
        }
        for k in 1..chunks.len() {
            numchunks.push(dec_text.clone());
            for piece in split_on(chunks[k], sep.as_str()).iter() {
                numchunks.push(piece.clone());
            }
        }
        if finalpoint {
            numchunks.push(dec_text.clone());
        }
        if wantlist {
            let mut out: Vec[V] = Vec.new();
            if sign != "" {
                out.push(V.S(sign.to_string()));
            }
            for c in numchunks.iter() {
                out.push(V.S(c.clone()));
            }
            return Ok(V.L(out));
        }
        let signout = if sign != "" { f"{sign} " } else { String.new() };
        let valout = if group != 0 {
            joined(numchunks, ", ".to_string())
        } else {
            render(numchunks, decimal, comma)?
        };
        Ok(V.S(f"{signout}{valout}"))
    }

    fn join(self, words: ref Option[Vec[String]], sep0: ref Option[String], sep_spaced: bool, final_sep0: ref Option[String], conj0: ref String, conj_spaced: bool) -> String {
        let ws = match words {
            Some(w) => w.clone(),
            None => Vec.new(),
        };
        if ws.len() == 0 {
            return String.new();
        }
        if ws.len() == 1 {
            return ws[0].clone();
        }
        let mut conj = conj0.clone();
        if conj_spaced {
            if conj == "" {
                conj = " ".to_string();
            } else {
                conj = f" {conj} ";
            }
        }
        if ws.len() == 2 {
            return f"{ws[0]}{conj}{ws[1]}";
        }
        let mut sep = match sep0 {
            Some(s) => s.clone(),
            None => if joined(ws, String.new()).contains(",") { ";".to_string() } else { ",".to_string() },
        };
        let final_sep = match final_sep0 {
            Some(f) => f"{f}{conj}",
            None => f"{sep}{conj}",
        };
        if sep_spaced {
            sep = f"{sep} ";
        }
        let mut head: Vec[String] = Vec.new();
        for k in 0..ws.len() - 1 {
            head.push(ws[k].clone());
        }
        f"{joined(head, sep)}{final_sep}{ws[ws.len() - 1]}"
    }
}

// _render: commas between the chunks before the decimal word.
fn render(chunks: ref Vec[String], decimal: ref Option[String], comma: ref String) -> Result[String, PyErr] {
    if chunks.len() == 0 {
        return Err(py_err("IndexError", "pop from empty list".to_string()));
    }
    let mut out = chunks[0].clone();
    let mut first = match decimal {
        None => true,
        Some(d) => not chunks[0].ends_with(d.as_str()),
    };
    for k in 1..chunks.len() {
        let nc = chunks[k].clone();
        let is_dec = match decimal {
            Some(d) => nc == *d,
            None => false,
        };
        if is_dec {
            first = false;
        } else if first {
            out.push_str(comma);
        }
        out.push_str(f" {nc}");
    }
    Ok(out)
}

fn dg(mo: ref Mt, g: i64) -> i64 {
    i64.parse(mo.g(g)).unwrap_or(0)
}

// ------------------------------------------------------ method calls

fn argv(args: ref Vec[V], kw: ref Vec[(String, V)], idx: i64, name: Str) -> Option[V] {
    if idx < args.len() {
        return Some(args[idx].clone());
    }
    for (k, v) in kw.iter() {
        if k == name {
            return Some(v.clone());
        }
    }
    None
}

fn arg_or(args: ref Vec[V], kw: ref Vec[(String, V)], idx: i64, name: Str, dflt: own V) -> V {
    match argv(args, kw, idx, name) {
        Some(v) => v,
        None => dflt,
    }
}

fn want_text(v: ref V) -> Result[String, PyErr] {
    match v {
        V.S(s) => Ok(s.clone()),
        _ => Err(type_error_text(v)),
    }
}

fn opt_word(v: ref V) -> Option[String] {
    match v {
        V.S(s) => Some(s.clone()),
        _ => None,
    }
}

fn v_int(v: ref V) -> i64 {
    match v {
        V.I(n) => n,
        V.B(b) => if b { 1 } else { 0 },
        V.F(_) => f64_of(v) as i64,
        _ => 0,
    }
}

fn str_or_false(r: ref Option[String]) -> V {
    match r {
        Some(s) => V.S(s.clone()),
        None => V.B(false),
    }
}

fn str_list(v: ref V) -> Option[Vec[String]] {
    match v {
        V.L(items) => {
            let mut out: Vec[String] = Vec.new();
            for it in items.iter() {
                out.push(v_str(it));
            }
            Some(out)
        }
        _ => None,
    }
}

impl Eng {
    fn call_method(mut ref self, t: ref Tab, name: ref String, args: ref Vec[V], kw: ref Vec[(String, V)]) -> Result[V, PyErr] {
        let a0 = arg_or(args, kw, 0, "", V.N);
        if name == "plural" or name == "plural_noun" or name == "plural_verb" or name == "plural_adj" {
            let text = want_text(arg_or(args, kw, 0, "text", V.N))?;
            let count = arg_or(args, kw, 1, "count", V.N);
            let r = if name == "plural" {
                self.plural(t, text, count)?
            } else if name == "plural_noun" {
                self.plural_noun(t, text, count)?
            } else if name == "plural_verb" {
                self.plural_verb(t, text, count)?
            } else {
                self.plural_adj(t, text, count)?
            };
            return Ok(V.S(r));
        }
        if name == "singular_noun" {
            let text = want_text(arg_or(args, kw, 0, "text", V.N))?;
            let count = arg_or(args, kw, 1, "count", V.N);
            let gender = opt_word(arg_or(args, kw, 2, "gender", V.N));
            return Ok(str_or_false(self.singular_noun(t, text, count, gender)?));
        }
        if name == "compare" or name == "compare_nouns" or name == "compare_verbs" or name == "compare_adjs" {
            let w1 = want_text(arg_or(args, kw, 0, "word1", V.N))?;
            let w2 = want_text(arg_or(args, kw, 1, "word2", V.N))?;
            let r = if name == "compare" {
                self.compare(t, w1, w2)?
            } else if name == "compare_nouns" {
                self.plequal(t, w1, w2, Norm.Noun)?
            } else if name == "compare_verbs" {
                self.plequal(t, w1, w2, Norm.Verb)?
            } else {
                self.plequal(t, w1, w2, Norm.Adj)?
            };
            return Ok(str_or_false(r));
        }
        if name == "a" or name == "an" {
            let text = want_text(arg_or(args, kw, 0, "text", V.N))?;
            let count = arg_or(args, kw, 1, "count", V.I(1));
            return Ok(V.S(self.a(t, text, count)?));
        }
        if name == "no" {
            let text = want_text(arg_or(args, kw, 0, "text", V.N))?;
            let count = arg_or(args, kw, 1, "count", V.N);
            return Ok(V.S(self.no(t, text, count)?));
        }
        if name == "present_participle" {
            let word = want_text(arg_or(args, kw, 0, "word", V.N))?;
            return Ok(V.S(self.present_participle(t, word)?));
        }
        if name == "ordinal" {
            return Ok(V.S(self.ordinal(t, arg_or(args, kw, 0, "num", V.N))?));
        }
        if name == "number_to_words" {
            let num = arg_or(args, kw, 0, "num", V.N);
            let wantlist = truthy(arg_or(args, kw, 1, "wantlist", V.B(false)));
            let group = v_int(arg_or(args, kw, 2, "group", V.I(0)));
            let comma = v_str(arg_or(args, kw, 3, "comma", V.S(",".to_string())));
            let andword = v_str(arg_or(args, kw, 4, "andword", V.S("and".to_string())));
            let zero = v_str(arg_or(args, kw, 5, "zero", V.S("zero".to_string())));
            let one = v_str(arg_or(args, kw, 6, "one", V.S("one".to_string())));
            let decimal = opt_word(arg_or(args, kw, 7, "decimal", V.S("point".to_string())));
            let threshold = match arg_or(args, kw, 8, "threshold", V.N) {
                V.N => None,
                v => Some(v_int(v)),
            };
            return self.number_to_words(t, num, wantlist, group, comma, andword, zero, one, decimal, threshold);
        }
        if name == "join" {
            let words = str_list(arg_or(args, kw, 0, "words", V.N));
            let sep = opt_word(arg_or(args, kw, 1, "sep", V.N));
            let sep_spaced = truthy(arg_or(args, kw, 2, "sep_spaced", V.B(true)));
            let final_sep = opt_word(arg_or(args, kw, 3, "final_sep", V.N));
            let conj = v_str(arg_or(args, kw, 4, "conj", V.S("and".to_string())));
            let conj_spaced = truthy(arg_or(args, kw, 5, "conj_spaced", V.B(true)));
            return Ok(V.S(self.join(words, sep, sep_spaced, final_sep, conj, conj_spaced)));
        }
        if name == "classical" {
            self.classical_kw(kw)?;
            return Ok(V.N);
        }
        if name == "num" {
            let count = arg_or(args, kw, 0, "count", V.N);
            let show = arg_or(args, kw, 1, "show", V.N);
            return Ok(V.S(self.num(count, show)?));
        }
        if name == "gender" {
            let g = v_str(a0);
            if not t.genders.contains(g) {
                return Err(py_err("BadGenderError", String.new()));
            }
            self.thegender = g;
            return Ok(V.N);
        }
        if name == "defnoun" or name == "defadj" {
            let s = opt_word(arg_or(args, kw, 0, "singular", V.N));
            let p = opt_word(arg_or(args, kw, 1, "plural", V.N));
            self.checkpat(s)?;
            if name == "defnoun" {
                self.ud_pl_sb.push(s.clone());
                self.ud_pl_sb.push(p.clone());
                self.ud_si_sb.push(p);
                self.ud_si_sb.push(s);
            } else {
                self.ud_pl_adj.push(s);
                self.ud_pl_adj.push(p);
            }
            return Ok(V.I(1));
        }
        if name == "defverb" {
            let mut vs: Vec[Option[String]] = Vec.new();
            for k in 0..6 {
                vs.push(opt_word(arg_or(args, kw, k, "", V.N)));
            }
            self.checkpat(vs[0])?;
            self.checkpat(vs[2])?;
            self.checkpat(vs[4])?;
            for v in vs.iter() {
                self.ud_pl_v.push(v.clone());
            }
            return Ok(V.I(1));
        }
        if name == "defa" or name == "defan" {
            let p = opt_word(a0);
            self.checkpat(p)?;
            self.ud_a.push(p);
            self.ud_a.push(Some(if name == "defa" { "a".to_string() } else { "an".to_string() }));
            return Ok(V.I(1));
        }
        if name == "inflect" {
            let text = want_text(a0)?;
            return Ok(V.S(self.inflect(t, text)?));
        }
        Err(py_err("AttributeError", f"'engine' object has no attribute {s_repr(name)}"))
    }

    fn classical_kw(mut ref self, kw: ref Vec[(String, V)]) -> Result[(), PyErr] {
        if kw.len() == 0 {
            self.classical = all_classical();
            return Ok(());
        }
        for (k, v) in kw.iter() {
            if k == "all" {
                self.classical = if truthy(v) { all_classical() } else { no_classical() };
            }
        }
        let names = classical_names();
        for (k, v) in kw.iter() {
            let mut found = false;
            for i in 0..names.len() {
                if names[i] == *k {
                    self.classical[i] = truthy(v);
                    found = true;
                }
            }
            if not found {
                return Err(py_err("UnknownClassicalModeError", String.new()));
            }
        }
        Ok(())
    }

    fn num(mut ref self, count: ref V, show: ref V) -> Result[String, PyErr] {
        if is_none(count) {
            self.persistent = None;
            return Ok(String.new());
        }
        let n = match count {
            V.S(s) => {
                let st = strip_ws(s);
                match i64.parse(st) {
                    Ok(v) => v,
                    Err(_) => return Err(py_err("BadNumValueError", String.new())),
                }
            }
            _ => v_int(count),
        };
        self.persistent = Some(n);
        if is_none(show) or truthy(show) {
            return Ok(v_str(count));
        }
        Ok(String.new())
    }

    // inflect(): each call written in Python syntax, replaced by what
    // the method returns.
    fn inflect(mut ref self, t: ref Tab, text: ref String) -> Result[String, PyErr] {
        let save = self.persistent;
        let ms = matches_of(t.re_function_call, text, 0);
        let gs = gaps(text, ms);
        let mut out = String.new();
        let mut item = 0;
        let mut bad: Option[(i64, String)] = None;
        for k in 0..ms.len() {
            if gs[k].len() > 0 {
                out.push_str(gs[k]);
                item += 1;
            }
            let matched = ms[k].g(1);
            let fname = ms[k].g(2);
            let methods = vec!["plural", "plural_adj", "plural_noun", "plural_verb", "singular_noun", "a", "an", "no", "ordinal", "number_to_words", "present_participle", "num"];
            let mut known = false;
            for m in methods.iter() {
                if fname == *m {
                    known = true;
                }
            }
            if not known {
                out.push_str(matched);
                item += 1;
                continue;
            }
            let (args, kw) = eval_call(matched)?;
            let r = self.call_method(t, fname, args, kw)?;
            match r {
                V.S(s) => out.push_str(s),
                other => {
                    if bad.is_none() {
                        bad = Some((item, v_type(other).to_string()));
                    }
                }
            }
            item += 1;
        }
        out.push_str(gs[ms.len()]);
        if let Some((i, ty)) = bad {
            return Err(py_err("TypeError", f"sequence item {i}: expected str instance, {ty} found"));
        }
        self.persistent = save;
        Ok(out)
    }
}

// ------------------------------------------- ast.parse of one call

enum PyE {
    Const(V),
    Name(String),
    Unary,
    ListE(Vec[PyE]),
    TupleE(Vec[PyE]),
}

struct PyIn {
    cs: Vec[char],
    pos: i64,
}

fn syntax_error() -> PyErr {
    py_err("SyntaxError", "invalid syntax".to_string())
}

fn ident_start(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

fn ident_char(c: char) -> bool {
    ident_start(c) or is_ascii_digit_char(c)
}

impl PyIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and (self.cs[self.pos] == ' ' or self.cs[self.pos] == '\t') {
            self.pos += 1;
        }
    }

    fn peek(self) -> char {
        if self.pos < self.cs.len() { self.cs[self.pos] } else { '\u{0}' }
    }

    fn eat(mut ref self, c: char) -> bool {
        self.ws();
        if self.peek() == c {
            self.pos += 1;
            return true;
        }
        false
    }

    fn ident(mut ref self) -> Option[String] {
        self.ws();
        if not ident_start(self.peek()) {
            return None;
        }
        let st = self.pos;
        while self.pos < self.cs.len() and ident_char(self.cs[self.pos]) {
            self.pos += 1;
        }
        Some(str_of(sub_chars(self.cs, st, self.pos)))
    }

    fn string(mut ref self) -> Result[String, PyErr] {
        let q = self.cs[self.pos];
        self.pos += 1;
        let mut s = String.new();
        loop {
            if self.pos >= self.cs.len() {
                return Err(syntax_error());
            }
            let c = self.cs[self.pos];
            self.pos += 1;
            if c == q {
                return Ok(s);
            }
            if c != '\\' {
                s.push(c);
                continue;
            }
            if self.pos >= self.cs.len() {
                return Err(syntax_error());
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == '\\' or e == '\'' or e == '"' {
                s.push(e);
            } else if e == 'x' or e == 'u' {
                let n = if e == 'x' { 2 } else { 4 };
                let mut v: u32 = 0;
                for _ in 0..n {
                    let h = self.cs[self.pos];
                    self.pos += 1;
                    let d = if h >= '0' and h <= '9' { h as u32 - 48 } else if h >= 'a' and h <= 'f' { h as u32 - 87 } else { h as u32 - 55 };
                    v = v * 16 + d;
                }
                s.push(char.try_from(v).unwrap_or('?'));
            } else {
                s.push('\\');
                s.push(e);
            }
        }
    }

    fn expr(mut ref self) -> Result[PyE, PyErr] {
        self.ws();
        let c = self.peek();
        if c == '-' or c == '+' {
            self.pos += 1;
            self.expr()?;
            return Ok(PyE.Unary);
        }
        if c == '\'' or c == '"' {
            let mut s = String.new();
            loop {
                self.ws();
                let d = self.peek();
                if d != '\'' and d != '"' {
                    break;
                }
                s.push_str(self.string()?);
            }
            return Ok(PyE.Const(V.S(s)));
        }
        if is_ascii_digit_char(c) or c == '.' {
            let st = self.pos;
            while self.pos < self.cs.len() and (is_ascii_digit_char(self.cs[self.pos]) or self.cs[self.pos] == '.' or self.cs[self.pos] == '_') {
                self.pos += 1;
            }
            let text = str_of(sub_chars(self.cs, st, self.pos));
            if text.contains(".") {
                return Ok(PyE.Const(V.F(text)));
            }
            return match i64.parse(text) {
                Ok(n) => Ok(PyE.Const(V.I(n))),
                Err(_) => Err(syntax_error()),
            };
        }
        if c == '[' or c == '(' {
            self.pos += 1;
            let close = if c == '[' { ']' } else { ')' };
            let mut items: Vec[PyE] = Vec.new();
            let mut trailing_comma = false;
            loop {
                if self.eat(close) {
                    break;
                }
                items.push(self.expr()?);
                trailing_comma = false;
                if self.eat(',') {
                    trailing_comma = true;
                    continue;
                }
                if self.eat(close) {
                    break;
                }
                return Err(syntax_error());
            }
            if c == '[' {
                return Ok(PyE.ListE(items));
            }
            if items.len() == 1 and not trailing_comma {
                return Ok(items.pop().unwrap());
            }
            return Ok(PyE.TupleE(items));
        }
        match self.ident() {
            Some(id) => {
                if id == "True" {
                    return Ok(PyE.Const(V.B(true)));
                }
                if id == "False" {
                    return Ok(PyE.Const(V.B(false)));
                }
                if id == "None" {
                    return Ok(PyE.Const(V.N));
                }
                Ok(PyE.Name(id))
            }
            None => Err(syntax_error()),
        }
    }
}

fn py_value(e: ref PyE) -> Result[V, PyErr] {
    match e {
        PyE.Const(v) => Ok(v.clone()),
        PyE.Name(id) => Err(py_err("NameError", f"name '{id}' is not defined")),
        PyE.Unary => Err(py_err("AttributeError", "'UnaryOp' object has no attribute 'id'".to_string())),
        PyE.ListE(items) => {
            let mut out: Vec[V] = Vec.new();
            for it in items.iter() {
                out.push(py_value(it)?);
            }
            Ok(V.L(out))
        }
        PyE.TupleE(items) => {
            let mut out: Vec[V] = Vec.new();
            for it in items.iter() {
                out.push(py_value(it)?);
            }
            Ok(V.T(out))
        }
    }
}

// The arguments of `name(...)`, as _string_to_substitute evaluates them.
fn eval_call(text: ref String) -> Result[(Vec[V], Vec[(String, V)]), PyErr] {
    let mut p = PyIn { cs: text.chars().collect(), pos: 0 };
    if p.ident().is_none() or not p.eat('(') {
        return Err(syntax_error());
    }
    let mut pos_args: Vec[PyE] = Vec.new();
    let mut kw_args: Vec[(String, PyE)] = Vec.new();
    loop {
        if p.eat(')') {
            break;
        }
        let save = p.pos;
        let mut keyword: Option[String] = None;
        if let Some(id) = p.ident() {
            if p.eat('=') {
                keyword = Some(id);
            } else {
                p.pos = save;
            }
        } else {
            p.pos = save;
        }
        let e = p.expr()?;
        match keyword {
            Some(k) => kw_args.push((k, e)),
            None => pos_args.push(e),
        }
        if p.eat(',') {
            continue;
        }
        if p.eat(')') {
            break;
        }
        return Err(syntax_error());
    }
    p.ws();
    if p.pos != p.cs.len() {
        return Err(syntax_error());
    }
    let mut args: Vec[V] = Vec.new();
    for e in pos_args.iter() {
        args.push(py_value(e)?);
    }
    let mut kw: Vec[(String, V)] = Vec.new();
    for (k, e) in kw_args.iter() {
        kw.push((k.clone(), py_value(e)?));
    }
    Ok((args, kw))
}

// ------------------------------------------------------------ programs

fn failure(e: ref PyErr) -> String {
    f"! {e.kind}: {e.msg}"
}

fn perr(e: ref PyErr) -> String {
    failure(e)
}

fn pad_left(s: ref String, w: i64) -> String {
    let mut out = s.clone();
    let mut n = clen(s);
    while n < w {
        out.push(' ');
        n += 1;
    }
    out
}

fn pad_right(s: ref String, w: i64) -> String {
    let mut out = String.new();
    let mut n = clen(s);
    while n < w {
        out.push(' ');
        n += 1;
    }
    out.push_str(s);
    out
}

fn read_data(name: ref String) -> Result[String, String] {
    match fs.read_to_string(f"data/{name}") {
        Ok(s) => Ok(s),
        Err(e) => Err(f"data/{name}: {e}"),
    }
}

fn data_lines(name: ref String) -> Result[Vec[String], String] {
    let text = read_data(name)?;
    let mut out: Vec[String] = Vec.new();
    for l in text.lines() {
        out.push(l.to_string());
    }
    Ok(out)
}

fn j_int(j: ref J) -> i64 {
    match j {
        J.N(t) => i64.parse(t).unwrap_or(0),
        _ => 0,
    }
}

fn nw(e: mut ref Eng, t: ref Tab, n: ref V) -> Result[String, PyErr] {
    let r = e.number_to_words(t, n, false, 0, ",".to_string(), "and".to_string(), "zero".to_string(), "one".to_string(), Some("point".to_string()), None)?;
    Ok(v_str(r))
}

fn prog_digest(e: mut ref Eng, t: ref Tab, file: ref String) -> Result[(), PyErr] {
    let text = read_data(file).map_err(|m| py_err("OSError", m))?;
    let repos = json_line(text).map_err(|m| py_err("ValueError", m))?;
    if let J.A(items) = repos {
        for repo in items.iter() {
            let mut parts: Vec[String] = Vec.new();
            if let J.A(open) = j_get(repo, "open") {
                for pair in open.iter() {
                    if let J.A(kn) = pair {
                        let kind = match kn[0].clone() {
                            J.S(s) => s,
                            _ => String.new(),
                        };
                        let n = j_int(kn[1]);
                        let count = if n < 10 { nw(mut e, t, V.I(n))? } else { f"{n}" };
                        if n == 0 {
                            parts.push(e.no(t, kind, V.I(0))?);
                        } else {
                            parts.push(f"{count} {e.plural(t, kind, V.I(n))?}");
                        }
                    }
                }
            }
            let owners_n = j_int(j_get(repo, "owners"));
            let verb = e.plural_verb(t, "is".to_string(), V.I(owners_n))?;
            let maint = j_strs(repo, "maintainers");
            let owners = if maint.len() > 0 { e.join(Some(maint), None, true, None, "and".to_string(), true) } else { "nobody".to_string() };
            let listed = e.join(Some(parts), None, true, None, "and".to_string(), true);
            println(f"{j_str(repo, "name")}: {listed} open; {owners} {verb} on call");
            let stale = j_int(j_get(repo, "stale"));
            if stale != 0 {
                let a = e.no(t, "stale branch".to_string(), V.I(stale))?;
                let b = e.plural_verb(t, "was".to_string(), V.I(stale))?;
                let c = e.a(t, j_str(repo, "oldest"), V.I(1))?;
                println(f"  {a} {b} found; {c} is the oldest");
            }
        }
    }
    Ok(())
}

fn prog_cheques(e: mut ref Eng, t: ref Tab, file: ref String) -> Result[(), PyErr] {
    let lines = data_lines(file).map_err(|m| py_err("OSError", m))?;
    for k in 1..lines.len() {
        let f = split_on(lines[k], ",");
        if f.len() < 5 {
            continue;
        }
        let payee = f[0].clone();
        let amount = f[1].clone();
        let ap = split_once_on(amount, ".");
        let whole = ap[0].clone();
        let cents_raw = if ap.len() > 1 { ap[1].clone() } else { String.new() };
        let cents = pys(f"{cents_raw}00", 0, 2);
        let words = v_str(e.number_to_words(t, V.S(whole.clone()), false, 0, String.new(), String.new(), "zero".to_string(), "one".to_string(), Some("point".to_string()), None)?);
        let unit = if whole == "1" { f[3].clone() } else { f[4].clone() };
        let line = f"{words} {unit} and {cents}/100";
        let shown = f"{uppr(first_char(line))}{pys(line, 1, big())}";
        println(f"{pad_left(payee, 24)} {f[2]} {pad_right(amount, 12)}  {shown}");
        let grouped = v_str(e.number_to_words(t, V.S(whole), false, 3, ",".to_string(), "and".to_string(), "zero".to_string(), "one".to_string(), Some("point".to_string()), None)?);
        println(f"{pad_left(String.new(), 24)} {pad_left(String.new(), 3)} {pad_right(String.new(), 12)}  read back: {grouped}");
    }
    Ok(())
}

fn prog_leaderboard(e: mut ref Eng, t: ref Tab, file: ref String) -> Result[(), PyErr] {
    let lines = data_lines(file).map_err(|m| py_err("OSError", m))?;
    let mut rows: Vec[(String, i64)] = Vec.new();
    for k in 1..lines.len() {
        let f = split_on(lines[k], ",");
        if f.len() == 2 {
            rows.push((f[0].clone(), i64.parse(f[1]).unwrap_or(0)));
        }
    }
    // a stable sort, highest first
    let mut i = 1;
    while i < rows.len() {
        let mut j = i;
        while j > 0 and rows[j - 1].1 < rows[j].1 {
            let tmp = rows[j - 1].clone();
            rows[j - 1] = rows[j].clone();
            rows[j] = tmp;
            j -= 1;
        }
        i += 1;
    }
    let mut rank = 0;
    let mut last = -1;
    for k in 0..rows.len() {
        let pts = rows[k].1;
        if pts != last {
            rank = k + 1;
            last = pts;
        }
        let o = e.ordinal(t, V.I(rank))?;
        let pl = e.plural(t, "point".to_string(), V.I(pts))?;
        println(f"{pad_right(o, 5)} {pad_left(rows[k].0, 12)} {pad_right(f"{pts}", 6)} {pl}");
    }
    let mut winners: Vec[String] = Vec.new();
    for r in rows.iter() {
        if r.1 == rows[0].1 {
            winners.push(r.0.clone());
        }
    }
    let wn = winners.len();
    let names = e.join(Some(winners), None, true, None, "and".to_string(), true);
    let takes = e.plural_verb(t, "takes".to_string(), V.I(wn))?;
    let first = e.ordinal(t, V.S(nw(mut e, t, V.I(1))?))?;
    let field = nw(mut e, t, V.I(rows.len()))?;
    let players = e.plural(t, "player".to_string(), V.I(rows.len()))?;
    let lastw = e.ordinal(t, V.S(nw(mut e, t, V.I(rank))?))?;
    println(f"{names} {takes} {first} place; the field had {field} {players}, the last in {lastw} place");
    Ok(())
}

fn is_up(c: char) -> bool {
    c >= 'A' and c <= 'Z'
}

fn is_low(c: char) -> bool {
    c >= 'a' and c <= 'z'
}

fn snake(name: ref String) -> String {
    let cs: Vec[char] = name.chars().collect();
    let mut out = String.new();
    for i in 0..cs.len() {
        let c = cs[i];
        if is_up(c) and i > 0 and (not is_up(cs[i - 1]) or (i + 1 < cs.len() and is_low(cs[i + 1]))) {
            out.push('_');
        }
        let mut one = String.new();
        one.push(c);
        out.push_str(lowr(one));
    }
    out
}

fn prog_tables(e: mut ref Eng, t: ref Tab, file: ref String) -> Result[(), PyErr] {
    let lines = data_lines(file).map_err(|m| py_err("OSError", m))?;
    for line in lines.iter() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let kn = split_once_on(line, " ");
        let kind = kn[0].clone();
        let name = kn[1].clone();
        if kind == "model" {
            let mut words = split_on(snake(name), "_");
            let last = words.len() - 1;
            words[last] = e.plural_noun(t, words[last], V.N)?;
            let verbose = joined(split_on(snake(name), "_"), " ".to_string());
            let pv = e.plural_noun(t, verbose, V.N)?;
            let av = e.a(t, verbose, V.I(1))?;
            println(f"model {name}: table {joined(words, "_".to_string())}, verbose {s_repr(verbose)}, plural {s_repr(pv)}, {av}");
        } else {
            let mut words = split_on(name, "_");
            let last = words.len() - 1;
            match e.singular_noun(t, words[last], V.N, None)? {
                None => {
                    let mut model = String.new();
                    for w in words.iter() {
                        model.push_str(capz(w));
                    }
                    println(f"table {name}: already singular, model {model}");
                }
                Some(single) => {
                    words[last] = single;
                    let mut model = String.new();
                    for w in words.iter() {
                        model.push_str(capz(w));
                    }
                    println(f"table {name}: model {model}");
                }
            }
        }
    }
    Ok(())
}

fn prog_inventory(e: mut ref Eng, t: ref Tab, file: ref String) -> Result[(), PyErr] {
    let lines = data_lines(file).map_err(|m| py_err("OSError", m))?;
    let mut total = 0;
    for line in lines.iter() {
        if line.len() == 0 {
            continue;
        }
        let qi = split_once_on(line, " ");
        let n = i64.parse(qi[0]).unwrap_or(0);
        total += n;
        if n == 1 {
            println(f"  {e.a(t, qi[1], V.I(1))?} in stock");
        } else {
            println(f"  {e.no(t, qi[1], V.I(n))?} in stock");
        }
    }
    let words = nw(mut e, t, V.I(total))?;
    let items = e.plural(t, "item".to_string(), V.I(total))?;
    println(f"  {words} {items} in all");
    Ok(())
}

fn prog_notify(e: mut ref Eng, t: ref Tab, file: ref String) -> Result[(), PyErr] {
    let lines = data_lines(file).map_err(|m| py_err("OSError", m))?;
    for line in lines.iter() {
        if line.len() == 0 {
            continue;
        }
        let ct = split_once_on(line, "\t");
        let n = i64.parse(ct[0]).unwrap_or(0);
        e.num(V.I(n), V.B(false))?;
        match e.inflect(t, ct[1]) {
            Ok(s) => println(s),
            Err(err) => println(failure(err)),
        }
        e.num(V.N, V.N)?;
    }
    Ok(())
}

fn prog_dryrun(e: mut ref Eng, t: ref Tab, file: ref String) -> Result[(), PyErr] {
    let lines = data_lines(file).map_err(|m| py_err("OSError", m))?;
    for line in lines.iter() {
        if line.len() == 0 {
            continue;
        }
        let parts = split_on(line, " ");
        let verb = parts[0].clone();
        let n = i64.parse(parts[1]).unwrap_or(0);
        let mut rest: Vec[String] = Vec.new();
        for k in 2..parts.len() {
            rest.push(parts[k].clone());
        }
        let thing = joined(rest, " ".to_string());
        let pp = capz(e.present_participle(t, verb)?);
        println(f"{pp} {e.no(t, thing, V.I(n))?}");
    }
    Ok(())
}

fn call_text(name: ref String, args: ref Vec[V], kw: ref Vec[(String, V)]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for a in args.iter() {
        parts.push(v_repr(a));
    }
    for (k, v) in kw.iter() {
        parts.push(f"{k}={v_repr(v)}");
    }
    f"{name}({joined(parts, ", ".to_string())})"
}

fn run() -> Result[(), String] {
    let raw = load_raw(read_data("tables.json".to_string())?)?;
    let t = new_tab(raw)?;
    let jobs = data_lines("jobs.jsonl".to_string())?;
    for line in jobs.iter() {
        if line.len() == 0 {
            continue;
        }
        let j = json_line(line)?;
        println(f"== {j_str(j, "name")}");
        let mut e = new_eng();
        if let J.A(ops) = j_get(j, "ops") {
            for op in ops.iter() {
                let kind = j_str(op, "op");
                if kind == "call" {
                    let name = j_str(op, "fn");
                    let mut args: Vec[V] = Vec.new();
                    if let J.A(items) = j_get(op, "args") {
                        for it in items.iter() {
                            args.push(v_of_json(it));
                        }
                    }
                    let mut kw: Vec[(String, V)] = Vec.new();
                    if let J.O(members) = j_get(op, "kw") {
                        for (k, v) in members.iter() {
                            kw.push((k.clone(), v_of_json(v)));
                        }
                    }
                    let shown = call_text(name, args, kw);
                    match e.call_method(t, name, args, kw) {
                        Ok(r) => println(f"{shown} -> {v_repr(r)}"),
                        Err(err) => println(f"{shown} {failure(err)}"),
                    }
                    continue;
                }
                let file = j_str(op, "file");
                let r = if kind == "digest" {
                    prog_digest(mut e, t, file)
                } else if kind == "cheques" {
                    prog_cheques(mut e, t, file)
                } else if kind == "leaderboard" {
                    prog_leaderboard(mut e, t, file)
                } else if kind == "tables" {
                    prog_tables(mut e, t, file)
                } else if kind == "inventory" {
                    prog_inventory(mut e, t, file)
                } else if kind == "notify" {
                    prog_notify(mut e, t, file)
                } else {
                    prog_dryrun(mut e, t, file)
                };
                if let Err(err) = r {
                    return Err(failure(err));
                }
            }
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}


// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

