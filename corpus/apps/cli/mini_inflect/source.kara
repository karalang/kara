// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
        // and the set takes in the extra cases of each letter in it
        if not hit and not ascii {
            for x in extra_cases(lo).iter() {
                let xu = upper(*x, ascii);
                if in_items(set, *x, ascii) or (lower(xu, ascii) == *x and in_items(set, xu, ascii)) {
                    hit = true;
                }
            }
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

#[derive(Clone)]
struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if g == 0 { (m.start, m.end) } else { m.spans[g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}


// --------------------------------------------------- Unicode strings


// ------------------------------------------------------- str, as used

// An end past any string, for an open-ended slice.
fn big() -> i64 {
    1 << 62
}

fn norm_ix(i: i64, n: i64) -> i64 {
    if i < 0 {
        let j = i + n;
        if j < 0 { 0 } else { j }
    } else if i > n {
        n
    } else {
        i
    }
}

// s[a:b], counting characters, with Python's negative indices and
// clamping.
fn pys(s: ref String, a: i64, b: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len();
    let x = norm_ix(a, n);
    let y = norm_ix(b, n);
    let mut out = String.new();
    let mut i = x;
    while i < y {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// s[-k:]
fn sfx(s: ref String, k: i64) -> String {
    pys(s, -k, big())
}

// s[:-k]
fn cut(s: ref String, k: i64) -> String {
    pys(s, 0, -k)
}

fn clen(s: ref String) -> i64 {
    let mut n = 0;
    for _ in s.chars() {
        n += 1;
    }
    n
}

fn lowr(s: ref String) -> String {
    s.to_lowercase()
}

fn uppr(s: ref String) -> String {
    s.to_uppercase()
}

// str.capitalize: the first character upper case, the rest lower.
fn capz(s: ref String) -> String {
    let mut out = String.new();
    let mut first = true;
    for c in s.chars() {
        let mut one = String.new();
        one.push(c);
        if first {
            out.push_str(one.to_uppercase());
            first = false;
        } else {
            out.push_str(one.to_lowercase());
        }
    }
    out
}

fn first_char(s: ref String) -> String {
    pys(s, 0, 1)
}

// str.split(): runs of whitespace, none at either end.
fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in s.split_whitespace() {
        out.push(w.to_string());
    }
    out
}

// str.split(sep)
fn split_on(s: ref String, sep: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in s.split(sep) {
        out.push(w.to_string());
    }
    out
}

// str.split(sep, 1)
fn split_once_on(s: ref String, sep: Str) -> Vec[String] {
    let parts = split_on(s, sep);
    if parts.len() <= 1 {
        return parts;
    }
    let mut rest: Vec[String] = Vec.new();
    for i in 1..parts.len() {
        rest.push(parts[i].clone());
    }
    let mut out: Vec[String] = Vec.new();
    out.push(parts[0].clone());
    out.push(joined(rest, sep.to_string()));
    out
}

fn joined(parts: ref Vec[String], sep: ref String) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn is_py_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' or c == '\u{1c}' or c == '\u{1d}' or c == '\u{1e}' or c == '\u{1f}' or c == '\u{85}' or c == '\u{a0}' or c == '\u{2028}' or c == '\u{2029}' or c == '\u{3000}'
}

fn strip_ws(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    let mut b = cs.len();
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    str_of(sub_chars(cs, a, b))
}

fn lstrip_ws(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    while a < cs.len() and is_py_space(cs[a]) {
        a += 1;
    }
    str_of(sub_chars(cs, a, cs.len()))
}

fn lstrip_char(s: ref String, c: char) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    while a < cs.len() and cs[a] == c {
        a += 1;
    }
    str_of(sub_chars(cs, a, cs.len()))
}

fn s_repr(s: ref String) -> String {
    repr_of(cps_of(s))
}

fn cps_of(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn str_list_repr(v: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for s in v.iter() {
        parts.push(s_repr(s));
    }
    f"[{joined(parts, ", ".to_string())}]"
}

// ------------------------------------------------------ re, as used

struct Mt {
    s: Vec[i64],
    f: Found,
}

impl Mt {
    fn has(self, g: i64) -> bool {
        if g == 0 {
            return true;
        }
        self.f.spans[g - 1].0 >= 0
    }

    fn g(self, g: i64) -> String {
        if g == 0 {
            return to_string(slice(self.s, self.f.start, self.f.end));
        }
        let (a, b) = self.f.spans[g - 1];
        if a < 0 {
            return String.new();
        }
        to_string(slice(self.s, a, b))
    }
}

fn rx(p: ref String, flags: i64) -> Result[Program, String] {
    match compile(cps_of(p), flags) {
        Ok(prog) => Ok(prog),
        Err(e) => Err(f"cannot compile {p}: {err_text(e)}"),
    }
}

fn rxs(p: Str, flags: i64) -> Result[Program, String] {
    rx(p.to_string(), flags)
}

// pattern.search(s)
fn search(prog: ref Program, s: ref String) -> Option[Mt] {
    let v = cps_of(s);
    let mut m = new_matcher(prog, v);
    match find(mut m, prog, 0, false, 0) {
        Some(f) => Some(Mt { s: v, f: f }),
        None => None,
    }
}

// pattern.match(s)
fn rmatch(prog: ref Program, s: ref String) -> Option[Mt] {
    let v = cps_of(s);
    let mut m = new_matcher(prog, v);
    match find(mut m, prog, 0, false, 1) {
        Some(f) => Some(Mt { s: v, f: f }),
        None => None,
    }
}

fn hits(prog: ref Program, s: ref String) -> bool {
    search(prog, s).is_some()
}

// The matches pattern.sub(repl, s, count) replaces.
fn matches_of(prog: ref Program, s: ref String, count: i64) -> Vec[Mt] {
    let v = cps_of(s);
    let mut out: Vec[Mt] = Vec.new();
    for f in all_matches(prog, v, count).iter() {
        out.push(Mt { s: v.clone(), f: f.clone() });
    }
    out
}

// What is between and around the matches: the text before the first,
// between each pair, and after the last.
fn gaps(s: ref String, ms: ref Vec[Mt]) -> Vec[String] {
    let v = cps_of(s);
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    for m in ms.iter() {
        out.push(to_string(slice(v, i, m.f.start)));
        i = m.f.end;
    }
    out.push(to_string(slice(v, i, v.len())));
    out
}

fn re_err(e: ref ReErr) -> PyErr {
    if e.kind == "error" {
        if e.pos >= 0 {
            return py_err("PatternError", f"{e.msg} at position {e.pos}");
        }
        return py_err("PatternError", e.msg.clone());
    }
    py_err(e.kind.as_str(), e.msg.clone())
}

// pattern.sub with a template, as re does it: the template parsed once.
fn sub_tpl(prog: ref Program, repl: Str, s: ref String, count: i64) -> Result[(String, i64), PyErr] {
    let pieces = match parse_template(cps_of(repl.to_string()), prog) {
        Ok(p) => p,
        Err(e) => return Err(re_err(e)),
    };
    let ms = matches_of(prog, s, count);
    let gs = gaps(s, ms);
    let mut out: Vec[i64] = Vec.new();
    for k in 0..ms.len() {
        push_all(mut out, cps_of(gs[k]));
        expand(pieces, ms[k].s, ms[k].f, mut out);
    }
    push_all(mut out, cps_of(gs[ms.len()]));
    Ok((to_string(out), ms.len()))
}

// ---------------------------------------------------------- exceptions

struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn index_error() -> PyErr {
    py_err("IndexError", "list index out of range".to_string())
}

fn pick(v: ref Vec[String], i: i64) -> Result[String, PyErr] {
    if i < 0 or i >= v.len() {
        return Err(index_error());
    }
    Ok(v[i].clone())
}

// ------------------------------------------------------------ tables

// bysize(): the words of a list grouped by length, the lengths in the
// order they first appear.
struct BySize {
    keys: Vec[i64],
    sets: Map[i64, Set[String]],
}

fn bysize(words: ref Vec[String]) -> BySize {
    let mut keys: Vec[i64] = Vec.new();
    let mut sets: Map[i64, Set[String]] = Map.new();
    for w in words.iter() {
        let n = clen(w);
        if not sets.contains_key(n) {
            keys.push(n);
            sets.insert(n, Set.new());
        }
        if let Some(set) = sets.get_mut(n) {
            set.insert(w.clone());
        }
    }
    BySize { keys: keys, sets: sets }
}

impl BySize {
    // any(w[-k:] in v for k, v in d.items())
    fn ends(self, w: ref String) -> bool {
        for k in self.keys.iter() {
            if let Some(set) = self.sets.get(*k) {
                if set.contains(sfx(w, *k)) {
                    return true;
                }
            }
        }
        false
    }

    // v = d.get(n); v and w in v
    fn at_len_has(self, n: i64, w: ref String) -> bool {
        match self.sets.get(n) {
            Some(set) => set.contains(w),
            None => false,
        }
    }
}

fn enclose(s: ref String) -> String {
    f"(?:{s})"
}

// joinstem(cutpoint, words): each word less its last -cutpoint
// letters, as alternatives; cut 0 keeps the words whole.
fn joinstem(cutn: i64, words: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for w in words.iter() {
        parts.push(if cutn == 0 { w.clone() } else { cut(w, cutn) });
    }
    enclose(joined(parts, "|".to_string()))
}

struct PlSi {
    si_list: Vec[String],
    si_bs: BySize,
    pl_bs: BySize,
    stem: String,
}

// make_pl_si_lists(lst, plending, siendingsize); a size of 0 stands for
// None, which keeps the whole word.
fn make_pl_si(lst: ref Vec[String], plending: Str, size: i64) -> PlSi {
    let mut si: Vec[String] = Vec.new();
    for w in lst.iter() {
        let stem = if size == 0 { w.clone() } else { cut(w, size) };
        si.push(f"{stem}{plending}");
    }
    PlSi {
        si_bs: bysize(si),
        si_list: si,
        pl_bs: bysize(lst),
        stem: joinstem(size, lst),
    }
}

fn set_of(v: ref Vec[String]) -> Set[String] {
    let mut s: Set[String] = Set.new();
    for w in v.iter() {
        s.insert(w.clone());
    }
    s
}

fn map_of(pairs: ref Vec[(String, String)]) -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    for (k, v) in pairs.iter() {
        m.insert(k.clone(), v.clone());
    }
    m
}

fn values_set(pairs: ref Vec[(String, String)]) -> Set[String] {
    let mut s: Set[String] = Set.new();
    for (_, v) in pairs.iter() {
        s.insert(v.clone());
    }
    s
}

fn keys_of(pairs: ref Vec[(String, String)]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for (k, _) in pairs.iter() {
        out.push(k.clone());
    }
    out
}

fn concat(a: ref Vec[String], b: ref Vec[String]) -> Vec[String] {
    let mut out = a.clone();
    for w in b.iter() {
        out.push(w.clone());
    }
    out
}

fn prefixed(pre: Str, v: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in v.iter() {
        out.push(f"{pre}{w}");
    }
    out
}

fn suffixed(v: ref Vec[String], post: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in v.iter() {
        out.push(f"{w}{post}");
    }
    out
}

// An insertion-ordered dict, for the derivations that delete and
// re-add keys.
struct ODict {
    keys: Vec[String],
    map: Map[String, String],
}

impl ODict {
    fn set(mut ref self, k: ref String, v: ref String) {
        if not self.map.contains_key(k) {
            self.keys.push(k.clone());
        }
        self.map.insert(k.clone(), v.clone());
    }

    fn del(mut ref self, k: ref String) {
        self.map.remove(k);
        let mut keep: Vec[String] = Vec.new();
        for x in self.keys.iter() {
            if x != k {
                keep.push(x.clone());
            }
        }
        self.keys = keep;
    }
}

// {v: k for (k, v) in d.items()}, then each "a|b" key split into two.
fn invert_split(pairs: ref Vec[(String, String)]) -> Map[String, String] {
    let mut d = ODict { keys: Vec.new(), map: Map.new() };
    for (k, v) in pairs.iter() {
        d.set(v, k);
    }
    let snapshot = d.keys.clone();
    for k in snapshot.iter() {
        if k.contains("|") {
            let parts = split_on(k, "|");
            let val = d.map.get(k).unwrap().clone();
            d.set(parts[0], val);
            d.set(parts[1], val);
            d.del(k);
        }
    }
    d.map
}

fn invert(pairs: ref Vec[(String, String)]) -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    for (k, v) in pairs.iter() {
        m.insert(v.clone(), k.clone());
    }
    m
}

// A singular pronoun: one word, or one for each gender.
enum SiPron {
    One(String),
    ByGender(Vec[(String, String)]),
}

fn genders6(a: Str, b: Str, c: Str, d: Str, e: Str, f: Str) -> SiPron {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("neuter".to_string(), a.to_string()));
    v.push(("feminine".to_string(), b.to_string()));
    v.push(("masculine".to_string(), c.to_string()));
    v.push(("gender-neutral".to_string(), d.to_string()));
    v.push(("feminine or masculine".to_string(), e.to_string()));
    v.push(("masculine or feminine".to_string(), f.to_string()));
    SiPron.ByGender(v)
}

struct Raw {
    lists: Map[String, Vec[String]],
    dicts: Map[String, Vec[(String, String)]],
}

impl Raw {
    fn l(self, name: Str) -> Vec[String] {
        match self.lists.get(name.to_string()) {
            Some(v) => v.clone(),
            None => Vec.new(),
        }
    }

    fn d(self, name: Str) -> Vec[(String, String)] {
        match self.dicts.get(name.to_string()) {
            Some(v) => v.clone(),
            None => Vec.new(),
        }
    }
}

fn load_raw(text: ref String) -> Result[Raw, String] {
    let j = json_line(text)?;
    let mut lists: Map[String, Vec[String]] = Map.new();
    let mut dicts: Map[String, Vec[(String, String)]] = Map.new();
    if let J.O(members) = j {
        for (name, v) in members.iter() {
            if let J.A(items) = v {
                let mut words: Vec[String] = Vec.new();
                let mut pairs: Vec[(String, String)] = Vec.new();
                let mut is_dict = false;
                for it in items.iter() {
                    match it {
                        J.S(s) => words.push(s.clone()),
                        J.A(kv) => {
                            is_dict = true;
                            if let (J.S(k), J.S(val)) = (kv[0].clone(), kv[1].clone()) {
                                pairs.push((k, val));
                            }
                        }
                        _ => {}
                    }
                }
                if is_dict {
                    dicts.insert(name.clone(), pairs);
                } else {
                    lists.insert(name.clone(), words);
                }
            }
        }
    }
    Ok(Raw { lists: lists, dicts: dicts })
}

