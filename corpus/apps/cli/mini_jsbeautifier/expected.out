| class Queue extends Base {
|     constructor(n) {
|         super();
|         this.items = [];
|         this.limit = n
|     }
|     get size() {
|         return this.items.length
|     }* drain() {
|         while (this.items.length) yield this.items.shift()
|     }
|     push(x) {
|         switch (typeof x) {
|             case "number":
|                 x = {
|                     v: x
|                 };
|                 break;
|             case "string":
|                 x = {
|                     v: x,
|                     s: true
|                 };
|             default:
|                 if (x == null) throw new TypeError("no item")
|         }
|         outer: for (let i = 0; i < this.items.length; i++) {
|             for (const k in x) {
|                 if (this.items[i][k] === x[k]) continue outer
|             }
|         }
|         this.items.length < this.limit ? this.items.push(x) : this.items.splice(0, 1, x);
|         return this
|     }
| }
