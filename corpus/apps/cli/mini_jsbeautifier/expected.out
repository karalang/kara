| class Queue extends Base { constructor(n) { super();\r
|         this.items = [];\r
|         this.limit = n } get size() { return this.items.length }* drain() { while (this.items.length) yield this.items.shift() } push(x) { switch (typeof x) {\r
|             case "number":\r
|                 x = { v: x }; break;\r
|             case "string":\r
|                 x = { v: x, s: true };\r
|             default:\r
|                 if (x == null) throw new TypeError("no item") } outer: for (let i = 0; i < this.items.length; i++) { for (const k in x) { if (this.items[i][k] === x[k]) continue outer } } this.items.length < this.limit ? this.items.push(x) : this.items.splice(0, 1, x); return this } }\r
