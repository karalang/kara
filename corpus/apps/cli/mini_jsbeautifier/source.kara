const ID_PART: Str = "300-36f,483-487,591-5bd,5bf,5c1,5c2,5c4,5c5,5c7,610-61a,620-649,672-6d3,6e7-6e8,6fb-6fc,730-74a,800-814,81b-823,825-827,829-82d,840-857,8e4-8fe,900-903,93a-93c,93e-94f,951-957,962-963,966-96f,981-983,9bc,9be-9c4,9c7,9c8,9d7,9df-9e0,a01-a03,a3c,a3e-a42,a47,a48,a4b-a4d,a51,a66-a71,a75,a81-a83,abc,abe-ac5,ac7-ac9,acb-acd,ae2-ae3,ae6-aef,b01-b03,b3c,b3e-b44,b47,b48,b4b-b4d,b56,b57,b5f-b60,b66-b6f,b82,bbe-bc2,bc6-bc8,bca-bcd,bd7,be6-bef,c01-c03,c46-c48,c4a-c4d,c55,c56,c62-c63,c66-c6f,c82,c83,cbc,cbe-cc4,cc6-cc8,cca-ccd,cd5,cd6,ce2-ce3,ce6-cef,d02,d03,d46-d48,d57,d62-d63,d66-d6f,d82,d83,dca,dcf-dd4,dd6,dd8-ddf,df2,df3,e34-e3a,e40-e45,e50-e59,eb4-eb9,ec8-ecd,ed0-ed9,f18,f19,f20-f29,f35,f37,f39,f41-f47,f71-f84,f86-f87,f8d-f97,f99-fbc,fc6,1000-1029,1040-1049,1067-106d,1071-1074,1082-108d,108f-109d,135d-135f,170e-1710,1720-1730,1740-1750,1772,1773,1780-17b2,17dd,17e0-17e9,180b-180d,1810-1819,1920-192b,1930-193b,1951-196d,19b0-19c0,19c8-19c9,19d0-19d9,1a00-1a15,1a20-1a53,1a60-1a7c,1a7f-1a89,1a90-1a99,1b46-1b4b,1b50-1b59,1b6b-1b73,1bb0-1bb9,1be6-1bf3,1c00-1c22,1c40-1c49,1c5b-1c7d,1cd0-1cd2,1d00-1dbe,1e01-1f15,200c,200d,203f,2040,2054,20d0-20dc,20e1,20e5-20f0,2d81-2d96,2de0-2dff,3021-3028,3099,309a,a640-a66d,a674-a67d,a69f,a6f0-a6f1,a7f8-a800,a806,a80b,a823-a827,a880-a881,a8b4-a8c4,a8d0-a8d9,a8f3-a8f7,a900-a909,a926-a92d,a930-a945,a980-a983,a9b3-a9c0,aa00-aa27,aa40-aa41,aa4c-aa4d,aa50-aa59,aa7b,aae0-aae9,aaf2-aaf3,abc0-abe1,abec,abed,abf0-abf9,fb20-fb28,fe00-fe0f,fe20-fe26,fe33,fe34,fe4d-fe4f,ff10-ff19,ff3f";

fn parse_ranges(s: Str) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    for part in s.split(",") {
        let mut lo: i64 = 0;
        let mut hi: i64 = -1;
        for c in part.chars() {
            if c == '-' {
                hi = 0;
            } else if hi < 0 {
                lo = lo * 16 + hex_value(c);
            } else {
                hi = hi * 16 + hex_value(c);
            }
        }
        if hi < 0 {
            hi = lo;
        }
        out.push((lo, hi));
    }
    out
}

fn in_ranges(rs: ref Vec[(i64, i64)], n: i64) -> bool {
    let mut lo: i64 = 0;
    let mut hi = rs.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (a, b) = rs[mid];
        if n < a {
            hi = mid;
        } else if n > b {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ tokens

#[derive(Copy, Clone, PartialEq, Eq)]
enum Tk {
    Start,
    Eof,
    StartExpr,
    EndExpr,
    StartBlock,
    EndBlock,
    Word,
    Reserved,
    Semicolon,
    Strng,
    Equals,
    Operator,
    Comma,
    BlockComment,
    Comment,
    Dot,
    Unknown,
}

// core.token.Token. Links between tokens are indices into the token arena,
// -1 for None.
struct Tok {
    kind: Tk,
    text: String,
    newlines: i64,
    ws: String,
    parent: i64,
    next: i64,
    previous: i64,
    opened: i64,
    closed: i64,
    comments: Vec[i64],
    directives: Vec[(String, String)],
}

fn new_tok(kind: Tk, text: own String, newlines: i64, ws: own String) -> Tok {
    Tok {
        kind: kind,
        text: text,
        newlines: newlines,
        ws: ws,
        parent: -1,
        next: -1,
        previous: -1,
        opened: -1,
        closed: -1,
        comments: Vec.new(),
        directives: Vec.new(),
    }
}

fn directive(t: ref Tok, key: Str) -> String {
    for (k, v) in t.directives.iter() {
        if k == key {
            return v.clone();
        }
    }
    String.new()
}

const POSITIONABLE: Array[Str, 29] = [">>>", "===", "!==", "&&=", "??=", "||=", "<<", "&&", ">=", "**", "!=", "==",
                                      "<=", ">>", "||", "??", "|>", "<", "/", "-", "+", ">", ":", "&", "%", "?",
                                      "^", "|", "*"];

fn positionable(s: ref String) -> bool {
    for p in POSITIONABLE {
        if s == p {
            return true;
        }
    }
    false
}

// The punct pattern's alternatives, in order (after "?." not followed by a
// digit, which comes first).
const PUNCT: Array[Str, 49] = [">>>=", "...", ">>=", "<<=", "===", ">>>", "!==", "**=", "&&=", "??=", "||=", "=>",
                               "^=", "::", "/=", "<<", "<=", "==", "&&", "-=", ">=", ">>", "!=", "--", "+=", "**",
                               "||", "??", "++", "%=", "&=", "*=", "|=", "|>", "=", "!", "?", ">", "<", ":", "/",
                               "^", "-", "+", "*", "&", "%", "~", "|"];

const LINE_STARTERS: Array[Str, 17] = ["continue", "try", "throw", "return", "var", "let", "const", "if", "switch",
                                       "case", "default", "for", "while", "break", "function", "import", "export"];

const RESERVED_MORE: Array[Str, 17] = ["do", "in", "of", "else", "get", "set", "new", "catch", "finally", "typeof",
                                       "yield", "async", "await", "from", "as", "class", "extends"];

fn line_starter(s: ref String) -> bool {
    for w in LINE_STARTERS {
        if s == w {
            return true;
        }
    }
    false
}

fn reserved_word_text(s: ref String) -> bool {
    if line_starter(s) {
        return true;
    }
    for w in RESERVED_MORE {
        if s == w {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ the tokenizer

// The templating languages a pattern reads through (TemplatablePattern's
// _disabled flags, inverted): only django, erb, handlebars and php can be on
// for JavaScript; smarty and angular stay off.
struct Templates {
    django: bool,
    erb: bool,
    handlebars: bool,
    php: bool,
}

// What a pattern reads until: the quote and template-literal patterns.
#[derive(Copy, Clone, PartialEq, Eq)]
enum Until {
    Single,
    Double,
    TemplateText,
    TemplateExpr,
}

// javascript.tokenizer.Tokenizer over core.inputscanner.InputScanner. The
// input is a vector of code points, as a Python str is indexed.
struct Lexer {
    cs: Vec[char],
    n: i64,
    pos: i64,
    newline_count: i64,
    ws_before: String,
    tpl: Templates,
    unescape: bool,
    e4x: bool,
    in_html_comment: bool,
    has_char_escapes: bool,
    id_start: Vec[(i64, i64)],
    id_part: Vec[(i64, i64)],
    toks: Vec[Tok],
    stream: Vec[i64],
}

fn new_lexer(text: ref String, opts: ref Opts, id_start: ref Vec[(i64, i64)], id_part: ref Vec[(i64, i64)]) -> Lexer {
    let cs = chars_of(text);
    let n = cs.len() as i64;
    let on = |name: Str| opts.templating.iter().any(|t| t == name);
    let tpl = Templates { django: on("django"), erb: on("erb"), handlebars: on("handlebars"), php: on("php") };
    let mut toks: Vec[Tok] = Vec.new();
    // 0: the START_BLOCK token every BeautifierFlags starts with; 1: the
    // START token the first token's `previous` points at.
    toks.push(new_tok(Tk.StartBlock, String.new(), 0, String.new()));
    toks.push(new_tok(Tk.Start, String.new(), 0, String.new()));
    Lexer {
        cs: cs,
        n: n,
        pos: 0,
        newline_count: 0,
        ws_before: String.new(),
        tpl: tpl,
        unescape: opts.unescape_strings,
        e4x: opts.e4x,
        in_html_comment: false,
        has_char_escapes: false,
        id_start: id_start.clone(),
        id_part: id_part.clone(),
        toks: toks,
        stream: Vec.new(),
    }
}

impl Lexer {
    // ---- InputScanner

    fn has_next(ref self) -> bool {
        self.pos < self.n
    }

    fn peek_at(ref self, k: i64) -> Option[char] {
        let i = self.pos + k;
        if i >= 0 and i < self.n { Some(self.cs[i]) } else { None }
    }

    fn peek_is(ref self, k: i64, c: char) -> bool {
        match self.peek_at(k) {
            Some(d) => d == c,
            None => false,
        }
    }

    fn next_char(mut ref self) -> String {
        if self.pos < self.n {
            let c = self.cs[self.pos];
            self.pos += 1;
            let mut s = String.new();
            s.push(c);
            return s;
        }
        String.new()
    }

    fn back(mut ref self) {
        if self.pos > 0 {
            self.pos -= 1;
        }
    }

    fn at(ref self, i: i64, s: Str) -> bool {
        let mut k = i;
        for c in s.chars() {
            if k >= self.n or self.cs[k] != c {
                return false;
            }
            k += 1;
        }
        true
    }

    fn take(mut ref self, end: i64) -> String {
        let s = text_of(self.cs, self.pos, end);
        self.pos = end;
        s
    }

    // ---- character classes

    fn ident_start_char(ref self, c: char) -> bool {
        let n = c as u32 as i64;
        if n < 128 {
            return c == '#' or c == '$' or c == '@' or c.is_ascii_alphabetic() or c == '_';
        }
        in_ranges(self.id_start, n)
    }

    fn ident_char(ref self, c: char) -> bool {
        let n = c as u32 as i64;
        if n < 128 {
            return c == '$' or c.is_ascii_alphanumeric() or c == '_';
        }
        in_ranges(self.id_start, n) or in_ranges(self.id_part, n)
    }

    // \\u[0-9a-fA-F]{4}|\\u\{[0-9a-fA-F]+\} at i: the end, or -1.
    fn unicode_escape(ref self, i: i64) -> i64 {
        if not (self.at(i, "\\u")) {
            return -1;
        }
        if i + 5 < self.n and hex_digit(self.cs[i + 2]) and hex_digit(self.cs[i + 3]) and hex_digit(self.cs[i + 4])
            and hex_digit(self.cs[i + 5]) {
            return i + 6;
        }
        if i + 2 < self.n and self.cs[i + 2] == '{' {
            let mut j = i + 3;
            while j < self.n and hex_digit(self.cs[j]) {
                j += 1;
            }
            if j > i + 3 and j < self.n and self.cs[j] == '}' {
                return j + 1;
            }
        }
        -1
    }

    // One identifier character (or escape) at i: its end, or -1.
    fn ident_unit(ref self, i: i64, start: bool) -> i64 {
        let e = self.unicode_escape(i);
        if e >= 0 {
            return e;
        }
        if i < self.n {
            let c = self.cs[i];
            if (start and self.ident_start_char(c)) or (not start and self.ident_char(c)) {
                return i + 1;
            }
        }
        -1
    }

    // acorn.identifier at i: the end, or -1.
    fn identifier_end(ref self, i: i64) -> i64 {
        let mut e = self.ident_unit(i, true);
        if e < 0 {
            return -1;
        }
        loop {
            let f = self.ident_unit(e, false);
            if f < 0 {
                return e;
            }
            e = f;
        }
    }

    // acorn.identifierMatch at i: the end, or -1.
    fn identifier_match_end(ref self, i: i64) -> i64 {
        let mut e = self.ident_unit(i, false);
        if e < 0 {
            return -1;
        }
        loop {
            let f = self.ident_unit(e, false);
            if f < 0 {
                return e;
            }
            e = f;
        }
    }

    fn digit_at(ref self, i: i64) -> bool {
        i < self.n and self.cs[i].is_ascii_digit()
    }

    fn digit_us_at(ref self, i: i64) -> bool {
        i < self.n and (self.cs[i].is_ascii_digit() or self.cs[i] == '_')
    }

    // number_pattern at i: the end, or -1.
    fn number_end(ref self, i: i64) -> i64 {
        if i >= self.n {
            return -1;
        }
        if self.cs[i] == '0' and i + 1 < self.n {
            let x = self.cs[i + 1];
            if x == 'x' or x == 'X' or x == 'o' or x == 'O' or x == 'b' or x == 'B' {
                let mut j = i + 2;
                while j < self.n {
                    let c = self.cs[j];
                    let ok = if x == 'x' or x == 'X' {
                        hex_digit(c) or c == '_'
                    } else if x == 'o' or x == 'O' {
                        (c >= '0' and c <= '7') or c == '_'
                    } else {
                        c == '0' or c == '1' or c == '_'
                    };
                    if not ok {
                        break;
                    }
                    j += 1;
                }
                if j < self.n and self.cs[j] == 'n' {
                    j += 1;
                }
                return j;
            }
        }
        // \d[\d_]*n
        if self.digit_at(i) {
            let mut j = i + 1;
            while self.digit_us_at(j) {
                j += 1;
            }
            if j < self.n and self.cs[j] == 'n' {
                return j + 1;
            }
        }
        // (?:\.\d[\d_]*|\d[\d_]*\.?[\d_]*)(?:[eE][+-]?[\d_]+)?
        let mut j = -1;
        if self.cs[i] == '.' and self.digit_at(i + 1) {
            j = i + 2;
            while self.digit_us_at(j) {
                j += 1;
            }
        } else if self.digit_at(i) {
            j = i + 1;
            while self.digit_us_at(j) {
                j += 1;
            }
            if j < self.n and self.cs[j] == '.' {
                j += 1;
            }
            while self.digit_us_at(j) {
                j += 1;
            }
        }
        if j < 0 {
            return -1;
        }
        if j < self.n and (self.cs[j] == 'e' or self.cs[j] == 'E') {
            let mut k = j + 1;
            if k < self.n and (self.cs[k] == '+' or self.cs[k] == '-') {
                k += 1;
            }
            if self.digit_us_at(k) {
                while self.digit_us_at(k) {
                    k += 1;
                }
                return k;
            }
        }
        j
    }

    // \r\n|[\n\r  ] at i: the end, or -1.
    fn line_break_end(ref self, i: i64) -> i64 {
        if i >= self.n {
            return -1;
        }
        if self.cs[i] == '\r' and i + 1 < self.n and self.cs[i + 1] == '\n' {
            return i + 2;
        }
        if js_newline(self.cs[i]) { i + 1 } else { -1 }
    }

    // readUntil(pattern, include_match) for a pattern given by its search:
    // `found` is (start, end) of the first match, or (-1, -1).
    fn read_until_found(mut ref self, found: (i64, i64), include: bool) -> String {
        if not self.has_next() {
            return String.new();
        }
        let (s, e) = found;
        let end = if s < 0 { self.n } else if include { e } else { s };
        self.take(end)
    }

    // Search for a literal from the current position.
    fn search_lit(ref self, lit: Str) -> (i64, i64) {
        let len = lit.chars().count() as i64;
        let mut i = self.pos;
        while i + len <= self.n {
            if self.at(i, lit) {
                return (i, i + len);
            }
            i += 1;
        }
        (-1, -1)
    }

    fn search_line_break(ref self) -> (i64, i64) {
        let mut i = self.pos;
        while i < self.n {
            let e = self.line_break_end(i);
            if e >= 0 {
                return (i, e);
            }
            i += 1;
        }
        (-1, -1)
    }

    // Pattern.starting_with(lit).until_after(end_lit).read()
    fn read_between(mut ref self, start: Str, end_lit: Str) -> String {
        if not self.at(self.pos, start) {
            return String.new();
        }
        let len = start.chars().count() as i64;
        let mut s = self.take(self.pos + len);
        let found = self.search_lit(end_lit);
        s.push_str(self.read_until_found(found, true));
        s
    }

    // ---- the whitespace pattern

    fn ws_char(c: char) -> bool {
        let n = c as u32;
        c == '\t' or c == ' ' or c == '\n' or c == '\r' or n == 0xa0 or n == 0x1680 or n == 0x180e
            or (n >= 0x2000 and n <= 0x200a) or n == 0x202f or n == 0x205f or n == 0x3000 or n == 0xfeff
            or n == 0x2028 or n == 0x2029
    }

    fn read_whitespace(mut ref self) {
        self.newline_count = 0;
        self.ws_before = String.new();
        let start = self.pos;
        let mut j = self.pos;
        while j < self.n and Lexer.ws_char(self.cs[j]) {
            j += 1;
        }
        if j == start {
            return;
        }
        if j == start + 1 and self.cs[start] == ' ' {
            self.pos = j;
            self.ws_before = " ".to_string();
            return;
        }
        // split on \r\n|[  \n\r]
        let mut count = 0;
        let mut last = start;
        let mut i = start;
        while i < j {
            let c = self.cs[i];
            if c == '\r' and i + 1 < j and self.cs[i + 1] == '\n' {
                count += 1;
                i += 2;
                last = i;
            } else if c == '\n' or c == '\r' or c == '\u{2028}' or c == '\u{2029}' {
                count += 1;
                i += 1;
                last = i;
            } else {
                i += 1;
            }
        }
        self.newline_count = count;
        self.ws_before = text_of(self.cs, last, j);
        self.pos = j;
    }

    fn create(mut ref self, kind: Tk, text: own String) -> i64 {
        let t = new_tok(kind, text, self.newline_count, self.ws_before.clone());
        self.toks.push(t);
        self.toks.len() as i64 - 1
    }

    // ---- templates (TemplatablePattern)

    // A template's start at i, as the template pattern's alternatives
    // match it.
    fn template_start_at(ref self, i: i64) -> i64 {
        if self.tpl.php and self.at(i, "<?") {
            if self.at(i + 2, "=") or self.at(i + 2, " ") {
                return i + 3;
            }
            if self.at(i + 2, "php") {
                return i + 5;
            }
        }
        if self.tpl.handlebars and self.at(i, "{{") {
            return i + 2;
        }
        if self.tpl.erb and self.at(i, "<%") and i + 2 < self.n and self.cs[i + 2] != '%' {
            return i + 3;
        }
        if self.tpl.django and (self.at(i, "{%") or self.at(i, "{{") or self.at(i, "{#")) {
            return i + 2;
        }
        -1
    }

    fn until_char(c: char, u: Until) -> bool {
        match u {
            Until.Single => c == '\'' or c == '\\' or js_newline(c),
            Until.Double => c == '"' or c == '\\' or js_newline(c),
            Until.TemplateText => c == '`' or c == '\\' or c == '$',
            Until.TemplateExpr => c == '`' or c == '}' or c == '\\',
        }
    }

    // readUntil(template_pattern) for a pattern that reads until `u`.
    fn read_until_template(mut ref self, u: Until) -> String {
        if not self.has_next() {
            return String.new();
        }
        let mut i = self.pos;
        while i < self.n {
            if self.template_start_at(i) >= 0 or Lexer.until_char(self.cs[i], u) {
                break;
            }
            i += 1;
        }
        self.take(i)
    }

    // TemplatablePattern._read_template
    fn read_template(mut ref self) -> String {
        let mut s = String.new();
        if self.peek_is(0, '<') {
            if self.tpl.php and self.peek_is(1, '?') {
                if self.at(self.pos, "<?=") {
                    s = self.read_between("<?=", "?>");
                } else if self.at(self.pos, "<? ") {
                    s = self.read_between("<? ", "?>");
                } else if self.at(self.pos, "<?php") {
                    s = self.read_between("<?php", "?>");
                }
            }
            if s == "" and self.tpl.erb and self.peek_is(1, '%') {
                if self.pos + 2 < self.n and self.cs[self.pos + 2] != '%' {
                    s = self.take(self.pos + 3);
                    // until_after [^%]%>
                    let mut found = (-1, -1);
                    let mut i = self.pos;
                    while i + 2 < self.n {
                        if self.cs[i] != '%' and self.cs[i + 1] == '%' and self.cs[i + 2] == '>' {
                            found = (i, i + 3);
                            break;
                        }
                        i += 1;
                    }
                    s.push_str(self.read_until_found(found, true));
                }
            }
        } else if self.peek_is(0, '{') {
            if self.tpl.handlebars {
                s = self.read_between("{{!--", "--}}");
                if s == "" {
                    s = self.read_between("{{{", "}}}");
                }
                if s == "" {
                    s = self.read_between("{{", "}}");
                }
            }
            if self.tpl.django {
                if s == "" {
                    s = self.read_between("{{", "}}");
                }
                if s == "" {
                    s = self.read_between("{#", "#}");
                }
                if s == "" {
                    s = self.read_between("{%", "%}");
                }
            }
        }
        s
    }

    // A templatable pattern that reads until `u` (the quote patterns).
    fn read_templatable(mut ref self, u: Until) -> String {
        let mut result = self.read_until_template(u);
        let mut next = self.read_template();
        while next != "" {
            next.push_str(self.read_until_template(u));
            result.push_str(next);
            next = self.read_template();
        }
        result
    }

    // The identifier pattern: acorn.identifier, then templates and
    // identifierMatch in turn.
    fn read_identifier(mut ref self) -> String {
        let mut result = String.new();
        let e = self.identifier_end(self.pos);
        if e >= 0 {
            result = self.take(e);
        }
        let mut next = self.read_template();
        while next != "" {
            if self.has_next() {
                let f = self.identifier_match_end(self.pos);
                if f >= 0 {
                    next.push_str(self.take(f));
                }
            }
            result.push_str(next);
            next = self.read_template();
        }
        result
    }
}

// One match of the e4x xmlRegExp: where it ends, group 1 (a "/" after the
// "<"), group 2 (the tag name) and the last group (a "/" before the ">").
struct XmlMatch {
    end: i64,
    end_tag: bool,
    name: String,
    singleton_slash: bool,
}

fn xml_name_char(c: char) -> bool {
    c.is_ascii_alphanumeric() or c == '-' or c == ':' or c == '_' or c == '.'
}

// re.sub(r"^{\s+", "{", re.sub(r"\s+}$", "}", tag))
fn trim_curly(tag: ref String) -> String {
    let cs = chars_of(tag);
    let n = cs.len() as i64;
    let mut end = n;
    if n > 0 and cs[n - 1] == '}' {
        let mut k = n - 1;
        while k > 0 and py_space(cs[k - 1]) {
            k -= 1;
        }
        if k < n - 1 {
            end = k;
        }
    }
    let mut start = 0;
    if n > 0 and cs[0] == '{' {
        let mut k = 1;
        while k < end and py_space(cs[k]) {
            k += 1;
        }
        if k > 1 {
            start = k;
        }
    }
    let mut out = String.new();
    if start > 0 {
        out.push('{');
    }
    out.push_str(text_of(cs, start, end));
    if end < n {
        out.push('}');
    }
    out
}

impl Lexer {
    // ---- the e4x tag matcher: xmlRegExp from one "<", with the regex's
    // backtracking order.

    fn skip_space(ref self, i: i64) -> i64 {
        let mut j = i;
        while j < self.n and py_space(self.cs[j]) {
            j += 1;
        }
        j
    }

    // {[^}]+?} at i
    fn curly_end(ref self, i: i64) -> i64 {
        if i >= self.n or self.cs[i] != '{' or i + 1 >= self.n or self.cs[i + 1] == '}' {
            return -1;
        }
        let mut j = i + 1;
        while j < self.n and self.cs[j] != '}' {
            j += 1;
        }
        if j < self.n { j + 1 } else { -1 }
    }

    fn name_end(ref self, i: i64) -> i64 {
        let mut j = i;
        while j < self.n and xml_name_char(self.cs[j]) {
            j += 1;
        }
        if j > i { j } else { -1 }
    }

    // An attribute value: '[^']*' | "[^"]*" | {([^{}]|{[^}]+?})+?}
    fn value_end(ref self, i: i64) -> i64 {
        if i >= self.n {
            return -1;
        }
        let q = self.cs[i];
        if q == '\'' or q == '"' {
            let mut j = i + 1;
            while j < self.n and self.cs[j] != q {
                j += 1;
            }
            return if j < self.n { j + 1 } else { -1 };
        }
        if q != '{' {
            return -1;
        }
        let mut j = i + 1;
        let mut items = 0;
        while j < self.n {
            let c = self.cs[j];
            if c == '}' {
                return if items > 0 { j + 1 } else { -1 };
            }
            if c == '{' {
                let e = self.curly_end(j);
                if e < 0 {
                    return -1;
                }
                j = e;
            } else {
                j += 1;
            }
            items += 1;
        }
        -1
    }

    // \s*(\/?)\s*> at i: (end, slash), end -1 on failure.
    fn tag_tail(ref self, i: i64) -> (i64, bool) {
        let mut j = self.skip_space(i);
        let mut slash = false;
        if j < self.n and self.cs[j] == '/' {
            slash = true;
            j += 1;
        }
        j = self.skip_space(j);
        if j < self.n and self.cs[j] == '>' { (j + 1, slash) } else { (-1, false) }
    }

    // (attribute)* then the tail, trying another attribute first.
    fn tag_attrs(ref self, i: i64) -> (i64, bool) {
        // \s*{[^}]+?}
        let a = self.curly_end(self.skip_space(i));
        if a >= 0 {
            let r = self.tag_attrs(a);
            if r.0 >= 0 {
                return r;
            }
        }
        let s = self.skip_space(i);
        if s > i {
            // \s+[-a-zA-Z:0-9_.]+
            let b = self.name_end(s);
            if b >= 0 {
                let r = self.tag_attrs(b);
                if r.0 >= 0 {
                    return r;
                }
                // \s+name\s*=\s*value
                let eq = self.skip_space(b);
                if eq < self.n and self.cs[eq] == '=' {
                    let v = self.value_end(self.skip_space(eq + 1));
                    if v >= 0 {
                        let r2 = self.tag_attrs(v);
                        if r2.0 >= 0 {
                            return r2;
                        }
                    }
                }
            }
        }
        self.tag_tail(i)
    }

    // The tag starting with "<" at lt.
    fn match_tag(ref self, lt: i64) -> Option[XmlMatch] {
        for slash in [true, false] {
            let mut i = lt + 1;
            if slash {
                if i < self.n and self.cs[i] == '/' {
                    i += 1;
                } else {
                    continue;
                }
            }
            // ([-a-zA-Z:0-9_.]+|{[^}]+?}|!\[CDATA\[[^\]]*?\]\]|)
            let mut names: Vec[i64] = Vec.new();
            let a = self.name_end(i);
            if a >= 0 {
                names.push(a);
            }
            let b = self.curly_end(i);
            if b >= 0 {
                names.push(b);
            }
            if self.at(i, "![CDATA[") {
                let mut j = i + 8;
                while j < self.n and self.cs[j] != ']' {
                    j += 1;
                }
                if self.at(j, "]]") {
                    names.push(j + 2);
                }
            }
            names.push(i);
            for k in names {
                let (end, last) = self.tag_attrs(k);
                if end >= 0 {
                    return Some(XmlMatch { end: end, end_tag: slash, name: text_of(self.cs, i, k), singleton_slash: last });
                }
            }
        }
        None
    }

    // self._patterns.xml.read_match(): [\s\S]*? up to the first "<" that
    // starts a tag. On a match the position moves past it.
    fn xml_read_match(mut ref self) -> Option[(String, XmlMatch)] {
        if not self.has_next() {
            return None;
        }
        let mut p = self.pos;
        while p < self.n {
            if self.cs[p] == '<' {
                match self.match_tag(p) {
                    Some(m) => {
                        let whole = text_of(self.cs, self.pos, m.end);
                        self.pos = m.end;
                        return Some((whole, m));
                    }
                    None => {}
                }
            }
            p += 1;
        }
        None
    }

    // ---- the token readers

    fn tokenize(mut ref self) {
        let mut previous: i64 = 1;
        let mut open: i64 = -1;
        let mut open_stack: Vec[i64] = Vec.new();
        while self.toks[previous].kind != Tk.Eof {
            let current = self.next_with_comments(previous, open);
            let ck = self.toks[current].kind;
            if ck == Tk.StartBlock or ck == Tk.StartExpr {
                open_stack.push(open);
                open = current;
            } else if open >= 0 and (ck == Tk.EndBlock or ck == Tk.EndExpr) {
                let ct = self.toks[current].text.clone();
                let ot = self.toks[open].text.clone();
                if (ct == "]" and ot == "[") or (ct == ")" and ot == "(") or (ct == "}" and ot == "{") {
                    self.toks[current].opened = open;
                    self.toks[open].closed = current;
                    open = open_stack.pop().unwrap_or(-1);
                    self.toks[current].parent = open;
                }
            }
            self.stream.push(current);
            previous = current;
        }
    }

    fn is_comment_kind(k: Tk) -> bool {
        k == Tk.Comment or k == Tk.BlockComment or k == Tk.Unknown
    }

    fn next_with_comments(mut ref self, previous: i64, open: i64) -> i64 {
        let mut current = self.next_token(previous, open);
        if Lexer.is_comment_kind(self.toks[current].kind) {
            let mut comments: Vec[i64] = Vec.new();
            while Lexer.is_comment_kind(self.toks[current].kind) {
                comments.push(current);
                current = self.next_token(previous, open);
            }
            self.toks[current].comments = comments;
        }
        self.toks[current].parent = open;
        self.toks[current].previous = previous;
        self.toks[previous].next = current;
        current
    }

    fn next_token(mut ref self, previous: i64, open: i64) -> i64 {
        self.read_whitespace();
        let c = match self.peek_at(0) {
            Some(c) => c,
            None => return self.create(Tk.Eof, String.new()),
        };
        let mut t = self.read_non_javascript(c);
        if t < 0 {
            t = self.read_string(c);
        }
        if t < 0 {
            t = self.read_pair(c);
        }
        if t < 0 {
            t = self.read_word(previous);
        }
        if t < 0 {
            t = self.read_singles(c);
        }
        if t < 0 {
            t = self.read_comment(c);
        }
        if t < 0 {
            t = self.read_regexp(c, previous);
        }
        if t < 0 {
            t = self.read_xml(c, previous);
        }
        if t < 0 {
            t = self.read_punctuation();
        }
        if t < 0 {
            let s = self.next_char();
            t = self.create(Tk.Unknown, s);
        }
        t
    }

    fn read_singles(mut ref self, c: char) -> i64 {
        let kind = match c {
            '(' | '[' => Tk.StartExpr,
            ')' | ']' => Tk.EndExpr,
            '{' => Tk.StartBlock,
            '}' => Tk.EndBlock,
            ';' => Tk.Semicolon,
            ',' => Tk.Comma,
            '.' => {
                match self.peek_at(1) {
                    Some(d) => if d.is_ascii_digit() or d == '.' { return -1; } else { Tk.Dot },
                    None => return -1,
                }
            }
            _ => return -1,
        };
        let s = self.next_char();
        self.create(kind, s)
    }

    fn read_pair(mut ref self, c: char) -> i64 {
        if c == '#' and self.peek_is(1, '{') {
            let t = self.create(Tk.StartBlock, "#{".to_string());
            self.pos += 2;
            return t;
        }
        -1
    }

    fn read_word(mut ref self, previous: i64) -> i64 {
        let s = self.read_identifier();
        if s != "" {
            let word = normalize_breaks(s);
            let pk = self.toks[previous].kind;
            let pt = self.toks[previous].text.clone();
            if not (pk == Tk.Dot or (pk == Tk.Reserved and (pt == "set" or pt == "get"))) and reserved_word_text(word) {
                if (word == "in" or word == "of") and (pk == Tk.Word or pk == Tk.Strng) {
                    return self.create(Tk.Operator, word);
                }
                return self.create(Tk.Reserved, word);
            }
            return self.create(Tk.Word, word);
        }
        let e = if self.has_next() { self.number_end(self.pos) } else { -1 };
        if e > self.pos {
            let num = self.take(e);
            return self.create(Tk.Word, num);
        }
        -1
    }

    fn read_comment(mut ref self, c: char) -> i64 {
        if c != '/' {
            return -1;
        }
        if self.peek_is(1, '*') {
            let start = self.pos;
            self.pos += 2;
            let found = self.search_lit("*/");
            let mut comment = text_of(self.cs, start, self.pos);
            comment.push_str(self.read_until_found(found, true));
            let directives = get_directives(comment);
            let mut dirs: Vec[(String, String)] = Vec.new();
            let mut ignore_start = false;
            match directives {
                Some(d) => {
                    for (k, v) in d.iter() {
                        if k == "ignore" and v == "start" {
                            ignore_start = true;
                        }
                    }
                    dirs = d;
                }
                None => {}
            }
            if ignore_start {
                let found_end = self.search_ignore_end();
                comment.push_str(self.read_until_found(found_end, true));
            }
            let text = normalize_breaks(comment);
            let t = self.create(Tk.BlockComment, text);
            self.toks[t].directives = dirs;
            return t;
        }
        if self.peek_is(1, '/') {
            let start = self.pos;
            self.pos += 2;
            let mut i = self.pos;
            while i < self.n and not js_newline(self.cs[i]) {
                i += 1;
            }
            let mut comment = text_of(self.cs, start, self.pos);
            let found = if i < self.n { (i, i + 1) } else { (-1, -1) };
            comment.push_str(self.read_until_found(found, false));
            return self.create(Tk.Comment, comment);
        }
        -1
    }

    // /\*\sbeautify\signore:end\s\*/
    fn search_ignore_end(ref self) -> (i64, i64) {
        let mut i = self.pos;
        while i + 25 <= self.n {
            if self.at(i, "/*") and py_space(self.cs[i + 2]) and self.at(i + 3, "beautify") and py_space(self.cs[i + 11])
                and self.at(i + 12, "ignore:end") and py_space(self.cs[i + 22]) and self.at(i + 23, "*/") {
                return (i, i + 25);
            }
            i += 1;
        }
        (-1, -1)
    }

    fn read_string(mut ref self, c: char) -> i64 {
        if c != '`' and c != '\'' and c != '"' {
            return -1;
        }
        let mut s = self.next_char();
        self.has_char_escapes = false;
        if c == '`' {
            s.push_str(self.parse_string('`', true, "${"));
        } else {
            s.push_str(self.parse_string(c, false, ""));
        }
        if self.has_char_escapes and self.unescape {
            s = unescape_string(s);
        }
        if self.peek_is(0, c) {
            s.push_str(self.next_char());
        }
        let text = normalize_breaks(s);
        self.create(Tk.Strng, text)
    }

    // parse_string(delimiter, allow_unescaped_newlines, start_sub); "" for
    // a start_sub of None.
    fn parse_string(mut ref self, delimiter: char, allow_newlines: bool, start_sub: Str) -> String {
        let u = match delimiter {
            '\'' => Until.Single,
            '"' => Until.Double,
            '`' => Until.TemplateText,
            _ => Until.TemplateExpr,
        };
        let mut result = self.read_templatable(u);
        while self.has_next() {
            let ch = self.cs[self.pos];
            let mut next = self.next_char();
            if ch == delimiter or (not allow_newlines and js_newline(ch)) {
                self.back();
                break;
            } else if ch == '\\' and self.has_next() {
                let cur = self.cs[self.pos];
                if cur == 'x' or cur == 'u' {
                    self.has_char_escapes = true;
                } else if cur == '\r' and self.peek_is(1, '\n') {
                    self.pos += 1;
                }
                next.push_str(self.next_char());
            } else if start_sub != "" {
                if start_sub == "${" and ch == '$' and self.peek_is(0, '{') {
                    next.push_str(self.next_char());
                }
                if next == start_sub {
                    if delimiter == '`' {
                        next.push_str(self.parse_string('}', allow_newlines, "`"));
                    } else {
                        next.push_str(self.parse_string('`', allow_newlines, "${"));
                    }
                    if self.has_next() {
                        next.push_str(self.next_char());
                    }
                }
            }
            next.push_str(self.read_templatable(u));
            result.push_str(next);
        }
        result
    }

    fn read_regexp(mut ref self, c: char, previous: i64) -> i64 {
        if c != '/' or not self.allow_regex_or_xml(previous) {
            return -1;
        }
        let mut s = self.next_char();
        let mut esc = false;
        let mut in_class = false;
        while self.has_next() {
            let p = self.cs[self.pos];
            if not (esc or in_class or p != c) or js_newline(p) {
                break;
            }
            s.push(p);
            if not esc {
                esc = p == '\\';
                if p == '[' {
                    in_class = true;
                } else if p == ']' {
                    in_class = false;
                }
            } else {
                esc = false;
            }
            self.pos += 1;
        }
        if self.peek_is(0, c) {
            s.push_str(self.next_char());
            if self.has_next() {
                let e = self.identifier_end(self.pos);
                if e >= 0 {
                    s.push_str(self.take(e));
                }
            }
        }
        self.create(Tk.Strng, s)
    }

    fn allow_regex_or_xml(ref self, previous: i64) -> bool {
        let p = ref self.toks[previous];
        if p.kind == Tk.Reserved {
            for w in ["return", "case", "throw", "else", "do", "typeof", "yield"] {
                if p.text == w {
                    return true;
                }
            }
        }
        if p.kind == Tk.EndExpr and p.text == ")" and p.opened >= 0 {
            let before = ref self.toks[self.toks[p.opened].previous];
            if before.kind == Tk.Reserved and (before.text == "if" or before.text == "while" or before.text == "for") {
                return true;
            }
        }
        match p.kind {
            Tk.Comment | Tk.StartExpr | Tk.StartBlock | Tk.Start | Tk.EndBlock | Tk.Operator | Tk.Equals | Tk.Eof
                | Tk.Semicolon | Tk.Comma => true,
            _ => false,
        }
    }

    fn read_xml(mut ref self, c: char, previous: i64) -> i64 {
        if not (self.e4x and c == '<' and self.allow_regex_or_xml(previous)) {
            return -1;
        }
        let first = self.xml_read_match();
        let (whole0, m0) = match first {
            Some(x) => x,
            None => return -1,
        };
        if m0.end_tag {
            return -1;
        }
        let root = trim_curly(m0.name);
        let curly_root = root.starts_with("{");
        let mut depth = 0;
        let mut xml = String.new();
        let mut closed = false;
        let mut current: Option[(String, XmlMatch)] = Some((whole0, m0));
        loop {
            let (whole, m) = match current {
                Some(x) => x,
                None => break,
            };
            let singleton = m.singleton_slash or m.name.starts_with("![CDATA[");
            if not singleton and (m.name == root or (curly_root and trim_curly(m.name) != "")) {
                if m.end_tag {
                    depth -= 1;
                } else {
                    depth += 1;
                }
            }
            xml.push_str(whole);
            if depth <= 0 {
                closed = true;
                break;
            }
            current = self.xml_read_match();
        }
        if not closed {
            let rest = self.take(self.n);
            xml.push_str(rest);
        }
        let text = normalize_breaks(xml);
        self.create(Tk.Strng, text)
    }

    fn read_non_javascript(mut ref self, c: char) -> i64 {
        if c == '#' {
            if self.stream.len() == 0 and self.at(self.pos, "#!") {
                let start = self.pos;
                self.pos += 2;
                let found = self.search_line_break();
                let mut s = text_of(self.cs, start, self.pos);
                s.push_str(self.read_until_found(found, true));
                let mut text = py_strip(s);
                text.push('\n');
                return self.create(Tk.Unknown, text);
            }
            if self.at(self.pos, "#include") {
                let start = self.pos;
                self.pos += 8;
                let found = self.search_line_break();
                let mut s = text_of(self.cs, start, self.pos);
                s.push_str(self.read_until_found(found, true));
                let mut text = py_strip(s);
                text.push('\n');
                return self.create(Tk.Unknown, text);
            }
            self.pos += 1;
            let mut sharp = "#".to_string();
            if self.has_next() and self.cs[self.pos].is_ascii_digit() {
                let mut ch = '#';
                loop {
                    ch = self.cs[self.pos];
                    self.pos += 1;
                    sharp.push(ch);
                    if not self.has_next() or ch == '#' or ch == '=' {
                        break;
                    }
                }
                if ch == '#' {
                } else if self.peek_is(0, '[') and self.peek_is(1, ']') {
                    sharp.push_str("[]");
                    self.pos += 2;
                } else if self.peek_is(0, '{') and self.peek_is(1, '}') {
                    sharp.push_str("{}");
                    self.pos += 2;
                }
                return self.create(Tk.Word, sharp);
            }
            self.back();
        } else if c == '<' and self.stream.len() == 0 {
            if self.at(self.pos, "<!--") {
                self.pos += 4;
                let mut s = "<!--".to_string();
                while self.has_next() and not js_newline(self.cs[self.pos]) {
                    s.push(self.cs[self.pos]);
                    self.pos += 1;
                }
                self.in_html_comment = true;
                return self.create(Tk.Comment, s);
            }
        } else if c == '-' and self.in_html_comment and self.at(self.pos, "-->") {
            self.pos += 3;
            self.in_html_comment = false;
            return self.create(Tk.Comment, "-->".to_string());
        }
        -1
    }

    fn read_punctuation(mut ref self) -> i64 {
        if self.at(self.pos, "?.") and not self.digit_at(self.pos + 2) {
            self.pos += 2;
            return self.create(Tk.Dot, "?.".to_string());
        }
        // .iter(): a bare `for` over the const is taken to borrow self
        // (B-2026-10-24-25).
        for p in PUNCT.iter() {
            if self.at(self.pos, p) {
                let len = p.chars().count() as i64;
                self.pos += len;
                let kind = if p == "=" { Tk.Equals } else { Tk.Operator };
                return self.create(kind, p.to_string());
            }
        }
        -1
    }
}

// Directives.get_directives for the /* */ pair: None unless the comment is
// "/* beautify name:value ... */".
fn word_run(cs: ref Vec[char], i: i64) -> i64 {
    let mut j = i;
    while j < cs.len() as i64 and py_word(cs[j]) {
        j += 1;
    }
    j
}

fn get_directives(text: ref String) -> Option[Vec[(String, String)]] {
    let cs = chars_of(text);
    let n = cs.len() as i64;
    let prefix = chars_of("/* beautify".to_string());
    if n < 11 {
        return None;
    }
    for k in 0..11 {
        if cs[k] != prefix[k] {
            return None;
        }
    }
    let mut i: i64 = 11;
    let mut count = 0;
    loop {
        if i < n and cs[i] == ' ' {
            let a = word_run(cs, i + 1);
            if a > i + 1 and a < n and cs[a] == ':' {
                let b = word_run(cs, a + 1);
                if b > a + 1 {
                    i = b;
                    count += 1;
                    continue;
                }
            }
        }
        break;
    }
    if count == 0 or not (i + 2 < n and cs[i] == ' ' and cs[i + 1] == '*' and cs[i + 2] == '/') {
        return None;
    }
    let mut out: Vec[(String, String)] = Vec.new();
    let mut p: i64 = 0;
    while p < n {
        if cs[p] == ' ' {
            let a = word_run(cs, p + 1);
            if a > p + 1 and a < n and cs[a] == ':' {
                let b = word_run(cs, a + 1);
                if b > a + 1 {
                    let key = text_of(cs, p + 1, a);
                    let value = text_of(cs, a + 1, b);
                    raw_set(mut out, key, value);
                    p = b;
                    continue;
                }
            }
        }
        p += 1;
    }
    Some(out)
}

fn raw_set(items: mut ref Vec[(String, String)], key: own String, value: own String) {
    for e in items.iter_mut() {
        if e.0 == key {
            e.1 = value;
            return;
        }
    }
    items.push((key, value));
}

// Tokenizer.unescape_string
fn unescape_string(s: ref String) -> String {
    let cs = chars_of(s);
    let n = cs.len() as i64;
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < n {
        // ([\s]|[^\\]|\\\\)+
        while i < n {
            if cs[i] != '\\' {
                out.push(cs[i]);
                i += 1;
            } else if i + 1 < n and cs[i + 1] == '\\' {
                out.push_str("\\\\");
                i += 2;
            } else {
                break;
            }
        }
        if i >= n {
            continue;
        }
        i += 1;
        let mut digits_from: i64 = -1;
        let mut digits_to: i64 = -1;
        let mut matched_to: i64 = -1;
        let is_x = i < n and cs[i] == 'x';
        if is_x {
            if i + 2 < n and hex_digit(cs[i + 1]) and hex_digit(cs[i + 2]) {
                digits_from = i + 1;
                digits_to = i + 3;
                matched_to = i + 3;
            }
        } else if i < n and cs[i] == 'u' {
            if i + 4 < n and hex_digit(cs[i + 1]) and hex_digit(cs[i + 2]) and hex_digit(cs[i + 3]) and hex_digit(cs[i + 4]) {
                digits_from = i + 1;
                digits_to = i + 5;
                matched_to = i + 5;
            } else if i + 1 < n and cs[i + 1] == '{' {
                let mut j = i + 2;
                while j < n and hex_digit(cs[j]) {
                    j += 1;
                }
                if j > i + 2 and j < n and cs[j] == '}' {
                    digits_from = i + 2;
                    digits_to = j;
                    matched_to = j + 1;
                }
            }
        } else {
            out.push('\\');
            if i < n {
                out.push(cs[i]);
                i += 1;
            }
            continue;
        }
        if matched_to < 0 {
            return s.clone();
        }
        let mut escaped: i64 = 0;
        let mut overflow = false;
        for k in digits_from..digits_to {
            if escaped > 0x10FFFF {
                overflow = true;
            } else {
                escaped = escaped * 16 + hex_value(cs[k]);
            }
        }
        let group0 = text_of(cs, i, matched_to);
        i = matched_to;
        if escaped > 0x7E and escaped <= 0xFF and is_x {
            return s.clone();
        } else if escaped >= 0 and escaped < 0x20 {
            out.push('\\');
            out.push_str(group0);
        } else if overflow or escaped > 0x10FFFF {
            out.push('\\');
            out.push_str(group0);
        } else if escaped == 0x22 or escaped == 0x27 or escaped == 0x5C {
            out.push('\\');
            out.push(char.try_from(escaped as u32).unwrap_or('?'));
        } else {
            match char.try_from(escaped as u32) {
                Ok(ch) => out.push(ch),
                Err(_) => {
                    out.push('\\');
                    out.push_str(group0);
                }
            }
        }
    }
    out
}

// ------------------------------------------------------------ output

// core.output.OutputLine. Counts are in code points, as Python's len().
struct Line {
    chars: i64,
    indent: i64,
    align: i64,
    wrap_index: i64,
    wrap_chars: i64,
    wrap_indent: i64,
    wrap_align: i64,
    items: Vec[String],
}

fn blank_line() -> Line {
    Line { chars: 0, indent: -1, align: 0, wrap_index: 0, wrap_chars: 0, wrap_indent: -1, wrap_align: 0, items: Vec.new() }
}

impl Line {
    fn is_empty(ref self) -> bool {
        self.items.len() == 0
    }

    fn last(ref self) -> String {
        match self.items.last() {
            Some(s) => s.clone(),
            None => String.new(),
        }
    }

    fn last_is(ref self, s: Str) -> bool {
        match self.items.last() {
            Some(x) => x == s,
            None => false,
        }
    }

    fn push(mut ref self, item: own String) {
        let mut n: i64 = 0;
        let mut last_newline: i64 = -1;
        for c in item.chars() {
            if c == '\n' {
                last_newline = n;
            }
            n += 1;
        }
        if last_newline >= 0 {
            self.chars = n - last_newline;
        } else {
            self.chars += n;
        }
        self.items.push(item);
    }

    fn pop(mut ref self) -> Option[String] {
        match self.items.pop() {
            Some(item) => {
                self.chars -= clen(item);
                Some(item)
            }
            None => None,
        }
    }

    fn trim(mut ref self) {
        while self.last_is(" ") {
            self.items.pop();
            self.chars -= 1;
        }
    }

    fn remove_wrap_indent(mut ref self) {
        if self.wrap_indent > 0 {
            self.wrap_indent -= 1;
        }
    }
}

// core.output.Output with its IndentStringCache. The current line is always
// the last of `lines` and the previous line the one before it.
struct Output {
    cache: Vec[String],
    cache_indent_size: i64,
    indent_string: String,
    base: String,
    base_len: i64,
    raw: bool,
    end_with_newline: bool,
    indent_size: i64,
    wrap: i64,
    indent_empty: bool,
    lines: Vec[Line],
    next_line: Line,
    space_before_token: bool,
    non_breaking_space: bool,
    previous_token_wrapped: bool,
}

fn repeat(s: ref String, n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(s);
    }
    out
}

fn new_output(opts: ref Opts, base_indent: ref String) -> Output {
    let indent_string = if opts.indent_with_tabs { opts.indent_char.clone() } else { repeat(opts.indent_char, opts.indent_size) };
    let base = if opts.indent_level > 0 { repeat(indent_string, opts.indent_level) } else { base_indent.clone() };
    let mut cache: Vec[String] = Vec.new();
    cache.push(String.new());
    let base_len = clen(base);
    let mut out = Output {
        cache: cache,
        cache_indent_size: opts.indent_size,
        indent_string: indent_string,
        base: base,
        base_len: base_len,
        raw: false,
        end_with_newline: opts.end_with_newline,
        indent_size: opts.indent_size,
        wrap: opts.wrap_line_length,
        indent_empty: opts.indent_empty_lines,
        lines: Vec.new(),
        next_line: blank_line(),
        space_before_token: false,
        non_breaking_space: false,
        previous_token_wrapped: false,
    };
    out.add_outputline();
    out
}

impl Output {
    fn cur(ref self) -> i64 {
        self.lines.len() as i64 - 1
    }

    fn get_indent_size(ref self, indent: i64, column: i64) -> i64 {
        let mut result = self.base_len;
        if indent < 0 {
            result = 0;
        }
        result + indent * self.indent_size + column
    }

    fn get_indent_string(mut ref self, indent_level: i64, column: i64) -> String {
        let mut result = self.base.clone();
        let mut level = indent_level;
        if level < 0 {
            level = 0;
            result = String.new();
        }
        let col = column + level * self.cache_indent_size;
        while col >= self.cache.len() as i64 {
            let mut c = self.cache.len() as i64;
            let mut s = String.new();
            if self.cache_indent_size != 0 and c >= self.cache_indent_size {
                let k = c / self.cache_indent_size;
                c -= k * self.cache_indent_size;
                s = repeat(self.indent_string, k);
            }
            if c != 0 {
                s.push_str(repeat(" ".to_string(), c));
            }
            self.cache.push(s);
        }
        result.push_str(self.cache[col]);
        result
    }

    // OutputLine.set_indent on line k (-1 for next_line).
    fn line_set_indent(mut ref self, k: i64, indent: i64, align: i64) {
        let size = self.get_indent_size(indent, align);
        if k < 0 {
            if self.next_line.is_empty() {
                self.next_line.indent = indent;
                self.next_line.align = align;
                self.next_line.chars = size;
            }
        } else if self.lines[k].is_empty() {
            self.lines[k].indent = indent;
            self.lines[k].align = align;
            self.lines[k].chars = size;
        }
    }

    fn add_outputline(mut ref self) {
        let (ni, na) = (self.next_line.indent, self.next_line.align);
        self.lines.push(blank_line());
        let k = self.cur();
        self.line_set_indent(k, ni, na);
    }

    fn get_line_number(ref self) -> i64 {
        self.lines.len() as i64
    }

    fn is_empty(ref self) -> bool {
        self.lines.len() == 1 and self.lines[0].is_empty()
    }

    fn just_added_newline(ref self) -> bool {
        self.lines[self.cur()].is_empty()
    }

    fn just_added_blankline(ref self) -> bool {
        if self.is_empty() {
            return true;
        }
        let k = self.cur();
        self.lines[k].is_empty() and k >= 1 and self.lines[k - 1].is_empty()
    }

    fn add_new_line(mut ref self, force_newline: bool) -> bool {
        if self.is_empty() or (not force_newline and self.just_added_newline()) {
            return false;
        }
        if not self.raw {
            self.add_outputline();
        }
        true
    }

    fn set_wrap_point(mut ref self) {
        if self.wrap != 0 {
            let k = self.cur();
            let (ni, na) = (self.next_line.indent, self.next_line.align);
            let line = mut ref self.lines[k];
            line.wrap_index = line.items.len() as i64;
            line.wrap_chars = line.chars;
            line.wrap_indent = ni;
            line.wrap_align = na;
        }
    }

    // OutputLine._allow_wrap on the current line.
    fn allow_wrap(mut ref self) -> bool {
        let k = self.cur();
        let next_chars = self.next_line.chars;
        let should = {
            let line = ref self.lines[k];
            line.wrap_index != 0 and line.chars > self.wrap and line.wrap_chars > next_chars
        };
        if not should {
            return false;
        }
        self.add_new_line(false);
        let j = self.cur();
        let (wi, wa, at, total, wchars) = {
            let line = ref self.lines[k];
            (line.wrap_indent, line.wrap_align, line.wrap_index, line.chars, line.wrap_chars)
        };
        self.line_set_indent(j, wi, wa);
        let mut moved: Vec[String] = Vec.new();
        let mut kept: Vec[String] = Vec.new();
        let mut idx: i64 = 0;
        for item in self.lines[k].items.iter() {
            if idx < at {
                kept.push(item.clone());
            } else {
                moved.push(item.clone());
            }
            idx += 1;
        }
        self.lines[k].items = kept;
        self.lines[k].chars = wchars;
        let next = mut ref self.lines[j];
        next.items = moved;
        next.chars += total - wchars;
        if next.items.len() > 0 and next.items[0] == " " {
            next.items.remove(0);
            next.chars -= 1;
        }
        true
    }

    fn set_indent(mut ref self, indent: i64, align: i64) -> bool {
        self.line_set_indent(-1, indent, align);
        let k = self.cur();
        if self.lines.len() > 1 {
            self.line_set_indent(k, indent, align);
            return true;
        }
        self.line_set_indent(k, 0, 0);
        false
    }

    fn add_raw_token(mut ref self, newlines: i64, ws: ref String, text: ref String) {
        for _ in 0..newlines {
            self.add_outputline();
        }
        let k = self.cur();
        self.line_set_indent(k, -1, 0);
        self.lines[k].push(ws.clone());
        self.lines[k].push(text.clone());
        self.space_before_token = false;
        self.non_breaking_space = false;
        self.previous_token_wrapped = false;
    }

    fn add_token(mut ref self, s: ref String) {
        if self.space_before_token and not self.just_added_newline() {
            if not self.non_breaking_space {
                self.set_wrap_point();
            }
            let k = self.cur();
            self.lines[k].push(" ".to_string());
        }
        self.space_before_token = false;
        let k = self.cur();
        self.lines[k].push(s.clone());
        self.space_before_token = false;
        self.non_breaking_space = false;
        self.previous_token_wrapped = self.allow_wrap();
    }

    fn remove_indent(mut ref self, index: i64) {
        let mut i = index;
        let size = self.indent_size;
        while i < self.lines.len() as i64 {
            let line = mut ref self.lines[i];
            if line.indent > 0 {
                line.indent -= 1;
                line.chars -= size;
            }
            i += 1;
        }
        let k = self.cur();
        self.lines[k].remove_wrap_indent();
    }

    fn trim(mut ref self, eat_newlines: bool) {
        let k = self.cur();
        self.lines[k].trim();
        while eat_newlines and self.lines.len() > 1 and self.lines[self.cur()].is_empty() {
            self.lines.pop();
            let j = self.cur();
            self.lines[j].trim();
        }
    }

    fn line_text(mut ref self, k: i64) -> String {
        let (empty, indent, align) = {
            let line = ref self.lines[k];
            (line.is_empty(), line.indent, line.align)
        };
        if empty {
            if self.indent_empty {
                return self.get_indent_string(indent, 0);
            }
            return String.new();
        }
        let mut s = self.get_indent_string(indent, align);
        for item in self.lines[k].items.iter() {
            s.push_str(item);
        }
        s
    }

    fn get_code(mut ref self, eol: ref String) -> String {
        self.trim(true);
        let k = self.cur();
        match self.lines[k].pop() {
            Some(last) => {
                let mut item = last;
                if item != "" {
                    if last_char(item) == '\n' {
                        let cs = chars_of(item);
                        let mut end = cs.len() as i64;
                        while end > 0 and cs[end - 1] == '\n' {
                            end -= 1;
                        }
                        item = text_of(cs, 0, end);
                    }
                    self.lines[k].push(item);
                }
            }
            None => {}
        }
        if self.end_with_newline {
            self.add_outputline();
        }
        let mut code = String.new();
        for i in 0..self.lines.len() as i64 {
            if i > 0 {
                code.push('\n');
            }
            let t = self.line_text(i);
            code.push_str(t);
        }
        if eol != "\n" {
            code = code.replace("\n", eol);
        }
        code
    }
}

// ------------------------------------------------------------ beautifier

#[derive(Copy, Clone, PartialEq, Eq)]
enum Mode {
    BlockStatement,
    Statement,
    ObjectLiteral,
    ArrayLiteral,
    ForInitializer,
    Conditional,
    Expression,
}

fn is_expression(m: Mode) -> bool {
    m == Mode.Expression or m == Mode.ForInitializer or m == Mode.Conditional
}

// BeautifierFlags. `parent` indexes the flags arena (-1 for None) and
// `last_token` the token arena.
struct Flags {
    mode: Mode,
    parent: i64,
    last_token: i64,
    last_word: String,
    declaration_statement: bool,
    declaration_assignment: bool,
    multiline_frame: bool,
    inline_frame: bool,
    if_block: bool,
    else_block: bool,
    class_start_block: bool,
    do_block: bool,
    do_while: bool,
    import_block: bool,
    in_case: bool,
    in_case_statement: bool,
    case_body: bool,
    case_block: bool,
    indentation_level: i64,
    alignment: i64,
    line_indent_level: i64,
    start_line_index: i64,
    ternary_depth: i64,
}

fn new_flags(mode: Mode) -> Flags {
    Flags {
        mode: mode,
        parent: -1,
        last_token: 0,
        last_word: String.new(),
        declaration_statement: false,
        declaration_assignment: false,
        multiline_frame: false,
        inline_frame: false,
        if_block: false,
        else_block: false,
        class_start_block: false,
        do_block: false,
        do_while: false,
        import_block: false,
        in_case: false,
        in_case_statement: false,
        case_body: false,
        case_block: false,
        indentation_level: 0,
        alignment: 0,
        line_indent_level: 0,
        start_line_index: 0,
        ternary_depth: 0,
    }
}

// Word lists are space-separated.
const SPECIAL_WORDS: Str = "case return do if throw else await break continue async";
const RESTRICTED: Str = "async break continue return throw yield";

fn in_list(s: ref String, list: Str) -> bool {
    for w in list.split(" ") {
        if s == w {
            return true;
        }
    }
    false
}

// re.search("^([0-9])+$", s)
fn all_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not c.is_ascii_digit() {
            return false;
        }
    }
    true
}

struct Beautifier {
    opts: Opts,
    toks: Vec[Tok],
    stream: Vec[i64],
    // The token stream's position: one past the token being handled.
    pos: i64,
    fl: Vec[Flags],
    cur: i64,
    prev: i64,
    store: Vec[i64],
    out: Output,
    last_last_text: String,
}

impl Beautifier {
    // ---- token and flag queries

    fn peek(ref self, k: i64) -> i64 {
        let i = self.pos + k;
        if i >= 0 and i < self.stream.len() as i64 { self.stream[i] } else { -1 }
    }

    fn kind(ref self, t: i64) -> Tk {
        if t < 0 { Tk.Start } else { self.toks[t].kind }
    }

    fn newlines(ref self, t: i64) -> i64 {
        if t < 0 { 0 } else { self.toks[t].newlines }
    }

    fn text_is(ref self, t: i64, s: Str) -> bool {
        t >= 0 and self.toks[t].text == s
    }

    fn text_in(ref self, t: i64, list: Str) -> bool {
        t >= 0 and in_list(self.toks[t].text, list)
    }

    // reserved_word / reserved_array
    fn res(ref self, t: i64, w: Str) -> bool {
        t >= 0 and self.toks[t].kind == Tk.Reserved and self.toks[t].text == w
    }

    fn res_in(ref self, t: i64, list: Str) -> bool {
        t >= 0 and self.toks[t].kind == Tk.Reserved and in_list(self.toks[t].text, list)
    }

    fn res_line_starter(ref self, t: i64) -> bool {
        t >= 0 and self.toks[t].kind == Tk.Reserved and line_starter(self.toks[t].text)
    }

    fn mode(ref self) -> Mode {
        self.fl[self.cur].mode
    }

    fn parent_mode(ref self) -> Mode {
        self.fl[self.fl[self.cur].parent].mode
    }

    fn prev_mode(ref self) -> Mode {
        self.fl[self.prev].mode
    }

    fn lt(ref self) -> i64 {
        self.fl[self.cur].last_token
    }

    fn lt_kind(ref self) -> Tk {
        self.toks[self.lt()].kind
    }

    fn lt_is(ref self, s: Str) -> bool {
        self.toks[self.lt()].text == s
    }

    fn lt_in(ref self, list: Str) -> bool {
        in_list(self.toks[self.lt()].text, list)
    }

    fn lt_res(ref self, w: Str) -> bool {
        self.res(self.lt(), w)
    }

    fn lt_res_in(ref self, list: Str) -> bool {
        self.res_in(self.lt(), list)
    }

    fn llt_in(ref self, list: Str) -> bool {
        in_list(self.last_last_text, list)
    }

    fn space(mut ref self, on: bool) {
        self.out.space_before_token = on;
    }

    // ---- modes and indentation

    fn out_set_indent(mut ref self) -> bool {
        let c = self.cur;
        let il = self.fl[c].indentation_level;
        let al = self.fl[c].alignment;
        self.out.set_indent(il, al)
    }

    fn set_mode(mut ref self, mode: Mode) {
        if self.cur >= 0 {
            self.store.push(self.cur);
            self.prev = self.cur;
        } else {
            self.fl.push(new_flags(mode));
            self.prev = self.fl.len() as i64 - 1;
        }
        let added_newline = self.out.just_added_newline();
        let p = self.prev;
        let mut f = new_flags(mode);
        let mut next_indent_level = self.fl[p].indentation_level;
        if not added_newline and self.fl[p].line_indent_level > next_indent_level {
            next_indent_level = self.fl[p].line_indent_level;
        }
        f.parent = p;
        f.last_token = self.fl[p].last_token;
        f.last_word = self.fl[p].last_word.clone();
        f.indentation_level = next_indent_level;
        f.start_line_index = self.out.get_line_number();
        self.fl.push(f);
        self.cur = self.fl.len() as i64 - 1;
        self.out_set_indent();
    }

    fn remove_redundant_indentation(mut ref self, frame: i64) {
        let f = ref self.fl[frame];
        if f.multiline_frame or f.mode == Mode.ForInitializer or f.mode == Mode.Conditional {
            return;
        }
        let start = f.start_line_index;
        self.out.remove_indent(start);
    }

    fn restore_mode(mut ref self) {
        match self.store.pop() {
            Some(f) => {
                self.prev = self.cur;
                self.cur = f;
                if self.fl[self.prev].mode == Mode.Statement {
                    let p = self.prev;
                    self.remove_redundant_indentation(p);
                }
            }
            None => {}
        }
        self.out_set_indent();
    }

    fn indent(mut ref self) {
        let c = self.cur;
        self.fl[c].indentation_level += 1;
        self.out_set_indent();
    }

    fn deindent(mut ref self) {
        let c = self.cur;
        let level = self.fl[c].indentation_level;
        let p = self.fl[c].parent;
        if level > 0 and (p < 0 or level > self.fl[p].indentation_level) {
            self.fl[c].indentation_level -= 1;
        }
        self.out_set_indent();
    }

    fn start_of_object_property(ref self) -> bool {
        let f = ref self.fl[self.cur];
        self.parent_mode() == Mode.ObjectLiteral and f.mode == Mode.Statement
            and ((self.lt_is(":") and f.ternary_depth == 0) or self.lt_res_in("get set"))
    }

    fn start_of_statement(mut ref self, t: i64) -> bool {
        let tk = self.toks[t].kind;
        let tn = self.toks[t].newlines;
        let lk = self.lt_kind();
        let mode = self.mode();
        let mut start = self.lt_res_in("var let const") and tk == Tk.Word;
        start = start or self.lt_res("do");
        start = start
            or (not (self.parent_mode() == Mode.ObjectLiteral and mode == Mode.Statement) and self.lt_res_in(RESTRICTED)
                and tn == 0);
        start = start or (self.lt_res("else") and not (self.res(t, "if") and self.toks[t].comments.len() == 0));
        start = start
            or (lk == Tk.EndExpr and (self.prev_mode() == Mode.ForInitializer or self.prev_mode() == Mode.Conditional));
        start = start
            or (lk == Tk.Word and mode == Mode.BlockStatement and not self.fl[self.cur].in_case
                and not (self.text_is(t, "--") or self.text_is(t, "++")) and self.last_last_text != "function"
                and tk != Tk.Word and tk != Tk.Reserved);
        start = start
            or (mode == Mode.ObjectLiteral
                and ((self.lt_is(":") and self.fl[self.cur].ternary_depth == 0) or self.lt_res_in("get set")));
        if not start {
            return false;
        }
        self.set_mode(Mode.Statement);
        self.indent();
        self.handle_whitespace_and_comments(t, true);
        // Issue #276: a statement starting with if, for, while or do goes
        // on a new line.
        if not self.start_of_object_property() {
            let force = self.res_in(t, "do for if while");
            self.allow_wrap_or_preserved_newline(t, force);
        }
        true
    }

    // ---- printing

    fn handle_whitespace_and_comments(mut ref self, t: i64, preserve: bool) {
        let mut newlines = self.toks[t].newlines;
        let keep_whitespace = self.opts.keep_array_indentation and self.mode() == Mode.ArrayLiteral;
        let comments = self.toks[t].comments.clone();
        for c in comments {
            // Inline comments are formatted as though they were not there.
            self.handle_whitespace_and_comments(c, preserve);
            self.handle_token(c, preserve);
        }
        if keep_whitespace {
            for i in 0..newlines {
                self.print_newline(i > 0, preserve);
            }
        } else {
            if self.opts.max_preserve_newlines != 0 and newlines > self.opts.max_preserve_newlines {
                newlines = self.opts.max_preserve_newlines;
            }
            if self.opts.preserve_newlines and newlines > 1 {
                self.print_newline(false, preserve);
                for _ in 1..newlines {
                    self.print_newline(true, preserve);
                }
            }
        }
    }

    fn allow_wrap_or_preserved_newline(mut ref self, t: i64, force_linewrap: bool) {
        // Never wrap the first token of a line.
        if self.out.just_added_newline() {
            return;
        }
        let mut should_preserve_or_force = (self.opts.preserve_newlines and self.toks[t].newlines != 0) or force_linewrap;
        let last_positionable = positionable(self.toks[self.lt()].text);
        let cur_positionable = positionable(self.toks[t].text);
        if last_positionable or cur_positionable {
            let op = self.opts.operator_position.clone();
            let operator_newline = (last_positionable and (op == "before-newline" or op == "preserve-newline"))
                or cur_positionable;
            should_preserve_or_force = should_preserve_or_force and operator_newline;
        }
        if should_preserve_or_force {
            self.print_newline(false, true);
        } else if self.opts.wrap_line_length > 0 {
            // No newline between these words and the expression after them.
            if self.lt_res_in(RESTRICTED) {
                return;
            }
            self.out.set_wrap_point();
        }
    }

    fn print_newline(mut ref self, force_newline: bool, preserve_statement_flags: bool) {
        if not preserve_statement_flags {
            let lk = self.lt_kind();
            if not self.lt_is(";") and not self.lt_is(",") and not self.lt_is("=")
                and (lk != Tk.Operator or self.lt_is("--") or self.lt_is("++")) {
                let next = self.peek(0);
                while self.mode() == Mode.Statement and not (self.fl[self.cur].if_block and self.res(next, "else"))
                    and not self.fl[self.cur].do_block {
                    self.restore_mode();
                }
            }
        }
        if self.out.add_new_line(force_newline) {
            let c = self.cur;
            self.fl[c].multiline_frame = true;
        }
    }

    fn print_token_line_indentation(mut ref self, t: i64) {
        if not self.out.just_added_newline() {
            return;
        }
        if self.opts.keep_array_indentation and self.toks[t].newlines != 0
            and (self.mode() == Mode.ArrayLiteral or self.toks[t].text == "[") {
            let k = self.out.cur();
            self.out.line_set_indent(k, -1, 0);
            let ws = self.toks[t].ws.clone();
            self.out.lines[k].push(ws);
            self.out.space_before_token = false;
        } else if self.out_set_indent() {
            let c = self.cur;
            self.fl[c].line_indent_level = self.fl[c].indentation_level;
        }
    }

    fn print_token(mut ref self, t: i64) {
        let s = self.toks[t].text.clone();
        self.print_token_text(t, s);
    }

    fn print_token_text(mut ref self, t: i64, s: own String) {
        if self.out.raw {
            let newlines = self.toks[t].newlines;
            let ws = self.toks[t].ws.clone();
            let text = self.toks[t].text.clone();
            self.out.add_raw_token(newlines, ws, text);
            return;
        }
        let p = self.toks[t].previous;
        if self.opts.comma_first and p >= 0 and self.toks[p].kind == Tk.Comma and self.out.just_added_newline() {
            let k = self.out.cur();
            if k >= 1 and self.out.lines[k - 1].last_is(",") {
                // If the comma was already at the start of the line, pull
                // back onto that line and reprint the indentation.
                let popped = self.out.lines[k - 1].pop();
                if self.out.lines[k - 1].is_empty() {
                    match popped {
                        Some(x) => self.out.lines[k - 1].push(x),
                        None => {}
                    }
                    self.out.trim(true);
                    let j = self.out.cur();
                    let _ = self.out.lines[j].pop();
                    self.out.trim(false);
                }
                // The comma goes in front of the next token.
                self.print_token_line_indentation(t);
                self.out.add_token(",".to_string());
                self.out.space_before_token = true;
            }
        }
        self.print_token_line_indentation(t);
        self.out.non_breaking_space = true;
        self.out.add_token(s);
        if self.out.previous_token_wrapped {
            let c = self.cur;
            self.fl[c].multiline_frame = true;
        }
    }

    // ---- the token handlers

    fn handle_token(mut ref self, t: i64, preserve: bool) {
        match self.toks[t].kind {
            Tk.StartExpr => self.handle_start_expr(t),
            Tk.EndExpr => self.handle_end_expr(t),
            Tk.StartBlock => self.handle_start_block(t),
            Tk.EndBlock => self.handle_end_block(t),
            Tk.Word => self.handle_word(t),
            Tk.Reserved => self.handle_word(t),
            Tk.Semicolon => self.handle_semicolon(t),
            Tk.Strng => self.handle_string(t),
            Tk.Equals => self.handle_equals(t),
            Tk.Operator => self.handle_operator(t),
            Tk.Comma => self.handle_comma(t),
            Tk.BlockComment => self.handle_block_comment(t, preserve),
            Tk.Comment => self.handle_comment(t, preserve),
            Tk.Dot => self.handle_dot(t),
            Tk.Eof => self.handle_eof(t),
            _ => self.handle_unknown(t, preserve),
        }
    }

    fn handle_start_expr(mut ref self, t: i64) {
        if not self.start_of_statement(t) {
            self.handle_whitespace_and_comments(t, false);
        }
        let mut next_mode = Mode.Expression;
        if self.text_is(t, "[") {
            let lk = self.lt_kind();
            if lk == Tk.Word or self.lt_is(")") {
                if self.res_line_starter(self.lt()) {
                    self.space(true);
                }
                self.print_token(t);
                self.set_mode(next_mode);
                self.indent();
                if self.opts.space_in_paren {
                    self.space(true);
                }
                return;
            }
            next_mode = Mode.ArrayLiteral;
            if self.mode() == Mode.ArrayLiteral {
                // "], [" and "}, [" go to a new line.
                if self.lt_is("[") or (self.lt_is(",") and self.llt_in("] }")) {
                    if not self.opts.keep_array_indentation {
                        self.print_newline(false, false);
                    }
                }
            }
            let lk = self.lt_kind();
            if not (lk == Tk.StartExpr or lk == Tk.EndExpr or lk == Tk.Word or lk == Tk.Operator or lk == Tk.Dot) {
                self.space(true);
            }
        } else {
            let lk = self.lt_kind();
            if lk == Tk.Reserved {
                if self.lt_is("for") {
                    self.space(self.opts.space_before_conditional);
                    next_mode = Mode.ForInitializer;
                } else if self.lt_in("if while switch") {
                    self.space(self.opts.space_before_conditional);
                    next_mode = Mode.Conditional;
                } else if in_list(self.fl[self.cur].last_word, "await async") {
                    // A space between await and an IIFE, or async and an
                    // arrow function.
                    self.space(true);
                } else if self.lt_is("import") and self.toks[t].ws == "" {
                    self.space(false);
                } else if line_starter(self.toks[self.lt()].text) or self.lt_is("catch") {
                    self.space(true);
                }
            } else if lk == Tk.Equals or lk == Tk.Operator {
                // a = (b &&
                //     (c || d));
                if not self.start_of_object_property() {
                    self.allow_wrap_or_preserved_newline(t, false);
                }
            } else if lk == Tk.Word {
                self.space(false);
                // function name() vs function name (), and the method
                // shorthand in object literals and classes. peek(-1) is the
                // current token.
                let back2 = self.peek(-3);
                if self.opts.space_after_named_function and back2 >= 0 {
                    let back3 = self.peek(-4);
                    if self.res_in(back2, "async function")
                        or (self.text_is(back2, "*") and self.res_in(back3, "async function")) {
                        self.space(true);
                    } else if self.mode() == Mode.ObjectLiteral {
                        if self.text_in(back2, "{ ,") or (self.text_is(back2, "*") and self.text_in(back3, "{ ,")) {
                            self.space(true);
                        }
                    } else if self.fl[self.cur].parent >= 0 and self.fl[self.fl[self.cur].parent].class_start_block {
                        self.space(true);
                    }
                }
            } else {
                // a.b('c',
                //     () => d.e
                // )
                self.allow_wrap_or_preserved_newline(t, false);
            }
            // function() vs function (), typeof() vs typeof (), and the
            // generator forms.
            if (self.lt_kind() == Tk.Reserved and in_list(self.fl[self.cur].last_word, "function typeof"))
                or (self.lt_is("*")
                    and (self.llt_in("function yield") or (self.mode() == Mode.ObjectLiteral and self.llt_in("{ ,")))) {
                self.space(self.opts.space_after_anon_function);
            }
        }
        let lk = self.lt_kind();
        if self.lt_is(";") or lk == Tk.StartBlock {
            self.print_newline(false, false);
        } else if lk == Tk.EndExpr or lk == Tk.StartExpr or lk == Tk.EndBlock or lk == Tk.Comma or self.lt_is(".") {
            // Nothing on (( )( ][ ]( and .(
            let force = self.toks[t].newlines != 0;
            self.allow_wrap_or_preserved_newline(t, force);
        }
        self.print_token(t);
        self.set_mode(next_mode);
        if self.opts.space_in_paren {
            self.space(true);
        }
        // A newline inside an expression is always indented.
        self.indent();
    }

    fn handle_end_expr(mut ref self, t: i64) {
        // Statements must all be closed when their container closes.
        while self.mode() == Mode.Statement {
            self.restore_mode();
        }
        self.handle_whitespace_and_comments(t, false);
        if self.fl[self.cur].multiline_frame {
            let force = self.text_is(t, "]") and self.mode() == Mode.ArrayLiteral and not self.opts.keep_array_indentation;
            self.allow_wrap_or_preserved_newline(t, force);
        }
        if self.opts.space_in_paren {
            if self.lt_kind() == Tk.StartExpr and not self.opts.space_in_empty_paren {
                // Empty parens are always "()" and "[]".
                self.space(false);
                self.out.trim(false);
            } else {
                self.space(true);
            }
        }
        self.deindent();
        self.print_token(t);
        self.restore_mode();
        let p = self.prev;
        self.remove_redundant_indentation(p);
        // do {} while () needs no statement after it.
        let c = self.cur;
        if self.fl[c].do_while and self.fl[p].mode == Mode.Conditional {
            self.fl[p].mode = Mode.Expression;
            self.fl[c].do_block = false;
            self.fl[c].do_while = false;
        }
    }

    fn handle_start_block(mut ref self, t: i64) {
        self.handle_whitespace_and_comments(t, false);
        // Is this a BlockStatement that should be an ObjectLiteral?
        let next = self.peek(0);
        let second = self.peek(1);
        let nk = self.kind(next);
        let sk = self.kind(second);
        if self.fl[self.cur].last_word == "switch" and self.lt_kind() == Tk.EndExpr {
            self.set_mode(Mode.BlockStatement);
            let c = self.cur;
            self.fl[c].in_case_statement = true;
        } else if self.fl[self.cur].case_body {
            self.set_mode(Mode.BlockStatement);
        } else if second >= 0
            and ((self.text_in(second, ": ,") and (nk == Tk.Strng or nk == Tk.Word or nk == Tk.Reserved))
                or (self.text_in(next, "get set ...") and (sk == Tk.Word or sk == Tk.Reserved))) {
            // TypeScript is not supported, but has long not been broken.
            if self.llt_in("class interface") and not self.text_in(second, ": ,") {
                self.set_mode(Mode.BlockStatement);
            } else {
                self.set_mode(Mode.ObjectLiteral);
            }
        } else if self.lt_kind() == Tk.Operator and self.lt_is("=>") {
            // (param1, paramN) => { statements }
            self.set_mode(Mode.BlockStatement);
        } else if self.lt_kind() == Tk.Equals or self.lt_kind() == Tk.StartExpr or self.lt_kind() == Tk.Comma
            or self.lt_kind() == Tk.Operator or self.lt_res_in("return throw import default") {
            // A block returned, imported, exported, passed or assigned is
            // an object literal.
            self.set_mode(Mode.ObjectLiteral);
        } else {
            self.set_mode(Mode.BlockStatement);
        }
        let ltp = self.toks[self.lt()].previous;
        if self.res_in(ltp, "class extends") {
            let c = self.cur;
            self.fl[c].class_start_block = true;
        }
        let empty_braces = next >= 0 and self.toks[next].comments.len() == 0 and self.toks[next].text == "}";
        let empty_anonymous_function = empty_braces and self.fl[self.cur].last_word == "function"
            and self.lt_kind() == Tk.EndExpr;

        if self.opts.brace_preserve_inline {
            // Search forward for a newline wanted inside this block.
            let c = self.cur;
            self.fl[c].inline_frame = true;
            let mut index: i64 = 0;
            loop {
                index += 1;
                let check = self.peek(index - 1);
                if self.newlines(check) != 0 {
                    self.fl[c].inline_frame = false;
                }
                let ck = self.kind(check);
                if not (ck != Tk.Eof and not (ck == Tk.EndBlock and self.toks[check].opened == t)) {
                    break;
                }
            }
        }

        let bs = self.opts.brace_style.clone();
        if (bs == "expand" or (bs == "none" and self.toks[t].newlines != 0)) and not self.fl[self.cur].inline_frame {
            let lk = self.lt_kind();
            if lk != Tk.Operator
                and (empty_anonymous_function or lk == Tk.Equals or (self.lt_res_in(SPECIAL_WORDS) and not self.lt_is("else"))) {
                self.space(true);
            } else {
                self.print_newline(false, true);
            }
        } else {
            let lk = self.lt_kind();
            if self.prev_mode() == Mode.ArrayLiteral and (lk == Tk.StartExpr or lk == Tk.Comma) {
                // When preserving inline, allow a newline between a comma
                // and the next brace.
                if self.fl[self.cur].inline_frame {
                    self.allow_wrap_or_preserved_newline(t, false);
                    let c = self.cur;
                    let p = self.prev;
                    self.fl[c].inline_frame = true;
                    self.fl[p].multiline_frame = self.fl[p].multiline_frame or self.fl[c].multiline_frame;
                    self.fl[c].multiline_frame = false;
                } else if lk == Tk.Comma {
                    self.space(true);
                }
            } else if lk != Tk.Operator and lk != Tk.StartExpr {
                if (lk == Tk.StartBlock or lk == Tk.Semicolon) and not self.fl[self.cur].inline_frame {
                    self.print_newline(false, false);
                } else {
                    self.space(true);
                }
            }
        }
        self.print_token(t);
        self.indent();
        // Open braces are followed by a new line, except in these cases.
        if not empty_braces and not (self.opts.brace_preserve_inline and self.fl[self.cur].inline_frame) {
            self.print_newline(false, false);
        }
    }

    fn handle_end_block(mut ref self, t: i64) {
        self.handle_whitespace_and_comments(t, false);
        while self.mode() == Mode.Statement {
            self.restore_mode();
        }
        let empty_braces = self.lt_kind() == Tk.StartBlock;
        if self.fl[self.cur].inline_frame and not empty_braces {
            self.space(true);
        } else if self.opts.brace_style == "expand" {
            if not empty_braces {
                self.print_newline(false, false);
            }
        } else if not empty_braces {
            if self.mode() == Mode.ArrayLiteral and self.opts.keep_array_indentation {
                self.opts.keep_array_indentation = false;
                self.print_newline(false, false);
                self.opts.keep_array_indentation = true;
            } else {
                self.print_newline(false, false);
            }
        }
        self.restore_mode();
        self.print_token(t);
    }

    fn handle_word(mut ref self, t: i64) {
        if self.toks[t].kind == Tk.Reserved {
            let text = self.toks[t].text.clone();
            if (text == "set" or text == "get") and self.mode() != Mode.ObjectLiteral {
                self.toks[t].kind = Tk.Word;
            } else if text == "import" and self.text_in(self.peek(0), "( .") {
                self.toks[t].kind = Tk.Word;
            } else if (text == "as" or text == "from") and not self.fl[self.cur].import_block {
                self.toks[t].kind = Tk.Word;
            } else if self.mode() == Mode.ObjectLiteral {
                if self.text_is(self.peek(0), ":") {
                    self.toks[t].kind = Tk.Word;
                }
            }
        }

        if self.start_of_statement(t) {
            if self.lt_res_in("var let const") and self.toks[t].kind == Tk.Word {
                let c = self.cur;
                self.fl[c].declaration_statement = true;
            }
        } else if self.toks[t].newlines != 0 and not is_expression(self.mode())
            and (self.lt_kind() != Tk.Operator or self.lt_is("--") or self.lt_is("++")) and self.lt_kind() != Tk.Equals
            and (self.opts.preserve_newlines or not self.lt_res_in("var let const set get")) {
            self.handle_whitespace_and_comments(t, false);
            self.print_newline(false, false);
        } else {
            self.handle_whitespace_and_comments(t, false);
        }

        if self.fl[self.cur].do_block and not self.fl[self.cur].do_while {
            if self.res(t, "while") {
                // do {} ## while ()
                self.space(true);
                self.print_token(t);
                self.space(true);
                let c = self.cur;
                self.fl[c].do_while = true;
                return;
            }
            // do {} should always have while as the next word; recover if not.
            self.print_newline(false, false);
            let c = self.cur;
            self.fl[c].do_block = false;
        }

        // An if may be followed by an else, or not: unwind the modes of
        // if (a) if (b) c(); else d(); else e();
        if self.fl[self.cur].if_block {
            if not self.fl[self.cur].else_block and self.res(t, "else") {
                let c = self.cur;
                self.fl[c].else_block = true;
            } else {
                while self.mode() == Mode.Statement {
                    self.restore_mode();
                }
                let c = self.cur;
                self.fl[c].if_block = false;
            }
        }

        if self.fl[self.cur].in_case_statement and self.res_in(t, "case default") {
            self.print_newline(false, false);
            if not self.fl[self.cur].case_block and (self.fl[self.cur].case_body or self.opts.jslint_happy) {
                self.deindent();
            }
            let c = self.cur;
            self.fl[c].case_body = false;
            self.print_token(t);
            let c = self.cur;
            self.fl[c].in_case = true;
            return;
        }

        let lk = self.lt_kind();
        if lk == Tk.Comma or lk == Tk.StartExpr or lk == Tk.Equals or lk == Tk.Operator {
            // A numeric property value with a +/- prefix is a different
            // start of object property.
            if not self.start_of_object_property()
                and not (self.lt_in("+ -") and self.last_last_text == ":" and self.parent_mode() == Mode.ObjectLiteral) {
                self.allow_wrap_or_preserved_newline(t, false);
            }
        }

        if self.res(t, "function") {
            if self.lt_in("} ;")
                or (self.out.just_added_newline() and not (self.lt_in("( [ { : = ,") or self.lt_kind() == Tk.Operator)) {
                // At least one blank line before a function definition,
                // except in arrays.
                if not self.out.just_added_blankline() and self.toks[t].comments.len() == 0 {
                    self.print_newline(false, false);
                    self.print_newline(true, false);
                }
            }
            let lk = self.lt_kind();
            if lk == Tk.Reserved or lk == Tk.Word {
                if self.lt_res_in("get set new export") or self.lt_res_in(RESTRICTED) {
                    self.space(true);
                } else if self.lt_res("default") and self.last_last_text == "export" {
                    self.space(true);
                } else if self.lt_is("declare") {
                    // TypeScript's declare function
                    self.space(true);
                } else {
                    self.print_newline(false, false);
                }
            } else if lk == Tk.Operator or self.lt_is("=") {
                // foo = function
                self.space(true);
            } else if not self.fl[self.cur].multiline_frame and (is_expression(self.mode()) or self.mode() == Mode.ArrayLiteral) {
                // (function
            } else {
                self.print_newline(false, false);
            }
            self.print_token(t);
            let c = self.cur;
            self.fl[c].last_word = self.toks[t].text.clone();
            return;
        }

        // 0 NONE, 1 SPACE, 2 NEWLINE
        let mut prefix: i64 = 0;
        let bs = self.opts.brace_style.clone();
        let lk = self.lt_kind();
        let tn = self.toks[t].newlines;
        if lk == Tk.EndBlock {
            if self.fl[self.prev].inline_frame {
                prefix = 1;
            } else if not self.res_in(t, "else catch finally from") {
                prefix = 2;
            } else if bs == "expand" or bs == "end-expand" or (bs == "none" and tn != 0) {
                prefix = 2;
            } else {
                prefix = 1;
                self.space(true);
            }
        } else if lk == Tk.Semicolon and self.mode() == Mode.BlockStatement {
            prefix = 2;
        } else if lk == Tk.Semicolon and is_expression(self.mode()) {
            prefix = 1;
        } else if lk == Tk.Strng {
            prefix = 2;
        } else if lk == Tk.Reserved or lk == Tk.Word
            or (self.lt_is("*")
                and (self.llt_in("function yield") or (self.mode() == Mode.ObjectLiteral and self.llt_in("{ ,")))) {
            prefix = 1;
        } else if lk == Tk.StartBlock {
            if self.fl[self.cur].inline_frame {
                prefix = 1;
            } else {
                prefix = 2;
            }
        } else if lk == Tk.EndExpr {
            self.space(true);
            prefix = 2;
        }

        if self.res_line_starter(t) and not self.lt_is(")") {
            if self.fl[self.cur].inline_frame or self.lt_is("else ") or self.lt_is("export") {
                prefix = 1;
            } else {
                prefix = 2;
            }
        }

        if self.res_in(t, "else catch finally") {
            if (not (self.lt_kind() == Tk.EndBlock and self.prev_mode() == Mode.BlockStatement) or bs == "expand"
                or bs == "end-expand" or (bs == "none" and tn != 0))
                and not self.fl[self.cur].inline_frame {
                self.print_newline(false, false);
            } else {
                self.out.trim(true);
                // Put a newline back after anything but a close block:
                // the "} // comment" case.
                let k = self.out.cur();
                if not self.out.lines[k].last_is("}") {
                    self.print_newline(false, false);
                }
                self.space(true);
            }
        } else if prefix == 2 {
            if self.lt_res_in(SPECIAL_WORDS) {
                // No newline in return nnn.
                self.space(true);
            } else if self.lt_is("declare") and self.res_in(t, "var let const") {
                // TypeScript's declare
                self.space(true);
            } else if self.lt_kind() != Tk.EndExpr {
                // No forced newline on the var of for (var x = 0...
                if (self.lt_kind() != Tk.StartExpr or not self.res_in(t, "var let const")) and not self.lt_is(":") {
                    if self.res(t, "if") and self.lt_is("else") {
                        self.space(true);
                    } else {
                        self.print_newline(false, false);
                    }
                }
            } else if self.res_line_starter(t) and not self.lt_is(")") {
                self.print_newline(false, false);
            }
        } else if self.fl[self.cur].multiline_frame and self.mode() == Mode.ArrayLiteral and self.lt_is(",")
            and self.last_last_text == "}" {
            // "}," in lists gets a newline.
            self.print_newline(false, false);
        } else if prefix == 1 {
            self.space(true);
        }

        let p = self.toks[t].previous;
        if p >= 0 and (self.toks[p].kind == Tk.Word or self.toks[p].kind == Tk.Reserved) {
            self.space(true);
        }
        self.print_token(t);
        let text = self.toks[t].text.clone();
        let c = self.cur;
        self.fl[c].last_word = text.clone();
        if self.toks[t].kind == Tk.Reserved {
            if text == "do" {
                self.fl[c].do_block = true;
            } else if text == "if" {
                self.fl[c].if_block = true;
            } else if text == "import" {
                self.fl[c].import_block = true;
            } else if text == "from" and self.fl[c].import_block {
                self.fl[c].import_block = false;
            }
        }
    }

    fn handle_semicolon(mut ref self, t: i64) {
        if self.start_of_statement(t) {
            // A semicolon can start (and end) a statement.
            self.space(false);
        } else {
            self.handle_whitespace_and_comments(t, false);
        }
        let next = self.peek(0);
        while self.mode() == Mode.Statement and not (self.fl[self.cur].if_block and self.res(next, "else"))
            and not self.fl[self.cur].do_block {
            self.restore_mode();
        }
        if self.fl[self.cur].import_block {
            let c = self.cur;
            self.fl[c].import_block = false;
        }
        self.print_token(t);
    }

    fn handle_string(mut ref self, t: i64) {
        let backtick = first_char(self.toks[t].text) == '`';
        let tn = self.toks[t].newlines;
        let p = self.toks[t].previous;
        if backtick and tn == 0 and self.toks[t].ws == "" and (self.lt_kind() == Tk.Word or self.text_is(p, ")")) {
            // Backtick strings right after a word or ")" stay put.
        } else if self.start_of_statement(t) {
            // Strings want at least a space before them.
            self.space(true);
        } else {
            self.handle_whitespace_and_comments(t, false);
            let lk = self.lt_kind();
            if lk == Tk.Reserved or lk == Tk.Word or self.fl[self.cur].inline_frame {
                self.space(true);
            } else if lk == Tk.Comma or lk == Tk.StartExpr or lk == Tk.Equals or lk == Tk.Operator {
                if not self.start_of_object_property() {
                    self.allow_wrap_or_preserved_newline(t, false);
                }
            } else if backtick and lk == Tk.EndExpr and self.text_in(p, "] )") and tn == 0 {
                self.space(true);
            } else {
                self.print_newline(false, false);
            }
        }
        self.print_token(t);
    }

    fn handle_equals(mut ref self, t: i64) {
        if not self.start_of_statement(t) {
            self.handle_whitespace_and_comments(t, false);
        }
        if self.fl[self.cur].declaration_statement {
            // An = in a var line: different line breaking rules apply.
            let c = self.cur;
            self.fl[c].declaration_assignment = true;
        }
        self.space(true);
        self.print_token(t);
        self.space(true);
    }

    fn handle_comma(mut ref self, t: i64) {
        self.handle_whitespace_and_comments(t, true);
        self.print_token(t);
        self.space(true);
        if self.fl[self.cur].declaration_statement {
            let c = self.cur;
            if is_expression(self.parent_mode()) {
                // No break on the comma of for ( var a = 1, b = 2
                self.fl[c].declaration_assignment = false;
            }
            if self.fl[c].declaration_assignment {
                self.fl[c].declaration_assignment = false;
                self.print_newline(false, true);
            } else if self.opts.comma_first {
                // A newline before the comma becomes one after it, fixed
                // up later.
                self.allow_wrap_or_preserved_newline(t, false);
            }
        } else if self.mode() == Mode.ObjectLiteral
            or (self.mode() == Mode.Statement and self.parent_mode() == Mode.ObjectLiteral) {
            if self.mode() == Mode.Statement {
                self.restore_mode();
            }
            if not self.fl[self.cur].inline_frame {
                self.print_newline(false, false);
            }
        } else if self.opts.comma_first {
            self.allow_wrap_or_preserved_newline(t, false);
        }
    }

    fn handle_operator(mut ref self, t: i64) {
        let text = self.toks[t].text.clone();
        let lk = self.lt_kind();
        let is_generator_asterisk = text == "*"
            and (self.lt_res_in("function yield") or lk == Tk.StartBlock or lk == Tk.Comma or lk == Tk.EndBlock
                or lk == Tk.Semicolon);
        let is_unary = (text == "+" or text == "-")
            and (lk == Tk.StartBlock or lk == Tk.StartExpr or lk == Tk.Equals or lk == Tk.Operator
                or line_starter(self.toks[self.lt()].text) or self.lt_is(","));

        if not self.start_of_statement(t) {
            self.handle_whitespace_and_comments(t, not is_generator_asterisk);
        }
        // ActionScript's import .*;
        if text == "*" and self.lt_kind() == Tk.Dot {
            self.print_token(t);
            return;
        }
        // No spaces around the namespacing operator.
        if text == "::" {
            self.print_token(t);
            return;
        }
        // A numeric property value with a +/- sign in front.
        if (text == "-" or text == "+") and self.start_of_object_property() {
            self.print_token(t);
            return;
        }
        let op = self.opts.operator_position.clone();
        // Wrapping between operators when operator_position is before or
        // preserve.
        if self.lt_kind() == Tk.Operator and (op == "before-newline" or op == "preserve-newline") {
            self.allow_wrap_or_preserved_newline(t, false);
        }

        if text == ":" and self.fl[self.cur].in_case {
            self.print_token(t);
            let c = self.cur;
            self.fl[c].in_case = false;
            self.fl[c].case_body = true;
            if self.kind(self.peek(0)) != Tk.StartBlock {
                self.indent();
                self.print_newline(false, false);
                let c = self.cur;
                self.fl[c].case_block = false;
            } else {
                self.space(true);
                let c = self.cur;
                self.fl[c].case_block = true;
            }
            return;
        }

        let mut space_before = true;
        let mut space_after = true;
        let mut in_ternary = false;
        if text == ":" {
            if self.fl[self.cur].ternary_depth == 0 {
                // A colon outside ternaries and objects is invalid; guess.
                space_before = false;
            } else {
                let c = self.cur;
                self.fl[c].ternary_depth -= 1;
                in_ternary = true;
            }
        } else if text == "?" {
            let c = self.cur;
            self.fl[c].ternary_depth += 1;
        }

        // operator_position, before any conflicting logic.
        if not is_unary and not is_generator_asterisk and self.opts.preserve_newlines and positionable(text) {
            let is_colon = text == ":";
            let is_ternary_colon = is_colon and in_ternary;
            let is_other_colon = is_colon and not in_ternary;
            if op == "before-newline" {
                self.space(not is_other_colon);
                self.print_token(t);
                if not is_colon or is_ternary_colon {
                    self.allow_wrap_or_preserved_newline(t, false);
                }
                self.space(true);
                return;
            } else if op == "after-newline" {
                self.space(true);
                if not is_colon or is_ternary_colon {
                    if self.newlines(self.peek(0)) != 0 {
                        self.print_newline(false, true);
                    } else {
                        self.allow_wrap_or_preserved_newline(t, false);
                    }
                } else {
                    self.space(false);
                }
                self.print_token(t);
                self.space(true);
                return;
            } else if op == "preserve-newline" {
                if not is_other_colon {
                    self.allow_wrap_or_preserved_newline(t, false);
                }
                let on = not (self.out.just_added_newline() or is_other_colon);
                self.space(on);
                self.print_token(t);
                self.space(true);
                return;
            }
        }

        if is_generator_asterisk {
            self.allow_wrap_or_preserved_newline(t, false);
            space_before = false;
            let nk = self.kind(self.peek(0));
            space_after = nk == Tk.Word or nk == Tk.Reserved;
        } else if text == "..." {
            self.allow_wrap_or_preserved_newline(t, false);
            space_before = self.lt_kind() == Tk.StartBlock;
            space_after = false;
        } else if in_list(text, "-- ++ ! ~") or is_unary {
            if self.lt_kind() == Tk.Comma or self.lt_kind() == Tk.StartExpr {
                self.allow_wrap_or_preserved_newline(t, false);
            }
            space_before = false;
            space_after = false;
            // ECMA-262 5.1 7.9.1: a newline between -- or ++ and anything
            // else is kept.
            let tn = self.toks[t].newlines;
            if tn != 0 and (text == "--" or text == "++" or text == "~") {
                let new_line_needed = self.lt_res_in(SPECIAL_WORDS) and tn != 0;
                if new_line_needed and (self.fl[self.prev].if_block or self.fl[self.prev].else_block) {
                    self.restore_mode();
                }
                self.print_newline(new_line_needed, true);
            }
            // for (;; ++i)
            if self.lt_is(";") and is_expression(self.mode()) {
                space_before = true;
            }
            let lk = self.lt_kind();
            if lk == Tk.Reserved {
                space_before = true;
            } else if lk == Tk.EndExpr {
                space_before = not (self.lt_is("]") and (text == "--" or text == "++"));
            } else if lk == Tk.Operator {
                // a++ + ++b, a - -b; + and - after -- or ++ are not unary.
                space_before = in_list(text, "-- - ++ +") and self.lt_in("-- - ++ +");
                if (text == "-" or text == "+") and self.lt_in("-- ++") {
                    space_after = true;
                }
            }
            let mode = self.mode();
            if ((mode == Mode.BlockStatement and not self.fl[self.cur].inline_frame) or mode == Mode.Statement)
                and self.lt_in("{ ;") {
                // { foo: --i }, foo(): --bar
                self.print_newline(false, false);
            }
        }

        if space_before {
            self.space(true);
        }
        self.print_token(t);
        if space_after {
            self.space(true);
        }
    }

    fn handle_block_comment(mut ref self, t: i64, preserve: bool) {
        if self.out.raw {
            let newlines = self.toks[t].newlines;
            let ws = self.toks[t].ws.clone();
            let text = self.toks[t].text.clone();
            self.out.add_raw_token(newlines, ws, text);
            if directive(self.toks[t], "preserve") == "end" {
                self.out.raw = false;
            }
            return;
        }
        if self.toks[t].directives.len() > 0 {
            self.print_newline(false, preserve);
            self.print_token(t);
            if directive(self.toks[t], "preserve") == "start" {
                self.out.raw = true;
            }
            self.print_newline(false, true);
            return;
        }
        let text = self.toks[t].text.clone();
        // An inline block comment.
        if not text.chars().any(|c| js_newline(c)) and self.toks[t].newlines == 0 {
            self.space(true);
            self.print_token(t);
            self.space(true);
            return;
        }
        let lines = split_breaks(text);
        let last_indent = self.toks[t].ws.clone();
        let last_indent_length = clen(last_indent);

        // A block comment starts on a new line; its first line is always
        // indented.
        self.print_newline(false, preserve);
        self.print_token_text(t, lines[0].clone());
        self.print_newline(false, preserve);

        if lines.len() > 1 {
            let mut rest: Vec[String] = Vec.new();
            for i in 1..lines.len() as i64 {
                rest.push(lines[i].clone());
            }
            // any() over the lines themselves skips the empty ones.
            let mut javadoc = true;
            let mut starless = true;
            for l in rest.iter() {
                if l.len() > 0 and (py_strip(l) == "" or first_char(py_lstrip(l)) != '*') {
                    javadoc = false;
                }
                if not (l.starts_with(last_indent.as_str()) or py_strip(l) == "") {
                    starless = false;
                }
            }
            if javadoc {
                let c = self.cur;
                self.fl[c].alignment = 1;
            }
            for line in rest {
                if javadoc {
                    // javadoc: reformat and re-indent
                    self.print_token_text(t, py_lstrip(line));
                } else if starless and clen(line) > last_indent_length {
                    // starless: re-indent non-empty content, avoiding trim
                    self.print_token_text(t, drop_chars(line, last_indent_length));
                } else {
                    // anything else is output raw
                    let k = self.out.cur();
                    self.out.line_set_indent(k, -1, 0);
                    self.out.add_token(line);
                }
                // A comment on its own line or over several lines is
                // followed by a new line.
                self.print_newline(false, preserve);
            }
            let c = self.cur;
            self.fl[c].alignment = 0;
        }
    }

    fn handle_comment(mut ref self, t: i64, preserve: bool) {
        if self.toks[t].newlines != 0 {
            self.print_newline(false, preserve);
        } else {
            self.out.trim(true);
        }
        self.space(true);
        self.print_token(t);
        self.print_newline(false, preserve);
    }

    fn handle_dot(mut ref self, t: i64) {
        if not self.start_of_statement(t) {
            self.handle_whitespace_and_comments(t, true);
        }
        if all_digits(self.toks[self.lt()].text) {
            self.space(true);
        }
        if self.lt_res_in(SPECIAL_WORDS) {
            self.space(false);
        } else {
            // Newlines before dots are kept, and forced after a close
            // paren with break_chained_methods: bar().baz()
            let force = self.lt_is(")") and self.opts.break_chained_methods;
            self.allow_wrap_or_preserved_newline(t, force);
        }
        // Unindent a chained method's dot only when it starts a line.
        if self.opts.unindent_chained_methods and self.out.just_added_newline() {
            self.deindent();
        }
        self.print_token(t);
    }

    fn handle_unknown(mut ref self, t: i64, preserve: bool) {
        self.print_token(t);
        if last_char(self.toks[t].text) == '\n' {
            self.print_newline(false, preserve);
        }
    }

    fn handle_eof(mut ref self, t: i64) {
        // Unwind any open statements.
        while self.mode() == Mode.Statement {
            self.restore_mode();
        }
        self.handle_whitespace_and_comments(t, false);
    }
}

// Beautifier.beautify for one call, with the options already built.
fn beautify(src: ref String, opts: own Opts, id_start: ref Vec[(i64, i64)], id_part: ref Vec[(i64, i64)]) -> String {
    if opts.disabled {
        return src.clone();
    }
    let mut o = opts;
    let cs = chars_of(src);
    let n = cs.len() as i64;
    if o.eol == "auto" {
        // acorn.lineBreak: the source's first line break.
        o.eol = "\n".to_string();
        let mut i: i64 = 0;
        while i < n {
            let c = cs[i];
            if c == '\r' and i + 1 < n and cs[i + 1] == '\n' {
                o.eol = "\r\n".to_string();
                break;
            }
            if js_newline(c) {
                o.eol = String.new();
                o.eol.push(c);
                break;
            }
            i += 1;
        }
    }
    // re.search("^[\t ]*", source)
    let mut base_end: i64 = 0;
    while base_end < n and (cs[base_end] == '\t' or cs[base_end] == ' ') {
        base_end += 1;
    }
    let base_indent = text_of(cs, 0, base_end);
    let out = new_output(o, base_indent);
    let mut lx = new_lexer(src, o, id_start, id_part);
    lx.tokenize();
    let eol = o.eol.clone();
    let mut b = Beautifier {
        opts: o,
        toks: lx.toks,
        stream: lx.stream,
        pos: 0,
        fl: Vec.new(),
        cur: -1,
        prev: -1,
        store: Vec.new(),
        out: out,
        last_last_text: String.new(),
    };
    b.set_mode(Mode.BlockStatement);
    let count = b.stream.len() as i64;
    let mut i: i64 = 0;
    while i < count {
        let t = b.stream[i];
        b.pos = i + 1;
        b.handle_token(t, false);
        let c = b.cur;
        let lt = b.fl[c].last_token;
        b.last_last_text = b.toks[lt].text.clone();
        b.fl[c].last_token = t;
        i += 1;
    }
    b.out.get_code(eol)
}

// ------------------------------------------------------------ main

// The first `count` space-separated fields of a line, then the rest of it
// (which may hold spaces).
fn fields(line: ref String, count: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in line.chars() {
        if c == ' ' and out.len() as i64 < count {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn parse_value(kind: ref String, text: ref String) -> Val {
    if kind == "b" {
        Val.B(text == "1")
    } else if kind == "i" {
        Val.I(i64.parse(text).unwrap_or(0))
    } else if kind == "s" {
        Val.S(unescape(text))
    } else {
        let mut parts: Vec[String] = Vec.new();
        for p in unescape(text).split(",") {
            parts.push(p.to_string());
        }
        Val.L(parts)
    }
}

struct Job {
    n: i64,
    set: i64,
    src: String,
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = fs.write("data/jobs.txt".to_string(), jobs_text()) {
        eprintln(f"cannot write data/jobs.txt: {e}");
        return;
    }
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read data/jobs.txt: {e}");
            return;
        },
    };
    let id_start = parse_ranges(ID_START);
    let id_part = parse_ranges(ID_PART);

    // Option sets are numbered from 1, in order.
    let mut sets: Vec[Raw] = Vec.new();
    let mut jobs: Vec[Job] = Vec.new();
    for line in text.split("\n") {
        let line = line.to_string();
        if line.starts_with("set ") {
            sets.push(Raw { items: Vec.new(), child: Vec.new() });
        } else if line.starts_with("o ") {
            let f = fields(line, 3);
            let v = parse_value(f[2], f[3]);
            let k = sets.len() - 1;
            if f[1].starts_with("js.") {
                sets[k].child.push((drop_chars(f[1], 3), v));
            } else {
                sets[k].items.push((f[1].clone(), v));
            }
        } else if line.starts_with("job ") {
            let f = fields(line, 2);
            let n = i64.parse(f[1]).unwrap_or(0);
            let s = i64.parse(f[2]).unwrap_or(0);
            jobs.push(Job { n: n, set: s, src: String.new() });
        } else if line.starts_with("in ") {
            let k = jobs.len() - 1;
            jobs[k].src = unescape(drop_chars(line, 3));
        }
    }

    for job in jobs.iter() {
        let opts = make_opts(sets[job.set - 1]);
        let out = beautify(job.src, opts, id_start, id_part);
        println(f"== {job.n} (set {job.set}, {clen(job.src)} chars in, {clen(out)} out)");
        for part in out.split("\n") {
            println(f"| {escape_line(part.to_string())}");
        }
    }
    println(f"{jobs.len()} jobs");
}

