// mini_jsbeautifier: jsbeautifier 2.0.3 (beautifier.io's JavaScript
// beautifier, MIT), ported to Kara. It reads data/jobs.txt, which holds the
// beautify() calls jsbeautifier's own test suite makes, each with its
// options, and prints what every call returns.

// ------------------------------------------------------------ text helpers

// str.isspace(), which is also what \s matches in a Python str pattern.
fn py_space(c: char) -> bool {
    let n = c as u32;
    (n >= 9 and n <= 13) or n == 32 or (n >= 0x1c and n <= 0x1f) or n == 0x85 or n == 0xa0 or n == 0x1680
        or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029 or n == 0x202f or n == 0x205f
        or n == 0x3000
}

// \w in a Python str pattern.
fn py_word(c: char) -> bool {
    c == '_' or c.is_alphanumeric()
}

// \r, \n,   and  : acorn's newline.
fn js_newline(c: char) -> bool {
    c == '\n' or c == '\r' or c == '\u{2028}' or c == '\u{2029}'
}

fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text_of(cs: ref Vec[char], from: i64, to: i64) -> String {
    let mut out = String.new();
    let mut i = from;
    while i < to {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// len() of a Python str: the number of code points.
fn clen(s: ref String) -> i64 {
    s.chars().count() as i64
}

fn first_char(s: ref String) -> char {
    match s.chars().next() {
        Some(c) => c,
        None => '\u{0}',
    }
}

fn last_char(s: ref String) -> char {
    let mut last = '\u{0}';
    for c in s.chars() {
        last = c;
    }
    last
}

// s[n:] by code points.
fn drop_chars(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut i: i64 = 0;
    for c in s.chars() {
        if i >= n {
            out.push(c);
        }
        i += 1;
    }
    out
}

fn py_lstrip(s: ref String) -> String {
    let mut out = String.new();
    let mut started = false;
    for c in s.chars() {
        if started or not py_space(c) {
            started = true;
            out.push(c);
        }
    }
    out
}

fn py_strip(s: ref String) -> String {
    let cs = chars_of(py_lstrip(s));
    let mut end = cs.len() as i64;
    while end > 0 and py_space(cs[end - 1]) {
        end -= 1;
    }
    text_of(cs, 0, end)
}

// acorn.allLineBreaks.sub("\n", s): \r\n and each of \r, \n,   and
//   become \n.
fn normalize_breaks(s: ref String) -> String {
    let cs = chars_of(s);
    let mut out = String.new();
    let mut i: i64 = 0;
    let n = cs.len() as i64;
    while i < n {
        let c = cs[i];
        if c == '\r' and i + 1 < n and cs[i + 1] == '\n' {
            out.push('\n');
            i += 2;
        } else if js_newline(c) {
            out.push('\n');
            i += 1;
        } else {
            out.push(c);
            i += 1;
        }
    }
    out
}

// acorn.allLineBreaks.split(s)
fn split_breaks(s: ref String) -> Vec[String] {
    let cs = chars_of(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i: i64 = 0;
    let n = cs.len() as i64;
    while i < n {
        let c = cs[i];
        if js_newline(c) {
            out.push(cur);
            cur = String.new();
            if c == '\r' and i + 1 < n and cs[i + 1] == '\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    out.push(cur);
    out
}

fn hex_value(c: char) -> i64 {
    match c {
        '0'..='9' => (c as u32 - '0' as u32) as i64,
        'a'..='f' => (c as u32 - 'a' as u32 + 10) as i64,
        'A'..='F' => (c as u32 - 'A' as u32 + 10) as i64,
        _ => -1,
    }
}

fn hex_digit(c: char) -> bool {
    hex_value(c) >= 0
}

// The escapes data/jobs.txt uses: \\, \n, \r, \t and \u{hex}.
fn unescape(s: ref String) -> String {
    let cs = chars_of(s);
    let mut out = String.new();
    let mut i: i64 = 0;
    let n = cs.len() as i64;
    while i < n {
        let c = cs[i];
        if c != '\\' {
            out.push(c);
            i += 1;
            continue;
        }
        let d = cs[i + 1];
        if d == 'n' {
            out.push('\n');
            i += 2;
        } else if d == 'r' {
            out.push('\r');
            i += 2;
        } else if d == 't' {
            out.push('\t');
            i += 2;
        } else if d == '\\' {
            out.push('\\');
            i += 2;
        } else {
            let mut v: i64 = 0;
            let mut j = i + 3;
            while cs[j] != '}' {
                v = v * 16 + hex_value(cs[j]);
                j += 1;
            }
            match char.try_from(v as u32) {
                Ok(ch) => out.push(ch),
                Err(_) => {}
            }
            i = j + 1;
        }
    }
    out
}

// Code points a printed line shows as \u{hex}: Unicode categories Z and C
// above ASCII (the ones present in the jobs), besides the ASCII controls.
fn shown_escaped(c: char) -> bool {
    let n = c as u32;
    n < 0x20 or n == 0x7f or (n >= 0x80 and n < 0xa0) or n == 0xa0 or n == 0xad or n == 0x1680 or n == 0x180e
        or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) or (n >= 0x205f and n <= 0x206f)
        or n == 0x3000 or n == 0xfeff or (n >= 0xfff0 and n <= 0xffff) or (n >= 0xd800 and n <= 0xf8ff)
        or n >= 0xe0000
}

fn escape_line(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if shown_escaped(c) {
            out.push_str(f"\\u{{{(c as u32):x}}}");
        } else {
            out.push(c);
        }
    }
    out
}

// ------------------------------------------------------------ options

// A recorded option value, as the test suite set it on its options object.
#[derive(Clone)]
enum Val {
    B(bool),
    I(i64),
    S(String),
    L(Vec[String]),
}

// The raw options a beautify() call gets: the attributes of the object the
// test suite passed, in order, and its `js` child options.
struct Raw {
    items: Vec[(String, Val)],
    child: Vec[(String, Val)],
}

fn raw_put(items: mut ref Vec[(String, Val)], key: own String, v: own Val) {
    for e in items.iter_mut() {
        if e.0 == key {
            e.1 = v;
            return;
        }
    }
    items.push((key, v));
}

// options._mergeOpts(options, "js"), after _normalizeOpts: a dashed name
// is renamed to its underscored form, and the js child's values override.
fn merge_raw(raw: ref Raw) -> Vec[(String, Val)] {
    let mut out: Vec[(String, Val)] = Vec.new();
    for (k, v) in raw.items.iter() {
        if not k.contains("-") {
            out.push((k.clone(), v.clone()));
        }
    }
    for (k, v) in raw.items.iter() {
        if k.contains("-") {
            raw_put(mut out, k.replace("-", "_"), v.clone());
        }
    }
    for (k, v) in raw.child.iter() {
        raw_put(mut out, k.clone(), v.clone());
    }
    out
}

fn raw_get(items: ref Vec[(String, Val)], name: Str) -> Option[Val] {
    for (k, v) in items.iter() {
        if k == name {
            return Some(v.clone());
        }
    }
    None
}

fn get_boolean(items: ref Vec[(String, Val)], name: Str, default: bool) -> bool {
    match raw_get(items, name) {
        None => default,
        Some(Val.B(b)) => b,
        Some(Val.I(i)) => i != 0,
        Some(Val.S(s)) => s.len() > 0,
        Some(Val.L(l)) => l.len() > 0,
    }
}

fn get_characters(items: ref Vec[(String, Val)], name: Str, default: Str) -> String {
    let v = match raw_get(items, name) {
        None => default.to_string(),
        Some(Val.S(s)) => s,
        Some(_) => return String.new(),
    };
    v.replace("\\r", "\r").replace("\\n", "\n").replace("\\t", "\t")
}

fn get_number(items: ref Vec[(String, Val)], name: Str, default: i64) -> i64 {
    match raw_get(items, name) {
        None => default,
        Some(Val.I(i)) => i,
        Some(Val.B(b)) => if b { 1 } else { 0 },
        Some(Val.S(s)) => i64.parse(py_strip(s)).unwrap_or(0),
        Some(Val.L(_)) => 0,
    }
}

// re.split(r"[^a-zA-Z0-9_/\-]+", value)
fn split_selection(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut in_sep = false;
    for c in s.chars() {
        if c.is_ascii_alphanumeric() or c == '_' or c == '/' or c == '-' {
            cur.push(c);
            in_sep = false;
        } else if not in_sep {
            out.push(cur);
            cur = String.new();
            in_sep = true;
        }
    }
    out.push(cur);
    out
}

fn get_array(items: ref Vec[(String, Val)], name: Str, default: ref Vec[String]) -> Vec[String] {
    match raw_get(items, name) {
        None => default.clone(),
        Some(Val.L(l)) => l,
        Some(Val.S(s)) => split_selection(s),
        Some(_) => Vec.new(),
    }
}

struct Opts {
    disabled: bool,
    eol: String,
    end_with_newline: bool,
    indent_size: i64,
    indent_char: String,
    indent_level: i64,
    preserve_newlines: bool,
    max_preserve_newlines: i64,
    indent_with_tabs: bool,
    wrap_line_length: i64,
    indent_empty_lines: bool,
    templating: Vec[String],
    brace_preserve_inline: bool,
    brace_style: String,
    unindent_chained_methods: bool,
    break_chained_methods: bool,
    space_in_paren: bool,
    space_in_empty_paren: bool,
    jslint_happy: bool,
    space_after_anon_function: bool,
    space_after_named_function: bool,
    keep_array_indentation: bool,
    space_before_conditional: bool,
    unescape_strings: bool,
    e4x: bool,
    comma_first: bool,
    operator_position: String,
}

fn one(s: Str) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(s.to_string());
    v
}

// core.options.Options and javascript.options.BeautifierOptions.
fn make_opts(raw: ref Raw) -> Opts {
    let mut items = merge_raw(raw);
    let indent_char0 = get_characters(items, "indent_char", " ");
    let preserve = get_boolean(items, "preserve_newlines", true);
    let mut max_preserve = get_number(items, "max_preserve_newlines", 32786);
    if not preserve {
        max_preserve = 0;
    }
    let tabs = get_boolean(items, "indent_with_tabs", indent_char0 == "\t");
    let mut indent_char = indent_char0;
    let mut indent_size = get_number(items, "indent_size", 4);
    if tabs {
        indent_char = "\t".to_string();
        if indent_size == 1 {
            indent_size = 4;
        }
    }
    let wrap = get_number(items, "wrap_line_length", get_number(items, "max_char", 0));
    let templating = get_array(items, "templating", one("auto"));

    match raw_get(items, "brace_style") {
        Some(Val.S(s)) => {
            if s == "expand-strict" {
                raw_put(mut items, "brace_style".to_string(), Val.S("expand".to_string()));
            } else if s == "collapse-preserve-inline" {
                raw_put(mut items, "brace_style".to_string(), Val.S("collapse,preserve-inline".to_string()));
            }
        }
        _ => {}
    }
    let mut preserve_inline = false;
    let mut brace_style = "collapse".to_string();
    for bs in get_array(items, "brace_style", one("collapse")).into_iter() {
        if bs == "preserve-inline" {
            preserve_inline = true;
        } else {
            brace_style = bs;
        }
    }
    let jslint = get_boolean(items, "jslint_happy", false);
    let operator_position = match get_array(items, "operator_position", one("before-newline")).first() {
        Some(p) => p.clone(),
        None => "before-newline".to_string(),
    };
    Opts {
        disabled: get_boolean(items, "disabled", false),
        eol: get_characters(items, "eol", "auto"),
        end_with_newline: get_boolean(items, "end_with_newline", false),
        indent_size: indent_size,
        indent_char: indent_char,
        indent_level: get_number(items, "indent_level", 0),
        preserve_newlines: preserve,
        max_preserve_newlines: max_preserve,
        indent_with_tabs: tabs,
        wrap_line_length: wrap,
        indent_empty_lines: get_boolean(items, "indent_empty_lines", false),
        templating: templating,
        brace_preserve_inline: preserve_inline,
        brace_style: brace_style,
        unindent_chained_methods: get_boolean(items, "unindent_chained_methods", false),
        break_chained_methods: get_boolean(items, "break_chained_methods", false),
        space_in_paren: get_boolean(items, "space_in_paren", false),
        space_in_empty_paren: get_boolean(items, "space_in_empty_paren", false),
        jslint_happy: jslint,
        space_after_anon_function: jslint or get_boolean(items, "space_after_anon_function", false),
        space_after_named_function: get_boolean(items, "space_after_named_function", false),
        keep_array_indentation: get_boolean(items, "keep_array_indentation", false),
        space_before_conditional: get_boolean(items, "space_before_conditional", true),
        unescape_strings: get_boolean(items, "unescape_strings", false),
        e4x: get_boolean(items, "e4x", false),
        comma_first: get_boolean(items, "comma_first", false),
        operator_position: operator_position,
    }
}

// ------------------------------------------------------------ acorn character classes

