fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data/cli")?;
    put("data/cli/package-lock.json", file_0())?;
    put("data/cli/package.json", file_1())?;
    make_dir("data")?;
    put("data/jobs.txt", file_2())?;
    put("data/registry.json", file_3())?;
    make_dir("data/web")?;
    put("data/web/package-lock.json", file_4())?;
    put("data/web/package.json", file_5())?;
    Ok(())
}

// The names of the input files.
fn data_names() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push("cli/package-lock.json".to_string());
    v.push("cli/package.json".to_string());
    v.push("jobs.txt".to_string());
    v.push("registry.json".to_string());
    v.push("web/package-lock.json".to_string());
    v.push("web/package.json".to_string());
    v
}

// ------------------------------------------------------------ the jobs

fn run() -> Result[(), String] {
    write_data()?;
    let rx = semver_rx();
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    for line in lines_of(text) {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let w = words(line);
        let mut out = f"$ {line}\n";
        let rest: Vec[String] = w[1..].to_vec();
        if w[0] == "semver" {
            let r = semver_cli(rx, rest);
            out.push_str(r.out);
            out.push_str(r.err);
            if r.status != 0 {
                out.push_str(f"[exit status {r.status}]\n");
            }
        } else if w[0] == "lib" {
            let args: Vec[String] = rest[1..].to_vec();
            out.push_str(lib_line(rx, rest[0], args));
            out.push_str("\n");
        } else if w[0] == "outdated" {
            out.push_str(outdated(rx, rest[0])?);
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
