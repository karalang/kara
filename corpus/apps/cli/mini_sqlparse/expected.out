== 218 format "-- note 20\nupdate users set email = 0 where name in (19, 17, 14);\nupdate users set name = 0 where name < 'paid';\nselect id as label, u.id, id as a, name, o.total from items where price like '%x_y%' or u.id < null or o.total in (54, 96) group by u.id order by email;\n" identifier_case='lower' truncate_strings=4 indent_columns=True
  |-- note 20
  |
  |update users
  |set email = 0
  |where name in (
  |                 19,
  |                 17,
  |                 14);
  |
  |
  |update users
  |set name = 0
  |where name < 'paid';
  |
  |
  |select
  |  id as label,
  |  u.id,
  |  id as a,
  |  name,
  |  o.total
  |from items
  |where price like '%x_y[...]'
  |  or u.id < null
  |  or o.total in (
  |                   54,
  |                   96)
  |group by u.id
  |order by email;
