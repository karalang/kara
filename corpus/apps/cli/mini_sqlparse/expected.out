== 115 format analytics/daily_revenue.sql reindent=True indent_width=4 indent_after_first=True
  |with paid as
  |        (select o.id,
  |                o.customer_id,
  |                date_trunc('day', o.placed_at) as day,
  |                o.total_cents
  |         from orders o
  |         where o.status in ('paid',
  |                            'shipped')
  |             and o.placed_at >= now() - interval '30 days'),
  |     ranked as
  |        (select p.*,
  |                row_number() over (partition by p.customer_id
  |                                   order by p.total_cents desc) as rn
  |         from paid p)
  |    select day,
  |           count(*) as orders,
  |           sum(total_cents) / 100.0 as revenue,
  |           avg(total_cents)::numeric(10, 2) as avg_cents,
  |           case
  |               when sum(total_cents) > 1000000 then 'big'
  |               when sum(total_cents) > 100000 then 'medium'
  |               else 'small'
  |           end as bucket
  |    from ranked
  |    where rn = 1
  |    group by day
  |    having count(*) > 5
  |    order by day desc nulls last
  |    limit 30;
