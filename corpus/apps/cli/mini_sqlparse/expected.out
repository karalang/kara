== 143 format plpgsql/proc.sql strip_comments=True reindent=True keyword_case='upper' use_space_around_operators=True
  |CREATE FUNCTION bump_counter(p_id int) RETURNS void AS BEGIN DECLARE c int;
  |FOR r IN
  |SELECT id
  |FROM counters LOOP
  |UPDATE counters
  |SET n = n + 1
  |WHERE id = r.id; END LOOP; IF p_id > 0 THEN
  |UPDATE counters
  |SET n = 0
  |WHERE id = p_id; END IF; END;
  |SELECT bump_counter(3);
