== 126 format plpgsql/audit.sql reindent_aligned=True
  |CREATE OR REPLACE
  |FUNCTION audit_order_change() RETURNS trigger AS $$
  |DECLARE
  |    changed text;
  |BEGIN
  |    IF TG_OP = 'UPDATE' THEN
  |        changed := 'update';
  |    ELSE
  |        changed := 'other';
  |    END IF;
  |    INSERT INTO order_audit (order_id, action, at) VALUES (NEW.id, changed, now());
  |    RETURN NEW;
  |END;
  |$$ LANGUAGE plpgsql;CREATE TRIGGER orders_audit AFTER UPDATE
  |    ON orders
  |   FOR EACH ROW EXECUTE
  |FUNCTION audit_order_change();
== 127 format plpgsql/proc.sql reindent_aligned=True
  |create
  |function bump_counter(p_id int) returns void as begin declare c int;
  |   for r in select id
  |  from counters loop update counters
  |   set n = n + 1
  | where id = r.id; end loop; if p_id > 0 then update counters
  |   set n = 0
  | where id = p_id; end if; end; select bump_counter(3);
