== 98 format analytics/cohorts.sql 
  |SELECT c.id AS customer, MIN(o.placed_at) AS first_order, COUNT(DISTINCT o.id) orders,
  |  SUM(CASE WHEN o.status = 'refunded' THEN 1 ELSE 0 END) AS refunds
  |FROM customers c LEFT OUTER JOIN orders o ON o.customer_id = c.id
  |WHERE c.created_at BETWEEN '2024-01-01' AND '2024-12-31' AND c.email NOT LIKE '%@example.com'
  |GROUP BY c.id ORDER BY first_order ASC, orders DESC;
  |SELECT * FROM customers WHERE id IN (SELECT customer_id FROM orders WHERE total_cents > 50000);
== 99 format analytics/daily_revenue.sql 
  |with paid as (
  |    select o.id, o.customer_id, date_trunc('day', o.placed_at) as day, o.total_cents
  |    from orders o
  |    where o.status in ('paid', 'shipped') and o.placed_at >= now() - interval '30 days'
  |), ranked as (
  |    select p.*, row_number() over (partition by p.customer_id order by p.total_cents desc) as rn
  |    from paid p
  |)
  |select day, count(*) as orders, sum(total_cents) / 100.0 as revenue,
  |       avg(total_cents)::numeric(10,2) as avg_cents,
  |       case when sum(total_cents) > 1000000 then 'big' when sum(total_cents) > 100000 then 'medium' else 'small' end as bucket
  |from ranked
  |where rn = 1
  |group by day
  |having count(*) > 5
  |order by day desc nulls last
  |limit 30;
== 100 format migrations/0001_initial.sql keyword_case='upper'
  |-- Initial schema for the orders service.
  |-- Generated by hand, reviewed in PR 118.
  |
  |CREATE TABLE customers (
  |    id          BIGSERIAL PRIMARY KEY,
  |    email       VARCHAR(255) NOT NULL UNIQUE,
  |    full_name   TEXT,
  |    created_at  TIMESTAMP WITH TIME ZONE DEFAULT now(),
  |    is_active   BOOLEAN NOT NULL DEFAULT TRUE
  |);
  |
  |CREATE TABLE orders (
  |    id           BIGSERIAL PRIMARY KEY,
  |    customer_id  BIGINT NOT NULL REFERENCES customers(id) ON DELETE CASCADE,
  |    status       VARCHAR(20) NOT NULL DEFAULT 'pending',
  |    total_cents  INTEGER NOT NULL CHECK (total_cents >= 0),
  |    placed_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
  |);
  |
  |CREATE INDEX orders_customer_idx ON orders (customer_id);
  |CREATE UNIQUE INDEX customers_email_lower_idx ON customers (lower(email));
  |
  |COMMENT ON TABLE orders IS 'One row per checkout';
