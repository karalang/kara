== 48 split analytics/cohorts.sql
  [0] "SELECT c.id AS customer, MIN(o.placed_at) AS first_order, COUNT(DISTINCT o.id) orders,\n  SUM(CASE WHEN o.status = 'refunded' THEN 1 ELSE 0 END) AS refunds\nFROM customers c LEFT OUTER JOIN orders o ON o.customer_id = c.id\nWHERE c.created_at BETWEEN '2024-01-01' AND '2024-12-31' AND c.email NOT LIKE '%@example.com'\nGROUP BY c.id ORDER BY first_order ASC, orders DESC;"
  [1] 'SELECT * FROM customers WHERE id IN (SELECT customer_id FROM orders WHERE total_cents > 50000);'
  2 statements
== 49 split analytics/daily_revenue.sql
  [0] "with paid as (\n    select o.id, o.customer_id, date_trunc('day', o.placed_at) as day, o.total_cents\n    from orders o\n    where o.status in ('paid', 'shipped') and o.placed_at >= now() - interval '30 days'\n), ranked as (\n    select p.*, row_number() over (partition by p.customer_id order by p.total_cents desc) as rn\n    from paid p\n)\nselect day, count(*) as orders, sum(total_cents) / 100.0 as revenue,\n       avg(total_cents)::numeric(10,2) as avg_cents,\n       case when sum(total_cents) > 1000000 then 'big' when sum(total_cents) > 100000 then 'medium' else 'small' end as bucket\nfrom ranked\nwhere rn = 1\ngroup by day\nhaving count(*) > 5\norder by day desc nulls last\nlimit 30;"
  1 statements
