== 51 split migrations/0001_initial.sql
  [0] '-- Initial schema for the orders service.\n-- Generated by hand, reviewed in PR 118.\n\nCREATE TABLE customers (\n    id          BIGSERIAL PRIMARY KEY,\n    email       VARCHAR(255) NOT NULL UNIQUE,\n    full_name   TEXT,\n    created_at  TIMESTAMP WITH TIME ZONE DEFAULT now(),\n    is_active   BOOLEAN NOT NULL DEFAULT TRUE\n);'
  [1] "CREATE TABLE orders (\n    id           BIGSERIAL PRIMARY KEY,\n    customer_id  BIGINT NOT NULL REFERENCES customers(id) ON DELETE CASCADE,\n    status       VARCHAR(20) NOT NULL DEFAULT 'pending',\n    total_cents  INTEGER NOT NULL CHECK (total_cents >= 0),\n    placed_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);"
  [2] 'CREATE INDEX orders_customer_idx ON orders (customer_id);'
  [3] 'CREATE UNIQUE INDEX customers_email_lower_idx ON customers (lower(email));'
  [4] "COMMENT ON TABLE orders IS 'One row per checkout';"
  5 statements
