    t.push_str("DECLARE\n");
    t.push_str("    changed text;\n");
    t.push_str("BEGIN\n");
    t.push_str("    IF TG_OP = 'UPDATE' THEN\n");
    t.push_str("        changed := 'update';\n");
    t.push_str("    ELSE\n");
    t.push_str("        changed := 'other';\n");
    t.push_str("    END IF;\n");
    t.push_str("    INSERT INTO order_audit (order_id, action, at) VALUES (NEW.id, changed, now());\n");
    t.push_str("    RETURN NEW;\n");
    t.push_str("END;\n");
    t.push_str("$$ LANGUAGE plpgsql;\n");
    t.push_str("\n");
    t.push_str("CREATE TRIGGER orders_audit AFTER UPDATE ON orders FOR EACH ROW EXECUTE FUNCTION audit_order_change();\n");
