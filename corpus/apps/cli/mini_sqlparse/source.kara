    t.push_str("{\"op\": \"format\", \"sql\": \"select name, coalesce(price), status, price from logs inner join items on qty = null where created_at < 'new' group by u.id limit 30;\\nselect price, email, email, price from users u inner join items on name > 'paid' and id in (select id, max(o.total), sum(o.total), total, count(u.id) from items left outer join items on price < 219 where created_at like '%bob%' and o.total <= 404 order by status asc)\", \"opts\": {\"wrap_after\": 20, \"strip_comments\": true, \"compact\": true, \"indent_columns\": true}}\n");
