    t.push_str("{\"op\": \"format\", \"sql\": \"-- note 33\\ninsert into users (b, d) values (7, 'x'), (1, 'x'), (6, 'y z');\\nselect max(price) from users u;\\nselect u.id as a, qty, o.total, total, o.total from users u inner join orders o on o.total >= 'new' where email <= 307 and o.total > 'paid' limit 78\", \"opts\": {\"truncate_strings\": 2}}\n");
