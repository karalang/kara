    t.push_str("{\"op\": \"format\", \"sql\": \"select status from users u join logs on total >= 360 group by created_at\", \"opts\": {\"indent_columns\": true, \"reindent\": true, \"strip_whitespace\": true, \"keyword_case\": \"upper\"}}\n");
    t.push_str("{\"op\": \"lint\", \"dir\": \"migrations\"}\n");
    t.push_str("{\"op\": \"lint\", \"dir\": \"sqlite\"}\n");
    t.push_str("{\"op\": \"querylog\", \"file\": \"logs/django_queries.log\"}\n");
    t.push_str("{\"op\": \"tables\", \"file\": \"analytics/daily_revenue.sql\"}\n");
    t.push_str("{\"op\": \"tables\", \"file\": \"tsql/report.sql\"}\n");
    t.push_str("{\"op\": \"splitfiles\", \"file\": \"mysql/dump.sql\"}\n");
    v.push(DataFile { path: "jobs.jsonl".to_string(), hex: false, body: t });
}

