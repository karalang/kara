    t.push_str("{\"op\": \"format\", \"sql\": \"select total as a, sum(name), status from public.events e where status > null or created_at <> null or u.id >= 'paid' group by email order by name desc;\\ninsert into items (b, c) values (8, 'y z');\\n\", \"opts\": {\"truncate_strings\": 2}}\n");
