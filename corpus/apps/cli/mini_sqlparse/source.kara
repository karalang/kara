    t.push_str("{\"op\": \"format\", \"sql\": \"insert into items (d, c) values (2, 'y z'), (1, 'x'), (1, 'x');\", \"opts\": {\"indent_tabs\": true, \"indent_after_first\": true, \"use_space_around_operators\": true, \"keyword_case\": \"lower\"}}\n");
    t.push_str("{\"op\": \"format\", \"sql\": \"-- note 18\\ninsert into items (d, a) values (7, 'x');\", \"opts\": {\"keyword_case\": \"upper\", \"compact\": true, \"strip_whitespace\": true}}\n");
    t.push_str("{\"op\": \"format\", \"sql\": \"-- note 19\\nupdate orders set created_at = 8 where id <> 'paid';\", \"opts\": {\"reindent_aligned\": true, \"wrap_after\": 80}}\n");
