    let mut t = String.new();
    t.push_str("create function bump_counter(p_id int) returns void as\n");
    t.push_str("begin\n");
    t.push_str("  declare c int;\n");
    t.push_str("  for r in select id from counters loop\n");
    t.push_str("    update counters set n = n + 1 where id = r.id;\n");
    t.push_str("  end loop;\n");
    t.push_str("  if p_id > 0 then\n");
    t.push_str("    update counters set n = 0 where id = p_id;\n");
    t.push_str("  end if;\n");
    t.push_str("end;\n");
    t.push_str("select bump_counter(3);\n");
