    t.push_str("INSERT OR REPLACE INTO notes (id, body) VALUES (?, ?);\n");
    t.push_str("SELECT id, substr(body, 1, 40) || '...' AS preview FROM notes WHERE tags LIKE '%' || ? || '%' ORDER BY created DESC LIMIT 20 OFFSET 40;\n");
