== errors
1. valid '* * * * *' -> True
2. valid '* * * *' -> False
3. valid '* * * * * * * *' -> False
4. valid '' -> False
5. valid '@daily' -> True
6. valid '@DAILY' -> True
7. valid '@reboot' -> False
8. valid '60 * * * *' -> False
9. valid '* 24 * * *' -> False
10. valid '* * 32 * *' -> False
11. valid '* * 0 * *' -> False
12. valid '* * * 13 *' -> False
13. valid '* * * 0 *' -> False
