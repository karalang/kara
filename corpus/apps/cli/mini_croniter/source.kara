// mini_croniter: cron schedules as croniter 6.2.4 reads and walks them,
// the library behind many Python schedulers, task queues and job
// runners. The port covers:
// - the expression parser: 5, 6 and 7 fields, seconds first or sixth,
//   names, ranges, steps and wrap-around ranges, L for the last day, W
//   for the nearest weekday, # and L for the nth weekday, ?, the @
//   aliases, Jenkins-style H hashing from a job id, and strict checking
//   of days that never occur;
// - get_next, get_prev, get_current and all_next / all_prev, with
//   day_or, implement_cron_bug, max_years_between_matches and
//   expand_from_start_time;
// - naive, UTC, fixed-offset and zoneinfo times, with croniter's rules
//   for wall times that are skipped or repeat when the clocks change,
//   read from real TZif files (the loader is mini_zoneinfo's);
// - the float timestamps it works in, rounded as CPython rounds them;
// - match, match_range and croniter_range.
//
// The jobs in data/jobs.jsonl are written by hand and drawn at random
// from a fixed seed. expected.out is the output of oracle.py, which runs
// them through croniter itself.

// ------------------------------------------------------------ text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// \w on ASCII.
fn is_word(c: u8) -> bool {
    is_alnum(c) or c == b'_'
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

// str.partition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Whether s is \d+ (ASCII digits).
fn all_digits_str(s: Str) -> bool {
    let b = to_bytes(s);
    if b.len() == 0 {
        return false;
    }
    for c in b.iter() {
        if not is_digit(*c) {
            return false;
        }
    }
    true
}

// int() of a string of digits.
fn digits_int(s: Str) -> i64 {
    let mut n: i64 = 0;
    for c in to_bytes(s).iter() {
        n = n * 10 + (*c - b'0') as i64;
    }
    n
}

// str.lower on ASCII.
fn lower(s: Str) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in to_bytes(s).iter() {
        out.push(if *c >= b'A' and *c <= b'Z' { *c + 32 } else { *c });
    }
    from_bytes(out)
}

// White space as str.split sees it, on ASCII.
fn is_split_ws(c: u8) -> bool {
    c == b' ' or (c >= 9 and c <= 13) or (c >= 28 and c <= 31)
}

// str.split() with no separator.
fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_split_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_split_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

// str.split(",").
fn split_commas(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == b',' {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// repr() of an ASCII str.
fn str_repr(s: Str) -> String {
    let b = to_bytes(s);
    let q = if find_byte(s, b'\'') >= 0 and find_byte(s, b'"') < 0 { b'"' } else { b'\'' };
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    for c in b.iter() {
        let x = *c;
        if x == b'\\' or x == q {
            out.push(b'\\');
            out.push(x);
        } else if x == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if x == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if x == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if x < 32 or x == 127 {
            let h = "0123456789abcdef".bytes().to_vec();
            out.push(b'\\');
            out.push(b'x');
            out.push(h[(x / 16) as i64]);
            out.push(h[(x % 16) as i64]);
        } else {
            out.push(x);
        }
    }
    out.push(q);
    from_bytes(out)
}

// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, arrays and objects.
#[derive(Clone)]
enum J {
    S(String),
    N(i128),
    F(f64),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else if c >= 'a' and c <= 'f' {
                (c as u32) - ('a' as u32) + 10
            } else {
                (c as u32) - ('A' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let mut neg = false;
            if c == '-' {
                neg = true;
                self.pos += 1;
            }
            let mut n: i128 = 0;
            let mut frac: i64 = -1;
            while self.pos < self.cs.len() and ((self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9') or self.cs[self.pos] == '.') {
                if self.cs[self.pos] == '.' {
                    frac = 0;
                } else {
                    n = n * 10 + ((self.cs[self.pos] as u32) - ('0' as u32)) as i128;
                    if frac >= 0 {
                        frac += 1;
                    }
                }
                self.pos += 1;
            }
            if frac >= 0 {
                // The data's floats have at most 16 digits, so the digits
                // and the power of ten are both exact and the one division
                // rounds correctly.
                let mut p: f64 = 1.0;
                for _ in 0..frac {
                    p *= 10.0;
                }
                let x = (n as f64) / p;
                return Ok(J.F(if neg { -x } else { x }));
            }
            return Ok(J.N(if neg { -n } else { n }));
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value()
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_has(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.Null => false,
        _ => true,
    }
}

fn j_str(j: ref J, key: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn j_int(j: ref J, key: Str, default: i128) -> i128 {
    match j_get(j, key) {
        J.N(n) => n,
        _ => default,
    }
}

// Whether the object has the member at all, null or not.
fn j_present(j: ref J, key: Str) -> bool {
    if let J.O(members) = j {
        for (k, _) in members.iter() {
            if k == key {
                return true;
            }
        }
    }
    false
}

fn j_bool(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}


// ------------------------------------------------------------ calendar

// Division and remainder rounding down, as Python's // and %.
fn fdiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn fmod(a: i64, b: i64) -> i64 {
    a - fdiv(a, b) * b
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if is_leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

// Days from 1970-01-01 to a date.
fn days_from_civil(year: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { year - 1 } else { year };
    let era = (if y >= 0 { y } else { y - 399 }) / 400;
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// The date of a day number: (year, month, day).
fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400;
    (if m <= 2 { y + 1 } else { y }, m, d)
}

// Monday is 0, as datetime.weekday has it.
fn weekday(days: i64) -> i64 {
    fmod(days + 3, 7)
}

fn year_of(ts: i64) -> i64 {
    let (y, _, _) = civil_from_days(fdiv(ts, 86400));
    y
}

fn pad2(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn pad4(n: i64) -> String {
    if n < 10 {
        f"000{n}"
    } else if n < 100 {
        f"00{n}"
    } else if n < 1000 {
        f"0{n}"
    } else {
        f"{n}"
    }
}

fn pad6(n: i64) -> String {
    let mut s = f"{n}";
    while s.len() < 6 {
        s = f"0{s}";
    }
    s
}

// ------------------------------------------------------------ wall clocks

const US: i64 = 1000000;
const MINUTE_US: i64 = 60000000;
const DAY_US: i64 = 86400000000;

// A naive datetime's fields.
#[derive(Clone)]
struct F {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
}

// Microseconds from 1970-01-01 00:00 to a wall time, and back.
fn us_of(f: ref F) -> i64 {
    ((days_from_civil(f.y, f.mo, f.d) * 24 + f.h) * 60 + f.mi) * 60 * US + f.s * US + f.us
}

fn fields(t: i64) -> F {
    let days = fdiv(t, DAY_US);
    let rest = t - days * DAY_US;
    let (y, mo, d) = civil_from_days(days);
    let secs = rest / US;
    F { y: y, mo: mo, d: d, h: secs / 3600, mi: secs / 60 % 60, s: secs % 60, us: rest % US }
}

// datetime.isoweekday() % 7: Sunday is 0.
fn cron_dow(f: ref F) -> i64 {
    fmod(weekday(days_from_civil(f.y, f.mo, f.d)) + 1, 7)
}

fn plus_days(f: ref F, n: i64) -> F {
    fields(us_of(f) + n * DAY_US)
}

// The relativedelta(months=n) step: the day is clipped to the month.
fn plus_months(f: ref F, n: i64) -> F {
    let total = f.y * 12 + f.mo - 1 + n;
    let mut g = f.clone();
    g.y = fdiv(total, 12);
    g.mo = fmod(total, 12) + 1;
    let dim = days_in_month(g.y, g.mo);
    if g.d > dim {
        g.d = dim;
    }
    g
}

fn set_time(f: ref F, h: i64, mi: i64, s: i64) -> F {
    let mut g = f.clone();
    g.h = h;
    g.mi = mi;
    g.s = s;
    g
}

fn wall_str(t: i64) -> String {
    let f = fields(t);
    let base = f"{pad4(f.y)}-{pad2(f.mo)}-{pad2(f.d)} {pad2(f.h)}:{pad2(f.mi)}:{pad2(f.s)}";
    if f.us != 0 { f"{base}.{pad6(f.us)}" } else { base }
}

// A UTC offset the way isoformat writes it.
fn off_str(secs: i64) -> String {
    let sign = if secs < 0 { "-" } else { "+" };
    let s = if secs < 0 { -secs } else { secs };
    let sec = s % 60;
    let tail = if sec != 0 { f":{pad2(sec)}" } else { String.new() };
    f"{sign}{pad2(s / 3600)}:{pad2(s / 60 % 60)}{tail}"
}

// ------------------------------------------------------------ float timestamps

// CPython's _PyTime_RoundHalfEven.
fn round_half_even(x: f64) -> f64 {
    let r = x.round();
    let diff = x - r;
    if diff == 0.5 or diff == -0.5 {
        return 2.0 * (x / 2.0).round();
    }
    r
}

// datetime.fromtimestamp(t, tzutc()).replace(tzinfo=None), as microseconds
// of naive UTC: _PyTime_ObjectToTimeval splits t with modf and rounds the
// fraction half to even.
fn from_timestamp(t: f64) -> i64 {
    let mut ip = t.trunc();
    let mut fp = round_half_even((t - ip) * 1000000.0);
    if fp >= 1000000.0 {
        fp -= 1000000.0;
        ip += 1.0;
    } else if fp < 0.0 {
        fp += 1000000.0;
        ip -= 1.0;
    }
    (ip as i64) * US + (fp as i64)
}

// timedelta.total_seconds() of a span in microseconds.
fn total_seconds(us: i64) -> f64 {
    (us as f64) / 1000000.0
}

// ------------------------------------------------------------ the TZif file (from mini_zoneinfo)

struct Reader {
    b: Vec[u8],
    at: i64,
}

impl Reader {
    fn take(mut ref self, n: i64) -> Result[Vec[u8], String] {
        if self.at + n > self.b.len() {
            return Err("Invalid TZif file: truncated".to_string());
        }
        let mut out: Vec[u8] = Vec.new();
        for i in self.at..self.at + n {
            out.push(self.b[i]);
        }
        self.at += n;
        Ok(out)
    }

    fn skip(mut ref self, n: i64) {
        self.at += n;
    }

    fn int(mut ref self, n: i64) -> Result[i64, String] {
        let v = self.take(n)?;
        let mut x: i64 = 0;
        for i in 0..n {
            x = (x << 8) | (v[i] as i64);
        }
        // sign-extend
        if n < 8 and v[0] >= 0x80 {
            x -= 1 << (8 * n);
        }
        Ok(x)
    }

    fn byte(mut ref self) -> Result[i64, String] {
        let v = self.take(1)?;
        Ok(v[0] as i64)
    }

    fn signed_byte(mut ref self) -> Result[i64, String] {
        let v = self.byte()?;
        Ok(if v >= 128 { v - 256 } else { v })
    }
}

struct Header {
    version: i64,
    isutcnt: i64,
    isstdcnt: i64,
    leapcnt: i64,
    timecnt: i64,
    typecnt: i64,
    charcnt: i64,
}

fn read_header(r: mut ref Reader) -> Result[Header, String] {
    if from_bytes(r.take(4)?) != "TZif" {
        return Err("Invalid TZif file: magic not found".to_string());
    }
    let v = r.byte()?;
    let version = if v == 0 { 1 } else { v - 48 };
    r.skip(15);
    Ok(Header {
        version: version,
        isutcnt: r.int(4)?,
        isstdcnt: r.int(4)?,
        leapcnt: r.int(4)?,
        timecnt: r.int(4)?,
        typecnt: r.int(4)?,
        charcnt: r.int(4)?,
    })
}

// What _common.load_data reads from a file.
struct Raw {
    version: i64,
    trans_idx: Vec[i64],
    trans_utc: Vec[i64],
    utcoff: Vec[i64],
    isdst: Vec[i64],
    abbr: Vec[String],
    tz_str: Option[String],
}

fn load_data(bytes: own Vec[u8]) -> Result[Raw, String] {
    let mut r = Reader { b: bytes, at: 0 };
    let mut h = read_header(mut r)?;
    let version = h.version;
    let mut time_size: i64 = 4;
    if h.version > 1 {
        // skip the version 1 data, then read the second header
        time_size = 8;
        r.skip(h.timecnt * 5 + h.typecnt * 6 + h.charcnt + h.leapcnt * 8 + h.isstdcnt + h.isutcnt);
        h = read_header(mut r)?;
    }
    let mut trans_utc: Vec[i64] = Vec.new();
    let mut trans_idx: Vec[i64] = Vec.new();
    for _ in 0..h.timecnt {
        trans_utc.push(r.int(time_size)?);
    }
    let mut most: i64 = -1;
    for _ in 0..h.timecnt {
        let i = r.byte()?;
        if i > most {
            most = i;
        }
        trans_idx.push(i);
    }
    if h.timecnt > 0 and most >= h.typecnt {
        return Err(f"Invalid transition index found while reading TZif: {most}");
    }
    let mut utcoff: Vec[i64] = Vec.new();
    let mut isdst: Vec[i64] = Vec.new();
    let mut abbrind: Vec[i64] = Vec.new();
    for _ in 0..h.typecnt {
        utcoff.push(r.int(4)?);
        isdst.push(r.signed_byte()?);
        abbrind.push(r.signed_byte()?);
    }
    let chars = r.take(h.charcnt)?;
    let mut abbr: Vec[String] = Vec.new();
    for i in 0..abbrind.len() {
        let st = abbrind[i];
        let mut e = st;
        while e < chars.len() and chars[e] != 0 {
            e += 1;
        }
        abbr.push(byte_str(chars, st, e));
    }
    let mut tz_str: Option[String] = None;
    if version >= 2 {
        r.skip(h.isutcnt + h.isstdcnt + h.leapcnt * 12);
        let nl = r.byte()?;
        if nl != 10 {
            return Err("Invalid TZif file: no newline before the footer".to_string());
        }
        let mut line: Vec[u8] = Vec.new();
        let mut ended = false;
        while r.at < r.b.len() {
            let c = r.byte()?;
            if c == 10 {
                ended = true;
                break;
            }
            line.push(c as u8);
        }
        if not ended {
            return Err("Invalid TZif file: unexpected end of file".to_string());
        }
        tz_str = Some(from_bytes(line));
    }
    Ok(Raw { version: version, trans_idx: trans_idx, trans_utc: trans_utc, utcoff: utcoff, isdst: isdst, abbr: abbr, tz_str: tz_str })
}

// ------------------------------------------------------------ TZ strings

// A _ttinfo: the offset, the DST part of it, and the name.
#[derive(Clone)]
struct Tti {
    utcoff: i64,
    dstoff: i64,
    tzname: String,
}

fn tti_eq(a: ref Tti, b: ref Tti) -> bool {
    a.utcoff == b.utcoff and a.dstoff == b.dstoff and a.tzname == b.tzname
}

// A transition day: Mm.w.d when `cal`, otherwise Jn or n.
#[derive(Clone)]
struct DayRule {
    cal: bool,
    m: i64,
    w: i64,
    d: i64,
    julian: bool,
    secs: i64,
}

// The rule after the last transition: either a fixed _ttinfo or a
// _TZStr with its two _ttinfos and its start and end.
#[derive(Clone)]
struct After {
    is_rule: bool,
    std: Tti,
    dst: Tti,
    start: DayRule,
    end: DayRule,
    dst_diff: i64,
}

fn fixed_after(t: own Tti) -> After {
    let r = DayRule { cal: false, m: 0, w: 0, d: 0, julian: false, secs: 0 };
    After { is_rule: false, std: t.clone(), dst: t, start: r.clone(), end: r, dst_diff: 0 }
}

fn days_before_year(year: i64) -> i64 {
    let y = year - 1;
    y * 365 + fdiv(y, 4) - fdiv(y, 100) + fdiv(y, 400) - 719163
}

const DAYS_BEFORE_MONTH: Array[i64, 13] = [-1, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];

fn year_to_epoch(r: ref DayRule, year: i64) -> i64 {
    if not r.cal {
        let mut d = r.d;
        if r.julian and d >= 59 and is_leap(year) {
            d += 1;
        }
        return (days_before_year(year) + d) * 86400 + r.secs;
    }
    // calendar.monthrange counts Monday as 0; POSIX counts Sunday as 0
    let first_day = weekday(days_from_civil(year, r.m, 1));
    let mut month_day = fmod(r.d - (first_day + 1), 7) + 1;
    month_day += (r.w - 1) * 7;
    if month_day > days_in_month(year, r.m) {
        month_day -= 7;
    }
    let leap: i64 = if r.m > 2 and is_leap(year) { 1 } else { 0 };
    let ordinal = days_before_year(year) + DAYS_BEFORE_MONTH[r.m] + leap + month_day;
    ordinal * 86400 + r.secs
}

fn all_digits(b: ref Vec[u8], from: i64, to: i64) -> bool {
    if to <= from {
        return false;
    }
    for i in from..to {
        if not is_digit(b[i]) {
            return false;
        }
    }
    true
}

fn digits_val(b: ref Vec[u8], from: i64, to: i64) -> i64 {
    let mut n: i64 = 0;
    for i in from..to {
        n = n * 10 + (b[i] - b'0') as i64;
    }
    n
}

// [+-]?\d{1,3}(:\d{2}(:\d{2})?)? at b[i..], as many bytes as it takes:
// (end, sign, h, m, s), or end = -1 when nothing matches.
fn scan_hms(b: ref Vec[u8], i0: i64) -> (i64, i64, i64, i64, i64) {
    let mut i = i0;
    let mut sign: i64 = 0;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        sign = if b[i] == b'-' { -1 } else { 1 };
        i += 1;
    }
    let st = i;
    while i < b.len() and is_digit(b[i]) and i - st < 3 {
        i += 1;
    }
    if i == st {
        return (-1, 0, 0, 0, 0);
    }
    let h = digits_val(b, st, i);
    let mut m: i64 = 0;
    let mut s: i64 = 0;
    if i + 3 <= b.len() and b[i] == b':' and all_digits(b, i + 1, i + 3) {
        m = digits_val(b, i + 1, i + 3);
        i += 3;
        if i + 3 <= b.len() and b[i] == b':' and all_digits(b, i + 1, i + 3) {
            s = digits_val(b, i + 1, i + 3);
            i += 3;
        }
    }
    (i, sign, h, m, s)
}

fn min_i(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

// [a-zA-Z]+ or <[a-zA-Z0-9+-]+> at b[i..]: the end, or -1.
fn scan_abbr(b: ref Vec[u8], i0: i64) -> i64 {
    let mut i = i0;
    if i < b.len() and b[i] == b'<' {
        i += 1;
        let st = i;
        while i < b.len() and (is_alnum(b[i]) or b[i] == b'+' or b[i] == b'-') {
            i += 1;
        }
        if i == st or i >= b.len() or b[i] != b'>' {
            return -1;
        }
        return i + 1;
    }
    while i < b.len() and is_alpha(b[i]) {
        i += 1;
    }
    if i == i0 { -1 } else { i }
}

fn strip_angles(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and (b[i] == b'<' or b[i] == b'>') {
        i += 1;
    }
    while j > i and (b[j - 1] == b'<' or b[j - 1] == b'>') {
        j -= 1;
    }
    byte_str(b, i, j)
}

// _parse_tz_delta: hours west become seconds east.
fn tz_delta(sign: i64, h: i64, m: i64, s: i64) -> Result[i64, String] {
    if h > 24 {
        return Err("hours".to_string());
    }
    let total = h * 3600 + m * 60 + s;
    Ok(if sign != -1 { -total } else { total })
}

fn parse_time(s: Str) -> Result[i64, String] {
    let b = to_bytes(s);
    let (e, sign, h, m, sec) = scan_hms(b, 0);
    if e != b.len() {
        return Err(f"Invalid time: {s}");
    }
    if h > 167 {
        return Err(f"Hour must be in [0, 167]: {s}");
    }
    let t = h * 3600 + m * 60 + sec;
    Ok(if sign == -1 { -t } else { t })
}

fn parse_day_rule(s: Str) -> Result[DayRule, String] {
    let (date, has_time, time) = partition(s, b'/');
    let b = to_bytes(date);
    let mut r = DayRule { cal: false, m: 0, w: 0, d: 0, julian: false, secs: 7200 };
    if first_byte(date) == b'M' {
        // M(\d{1,2})\.(\d)\.(\d)
        let mut i: i64 = 1;
        while i < b.len() and is_digit(b[i]) {
            i += 1;
        }
        if i == 1 or i > 3 or i + 4 != b.len() or b[i] != b'.' or not is_digit(b[i + 1]) or b[i + 2] != b'.' or not is_digit(b[i + 3]) {
            return Err(f"Invalid dst start/end date: {s}");
        }
        r.cal = true;
        r.m = digits_val(b, 1, i);
        r.w = (b[i + 1] - b'0') as i64;
        r.d = (b[i + 3] - b'0') as i64;
        if r.m < 1 or r.m > 12 {
            return Err("m must be in [1, 12]".to_string());
        }
        if r.w < 1 or r.w > 5 {
            return Err("w must be in [1, 5]".to_string());
        }
        if r.d < 0 or r.d > 6 {
            return Err("d must be in [0, 6]".to_string());
        }
    } else {
        let mut st: i64 = 0;
        if first_byte(date) == b'J' {
            r.julian = true;
            st = 1;
        }
        if b.len() - st > 3 or not all_digits(b, st, b.len()) {
            return Err(f"Invalid dst start/end date: {s}");
        }
        r.d = digits_val(b, st, b.len());
        let min_day: i64 = if r.julian { 1 } else { 0 };
        if r.d < min_day or r.d > 365 {
            return Err(f"d must be in [{min_day}, 365], not: {r.d}");
        }
    }
    if has_time {
        r.secs = parse_time(time)?;
    }
    Ok(r)
}

// _parse_tz_str
fn parse_tz_str(s: Str) -> Result[After, String] {
    let (offset_str, has_rules, rules) = partition(s, b',');
    let b = to_bytes(offset_str);
    let bad = f"{s} is not a valid TZ string";
    let e1 = scan_abbr(b, 0);
    if e1 < 0 {
        return Err(bad);
    }
    let std_abbr = strip_angles(byte_str(b, 0, e1));
    let mut std_off: i64 = 0;
    let mut has_std_off = false;
    let mut dst_abbr = String.new();
    let mut has_dst = false;
    let mut dst_off: i64 = 0;
    let mut has_dst_off = false;
    let mut std_hms: (i64, i64, i64, i64) = (0, 0, 0, 0);
    let mut dst_hms: (i64, i64, i64, i64) = (0, 0, 0, 0);
    let mut i = e1;
    if i < b.len() {
        let (e2, sg, h, m, sec) = scan_hms(b, i);
        if e2 < 0 {
            return Err(bad);
        }
        has_std_off = true;
        std_hms = (sg, h, m, sec);
        i = e2;
        if i < b.len() {
            let e3 = scan_abbr(b, i);
            if e3 < 0 {
                return Err(bad);
            }
            dst_abbr = strip_angles(byte_str(b, i, e3));
            has_dst = true;
            i = e3;
            if i < b.len() {
                let (e4, sg2, h2, m2, sec2) = scan_hms(b, i);
                if e4 != b.len() {
                    return Err(bad);
                }
                has_dst_off = true;
                dst_hms = (sg2, h2, m2, sec2);
            }
        }
    }
    // the whole string matched; now the offsets' values
    if not has_std_off {
        return Err(f"Invalid STD offset in {s}");
    }
    let (sg, h, m, sec) = std_hms;
    std_off = match tz_delta(sg, h, m, sec) {
        Ok(v) => v,
        Err(_) => return Err(f"Invalid STD offset in {s}"),
    };
    if has_dst {
        if has_dst_off {
            let (sg2, h2, m2, sec2) = dst_hms;
            dst_off = match tz_delta(sg2, h2, m2, sec2) {
                Ok(v) => v,
                Err(_) => return Err(f"Invalid DST offset in {s}"),
            };
        } else {
            dst_off = std_off + 3600;
        }
        if not has_rules {
            return Err(f"Missing transition rules: {s}");
        }
        let (a, two, c) = partition(rules, b',');
        if not two {
            return Err(f"Invalid TZ string: {s}");
        }
        let start = match parse_day_rule(a) {
            Ok(r) => r,
            Err(_) => return Err(f"Invalid TZ string: {s}"),
        };
        let end = match parse_day_rule(c) {
            Ok(r) => r,
            Err(_) => return Err(f"Invalid TZ string: {s}"),
        };
        let diff = dst_off - std_off;
        return Ok(After {
            is_rule: true,
            std: Tti { utcoff: std_off, dstoff: 0, tzname: std_abbr },
            dst: Tti { utcoff: dst_off, dstoff: diff, tzname: dst_abbr },
            start: start,
            end: end,
            dst_diff: diff,
        });
    }
    if has_rules {
        return Err(f"Transition rule present without DST: {s}");
    }
    Ok(fixed_after(Tti { utcoff: std_off, dstoff: 0, tzname: std_abbr }))
}

fn transitions(a: ref After, year: i64) -> (i64, i64) {
    (year_to_epoch(a.start, year), year_to_epoch(a.end, year))
}

fn rule_info(a: ref After, ts: i64, year: i64, fold: i64) -> Tti {
    let (s0, e0) = transitions(a, year);
    let mut start = s0;
    let mut end = e0;
    if (fold == 1) == (a.dst_diff >= 0) {
        end -= a.dst_diff;
    } else {
        start += a.dst_diff;
    }
    let isdst = if start < end { start <= ts and ts < end } else { not (end <= ts and ts < start) };
    if isdst { a.dst.clone() } else { a.std.clone() }
}

fn rule_info_fromutc(a: ref After, ts: i64, year: i64) -> (Tti, bool) {
    let (s0, e0) = transitions(a, year);
    let start = s0 - a.std.utcoff;
    let end = e0 - a.dst.utcoff;
    let isdst = if start < end { start <= ts and ts < end } else { not (end <= ts and ts < start) };
    let (lo, hi) = if a.dst_diff > 0 { (end, end + a.dst_diff) } else { (start, start - a.dst_diff) };
    let fold = lo <= ts and ts < hi;
    (if isdst { a.dst.clone() } else { a.std.clone() }, fold)
}

// ------------------------------------------------------------ the zone

#[derive(Clone)]
struct Zone {
    key: String,
    trans_utc: Vec[i64],
    // the transitions in local time, for fold 0 and for fold 1
    local0: Vec[i64],
    local1: Vec[i64],
    // the _ttinfo each transition starts
    ttinfos: Vec[Tti],
    before: Option[Tti],
    after: After,
}

// ZoneInfo._utcoff_to_dstoff
fn utcoff_to_dstoff(trans_idx: ref Vec[i64], utcoffsets: ref Vec[i64], isdsts: ref Vec[i64]) -> Vec[i64] {
    let typecnt = isdsts.len();
    let mut dstoffs: Vec[i64] = Vec.new();
    let mut dst_cnt: i64 = 0;
    for i in 0..typecnt {
        dstoffs.push(0);
        if isdsts[i] != 0 {
            dst_cnt += 1;
        }
    }
    let mut dst_found: i64 = 0;
    let mut broke = false;
    for i in 1..trans_idx.len() {
        if dst_cnt == dst_found {
            broke = true;
            break;
        }
        let idx = trans_idx[i];
        if isdsts[idx] == 0 {
            continue;
        }
        if dstoffs[idx] != 0 {
            continue;
        }
        let mut dstoff: i64 = 0;
        let utcoff = utcoffsets[idx];
        let mut comp_idx = trans_idx[i - 1];
        if isdsts[comp_idx] == 0 {
            dstoff = utcoff - utcoffsets[comp_idx];
        }
        if dstoff == 0 and idx < typecnt - 1 and i + 1 < trans_idx.len() {
            comp_idx = trans_idx[i + 1];
            if isdsts[comp_idx] != 0 {
                continue;
            }
            dstoff = utcoff - utcoffsets[comp_idx];
        }
        if dstoff != 0 {
            dst_found += 1;
            dstoffs[idx] = dstoff;
        }
    }
    if not broke {
        // a DST type with no offset found gets one hour
        for idx in 0..typecnt {
            if dstoffs[idx] == 0 and isdsts[idx] != 0 {
                dstoffs[idx] = 3600;
            }
        }
    }
    dstoffs
}

// ZoneInfo._ts_to_local: the larger offset for fold 0, the smaller for 1.
fn ts_to_local(trans_idx: ref Vec[i64], trans_utc: ref Vec[i64], utcoffsets: ref Vec[i64], fold: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if trans_utc.len() == 0 {
        return out;
    }
    for i in 0..trans_idx.len() {
        let mut a: i64 = 0;
        let mut b: i64 = 0;
        if i == 0 {
            if utcoffsets.len() > 1 {
                a = utcoffsets[0];
                b = utcoffsets[trans_idx[0]];
            } else {
                a = utcoffsets[0];
                b = utcoffsets[0];
            }
        } else {
            a = utcoffsets[trans_idx[i - 1]];
            b = utcoffsets[trans_idx[i]];
        }
        let hi = if a > b { a } else { b };
        let lo = if a > b { b } else { a };
        out.push(trans_utc[i] + if fold == 0 { hi } else { lo });
    }
    out
}

fn load_zone(key: Str, raw: ref Raw) -> Result[Zone, String] {
    let dstoff = utcoff_to_dstoff(raw.trans_idx, raw.utcoff, raw.isdst);
    let mut list: Vec[Tti] = Vec.new();
    for i in 0..raw.utcoff.len() {
        list.push(Tti { utcoff: raw.utcoff[i], dstoff: dstoff[i], tzname: raw.abbr[i].clone() });
    }
    let mut ttinfos: Vec[Tti] = Vec.new();
    for i in 0..raw.trans_idx.len() {
        ttinfos.push(list[raw.trans_idx[i]].clone());
    }
    // the first standard-time type
    let mut before: Option[Tti] = None;
    for i in 0..raw.isdst.len() {
        if raw.isdst[i] == 0 {
            before = Some(list[i].clone());
            break;
        }
    }
    if before.is_none() and ttinfos.len() > 0 {
        before = Some(ttinfos[0].clone());
    }
    let footer = raw.tz_str.clone().unwrap_or(String.new());
    let after = if footer.len() > 0 {
        parse_tz_str(footer)?
    } else {
        if ttinfos.len() == 0 and list.len() == 0 {
            return Err("No time zone information found.".to_string());
        }
        if ttinfos.len() > 0 {
            fixed_after(ttinfos[ttinfos.len() - 1].clone())
        } else {
            fixed_after(list[list.len() - 1].clone())
        }
    };
    Ok(Zone {
        key: key.to_string(),
        trans_utc: raw.trans_utc.clone(),
        local0: ts_to_local(raw.trans_idx, raw.trans_utc, raw.utcoff, 0),
        local1: ts_to_local(raw.trans_idx, raw.trans_utc, raw.utcoff, 1),
        ttinfos: ttinfos,
        before: before,
        after: after,
    })
}

// bisect.bisect_right
fn bisect_right(v: ref Vec[i64], x: i64) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if x < v[mid] {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn before_tti(z: ref Zone) -> Tti {
    match z.before.clone() {
        Some(t) => t,
        None => Tti { utcoff: 0, dstoff: 0, tzname: String.new() },
    }
}

// ZoneInfo._find_trans: the _ttinfo in force at a local time.
fn find_trans(z: ref Zone, ts: i64, fold: i64) -> Tti {
    let n = z.local0.len();
    let first = if n > 0 { if fold == 0 { z.local0[0] } else { z.local1[0] } } else { 0 };
    let last = if n > 0 { if fold == 0 { z.local0[n - 1] } else { z.local1[n - 1] } } else { 0 };
    if n > 0 and ts < first {
        return before_tti(z);
    }
    if n == 0 or ts > last {
        if z.after.is_rule {
            return rule_info(z.after, ts, year_of(ts), fold);
        }
        return z.after.std.clone();
    }
    let idx = if fold == 0 { bisect_right(z.local0, ts) } else { bisect_right(z.local1, ts) } - 1;
    z.ttinfos[idx].clone()
}

// ZoneInfo.fromutc: the _ttinfo in force at a UTC time, and the fold of
// the local time it gives.
fn from_utc(z: ref Zone, ts: i64) -> (Tti, bool) {
    let n = z.trans_utc.len();
    if n >= 1 and ts < z.trans_utc[0] {
        return (before_tti(z), false);
    }
    if (n == 0 or ts > z.trans_utc[n - 1]) and z.after.is_rule {
        return rule_info_fromutc(z.after, ts, year_of(ts));
    }
    if n == 0 {
        return (z.after.std.clone(), false);
    }
    let idx = bisect_right(z.trans_utc, ts);
    let mut prev = before_tti(z);
    let mut tti = z.ttinfos[0].clone();
    if n > 1 and ts >= z.trans_utc[1] {
        prev = z.ttinfos[idx - 2].clone();
        tti = z.ttinfos[idx - 1].clone();
    } else if ts > z.trans_utc[n - 1] {
        prev = z.ttinfos[n - 1].clone();
        tti = z.after.std.clone();
    }
    let shift = prev.utcoff - tti.utcoff;
    let fold = shift > ts - z.trans_utc[idx - 1];
    (tti, fold)
}

// ------------------------------------------------------------ the files


// ------------------------------------------------------------ tzinfo

enum Tz {
    Utc,
    Fixed(i64),
    Zone(Zone),
}

// The time zones a run has made, each made once: two datetimes with the
// same index share one tzinfo object, which is what Python's comparison
// and subtraction look at.
struct Zones {
    names: Vec[String],
    list: Vec[Tz],
}

// A datetime: the wall clock in microseconds, its fold, and the index of
// its tzinfo in Zones (-1 when it is naive).
#[derive(Clone)]
struct Dt {
    us: i64,
    fold: i64,
    tz: i64,
}

fn naive(us: i64) -> Dt {
    Dt { us: us, fold: 0, tz: -1 }
}

fn tz_index(zs: mut ref Zones, spec: ref String) -> Result[i64, String] {
    for i in 0..zs.names.len() {
        if zs.names[i] == *spec {
            return Ok(i);
        }
    }
    let b = to_bytes(spec);
    let tz = if *spec == "UTC" {
        Tz.Utc
    } else if b[0] == b'+' or b[0] == b'-' {
        let (h, _, m) = partition(slice_from(spec, 1), b':');
        let secs = digits_int(h) * 3600 + digits_int(m) * 60;
        Tz.Fixed(if b[0] == b'-' { -secs } else { secs })
    } else {
        let mut file: Vec[u8] = Vec.new();
        for c in b.iter() {
            file.push(if *c == b'/' { b'_' } else { *c });
        }
        let path = f"data/zones/{from_bytes(file)}";
        let bytes = match fs.read_bytes(path.clone()) {
            Ok(v) => v,
            Err(e) => return Err(f"cannot read {path}: {e}"),
        };
        let raw = load_data(bytes)?;
        Tz.Zone(load_zone(spec, raw)?)
    };
    zs.names.push(spec.clone());
    zs.list.push(tz);
    Ok(zs.names.len() - 1)
}

// dt.utcoffset() in seconds, for an aware datetime.
fn utcoffset(zs: ref Zones, t: ref Dt) -> i64 {
    match zs.list[t.tz] {
        Tz.Utc => 0,
        Tz.Fixed(s) => s,
        Tz.Zone(z) => find_trans(z, fdiv(t.us, US), t.fold).utcoff,
    }
}

// The UTC instant of an aware datetime, in microseconds.
fn instant(zs: ref Zones, t: ref Dt) -> i64 {
    t.us - utcoffset(zs, t) * US
}

// The UTC instant u as a wall time in zone tz: tz.fromutc.
fn from_utc_us(zs: ref Zones, tz: i64, u: i64) -> Dt {
    match zs.list[tz] {
        Tz.Utc => Dt { us: u, fold: 0, tz: tz },
        Tz.Fixed(s) => Dt { us: u + s * US, fold: 0, tz: tz },
        Tz.Zone(z) => {
            let (tti, fold) = from_utc(z, fdiv(u, US));
            Dt { us: u + tti.utcoff * US, fold: if fold { 1 } else { 0 }, tz: tz }
        }
    }
}

// dateutil.tz.datetime_exists: whether the wall time survives a round
// trip through UTC.
fn exists(zs: ref Zones, t: ref Dt) -> bool {
    from_utc_us(zs, t.tz, instant(zs, t)).us == t.us
}

fn dt_str(zs: ref Zones, t: ref Dt) -> String {
    if t.tz < 0 {
        return wall_str(t.us);
    }
    f"{wall_str(t.us)}{off_str(utcoffset(zs, t))}"
}

// a < b, a == b or a > b as -1, 0 or 1, as datetime compares them: by the
// wall clock when they share a tzinfo, otherwise in UTC.
fn compare(zs: ref Zones, a: ref Dt, b: ref Dt) -> Result[i64, Exc] {
    let (x, y) = if a.tz == b.tz {
        (a.us, b.us)
    } else if a.tz < 0 or b.tz < 0 {
        return Err(exc("TypeError", "can't compare offset-naive and offset-aware datetimes"));
    } else {
        (instant(zs, a), instant(zs, b))
    };
    Ok(if x < y { -1 } else if x > y { 1 } else { 0 })
}

// a - b in microseconds.
fn subtract(zs: ref Zones, a: ref Dt, b: ref Dt) -> Result[i64, Exc] {
    if a.tz == b.tz {
        return Ok(a.us - b.us);
    }
    if a.tz < 0 or b.tz < 0 {
        return Err(exc("TypeError", "can't subtract offset-naive and offset-aware datetimes"));
    }
    Ok(instant(zs, a) - instant(zs, b))
}

// dt + timedelta: the fold goes back to 0.
fn plus_us(t: ref Dt, n: i64) -> Dt {
    Dt { us: t.us + n, fold: 0, tz: t.tz }
}

// croniter's datetime_to_timestamp.
fn dt_to_ts(zs: ref Zones, t: ref Dt) -> f64 {
    let u = if t.tz < 0 { t.us } else { instant(zs, t) };
    total_seconds(u)
}

// croniter.timestamp_to_datetime with the croniter's tzinfo.
fn ts_to_dt(zs: ref Zones, ts: f64, tz: i64) -> Dt {
    let u = from_timestamp(ts);
    if tz < 0 {
        return naive(u);
    }
    from_utc_us(zs, tz, u)
}

// _is_successor: whether a comes after b (before it, going back).
fn is_successor(zs: ref Zones, a: ref Dt, b: ref Dt, is_prev: bool) -> bool {
    if is_prev {
        return instant(zs, a) < instant(zs, b);
    }
    instant(zs, a) > instant(zs, b)
}

// ------------------------------------------------------------ errors

// An exception: its class name and its message.
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: Str) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.to_string() }
}

fn bad_cron(msg: Str) -> Exc {
    exc("CroniterBadCronError", msg)
}

fn exc_str(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

// Every class here but TypeError and ValueError is a CroniterError.
fn is_croniter_error(e: ref Exc) -> bool {
    e.kind.starts_with("Croniter")
}

// ------------------------------------------------------------ fields

const MINUTE_FIELD: i64 = 0;
const HOUR_FIELD: i64 = 1;
const DAY_FIELD: i64 = 2;
const MONTH_FIELD: i64 = 3;
const DOW_FIELD: i64 = 4;
const SECOND_FIELD: i64 = 5;
const YEAR_FIELD: i64 = 6;

const RANGE_LO: Array[i64, 7] = [0, 0, 1, 1, 0, 0, 1970];
const RANGE_HI: Array[i64, 7] = [59, 23, 31, 12, 6, 59, 2099];
const LEN_MEANS_ALL: Array[i64, 7] = [60, 24, 31, 12, 7, 60, 130];

// One value of an expanded field: a number, '*' or 'l'.
#[derive(Clone)]
enum It {
    N(i64),
    Star,
    L,
}

fn it_eq(a: ref It, b: ref It) -> bool {
    sort_key(a) == sort_key(b)
}

fn has_it(v: ref Vec[It], x: ref It) -> bool {
    for y in v.iter() {
        if it_eq(y, x) {
            return true;
        }
    }
    false
}

fn has_i64(v: ref Vec[i64], x: i64) -> bool {
    for y in v.iter() {
        if *y == x {
            return true;
        }
    }
    false
}

fn has_str(v: ref Vec[String], x: ref String) -> bool {
    for y in v.iter() {
        if *y == *x {
            return true;
        }
    }
    false
}

fn has_star(v: ref Vec[It]) -> bool {
    has_it(v, It.Star)
}

// The key _expand sorts by: f"{i:02}" for a number, else the string.
fn sort_key(x: ref It) -> String {
    match x {
        It.N(n) => if *n >= 0 and *n < 10 { f"0{n}" } else { f"{n}" },
        It.Star => "*".to_string(),
        It.L => "l".to_string(),
    }
}

fn it_repr(x: ref It) -> String {
    match x {
        It.N(n) => f"{n}",
        It.Star => "'*'".to_string(),
        It.L => "'l'".to_string(),
    }
}

// An nth weekday entry: a weekday and the set of n (-1 for 'l').
#[derive(Clone)]
struct Nth {
    wday: i64,
    ns: Vec[i64],
}

struct Expanded {
    fields: Vec[Vec[It]],
    nth: Vec[Nth],
    expressions: Vec[String],
    nearest: Vec[i64],
}

fn expanded_repr(e: ref Expanded) -> String {
    let mut parts: Vec[String] = Vec.new();
    for f in e.fields.iter() {
        let mut items: Vec[String] = Vec.new();
        for x in f.iter() {
            items.push(it_repr(x));
        }
        let inner = join(items, ", ");
        parts.push(f"[{inner}]");
    }
    let mut keys: Vec[i64] = Vec.new();
    for n in e.nth.iter() {
        keys.push(n.wday);
    }
    keys.sort();
    let mut nths: Vec[String] = Vec.new();
    for k in keys.iter() {
        for n in e.nth.iter() {
            if n.wday == *k {
                let mut ns = n.ns.clone();
                ns.sort();
                let mut vals: Vec[String] = Vec.new();
                for v in ns.iter() {
                    if *v >= 0 {
                        vals.push(f"{v}");
                    }
                }
                // 'l' sorts after the digits
                if ns.len() > 0 and ns[0] < 0 {
                    vals.push("'l'".to_string());
                }
                let inner = join(vals, ", ");
                nths.push(f"{k}: [{inner}]");
            }
        }
    }
    let a = join(parts, ", ");
    let b = join(nths, ", ");
    f"[{a}] " + "{" + b + "}"
}

// ------------------------------------------------------------ names

const MONTH_NAMES: Array[Str, 12] = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
const DOW_NAMES: Array[Str, 7] = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"];

fn month_number(s: Str) -> i64 {
    for i in 0..12 {
        if s == MONTH_NAMES[i] {
            return i + 1;
        }
    }
    -1
}

fn dow_number(s: Str) -> i64 {
    for i in 0..7 {
        if s == DOW_NAMES[i] {
            return i;
        }
    }
    -1
}

// croniter._alphaconv: a name in ALPHACONV[index].
fn alphaconv(index: i64, key: Str, expressions: ref Vec[String]) -> Result[It, Exc] {
    if index == DAY_FIELD and key == "l" {
        return Ok(It.L);
    }
    if index == MONTH_FIELD and month_number(key) > 0 {
        return Ok(It.N(month_number(key)));
    }
    if index == DOW_FIELD and dow_number(key) >= 0 {
        return Ok(It.N(dow_number(key)));
    }
    Err(exc("CroniterNotAlphaError", f"[{join(expressions, " ")}] is not acceptable"))
}

// croniter.value_alias: 0 is the 1st of a day or month field and 7 is
// Sunday, but only for some field counts.
fn value_alias(val: i64, index: i64, n: i64) -> i64 {
    let skip = ((index == DAY_FIELD or index == MONTH_FIELD) and n == 5)
        or ((index == MONTH_FIELD or index == DOW_FIELD) and n == 6)
        or ((index == DAY_FIELD or index == MONTH_FIELD or index == DOW_FIELD) and n == 7);
    if skip {
        return val;
    }
    if (index == DAY_FIELD or index == MONTH_FIELD) and val == 0 {
        return 1;
    }
    if index == DOW_FIELD and val == 7 {
        return 0;
    }
    val
}

// ------------------------------------------------------------ the regexes

// A weekday, or two joined by '-'; or the same for months.
fn is_name_range(s: Str, month: bool) -> bool {
    let (a, dash, b) = partition(s, b'-');
    let ok = |x: Str| { if month { month_number(x) > 0 } else { dow_number(x) >= 0 } };
    if not ok(a) {
        return false;
    }
    if dash { ok(b) } else { true }
}

fn all_word(s: Str) -> bool {
    let b = to_bytes(s);
    if b.len() == 0 {
        return false;
    }
    for c in b.iter() {
        if not is_word(*c) {
            return false;
        }
    }
    true
}

// special_dow_re: (he, last) for 'he#last', ("", last) for 'l' + digits,
// or None.
fn special_dow(s: Str) -> Option[(String, String)] {
    let (h, sharp, d) = partition(s, b'#');
    if sharp and all_digits_str(d) and (is_name_range(h, false) or is_name_range(h, true) or all_word(h)) {
        return Some((h, d));
    }
    if first_byte(s) == b'l' and all_digits_str(slice_from(s, 1)) {
        return Some((String.new(), slice_from(s, 1)));
    }
    None
}

// nearest_weekday_re: the day of '15w' or 'w15'.
fn nearest_weekday_day(s: Str) -> Option[i64] {
    let b = to_bytes(s);
    let n = b.len();
    if n >= 2 and b[n - 1] == b'w' and all_digits_str(slice(s, 0, n - 1)) {
        return Some(digits_int(slice(s, 0, n - 1)));
    }
    if n >= 2 and b[0] == b'w' and all_digits_str(slice_from(s, 1)) {
        return Some(digits_int(slice_from(s, 1)));
    }
    None
}

// step_search_re: (low, high, step) of 'low-high' or 'low-high/step'.
fn step_search(s: Str) -> Option[(String, String, String)] {
    let i = find_byte(s, b'-');
    if i <= 0 {
        return None;
    }
    let low = slice(s, 0, i);
    let rest = slice_from(s, i + 1);
    let rb = to_bytes(rest);
    let mut j: i64 = 0;
    while j < rb.len() and rb[j] != b'-' and rb[j] != b'/' {
        j += 1;
    }
    if j == 0 {
        return None;
    }
    let high = slice(rest, 0, j);
    if j == rb.len() {
        return Some((low, high, String.new()));
    }
    if rb[j] == b'/' and all_digits_str(slice_from(rest, j + 1)) {
        return Some((low, high, slice_from(rest, j + 1)));
    }
    None
}

// re.sub(r"^(.+)\/(.+)$", r"\1-HI/\2", s): the last '/' with something
// on both sides.
fn sub_step(s: Str, hi: i64) -> String {
    let b = to_bytes(s);
    let mut i = b.len() - 2;
    while i >= 1 {
        if b[i] == b'/' {
            return f"{slice(s, 0, i)}-{hi}/{slice_from(s, i + 1)}";
        }
        i -= 1;
    }
    s.to_string()
}

// ------------------------------------------------------------ hashing

fn crc32(b: ref Vec[u8]) -> i64 {
    let mut c: u32 = 0xFFFFFFFF;
    for x in b.iter() {
        c = c ^ (*x as u32);
        for _ in 0..8 {
            c = if (c & 1) != 0 { (c >> 1) ^ 0xEDB88320 } else { c >> 1 };
        }
    }
    (c ^ 0xFFFFFFFF) as i64
}

// HashExpander.do. A hash_id given to croniter.expand as a str reaches
// binascii.crc32 unencoded, which refuses it.
fn hash_do(idx: i64, hash_id: ref Vec[u8], hash_str: bool, range_end: i64, range_begin: i64) -> Result[i64, Exc] {
    if hash_str {
        return Err(exc("TypeError", "a bytes-like object is required, not 'str'"));
    }
    Ok(fmod(crc32(hash_id) >> idx, range_end - range_begin + 1) + range_begin)
}

// HashExpander.expand on one field.
fn hash_expand(idx: i64, expr: Str, hash_id: ref Option[Vec[u8]], hash_str: bool) -> Result[String, Exc] {
    let b = to_bytes(expr);
    if b.len() == 0 or (b[0] != b'h' and b[0] != b'r') {
        return Ok(expr.to_string());
    }
    // ^(h|r)(\((\d+)-(\d+)\))?(\/(\d+))?$
    let mut i: i64 = 1;
    let mut rb = String.new();
    let mut re = String.new();
    if i < b.len() and b[i] == b'(' {
        let mut j = i + 1;
        while j < b.len() and is_digit(b[j]) {
            j += 1;
        }
        let mut k = j + 1;
        while k < b.len() and is_digit(b[k]) {
            k += 1;
        }
        if j > i + 1 and j < b.len() and b[j] == b'-' and k > j + 1 and k < b.len() and b[k] == b')' {
            rb = slice(expr, i + 1, j);
            re = slice(expr, j + 1, k);
            i = k + 1;
        }
    }
    let mut div = String.new();
    if i < b.len() {
        if b[i] != b'/' or not all_digits_str(slice_from(expr, i + 1)) {
            return Ok(expr.to_string());
        }
        div = slice_from(expr, i + 1);
    }
    if b[0] == b'r' {
        return Err(exc("NotPorted", "R (random) definitions are not ported"));
    }
    let id = match hash_id {
        Some(v) => v.clone(),
        None => return Err(bad_cron("Hashed definitions must include hash_id")),
    };
    let has_range = rb.len() > 0;
    if has_range and digits_int(rb) >= digits_int(re) {
        return Err(bad_cron("Range end must be greater than range begin"));
    }
    if has_range and div.len() > 0 {
        if digits_int(div) == 0 {
            return Err(bad_cron(f"Bad expression: {expr}"));
        }
        let x = hash_do(idx, id, hash_str, digits_int(div) - 1 + digits_int(rb), digits_int(rb))?;
        return Ok(f"{x}-{digits_int(re)}/{digits_int(div)}");
    }
    if has_range {
        return Ok(f"{hash_do(idx, id, hash_str, digits_int(re), digits_int(rb))?}");
    }
    if div.len() > 0 {
        if digits_int(div) == 0 {
            return Err(bad_cron(f"Bad expression: {expr}"));
        }
        let x = hash_do(idx, id, hash_str, digits_int(div) - 1 + RANGE_LO[idx], RANGE_LO[idx])?;
        return Ok(f"{x}-{RANGE_HI[idx]}/{digits_int(div)}");
    }
    Ok(f"{hash_do(idx, id, hash_str, RANGE_HI[idx], RANGE_LO[idx])?}")
}

// ------------------------------------------------------------ _expand

fn alias_of(efl: Str, hashed: bool) -> Option[String] {
    let (plain, hash) = if efl == "@midnight" {
        ("0 0 * * *", "h h(0-2) * * * h")
    } else if efl == "@hourly" {
        ("0 * * * *", "h * * * * h")
    } else if efl == "@daily" {
        ("0 0 * * *", "h h * * * h")
    } else if efl == "@weekly" {
        ("0 0 * * 0", "h h * * h h")
    } else if efl == "@monthly" {
        ("0 0 1 * *", "h h h * * h")
    } else if efl == "@yearly" or efl == "@annually" {
        ("0 0 1 1 *", "h h h h * h")
    } else {
        return None;
    };
    Some(if hashed { hash.to_string() } else { plain.to_string() })
}

// croniter._get_low_from_current_date_number
fn low_from_date(index: i64, step: i64, ts: i64) -> Result[i64, Exc] {
    let f = fields(ts * US);
    if index == MINUTE_FIELD {
        return Ok(fmod(f.mi, step));
    }
    if index == HOUR_FIELD {
        return Ok(fmod(f.h, step));
    }
    if index == DAY_FIELD {
        return Ok(fmod(f.d - 1, step) + 1);
    }
    if index == MONTH_FIELD {
        return Ok(fmod(f.mo - 1, step) + 1);
    }
    if index == DOW_FIELD {
        return Ok(fmod(cron_dow(f), step));
    }
    Err(exc("ValueError", "Can't get current date number for index larger than 4"))
}

fn int_list_repr(v: ref Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in v.iter() {
        parts.push(f"{x}");
    }
    let inner = join(parts, ", ");
    f"[{inner}]"
}

// One field of the expression, after hashing: its values, with the nth
// weekdays and nearest weekdays it adds.
fn expand_field(
    expr_format: Str,
    field_index: i64,
    expr0: String,
    expressions: ref Vec[String],
    from_ts: f64,
    nth: mut ref Vec[Nth],
    nearest: mut ref Vec[i64],
) -> Result[Vec[It], Exc] {
    let n_expr = expressions.len();
    let mut expr = expr0.clone();
    if find_byte(expr, b'?') >= 0 {
        if expr != "?" {
            return Err(bad_cron(f"[{expr_format}] is not acceptable. Question mark can not used with other characters"));
        }
        if field_index != DAY_FIELD and field_index != DOW_FIELD {
            return Err(bad_cron(f"[{expr_format}] is not acceptable. Question mark can only used in day_of_month or day_of_week"));
        }
        expr = "*".to_string();
    }
    let lo_f = RANGE_LO[field_index];
    let hi_f = RANGE_HI[field_index];
    let mut e_list = split_commas(expr);
    let mut res: Vec[It] = Vec.new();
    let mut seen: Vec[String] = Vec.new();
    while e_list.len() > 0 {
        let mut e = e_list.pop().unwrap();
        // the n of 'e#n' (-1 for an 'l' prefix), or 0
        let mut nth_n: i64 = 0;
        if field_index == DOW_FIELD {
            if let Some((he, last)) = special_dow(e) {
                if he.len() > 0 {
                    e = he;
                    let n = digits_int(last);
                    if n < 1 or n > 5 {
                        return Err(bad_cron(f"[{expr_format}] is not acceptable. Invalid day_of_week value: '{n}'"));
                    }
                    nth_n = n;
                } else {
                    e = last;
                    nth_n = -1;
                }
            }
        }
        if field_index == DAY_FIELD {
            if let Some(w_day) = nearest_weekday_day(e) {
                if w_day < 1 or w_day > 31 {
                    return Err(bad_cron(f"[{expr_format}] is not acceptable, nearest weekday day value '{w_day}' out of range"));
                }
                if e_list.len() > 0 or res.len() > 0 {
                    return Err(bad_cron(f"[{expr_format}] is not acceptable. 'W' can only be used with a single day value, not in a list or range"));
                }
                if not has_i64(nearest, w_day) {
                    nearest.push(w_day);
                }
                res.push(It.N(w_day));
                continue;
            }
        }
        let eb = to_bytes(e);
        let mut t = if eb.len() >= 3 and eb[0] == b'*' and eb[1] == b'/' {
            f"{lo_f}-{hi_f}{slice_from(e, 1)}"
        } else {
            e.clone()
        };
        let mut m = step_search(t);
        if m.is_none() {
            t = sub_step(e, hi_f);
            m = step_search(t);
        }
        if let Some((low0, high0, step0)) = m {
            let mut low_s = low0;
            let mut high_s = high0;
            if field_index == DAY_FIELD and high_s == "l" {
                high_s = "31".to_string();
            }
            if not all_digits_str(low_s) {
                low_s = match alphaconv(field_index, low_s, expressions)? {
                    It.N(v) => f"{v}",
                    _ => "l".to_string(),
                };
            }
            if not all_digits_str(high_s) {
                high_s = match alphaconv(field_index, high_s, expressions)? {
                    It.N(v) => f"{v}",
                    _ => "l".to_string(),
                };
            }
            let step = if step0.len() > 0 { digits_int(step0) } else { 1 };
            if step == 0 {
                return Err(bad_cron(f"[{expr_format}] step '{step}' in field {field_index} is not acceptable"));
            }
            if not all_digits_str(low_s) or not all_digits_str(high_s) {
                return Err(bad_cron(f"[{expr_format}] bands '{low_s}-{high_s}' in field {field_index} are not acceptable"));
            }
            let mut low = value_alias(digits_int(low_s), field_index, n_expr);
            let high = value_alias(digits_int(high_s), field_index, n_expr);
            let top = if low > high { low } else { high };
            if top > hi_f {
                return Err(bad_cron(f"{expr_format} is out of bands"));
            }
            if from_ts != 0.0 {
                low = low_from_date(field_index, step, from_ts as i64)?;
            }
            let mut rng: Vec[i64] = Vec.new();
            if low > high {
                let mut v = low;
                while v <= hi_f {
                    rng.push(v);
                    v += step;
                }
                let mut to_skip: i64 = 0;
                if rng.len() > 0 {
                    let last = rng[rng.len() - 1];
                    let already_skipped = hi_f - last;
                    let curpos = last - lo_f;
                    if curpos + step > hi_f - lo_f + 1 and already_skipped < step {
                        to_skip = step - already_skipped;
                    }
                }
                let mut w = lo_f + to_skip;
                while w <= high {
                    rng.push(w);
                    w += step;
                }
            } else if low == high {
                let mut v = lo_f;
                while v <= hi_f {
                    rng.push(v);
                    v += step;
                }
            } else {
                let mut v = low;
                while v <= high {
                    rng.push(v);
                    v += step;
                }
            }
            let mut items: Vec[String] = Vec.new();
            for v in rng.iter() {
                items.push(if field_index == DOW_FIELD and nth_n > 0 { f"{v}#{nth_n}" } else { f"{v}" });
            }
            for a in items.iter() {
                if not has_str(seen, a) {
                    e_list.push(a.clone());
                }
            }
            for a in items.iter() {
                if not has_str(seen, a) {
                    seen.push(a.clone());
                }
            }
        } else {
            if first_byte(t) == b'-' {
                return Err(bad_cron(f"[{expr_format}] is not acceptable, negative numbers not allowed"));
            }
            let v = if t == "*" {
                It.Star
            } else if all_digits_str(t) {
                It.N(digits_int(t))
            } else {
                alphaconv(field_index, t, expressions)?
            };
            let v2 = match v {
                It.N(n) => It.N(value_alias(n, field_index, n_expr)),
                other => other,
            };
            if let It.N(n) = v2 {
                if n < lo_f or n > hi_f {
                    return Err(bad_cron(f"[{expr_format}] is not acceptable, out of range"));
                }
            }
            res.push(v2.clone());
            if field_index == DOW_FIELD and nth_n != 0 {
                if let It.N(wd) = v2 {
                    let mut found = false;
                    for k in 0..nth.len() {
                        if nth[k].wday == wd {
                            found = true;
                            if not has_i64(nth[k].ns, nth_n) {
                                nth[k].ns.push(nth_n);
                            }
                        }
                    }
                    if not found {
                        nth.push(Nth { wday: wd, ns: vec![nth_n] });
                    }
                }
            }
        }
    }
    // set(), then sorted by the f"{i:02}" key
    let mut uniq: Vec[It] = Vec.new();
    for x in res.iter() {
        if not has_it(uniq, x) {
            uniq.push(x.clone());
        }
    }
    let mut keyed: Vec[(String, i64)] = Vec.new();
    for i in 0..uniq.len() {
        keyed.push((sort_key(uniq[i]), i));
    }
    keyed.sort();
    let mut out: Vec[It] = Vec.new();
    for (_, i) in keyed.iter() {
        out.push(uniq[*i].clone());
    }
    if out.len() == LEN_MEANS_ALL[field_index] {
        let keep = (field_index == DAY_FIELD and find_byte(expressions[DOW_FIELD], b'*') < 0)
            or (field_index == DOW_FIELD and find_byte(expressions[DAY_FIELD], b'*') < 0);
        if not keep {
            out = vec![It.Star];
        }
    }
    if out.len() == 1 and has_star(out) {
        out = vec![It.Star];
    }
    Ok(out)
}

// croniter._expand
fn expand(
    expr_format: Str,
    hash_id: ref Option[Vec[u8]],
    hash_str: bool,
    second_at_beginning: bool,
    from_ts: f64,
    strict: bool,
    strict_year: ref Option[Vec[i64]],
) -> Result[Expanded, Exc] {
    let mut efl = lower(expr_format);
    if let Some(a) = alias_of(efl, hash_id.is_some()) {
        efl = a;
    }
    let mut expressions = split_ws(efl);
    let n = expressions.len();
    if n != 5 and n != 6 and n != 7 {
        return Err(bad_cron("Exactly 5, 6 or 7 columns has to be specified for iterator expression."));
    }
    if n > 5 and second_at_beginning {
        let first = expressions.remove(0);
        expressions.insert(SECOND_FIELD, first);
    }
    let mut fields: Vec[Vec[It]] = Vec.new();
    let mut nth: Vec[Nth] = Vec.new();
    let mut nearest: Vec[i64] = Vec.new();
    for field_index in 0..n {
        let expr = hash_expand(field_index, expressions[field_index], hash_id, hash_str)?;
        let f = expand_field(expr_format, field_index, expr, expressions, from_ts, mut nth, mut nearest)?;
        fields.push(f);
    }
    if nth.len() > 0 {
        let mut rest: Vec[i64] = Vec.new();
        let mut distinct: i64 = 0;
        for x in fields[DOW_FIELD].iter() {
            distinct += 1;
            if let It.N(v) = x {
                let mut keyed = false;
                for e in nth.iter() {
                    if e.wday == *v {
                        keyed = true;
                    }
                }
                if not keyed {
                    rest.push(*v);
                }
            }
        }
        if rest.len() > 0 and distinct != LEN_MEANS_ALL[DOW_FIELD] {
            rest.sort();
            let mut ds: Vec[String] = Vec.new();
            for v in rest.iter() {
                ds.push(f"{v}");
            }
            let mut ns: Vec[String] = Vec.new();
            for e in nth.iter() {
                let mut vs = e.ns.clone();
                vs.sort();
                let mut parts: Vec[String] = Vec.new();
                for v in vs.iter() {
                    parts.push(f"{v}");
                }
                let inner = join(parts, ", ");
                ns.push(f"{e.wday}: " + "{" + inner + "}");
            }
            let dow = join(ds, ", ");
            let nths = join(ns, ", ");
            let msg = f"day-of-week field does not support mixing literal values and nth day of week syntax.  Cron: '{expr_format}'    dow=" + "{" + dow + "} vs nth={" + nths + "}";
            return Err(exc("CroniterUnsupportedSyntaxError", msg));
        }
    }
    if strict {
        strict_check(expr_format, fields, strict_year)?;
    }
    Ok(Expanded { fields: fields, nth: nth, expressions: expressions, nearest: nearest })
}

fn strict_check(expr_format: Str, fields: ref Vec[Vec[It]], strict_year: ref Option[Vec[i64]]) -> Result[(), Exc] {
    let days = fields[DAY_FIELD].clone();
    let months = fields[MONTH_FIELD].clone();
    let days_star = days.len() == 1 and has_star(days);
    let days_l = days.len() == 1 and has_it(days, It.L);
    let months_star = months.len() == 1 and has_star(months);
    if days_star or days_l or months_star {
        return Ok(());
    }
    let mut int_days: Vec[i64] = Vec.new();
    for x in days.iter() {
        if let It.N(v) = x {
            int_days.push(*v);
        }
    }
    let mut int_months: Vec[i64] = Vec.new();
    for x in months.iter() {
        if let It.N(v) = x {
            int_months.push(*v);
        }
    }
    if int_days.len() == 0 or int_months.len() == 0 {
        return Ok(());
    }
    let mut feb: i64 = 28;
    if has_i64(int_months, 2) {
        let mut leap = true;
        if let Some(ys) = strict_year {
            leap = false;
            for y in ys.iter() {
                if is_leap(*y) {
                    leap = true;
                }
            }
        } else if fields.len() > YEAR_FIELD {
            let years = fields[YEAR_FIELD].clone();
            if not (years.len() == 1 and has_star(years)) {
                let mut any = false;
                let mut seen = false;
                for x in years.iter() {
                    if let It.N(y) = x {
                        seen = true;
                        if is_leap(*y) {
                            any = true;
                        }
                    }
                }
                if seen {
                    leap = any;
                }
            }
        }
        if leap {
            feb = 29;
        }
    }
    let mut min_day = int_days[0];
    for d in int_days.iter() {
        if *d < min_day {
            min_day = *d;
        }
    }
    let mut max_possible: i64 = 0;
    for m in int_months.iter() {
        let dim = if *m == 2 { feb } else { days_in_month(2001, *m) };
        if dim > max_possible {
            max_possible = dim;
        }
    }
    if min_day > max_possible {
        return Err(bad_cron(f"[{expr_format}] is not acceptable. Day(s) {int_list_repr(int_days)} can never occur in month(s) {int_list_repr(int_months)}"));
    }
    Ok(())
}

// ------------------------------------------------------------ the iterator

struct Cron {
    ex: Expanded,
    day_or: bool,
    cron_bug: bool,
    max_years: i64,
    max_set: bool,
    // the tzinfo of the start time, or -1
    tz: i64,
    cur: f64,
}

struct Opts {
    day_or: bool,
    hash_id: Option[Vec[u8]],
    second_at_beginning: bool,
    cron_bug: bool,
    expand_from_start: bool,
    max_years: Option[i64],
}

fn default_opts() -> Opts {
    Opts {
        day_or: true,
        hash_id: None,
        second_at_beginning: false,
        cron_bug: false,
        expand_from_start: false,
        max_years: None,
    }
}

// A start or stop time: a float timestamp or a datetime.
#[derive(Clone)]
enum TimeArg {
    Ts(f64),
    At(Dt),
}

fn time_str(zs: ref Zones, t: ref TimeArg) -> String {
    match t {
        TimeArg.Ts(x) => f"{x}",
        TimeArg.At(d) => dt_str(zs, d),
    }
}

// croniter.__init__
fn new_cron(zs: ref Zones, expr: Str, start: ref TimeArg, o: ref Opts) -> Result[Cron, Exc] {
    let (tz, cur) = match start {
        TimeArg.Ts(x) => (-1, *x),
        TimeArg.At(d) => (d.tz, dt_to_ts(zs, d)),
    };
    let max_years = match o.max_years {
        Some(n) => if n < 1 { 1 } else { n },
        None => 50,
    };
    let from_ts = if o.expand_from_start { cur } else { 0.0 };
    let ex = expand(expr, o.hash_id, false, o.second_at_beginning, from_ts, false, None)?;
    Ok(Cron {
        ex: ex,
        day_or: o.day_or,
        cron_bug: o.cron_bug,
        max_years: max_years,
        max_set: o.max_years.is_some(),
        tz: tz,
        cur: cur,
    })
}

// _get_next_nearest_diff
fn next_nearest_diff(x: i64, to_check: ref Vec[It], range_val: i64) -> Option[i64] {
    for d in to_check.iter() {
        let mut v: i64 = 0;
        match d {
            It.N(n) => v = *n,
            _ => v = range_val,
        }
        if range_val >= 0 {
            if v > range_val {
                continue;
            }
        }
        if v >= x {
            return Some(v - x);
        }
    }
    if range_val < 0 {
        return None;
    }
    let first = match to_check[0] {
        It.N(n) => n,
        _ => range_val,
    };
    Some(first - x + range_val)
}

// _get_prev_nearest_diff
fn prev_nearest_diff(x: i64, to_check: ref Vec[It], range_val: i64) -> Option[i64] {
    let mut cands: Vec[i64] = Vec.new();
    let mut has_l = false;
    let mut i = to_check.len() - 1;
    while i >= 0 {
        match to_check[i] {
            It.N(n) => cands.push(n),
            _ => has_l = true,
        }
        i -= 1;
    }
    for d in cands.iter() {
        if *d <= x {
            return Some(*d - x);
        }
    }
    if has_l {
        return Some(-x);
    }
    if range_val < 0 {
        return None;
    }
    let mut candidate = cands[0];
    for c in cands.iter() {
        if *c <= range_val {
            candidate = *c;
            break;
        }
    }
    if candidate > range_val {
        return Some(-range_val);
    }
    Some(candidate - x - range_val)
}

fn nearest_diff(is_prev: bool, x: i64, to_check: ref Vec[It], range_val: i64) -> Option[i64] {
    if is_prev { prev_nearest_diff(x, to_check, range_val) } else { next_nearest_diff(x, to_check, range_val) }
}

// The days of a month that fall on a weekday (Sunday is 0).
fn nth_weekdays(year: i64, month: i64, dow: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let first = days_from_civil(year, month, 1);
    for d in 1..days_in_month(year, month) + 1 {
        if fmod(weekday(first + d - 1) + 1, 7) == dow {
            out.push(d);
        }
    }
    out
}

// _get_nearest_weekday
fn nearest_weekday(year: i64, month: i64, day0: i64) -> i64 {
    let last_day = days_in_month(year, month);
    let day = if day0 < last_day { day0 } else { last_day };
    let wd = weekday(days_from_civil(year, month, day));
    if wd < 5 {
        return day;
    }
    if wd == 5 {
        return if day > 1 { day - 1 } else { day + 2 };
    }
    if day < last_day { day + 1 } else { day - 2 }
}

// The step a proc takes on a day change: to the start of the day, or to
// its last second going back.
fn day_step(d: ref F, days: i64, is_prev: bool) -> F {
    if is_prev { plus_days(set_time(d, 23, 59, 59), days) } else { plus_days(set_time(d, 0, 0, 0), days) }
}

// No candidate this month: to the start of the next, or the last second
// of the one before.
fn month_skip(d: ref F, is_prev: bool) -> F {
    if is_prev {
        return plus_days(set_time(d, 23, 59, 59), -d.d);
    }
    plus_days(set_time(d, 0, 0, 0), days_in_month(d.y, d.mo) - d.d + 1)
}

// A day picked from candidates: (changed, the new time).
fn pick_day(d: ref F, cands0: ref Vec[i64], is_prev: bool) -> (bool, F) {
    if cands0.len() == 0 {
        return (true, month_skip(d, is_prev));
    }
    let mut cands = cands0.clone();
    cands.sort();
    let diff = (if is_prev { cands[cands.len() - 1] } else { cands[0] }) - d.d;
    if diff != 0 {
        return (true, day_step(d, diff, is_prev));
    }
    (false, d.clone())
}

// The procs of croniter._calc. Each returns 0 when nothing changed, 1
// when the time moved, and 2 for None (no year is left).
fn proc_step(c: ref Cron, which: i64, ex: ref Vec[Vec[It]], is_prev: bool, d: mut ref F) -> i64 {
    let nf = ex.len();
    if which == 0 {
        // the year
        if nf == 7 and not has_star(ex[YEAR_FIELD]) {
            let dy = match nearest_diff(is_prev, d.y, ex[YEAR_FIELD], -1) {
                Some(v) => v,
                None => return 2,
            };
            if dy != 0 {
                let y = d.y + dy;
                *d = if is_prev {
                    F { y: y, mo: 12, d: 31, h: 23, mi: 59, s: 59, us: d.us }
                } else {
                    F { y: y, mo: 1, d: 1, h: 0, mi: 0, s: 0, us: d.us }
                };
                return 1;
            }
        }
        return 0;
    }
    if which == 1 {
        // the month
        if not has_star(ex[MONTH_FIELD]) {
            if let Some(dm) = nearest_diff(is_prev, d.mo, ex[MONTH_FIELD], 12) {
                if dm != 0 {
                    if is_prev {
                        let g = plus_months(d, dm);
                        let mut h = set_time(g, 23, 59, 59);
                        h.d = days_in_month(g.y, g.mo);
                        *d = h;
                    } else {
                        let mut g = plus_months(d, dm);
                        g.d = 1;
                        *d = set_time(g, 0, 0, 0);
                    }
                    return 1;
                }
            }
        }
        return 0;
    }
    if which == 2 {
        if c.ex.nearest.len() > 0 {
            let mut cands: Vec[i64] = Vec.new();
            for w in c.ex.nearest.iter() {
                let cand = nearest_weekday(d.y, d.mo, *w);
                if (is_prev and cand <= d.d) or (not is_prev and d.d <= cand) {
                    cands.push(cand);
                }
            }
            let (changed, g) = pick_day(d, cands, is_prev);
            *d = g;
            return if changed { 1 } else { 0 };
        }
        // the day of the month
        if not has_star(ex[DAY_FIELD]) {
            let days = days_in_month(d.y, d.mo);
            if has_it(ex[DAY_FIELD], It.L) and days == d.d {
                return 0;
            }
            let range_val = if is_prev {
                let pm = fmod(d.mo - 2, 12) + 1;
                let py = if d.mo == 1 { d.y - 1 } else { d.y };
                days_in_month(py, pm)
            } else {
                days
            };
            if let Some(dd) = nearest_diff(is_prev, d.d, ex[DAY_FIELD], range_val) {
                if dd != 0 {
                    *d = day_step(d, dd, is_prev);
                    return 1;
                }
            }
        }
        return 0;
    }
    if which == 3 {
        if c.ex.nth.len() > 0 {
            let mut cands: Vec[i64] = Vec.new();
            for e in c.ex.nth.iter() {
                let days = nth_weekdays(d.y, d.mo, e.wday);
                for n in e.ns.iter() {
                    if *n > 0 and days.len() < *n {
                        continue;
                    }
                    let cand = if *n < 0 { days[days.len() - 1] } else { days[*n - 1] };
                    if (is_prev and cand <= d.d) or (not is_prev and d.d <= cand) {
                        cands.push(cand);
                    }
                }
            }
            let (changed, g) = pick_day(d, cands, is_prev);
            *d = g;
            return if changed { 1 } else { 0 };
        }
        // the day of the week
        if not has_star(ex[DOW_FIELD]) {
            if let Some(dd) = nearest_diff(is_prev, cron_dow(d), ex[DOW_FIELD], 7) {
                if dd != 0 {
                    *d = day_step(d, dd, is_prev);
                    return 1;
                }
            }
        }
        return 0;
    }
    if which == 4 {
        if not has_star(ex[HOUR_FIELD]) {
            if let Some(dh) = nearest_diff(is_prev, d.h, ex[HOUR_FIELD], 24) {
                if dh != 0 {
                    let g = if is_prev { set_time(d, d.h, 59, 59) } else { set_time(d, d.h, 0, 0) };
                    *d = fields(us_of(g) + dh * 3600 * US);
                    return 1;
                }
            }
        }
        return 0;
    }
    if which == 5 {
        if not has_star(ex[MINUTE_FIELD]) {
            if let Some(dm) = nearest_diff(is_prev, d.mi, ex[MINUTE_FIELD], 60) {
                if dm != 0 {
                    let g = set_time(d, d.h, d.mi, if is_prev { 59 } else { 0 });
                    *d = fields(us_of(g) + dm * MINUTE_US);
                    return 1;
                }
            }
        }
        return 0;
    }
    // the second
    if nf > 5 {
        if not has_star(ex[SECOND_FIELD]) {
            if let Some(ds) = nearest_diff(is_prev, d.s, ex[SECOND_FIELD], 60) {
                if ds != 0 {
                    *d = fields(us_of(d) + ds * US);
                    return 1;
                }
            }
        }
    } else {
        d.s = 0;
    }
    0
}

// _add_tzinfo: the wall time in prev's zone, moved past a gap, and the
// side of an overlap that comes after prev. The flag is false when the
// time had to be moved.
fn add_tzinfo(zs: ref Zones, date: i64, prev: ref Dt, is_prev: bool) -> (Dt, bool) {
    let mut result = Dt { us: date, fold: if is_prev { 1 } else { 0 }, tz: prev.tz };
    if not exists(zs, result) {
        while not exists(zs, result) {
            result = plus_us(result, MINUTE_US);
        }
        return (result, false);
    }
    let farther = Dt { us: date, fold: if is_prev { 0 } else { 1 }, tz: prev.tz };
    if utcoffset(zs, result) != utcoffset(zs, farther) {
        if not is_successor(zs, result, prev, is_prev) {
            result = farther;
        }
    }
    (result, true)
}

// croniter._calc
fn calc(c: ref Cron, zs: ref Zones, now: ref Dt, ex: ref Vec[Vec[It]], is_prev: bool) -> Result[Dt, Exc] {
    let nf = ex.len();
    let step = if is_prev { -1 } else if nf > 5 { US } else { MINUTE_US };
    let mut t = fields(now.us + step);
    t.us = 0;
    if nf <= 5 {
        t.s = 0;
    }
    let current_year = t.y;
    let mut year = t.y;
    let mut found = false;
    while (if year > current_year { year - current_year } else { current_year - year }) <= c.max_years {
        let mut next = false;
        let mut stop = false;
        for which in 0..7 {
            let r = proc_step(c, which, ex, is_prev, mut t);
            if r == 2 {
                stop = true;
                break;
            }
            if r == 1 {
                year = t.y;
                next = true;
                break;
            }
        }
        if stop {
            break;
        }
        if next {
            continue;
        }
        found = true;
        break;
    }
    if not found {
        return Err(exc("CroniterBadDateError", if is_prev { "failed to find prev date" } else { "failed to find next date" }));
    }
    t.us = 0;
    let mut unaware = us_of(t);
    if now.tz < 0 {
        return Ok(naive(unaware));
    }
    let mut (aware, ok) = add_tzinfo(zs, unaware, now, is_prev);
    if not ok and (not is_successor(zs, aware, now, is_prev) or has_star(ex[HOUR_FIELD])) {
        while not ok {
            unaware = calc(c, zs, naive(unaware), ex, is_prev)?.us;
            let (a, k) = add_tzinfo(zs, unaware, now, is_prev);
            aware = a;
            ok = k;
        }
    }
    let delta = utcoffset(zs, aware) - utcoffset(zs, now);
    if delta == 0 {
        return Ok(aware);
    }
    let alt_naive = calc(c, zs, naive(now.us + delta * US), ex, is_prev)?;
    let (alt, _) = add_tzinfo(zs, alt_naive.us, now, is_prev);
    if not is_successor(zs, alt, now, is_prev) {
        return Ok(aware);
    }
    if is_successor(zs, aware, alt, is_prev) {
        return Ok(alt);
    }
    Ok(aware)
}

// croniter._calc_next
fn calc_next(c: ref Cron, zs: ref Zones, is_prev: bool) -> Result[Dt, Exc] {
    let current = ts_to_dt(zs, c.cur, c.tz);
    let mut ex = c.ex.fields.clone();
    let day_star = has_it_first_star(ex[DAY_FIELD]);
    let dow_star = has_it_first_star(ex[DOW_FIELD]);
    if not day_star and not dow_star and c.day_or {
        let bug = c.cron_bug and (first_byte(c.ex.expressions[DAY_FIELD]) == b'*' or first_byte(c.ex.expressions[DOW_FIELD]) == b'*');
        if not bug {
            let bak = ex[DOW_FIELD].clone();
            ex[DOW_FIELD] = vec![It.Star];
            let t1 = calc(c, zs, current, ex, is_prev)?;
            ex[DOW_FIELD] = bak;
            ex[DAY_FIELD] = vec![It.Star];
            let t2 = calc(c, zs, current, ex, is_prev)?;
            let cmp = compare(zs, t1, t2)?;
            if is_prev {
                return Ok(if cmp > 0 { t1 } else { t2 });
            }
            return Ok(if cmp < 0 { t1 } else { t2 });
        }
    }
    calc(c, zs, current, ex, is_prev)
}

fn has_it_first_star(v: ref Vec[It]) -> bool {
    match v[0] {
        It.Star => true,
        _ => false,
    }
}

// croniter._get_next: the datetime and its timestamp.
fn get_next(c: mut ref Cron, zs: ref Zones, is_prev: bool, update: bool) -> Result[(Dt, f64), Exc] {
    let result = calc_next(c, zs, is_prev)?;
    let ts = dt_to_ts(zs, result);
    if update {
        c.cur = ts;
    }
    Ok((result, ts))
}

fn set_current(c: mut ref Cron, zs: ref Zones, t: ref Dt) {
    c.tz = t.tz;
    c.cur = dt_to_ts(zs, t);
}

// ------------------------------------------------------------ match and range

// croniter.match_range
fn match_range(zs: ref Zones, expr: Str, from: ref TimeArg, to: ref TimeArg, o: ref Opts, precision: Option[i64]) -> Result[bool, Exc] {
    let mut c = new_cron(zs, expr, to, o)?;
    let mut tdp = ts_to_dt(zs, c.cur, c.tz);
    if fmod(tdp.us, US) == 0 {
        tdp = plus_us(tdp, 1);
    }
    set_current(mut c, zs, tdp);
    let tdt = match get_next(mut c, zs, true, true) {
        Ok((t, _)) => t,
        Err(e) => {
            if e.kind == "CroniterBadDateError" {
                return Ok(false);
            }
            return Err(e);
        }
    };
    let p = match precision {
        Some(n) => n,
        None => if c.ex.fields.len() > 5 { 1 } else { 60 },
    };
    let span = if let TimeArg.At(b) = to {
        if let TimeArg.At(a) = from {
            subtract(zs, b, a)?
        } else {
            return Err(exc("TypeError", "unsupported operand type(s) for -: 'datetime.datetime' and 'float'"));
        }
    } else if let TimeArg.At(_) = from {
        return Err(exc("TypeError", "unsupported operand type(s) for -: 'float' and 'datetime.datetime'"));
    } else {
        return Err(exc("AttributeError", "'float' object has no attribute 'total_seconds'"));
    };
    let duration = total_seconds(span) + (p as f64);
    let gap = if tdp.us > tdt.us { tdp.us - tdt.us } else { tdt.us - tdp.us };
    Ok(total_seconds(gap) < duration)
}

fn type_name(t: ref TimeArg) -> String {
    match t {
        TimeArg.Ts(_) => "<class 'float'>".to_string(),
        TimeArg.At(_) => "<class 'datetime.datetime'>".to_string(),
    }
}

// croniter_range: the values it yields, and the error that ended it.
fn cron_range(zs: ref Zones, start0: ref TimeArg, stop0: ref TimeArg, expr: Str, ret: Str, o: ref Opts, exclude_ends: bool, out: mut ref Vec[String]) -> Result[(), Exc] {
    let mut start = naive(0);
    let mut stop = naive(0);
    let mut auto_float = false;
    let mut same = false;
    if let TimeArg.Ts(a) = start0 {
        if let TimeArg.Ts(b) = stop0 {
            start = naive(from_timestamp(*a));
            stop = naive(from_timestamp(*b));
            auto_float = true;
            same = true;
        }
    }
    if let TimeArg.At(a) = start0 {
        if let TimeArg.At(b) = stop0 {
            start = a.clone();
            stop = b.clone();
            same = true;
        }
    }
    if not same {
        let a = type_name(start0);
        let b = type_name(stop0);
        return Err(exc("CroniterBadTypeRangeError", f"The start and stop must be same type.  {a} != {b}"));
    }
    let as_float = if ret == "" { auto_float } else { ret == "float" };
    if not exclude_ends {
        if compare(zs, start, stop)? < 0 {
            start = plus_us(start, -1);
            stop = plus_us(stop, 1);
        } else {
            start = plus_us(start, 1);
            stop = plus_us(stop, -1);
        }
    }
    let ys = fields(start.us).y;
    let ye = fields(stop.us).y;
    let span = (if ye > ys { ye - ys } else { ys - ye }) + 1;
    let ro = Opts {
        day_or: o.day_or,
        hash_id: None,
        second_at_beginning: o.second_at_beginning,
        cron_bug: false,
        expand_from_start: o.expand_from_start,
        max_years: Some(span),
    };
    let mut c = new_cron(zs, expr, TimeArg.At(start.clone()), ro)?;
    let forward = compare(zs, start, stop)? < 0;
    loop {
        let (t, ts) = match get_next(mut c, zs, not forward, true) {
            Ok(v) => v,
            Err(e) => {
                if e.kind == "CroniterBadDateError" {
                    return Ok(());
                }
                return Err(e);
            }
        };
        let cmp = compare(zs, t, stop)?;
        if (forward and cmp >= 0) or (not forward and cmp <= 0) {
            return Ok(());
        }
        out.push(if as_float { f"{ts}" } else { dt_str(zs, t) });
    }
}

// ------------------------------------------------------------ jobs

fn time_arg(zs: mut ref Zones, j: ref J) -> Result[TimeArg, String] {
    match j {
        J.F(x) => Ok(TimeArg.Ts(*x)),
        J.N(n) => Ok(TimeArg.Ts(*n as f64)),
        _ => {
            let mut v: Vec[i64] = Vec.new();
            if let J.A(items) = j_get(j, "dt") {
                for x in items.iter() {
                    if let J.N(n) = x {
                        v.push(*n as i64);
                    }
                }
            }
            let f = F { y: v[0], mo: v[1], d: v[2], h: v[3], mi: v[4], s: v[5], us: v[6] };
            let tz = match j_get(j, "tz") {
                J.S(s) => tz_index(mut zs, s)?,
                _ => -1,
            };
            Ok(TimeArg.At(Dt { us: us_of(f), fold: j_int(j, "fold", 0) as i64, tz: tz }))
        }
    }
}

fn opts_of(o: ref J) -> Opts {
    let mut r = default_opts();
    if j_present(o, "day_or") {
        r.day_or = j_bool(o, "day_or");
    }
    if j_present(o, "hash_id") {
        r.hash_id = Some(to_bytes(j_str(o, "hash_id")));
    }
    r.second_at_beginning = j_bool(o, "second_at_beginning");
    r.cron_bug = j_bool(o, "implement_cron_bug");
    r.expand_from_start = j_bool(o, "expand_from_start_time");
    if j_present(o, "max_years") {
        r.max_years = Some(j_int(o, "max_years", 0) as i64);
    }
    r
}

fn strict_year_of(o: ref J) -> Option[Vec[i64]] {
    match j_get(o, "strict_year") {
        J.N(n) => Some(vec![n as i64]),
        J.A(items) => {
            let mut v: Vec[i64] = Vec.new();
            for x in items.iter() {
                if let J.N(n) = x {
                    v.push(*n as i64);
                }
            }
            Some(v)
        }
        _ => None,
    }
}

fn show(zs: ref Zones, as_float: bool, t: ref Dt, ts: f64) -> String {
    if as_float { f"{ts}" } else { dt_str(zs, t) }
}

fn run_iter(zs: mut ref Zones, tag: Str, o: ref J) -> Result[(), String] {
    let start = time_arg(mut zs, j_get(o, "start"))?;
    println(f"{tag} from {time_str(zs, start)}");
    let as_float = j_str(o, "ret") == "float";
    let expr = j_str(o, "expr");
    let opts = opts_of(o);
    let mut c = match new_cron(zs, expr, start, opts) {
        Ok(c) => c,
        Err(e) => {
            println(f"  {exc_str(e)}");
            return Ok(());
        }
    };
    if j_str(o, "op") == "all" {
        let prev = j_str(o, "dir") == "prev";
        let want = j_int(o, "n", 0) as i64;
        let mut k: i64 = 0;
        loop {
            match get_next(mut c, zs, prev, true) {
                Ok((t, ts)) => {
                    println(f"  {show(zs, as_float, t, ts)}");
                    k += 1;
                    if k == want {
                        return Ok(());
                    }
                }
                Err(e) => {
                    if e.kind == "CroniterBadDateError" and c.max_set {
                        println("  (end)");
                    } else {
                        println(f"  {exc_str(e)}");
                    }
                    return Ok(());
                }
            }
        }
    }
    for ch in j_str(o, "seq").chars() {
        if ch == 'c' {
            let cur = if as_float { f"{c.cur}" } else { dt_str(zs, ts_to_dt(zs, c.cur, c.tz)) };
            println(f"  c {cur}");
            continue;
        }
        let prev = ch == 'p' or ch == 'P';
        let update = ch == 'n' or ch == 'p';
        match get_next(mut c, zs, prev, update) {
            Ok((t, ts)) => println(f"  {ch} {show(zs, as_float, t, ts)}"),
            Err(e) => println(f"  {ch} {exc_str(e)}"),
        }
    }
    Ok(())
}

fn run_op(zs: mut ref Zones, i: i64, o: ref J) -> Result[(), String] {
    let op = j_str(o, "op");
    let expr = j_str(o, "expr");
    let tag = f"{i}. {op} {str_repr(expr)}";
    if op == "iter" or op == "all" {
        return run_iter(mut zs, tag, o);
    }
    let opts = opts_of(o);
    if op == "expand" {
        let r = expand(expr, opts.hash_id, j_bool(o, "hash_str"), opts.second_at_beginning, 0.0, j_bool(o, "strict"), strict_year_of(o));
        match r {
            Ok(ex) => println(f"{tag} -> {expanded_repr(ex)}"),
            Err(e) => println(f"{tag} -> {exc_str(e)}"),
        }
        return Ok(());
    }
    if op == "valid" {
        let r = expand(expr, opts.hash_id, false, opts.second_at_beginning, 0.0, j_bool(o, "strict"), strict_year_of(o));
        let ok = match r {
            Ok(_) => "True".to_string(),
            Err(e) => if is_croniter_error(e) { "False".to_string() } else { exc_str(e) },
        };
        println(f"{tag} -> {ok}");
        return Ok(());
    }
    let precision = if j_present(o, "precision") { Some(j_int(o, "precision", 0) as i64) } else { None };
    if op == "match" {
        let t = time_arg(mut zs, j_get(o, "t"))?;
        let r = match match_range(zs, expr, t, t, opts, precision) {
            Ok(b) => if b { "True".to_string() } else { "False".to_string() },
            Err(e) => exc_str(e),
        };
        println(f"{tag} at {time_str(zs, t)} -> {r}");
        return Ok(());
    }
    if op == "match_range" {
        let a = time_arg(mut zs, j_get(o, "from"))?;
        let b = time_arg(mut zs, j_get(o, "to"))?;
        let r = match match_range(zs, expr, a, b, opts, precision) {
            Ok(v) => if v { "True".to_string() } else { "False".to_string() },
            Err(e) => exc_str(e),
        };
        println(f"{tag} from {time_str(zs, a)} to {time_str(zs, b)} -> {r}");
        return Ok(());
    }
    if op == "range" {
        let a = time_arg(mut zs, j_get(o, "start"))?;
        let b = time_arg(mut zs, j_get(o, "stop"))?;
        println(f"{tag} from {time_str(zs, a)} to {time_str(zs, b)}");
        let mut out: Vec[String] = Vec.new();
        let r = cron_range(zs, a, b, expr, j_str(o, "ret"), opts, j_bool(o, "exclude_ends"), mut out);
        for line in out.iter() {
            println(f"  {line}");
        }
        if let Err(e) = r {
            println(f"  {exc_str(e)}");
        }
        return Ok(());
    }
    Err(f"unknown op {op}")
}

fn run() -> Result[(), String] {
    let text = match fs.read_to_string("data/jobs.jsonl".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.jsonl: {e}"),
    };
    let mut zs = Zones { names: Vec.new(), list: Vec.new() };
    for line in text.lines() {
        if line.len() == 0 {
            continue;
        }
        let j = json_line(line.to_string())?;
        println(f"== {j_str(j, "name")}");
        if let J.A(ops) = j_get(j, "ops") {
            for i in 0..ops.len() {
                run_op(mut zs, i + 1, ops[i])?;
            }
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("{\"name\": \"basics\", \"ops\": [{\"op\": \"iter\", \"expr\": \"*/15 * * * *\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"nnnnpp\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"0 9 * * mon-fri\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"nnnnnnp\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"30 2 * * *\", \"start\": 1705313250.0, \"seq\": \"nnnc\", \"ret\": \"float\"}, {\"op\": \"iter\", \"expr\": \"0 0 1 * *\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"nnnpppp\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"0 12 * * sun\", \"start\": {\"dt\": [2024, 2, 27, 12, 0, 0, 0], \"tz\": null}, \"seq\": \"nnppp\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"5 4 * * *\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"NNnc\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"0 */6 * * *\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"nnnnnPpc\", \"ret\": \"float\"}, {\"op\": \"iter\", \"expr\": \"15,45 8-10 * * *\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"nnnnnnn\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"59 23 31 12 *\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"nnp\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"0 0 29 2 *\", \"start\": {\"dt\": [2024, 1, 15, 10, 7, 30, 0], \"tz\": null}, \"seq\": \"nnnpp\", \"ret\": \"dt\"}, {\"op\": \"iter\", \"expr\": \"* * * * *\", \"start\": {\"dt\": [2024, 12, 31, 23, 59, 30, 0], \"tz\": null}, \"seq\": \"nnp\", \"ret\": \"dt\"}]}\n");
