fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("books.xml\t-t\t-m\t//book\t-v\t@id\t-o\t: \t-v\ttitle\t-n\n");
    t.push_str("books.xml\t-t\t-m\t//book\t-s\tD:N:-\tprice\t-v\tprice\t-o\t \t-v\t@id\t-n\n");
    t.push_str("books.xml\t-t\t-m\t//book\t-s\tA:T:-\ttitle\t-v\tposition()\t-o\t/\t-v\tlast()\t-o\t \t-v\tnormalize-space(title)\t-n\n");
    t.push_str("books.xml\t-t\t-m\t//book[author]\t-v\t@id\t-o\t:\t-m\tauthor\t-o\t \t-v\tposition()\t-o\t=\t-v\t.\t-b\t-n\n");
    t.push_str("books.xml\t-t\t-m\t//book\t-i\tstock = 0\t-v\t@id\t-o\t sold out\t-n\t-b\t-i\tnot(stock)\t-v\t@id\t-o\t no stock line\t-n\n");
    t.push_str("books.xml\t-t\t-v\tcount(//book)\t-o\t books, \t-v\tsum(//stock)\t-o\t copies\t-n\n");
    t.push_str("books.xml\t-t\t-m\t//book\t-s\tA:T:-\t@category\t-s\tD:N:-\tyear\t-v\t@category\t-o\t \t-v\tyear\t-n\n");
    t.push_str("books.xml\t-t\t-c\t//book[1]/title\t-n\t-c\t//book[4]/comment()\t-n\n");
    t.push_str("feed.xml\t-N\ta=http://www.w3.org/2005/Atom\t-N\tdc=http://purl.org/dc/elements/1.1/\t-t\t-m\t//a:entry\t-s\tA:T:-\ta:updated\t-v\tsubstring(a:updated, 1, 10)\t-o\t \t-v\ta:title\t-o\t (\t-v\tcount(dc:subject)\t-o\t tags)\t-n\n");
    t.push_str("feed.xml\t-N\ta=http://www.w3.org/2005/Atom\t-t\t-m\t//a:entry[position() = last()]\t-v\ta:link/@href\t-n\n");
    t.push_str("page.xhtml\t-N\th=http://www.w3.org/1999/xhtml\t-t\t-m\t//h:tr[h:td]\t-s\tA:N:-\th:td[3]\t-v\th:td[1]\t-o\t@\t-v\th:td[2]\t-o\t \t-v\th:td[3]\t-i\t@class != 'ok'\t-o\t !\t-b\t-n\n");
    t.push_str("page.xhtml\t-N\th=http://www.w3.org/1999/xhtml\t-t\t-m\t//h:a\t-v\tconcat(position(), ' ', @href)\t-n\n");
    t.push_str("pom.xml\t-N\tp=http://maven.apache.org/POM/4.0.0\t-t\t-m\t//p:dependency\t-s\tA:T:-\tp:scope\t-v\tp:groupId\t-o\t:\t-v\tp:artifactId\t-o\t:\t-v\tp:version\t-i\tp:scope\t-o\t [\t-v\tp:scope\t-o\t]\t-b\t-n\n");
    t.push_str("inventory.xml\t-N\tw=urn:example:warehouse\t-t\t-m\t//w:bin\t-v\t@code\t-o\t \t-v\tsum(item/@qty)\t-o\t units, value \t-v\tround(sum(item/@qty) * 100) div 100\t-n\t-m\titem\t-s\tD:N:-\t@qty\t-o\t  \t-v\t@sku\t-o\t x\t-v\t@qty\t-n\n");
    v.push(DataFile { path: "sel.tsv".to_string(), hex: false, body: t });
}
