// mini_regalloc: the back end of a compiler, for mini_ssa's three-address
// IR. It selects instructions for a small load/store machine, computes
// liveness, live intervals and the interference graph, and allocates K
// registers two ways: Poletto and Sarkar's linear scan, and Chaitin's
// graph colouring with Briggs's optimistic colouring. Spilled values go
// through two scratch registers, registers live across a call are saved
// around it, and a simulator runs the result, so every `run` job checks
// both allocations against an interpreter of the IR.

// ------------------------------------------------------------ arithmetic

const STEP_LIMIT: i64 = 100000;
const DEPTH_LIMIT: i64 = 200;

// 32-bit two's complement, as the IR's integers are.
fn wrap(v: i64) -> i64 {
    let m = v & 4294967295;
    if (m & 2147483648) != 0 {
        m - 4294967296
    } else {
        m
    }
}

fn is_binop(s: Str) -> bool {
    match s {
        "==" | "!=" | "<=" | ">=" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "&" | "|" | "^" => true,
        _ => false,
    }
}

fn b2i(b: bool) -> i64 {
    if b {
        1
    } else {
        0
    }
}

// The value of a op b, or None when it traps (division by zero).
fn fold(op: Str, a: i64, b: i64) -> Option[i64] {
    match op {
        "+" => Some(wrap(a + b)),
        "-" => Some(wrap(a - b)),
        "*" => Some(wrap(a * b)),
        "/" => {
            if b == 0 {
                None
            } else {
                Some(wrap(a / b))
            }
        }
        "%" => {
            if b == 0 {
                None
            } else {
                Some(wrap(a % b))
            }
        }
        "&" => Some(wrap(a & b)),
        "|" => Some(wrap(a | b)),
        "^" => Some(wrap(a ^ b)),
        "<<" => Some(wrap(a << (b & 31))),
        ">>" => Some(wrap(a >> (b & 31))),
        "==" => Some(b2i(a == b)),
        "!=" => Some(b2i(a != b)),
        "<" => Some(b2i(a < b)),
        "<=" => Some(b2i(a <= b)),
        ">" => Some(b2i(a > b)),
        _ => Some(b2i(a >= b)),
    }
}

// ------------------------------------------------------------ IR

#[derive(Copy, Clone, PartialEq, Eq)]
enum OpK {
    Var,
    Const,
    Undef,
}

// An operand: a variable, a constant, or undef (which reads as 0).
#[derive(Clone)]
struct Opd {
    kind: OpK,
    name: String,
    val: i64,
}

impl Opd {
    fn show(ref self) -> String {
        match self.kind {
            OpK.Var => self.name.clone(),
            OpK.Const => f"{self.val}",
            OpK.Undef => "undef".to_string(),
        }
    }

    fn same(ref self, o: ref Opd) -> bool {
        self.kind == o.kind and self.name == o.name and self.val == o.val
    }

    fn is_var(ref self) -> bool {
        self.kind == OpK.Var
    }

    fn names(ref self, n: Str) -> bool {
        self.kind == OpK.Var and self.name == n
    }
}

fn mkvar(n: Str) -> Opd {
    Opd { kind: OpK.Var, name: n.to_string(), val: 0 }
}

fn mkconst(v: i64) -> Opd {
    Opd { kind: OpK.Const, name: String.new(), val: v }
}

fn mkundef() -> Opd {
    Opd { kind: OpK.Undef, name: String.new(), val: 0 }
}

#[derive(Copy, Clone, PartialEq, Eq)]
enum Op {
    Bin,
    Mov,
    Call,
    Print,
    Br,
    Jmp,
    Ret,
    Phi,
}

// A phi's args run parallel to its preds.
#[derive(Clone)]
struct Instr {
    op: Op,
    dst: String,
    binop: String,
    args: Vec[Opd],
    labels: Vec[String],
    func: String,
    line: i64,
    preds: Vec[String],
}

fn instr(op: Op, line: i64) -> Instr {
    Instr {
        op: op,
        dst: String.new(),
        binop: String.new(),
        args: Vec.new(),
        labels: Vec.new(),
        func: String.new(),
        line: line,
        preds: Vec.new(),
    }
}

fn jmp_to(label: Str, line: i64) -> Instr {
    let mut i = instr(Op.Jmp, line);
    i.labels.push(label.to_string());
    i
}

fn mov(dst: Str, a: own Opd, line: i64) -> Instr {
    let mut i = instr(Op.Mov, line);
    i.dst = dst.to_string();
    i.args.push(a);
    i
}

impl Instr {
    fn is_term(ref self) -> bool {
        self.op == Op.Br or self.op == Op.Jmp or self.op == Op.Ret
    }

    // No effect but its value: a division by a variable or by zero may
    // trap, so it is not.
    fn pure(ref self) -> bool {
        if self.op == Op.Bin and (self.binop == "/" or self.binop == "%") {
            let d = self.args[1].clone();
            return d.kind == OpK.Const and d.val != 0;
        }
        self.op == Op.Bin or self.op == Op.Mov or self.op == Op.Phi
    }

    fn valued(ref self) -> bool {
        self.op == Op.Bin or self.op == Op.Mov or self.op == Op.Phi
    }

    fn show(ref self) -> String {
        let a: Vec[String] = self.args.iter().map(|x| x.show()).collect();
        match self.op {
            Op.Bin => f"{self.dst} = {a[0]} {self.binop} {a[1]}",
            Op.Mov => f"{self.dst} = {a[0]}",
            Op.Call => {
                let j = a.join(", ");
                let s = f"call {self.func}({j})";
                if self.dst.len() > 0 {
                    f"{self.dst} = {s}"
                } else {
                    s
                }
            }
            Op.Print => f"print {a[0]}",
            Op.Br => f"br {a[0]}, {self.labels[0]}, {self.labels[1]}",
            Op.Jmp => f"jmp {self.labels[0]}",
            Op.Ret => {
                if a.len() > 0 {
                    f"ret {a[0]}"
                } else {
                    "ret".to_string()
                }
            }
            Op.Phi => {
                let mut ps: Vec[String] = Vec.new();
                let mut k = 0;
                while k < a.len() and k < self.preds.len() {
                    ps.push(f"[{a[k]}, {self.preds[k]}]");
                    k += 1;
                }
                let j = ps.join(", ");
                f"{self.dst} = phi {j}"
            }
        }
    }
}

#[derive(Clone)]
struct Block {
    name: String,
    line: i64,
    instrs: Vec[Instr],
}

impl Block {
    fn term(ref self) -> Instr {
        self.instrs[self.instrs.len() - 1].clone()
    }

    fn succs(ref self) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        let t = self.term();
        for l in t.labels.iter() {
            if not out.contains(l.clone()) {
                out.push(l.clone());
            }
        }
        out
    }

    fn has_phi(ref self) -> bool {
        for i in self.instrs.iter() {
            if i.op == Op.Phi {
                return true;
            }
        }
        false
    }
}

#[derive(Clone)]
struct Func {
    name: String,
    params: Vec[String],
    line: i64,
    blocks: Vec[Block],
}

impl Func {
    fn find(ref self, name: Str) -> i64 {
        for k in 0..self.blocks.len() {
            if self.blocks[k].name == name {
                return k;
            }
        }
        -1
    }

    fn show(ref self) -> Vec[String] {
        let ps = self.params.join(", ");
        let mut out: Vec[String] = Vec.new();
        out.push(f"func {self.name}({ps}) " + "{");
        for b in self.blocks.iter() {
            out.push(f"{b.name}:");
            for i in b.instrs.iter() {
                out.push("  " + i.show());
            }
        }
        out.push("}".to_string());
        out
    }
}

// ------------------------------------------------------------ parser

struct IrErr {
    line: i64,
    msg: String,
}

fn irerr(line: i64, msg: own String) -> IrErr {
    IrErr { line: line, msg: msg }
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_name(s: Str) -> bool {
    let b = s.bytes().to_vec();
    if b.len() == 0 or not (is_alpha(b[0]) or b[0] == b'_') {
        return false;
    }
    for c in b {
        if not (is_alpha(c) or is_digit(c) or c == b'_') {
            return false;
        }
    }
    true
}

fn is_int(s: Str) -> bool {
    let t = s.strip_prefix("-") ?? s;
    if t.len() == 0 {
        return false;
    }
    for c in t.bytes() {
        if not is_digit(c) {
            return false;
        }
    }
    true
}

fn operand(tok: Str, line: i64) -> Result[Opd, IrErr] {
    if is_int(tok) {
        return Ok(mkconst(wrap(i64.parse(tok).unwrap_or(0))));
    }
    if is_name(tok) {
        return Ok(mkvar(tok));
    }
    Err(irerr(line, f"bad operand '{tok}'"))
}

fn split_args(text: Str, line: i64) -> Result[Vec[Opd], IrErr] {
    let t = text.trim();
    let mut out: Vec[Opd] = Vec.new();
    if t.len() == 0 {
        return Ok(out);
    }
    for p in t.split(",") {
        out.push(operand(p.trim(), line)?);
    }
    Ok(out)
}

fn words_of(s: Str) -> Vec[String] {
    s.split_whitespace().map(|w| w.to_string()).collect()
}

fn parse_instr(text: Str, line: i64) -> Result[Instr, IrErr] {
    let words = words_of(text);
    let head = words[0].clone();
    if head == "print" {
        if words.len() != 2 {
            return Err(irerr(line, "print takes one operand".to_string()));
        }
        let mut i = instr(Op.Print, line);
        i.args.push(operand(words[1], line)?);
        return Ok(i);
    }
    if head == "jmp" {
        if words.len() != 2 or not is_name(words[1]) {
            return Err(irerr(line, "jmp takes one label".to_string()));
        }
        return Ok(jmp_to(words[1], line));
    }
    if head == "ret" {
        let mut i = instr(Op.Ret, line);
        if words.len() == 1 {
            return Ok(i);
        }
        if words.len() != 2 {
            return Err(irerr(line, "ret takes at most one operand".to_string()));
        }
        i.args.push(operand(words[1], line)?);
        return Ok(i);
    }
    if head == "br" {
        let rest = text.substring(2);
        let parts: Vec[String] = rest.split(",").map(|p| p.trim().to_string()).collect();
        if parts.len() != 3 or not is_name(parts[1]) or not is_name(parts[2]) {
            return Err(irerr(line, "br takes a condition and two labels".to_string()));
        }
        let mut i = instr(Op.Br, line);
        i.args.push(operand(parts[0], line)?);
        i.labels.push(parts[1].clone());
        i.labels.push(parts[2].clone());
        return Ok(i);
    }
    if head == "call" {
        return parse_call("", text, line);
    }
    if words.len() >= 3 and words[1] == "=" {
        let dst = words[0].clone();
        if not is_name(dst) {
            return Err(irerr(line, f"bad destination '{dst}'"));
        }
        let eq = text.find("=") ?? 0;
        let rhs = text.substring(eq + 1).trim().to_string();
        if rhs.starts_with("call ") {
            return parse_call(dst, rhs, line);
        }
        let r = words_of(rhs);
        if r.len() == 1 {
            return Ok(mov(dst, operand(r[0], line)?, line));
        }
        if r.len() == 3 and is_binop(r[1]) {
            let mut i = instr(Op.Bin, line);
            i.dst = dst;
            i.binop = r[1].clone();
            i.args.push(operand(r[0], line)?);
            i.args.push(operand(r[2], line)?);
            return Ok(i);
        }
        return Err(irerr(line, f"cannot read '{rhs}'"));
    }
    Err(irerr(line, f"unknown instruction '{head}'"))
}

fn parse_call(dst: Str, text: Str, line: i64) -> Result[Instr, IrErr] {
    let rest = text.substring(4).trim().to_string();
    let open = match rest.find("(") {
        Some(k) => k,
        None => -1,
    };
    if open < 0 or not rest.ends_with(")") {
        return Err(irerr(line, "a call is written call f(args)".to_string()));
    }
    let name = rest.substring(0, open).trim().to_string();
    if not is_name(name) {
        return Err(irerr(line, f"bad function name '{name}'"));
    }
    let inner = rest.substring(open + 1, rest.len() - 1);
    let mut i = instr(Op.Call, line);
    i.dst = dst.to_string();
    i.args = split_args(inner, line)?;
    i.func = name;
    Ok(i)
}

fn bad_head(n: i64) -> IrErr {
    irerr(n, "expected 'func name(params) {'".to_string())
}

fn parse(src: Str) -> Result[Vec[Func], IrErr] {
    let mut funcs: Vec[Func] = Vec.new();
    let mut cur = Func { name: String.new(), params: Vec.new(), line: 0, blocks: Vec.new() };
    let mut in_func = false;
    let lines: Vec[String] = src.split("\n").map(|l| l.to_string()).collect();
    for k in 0..lines.len() {
        let n = k + 1;
        let raw = lines[k].clone();
        let code = match raw.find("#") {
            Some(h) => raw.substring(0, h),
            None => raw.clone(),
        };
        let text = code.trim().to_string();
        if text.len() == 0 {
            continue;
        }
        if not in_func {
            if not (text.starts_with("func ") and text.ends_with("{")) {
                return Err(bad_head(n));
            }
            let head = text.substring(5, text.len() - 1).trim().to_string();
            let open = match head.find("(") {
                Some(p) => p,
                None => -1,
            };
            if open < 0 or not head.ends_with(")") {
                return Err(bad_head(n));
            }
            let name = head.substring(0, open).trim().to_string();
            let mut ps: Vec[String] = Vec.new();
            for p in head.substring(open + 1, head.len() - 1).split(",") {
                let q = p.trim();
                if q.len() > 0 {
                    ps.push(q.to_string());
                }
            }
            for p in ps.iter() {
                if not is_name(p) {
                    return Err(irerr(n, f"bad parameter '{p}'"));
                }
            }
            for f in funcs.iter() {
                if f.name == name {
                    return Err(irerr(n, f"function {name} is defined twice"));
                }
            }
            cur = Func { name: name, params: ps, line: n, blocks: Vec.new() };
            in_func = true;
            continue;
        }
        if text == "}" {
            if cur.blocks.len() == 0 {
                let nm = cur.name.clone();
                return Err(irerr(n, f"function {nm} has no blocks"));
            }
            funcs.push(cur.clone());
            in_func = false;
            continue;
        }
        if text.ends_with(":") {
            let label = text.substring(0, text.len() - 1).trim().to_string();
            if not is_name(label) {
                return Err(irerr(n, f"bad label '{label}'"));
            }
            if cur.find(label) >= 0 {
                return Err(irerr(n, f"label {label} is defined twice"));
            }
            cur.blocks.push(Block { name: label, line: n, instrs: Vec.new() });
            continue;
        }
        if cur.blocks.len() == 0 {
            return Err(irerr(n, "an instruction before the first label".to_string()));
        }
        let bk = cur.blocks.len() - 1;
        let ni = cur.blocks[bk].instrs.len();
        if ni > 0 and cur.blocks[bk].instrs[ni - 1].is_term() {
            let bn = cur.blocks[bk].name.clone();
            return Err(irerr(n, f"an instruction after the terminator of block {bn}"));
        }
        let ins = parse_instr(text, n)?;
        cur.blocks[bk].instrs.push(ins);
    }
    if in_func {
        let nm = cur.name.clone();
        return Err(irerr(lines.len(), f"function {nm} is not closed"));
    }
    for f in funcs.iter() {
        for b in f.blocks.iter() {
            if b.instrs.len() == 0 or not b.instrs[b.instrs.len() - 1].is_term() {
                let bn = b.name.clone();
                return Err(irerr(b.line, f"block {bn} has no terminator"));
            }
            let t = b.term();
            for l in t.labels.iter() {
                if f.find(l) < 0 {
                    return Err(irerr(t.line, f"unknown label {l}"));
                }
                if l.clone() == f.blocks[0].name {
                    return Err(irerr(t.line, f"the entry block {l} cannot be a jump target"));
                }
            }
            for i in b.instrs.iter() {
                if i.op == Op.Call {
                    let mut arity = -1;
                    for h in funcs.iter() {
                        if h.name == i.func {
                            arity = h.params.len();
                        }
                    }
                    let fname = i.func.clone();
                    if arity < 0 {
                        return Err(irerr(i.line, f"unknown function {fname}"));
                    }
                    if arity != i.args.len() {
                        let given = i.args.len();
                        return Err(irerr(i.line, f"{fname} takes {arity} argument(s), given {given}"));
                    }
                }
            }
        }
    }
    Ok(funcs)
}

// ------------------------------------------------------------ CFG

// Reachable blocks, their edges, the RPO and the dominator tree. Blocks
// are numbered by their place in the function's layout.
struct Cfg {
    names: Vec[String],
    bix: Map[String, i64],
    reach: Vec[bool],
    lay: Vec[i64],
    succ: Vec[Vec[i64]],
    pred: Vec[Vec[i64]],
    rpo: Vec[i64],
    index: Vec[i64],
    idom: Vec[i64],
    children: Vec[Vec[i64]],
    df: Vec[Vec[i64]],
}

fn build_cfg(f: ref Func) -> Cfg {
    let nb = f.blocks.len();
    let mut c = Cfg {
        names: Vec.new(),
        bix: Map.new(),
        reach: Vec.filled(nb, false),
        lay: Vec.new(),
        succ: Vec.filled(nb, Vec.new()),
        pred: Vec.filled(nb, Vec.new()),
        rpo: Vec.new(),
        index: Vec.filled(nb, -1),
        idom: Vec.filled(nb, -1),
        children: Vec.filled(nb, Vec.new()),
        df: Vec.filled(nb, Vec.new()),
    };
    for k in 0..nb {
        c.names.push(f.blocks[k].name.clone());
        c.bix.insert(f.blocks[k].name.clone(), k);
    }
    let mut all_succ: Vec[Vec[i64]] = Vec.new();
    for k in 0..nb {
        let mut s: Vec[i64] = Vec.new();
        for l in f.blocks[k].succs().iter() {
            s.push(c.bix.get(l.clone()) ?? 0);
        }
        all_succ.push(s);
    }
    // reachable
    let mut stack: Vec[i64] = vec![0];
    while stack.len() > 0 {
        let n = stack.pop() ?? 0;
        if c.reach[n] {
            continue;
        }
        c.reach[n] = true;
        for s in all_succ[n].iter() {
            stack.push(s);
        }
    }
    for k in 0..nb {
        if c.reach[k] {
            c.lay.push(k);
            c.succ[k] = all_succ[k].clone();
        }
    }
    for n in c.lay.clone() {
        for s in c.succ[n].clone() {
            c.pred[s].push(n);
        }
    }
    // reverse post-order
    let mut seen: Vec[bool] = Vec.filled(nb, false);
    let mut post: Vec[i64] = Vec.new();
    dfs_post(c.succ, 0, mut seen, mut post);
    let mut r = post.len() - 1;
    while r >= 0 {
        c.rpo.push(post[r]);
        r -= 1;
    }
    for k in 0..c.rpo.len() {
        c.index[c.rpo[k]] = k;
    }
    c.dominators();
    for k in 1..c.rpo.len() {
        let n = c.rpo[k];
        let d = c.idom[n];
        c.children[d].push(n);
    }
    c.frontiers();
    c
}

fn dfs_post(succ: ref Vec[Vec[i64]], n: i64, seen: mut ref Vec[bool], post: mut ref Vec[i64]) {
    seen[n] = true;
    for s in succ[n].iter() {
        if not seen[s] {
            dfs_post(succ, s, mut seen, mut post);
        }
    }
    post.push(n);
}

impl Cfg {
    fn dominators(mut ref self) {
        let entry = self.rpo[0];
        self.idom[entry] = entry;
        let mut changed = true;
        while changed {
            changed = false;
            for k in 1..self.rpo.len() {
                let b = self.rpo[k];
                let mut new = -1;
                for p in self.pred[b].clone() {
                    if self.idom[p] >= 0 {
                        new = if new < 0 { p } else { self.intersect(p, new) };
                    }
                }
                if self.idom[b] != new {
                    self.idom[b] = new;
                    changed = true;
                }
            }
        }
    }

    fn intersect(ref self, a0: i64, b0: i64) -> i64 {
        let mut a = a0;
        let mut b = b0;
        while a != b {
            while self.index[a] > self.index[b] {
                a = self.idom[a];
            }
            while self.index[b] > self.index[a] {
                b = self.idom[b];
            }
        }
        a
    }

    fn dominates(ref self, a: i64, b0: i64) -> bool {
        let mut b = b0;
        loop {
            if a == b {
                return true;
            }
            if b == self.rpo[0] {
                return false;
            }
            b = self.idom[b];
        }
    }

    fn frontiers(mut ref self) {
        for b in self.rpo.clone() {
            if self.pred[b].len() >= 2 {
                for p in self.pred[b].clone() {
                    let mut r = p;
                    while r != self.idom[b] {
                        if not self.df[r].contains(b) {
                            self.df[r].push(b);
                        }
                        r = self.idom[r];
                    }
                }
            }
        }
        for n in self.rpo.clone() {
            let mut d = self.df[n].clone();
            self.sort_rpo(mut d);
            self.df[n] = d;
        }
    }

    fn sort_rpo(ref self, v: mut ref Vec[i64]) {
        let mut keys: Vec[(i64, i64)] = Vec.new();
        for x in v.iter() {
            keys.push((self.index[x], x));
        }
        keys.sort();
        v.clear();
        for (_, x) in keys {
            v.push(x);
        }
    }

    fn name_list(ref self, v: ref Vec[i64]) -> String {
        let mut out: Vec[String] = Vec.new();
        for x in v.iter() {
            out.push(self.names[x].clone());
        }
        if out.len() == 0 {
            "-".to_string()
        } else {
            out.join(", ")
        }
    }

    fn pred_names(ref self, n: i64) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        for p in self.pred[n].iter() {
            out.push(self.names[p].clone());
        }
        out
    }

    // (header, back-edge tails, body) for each natural loop, in RPO.
    fn loops(ref self) -> Vec[(i64, Vec[i64], Vec[i64])] {
        let mut out: Vec[(i64, Vec[i64], Vec[i64])] = Vec.new();
        for h in self.rpo.iter() {
            let mut tails: Vec[i64] = Vec.new();
            for t in self.pred[h].iter() {
                if self.dominates(h, t) {
                    tails.push(t);
                }
            }
            if tails.len() == 0 {
                continue;
            }
            let mut body: Vec[i64] = vec![h];
            let mut stack = tails.clone();
            while stack.len() > 0 {
                let n = stack.pop() ?? 0;
                if body.contains(n) {
                    continue;
                }
                body.push(n);
                for p in self.pred[n].iter() {
                    stack.push(p);
                }
            }
            self.sort_rpo(mut tails);
            self.sort_rpo(mut body);
            out.push((h, tails, body));
        }
        out
    }
}

// Sorted, duplicate-free name sets.
fn set_of(v: ref Vec[String]) -> Vec[String] {
    let mut s = v.clone();
    s.sort();
    s.dedup();
    s
}

fn set_union(a: ref Vec[String], b: ref Vec[String]) -> Vec[String] {
    let mut s = a.clone();
    for x in b.iter() {
        s.push(x.clone());
    }
    set_of(s)
}

fn set_minus(a: ref Vec[String], b: ref Vec[String]) -> Vec[String] {
    let mut s: Vec[String] = Vec.new();
    for x in a.iter() {
        if not b.contains(x.clone()) {
            s.push(x.clone());
        }
    }
    s
}


// ------------------------------------------------------------ the IR interpreter

fn position(v: ref Vec[String], x: Str) -> i64 {
    for k in 0..v.len() {
        if v[k] == x {
            return k;
        }
    }
    -1
}

struct Prog {
    funcs: Vec[Func],
    fmap: Map[String, i64],
    bmaps: Vec[Map[String, i64]],
}

fn prog(funcs: ref Vec[Func]) -> Prog {
    let mut fmap: Map[String, i64] = Map.new();
    let mut bmaps: Vec[Map[String, i64]] = Vec.new();
    for k in 0..funcs.len() {
        let _ = fmap.insert(funcs[k].name.clone(), k);
        let mut m: Map[String, i64] = Map.new();
        for j in 0..funcs[k].blocks.len() {
            let _ = m.insert(funcs[k].blocks[j].name.clone(), j);
        }
        bmaps.push(m);
    }
    Prog { funcs: funcs.clone(), fmap: fmap, bmaps: bmaps }
}

struct IrMachine {
    steps: i64,
    out: Vec[String],
}

fn ir_read(env: ref Map[String, i64], a: ref Opd) -> i64 {
    if a.kind == OpK.Const {
        return a.val;
    }
    env.get(a.name.clone()) ?? 0
}

fn ir_call(m: mut ref IrMachine, p: ref Prog, name: Str, args: ref Vec[i64], depth: i64) -> Result[i64, String] {
    if depth > DEPTH_LIMIT {
        return Err("call depth limit".to_string());
    }
    let fi = p.fmap.get(name.to_string()) ?? 0;
    let f = ref p.funcs[fi];
    let mut env: Map[String, i64] = Map.new();
    for k in 0..f.params.len() {
        if k < args.len() {
            let _ = env.insert(f.params[k].clone(), args[k]);
        }
    }
    let mut cur: i64 = 0;
    loop {
        let b = ref f.blocks[cur];
        let mut next = String.new();
        for i in b.instrs.iter() {
            m.steps += 1;
            if m.steps > STEP_LIMIT {
                return Err("step limit".to_string());
            }
            match i.op {
                Op.Bin => {
                    match fold(i.binop, ir_read(env, i.args[0]), ir_read(env, i.args[1])) {
                        Some(r) => {
                            let _ = env.insert(i.dst.clone(), r);
                        }
                        None => return Err(f"division by zero in {name}"),
                    }
                }
                Op.Mov => {
                    let v = ir_read(env, i.args[0]);
                    let _ = env.insert(i.dst.clone(), v);
                }
                Op.Call => {
                    let av: Vec[i64] = i.args.iter().map(|a| ir_read(env, a)).collect();
                    let r = ir_call(mut m, p, i.func, av, depth + 1)?;
                    if i.dst.len() > 0 {
                        let _ = env.insert(i.dst.clone(), r);
                    }
                }
                Op.Print => {
                    let v = ir_read(env, i.args[0]);
                    m.out.push(f"{v}");
                }
                Op.Ret => {
                    if i.args.len() > 0 {
                        return Ok(ir_read(env, i.args[0]));
                    }
                    return Ok(0);
                }
                Op.Jmp => {
                    next = i.labels[0].clone();
                    break;
                }
                Op.Br => {
                    next = if ir_read(env, i.args[0]) != 0 { i.labels[0].clone() } else { i.labels[1].clone() };
                    break;
                }
                Op.Phi => {}
            }
        }
        cur = p.bmaps[fi].get(next) ?? 0;
    }
}

// ------------------------------------------------------------ the machine

// Registers: r1..rK are allocated; t0 and t1 are scratch for spilled
// values; a0..a3 carry arguments and the result. Every register is
// caller-saved. A virtual register is a %name.

const MAX_ARGS: i64 = 4;

fn rri(op: Str) -> String {
    let s = match op {
        "+" => "addi",
        "-" => "subi",
        "&" => "andi",
        "|" => "ori",
        "^" => "xori",
        "<<" => "slli",
        ">>" => "srai",
        _ => "",
    };
    s.to_string()
}

fn rrr(op: Str) -> String {
    let s = match op {
        "+" => "add",
        "-" => "sub",
        "*" => "mul",
        "/" => "div",
        "%" => "rem",
        "&" => "and",
        "|" => "or",
        "^" => "xor",
        "<<" => "sll",
        ">>" => "sra",
        "==" => "seq",
        "!=" => "sne",
        "<" => "slt",
        "<=" => "sle",
        ">" => "sgt",
        _ => "sge",
    };
    s.to_string()
}

fn is_rri(mn: Str) -> bool {
    match mn {
        "addi" | "subi" | "andi" | "ori" | "xori" | "slli" | "srai" => true,
        _ => false,
    }
}

// The IR operator a machine mnemonic computes, or "" for one that is not
// arithmetic.
fn binop_of(mn: Str) -> String {
    let s = match mn {
        "add" | "addi" => "+",
        "sub" | "subi" => "-",
        "mul" => "*",
        "div" => "/",
        "rem" => "%",
        "and" | "andi" => "&",
        "or" | "ori" => "|",
        "xor" | "xori" => "^",
        "sll" | "slli" => "<<",
        "sra" | "srai" => ">>",
        "seq" => "==",
        "sne" => "!=",
        "slt" => "<",
        "sle" => "<=",
        "sgt" => ">",
        "sge" => ">=",
        _ => "",
    };
    s.to_string()
}

fn commutes(op: Str) -> bool {
    match op {
        "+" | "*" | "&" | "|" | "^" | "==" | "!=" => true,
        _ => false,
    }
}

#[derive(Copy, Clone, PartialEq, Eq)]
enum RegK {
    Virt,
    Alloc,
    Scratch,
    Arg,
}

// A register operand: a virtual register, or a physical one by name.
#[derive(Clone)]
struct Reg {
    kind: RegK,
    name: String,
}

impl Reg {
    fn show(ref self) -> String {
        if self.kind == RegK.Virt {
            "%" + self.name
        } else {
            self.name.clone()
        }
    }

    fn same(ref self, o: ref Reg) -> bool {
        self.kind == o.kind and self.name == o.name
    }
}

fn vr(n: Str) -> Reg {
    Reg { kind: RegK.Virt, name: n.to_string() }
}

fn ar(k: i64) -> Reg {
    Reg { kind: RegK.Arg, name: f"a{k}" }
}

fn rr(k: i64) -> Reg {
    Reg { kind: RegK.Alloc, name: f"r{k}" }
}

fn tr(k: i64) -> Reg {
    Reg { kind: RegK.Scratch, name: f"t{k}" }
}

// op is a mnemonic. dst and srcs are registers; imm is an immediate or a
// stack slot; label a branch target; func and nargs describe a call.
#[derive(Clone)]
struct MInst {
    op: String,
    has_dst: bool,
    dst: Reg,
    srcs: Vec[Reg],
    imm: i64,
    label: String,
    func: String,
    nargs: i64,
}

fn mi(op: Str) -> MInst {
    MInst {
        op: op.to_string(),
        has_dst: false,
        dst: vr(""),
        srcs: Vec.new(),
        imm: 0,
        label: String.new(),
        func: String.new(),
        nargs: 0,
    }
}

fn mi_d(op: Str, dst: own Reg) -> MInst {
    let mut m = mi(op);
    m.has_dst = true;
    m.dst = dst;
    m
}

fn mi_li(dst: own Reg, v: i64) -> MInst {
    let mut m = mi_d("li", dst);
    m.imm = v;
    m
}

fn mi_mv(dst: own Reg, src: own Reg) -> MInst {
    let mut m = mi_d("mv", dst);
    m.srcs.push(src);
    m
}

fn mi_label(op: Str, label: Str) -> MInst {
    let mut m = mi(op);
    m.label = label.to_string();
    m
}

impl MInst {
    fn show(ref self) -> String {
        let s: Vec[String] = self.srcs.iter().map(|x| x.show()).collect();
        let d = self.dst.show();
        let op = self.op.clone();
        if op == "li" {
            return f"li {d}, {self.imm}";
        }
        if op == "mv" {
            return f"mv {d}, {s[0]}";
        }
        if is_rri(op) {
            return f"{op} {d}, {s[0]}, {self.imm}";
        }
        if binop_of(op).len() > 0 {
            return f"{op} {d}, {s[0]}, {s[1]}";
        }
        if op == "print" {
            return f"print {s[0]}";
        }
        if op == "bnez" or op == "beqz" {
            return f"{op} {s[0]}, {self.label}";
        }
        if op == "j" {
            return f"j {self.label}";
        }
        if op == "call" {
            return f"call {self.func}";
        }
        if op == "ld" {
            return f"ld {d}, [sp+{self.imm}]";
        }
        if op == "st" {
            return f"st {s[0]}, [sp+{self.imm}]";
        }
        op
    }

    fn vdefs(ref self) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        if self.has_dst and self.dst.kind == RegK.Virt {
            out.push(self.dst.name.clone());
        }
        out
    }

    fn vuses(ref self) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        for x in self.srcs.iter() {
            if x.kind == RegK.Virt and not out.contains(x.name.clone()) {
                out.push(x.name.clone());
            }
        }
        out
    }

    fn vall(ref self) -> Vec[String] {
        let mut out = self.vdefs();
        out.extend(self.vuses());
        out
    }
}

#[derive(Clone)]
struct MBlock {
    name: String,
    succs: Vec[String],
    code: Vec[MInst],
}

#[derive(Clone)]
struct MFunc {
    name: String,
    nparams: i64,
    blocks: Vec[MBlock],
    frame: i64,
    depth: Map[String, i64],
}

impl MFunc {
    fn show(ref self) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        out.push(f"{self.name}:  # frame {self.frame}");
        for b in self.blocks.iter() {
            out.push(f".{b.name}:");
            for m in b.code.iter() {
                out.push("  " + m.show());
            }
        }
        out
    }

    fn find(ref self, name: Str) -> i64 {
        for k in 0..self.blocks.len() {
            if self.blocks[k].name == name {
                return k;
            }
        }
        -1
    }
}

// ------------------------------------------------------------ instruction selection

struct Selector {
    k: i64,
}

impl Selector {
    fn constant(mut ref self, code: mut ref Vec[MInst], v: i64) -> Reg {
        let r = vr(f"c.{self.k}");
        self.k += 1;
        code.push(mi_li(r.clone(), v));
        r
    }

    fn reg(mut ref self, code: mut ref Vec[MInst], a: ref Opd) -> Reg {
        if a.kind == OpK.Const {
            return self.constant(mut code, a.val);
        }
        vr(a.name)
    }
}

fn arg_into(code: mut ref Vec[MInst], k: i64, a: ref Opd) {
    if a.kind == OpK.Const {
        code.push(mi_li(ar(k), a.val));
    } else {
        code.push(mi_mv(ar(k), vr(a.name)));
    }
}

// Machine code over virtual registers. Unreachable blocks are dropped, as
// a back end does.
fn select(f: ref Func) -> Result[MFunc, IrErr] {
    let cfg = build_cfg(f);
    let mut blocks: Vec[Block] = Vec.new();
    let mut bsucc: Vec[Vec[String]] = Vec.new();
    for k in 0..f.blocks.len() {
        if cfg.reach[k] {
            blocks.push(f.blocks[k].clone());
            let ss: Vec[String] = cfg.succ[k].iter().map(|s| cfg.names[s].clone()).collect();
            bsucc.push(ss);
        }
    }
    let np = f.params.len();
    if np > MAX_ARGS {
        let fname = f.name.clone();
        return Err(irerr(f.line, f"{fname} has {np} parameters; the calling convention passes at most {MAX_ARGS}"));
    }
    let mut m = MFunc { name: f.name.clone(), nparams: np, blocks: Vec.new(), frame: 0, depth: Map.new() };
    let mut sel = Selector { k: 0 };
    for n in 0..blocks.len() {
        let b = ref blocks[n];
        let mut code: Vec[MInst] = Vec.new();
        if n == 0 {
            for k in 0..f.params.len() {
                code.push(mi_mv(vr(f.params[k]), ar(k)));
            }
        }
        let nxt = if n + 1 < blocks.len() { blocks[n + 1].name.clone() } else { String.new() };
        for i in b.instrs.iter() {
            if i.op == Op.Bin {
                let mut x = i.args[0].clone();
                let mut y = i.args[1].clone();
                let op = i.binop.clone();
                if x.kind == OpK.Const and y.kind != OpK.Const and commutes(op) {
                    x, y = y, x;
                }
                if y.kind == OpK.Const and rri(op).len() > 0 {
                    let mut ins = mi_d(rri(op), vr(i.dst));
                    ins.srcs.push(sel.reg(mut code, x));
                    ins.imm = y.val;
                    code.push(ins);
                } else {
                    let rx = sel.reg(mut code, x);
                    let ry = sel.reg(mut code, y);
                    let mut ins = mi_d(rrr(op), vr(i.dst));
                    ins.srcs.push(rx);
                    ins.srcs.push(ry);
                    code.push(ins);
                }
            } else if i.op == Op.Mov {
                let a = ref i.args[0];
                if a.kind == OpK.Const {
                    code.push(mi_li(vr(i.dst), a.val));
                } else {
                    code.push(mi_mv(vr(i.dst), vr(a.name)));
                }
            } else if i.op == Op.Call {
                let na = i.args.len();
                if na > MAX_ARGS {
                    let fname = i.func.clone();
                    return Err(irerr(i.line, f"call {fname} passes {na} arguments; the calling convention passes at most {MAX_ARGS}"));
                }
                for k in 0..na {
                    arg_into(mut code, k, i.args[k]);
                }
                let mut c = mi("call");
                c.func = i.func.clone();
                c.nargs = na;
                code.push(c);
                if i.dst.len() > 0 {
                    code.push(mi_mv(vr(i.dst), ar(0)));
                }
            } else if i.op == Op.Print {
                let mut p = mi("print");
                p.srcs.push(sel.reg(mut code, i.args[0]));
                code.push(p);
            } else if i.op == Op.Ret {
                if i.args.len() > 0 {
                    arg_into(mut code, 0, i.args[0]);
                } else {
                    // a bare ret returns 0, as the IR defines it
                    code.push(mi_li(ar(0), 0));
                }
                code.push(mi("ret"));
            } else if i.op == Op.Jmp {
                if i.labels[0] != nxt {
                    code.push(mi_label("j", i.labels[0]));
                }
            } else if i.op == Op.Br {
                let c = sel.reg(mut code, i.args[0]);
                let t = i.labels[0].clone();
                let e = i.labels[1].clone();
                if t == e {
                    if t != nxt {
                        code.push(mi_label("j", t));
                    }
                } else if t == nxt {
                    let mut ins = mi_label("beqz", e);
                    ins.srcs.push(c);
                    code.push(ins);
                } else {
                    let mut ins = mi_label("bnez", t);
                    ins.srcs.push(c);
                    code.push(ins);
                    if e != nxt {
                        code.push(mi_label("j", e));
                    }
                }
            }
        }
        m.blocks.push(MBlock { name: b.name.clone(), succs: bsucc[n].clone(), code: code });
    }
    // a name read before any assignment reaches it reads 0, as in the IR
    let (li, _) = mliveness(m);
    let mut zero: Vec[MInst] = Vec.new();
    for v in li[0].iter() {
        zero.push(mi_li(vr(v), 0));
    }
    zero.extend(m.blocks[0].code.clone());
    m.blocks[0].code = zero;
    let loops = cfg.loops();
    for b in m.blocks.iter() {
        let bk = cfg.bix.get(b.name.clone()) ?? 0;
        let mut d = 0;
        for (_, _, body) in loops.iter() {
            if body.contains(bk) {
                d += 1;
            }
        }
        let _ = m.depth.insert(b.name.clone(), d);
    }
    Ok(m)
}

// ------------------------------------------------------------ liveness

fn block_index(m: ref MFunc) -> Map[String, i64] {
    let mut ix: Map[String, i64] = Map.new();
    for k in 0..m.blocks.len() {
        let _ = ix.insert(m.blocks[k].name.clone(), k);
    }
    ix
}

// Live-in and live-out of each block, by layout position, as sorted sets.
fn mliveness(m: ref MFunc) -> (Vec[Vec[String]], Vec[Vec[String]]) {
    let nb = m.blocks.len();
    let ix = block_index(m);
    let mut uses: Vec[Vec[String]] = Vec.new();
    let mut defs: Vec[Vec[String]] = Vec.new();
    for b in m.blocks.iter() {
        let mut u: Vec[String] = Vec.new();
        let mut d: Vec[String] = Vec.new();
        for i in b.code.iter() {
            for x in i.vuses().iter() {
                if not d.contains(x.clone()) and not u.contains(x.clone()) {
                    u.push(x.clone());
                }
            }
            for x in i.vdefs().iter() {
                if not d.contains(x.clone()) {
                    d.push(x.clone());
                }
            }
        }
        uses.push(set_of(u));
        defs.push(set_of(d));
    }
    let mut live_in: Vec[Vec[String]] = Vec.filled(nb, Vec.new());
    let mut live_out: Vec[Vec[String]] = Vec.filled(nb, Vec.new());
    let mut changed = true;
    while changed {
        changed = false;
        let mut n = nb - 1;
        while n >= 0 {
            let mut out: Vec[String] = Vec.new();
            for s in m.blocks[n].succs.iter() {
                let sk = ix.get(s.clone()) ?? 0;
                out = set_union(out, live_in[sk]);
            }
            let inn = set_union(uses[n], set_minus(out, defs[n]));
            if out != live_out[n] or inn != live_in[n] {
                live_out[n] = out;
                live_in[n] = inn;
                changed = true;
            }
            n -= 1;
        }
    }
    (live_in, live_out)
}

#[derive(Copy, Clone)]
struct Iv {
    s: i64,
    e: i64,
}

struct Intervals {
    iv: Map[String, Iv],
    calls: Vec[(i64, Vec[String])],
}

fn extend(iv: mut ref Map[String, Iv], v: Str, p: i64) {
    let cur = match iv.get(v.to_string()) {
        Some(x) => Iv { s: imin(x.s, p), e: imax(x.e, p) },
        None => Iv { s: p, e: p },
    };
    let _ = iv.insert(v.to_string(), cur);
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b {
        a
    } else {
        b
    }
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b {
        a
    } else {
        b
    }
}

// Linear positions: instruction k of the layout reads at 2k and writes at
// 2k+1.
fn intervals(m: ref MFunc) -> Intervals {
    let (_, lo) = mliveness(m);
    let mut iv: Map[String, Iv] = Map.new();
    let mut calls: Vec[(i64, Vec[String])] = Vec.new();
    let mut base = 0;
    for bk in 0..m.blocks.len() {
        let b = ref m.blocks[bk];
        let mut live = lo[bk].clone();
        let last = base + b.code.len() - 1;
        for v in live.iter() {
            extend(mut iv, v, 2 * last + 1);
        }
        let mut k = b.code.len() - 1;
        while k >= 0 {
            let i = ref b.code[k];
            let p = base + k;
            for d in i.vdefs().iter() {
                extend(mut iv, d, 2 * p + 1);
                live.retain(|x| x != d);
            }
            if i.op == "call" {
                calls.push((2 * p, set_of(live)));
            }
            for u in i.vuses().iter() {
                if not live.contains(u.clone()) {
                    live.push(u.clone());
                }
            }
            for v in live.iter() {
                extend(mut iv, v, 2 * p);
            }
            k -= 1;
        }
        base += b.code.len();
    }
    Intervals { iv: iv, calls: calls }
}

// Each virtual register's neighbours, in name order.
fn interference(m: ref MFunc) -> Map[String, Vec[String]] {
    let (_, lo) = mliveness(m);
    let mut edges: Map[String, Vec[String]] = Map.new();
    for b in m.blocks.iter() {
        for i in b.code.iter() {
            for v in i.vall().iter() {
                if not edges.contains_key(v.clone()) {
                    let _ = edges.insert(v.clone(), Vec.new());
                }
            }
        }
    }
    for bk in 0..m.blocks.len() {
        let b = ref m.blocks[bk];
        let mut live = lo[bk].clone();
        let mut k = b.code.len() - 1;
        while k >= 0 {
            let i = ref b.code[k];
            let src = if i.op == "mv" and i.srcs[0].kind == RegK.Virt { i.srcs[0].name.clone() } else { String.new() };
            for d in i.vdefs().iter() {
                for v in live.iter() {
                    if v != d and v.clone() != src {
                        add_edge(mut edges, d, v);
                        add_edge(mut edges, v, d);
                    }
                }
                live.retain(|x| x != d);
            }
            for u in i.vuses().iter() {
                if not live.contains(u.clone()) {
                    live.push(u.clone());
                }
            }
            k -= 1;
        }
    }
    let keys: Vec[String] = edges.keys().map(|k| k.clone()).collect();
    for k in keys.iter() {
        if let Some(v) = edges.get_mut(k.clone()) {
            v.sort();
        }
    }
    edges
}

fn add_edge(edges: mut ref Map[String, Vec[String]], a: Str, b: Str) {
    if let Some(v) = edges.get_mut(a.to_string()) {
        if not v.contains(b.to_string()) {
            v.push(b.to_string());
        }
    }
}

fn spill_costs(m: ref MFunc) -> Map[String, i64] {
    let mut cost: Map[String, i64] = Map.new();
    for b in m.blocks.iter() {
        let mut w = 1;
        for _ in 0..(m.depth.get(b.name.clone()) ?? 0) {
            w *= 10;
        }
        for i in b.code.iter() {
            for v in i.vall().iter() {
                let c = cost.get(v.clone()) ?? 0;
                let _ = cost.insert(v.clone(), c + w);
            }
        }
    }
    cost
}

// ------------------------------------------------------------ the two allocators

// Where a virtual register lives: register r<n>, or stack slot n.
#[derive(Copy, Clone)]
struct Loc {
    slot: bool,
    n: i64,
}

fn in_reg(n: i64) -> Loc {
    Loc { slot: false, n: n }
}

fn in_slot(n: i64) -> Loc {
    Loc { slot: true, n: n }
}

fn iv_of(iv: ref Map[String, Iv], v: Str) -> Iv {
    iv.get(v.to_string()) ?? Iv { s: 0, e: 0 }
}

fn insert_active(active: mut ref Vec[String], v: Str, iv: ref Map[String, Iv]) {
    let ve = iv_of(iv, v).e;
    let mut k = 0;
    while k < active.len() {
        let ae = iv_of(iv, active[k]).e;
        if ae < ve or (ae == ve and active[k] < v) {
            k += 1;
        } else {
            break;
        }
    }
    active.insert(k, v.to_string());
}

// Poletto and Sarkar's linear scan: intervals by start; at each one,
// expire those ended, and when all K registers are taken spill whichever
// of it and the active intervals ends last.
fn linear_scan(m: ref MFunc, k_regs: i64) -> (Map[String, Loc], i64) {
    let ivs = intervals(m);
    let iv = ivs.iv;
    let mut order: Vec[(i64, String)] = Vec.new();
    for (v, x) in iv.iter() {
        order.push((x.s, v.clone()));
    }
    order.sort();
    let mut active: Vec[String] = Vec.new();
    let mut free: Vec[i64] = Vec.new();
    for r in 1..(k_regs + 1) {
        free.push(r);
    }
    let mut loc: Map[String, Loc] = Map.new();
    let mut slots = 0;
    for (s, v) in order.iter() {
        let e = iv_of(iv, v).e;
        while active.len() > 0 and iv_of(iv, active[0]).e < s {
            let j = active.remove(0);
            free.push((loc.get(j) ?? in_reg(0)).n);
            free.sort();
        }
        if active.len() == k_regs {
            let spill = active[active.len() - 1].clone();
            if iv_of(iv, spill).e > e {
                let r = loc.get(spill.clone()) ?? in_reg(0);
                let _ = loc.insert(v.clone(), r);
                let _ = loc.insert(spill, in_slot(slots));
                slots += 1;
                let _ = active.pop();
                insert_active(mut active, v, iv);
            } else {
                let _ = loc.insert(v.clone(), in_slot(slots));
                slots += 1;
            }
        } else {
            let r = free.remove(0);
            let _ = loc.insert(v.clone(), in_reg(r));
            insert_active(mut active, v, iv);
        }
    }
    (loc, slots)
}

// Chaitin's simplify with Briggs's optimistic colouring: remove a node of
// degree < K while there is one, else the cheapest per neighbour; then
// colour in reverse, spilling a node only when no colour is left.
fn colour(m: ref MFunc, k_regs: i64) -> (Map[String, Loc], i64) {
    let edges = interference(m);
    let cost = spill_costs(m);
    let mut names: Vec[String] = edges.keys().map(|k| k.clone()).collect();
    names.sort();
    let n = names.len();
    let mut ix: Map[String, i64] = Map.new();
    for k in 0..n {
        let _ = ix.insert(names[k].clone(), k);
    }
    let mut adj: Vec[Vec[i64]] = Vec.new();
    let mut deg: Vec[i64] = Vec.new();
    let mut cst: Vec[i64] = Vec.new();
    for k in 0..n {
        let ns = edges.get(names[k].clone()).cloned() ?? Vec.new();
        let a: Vec[i64] = ns.iter().map(|u| ix.get(u.clone()) ?? 0).collect();
        deg.push(a.len());
        adj.push(a);
        cst.push(cost.get(names[k].clone()) ?? 0);
    }
    let mut left: Vec[bool] = Vec.filled(n, true);
    let mut remaining = n;
    let mut stack: Vec[i64] = Vec.new();
    while remaining > 0 {
        let mut pick = -1;
        for v in 0..n {
            if left[v] and deg[v] < k_regs {
                pick = v;
                break;
            }
        }
        if pick < 0 {
            for v in 0..n {
                if left[v] and (pick < 0 or cst[v] * deg[pick] < cst[pick] * deg[v]) {
                    pick = v;
                }
            }
        }
        stack.push(pick);
        left[pick] = false;
        remaining -= 1;
        for u in adj[pick].iter() {
            if left[u] {
                deg[u] -= 1;
            }
        }
    }
    let mut colour_of: Vec[i64] = Vec.filled(n, -1);
    let mut loc: Map[String, Loc] = Map.new();
    let mut slots = 0;
    let mut s = stack.len() - 1;
    while s >= 0 {
        let v = stack[s];
        let mut used: Vec[bool] = Vec.filled(k_regs + 1, false);
        for u in adj[v].iter() {
            if colour_of[u] > 0 {
                used[colour_of[u]] = true;
            }
        }
        let mut c = -1;
        for r in 1..(k_regs + 1) {
            if not used[r] {
                c = r;
                break;
            }
        }
        if c < 0 {
            let _ = loc.insert(names[v].clone(), in_slot(slots));
            slots += 1;
        } else {
            colour_of[v] = c;
            let _ = loc.insert(names[v].clone(), in_reg(c));
        }
        s -= 1;
    }
    (loc, slots)
}

// ------------------------------------------------------------ rewriting

struct Stats {
    spilled: i64,
    loads: i64,
    stores: i64,
    saves: i64,
    moves: i64,
    size: i64,
}

fn loc_of(loc: ref Map[String, Loc], v: Str) -> Loc {
    loc.get(v.to_string()) ?? in_reg(0)
}

// Physical registers for every operand: a spilled value is loaded into t0
// or t1 before a use and stored after a definition; a register live across
// a call is saved before it and restored after; a move between one
// register and itself goes.
fn rewrite(m: ref MFunc, loc: ref Map[String, Loc], slots: i64, k_regs: i64) -> (MFunc, Stats) {
    let ivs = intervals(m);
    let mut across: Map[i64, Vec[String]] = Map.new();
    for (p, live) in ivs.calls.iter() {
        let _ = across.insert(p, live.clone());
    }
    let mut st = Stats { spilled: slots, loads: 0, stores: 0, saves: 0, moves: 0, size: 0 };
    let mut saved = false;
    let mut out = MFunc { name: m.name.clone(), nparams: m.nparams, blocks: Vec.new(), frame: 0, depth: Map.new() };
    let mut base = 0;
    for b in m.blocks.iter() {
        let mut code: Vec[MInst] = Vec.new();
        for k in 0..b.code.len() {
            let i = ref b.code[k];
            let p = base + k;
            let mut pre: Vec[MInst] = Vec.new();
            let mut post: Vec[MInst] = Vec.new();
            let mut srcs: Vec[Reg] = Vec.new();
            let mut tnames: Vec[String] = Vec.new();
            for x in i.srcs.iter() {
                if x.kind != RegK.Virt {
                    srcs.push(x.clone());
                    continue;
                }
                let l = loc_of(loc, x.name);
                if l.slot {
                    let t = position(tnames, x.name);
                    if t >= 0 {
                        srcs.push(tr(t));
                    } else {
                        let nt = tnames.len();
                        let mut ld = mi_d("ld", tr(nt));
                        ld.imm = l.n;
                        pre.push(ld);
                        st.loads += 1;
                        tnames.push(x.name.clone());
                        srcs.push(tr(nt));
                    }
                } else {
                    srcs.push(rr(l.n));
                }
            }
            let mut dst = i.dst.clone();
            if i.has_dst and dst.kind == RegK.Virt {
                let l = loc_of(loc, dst.name);
                if l.slot {
                    let mut s = mi("st");
                    s.srcs.push(tr(0));
                    s.imm = l.n;
                    post.push(s);
                    st.stores += 1;
                    dst = tr(0);
                } else {
                    dst = rr(l.n);
                }
            }
            if i.op == "call" {
                let live = across.get(2 * p).cloned() ?? Vec.new();
                let mut regs: Vec[i64] = Vec.new();
                for v in live.iter() {
                    let l = loc_of(loc, v);
                    if not l.slot and not regs.contains(l.n) {
                        regs.push(l.n);
                    }
                }
                regs.sort();
                for r in regs.iter() {
                    saved = true;
                    let mut s = mi("st");
                    s.srcs.push(rr(r));
                    s.imm = slots + r - 1;
                    pre.push(s);
                    let mut l = mi_d("ld", rr(r));
                    l.imm = slots + r - 1;
                    post.push(l);
                    st.saves += 1;
                }
            }
            let mut ni = i.clone();
            ni.dst = dst;
            ni.srcs = srcs;
            code.extend(pre);
            if ni.op == "mv" and ni.dst.same(ni.srcs[0]) {
                st.moves += 1;
            } else {
                code.push(ni);
            }
            code.extend(post);
        }
        base += b.code.len();
        st.size += code.len();
        out.blocks.push(MBlock { name: b.name.clone(), succs: b.succs.clone(), code: code });
    }
    out.frame = slots + (if saved { k_regs } else { 0 });
    (out, st)
}

fn allocate(f: ref Func, k_regs: i64, how: Str) -> Result[(Map[String, Loc], MFunc, Stats), IrErr] {
    let m = select(f)?;
    let (loc, slots) = if how == "linear" { linear_scan(m, k_regs) } else { colour(m, k_regs) };
    let (mf, st) = rewrite(m, loc, slots, k_regs);
    Ok((loc, mf, st))
}

// ------------------------------------------------------------ the simulator

struct Sim {
    funcs: Vec[MFunc],
    fmap: Map[String, i64],
    bmaps: Vec[Map[String, i64]],
    regs: Map[String, i64],
    steps: i64,
    mem: i64,
    out: Vec[String],
}

fn new_sim(funcs: own Vec[MFunc]) -> Sim {
    let mut fmap: Map[String, i64] = Map.new();
    let mut bmaps: Vec[Map[String, i64]] = Vec.new();
    for k in 0..funcs.len() {
        let _ = fmap.insert(funcs[k].name.clone(), k);
        bmaps.push(block_index(funcs[k]));
    }
    Sim { funcs: funcs, fmap: fmap, bmaps: bmaps, regs: Map.new(), steps: 0, mem: 0, out: Vec.new() }
}

impl Sim {
    fn get(ref self, r: ref Reg) -> i64 {
        self.regs.get(r.name.clone()) ?? 0
    }

    fn set(mut ref self, r: ref Reg, v: i64) {
        let _ = self.regs.insert(r.name.clone(), v);
    }

    fn call(mut ref self, name: Str, depth: i64) -> Result[i64, String] {
        if depth > DEPTH_LIMIT {
            return Err("call depth limit".to_string());
        }
        let fi = self.fmap.get(name.to_string()) ?? 0;
        let f = self.funcs[fi].clone();
        let mut frame: Vec[i64] = Vec.filled(f.frame, 0);
        let mut bi: i64 = 0;
        loop {
            let b = ref f.blocks[bi];
            let mut jumped = String.new();
            for i in b.code.iter() {
                self.steps += 1;
                if self.steps > 4 * STEP_LIMIT {
                    return Err("step limit".to_string());
                }
                let op = i.op.clone();
                let bop = binop_of(op);
                if op == "li" {
                    self.set(i.dst, i.imm);
                } else if op == "mv" {
                    let v = self.get(i.srcs[0]);
                    self.set(i.dst, v);
                } else if bop.len() > 0 {
                    let a = self.get(i.srcs[0]);
                    let c = if is_rri(op) { i.imm } else { self.get(i.srcs[1]) };
                    match fold(bop, a, c) {
                        Some(r) => self.set(i.dst, r),
                        None => return Err(f"division by zero in {name}"),
                    }
                } else if op == "print" {
                    let v = self.get(i.srcs[0]);
                    self.out.push(f"{v}");
                } else if op == "bnez" or op == "beqz" {
                    if (self.get(i.srcs[0]) != 0) == (op == "bnez") {
                        jumped = i.label.clone();
                        break;
                    }
                } else if op == "j" {
                    jumped = i.label.clone();
                    break;
                } else if op == "call" {
                    let _ = self.call(i.func, depth + 1)?;
                } else if op == "ret" {
                    return Ok(self.regs.get("a0".to_string()) ?? 0);
                } else if op == "ld" {
                    self.mem += 1;
                    self.set(i.dst, frame[i.imm]);
                } else if op == "st" {
                    self.mem += 1;
                    frame[i.imm] = self.get(i.srcs[0]);
                }
            }
            bi = if jumped.len() > 0 { self.bmaps[fi].get(jumped) ?? 0 } else { bi + 1 };
        }
    }
}

// ------------------------------------------------------------ jobs

fn fmt_loc(l: Loc) -> String {
    if l.slot {
        f"[sp+{l.n}]"
    } else {
        f"r{l.n}"
    }
}

fn fmt_stats(st: ref Stats) -> String {
    f"; spilled {st.spilled}, loads {st.loads}, stores {st.stores}, saves {st.saves}, moves removed {st.moves}, size {st.size}"
}

fn err_line(fname: Str, e: ref IrErr) -> String {
    f"{fname}:{e.line}: error: {e.msg}"
}

fn run_mode(funcs: ref Vec[Func], rest: ref Vec[String], fname: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if rest.len() == 0 {
        out.push(f"{fname}: error: run needs a function");
        return out;
    }
    let name = rest[0].clone();
    let k_regs = if rest.len() > 1 { i64.parse(rest[1]).unwrap_or(4) } else { 4 };
    let mut args: Vec[i64] = Vec.new();
    for k in 2..rest.len() {
        args.push(wrap(i64.parse(rest[k]).unwrap_or(0)));
    }
    let mut np = -1;
    for h in funcs.iter() {
        if h.name == name {
            np = h.params.len();
        }
    }
    if np < 0 {
        out.push(f"{fname}: error: no function {name}");
        return out;
    }
    if args.len() != np {
        let given = args.len();
        out.push(f"{fname}: error: {name} takes {np} argument(s), given {given}");
        return out;
    }
    let p = prog(funcs);
    let mut ir = IrMachine { steps: 0, out: Vec.new() };
    let res = match ir_call(mut ir, p, name, args, 0) {
        Ok(r) => f"returned {r}",
        Err(t) => f"trap: {t}",
    };
    let mut line = f"ir: {res} after {ir.steps} steps";
    if ir.out.len() > 0 {
        line = line + "; printed " + ir.out.join(" ");
    }
    out.push(line);
    for how in ["linear", "colour"].to_vec() {
        let mut mfs: Vec[MFunc] = Vec.new();
        for f in funcs.iter() {
            match allocate(f, k_regs, how) {
                Ok((_, mf, _)) => mfs.push(mf),
                Err(e) => {
                    out.push(err_line(fname, e));
                    return out;
                }
            }
        }
        let mut sim = new_sim(mfs);
        for k in 0..args.len() {
            let _ = sim.regs.insert(f"a{k}", args[k]);
        }
        let mres = match sim.call(name, 0) {
            Ok(r) => f"returned {r}",
            Err(t) => f"trap: {t}",
        };
        let mut l2 = f"{how}: {mres} after {sim.steps} instructions, {sim.mem} memory";
        if sim.out.len() > 0 {
            l2 = l2 + "; printed " + sim.out.join(" ");
        }
        out.push(l2);
        if mres != res or sim.out != ir.out {
            out.push(f"MISMATCH: {how} differs from the IR");
        }
    }
    out
}

fn run_job(mode: Str, rest: ref Vec[String], fname: Str, src: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let funcs = match parse(src) {
        Ok(fs) => fs,
        Err(e) => {
            out.push(err_line(fname, e));
            return out;
        }
    };
    if mode == "run" {
        return run_mode(funcs, rest, fname);
    }
    if funcs.len() == 0 {
        out.push(f"{fname}: error: no functions");
        return out;
    }
    let target = if rest.len() > 0 { rest[0].clone() } else { funcs[0].name.clone() };
    let mut fi = -1;
    for k in 0..funcs.len() {
        if funcs[k].name == target {
            fi = k;
        }
    }
    if fi < 0 {
        out.push(f"{fname}: error: no function {target}");
        return out;
    }
    let f = ref funcs[fi];
    let m = match select(f) {
        Ok(m) => m,
        Err(e) => {
            out.push(err_line(fname, e));
            return out;
        }
    };
    if mode == "sel" {
        return m.show();
    }
    if mode == "live" {
        let ivs = intervals(m);
        let mut order: Vec[(i64, String)] = Vec.new();
        for (v, x) in ivs.iv.iter() {
            order.push((x.s, v.clone()));
        }
        order.sort();
        for (_, v) in order.iter() {
            let x = iv_of(ivs.iv, v);
            out.push(f"%{v}: [{x.s}, {x.e}]");
        }
        for (p, live) in ivs.calls.iter() {
            let names: Vec[String] = live.iter().map(|v| "%" + v).collect();
            let ls = if names.len() > 0 { names.join(", ") } else { "-".to_string() };
            out.push(f"call at {p}: live across {ls}");
        }
        return out;
    }
    if mode == "graph" {
        let edges = interference(m);
        let cost = spill_costs(m);
        let mut names: Vec[String] = edges.keys().map(|k| k.clone()).collect();
        names.sort();
        for v in names.iter() {
            let ns = edges.get(v.clone()).cloned() ?? Vec.new();
            let shown: Vec[String] = ns.iter().map(|u| "%" + u).collect();
            let list = if shown.len() > 0 { shown.join(", ") } else { "-".to_string() };
            let c = cost.get(v.clone()) ?? 0;
            let d = ns.len();
            out.push(f"%{v}: degree {d}, cost {c}; {list}");
        }
        return out;
    }
    if mode == "linear" or mode == "colour" {
        let k_regs = if rest.len() > 1 { i64.parse(rest[1]).unwrap_or(4) } else { 4 };
        match allocate(f, k_regs, mode) {
            Ok((loc, mf, st)) => {
                let mut names: Vec[String] = loc.keys().map(|k| k.clone()).collect();
                names.sort();
                let parts: Vec[String] = names.iter().map(|v| f"%{v} " + fmt_loc(loc_of(loc, v))).collect();
                out.push("; " + parts.join(", "));
                out.extend(mf.show());
                out.push(fmt_stats(st));
            }
            Err(e) => out.push(err_line(fname, e)),
        }
        return out;
    }
    if mode == "compare" {
        for k_regs in [2, 3, 4, 6, 8].to_vec() {
            for how in ["linear", "colour"].to_vec() {
                if let Ok((_, _, st)) = allocate(f, k_regs, how) {
                    out.push(f"K={k_regs} {how}: spilled {st.spilled}, loads {st.loads}, stores {st.stores}, saves {st.saves}, size {st.size}");
                }
            }
        }
        return out;
    }
    out.push(f"unknown mode {mode}");
    out
}
fn unescape(s: Str) -> String {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'\\' and i + 1 < b.len() {
            let c = b[i + 1];
            out.push(if c == b'n' { b'\n' } else if c == b't' { b'\t' } else { c });
            i += 2;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    String.from_utf8(out).unwrap_or(String.new())
}

fn transcript(job: String) -> String {
    let mut out: Vec[String] = Vec.new();
    out.push("$ " + job);
    let words: Vec[String] = job.split(" ").map(|w| w.to_string()).collect();
    if words[0] == "snip" {
        let mode = if words.len() > 1 { words[1].clone() } else { String.new() };
        let skip = 5 + mode.len() + 1;
        let mut src = unescape(job.substring(skip));
        let mut rest: Vec[String] = Vec.new();
        if let Some((a, b)) = src.clone().split_once(" ;; ") {
            rest = b.split(" ").map(|w| w.to_string()).collect();
            src = a.to_string();
        }
        out.extend(run_job(mode, rest, "snip.ir", src));
    } else {
        let mode = words[0].clone();
        let name = if words.len() > 1 { words[1].clone() } else { String.new() };
        let mut rest: Vec[String] = Vec.new();
        for k in 2..words.len() {
            rest.push(words[k].clone());
        }
        match fs.read_to_string("data/" + name) {
            Ok(src) => out.extend(run_job(mode, rest, name, src)),
            Err(e) => out.push(f"! cannot read {name}: {e}"),
        }
    }
    out.join("\n") + "\n"
}

fn is_hexd(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in jobs.split("\n") {
        let t = l.strip_suffix("\r") ?? l;
        if t.trim().len() > 0 {
            lines.push(t.to_string());
        }
    }
    // Every job in a task of its own; the transcript prints in job order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for line in lines {
        handles.push(group.spawn(|| transcript(line)));
    }
    for h in handles.into_iter() {
        print(h.join());
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/abi.ir", unhex(file_0()))?;
    put_bytes("data/arith.ir", unhex(file_1()))?;
    put_bytes("data/calls.ir", unhex(file_2()))?;
    put_bytes("data/jobs.txt", unhex(file_3()))?;
    put_bytes("data/loops.ir", unhex(file_4()))?;
    put_bytes("data/pressure.ir", unhex(file_5()))?;
    put_bytes("data/swap.ir", unhex(file_6()))?;
    Ok(())
}

