%neg: degree 1, cost 2; %n
%r: degree 1, cost 5; %big
%zero: degree 1, cost 2; %n
$ sel loops.ir grid
grid:  # frame 0
.entry:
  mv %n, a0
  li %total, 0
  li %i, 0
.outer:
  slt %ci, %i, %n
  beqz %ci, done
.init:
  li %j, 0
.inner:
  slt %cj, %j, %n
  beqz %cj, next
.cell:
  mul %p, %i, %j
  add %total, %total, %p
  addi %j, %j, 1
  j inner
.next:
  addi %i, %i, 1
  j outer
.done:
  mv a0, %total
  ret
