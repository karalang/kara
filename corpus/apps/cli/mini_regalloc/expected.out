$ sel pressure.ir accum
accum:  # frame 0
.entry:
  mv %n, a0
  li %s0, 0
  li %s1, 0
  li %s2, 0
  li %s3, 0
  li %s4, 0
  li %s5, 0
  li %i, 0
.loop:
  slt %c, %i, %n
  beqz %c, done
.body:
  add %s0, %s0, %i
  mul %t, %i, %i
  add %s1, %s1, %t
  mul %t, %t, %i
  xor %s2, %s2, %t
  addi %s3, %s3, 1
  sub %s4, %s4, %i
  andi %m, %i, 3
  add %s5, %s5, %m
  addi %i, %i, 1
  j loop
.done:
  print %s0
  print %s1
  print %s2
  print %s3
  print %s4
  print %s5
  add %r, %s0, %s1
  add %r, %r, %s2
  add %r, %r, %s3
  add %r, %r, %s4
  add %r, %r, %s5
  mv a0, %r
  ret
