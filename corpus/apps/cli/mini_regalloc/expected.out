$ sel calls.ir ack
ack:  # frame 0
.entry:
  mv %m, a0
  mv %n, a1
  li %c.0, 0
  seq %mz, %m, %c.0
  beqz %mz, inner
.base:
  addi %r, %n, 1
  mv a0, %r
  ret
.inner:
  li %c.1, 0
  seq %nz, %n, %c.1
  beqz %nz, both
.down:
  subi %m1, %m, 1
  mv a0, %m1
  li a1, 1
  call ack
  mv %r, a0
  mv a0, %r
  ret
.both:
  subi %n1, %n, 1
  mv a0, %m
  mv a1, %n1
  call ack
  mv %t, a0
  subi %m1, %m, 1
  mv a0, %m1
  mv a1, %t
  call ack
  mv %r, a0
  mv a0, %r
  ret
