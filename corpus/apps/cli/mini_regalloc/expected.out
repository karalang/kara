$ linear loops.ir primes 2
; %c.0 r1, %count [sp+0], %d [sp+3], %dd r2, %divides r1, %k [sp+2], %m r2, %more r1, %n [sp+1], %past r2
primes:  # frame 4
.entry:
  mv t0, a0
  st t0, [sp+1]
  li t0, 0
  st t0, [sp+0]
  li t0, 2
  st t0, [sp+2]
.outer:
  ld t0, [sp+2]
  ld t1, [sp+1]
  sle r1, t0, t1
  beqz r1, done
.start:
  li t0, 2
  st t0, [sp+3]
.trial:
  ld t0, [sp+3]
  mul r2, t0, t0
  ld t0, [sp+2]
  sgt r2, r2, t0
  bnez r2, prime
.test:
  ld t0, [sp+2]
  ld t1, [sp+3]
  rem r2, t0, t1
  li r1, 0
  seq r1, r2, r1
  bnez r1, composite
.bump:
  ld t0, [sp+3]
  addi t0, t0, 1
  st t0, [sp+3]
  j trial
.prime:
  ld t0, [sp+0]
  addi t0, t0, 1
  st t0, [sp+0]
.composite:
  ld t0, [sp+2]
  addi t0, t0, 1
  st t0, [sp+2]
  j outer
.done:
  ld t0, [sp+0]
  mv a0, t0
  ret
