$ linear arith.ir collatz 3
; %c.0 r3, %c.1 r3, %c.2 r3, %c.3 r3, %n r1, %one r3, %rem r3, %steps r2, %t r3
collatz:  # frame 0
.entry:
  mv r1, a0
  li r2, 0
.head:
  li r3, 1
  seq r3, r1, r3
  bnez r3, done
.body:
  li r3, 2
  rem r3, r1, r3
  bnez r3, odd
.even:
  li r3, 2
  div r1, r1, r3
  j next
.odd:
  li r3, 3
  mul r3, r1, r3
  addi r1, r3, 1
.next:
  addi r2, r2, 1
  j head
.done:
  mv a0, r2
  ret
