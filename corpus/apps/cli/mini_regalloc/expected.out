$ sel swap.ir lost
lost:  # frame 0
.entry:
  mv %n, a0
  li %x, 0
.loop:
  mv %y, %x
  addi %x, %x, 1
  slt %c, %x, %n
  bnez %c, loop
.done:
  mv a0, %y
  ret
