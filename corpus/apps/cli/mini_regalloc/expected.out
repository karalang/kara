$ sel arith.ir gcd
gcd:  # frame 0
.entry:
  mv %a, a0
  mv %b, a1
.test:
  li %c.0, 0
  seq %z, %b, %c.0
  bnez %z, done
.step:
  rem %t, %a, %b
  mv %a, %b
  mv %b, %t
  j test
.done:
  mv a0, %a
  ret
