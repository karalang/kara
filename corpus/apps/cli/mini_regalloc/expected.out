$ sel abi.ir chain
chain:  # frame 0
.entry:
  mv %n, a0
  li %c.0, 0
  seq %z, %n, %c.0
  beqz %z, rec
.base:
  li a0, 0
  ret
.rec:
  subi %m, %n, 1
  mul %k, %n, %n
  mv a0, %m
  call chain
  mv %r, a0
  add %s, %r, %k
  mv a0, %s
  ret
