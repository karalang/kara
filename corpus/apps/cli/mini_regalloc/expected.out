%t: degree 2, cost 20; %a, %b
%z: degree 2, cost 20; %a, %b
$ sel arith.ir classify
classify:  # frame 0
.entry:
  mv %n, a0
  li %c.0, 0
  slt %neg, %n, %c.0
  beqz %neg, check
.negative:
  li %r, -1
  j out
.check:
  li %c.1, 0
  seq %zero, %n, %c.1
  beqz %zero, positive
.isz:
  li %r, 0
  j out
.positive:
  li %c.2, 100
  sgt %big, %n, %c.2
  li %r, 1
  beqz %big, out
.huge:
  li %r, 2
.out:
  mv a0, %r
  ret
