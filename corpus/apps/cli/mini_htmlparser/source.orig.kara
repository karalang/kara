// mini_htmlparser: Python 3.13's html.parser.HTMLParser and html.escape /
// html.unescape, ported from html/parser.py and html/__init__.py, with a
// link extractor, a text extractor, a table of contents and a sanitizer
// built on the parser's events.

// ---------------------------------------------------------------- chars

fn is_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{c}'
}

fn is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_hex(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn is_alnum(c: char) -> bool {
    is_alpha(c) or is_digit(c)
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        match char.try_from(c as i64 + 32) {
            Ok(l) => l,
            Err(_) => c,
        }
    } else {
        c
    }
}

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

// raw[i..] starts with s.
fn at(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or raw[k] != c {
            return false;
        }
        k += 1;
    }
    true
}

// raw[i..] starts with s, ignoring ASCII case.
fn at_nocase(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or ascii_lower(raw[k]) != ascii_lower(c) {
            return false;
        }
        k += 1;
    }
    true
}

fn find_char(raw: ref Vec[char], c: char, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if raw[k] == c {
            return k;
        }
        k += 1;
    }
    -1
}

fn find_str(raw: ref Vec[char], s: ref String, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if at(raw, k, s) {
            return k;
        }
        k += 1;
    }
    -1
}

// ---------------------------------------------------------------- html.escape / html.unescape

fn escape(s: ref String, quote: bool) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else if quote and c == '"' {
            out.push_str("&quot;");
        } else if quote and c == '\'' {
            out.push_str("&#x27;");
        } else {
            out.push(c);
        }
    }
    out
}

// The numeric-character-reference-end-state table of html/__init__.py.
fn invalid_charref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn invalid_codepoint(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

fn push_code(out: mut ref String, num: i64) {
    match char.try_from(num) {
        Ok(c) => out.push(c),
        Err(_) => out.push('\u{fffd}'),
    }
}

fn numeric_ref(num: i64, out: mut ref String) {
    match invalid_charref(num) {
        Some(v) => {
            push_code(out, v);
            return;
        }
        None => {}
    }
    if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
        out.push('\u{fffd}');
        return;
    }
    if invalid_codepoint(num) {
        return;
    }
    push_code(out, num);
}

// The digits raw[lo..hi] in base 10 or 16, held at 0x110000 once past
// the last code point, as int() then the range check would decide.
fn ref_number(raw: ref Vec[char], lo: i64, hi: i64, base: i64) -> i64 {
    let mut n = 0;
    let mut k = lo;
    while k < hi {
        let c = raw[k];
        let d = if is_digit(c) {
            c as i64 - '0' as i64
        } else {
            ascii_lower(c) as i64 - 'a' as i64 + 10
        };
        n = n * base + d;
        if n > 0x10ffff {
            n = 0x110000;
        }
        k += 1;
    }
    n
}

// A named reference's text, the name possibly ending in ';'.
fn named_ref(name: ref Vec[char], ents: ref Map[String, String], out: mut ref String) {
    let whole = text(name, 0, name.len());
    match ents.get(whole.clone()) {
        Some(v) => {
            out.push_str(v);
            return;
        }
        None => {}
    }
    // The longest name the standard allows as a prefix.
    let mut x = name.len() - 1;
    while x > 1 {
        match ents.get(text(name, 0, x)) {
            Some(v) => {
                out.push_str(v);
                out.push_str(text(name, x, name.len()));
                return;
            }
            None => {}
        }
        x -= 1;
    }
    out.push('&');
    out.push_str(whole);
}

fn named_class(c: char) -> bool {
    not (c == '\t' or c == '\n' or c == '\u{c}' or c == ' ' or c == '<' or c == '&' or c == '#' or c == ';')
}

// html.unescape over raw[lo..hi].
fn unescape_chars(raw: ref Vec[char], lo: i64, hi: i64, ents: ref Map[String, String]) -> String {
    let mut out = String.new();
    let mut p = lo;
    while p < hi {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        if p + 1 < hi and raw[p + 1] == '#' {
            if p + 2 < hi and is_digit(raw[p + 2]) {
                let mut q = p + 2;
                while q < hi and is_digit(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 2, q, 10), out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else if p + 3 < hi and (raw[p + 2] == 'x' or raw[p + 2] == 'X') and is_hex(raw[p + 3]) {
                let mut q = p + 3;
                while q < hi and is_hex(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 3, q, 16), out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else {
                out.push('&');
                p += 1;
            }
            continue;
        }
        let mut q = p + 1;
        while q < hi and q - (p + 1) < 32 and named_class(raw[q]) {
            q += 1;
        }
        if q == p + 1 {
            out.push('&');
            p += 1;
            continue;
        }
        if q < hi and raw[q] == ';' {
            q += 1;
        }
        let name: Vec[char] = raw[p + 1..q].iter().collect();
        named_ref(name, ents, out);
        p = q;
    }
    out
}

fn unescape(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    unescape_chars(raw, 0, raw.len(), ents)
}

// _unescape_attrvalue: numeric references always, named ones only when
// the whole name is in the table and no '=' follows.
fn unescape_attr(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    let n = raw.len();
    let mut out = String.new();
    let mut p = 0;
    while p < n {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        let mut q = p + 1;
        let mut numeric = false;
        if q < n and raw[q] == '#' {
            if q + 1 < n and is_digit(raw[q + 1]) {
                q += 1;
                while q < n and is_digit(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else if q + 2 < n and (raw[q + 1] == 'x' or raw[q + 1] == 'X') and is_hex(raw[q + 2]) {
                q += 2;
                while q < n and is_hex(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else {
                out.push('&');
                p += 1;
                continue;
            }
        } else if q < n and is_alpha(raw[q]) {
            while q < n and is_alnum(raw[q]) {
                q += 1;
            }
        } else {
            out.push('&');
            p += 1;
            continue;
        }
        let mut eq = false;
        if q < n and (raw[q] == ';' or raw[q] == '=') {
            eq = raw[q] == '=';
            q += 1;
        }
        let r = text(raw, p, q);
        if numeric {
            out.push_str(unescape_chars(raw, p, q, ents));
        } else if not eq and ents.contains_key(text(raw, p + 1, q)) {
            out.push_str(unescape_chars(raw, p, q, ents));
        } else {
            out.push_str(r);
        }
        p = q;
    }
    out
}

// ---------------------------------------------------------------- the tokenizer's patterns

// The end of locatetagend's match at p (a tag name's first letter).
fn locate_tag_end(raw: ref Vec[char], p: i64) -> i64 {
    let n = raw.len();
    let mut k = p + 1;
    while k < n and not (is_space(raw[k]) or raw[k] == '/' or raw[k] == '>') {
        k += 1;
    }
    while k < n and (is_space(raw[k]) or raw[k] == '/') {
        k += 1;
    }
    loop {
        if k >= n or not after_attr_gap(raw[k - 1]) {
            break;
        }
        let c = raw[k];
        if is_space(c) or c == '/' or c == '>' {
            break;
        }
        k = attr_name_end(raw, k);
        match value_indicator(raw, k) {
            Some(v) => k = v.2,
            None => {}
        }
        while k < n and (is_space(raw[k]) or raw[k] == '/') {
            k += 1;
        }
    }
    if k < n and raw[k] == '>' {
        k += 1;
    }
    k
}

// The lookbehind before an attribute name: ['"\t\n\r\f /].
fn after_attr_gap(c: char) -> bool {
    c == '\'' or c == '"' or is_space(c) or c == '/'
}

fn attr_name_end(raw: ref Vec[char], k: i64) -> i64 {
    let n = raw.len();
    let mut e = k + 1;
    while e < n and not (is_space(raw[e]) or raw[e] == '/' or raw[e] == '=' or raw[e] == '>') {
        e += 1;
    }
    e
}

// A value at b: 'x', "x" or a bare run; None when a quote opens and never
// closes.
fn value_at(raw: ref Vec[char], b: i64) -> Option[i64] {
    let n = raw.len();
    if b < n and (raw[b] == '\'' or raw[b] == '"') {
        let q = find_char(raw, raw[b], b + 1);
        if q < 0 {
            return None;
        }
        return Some(q + 1);
    }
    let mut e = b;
    while e < n and not (raw[e] == '>' or is_space(raw[e])) {
        e += 1;
    }
    Some(e)
}

// `[\t\n\r\f ]*=[\t\n\r\f ]*` and a value after an attribute name ending
// at k: (value start, value end, match end), backtracking the way re does
// when a quote never closes.
fn value_indicator(raw: ref Vec[char], k: i64) -> Option[(i64, i64, i64)] {
    let n = raw.len();
    let mut a = k;
    while a < n and is_space(raw[a]) {
        a += 1;
    }
    if a >= n or raw[a] != '=' {
        return None;
    }
    let mut b = a + 1;
    while b < n and is_space(raw[b]) {
        b += 1;
    }
    match value_at(raw, b) {
        Some(e) => Some((b, e, e)),
        None => {
            if b > a + 1 {
                // One space fewer, and the value is the empty bare run.
                Some((b - 1, b - 1, b - 1))
            } else {
                None
            }
        }
    }
}

struct Attr {
    name: String,
    value: Option[String],
}

// ---------------------------------------------------------------- events

enum Event {
    Start(String, Vec[Attr]),
    StartEnd(String, Vec[Attr]),
    End(String),
    Data(String),
    Comment(String),
    Decl(String),
    Pi(String),
    UnknownDecl(String),
    CharRef(String),
    EntityRef(String),
}

struct Ev {
    line: i64,
    col: i64,
    ev: Event,
}

// ---------------------------------------------------------------- HTMLParser

struct HtmlParser {
    convert_charrefs: bool,
    raw: Vec[char],
    lineno: i64,
    offset: i64,
    lasttag: String,
    cdata_elem: String,
    escapable: bool,
    support_cdata: bool,
    pending: Vec[char],
    pending_len: i64,
    parse_threshold: i64,
    starttag_text: Option[String],
    events: Vec[Ev],
}

fn is_cdata_content(tag: ref String) -> bool {
    tag == "script" or tag == "style" or tag == "xmp" or tag == "iframe" or tag == "noembed" or tag == "noframes"
}

impl HtmlParser {
    fn new(convert_charrefs: bool) -> HtmlParser {
        HtmlParser {
            convert_charrefs: convert_charrefs,
            raw: Vec.new(),
            lineno: 1,
            offset: 0,
            lasttag: "???".to_string(),
            cdata_elem: String.new(),
            escapable: true,
            support_cdata: true,
            pending: Vec.new(),
            pending_len: 0,
            parse_threshold: 1,
            starttag_text: None,
            events: Vec.new(),
        }
    }

    fn emit(mut ref self, ev: own Event) {
        self.events.push(Ev { line: self.lineno, col: self.offset, ev: ev });
    }

    fn feed(mut ref self, data: ref Vec[char], ents: ref Map[String, String]) {
        self.pending_len += data.len();
        if self.pending_len < self.parse_threshold {
            for c in data.iter() {
                self.pending.push(*c);
            }
            return;
        }
        for c in self.pending.iter() {
            self.raw.push(*c);
        }
        for c in data.iter() {
            self.raw.push(*c);
        }
        self.pending.clear();
        self.pending_len = 0;
        let n = self.raw.len();
        self.goahead(false, ents);
        if self.raw.len() < n {
            self.parse_threshold = 1;
        } else {
            self.parse_threshold = self.raw.len();
        }
    }

    fn close(mut ref self, ents: ref Map[String, String]) {
        if self.pending.len() > 0 {
            for c in self.pending.iter() {
                self.raw.push(*c);
            }
            self.pending.clear();
            self.pending_len = 0;
        }
        self.goahead(true, ents);
    }

    fn getpos(ref self) -> (i64, i64) {
        (self.lineno, self.offset)
    }

    fn updatepos(mut ref self, i: i64, j: i64) -> i64 {
        if i >= j {
            return j;
        }
        let mut nlines = 0;
        let mut last = -1;
        let mut k = i;
        while k < j {
            if self.raw[k] == '\n' {
                nlines += 1;
                last = k;
            }
            k += 1;
        }
        if nlines > 0 {
            self.lineno += nlines;
            self.offset = j - (last + 1);
        } else {
            self.offset += j - i;
        }
        j
    }

    fn set_cdata_mode(mut ref self, elem: ref String, escapable: bool) {
        self.cdata_elem = elem.to_lowercase();
        self.escapable = escapable;
    }

    fn clear_cdata_mode(mut ref self) {
        self.cdata_elem = String.new();
        self.escapable = true;
    }

    // self.interesting.search(rawdata, i): the start of the match, or -1.
    fn interesting(ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if self.cdata_elem == "plaintext" {
            return n;
        }
        let mut p = i;
        while p < n {
            let c = self.raw[p];
            if self.cdata_elem == "" {
                if c == '<' or c == '&' {
                    return p;
                }
            } else {
                if self.escapable and not self.convert_charrefs and c == '&' {
                    return p;
                }
                if c == '<' and p + 1 < n and self.raw[p + 1] == '/' and at_nocase(self.raw, p + 2, self.cdata_elem) {
                    let after = p + 2 + self.cdata_elem.chars().count();
                    if after < n and (is_space(self.raw[after]) or self.raw[after] == '/' or self.raw[after] == '>') {
                        return p;
                    }
                }
            }
            p += 1;
        }
        -1
    }

    fn data(mut ref self, lo: i64, hi: i64, ents: ref Map[String, String]) {
        let s = if self.convert_charrefs and self.escapable {
            unescape_chars(self.raw, lo, hi, ents)
        } else {
            text(self.raw, lo, hi)
        };
        self.emit(Event.Data(s));
    }

    fn goahead(mut ref self, end: bool, ents: ref Map[String, String]) {
        let n = self.raw.len();
        let mut i = 0;
        while i < n {
            let mut j = n;
            if self.convert_charrefs and self.cdata_elem == "" {
                let lt = find_char(self.raw, '<', i);
                if lt < 0 {
                    // A reference may be cut in half at the end of the buffer.
                    let lo = if i > n - 34 { i } else { n - 34 };
                    let mut amppos = -1;
                    let mut k = n - 1;
                    while k >= lo {
                        if self.raw[k] == '&' {
                            amppos = k;
                            break;
                        }
                        k -= 1;
                    }
                    if amppos >= 0 {
                        let mut ended = false;
                        let mut q = amppos;
                        while q < n {
                            let c = self.raw[q];
                            if is_space(c) or c == ';' {
                                ended = true;
                                break;
                            }
                            q += 1;
                        }
                        if not ended {
                            break;
                        }
                    }
                    j = n;
                } else {
                    j = lt;
                }
            } else {
                let m = self.interesting(i);
                if m >= 0 {
                    j = m;
                } else {
                    if self.cdata_elem != "" {
                        break;
                    }
                    j = n;
                }
            }
            if i < j {
                self.data(i, j, ents);
            }
            i = self.updatepos(i, j);
            if i == n {
                break;
            }
            if self.raw[i] == '<' {
                let mut k = 0;
                if i + 1 < n and is_alpha(self.raw[i + 1]) {
                    k = self.parse_starttag(i, ents);
                } else if at(self.raw, i, "</") {
                    k = self.parse_endtag(i);
                } else if at(self.raw, i, "<!--") {
                    k = self.parse_comment(i);
                } else if at(self.raw, i, "<?") {
                    k = self.parse_pi(i);
                } else if at(self.raw, i, "<!") {
                    k = self.parse_html_declaration(i);
                } else if i + 1 < n or end {
                    self.emit(Event.Data("<".to_string()));
                    k = i + 1;
                } else {
                    break;
                }
                if k < 0 {
                    if not end {
                        break;
                    }
                    self.flush_unterminated(i);
                    k = n;
                }
                i = self.updatepos(i, k);
            } else if at(self.raw, i, "&#") {
                match self.match_charref(i) {
                    Some((name, e)) => {
                        self.emit(Event.CharRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 2 < n and (is_digit(self.raw[i + 2])
                    or (i + 3 < n and (self.raw[i + 2] == 'x' or self.raw[i + 2] == 'X') and is_hex(self.raw[i + 3])));
                if incomplete {
                    if end {
                        let name = text(self.raw, i + 2, n);
                        self.emit(Event.CharRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 3 < n {
                    self.emit(Event.Data("&#".to_string()));
                    i = self.updatepos(i, i + 2);
                } else {
                    break;
                }
            } else if self.raw[i] == '&' {
                match self.match_entityref(i) {
                    Some((name, e)) => {
                        self.emit(Event.EntityRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 1 < n and (is_alpha(self.raw[i + 1]) or self.raw[i + 1] == '#');
                if incomplete {
                    if end {
                        let name = text(self.raw, i + 1, n);
                        self.emit(Event.EntityRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 1 < n {
                    self.emit(Event.Data("&".to_string()));
                    i = self.updatepos(i, i + 1);
                } else {
                    break;
                }
            } else {
                panic("interesting.search() lied");
            }
        }
        if end and i < n {
            self.data(i, n, ents);
            i = self.updatepos(i, n);
        }
        self.raw = self.raw[i..].iter().collect();
    }

    // What goahead does at EOF with a construct that never ended.
    fn flush_unterminated(mut ref self, i: i64) {
        let n = self.raw.len();
        if i + 1 < n and is_alpha(self.raw[i + 1]) {
            return;
        }
        if at(self.raw, i, "</") {
            if i + 2 == n {
                self.emit(Event.Data("</".to_string()));
            } else if i + 2 < n and is_alpha(self.raw[i + 2]) {
                return;
            } else {
                let s = text(self.raw, i + 2, n);
                self.emit(Event.Comment(s));
            }
        } else if at(self.raw, i, "<!--") {
            let mut j = n;
            let suffixes: Vec[String] = vec!["--!".to_string(), "--".to_string(), "-".to_string()];
            for suffix in suffixes.iter() {
                let len = suffix.chars().count();
                if n - (i + 4) >= len and at(self.raw, n - len, suffix) {
                    j -= len;
                    break;
                }
            }
            let s = text(self.raw, i + 4, j);
            self.emit(Event.Comment(s));
        } else if at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let s = text(self.raw, i + 3, n);
            self.emit(Event.UnknownDecl(s));
        } else if at_nocase(self.raw, i, "<!doctype") {
            let s = text(self.raw, i + 2, n);
            self.emit(Event.Decl(s));
        } else if at(self.raw, i, "<!") {
            let s = text(self.raw, i + 2, n);
            self.emit(Event.Comment(s));
        } else if at(self.raw, i, "<?") {
            let s = text(self.raw, i + 2, n);
            self.emit(Event.Pi(s));
        } else {
            panic("we should not get here!");
        }
    }

    // charref: &#(?:[0-9]+|[xX][0-9a-fA-F]+)[^0-9a-fA-F] at i.
    fn match_charref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        let mut q = i + 2;
        if q < n and is_digit(self.raw[q]) {
            while q < n and is_digit(self.raw[q]) {
                q += 1;
            }
        } else if q + 1 < n and (self.raw[q] == 'x' or self.raw[q] == 'X') and is_hex(self.raw[q + 1]) {
            q += 1;
            while q < n and is_hex(self.raw[q]) {
                q += 1;
            }
        } else {
            return None;
        }
        if q >= n or is_hex(self.raw[q]) {
            return None;
        }
        Some((text(self.raw, i + 2, q), q + 1))
    }

    // entityref: &([a-zA-Z][-.a-zA-Z0-9]*)[^a-zA-Z0-9] at i, giving back
    // name characters when the buffer ends inside the name.
    fn match_entityref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        if i + 1 >= n or not is_alpha(self.raw[i + 1]) {
            return None;
        }
        let mut e = i + 2;
        while e < n and (is_alnum(self.raw[e]) or self.raw[e] == '-' or self.raw[e] == '.') {
            e += 1;
        }
        if e < n {
            return Some((text(self.raw, i + 1, e), e + 1));
        }
        let mut b = e - 1;
        while b > i + 1 {
            if not is_alnum(self.raw[b]) {
                return Some((text(self.raw, i + 1, b), b + 1));
            }
            b -= 1;
        }
        None
    }

    fn parse_html_declaration(mut ref self, i: i64) -> i64 {
        if at(self.raw, i, "<!--") {
            return self.parse_comment(i);
        } else if at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let j = find_str(self.raw, "]]>", i + 9);
            if j < 0 {
                return -1;
            }
            let s = text(self.raw, i + 3, j);
            self.emit(Event.UnknownDecl(s));
            return j + 3;
        } else if at_nocase(self.raw, i, "<!doctype") {
            let gtpos = find_char(self.raw, '>', i + 9);
            if gtpos < 0 {
                return -1;
            }
            let s = text(self.raw, i + 2, gtpos);
            self.emit(Event.Decl(s));
            return gtpos + 1;
        }
        self.parse_bogus_comment(i)
    }

    fn parse_comment(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        let mut start = -1;
        let mut stop = -1;
        // An empty comment is closed by the first ">" or "->".
        if i + 4 < n and self.raw[i + 4] == '>' {
            start = i + 4;
            stop = i + 5;
        } else if i + 5 < n and self.raw[i + 4] == '-' and self.raw[i + 5] == '>' {
            start = i + 4;
            stop = i + 6;
        } else {
            let mut p = i + 4;
            while p + 2 < n {
                if self.raw[p] == '-' and self.raw[p + 1] == '-' {
                    if self.raw[p + 2] == '>' {
                        start = p;
                        stop = p + 3;
                        break;
                    }
                    if p + 3 < n and self.raw[p + 2] == '!' and self.raw[p + 3] == '>' {
                        start = p;
                        stop = p + 4;
                        break;
                    }
                }
                p += 1;
            }
            if start < 0 {
                return -1;
            }
        }
        let s = text(self.raw, i + 4, start);
        self.emit(Event.Comment(s));
        stop
    }

    fn parse_bogus_comment(mut ref self, i: i64) -> i64 {
        let pos = find_char(self.raw, '>', i + 2);
        if pos < 0 {
            return -1;
        }
        let s = text(self.raw, i + 2, pos);
        self.emit(Event.Comment(s));
        pos + 1
    }

    fn parse_pi(mut ref self, i: i64) -> i64 {
        let j = find_char(self.raw, '>', i + 2);
        if j < 0 {
            return -1;
        }
        let s = text(self.raw, i + 2, j);
        self.emit(Event.Pi(s));
        j + 1
    }

    fn parse_starttag(mut ref self, i: i64, ents: ref Map[String, String]) -> i64 {
        self.starttag_text = None;
        let endpos = locate_tag_end(self.raw, i + 1);
        if self.raw[endpos - 1] != '>' {
            return -1;
        }
        self.starttag_text = Some(text(self.raw, i, endpos));
        let n = self.raw.len();

        // tagfind_tolerant
        let mut k = i + 2;
        while k < n and not (is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = text(self.raw, i + 1, k).to_lowercase();
        k = skip_attr_gap(self.raw, k);
        self.lasttag = tag.clone();

        let mut attrs: Vec[Attr] = Vec.new();
        while k < endpos {
            // attrfind_tolerant
            if not after_attr_gap(self.raw[k - 1]) {
                break;
            }
            let c = self.raw[k];
            if is_space(c) or c == '/' or c == '>' {
                break;
            }
            let ne = attr_name_end(self.raw, k);
            let name = text(self.raw, k, ne).to_lowercase();
            let mut value: Option[String] = None;
            let mut m = ne;
            match value_indicator(self.raw, ne) {
                Some((vs, ve, e)) => {
                    let mut v = text(self.raw, vs, ve);
                    if ve - vs >= 2 and (self.raw[vs] == '\'' or self.raw[vs] == '"') and self.raw[ve - 1] == self.raw[vs] {
                        v = text(self.raw, vs + 1, ve - 1);
                    }
                    if v.len() > 0 {
                        v = unescape_attr(v, ents);
                    }
                    value = Some(v);
                    m = e;
                }
                None => {}
            }
            attrs.push(Attr { name: name, value: value });
            k = skip_attr_gap(self.raw, m);
        }

        let tail = text(self.raw, k, endpos);
        let end = tail.trim();
        if end != ">" and end != "/>" {
            let s = text(self.raw, i, endpos);
            self.emit(Event.Data(s));
            return endpos;
        }
        if end == "/>" {
            self.emit(Event.StartEnd(tag, attrs));
        } else {
            self.emit(Event.Start(tag.clone(), attrs));
            if is_cdata_content(tag) or tag == "plaintext" {
                self.set_cdata_mode(tag, false);
            } else if tag == "textarea" or tag == "title" {
                self.set_cdata_mode(tag, true);
            }
        }
        endpos
    }

    fn parse_endtag(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if find_char(self.raw, '>', i + 2) < 0 {
            return -1;
        }
        if not (i + 2 < n and is_alpha(self.raw[i + 2])) {
            if self.raw[i + 2] == '>' {
                // "</>" is ignored.
                return i + 3;
            }
            return self.parse_bogus_comment(i);
        }
        let j = locate_tag_end(self.raw, i + 2);
        if self.raw[j - 1] != '>' {
            return -1;
        }
        let mut k = i + 3;
        while k < n and not (is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = text(self.raw, i + 2, k).to_lowercase();
        self.emit(Event.End(tag));
        self.clear_cdata_mode();
        j
    }
}

// (?:[\t\n\r\f ]|/(?!>))*
fn skip_attr_gap(raw: ref Vec[char], from: i64) -> i64 {
    let n = raw.len();
    let mut k = from;
    while k < n {
        if is_space(raw[k]) {
            k += 1;
        } else if raw[k] == '/' and not (k + 1 < n and raw[k + 1] == '>') {
            k += 1;
        } else {
            break;
        }
    }
    k
}

fn parse_all(src: ref String, convert: bool, chunk: i64, ents: ref Map[String, String]) -> HtmlParser {
    let mut p = HtmlParser.new(convert);
    let chars = to_chars(src);
    if chunk == 0 {
        p.feed(chars, ents);
    } else {
        let mut k = 0;
        while k < chars.len() {
            let hi = if k + chunk < chars.len() { k + chunk } else { chars.len() };
            let piece: Vec[char] = chars[k..hi].iter().collect();
            p.feed(piece, ents);
            k = hi;
        }
    }
    p.close(ents);
    p
}

// ---------------------------------------------------------------- printing

fn esc(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        let o = c as i64;
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '"' {
            out.push_str("\\\"");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if o < 32 or (o >= 0x7f and o <= 0x9f) {
            let hex: Vec[char] = "0123456789abcdef".chars().collect();
            out.push_str("\\x");
            out.push(hex[o / 16]);
            out.push(hex[o % 16]);
        } else {
            out.push(c);
        }
    }
    out
}

fn attr_text(attrs: ref Vec[Attr]) -> String {
    let mut s = String.new();
    for a in attrs.iter() {
        match a.value {
            Some(v) => {
                let t = f" {esc(a.name)}=\"{esc(v)}\"";
                s.push_str(t);
            }
            None => {
                s.push(' ');
                s.push_str(esc(a.name));
            }
        }
    }
    s
}

fn event_text(ev: ref Event) -> String {
    match ev {
        Event.Start(tag, attrs) => f"start {tag}{attr_text(attrs)}",
        Event.StartEnd(tag, attrs) => f"startend {tag}{attr_text(attrs)}",
        Event.End(tag) => f"end {tag}",
        Event.Data(s) => f"data \"{esc(s)}\"",
        Event.Comment(s) => f"comment \"{esc(s)}\"",
        Event.Decl(s) => f"decl \"{esc(s)}\"",
        Event.Pi(s) => f"pi \"{esc(s)}\"",
        Event.UnknownDecl(s) => f"unknown_decl \"{esc(s)}\"",
        Event.CharRef(s) => f"charref {esc(s)}",
        Event.EntityRef(s) => f"entityref {esc(s)}",
    }
}

// ---------------------------------------------------------------- programs

fn link_attr(tag: ref String) -> String {
    if tag == "a" or tag == "link" {
        "href".to_string()
    } else if tag == "img" or tag == "script" or tag == "iframe" {
        "src".to_string()
    } else if tag == "form" {
        "action".to_string()
    } else {
        String.new()
    }
}

fn links(p: ref HtmlParser, out: mut ref String) {
    let mut title: Option[String] = None;
    let mut in_title = false;
    let mut description: Option[String] = None;
    for e in p.events.iter() {
        match e.ev {
            Event.Start(tag, attrs) => {
                link_starttag(tag, attrs, out, mut title, mut in_title, mut description);
            }
            Event.StartEnd(tag, attrs) => {
                link_starttag(tag, attrs, out, mut title, mut in_title, mut description);
            }
            Event.End(tag) => {
                if tag == "title" {
                    in_title = false;
                }
            }
            Event.Data(s) => {
                if in_title {
                    match title {
                        Some(t) => title = Some(f"{t}{s}"),
                        None => {}
                    }
                }
            }
            _ => {}
        }
    }
    let t = match title {
        Some(t) => esc(t),
        None => "(none)".to_string(),
    };
    out.push_str(f"  title: {t}\n");
    let d = match description {
        Some(d) => esc(d),
        None => "(none)".to_string(),
    };
    out.push_str(f"  description: {d}\n");
}

fn link_starttag(tag: ref String, attrs: ref Vec[Attr], out: mut ref String, title: mut ref Option[String], in_title: mut ref bool, description: mut ref Option[String]) {
    let want = link_attr(tag);
    for a in attrs.iter() {
        if a.name == want {
            match a.value {
                Some(v) => out.push_str(f"  {esc(f"{tag} {a.name} {v}")}\n"),
                None => {}
            }
        }
    }
    if tag == "title" {
        *in_title = true;
        *title = Some(String.new());
    }
    if tag == "meta" {
        // dict(attrs): the last of a repeated name wins.
        let mut name: Option[String] = None;
        let mut content: Option[String] = None;
        let mut has_content = false;
        for a in attrs.iter() {
            if a.name == "name" {
                name = a.value.clone();
            }
            if a.name == "content" {
                content = a.value.clone();
                has_content = true;
            }
        }
        let is_desc = match name {
            Some(n) => n == "description",
            None => false,
        };
        if is_desc and has_content {
            match content {
                Some(c) => *description = Some(c),
                None => {}
            }
        }
    }
}

fn collapse(s: ref String) -> String {
    let mut out = String.new();
    let mut space = false;
    for c in s.chars() {
        if is_space(c) {
            space = true;
        } else {
            if space {
                out.push(' ');
            }
            space = false;
            out.push(c);
        }
    }
    if space {
        out.push(' ');
    }
    out
}

fn strip_ws(s: ref String) -> String {
    let chars = to_chars(s);
    let mut lo = 0;
    let mut hi = chars.len();
    while lo < hi and is_space(chars[lo]) {
        lo += 1;
    }
    while hi > lo and is_space(chars[hi - 1]) {
        hi -= 1;
    }
    text(chars, lo, hi)
}

fn is_block(tag: ref String) -> bool {
    let blocks: Vec[String] = vec![
        "p".to_string(), "h1".to_string(), "h2".to_string(), "h3".to_string(), "h4".to_string(),
        "h5".to_string(), "h6".to_string(), "li".to_string(), "pre".to_string(), "br".to_string(),
        "div".to_string(), "tr".to_string(), "article".to_string(), "nav".to_string(),
        "footer".to_string(), "ul".to_string(), "ol".to_string(), "section".to_string(),
        "header".to_string(), "form".to_string(), "label".to_string(), "select".to_string(),
        "option".to_string(), "textarea".to_string(), "plaintext".to_string(),
    ];
    blocks.contains(tag)
}

fn is_skipped(tag: ref String) -> bool {
    tag == "script" or tag == "style" or tag == "title"
}

struct TextState {
    parts: String,
    skip: i64,
    pre: i64,
}

impl TextState {
    fn start(mut ref self, tag: ref String) {
        if is_skipped(tag) {
            self.skip += 1;
        }
        if tag == "pre" {
            self.pre += 1;
        }
        if is_block(tag) {
            self.parts.push('\n');
        }
    }

    fn end(mut ref self, tag: ref String) {
        if is_skipped(tag) and self.skip > 0 {
            self.skip -= 1;
        }
        if tag == "pre" and self.pre > 0 {
            self.pre -= 1;
        }
        if is_block(tag) {
            self.parts.push('\n');
        }
    }
}

fn text_of(p: ref HtmlParser, out: mut ref String) {
    let mut st = TextState { parts: String.new(), skip: 0, pre: 0 };
    for e in p.events.iter() {
        match e.ev {
            Event.Start(tag, _) => st.start(tag),
            Event.StartEnd(tag, _) => {
                st.start(tag);
                st.end(tag);
            }
            Event.End(tag) => st.end(tag),
            Event.Data(s) => {
                if st.skip == 0 {
                    if st.pre > 0 {
                        st.parts.push_str(s);
                    } else {
                        st.parts.push_str(collapse(s));
                    }
                }
            }
            _ => {}
        }
    }
    for line in st.parts.split("\n") {
        let l = strip_ws(line);
        if l.len() > 0 {
            out.push_str(f"  | {esc(l)}\n");
        }
    }
}

struct Heading {
    level: i64,
    id: Option[String],
    text: String,
}

fn heading_level(tag: ref String) -> i64 {
    if tag == "h1" {
        1
    } else if tag == "h2" {
        2
    } else if tag == "h3" {
        3
    } else {
        0
    }
}

fn toc_start(tag: ref String, attrs: ref Vec[Attr], cur: mut ref Option[Heading]) {
    let level = heading_level(tag);
    if level > 0 {
        let mut id: Option[String] = None;
        for a in attrs.iter() {
            if a.name == "id" {
                id = a.value.clone();
            }
        }
        *cur = Some(Heading { level: level, id: id, text: String.new() });
    }
}

fn toc_end(tag: ref String, cur: mut ref Option[Heading], items: mut ref Vec[Heading]) {
    let done = match cur {
        Some(h) => heading_level(tag) == h.level,
        None => false,
    };
    if done {
        match cur.take() {
            Some(h) => items.push(h),
            None => {}
        }
    }
}

fn toc(p: ref HtmlParser, out: mut ref String) {
    let mut cur: Option[Heading] = None;
    let mut items: Vec[Heading] = Vec.new();
    for e in p.events.iter() {
        match e.ev {
            Event.Start(tag, attrs) => toc_start(tag, attrs, mut cur),
            Event.StartEnd(tag, attrs) => {
                toc_start(tag, attrs, mut cur);
                toc_end(tag, mut cur, mut items);
            }
            Event.End(tag) => toc_end(tag, mut cur, mut items),
            Event.Data(s) => {
                match cur {
                    Some(h) => h.text.push_str(s),
                    None => {}
                }
            }
            _ => {}
        }
    }
    if items.len() == 0 {
        out.push_str("  (no headings)\n");
    }
    for h in items.iter() {
        let mut line = "  ".to_string();
        let mut k = 1;
        while k < h.level {
            line.push_str("  ");
            k += 1;
        }
        line.push_str(esc(strip_ws(collapse(h.text))));
        match h.id {
            Some(id) => line.push_str(esc(f" (#{id})")),
            None => {}
        }
        out.push_str(f"{line}\n");
    }
}

// Which attributes a sanitized tag keeps, or None when the tag goes.
fn allowed_attrs(tag: ref String) -> Option[Vec[String]] {
    if tag == "a" {
        return Some(vec!["href".to_string(), "title".to_string()]);
    }
    let bare: Vec[String] = vec![
        "b".to_string(), "i".to_string(), "em".to_string(), "strong".to_string(),
        "p".to_string(), "ul".to_string(), "li".to_string(), "code".to_string(),
        "pre".to_string(), "br".to_string(), "h1".to_string(), "h2".to_string(), "h3".to_string(),
    ];
    if bare.contains(tag) {
        Some(Vec.new())
    } else {
        None
    }
}

fn dropped_with_content(tag: ref String) -> bool {
    tag == "script" or tag == "style" or tag == "iframe" or tag == "title"
}

struct Sanitizer {
    out: String,
    drop: i64,
    removed_tags: i64,
    removed_attrs: i64,
}

impl Sanitizer {
    fn start(mut ref self, tag: ref String, attrs: ref Vec[Attr], closed: bool) {
        if dropped_with_content(tag) {
            if not closed {
                self.drop += 1;
            }
            self.removed_tags += 1;
            return;
        }
        if self.drop > 0 {
            return;
        }
        let keep = match allowed_attrs(tag) {
            Some(k) => k,
            None => {
                self.removed_tags += 1;
                self.removed_attrs += attrs.len();
                return;
            }
        };
        let mut s = f"<{tag}";
        for a in attrs.iter() {
            let v = match a.value {
                Some(v) => v.clone(),
                None => {
                    self.removed_attrs += 1;
                    continue;
                }
            };
            if not keep.contains(a.name) {
                self.removed_attrs += 1;
                continue;
            }
            if a.name == "href" and strip_ws(v).to_lowercase().starts_with("javascript:") {
                self.removed_attrs += 1;
                continue;
            }
            s.push_str(f" {a.name}=\"{escape(v, true)}\"");
        }
        if tag == "a" {
            s.push_str(" rel=\"nofollow\"");
        }
        s.push('>');
        self.out.push_str(s);
        if closed and tag != "br" {
            self.out.push_str(f"</{tag}>");
        }
    }

    fn end(mut ref self, tag: ref String) {
        if dropped_with_content(tag) {
            if self.drop > 0 {
                self.drop -= 1;
            }
            return;
        }
        if self.drop > 0 {
            return;
        }
        match allowed_attrs(tag) {
            Some(_) => {
                if tag != "br" {
                    self.out.push_str(f"</{tag}>");
                }
            }
            None => {}
        }
    }
}

fn sanitize(p: ref HtmlParser, out: mut ref String) {
    let mut s = Sanitizer { out: String.new(), drop: 0, removed_tags: 0, removed_attrs: 0 };
    for e in p.events.iter() {
        match e.ev {
            Event.Start(tag, attrs) => s.start(tag, attrs, false),
            Event.StartEnd(tag, attrs) => s.start(tag, attrs, true),
            Event.End(tag) => s.end(tag),
            Event.Data(d) => {
                if s.drop == 0 {
                    s.out.push_str(escape(d, false));
                }
            }
            _ => {}
        }
    }
    for line in s.out.split("\n") {
        out.push_str(f"  | {esc(line)}\n");
    }
    out.push_str(f"  removed {s.removed_tags} tags, {s.removed_attrs} attributes\n");
}

// ---------------------------------------------------------------- jobs

fn source(arg: ref String) -> Result[String, String] {
    if arg.starts_with("@") {
        let path = f"data/pages/{arg[1..].to_string()}";
        return match fs.read_to_string(path.clone()) {
            Ok(s) => Ok(s),
            Err(e) => Err(f"cannot read {path}: {e}"),
        };
    }
    Ok(arg.replace("\\n", "\n"))
}

fn run(f: ref Vec[String], ents: ref Map[String, String], out: mut ref String) -> Result[(), String] {
    let kind = f[0].clone();
    if kind == "events" {
        let src = source(f[1])?;
        let chunk = match i64.parse(f[3].clone()) {
            Some(n) => n,
            None => return Err(f"bad chunk {f[3]}"),
        };
        let p = parse_all(src, f[2] == "1", chunk, ents);
        for e in p.events.iter() {
            out.push_str(f"  {e.line}:{e.col} {event_text(e.ev)}\n");
        }
        let (line, col) = p.getpos();
        out.push_str(f"  end {line}:{col}\n");
    } else if kind == "unescape" {
        out.push_str(f"  {esc(unescape(f[1], ents))}\n");
    } else if kind == "escape" {
        out.push_str(f"  {esc(escape(f[1], f[2] == "1"))}\n");
    } else {
        let src = source(f[1])?;
        let p = parse_all(src, true, 0, ents);
        if kind == "links" {
            links(p, out);
        } else if kind == "text" {
            text_of(p, out);
        } else if kind == "toc" {
            toc(p, out);
        } else if kind == "sanitize" {
            sanitize(p, out);
        } else {
            return Err(f"unknown job {kind}");
        }
    }
    Ok(())
}

fn main() {
    for (path, contents) in data_files() {
        let parts = path.split("/");
        let mut dir = "data".to_string();
        let mut k = 0;
        while k + 1 < parts.len() {
            dir = f"{dir}/{parts[k]}";
            k += 1;
        }
        if let Err(e) = fs.create_dir_all(dir.clone()) {
            eprintln(f"cannot create {dir}: {e}");
            return;
        }
        if let Err(e) = fs.write(f"data/{path}", contents) {
            eprintln(f"cannot write {path}: {e}");
            return;
        }
    }
    if let Err(e) = fs.write("data/jobs.tsv".to_string(), jobs_text()) {
        eprintln(f"cannot write jobs.tsv: {e}");
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"cannot read jobs.tsv: {e}");
            return;
        }
    };
    let ents = html5_entities();
    for job in jobs.lines() {
        let f = job.split("\t");
        let mut out = String.new();
        println(f"== {esc(f.join(" | "))}");
        match run(f, ents, mut out) {
            Ok(()) => print(out),
            Err(e) => {
                print(out);
                println(f"  error: {e}");
            }
        }
    }
}

