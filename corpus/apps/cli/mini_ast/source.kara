    t.push_str("parse\t'(a, b) += 1'\n");
    t.push_str("parse\t'f() += 1'\n");
    t.push_str("parse\t'f(k=1, a)'\n");
    t.push_str("parse\t'f(**k, a)'\n");
    t.push_str("parse\t'f(a for a in b, c)'\n");
    t.push_str("parse\t'def f(a=1, b): pass'\n");
    t.push_str("parse\t'lambda x=1, y: 0'\n");
    t.push_str("parse\t'x = 1 if y'\n");
    t.push_str("parse\t'import'\n");
    t.push_str("eval\t'1'\n");
    t.push_str("eval\t'-1'\n");
    t.push_str("eval\t'+2.5'\n");
    t.push_str("eval\t'1+2j'\n");
    t.push_str("eval\t'-1-2j'\n");
    t.push_str("eval\t'3j'\n");
    t.push_str("eval\t\"'abc'\"\n");
    t.push_str("eval\t\"b'x\\\\x00'\"\n");
    t.push_str("eval\t\"[1, 'two', (3, 4.0), None, True]\"\n");
    t.push_str("eval\t\"{'a': 1, 'b': [2, 3], 'c': {'d': None}}\"\n");
    t.push_str("eval\t'(1,)'\n");
    t.push_str("eval\t'()'\n");
    t.push_str("eval\t'{}'\n");
    t.push_str("eval\t'set()'\n");
    t.push_str("eval\t'  [1, 2]'\n");
    t.push_str("eval\t\"{'k': -0.5, 'j': 1e100, 'big': 123456789012345678901234567890}\"\n");
    t.push_str("eval\t\"'multi' 'part'\"\n");
    t.push_str("eval\t'[1, 2,]'\n");
    t.push_str("eval\t'1 + 2'\n");
    t.push_str("eval\t'x'\n");
    t.push_str("eval\t'f(1)'\n");
    t.push_str("eval\t\"-'a'\"\n");
    t.push_str("eval\t'{**a}'\n");
    t.push_str("eval\t'[1, 2] + [3]'\n");
    t.push_str("eval\t\"(1, [2, (3, {'x': ()})])\"\n");
    v.push(DataFile { path: "jobs.tsv".to_string(), hex: false, body: t });
}

fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("\"\"\"A small shop: products, carts and prices.\"\"\"\n");
    t.push_str("\n");
    t.push_str("from .models import Product, Cart\n");
    t.push_str("from .pricing import total, apply_discount\n");
    t.push_str("\n");
    t.push_str("__all__ = [\"Product\", \"Cart\", \"total\", \"apply_discount\"]\n");
    t.push_str("__version__ = \"1.4.0\"\n");
    v.push(DataFile { path: "project/shop/__init__.py".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("#!/usr/bin/env python3\n");
    t.push_str("\"\"\"Command line: shop add SKU QTY, shop total.\"\"\"\n");
    t.push_str("import argparse\n");
    t.push_str("import sys\n");
    t.push_str("import logging as log\n");
    t.push_str("from pathlib import Path\n");
    t.push_str("from . import models\n");
    t.push_str("from .pricing import total, split as split_amount\n");
    t.push_str("\n");
    t.push_str("CATALOG = {\n");
    t.push_str("    \"A1\": models.Product(\"A1\", \"Mug\", 850, (\"kitchen\",)),\n");
    t.push_str("    \"B2\": models.Product(\"B2\", \"Tea\", 1299),\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def parse_args(argv=None):\n");
    t.push_str("    p = argparse.ArgumentParser(prog=\"shop\")\n");
    t.push_str("    sub = p.add_subparsers(dest=\"cmd\", required=True)\n");
    t.push_str("    add = sub.add_parser(\"add\")\n");
    t.push_str("    add.add_argument(\"sku\")\n");
    t.push_str("    add.add_argument(\"qty\", type=int, nargs=\"?\", default=1)\n");
    t.push_str("    sub.add_parser(\"total\")\n");
    t.push_str("    return p.parse_args(argv)\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("async def fetch_rates(session, url):\n");
    t.push_str("    async with session.get(url) as resp:\n");
    t.push_str("        async for chunk in resp.content:\n");
    t.push_str("            yield chunk\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def main(argv=None) -> int:\n");
    t.push_str("    args = parse_args(argv)\n");
    t.push_str("    cart = models.Cart()\n");
    t.push_str("    while True:\n");
    t.push_str("        try:\n");
    t.push_str("            if args.cmd == \"add\":\n");
    t.push_str("                cart.add(CATALOG[args.sku], args.qty)\n");
    t.push_str("            break\n");
    t.push_str("        except KeyError as e:\n");
    t.push_str("            print(f\"no such product: {e}\", file=sys.stderr)\n");
    t.push_str("            return 1\n");
    t.push_str("        finally:\n");
    t.push_str("            log.debug(\"done\")\n");
    t.push_str("    with open(Path(\"cart.txt\"), \"w\") as out, open(\"log\", \"a\"):\n");
    t.push_str("        for line in cart:\n");
    t.push_str("            out.write(f\"{line.product.sku}\\t{line.qty}\\n\")\n");
    t.push_str("    print(total(cart), *split_amount(total(cart), 3), sep=\", \")\n");
    t.push_str("    return 0 if len(cart) else 2\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("if __name__ == \"__main__\":\n");
    t.push_str("    sys.exit(main())\n");
    v.push(DataFile { path: "project/shop/cli.py".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("\"\"\"The data the shop keeps.\"\"\"\n");
    t.push_str("from __future__ import annotations\n");
    t.push_str("\n");
    t.push_str("import dataclasses\n");
    t.push_str("from dataclasses import dataclass, field\n");
    t.push_str("from typing import Iterator, Optional\n");
    t.push_str("import json, os\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("@dataclass(frozen=True)\n");
    t.push_str("class Product:\n");
    t.push_str("    \"\"\"A thing for sale.\n");
    t.push_str("\n");
    t.push_str("    Prices are in cents, so sums stay exact.\n");
    t.push_str("    \"\"\"\n");
    t.push_str("\n");
    t.push_str("    sku: str\n");
    t.push_str("    name: str\n");
    t.push_str("    price: int\n");
    t.push_str("    tags: tuple[str, ...] = ()\n");
    t.push_str("\n");
    t.push_str("    def label(self, *, currency: str = \"EUR\") -> str:\n");
    t.push_str("        return f\"{self.name} ({self.price / 100:.2f} {currency})\"\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("@dataclass\n");
    t.push_str("class Line:\n");
    t.push_str("    product: Product\n");
    t.push_str("    qty: int = 1\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("class Cart:\n");
    t.push_str("    \"\"\"Lines by SKU.\"\"\"\n");
    t.push_str("\n");
    t.push_str("    def __init__(self, owner: Optional[str] = None) -> None:\n");
    t.push_str("        self.owner = owner\n");
    t.push_str("        self._lines: dict[str, Line] = {}\n");
    t.push_str("\n");
    t.push_str("    def add(self, product: Product, qty: int = 1) -> None:\n");
    t.push_str("        if qty <= 0:\n");
    t.push_str("            raise ValueError(f\"bad quantity {qty!r}\")\n");
    t.push_str("        line = self._lines.get(product.sku)\n");
    t.push_str("        if line is None:\n");
    t.push_str("            self._lines[product.sku] = Line(product, qty)\n");
    t.push_str("        else:\n");
    t.push_str("            line.qty += qty\n");
    t.push_str("\n");
    t.push_str("    def remove(self, sku: str) -> bool:\n");
    t.push_str("        return self._lines.pop(sku, None) is not None\n");
    t.push_str("\n");
    t.push_str("    def __iter__(self) -> Iterator[Line]:\n");
    t.push_str("        yield from sorted(self._lines.values(), key=lambda l: l.product.sku)\n");
    t.push_str("\n");
    t.push_str("    def __len__(self):\n");
    t.push_str("        return sum(l.qty for l in self._lines.values())\n");
    t.push_str("\n");
    t.push_str("    @property\n");
    t.push_str("    def empty(self) -> bool:\n");
    t.push_str("        return not self._lines\n");
    v.push(DataFile { path: "project/shop/models.py".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("\"\"\"Totals, discounts and tax.\"\"\"\n");
    t.push_str("import math\n");
    t.push_str("from decimal import Decimal, ROUND_HALF_UP\n");
    t.push_str("from .models import Cart, Line\n");
    t.push_str("\n");
    t.push_str("TAX_RATES = {\"standard\": 0.21, \"reduced\": 0.09, \"zero\": 0.0}\n");
    t.push_str("BULK = [(100, 0.15), (50, 0.10), (10, 0.05)]\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def line_price(line: Line) -> int:\n");
    t.push_str("    for threshold, rate in BULK:\n");
    t.push_str("        if line.qty >= threshold:\n");
    t.push_str("            return round(line.product.price * line.qty * (1 - rate))\n");
    t.push_str("    return line.product.price * line.qty\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def total(cart: Cart, tax: str = \"standard\") -> int:\n");
    t.push_str("    \"\"\"The cart's total in cents, tax included.\"\"\"\n");
    t.push_str("    try:\n");
    t.push_str("        rate = TAX_RATES[tax]\n");
    t.push_str("    except KeyError:\n");
    t.push_str("        raise ValueError(f\"unknown tax class: {tax}\") from None\n");
    t.push_str("    net = sum(line_price(l) for l in cart)\n");
    t.push_str("    return int(Decimal(net * (1 + rate)).quantize(Decimal(1), ROUND_HALF_UP))\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def apply_discount(amount, code=None, *, codes=None):\n");
    t.push_str("    codes = codes or {}\n");
    t.push_str("    if not code:\n");
    t.push_str("        return amount\n");
    t.push_str("    elif code in codes and codes[code] > 0:\n");
    t.push_str("        pct = codes[code]\n");
    t.push_str("        return amount - amount * pct // 100\n");
    t.push_str("    elif code.startswith(\"FLAT\") and code[4:].isdigit():\n");
    t.push_str("        return max(0, amount - int(code[4:]))\n");
    t.push_str("    else:\n");
    t.push_str("        return amount\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def split(amount: int, ways: int) -> list[int]:\n");
    t.push_str("    base, extra = divmod(amount, ways)\n");
    t.push_str("    return [base + (1 if i < extra else 0) for i in range(ways)]\n");
    v.push(DataFile { path: "project/shop/pricing.py".to_string(), hex: false, body: t });
    let mut t = String.new();
    v.push(DataFile { path: "project/shop/util/__init__.py".to_string(), hex: false, body: t });
}

fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("\"\"\"Text helpers.\"\"\"\n");
    t.push_str("import re\n");
    t.push_str("import unicodedata as ud\n");
    t.push_str("\n");
    t.push_str("_WS = re.compile(r\"\\s+\")\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def slug(s: str, sep=\"-\") -> str:\n");
    t.push_str("    s = ud.normalize(\"NFKD\", s).encode(\"ascii\", \"ignore\").decode()\n");
    t.push_str("    return sep.join(w for w in _WS.split(s.lower()) if w.isalnum())\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def wrap(text, width=70):\n");
    t.push_str("    words, line, out = text.split(), [], []\n");
    t.push_str("    for w in words:\n");
    t.push_str("        if line and len(\" \".join(line + [w])) > width:\n");
    t.push_str("            out.append(\" \".join(line))\n");
    t.push_str("            line = [w]\n");
    t.push_str("        else:\n");
    t.push_str("            line.append(w)\n");
    t.push_str("    if line:\n");
    t.push_str("        out.append(\" \".join(line))\n");
    t.push_str("    return \"\\n\".join(out)\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def ellipsis(s, n):\n");
    t.push_str("    return s if len(s) <= n else s[: n - 1] + \"\\u2026\"\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def counts(words):\n");
    t.push_str("    seen = {}\n");
    t.push_str("    for w in words:\n");
    t.push_str("        seen[w] = seen.get(w, 0) + 1\n");
    t.push_str("    return {k: v for k, v in sorted(seen.items(), key=lambda kv: (-kv[1], kv[0])) if v > 1}\n");
    v.push(DataFile { path: "project/shop/util/text.py".to_string(), hex: false, body: t });
}
