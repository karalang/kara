// mini_ast: Python 3.13's ast module in Kara. ast.parse (the PEG
// parser's rules, its positions and its error messages, on top of the
// tokenizer), ast.dump, ast.unparse, ast.literal_eval and
// ast.get_docstring, with a few code-base tools on top: an outline, an
// import graph, unused imports, cyclomatic complexity and node counts.
// ------------------------------------------------------------ text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

// Text with no surrogates in it, as a String.
fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in s {
        if c < 0x80 {
            out.push(c as u8);
        } else if c < 0x800 {
            out.push((0xC0 | (c >> 6)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else if c < 0x10000 {
            out.push((0xE0 | (c >> 12)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (c >> 18)) as u8);
            out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts_with(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    if p.len() > s.len() {
        return false;
    }
    for i in 0..p.len() {
        if s[i] != p[i] {
            return false;
        }
    }
    true
}

fn hex_n(c: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(c >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_val(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 102 {
        return c - 87;
    }
    if c >= 65 and c <= 70 {
        return c - 55;
    }
    -1
}

fn split_cp(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn split_tabs(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\t' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// the lines of a file, without their \n, as Python's iteration gives
// them
fn text_lines(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn sort_strings(v: mut ref Vec[String]) {
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and v[j] < v[j - 1] {
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn is_surrogate(c: i64) -> bool {
    c >= 0xD800 and c <= 0xDFFF
}

// ------------------------------------------------------------ reprs

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

// repr() of a str
fn repr_of(s: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
    to_string(out)
}

fn pr(s: ref String) -> String {
    repr_of(cps(s))
}

// ------------------------------------------------------------ the tokenizer
//
// A port of Parser/lexer/lexer.c as Python 3.13 runs it for the tokenize
// module (extra tokens on), and of the token building in
// Python/Python-tokenize.c. The source is held whole; `inp` is the end
// of the last line read, as the C readline buffer has it, so line
// numbers and columns come out where the C code puts them.

const EOF: i64 = -1;
const BAD: i64 = -2;

const E_OK: i64 = 0;
const E_EOF: i64 = 1;
const E_DEDENT: i64 = 2;
const E_TABSPACE: i64 = 3;
const E_LINECONT: i64 = 4;
const E_ERROR: i64 = 5;

const T_ERROR: i64 = 0;
const T_NAME: i64 = 1;
const T_NUMBER: i64 = 2;
const T_STRING: i64 = 3;
const T_OP: i64 = 4;
const T_NEWLINE: i64 = 5;
const T_NL: i64 = 6;
const T_COMMENT: i64 = 7;
const T_INDENT: i64 = 8;
const T_DEDENT: i64 = 9;
const T_ENDMARKER: i64 = 10;
const T_FSTART: i64 = 11;
const T_FMIDDLE: i64 = 12;
const T_FEND: i64 = 13;
const T_ENCODING: i64 = 14;

fn type_name(t: i64) -> String {
    let names = vec!["ERRORTOKEN", "NAME", "NUMBER", "STRING", "OP", "NEWLINE", "NL", "COMMENT", "INDENT", "DEDENT", "ENDMARKER", "FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END", "ENCODING"];
    names[t].to_string()
}

// token.EXACT_TOKEN_TYPES
fn exact_name(s: ref String) -> String {
    let table = vec![
        ("!", "EXCLAMATION"), ("!=", "NOTEQUAL"), ("%", "PERCENT"), ("%=", "PERCENTEQUAL"),
        ("&", "AMPER"), ("&=", "AMPEREQUAL"), ("(", "LPAR"), (")", "RPAR"), ("*", "STAR"),
        ("**", "DOUBLESTAR"), ("**=", "DOUBLESTAREQUAL"), ("*=", "STAREQUAL"), ("+", "PLUS"),
        ("+=", "PLUSEQUAL"), (",", "COMMA"), ("-", "MINUS"), ("-=", "MINEQUAL"), ("->", "RARROW"),
        (".", "DOT"), ("...", "ELLIPSIS"), ("/", "SLASH"), ("//", "DOUBLESLASH"),
        ("//=", "DOUBLESLASHEQUAL"), ("/=", "SLASHEQUAL"), (":", "COLON"), (":=", "COLONEQUAL"),
        (";", "SEMI"), ("<", "LESS"), ("<<", "LEFTSHIFT"), ("<<=", "LEFTSHIFTEQUAL"),
        ("<=", "LESSEQUAL"), ("=", "EQUAL"), ("==", "EQEQUAL"), (">", "GREATER"),
        (">=", "GREATEREQUAL"), (">>", "RIGHTSHIFT"), (">>=", "RIGHTSHIFTEQUAL"), ("@", "AT"),
        ("@=", "ATEQUAL"), ("[", "LSQB"), ("]", "RSQB"), ("^", "CIRCUMFLEX"),
        ("^=", "CIRCUMFLEXEQUAL"), ("{", "LBRACE"), ("|", "VBAR"), ("|=", "VBAREQUAL"),
        ("}", "RBRACE"), ("~", "TILDE"),
    ];
    for (k, v) in table {
        if s == k {
            return v.to_string();
        }
    }
    "OP".to_string()
}

fn is_two(a: i64, b: i64) -> bool {
    let s = to_string(vec![a, b]);
    let pairs = vec!["!=", "%=", "&=", "**", "*=", "+=", "-=", "->", "//", "/=", ":=", "<<", "<=", "==", ">=", ">>", "@=", "^=", "|="];
    for p in pairs {
        if s == p {
            return true;
        }
    }
    false
}

fn is_three(a: i64, b: i64, c: i64) -> bool {
    let s = to_string(vec![a, b, c]);
    s == "**=" or s == "//=" or s == "<<=" or s == ">>="
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn is_xdigit(c: i64) -> bool {
    is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

fn is_id_start(c: i64) -> bool {
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 or c >= 128
}

fn is_id_char(c: i64) -> bool {
    is_id_start(c) or is_digit(c)
}

fn lower(c: i64) -> i64 {
    if c >= 65 and c <= 90 { c + 32 } else { c }
}

// One entry of the C tokenizer's mode stack. The bottom entry is the
// regular mode; each f-string pushes one, which flips between reading
// its literal text (`fstring`) and reading an expression.
#[derive(Clone)]
struct Mode {
    fstring: bool,
    quote: i64,
    quote_size: i64,
    raw: bool,
    start: i64,
    multi_line_start: i64,
    line_no: i64,
    depth: i64,
    expr_depth: i64,
    in_spec: bool,
    debug: bool,
}

fn regular_mode() -> Mode {
    Mode { fstring: false, quote: 0, quote_size: 0, raw: false, start: 0, multi_line_start: 0, line_no: 0, depth: 0, expr_depth: 0, in_spec: false, debug: false }
}

#[derive(Clone)]
struct Tok {
    ty: i64,
    text: Vec[i64],
    sr: i64,
    sc: i64,
    er: i64,
    ec: i64,
    scb: i64,
    ecb: i64,
}

#[derive(Clone)]
struct TokErr {
    kind: String,
    msg: String,
    line: i64,
    col: i64,
}

struct Lexed {
    toks: Vec[Tok],
    failed: bool,
    err: TokErr,
}

struct Lx {
    s: Vec[i64],
    n: i64,
    line_ends: Vec[i64],
    implicit: bool,
    implicit_now: bool,
    cur: i64,
    inp: i64,
    buf: i64,
    start: i64,
    lineno: i64,
    line_start: i64,
    first_lineno: i64,
    multi_line_start: i64,
    done: i64,
    atbol: bool,
    level: i64,
    indstack: Vec[i64],
    altindstack: Vec[i64],
    pendin: i64,
    comment_newline: bool,
    modes: Vec[Mode],
    ps: i64,
    pe: i64,
    err: TokErr,
    parse_mode: bool,
    parens: Vec[i64],
    paren_lines: Vec[i64],
    paren_cols: Vec[i64],
}

fn new_lexer(text: ref Vec[i64], parse_mode: bool) -> Lx {
    let mut s = text.clone();
    let mut implicit = false;
    if s.len() > 0 and s[s.len() - 1] != 10 {
        s.push(10);
        implicit = true;
    }
    let mut ends: Vec[i64] = Vec.new();
    for i in 0..s.len() {
        if s[i] == 10 {
            ends.push(i + 1);
        }
    }
    let n = s.len();
    Lx {
        s: s, n: n, line_ends: ends, implicit: implicit, implicit_now: false,
        cur: 0, inp: 0, buf: 0, start: -1, lineno: 0, line_start: 0,
        first_lineno: 0, multi_line_start: 0, done: E_OK, atbol: true, level: 0,
        indstack: vec![0], altindstack: vec![0], pendin: 0, comment_newline: false,
        modes: vec![regular_mode()], ps: -1, pe: -1,
        err: TokErr { kind: String.new(), msg: String.new(), line: 0, col: 0 },
        parse_mode: parse_mode, parens: Vec.new(), paren_lines: Vec.new(), paren_cols: Vec.new(),
    }
}

// tok_nextc: the next character, reading the next line when the current
// one is used up.
fn nextc(lx: mut ref Lx) -> i64 {
    if lx.cur != lx.inp {
        lx.cur += 1;
        return lx.s[lx.cur - 1];
    }
    if lx.done != E_OK {
        return EOF;
    }
    if lx.start < 0 and lx.modes.len() == 1 {
        lx.buf = lx.inp;
    }
    if lx.inp >= lx.n {
        lx.done = E_EOF;
        lx.cur = lx.inp;
        return EOF;
    }
    lx.lineno += 1;
    lx.line_start = lx.cur;
    lx.inp = lx.line_ends[lx.lineno - 1];
    if lx.implicit and lx.lineno == lx.line_ends.len() {
        lx.implicit_now = true;
    }
    lx.cur += 1;
    lx.s[lx.cur - 1]
}

fn backup(lx: mut ref Lx, c: i64) {
    if c != EOF {
        lx.cur -= 1;
    }
}

fn syntax_error(lx: mut ref Lx, msg: own String) -> i64 {
    let col = lx.cur - lx.line_start;
    syntax_error_at(mut lx, msg, col)
}

// The tokenize module reports an unterminated triple-quoted string in
// its own words; the parser keeps the tokenizer's.
fn syntax_error_at(lx: mut ref Lx, msg: own String, col: i64) -> i64 {
    let m = if not lx.parse_mode and msg.starts_with("unterminated triple-quoted string literal") { "EOF in multi-line string".to_string() } else { msg };
    let kind = if lx.parse_mode { "SyntaxError" } else { "TokenError" };
    lx.err = TokErr { kind: kind.to_string(), msg: m, line: lx.lineno, col: col };
    lx.done = E_ERROR;
    T_ERROR
}

fn indent_error(lx: mut ref Lx) -> i64 {
    lx.done = E_TABSPACE;
    lx.cur = lx.inp;
    T_ERROR
}

// tok_continuation_line: a backslash must end its line, and a line must
// follow it.
fn continuation_line(lx: mut ref Lx) -> i64 {
    let mut c = nextc(mut lx);
    if c == 13 {
        c = nextc(mut lx);
    }
    if c != 10 {
        lx.done = E_LINECONT;
        return BAD;
    }
    c = nextc(mut lx);
    if c == EOF {
        lx.done = E_EOF;
        lx.cur = lx.inp;
        return BAD;
    }
    backup(mut lx, c);
    c
}

fn tok_out(lx: mut ref Lx, ty: i64) -> i64 {
    lx.ps = lx.start;
    lx.pe = lx.cur;
    ty
}

// ------------------------------------------------------------ numbers

fn decimal_tail(lx: mut ref Lx) -> i64 {
    loop {
        let mut c = nextc(mut lx);
        while is_digit(c) {
            c = nextc(mut lx);
        }
        if c != 95 {
            return c;
        }
        c = nextc(mut lx);
        if not is_digit(c) {
            backup(mut lx, c);
            syntax_error(mut lx, "invalid decimal literal".to_string());
            return BAD;
        }
    }
}

fn finish_number(lx: mut ref Lx, c: i64) -> i64 {
    backup(mut lx, c);
    tok_out(mut lx, T_NUMBER)
}

fn num_imaginary(lx: mut ref Lx, c: i64) -> i64 {
    if c == 106 or c == 74 {
        let d = nextc(mut lx);
        return finish_number(mut lx, d);
    }
    finish_number(mut lx, c)
}

fn num_exponent(lx: mut ref Lx, e: i64) -> i64 {
    let mut c = nextc(mut lx);
    if c == 43 or c == 45 {
        c = nextc(mut lx);
        if not is_digit(c) {
            backup(mut lx, c);
            return syntax_error(mut lx, "invalid decimal literal".to_string());
        }
    } else if not is_digit(c) {
        backup(mut lx, c);
        backup(mut lx, e);
        return tok_out(mut lx, T_NUMBER);
    }
    c = decimal_tail(mut lx);
    if c == BAD {
        return T_ERROR;
    }
    num_imaginary(mut lx, c)
}

fn num_exp_part(lx: mut ref Lx, c: i64) -> i64 {
    if c == 101 or c == 69 {
        return num_exponent(mut lx, c);
    }
    num_imaginary(mut lx, c)
}

fn num_fraction(lx: mut ref Lx, c0: i64) -> i64 {
    let mut c = c0;
    if is_digit(c) {
        c = decimal_tail(mut lx);
        if c == BAD {
            return T_ERROR;
        }
    }
    num_exp_part(mut lx, c)
}

fn num_after_int(lx: mut ref Lx, c: i64) -> i64 {
    if c == 46 {
        let d = nextc(mut lx);
        return num_fraction(mut lx, d);
    }
    num_exp_part(mut lx, c)
}

fn digit_text(c: i64) -> String {
    to_string(vec![c])
}

// Hex, octal and binary: `bits` names the kind, `ok` says which digits
// it takes.
fn based_number(lx: mut ref Lx, kind: Str, base: i64) -> i64 {
    let mut c = nextc(mut lx);
    loop {
        if c == 95 {
            c = nextc(mut lx);
        }
        if not digit_in(c, base) {
            if base != 16 and is_digit(c) {
                return syntax_error(mut lx, f"invalid digit '{digit_text(c)}' in {kind} literal");
            }
            backup(mut lx, c);
            return syntax_error(mut lx, f"invalid {kind} literal");
        }
        c = nextc(mut lx);
        while digit_in(c, base) {
            c = nextc(mut lx);
        }
        if c != 95 {
            break;
        }
    }
    if base != 16 and is_digit(c) {
        return syntax_error(mut lx, f"invalid digit '{digit_text(c)}' in {kind} literal");
    }
    finish_number(mut lx, c)
}

fn digit_in(c: i64, base: i64) -> bool {
    if base == 16 {
        is_xdigit(c)
    } else {
        c >= 48 and c < 48 + base
    }
}

fn lex_number(lx: mut ref Lx, c0: i64) -> i64 {
    let mut c = c0;
    if c == 48 {
        c = nextc(mut lx);
        if c == 120 or c == 88 {
            return based_number(mut lx, "hexadecimal", 16);
        }
        if c == 111 or c == 79 {
            return based_number(mut lx, "octal", 8);
        }
        if c == 98 or c == 66 {
            return based_number(mut lx, "binary", 2);
        }
        loop {
            if c == 95 {
                c = nextc(mut lx);
                if not is_digit(c) {
                    backup(mut lx, c);
                    return syntax_error(mut lx, "invalid decimal literal".to_string());
                }
            }
            if c != 48 {
                break;
            }
            c = nextc(mut lx);
        }
        let mut nonzero = false;
        if is_digit(c) {
            nonzero = true;
            c = decimal_tail(mut lx);
            if c == BAD {
                return T_ERROR;
            }
        }
        if nonzero and lx.parse_mode and c != 46 and c != 101 and c != 69 and c != 106 and c != 74 {
            backup(mut lx, c);
            let col = lx.start + 1 - lx.line_start;
            return syntax_error_at(mut lx, "leading zeros in decimal integer literals are not permitted; use an 0o prefix for octal integers".to_string(), col);
        }
        return num_after_int(mut lx, c);
    }
    c = decimal_tail(mut lx);
    if c == BAD {
        return T_ERROR;
    }
    num_after_int(mut lx, c)
}

// ------------------------------------------------------------ regular mode

fn get_normal(lx: mut ref Lx) -> i64 {
    // nextline
    lx.start = -1;
    let mut blankline = false;
    if lx.atbol {
        let mut col = 0;
        let mut altcol = 0;
        lx.atbol = false;
        let mut cont_line_col = 0;
        let mut c = 0;
        loop {
            c = nextc(mut lx);
            if c == 32 {
                col += 1;
                altcol += 1;
            } else if c == 9 {
                col = (col / 8 + 1) * 8;
                altcol += 1;
            } else if c == 12 {
                col = 0;
                altcol = 0;
            } else if c == 92 {
                if cont_line_col == 0 {
                    cont_line_col = col;
                }
                if continuation_line(mut lx) == BAD {
                    return T_ERROR;
                }
            } else {
                break;
            }
        }
        backup(mut lx, c);
        if c == 35 or c == 10 or c == 13 {
            blankline = true;
        }
        if not blankline and lx.level == 0 {
            if cont_line_col != 0 {
                col = cont_line_col;
                altcol = cont_line_col;
            }
            let k = lx.indstack.len() - 1;
            if col == lx.indstack[k] {
                if altcol != lx.altindstack[k] {
                    return indent_error(mut lx);
                }
            } else if col > lx.indstack[k] {
                if altcol <= lx.altindstack[k] {
                    return indent_error(mut lx);
                }
                lx.pendin += 1;
                lx.indstack.push(col);
                lx.altindstack.push(altcol);
            } else {
                while lx.indstack.len() > 1 and col < lx.indstack[lx.indstack.len() - 1] {
                    lx.pendin -= 1;
                    lx.indstack.pop();
                    lx.altindstack.pop();
                }
                let j = lx.indstack.len() - 1;
                if col != lx.indstack[j] {
                    lx.done = E_DEDENT;
                    lx.cur = lx.inp;
                    return T_ERROR;
                }
                if altcol != lx.altindstack[j] {
                    return indent_error(mut lx);
                }
            }
        }
    }

    lx.start = lx.cur;
    if lx.pendin != 0 {
        if lx.pendin < 0 {
            lx.pendin += 1;
            lx.ps = lx.cur;
            lx.pe = lx.cur;
            return T_DEDENT;
        }
        lx.pendin -= 1;
        lx.ps = lx.buf;
        lx.pe = lx.cur;
        return T_INDENT;
    }

    let peek = nextc(mut lx);
    backup(mut lx, peek);

    loop {
        // again
        lx.start = -1;
        let mut c = nextc(mut lx);
        while c == 32 or c == 9 or c == 12 {
            c = nextc(mut lx);
        }
        lx.start = lx.cur - 1;

        if c == 35 {
            while c != EOF and c != 10 and c != 13 {
                c = nextc(mut lx);
            }
            let p = lx.start;
            backup(mut lx, c);
            lx.ps = p;
            lx.pe = lx.cur;
            lx.comment_newline = blankline;
            return T_COMMENT;
        }

        if c == EOF {
            if lx.level > 0 {
                return T_ERROR;
            }
            lx.ps = -1;
            lx.pe = -1;
            return if lx.done == E_EOF { T_ENDMARKER } else { T_ERROR };
        }

        // identifiers, and the prefixes of string literals
        let mut go = 0;
        if is_id_start(c) {
            let mut saw_b = false;
            let mut saw_r = false;
            let mut saw_u = false;
            let mut saw_f = false;
            loop {
                if not (saw_b or saw_u or saw_f) and (c == 98 or c == 66) {
                    saw_b = true;
                } else if not (saw_b or saw_u or saw_r or saw_f) and (c == 117 or c == 85) {
                    saw_u = true;
                } else if not (saw_r or saw_u) and (c == 114 or c == 82) {
                    saw_r = true;
                } else if not (saw_f or saw_b or saw_u) and (c == 102 or c == 70) {
                    saw_f = true;
                } else {
                    break;
                }
                c = nextc(mut lx);
                if c == 34 or c == 39 {
                    go = if saw_f { 1 } else { 2 };
                    break;
                }
            }
            if go == 0 {
                while is_id_char(c) {
                    c = nextc(mut lx);
                }
                backup(mut lx, c);
                return tok_out(mut lx, T_NAME);
            }
        }

        if go == 0 {
            if c == 13 {
                c = nextc(mut lx);
            }
            if c == 10 {
                lx.atbol = true;
                if blankline or lx.level > 0 {
                    lx.comment_newline = false;
                    return tok_out(mut lx, T_NL);
                }
                if lx.comment_newline {
                    lx.comment_newline = false;
                    return tok_out(mut lx, T_NL);
                }
                lx.ps = lx.start;
                lx.pe = lx.cur - 1;
                return T_NEWLINE;
            }

            if c == 46 {
                c = nextc(mut lx);
                if is_digit(c) {
                    return num_fraction(mut lx, c);
                }
                if c == 46 {
                    c = nextc(mut lx);
                    if c == 46 {
                        return tok_out(mut lx, T_OP);
                    }
                    backup(mut lx, c);
                    backup(mut lx, 46);
                } else {
                    backup(mut lx, c);
                }
                return tok_out(mut lx, T_OP);
            }

            if is_digit(c) {
                return lex_number(mut lx, c);
            }
        }

        if go == 1 {
            return fstring_start(mut lx, c);
        }

        if c == 39 or c == 34 {
            return lex_string(mut lx, c);
        }

        if c == 92 {
            if continuation_line(mut lx) == BAD {
                return T_ERROR;
            }
            continue;
        }

        return punctuation(mut lx, c);
    }
}

fn fstring_start(lx: mut ref Lx, quote: i64) -> i64 {
    let mut quote_size = 1;
    lx.first_lineno = lx.lineno;
    lx.multi_line_start = lx.line_start;
    let after = nextc(mut lx);
    if after == quote {
        let after2 = nextc(mut lx);
        if after2 == quote {
            quote_size = 3;
        } else {
            backup(mut lx, after2);
            backup(mut lx, after);
        }
    }
    if after != quote {
        backup(mut lx, after);
    }
    lx.ps = lx.start;
    lx.pe = lx.cur;
    let first = lower(lx.s[lx.start]);
    let raw = if first == 102 { lower(lx.s[lx.start + 1]) == 114 } else { true };
    lx.modes.push(Mode {
        fstring: true, quote: quote, quote_size: quote_size, raw: raw, start: lx.start,
        multi_line_start: lx.line_start, line_no: lx.lineno, depth: 0, expr_depth: -1,
        in_spec: false, debug: false,
    });
    T_FSTART
}

fn lex_string(lx: mut ref Lx, quote: i64) -> i64 {
    let mut quote_size = 1;
    let mut end_quote_size = 0;
    let mut has_escaped_quote = false;
    lx.first_lineno = lx.lineno;
    lx.multi_line_start = lx.line_start;
    let mut c = nextc(mut lx);
    if c == quote {
        c = nextc(mut lx);
        if c == quote {
            quote_size = 3;
        } else {
            end_quote_size = 1;
        }
    }
    if c != quote {
        backup(mut lx, c);
    }
    while end_quote_size != quote_size {
        c = nextc(mut lx);
        if c == EOF or (quote_size == 1 and c == 10) {
            lx.cur = lx.start + 1;
            lx.line_start = lx.multi_line_start;
            let at = lx.lineno;
            lx.lineno = lx.first_lineno;
            let top = lx.modes.len() - 1;
            if top > 0 and lx.modes[top].quote == quote and lx.modes[top].quote_size == quote_size {
                return syntax_error(mut lx, "f-string: expecting '}'".to_string());
            }
            if quote_size == 3 {
                return syntax_error(mut lx, f"unterminated triple-quoted string literal (detected at line {at})");
            }
            if has_escaped_quote {
                return syntax_error(mut lx, f"unterminated string literal (detected at line {at}); perhaps you escaped the end quote?");
            }
            return syntax_error(mut lx, f"unterminated string literal (detected at line {at})");
        }
        if c == quote {
            end_quote_size += 1;
        } else {
            end_quote_size = 0;
            if c == 92 {
                c = nextc(mut lx);
                if c == quote {
                    has_escaped_quote = true;
                }
                if c == 13 {
                    c = nextc(mut lx);
                }
            }
        }
    }
    tok_out(mut lx, T_STRING)
}

fn punctuation(lx: mut ref Lx, c: i64) -> i64 {
    let top = lx.modes.len() - 1;
    let inside = top > 0;
    if inside and (c == 58 or c == 125 or c == 33 or c == 123) and lx.modes[top].expr_depth >= 0 {
        let cursor = lx.modes[top].depth - (if c != 123 { 1 } else { 0 });
        if c == 58 and cursor == lx.modes[top].expr_depth {
            lx.modes[top].fstring = true;
            lx.modes[top].in_spec = true;
            return tok_out(mut lx, T_OP);
        }
    }

    let c2 = nextc(mut lx);
    if is_two(c, c2) {
        let c3 = nextc(mut lx);
        if not is_three(c, c2, c3) {
            backup(mut lx, c3);
        }
        return tok_out(mut lx, T_OP);
    }
    backup(mut lx, c2);

    if c == 40 or c == 91 or c == 123 {
        lx.level += 1;
        lx.parens.push(c);
        lx.paren_lines.push(lx.lineno);
        lx.paren_cols.push(lx.start - lx.line_start);
        if inside {
            lx.modes[top].depth += 1;
        }
    } else if c == 41 or c == 93 or c == 125 {
        if inside and lx.modes[top].depth == 0 and c == 125 {
            return syntax_error(mut lx, "f-string: single '}' is not allowed".to_string());
        }
        if lx.parse_mode and lx.level == 0 {
            return syntax_error(mut lx, f"unmatched '{digit_text(c)}'");
        }
        if lx.level > 0 {
            lx.level -= 1;
            let opening = lx.parens.pop().unwrap();
            let line = lx.paren_lines.pop().unwrap();
            lx.paren_cols.pop();
            let fits = (opening == 40 and c == 41) or (opening == 91 and c == 93) or (opening == 123 and c == 125);
            if lx.parse_mode and not fits {
                if inside and opening == 123 and lx.modes[top].depth - 1 == lx.modes[top].expr_depth {
                    return syntax_error(mut lx, f"f-string: unmatched '{digit_text(c)}'");
                }
                if line != lx.lineno {
                    return syntax_error(mut lx, f"closing parenthesis '{digit_text(c)}' does not match opening parenthesis '{digit_text(opening)}' on line {line}");
                }
                return syntax_error(mut lx, f"closing parenthesis '{digit_text(c)}' does not match opening parenthesis '{digit_text(opening)}'");
            }
        }
        if inside {
            lx.modes[top].depth -= 1;
            if lx.modes[top].depth < 0 {
                return syntax_error(mut lx, f"f-string: unmatched '{digit_text(c)}'");
            }
            if c == 125 and lx.modes[top].depth == lx.modes[top].expr_depth {
                lx.modes[top].expr_depth -= 1;
                lx.modes[top].fstring = true;
                lx.modes[top].in_spec = false;
                lx.modes[top].debug = false;
            }
        }
    }

    if not is_printable(c) {
        return syntax_error(mut lx, f"invalid non-printable character U+{hex_n(c, 4).to_uppercase()}");
    }
    if c == 61 and inside and lx.modes[top].expr_depth >= 0 {
        lx.modes[top].debug = true;
    }
    tok_out(mut lx, T_OP)
}

// ------------------------------------------------------------ f-string mode

fn get_fstring(lx: mut ref Lx) -> i64 {
    let top = lx.modes.len() - 1;
    lx.start = lx.cur;
    lx.first_lineno = lx.lineno;

    let start_char = nextc(mut lx);
    if start_char == 123 {
        let peek1 = nextc(mut lx);
        backup(mut lx, peek1);
        backup(mut lx, start_char);
        if peek1 != 123 {
            lx.modes[top].expr_depth += 1;
            lx.modes[top].fstring = false;
            return get_normal(mut lx);
        }
    } else {
        backup(mut lx, start_char);
    }

    let q = lx.modes[top].quote;
    let qs = lx.modes[top].quote_size;
    let mut at_end = true;
    for _ in 0..qs {
        let c = nextc(mut lx);
        if c != q {
            backup(mut lx, c);
            at_end = false;
            break;
        }
    }
    if at_end {
        lx.ps = lx.start;
        lx.pe = lx.cur;
        lx.modes.pop();
        return T_FEND;
    }

    lx.multi_line_start = lx.line_start;
    let mut end_quote_size = 0;
    let mut unicode_escape = false;
    while end_quote_size != qs {
        let c = nextc(mut lx);
        let in_spec = lx.modes[top].in_spec and lx.modes[top].expr_depth >= 0;
        if c == EOF or (qs == 1 and c == 10) {
            if in_spec and c == 10 {
                if qs == 1 {
                    return syntax_error(mut lx, "f-string: newlines are not allowed in format specifiers for single quoted f-strings".to_string());
                }
                backup(mut lx, c);
                lx.modes[top].fstring = false;
                lx.modes[top].in_spec = false;
                return tok_out(mut lx, T_FMIDDLE);
            }
            lx.cur = lx.modes[top].start + 1;
            lx.line_start = lx.modes[top].multi_line_start;
            let at = lx.lineno;
            lx.lineno = lx.modes[top].line_no;
            if qs == 3 {
                return syntax_error(mut lx, f"unterminated triple-quoted f-string literal (detected at line {at})");
            }
            return syntax_error(mut lx, f"unterminated f-string literal (detected at line {at})");
        }
        if c == q {
            end_quote_size += 1;
            continue;
        }
        end_quote_size = 0;
        if c == 123 {
            let peek = nextc(mut lx);
            if peek != 123 or in_spec {
                backup(mut lx, peek);
                backup(mut lx, c);
                lx.modes[top].expr_depth += 1;
                lx.modes[top].fstring = false;
                lx.modes[top].in_spec = false;
                return tok_out(mut lx, T_FMIDDLE);
            }
            lx.ps = lx.start;
            lx.pe = lx.cur - 1;
            return T_FMIDDLE;
        } else if c == 125 {
            if unicode_escape {
                return tok_out(mut lx, T_FMIDDLE);
            }
            let peek = nextc(mut lx);
            if peek == 125 and not in_spec and lx.modes[top].depth == 0 {
                lx.ps = lx.start;
                lx.pe = lx.cur - 1;
                return T_FMIDDLE;
            }
            backup(mut lx, peek);
            backup(mut lx, c);
            lx.modes[top].fstring = false;
            lx.modes[top].in_spec = false;
            return tok_out(mut lx, T_FMIDDLE);
        } else if c == 92 {
            let mut peek = nextc(mut lx);
            if peek == 13 {
                peek = nextc(mut lx);
            }
            if peek == 123 or peek == 125 {
                backup(mut lx, peek);
                continue;
            }
            if not lx.modes[top].raw and peek == 78 {
                peek = nextc(mut lx);
                if peek == 123 {
                    unicode_escape = true;
                } else {
                    backup(mut lx, peek);
                }
            }
        }
    }
    for _ in 0..qs {
        backup(mut lx, q);
    }
    tok_out(mut lx, T_FMIDDLE)
}

fn tok_get(lx: mut ref Lx) -> i64 {
    let top = lx.modes.len() - 1;
    if lx.modes[top].fstring {
        get_fstring(mut lx)
    } else {
        get_normal(mut lx)
    }
}

// ------------------------------------------------------------ tokens

// The token as Python-tokenize.c builds it: string literals take their
// start line from where they began, the end is on the last line read,
// and the tokens at the end of the file go on the line after it.
fn make_tok(lx: ref Lx, ty: i64) -> Tok {
    let trailing = ty == T_ENDMARKER or (ty == T_DEDENT and lx.done == E_EOF);
    let mut text: Vec[i64] = if lx.ps < 0 { Vec.new() } else { slice(lx.s, lx.ps, lx.pe) };
    let strlit = ty == T_STRING or ty == T_FMIDDLE;
    let ls = if strlit { lx.multi_line_start } else { lx.line_start };
    let mut sr = if strlit { lx.first_lineno } else { lx.lineno };
    let mut er = lx.lineno;
    let mut sc = if lx.ps >= 0 and lx.ps >= ls { lx.ps - ls } else { -1 };
    let mut ec = if lx.pe >= 0 and lx.pe >= lx.line_start { lx.pe - lx.line_start } else { -1 };
    let mut scb = if sc >= 0 { utf8_width(lx.s, ls, lx.ps) } else { -1 };
    let mut ecb = if ec >= 0 { utf8_width(lx.s, lx.line_start, lx.pe) } else { -1 };
    if trailing {
        sr += 1;
        er = sr;
        sc = 0;
        ec = 0;
        scb = 0;
        ecb = 0;
    }
    if ty == T_NEWLINE {
        if not lx.implicit_now {
            text = if lx.s[lx.start] == 13 { cp("\r\n") } else { cp("\n") };
        }
        ec += 1;
        ecb += 1;
    } else if ty == T_NL and lx.implicit_now {
        text = Vec.new();
    }
    Tok { ty: ty, text: text, sr: sr, sc: sc, er: er, ec: ec, scb: scb, ecb: ecb }
}

// _tokenizer_error, for the errors that are not syntax errors
fn state_error(lx: ref Lx) -> TokErr {
    if lx.done == E_ERROR {
        return lx.err.clone();
    }
    let col = if lx.inp - lx.buf < 0 { 0 } else { lx.inp - lx.buf };
    if lx.done == E_EOF {
        return TokErr { kind: "TokenError".to_string(), msg: "unexpected EOF in multi-line statement".to_string(), line: lx.lineno, col: col };
    }
    if lx.done == E_DEDENT {
        return TokErr { kind: "IndentationError".to_string(), msg: "unindent does not match any outer indentation level".to_string(), line: lx.lineno, col: col };
    }
    if lx.done == E_TABSPACE {
        return TokErr { kind: "TabError".to_string(), msg: "inconsistent use of tabs and spaces in indentation".to_string(), line: lx.lineno, col: col };
    }
    if lx.done == E_LINECONT {
        return TokErr { kind: "TokenError".to_string(), msg: "unexpected character after line continuation character".to_string(), line: lx.lineno, col: col };
    }
    TokErr { kind: "TokenError".to_string(), msg: "unknown tokenization error".to_string(), line: lx.lineno, col: col }
}

// How many bytes s[from..to] takes in UTF-8.
fn utf8_width(s: ref Vec[i64], from: i64, to: i64) -> i64 {
    let mut n = 0;
    let mut i = from;
    while i < to {
        let c = s[i];
        n += if c < 0x80 { 1 } else if c < 0x800 { 2 } else if c < 0x10000 { 3 } else { 4 };
        i += 1;
    }
    n
}

// ------------------------------------------------------------ the tree
//
// The nodes live in one arena and refer to each other by index. A node
// has its type name and its fields in the order of the class's _fields,
// so that dump can walk them as they are; a field is a child, a list of
// children (-1 for a None in it), an identifier, an int, a constant, a
// list of identifiers, or absent.

const K_NODE: i64 = 0;
const K_LIST: i64 = 1;
const K_STR: i64 = 2;
const K_INT: i64 = 3;
const K_NONE: i64 = 4;
const K_CONST: i64 = 5;
const K_STRS: i64 = 6;

#[derive(Clone)]
struct Fld {
    name: String,
    k: i64,
    kids: Vec[i64],
    s: String,
    n: i64,
    strs: Vec[String],
}

#[derive(Clone)]
struct N {
    ty: String,
    f: Vec[Fld],
    pos: bool,
    l1: i64,
    c1: i64,
    l2: i64,
    c2: i64,
}

// The kinds of constant: the value a Constant node holds.
const C_INT: i64 = 0;
const C_FLOAT: i64 = 1;
const C_COMPLEX: i64 = 2;
const C_STR: i64 = 3;
const C_BYTES: i64 = 4;
const C_TRUE: i64 = 5;
const C_FALSE: i64 = 6;
const C_NONE: i64 = 7;
const C_ELL: i64 = 8;

// An int is its decimal digits, with a sign when it is negative; a
// float or a complex's imaginary part is `x`; a str or bytes is `s`.
#[derive(Clone)]
struct Cv {
    ck: i64,
    s: Vec[i64],
    num: String,
    x: f64,
}

struct Ast {
    nodes: Vec[N],
    consts: Vec[Cv],
}

fn new_ast() -> Ast {
    Ast { nodes: Vec.new(), consts: Vec.new() }
}

fn cv_of(ck: i64) -> Cv {
    Cv { ck: ck, s: Vec.new(), num: String.new(), x: 0.0 }
}

fn mk(a: mut ref Ast, ty: Str) -> i64 {
    a.nodes.push(N { ty: ty.to_string(), f: Vec.new(), pos: false, l1: 0, c1: 0, l2: 0, c2: 0 });
    a.nodes.len() - 1
}

fn new_fld(name: Str, k: i64) -> Fld {
    Fld { name: name.to_string(), k: k, kids: Vec.new(), s: String.new(), n: 0, strs: Vec.new() }
}

fn add_node(a: mut ref Ast, id: i64, name: Str, child: i64) {
    if child < 0 {
        a.nodes[id].f.push(new_fld(name, K_NONE));
    } else {
        let mut f = new_fld(name, K_NODE);
        f.kids.push(child);
        a.nodes[id].f.push(f);
    }
}

fn add_list(a: mut ref Ast, id: i64, name: Str, kids: ref Vec[i64]) {
    let mut f = new_fld(name, K_LIST);
    f.kids = kids.clone();
    a.nodes[id].f.push(f);
}

fn add_str(a: mut ref Ast, id: i64, name: Str, s: ref String) {
    let mut f = new_fld(name, K_STR);
    f.s = s.clone();
    a.nodes[id].f.push(f);
}

fn add_none(a: mut ref Ast, id: i64, name: Str) {
    a.nodes[id].f.push(new_fld(name, K_NONE));
}

fn add_int(a: mut ref Ast, id: i64, name: Str, n: i64) {
    let mut f = new_fld(name, K_INT);
    f.n = n;
    a.nodes[id].f.push(f);
}

fn add_strs(a: mut ref Ast, id: i64, name: Str, v: ref Vec[String]) {
    let mut f = new_fld(name, K_STRS);
    f.strs = v.clone();
    a.nodes[id].f.push(f);
}

fn set_pos(a: mut ref Ast, id: i64, l1: i64, c1: i64, l2: i64, c2: i64) {
    a.nodes[id].pos = true;
    a.nodes[id].l1 = l1;
    a.nodes[id].c1 = c1;
    a.nodes[id].l2 = l2;
    a.nodes[id].c2 = c2;
}

fn copy_pos(a: mut ref Ast, to: i64, from: i64) {
    let l1 = a.nodes[from].l1;
    let c1 = a.nodes[from].c1;
    let l2 = a.nodes[from].l2;
    let c2 = a.nodes[from].c2;
    set_pos(mut a, to, l1, c1, l2, c2);
}

fn is(a: ref Ast, id: i64, ty: Str) -> bool {
    id >= 0 and a.nodes[id].ty == ty
}

fn ty_of(a: ref Ast, id: i64) -> String {
    a.nodes[id].ty.clone()
}

fn field_at(a: ref Ast, id: i64, name: Str) -> i64 {
    let n = ref a.nodes[id];
    let mut k = 0;
    while k < n.f.len() {
        if n.f[k].name == name {
            return k;
        }
        k += 1;
    }
    -1
}

// The child in a node field, or -1 when it is None.
fn kid(a: ref Ast, id: i64, name: Str) -> i64 {
    let k = field_at(a, id, name);
    if k < 0 or a.nodes[id].f[k].k != K_NODE {
        return -1;
    }
    a.nodes[id].f[k].kids[0]
}

fn kids(a: ref Ast, id: i64, name: Str) -> Vec[i64] {
    let k = field_at(a, id, name);
    if k < 0 or a.nodes[id].f[k].k != K_LIST {
        return Vec.new();
    }
    a.nodes[id].f[k].kids.clone()
}

fn sval(a: ref Ast, id: i64, name: Str) -> String {
    let k = field_at(a, id, name);
    if k < 0 or a.nodes[id].f[k].k != K_STR {
        return String.new();
    }
    a.nodes[id].f[k].s.clone()
}

fn has_str(a: ref Ast, id: i64, name: Str) -> bool {
    let k = field_at(a, id, name);
    k >= 0 and a.nodes[id].f[k].k == K_STR
}

fn ival(a: ref Ast, id: i64, name: Str) -> i64 {
    let k = field_at(a, id, name);
    if k < 0 {
        return 0;
    }
    a.nodes[id].f[k].n
}

fn strs(a: ref Ast, id: i64, name: Str) -> Vec[String] {
    let k = field_at(a, id, name);
    if k < 0 {
        return Vec.new();
    }
    a.nodes[id].f[k].strs.clone()
}

fn set_kid(a: mut ref Ast, id: i64, name: Str, child: i64) {
    let k = field_at(a, id, name);
    a.nodes[id].f[k].k = K_NODE;
    a.nodes[id].f[k].kids = vec![child];
}

fn set_kids(a: mut ref Ast, id: i64, name: Str, v: ref Vec[i64]) {
    let k = field_at(a, id, name);
    a.nodes[id].f[k].kids = v.clone();
}

// The constant a Constant node holds.
fn cv(a: ref Ast, id: i64) -> Cv {
    let k = field_at(a, id, "value");
    a.consts[a.nodes[id].f[k].n].clone()
}

fn const_kind(a: ref Ast, id: i64) -> i64 {
    let k = field_at(a, id, "value");
    a.consts[a.nodes[id].f[k].n].ck
}

// A node with no fields: an expression context or an operator.
fn leaf(a: mut ref Ast, ty: Str) -> i64 {
    mk(mut a, ty)
}

fn constant(a: mut ref Ast, v: own Cv, kind_u: bool) -> i64 {
    let id = mk(mut a, "Constant");
    a.consts.push(v);
    let mut f = new_fld("value", K_CONST);
    f.n = a.consts.len() - 1;
    a.nodes[id].f.push(f);
    if kind_u {
        add_str(mut a, id, "kind", "u".to_string());
    } else {
        add_none(mut a, id, "kind");
    }
    id
}

fn str_const(a: mut ref Ast, s: ref Vec[i64]) -> i64 {
    let mut v = cv_of(C_STR);
    v.s = s.clone();
    constant(mut a, v, false)
}

fn name_node(a: mut ref Ast, id: ref String, ctx: Str) -> i64 {
    let n = mk(mut a, "Name");
    add_str(mut a, n, "id", id);
    let c = leaf(mut a, ctx);
    add_node(mut a, n, "ctx", c);
    n
}

// ------------------------------------------------------------ reprs

fn float_repr(x: f64) -> String {
    f"{x}"
}

// The imaginary part as complex's repr writes it: no `.0` on a whole
// number.
fn imag_repr(x: f64) -> String {
    let s = float_repr(x);
    if s.ends_with(".0") {
        let v = cps(s);
        return to_string(slice(v, 0, v.len() - 2));
    }
    s
}

fn bytes_repr(s: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(98);
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c >= 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    to_string(out)
}

fn const_repr(v: ref Cv) -> String {
    if v.ck == C_INT {
        v.num.clone()
    } else if v.ck == C_FLOAT {
        float_repr(v.x)
    } else if v.ck == C_COMPLEX {
        f"{imag_repr(v.x)}j"
    } else if v.ck == C_STR {
        repr_of(v.s)
    } else if v.ck == C_BYTES {
        bytes_repr(v.s)
    } else if v.ck == C_TRUE {
        "True".to_string()
    } else if v.ck == C_FALSE {
        "False".to_string()
    } else if v.ck == C_NONE {
        "None".to_string()
    } else {
        "Ellipsis".to_string()
    }
}

// ------------------------------------------------------------ dump

// ast.dump: fields that are None or empty lists are left out, except a
// Constant's value; with `attrs`, the positions follow.
fn dump(a: ref Ast, id: i64, attrs: bool) -> String {
    if id < 0 {
        return "None".to_string();
    }
    let n = ref a.nodes[id];
    let mut parts: Vec[String] = Vec.new();
    let mut k = 0;
    while k < n.f.len() {
        let f = ref n.f[k];
        k += 1;
        if f.k == K_NONE {
            continue;
        }
        if f.k == K_NODE {
            parts.push(f"{f.name}={dump(a, f.kids[0], attrs)}");
        } else if f.k == K_LIST {
            if f.kids.len() == 0 {
                continue;
            }
            let mut items: Vec[String] = Vec.new();
            for c in f.kids {
                items.push(dump(a, c, attrs));
            }
            parts.push(f"{f.name}=[{join(items, ", ")}]");
        } else if f.k == K_STR {
            parts.push(f"{f.name}={pr(f.s)}");
        } else if f.k == K_INT {
            parts.push(f"{f.name}={f.n}");
        } else if f.k == K_CONST {
            parts.push(f"{f.name}={const_repr(a.consts[f.n])}");
        } else {
            if f.strs.len() == 0 {
                continue;
            }
            let mut items: Vec[String] = Vec.new();
            for s in f.strs {
                items.push(pr(s));
            }
            parts.push(f"{f.name}=[{join(items, ", ")}]");
        }
    }
    if attrs and n.pos {
        parts.push(f"lineno={n.l1}");
        parts.push(f"col_offset={n.c1}");
        parts.push(f"end_lineno={n.l2}");
        parts.push(f"end_col_offset={n.c2}");
    }
    f"{n.ty}({join(parts, ", ")})"
}

fn join(v: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for s in v {
        if not first {
            out.push_str(sep);
        }
        first = false;
        out.push_str(s);
    }
    out
}

// The children of a node, in field order, as ast.iter_child_nodes
// gives them.
fn children(a: ref Ast, id: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let n = ref a.nodes[id];
    let mut k = 0;
    while k < n.f.len() {
        let f = ref n.f[k];
        if f.k == K_NODE or f.k == K_LIST {
            for c in f.kids {
                if c >= 0 {
                    out.push(c);
                }
            }
        }
        k += 1;
    }
    out
}

// ast.walk: breadth first from the node.
fn walk(a: ref Ast, id: i64) -> Vec[i64] {
    let mut out: Vec[i64] = vec![id];
    let mut i = 0;
    while i < out.len() {
        let next = children(a, out[i]);
        for c in next {
            out.push(c);
        }
        i += 1;
    }
    out
}

// ------------------------------------------------------------ literals

// A str or bytes literal as the parser decodes it: the prefix, the
// quotes, and the escapes unless it is raw. `is_u` says it had a u
// prefix.
struct Lit {
    bytes: bool,
    is_u: bool,
    raw: bool,
    body: Vec[i64],
}

fn split_literal(t: ref Vec[i64]) -> Lit {
    let mut i = 0;
    let mut bytes = false;
    let mut raw = false;
    let mut is_u = false;
    while t[i] != 39 and t[i] != 34 {
        let c = lower(t[i]);
        if c == 98 {
            bytes = true;
        } else if c == 114 {
            raw = true;
        } else if c == 117 {
            is_u = true;
        }
        i += 1;
    }
    let q = t[i];
    let size = if i + 2 < t.len() and t[i + 1] == q and t[i + 2] == q and t.len() - i >= 6 { 3 } else { 1 };
    let body = slice(t, i + size, t.len() - size);
    Lit { bytes: bytes, is_u: is_u, raw: raw, body: body }
}

// decode_unicode_with_escapes and its bytes twin. An escape Python does
// not know stays as it is, backslash and all.
fn decode_escapes(s: ref Vec[i64], bytes: bool) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    let end = s.len();
    while i < end {
        let c = s[i];
        if c != 92 or i + 1 >= end {
            out.push(c);
            i += 1;
            continue;
        }
        let e = s[i + 1];
        i += 2;
        if e == 110 {
            out.push(10);
        } else if e == 116 {
            out.push(9);
        } else if e == 114 {
            out.push(13);
        } else if e == 97 {
            out.push(7);
        } else if e == 98 {
            out.push(8);
        } else if e == 102 {
            out.push(12);
        } else if e == 118 {
            out.push(11);
        } else if e >= 48 and e <= 55 {
            let mut x = e - 48;
            let mut k = 0;
            while k < 2 and i < end and s[i] >= 48 and s[i] <= 55 {
                x = x * 8 + s[i] - 48;
                i += 1;
                k += 1;
            }
            out.push(if bytes { x & 0xFF } else { x });
        } else if e == 120 or (not bytes and (e == 117 or e == 85)) {
            let count = if e == 120 { 2 } else if e == 117 { 4 } else { 8 };
            let mut x = 0;
            for _ in 0..count {
                if i < end {
                    x = x * 16 + hex_val(s[i]);
                }
                i += 1;
            }
            out.push(x);
        } else if e == 92 or e == 39 or e == 34 {
            out.push(e);
        } else if e == 10 {
            // a line continuation inside the literal
        } else {
            out.push(92);
            out.push(e);
        }
    }
    out
}

fn decode_literal(t: ref Vec[i64]) -> Lit {
    let mut l = split_literal(t);
    if not l.raw {
        l.body = decode_escapes(l.body, l.bytes);
    }
    l
}

// ------------------------------------------------------------ numbers

// The digits of `digits` in `base`, as a decimal string.
fn to_decimal(digits: ref Vec[i64], base: i64) -> String {
    let mut d: Vec[i64] = vec![0];
    for c in digits {
        let mut carry = hex_val(c);
        let mut i = 0;
        while i < d.len() {
            let t = d[i] * base + carry;
            d[i] = t % 10;
            carry = t / 10;
            i += 1;
        }
        while carry > 0 {
            d.push(carry % 10);
            carry = carry / 10;
        }
    }
    while d.len() > 1 and d[d.len() - 1] == 0 {
        d.pop();
    }
    let mut out = String.new();
    let mut i = d.len() - 1;
    while i >= 0 {
        out.push_str(f"{d[i]}");
        i -= 1;
    }
    out
}

// A NUMBER token as a constant.
fn number_value(text: ref Vec[i64]) -> Cv {
    let mut t: Vec[i64] = Vec.new();
    for c in text {
        if c != 95 {
            t.push(c);
        }
    }
    if t.len() > 1 and t[0] == 48 {
        let b = lower(t[1]);
        let base = if b == 120 { 16 } else if b == 111 { 8 } else if b == 98 { 2 } else { 0 };
        if base > 0 {
            let mut v = cv_of(C_INT);
            v.num = to_decimal(slice(t, 2, t.len()), base);
            return v;
        }
    }
    let last = lower(t[t.len() - 1]);
    if last == 106 {
        let mut v = cv_of(C_COMPLEX);
        v.x = parse_float(slice(t, 0, t.len() - 1));
        return v;
    }
    for c in t {
        if c == 46 or c == 101 or c == 69 {
            let mut v = cv_of(C_FLOAT);
            v.x = parse_float(t);
            return v;
        }
    }
    let mut v = cv_of(C_INT);
    v.num = to_decimal(t, 10);
    v
}

fn parse_float(t: ref Vec[i64]) -> f64 {
    match f64.parse(to_string(t)) {
        Ok(x) => x,
        Err(_) => 0.0,
    }
}

// ------------------------------------------------------------ the parser
//
// A recursive-descent port of the PEG grammar of Python 3.13
// (Grammar/python.gram) for the statements and expressions in it other
// than match and type parameters. Tokens come from the lexer above in
// its parse mode, one at a time as the parser asks for them, so a
// tokenizer error surfaces when the parser first looks at the token, as
// it does in CPython.
//
// Errors are sticky: the first one wins, except that a specific message
// (one of the grammar's invalid_* rules) replaces a plain "invalid
// syntax". The plain one names the furthest token the parser looked at,
// as the first pass of the C parser does.

#[derive(Clone)]
struct Pt {
    ty: i64,
    s: String,
    text: Vec[i64],
    l1: i64,
    c1: i64,
    b1: i64,
    l2: i64,
    b2: i64,
    a1: i64,
    a2: i64,
    cur_col: i64,
}

struct P {
    lx: Lx,
    toks: Vec[Pt],
    pos: i64,
    lexdone: bool,
    ast: Ast,
    ek: i64,
    etype: String,
    emsg: String,
    eline: i64,
    ecol: i64,
    gen_tok: i64,
}

const EK_NONE: i64 = 0;
const EK_GENERIC: i64 = 1;
const EK_SPECIFIC: i64 = 2;
const EK_TOKEN: i64 = 3;

fn new_parser(src: ref Vec[i64]) -> P {
    P {
        lx: new_lexer(src, true), toks: Vec.new(), pos: 0, lexdone: false, ast: new_ast(),
        ek: EK_NONE, etype: String.new(), emsg: String.new(), eline: 0, ecol: 0, gen_tok: 0,
    }
}

fn is_keyword(s: ref String) -> bool {
    let kws = vec!["False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield"];
    for k in kws {
        if s == k {
            return true;
        }
    }
    false
}

// The token the tokenizer fails on, with the error it raises: what
// _PyPegen_tokenizer_error makes of the tokenizer's state.
fn tokenizer_error(p: mut ref P) {
    let lx = ref p.lx;
    let mut etype = "SyntaxError".to_string();
    let mut msg = String.new();
    let mut line = lx.lineno;
    let mut col = 0;
    if lx.done == E_ERROR {
        etype = lx.err.kind.clone();
        msg = lx.err.msg.clone();
        line = lx.err.line;
        col = lx.err.col;
    } else if lx.done == E_EOF {
        if lx.level > 0 {
            let k = lx.parens.len() - 1;
            msg = f"'{digit_text(lx.parens[k])}' was never closed";
            line = lx.paren_lines[k];
            col = lx.paren_cols[k] + 1;
        } else {
            msg = "unexpected EOF while parsing".to_string();
        }
    } else if lx.done == E_DEDENT {
        etype = "IndentationError".to_string();
        msg = "unindent does not match any outer indentation level".to_string();
        col = lx.cur - lx.line_start;
    } else if lx.done == E_TABSPACE {
        etype = "TabError".to_string();
        msg = "inconsistent use of tabs and spaces in indentation".to_string();
        col = 1;
    } else if lx.done == E_LINECONT {
        msg = "unexpected character after line continuation character".to_string();
        col = lx.cur - lx.buf;
    } else {
        msg = "unknown parsing error".to_string();
    }
    p.ek = EK_TOKEN;
    p.etype = etype;
    p.emsg = msg;
    p.eline = line;
    p.ecol = col;
}

fn fetch(p: mut ref P) {
    if p.lexdone {
        let last = p.toks[p.toks.len() - 1].clone();
        p.toks.push(last);
        return;
    }
    loop {
        let ty = tok_get(mut p.lx);
        if ty == T_COMMENT or ty == T_NL {
            continue;
        }
        let cur_col = p.lx.cur - p.lx.line_start;
        if ty == T_ERROR {
            if p.ek != EK_TOKEN {
                tokenizer_error(mut p);
            }
            p.lexdone = true;
            p.toks.push(Pt { ty: T_ERROR, s: String.new(), text: Vec.new(), l1: p.lx.lineno, c1: -1, b1: -1, l2: p.lx.lineno, b2: -1, a1: 0, a2: 0, cur_col: cur_col });
            return;
        }
        let t = make_tok(p.lx, ty);
        let s = to_string(t.text);
        let mut pt = Pt { ty: ty, s: s, text: t.text, l1: t.sr, c1: t.sc, b1: t.scb, l2: t.er, b2: t.ecb, a1: p.lx.ps, a2: p.lx.pe, cur_col: cur_col };
        if ty == T_INDENT or ty == T_DEDENT or ty == T_ENDMARKER {
            pt.l1 = p.lx.lineno;
            pt.l2 = p.lx.lineno;
            pt.c1 = -1;
            pt.b1 = -1;
            pt.b2 = -1;
        }
        p.toks.push(pt);
        if ty == T_ENDMARKER {
            p.lexdone = true;
        }
        return;
    }
}

fn ti(p: mut ref P, k: i64) -> i64 {
    let i = p.pos + k;
    while i >= p.toks.len() {
        fetch(mut p);
    }
    i
}

fn tty(p: mut ref P, k: i64) -> i64 {
    let i = ti(mut p, k);
    p.toks[i].ty
}

fn is_op(p: mut ref P, k: i64, s: Str) -> bool {
    let i = ti(mut p, k);
    p.toks[i].ty == T_OP and p.toks[i].s == s
}

fn is_kw(p: mut ref P, k: i64, s: Str) -> bool {
    let i = ti(mut p, k);
    p.toks[i].ty == T_NAME and p.toks[i].s == s
}

fn is_name(p: mut ref P, k: i64) -> bool {
    let i = ti(mut p, k);
    p.toks[i].ty == T_NAME and not is_keyword(p.toks[i].s)
}

fn tok_text(p: mut ref P, k: i64) -> String {
    let i = ti(mut p, k);
    p.toks[i].s.clone()
}

fn adv(p: mut ref P) {
    p.pos += 1;
}

// ------------------------------------------------------------ errors

fn failed(p: ref P) -> bool {
    p.ek != EK_NONE
}

// A plain "invalid syntax": it names the furthest token looked at.
fn fail(p: mut ref P) -> i64 {
    if p.ek == EK_NONE {
        p.ek = EK_GENERIC;
        p.gen_tok = p.toks.len() - 1;
    }
    -1
}

fn raise_at(p: mut ref P, etype: Str, msg: own String, line: i64, col: i64) -> i64 {
    if p.ek == EK_NONE or p.ek == EK_GENERIC {
        p.ek = EK_SPECIFIC;
        p.etype = etype.to_string();
        p.emsg = msg;
        p.eline = line;
        p.ecol = col;
    }
    -1
}

// The column a token's error names, one-based, in characters.
fn tok_err_col(p: ref P, i: i64) -> i64 {
    if p.toks[i].c1 < 0 { p.toks[i].cur_col } else { p.toks[i].c1 + 1 }
}

// RAISE_SYNTAX_ERROR: at the last token fetched.
fn raise_last(p: mut ref P, etype: Str, msg: own String) -> i64 {
    let i = p.toks.len() - 1;
    let line = p.toks[i].l1;
    let col = tok_err_col(p, i);
    raise_at(mut p, etype, msg, line, col)
}

fn raise_tok(p: mut ref P, i: i64, msg: own String) -> i64 {
    let line = p.toks[i].l1;
    let col = tok_err_col(p, i);
    raise_at(mut p, "SyntaxError", msg, line, col)
}

// A known location on a node: its start, as a one-based character
// column.
fn raise_node(p: mut ref P, id: i64, msg: own String) -> i64 {
    let line = p.ast.nodes[id].l1;
    let b = p.ast.nodes[id].c1;
    let col = char_col(p.lx.s, p.lx.line_ends, line, b) + 1;
    raise_at(mut p, "SyntaxError", msg, line, col)
}

// A byte column on a line as a character column.
fn char_col(s: ref Vec[i64], ends: ref Vec[i64], line: i64, b: i64) -> i64 {
    let mut i = if line >= 2 { ends[line - 2] } else { 0 };
    let mut bytes = 0;
    let mut chars = 0;
    while bytes < b and i < s.len() {
        let c = s[i];
        bytes += if c < 0x80 { 1 } else if c < 0x800 { 2 } else if c < 0x10000 { 3 } else { 4 };
        chars += 1;
        i += 1;
    }
    chars
}

// The final error, as _Pypegen_set_syntax_error leaves it: a plain
// error at an INDENT or DEDENT is an IndentationError, and after any
// error from the parser the rest of the source is tokenized, so that a
// tokenizer error further on wins.
fn finish_error(p: mut ref P) {
    if p.ek == EK_GENERIC {
        let i = p.gen_tok;
        let t = p.toks[i].clone();
        if t.ty == T_INDENT or t.ty == T_DEDENT {
            p.etype = "IndentationError".to_string();
            p.emsg = if t.ty == T_INDENT { "unexpected indent".to_string() } else { "unexpected unindent".to_string() };
            p.eline = t.l1;
            p.ecol = t.cur_col;
        } else {
            p.etype = "SyntaxError".to_string();
            p.emsg = "invalid syntax".to_string();
            p.eline = t.l1;
            p.ecol = if t.c1 < 0 { 0 } else { t.c1 + 1 };
        }
    }
    if p.ek == EK_TOKEN {
        return;
    }
    let err_line = p.eline;
    let etype = p.etype.clone();
    let emsg = p.emsg.clone();
    let ecol = p.ecol;
    while not p.lexdone {
        fetch(mut p);
    }
    if p.ek != EK_TOKEN {
        return;
    }
    let keep = if p.lx.done == E_EOF {
        not (p.lx.level > 0 and err_line > p.lx.paren_lines[p.lx.parens.len() - 1])
    } else {
        p.lx.modes.len() > 1
    };
    p.ek = EK_SPECIFIC;
    if keep {
        p.etype = etype;
        p.emsg = emsg;
        p.eline = err_line;
        p.ecol = ecol;
    }
}

// ------------------------------------------------------------ positions

// The rule's start token to the last token it took that is not a
// NEWLINE, INDENT or DEDENT (_PyPegen_get_last_nonnwhitespace_token).
fn finish(p: mut ref P, id: i64, s: i64) -> i64 {
    let mut m = p.pos - 1;
    while m > s {
        let ty = p.toks[m].ty;
        if ty != T_NEWLINE and ty != T_INDENT and ty != T_DEDENT and ty != T_ENDMARKER {
            break;
        }
        m -= 1;
    }
    let l1 = p.toks[s].l1;
    let c1 = p.toks[s].b1;
    let l2 = p.toks[m].l2;
    let c2 = p.toks[m].b2;
    set_pos(mut p.ast, id, l1, c1, l2, c2);
    id
}

fn tok_pos(p: mut ref P, id: i64, i: i64) -> i64 {
    let l1 = p.toks[i].l1;
    let c1 = p.toks[i].b1;
    let l2 = p.toks[i].l2;
    let c2 = p.toks[i].b2;
    set_pos(mut p.ast, id, l1, c1, l2, c2);
    id
}

// ------------------------------------------------------------ targets

const TG_STAR: i64 = 0;
const TG_DEL: i64 = 1;
const TG_FOR: i64 = 2;

// _PyPegen_get_invalid_target
fn invalid_target(a: ref Ast, e: i64, kind: i64) -> i64 {
    if e < 0 {
        return -1;
    }
    if is(a, e, "List") or is(a, e, "Tuple") {
        for c in kids(a, e, "elts") {
            let r = invalid_target(a, c, kind);
            if r >= 0 {
                return r;
            }
        }
        return -1;
    }
    if is(a, e, "Starred") {
        if kind == TG_DEL {
            return e;
        }
        return invalid_target(a, kid(a, e, "value"), kind);
    }
    if is(a, e, "Compare") {
        if kind == TG_FOR {
            let ops = kids(a, e, "ops");
            if is(a, ops[0], "In") {
                return invalid_target(a, kid(a, e, "left"), kind);
            }
            return -1;
        }
        return e;
    }
    if is(a, e, "Name") or is(a, e, "Subscript") or is(a, e, "Attribute") {
        return -1;
    }
    e
}

// _PyPegen_get_expr_name
fn expr_name(a: ref Ast, e: i64) -> String {
    let t = ty_of(a, e);
    if t == "Constant" {
        let k = const_kind(a, e);
        return if k == C_NONE { "None" } else if k == C_TRUE { "True" } else if k == C_FALSE { "False" } else if k == C_ELL { "ellipsis" } else { "literal" }.to_string();
    }
    let table = vec![
        ("Attribute", "attribute"), ("Subscript", "subscript"), ("Starred", "starred"), ("Name", "name"),
        ("List", "list"), ("Tuple", "tuple"), ("Lambda", "lambda"), ("Call", "function call"),
        ("BoolOp", "expression"), ("BinOp", "expression"), ("UnaryOp", "expression"),
        ("GeneratorExp", "generator expression"), ("Yield", "yield expression"),
        ("YieldFrom", "yield expression"), ("Await", "await expression"), ("ListComp", "list comprehension"),
        ("SetComp", "set comprehension"), ("DictComp", "dict comprehension"), ("Dict", "dict literal"),
        ("Set", "set display"), ("JoinedStr", "f-string expression"), ("FormattedValue", "f-string expression"),
        ("Compare", "comparison"), ("IfExp", "conditional expression"), ("NamedExpr", "named expression"),
    ];
    for (k, v) in table {
        if t == k {
            return v.to_string();
        }
    }
    "expression".to_string()
}

fn set_ctx(a: mut ref Ast, e: i64, ctx: Str) {
    if field_at(a, e, "ctx") >= 0 {
        let c = leaf(mut a, ctx);
        set_kid(mut a, e, "ctx", c);
    }
    if is(a, e, "Starred") {
        let v = kid(a, e, "value");
        set_ctx(mut a, v, ctx);
    } else if is(a, e, "List") or is(a, e, "Tuple") {
        for c in kids(a, e, "elts") {
            set_ctx(mut a, c, ctx);
        }
    }
}

// ------------------------------------------------------------ nodes

fn op_node(a: mut ref Ast, ty: Str) -> i64 {
    leaf(mut a, ty)
}

fn binop(p: mut ref P, s: i64, l: i64, op: Str, r: i64) -> i64 {
    let id = mk(mut p.ast, "BinOp");
    add_node(mut p.ast, id, "left", l);
    let o = op_node(mut p.ast, op);
    add_node(mut p.ast, id, "op", o);
    add_node(mut p.ast, id, "right", r);
    finish(mut p, id, s)
}

fn tuple_node(p: mut ref P, s: i64, elts: ref Vec[i64]) -> i64 {
    let id = mk(mut p.ast, "Tuple");
    add_list(mut p.ast, id, "elts", elts);
    let c = leaf(mut p.ast, "Load");
    add_node(mut p.ast, id, "ctx", c);
    finish(mut p, id, s)
}

fn starred(p: mut ref P, s: i64, v: i64) -> i64 {
    let id = mk(mut p.ast, "Starred");
    add_node(mut p.ast, id, "value", v);
    let c = leaf(mut p.ast, "Load");
    add_node(mut p.ast, id, "ctx", c);
    finish(mut p, id, s)
}

// Can the next token start an expression?
fn starts_expr(p: mut ref P) -> bool {
    let i = ti(mut p, 0);
    let t = ref p.toks[i];
    if t.ty == T_NAME {
        return not is_keyword(t.s) or t.s == "not" or t.s == "lambda" or t.s == "await" or t.s == "True" or t.s == "False" or t.s == "None";
    }
    if t.ty == T_NUMBER or t.ty == T_STRING or t.ty == T_FSTART {
        return true;
    }
    if t.ty == T_OP {
        return t.s == "(" or t.s == "[" or t.s == "{" or t.s == "-" or t.s == "+" or t.s == "~" or t.s == "...";
    }
    false
}

fn starts_star_expr(p: mut ref P) -> bool {
    is_op(mut p, 0, "*") or starts_expr(mut p)
}

// ------------------------------------------------------------ expressions

fn star_expressions(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let e = star_expression(mut p);
    if e < 0 or not is_op(mut p, 0, ",") {
        return e;
    }
    let mut elts = vec![e];
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if not starts_star_expr(mut p) {
            break;
        }
        let x = star_expression(mut p);
        if x < 0 {
            return -1;
        }
        elts.push(x);
    }
    tuple_node(mut p, s, elts)
}

fn star_expression(p: mut ref P) -> i64 {
    if is_op(mut p, 0, "*") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    expression(mut p)
}

fn star_named_expression(p: mut ref P) -> i64 {
    if is_op(mut p, 0, "*") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    named_expression(mut p)
}

fn named_expression(p: mut ref P) -> i64 {
    if is_name(mut p, 0) and is_op(mut p, 1, ":=") {
        let s = ti(mut p, 0);
        let target = name_node(mut p.ast, tok_text(mut p, 0), "Store");
        tok_pos(mut p, target, s);
        adv(mut p);
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "NamedExpr");
        add_node(mut p.ast, id, "target", target);
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    expression(mut p)
}

fn expression(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "lambda") {
        return lambdef(mut p);
    }
    let s = ti(mut p, 0);
    let a = disjunction(mut p);
    if a < 0 {
        return -1;
    }
    if is_kw(mut p, 0, "if") {
        adv(mut p);
        let b = disjunction(mut p);
        if b < 0 {
            return -1;
        }
        if not is_kw(mut p, 0, "else") {
            if is_op(mut p, 0, ":") {
                return fail(mut p);
            }
            return raise_node(mut p, a, "expected 'else' after 'if' expression".to_string());
        }
        adv(mut p);
        let c = expression(mut p);
        if c < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "IfExp");
        add_node(mut p.ast, id, "test", b);
        add_node(mut p.ast, id, "body", a);
        add_node(mut p.ast, id, "orelse", c);
        return finish(mut p, id, s);
    }
    a
}

fn yield_expr(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    if is_kw(mut p, 0, "from") {
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "YieldFrom");
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    let mut v = -1;
    if starts_star_expr(mut p) {
        v = star_expressions(mut p);
        if v < 0 {
            return -1;
        }
    }
    let id = mk(mut p.ast, "Yield");
    add_node(mut p.ast, id, "value", v);
    finish(mut p, id, s)
}

fn boolop(p: mut ref P, word: Str, op: Str) -> i64 {
    let s = ti(mut p, 0);
    let first = if word == "or" { conjunction(mut p) } else { inversion(mut p) };
    if first < 0 or not is_kw(mut p, 0, word) {
        return first;
    }
    let mut values = vec![first];
    while is_kw(mut p, 0, word) {
        adv(mut p);
        let v = if word == "or" { conjunction(mut p) } else { inversion(mut p) };
        if v < 0 {
            return -1;
        }
        values.push(v);
    }
    let id = mk(mut p.ast, "BoolOp");
    let o = op_node(mut p.ast, op);
    add_node(mut p.ast, id, "op", o);
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

fn disjunction(p: mut ref P) -> i64 {
    boolop(mut p, "or", "Or")
}

fn conjunction(p: mut ref P) -> i64 {
    boolop(mut p, "and", "And")
}

fn inversion(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "not") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = inversion(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "UnaryOp");
        let o = op_node(mut p.ast, "Not");
        add_node(mut p.ast, id, "op", o);
        add_node(mut p.ast, id, "operand", v);
        return finish(mut p, id, s);
    }
    comparison(mut p)
}

// The comparison operator at the cursor, and how many tokens it takes.
fn compare_op(p: mut ref P) -> (String, i64) {
    if is_kw(mut p, 0, "not") and is_kw(mut p, 1, "in") {
        return ("NotIn".to_string(), 2);
    }
    if is_kw(mut p, 0, "in") {
        return ("In".to_string(), 1);
    }
    if is_kw(mut p, 0, "is") {
        if is_kw(mut p, 1, "not") {
            return ("IsNot".to_string(), 2);
        }
        return ("Is".to_string(), 1);
    }
    let i = ti(mut p, 0);
    if p.toks[i].ty == T_OP {
        let table = vec![("==", "Eq"), ("!=", "NotEq"), ("<=", "LtE"), ("<", "Lt"), (">=", "GtE"), (">", "Gt")];
        for (k, v) in table {
            if p.toks[i].s == k {
                return (v.to_string(), 1);
            }
        }
    }
    (String.new(), 0)
}

fn comparison(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let left = bitwise_or(mut p);
    if left < 0 {
        return -1;
    }
    let mut ops: Vec[i64] = Vec.new();
    let mut comps: Vec[i64] = Vec.new();
    loop {
        let (op, n) = compare_op(mut p);
        if n == 0 {
            break;
        }
        for _ in 0..n {
            adv(mut p);
        }
        let r = bitwise_or(mut p);
        if r < 0 {
            return -1;
        }
        let o = op_node(mut p.ast, op.as_str());
        ops.push(o);
        comps.push(r);
    }
    if ops.len() == 0 {
        return left;
    }
    let id = mk(mut p.ast, "Compare");
    add_node(mut p.ast, id, "left", left);
    add_list(mut p.ast, id, "ops", ops);
    add_list(mut p.ast, id, "comparators", comps);
    finish(mut p, id, s)
}

// The binary operator levels from `|` down to `*`: level 0 is `|`.
fn level_op(p: mut ref P, level: i64) -> String {
    let i = ti(mut p, 0);
    if p.toks[i].ty != T_OP {
        return String.new();
    }
    let s = p.toks[i].s.clone();
    if level == 0 and s == "|" {
        return "BitOr".to_string();
    }
    if level == 1 and s == "^" {
        return "BitXor".to_string();
    }
    if level == 2 and s == "&" {
        return "BitAnd".to_string();
    }
    if level == 3 {
        if s == "<<" {
            return "LShift".to_string();
        }
        if s == ">>" {
            return "RShift".to_string();
        }
    }
    if level == 4 {
        if s == "+" {
            return "Add".to_string();
        }
        if s == "-" {
            return "Sub".to_string();
        }
    }
    if level == 5 {
        let table = vec![("*", "Mult"), ("/", "Div"), ("//", "FloorDiv"), ("%", "Mod"), ("@", "MatMult")];
        for (k, v) in table {
            if s == k {
                return v.to_string();
            }
        }
    }
    String.new()
}

fn binary(p: mut ref P, level: i64) -> i64 {
    if level == 6 {
        return factor(mut p);
    }
    let s = ti(mut p, 0);
    let mut e = binary(mut p, level + 1);
    if e < 0 {
        return -1;
    }
    loop {
        let op = level_op(mut p, level);
        if op.is_empty() {
            break;
        }
        adv(mut p);
        let r = binary(mut p, level + 1);
        if r < 0 {
            return -1;
        }
        e = binop(mut p, s, e, op.as_str(), r);
    }
    e
}

fn bitwise_or(p: mut ref P) -> i64 {
    binary(mut p, 0)
}

fn factor(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut op = "";
    if is_op(mut p, 0, "+") {
        op = "UAdd";
    } else if is_op(mut p, 0, "-") {
        op = "USub";
    } else if is_op(mut p, 0, "~") {
        op = "Invert";
    }
    if op != "" {
        adv(mut p);
        let v = factor(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "UnaryOp");
        let o = op_node(mut p.ast, op);
        add_node(mut p.ast, id, "op", o);
        add_node(mut p.ast, id, "operand", v);
        return finish(mut p, id, s);
    }
    power(mut p)
}

fn power(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let a = await_primary(mut p);
    if a < 0 {
        return -1;
    }
    if is_op(mut p, 0, "**") {
        adv(mut p);
        let b = factor(mut p);
        if b < 0 {
            return -1;
        }
        return binop(mut p, s, a, "Pow", b);
    }
    a
}

fn await_primary(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "await") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = primary(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "Await");
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    primary(mut p)
}

fn primary(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut e = atom(mut p);
    if e < 0 {
        return -1;
    }
    loop {
        if is_op(mut p, 0, ".") {
            adv(mut p);
            if not is_name(mut p, 0) {
                return fail(mut p);
            }
            let attr = tok_text(mut p, 0);
            adv(mut p);
            let id = mk(mut p.ast, "Attribute");
            add_node(mut p.ast, id, "value", e);
            add_str(mut p.ast, id, "attr", attr);
            let c = leaf(mut p.ast, "Load");
            add_node(mut p.ast, id, "ctx", c);
            e = finish(mut p, id, s);
        } else if is_op(mut p, 0, "(") {
            let mut args: Vec[i64] = Vec.new();
            let mut kws: Vec[i64] = Vec.new();
            if call_args(mut p, true, mut args, mut kws) < 0 {
                return -1;
            }
            let id = mk(mut p.ast, "Call");
            add_node(mut p.ast, id, "func", e);
            add_list(mut p.ast, id, "args", args);
            add_list(mut p.ast, id, "keywords", kws);
            e = finish(mut p, id, s);
        } else if is_op(mut p, 0, "[") {
            adv(mut p);
            let sl = slices(mut p);
            if sl < 0 {
                return -1;
            }
            if not is_op(mut p, 0, "]") {
                return fail(mut p);
            }
            adv(mut p);
            let id = mk(mut p.ast, "Subscript");
            add_node(mut p.ast, id, "value", e);
            add_node(mut p.ast, id, "slice", sl);
            let c = leaf(mut p.ast, "Load");
            add_node(mut p.ast, id, "ctx", c);
            e = finish(mut p, id, s);
        } else {
            break;
        }
    }
    e
}

fn slices(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let first_starred = is_op(mut p, 0, "*");
    let first = slice_item(mut p);
    if first < 0 {
        return -1;
    }
    if not is_op(mut p, 0, ",") and not first_starred {
        return first;
    }
    let mut elts = vec![first];
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, "]") {
            break;
        }
        let x = slice_item(mut p);
        if x < 0 {
            return -1;
        }
        elts.push(x);
    }
    tuple_node(mut p, s, elts)
}

fn slice_item(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    if is_op(mut p, 0, "*") {
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    let mut lower = -1;
    if not is_op(mut p, 0, ":") {
        lower = named_expression(mut p);
        if lower < 0 {
            return -1;
        }
        if not is_op(mut p, 0, ":") {
            return lower;
        }
    }
    adv(mut p);
    let mut upper = -1;
    let mut step = -1;
    if starts_expr(mut p) {
        upper = expression(mut p);
        if upper < 0 {
            return -1;
        }
    }
    if is_op(mut p, 0, ":") {
        adv(mut p);
        if starts_expr(mut p) {
            step = expression(mut p);
            if step < 0 {
                return -1;
            }
        }
    }
    let id = mk(mut p.ast, "Slice");
    add_node(mut p.ast, id, "lower", lower);
    add_node(mut p.ast, id, "upper", upper);
    add_node(mut p.ast, id, "step", step);
    finish(mut p, id, s)
}

fn keyword_node(p: mut ref P, s: i64, name: Option[String], v: i64) -> i64 {
    let id = mk(mut p.ast, "keyword");
    match name {
        Some(n) => add_str(mut p.ast, id, "arg", n),
        None => add_none(mut p.ast, id, "arg"),
    }
    add_node(mut p.ast, id, "value", v);
    finish(mut p, id, s)
}

fn starts_comprehension(p: mut ref P) -> bool {
    is_kw(mut p, 0, "for") or (is_kw(mut p, 0, "async") and is_kw(mut p, 1, "for"))
}

// The arguments of a call or a class, from its `(` to its `)`. A call
// takes a bare generator expression as its only argument; the
// generator expression then spans the parentheses.
fn call_args(p: mut ref P, allow_genexp: bool, args: mut ref Vec[i64], kws: mut ref Vec[i64]) -> i64 {
    let lp = ti(mut p, 0);
    adv(mut p);
    let mut seen_kw = false;
    let mut seen_unpack = false;
    let mut first = true;
    loop {
        if is_op(mut p, 0, ")") {
            break;
        }
        let s = ti(mut p, 0);
        if is_op(mut p, 0, "*") {
            adv(mut p);
            let v = expression(mut p);
            if v < 0 {
                return -1;
            }
            let st = starred(mut p, s, v);
            args.push(st);
        } else if is_op(mut p, 0, "**") {
            adv(mut p);
            let v = expression(mut p);
            if v < 0 {
                return -1;
            }
            let k = keyword_node(mut p, s, None, v);
            kws.push(k);
            seen_unpack = true;
        } else if is_name(mut p, 0) and is_op(mut p, 1, "=") {
            let name = tok_text(mut p, 0);
            adv(mut p);
            adv(mut p);
            let v = expression(mut p);
            if v < 0 {
                return -1;
            }
            let k = keyword_node(mut p, s, Some(name), v);
            kws.push(k);
            seen_kw = true;
        } else {
            let e = named_expression(mut p);
            if e < 0 {
                return -1;
            }
            if starts_comprehension(mut p) {
                if not allow_genexp {
                    return fail(mut p);
                }
                let gens = for_if_clauses(mut p);
                if failed(p) {
                    return -1;
                }
                if not first or not is_op(mut p, 0, ")") {
                    return raise_node(mut p, e, "Generator expression must be parenthesized".to_string());
                }
                adv(mut p);
                let g = mk(mut p.ast, "GeneratorExp");
                add_node(mut p.ast, g, "elt", e);
                add_list(mut p.ast, g, "generators", gens);
                finish(mut p, g, lp);
                args.push(g);
                return 0;
            }
            if seen_kw or seen_unpack {
                let msg = if seen_unpack { "positional argument follows keyword argument unpacking" } else { "positional argument follows keyword argument" };
                return raise_last(mut p, "SyntaxError", msg.to_string());
            }
            args.push(e);
        }
        first = false;
        if is_op(mut p, 0, ",") {
            adv(mut p);
            continue;
        }
        if is_op(mut p, 0, ")") {
            break;
        }
        return fail(mut p);
    }
    adv(mut p);
    0
}

fn for_targets(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let first = target_elem(mut p);
    if first < 0 {
        return -1;
    }
    let mut e = first;
    if is_op(mut p, 0, ",") {
        let mut elts = vec![first];
        while is_op(mut p, 0, ",") {
            adv(mut p);
            if not starts_star_expr(mut p) {
                break;
            }
            let x = target_elem(mut p);
            if x < 0 {
                return -1;
            }
            elts.push(x);
        }
        e = tuple_node(mut p, s, elts);
    }
    let bad = invalid_target(p.ast, e, TG_FOR);
    if bad >= 0 {
        let name = expr_name(p.ast, bad);
        return raise_node(mut p, bad, f"cannot assign to {name}");
    }
    set_ctx(mut p.ast, e, "Store");
    e
}

fn target_elem(p: mut ref P) -> i64 {
    if is_op(mut p, 0, "*") {
        let s = ti(mut p, 0);
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        return starred(mut p, s, v);
    }
    bitwise_or(mut p)
}

fn for_if_clauses(p: mut ref P) -> Vec[i64] {
    let mut gens: Vec[i64] = Vec.new();
    while starts_comprehension(mut p) {
        let mut is_async = 0;
        if is_kw(mut p, 0, "async") {
            is_async = 1;
            adv(mut p);
        }
        adv(mut p);
        let target = for_targets(mut p);
        if target < 0 {
            return gens;
        }
        if not is_kw(mut p, 0, "in") {
            fail(mut p);
            return gens;
        }
        adv(mut p);
        let iter = disjunction(mut p);
        if iter < 0 {
            return gens;
        }
        let mut ifs: Vec[i64] = Vec.new();
        while is_kw(mut p, 0, "if") {
            adv(mut p);
            let c = disjunction(mut p);
            if c < 0 {
                return gens;
            }
            ifs.push(c);
        }
        let id = mk(mut p.ast, "comprehension");
        add_node(mut p.ast, id, "target", target);
        add_node(mut p.ast, id, "iter", iter);
        add_list(mut p.ast, id, "ifs", ifs);
        add_int(mut p.ast, id, "is_async", is_async);
        gens.push(id);
    }
    gens
}

fn comp_node(p: mut ref P, s: i64, ty: Str, elt: i64, gens: ref Vec[i64]) -> i64 {
    let id = mk(mut p.ast, ty);
    add_node(mut p.ast, id, "elt", elt);
    add_list(mut p.ast, id, "generators", gens);
    finish(mut p, id, s)
}

fn atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let t = p.toks[s].clone();
    if t.ty == T_NAME {
        if not is_keyword(t.s) {
            adv(mut p);
            let id = name_node(mut p.ast, t.s, "Load");
            return tok_pos(mut p, id, s);
        }
        if t.s == "True" or t.s == "False" or t.s == "None" {
            adv(mut p);
            let ck = if t.s == "True" { C_TRUE } else if t.s == "False" { C_FALSE } else { C_NONE };
            let id = constant(mut p.ast, cv_of(ck), false);
            return tok_pos(mut p, id, s);
        }
        return fail(mut p);
    }
    if t.ty == T_NUMBER {
        adv(mut p);
        let id = constant(mut p.ast, number_value(t.text), false);
        return tok_pos(mut p, id, s);
    }
    if t.ty == T_STRING or t.ty == T_FSTART {
        return strings(mut p);
    }
    if t.ty == T_OP {
        if t.s == "(" {
            return paren_atom(mut p);
        }
        if t.s == "[" {
            return list_atom(mut p);
        }
        if t.s == "{" {
            return brace_atom(mut p);
        }
        if t.s == "..." {
            adv(mut p);
            let id = constant(mut p.ast, cv_of(C_ELL), false);
            return tok_pos(mut p, id, s);
        }
    }
    fail(mut p)
}

fn paren_atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    if is_op(mut p, 0, ")") {
        adv(mut p);
        return tuple_node(mut p, s, Vec.new());
    }
    if is_kw(mut p, 0, "yield") {
        let y = yield_expr(mut p);
        if y < 0 {
            return -1;
        }
        if not is_op(mut p, 0, ")") {
            return fail(mut p);
        }
        adv(mut p);
        return y;
    }
    let first = star_named_expression(mut p);
    if first < 0 {
        return -1;
    }
    if starts_comprehension(mut p) {
        let gens = for_if_clauses(mut p);
        if failed(p) {
            return -1;
        }
        if not is_op(mut p, 0, ")") {
            return fail(mut p);
        }
        adv(mut p);
        return comp_node(mut p, s, "GeneratorExp", first, gens);
    }
    if is_op(mut p, 0, ")") {
        adv(mut p);
        return first;
    }
    if not is_op(mut p, 0, ",") {
        return fail(mut p);
    }
    let mut elts = vec![first];
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, ")") {
            break;
        }
        let x = star_named_expression(mut p);
        if x < 0 {
            return -1;
        }
        elts.push(x);
    }
    if not is_op(mut p, 0, ")") {
        return fail(mut p);
    }
    adv(mut p);
    tuple_node(mut p, s, elts)
}

// The elements of a display up to its closing bracket, after the first.
fn more_elements(p: mut ref P, elts: mut ref Vec[i64], close: Str) -> bool {
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, close) {
            break;
        }
        let x = star_named_expression(mut p);
        if x < 0 {
            return false;
        }
        elts.push(x);
    }
    if not is_op(mut p, 0, close) {
        fail(mut p);
        return false;
    }
    adv(mut p);
    true
}

fn list_atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut elts: Vec[i64] = Vec.new();
    if is_op(mut p, 0, "]") {
        adv(mut p);
    } else {
        let first = star_named_expression(mut p);
        if first < 0 {
            return -1;
        }
        if starts_comprehension(mut p) {
            let gens = for_if_clauses(mut p);
            if failed(p) {
                return -1;
            }
            if not is_op(mut p, 0, "]") {
                return fail(mut p);
            }
            adv(mut p);
            return comp_node(mut p, s, "ListComp", first, gens);
        }
        elts.push(first);
        if not more_elements(mut p, mut elts, "]") {
            return -1;
        }
    }
    let id = mk(mut p.ast, "List");
    add_list(mut p.ast, id, "elts", elts);
    let c = leaf(mut p.ast, "Load");
    add_node(mut p.ast, id, "ctx", c);
    finish(mut p, id, s)
}

fn brace_atom(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut keys: Vec[i64] = Vec.new();
    let mut values: Vec[i64] = Vec.new();
    if is_op(mut p, 0, "}") {
        adv(mut p);
        return dict_node(mut p, s, keys, values);
    }
    if is_op(mut p, 0, "**") {
        adv(mut p);
        let v = bitwise_or(mut p);
        if v < 0 {
            return -1;
        }
        keys.push(-1);
        values.push(v);
        return dict_rest(mut p, s, mut keys, mut values);
    }
    let first = star_named_expression(mut p);
    if first < 0 {
        return -1;
    }
    if is_op(mut p, 0, ":") and not is(p.ast, first, "Starred") {
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        if starts_comprehension(mut p) {
            let gens = for_if_clauses(mut p);
            if failed(p) {
                return -1;
            }
            if not is_op(mut p, 0, "}") {
                return fail(mut p);
            }
            adv(mut p);
            let id = mk(mut p.ast, "DictComp");
            add_node(mut p.ast, id, "key", first);
            add_node(mut p.ast, id, "value", v);
            add_list(mut p.ast, id, "generators", gens);
            return finish(mut p, id, s);
        }
        keys.push(first);
        values.push(v);
        return dict_rest(mut p, s, mut keys, mut values);
    }
    if starts_comprehension(mut p) {
        let gens = for_if_clauses(mut p);
        if failed(p) {
            return -1;
        }
        if not is_op(mut p, 0, "}") {
            return fail(mut p);
        }
        adv(mut p);
        return comp_node(mut p, s, "SetComp", first, gens);
    }
    let mut elts = vec![first];
    if not more_elements(mut p, mut elts, "}") {
        return -1;
    }
    let id = mk(mut p.ast, "Set");
    add_list(mut p.ast, id, "elts", elts);
    finish(mut p, id, s)
}

fn dict_rest(p: mut ref P, s: i64, keys: mut ref Vec[i64], values: mut ref Vec[i64]) -> i64 {
    while is_op(mut p, 0, ",") {
        adv(mut p);
        if is_op(mut p, 0, "}") {
            break;
        }
        if is_op(mut p, 0, "**") {
            adv(mut p);
            let v = bitwise_or(mut p);
            if v < 0 {
                return -1;
            }
            keys.push(-1);
            values.push(v);
            continue;
        }
        let k = expression(mut p);
        if k < 0 {
            return -1;
        }
        if not is_op(mut p, 0, ":") {
            return fail(mut p);
        }
        adv(mut p);
        let v = expression(mut p);
        if v < 0 {
            return -1;
        }
        keys.push(k);
        values.push(v);
    }
    if not is_op(mut p, 0, "}") {
        return fail(mut p);
    }
    adv(mut p);
    dict_node(mut p, s, keys, values)
}

fn dict_node(p: mut ref P, s: i64, keys: ref Vec[i64], values: ref Vec[i64]) -> i64 {
    let id = mk(mut p.ast, "Dict");
    add_list(mut p.ast, id, "keys", keys);
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

fn lambdef(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let args = params(mut p, true);
    if args < 0 {
        return -1;
    }
    if not is_op(mut p, 0, ":") {
        return fail(mut p);
    }
    adv(mut p);
    if tty(mut p, 0) == T_FMIDDLE {
        return raise_tok(mut p, s, "f-string: lambda expressions are not allowed without parentheses".to_string());
    }
    let body = expression(mut p);
    if body < 0 {
        return -1;
    }
    let id = mk(mut p.ast, "Lambda");
    add_node(mut p.ast, id, "args", args);
    add_node(mut p.ast, id, "body", body);
    finish(mut p, id, s)
}

fn param(p: mut ref P, is_lambda: bool) -> i64 {
    let s = ti(mut p, 0);
    if not is_name(mut p, 0) {
        return fail(mut p);
    }
    let name = tok_text(mut p, 0);
    adv(mut p);
    let mut ann = -1;
    if not is_lambda and is_op(mut p, 0, ":") {
        adv(mut p);
        ann = expression(mut p);
        if ann < 0 {
            return -1;
        }
    }
    let id = mk(mut p.ast, "arg");
    add_str(mut p.ast, id, "arg", name);
    add_node(mut p.ast, id, "annotation", ann);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

// The parameters of a def (up to its `)`) or of a lambda (up to its
// `:`), as an arguments node.
fn params(p: mut ref P, is_lambda: bool) -> i64 {
    let close = if is_lambda { ":" } else { ")" };
    let mut posonly: Vec[i64] = Vec.new();
    let mut args: Vec[i64] = Vec.new();
    let mut defaults: Vec[i64] = Vec.new();
    let mut kwonly: Vec[i64] = Vec.new();
    let mut kwdefaults: Vec[i64] = Vec.new();
    let mut vararg = -1;
    let mut kwarg = -1;
    let mut seen_star = false;
    let mut seen_default = false;
    loop {
        if is_op(mut p, 0, close) {
            break;
        }
        if is_op(mut p, 0, "/") {
            if seen_star or args.len() == 0 or posonly.len() > 0 {
                return fail(mut p);
            }
            adv(mut p);
            posonly = args;
            args = Vec.new();
        } else if is_op(mut p, 0, "*") {
            if seen_star {
                return fail(mut p);
            }
            adv(mut p);
            seen_star = true;
            if not is_op(mut p, 0, ",") {
                vararg = param(mut p, is_lambda);
                if vararg < 0 {
                    return -1;
                }
            }
        } else if is_op(mut p, 0, "**") {
            adv(mut p);
            kwarg = param(mut p, is_lambda);
            if kwarg < 0 {
                return -1;
            }
            if is_op(mut p, 0, ",") {
                adv(mut p);
            }
            if not is_op(mut p, 0, close) {
                return fail(mut p);
            }
            break;
        } else {
            let a = param(mut p, is_lambda);
            if a < 0 {
                return -1;
            }
            let mut d = -1;
            if is_op(mut p, 0, "=") {
                adv(mut p);
                d = expression(mut p);
                if d < 0 {
                    return -1;
                }
            }
            if seen_star {
                kwonly.push(a);
                kwdefaults.push(d);
            } else {
                if d >= 0 {
                    defaults.push(d);
                    seen_default = true;
                } else if seen_default {
                    return raise_node(mut p, a, "parameter without a default follows parameter with a default".to_string());
                }
                args.push(a);
            }
        }
        if is_op(mut p, 0, ",") {
            adv(mut p);
            continue;
        }
        if is_op(mut p, 0, close) {
            break;
        }
        return fail(mut p);
    }
    let id = mk(mut p.ast, "arguments");
    add_list(mut p.ast, id, "posonlyargs", posonly);
    add_list(mut p.ast, id, "args", args);
    add_node(mut p.ast, id, "vararg", vararg);
    add_list(mut p.ast, id, "kwonlyargs", kwonly);
    add_list(mut p.ast, id, "kw_defaults", kwdefaults);
    add_node(mut p.ast, id, "kwarg", kwarg);
    add_list(mut p.ast, id, "defaults", defaults);
    id
}

// ------------------------------------------------------------ strings

fn string_const(p: mut ref P, i: i64) -> i64 {
    let l = decode_literal(p.toks[i].text);
    let mut v = cv_of(if l.bytes { C_BYTES } else { C_STR });
    v.s = l.body;
    let id = constant(mut p.ast, v, l.is_u);
    tok_pos(mut p, id, i)
}

fn is_str_const(a: ref Ast, id: i64) -> bool {
    is(a, id, "Constant") and const_kind(a, id) == C_STR
}

fn is_empty_str(a: ref Ast, id: i64) -> bool {
    is_str_const(a, id) and cv(a, id).s.len() == 0
}

// An f-string's literal part, decoded unless the f-string is raw.
fn middle_const(p: mut ref P, i: i64, raw: bool) -> i64 {
    let text = p.toks[i].text.clone();
    let body = if raw { text } else { decode_escapes(text, false) };
    let id = str_const(mut p.ast, body);
    tok_pos(mut p, id, i)
}

fn strings(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut parts: Vec[i64] = Vec.new();
    loop {
        let ty = tty(mut p, 0);
        if ty == T_STRING {
            let i = ti(mut p, 0);
            let c = string_const(mut p, i);
            parts.push(c);
            adv(mut p);
        } else if ty == T_FSTART {
            let f = fstring(mut p);
            if f < 0 {
                return -1;
            }
            parts.push(f);
        } else {
            break;
        }
    }
    concatenate(mut p, parts, s)
}

fn fstring(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let mut raw = false;
    for c in p.toks[s].text.clone() {
        if c == 114 or c == 82 {
            raw = true;
        }
    }
    adv(mut p);
    let mut vals: Vec[i64] = Vec.new();
    loop {
        let ty = tty(mut p, 0);
        if ty == T_FMIDDLE {
            let i = ti(mut p, 0);
            let c = middle_const(mut p, i, raw);
            vals.push(c);
            adv(mut p);
        } else if is_op(mut p, 0, "{") {
            let f = replacement_field(mut p);
            if f < 0 {
                return -1;
            }
            vals.push(f);
        } else if ty == T_FEND {
            adv(mut p);
            break;
        } else {
            return fail(mut p);
        }
    }
    // _PyPegen_joined_str: the debug text's JoinedStr is opened up, and
    // the empty literal parts go.
    let mut values: Vec[i64] = Vec.new();
    for v in vals {
        if is(p.ast, v, "JoinedStr") {
            for x in kids(p.ast, v, "values") {
                values.push(x);
            }
        } else if not is_empty_str(p.ast, v) {
            values.push(v);
        }
    }
    let id = mk(mut p.ast, "JoinedStr");
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

fn replacement_field(p: mut ref P) -> i64 {
    let lb = ti(mut p, 0);
    adv(mut p);
    let e = if is_kw(mut p, 0, "yield") { yield_expr(mut p) } else { star_expressions(mut p) };
    if e < 0 {
        return -1;
    }
    let mut debug = false;
    if is_op(mut p, 0, "=") {
        debug = true;
        adv(mut p);
    }
    let after_eq = ti(mut p, 0);
    let mut conv = -1;
    let mut conv_tok = -1;
    if is_op(mut p, 0, "!") {
        adv(mut p);
        if not is_name(mut p, 0) {
            return fail(mut p);
        }
        conv_tok = ti(mut p, 0);
        let name = p.toks[conv_tok].text.clone();
        adv(mut p);
        conv = name[0];
    }
    let mut spec = -1;
    let mut spec_tok = -1;
    if is_op(mut p, 0, ":") {
        spec_tok = ti(mut p, 0);
        spec = format_spec(mut p);
        if spec < 0 {
            return -1;
        }
    }
    if not is_op(mut p, 0, "}") {
        return fail(mut p);
    }
    let rb = ti(mut p, 0);
    adv(mut p);
    if debug and conv < 0 and spec < 0 {
        conv = 114;
    }
    let fv = mk(mut p.ast, "FormattedValue");
    add_node(mut p.ast, fv, "value", e);
    add_int(mut p.ast, fv, "conversion", conv);
    add_node(mut p.ast, fv, "format_spec", spec);
    finish(mut p, fv, lb);
    if not debug {
        return fv;
    }
    // The text of the expression up to the token after `=`, as a
    // constant in front.
    let text = slice(p.lx.s, p.toks[lb].a2, p.toks[after_eq].a1);
    let body = decode_escapes(text, false);
    let d = str_const(mut p.ast, body);
    let end = if conv_tok >= 0 { conv_tok - 1 } else if spec_tok >= 0 { spec_tok } else { rb };
    let l1 = p.toks[lb].l1;
    let c1 = p.toks[lb].b1 + 1;
    let l2 = p.toks[end].l1;
    let c2 = p.toks[end].b1;
    set_pos(mut p.ast, d, l1, c1, l2, c2);
    let j = mk(mut p.ast, "JoinedStr");
    add_list(mut p.ast, j, "values", vec![d, fv]);
    j
}

fn format_spec(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut items: Vec[i64] = Vec.new();
    loop {
        if tty(mut p, 0) == T_FMIDDLE {
            let i = ti(mut p, 0);
            let text = p.toks[i].text.clone();
            let id = str_const(mut p.ast, decode_escapes(text, false));
            tok_pos(mut p, id, i);
            if not is_empty_str(p.ast, id) {
                items.push(id);
            }
            adv(mut p);
        } else if is_op(mut p, 0, "{") {
            let f = replacement_field(mut p);
            if f < 0 {
                return -1;
            }
            items.push(f);
        } else {
            break;
        }
    }
    if items.len() == 0 or (items.len() == 1 and is(p.ast, items[0], "Constant")) {
        let id = mk(mut p.ast, "JoinedStr");
        add_list(mut p.ast, id, "values", items);
        return finish(mut p, id, s);
    }
    concatenate(mut p, items, s)
}

// _PyPegen_concatenate_strings: adjacent literals fold into one, which
// takes the kind of the first; with an f-string among them the result
// is a JoinedStr without empty literals.
fn concatenate(p: mut ref P, parts: ref Vec[i64], s: i64) -> i64 {
    let mut f_found = false;
    let mut bytes_found = false;
    let mut uni_found = false;
    for x in parts {
        if is(p.ast, x, "Constant") {
            if const_kind(p.ast, x) == C_BYTES {
                bytes_found = true;
            } else {
                uni_found = true;
            }
        } else {
            f_found = true;
        }
    }
    if bytes_found and (uni_found or f_found) {
        return raise_last(mut p, "SyntaxError", "cannot mix bytes and nonbytes literals".to_string());
    }
    if bytes_found {
        let mut v = cv_of(C_BYTES);
        let mut kind_u = false;
        let mut first = true;
        for x in parts {
            if first {
                kind_u = has_str(p.ast, x, "kind");
                first = false;
            }
            for c in cv(p.ast, x).s {
                v.s.push(c);
            }
        }
        let id = constant(mut p.ast, v, kind_u);
        return finish(mut p, id, s);
    }
    if not f_found and parts.len() == 1 {
        return parts[0];
    }
    let mut flat: Vec[i64] = Vec.new();
    for x in parts {
        if is(p.ast, x, "JoinedStr") {
            for y in kids(p.ast, x, "values") {
                flat.push(y);
            }
        } else {
            flat.push(x);
        }
    }
    let mut values: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < flat.len() {
        let mut elem = flat[i];
        if is(p.ast, elem, "Constant") {
            if i + 1 < flat.len() and is(p.ast, flat[i + 1], "Constant") {
                let first = elem;
                let mut last = elem;
                let mut text: Vec[i64] = Vec.new();
                let mut j = i;
                while j < flat.len() and is(p.ast, flat[j], "Constant") {
                    for c in cv(p.ast, flat[j]).s {
                        text.push(c);
                    }
                    last = flat[j];
                    j += 1;
                }
                i = j - 1;
                let mut v = cv_of(C_STR);
                v.s = text;
                let kind_u = has_str(p.ast, first, "kind");
                elem = constant(mut p.ast, v, kind_u);
                let l1 = p.ast.nodes[first].l1;
                let c1 = p.ast.nodes[first].c1;
                let l2 = p.ast.nodes[last].l2;
                let c2 = p.ast.nodes[last].c2;
                set_pos(mut p.ast, elem, l1, c1, l2, c2);
            }
            if f_found and is_empty_str(p.ast, elem) {
                i += 1;
                continue;
            }
        }
        values.push(elem);
        i += 1;
    }
    if not f_found {
        return values[0];
    }
    let id = mk(mut p.ast, "JoinedStr");
    add_list(mut p.ast, id, "values", values);
    finish(mut p, id, s)
}

// ------------------------------------------------------------ statements

fn parse_module(p: mut ref P) -> i64 {
    let mut body: Vec[i64] = Vec.new();
    while tty(mut p, 0) != T_ENDMARKER {
        statement(mut p, mut body);
        if failed(p) {
            return -1;
        }
    }
    let id = mk(mut p.ast, "Module");
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "type_ignores", Vec.new());
    id
}

// mode='eval': an expression, then the end.
fn parse_eval(p: mut ref P) -> i64 {
    let e = star_expressions(mut p);
    if e < 0 {
        return -1;
    }
    while tty(mut p, 0) == T_NEWLINE {
        adv(mut p);
    }
    if tty(mut p, 0) != T_ENDMARKER {
        return fail(mut p);
    }
    let id = mk(mut p.ast, "Expression");
    add_node(mut p.ast, id, "body", e);
    id
}

fn statement(p: mut ref P, out: mut ref Vec[i64]) {
    let i = ti(mut p, 0);
    let t = p.toks[i].clone();
    if t.ty == T_NAME {
        let w = t.s.as_str();
        let mut st = -2;
        if w == "if" {
            st = if_stmt(mut p);
        } else if w == "while" {
            st = while_stmt(mut p);
        } else if w == "for" {
            st = for_stmt(mut p);
        } else if w == "try" {
            st = try_stmt(mut p);
        } else if w == "with" {
            st = with_stmt(mut p);
        } else if w == "def" or w == "class" {
            st = def_or_class(mut p, Vec.new());
        } else if w == "async" and (is_kw(mut p, 1, "def") or is_kw(mut p, 1, "for") or is_kw(mut p, 1, "with")) {
            if is_kw(mut p, 1, "def") {
                st = def_or_class(mut p, Vec.new());
            } else if is_kw(mut p, 1, "for") {
                st = for_stmt(mut p);
            } else {
                st = with_stmt(mut p);
            }
        }
        if st != -2 {
            if st >= 0 {
                out.push(st);
            }
            return;
        }
    }
    if t.ty == T_OP and t.s == "@" {
        let mut decos: Vec[i64] = Vec.new();
        while is_op(mut p, 0, "@") {
            adv(mut p);
            let d = named_expression(mut p);
            if d < 0 {
                return;
            }
            if tty(mut p, 0) != T_NEWLINE {
                fail(mut p);
                return;
            }
            adv(mut p);
            decos.push(d);
        }
        let st = def_or_class(mut p, decos);
        if st >= 0 {
            out.push(st);
        }
        return;
    }
    simple_stmts(mut p, mut out);
}

fn simple_stmts(p: mut ref P, out: mut ref Vec[i64]) {
    loop {
        let st = simple_stmt(mut p);
        if st < 0 {
            return;
        }
        out.push(st);
        if is_op(mut p, 0, ";") {
            adv(mut p);
            if tty(mut p, 0) == T_NEWLINE {
                adv(mut p);
                return;
            }
            continue;
        }
        if tty(mut p, 0) == T_NEWLINE {
            adv(mut p);
            return;
        }
        fail(mut p);
        return;
    }
}

fn simple_kw(p: mut ref P, ty: Str) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let id = mk(mut p.ast, ty);
    tok_pos(mut p, id, s)
}

fn names_list(p: mut ref P) -> Vec[String] {
    let mut names: Vec[String] = Vec.new();
    loop {
        if not is_name(mut p, 0) {
            fail(mut p);
            return names;
        }
        names.push(tok_text(mut p, 0));
        adv(mut p);
        if not is_op(mut p, 0, ",") {
            return names;
        }
        adv(mut p);
    }
}

fn simple_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    if is_kw(mut p, 0, "pass") {
        return simple_kw(mut p, "Pass");
    }
    if is_kw(mut p, 0, "break") {
        return simple_kw(mut p, "Break");
    }
    if is_kw(mut p, 0, "continue") {
        return simple_kw(mut p, "Continue");
    }
    if is_kw(mut p, 0, "return") {
        adv(mut p);
        let mut v = -1;
        if starts_star_expr(mut p) {
            v = star_expressions(mut p);
            if v < 0 {
                return -1;
            }
        }
        let id = mk(mut p.ast, "Return");
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "raise") {
        adv(mut p);
        let mut exc = -1;
        let mut cause = -1;
        if starts_expr(mut p) {
            exc = expression(mut p);
            if exc < 0 {
                return -1;
            }
            if is_kw(mut p, 0, "from") {
                adv(mut p);
                cause = expression(mut p);
                if cause < 0 {
                    return -1;
                }
            }
        }
        let id = mk(mut p.ast, "Raise");
        add_node(mut p.ast, id, "exc", exc);
        add_node(mut p.ast, id, "cause", cause);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "global") or is_kw(mut p, 0, "nonlocal") {
        let ty = if is_kw(mut p, 0, "global") { "Global" } else { "Nonlocal" };
        adv(mut p);
        let names = names_list(mut p);
        if failed(p) {
            return -1;
        }
        let id = mk(mut p.ast, ty);
        add_strs(mut p.ast, id, "names", names);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "del") {
        return del_stmt(mut p);
    }
    if is_kw(mut p, 0, "assert") {
        adv(mut p);
        let test = expression(mut p);
        if test < 0 {
            return -1;
        }
        let mut msg = -1;
        if is_op(mut p, 0, ",") {
            adv(mut p);
            msg = expression(mut p);
            if msg < 0 {
                return -1;
            }
        }
        let id = mk(mut p.ast, "Assert");
        add_node(mut p.ast, id, "test", test);
        add_node(mut p.ast, id, "msg", msg);
        return finish(mut p, id, s);
    }
    if is_kw(mut p, 0, "import") {
        return import_name(mut p);
    }
    if is_kw(mut p, 0, "from") {
        return import_from(mut p);
    }
    if is_kw(mut p, 0, "yield") {
        let y = yield_expr(mut p);
        if y < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "Expr");
        add_node(mut p.ast, id, "value", y);
        return finish(mut p, id, s);
    }
    expr_or_assign(mut p)
}

fn del_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut targets: Vec[i64] = Vec.new();
    loop {
        let e = star_expression(mut p);
        if e < 0 {
            return -1;
        }
        targets.push(e);
        if not is_op(mut p, 0, ",") {
            break;
        }
        adv(mut p);
        if not starts_star_expr(mut p) {
            break;
        }
    }
    for e in targets {
        let bad = invalid_target(p.ast, e, TG_DEL);
        if bad >= 0 {
            let name = expr_name(p.ast, bad);
            return raise_node(mut p, bad, f"cannot delete {name}");
        }
    }
    for e in targets {
        set_ctx(mut p.ast, e, "Del");
    }
    let id = mk(mut p.ast, "Delete");
    add_list(mut p.ast, id, "targets", targets);
    finish(mut p, id, s)
}

fn dotted_name(p: mut ref P) -> String {
    let mut out = String.new();
    loop {
        if not is_name(mut p, 0) {
            fail(mut p);
            return out;
        }
        out.push_str(tok_text(mut p, 0));
        adv(mut p);
        if not is_op(mut p, 0, ".") {
            return out;
        }
        out.push('.');
        adv(mut p);
    }
}

fn alias_node(p: mut ref P, s: i64, name: ref String, asname: Option[String]) -> i64 {
    let id = mk(mut p.ast, "alias");
    add_str(mut p.ast, id, "name", name);
    match asname {
        Some(a) => add_str(mut p.ast, id, "asname", a),
        None => add_none(mut p.ast, id, "asname"),
    }
    finish(mut p, id, s)
}

fn as_name(p: mut ref P) -> Option[String] {
    if not is_kw(mut p, 0, "as") {
        return None;
    }
    adv(mut p);
    if not is_name(mut p, 0) {
        fail(mut p);
        return None;
    }
    let n = tok_text(mut p, 0);
    adv(mut p);
    Some(n)
}

fn import_name(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    if tty(mut p, 0) == T_NEWLINE {
        let i = ti(mut p, 0);
        return raise_tok(mut p, i, "Expected one or more names after 'import'".to_string());
    }
    let mut names: Vec[i64] = Vec.new();
    loop {
        let a = ti(mut p, 0);
        let name = dotted_name(mut p);
        if failed(p) {
            return -1;
        }
        let asname = as_name(mut p);
        if failed(p) {
            return -1;
        }
        let al = alias_node(mut p, a, name, asname);
        names.push(al);
        if not is_op(mut p, 0, ",") {
            break;
        }
        adv(mut p);
    }
    let id = mk(mut p.ast, "Import");
    add_list(mut p.ast, id, "names", names);
    finish(mut p, id, s)
}

fn import_from(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    adv(mut p);
    let mut level = 0;
    loop {
        if is_op(mut p, 0, ".") {
            level += 1;
        } else if is_op(mut p, 0, "...") {
            level += 3;
        } else {
            break;
        }
        adv(mut p);
    }
    let mut module: Option[String] = None;
    if not is_kw(mut p, 0, "import") or level == 0 {
        let m = dotted_name(mut p);
        if failed(p) {
            return -1;
        }
        module = Some(m);
    }
    if not is_kw(mut p, 0, "import") {
        return fail(mut p);
    }
    adv(mut p);
    let mut names: Vec[i64] = Vec.new();
    if is_op(mut p, 0, "*") {
        let a = ti(mut p, 0);
        adv(mut p);
        let al = alias_node(mut p, a, "*".to_string(), None);
        names.push(al);
    } else {
        let paren = is_op(mut p, 0, "(");
        if paren {
            adv(mut p);
        }
        loop {
            let a = ti(mut p, 0);
            if not is_name(mut p, 0) {
                return fail(mut p);
            }
            let name = tok_text(mut p, 0);
            adv(mut p);
            let asname = as_name(mut p);
            if failed(p) {
                return -1;
            }
            let al = alias_node(mut p, a, name, asname);
            names.push(al);
            if not is_op(mut p, 0, ",") {
                break;
            }
            adv(mut p);
            if paren and is_op(mut p, 0, ")") {
                break;
            }
        }
        if paren {
            if not is_op(mut p, 0, ")") {
                return fail(mut p);
            }
            adv(mut p);
        }
    }
    let id = mk(mut p.ast, "ImportFrom");
    match module {
        Some(m) => add_str(mut p.ast, id, "module", m),
        None => add_none(mut p.ast, id, "module"),
    }
    add_list(mut p.ast, id, "names", names);
    add_int(mut p.ast, id, "level", level);
    finish(mut p, id, s)
}

fn is_single_target(a: ref Ast, e: i64) -> bool {
    is(a, e, "Name") or is(a, e, "Attribute") or is(a, e, "Subscript")
}

fn augassign_op(p: mut ref P) -> String {
    let i = ti(mut p, 0);
    if p.toks[i].ty != T_OP {
        return String.new();
    }
    let table = vec![
        ("+=", "Add"), ("-=", "Sub"), ("*=", "Mult"), ("@=", "MatMult"), ("/=", "Div"), ("%=", "Mod"),
        ("&=", "BitAnd"), ("|=", "BitOr"), ("^=", "BitXor"), ("<<=", "LShift"), (">>=", "RShift"),
        ("**=", "Pow"), ("//=", "FloorDiv"),
    ];
    for (k, v) in table {
        if p.toks[i].s == k {
            return v.to_string();
        }
    }
    String.new()
}

fn rhs(p: mut ref P) -> i64 {
    if is_kw(mut p, 0, "yield") {
        yield_expr(mut p)
    } else {
        star_expressions(mut p)
    }
}

// Is the node a bitwise_or as the grammar has it, and so a candidate
// for "Maybe you meant '=='"?
fn is_bitwise_or_level(a: ref Ast, e: i64) -> bool {
    let bad = vec!["Compare", "BoolOp", "IfExp", "Lambda", "NamedExpr", "Starred", "Yield", "YieldFrom", "List", "Tuple", "GeneratorExp"];
    for b in bad {
        if is(a, e, b) {
            return false;
        }
    }
    if is(a, e, "UnaryOp") and is(a, kid(a, e, "op"), "Not") {
        return false;
    }
    if is(a, e, "Constant") {
        let k = const_kind(a, e);
        if k == C_TRUE or k == C_FALSE or k == C_NONE {
            return false;
        }
    }
    true
}

fn expr_or_assign(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    if is_name(mut p, 0) and is_op(mut p, 1, ":") {
        let target = name_node(mut p.ast, tok_text(mut p, 0), "Store");
        tok_pos(mut p, target, s);
        adv(mut p);
        return ann_assign(mut p, s, target, 1);
    }
    let e = star_expressions(mut p);
    if e < 0 {
        return -1;
    }
    if is_op(mut p, 0, ":") {
        if not is_single_target(p.ast, e) {
            return fail(mut p);
        }
        set_ctx(mut p.ast, e, "Store");
        return ann_assign(mut p, s, e, 0);
    }
    let op = augassign_op(mut p);
    if not op.is_empty() {
        if not is_single_target(p.ast, e) {
            let name = expr_name(p.ast, e);
            return raise_node(mut p, e, f"'{name}' is an illegal expression for augmented assignment");
        }
        set_ctx(mut p.ast, e, "Store");
        adv(mut p);
        let v = rhs(mut p);
        if v < 0 {
            return -1;
        }
        let id = mk(mut p.ast, "AugAssign");
        add_node(mut p.ast, id, "target", e);
        let o = op_node(mut p.ast, op.as_str());
        add_node(mut p.ast, id, "op", o);
        add_node(mut p.ast, id, "value", v);
        return finish(mut p, id, s);
    }
    if not is_op(mut p, 0, "=") {
        let id = mk(mut p.ast, "Expr");
        add_node(mut p.ast, id, "value", e);
        return finish(mut p, id, s);
    }
    let mut targets = vec![e];
    let mut value = -1;
    let mut rhs_start = -1;
    loop {
        adv(mut p);
        if rhs_start < 0 {
            rhs_start = ti(mut p, 0);
        }
        let v = rhs(mut p);
        if v < 0 {
            return -1;
        }
        if is_op(mut p, 0, "=") {
            targets.push(v);
            continue;
        }
        value = v;
        break;
    }
    let mut k = 0;
    while k < targets.len() {
        let t = targets[k];
        let bad = invalid_target(p.ast, t, TG_STAR);
        if bad >= 0 {
            let rt = p.toks[rhs_start].clone();
            let rhs_ok = not (rt.ty == T_NAME and (rt.s == "not" or rt.s == "lambda" or rt.s == "yield")) and not (rt.ty == T_OP and rt.s == "*");
            if k == 0 and targets.len() == 1 and rhs_ok and is_bitwise_or_level(p.ast, t) {
                let name = expr_name(p.ast, t);
                return raise_node(mut p, t, f"cannot assign to {name} here. Maybe you meant '==' instead of '='?");
            }
            let name = expr_name(p.ast, bad);
            return raise_node(mut p, bad, f"cannot assign to {name}");
        }
        k += 1;
    }
    for t in targets {
        set_ctx(mut p.ast, t, "Store");
    }
    let id = mk(mut p.ast, "Assign");
    add_list(mut p.ast, id, "targets", targets);
    add_node(mut p.ast, id, "value", value);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

fn ann_assign(p: mut ref P, s: i64, target: i64, simple: i64) -> i64 {
    adv(mut p);
    let ann = expression(mut p);
    if ann < 0 {
        return -1;
    }
    let mut v = -1;
    if is_op(mut p, 0, "=") {
        adv(mut p);
        v = rhs(mut p);
        if v < 0 {
            return -1;
        }
    }
    let id = mk(mut p.ast, "AnnAssign");
    add_node(mut p.ast, id, "target", target);
    add_node(mut p.ast, id, "annotation", ann);
    add_node(mut p.ast, id, "value", v);
    add_int(mut p.ast, id, "simple", simple);
    finish(mut p, id, s)
}

// `:` after a compound statement's header. A forced one (`&&':'`)
// reports "expected ':'" at whatever follows; the others only before a
// line end.
fn expect_colon(p: mut ref P, forced: bool) -> bool {
    if is_op(mut p, 0, ":") {
        adv(mut p);
        return true;
    }
    let i = ti(mut p, 0);
    if forced or p.toks[i].ty == T_NEWLINE {
        raise_tok(mut p, i, "expected ':'".to_string());
    } else {
        fail(mut p);
    }
    false
}

// A block after a `:`: an indented suite, or simple statements on the
// same line.
fn block(p: mut ref P, what: Str, line: i64) -> Vec[i64] {
    let mut body: Vec[i64] = Vec.new();
    if tty(mut p, 0) == T_NEWLINE {
        adv(mut p);
        if tty(mut p, 0) != T_INDENT {
            raise_last(mut p, "IndentationError", f"expected an indented block after {what} on line {line}");
            return body;
        }
        adv(mut p);
        while tty(mut p, 0) != T_DEDENT {
            statement(mut p, mut body);
            if failed(p) {
                return body;
            }
        }
        adv(mut p);
        return body;
    }
    simple_stmts(mut p, mut body);
    body
}

fn kw_line(p: mut ref P) -> i64 {
    let i = ti(mut p, 0);
    p.toks[i].l1
}

fn else_block(p: mut ref P) -> Vec[i64] {
    if not is_kw(mut p, 0, "else") {
        return Vec.new();
    }
    let line = kw_line(mut p);
    adv(mut p);
    if not expect_colon(mut p, true) {
        return Vec.new();
    }
    block(mut p, "'else' statement", line)
}

fn if_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    let what = if is_kw(mut p, 0, "elif") { "'elif' statement" } else { "'if' statement" };
    adv(mut p);
    let test = named_expression(mut p);
    if test < 0 {
        return -1;
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, what, line);
    if failed(p) {
        return -1;
    }
    let mut orelse: Vec[i64] = Vec.new();
    if is_kw(mut p, 0, "elif") {
        let e = if_stmt(mut p);
        if e < 0 {
            return -1;
        }
        orelse.push(e);
    } else {
        orelse = else_block(mut p);
        if failed(p) {
            return -1;
        }
    }
    let id = mk(mut p.ast, "If");
    add_node(mut p.ast, id, "test", test);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "orelse", orelse);
    finish(mut p, id, s)
}

fn while_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    adv(mut p);
    let test = named_expression(mut p);
    if test < 0 {
        return -1;
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, "'while' statement", line);
    if failed(p) {
        return -1;
    }
    let orelse = else_block(mut p);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, "While");
    add_node(mut p.ast, id, "test", test);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "orelse", orelse);
    finish(mut p, id, s)
}

fn for_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    let is_async = is_kw(mut p, 0, "async");
    if is_async {
        adv(mut p);
    }
    adv(mut p);
    let target = for_targets(mut p);
    if target < 0 {
        return -1;
    }
    if not is_kw(mut p, 0, "in") {
        return fail(mut p);
    }
    adv(mut p);
    let iter = star_expressions(mut p);
    if iter < 0 {
        return -1;
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, "'for' statement", line);
    if failed(p) {
        return -1;
    }
    let orelse = else_block(mut p);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, if is_async { "AsyncFor" } else { "For" });
    add_node(mut p.ast, id, "target", target);
    add_node(mut p.ast, id, "iter", iter);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "orelse", orelse);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

fn try_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    adv(mut p);
    if not expect_colon(mut p, true) {
        return -1;
    }
    let body = block(mut p, "'try' statement", line);
    if failed(p) {
        return -1;
    }
    let mut handlers: Vec[i64] = Vec.new();
    let mut star = false;
    while is_kw(mut p, 0, "except") {
        let hs = ti(mut p, 0);
        let hline = kw_line(mut p);
        adv(mut p);
        let mut what = "'except' statement";
        if is_op(mut p, 0, "*") {
            star = true;
            what = "'except*' statement";
            adv(mut p);
        }
        let mut typ = -1;
        let mut name: Option[String] = None;
        if not is_op(mut p, 0, ":") {
            typ = expression(mut p);
            if typ < 0 {
                return -1;
            }
            name = as_name(mut p);
            if failed(p) {
                return -1;
            }
        }
        if not expect_colon(mut p, false) {
            return -1;
        }
        let hb = block(mut p, what, hline);
        if failed(p) {
            return -1;
        }
        let h = mk(mut p.ast, "ExceptHandler");
        add_node(mut p.ast, h, "type", typ);
        match name {
            Some(n) => add_str(mut p.ast, h, "name", n),
            None => add_none(mut p.ast, h, "name"),
        }
        add_list(mut p.ast, h, "body", hb);
        finish(mut p, h, hs);
        handlers.push(h);
    }
    let orelse = if handlers.len() > 0 { else_block(mut p) } else { Vec.new() };
    if failed(p) {
        return -1;
    }
    let mut finalbody: Vec[i64] = Vec.new();
    if is_kw(mut p, 0, "finally") {
        let fline = kw_line(mut p);
        adv(mut p);
        if not expect_colon(mut p, true) {
            return -1;
        }
        finalbody = block(mut p, "'finally' statement", fline);
        if failed(p) {
            return -1;
        }
    }
    if handlers.len() == 0 and finalbody.len() == 0 {
        return fail(mut p);
    }
    let id = mk(mut p.ast, if star { "TryStar" } else { "Try" });
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "handlers", handlers);
    add_list(mut p.ast, id, "orelse", orelse);
    add_list(mut p.ast, id, "finalbody", finalbody);
    finish(mut p, id, s)
}

fn with_item(p: mut ref P) -> i64 {
    let e = expression(mut p);
    if e < 0 {
        return -1;
    }
    let mut t = -1;
    if is_kw(mut p, 0, "as") {
        adv(mut p);
        t = target_elem(mut p);
        if t < 0 {
            return -1;
        }
        if not (is_op(mut p, 0, ",") or is_op(mut p, 0, ")") or is_op(mut p, 0, ":")) {
            return fail(mut p);
        }
        let bad = invalid_target(p.ast, t, TG_STAR);
        if bad >= 0 {
            let name = expr_name(p.ast, bad);
            return raise_node(mut p, bad, f"cannot assign to {name}");
        }
        set_ctx(mut p.ast, t, "Store");
    }
    let id = mk(mut p.ast, "withitem");
    add_node(mut p.ast, id, "context_expr", e);
    add_node(mut p.ast, id, "optional_vars", t);
    id
}

fn with_items(p: mut ref P, paren: bool) -> Vec[i64] {
    let mut items: Vec[i64] = Vec.new();
    loop {
        let it = with_item(mut p);
        if it < 0 {
            return items;
        }
        items.push(it);
        if not is_op(mut p, 0, ",") {
            return items;
        }
        adv(mut p);
        if paren and is_op(mut p, 0, ")") {
            return items;
        }
    }
}

fn with_stmt(p: mut ref P) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    let is_async = is_kw(mut p, 0, "async");
    if is_async {
        adv(mut p);
    }
    adv(mut p);
    let mut items: Vec[i64] = Vec.new();
    let mut done = false;
    if is_op(mut p, 0, "(") {
        // `with (a as b, c):`, tried first; on failure the parenthesis
        // is read again as the start of an expression.
        let save = p.pos;
        adv(mut p);
        items = with_items(mut p, true);
        if not failed(p) and is_op(mut p, 0, ")") and is_op(mut p, 1, ":") {
            adv(mut p);
            done = true;
        } else if p.ek == EK_TOKEN {
            return -1;
        } else {
            p.ek = EK_NONE;
            p.pos = save;
        }
    }
    if not done {
        items = with_items(mut p, false);
        if failed(p) {
            return -1;
        }
    }
    if not expect_colon(mut p, false) {
        return -1;
    }
    let body = block(mut p, "'with' statement", line);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, if is_async { "AsyncWith" } else { "With" });
    add_list(mut p.ast, id, "items", items);
    add_list(mut p.ast, id, "body", body);
    add_none(mut p.ast, id, "type_comment");
    finish(mut p, id, s)
}

fn def_or_class(p: mut ref P, decos: own Vec[i64]) -> i64 {
    let s = ti(mut p, 0);
    let line = kw_line(mut p);
    if is_kw(mut p, 0, "class") {
        adv(mut p);
        if not is_name(mut p, 0) {
            return fail(mut p);
        }
        let name = tok_text(mut p, 0);
        adv(mut p);
        let mut bases: Vec[i64] = Vec.new();
        let mut kws: Vec[i64] = Vec.new();
        if is_op(mut p, 0, "(") {
            if call_args(mut p, false, mut bases, mut kws) < 0 {
                return -1;
            }
        }
        if not expect_colon(mut p, false) {
            return -1;
        }
        let body = block(mut p, "class definition", line);
        if failed(p) {
            return -1;
        }
        let id = mk(mut p.ast, "ClassDef");
        add_str(mut p.ast, id, "name", name);
        add_list(mut p.ast, id, "bases", bases);
        add_list(mut p.ast, id, "keywords", kws);
        add_list(mut p.ast, id, "body", body);
        add_list(mut p.ast, id, "decorator_list", decos);
        add_list(mut p.ast, id, "type_params", Vec.new());
        return finish(mut p, id, s);
    }
    let is_async = is_kw(mut p, 0, "async");
    if is_async {
        adv(mut p);
    }
    if not is_kw(mut p, 0, "def") {
        return fail(mut p);
    }
    adv(mut p);
    if not is_name(mut p, 0) {
        return fail(mut p);
    }
    let name = tok_text(mut p, 0);
    adv(mut p);
    if not is_op(mut p, 0, "(") {
        return fail(mut p);
    }
    adv(mut p);
    let args = params(mut p, false);
    if args < 0 {
        return -1;
    }
    if not is_op(mut p, 0, ")") {
        return fail(mut p);
    }
    adv(mut p);
    let mut returns = -1;
    if is_op(mut p, 0, "->") {
        adv(mut p);
        returns = expression(mut p);
        if returns < 0 {
            return -1;
        }
    }
    if not expect_colon(mut p, true) {
        return -1;
    }
    let body = block(mut p, "function definition", line);
    if failed(p) {
        return -1;
    }
    let id = mk(mut p.ast, if is_async { "AsyncFunctionDef" } else { "FunctionDef" });
    add_str(mut p.ast, id, "name", name);
    add_node(mut p.ast, id, "args", args);
    add_list(mut p.ast, id, "body", body);
    add_list(mut p.ast, id, "decorator_list", decos);
    add_node(mut p.ast, id, "returns", returns);
    add_none(mut p.ast, id, "type_comment");
    add_list(mut p.ast, id, "type_params", Vec.new());
    finish(mut p, id, s)
}

// ------------------------------------------------------------ entry

struct Parsed {
    ast: Ast,
    root: i64,
    ok: bool,
    etype: String,
    emsg: String,
    eline: i64,
    ecol: i64,
}

fn run_parser(src: ref Vec[i64], eval_mode: bool) -> Parsed {
    let mut p = new_parser(src);
    let root = if eval_mode { parse_eval(mut p) } else { parse_module(mut p) };
    if root >= 0 and not failed(p) {
        return Parsed { ast: p.ast, root: root, ok: true, etype: String.new(), emsg: String.new(), eline: 0, ecol: 0 };
    }
    finish_error(mut p);
    Parsed { ast: p.ast, root: -1, ok: false, etype: p.etype, emsg: p.emsg, eline: p.eline, ecol: p.ecol }
}

// ------------------------------------------------------------ unparse

// ast.unparse, after Lib/ast.py's _Unparser: precedences decide the
// parentheses, and string literals pick the quotes that need the fewest
// escapes.
const P_NAMED: i64 = 1;
const P_TUPLE: i64 = 2;
const P_YIELD: i64 = 3;
const P_TEST: i64 = 4;
const P_OR: i64 = 5;
const P_AND: i64 = 6;
const P_NOT: i64 = 7;
const P_CMP: i64 = 8;
const P_EXPR: i64 = 9;
const P_BXOR: i64 = 10;
const P_BAND: i64 = 11;
const P_SHIFT: i64 = 12;
const P_ARITH: i64 = 13;
const P_TERM: i64 = 14;
const P_FACTOR: i64 = 15;
const P_POWER: i64 = 16;
const P_AWAIT: i64 = 17;
const P_ATOM: i64 = 18;

fn nxt(p: i64) -> i64 {
    if p >= P_ATOM { P_ATOM } else { p + 1 }
}

// `parts` counts the writes, as the source list's length does: an
// empty write still counts for maybe_newline.
struct U {
    out: String,
    parts: i64,
    indent: i64,
    in_try_star: bool,
    prec: Vec[i64],
}

fn new_u(a: ref Ast) -> U {
    U { out: String.new(), parts: 0, indent: 0, in_try_star: false, prec: Vec.filled(a.nodes.len(), -1) }
}

fn unparse(a: ref Ast, id: i64) -> String {
    let mut u = new_u(a);
    ux(mut u, a, id);
    u.out
}

fn w(u: mut ref U, s: Str) {
    u.out.push_str(s);
    u.parts += 1;
}

fn ws(u: mut ref U, s: ref String) {
    u.out.push_str(s.as_str());
    u.parts += 1;
}

fn maybe_newline(u: mut ref U) {
    if u.parts > 0 {
        w(mut u, "\n");
    }
}

fn fill(u: mut ref U, text: Str) {
    maybe_newline(mut u);
    let mut s = String.new();
    let mut i = 0;
    while i < u.indent {
        s.push_str("    ");
        i += 1;
    }
    s.push_str(text);
    ws(mut u, s);
}

fn get_prec(u: ref U, id: i64) -> i64 {
    if u.prec[id] < 0 { P_TEST } else { u.prec[id] }
}

fn set_prec(u: mut ref U, id: i64, p: i64) {
    if id >= 0 {
        u.prec[id] = p;
    }
}

fn open_if(u: mut ref U, cond: bool, s: Str) {
    if cond {
        w(mut u, s);
    }
}

fn ux_list(u: mut ref U, a: ref Ast, v: ref Vec[i64]) {
    for id in v {
        ux(mut u, a, id);
    }
}

fn ux_sep(u: mut ref U, a: ref Ast, v: ref Vec[i64], sep: Str) {
    let mut first = true;
    for id in v {
        if not first {
            w(mut u, sep);
        }
        first = false;
        ux(mut u, a, id);
    }
}

fn items_view(u: mut ref U, a: ref Ast, v: ref Vec[i64]) {
    if v.len() == 1 {
        ux(mut u, a, v[0]);
        w(mut u, ",");
    } else {
        ux_sep(mut u, a, v, ", ");
    }
}

fn start_block(u: mut ref U) {
    w(mut u, ":");
    u.indent += 1;
}

fn end_block(u: mut ref U) {
    u.indent -= 1;
}

fn block_of(u: mut ref U, a: ref Ast, body: ref Vec[i64]) {
    start_block(mut u);
    ux_list(mut u, a, body);
    end_block(mut u);
}

fn binop_sym(ty: ref String) -> Str {
    match ty.as_str() {
        "Add" => "+",
        "Sub" => "-",
        "Mult" => "*",
        "MatMult" => "@",
        "Div" => "/",
        "Mod" => "%",
        "LShift" => "<<",
        "RShift" => ">>",
        "BitOr" => "|",
        "BitXor" => "^",
        "BitAnd" => "&",
        "FloorDiv" => "//",
        _ => "**",
    }
}

fn binop_prec(ty: ref String) -> i64 {
    match ty.as_str() {
        "Add" => P_ARITH,
        "Sub" => P_ARITH,
        "LShift" => P_SHIFT,
        "RShift" => P_SHIFT,
        "BitOr" => P_EXPR,
        "BitXor" => P_BXOR,
        "BitAnd" => P_BAND,
        "Pow" => P_POWER,
        _ => P_TERM,
    }
}

fn cmp_sym(ty: ref String) -> Str {
    match ty.as_str() {
        "Eq" => "==",
        "NotEq" => "!=",
        "Lt" => "<",
        "LtE" => "<=",
        "Gt" => ">",
        "GtE" => ">=",
        "Is" => "is",
        "IsNot" => "is not",
        "In" => "in",
        _ => "not in",
    }
}

// ------------------------------------------------------------ string literals

fn quotes_all() -> Vec[String] {
    vec!["'".to_string(), "\"".to_string(), "\"\"\"".to_string(), "'''".to_string()]
}

fn quotes_multi() -> Vec[String] {
    vec!["\"\"\"".to_string(), "'''".to_string()]
}

fn contains_sub(s: ref Vec[i64], sub: ref Vec[i64]) -> bool {
    if sub.len() == 0 {
        return true;
    }
    let mut i = 0;
    while i + sub.len() <= s.len() {
        let mut k = 0;
        while k < sub.len() and s[i + k] == sub[k] {
            k += 1;
        }
        if k == sub.len() {
            return true;
        }
        i += 1;
    }
    false
}

fn has_cp(s: ref Vec[i64], c: i64) -> bool {
    for x in s {
        if x == c {
            return true;
        }
    }
    false
}

fn is_multi(q: ref String) -> bool {
    q.len() == 3
}

// str.encode("unicode_escape") of one character.
fn push_unicode_escape(out: mut ref Vec[i64], c: i64) {
    if c == 92 {
        push_ascii(mut out, "\\\\");
    } else if c == 9 {
        push_ascii(mut out, "\\t");
    } else if c == 10 {
        push_ascii(mut out, "\\n");
    } else if c == 13 {
        push_ascii(mut out, "\\r");
    } else if c < 0x100 {
        push_ascii(mut out, "\\x");
        push_ascii(mut out, hex_n(c, 2));
    } else if c < 0x10000 {
        push_ascii(mut out, "\\u");
        push_ascii(mut out, hex_n(c, 4));
    } else {
        push_ascii(mut out, "\\U");
        push_ascii(mut out, hex_n(c, 8));
    }
}

struct Sl {
    s: Vec[i64],
    q: Vec[String],
}

fn str_literal_helper(string: ref Vec[i64], quote_types: ref Vec[String], escape_ws: bool) -> Sl {
    let mut esc: Vec[i64] = Vec.new();
    for c in string {
        if not escape_ws and (c == 10 or c == 9) {
            esc.push(c);
        } else if c == 92 or not is_printable(c) {
            push_unicode_escape(mut esc, c);
        } else {
            esc.push(c);
        }
    }
    let mut possible: Vec[String] = Vec.new();
    let nl = has_cp(esc, 10);
    for q in quote_types {
        if nl and not is_multi(q) {
            continue;
        }
        if contains_sub(esc, cps(q)) {
            continue;
        }
        possible.push(q.clone());
    }
    if possible.len() == 0 {
        let r = cps(repr_of(string));
        let first = r[0];
        let mut quote = to_string(slice(r, 0, 1));
        for q in quote_types {
            if has_cp(cps(q), first) {
                quote = q.clone();
                break;
            }
        }
        return Sl { s: slice(r, 1, r.len() - 1), q: vec![quote] };
    }
    if esc.len() > 0 {
        let last = esc[esc.len() - 1];
        let mut sorted: Vec[String] = Vec.new();
        for q in possible.iter() {
            if cps(q)[0] != last {
                sorted.push(q.clone());
            }
        }
        for q in possible.iter() {
            if cps(q)[0] == last {
                sorted.push(q.clone());
            }
        }
        possible = sorted;
        if cps(possible[0])[0] == last {
            esc.pop();
            esc.push(92);
            esc.push(last);
        }
    }
    Sl { s: esc, q: possible }
}

fn write_str_avoiding_backslashes(u: mut ref U, string: ref Vec[i64], quote_types: ref Vec[String]) {
    let r = str_literal_helper(string, quote_types, false);
    let q = r.q[0].clone();
    ws(mut u, f"{q}{to_string(r.s)}{q}");
}

fn joined_str(u: mut ref U, a: ref Ast, id: i64) {
    w(mut u, "f");
    let mut texts: Vec[String] = Vec.new();
    let mut consts: Vec[bool] = Vec.new();
    for v in kids(a, id, "values").iter() {
        let saved = u.out.clone();
        let saved_parts = u.parts;
        u.out = String.new();
        u.parts = 0;
        write_fstring_inner(mut u, a, v, false);
        texts.push(u.out.clone());
        u.out = saved;
        u.parts = saved_parts;
        consts.push(is(a, v, "Constant"));
    }
    let mut quote_types = quotes_all();
    let mut fallback = false;
    let mut new_parts: Vec[String] = Vec.new();
    let mut k = 0;
    while k < texts.len() {
        let value = cps(texts[k]);
        if consts[k] {
            let r = str_literal_helper(value, quote_types, true);
            let mut meets = false;
            for q in r.q.iter() {
                for old in quote_types.iter() {
                    if q == old {
                        meets = true;
                    }
                }
            }
            if not meets {
                fallback = true;
                break;
            }
            quote_types = r.q;
            new_parts.push(to_string(r.s));
        } else {
            if has_cp(value, 10) {
                let mut m: Vec[String] = Vec.new();
                for q in quote_types.iter() {
                    if is_multi(q) {
                        m.push(q.clone());
                    }
                }
                quote_types = m;
            }
            let mut n: Vec[String] = Vec.new();
            for q in quote_types.iter() {
                if not contains_sub(value, cps(q)) {
                    n.push(q.clone());
                }
            }
            if n.len() > 0 {
                quote_types = n;
            }
            new_parts.push(texts[k].clone());
        }
        k += 1;
    }
    if fallback {
        quote_types = vec!["'''".to_string()];
        new_parts = Vec.new();
        let mut k = 0;
        while k < texts.len() {
            if consts[k] {
                let mut v: Vec[i64] = vec![34];
                push_all(mut v, cps(texts[k]));
                let r = cps(repr_of(v));
                new_parts.push(to_string(slice(r, 2, r.len() - 1)));
            } else {
                new_parts.push(texts[k].clone());
            }
            k += 1;
        }
    }
    let q = quote_types[0].clone();
    let mut s = q.clone();
    for part in new_parts.iter() {
        s.push_str(part.as_str());
    }
    s.push_str(q.as_str());
    ws(mut u, s);
}

fn write_fstring_inner(u: mut ref U, a: ref Ast, id: i64, spec: bool) {
    if is(a, id, "JoinedStr") {
        for v in kids(a, id, "values").iter() {
            write_fstring_inner(mut u, a, v, spec);
        }
    } else if is(a, id, "Constant") {
        let s = cv(a, id).s;
        let mut out: Vec[i64] = Vec.new();
        for c in s {
            if c == 123 {
                push_ascii(mut out, "{{");
            } else if c == 125 {
                push_ascii(mut out, "}}");
            } else if spec and c == 92 {
                push_ascii(mut out, "\\\\");
            } else if spec and c == 39 {
                push_ascii(mut out, "\\'");
            } else if spec and c == 34 {
                push_ascii(mut out, "\\\"");
            } else if spec and c == 10 {
                push_ascii(mut out, "\\n");
            } else {
                out.push(c);
            }
        }
        ws(mut u, to_string(out));
    } else {
        formatted_value(mut u, a, id);
    }
}

fn formatted_value(u: mut ref U, a: ref Ast, id: i64) {
    w(mut u, "{");
    let inner = kid(a, id, "value");
    let mut v = new_u(a);
    set_prec(mut v, inner, nxt(P_TEST));
    ux(mut v, a, inner);
    if v.out.starts_with("{") {
        w(mut u, " ");
    }
    ws(mut u, v.out);
    let conv = ival(a, id, "conversion");
    if conv != -1 {
        let mut b: Vec[i64] = vec![33];
        b.push(conv);
        ws(mut u, to_string(b));
    }
    let spec = kid(a, id, "format_spec");
    if spec >= 0 {
        w(mut u, ":");
        write_fstring_inner(mut u, a, spec, true);
    }
    w(mut u, "}");
}

fn raw_docstring(a: ref Ast, id: i64) -> i64 {
    let t = ty_of(a, id);
    if t != "FunctionDef" and t != "AsyncFunctionDef" and t != "ClassDef" and t != "Module" {
        return -1;
    }
    let body = kids(a, id, "body");
    if body.len() < 1 or not is(a, body[0], "Expr") {
        return -1;
    }
    let v = kid(a, body[0], "value");
    if is(a, v, "Constant") and const_kind(a, v) == C_STR {
        return v;
    }
    -1
}

fn docstring_and_body(u: mut ref U, a: ref Ast, id: i64) {
    let body = kids(a, id, "body");
    let d = raw_docstring(a, id);
    if d >= 0 {
        fill(mut u, "");
        if has_str(a, d, "kind") {
            w(mut u, "u");
        }
        write_str_avoiding_backslashes(mut u, cv(a, d).s, quotes_multi());
        ux_list(mut u, a, slice(body, 1, body.len()));
    } else {
        ux_list(mut u, a, body);
    }
}

fn write_constant(u: mut ref U, v: ref Cv) {
    let r = const_repr(v);
    if v.ck == C_FLOAT or v.ck == C_COMPLEX {
        ws(mut u, r.replace("inf", "1e309"));
    } else {
        ws(mut u, r);
    }
}

// ------------------------------------------------------------ traverse

fn ux(u: mut ref U, a: ref Ast, id: i64) {
    let t = ty_of(a, id);
    match t.as_str() {
        "Module" => docstring_and_body(mut u, a, id),
        "Expr" => {
            fill(mut u, "");
            let v = kid(a, id, "value");
            set_prec(mut u, v, P_YIELD);
            ux(mut u, a, v);
        }
        "NamedExpr" => {
            let paren = get_prec(u, id) > P_NAMED;
            open_if(mut u, paren, "(");
            let target = kid(a, id, "target");
            let value = kid(a, id, "value");
            set_prec(mut u, target, P_ATOM);
            set_prec(mut u, value, P_ATOM);
            ux(mut u, a, target);
            w(mut u, " := ");
            ux(mut u, a, value);
            open_if(mut u, paren, ")");
        }
        "Import" => {
            fill(mut u, "import ");
            ux_sep(mut u, a, kids(a, id, "names"), ", ");
        }
        "ImportFrom" => {
            fill(mut u, "from ");
            let mut dots = String.new();
            let mut i = 0;
            while i < ival(a, id, "level") {
                dots.push_str(".");
                i += 1;
            }
            ws(mut u, dots);
            if has_str(a, id, "module") {
                ws(mut u, sval(a, id, "module"));
            }
            w(mut u, " import ");
            ux_sep(mut u, a, kids(a, id, "names"), ", ");
        }
        "Assign" => {
            fill(mut u, "");
            for target in kids(a, id, "targets").iter() {
                set_prec(mut u, target, P_TUPLE);
                ux(mut u, a, target);
                w(mut u, " = ");
            }
            ux(mut u, a, kid(a, id, "value"));
        }
        "AugAssign" => {
            fill(mut u, "");
            ux(mut u, a, kid(a, id, "target"));
            let op = ty_of(a, kid(a, id, "op"));
            ws(mut u, f" {binop_sym(op)}= ");
            ux(mut u, a, kid(a, id, "value"));
        }
        "AnnAssign" => {
            fill(mut u, "");
            let target = kid(a, id, "target");
            let paren = ival(a, id, "simple") == 0 and is(a, target, "Name");
            open_if(mut u, paren, "(");
            ux(mut u, a, target);
            open_if(mut u, paren, ")");
            w(mut u, ": ");
            ux(mut u, a, kid(a, id, "annotation"));
            let v = kid(a, id, "value");
            if v >= 0 {
                w(mut u, " = ");
                ux(mut u, a, v);
            }
        }
        "Return" => {
            fill(mut u, "return");
            let v = kid(a, id, "value");
            if v >= 0 {
                w(mut u, " ");
                ux(mut u, a, v);
            }
        }
        "Pass" => fill(mut u, "pass"),
        "Break" => fill(mut u, "break"),
        "Continue" => fill(mut u, "continue"),
        "Delete" => {
            fill(mut u, "del ");
            ux_sep(mut u, a, kids(a, id, "targets"), ", ");
        }
        "Assert" => {
            fill(mut u, "assert ");
            ux(mut u, a, kid(a, id, "test"));
            let m = kid(a, id, "msg");
            if m >= 0 {
                w(mut u, ", ");
                ux(mut u, a, m);
            }
        }
        "Global" => {
            fill(mut u, "global ");
            ws(mut u, join(strs(a, id, "names"), ", "));
        }
        "Nonlocal" => {
            fill(mut u, "nonlocal ");
            ws(mut u, join(strs(a, id, "names"), ", "));
        }
        "Await" => prefix_value(mut u, a, id, P_AWAIT, "await"),
        "Yield" => prefix_value(mut u, a, id, P_YIELD, "yield"),
        "YieldFrom" => {
            let paren = get_prec(u, id) > P_YIELD;
            open_if(mut u, paren, "(");
            w(mut u, "yield from ");
            let v = kid(a, id, "value");
            set_prec(mut u, v, P_ATOM);
            ux(mut u, a, v);
            open_if(mut u, paren, ")");
        }
        "Raise" => {
            fill(mut u, "raise");
            let exc = kid(a, id, "exc");
            if exc >= 0 {
                w(mut u, " ");
                ux(mut u, a, exc);
                let cause = kid(a, id, "cause");
                if cause >= 0 {
                    w(mut u, " from ");
                    ux(mut u, a, cause);
                }
            }
        }
        "Try" => visit_try(mut u, a, id, false),
        "TryStar" => visit_try(mut u, a, id, true),
        "ExceptHandler" => {
            if u.in_try_star {
                fill(mut u, "except*");
            } else {
                fill(mut u, "except");
            }
            let et = kid(a, id, "type");
            if et >= 0 {
                w(mut u, " ");
                ux(mut u, a, et);
            }
            if has_str(a, id, "name") {
                w(mut u, " as ");
                ws(mut u, sval(a, id, "name"));
            }
            block_of(mut u, a, kids(a, id, "body"));
        }
        "ClassDef" => {
            maybe_newline(mut u);
            for d in kids(a, id, "decorator_list").iter() {
                fill(mut u, "@");
                ux(mut u, a, d);
            }
            let head = f"class {sval(a, id, "name")}";
            fill(mut u, head.as_str());
            let bases = kids(a, id, "bases");
            let kws = kids(a, id, "keywords");
            let paren = bases.len() > 0 or kws.len() > 0;
            open_if(mut u, paren, "(");
            let mut all = bases.clone();
            push_all(mut all, kws);
            ux_sep(mut u, a, all, ", ");
            open_if(mut u, paren, ")");
            start_block(mut u);
            docstring_and_body(mut u, a, id);
            end_block(mut u);
        }
        "FunctionDef" => function_helper(mut u, a, id, "def"),
        "AsyncFunctionDef" => function_helper(mut u, a, id, "async def"),
        "For" => for_helper(mut u, a, id, "for "),
        "AsyncFor" => for_helper(mut u, a, id, "async for "),
        "If" => {
            fill(mut u, "if ");
            ux(mut u, a, kid(a, id, "test"));
            block_of(mut u, a, kids(a, id, "body"));
            let mut node = id;
            loop {
                let orelse = kids(a, node, "orelse");
                if orelse.len() != 1 or not is(a, orelse[0], "If") {
                    break;
                }
                node = orelse[0];
                fill(mut u, "elif ");
                ux(mut u, a, kid(a, node, "test"));
                block_of(mut u, a, kids(a, node, "body"));
            }
            let orelse = kids(a, node, "orelse");
            if orelse.len() > 0 {
                fill(mut u, "else");
                block_of(mut u, a, orelse);
            }
        }
        "While" => {
            fill(mut u, "while ");
            ux(mut u, a, kid(a, id, "test"));
            block_of(mut u, a, kids(a, id, "body"));
            let orelse = kids(a, id, "orelse");
            if orelse.len() > 0 {
                fill(mut u, "else");
                block_of(mut u, a, orelse);
            }
        }
        "With" => {
            fill(mut u, "with ");
            ux_sep(mut u, a, kids(a, id, "items"), ", ");
            block_of(mut u, a, kids(a, id, "body"));
        }
        "AsyncWith" => {
            fill(mut u, "async with ");
            ux_sep(mut u, a, kids(a, id, "items"), ", ");
            block_of(mut u, a, kids(a, id, "body"));
        }
        "JoinedStr" => joined_str(mut u, a, id),
        "FormattedValue" => formatted_value(mut u, a, id),
        "Name" => ws(mut u, sval(a, id, "id")),
        "Constant" => {
            let v = cv(a, id);
            if v.ck == C_ELL {
                w(mut u, "...");
            } else {
                if has_str(a, id, "kind") {
                    w(mut u, "u");
                }
                write_constant(mut u, v);
            }
        }
        "List" => {
            w(mut u, "[");
            ux_sep(mut u, a, kids(a, id, "elts"), ", ");
            w(mut u, "]");
        }
        "ListComp" => comp(mut u, a, id, "[", "]"),
        "GeneratorExp" => comp(mut u, a, id, "(", ")"),
        "SetComp" => comp(mut u, a, id, "{", "}"),
        "DictComp" => {
            w(mut u, "{");
            ux(mut u, a, kid(a, id, "key"));
            w(mut u, ": ");
            ux(mut u, a, kid(a, id, "value"));
            ux_list(mut u, a, kids(a, id, "generators"));
            w(mut u, "}");
        }
        "comprehension" => {
            if ival(a, id, "is_async") != 0 {
                w(mut u, " async for ");
            } else {
                w(mut u, " for ");
            }
            let target = kid(a, id, "target");
            set_prec(mut u, target, P_TUPLE);
            ux(mut u, a, target);
            w(mut u, " in ");
            let iter = kid(a, id, "iter");
            let ifs = kids(a, id, "ifs");
            set_prec(mut u, iter, nxt(P_TEST));
            for c in ifs.iter() {
                set_prec(mut u, c, nxt(P_TEST));
            }
            ux(mut u, a, iter);
            for c in ifs.iter() {
                w(mut u, " if ");
                ux(mut u, a, c);
            }
        }
        "IfExp" => {
            let paren = get_prec(u, id) > P_TEST;
            open_if(mut u, paren, "(");
            let body = kid(a, id, "body");
            let test = kid(a, id, "test");
            let orelse = kid(a, id, "orelse");
            set_prec(mut u, body, nxt(P_TEST));
            set_prec(mut u, test, nxt(P_TEST));
            ux(mut u, a, body);
            w(mut u, " if ");
            ux(mut u, a, test);
            w(mut u, " else ");
            set_prec(mut u, orelse, P_TEST);
            ux(mut u, a, orelse);
            open_if(mut u, paren, ")");
        }
        "Set" => {
            let elts = kids(a, id, "elts");
            if elts.len() > 0 {
                w(mut u, "{");
                ux_sep(mut u, a, elts, ", ");
                w(mut u, "}");
            } else {
                w(mut u, "{*()}");
            }
        }
        "Dict" => {
            w(mut u, "{");
            let keys = kids(a, id, "keys");
            let values = kids(a, id, "values");
            let mut i = 0;
            while i < keys.len() {
                if i > 0 {
                    w(mut u, ", ");
                }
                if keys[i] < 0 {
                    w(mut u, "**");
                    set_prec(mut u, values[i], P_EXPR);
                    ux(mut u, a, values[i]);
                } else {
                    ux(mut u, a, keys[i]);
                    w(mut u, ": ");
                    ux(mut u, a, values[i]);
                }
                i += 1;
            }
            w(mut u, "}");
        }
        "Tuple" => {
            let elts = kids(a, id, "elts");
            let paren = elts.len() == 0 or get_prec(u, id) > P_TUPLE;
            open_if(mut u, paren, "(");
            items_view(mut u, a, elts);
            open_if(mut u, paren, ")");
        }
        "UnaryOp" => {
            let op = ty_of(a, kid(a, id, "op"));
            let sym = match op.as_str() {
                "Invert" => "~",
                "Not" => "not",
                "UAdd" => "+",
                _ => "-",
            };
            let p = if op == "Not" { P_NOT } else { P_FACTOR };
            let paren = get_prec(u, id) > p;
            open_if(mut u, paren, "(");
            w(mut u, sym);
            if p != P_FACTOR {
                w(mut u, " ");
            }
            let operand = kid(a, id, "operand");
            set_prec(mut u, operand, p);
            ux(mut u, a, operand);
            open_if(mut u, paren, ")");
        }
        "BinOp" => {
            let op = ty_of(a, kid(a, id, "op"));
            let p = binop_prec(op);
            let paren = get_prec(u, id) > p;
            open_if(mut u, paren, "(");
            let left_p = if op == "Pow" { nxt(p) } else { p };
            let right_p = if op == "Pow" { p } else { nxt(p) };
            let left = kid(a, id, "left");
            let right = kid(a, id, "right");
            set_prec(mut u, left, left_p);
            ux(mut u, a, left);
            ws(mut u, f" {binop_sym(op)} ");
            set_prec(mut u, right, right_p);
            ux(mut u, a, right);
            open_if(mut u, paren, ")");
        }
        "Compare" => {
            let paren = get_prec(u, id) > P_CMP;
            open_if(mut u, paren, "(");
            let left = kid(a, id, "left");
            let comps = kids(a, id, "comparators");
            let ops = kids(a, id, "ops");
            set_prec(mut u, left, nxt(P_CMP));
            for c in comps.iter() {
                set_prec(mut u, c, nxt(P_CMP));
            }
            ux(mut u, a, left);
            let mut i = 0;
            while i < ops.len() {
                ws(mut u, f" {cmp_sym(ty_of(a, ops[i]))} ");
                ux(mut u, a, comps[i]);
                i += 1;
            }
            open_if(mut u, paren, ")");
        }
        "BoolOp" => {
            let is_and = is(a, kid(a, id, "op"), "And");
            let mut p = if is_and { P_AND } else { P_OR };
            let paren = get_prec(u, id) > p;
            open_if(mut u, paren, "(");
            let sep = if is_and { " and " } else { " or " };
            let mut first = true;
            for v in kids(a, id, "values").iter() {
                if not first {
                    w(mut u, sep);
                }
                first = false;
                p = nxt(p);
                set_prec(mut u, v, p);
                ux(mut u, a, v);
            }
            open_if(mut u, paren, ")");
        }
        "Attribute" => {
            let v = kid(a, id, "value");
            set_prec(mut u, v, P_ATOM);
            ux(mut u, a, v);
            if is(a, v, "Constant") {
                let ck = const_kind(a, v);
                if ck == C_INT or ck == C_TRUE or ck == C_FALSE {
                    w(mut u, " ");
                }
            }
            w(mut u, ".");
            ws(mut u, sval(a, id, "attr"));
        }
        "Call" => {
            let f = kid(a, id, "func");
            set_prec(mut u, f, P_ATOM);
            ux(mut u, a, f);
            w(mut u, "(");
            let mut all = kids(a, id, "args");
            push_all(mut all, kids(a, id, "keywords"));
            ux_sep(mut u, a, all, ", ");
            w(mut u, ")");
        }
        "Subscript" => {
            let v = kid(a, id, "value");
            set_prec(mut u, v, P_ATOM);
            ux(mut u, a, v);
            w(mut u, "[");
            let s = kid(a, id, "slice");
            if is(a, s, "Tuple") and kids(a, s, "elts").len() > 0 {
                items_view(mut u, a, kids(a, s, "elts"));
            } else {
                ux(mut u, a, s);
            }
            w(mut u, "]");
        }
        "Starred" => {
            w(mut u, "*");
            let v = kid(a, id, "value");
            set_prec(mut u, v, P_EXPR);
            ux(mut u, a, v);
        }
        "Slice" => {
            let lower = kid(a, id, "lower");
            if lower >= 0 {
                ux(mut u, a, lower);
            }
            w(mut u, ":");
            let upper = kid(a, id, "upper");
            if upper >= 0 {
                ux(mut u, a, upper);
            }
            let step = kid(a, id, "step");
            if step >= 0 {
                w(mut u, ":");
                ux(mut u, a, step);
            }
        }
        "arg" => {
            ws(mut u, sval(a, id, "arg"));
            let ann = kid(a, id, "annotation");
            if ann >= 0 {
                w(mut u, ": ");
                ux(mut u, a, ann);
            }
        }
        "arguments" => arguments(mut u, a, id),
        "keyword" => {
            if has_str(a, id, "arg") {
                ws(mut u, sval(a, id, "arg"));
                w(mut u, "=");
            } else {
                w(mut u, "**");
            }
            ux(mut u, a, kid(a, id, "value"));
        }
        "Lambda" => {
            let paren = get_prec(u, id) > P_TEST;
            open_if(mut u, paren, "(");
            w(mut u, "lambda");
            let saved = u.out.clone();
            let saved_parts = u.parts;
            u.out = String.new();
            u.parts = 0;
            ux(mut u, a, kid(a, id, "args"));
            let buf = u.out.clone();
            let buf_parts = u.parts;
            u.out = saved;
            u.parts = saved_parts;
            if buf_parts > 0 {
                w(mut u, " ");
                u.out.push_str(buf.as_str());
                u.parts += buf_parts;
            }
            w(mut u, ": ");
            let body = kid(a, id, "body");
            set_prec(mut u, body, P_TEST);
            ux(mut u, a, body);
            open_if(mut u, paren, ")");
        }
        "alias" => {
            ws(mut u, sval(a, id, "name"));
            if has_str(a, id, "asname") {
                ws(mut u, f" as {sval(a, id, "asname")}");
            }
        }
        "withitem" => {
            ux(mut u, a, kid(a, id, "context_expr"));
            let v = kid(a, id, "optional_vars");
            if v >= 0 {
                w(mut u, " as ");
                ux(mut u, a, v);
            }
        }
        _ => {
            ws(mut u, f"<{t}>");
        }
    }
}

fn prefix_value(u: mut ref U, a: ref Ast, id: i64, p: i64, word: Str) {
    let paren = get_prec(u, id) > p;
    open_if(mut u, paren, "(");
    w(mut u, word);
    let v = kid(a, id, "value");
    if v >= 0 {
        w(mut u, " ");
        set_prec(mut u, v, P_ATOM);
        ux(mut u, a, v);
    }
    open_if(mut u, paren, ")");
}

fn comp(u: mut ref U, a: ref Ast, id: i64, open: Str, close: Str) {
    w(mut u, open);
    ux(mut u, a, kid(a, id, "elt"));
    ux_list(mut u, a, kids(a, id, "generators"));
    w(mut u, close);
}

fn visit_try(u: mut ref U, a: ref Ast, id: i64, star: bool) {
    let prev = u.in_try_star;
    u.in_try_star = star;
    fill(mut u, "try");
    block_of(mut u, a, kids(a, id, "body"));
    ux_list(mut u, a, kids(a, id, "handlers"));
    let orelse = kids(a, id, "orelse");
    if orelse.len() > 0 {
        fill(mut u, "else");
        block_of(mut u, a, orelse);
    }
    let fin = kids(a, id, "finalbody");
    if fin.len() > 0 {
        fill(mut u, "finally");
        block_of(mut u, a, fin);
    }
    u.in_try_star = prev;
}

fn function_helper(u: mut ref U, a: ref Ast, id: i64, kw: Str) {
    maybe_newline(mut u);
    for d in kids(a, id, "decorator_list").iter() {
        fill(mut u, "@");
        ux(mut u, a, d);
    }
    let head = f"{kw} {sval(a, id, "name")}";
    fill(mut u, head.as_str());
    w(mut u, "(");
    ux(mut u, a, kid(a, id, "args"));
    w(mut u, ")");
    let r = kid(a, id, "returns");
    if r >= 0 {
        w(mut u, " -> ");
        ux(mut u, a, r);
    }
    start_block(mut u);
    docstring_and_body(mut u, a, id);
    end_block(mut u);
}

fn for_helper(u: mut ref U, a: ref Ast, id: i64, kw: Str) {
    fill(mut u, kw);
    let target = kid(a, id, "target");
    set_prec(mut u, target, P_TUPLE);
    ux(mut u, a, target);
    w(mut u, " in ");
    ux(mut u, a, kid(a, id, "iter"));
    block_of(mut u, a, kids(a, id, "body"));
    let orelse = kids(a, id, "orelse");
    if orelse.len() > 0 {
        fill(mut u, "else");
        block_of(mut u, a, orelse);
    }
}

fn arguments(u: mut ref U, a: ref Ast, id: i64) {
    let mut first = true;
    let posonly = kids(a, id, "posonlyargs");
    let mut all = posonly.clone();
    push_all(mut all, kids(a, id, "args"));
    let defaults = kids(a, id, "defaults");
    let lead = all.len() - defaults.len();
    let mut i = 0;
    while i < all.len() {
        if first {
            first = false;
        } else {
            w(mut u, ", ");
        }
        ux(mut u, a, all[i]);
        if i >= lead {
            w(mut u, "=");
            ux(mut u, a, defaults[i - lead]);
        }
        if i + 1 == posonly.len() {
            w(mut u, ", /");
        }
        i += 1;
    }
    let vararg = kid(a, id, "vararg");
    let kwonly = kids(a, id, "kwonlyargs");
    if vararg >= 0 or kwonly.len() > 0 {
        if first {
            first = false;
        } else {
            w(mut u, ", ");
        }
        w(mut u, "*");
        if vararg >= 0 {
            ws(mut u, sval(a, vararg, "arg"));
            let ann = kid(a, vararg, "annotation");
            if ann >= 0 {
                w(mut u, ": ");
                ux(mut u, a, ann);
            }
        }
    }
    let kwd = kids(a, id, "kw_defaults");
    let mut k = 0;
    while k < kwonly.len() {
        w(mut u, ", ");
        ux(mut u, a, kwonly[k]);
        if kwd[k] >= 0 {
            w(mut u, "=");
            ux(mut u, a, kwd[k]);
        }
        k += 1;
    }
    let kwarg = kid(a, id, "kwarg");
    if kwarg >= 0 {
        if not first {
            w(mut u, ", ");
        }
        ws(mut u, f"**{sval(a, kwarg, "arg")}");
        let ann = kid(a, kwarg, "annotation");
        if ann >= 0 {
            w(mut u, ": ");
            ux(mut u, a, ann);
        }
    }
}

// ------------------------------------------------------------ literal_eval

const V_CONST: i64 = 0;
const V_COMPLEX: i64 = 1;
const V_TUPLE: i64 = 2;
const V_LIST: i64 = 3;
const V_SET: i64 = 4;
const V_DICT: i64 = 5;

// A dict's items alternate key and value.
#[derive(Clone)]
struct Val {
    k: i64,
    c: Cv,
    re: f64,
    im: f64,
    items: Vec[Val],
}

fn val_of(c: own Cv) -> Val {
    Val { k: V_CONST, c: c, re: 0.0, im: 0.0, items: Vec.new() }
}

fn val_items(k: i64, items: own Vec[Val]) -> Val {
    Val { k: k, c: cv_of(C_NONE), re: 0.0, im: 0.0, items: items }
}

fn malformed(a: ref Ast, id: i64) -> String {
    if id < 0 {
        return "malformed node or string: None".to_string();
    }
    let n = ref a.nodes[id];
    if n.pos and n.l1 != 0 {
        return f"malformed node or string on line {n.l1}: <ast.{n.ty} object>";
    }
    f"malformed node or string: <ast.{n.ty} object>"
}

fn convert_num(a: ref Ast, id: i64) -> Result[Val, String] {
    if not is(a, id, "Constant") {
        return Err(malformed(a, id));
    }
    let ck = const_kind(a, id);
    if ck != C_INT and ck != C_FLOAT and ck != C_COMPLEX {
        return Err(malformed(a, id));
    }
    Ok(val_of(cv(a, id)))
}

fn negate(v: own Val) -> Val {
    let mut c = v.c.clone();
    if c.ck == C_INT {
        if c.num.starts_with("-") {
            let d = cps(c.num);
            c.num = to_string(slice(d, 1, d.len()));
        } else if c.num != "0" {
            c.num = f"-{c.num}";
        }
        return val_of(c);
    }
    if c.ck == C_FLOAT {
        c.x = -c.x;
        return val_of(c);
    }
    Val { k: V_COMPLEX, c: cv_of(C_NONE), re: -0.0, im: -c.x, items: Vec.new() }
}

fn convert_signed_num(a: ref Ast, id: i64) -> Result[Val, String] {
    if is(a, id, "UnaryOp") {
        let op = ty_of(a, kid(a, id, "op"));
        if op == "UAdd" or op == "USub" {
            let v = convert_num(a, kid(a, id, "operand"))?;
            if op == "UAdd" {
                return Ok(v);
            }
            return Ok(negate(v));
        }
    }
    convert_num(a, id)
}

fn real_of(v: ref Val) -> f64 {
    if v.c.ck == C_INT {
        return parse_float(cps(v.c.num));
    }
    v.c.x
}

fn convert_list(a: ref Ast, v: ref Vec[i64]) -> Result[Vec[Val], String] {
    let mut out: Vec[Val] = Vec.new();
    for id in v {
        out.push(convert(a, id)?);
    }
    Ok(out)
}

fn convert(a: ref Ast, id: i64) -> Result[Val, String] {
    if is(a, id, "Constant") {
        return Ok(val_of(cv(a, id)));
    }
    if is(a, id, "Tuple") {
        return Ok(val_items(V_TUPLE, convert_list(a, kids(a, id, "elts"))?));
    }
    if is(a, id, "List") {
        return Ok(val_items(V_LIST, convert_list(a, kids(a, id, "elts"))?));
    }
    if is(a, id, "Set") {
        return Ok(val_items(V_SET, convert_list(a, kids(a, id, "elts"))?));
    }
    if is(a, id, "Call") {
        let f = kid(a, id, "func");
        if is(a, f, "Name") and sval(a, f, "id") == "set" and kids(a, id, "args").len() == 0 and kids(a, id, "keywords").len() == 0 {
            return Ok(val_items(V_SET, Vec.new()));
        }
    }
    if is(a, id, "Dict") {
        let keys = kids(a, id, "keys");
        let values = kids(a, id, "values");
        let mut items: Vec[Val] = Vec.new();
        let mut i = 0;
        while i < keys.len() {
            items.push(convert(a, keys[i])?);
            items.push(convert(a, values[i])?);
            i += 1;
        }
        return Ok(val_items(V_DICT, items));
    }
    if is(a, id, "BinOp") {
        let op = ty_of(a, kid(a, id, "op"));
        if op == "Add" or op == "Sub" {
            let left = convert_signed_num(a, kid(a, id, "left"))?;
            let right = convert_num(a, kid(a, id, "right"))?;
            let left_real = left.k == V_CONST and (left.c.ck == C_INT or left.c.ck == C_FLOAT);
            if left_real and right.c.ck == C_COMPLEX {
                let re = real_of(left);
                let im = right.c.x;
                if op == "Add" {
                    return Ok(Val { k: V_COMPLEX, c: cv_of(C_NONE), re: re + 0.0, im: 0.0 + im, items: Vec.new() });
                }
                return Ok(Val { k: V_COMPLEX, c: cv_of(C_NONE), re: re - 0.0, im: 0.0 - im, items: Vec.new() });
            }
        }
    }
    convert_signed_num(a, id)
}

// A complex's part as its repr writes it.
fn part_repr(x: f64) -> String {
    imag_repr(x)
}

fn val_repr(v: ref Val) -> String {
    if v.k == V_CONST {
        return const_repr(v.c);
    }
    if v.k == V_COMPLEX {
        let positive_zero = v.re == 0.0 and not float_repr(v.re).starts_with("-");
        if positive_zero {
            return f"{part_repr(v.im)}j";
        }
        let im = part_repr(v.im);
        let sign = if im.starts_with("-") { "" } else { "+" };
        return f"({part_repr(v.re)}{sign}{im}j)";
    }
    let mut parts: Vec[String] = Vec.new();
    if v.k == V_DICT {
        let mut i = 0;
        while i < v.items.len() {
            parts.push(f"{val_repr(v.items[i])}: {val_repr(v.items[i + 1])}");
            i += 2;
        }
        return f"{{{join(parts, ", ")}}}";
    }
    for x in v.items.iter() {
        parts.push(val_repr(x));
    }
    if v.k == V_LIST {
        return f"[{join(parts, ", ")}]";
    }
    if v.k == V_SET {
        if parts.len() == 0 {
            return "set()".to_string();
        }
        return f"{{{join(parts, ", ")}}}";
    }
    if parts.len() == 1 {
        return f"({parts[0]},)";
    }
    f"({join(parts, ", ")})"
}

// ast.literal_eval of a string: the repr of the value, or the error as
// `Type: message`.
fn literal_eval(src: ref Vec[i64]) -> String {
    let mut i = 0;
    while i < src.len() and (src[i] == 32 or src[i] == 9) {
        i += 1;
    }
    let r = run_parser(slice(src, i, src.len()), true);
    if not r.ok {
        return f"! {r.etype}: {r.emsg} (<unknown>, line {r.eline})";
    }
    let body = kid(r.ast, r.root, "body");
    match convert(r.ast, body) {
        Ok(v) => val_repr(v),
        Err(e) => f"! ValueError: {e}",
    }
}

// ------------------------------------------------------------ files

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn unhex(s: ref String) -> Vec[u8] {
    let d = cps(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < d.len() {
        out.push((hex_val(d[i]) * 16 + hex_val(d[i + 1])) as u8);
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    for dir in vec!["data/project/shop/util"] {
        if fs.create_dir_all(dir.to_string()).is_err() {
            return Err(f"cannot create {dir}");
        }
    }
    for file in data_files() {
        let p = f"data/{file.path}";
        let r = if file.hex { fs.write_bytes(p.clone(), unhex(file.body)) } else { fs.write(p.clone(), file.body.clone()) };
        if r.is_err() {
            return Err(f"cannot write {p}");
        }
    }
    Ok(())
}

// Every file under a directory, as os.walk finds them.
fn walk_files(dir: ref String, out: mut ref Vec[String]) {
    if let Ok(names) = fs.read_dir(dir.clone()) {
        for n in names.into_iter() {
            let p = f"{dir}/{n}";
            if fs.read_dir(p.clone()).is_ok() {
                walk_files(p, mut out);
            } else {
                out.push(p);
            }
        }
    }
}

fn project_files() -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    walk_files("data/project".to_string(), mut out);
    sort_strings(mut out);
    out
}

fn read_source(path: ref String) -> Result[Vec[i64], String] {
    match fs.read_to_string(path.clone()) {
        Ok(t) => Ok(cps(t)),
        Err(_) => Err(f"cannot read {path}"),
    }
}

struct Tree {
    ast: Ast,
    root: i64,
}

fn parse_file(path: ref String) -> Result[Tree, String] {
    let src = read_source(path)?;
    let r = run_parser(src, false);
    if not r.ok {
        return Err(f"{path}: {r.etype}: {r.emsg}");
    }
    Ok(Tree { ast: r.ast, root: r.root })
}

// ------------------------------------------------------------ jobs

fn run_jobs() -> Result[(), String] {
    println("== jobs");
    let text = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(_) => return Err("cannot read data/jobs.tsv".to_string()),
    };
    for line in text_lines(text).iter() {
        let parts = split_tabs(line);
        let op = parts[0].clone();
        let src = decode_literal(cps(parts[1])).body;
        println(f"{op} {parts[1]}");
        if op == "eval" {
            println(f"  {literal_eval(src)}");
            continue;
        }
        let r = run_parser(src, false);
        if not r.ok {
            println(f"  ! {r.etype}: {r.emsg} at {r.eline},{r.ecol}");
            continue;
        }
        println(f"  {dump(r.ast, r.root, op == "attrs")}");
        if op == "parse" {
            for l in unparse(r.ast, r.root).split("\n") {
                println(f"  | {l}");
            }
        }
    }
    Ok(())
}

// ------------------------------------------------------------ programs

fn unparse_files(paths: ref Vec[String]) -> Result[(), String] {
    for path in paths.iter() {
        println(f"== unparse {path}");
        let t = parse_file(path)?;
        let text = unparse(t.ast, t.root);
        for l in text.split("\n") {
            println(f"| {l}");
        }
        let again = run_parser(cps(text), false);
        let same = again.ok and dump(again.ast, again.root, false) == dump(t.ast, t.root, false);
        println(f"round trip: {if same { "same" } else { "DIFFERENT" }}");
    }
    Ok(())
}

// str.expandtabs(): tabs to the next multiple of eight columns.
fn expand_tabs(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut col = 0;
    for c in s {
        if c == 9 {
            out.push(32);
            col += 1;
            while col % 8 != 0 {
                out.push(32);
                col += 1;
            }
        } else {
            out.push(c);
            col += 1;
            if c == 10 or c == 13 {
                col = 0;
            }
        }
    }
    out
}

fn strip_spaces(s: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < s.len() and s[i] == 32 {
        i += 1;
    }
    i
}

// inspect.cleandoc
fn cleandoc(doc: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut lines = split_cp(expand_tabs(doc), 10);
    let mut margin = -1;
    let mut k = 1;
    while k < lines.len() {
        let lead = strip_spaces(lines[k]);
        if lead < lines[k].len() and (margin < 0 or lead < margin) {
            margin = lead;
        }
        k += 1;
    }
    if lines.len() > 0 {
        let lead = strip_spaces(lines[0]);
        lines[0] = slice(lines[0], lead, lines[0].len());
    }
    if margin >= 0 {
        let mut k = 1;
        while k < lines.len() {
            let n = lines[k].len();
            lines[k] = slice(lines[k], if margin < n { margin } else { n }, n);
            k += 1;
        }
    }
    while lines.len() > 0 and lines[lines.len() - 1].len() == 0 {
        lines.pop();
    }
    let mut start = 0;
    while start < lines.len() and lines[start].len() == 0 {
        start += 1;
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    while start < lines.len() {
        out.push(lines[start].clone());
        start += 1;
    }
    out
}

// The first line of ast.get_docstring, or "" when there is none.
fn doc_first_line(a: ref Ast, id: i64) -> String {
    let body = kids(a, id, "body");
    if body.len() == 0 or not is(a, body[0], "Expr") {
        return String.new();
    }
    let v = kid(a, body[0], "value");
    if not is(a, v, "Constant") or const_kind(a, v) != C_STR {
        return String.new();
    }
    let lines = cleandoc(cv(a, v).s);
    if lines.len() == 0 {
        return String.new();
    }
    to_string(lines[0])
}

fn is_def(a: ref Ast, id: i64) -> bool {
    is(a, id, "FunctionDef") or is(a, id, "AsyncFunctionDef") or is(a, id, "ClassDef")
}

fn spaces(n: i64) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < n {
        s.push_str(" ");
        i += 1;
    }
    s
}

fn outline_walk(a: ref Ast, body: ref Vec[i64], prefix: ref String, depth: i64) {
    for id in body {
        if not is_def(a, id) {
            continue;
        }
        let t = ty_of(a, id);
        let kind = if t == "FunctionDef" { "def" } else if t == "AsyncFunctionDef" { "async def" } else { "class" };
        let mut decos = String.new();
        for d in kids(a, id, "decorator_list").iter() {
            decos.push_str(f"@{unparse(a, d)} ");
        }
        let mut sig = String.new();
        if t == "ClassDef" {
            let mut bases: Vec[String] = Vec.new();
            for b in kids(a, id, "bases").iter() {
                bases.push(unparse(a, b));
            }
            for k in kids(a, id, "keywords").iter() {
                bases.push(unparse(a, k));
            }
            if bases.len() > 0 {
                sig = f"({join(bases, ", ")})";
            }
        } else {
            sig = f"({unparse(a, kid(a, id, "args"))})";
            let r = kid(a, id, "returns");
            if r >= 0 {
                sig.push_str(f" -> {unparse(a, r)}");
            }
        }
        let d = doc_first_line(a, id);
        let first = if d.is_empty() { String.new() } else { f"  # {d}" };
        let name = sval(a, id, "name");
        let n = ref a.nodes[id];
        println(f"{spaces(depth * 2)}{n.l1}:{n.c1} {decos}{kind} {prefix}{name}{sig}{first}");
        outline_walk(a, kids(a, id, "body"), f"{prefix}{name}.", depth + 1);
    }
}

fn outline(paths: ref Vec[String]) -> Result[(), String] {
    println("== outline");
    for path in paths.iter() {
        let t = parse_file(path)?;
        let d = doc_first_line(t.ast, t.root);
        println(f"{path}: {if d.is_empty() { "-".to_string() } else { d }}");
        outline_walk(t.ast, kids(t.ast, t.root, "body"), String.new(), 1);
    }
    Ok(())
}

fn module_parts(path: ref String) -> Vec[String] {
    let p = cps(path);
    let inner = to_string(slice(p, 13, p.len() - 3));
    let mut parts: Vec[String] = Vec.new();
    for s in inner.split("/") {
        parts.push(s.to_string());
    }
    if parts[parts.len() - 1] == "__init__" {
        parts.pop();
    }
    parts
}

fn module_name(path: ref String) -> String {
    join(module_parts(path), ".")
}

fn package_parts(path: ref String) -> Vec[String] {
    let mut parts = module_parts(path);
    if not path.ends_with("__init__.py") and parts.len() > 0 {
        parts.pop();
    }
    parts
}

fn add_unique(v: mut ref Vec[String], s: own String) {
    for x in v.iter() {
        if x == s {
            return;
        }
    }
    v.push(s);
}

fn imported_modules(path: ref String, a: ref Ast, root: i64) -> Vec[String] {
    let pkg = package_parts(path);
    let mut found: Vec[String] = Vec.new();
    for id in walk(a, root) {
        if is(a, id, "Import") {
            for al in kids(a, id, "names").iter() {
                add_unique(mut found, sval(a, al, "name"));
            }
        } else if is(a, id, "ImportFrom") {
            let level = ival(a, id, "level");
            if level > 0 {
                let mut keep = pkg.len() - (level - 1);
                if keep < 0 {
                    keep = 0;
                }
                let mut base: Vec[String] = Vec.new();
                let mut i = 0;
                while i < keep {
                    base.push(pkg[i].clone());
                    i += 1;
                }
                if has_str(a, id, "module") {
                    base.push(sval(a, id, "module"));
                }
                add_unique(mut found, join(base, "."));
            } else {
                add_unique(mut found, sval(a, id, "module"));
            }
        }
    }
    sort_strings(mut found);
    found
}

fn imports(paths: ref Vec[String]) -> Result[(), String] {
    println("== imports");
    let mut users: Vec[String] = Vec.new();
    let mut user_of: Vec[Vec[String]] = Vec.new();
    let mut mods: Vec[String] = Vec.new();
    for path in paths.iter() {
        let m = module_name(path);
        mods.push(m.clone());
        let t = parse_file(path)?;
        let found = imported_modules(path, t.ast, t.root);
        println(f"{m}: {join(found, ", ")}");
        for f in found.iter() {
            let mut k = 0;
            while k < users.len() and users[k] != f {
                k += 1;
            }
            if k == users.len() {
                users.push(f.clone());
                user_of.push(Vec.new());
            }
            add_unique(mut user_of[k], m.clone());
        }
    }
    let mut order = users.clone();
    sort_strings(mut order);
    for m in order.iter() {
        if not mods.contains(m) {
            continue;
        }
        let mut k = 0;
        while users[k] != m {
            k += 1;
        }
        let mut u = user_of[k].clone();
        sort_strings(mut u);
        println(f"{m} <- {join(u, ", ")}");
    }
    Ok(())
}

fn unused_imports(paths: ref Vec[String]) -> Result[(), String] {
    println("== unused imports");
    for path in paths.iter() {
        let t = parse_file(path)?;
        let a = ref t.ast;
        let mut used: Vec[String] = Vec.new();
        for id in walk(a, t.root) {
            if is(a, id, "Name") and is(a, kid(a, id, "ctx"), "Load") {
                add_unique(mut used, sval(a, id, "id"));
            }
            if is(a, id, "Assign") {
                let v = kid(a, id, "value");
                for target in kids(a, id, "targets").iter() {
                    if is(a, target, "Name") and sval(a, target, "id") == "__all__" and (is(a, v, "List") or is(a, v, "Tuple")) {
                        for e in kids(a, v, "elts").iter() {
                            if is(a, e, "Constant") and const_kind(a, e) == C_STR {
                                add_unique(mut used, to_string(cv(a, e).s));
                            }
                        }
                    }
                }
            }
        }
        for id in kids(a, t.root, "body").iter() {
            let n = ref a.nodes[id];
            if is(a, id, "Import") {
                for al in kids(a, id, "names").iter() {
                    let name = sval(a, al, "name");
                    let shown = if has_str(a, al, "asname") { sval(a, al, "asname") } else { name.clone() };
                    let bound = if has_str(a, al, "asname") { shown.clone() } else { name.split(".").next().unwrap().to_string() };
                    if not used.contains(bound) {
                        println(f"{path}:{n.l1}:{n.c1 + 1}: {pr(shown)} imported but unused");
                    }
                }
            } else if is(a, id, "ImportFrom") and sval(a, id, "module") != "__future__" {
                for al in kids(a, id, "names").iter() {
                    let name = sval(a, al, "name");
                    if name == "*" {
                        continue;
                    }
                    let bound = if has_str(a, al, "asname") { sval(a, al, "asname") } else { name.clone() };
                    let mut full = String.new();
                    if has_str(a, id, "module") {
                        full.push_str(f"{sval(a, id, "module")}.");
                    } else {
                        full.push_str(spaces(ival(a, id, "level")).replace(" ", ".").as_str());
                    }
                    full.push_str(name.as_str());
                    if not used.contains(bound) {
                        println(f"{path}:{n.l1}:{n.c1 + 1}: {pr(full)} imported but unused");
                    }
                }
            }
        }
    }
    Ok(())
}

fn is_decision(a: ref Ast, id: i64) -> bool {
    let t = ty_of(a, id);
    t == "If" or t == "IfExp" or t == "For" or t == "AsyncFor" or t == "While" or t == "ExceptHandler" or t == "Assert"
}

fn score(a: ref Ast, node: i64) -> i64 {
    let mut n = 0;
    let mut stack = children(a, node);
    while stack.len() > 0 {
        let c = stack.pop().unwrap();
        if is_def(a, c) {
            continue;
        }
        if is_decision(a, c) {
            n += 1;
        } else if is(a, c, "comprehension") {
            n += 1 + kids(a, c, "ifs").len();
        } else if is(a, c, "BoolOp") {
            n += kids(a, c, "values").len() - 1;
        }
        for x in children(a, c) {
            stack.push(x);
        }
    }
    n
}

struct Row {
    path: String,
    line: i64,
    name: String,
    c: i64,
}

fn complexity_walk(a: ref Ast, path: ref String, body: ref Vec[i64], prefix: ref String, rows: mut ref Vec[Row]) {
    for id in body {
        let name = f"{prefix}{sval(a, id, "name")}";
        if is(a, id, "FunctionDef") or is(a, id, "AsyncFunctionDef") {
            rows.push(Row { path: path.clone(), line: a.nodes[id].l1, name: name.clone(), c: 1 + score(a, id) });
            complexity_walk(a, path, kids(a, id, "body"), f"{name}.", mut rows);
        } else if is(a, id, "ClassDef") {
            complexity_walk(a, path, kids(a, id, "body"), f"{name}.", mut rows);
        }
    }
}

fn row_before(x: ref Row, y: ref Row) -> bool {
    if x.c != y.c {
        return x.c > y.c;
    }
    if x.path != y.path {
        return x.path < y.path;
    }
    x.line < y.line
}

fn lpad(n: i64, width: i64) -> String {
    let s = n.to_string();
    f"{spaces(width - s.len())}{s}"
}

fn complexity(paths: ref Vec[String]) -> Result[(), String] {
    println("== complexity");
    let mut rows: Vec[Row] = Vec.new();
    for path in paths.iter() {
        let t = parse_file(path)?;
        complexity_walk(t.ast, path, kids(t.ast, t.root, "body"), String.new(), mut rows);
    }
    let mut order: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < rows.len() {
        let mut j = order.len();
        order.push(i);
        while j > 0 and row_before(rows[order[j]], rows[order[j - 1]]) {
            let t = order[j];
            order[j] = order[j - 1];
            order[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
    for k in order {
        let r = ref rows[k];
        let grade = if r.c <= 5 { "A" } else if r.c <= 10 { "B" } else { "C" };
        println(f"{grade} {lpad(r.c, 2)} {r.path}:{r.line} {r.name}");
    }
    Ok(())
}

fn node_counts(paths: ref Vec[String]) -> Result[(), String] {
    println("== node counts");
    let mut names: Vec[String] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    for path in paths.iter() {
        let t = parse_file(path)?;
        for id in walk(t.ast, t.root) {
            let name = ref t.ast.nodes[id].ty;
            let mut k = 0;
            while k < names.len() and names[k] != name {
                k += 1;
            }
            if k == names.len() {
                names.push(name.clone());
                counts.push(0);
            }
            counts[k] += 1;
        }
    }
    let mut order: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < names.len() {
        let mut j = order.len();
        order.push(i);
        while j > 0 {
            let x = order[j];
            let y = order[j - 1];
            let before = counts[x] > counts[y] or (counts[x] == counts[y] and names[x] < names[y]);
            if not before {
                break;
            }
            order[j] = y;
            order[j - 1] = x;
            j -= 1;
        }
        i += 1;
    }
    for k in order {
        println(f"{lpad(counts[k], 5)} {names[k]}");
    }
    Ok(())
}

fn run() -> Result[(), String] {
    if fs.exists("data") {
        if fs.remove_dir_all("data").is_err() {
            return Err("cannot remove data".to_string());
        }
    }
    write_data()?;
    run_jobs()?;
    let files = project_files();
    unparse_files(files)?;
    outline(files)?;
    imports(files)?;
    unused_imports(files)?;
    complexity(files)?;
    node_counts(files)?;
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

