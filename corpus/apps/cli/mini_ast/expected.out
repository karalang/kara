== jobs
parse 'x = 1'
  Module(body=[Assign(targets=[Name(id='x', ctx=Store())], value=Constant(value=1))])
  | x = 1
parse 'a = b = c'
  Module(body=[Assign(targets=[Name(id='a', ctx=Store()), Name(id='b', ctx=Store())], value=Name(id='c', ctx=Load()))])
  | a = b = c
parse 'x, = y'
  Module(body=[Assign(targets=[Tuple(elts=[Name(id='x', ctx=Store())], ctx=Store())], value=Name(id='y', ctx=Load()))])
  | x, = y
parse 'a, *b = c'
  Module(body=[Assign(targets=[Tuple(elts=[Name(id='a', ctx=Store()), Starred(value=Name(id='b', ctx=Store()), ctx=Store())], ctx=Store())], value=Name(id='c', ctx=Load()))])
  | a, *b = c
parse '*a, b = c'
  Module(body=[Assign(targets=[Tuple(elts=[Starred(value=Name(id='a', ctx=Store()), ctx=Store()), Name(id='b', ctx=Store())], ctx=Store())], value=Name(id='c', ctx=Load()))])
  | *a, b = c
parse 'x @= y'
  Module(body=[AugAssign(target=Name(id='x', ctx=Store()), op=MatMult(), value=Name(id='y', ctx=Load()))])
  | x @= y
parse 'x //= 2; y **= 3; z >>= 1'
  Module(body=[AugAssign(target=Name(id='x', ctx=Store()), op=FloorDiv(), value=Constant(value=2)), AugAssign(target=Name(id='y', ctx=Store()), op=Pow(), value=Constant(value=3)), AugAssign(target=Name(id='z', ctx=Store()), op=RShift(), value=Constant(value=1))])
  | x //= 2
  | y **= 3
  | z >>= 1
parse 'x: int'
  Module(body=[AnnAssign(target=Name(id='x', ctx=Store()), annotation=Name(id='int', ctx=Load()), simple=1)])
  | x: int
parse 'x: list[int] = []'
  Module(body=[AnnAssign(target=Name(id='x', ctx=Store()), annotation=Subscript(value=Name(id='list', ctx=Load()), slice=Name(id='int', ctx=Load()), ctx=Load()), value=List(ctx=Load()), simple=1)])
  | x: list[int] = []
parse '(x): int = 1'
  Module(body=[AnnAssign(target=Name(id='x', ctx=Store()), annotation=Name(id='int', ctx=Load()), value=Constant(value=1), simple=0)])
  | (x): int = 1
parse 'x.y: int'
  Module(body=[AnnAssign(target=Attribute(value=Name(id='x', ctx=Load()), attr='y', ctx=Store()), annotation=Name(id='int', ctx=Load()), simple=0)])
  | x.y: int
parse 'del a[0], b.c, (d, e)'
  Module(body=[Delete(targets=[Subscript(value=Name(id='a', ctx=Load()), slice=Constant(value=0), ctx=Del()), Attribute(value=Name(id='b', ctx=Load()), attr='c', ctx=Del()), Tuple(elts=[Name(id='d', ctx=Del()), Name(id='e', ctx=Del())], ctx=Del())])])
  | del a[0], b.c, (d, e)
parse 'pass; break; continue'
  Module(body=[Pass(), Break(), Continue()])
  | pass
  | break
  | continue
parse 'return'
  Module(body=[Return()])
  | return
parse 'return *a, b'
  Module(body=[Return(value=Tuple(elts=[Starred(value=Name(id='a', ctx=Load()), ctx=Load()), Name(id='b', ctx=Load())], ctx=Load()))])
  | return (*a, b)
parse 'raise'
  Module(body=[Raise()])
  | raise
parse 'raise E from c'
  Module(body=[Raise(exc=Name(id='E', ctx=Load()), cause=Name(id='c', ctx=Load()))])
  | raise E from c
parse "assert x, 'm'"
  Module(body=[Assert(test=Name(id='x', ctx=Load()), msg=Constant(value='m'))])
  | assert x, 'm'
parse 'global a, b'
  Module(body=[Global(names=['a', 'b'])])
  | global a, b
parse 'nonlocal x'
  Module(body=[Nonlocal(names=['x'])])
  | nonlocal x
parse 'import a.b.c as d, e'
  Module(body=[Import(names=[alias(name='a.b.c', asname='d'), alias(name='e')])])
  | import a.b.c as d, e
parse 'from ... import x'
  Module(body=[ImportFrom(names=[alias(name='x')], level=3)])
  | from ... import x
parse 'from .a.b import *'
  Module(body=[ImportFrom(module='a.b', names=[alias(name='*')], level=1)])
  | from .a.b import *
parse 'from x import (a, b as c,)'
  Module(body=[ImportFrom(module='x', names=[alias(name='a'), alias(name='b', asname='c')], level=0)])
  | from x import a, b as c
parse 'from . import mod'
  Module(body=[ImportFrom(names=[alias(name='mod')], level=1)])
  | from . import mod
parse 'if a:\n    pass\nelif b:\n    pass\nelif c:\n    x\nelse:\n    y'
  Module(body=[If(test=Name(id='a', ctx=Load()), body=[Pass()], orelse=[If(test=Name(id='b', ctx=Load()), body=[Pass()], orelse=[If(test=Name(id='c', ctx=Load()), body=[Expr(value=Name(id='x', ctx=Load()))], orelse=[Expr(value=Name(id='y', ctx=Load()))])])])])
  | if a:
  |     pass
  | elif b:
  |     pass
  | elif c:
  |     x
  | else:
  |     y
parse 'if a:\n    pass\nelse:\n    if b:\n        pass'
  Module(body=[If(test=Name(id='a', ctx=Load()), body=[Pass()], orelse=[If(test=Name(id='b', ctx=Load()), body=[Pass()])])])
  | if a:
  |     pass
  | elif b:
  |     pass
parse 'while x:\n    break\nelse:\n    continue'
  Module(body=[While(test=Name(id='x', ctx=Load()), body=[Break()], orelse=[Continue()])])
  | while x:
  |     break
  | else:
  |     continue
parse 'for i, j in x: pass'
  Module(body=[For(target=Tuple(elts=[Name(id='i', ctx=Store()), Name(id='j', ctx=Store())], ctx=Store()), iter=Name(id='x', ctx=Load()), body=[Pass()])])
  | for i, j in x:
  |     pass
parse 'for x in *a, *b: pass'
  Module(body=[For(target=Name(id='x', ctx=Store()), iter=Tuple(elts=[Starred(value=Name(id='a', ctx=Load()), ctx=Load()), Starred(value=Name(id='b', ctx=Load()), ctx=Load())], ctx=Load()), body=[Pass()])])
  | for x in (*a, *b):
  |     pass
parse 'for (a, b) in c:\n    pass\nelse:\n    d'
  Module(body=[For(target=Tuple(elts=[Name(id='a', ctx=Store()), Name(id='b', ctx=Store())], ctx=Store()), iter=Name(id='c', ctx=Load()), body=[Pass()], orelse=[Expr(value=Name(id='d', ctx=Load()))])])
  | for a, b in c:
  |     pass
  | else:
  |     d
parse 'try:\n  pass\nexcept E as e:\n  pass\nexcept (A, B):\n  pass\nexcept:\n  raise\nelse:\n  pass\nfinally:\n  pass'
  Module(body=[Try(body=[Pass()], handlers=[ExceptHandler(type=Name(id='E', ctx=Load()), name='e', body=[Pass()]), ExceptHandler(type=Tuple(elts=[Name(id='A', ctx=Load()), Name(id='B', ctx=Load())], ctx=Load()), body=[Pass()]), ExceptHandler(body=[Raise()])], orelse=[Pass()], finalbody=[Pass()])])
  | try:
  |     pass
  | except E as e:
  |     pass
  | except (A, B):
  |     pass
  | except:
  |     raise
  | else:
  |     pass
  | finally:
  |     pass
parse 'try:\n  pass\nfinally:\n  pass'
  Module(body=[Try(body=[Pass()], finalbody=[Pass()])])
  | try:
  |     pass
  | finally:
  |     pass
parse 'try:\n  pass\nexcept* E: pass'
  Module(body=[TryStar(body=[Pass()], handlers=[ExceptHandler(type=Name(id='E', ctx=Load()), body=[Pass()])])])
  | try:
  |     pass
  | except* E:
  |     pass
parse 'with a as b, c: pass'
  Module(body=[With(items=[withitem(context_expr=Name(id='a', ctx=Load()), optional_vars=Name(id='b', ctx=Store())), withitem(context_expr=Name(id='c', ctx=Load()))], body=[Pass()])])
  | with a as b, c:
  |     pass
parse 'with (a as b, c as d): pass'
  Module(body=[With(items=[withitem(context_expr=Name(id='a', ctx=Load()), optional_vars=Name(id='b', ctx=Store())), withitem(context_expr=Name(id='c', ctx=Load()), optional_vars=Name(id='d', ctx=Store()))], body=[Pass()])])
  | with a as b, c as d:
  |     pass
parse 'with (a, b): pass'
  Module(body=[With(items=[withitem(context_expr=Name(id='a', ctx=Load())), withitem(context_expr=Name(id='b', ctx=Load()))], body=[Pass()])])
  | with a, b:
  |     pass
parse 'with (yield): pass'
  Module(body=[With(items=[withitem(context_expr=Yield())], body=[Pass()])])
  | with (yield):
  |     pass
parse 'with open(p) as f, lock:\n    data = f.read()'
  Module(body=[With(items=[withitem(context_expr=Call(func=Name(id='open', ctx=Load()), args=[Name(id='p', ctx=Load())]), optional_vars=Name(id='f', ctx=Store())), withitem(context_expr=Name(id='lock', ctx=Load()))], body=[Assign(targets=[Name(id='data', ctx=Store())], value=Call(func=Attribute(value=Name(id='f', ctx=Load()), attr='read', ctx=Load())))])])
  | with open(p) as f, lock:
  |     data = f.read()
parse 'def f(): pass'
  Module(body=[FunctionDef(name='f', args=arguments(), body=[Pass()])])
  | def f():
  |     pass
parse 'def f(a, /, b=2, *c, d, e=3, **g) -> int:\n    "doc"\n    return a'
  Module(body=[FunctionDef(name='f', args=arguments(posonlyargs=[arg(arg='a')], args=[arg(arg='b')], vararg=arg(arg='c'), kwonlyargs=[arg(arg='d'), arg(arg='e')], kw_defaults=[None, Constant(value=3)], kwarg=arg(arg='g'), defaults=[Constant(value=2)]), body=[Expr(value=Constant(value='doc')), Return(value=Name(id='a', ctx=Load()))], returns=Name(id='int', ctx=Load()))])
  | def f(a, /, b=2, *c, d, e=3, **g) -> int:
  |     """doc"""
  |     return a
parse 'def f(a, b=1, /, c=2): pass'
  Module(body=[FunctionDef(name='f', args=arguments(posonlyargs=[arg(arg='a'), arg(arg='b')], args=[arg(arg='c')], defaults=[Constant(value=1), Constant(value=2)]), body=[Pass()])])
  | def f(a, b=1, /, c=2):
  |     pass
parse 'def f(*, a, b=1): pass'
  Module(body=[FunctionDef(name='f', args=arguments(kwonlyargs=[arg(arg='a'), arg(arg='b')], kw_defaults=[None, Constant(value=1)]), body=[Pass()])])
  | def f(*, a, b=1):
  |     pass
parse "def f(a: int = 0, *args: str, **kw: 'T') -> None: ..."
  Module(body=[FunctionDef(name='f', args=arguments(args=[arg(arg='a', annotation=Name(id='int', ctx=Load()))], vararg=arg(arg='args', annotation=Name(id='str', ctx=Load())), kwarg=arg(arg='kw', annotation=Constant(value='T')), defaults=[Constant(value=0)]), body=[Expr(value=Constant(value=Ellipsis))], returns=Constant(value=None))])
  | def f(a: int=0, *args: str, **kw: 'T') -> None:
  |     ...
parse '@d\n@e.f(1)\ndef g(): pass'
  Module(body=[FunctionDef(name='g', args=arguments(), body=[Pass()], decorator_list=[Name(id='d', ctx=Load()), Call(func=Attribute(value=Name(id='e', ctx=Load()), attr='f', ctx=Load()), args=[Constant(value=1)])])])
  | @d
  | @e.f(1)
  | def g():
  |     pass
parse '@property\ndef x(self): return self._x'
  Module(body=[FunctionDef(name='x', args=arguments(args=[arg(arg='self')]), body=[Return(value=Attribute(value=Name(id='self', ctx=Load()), attr='_x', ctx=Load()))], decorator_list=[Name(id='property', ctx=Load())])])
  | @property
  | def x(self):
  |     return self._x
parse 'async def f():\n    async for x in y: pass\n    async with a: pass\n    await b\n    return [i async for i in z]'
  Module(body=[AsyncFunctionDef(name='f', args=arguments(), body=[AsyncFor(target=Name(id='x', ctx=Store()), iter=Name(id='y', ctx=Load()), body=[Pass()]), AsyncWith(items=[withitem(context_expr=Name(id='a', ctx=Load()))], body=[Pass()]), Expr(value=Await(value=Name(id='b', ctx=Load()))), Return(value=ListComp(elt=Name(id='i', ctx=Load()), generators=[comprehension(target=Name(id='i', ctx=Store()), iter=Name(id='z', ctx=Load()), is_async=1)]))])])
  | async def f():
  |     async for x in y:
  |         pass
  |     async with a:
  |         pass
  |     await b
  |     return [i async for i in z]
parse 'class C: pass'
  Module(body=[ClassDef(name='C', body=[Pass()])])
  | class C:
  |     pass
parse "class C(B, metaclass=M):\n    '''Doc.'''\n    x = 1\n\n    def m(self): pass"
  Module(body=[ClassDef(name='C', bases=[Name(id='B', ctx=Load())], keywords=[keyword(arg='metaclass', value=Name(id='M', ctx=Load()))], body=[Expr(value=Constant(value='Doc.')), Assign(targets=[Name(id='x', ctx=Store())], value=Constant(value=1)), FunctionDef(name='m', args=arguments(args=[arg(arg='self')]), body=[Pass()])])])
  | class C(B, metaclass=M):
  |     """Doc."""
  |     x = 1
  | 
  |     def m(self):
  |         pass
parse 'class C(*bases, **kw): pass'
  Module(body=[ClassDef(name='C', bases=[Starred(value=Name(id='bases', ctx=Load()), ctx=Load())], keywords=[keyword(value=Name(id='kw', ctx=Load()))], body=[Pass()])])
  | class C(*bases, **kw):
  |     pass
parse '@dataclass\nclass P:\n    x: int\n    y: int = 0'
  Module(body=[ClassDef(name='P', body=[AnnAssign(target=Name(id='x', ctx=Store()), annotation=Name(id='int', ctx=Load()), simple=1), AnnAssign(target=Name(id='y', ctx=Store()), annotation=Name(id='int', ctx=Load()), value=Constant(value=0), simple=1)], decorator_list=[Name(id='dataclass', ctx=Load())])])
  | @dataclass
  | class P:
  |     x: int
  |     y: int = 0
parse 'def f():\n    yield\n    yield x\n    yield x, y\n    yield from z\n    x = yield'
  Module(body=[FunctionDef(name='f', args=arguments(), body=[Expr(value=Yield()), Expr(value=Yield(value=Name(id='x', ctx=Load()))), Expr(value=Yield(value=Tuple(elts=[Name(id='x', ctx=Load()), Name(id='y', ctx=Load())], ctx=Load()))), Expr(value=YieldFrom(value=Name(id='z', ctx=Load()))), Assign(targets=[Name(id='x', ctx=Store())], value=Yield())])])
  | def f():
  |     yield
  |     yield x
  |     yield (x, y)
  |     yield from z
  |     x = (yield)
parse 'x = (yield)'
  Module(body=[Assign(targets=[Name(id='x', ctx=Store())], value=Yield())])
  | x = (yield)
parse 'if x:\n    pass\n\n# comment\ny = 2  # trailing'
  Module(body=[If(test=Name(id='x', ctx=Load()), body=[Pass()]), Assign(targets=[Name(id='y', ctx=Store())], value=Constant(value=2))])
  | if x:
  |     pass
  | y = 2
parse 'x = [\n    1,\n    2,  # two\n]'
  Module(body=[Assign(targets=[Name(id='x', ctx=Store())], value=List(elts=[Constant(value=1), Constant(value=2)], ctx=Load()))])
  | x = [1, 2]
parse 'x = 1 + \\\n    2'
