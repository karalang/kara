parse '...'
  Module(body=[Expr(value=Constant(value=Ellipsis))])
  | ...
parse 'x[...]'
  Module(body=[Expr(value=Subscript(value=Name(id='x', ctx=Load()), slice=Constant(value=Ellipsis), ctx=Load()))])
  | x[...]
parse 'True, False, None'
  Module(body=[Expr(value=Tuple(elts=[Constant(value=True), Constant(value=False), Constant(value=None)], ctx=Load()))])
  | (True, False, None)
parse 'not a or b and c'
  Module(body=[Expr(value=BoolOp(op=Or(), values=[UnaryOp(op=Not(), operand=Name(id='a', ctx=Load())), BoolOp(op=And(), values=[Name(id='b', ctx=Load()), Name(id='c', ctx=Load())])]))])
  | not a or (b and c)
