  Module(body=[Assign(targets=[Name(id='x', ctx=Store())], value=BinOp(left=BinOp(left=BinOp(left=BinOp(left=BinOp(left=BinOp(left=BinOp(left=BinOp(left=BinOp(left=Constant(value=1000), op=Add(), right=Constant(value=255)), op=Add(), right=Constant(value=15)), op=Add(), right=Constant(value=5)), op=Add(), right=Constant(value=0.001)), op=Add(), right=Constant(value=2.5j)), op=Add(), right=Constant(value=100000.0)), op=Add(), right=Constant(value=0.5)), op=Add(), right=Constant(value=5.0)), op=Add(), right=Constant(value=0j)))])
  | x = 1000 + 255 + 15 + 5 + 0.001 + 2.5j + 100000.0 + 0.5 + 5.0 + 0j
parse 'x = 10**100 + 0xffffffffffffffffffffffff + 18446744073709551616'
