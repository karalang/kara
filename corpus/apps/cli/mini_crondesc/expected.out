crontab data/crontabs/web01.crontab en_US
  env SHELL=/bin/bash
  env MAILTO=ops@example.com
  /usr/local/bin/healthcheck --quiet :: Every 5 minutes
  /opt/app/bin/backup-db --retain 14 :: At 03:00 AM
  /usr/sbin/logrotate /etc/logrotate.conf :: At 04:30 AM, only on Sunday
  /opt/app/bin/start-workers :: at startup
  /usr/bin/certbot renew --quiet :: At 12:00 AM (@daily)
  /opt/app/bin/flush-metrics :: Every hour (@hourly)
  /opt/app/bin/sync-crm :: At 15 minutes past the hour, between 09:00 AM and 05:59 PM, Monday through Friday
  /opt/app/bin/invoice-run --month last :: At 12:00 AM, on day 1 of the month
  8 schedules
crontab data/crontabs/web01.crontab de_DE
  env SHELL=/bin/bash
  env MAILTO=ops@example.com
  /usr/local/bin/healthcheck --quiet :: Alle 5 Minuten
  /opt/app/bin/backup-db --retain 14 :: Um 03:00
  /usr/sbin/logrotate /etc/logrotate.conf :: Um 04:30, nur am Sunday
  /opt/app/bin/start-workers :: at startup
  /usr/bin/certbot renew --quiet :: Um 00:00 (@daily)
  /opt/app/bin/flush-metrics :: Jede Stunde (@hourly)
  /opt/app/bin/sync-crm :: Bei Minute 15, zwischen 09:00 und 17:59, Monday bis Friday
  /opt/app/bin/invoice-run --month last :: Um 00:00, am 1 Tag des Monats
  8 schedules
crontab data/crontabs/k8s-cronjobs.txt en_US
  reports-weekly :: At 06:00 AM, only on Monday
  cache-warm :: Every 10 minutes, between 06:00 AM and 10:59 PM
  db-vacuum :: At 02:30 AM, only on Saturday and Sunday
  token-rotate :: At 12:00 AM, on day 1 of the month, every 2 months
  quarterly-close :: At 06:00 PM, on the last day of the month, only in March, June, September, and December
  bad-one :: At 13:00 PM
  6 schedules
crontab data/crontabs/k8s-cronjobs.txt ja_JP
  reports-weekly :: 次において実施 06:00、Monday にのみ
  cache-warm :: 10 分ごと, 06:00 と 22:59 の間
  db-vacuum :: 次において実施 02:30、Saturday と Sunday にのみ
  token-rotate :: 次において実施 00:00、月の 1 日目、2 か月ごと
  quarterly-close :: 次において実施 18:00、次の最終日に、March, June, September, と December でのみ
  bad-one :: 次において実施 25:00
