    t.push_str("org.quartz.job.broken.cron = 0 0 0 1 1\n");
    v.push(DataFile { path: "crontabs/quartz.properties".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# m h  dom mon dow   command\n");
    t.push_str("SHELL=/bin/bash\n");
    t.push_str("MAILTO=ops@example.com\n");
    t.push_str("*/5 * * * * /usr/local/bin/healthcheck --quiet\n");
    t.push_str("0 3 * * * /opt/app/bin/backup-db --retain 14\n");
    t.push_str("30 4 * * 0 /usr/sbin/logrotate /etc/logrotate.conf\n");
    t.push_str("@reboot /opt/app/bin/start-workers\n");
    t.push_str("@daily /usr/bin/certbot renew --quiet\n");
    t.push_str("@hourly /opt/app/bin/flush-metrics\n");
    t.push_str("15 9-17 * * MON-FRI /opt/app/bin/sync-crm\n");
    t.push_str("0 0 1 * * /opt/app/bin/invoice-run --month last\n");
    t.push_str("\n");
    t.push_str("# end of file\n");
    v.push(DataFile { path: "crontabs/web01.crontab".to_string(), hex: false, body: t });
}

