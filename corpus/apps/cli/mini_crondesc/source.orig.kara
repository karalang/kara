// mini_crondesc: cron_descriptor 2.2.1, the library that turns a cron
// expression into a sentence ("At 06:30 AM, Monday through Friday"), as
// Python 3.13 runs it. It ports the expression parser with its
// normalisation of the five, six and seven field forms, the description of
// each field with its special cases (L, W, #, steps over ranges and lists),
// casing and verbosity, the gettext catalogs it reads its phrases from, with
// the fallback that makes a missing phrase empty, the separate
// ExpressionValidator with its error messages, and the command line, whose
// argparse parser is ported for its one positional and four options.
//
// The jobs in data/jobs.jsonl describe schedules from system crontabs,
// Kubernetes CronJobs, Quartz and AWS EventBridge in all 32 shipped
// languages and some catalogs of a team's own, validate them, run the
// command line, and describe three crontab-style files line by line.

// ------------------------------------------------------------ text helpers

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn slice(v: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    let mut i = a;
    while i < b and i < v.len() {
        out.push(v[i]);
        i += 1;
    }
    out
}

// str.isspace() for one character, which is also what `\s` matches.
fn py_space(c: char) -> bool {
    let n = c as u32;
    (n >= 9 and n <= 13) or (n >= 0x1C and n <= 0x20) or n == 0x85 or n == 0xA0 or n == 0x1680
        or (n >= 0x2000 and n <= 0x200A) or n == 0x2028 or n == 0x2029 or n == 0x202F or n == 0x205F
        or n == 0x3000
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut a = 0;
    let mut b = v.len();
    while a < b and py_space(v[a]) {
        a += 1;
    }
    while b > a and py_space(v[b - 1]) {
        b -= 1;
    }
    slice(v, a, b)
}

fn py_rstrip(s: ref String) -> String {
    let v = chars(s);
    let mut b = v.len();
    while b > 0 and py_space(v[b - 1]) {
        b -= 1;
    }
    slice(v, 0, b)
}

fn py_lstrip(s: ref String) -> String {
    let v = chars(s);
    let mut a = 0;
    while a < v.len() and py_space(v[a]) {
        a += 1;
    }
    slice(v, a, v.len())
}

fn hex_digits(n: u32, width: i64) -> String {
    let digits = chars("0123456789abcdef".to_string());
    let mut out: Vec[char] = Vec.new();
    let mut k = 0;
    let mut x = n;
    while k < width {
        out.push(digits[(x % 16) as i64]);
        x = x / 16;
        k += 1;
    }
    out.reverse();
    text(out)
}

// Whether repr() prints a character as it is.
fn printable(c: char) -> bool {
    let n = c as u32;
    if n < 0x20 or (n >= 0x7F and n <= 0xA0) or n == 0xAD {
        return false;
    }
    if (n >= 0x2000 and n <= 0x200F) or (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) {
        return false;
    }
    not (n == 0x1680 or n == 0x3000 or n == 0xFEFF or (n >= 0xD800 and n <= 0xDFFF))
}

// repr() of a str.
fn py_repr(s: ref String) -> String {
    let quote = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in s.chars() {
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if printable(c) {
            out.push(c);
        } else {
            let n = c as u32;
            if n < 0x100 {
                out.push_str("\\x");
                out.push_str(hex_digits(n, 2).as_str());
            } else if n < 0x10000 {
                out.push_str("\\u");
                out.push_str(hex_digits(n, 4).as_str());
            } else {
                out.push_str("\\U");
                out.push_str(hex_digits(n, 8).as_str());
            }
        }
    }
    out.push(quote);
    out
}

// str.splitlines(keepends=True), which is how codecs' readline cuts a file.
fn split_lines(s: ref String) -> Vec[String] {
    let v = chars(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        cur.push(c);
        let n = c as u32;
        let mut ends = (n >= 10 and n <= 13) or (n >= 0x1C and n <= 0x1E) or n == 0x85 or n == 0x2028
            or n == 0x2029;
        if c == '\r' and i + 1 < v.len() and v[i + 1] == '\n' {
            cur.push('\n');
            i += 1;
            ends = true;
        }
        if ends {
            out.push(cur.clone());
            cur = String.new();
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// ------------------------------------------------------------ JSON in

// The jobs file holds arrays, strings, small objects, booleans and null.
#[derive(Clone)]
enum J {
    S(String),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and py_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc = chars(w.to_string());
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else if c >= 'a' and c <= 'f' {
                (c as u32) - ('a' as u32) + 10
            } else {
                (c as u32) - ('A' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: chars(l), pos: 0 };
    p.value()
}

fn j_str(j: ref J) -> String {
    match j {
        J.S(s) => s.clone(),
        _ => String.new(),
    }
}

fn j_opt_str(j: ref J) -> Option[String] {
    match j {
        J.S(s) => Some(s.clone()),
        _ => None,
    }
}

fn j_strs(j: ref J) -> Vec[String] {
    match j {
        J.A(items) => items.iter().map(|x| j_str(x)).collect(),
        _ => Vec.new(),
    }
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_bool(j: ref J, default: bool) -> bool {
    match j {
        J.B(b) => *b,
        _ => default,
    }
}

// json.dumps(s, ensure_ascii=False)
fn json_quote(s: ref String) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if (c as u32) < 0x20 {
            out.push_str("\\u");
            out.push_str(hex_digits(c as u32, 4).as_str());
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

// ------------------------------------------------------------ Python's errors

// An exception as the last line of a traceback prints it.
#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: ref String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg.clone() }
}

fn format_error(msg: ref String) -> PyErr {
    py_err("cron_descriptor.Exception.FormatError", msg)
}

fn value_error(msg: Str) -> PyErr {
    py_err("ValueError", msg.to_string())
}

fn exc_line(e: ref PyErr) -> String {
    if e.msg.is_empty() {
        return e.kind.clone();
    }
    f"{e.kind}: {e.msg}"
}

// ------------------------------------------------------------ str methods

fn is_d(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn has(s: ref String, c: char) -> bool {
    for x in s.chars() {
        if x == c {
            return true;
        }
    }
    false
}

fn has_any(s: ref String, set: Str) -> bool {
    for x in s.chars() {
        for y in set.chars() {
            if x == y {
                return true;
            }
        }
    }
    false
}

fn all_digits(s: ref String) -> bool {
    if s.is_empty() {
        return false;
    }
    for c in s.chars() {
        if not is_d(c) {
            return false;
        }
    }
    true
}

// str.split(sep)
fn py_split(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur.clone());
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// str.split(sep, 1)
fn split_once(s: ref String, sep: char) -> (String, Option[String]) {
    let v = chars(s);
    let mut i = 0;
    while i < v.len() {
        if v[i] == sep {
            return (slice(v, 0, i), Some(slice(v, i + 1, v.len())));
        }
        i += 1;
    }
    (s.clone(), None)
}

// str.split() with no separator
fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if py_space(c) {
            if not cur.is_empty() {
                out.push(cur.clone());
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// str.replace(old, new) for a non-empty old
fn py_replace(s: ref String, old: ref String, new: ref String) -> String {
    if old.is_empty() {
        return s.clone();
    }
    let v = chars(s);
    let o = chars(old);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        let mut hit = i + o.len() <= v.len();
        let mut k = 0;
        while hit and k < o.len() {
            if v[i + k] != o[k] {
                hit = false;
            }
            k += 1;
        }
        if hit {
            out.push_str(new.as_str());
            i += o.len();
        } else {
            out.push(v[i]);
            i += 1;
        }
    }
    out
}

fn replace_str(s: ref String, old: Str, new: Str) -> String {
    py_replace(s, old.to_string(), new.to_string())
}

fn upper_char(c: char) -> String {
    c.to_string().to_uppercase()
}

fn lower_char(c: char) -> String {
    c.to_string().to_lowercase()
}

fn is_cased(c: char) -> bool {
    upper_char(c) != c.to_string() or lower_char(c) != c.to_string()
}

// str.title()
fn py_title(s: ref String) -> String {
    let mut out = String.new();
    let mut prev = false;
    for c in s.chars() {
        if prev {
            out.push_str(lower_char(c).as_str());
        } else {
            out.push_str(upper_char(c).as_str());
        }
        prev = is_cased(c);
    }
    out
}

fn zfill(s: ref String, w: i64) -> String {
    let v = chars(s);
    if v.len() >= w {
        return s.clone();
    }
    let mut out = String.new();
    let mut i = 0;
    if v.len() > 0 and (v[0] == '-' or v[0] == '+') {
        out.push(v[0]);
        i = 1;
    }
    let mut k = v.len();
    while k < w {
        out.push('0');
        k += 1;
    }
    while i < v.len() {
        out.push(v[i]);
        i += 1;
    }
    out
}

// int(s) for a str
fn py_int(s: ref String) -> Result[i64, PyErr] {
    let v = chars(s);
    let mut a = 0;
    let mut b = v.len();
    while a < b and py_space(v[a]) {
        a += 1;
    }
    while b > a and py_space(v[b - 1]) {
        b -= 1;
    }
    let mut neg = false;
    let mut i = a;
    if i < b and (v[i] == '+' or v[i] == '-') {
        neg = v[i] == '-';
        i += 1;
    }
    let mut n: i64 = 0;
    let mut no_us = true;
    let mut ok = true;
    while i < b {
        let c = v[i];
        if is_d(c) {
            n = n * 10 + ((c as i64) - ('0' as i64));
            no_us = false;
        } else if c == '_' and not no_us {
            no_us = true;
        } else {
            ok = false;
        }
        i += 1;
    }
    if not ok or no_us {
        return Err(py_err("ValueError", f"invalid literal for int() with base 10: {py_repr(s)}"));
    }
    Ok(if neg { 0 - n } else { n })
}

fn int_ok(s: ref String) -> Option[i64] {
    match py_int(s) {
        Ok(n) => Some(n),
        Err(_) => None,
    }
}

// str.format with positional str arguments, as CPython parses the
// template: doubled braces, auto and manual numbering, names.
fn py_format(f: ref String, args: ref Vec[String]) -> Result[String, PyErr] {
    let v = chars(f);
    let mut out = String.new();
    let mut i = 0;
    let mut auto: i64 = 0;
    let mut mode = 0;
    while i < v.len() {
        let c = v[i];
        if c == '{' {
            if i + 1 < v.len() and v[i + 1] == '{' {
                out.push('{');
                i += 2;
                continue;
            }
            if i + 1 >= v.len() {
                return Err(value_error("Single '{' encountered in format string"));
            }
            let mut depth = 1;
            let mut j = i + 1;
            while j < v.len() {
                if v[j] == '{' {
                    depth += 1;
                } else if v[j] == '}' {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                j += 1;
            }
            if j >= v.len() {
                return Err(value_error("expected '}' before end of string"));
            }
            let fv = chars(slice(v, i + 1, j));
            let mut k = 0;
            while k < fv.len() and fv[k] != '!' and fv[k] != ':' {
                k += 1;
            }
            let name = slice(fv, 0, k);
            let conv = if k + 1 < fv.len() and fv[k] == '!' { fv[k + 1] } else { 's' };
            let index = if name.is_empty() {
                if mode == 2 {
                    return Err(value_error("cannot switch from manual field specification to automatic field numbering"));
                }
                mode = 1;
                auto += 1;
                auto - 1
            } else if all_digits(name) {
                if mode == 1 {
                    return Err(value_error("cannot switch from automatic field numbering to manual field specification"));
                }
                mode = 2;
                py_int(name)?
            } else {
                return Err(py_err("KeyError", py_repr(name)));
            };
            if index >= args.len() {
                return Err(py_err("IndexError", f"Replacement index {index} out of range for positional args tuple"));
            }
            if conv == 'r' {
                out.push_str(py_repr(args[index]).as_str());
            } else {
                out.push_str(args[index].as_str());
            }
            i = j + 1;
        } else if c == '}' {
            if i + 1 < v.len() and v[i + 1] == '}' {
                out.push('}');
                i += 2;
                continue;
            }
            return Err(value_error("Single '}' encountered in format string"));
        } else {
            out.push(c);
            i += 1;
        }
    }
    Ok(out)
}

fn fmt1(f: ref String, a: ref String) -> Result[String, PyErr] {
    py_format(f, vec![a.clone()])
}

fn fmt2(f: ref String, a: ref String, b: ref String) -> Result[String, PyErr] {
    py_format(f, vec![a.clone(), b.clone()])
}

// ------------------------------------------------------------ gettext

#[derive(Clone)]
struct Catalog {
    single: Map[String, String],
    // the first form of each plural entry, which gettext() falls back to
    plural0: Map[String, String],
}

fn u32_at(b: ref Vec[u8], at: i64, big: bool) -> i64 {
    let mut x: i64 = 0;
    for k in 0..4 {
        let byte = if big { b[at + k] } else { b[at + 3 - k] };
        x = (x << 8) | (byte as i64);
    }
    x
}

fn sub(b: ref Vec[u8], lo: i64, hi: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = lo;
    while i < hi {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn decode(b: ref Vec[u8]) -> String {
    String.from_utf8(b.clone()).unwrap_or("?".to_string())
}

fn struct_error(n: i64) -> PyErr {
    py_err("struct.error", f"unpack requires a buffer of {n} bytes")
}

// What reading a catalog can raise: an OSError (which GetText answers by
// loading en_US instead) or anything else, which it lets through.
enum MoErr {
    Os(String),
    Other(PyErr),
}

// GNUTranslations._parse
fn load_mo(buf: ref Vec[u8]) -> Result[Catalog, MoErr] {
    let mut c = Catalog { single: Map.new(), plural0: Map.new() };
    let n = buf.len();
    if n < 4 {
        return Err(MoErr.Other(struct_error(4)));
    }
    let magic = u32_at(buf, 0, false);
    let big = if magic == 0x950412de {
        false
    } else if magic == 0xde120495 {
        true
    } else {
        return Err(MoErr.Os("Bad magic number".to_string()));
    };
    if n < 20 {
        return Err(MoErr.Other(struct_error(16)));
    }
    let version = u32_at(buf, 4, big);
    let count = u32_at(buf, 8, big);
    let mut master = u32_at(buf, 12, big);
    let mut trans = u32_at(buf, 16, big);
    let major = version >> 16;
    if major != 0 and major != 1 {
        return Err(MoErr.Os(f"Bad version number {major}"));
    }
    let mut i = 0;
    while i < count {
        if master + 8 > n {
            return Err(MoErr.Other(struct_error(8)));
        }
        let mlen = u32_at(buf, master, big);
        let moff = u32_at(buf, master + 4, big);
        if trans + 8 > n {
            return Err(MoErr.Other(struct_error(8)));
        }
        let tlen = u32_at(buf, trans, big);
        let toff = u32_at(buf, trans + 4, big);
        if not (moff + mlen < n and toff + tlen < n) {
            return Err(MoErr.Os("File is corrupt".to_string()));
        }
        let msg = sub(buf, moff, moff + mlen);
        let tmsg = sub(buf, toff, toff + tlen);
        // The header only sets the charset and the plural rule; every
        // catalog here is UTF-8 or plain ASCII, and none has plural entries
        // whose form would depend on the rule.
        let mut zero = -1;
        let mut k = 0;
        while k < msg.len() {
            if msg[k] == 0 and zero < 0 {
                zero = k;
            }
            k += 1;
        }
        if zero >= 0 {
            let mut end = 0;
            while end < tmsg.len() and tmsg[end] != 0 {
                end += 1;
            }
            c.plural0.insert(decode(sub(msg, 0, zero)), decode(sub(tmsg, 0, end)));
        } else {
            c.single.insert(decode(msg), decode(tmsg));
        }
        master += 8;
        trans += 8;
        i += 1;
    }
    Ok(c)
}

// Catalogs already read, by path; the files do not change while the jobs
// run. A Desc takes its catalog out of the cache and give_back returns it.
fn read_mo(cache: mut ref Map[String, Catalog], path: ref String) -> Result[(Catalog, String), MoErr] {
    if let Some(c) = cache.remove(path.clone()) {
        return Ok((c, path.clone()));
    }
    let c = read_mo_file(path)?;
    Ok((c, path.clone()))
}

fn read_mo_file(path: ref String) -> Result[Catalog, MoErr] {
    if not fs.exists(path.clone()) {
        return Err(MoErr.Os("No such file or directory".to_string()));
    }
    match fs.read_bytes(path.clone()) {
        Ok(b) => load_mo(b),
        Err(_) => Err(MoErr.Os("cannot read".to_string())),
    }
}

// GetText: the locale's catalog, or en_US from the package if that one
// cannot be opened or is not a catalog.
fn get_text(cache: mut ref Map[String, Catalog], code: ref String, location: ref Option[String]) -> Result[(Catalog, String), PyErr] {
    let dir = match location {
        Some(l) => if l.is_empty() { "data/locale".to_string() } else { l.clone() },
        None => "data/locale".to_string(),
    };
    match read_mo(mut cache, f"{dir}/{code}.mo") {
        Ok(c) => Ok(c),
        Err(MoErr.Other(e)) => Err(e),
        Err(MoErr.Os(_)) => match read_mo(mut cache, "data/locale/en_US.mo".to_string()) {
            Ok(c) => Ok(c),
            Err(MoErr.Other(e)) => Err(e),
            Err(MoErr.Os(m)) => Err(py_err("OSError", m)),
        },
    }
}

// ------------------------------------------------------------ Options

#[derive(Clone)]
struct Options {
    locale_code: String,
    // 1 Title, 2 Sentence, 3 LowerCase
    casing: i64,
    verbose: bool,
    dow0: bool,
    h24: bool,
    location: Option[String],
}

fn twelve_hour(code: ref String) -> bool {
    let l = vec!["en_US", "en_CA", "fr_CA", "en_AU", "en_NZ", "en_IE", "en_PH", "es_MX", "en_PK", "en_IN", "ar_SA",
        "bn_BD", "es_HN", "es_SV", "es_NI", "ar_JO", "ar_EG", "es_CO"];
    l.iter().any(|x| x == code.as_str())
}

fn casing_of(name: ref String) -> i64 {
    if name == "Title" {
        1
    } else if name == "LowerCase" {
        3
    } else {
        2
    }
}

// Options(locale_code=...): use_24hour_time_format follows the locale when
// it is not given.
fn new_options(code: ref String, h24: Option[bool]) -> Options {
    Options {
        locale_code: code.clone(),
        casing: 2,
        verbose: false,
        dow0: true,
        h24: match h24 {
            Some(b) => b,
            None => not twelve_hour(code),
        },
        location: None,
    }
}

// ------------------------------------------------------------ ExpressionParser

fn ends_with_4_digits(s: ref String) -> bool {
    let v = chars(s);
    if v.len() < 4 {
        return false;
    }
    let mut k = v.len() - 4;
    while k < v.len() {
        if not is_d(v[k]) {
            return false;
        }
        k += 1;
    }
    true
}

fn day_abbr() -> Vec[String] {
    vec!["SUN".to_string(), "MON".to_string(), "TUE".to_string(), "WED".to_string(), "THU".to_string(),
        "FRI".to_string(), "SAT".to_string()]
}

fn month_abbr() -> Vec[String] {
    vec!["JAN".to_string(), "FEB".to_string(), "MAR".to_string(), "APR".to_string(), "MAY".to_string(),
        "JUN".to_string(), "JUL".to_string(), "AUG".to_string(), "SEP".to_string(), "OCT".to_string(),
        "NOV".to_string(), "DEC".to_string()]
}

// re.sub(r"(^\d)|([^#/\s]\d)", digit_replace, dow)
fn adjust_dow(s: ref String, dow0: bool) -> Result[String, PyErr] {
    let v = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        let mut len = 0;
        if i == 0 and is_d(v[0]) {
            len = 1;
        } else if v[i] != '#' and v[i] != '/' and not py_space(v[i]) and i + 1 < v.len() and is_d(v[i + 1]) {
            len = 2;
        }
        if len == 0 {
            out.push(v[i]);
            i += 1;
            continue;
        }
        let mv = slice(v, i, i + len);
        let mut digits = String.new();
        for c in mv.chars() {
            if is_d(c) {
                digits.push(c);
            }
        }
        let mut adjusted = digits.clone();
        if dow0 {
            if digits == "7" {
                adjusted = "0".to_string();
            }
        } else {
            adjusted = f"{py_int(digits)? - 1}";
        }
        out.push_str(py_replace(mv, digits, adjusted).as_str());
        i += len;
    }
    Ok(out)
}

fn starts(s: ref String, p: Str) -> bool {
    s.starts_with(p)
}

fn parse_expression(e: ref String, o: ref Options) -> Result[Vec[String], PyErr] {
    let mut p: Vec[String] = Vec.new();
    for _ in 0..7 {
        p.push(String.new());
    }
    if e.is_empty() {
        return Err(py_err("cron_descriptor.Exception.MissingFieldError",
            "Field 'ExpressionDescriptor.expression' not found.".to_string()));
    }
    let t = split_ws(e);
    let n = t.len();
    if n < 5 {
        return Err(format_error(f"Error: Expression only has {n} parts.  At least 5 part are required."));
    }
    if n == 5 {
        for i in 0..5 {
            p[i + 1] = t[i].clone();
        }
    } else if n == 6 {
        let shift = ends_with_4_digits(t[5]) or t[4] == "?" or t[2] == "?";
        for i in 0..6 {
            if shift {
                p[i + 1] = t[i].clone();
            } else {
                p[i] = t[i].clone();
            }
        }
    } else if n == 7 {
        p = t;
    } else {
        return Err(format_error(f"Error: Expression has too many parts ({n}).  Expression must not have more than 7 parts."));
    }
    // normalize_expression
    p[3] = replace_str(p[3], "?", "*");
    p[5] = replace_str(p[5], "?", "*");
    for i in 0..3 {
        if starts(p[i], "0/") {
            p[i] = replace_str(p[i], "0/", "*/");
        }
    }
    for i in 3..7 {
        if starts(p[i], "1/") {
            p[i] = replace_str(p[i], "1/", "*/");
        }
    }
    p[5] = adjust_dow(p[5], o.dow0)?;
    if p[3] == "?" {
        p[3] = "*".to_string();
    }
    // .upper() before each replace, as the parser does; it is idempotent, so
    // once is the same.
    p[5] = p[5].to_uppercase();
    p[4] = p[4].to_uppercase();
    let days = day_abbr();
    for d in 0..7 {
        if p[5].contains(days[d].as_str()) {
            p[5] = py_replace(p[5], days[d], f"{d}");
        }
    }
    let months = month_abbr();
    for m in 0..12 {
        if p[4].contains(months[m].as_str()) {
            p[4] = py_replace(p[4], months[m], f"{m + 1}");
        }
    }
    if p[0] == "0" {
        p[0] = String.new();
    }
    let star0 = has_any(p[0], "*/");
    let star1 = has_any(p[1], "*/");
    let special2 = has_any(p[2], "*-,/");
    if not special2 and (star0 or star1) {
        p[2] = f"{p[2]}-{p[2]}";
    }
    for i in 0..7 {
        if p[i] == "*/1" {
            p[i] = "*".to_string();
        }
        if has(p[i], '/') and not has_any(p[i], "*-,") and i >= 4 {
            let thr = if i == 4 { "12" } else if i == 5 { "6" } else { "9999" };
            let parts = py_split(p[i], '/');
            p[i] = f"{parts[0]}-{thr}/{parts[1]}";
        }
    }
    Ok(p)
}

// ------------------------------------------------------------ ExpressionDescriptor

enum Field {
    Sec,
    Min,
    Hour,
    Dow,
    // the day list in front of a step, e.g. 1,3/2
    DowList,
    Month,
    Dom,
    Year,
}

struct Desc {
    p: Vec[String],
    o: Options,
    cat: Catalog,
    cat_path: String,
}

fn tr(d: ref Desc, m: Str) -> String {
    if let Some(v) = d.cat.single.get(m) {
        return v.clone();
    }
    if let Some(v) = d.cat.plural0.get(m) {
        return v.clone();
    }
    String.new()
}

// translate(a) or translate(b)
fn tr2(d: ref Desc, a: Str, b: Str) -> String {
    let x = tr(d, a);
    if x.is_empty() { tr(d, b) } else { x }
}

fn special(s: ref String) -> bool {
    has_any(s, "/-,*")
}

fn format_time(d: ref Desc, hour_e: ref String, min_e: ref String, sec_e: own Option[String]) -> Result[String, PyErr] {
    let mut hour = py_int(hour_e)?;
    let mut period = String.new();
    if not d.o.h24 {
        period = if hour >= 12 { tr(d, "PM") } else { tr(d, "AM") };
        if not period.is_empty() {
            period = f" {period}";
        }
        if hour > 12 {
            hour -= 12;
        }
        if hour == 0 {
            hour = 12;
        }
    }
    let minute = f"{py_int(min_e)?}";
    let mut second = String.new();
    if let Some(s) = sec_e {
        if not s.is_empty() {
            let sn = f"{py_int(s)?}";
            second = f":{zfill(sn, 2)}";
        }
    }
    let hs = f"{hour}";
    Ok(f"{zfill(hs, 2)}:{zfill(minute, 2)}{second}{period}")
}

fn day_name(n: i64) -> Result[String, PyErr] {
    let names = vec!["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    if n >= 0 and n < 7 {
        return Ok(names[n].to_string());
    }
    if n < 0 and n >= -7 {
        return Ok(names[7 + n].to_string());
    }
    Err(py_err("IndexError", f"Day {n} is out of range!"))
}

fn get_day_name(s: ref String) -> Result[String, PyErr] {
    let mut exp = s.clone();
    if has(s, '#') {
        let parts = py_split(s, '#');
        if parts.len() > 2 {
            return Err(value_error("too many values to unpack (expected 2, got 3)"));
        }
        exp = parts[0].clone();
    } else if has(s, 'L') {
        exp = replace_str(exp, "L", "");
    }
    day_name(py_int(exp)?)
}

fn month_name(s: ref String) -> Result[String, PyErr] {
    let m = py_int(s)?;
    if m < 1 or m > 12 {
        return Err(value_error("month must be in 1..12"));
    }
    let names = vec!["January", "February", "March", "April", "May", "June", "July", "August", "September", "October",
        "November", "December"];
    Ok(names[m - 1].to_string())
}

fn format_year(s: ref String) -> Result[String, PyErr] {
    if all_digits(s) {
        let y = py_int(s)?;
        if y < 1900 {
            return Ok(f"{y}");
        }
        if y > 9999 {
            return Err(py_err("ValueError", f"year {y} is out of range"));
        }
        return Ok(f"{y}");
    }
    Ok(s.clone())
}

fn single(d: ref Desc, f: ref Field, s: ref String) -> Result[String, PyErr] {
    match f {
        Field.Hour => format_time(d, s, "0".to_string(), None),
        Field.Dow => get_day_name(s),
        Field.DowList => get_day_name(s),
        Field.Month => month_name(s),
        Field.Year => format_year(s),
        _ => Ok(s.clone()),
    }
}

fn interval(d: ref Desc, f: ref Field, s: ref String) -> Result[String, PyErr] {
    match f {
        Field.Sec => fmt1(tr(d, "every {0} seconds"), s),
        Field.Min => fmt1(tr(d, "every {0} minutes"), s),
        Field.Hour => fmt1(tr(d, "every {0} hours"), s),
        Field.Dow => fmt1(tr(d, ", every {0} days of the week"), s),
        Field.DowList => fmt1(tr(d, ", every {0} days of the week"), s),
        Field.Month => fmt1(tr(d, ", every {0} months"), s),
        Field.Year => fmt1(tr(d, ", every {0} years"), s),
        Field.Dom => Ok(if s == "1" { tr(d, ", every day") } else { tr(d, ", every {0} days") }),
    }
}

fn between(d: ref Desc, f: ref Field) -> String {
    match f {
        Field.Sec => tr(d, "seconds {0} through {1} past the minute"),
        Field.Min => tr(d, "minutes {0} through {1} past the hour"),
        Field.Hour => tr(d, "between {0} and {1}"),
        Field.Dow => tr(d, ", {0} through {1}"),
        Field.DowList => tr(d, ", {0} through {1}"),
        Field.Month => tr2(d, ", month {0} through month {1}", ", {0} through {1}"),
        Field.Year => tr2(d, ", year {0} through year {1}", ", {0} through {1}"),
        Field.Dom => tr(d, ", between day {0} and {1} of the month"),
    }
}

fn range_format(d: ref Desc, f: ref Field) -> String {
    match f {
        Field.Sec => tr2(d, ", second {0} through second {1}", ", {0} through {1}"),
        Field.Min => tr2(d, ", minute {0} through minute {1}", ", {0} through {1}"),
        Field.Hour => tr2(d, ", hour {0} through hour {1}", ", {0} through {1}"),
        Field.Month => tr2(d, ", month {0} through month {1}", ", {0} through {1}"),
        Field.Year => tr2(d, ", year {0} through year {1}", ", {0} through {1}"),
        _ => tr(d, ", {0} through {1}"),
    }
}

fn dow_format(d: ref Desc, s: ref String) -> String {
    if has(s, '#') {
        let v = chars(s);
        let mut at = 0;
        while v[at] != '#' {
            at += 1;
        }
        let which = match int_ok(slice(v, at + 1, v.len())) {
            Some(1) => tr(d, "first"),
            Some(2) => tr(d, "second"),
            Some(3) => tr(d, "third"),
            Some(4) => tr(d, "fourth"),
            Some(5) => tr(d, "fifth"),
            _ => String.new(),
        };
        let a = tr(d, ", on the ");
        let b = tr(d, " {0} of the month");
        return f"{a}{which}{b}";
    }
    if has(s, 'L') {
        return tr(d, ", on the last {0} of the month");
    }
    if d.p[3] != "*" {
        return tr2(d, ", or on {0}", ", only on {0}");
    }
    tr(d, ", only on {0}")
}

fn description_format(d: ref Desc, f: ref Field, s: ref String) -> String {
    match f {
        Field.Sec => {
            if s == "0" {
                return String.new();
            }
            match int_ok(s) {
                Some(n) => if n < 20 {
                    tr(d, "at {0} seconds past the minute")
                } else {
                    tr2(d, "at {0} seconds past the minute [grThen20]", "at {0} seconds past the minute")
                },
                None => tr(d, "at {0} seconds past the minute"),
            }
        }
        Field.Min => {
            let hour_e = d.p[2].clone();
            let is_hour_range = has(hour_e, '-') and not has_any(hour_e, "/,");
            if s == "0" and d.p[0].is_empty() and not is_hour_range {
                return String.new();
            }
            match int_ok(s) {
                Some(n) => if n < 20 {
                    tr(d, "at {0} minutes past the hour")
                } else {
                    tr2(d, "at {0} minutes past the hour [grThen20]", "at {0} minutes past the hour")
                },
                None => tr(d, "at {0} minutes past the hour"),
            }
        }
        Field.Hour => tr(d, "at {0}"),
        Field.Dow => dow_format(d, s),
        Field.DowList => tr(d, ", only on {0}"),
        Field.Month => tr(d, ", only in {0}"),
        Field.Year => tr(d, ", only in {0}"),
        Field.Dom => tr(d, ", on day {0} of the month"),
    }
}

fn generate_between(d: ref Desc, e: ref String, fmt: ref String, f: ref Field) -> Result[String, PyErr] {
    let segs = py_split(e, '-');
    let a = single(d, f, segs[0])?;
    let b = replace_str(single(d, f, segs[1])?, ":00", ":59");
    fmt2(fmt, a, b)
}

fn step_in_comma(d: ref Desc, seg: ref String, f: ref Field) -> Result[String, PyErr] {
    let subs = py_split(seg, '/');
    let mut step = fmt1(interval(d, f, subs[1])?, subs[1])?;
    if starts(step, ", ") {
        let v = chars(step);
        step = slice(v, 2, v.len());
    }
    if has(subs[0], '-') {
        let b = generate_between(d, subs[0], range_format(d, f), f)?;
        let bb = replace_str(b, ", ", "");
        step = f"{step}, {bb}";
    } else if subs[0] != "*" {
        let item = single(d, f, subs[0])?;
        let st = fmt1(tr(d, "starting {0}"), item)?;
        step = f"{step}, {st}";
    }
    Ok(step)
}

fn segment(d: ref Desc, f: ref Field, e: ref String, all: ref String) -> Result[String, PyErr] {
    if e.is_empty() {
        return Ok(String.new());
    }
    if e == "*" {
        return Ok(all.clone());
    }
    if not has_any(e, "/-,") {
        let fmt = description_format(d, f, e);
        return fmt1(fmt, single(d, f, e)?);
    }
    if has(e, ',') {
        let segs = py_split(e, ',');
        let n = segs.len();
        let mut content = String.new();
        for i in 0..n {
            if i > 0 and n > 2 {
                content.push(',');
                if i < n - 1 {
                    content.push(' ');
                }
            }
            if i > 0 and n > 1 and (i == n - 1 or n == 2) {
                content.push_str(tr(d, " and ").as_str());
            }
            let seg = segs[i].clone();
            if has(seg, '/') {
                content.push_str(step_in_comma(d, seg, f)?.as_str());
            } else if has(seg, '-') {
                let b = generate_between(d, seg, range_format(d, f), f)?;
                content.push_str(replace_str(b, ", ", "").as_str());
            } else {
                content.push_str(single(d, f, seg)?.as_str());
            }
        }
        return fmt1(description_format(d, f, e), content);
    }
    if has(e, '/') {
        let segs = py_split(e, '/');
        let mut out = fmt1(interval(d, f, segs[1])?, segs[1])?;
        if has(segs[0], '-') {
            let b = generate_between(d, segs[0], between(d, f), f)?;
            if not starts(b, ", ") {
                out.push_str(", ");
            }
            out.push_str(b.as_str());
        } else if not has_any(segs[0], "*,") {
            let fmt = description_format(d, f, segs[0]);
            let item = replace_str(fmt1(fmt, single(d, f, segs[0])?)?, ", ", "");
            out.push_str(fmt1(tr(d, ", starting {0}"), item)?.as_str());
        }
        return Ok(out);
    }
    generate_between(d, e, between(d, f), f)
}

fn seconds_description(d: ref Desc) -> Result[String, PyErr] {
    segment(d, Field.Sec, d.p[0], tr(d, "every second"))
}

fn minutes_description(d: ref Desc) -> Result[String, PyErr] {
    segment(d, Field.Min, d.p[1], tr(d, "every minute"))
}

fn hours_description(d: ref Desc) -> Result[String, PyErr] {
    segment(d, Field.Hour, d.p[2], tr(d, "every hour"))
}

fn month_description(d: ref Desc) -> Result[String, PyErr] {
    segment(d, Field.Month, d.p[4], String.new())
}

fn year_description(d: ref Desc) -> Result[String, PyErr] {
    segment(d, Field.Year, d.p[6], String.new())
}

fn time_of_day_description(d: ref Desc) -> Result[String, PyErr] {
    let sec = d.p[0].clone();
    let min = d.p[1].clone();
    let hour = d.p[2].clone();
    let mut parts: Vec[String] = Vec.new();
    if not special(min) and not special(hour) and not special(sec) {
        parts.push(tr(d, "At "));
        parts.push(format_time(d, hour, min, Some(sec))?);
    } else if sec.is_empty() and has(min, '-') and not has(min, ',') and not special(hour) {
        let mp = py_split(min, '-');
        let fmt = tr(d, "Every minute between {0} and {1}");
        let a = format_time(d, hour, mp[0], None)?;
        let b = format_time(d, hour, mp[1], None)?;
        parts.push(fmt2(fmt, a, b)?);
    } else if sec.is_empty() and has(hour, ',') and not has(hour, '-') and not special(min) {
        let hp = py_split(hour, ',');
        let n = hp.len();
        parts.push(tr(d, "At"));
        for i in 0..n {
            parts.push(" ".to_string());
            parts.push(format_time(d, hp[i], min, None)?);
            if i < n - 2 {
                parts.push(",".to_string());
            }
            if i == n - 2 {
                parts.push(tr(d, " and"));
            }
        }
    } else {
        let s = seconds_description(d)?;
        let m = minutes_description(d)?;
        let h = hours_description(d)?;
        parts.push(s);
        if parts.iter().any(|x| not x.is_empty()) and not m.is_empty() {
            parts.push(", ".to_string());
        }
        parts.push(m);
        if parts.iter().any(|x| not x.is_empty()) and not h.is_empty() {
            parts.push(", ".to_string());
        }
        parts.push(h);
    }
    let mut out = String.new();
    for x in parts.iter() {
        out.push_str(x.as_str());
    }
    Ok(out)
}

fn day_of_week_description(d: ref Desc) -> Result[String, PyErr] {
    let e = d.p[5].clone();
    if e == "*" {
        return Ok(String.new());
    }
    let (base, rest) = split_once(e, '/');
    if let Some(step) = rest {
        if all_digits(step) {
            let mut day: Option[String] = None;
            if has(base, ',') {
                day = Some(segment(d, Field.DowList, base, String.new())?);
            } else if has(base, '-') {
                let rs = py_split(base, '-');
                if rs.len() > 2 {
                    return Err(value_error(f"too many values to unpack (expected 2, got {rs.len()})"));
                }
                let end = py_int(rs[1])?;
                let size = (if end == 0 { 7 } else { end }) - py_int(rs[0])? + 1;
                if py_int(step)? >= size {
                    if py_int(rs[1])? == 6 {
                        day = Some(fmt1(tr(d, ", only on {0}"), get_day_name(rs[0])?)?);
                    } else {
                        day = Some(generate_between(d, base, tr(d, ", {0} through {1}"), Field.Dow)?);
                    }
                }
            }
            if let Some(dd) = day {
                let iv = fmt1(tr2(d, ", every {0} weeks", ", every {0} days of the week"), step)?;
                return Ok(f"{iv}{dd}");
            }
        }
    }
    segment(d, Field.Dow, e, tr(d, ", every day"))
}

fn char_at(v: ref Vec[char], i: i64) -> char {
    if i < v.len() { v[i] } else { ' ' }
}

// re.match(r"(\d{1,2}W)|(W\d{1,2})", e)
fn weekday_match(e: ref String) -> Option[String] {
    let v = chars(e);
    if is_d(char_at(v, 0)) {
        if is_d(char_at(v, 1)) and char_at(v, 2) == 'W' {
            return Some(slice(v, 0, 3));
        }
        if char_at(v, 1) == 'W' {
            return Some(slice(v, 0, 2));
        }
    }
    if char_at(v, 0) == 'W' and is_d(char_at(v, 1)) {
        if is_d(char_at(v, 2)) {
            return Some(slice(v, 0, 3));
        }
        return Some(slice(v, 0, 2));
    }
    None
}

// re.match(r"L-(\d{1,2})", e).group(1)
fn last_offset_match(e: ref String) -> Option[String] {
    let v = chars(e);
    if v.len() < 3 or v[0] != 'L' or v[1] != '-' or not is_d(v[2]) {
        return None;
    }
    if v.len() > 3 and is_d(v[3]) {
        return Some(slice(v, 2, 4));
    }
    Some(slice(v, 2, 3))
}

fn day_of_month_description(d: ref Desc) -> Result[String, PyErr] {
    let e = d.p[3].clone();
    if e == "L" {
        return Ok(tr(d, ", on the last day of the month"));
    }
    if e == "LW" or e == "WL" {
        return Ok(tr(d, ", on the last weekday of the month"));
    }
    if let Some(m) = weekday_match(e) {
        let n = py_int(replace_str(m, "W", ""))?;
        let day = if n == 1 { tr(d, "first weekday") } else { fmt1(tr(d, "weekday nearest day {0}"), f"{n}")? };
        return fmt1(tr(d, ", on the {0} of the month"), day);
    }
    if e == "*" and d.p[5] != "*" {
        return Ok(String.new());
    }
    if let Some(off) = last_offset_match(e) {
        return fmt1(tr(d, ", {0} days before the last day of the month"), off);
    }
    segment(d, Field.Dom, e, tr(d, ", every day"))
}

fn transform_verbosity(d: ref Desc, s: ref String) -> String {
    if d.o.verbose {
        return s.clone();
    }
    let mut out = py_replace(s, tr(d, ", every minute"), String.new());
    out = py_replace(out, tr(d, ", every hour"), String.new());
    out = py_replace(out, tr(d, ", every day"), String.new());
    let v = chars(out);
    if v.len() >= 2 and v[v.len() - 2] == ',' and v[v.len() - 1] == ' ' {
        return slice(v, 0, v.len() - 2);
    }
    if v.len() >= 1 and v[v.len() - 1] == ',' {
        return slice(v, 0, v.len() - 1);
    }
    out
}

fn transform_case(s: ref String, casing: i64) -> Result[String, PyErr] {
    if casing == 2 {
        let v = chars(s);
        if v.is_empty() {
            return Err(py_err("IndexError", "string index out of range".to_string()));
        }
        return Ok(f"{upper_char(v[0])}{slice(v, 1, v.len())}");
    }
    if casing == 1 {
        return Ok(py_title(s));
    }
    Ok(s.to_lowercase())
}

fn full_inner(d: ref Desc) -> Result[String, PyErr] {
    let time = time_of_day_description(d)?;
    let dom = day_of_month_description(d)?;
    let month = month_description(d)?;
    let dow = day_of_week_description(d)?;
    let year = year_description(d)?;
    let s = transform_verbosity(d, f"{time}{dom}{dow}{month}{year}");
    transform_case(s, d.o.casing)
}

fn full_description(d: ref Desc) -> Result[String, PyErr] {
    match full_inner(d) {
        Ok(s) => Ok(s),
        Err(_) => Err(format_error(tr(d, "An error occurred when generating the expression description.  Check the cron expression syntax."))),
    }
}

fn get_description(d: ref Desc, part: ref String) -> Result[String, PyErr] {
    if part == "TIMEOFDAY" {
        time_of_day_description(d)
    } else if part == "SECONDS" {
        seconds_description(d)
    } else if part == "MINUTES" {
        minutes_description(d)
    } else if part == "HOURS" {
        hours_description(d)
    } else if part == "DAYOFWEEK" {
        day_of_week_description(d)
    } else if part == "MONTH" {
        month_description(d)
    } else if part == "DAYOFMONTH" {
        day_of_month_description(d)
    } else if part == "YEAR" {
        year_description(d)
    } else {
        full_description(d)
    }
}

// ExpressionDescriptor(expression, options)
fn descriptor(cache: mut ref Map[String, Catalog], e: ref String, o: own Options) -> Result[Desc, PyErr] {
    let (cat, path) = get_text(mut cache, o.locale_code, o.location)?;
    match parse_expression(e, o) {
        Ok(p) => Ok(Desc { p: p, o: o, cat: cat, cat_path: path }),
        Err(err) => {
            cache.insert(path, cat);
            Err(err)
        }
    }
}

fn give_back(cache: mut ref Map[String, Catalog], d: own Desc) {
    cache.insert(d.cat_path, d.cat);
}

// ------------------------------------------------------------ ExpressionValidator

// \d{lo,hi} as the whole string
fn digits_len(s: ref String, lo: i64, hi: i64) -> bool {
    let n = chars(s).len();
    all_digits(s) and n >= lo and n <= hi
}

// \d{a,b}<sep>\d{c,d} as the whole string
fn pair(s: ref String, sep: char, a: i64, b: i64, c: i64, d: i64) -> bool {
    let p = py_split(s, sep);
    p.len() == 2 and digits_len(p[0], a, b) and digits_len(p[1], c, d)
}

// \d{n,m}-\d{n,m}/\d{x,y}
fn range_step(s: ref String, n: i64, m: i64, x: i64, y: i64) -> bool {
    let p = py_split(s, '/');
    p.len() == 2 and pair(p[0], '-', n, m, n, m) and digits_len(p[1], x, y)
}

fn star_step(s: ref String, x: i64, y: i64) -> bool {
    let v = chars(s);
    v.len() >= 2 and v[0] == '*' and v[1] == '/' and digits_len(slice(v, 2, v.len()), x, y)
}

// ^(\d{n,m}|\d{n,m}-\d{n,m})(,\d{n,m}|,\d{n,m}-\d{n,m})+$, or without the
// ranges
fn number_list(s: ref String, n: i64, m: i64, ranges: bool) -> bool {
    let items = py_split(s, ',');
    if items.len() < 2 {
        return false;
    }
    for it in items.iter() {
        if not (digits_len(it, n, m) or (ranges and pair(it, '-', n, m, n, m))) {
            return false;
        }
    }
    true
}

fn no_digits(s: ref String) -> bool {
    for c in s.chars() {
        if is_d(c) {
            return false;
        }
    }
    true
}

// \D{3}$
fn three_non_digits(s: ref String) -> bool {
    chars(s).len() == 3 and no_digits(s)
}

// \D{3}-\D{3}$
fn name_range(s: ref String) -> bool {
    let v = chars(s);
    v.len() == 7 and v[3] == '-' and no_digits(s)
}

fn letters3(s: ref String) -> bool {
    let v = chars(s);
    if v.len() != 3 {
        return false;
    }
    for c in v.iter() {
        if not ((*c >= 'a' and *c <= 'z') or (*c >= 'A' and *c <= 'Z')) {
            return false;
        }
    }
    true
}

// The fullmatch list of numbers, names and ranges of either, with `digits`
// digits to a number.
fn mixed_list(s: ref String, lo: i64, hi: i64) -> bool {
    for it in py_split(s, ',').iter() {
        let (a, b) = split_once(it, '-');
        let ok = match b {
            None => digits_len(a, lo, hi) or letters3(a),
            Some(bb) => (digits_len(a, lo, hi) and digits_len(bb, lo, hi)) or (letters3(a) and letters3(bb)),
        };
        if not ok {
            return false;
        }
    }
    true
}

fn check_range(prefix: ref String, mi: i64, mx: i64, e: ref String, kind: i64) -> Result[(), PyErr] {
    let n = py_int(e)?;
    if n < mi or mx < n {
        let msg = if kind == 0 {
            f"{prefix} values must be between {mi} and {mx} but '{e}' is provided"
        } else if kind == 1 {
            f"({prefix}) Accepted increment value range is {mi}~{mx} but '{e}' is provided"
        } else {
            f"({prefix}) Accepted week value is {mi}~{mx} but '{e}' is provided"
        };
        return Err(format_error(msg));
    }
    Ok(())
}

fn compare_range(prefix: ref String, st: ref String, ed: ref String, mi: i64, mx: i64, dow: bool) -> Result[(), PyErr] {
    let a = py_int(st)?;
    let b = py_int(ed)?;
    if a > b {
        if dow {
            let days = day_abbr();
            return Err(format_error(f"({prefix}) Invalid range '{days[a]}-{days[b]}'. Accepted range is {mi}-{mx}"));
        }
        return Err(format_error(f"({prefix}) Invalid range '{st}-{ed}'. Accepted range is {mi}-{mx}"));
    }
    Ok(())
}

fn illegal(prefix: ref String, e: ref String) -> PyErr {
    format_error(f"({prefix}) Illegal Expression Format '{e}'")
}

fn too_many(prefix: ref String, limit: i64, n: i64) -> PyErr {
    format_error(f"({prefix}) Exceeded maximum number({limit}) of specified value. '{n}' is provided")
}

fn check_pair(prefix: ref String, s: ref String, mi: i64, mx: i64) -> Result[(), PyErr] {
    let p = py_split(s, '-');
    check_range(prefix, mi, mx, p[0], 0)?;
    check_range(prefix, mi, mx, p[1], 0)?;
    compare_range(prefix, p[0], p[1], mi, mx, false)
}

fn check_range_step(prefix: ref String, s: ref String, mi: i64, mx: i64, imi: i64, imx: i64) -> Result[(), PyErr] {
    let p = py_split(s, '/');
    check_pair(prefix, p[0], mi, mx)?;
    check_range(prefix, imi, imx, p[1], 1)
}

fn second_minute_or_hour(e: ref String, prefix: ref String, mx: i64, limit: i64) -> Result[(), PyErr] {
    let mi = 0;
    if digits_len(e, 1, 2) {
        return check_range(prefix, mi, mx, e, 0);
    }
    if not has_any(e, "-*,/") {
        return Err(illegal(prefix, e));
    }
    if e == "*" {
        return Ok(());
    }
    if pair(e, '-', 1, 2, 1, 2) {
        return check_pair(prefix, e, mi, mx);
    }
    if pair(e, '/', 1, 2, 1, 2) {
        let p = py_split(e, '/');
        check_range(prefix, mi, mx, p[0], 0)?;
        return check_range(prefix, mi, mx, p[1], 1);
    }
    if range_step(e, 1, 2, 1, 2) {
        return check_range_step(prefix, e, mi, mx, mi, mx);
    }
    if star_step(e, 1, 2) {
        let p = py_split(e, '/');
        return check_range(prefix, mi, mx, p[1], 1);
    }
    if number_list(e, 1, 2, true) {
        let items = py_split(e, ',');
        if items.len() > limit {
            return Err(too_many(prefix, limit, items.len()));
        }
        for it in items.iter() {
            if has(it, '-') {
                check_pair(prefix, it, mi, mx)?;
            } else {
                check_range(prefix, mi, mx, it, 0)?;
            }
        }
        return Ok(());
    }
    Err(illegal(prefix, e))
}

fn day_of_month_check(e: ref String, prefix: ref String) -> Result[(), PyErr] {
    let (mi, mx) = (1, 31);
    let v = chars(e);
    if digits_len(e, 1, 2) {
        return check_range(prefix, mi, mx, e, 0);
    }
    if has_any(e, "-*,/?") {
        if e == "*" or e == "?" {
            return Ok(());
        }
        if pair(e, '-', 1, 2, 1, 2) {
            return check_pair(prefix, e, mi, mx);
        }
        if pair(e, '/', 1, 2, 1, 2) {
            let p = py_split(e, '/');
            check_range(prefix, mi, mx, p[0], 0)?;
            return check_range(prefix, 0, mx, p[1], 1);
        }
        if range_step(e, 1, 2, 1, 2) {
            return check_range_step(prefix, e, mi, mx, 0, mx);
        }
        if star_step(e, 1, 2) {
            let p = py_split(e, '/');
            return check_range(prefix, 0, mx, p[1], 1);
        }
        if number_list(e, 1, 2, false) {
            let items = py_split(e, ',');
            if items.len() > 31 {
                return Err(too_many(prefix, 31, items.len()));
            }
            for it in items.iter() {
                check_range(prefix, mi, mx, it, 0)?;
            }
            return Ok(());
        }
        if v.len() >= 3 and (v[0] == 'L' or v[0] == 'l') and v[1] == '-' and digits_len(slice(v, 2, v.len()), 1, 2) {
            return check_range(prefix, mi, mx, slice(v, 2, v.len()), 0);
        }
        return Err(format_error(f"Illegal Expression Format '{e}'"));
    }
    if (v.len() == 1 and (is_l(v[0]) or is_w(v[0]))) or (v.len() == 2 and ((is_l(v[0]) and is_w(v[1])) or (is_w(v[0]) and is_l(v[1])))) {
        return Ok(());
    }
    if v.len() >= 2 and is_w(v[v.len() - 1]) and digits_len(slice(v, 0, v.len() - 1), 1, 2) {
        return check_range(prefix, mi, mx, slice(v, 0, v.len() - 1), 0);
    }
    if v.len() >= 2 and is_w(v[0]) and digits_len(slice(v, 1, v.len()), 1, 2) {
        return check_range(prefix, mi, mx, slice(v, 1, v.len()), 0);
    }
    Err(illegal(prefix, e))
}

fn is_l(c: char) -> bool {
    c == 'L' or c == 'l'
}

fn is_w(c: char) -> bool {
    c == 'W' or c == 'w'
}

fn month_number(name: ref String) -> Option[i64] {
    let m = month_abbr();
    for i in 0..12 {
        if m[i] == name.as_str() {
            return Some(i + 1);
        }
    }
    None
}

fn day_number(name: ref String) -> Option[i64] {
    let d = day_abbr();
    for i in 0..7 {
        if d[i] == name.as_str() {
            return Some(i);
        }
    }
    None
}

fn key_error(k: ref String) -> PyErr {
    py_err("KeyError", py_repr(k))
}

fn month_check(e: ref String, prefix: ref String) -> Result[(), PyErr] {
    let (mi, mx) = (1, 12);
    if digits_len(e, 1, 2) {
        return check_range(prefix, mi, mx, e, 0);
    }
    if three_non_digits(e) {
        if month_number(e).is_none() {
            return Err(format_error(f"Invalid Month value '{e}'"));
        }
        return Ok(());
    }
    if not has_any(e, "-*,/") {
        return Err(illegal(prefix, e));
    }
    if e == "*" {
        return Ok(());
    }
    if pair(e, '-', 1, 2, 1, 2) {
        return check_pair(prefix, e, mi, mx);
    }
    if name_range(e) {
        let p = py_split(e, '-');
        match (month_number(p[0]), month_number(p[1])) {
            (Some(a), Some(b)) => return compare_range(prefix, f"{a}", f"{b}", mi, mx, false),
            _ => return Err(format_error(f"Invalid Month value '{e}'")),
        }
    }
    if pair(e, '/', 1, 2, 1, 2) {
        let p = py_split(e, '/');
        check_range(prefix, mi, mx, p[0], 0)?;
        return check_range(prefix, 0, mx, p[1], 1);
    }
    if range_step(e, 1, 2, 1, 2) {
        return check_range_step(prefix, e, mi, mx, 0, 12);
    }
    if star_step(e, 1, 2) {
        let p = py_split(e, '/');
        return check_range(prefix, 0, 12, p[1], 1);
    }
    if number_list(e, 1, 2, false) {
        let items = py_split(e, ',');
        if items.len() > 12 {
            return Err(too_many(prefix, 12, items.len()));
        }
        for it in items.iter() {
            check_range(prefix, mi, mx, it, 0)?;
        }
        return Ok(());
    }
    if mixed_list(e, 1, 2) {
        let items = py_split(e, ',');
        if items.len() > 12 {
            return Err(too_many(prefix, 12, items.len()));
        }
        for it in items.iter() {
            if has(it, '-') {
                let p = py_split(it, '-');
                if chars(p[0]).len() == 3 {
                    for k in 0..2 {
                        let u = p[k].to_uppercase();
                        match month_number(u) {
                            Some(n) => check_range(prefix, mi, mx, f"{n}", 0)?,
                            None => return Err(key_error(u)),
                        }
                    }
                } else {
                    check_pair(prefix, it, mi, mx)?;
                }
            } else if chars(it).len() == 3 {
                let u = it.to_uppercase();
                match month_number(u) {
                    Some(n) => check_range(prefix, mi, mx, f"{n}", 0)?,
                    None => return Err(key_error(u)),
                }
            } else {
                check_range(prefix, mi, mx, it, 0)?;
            }
        }
        return Ok(());
    }
    Err(illegal(prefix, e))
}

fn day_of_week_check(e: ref String, prefix: ref String) -> Result[(), PyErr] {
    let (mi, mx) = (0, 7);
    let v = chars(e);
    if e == "*" or e == "?" {
        return Ok(());
    }
    if digits_len(e, 1, 1) {
        return check_range(prefix, mi, mx, e, 0);
    }
    if three_non_digits(e) {
        if day_number(e.to_uppercase()).is_some() {
            return Ok(());
        }
        return Err(format_error(f"Invalid value '{e}'"));
    }
    if pair(e, '/', 1, 1, 1, 1) {
        let p = py_split(e, '/');
        check_range(prefix, mi, mx, p[0], 0)?;
        return check_range(prefix, 0, mx, p[1], 1);
    }
    if range_step(e, 1, 1, 1, 1) {
        return check_range_step(prefix, e, mi, mx, 0, mx);
    }
    if star_step(e, 1, 1) {
        let p = py_split(e, '/');
        return check_range(prefix, 0, mx, p[1], 1);
    }
    if pair(e, '-', 1, 1, 1, 1) {
        return check_pair(prefix, e, mi, mx);
    }
    if name_range(e) {
        let p = py_split(e, '-');
        match (day_number(p[0].to_uppercase()), day_number(p[1].to_uppercase())) {
            (Some(a), Some(b)) => return compare_range(prefix, f"{a}", f"{b}", mi, mx, true),
            _ => return Err(format_error(f"({prefix}) Invalid value '{e}'")),
        }
    }
    if mixed_list(e, 1, 1) {
        let items = py_split(e, ',');
        if items.len() > 7 {
            return Err(too_many(prefix, 7, items.len()));
        }
        for it in items.iter() {
            if has(it, '-') {
                let p = py_split(it, '-');
                if chars(p[0]).len() == 3 {
                    for k in 0..2 {
                        let u = p[k].to_uppercase();
                        match day_number(u) {
                            Some(n) => check_range(prefix, mi, mx, f"{n}", 0)?,
                            None => return Err(key_error(u)),
                        }
                    }
                } else {
                    check_pair(prefix, it, mi, mx)?;
                }
            } else if chars(it).len() == 3 {
                let u = it.to_uppercase();
                match day_number(u) {
                    Some(n) => check_range(prefix, mi, mx, f"{n + 1}", 0)?,
                    None => return Err(key_error(u)),
                }
            } else {
                check_range(prefix, mi, mx, it, 0)?;
            }
        }
        return Ok(());
    }
    if v.len() == 2 and is_d(v[0]) and (v[1] == 'l' or v[1] == 'L') {
        return check_range(prefix, mi, mx, slice(v, 0, 1), 0);
    }
    if v.len() == 3 and is_d(v[0]) and v[1] == '#' and is_d(v[2]) {
        check_range(prefix, mi, mx, slice(v, 0, 1), 0)?;
        return check_range(prefix, mi, 5, slice(v, 2, 3), 2);
    }
    if v.len() == 5 and no_digits(slice(v, 0, 3)) and v[3] == '#' and is_d(v[4]) {
        if day_number(slice(v, 0, 3).to_uppercase()).is_none() {
            return Err(format_error(f"({prefix}) Invalid value '{e}'"));
        }
        return check_range(prefix, mi, 5, slice(v, 4, 5), 2);
    }
    Err(illegal(prefix, e))
}

fn year_check(e: ref String, prefix: ref String) -> Result[(), PyErr] {
    let (mi, mx) = (1970, 2099);
    if digits_len(e, 4, 4) {
        return check_range(prefix, mi, mx, e, 0);
    }
    if not has_any(e, "-*,/") {
        return Err(illegal(prefix, e));
    }
    if e == "*" {
        return Ok(());
    }
    if pair(e, '-', 4, 4, 4, 4) {
        return check_pair(prefix, e, mi, mx);
    }
    if pair(e, '/', 4, 4, 1, 3) {
        let p = py_split(e, '/');
        check_range(prefix, mi, mx, p[0], 0)?;
        return check_range(prefix, 0, 129, p[1], 1);
    }
    if range_step(e, 4, 4, 1, 3) {
        return check_range_step(prefix, e, mi, mx, 0, 129);
    }
    if star_step(e, 1, 3) {
        let p = py_split(e, '/');
        return check_range(prefix, 0, 129, p[1], 1);
    }
    if pair(e, '/', 1, 1, 1, 3) {
        let p = py_split(e, '/');
        check_range(prefix, 0, 129, p[0], 0)?;
        return check_range(prefix, 0, 129, p[1], 1);
    }
    if number_list(e, 4, 4, true) {
        let items = py_split(e, ',');
        if items.len() > 84 {
            return Err(too_many(prefix, 84, items.len()));
        }
        for it in items.iter() {
            if has(it, '-') {
                check_pair(prefix, it, mi, mx)?;
            } else {
                check_range(prefix, mi, mx, it, 0)?;
            }
        }
        return Ok(());
    }
    Err(illegal(prefix, e))
}

// ExpressionValidator().validate(expression)
fn validate(e: ref String) -> Result[(), PyErr] {
    let mut p: Vec[String] = Vec.new();
    for _ in 0..7 {
        p.push(String.new());
    }
    let t = split_ws(e);
    let n = t.len();
    if n < 5 {
        return Err(format_error(f"Error: Expression only has {n} parts.  At least 5 part are required."));
    }
    if n == 5 {
        for i in 0..5 {
            p[i + 1] = t[i].clone();
        }
    } else if n == 6 {
        let shift = ends_with_4_digits(t[5]) or t[4] == "?" or t[2] == "?";
        for i in 0..6 {
            if shift {
                p[i + 1] = t[i].clone();
            } else {
                p[i] = t[i].clone();
            }
        }
    } else if n == 7 {
        p = t;
    } else {
        return Err(format_error(f"Error: Expression has too many parts ({n}).  Expression must not have more than 7 parts."));
    }
    let sm = "Second and Minute".to_string();
    let with_year = n == 7 or (n == 6 and ends_with_4_digits(p[6]));
    if n != 5 and not (n == 6 and with_year) and not p[0].is_empty() {
        second_minute_or_hour(p[0], sm, 59, 60)?;
    }
    second_minute_or_hour(p[1], sm, 59, 60)?;
    second_minute_or_hour(p[2], "Hour".to_string(), 23, 24)?;
    day_of_month_check(p[3], "DayOfMonth".to_string())?;
    month_check(p[4], "Month".to_string())?;
    day_of_week_check(p[5], "DayOfWeek".to_string())?;
    if (n == 6 and with_year) or (n == 7 and not p[6].is_empty()) {
        year_check(p[6], "Year".to_string())?;
    }
    Ok(())
}

// ------------------------------------------------------------ the jobs

// json.dumps(..., sort_keys=True, separators=(",", ":"))
fn j_dump(j: ref J) -> String {
    match j {
        J.S(s) => json_quote(s),
        J.B(b) => if *b { "true".to_string() } else { "false".to_string() },
        J.Null => "null".to_string(),
        J.A(items) => {
            let parts: Vec[String] = items.iter().map(|x| j_dump(x)).collect();
            let body = parts.join(",");
            f"[{body}]"
        }
        J.O(members) => {
            let mut keys: Vec[String] = members.iter().map(|m| m.0.clone()).collect();
            keys.sort();
            let mut out = "{".to_string();
            for i in 0..keys.len() {
                if i > 0 {
                    out.push(',');
                }
                out.push_str(json_quote(keys[i]).as_str());
                out.push(':');
                out.push_str(j_dump(j_get(j, keys[i].as_str())).as_str());
            }
            out.push('}');
            out
        }
    }
}

fn j_has(j: ref J, key: Str) -> bool {
    match j {
        J.O(members) => members.iter().any(|m| m.0 == key),
        _ => false,
    }
}

fn emit(out: mut ref String, line: ref String) {
    out.push_str(line.as_str());
    out.push('\n');
}

// The options a job asks for, with any warning Options() gives.
fn job_options(o: ref J, out: mut ref String) -> Options {
    if j_bool(j_get(o, "auto"), false) {
        let sys = if j_has(o, "system") { j_opt_str(j_get(o, "system")) } else { Some("en_US".to_string()) };
        let code = match sys {
            Some(c) => c,
            None => {
                emit(mut out, "  warning: No system locale set. Falling back to 'en_US'. Set LANG/LC_ALL or pass locale_code to override.".to_string());
                "en_US".to_string()
            }
        };
        return new_options(code, None);
    }
    let code = j_opt_str(j_get(o, "locale")).unwrap_or("en_US".to_string());
    let h24 = if j_has(o, "h24") { Some(j_bool(j_get(o, "h24"), false)) } else { None };
    let mut opts = new_options(code, h24);
    if let Some(c) = j_opt_str(j_get(o, "casing")) {
        opts.casing = casing_of(c);
    }
    opts.verbose = j_bool(j_get(o, "verbose"), false);
    opts.dow0 = j_bool(j_get(o, "dow0"), true);
    opts.location = j_opt_str(j_get(o, "location"));
    opts
}

// ExpressionDescriptor(expression, options, **kwargs)
fn apply_kwargs(opts: mut ref Options, kw: ref J) -> Result[(), PyErr] {
    if let J.O(members) = kw {
        for (k, v) in members.iter() {
            if k == "verbose" {
                opts.verbose = j_bool(v, false);
            } else if k == "casing_type" {
                opts.casing = casing_of(j_str(v));
            } else if k == "use_24hour_time_format" {
                opts.h24 = j_bool(v, false);
            } else if k == "locale_code" {
                opts.locale_code = j_str(v);
            } else if k == "day_of_week_start_index_zero" {
                opts.dow0 = j_bool(v, true);
            } else if k == "locale_location" {
                opts.location = j_opt_str(v);
            } else {
                return Err(py_err("cron_descriptor.Exception.WrongArgumentError", f"Unknown {k} configuration argument"));
            }
        }
    }
    Ok(())
}

fn job_desc(cache: mut ref Map[String, Catalog], e: ref String, o: ref J, out: mut ref String) {
    let ej = json_quote(e);
    let oj = j_dump(o);
    emit(mut out, f"desc {ej} {oj}");
    let mut opts = job_options(o, mut out);
    let part = j_opt_str(j_get(o, "part")).unwrap_or("FULL".to_string());
    let result = match apply_kwargs(mut opts, j_get(o, "kwargs")) {
        Err(err) => Err(err),
        Ok(()) => match descriptor(mut cache, e, opts) {
            Ok(d) => {
                let r = get_description(d, part);
                give_back(mut cache, d);
                r
            }
            Err(err) => Err(err),
        },
    };
    match result {
        Ok(s) => emit(mut out, f"  = {s}"),
        Err(err) => emit(mut out, f"  ! {exc_line(err)}"),
    }
}

fn job_validate(e: ref String, out: mut ref String) {
    let ej = json_quote(e);
    match validate(e) {
        Ok(()) => emit(mut out, f"valid {ej}: ok"),
        Err(err) => emit(mut out, f"valid {ej}: {exc_line(err)}"),
    }
}

// ------------------------------------------------------------ the command line

// cron_descriptor's argparse parser: -h, -c/--casing with three choices,
// three flags, and one positional.
struct Opt {
    s: String,
    // 0 help, 1 casing, 2 verbose, 3 one-indexed-week, 4 24-hour
    action: i64,
}

fn cli_options() -> Vec[Opt] {
    let names = vec!["-h", "--help", "-c", "--casing", "-v", "--verbose", "-W", "--one-indexed-week", "-H",
        "--use-24-hour-time-format"];
    let mut v: Vec[Opt] = Vec.new();
    for i in 0..names.len() {
        v.push(Opt { s: names[i].to_string(), action: i / 2 });
    }
    v
}

fn action_name(a: i64) -> String {
    let names = vec!["-h/--help", "-c/--casing", "-v/--verbose", "-W/--one-indexed-week", "-H/--use-24-hour-time-format"];
    names[a].to_string()
}

fn lookup_opt(opts: ref Vec[Opt], s: ref String) -> i64 {
    for o in opts.iter() {
        if o.s == s.as_str() {
            return o.action;
        }
    }
    -1
}

// (action or -1, option string, sep, explicit argument)
#[derive(Clone)]
struct OptTuple {
    action: i64,
    opt: String,
    sep: Option[String],
    explicit: Option[String],
}

fn tuple(a: i64, opt: ref String, sep: own Option[String], ex: own Option[String]) -> OptTuple {
    OptTuple { action: a, opt: opt.clone(), sep: sep, explicit: ex }
}

// str.partition('=')
fn partition_eq(s: ref String) -> (String, Option[String]) {
    split_once(s, '=')
}

fn negative_number(s: ref String) -> bool {
    let v = chars(s);
    if v.len() < 2 or v[0] != '-' {
        return false;
    }
    let rest = slice(v, 1, v.len());
    if all_digits(rest) {
        return true;
    }
    let (a, b) = split_once(rest, '.');
    match b {
        Some(bb) => (a.is_empty() or all_digits(a)) and all_digits(bb),
        None => false,
    }
}

fn option_tuples(opts: ref Vec[Opt], s: ref String) -> Vec[OptTuple] {
    let v = chars(s);
    let mut out: Vec[OptTuple] = Vec.new();
    let (prefix, ex) = partition_eq(s);
    let sep = if ex.is_some() { Some("=".to_string()) } else { None };
    if v[1] == '-' {
        for o in opts.iter() {
            if o.s.starts_with(prefix.as_str()) {
                out.push(tuple(o.action, o.s, sep.clone(), ex.clone()));
            }
        }
    } else {
        let short = slice(v, 0, 2);
        let short_ex = slice(v, 2, v.len());
        for o in opts.iter() {
            if o.s == short {
                out.push(tuple(o.action, o.s, Some(String.new()), Some(short_ex.clone())));
            } else if o.s.starts_with(prefix.as_str()) {
                out.push(tuple(o.action, o.s, sep.clone(), ex.clone()));
            }
        }
    }
    out
}

// _parse_optional: None for a positional
fn parse_optional(opts: ref Vec[Opt], s: ref String) -> Option[Vec[OptTuple]] {
    if s.is_empty() or not s.starts_with("-") {
        return None;
    }
    let a = lookup_opt(opts, s);
    if a >= 0 {
        return Some(vec![tuple(a, s, None, None)]);
    }
    if chars(s).len() == 1 {
        return None;
    }
    let (o, ex) = partition_eq(s);
    if let Some(x) = ex {
        let a2 = lookup_opt(opts, o);
        if a2 >= 0 {
            return Some(vec![tuple(a2, o, Some("=".to_string()), Some(x))]);
        }
    }
    let t = option_tuples(opts, s);
    if t.len() > 0 {
        return Some(t);
    }
    if negative_number(s) {
        return None;
    }
    if has(s, ' ') {
        return None;
    }
    Some(vec![tuple(-1, s, None, None)])
}

struct Cli {
    argv: Vec[String],
    pattern: Vec[char],
    found: Vec[Option[Vec[OptTuple]]],
    extras: Vec[String],
    expression: Option[String],
    casing: String,
    verbose: bool,
    week1: bool,
    h24: bool,
    help: bool,
}

// What stops the parse: an error message (exit 2) or -h.
enum Stop {
    Error(String),
    Help,
}

fn arg_error(a: i64, msg: ref String) -> Stop {
    let n = action_name(a);
    Stop.Error(f"argument {n}: {msg}")
}

fn take_action(c: mut ref Cli, a: i64, args: ref Vec[String]) -> Result[(), Stop] {
    if a == 0 {
        return Err(Stop.Help);
    }
    if a == 1 {
        let v = args[0].clone();
        if v != "Title" and v != "Sentence" and v != "LowerCase" {
            return Err(arg_error(1, f"invalid choice: {py_repr(v)} (choose from 'Title', 'Sentence', 'LowerCase')"));
        }
        c.casing = v;
    } else if a == 2 {
        c.verbose = true;
    } else if a == 3 {
        c.week1 = true;
    } else {
        c.h24 = true;
    }
    Ok(())
}

fn nargs(a: i64) -> i64 {
    if a == 1 { 1 } else { 0 }
}

fn consume_optional(c: mut ref Cli, start: i64) -> Result[i64, Stop] {
    let tuples = c.found[start].clone().unwrap_or(Vec.new());
    if tuples.len() > 1 {
        let names: Vec[String] = tuples.iter().map(|t| t.opt.clone()).collect();
        let arg = c.argv[start].clone();
        let m = names.join(", ");
        return Err(Stop.Error(f"ambiguous option: {arg} could match {m}"));
    }
    let first = tuples[0].clone();
    let mut action = first.action;
    let mut opt = first.opt.clone();
    let mut sep = first.sep.clone();
    let mut explicit = first.explicit.clone();
    let mut todo: Vec[(i64, Vec[String])] = Vec.new();
    let mut stop = start + 1;
    loop {
        if action < 0 {
            c.extras.push(c.argv[start].clone());
            return Ok(start + 1);
        }
        if let Some(ex) = explicit.clone() {
            let count = nargs(action);
            let ov = chars(opt);
            if count == 0 and ov[1] != '-' and not ex.is_empty() {
                let exv = chars(ex);
                let sep_set = match sep.clone() {
                    Some(s) => not s.is_empty(),
                    None => false,
                };
                if sep_set or exv[0] == '-' {
                    return Err(arg_error(action, f"ignored explicit argument {py_repr(ex)}"));
                }
                todo.push((action, Vec.new()));
                opt = f"-{exv[0]}";
                let a = lookup_opt(cli_options(), opt);
                if a >= 0 {
                    action = a;
                    let rest = slice(exv, 1, exv.len());
                    if rest.is_empty() {
                        sep = None;
                        explicit = None;
                    } else if starts(rest, "=") {
                        sep = Some("=".to_string());
                        let rv = chars(rest);
                        explicit = Some(slice(rv, 1, rv.len()));
                    } else {
                        sep = Some(String.new());
                        explicit = Some(rest);
                    }
                } else {
                    c.extras.push(f"-{ex}");
                    stop = start + 1;
                    break;
                }
            } else if count == 1 {
                stop = start + 1;
                todo.push((action, vec![ex]));
                break;
            } else {
                return Err(arg_error(action, f"ignored explicit argument {py_repr(ex)}"));
            }
        } else {
            let s = start + 1;
            let count = nargs(action);
            if count == 1 and not (s < c.pattern.len() and c.pattern[s] == 'A') {
                return Err(arg_error(action, "expected one argument".to_string()));
            }
            stop = s + count;
            let mut args: Vec[String] = Vec.new();
            for k in s..stop {
                args.push(c.argv[k].clone());
            }
            todo.push((action, args));
            break;
        }
    }
    for (a, args) in todo.iter() {
        take_action(mut c, *a, args)?;
    }
    Ok(stop)
}

// consume_positionals for the one positional, nargs=None: '-*A-*'
fn consume_positionals(c: mut ref Cli, start: i64) -> i64 {
    if c.expression.is_some() {
        return start;
    }
    let mut i = start;
    while i < c.pattern.len() and c.pattern[i] == '-' {
        i += 1;
    }
    if not (i < c.pattern.len() and c.pattern[i] == 'A') {
        return start;
    }
    i += 1;
    while i < c.pattern.len() and c.pattern[i] == '-' {
        i += 1;
    }
    let mut args: Vec[String] = Vec.new();
    let mut dash = false;
    for k in start..i {
        if c.pattern[k] == '-' {
            dash = true;
        }
        args.push(c.argv[k].clone());
    }
    if dash {
        let mut k = 0;
        while k < args.len() {
            if args[k] == "--" {
                args.remove(k);
                break;
            }
            k += 1;
        }
    }
    c.expression = Some(args[0].clone());
    i
}

fn parse_cli(argv: ref Vec[String]) -> Result[Cli, Stop] {
    let opts = cli_options();
    let mut c = Cli {
        argv: argv.clone(),
        pattern: Vec.new(),
        found: Vec.new(),
        extras: Vec.new(),
        expression: None,
        casing: "Sentence".to_string(),
        verbose: false,
        week1: false,
        h24: false,
        help: false,
    };
    let mut after = false;
    let mut max_opt = -1;
    for i in 0..argv.len() {
        if after {
            c.pattern.push('A');
            c.found.push(None);
        } else if argv[i] == "--" {
            c.pattern.push('-');
            c.found.push(None);
            after = true;
        } else {
            match parse_optional(opts, argv[i]) {
                None => {
                    c.pattern.push('A');
                    c.found.push(None);
                }
                Some(t) => {
                    c.pattern.push('O');
                    c.found.push(Some(t));
                    max_opt = i;
                }
            }
        }
    }
    let mut start = 0;
    while start <= max_opt {
        let mut next = start;
        while next <= max_opt and c.found[next].is_none() {
            next += 1;
        }
        if start != next {
            let end = consume_positionals(mut c, start);
            if end > start {
                start = end;
                continue;
            }
            start = end;
        }
        if c.found[start].is_none() {
            for k in start..next {
                c.extras.push(c.argv[k].clone());
            }
            start = next;
        }
        start = consume_optional(mut c, start)?;
    }
    let stop = consume_positionals(mut c, start);
    for k in stop..argv.len() {
        c.extras.push(argv[k].clone());
    }
    if c.expression.is_none() {
        return Err(Stop.Error("the following arguments are required: expression".to_string()));
    }
    if c.extras.len() > 0 {
        let x = c.extras.join(" ");
        return Err(Stop.Error(f"unrecognized arguments: {x}"));
    }
    Ok(c)
}

fn usage_lines() -> Vec[String] {
    vec!["usage: cron_descriptor [-h] [-c {Title,Sentence,LowerCase}] [-v] [-W] [-H]".to_string(),
        "                       expression".to_string()]
}

fn help_lines() -> Vec[String] {
    let mut v = usage_lines();
    for l in vec!["", "positional arguments:", "  expression", "", "options:",
        "  -h, --help            show this help message and exit", "  -c, --casing {Title,Sentence,LowerCase}",
        "  -v, --verbose", "  -W, --one-indexed-week", "  -H, --use-24-hour-time-format"] {
        v.push(l.to_string());
    }
    v
}

// json.dumps(list) with the default separators
fn json_list(v: ref Vec[String]) -> String {
    let parts: Vec[String] = v.iter().map(|s| json_quote(s)).collect();
    let body = parts.join(", ");
    f"[{body}]"
}

fn job_cli(cache: mut ref Map[String, Catalog], argv: ref Vec[String], sys: ref String, out: mut ref String) {
    let a = json_list(argv);
    emit(mut out, f"$ cron_descriptor {a} LANG={sys}");
    match parse_cli(argv) {
        Err(Stop.Help) => {
            for l in help_lines() {
                emit(mut out, l);
            }
            emit(mut out, "exit 0".to_string());
        }
        Err(Stop.Error(m)) => {
            for l in usage_lines() {
                emit(mut out, f"stderr: {l}");
            }
            emit(mut out, f"stderr: cron_descriptor: error: {m}");
            emit(mut out, "exit 2".to_string());
        }
        Ok(c) => {
            let mut o = new_options(sys, None);
            o.casing = casing_of(c.casing);
            o.verbose = c.verbose;
            o.dow0 = not c.week1;
            o.h24 = c.h24;
            let e = c.expression.clone().unwrap_or(String.new());
            let r = match descriptor(mut cache, e, o) {
                Ok(d) => {
                    let r = full_description(d);
                    give_back(mut cache, d);
                    r
                }
                Err(err) => Err(err),
            };
            match r {
                Ok(s) => {
                    emit(mut out, s);
                    emit(mut out, "exit 0".to_string());
                }
                Err(err) => {
                    emit(mut out, "stderr: Traceback (most recent call last):".to_string());
                    emit(mut out, f"stderr: {exc_line(err)}");
                    emit(mut out, "exit 1".to_string());
                }
            }
        }
    }
}

// ------------------------------------------------------------ crontabs

fn describe_or_error(cache: mut ref Map[String, Catalog], e: ref String, o: ref Options) -> String {
    let r = match descriptor(mut cache, e, o.clone()) {
        Ok(d) => {
            let r = full_description(d);
            give_back(mut cache, d);
            r
        }
        Err(err) => Err(err),
    };
    match r {
        Ok(s) => s,
        Err(err) => f"error: {exc_line(err)}",
    }
}

fn macro_of(m: ref String) -> Option[String] {
    let pairs = vec![("@yearly", "0 0 1 1 *"), ("@annually", "0 0 1 1 *"), ("@monthly", "0 0 1 * *"),
        ("@weekly", "0 0 * * 0"), ("@daily", "0 0 * * *"), ("@midnight", "0 0 * * *"), ("@hourly", "0 * * * *")];
    for (k, v) in pairs.iter() {
        if m == *k {
            return Some(v.to_string());
        }
    }
    None
}

fn job_crontab(cache: mut ref Map[String, Catalog], path: ref String, code: ref String, out: mut ref String) {
    emit(mut out, f"crontab {path} {code}");
    if not fs.exists(path.clone()) {
        emit(mut out, f"  cannot read {path}: No such file or directory");
        return;
    }
    let body = match fs.read_to_string(path.clone()) {
        Ok(b) => b,
        Err(e) => {
            emit(mut out, f"  cannot read {path}: {e}");
            return;
        }
    };
    let o = new_options(code, None);
    let mut n = 0;
    for raw in py_split(body, '\n').iter() {
        let line = py_strip(raw);
        if line.is_empty() or starts(line, "#") {
            continue;
        }
        if path.ends_with(".crontab") {
            let fields = split_ws(line);
            let first = fields[0].clone();
            if starts(first, "@") {
                let lv = chars(line);
                let cmd = py_strip(slice(lv, chars(first).len(), lv.len()));
                if first == "@reboot" {
                    emit(mut out, f"  {cmd} :: at startup");
                } else if let Some(m) = macro_of(first) {
                    let d = describe_or_error(mut cache, m, o);
                    emit(mut out, f"  {cmd} :: {d} ({first})");
                } else {
                    emit(mut out, f"  {cmd} :: unknown macro {first}");
                }
                n += 1;
                continue;
            }
            if has(first, '=') {
                emit(mut out, f"  env {first}");
                continue;
            }
            let mut sched: Vec[String] = Vec.new();
            let mut cmd: Vec[String] = Vec.new();
            for i in 0..fields.len() {
                if i < 5 {
                    sched.push(fields[i].clone());
                } else {
                    cmd.push(fields[i].clone());
                }
            }
            let d = describe_or_error(mut cache, sched.join(" "), o);
            let c = cmd.join(" ");
            emit(mut out, f"  {c} :: {d}");
        } else if path.ends_with(".txt") {
            let (name, rest) = split_once(line, '\t');
            let d = describe_or_error(mut cache, rest.unwrap_or(String.new()), o);
            emit(mut out, f"  {name} :: {d}");
        } else {
            let (key, rest) = split_once(line, '=');
            let d = describe_or_error(mut cache, py_strip(rest.unwrap_or(String.new())), o);
            let k = py_strip(key);
            emit(mut out, f"  {k} :: {d}");
        }
        n += 1;
    }
    emit(mut out, f"  {n} schedules");
}

fn run() -> Result[(), String] {
    let jobs = match fs.read_to_string("data/jobs.jsonl") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.jsonl: {e}"),
    };
    let mut cache: Map[String, Catalog] = Map.new();
    for line in py_split(jobs, '\n').iter() {
        if line.is_empty() {
            continue;
        }
        let j = json_line(line)?;
        let items = match j {
            J.A(items) => items,
            _ => return Err("a job is not an array".to_string()),
        };
        let kind = j_str(items[0]);
        let mut out = String.new();
        if kind == "desc" {
            job_desc(mut cache, j_str(items[1]), items[2], mut out);
        } else if kind == "validate" {
            job_validate(j_str(items[1]), mut out);
        } else if kind == "cli" {
            let sys = j_opt_str(items[2]).unwrap_or("None".to_string());
            job_cli(mut cache, j_strs(items[1]), sys, mut out);
        } else if kind == "crontab" {
            job_crontab(mut cache, j_str(items[1]), j_str(items[2]), mut out);
        }
        print(out);
    }
    Ok(())
}

// ------------------------------------------------------------ data/

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    data_part_7(mut v);
    data_part_8(mut v);
    data_part_9(mut v);
    data_part_10(mut v);
    data_part_11(mut v);
    data_part_12(mut v);
    data_part_13(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# schedule from each CronJob in the cluster\n");
    t.push_str("reports-weekly\t0 6 * * 1\n");
    t.push_str("cache-warm\t*/10 6-22 * * *\n");
    t.push_str("db-vacuum\t30 2 * * 6,0\n");
    t.push_str("token-rotate\t0 0 1 */2 *\n");
    t.push_str("quarterly-close\t0 18 L 3,6,9,12 *\n");
    t.push_str("bad-one\t0 25 * * *\n");
    v.push(DataFile { path: "crontabs/k8s-cronjobs.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("org.quartz.job.cleanup.cron = 0 0/30 8-18 ? * MON-FRI\n");
    t.push_str("org.quartz.job.digest.cron = 0 0 7 ? * 2#1\n");
    t.push_str("org.quartz.job.archive.cron = 0 15 10 L * ?\n");
