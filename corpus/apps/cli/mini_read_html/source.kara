// ============================================================ regular expressions (from mini_re)

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(c));
            } else {
                out.push(Node.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[r] + 1;
                    if not ((count >= max and max != maxrepeat()) or pos == self.lasts[r]) {
                        self.set_count(r, count);
                        self.set_last(r, pos);
                        pc = body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) == c } else { self.s[pos] == c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) != c } else { self.s[pos] != c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[set], self.s[pos], icase, ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(kind, ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(slot, pos);
                        if (slot & 1) == 1 {
                            self.set_lastindex(slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = a;
                    }
                    Op.Jmp(a) => pc = a,
                    Op.RepInit(r, until) => {
                        self.set_count(r, -1);
                        self.set_last(r, -1);
                        pc = until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[r] + 1;
                        if count < min {
                            self.set_count(r, count);
                            pc = body;
                        } else if greedy {
                            if (count < max or max == maxrepeat()) and pos != self.lasts[r] {
                                choices.push(Choice { pc: exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(r, count);
                                self.set_last(r, pos);
                                pc = body;
                            } else {
                                pc = exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if icase { lower(x, ascii) == lower(y, ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if width < 0 { pos } else { pos - width };
                        let found = from >= 0 and self.run(prog, sub, from, false) >= 0;
                        if negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = next;
                            }
                        } else if found {
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == l,
            Item.Range(lo, hi) => c >= lo and c <= hi,
            Item.Cat(k) => {
                let kind = k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}


// ------------------------------------------------------------ Python values

struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: Str) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg.to_string() }
}

fn nan() -> f64 {
    0.0 / 0.0
}

fn inf() -> f64 {
    1.0 / 0.0
}

fn is_nan(x: f64) -> bool {
    x != x
}

fn cps_of(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

// repr() of a str.
fn py_repr(s: Str) -> String {
    repr_of(cps_of(s))
}

// str.strip(): Python's white space off both ends.
fn py_strip(s: Str) -> String {
    let c = cps_of(s);
    let mut a: i64 = 0;
    let mut b = c.len();
    while a < b and is_space(c[a], false) {
        a += 1;
    }
    while b > a and is_space(c[b - 1], false) {
        b -= 1;
    }
    to_string(slice(c, a, b))
}

// repr() of a float.
fn float_repr(x: f64) -> String {
    if is_nan(x) {
        "nan".to_string()
    } else if x == inf() {
        "inf".to_string()
    } else if x == -inf() {
        "-inf".to_string()
    } else {
        x.to_string()
    }
}

// int(s) for a str: an optional sign and decimal digits, with
// surrounding white space and single underscores between digits.
fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(py_strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut v: i64 = 0;
    let mut last_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            if v > 922337203685477580 {
                return None;
            }
            v = v * 10 + (c - b'0') as i64;
            last_digit = true;
        } else if c == b'_' and last_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            last_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

// float(s) for a str: what Python's float() accepts, including inf,
// infinity and nan in any case.
fn py_float(s: Str) -> Option[f64] {
    let t = py_strip(s);
    let low = lower_ascii(t);
    let (sign, body) = if low.starts_with("-") {
        (-1.0, low[1..].to_string())
    } else if low.starts_with("+") {
        (1.0, low[1..].to_string())
    } else {
        (1.0, low.clone())
    };
    if body == "inf" or body == "infinity" {
        return Some(sign * inf());
    }
    if body == "nan" {
        return Some(nan());
    }
    let b = to_bytes(body);
    if b.len() == 0 {
        return None;
    }
    let mut i: i64 = 0;
    let mut digits = 0;
    while i < b.len() and is_digit(b[i]) {
        i += 1;
        digits += 1;
    }
    if i < b.len() and b[i] == b'.' {
        i += 1;
        while i < b.len() and is_digit(b[i]) {
            i += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return None;
    }
    if i < b.len() and b[i] == b'e' {
        i += 1;
        if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
            i += 1;
        }
        let st = i;
        while i < b.len() and is_digit(b[i]) {
            i += 1;
        }
        if i == st {
            return None;
        }
    }
    if i != b.len() {
        return None;
    }
    match f64.parse(t) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

// ------------------------------------------------------------ cells and labels

// A cell of a parsed table, and a value in an object column: text, a
// (text, href) tuple from extract_links, a bool, or NaN.
#[derive(Clone)]
enum Val {
    Na,
    S(String),
    P(String, Option[String]),
    B(bool),
}

// One element of a column or index label.
#[derive(Clone)]
enum Lab {
    Nil,
    I(i64),
    S(String),
    P(String, Option[String]),
}

fn pair_repr(t: Str, h: ref Option[String]) -> String {
    match h {
        Some(x) => f"({py_repr(t)}, {py_repr(x)})",
        None => f"({py_repr(t)}, None)",
    }
}

fn val_text(v: ref Val) -> String {
    match v {
        Val.Na => "".to_string(),
        Val.S(s) => s.clone(),
        Val.P(t, h) => pair_repr(t, h),
        Val.B(b) => if b { "True".to_string() } else { "False".to_string() },
    }
}

fn opt_eq(a: ref Option[String], b: ref Option[String]) -> bool {
    match (a, b) {
        (Some(x), Some(y)) => x == y,
        (None, None) => true,
        _ => false,
    }
}

fn lab_eq(a: ref Lab, b: ref Lab) -> bool {
    match (a, b) {
        (Lab.Nil, Lab.Nil) => true,
        (Lab.I(x), Lab.I(y)) => x == y,
        (Lab.S(x), Lab.S(y)) => x == y,
        (Lab.P(t, h), Lab.P(u, g)) => t == u and opt_eq(h, g),
        _ => false,
    }
}

fn key_eq(a: ref Vec[Lab], b: ref Vec[Lab]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if not lab_eq(a[i], b[i]) {
            return false;
        }
    }
    true
}

fn lab_repr(l: ref Lab) -> String {
    match l {
        Lab.Nil => "None".to_string(),
        Lab.I(n) => n.to_string(),
        Lab.S(s) => py_repr(s),
        Lab.P(t, h) => pair_repr(t, h),
    }
}

// str() of a label, as an f-string writes it.
fn lab_fstr(l: ref Lab) -> String {
    match l {
        Lab.Nil => "None".to_string(),
        Lab.I(n) => n.to_string(),
        Lab.S(s) => s.clone(),
        Lab.P(t, h) => pair_repr(t, h),
    }
}

// A label as the csv writer writes it: None is empty.
fn lab_csv(l: ref Lab) -> String {
    match l {
        Lab.Nil => "".to_string(),
        _ => lab_fstr(l),
    }
}

// A column label is a key: one label, or the tuple of a MultiIndex.
fn key_repr(k: ref Vec[Lab]) -> String {
    if k.len() == 1 {
        return lab_repr(k[0]);
    }
    let mut parts: Vec[String] = Vec.new();
    for l in k {
        parts.push(lab_repr(l));
    }
    f"({join(parts, ", ")})"
}

fn key_csv(k: ref Vec[Lab]) -> String {
    if k.len() == 1 {
        return lab_csv(k[0]);
    }
    key_repr(k)
}

fn key_fstr(k: ref Vec[Lab]) -> String {
    if k.len() == 1 {
        return lab_fstr(k[0]);
    }
    key_repr(k)
}

fn is_tuple(k: ref Vec[Lab]) -> bool {
    k.len() > 1 or match k[0] {
        Lab.P(_, _) => true,
        _ => false,
    }
}

fn lab_of(v: ref Val) -> Lab {
    match v {
        Val.Na => Lab.Nil,
        Val.S(s) => Lab.S(s.clone()),
        Val.P(t, h) => Lab.P(t.clone(), h.clone()),
        Val.B(b) => Lab.I(if b { 1 } else { 0 }),
    }
}

fn int_in(v: ref Vec[i64], x: i64) -> bool {
    for y in v {
        if y == x {
            return true;
        }
    }
    false
}

fn str_in(v: ref Vec[String], s: Str) -> bool {
    for x in v {
        if x == s {
            return true;
        }
    }
    false
}

fn sorted_ints(v: ref Vec[i64]) -> Vec[i64] {
    let mut out = v.clone();
    let n = out.len();
    for i in 0..n {
        for j in 0..n - 1 - i {
            if out[j] > out[j + 1] {
                let t = out[j];
                out[j] = out[j + 1];
                out[j + 1] = t;
            }
        }
    }
    out
}

// is_potential_multi_index: every label outside the index is a tuple.
fn potential_mi(cols: ref Vec[Vec[Lab]], index_col: ref Option[Vec[i64]]) -> bool {
    if cols.len() == 0 {
        return false;
    }
    let ic = match index_col {
        Some(ref v) => v.clone(),
        None => Vec.new(),
    };
    for k in cols {
        let in_index = k.len() == 1 and match k[0] {
            Lab.I(n) => int_in(ic, n),
            _ => false,
        };
        if not in_index and not is_tuple(k) {
            return false;
        }
    }
    true
}

fn key_count(seen: ref Vec[(Vec[Lab], i64)], k: ref Vec[Lab]) -> i64 {
    for (s, n) in seen {
        if key_eq(s, k) {
            return n;
        }
    }
    0
}

fn set_key_count(seen: mut ref Vec[(Vec[Lab], i64)], k: ref Vec[Lab], n: i64) {
    for i in 0..seen.len() {
        if key_eq(seen[i].0, k) {
            seen[i].1 = n;
            return;
        }
    }
    seen.push((k.clone(), n));
}

// The label dedup_names makes of a repeat: `x.1`, or the tuple with
// its last element so marked.
fn renamed(col: ref Vec[Lab], n: i64, mi: bool) -> Vec[Lab] {
    if mi and col.len() > 1 {
        let mut c = col.clone();
        let last = c.len() - 1;
        c[last] = Lab.S(f"{lab_fstr(col[last])}.{n}");
        return c;
    }
    vec![Lab.S(f"{key_fstr(col)}.{n}")]
}

// pandas.io.common.dedup_names.
fn dedup_names(names: ref Vec[Vec[Lab]], mi: bool) -> Vec[Vec[Lab]] {
    let mut out = names.clone();
    let mut counts: Vec[(Vec[Lab], i64)] = Vec.new();
    for i in 0..out.len() {
        let mut col = out[i].clone();
        let mut cur = key_count(counts, col);
        while cur > 0 {
            set_key_count(mut counts, col, cur + 1);
            col = renamed(col, cur, mi);
            cur = key_count(counts, col);
        }
        out[i] = col.clone();
        set_key_count(mut counts, col, cur + 1);
    }
    out
}

// ------------------------------------------------------------ missing values

fn str_na_values() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for c in ["", "#N/A", "#N/A N/A", "#NA", "-1.#IND", "-1.#QNAN", "-NaN", "-nan", "1.#IND", "1.#QNAN", "<NA>", "N/A", "NA", "NULL", "NaN", "None", "n/a", "nan", "null"] {
        v.push(c.to_string());
    }
    v
}

// The values a column reads as missing: strings, and the numbers equal
// to them.
struct NaSet {
    strs: Vec[String],
    nums: Vec[f64],
}

impl NaSet {
    fn has(ref self, v: ref Val) -> bool {
        match v {
            Val.S(s) => str_in(self.strs, s),
            _ => false,
        }
    }

    fn has_num(ref self, x: f64) -> bool {
        for n in self.nums {
            if n == x {
                return true;
            }
        }
        false
    }
}

// _clean_na_values with _stringify_na_values and _floatify_na_values.
fn na_set(na_values: ref Option[Vec[String]], keep_default_na: bool) -> NaSet {
    let mut strs: Vec[String] = Vec.new();
    let mut nums: Vec[f64] = Vec.new();
    match na_values {
        None => {
            if keep_default_na {
                strs = str_na_values();
            }
        }
        Some(vs) => {
            for x in vs {
                strs.push(x.clone());
                if let Some(v) = py_float(x) {
                    if not is_nan(v) and v != inf() and v != -inf() {
                        if v == v.floor() {
                            let iv = v as i64;
                            strs.push(f"{iv}.0");
                            strs.push(iv.to_string());
                        }
                        nums.push(v);
                    }
                }
            }
            if keep_default_na {
                for s in str_na_values() {
                    strs.push(s.clone());
                }
            }
            for s in strs {
                if let Some(v) = py_float(s) {
                    if not is_nan(v) {
                        nums.push(v);
                    }
                }
            }
        }
    }
    NaSet { strs: strs, nums: nums }
}

// ------------------------------------------------------------ columns

// A column as numpy and pandas hold it: numpy int64, float64 and bool,
// an object array (Val.Na is NaN), and the masked arrays of
// dtype_backend="numpy_nullable", where None is <NA>.
#[derive(Clone)]
enum Col {
    Int(Vec[i64]),
    Float(Vec[f64]),
    Bool(Vec[bool]),
    Obj(Vec[Val]),
    NInt(Vec[Option[i64]]),
    NFloat(Vec[Option[f64]]),
    NBool(Vec[Option[bool]]),
    NStr(Vec[Option[String]]),
}

// The dtype a DataFrame gives the column: an object array of strings
// and NaN becomes pandas 3's str.
fn dtype_name(c: ref Col) -> String {
    match c {
        Col.Int(_) => "int64".to_string(),
        Col.Float(_) => "float64".to_string(),
        Col.Bool(_) => "bool".to_string(),
        Col.Obj(v) => {
            if v.len() == 0 {
                return "object".to_string();
            }
            for x in v {
                match x {
                    Val.S(_) => {}
                    Val.Na => {}
                    _ => return "object".to_string(),
                }
            }
            "str".to_string()
        }
        Col.NInt(_) => "Int64".to_string(),
        Col.NFloat(_) => "Float64".to_string(),
        Col.NBool(_) => "boolean".to_string(),
        Col.NStr(_) => "string".to_string(),
    }
}

fn col_len(c: ref Col) -> i64 {
    match c {
        Col.Int(v) => v.len(),
        Col.Float(v) => v.len(),
        Col.Bool(v) => v.len(),
        Col.Obj(v) => v.len(),
        Col.NInt(v) => v.len(),
        Col.NFloat(v) => v.len(),
        Col.NBool(v) => v.len(),
        Col.NStr(v) => v.len(),
    }
}

fn bool_word(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// One value as to_csv writes it: missing values are empty.
fn cell_text(c: ref Col, i: i64) -> String {
    match c {
        Col.Int(v) => v[i].to_string(),
        Col.Float(v) => if is_nan(v[i]) { "".to_string() } else { float_repr(v[i]) },
        Col.Bool(v) => bool_word(v[i]),
        Col.Obj(v) => val_text(v[i]),
        Col.NInt(v) => match v[i] {
            Some(n) => n.to_string(),
            None => "".to_string(),
        },
        Col.NFloat(v) => match v[i] {
            Some(x) => float_repr(x),
            None => "".to_string(),
        },
        Col.NBool(v) => match v[i] {
            Some(b) => bool_word(b),
            None => "".to_string(),
        },
        Col.NStr(v) => match v[i] {
            Some(s) => s.clone(),
            None => "".to_string(),
        },
    }
}

// floatify: the number a string spells, and whether it could be an int.
fn floatify(s: Str) -> Option[(f64, bool)] {
    let t = py_strip(s);
    let low = lower_ascii(t);
    let body = if low.starts_with("-") or low.starts_with("+") { low[1..].to_string() } else { low.clone() };
    if body == "inf" or body == "infinity" or body == "nan" {
        return match py_float(t) {
            Some(x) => Some((x, false)),
            None => None,
        };
    }
    if has_byte(t, b'_') {
        return None;
    }
    match py_float(t) {
        Some(x) => Some((x, not (has_byte(t, b'.') or has_byte(t, b'e') or has_byte(t, b'E')))),
        None => None,
    }
}

// maybe_convert_numeric over strings; None where it raises. With
// `masked` a missing value goes in the mask instead of making the
// column float.
fn convert_numeric(vals: ref Vec[Val], na: ref NaSet, masked: bool) -> Option[Col] {
    let mut floats: Vec[f64] = Vec.new();
    let mut ints: Vec[i64] = Vec.new();
    let mut mask: Vec[bool] = Vec.new();
    let mut seen_float = false;
    let mut seen_int = false;
    for v in vals {
        let mut null = false;
        match v {
            Val.S(s) => {
                if na.has(v) {
                    null = true;
                } else {
                    if s.len() == 0 {
                        return None;
                    }
                    let (x, maybe) = floatify(s)?;
                    if na.has_num(x) {
                        null = true;
                    } else {
                        floats.push(x);
                        mask.push(false);
                        if maybe {
                            ints.push(py_int(s)?);
                            seen_int = true;
                        } else {
                            ints.push(0);
                            seen_float = true;
                        }
                    }
                }
            }
            Val.Na => null = true,
            _ => return None,
        }
        if null {
            floats.push(nan());
            ints.push(0);
            mask.push(true);
            if not masked {
                seen_float = true;
            }
        }
    }
    if masked {
        let mut all = true;
        for m in mask {
            if not m {
                all = false;
            }
        }
        if all or not seen_float {
            let mut out: Vec[Option[i64]] = Vec.new();
            for i in 0..ints.len() {
                out.push(if mask[i] { None } else { Some(ints[i]) });
            }
            return Some(Col.NInt(out));
        }
        let mut out: Vec[Option[f64]] = Vec.new();
        for i in 0..floats.len() {
            out.push(if mask[i] { None } else { Some(floats[i]) });
        }
        return Some(Col.NFloat(out));
    }
    if seen_float {
        Some(Col.Float(floats))
    } else {
        Some(Col.Int(ints))
    }
}

// sanitize_objects: the missing values become NaN.
fn sanitize(vals: own Vec[Val], na: ref NaSet) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    for v in vals.into_iter() {
        if na.has(v) {
            out.push(Val.Na);
        } else {
            out.push(v);
        }
    }
    out
}

// maybe_convert_bool; None where it hands the values back.
fn convert_bool(vals: ref Vec[Val], masked: bool) -> Option[Col] {
    let mut out: Vec[Option[bool]] = Vec.new();
    let mut has_na = false;
    for v in vals {
        match v {
            Val.B(b) => out.push(Some(b)),
            Val.S(s) => {
                if s == "True" or s == "TRUE" or s == "true" {
                    out.push(Some(true));
                } else if s == "False" or s == "FALSE" or s == "false" {
                    out.push(Some(false));
                } else {
                    return None;
                }
            }
            Val.Na => {
                out.push(None);
                has_na = true;
            }
            _ => return None,
        }
    }
    if masked {
        return Some(Col.NBool(out));
    }
    if has_na {
        let mut objs: Vec[Val] = Vec.new();
        for b in out {
            objs.push(match b {
                Some(x) => Val.B(x),
                None => Val.Na,
            });
        }
        return Some(Col.Obj(objs));
    }
    let mut bools: Vec[bool] = Vec.new();
    for b in out {
        bools.push(b.unwrap_or(false));
    }
    Some(Col.Bool(bools))
}

// _infer_types for an object column of cells.
fn infer_types(vals: own Vec[Val], na: ref NaSet, masked: bool) -> Col {
    if let Some(c) = convert_numeric(vals, na, masked) {
        return c;
    }
    let v = sanitize(vals, na);
    if let Some(c) = convert_bool(v, masked) {
        return c;
    }
    if masked {
        let mut out: Vec[Option[String]] = Vec.new();
        for x in v {
            out.push(match x {
                Val.Na => None,
                _ => Some(val_text(x)),
            });
        }
        return Col.NStr(out);
    }
    Col.Obj(v)
}

// ------------------------------------------------------------ the options

struct Opts {
    pattern: String,
    attrs: Vec[(String, String)],
    header: Option[Vec[i64]],
    index_col: Option[Vec[i64]],
    skip: Vec[i64],
    thousands: Option[String],
    decimal: String,
    na_values: Option[Vec[String]],
    keep_default_na: bool,
    displayed_only: bool,
    links: Option[String],
    encoding: Option[String],
    flavor: Option[String],
    backend: Option[String],
    head: Option[i64],
}

fn int_arg(v: Str) -> Result[i64, PyErr] {
    match py_int(v) {
        Some(n) => Ok(n),
        None => Err(py_err("ValueError", f"invalid literal for int() with base 10: {py_repr(v)}")),
    }
}

fn ints_arg(v: Str) -> Result[Vec[i64], PyErr] {
    let mut out: Vec[i64] = Vec.new();
    for x in split_on(v, b',') {
        out.push(int_arg(x)?);
    }
    Ok(out)
}

// The keyword arguments the oracle builds from a job's `k=v` words.
fn parse_opts(words: ref Vec[String]) -> Result[Opts, PyErr] {
    let mut o = Opts {
        pattern: ".+".to_string(),
        attrs: Vec.new(),
        header: None,
        index_col: None,
        skip: Vec.new(),
        thousands: Some(",".to_string()),
        decimal: ".".to_string(),
        na_values: None,
        keep_default_na: true,
        displayed_only: true,
        links: None,
        encoding: None,
        flavor: None,
        backend: None,
        head: None,
    };
    for w in words {
        let b = to_bytes(w);
        let mut eq: i64 = 0;
        while eq < b.len() and b[eq] != b'=' {
            eq += 1;
        }
        let k = byte_str(b, 0, eq);
        let v = replace_all(byte_str(b, eq + 1, b.len()), "\\s", " ");
        if k == "attrs" {
            for p in split_on(v, b',') {
                let pb = to_bytes(p);
                let mut c: i64 = 0;
                while c < pb.len() and pb[c] != b':' {
                    c += 1;
                }
                let name = byte_str(pb, 0, c);
                let value = byte_str(pb, c + 1, pb.len());
                let mut replaced = false;
                for i in 0..o.attrs.len() {
                    if o.attrs[i].0 == name {
                        o.attrs[i].1 = value.clone();
                        replaced = true;
                    }
                }
                if not replaced {
                    o.attrs.push((name, value));
                }
            }
        } else if k == "header" {
            o.header = if v == "None" { None } else { Some(ints_arg(v)?) };
        } else if k == "index_col" {
            o.index_col = if v == "None" { None } else { Some(ints_arg(v)?) };
        } else if k == "skiprows" {
            if has_byte(v, b':') {
                let p = split_on(v, b':');
                let (a, stop, step) = (int_arg(p[0])?, int_arg(p[1])?, int_arg(p[2])?);
                let mut i = a;
                while (step > 0 and i < stop) or (step < 0 and i > stop) {
                    o.skip.push(i);
                    i += step;
                }
            } else if has_byte(v, b',') {
                o.skip = ints_arg(v)?;
            } else {
                let n = int_arg(v)?;
                if n < 0 {
                    return Err(py_err("ValueError", "cannot skip rows starting from the end of the data (you passed a negative value)"));
                }
                for i in 0..n {
                    o.skip.push(i);
                }
            }
        } else if k == "thousands" {
            o.thousands = if v == "None" { None } else { Some(v.clone()) };
        } else if k == "decimal" {
            o.decimal = v.clone();
        } else if k == "na_values" {
            o.na_values = Some(split_on(v, b','));
        } else if k == "keep_default_na" {
            o.keep_default_na = v == "True";
        } else if k == "displayed_only" {
            o.displayed_only = v == "True";
        } else if k == "head" {
            o.head = Some(int_arg(v)?);
        } else if k == "match" {
            o.pattern = v.clone();
        } else if k == "extract_links" {
            o.links = Some(v.clone());
        } else if k == "encoding" {
            o.encoding = Some(v.clone());
        } else if k == "flavor" {
            o.flavor = Some(v.clone());
        } else if k == "dtype_backend" {
            o.backend = Some(v.clone());
        } else {
            return Err(py_err("TypeError", f"read_html() got an unexpected keyword argument '{k}'"));
        }
    }
    Ok(o)
}

fn links_in(o: ref Opts, section: Str) -> bool {
    match o.links {
        Some(l) => l == "all" or l == section,
        None => false,
    }
}

// ------------------------------------------------------------ walking the tree

fn is_elem(dom: ref Dom, id: i64, name: Str) -> bool {
    dom.nodes[id].kind == K_ELEM and dom.nodes[id].name == name
}

fn walk(dom: ref Dom, id: i64, out: mut ref Vec[i64]) {
    for k in dom.nodes[id].kids {
        out.push(k);
        walk(dom, k, mut out);
    }
}

// The descendants of a node in document order (XPath `.//node()`).
fn descendants(dom: ref Dom, id: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    walk(dom, id, mut out);
    out
}

fn named_descendants(dom: ref Dom, id: i64, name: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for d in descendants(dom, id) {
        if is_elem(dom, d, name) {
            out.push(d);
        }
    }
    out
}

fn child_elems(dom: ref Dom, id: i64, a: Str, b: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for k in dom.nodes[id].kids {
        if is_elem(dom, k, a) or is_elem(dom, k, b) {
            out.push(k);
        }
    }
    out
}

fn is_text_node(dom: ref Dom, id: i64) -> bool {
    dom.nodes[id].kind == K_TEXT or dom.nodes[id].kind == K_CDATA
}

// text_content(): the text of every text node below, in order.
fn text_content(dom: ref Dom, id: i64) -> String {
    let mut out = String.new();
    for d in descendants(dom, id) {
        if is_text_node(dom, d) {
            out.push_str(dom.nodes[d].text);
        }
    }
    out
}

fn kid_pos(dom: ref Dom, id: i64) -> i64 {
    let p = dom.nodes[id].parent;
    for i in 0..dom.nodes[p].kids.len() {
        if dom.nodes[p].kids[i] == id {
            return i;
        }
    }
    -1
}

// drop_tree(): the element leaves its parent; its tail stays.
fn drop_tree(dom: mut ref Dom, id: i64) {
    let p = dom.nodes[id].parent;
    if p < 0 {
        return;
    }
    let mut kids: Vec[i64] = Vec.new();
    for k in dom.nodes[p].kids {
        if k != id {
            kids.push(k);
        }
    }
    dom.nodes[p].kids = kids;
    dom.nodes[id].parent = -1;
}

// `br.tail = "\n" + (br.tail or "")` for every `*//br`.
fn break_lines(dom: mut ref Dom, root: i64) {
    let mut brs: Vec[i64] = Vec.new();
    for k in dom.nodes[root].kids {
        if dom.nodes[k].kind == K_ELEM {
            for b in named_descendants(dom, k, "br") {
                brs.push(b);
            }
        }
    }
    for b in brs {
        let p = dom.nodes[b].parent;
        let at = kid_pos(dom, b);
        let next = at + 1;
        if next < dom.nodes[p].kids.len() and is_text_node(dom, dom.nodes[p].kids[next]) {
            let t = dom.nodes[p].kids[next];
            dom.nodes[t].text = f"\n{dom.nodes[t].text}";
        } else {
            let id = dom.nodes.len();
            dom.nodes.push(new_node(K_TEXT, "", "\n", p));
            let mut kids: Vec[i64] = Vec.new();
            for i in 0..dom.nodes[p].kids.len() {
                kids.push(dom.nodes[p].kids[i]);
                if i == at {
                    kids.push(id);
                }
            }
            dom.nodes[p].kids = kids;
        }
    }
}

fn has_ancestor(dom: ref Dom, id: i64, name: Str, stop: i64) -> bool {
    let mut p = dom.nodes[id].parent;
    while p >= 0 and p != stop {
        if is_elem(dom, p, name) {
            return true;
        }
        p = dom.nodes[p].parent;
    }
    false
}

// `.//<section>//tr`: the rows below a tbody or tfoot of the table.
fn section_rows(dom: ref Dom, table: i64, section: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for tr in named_descendants(dom, table, "tr") {
        if has_ancestor(dom, tr, section, table) {
            out.push(tr);
        }
    }
    out
}

fn thead_rows(dom: ref Dom, table: i64) -> Vec[i64] {
    let mut rows: Vec[i64] = Vec.new();
    for th in named_descendants(dom, table, "thead") {
        for tr in child_elems(dom, th, "tr", "tr") {
            rows.push(tr);
        }
        if child_elems(dom, th, "td", "th").len() > 0 {
            rows.push(th);
        }
    }
    rows
}

fn tbody_rows(dom: ref Dom, table: i64) -> Vec[i64] {
    let mut rows = section_rows(dom, table, "tbody");
    for tr in child_elems(dom, table, "tr", "tr") {
        rows.push(tr);
    }
    rows
}

// `.//a/@href`, the first one.
fn href_of(dom: ref Dom, td: i64) -> Option[String] {
    for a in named_descendants(dom, td, "a") {
        if let Some(h) = dom.attr(a, "href") {
            return Some(h);
        }
    }
    None
}

// _remove_whitespace: strip(), then `[\r\n]+|\s{2,}` becomes one space.
fn remove_whitespace(s: Str) -> String {
    let c = cps_of(py_strip(s));
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < c.len() {
        if c[i] == 13 or c[i] == 10 {
            while i < c.len() and (c[i] == 13 or c[i] == 10) {
                i += 1;
            }
            out.push(32);
        } else if is_space(c[i], false) and i + 1 < c.len() and is_space(c[i + 1], false) {
            while i < c.len() and is_space(c[i], false) {
                i += 1;
            }
            out.push(32);
        } else {
            out.push(c[i]);
            i += 1;
        }
    }
    to_string(out)
}

fn span_of(dom: ref Dom, td: i64, name: Str) -> Result[i64, PyErr] {
    match dom.attr(td, name) {
        Some(v) => {
            if v.len() == 0 {
                Ok(1)
            } else {
                int_arg(v)
            }
        }
        None => Ok(1),
    }
}

// _expand_colspan_rowspan: rows of text, and the cells a rowspan still
// owes the rows after them.
fn expand_spans(dom: ref Dom, rows: ref Vec[i64], section: Str, rem0: own Vec[(i64, Val, i64)], overflow: bool, o: ref Opts) -> Result[(Vec[Vec[Val]], Vec[(i64, Val, i64)]), PyErr] {
    let mut all: Vec[Vec[Val]] = Vec.new();
    let mut remainder = rem0;
    for tr in rows {
        let mut texts: Vec[Val] = Vec.new();
        let mut next_rem: Vec[(i64, Val, i64)] = Vec.new();
        let mut index: i64 = 0;
        for td in child_elems(dom, tr, "td", "th") {
            while remainder.len() > 0 and remainder[0].0 <= index {
                let (pi, pt, ps) = remainder.remove(0);
                texts.push(pt.clone());
                if ps > 1 {
                    next_rem.push((pi, pt, ps - 1));
                }
                index += 1;
            }
            let t = remove_whitespace(text_content(dom, td));
            let text = if links_in(o, section) { Val.P(t, href_of(dom, td)) } else { Val.S(t) };
            let rowspan = span_of(dom, td, "rowspan")?;
            let colspan = span_of(dom, td, "colspan")?;
            for _ in 0..colspan {
                texts.push(text.clone());
                if rowspan > 1 {
                    next_rem.push((index, text.clone(), rowspan - 1));
                }
                index += 1;
            }
        }
        for (pi, pt, ps) in remainder {
            texts.push(pt.clone());
            if ps > 1 {
                next_rem.push((pi, pt.clone(), ps - 1));
            }
        }
        all.push(texts);
        remainder = next_rem;
    }
    if not overflow {
        while remainder.len() > 0 {
            let mut next_rem: Vec[(i64, Val, i64)] = Vec.new();
            let mut texts: Vec[Val] = Vec.new();
            for (pi, pt, ps) in remainder {
                texts.push(pt.clone());
                if ps > 1 {
                    next_rem.push((pi, pt.clone(), ps - 1));
                }
            }
            all.push(texts);
            remainder = next_rem;
        }
    }
    Ok((all, remainder))
}

fn all_th(dom: ref Dom, tr: i64) -> bool {
    for td in child_elems(dom, tr, "td", "th") {
        if not is_elem(dom, td, "th") {
            return false;
        }
    }
    true
}

// _parse_thead_tbody_tfoot.
fn table_rows(dom: ref Dom, table: i64, o: ref Opts) -> Result[(Vec[Vec[Val]], Vec[Vec[Val]], Vec[Vec[Val]]), PyErr] {
    let mut head = thead_rows(dom, table);
    let mut body = tbody_rows(dom, table);
    let foot = section_rows(dom, table, "tfoot");
    if head.len() == 0 {
        while body.len() > 0 and all_th(dom, body[0]) {
            head.push(body.remove(0));
        }
    }
    let (h, rem) = expand_spans(dom, head, "header", Vec.new(), true, o)?;
    let (b, rem2) = expand_spans(dom, body, "body", rem, foot.len() > 0, o)?;
    let (f, _) = expand_spans(dom, foot, "footer", rem2, false, o)?;
    Ok((h, b, f))
}

// ------------------------------------------------------------ TextParser

// The python engine's reader over a list of rows.
struct Tp {
    data: Vec[Vec[Val]],
    buf: Vec[Vec[Val]],
    pos: i64,
    line_pos: i64,
    skip: Vec[i64],
}

// _remove_empty_lines keeps a row of two cells or more, and one cell
// that is not a blank string.
fn keep_line(line: ref Vec[Val]) -> bool {
    if line.len() > 1 {
        return true;
    }
    if line.len() == 0 {
        return false;
    }
    match line[0] {
        Val.S(s) => py_strip(s).len() > 0,
        _ => true,
    }
}

impl Tp {
    fn skipped(ref self, i: i64) -> bool {
        int_in(self.skip, i)
    }

    // _next_line: skips the rows skiprows names, then the empty ones.
    fn next_line(mut ref self) -> Option[Vec[Val]] {
        while self.skipped(self.pos) {
            if self.pos >= self.data.len() {
                break;
            }
            self.pos += 1;
        }
        loop {
            if self.pos >= self.data.len() {
                return None;
            }
            let line = self.data[self.pos].clone();
            self.pos += 1;
            if keep_line(line) {
                self.line_pos += 1;
                self.buf.push(line.clone());
                return Some(line);
            }
        }
    }

    fn buffered_line(mut ref self) -> Option[Vec[Val]] {
        if self.buf.len() > 0 {
            return Some(self.buf[0].clone());
        }
        self.next_line()
    }

    // _get_lines: the buffer, then every row left that skiprows keeps.
    fn rest(mut ref self) -> Vec[Vec[Val]] {
        let mut lines = self.buf.clone();
        for i in self.pos..self.data.len() {
            if self.skip.len() == 0 or not self.skipped(i) {
                lines.push(self.data[i].clone());
            }
        }
        self.pos = self.data.len();
        self.buf.clear();
        let mut out: Vec[Vec[Val]] = Vec.new();
        for l in lines {
            if keep_line(l) {
                out.push(l.clone());
            }
        }
        out
    }
}

fn index_error() -> PyErr {
    py_err("IndexError", "list index out of range")
}

fn lab_in_unnamed(l: ref Lab, unnamed: ref Vec[String]) -> bool {
    match l {
        Lab.S(s) => str_in(unnamed, s),
        _ => false,
    }
}

// _clean_index_names: the names of the index columns, and the columns
// left.
fn clean_index_names(cols: ref Vec[Vec[Lab]], index_col: ref Option[Vec[i64]], unnamed: ref Vec[String]) -> Result[(Option[Vec[Vec[Lab]]], Vec[Vec[Lab]]), PyErr] {
    let ic = match index_col {
        Some(ref v) => v.clone(),
        None => return Ok((None, cols.clone())),
    };
    if cols.len() == 0 {
        let mut names: Vec[Vec[Lab]] = Vec.new();
        for _ in ic {
            names.push(vec![Lab.Nil]);
        }
        return Ok((Some(names), Vec.new()));
    }
    let mut columns = cols.clone();
    let mut names: Vec[Vec[Lab]] = Vec.new();
    for c0 in ic {
        let c = if c0 < 0 { c0 + cols.len() } else { c0 };
        if c < 0 or c >= cols.len() {
            return Err(index_error());
        }
        let name = cols[c].clone();
        let mut j: i64 = 0;
        while j < columns.len() and not key_eq(columns[j], name) {
            j += 1;
        }
        if j < columns.len() {
            let _ = columns.remove(j);
        }
        names.push(name);
    }
    for i in 0..names.len() {
        if names[i].len() == 1 and lab_in_unnamed(names[i][0], unnamed) {
            names[i] = vec![Lab.Nil];
        }
    }
    Ok((Some(names), columns))
}

// The frame read_html returns, as to_csv needs it.
struct Frame {
    cols: Vec[Vec[Lab]],
    mi: bool,
    col_names: Vec[Lab],
    data: Vec[Col],
    index: Vec[Col],
    index_names: Vec[Vec[Lab]],
    nrows: i64,
}

fn re_escape(s: Str) -> String {
    let mut out = String.new();
    for ch in s.chars() {
        if "()[]{}?*+-|^$\\.&~# \t\n\r".contains(ch.to_string()) {
            out.push('\\');
        }
        out.push(ch);
    }
    out
}

fn compile_str(p: Str) -> Program {
    match compile(cps_of(p), 0) {
        Ok(prog) => prog,
        Err(_) => compile(cps_of("$^"), 0).unwrap(),
    }
}

fn re_search(prog: ref Program, s: Str) -> bool {
    let cps = cps_of(s);
    let mut m = new_matcher(prog, cps);
    find(mut m, prog, 0, false, 0).is_some()
}

// _search_replace_num_columns: in a cell the number pattern matches,
// `search` becomes `replace`.
fn replace_num(lines: own Vec[Vec[Val]], num: ref Program, search: Str, replace: Str) -> Vec[Vec[Val]] {
    let mut out: Vec[Vec[Val]] = Vec.new();
    for line in lines.into_iter() {
        let mut rl: Vec[Val] = Vec.new();
        for x in line.into_iter() {
            let hit = match x {
                Val.S(ref s) => replace_all(s, search, "") != s and re_search(num, py_strip(s)),
                _ => false,
            };
            if hit {
                rl.push(Val.S(replace_all(val_text(x), search, replace)));
            } else {
                rl.push(x);
            }
        }
        out.push(rl);
    }
    out
}

fn empty_data() -> Option[Frame] {
    None
}

// TextParser(rows, header=..., ...).read() on the python engine; None
// where it raises EmptyDataError.
fn text_parser(rows: own Vec[Vec[Val]], header: ref Option[Vec[i64]], o: ref Opts) -> Result[Option[Frame], PyErr] {
    let masked = match o.backend {
        Some(b) => b == "numpy_nullable",
        None => false,
    };
    let index_col = o.index_col.clone();
    let mut tp = Tp { data: rows, buf: Vec.new(), pos: 0, line_pos: 0, skip: o.skip.clone() };
    let mut unnamed: Vec[String] = Vec.new();
    let mut columns: Vec[Vec[Lab]] = Vec.new();
    let mut num_orig: i64 = 0;
    let mut clear_buffer = true;
    let mut header_line: Option[Vec[Val]] = None;
    // _infer_columns
    match header {
        Some(h0) => {
            let have_mi = h0.len() > 1;
            let mut hs = h0.clone();
            if have_mi {
                hs.push(h0[h0.len() - 1] + 1);
            }
            let last = hs[hs.len() - 1];
            let mut level: i64 = 0;
            for hr in hs {
                let mut got = tp.buffered_line();
                let mut stopped = got.is_none();
                while not stopped and tp.line_pos <= hr {
                    got = tp.next_line();
                    stopped = got.is_none();
                }
                if stopped {
                    if 0 < tp.line_pos and tp.line_pos <= hr and (not have_mi or hr != last) {
                        let mut joi: Vec[String] = Vec.new();
                        let n = if have_mi { hs.len() - 1 } else { hs.len() };
                        for i in 0..n {
                            joi.push(hs[i].to_string());
                        }
                        return Err(py_err("ValueError", f"Passed header=[{join(joi, ",")}], len of {joi.len()}, but only {tp.line_pos} lines in file"));
                    }
                    if have_mi and hr > 0 {
                        if clear_buffer {
                            tp.buf.clear();
                        }
                        let mut nils: Vec[Lab] = Vec.new();
                        for _ in 0..columns[columns.len() - 1].len() {
                            nils.push(Lab.Nil);
                        }
                        columns.push(nils);
                        clear_buffer = false;
                        break;
                    }
                    return Ok(empty_data());
                }
                let line = got.unwrap();
                let mut this: Vec[Lab] = Vec.new();
                let mut this_unnamed: Vec[i64] = Vec.new();
                for i in 0..line.len() {
                    let blank = match line[i] {
                        Val.S(s) => s.len() == 0,
                        _ => false,
                    };
                    if blank {
                        this.push(Lab.S(if have_mi { f"Unnamed: {i}_level_{level}" } else { f"Unnamed: {i}" }));
                        this_unnamed.push(i);
                    } else {
                        this.push(lab_of(line[i]));
                    }
                }
                if not have_mi {
                    let mut order: Vec[i64] = Vec.new();
                    for i in 0..this.len() {
                        if not int_in(this_unnamed, i) {
                            order.push(i);
                        }
                    }
                    for i in this_unnamed {
                        order.push(i);
                    }
                    let mut counts: Vec[(Vec[Lab], i64)] = Vec.new();
                    for i in order {
                        let old = vec![this[i].clone()];
                        let mut col = old.clone();
                        let mut cur = key_count(counts, col);
                        while cur > 0 {
                            set_key_count(mut counts, old, cur + 1);
                            col = vec![Lab.S(f"{key_fstr(old)}.{cur}")];
                            let mut present = false;
                            for t in this {
                                if lab_eq(t, col[0]) {
                                    present = true;
                                }
                            }
                            if present {
                                cur += 1;
                            } else {
                                cur = key_count(counts, col);
                            }
                        }
                        this[i] = col[0].clone();
                        set_key_count(mut counts, col, cur + 1);
                    }
                } else if hr == last {
                    let lc = this.len();
                    let ic = match index_col {
                        Some(ref v) => v.len(),
                        None => 0,
                    };
                    let uc = this_unnamed.len();
                    if (lc != uc and lc - ic > uc) or ic == 0 {
                        clear_buffer = false;
                        let mut nils: Vec[Lab] = Vec.new();
                        for _ in 0..lc {
                            nils.push(Lab.Nil);
                        }
                        this = nils;
                        let keep = tp.buf[tp.buf.len() - 1].clone();
                        tp.buf = vec![keep];
                    }
                }
                for i in this_unnamed {
                    if let Lab.S(s) = this[i] {
                        unnamed.push(s.clone());
                    }
                }
                columns.push(this);
                if columns.len() == 1 {
                    num_orig = columns[0].len();
                }
                level += 1;
            }
            if clear_buffer {
                tp.buf.clear();
            }
        }
        None => {
            let line = match tp.buffered_line() {
                Some(l) => l,
                None => return Ok(empty_data()),
            };
            num_orig = line.len();
            let mut labs: Vec[Lab] = Vec.new();
            for i in 0..line.len() {
                labs.push(Lab.I(i));
            }
            columns.push(labs);
            header_line = Some(line);
        }
    }
    // _extract_multi_indexer_columns
    let mut names: Vec[Vec[Lab]] = Vec.new();
    let mut index_names: Option[Vec[Vec[Lab]]] = None;
    let mut col_names: Vec[Lab] = Vec.new();
    if columns.len() < 2 {
        for l in columns[0] {
            names.push(vec![l.clone()]);
        }
    } else {
        let ic = match index_col {
            Some(ref v) => v.clone(),
            None => Vec.new(),
        };
        let idx_row = columns.pop().unwrap();
        let mut idx_keys: Vec[Vec[Lab]] = Vec.new();
        for l in idx_row {
            idx_keys.push(vec![l.clone()]);
        }
        let (n0, _) = clean_index_names(idx_keys, index_col, unnamed)?;
        index_names = n0;
        let field_count = columns[0].len();
        for i in 0..field_count {
            if not int_in(ic, i) {
                let mut t: Vec[Lab] = Vec.new();
                for r in columns {
                    t.push(r[i].clone());
                }
                names.push(t);
            }
        }
        for c in sorted_ints(ic) {
            let at = if c > names.len() { names.len() } else { c };
            names.insert(at, vec![Lab.I(c)]);
        }
        for r in columns {
            if ic.len() > 0 {
                let l = r[ic[0]].clone();
                let keep = match l {
                    Lab.Nil => false,
                    _ => not lab_in_unnamed(l, unnamed),
                };
                col_names.push(if keep { l } else { Lab.Nil });
            } else {
                col_names.push(Lab.Nil);
            }
        }
    }
    let orig_names = names.clone();
    // _get_index_name
    let _line = match header_line {
        Some(l) => Some(l),
        None => tp.next_line(),
    };
    let _next = tp.next_line();
    let (n1, _) = clean_index_names(orig_names, index_col, unnamed)?;
    if index_names.is_none() {
        index_names = n1;
    }
    // read()
    let mut content = tp.rest();
    if let Some(t) = o.thousands {
        let num = compile_str(f"^[\\-\\+]?([0-9]+{re_escape(t)}|[0-9])*({re_escape(o.decimal)}[0-9]*)?([0-9]?(E|e)\\-?[0-9]+)?$");
        content = replace_num(content, num, t, "");
    }
    if o.decimal != "." {
        let num = match o.thousands {
            Some(t) => compile_str(f"^[\\-\\+]?([0-9]+{re_escape(t)}|[0-9])*({re_escape(o.decimal)}[0-9]*)?([0-9]?(E|e)\\-?[0-9]+)?$"),
            None => compile_str(f"^[\\-\\+]?[0-9]*({re_escape(o.decimal)}[0-9]*)?([0-9]?(E|e)\\-?[0-9]+)?$"),
        };
        content = replace_num(content, num, o.decimal, ".");
    }
    let na = na_set(o.na_values, o.keep_default_na);
    let dedup = dedup_names(orig_names, potential_mi(orig_names, index_col));
    if content.len() == 0 {
        // _get_empty_meta
        let mut cols = dedup.clone();
        let mut index: Vec[Col] = Vec.new();
        let mut inames: Vec[Vec[Lab]] = Vec.new();
        if let (Some(ic), Some(ns)) = (index_col.clone(), index_names.clone()) {
            for n in ns {
                index.push(Col.Obj(Vec.new()));
                inames.push(n.clone());
            }
            let s = sorted_ints(ic);
            for i in 0..s.len() {
                let at = s[i] - i;
                if at < 0 or at >= cols.len() {
                    return Err(index_error());
                }
                let _ = cols.remove(at);
            }
        }
        let mut data: Vec[Col] = Vec.new();
        for _ in cols {
            data.push(Col.Obj(Vec.new()));
        }
        let mi = potential_mi(cols, None);
        return Ok(Some(Frame { cols: cols, mi: mi, col_names: col_names, data: data, index: index, index_names: inames, nrows: 0 }));
    }
    // _rows_to_cols
    let mut width = num_orig;
    for r in content {
        if r.len() > width {
            width = r.len();
        }
    }
    let mut alldata: Vec[Vec[Val]] = Vec.new();
    for j in 0..width {
        let mut c: Vec[Val] = Vec.new();
        for r in content {
            c.push(if j < r.len() { r[j].clone() } else { Val.Na });
        }
        alldata.push(c);
    }
    let nrows = content.len();
    // _make_index
    let mut cols = dedup.clone();
    let mut index: Vec[Col] = Vec.new();
    let mut inames: Vec[Vec[Lab]] = Vec.new();
    if let Some(ic) = index_col.clone() {
        if ic.len() > 0 {
            for k in 0..ic.len() {
                let idx = ic[k];
                if idx < 0 or idx >= alldata.len() {
                    return Err(index_error());
                }
                index.push(infer_types(alldata[idx].clone(), na, masked));
                inames.push(match index_names {
                    Some(ref ns) => ns[k].clone(),
                    None => vec![Lab.Nil],
                });
            }
            let s = sorted_ints(ic);
            let mut k = s.len();
            while k > 0 {
                k -= 1;
                let _ = alldata.remove(s[k]);
                if s[k] < cols.len() {
                    let _ = cols.remove(s[k]);
                }
            }
        }
    }
    let mut data: Vec[Col] = Vec.new();
    for i in 0..cols.len() {
        if i < alldata.len() {
            data.push(infer_types(alldata[i].clone(), na, masked));
        }
    }
    let mi = potential_mi(cols, None);
    Ok(Some(Frame { cols: cols, mi: mi, col_names: col_names, data: data, index: index, index_names: inames, nrows: nrows }))
}

// _data_to_frame: header, body and footer rows into one frame.
fn data_to_frame(head: own Vec[Vec[Val]], body0: own Vec[Vec[Val]], foot: own Vec[Vec[Val]], o: ref Opts) -> Result[Option[Frame], PyErr] {
    let mut header = o.header.clone();
    let mut body: Vec[Vec[Val]] = Vec.new();
    if head.len() > 0 {
        if header.is_none() {
            if head.len() == 1 {
                header = Some(vec![0]);
            } else {
                let mut hs: Vec[i64] = Vec.new();
                for i in 0..head.len() {
                    let mut any = false;
                    for t in head[i] {
                        let truthy = match t {
                            Val.S(s) => s.len() > 0,
                            _ => true,
                        };
                        if truthy {
                            any = true;
                        }
                    }
                    if any {
                        hs.push(i);
                    }
                }
                header = Some(hs);
            }
        }
        for r in head.into_iter() {
            body.push(r);
        }
    }
    for r in body0.into_iter() {
        body.push(r);
    }
    for r in foot.into_iter() {
        body.push(r);
    }
    // _expand_elements
    let mut widest: i64 = 0;
    for r in body {
        if r.len() > widest {
            widest = r.len();
        }
    }
    for i in 0..body.len() {
        while body[i].len() < widest {
            body[i].push(Val.S("".to_string()));
        }
    }
    let mut f = match text_parser(body, header, o)? {
        Some(f) => f,
        None => return Ok(None),
    };
    // extract_links="all" or "header": a MultiIndex becomes an Index of
    // tuples.
    if f.mi and (links_in(o, "header") and o.links.is_some()) {
        let mut flat: Vec[Vec[Lab]] = Vec.new();
        for k in f.cols {
            if k.len() > 2 {
                flat.push(vec![k[0].clone(), k[1].clone()]);
            } else {
                flat.push(k.clone());
            }
        }
        f.cols = flat;
        f.mi = false;
    }
    Ok(Some(f))
}

// ------------------------------------------------------------ to_csv

fn csv_field(s: Str) -> String {
    if has_byte(s, b',') or has_byte(s, b'"') or has_byte(s, b'\n') or has_byte(s, b'\r') {
        f"\"{replace_all(s, "\"", "\"\"")}\""
    } else {
        s.to_string()
    }
}

fn csv_row(fields: ref Vec[String]) -> String {
    if fields.len() == 1 and fields[0].len() == 0 {
        return "\"\"\n".to_string();
    }
    let mut parts: Vec[String] = Vec.new();
    for f in fields {
        parts.push(csv_field(f));
    }
    f"{join(parts, ",")}\n"
}

fn is_falsy(k: ref Vec[Lab]) -> bool {
    if k.len() != 1 {
        return false;
    }
    match k[0] {
        Lab.Nil => true,
        Lab.I(n) => n == 0,
        Lab.S(s) => s.len() == 0,
        _ => false,
    }
}

// shape, dtypes and df.head(n).to_csv(lineterminator="\n").
fn frame_text(f: ref Frame, head: ref Option[i64]) -> String {
    let mut out = f"shape ({f.nrows}, {f.cols.len()})\n";
    for i in 0..f.cols.len() {
        out.push_str(f"  {key_repr(f.cols[i])}: {dtype_name(f.data[i])}\n");
    }
    let mut labels: Vec[String] = Vec.new();
    if f.index.len() == 0 {
        labels.push("".to_string());
    } else if f.index.len() == 1 {
        labels.push(key_csv(f.index_names[0]));
    } else {
        for n in f.index_names {
            labels.push(if is_falsy(n) { "".to_string() } else { key_csv(n) });
        }
    }
    if not f.mi {
        let mut row = labels.clone();
        for k in f.cols {
            row.push(key_csv(k));
        }
        out.push_str(csv_row(row));
    } else {
        let levels = if f.cols.len() > 0 { f.cols[0].len() } else { f.col_names.len() };
        for lv in 0..levels {
            let mut row: Vec[String] = Vec.new();
            row.push(if lv < f.col_names.len() { lab_csv(f.col_names[lv]) } else { "".to_string() });
            for _ in 1..labels.len() {
                row.push("".to_string());
            }
            for k in f.cols {
                row.push(lab_csv(k[lv]));
            }
            out.push_str(csv_row(row));
        }
        let mut any = false;
        for l in labels {
            if l.len() > 0 {
                any = true;
            }
        }
        if any {
            let mut row = labels.clone();
            for _ in f.cols {
                row.push("".to_string());
            }
            out.push_str(csv_row(row));
        }
    }
    let n = match head {
        Some(h) => if h < f.nrows { h } else { f.nrows },
        None => f.nrows,
    };
    for r in 0..n {
        let mut row: Vec[String] = Vec.new();
        if f.index.len() == 0 {
            row.push(r.to_string());
        } else {
            for c in f.index {
                row.push(cell_text(c, r));
            }
        }
        for c in f.data {
            row.push(cell_text(c, r));
        }
        out.push_str(csv_row(row));
    }
    out
}

// ------------------------------------------------------------ read_html

fn match_attrs(dom: ref Dom, t: i64, attrs: ref Vec[(String, String)]) -> bool {
    for (k, v) in attrs {
        match dom.attr(t, k) {
            Some(x) => {
                if x != v {
                    return false;
                }
            }
            None => return false,
        }
    }
    true
}

fn hidden(dom: ref Dom, id: i64) -> bool {
    match dom.attr(id, "style") {
        Some(s) => has_text(replace_all(s, " ", ""), "display:none"),
        None => false,
    }
}

fn has_text(s: Str, pat: Str) -> bool {
    replace_all(s, pat, "") != s
}

// pd.read_html(path, flavor="lxml", ...): the frames, as the oracle
// prints them.
fn read_html(path: Str, o: ref Opts) -> Result[String, PyErr] {
    if let Some(l) = o.links {
        if not (l == "header" or l == "footer" or l == "body" or l == "all") {
            return Err(py_err("ValueError", f"`extract_links` must be one of {{None, \"header\", \"footer\", \"body\", \"all\"}}, got \"{l}\""));
        }
    }
    if let Some(b) = o.backend {
        if not (b == "numpy_nullable" or b == "pyarrow") {
            return Err(py_err("ValueError", f"dtype_backend {b} is invalid, only 'numpy_nullable' and 'pyarrow' are allowed."));
        }
    }
    if let Some(fl) = o.flavor {
        if fl != "lxml" {
            return Err(py_err("ValueError", f"{py_repr(fl)} is not a valid flavor"));
        }
    }
    // re.compile(match)
    if let Err(e) = compile(cps_of(o.pattern), 0) {
        let kind = if e.kind == "error" { "PatternError".to_string() } else { e.kind.clone() };
        let msg = if e.kind == "error" and e.pos >= 0 { f"{e.msg} at position {e.pos}" } else { e.msg.clone() };
        return Err(py_err(kind, msg));
    }
    // HTMLParser(recover=True, encoding=...)
    let mut forced: i64 = 0;
    if let Some(enc) = o.encoding {
        forced = codec_of(enc);
        if forced == 0 {
            return Err(py_err("LookupError", f"unknown encoding: 'b'{enc}''"));
        }
    }
    let bytes = match fs.read_bytes(path.to_string()) {
        Ok(b) => b,
        Err(_) => return Err(py_err("FileNotFoundError", f"[Errno 2] No such file or directory: {path}")),
    };
    let mut dom = parse_html(bytes, forced);
    let root = match dom.root() {
        Some(r) => r,
        None => return Err(py_err("XMLSyntaxError", "no text parsed from document (line 0)")),
    };
    break_lines(mut dom, root);
    // //table[.//text()[re:test(., pattern)]][@k='v' and ...]; the
    // pattern goes into the XPath through repr, so its backslashes double.
    let prog = compile_str(replace_all(o.pattern, "\\", "\\\\"));
    let mut tables: Vec[i64] = Vec.new();
    for t in named_descendants(dom, 0, "table") {
        let mut hit = false;
        for d in descendants(dom, t) {
            if not hit and is_text_node(dom, d) and re_search(prog, dom.nodes[d].text) {
                hit = true;
            }
        }
        if hit and match_attrs(dom, t, o.attrs) {
            if not (o.displayed_only and hidden(dom, t)) {
                tables.push(t);
            }
        }
    }
    if o.displayed_only {
        for t in tables {
            for s in named_descendants(dom, t, "style") {
                drop_tree(mut dom, s);
            }
            let mut styled: Vec[i64] = Vec.new();
            for d in descendants(dom, t) {
                if dom.nodes[d].kind == K_ELEM and dom.attr(d, "style").is_some() {
                    styled.push(d);
                }
            }
            for d in styled {
                if hidden(dom, d) {
                    drop_tree(mut dom, d);
                }
            }
        }
    }
    if tables.len() == 0 {
        return Err(py_err("ValueError", f"No tables found matching regex {py_repr(o.pattern)}"));
    }
    let mut frames: Vec[Frame] = Vec.new();
    for t in tables {
        let (h, b, f) = table_rows(dom, t, o)?;
        if let Some(fr) = data_to_frame(h, b, f, o)? {
            frames.push(fr);
        }
    }
    let mut out = f"tables {frames.len()}\n";
    for k in 0..frames.len() {
        out.push_str(f"table {k}\n");
        out.push_str(frame_text(frames[k], o.head));
    }
    Ok(out)
}

fn run_job(line: Str) -> Result[String, PyErr] {
    let w = split_on(line, b' ');
    if w.len() < 2 or w[0] != "read" {
        return Err(py_err("ValueError", f"unknown job {py_repr(line)}"));
    }
    let mut rest: Vec[String] = Vec.new();
    for i in 2..w.len() {
        rest.push(w[i].clone());
    }
    let o = parse_opts(rest)?;
    read_html(f"data/{w[1]}", o)
}

// The transcript of one job.
fn transcript(line: Str) -> String {
    let mut t = f"$ {line}\n";
    match run_job(line) {
        Ok(text) => t.push_str(text),
        Err(e) => t.push_str(f"! {e.kind}: {e.msg}\n"),
    }
    t
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in lines_of(jobs) {
        if l.len() > 0 {
            lines.push(l.clone());
        }
    }
    // Every job in a task of its own; the transcript prints in job order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for line in lines {
        handles.push(group.spawn(|| transcript(line)));
    }
    for h in handles.into_iter() {
        print(h.join());
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/cities.html", unhex(file_0()))?;
    put_bytes("data/empty.html", unhex(file_1()))?;
    put_bytes("data/fragment.html", unhex(file_2()))?;
    put_bytes("data/jobs.txt", unhex(file_3()))?;
    put_bytes("data/latin1.html", unhex(file_4()))?;
    put_bytes("data/legacy.html", unhex(file_5()))?;
    put_bytes("data/no_tables.html", unhex(file_6()))?;
    put_bytes("data/prices.html", unhex(file_7()))?;
    put_bytes("data/release.html", unhex(file_8()))?;
    put_bytes("data/standings.html", unhex(file_9()))?;
    put_bytes("data/statement.html", unhex(file_10()))?;
    Ok(())
}

