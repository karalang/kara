// mini_read_html: a Kāra port of pandas 3.0.5's read_html with its lxml
// flavor (pandas: BSD-3-Clause, the pandas development team). Under
// lxml 6.1 sits libxml2 2.14's HTML parser (MIT, Daniel Veillard and the
// libxml2 contributors), and this program ports that too: the HTML5
// tokenizer, the HTML 4 tree construction it still uses (implied html,
// head and body, the start tags that close open elements, end-tag
// priorities, the elements with no end tag), character and entity
// references with the HTML5 entity table, raw text in script and style,
// and the encodings: a byte-order mark, a meta charset or http-equiv,
// windows-1252 and ISO-8859-1, and libxml2's switch to ISO-8859-1 on the
// first byte that is not ASCII when nothing declared an encoding. On the
// tree it runs read_html: the tables whose text matches a regular
// expression (Python's re, ported in mini_re) and whose attributes match,
// display:none, the header, body and footer rows with colspan and
// rowspan, extract_links, and then pandas' TextParser on the python
// engine: header rows (one, several, or none), index_col, skiprows,
// thousands, decimal, na_values, keep_default_na and dtype_backend, with
// pandas' type inference for each column, and to_csv.
//
// It reads data/jobs.txt, one job per line, runs each in a task of its
// own, and prints, in job order, `$ <job>` and what the oracle prints: the
// number of tables, and for each its shape, its dtypes and to_csv. An
// error prints as `! <exception>: <message>`.

import std.sync.{TaskGroup};

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn bytes_of(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    v
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_letter(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_letter(c)
}

fn is_hex_digit(c: u8) -> bool {
    is_digit(c) or ((c | 32) >= b'a' and (c | 32) <= b'f')
}

// IS_WS_HTML: space, tab, line feed, form feed and carriage return.
fn is_ws_html(c: u8) -> bool {
    c == 32 or (c >= 9 and c <= 13 and c != 11)
}

fn lower_ascii(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for c in b {
        out.push(if c >= b'A' and c <= b'Z' { c + 32 } else { c });
    }
    from_bytes(out)
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn split_spaces(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and (b[i] == b' ' or b[i] == b'\n') {
            i += 1;
        }
        let st = i;
        while i < b.len() and b[i] != b' ' and b[i] != b'\n' {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn has_byte(s: Str, c: u8) -> bool {
    for x in s.bytes() {
        if x == c {
            return true;
        }
    }
    false
}

fn replace_all(s: Str, from: Str, to: Str) -> String {
    let b = to_bytes(s);
    let f = to_bytes(from);
    let mut out = String.new();
    let mut i: i64 = 0;
    let mut st: i64 = 0;
    while i + f.len() <= b.len() {
        let mut hit = f.len() > 0;
        for k in 0..f.len() {
            if hit and b[i + k] != f[k] {
                hit = false;
            }
        }
        if hit {
            out.push_str(byte_str(b, st, i));
            out.push_str(to);
            i += f.len();
            st = i;
        } else {
            i += 1;
        }
    }
    out.push_str(byte_str(b, st, b.len()));
    out
}

// The position of `pat` in `b` at or after `from`, ignoring ASCII case;
// -1 when it is not there (xmlStrcasestr).
fn find_ci(b: ref Vec[u8], from: i64, pat: Str) -> i64 {
    let p = to_bytes(pat);
    let mut i = from;
    while i + p.len() <= b.len() {
        let mut hit = true;
        for k in 0..p.len() {
            if hit and (b[i + k] | 32) != (p[k] | 32) {
                hit = false;
            }
        }
        if hit {
            return i;
        }
        i += 1;
    }
    -1
}

fn eq_ci(a: Str, b: Str) -> bool {
    lower_ascii(a) == lower_ascii(b)
}

// ------------------------------------------------------------ the tree

const K_DOC: i64 = 0;
const K_ELEM: i64 = 1;
const K_TEXT: i64 = 2;
const K_CDATA: i64 = 3;
const K_COMMENT: i64 = 4;

// One node of the tree libxml2's SAX2 handler builds: the document, an
// element, text, a CDATA block (what script and style hold) or a comment.
#[derive(Clone)]
struct HNode {
    kind: i64,
    name: String,
    text: String,
    attrs: Vec[(String, String)],
    kids: Vec[i64],
    parent: i64,
}

#[derive(Clone)]
struct Dom {
    nodes: Vec[HNode],
}

fn new_node(kind: i64, name: Str, text: Str, parent: i64) -> HNode {
    HNode { kind: kind, name: name.to_string(), text: text.to_string(), attrs: Vec.new(), kids: Vec.new(), parent: parent }
}

impl Dom {
    fn add(mut ref self, parent: i64, n: own HNode) -> i64 {
        let id = self.nodes.len();
        self.nodes.push(n);
        self.nodes[parent].kids.push(id);
        id
    }

    // xmlSAX2Text: text joins the last child when that is text of the
    // same kind.
    fn add_text(mut ref self, parent: i64, kind: i64, s: Str) {
        let k = self.nodes[parent].kids.len();
        if k > 0 {
            let last = self.nodes[parent].kids[k - 1];
            if self.nodes[last].kind == kind {
                self.nodes[last].text.push_str(s);
                return;
            }
        }
        let _ = self.add(parent, new_node(kind, "", s, parent));
    }

    fn attr(ref self, id: i64, name: Str) -> Option[String] {
        for (k, v) in self.nodes[id].attrs {
            if k == name {
                return Some(v.clone());
            }
        }
        None
    }

    // The root element: the document's first element child.
    fn root(ref self) -> Option[i64] {
        for k in self.nodes[0].kids {
            if self.nodes[k].kind == K_ELEM {
                return Some(k);
            }
        }
        None
    }
}

// ------------------------------------------------------------ the HTML tables

const DATA_RCDATA: i64 = 1;
const DATA_RAWTEXT: i64 = 2;
const DATA_PLAINTEXT: i64 = 3;
const DATA_SCRIPT: i64 = 4;
const DATA_SCRIPT_ESC1: i64 = 5;
const DATA_SCRIPT_ESC2: i64 = 6;

const INSERT_IN_HEAD: i64 = 3;
const INSERT_IN_BODY: i64 = 10;

// html40ElementTable: for each element, its end-tag rule, whether it is
// empty and its data mode (0 for markup, then DATA_*).
fn element_table() -> Map[String, i64] {
    let t = "a:000 abbr:000 acronym:000 address:000 applet:000 area:210 b:300 base:210 basefont:210 bdo:000 big:300 blockquote:000 body:100 br:210 button:000 caption:000 center:300 cite:000 code:000 col:210 colgroup:100 dd:100 del:000 dfn:000 dir:000 div:000 dl:000 dt:100 em:300 embed:100 fieldset:000 font:300 form:000 frame:210 frameset:000 h1:000 h2:000 h3:000 h4:000 h5:000 h6:000 head:100 hr:210 html:100 i:300 iframe:002 img:210 input:210 ins:000 isindex:210 kbd:000 label:000 legend:000 li:100 link:210 map:000 menu:000 meta:210 noembed:002 noframes:002 noscript:000 object:000 ol:000 optgroup:000 option:100 p:100 param:210 plaintext:003 pre:000 q:000 s:300 samp:000 script:004 select:000 small:300 span:000 strike:300 strong:300 style:002 sub:300 sup:300 table:000 tbody:000 td:000 textarea:001 tfoot:100 th:100 thead:100 title:001 tr:000 tt:300 u:300 ul:000 var:000 xmp:002";
    let mut m: Map[String, i64] = Map.new();
    for item in split_spaces(t) {
        let parts = split_on(item, b':');
        let f = to_bytes(parts[1]);
        let empty = if f[1] == b'1' { 10 } else { 0 };
        m.insert(parts[0].clone(), empty + (f[2] - b'0') as i64);
    }
    m
}

// htmlStartClose: the open elements (left of the colon) a start tag
// (right of it) closes.
fn start_close_table() -> Set[String] {
    let t = "a:a,fieldset,table,td,th address:dd,dl,dt,form,li,ul b:center,p,td,th big:p caption:col,colgroup,tbody,tfoot,thead,tr col:col,colgroup,tbody,tfoot,thead,tr colgroup:colgroup,tbody,tfoot,thead,tr dd:dt dir:dd,dl,dt,form,ul dl:form,li dt:dd,dl font:center,td,th form:form h1:fieldset,form,li,p,table h2:fieldset,form,li,p,table h3:fieldset,form,li,p,table h4:fieldset,form,li,p,table h5:fieldset,form,li,p,table h6:fieldset,form,li,p,table head:a,abbr,acronym,address,b,bdo,big,blockquote,body,br,center,cite,code,dd,dfn,dir,div,dl,dt,em,fieldset,font,form,frameset,h1,h2,h3,h4,h5,h6,hr,i,iframe,img,kbd,li,listing,map,menu,ol,p,pre,q,s,samp,small,span,strike,strong,sub,sup,table,tt,u,ul,var,xmp hr:form i:center,p,td,th legend:fieldset li:li link:body,frameset listing:dd,dl,dt,fieldset,form,li,table,ul menu:dd,dl,dt,form,ul ol:form option:optgroup,option p:address,blockquote,body,caption,center,col,colgroup,dd,dir,div,dl,dt,fieldset,form,frameset,h1,h2,h3,h4,h5,h6,head,hr,li,listing,menu,ol,p,pre,table,tbody,td,tfoot,th,title,tr,ul,xmp pre:dd,dl,dt,fieldset,form,li,table,ul s:p script:noscript small:p span:td,th strike:p style:body,frameset tbody:tbody,tfoot td:tbody,td,tfoot,th,tr tfoot:tbody th:tbody,td,tfoot,th,tr thead:tbody,tfoot title:body,frameset tr:tbody,tfoot,tr tt:p u:p,td,th ul:address,form,menu,pre xmp:dd,dl,dt,fieldset,form,li,table,ul";
    let mut s: Set[String] = Set.new();
    for item in split_spaces(t) {
        let parts = split_on(item, b':');
        for n in split_on(parts[1], b',') {
            s.insert(f"{parts[0]} {n}");
        }
    }
    s
}

// htmlEndPriority: an end tag closes open elements of lower or equal
// priority only.
fn end_priority(name: Str) -> i64 {
    if name == "div" {
        150
    } else if name == "td" or name == "th" {
        160
    } else if name == "tr" {
        170
    } else if name == "thead" or name == "tbody" or name == "tfoot" {
        180
    } else if name == "table" {
        190
    } else if name == "head" or name == "body" {
        200
    } else if name == "html" {
        220
    } else {
        100
    }
}

// The HTML 4 attributes whose bare form means their own name.
fn is_boolean_attr(name: Str) -> bool {
    for b in ["checked", "compact", "declare", "defer", "disabled", "ismap", "multiple", "nohref", "noresize", "noshade", "nowrap", "readonly", "selected"] {
        if b == name {
            return true;
        }
    }
    false
}

// The HTML5 named character references: for each name, whether it may
// end without a semicolon, and its value.
fn entity_map() -> Map[String, (bool, Vec[u8])] {
    let mut m: Map[String, (bool, Vec[u8])] = Map.new();
    let mut words = split_spaces(entities_1());
    for w in split_spaces(entities_2()).into_iter() {
        words.push(w);
    }
    let mut k: i64 = 0;
    while k + 2 < words.len() {
        m.insert(words[k].clone(), (words[k + 1] == "1", unhex(words[k + 2])));
        k += 3;
    }
    m
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) { c - b'0' } else { (c | 32) - b'a' + 10 }
}

// The bytes a run of hex digits spells; anything else is skipped.
fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hex_digit(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

// ------------------------------------------------------------ encodings

const ENC_UTF8: i64 = 1;
const ENC_LATIN1: i64 = 2;
const ENC_CP1252: i64 = 3;

// The encodings this port knows, by the names libxml2 and iconv take;
// 0 for any other.
fn codec_of(name: Str) -> i64 {
    let n = lower_ascii(name);
    if n == "utf-8" or n == "utf8" {
        ENC_UTF8
    } else if n == "iso-8859-1" or n == "iso8859-1" or n == "iso_8859-1" or n == "latin1" or n == "iso-latin-1" or n == "l1" {
        ENC_LATIN1
    } else if n == "windows-1252" or n == "cp1252" {
        ENC_CP1252
    } else {
        0
    }
}

// The code points windows-1252 gives 0x80 to 0x9f; 0 where it has none.
fn cp1252_high(c: u8) -> i64 {
    let t: Vec[i64] = vec![8364, 0, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 0, 381, 0, 0, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 0, 382, 376];
    t[(c - 128) as i64]
}

fn push_utf8(out: mut ref Vec[u8], c: i64) {
    if c < 128 {
        out.push(c as u8);
    } else if c < 2048 {
        out.push((192 + c / 64) as u8);
        out.push((128 + c % 64) as u8);
    } else if c < 65536 {
        out.push((224 + c / 4096) as u8);
        out.push((128 + (c / 64) % 64) as u8);
        out.push((128 + c % 64) as u8);
    } else {
        out.push((240 + c / 262144) as u8);
        out.push((128 + (c / 4096) % 64) as u8);
        out.push((128 + (c / 64) % 64) as u8);
        out.push((128 + c % 64) as u8);
    }
}

// Bytes in a single-byte encoding as UTF-8. A windows-1252 byte with no
// character becomes U+FFFD (iconv reports an error there instead).
fn decode_single(b: ref Vec[u8], from: i64, codec: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for i in from..b.len() {
        let c = b[i];
        if c < 128 {
            out.push(c);
        } else if codec == ENC_CP1252 and c < 160 {
            let u = cp1252_high(c);
            push_utf8(mut out, if u == 0 { 65533 } else { u });
        } else {
            push_utf8(mut out, c as i64);
        }
    }
    out
}

// htmlCodePointToUtf8: a numeric character reference's character, with
// 0x80 to 0x9f read as windows-1252 and the invalid ones as U+FFFD.
fn ncr_utf8(c0: i64) -> Vec[u8] {
    let remap: Vec[i64] = vec![8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143, 144, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376];
    let mut c = c0;
    if c >= 128 and c < 160 {
        c = remap[c - 128];
    } else if c <= 0 or (c >= 55296 and c < 57344) or c > 1114111 {
        c = 65533;
    }
    let mut out: Vec[u8] = Vec.new();
    push_utf8(mut out, c);
    out
}

fn fffd() -> Vec[u8] {
    vec![239, 191, 189]
}

// ------------------------------------------------------------ the parser

// The masks of htmlParseData: the bytes that end a run of data.
const MASK_DQ: i64 = 1;
const MASK_SQ: i64 = 2;
const MASK_GT: i64 = 3;
const MASK_DASH: i64 = 4;
const MASK_WS_GT: i64 = 5;

fn mask_match(mask: i64, c: u8) -> bool {
    if mask == MASK_DQ {
        c == b'"'
    } else if mask == MASK_SQ {
        c == b'\''
    } else if mask == MASK_GT {
        c == b'>'
    } else if mask == MASK_DASH {
        c == b'-'
    } else {
        c == 9 or c == 10 or c == 12 or c == 13 or c == b' ' or c == b'>'
    }
}

// libxml2's htmlParserCtxt with the SAX2 tree builder: the input, whether
// its encoding is settled, the open elements with their nodes, and the
// tree.
struct Html {
    b: Vec[u8],
    pos: i64,
    has_enc: bool,
    stack: Vec[(String, i64)],
    insert: i64,
    depth: i64,
    end_check: i64,
    dom: Dom,
    ents: Map[String, (bool, Vec[u8])],
    elems: Map[String, i64],
    closes: Set[String],
}

impl Html {
    fn at(ref self, i: i64) -> u8 {
        if i < self.b.len() { self.b[i] } else { 0 }
    }

    fn cur(ref self) -> u8 {
        self.at(self.pos)
    }

    fn nxt(ref self, k: i64) -> u8 {
        self.at(self.pos + k)
    }

    fn eof(ref self) -> bool {
        self.pos >= self.b.len()
    }

    fn top_name(ref self) -> String {
        let n = self.stack.len();
        if n == 0 { String.new() } else { self.stack[n - 1].0.clone() }
    }

    fn top_node(ref self) -> i64 {
        let n = self.stack.len();
        if n == 0 { -1 } else { self.stack[n - 1].1 }
    }

    fn in_stack(ref self, name: Str) -> bool {
        for (n, _) in self.stack {
            if n == name {
                return true;
            }
        }
        false
    }

    fn skip_blanks(mut ref self) {
        while not self.eof() and is_ws_html(self.cur()) {
            self.pos += 1;
        }
    }

    // ---------------------------------------------------- encodings

    // Decode the rest of the input, from the current position, in a
    // new encoding (xmlSwitchEncoding). False for an unknown encoding.
    fn switch_to(mut ref self, name: Str) -> bool {
        let codec = codec_of(name);
        if codec == 0 {
            return false;
        }
        if codec != ENC_UTF8 {
            let mut nb = bytes_of(self.b, 0, self.pos);
            for c in decode_single(self.b, self.pos, codec) {
                nb.push(c);
            }
            self.b = nb;
        }
        self.has_enc = true;
        true
    }

    // xmlSetDeclaredEncoding: a meta tag's charset counts only while no
    // encoding is settled.
    fn declare(mut ref self, name: Str) {
        if not self.has_enc {
            let _ = self.switch_to(name);
        }
    }

    // A byte above 0x7f before any encoding is settled: htmlFindEncoding
    // looks ahead for an http-equiv charset, and without one the rest is
    // ISO-8859-1.
    fn guess_encoding(mut ref self) {
        let mut guess = String.new();
        let a = find_ci(self.b, self.pos, "HTTP-EQUIV");
        if a >= 0 {
            let c = find_ci(self.b, a, "CONTENT");
            if c >= 0 {
                let s = find_ci(self.b, c, "CHARSET=");
                if s >= 0 {
                    let mut e = s + 8;
                    while e < self.b.len() and (is_alnum(self.b[e]) or self.b[e] == b'-' or self.b[e] == b'_' or self.b[e] == b':' or self.b[e] == b'/') {
                        e += 1;
                    }
                    guess = byte_str(self.b, s + 8, e);
                }
            }
        }
        if guess.len() == 0 {
            let _ = self.switch_to("iso-8859-1");
        } else {
            let _ = self.switch_to(guess);
        }
        self.has_enc = true;
    }

    // htmlValidateUtf8: the length of the UTF-8 sequence at i, or -1.
    fn utf8_size(ref self, i: i64) -> i64 {
        let c = self.b[i] as i64;
        let n = self.b.len() - i;
        if c < 194 {
            return -1;
        }
        if c < 224 {
            if n < 2 or (self.b[i + 1] & 192) != 128 {
                return -1;
            }
            return 2;
        }
        if c < 240 {
            if n < 3 {
                return -1;
            }
            let v = (c << 16) | ((self.b[i + 1] as i64) << 8) | (self.b[i + 2] as i64);
            if (v & 49344) != 32896 or (v & 991232) == 0 or (v & 991232) == 868352 {
                return -1;
            }
            return 3;
        }
        if n < 4 {
            return -1;
        }
        let v = (c << 24) | ((self.b[i + 1] as i64) << 16) | ((self.b[i + 2] as i64) << 8) | (self.b[i + 3] as i64);
        if (v & 12632256) != 8421504 or v < 4035969024 or v >= 4103077888 {
            return -1;
        }
        4
    }

    // htmlFindEntityPrefix over the bytes at `start`, just after the
    // ampersand: the longest entity name there that may end where it
    // does, the length it takes (with its semicolon) and its value.
    fn entity_at(ref self, start: i64, is_attr: bool) -> Option[(i64, Vec[u8])] {
        let slen = self.b.len() - start;
        if slen < 2 or not is_letter(self.b[start]) {
            return None;
        }
        let mut best: Option[(i64, Vec[u8])] = None;
        let mut l: i64 = 1;
        while l <= 32 and l <= slen {
            let name = byte_str(self.b, start, start + l);
            if let Some(e) = self.ents.get(name) {
                let (legacy, val) = e;
                let term = self.at(start + l);
                let is_term = term == b';' or (legacy and (not is_attr or (not is_alnum(term) and term != b'=')));
                if is_term {
                    best = Some((l + if term == b';' { 1 } else { 0 }, val.clone()));
                }
            }
            l += 1;
        }
        best
    }

    // ---------------------------------------------------- the tree

    fn push_elem(mut ref self, name: Str, attrs: ref Vec[(String, Option[String])]) {
        if name == "head" and self.insert < INSERT_IN_HEAD {
            self.insert = INSERT_IN_HEAD;
        }
        if name == "body" and self.insert < INSERT_IN_BODY {
            self.insert = INSERT_IN_BODY;
        }
        let parent = if self.stack.len() == 0 { 0 } else { self.top_node() };
        let mut n = new_node(K_ELEM, name, "", parent);
        for (k, v) in attrs {
            let value = match v {
                Some(x) => x.clone(),
                None => if is_boolean_attr(k) { k.clone() } else { String.new() },
            };
            n.attrs.push((k.clone(), value));
        }
        let id = self.dom.add(parent, n);
        self.stack.push((name.to_string(), id));
    }

    fn pop_elem(mut ref self) {
        let _ = self.stack.pop();
    }

    fn characters(mut ref self, s: ref Vec[u8]) {
        let p = self.top_node();
        if p >= 0 and s.len() > 0 {
            self.dom.add_text(p, K_TEXT, from_bytes(s.clone()));
        }
    }

    fn cdata(mut ref self, s: ref Vec[u8]) {
        let p = self.top_node();
        if p >= 0 and s.len() > 0 {
            self.dom.add_text(p, K_CDATA, from_bytes(s.clone()));
        }
    }

    fn comment(mut ref self, s: ref Vec[u8]) {
        let p = if self.stack.len() == 0 { 0 } else { self.top_node() };
        let _ = self.dom.add(p, new_node(K_COMMENT, "", from_bytes(s.clone()), p));
    }

    // ---------------------------------------------------- implied and closed elements

    // htmlAutoClose: close the open elements the new tag closes.
    fn auto_close(mut ref self, newtag: Str) {
        while self.stack.len() > 0 and self.closes.contains(f"{self.top_name()} {newtag}") {
            self.pop_elem();
        }
    }

    // htmlAutoCloseOnClose: an end tag closes what it can reach without
    // passing an element of higher priority.
    fn auto_close_on_close(mut ref self, newtag: Str) {
        let priority = end_priority(newtag);
        let mut i = self.stack.len() - 1;
        while i >= 0 {
            if self.stack[i].0 == newtag {
                break;
            }
            if end_priority(self.stack[i].0) > priority {
                return;
            }
            i -= 1;
        }
        if i < 0 {
            return;
        }
        while self.top_name() != newtag {
            self.pop_elem();
        }
    }

    // htmlCheckImplied: html, then head or body, where the tag needs them.
    fn check_implied(mut ref self, newtag: Str) {
        if newtag == "html" {
            return;
        }
        let none: Vec[(String, Option[String])] = Vec.new();
        if self.stack.len() == 0 {
            self.push_elem("html", none);
        }
        if newtag == "body" or newtag == "head" {
            return;
        }
        let head_tag = newtag == "script" or newtag == "style" or newtag == "meta" or newtag == "link" or newtag == "title" or newtag == "base";
        if self.stack.len() <= 1 and head_tag {
            if self.insert >= INSERT_IN_HEAD {
                return;
            }
            self.push_elem("head", none);
        } else if newtag != "noframes" and newtag != "frame" and newtag != "frameset" {
            if self.insert >= INSERT_IN_BODY {
                return;
            }
            if self.in_stack("body") or self.in_stack("head") {
                return;
            }
            self.push_elem("body", none);
        }
    }

    // htmlStartCharData: text that is not white space needs a body.
    fn start_char_data(mut ref self) {
        if self.top_name() == "head" {
            self.auto_close("p");
        }
        self.check_implied("p");
    }

    // htmlCharDataSAXCallback: white space at the start of text in html
    // or head stays there; the rest of it starts a body.
    fn char_data_cb(mut ref self, buf: ref Vec[u8], mode: i64) {
        if mode == 0 or mode == DATA_RCDATA {
            let mut start: i64 = 0;
            if self.stack.len() == 0 or self.top_name() == "html" or self.top_name() == "head" {
                while start < buf.len() and is_ws_html(buf[start]) {
                    start += 1;
                }
                if start > 0 {
                    self.characters(bytes_of(buf, 0, start));
                }
                if start >= buf.len() {
                    return;
                }
                self.start_char_data();
            }
            self.characters(bytes_of(buf, start, buf.len()));
        } else {
            self.cdata(buf);
        }
    }

    // ---------------------------------------------------- character data

    // htmlParseCharData: text, character references, and the raw text
    // of script, style and the rest up to their end tag.
    fn char_data(mut ref self) {
        let mut mode = self.end_check;
        let mut complete = false;
        loop {
            let n = self.b.len();
            let chunk = self.pos;
            let mut i = self.pos;
            let mut repl: Vec[u8] = Vec.new();
            let mut skip: i64 = 0;
            let mut ncr: i64 = 0;
            let mut ncr_size: i64 = 0;
            let mut cp: i64 = 0;
            let mut done = false;
            let mut restart = false;
            loop {
                if i >= n {
                    done = true;
                    break;
                }
                let cur = self.b[i];
                if ncr > 0 {
                    let lc = cur | 32;
                    let mut digit: i64 = -1;
                    if is_digit(cur) {
                        digit = (cur - b'0') as i64;
                    } else if ncr == 16 and lc >= b'a' and lc <= b'f' {
                        digit = (lc - b'a') as i64 + 10;
                    }
                    if digit < 0 {
                        if cur == b';' {
                            i += 1;
                            ncr_size += 1;
                        }
                        break;
                    }
                    cp = cp * ncr + digit;
                    if cp >= 1114112 {
                        cp = 1114112;
                    }
                    ncr_size += 1;
                    i += 1;
                    continue;
                }
                if cur == b'<' {
                    if mode == 0 {
                        done = true;
                        complete = true;
                        break;
                    }
                    if mode != DATA_PLAINTEXT and i + 1 < n {
                        let mut j = i + 1;
                        if mode == DATA_SCRIPT and self.b[j] == b'!' {
                            j += 1;
                            if j < n and self.b[j] == b'-' {
                                j += 1;
                                if j < n and self.b[j] == b'-' {
                                    mode = DATA_SCRIPT_ESC1;
                                }
                            }
                        } else {
                            let mut solidus = false;
                            if self.b[j] == b'/' {
                                j += 1;
                                solidus = true;
                            }
                            if solidus or mode == DATA_SCRIPT_ESC1 {
                                let name = to_bytes(self.top_name());
                                let mut k: i64 = 0;
                                while j < n and k < name.len() and name[k] == (self.b[j] | 32) {
                                    k += 1;
                                    j += 1;
                                }
                                if k == name.len() and j < n {
                                    let c = self.b[j];
                                    if c == b'>' or c == b'/' or is_ws_html(c) {
                                        if mode == DATA_SCRIPT_ESC1 and not solidus {
                                            mode = DATA_SCRIPT_ESC2;
                                        } else if mode == DATA_SCRIPT_ESC2 {
                                            mode = DATA_SCRIPT_ESC1;
                                        } else {
                                            complete = true;
                                            done = true;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    i += 1;
                    continue;
                }
                if cur == b'-' {
                    if (mode == DATA_SCRIPT_ESC1 or mode == DATA_SCRIPT_ESC2) and self.at(i + 1) == b'-' and self.at(i + 2) == b'>' {
                        mode = DATA_SCRIPT;
                    }
                    i += 1;
                    continue;
                }
                if cur == b'&' {
                    if mode != 0 and mode != DATA_RCDATA {
                        i += 1;
                        continue;
                    }
                    if self.at(i + 1) == b'#' {
                        let c2 = self.at(i + 2);
                        let mut size: i64 = 1;
                        if (c2 | 32) == b'x' {
                            if is_hex_digit(self.at(i + 3)) {
                                ncr = 16;
                                size = 3;
                                ncr_size = 3;
                                cp = 0;
                            }
                        } else if is_digit(c2) {
                            ncr = 10;
                            size = 2;
                            ncr_size = 2;
                            cp = 0;
                        }
                        i += size;
                        continue;
                    }
                    match self.entity_at(i + 1, false) {
                        Some(found) => {
                            let (len, val) = found;
                            skip = len + 1;
                            repl = val;
                            break;
                        }
                        None => {
                            i += 1;
                            continue;
                        }
                    }
                }
                if cur == 0 {
                    skip = 1;
                    repl = fffd();
                    break;
                }
                if cur == b'\r' {
                    skip = 1;
                    if self.at(i + 1) != 10 {
                        repl = vec![10];
                    }
                    break;
                }
                if cur >= 128 {
                    if not self.has_enc {
                        if i > chunk {
                            break;
                        }
                        self.guess_encoding();
                        restart = true;
                        break;
                    }
                    let size = self.utf8_size(i);
                    if size <= 0 {
                        skip = 1;
                        repl = fffd();
                        break;
                    }
                    i += size;
                    continue;
                }
                i += 1;
            }
            if restart {
                continue;
            }
            if ncr_size > 0 {
                skip = ncr_size;
                i -= ncr_size;
                repl = ncr_utf8(cp);
            }
            self.pos = i;
            if i > chunk {
                let piece = bytes_of(self.b, chunk, i);
                self.char_data_cb(piece, mode);
            }
            self.pos += skip;
            if repl.len() > 0 {
                self.char_data_cb(repl, mode);
            }
            if done {
                break;
            }
        }
        self.end_check = if complete { 0 } else { mode };
    }

    // htmlParseData: an attribute value, a comment or a doctype field, up
    // to a byte of the mask; character references only where refs is
    // set.
    fn parse_data(mut ref self, mask: i64, comment: bool, refs: bool) -> Vec[u8] {
        let mut out: Vec[u8] = Vec.new();
        let mut term_skip: i64 = -1;
        loop {
            let n = self.b.len();
            let chunk = self.pos;
            let mut i = self.pos;
            let mut repl: Vec[u8] = Vec.new();
            let mut skip: i64 = 0;
            let mut ncr: i64 = 0;
            let mut ncr_size: i64 = 0;
            let mut cp: i64 = 0;
            let mut restart = false;
            loop {
                if i >= n {
                    term_skip = 0;
                    break;
                }
                let cur = self.b[i];
                if mask_match(mask, cur) {
                    if comment {
                        if n - i < 2 {
                            term_skip = 1;
                        } else if self.b[i + 1] == b'-' {
                            if n - i < 3 {
                                term_skip = 2;
                            } else if self.b[i + 2] == b'>' {
                                term_skip = 3;
                            } else if self.b[i + 2] == b'!' {
                                if n - i < 4 {
                                    term_skip = 3;
                                } else if self.b[i + 3] == b'>' {
                                    term_skip = 4;
                                }
                            }
                        }
                        if term_skip >= 0 {
                            break;
                        }
                    } else {
                        term_skip = 0;
                        break;
                    }
                }
                if ncr > 0 {
                    let lc = cur | 32;
                    let mut digit: i64 = -1;
                    if is_digit(cur) {
                        digit = (cur - b'0') as i64;
                    } else if ncr == 16 and lc >= b'a' and lc <= b'f' {
                        digit = (lc - b'a') as i64 + 10;
                    }
                    if digit < 0 {
                        if cur == b';' {
                            i += 1;
                            ncr_size += 1;
                        }
                        break;
                    }
                    cp = cp * ncr + digit;
                    if cp >= 1114112 {
                        cp = 1114112;
                    }
                    ncr_size += 1;
                    i += 1;
                    continue;
                }
                if cur == b'&' and refs {
                    if self.at(i + 1) == b'#' {
                        let c2 = self.at(i + 2);
                        let mut size: i64 = 1;
                        if (c2 | 32) == b'x' {
                            if is_hex_digit(self.at(i + 3)) {
                                ncr = 16;
                                size = 3;
                                ncr_size = 3;
                                cp = 0;
                            }
                        } else if is_digit(c2) {
                            ncr = 10;
                            size = 2;
                            ncr_size = 2;
                            cp = 0;
                        }
                        i += size;
                        continue;
                    }
                    match self.entity_at(i + 1, true) {
                        Some(found) => {
                            let (len, val) = found;
                            skip = len + 1;
                            repl = val;
                            break;
                        }
                        None => {
                            i += 1;
                            continue;
                        }
                    }
                }
                if cur == 0 {
                    skip = 1;
                    repl = fffd();
                    break;
                }
                if cur == b'\r' {
                    skip = 1;
                    if self.at(i + 1) != 10 {
                        repl = vec![10];
                    }
                    break;
                }
                if cur >= 128 {
                    if not self.has_enc {
                        if i > chunk {
                            break;
                        }
                        self.guess_encoding();
                        restart = true;
                        break;
                    }
                    let size = self.utf8_size(i);
                    if size <= 0 {
                        skip = 1;
                        repl = fffd();
                        break;
                    }
                    i += size;
                    continue;
                }
                i += 1;
            }
            if restart {
                continue;
            }
            if ncr_size > 0 {
                skip = ncr_size;
                i -= ncr_size;
                repl = ncr_utf8(cp);
            }
            for k in chunk..i {
                out.push(self.b[k]);
            }
            self.pos = i + skip;
            for c in repl {
                out.push(c);
            }
            if term_skip >= 0 {
                break;
            }
        }
        if term_skip > 0 {
            self.pos += term_skip;
        }
        out
    }

    // htmlParseHTMLName: a tag or attribute name, in lower case, of at
    // most 100 bytes.
    fn parse_name(mut ref self, attr: bool) -> String {
        let stop = if attr { b'=' } else { b' ' };
        let mut buf: Vec[u8] = Vec.new();
        while not self.eof() {
            let c = self.cur();
            if buf.len() != 0 and (c == b'/' or c == b'>' or c == stop or is_ws_html(c)) {
                break;
            }
            let mut size: i64 = 1;
            if c == 0 {
                if buf.len() + 3 <= 100 {
                    for x in fffd() {
                        buf.push(x);
                    }
                }
            } else if c < 128 {
                if buf.len() < 100 {
                    buf.push(if c >= b'A' and c <= b'Z' { c + 32 } else { c });
                }
            } else {
                size = self.utf8_size(self.pos);
                if size > 0 {
                    if buf.len() + size <= 100 {
                        for k in 0..size {
                            buf.push(self.b[self.pos + k]);
                        }
                    }
                } else {
                    size = 1;
                    if buf.len() + 3 <= 100 {
                        for x in fffd() {
                            buf.push(x);
                        }
                    }
                }
            }
            self.pos += size;
        }
        from_bytes(buf)
    }

    // htmlParseComment: <!-- ... --> or a bogus comment up to `>`.
    fn parse_comment(mut ref self, bogus: bool) {
        if bogus {
            let d = self.parse_data(MASK_GT, false, false);
            if self.cur() == b'>' {
                self.pos += 1;
            }
            self.comment(d);
            return;
        }
        if self.cur() == b'>' {
            self.pos += 1;
            self.comment(Vec.new());
        } else if self.cur() == b'-' and self.nxt(1) == b'>' {
            self.pos += 2;
            self.comment(Vec.new());
        } else {
            let d = self.parse_data(MASK_DASH, true, false);
            self.comment(d);
        }
    }

    // htmlParseDocTypeDecl: its name and identifiers take no part in the
    // tree, and it always ends at the first `>`.
    fn parse_doctype(mut ref self) {
        self.pos += 9;
        while not self.eof() {
            let c = self.cur();
            self.pos += 1;
            if c == b'>' {
                break;
            }
        }
    }

    fn is_doctype(ref self) -> bool {
        let w = to_bytes("DOCTYPE");
        for k in 0..7 {
            let c = self.nxt(2 + k);
            let u = if c >= b'a' and c <= b'z' { c - 32 } else { c };
            if u != w[k] {
                return false;
            }
        }
        true
    }

    // htmlParseAttValue: quoted or bare.
    fn parse_att_value(mut ref self) -> Vec[u8] {
        if self.cur() == b'"' {
            self.pos += 1;
            let v = self.parse_data(MASK_DQ, false, true);
            if self.cur() == b'"' {
                self.pos += 1;
            }
            return v;
        }
        if self.cur() == b'\'' {
            self.pos += 1;
            let v = self.parse_data(MASK_SQ, false, true);
            if self.cur() == b'\'' {
                self.pos += 1;
            }
            return v;
        }
        self.parse_data(MASK_WS_GT, false, true)
    }

    fn parse_attribute(mut ref self) -> (String, Option[String]) {
        let name = self.parse_name(true);
        self.skip_blanks();
        let mut value: Option[String] = None;
        if self.cur() == b'=' {
            self.pos += 1;
            self.skip_blanks();
            value = Some(from_bytes(self.parse_att_value()));
        }
        (name, value)
    }

    // htmlCheckMeta and htmlCheckEncoding.
    fn check_meta(mut ref self, attrs: ref Vec[(String, Option[String])]) {
        let mut http = false;
        let mut content: Option[String] = None;
        for (k, v) in attrs {
            if let Some(val) = v {
                if eq_ci(k, "http-equiv") and eq_ci(val, "Content-Type") {
                    http = true;
                } else if eq_ci(k, "charset") {
                    self.declare(val);
                } else if eq_ci(k, "content") {
                    content = Some(val.clone());
                }
            }
        }
        if http {
            if let Some(c) = content {
                let b = to_bytes(c);
                let mut at = find_ci(b, 0, "charset");
                if at >= 0 {
                    at += 7;
                    if at < b.len() and is_ws_html(b[at]) {
                        at = find_ci(b, 0, "=");
                    }
                    if at >= 0 and at < b.len() and b[at] == b'=' {
                        self.declare(byte_str(b, at + 1, b.len()));
                    }
                }
            }
        }
    }

    // htmlParseStartTag; true when the element was opened.
    fn parse_start_tag(mut ref self) {
        self.end_check = 0;
        self.pos += 1;
        let name = self.parse_name(false);
        let meta = name == "meta";
        self.auto_close(name);
        self.check_implied(name);
        let mut discard = false;
        if self.stack.len() > 0 and name == "html" {
            discard = true;
            self.depth += 1;
        }
        if self.stack.len() != 1 and name == "head" {
            discard = true;
            self.depth += 1;
        }
        if name == "body" {
            for (n, _) in self.stack.clone() {
                if n == "body" {
                    discard = true;
                    self.depth += 1;
                }
            }
        }
        self.skip_blanks();
        let mut attrs: Vec[(String, Option[String])] = Vec.new();
        while not self.eof() and self.cur() != b'>' and not (self.cur() == b'/' and self.nxt(1) == b'>') {
            if self.cur() == b'/' {
                self.pos += 1;
                self.skip_blanks();
                continue;
            }
            let (k, v) = self.parse_attribute();
            let mut dup = false;
            for (a, _) in attrs {
                if a == k {
                    dup = true;
                }
            }
            if not dup {
                attrs.push((k, v));
            }
            self.skip_blanks();
        }
        if self.eof() {
            return;
        }
        if meta and attrs.len() > 0 {
            self.check_meta(attrs);
        }
        if not discard {
            self.push_elem(name, attrs);
        }
    }

    // htmlParseEndTag.
    fn parse_end_tag(mut ref self) {
        self.end_check = 0;
        self.pos += 2;
        if self.eof() {
            self.start_char_data();
            self.characters(to_bytes("</"));
            return;
        }
        if self.cur() == b'>' {
            self.pos += 1;
            return;
        }
        if not is_letter(self.cur()) {
            self.parse_comment(true);
            return;
        }
        let name = self.parse_name(false);
        self.skip_blanks();
        while not self.eof() and self.cur() != b'>' and not (self.cur() == b'/' and self.nxt(1) == b'>') {
            if self.cur() == b'/' {
                self.pos += 1;
                self.skip_blanks();
                continue;
            }
            let _ = self.parse_attribute();
            self.skip_blanks();
        }
        if self.cur() == b'>' {
            self.pos += 1;
        } else if self.cur() == b'/' and self.nxt(1) == b'>' {
            self.pos += 2;
        } else {
            return;
        }
        if self.depth > 0 and (name == "html" or name == "body" or name == "head") {
            self.depth -= 1;
            return;
        }
        if not self.in_stack(name) {
            return;
        }
        self.auto_close_on_close(name);
        if self.top_name() == name {
            self.pop_elem();
        }
    }

    // htmlParseElementInternal: a start tag, closed at once when it ends
    // in `/>` or names an empty element.
    fn parse_element(mut ref self) {
        self.parse_start_tag();
        if self.stack.len() == 0 {
            return;
        }
        let name = self.top_name();
        if self.cur() == b'/' and self.nxt(1) == b'>' {
            self.pos += 2;
            self.pop_elem();
            return;
        }
        if self.cur() != b'>' {
            return;
        }
        self.pos += 1;
        if let Some(code) = self.elems.get(name) {
            let c = *code;
            if c >= 10 {
                self.pop_elem();
                return;
            }
            self.end_check = c;
        }
    }

    // htmlParseContent.
    fn parse_content(mut ref self) {
        while not self.eof() {
            let mode = self.end_check;
            if mode == 0 and self.cur() == b'<' {
                let n1 = self.nxt(1);
                if n1 == b'/' {
                    self.parse_end_tag();
                } else if n1 == b'!' {
                    if self.is_doctype() {
                        self.parse_doctype();
                    } else if self.nxt(2) == b'-' and self.nxt(3) == b'-' {
                        self.pos += 4;
                        self.parse_comment(false);
                    } else {
                        self.pos += 2;
                        self.parse_comment(true);
                    }
                } else if n1 == b'?' {
                    self.pos += 1;
                    self.parse_comment(true);
                } else if is_letter(n1) {
                    self.parse_element();
                } else {
                    self.start_char_data();
                    self.characters(to_bytes("<"));
                    self.pos += 1;
                }
            } else {
                self.char_data();
            }
        }
        while self.stack.len() > 0 {
            self.pop_elem();
        }
    }

    // The comments and processing instructions before the content.
    fn parse_misc(mut ref self) {
        while self.cur() == b'<' {
            if self.nxt(1) == b'!' and self.nxt(2) == b'-' and self.nxt(3) == b'-' {
                self.pos += 4;
                self.parse_comment(false);
            } else if self.nxt(1) == b'?' {
                self.pos += 1;
                self.parse_comment(true);
            } else {
                break;
            }
            self.skip_blanks();
        }
    }

    // htmlParseDocument.
    fn parse_document(mut ref self) {
        if not self.has_enc and self.b.len() >= 3 and self.b[0] == 239 and self.b[1] == 187 and self.b[2] == 191 {
            self.pos = 3;
            self.has_enc = true;
        }
        if not self.has_enc and self.b.len() >= 4 and self.b[0] == b'<' and self.b[1] == b'?' and self.b[2] == b'x' and self.b[3] == b'm' {
            self.has_enc = true;
        }
        self.skip_blanks();
        self.parse_misc();
        if self.cur() == b'<' and self.nxt(1) == b'!' and self.is_doctype() {
            self.parse_doctype();
        }
        self.skip_blanks();
        self.parse_misc();
        self.parse_content();
    }
}

// lxml.html.parse(path, HTMLParser(recover=True, encoding=...)): the
// tree of a file's bytes, with the encoding the caller forces, if any.
fn parse_html(bytes: own Vec[u8], forced: i64) -> Dom {
    let mut root = new_node(K_DOC, "", "", -1);
    root.parent = -1;
    let mut h = Html {
        b: bytes,
        pos: 0,
        has_enc: false,
        stack: Vec.new(),
        insert: 0,
        depth: 0,
        end_check: 0,
        dom: Dom { nodes: vec![root] },
        ents: entity_map(),
        elems: element_table(),
        closes: start_close_table(),
    };
    if forced != 0 {
        if forced != ENC_UTF8 {
            h.b = decode_single(h.b, 0, forced);
        }
        h.has_enc = true;
    }
    h.parse_document();
    h.dom
}

