    s.push_str("fnv1_32\thello\n");
    s.push_str("fnv1a_32\thello\n");
    s.push_str("fnv0_32\tHello\n");
    s.push_str("fnv1_32\tHello\n");
    s.push_str("fnv1a_32\tHello\n");
    s.push_str("fnv0_32\thello world\n");
    s.push_str("fnv1_32\thello world\n");
    s.push_str("fnv1a_32\thello world\n");
    s.push_str("fnv0_32\tThe quick brown fox jumps over the lazy dog\n");
    s.push_str("fnv1_32\tThe quick brown fox jumps over the lazy dog\n");
    s.push_str("fnv1a_32\tThe quick brown fox jumps over the lazy dog\n");
    s.push_str("fnv0_32\tfoobar\n");
    s.push_str("fnv1_32\tfoobar\n");
    s.push_str("fnv1a_32\tfoobar\n");
    s.push_str("fnv0_32\tchongo was here!\n");
    s.push_str("fnv1_32\tchongo was here!\n");
    s.push_str("fnv1a_32\tchongo was here!\n");
    s.push_str("fnv0_32\tchongo was here!\n");
    s.push_str("fnv1_32\tchongo was here!\n");
    s.push_str("fnv1a_32\tchongo was here!\n");
    s.push_str("fnv0_32\t1234567890\n");
    s.push_str("fnv1_32\t1234567890\n");
    s.push_str("fnv1a_32\t1234567890\n");
    s.push_str("fnv0_32\t0\n");
    s.push_str("fnv1_32\t0\n");
    s.push_str("fnv1a_32\t0\n");
    s.push_str("fnv0_32\t00\n");
    s.push_str("fnv1_32\t00\n");
    s.push_str("fnv1a_32\t00\n");
    s.push_str("fnv0_32\t000\n");
    s.push_str("fnv1_32\t000\n");
    s.push_str("fnv1a_32\t000\n");
    s.push_str("fnv0_32\tFNV\n");
    s.push_str("fnv1_32\tFNV\n");
    s.push_str("fnv1a_32\tFNV\n");
    s.push_str("fnv0_32\tfnv\n");
    s.push_str("fnv1_32\tfnv\n");
    s.push_str("fnv1a_32\tfnv\n");
    s.push_str("fnv0_32\tgeohash\n");
    s.push_str("fnv1_32\tgeohash\n");
    s.push_str("fnv1a_32\tgeohash\n");
    s.push_str("fnv0_32\ta quick test of the fnv hash\n");
    s.push_str("fnv1_32\ta quick test of the fnv hash\n");
    s.push_str("fnv1a_32\ta quick test of the fnv hash\n");
