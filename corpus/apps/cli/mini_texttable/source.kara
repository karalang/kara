// mini_texttable: a port of texttable 1.7.2 (MIT, Gerome Fournier), the
// module that draws ASCII tables for command-line tools, run as the tables
// an operations team's tools print: a server inventory, a cost report,
// benchmark runs, a translation status board and a CSV import with bad
// rows. Every op of data/jobs.tsv is a call on a Texttable. See README.md.

// ------------------------------------------------------------ chars

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn repeat(c: char, n: i64) -> String {
    let mut s = String.new();
    let mut k = 0;
    while k < n {
        s.push(c);
        k += 1;
    }
    s
}

fn repeat_str(t: ref String, n: i64) -> String {
    let mut s = String.new();
    let mut k = 0;
    while k < n {
        s.push_str(t);
        k += 1;
    }
    s
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' { chr(c as i64 + 32) } else { c }
}

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

fn hex_val(c: char) -> i64 {
    if is_digit(c) {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else {
        c as i64 - 55
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs = to_chars(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

// str.isspace, which str.strip uses: Unicode White_Space plus the four
// ASCII separators U+001C..U+001F.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

// s.strip() == ""
fn is_blank(s: ref String) -> bool {
    s.chars().all(|c| py_space(c))
}

// str.split(sep) for a one-character separator: always at least one piece.
fn split_char(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

// ------------------------------------------------------------ repr() and ascii()

fn char_esc(n: i64) -> String {
    if n < 0x100 {
        f"\\x{hex_digits(n, 2)}"
    } else if n < 0x10000 {
        f"\\u{hex_digits(n, 4)}"
    } else {
        f"\\U{hex_digits(n, 8)}"
    }
}

fn quote_of(s: ref String) -> char {
    if s.contains("'") and not s.contains("\"") { '"' } else { '\'' }
}

// ascii() of a str, or repr() of an ASCII one.
fn py_ascii(s: ref String) -> String {
    let q = quote_of(s);
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if n < 0x20 or n >= 0x7f {
            out.push_str(char_esc(n));
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// ascii() without its quotes: how the output shows any text.
fn vis(s: ref String) -> String {
    let cs = to_chars(py_ascii(s));
    text(cs, 1, cs.len() - 1)
}

// repr() of bytes.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut sq = false;
    let mut dq = false;
    for x in b {
        if *x == 39 {
            sq = true;
        }
        if *x == 34 {
            dq = true;
        }
    }
    let q: i64 = if sq and not dq { 34 } else { 39 };
    let mut out = "b".to_string();
    out.push(chr(q));
    for x in b {
        let n = *x as i64;
        if n == q or n == 92 {
            out.push('\\');
            out.push(chr(n));
        } else if n == 9 {
            out.push_str("\\t");
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n < 32 or n >= 127 {
            out.push_str(f"\\x{hex_digits(n, 2)}");
        } else {
            out.push(chr(n));
        }
    }
    out.push(chr(q));
    out
}

// ------------------------------------------------------------ bytes to str

// bytes.decode('utf-8', 'replace'), and the message that
// bytes.decode('utf-8') raises with at the first bad sequence.
fn decode_utf8(b: ref Vec[u8]) -> (String, Option[String]) {
    let n = b.len();
    let mut out = String.new();
    let mut first: Option[String] = None;
    let mut i = 0;
    while i < n {
        let x = b[i] as i64;
        if x < 0x80 {
            out.push(chr(x));
            i += 1;
            continue;
        }
        let (need, lo, hi) = if x >= 0xc2 and x <= 0xdf {
            (1, 0x80, 0xbf)
        } else if x == 0xe0 {
            (2, 0xa0, 0xbf)
        } else if x == 0xed {
            (2, 0x80, 0x9f)
        } else if x >= 0xe1 and x <= 0xef {
            (2, 0x80, 0xbf)
        } else if x == 0xf0 {
            (3, 0x90, 0xbf)
        } else if x == 0xf4 {
            (3, 0x80, 0x8f)
        } else if x >= 0xf1 and x <= 0xf3 {
            (3, 0x80, 0xbf)
        } else {
            (0, 0, 0)
        };
        if need == 0 {
            if first.is_none() {
                first = Some(f"'utf-8' codec can't decode byte 0x{hex_digits(x, 2)} in position {i}: invalid start byte");
            }
            out.push('\u{fffd}');
            i += 1;
            continue;
        }
        let mut good = need + 1;
        let mut at_end = false;
        for k in 1..(need + 1) {
            if i + k >= n {
                good = k;
                at_end = true;
                break;
            }
            let y = b[i + k] as i64;
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xbf) };
            if y < l or y > h {
                good = k;
                break;
            }
        }
        if good <= need {
            if first.is_none() {
                let reason = if at_end { "unexpected end of data" } else { "invalid continuation byte" };
                first = Some(if good == 1 {
                    f"'utf-8' codec can't decode byte 0x{hex_digits(x, 2)} in position {i}: {reason}"
                } else {
                    f"'utf-8' codec can't decode bytes in position {i}-{i + good - 1}: {reason}"
                });
            }
            out.push('\u{fffd}');
            i += good;
            continue;
        }
        let mut cp = if need == 1 { x & 0x1f } else if need == 2 { x & 0x0f } else { x & 0x07 };
        for k in 1..(need + 1) {
            cp = cp * 64 + (b[i + k] as i64 & 0x3f);
        }
        out.push(chr(cp));
        i += need + 1;
    }
    (out, first)
}

// ------------------------------------------------------------ floats

// Magnitudes as 32-bit limbs, least significant first, with no high
// zero limbs (zero is the empty vector).
fn big_trim(a: mut ref Vec[u32]) {
    while a.len() > 0 and a[a.len() - 1] == 0 {
        a.pop();
    }
}

fn big_mul_add(a: mut ref Vec[u32], m: u64, add: u64) {
    let mut carry = add;
    for i in 0..a.len() {
        let t = (a[i] as u64) * m + carry;
        a[i] = (t & 4294967295) as u32;
        carry = t >> 32;
    }
    while carry > 0 {
        a.push((carry & 4294967295) as u32);
        carry = carry >> 32;
    }
}

fn big_from_digits(ds: ref Vec[u8]) -> Vec[u32] {
    let mut a: Vec[u32] = Vec.new();
    for d in ds.iter() {
        big_mul_add(mut a, 10, *d as u64);
    }
    big_trim(mut a);
    a
}

fn big_pow10(n: i64) -> Vec[u32] {
    let mut a: Vec[u32] = [1];
    let mut k = n;
    while k >= 9 {
        big_mul_add(mut a, 1000000000, 0);
        k -= 9;
    }
    while k > 0 {
        big_mul_add(mut a, 10, 0);
        k -= 1;
    }
    a
}

fn big_mul(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(a.len() + b.len()) {
        out.push(0);
    }
    for i in 0..a.len() {
        let mut carry: u64 = 0;
        for j in 0..b.len() {
            let t = (a[i] as u64) * (b[j] as u64) + (out[i + j] as u64) + carry;
            out[i + j] = (t & 4294967295) as u32;
            carry = t >> 32;
        }
        let mut k = i + b.len();
        while carry > 0 {
            let t = (out[k] as u64) + carry;
            out[k] = (t & 4294967295) as u32;
            carry = t >> 32;
            k += 1;
        }
    }
    big_trim(mut out);
    out
}

fn big_bitlen(a: ref Vec[u32]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut n: i64 = 0;
    while top > 0 {
        n += 1;
        top = top >> 1;
    }
    (a.len() - 1) * 32 + n
}

fn big_shl(a: ref Vec[u32], bits: i64) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(bits / 32) {
        out.push(0);
    }
    let s = bits % 32;
    let mut carry: u64 = 0;
    for i in 0..a.len() {
        let t = ((a[i] as u64) << s) | carry;
        out.push((t & 4294967295) as u32);
        carry = t >> 32;
    }
    if carry > 0 {
        out.push(carry as u32);
    }
    big_trim(mut out);
    out
}

fn big_shr1(a: mut ref Vec[u32]) {
    let mut i = 0;
    while i < a.len() {
        let hi: u32 = if i + 1 < a.len() { a[i + 1] & 1 } else { 0 };
        a[i] = (a[i] >> 1) | (hi << 31);
        i += 1;
    }
    big_trim(mut a);
}

fn big_cmp(a: ref Vec[u32], b: ref Vec[u32]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

// a -= b, where a >= b.
fn big_sub(a: mut ref Vec[u32], b: ref Vec[u32]) {
    let mut borrow: i64 = 0;
    for i in 0..a.len() {
        let bv: i64 = if i < b.len() { b[i] as i64 } else { 0 };
        let mut t = (a[i] as i64) - bv - borrow;
        if t < 0 {
            t += 4294967296;
            borrow = 1;
        } else {
            borrow = 0;
        }
        a[i] = t as u32;
    }
    big_trim(mut a);
}

// ------------------------------------------------------------ decimal to float

// The f64 nearest to digits * 10**exp10, ties to even, as CPython's
// float() gives it. digits holds the digit values without leading zeros.
fn decimal_to_f64(digits: ref Vec[u8], exp10: i64, neg: bool) -> f64 {
    let mut ds = digits.clone();
    let mut e10 = exp10;
    while ds.len() > 0 and ds[ds.len() - 1] == 0 {
        ds.pop();
        e10 += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if ds.len() == 0 {
        return sign * 0.0;
    }
    let n = ds.len();
    if n + e10 > 310 {
        return sign * f64.INFINITY;
    }
    if n + e10 < -330 {
        return sign * 0.0;
    }
    // The digits and the power of ten are exact, so one operation
    // rounds correctly.
    if n <= 15 and e10 >= -22 and e10 <= 22 {
        let mut m: f64 = 0.0;
        for d in ds.iter() {
            m = m * 10.0 + (*d as f64);
        }
        let mut p: f64 = 1.0;
        let mut k = if e10 < 0 { -e10 } else { e10 };
        while k > 0 {
            p *= 10.0;
            k -= 1;
        }
        return sign * (if e10 < 0 { m / p } else { m * p });
    }
    let mut num = big_from_digits(ds);
    let mut den: Vec[u32] = [1];
    if e10 >= 0 {
        num = big_mul(num, big_pow10(e10));
    } else {
        den = big_pow10(-e10);
    }
    // q = floor(num * 2**s / den) with 54 bits: the 53 of the result
    // and one to round on.
    let mut s = 54 - (big_bitlen(num) - big_bitlen(den));
    if s > 1075 {
        s = 1075;
    }
    let mut q: u64 = 0;
    let mut rem: Vec[u32] = Vec.new();
    let mut tries = 0;
    while tries < 2 {
        let mut n2 = if s > 0 { big_shl(num, s) } else { num.clone() };
        let d2 = if s < 0 { big_shl(den, -s) } else { den.clone() };
        let mut dd = big_shl(d2, 55);
        q = 0;
        let mut bit = 55;
        while bit >= 0 {
            if big_cmp(n2, dd) >= 0 {
                big_sub(mut n2, dd);
                q = q | ((1 as u64) << bit);
            }
            big_shr1(mut dd);
            bit -= 1;
        }
        rem = n2;
        if q >= ((1 as u64) << 54) and s < 1075 {
            s -= 1;
            tries += 1;
            continue;
        }
        if q < ((1 as u64) << 53) and s < 1075 {
            s += 1;
            tries += 1;
            continue;
        }
        break;
    }
    let mut mant = q >> 1;
    let round = (q & 1) == 1;
    let sticky = rem.len() > 0;
    if round and (sticky or (mant & 1) == 1) {
        mant += 1;
    }
    // The value is mant * 2**(1 - s).
    let mut e2 = 1 - s;
    if mant == ((1 as u64) << 53) {
        mant = mant >> 1;
        e2 += 1;
    }
    let bits: u64 = if mant < ((1 as u64) << 52) {
        // Subnormal: s is 1075 and the exponent field is zero.
        mant
    } else {
        let biased = e2 + 1075;
        if biased >= 2047 {
            return sign * f64.INFINITY;
        }
        ((biased as u64) << 52) | (mant & (((1 as u64) << 52) - 1))
    };
    sign * bits.bits_as_f64()
}

// ------------------------------------------------------------ float to decimal

fn big_to_digits(a: ref Vec[u32]) -> Vec[char] {
    if a.len() == 0 {
        return ['0'];
    }
    let mut x = a.clone();
    let mut chunks: Vec[u64] = Vec.new();
    while x.len() > 0 {
        let mut rem: u64 = 0;
        let mut i = x.len() - 1;
        while i >= 0 {
            let cur = (rem << 32) | (x[i] as u64);
            x[i] = (cur / 1000000000) as u32;
            rem = cur % 1000000000;
            i -= 1;
        }
        big_trim(mut x);
        chunks.push(rem);
    }
    let mut out: Vec[char] = Vec.new();
    let mut k = chunks.len() - 1;
    while k >= 0 {
        let s = chunks[k].to_string();
        if k < chunks.len() - 1 {
            for _ in 0..(9 - s.len()) {
                out.push('0');
            }
        }
        for c in s.chars() {
            out.push(c);
        }
        k -= 1;
    }
    out
}

// The exact decimal value of a finite, non-negative x: its digits with no
// leading zeros (none for zero) and the decimal exponent of the first.
fn exact_digits(x: f64) -> (Vec[char], i64) {
    let bits = x.to_bits();
    let biased = ((bits >> 52) & 2047) as i64;
    let frac = bits & ((1 as u64 << 52) - 1);
    let m: u64 = if biased == 0 { frac } else { frac | (1 as u64 << 52) };
    let q = if biased == 0 { -1074 } else { biased - 1075 };
    if m == 0 {
        return (Vec.new(), 0);
    }
    let mut a: Vec[u32] = Vec.new();
    big_mul_add(mut a, 1, m);
    let mut e10 = 0;
    if q >= 0 {
        a = big_shl(a, q);
    } else {
        // m * 2**q == m * 5**-q * 10**q
        let mut k = 0;
        while k < -q {
            big_mul_add(mut a, 5, 0);
            k += 1;
        }
        e10 = q;
    }
    let mut d = big_to_digits(a);
    while d.len() > 1 and d[d.len() - 1] == '0' {
        d.pop();
        e10 += 1;
    }
    let n = d.len();
    (d, e10 + n - 1)
}

// The exact digits (d, e) rounded half-to-even to keep the digits whose
// place is at least 10**place: the kept digits (possibly empty when all
// round away) and the exponent of the first.
fn round_place(d: ref Vec[char], e: i64, place: i64) -> (Vec[char], i64) {
    let n = e - place + 1;
    if n >= d.len() {
        return (d.clone(), e);
    }
    if n < 0 {
        return (Vec.new(), place);
    }
    let mut keep: Vec[char] = Vec.new();
    for k in 0..n {
        keep.push(d[k]);
    }
    let first = d[n];
    let mut rest = false;
    for k in (n + 1)..d.len() {
        if d[k] != '0' {
            rest = true;
        }
    }
    let odd = n > 0 and (d[n - 1] as i64 - 48) % 2 == 1;
    let up = first > '5' or (first == '5' and (rest or odd));
    if not up {
        while keep.len() > 0 and keep[keep.len() - 1] == '0' {
            keep.pop();
        }
        if keep.len() == 0 {
            return (Vec.new(), place);
        }
        return (keep, e);
    }
    let mut j = keep.len() - 1;
    while j >= 0 and keep[j] == '9' {
        keep.pop();
        j -= 1;
    }
    if j < 0 {
        return (['1'], e + 1);
    }
    keep[j] = chr(keep[j] as i64 + 1);
    (keep, e)
}

fn digit_vals(d: ref Vec[char]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for c in d.iter() {
        v.push((*c as i64 - 48) as u8);
    }
    v
}

// The shortest digits that read back as x (x finite and non-negative).
// A rounding that reads back keeps reading back with more digits, so the
// count is found by bisection.
fn shortest_digits(x: f64) -> (Vec[char], i64) {
    let (d, e) = exact_digits(x);
    if d.len() == 0 {
        return (['0'], 0);
    }
    let mut lo = 1;
    let mut hi = 17;
    while lo < hi {
        let p = (lo + hi) / 2;
        let (r, re) = round_place(d, e, e - p + 1);
        if r.len() > 0 and decimal_to_f64(digit_vals(r), re - r.len() + 1, false) == x {
            hi = p;
        } else {
            lo = p + 1;
        }
    }
    round_place(d, e, e - lo + 1)
}

fn exp_text(e: i64, upper: bool) -> String {
    let mark = if upper { 'E' } else { 'e' };
    let sign = if e < 0 { '-' } else { '+' };
    let a = if e < 0 { -e } else { e };
    if a < 10 {
        f"{mark}{sign}0{a}"
    } else {
        f"{mark}{sign}{a}"
    }
}

fn is_neg(x: f64) -> bool {
    (x.to_bits() >> 63) == 1
}

// repr(float).
fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    let sign = if is_neg(x) { "-" } else { "" };
    let a = if is_neg(x) { -x } else { x };
    if a == f64.INFINITY {
        return f"{sign}inf";
    }
    let (d, e) = shortest_digits(a);
    let decpt = e + 1;
    let mut s = sign.to_string();
    if decpt <= -4 or decpt > 16 {
        s.push(d[0]);
        if d.len() > 1 {
            s.push('.');
            s.push_str(text(d, 1, d.len()));
        }
        s.push_str(exp_text(e, false));
    } else if decpt <= 0 {
        s.push_str("0.");
        s.push_str(repeat('0', -decpt));
        s.push_str(text(d, 0, d.len()));
    } else if decpt >= d.len() {
        s.push_str(text(d, 0, d.len()));
        s.push_str(repeat('0', decpt - d.len()));
        s.push_str(".0");
    } else {
        s.push_str(text(d, 0, decpt));
        s.push('.');
        s.push_str(text(d, decpt, d.len()));
    }
    s
}

// x (finite, non-negative) with `precision` digits after the point, as
// '%.Nf' writes it: the integer digits and the fraction (with its point).
fn fixed_text(x: f64, precision: i64, alt: bool) -> (String, String) {
    let (d, e) = exact_digits(x);
    let (r, re) = if d.len() == 0 { (Vec.new(), 0) } else { round_place(d, e, -precision) };
    // the digit at place p (0 when outside r)
    let mut int_part = String.new();
    if r.len() == 0 or re < 0 {
        int_part.push('0');
    } else {
        for i in 0..(re + 1) {
            int_part.push(if i < r.len() { r[i] } else { '0' });
        }
    }
    let mut frac = String.new();
    if precision > 0 or alt {
        frac.push('.');
    }
    for p in 1..(precision + 1) {
        let k = re + p;
        frac.push(if r.len() > 0 and k >= 0 and k < r.len() { r[k] } else { '0' });
    }
    (int_part, frac)
}

// x (finite, non-negative) as '%.Ne' writes it.
fn sci_text(x: f64, precision: i64, alt: bool, upper: bool) -> (String, String) {
    let (d, e) = exact_digits(x);
    let (r, re) = if d.len() == 0 { (['0'], 0) } else { round_place(d, e, e - precision) };
    let mut frac = String.new();
    if precision > 0 or alt {
        frac.push('.');
    }
    for k in 1..(precision + 1) {
        frac.push(if k < r.len() { r[k] } else { '0' });
    }
    frac.push_str(exp_text(re, upper));
    (r[0].to_string(), frac)
}

// ------------------------------------------------------------ float() and int() of a str

// A float literal's text (digits, a point, an exponent) to the nearest
// f64.
fn parse_float_text(t: ref Vec[char], neg: bool) -> f64 {
    let mut digits: Vec[u8] = Vec.new();
    let mut exp10: i64 = 0;
    let mut i = 0;
    let mut point = false;
    while i < t.len() {
        let c = t[i];
        if is_digit(c) {
            let d = (c as i64 - 48) as u8;
            if digits.len() > 0 or d != 0 {
                digits.push(d);
            }
            if point {
                exp10 -= 1;
            }
        } else if c == '.' {
            point = true;
        } else if c == 'e' or c == 'E' {
            let mut j = i + 1;
            let mut eneg = false;
            if j < t.len() and (t[j] == '+' or t[j] == '-') {
                eneg = t[j] == '-';
                j += 1;
            }
            let mut ev = 0;
            while j < t.len() {
                ev = ev * 10 + (t[j] as i64 - 48);
                if ev > 100000 {
                    ev = 100000;
                }
                j += 1;
            }
            exp10 += if eneg { -ev } else { ev };
            break;
        }
        i += 1;
    }
    decimal_to_f64(digits, exp10, neg)
}


fn strip_space(cs: ref Vec[char]) -> Vec[char] {
    let mut a = 0;
    let mut b = cs.len();
    while a < b and py_space(cs[a]) {
        a += 1;
    }
    while b > a and py_space(cs[b - 1]) {
        b -= 1;
    }
    cs[a..b].to_vec()
}

// int(s): whitespace, a sign, digits with single underscores between.
fn py_int_str(s: ref Vec[char]) -> Option[i64] {
    let t = strip_space(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i >= t.len() {
        return None;
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if c == '_' {
            if not prev_digit or i + 1 == t.len() {
                return None;
            }
            prev_digit = false;
        } else if is_digit(c) {
            v = v * 10 + (c as i64 - 48);
            prev_digit = true;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

// float(s): whitespace, a sign, then inf, infinity, nan, or a decimal
// number with single underscores between digits.
fn py_float_str(s: ref Vec[char]) -> Option[f64] {
    let t = strip_space(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    let mut word = String.new();
    for k in i..t.len() {
        word.push(ascii_lower(t[k]));
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if word == "inf" or word == "infinity" {
        return Some(sign * f64.INFINITY);
    }
    if word == "nan" {
        return Some(f64.INFINITY - f64.INFINITY);
    }
    let mut body: Vec[char] = Vec.new();
    let mut seen = false;
    let mut point = false;
    let mut exp = false;
    let mut exp_digit = false;
    while i < t.len() {
        let c = t[i];
        if is_digit(c) {
            if exp {
                exp_digit = true;
            } else {
                seen = true;
            }
        } else if c == '.' and not point and not exp {
            point = true;
        } else if (c == 'e' or c == 'E') and seen and not exp {
            exp = true;
        } else if (c == '+' or c == '-') and exp and (t[i - 1] == 'e' or t[i - 1] == 'E') {
        } else if c == '_' and i > 0 and i + 1 < t.len() and is_digit(t[i - 1]) and is_digit(t[i + 1]) {
            i += 1;
            continue;
        } else {
            return None;
        }
        body.push(c);
        i += 1;
    }
    if not seen or (exp and not exp_digit) {
        return None;
    }
    Some(parse_float_text(body, neg))
}

// '%.*f' % (n, x)
fn fmt_fixed(x: f64, n: i64) -> String {
    if x != x {
        return "nan".to_string();
    }
    let sign = if is_neg(x) { "-" } else { "" };
    let a = if is_neg(x) { -x } else { x };
    if a == f64.INFINITY {
        return f"{sign}inf";
    }
    let (ip, frac) = fixed_text(a, n, false);
    f"{sign}{ip}{frac}"
}

// '%.*e' % (n, x)
fn fmt_sci(x: f64, n: i64) -> String {
    if x != x {
        return "nan".to_string();
    }
    let sign = if is_neg(x) { "-" } else { "" };
    let a = if is_neg(x) { -x } else { x };
    if a == f64.INFINITY {
        return f"{sign}inf";
    }
    let (lead, rest) = sci_text(a, n, false, false);
    f"{sign}{lead}{rest}"
}

// str(int(round(x))) for a finite x: round() ties to even.
fn round_int_text(x: f64) -> String {
    let a = if is_neg(x) { -x } else { x };
    let (ip, _) = fixed_text(a, 0, false);
    if ip == "0" or not is_neg(x) { ip } else { f"-{ip}" }
}

// ------------------------------------------------------------ Python values

enum Val {
    Nil,
    Bool(bool),
    Int(i64),
    // an int too large for i64, as its digits
    Big(String),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
}

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: ref String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.clone() }
}

fn index_error() -> Exc {
    exc("IndexError", "list index out of range")
}

fn reduce_error() -> Exc {
    exc("TypeError", "reduce() of empty iterable with no initial value")
}

// ascii(v)
fn show(v: ref Val) -> String {
    match v {
        Val.Nil => "None".to_string(),
        Val.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => n.to_string(),
        Val.Big(d) => d.clone(),
        Val.Float(x) => float_repr(*x),
        Val.Str(s) => py_ascii(s),
        Val.Bytes(b) => bytes_repr(b),
    }
}

fn show_list(vs: ref Vec[Val]) -> String {
    let mut out = "[".to_string();
    for i in 0..vs.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(show(vs[i]));
    }
    out.push(']');
    out
}

// str(v) for anything but bytes, which obj2unicode decodes.
fn py_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => show(v),
    }
}

fn py_bool(v: ref Val) -> bool {
    match v {
        Val.Nil => false,
        Val.Bool(b) => *b,
        Val.Int(n) => *n != 0,
        Val.Big(_) => true,
        Val.Float(x) => *x != 0.0,
        Val.Str(s) => not s.is_empty(),
        Val.Bytes(b) => not b.is_empty(),
    }
}

// A str with its decimal digits (any script) as ASCII digits, as float()
// and int() read it. `ds` holds the runs of digits from width_text().
fn ascii_digits(s: ref String, ds: ref Vec[(i64, i64)]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for c in s.chars() {
        let n = c as i64;
        let mut d = c;
        if n >= 0x80 {
            for r in ds.iter() {
                let (lo, hi) = *r;
                if n >= lo and n <= hi {
                    d = chr(48 + n - lo);
                    break;
                }
            }
        }
        out.push(d);
    }
    out
}

// float(v), or None where texttable falls back to text (None, or a str or
// bytes that float() refuses).
fn to_float(v: ref Val, ds: ref Vec[(i64, i64)]) -> Option[f64] {
    match v {
        Val.Nil => None,
        Val.Bool(b) => Some(if *b { 1.0 } else { 0.0 }),
        Val.Int(n) => Some(*n as f64),
        Val.Big(d) => py_float_str(to_chars(d)),
        Val.Float(x) => Some(*x),
        Val.Str(s) => py_float_str(ascii_digits(s, ds)),
        Val.Bytes(b) => {
            let mut cs: Vec[char] = Vec.new();
            for x in b {
                cs.push(chr(*x as i64));
            }
            py_float_str(cs)
        }
    }
}

// int(v), as set_cols_width calls it.
fn to_int(v: ref Val, ds: ref Vec[(i64, i64)]) -> Result[i64, Exc] {
    match v {
        Val.Nil => Err(exc("TypeError", "int() argument must be a string, a bytes-like object or a real number, not 'NoneType'")),
        Val.Bool(b) => Ok(if *b { 1 } else { 0 }),
        Val.Int(n) => Ok(*n),
        // Not reached by the jobs: widths never hold an int this large.
        Val.Big(d) => Err(exc("OverflowError", f"int too large: {d}")),
        Val.Float(x) => {
            if *x != *x {
                Err(exc("ValueError", "cannot convert float NaN to integer"))
            } else if *x == f64.INFINITY or *x == -f64.INFINITY {
                Err(exc("OverflowError", "cannot convert float infinity to integer"))
            } else {
                Ok(*x as i64)
            }
        }
        Val.Str(s) => match py_int_str(ascii_digits(s, ds)) {
            Some(n) => Ok(n),
            None => Err(exc("ValueError", f"invalid literal for int() with base 10: {py_ascii(s)}")),
        },
        Val.Bytes(b) => {
            let mut cs: Vec[char] = Vec.new();
            for x in b {
                cs.push(chr(*x as i64));
            }
            match py_int_str(cs) {
                Some(n) => Ok(n),
                None => Err(exc("ValueError", f"invalid literal for int() with base 10: {bytes_repr(b)}")),
            }
        }
    }
}

// ------------------------------------------------------------ display width

// The fallback uchar_width: 2 for East Asian Wide and Fullwidth, 0 for a
// combining character, 1 otherwise. The ranges come from width_text().
struct Uni {
    wide: Vec[(i64, i64)],
    zero: Vec[(i64, i64)],
    digits: Vec[(i64, i64)],
}

fn load_uni() -> Uni {
    let mut u = Uni { wide: Vec.new(), zero: Vec.new(), digits: Vec.new() };
    for line in split_char(width_text(), '\n') {
        let f = split_char(line, ' ');
        if f.len() != 3 {
            continue;
        }
        let lo = hex_int(f[1]);
        let hi = hex_int(f[2]);
        if f[0] == "w" {
            u.wide.push((lo, hi));
        } else if f[0] == "d" {
            u.digits.push((lo, hi));
        } else {
            u.zero.push((lo, hi));
        }
    }
    u
}

fn hex_int(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_val(c);
    }
    v
}

fn in_ranges(rs: ref Vec[(i64, i64)], n: i64) -> bool {
    let mut lo = 0;
    let mut hi = rs.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (a, b) = rs[mid];
        if n < a {
            hi = mid;
        } else if n > b {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
}

fn uchar_width(u: ref Uni, c: char) -> i64 {
    let n = c as i64;
    if in_ranges(u.wide, n) {
        2
    } else if in_ranges(u.zero, n) {
        0
    } else {
        1
    }
}

// texttable's own len() for a str: the sum of the widths.
fn disp_len(u: ref Uni, s: ref String) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        n += uchar_width(u, c);
    }
    n
}

// ------------------------------------------------------------ textwrap.wrap(text, width)
//
// The defaults only: tabs expand to 8, whitespace becomes spaces, long
// words break (at a hyphen when one fits), and lines drop their outer
// whitespace. Widths count code points, as textwrap does.

fn is_ws(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\u{b}' or c == '\u{c}' or c == '\r'
}

fn is_word(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

fn is_letter(c: char) -> bool {
    is_word(c) and not c.is_ascii_digit()
}

fn is_word_punct(c: char) -> bool {
    is_word(c) or c == '!' or c == '"' or c == '\'' or c == '&' or c == '.' or c == ',' or c == '?'
}

fn chunk_blank(v: ref Vec[char]) -> bool {
    v.iter().all(|c| py_space(*c))
}

fn munge(t: ref Vec[char]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    let mut col = 0;
    for c in t.iter() {
        if *c == '\t' {
            let incr = 8 - col % 8;
            for _ in 0..incr {
                out.push(' ');
            }
            col += incr;
        } else if *c == '\n' or *c == '\r' {
            out.push(' ');
            col = 0;
        } else if is_ws(*c) {
            out.push(' ');
            col += 1;
        } else {
            out.push(*c);
            col += 1;
        }
    }
    out
}

fn em_dash_at(t: ref Vec[char], i: i64) -> Option[i64] {
    if i == 0 or not is_word_punct(t[i - 1]) {
        return None;
    }
    let mut k = i;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    if k - i >= 2 and k < t.len() and is_word(t[k]) {
        Some(k)
    } else {
        None
    }
}

fn dashes_then_word(t: ref Vec[char], j: i64) -> bool {
    let mut k = j;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    k - j >= 2 and k < t.len() and is_word(t[k])
}

// The word alternative of wordsep_re at i: the lazy \S+? grows until one
// of its three endings matches.
fn word_end(t: ref Vec[char], i: i64) -> i64 {
    let n = t.len();
    let mut j = i + 1;
    loop {
        if j < n and t[j] == '-' {
            let behind = (j >= 2 and is_letter(t[j - 2]) and is_letter(t[j - 1]))
                or (j >= 3 and is_letter(t[j - 3]) and t[j - 2] == '-' and is_letter(t[j - 1]));
            let ahead = j + 1 < n and is_letter(t[j + 1])
                and ((j + 2 < n and is_letter(t[j + 2])) or (j + 3 < n and t[j + 2] == '-' and is_letter(t[j + 3])));
            if behind and ahead {
                return j + 1;
            }
        }
        if j == n or is_ws(t[j]) {
            return j;
        }
        if is_word_punct(t[j - 1]) and dashes_then_word(t, j) {
            return j;
        }
        j += 1;
    }
}

fn split_chunks(t: ref Vec[char]) -> Vec[Vec[char]] {
    let n = t.len();
    let mut chunks: Vec[Vec[char]] = Vec.new();
    let mut i = 0;
    while i < n {
        let mut end = i;
        if is_ws(t[i]) {
            while end < n and is_ws(t[end]) {
                end += 1;
            }
        } else {
            end = match em_dash_at(t, i) {
                Some(e) => e,
                None => word_end(t, i),
            };
        }
        chunks.push(t[i..end].to_vec());
        i = end;
    }
    chunks
}

fn handle_long_word(rev: mut ref Vec[Vec[char]], cur_line: mut ref Vec[Vec[char]], cur_len: i64, width: i64) {
    let space_left = if width < 1 { 1 } else { width - cur_len };
    let mut end = space_left;
    let last = rev.len() - 1;
    let chunk = rev[last].clone();
    if chunk.len() > space_left {
        let mut hyphen = -1;
        let mut k = space_left;
        while k > 0 {
            k -= 1;
            if chunk[k] == '-' {
                hyphen = k;
                break;
            }
        }
        if hyphen > 0 and chunk[0..hyphen].iter().any(|c| *c != '-') {
            end = hyphen + 1;
        }
    }
    if end > chunk.len() {
        end = chunk.len();
    }
    cur_line.push(chunk[0..end].to_vec());
    rev[last] = chunk[end..].to_vec();
}

fn wrap(s: ref String, width: i64) -> Result[Vec[String], Exc] {
    if width <= 0 {
        return Err(exc("ValueError", f"invalid width {width} (must be > 0)"));
    }
    let mut rev = split_chunks(munge(to_chars(s)));
    rev.reverse();
    let mut lines: Vec[String] = Vec.new();
    while not rev.is_empty() {
        let mut cur_line: Vec[Vec[char]] = Vec.new();
        let mut cur_len = 0;
        if chunk_blank(rev[rev.len() - 1]) and not lines.is_empty() {
            rev.pop();
        }
        while not rev.is_empty() {
            let l = rev[rev.len() - 1].len();
            if cur_len + l <= width {
                cur_line.push(rev.pop().unwrap());
                cur_len += l;
            } else {
                break;
            }
        }
        if not rev.is_empty() and rev[rev.len() - 1].len() > width {
            handle_long_word(mut rev, mut cur_line, cur_len, width);
        }
        if not cur_line.is_empty() and chunk_blank(cur_line[cur_line.len() - 1]) {
            cur_line.pop();
        }
        if cur_line.is_empty() {
            continue;
        }
        let mut line = String.new();
        for ch in cur_line.iter() {
            for c in ch.iter() {
                line.push(*c);
            }
        }
        lines.push(line);
    }
    Ok(lines)
}

// ------------------------------------------------------------ Texttable

const BORDER: i64 = 1;
const HEADER: i64 = 2;
const HLINES: i64 = 4;
const VLINES: i64 = 8;

// A cell format that cannot read its value as a float raises
// FallbackToText, and the cell is formatted as text instead.
enum Fmt {
    Done(String),
    Fallback,
}

struct Table {
    // 0 when unlimited (texttable stores False)
    max_width: i64,
    precision: i64,
    deco: i64,
    horiz: String,
    vert: String,
    corner: String,
    head: String,
    row_size: Option[i64],
    header: Vec[String],
    rows: Vec[Vec[String]],
    // attributes texttable only has once they are set (hasattr)
    header_align: Option[Vec[String]],
    align: Option[Vec[String]],
    valign: Option[Vec[String]],
    dtype: Option[Vec[String]],
    width_explicit: Option[Vec[i64]],
    // what the library writes to sys.stderr
    stderr: Vec[String],
    // the decimal digit runs, for float() and int()
    digits: Vec[(i64, i64)],
}

fn strs(vs: ref Vec[Val]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for v in vs.iter() {
        out.push(py_str(v));
    }
    out
}

fn first_char(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        out.push(c);
        break;
    }
    out
}

fn min3(a: i64, b: i64, c: i64) -> i64 {
    let m = if a < b { a } else { b };
    if m < c { m } else { c }
}

impl Table {
    fn new(max_width: i64, u: ref Uni) -> Table {
        Table {
            max_width: if max_width > 0 { max_width } else { 0 },
            precision: 3,
            deco: VLINES | HLINES | BORDER | HEADER,
            horiz: "-".to_string(),
            vert: "|".to_string(),
            corner: "+".to_string(),
            head: "=".to_string(),
            row_size: None,
            header: Vec.new(),
            rows: Vec.new(),
            header_align: None,
            align: None,
            valign: None,
            dtype: None,
            width_explicit: None,
            stderr: Vec.new(),
            digits: u.digits.clone(),
        }
    }

    fn reset(mut ref self) {
        self.row_size = None;
        self.header = Vec.new();
        self.rows = Vec.new();
    }

    fn check_row_size(mut ref self, n: i64) -> Result[(), Exc] {
        match self.row_size {
            Some(r) => {
                if r == 0 {
                    self.row_size = Some(n);
                } else if r != n {
                    return Err(exc("ArraySizeError", f"array should contain {r} elements"));
                }
            }
            None => {
                self.row_size = Some(n);
            }
        }
        Ok(())
    }

    fn set_chars(mut ref self, vs: ref Vec[Val]) -> Result[(), Exc] {
        if vs.len() != 4 {
            return Err(exc("ArraySizeError", "array should contain 4 characters"));
        }
        self.horiz = first_char(py_str(vs[0]));
        self.vert = first_char(py_str(vs[1]));
        self.corner = first_char(py_str(vs[2]));
        self.head = first_char(py_str(vs[3]));
        Ok(())
    }

    fn set_cols_width(mut ref self, vs: ref Vec[Val]) -> Result[(), Exc] {
        self.check_row_size(vs.len())?;
        let mut ws: Vec[i64] = Vec.new();
        for v in vs.iter() {
            match to_int(v, self.digits) {
                Ok(n) => ws.push(n),
                Err(e) => {
                    if e.kind == "ValueError" {
                        self.stderr.push("Wrong argument in column width specification".to_string());
                    }
                    return Err(e);
                }
            }
        }
        if ws.is_empty() {
            return Err(reduce_error());
        }
        let mut m = ws[0];
        for w in ws.iter() {
            if *w < m {
                m = *w;
            }
        }
        if m <= 0 {
            self.stderr.push("Wrong argument in column width specification".to_string());
            return Err(exc("ValueError", ""));
        }
        self.width_explicit = Some(ws);
        Ok(())
    }

    fn set_precision(mut ref self, v: ref Val) -> Result[(), Exc] {
        match v {
            Val.Int(n) => {
                if *n >= 0 {
                    self.precision = *n;
                    return Ok(());
                }
            }
            _ => {}
        }
        Err(exc("ValueError", "width must be an integer greater then 0"))
    }

    // obj2unicode
    fn obj2unicode(mut ref self, v: ref Val) -> String {
        match v {
            Val.Bytes(b) => {
                let (s, bad) = decode_utf8(b);
                if let Some(msg) = bad {
                    self.stderr.push(f"UnicodeDecodeError exception for string '{bytes_repr(b)}': {msg}");
                }
                s
            }
            _ => py_str(v),
        }
    }

    fn set_header(mut ref self, vs: ref Vec[Val]) -> Result[(), Exc] {
        self.check_row_size(vs.len())?;
        let mut h: Vec[String] = Vec.new();
        for v in vs.iter() {
            h.push(self.obj2unicode(v));
        }
        self.header = h;
        Ok(())
    }

    fn fmt_int(ref self, x: ref Val) -> Result[Fmt, Exc] {
        match x {
            Val.Int(n) => return Ok(Fmt.Done(n.to_string())),
            Val.Big(d) => return Ok(Fmt.Done(d.clone())),
            _ => {}
        }
        let f = match to_float(x, self.digits) {
            Some(f) => f,
            None => return Ok(Fmt.Fallback),
        };
        if f != f {
            return Err(exc("ValueError", "cannot convert float NaN to integer"));
        }
        if f == f64.INFINITY or f == -f64.INFINITY {
            return Err(exc("OverflowError", "cannot convert float infinity to integer"));
        }
        Ok(Fmt.Done(round_int_text(f)))
    }

    fn fmt_float(ref self, x: ref Val) -> Fmt {
        match to_float(x, self.digits) {
            Some(f) => Fmt.Done(fmt_fixed(f, self.precision)),
            None => Fmt.Fallback,
        }
    }

    fn fmt_exp(ref self, x: ref Val) -> Fmt {
        match to_float(x, self.digits) {
            Some(f) => Fmt.Done(fmt_sci(f, self.precision)),
            None => Fmt.Fallback,
        }
    }

    fn fmt_bool(ref self, x: ref Val) -> Fmt {
        Fmt.Done(if py_bool(x) { "True".to_string() } else { "False".to_string() })
    }

    fn fmt_auto(mut ref self, x: ref Val) -> Result[Fmt, Exc] {
        let f = match to_float(x, self.digits) {
            Some(f) => f,
            None => return Ok(Fmt.Fallback),
        };
        let a = if f < 0.0 { -f } else { f };
        if a > 100000000.0 {
            Ok(self.fmt_exp(x))
        } else if f != f {
            Ok(Fmt.Done(self.obj2unicode(x)))
        } else if (f as i64) as f64 == f {
            match x {
                Val.Bool(_) => Ok(self.fmt_bool(x)),
                _ => self.fmt_int(x),
            }
        } else {
            Ok(self.fmt_float(x))
        }
    }

    // _str
    fn cell_text(mut ref self, i: i64, x: ref Val) -> Result[String, Exc] {
        let dtype = match self.dtype {
            Some(d) => {
                if i >= d.len() {
                    return Err(index_error());
                }
                d[i].clone()
            }
            None => "a".to_string(),
        };
        let r = if dtype == "a" {
            self.fmt_auto(x)?
        } else if dtype == "i" {
            self.fmt_int(x)?
        } else if dtype == "b" {
            self.fmt_bool(x)
        } else if dtype == "f" {
            self.fmt_float(x)
        } else if dtype == "e" {
            self.fmt_exp(x)
        } else if dtype == "t" {
            Fmt.Done(self.obj2unicode(x))
        } else {
            return Err(exc("KeyError", py_ascii(dtype)));
        };
        match r {
            Fmt.Done(s) => Ok(s),
            Fmt.Fallback => Ok(self.obj2unicode(x)),
        }
    }

    fn add_row(mut ref self, vs: ref Vec[Val]) -> Result[(), Exc] {
        self.check_row_size(vs.len())?;
        if self.dtype.is_none() {
            let n = self.row_size.unwrap_or(0);
            let mut d: Vec[String] = Vec.new();
            for _ in 0..n {
                d.push("a".to_string());
            }
            self.dtype = Some(d);
        }
        let mut cells: Vec[String] = Vec.new();
        for i in 0..vs.len() {
            cells.push(self.cell_text(i, vs[i])?);
        }
        self.rows.push(cells);
        Ok(())
    }

    fn add_rows(mut ref self, rs: ref Vec[Vec[Val]], header: bool) -> Result[(), Exc] {
        let mut start = 0;
        if header {
            if rs.is_empty() {
                return Err(index_error());
            }
            self.set_header(rs[0])?;
            start = 1;
        }
        for k in start..rs.len() {
            self.add_row(rs[k])?;
        }
        Ok(())
    }

    fn has_vlines(ref self) -> bool {
        self.deco & VLINES > 0
    }

    fn has_hlines(ref self) -> bool {
        self.deco & HLINES > 0
    }

    fn has_border(ref self) -> bool {
        self.deco & BORDER > 0
    }

    fn has_header(ref self) -> bool {
        self.deco & HEADER > 0
    }

    fn build_hline(ref self, width: ref Vec[i64], is_header: bool) -> String {
        let horiz = if is_header { self.head.clone() } else { self.horiz.clone() };
        let mid = if self.has_vlines() { self.corner.clone() } else { horiz.clone() };
        let sep = f"{horiz}{mid}{horiz}";
        let mut l = String.new();
        for k in 0..width.len() {
            if k > 0 {
                l.push_str(sep);
            }
            l.push_str(repeat_str(horiz, width[k]));
        }
        if self.has_border() {
            f"{self.corner}{horiz}{l}{horiz}{self.corner}\n"
        } else {
            f"{l}\n"
        }
    }

    fn len_cell(ref self, u: ref Uni, cell: ref String) -> i64 {
        let mut maxi = 0;
        for line in split_char(cell, '\n') {
            let mut length = 0;
            let parts = split_char(line, '\t');
            for i in 0..parts.len() {
                length += disp_len(u, parts[i]);
                if i + 1 < parts.len() {
                    length = (length / 8 + 1) * 8;
                }
            }
            if length > maxi {
                maxi = length;
            }
        }
        maxi
    }

    fn compute_cols_width(ref self, u: ref Uni) -> Result[Vec[i64], Exc] {
        let mut maxi: Vec[i64] = Vec.new();
        for h in self.header.iter() {
            maxi.push(self.len_cell(u, h));
        }
        for row in self.rows.iter() {
            for i in 0..row.len() {
                let w = self.len_cell(u, row[i]);
                if i < maxi.len() {
                    if w > maxi[i] {
                        maxi[i] = w;
                    }
                } else {
                    maxi.push(w);
                }
            }
        }
        let ncols = maxi.len();
        let mut content = 0;
        for m in maxi.iter() {
            content += *m;
        }
        let deco_width = 3 * (ncols - 1) + if self.has_border() { 4 } else { 0 };
        if self.max_width > 0 and content + deco_width > self.max_width {
            if self.max_width < ncols + deco_width {
                return Err(exc("ValueError", "max_width too low to render data"));
            }
            let mut available = self.max_width - deco_width;
            let mut newmaxi: Vec[i64] = Vec.new();
            for _ in 0..ncols {
                newmaxi.push(0);
            }
            let mut i = 0;
            while available > 0 {
                if newmaxi[i] < maxi[i] {
                    newmaxi[i] += 1;
                    available -= 1;
                }
                i = (i + 1) % ncols;
            }
            maxi = newmaxi;
        }
        Ok(maxi)
    }

    fn splitit(ref self, line: ref Vec[String], isheader: bool, width: ref Vec[i64]) -> Result[Vec[Vec[String]], Exc] {
        let mut wrapped: Vec[Vec[String]] = Vec.new();
        let n = if line.len() < width.len() { line.len() } else { width.len() };
        for k in 0..n {
            let mut array: Vec[String] = Vec.new();
            for c in split_char(line[k], '\n') {
                if is_blank(c) {
                    array.push(String.new());
                } else {
                    for piece in wrap(c, width[k])? {
                        array.push(piece.clone());
                    }
                }
            }
            wrapped.push(array);
        }
        if wrapped.is_empty() {
            return Err(reduce_error());
        }
        let mut most = 0;
        for cell in wrapped.iter() {
            if cell.len() > most {
                most = cell.len();
            }
        }
        let valign = self.valign.clone().unwrap_or(Vec.new());
        let m = if wrapped.len() < valign.len() { wrapped.len() } else { valign.len() };
        for k in 0..m {
            let va = if isheader { "t".to_string() } else { valign[k].clone() };
            let missing = most - wrapped[k].len();
            let mut cell: Vec[String] = Vec.new();
            let (before, after) = if va == "m" {
                (missing / 2, missing / 2 + missing % 2)
            } else if va == "b" {
                (missing, 0)
            } else {
                (0, missing)
            };
            for _ in 0..before {
                cell.push(String.new());
            }
            for s in wrapped[k].iter() {
                cell.push(s.clone());
            }
            for _ in 0..after {
                cell.push(String.new());
            }
            wrapped[k] = cell;
        }
        Ok(wrapped)
    }

    fn draw_line(ref self, u: ref Uni, line: ref Vec[String], isheader: bool, width: ref Vec[i64]) -> Result[String, Exc] {
        let cells = self.splitit(line, isheader, width)?;
        let align = self.align.clone().unwrap_or(Vec.new());
        let header_align = self.header_align.clone().unwrap_or(Vec.new());
        let mut out = String.new();
        let n = min3(cells.len(), width.len(), align.len());
        for i in 0..cells[0].len() {
            if self.has_border() {
                out.push_str(f"{self.vert} ");
            }
            let mut length = 0;
            for k in 0..n {
                length += 1;
                if i >= cells[k].len() {
                    return Err(index_error());
                }
                let cell_line = cells[k][i].clone();
                let fill = width[k] - disp_len(u, cell_line);
                let al = if isheader {
                    if length - 1 >= header_align.len() {
                        return Err(index_error());
                    }
                    header_align[length - 1].clone()
                } else {
                    align[k].clone()
                };
                let pad = if fill > 0 { fill } else { 0 };
                if al == "r" {
                    out.push_str(repeat(' ', pad));
                    out.push_str(cell_line);
                } else if al == "c" {
                    out.push_str(repeat(' ', pad / 2));
                    out.push_str(cell_line);
                    out.push_str(repeat(' ', pad - pad / 2));
                } else {
                    out.push_str(cell_line);
                    out.push_str(repeat(' ', pad));
                }
                if length < cells.len() {
                    if self.has_vlines() {
                        out.push_str(f" {self.vert} ");
                    } else {
                        out.push_str("   ");
                    }
                }
            }
            if self.has_border() {
                out.push_str(f" {self.vert}");
            }
            out.push('\n');
        }
        Ok(out)
    }

    fn check_align(mut ref self) {
        let n = self.row_size.unwrap_or(0);
        if self.header_align.is_none() {
            self.header_align = Some(filled("c", n));
        }
        if self.align.is_none() {
            self.align = Some(filled("l", n));
        }
        if self.valign.is_none() {
            self.valign = Some(filled("t", n));
        }
    }

    fn draw(mut ref self, u: ref Uni) -> Result[Option[String], Exc] {
        if self.header.is_empty() and self.rows.is_empty() {
            return Ok(None);
        }
        let width = match self.width_explicit {
            Some(w) => w.clone(),
            None => self.compute_cols_width(u)?,
        };
        self.check_align();
        let mut hline: Option[String] = None;
        let mut out = String.new();
        if self.has_border() {
            let h = self.build_hline(width, false);
            out.push_str(h);
            hline = Some(h);
        }
        if not self.header.is_empty() {
            out.push_str(self.draw_line(u, self.header, true, width)?);
            if self.has_header() {
                out.push_str(self.build_hline(width, true));
            }
        }
        let mut length = 0;
        for row in self.rows.iter() {
            length += 1;
            out.push_str(self.draw_line(u, row, false, width)?);
            if self.has_hlines() and length < self.rows.len() {
                if hline.is_none() {
                    hline = Some(self.build_hline(width, false));
                }
                out.push_str(hline.clone().unwrap());
            }
        }
        if self.has_border() {
            if hline.is_none() {
                hline = Some(self.build_hline(width, false));
            }
            out.push_str(hline.clone().unwrap());
        }
        let _ = out.pop();
        Ok(Some(out))
    }
}

fn filled(s: Str, n: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for _ in 0..n {
        out.push(s.to_string());
    }
    out
}

// ------------------------------------------------------------ the jobs

fn decode_val(w: ref String) -> Val {
    if w == "n" {
        return Val.Nil;
    }
    let cs = to_chars(w);
    let t = cs[0];
    let rest = text(cs, 2, cs.len());
    if t == 'b' {
        Val.Bool(rest == "1")
    } else if t == 'i' and rest.len() > 18 {
        Val.Big(rest)
    } else if t == 'i' {
        Val.Int(py_int_str(to_chars(rest)).unwrap())
    } else if t == 'f' {
        Val.Float(py_float_str(to_chars(rest)).unwrap())
    } else if t == 'y' {
        Val.Bytes(hex_bytes(rest))
    } else {
        let (s, _) = decode_utf8(hex_bytes(rest));
        Val.Str(s)
    }
}

fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push('\n');
}

fn run_op(t: mut ref Table, f: ref Vec[String], u: ref Uni, out: mut ref String) -> Result[(), Exc] {
    let name = f[0].clone();
    let mut vals: Vec[Val] = Vec.new();
    if name != "rows" {
        for k in 1..f.len() {
            vals.push(decode_val(f[k]));
        }
    }
    if name == "new" {
        let mut shown = "> new".to_string();
        for v in vals.iter() {
            shown.push(' ');
            shown.push_str(show(v));
        }
        emit(mut out, shown);
        let mw = if vals.is_empty() {
            80
        } else {
            match vals[0] {
                Val.Int(n) => n,
                _ => 80,
            }
        };
        *t = Table.new(mw, u);
        return Ok(());
    }
    if name == "rows" {
        let header = py_bool(decode_val(f[1]));
        let mut rs: Vec[Vec[Val]] = Vec.new();
        if f.len() > 2 {
            rs.push(Vec.new());
            for k in 2..f.len() {
                if f[k] == "/" {
                    rs.push(Vec.new());
                } else {
                    let last = rs.len() - 1;
                    rs[last].push(decode_val(f[k]));
                }
            }
        }
        let mut shown = "[".to_string();
        for k in 0..rs.len() {
            if k > 0 {
                shown.push_str(", ");
            }
            shown.push_str(show_list(rs[k]));
        }
        shown.push(']');
        let hname = if header { "True" } else { "False" };
        emit(mut out, f"> rows header={hname} {shown}");
        return t.add_rows(rs, header);
    }
    if name == "draw" {
        emit(mut out, "> draw");
        match t.draw(u)? {
            None => emit(mut out, "  -> None"),
            Some(s) => {
                for line in split_char(s, '\n') {
                    emit(mut out, f"    {line}");
                }
            }
        }
        return Ok(());
    }
    if name == "reset" {
        emit(mut out, "> reset");
        t.reset();
        return Ok(());
    }
    if name == "max_width" or name == "deco" or name == "precision" {
        emit(mut out, f"> {name} {show(vals[0])}");
        if name == "precision" {
            return t.set_precision(vals[0]);
        }
        let n = match vals[0] {
            Val.Int(n) => n,
            _ => 0,
        };
        if name == "deco" {
            t.deco = n;
        } else {
            t.max_width = if n > 0 { n } else { 0 };
        }
        return Ok(());
    }
    emit(mut out, f"> {name} {show_list(vals)}");
    if name == "chars" {
        t.set_chars(vals)
    } else if name == "width" {
        t.set_cols_width(vals)
    } else if name == "header" {
        t.set_header(vals)
    } else if name == "row" {
        t.add_row(vals)
    } else {
        t.check_row_size(vals.len())?;
        let s = strs(vals);
        if name == "header_align" {
            t.header_align = Some(s);
        } else if name == "align" {
            t.align = Some(s);
        } else if name == "valign" {
            t.valign = Some(s);
        } else {
            t.dtype = Some(s);
        }
        Ok(())
    }
}

fn main() {
    let u = load_uni();
    let mut out = String.new();
    let mut t = Table.new(80, u);
    for line in split_char(jobs_text(), '\n') {
        if line.is_empty() {
            continue;
        }
        let f = split_char(line, '\t');
        if f[0] == "job" {
            emit(mut out, f"== {f[1]}");
            t = Table.new(80, u);
            continue;
        }
        let r = run_op(mut t, f, u, mut out);
        for e in t.stderr.iter() {
            emit(mut out, f"  stderr: {vis(e)}");
        }
        t.stderr = Vec.new();
        if let Err(e) = r {
            let msg = vis(e.msg);
            if msg.is_empty() {
                emit(mut out, f"  error {e.kind}");
            } else {
                emit(mut out, f"  error {e.kind}: {msg}");
            }
        }
    }
    print(out);
}

