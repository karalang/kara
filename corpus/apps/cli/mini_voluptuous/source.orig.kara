// mini_voluptuous: voluptuous 0.15.2, the data validation library Home
// Assistant declares its configuration schemas with, as Python 3.13 runs
// it. A schema is a plain structure: a dict whose keys are strings,
// Required/Optional/Remove/Exclusive/Inclusive markers, classes or
// validators, a list of alternatives, a literal, or a validator. The port
// keeps the library's compile-time `required` (which Any, All and SomeOf
// reset for what they hold), its key candidates in _sort_item order, the
// exclusion and inclusion groups, defaults, extra keys (prevent, allow,
// remove), Self, Schema.extend and Schema.infer, and every validator the
// jobs use: Any, All, SomeOf, Maybe, Msg, Coerce, Boolean, IsTrue,
// IsFalse, Email, Url, FqdnUrl, IsFile, IsDir, PathExists, Match,
// Replace, Range, Clamp, Length, Datetime, Date, In, NotIn, Contains,
// ExactSequence, Unordered, Unique, Equal, Number, the string helpers,
// DefaultTo, SetTo and Literal. Errors keep Invalid's paths, its
// error_type and str(), MultipleInvalid's nesting, and humanize_error's
// sorted "... Got ..." lines. Match, Replace and Email run on the regex
// engine of mini_re (Python's re, ported from _parser.py and sre), and
// Datetime and Date on the _strptime port of mini_parse.
//
// The jobs in data/jobs.jsonl check Home Assistant light and automation
// configurations, web server, compose and feature flag files, a menu
// that holds itself, sign-up forms, invoices and sensor readings, infer
// schemas from three documents, and run every validator at its edges.

// ------------------------------------------------------------ text as code points

fn cps(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps_of(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat_ascii(a: ref Vec[i64], s: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, s);
    out
}

fn index_of(s: ref Vec[i64], c: i64) -> i64 {
    let mut i = 0;
    while i < s.len() {
        if s[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn has(s: ref Vec[i64], c: i64) -> bool {
    index_of(s, c) >= 0
}

// `needle in s` for str
fn contains_seq(s: ref Vec[i64], needle: ref Vec[i64]) -> bool {
    find_seq(s, needle, 0) >= 0
}

fn find_seq(s: ref Vec[i64], needle: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i + needle.len() <= s.len() {
        let mut k = 0;
        while k < needle.len() and s[i + k] == needle[k] {
            k += 1;
        }
        if k == needle.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn starts_with_seq(s: ref Vec[i64], p: Str) -> bool {
    let n = cps(p);
    if n.len() > s.len() {
        return false;
    }
    let mut k = 0;
    while k < n.len() {
        if s[k] != n[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn eq_ascii(s: ref Vec[i64], p: Str) -> bool {
    same(s, cps(p))
}

// One character in a str of ASCII choices.
fn in_ascii(c: i64, set: Str) -> bool {
    for b in set.bytes() {
        if (b as i64) == c {
            return true;
        }
    }
    false
}

// str.replace
fn replace_seq(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if old.len() > 0 and i + old.len() <= s.len() {
            let mut k = 0;
            while k < old.len() and s[i + k] == old[k] {
                k += 1;
            }
            if k == old.len() {
                push_all(mut out, new);
                i += old.len();
                continue;
            }
        }
        out.push(s[i]);
        i += 1;
    }
    out
}

fn replace_char(s: ref Vec[i64], old: i64, new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if c == old {
            push_all(mut out, new);
        } else {
            out.push(c);
        }
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        out.push(c);
        k += 1;
    }
    out
}

// str.split(sep) for a one-character separator
fn split_on(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    while a < b and is_space(s[a], false) {
        a += 1;
    }
    while b > a and is_space(s[b - 1], false) {
        b -= 1;
    }
    slice(s, a, b)
}

fn lower_all(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(lower(c, false));
    }
    out
}

fn upper_all(s: ref Vec[i64]) -> Vec[i64] {
    cps_of(to_string(s).to_uppercase())
}

fn is_alpha_cp(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

// str.isupper
fn is_upper_str(s: ref Vec[i64]) -> bool {
    let mut cased = false;
    for c in s {
        if lower(c, false) != c {
            cased = true;
        } else if upper(c, false) != c {
            return false;
        }
    }
    cased
}

// The value of a decimal digit: the decimal digits come in runs of ten.
fn digit_value(c: i64) -> i64 {
    if c < 0x80 {
        return c - 48;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    0
}

// str.isdigit, for the strings date_convert looks at
fn all_decimal(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if not is_decimal(c) {
            return false;
        }
    }
    true
}

fn pad_n(n: i64, width: i64) -> String {
    let mut s = f"{n}";
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}
// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

// ------------------------------------------------------------ Python values

// An exception as Python prints it: "ValueError: ...".
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: own String) -> PyErr {
    py_err("ValueError", msg)
}

fn err_line(e: ref PyErr) -> String {
    f"{e.kind}: {e.msg}"
}

// A tzinfo: parse's FixedTzOffset (fixed is true, with the name it was
// given), or datetime.timezone from strptime's %z.
#[derive(Clone)]
struct Tz {
    fixed: bool,
    name: Vec[i64],
    // the offset in microseconds east of UTC
    us: i64,
}

#[derive(Clone)]
struct Moment {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
    tz: Option[Tz],
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    f"{x}"
}

// str(timedelta(microseconds=us))
fn td_str(us: i64) -> String {
    let days = floor_div(us, 86400000000);
    let rest = us - days * 86400000000;
    let secs = rest / 1000000;
    let micro = rest % 1000000;
    let mut s = f"{secs / 3600}:{pad_n((secs / 60) % 60, 2)}:{pad_n(secs % 60, 2)}";
    if micro != 0 {
        s = f"{s}.{pad_n(micro, 6)}";
    }
    if days != 0 {
        let plural = if days == 1 or days == -1 { "" } else { "s" };
        s = f"{days} day{plural}, {s}";
    }
    s
}

// repr(timedelta(microseconds=us))
fn td_repr(us: i64) -> String {
    let days = floor_div(us, 86400000000);
    let rest = us - days * 86400000000;
    let secs = rest / 1000000;
    let micro = rest % 1000000;
    let mut parts: Vec[String] = Vec.new();
    if days != 0 {
        parts.push(f"days={days}");
    }
    if secs != 0 {
        parts.push(f"seconds={secs}");
    }
    if micro != 0 {
        parts.push(f"microseconds={micro}");
    }
    if parts.len() == 0 {
        return "datetime.timedelta(0)".to_string();
    }
    f"datetime.timedelta({parts.join(", ")})"
}

// ------------------------------------------------------------ int(), float() and Decimal()

fn bad_int(s: ref Vec[i64], base: i64) -> PyErr {
    value_error(f"invalid literal for int() with base {base}: {repr_of(s)}")
}

// int(s): whitespace around, a sign, and decimal digits of any script
// with single underscores between them.
fn py_int(s: ref Vec[i64]) -> Result[i64, PyErr] {
    let t = strip(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    if i >= t.len() {
        return Err(bad_int(s, 10));
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if is_decimal(c) {
            n = n * 10 + digit_value(c);
            prev_digit = true;
        } else if c == 95 and prev_digit and i + 1 < t.len() and is_decimal(t[i + 1]) {
            prev_digit = false;
        } else {
            return Err(bad_int(s, 10));
        }
        i += 1;
    }
    Ok(if neg { -n } else { n })
}

// ------------------------------------------------------------ the calendar

fn is_leap(y: i64) -> bool {
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
}

fn days_in_month(y: i64, m: i64) -> i64 {
    let dim = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if m == 2 and is_leap(y) { 29 } else { dim[m] }
}

fn days_before_month(y: i64, m: i64) -> i64 {
    let dbm = [0, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    dbm[m] + if m > 2 and is_leap(y) { 1 } else { 0 }
}

fn to_ordinal(y: i64, m: i64, d: i64) -> i64 {
    let y1 = y - 1;
    y1 * 365 + y1 / 4 - y1 / 100 + y1 / 400 + days_before_month(y, m) + d
}

// date.fromordinal
fn from_ordinal(ord: i64) -> (i64, i64, i64) {
    let mut n = ord - 1;
    let n400 = n / 146097;
    n = n % 146097;
    let mut year = n400 * 400 + 1;
    let n100 = n / 36524;
    n = n % 36524;
    let n4 = n / 1461;
    n = n % 1461;
    let n1 = n / 365;
    n = n % 365;
    year += n100 * 100 + n4 * 4 + n1;
    if n1 == 4 or n100 == 4 {
        return (year - 1, 12, 31);
    }
    let leap = n1 == 3 and (n4 != 24 or n100 == 3);
    let dbm = [0, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let dim = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut month = (n + 50) >> 5;
    let mut preceding = dbm[month] + if month > 2 and leap { 1 } else { 0 };
    if preceding > n {
        month -= 1;
        preceding -= dim[month] + if month == 2 and leap { 1 } else { 0 };
    }
    n -= preceding;
    (year, month, n + 1)
}

fn weekday(y: i64, m: i64, d: i64) -> i64 {
    (to_ordinal(y, m, d) + 6) % 7
}

// The checks date() makes, in its order.
fn check_date(y: i64, m: i64, d: i64) -> Result[(), PyErr] {
    if y < 1 or y > 9999 {
        return Err(value_error(f"year {y} is out of range"));
    }
    if m < 1 or m > 12 {
        return Err(value_error("month must be in 1..12".to_string()));
    }
    if d < 1 or d > days_in_month(y, m) {
        return Err(value_error("day is out of range for month".to_string()));
    }
    Ok(())
}

// And the ones time() makes.
fn check_time(h: i64, mi: i64, s: i64, us: i64) -> Result[(), PyErr] {
    if h < 0 or h > 23 {
        return Err(value_error("hour must be in 0..23".to_string()));
    }
    if mi < 0 or mi > 59 {
        return Err(value_error("minute must be in 0..59".to_string()));
    }
    if s < 0 or s > 59 {
        return Err(value_error("second must be in 0..59".to_string()));
    }
    if us < 0 or us > 999999 {
        return Err(value_error("microsecond must be in 0..999999".to_string()));
    }
    Ok(())
}

fn date_iso(y: i64, m: i64, d: i64) -> String {
    f"{pad_n(y, 4)}-{pad_n(m, 2)}-{pad_n(d, 2)}"
}

// datetime.isoformat()
fn dt_iso(t: ref Moment) -> String {
    let mut s = f"{date_iso(t.y, t.mo, t.d)}T{pad_n(t.h, 2)}:{pad_n(t.mi, 2)}:{pad_n(t.s, 2)}";
    if t.us != 0 {
        s = f"{s}.{pad_n(t.us, 6)}";
    }
    if let Some(z) = t.tz {
        let mut off = z.us;
        let mut sign = "+";
        if off < 0 {
            sign = "-";
            off = -off;
        }
        let secs = off / 1000000;
        s = f"{s}{sign}{pad_n(secs / 3600, 2)}:{pad_n((secs / 60) % 60, 2)}";
        if secs % 60 != 0 or off % 1000000 != 0 {
            s = f"{s}:{pad_n(secs % 60, 2)}";
        }
        if off % 1000000 != 0 {
            s = f"{s}.{pad_n(off % 1000000, 6)}";
        }
    }
    s
}

// An aware datetime's instant, in microseconds, for comparisons.
fn dt_instant(t: ref Moment) -> i64 {
    let local = ((to_ordinal(t.y, t.mo, t.d) * 24 + t.h) * 60 + t.mi) * 60 + t.s;
    let off = match t.tz {
        Some(z) => z.us,
        None => 0,
    };
    local * 1000000 + t.us - off
}
// ------------------------------------------------------------ compiled patterns

// Every expression is compiled once; the jobs build many parsers from the
// same few templates.
struct Rx {
    progs: Vec[Program],
    index: Map[String, i64],
}

fn new_rx() -> Rx {
    Rx { progs: Vec.new(), index: Map.new() }
}

fn rx_compile(rx: mut ref Rx, pattern: ref Vec[i64], flags: i64) -> Result[i64, ReErr] {
    let key = f"{flags}:{to_string(pattern)}";
    if let Some(i) = rx.index.get(key) {
        return Ok(i);
    }
    let prog = compile(pattern, flags)?;
    rx.progs.push(prog);
    let i = rx.progs.len() - 1;
    rx.index.insert(key, i);
    Ok(i)
}

fn re_message(e: ref ReErr) -> String {
    if e.pos >= 0 { f"{e.msg} at position {e.pos}" } else { e.msg.clone() }
}

// re.error reaches the caller as re.PatternError, its name since 3.13.
fn pattern_error(e: ref ReErr) -> PyErr {
    if e.kind == "error" {
        return py_err("PatternError", re_message(e));
    }
    py_err(e.kind.as_str(), e.msg.clone())
}

fn flag_ignorecase() -> i64 { 2 }
fn flag_dotall() -> i64 { 16 }

fn group_of(s: ref Vec[i64], m: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(slice(s, a, b)) }
}

fn named_group(prog: ref Program, name: ref Vec[i64]) -> i64 {
    for (n, g) in prog.names.iter() {
        if same(n, name) {
            return *g;
        }
    }
    -1
}

fn is_ascii_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

// ------------------------------------------------------------ _strptime

// LocaleTime in the C locale.
fn f_weekday() -> Vec[Str] {
    vec!["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
}

fn a_weekday() -> Vec[Str] {
    vec!["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
}

fn f_month() -> Vec[Str] {
    vec!["", "january", "february", "march", "april", "may", "june", "july", "august", "september", "october",
        "november", "december"]
}

fn a_month() -> Vec[Str] {
    vec!["", "jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
}

// TimeRE.__seqToRE: longest first, keeping the order of equal lengths.
fn seq_to_re(names: ref Vec[Str], from: i64, directive: Str) -> String {
    let mut order: Vec[Str] = Vec.new();
    let mut k = from;
    while k < names.len() {
        let cur = names[k];
        let mut j = order.len();
        order.push(cur);
        while j > 0 and order[j - 1].len() < cur.len() {
            order[j] = order[j - 1];
            j -= 1;
        }
        order[j] = cur;
        k += 1;
    }
    f"(?P<{directive}>{order.join("|")})"
}

// TimeRE's mapping for a directive, or None where it has none (KeyError).
fn directive_re(key: ref Vec[i64]) -> Option[String] {
    let k = to_string(key);
    let d = "(?P<d>3[0-1]|[1-2]\\d|0[1-9]|[1-9]| [1-9])";
    let h = "(?P<H>2[0-3]|[0-1]\\d|\\d| \\d)";
    let i = "(?P<I>1[0-2]|0[1-9]|[1-9]| [1-9])";
    let u = "(?P<U>5[0-3]|[0-4]\\d|\\d)";
    let r = if k == "d" or k == "e" {
        d.to_string()
    } else if k == "f" {
        "(?P<f>[0-9]{1,6})".to_string()
    } else if k == "H" or k == "k" {
        h.to_string()
    } else if k == "I" or k == "l" {
        i.to_string()
    } else if k == "j" {
        "(?P<j>36[0-6]|3[0-5]\\d|[1-2]\\d\\d|0[1-9]\\d|00[1-9]|[1-9]\\d|0[1-9]|[1-9])".to_string()
    } else if k == "m" {
        "(?P<m>1[0-2]|0[1-9]|[1-9])".to_string()
    } else if k == "M" {
        "(?P<M>[0-5]\\d|\\d)".to_string()
    } else if k == "S" {
        "(?P<S>6[0-1]|[0-5]\\d|\\d)".to_string()
    } else if k == "U" {
        u.to_string()
    } else if k == "W" {
        u.replace("U", "W")
    } else if k == "w" {
        "(?P<w>[0-6])".to_string()
    } else if k == "y" {
        "(?P<y>\\d\\d)".to_string()
    } else if k == "Y" {
        "(?P<Y>\\d\\d\\d\\d)".to_string()
    } else if k == "z" {
        "(?P<z>[+-]\\d\\d:?[0-5]\\d(:?[0-5]\\d(\\.\\d{1,6})?)?|(?-i:Z))".to_string()
    } else if k == "A" {
        seq_to_re(f_weekday(), 0, "A")
    } else if k == "a" {
        seq_to_re(a_weekday(), 0, "a")
    } else if k == "B" {
        seq_to_re(f_month(), 1, "B")
    } else if k == "b" {
        seq_to_re(a_month(), 1, "b")
    } else if k == "p" or k == "P" or k == "Op" {
        seq_to_re(vec!["am", "pm"], 0, "p")
    } else if k == "%" {
        "%".to_string()
    } else if k == "Od" or k == "Oe" or k == "Om" or k == "Oy" or k == "OC" or k == "OH" or k == "OI" or k == "OM"
        or k == "OS" {
        let c = to_string(slice(key, 1, 2));
        let name = if c == "e" { "d".to_string() } else { c };
        f"(?P<{name}>\\d\\d|\\d| \\d)"
    } else if k == "Ow" {
        "(?P<w>\\d)".to_string()
    } else if k == "T" {
        return Some(to_string(time_pattern(cps("%H:%M:%S")).ok()?));
    } else if k == "R" {
        return Some(to_string(time_pattern(cps("%H:%M")).ok()?));
    } else {
        return None;
    };
    Some(r)
}

// TimeRE.pattern; Err holds the directive a KeyError names.
fn time_pattern(format: ref Vec[i64]) -> Result[Vec[i64], Vec[i64]] {
    let mut esc: Vec[i64] = Vec.new();
    for c in format {
        if in_ascii(c, "\\.^$*+?(){}[]|") {
            esc.push(92);
        }
        esc.push(c);
    }
    let mut ws: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < esc.len() {
        if is_space(esc[i], false) {
            while i < esc.len() and is_space(esc[i], false) {
                i += 1;
            }
            push_ascii(mut ws, "\\s+");
            continue;
        }
        if esc[i] == 39 {
            push_all(mut ws, cps("['\u{2bc}]"));
        } else {
            ws.push(esc[i]);
        }
        i += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    i = 0;
    while i < ws.len() {
        if ws[i] != 37 {
            out.push(ws[i]);
            i += 1;
            continue;
        }
        i += 1;
        while i < ws.len() and in_ascii(ws[i], "-_0^#") {
            i += 1;
        }
        while i < ws.len() and is_ascii_digit(ws[i]) {
            i += 1;
        }
        let mut key: Vec[i64] = Vec.new();
        if i < ws.len() and (ws[i] == 79 or ws[i] == 69) {
            key.push(ws[i]);
            i += 1;
        }
        if i < ws.len() and ws[i] == 92 {
            key.push(92);
            i += 1;
        }
        if i < ws.len() and ws[i] != 10 {
            key.push(ws[i]);
            i += 1;
        }
        match directive_re(key) {
            Some(r) => push_all(mut out, cps_of(r)),
            None => return Err(key),
        }
    }
    Ok(out)
}

struct TzOut {
    has: bool,
    secs: i64,
    frac: i64,
}

fn index_in(names: ref Vec[Str], s: ref Vec[i64]) -> i64 {
    let l = to_string(lower_all(s));
    let mut k = 0;
    while k < names.len() {
        if names[k] == l {
            return k;
        }
        k += 1;
    }
    -1
}

// _calc_julian_from_U_or_W
fn julian_from_week(year: i64, week: i64, day_of_week0: i64, starts_mon: bool) -> i64 {
    let mut first = weekday(year, 1, 1);
    let mut dow = day_of_week0;
    if not starts_mon {
        first = (first + 1) % 7;
        dow = (dow + 1) % 7;
    }
    let week0 = (7 - first) % 7;
    if week == 0 {
        return 1 + dow - first;
    }
    1 + week0 + 7 * (week - 1) + dow
}

// datetime.strptime(data, format)
fn strptime(rx: mut ref Rx, data: ref Vec[i64], format: ref Vec[i64]) -> Result[Moment, PyErr] {
    let pattern = match time_pattern(format) {
        Ok(p) => p,
        Err(key) => {
            let bad = replace_seq(key, cps("\\s"), Vec.new());
            if bad.len() == 0 {
                return Err(value_error(f"stray % in format '{to_string(format)}'"));
            }
            let mut b = bad.clone();
            let k = index_of(b, 92);
            if k >= 0 {
                b = cat(slice(b, 0, k), slice(b, k + 1, b.len()));
            }
            return Err(value_error(f"'{to_string(b)}' is a bad directive in format '{to_string(format)}'"));
        }
    };
    let pi = match rx_compile(mut rx, pattern, flag_ignorecase()) {
        Ok(i) => i,
        Err(e) => return Err(pattern_error(e)),
    };
    let found = {
        let prog = ref rx.progs[pi];
        let mut m = new_matcher(prog, data);
        find(mut m, prog, 0, false, 1)
    };
    let f = match found {
        Some(f) => f,
        None => return Err(value_error(f"time data {repr_of(data)} does not match format {repr_of(format)}")),
    };
    if f.end != data.len() {
        return Err(value_error(f"unconverted data remains: {to_string(slice(data, f.end, data.len()))}"));
    }
    let names = rx.progs[pi].names.clone();
    let mut year = -1;
    let mut month = 1;
    let mut day = 1;
    let mut hour = 0;
    let mut minute = 0;
    let mut second = 0;
    let mut fraction = 0;
    let mut tz = TzOut { has: false, secs: 0, frac: 0 };
    let mut week_of_year = -1;
    let mut week_starts = -1;
    let mut wday = -1;
    let mut julian = -1;
    // %p, which %I reads
    let mut ampm: Vec[i64] = Vec.new();
    for (name, g) in names.iter() {
        if eq_ascii(name, "p") {
            if let Some(t) = group_of(data, f, *g) {
                ampm = lower_all(t);
            }
        }
    }
    for (name, g) in names.iter() {
        let t = match group_of(data, f, *g) {
            Some(t) => t,
            None => continue,
        };
        let key = to_string(name);
        if key == "y" {
            year = py_int(t)?;
            year += if year <= 68 { 2000 } else { 1900 };
        } else if key == "Y" {
            year = py_int(t)?;
        } else if key == "m" {
            month = py_int(t)?;
        } else if key == "B" {
            month = index_in(f_month(), t);
        } else if key == "b" {
            month = index_in(a_month(), t);
        } else if key == "d" {
            day = py_int(t)?;
        } else if key == "H" {
            hour = py_int(t)?;
        } else if key == "I" {
            hour = py_int(t)?;
            if ampm.len() == 0 or eq_ascii(ampm, "am") {
                if hour == 12 {
                    hour = 0;
                }
            } else if eq_ascii(ampm, "pm") {
                if hour != 12 {
                    hour += 12;
                }
            }
        } else if key == "M" {
            minute = py_int(t)?;
        } else if key == "S" {
            second = py_int(t)?;
        } else if key == "f" {
            let mut s = t.clone();
            while s.len() < 6 {
                s.push(48);
            }
            fraction = py_int(s)?;
        } else if key == "A" {
            wday = index_in(f_weekday(), t);
        } else if key == "a" {
            wday = index_in(a_weekday(), t);
        } else if key == "w" {
            wday = py_int(t)?;
            wday = if wday == 0 { 6 } else { wday - 1 };
        } else if key == "j" {
            julian = py_int(t)?;
        } else if key == "U" or key == "W" {
            week_of_year = py_int(t)?;
            week_starts = if key == "U" { 6 } else { 0 };
        } else if key == "z" {
            tz = parse_z(t)?;
        }
    }
    let mut leap_year_fix = false;
    if year < 0 {
        if month == 2 and day == 29 {
            year = 1904;
            leap_year_fix = true;
        } else {
            year = 1900;
        }
    }
    if julian < 0 and wday >= 0 and week_of_year >= 0 {
        julian = julian_from_week(year, week_of_year, wday, week_starts == 0);
        if julian <= 0 {
            year -= 1;
            julian += if is_leap(year) { 366 } else { 365 };
        }
    }
    if julian < 0 {
        check_date(year, month, day)?;
    } else {
        check_date(year, 1, 1)?;
        let (yy, mm, dd) = from_ordinal(julian - 1 + to_ordinal(year, 1, 1));
        check_date(yy, mm, dd)?;
        year = yy;
        month = mm;
        day = dd;
    }
    if leap_year_fix {
        year = 1900;
    }
    let mut zone: Option[Tz] = None;
    if tz.has {
        let us = tz.secs * 1000000 + tz.frac;
        if us <= -86400000000 or us >= 86400000000 {
            return Err(value_error(f"offset must be a timedelta strictly between -timedelta(hours=24) and timedelta(hours=24), not {td_repr(us)}."));
        }
        zone = Some(Tz { fixed: false, name: Vec.new(), us: us });
    }
    check_date(year, month, day)?;
    check_time(hour, minute, second, fraction)?;
    Ok(Moment { y: year, mo: month, d: day, h: hour, mi: minute, s: second, us: fraction, tz: zone })
}

fn cut(s: ref Vec[i64], a: i64, b: i64) -> Vec[i64] {
    let lo = if a > s.len() { s.len() } else { a };
    let hi = if b > s.len() { s.len() } else { b };
    if hi <= lo { Vec.new() } else { slice(s, lo, hi) }
}

// The %z branch of _strptime.
fn parse_z(found: ref Vec[i64]) -> Result[TzOut, PyErr] {
    if eq_ascii(found, "Z") {
        return Ok(TzOut { has: true, secs: 0, frac: 0 });
    }
    let mut z = found.clone();
    if z[3] == 58 {
        z = cat(cut(z, 0, 3), cut(z, 4, z.len()));
        if z.len() > 5 {
            if z[5] != 58 {
                return Err(value_error(f"Inconsistent use of : in {to_string(found)}"));
            }
            z = cat(cut(z, 0, 5), cut(z, 6, z.len()));
        }
    }
    let hours = py_int(cut(z, 1, 3))?;
    let minutes = py_int(cut(z, 3, 5))?;
    let sec_text = cut(z, 5, 7);
    let seconds = if sec_text.len() == 0 { 0 } else { py_int(sec_text)? };
    let mut gmtoff = hours * 3600 + minutes * 60 + seconds;
    let mut rem = cut(z, 8, z.len());
    while rem.len() < 6 {
        rem.push(48);
    }
    let mut frac = py_int(rem)?;
    if z[0] == 45 {
        gmtoff = -gmtoff;
        frac = -frac;
    }
    Ok(TzOut { has: true, secs: gmtoff, frac: frac })
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = *g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if *g == 0 { (m.start, m.end) } else { m.spans[*g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}

// float(s) for the strings parse's float patterns match.
fn py_float(s: ref Vec[i64]) -> Result[f64, PyErr] {
    let t = strip(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    let rest = to_string(lower_all(slice(t, i, t.len())));
    if rest == "inf" or rest == "infinity" {
        return Ok(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if rest == "nan" {
        return Ok(0.0 / 0.0);
    }
    let lit = to_string(t);
    let fixed = if lit.starts_with(".") or lit.starts_with("-.") or lit.starts_with("+.") {
        lit.replace(".", "0.")
    } else {
        lit
    };
    let unsigned = if fixed.starts_with("+") { to_string(slice(cps_of(fixed), 1, fixed.len())) } else { fixed };
    match f64.parse(unsigned) {
        Ok(x) => Ok(x),
        Err(_) => Err(value_error(f"could not convert string to float: {repr_of(s)}")),
    }
}


// ------------------------------------------------------------ Python values

// A JSON document as Python holds it after json.load, and what the
// validators turn it into.
#[derive(Clone)]
enum Value {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(Vec[i64]),
    List(Vec[Value]),
    // a dict's keys are strings: the documents are JSON
    Dict(Vec[(Vec[i64], Value)]),
}

fn type_of(v: ref Value) -> Str {
    match v {
        Value.Null => "NoneType",
        Value.Bool(_) => "bool",
        Value.Int(_) => "int",
        Value.Float(_) => "float",
        Value.Str(_) => "str",
        Value.List(_) => "list",
        Value.Dict(_) => "dict",
    }
}

fn truthy(v: ref Value) -> bool {
    match v {
        Value.Null => false,
        Value.Bool(b) => *b,
        Value.Int(n) => *n != 0,
        Value.Float(x) => *x != 0.0,
        Value.Str(s) => s.len() > 0,
        Value.List(xs) => xs.len() > 0,
        Value.Dict(d) => d.len() > 0,
    }
}

// bool is an int subclass
fn int_of(v: ref Value) -> Option[i64] {
    match v {
        Value.Bool(b) => Some(if *b { 1 } else { 0 }),
        Value.Int(n) => Some(*n),
        _ => None,
    }
}

fn float_of(v: ref Value) -> Option[f64] {
    match v {
        Value.Float(x) => Some(*x),
        _ => match int_of(v) {
            Some(n) => Some(n as f64),
            None => None,
        },
    }
}

fn lookup(d: ref Vec[(Vec[i64], Value)], key: ref Vec[i64]) -> Option[Value] {
    for (k, v) in d.iter() {
        if same(k, key) {
            return Some(v.clone());
        }
    }
    None
}

fn has_key(d: ref Vec[(Vec[i64], Value)], key: ref Vec[i64]) -> bool {
    for (k, _) in d.iter() {
        if same(k, key) {
            return true;
        }
    }
    false
}

// d[key] = v: a new key goes at the end, an old one keeps its place
fn dict_set(d: mut ref Vec[(Vec[i64], Value)], key: own Vec[i64], v: own Value) {
    let mut i = 0;
    while i < d.len() {
        if same(d[i].0, key) {
            d[i] = (key, v);
            return;
        }
        i += 1;
    }
    d.push((key, v));
}

// ==
fn py_eq(a: ref Value, b: ref Value) -> bool {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => return x == y,
        _ => {}
    }
    match (float_of(a), float_of(b)) {
        (Some(x), Some(y)) => return x == y,
        _ => {}
    }
    match (a, b) {
        (Value.Null, Value.Null) => true,
        (Value.Str(x), Value.Str(y)) => same(x, y),
        (Value.List(xs), Value.List(ys)) => {
            if xs.len() != ys.len() {
                return false;
            }
            let mut i = 0;
            while i < xs.len() {
                if not py_eq(xs[i], ys[i]) {
                    return false;
                }
                i += 1;
            }
            true
        }
        (Value.Dict(x), Value.Dict(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for (k, v) in x.iter() {
                match lookup(y, k) {
                    Some(w) => {
                        if not py_eq(v, w) {
                            return false;
                        }
                    }
                    None => return false,
                }
            }
            true
        }
        _ => false,
    }
}

fn cmp_cps(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    if a.len() == b.len() { 0 } else if a.len() < b.len() { -1 } else { 1 }
}

fn sign_of(less: bool, greater: bool) -> i64 {
    if less { -1 } else if greater { 1 } else { 0 }
}

// a < b and a > b as one answer, or None where Python raises TypeError
fn py_cmp(a: ref Value, b: ref Value) -> Option[i64] {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => return Some(sign_of(x < y, x > y)),
        _ => {}
    }
    match (float_of(a), float_of(b)) {
        (Some(x), Some(y)) => return Some(sign_of(x < y, x > y)),
        _ => {}
    }
    match (a, b) {
        (Value.Str(x), Value.Str(y)) => Some(cmp_cps(x, y)),
        (Value.List(xs), Value.List(ys)) => {
            let mut i = 0;
            while i < xs.len() and i < ys.len() {
                if not py_eq(xs[i], ys[i]) {
                    return py_cmp(xs[i], ys[i]);
                }
                i += 1;
            }
            Some(sign_of(xs.len() < ys.len(), xs.len() > ys.len()))
        }
        _ => None,
    }
}

// repr(v); a dict's keys in sorted order when `sorted` is set
fn repr_into(v: ref Value, sorted: bool, out: mut ref Vec[i64]) {
    match v {
        Value.Null => push_ascii(mut out, "None"),
        Value.Bool(b) => push_ascii(mut out, if *b { "True" } else { "False" }),
        Value.Int(n) => push_ascii(mut out, f"{n}"),
        Value.Float(x) => push_ascii(mut out, float_repr(*x)),
        Value.Str(s) => str_repr(s, mut out),
        Value.List(xs) => {
            out.push(91);
            let mut i = 0;
            while i < xs.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                repr_into(xs[i], sorted, mut out);
                i += 1;
            }
            out.push(93);
        }
        Value.Dict(d) => {
            let mut order: Vec[i64] = Vec.new();
            let mut i = 0;
            while i < d.len() {
                // insertion sort keeps it stable
                let mut j = order.len();
                order.push(i);
                if sorted {
                    while j > 0 and cmp_cps(d[order[j - 1]].0, d[i].0) > 0 {
                        order[j] = order[j - 1];
                        j -= 1;
                    }
                    order[j] = i;
                }
                i += 1;
            }
            out.push(123);
            let mut k = 0;
            while k < order.len() {
                if k > 0 {
                    push_ascii(mut out, ", ");
                }
                let (key, val) = ref d[order[k]];
                str_repr(key, mut out);
                push_ascii(mut out, ": ");
                repr_into(val, sorted, mut out);
                k += 1;
            }
            out.push(125);
        }
    }
}

fn py_repr(v: ref Value) -> String {
    let mut out: Vec[i64] = Vec.new();
    repr_into(v, false, mut out);
    to_string(out)
}

fn sorted_repr(v: ref Value) -> String {
    let mut out: Vec[i64] = Vec.new();
    repr_into(v, true, mut out);
    to_string(out)
}

// str(v)
fn py_str_cps(v: ref Value) -> Vec[i64] {
    match v {
        Value.Str(s) => s.clone(),
        _ => {
            let mut out: Vec[i64] = Vec.new();
            repr_into(v, false, mut out);
            out
        }
    }
}

fn py_str(v: ref Value) -> String {
    to_string(py_str_cps(v))
}

// ------------------------------------------------------------ JSON in

struct JsonIn {
    cs: Vec[i64],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and (self.cs[self.pos] == 32 or self.cs[self.pos] == 10 or self.cs[self.pos] == 13 or self.cs[self.pos] == 9) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc = cps(w);
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> i64 {
        let mut n = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= 48 and c <= 57 { c - 48 } else if c >= 97 and c <= 102 { c - 87 } else { c - 55 };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[Value, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == 91 {
            self.pos += 1;
            let mut items: Vec[Value] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == 93 {
                self.pos += 1;
                return Ok(Value.List(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == 93 {
                    return Ok(Value.List(items));
                }
                if d != 44 {
                    return Err("bad JSON array separator".to_string());
                }
            }
        }
        if c == 123 {
            self.pos += 1;
            let mut members: Vec[(Vec[i64], Value)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == 125 {
                self.pos += 1;
                return Ok(Value.Dict(members));
            }
            loop {
                let key = match self.value()? {
                    Value.Str(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != 58 {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                // json.loads keeps the last of a repeated key
                dict_set(mut members, key, v);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == 125 {
                    return Ok(Value.Dict(members));
                }
                if d != 44 {
                    return Err("bad JSON object separator".to_string());
                }
            }
        }
        if self.word("true") {
            return Ok(Value.Bool(true));
        }
        if self.word("false") {
            return Ok(Value.Bool(false));
        }
        if self.word("null") {
            return Ok(Value.Null);
        }
        if c == 45 or (c >= 48 and c <= 57) {
            let start = self.pos;
            let mut is_float = false;
            while self.pos < self.cs.len() {
                let d = self.cs[self.pos];
                if d == 46 or d == 101 or d == 69 {
                    is_float = true;
                } else if not (d == 45 or d == 43 or (d >= 48 and d <= 57)) {
                    break;
                }
                self.pos += 1;
            }
            let text = to_string(slice(self.cs, start, self.pos));
            if is_float {
                return match f64.parse(text) {
                    Ok(x) => Ok(Value.Float(x)),
                    Err(_) => Err("bad JSON number".to_string()),
                };
            }
            return match i64.parse(text) {
                Ok(n) => Ok(Value.Int(n)),
                Err(_) => Err("bad JSON number".to_string()),
            };
        }
        if c != 34 {
            return Err("unexpected JSON character".to_string());
        }
        self.pos += 1;
        let mut s: Vec[i64] = Vec.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == 34 {
                return Ok(Value.Str(s));
            }
            if d != 92 {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 110 {
                s.push(10);
            } else if e == 116 {
                s.push(9);
            } else if e == 114 {
                s.push(13);
            } else if e == 98 {
                s.push(8);
            } else if e == 102 {
                s.push(12);
            } else if e == 117 {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 and self.pos + 1 < self.cs.len() and self.cs[self.pos] == 92 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(n);
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn parse_json(text: ref String) -> Result[Value, String] {
    let mut p = JsonIn { cs: cps_of(text), pos: 0 };
    p.value()
}

fn get(d: ref Value, key: Str) -> Option[Value] {
    match d {
        Value.Dict(items) => lookup(items, cps(key)),
        _ => None,
    }
}

fn get_text(d: ref Value, key: Str) -> Vec[i64] {
    match get(d, key) {
        Some(Value.Str(s)) => s,
        _ => Vec.new(),
    }
}

fn get_msg(d: ref Value) -> Option[String] {
    match get(d, "msg") {
        Some(Value.Str(s)) => Some(to_string(s)),
        _ => None,
    }
}

fn get_flag(d: ref Value, key: Str, default: bool) -> bool {
    match get(d, key) {
        Some(Value.Bool(b)) => b,
        _ => default,
    }
}

fn get_int(d: ref Value, key: Str) -> i64 {
    match get(d, key) {
        Some(Value.Int(n)) => n,
        _ => -1,
    }
}

// ------------------------------------------------------------ errors

// One step of an error's path: a key or an index (`data[...]` shows its
// repr), a group's VirtualPathComponent (`<label>`), or a key that is a
// class or a validator, shown by its repr and found in no document.
#[derive(Clone)]
enum PathItem {
    Val(Value),
    Virt(Vec[i64]),
    Opaque(String),
}

// er.Invalid: its message, path and error_type ("" for none)
#[derive(Clone)]
struct Inv {
    msg: String,
    path: Vec[PathItem],
    error_type: String,
}

// An Invalid, or a MultipleInvalid with the errors it holds
#[derive(Clone)]
enum VErr {
    One(Inv),
    Many(Vec[VErr]),
}

fn fail(msg: own String, path: ref Vec[PathItem]) -> VErr {
    VErr.One(Inv { msg: msg, path: path.clone(), error_type: String.new() })
}

fn fail0(msg: own String) -> VErr {
    VErr.One(Inv { msg: msg, path: Vec.new(), error_type: String.new() })
}

fn sub_path(path: ref Vec[PathItem], item: own PathItem) -> Vec[PathItem] {
    let mut p = path.clone();
    p.push(item);
    p
}

// len(e.path): a MultipleInvalid's path is its first error's
fn depth(e: ref VErr) -> i64 {
    match e {
        VErr.One(i) => i.path.len(),
        VErr.Many(es) => if es.len() == 0 { 0 } else { depth(es[0]) },
    }
}

// e.prepend(path)
fn prepend(e: own VErr, path: ref Vec[PathItem]) -> VErr {
    if path.len() == 0 {
        return e;
    }
    match e {
        VErr.One(i) => {
            let mut p = path.clone();
            for item in i.path.iter() {
                p.push(item.clone());
            }
            VErr.One(Inv { msg: i.msg, path: p, error_type: i.error_type })
        }
        VErr.Many(es) => {
            let mut out: Vec[VErr] = Vec.new();
            for x in es {
                out.push(prepend(x, path));
            }
            VErr.Many(out)
        }
    }
}

// Schema.__call__ hands every failure out as a MultipleInvalid
fn as_many(e: own VErr) -> VErr {
    match e {
        VErr.Many(es) => VErr.Many(es),
        VErr.One(i) => {
            let mut es: Vec[VErr] = Vec.new();
            es.push(VErr.One(i));
            VErr.Many(es)
        }
    }
}

// the errors a mapping collects from a MultipleInvalid, or the one error
fn flatten(e: own VErr) -> Vec[VErr] {
    match e {
        VErr.Many(es) => es,
        VErr.One(i) => {
            let mut es: Vec[VErr] = Vec.new();
            es.push(VErr.One(i));
            es
        }
    }
}

fn item_repr(p: ref PathItem) -> String {
    match p {
        PathItem.Val(v) => py_repr(v),
        PathItem.Virt(label) => f"<{to_string(label)}>",
        PathItem.Opaque(r) => r.clone(),
    }
}

// str(e)
fn err_str(e: ref VErr) -> String {
    match e {
        VErr.One(i) => {
            let mut s = i.msg.clone();
            if i.error_type.len() > 0 {
                s = f"{s} for {i.error_type}";
            }
            if i.path.len() > 0 {
                let parts: Vec[String] = i.path.iter().map(|p| item_repr(p)).collect();
                s = f"{s} @ data[{parts.join("][")}]";
            }
            s
        }
        VErr.Many(es) => if es.len() == 0 { String.new() } else { err_str(es[0]) },
    }
}

// humanize._nested_getitem: None where a step raises KeyError,
// IndexError or TypeError
fn nested_getitem(data: ref Value, path: ref Vec[PathItem]) -> Value {
    let mut cur = data.clone();
    for item in path.iter() {
        let next = match (cur, item) {
            (Value.Dict(d), PathItem.Val(Value.Str(k))) => lookup(d, k),
            (Value.Dict(d), PathItem.Virt(k)) => lookup(d, k),
            (Value.List(xs), PathItem.Val(iv)) => match int_of(iv) {
                Some(i0) => {
                    let i = if i0 < 0 { i0 + xs.len() } else { i0 };
                    if i >= 0 and i < xs.len() { Some(xs[i].clone()) } else { None }
                }
                None => None,
            },
            (Value.Str(s), PathItem.Val(iv)) => match int_of(iv) {
                Some(i0) => {
                    let i = if i0 < 0 { i0 + s.len() } else { i0 };
                    if i >= 0 and i < s.len() {
                        let mut one: Vec[i64] = Vec.new();
                        one.push(s[i]);
                        Some(Value.Str(one))
                    } else {
                        None
                    }
                }
                None => None,
            },
            _ => None,
        };
        match next {
            Some(v) => cur = v,
            None => return Value.Null,
        }
    }
    cur
}

// humanize_error, MAX_VALIDATION_ERROR_ITEM_LENGTH = 500
fn humanize(data: ref Value, e: ref VErr) -> String {
    match e {
        VErr.Many(es) => {
            let mut lines: Vec[String] = es.iter().map(|x| humanize(data, x)).collect();
            lines.sort_by(|a, b| a.cmp(b));
            lines.join("\n")
        }
        VErr.One(i) => {
            let mut got = cps_of(py_repr(nested_getitem(data, i.path)));
            if got.len() > 500 {
                got = slice(got, 0, 497);
                push_ascii(mut got, "...");
            }
            f"{err_str(e)}. Got {to_string(got)}"
        }
    }
}

// ------------------------------------------------------------ schemas

#[derive(Clone, PartialEq)]
enum SOp {
    Type,
    Lit,
    Dict,
    List,
    Any,
    All,
    SomeOf,
    Msg,
    Coerce,
    Boolean,
    IsTrue,
    IsFalse,
    Email,
    Url,
    FqdnUrl,
    IsFile,
    IsDir,
    PathExists,
    Match,
    Replace,
    Range,
    Clamp,
    Length,
    Datetime,
    Date,
    In,
    NotIn,
    Contains,
    ExactSequence,
    Unordered,
    Unique,
    Equal,
    Number,
    Lower,
    Upper,
    Capitalize,
    Title,
    Strip,
    DefaultTo,
    SetTo,
    Literal,
    SelfRef,
}

#[derive(Clone, PartialEq)]
enum KeyKind {
    Plain,
    Required,
    Optional,
    Remove,
    Exclusive,
    Inclusive,
    Validator,
    Extra,
}

// A key of a dict schema: a plain string, a marker on a string, a
// validator (a class, Match(...), Any(...)) or Extra.
#[derive(Clone)]
struct KeyN {
    kind: KeyKind,
    name: Vec[i64],
    msg: Option[String],
    default: Option[Value],
    group: Vec[i64],
    // the validator of a Validator key
    node: Vec[SNode],
}

// A schema node. `kids` holds a dict's values (one per key), a list's
// items, the validators of Any, All, SomeOf, ExactSequence and Unordered,
// and the schema of Msg. `a` and `b` are a literal, the bounds of Range,
// Clamp and Length, the value of DefaultTo, SetTo and Literal, Equal's
// target, Contains' item and the container of In and NotIn. `text` is a
// type name, a pattern or a format and `text2` a substitution; `n1` and
// `n2` are SomeOf's min_valid and max_valid and Number's precision and
// scale (-1 for None); `f1` and `f2` are Range's min_included and
// max_included, and `f1` the `required` of Any, All and SomeOf.
#[derive(Clone)]
struct SNode {
    op: SOp,
    kids: Vec[SNode],
    keys: Vec[KeyN],
    msg: Option[String],
    a: Option[Value],
    b: Option[Value],
    text: Vec[i64],
    text2: Vec[i64],
    n1: i64,
    n2: i64,
    f1: bool,
    f2: bool,
}

fn node(op: SOp) -> SNode {
    SNode {
        op: op,
        kids: Vec.new(),
        keys: Vec.new(),
        msg: None,
        a: None,
        b: None,
        text: Vec.new(),
        text2: Vec.new(),
        n1: -1,
        n2: -1,
        f1: false,
        f2: false,
    }
}

fn type_node(name: Str) -> SNode {
    let mut n = node(SOp.Type);
    n.text = cps(name);
    n
}

fn lit_node(v: ref Value) -> SNode {
    let mut n = node(SOp.Lit);
    n.a = Some(v.clone());
    n
}

fn simple_op(name: ref String) -> Option[SOp] {
    let op = if name == "boolean" {
        SOp.Boolean
    } else if name == "istrue" {
        SOp.IsTrue
    } else if name == "isfalse" {
        SOp.IsFalse
    } else if name == "email" {
        SOp.Email
    } else if name == "url" {
        SOp.Url
    } else if name == "fqdnurl" {
        SOp.FqdnUrl
    } else if name == "isfile" {
        SOp.IsFile
    } else if name == "isdir" {
        SOp.IsDir
    } else if name == "pathexists" {
        SOp.PathExists
    } else if name == "unique" {
        SOp.Unique
    } else if name == "lower" {
        SOp.Lower
    } else if name == "upper" {
        SOp.Upper
    } else if name == "capitalize" {
        SOp.Capitalize
    } else if name == "title" {
        SOp.Title
    } else if name == "strip" {
        SOp.Strip
    } else if name == "self" {
        SOp.SelfRef
    } else {
        return None;
    };
    Some(op)
}

fn build_all(items: ref Value) -> Result[Vec[SNode], String] {
    let mut out: Vec[SNode] = Vec.new();
    if let Value.List(xs) = items {
        for x in xs.iter() {
            out.push(build(x)?);
        }
    }
    Ok(out)
}

fn build_key(k: ref Value) -> Result[KeyN, String] {
    let mut key = KeyN { kind: KeyKind.Plain, name: Vec.new(), msg: None, default: None, group: Vec.new(), node: Vec.new() };
    if let Value.Str(s) = k {
        key.name = s.clone();
        return Ok(key);
    }
    let op = to_string(get_text(k, "op"));
    key.kind = if op == "required" {
        KeyKind.Required
    } else if op == "optional" {
        KeyKind.Optional
    } else if op == "remove" {
        KeyKind.Remove
    } else if op == "exclusive" {
        KeyKind.Exclusive
    } else if op == "inclusive" {
        KeyKind.Inclusive
    } else if op == "extra" {
        KeyKind.Extra
    } else {
        KeyKind.Validator
    };
    if key.kind == KeyKind.Validator {
        key.node.push(build(k)?);
        return Ok(key);
    }
    key.name = get_text(k, "name");
    key.msg = get_msg(k);
    key.default = get(k, "default");
    key.group = get_text(k, "group");
    Ok(key)
}

// A schema node from its JSON form (see mk.py)
fn build(j: ref Value) -> Result[SNode, String] {
    let d = match j {
        Value.List(_) => {
            let mut n = node(SOp.List);
            n.kids = build_all(j)?;
            return Ok(n);
        }
        Value.Dict(_) => j,
        _ => return Ok(lit_node(j)),
    };
    let op = to_string(get_text(d, "op"));
    if let Some(s) = simple_op(op) {
        let mut n = node(s);
        n.msg = get_msg(d);
        return Ok(n);
    }
    let mut n = node(SOp.Lit);
    n.msg = get_msg(d);
    if op == "type" {
        n.op = SOp.Type;
        n.text = get_text(d, "name");
    } else if op == "lit" {
        n.a = get(d, "value");
    } else if op == "dict" {
        n.op = SOp.Dict;
        if let Some(Value.List(pairs)) = get(d, "keys") {
            for pair in pairs.iter() {
                if let Value.List(kv) = pair {
                    n.keys.push(build_key(kv[0])?);
                    n.kids.push(build(kv[1])?);
                }
            }
        }
    } else if op == "list" {
        n.op = SOp.List;
        n.kids = build_all(get(d, "items").unwrap_or(Value.Null))?;
    } else if op == "any" or op == "all" or op == "someof" {
        n.op = if op == "any" { SOp.Any } else if op == "all" { SOp.All } else { SOp.SomeOf };
        n.kids = build_all(get(d, "of").unwrap_or(Value.Null))?;
        n.f1 = get_flag(d, "required", false);
        n.n1 = get_int(d, "min");
        n.n2 = get_int(d, "max");
    } else if op == "maybe" {
        // Maybe(v, msg) is Any(None, v, msg=msg)
        n.op = SOp.Any;
        n.kids.push(lit_node(Value.Null));
        n.kids.push(build(get(d, "of").unwrap_or(Value.Null))?);
    } else if op == "msg" {
        n.op = SOp.Msg;
        n.kids.push(build(get(d, "of").unwrap_or(Value.Null))?);
        n.msg = Some(to_string(get_text(d, "text")));
    } else if op == "coerce" {
        n.op = SOp.Coerce;
        n.text = get_text(d, "type");
    } else if op == "match" or op == "replace" {
        n.op = if op == "match" { SOp.Match } else { SOp.Replace };
        n.text = get_text(d, "pattern");
        n.text2 = get_text(d, "sub");
    } else if op == "range" or op == "clamp" or op == "length" {
        n.op = if op == "range" { SOp.Range } else if op == "clamp" { SOp.Clamp } else { SOp.Length };
        n.a = get(d, "min");
        n.b = get(d, "max");
        n.f1 = get_flag(d, "min_included", true);
        n.f2 = get_flag(d, "max_included", true);
    } else if op == "datetime" or op == "date" {
        n.op = if op == "datetime" { SOp.Datetime } else { SOp.Date };
        n.text = match get(d, "format") {
            Some(Value.Str(f)) => f,
            _ => cps(if op == "datetime" { "%Y-%m-%dT%H:%M:%S.%fZ" } else { "%Y-%m-%d" }),
        };
    } else if op == "in" or op == "notin" {
        n.op = if op == "in" { SOp.In } else { SOp.NotIn };
        n.a = get(d, "container");
    } else if op == "contains" {
        n.op = SOp.Contains;
        n.a = get(d, "item");
    } else if op == "exactsequence" or op == "unordered" {
        n.op = if op == "exactsequence" { SOp.ExactSequence } else { SOp.Unordered };
        n.kids = build_all(get(d, "of").unwrap_or(Value.Null))?;
    } else if op == "equal" {
        n.op = SOp.Equal;
        n.a = get(d, "target");
    } else if op == "number" {
        n.op = SOp.Number;
        n.n1 = get_int(d, "precision");
        n.n2 = get_int(d, "scale");
    } else if op == "defaultto" or op == "setto" or op == "literal" {
        n.op = if op == "defaultto" { SOp.DefaultTo } else if op == "setto" { SOp.SetTo } else { SOp.Literal };
        n.a = get(d, "value");
    } else {
        return Err(f"unknown schema node {op}");
    }
    Ok(n)
}

fn msg_repr(m: ref Option[String]) -> String {
    match m {
        Some(s) => repr_of(cps_of(s)),
        None => "None".to_string(),
    }
}

// repr() of the validators a key can be, for the path of a required key
// that is not a string
fn node_repr(n: ref SNode) -> String {
    match n.op {
        SOp.Type => f"<class '{to_string(n.text)}'>",
        SOp.Lit => py_repr(n.a.clone().unwrap_or(Value.Null)),
        SOp.Match => f"Match({repr_of(n.text)}, msg={msg_repr(n.msg)})",
        SOp.Any | SOp.All => {
            let parts: Vec[String] = n.kids.iter().map(|k| node_repr(k)).collect();
            let name = if n.op == SOp.Any { "Any" } else { "All" };
            f"{name}({parts.join(", ")}, msg={msg_repr(n.msg)})"
        }
        _ => "<validator>".to_string(),
    }
}

// str(schema) for what Schema.infer builds
fn schema_str(n: ref SNode) -> String {
    match n.op {
        SOp.Dict => {
            let mut parts: Vec[String] = Vec.new();
            let mut i = 0;
            while i < n.keys.len() {
                parts.push(f"{repr_of(n.keys[i].name)}: {schema_str(n.kids[i])}");
                i += 1;
            }
            f"{{{parts.join(", ")}}}"
        }
        SOp.List => {
            let parts: Vec[String] = n.kids.iter().map(|k| schema_str(k)).collect();
            f"[{parts.join(", ")}]"
        }
        _ => node_repr(n),
    }
}

// Schema.infer: a class for each value, an empty dict or list as dict or
// list
fn infer(v: ref Value) -> SNode {
    match v {
        Value.Dict(d) => {
            if d.len() == 0 {
                return type_node("dict");
            }
            let mut n = node(SOp.Dict);
            for (k, x) in d.iter() {
                n.keys.push(KeyN { kind: KeyKind.Plain, name: k.clone(), msg: None, default: None, group: Vec.new(), node: Vec.new() });
                n.kids.push(infer(x));
            }
            n
        }
        Value.List(xs) => {
            if xs.len() == 0 {
                return type_node("list");
            }
            let mut n = node(SOp.List);
            for x in xs.iter() {
                n.kids.push(infer(x));
            }
            n
        }
        _ => type_node(type_of(v)),
    }
}

// the literal Schema.extend matches keys by: a marker's string, a plain
// string, or a class
fn key_literal_eq(a: ref KeyN, b: ref KeyN) -> bool {
    let a_str = a.kind != KeyKind.Validator and a.kind != KeyKind.Extra;
    let b_str = b.kind != KeyKind.Validator and b.kind != KeyKind.Extra;
    if a_str and b_str {
        return same(a.name, b.name);
    }
    if a.kind == KeyKind.Extra and b.kind == KeyKind.Extra {
        return true;
    }
    if a.kind == KeyKind.Validator and b.kind == KeyKind.Validator {
        return a.node[0].op == SOp.Type and b.node[0].op == SOp.Type and same(a.node[0].text, b.node[0].text);
    }
    false
}

// Schema.extend on two dict schemas
fn extend_dict(base: ref SNode, with: ref SNode) -> SNode {
    let mut keys: Vec[KeyN] = base.keys.clone();
    let mut kids: Vec[SNode] = base.kids.clone();
    let lits: Vec[KeyN] = base.keys.clone();
    let mut i = 0;
    while i < with.keys.len() {
        let key = ref with.keys[i];
        let value = ref with.kids[i];
        let mut found = -1;
        for l in lits.iter() {
            if key_literal_eq(l, key) {
                // result_key_map[key_literal(key)]: the base's key, found
                // among the result's keys
                let mut j = 0;
                while j < keys.len() {
                    if key_literal_eq(keys[j], l) {
                        found = j;
                    }
                    j += 1;
                }
                break;
            }
        }
        if found >= 0 {
            let old = kids[found].clone();
            keys.remove(found);
            kids.remove(found);
            keys.push(key.clone());
            if old.op == SOp.Dict and value.op == SOp.Dict {
                kids.push(extend_dict(old, value));
            } else {
                kids.push(value.clone());
            }
        } else {
            keys.push(key.clone());
            kids.push(value.clone());
        }
        i += 1;
    }
    let mut n = node(SOp.Dict);
    n.keys = keys;
    n.kids = kids;
    n
}

fn prevent_extra() -> i64 { 0 }
fn allow_extra() -> i64 { 1 }
fn remove_extra() -> i64 { 2 }

struct Sch {
    name: String,
    root: SNode,
    required: bool,
    extra: i64,
}

fn extra_of(j: ref Value, default: i64) -> i64 {
    let e = to_string(get_text(j, "extra"));
    if e == "allow" {
        allow_extra()
    } else if e == "remove" {
        remove_extra()
    } else if e == "prevent" {
        prevent_extra()
    } else {
        default
    }
}

fn find_schema(all: ref Vec[Sch], name: ref String) -> i64 {
    let mut i = 0;
    while i < all.len() {
        if all[i].name == *name {
            return i;
        }
        i += 1;
    }
    -1
}

fn load_schemas(text: ref String) -> Result[Vec[Sch], String] {
    let mut out: Vec[Sch] = Vec.new();
    let items = match parse_json(text)? {
        Value.List(xs) => xs,
        _ => return Err("schemas.json is not a list".to_string()),
    };
    for j in items.iter() {
        let name = to_string(get_text(j, "name"));
        let base = to_string(get_text(j, "extend"));
        if base.len() > 0 {
            let b = find_schema(out, base);
            if b < 0 {
                return Err(f"unknown schema {base}");
            }
            let with = build(get(j, "with").unwrap_or(Value.Null))?;
            let root = extend_dict(out[b].root, with);
            let required = get_flag(j, "required", out[b].required);
            let extra = extra_of(j, out[b].extra);
            out.push(Sch { name: name, root: root, required: required, extra: extra });
        } else {
            let root = build(get(j, "schema").unwrap_or(Value.Null))?;
            let required = get_flag(j, "required", false);
            let extra = extra_of(j, prevent_extra());
            out.push(Sch { name: name, root: root, required: required, extra: extra });
        }
    }
    Ok(out)
}

// ------------------------------------------------------------ validating

// What the compiled schema carries: `req`, the schema's `required` as it
// stood while this part was compiled (Any, All and SomeOf set their own
// for what they hold), `extra`, read when the mapping runs, and the
// `required` that Self's whole schema was compiled with.
#[derive(Clone)]
struct Ctx {
    req: bool,
    extra: i64,
    root_req: bool,
}

struct Env {
    rx: Rx,
    user_re: i64,
    domain_re: i64,
}

fn msg_or(n: ref SNode, default: own String) -> String {
    match n.msg.clone() {
        Some(m) => if m.len() > 0 { m } else { default },
        None => default,
    }
}

fn is_instance(v: ref Value, ty: ref Vec[i64]) -> bool {
    let t = to_string(ty);
    if t == "object" {
        return true;
    }
    if t == "int" {
        return int_of(v).is_some();
    }
    t == type_of(v)
}

// the schema's own compiled function at `path`
fn validate(env: mut ref Env, n: ref SNode, root: ref SNode, cx: ref Ctx, path: ref Vec[PathItem], v: ref Value) -> Result[Value, VErr] {
    match n.op {
        SOp.Type => {
            if is_instance(v, n.text) {
                Ok(v.clone())
            } else {
                Err(fail(f"expected {to_string(n.text)}", path))
            }
        }
        SOp.Lit => {
            let want = n.a.clone().unwrap_or(Value.Null);
            if py_eq(v, want) {
                Ok(v.clone())
            } else {
                Err(fail("not a valid value".to_string(), path))
            }
        }
        SOp.Dict => match v {
            Value.Dict(d) => validate_dict(env, n, root, cx, path, d),
            _ => Err(fail("expected a dictionary".to_string(), path)),
        },
        SOp.List => validate_list(env, n, root, cx, path, v),
        SOp.Any => {
            let inner = Ctx { req: n.f1, extra: cx.extra, root_req: cx.root_req };
            let mut error: Option[VErr] = None;
            for kid in n.kids.iter() {
                match validate(env, kid, root, inner, path, v) {
                    Ok(x) => return Ok(x),
                    Err(e) => {
                        let deeper = match error {
                            Some(old) => depth(e) > depth(old),
                            None => true,
                        };
                        if deeper {
                            error = Some(e);
                        }
                    }
                }
            }
            match error {
                Some(e) => match n.msg.clone() {
                    None => Err(e),
                    Some(m) => Err(fail(m, path)),
                },
                None => Err(fail(msg_or(n, "no valid value found".to_string()), path)),
            }
        }
        SOp.All => {
            let inner = Ctx { req: n.f1, extra: cx.extra, root_req: cx.root_req };
            let mut cur = v.clone();
            for kid in n.kids.iter() {
                match validate(env, kid, root, inner, path, cur) {
                    Ok(x) => cur = x,
                    Err(e) => {
                        return match n.msg.clone() {
                            None => Err(e),
                            Some(m) => Err(fail(m, path)),
                        };
                    }
                }
            }
            Ok(cur)
        }
        SOp.SomeOf => {
            let inner = Ctx { req: n.f1, extra: cx.extra, root_req: cx.root_req };
            let mut errors: Vec[VErr] = Vec.new();
            let mut cur = v.clone();
            for kid in n.kids.iter() {
                match validate(env, kid, root, inner, path, cur) {
                    Ok(x) => cur = x,
                    Err(e) => errors.push(e),
                }
            }
            let min_valid = if n.n1 > 0 { n.n1 } else { 0 };
            let max_valid = if n.n2 > 0 { n.n2 } else { n.kids.len() };
            let passed = n.kids.len() - errors.len();
            if min_valid <= passed and passed <= max_valid {
                return Ok(cur);
            }
            let joined: Vec[String] = errors.iter().map(|e| err_str(e)).collect();
            // TooManyValid and NotEnoughValid are raised with no path
            Err(fail0(msg_or(n, joined.join(", "))))
        }
        SOp.SelfRef => {
            let whole = Ctx { req: cx.root_req, extra: cx.extra, root_req: cx.root_req };
            validate(env, root, root, whole, path, v)
        }
        _ => match call(env, n, v) {
            Ok(x) => Ok(x),
            Err(e) => Err(prepend(e, path)),
        },
    }
}

// Schema(schema)(v), as Msg, the markers, ExactSequence and Unordered
// build them: required=False, PREVENT_EXTRA
fn fresh(env: mut ref Env, n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let cx = Ctx { req: false, extra: prevent_extra(), root_req: false };
    let empty: Vec[PathItem] = Vec.new();
    match validate(env, n, n, cx, empty, v) {
        Ok(x) => Ok(x),
        Err(e) => Err(as_many(e)),
    }
}

fn run_schema(env: mut ref Env, s: ref Sch, v: ref Value) -> Result[Value, VErr] {
    let cx = Ctx { req: s.required, extra: s.extra, root_req: s.required };
    let empty: Vec[PathItem] = Vec.new();
    match validate(env, s.root, s.root, cx, empty, v) {
        Ok(x) => Ok(x),
        Err(e) => Err(as_many(e)),
    }
}

fn is_marker(k: KeyKind) -> bool {
    k == KeyKind.Required or k == KeyKind.Optional or k == KeyKind.Exclusive or k == KeyKind.Inclusive
}

// _sort_item: Remove, the other markers, callables (Extra among them),
// then classes; plain strings come first
fn key_priority(k: ref KeyN) -> i64 {
    if k.kind == KeyKind.Remove {
        1
    } else if is_marker(k.kind) {
        2
    } else if k.kind == KeyKind.Validator {
        if k.node[0].op == SOp.Type { 4 } else { 3 }
    } else if k.kind == KeyKind.Extra {
        3
    } else {
        0
    }
}

fn group_labels(n: ref SNode, kind: KeyKind) -> Vec[Vec[i64]] {
    let mut labels: Vec[Vec[i64]] = Vec.new();
    for k in n.keys.iter() {
        if k.kind == kind {
            let mut seen = false;
            for l in labels.iter() {
                if same(l, k.group) {
                    seen = true;
                }
            }
            if not seen {
                labels.push(k.group.clone());
            }
        }
    }
    labels
}

fn key_path_item(k: ref KeyN) -> PathItem {
    if k.kind == KeyKind.Validator {
        PathItem.Opaque(node_repr(k.node[0]))
    } else {
        PathItem.Val(Value.Str(k.name.clone()))
    }
}

// hasattr(key, 'msg') and key.msg: the markers, and validators other
// than classes
fn key_msg(k: ref KeyN) -> Option[String] {
    let m = if k.kind == KeyKind.Validator {
        if k.node[0].op == SOp.Type { None } else { k.node[0].msg.clone() }
    } else if k.kind == KeyKind.Plain {
        None
    } else {
        k.msg.clone()
    };
    match m {
        Some(s) => if s.len() > 0 { Some(s) } else { None },
        None => None,
    }
}

// _compile_dict's validate_dict: the groups first, then the mapping
fn validate_dict(env: mut ref Env, n: ref SNode, root: ref SNode, cx: ref Ctx, path: ref Vec[PathItem], d: ref Vec[(Vec[i64], Value)]) -> Result[Value, VErr] {
    let mut errors: Vec[VErr] = Vec.new();
    for label in group_labels(n, KeyKind.Exclusive).iter() {
        let mut exists = false;
        for k in n.keys.iter() {
            if k.kind == KeyKind.Exclusive and same(k.group, label) and has_key(d, k.name) {
                if exists {
                    let m = match key_msg(k) {
                        Some(m) => m,
                        None => f"two or more values in the same group of exclusion '{to_string(label)}'",
                    };
                    errors.push(fail(m, sub_path(path, PathItem.Virt(label.clone()))));
                    break;
                }
                exists = true;
            }
        }
    }
    if errors.len() > 0 {
        return Err(VErr.Many(errors));
    }
    for label in group_labels(n, KeyKind.Inclusive).iter() {
        let mut any = false;
        let mut all = true;
        let mut m = f"some but not all values in the same group of inclusion '{to_string(label)}'";
        let mut msg_found = false;
        for k in n.keys.iter() {
            if k.kind == KeyKind.Inclusive and same(k.group, label) {
                if has_key(d, k.name) {
                    any = true;
                } else {
                    all = false;
                }
                if not msg_found {
                    if let Some(km) = key_msg(k) {
                        m = km;
                        msg_found = true;
                    }
                }
            }
        }
        if any and not all {
            errors.push(fail(m, sub_path(path, PathItem.Virt(label.clone()))));
            break;
        }
    }
    if errors.len() > 0 {
        return Err(VErr.Many(errors));
    }
    validate_mapping(env, n, root, cx, path, d)
}

// _compile_mapping's validate_mapping
fn validate_mapping(env: mut ref Env, n: ref SNode, root: ref SNode, cx: ref Ctx, path: ref Vec[PathItem], d: ref Vec[(Vec[i64], Value)]) -> Result[Value, VErr] {
    let nk = n.keys.len();
    // all_required_keys, all_default_keys, and the candidates in
    // _iterate_mapping_candidates order (a stable sort)
    let mut required: Vec[bool] = Vec.new();
    let mut order: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < nk {
        let k = ref n.keys[i];
        let optional = is_marker(k.kind) and k.kind != KeyKind.Required;
        required.push(k.kind != KeyKind.Extra and ((cx.req and not optional and k.kind != KeyKind.Remove) or k.kind == KeyKind.Required));
        let mut j = order.len();
        order.push(i);
        while j > 0 and key_priority(n.keys[order[j - 1]]) > key_priority(k) {
            order[j] = order[j - 1];
            j -= 1;
        }
        order[j] = i;
        i += 1;
    }
    let mut kv: Vec[(Vec[i64], Value)] = d.clone();
    for k in n.keys.iter() {
        if is_marker(k.kind) {
            if let Some(dv) = k.default.clone() {
                if not has_key(kv, k.name) {
                    kv.push((k.name.clone(), dv));
                }
            }
        }
    }
    let mut out: Vec[(Vec[i64], Value)] = Vec.new();
    let mut errors: Vec[VErr] = Vec.new();
    for (key, value) in kv.iter() {
        let key_path = sub_path(path, PathItem.Val(Value.Str(key.clone())));
        let key_value = Value.Str(key.clone());
        // candidates_by_key.get(key, []), then additional_candidates
        let mut relevant: Vec[i64] = Vec.new();
        for ci in order.iter() {
            let k = ref n.keys[*ci];
            if k.kind != KeyKind.Validator and k.kind != KeyKind.Extra and same(k.name, key) {
                relevant.push(*ci);
            }
        }
        for ci in order.iter() {
            let k = ref n.keys[*ci];
            if k.kind == KeyKind.Validator or k.kind == KeyKind.Extra {
                relevant.push(*ci);
            }
        }
        let mut remove_key = false;
        let mut error: Option[VErr] = None;
        let mut broke = false;
        for ci in relevant.iter() {
            let k = ref n.keys[*ci];
            let mut new_key = key.clone();
            if k.kind == KeyKind.Validator {
                match validate(env, k.node[0], root, cx, key_path, key_value) {
                    Ok(Value.Str(s)) => new_key = s,
                    Ok(_) => {}
                    Err(e) => {
                        if depth(e) > key_path.len() {
                            return Err(e);
                        }
                        let deeper = match error {
                            Some(old) => depth(e) > depth(old),
                            None => true,
                        };
                        if deeper {
                            error = Some(e);
                        }
                        continue;
                    }
                }
            }
            let is_remove = k.kind == KeyKind.Remove;
            match validate(env, n.kids[*ci], root, cx, key_path, value) {
                Ok(cval) => {
                    if is_remove {
                        remove_key = true;
                        continue;
                    }
                    dict_set(mut out, new_key, cval);
                }
                Err(e) => {
                    if is_remove or remove_key {
                        continue;
                    }
                    for err in flatten(e) {
                        let typed = match err {
                            VErr.One(inv) => {
                                if inv.path.len() <= key_path.len() {
                                    VErr.One(Inv { msg: inv.msg, path: inv.path, error_type: "dictionary value".to_string() })
                                } else {
                                    VErr.One(inv)
                                }
                            }
                            many => many,
                        };
                        errors.push(typed);
                    }
                }
            }
            required[*ci] = false;
            broke = true;
            break;
        }
        if not broke {
            if remove_key {
                continue;
            }
            if cx.extra == allow_extra() {
                dict_set(mut out, key.clone(), value.clone());
            } else if let Some(e) = error {
                errors.push(e);
            } else if cx.extra != remove_extra() {
                errors.push(fail("extra keys not allowed".to_string(), key_path));
            }
        }
    }
    i = 0;
    while i < nk {
        if required[i] {
            let k = ref n.keys[i];
            let m = match key_msg(k) {
                Some(m) => m,
                None => "required key not provided".to_string(),
            };
            errors.push(fail(m, sub_path(path, key_path_item(k))));
        }
        i += 1;
    }
    if errors.len() > 0 {
        return Err(VErr.Many(errors));
    }
    Ok(Value.Dict(out))
}

// _compile_sequence's validate_sequence, for a list
fn validate_list(env: mut ref Env, n: ref SNode, root: ref SNode, cx: ref Ctx, path: ref Vec[PathItem], v: ref Value) -> Result[Value, VErr] {
    let items = match v {
        Value.List(xs) => xs,
        _ => return Err(fail("expected a list".to_string(), path)),
    };
    if n.kids.len() == 0 {
        if items.len() > 0 {
            // `path if path else data`: at the top the list itself is the path
            let p: Vec[PathItem] = if path.len() > 0 {
                path.clone()
            } else {
                items.iter().map(|x| PathItem.Val(x.clone())).collect()
            };
            let mut es: Vec[VErr] = Vec.new();
            es.push(fail("not a valid value".to_string(), p));
            return Err(VErr.Many(es));
        }
        return Ok(v.clone());
    }
    let mut out: Vec[Value] = Vec.new();
    let mut errors: Vec[VErr] = Vec.new();
    let mut i = 0;
    while i < items.len() {
        let index_path = sub_path(path, PathItem.Val(Value.Int(i)));
        let mut invalid: Option[VErr] = None;
        let mut ok = false;
        for kid in n.kids.iter() {
            match validate(env, kid, root, cx, index_path, items[i]) {
                Ok(x) => {
                    out.push(x);
                    ok = true;
                    break;
                }
                Err(e) => {
                    if depth(e) > index_path.len() {
                        return Err(e);
                    }
                    invalid = Some(e);
                }
            }
        }
        if not ok {
            if let Some(e) = invalid {
                errors.push(e);
            }
        }
        i += 1;
    }
    if errors.len() > 0 {
        return Err(VErr.Many(errors));
    }
    Ok(Value.List(out))
}

// ------------------------------------------------------------ the validators

fn number_text(v: ref Value) -> String {
    py_str(v)
}

fn bound_text(b: ref Option[Value]) -> String {
    match b {
        Some(v) => py_str(v),
        None => "None".to_string(),
    }
}

// Coerce(type)
fn coerce(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let ty = to_string(n.text);
    let bad = fail0(msg_or(n, f"expected {ty}"));
    if ty == "str" {
        return Ok(Value.Str(py_str_cps(v)));
    }
    if ty == "bool" {
        return Ok(Value.Bool(truthy(v)));
    }
    if ty == "int" {
        return match v {
            Value.Str(s) => match py_int(s) {
                Ok(x) => Ok(Value.Int(x)),
                Err(_) => Err(bad),
            },
            Value.Float(x) => {
                if *x != *x {
                    Err(bad)
                } else {
                    Ok(Value.Int(*x as i64))
                }
            }
            _ => match int_of(v) {
                Some(x) => Ok(Value.Int(x)),
                None => Err(bad),
            },
        };
    }
    match v {
        Value.Str(s) => match py_float(s) {
            Ok(x) => Ok(Value.Float(x)),
            Err(_) => Err(bad),
        },
        _ => match float_of(v) {
            Some(x) => Ok(Value.Float(x)),
            None => Err(bad),
        },
    }
}

// Boolean()
fn boolean(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    if let Value.Str(s) = v {
        let t = to_string(lower_all(s));
        if t == "1" or t == "true" or t == "yes" or t == "on" or t == "enable" {
            return Ok(Value.Bool(true));
        }
        if t == "0" or t == "false" or t == "no" or t == "off" or t == "disable" {
            return Ok(Value.Bool(false));
        }
        return Err(fail0(msg_or(n, "expected boolean".to_string())));
    }
    Ok(Value.Bool(truthy(v)))
}

// urlparse(v): the scheme and the netloc, or None where it raises
fn url_parts(s: ref Vec[i64]) -> Option[(Vec[i64], Vec[i64])] {
    let mut a = 0;
    while a < s.len() and s[a] <= 32 {
        a += 1;
    }
    let mut url: Vec[i64] = Vec.new();
    let mut k = a;
    while k < s.len() {
        if s[k] != 9 and s[k] != 10 and s[k] != 13 {
            url.push(s[k]);
        }
        k += 1;
    }
    let mut scheme: Vec[i64] = Vec.new();
    let i = index_of(url, 58);
    if i > 0 and url[0] < 128 and is_ascii_letter(url[0]) {
        let mut all_scheme = true;
        let mut j = 0;
        while j < i {
            let c = url[j];
            if not (is_ascii_letter(c) or (c >= 48 and c <= 57) or c == 43 or c == 45 or c == 46) {
                all_scheme = false;
                break;
            }
            j += 1;
        }
        if all_scheme {
            scheme = lower_all(slice(url, 0, i));
            url = slice(url, i + 1, url.len());
        }
    }
    let mut netloc: Vec[i64] = Vec.new();
    if url.len() >= 2 and url[0] == 47 and url[1] == 47 {
        let mut end = url.len();
        let mut j = 2;
        while j < url.len() {
            if url[j] == 47 or url[j] == 63 or url[j] == 35 {
                end = j;
                break;
            }
            j += 1;
        }
        netloc = slice(url, 2, end);
        if has(netloc, 91) != has(netloc, 93) {
            return None;
        }
    }
    Some((scheme, netloc))
}

// _url_validation
fn url_ok(v: ref Value, fqdn: bool) -> bool {
    match v {
        Value.Str(s) => match url_parts(s) {
            Some((scheme, netloc)) => {
                if scheme.len() == 0 or netloc.len() == 0 {
                    return false;
                }
                not fqdn or has(netloc, 46)
            }
            None => false,
        },
        _ => false,
    }
}

fn user_regex() -> Str {
    "(?:(^[-!#$%&'*+/=?^_`{}|~0-9A-Z]+(\\.[-!#$%&'*+/=?^_`{}|~0-9A-Z]+)*$|^\"([\\001-\\010\\013\\014\\016-\\037!#-\\[\\]-\\177]|\\\\[\\001-\\011\\013\\014\\016-\\177])*\"$))\\Z"
}

fn domain_regex() -> Str {
    "(?:(?:[A-Z0-9](?:[A-Z0-9-]{0,61}[A-Z0-9])?\\.)+(?:[A-Z]{2,6}\\.?|[A-Z0-9-]{2,}\\.?$)|^\\[(25[0-5]|2[0-4]\\d|[0-1]?\\d?\\d)(\\.(25[0-5]|2[0-4]\\d|[0-1]?\\d?\\d)){3}\\]$)\\Z"
}

fn re_match(env: mut ref Env, prog: i64, s: ref Vec[i64]) -> bool {
    let p = ref env.rx.progs[prog];
    let mut m = new_matcher(p, s);
    find(mut m, p, 0, false, 1).is_some()
}

// Email()
fn email_ok(env: mut ref Env, v: ref Value) -> bool {
    let s = match v {
        Value.Str(s) => s,
        _ => return false,
    };
    if s.len() == 0 or not has(s, 64) {
        return false;
    }
    let mut at = s.len() - 1;
    while s[at] != 64 {
        at -= 1;
    }
    let user = slice(s, 0, at);
    let domain = slice(s, at + 1, s.len());
    if env.user_re < 0 {
        env.user_re = rx_compile(mut env.rx, cps(user_regex()), flag_ignorecase()).unwrap_or(-1);
        env.domain_re = rx_compile(mut env.rx, cps(domain_regex()), flag_ignorecase()).unwrap_or(-1);
    }
    let (u, d) = (env.user_re, env.domain_re);
    re_match(env, u, user) and re_match(env, d, domain)
}

// IsFile, IsDir and PathExists: a falsy value is refused before the
// file system is asked
fn path_check(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let (falsy_msg, default) = match n.op {
        SOp.IsFile => ("Not a file", "Not a file"),
        SOp.IsDir => ("Not a directory", "Not a directory"),
        _ => ("Not a Path", "path does not exist"),
    };
    if not truthy(v) {
        return Err(fail0(falsy_msg.to_string()));
    }
    let p = py_str(v);
    let found = match fs.metadata(p) {
        Ok(md) => match n.op {
            SOp.IsFile => md.is_file,
            SOp.IsDir => md.is_dir,
            _ => true,
        },
        Err(_) => false,
    };
    if found {
        Ok(v.clone())
    } else {
        Err(fail0(msg_or(n, default.to_string())))
    }
}

fn compiled(env: mut ref Env, n: ref SNode) -> i64 {
    rx_compile(mut env.rx, n.text, 0).unwrap_or(-1)
}

// Range(min, max, min_included, max_included)
fn range_check(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let bad_type = fail0(msg_or(n, "invalid value or type (must have a partial ordering)".to_string()));
    if let Some(lo) = n.a.clone() {
        match py_cmp(v, lo) {
            None => return Err(bad_type),
            Some(c) => {
                if n.f1 and c < 0 {
                    return Err(fail0(msg_or(n, f"value must be at least {py_str(lo)}")));
                }
                if not n.f1 and c <= 0 {
                    return Err(fail0(msg_or(n, f"value must be higher than {py_str(lo)}")));
                }
            }
        }
    }
    if let Some(hi) = n.b.clone() {
        match py_cmp(v, hi) {
            None => return Err(bad_type),
            Some(c) => {
                if n.f2 and c > 0 {
                    return Err(fail0(msg_or(n, f"value must be at most {py_str(hi)}")));
                }
                if not n.f2 and c >= 0 {
                    return Err(fail0(msg_or(n, f"value must be lower than {py_str(hi)}")));
                }
            }
        }
    }
    Ok(v.clone())
}

// Clamp(min, max)
fn clamp(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let bad_type = fail0(msg_or(n, "invalid value or type (must have a partial ordering)".to_string()));
    let mut cur = v.clone();
    if let Some(lo) = n.a.clone() {
        match py_cmp(cur, lo) {
            None => return Err(bad_type),
            Some(c) => if c < 0 { cur = lo; },
        }
    }
    if let Some(hi) = n.b.clone() {
        match py_cmp(cur, hi) {
            None => return Err(bad_type),
            Some(c) => if c > 0 { cur = hi; },
        }
    }
    Ok(cur)
}

// Length(min, max)
fn length(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let len = match v {
        Value.Str(s) => s.len(),
        Value.List(xs) => xs.len(),
        Value.Dict(d) => d.len(),
        _ => return Err(fail0(msg_or(n, "invalid value or type".to_string()))),
    };
    if let Some(lo) = n.a.clone() {
        if let Some(m) = int_of(lo) {
            if len < m {
                return Err(fail0(msg_or(n, f"length of value must be at least {py_str(lo)}")));
            }
        }
    }
    if let Some(hi) = n.b.clone() {
        if let Some(m) = int_of(hi) {
            if len > m {
                return Err(fail0(msg_or(n, f"length of value must be at most {py_str(hi)}")));
            }
        }
    }
    Ok(v.clone())
}

// sorted(container), or sorted(container, key=str) where `<` raises
fn sorted_container(c: ref Vec[Value]) -> Vec[Value] {
    let mut comparable = true;
    let mut i = 0;
    while i < c.len() {
        let mut j = i + 1;
        while j < c.len() {
            if py_cmp(c[i], c[j]).is_none() {
                comparable = false;
            }
            j += 1;
        }
        i += 1;
    }
    let mut out: Vec[Value] = Vec.new();
    for x in c.iter() {
        let mut j = out.len();
        out.push(x.clone());
        while j > 0 {
            let later = if comparable {
                py_cmp(out[j - 1], x).unwrap_or(0) > 0
            } else {
                cmp_cps(py_str_cps(out[j - 1]), py_str_cps(x)) > 0
            };
            if not later {
                break;
            }
            out[j] = out[j - 1].clone();
            j -= 1;
        }
        out[j] = x.clone();
    }
    out
}

fn container_text(n: ref SNode) -> String {
    match n.a.clone() {
        Some(Value.List(xs)) => py_repr(Value.List(sorted_container(xs))),
        _ => "[]".to_string(),
    }
}

fn member(n: ref SNode, v: ref Value) -> bool {
    match n.a.clone() {
        Some(Value.List(xs)) => {
            for x in xs.iter() {
                if py_eq(x, v) {
                    return true;
                }
            }
            false
        }
        _ => false,
    }
}

fn hashable(v: ref Value) -> bool {
    match v {
        Value.List(_) => false,
        Value.Dict(_) => false,
        _ => true,
    }
}

// `item in v`, or None where it raises TypeError
fn contains(v: ref Value, item: ref Value) -> Option[bool] {
    match v {
        Value.Str(s) => match item {
            Value.Str(t) => Some(contains_seq(s, t)),
            _ => None,
        },
        Value.List(xs) => {
            for x in xs.iter() {
                if py_eq(x, item) {
                    return Some(true);
                }
            }
            Some(false)
        }
        Value.Dict(d) => {
            if not hashable(item) {
                return None;
            }
            match item {
                Value.Str(t) => Some(has_key(d, t)),
                _ => Some(false),
            }
        }
        _ => None,
    }
}

// what set(v) iterates over, or the TypeError it raises
fn set_items(v: ref Value) -> Result[Vec[Value], String] {
    match v {
        Value.Str(s) => {
            let mut out: Vec[Value] = Vec.new();
            for c in s {
                let mut one: Vec[i64] = Vec.new();
                one.push(c);
                out.push(Value.Str(one));
            }
            Ok(out)
        }
        Value.List(xs) => {
            for x in xs.iter() {
                if not hashable(x) {
                    return Err(f"unhashable type: '{type_of(x)}'");
                }
            }
            Ok(xs.clone())
        }
        Value.Dict(d) => Ok(d.iter().map(|kv| Value.Str(kv.0.clone())).collect()),
        _ => Err(f"'{type_of(v)}' object is not iterable"),
    }
}

// Unique()
fn unique(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let items = match set_items(v) {
        Ok(xs) => xs,
        Err(e) => return Err(fail0(msg_or(n, f"contains unhashable elements: {e}"))),
    };
    let mut seen: Vec[Value] = Vec.new();
    let mut dupes: Vec[Value] = Vec.new();
    for x in items.iter() {
        let mut in_seen = false;
        for s in seen.iter() {
            if py_eq(s, x) {
                in_seen = true;
            }
        }
        if in_seen {
            let mut known = false;
            for dd in dupes.iter() {
                if py_eq(dd, x) {
                    known = true;
                }
            }
            if not known {
                dupes.push(x.clone());
            }
        } else {
            seen.push(x.clone());
        }
    }
    if dupes.len() > 0 {
        return Err(fail0(msg_or(n, f"contains duplicate items: {py_repr(Value.List(dupes))}")));
    }
    Ok(v.clone())
}

// Decimal(v).as_tuple(): the number of digits and the exponent, or None
// for InvalidOperation
fn decimal_parts(v: ref Value) -> Option[(i64, i64)] {
    let t = match v {
        Value.Str(s) => strip(s),
        _ => match int_of(v) {
            Some(x) => {
                let digits = if x == 0 { 1 } else { f"{if x < 0 { -x } else { x }}".len() };
                return Some((digits, 0));
            }
            None => return None,
        },
    };
    let mut i = 0;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        i += 1;
    }
    let mut coeff: Vec[i64] = Vec.new();
    let mut frac = 0;
    let mut seen_digit = false;
    let mut seen_point = false;
    while i < t.len() {
        let c = t[i];
        if c >= 48 and c <= 57 {
            coeff.push(c);
            seen_digit = true;
            if seen_point {
                frac += 1;
            }
        } else if c == 46 and not seen_point {
            seen_point = true;
        } else if c == 95 and i > 0 and is_ascii_digit(t[i - 1]) and i + 1 < t.len() and is_ascii_digit(t[i + 1]) {
            // an underscore between digits
        } else {
            break;
        }
        i += 1;
    }
    if not seen_digit {
        return None;
    }
    let mut exp = 0;
    if i < t.len() and (t[i] == 101 or t[i] == 69) {
        i += 1;
        let mut neg = false;
        if i < t.len() and (t[i] == 43 or t[i] == 45) {
            neg = t[i] == 45;
            i += 1;
        }
        let start = i;
        while i < t.len() and is_ascii_digit(t[i]) {
            exp = exp * 10 + t[i] - 48;
            i += 1;
        }
        if i == start {
            return None;
        }
        if neg {
            exp = -exp;
        }
    }
    if i != t.len() {
        return None;
    }
    let mut lead = 0;
    while lead + 1 < coeff.len() and coeff[lead] == 48 {
        lead += 1;
    }
    Some((coeff.len() - lead, exp - frac))
}

// Number(precision, scale)
fn number(n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let (precision, exp) = match decimal_parts(v) {
        Some(p) => p,
        None => return Err(fail0(msg_or(n, "Value must be a number enclosed with string".to_string()))),
    };
    let scale = -exp;
    if n.n1 >= 0 and n.n2 >= 0 and precision != n.n1 and scale != n.n2 {
        return Err(fail0(msg_or(n, f"Precision must be equal to {n.n1}, and Scale must be equal to {n.n2}")));
    }
    if n.n1 >= 0 and precision != n.n1 {
        return Err(fail0(msg_or(n, f"Precision must be equal to {n.n1}")));
    }
    if n.n2 >= 0 and scale != n.n2 {
        return Err(fail0(msg_or(n, f"Scale must be equal to {n.n2}")));
    }
    Ok(v.clone())
}

// ExactSequence(validators)
fn exact_sequence(env: mut ref Env, n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let bad = fail0(msg_or(n, "None".to_string()));
    let items = match v {
        Value.List(xs) => xs,
        _ => return Err(bad),
    };
    if items.len() != n.kids.len() {
        return Err(bad);
    }
    let mut out: Vec[Value] = Vec.new();
    let mut i = 0;
    while i < items.len() {
        match fresh(env, n.kids[i], items[i]) {
            Ok(x) => out.push(x),
            Err(e) => {
                return match n.msg {
                    None => Err(e),
                    Some(_) => Err(bad),
                };
            }
        }
        i += 1;
    }
    Ok(Value.List(out))
}

// Unordered(validators)
fn unordered(env: mut ref Env, n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    let items = match v {
        Value.List(xs) => xs,
        _ => return Err(fail0(msg_or(n, f"Value {py_str(v)} is not sequence!"))),
    };
    if items.len() != n.kids.len() {
        return Err(fail0(msg_or(n, f"List lengths differ, value:{items.len()} != target:{n.kids.len()}")));
    }
    let mut consumed: Vec[bool] = Vec.filled(n.kids.len(), false);
    let mut missing: Vec[VErr] = Vec.new();
    let mut index = 0;
    while index < items.len() {
        let mut found = false;
        let mut i = 0;
        while i < n.kids.len() {
            if not consumed[i] {
                if fresh(env, n.kids[i], items[index]).is_ok() {
                    found = true;
                    consumed[i] = true;
                    break;
                }
            }
            i += 1;
        }
        if not found {
            missing.push(fail0(msg_or(n, f"Element #{index} ({py_str(items[index])}) is not valid against any validator")));
        }
        index += 1;
    }
    if missing.len() == 1 {
        return Err(missing.remove(0));
    }
    if missing.len() > 1 {
        return Err(VErr.Many(missing));
    }
    Ok(v.clone())
}

fn title(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut prev_cased = false;
    for c in s {
        out.push(if prev_cased { lower(c, false) } else { upper(c, false) });
        prev_cased = is_alpha_cp(c);
    }
    out
}

fn capitalize(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut first = true;
    for c in s {
        out.push(if first { upper(c, false) } else { lower(c, false) });
        first = false;
    }
    out
}

// pattern.sub(substitution, v)
fn re_sub(env: mut ref Env, n: ref SNode, s: ref Vec[i64]) -> Vec[i64] {
    let k = compiled(env, n);
    let prog = ref env.rx.progs[k];
    let pieces = match parse_template(n.text2, prog) {
        Ok(p) => p,
        Err(_) => return s.clone(),
    };
    let ms = all_matches(prog, s, 0);
    let mut result: Vec[i64] = Vec.new();
    let mut i = 0;
    for m in ms.iter() {
        push_all(mut result, slice(s, i, m.start));
        expand(pieces, s, m, mut result);
        i = m.end;
    }
    push_all(mut result, slice(s, i, s.len()));
    result
}

// A callable validator, called as schema(data): its errors carry no
// path, and validate_callable prepends it.
fn call(env: mut ref Env, n: ref SNode, v: ref Value) -> Result[Value, VErr] {
    match n.op {
        SOp.Msg => match fresh(env, n.kids[0], v) {
            Ok(x) => Ok(x),
            Err(e) => {
                if depth(e) > 1 {
                    Err(e)
                } else {
                    Err(fail0(n.msg.clone().unwrap_or(String.new())))
                }
            }
        },
        SOp.Coerce => coerce(n, v),
        SOp.Boolean => boolean(n, v),
        SOp.IsTrue => if truthy(v) { Ok(v.clone()) } else { Err(fail0(msg_or(n, "value was not true".to_string()))) },
        SOp.IsFalse => if truthy(v) { Err(fail0(msg_or(n, "value was not false".to_string()))) } else { Ok(v.clone()) },
        SOp.Email => if email_ok(env, v) { Ok(v.clone()) } else { Err(fail0(msg_or(n, "expected an email address".to_string()))) },
        SOp.Url => if url_ok(v, false) { Ok(v.clone()) } else { Err(fail0(msg_or(n, "expected a URL".to_string()))) },
        SOp.FqdnUrl => {
            if url_ok(v, true) {
                Ok(v.clone())
            } else {
                Err(fail0(msg_or(n, "expected a fully qualified domain name URL".to_string())))
            }
        }
        SOp.IsFile | SOp.IsDir | SOp.PathExists => path_check(n, v),
        SOp.Match => {
            let s = match v {
                Value.Str(s) => s,
                _ => return Err(fail0("expected string or buffer".to_string())),
            };
            let k = compiled(env, n);
            if re_match(env, k, s) {
                Ok(v.clone())
            } else {
                Err(fail0(msg_or(n, f"does not match regular expression {to_string(n.text)}")))
            }
        }
        SOp.Replace => match v {
            Value.Str(s) => Ok(Value.Str(re_sub(env, n, s))),
            _ => Err(fail0("expected string or bytes-like object".to_string())),
        },
        SOp.Range => range_check(n, v),
        SOp.Clamp => clamp(n, v),
        SOp.Length => length(n, v),
        SOp.Datetime | SOp.Date => {
            let ok = match v {
                Value.Str(s) => strptime(mut env.rx, s, n.text).is_ok(),
                _ => false,
            };
            if ok {
                Ok(v.clone())
            } else {
                Err(fail0(msg_or(n, f"value does not match expected format {to_string(n.text)}")))
            }
        }
        SOp.In => {
            if member(n, v) {
                Ok(v.clone())
            } else {
                Err(fail0(msg_or(n, f"value must be one of {container_text(n)}")))
            }
        }
        SOp.NotIn => {
            if member(n, v) {
                Err(fail0(msg_or(n, f"value must not be one of {container_text(n)}")))
            } else {
                Ok(v.clone())
            }
        }
        SOp.Contains => {
            let item = n.a.clone().unwrap_or(Value.Null);
            match contains(v, item) {
                Some(true) => Ok(v.clone()),
                _ => Err(fail0(msg_or(n, "value is not allowed".to_string()))),
            }
        }
        SOp.ExactSequence => exact_sequence(env, n, v),
        SOp.Unordered => unordered(env, n, v),
        SOp.Unique => unique(n, v),
        SOp.Equal => {
            let target = n.a.clone().unwrap_or(Value.Null);
            if py_eq(v, target) {
                Ok(v.clone())
            } else {
                Err(fail0(msg_or(n, f"Values are not equal: value:{py_str(v)} != target:{py_str(target)}")))
            }
        }
        SOp.Number => number(n, v),
        SOp.Lower => Ok(Value.Str(lower_all(py_str_cps(v)))),
        SOp.Upper => Ok(Value.Str(upper_all(py_str_cps(v)))),
        SOp.Capitalize => Ok(Value.Str(capitalize(py_str_cps(v)))),
        SOp.Title => Ok(Value.Str(title(py_str_cps(v)))),
        SOp.Strip => Ok(Value.Str(strip(py_str_cps(v)))),
        SOp.DefaultTo => match v {
            Value.Null => Ok(n.a.clone().unwrap_or(Value.Null)),
            _ => Ok(v.clone()),
        },
        SOp.SetTo => Ok(n.a.clone().unwrap_or(Value.Null)),
        SOp.Literal => {
            let lit = n.a.clone().unwrap_or(Value.Null);
            if py_eq(lit, v) {
                Ok(lit)
            } else {
                Err(fail0(f"{py_str(v)} not match for {py_str(lit)}"))
            }
        }
        _ => Err(fail0("unsupported validator".to_string())),
    }
}

// ------------------------------------------------------------ jobs

fn run_one(env: mut ref Env, count: mut ref i64, label: ref String, s: ref Sch, data: ref Value) {
    *count += 1;
    match run_schema(env, s, data) {
        Ok(out) => {
            println(f"job {*count} {label}: valid");
            println(f"  {sorted_repr(out)}");
        }
        Err(e) => {
            let k = match e {
                VErr.Many(es) => es.len(),
                VErr.One(_) => 1,
            };
            println(f"job {*count} {label}: {k} error{if k == 1 { "" } else { "s" }}");
            for line in humanize(data, e).split("\n") {
                println(f"  {line}");
            }
        }
    }
}

fn load_doc(path: ref String) -> Result[Value, String] {
    match fs.read_to_string(f"data/{path}") {
        Ok(t) => parse_json(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn run_jobs() -> Result[(), String] {
    let schemas_text = match fs.read_to_string("data/schemas.json".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read schemas.json: {e}"),
    };
    let schemas = load_schemas(schemas_text)?;
    let jobs = match fs.read_to_string("data/jobs.jsonl".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read jobs.jsonl: {e}"),
    };
    let mut env = Env { rx: new_rx(), user_re: -1, domain_re: -1 };
    let mut count = 0;
    for line in jobs.lines() {
        let job = parse_json(line.to_string())?;
        let infer_path = to_string(get_text(job, "infer"));
        if infer_path.len() > 0 {
            let inferred = Sch { name: "inferred".to_string(), root: infer(load_doc(infer_path)?), required: false, extra: prevent_extra() };
            count += 1;
            println(f"job {count} infer {infer_path}");
            println(f"  {schema_str(inferred.root)}");
            if let Some(Value.List(checks)) = get(job, "check") {
                for c in checks.iter() {
                    let p = py_str(c);
                    let doc = load_doc(p)?;
                    run_one(mut env, mut count, f"inferred {p}", inferred, doc);
                }
            }
            continue;
        }
        let name = to_string(get_text(job, "schema"));
        let k = find_schema(schemas, name);
        if k < 0 {
            return Err(f"unknown schema {name}");
        }
        let s = ref schemas[k];
        let file = to_string(get_text(job, "file"));
        if file.len() > 0 {
            let doc = load_doc(file)?;
            if get_flag(job, "each", false) {
                if let Value.List(docs) = doc {
                    let mut i = 0;
                    while i < docs.len() {
                        run_one(mut env, mut count, f"{name} {file}[{i}]", s, docs[i]);
                        i += 1;
                    }
                }
            } else {
                run_one(mut env, mut count, f"{name} {file}", s, doc);
            }
        } else {
            let data = get(job, "data").unwrap_or(Value.Null);
            run_one(mut env, mut count, f"{name}({sorted_repr(data)})", s, data);
        }
    }
    Ok(())
}

// --------------------------------------------------------------- data

struct DataFile {
    path: String,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    if fs.exists("data") {
        if fs.remove_dir_all("data").is_err() {
            return Err("cannot remove the old data/".to_string());
        }
    }
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run_jobs() {
        eprintln(e);
    }
    let _ = fs.remove_dir_all("data");
}

// ------------------------------------------------------------- data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    v
}

