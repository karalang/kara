fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("rules.v4".to_string(), file_0()));
    v.push(("broken-option.v4".to_string(), file_1()));
    v.push(("broken-target.v4".to_string(), file_2()));
    v.push(("broken-commit.v4".to_string(), file_3()));
    v.push(("jobs.txt".to_string(), file_4()));
    v
}

fn write_data() -> Result[(), String] {
    let _ = fs.remove_dir_all("data".to_string());
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"{e}");
    }
    for (name, text) in data_files() {
        if let Err(e) = fs.write(f"data/{name}", text) {
            return Err(f"{e}");
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let mut tables: Vec[Table] = Vec.new();
    tables.push(new_table("nat"));
    tables.push(new_table("filter"));
    let mut conns: Vec[Conn] = Vec.new();
    for line in read_file("data/jobs.txt").split("\n") {
        if line.is_empty() or line.starts_with("#") {
            continue;
        }
        println(f"$ {line}");
        let words = tokenize(line.as_str());
        let mut code = 0;
        let cmd = words[0].as_str();
        if cmd == "iptables-restore" {
            code = restore(mut tables, f"data/{words[1]}".as_str());
        } else if cmd == "iptables" {
            if let Err(e) = cmd_iptables(mut tables, words[1..].to_vec()) {
                if e.code == 2 {
                    println(f"iptables {VERSION}: {e.msg}");
                    println("");
                    println("Try `iptables -h' or 'iptables --help' for more information.");
                } else {
                    println(f"iptables: {e.msg}");
                }
                code = e.code;
            }
        } else if cmd == "iptables-save" {
            save(tables);
        } else if cmd == "conntrack" {
            conntrack_list(conns);
        } else if cmd == "packet" {
            packet(mut tables, mut conns, line.as_str());
        }
        if code != 0 {
            println(f"(exit status {code})");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(f"error: {e}");
    }
}
