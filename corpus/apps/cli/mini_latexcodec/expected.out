== lexer
> lex strict b"\\foo  bar \\' e \\\\ x \\% y %c\nz #1 #a $m$ $$d$$ -- --- ``q'' ?` !`"
  control_word:'\\foo'
  chars:'b'
  chars:'a'
  chars:'r'
  space:' '
  control_symbol:"\\'"
  chars:'e'
  space:' '
  control_symbol_x2:'\\\\'
  space:' '
  chars:'x'
  space:' '
  control_symbol_x2:'\\%'
  space:' '
  chars:'y'
  space:' '
  chars:'z'
  space:' '
  parameter:'#1'
  space:' '
  parameter:'#'
  chars:'a'
  space:' '
  mathshift:'$'
  chars:'m'
  mathshift:'$'
  space:' '
  mathshift:'$$'
  chars:'d'
  mathshift:'$$'
  space:' '
  chars:'--'
  space:' '
  chars:'---'
  space:' '
  chars:'``'
  chars:'q'
  chars:"''"
  space:' '
  chars:'?`'
  space:' '
  chars:'!`'
  state M inline_math False
> lex strict b'a\n\nb\n  c\t\\par\n'
  chars:'a'
  space:' '
  control_word:'\\par'
  chars:'b'
  space:' '
  chars:'c'
  space:'\t'
  control_word:'\\par'
  state N inline_math False
> lex strict b'\\1 \\@ \\ \\~ \\= \\^ \\! \\. \\" \\` \\{'
  control_symbol_x:'\\1'
  space:' '
  control_symbol_x:'\\@'
  space:' '
  control_symbol:'\\ '
  control_symbol:'\\~'
  control_symbol:'\\='
  control_symbol:'\\^'
  control_symbol:'\\!'
  control_symbol:'\\.'
  control_symbol:'\\"'
  control_symbol:'\\`'
  control_symbol_x:'\\{'
