== encode basics
> enc latex strict 'M\xfcller'
  -> b'M\\"uller'
> enc latex strict 'Erd\u0151s, P\xe1l'
  -> b"Erd\\H os, P\\'al"
> enc latex strict '\xc5ngstr\xf6m'
  -> b'\\AA ngstr\\"om'
> enc latex strict '\xe5 b\xe5b\xe5'
  -> b'\\aa\\ b\\aa b\\aa'
> enc latex strict '100% & #1 _x_ $5 {braces} \\back ~tilde ^hat'
  -> b'100\\% \\& \\#1 \\_x\\_ $5 {braces} \\back \\textasciitilde tilde ^hat'
> enc latex strict 'Stra\xdfe and \u0152uvre, \xe6ther, \xf8'
  -> b'Stra\\ss e and \\OE uvre, \\ae ther, \\o'
> enc latex strict '\u201cquoted\u201d \u2013 \u2014 \u2026 \u2018single\u2019 \xabguillemets\xbb'
  -> b"``quoted'' -- --- \\ldots\\ `single' \\guillemotleft guillemets\\guillemotright"
> enc latex strict '\u03b1 \u03b2 \u03b3 \u03a9 \u221e \u2264 \u2265 \u2260 \u2211'
  -> b'$\\alpha$ $\\beta$ $\\gamma$ $\\Omega$ $\\infty$ $\\leq$ $\\geq$ $\\neq$ $\\sum$'
> enc latex strict '\ufb01ne \ufb02ow \ufb00 \ufb03 \ufb06'
  -> b'fine flow ff ffi st'
> enc latex strict '\xa9 \xae \u2122 \xb0 \xb1 \xb2 \xb5 \xb6 \xb7 \xbf \xa1'
  -> b'\\copyright\\ \\textregistered\\ $^{TM}$ $^\\circ$ $\\pm$ $^2$ $\\mu$ \\P\\ $\\cdot$ ?` !`'
> enc latex strict 'tab\there\nnewline\r\nCRLF'
  -> b'tab\there\nnewline\r\nCRLF'
> enc latex strict '\u200b\u200c\u200d\u2009\u2003 \ufffd \xa0 \xad'
  -> b'\\hspace{0pt}{} \\quad\\ ???? ~ \\-'
> enc latex strict ''
  -> b''
> enc latex strict 'plain ASCII text 123'
  -> b'plain ASCII text 123'
> enc latex strict '\\'
  -> b'\\'
> enc latex strict '\\\\ two'
  -> b'\\\\ two'
> enc latex strict 'e\u0301 combining'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\u0301' in position 0: don't know how to translate '\u0301' into latex
> enc latex strict '\u216b'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\u216b' in position 0: don't know how to translate '\u216b' into latex
== encode errors
> enc latex strict 'snow \u2603 man'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\u2603' in position 0: don't know how to translate '\u2603' into latex
> enc latex strict '\u20ac 12'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\u20ac' in position 0: don't know how to translate '\u20ac' into latex
> enc latex strict 'emoji \U0001f600'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\U0001f600' in position 0: don't know how to translate '\U0001f600' into latex
> enc latex strict 'sep\u2028line'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\u2028' in position 0: don't know how to translate '\\u2028' into latex
> enc latex ignore 'snow \u2603 man \u20ac 12'
  -> b'snow  man  12'
> enc latex ignore '\\aa \u2603b'
  -> b'\\aa b'
> enc latex replace 'snow \u2603 man \u20ac 12 \U0001f600'
  -> b'snow {\\char9731} man {\\char8364} 12 {\\char128512}'
> enc latex keep 'snow \u2603 man'
  error LookupError: unknown error handler name 'keep'
> enc latex keep 'ascii only'
  -> b'ascii only'
> enc ulatex keep 'snow \u2603 man'
  -> 'snow \u2603 man'
> enc latex backslashreplace '\u2603'
  error ValueError: latex codec does not support backslashreplace errors
> enc latex backslashreplace 'ok'
  -> b'ok'
> enc ulatex foo '\xe9 \u2603'
  error ValueError: latex codec does not support foo errors
== encode inputenc
> enc latex+latin1 strict 'M\xfcller, Erd\u0151s, \xbd, \u2603'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\u2603' in position 0: don't know how to translate '\u2603' into latex
> enc latex+latin1 replace 'M\xfcller, Erd\u0151s, \xbd, \u2603'
  -> b'M\xfcller, Erd\\H os, \xbd, {\\char9731}'
> enc latex+utf8 strict 'M\xfcller, Erd\u0151s, \u2603 \U0001f600 & 100%'
  -> b'M\xc3\xbcller, Erd\xc5\x91s, \xe2\x98\x83 \xf0\x9f\x98\x80 \\& 100\\%'
> enc latex+utf-8 strict '\xc5ngstr\xf6m'
  -> b'\xc3\x85ngstr\xc3\xb6m'
> enc latex+latin-1 strict '\xc5ngstr\xf6m \u0152'
  -> b'\xc5ngstr\xf6m \\OE'
> enc latex_utf8 strict '\xe9'
  -> b'\xc3\xa9'
> enc latex-utf8 strict '\xe9'
  -> b'\xc3\xa9'
> enc latex+cp1252 strict '\u201c\u20ac\u201d \u0152 \xbd'
  -> b'\x93\x80\x94 \x8c \xbd'
> enc latex+ascii strict '\xe9'
  -> b"\\'e"
> enc latex+ strict '\xe9'
  -> b"\\'e"
> enc LaTeX strict '\xe9'
  -> b"\\'e"
> enc ulatex+utf8 strict '\xe9 \u2603 \\'
  -> '\xe9 \u2603 \\'
> enc ulatex+latin1 strict '\xe9 \u0151'
  -> '\xe9 \\H o'
> enc ulatex strict '\xe9 \u0151'
  -> "\\'e \\H o"
> enc latex+klingon strict 'a'
  error LookupError: unknown encoding: klingon
> enc latex+klingon strict '&'
  error LookupError: unknown encoding: klingon
> enc latex++x strict '&\xe9'
  error LookupError: unknown encoding: x
> enc latexx strict 'a'
  error LookupError: unknown encoding: latexx
> enc latex.utf8 strict 'a'
  error LookupError: unknown encoding: latex.utf8
> enc latex+utf8+x strict '\xe9'
  error LookupError: unknown encoding: utf8_x
== str api
> strenc latex strict 'M\xfcller'
  -> b'M\\"uller'
> strenc latex+utf8 strict 'M\xfcller \u2603'
  -> b'M\xc3\xbcller \xe2\x98\x83'
> strenc ulatex strict 'M\xfcller'
  error TypeError: 'ulatex' encoder returned 'str' instead of 'bytes'; use codecs.encode() to encode to arbitrary types
> strenc latex strict '\u2603'
  error UnicodeEncodeError: 'latex' codec can't encode character '\\u2603' in position 0: don't know how to translate '\u2603' into latex
> bdec latex strict b'M\\"{u}ller'
  -> 'M{\xfc}ller'
> bdec latex+latin1 strict b"G\xf6del \\'e"
  -> 'G\xf6del \xe9'
> bdec ulatex strict b'abc'
  error TypeError: cannot use a string pattern on a bytes-like object
> bdec latex strict b'\\'
  error UnicodeDecodeError: 'latex' codec can't decode byte 0x5c in position 0: unknown token '\\\\'
== decode basics
> dec latex strict b'M\\"uller and M{\\"u}ller and M\\"{u}ller'
  -> 'M\xfcller and M{\xfc}ller and M{\xfc}ller'
> dec latex strict b"Erd\\H{o}s, P\\'al, Fran\\c cois, Fran\\c{c}ois"
  -> 'Erd{\u0151}s, P\xe1l, Fran\xe7ois, Fran{\xe7}ois'
> dec latex strict b'\\AA ngstr\\"om, \\aa, Stra\\ss e, \\o, \\ae\\ \\oe'
  -> '\xc5ngstr\xf6m, \xe5, Stra\xdfe, \xf8, \xe6 \u0153'
