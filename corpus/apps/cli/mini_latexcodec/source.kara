// mini_latexcodec: a port of latexcodec 3.0.1 (MIT, Matthias C. M.
// Troffaes), the codec that bibliography tools such as pybtex use to turn
// LaTeX markup into Unicode and back, run as a university library's
// bibliography desk. The jobs encode and decode text through the `latex`
// and `ulatex` codecs, incrementally and in one go, lex LaTeX, and read,
// write and convert files held in a small in-memory file system. See
// README.md.

// ------------------------------------------------------------ Python str helpers

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

// str.isprintable(), for the characters the jobs hold.
fn py_printable(c: char) -> bool {
    let n = c as i64;
    if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x206f) or n == 0x3000 or n == 0xfeff or (n >= 0xfff9 and n <= 0xfffb) {
        return false;
    }
    not (n >= 0xe000 and n <= 0xf8ff)
}

fn char_esc(n: i64) -> String {
    if n < 0x100 {
        f"\\x{hex_digits(n, 2)}"
    } else if n < 0x10000 {
        f"\\u{hex_digits(n, 4)}"
    } else {
        f"\\U{hex_digits(n, 8)}"
    }
}

fn quote_of(s: ref String) -> char {
    if s.contains("'") and not s.contains("\"") { '"' } else { '\'' }
}

// repr() of a str, or ascii() of it when `all` is set.
fn str_repr(s: ref String, all: bool) -> String {
    let q = quote_of(s);
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if all and n >= 0x7f {
            out.push_str(char_esc(n));
        } else if py_printable(c) {
            out.push(c);
        } else {
            out.push_str(char_esc(n));
        }
    }
    out.push(q);
    out
}

fn py_repr(s: ref String) -> String {
    str_repr(s, false)
}

fn py_ascii(s: ref String) -> String {
    str_repr(s, true)
}

// ascii() without its quotes: how the output shows any text.
fn vis(s: ref String) -> String {
    let cs: Vec[char] = py_ascii(s).chars().collect();
    chars_str(cs, 1, cs.len() - 1)
}

// repr() of bytes.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut sq = false;
    let mut dq = false;
    for x in b {
        if *x == 39 {
            sq = true;
        }
        if *x == 34 {
            dq = true;
        }
    }
    let q: i64 = if sq and not dq { 34 } else { 39 };
    let mut out = "b".to_string();
    out.push(char.try_from(q as u32).unwrap());
    for x in b {
        let n = *x as i64;
        if n == q or n == 92 {
            out.push('\\');
            out.push(char.try_from(n as u32).unwrap());
        } else if n == 9 {
            out.push_str("\\t");
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n < 32 or n >= 127 {
            out.push_str(f"\\x{hex_digits(n, 2)}");
        } else {
            out.push(char.try_from(n as u32).unwrap());
        }
    }
    out.push(char.try_from(q as u32).unwrap());
    out
}

fn chs(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn chars_str(s: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    for i in a..b {
        out.push(s[i]);
    }
    out
}

fn char_count(s: ref String) -> i64 {
    let mut n = 0;
    for _ in s.chars() {
        n += 1;
    }
    n
}

fn one_char(c: char) -> String {
    let mut s = String.new();
    s.push(c);
    s
}

fn push_cp(out: mut ref String, cp: i64) {
    out.push(char.try_from(cp as u32).unwrap());
}

fn utf8_of(s: ref String) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for x in s.bytes() {
        out.push(x);
    }
    out
}

fn lower_ascii(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(char.try_from(c as u32 + 32).unwrap());
        } else {
            out.push(c);
        }
    }
    out
}

fn is_letter(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_dig(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn hex_val(c: char) -> i64 {
    if is_dig(c) {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else {
        c as i64 - 55
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs = chs(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn sort_strings(xs: mut ref Vec[String]) {
    for i in 1..xs.len() {
        let mut j = i;
        while j > 0 and xs[j - 1] > xs[j] {
            let t = xs[j - 1].clone();
            xs[j - 1] = xs[j].clone();
            xs[j] = t;
            j -= 1;
        }
    }
}

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: ref String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.clone() }
}

// ------------------------------------------------------------ the input encodings
//
// latexcodec checks each character against its input encoding and decodes
// bytes through it, so the port carries the four encodings the jobs name.

enum Codec {
    U8,
    Ascii,
    L1,
    Cp1252,
}

// The normalization codecs.lookup applies to a name before the search
// functions see it: ASCII lower case, runs of other characters than
// letters, digits and '.' become one '_', none at either end.
fn norm_encoding(name: ref String) -> String {
    let mut out = String.new();
    let mut pending = false;
    for c in lower_ascii(name).chars() {
        let alnum = (c >= 'a' and c <= 'z') or is_dig(c) or c == '.';
        if alnum {
            if pending and out.len() > 0 {
                out.push('_');
            }
            pending = false;
            out.push(c);
        } else {
            pending = true;
        }
    }
    out
}

fn in_list(k: ref String, xs: ref Vec[Str]) -> bool {
    for x in xs {
        if *k == *x {
            return true;
        }
    }
    false
}

fn codec_lookup(name: ref String) -> Result[Codec, Exc] {
    let k = norm_encoding(name);
    if in_list(k, vec!["utf_8", "utf8", "u8", "utf", "cp65001"]) {
        return Ok(Codec.U8);
    }
    if in_list(k, vec!["ascii", "us_ascii", "646", "ansi_x3.4_1968", "cp367", "us"]) {
        return Ok(Codec.Ascii);
    }
    if in_list(k, vec!["latin_1", "latin1", "latin", "l1", "iso8859_1", "iso_8859_1", "8859", "cp819", "iso_ir_100"]) {
        return Ok(Codec.L1);
    }
    if in_list(k, vec!["cp1252", "windows_1252", "1252"]) {
        return Ok(Codec.Cp1252);
    }
    Err(unknown_encoding(name))
}

fn unknown_encoding(name: ref String) -> Exc {
    exc("LookupError", f"unknown encoding: {name}")
}

fn handler_err(errors: ref String) -> Exc {
    exc("LookupError", f"unknown error handler name '{errors}'")
}

fn codec_name(c: ref Codec) -> Str {
    match c {
        Codec.U8 => "utf-8",
        Codec.Ascii => "ascii",
        Codec.L1 => "latin-1",
        Codec.Cp1252 => "charmap",
    }
}

// The cp1252 characters of bytes 0x80..0x9f; 0 where the byte is undefined.
fn cp1252_high() -> Vec[i64] {
    vec![0x20ac, 0, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021, 0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0, 0x017d, 0,
         0, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014, 0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0, 0x017e, 0x0178]
}

// The bytes of one character, or false if the codec cannot encode it.
fn encode_char(codec: ref Codec, c: char, out: mut ref Vec[u8]) -> bool {
    let n = c as i64;
    match codec {
        Codec.U8 => {
            for x in one_char(c).bytes() {
                out.push(x);
            }
            true
        }
        Codec.Ascii => {
            if n < 128 {
                out.push(n as u8);
            }
            n < 128
        }
        Codec.L1 => {
            if n < 256 {
                out.push(n as u8);
            }
            n < 256
        }
        Codec.Cp1252 => {
            if n < 0x80 or (n >= 0xa0 and n < 0x100) {
                out.push(n as u8);
                return true;
            }
            let high = cp1252_high();
            for i in 0..32 {
                if high[i] == n {
                    out.push((0x80 + i) as u8);
                    return true;
                }
            }
            false
        }
    }
}

fn encodable(codec: ref Codec, c: char) -> bool {
    let mut scratch: Vec[u8] = Vec.new();
    encode_char(codec, c, mut scratch)
}

// str.encode(codec, errors).
fn encode_text(codec: ref Codec, s: ref String, errors: ref String) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    for c in s.chars() {
        if not encode_char(codec, c, mut out) {
            if *errors == "strict" {
                let why = match codec {
                    Codec.Ascii => "ordinal not in range(128)",
                    Codec.L1 => "ordinal not in range(256)",
                    _ => "character maps to <undefined>",
                };
                return Err(exc("UnicodeEncodeError", f"'{codec_name(codec)}' codec can't encode character '{char_esc(c as i64)}' in position {i}: {why}"));
            } else if *errors == "replace" {
                out.push(63);
            } else if *errors != "ignore" {
                return Err(handler_err(errors));
            }
        }
        i += 1;
    }
    Ok(out)
}

fn decode_err(codec: Str, a: i64, b: i64, bytes: ref Vec[u8], reason: Str) -> Exc {
    if b == a {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode byte 0x{hex_digits(bytes[a] as i64, 2)} in position {a}: {reason}")
    } else {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode bytes in position {a}-{b}: {reason}")
    }
}

// codecs.getincrementaldecoder(codec)(errors): only utf-8 keeps bytes
// between calls, the start of a character split across chunks.
struct ByteDec {
    codec: Codec,
    errors: String,
    pending: Vec[u8],
}

fn bad_bytes(d: ref ByteDec, out: mut ref String, b: ref Vec[u8], a: i64, e: i64, reason: Str) -> Result[(), Exc] {
    if d.errors == "strict" {
        return Err(decode_err(codec_name(d.codec), a, e - 1, b, reason));
    }
    if d.errors == "replace" {
        push_cp(mut out, 0xfffd);
        return Ok(());
    }
    if d.errors == "ignore" {
        return Ok(());
    }
    Err(handler_err(d.errors))
}

fn bd_decode(d: mut ref ByteDec, input: ref Vec[u8], fin: bool) -> Result[String, Exc] {
    let mut b = d.pending.clone();
    for x in input {
        b.push(*x);
    }
    d.pending = Vec.new();
    let n = b.len();
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        let x = b[i] as i64;
        let is_u8 = match d.codec {
            Codec.U8 => true,
            _ => false,
        };
        if not is_u8 {
            if x < 0x80 {
                push_cp(mut out, x);
            } else {
                match d.codec {
                    Codec.L1 => push_cp(mut out, x),
                    Codec.Ascii => bad_bytes(d, mut out, b, i, i + 1, "ordinal not in range(128)")?,
                    _ => {
                        let high = cp1252_high();
                        if x < 0xa0 and high[x - 0x80] == 0 {
                            bad_bytes(d, mut out, b, i, i + 1, "character maps to <undefined>")?;
                        } else if x < 0xa0 {
                            push_cp(mut out, high[x - 0x80]);
                        } else {
                            push_cp(mut out, x);
                        }
                    }
                }
            }
            i += 1;
            continue;
        }
        if x < 0x80 {
            push_cp(mut out, x);
            i += 1;
            continue;
        }
        let (need, lo, hi) = if x >= 0xc2 and x <= 0xdf {
            (1, 0x80, 0xbf)
        } else if x == 0xe0 {
            (2, 0xa0, 0xbf)
        } else if x == 0xed {
            (2, 0x80, 0x9f)
        } else if x >= 0xe1 and x <= 0xef {
            (2, 0x80, 0xbf)
        } else if x == 0xf0 {
            (3, 0x90, 0xbf)
        } else if x == 0xf4 {
            (3, 0x80, 0x8f)
        } else if x >= 0xf1 and x <= 0xf3 {
            (3, 0x80, 0xbf)
        } else {
            bad_bytes(d, mut out, b, i, i + 1, "invalid start byte")?;
            i += 1;
            continue;
        };
        let mut good = need + 1;
        let mut at_end = false;
        for k in 1..(need + 1) {
            if i + k >= n {
                good = k;
                at_end = true;
                break;
            }
            let y = b[i + k] as i64;
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xbf) };
            if y < l or y > h {
                good = k;
                break;
            }
        }
        if good <= need {
            if at_end and not fin {
                for k in i..n {
                    d.pending.push(b[k]);
                }
                break;
            }
            let reason = if at_end { "unexpected end of data" } else { "invalid continuation byte" };
            bad_bytes(d, mut out, b, i, i + good, reason)?;
            i += good;
            continue;
        }
        let mut cp = if need == 1 { x & 0x1f } else if need == 2 { x & 0x0f } else { x & 0x07 };
        for k in 1..(need + 1) {
            cp = cp * 64 + (b[i + k] as i64 & 0x3f);
        }
        push_cp(mut out, cp);
        i += need + 1;
    }
    Ok(out)
}

// ------------------------------------------------------------ the lexer
//
// lexer.py's LatexLexer joins its token regexps into one alternation and
// walks it with finditer. Every character starts some alternative, so the
// tokens cover the input; raw_match picks the alternative the regex would.

#[derive(Clone)]
struct Tok {
    name: String,
    text: String,
}

fn tok(name: Str, text: ref String) -> Tok {
    Tok { name: name.to_string(), text: text.clone() }
}

fn empty_tok() -> Tok {
    tok("unknown", String.new())
}

fn at(cs: ref Vec[char], i: i64, c: char) -> bool {
    i < cs.len() and cs[i] == c
}

// The token name and length the lexer's regexp matches at cs[i].
fn raw_match(cs: ref Vec[char], i: i64) -> (Str, i64) {
    let n = cs.len();
    let c = cs[i];
    if c == '\\' and i + 1 < n {
        let d = cs[i + 1];
        if d == '\\' or d == '%' {
            return ("control_symbol_x2", 2);
        }
        if is_letter(d) {
            let mut j = i + 1;
            while j < n and is_letter(cs[j]) {
                j += 1;
            }
            return ("control_word", j - i);
        }
        if d == '~' or d == '\'' or d == '"' or d == '`' or d == ' ' or d == '=' or d == '^' or d == '!' or d == '.' {
            return ("control_symbol", 2);
        }
        return ("control_symbol_x", 2);
    }
    if c == '%' {
        let mut j = i + 1;
        while j < n and cs[j] != '\n' {
            j += 1;
        }
        return ("comment", j - i);
    }
    if c == '#' {
        return ("parameter", if i + 1 < n and is_dig(cs[i + 1]) { 2 } else { 1 });
    }
    if c == ' ' or c == '\t' {
        return ("space", 1);
    }
    if c == '\n' {
        return ("newline", 1);
    }
    if c == '$' {
        return ("mathshift", if at(cs, i + 1, '$') { 2 } else { 1 });
    }
    if c == '-' {
        if at(cs, i + 1, '-') and at(cs, i + 2, '-') {
            return ("chars", 3);
        }
        return ("chars", if at(cs, i + 1, '-') { 2 } else { 1 });
    }
    if (c == '`' and at(cs, i + 1, '`')) or (c == '\'' and at(cs, i + 1, '\'')) {
        return ("chars", 2);
    }
    if (c == '?' or c == '!') and at(cs, i + 1, '`') {
        return ("chars", 2);
    }
    if c != '\\' {
        return ("chars", 1);
    }
    ("unknown", 1)
}

// LatexIncrementalLexer: the raw buffer holds the last token until the
// next call (or the final one) shows it is complete. State is N (new
// line), S (skipping spaces) or M (middle of a line).
struct Lexer {
    errors: String,
    raw: Tok,
    state: char,
    inline_math: bool,
}

fn lexer_new(errors: ref String) -> Lexer {
    Lexer { errors: errors.clone(), raw: empty_tok(), state: 'N', inline_math: false }
}

fn lexer_reset(lx: mut ref Lexer) {
    lx.raw = empty_tok();
    lx.state = 'N';
    lx.inline_math = false;
}

fn raw_tokens(lx: mut ref Lexer, chars: ref String, fin: bool) -> Vec[Tok] {
    let mut s = lx.raw.text.clone();
    s.push_str(chars);
    lx.raw = empty_tok();
    let cs = chs(s);
    let mut out: Vec[Tok] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        let (name, len) = raw_match(cs, i);
        if lx.raw.text.len() > 0 {
            out.push(lx.raw.clone());
        }
        lx.raw = tok(name, chars_str(cs, i, i + len));
        i += len;
    }
    if fin {
        if lx.raw.text.len() > 0 {
            out.push(lx.raw.clone());
        }
        lx.raw = empty_tok();
    }
    out
}

// UnicodeDecodeError("latex", chars.encode("utf8"), start, end, reason):
// the positions count characters, the byte shown is the byte at that index.
fn unknown_err(chars: ref String, start: i64, end: i64, text: ref String) -> Exc {
    let b = utf8_of(chars);
    let reason = f"unknown token {py_repr(text)}";
    if start >= 0 and start < b.len() and end <= b.len() and end == start + 1 {
        exc("UnicodeDecodeError", f"'latex' codec can't decode byte 0x{hex_digits(b[start] as i64, 2)} in position {start}: {reason}")
    } else {
        exc("UnicodeDecodeError", f"'latex' codec can't decode bytes in position {start}-{end - 1}: {reason}")
    }
}

// LatexIncrementalLexer.get_tokens; the tokens before an error stay in out.
fn get_tokens(lx: mut ref Lexer, chars: ref String, fin: bool, out: mut ref Vec[Tok]) -> Result[(), Exc] {
    let mut pos = 0 - char_count(lx.raw.text);
    for t in raw_tokens(mut lx, chars, fin) {
        let len = char_count(t.text);
        pos += len;
        let name = t.name.clone();
        if name == "newline" {
            if lx.state == 'N' {
                out.push(tok("control_word", "\\par".to_string()));
            } else if lx.state == 'S' {
                lx.state = 'N';
            } else {
                lx.state = 'N';
                out.push(tok("space", " ".to_string()));
            }
        } else if name == "space" {
            if lx.state == 'M' {
                lx.state = 'S';
                out.push(t.clone());
            }
        } else if name == "mathshift" {
            lx.inline_math = not lx.inline_math;
            lx.state = 'M';
            out.push(t.clone());
        } else if name == "parameter" or name == "chars" or name == "control_symbol_x" or name == "control_symbol_x2" {
            lx.state = 'M';
            out.push(t.clone());
        } else if name == "control_word" or name == "control_symbol" {
            lx.state = 'S';
            out.push(t.clone());
        } else if name == "comment" {
            lx.state = 'S';
        } else {
            if lx.errors == "strict" {
                return Err(unknown_err(chars, pos - len, pos, t.text));
            } else if lx.errors == "replace" {
                out.push(tok("chars", one_char('\u{fffd}')));
            } else if lx.errors != "ignore" {
                return Err(exc("NotImplementedError", f"error mode {py_repr(lx.errors)} not supported"));
            }
        }
    }
    Ok(())
}

// LatexIncrementalDecoder.decode_token: a control word gets a space after
// it, so that joined tokens stay apart.
fn decode_token(t: ref Tok) -> String {
    if t.name == "control_word" {
        f"{t.text} "
    } else {
        t.text.clone()
    }
}

// ------------------------------------------------------------ the translation table

struct Trans {
    uni: String,
    latex: String,
    encode: bool,
    decode: bool,
    text_mode: bool,
    math_mode: bool,
}

struct Table {
    umap: Map[String, String],
    ukeys: Vec[String],
    utoks: Vec[Vec[Tok]],
    max_length: i64,
    lmap: Map[String, (String, Vec[Tok])],
    lkeys: Vec[String],
}

// A token sequence as a map key.
fn tok_key(ts: ref Vec[Tok], from: i64) -> String {
    let mut k = String.new();
    for i in from..ts.len() {
        k.push_str(ts[i].name);
        k.push('\u{1}');
        k.push_str(ts[i].text);
        k.push('\u{2}');
    }
    k
}

fn starts_control(t: ref Tok) -> bool {
    t.name.starts_with("control")
}

// LatexUnicodeTable.register.
fn register(tb: mut ref Table, lx: mut ref Lexer, t: ref Trans) {
    if t.math_mode and not t.text_mode {
        for (a, b) in vec![("$", "$"), ("\\(", "\\)")] {
            let v = Trans { uni: t.uni.clone(), latex: f"{a}{t.latex}{b}", encode: t.encode, decode: t.decode, text_mode: true, math_mode: false };
            register(mut tb, mut lx, v);
        }
        return;
    }
    lexer_reset(mut lx);
    lx.state = 'M';
    let mut ts: Vec[Tok] = Vec.new();
    let _ = get_tokens(mut lx, t.latex, true, mut ts);
    if t.decode {
        let key = tok_key(ts, 0);
        if not tb.umap.contains_key(key) {
            if ts.len() > tb.max_length {
                tb.max_length = ts.len();
            }
            tb.umap.insert(key.clone(), t.uni.clone());
            tb.ukeys.push(key);
            tb.utoks.push(ts.clone());
        }
        if ts.len() == 2 and starts_control(ts[0]) and ts[1].name == "chars" {
            let v = Trans { uni: f"{{{t.uni}}}", latex: f"{ts[0].text}{{{ts[1].text}}}", encode: false, decode: true, text_mode: t.text_mode, math_mode: t.math_mode };
            register(mut tb, mut lx, v);
        }
        if ts.len() == 4 and (ts[0].text == "$" or ts[0].text == "\\(") and starts_control(ts[1]) and ts[2].name == "chars" and (ts[3].text == "$" or ts[3].text == "\\)") {
            let v = Trans { uni: t.uni.clone(), latex: f"{ts[0].text}{ts[1].text}{{{ts[2].text}}}{ts[3].text}", encode: false, decode: true, text_mode: t.text_mode, math_mode: t.math_mode };
            register(mut tb, mut lx, v);
        }
    }
    if t.encode and not tb.lmap.contains_key(t.uni) {
        tb.lmap.insert(t.uni.clone(), (t.latex.clone(), ts));
        tb.lkeys.push(t.uni.clone());
    }
}

// LatexUnicodeTable.register_all, over table_text(): a marker, the
// characters as hex code points, and the LaTeX.
fn build_table() -> Table {
    let mut tb = Table { umap: Map.new(), ukeys: Vec.new(), utoks: Vec.new(), max_length: 0, lmap: Map.new(), lkeys: Vec.new() };
    let mut lx = lexer_new("strict".to_string());
    for latex in vec![" \\par", "\\par"] {
        let t = Trans { uni: "\n\n".to_string(), latex: latex.to_string(), encode: false, decode: true, text_mode: true, math_mode: false };
        register(mut tb, mut lx, t);
    }
    for line in split_on(table_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, '\t');
        let m = chs(f[0]);
        let mut uni = String.new();
        for h in split_on(f[1], ',') {
            let mut cp = 0;
            for c in h.chars() {
                cp = cp * 16 + hex_val(c);
            }
            push_cp(mut uni, cp);
        }
        let t = Trans {
            uni: uni,
            latex: f[2].clone(),
            encode: m[1] == '-' or m[1] == '>',
            decode: m[1] == '-' or m[1] == '<',
            text_mode: m[0] == 'A' or m[0] == 'T',
            math_mode: m[0] == 'A' or m[0] == 'M',
        };
        register(mut tb, mut lx, t);
    }
    tb
}

// ------------------------------------------------------------ the codecs

// What find_latex makes of a name: the latex or ulatex codec and its
// input encoding.
struct Latex {
    unicode: bool,
    inputenc: String,
}

fn find_latex(name: ref String) -> Option[Latex] {
    let k = norm_encoding(name);
    let cs = chs(k);
    let mut cut = cs.len();
    for i in 0..cs.len() {
        if cs[i] == '_' {
            cut = i;
            break;
        }
    }
    let enc = chars_str(cs, 0, cut);
    let mut inputenc = if cut < cs.len() { chars_str(cs, cut + 1, cs.len()) } else { String.new() };
    if inputenc.len() == 0 {
        inputenc = "ascii".to_string();
    }
    if enc == "latex" {
        Some(Latex { unicode: false, inputenc: inputenc })
    } else if enc == "ulatex" {
        Some(Latex { unicode: true, inputenc: inputenc })
    } else {
        None
    }
}

enum Kind {
    Plain(Codec),
    Tex(Latex),
}

// codecs.lookup: the standard encodings are searched before latexcodec's
// search function.
fn resolve(name: ref String) -> Result[Kind, Exc] {
    match codec_lookup(name) {
        Ok(c) => return Ok(Kind.Plain(c)),
        Err(_) => {}
    }
    match find_latex(name) {
        Some(l) => Ok(Kind.Tex(l)),
        None => Err(unknown_encoding(name)),
    }
}

enum Out {
    Text(String),
    Bytes(Vec[u8]),
}

fn out_repr(o: ref Out) -> String {
    match o {
        Out.Text(s) => py_ascii(s),
        Out.Bytes(b) => bytes_repr(b),
    }
}

// LatexIncrementalEncoder, and UnicodeLatexIncrementalEncoder when
// `unicode` is set. In state S the last token was a control word, which
// eats the space after it.
struct Enc {
    errors: String,
    inputenc: String,
    unicode: bool,
    state: char,
}

fn enc_new(l: ref Latex, errors: ref String) -> Enc {
    Enc { errors: errors.clone(), inputenc: l.inputenc.clone(), unicode: l.unicode, state: 'M' }
}

fn table_latex(tb: ref Table, s: ref String) -> Option[(String, Vec[Tok])] {
    match tb.lmap.get(s) {
        Some(v) => Some(v.clone()),
        None => None,
    }
}

// _get_latex_chars_tokens_from_char.
fn char_latex(tb: ref Table, e: ref Enc, c: char) -> Result[(String, Vec[Tok]), Exc] {
    let s = one_char(c);
    if (c as i64) < 128 {
        if let Some(v) = table_latex(tb, s) {
            return Ok(v);
        }
    }
    let codec = codec_lookup(e.inputenc)?;
    if encodable(codec, c) {
        return Ok((s.clone(), vec![tok("chars", s)]));
    }
    if let Some(v) = table_latex(tb, s) {
        return Ok(v);
    }
    if e.errors == "strict" {
        return Err(exc("UnicodeEncodeError", f"'latex' codec can't encode character '{char_esc(c as i64)}' in position 0: don't know how to translate {py_repr(s)} into latex"));
    }
    if e.errors == "ignore" {
        return Ok((String.new(), vec![empty_tok()]));
    }
    if e.errors == "replace" {
        let b = f"{{\\char{c as i64}}}";
        return Ok((b.clone(), vec![tok("chars", b)]));
    }
    if e.errors == "keep" {
        return Ok((s.clone(), vec![tok("chars", s)]));
    }
    Err(exc("ValueError", f"latex codec does not support {e.errors} errors"))
}

// LatexIncrementalEncoder.get_latex_chars, joined.
fn enc_chars(tb: ref Table, e: mut ref Enc, s: ref String) -> Result[String, Exc] {
    let mut out = String.new();
    for c in s.chars() {
        let (latex, ts) = char_latex(tb, e, c)?;
        let mut bytes = latex;
        if e.state == 'S' {
            if bytes.starts_with(" ") {
                out.push_str("\\ ");
                let cs = chs(bytes);
                bytes = chars_str(cs, 1, cs.len());
            } else {
                out.push(' ');
            }
        }
        if ts.len() > 0 {
            e.state = if ts[ts.len() - 1].name == "control_word" { 'S' } else { 'M' };
        }
        out.push_str(bytes);
    }
    Ok(out)
}

fn enc_encode(tb: ref Table, e: mut ref Enc, s: ref String) -> Result[Out, Exc] {
    let chars = enc_chars(tb, mut e, s)?;
    if e.unicode {
        return Ok(Out.Text(chars));
    }
    let codec = codec_lookup(e.inputenc)?;
    Ok(Out.Bytes(encode_text(codec, chars, e.errors)?))
}

// What a decoder is handed: str or bytes.
enum In {
    Str(String),
    Raw(Vec[u8]),
}

// The translating LatexIncrementalDecoder (or the plain one in lexer.py
// when `translate` is off), with its input-encoding decoder and the token
// buffer that waits for a longer match.
struct Dec {
    lx: Lexer,
    bd: ByteDec,
    unicode: bool,
    translate: bool,
    buf: Vec[Tok],
}

fn dec_new(l: ref Latex, errors: ref String, translate: bool) -> Result[Dec, Exc] {
    let codec = codec_lookup(l.inputenc)?;
    Ok(Dec { lx: lexer_new(errors), bd: ByteDec { codec: codec, errors: errors.clone(), pending: Vec.new() }, unicode: l.unicode, translate: translate, buf: Vec.new() })
}

fn dec_reset(d: mut ref Dec) {
    lexer_reset(mut d.lx);
    d.buf = Vec.new();
}

// get_unicode_tokens, joined.
fn udecode(tb: ref Table, d: mut ref Dec, chars: ref String, fin: bool) -> Result[String, Exc] {
    let mut ts: Vec[Tok] = Vec.new();
    get_tokens(mut d.lx, chars, fin, mut ts)?;
    let mut out = String.new();
    if not d.translate {
        for t in ts {
            out.push_str(decode_token(t));
        }
        return Ok(out);
    }
    for t in ts {
        d.buf.push(t.clone());
        let n = d.buf.len();
        let mut i = n;
        while i > 0 {
            if let Some(u) = tb.umap.get(tok_key(d.buf, n - i)) {
                for k in 0..(n - i) {
                    out.push_str(decode_token(d.buf[k]));
                }
                out.push_str(u);
                d.buf = Vec.new();
                break;
            }
            i -= 1;
        }
        while d.buf.len() >= tb.max_length {
            out.push_str(decode_token(d.buf[0]));
            d.buf.remove(0);
        }
    }
    if fin {
        for t in d.buf {
            out.push_str(decode_token(t));
        }
        d.buf = Vec.new();
    }
    Ok(out)
}

fn regex_bytes_err() -> Exc {
    exc("TypeError", "cannot use a string pattern on a bytes-like object".to_string())
}

fn dec_decode(tb: ref Table, d: mut ref Dec, input: ref In, fin: bool) -> Result[String, Exc] {
    match input {
        In.Str(s) => udecode(tb, mut d, s, fin),
        In.Raw(b) => {
            if d.unicode {
                return Err(regex_bytes_err());
            }
            let chars = match bd_decode(mut d.bd, b, fin) {
                Ok(s) => s,
                Err(e) => {
                    if e.kind == "UnicodeDecodeError" {
                        return Err(exc("ValueError", e.msg));
                    }
                    return Err(e);
                }
            };
            udecode(tb, mut d, chars, fin)
        }
    }
}

// codecs.encode(text, name, errors).
fn codec_encode(tb: ref Table, name: ref String, errors: ref String, text: ref String) -> Result[Out, Exc] {
    match resolve(name)? {
        Kind.Plain(c) => Ok(Out.Bytes(encode_text(c, text, errors)?)),
        Kind.Tex(l) => {
            let mut e = enc_new(l, errors);
            enc_encode(tb, mut e, text)
        }
    }
}

// codecs.decode(data, name, errors).
fn codec_decode(tb: ref Table, name: ref String, errors: ref String, input: ref In) -> Result[String, Exc] {
    match resolve(name)? {
        Kind.Plain(c) => {
            match input {
                In.Raw(b) => {
                    let mut bd = ByteDec { codec: c, errors: errors.clone(), pending: Vec.new() };
                    bd_decode(mut bd, b, true)
                }
                In.Str(_) => Err(exc("TypeError", "a bytes-like object is required, not 'str'".to_string())),
            }
        }
        Kind.Tex(l) => {
            let mut d = dec_new(l, errors, true)?;
            dec_decode(tb, mut d, input, true)
        }
    }
}

// str.encode(name, errors): only bytes may come back.
fn str_encode(tb: ref Table, name: ref String, errors: ref String, text: ref String) -> Result[Vec[u8], Exc] {
    match codec_encode(tb, name, errors, text)? {
        Out.Bytes(b) => Ok(b),
        Out.Text(_) => Err(exc("TypeError", f"'{name}' encoder returned 'str' instead of 'bytes'; use codecs.encode() to encode to arbitrary types")),
    }
}

// ------------------------------------------------------------ the desk

struct World {
    out: String,
    files: Map[String, Vec[u8]],
}

fn emit(w: mut ref World, s: ref String) {
    w.out.push_str(s);
    w.out.push('\n');
}

fn emit_err(w: mut ref World, e: ref Exc) {
    emit(mut w, f"  error {e.kind}: {vis(e.msg)}");
}

fn fs_read(w: ref World, path: ref String) -> Result[Vec[u8], Exc] {
    match w.files.get(path) {
        Some(b) => Ok(b.clone()),
        None => Err(exc("FileNotFoundError", f"[Errno 2] No such file or directory: {py_repr(path)}")),
    }
}

fn file_names(w: ref World) -> Vec[String] {
    let mut names: Vec[String] = Vec.new();
    for (k, _) in w.files {
        names.push(k.clone());
    }
    sort_strings(mut names);
    names
}

fn show_file(w: mut ref World, name: ref String, data: ref Vec[u8]) {
    emit(mut w, f"  wrote {name} ({data.len()} bytes)");
    match String.from_utf8(data.clone()) {
        Ok(text) => {
            let mut lines = split_on(text, '\n');
            let last = lines.pop().unwrap();
            for ln in lines {
                emit(mut w, f"    |{vis(ln)}");
            }
            if last.len() > 0 {
                emit(mut w, f"    |{vis(last)}");
                emit(mut w, "    (no newline at end)".to_string());
            }
        }
        Err(_) => {
            let mut i = 0;
            while i < data.len() {
                let mut line = "    #".to_string();
                let mut k = i;
                while k < data.len() and k < i + 32 {
                    line.push_str(hex_digits(data[k] as i64, 2));
                    k += 1;
                }
                emit(mut w, line);
                i += 32;
            }
        }
    }
}

fn arg_bytes(word: ref String) -> Vec[u8] {
    let cs = chs(word);
    hex_bytes(chars_str(cs, 2, cs.len()))
}

fn arg_text(word: ref String) -> String {
    String.from_utf8(arg_bytes(word)).unwrap()
}

fn shown(word: ref String) -> String {
    if word.starts_with("h:") {
        py_ascii(arg_text(word))
    } else if word.starts_with("x:") {
        bytes_repr(arg_bytes(word))
    } else {
        word.clone()
    }
}

fn arg_in(word: ref String) -> In {
    if word.starts_with("h:") { In.Str(arg_text(word)) } else { In.Raw(arg_bytes(word)) }
}

// An incremental op's chunk: str for ulatex, bytes for every other codec.
fn chunk_in(codec: ref String, word: ref String) -> In {
    if lower_ascii(codec).starts_with("ulatex") { In.Str(arg_text(word)) } else { In.Raw(arg_bytes(word)) }
}

fn toks_str(ts: ref Vec[Tok]) -> String {
    if ts.len() == 0 {
        return "(none)".to_string();
    }
    let mut out = String.new();
    for i in 0..ts.len() {
        if i > 0 {
            out.push(' ');
        }
        out.push_str(f"{ts[i].name}:{py_ascii(ts[i].text)}");
    }
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn run_table(w: mut ref World, tb: ref Table) {
    emit(mut w, f"  unicode_map {tb.ukeys.len()} entries, max_length {tb.max_length}, latex_map {tb.lkeys.len()} entries");
    for i in 0..tb.ukeys.len() {
        let u = tb.umap.get(tb.ukeys[i]).unwrap();
        emit(mut w, f"  dec {toks_str(tb.utoks[i])} -> {py_ascii(u)}");
    }
    for k in tb.lkeys {
        let (latex, ts) = tb.lmap.get(k).unwrap();
        emit(mut w, f"  enc {py_ascii(k)} -> {py_ascii(latex)} [{toks_str(ts)}]");
    }
}

fn lexer_decoder(errors: ref String) -> Dec {
    let l = Latex { unicode: false, inputenc: "ascii".to_string() };
    dec_new(l, errors, false).unwrap()
}

fn run_op(w: mut ref World, tb: ref Table, words: ref Vec[String]) -> Result[(), Exc] {
    let op = words[0].clone();
    if op == "table" {
        run_table(mut w, tb);
    } else if op == "enc" {
        let r = codec_encode(tb, words[1], words[2], arg_text(words[3]))?;
        emit(mut w, f"  -> {out_repr(r)}");
    } else if op == "dec" {
        let r = codec_decode(tb, words[1], words[2], arg_in(words[3]))?;
        emit(mut w, f"  -> {py_ascii(r)}");
    } else if op == "strenc" {
        let r = str_encode(tb, words[1], words[2], arg_text(words[3]))?;
        emit(mut w, f"  -> {bytes_repr(r)}");
    } else if op == "bdec" {
        let r = codec_decode(tb, words[1], words[2], In.Raw(arg_bytes(words[3])))?;
        emit(mut w, f"  -> {py_ascii(r)}");
    } else if op == "ienc" {
        let l = match resolve(words[1])? {
            Kind.Tex(l) => l,
            Kind.Plain(_) => return Err(exc("ValueError", "not a latex codec".to_string())),
        };
        let mut e = enc_new(l, words[2]);
        for i in 3..words.len() {
            let k = i - 3;
            if words[i] == "r" {
                e.state = 'M';
                emit(mut w, f"  [{k}] reset");
                continue;
            }
            match enc_encode(tb, mut e, arg_text(words[i])) {
                Ok(r) => emit(mut w, f"  [{k}] -> {out_repr(r)}"),
                Err(x) => {
                    emit_err(mut w, x);
                    return Ok(());
                }
            }
        }
    } else if op == "idec" {
        let l = match resolve(words[1])? {
            Kind.Tex(l) => l,
            Kind.Plain(_) => return Err(exc("ValueError", "not a latex codec".to_string())),
        };
        let mut d = dec_new(l, words[2], true)?;
        for i in 3..words.len() {
            let k = i - 3;
            if words[i] == "r" {
                dec_reset(mut d);
                emit(mut w, f"  [{k}] reset");
                continue;
            }
            match dec_decode(tb, mut d, chunk_in(words[1], words[i]), words[i].starts_with("f:")) {
                Ok(r) => emit(mut w, f"  [{k}] -> {py_ascii(r)}"),
                Err(x) => {
                    emit_err(mut w, x);
                    return Ok(());
                }
            }
        }
    } else if op == "lex" {
        let mut d = lexer_decoder(words[1]);
        let mut ts: Vec[Tok] = Vec.new();
        let r = get_tokens(mut d.lx, String.from_utf8(arg_bytes(words[2])).unwrap(), true, mut ts);
        for t in ts {
            emit(mut w, f"  {t.name}:{py_ascii(t.text)}");
        }
        match r {
            Ok(_) => emit(mut w, f"  state {d.lx.state} inline_math {py_bool(d.lx.inline_math)}"),
            Err(x) => emit_err(mut w, x),
        }
    } else if op == "ilex" {
        let mut d = lexer_decoder(words[1]);
        for i in 2..words.len() {
            let mut ts: Vec[Tok] = Vec.new();
            get_tokens(mut d.lx, String.from_utf8(arg_bytes(words[i])).unwrap(), words[i].starts_with("f:"), mut ts)?;
            let st = if d.lx.state == 'M' { 0 } else if d.lx.state == 'N' { 1 } else { 2 };
            let bits = st + if d.lx.inline_math { 4 } else { 0 };
            emit(mut w, f"  [{i - 2}] {toks_str(ts)}");
            emit(mut w, f"      state {d.lx.raw.name}:{py_ascii(d.lx.raw.text)} {bits}");
        }
    } else if op == "plain" {
        let mut d = lexer_decoder(words[1]);
        let r = dec_decode(tb, mut d, In.Raw(arg_bytes(words[2])), true)?;
        emit(mut w, f"  -> {py_ascii(r)}");
    } else if op == "read" {
        // codecs.open(path, 'r', codec, errors).read()
        let data = fs_read(w, words[1])?;
        let kind = resolve(words[2])?;
        if data.len() == 0 {
            emit(mut w, "  -> ''".to_string());
            return Ok(());
        }
        let r = match kind {
            Kind.Tex(l) => {
                let mut d = dec_new(l, words[3], true)?;
                dec_decode(tb, mut d, In.Raw(data), true)?
            }
            Kind.Plain(c) => {
                let mut bd = ByteDec { codec: c, errors: words[3].clone(), pending: Vec.new() };
                bd_decode(mut bd, data, true)?
            }
        };
        emit(mut w, f"  -> {py_ascii(r)}");
    } else if op == "write" {
        // codecs.open(path, 'w', codec, errors).write(text): the file is
        // created before anything is encoded.
        w.files.insert(words[1].clone(), Vec.new());
        resolve(words[2])?;
        let r = codec_encode(tb, words[2], words[3], arg_text(words[4]))?;
        match r {
            Out.Bytes(b) => {
                w.files.insert(words[1].clone(), b);
            }
            Out.Text(_) => return Err(exc("TypeError", "a bytes-like object is required, not 'str'".to_string())),
        }
    } else if op == "convert" {
        let data = fs_read(w, words[1])?;
        let text = codec_decode(tb, words[3], words[5], In.Raw(data))?;
        let out = str_encode(tb, words[4], words[5], text)?;
        w.files.insert(words[2].clone(), out);
    }
    Ok(())
}

fn run_job(w: mut ref World, tb: ref Table, line: ref String) {
    let fields = split_on(line, '\t');
    emit(mut w, f"== {fields[0]}");
    w.files = Map.new();
    if fields[1] != "-" {
        for item in split_on(fields[1], ',') {
            let kv = split_on(item, '=');
            w.files.insert(kv[0].clone(), hex_bytes(kv[1]));
        }
    }
    for i in 2..fields.len() {
        let words = split_on(fields[i], ' ');
        let mut shown_line = ">".to_string();
        for x in words {
            shown_line.push(' ');
            shown_line.push_str(shown(x));
        }
        emit(mut w, shown_line);
        let before = w.files.clone();
        match run_op(mut w, tb, words) {
            Ok(_) => {}
            Err(e) => emit_err(mut w, e),
        }
        for k in file_names(w) {
            let now = w.files.get(k).unwrap().clone();
            let changed = match before.get(k) {
                Some(old) => *old != now,
                None => true,
            };
            if changed {
                show_file(mut w, k, now);
            }
        }
    }
}

fn main() {
    let tb = build_table();
    let mut w = World { out: String.new(), files: Map.new() };
    for line in split_on(jobs_text(), '\n') {
        if line.len() > 0 {
            run_job(mut w, tb, line);
        }
    }
    print(w.out);
}

// Generated by gen_kara.py from data/jobs.tsv.
fn jobs_text() -> String {
    let mut s = String.new();
    s.push_str("table\t-\ttable\n");
