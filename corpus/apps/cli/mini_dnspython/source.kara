}

fn file_zones_example_com_next_zone_0(t: mut ref String) {
    t.push_str("$TTL 1h\n");
    t.push_str("@   IN  SOA ns1.example.com. hostmaster.example.com. 2026102201 2h 15m 2w 5m\n");
    t.push_str("    IN  NS   ns1\n");
    t.push_str("    IN  NS   ns2.example.net.\n");
