fn file_zones_2_0_192_in_addr_arpa_zone_0(t: mut ref String) {
    t.push_str("$TTL 1d\n");
    t.push_str("@ SOA ns1.example.com. hostmaster.example.com. 1 1h 15m 1w 1h\n");
    t.push_str("@ NS ns1.example.com.\n");
    t.push_str("10 PTR example.com.\n");
    t.push_str("25 PTR mail.example.com.\n");
    t.push_str("26 PTR mail.example.com.\n");
    t.push_str("53 PTR ns1.example.com.\n");
    t.push_str("$GENERATE 100-104 $ PTR dhcp-$.example.com.\n");
    t.push_str("$GENERATE 200-206/3 ${0,3,d} 600 PTR h${-199,2,x}.lab.example.com.\n");
    t.push_str("$GENERATE 7-9 ${0,0,o} IN PTR oct-${8}.example.com.\n");
}

