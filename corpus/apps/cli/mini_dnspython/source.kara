    t.push_str("    IN  MX   30 mail3\n");
    t.push_str("    IN  TXT  \"v=spf1 mx include:_spf.example.net -all\"\n");
    t.push_str("    IN  A    192.0.2.10\n");
    t.push_str("    IN  AAAA 2001:db8::10\n");
    t.push_str("ns1     IN A    192.0.2.53\n");
    t.push_str("        IN AAAA 2001:db8::53\n");
    t.push_str("mail    IN A    192.0.2.25\n");
    t.push_str("mail3   IN A    192.0.2.27\n");
    t.push_str("www     IN CNAME @\n");
    t.push_str("shop    IN CNAME www\n");
    t.push_str("api     300 A   192.0.2.30\n");
    t.push_str("api     300 A   192.0.2.31\n");
    t.push_str("status  A       192.0.2.80\n");
    t.push_str("_dmarc  TXT     \"v=DMARC1; p=reject; rua=mailto:dmarc@example.com\"\n");
}

fn file_zones_example_com_zone_0(t: mut ref String) {
    t.push_str("; example.com: the zone of Example Shop\n");
    t.push_str("$TTL 1h\n");
    t.push_str("@   IN  SOA ns1.example.com. hostmaster.example.com. (\n");
    t.push_str("        2026102101 ; serial\n");
    t.push_str("        2h         ; refresh\n");
    t.push_str("        15m        ; retry\n");
    t.push_str("        2w         ; expire\n");
    t.push_str("        5m )       ; negative caching\n");
    t.push_str("    IN  NS   ns1\n");
    t.push_str("    IN  NS   ns2.example.net.\n");
    t.push_str("    IN  MX   10 mail\n");
    t.push_str("    IN  MX   20 mail2.example.net.\n");
    t.push_str("    IN  TXT  \"v=spf1 mx include:_spf.example.net -all\"\n");
    t.push_str("    IN  CAA  0 issue \"letsencrypt.org\"\n");
    t.push_str("    IN  CAA  0 iodef \"mailto:security@example.com\"\n");
    t.push_str("    IN  A    192.0.2.10\n");
    t.push_str("    IN  AAAA 2001:db8:0:0::10\n");
    t.push_str("\n");
    t.push_str("ns1     IN A    192.0.2.53\n");
    t.push_str("        IN AAAA 2001:DB8::53\n");
    t.push_str("mail    300 IN A 192.0.2.25\n");
    t.push_str("mail    IN A    192.0.2.26\n");
    t.push_str("www     IN CNAME @\n");
    t.push_str("shop    IN CNAME www\n");
    t.push_str("api     600 A   192.0.2.30\n");
    t.push_str("api     A       192.0.2.31\n");
    t.push_str("api     A       192.0.2.30   ; the same address again\n");
    t.push_str("_dmarc  TXT     \"v=DMARC1; p=quarantine; rua=mailto:dmarc@example.com\"\n");
    t.push_str("_sip._tcp SRV   10 60 5060 sip1\n");
    t.push_str("          SRV   20 0 5060 sip2.example.net.\n");
    t.push_str("sip1    A       192.0.2.40\n");
    t.push_str("_443._tcp.www TLSA 3 1 1 ( 0123456789abcdef0123456789abcdef\n");
    t.push_str("                           0123456789ABCDEF0123456789ABCDEF )\n");
    t.push_str("ns1     SSHFP   4 2 9b1e6c8a2f0d4e3b7a5c1d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a\n");
    t.push_str("db      HINFO   \"x86_64\" \"Linux 6.1\"\n");
    t.push_str("legacy  TXT     \"a \\\"quoted\\\" word\" two\\032words \"semi;colon\" \"tab\\009x\" \"\"\n");
    t.push_str("dev     NS      ns.dev\n");
    t.push_str("ns.dev  A       192.0.2.60\n");
    t.push_str("office  TYPE65280 \\# 4 0a0b0c0d\n");
    t.push_str("printer A       \\# 4 C0000263\n");
    t.push_str("WWW2    A       192.0.2.11\n");
    t.push_str("www2    A       192.0.2.12\n");
    t.push_str("Mixed.Case MX   5 MAIL\n");
    t.push_str("big     TXT     \"record one of the big set, padded out to make the answer long\"\n");
    t.push_str("big     TXT     \"record two of the big set, padded out to make the answer long\"\n");
    t.push_str("big     TXT     \"record three of the big set, padded out to make the answer long\"\n");
    t.push_str("big     TXT     \"record four of the big set, padded out to make the answer long\"\n");
    t.push_str("big     TXT     \"record five of the big set, padded out to make the answer long\"\n");
    t.push_str("big     TXT     \"record six of the big set, padded out to make the answer long\"\n");
    t.push_str("big     TXT     \"record seven of the big set, padded out to make the answer long\"\n");
    t.push_str("big     TXT     \"record eight of the big set, padded out to make the answer long\"\n");
    t.push_str("$ORIGIN corp.example.com.\n");
    t.push_str("vpn     A       198.51.100.1\n");
    t.push_str("intranet CNAME  vpn\n");
    t.push_str("@       TXT     \"corp\"\n");
    t.push_str("$ORIGIN example.com.\n");
    t.push_str("*.cdn   CNAME   cdn.example.net.\n");
}

fn file_zones_example_net_zone_0(t: mut ref String) {
    t.push_str("$ORIGIN example.net.\n");
    t.push_str("$TTL 86400\n");
    t.push_str("example.net. 3600 IN SOA ns2.example.net. admin.example.net. 7 3600 900 1209600 300\n");
    t.push_str("example.net. IN 3600 NS ns2\n");
    t.push_str("             NS ns3.example.org.\n");
    t.push_str("ns2 A 203.0.113.2\n");
    t.push_str("mail2 IN A 203.0.113.25\n");
    t.push_str("sip2 1d IN A 203.0.113.40\n");
    t.push_str("_spf TXT \"v=spf1 ip4:192.0.2.0/24 ip4:203.0.113.0/24 -all\"\n");
    t.push_str("cdn 60 CNAME edge.cdn.example.org.\n");
    t.push_str("$TTL 5m\n");
    t.push_str("ttl-test A 203.0.113.99\n");
    t.push_str("\tA 203.0.113.98\n");
    t.push_str("other.example.org. A 203.0.113.1   ; outside the zone, so it is skipped\n");
}
