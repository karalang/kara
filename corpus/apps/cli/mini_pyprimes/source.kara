// mini_pyprimes — a port of the deterministic surface of the `pyprimes` library
// (Steven D'Aprano, MIT): prime generation, the prime-counting function, prime
// sums, exact trial-division primality and integer factorisation. These power
// cryptographic key work, number-theory tooling and math teaching material.
//
// The library's probabilistic isprime (random Miller-Rabin bases) and its
// base-dependent fermat / miller_rabin are deliberately out of scope; only the
// exact, deterministic functions are ported. Primes are generated by the same
// ascending trial-division scheme, and the integer test d*d <= n stands in for
// the library's float d <= n**0.5 — identical over the input range used here.

struct Fac {
    ps: Vec[i64],
    cs: Vec[i64],
}

fn str_bytes(s: String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(b);
    }
    v
}

fn itoa(n: i64) -> String {
    if n == 0 {
        return "0";
    }
    let mut neg = false;
    let mut x = n;
    if x < 0 {
        neg = true;
        x = -x;
    }
    let mut buf: Vec[u8] = Vec.new();
    while x > 0 {
        let d = (x % 10) as u8;
        buf.push(48 + d);
        x = x / 10;
    }
    if neg {
        buf.push(45);
    }
    let mut out = String.new();
    let mut i = buf.len();
    while i > 0 {
        i = i - 1;
        let mut one: Vec[u8] = Vec.new();
        one.push(buf[i]);
        out.push_str(String.from_utf8(one).unwrap_or(""));
    }
    out
}

fn split_fields(line: String, sepb: u8) -> Vec[String] {
    let b = str_bytes(line.clone());
    let m = b.len();
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= m {
        if i == m or b[i] == sepb {
            out.push(line.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    out
}

fn parse_int(s: String) -> i64 {
    let b = str_bytes(s);
    let m = b.len();
    if m == 0 {
        return 0;
    }
    let mut neg = false;
    let mut i = 0;
    if b[0] == 45 {
        neg = true;
        i = 1;
    }
    let mut v: i64 = 0;
    while i < m {
        v = v * 10 + (b[i] - 48) as i64;
        i = i + 1;
    }
    if neg { -v } else { v }
}

// is i prime, tested against the already-collected ascending primes up to √i
fn gen_is_prime_by(primes: ref Vec[i64], i: i64) -> bool {
    let mut k = 0;
    while k < primes.len() {
        let p = primes[k];
        if p * p > i {
            return true;
        }
        if i % p == 0 {
            return false;
        }
        k = k + 1;
    }
    true
}

fn first_primes(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if n <= 0 {
        return out;
    }
    out.push(2);
    let mut i = 3;
    while out.len() < n {
        if gen_is_prime_by(out, i) {
            out.push(i);
        }
        i = i + 2;
    }
    out
}

fn primes_below(x: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if x >= 2 {
        out.push(2);
    }
    let mut i = 3;
    while i <= x {
        if gen_is_prime_by(out, i) {
            out.push(i);
        }
        i = i + 2;
    }
    out
}

fn isprime_div(n: i64) -> bool {
    if n < 2 {
        return false;
    }
    if n % 2 == 0 {
        return n == 2;
    }
    let mut d = 3;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 2;
    }
    true
}

fn factorise(n0: i64) -> Fac {
    let mut ps: Vec[i64] = Vec.new();
    let mut cs: Vec[i64] = Vec.new();
    let mut n = n0;
    if n == 0 or n == 1 or n == -1 {
        ps.push(n);
        cs.push(1);
        return Fac { ps: ps, cs: cs };
    }
    if n < 0 {
        ps.push(-1);
        cs.push(1);
        n = -n;
    }
    let mut d = 2;
    while d * d <= n {
        let mut count = 0;
        while n % d == 0 {
            count = count + 1;
            n = n / d;
        }
        if count > 0 {
            ps.push(d);
            cs.push(count);
        }
        d = if d == 2 { 3 } else { d + 2 };
    }
    if n != 1 {
        ps.push(n);
        cs.push(1);
    }
    Fac { ps: ps, cs: cs }
}

fn join_vec(v: ref Vec[i64]) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < v.len() {
        if i > 0 {
            s.push_str(" ");
        }
        s.push_str(itoa(v[i]));
        i = i + 1;
    }
    s
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();

    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let f = split_fields(line, 9);
                let op = f[0].clone();
                let v = parse_int(f[1].clone());
                if op == "nth" {
                    let ps = first_primes(v);
                    out.push_str(itoa(ps[v - 1]));
                    out.push_str("\n");
                } else if op == "first" {
                    out.push_str(join_vec(first_primes(v)));
                    out.push_str("\n");
                } else if op == "below" {
                    out.push_str(join_vec(primes_below(v)));
                    out.push_str("\n");
                } else if op == "count" {
                    out.push_str(itoa(primes_below(v).len()));
                    out.push_str("\n");
                } else if op == "sum" {
                    let ps = first_primes(v);
                    let mut total = 0;
                    let mut k = 0;
                    while k < ps.len() {
                        total = total + ps[k];
                        k = k + 1;
                    }
                    out.push_str(itoa(total));
                    out.push_str("\n");
                } else if op == "isprime" {
                    if isprime_div(v) {
                        out.push_str("yes\n");
                    } else {
                        out.push_str("no\n");
                    }
                } else if op == "factor" {
                    let fac = factorise(v);
                    let mut s = String.new();
                    let mut k = 0;
                    while k < fac.ps.len() {
                        if k > 0 {
                            s.push_str(" ");
                        }
                        s.push_str(itoa(fac.ps[k]));
                        s.push_str(":");
                        s.push_str(itoa(fac.cs[k]));
                        k = k + 1;
                    }
                    out.push_str(s);
                    out.push_str("\n");
                } else if op == "factors" {
                    let fac = factorise(v);
                    let mut s = String.new();
                    let mut first = true;
                    let mut k = 0;
                    while k < fac.ps.len() {
                        let mut c = 0;
                        while c < fac.cs[k] {
                            if first == false {
                                s.push_str(" ");
                            }
                            first = false;
                            s.push_str(itoa(fac.ps[k]));
                            c = c + 1;
                        }
                        k = k + 1;
                    }
                    out.push_str(s);
                    out.push_str("\n");
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

