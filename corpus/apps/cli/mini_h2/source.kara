// H2ConnectionStateMachine._transitions: (state, input) to target, -1 for none.
fn conn_transition(state: i64, input: i64) -> i64 {
    match state * 100 + input {
        0 => 1,
        9 => 2,
        6 => 0,
        15 => 0,
        4 => 0,
        13 => 0,
        5 => 0,
        14 => 0,
        3 => 3,
        12 => 3,
        8 => 0,
        17 => 0,
        18 => 2,
        19 => 1,
        100 => 1,
        102 => 1,
        103 => 3,
        104 => 1,
        105 => 1,
        106 => 1,
        108 => 1,
        109 => 1,
        110 => 1,
        111 => 1,
        112 => 3,
        113 => 1,
        114 => 1,
        115 => 1,
        107 => 1,
        116 => 1,
        117 => 1,
        119 => 1,
        200 => 2,
        201 => 2,
        202 => 2,
        203 => 3,
        204 => 2,
        205 => 2,
        206 => 2,
        208 => 2,
        209 => 2,
        211 => 2,
        212 => 3,
        213 => 2,
        214 => 2,
        215 => 2,
        217 => 2,
        207 => 2,
        216 => 2,
        218 => 2,
        219 => 2,
        303 => 3,
        312 => 3,
        _ => -1,
    }
}
