// ---------------------------------------------------------------- h2: errors

// An h2 exception: its class name, its str(), the error code a
// connection is terminated with, and the stream id and pending events
// that StreamClosedError and StreamIDTooLowError carry.
#[derive(Clone)]
struct H2Err {
    kind: String,
    msg: String,
    code: i64,
    sid: i64,
    events: Vec[Ev],
}

fn err_of(kind: Str, msg: ref String, code: i64) -> H2Err {
    H2Err { kind: kind.to_string(), msg: msg.clone(), code: code, sid: 0, events: Vec.new() }
}

fn proto(msg: ref String) -> H2Err {
    err_of("ProtocolError", msg, 1)
}

fn flow_err(msg: ref String) -> H2Err {
    err_of("FlowControlError", msg, 3)
}

fn value_err(msg: ref String) -> H2Err {
    err_of("ValueError", msg, 0)
}

fn key_err(key: i64) -> H2Err {
    err_of("KeyError", f"{key}", 0)
}

fn assertion_err() -> H2Err {
    err_of("AssertionError", "".to_string(), 0)
}

fn index_err() -> H2Err {
    err_of("IndexError", "list index out of range".to_string(), 0)
}

fn closed_err(sid: i64) -> H2Err {
    let mut e = err_of("StreamClosedError", f"{sid}", 5);
    e.sid = sid;
    e
}

fn no_such(sid: i64) -> H2Err {
    let mut e = err_of("NoSuchStreamError", f"{sid}", 1);
    e.sid = sid;
    e
}

fn too_low(sid: i64, highest: i64) -> H2Err {
    let mut e = err_of("StreamIDTooLowError", f"StreamIDTooLowError: {sid} is lower than {highest}", 1);
    e.sid = sid;
    e
}

// The classes that are not h2.exceptions.ProtocolError subclasses.
fn is_protocol(e: ref H2Err) -> bool {
    not (e.kind == "ValueError" or e.kind == "KeyError" or e.kind == "RFC1122Error"
        or e.kind == "AssertionError" or e.kind == "IndexError" or e.kind == "InvalidPaddingError")
}

fn is_no_such(e: ref H2Err) -> bool {
    e.kind == "NoSuchStreamError" or e.kind == "StreamClosedError"
}

// ---------------------------------------------------------------- h2: events

const EV_REQUEST: i64 = 0;
const EV_RESPONSE: i64 = 1;
const EV_TRAILERS: i64 = 2;
const EV_INFORMATIONAL: i64 = 3;
const EV_DATA: i64 = 4;
const EV_WINDOW: i64 = 5;
const EV_REMOTE_SETTINGS: i64 = 6;
const EV_PING: i64 = 7;
const EV_PING_ACK: i64 = 8;
const EV_ENDED: i64 = 9;
const EV_RESET: i64 = 10;
const EV_PUSHED: i64 = 11;
const EV_SETTINGS_ACK: i64 = 12;
const EV_PRIORITY: i64 = 13;
const EV_TERMINATED: i64 = 14;
const EV_ALTSVC: i64 = 15;
const EV_UNKNOWN: i64 = 16;
// the internal _HeadersSent events
const EV_RESPONSE_SENT: i64 = 20;
const EV_REQUEST_SENT: i64 = 21;
const EV_TRAILERS_SENT: i64 = 22;
const EV_PUSH_SENT: i64 = 23;

// A setting value that is Python's None (a deque's [None] head).
const NONE: i64 = -4611686018427387904;

#[derive(Clone)]
struct Changed {
    setting: i64,
    original: i64,
    new: i64,
}

#[derive(Clone)]
struct Ev {
    kind: i64,
    sid: i64,
    hdrs: Vec[Header],
    as_str: bool,
    data: Vec[u8],
    flow: i64,
    delta: i64,
    code: i64,
    remote: bool,
    changed: Vec[Changed],
    pushed: i64,
    weight: i64,
    depends: i64,
    exclusive: bool,
    last: i64,
    extra: Vec[u8],
    origin: Vec[u8],
    field: Vec[u8],
}

fn ev(kind: i64, sid: i64) -> Ev {
    Ev {
        kind: kind,
        sid: sid,
        hdrs: Vec.new(),
        as_str: false,
        data: Vec.new(),
        flow: 0,
        delta: 0,
        code: 0,
        remote: true,
        changed: Vec.new(),
        pushed: 0,
        weight: 0,
        depends: 0,
        exclusive: false,
        last: 0,
        extra: Vec.new(),
        origin: Vec.new(),
        field: Vec.new(),
    }
}

fn opt_repr(v: i64) -> String {
    if v == NONE { "None".to_string() } else { f"{v}" }
}

fn changed_repr(cs: ref Vec[Changed]) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < cs.len() {
        if i > 0 {
            s.push_str(", ");
        }
        let c = ref cs[i];
        s.push_str(f"ChangedSetting(setting={c.setting}, original_value={opt_repr(c.original)}, new_value={c.new})");
        i += 1;
    }
    s
}

// Python's str repr, for headers decoded with header_encoding.
fn str_repr(data: ref Vec[u8]) -> String {
    let text = text_of(data);
    let mut has_sq = false;
    let mut has_dq = false;
    for c in text.chars() {
        if c == '\'' { has_sq = true; }
        if c == '"' { has_dq = true; }
    }
    let qc: char = if has_sq and not has_dq { '"' } else { '\'' };
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    s.push(qc);
    for c in text.chars() {
        let o = c as i64;
        if c == qc or c == '\\' {
            s.push('\\');
            s.push(c);
        } else if c == '\t' {
            s.push_str("\\t");
        } else if c == '\n' {
            s.push_str("\\n");
        } else if c == '\r' {
            s.push_str("\\r");
        } else if o < 0x20 or (o >= 0x7f and o <= 0xa0) {
            s.push_str("\\x");
            s.push(ds[o / 16]);
            s.push(ds[o % 16]);
        } else {
            s.push(c);
        }
    }
    s.push(qc);
    s
}

fn hdrs_repr(hs: ref Vec[Header], as_str: bool) -> String {
    let mut s = String.new();
    s.push('[');
    let mut i = 0;
    while i < hs.len() {
        if i > 0 {
            s.push_str(", ");
        }
        let h = ref hs[i];
        if as_str {
            s.push_str(f"({str_repr(h.name)}, {str_repr(h.value)})");
        } else {
            s.push_str(f"({bytes_repr(h.name)}, {bytes_repr(h.value)})");
        }
        i += 1;
    }
    s.push(']');
    s
}

fn head_hex(data: ref Vec[u8], n: i64) -> String {
    hex_of(sub(data, 0, n))
}

fn ev_repr(e: ref Ev) -> String {
    let k = e.kind;
    if k == EV_REQUEST {
        f"<RequestReceived stream_id:{e.sid}, headers:{hdrs_repr(e.hdrs, e.as_str)}>"
    } else if k == EV_RESPONSE {
        f"<ResponseReceived stream_id:{e.sid}, headers:{hdrs_repr(e.hdrs, e.as_str)}>"
    } else if k == EV_TRAILERS {
        f"<TrailersReceived stream_id:{e.sid}, headers:{hdrs_repr(e.hdrs, e.as_str)}>"
    } else if k == EV_INFORMATIONAL {
        f"<InformationalResponseReceived stream_id:{e.sid}, headers:{hdrs_repr(e.hdrs, e.as_str)}>"
    } else if k == EV_DATA {
        f"<DataReceived stream_id:{e.sid}, flow_controlled_length:{e.flow}, data:{head_hex(e.data, 20)}>"
    } else if k == EV_WINDOW {
        f"<WindowUpdated stream_id:{e.sid}, delta:{e.delta}>"
    } else if k == EV_REMOTE_SETTINGS {
        let cs = changed_repr(e.changed);
        let mut s = "<RemoteSettingsChanged changed_settings:{".to_string();
        s.push_str(cs);
        s.push_str("}>");
        s
    } else if k == EV_PING {
        f"<PingReceived ping_data:{hex_of(e.data)}>"
    } else if k == EV_PING_ACK {
        f"<PingAckReceived ping_data:{hex_of(e.data)}>"
    } else if k == EV_ENDED {
        f"<StreamEnded stream_id:{e.sid}>"
    } else if k == EV_RESET {
        f"<StreamReset stream_id:{e.sid}, error_code:{e.code}, remote_reset:{bstr(e.remote)}>"
    } else if k == EV_PUSHED {
        f"<PushedStreamReceived pushed_stream_id:{e.pushed}, parent_stream_id:{e.sid}, headers:{hdrs_repr(e.hdrs, e.as_str)}>"
    } else if k == EV_SETTINGS_ACK {
        let cs = changed_repr(e.changed);
        let mut s = "<SettingsAcknowledged changed_settings:{".to_string();
        s.push_str(cs);
        s.push_str("}>");
        s
    } else if k == EV_PRIORITY {
        f"<PriorityUpdated stream_id:{e.sid}, weight:{e.weight}, depends_on:{e.depends}, exclusive:{bstr(e.exclusive)}>"
    } else if k == EV_TERMINATED {
        let extra = if e.extra.len() == 0 { "None".to_string() } else { head_hex(e.extra, 20) };
        f"<ConnectionTerminated error_code:{e.code}, last_stream_id:{e.last}, additional_data:{extra}>"
    } else if k == EV_ALTSVC {
        f"<AlternativeServiceAvailable origin:{text_of(e.origin)}, field_value:{text_of(e.field)}>"
    } else {
        "<UnknownFrameReceived>".to_string()
    }
}

// ---------------------------------------------------------------- h2: settings

// h2.settings.Settings: each setting's deque of values, the acknowledged
// one first and the ones waiting for an ACK after it, in dict order.
struct Settings {
    keys: Vec[i64],
    vals: Vec[Vec[i64]],
}

fn validate_setting(key: i64, value: i64) -> i64 {
    if key == 2 {
        if value != 0 and value != 1 { return 1; }
    } else if key == 4 {
        if value < 0 or value > 2147483647 { return 3; }
    } else if key == 5 {
        if value < 16384 or value > 16777215 { return 1; }
    } else if key == 6 {
        if value < 0 { return 1; }
    } else if key == 8 {
        if value != 0 and value != 1 { return 1; }
    }
    0
}

fn new_settings(client: bool, initial: ref Vec[(i64, i64)]) -> Settings {
    let mut s = Settings { keys: vec![1, 2, 4, 5, 8], vals: Vec.new() };
    s.vals.push(vec![4096]);
    s.vals.push(vec![if client { 1 } else { 0 }]);
    s.vals.push(vec![65535]);
    s.vals.push(vec![16384]);
    s.vals.push(vec![0]);
    for (k, v) in initial.iter() {
        let i = s.find(k);
        if i < 0 {
            s.keys.push(k);
            s.vals.push(vec![v]);
        } else {
            s.vals[i] = vec![v];
        }
    }
    s
}

impl Settings {
    fn find(ref self, key: i64) -> i64 {
        let mut i = 0;
        while i < self.keys.len() {
            if self.keys[i] == key {
                return i;
            }
            i += 1;
        }
        -1
    }

    // Mapping.get: the acknowledged value, NONE when there is none.
    fn get(ref self, key: i64) -> i64 {
        let i = self.find(key);
        if i < 0 { NONE } else { self.vals[i][0] }
    }

    fn set(mut ref self, key: i64, value: i64) -> Result[(), H2Err] {
        let code = validate_setting(key, value);
        if code != 0 {
            return Err(err_of("InvalidSettingsValueError", f"Setting {key} has invalid value {value}", code));
        }
        let i = self.find(key);
        if i < 0 {
            self.keys.push(key);
            self.vals.push(vec![NONE, value]);
        } else {
            self.vals[i].push(value);
        }
        Ok(())
    }

    fn update(mut ref self, pairs: ref Vec[(i64, i64)]) -> Result[(), H2Err] {
        for (k, v) in pairs.iter() {
            self.set(k, v)?;
        }
        Ok(())
    }

    fn acknowledge(mut ref self) -> Vec[Changed] {
        let mut out: Vec[Changed] = Vec.new();
        let mut i = 0;
        while i < self.keys.len() {
            if self.vals[i].len() > 1 {
                let old = self.vals[i].remove(0);
                out.push(Changed { setting: self.keys[i], original: old, new: self.vals[i][0] });
            }
            i += 1;
        }
        out
    }

    // items(): __getitem__ raises KeyError on a setting not yet acknowledged.
    fn items(ref self) -> Result[Vec[(i64, i64)], H2Err] {
        let mut out: Vec[(i64, i64)] = Vec.new();
        let mut i = 0;
        while i < self.keys.len() {
            let v = self.vals[i][0];
            if v == NONE {
                return Err(err_of("KeyError", "".to_string(), 0));
            }
            out.push((self.keys[i], v));
            i += 1;
        }
        Ok(out)
    }

    fn max_concurrent_streams(ref self) -> i64 {
        let v = self.get(3);
        if v == NONE { 4294967297 } else { v }
    }
}

fn find_change(cs: ref Vec[Changed], key: i64) -> i64 {
    let mut i = 0;
    while i < cs.len() {
        if cs[i].setting == key {
            return i;
        }
        i += 1;
    }
    -1
}

// ---------------------------------------------------------------- h2: windows

const LARGEST_WINDOW: i64 = 2147483647;

#[derive(Clone)]
struct Win {
    max: i64,
    cur: i64,
    processed: i64,
}

fn new_win(size: i64) -> Win {
    Win { max: size, cur: size, processed: 0 }
}

impl Win {
    fn consumed(mut ref self, size: i64) -> Result[(), H2Err] {
        self.cur -= size;
        if self.cur < 0 {
            return Err(flow_err("Flow control window shrunk below 0".to_string()));
        }
        Ok(())
    }

    fn opened(mut ref self, size: i64) -> Result[(), H2Err] {
        self.cur += size;
        if self.cur > LARGEST_WINDOW {
            return Err(flow_err(f"Flow control window mustn't exceed {LARGEST_WINDOW}"));
        }
        if self.cur > self.max {
            self.max = self.cur;
        }
        Ok(())
    }

    // process_bytes: the increment to send, 0 standing in for None too
    // (both are false where h2 tests it).
    fn process(mut ref self, size: i64) -> i64 {
        self.processed += size;
        if self.processed == 0 {
            return 0;
        }
        let max_increment = self.max - self.cur;
        let mut increment = 0;
        let quarter = if self.max / 4 < 1024 { self.max / 4 } else { 1024 };
        if (self.cur == 0 and self.processed > quarter) or self.processed >= self.max / 2 {
            increment = if self.processed < max_increment { self.processed } else { max_increment };
            self.processed = 0;
        }
        self.cur += increment;
        increment
    }
}

fn guard_increment_window(current: i64, increment: i64) -> Result[i64, H2Err] {
    let n = current + increment;
    if n > LARGEST_WINDOW {
        return Err(flow_err(f"May not increment flow control window past {LARGEST_WINDOW}"));
    }
    Ok(n)
}

// ---------------------------------------------------------------- h2: configuration

#[derive(Clone)]
struct Config {
    client: bool,
    encoding: bool,
    validate_out: bool,
    normalize_out: bool,
    split_cookies: bool,
    validate_in: bool,
    normalize_in: bool,
}

// ---------------------------------------------------------------- h2: byte helpers

fn eq_str(v: ref Vec[u8], s: Str) -> bool {
    same_bytes(v, bytes_of(s.to_string()))
}

fn starts_with_byte(v: ref Vec[u8], b: i64) -> bool {
    v.len() > 0 and v[0] as i64 == b
}

// Python's `a in b` on two bytes objects: a substring test.
fn is_substring(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() > b.len() {
        return false;
    }
    let mut i = 0;
    while i + a.len() <= b.len() {
        let mut j = 0;
        while j < a.len() and a[j] == b[i + j] {
            j += 1;
        }
        if j == a.len() {
            return true;
        }
        i += 1;
    }
    false
}

fn is_ws(b: u8) -> bool {
    let c = b as i64;
    c == 32 or (c >= 9 and c <= 13)
}

fn lower_bytes(v: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for b in v.iter() {
        let c = *b as i64;
        if c >= 65 and c <= 90 { out.push((c + 32) as u8); } else { out.push(*b); }
    }
    out
}

fn strip_bytes(v: ref Vec[u8]) -> Vec[u8] {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and is_ws(v[lo]) {
        lo += 1;
    }
    while hi > lo and is_ws(v[hi - 1]) {
        hi -= 1;
    }
    sub(v, lo, hi)
}

fn has_upper(v: ref Vec[u8]) -> bool {
    for b in v.iter() {
        let c = *b as i64;
        if c >= 65 and c <= 90 {
            return true;
        }
    }
    false
}

// bytes.split(sep) with a two-byte separator.
fn split_bytes(v: ref Vec[u8], sep: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < v.len() {
        let mut j = 0;
        while j < sep.len() and i + j < v.len() and v[i + j] == sep[j] {
            j += 1;
        }
        if j == sep.len() {
            out.push(cur);
            cur = Vec.new();
            i += sep.len();
        } else {
            cur.push(v[i]);
            i += 1;
        }
    }
    out.push(cur);
    out
}

// int(v, 10) on bytes: surrounding whitespace, a sign, and underscores
// between digits. None when Python raises ValueError.
fn py_int(v: ref Vec[u8]) -> Option[i64] {
    let s = strip_bytes(v);
    let mut i = 0;
    let mut neg = false;
    if i < s.len() and (s[i] as i64 == 43 or s[i] as i64 == 45) {
        neg = s[i] as i64 == 45;
        i += 1;
    }
    if i >= s.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < s.len() {
        let c = s[i] as i64;
        if c >= 48 and c <= 57 {
            n = n * 10 + (c - 48);
            prev_digit = true;
        } else if c == 95 and prev_digit and i + 1 < s.len() {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if not prev_digit {
        return None;
    }
    Some(if neg { -n } else { n })
}

// base64.urlsafe_b64encode / urlsafe_b64decode.
fn b64_alphabet() -> Vec[char] {
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_".chars().collect()
}

fn b64_encode(data: ref Vec[u8]) -> Vec[u8] {
    let al = b64_alphabet();
    let mut out = String.new();
    let mut i = 0;
    while i < data.len() {
        let b0 = data[i] as i64;
        let b1 = if i + 1 < data.len() { data[i + 1] as i64 } else { 0 };
        let b2 = if i + 2 < data.len() { data[i + 2] as i64 } else { 0 };
        let n = b0 * 65536 + b1 * 256 + b2;
        out.push(al[(n / 262144) % 64]);
        out.push(al[(n / 4096) % 64]);
        if i + 1 < data.len() { out.push(al[(n / 64) % 64]); } else { out.push('='); }
        if i + 2 < data.len() { out.push(al[n % 64]); } else { out.push('='); }
        i += 3;
    }
    bytes_of(out)
}

fn b64_decode(text: ref Vec[u8]) -> Vec[u8] {
    let al = b64_alphabet();
    let mut vals: Vec[i64] = Vec.new();
    for b in text.iter() {
        let c = *b as char;
        let mut k = 0;
        while k < 64 {
            if al[k] == c {
                vals.push(k);
                break;
            }
            k += 1;
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < vals.len() {
        let a = vals[i];
        let b = vals[i + 1];
        let c = if i + 2 < vals.len() { vals[i + 2] } else { -1 };
        let d = if i + 3 < vals.len() { vals[i + 3] } else { -1 };
        out.push(((a * 4 + b / 16) % 256) as u8);
        if c >= 0 {
            out.push((((b % 16) * 16 + c / 4) % 256) as u8);
        }
        if d >= 0 {
            out.push((((c % 4) * 64 + d) % 256) as u8);
        }
        i += 4;
    }
    out
}
// ---------------------------------------------------------------- h2: header pipelines

// h2.utilities chains generators: normalize_outbound_headers,
// validate_outbound_headers, normalize_inbound_headers and
// validate_headers each wrap the iterable they are given, and the
// encoder (or list()) pulls one header at a time through every stage.
// So a header that fails a check stops the chain after the headers
// before it went all the way through (and, outbound, into the encoder's
// dynamic table), and the checks a stage runs once its input is
// exhausted run in stage order after the last header. The port runs
// the same stages one header at a time and returns what came out of
// the end together with the error that stopped it.

const ST_LOWERCASE: i64 = 1;
const ST_SPLIT_COOKIES: i64 = 2;
const ST_STRIP: i64 = 3;
const ST_STRIP_CONNECTION: i64 = 4;
const ST_SECURE: i64 = 5;
const ST_EMPTY_NAME: i64 = 10;
const ST_UPPERCASE: i64 = 11;
const ST_WHITESPACE: i64 = 12;
const ST_TE: i64 = 13;
const ST_CONNECTION: i64 = 14;
const ST_PSEUDO: i64 = 15;
const ST_HOST_AUTHORITY: i64 = 16;
const ST_PATH: i64 = 17;
const ST_COMBINE_COOKIES: i64 = 20;

// HeaderValidationFlags
#[derive(Clone)]
struct VFlags {
    client: bool,
    trailer: bool,
    response: bool,
    push: bool,
}

// What a stateful stage remembers between headers.
struct PState {
    seen: Vec[Vec[u8]],
    regular: bool,
    has_method: bool,
    method: Vec[u8],
    has_authority: bool,
    authority: Vec[u8],
    has_host: bool,
    host: Vec[u8],
    cookies: Vec[Vec[u8]],
}

fn new_pstate() -> PState {
    PState {
        seen: Vec.new(),
        regular: false,
        has_method: false,
        method: Vec.new(),
        has_authority: false,
        authority: Vec.new(),
        has_host: false,
        host: Vec.new(),
        cookies: Vec.new(),
    }
}

fn is_connection_header(name: ref Vec[u8]) -> bool {
    eq_str(name, "connection") or eq_str(name, "proxy-connection") or eq_str(name, "keep-alive")
        or eq_str(name, "transfer-encoding") or eq_str(name, "upgrade")
}

fn is_allowed_pseudo(name: ref Vec[u8]) -> bool {
    eq_str(name, ":method") or eq_str(name, ":scheme") or eq_str(name, ":authority")
        or eq_str(name, ":path") or eq_str(name, ":status") or eq_str(name, ":protocol")
}

fn is_request_only(name: ref Vec[u8]) -> bool {
    eq_str(name, ":scheme") or eq_str(name, ":path") or eq_str(name, ":authority")
        or eq_str(name, ":method") or eq_str(name, ":protocol")
}

fn contains_name(set: ref Vec[Vec[u8]], name: ref Vec[u8]) -> bool {
    for n in set.iter() {
        if same_bytes(n, name) {
            return true;
        }
    }
    false
}

// A Python set of bytes. One element prints the same in any order; for
// more the port keeps insertion order where Python follows its hashes.
fn set_repr(set: ref Vec[Vec[u8]]) -> String {
    let mut s = "{".to_string();
    let mut i = 0;
    while i < set.len() {
        if i > 0 {
            s.push_str(", ");
        }
        s.push_str(bytes_repr(set[i]));
        i += 1;
    }
    s.push('}');
    s
}

fn hdr(name: ref Vec[u8], value: ref Vec[u8], never: bool) -> Header {
    Header { name: name.clone(), value: value.clone(), never: never }
}

fn one(h: ref Header) -> Vec[Header] {
    let mut v: Vec[Header] = Vec.new();
    v.push(h.clone());
    v
}

// One header into a stage: what the stage yields for it.
fn stage_apply(stage: i64, h: ref Header, st: mut ref PState) -> Result[Vec[Header], H2Err] {
    let mut out: Vec[Header] = Vec.new();
    if stage == ST_LOWERCASE {
        out.push(hdr(lower_bytes(h.name), h.value, h.never));
    } else if stage == ST_SPLIT_COOKIES {
        if eq_str(h.name, "cookie") {
            for part in split_bytes(h.value, bytes_of("; ".to_string())).iter() {
                out.push(hdr(h.name, part, h.never));
            }
        } else {
            out.push(h.clone());
        }
    } else if stage == ST_STRIP {
        out.push(hdr(strip_bytes(h.name), strip_bytes(h.value), h.never));
    } else if stage == ST_STRIP_CONNECTION {
        if not is_connection_header(h.name) {
            out.push(h.clone());
        }
    } else if stage == ST_SECURE {
        // `header[0] in b'cookie'` is a substring test.
        let secure = eq_str(h.name, "authorization") or eq_str(h.name, "proxy-authorization")
            or (is_substring(h.name, bytes_of("cookie".to_string())) and h.value.len() < 20);
        if secure {
            out.push(hdr(h.name, h.value, true));
        } else {
            out.push(h.clone());
        }
    } else if stage == ST_EMPTY_NAME {
        if h.name.len() == 0 {
            return Err(proto("Received header name with zero length.".to_string()));
        }
        out.push(h.clone());
    } else if stage == ST_UPPERCASE {
        if has_upper(h.name) {
            return Err(proto(f"Received uppercase header name {bytes_repr(h.name)}."));
        }
        out.push(h.clone());
    } else if stage == ST_WHITESPACE {
        if h.name.len() == 0 {
            return Err(err_of("IndexError", "index out of range".to_string(), 0));
        }
        if is_ws(h.name[0]) or is_ws(h.name[h.name.len() - 1]) {
            return Err(proto(f"Received header name surrounded by whitespace {bytes_repr(h.name)}"));
        }
        if h.value.len() > 0 and (is_ws(h.value[0]) or is_ws(h.value[h.value.len() - 1])) {
            return Err(proto(f"Received header value surrounded by whitespace {bytes_repr(h.value)}"));
        }
        out.push(h.clone());
    } else if stage == ST_TE {
        if eq_str(h.name, "te") and not eq_str(lower_bytes(h.value), "trailers") {
            return Err(proto(f"Invalid value for TE header: {bytes_repr(h.value)}"));
        }
        out.push(h.clone());
    } else if stage == ST_CONNECTION {
        if is_connection_header(h.name) {
            return Err(proto(f"Connection-specific header field present: {bytes_repr(h.name)}."));
        }
        out.push(h.clone());
    } else if stage == ST_PSEUDO {
        if h.name.len() == 0 {
            return Err(err_of("IndexError", "index out of range".to_string(), 0));
        }
        if starts_with_byte(h.name, 58) {
            if contains_name(st.seen, h.name) {
                return Err(proto(f"Received duplicate pseudo-header field {bytes_repr(h.name)}"));
            }
            st.seen.push(h.name.clone());
            if st.regular {
                return Err(proto(f"Received pseudo-header field out of sequence: {bytes_repr(h.name)}"));
            }
            if not is_allowed_pseudo(h.name) {
                return Err(proto(f"Received custom pseudo-header field {bytes_repr(h.name)}"));
            }
            if is_substring(h.name, bytes_of(":method".to_string())) {
                st.has_method = true;
                st.method = h.value.clone();
            }
        } else {
            st.regular = true;
        }
        out.push(h.clone());
    } else if stage == ST_HOST_AUTHORITY {
        if eq_str(h.name, ":authority") {
            st.has_authority = true;
            st.authority = h.value.clone();
        } else if eq_str(h.name, "host") {
            st.has_host = true;
            st.host = h.value.clone();
        }
        out.push(h.clone());
    } else if stage == ST_PATH {
        if eq_str(h.name, ":path") and h.value.len() == 0 {
            return Err(proto("An empty :path header is forbidden".to_string()));
        }
        out.push(h.clone());
    } else if stage == ST_COMBINE_COOKIES {
        if eq_str(h.name, "cookie") {
            st.cookies.push(h.value.clone());
        } else {
            out.push(h.clone());
        }
    }
    Ok(out)
}

fn assert_in_set(name: Str, set: ref Vec[Vec[u8]]) -> Result[(), H2Err] {
    let n = bytes_of(name.to_string());
    if not contains_name(set, n) {
        return Err(proto(f"Header block missing mandatory {bytes_repr(n)} header"));
    }
    Ok(())
}

// _check_pseudo_header_field_acceptability
fn pseudo_acceptability(st: ref PState, fl: ref VFlags) -> Result[(), H2Err] {
    if fl.trailer and st.seen.len() > 0 {
        return Err(proto(f"Received pseudo-header in trailer {set_repr(st.seen)}"));
    }
    if fl.response {
        assert_in_set(":status", st.seen)?;
        let mut bad: Vec[Vec[u8]] = Vec.new();
        for n in st.seen.iter() {
            if is_request_only(n) {
                bad.push(n.clone());
            }
        }
        if bad.len() > 0 {
            return Err(proto(f"Encountered request-only headers {set_repr(bad)}"));
        }
    } else if not fl.trailer {
        assert_in_set(":path", st.seen)?;
        assert_in_set(":method", st.seen)?;
        assert_in_set(":scheme", st.seen)?;
        let mut bad: Vec[Vec[u8]] = Vec.new();
        for n in st.seen.iter() {
            if eq_str(n, ":status") {
                bad.push(n.clone());
            }
        }
        if bad.len() > 0 {
            return Err(proto(f"Encountered response-only headers {set_repr(bad)}"));
        }
        let connect = st.has_method and eq_str(st.method, "CONNECT");
        if not connect {
            let mut bad2: Vec[Vec[u8]] = Vec.new();
            for n in st.seen.iter() {
                if eq_str(n, ":protocol") {
                    bad2.push(n.clone());
                }
            }
            if bad2.len() > 0 {
                return Err(proto(f"Encountered connect-request-only headers {set_repr(bad2)}"));
            }
        }
    }
    Ok(())
}

// What a stage does once its input is exhausted.
fn stage_flush(stage: i64, st: mut ref PState, fl: ref VFlags) -> Result[Vec[Header], H2Err] {
    let mut out: Vec[Header] = Vec.new();
    if stage == ST_PSEUDO {
        pseudo_acceptability(st, fl)?;
    } else if stage == ST_HOST_AUTHORITY {
        if not st.has_authority and not st.has_host {
            return Err(proto("Request header block does not have an :authority or Host header.".to_string()));
        }
        if st.has_authority and st.has_host and not same_bytes(st.authority, st.host) {
            return Err(proto(f"Request header block has mismatched :authority and Host headers: {bytes_repr(st.authority)} / {bytes_repr(st.host)}"));
        }
    } else if stage == ST_COMBINE_COOKIES {
        if st.cookies.len() > 0 {
            let mut joined: Vec[u8] = Vec.new();
            let mut i = 0;
            while i < st.cookies.len() {
                if i > 0 {
                    push_all(mut joined, bytes_of("; ".to_string()));
                }
                push_all(mut joined, st.cookies[i]);
                i += 1;
            }
            out.push(hdr(bytes_of("cookie".to_string()), joined, true));
        }
    }
    Ok(out)
}

fn push_through(stages: ref Vec[i64], k: i64, h: ref Header, sts: mut ref Vec[PState], out: mut ref Vec[Header]) -> Result[(), H2Err] {
    if k == stages.len() {
        out.push(h.clone());
        return Ok(());
    }
    let outs = stage_apply(stages[k], h, mut sts[k])?;
    for o in outs.iter() {
        push_through(stages, k + 1, o, mut sts, mut out)?;
    }
    Ok(())
}

// Pull every header through the chain: what came out, and the error
// that stopped it, if one did.
fn run_pipe(stages: ref Vec[i64], fl: ref VFlags, input: ref Vec[Header]) -> (Vec[Header], Option[H2Err]) {
    let mut sts: Vec[PState] = Vec.new();
    for _ in stages.iter() {
        sts.push(new_pstate());
    }
    let mut out: Vec[Header] = Vec.new();
    for h in input.iter() {
        if let Err(e) = push_through(stages, 0, h, mut sts, mut out) {
            return (out, Some(e));
        }
    }
    let mut k = 0;
    while k < stages.len() {
        match stage_flush(stages[k], mut sts[k], fl) {
            Ok(more) => {
                for h in more.iter() {
                    if let Err(e) = push_through(stages, k + 1, h, mut sts, mut out) {
                        return (out, Some(e));
                    }
                }
            }
            Err(e) => {
                return (out, Some(e));
            }
        }
        k += 1;
    }
    (out, None)
}

fn outbound_stages(cfg: ref Config, fl: ref VFlags) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if cfg.normalize_out {
        v.push(ST_LOWERCASE);
        if cfg.split_cookies {
            v.push(ST_SPLIT_COOKIES);
        }
        v.push(ST_STRIP);
        v.push(ST_STRIP_CONNECTION);
        v.push(ST_SECURE);
    }
    if cfg.validate_out {
        v.push(ST_TE);
        v.push(ST_CONNECTION);
        v.push(ST_PSEUDO);
        if not fl.response and not fl.trailer {
            v.push(ST_HOST_AUTHORITY);
            v.push(ST_PATH);
        }
    }
    v
}

fn inbound_stages(cfg: ref Config, fl: ref VFlags) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if cfg.normalize_in {
        v.push(ST_COMBINE_COOKIES);
    }
    if cfg.validate_in {
        v.push(ST_EMPTY_NAME);
        v.push(ST_UPPERCASE);
        v.push(ST_WHITESPACE);
        v.push(ST_TE);
        v.push(ST_CONNECTION);
        v.push(ST_PSEUDO);
        if not fl.response and not fl.trailer {
            v.push(ST_HOST_AUTHORITY);
            v.push(ST_PATH);
        }
    }
    v
}

fn is_informational_response(hs: ref Vec[Header]) -> bool {
    for h in hs.iter() {
        if not starts_with_byte(h.name, 58) {
            return false;
        }
        if not eq_str(h.name, ":status") {
            continue;
        }
        return starts_with_byte(h.value, 49);
    }
    false
}

fn find_header(hs: ref Vec[Header], name: Str) -> Option[Vec[u8]] {
    for h in hs.iter() {
        if eq_str(h.name, name) {
            return Some(h.value.clone());
        }
    }
    None
}
// ---------------------------------------------------------------- h2: streams

const S_IDLE: i64 = 0;
const S_RESERVED_REMOTE: i64 = 1;
const S_RESERVED_LOCAL: i64 = 2;
const S_OPEN: i64 = 3;
const S_HALF_CLOSED_REMOTE: i64 = 4;
const S_HALF_CLOSED_LOCAL: i64 = 5;
const S_CLOSED: i64 = 6;

const IN_SEND_HEADERS: i64 = 0;
const IN_SEND_PUSH_PROMISE: i64 = 1;
const IN_SEND_RST_STREAM: i64 = 2;
const IN_SEND_DATA: i64 = 3;
const IN_SEND_WINDOW_UPDATE: i64 = 4;
const IN_SEND_END_STREAM: i64 = 5;
const IN_RECV_HEADERS: i64 = 6;
const IN_RECV_PUSH_PROMISE: i64 = 7;
const IN_RECV_RST_STREAM: i64 = 8;
const IN_RECV_DATA: i64 = 9;
const IN_RECV_WINDOW_UPDATE: i64 = 10;
const IN_RECV_END_STREAM: i64 = 11;
const IN_RECV_CONTINUATION: i64 = 12;
const IN_SEND_INFORMATIONAL_HEADERS: i64 = 13;
const IN_RECV_INFORMATIONAL_HEADERS: i64 = 14;
const IN_SEND_ALTERNATIVE_SERVICE: i64 = 15;
const IN_RECV_ALTERNATIVE_SERVICE: i64 = 16;
const IN_UPGRADE_CLIENT: i64 = 17;
const IN_UPGRADE_SERVER: i64 = 18;

// StreamClosedBy, -1 for None
const BY_SEND_END: i64 = 0;
const BY_RECV_END: i64 = 1;
const BY_SEND_RST: i64 = 2;
const BY_RECV_RST: i64 = 3;

fn stream_state_name(s: i64) -> String {
    let names = vec!["IDLE", "RESERVED_REMOTE", "RESERVED_LOCAL", "OPEN", "HALF_CLOSED_REMOTE", "HALF_CLOSED_LOCAL", "CLOSED"];
    names[s].to_string()
}

fn stream_input_name(i: i64) -> String {
    let names = vec![
        "SEND_HEADERS", "SEND_PUSH_PROMISE", "SEND_RST_STREAM", "SEND_DATA", "SEND_WINDOW_UPDATE",
        "SEND_END_STREAM", "RECV_HEADERS", "RECV_PUSH_PROMISE", "RECV_RST_STREAM", "RECV_DATA",
        "RECV_WINDOW_UPDATE", "RECV_END_STREAM", "RECV_CONTINUATION", "SEND_INFORMATIONAL_HEADERS",
        "RECV_INFORMATIONAL_HEADERS", "SEND_ALTERNATIVE_SERVICE", "RECV_ALTERNATIVE_SERVICE",
        "UPGRADE_CLIENT", "UPGRADE_SERVER",
    ];
    names[i].to_string()
}

// H2Stream with its H2StreamStateMachine folded in. `client` is the
// machine's three-valued flag: -1 None, 0 False, 1 True.
#[derive(Clone)]
struct Stream {
    sid: i64,
    state: i64,
    client: i64,
    headers_sent: bool,
    trailers_sent: bool,
    headers_received: bool,
    trailers_received: bool,
    closed_by: i64,
    max_out_frame: i64,
    has_method: bool,
    method: Vec[u8],
    out_win: i64,
    in_win: Win,
    has_expected: bool,
    expected: i64,
    actual: i64,
    has_authority: bool,
    authority: Vec[u8],
    cfg: Config,
}

fn new_stream(sid: i64, cfg: ref Config, inbound: i64, outbound: i64) -> Stream {
    Stream {
        sid: sid,
        state: S_IDLE,
        client: -1,
        headers_sent: false,
        trailers_sent: false,
        headers_received: false,
        trailers_received: false,
        closed_by: -1,
        max_out_frame: 0,
        has_method: false,
        method: Vec.new(),
        out_win: outbound,
        in_win: new_win(inbound),
        has_expected: false,
        expected: 0,
        actual: 0,
        has_authority: false,
        authority: Vec.new(),
        cfg: cfg.clone(),
    }
}

fn stream_repr(s: ref Stream) -> String {
    f"<H2Stream id:{s.sid} state:<StreamState.{stream_state_name(s.state)}: {s.state}>>"
}

fn stream_is_open(s: ref Stream) -> bool {
    s.state == S_OPEN or s.state == S_HALF_CLOSED_LOCAL or s.state == S_HALF_CLOSED_REMOTE
}

fn evs1(e: own Ev) -> Vec[Ev] {
    let mut v: Vec[Ev] = Vec.new();
    v.push(e);
    v
}

// The transition callbacks, numbered as gen_kara.py's FUNCS.
fn sm_call(s: mut ref Stream, func: i64) -> Result[Vec[Ev], H2Err] {
    let none: Vec[Ev] = Vec.new();
    if func == 1 {
        // request_sent
        s.client = 1;
        s.headers_sent = true;
        return Ok(evs1(ev(EV_REQUEST_SENT, 0)));
    } else if func == 2 {
        // response_sent
        if not s.headers_sent {
            if s.client != 0 {
                return Err(proto("Client cannot send responses.".to_string()));
            }
            s.headers_sent = true;
            return Ok(evs1(ev(EV_RESPONSE_SENT, 0)));
        }
        if s.trailers_sent {
            return Err(assertion_err());
        }
        s.trailers_sent = true;
        return Ok(evs1(ev(EV_TRAILERS_SENT, 0)));
    } else if func == 3 {
        // request_received
        if s.headers_received or s.trailers_received {
            return Err(assertion_err());
        }
        s.client = 0;
        s.headers_received = true;
        return Ok(evs1(ev(EV_REQUEST, s.sid)));
    } else if func == 4 {
        // response_received
        if not s.headers_received {
            if s.client != 1 {
                return Err(assertion_err());
            }
            s.headers_received = true;
            return Ok(evs1(ev(EV_RESPONSE, s.sid)));
        }
        if s.trailers_received {
            return Err(assertion_err());
        }
        s.trailers_received = true;
        return Ok(evs1(ev(EV_TRAILERS, s.sid)));
    } else if func == 5 {
        // data_received
        if not s.headers_received {
            return Err(proto("cannot receive data before headers".to_string()));
        }
        return Ok(evs1(ev(EV_DATA, s.sid)));
    } else if func == 6 {
        // window_updated
        return Ok(evs1(ev(EV_WINDOW, s.sid)));
    } else if func == 7 {
        // stream_half_closed
        return Ok(evs1(ev(EV_ENDED, s.sid)));
    } else if func == 8 {
        // stream_ended
        s.closed_by = BY_RECV_END;
        return Ok(evs1(ev(EV_ENDED, s.sid)));
    } else if func == 9 {
        // stream_reset
        s.closed_by = BY_RECV_RST;
        return Ok(evs1(ev(EV_RESET, s.sid)));
    } else if func == 10 {
        // send_new_pushed_stream
        if s.client != -1 {
            return Err(assertion_err());
        }
        s.client = 0;
        s.headers_received = true;
        return Ok(none);
    } else if func == 11 {
        // recv_new_pushed_stream
        if s.client != -1 {
            return Err(assertion_err());
        }
        s.client = 1;
        s.headers_sent = true;
        return Ok(none);
    } else if func == 12 {
        // send_push_promise
        if s.client == 1 {
            return Err(proto("Cannot push streams from client peers.".to_string()));
        }
        return Ok(evs1(ev(EV_PUSH_SENT, 0)));
    } else if func == 13 {
        // recv_push_promise
        if s.client != 1 {
            if s.client == -1 {
                return Err(proto("Idle streams cannot receive pushes".to_string()));
            }
            return Err(proto("Cannot receive pushed streams as a server".to_string()));
        }
        return Ok(evs1(ev(EV_PUSHED, s.sid)));
    } else if func == 14 {
        // send_end_stream
        s.closed_by = BY_SEND_END;
        return Ok(none);
    } else if func == 15 {
        // send_reset_stream
        s.closed_by = BY_SEND_RST;
        return Ok(none);
    } else if func == 16 {
        // reset_stream_on_error
        s.closed_by = BY_SEND_RST;
        let mut e = closed_err(s.sid);
        let mut r = ev(EV_RESET, s.sid);
        r.code = 5;
        r.remote = false;
        e.events.push(r);
        return Err(e);
    } else if func == 17 or func == 18 {
        // recv_on_closed_stream, send_on_closed_stream
        return Err(closed_err(s.sid));
    } else if func == 19 {
        // recv_push_on_closed_stream
        if s.closed_by == -1 {
            return Err(assertion_err());
        }
        if s.closed_by == BY_SEND_RST {
            return Err(closed_err(s.sid));
        }
        return Err(proto("Attempted to push on closed stream.".to_string()));
    } else if func == 20 {
        // send_push_on_closed_stream
        return Err(proto("Attempted to push on closed stream.".to_string()));
    } else if func == 21 {
        // send_informational_response
        if s.headers_sent {
            return Err(proto("Information response after final response".to_string()));
        }
        return Ok(evs1(ev(EV_RESPONSE_SENT, 0)));
    } else if func == 22 {
        // recv_informational_response
        if s.headers_received {
            return Err(proto("Informational response after final response".to_string()));
        }
        return Ok(evs1(ev(EV_INFORMATIONAL, s.sid)));
    } else if func == 23 {
        // recv_alt_svc
        if s.client == 0 or s.headers_received {
            return Ok(none);
        }
        return Ok(evs1(ev(EV_ALTSVC, 0)));
    }
    // send_alt_svc
    if s.headers_sent {
        return Err(proto("Cannot send ALTSVC after sending response headers.".to_string()));
    }
    Ok(none)
}

// H2StreamStateMachine.process_input
fn sm_process(s: mut ref Stream, input: i64) -> Result[Vec[Ev], H2Err] {
    let (func, target) = stream_transition(s.state, input);
    if func < 0 {
        let old = s.state;
        s.state = S_CLOSED;
        return Err(proto(f"Invalid input StreamInputs.{stream_input_name(input)} in state {old}"));
    }
    s.state = target;
    if func == 0 {
        return Ok(Vec.new());
    }
    match sm_call(mut s, func) {
        Ok(evs) => Ok(evs),
        Err(e) => {
            if e.kind == "AssertionError" {
                s.state = S_CLOSED;
                return Err(proto("".to_string()));
            }
            if is_protocol(e) {
                s.state = S_CLOSED;
            }
            Err(e)
        }
    }
}

fn build_flags(s: ref Stream, events: ref Vec[Ev]) -> Result[VFlags, H2Err] {
    if events.len() == 0 {
        return Err(index_err());
    }
    let k = events[0].kind;
    Ok(VFlags {
        client: s.client == 1,
        trailer: k == EV_TRAILERS_SENT or k == EV_TRAILERS,
        response: k == EV_RESPONSE_SENT or k == EV_RESPONSE or k == EV_INFORMATIONAL,
        push: k == EV_PUSHED or k == EV_PUSH_SENT,
    })
}

// _build_headers_frames: normalise and validate as the encoder pulls,
// then cut the block into the first frame and CONTINUATION frames.
fn build_headers_frames(s: ref Stream, hc: ref Ctx, enc: mut ref Encoder, headers: ref Vec[Header], first: own Frame, fl: ref VFlags) -> Result[Vec[Frame], H2Err] {
    let stages = outbound_stages(s.cfg, fl);
    let (out, failed) = run_pipe(stages, fl, headers);
    let encoded = enc.encode(hc, out, true);
    if let Some(e) = failed {
        return Err(e);
    }
    if encoded.len() == 0 {
        return Err(index_err());
    }
    let size = s.max_out_frame;
    let mut frames: Vec[Frame] = Vec.new();
    let mut f = first;
    f.data = sub(encoded, 0, size);
    frames.push(f);
    let mut at = size;
    while at < encoded.len() {
        let mut cf = blank_frame(k_continuation(), s.sid);
        cf.data = sub(encoded, at, at + size);
        frames.push(cf);
        at += size;
    }
    let last = frames.len() - 1;
    add_flag(mut frames[last], "END_HEADERS".to_string());
    Ok(frames)
}

fn stream_send_headers(s: mut ref Stream, hc: ref Ctx, enc: mut ref Encoder, headers: ref Vec[Header], end: bool) -> Result[Vec[Frame], H2Err] {
    let mut input = IN_SEND_HEADERS;
    if s.client != 1 and is_informational_response(headers) {
        if end {
            return Err(proto("Cannot set END_STREAM on informational responses.".to_string()));
        }
        input = IN_SEND_INFORMATIONAL_HEADERS;
    }
    let events = sm_process(mut s, input)?;
    let hf = blank_frame(k_headers(), s.sid);
    let fl = build_flags(s, events)?;
    let mut frames = build_headers_frames(s, hc, mut enc, headers, hf, fl)?;
    if end {
        sm_process(mut s, IN_SEND_END_STREAM)?;
        add_flag(mut frames[0], "END_STREAM".to_string());
    }
    if s.trailers_sent and not end {
        return Err(proto("Trailers must have END_STREAM set.".to_string()));
    }
    if s.client == 1 and not s.has_authority {
        if let Some(a) = find_header(headers, ":authority") {
            s.has_authority = true;
            s.authority = a;
        }
    }
    // extract_method_header
    match find_header(headers, ":method") {
        Some(m) => {
            s.has_method = true;
            s.method = m;
        }
        None => {
            s.has_method = false;
        }
    }
    Ok(frames)
}

fn stream_push_in_band(s: mut ref Stream, hc: ref Ctx, enc: mut ref Encoder, related: i64, headers: ref Vec[Header]) -> Result[Vec[Frame], H2Err] {
    let events = sm_process(mut s, IN_SEND_PUSH_PROMISE)?;
    let mut ppf = blank_frame(k_pushpromise(), s.sid);
    ppf.promised_stream_id = related;
    let fl = build_flags(s, events)?;
    build_headers_frames(s, hc, mut enc, headers, ppf, fl)
}

fn stream_locally_pushed(s: mut ref Stream) -> Result[(), H2Err] {
    let events = sm_process(mut s, IN_SEND_PUSH_PROMISE)?;
    if events.len() > 0 {
        return Err(assertion_err());
    }
    Ok(())
}

fn data_flow_len(f: ref Frame) -> i64 {
    let pad = if has_flag(f, "PADDED".to_string()) { f.pad_length + 1 } else { 0 };
    f.data.len() + pad
}

fn stream_send_data(s: mut ref Stream, data: ref Vec[u8], end: bool, pad: i64) -> Result[Vec[Frame], H2Err] {
    sm_process(mut s, IN_SEND_DATA)?;
    let mut df = blank_frame(k_data(), s.sid);
    df.data = data.clone();
    if end {
        sm_process(mut s, IN_SEND_END_STREAM)?;
        add_flag(mut df, "END_STREAM".to_string());
    }
    if pad >= 0 {
        add_flag(mut df, "PADDED".to_string());
        df.pad_length = pad;
    }
    s.out_win -= data_flow_len(df);
    if s.out_win < 0 {
        return Err(assertion_err());
    }
    let mut v: Vec[Frame] = Vec.new();
    v.push(df);
    Ok(v)
}

fn frames1(f: own Frame) -> Vec[Frame] {
    let mut v: Vec[Frame] = Vec.new();
    v.push(f);
    v
}

fn stream_end_stream(s: mut ref Stream) -> Result[Vec[Frame], H2Err] {
    sm_process(mut s, IN_SEND_END_STREAM)?;
    let mut df = blank_frame(k_data(), s.sid);
    add_flag(mut df, "END_STREAM".to_string());
    Ok(frames1(df))
}

fn stream_advertise_alt(s: mut ref Stream, field: ref Vec[u8]) -> Result[Vec[Frame], H2Err] {
    sm_process(mut s, IN_SEND_ALTERNATIVE_SERVICE)?;
    let mut f = blank_frame(k_altsvc(), s.sid);
    f.field = field.clone();
    Ok(frames1(f))
}

fn window_update_frame(sid: i64, increment: i64) -> Frame {
    let mut f = blank_frame(k_windowupdate(), sid);
    f.window_increment = increment;
    f
}

fn rst_frame(sid: i64, code: i64) -> Frame {
    let mut f = blank_frame(k_rststream(), sid);
    f.error_code = code;
    f
}

fn stream_increase_window(s: mut ref Stream, increment: i64) -> Result[Vec[Frame], H2Err] {
    sm_process(mut s, IN_SEND_WINDOW_UPDATE)?;
    s.in_win.opened(increment)?;
    Ok(frames1(window_update_frame(s.sid, increment)))
}

// _process_received_headers
fn process_received(s: ref Stream, headers: ref Vec[Header], fl: ref VFlags) -> Result[Vec[Header], H2Err] {
    let stages = inbound_stages(s.cfg, fl);
    let (out, failed) = run_pipe(stages, fl, headers);
    if let Some(e) = failed {
        return Err(e);
    }
    Ok(out)
}

fn stream_recv_push_in_band(s: mut ref Stream, promised: i64, headers: ref Vec[Header]) -> Result[Vec[Ev], H2Err] {
    let mut events = sm_process(mut s, IN_RECV_PUSH_PROMISE)?;
    if events.len() == 0 {
        return Err(index_err());
    }
    events[0].pushed = promised;
    let fl = build_flags(s, events)?;
    events[0].hdrs = process_received(s, headers, fl)?;
    events[0].as_str = s.cfg.encoding;
    Ok(events)
}

fn stream_remotely_pushed(s: mut ref Stream, headers: ref Vec[Header]) -> Result[(), H2Err] {
    sm_process(mut s, IN_RECV_PUSH_PROMISE)?;
    match find_header(headers, ":authority") {
        Some(a) => {
            s.has_authority = true;
            s.authority = a;
        }
        None => {
            s.has_authority = false;
        }
    }
    Ok(())
}

fn init_content_length(s: mut ref Stream, headers: ref Vec[Header]) -> Result[(), H2Err] {
    if s.has_method and eq_str(s.method, "HEAD") {
        s.has_expected = true;
        s.expected = 0;
        return Ok(());
    }
    for h in headers.iter() {
        if eq_str(h.name, "content-length") {
            match py_int(h.value) {
                Some(n) => {
                    s.has_expected = true;
                    s.expected = n;
                }
                None => {
                    return Err(proto(f"Invalid content-length header: {bytes_repr(h.value)}"));
                }
            }
            return Ok(());
        }
    }
    Ok(())
}

fn body_length_err(expected: i64, actual: i64) -> H2Err {
    err_of("InvalidBodyLengthError", f"InvalidBodyLengthError: Expected {expected} bytes, received {actual}", 1)
}

fn track_content_length(s: mut ref Stream, length: i64, end: bool) -> Result[(), H2Err] {
    s.actual += length;
    if s.has_expected {
        if s.expected < s.actual {
            return Err(body_length_err(s.expected, s.actual));
        }
        if end and s.expected != s.actual {
            return Err(body_length_err(s.expected, s.actual));
        }
    }
    Ok(())
}

fn stream_receive_headers(s: mut ref Stream, headers: ref Vec[Header], end: bool) -> Result[Vec[Ev], H2Err] {
    let mut input = IN_RECV_HEADERS;
    if is_informational_response(headers) {
        if end {
            return Err(proto("Cannot set END_STREAM on informational responses".to_string()));
        }
        input = IN_RECV_INFORMATIONAL_HEADERS;
    }
    let mut events = sm_process(mut s, input)?;
    if end {
        let es = sm_process(mut s, IN_RECV_END_STREAM)?;
        for e in es.iter() {
            events.push(e.clone());
        }
    }
    init_content_length(mut s, headers)?;
    if events[0].kind == EV_TRAILERS and not end {
        return Err(proto("Trailers must have END_STREAM set".to_string()));
    }
    let fl = build_flags(s, events)?;
    events[0].hdrs = process_received(s, headers, fl)?;
    events[0].as_str = s.cfg.encoding;
    Ok(events)
}

fn stream_receive_data(s: mut ref Stream, data: ref Vec[u8], end: bool, flow: i64) -> Result[Vec[Ev], H2Err] {
    let mut events = sm_process(mut s, IN_RECV_DATA)?;
    s.in_win.consumed(flow)?;
    track_content_length(mut s, data.len(), end)?;
    if end {
        let es = sm_process(mut s, IN_RECV_END_STREAM)?;
        for e in es.iter() {
            events.push(e.clone());
        }
    }
    events[0].data = data.clone();
    events[0].flow = flow;
    Ok(events)
}

fn stream_reset_stream(s: mut ref Stream, code: i64) -> Result[Vec[Frame], H2Err] {
    sm_process(mut s, IN_SEND_RST_STREAM)?;
    Ok(frames1(rst_frame(s.sid, code)))
}

fn stream_receive_window_update(s: mut ref Stream, increment: i64) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
    let mut events = sm_process(mut s, IN_RECV_WINDOW_UPDATE)?;
    let mut frames: Vec[Frame] = Vec.new();
    if events.len() > 0 {
        events[0].delta = increment;
        match guard_increment_window(s.out_win, increment) {
            Ok(n) => {
                s.out_win = n;
            }
            Err(_) => {
                let mut r = ev(EV_RESET, s.sid);
                r.code = 3;
                r.remote = false;
                events = evs1(r);
                frames = stream_reset_stream(mut s, 3)?;
            }
        }
    }
    Ok((frames, events))
}

fn stream_receive_alt_svc(s: mut ref Stream, f: ref Frame) -> Result[Vec[Ev], H2Err] {
    if f.origin.len() > 0 {
        return Ok(Vec.new());
    }
    let mut events = sm_process(mut s, IN_RECV_ALTERNATIVE_SERVICE)?;
    if events.len() > 0 {
        events[0].origin = if s.has_authority { s.authority.clone() } else { Vec.new() };
        events[0].field = f.field.clone();
    }
    Ok(events)
}

fn stream_stream_reset(s: mut ref Stream, f: ref Frame) -> Result[Vec[Ev], H2Err] {
    let mut events = sm_process(mut s, IN_RECV_RST_STREAM)?;
    if events.len() > 0 {
        events[0].code = f.error_code;
    }
    Ok(events)
}

fn stream_ack_data(s: mut ref Stream, size: i64) -> Vec[Frame] {
    let increment = s.in_win.process(size);
    if increment != 0 {
        return frames1(window_update_frame(s.sid, increment));
    }
    Vec.new()
}

fn stream_inbound_settings_change(s: mut ref Stream, delta: i64) -> Result[(), H2Err] {
    let new_max = s.in_win.max + delta;
    s.in_win.opened(delta)?;
    s.in_win.max = new_max;
    Ok(())
}
// ---------------------------------------------------------------- h2: the frame buffer

const PREAMBLE: Str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

// FrameBuffer: the server's preamble check, frame parsing, and the
// HEADERS / PUSH_PROMISE + CONTINUATION reassembly.
struct FBuf {
    data: Vec[u8],
    max: i64,
    pre: Vec[u8],
    hbuf: Vec[Frame],
}

fn new_fbuf(server: bool) -> FBuf {
    let pre = if server { bytes_of(PREAMBLE.to_string()) } else { Vec.new() };
    FBuf { data: Vec.new(), max: 0, pre: pre, hbuf: Vec.new() }
}

// What hyperframe raises from parse_body: InvalidPaddingError,
// InvalidDataError or InvalidFrameError, as FrameBuffer re-raises them.
fn body_err(msg: ref String) -> H2Err {
    if msg == "Padding is too long." {
        return err_of("InvalidPaddingError", msg, 1);
    }
    if msg.starts_with("SETTINGS ack frame must not") or msg.starts_with("Invalid PUSH_PROMISE promised")
        or msg.starts_with("WINDOW_UPDATE increment must") {
        return proto("Received frame with non-compliant data".to_string());
    }
    err_of("FrameDataMissingError", "Frame data missing or invalid".to_string(), 6)
}

impl FBuf {
    fn add_data(mut ref self, data: ref Vec[u8]) -> Result[(), H2Err] {
        let mut rest = data.clone();
        if self.pre.len() > 0 {
            let n = if self.pre.len() < data.len() { self.pre.len() } else { data.len() };
            if not same_bytes(sub(self.pre, 0, n), sub(data, 0, n)) {
                return Err(proto("Invalid HTTP/2 preamble.".to_string()));
            }
            rest = sub(data, n, data.len());
            self.pre = sub(self.pre, n, self.pre.len());
        }
        push_all(mut self.data, rest);
        Ok(())
    }

    fn update_header_buffer(mut ref self, f: own Frame) -> Result[Option[Frame], H2Err] {
        if self.hbuf.len() > 0 {
            let sid = self.hbuf[0].stream_id;
            if f.kind != k_continuation() or f.stream_id != sid {
                return Err(proto("Invalid frame during header block.".to_string()));
            }
            let end = has_flag(f, "END_HEADERS".to_string());
            self.hbuf.push(f);
            if self.hbuf.len() > 64 {
                return Err(proto("Too many continuation frames received.".to_string()));
            }
            if end {
                let mut first = self.hbuf[0].clone();
                add_flag(mut first, "END_HEADERS".to_string());
                let mut joined: Vec[u8] = Vec.new();
                for x in self.hbuf.iter() {
                    push_all(mut joined, x.data);
                }
                first.data = joined;
                self.hbuf.clear();
                return Ok(Some(first));
            }
            return Ok(None);
        }
        if (f.kind == k_headers() or f.kind == k_pushpromise()) and not has_flag(f, "END_HEADERS".to_string()) {
            self.hbuf.push(f);
            return Ok(None);
        }
        Ok(Some(f))
    }

    // __next__: the next complete frame, None when more bytes are needed.
    fn next_frame(mut ref self) -> Result[Option[Frame], H2Err] {
        loop {
            if self.data.len() < 9 {
                return Ok(None);
            }
            let (f0, length) = match parse_frame_header(sub(self.data, 0, 9), false) {
                Ok(p) => p,
                Err(m) => {
                    return Err(proto(f"Received frame with invalid header: {m}"));
                }
            };
            if self.data.len() < length + 9 {
                return Ok(None);
            }
            let mut f = f0;
            if length > self.max {
                return Err(err_of("FrameTooLargeError", f"Received overlong frame: length {length}, max {self.max}", 6));
            }
            if let Err(m) = parse_body(mut f, sub(self.data, 9, 9 + length)) {
                return Err(body_err(m));
            }
            self.data = sub(self.data, 9 + length, self.data.len());
            if let Some(g) = self.update_header_buffer(f)? {
                return Ok(Some(g));
            }
        }
    }
}

// ---------------------------------------------------------------- h2: the connection

const C_IDLE: i64 = 0;
const C_CLIENT_OPEN: i64 = 1;
const C_SERVER_OPEN: i64 = 2;
const C_CLOSED: i64 = 3;

const CI_SEND_HEADERS: i64 = 0;
const CI_SEND_PUSH_PROMISE: i64 = 1;
const CI_SEND_DATA: i64 = 2;
const CI_SEND_GOAWAY: i64 = 3;
const CI_SEND_WINDOW_UPDATE: i64 = 4;
const CI_SEND_PING: i64 = 5;
const CI_SEND_SETTINGS: i64 = 6;
const CI_SEND_RST_STREAM: i64 = 7;
const CI_SEND_PRIORITY: i64 = 8;
const CI_RECV_HEADERS: i64 = 9;
const CI_RECV_PUSH_PROMISE: i64 = 10;
const CI_RECV_DATA: i64 = 11;
const CI_RECV_GOAWAY: i64 = 12;
const CI_RECV_WINDOW_UPDATE: i64 = 13;
const CI_RECV_PING: i64 = 14;
const CI_RECV_SETTINGS: i64 = 15;
const CI_RECV_RST_STREAM: i64 = 16;
const CI_RECV_PRIORITY: i64 = 17;
const CI_SEND_ALTERNATIVE_SERVICE: i64 = 18;
const CI_RECV_ALTERNATIVE_SERVICE: i64 = 19;

const HIGHEST_STREAM_ID: i64 = 2147483647;

fn conn_state_name(s: i64) -> String {
    let names = vec!["IDLE", "CLIENT_OPEN", "SERVER_OPEN", "CLOSED"];
    f"ConnectionState.{names[s]}"
}

fn conn_input_name(i: i64) -> String {
    let names = vec![
        "SEND_HEADERS", "SEND_PUSH_PROMISE", "SEND_DATA", "SEND_GOAWAY", "SEND_WINDOW_UPDATE",
        "SEND_PING", "SEND_SETTINGS", "SEND_RST_STREAM", "SEND_PRIORITY", "RECV_HEADERS",
        "RECV_PUSH_PROMISE", "RECV_DATA", "RECV_GOAWAY", "RECV_WINDOW_UPDATE", "RECV_PING",
        "RECV_SETTINGS", "RECV_RST_STREAM", "RECV_PRIORITY", "SEND_ALTERNATIVE_SERVICE",
        "RECV_ALTERNATIVE_SERVICE",
    ];
    f"ConnectionInputs.{names[i]}"
}

// The arguments of a send_headers or prioritize call that may be None.
struct Prio {
    weight: Option[i64],
    depends: Option[i64],
    exclusive: Option[bool],
}

fn add_frame_priority(f: mut ref Frame, p: ref Prio) -> Result[(), H2Err] {
    if let Some(d) = p.depends {
        if d == f.stream_id {
            return Err(proto(f"Stream {f.stream_id} may not depend on itself"));
        }
    }
    let mut weight = 15;
    if let Some(w) = p.weight {
        if w > 256 or w < 1 {
            return Err(proto(f"Weight must be between 1 and 256, not {w}"));
        }
        weight = w - 1;
    }
    f.stream_weight = weight;
    f.depends_on = match p.depends { Some(d) => d, None => 0 };
    f.exclusive = match p.exclusive { Some(x) => x, None => false };
    Ok(())
}

struct Conn {
    state: i64,
    streams: Vec[Stream],
    closed: Vec[(i64, i64)],
    hi_in: i64,
    hi_out: i64,
    enc: Encoder,
    dec: Decoder,
    cfg: Config,
    local: Settings,
    remote: Settings,
    out_win: i64,
    max_out_frame: i64,
    max_in_frame: i64,
    buf: FBuf,
    sendbuf: Vec[u8],
    in_win: Win,
}

fn new_conn(cfg: ref Config) -> Conn {
    let mut initial: Vec[(i64, i64)] = Vec.new();
    initial.push((3, 100));
    initial.push((6, 65536));
    let local = new_settings(cfg.client, initial);
    let remote = new_settings(not cfg.client, Vec.new());
    let out_win = remote.get(4);
    let max_out = remote.get(5);
    let max_in = local.get(5);
    let in_size = local.get(4);
    let mut dec = new_decoder();
    dec.max_list = 65536;
    Conn {
        state: C_IDLE,
        streams: Vec.new(),
        closed: Vec.new(),
        hi_in: 0,
        hi_out: 0,
        enc: new_encoder(),
        dec: dec,
        cfg: cfg.clone(),
        local: local,
        remote: remote,
        out_win: out_win,
        max_out_frame: max_out,
        max_in_frame: max_in,
        buf: new_fbuf(not cfg.client),
        sendbuf: Vec.new(),
        in_win: new_win(in_size),
    }
}

fn settings_frame(pairs: ref Vec[(i64, i64)]) -> Frame {
    let mut f = blank_frame(k_settings(), 0);
    for (k, v) in pairs.iter() {
        set_setting(mut f, k, v);
    }
    f
}

fn serialized(f: ref Frame) -> Vec[u8] {
    match serialize(f) {
        Ok(b) => b,
        Err(_) => Vec.new(),
    }
}

impl Conn {
    fn process(mut ref self, input: i64) -> Result[(), H2Err] {
        let target = conn_transition(self.state, input);
        if target < 0 {
            let old = self.state;
            self.state = C_CLOSED;
            return Err(proto(f"Invalid input {conn_input_name(input)} in state {conn_state_name(old)}"));
        }
        self.state = target;
        Ok(())
    }

    fn find(ref self, sid: i64) -> i64 {
        let mut i = 0;
        while i < self.streams.len() {
            if self.streams[i].sid == sid {
                return i;
            }
            i += 1;
        }
        -1
    }

    fn prepare(mut ref self, frames: ref Vec[Frame]) -> Result[(), H2Err] {
        if frames.len() == 0 {
            return Ok(());
        }
        let mut too_big = false;
        for f in frames.iter() {
            let body = serialize_body(f);
            if body.len() > self.max_out_frame {
                too_big = true;
            }
            push_all(mut self.sendbuf, serialized(f));
        }
        if too_big {
            return Err(assertion_err());
        }
        Ok(())
    }

    // _open_streams: counts the open streams of one parity and forgets
    // every closed stream, remembering how it closed.
    fn open_streams(mut ref self, remainder: i64) -> i64 {
        let mut count = 0;
        let mut i = 0;
        while i < self.streams.len() {
            let s = ref self.streams[i];
            if stream_is_open(s) and s.sid % 2 == remainder {
                count += 1;
                i += 1;
            } else if s.state == S_CLOSED {
                let gone = self.streams.remove(i);
                self.closed.push((gone.sid, gone.closed_by));
            } else {
                i += 1;
            }
        }
        count
    }

    fn open_outbound(mut ref self) -> i64 {
        self.open_streams(if self.cfg.client { 1 } else { 0 })
    }

    fn open_inbound(mut ref self) -> i64 {
        self.open_streams(if self.cfg.client { 0 } else { 1 })
    }

    fn is_outbound(ref self, sid: i64) -> bool {
        sid % 2 == (if self.cfg.client { 1 } else { 0 })
    }

    fn begin_new_stream(mut ref self, sid: i64, allowed: i64) -> Result[i64, H2Err] {
        let outbound = self.is_outbound(sid);
        let highest = if outbound { self.hi_out } else { self.hi_in };
        if sid <= highest {
            return Err(too_low(sid, highest));
        }
        if sid % 2 != allowed {
            return Err(proto("Invalid stream ID for peer.".to_string()));
        }
        let mut s = new_stream(sid, self.cfg, self.local.get(4), self.remote.get(4));
        s.max_out_frame = self.max_out_frame;
        self.streams.push(s);
        if outbound {
            self.hi_out = sid;
        } else {
            self.hi_in = sid;
        }
        Ok(self.streams.len() - 1)
    }

    fn get_or_create(mut ref self, sid: i64, allowed: i64) -> Result[i64, H2Err] {
        let i = self.find(sid);
        if i >= 0 {
            return Ok(i);
        }
        self.begin_new_stream(sid, allowed)
    }

    // _get_stream_by_id; sid 0 stands for both 0 and None.
    fn get_stream(ref self, sid: i64) -> Result[i64, H2Err] {
        if sid == 0 {
            return Err(no_such(-1));
        }
        let i = self.find(sid);
        if i >= 0 {
            return Ok(i);
        }
        let highest = if self.is_outbound(sid) { self.hi_out } else { self.hi_in };
        if sid > highest {
            return Err(no_such(sid));
        }
        Err(closed_err(sid))
    }

    fn initiate_connection(mut ref self) -> Result[(), H2Err] {
        self.process(CI_SEND_SETTINGS)?;
        if self.cfg.client {
            push_all(mut self.sendbuf, bytes_of(PREAMBLE.to_string()));
        }
        let f = settings_frame(self.local.items()?);
        push_all(mut self.sendbuf, serialized(f));
        Ok(())
    }

    fn initiate_upgrade(mut ref self, hc: ref Ctx, header: ref Vec[u8]) -> Result[Option[Vec[u8]], H2Err] {
        let mut frame_data: Option[Vec[u8]] = None;
        self.initiate_connection()?;
        if self.cfg.client {
            let f = settings_frame(self.local.items()?);
            frame_data = Some(b64_encode(serialize_body(f)));
        } else if header.len() > 0 {
            let raw = b64_decode(header);
            let mut f = blank_frame(k_settings(), 0);
            if let Err(m) = parse_body(mut f, raw) {
                return Err(err_of("InvalidFrameError", m, 0));
            }
            // The SETTINGS ACK this builds is dropped, as h2 drops it.
            self.receive_settings_frame(f)?;
        }
        self.process(if self.cfg.client { CI_SEND_HEADERS } else { CI_RECV_HEADERS })?;
        self.begin_new_stream(1, 1)?;
        let i = self.find(1);
        if i < 0 {
            return Err(key_err(1));
        }
        let input = if self.cfg.client { IN_UPGRADE_CLIENT } else { IN_UPGRADE_SERVER };
        sm_process(mut self.streams[i], input)?;
        Ok(frame_data)
    }

    fn next_stream_id(ref self) -> Result[i64, H2Err] {
        let next = if self.hi_out == 0 { if self.cfg.client { 1 } else { 2 } } else { self.hi_out + 2 };
        if next > HIGHEST_STREAM_ID {
            return Err(err_of("NoAvailableStreamIDError", "Exhausted allowed stream IDs".to_string(), 1));
        }
        Ok(next)
    }

    fn send_headers(mut ref self, hc: ref Ctx, sid: i64, headers: ref Vec[Header], end: bool, p: ref Prio) -> Result[(), H2Err] {
        if self.find(sid) < 0 {
            let max_open = self.remote.max_concurrent_streams();
            if self.open_outbound() + 1 > max_open {
                let n = self.open_outbound();
                return Err(err_of("TooManyStreamsError", f"Max outbound streams is {max_open}, {n} open", 1));
            }
        }
        self.process(CI_SEND_HEADERS)?;
        let i = self.get_or_create(sid, if self.cfg.client { 1 } else { 0 })?;
        let mut frames = stream_send_headers(mut self.streams[i], hc, mut self.enc, headers, end)?;
        let present = p.weight.is_some() or p.depends.is_some() or p.exclusive.is_some();
        if present {
            if not self.cfg.client {
                return Err(err_of("RFC1122Error", "Servers SHOULD NOT prioritize streams.".to_string(), 0));
            }
            add_flag(mut frames[0], "PRIORITY".to_string());
            add_frame_priority(mut frames[0], p)?;
        }
        self.prepare(frames)
    }

    fn local_window(ref self, sid: i64) -> Result[i64, H2Err] {
        let i = self.get_stream(sid)?;
        let w = self.streams[i].out_win;
        Ok(if self.out_win < w { self.out_win } else { w })
    }

    fn remote_window(ref self, sid: i64) -> Result[i64, H2Err] {
        let i = self.get_stream(sid)?;
        let w = self.streams[i].in_win.cur;
        Ok(if self.in_win.cur < w { self.in_win.cur } else { w })
    }

    fn send_data(mut ref self, sid: i64, data: ref Vec[u8], end: bool, pad: Option[i64]) -> Result[(), H2Err] {
        let mut frame_size = data.len();
        let mut pad_length = -1;
        if let Some(n) = pad {
            if n < 0 or n > 255 {
                return Err(value_err("pad_length must be within range: [0, 255]".to_string()));
            }
            frame_size += n + 1;
            pad_length = n;
        }
        if frame_size > self.local_window(sid)? {
            let w = self.local_window(sid)?;
            return Err(flow_err(f"Cannot send {frame_size} bytes, flow control window is {w}"));
        }
        if frame_size > self.max_out_frame {
            return Err(err_of("FrameTooLargeError", f"Cannot send frame size {frame_size}, max frame size is {self.max_out_frame}", 6));
        }
        self.process(CI_SEND_DATA)?;
        let i = self.find(sid);
        if i < 0 {
            return Err(key_err(sid));
        }
        let frames = stream_send_data(mut self.streams[i], data, end, pad_length)?;
        self.prepare(frames)?;
        self.out_win -= frame_size;
        if self.out_win < 0 {
            return Err(assertion_err());
        }
        Ok(())
    }

    fn end_stream(mut ref self, sid: i64) -> Result[(), H2Err] {
        self.process(CI_SEND_DATA)?;
        let i = self.find(sid);
        if i < 0 {
            return Err(key_err(sid));
        }
        let frames = stream_end_stream(mut self.streams[i])?;
        self.prepare(frames)
    }

    fn increment_window(mut ref self, increment: i64, sid: Option[i64]) -> Result[(), H2Err] {
        if increment < 1 or increment > 2147483647 {
            return Err(value_err("Flow control increment must be between 1 and 2147483647".to_string()));
        }
        self.process(CI_SEND_WINDOW_UPDATE)?;
        let mut frames: Vec[Frame] = Vec.new();
        match sid {
            Some(n) => {
                let i = self.find(n);
                if i < 0 {
                    return Err(key_err(n));
                }
                frames = stream_increase_window(mut self.streams[i], increment)?;
            }
            None => {
                self.in_win.opened(increment)?;
                frames.push(window_update_frame(0, increment));
            }
        }
        self.prepare(frames)
    }

    fn push_stream(mut ref self, hc: ref Ctx, sid: i64, promised: i64, headers: ref Vec[Header]) -> Result[(), H2Err] {
        if self.remote.get(2) == 0 {
            return Err(proto("Remote peer has disabled stream push".to_string()));
        }
        self.process(CI_SEND_PUSH_PROMISE)?;
        self.get_stream(sid)?;
        if sid % 2 == 0 {
            return Err(proto("Cannot recursively push streams.".to_string()));
        }
        self.begin_new_stream(promised, 0)?;
        let i = self.find(sid);
        let mut frames = stream_push_in_band(mut self.streams[i], hc, mut self.enc, promised, headers)?;
        let j = self.find(promised);
        stream_locally_pushed(mut self.streams[j])?;
        self.prepare(frames)
    }

    fn ping(mut ref self, data: ref Vec[u8]) -> Result[(), H2Err] {
        if data.len() != 8 {
            return Err(value_err(f"Invalid value for ping data: {bytes_repr(data)}"));
        }
        self.process(CI_SEND_PING)?;
        let mut f = blank_frame(k_ping(), 0);
        f.opaque_data = data.clone();
        self.prepare(frames1(f))
    }

    fn reset_stream(mut ref self, sid: i64, code: i64) -> Result[(), H2Err] {
        self.process(CI_SEND_RST_STREAM)?;
        let i = self.get_stream(sid)?;
        let frames = stream_reset_stream(mut self.streams[i], code)?;
        self.prepare(frames)
    }

    fn close_connection(mut ref self, code: i64, data: ref Vec[u8], last: Option[i64]) -> Result[(), H2Err] {
        self.process(CI_SEND_GOAWAY)?;
        let mut f = blank_frame(k_goaway(), 0);
        f.last_stream_id = match last { Some(n) => n, None => self.hi_in };
        f.error_code = code;
        f.additional_data = data.clone();
        self.prepare(frames1(f))
    }

    fn update_settings(mut ref self, pairs: ref Vec[(i64, i64)]) -> Result[(), H2Err] {
        self.process(CI_SEND_SETTINGS)?;
        self.local.update(pairs)?;
        self.prepare(frames1(settings_frame(pairs)))
    }

    fn advertise_alt(mut ref self, field: ref Vec[u8], origin: own Option[Vec[u8]], sid: Option[i64]) -> Result[(), H2Err] {
        if origin.is_some() and sid.is_some() {
            return Err(value_err("Must not provide both origin and stream_id".to_string()));
        }
        self.process(CI_SEND_ALTERNATIVE_SERVICE)?;
        let mut frames: Vec[Frame] = Vec.new();
        match origin {
            Some(o) => {
                let mut f = blank_frame(k_altsvc(), 0);
                f.origin = o;
                f.field = field.clone();
                frames.push(f);
            }
            None => {
                let n = match sid { Some(x) => x, None => 0 };
                let i = self.get_stream(n)?;
                frames = stream_advertise_alt(mut self.streams[i], field)?;
            }
        }
        self.prepare(frames)
    }

    fn prioritize(mut ref self, sid: i64, p: ref Prio) -> Result[(), H2Err] {
        if not self.cfg.client {
            return Err(err_of("RFC1122Error", "Servers SHOULD NOT prioritize streams.".to_string(), 0));
        }
        self.process(CI_SEND_PRIORITY)?;
        if sid == 0 {
            return Err(err_of("InvalidDataError", "Stream ID must be non-zero for PriorityFrame".to_string(), 0));
        }
        let mut f = blank_frame(k_priority(), sid);
        add_frame_priority(mut f, p)?;
        self.prepare(frames1(f))
    }

    fn acknowledge(mut ref self, size: i64, sid: i64) -> Result[(), H2Err] {
        if sid <= 0 {
            return Err(value_err(f"Stream ID {sid} is not valid for acknowledge_received_data"));
        }
        if size < 0 {
            return Err(value_err("Cannot acknowledge negative data".to_string()));
        }
        let mut frames: Vec[Frame] = Vec.new();
        let increment = self.in_win.process(size);
        if increment != 0 {
            frames.push(window_update_frame(0, increment));
        }
        match self.get_stream(sid) {
            Ok(i) => {
                if stream_is_open(self.streams[i]) {
                    for f in stream_ack_data(mut self.streams[i], size).iter() {
                        frames.push(f.clone());
                    }
                }
            }
            Err(e) => {
                if e.kind != "StreamClosedError" {
                    return Err(e);
                }
            }
        }
        self.prepare(frames)
    }

    fn data_to_send(mut ref self, amount: Option[i64]) -> Vec[u8] {
        match amount {
            None => {
                let d = self.sendbuf.clone();
                self.sendbuf.clear();
                d
            }
            Some(n) => {
                let d = sub(self.sendbuf, 0, n);
                self.sendbuf = sub(self.sendbuf, n, self.sendbuf.len());
                d
            }
        }
    }

    fn acknowledge_settings(mut ref self) -> Result[Vec[Frame], H2Err] {
        self.process(CI_SEND_SETTINGS)?;
        let changes = self.remote.acknowledge();
        let w = find_change(changes, 4);
        if w >= 0 {
            let old = if changes[w].original == NONE { 0 } else { changes[w].original };
            let delta = changes[w].new - old;
            let mut i = 0;
            while i < self.streams.len() {
                self.streams[i].out_win = guard_increment_window(self.streams[i].out_win, delta)?;
                i += 1;
            }
        }
        let t = find_change(changes, 1);
        if t >= 0 {
            self.enc.set_table_size(changes[t].new);
        }
        let m = find_change(changes, 5);
        if m >= 0 {
            self.max_out_frame = changes[m].new;
            let mut i = 0;
            while i < self.streams.len() {
                self.streams[i].max_out_frame = changes[m].new;
                i += 1;
            }
        }
        let mut f = blank_frame(k_settings(), 0);
        add_flag(mut f, "ACK".to_string());
        Ok(frames1(f))
    }

    fn local_settings_acked(mut ref self) -> Result[Vec[Changed], H2Err] {
        let changes = self.local.acknowledge();
        let w = find_change(changes, 4);
        if w >= 0 {
            let old = if changes[w].original == NONE { 0 } else { changes[w].original };
            let delta = changes[w].new - old;
            let mut i = 0;
            while i < self.streams.len() {
                stream_inbound_settings_change(mut self.streams[i], delta)?;
                i += 1;
            }
        }
        let l = find_change(changes, 6);
        if l >= 0 {
            self.dec.max_list = changes[l].new;
        }
        let m = find_change(changes, 5);
        if m >= 0 {
            self.max_in_frame = changes[m].new;
        }
        let t = find_change(changes, 1);
        if t >= 0 {
            self.dec.max_allowed = changes[t].new;
        }
        Ok(changes)
    }

    fn closed_by(ref self, sid: i64) -> i64 {
        let i = self.find(sid);
        if i >= 0 {
            return self.streams[i].closed_by;
        }
        for (k, by) in self.closed.iter() {
            if k == sid {
                return by;
            }
        }
        -1
    }

    fn closed_by_reset(ref self, sid: i64) -> bool {
        let by = self.closed_by(sid);
        by == BY_RECV_RST or by == BY_SEND_RST
    }

    fn closed_by_end(ref self, sid: i64) -> bool {
        let by = self.closed_by(sid);
        by == BY_RECV_END or by == BY_SEND_END
    }

    // ------------------------------------------------ receiving

    fn decode_block(mut ref self, hc: ref Ctx, block: ref Vec[u8]) -> Result[Vec[Header], H2Err] {
        match self.dec.decode(hc, block) {
            Ok(hs) => Ok(hs),
            Err(e) => {
                if e.kind == "OversizedHeaderListError" {
                    return Err(err_of("DenialOfServiceError", f"Oversized header block: {e.msg}", 11));
                }
                Err(proto(f"Error decoding header block: {e.msg}"))
            }
        }
    }

    fn receive_data(mut ref self, hc: ref Ctx, data: ref Vec[u8]) -> Result[Vec[Ev], H2Err] {
        self.buf.add_data(data)?;
        self.buf.max = self.max_in_frame;
        let mut events: Vec[Ev] = Vec.new();
        loop {
            let got = match self.buf.next_frame() {
                Ok(g) => g,
                Err(e) => {
                    return self.fail(e);
                }
            };
            match got {
                None => {
                    break;
                }
                Some(f) => match self.receive_frame(hc, f) {
                    Ok(evs) => {
                        for e in evs.iter() {
                            events.push(e.clone());
                        }
                    }
                    Err(e) => {
                        return self.fail(e);
                    }
                },
            }
        }
        Ok(events)
    }

    fn fail(mut ref self, e: own H2Err) -> Result[Vec[Ev], H2Err] {
        if e.kind == "InvalidPaddingError" {
            self.terminate(1)?;
            return Err(proto("Received frame with invalid padding.".to_string()));
        }
        if is_protocol(e) {
            self.terminate(e.code)?;
        }
        Err(e)
    }

    fn terminate(mut ref self, code: i64) -> Result[(), H2Err] {
        let mut f = blank_frame(k_goaway(), 0);
        f.last_stream_id = self.hi_in;
        f.error_code = code;
        self.process(CI_SEND_GOAWAY)?;
        self.prepare(frames1(f))
    }

    fn receive_frame(mut ref self, hc: ref Ctx, f: own Frame) -> Result[Vec[Ev], H2Err] {
        let k = f.kind;
        let r = if k == k_data() {
            self.receive_data_frame(f)
        } else if k == k_headers() {
            self.receive_headers_frame(hc, f)
        } else if k == k_priority() {
            self.receive_priority_frame(f)
        } else if k == k_rststream() {
            self.receive_rst_frame(f)
        } else if k == k_settings() {
            self.receive_settings_frame(f)
        } else if k == k_pushpromise() {
            self.receive_push_promise_frame(hc, f)
        } else if k == k_ping() {
            self.receive_ping_frame(f)
        } else if k == k_goaway() {
            self.receive_goaway_frame(f)
        } else if k == k_windowupdate() {
            self.receive_window_update_frame(f)
        } else if k == k_continuation() {
            self.receive_naked_continuation(f)
        } else if k == k_altsvc() {
            self.receive_alt_svc_frame(f)
        } else {
            Ok((Vec.new(), evs1(ev(EV_UNKNOWN, 0))))
        };
        match r {
            Ok((frames, evs)) => {
                self.prepare(frames)?;
                Ok(evs)
            }
            Err(e) => {
                if e.kind == "StreamClosedError" {
                    if self.closed_by_reset(e.sid) {
                        self.prepare(frames1(rst_frame(e.sid, e.code)))?;
                        return Ok(e.events);
                    }
                    return Err(e);
                }
                if e.kind == "StreamIDTooLowError" {
                    if self.closed_by_reset(e.sid) {
                        self.prepare(frames1(rst_frame(e.sid, 5)))?;
                        return Ok(Vec.new());
                    }
                    if self.closed_by_end(e.sid) {
                        return Err(closed_err(e.sid));
                    }
                }
                Err(e)
            }
        }
    }

    fn receive_headers_frame(mut ref self, hc: ref Ctx, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        if self.find(f.stream_id) < 0 {
            let max_open = self.local.max_concurrent_streams();
            if self.open_inbound() + 1 > max_open {
                let n = self.open_outbound();
                return Err(err_of("TooManyStreamsError", f"Max outbound streams is {max_open}, {n} open", 1));
            }
        }
        let headers = self.decode_block(hc, f.data)?;
        self.process(CI_RECV_HEADERS)?;
        let i = self.get_or_create(f.stream_id, if self.cfg.client { 0 } else { 1 })?;
        let end = has_flag(f, "END_STREAM".to_string());
        let mut evs = stream_receive_headers(mut self.streams[i], headers, end)?;
        if has_flag(f, "PRIORITY".to_string()) {
            let (_, p_events) = self.receive_priority_frame(f)?;
            for e in p_events.iter() {
                evs.push(e.clone());
            }
        }
        Ok((Vec.new(), evs))
    }

    fn receive_push_promise_frame(mut ref self, hc: ref Ctx, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        if self.local.get(2) == 0 {
            return Err(proto("Received pushed stream".to_string()));
        }
        let pushed = self.decode_block(hc, f.data)?;
        self.process(CI_RECV_PUSH_PROMISE)?;
        let i = match self.get_stream(f.stream_id) {
            Ok(i) => i,
            Err(e) => {
                if not is_no_such(e) {
                    return Err(e);
                }
                if self.closed_by(f.stream_id) == BY_SEND_RST {
                    return Ok((frames1(rst_frame(f.promised_stream_id, 7)), Vec.new()));
                }
                return Err(proto("Attempted to push on closed stream.".to_string()));
            }
        };
        if f.stream_id % 2 == 0 {
            return Err(proto("Cannot recursively push streams.".to_string()));
        }
        let evs = match stream_recv_push_in_band(mut self.streams[i], f.promised_stream_id, pushed) {
            Ok(v) => v,
            Err(e) => {
                if e.kind == "StreamClosedError" {
                    return Ok((frames1(rst_frame(f.promised_stream_id, 7)), Vec.new()));
                }
                return Err(e);
            }
        };
        self.begin_new_stream(f.promised_stream_id, 0)?;
        let j = self.find(f.promised_stream_id);
        stream_remotely_pushed(mut self.streams[j], pushed)?;
        Ok((Vec.new(), evs))
    }

    fn receive_data_frame(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        let flow = data_flow_len(f);
        self.process(CI_RECV_DATA)?;
        self.in_win.consumed(flow)?;
        let attempt = match self.get_stream(f.stream_id) {
            Ok(i) => stream_receive_data(mut self.streams[i], f.data, has_flag(f, "END_STREAM".to_string()), flow),
            Err(e) => Err(e),
        };
        match attempt {
            Ok(evs) => Ok((Vec.new(), evs)),
            Err(e) => {
                if e.kind != "StreamClosedError" {
                    return Err(e);
                }
                // _handle_data_on_closed_stream
                let mut frames: Vec[Frame] = Vec.new();
                let increment = self.in_win.process(flow);
                if increment != 0 {
                    frames.push(window_update_frame(0, increment));
                }
                frames.push(rst_frame(e.sid, e.code));
                Ok((frames, e.events))
            }
        }
    }

    fn receive_settings_frame(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        self.process(CI_RECV_SETTINGS)?;
        if has_flag(f, "ACK".to_string()) {
            let mut e = ev(EV_SETTINGS_ACK, 0);
            e.changed = self.local_settings_acked()?;
            return Ok((Vec.new(), evs1(e)));
        }
        self.remote.update(f.settings)?;
        // RemoteSettingsChanged.from_settings reads the updated object,
        // whose acknowledged values have not moved yet.
        let mut e = ev(EV_REMOTE_SETTINGS, 0);
        for (k, v) in f.settings.iter() {
            e.changed.push(Changed { setting: k, original: self.remote.get(k), new: v });
        }
        let frames = self.acknowledge_settings()?;
        Ok((frames, evs1(e)))
    }

    fn receive_window_update_frame(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        self.process(CI_RECV_WINDOW_UPDATE)?;
        if f.stream_id != 0 {
            let r = match self.get_stream(f.stream_id) {
                Ok(i) => stream_receive_window_update(mut self.streams[i], f.window_increment),
                Err(e) => Err(e),
            };
            return match r {
                Ok(p) => Ok(p),
                Err(e) => {
                    if e.kind == "StreamClosedError" {
                        Ok((Vec.new(), Vec.new()))
                    } else {
                        Err(e)
                    }
                }
            };
        }
        self.out_win = guard_increment_window(self.out_win, f.window_increment)?;
        let mut e = ev(EV_WINDOW, 0);
        e.delta = f.window_increment;
        Ok((Vec.new(), evs1(e)))
    }

    fn receive_ping_frame(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        self.process(CI_RECV_PING)?;
        let mut frames: Vec[Frame] = Vec.new();
        let mut e = ev(EV_PING, 0);
        if has_flag(f, "ACK".to_string()) {
            e.kind = EV_PING_ACK;
        } else {
            let mut p = blank_frame(k_ping(), 0);
            add_flag(mut p, "ACK".to_string());
            p.opaque_data = f.opaque_data.clone();
            frames.push(p);
        }
        e.data = f.opaque_data.clone();
        Ok((frames, evs1(e)))
    }

    fn receive_rst_frame(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        self.process(CI_RECV_RST_STREAM)?;
        match self.get_stream(f.stream_id) {
            Ok(i) => {
                let evs = stream_stream_reset(mut self.streams[i], f)?;
                Ok((Vec.new(), evs))
            }
            Err(e) => {
                if is_no_such(e) {
                    Ok((Vec.new(), Vec.new()))
                } else {
                    Err(e)
                }
            }
        }
    }

    fn receive_priority_frame(mut ref self, f: ref Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        self.process(CI_RECV_PRIORITY)?;
        let mut e = ev(EV_PRIORITY, f.stream_id);
        e.depends = f.depends_on;
        e.exclusive = f.exclusive;
        e.weight = f.stream_weight + 1;
        if e.depends == f.stream_id {
            return Err(proto(f"Stream {f.stream_id} may not depend on itself"));
        }
        Ok((Vec.new(), evs1(e)))
    }

    fn receive_goaway_frame(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        self.process(CI_RECV_GOAWAY)?;
        self.sendbuf.clear();
        let mut e = ev(EV_TERMINATED, 0);
        e.code = f.error_code;
        e.last = f.last_stream_id;
        e.extra = f.additional_data.clone();
        Ok((Vec.new(), evs1(e)))
    }

    fn receive_naked_continuation(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        let i = self.get_stream(f.stream_id)?;
        sm_process(mut self.streams[i], IN_RECV_CONTINUATION)?;
        Err(err_of("AssertionError", "Should not be reachable".to_string(), 0))
    }

    fn receive_alt_svc_frame(mut ref self, f: own Frame) -> Result[(Vec[Frame], Vec[Ev]), H2Err] {
        self.process(CI_RECV_ALTERNATIVE_SERVICE)?;
        let mut evs: Vec[Ev] = Vec.new();
        if f.stream_id != 0 {
            match self.get_stream(f.stream_id) {
                Ok(i) => {
                    evs = stream_receive_alt_svc(mut self.streams[i], f)?;
                }
                Err(e) => {
                    if not is_no_such(e) {
                        return Err(e);
                    }
                }
            }
            return Ok((Vec.new(), evs));
        }
        if f.origin.len() == 0 or not self.cfg.client {
            return Ok((Vec.new(), evs));
        }
        let mut e = ev(EV_ALTSVC, 0);
        e.origin = f.origin.clone();
        e.field = f.field.clone();
        Ok((Vec.new(), evs1(e)))
    }
}
// ---------------------------------------------------------------- the driver (oracle.py's run_job)

fn unesc(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if c == '~' and i + 1 < cs.len() {
            let d = cs[i + 1];
            if d == 's' {
                out.push(' ');
            } else if d == 't' {
                out.push('\t');
            } else if d == 'n' {
                out.push('\n');
            } else if d == 'e' {
                out.push('=');
            } else if d == '~' {
                out.push('~');
            } else if d == 'c' {
                out.push(',');
            } else if d != 'z' {
                out.push(d);
            }
            i += 2;
            continue;
        }
        out.push(c);
        i += 1;
    }
    out
}

fn chars_str(cs: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut i = lo;
    while i < hi {
        s.push(cs[i]);
        i += 1;
    }
    s
}

// `name=value`, `!` for a never-indexed header, `%` for one given as
// bytes (which h2 treats like the text form).
fn parse_header(tok: ref String) -> Header {
    let all: Vec[char] = tok.chars().collect();
    let never = all.len() > 0 and all[0] == '!';
    let raw = all.len() > 0 and all[0] == '%';
    let start = if never or raw { 1 } else { 0 };
    let cs: Vec[char] = sub_chars(all, start);
    let mut eq = 1;
    while eq < cs.len() and cs[eq] != '=' {
        eq += 1;
    }
    let name = unesc(chars_str(cs, 0, eq));
    let value = unesc(chars_str(cs, eq + 1, cs.len()));
    Header { name: bytes_of(name), value: bytes_of(value), never: never }
}

fn sub_chars(cs: ref Vec[char], lo: i64) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    let mut i = lo;
    while i < cs.len() {
        out.push(cs[i]);
        i += 1;
    }
    out
}

fn payload(tok: ref String) -> Vec[u8] {
    if tok.starts_with("len=") {
        let n = int_of(tok[4..].to_string());
        let mut out: Vec[u8] = Vec.new();
        let mut i = 0;
        while i < n {
            out.push(((i * 7 + 3) % 251) as u8);
            i += 1;
        }
        return out;
    }
    if tok.starts_with("hex=") {
        return unhex(tok[4..].to_string());
    }
    bytes_of(unesc(tok))
}

fn int_of(s: ref String) -> i64 {
    match i64.parse(s) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

// opts_of: `k=v` words into ordered pairs, a later key replacing an
// earlier one's value in place, as a dict does.
fn opts_of(words: ref Vec[String], from: i64) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    let mut i = from;
    while i < words.len() {
        let w = ref words[i];
        let (k, v) = match w.find("=") {
            Some(at) => (w[..at].to_string(), w[at + 1..].to_string()),
            None => (w.clone(), String.new()),
        };
        let mut found = false;
        let mut j = 0;
        while j < out.len() {
            if out[j].0 == k {
                out[j] = (k.clone(), v.clone());
                found = true;
            }
            j += 1;
        }
        if not found {
            out.push((k, v));
        }
        i += 1;
    }
    out
}

fn opt_get(opts: ref Vec[(String, String)], key: Str) -> Option[String] {
    for (k, v) in opts.iter() {
        if k == key {
            return Some(v.clone());
        }
    }
    None
}

fn show_frames(data: ref Vec[u8]) {
    let pre = bytes_of(PREAMBLE.to_string());
    let mut rest = data.clone();
    if rest.len() >= pre.len() and same_bytes(sub(rest, 0, pre.len()), pre) {
        println("    > preamble");
        rest = sub(rest, pre.len(), rest.len());
    }
    while rest.len() >= 9 {
        let (f0, length) = match parse_frame_header(sub(rest, 0, 9), false) {
            Ok(p) => p,
            Err(m) => {
                println(f"    > unparsable header: {m}");
                return;
            }
        };
        if rest.len() < 9 + length {
            break;
        }
        let mut f = f0;
        if let Err(m) = parse_body(mut f, sub(rest, 9, 9 + length)) {
            println(f"    > unparsable body: {m}");
            return;
        }
        println(f"    > {frame_repr(f)}");
        rest = sub(rest, 9 + length, rest.len());
    }
    if rest.len() > 0 {
        println(f"    > {rest.len()} trailing bytes");
    }
}

fn show_error(e: ref H2Err) {
    println(f"    error {e.kind}: {e.msg}");
}

fn make_conn(side: ref String, opts: ref Vec[(String, String)]) -> Conn {
    let mut cfg = Config {
        client: side == "client",
        encoding: false,
        validate_out: true,
        normalize_out: true,
        split_cookies: false,
        validate_in: true,
        normalize_in: true,
    };
    for (k, v) in opts.iter() {
        let on = v == "1";
        if k == "encoding" {
            cfg.encoding = true;
        } else if k == "validate_outbound_headers" {
            cfg.validate_out = on;
        } else if k == "normalize_outbound_headers" {
            cfg.normalize_out = on;
        } else if k == "split_outbound_cookies" {
            cfg.split_cookies = on;
        } else if k == "validate_inbound_headers" {
            cfg.validate_in = on;
        } else if k == "normalize_inbound_headers" {
            cfg.normalize_in = on;
        }
    }
    new_conn(cfg)
}

fn state_line(name: ref String, c: mut ref Conn) {
    let out_n = c.open_outbound();
    let in_n = c.open_inbound();
    let next = match c.next_stream_id() {
        Ok(n) => f"{n}",
        Err(e) => f"error {e.kind}",
    };
    println(f"    {name}: {conn_state_name(c.state)}, open out {out_n} in {in_n}, window out {c.out_win} in {c.in_win.cur}, next {next}");
    let mut ids: Vec[i64] = Vec.new();
    for s in c.streams.iter() {
        ids.push(s.sid);
    }
    ids.sort();
    for sid in ids.iter() {
        let s = ref c.streams[c.find(*sid)];
        println(f"      {stream_repr(s)} out {s.out_win} in {s.in_win.cur} frame {s.max_out_frame}");
    }
}

fn deliver(hc: ref Ctx, dst: mut ref Conn, data: ref Vec[u8]) {
    match dst.receive_data(hc, data) {
        Ok(evs) => {
            for e in evs.iter() {
                println(f"    {ev_repr(e)}");
            }
        }
        Err(e) => show_error(e),
    }
}

fn prio_of(words: ref Vec[String], from: i64) -> Prio {
    let opts = opts_of(words, from);
    Prio {
        weight: match opt_get(opts, "w") { Some(v) => Some(int_of(v)), None => None },
        depends: match opt_get(opts, "d") { Some(v) => Some(int_of(v)), None => None },
        exclusive: match opt_get(opts, "x") { Some(v) => Some(v == "1"), None => None },
    }
}

// One command on one endpoint; what it prints, or the error it raised.
fn exec(hc: ref Ctx, name: ref String, c: mut ref Conn, verb: ref String, w: ref Vec[String]) -> Result[(), H2Err] {
    if verb == "initiate" {
        c.initiate_connection()?;
    } else if verb == "upgrade" {
        let header = if w.len() > 2 { bytes_of(w[2]) } else { Vec.new() };
        match c.initiate_upgrade(hc, header)? {
            Some(b) => println(f"    -> {bytes_repr(b)}"),
            None => println("    -> None"),
        }
    } else if verb == "headers" {
        let sid = int_of(w[2]);
        let mut end = false;
        let mut p = Prio { weight: None, depends: None, exclusive: None };
        let mut hs: Vec[Header] = Vec.new();
        let mut i = 3;
        while i < w.len() {
            let a = ref w[i];
            if a == "end" {
                end = true;
            } else if a.starts_with("w=") {
                p.weight = Some(int_of(a[2..].to_string()));
            } else if a.starts_with("d=") {
                p.depends = Some(int_of(a[2..].to_string()));
            } else if a.starts_with("x=") {
                p.exclusive = Some(a[2..].to_string() == "1");
            } else {
                hs.push(parse_header(a));
            }
            i += 1;
        }
        c.send_headers(hc, sid, hs, end, p)?;
    } else if verb == "data" {
        let sid = int_of(w[2]);
        let mut end = false;
        let mut pad: Option[i64] = None;
        let mut i = 4;
        while i < w.len() {
            let a = ref w[i];
            if a == "end" {
                end = true;
            } else if a.starts_with("pad=") {
                pad = Some(int_of(a[4..].to_string()));
            }
            i += 1;
        }
        c.send_data(sid, payload(w[3]), end, pad)?;
    } else if verb == "end" {
        c.end_stream(int_of(w[2]))?;
    } else if verb == "window" {
        if w.len() > 3 {
            c.increment_window(int_of(w[2]), Some(int_of(w[3])))?;
        } else {
            c.increment_window(int_of(w[2]), None)?;
        }
    } else if verb == "push" {
        let mut hs: Vec[Header] = Vec.new();
        let mut i = 4;
        while i < w.len() {
            hs.push(parse_header(w[i]));
            i += 1;
        }
        c.push_stream(hc, int_of(w[2]), int_of(w[3]), hs)?;
    } else if verb == "ping" {
        c.ping(payload(w[2]))?;
    } else if verb == "reset" {
        let code = if w.len() > 3 { int_of(w[3]) } else { 0 };
        c.reset_stream(int_of(w[2]), code)?;
    } else if verb == "goaway" {
        let opts = opts_of(w, 2);
        let code = match opt_get(opts, "code") { Some(v) => int_of(v), None => 0 };
        let data = match opt_get(opts, "data") { Some(v) => payload(v), None => Vec.new() };
        let last = match opt_get(opts, "last") { Some(v) => Some(int_of(v)), None => None };
        c.close_connection(code, data, last)?;
    } else if verb == "settings" {
        let mut pairs: Vec[(i64, i64)] = Vec.new();
        for (k, v) in opts_of(w, 2).iter() {
            pairs.push((int_of(k), int_of(v)));
        }
        c.update_settings(pairs)?;
    } else if verb == "altsvc" {
        let opts = opts_of(w, 3);
        let origin = match opt_get(opts, "origin") { Some(v) => Some(payload(v)), None => None };
        let sid = match opt_get(opts, "sid") { Some(v) => Some(int_of(v)), None => None };
        c.advertise_alt(payload(w[2]), origin, sid)?;
    } else if verb == "prio" {
        c.prioritize(int_of(w[2]), prio_of(w, 3))?;
    } else if verb == "ack" {
        c.acknowledge(int_of(w[2]), int_of(w[3]))?;
    } else if verb == "raw" {
        deliver(hc, mut c, unhex(w[2]));
    } else if verb == "drop" {
        let d = c.data_to_send(None);
        println(f"    dropped {d.len()} bytes");
    } else if verb == "show" {
        show_frames(c.data_to_send(None));
    } else if verb == "state" {
        state_line(name, mut c);
    } else if verb == "windows" {
        let sid = int_of(w[2]);
        let l = c.local_window(sid)?;
        let r = c.remote_window(sid)?;
        println(f"    local {l} remote {r}");
    } else {
        println(f"    unknown verb {verb}");
    }
    Ok(())
}

fn find_conn(names: ref Vec[String], name: ref String) -> i64 {
    let mut i = 0;
    while i < names.len() {
        if names[i] == *name {
            return i;
        }
        i += 1;
    }
    -1
}

fn run_job(hc: ref Ctx, lines: ref Vec[String]) {
    let mut names: Vec[String] = Vec.new();
    let mut conns: Vec[Conn] = Vec.new();
    for line in lines.iter() {
        let w: Vec[String] = line.split(" ").map(|x| x.to_string()).collect();
        if w.len() > 2 and w[1] == "raw" {
            println(f"  {w[0]} raw {w[2].len() / 2} bytes");
        } else {
            println(f"  {line}");
        }
        if w[0] == "pipe" {
            let src = find_conn(names, w[1]);
            let dst = find_conn(names, w[2]);
            let data = if w.len() > 3 {
                let d = conns[src].data_to_send(Some(int_of(w[3])));
                println(f"    > {d.len()} bytes");
                d
            } else {
                let d = conns[src].data_to_send(None);
                show_frames(d);
                d
            };
            deliver(hc, mut conns[dst], data);
            continue;
        }
        if w[1] == "new" {
            let c = make_conn(w[2], opts_of(w, 3));
            let at = find_conn(names, w[0]);
            if at >= 0 {
                conns[at] = c;
            } else {
                names.push(w[0].clone());
                conns.push(c);
            }
            continue;
        }
        let at = find_conn(names, w[0]);
        if let Err(e) = exec(hc, w[0], mut conns[at], w[1], w) {
            show_error(e);
        }
    }
}

fn run() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    if let Err(e) = fs.write_bytes("data/jobs.txt".to_string(), bytes_of(jobs_text())) {
        return Err(f"cannot write data/jobs.txt: {e}");
    }
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            return Err(f"cannot read data/jobs.txt: {e}");
        }
    };
    let hc = Ctx { statics: static_entries(), huffman: new_huffman() };
    let mut titles: Vec[String] = Vec.new();
    let mut bodies: Vec[Vec[String]] = Vec.new();
    for line in text.split("\n") {
        if line.starts_with("job ") {
            titles.push(line[4..].to_string());
            bodies.push(Vec.new());
        } else if line.len() > 0 {
            let last = bodies.len() - 1;
            bodies[last].push(line.to_string());
        }
    }
    let mut i = 0;
    while i < titles.len() {
        println(f"> {titles[i]}");
        run_job(hc, bodies[i]);
        i += 1;
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
