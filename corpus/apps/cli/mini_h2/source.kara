fn jobs_text() -> String {
    let mut out = String.new();
    jobs_text_0(mut out);
    out
}

// H2StreamStateMachine's _transitions: (state, input) to (callback, target).
// The callback is FUNCS' index plus one, 0 for none; -1 means no transition.
fn stream_transition(state: i64, input: i64) -> (i64, i64) {
    match state * 100 + input {
        0 => (1, 3),
        6 => (3, 3),
        9 => (16, 6),
        1 => (10, 2),
        7 => (11, 1),
        16 => (0, 0),
        17 => (1, 5),
        18 => (3, 4),
        200 => (2, 4),
