// mini_h2: h2 4.2.0, the sans-I/O HTTP/2 protocol stack of Python's
// HTTP/2 clients and servers (httpx, hypercorn, twisted, grpclib), on
// the ports of its two dependencies, hpack 4.1.0 and hyperframe 6.1.0.
//
// The port covers H2Connection with its connection state machine,
// H2Stream with its stream state machine, flow-control windows, the
// SETTINGS bookkeeping (values waiting for an ACK), the frame buffer
// with CONTINUATION reassembly, the outbound normalisation and the
// inbound and outbound header validation, server push, priority,
// ALTSVC, PING, RST_STREAM, GOAWAY, the h2c upgrade, and every event
// and exception with the text h2 gives it.
//
// The run plays 75 conversations from data/jobs.txt (see mk.py): pairs
// of endpoints passing bytes to each other, and raw frames from a
// misbehaving peer. expected.out is oracle.py's output, which plays the
// same conversations through the vendored h2 itself.

// ---------------------------------------------------------------- bytes

fn char_of(cp: i64) -> char {
    char.try_from(cp as u32).unwrap_or('\u{fffd}')
}

fn is_cont(b: u8) -> bool {
    b >= 0x80 and b < 0xC0
}

// CPython's UTF-8 decoder with errors="replace": each maximal invalid
// subpart is one U+FFFD. The flag says whether the bytes were valid.
fn utf8_decode(data: ref Vec[u8]) -> (String, bool) {
    let mut out = String.new();
    let mut clean = true;
    let mut i = 0;
    let n = data.len();
    while i < n {
        let b = data[i];
        if b < 0x80 {
            out.push(b as char);
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if b >= 0xC2 and b <= 0xDF {
            need = 1;
        } else if b >= 0xE0 and b <= 0xEF {
            need = 2;
            if b == 0xE0 {
                lo = 0xA0;
            }
            if b == 0xED {
                hi = 0x9F;
            }
        } else if b >= 0xF0 and b <= 0xF4 {
            need = 3;
            if b == 0xF0 {
                lo = 0x90;
            }
            if b == 0xF4 {
                hi = 0x8F;
            }
        }
        clean = clean and need > 0;
        if need == 0 {
            out.push('\u{fffd}');
            i += 1;
            continue;
        }
        let mut k = 1;
        let mut bad = false;
        while k <= need {
            if i + k >= n {
                out.push('\u{fffd}');
                return (out, false);
            }
            let c = data[i + k];
            let ok = if k == 1 { c >= lo and c <= hi } else { is_cont(c) };
            if not ok {
                bad = true;
                break;
            }
            k += 1;
        }
        if bad {
            clean = false;
            out.push('\u{fffd}');
            i += k;
            continue;
        }
        let mut cp: i64 = if need == 1 { (b & 0x1F) as i64 } else if need == 2 { (b & 0x0F) as i64 } else { (b & 0x07) as i64 };
        k = 1;
        while k <= need {
            cp = (cp << 6) | ((data[i + k] & 0x3F) as i64);
            k += 1;
        }
        out.push(char_of(cp));
        i += need + 1;
    }
    (out, clean)
}

fn bytes_of(s: ref String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(*b);
    }
    v
}

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else {
        c as i64 - 55
    }
}

fn unhex(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

fn hex_of(data: ref Vec[u8]) -> String {
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    for b in data.iter() {
        let v = *b as i64;
        s.push(ds[v / 16]);
        s.push(ds[v % 16]);
    }
    s
}

fn push_all(out: mut ref Vec[u8], more: ref Vec[u8]) {
    for b in more.iter() {
        out.push(*b);
    }
}

fn sub(data: ref Vec[u8], lo: i64, hi: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = lo;
    let end = if hi < data.len() { hi } else { data.len() };
    while i < end {
        out.push(data[i]);
        i += 1;
    }
    out
}

fn same_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

// Control characters as \xNN, the way the report prints header text.
fn esc(s: ref String) -> String {
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    for c in s.chars() {
        let o = c as i64;
        if o < 0x20 or o == 0x7F {
            out.push_str("\\x");
            out.push(ds[o / 16]);
            out.push(ds[o % 16]);
        } else {
            out.push(c);
        }
    }
    out
}

fn text_of(data: ref Vec[u8]) -> String {
    let (s, _) = utf8_decode(data);
    s
}

fn pack_u16(out: mut ref Vec[u8], v: i64) {
    out.push(((v / 256) % 256) as u8);
    out.push((v % 256) as u8);
}

fn pack_u32(out: mut ref Vec[u8], v: i64) {
    out.push(((v / 16777216) % 256) as u8);
    out.push(((v / 65536) % 256) as u8);
    out.push(((v / 256) % 256) as u8);
    out.push((v % 256) as u8);
}

fn read_u16(data: ref Vec[u8], off: i64) -> i64 {
    (data[off] as i64) * 256 + (data[off + 1] as i64)
}

fn read_u32(data: ref Vec[u8], off: i64) -> i64 {
    (data[off] as i64) * 16777216
        + (data[off + 1] as i64) * 65536
        + (data[off + 2] as i64) * 256
        + (data[off + 3] as i64)
}

fn bstr(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn hex_upper(n: i64) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let ds: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut digits: Vec[char] = Vec.new();
    let mut v = n;
    while v > 0 {
        digits.push(ds[v % 16]);
        v /= 16;
    }
    let mut s = String.new();
    let mut i = digits.len() - 1;
    while i >= 0 {
        s.push(digits[i]);
        i -= 1;
    }
    s
}

// ---------- frame model ----------
// ---------------------------------------------------------------- frames (hyperframe 6.1.0, from mini_hyperframe)

#[derive(Clone)]
struct Frame {
    kind: i64,          // index matching FKind order
    type_byte: i64,
    stream_id: i64,
    flags: Vec[String],
    body_len: i64,
    data: Vec[u8],
    pad_length: i64,
    depends_on: i64,
    stream_weight: i64,
    exclusive: bool,
    error_code: i64,
    settings: Vec[(i64, i64)],
    promised_stream_id: i64,
    opaque_data: Vec[u8],
    last_stream_id: i64,
    additional_data: Vec[u8],
    window_increment: i64,
    origin: Vec[u8],
    field: Vec[u8],
    flag_byte: i64,
}

// kind indices
fn k_data() -> i64 { 0 }
fn k_headers() -> i64 { 1 }
fn k_priority() -> i64 { 2 }
fn k_rststream() -> i64 { 3 }
fn k_settings() -> i64 { 4 }
fn k_pushpromise() -> i64 { 5 }
fn k_ping() -> i64 { 6 }
fn k_goaway() -> i64 { 7 }
fn k_windowupdate() -> i64 { 8 }
fn k_continuation() -> i64 { 9 }
fn k_altsvc() -> i64 { 10 }
fn k_extension() -> i64 { 11 }

fn blank_frame(kind: i64, stream_id: i64) -> Frame {
    Frame {
        kind: kind,
        type_byte: type_byte(kind),
        stream_id: stream_id,
        flags: Vec.new(),
        body_len: 0,
        data: Vec.new(),
        pad_length: 0,
        depends_on: 0,
        stream_weight: 0,
        exclusive: false,
        error_code: 0,
        settings: Vec.new(),
        promised_stream_id: 0,
        opaque_data: Vec.new(),
        last_stream_id: 0,
        additional_data: Vec.new(),
        window_increment: 0,
        origin: Vec.new(),
        field: Vec.new(),
        flag_byte: 0,
    }
}

fn type_byte(kind: i64) -> i64 {
    if kind == 0 { 0x0 }
    else if kind == 1 { 0x1 }
    else if kind == 2 { 0x2 }
    else if kind == 3 { 0x3 }
    else if kind == 4 { 0x4 }
    else if kind == 5 { 0x5 }
    else if kind == 6 { 0x6 }
    else if kind == 7 { 0x7 }
    else if kind == 8 { 0x8 }
    else if kind == 9 { 0x9 }
    else if kind == 10 { 0xA }
    else { -1 }
}

fn type_name(kind: i64) -> String {
    if kind == 0 { "DataFrame".to_string() }
    else if kind == 1 { "HeadersFrame".to_string() }
    else if kind == 2 { "PriorityFrame".to_string() }
    else if kind == 3 { "RstStreamFrame".to_string() }
    else if kind == 4 { "SettingsFrame".to_string() }
    else if kind == 5 { "PushPromiseFrame".to_string() }
    else if kind == 6 { "PingFrame".to_string() }
    else if kind == 7 { "GoAwayFrame".to_string() }
    else if kind == 8 { "WindowUpdateFrame".to_string() }
    else if kind == 9 { "ContinuationFrame".to_string() }
    else if kind == 10 { "AltSvcFrame".to_string() }
    else { "ExtensionFrame".to_string() }
}

// stream association: 0 = either, 1 = has-stream, 2 = no-stream
fn stream_assoc(kind: i64) -> i64 {
    if kind == 0 { 1 }        // data
    else if kind == 1 { 1 }   // headers
    else if kind == 2 { 1 }   // priority
    else if kind == 3 { 1 }   // rststream
    else if kind == 4 { 2 }   // settings
    else if kind == 5 { 1 }   // pushpromise
    else if kind == 6 { 2 }   // ping
    else if kind == 7 { 2 }   // goaway
    else if kind == 8 { 0 }   // windowupdate
    else if kind == 9 { 1 }   // continuation
    else { 0 }                // altsvc, extension
}

fn defined_flags(kind: i64) -> Vec[(String, i64)] {
    let mut v: Vec[(String, i64)] = Vec.new();
    if kind == 0 {
        v.push(("END_STREAM".to_string(), 0x01));
        v.push(("PADDED".to_string(), 0x08));
    } else if kind == 1 {
        v.push(("END_STREAM".to_string(), 0x01));
        v.push(("END_HEADERS".to_string(), 0x04));
        v.push(("PADDED".to_string(), 0x08));
        v.push(("PRIORITY".to_string(), 0x20));
    } else if kind == 3 {
        // no flags
    } else if kind == 4 {
        v.push(("ACK".to_string(), 0x01));
    } else if kind == 5 {
        v.push(("END_HEADERS".to_string(), 0x04));
        v.push(("PADDED".to_string(), 0x08));
    } else if kind == 6 {
        v.push(("ACK".to_string(), 0x01));
    } else if kind == 9 {
        v.push(("END_HEADERS".to_string(), 0x04));
    }
    v
}

fn has_flag(frame: ref Frame, name: ref String) -> bool {
    for f in frame.flags.iter() {
        if f == name {
            return true;
        }
    }
    false
}

fn add_flag(frame: mut ref Frame, name: ref String) {
    let present = has_flag(frame, name);
    if not present {
        frame.flags.push(name.to_string());
    }
}

// ---------- repr helpers ----------

fn str_lt(a: ref String, b: ref String) -> bool {
    let ca: Vec[char] = a.chars().collect();
    let cb: Vec[char] = b.chars().collect();
    let mut i = 0;
    while i < ca.len() and i < cb.len() {
        if ca[i] != cb[i] {
            return (ca[i] as i64) < (cb[i] as i64);
        }
        i += 1;
    }
    ca.len() < cb.len()
}

fn flags_repr(frame: ref Frame) -> String {
    let mut names: Vec[String] = Vec.new();
    for f in frame.flags.iter() {
        names.push(f.to_string());
    }
    // insertion sort ascending
    let mut a = 1;
    while a < names.len() {
        let mut b = a;
        while b > 0 and str_lt(names[b], names[b - 1]) {
            let tmp = names[b - 1].clone();
            names[b - 1] = names[b].clone();
            names[b] = tmp;
            b -= 1;
        }
        a += 1;
    }
    let mut s = String.new();
    s.push('[');
    let mut i = 0;
    while i < names.len() {
        if i > 0 {
            s.push_str(", ");
        }
        s.push('\'');
        s.push_str(names[i]);
        s.push('\'');
        i += 1;
    }
    s.push(']');
    s
}

fn raw_data_repr(data: ref Vec[u8]) -> String {
    if data.len() == 0 {
        return "None".to_string();
    }
    let full = hex_of(data);
    let cs: Vec[char] = full.chars().collect();
    let mut r = String.new();
    if cs.len() > 20 {
        let mut i = 0;
        while i < 20 {
            r.push(cs[i]);
            i += 1;
        }
        r.push_str("...");
    } else {
        r = full;
    }
    f"<hex:{r}>"
}

// Python's bytes repr: b'...' with backslash escapes, choosing a double
// quote when the data holds a single quote but no double quote.
fn bytes_repr(data: ref Vec[u8]) -> String {
    let mut has_sq = false;
    let mut has_dq = false;
    for b in data.iter() {
        if *b as i64 == 39 { has_sq = true; }
        if *b as i64 == 34 { has_dq = true; }
    }
    let quote: i64 = if has_sq and not has_dq { 34 } else { 39 };
    let qc: char = if quote == 34 { '"' } else { '\'' };
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    s.push('b');
    s.push(qc);
    for bb in data.iter() {
        let c = *bb as i64;
        if c == quote or c == 92 {
            s.push('\\');
            s.push(c as u8 as char);
        } else if c == 9 {
            s.push_str("\\t");
        } else if c == 10 {
            s.push_str("\\n");
        } else if c == 13 {
            s.push_str("\\r");
        } else if c < 0x20 or c >= 0x7f {
            s.push_str("\\x");
            s.push(ds[c / 16]);
            s.push(ds[c % 16]);
        } else {
            s.push(c as u8 as char);
        }
    }
    s.push(qc);
    s
}

fn settings_repr(frame: ref Frame) -> String {
    let mut s = String.new();
    s.push('{');
    let mut i = 0;
    while i < frame.settings.len() {
        if i > 0 {
            s.push_str(", ");
        }
        let k = frame.settings[i].0;
        let v = frame.settings[i].1;
        s.push_str(f"{k}: {v}");
        i += 1;
    }
    s.push('}');
    s
}

fn body_repr(frame: ref Frame) -> String {
    if frame.kind == 2 {
        f"exclusive={bstr(frame.exclusive)}, depends_on={frame.depends_on}, stream_weight={frame.stream_weight}"
    } else if frame.kind == 1 {
        let dr = raw_data_repr(frame.data);
        f"exclusive={bstr(frame.exclusive)}, depends_on={frame.depends_on}, stream_weight={frame.stream_weight}, data={dr}"
    } else if frame.kind == 3 {
        f"error_code={frame.error_code}"
    } else if frame.kind == 4 {
        let sr = settings_repr(frame);
        f"settings={sr}"
    } else if frame.kind == 5 {
        let dr = raw_data_repr(frame.data);
        f"promised_stream_id={frame.promised_stream_id}, data={dr}"
    } else if frame.kind == 6 {
        let br = bytes_repr(frame.opaque_data);
        f"opaque_data={br}"
    } else if frame.kind == 7 {
        let br = bytes_repr(frame.additional_data);
        f"last_stream_id={frame.last_stream_id}, error_code={frame.error_code}, additional_data={br}"
    } else if frame.kind == 8 {
        f"window_increment={frame.window_increment}"
    } else if frame.kind == 9 {
        let dr = raw_data_repr(frame.data);
        f"data={dr}"
    } else if frame.kind == 10 {
        let orig = bytes_repr(frame.origin);
        let fr = bytes_repr(frame.field);
        f"origin={orig}, field={fr}"
    } else if frame.kind == 11 {
        let br = raw_data_repr(frame.data);
        f"type={frame.type_byte}, flag_byte={frame.flag_byte}, body={br}"
    } else {
        // data / continuation fallback: serialized body
        let body = serialize_body(frame);
        raw_data_repr(body)
    }
}

fn frame_repr(frame: ref Frame) -> String {
    let name = type_name(frame.kind);
    let fr = flags_repr(frame);
    let br = body_repr(frame);
    f"{name}(stream_id={frame.stream_id}, flags={fr}): {br}"
}

// ---------- serialize ----------

fn serialize_padding_data(frame: ref Frame) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let padded = "PADDED".to_string();
    if has_flag(frame, padded) {
        out.push((frame.pad_length % 256) as u8);
    }
    out
}

fn serialize_priority_data(frame: ref Frame) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let val = frame.depends_on + (if frame.exclusive { 0x80000000 } else { 0 });
    pack_u32(mut out, val);
    out.push((frame.stream_weight % 256) as u8);
    out
}

fn zeros(n: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < n {
        v.push(0);
        i += 1;
    }
    v
}

fn serialize_body(frame: ref Frame) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    if frame.kind == 0 {
        push_all(mut out, serialize_padding_data(frame));
        push_all(mut out, frame.data);
        push_all(mut out, zeros(frame.pad_length));
    } else if frame.kind == 1 {
        push_all(mut out, serialize_padding_data(frame));
        let priority = "PRIORITY".to_string();
        if has_flag(frame, priority) {
            push_all(mut out, serialize_priority_data(frame));
        }
        push_all(mut out, frame.data);
        push_all(mut out, zeros(frame.pad_length));
    } else if frame.kind == 2 {
        push_all(mut out, serialize_priority_data(frame));
    } else if frame.kind == 3 {
        pack_u32(mut out, frame.error_code);
    } else if frame.kind == 4 {
        let mut i = 0;
        while i < frame.settings.len() {
            pack_u16(mut out, frame.settings[i].0 % 256);
            pack_u32(mut out, frame.settings[i].1);
            i += 1;
        }
    } else if frame.kind == 5 {
        push_all(mut out, serialize_padding_data(frame));
        pack_u32(mut out, frame.promised_stream_id);
        push_all(mut out, frame.data);
        push_all(mut out, zeros(frame.pad_length));
    } else if frame.kind == 6 {
        push_all(mut out, frame.opaque_data);
        let mut i = frame.opaque_data.len();
        while i < 8 {
            out.push(0);
            i += 1;
        }
    } else if frame.kind == 7 {
        pack_u32(mut out, frame.last_stream_id % 2147483648);
        pack_u32(mut out, frame.error_code);
        push_all(mut out, frame.additional_data);
    } else if frame.kind == 8 {
        pack_u32(mut out, frame.window_increment % 2147483648);
    } else if frame.kind == 9 {
        push_all(mut out, frame.data);
    } else if frame.kind == 10 {
        pack_u16(mut out, frame.origin.len());
        push_all(mut out, frame.origin);
        push_all(mut out, frame.field);
    }
    out
}

fn serialize(frame: ref Frame) -> Result[Vec[u8], String] {
    if frame.kind == 6 and frame.opaque_data.len() > 8 {
        let n = frame.opaque_data.len();
        return Err(f"PING frame may not have more than 8 bytes of data, got {n}");
    }
    let body = serialize_body(frame);
    let body_len = body.len();
    let mut out: Vec[u8] = Vec.new();
    pack_u16(mut out, (body_len / 256) % 65536);
    out.push((body_len % 256) as u8);
    out.push((frame.type_byte % 256) as u8);
    // flags byte
    let mut flags: i64 = 0;
    for pair in defined_flags(frame.kind).iter() {
        if has_flag(frame, pair.0) {
            flags += pair.1;
        }
    }
    out.push((flags % 256) as u8);
    pack_u32(mut out, frame.stream_id % 2147483648);
    push_all(mut out, body);
    Ok(out)
}

// ---------- parse ----------

// returns bytes consumed, or Err
fn parse_padding_data(frame: mut ref Frame, data: ref Vec[u8]) -> Result[i64, String] {
    let padded = "PADDED".to_string();
    if has_flag(frame, padded) {
        if data.len() < 1 {
            return Err("Invalid Padding data".to_string());
        }
        frame.pad_length = data[0] as i64;
        return Ok(1);
    }
    Ok(0)
}

fn parse_priority_data(frame: mut ref Frame, data: ref Vec[u8]) -> Result[i64, String] {
    if data.len() < 5 {
        return Err("Invalid Priority data".to_string());
    }
    let raw = read_u32(data, 0);
    frame.stream_weight = data[4] as i64;
    frame.exclusive = (raw / 2147483648) % 2 == 1;
    frame.depends_on = raw % 2147483648;
    Ok(5)
}

fn parse_frame_header(data: ref Vec[u8], strict: bool) -> Result[(Frame, i64), String] {
    if data.len() < 9 {
        return Err("Invalid frame header".to_string());
    }
    let length = read_u16(data, 0) * 256 + (data[2] as i64);
    let typ = data[3] as i64;
    let flag_byte = data[4] as i64;
    let stream_id = read_u32(data, 5) % 2147483648;

    let kind = kind_for_type(typ);
    if kind < 0 {
        if strict {
            let hx = hex_upper(typ);
            return Err(f"UnknownFrameError: Unknown frame type 0x{hx} received, length {length} bytes");
        }
        let mut ef = blank_frame(k_extension(), stream_id);
        ef.type_byte = typ;
        ef.flag_byte = flag_byte;
        return Ok((ef, length));
    }

    // construct and run the stream-association check
    let mut frame = blank_frame(kind, stream_id);
    let assoc = stream_assoc(kind);
    if stream_id == 0 and assoc == 1 {
        let nm = type_name(kind);
        return Err(f"Stream ID must be non-zero for {nm}");
    }
    if stream_id != 0 and assoc == 2 {
        let nm = type_name(kind);
        return Err(f"Stream ID must be zero for {nm} with stream_id={stream_id}");
    }
    parse_flags(mut frame, flag_byte);
    Ok((frame, length))
}

fn kind_for_type(typ: i64) -> i64 {
    if typ == 0 { 0 }
    else if typ == 1 { 1 }
    else if typ == 2 { 2 }
    else if typ == 3 { 3 }
    else if typ == 4 { 4 }
    else if typ == 5 { 5 }
    else if typ == 6 { 6 }
    else if typ == 7 { 7 }
    else if typ == 8 { 8 }
    else if typ == 9 { 9 }
    else if typ == 10 { 10 }
    else { -1 }
}

fn parse_flags(frame: mut ref Frame, flag_byte: i64) {
    let flags = defined_flags(frame.kind);
    let mut i = 0;
    while i < flags.len() {
        let bit = flags[i].1;
        if band(flag_byte, bit) != 0 {
            add_flag(mut frame, flags[i].0.clone());
        }
        i += 1;
    }
}

fn band(a: i64, b: i64) -> i64 {
    let mut result = 0;
    let mut bit = 1;
    let mut x = a;
    let mut y = b;
    while x > 0 or y > 0 {
        if (x % 2) == 1 and (y % 2) == 1 {
            result += bit;
        }
        x /= 2;
        y /= 2;
        bit *= 2;
    }
    result
}

fn parse_body(frame: mut ref Frame, data: ref Vec[u8]) -> Result[(), String] {
    if frame.kind == 0 {
        let pdl = parse_padding_data(mut frame, data)?;
        let endd = data.len() - frame.pad_length;
        frame.data = sub(data, pdl, endd);
        frame.body_len = data.len();
        if frame.pad_length != 0 and frame.pad_length >= frame.body_len {
            return Err("Padding is too long.".to_string());
        }
        Ok(())
    } else if frame.kind == 1 {
        let pdl = parse_padding_data(mut frame, data)?;
        let rest = sub(data, pdl, data.len());
        let priority = "PRIORITY".to_string();
        let mut prio_len = 0;
        if has_flag(frame, priority) {
            prio_len = parse_priority_data(mut frame, rest)?;
        }
        frame.body_len = rest.len();
        let endd = rest.len() - frame.pad_length;
        frame.data = sub(rest, prio_len, endd);
        if frame.pad_length != 0 and frame.pad_length >= frame.body_len {
            return Err("Padding is too long.".to_string());
        }
        Ok(())
    } else if frame.kind == 2 {
        if data.len() > 5 {
            let n = data.len();
            return Err(f"PRIORITY must have 5 byte body: actual length {n}.");
        }
        parse_priority_data(mut frame, data)?;
        frame.body_len = 5;
        Ok(())
    } else if frame.kind == 3 {
        if data.len() != 4 {
            let n = data.len();
            return Err(f"RST_STREAM must have 4 byte body: actual length {n}.");
        }
        frame.error_code = read_u32(data, 0);
        frame.body_len = 4;
        Ok(())
    } else if frame.kind == 4 {
        let ack = "ACK".to_string();
        if has_flag(frame, ack) and data.len() > 0 {
            let n = data.len();
            return Err(f"SETTINGS ack frame must not have payload: got {n} bytes");
        }
        let mut body_len = 0;
        let mut i = 0;
        while i < data.len() {
            if i + 6 > data.len() {
                return Err("Invalid SETTINGS body".to_string());
            }
            let name = read_u16(data, i);
            let value = read_u32(data, i + 2);
            set_setting(mut frame, name, value);
            body_len += 6;
            i += 6;
        }
        frame.body_len = body_len;
        Ok(())
    } else if frame.kind == 5 {
        let pdl = parse_padding_data(mut frame, data)?;
        if pdl + 4 > data.len() {
            return Err("Invalid PUSH_PROMISE body".to_string());
        }
        frame.promised_stream_id = read_u32(data, pdl);
        let endd = data.len() - frame.pad_length;
        frame.data = sub(data, pdl + 4, endd);
        frame.body_len = data.len();
        if frame.promised_stream_id == 0 or frame.promised_stream_id % 2 != 0 {
            let p = frame.promised_stream_id;
            return Err(f"Invalid PUSH_PROMISE promised stream id: {p}");
        }
        if frame.pad_length != 0 and frame.pad_length >= frame.body_len {
            return Err("Padding is too long.".to_string());
        }
        Ok(())
    } else if frame.kind == 6 {
        if data.len() != 8 {
            let n = data.len();
            return Err(f"PING frame must have 8 byte length: got {n}");
        }
        frame.opaque_data = sub(data, 0, 8);
        frame.body_len = 8;
        Ok(())
    } else if frame.kind == 7 {
        if data.len() < 8 {
            return Err("Invalid GOAWAY body.".to_string());
        }
        frame.last_stream_id = read_u32(data, 0);
        frame.error_code = read_u32(data, 4);
        frame.body_len = data.len();
        if data.len() > 8 {
            frame.additional_data = sub(data, 8, data.len());
        }
        Ok(())
    } else if frame.kind == 8 {
        if data.len() > 4 {
            let n = data.len();
            return Err(f"WINDOW_UPDATE frame must have 4 byte length: got {n}");
        }
        if data.len() < 4 {
            return Err("Invalid WINDOW_UPDATE body".to_string());
        }
        frame.window_increment = read_u32(data, 0);
        if frame.window_increment < 1 or frame.window_increment > 2147483647 {
            return Err("WINDOW_UPDATE increment must be between 1 to 2^31-1".to_string());
        }
        frame.body_len = 4;
        Ok(())
    } else if frame.kind == 9 {
        frame.data = sub(data, 0, data.len());
        frame.body_len = data.len();
        Ok(())
    } else if frame.kind == 10 {
        if data.len() < 2 {
            return Err("Invalid ALTSVC frame body.".to_string());
        }
        let origin_len = read_u16(data, 0);
        frame.origin = sub(data, 2, 2 + origin_len);
        if frame.origin.len() != origin_len {
            return Err("Invalid ALTSVC frame body.".to_string());
        }
        frame.field = sub(data, 2 + origin_len, data.len());
        frame.body_len = data.len();
        Ok(())
    } else {
        // extension
        frame.data = sub(data, 0, data.len());
        frame.body_len = data.len();
        Ok(())
    }
}

fn set_setting(frame: mut ref Frame, name: i64, value: i64) {
    let mut i = 0;
    while i < frame.settings.len() {
        if frame.settings[i].0 == name {
            frame.settings[i] = (name, value);
            return;
        }
        i += 1;
    }
    frame.settings.push((name, value));
}

// ---------------------------------------------------------------- HPACK (hpack 4.1.0, from mini_hpack)


// The hpack exception: its class name and message.
struct HErr {
    kind: String,
    msg: String,
}

fn decoding_error(msg: Str) -> HErr {
    HErr { kind: "HPACKDecodingError".to_string(), msg: msg.to_string() }
}

// ---------------------------------------------------------------- integers

fn encode_integer(integer: i64, prefix_bits: i64) -> Vec[u8] {
    let max_number = (1 << prefix_bits) - 1;
    let mut out: Vec[u8] = Vec.new();
    if integer < max_number {
        out.push(integer as u8);
        return out;
    }
    out.push(max_number as u8);
    let mut rest = integer - max_number;
    while rest >= 128 {
        out.push(((rest & 127) + 128) as u8);
        rest = rest >> 7;
    }
    out.push(rest as u8);
    out
}

// decode_integer on data[at:]: the number and the bytes it took.
fn decode_integer(data: ref Vec[u8], at: i64, prefix_bits: i64) -> Result[(i64, i64), HErr] {
    let max_number = (1 << prefix_bits) - 1;
    let mask = 0xFF >> (8 - prefix_bits);
    if at >= data.len() {
        return Err(decoding_error("Unable to decode HPACK integer representation from <memory>"));
    }
    let mut number = (data[at] as i64) & mask;
    let mut index = 1;
    let mut shift = 0;
    if number == max_number {
        loop {
            if at + index >= data.len() {
                return Err(decoding_error("Unable to decode HPACK integer representation from <memory>"));
            }
            let next_byte = data[at + index] as i64;
            index += 1;
            if next_byte >= 128 {
                number += (next_byte - 128) << shift;
            } else {
                number += next_byte << shift;
                break;
            }
            shift += 7;
        }
    }
    Ok((number, index))
}

// ---------------------------------------------------------------- Huffman

struct Huffman {
    codes: Vec[(i64, i64)],
    fsm: Vec[i64],
}

fn new_huffman() -> Huffman {
    let text = huffman_fsm_hex();
    let raw = unhex(text);
    let mut fsm: Vec[i64] = Vec.new();
    for b in raw.iter() {
        fsm.push(*b as i64);
    }
    Huffman { codes: huffman_codes(), fsm: fsm }
}

const HUFFMAN_COMPLETE: i64 = 1;
const HUFFMAN_EMIT_SYMBOL: i64 = 2;
const HUFFMAN_FAIL: i64 = 4;

impl Huffman {
    // HuffmanEncoder.encode: the codes, padded to an octet with ones.
    fn encode(ref self, data: ref Vec[u8]) -> Vec[u8] {
        let mut out: Vec[u8] = Vec.new();
        let mut acc: i64 = 0;
        let mut bits = 0;
        for b in data.iter() {
            let (code, len) = self.codes[*b as i64];
            acc = (acc << len) | code;
            bits += len;
            while bits >= 8 {
                bits -= 8;
                out.push(((acc >> bits) & 0xFF) as u8);
            }
            acc = acc & ((1 << bits) - 1);
        }
        if bits > 0 {
            let pad = 8 - bits;
            out.push((((acc << pad) | ((1 << pad) - 1)) & 0xFF) as u8);
        }
        out
    }

    // decode_huffman: two nibbles per byte through the state machine.
    fn decode(ref self, data: ref Vec[u8]) -> Result[Vec[u8], HErr] {
        let mut out: Vec[u8] = Vec.new();
        if data.len() == 0 {
            return Ok(out);
        }
        let mut state = 0;
        let mut flags = 0;
        for b in data.iter() {
            let byte = *b as i64;
            for nibble in [byte >> 4, byte & 0x0F] {
                let index = (state * 16 + nibble) * 3;
                state = self.fsm[index];
                flags = self.fsm[index + 1];
                if flags & HUFFMAN_FAIL != 0 {
                    return Err(decoding_error("Invalid Huffman string"));
                }
                if flags & HUFFMAN_EMIT_SYMBOL != 0 {
                    out.push(self.fsm[index + 2] as u8);
                }
            }
        }
        if flags & HUFFMAN_COMPLETE == 0 {
            return Err(decoding_error("Incomplete Huffman string"));
        }
        Ok(out)
    }
}

// ---------------------------------------------------------------- tables

struct Field {
    name: Vec[u8],
    value: Vec[u8],
}

fn entry_size(name: ref Vec[u8], value: ref Vec[u8]) -> i64 {
    32 + name.len() + value.len()
}

enum Found {
    Nothing,
    Partial(i64),
    Perfect(i64),
}

// HeaderTable: the dynamic entries newest first, as hpack's deque.
struct Table {
    maxsize: i64,
    current: i64,
    resized: bool,
    dynamic: Vec[Field],
}

fn new_table() -> Table {
    Table { maxsize: 4096, current: 0, resized: false, dynamic: Vec.new() }
}

const STATIC_LEN: i64 = 61;

impl Table {
    fn get_by_index(ref self, statics: ref Vec[Field], index: i64) -> Result[Field, HErr] {
        let i = index - 1;
        if i >= 0 {
            if i < STATIC_LEN {
                let e = ref statics[i];
                return Ok(Field { name: e.name.clone(), value: e.value.clone() });
            }
            let j = i - STATIC_LEN;
            if j < self.dynamic.len() {
                let e = ref self.dynamic[j];
                return Ok(Field { name: e.name.clone(), value: e.value.clone() });
            }
        }
        Err(HErr { kind: "InvalidTableIndex".to_string(), msg: f"Invalid table index {index}" })
    }

    fn add(mut ref self, name: ref Vec[u8], value: ref Vec[u8]) {
        let size = entry_size(name, value);
        if size > self.maxsize {
            self.dynamic.clear();
            self.current = 0;
        } else {
            self.dynamic.insert(0, Field { name: name.clone(), value: value.clone() });
            self.current += size;
            self.shrink();
        }
    }

    fn search(ref self, statics: ref Vec[Field], name: ref Vec[u8], value: ref Vec[u8]) -> Found {
        let mut partial = Found.Nothing;
        let mut i = 0;
        let mut first = -1;
        while i < STATIC_LEN {
            let e = ref statics[i];
            if same_bytes(e.name, name) {
                if first < 0 {
                    first = i + 1;
                }
                if same_bytes(e.value, value) {
                    return Found.Perfect(i + 1);
                }
            }
            i += 1;
        }
        if first > 0 {
            partial = Found.Partial(first);
        }
        let mut have_partial = first > 0;
        let mut k = 0;
        while k < self.dynamic.len() {
            let e = ref self.dynamic[k];
            if same_bytes(e.name, name) {
                if same_bytes(e.value, value) {
                    return Found.Perfect(k + STATIC_LEN + 1);
                } else if not have_partial {
                    partial = Found.Partial(k + STATIC_LEN + 1);
                    have_partial = true;
                }
            }
            k += 1;
        }
        partial
    }

    fn set_maxsize(mut ref self, newmax: i64) {
        let oldmax = self.maxsize;
        self.maxsize = newmax;
        self.resized = newmax != oldmax;
        if newmax <= 0 {
            self.dynamic.clear();
            self.current = 0;
        } else if oldmax > newmax {
            self.shrink();
        }
    }

    fn shrink(mut ref self) {
        let mut cursize = self.current;
        while cursize > self.maxsize {
            if let Some(e) = self.dynamic.pop() {
                cursize -= entry_size(e.name, e.value);
            }
        }
        self.current = cursize;
    }

    fn same_entries(ref self, other: ref Table) -> bool {
        if self.dynamic.len() != other.dynamic.len() {
            return false;
        }
        let mut i = 0;
        while i < self.dynamic.len() {
            let a = ref self.dynamic[i];
            let b = ref other.dynamic[i];
            if not same_bytes(a.name, b.name) or not same_bytes(a.value, b.value) {
                return false;
            }
            i += 1;
        }
        true
    }

    fn show(ref self) {
        println(f"   table: {self.dynamic.len()} entries, {self.current} of {self.maxsize} bytes");
        let mut i = 0;
        while i < self.dynamic.len() {
            let e = ref self.dynamic[i];
            println(f"     [{62 + i}] {esc(text_of(e.name))}: {esc(text_of(e.value))}");
            i += 1;
        }
    }
}

fn static_entries() -> Vec[Field] {
    let mut v: Vec[Field] = Vec.new();
    for (n, val) in static_table().iter() {
        v.push(Field { name: bytes_of(n.to_string()), value: bytes_of(val.to_string()) });
    }
    v
}

// ---------------------------------------------------------------- Encoder

#[derive(Clone)]
struct Header {
    name: Vec[u8],
    value: Vec[u8],
    never: bool,
}

struct Encoder {
    table: Table,
    changes: Vec[i64],
}

fn new_encoder() -> Encoder {
    Encoder { table: new_table(), changes: Vec.new() }
}

fn with_bit(v: own Vec[u8], bit: u8) -> Vec[u8] {
    let mut v = v;
    v[0] = v[0] | bit;
    v
}

impl Encoder {
    fn set_table_size(mut ref self, value: i64) {
        self.table.set_maxsize(value);
        if self.table.resized {
            self.changes.push(value);
        }
    }

    fn encode(mut ref self, ctx: ref Ctx, headers: ref Vec[Header], huffman: bool) -> Vec[u8] {
        let mut block: Vec[u8] = Vec.new();
        if self.table.resized {
            for size in self.changes.iter() {
                push_all(mut block, with_bit(encode_integer(*size, 5), 0x20));
            }
            self.changes.clear();
            self.table.resized = false;
        }
        for h in headers.iter() {
            let part = self.add(ctx, h, huffman);
            push_all(mut block, part);
        }
        block
    }

    fn add(mut ref self, ctx: ref Ctx, h: ref Header, huffman: bool) -> Vec[u8] {
        let sensitive = h.never;
        let indexbit: u8 = if sensitive { 0x10 } else { 0x40 };
        // hpack tests the matched value for truth, so a perfect match on
        // an empty value is encoded like a match on the name alone.
        let (index, perfect) = match self.table.search(ctx.statics, h.name, h.value) {
            Found.Nothing => {
                let encoded = encode_literal(ctx, h.name, h.value, indexbit, huffman);
                if not sensitive {
                    self.table.add(h.name, h.value);
                }
                return encoded;
            }
            Found.Perfect(index) => (index, h.value.len() > 0),
            Found.Partial(index) => (index, false),
        };
        if perfect {
            return with_bit(encode_integer(index, 7), 0x80);
        }
        let prefix = if indexbit != 0x40 { encode_integer(index, 4) } else { encode_integer(index, 6) };
        let mut out = with_bit(prefix, indexbit);
        push_all(mut out, string_literal(ctx, h.value, huffman));
        if not sensitive {
            self.table.add(h.name, h.value);
        }
        out
    }
}

// A length-prefixed string, Huffman-coded or not.
fn string_literal(ctx: ref Ctx, s: ref Vec[u8], huffman: bool) -> Vec[u8] {
    let body = if huffman { ctx.huffman.encode(s) } else { s.clone() };
    let len = encode_integer(body.len(), 7);
    let mut out = if huffman { with_bit(len, 0x80) } else { len };
    push_all(mut out, body);
    out
}

fn encode_literal(ctx: ref Ctx, name: ref Vec[u8], value: ref Vec[u8], indexbit: u8, huffman: bool) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    out.push(indexbit);
    push_all(mut out, string_literal(ctx, name, huffman));
    push_all(mut out, string_literal(ctx, value, huffman));
    out
}

// ---------------------------------------------------------------- Decoder

struct Decoder {
    table: Table,
    max_list: i64,
    max_allowed: i64,
}

fn new_decoder() -> Decoder {
    Decoder { table: new_table(), max_list: 65536, max_allowed: 4096 }
}

impl Decoder {
    fn decode(mut ref self, ctx: ref Ctx, data: ref Vec[u8]) -> Result[Vec[Header], HErr] {
        let mut headers: Vec[Header] = Vec.new();
        let mut inflated = 0;
        let mut at = 0;
        while at < data.len() {
            let current = data[at];
            let mut got: Option[Header] = None;
            let mut consumed = 0;
            if current & 0x80 != 0 {
                let (index, n) = decode_integer(data, at, 7)?;
                let e = self.table.get_by_index(ctx.statics, index)?;
                got = Some(Header { name: e.name, value: e.value, never: false });
                consumed = n;
            } else if current & 0x40 != 0 {
                let (h, n) = self.decode_literal(ctx, data, at, true)?;
                got = Some(h);
                consumed = n;
            } else if current & 0x20 != 0 {
                if headers.len() > 0 {
                    return Err(decoding_error("Table size update not at the start of the block"));
                }
                let (new_size, n) = decode_integer(data, at, 5)?;
                if new_size > self.max_allowed {
                    return Err(HErr { kind: "InvalidTableSizeError".to_string(), msg: "Encoder exceeded max allowable table size".to_string() });
                }
                self.table.set_maxsize(new_size);
                consumed = n;
            } else {
                let (h, n) = self.decode_literal(ctx, data, at, false)?;
                got = Some(h);
                consumed = n;
            }
            if let Some(h) = got {
                inflated += entry_size(h.name, h.value);
                headers.push(h);
                if inflated > self.max_list {
                    return Err(HErr { kind: "OversizedHeaderListError".to_string(), msg: f"A header list larger than {self.max_list} has been received" });
                }
            }
            at += consumed;
        }
        if self.table.maxsize > self.max_allowed {
            return Err(HErr { kind: "InvalidTableSizeError".to_string(), msg: "Encoder did not shrink table size to within the max".to_string() });
        }
        // h2 decodes with raw=True, which skips the UTF-8 check.
        Ok(headers)
    }

    // _decode_literal on data[at:]: the header and the bytes it took.
    fn decode_literal(mut ref self, ctx: ref Ctx, data: ref Vec[u8], at: i64, should_index: bool) -> Result[(Header, i64), HErr] {
        let high = data[at] as i64;
        let indexed_name = if should_index { high & 0x3F } else { high & 0x0F };
        let name_len = if should_index { 6 } else { 4 };
        let not_indexable = not should_index and high & 0x10 != 0;
        let mut total = 0;
        let mut name: Vec[u8] = Vec.new();
        // `pos` is where hpack's `data` starts before the value: after the
        // name's index, or after the name.
        let mut pos = at;
        if indexed_name != 0 {
            let (index, n) = decode_integer(data, at, name_len)?;
            name = self.table.get_by_index(ctx.statics, index)?.name;
            total = n;
            pos = at + n;
        } else {
            let start = at + 1;
            let (length, n) = decode_integer(data, start, 7)?;
            let raw = sub(data, start + n, start + n + length);
            if raw.len() != length {
                return Err(decoding_error("Truncated header block"));
            }
            name = if data[start] & 0x80 != 0 { ctx.huffman.decode(raw)? } else { raw };
            total = n + length + 1;
            pos = start + n + length;
        }
        let (length, n) = decode_integer(data, pos, 7)?;
        let raw = sub(data, pos + n, pos + n + length);
        if raw.len() != length {
            return Err(decoding_error("Truncated header block"));
        }
        let value = if data[pos] & 0x80 != 0 { ctx.huffman.decode(raw)? } else { raw };
        total += length + n;
        if should_index {
            self.table.add(name, value);
        }
        Ok((Header { name: name, value: value, never: not_indexable }, total))
    }
}

struct Ctx {
    statics: Vec[Field],
    huffman: Huffman,
}


// HeaderTable.STATIC_TABLE
fn static_table() -> Vec[(Str, Str)] {
    vec![
        (":authority", ""),
        (":method", "GET"),
        (":method", "POST"),
        (":path", "/"),
        (":path", "/index.html"),
        (":scheme", "http"),
        (":scheme", "https"),
        (":status", "200"),
        (":status", "204"),
        (":status", "206"),
        (":status", "304"),
        (":status", "400"),
        (":status", "404"),
        (":status", "500"),
        ("accept-charset", ""),
        ("accept-encoding", "gzip, deflate"),
        ("accept-language", ""),
        ("accept-ranges", ""),
        ("accept", ""),
        ("access-control-allow-origin", ""),
        ("age", ""),
        ("allow", ""),
        ("authorization", ""),
        ("cache-control", ""),
        ("content-disposition", ""),
        ("content-encoding", ""),
        ("content-language", ""),
        ("content-length", ""),
        ("content-location", ""),
        ("content-range", ""),
        ("content-type", ""),
        ("cookie", ""),
        ("date", ""),
        ("etag", ""),
        ("expect", ""),
        ("expires", ""),
        ("from", ""),
        ("host", ""),
        ("if-match", ""),
        ("if-modified-since", ""),
        ("if-none-match", ""),
        ("if-range", ""),
        ("if-unmodified-since", ""),
        ("last-modified", ""),
        ("link", ""),
        ("location", ""),
        ("max-forwards", ""),
        ("proxy-authenticate", ""),
        ("proxy-authorization", ""),
        ("range", ""),
        ("referer", ""),
        ("refresh", ""),
