// mini_pyaes: a port of pyaes 1.6.1 (MIT, Richard Moore), the pure-Python
// AES block cipher with its five modes of operation (ECB, CBC, CFB, OFB and
// CTR), the feeders that chunk and pad a stream of bytes for them, and the
// stream helpers a small backup tool encrypts its files with. Every step of
// data/jobs.tsv is a call on pyaes (see mk.py and README.md).
//
// Bytes are held as a Vec of byte values. The files the jobs encrypt are
// written to data/plain/ first, and the streams really read and write
// files under data/, in chunks of the block size asked for.

// ------------------------------------------------------------ helpers

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: Str) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.to_string() }
}

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_num(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_val(c);
    }
    v
}

fn hex_bytes(s: ref String) -> Vec[i64] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        out.push(hex_val(cs[k]) * 16 + hex_val(cs[k + 1]));
        k += 2;
    }
    out
}

fn hex_of(b: ref Vec[i64]) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    for x in b {
        out.push(d[(*x >> 4) & 15]);
        out.push(d[*x & 15]);
    }
    out
}

// int() of a decimal string.
fn int_of(s: ref String) -> i64 {
    let mut neg = false;
    let mut v = 0;
    for c in s.chars() {
        if c == '-' {
            neg = true;
        } else {
            v = v * 10 + (c as i64 - 48);
        }
    }
    if neg { -v } else { v }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

// data[lo:hi], clamped the way Python slices are.
fn slice(data: ref Vec[i64], lo: i64, hi: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let end = if hi > data.len() { data.len() } else { hi };
    let mut k = if lo < 0 { 0 } else { lo };
    while k < end {
        out.push(data[k]);
        k += 1;
    }
    out
}

fn push_all(out: mut ref Vec[i64], xs: ref Vec[i64]) {
    for x in xs {
        out.push(*x);
    }
}

// [a ^ b for (a, b) in zip(xs, ys)]
fn xor_zip(xs: ref Vec[i64], ys: ref Vec[i64]) -> Vec[i64] {
    let n = if xs.len() < ys.len() { xs.len() } else { ys.len() };
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        out.push(xs[k] ^ ys[k]);
        k += 1;
    }
    out
}

// Python's % and //, which round toward negative infinity.
fn py_mod(a: i64, b: i64) -> i64 {
    let r = a % b;
    if r != 0 and (r < 0) != (b < 0) { r + b } else { r }
}

fn py_div(a: i64, b: i64) -> i64 {
    (a - py_mod(a, b)) / b
}

fn fnv(b: ref Vec[i64]) -> i64 {
    let mut h = 2166136261;
    for x in b {
        h = ((h ^ *x) * 16777619) & 4294967295;
    }
    h
}

// How oracle.py prints bytes.
fn show(b: ref Vec[i64]) -> String {
    if b.len() > 64 {
        f"{b.len()} bytes, fnv1a {fnv(b):08x}"
    } else {
        f"{hex_of(b)} ({b.len()} bytes)"
    }
}

// repr() of a list of ints.
fn list_repr(b: ref Vec[i64]) -> String {
    let mut s = "[".to_string();
    let mut k = 0;
    while k < b.len() {
        if k > 0 {
            s.push_str(", ");
        }
        s.push_str(f"{b[k]}");
        k += 1;
    }
    s.push_str("]");
    s
}

// ------------------------------------------------------------ AES (aes.py)

struct Tables {
    s: Vec[i64],
    si: Vec[i64],
    t1: Vec[i64],
    t2: Vec[i64],
    t3: Vec[i64],
    t4: Vec[i64],
    t5: Vec[i64],
    t6: Vec[i64],
    t7: Vec[i64],
    t8: Vec[i64],
    u1: Vec[i64],
    u2: Vec[i64],
    u3: Vec[i64],
    u4: Vec[i64],
    rcon: Vec[i64],
}

// The AES class's tables, in the order gen_kara.py writes them.
fn load_tables() -> Tables {
    let mut by: Vec[Vec[i64]] = Vec.new();
    for line in split_on(table_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let mut v: Vec[i64] = Vec.new();
        let mut k = 1;
        while k < f.len() {
            v.push(hex_num(f[k]));
            k += 1;
        }
        by.push(v);
    }
    Tables {
        s: by[0].clone(),
        si: by[1].clone(),
        t1: by[2].clone(),
        t2: by[3].clone(),
        t3: by[4].clone(),
        t4: by[5].clone(),
        t5: by[6].clone(),
        t6: by[7].clone(),
        t7: by[8].clone(),
        t8: by[9].clone(),
        u1: by[10].clone(),
        u2: by[11].clone(),
        u3: by[12].clone(),
        u4: by[13].clone(),
        rcon: by[14].clone(),
    }
}

// The round keys, flattened: round r's four words start at r * 4. As in
// the library they are the signed words struct.unpack('>i') gives.
struct Aes {
    rounds: i64,
    ke: Vec[i64],
    kd: Vec[i64],
}

fn none_len() -> Exc {
    exc("TypeError", "object of type 'NoneType' has no len()")
}

fn aes_new(tb: ref Tables, key: ref Option[Vec[i64]]) -> Result[Aes, Exc] {
    let k = match key {
        Some(k) => k.clone(),
        None => {
            return Err(none_len());
        }
    };
    let n = k.len();
    if n != 16 and n != 24 and n != 32 {
        return Err(exc("ValueError", "Invalid key size"));
    }
    let rounds = if n == 16 { 10 } else if n == 24 { 12 } else { 14 };
    let round_key_count = (rounds + 1) * 4;
    let mut ke: Vec[i64] = Vec.new();
    let mut kd: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < round_key_count {
        ke.push(0);
        kd.push(0);
        i += 1;
    }
    let kc = n / 4;
    let mut tk: Vec[i64] = Vec.new();
    i = 0;
    while i < kc {
        let w = (k[4 * i] << 24) | (k[4 * i + 1] << 16) | (k[4 * i + 2] << 8) | k[4 * i + 3];
        tk.push(if w >= 2147483648 { w - 4294967296 } else { w });
        i += 1;
    }
    i = 0;
    while i < kc {
        ke[i] = tk[i];
        kd[(rounds - i / 4) * 4 + i % 4] = tk[i];
        i += 1;
    }
    // Key expansion (fips-197 section 5.2)
    let mut rconpointer = 0;
    let mut t = kc;
    while t < round_key_count {
        let tt = tk[kc - 1];
        tk[0] = tk[0]
            ^ ((tb.s[(tt >> 16) & 255] << 24)
                ^ (tb.s[(tt >> 8) & 255] << 16)
                ^ (tb.s[tt & 255] << 8)
                ^ tb.s[(tt >> 24) & 255]
                ^ (tb.rcon[rconpointer] << 24));
        rconpointer += 1;
        if kc != 8 {
            let mut j = 1;
            while j < kc {
                tk[j] = tk[j] ^ tk[j - 1];
                j += 1;
            }
        } else {
            // Key expansion for 256-bit keys is "slightly different"
            let mut j = 1;
            while j < kc / 2 {
                tk[j] = tk[j] ^ tk[j - 1];
                j += 1;
            }
            let tt = tk[kc / 2 - 1];
            tk[kc / 2] = tk[kc / 2]
                ^ (tb.s[tt & 255]
                    ^ (tb.s[(tt >> 8) & 255] << 8)
                    ^ (tb.s[(tt >> 16) & 255] << 16)
                    ^ (tb.s[(tt >> 24) & 255] << 24));
            j = kc / 2 + 1;
            while j < kc {
                tk[j] = tk[j] ^ tk[j - 1];
                j += 1;
            }
        }
        let mut j = 0;
        while j < kc and t < round_key_count {
            ke[t] = tk[j];
            kd[(rounds - t / 4) * 4 + t % 4] = tk[j];
            j += 1;
            t += 1;
        }
    }
    // Inverse-Cipher-ify the decryption round key (fips-197 section 5.3)
    let mut r = 1;
    while r < rounds {
        let mut j = 0;
        while j < 4 {
            let tt = kd[r * 4 + j];
            kd[r * 4 + j] = tb.u1[(tt >> 24) & 255]
                ^ tb.u2[(tt >> 16) & 255]
                ^ tb.u3[(tt >> 8) & 255]
                ^ tb.u4[tt & 255];
            j += 1;
        }
        r += 1;
    }
    Ok(Aes { rounds: rounds, ke: ke, kd: kd })
}

fn compact_word(b: ref Vec[i64], at: i64) -> i64 {
    (b[at] << 24) | (b[at + 1] << 16) | (b[at + 2] << 8) | b[at + 3]
}

// AES.encrypt and AES.decrypt: one 16-byte block in, a list of 16 out.
fn aes_block(tb: ref Tables, a: ref Aes, encrypt: bool, block: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    if block.len() != 16 {
        return Err(exc("ValueError", "wrong block length"));
    }
    let rounds = a.rounds;
    let s1 = if encrypt { 1 } else { 3 };
    let s3 = if encrypt { 3 } else { 1 };
    let keys = if encrypt { a.ke.clone() } else { a.kd.clone() };
    let mut t: Vec[i64] = Vec.new();
    for i in 0..4 {
        t.push(compact_word(block, 4 * i) ^ keys[i]);
    }
    let mut r = 1;
    while r < rounds {
        let mut next: Vec[i64] = Vec.new();
        for i in 0..4 {
            let w0 = (t[i] >> 24) & 255;
            let w1 = (t[(i + s1) % 4] >> 16) & 255;
            let w2 = (t[(i + 2) % 4] >> 8) & 255;
            let w3 = t[(i + s3) % 4] & 255;
            let v = if encrypt {
                tb.t1[w0] ^ tb.t2[w1] ^ tb.t3[w2] ^ tb.t4[w3]
            } else {
                tb.t5[w0] ^ tb.t6[w1] ^ tb.t7[w2] ^ tb.t8[w3]
            };
            next.push(v ^ keys[r * 4 + i]);
        }
        t = next;
        r += 1;
    }
    // The last round is special
    let sbox = if encrypt { tb.s.clone() } else { tb.si.clone() };
    let mut result: Vec[i64] = Vec.new();
    for i in 0..4 {
        let tt = keys[rounds * 4 + i];
        result.push((sbox[(t[i] >> 24) & 255] ^ (tt >> 24)) & 255);
        result.push((sbox[(t[(i + s1) % 4] >> 16) & 255] ^ (tt >> 16)) & 255);
        result.push((sbox[(t[(i + 2) % 4] >> 8) & 255] ^ (tt >> 8)) & 255);
        result.push((sbox[t[(i + s3) % 4] & 255] ^ tt) & 255);
    }
    Ok(result)
}

// Counter(initial_value): the low 128 bits of the value, high byte first,
// as [((initial_value >> i) % 256) for i in range(120, -1, -8)] gives
// them (two's complement for a negative value). The value is a decimal
// string, since it may be any size.
fn counter_bytes(dec: ref String) -> Vec[i64] {
    let mut neg = false;
    let mut digits: Vec[i64] = Vec.new();
    for c in dec.chars() {
        if c == '-' {
            neg = true;
        } else {
            digits.push(c as i64 - 48);
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for _ in 0..16 {
        out.push(0);
    }
    for k in 0..16 {
        let mut rem = 0;
        let mut q: Vec[i64] = Vec.new();
        for d in digits.iter() {
            let cur = rem * 10 + *d;
            q.push(cur / 256);
            rem = cur % 256;
        }
        out[15 - k] = rem;
        digits = q;
    }
    if neg {
        let mut carry = 1;
        let mut k = 15;
        while k >= 0 {
            let v = (255 - out[k]) + carry;
            out[k] = v & 255;
            carry = v >> 8;
            k -= 1;
        }
    }
    out
}

// Counter.increment (overflow rolls back to 0).
fn increment(c: mut ref Vec[i64]) {
    let mut i = c.len() - 1;
    while i >= 0 {
        c[i] += 1;
        if c[i] < 256 {
            return;
        }
        c[i] = 0;
        i -= 1;
    }
}

// ------------------------------------------------------------ modes

const ECB: i64 = 0;
const CBC: i64 = 1;
const CFB: i64 = 2;
const OFB: i64 = 3;
const CTR: i64 = 4;

// One AESModeOfOperation object. `reg` is CBC's last cipherblock, CFB's
// shift register or OFB's last precipherblock; `rem` and `pos` are what
// OFB and CTR have left of their last keystream block. `reg_list` is true
// while CFB's shift register is the list [0] * 16 it starts as without an
// IV, which the library cannot concatenate bytes onto.
struct Mode {
    kind: i64,
    aes: Aes,
    reg: Vec[i64],
    reg_list: bool,
    rem: Vec[i64],
    pos: i64,
    seg: i64,
    counter: i64,
}

struct Feeder {
    mode: i64,
    encrypt: bool,
    buf: Vec[i64],
    done: bool,
    padding: String,
}

// The objects the jobs make, and the names they are bound to. A name bound
// again gets a new object; the old one lives on for whatever holds it, as
// a Python object does.
struct State {
    modes: Vec[Mode],
    counters: Vec[Vec[i64]],
    feeders: Vec[Feeder],
    mode_ix: Map[String, i64],
    counter_ix: Map[String, i64],
    feeder_ix: Map[String, i64],
}

fn lookup(m: ref Map[String, i64], name: ref String) -> i64 {
    match m.get(name.clone()) {
        Some(v) => *v,
        None => -1,
    }
}

fn val(f: ref String) -> Option[Vec[i64]] {
    if f == "-" { None } else { Some(hex_bytes(f)) }
}

fn iv_reg(iv: ref Option[Vec[i64]]) -> Result[Vec[i64], Exc] {
    match iv {
        None => {
            let mut z: Vec[i64] = Vec.new();
            for _ in 0..16 {
                z.push(0);
            }
            Ok(z)
        }
        Some(v) => {
            if v.len() != 16 {
                Err(exc("ValueError", "initialization vector must be 16 bytes"))
            } else {
                Ok(v.clone())
            }
        }
    }
}

// mode <name> <kind> <key> [<iv>|<counter>] [<segment size>], as
// oracle.py's make_mode() calls the constructors: each checks its
// arguments in the library's order (the IV before the key).
fn make_mode(tb: ref Tables, st: mut ref State, f: ref Vec[String]) -> Result[Mode, Exc] {
    let key = val(f[3]);
    let kind = f[2].clone();
    let iv: Option[Vec[i64]] = if f.len() > 4 and kind != "ctr" { val(f[4]) } else { None };
    if kind == "ecb" {
        let aes = aes_new(tb, key)?;
        return Ok(Mode { kind: ECB, aes: aes, reg: Vec.new(), reg_list: false, rem: Vec.new(), pos: 0, seg: 0, counter: -1 });
    }
    if kind == "cbc" or kind == "ofb" {
        let reg = iv_reg(iv)?;
        let aes = aes_new(tb, key)?;
        let k = if kind == "cbc" { CBC } else { OFB };
        return Ok(Mode { kind: k, aes: aes, reg: reg, reg_list: false, rem: Vec.new(), pos: 0, seg: 0, counter: -1 });
    }
    if kind == "cfb" {
        let mut seg = int_of(f[5]);
        if seg == 0 {
            seg = 1;
        }
        let reg = iv_reg(iv)?;
        let aes = aes_new(tb, key)?;
        return Ok(Mode { kind: CFB, aes: aes, reg: reg, reg_list: iv.is_none(), rem: Vec.new(), pos: 0, seg: seg, counter: -1 });
    }
    let aes = aes_new(tb, key)?;
    let counter = if f.len() > 4 {
        lookup(st.counter_ix, f[4])
    } else {
        st.counters.push(counter_bytes("1".to_string()));
        st.counters.len() - 1
    };
    Ok(Mode { kind: CTR, aes: aes, reg: Vec.new(), reg_list: false, rem: Vec.new(), pos: 0, seg: 0, counter: counter })
}

// mode.encrypt(data) or mode.decrypt(data).
fn crypt(tb: ref Tables, st: mut ref State, mi: i64, encrypt: bool, data: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    let kind = st.modes[mi].kind;
    let what = if encrypt { "plaintext" } else { "ciphertext" };
    if kind == ECB or kind == CBC {
        if data.len() != 16 {
            return Err(exc("ValueError", f"{what} block must be 16 bytes"));
        }
        if kind == ECB {
            return aes_block(tb, st.modes[mi].aes, encrypt, data);
        }
        if encrypt {
            let pre = xor_zip(data, st.modes[mi].reg);
            let c = aes_block(tb, st.modes[mi].aes, true, pre)?;
            st.modes[mi].reg = c.clone();
            return Ok(c);
        }
        let d = aes_block(tb, st.modes[mi].aes, false, data)?;
        let p = xor_zip(d, st.modes[mi].reg);
        st.modes[mi].reg = data.clone();
        return Ok(p);
    }
    if kind == CFB {
        let seg = st.modes[mi].seg;
        if py_mod(data.len(), seg) != 0 {
            return Err(exc("ValueError", f"{what} block must be a multiple of segment_size"));
        }
        let mut out: Vec[i64] = Vec.new();
        let mut i = 0;
        while seg > 0 and i < data.len() {
            let segment = slice(data, i, i + seg);
            let x = aes_block(tb, st.modes[mi].aes, true, st.modes[mi].reg)?;
            let xs = slice(x, 0, segment.len());
            let other = xor_zip(segment, xs);
            // Shift the top bits out and the ciphertext in
            if st.modes[mi].reg_list {
                return Err(exc("TypeError", "can only concatenate list (not \"bytes\") to list"));
            }
            let cipher = if encrypt { other.clone() } else { segment.clone() };
            let reg = st.modes[mi].reg.clone();
            let mut next = slice(reg, cipher.len(), reg.len());
            push_all(mut next, cipher);
            st.modes[mi].reg = next;
            push_all(mut out, other);
            i += seg;
        }
        return Ok(out);
    }
    if kind == OFB {
        // AES-OFB is symmetric
        let mut out: Vec[i64] = Vec.new();
        for p in data {
            if st.modes[mi].pos == st.modes[mi].rem.len() {
                let block = aes_block(tb, st.modes[mi].aes, true, st.modes[mi].reg)?;
                st.modes[mi].rem = block;
                st.modes[mi].pos = 0;
                st.modes[mi].reg = Vec.new();
            }
            let pre = st.modes[mi].rem[st.modes[mi].pos];
            st.modes[mi].pos += 1;
            st.modes[mi].reg.push(pre);
            out.push(*p ^ pre);
        }
        return Ok(out);
    }
    // CTR, symmetric too
    let c = st.modes[mi].counter;
    while st.modes[mi].rem.len() - st.modes[mi].pos < data.len() {
        let block = aes_block(tb, st.modes[mi].aes, true, st.counters[c])?;
        let mut rem = slice(st.modes[mi].rem, st.modes[mi].pos, st.modes[mi].rem.len());
        push_all(mut rem, block);
        st.modes[mi].rem = rem;
        st.modes[mi].pos = 0;
        increment(mut st.counters[c]);
    }
    let pos = st.modes[mi].pos;
    let ks = slice(st.modes[mi].rem, pos, pos + data.len());
    let out = xor_zip(data, ks);
    st.modes[mi].pos = pos + out.len();
    Ok(out)
}

// ------------------------------------------------------------ feeders (blockfeeder.py)

fn invalid_padding() -> Exc {
    exc("Exception", "invalid padding option")
}

fn can_consume(m: ref Mode, size: i64) -> i64 {
    if m.kind == ECB or m.kind == CBC {
        if size >= 16 { 16 } else { 0 }
    } else if m.kind == CFB {
        m.seg * py_div(size, m.seg)
    } else {
        size
    }
}

fn strip_pkcs7(data: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    if data.len() % 16 != 0 {
        return Err(exc("ValueError", "invalid length"));
    }
    let pad = data[data.len() - 1];
    if pad > 16 {
        return Err(exc("ValueError", "invalid padding byte"));
    }
    // data[:-pad], which is empty for a pad of 0
    if pad == 0 {
        return Ok(Vec.new());
    }
    Ok(slice(data, 0, data.len() - pad))
}

// _final_encrypt / _final_decrypt of the mode's family.
fn final_block(tb: ref Tables, st: mut ref State, mi: i64, encrypt: bool, data: ref Vec[i64], padding: ref String) -> Result[Vec[i64], Exc] {
    let kind = st.modes[mi].kind;
    if kind == ECB or kind == CBC {
        if encrypt {
            let mut d = data.clone();
            if padding == "default" {
                let pad = 16 - data.len() % 16;
                for _ in 0..pad {
                    d.push(pad);
                }
            } else if padding == "none" {
                if data.len() != 16 {
                    return Err(exc("Exception", "invalid data length for final block"));
                }
            } else {
                return Err(invalid_padding());
            }
            if d.len() == 32 {
                let mut a = crypt(tb, mut st, mi, true, slice(d, 0, 16))?;
                let b = crypt(tb, mut st, mi, true, slice(d, 16, 32))?;
                push_all(mut a, b);
                return Ok(a);
            }
            return crypt(tb, mut st, mi, true, d);
        }
        if padding == "default" {
            let p = crypt(tb, mut st, mi, false, data)?;
            return strip_pkcs7(p);
        }
        if padding == "none" {
            if data.len() != 16 {
                return Err(exc("Exception", "invalid data length for final block"));
            }
            return crypt(tb, mut st, mi, false, data);
        }
        return Err(invalid_padding());
    }
    if kind == CFB {
        // CFB can handle a non-segment-sized block at the end using the
        // remaining cipherblock
        if padding != "default" {
            return Err(invalid_padding());
        }
        let seg = st.modes[mi].seg;
        let mut padded = data.clone();
        let faux = seg - py_mod(data.len(), seg);
        for _ in 0..faux {
            padded.push(0);
        }
        let out = crypt(tb, mut st, mi, encrypt, padded)?;
        return Ok(slice(out, 0, data.len()));
    }
    if padding != "none" and padding != "default" {
        return Err(invalid_padding());
    }
    crypt(tb, mut st, mi, encrypt, data)
}

// BlockFeeder.feed(data); None is the final call.
fn feed(tb: ref Tables, st: mut ref State, fi: i64, data: ref Option[Vec[i64]]) -> Result[Vec[i64], Exc] {
    if st.feeders[fi].done {
        return Err(exc("ValueError", "already finished feeder"));
    }
    let mi = st.feeders[fi].mode;
    let encrypt = st.feeders[fi].encrypt;
    match data {
        None => {
            // Finalize; process the spare bytes we were keeping
            let buf = st.feeders[fi].buf.clone();
            let padding = st.feeders[fi].padding.clone();
            let result = final_block(tb, mut st, mi, encrypt, buf, padding)?;
            st.feeders[fi].done = true;
            st.feeders[fi].buf = Vec.new();
            return Ok(result);
        }
        Some(d) => {
            push_all(mut st.feeders[fi].buf, d);
        }
    }
    // We keep 16 bytes around so we can determine padding
    let mut result: Vec[i64] = Vec.new();
    while st.feeders[fi].buf.len() > 16 {
        let n = can_consume(st.modes[mi], st.feeders[fi].buf.len() - 16);
        if n == 0 {
            break;
        }
        let chunk = slice(st.feeders[fi].buf, 0, n);
        let out = crypt(tb, mut st, mi, encrypt, chunk)?;
        push_all(mut result, out);
        let buf = st.feeders[fi].buf.clone();
        st.feeders[fi].buf = slice(buf, n, buf.len());
    }
    Ok(result)
}

fn new_feeder(st: mut ref State, mi: i64, encrypt: bool, padding: ref String) -> i64 {
    st.feeders.push(Feeder { mode: mi, encrypt: encrypt, buf: Vec.new(), done: false, padding: padding.clone() });
    st.feeders.len() - 1
}

// ------------------------------------------------------------ files

fn not_found(p: ref String) -> Exc {
    Exc { kind: "FileNotFoundError".to_string(), msg: f"[Errno 2] No such file or directory: 'data/{p}'" }
}

fn read_file(p: ref String) -> Result[Vec[i64], Exc] {
    match fs.read_bytes(f"data/{p}") {
        Ok(b) => {
            let mut out: Vec[i64] = Vec.new();
            for x in b.iter() {
                out.push(*x as i64);
            }
            Ok(out)
        }
        Err(_) => Err(not_found(p)),
    }
}

fn to_u8(b: ref Vec[i64]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for x in b {
        out.push(*x as u8);
    }
    out
}

fn write_file(p: ref String, b: ref Vec[i64]) -> Result[(), Exc] {
    match fs.write_bytes(f"data/{p}", to_u8(b)) {
        Ok(_) => Ok(()),
        Err(e) => Err(Exc { kind: "OSError".to_string(), msg: f"{e}" }),
    }
}

fn io_err(e: IoError) -> Exc {
    Exc { kind: "OSError".to_string(), msg: f"{e}" }
}

// encrypt_stream / decrypt_stream: the mode under an Encrypter (or a
// Decrypter), fed in_stream.read(block_size) until it comes back empty,
// each result written to out_stream as it comes, then feed().
fn stream(tb: ref Tables, st: mut ref State, mi: i64, encrypt: bool, src: ref String, dst: ref String, block: i64, padding: ref String) -> Result[(), Exc] {
    let fin = match File.open(f"data/{src}") {
        Ok(h) => h,
        Err(_) => {
            return Err(not_found(src));
        }
    };
    let fout = match File.create(f"data/{dst}") {
        Ok(h) => h,
        Err(e) => {
            return Err(io_err(e));
        }
    };
    let fi = new_feeder(mut st, mi, encrypt, padding);
    loop {
        // BufferedReader.read(n): up to n bytes, or all that is left for a
        // negative n, or nothing for 0
        let mut chunk: Vec[i64] = Vec.new();
        while block != 0 {
            let room = if block < 0 { 8192 } else { block - chunk.len() };
            if room == 0 {
                break;
            }
            let mut buf: Vec[u8] = Vec.new();
            for _ in 0..room {
                buf.push(0u8);
            }
            let n = match fin.read(mut buf[0..room]) {
                Ok(n) => n,
                Err(e) => {
                    return Err(io_err(e));
                }
            };
            if n == 0 {
                break;
            }
            let mut k = 0;
            while k < n {
                chunk.push(buf[k] as i64);
                k += 1;
            }
        }
        if chunk.len() == 0 {
            break;
        }
        let converted = feed(tb, mut st, fi, Some(chunk))?;
        write_all(fout, converted)?;
    }
    let converted = feed(tb, mut st, fi, None)?;
    write_all(fout, converted)?;
    Ok(())
}

fn write_all(f: ref File, b: ref Vec[i64]) -> Result[(), Exc] {
    let bytes = to_u8(b);
    let mut off = 0;
    while off < bytes.len() {
        let n = match f.write(bytes[off..bytes.len()]) {
            Ok(n) => n,
            Err(e) => {
                return Err(io_err(e));
            }
        };
        off += n;
    }
    Ok(())
}

fn compare(a: ref String, b: ref String) -> Result[String, Exc] {
    let x = read_file(a)?;
    let y = read_file(b)?;
    if xor_same(x, y) {
        return Ok(f"same ({x.len()} bytes)");
    }
    let mut n = 0;
    while n < x.len() and n < y.len() and x[n] == y[n] {
        n += 1;
    }
    Ok(f"differ at byte {n} ({x.len()} and {y.len()} bytes)")
}

// The files data/plain/ holds, as mk.py writes them.
fn write_plain_files() -> Result[(), Exc] {
    if let Err(e) = fs.create_dir_all("data/plain".to_string()) {
        return Err(io_err(e));
    }
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(io_err(e));
    }
    for line in split_on(plain_files_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let body = if f[1] == "-" { Vec.new() } else { hex_bytes(f[1]) };
        write_file(f"plain/{f[0]}", body)?;
    }
    Ok(())
}

// ------------------------------------------------------------ the jobs

fn bind(m: mut ref Map[String, i64], name: ref String, ix: i64) {
    m.insert(name.clone(), ix);
}

// One step of jobs.tsv; what it returns goes to `out`, one "  -> " line
// each, and an exception is the step's last line.
fn step(tb: ref Tables, st: mut ref State, f: ref Vec[String], out: mut ref Vec[String]) -> Result[(), Exc] {
    let op = f[0].clone();
    if op == "mode" {
        let m = make_mode(tb, mut st, f)?;
        st.modes.push(m);
        bind(mut st.mode_ix, f[1], st.modes.len() - 1);
        out.push("ok".to_string());
    } else if op == "counter" {
        st.counters.push(counter_bytes(f[2]));
        bind(mut st.counter_ix, f[1], st.counters.len() - 1);
        out.push("ok".to_string());
    } else if op == "value" {
        let c = lookup(st.counter_ix, f[1]);
        out.push(list_repr(st.counters[c]));
    } else if op == "aes" {
        let a = aes_new(tb, val(f[1]))?;
        let r = aes_block(tb, a, f[2] == "encrypt", hex_bytes(f[3]))?;
        out.push(list_repr(r));
    } else if op == "encrypt" or op == "decrypt" {
        let mi = lookup(st.mode_ix, f[1]);
        let r = crypt(tb, mut st, mi, op == "encrypt", hex_bytes(f[2]))?;
        out.push(show(r));
    } else if op == "feeder" {
        let mi = lookup(st.mode_ix, f[2]);
        let padding = if f.len() > 4 { f[4].clone() } else { "default".to_string() };
        let fi = new_feeder(mut st, mi, f[3] == "encrypter", padding);
        bind(mut st.feeder_ix, f[1], fi);
        out.push("ok".to_string());
    } else if op == "feed" {
        let fi = lookup(st.feeder_ix, f[1]);
        let data: Option[Vec[i64]] = if f.len() > 2 { Some(hex_bytes(f[2])) } else { None };
        let r = feed(tb, mut st, fi, data)?;
        out.push(show(r));
    } else if op == "pipe" {
        let fe = lookup(st.feeder_ix, f[1]);
        let fd = lookup(st.feeder_ix, f[2]);
        let data = hex_bytes(f[3]);
        let mut c = feed(tb, mut st, fe, Some(data.clone()))?;
        let c2 = feed(tb, mut st, fe, None)?;
        push_all(mut c, c2);
        out.push(f"ciphertext {show(c)}");
        let mut p = feed(tb, mut st, fd, Some(c))?;
        let p2 = feed(tb, mut st, fd, None)?;
        push_all(mut p, p2);
        out.push(f"plaintext {show(p)}");
        out.push(if xor_same(p, data) { "same".to_string() } else { "differs".to_string() });
    } else if op == "roundtrip" {
        let a = lookup(st.mode_ix, f[1]);
        let b = lookup(st.mode_ix, f[2]);
        let data = hex_bytes(f[3]);
        let c = crypt(tb, mut st, a, true, data)?;
        out.push(f"ciphertext {show(c)}");
        let p = crypt(tb, mut st, b, false, c)?;
        out.push(f"plaintext {show(p)}");
        out.push(if xor_same(p, data) { "same".to_string() } else { "differs".to_string() });
    } else if op == "stream" {
        let mi = lookup(st.mode_ix, f[2]);
        let block = int_of(f[5]);
        let padding = if f.len() > 6 { f[6].clone() } else { "default".to_string() };
        stream(tb, mut st, mi, f[1] == "encrypt", f[3], f[4], block, padding)?;
        out.push(show(read_file(f[4])?));
    } else if op == "cut" {
        let b = read_file(f[1])?;
        let n = int_of(f[3]);
        let cut = slice(b, 0, n);
        write_file(f[2], cut)?;
        out.push(show(cut));
    } else if op == "compare" {
        out.push(compare(f[1], f[2])?);
    } else if op == "size" {
        out.push(show(read_file(f[1])?));
    }
    Ok(())
}

fn xor_same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut k = 0;
    while k < a.len() {
        if a[k] != b[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn main() {
    if let Err(e) = write_plain_files() {
        eprintln(f"{e.kind}: {e.msg}");
        return;
    }
    let tb = load_tables();
    let mut st = State {
        modes: Vec.new(),
        counters: Vec.new(),
        feeders: Vec.new(),
        mode_ix: Map.new(),
        counter_ix: Map.new(),
        feeder_ix: Map.new(),
    };
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, '\t');
        if f[0] == "job" {
            println(f"== {f[1]}");
            continue;
        }
        let mut shown = String.new();
        let mut k = 0;
        while k < f.len() {
            if k > 0 {
                shown.push(' ');
            }
            if f[k].len() == 0 {
                shown.push_str("''");
            } else {
                shown.push_str(f[k]);
            }
            k += 1;
        }
        println(f"> {shown}");
        let mut out: Vec[String] = Vec.new();
        let r = step(tb, mut st, f, mut out);
        for x in out.iter() {
            println(f"  -> {x}");
        }
        if let Err(e) = r {
            println(f"  error {e.kind}: {e.msg}");
        }
    }
}

