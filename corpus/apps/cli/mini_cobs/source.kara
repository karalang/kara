// mini_cobs — a port of the byte-stuffing codecs of cobs 1.2.2 (MIT, Craig
// McQueen). Consistent Overhead Byte Stuffing (COBS) encodes an arbitrary byte
// string into one with no zero bytes, adding a predictable, bounded overhead,
// so a zero byte can be used as an unambiguous packet delimiter on a serial or
// network link. COBS/R ("Reduced") is the same framing with one fewer overhead
// byte in the common case, by folding the last data byte into the final length
// code when it is large enough.
//
// Each job is `<op>\t<hex>`:
//   cobs_enc  / cobsr_enc  <hex payload>  → the encoded frame as hex;
//   cobs_dec  / cobsr_dec  <hex frame>    → `ok <hex>` (the decoded payload) or
//                                           `err <message>` on a malformed frame.
//
// Both encoders and both decoders follow the vendored pure-Python
// implementation statement for statement, including the run-boundary length
// codes (0xFD for COBS, 0xFE for COBS/R) and the two DecodeError messages
// ("zero byte found in input" / "not enough input bytes for length code").
// jobs_text() carries data/jobs.tsv verbatim; the decode inputs there are the
// frames the vendored encoder produced, plus a few deliberately broken frames.
//
// Scope: the byte codecs themselves. The library's incremental / chunked
// wrappers and its str-input TypeErrors are out of scope (see README).

struct DecRes {
    ok: bool,
    out: Vec[i64],
    err: String,
}

fn str_bytes(s: Str) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() {
        v.push(b as i64);
    }
    v
}

fn split_fields(line: Str, sepb: i64) -> Vec[String] {
    let v = str_bytes(line);
    let n = v.len();
    let mut fields: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == sepb {
            fields.push(line.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    fields
}

fn hex_val(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 102 {
        return c - 97 + 10;
    }
    c - 65 + 10 // uppercase A-F (unused here but complete)
}

fn hex_to_bytes(s: Str) -> Vec[i64] {
    let b = str_bytes(s);
    let mut v: Vec[i64] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        v.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i = i + 2;
    }
    v
}

fn bytes_to_hex(v: Vec[i64]) -> String {
    let tbl = "0123456789abcdef".to_string();
    let mut o = String.new();
    let mut i = 0;
    while i < v.len() {
        let hi = (v[i] >> 4) & 15;
        let lo = v[i] & 15;
        o.push_str(tbl.substring(hi, hi + 1));
        o.push_str(tbl.substring(lo, lo + 1));
        i = i + 1;
    }
    o
}

// Consistent Overhead Byte Stuffing — encode.
fn cobs_encode(src: Vec[i64]) -> Vec[i64] {
    let n = src.len();
    let mut out: Vec[i64] = Vec.new();
    let mut final_zero = true;
    let mut idx = 0;
    let mut search_start = 0;
    while idx < n {
        let c = src[idx];
        if c == 0 {
            final_zero = true;
            out.push(idx - search_start + 1);
            let mut k = search_start;
            while k < idx {
                out.push(src[k]);
                k = k + 1;
            }
            search_start = idx + 1;
        } else {
            if idx - search_start == 253 {
                final_zero = false;
                out.push(255);
                let mut k = search_start;
                while k <= idx {
                    out.push(src[k]);
                    k = k + 1;
                }
                search_start = idx + 1;
            }
        }
        idx = idx + 1;
    }
    if idx != search_start or final_zero {
        out.push(idx - search_start + 1);
        let mut k = search_start;
        while k < idx {
            out.push(src[k]);
            k = k + 1;
        }
    }
    out
}

// Consistent Overhead Byte Stuffing — decode.
fn cobs_decode(src: Vec[i64]) -> DecRes {
    let n = src.len();
    let mut out: Vec[i64] = Vec.new();
    let mut idx = 0;
    if n > 0 {
        while true {
            let length = src[idx];
            if length == 0 {
                return DecRes { ok: false, out: Vec.new(), err: "zero byte found in input".to_string() };
            }
            idx = idx + 1;
            let end = idx + length - 1;
            let lim = if end < n { end } else { n };
            let mut k = idx;
            while k < lim {
                if src[k] == 0 {
                    return DecRes { ok: false, out: Vec.new(), err: "zero byte found in input".to_string() };
                }
                out.push(src[k]);
                k = k + 1;
            }
            idx = end;
            if idx > n {
                return DecRes { ok: false, out: Vec.new(), err: "not enough input bytes for length code".to_string() };
            }
            if idx < n {
                if length < 255 {
                    out.push(0);
                }
            } else {
                break;
            }
        }
    }
    DecRes { ok: true, out: out, err: "".to_string() }
}

// Consistent Overhead Byte Stuffing / Reduced — encode.
fn cobsr_encode(src: Vec[i64]) -> Vec[i64] {
    let n = src.len();
    let mut out: Vec[i64] = Vec.new();
    let mut idx = 0;
    let mut search_start = 0;
    while idx < n {
        if idx - search_start == 254 {
            out.push(255);
            let mut k = search_start;
            while k < idx {
                out.push(src[k]);
                k = k + 1;
            }
            search_start = idx;
        }
        if src[idx] == 0 {
            out.push(idx - search_start + 1);
            let mut k = search_start;
            while k < idx {
                out.push(src[k]);
                k = k + 1;
            }
            search_start = idx + 1;
        }
        idx = idx + 1;
    }
    let final_byte_value = if n == 0 { 0 } else { src[n - 1] };
    let length_value = idx - search_start + 1;
    if final_byte_value < length_value {
        // Same as plain COBS.
        out.push(length_value);
        let mut k = search_start;
        while k < idx {
            out.push(src[k]);
            k = k + 1;
        }
    } else {
        // COBS/R: the length code is the final byte, which is then dropped from
        // the data sequence.
        out.push(final_byte_value);
        let mut k = search_start;
        while k < idx - 1 {
            out.push(src[k]);
            k = k + 1;
        }
    }
    out
}

// Consistent Overhead Byte Stuffing / Reduced — decode.
fn cobsr_decode(src: Vec[i64]) -> DecRes {
    let n = src.len();
    let mut out: Vec[i64] = Vec.new();
    let mut idx = 0;
    if n > 0 {
        while true {
            let length = src[idx];
            if length == 0 {
                return DecRes { ok: false, out: Vec.new(), err: "zero byte found in input".to_string() };
            }
            idx = idx + 1;
            let end = idx + length - 1;
            let lim = if end < n { end } else { n };
            let mut k = idx;
            while k < lim {
                if src[k] == 0 {
                    return DecRes { ok: false, out: Vec.new(), err: "zero byte found in input".to_string() };
                }
                out.push(src[k]);
                k = k + 1;
            }
            idx = end;
            if idx > n {
                out.push(length);
                break;
            } else {
                if idx < n {
                    if length < 255 {
                        out.push(0);
                    }
                } else {
                    break;
                }
            }
        }
    }
    DecRes { ok: true, out: out, err: "".to_string() }
}

fn run_decode(r: DecRes) -> String {
    let mut o = String.new();
    if r.ok {
        o.push_str("ok ");
        o.push_str(bytes_to_hex(r.out));
    } else {
        o.push_str("err ");
        o.push_str(r.err.clone());
    }
    o
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let f = split_fields(line, 9);
                let op = f[0].clone();
                let hexstr = f[1].clone();
                out.push_str("== ");
                out.push_str(op.clone());
                out.push_str(" ");
                out.push_str(hexstr.clone());
                out.push_str("\n");
                let src = hex_to_bytes(hexstr.clone());
                if op == "cobs_enc" {
                    out.push_str(bytes_to_hex(cobs_encode(src)));
                } else {
                    if op == "cobsr_enc" {
                        out.push_str(bytes_to_hex(cobsr_encode(src)));
                    } else {
                        if op == "cobs_dec" {
                            out.push_str(run_decode(cobs_decode(src)));
                        } else {
                            out.push_str(run_decode(cobsr_decode(src)));
                        }
                    }
                }
                out.push_str("\n");
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

