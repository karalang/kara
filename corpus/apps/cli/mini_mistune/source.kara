fn punctuation() -> Str {
    "[!\"\\#\\$%\\&'\\(\\)\\*\\+,\\-\\./:;<=>\\?@\\[\\\\\\]\\^_`\\{\\|\\}\\~]"
}
// ------------------------------------------------------------ the context

// What every Markdown instance shares: the compiled patterns, the HTML5
// entity table and the parse environments. A Python BlockState's `env`
// is a dict that child states share; here the dicts live in `envs` and
// a state holds an index.
struct Ctx {
    rx: Rx,
    p: Pats,
    ents: Map[String, String],
    envs: Vec[Env],
}

struct Env {
    // ref_links: unikey -> {'url', 'label', 'title'}, in insertion order
    ref_links: Vec[(Vec[i64], V)],
    // whether the dict has a 'ref_links' key at all ({} has none)
    has_ref_links: bool,
    ref_footnotes: Vec[(Vec[i64], Vec[i64])],
    footnotes: Vec[Vec[i64]],
    ref_abbrs: Vec[(Vec[i64], Vec[i64])],
    abbrs_re: i64,
    file: Option[Vec[i64]],
    toc_items: Option[Vec[(i64, Vec[i64], Vec[i64])]],
    inline_images: Vec[V],
}

fn new_env(with_links: bool) -> Env {
    Env {
        ref_links: Vec.new(),
        has_ref_links: with_links,
        ref_footnotes: Vec.new(),
        footnotes: Vec.new(),
        ref_abbrs: Vec.new(),
        abbrs_re: -1,
        file: None,
        toc_items: None,
        inline_images: Vec.new(),
    }
}

fn new_ctx() -> Ctx {
    let mut rx = new_rx();
    let p = make_pats(mut rx);
    Ctx { rx: rx, p: p, ents: html5_entities(), envs: Vec.new() }
}

fn add_env(cx: mut ref Ctx, with_links: bool) -> i64 {
    cx.envs.push(new_env(with_links));
    cx.envs.len() - 1
}

fn lookup(pairs: ref Vec[(Vec[i64], Vec[i64])], key: ref Vec[i64]) -> Option[Vec[i64]] {
    for (k, v) in pairs.iter() {
        if same(k, key) {
            return Some(v.clone());
        }
    }
    None
}

fn has_key(pairs: ref Vec[(Vec[i64], Vec[i64])], key: ref Vec[i64]) -> bool {
    for (k, _) in pairs.iter() {
        if same(k, key) {
            return true;
        }
    }
    false
}

fn ref_link(cx: ref Ctx, env: i64, key: ref Vec[i64]) -> Option[V] {
    for (k, v) in cx.envs[env].ref_links.iter() {
        if same(k, key) {
            return Some(v.clone());
        }
    }
    None
}

// -------------------------------------------------------------- util.py

fn expand_leading_tab(cx: mut ref Ctx, text: ref Vec[i64], width: i64) -> Vec[i64] {
    let mut t = text.clone();
    let found = rx_all(mut cx.rx, cx.p.expand_tab, mut t);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        let s = group_or_empty(t, f, 1);
        push_all(mut out, s);
        push_all(mut out, spaces(width - s.len()));
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

fn expand_tab(cx: mut ref Ctx, text: ref Vec[i64]) -> Vec[i64] {
    rx_sub_g1(mut cx.rx, cx.p.expand_tab, text, spaces(4))
}

fn escape(s: ref Vec[i64], quote: bool) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if c == 38 {
            push_str(mut out, "&amp;");
        } else if c == 60 {
            push_str(mut out, "&lt;");
        } else if c == 62 {
            push_str(mut out, "&gt;");
        } else if c == 34 and quote {
            push_str(mut out, "&quot;");
        } else {
            out.push(c);
        }
    }
    out
}

fn esc(s: ref Vec[i64]) -> Vec[i64] {
    escape(s, true)
}

fn is_quote_safe(c: i64, safe: ref Vec[i64]) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95 or c == 46 or c == 45 or c == 126 or has_char(safe, c)
}

// urllib.parse.quote(s, safe): UTF-8, then %XX for each byte that is not
// safe.
fn quote(s: ref Vec[i64], safe: Str) -> Vec[i64] {
    let sf = u(safe);
    let digits = u("0123456789ABCDEF");
    let mut out: Vec[i64] = Vec.new();
    for b in to_string(s).bytes() {
        let c = b as i64;
        if c < 128 and is_quote_safe(c, sf) {
            out.push(c);
        } else {
            out.push(37);
            out.push(digits[c >> 4]);
            out.push(digits[c & 15]);
        }
    }
    out
}

fn escape_url(cx: mut ref Ctx, link: ref Vec[i64]) -> Vec[i64] {
    let safe = ":/?#@!$&()*+,;=%";
    esc(quote(unescape(mut cx, link), safe))
}

fn safe_entity(cx: mut ref Ctx, s: ref Vec[i64]) -> Vec[i64] {
    esc(unescape(mut cx, s))
}

fn unikey(s: ref Vec[i64]) -> Vec[i64] {
    let key = strip(join(split_ws(s), " "));
    py_upper(py_lower(key))
}

// html._replace_charref, for the text after '&'.
fn replace_charref(cx: ref Ctx, s: ref Vec[i64], out: mut ref Vec[i64]) {
    if s[0] == 35 {
        let hex = s[1] == 120 or s[1] == 88;
        let digits = rstrip_of(tail(s, if hex { 2 } else { 1 }), ";");
        let mut num = 0;
        for c in digits {
            let d = if c >= 48 and c <= 57 { c - 48 } else if c >= 97 { c - 87 } else { c - 55 };
            num = num * (if hex { 16 } else { 10 }) + d;
            if num > 0x10FFFF {
                num = 0x110000;
            }
        }
        if let Some(v) = invalid_ref(num) {
            out.push(v);
            return;
        }
        if (num >= 0xD800 and num <= 0xDFFF) or num > 0x10FFFF {
            out.push(0xFFFD);
            return;
        }
        if invalid_code(num) {
            return;
        }
        out.push(num);
        return;
    }
    let whole = to_string(s);
    if let Some(v) = cx.ents.get(whole.clone()) {
        push_all(mut out, us(v));
        return;
    }
    let mut x = s.len() - 1;
    while x > 1 {
        if let Some(v) = cx.ents.get(to_string(slice(s, 0, x))) {
            push_all(mut out, us(v));
            push_all(mut out, tail(s, x));
            return;
        }
        x -= 1;
    }
    out.push(38);
    push_all(mut out, s);
}

fn invalid_ref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn invalid_code(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

// util.unescape: html.unescape with CommonMark's references, which need
// their semicolon.
fn unescape(cx: mut ref Ctx, s: ref Vec[i64]) -> Vec[i64] {
    if not has_char(s, 38) {
        return s.clone();
    }
    let mut t = s.clone();
    let found = rx_all(mut cx.rx, cx.p.charref, mut t);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        replace_charref(cx, group_or_empty(t, f, 1), mut out);
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

fn striptags(cx: mut ref Ctx, s: ref Vec[i64]) -> Vec[i64] {
    rx_sub(mut cx.rx, cx.p.striptags, s, "")
}

fn strip_end(cx: mut ref Ctx, s: ref Vec[i64]) -> Vec[i64] {
    rx_sub(mut cx.rx, cx.p.strip_end, s, "\n")
}

// ----------------------------------------------------------- helpers.py

fn unescape_char(cx: mut ref Ctx, text: ref Vec[i64]) -> Vec[i64] {
    rx_sub_g1(mut cx.rx, cx.p.escape_char, text, Vec.new())
}

// parse_link_text: the text up to the matching ']', and the position
// after it.
fn parse_link_text(cx: mut ref Ctx, src: mut ref Vec[i64], pos0: i64) -> Option[(Vec[i64], i64)] {
    let mut level = 1;
    let mut found = false;
    let start_pos = pos0;
    let mut pos = pos0;
    while pos < src.len() {
        match rx_search(mut cx.rx, cx.p.inline_square_bracket, mut src, pos) {
            Some(m) => {
                pos = m.end;
                // marker == ']': the whole match, backslashes and all
                if m.end - m.start == 1 and src[m.start] == 93 {
                    level -= 1;
                    if level == 0 {
                        found = true;
                        break;
                    }
                } else {
                    level += 1;
                }
            }
            None => break,
        }
    }
    if found {
        return Some((slice(src, start_pos, pos - 1), pos));
    }
    None
}

fn parse_link_label(cx: mut ref Ctx, src: mut ref Vec[i64], start_pos: i64) -> Option[(Vec[i64], i64)] {
    match rx_match(mut cx.rx, cx.p.inline_link_label, mut src, start_pos) {
        Some(m) => Some((slice(src, m.start, m.end - 1), m.end)),
        None => None,
    }
}

fn parse_link_href(cx: mut ref Ctx, src: mut ref Vec[i64], start_pos0: i64, block: bool) -> Option[(Vec[i64], i64)] {
    let mut start_pos = start_pos0;
    if let Some(m) = rx_match(mut cx.rx, cx.p.link_bracket_start, mut src, start_pos) {
        start_pos = m.end - 1;
        return match rx_match(mut cx.rx, cx.p.link_bracket, mut src, start_pos) {
            Some(m2) => Some((group_or_empty(src, m2, 1), m2.end)),
            None => None,
        };
    }
    let id = if block { cx.p.link_href_block } else { cx.p.link_href_inline };
    let m = match rx_match(mut cx.rx, id, mut src, start_pos) {
        Some(m) => m,
        None => return None,
    };
    let end_pos = m.end;
    let href = group_or_empty(src, m, 1);
    if block and href.len() > 0 and src[end_pos - 1] == href[href.len() - 1] {
        return Some((href, end_pos));
    }
    Some((href, end_pos - 1))
}

fn parse_link_title(cx: mut ref Ctx, src: ref Vec[i64], start_pos: i64, max_pos: i64) -> Option[(Vec[i64], i64)] {
    match rx_run_end(mut cx.rx, cx.p.link_title, src, start_pos, max_pos, 1) {
        Some(m) => {
            let t = group_or_empty(src, m, 1);
            let title = unescape_char(mut cx, sl(t, 1, -1));
            Some((title, m.end))
        }
        None => None,
    }
}

// parse_link: the attrs and the position after the ')'.
fn parse_link(cx: mut ref Ctx, src: mut ref Vec[i64], pos: i64) -> Option[(V, i64)] {
    let (href, href_pos) = match parse_link_href(mut cx, mut src, pos, false) {
        Some(p) => p,
        None => return None,
    };
    let n = src.len();
    let title = parse_link_title(mut cx, src, href_pos, n);
    let next_pos = match title {
        Some((_, tp)) => if tp != 0 { tp } else { href_pos },
        None => href_pos,
    };
    let m = match rx_match(mut cx.rx, cx.p.paren_end, mut src, next_pos) {
        Some(m) => m,
        None => return None,
    };
    let href2 = unescape_char(mut cx, href);
    let mut attrs = dict();
    put(mut attrs, "url", V.S(escape_url(mut cx, href2)));
    if let Some((t, _)) = title {
        if t.len() > 0 {
            put(mut attrs, "title", V.S(t));
        }
    }
    Some((attrs, m.end))
}
// ------------------------------------------------------------ core.py

struct BState {
    src: Vec[i64],
    tokens: Vec[V],
    cursor: i64,
    cursor_max: i64,
    list_tight: bool,
    // how many parents: BlockState.depth()
    depth: i64,
    env: i64,
}

fn new_bstate(env: i64) -> BState {
    BState { src: Vec.new(), tokens: Vec.new(), cursor: 0, cursor_max: 0, list_tight: true, depth: 0, env: env }
}

fn child_state(state: ref BState, src: own Vec[i64]) -> BState {
    let n = src.len();
    BState { src: src, tokens: Vec.new(), cursor: 0, cursor_max: n, list_tight: true, depth: state.depth + 1, env: state.env }
}

fn process(state: mut ref BState, src: own Vec[i64]) {
    state.cursor_max = src.len();
    state.src = src;
}

fn find_line_end(cx: mut ref Ctx, state: mut ref BState) -> i64 {
    match rx_search(mut cx.rx, cx.p.line_end, mut state.src, state.cursor) {
        Some(m) => m.end,
        None => state.cursor_max,
    }
}

fn get_text(state: ref BState, end_pos: i64) -> Vec[i64] {
    sl(state.src, state.cursor, end_pos)
}

fn last_is(state: ref BState, kind: Str) -> bool {
    state.tokens.len() > 0 and is_type(state.tokens[state.tokens.len() - 1], kind)
}

fn prepend_token(state: mut ref BState, token: own V) {
    let at = if state.tokens.len() == 0 { 0 } else { state.tokens.len() - 1 };
    state.tokens.insert(at, token);
}

fn append_text(t: mut ref V, more: ref Vec[i64]) {
    let mut text = get_s(t, "text");
    push_all(mut text, more);
    put(mut t, "text", V.S(text));
}

fn add_paragraph(state: mut ref BState, text: ref Vec[i64]) {
    if last_is(state, "paragraph") {
        let n = state.tokens.len();
        append_text(mut state.tokens[n - 1], text);
    } else {
        state.tokens.push(tok_t("paragraph", text.clone()));
    }
}

// append_paragraph: -1 when the last token is not a paragraph.
fn append_paragraph(cx: mut ref Ctx, state: mut ref BState) -> i64 {
    if last_is(state, "paragraph") {
        let pos = find_line_end(mut cx, mut state);
        let text = get_text(state, pos);
        let n = state.tokens.len();
        append_text(mut state.tokens[n - 1], text);
        return pos;
    }
    -1
}

struct IState {
    env: i64,
    src: Vec[i64],
    tokens: Vec[V],
    in_image: bool,
    in_link: bool,
    in_emphasis: bool,
    in_strong: bool,
}

fn new_istate(env: i64, src: own Vec[i64]) -> IState {
    IState { env: env, src: src, tokens: Vec.new(), in_image: false, in_link: false, in_emphasis: false, in_strong: false }
}

// InlineState.copy() with a new src.
fn copy_state(state: ref IState, src: own Vec[i64]) -> IState {
    IState {
        env: state.env,
        src: src,
        tokens: Vec.new(),
        in_image: state.in_image,
        in_link: state.in_link,
        in_emphasis: state.in_emphasis,
        in_strong: state.in_strong,
    }
}

// --------------------------------------------------------- the instance

// A Markdown instance: its block and inline parsers, the plugins'
// hooks, the directives, and the renderer.
struct Md {
    bspec: Vec[(String, Vec[i64])],
    brules: Vec[String],
    bmethods: Vec[(String, String)],
    block_quote_rules: Vec[String],
    list_rules: Vec[String],
    max_nested_level: i64,
    ispec: Vec[(String, Vec[i64])],
    irules: Vec[String],
    imethods: Vec[String],
    hard_wrap: bool,
    abbr_text: bool,
    // directive type -> (style, plugin)
    directives: Vec[(String, String, String)],
    fenced: bool,
    rst: bool,
    before_render: Vec[String],
    after_render: Vec[String],
    toc_hook: Option[(i64, i64)],
    // html, markdown, rst or ast
    renderer: String,
    escape: bool,
    rnames: Vec[String],
    sc: Vec[(String, i64)],
}

fn spec_of(spec: ref Vec[(String, Vec[i64])], name: ref String) -> Option[Vec[i64]] {
    for (k, p) in spec.iter() {
        if k == name {
            return Some(p.clone());
        }
    }
    None
}

fn set_spec(spec: mut ref Vec[(String, Vec[i64])], name: Str, pattern: own Vec[i64]) {
    let mut i = 0;
    while i < spec.len() {
        if spec[i].0 == name {
            spec[i].1 = pattern;
            return;
        }
        i += 1;
    }
    spec.push((name.to_string(), pattern));
}

fn has_rule(rules: ref Vec[String], name: Str) -> bool {
    for r in rules.iter() {
        if r == name {
            return true;
        }
    }
    false
}

// Parser.insert_rule
fn insert_rule(rules: mut ref Vec[String], name: Str, before: Str) {
    if before.len() > 0 {
        let mut i = 0;
        while i < rules.len() {
            if rules[i] == before {
                rules.insert(i, name.to_string());
                return;
            }
            i += 1;
        }
    }
    rules.push(name.to_string());
}

fn remove_rule(rules: ref Vec[String], name: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut gone = false;
    for r in rules.iter() {
        if not gone and r == name {
            gone = true;
        } else {
            out.push(r.clone());
        }
    }
    out
}

fn set_method(methods: mut ref Vec[(String, String)], name: Str, handler: Str) {
    let mut i = 0;
    while i < methods.len() {
        if methods[i].0 == name {
            methods[i].1 = handler.to_string();
            return;
        }
        i += 1;
    }
    methods.push((name.to_string(), handler.to_string()));
}

fn method_of(methods: ref Vec[(String, String)], name: ref String) -> String {
    for (k, h) in methods.iter() {
        if k == name {
            return h.clone();
        }
    }
    name.clone()
}

// BlockParser.register
fn block_register(md: mut ref Md, name: Str, pattern: Option[Vec[i64]], handler: Str, before: Str) {
    set_method(mut md.bmethods, name, handler);
    if let Some(p) = pattern {
        set_spec(mut md.bspec, name, p.clone());
    }
    if not has_rule(md.brules, name) {
        insert_rule(mut md.brules, name, before);
    }
}

fn inline_register(md: mut ref Md, name: Str, pattern: own Vec[i64], before: Str) {
    md.imethods.push(name.to_string());
    set_spec(mut md.ispec, name, pattern);
    if not has_rule(md.irules, name) {
        insert_rule(mut md.irules, name, before);
    }
}

fn new_md(renderer: Str, escape: bool, hard_wrap: bool) -> Md {
    let mut md = Md {
        bspec: block_spec(),
        brules: block_default_rules(),
        bmethods: Vec.new(),
        block_quote_rules: block_default_rules(),
        list_rules: block_default_rules(),
        max_nested_level: 6,
        ispec: inline_spec(),
        irules: inline_default_rules(),
        imethods: Vec.new(),
        hard_wrap: hard_wrap,
        abbr_text: false,
        directives: Vec.new(),
        fenced: false,
        rst: false,
        before_render: Vec.new(),
        after_render: Vec.new(),
        toc_hook: None,
        renderer: renderer.to_string(),
        escape: escape,
        rnames: Vec.new(),
        sc: Vec.new(),
    };
    if hard_wrap {
        set_spec(mut md.ispec, "linebreak", u(pat_hard_linebreak_rule()));
    } else {
        md.irules.push("softbreak".to_string());
    }
    let rules = md.irules.clone();
    for r in rules.iter() {
        md.imethods.push(r.clone());
    }
    md
}

fn has_imethod(md: ref Md, name: ref String) -> bool {
    for m in md.imethods.iter() {
        if m == name {
            return true;
        }
    }
    false
}

fn html_renderer(md: ref Md) -> bool {
    md.renderer == "html"
}

fn render_register(md: mut ref Md, name: Str) {
    if html_renderer(md) {
        md.rnames.push(name.to_string());
    }
}

// Parser.compile_sc: the rules joined into one alternation, one group
// per rule, cached by the rule names.
fn compile_sc(cx: mut ref Ctx, md: mut ref Md, block: bool, rules: ref Vec[String]) -> i64 {
    let mut key = if block { "b".to_string() } else { "i".to_string() };
    for r in rules.iter() {
        key.push_str("|");
        key.push_str(r);
    }
    for (k, id) in md.sc.iter() {
        if *k == key {
            return id;
        }
    }
    let mut regex: Vec[i64] = Vec.new();
    let mut first = true;
    for r in rules.iter() {
        let p = if block { spec_of(md.bspec, r) } else { spec_of(md.ispec, r) };
        if not first {
            regex.push(124);
        }
        first = false;
        push_str(mut regex, "(?P<");
        push_all(mut regex, us(r));
        regex.push(62);
        push_all(mut regex, p.unwrap_or(Vec.new()));
        regex.push(41);
    }
    let id = rx_id_v(mut cx.rx, regex, if block { 8 } else { 0 });
    md.sc.push((key, id));
    id
}
// ----------------------------------------------------- block_parser.py

fn tags_has(tags: ref Vec[String], name: ref Vec[i64]) -> bool {
    let n = to_string(name);
    for t in tags.iter() {
        if *t == n {
            return true;
        }
    }
    false
}

// BlockParser.parse
fn block_parse(cx: mut ref Ctx, md: mut ref Md, state: mut ref BState, rules: ref Vec[String]) {
    let sc = compile_sc(mut cx, mut md, true, rules);
    while state.cursor < state.cursor_max {
        let m = match rx_search(mut cx.rx, sc, mut state.src, state.cursor) {
            Some(m) => m,
            None => break,
        };
        let start = m.start;
        if start > state.cursor {
            let text = get_text(state, start);
            add_paragraph(mut state, text);
            state.cursor = start;
        }
        let end_pos = block_method(mut cx, mut md, m, sc, mut state);
        if end_pos > 0 {
            state.cursor = end_pos;
        } else {
            let e = find_line_end(mut cx, mut state);
            let text = get_text(state, e);
            add_paragraph(mut state, text);
            state.cursor = e;
        }
    }
    if state.cursor < state.cursor_max {
        let text = tail(state.src, state.cursor);
        add_paragraph(mut state, text);
        state.cursor = state.cursor_max;
    }
}

fn default_block_rules(md: ref Md) -> Vec[String] {
    md.brules.clone()
}

// Parser.parse_method: the rule whose group matched, by its handler.
fn block_method(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let name = last_group(cx.rx, rid, m);
    let h = method_of(md.bmethods, name);
    if h == "blank_line" {
        state.tokens.push(tok("blank_line"));
        return m.end;
    }
    if h == "thematic_break" {
        state.tokens.push(tok("thematic_break"));
        return m.end + 1;
    }
    if h == "indent_code" {
        return parse_indent_code(mut cx, m, mut state);
    }
    if h == "fenced_code" {
        return parse_fenced_code(mut cx, m, rid, mut state);
    }
    if h == "fenced_directive_code" {
        return directive_fenced_code(mut cx, mut md, m, rid, mut state);
    }
    if h == "axt_heading" {
        return parse_axt_heading(mut cx, m, rid, mut state);
    }
    if h == "setex_heading" {
        return parse_setex_heading(mut cx, mut md, m, rid, mut state);
    }
    if h == "ref_link" {
        return parse_ref_link(mut cx, m, rid, mut state);
    }
    if h == "block_quote" {
        return parse_block_quote(mut cx, mut md, m, rid, mut state);
    }
    if h == "block_spoiler" {
        return parse_block_spoiler(mut cx, mut md, m, rid, mut state);
    }
    if h == "list" {
        return parse_list(mut cx, mut md, m, rid, mut state);
    }
    if h == "block_html" or h == "raw_html" {
        return parse_raw_html(mut cx, m, mut state);
    }
    plugin_block_method(mut cx, mut md, h, m, rid, mut state)
}

fn parse_indent_code(cx: mut ref Ctx, m: ref Found, state: mut ref BState) -> i64 {
    let end_pos = append_paragraph(mut cx, mut state);
    if end_pos > 0 {
        return end_pos;
    }
    let code0 = group0(state.src, m);
    let code1 = expand_leading_tab(mut cx, code0, 4);
    let code2 = rx_sub(mut cx.rx, cx.p.indent_code_trim, code1, "");
    let code = strip_of(code2, "\n");
    let mut t = tok_raw("block_code", code);
    put(mut t, "style", vs("indent"));
    state.tokens.push(t);
    m.end
}

fn parse_fenced_code(cx: mut ref Ctx, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let spaces_ = gs(cx.rx, rid, state.src, m, "fenced_1");
    let marker = gs(cx.rx, rid, state.src, m, "fenced_2");
    let info = gs(cx.rx, rid, state.src, m, "fenced_3");
    let c = marker[0];
    if info.len() > 0 and c == 96 {
        // CommonMark Example 145: no backticks in a backtick fence's info
        if has_char(info, c) {
            return -1;
        }
    }
    let mut pat = u("^ {0,3}");
    pat.push(c);
    push_all(mut pat, u(f"{{{marker.len()},}}[ \\t]*(?:\\n|$)"));
    let end_re = rx_id_v(mut cx.rx, pat, 8);
    let cursor_start = m.end + 1;
    let mut code: Vec[i64] = Vec.new();
    let mut end_pos = state.cursor_max;
    match rx_search(mut cx.rx, end_re, mut state.src, cursor_start) {
        Some(m2) => {
            code = sl(state.src, cursor_start, m2.start);
            end_pos = m2.end;
        }
        None => {
            code = tail(state.src, cursor_start);
        }
    }
    if spaces_.len() > 0 and code.len() > 0 {
        let trim = rx_id_v(mut cx.rx, u(f"^ {{0,{spaces_.len()}}}"), 8);
        code = rx_sub(mut cx.rx, trim, code, "");
    }
    let mut t = tok_raw("block_code", code);
    put(mut t, "style", vs("fenced"));
    put(mut t, "marker", V.S(marker));
    if info.len() > 0 {
        let info2 = unescape_char(mut cx, info);
        let mut attrs = dict();
        put(mut attrs, "info", V.S(strip(info2)));
        put(mut t, "attrs", attrs);
    }
    state.tokens.push(t);
    end_pos
}

fn parse_axt_heading(cx: mut ref Ctx, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let level = gs(cx.rx, rid, state.src, m, "axt_1").len();
    let mut text = strip(gs(cx.rx, rid, state.src, m, "axt_2"));
    if text.len() > 0 {
        text = rx_sub(mut cx.rx, cx.p.axt_heading_trim, text, "");
    }
    let mut t = tok_t("heading", text);
    let mut attrs = dict();
    put(mut attrs, "level", V.I(level));
    put(mut t, "attrs", attrs);
    put(mut t, "style", vs("axt"));
    state.tokens.push(t);
    m.end + 1
}

fn parse_setex_heading(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    if last_is(state, "paragraph") {
        let level = if eq(gs(cx.rx, rid, state.src, m, "setext_1"), "=") { 1 } else { 2 };
        let n = state.tokens.len();
        set_type(mut state.tokens[n - 1], "heading");
        put(mut state.tokens[n - 1], "style", vs("setext"));
        let mut attrs = dict();
        put(mut attrs, "level", V.I(level));
        put(mut state.tokens[n - 1], "attrs", attrs);
        return m.end + 1;
    }
    let mut rules: Vec[String] = Vec.new();
    rules.push("thematic_break".to_string());
    rules.push("list".to_string());
    let sc = compile_sc(mut cx, mut md, true, rules);
    match rx_match(mut cx.rx, sc, mut state.src, state.cursor) {
        Some(m2) => block_method(mut cx, mut md, m2, sc, mut state),
        None => -1,
    }
}

fn parse_ref_link(cx: mut ref Ctx, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let end_pos = append_paragraph(mut cx, mut state);
    if end_pos > 0 {
        return end_pos;
    }
    let label = gs(cx.rx, rid, state.src, m, "reflink_1");
    let key = unikey(label);
    if key.len() == 0 {
        return -1;
    }
    let (href, href_pos0) = match parse_link_href(mut cx, mut state.src, m.end, true) {
        Some(p) => p,
        None => return -1,
    };
    let max_pos = match rx_search(mut cx.rx, cx.p.blank_line, mut state.src, href_pos0) {
        Some(b) => b.start,
        None => state.cursor_max,
    };
    let mut title: Option[Vec[i64]] = None;
    let mut title_pos = -1;
    if let Some((t, tp)) = parse_link_title(mut cx, state.src, href_pos0, max_pos) {
        title = Some(t);
        title_pos = tp;
    }
    if title_pos > 0 {
        match rx_match(mut cx.rx, cx.p.blank_to_line, mut state.src, title_pos) {
            Some(b) => title_pos = b.end,
            None => {
                title_pos = -1;
                title = None;
            }
        }
    }
    let mut href_pos = href_pos0;
    let mut href_v = Some(href);
    if title_pos < 0 {
        match rx_match(mut cx.rx, cx.p.blank_to_line, mut state.src, href_pos) {
            Some(b) => href_pos = b.end,
            None => {
                href_pos = -1;
                href_v = None;
            }
        }
    }
    let end = if title_pos > 0 { title_pos } else { href_pos };
    if end <= 0 {
        return -1;
    }
    let env = state.env;
    if ref_link(cx, env, key).is_none() {
        let h = unescape_char(mut cx, href_v.unwrap_or(Vec.new()));
        let mut data = dict();
        put(mut data, "url", V.S(escape_url(mut cx, h)));
        put(mut data, "label", V.S(label));
        if let Some(t) = title {
            if t.len() > 0 {
                put(mut data, "title", V.S(t));
            }
        }
        cx.envs[env].ref_links.push((key, data));
    }
    end
}

// BlockParser.extract_block_quote: the quote's text and, when a block
// that ended it was parsed, the position after that block.
fn extract_block_quote(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> (Vec[i64], i64) {
    let mut text = gs(cx.rx, rid, state.src, m, "quote_1");
    text.push(10);
    text = expand_leading_tab(mut cx, text, 3);
    text = rx_sub(mut cx.rx, cx.p.block_quote_trim, text, "");
    let mut rules: Vec[String] = Vec.new();
    rules.push("blank_line".to_string());
    rules.push("indent_code".to_string());
    rules.push("fenced_code".to_string());
    let sc = compile_sc(mut cx, mut md, true, rules);
    let require_marker = rx_match(mut cx.rx, sc, mut text, 0).is_some();
    state.cursor = m.end + 1;
    let mut end_pos = -1;
    if require_marker {
        if let Some(q) = rx_match(mut cx.rx, cx.p.strict_block_quote, mut state.src, state.cursor) {
            let quote = quote_text(mut cx, group0(state.src, q));
            push_all(mut text, quote);
            state.cursor = q.end;
        }
    } else {
        let mut prev_blank_line = false;
        let mut brules: Vec[String] = Vec.new();
        for r in ["blank_line", "thematic_break", "fenced_code", "list", "block_html"] {
            brules.push(r.to_string());
        }
        let break_sc = compile_sc(mut cx, mut md, true, brules);
        while state.cursor < state.cursor_max {
            if let Some(q) = rx_match(mut cx.rx, cx.p.strict_block_quote, mut state.src, state.cursor) {
                let quote = quote_text(mut cx, group0(state.src, q));
                push_all(mut text, quote);
                state.cursor = q.end;
                if is_blank(quote) {
                    prev_blank_line = true;
                } else {
                    let mut qq = quote.clone();
                    prev_blank_line = rx_search(mut cx.rx, cx.p.line_blank_end, mut qq, 0).is_some();
                }
                continue;
            }
            if prev_blank_line {
                // CommonMark Example 249: laziness needs a blank line
                // between a block quote and a following paragraph
                break;
            }
            if let Some(b) = rx_match(mut cx.rx, break_sc, mut state.src, state.cursor) {
                end_pos = block_method(mut cx, mut md, b, break_sc, mut state);
                if end_pos > 0 {
                    break;
                }
            }
            // a lazy continuation line
            let pos = find_line_end(mut cx, mut state);
            let line = expand_leading_tab(mut cx, get_text(state, pos), 3);
            push_all(mut text, line);
            state.cursor = pos;
        }
    }
    // CommonMark Example 6: the second tab is 4 spaces
    (expand_tab(mut cx, text), end_pos)
}

fn quote_text(cx: mut ref Ctx, q: ref Vec[i64]) -> Vec[i64] {
    let a = rx_sub(mut cx.rx, cx.p.block_quote_leading, q, "");
    let b = expand_leading_tab(mut cx, a, 3);
    rx_sub(mut cx.rx, cx.p.block_quote_trim, b, "")
}

fn parse_block_quote(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let (text, end_pos) = extract_block_quote(mut cx, mut md, m, rid, mut state);
    let mut child = child_state(state, text);
    let rules = if state.depth >= md.max_nested_level - 1 {
        remove_rule(md.block_quote_rules, "block_quote")
    } else {
        md.block_quote_rules.clone()
    };
    block_parse(mut cx, mut md, mut child, rules);
    let token = tok_children("block_quote", child.tokens);
    if end_pos > 0 {
        prepend_token(mut state, token);
        return end_pos;
    }
    state.tokens.push(token);
    state.cursor
}

fn parse_raw_html(cx: mut ref Ctx, m: ref Found, state: mut ref BState) -> i64 {
    let marker = strip(group0(state.src, m));
    if eq(marker, "<!--") {
        return html_to_end(mut cx, mut state, "-->", m.end);
    }
    if eq(marker, "<?") {
        return html_to_end(mut cx, mut state, "?>", m.end);
    }
    if eq(marker, "<![CDATA[") {
        return html_to_end(mut cx, mut state, "]]>", m.end);
    }
    if starts(marker, "<!") {
        return html_to_end(mut cx, mut state, ">", m.end);
    }
    let mut close_tag: Vec[i64] = Vec.new();
    let mut open_tag: Vec[i64] = Vec.new();
    if starts(marker, "</") {
        close_tag = ascii_lower(tail(marker, 2));
        // rule 6
        if tags_has(block_tags(), close_tag) {
            return html_to_newline(mut cx, mut state);
        }
    } else {
        open_tag = ascii_lower(tail(marker, 1));
        // rule 1
        if tags_has(pre_tags(), open_tag) {
            let end_tag = to_string(wrap("</", open_tag, ">"));
            return html_to_end(mut cx, mut state, end_tag.as_str(), m.end);
        }
        // rule 6
        if tags_has(block_tags(), open_tag) {
            return html_to_newline(mut cx, mut state);
        }
    }
    // Blocks of type 7 may not interrupt a paragraph.
    let end_pos = append_paragraph(mut cx, mut state);
    if end_pos > 0 {
        return end_pos;
    }
    // rule 7
    let start_pos = m.end;
    let line_end = find_line_end(mut cx, mut state);
    let ok = if open_tag.len() > 0 {
        rx_run_end(mut cx.rx, cx.p.open_tag_end, state.src, start_pos, line_end, 1).is_some()
    } else if close_tag.len() > 0 {
        rx_run_end(mut cx.rx, cx.p.close_tag_end, state.src, start_pos, line_end, 1).is_some()
    } else {
        false
    };
    if ok {
        return html_to_newline(mut cx, mut state);
    }
    -1
}

fn html_to_end(cx: mut ref Ctx, state: mut ref BState, end_marker: Str, start_pos: i64) -> i64 {
    let marker_pos = find(state.src, end_marker, start_pos);
    let mut text: Vec[i64] = Vec.new();
    let mut end_pos = state.cursor_max;
    if marker_pos == -1 {
        text = tail(state.src, state.cursor);
    } else {
        text = get_text(state, marker_pos);
        state.cursor = marker_pos;
        end_pos = find_line_end(mut cx, mut state);
        push_all(mut text, get_text(state, end_pos));
    }
    state.tokens.push(tok_raw("block_html", text));
    end_pos
}

fn html_to_newline(cx: mut ref Ctx, state: mut ref BState) -> i64 {
    let mut text: Vec[i64] = Vec.new();
    let mut end_pos = state.cursor_max;
    match rx_search(mut cx.rx, cx.p.blank_line, mut state.src, state.cursor) {
        Some(b) => {
            end_pos = b.start;
            text = get_text(state, end_pos);
        }
        None => {
            text = tail(state.src, state.cursor);
        }
    }
    state.tokens.push(tok_raw("block_html", text));
    end_pos
}

// ------------------------------------------------------ list_parser.py

fn parse_list(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let text = gs(cx.rx, rid, state.src, m, "list_3");
    if is_blank(text) {
        // Example 285: an empty list item cannot interrupt a paragraph
        let end_pos = append_paragraph(mut cx, mut state);
        if end_pos > 0 {
            return end_pos;
        }
    }
    let marker = gs(cx.rx, rid, state.src, m, "list_2");
    let ordered = marker.len() > 1;
    let depth = state.depth;
    let bullet_c = marker[marker.len() - 1];
    let mut token = tok_children("list", Vec.new());
    put(mut token, "tight", V.B(true));
    put(mut token, "bullet", V.S(vec_of(bullet_c)));
    let mut attrs = dict();
    put(mut attrs, "depth", V.I(depth));
    put(mut attrs, "ordered", V.B(ordered));
    put(mut token, "attrs", attrs);
    if ordered {
        let start = int_of(sl(marker, 0, -1));
        if start != 1 {
            // Example 304: only a list starting at 1 interrupts a paragraph
            let end_pos = append_paragraph(mut cx, mut state);
            if end_pos > 0 {
                return end_pos;
            }
            put_attr(mut token, "start", V.I(start));
        }
    }
    state.cursor = m.end + 1;
    let mut groups: Option[(Vec[i64], Vec[i64], Vec[i64])] = Some((gs(cx.rx, rid, state.src, m, "list_1"), marker.clone(), text));
    let rules = if depth >= md.max_nested_level - 1 {
        remove_rule(md.list_rules, "list")
    } else {
        md.list_rules.clone()
    };
    let bullet = list_bullet(bullet_c);
    let mut end_info: Option[(i64, i64)] = None;
    while let Some(g) = groups {
        groups = parse_list_item(mut cx, mut md, bullet, g, mut token, mut state, rules, mut end_info);
    }
    transform_tight_list(mut token);
    if let Some((index, end_pos)) = end_info {
        state.tokens.insert(index, token);
        return end_pos;
    }
    state.tokens.push(token);
    state.cursor
}

fn transform_tight_list(token: mut ref V) {
    if not get_b(token, "tight") {
        return;
    }
    if let V.D(items) = token {
        for (k, v) in items.iter_mut() {
            if k == "children" {
                if let V.L(list_items) = v {
                    for item in list_items.iter_mut() {
                        if let V.D(fields) = item {
                            for (k2, v2) in fields.iter_mut() {
                                if k2 == "children" {
                                    if let V.L(toks) = v2 {
                                        for t in toks.iter_mut() {
                                            if is_type(t, "paragraph") {
                                                set_type(mut t, "block_text");
                                            } else if is_type(t, "list") {
                                                transform_tight_list(mut t);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The pattern text of a spec rule, with its first '3' replaced as
// _parse_list_item does for a narrow marker.
fn narrowed(md: ref Md, name: Str, width: i64) -> Vec[i64] {
    let p = spec_of(md.bspec, name.to_string()).unwrap_or(Vec.new());
    if width < 3 {
        return replace_v(p, u("3"), num_text(width), 1);
    }
    p
}

fn parse_list_item(cx: mut ref Ctx, md: mut ref Md, bullet: Str, groups: own (Vec[i64], Vec[i64], Vec[i64]), token: mut ref V, state: mut ref BState, rules: ref Vec[String], end_info: mut ref Option[(i64, i64)]) -> Option[(Vec[i64], Vec[i64], Vec[i64])] {
    let (spaces_, marker, text0) = groups;
    let leading_width = spaces_.len() + marker.len();
    let (text1, continue_width) = compile_continue_width(mut cx, text0, leading_width);
    let item_pattern = list_item_pattern(bullet, leading_width);
    let mut pairs: Vec[(String, Vec[i64])] = Vec.new();
    for name in ["thematic_break", "fenced_code", "axt_heading", "block_quote", "block_html", "list"] {
        pairs.push((name.to_string(), narrowed(md, name, leading_width)));
    }
    pairs.insert(1, ("list_item".to_string(), item_pattern));
    let mut regex: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < pairs.len() {
        if i > 0 {
            regex.push(124);
        }
        push_str(mut regex, "(?P<");
        push_str(mut regex, pairs[i].0);
        push_str(mut regex, ">(?<=\\n)");
        push_all(mut regex, pairs[i].1);
        regex.push(41);
        i += 1;
    }
    let sc = rx_id_v(mut cx.rx, regex, 8);
    let mut src: Vec[i64] = Vec.new();
    let mut next_group: Option[(Vec[i64], Vec[i64], Vec[i64])] = None;
    let mut prev_blank_line = false;
    let mut pos = state.cursor;
    let continue_space = spaces(continue_width);
    while pos < state.cursor_max {
        pos = find_line_end(mut cx, mut state);
        let mut line = get_text(state, pos);
        if rx_match(mut cx.rx, cx.p.blank_line, mut line, 0).is_some() {
            src.push(10);
            prev_blank_line = true;
            state.cursor = pos;
            continue;
        }
        line = expand_leading_tab(mut cx, line, 4);
        if starts_v(line, continue_space) {
            if prev_blank_line and text1.len() == 0 and is_blank(src) {
                // Example 280: a list item starts with one blank line at most
                break;
            }
            push_all(mut src, line);
            prev_blank_line = false;
            state.cursor = pos;
            continue;
        }
        if let Some(m) = rx_match(mut cx.rx, sc, mut state.src, state.cursor) {
            let tok_type = last_group(cx.rx, sc, m);
            if tok_type == "list_item" {
                if prev_blank_line {
                    put(mut token, "tight", V.B(false));
                }
                next_group = Some((
                    gs(cx.rx, sc, state.src, m, "listitem_1"),
                    gs(cx.rx, sc, state.src, m, "listitem_2"),
                    gs(cx.rx, sc, state.src, m, "listitem_3"),
                ));
                state.cursor = m.end + 1;
                break;
            }
            if tok_type == "list" {
                break;
            }
            let tok_index = state.tokens.len();
            let end_pos = block_method(mut cx, mut md, m, sc, mut state);
            if end_pos > 0 {
                *end_info = Some((tok_index, end_pos));
                break;
            }
        }
        if prev_blank_line and not starts_v(line, continue_space) {
            // not a continuation line, and the line before is blank
            break;
        }
        push_all(mut src, line);
        state.cursor = pos;
    }
    let mut text = text1;
    push_all(mut text, clean_list_item_text(mut cx, src, continue_width));
    let mut child = child_state(state, strip_end(mut cx, text));
    block_parse(mut cx, mut md, mut child, rules);
    if get_b(token, "tight") and is_loose_list(child.tokens) {
        put(mut token, "tight", V.B(false));
    }
    let item = tok_children("list_item", child.tokens);
    if let V.D(items) = token {
        for (k, v) in items.iter_mut() {
            if k == "children" {
                if let V.L(l) = v {
                    l.push(item);
                }
                break;
            }
        }
    }
    next_group
}

fn list_bullet(c: i64) -> Str {
    if c == 46 {
        "\\d{0,9}\\."
    } else if c == 41 {
        "\\d{0,9}\\)"
    } else if c == 42 {
        "\\*"
    } else if c == 43 {
        "\\+"
    } else {
        "-"
    }
}

fn list_item_pattern(bullet: Str, leading_width: i64) -> Vec[i64] {
    let w = if leading_width > 3 { 3 } else { leading_width };
    u(f"^(?P<listitem_1> {{0,{w}}})(?P<listitem_2>{bullet})(?P<listitem_3>[ \\t]*|[ \\t][^\\n]+)$")
}

fn compile_continue_width(cx: mut ref Ctx, text0: ref Vec[i64], leading_width: i64) -> (Vec[i64], i64) {
    let t1 = expand_leading_tab(mut cx, text0, 3);
    let mut text = expand_tab(mut cx, t1);
    let mut space_width = 1;
    match rx_match(mut cx.rx, cx.p.line_has_text, mut text, 0) {
        Some(m2) => {
            // indented code: five spaces
            if starts(text, "     ") {
                space_width = 1;
            } else {
                space_width = group_or_empty(text, m2, 1).len();
            }
            text = tail(text, space_width);
            text.push(10);
        }
        None => {
            space_width = 1;
            text = Vec.new();
        }
    }
    (text, leading_width + space_width)
}

fn clean_list_item_text(cx: mut ref Ctx, src: ref Vec[i64], continue_width: i64) -> Vec[i64] {
    // Example 7: a tab is 3 spaces here
    let trim_space = spaces(continue_width);
    let mut rv: Vec[Vec[i64]] = Vec.new();
    for line in split_on(src, "\n") {
        if starts_v(line, trim_space) {
            let l2 = replace_v(line, trim_space, Vec.new(), 1);
            // Example 5: a tab is 4 spaces
            rv.push(expand_tab(mut cx, l2));
        } else {
            rv.push(line.clone());
        }
    }
    join(rv, "\n")
}

fn is_loose_list(tokens: ref Vec[V]) -> bool {
    let mut paragraph_count = 0;
    for t in tokens.iter() {
        if is_type(t, "blank_line") {
            return true;
        }
        if is_type(t, "paragraph") {
            paragraph_count += 1;
            if paragraph_count > 1 {
                return true;
            }
        }
    }
    false
}
// ---------------------------------------------------- inline_parser.py

// InlineParser.process_text, or the abbr plugin's when it is in use.
fn process_text(cx: mut ref Ctx, md: ref Md, text: own Vec[i64], state: mut ref IState) {
    if md.abbr_text {
        abbr_process_text(mut cx, text, mut state);
    } else {
        state.tokens.push(text_tok(text));
    }
}

// InlineParser.parse, which `render` returns the tokens of.
fn inline_parse(cx: mut ref Ctx, md: mut ref Md, state: mut ref IState) {
    let mut pos = 0;
    let rules = md.irules.clone();
    let sc = compile_sc(mut cx, mut md, false, rules);
    while pos < state.src.len() {
        let m = match rx_search(mut cx.rx, sc, mut state.src, pos) {
            Some(m) => m,
            None => break,
        };
        let end_pos = m.start;
        if end_pos > pos {
            let hole = slice(state.src, pos, end_pos);
            process_text(mut cx, md, hole, mut state);
        }
        let new_pos = inline_method(mut cx, mut md, m, sc, mut state);
        if new_pos <= 0 {
            // move on one character
            pos = end_pos + 1;
            let hole = sl(state.src, end_pos, pos);
            process_text(mut cx, md, hole, mut state);
        } else {
            pos = new_pos;
        }
    }
    if pos == 0 {
        // just text
        let all = state.src.clone();
        process_text(mut cx, md, all, mut state);
    } else if pos < state.src.len() {
        let rest = tail(state.src, pos);
        process_text(mut cx, md, rest, mut state);
    }
}

fn inline_render(cx: mut ref Ctx, md: mut ref Md, state: own IState) -> Vec[V] {
    let mut st = state;
    inline_parse(mut cx, mut md, mut st);
    st.tokens
}

// InlineParser.__call__
fn inline_call(cx: mut ref Ctx, md: mut ref Md, s: own Vec[i64], env: i64) -> Vec[V] {
    inline_render(mut cx, mut md, new_istate(env, s))
}

fn inline_method(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref IState) -> i64 {
    let name = last_group(cx.rx, rid, m);
    inline_by_name(mut cx, mut md, name, m, rid, mut state)
}

fn inline_by_name(cx: mut ref Ctx, md: mut ref Md, name: ref String, m: ref Found, rid: i64, state: mut ref IState) -> i64 {
    if name == "escape" {
        let text = unescape_char(mut cx, group0(state.src, m));
        state.tokens.push(text_tok(text));
        return m.end;
    }
    if name == "codespan" {
        return parse_codespan(mut cx, m, mut state);
    }
    if name == "emphasis" {
        return parse_emphasis(mut cx, mut md, m, mut state);
    }
    if name == "link" {
        return parse_link_rule(mut cx, mut md, m, mut state);
    }
    if name == "auto_link" or name == "auto_email" {
        let text = group0(state.src, m);
        if state.in_link {
            process_text(mut cx, md, text, mut state);
            return m.end;
        }
        let inner = sl(text, 1, -1);
        let url = if name == "auto_email" { ucat("mailto:", inner) } else { inner.clone() };
        add_auto_link(mut cx, url, inner, mut state);
        return m.end;
    }
    if name == "inline_html" {
        let html = group0(state.src, m);
        if starts(html, "<a ") or starts(html, "<a>") or starts(html, "<A ") or starts(html, "<A>") {
            state.in_link = true;
        } else if starts(html, "</a ") or starts(html, "</a>") or starts(html, "</A ") or starts(html, "</A>") {
            state.in_link = false;
        }
        state.tokens.push(tok_raw("inline_html", html));
        return m.end;
    }
    if name == "linebreak" {
        state.tokens.push(tok("linebreak"));
        return m.end;
    }
    if name == "softbreak" {
        state.tokens.push(tok("softbreak"));
        return m.end;
    }
    plugin_inline_method(mut cx, mut md, name, m, rid, mut state)
}

fn add_auto_link(cx: mut ref Ctx, url: ref Vec[i64], text: own Vec[i64], state: mut ref IState) {
    let mut children: Vec[V] = Vec.new();
    children.push(text_tok(text));
    let mut t = tok_children("link", children);
    let mut attrs = dict();
    put(mut attrs, "url", V.S(escape_url(mut cx, url)));
    put(mut t, "attrs", attrs);
    state.tokens.push(t);
}

fn parse_link_rule(cx: mut ref Ctx, md: mut ref Md, m: ref Found, state: mut ref IState) -> i64 {
    let pos = m.end;
    let marker = group0(state.src, m);
    let is_image = marker[0] == 33;
    if (is_image and state.in_image) or (not is_image and state.in_link) {
        state.tokens.push(text_tok(marker));
        return pos;
    }
    let mut text: Option[Vec[i64]] = None;
    let mut label: Option[Vec[i64]] = None;
    let mut end_pos = 0;
    match parse_link_label(mut cx, mut state.src, pos) {
        Some((l, e)) => {
            label = Some(l);
            end_pos = e;
        }
        None => {
            match parse_link_text(mut cx, mut state.src, pos) {
                Some((t, e)) => {
                    text = Some(t);
                    end_pos = e;
                }
                None => return -1,
            }
        }
    }
    if text.is_none() {
        text = label.clone();
    }
    if end_pos >= state.src.len() and label.is_none() {
        return -1;
    }
    let mut rules: Vec[String] = Vec.new();
    rules.push("codespan".to_string());
    rules.push("prec_auto_link".to_string());
    rules.push("prec_inline_html".to_string());
    let prec_pos = precedence_scan(mut cx, mut md, m, mut state, end_pos, rules);
    if prec_pos > 0 {
        return prec_pos;
    }
    if end_pos < state.src.len() {
        let c = state.src[end_pos];
        if c == 40 {
            // [text](<url> "title")
            if let Some((attrs, pos2)) = parse_link(mut cx, mut state.src, end_pos + 1) {
                if pos2 > 0 {
                    let token = link_token(mut cx, mut md, is_image, text.clone().unwrap(), attrs, state);
                    state.tokens.push(token);
                    return pos2;
                }
            }
        } else if c == 91 {
            // [text][label]
            if let Some((label2, pos2)) = parse_link_label(mut cx, mut state.src, end_pos + 1) {
                if pos2 > 0 {
                    end_pos = pos2;
                    if label2.len() > 0 {
                        label = Some(label2);
                    }
                }
            }
        }
    }
    let lab = match label {
        Some(l) => l,
        None => return -1,
    };
    let env = state.env;
    if cx.envs[env].ref_links.len() == 0 {
        return -1;
    }
    let key = unikey(lab);
    match ref_link(cx, env, key) {
        Some(data) => {
            let mut attrs = dict();
            put(mut attrs, "url", get(data, "url"));
            put(mut attrs, "title", get(data, "title"));
            let mut token = link_token(mut cx, mut md, is_image, text.unwrap(), attrs, state);
            put(mut token, "ref", V.S(key));
            put(mut token, "label", V.S(lab));
            state.tokens.push(token);
            end_pos
        }
        None => -1,
    }
}

fn link_token(cx: mut ref Ctx, md: mut ref Md, is_image: bool, text: own Vec[i64], attrs: own V, state: ref IState) -> V {
    let mut new_state = copy_state(state, text);
    if is_image {
        new_state.in_image = true;
    } else {
        new_state.in_link = true;
    }
    let children = inline_render(mut cx, mut md, new_state);
    let mut t = tok_children(if is_image { "image" } else { "link" }, children);
    put(mut t, "attrs", attrs);
    t
}

fn parse_emphasis(cx: mut ref Ctx, md: mut ref Md, m: ref Found, state: mut ref IState) -> i64 {
    let pos = m.end;
    let marker = group0(state.src, m);
    let mlen = marker.len();
    if (mlen == 1 and state.in_emphasis) or (mlen == 2 and state.in_strong) {
        state.tokens.push(text_tok(marker));
        return pos;
    }
    let star = marker[0] == 42;
    let end_re = if mlen == 1 {
        if star { cx.p.em1 } else { cx.p.em_1 }
    } else if mlen == 2 {
        if star { cx.p.em2 } else { cx.p.em_2 }
    } else if star {
        cx.p.em3
    } else {
        cx.p.em_3
    };
    let m1 = match rx_search(mut cx.rx, end_re, mut state.src, pos) {
        Some(m1) => m1,
        None => {
            state.tokens.push(text_tok(marker));
            return pos;
        }
    };
    let end_pos = m1.end;
    let text = sl(state.src, pos, end_pos - mlen);
    let prec_pos = precedence_scan(mut cx, mut md, m, mut state, end_pos, default_prec_rules());
    if prec_pos > 0 {
        return prec_pos;
    }
    let mut new_state = copy_state(state, text);
    if mlen == 1 {
        new_state.in_emphasis = true;
        let children = inline_render(mut cx, mut md, new_state);
        state.tokens.push(tok_children("emphasis", children));
    } else if mlen == 2 {
        new_state.in_strong = true;
        let children = inline_render(mut cx, mut md, new_state);
        state.tokens.push(tok_children("strong", children));
    } else {
        new_state.in_emphasis = true;
        new_state.in_strong = true;
        let mut children: Vec[V] = Vec.new();
        children.push(tok_children("strong", inline_render(mut cx, mut md, new_state)));
        state.tokens.push(tok_children("emphasis", children));
    }
    end_pos
}

fn default_prec_rules() -> Vec[String] {
    let mut rules: Vec[String] = Vec.new();
    for r in ["codespan", "link", "prec_auto_link", "prec_inline_html"] {
        rules.push(r.to_string());
    }
    rules
}

fn parse_codespan(cx: mut ref Ctx, m: ref Found, state: mut ref IState) -> i64 {
    let marker = group0(state.src, m);
    let mut pat = u("(.*?[^`])");
    push_all(mut pat, marker);
    push_str(mut pat, "(?!`)");
    let id = rx_id_v(mut cx.rx, pat, 16);
    let pos = m.end;
    match rx_match(mut cx.rx, id, mut state.src, pos) {
        Some(m2) => {
            let mut code = replace(group_or_empty(state.src, m2, 1), "\n", " ");
            // line endings are spaces
            if strip(code).len() > 0 {
                if starts(code, " ") and ends(code, " ") {
                    code = sl(code, 1, -1);
                }
            }
            state.tokens.push(tok_raw("codespan", esc(code)));
            m2.end
        }
        None => {
            state.tokens.push(text_tok(marker));
            pos
        }
    }
}

// InlineParser.precedence_scan: another rule starting inside the
// marked text, which takes over if it runs past its end.
fn precedence_scan(cx: mut ref Ctx, md: mut ref Md, m: ref Found, state: mut ref IState, end_pos: i64, rules: ref Vec[String]) -> i64 {
    let mark_pos = m.end;
    let sc = compile_sc(mut cx, mut md, false, rules);
    let m1 = match rx_run_end(mut cx.rx, sc, state.src, mark_pos, end_pos, 0) {
        Some(m1) => m1,
        None => return -1,
    };
    let rule_name = to_string(replace(us(last_group(cx.rx, sc, m1)), "prec_", ""));
    let mut one: Vec[String] = Vec.new();
    one.push(rule_name.clone());
    let sc2 = compile_sc(mut cx, mut md, false, one);
    let m2 = match rx_match(mut cx.rx, sc2, mut state.src, m1.start) {
        Some(m2) => m2,
        None => return -1,
    };
    let mut new_state = copy_state(state, state.src.clone());
    let m2_pos = inline_by_name(mut cx, mut md, rule_name, m2, sc2, mut new_state);
    if m2_pos <= 0 or m2_pos < end_pos {
        return -1;
    }
    let raw_text = sl(state.src, m.start, m2.start);
    state.tokens.push(text_tok(raw_text));
    for t in new_state.tokens {
        state.tokens.push(t.clone());
    }
    m2_pos
}
// ------------------------------------------------------------- plugins

// The `plugin(md)` call of each plugin in mistune.plugins.
fn use_plugin(md: mut ref Md, name: Str) -> Result[(), String] {
    if name == "speedup" {
        block_register(mut md, "paragraph", Some(u(pat_speedup_paragraph())), "paragraph", "");
        let mut text_pattern = u("[\\s\\S]+?(?=[\\\\><!\\[_*`~\\^\\$=]|");
        if has_rule(md.irules, "url_link") {
            push_str(mut text_pattern, "https?:|");
        }
        if md.hard_wrap {
            push_str(mut text_pattern, " *\\n|");
        } else {
            push_str(mut text_pattern, " {2,}\\n|");
        }
        push_str(mut text_pattern, "$)");
        inline_register(mut md, "text", text_pattern, "");
    } else if name == "strikethrough" {
        inline_register(mut md, "strikethrough", u("~~(?=[^\\s~])"), "link");
        render_register(mut md, "strikethrough");
    } else if name == "mark" {
        inline_register(mut md, "mark", u("==(?=[^\\s=])"), "link");
        render_register(mut md, "mark");
    } else if name == "insert" {
        inline_register(mut md, "insert", u("\\^\\^(?=[^\\s\\^])"), "link");
        render_register(mut md, "insert");
    } else if name == "superscript" {
        inline_register(mut md, "superscript", u(pat_superscript()), "linebreak");
        render_register(mut md, "superscript");
    } else if name == "subscript" {
        inline_register(mut md, "subscript", u(pat_subscript()), "linebreak");
        render_register(mut md, "subscript");
    } else if name == "footnotes" {
        inline_register(mut md, "footnote", u(pat_inline_footnote()), "link");
        block_register(mut md, "ref_footnote", Some(u(pat_ref_footnote())), "ref_footnote", "ref_link");
        md.after_render.push("footnotes".to_string());
        render_register(mut md, "footnote_ref");
        render_register(mut md, "footnote_item");
        render_register(mut md, "footnotes");
    } else if name == "table" {
        block_register(mut md, "table", Some(u(pat_table())), "table", "paragraph");
        block_register(mut md, "nptable", Some(u(pat_nptable())), "nptable", "paragraph");
        for r in ["table", "table_head", "table_body", "table_row", "table_cell"] {
            render_register(mut md, r);
        }
    } else if name == "url" {
        inline_register(mut md, "url_link", u(pat_url_link()), "");
    } else if name == "abbr" {
        block_register(mut md, "ref_abbr", Some(u(pat_ref_abbr())), "ref_abbr", "paragraph");
        md.abbr_text = true;
        render_register(mut md, "abbr");
    } else if name == "def_list" {
        block_register(mut md, "def_list", Some(u(pat_def_list())), "def_list", "paragraph");
        render_register(mut md, "def_list");
        render_register(mut md, "def_list_head");
        render_register(mut md, "def_list_item");
    } else if name == "math" {
        block_register(mut md, "block_math", Some(u(pat_block_math())), "block_math", "list");
        inline_register(mut md, "inline_math", u(pat_inline_math()), "link");
        render_register(mut md, "block_math");
        render_register(mut md, "inline_math");
    } else if name == "ruby" {
        inline_register(mut md, "ruby", u("\\[(?:\\w+\\(\\w+\\))+\\]"), "link");
        render_register(mut md, "ruby");
    } else if name == "task_lists" {
        md.before_render.push("task_lists".to_string());
        render_register(mut md, "task_list_item");
    } else if name == "spoiler" {
        block_register(mut md, "block_quote", None, "block_spoiler", "");
        inline_register(mut md, "inline_spoiler", u(pat_inline_spoiler()), "");
        render_register(mut md, "block_spoiler");
        render_register(mut md, "inline_spoiler");
    } else {
        // import_plugin's rsplit, then import_module
        if not name.contains(".") {
            return Err(f"ValueError: not enough values to unpack (expected 2, got 1)");
        }
        let module = name.rsplit_once(".").unwrap().0;
        return Err(f"ModuleNotFoundError: No module named '{module}'");
    }
    Ok(())
}

// ------------------------------------------------------- block methods

fn plugin_block_method(cx: mut ref Ctx, md: mut ref Md, h: ref String, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    if *h == "paragraph" {
        let text = group0(state.src, m);
        add_paragraph(mut state, text);
        return m.end;
    }
    if *h == "table" {
        return parse_table(mut cx, m, rid, mut state);
    }
    if *h == "nptable" {
        return parse_nptable(mut cx, m, rid, mut state);
    }
    if *h == "ref_footnote" {
        let key = unikey(gs(cx.rx, rid, state.src, m, "footnote_key"));
        let env = state.env;
        if not has_key(cx.envs[env].ref_footnotes, key) {
            let text = gs(cx.rx, rid, state.src, m, "footnote_text");
            cx.envs[env].ref_footnotes.push((key, text));
        }
        return m.end;
    }
    if *h == "ref_abbr" {
        let key = gs(cx.rx, rid, state.src, m, "abbr_key");
        let text = strip(gs(cx.rx, rid, state.src, m, "abbr_text"));
        let env = state.env;
        let mut i = 0;
        let mut done = false;
        while i < cx.envs[env].ref_abbrs.len() {
            if same(cx.envs[env].ref_abbrs[i].0, key) {
                cx.envs[env].ref_abbrs[i].1 = text.clone();
                done = true;
                break;
            }
            i += 1;
        }
        if not done {
            cx.envs[env].ref_abbrs.push((key, text));
        }
        // a definition splits a paragraph
        state.tokens.push(tok("blank_line"));
        return m.end + 1;
    }
    if *h == "def_list" {
        return parse_def_list(mut cx, mut md, m, rid, mut state);
    }
    if *h == "block_math" {
        let text = gs(cx.rx, rid, state.src, m, "math_text");
        state.tokens.push(tok_raw("block_math", text));
        return m.end + 1;
    }
    if *h == "rst_directive" {
        return rst_parse_directive(mut cx, mut md, mut state);
    }
    -1
}

// --------------------------------------------------------------- table

fn parse_table(cx: mut ref Ctx, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let pos = m.end;
    let header = gs(cx.rx, rid, state.src, m, "table_head");
    let align = gs(cx.rx, rid, state.src, m, "table_align");
    let (thead, aligns) = match process_thead(mut cx, header, align) {
        Some(p) => p,
        None => return -1,
    };
    let mut rows: Vec[V] = Vec.new();
    let body = gs(cx.rx, rid, state.src, m, "table_body");
    for text in split_lines(body, false) {
        let mut t = text.clone();
        let c = match rx_match(mut cx.rx, cx.p.table_cell, mut t, 0) {
            Some(c) => c,
            None => return -1,
        };
        match process_row(mut cx, group_or_empty(t, c, 1), aligns) {
            Some(row) => rows.push(row),
            None => return -1,
        }
    }
    let mut children: Vec[V] = Vec.new();
    children.push(thead);
    children.push(tok_children("table_body", rows));
    state.tokens.push(tok_children("table", children));
    pos
}

fn parse_nptable(cx: mut ref Ctx, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let header = gs(cx.rx, rid, state.src, m, "nptable_head");
    let align = gs(cx.rx, rid, state.src, m, "nptable_align");
    let (thead, aligns) = match process_thead(mut cx, header, align) {
        Some(p) => p,
        None => return -1,
    };
    let mut rows: Vec[V] = Vec.new();
    let body = gs(cx.rx, rid, state.src, m, "nptable_body");
    for text in split_lines(body, false) {
        match process_row(mut cx, text, aligns) {
            Some(row) => rows.push(row),
            None => return -1,
        }
    }
    let mut children: Vec[V] = Vec.new();
    children.push(thead);
    children.push(tok_children("table_body", rows));
    state.tokens.push(tok_children("table", children));
    m.end
}

fn cell(text: ref Vec[i64], align: ref V, head: bool) -> V {
    let mut t = tok_t("table_cell", strip(text));
    let mut attrs = dict();
    put(mut attrs, "align", align.clone());
    put(mut attrs, "head", V.B(head));
    put(mut t, "attrs", attrs);
    t
}

fn process_thead(cx: mut ref Ctx, header: ref Vec[i64], align: ref Vec[i64]) -> Option[(V, Vec[V])] {
    let headers = rx_split(mut cx.rx, cx.p.cell_split, header);
    let parts = rx_split(mut cx.rx, cx.p.cell_split, align);
    if headers.len() != parts.len() {
        return None;
    }
    let mut aligns: Vec[V] = Vec.new();
    for v in parts.iter() {
        let mut t = v.clone();
        if rx_match(mut cx.rx, cx.p.align_center, mut t, 0).is_some() {
            aligns.push(vs("center"));
        } else if rx_match(mut cx.rx, cx.p.align_left, mut t, 0).is_some() {
            aligns.push(vs("left"));
        } else if rx_match(mut cx.rx, cx.p.align_right, mut t, 0).is_some() {
            aligns.push(vs("right"));
        } else {
            aligns.push(V.Nil);
        }
    }
    let mut children: Vec[V] = Vec.new();
    let mut i = 0;
    while i < headers.len() {
        children.push(cell(headers[i], aligns[i], true));
        i += 1;
    }
    Some((tok_children("table_head", children), aligns))
}

fn process_row(cx: mut ref Ctx, text: ref Vec[i64], aligns: ref Vec[V]) -> Option[V] {
    let cells = rx_split(mut cx.rx, cx.p.cell_split, text);
    if cells.len() != aligns.len() {
        return None;
    }
    let mut children: Vec[V] = Vec.new();
    let mut i = 0;
    while i < cells.len() {
        children.push(cell(cells[i], aligns[i], false));
        i += 1;
    }
    Some(tok_children("table_row", children))
}

// ------------------------------------------------------------ def_list

fn parse_def_list(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let mut pos = m.end;
    let mut children: Vec[V] = Vec.new();
    let src0 = group0(state.src, m);
    let head0 = gs(cx.rx, rid, state.src, m, "def_list_head");
    def_items(mut cx, mut md, head0, src0, mut children);
    loop {
        match rx_match(mut cx.rx, cx.p.def_re, mut state.src, pos) {
            Some(m2) => {
                let head = gs(cx.rx, cx.p.def_re, state.src, m2, "def_list_head");
                let src = group0(state.src, m2);
                def_items(mut cx, mut md, head, src, mut children);
                pos = m2.end;
            }
            None => break,
        }
    }
    state.tokens.push(tok_children("def_list", children));
    pos
}

// _parse_def_item, for a match of DEF_RE (or of the def_list rule,
// whose groups are the same).
fn def_items(cx: mut ref Ctx, md: mut ref Md, head: ref Vec[i64], src0: ref Vec[i64], out: mut ref Vec[V]) {
    for line in split_lines(head, false) {
        out.push(tok_t("def_list_head", line.clone()));
    }
    let mut src = src0.clone();
    let end0 = head.len();
    let first = rx_search(mut cx.rx, cx.p.dd_start, mut src, end0).unwrap();
    let mut start = first.start;
    let mut prev_blank_line = eq(slice(src, end0, start), "\n");
    loop {
        let next = match rx_search(mut cx.rx, cx.p.dd_start, mut src, start + 1) {
            Some(n) => n,
            None => break,
        };
        let end = next.start;
        let text = replace1(slice(src, start, end), ":", " ");
        let children = def_process_text(mut cx, mut md, text, prev_blank_line);
        let mut t = text.clone();
        prev_blank_line = rx_search(mut cx.rx, cx.p.has_blank_line, mut t, 0).is_some();
        out.push(tok_children("def_list_item", children));
        start = end;
    }
    let text = replace1(tail(src, start), ":", " ");
    let children = def_process_text(mut cx, mut md, text, prev_blank_line);
    out.push(tok_children("def_list_item", children));
}

fn def_process_text(cx: mut ref Ctx, md: mut ref Md, text: ref Vec[i64], loose: bool) -> Vec[V] {
    let t = rx_sub(mut cx.rx, cx.p.def_trim, text, "");
    let env = add_env(mut cx, true);
    let mut state = new_bstate(env);
    process(mut state, strip_end(mut cx, t));
    // the default list rules
    let rules = md.list_rules.clone();
    block_parse(mut cx, mut md, mut state, rules);
    let mut tokens = state.tokens;
    if not loose and tokens.len() == 1 and is_type(tokens[0], "paragraph") {
        set_type(mut tokens[0], "block_text");
    }
    tokens
}

// ------------------------------------------------------ inline methods

fn plugin_inline_method(cx: mut ref Ctx, md: mut ref Md, name: ref String, m: ref Found, rid: i64, state: mut ref IState) -> i64 {
    if *name == "text" {
        let text = rx_sub(mut cx.rx, cx.p.hard_linebreak, group0(state.src, m), "\n");
        process_text(mut cx, md, text, mut state);
        return m.end;
    }
    if *name == "strikethrough" {
        return parse_to_end(mut cx, mut md, m, mut state, "strikethrough", cx.p.strike_end);
    }
    if *name == "mark" {
        return parse_to_end(mut cx, mut md, m, mut state, "mark", cx.p.mark_end);
    }
    if *name == "insert" {
        return parse_to_end(mut cx, mut md, m, mut state, "insert", cx.p.insert_end);
    }
    if *name == "superscript" or *name == "subscript" {
        let text = group0(state.src, m);
        let inner = replace(sl(text, 1, -1), "\\ ", " ");
        let new_state = copy_state(state, inner);
        let children = inline_render(mut cx, mut md, new_state);
        state.tokens.push(tok_children(if *name == "superscript" { "superscript" } else { "subscript" }, children));
        return m.end;
    }
    if *name == "footnote" {
        return parse_inline_footnote(mut cx, m, rid, mut state);
    }
    if *name == "url_link" {
        let text = group0(state.src, m);
        if state.in_link {
            process_text(mut cx, md, text, mut state);
            return m.end;
        }
        add_auto_link(mut cx, text, text.clone(), mut state);
        return m.end;
    }
    if *name == "inline_math" {
        let text = gs(cx.rx, rid, state.src, m, "math_text");
        state.tokens.push(tok_raw("inline_math", text));
        return m.end;
    }
    if *name == "ruby" {
        return parse_ruby(mut cx, m, mut state);
    }
    if *name == "inline_spoiler" {
        let text = gs(cx.rx, rid, state.src, m, "spoiler_text");
        let new_state = copy_state(state, text);
        let children = inline_render(mut cx, mut md, new_state);
        state.tokens.push(tok_children("inline_spoiler", children));
        return m.end;
    }
    -1
}

fn parse_to_end(cx: mut ref Ctx, md: mut ref Md, m: ref Found, state: mut ref IState, kind: Str, end_re: i64) -> i64 {
    let pos = m.end;
    let m1 = match rx_search(mut cx.rx, end_re, mut state.src, pos) {
        Some(m1) => m1,
        None => return -1,
    };
    let end_pos = m1.end;
    let text = sl(state.src, pos, end_pos - 2);
    let new_state = copy_state(state, text);
    let children = inline_render(mut cx, mut md, new_state);
    state.tokens.push(tok_children(kind, children));
    end_pos
}

fn parse_inline_footnote(cx: mut ref Ctx, m: ref Found, rid: i64, state: mut ref IState) -> i64 {
    let key = unikey(gs(cx.rx, rid, state.src, m, "footnote_key"));
    let env = state.env;
    if has_key(cx.envs[env].ref_footnotes, key) {
        let mut index = -1;
        let mut i = 0;
        while i < cx.envs[env].footnotes.len() {
            if same(cx.envs[env].footnotes[i], key) {
                index = i;
            }
            i += 1;
        }
        if index < 0 {
            cx.envs[env].footnotes.push(key.clone());
            index = cx.envs[env].footnotes.len() - 1;
        }
        let mut t = tok_raw("footnote_ref", key);
        let mut attrs = dict();
        put(mut attrs, "index", V.I(index + 1));
        put(mut t, "attrs", attrs);
        state.tokens.push(t);
    } else {
        state.tokens.push(text_tok(group0(state.src, m)));
    }
    m.end
}

fn ruby_tokens(text: ref Vec[i64]) -> Vec[V] {
    let mut tokens: Vec[V] = Vec.new();
    for item in split_on(text, ")") {
        let parts = split_on(item, "(");
        let mut t = tok_raw("ruby", parts[0].clone());
        let mut attrs = dict();
        put(mut attrs, "rt", V.S(parts[1].clone()));
        put(mut t, "attrs", attrs);
        tokens.push(t);
    }
    tokens
}

fn parse_ruby(cx: mut ref Ctx, m0: ref Found, state: mut ref IState) -> i64 {
    let mut m = Found { start: m0.start, end: m0.end, spans: m0.spans.clone(), lastindex: m0.lastindex };
    loop {
        let text = sl(group0(state.src, m), 1, -2);
        let tokens = ruby_tokens(text);
        let end_pos = m.end;
        if let Some(next) = rx_match(mut cx.rx, cx.p.ruby, mut state.src, end_pos) {
            for t in tokens {
                state.tokens.push(t.clone());
            }
            m = next;
            continue;
        }
        // the link rule's logic again
        if end_pos < state.src.len() {
            let link_pos = ruby_link(mut cx, mut state, end_pos, tokens.clone());
            if link_pos > 0 {
                return link_pos;
            }
        }
        for t in tokens {
            state.tokens.push(t.clone());
        }
        return end_pos;
    }
}

fn ruby_link(cx: mut ref Ctx, state: mut ref IState, pos: i64, tokens: own Vec[V]) -> i64 {
    let c = state.src[pos];
    if c == 40 {
        if let Some((attrs, link_pos)) = parse_link(mut cx, mut state.src, pos + 1) {
            if link_pos > 0 {
                let mut t = tok_children("link", tokens);
                put(mut t, "attrs", attrs);
                state.tokens.push(t);
                return link_pos;
            }
        }
    } else if c == 91 {
        if let Some((label, link_pos)) = parse_link_label(mut cx, mut state.src, pos + 1) {
            if label.len() > 0 and link_pos > 0 {
                let key = unikey(label);
                match ref_link(cx, state.env, key) {
                    Some(data) => {
                        let mut attrs = dict();
                        put(mut attrs, "url", get(data, "url"));
                        put(mut attrs, "title", get(data, "title"));
                        let mut t = tok_children("link", tokens);
                        put(mut t, "attrs", attrs);
                        state.tokens.push(t);
                    }
                    None => {
                        for t in tokens {
                            state.tokens.push(t.clone());
                        }
                        state.tokens.push(text_tok(wrap("[", label, "]")));
                    }
                }
                return link_pos;
            }
        }
    }
    -1
}

// The abbr plugin's process_text.
fn abbr_process_text(cx: mut ref Ctx, text0: own Vec[i64], state: mut ref IState) {
    let env = state.env;
    if cx.envs[env].ref_abbrs.len() == 0 {
        state.tokens.push(text_tok(text0));
        return;
    }
    let mut text = text0;
    if state.tokens.len() > 0 and is_type(state.tokens[state.tokens.len() - 1], "text") {
        let last = state.tokens.pop().unwrap();
        let mut joined = get_s(last, "raw");
        push_all(mut joined, text);
        text = joined;
    }
    if cx.envs[env].abbrs_re < 0 {
        let mut pat: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < cx.envs[env].ref_abbrs.len() {
            if i > 0 {
                pat.push(124);
            }
            push_all(mut pat, re_escape(cx.envs[env].ref_abbrs[i].0));
            i += 1;
        }
        cx.envs[env].abbrs_re = rx_id_v(mut cx.rx, pat, 32);
    }
    let id = cx.envs[env].abbrs_re;
    let mut pos = 0;
    while pos < text.len() {
        let m = match rx_search(mut cx.rx, id, mut text, pos) {
            Some(m) => m,
            None => break,
        };
        if m.start > pos {
            state.tokens.push(text_tok(slice(text, pos, m.start)));
        }
        let label = group0(text, m);
        let title = lookup(cx.envs[env].ref_abbrs, label).unwrap_or(Vec.new());
        let mut children: Vec[V] = Vec.new();
        children.push(text_tok(label));
        let mut t = tok_children("abbr", children);
        let mut attrs = dict();
        put(mut attrs, "title", V.S(title));
        put(mut t, "attrs", attrs);
        state.tokens.push(t);
        pos = m.end;
    }
    if pos == 0 {
        state.tokens.push(text_tok(text));
    } else if pos < text.len() {
        state.tokens.push(text_tok(tail(text, pos)));
    }
}

// re.escape
fn re_escape(s: ref Vec[i64]) -> Vec[i64] {
    let special = u("()[]{}?*+-|^$\\.&~# \t\n\r\u{b}\u{c}");
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if has_char(special, c) {
            out.push(92);
        }
        out.push(c);
    }
    out
}

// --------------------------------------------------------------- hooks

fn task_lists_hook(cx: mut ref Ctx, tokens: mut ref Vec[V]) {
    for t in tokens.iter_mut() {
        if is_type(t, "list_item") {
            rewrite_list_item(mut cx, mut t);
        }
        if has(t, "children") {
            if let V.D(items) = t {
                for (k, v) in items.iter_mut() {
                    if k == "children" {
                        if let V.L(l) = v {
                            task_lists_hook(mut cx, mut l);
                        }
                    }
                }
            }
        }
    }
}

fn rewrite_list_item(cx: mut ref Ctx, t: mut ref V) {
    let children = children_of(t);
    if children.len() == 0 {
        return;
    }
    let mut text = get_s(children[0], "text");
    if let Some(m) = rx_match(mut cx.rx, cx.p.task_list_item, mut text, 0) {
        let mark = group_or_empty(text, m, 1);
        let rest = tail(text, m.end);
        if let V.D(items) = t {
            for (k, v) in items.iter_mut() {
                if k == "children" {
                    if let V.L(l) = v {
                        put(mut l[0], "text", V.S(rest));
                    }
                    break;
                }
            }
        }
        set_type(mut t, "task_list_item");
        let mut attrs = dict();
        put(mut attrs, "checked", V.B(not eq(mark, "[ ]")));
        put(mut t, "attrs", attrs);
    }
}

// footnotes.parse_footnote_item
fn footnote_item(cx: mut ref Ctx, env: i64, key: ref Vec[i64], index: i64) -> V {
    let text = lookup(cx.envs[env].ref_footnotes, key).unwrap_or(Vec.new());
    let lines = split_lines(text, false);
    let mut second_line: Vec[i64] = Vec.new();
    let mut i = 1;
    while i < lines.len() {
        second_line = lines[i].clone();
        if second_line.len() > 0 {
            break;
        }
        i += 1;
    }
    let mut children: Vec[V] = Vec.new();
    if second_line.len() > 0 {
        let n = second_line.len() - lstrip(second_line).len();
        let id = rx_id_v(mut cx.rx, u(f"^ {{{n},}}"), 8 | 32);
        let t = strip(rx_sub(mut cx.rx, id, text, ""));
        for s in rx_split(mut cx.rx, cx.p.paragraph_split, t) {
            children.push(tok_t("paragraph", s.clone()));
        }
    } else {
        children.push(tok_t("paragraph", strip(text)));
    }
    let mut item = tok_children("footnote_item", children);
    let mut attrs = dict();
    put(mut attrs, "key", V.S(key.clone()));
    put(mut attrs, "index", V.I(index));
    put(mut item, "attrs", attrs);
    item
}
// --------------------------------------------------------- directives

// A directive's match: _directive_re over its subject, in the fenced or
// the rst style.
struct Dm {
    s: Vec[i64],
    f: Found,
    id: i64,
    rst: bool,
}

fn dm_group(cx: ref Ctx, dm: ref Dm, name: Str) -> Vec[i64] {
    gs(cx.rx, dm.id, dm.s, dm.f, name)
}

fn dm_type(cx: ref Ctx, dm: ref Dm) -> Vec[i64] {
    dm_group(cx, dm, "type")
}

fn dm_title(cx: ref Ctx, dm: ref Dm) -> Vec[i64] {
    dm_group(cx, dm, "title")
}

fn dm_content(cx: ref Ctx, dm: ref Dm) -> Vec[i64] {
    let text = dm_group(cx, dm, "text");
    if not dm.rst {
        return text;
    }
    let leading = group_or_empty(dm.s, dm.f, 1).len() + 2;
    let mut lines: Vec[Vec[i64]] = Vec.new();
    for line in split_lines(text, false) {
        lines.push(tail(line, leading));
    }
    let mut out = join(lines, "\n");
    out.push(10);
    out
}

// DirectiveParser.parse_options: (key, value) pairs.
fn dm_options(cx: mut ref Ctx, dm: ref Dm) -> Vec[(Vec[i64], Vec[i64])] {
    let text = dm_group(cx, dm, "options");
    let mut options: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    if is_blank(text) {
        return options;
    }
    let nl = rx_id(mut cx.rx, "\\n+", 32);
    for line0 in rx_split(mut cx.rx, nl, text) {
        let line = tail(strip(line0), 1);
        if line.len() == 0 {
            continue;
        }
        let i = find(line, ":", 0);
        let k = sl(line, 0, i);
        let v = strip(tail(line, i + 1));
        options.push((k, v));
    }
    options
}

// dict(options): the last value of a key.
fn opt(options: ref Vec[(Vec[i64], Vec[i64])], key: Str) -> Option[Vec[i64]] {
    let k = u(key);
    let mut found: Option[Vec[i64]] = None;
    for (a, b) in options.iter() {
        if same(a, k) {
            found = Some(b.clone());
        }
    }
    found
}

fn directive_of(md: ref Md, rst: bool, kind: ref Vec[i64]) -> String {
    let style = if rst { "rst" } else { "fenced" };
    let k = to_string(kind);
    for (s, t, p) in md.directives.iter() {
        if s == style and *t == k {
            return p.clone();
        }
    }
    String.new()
}

// FencedDirective.parse_fenced_code
fn directive_fenced_code(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let mut info = gs(cx.rx, rid, state.src, m, "fenced_3");
    if info.len() == 0 or rx_match(mut cx.rx, cx.p.fenced_type, mut info, 0).is_none() {
        return parse_fenced_code(mut cx, m, rid, mut state);
    }
    if state.depth >= md.max_nested_level {
        return parse_fenced_code(mut cx, m, rid, mut state);
    }
    let marker = gs(cx.rx, rid, state.src, m, "fenced_2");
    process_directive(mut cx, mut md, marker, m.start, mut state)
}

fn process_directive(cx: mut ref Ctx, md: mut ref Md, marker: ref Vec[i64], start: i64, state: mut ref BState) -> i64 {
    let mlen = marker.len();
    let cursor_start = start + mlen;
    let mut pat = u("^ {0,3}");
    pat.push(marker[0]);
    push_all(mut pat, u(f"{{{mlen},}}[ \\t]*(?:\\n|$)"));
    let end_re = rx_id_v(mut cx.rx, pat, 8);
    let mut text: Vec[i64] = Vec.new();
    let mut end_pos = state.cursor_max;
    match rx_search(mut cx.rx, end_re, mut state.src, cursor_start) {
        Some(e) => {
            text = sl(state.src, cursor_start, e.start);
            end_pos = e.end;
        }
        None => {
            text = tail(state.src, cursor_start);
        }
    }
    let f = match rx_match(mut cx.rx, cx.p.fenced_directive, mut text, 0) {
        Some(f) => f,
        None => return -1,
    };
    let dm = Dm { s: text, f: f, id: cx.p.fenced_directive, rst: false };
    directive_method(mut cx, mut md, dm, mut state);
    end_pos
}

// RSTDirective.parse_directive
fn rst_parse_directive(cx: mut ref Ctx, md: mut ref Md, state: mut ref BState) -> i64 {
    let f = match rx_match(mut cx.rx, cx.p.rst_directive, mut state.src, state.cursor) {
        Some(f) => f,
        None => return -1,
    };
    let end = f.end;
    let dm = Dm { s: state.src.clone(), f: f, id: cx.p.rst_directive, rst: true };
    directive_method(mut cx, mut md, dm, mut state);
    end
}

// BaseDirective.parse_method
fn directive_method(cx: mut ref Ctx, md: mut ref Md, dm: ref Dm, state: mut ref BState) {
    let kind = dm_type(cx, dm);
    let plugin = directive_of(md, dm.rst, kind);
    let tokens: Vec[V] = if plugin.len() == 0 {
        let mut one: Vec[V] = Vec.new();
        one.push(tok_raw("block_error", group0(dm.s, dm.f)));
        one
    } else {
        match directive_plugin(mut cx, mut md, plugin, dm, mut state) {
            Ok(t) => t,
            Err(e) => {
                let mut one: Vec[V] = Vec.new();
                one.push(tok_raw("block_error", e));
                one
            }
        }
    };
    for t in tokens {
        state.tokens.push(t.clone());
    }
}

// DirectiveParser.parse_tokens
fn directive_tokens(cx: mut ref Ctx, md: mut ref Md, rst: bool, text: own Vec[i64], state: ref BState) -> Vec[V] {
    let name = if rst { "rst_directive" } else { "fenced_directive" };
    let rules = if state.depth >= md.max_nested_level - 1 and has_rule(md.brules, name) {
        remove_rule(md.brules, name)
    } else {
        md.brules.clone()
    };
    let mut child = child_state(state, text);
    block_parse(mut cx, mut md, mut child, rules);
    child.tokens
}

// The plugin's parse; Err is the ValueError's text.
fn directive_plugin(cx: mut ref Ctx, md: mut ref Md, plugin: ref String, dm: ref Dm, state: mut ref BState) -> Result[Vec[V], Vec[i64]] {
    let mut out: Vec[V] = Vec.new();
    if *plugin == "admonition" {
        let name = dm_type(cx, dm);
        let mut attrs = dict();
        put(mut attrs, "name", V.S(name.clone()));
        let options = dm_options(mut cx, dm);
        if let Some(c) = opt(options, "class") {
            put(mut attrs, "class", V.S(c));
        }
        let mut title = dm_title(cx, dm);
        if title.len() == 0 {
            title = capitalize(name);
        }
        let content = dm_content(cx, dm);
        let mut children: Vec[V] = Vec.new();
        children.push(tok_t("admonition_title", title));
        children.push(tok_children("admonition_content", directive_tokens(mut cx, mut md, dm.rst, content, state)));
        let mut t = tok_children("admonition", children);
        put(mut t, "attrs", attrs);
        out.push(t);
    } else if *plugin == "toc" {
        out.push(parse_toc(mut cx, dm)?);
    } else if *plugin == "include" {
        return parse_include(mut cx, mut md, dm, mut state);
    } else if *plugin == "image" {
        let options = dm_options(mut cx, dm);
        let mut attrs = image_attrs(mut cx, options);
        put(mut attrs, "src", V.S(dm_title(cx, dm)));
        let mut t = tok("block_image");
        put(mut t, "attrs", attrs);
        out.push(t);
    } else if *plugin == "figure" {
        let options = dm_options(mut cx, dm);
        let mut image = image_attrs(mut cx, options);
        put(mut image, "src", V.S(dm_title(cx, dm)));
        let align = pop(mut image, "align");
        let mut fig = dict();
        if truthy(align) {
            put(mut fig, "align", align);
        }
        for k in ["figwidth", "figclass"] {
            if let Some(v) = opt(options, k) {
                put(mut fig, k, V.S(v));
            }
        }
        let mut img = tok("block_image");
        put(mut img, "attrs", image);
        let mut children: Vec[V] = Vec.new();
        children.push(img);
        let content = dm_content(cx, dm);
        if content.len() > 0 {
            let mut tokens = directive_tokens(mut cx, mut md, dm.rst, content, state);
            if is_type(tokens[0], "paragraph") {
                set_type(mut tokens[0], "figcaption");
                let caption = tokens.remove(0);
                children.push(caption);
                if tokens.len() > 0 {
                    children.push(tok_children("legend", tokens));
                }
            }
        }
        let mut t = tok("figure");
        put(mut t, "attrs", fig);
        put(mut t, "children", V.L(children));
        out.push(t);
    }
    Ok(out)
}

fn capitalize(s: ref Vec[i64]) -> Vec[i64] {
    if s.len() == 0 {
        return Vec.new();
    }
    let mut out = py_upper(sl(s, 0, 1));
    push_all(mut out, py_lower(tail(s, 1)));
    out
}

// int() of an option: None when Python's int() would refuse it.
fn py_int(s: ref Vec[i64]) -> Option[i64] {
    let t = strip(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    if i >= t.len() {
        return None;
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if c >= 48 and c <= 57 {
            v = v * 10 + (c - 48);
            prev_digit = true;
        } else if c == 95 and prev_digit and i + 1 < t.len() {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if not prev_digit {
        return None;
    }
    Some(if neg { -v } else { v })
}

fn toc_level(options: ref Vec[(Vec[i64], Vec[i64])], name: Str, default: i64) -> Result[i64, Vec[i64]] {
    match opt(options, name) {
        Some(level) => {
            if level.len() == 0 {
                return Ok(default);
            }
            match py_int(level) {
                Some(n) => Ok(n),
                None => Err(u(f"\"{name}\" option MUST be integer")),
            }
        }
        None => Ok(default),
    }
}

// TableOfContents.parse, with the default levels 1 to 3.
fn parse_toc(cx: mut ref Ctx, dm: ref Dm) -> Result[V, Vec[i64]] {
    let title = dm_title(cx, dm);
    let options = dm_options(mut cx, dm);
    let mut collapse = false;
    let mut min_level = 1;
    let mut max_level = 3;
    if options.len() > 0 {
        collapse = opt(options, "collapse").is_some();
        min_level = toc_level(options, "min-level", 1)?;
        max_level = toc_level(options, "max-level", 3)?;
        if min_level < 1 {
            return Err(u("\"min-level\" option MUST be >= 1"));
        }
        if max_level > 3 {
            return Err(u("\"max-level\" option MUST be <= 3"));
        }
        if min_level > max_level {
            return Err(u("\"min-level\" option MUST be less than \"max-level\" option"));
        }
    }
    let mut attrs = dict();
    put(mut attrs, "min_level", V.I(min_level));
    put(mut attrs, "max_level", V.I(max_level));
    put(mut attrs, "collapse", V.B(collapse));
    let mut t = tok_t("toc", title);
    put(mut t, "attrs", attrs);
    Ok(t)
}

fn image_attrs(cx: mut ref Ctx, options: ref Vec[(Vec[i64], Vec[i64])]) -> V {
    let mut attrs = dict();
    if let Some(alt) = opt(options, "alt") {
        put(mut attrs, "alt", V.S(alt));
    }
    if let Some(align) = opt(options, "align") {
        for a in ["top", "middle", "bottom", "left", "center", "right"] {
            if eq(align, a) {
                put(mut attrs, "align", V.S(align.clone()));
            }
        }
    }
    let height = opt(options, "height");
    let width = opt(options, "width");
    if let Some(h) = height {
        let mut t = h.clone();
        if h.len() > 0 and rx_match(mut cx.rx, cx.p.num, mut t, 0).is_some() {
            put(mut attrs, "height", V.S(h));
        }
    }
    if let Some(w) = width {
        let mut t = w.clone();
        if w.len() > 0 and rx_match(mut cx.rx, cx.p.num, mut t, 0).is_some() {
            put(mut attrs, "width", V.S(w));
        }
    }
    if let Some(target) = opt(options, "target") {
        put(mut attrs, "target", V.S(escape_url(mut cx, target)));
    }
    attrs
}

// os.path.normpath for the relative and absolute POSIX paths here.
fn normpath(p: ref Vec[i64]) -> Vec[i64] {
    if p.len() == 0 {
        return u(".");
    }
    let absolute = p[0] == 47;
    let mut parts: Vec[Vec[i64]] = Vec.new();
    for comp in split_on(p, "/") {
        if comp.len() == 0 or eq(comp, ".") {
            continue;
        }
        if eq(comp, "..") {
            if parts.len() > 0 and not eq(parts[parts.len() - 1], "..") {
                parts.pop();
                continue;
            }
            if absolute {
                continue;
            }
        }
        parts.push(comp.clone());
    }
    let mut out: Vec[i64] = Vec.new();
    if absolute {
        out.push(47);
    }
    push_all(mut out, join(parts, "/"));
    if out.len() == 0 {
        return u(".");
    }
    out
}

fn dirname(p: ref Vec[i64]) -> Vec[i64] {
    let mut i = p.len() - 1;
    while i >= 0 and p[i] != 47 {
        i -= 1;
    }
    if i < 0 {
        return Vec.new();
    }
    let head = slice(p, 0, i + 1);
    let trimmed = rstrip_of(head, "/");
    if trimmed.len() == 0 { head } else { trimmed }
}

fn path_join(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    if starts(b, "/") or a.len() == 0 {
        return b.clone();
    }
    let mut out = a.clone();
    if not ends(out, "/") {
        out.push(47);
    }
    push_all(mut out, b);
    out
}

// os.path.splitext's extension.
fn splitext_ext(p: ref Vec[i64]) -> Vec[i64] {
    let mut start = 0;
    let mut i = 0;
    while i < p.len() {
        if p[i] == 47 {
            start = i + 1;
        }
        i += 1;
    }
    let base = tail(p, start);
    let mut k = 0;
    while k < base.len() and base[k] == 46 {
        k += 1;
    }
    let mut dot = -1;
    let mut j = k;
    while j < base.len() {
        if base[j] == 46 {
            dot = j;
        }
        j += 1;
    }
    if dot < 0 {
        return Vec.new();
    }
    tail(base, dot)
}

fn is_file(p: ref Vec[i64]) -> bool {
    match fs.metadata(to_string(p)) {
        Ok(m) => not m.is_dir,
        Err(_) => false,
    }
}

// Include.parse
fn parse_include(cx: mut ref Ctx, md: mut ref Md, dm: ref Dm, state: mut ref BState) -> Result[Vec[V], Vec[i64]] {
    let mut out: Vec[V] = Vec.new();
    let source_file = match cx.envs[state.env].file.clone() {
        Some(f) => f,
        None => {
            out.push(tok_raw("block_error", u("Missing source file")));
            return Ok(out);
        }
    };
    let options = dm_options(mut cx, dm);
    let mut attrs = dict();
    for (k, v) in options.iter() {
        put(mut attrs, to_string(k).as_str(), V.S(v.clone()));
    }
    let relpath = dm_title(cx, dm);
    let dest = normpath(path_join(dirname(source_file), relpath));
    if same(dest, source_file) {
        out.push(tok_raw("block_error", ucat("Could not include self: ", relpath)));
        return Ok(out);
    }
    if not is_file(dest) {
        out.push(tok_raw("block_error", ucat("Could not find file: ", relpath)));
        return Ok(out);
    }
    let content = match fs.read_to_string(to_string(dest)) {
        Ok(s) => us(s),
        Err(_) => Vec.new(),
    };
    let ext = splitext_ext(relpath);
    if eq(ext, ".md") or eq(ext, ".markdown") or eq(ext, ".mkd") {
        let env = add_env(mut cx, true);
        cx.envs[env].file = Some(dest);
        let mut new_state = new_bstate(env);
        process(mut new_state, content);
        let rules = md.brules.clone();
        block_parse(mut cx, mut md, mut new_state, rules);
        return Ok(new_state.tokens);
    }
    if eq(ext, ".html") or eq(ext, ".xhtml") or eq(ext, ".htm") {
        out.push(tok_raw("block_html", content));
        return Ok(out);
    }
    put(mut attrs, "filepath", V.S(dest));
    let mut t = tok_raw("include", content);
    put(mut t, "attrs", attrs);
    out.push(t);
    Ok(out)
}

// spoiler.parse_block_spoiler
fn parse_block_spoiler(cx: mut ref Ctx, md: mut ref Md, m: ref Found, rid: i64, state: mut ref BState) -> i64 {
    let (text0, end_pos) = extract_block_quote(mut cx, mut md, m, rid, mut state);
    let mut text = text0;
    if not ends(text, "\n") {
        text.push(10);
    }
    let mut kind = "block_quote";
    if state.depth == 0 {
        let mut t = text.clone();
        if rx_match(mut cx.rx, cx.p.spoiler_match, mut t, 0).is_some() {
            text = rx_sub(mut cx.rx, cx.p.spoiler_start, text, "");
            kind = "block_spoiler";
        }
    }
    let mut child = child_state(state, text);
    let rules = if state.depth >= md.max_nested_level - 1 {
        remove_rule(md.block_quote_rules, "block_quote")
    } else {
        md.block_quote_rules.clone()
    };
    block_parse(mut cx, mut md, mut child, rules);
    let token = tok_children(kind, child.tokens);
    if end_pos > 0 {
        prepend_token(mut state, token);
        return end_pos;
    }
    state.tokens.push(token);
    state.cursor
}

// Registers a directive style with its plugins: FencedDirective (with
// the default markers) or RSTDirective, and each plugin's __call__.
fn use_directives(md: mut ref Md, rst: bool, plugins: ref Vec[String]) -> Result[(), String] {
    let style = if rst { "rst" } else { "fenced" };
    for p in plugins.iter() {
        if *p == "admonition" {
            for name in ["attention", "caution", "danger", "error", "hint", "important", "note", "tip", "warning"] {
                md.directives.push((style.to_string(), name.to_string(), "admonition".to_string()));
            }
            if md.renderer == "ast" {
                return Err("AttributeError: 'NoneType' object has no attribute 'NAME'".to_string());
            }
            render_register(mut md, "admonition");
            render_register(mut md, "admonition_title");
            render_register(mut md, "admonition_content");
        } else if *p == "toc" {
            if html_renderer(md) {
                md.directives.push((style.to_string(), "toc".to_string(), "toc".to_string()));
                md.before_render.push("toc_directive".to_string());
                render_register(mut md, "toc");
            }
        } else if *p == "include" {
            md.directives.push((style.to_string(), "include".to_string(), "include".to_string()));
            render_register(mut md, "include");
        } else if *p == "image" or *p == "figure" {
            md.directives.push((style.to_string(), p.clone(), p.clone()));
            if md.renderer == "ast" {
                return Err("AttributeError: 'NoneType' object has no attribute 'NAME'".to_string());
            }
            render_register(mut md, "block_image");
            if *p == "figure" {
                render_register(mut md, "figure");
                render_register(mut md, "figcaption");
                render_register(mut md, "legend");
            }
        } else {
            return Err(f"KeyError: '{p}'");
        }
    }
    if rst {
        block_register(mut md, "rst_directive", Some(u(pat_rst_directive_start())), "rst_directive", "");
        md.rst = true;
    } else {
        block_register(mut md, "fenced_code", None, "fenced_directive_code", "");
        md.fenced = true;
    }
    Ok(())
}
// --------------------------------------------------------- markdown.py

// Markdown._iter_render: each token's text goes through the inline
// parser, children first.
fn iter_render(cx: mut ref Ctx, md: mut ref Md, tokens: mut ref Vec[V], env: i64) {
    for t in tokens.iter_mut() {
        if has(t, "children") {
            if let V.D(items) = t {
                for (k, v) in items.iter_mut() {
                    if k == "children" {
                        if let V.L(l) = v {
                            iter_render(mut cx, mut md, mut l, env);
                        }
                        break;
                    }
                }
            }
        } else if has(t, "text") {
            let text = match pop(mut t, "text") {
                V.S(s) => s,
                _ => Vec.new(),
            };
            // strips only these, not the other Unicode spaces
            let children = inline_call(mut cx, mut md, strip_of(text, " \r\n\t\u{c}"), env);
            put(mut t, "children", V.L(children));
        }
    }
}

// What a render gives: text, or the token list when there is no
// renderer.
enum Out {
    Text(Vec[i64]),
    Toks(Vec[V]),
}

// Markdown.render_state
fn render_state(cx: mut ref Ctx, md: mut ref Md, tokens: mut ref Vec[V], env: i64) -> Result[Out, String] {
    iter_render(mut cx, mut md, mut tokens, env);
    if md.renderer == "ast" {
        return Ok(Out.Toks(tokens.clone()));
    }
    if md.renderer == "html" {
        return Ok(Out.Text(html_tokens(mut cx, md, tokens)?));
    }
    if md.renderer == "markdown" {
        let mut out = md_tokens(mut cx, md, tokens)?;
        let mut refs: Vec[Vec[i64]] = Vec.new();
        for (_, attrs) in cx.envs[env].ref_links.iter() {
            let mut text = wrap("[", get_s(attrs, "label"), "]: ");
            push_all(mut text, get_s(attrs, "url"));
            let title = get(attrs, "title");
            if truthy(title) {
                push_str(mut text, " \"");
                push_all(mut text, get_s(attrs, "title"));
                push_str(mut text, "\"");
            }
            refs.push(text);
        }
        push_all(mut out, join(refs, "\n\n"));
        out.push(10);
        return Ok(Out.Text(strip_end(mut cx, out)));
    }
    // rst
    cx.envs[env].inline_images = Vec.new();
    let mut out = rst_tokens(mut cx, md, tokens, env)?;
    let images = cx.envs[env].inline_images.clone();
    let mut refs: Vec[Vec[i64]] = Vec.new();
    let mut index = 0;
    for image in images.iter() {
        let alt = rst_tokens(mut cx, md, children_of(image), env)?;
        let mut text = u(f".. |img-{index}| image:: ");
        push_all(mut text, get_s(get(image, "attrs"), "url"));
        push_str(mut text, "\n   :alt: ");
        push_all(mut text, alt);
        refs.push(text);
        index += 1;
    }
    push_all(mut out, join(refs, "\n\n"));
    out.push(10);
    Ok(Out.Text(strip_end(mut cx, out)))
}

fn normalize_newlines(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if s[i] == 13 {
            out.push(10);
            if i + 1 < s.len() and s[i + 1] == 10 {
                i += 1;
            }
        } else {
            out.push(s[i]);
        }
        i += 1;
    }
    if not ends(out, "\n") {
        out.push(10);
    }
    out
}

// Markdown.parse: the result and the parsed state.
fn md_parse(cx: mut ref Ctx, md: mut ref Md, s: ref Vec[i64], file: own Option[Vec[i64]]) -> Result[(Out, BState), String] {
    let env = add_env(mut cx, true);
    cx.envs[env].file = file;
    let mut state = new_bstate(env);
    process(mut state, normalize_newlines(s));
    let rules = md.brules.clone();
    block_parse(mut cx, mut md, mut state, rules);
    let hooks = md.before_render.clone();
    for h in hooks.iter() {
        if *h == "task_lists" {
            task_lists_hook(mut cx, mut state.tokens);
        } else if *h == "toc_directive" {
            toc_directive_hook(mut cx, mut md, mut state.tokens);
        }
    }
    if let Some((lo, hi)) = md.toc_hook {
        add_toc_hook(mut cx, mut md, mut state, lo, hi);
    }
    let mut result = render_state(mut cx, mut md, mut state.tokens, env)?;
    let after = md.after_render.clone();
    for h in after.iter() {
        if *h == "footnotes" {
            result = footnotes_hook(mut cx, mut md, result, env)?;
        }
    }
    Ok((result, state))
}

fn footnotes_hook(cx: mut ref Ctx, md: mut ref Md, result: own Out, env: i64) -> Result[Out, String] {
    let notes = cx.envs[env].footnotes.clone();
    if notes.len() == 0 {
        return Ok(result);
    }
    let mut children: Vec[V] = Vec.new();
    let mut i = 0;
    while i < notes.len() {
        children.push(footnote_item(mut cx, env, notes[i], i + 1));
        i += 1;
    }
    let env2 = add_env(mut cx, true);
    let mut tokens: Vec[V] = Vec.new();
    tokens.push(tok_children("footnotes", children));
    let output = render_state(mut cx, mut md, mut tokens, env2)?;
    match result {
        Out.Text(a) => match output {
            Out.Text(b) => Ok(Out.Text(cat(a, b))),
            Out.Toks(_) => Ok(Out.Text(a)),
        },
        Out.Toks(a) => match output {
            Out.Toks(b) => {
                let mut all = a;
                for t in b {
                    all.push(t.clone());
                }
                Ok(Out.Toks(all))
            }
            Out.Text(_) => Ok(Out.Toks(a)),
        },
    }
}

// ------------------------------------------------------------ toc.py

// normalize_toc_item: (level, id, text) of a heading.
fn normalize_toc_item(cx: mut ref Ctx, md: mut ref Md, t: ref V) -> Result[(i64, Vec[i64], Vec[i64]), String] {
    let text = get_s(t, "text");
    let env = add_env(mut cx, false);
    let tokens = inline_call(mut cx, mut md, text, env);
    let html = html_tokens(mut cx, md, tokens)?;
    let level = get_i(get(t, "attrs"), "level");
    let id = get_s(get(t, "attrs"), "id");
    Ok((level, id, striptags(mut cx, html)))
}

fn add_toc_hook(cx: mut ref Ctx, md: mut ref Md, state: mut ref BState, lo: i64, hi: i64) {
    let mut items: Vec[(i64, Vec[i64], Vec[i64])] = Vec.new();
    let mut i = 0;
    let n = state.tokens.len();
    let mut k = 0;
    while k < n {
        if is_type(state.tokens[k], "heading") {
            let level = get_i(get(state.tokens[k], "attrs"), "level");
            if lo <= level and level <= hi {
                put_attr(mut state.tokens[k], "id", V.S(u(f"toc_{i + 1}")));
                let t = state.tokens[k].clone();
                if let Ok(item) = normalize_toc_item(mut cx, mut md, t) {
                    items.push(item);
                }
                i += 1;
            }
        }
        k += 1;
    }
    cx.envs[state.env].toc_items = Some(items);
}

fn toc_directive_hook(cx: mut ref Ctx, md: mut ref Md, tokens: mut ref Vec[V]) {
    let mut has_section = false;
    for t in tokens.iter() {
        if is_type(t, "toc") {
            has_section = true;
        }
    }
    if not has_section {
        return;
    }
    let mut items: Vec[(i64, Vec[i64], Vec[i64])] = Vec.new();
    let mut i = 0;
    let n = tokens.len();
    let mut k = 0;
    while k < n {
        if is_type(tokens[k], "heading") {
            put_attr(mut tokens[k], "id", V.S(u(f"toc_{i + 1}")));
            let t = tokens[k].clone();
            if let Ok(item) = normalize_toc_item(mut cx, mut md, t) {
                items.push(item);
            }
            i += 1;
        }
        k += 1;
    }
    k = 0;
    while k < n {
        if is_type(tokens[k], "toc") {
            let lo = get_i(get(tokens[k], "attrs"), "min_level");
            let hi = get_i(get(tokens[k], "attrs"), "max_level");
            let mut toc: Vec[V] = Vec.new();
            for (level, id, text) in items.iter() {
                if lo <= level and level <= hi {
                    let mut tup: Vec[V] = Vec.new();
                    tup.push(V.I(level));
                    tup.push(V.S(id.clone()));
                    tup.push(V.S(text.clone()));
                    toc.push(V.L(tup));
                }
            }
            put_attr(mut tokens[k], "toc", V.L(toc));
        }
        k += 1;
    }
}

fn render_toc_ul(toc: ref Vec[(i64, Vec[i64], Vec[i64])]) -> Vec[i64] {
    if toc.len() == 0 {
        return Vec.new();
    }
    let mut s = u("<ul>\n");
    let mut levels: Vec[i64] = Vec.new();
    for (level0, k, text) in toc.iter() {
        let level = level0;
        let mut item = wrap("<a href=\"#", k, "\">");
        push_all(mut item, text);
        push_str(mut item, "</a>");
        if levels.len() == 0 {
            push_str(mut s, "<li>");
            push_all(mut s, item);
            levels.push(level);
        } else if level == levels[levels.len() - 1] {
            push_str(mut s, "</li>\n<li>");
            push_all(mut s, item);
        } else if level > levels[levels.len() - 1] {
            push_str(mut s, "\n<ul>\n<li>");
            push_all(mut s, item);
            levels.push(level);
        } else {
            levels.pop();
            let mut placed = false;
            while levels.len() > 0 {
                let last_level = levels.pop().unwrap();
                if level == last_level {
                    push_str(mut s, "</li>\n</ul>\n</li>\n<li>");
                    push_all(mut s, item);
                    levels.push(level);
                    placed = true;
                    break;
                } else if level > last_level {
                    push_str(mut s, "</li>\n<li>");
                    push_all(mut s, item);
                    levels.push(last_level);
                    levels.push(level);
                    placed = true;
                    break;
                } else {
                    push_str(mut s, "</li>\n</ul>\n");
                }
            }
            if not placed {
                levels.push(level);
                push_str(mut s, "</li>\n<li>");
                push_all(mut s, item);
            }
        }
    }
    while levels.len() > 1 {
        push_str(mut s, "</li>\n</ul>\n");
        levels.pop();
    }
    push_str(mut s, "</li>\n</ul>\n");
    s
}

fn toc_tuples(v: ref V) -> Vec[(i64, Vec[i64], Vec[i64])] {
    let mut out: Vec[(i64, Vec[i64], Vec[i64])] = Vec.new();
    if let V.L(l) = v {
        for t in l.iter() {
            if let V.L(parts) = t {
                let level = if let V.I(n) = parts[0] { n } else { 0 };
                let id = if let V.S(s) = parts[1] { s.clone() } else { Vec.new() };
                let text = if let V.S(s) = parts[2] { s.clone() } else { Vec.new() };
                out.push((level, id, text));
            }
        }
    }
    out
}

// ---------------------------------------------------- the HTML renderer

fn no_renderer(kind: ref String) -> String {
    f"AttributeError: No renderer \"'{kind}'\""
}

fn html_has(md: ref Md, kind: ref String) -> bool {
    for k in ["text", "emphasis", "strong", "link", "image", "codespan", "linebreak", "softbreak", "inline_html", "paragraph", "heading", "blank_line", "thematic_break", "block_text", "block_code", "block_quote", "block_html", "block_error", "list", "list_item"] {
        if *kind == k {
            return true;
        }
    }
    for k in md.rnames.iter() {
        if k == kind {
            return true;
        }
    }
    false
}

fn html_tokens(cx: mut ref Ctx, md: ref Md, tokens: ref Vec[V]) -> Result[Vec[i64], String] {
    let mut out: Vec[i64] = Vec.new();
    for t in tokens.iter() {
        let s = html_token(mut cx, md, t)?;
        push_all(mut out, s);
    }
    Ok(out)
}

fn safe_url(url: ref Vec[i64]) -> Vec[i64] {
    let lower = py_lower(url);
    let harmful = starts(lower, "javascript:") or starts(lower, "vbscript:") or starts(lower, "file:") or starts(lower, "data:");
    let good = starts(lower, "data:image/gif;") or starts(lower, "data:image/png;") or starts(lower, "data:image/jpeg;") or starts(lower, "data:image/webp;");
    if harmful and not good {
        return u("#harmful-link");
    }
    url.clone()
}

fn html_token(cx: mut ref Ctx, md: ref Md, t: ref V) -> Result[Vec[i64], String] {
    let kind = ttype(t);
    if not html_has(md, kind) {
        return Err(no_renderer(kind));
    }
    let attrs = get(t, "attrs");
    let text = if has(t, "raw") {
        get_s(t, "raw")
    } else if has(t, "children") {
        html_tokens(mut cx, md, children_of(t))?
    } else {
        Vec.new()
    };
    let k = kind.as_str();
    let mut out: Vec[i64] = Vec.new();
    if k == "text" {
        return Ok(if md.escape { esc(text) } else { safe_entity(mut cx, text) });
    }
    if k == "emphasis" {
        return Ok(wrap("<em>", text, "</em>"));
    }
    if k == "strong" {
        return Ok(wrap("<strong>", text, "</strong>"));
    }
    if k == "link" {
        out = wrap("<a href=\"", safe_url(get_s(attrs, "url")), "\"");
        let title = get(attrs, "title");
        if truthy(title) {
            push_all(mut out, wrap(" title=\"", safe_entity(mut cx, get_s(attrs, "title")), "\""));
        }
        out.push(62);
        push_all(mut out, text);
        push_str(mut out, "</a>");
        return Ok(out);
    }
    if k == "image" {
        let src = safe_url(get_s(attrs, "url"));
        let alt = esc(striptags(mut cx, text));
        out = wrap("<img src=\"", src, "\" alt=\"");
        push_all(mut out, alt);
        out.push(34);
        if truthy(get(attrs, "title")) {
            push_all(mut out, wrap(" title=\"", safe_entity(mut cx, get_s(attrs, "title")), "\""));
        }
        push_str(mut out, " />");
        return Ok(out);
    }
    if k == "codespan" {
        return Ok(wrap("<code>", text, "</code>"));
    }
    if k == "linebreak" {
        return Ok(u("<br />\n"));
    }
    if k == "softbreak" {
        return Ok(u("\n"));
    }
    if k == "inline_html" {
        return Ok(if md.escape { esc(text) } else { text });
    }
    if k == "paragraph" {
        return Ok(wrap("<p>", text, "</p>\n"));
    }
    if k == "heading" {
        let tag = u(f"h{get_i(attrs, "level")}");
        out = ucat("<", tag);
        if truthy(get(attrs, "id")) {
            push_all(mut out, wrap(" id=\"", get_s(attrs, "id"), "\""));
        }
        out.push(62);
        push_all(mut out, text);
        push_all(mut out, wrap("</", tag, ">\n"));
        return Ok(out);
    }
    if k == "blank_line" {
        return Ok(Vec.new());
    }
    if k == "thematic_break" {
        return Ok(u("<hr />\n"));
    }
    if k == "block_text" {
        return Ok(text);
    }
    if k == "block_code" {
        out = u("<pre><code");
        let info_v = get(attrs, "info");
        if let V.S(info0) = info_v {
            let info = safe_entity(mut cx, strip(info0));
            if info.len() > 0 {
                let lang = split_ws(info)[0].clone();
                push_all(mut out, wrap(" class=\"language-", lang, "\""));
            }
        }
        out.push(62);
        push_all(mut out, esc(text));
        push_str(mut out, "</code></pre>\n");
        return Ok(out);
    }
    if k == "block_quote" {
        return Ok(wrap("<blockquote>\n", text, "</blockquote>\n"));
    }
    if k == "block_html" {
        if md.escape {
            return Ok(wrap("<p>", esc(strip(text)), "</p>\n"));
        }
        return Ok(catu(text, "\n"));
    }
    if k == "block_error" {
        return Ok(wrap("<div class=\"error\"><pre>", text, "</pre></div>\n"));
    }
    if k == "list" {
        if get_b(attrs, "ordered") {
            out = u("<ol");
            let start = get(attrs, "start");
            if let V.I(n) = start {
                push_str(mut out, f" start=\"{n}\"");
            }
            push_str(mut out, ">\n");
            push_all(mut out, text);
            push_str(mut out, "</ol>\n");
            return Ok(out);
        }
        return Ok(wrap("<ul>\n", text, "</ul>\n"));
    }
    if k == "list_item" {
        return Ok(wrap("<li>", text, "</li>\n"));
    }
    plugin_html(mut cx, k, text, attrs)
}

fn plugin_html(cx: mut ref Ctx, k: Str, text: own Vec[i64], attrs: ref V) -> Result[Vec[i64], String] {
    let mut out: Vec[i64] = Vec.new();
    if k == "strikethrough" {
        return Ok(wrap("<del>", text, "</del>"));
    }
    if k == "mark" {
        return Ok(wrap("<mark>", text, "</mark>"));
    }
    if k == "insert" {
        return Ok(wrap("<ins>", text, "</ins>"));
    }
    if k == "superscript" {
        return Ok(wrap("<sup>", text, "</sup>"));
    }
    if k == "subscript" {
        return Ok(wrap("<sub>", text, "</sub>"));
    }
    if k == "table" {
        return Ok(wrap("<table>\n", text, "</table>\n"));
    }
    if k == "table_head" {
        return Ok(wrap("<thead>\n<tr>\n", text, "</tr>\n</thead>\n"));
    }
    if k == "table_body" {
        return Ok(wrap("<tbody>\n", text, "</tbody>\n"));
    }
    if k == "table_row" {
        return Ok(wrap("<tr>\n", text, "</tr>\n"));
    }
    if k == "table_cell" {
        let tag = if get_b(attrs, "head") { "th" } else { "td" };
        out = u(f"  <{tag}");
        if truthy(get(attrs, "align")) {
            push_all(mut out, wrap(" style=\"text-align:", get_s(attrs, "align"), "\""));
        }
        out.push(62);
        push_all(mut out, text);
        push_str(mut out, f"</{tag}>\n");
        return Ok(out);
    }
    if k == "footnote_ref" {
        let i = get_i(attrs, "index");
        return Ok(u(f"<sup class=\"footnote-ref\" id=\"fnref-{i}\"><a href=\"#fn-{i}\">{i}</a></sup>"));
    }
    if k == "footnotes" {
        return Ok(wrap("<section class=\"footnotes\">\n<ol>\n", text, "</ol>\n</section>\n"));
    }
    if k == "footnote_item" {
        let i = get_i(attrs, "index");
        let body = sl(rstrip(text), 0, -4);
        out = u(f"<li id=\"fn-{i}\">");
        push_all(mut out, body);
        push_str(mut out, f"<a href=\"#fnref-{i}\" class=\"footnote\">&#8617;</a></p></li>\n");
        return Ok(out);
    }
    if k == "task_list_item" {
        let mut checkbox = u("<input class=\"task-list-item-checkbox\" type=\"checkbox\" disabled");
        if get_b(attrs, "checked") {
            push_str(mut checkbox, " checked/>");
        } else {
            push_str(mut checkbox, "/>");
        }
        let body = if starts(text, "<p>") {
            replace_v(text, u("<p>"), ucat("<p>", checkbox), 1)
        } else {
            cat(checkbox, text)
        };
        return Ok(wrap("<li class=\"task-list-item\">", body, "</li>\n"));
    }
    if k == "abbr" {
        let title = get(attrs, "title");
        if not truthy(title) {
            return Ok(wrap("<abbr>", text, "</abbr>"));
        }
        out = wrap("<abbr title=\"", esc(get_s(attrs, "title")), "\">");
        push_all(mut out, text);
        push_str(mut out, "</abbr>");
        return Ok(out);
    }
    if k == "def_list" {
        return Ok(wrap("<dl>\n", text, "</dl>\n"));
    }
    if k == "def_list_head" {
        return Ok(wrap("<dt>", text, "</dt>\n"));
    }
    if k == "def_list_item" {
        return Ok(wrap("<dd>", text, "</dd>\n"));
    }
    if k == "block_math" {
        return Ok(wrap("<div class=\"math\">$$\n", text, "\n$$</div>\n"));
    }
    if k == "inline_math" {
        return Ok(wrap("<span class=\"math\">\\(", text, "\\)</span>"));
    }
    if k == "ruby" {
        out = wrap("<ruby><rb>", text, "</rb><rt>");
        push_all(mut out, get_s(attrs, "rt"));
        push_str(mut out, "</rt></ruby>");
        return Ok(out);
    }
    if k == "block_spoiler" {
        return Ok(wrap("<div class=\"spoiler\">\n", text, "</div>\n"));
    }
    if k == "inline_spoiler" {
        return Ok(wrap("<span class=\"spoiler\">", text, "</span>"));
    }
    if k == "admonition" {
        out = ucat("<section class=\"admonition ", get_s(attrs, "name"));
        if truthy(get(attrs, "class")) {
            out.push(32);
            push_all(mut out, get_s(attrs, "class"));
        }
        push_str(mut out, "\">\n");
        push_all(mut out, text);
        push_str(mut out, "</section>\n");
        return Ok(out);
    }
    if k == "admonition_title" {
        return Ok(wrap("<p class=\"admonition-title\">", text, "</p>\n"));
    }
    if k == "admonition_content" {
        return Ok(text);
    }
    if k == "toc" {
        let title = if text.len() == 0 { u("Table of Contents") } else { text };
        if not has(attrs, "toc") {
            return Err("KeyError: 'toc'".to_string());
        }
        let content = render_toc_ul(toc_tuples(get(attrs, "toc")));
        out = u("<details class=\"toc\"");
        if not get_b(attrs, "collapse") {
            push_str(mut out, " open");
        }
        push_str(mut out, ">\n<summary>");
        push_all(mut out, title);
        push_str(mut out, "</summary>\n");
        push_all(mut out, content);
        push_str(mut out, "</details>\n");
        return Ok(out);
    }
    if k == "include" {
        return Ok(wrap("<pre class=\"directive-include\">\n", text, "</pre>\n"));
    }
    if k == "block_image" {
        return Ok(block_image(attrs));
    }
    if k == "figure" {
        let mut cls = u("figure");
        if truthy(get(attrs, "align")) {
            push_all(mut cls, ucat(" align-", get_s(attrs, "align")));
        }
        if truthy(get(attrs, "figclass")) {
            cls.push(32);
            push_all(mut cls, get_s(attrs, "figclass"));
        }
        out = wrap("<figure class=\"", cls, "\"");
        if truthy(get(attrs, "figwidth")) {
            push_all(mut out, wrap(" style=\"width:", get_s(attrs, "figwidth"), "\""));
        }
        push_str(mut out, ">\n");
        push_all(mut out, text);
        push_str(mut out, "</figure>\n");
        return Ok(out);
    }
    if k == "figcaption" {
        return Ok(wrap("<figcaption>", text, "</figcaption>\n"));
    }
    if k == "legend" {
        return Ok(wrap("<div class=\"legend\">\n", text, "</div>\n"));
    }
    Err(no_renderer(k.to_string()))
}

fn block_image(attrs: ref V) -> Vec[i64] {
    let mut img = wrap("<img src=\"", get_s(attrs, "src"), "\"");
    let mut style: Vec[i64] = Vec.new();
    if truthy(get(attrs, "alt")) {
        push_all(mut img, wrap(" alt=\"", esc(get_s(attrs, "alt")), "\""));
    }
    if truthy(get(attrs, "width")) {
        let w = get_s(attrs, "width");
        if is_digit_text(w) {
            push_all(mut img, wrap(" width=\"", w, "\""));
        } else {
            push_all(mut style, wrap("width:", w, ";"));
        }
    }
    if truthy(get(attrs, "height")) {
        let h = get_s(attrs, "height");
        if is_digit_text(h) {
            push_all(mut img, wrap(" height=\"", h, "\""));
        } else {
            push_all(mut style, wrap("height:", h, ";"));
        }
    }
    if style.len() > 0 {
        push_all(mut img, wrap(" style=\"", esc(style), "\""));
    }
    push_str(mut img, " />");
    let mut cls = u("block-image");
    if truthy(get(attrs, "align")) {
        push_all(mut cls, ucat(" align-", get_s(attrs, "align")));
    }
    if truthy(get(attrs, "target")) {
        let href = esc(safe_url(get_s(attrs, "target")));
        let mut out = wrap("<a class=\"", cls, "\" href=\"");
        push_all(mut out, href);
        push_str(mut out, "\">");
        push_all(mut out, img);
        push_str(mut out, "</a>\n");
        return out;
    }
    let mut out = wrap("<div class=\"", cls, "\">");
    push_all(mut out, img);
    push_str(mut out, "</div>\n");
    out
}

// --------------------------------------------- the Markdown and RST lists

// renderers/_list.render_list; `parent` is the parent list's
// (leading, tight) when the list is inside another.
fn render_list(cx: mut ref Ctx, md: ref Md, t: ref V, parent: Option[bool], env: i64) -> Result[Vec[i64], String] {
    let attrs = get(t, "attrs");
    let bullet = get_s(t, "bullet");
    let tight = get_b(t, "tight");
    let mut text: Vec[i64] = Vec.new();
    if get_b(attrs, "ordered") {
        let mut start = match get(attrs, "start") {
            V.I(n) => n,
            _ => 1,
        };
        for item in children_of(t).iter() {
            let leading = cat(num_text(start), catu(bullet, " "));
            push_all(mut text, render_list_item(mut cx, md, leading, tight, item, env)?);
            start += 1;
        }
    } else {
        let leading = catu(bullet, " ");
        for item in children_of(t).iter() {
            push_all(mut text, render_list_item(mut cx, md, leading, tight, item, env)?);
        }
    }
    match parent {
        Some(parent_tight) => {
            if parent_tight {
                return Ok(text);
            }
            Ok(catu(text, "\n"))
        }
        None => Ok(catu(strip_end(mut cx, text), "\n")),
    }
}

fn render_list_item(cx: mut ref Ctx, md: ref Md, leading: ref Vec[i64], tight: bool, item: ref V, env: i64) -> Result[Vec[i64], String] {
    let mut text: Vec[i64] = Vec.new();
    for t in children_of(item).iter() {
        if is_type(t, "list") {
            push_all(mut text, render_list(mut cx, md, t, Some(tight), env)?);
            continue;
        }
        if is_type(t, "blank_line") {
            continue;
        }
        let s = if md.renderer == "markdown" { md_token(mut cx, md, t)? } else { rst_token(mut cx, md, t, None, env)? };
        push_all(mut text, s);
    }
    let lines = split_lines(text, false);
    let mut out = if lines.len() > 0 { lines[0].clone() } else { Vec.new() };
    out.push(10);
    let prefix = spaces(leading.len());
    let mut i = 1;
    while i < lines.len() {
        if lines[i].len() > 0 {
            push_all(mut out, prefix);
            push_all(mut out, lines[i]);
        }
        out.push(10);
        i += 1;
    }
    Ok(cat(leading, out))
}

// ---------------------------------------------- the Markdown renderer

fn md_has(kind: ref String) -> bool {
    for k in ["text", "emphasis", "strong", "link", "image", "codespan", "linebreak", "softbreak", "blank_line", "inline_html", "paragraph", "heading", "thematic_break", "block_text", "block_code", "block_quote", "block_html", "block_error", "list"] {
        if *kind == k {
            return true;
        }
    }
    false
}

fn md_tokens(cx: mut ref Ctx, md: ref Md, tokens: ref Vec[V]) -> Result[Vec[i64], String] {
    let mut out: Vec[i64] = Vec.new();
    for t in tokens.iter() {
        push_all(mut out, md_token(mut cx, md, t)?);
    }
    Ok(out)
}

fn md_link(cx: mut ref Ctx, md: ref Md, t: ref V) -> Result[Vec[i64], String] {
    let label = get(t, "label");
    let text = md_tokens(mut cx, md, children_of(t))?;
    let mut out = wrap("[", text, "]");
    if truthy(label) {
        push_all(mut out, wrap("[", get_s(t, "label"), "]"));
        return Ok(out);
    }
    let attrs = get(t, "attrs");
    let url = get_s(attrs, "url");
    let has_title = truthy(get(attrs, "title"));
    if same(text, url) and not has_title {
        return Ok(wrap("<", text, ">"));
    } else if same(ucat("mailto:", text), url) and not has_title {
        return Ok(wrap("<", text, ">"));
    }
    out.push(40);
    if has_char(url, 40) or has_char(url, 41) {
        push_all(mut out, wrap("<", url, ">"));
    } else {
        push_all(mut out, url);
    }
    if has_title {
        push_all(mut out, wrap(" \"", get_s(attrs, "title"), "\""));
    }
    out.push(41);
    Ok(out)
}

fn md_token(cx: mut ref Ctx, md: ref Md, t: ref V) -> Result[Vec[i64], String] {
    let kind = ttype(t);
    if not md_has(kind) {
        return Err(no_renderer(kind));
    }
    let k = kind.as_str();
    if k == "text" or k == "inline_html" {
        return Ok(get_s(t, "raw"));
    }
    if k == "emphasis" {
        return Ok(wrap("*", md_tokens(mut cx, md, children_of(t))?, "*"));
    }
    if k == "strong" {
        return Ok(wrap("**", md_tokens(mut cx, md, children_of(t))?, "**"));
    }
    if k == "link" {
        return md_link(mut cx, md, t);
    }
    if k == "image" {
        return Ok(ucat("!", md_link(mut cx, md, t)?));
    }
    if k == "codespan" {
        return Ok(wrap("`", get_s(t, "raw"), "`"));
    }
    if k == "linebreak" {
        return Ok(u("  \n"));
    }
    if k == "softbreak" {
        return Ok(u("\n"));
    }
    if k == "blank_line" or k == "block_error" {
        return Ok(Vec.new());
    }
    if k == "paragraph" {
        return Ok(catu(md_tokens(mut cx, md, children_of(t))?, "\n\n"));
    }
    if k == "heading" {
        let level = get_i(get(t, "attrs"), "level");
        let mut out = repeat(35, level);
        out.push(32);
        push_all(mut out, md_tokens(mut cx, md, children_of(t))?);
        push_str(mut out, "\n\n");
        return Ok(out);
    }
    if k == "thematic_break" {
        return Ok(u("***\n\n"));
    }
    if k == "block_text" {
        return Ok(catu(md_tokens(mut cx, md, children_of(t))?, "\n"));
    }
    if k == "block_code" {
        let attrs = get(t, "attrs");
        let info = get_s(attrs, "info");
        let mut code = get_s(t, "raw");
        if code.len() > 0 and code[code.len() - 1] != 10 {
            code.push(10);
        }
        let mut marker = get_s(t, "marker");
        if marker.len() == 0 {
            marker = fenced_marker(mut cx, code);
        }
        let mut out = cat(marker, info);
        out.push(10);
        push_all(mut out, code);
        push_all(mut out, marker);
        push_str(mut out, "\n\n");
        return Ok(out);
    }
    if k == "block_quote" {
        return Ok(catu(indent(md_tokens(mut cx, md, children_of(t))?, "> "), "\n\n"));
    }
    if k == "block_html" {
        return Ok(catu(get_s(t, "raw"), "\n\n"));
    }
    render_list(mut cx, md, t, None, 0)
}

fn fenced_marker(cx: mut ref Ctx, code: ref Vec[i64]) -> Vec[i64] {
    let mut c = code.clone();
    let found = rx_all(mut cx.rx, cx.p.fenced_marker, mut c);
    if found.len() == 0 {
        return u("```");
    }
    let mut ticks: Vec[i64] = Vec.new();
    let mut waves: Vec[i64] = Vec.new();
    for f in found.iter() {
        if c[f.start] == 96 {
            ticks.push(f.end - f.start);
        } else {
            waves.push(f.end - f.start);
        }
    }
    if ticks.len() == 0 {
        return u("```");
    }
    if waves.len() == 0 {
        return u("~~~");
    }
    let mut most = 0;
    for n in ticks.iter() {
        if *n > most {
            most = *n;
        }
    }
    repeat(96, most + 1)
}

// ---------------------------------------------------- the RST renderer

fn rst_tokens(cx: mut ref Ctx, md: ref Md, tokens: ref Vec[V], env: i64) -> Result[Vec[i64], String] {
    let mut out: Vec[i64] = Vec.new();
    let mut prev = String.new();
    for t in tokens.iter() {
        // iter_tokens skips blank lines and gives each token the one before
        if is_type(t, "blank_line") {
            continue;
        }
        push_all(mut out, rst_token(mut cx, md, t, Some(prev.clone()), env)?);
        prev = ttype(t);
    }
    Ok(out)
}

fn rst_token(cx: mut ref Ctx, md: ref Md, t: ref V, prev: Option[String], env: i64) -> Result[Vec[i64], String] {
    let kind = ttype(t);
    if not md_has(kind) {
        return Err(no_renderer(kind));
    }
    let k = kind.as_str();
    if k == "text" {
        return Ok(replace(get_s(t, "raw"), "|", "\\|"));
    }
    if k == "emphasis" {
        return Ok(wrap("*", rst_tokens(mut cx, md, children_of(t), env)?, "*"));
    }
    if k == "strong" {
        return Ok(wrap("**", rst_tokens(mut cx, md, children_of(t), env)?, "**"));
    }
    if k == "link" {
        let text = rst_tokens(mut cx, md, children_of(t), env)?;
        let mut out = wrap("`", text, " <");
        push_all(mut out, get_s(get(t, "attrs"), "url"));
        push_str(mut out, ">`__");
        return Ok(out);
    }
    if k == "image" {
        let index = cx.envs[env].inline_images.len();
        cx.envs[env].inline_images.push(t.clone());
        return Ok(u(f"|img-{index}|"));
    }
    if k == "codespan" {
        return Ok(wrap("``", get_s(t, "raw"), "``"));
    }
    if k == "linebreak" {
        return Ok(u("<linebreak>"));
    }
    if k == "softbreak" {
        return Ok(u(" "));
    }
    if k == "inline_html" or k == "blank_line" or k == "block_error" {
        return Ok(Vec.new());
    }
    if k == "paragraph" {
        let children = children_of(t);
        let mut text: Vec[i64] = Vec.new();
        if children.len() == 1 and is_type(children[0], "image") {
            let image = children[0].clone();
            let attrs = get(image, "attrs");
            let alt = rst_tokens(mut cx, md, children_of(image), env)?;
            text = ucat(".. figure:: ", get_s(attrs, "url"));
            if truthy(get(attrs, "title")) {
                push_str(mut text, "\n   :alt: ");
                push_all(mut text, get_s(attrs, "title"));
            }
            push_str(mut text, "\n\n");
            push_all(mut text, indent(alt, "   "));
        } else {
            text = rst_tokens(mut cx, md, children, env)?;
            let lines = split_on(text, "<linebreak>");
            if lines.len() > 1 {
                let mut parts: Vec[Vec[i64]] = Vec.new();
                for line in lines.iter() {
                    parts.push(ucat("| ", line));
                }
                text = join(parts, "\n");
            }
        }
        return Ok(catu(text, "\n\n"));
    }
    if k == "heading" {
        let text = rst_tokens(mut cx, md, children_of(t), env)?;
        let level = get_i(get(t, "attrs"), "level");
        let marker = u("=-~^\"'")[level - 1];
        let mut out = text.clone();
        out.push(10);
        push_all(mut out, repeat(marker, text.len()));
        push_str(mut out, "\n\n");
        return Ok(out);
    }
    if k == "thematic_break" {
        return Ok(u("--------------\n\n"));
    }
    if k == "block_text" {
        return Ok(catu(rst_tokens(mut cx, md, children_of(t), env)?, "\n"));
    }
    if k == "block_code" {
        let info = get(get(t, "attrs"), "info");
        let code = indent(get_s(t, "raw"), "   ");
        if truthy(info) {
            let lang = split_ws(get_s(get(t, "attrs"), "info"))[0].clone();
            let mut out = ucat(".. code:: ", lang);
            push_str(mut out, "\n\n");
            push_all(mut out, code);
            out.push(10);
            return Ok(out);
        }
        let mut out = u("::\n\n");
        push_all(mut out, code);
        push_str(mut out, "\n\n");
        return Ok(out);
    }
    if k == "block_quote" {
        let mut text = indent(rst_tokens(mut cx, md, children_of(t), env)?, "   ");
        let p = match prev {
            Some(p) => p,
            None => return Err("KeyError: 'prev'".to_string()),
        };
        if p.len() > 0 and not (p == "paragraph" or p == "thematic_break" or p == "linebreak" or p == "heading") {
            text = ucat("..\n\n", text);
        }
        return Ok(text);
    }
    if k == "block_html" {
        let mut out = u(".. raw:: html\n\n");
        push_all(mut out, indent(get_s(t, "raw"), "   "));
        push_str(mut out, "\n\n");
        return Ok(out);
    }
    render_list(mut cx, md, t, None, env)
}
// ------------------------------------------------------------ the jobs

struct Config {
    name: String,
    renderer: String,
    escape: bool,
    hard_wrap: bool,
    plugins: Vec[String],
    rst: Vec[String],
    fenced: Vec[String],
}

fn words(s: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in s.split(",") {
        if w.len() > 0 {
            out.push(w.to_string());
        }
    }
    out
}

fn parse_config(rest: ref Vec[String]) -> Config {
    let mut c = Config {
        name: rest[0].clone(),
        renderer: "html".to_string(),
        escape: true,
        hard_wrap: false,
        plugins: Vec.new(),
        rst: Vec.new(),
        fenced: Vec.new(),
    };
    let mut i = 1;
    while i < rest.len() {
        let (k, v) = rest[i].split_once("=").unwrap();
        if k == "renderer" {
            c.renderer = v.to_string();
        } else if k == "escape" {
            c.escape = v == "1";
        } else if k == "hard_wrap" {
            c.hard_wrap = v == "1";
        } else if k == "plugins" {
            c.plugins = words(v);
        } else if k == "rst" {
            c.rst = words(v);
        } else if k == "fenced" {
            c.fenced = words(v);
        }
        i += 1;
    }
    c
}

// create_markdown, then md.use() of each directive style.
fn make_md(c: ref Config) -> Result[Md, String] {
    let mut md = new_md(c.renderer.as_str(), c.escape, c.hard_wrap);
    for p in c.plugins.iter() {
        use_plugin(mut md, p.as_str())?;
    }
    if c.rst.len() > 0 {
        use_directives(mut md, true, c.rst)?;
    }
    if c.fenced.len() > 0 {
        use_directives(mut md, false, c.fenced)?;
    }
    Ok(md)
}

fn find_config(configs: ref Vec[Config], name: ref String) -> Config {
    for c in configs.iter() {
        if c.name == *name {
            return Config {
                name: c.name.clone(),
                renderer: c.renderer.clone(),
                escape: c.escape,
                hard_wrap: c.hard_wrap,
                plugins: c.plugins.clone(),
                rst: c.rst.clone(),
                fenced: c.fenced.clone(),
            };
        }
    }
    parse_config(vec![name.clone()])
}

fn emit(s: ref Vec[i64]) {
    print(to_string(s));
}

fn emits(s: Str) {
    print(s);
}

fn show(out: ref Out) {
    match out {
        Out.Toks(t) => {
            let mut s: Vec[i64] = Vec.new();
            json_dump(V.L(t.clone()), mut s);
            s.push(10);
            emit(s);
        }
        Out.Text(s) => {
            emit(s);
            if not ends(s, "\n") {
                emits("\\ no newline\n");
            }
        }
    }
}

fn read_text(path: ref String) -> Result[Vec[i64], String] {
    match fs.read_to_string(path.clone()) {
        Ok(s) => Ok(us(s)),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

// md(text)
fn md_call(cx: mut ref Ctx, md: mut ref Md, text: ref Vec[i64]) -> Result[Out, String] {
    let (out, _) = md_parse(mut cx, mut md, text, None)?;
    Ok(out)
}

// md.read(path)
fn md_read(cx: mut ref Ctx, md: mut ref Md, path: ref Vec[i64]) -> Result[(Out, BState), String] {
    let text = read_text(to_string(path))?;
    md_parse(mut cx, mut md, text, Some(path.clone()))
}

fn run_cases(cx: mut ref Ctx, configs: ref Vec[Config], args: ref Vec[String]) -> Result[(), String] {
    let text = read_text(f"data/{args[0]}")?;
    let mut cases: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    let mut lines = split_on(text, "\n");
    lines.pop();
    for line in lines {
        if starts(line, "%%% ") {
            cases.push((tail(line, 4), Vec.new()));
        } else {
            let n = cases.len();
            push_all(mut cases[n - 1].1, line);
            cases[n - 1].1.push(10);
        }
    }
    let mut i = 1;
    while i < args.len() {
        let cfg = find_config(configs, args[i]);
        let mut md = make_md(cfg)?;
        for (title, body) in cases.iter() {
            emit(wrap("== ", title, ""));
            emits(f" [{args[i]}]\n");
            match md_call(mut cx, mut md, body) {
                Ok(out) => show(out),
                Err(e) => emits(f"error: {e}\n"),
            }
        }
        i += 1;
    }
    Ok(())
}

fn walk(dir: ref String, out: mut ref Vec[String]) {
    let names = match fs.read_dir(dir.clone()) {
        Ok(n) => n,
        Err(_) => return,
    };
    for n in names.iter() {
        let p = f"{dir}/{n}";
        match fs.metadata(p.clone()) {
            Ok(m) => {
                if m.is_dir {
                    walk(p, mut out);
                } else if n.ends_with(".md") {
                    out.push(p);
                }
            }
            Err(_) => {}
        }
    }
}

fn pages(top: ref String) -> Vec[String] {
    let mut found: Vec[String] = Vec.new();
    walk(top, mut found);
    let mut i = 1;
    while i < found.len() {
        let mut j = i;
        while j > 0 and found[j] < found[j - 1] {
            found.swap(j - 1, j);
            j -= 1;
        }
        i += 1;
    }
    found
}

fn relpath(path: ref String, top: ref String) -> String {
    path.as_str()[top.len() + 1..].to_string()
}

fn run_site(cx: mut ref Ctx, configs: ref Vec[Config], args: ref Vec[String]) -> Result[(), String] {
    let cfg = find_config(configs, args[0]);
    let top = f"data/{args[1]}";
    let dest = f"data/{args[2]}";
    for path in pages(top).iter() {
        let mut md = make_md(cfg)?;
        md.toc_hook = Some((1, 2));
        let (out, state) = md_read(mut cx, mut md, us(path))?;
        let html = match out {
            Out.Text(s) => s,
            Out.Toks(_) => Vec.new(),
        };
        let mut heads: Vec[V] = Vec.new();
        for t in state.tokens.iter() {
            if is_type(t, "heading") {
                heads.push(t.clone());
            }
        }
        let title = if heads.len() > 0 {
            let inner = html_tokens(mut cx, md, children_of(heads[0]))?;
            striptags(mut cx, inner)
        } else {
            let p = us(path);
            let mut k = p.len() - 1;
            while k >= 0 and p[k] != 47 {
                k -= 1;
            }
            tail(p, k + 1)
        };
        let rel = relpath(path, top);
        let target = f"{dest}/{rel.as_str()[..rel.len() - 3]}.html";
        let dir = to_string(dirname(us(target)));
        if let Err(e) = fs.create_dir_all(dir.clone()) {
            return Err(f"cannot create {dir}: {e}");
        }
        let toc = match cx.envs[state.env].toc_items.clone() {
            Some(items) => render_toc_ul(items),
            None => Vec.new(),
        };
        let mut page = wrap("<!doctype html>\n<title>", title, "</title>\n<nav>\n");
        push_all(mut page, toc);
        push_str(mut page, "</nav>\n<main>\n");
        push_all(mut page, html);
        push_str(mut page, "</main>\n");
        if let Err(e) = fs.write(target.clone(), to_string(page)) {
            return Err(f"cannot write {target}: {e}");
        }
        let back = read_text(target)?;
        let size = to_string(back).len();
        emits(f"== page {rel} -> {target} ({size} bytes, {heads.len()} headings)\n");
        show(Out.Text(back));
    }
    Ok(())
}

fn walk_links(tokens: ref Vec[V], found: mut ref Vec[(String, Vec[i64])]) {
    for t in tokens.iter() {
        let kind = ttype(t);
        if kind == "link" or kind == "image" {
            found.push((kind, get_s(get(t, "attrs"), "url")));
        }
        if has(t, "children") {
            walk_links(children_of(t), mut found);
        }
    }
}

fn run_links(cx: mut ref Ctx, configs: ref Vec[Config], args: ref Vec[String]) -> Result[(), String] {
    let cfg = find_config(configs, args[0]);
    let top = f"data/{args[1]}";
    for path in pages(top).iter() {
        let mut md = make_md(cfg)?;
        let (_, state) = md_read(mut cx, mut md, us(path))?;
        let mut found: Vec[(String, Vec[i64])] = Vec.new();
        walk_links(state.tokens, mut found);
        emits(f"== links {relpath(path, top)}: {found.len()}\n");
        for (kind, url) in found.iter() {
            let verdict = if contains(url, "://") or starts(url, "/") or starts(url, "#") or starts(url, "mailto:") {
                u("external")
            } else {
                let target = normpath(path_join(dirname(us(path)), url));
                if is_file(target) { u("ok") } else { ucat("MISSING ", target) }
            };
            let mut line = u(f"  {kind} ");
            push_all(mut line, url);
            line.push(32);
            push_all(mut line, verdict);
            line.push(10);
            emit(line);
        }
    }
    Ok(())
}

// ----------------------------------------------- python -m mistune

struct CliArgs {
    message: Option[Vec[i64]],
    file: Option[Vec[i64]],
    plugins: Option[Vec[String]],
    escape: bool,
    hardwrap: bool,
    output: Option[Vec[i64]],
    renderer: String,
    version: bool,
}

// argparse's test for an option: a dash, then no space.
fn looks_like_option(a: ref Vec[i64]) -> bool {
    a.len() > 1 and a[0] == 45 and not has_char(a, 32)
}

fn parse_cli(argv: ref Vec[Vec[i64]]) -> CliArgs {
    let mut a = CliArgs {
        message: None,
        file: None,
        plugins: None,
        escape: false,
        hardwrap: false,
        output: None,
        renderer: "html".to_string(),
        version: false,
    };
    let mut i = 0;
    while i < argv.len() {
        let opt = to_string(argv[i]);
        let o = opt.as_str();
        let value = if i + 1 < argv.len() { argv[i + 1].clone() } else { Vec.new() };
        if o == "-m" or o == "--message" {
            a.message = Some(value);
            i += 2;
        } else if o == "-f" or o == "--file" {
            a.file = Some(value);
            i += 2;
        } else if o == "-o" or o == "--output" {
            a.output = Some(value);
            i += 2;
        } else if o == "-r" or o == "--renderer" {
            a.renderer = to_string(value);
            i += 2;
        } else if o == "--escape" {
            a.escape = true;
            i += 1;
        } else if o == "--hardwrap" {
            a.hardwrap = true;
            i += 1;
        } else if o == "--version" {
            a.version = true;
            return a;
        } else if o == "-p" or o == "--plugin" {
            let mut list = match a.plugins {
                Some(l) => l,
                None => Vec.new(),
            };
            i += 1;
            while i < argv.len() and not looks_like_option(argv[i]) {
                list.push(to_string(argv[i]));
                i += 1;
            }
            a.plugins = Some(list);
        } else {
            i += 1;
        }
    }
    a
}

// __main__.cli; the exit status.
fn cli(cx: mut ref Ctx, argv: ref Vec[Vec[i64]]) -> i64 {
    let args = parse_cli(argv);
    if args.version {
        emits("mistune 3.0.2\n");
        return 0;
    }
    let message = match args.message.clone() {
        Some(m) => if m.len() > 0 { Some(m) } else { None },
        None => None,
    };
    if message.is_none() and args.file.is_none() {
        emits("You MUST specify a message or file\n");
        return 1;
    }
    let plugins = match args.plugins.clone() {
        Some(p) => if p.len() > 0 { p } else { default_cli_plugins() },
        None => default_cli_plugins(),
    };
    let cfg = Config {
        name: "cli".to_string(),
        renderer: args.renderer.clone(),
        escape: args.escape,
        hard_wrap: args.hardwrap,
        plugins: plugins,
        rst: Vec.new(),
        fenced: Vec.new(),
    };
    let result = match make_md(cfg) {
        Ok(md0) => match message {
            Some(m) => {
                let mut md = md0;
                md_call(mut cx, mut md, m)
            }
            None => {
                let mut md = md0;
                match md_read(mut cx, mut md, args.file.clone().unwrap()) {
                    Ok((out, _)) => Ok(out),
                    Err(e) => Err(e),
                }
            }
        },
        Err(e) => Err(e),
    };
    let text = match result {
        Ok(Out.Text(s)) => s,
        Ok(Out.Toks(t)) => {
            let mut s: Vec[i64] = Vec.new();
            py_repr(V.L(t), mut s);
            s
        }
        Err(e) => {
            emits(f"error: {e}\n");
            return 1;
        }
    };
    match args.output {
        Some(path) => {
            if let Err(e) = fs.write(to_string(path), to_string(text)) {
                emits(f"error: OSError: {e}\n");
                return 1;
            }
        }
        None => {
            emit(text);
            emits("\n");
        }
    }
    0
}

fn default_cli_plugins() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for p in ["strikethrough", "footnotes", "table", "speedup"] {
        v.push(p.to_string());
    }
    v
}

fn run_cli(cx: mut ref Ctx, rest: ref String) -> Result[(), String] {
    let mut argv: Vec[Vec[i64]] = Vec.new();
    for a in split_on(us(rest), "\t") {
        argv.push(replace(a, "\\n", "\n"));
    }
    emit(ucat("== cli ", join(argv, " ")));
    emits("\n");
    let code = cli(mut cx, argv);
    emits(f"[exit {code}]\n");
    let mut i = 0;
    while i < argv.len() {
        if eq(argv[i], "-o") {
            let path = to_string(argv[i + 1]);
            let text = read_text(path)?;
            emits(f"-- {path}\n");
            show(Out.Text(text));
            break;
        }
        i += 1;
    }
    Ok(())
}

fn run(cx: mut ref Ctx) -> Result[(), String] {
    let text = to_string(read_text("data/jobs.txt".to_string())?);
    let mut configs: Vec[Config] = Vec.new();
    for line in text.split("\n") {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let (kind, rest) = match line.split_once(" ") {
            Some((k, r)) => (k.to_string(), r.to_string()),
            None => (line.to_string(), String.new()),
        };
        let parts: Vec[String] = rest.split(" ").map(|w| w.to_string()).collect();
        if kind == "config" {
            configs.push(parse_config(parts));
        } else if kind == "cases" {
            run_cases(mut cx, configs, parts)?;
        } else if kind == "site" {
            run_site(mut cx, configs, parts)?;
        } else if kind == "links" {
            run_links(mut cx, configs, parts)?;
        } else if kind == "cli" {
            run_cli(mut cx, rest)?;
        }
    }
    Ok(())
}
// ------------------------------------------------- html.entities.html5

fn html5_entities() -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    add_entities_0(mut m);
    add_entities_1(mut m);
    add_entities_2(mut m);
    add_entities_3(mut m);
    add_entities_4(mut m);
    add_entities_5(mut m);
    add_entities_6(mut m);
    add_entities_7(mut m);
    add_entities_8(mut m);
    m
}

fn add_entities_0(m: mut ref Map[String, String]) {
    m.insert("AElig".to_string(), "\u{c6}".to_string());
    m.insert("AElig;".to_string(), "\u{c6}".to_string());
    m.insert("AMP".to_string(), "&".to_string());
