        }
        7835 => {
            out.push(7777);
        }
        8126 => {
            out.push(837);
            out.push(953);
        }
        8147 => {
            out.push(912);
        }
        8163 => {
            out.push(944);
        }
        42571 => {
            out.push(7304);
        }
        64261 => {
            out.push(64262);
        }
        64262 => {
            out.push(64261);
        }
        _ => {}
    }
    out
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
        // and the set takes in the extra cases of each letter in it
        if not hit and not ascii {
            for x in extra_cases(lo).iter() {
                let xu = upper(*x, ascii);
                if in_items(set, *x, ascii) or (lower(xu, ascii) == *x and in_items(set, xu, ascii)) {
                    hit = true;
                }
            }
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn re_find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match re_find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

// ------------------------------------------------- re.compile's cache

// Each pattern is compiled once and keeps one matcher; a search swaps
// the subject into that matcher and back, so no call copies the text.
struct Rx {
    progs: Vec[Program],
    ms: Vec[Matcher],
    keys: Map[String, i64],
}

fn new_rx() -> Rx {
    Rx { progs: Vec.new(), ms: Vec.new(), keys: Map.new() }
}

fn rx_id_v(rx: mut ref Rx, pat: ref Vec[i64], flags: i64) -> i64 {
    let key = f"{flags}:{to_string(pat)}";
    if let Some(id) = rx.keys.get(key) {
        return *id;
    }
    let prog = match re_compile(pat, flags) {
        Ok(p) => p,
        Err(e) => {
            eprintln(f"bad pattern {to_string(pat)}: {err_text(e)}");
            re_compile(u("(?!)"), 0).unwrap()
        }
    };
    let empty: Vec[i64] = Vec.new();
    let m = new_matcher(prog, empty);
    rx.progs.push(prog);
    rx.ms.push(m);
    let id = rx.progs.len() - 1;
    rx.keys.insert(key, id);
    id
}

fn rx_id(rx: mut ref Rx, pat: Str, flags: i64) -> i64 {
    rx_id_v(mut rx, u(pat), flags)
}

// pattern.search (mode 0), match (1) or fullmatch (2) at pos.
fn rx_run(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos0: i64, mode: i64) -> Option[Found] {
    // sre clamps the position into the string
    let pos = if pos0 > s.len() { s.len() } else if pos0 < 0 { 0 } else { pos0 };
    mem.swap(mut rx.ms[id].s, mut s);
    let r = re_find(mut rx.ms[id], rx.progs[id], pos, false, mode);
    mem.swap(mut rx.ms[id].s, mut s);
    r
}

// The same with endpos: the subject ends there.
fn rx_run_end(rx: mut ref Rx, id: i64, s: ref Vec[i64], pos: i64, endpos: i64, mode: i64) -> Option[Found] {
    let mut t = sl(s, 0, endpos);
    rx_run(mut rx, id, mut t, pos, mode)
}

fn rx_search(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos: i64) -> Option[Found] {
    rx_run(mut rx, id, mut s, pos, 0)
}

fn rx_match(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos: i64) -> Option[Found] {
    rx_run(mut rx, id, mut s, pos, 1)
}

// finditer.
fn rx_all(rx: mut ref Rx, id: i64, s: mut ref Vec[i64]) -> Vec[Found] {
    let mut out: Vec[Found] = Vec.new();
    mem.swap(mut rx.ms[id].s, mut s);
    let mut pos = 0;
    let mut must_advance = false;
    let n = rx.ms[id].s.len();
    while pos <= n {
        match re_find(mut rx.ms[id], rx.progs[id], pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    mem.swap(mut rx.ms[id].s, mut s);
    out
}

fn group_index(rx: ref Rx, id: i64, name: Str) -> i64 {
    let n = u(name);
    for (k, g) in rx.progs[id].names.iter() {
        if same(k, n) {
            return g;
        }
    }
    -1
}

// m.group(g) for g >= 1, None when the group did not take part.
fn group_n(s: ref Vec[i64], f: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = f.spans[g - 1];
    if a < 0 {
        return None;
    }
    Some(slice(s, a, b))
}

fn group_or_empty(s: ref Vec[i64], f: ref Found, g: i64) -> Vec[i64] {
    match group_n(s, f, g) {
        Some(t) => t,
        None => Vec.new(),
    }
}

fn group_named(rx: ref Rx, id: i64, s: ref Vec[i64], f: ref Found, name: Str) -> Option[Vec[i64]] {
    group_n(s, f, group_index(rx, id, name))
}

fn gs(rx: ref Rx, id: i64, s: ref Vec[i64], f: ref Found, name: Str) -> Vec[i64] {
    match group_named(rx, id, s, f, name) {
        Some(t) => t,
        None => Vec.new(),
    }
}

fn group0(s: ref Vec[i64], f: ref Found) -> Vec[i64] {
    slice(s, f.start, f.end)
}

// m.lastgroup.
fn last_group(rx: ref Rx, id: i64, f: ref Found) -> String {
    for (k, g) in rx.progs[id].names.iter() {
        if g == f.lastindex {
            return to_string(k);
        }
    }
    String.new()
}

// pattern.sub with a literal replacement.
fn rx_sub(rx: mut ref Rx, id: i64, s: ref Vec[i64], repl: Str) -> Vec[i64] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let r = u(repl);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        push_all(mut out, r);
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

// pattern.sub(r'\1' + suffix).
fn rx_sub_g1(rx: mut ref Rx, id: i64, s: ref Vec[i64], suffix: ref Vec[i64]) -> Vec[i64] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        push_all(mut out, group_or_empty(t, f, 1));
        push_all(mut out, suffix);
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

// pattern.split, for a pattern without groups.
fn rx_split(rx: mut ref Rx, id: i64, s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        out.push(slice(t, pos, f.start));
        pos = f.end;
    }
    out.push(slice(t, pos, t.len()));
    out
}
// ------------------------------------------------------------ Python str

// mistune's text is a Python str; here it is its code points, and these
// are the str methods mistune calls.

fn u(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn us(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat3(a: ref Vec[i64], b: ref Vec[i64], c: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    push_all(mut out, c);
    out
}

fn ucat(a: Str, b: ref Vec[i64]) -> Vec[i64] {
    let mut out = u(a);
    push_all(mut out, b);
    out
}

fn catu(a: ref Vec[i64], b: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, b);
    out
}

fn wrap(a: Str, b: ref Vec[i64], c: Str) -> Vec[i64] {
    let mut out = u(a);
    push_all(mut out, b);
    push_all(mut out, u(c));
    out
}

fn push_str(out: mut ref Vec[i64], s: Str) {
    push_all(mut out, u(s));
}

fn eq(a: ref Vec[i64], b: Str) -> bool {
    same(a, u(b))
}

// s[a:b] with Python's clamping.
fn sl(s: ref Vec[i64], a: i64, b: i64) -> Vec[i64] {
    let n = s.len();
    let mut lo = if a < 0 { a + n } else { a };
    let mut hi = if b < 0 { b + n } else { b };
    if lo < 0 {
        lo = 0;
    }
    if hi > n {
        hi = n;
    }
    if lo >= hi {
        return Vec.new();
    }
    slice(s, lo, hi)
}

fn tail(s: ref Vec[i64], a: i64) -> Vec[i64] {
    sl(s, a, s.len())
}

fn starts_at(s: ref Vec[i64], p: ref Vec[i64], at: i64) -> bool {
    if at < 0 or at + p.len() > s.len() {
        return false;
    }
    let mut i = 0;
    while i < p.len() {
        if s[at + i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts(s: ref Vec[i64], p: Str) -> bool {
    starts_at(s, u(p), 0)
}

fn starts_v(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    starts_at(s, p, 0)
}

fn ends(s: ref Vec[i64], p: Str) -> bool {
    let q = u(p);
    starts_at(s, q, s.len() - q.len())
}

fn find_v(s: ref Vec[i64], p: ref Vec[i64], from: i64) -> i64 {
    let mut i = if from < 0 { 0 } else { from };
    while i + p.len() <= s.len() {
        if starts_at(s, p, i) {
            return i;
        }
        i += 1;
    }
    -1
}

fn find(s: ref Vec[i64], p: Str, from: i64) -> i64 {
    find_v(s, u(p), from)
}

fn has_char(s: ref Vec[i64], c: i64) -> bool {
    for x in s {
        if x == c {
            return true;
        }
    }
    false
}

fn contains(s: ref Vec[i64], p: Str) -> bool {
    find(s, p, 0) >= 0
}

// str.replace(old, new, count), count -1 for all.
fn replace_v(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64], count: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if old.len() == 0 {
        // Python puts `new` before every character and at the end.
        let mut n = 0;
        let mut i = 0;
        while i <= s.len() {
            if count < 0 or n < count {
                push_all(mut out, new);
                n += 1;
            }
            if i < s.len() {
                out.push(s[i]);
            }
            i += 1;
        }
        return out;
    }
    let mut i = 0;
    let mut n = 0;
    while i < s.len() {
        if (count < 0 or n < count) and starts_at(s, old, i) {
            push_all(mut out, new);
            i += old.len();
            n += 1;
        } else {
            out.push(s[i]);
            i += 1;
        }
    }
    out
}

fn replace(s: ref Vec[i64], old: Str, new: Str) -> Vec[i64] {
    replace_v(s, u(old), u(new), -1)
}

fn replace1(s: ref Vec[i64], old: Str, new: Str) -> Vec[i64] {
    replace_v(s, u(old), u(new), 1)
}

fn is_ws(c: i64) -> bool {
    is_space(c, false)
}

// str.strip() and friends; `chars` empty means whitespace.
fn in_chars(c: i64, chars: ref Vec[i64]) -> bool {
    if chars.len() == 0 { is_ws(c) } else { has_char(chars, c) }
}

fn strip_chars(s: ref Vec[i64], chars: ref Vec[i64], left: bool, right: bool) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    if left {
        while a < b and in_chars(s[a], chars) {
            a += 1;
        }
    }
    if right {
        while b > a and in_chars(s[b - 1], chars) {
            b -= 1;
        }
    }
    slice(s, a, b)
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), true, true)
}

fn lstrip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), true, false)
}

fn rstrip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), false, true)
}

fn strip_of(s: ref Vec[i64], chars: Str) -> Vec[i64] {
    strip_chars(s, u(chars), true, true)
}

fn rstrip_of(s: ref Vec[i64], chars: Str) -> Vec[i64] {
    strip_chars(s, u(chars), false, true)
}

fn is_blank(s: ref Vec[i64]) -> bool {
    for c in s {
        if not is_ws(c) {
            return false;
        }
    }
    true
}

// str.split() with no separator.
fn split_ws(s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        while i < s.len() and is_ws(s[i]) {
            i += 1;
        }
        if i >= s.len() {
            break;
        }
        let a = i;
        while i < s.len() and not is_ws(s[i]) {
            i += 1;
        }
        out.push(slice(s, a, i));
    }
    out
}

// str.split(sep).
fn split_on(s: ref Vec[i64], sep: Str) -> Vec[Vec[i64]] {
    let p = u(sep);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut a = 0;
    let mut i = 0;
    while i + p.len() <= s.len() {
        if starts_at(s, p, i) {
            out.push(slice(s, a, i));
            i += p.len();
            a = i;
        } else {
            i += 1;
        }
    }
    out.push(slice(s, a, s.len()));
    out
}

fn is_line_break(c: i64) -> bool {
    c == 10 or c == 13 or c == 11 or c == 12 or c == 0x1C or c == 0x1D or c == 0x1E or c == 0x85 or c == 0x2028 or c == 0x2029
}

// str.splitlines(), keepends or not.
fn split_lines(s: ref Vec[i64], keep: bool) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut a = 0;
    let mut i = 0;
    while i < s.len() {
        if is_line_break(s[i]) {
            let mut end = i + 1;
            if s[i] == 13 and i + 1 < s.len() and s[i + 1] == 10 {
                end = i + 2;
            }
            out.push(slice(s, a, if keep { end } else { i }));
            a = end;
            i = end;
        } else {
            i += 1;
        }
    }
    if a < s.len() {
        out.push(slice(s, a, s.len()));
    }
    out
}

fn join(parts: ref Vec[Vec[i64]], sep: Str) -> Vec[i64] {
    let p = u(sep);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            push_all(mut out, p);
        }
        push_all(mut out, parts[i]);
        i += 1;
    }
    out
}

fn spaces(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        out.push(32);
        i += 1;
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        out.push(c);
        i += 1;
    }
    out
}

// str.lower() and str.upper(), with the full case mappings.
fn py_lower(s: ref Vec[i64]) -> Vec[i64] {
    us(to_string(s).to_lowercase())
}

fn py_upper(s: ref Vec[i64]) -> Vec[i64] {
    us(to_string(s).to_uppercase())
}

fn ascii_lower(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(if c >= 65 and c <= 90 { c + 32 } else { c });
    }
    out
}

fn num_text(n: i64) -> Vec[i64] {
    u(f"{n}")
}

fn is_digit_text(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if c < 48 or c > 57 {
            return false;
        }
    }
    true
}

// int() of a run of ASCII digits; -1 when it is not one.
fn int_of(s: ref Vec[i64]) -> i64 {
    let t = strip(s);
    if not is_digit_text(t) or t.len() > 18 {
        return -1;
    }
    let mut v = 0;
    for c in t {
        v = v * 10 + (c - 48);
    }
    v
}

// textwrap.indent(text, prefix): every line with something other than
// whitespace in it gets the prefix.
fn indent(text: ref Vec[i64], prefix: Str) -> Vec[i64] {
    let p = u(prefix);
    let mut out: Vec[i64] = Vec.new();
    for line in split_lines(text, true) {
        if not is_blank(line) {
            push_all(mut out, p);
        }
        push_all(mut out, line);
    }
    out
}
// ------------------------------------------------------------ tokens

// mistune's tokens are Python dicts. A V is one of their values; a
// dict keeps its keys in insertion order, as a Python dict does.
#[derive(Clone)]
enum V {
    Nil,
    B(bool),
    I(i64),
    S(Vec[i64]),
    L(Vec[V]),
    D(Vec[(String, V)]),
}

fn vs(s: Str) -> V {
    V.S(u(s))
}

fn dict() -> V {
    V.D(Vec.new())
}

fn tok(kind: Str) -> V {
    let mut d: Vec[(String, V)] = Vec.new();
    d.push(("type".to_string(), vs(kind)));
    V.D(d)
}

fn tok_raw(kind: Str, raw: own Vec[i64]) -> V {
    let mut t = tok(kind);
    put(mut t, "raw", V.S(raw));
    t
}

fn tok_t(kind: Str, text: own Vec[i64]) -> V {
    let mut t = tok(kind);
    put(mut t, "text", V.S(text));
    t
}

fn tok_children(kind: Str, children: own Vec[V]) -> V {
    let mut t = tok(kind);
    put(mut t, "children", V.L(children));
    t
}

fn text_tok(raw: own Vec[i64]) -> V {
    tok_raw("text", raw)
}

// d[k] = v
fn put(d: mut ref V, k: Str, v: own V) {
    if let V.D(items) = d {
        let mut i = 0;
        while i < items.len() {
            if items[i].0 == k {
                items[i].1 = v;
                return;
            }
            i += 1;
        }
        items.push((k.to_string(), v));
    }
}

fn has(d: ref V, k: Str) -> bool {
    if let V.D(items) = d {
        for (key, _) in items.iter() {
            if key == k {
                return true;
            }
        }
    }
    false
}

// d.get(k), cloned; Nil when absent.
fn get(d: ref V, k: Str) -> V {
    if let V.D(items) = d {
        for (key, v) in items.iter() {
            if key == k {
                return v.clone();
            }
        }
    }
    V.Nil
}

// d.pop(k)
fn pop(d: mut ref V, k: Str) -> V {
    if let V.D(items) = d {
        let mut i = 0;
        while i < items.len() {
            if items[i].0 == k {
                let (_, v) = items.remove(i);
                return v;
            }
            i += 1;
        }
    }
    V.Nil
}

fn get_s(d: ref V, k: Str) -> Vec[i64] {
    match get(d, k) {
        V.S(s) => s,
        _ => Vec.new(),
    }
}

fn get_i(d: ref V, k: Str) -> i64 {
    match get(d, k) {
        V.I(n) => n,
        _ => 0,
    }
}

fn get_b(d: ref V, k: Str) -> bool {
    match get(d, k) {
        V.B(b) => b,
        _ => false,
    }
}

fn ttype(d: ref V) -> String {
    if let V.D(items) = d {
        for (key, v) in items.iter() {
            if key == "type" {
                if let V.S(s) = v {
                    return to_string(s);
                }
            }
        }
    }
    String.new()
}

fn is_type(d: ref V, kind: Str) -> bool {
    ttype(d) == kind
}

fn set_type(d: mut ref V, kind: Str) {
    put(mut d, "type", vs(kind));
}

// Python truthiness.
fn truthy(v: ref V) -> bool {
    match v {
        V.Nil => false,
        V.B(b) => b,
        V.I(n) => n != 0,
        V.S(s) => s.len() > 0,
        V.L(l) => l.len() > 0,
        V.D(d) => d.len() > 0,
    }
}

fn children_of(d: ref V) -> Vec[V] {
    match get(d, "children") {
        V.L(l) => l,
        _ => Vec.new(),
    }
}

// d['attrs'][k] = v, making attrs when there is none.
fn put_attr(d: mut ref V, k: Str, v: own V) {
    if let V.D(items) = d {
        let mut i = 0;
        while i < items.len() {
            if items[i].0 == "attrs" {
                put(mut items[i].1, k, v);
                return;
            }
            i += 1;
        }
        let mut a = dict();
        put(mut a, k, v);
        items.push(("attrs".to_string(), a));
    }
}

fn attr(d: ref V, k: Str) -> V {
    get(get(d, "attrs"), k)
}

// ------------------------------------------------------- json.dumps

fn json_str(s: ref Vec[i64], out: mut ref Vec[i64]) {
    out.push(34);
    for c in s {
        if c == 34 {
            push_str(mut out, "\\\"");
        } else if c == 92 {
            push_str(mut out, "\\\\");
        } else if c == 10 {
            push_str(mut out, "\\n");
        } else if c == 13 {
            push_str(mut out, "\\r");
        } else if c == 9 {
            push_str(mut out, "\\t");
        } else if c == 8 {
            push_str(mut out, "\\b");
        } else if c == 12 {
            push_str(mut out, "\\f");
        } else if c < 32 or (c >= 128 and c < 0x10000) {
            push_str(mut out, "\\u");
            push_all(mut out, us(hex_n(c, 4)));
        } else if c >= 0x10000 {
            let v = c - 0x10000;
            push_str(mut out, "\\u");
            push_all(mut out, us(hex_n(0xD800 | (v >> 10), 4)));
            push_str(mut out, "\\u");
            push_all(mut out, us(hex_n(0xDC00 | (v & 0x3FF), 4)));
        } else {
            out.push(c);
        }
    }
    out.push(34);
}

fn json_dump(v: ref V, out: mut ref Vec[i64]) {
    match v {
        V.Nil => push_str(mut out, "null"),
        V.B(b) => push_str(mut out, if b { "true" } else { "false" }),
        V.I(n) => push_all(mut out, num_text(n)),
        V.S(s) => json_str(s, mut out),
        V.L(l) => {
            out.push(91);
            let mut i = 0;
            while i < l.len() {
                if i > 0 {
                    push_str(mut out, ", ");
                }
                json_dump(l[i], mut out);
                i += 1;
            }
            out.push(93);
        }
        V.D(d) => {
            out.push(123);
            let mut i = 0;
            while i < d.len() {
                if i > 0 {
                    push_str(mut out, ", ");
                }
                json_str(us(d[i].0), mut out);
                push_str(mut out, ": ");
                json_dump(d[i].1, mut out);
                i += 1;
            }
            out.push(125);
        }
    }
}

// ------------------------------------------------------------- repr

fn py_repr(v: ref V, out: mut ref Vec[i64]) {
    match v {
        V.Nil => push_str(mut out, "None"),
        V.B(b) => push_str(mut out, if b { "True" } else { "False" }),
        V.I(n) => push_all(mut out, num_text(n)),
        V.S(s) => str_repr(s, mut out),
        V.L(l) => {
            out.push(91);
            let mut i = 0;
            while i < l.len() {
                if i > 0 {
                    push_str(mut out, ", ");
                }
                py_repr(l[i], mut out);
                i += 1;
            }
            out.push(93);
        }
        V.D(d) => {
            out.push(123);
            let mut i = 0;
            while i < d.len() {
                if i > 0 {
                    push_str(mut out, ", ");
                }
                str_repr(us(d[i].0), mut out);
                push_str(mut out, ": ");
                py_repr(d[i].1, mut out);
                i += 1;
            }
            out.push(125);
        }
    }
}
// ------------------------------------------------------------ patterns

// mistune's regular expressions, as gen_kara.py read them from
// mistune/. The flags are re's: 8 is MULTILINE, 16 DOTALL, 32 UNICODE.
struct Pats {
    line_end: i64,
    expand_tab: i64,
    charref: i64,
    striptags: i64,
    strip_end: i64,
    link_bracket_start: i64,
    link_bracket: i64,
    link_href_block: i64,
    link_href_inline: i64,
    link_title: i64,
    paren_end: i64,
    inline_link_label: i64,
    inline_square_bracket: i64,
    escape_char: i64,
    indent_code_trim: i64,
    axt_heading_trim: i64,
    block_quote_trim: i64,
    block_quote_leading: i64,
    line_blank_end: i64,
    blank_to_line: i64,
    open_tag_end: i64,
    close_tag_end: i64,
    strict_block_quote: i64,
    blank_line: i64,
    line_has_text: i64,
    em1: i64,
    em_1: i64,
    em2: i64,
    em_2: i64,
    em3: i64,
    em_3: i64,
    hard_linebreak: i64,
    strike_end: i64,
    mark_end: i64,
    insert_end: i64,
    table_cell: i64,
    cell_split: i64,
    align_center: i64,
    align_left: i64,
    align_right: i64,
    paragraph_split: i64,
    task_list_item: i64,
    def_re: i64,
    dd_start: i64,
    def_trim: i64,
    has_blank_line: i64,
    ruby: i64,
    spoiler_start: i64,
    spoiler_match: i64,
    fenced_type: i64,
    fenced_directive: i64,
    rst_directive: i64,
    num: i64,
    fenced_marker: i64,
}

fn make_pats(rx: mut ref Rx) -> Pats {
    Pats {
        line_end: rx_id(mut rx, "\\n|$", 32),
        expand_tab: rx_id(mut rx, "^( {0,3})\\t", 40),
        charref: rx_id(mut rx, "&(#[0-9]{1,7};|#[xX][0-9a-fA-F]+;|[^\\t\\n\\f <&#;]{1,32};)", 32),
        striptags: rx_id(mut rx, "(<!--.*?-->|<[^>]*>)", 32),
        strip_end: rx_id(mut rx, "\\n\\s+$", 32),
        link_bracket_start: rx_id(mut rx, "[ \\t]*\\n?[ \\t]*<", 32),
        link_bracket: rx_id(mut rx, "<([^<>\\n\\\\\\x00]*)>", 32),
        link_href_block: rx_id(mut rx, "[ \\t]*\\n?[ \\t]*([^\\s]+)(?:\\s|$)", 32),
        link_href_inline: rx_id(mut rx, "[ \\t]*\\n?[ \\t]*([^ \\t\\n]*?)(?:[ \\t\\n]|(?:(?<!\\\\)(?:\\\\\\\\)*\\)))", 32),
        link_title: rx_id(mut rx, "[ \\t\\n]+(\"(?:\\\\[!\"\\#\\$%\\&'\\(\\)\\*\\+,\\-\\./:;<=>\\?@\\[\\\\\\]\\^_`\\{\\|\\}\\~]|[^\"\\x00])*\"|'(?:\\\\[!\"\\#\\$%\\&'\\(\\)\\*\\+,\\-\\./:;<=>\\?@\\[\\\\\\]\\^_`\\{\\|\\}\\~]|[^'\\x00])*')", 32),
        paren_end: rx_id(mut rx, "\\s*\\)", 32),
        inline_link_label: rx_id(mut rx, "(?:[^\\\\\\[\\]]|\\\\.){0,500}\\]", 32),
        inline_square_bracket: rx_id(mut rx, "(?<!\\\\)(?:\\\\\\\\)*[\\[\\]]", 32),
        escape_char: rx_id(mut rx, "\\\\([!\"\\#\\$%\\&'\\(\\)\\*\\+,\\-\\./:;<=>\\?@\\[\\\\\\]\\^_`\\{\\|\\}\\~])", 32),
        indent_code_trim: rx_id(mut rx, "^ {1,4}", 40),
        axt_heading_trim: rx_id(mut rx, "(\\s+|^)#+\\s*$", 32),
        block_quote_trim: rx_id(mut rx, "^ ?", 40),
        block_quote_leading: rx_id(mut rx, "^ *>", 40),
        line_blank_end: rx_id(mut rx, "\\n[ \\t]*\\n$", 32),
        blank_to_line: rx_id(mut rx, "[ \\t]*\\n", 32),
        open_tag_end: rx_id(mut rx, "(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:[^ !\"\\'=<>`]+|\\'[^\\']*?\\'|\"[^\\\"]*?\"))?)*[ \\t]*>[ \\t]*(?:\\n|$)", 32),
        close_tag_end: rx_id(mut rx, "[ \\t]*>[ \\t]*(?:\\n|$)", 32),
        strict_block_quote: rx_id(mut rx, "( {0,3}>[^\\n]*(?:\\n|$))+", 32),
        blank_line: rx_id(mut rx, "(^[ \\t\\v\\f]*\\n)+", 40),
        line_has_text: rx_id(mut rx, "( *)\\S", 32),
        em1: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\\\*|[^\\s*])\\*(?!\\*)", 32),
        em_1: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\_|[^\\s_])_(?!_)\\b", 32),
        em2: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\\\*|[^\\s*])\\*\\*(?!\\*)", 32),
        em_2: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\_|[^\\s_])__(?!_)\\b", 32),
        em3: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\\\*|[^\\s*])\\*\\*\\*(?!\\*)", 32),
        em_3: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\_|[^\\s_])___(?!_)\\b", 32),
        hard_linebreak: rx_id(mut rx, " *\\n\\s*", 32),
        strike_end: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\~|[^\\s~])~~(?!~)", 32),
        mark_end: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\=|[^\\s=])==(?!=)", 32),
        insert_end: rx_id(mut rx, "(?:(?<!\\\\)(?:\\\\\\\\)*\\\\\\^|[^\\s^])\\^\\^(?!\\^)", 32),
        table_cell: rx_id(mut rx, "^ {0,3}\\|(.+)\\|[ \\t]*$", 32),
        cell_split: rx_id(mut rx, " *(?<!\\\\)(?:\\\\\\\\)*\\| *", 32),
        align_center: rx_id(mut rx, "^ *:-+: *$", 32),
        align_left: rx_id(mut rx, "^ *:-+ *$", 32),
        align_right: rx_id(mut rx, "^ *-+: *$", 32),
        paragraph_split: rx_id(mut rx, "\\n{2,}", 32),
        task_list_item: rx_id(mut rx, "^(\\[[ xX]\\])\\s+", 32),
        def_re: rx_id(mut rx, "^(?P<def_list_head>(?:[^\\n]+\\n)+?)\\n?(?:\\:[ \\t]+.*\\n(?:[^\\n]+\\n)*(?:(?:[ \\t]*\\n)*[ \\t]+[^\\n]+\\n)*(?:[ \\t]*\\n)*)+", 40),
        dd_start: rx_id(mut rx, "^:[ \\t]+", 40),
        def_trim: rx_id(mut rx, "^ {0,4}", 40),
        has_blank_line: rx_id(mut rx, "\\n[ \\t]*\\n$", 32),
        ruby: rx_id(mut rx, "\\[(?:\\w+\\(\\w+\\))+\\]", 32),
        spoiler_start: rx_id(mut rx, "^ {0,3}! ?", 40),
        spoiler_match: rx_id(mut rx, "^( {0,3}![^\\n]*\\n)+$", 32),
        fenced_type: rx_id(mut rx, "^ *\\{[a-zA-Z0-9_-]+\\}", 32),
        fenced_directive: rx_id(mut rx, "\\{(?P<type>[a-zA-Z0-9_-]+)\\} *(?P<title>[^\\n]*)(?:\\n|$)(?P<options>(?:\\:[a-zA-Z0-9_-]+\\: *[^\\n]*\\n+)*)\\n*(?P<text>(?:[^\\n]*\\n+)*)", 32),
        rst_directive: rx_id(mut rx, "\\.\\.( +)(?P<type>[a-zA-Z0-9_-]+)\\:\\: *(?P<title>[^\\n]*)(?:\\n|$)(?P<options>(?:  \\1 {0,3}\\:[a-zA-Z0-9_-]+\\: *[^\\n]*\\n+)*)\\n*(?P<text>(?:  \\1 {0,3}[^\\n]*\\n+)*)", 32),
        num: rx_id(mut rx, "^\\d+(?:\\.\\d*)?", 32),
        fenced_marker: rx_id(mut rx, "^[`~]+", 40),
    }
}

fn pat_prevent_backslash() -> Str {
    "(?<!\\\\)(?:\\\\\\\\)*"
}

fn pat_link_label() -> Str {
    "(?:[^\\\\\\[\\]]|\\\\.){0,500}"
}

fn pat_speedup_paragraph() -> Str {
    "(?:^[^\\s\\d!\"\\#\\$%\\&'\\(\\)\\*\\+,\\-\\./:;<=>\\?@\\[\\\\\\]\\^_`\\{\\|\\}\\~][^\\n]*\\n)+"
}

fn pat_superscript() -> Str {
    "\\^(?:(?<!\\\\)(?:\\\\\\\\)*\\\\\\^|\\S|\\\\ )+?\\^"
}

fn pat_subscript() -> Str {
    "~(?:(?<!\\\\)(?:\\\\\\\\)*\\\\~|\\S|\\\\ )+?~"
}

fn pat_table() -> Str {
    "^ {0,3}\\|(?P<table_head>.+)\\|[ \\t]*\\n {0,3}\\|(?P<table_align> *[-:]+[-| :]*)\\|[ \\t]*\\n(?P<table_body>(?: {0,3}\\|.*\\|[ \\t]*(?:\\n|$))*)\\n*"
}

fn pat_nptable() -> Str {
    "^ {0,3}(?P<nptable_head>\\S.*\\|.*)\\n {0,3}(?P<nptable_align>[-:]+ *\\|[-| :]*)\\n(?P<nptable_body>(?:.*\\|.*(?:\\n|$))*)\\n*"
}

fn pat_ref_footnote() -> Str {
    "^(?P<footnote_lead> {0,3})\\[\\^(?P<footnote_key>(?:[^\\\\\\[\\]]|\\\\.){0,500})]:[ \\t](?P<footnote_text>[^\\n]*(?:\\n+|$)(?:(?P=footnote_lead) {1,3}(?! )[^\\n]*\\n+)*)"
}

fn pat_inline_footnote() -> Str {
    "\\[\\^(?P<footnote_key>(?:[^\\\\\\[\\]]|\\\\.){0,500})\\]"
}

fn pat_url_link() -> Str {
    "https?:\\/\\/[^\\s<]+[^<.,:;\"')\\]\\s]"
}

fn pat_ref_abbr() -> Str {
    "^ {0,3}\\*\\[(?P<abbr_key>[^\\]]+)(?<!\\\\)(?:\\\\\\\\)*\\]:(?P<abbr_text>(?:[ \\t]*\\n(?: {3,}|\\t)[^\\n]+)|(?:[^\\n]*))$"
}

fn pat_def_list() -> Str {
    "^(?P<def_list_head>(?:[^\\n]+\\n)+?)\\n?(?:\\:[ \\t]+.*\\n(?:[^\\n]+\\n)*(?:(?:[ \\t]*\\n)*[ \\t]+[^\\n]+\\n)*(?:[ \\t]*\\n)*)+"
}

fn pat_block_math() -> Str {
    "^ {0,3}\\$\\$[ \\t]*\\n(?P<math_text>[\\s\\S]+?)\\n\\$\\$[ \\t]*$"
}

fn pat_inline_math() -> Str {
    "\\$(?!\\s)(?P<math_text>.+?)(?!\\s)\\$"
}

fn pat_inline_spoiler() -> Str {
    ">!\\s*(?P<spoiler_text>.+?)\\s*!<"
}

fn pat_rst_directive_start() -> Str {
    "^\\.\\. +[a-zA-Z0-9_-]+\\:\\:"
}

fn pat_std_linebreak() -> Str {
    "(?:\\\\| {2,})\\n\\s*"
}

fn pat_hard_linebreak_rule() -> Str {
    " *\\n\\s*"
}

// BlockParser.SPECIFICATION.
fn block_spec() -> Vec[(String, Vec[i64])] {
    let mut v: Vec[(String, Vec[i64])] = Vec.new();
    v.push(("blank_line".to_string(), u("(^[ \\t\\v\\f]*\\n)+")));
    v.push(("axt_heading".to_string(), u("^ {0,3}(?P<axt_1>#{1,6})(?!#+)(?P<axt_2>[ \\t]*|[ \\t]+.*?)$")));
    v.push(("setex_heading".to_string(), u("^ {0,3}(?P<setext_1>=|-){1,}[ \\t]*$")));
    v.push(("fenced_code".to_string(), u("^(?P<fenced_1> {0,3})(?P<fenced_2>`{3,}|~{3,})[ \\t]*(?P<fenced_3>.*?)$")));
    v.push(("indent_code".to_string(), u("^(?: {4}| *\\t)[^\\n]+(?:\\n+|$)((?:(?: {4}| *\\t)[^\\n]+(?:\\n+|$))|\\s)*")));
    v.push(("thematic_break".to_string(), u("^ {0,3}((?:-[ \\t]*){3,}|(?:_[ \\t]*){3,}|(?:\\*[ \\t]*){3,})$")));
    v.push(("ref_link".to_string(), u("^ {0,3}\\[(?P<reflink_1>(?:[^\\\\\\[\\]]|\\\\.){0,500})\\]:")));
    v.push(("block_quote".to_string(), u("^ {0,3}>(?P<quote_1>.*?)$")));
    v.push(("list".to_string(), u("^(?P<list_1> {0,3})(?P<list_2>[\\*\\+-]|\\d{1,9}[.)])(?P<list_3>[ \\t]*|[ \\t].+)$")));
    v.push(("block_html".to_string(), u("^ {0,3}(?:(?:</?address|article|aside|base|basefont|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h1|h2|h3|h4|h5|h6|head|header|hr|html|iframe|legend|li|link|main|menu|menuitem|meta|nav|noframes|ol|optgroup|option|p|param|section|source|summary|table|tbody|td|tfoot|th|thead|title|tr|track|ul|pre|script|style|textarea(?:[ \\t]+|\\n|$))|<!--|<\\?|<![A-Z]|<!\\[CDATA\\[)")));
    v.push(("raw_html".to_string(), u("^ {0,3}(</?[A-Za-z][A-Za-z0-9-]*|<!--|<\\?|<![A-Z]|<!\\[CDATA\\[)")));
    v
}

// InlineParser.SPECIFICATION.
fn inline_spec() -> Vec[(String, Vec[i64])] {
    let mut v: Vec[(String, Vec[i64])] = Vec.new();
    v.push(("escape".to_string(), u("(?:\\\\[!\"\\#\\$%\\&'\\(\\)\\*\\+,\\-\\./:;<=>\\?@\\[\\\\\\]\\^_`\\{\\|\\}\\~])+")));
    v.push(("codespan".to_string(), u("`{1,}")));
    v.push(("emphasis".to_string(), u("\\*{1,3}(?=[^\\s*])|\\b_{1,3}(?=[^\\s_])")));
    v.push(("link".to_string(), u("!?\\[")));
    v.push(("auto_link".to_string(), u("<[A-Za-z][A-Za-z0-9.+-]{1,31}:[^<>\\x00-\\x20]*>")));
    v.push(("auto_email".to_string(), u("<[a-zA-Z0-9.!#$%&'*+\\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*>")));
    v.push(("inline_html".to_string(), u("<[A-Za-z][A-Za-z0-9-]*(?:\\s+[A-Za-z_:][A-Za-z0-9_.:-]*(?:\\s*=\\s*(?:[^ !\"\\'=<>`]+|\\'[^\\']*?\\'|\"[^\\\"]*?\"))?)*\\s*/?>|</[A-Za-z][A-Za-z0-9-]*\\s*>|<!--(?!>|->)(?:(?!--)[\\s\\S])+?(?<!-)-->|<\\?[\\s\\S]+?\\?>|<![A-Z][\\s\\S]+?>|<!\\[CDATA[\\s\\S]+?\\]\\]>")));
    v.push(("linebreak".to_string(), u("(?:\\\\| {2,})\\n\\s*")));
    v.push(("softbreak".to_string(), u(" *\\n\\s*")));
    v.push(("prec_auto_link".to_string(), u("<[A-Za-z][A-Za-z\\d.+-]{1,31}:")));
    v.push(("prec_inline_html".to_string(), u("</?[A-Za-z][A-Za-z0-9-]*|<!|<\\?")));
    v
}

