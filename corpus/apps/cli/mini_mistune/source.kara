    t.push_str("### Deep\n");
    t.push_str("## Part two\n");
    t.push_str("# End\n");
    v.push(DataFile { path: "cases.md".to_string(), body: t });
}

fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("Project **Kite**\n");
    t.push_str("================\n");
    t.push_str("\n");
    t.push_str("A *tiny* tool. Install: `pip install kite`.\n");
    t.push_str("\n");
    t.push_str("| a | b |\n");
    t.push_str("|---|---|\n");
    t.push_str("| 1 | 2 |\n");
    t.push_str("\n");
    t.push_str("~~old~~ new[^1]\n");
    t.push_str("\n");
    t.push_str("[^1]: A note.\n");
    v.push(DataFile { path: "cli/README.md".to_string(), body: t });
    let mut t = String.new();
    t.push_str("line one  \n");
    t.push_str("line two\n");
    t.push_str("\n");
    t.push_str("- a\n");
    t.push_str("- b\n");
    v.push(DataFile { path: "cli/notes.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# mini_mistune jobs: configs, then the runs that use them.\n");
    t.push_str("config html renderer=html escape=0 plugins=strikethrough,footnotes,table,speedup\n");
    t.push_str("config safe renderer=html escape=1\n");
    t.push_str("config wrap renderer=html escape=0 hard_wrap=1 plugins=speedup\n");
    t.push_str("config full renderer=html escape=0 plugins=strikethrough,mark,insert,superscript,subscript,footnotes,table,url,abbr,def_list,math,ruby,task_lists,spoiler rst=admonition,toc,image,figure fenced=admonition,include\n");
    t.push_str("config md renderer=markdown\n");
    t.push_str("config rst renderer=rst\n");
    t.push_str("config ast renderer=ast plugins=table,footnotes,task_lists\n");
    t.push_str("config docs renderer=html escape=0 plugins=strikethrough,mark,superscript,subscript,footnotes,table,url,abbr,def_list,math,task_lists fenced=admonition,toc,include,image,figure\n");
    t.push_str("cases cases.md html safe wrap full md rst ast\n");
    t.push_str("site docs site out\n");
    t.push_str("links docs site\n");
    t.push_str("cli -m\tHi **Markdown**\n");
    t.push_str("cli -m\t# Title\\n\\nText with <b>html</b>\t--escape\n");
    t.push_str("cli -f\tdata/cli/README.md\n");
    t.push_str("cli -f\tdata/cli/README.md\t-r\trst\n");
    t.push_str("cli -f\tdata/cli/README.md\t-r\tmarkdown\t-p\ttable\n");
    t.push_str("cli -f\tdata/cli/notes.txt\t--hardwrap\t-o\tdata/out/notes.html\n");
    t.push_str("cli -f\tdata/cli/README.md\t-p\tstrikethrough\tfootnotes\t-p\ttable\t-o\tdata/out/readme.html\n");
    t.push_str("cli -m\t- [ ] a\\n- [x] b\t-p\ttask_lists\t-r\tast\n");
    t.push_str("cli --version\n");
    t.push_str("cli -r\thtml\n");
    v.push(DataFile { path: "jobs.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("API reference\n");
    t.push_str("=============\n");
    t.push_str("\n");
    t.push_str("```{toc}\n");
    t.push_str(":min-level: 2\n");
    t.push_str(":max-level: 3\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("Build\n");
    t.push_str("-----\n");
    t.push_str("\n");
    t.push_str("`build(src, out, *, theme=None)` renders every page under `src`.\n");
    t.push_str("\n");
    t.push_str("### Arguments\n");
    t.push_str("\n");
    t.push_str("* **src**: the source folder\n");
    t.push_str("* **out**: the output folder\n");
    t.push_str("\n");
    t.push_str("Serve\n");
    t.push_str("-----\n");
    t.push_str("\n");
    t.push_str("`serve(out, port=8000)` serves `out` over HTTP.\n");
    t.push_str("\n");
    t.push_str("> **Note**: the server is for previews only.\n");
    t.push_str("> Use a real web server in production.\n");
    t.push_str("\n");
    t.push_str("Math: $O(n \\log n)$ for *n* pages, with the bound\n");
    t.push_str("\n");
    t.push_str("$$\n");
    t.push_str("T(n) = 2T(n/2) + n\n");
    t.push_str("$$\n");
    t.push_str("\n");
    t.push_str("*[HTTP]: Hypertext Transfer Protocol\n");
    v.push(DataFile { path: "site/api.md".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# Changelog\n");
    t.push_str("\n");
    t.push_str("## 2.1.0\n");
    t.push_str("\n");
    t.push_str("- Added ~~themes~~ ==theme packs==.\n");
    t.push_str("- Fixed H~2~O rendering, 2^10^ pages.\n");
    t.push_str("- Faster builds [^speed].\n");
    t.push_str("\n");
    t.push_str("## 2.0.0\n");
    t.push_str("\n");
    t.push_str("1. Rewrote the core.\n");
    t.push_str("2. Dropped Python 3.7.\n");
    t.push_str("\n");
    t.push_str("---\n");
    t.push_str("\n");
    t.push_str("Older releases: see <https://example.com/lumen/history>.\n");
    t.push_str("\n");
    t.push_str("[^speed]: About 40% faster on large sites.\n");
    v.push(DataFile { path: "site/changelog.md".to_string(), body: t });
    let mut t = String.new();
    t.push_str("Install Lumen with pip:\n");
    t.push_str("\n");
    t.push_str("    pip install lumen\n");
    t.push_str("\n");
    t.push_str("Then check the version:\n");
    t.push_str("\n");
    t.push_str("```console\n");
    t.push_str("$ lumen --version\n");
    t.push_str("lumen 2.1.0\n");
    t.push_str("```\n");
    v.push(DataFile { path: "site/guide/install.md".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# Usage\n");
    t.push_str("\n");
    t.push_str("```{toc}\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("## Build\n");
    t.push_str("\n");
    t.push_str("Run `lumen build`. The output goes to `site/` by default; change it with\n");
    t.push_str("`--out`.\n");
    t.push_str("\n");
    t.push_str("```{warning}\n");
    t.push_str("Building overwrites the output folder.\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("## Serve\n");
    t.push_str("\n");
    t.push_str("Run `lumen serve` and open <http://localhost:8000/>.\n");
    t.push_str("Back to the [index](../index.md).\n");
    t.push_str("\n");
    t.push_str("### Options\n");
    t.push_str("\n");
    t.push_str("Term\n");
    t.push_str(":   Meaning of the term.\n");
    t.push_str("\n");
    t.push_str("Port\n");
    t.push_str(":   The port to listen on, *8000* by default.\n");
    t.push_str("\n");
    t.push_str("```{include} ../snippets/note.md\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("```{include} usage.md\n");
    t.push_str("```\n");
    v.push(DataFile { path: "site/guide/usage.md".to_string(), body: t });
}

fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# Lumen documentation\n");
    t.push_str("\n");
    t.push_str("Lumen is a static site toolkit. This page is the entry point.\n");
    t.push_str("\n");
    t.push_str("```{toc} On this page\n");
    t.push_str(":max-level: 2\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("## Getting started\n");
    t.push_str("\n");
    t.push_str("```{include} guide/install.md\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("```{note} Before you begin\n");
    t.push_str(":class: tip-box\n");
    t.push_str("\n");
    t.push_str("You need Python 3.8 or later. See [usage](guide/usage.md).\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("## Configuration\n");
    t.push_str("\n");
    t.push_str("| Key | Default | Meaning |\n");
    t.push_str("|:----|:-------:|--------:|\n");
    t.push_str("| `title` | *none* | Site title |\n");
    t.push_str("| `theme` | `plain` | Theme name |\n");
    t.push_str("| `out` | `site/` | Output folder |\n");
    t.push_str("\n");
    t.push_str("The defaults are fine for most sites.[^defaults]\n");
    t.push_str("\n");
    t.push_str("[^defaults]: They follow the conventions of other generators.\n");
    t.push_str("\n");
    t.push_str("## Examples\n");
    t.push_str("\n");
    t.push_str("```{include} snippets/example.py\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("```{include} snippets/banner.html\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("```{figure} /images/arch.png\n");
    t.push_str(":figwidth: 60%\n");
    t.push_str(":align: center\n");
    t.push_str("\n");
    t.push_str("The build pipeline.\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("## Checklist\n");
    t.push_str("\n");
    t.push_str("- [x] write pages\n");
    t.push_str("- [ ] add search\n");
    t.push_str("- [ ] publish\n");
    t.push_str("\n");
    t.push_str("See the [API reference](api.md), the [changelog](changelog.md) and the\n");
    t.push_str("[missing page](guide/missing.md).\n");
    v.push(DataFile { path: "site/index.md".to_string(), body: t });
    let mut t = String.new();
    t.push_str("<div class=\"banner\">Lumen <b>2.1</b></div>\n");
    v.push(DataFile { path: "site/snippets/banner.html".to_string(), body: t });
    let mut t = String.new();
    t.push_str("from lumen import build\n");
    t.push_str("\n");
    t.push_str("build(\"docs\", \"site\")\n");
    v.push(DataFile { path: "site/snippets/example.py".to_string(), body: t });
    let mut t = String.new();
    t.push_str("> Included note: *see also* the [api](../api.md).\n");
    v.push(DataFile { path: "site/snippets/note.md".to_string(), body: t });
}
