    m.insert("zacute;".to_string(), "\u{17a}".to_string());
    m.insert("zcaron;".to_string(), "\u{17e}".to_string());
    m.insert("zcy;".to_string(), "\u{437}".to_string());
    m.insert("zdot;".to_string(), "\u{17c}".to_string());
    m.insert("zeetrf;".to_string(), "\u{2128}".to_string());
    m.insert("zeta;".to_string(), "\u{3b6}".to_string());
    m.insert("zfr;".to_string(), "\u{1d537}".to_string());
    m.insert("zhcy;".to_string(), "\u{436}".to_string());
    m.insert("zigrarr;".to_string(), "\u{21dd}".to_string());
    m.insert("zopf;".to_string(), "\u{1d56b}".to_string());
    m.insert("zscr;".to_string(), "\u{1d4cf}".to_string());
    m.insert("zwj;".to_string(), "\u{200d}".to_string());
    m.insert("zwnj;".to_string(), "\u{200c}".to_string());
}
// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

