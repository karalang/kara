        }
        1074 => {
            out.push(7296);
        }
        1076 => {
            out.push(7297);
        }
        1086 => {
            out.push(7298);
        }
        1089 => {
            out.push(7299);
        }
        1090 => {
            out.push(7300);
            out.push(7301);
        }
        1098 => {
            out.push(7302);
        }
        1123 => {
            out.push(7303);
        }
        7296 => {
            out.push(1074);
        }
        7297 => {
            out.push(1076);
        }
        7298 => {
            out.push(1086);
        }
        7299 => {
