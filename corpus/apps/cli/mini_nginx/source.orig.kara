    s.push_str("        server 10.0.0.11:8080;\n");
    s.push_str("        server 10.0.0.12:8080;\n");
    s.push_str("        server 10.0.0.13:8080;\n");
    s.push_str("    }\n");
    s.push_str("\n");
    s.push_str("    # Requests for a name no server claims are dropped.\n");
    s.push_str("    server {\n");
    s.push_str("        listen 80 default_server;\n");
    s.push_str("        server_name _;\n");
    s.push_str("        return 444;\n");
    s.push_str("    }\n");
    s.push_str("\n");
