fn write_data() -> Result[(), String] {
    for (name, text) in data_files() {
        let path = f"data/{name}";
        if let Err(e) = fs.create_dir_all(dirname(path.as_str())) {
            return Err(f"{e}");
        }
        if let Err(e) = fs.write(path, text) {
            return Err(f"{e}");
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    for b in ["data/broken1.conf", "data/broken2.conf", "data/broken3.conf"] {
        check(b);
    }
    let tree = match check("data/nginx.conf") {
        Some(t) => t,
        None => return Err("nginx.conf did not load".to_string()),
    };
    let mut site = Site { servers: Vec.new(), upstreams: Vec.new(), types: Vec.new(), default_type: "text/plain".to_string() };
    for top in tree {
        if top.name != "http" {
            continue;
        }
        for d in top.block {
            if d.name == "types" {
                for t in d.block {
                    for ext in t.args {
                        site.types.push((ext.clone(), t.name.clone()));
                    }
                }
            } else if d.name == "default_type" {
                site.default_type = d.args[0].clone();
            } else if d.name == "upstream" {
                let mut peers: Vec[String] = Vec.new();
                for s in d.block {
                    if s.name == "server" {
                        peers.push(s.args[0].clone());
                    }
                }
                site.upstreams.push(Upstream { name: d.args[0].clone(), peers: peers, used: 0 });
            } else if d.name == "server" {
                site.servers.push(Server.new(d)?);
            }
        }
    }
    let mut nloc = 0;
    for s in site.servers {
        nloc += s.locations.len();
    }
    println(f"{site.servers.len()} servers, {nloc} locations, {site.upstreams.len()} upstreams, {site.types.len()} types");
    println("");
    let requests = fs.read_to_string("data/requests.txt".to_string()).unwrap_or(String.new());
    for line in requests.split("\n") {
        if line.is_empty() or line.starts_with("#") {
            continue;
        }
        let f = line.split(" ");
        serve(site, i64.parse(f[1]).unwrap_or(80), f[2].as_str(), f[3].as_str());
    }
    for u in site.upstreams {
        println(f"upstream {u.name}: {u.used} request(s) over {u.peers.len()} peers");
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(f"error: {e}");
    }
}
