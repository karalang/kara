== query
'a=1&b=2&a=3'
  qsl [('a', '1'), ('b', '2'), ('a', '3')]
  qsl blank [('a', '1'), ('b', '2'), ('a', '3')]
  qsl strict [('a', '1'), ('b', '2'), ('a', '3')]
  qsl ';' [('a', '1&b=2&a=3')]
  qs {'a': ['1', '3'], 'b': ['2']}
  encode 'a=1&b=2&a=3'
  encode doseq 'a=1&a=3&b=2'
  encode quote 'a=1&b=2&a=3'
'name=John+Doe&city=New%20York'
  qsl [('name', 'John Doe'), ('city', 'New York')]
  qsl blank [('name', 'John Doe'), ('city', 'New York')]
  qsl strict [('name', 'John Doe'), ('city', 'New York')]
  qsl ';' [('name', 'John Doe&city=New York')]
  qs {'name': ['John Doe'], 'city': ['New York']}
  encode 'name=John+Doe&city=New+York'
  encode doseq 'name=John+Doe&city=New+York'
  encode quote 'name=John%20Doe&city=New%20York'
'empty=&flag&x=1'
  qsl [('x', '1')]
  qsl blank [('empty', ''), ('flag', ''), ('x', '1')]
  qsl strict Error: ValueError: bad query field: 'flag'
  qsl ';' [('empty', '&flag&x=1')]
  qs {'empty': [''], 'flag': [''], 'x': ['1']}
  encode 'empty=&flag=&x=1'
  encode doseq 'empty=&flag=&x=1'
  encode quote 'empty=&flag=&x=1'
'=nokey&k='
  qsl [('', 'nokey')]
  qsl blank [('', 'nokey'), ('k', '')]
  qsl strict [('', 'nokey'), ('k', '')]
  qsl ';' [('', 'nokey&k=')]
  qs {'': ['nokey'], 'k': ['']}
  encode '=nokey&k='
  encode doseq '=nokey&k='
  encode quote '=nokey&k='
'&&a=1&&'
  qsl [('a', '1')]
  qsl blank [('a', '1')]
  qsl strict Error: ValueError: bad query field: ''
  qsl ';' [('&&a', '1&&')]
  qs {'a': ['1']}
  encode 'a=1'
  encode doseq 'a=1'
  encode quote 'a=1'
'q=%E2%9C%93&lang=de-DE'
  qsl [('q', '✓'), ('lang', 'de-DE')]
  qsl blank [('q', '✓'), ('lang', 'de-DE')]
  qsl strict [('q', '✓'), ('lang', 'de-DE')]
  qsl ';' [('q', '✓&lang=de-DE')]
  qs {'q': ['✓'], 'lang': ['de-DE']}
  encode 'q=%E2%9C%93&lang=de-DE'
  encode doseq 'q=%E2%9C%93&lang=de-DE'
  encode quote 'q=%E2%9C%93&lang=de-DE'
'x=1;y=2'
  qsl [('x', '1;y=2')]
  qsl blank [('x', '1;y=2')]
  qsl strict [('x', '1;y=2')]
  qsl ';' [('x', '1'), ('y', '2')]
  qs {'x': ['1;y=2']}
  encode 'x=1%3By%3D2'
  encode doseq 'x=1%3By%3D2'
  encode quote 'x=1%3By%3D2'
'plus=a%2Bb+c&eq=a=b=c'
  qsl [('plus', 'a+b c'), ('eq', 'a=b=c')]
  qsl blank [('plus', 'a+b c'), ('eq', 'a=b=c')]
  qsl strict [('plus', 'a+b c'), ('eq', 'a=b=c')]
  qsl ';' [('plus', 'a+b c&eq=a=b=c')]
  qs {'plus': ['a+b c'], 'eq': ['a=b=c']}
  encode 'plus=a%2Bb+c&eq=a%3Db%3Dc'
  encode doseq 'plus=a%2Bb+c&eq=a%3Db%3Dc'
  encode quote 'plus=a%2Bb%20c&eq=a%3Db%3Dc'
'k=caf%C3%A9&bad=%FF'
  qsl [('k', 'café'), ('bad', '�')]
  qsl blank [('k', 'café'), ('bad', '�')]
  qsl strict [('k', 'café'), ('bad', '�')]
  qsl ';' [('k', 'café&bad=�')]
  qs {'k': ['café'], 'bad': ['�']}
  encode 'k=caf%C3%A9&bad=%EF%BF%BD'
  encode doseq 'k=caf%C3%A9&bad=%EF%BF%BD'
  encode quote 'k=caf%C3%A9&bad=%EF%BF%BD'
''
  qsl []
  qsl blank []
  qsl strict []
  qsl ';' []
  qs {}
  encode ''
  encode doseq ''
  encode quote ''
