  quote safe='' '%2Fpath%2Fto%2Ffile%20name.txt'
  quote_plus '%2Fpath%2Fto%2Ffile+name.txt'
  unquote '/path/to/file name.txt'
  unquote_plus '/path/to/file name.txt'
'a+b=c&d'
