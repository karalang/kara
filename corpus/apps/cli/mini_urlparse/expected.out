== join
-- base 'http://a/b/c/d;p?q'
  'g:h' -> 'g:h'
  'g' -> 'http://a/b/c/g'
  './g' -> 'http://a/b/c/g'
  'g/' -> 'http://a/b/c/g/'
  '/g' -> 'http://a/g'
  '//g' -> 'http://g'
  '?y' -> 'http://a/b/c/d;p?y'
  'g?y' -> 'http://a/b/c/g?y'
  '#s' -> 'http://a/b/c/d;p?q#s'
  'g#s' -> 'http://a/b/c/g#s'
  'g?y#s' -> 'http://a/b/c/g?y#s'
  ';x' -> 'http://a/b/c/;x'
  'g;x' -> 'http://a/b/c/g;x'
  'g;x?y#s' -> 'http://a/b/c/g;x?y#s'
  '' -> 'http://a/b/c/d;p?q'
  '.' -> 'http://a/b/c/'
  './' -> 'http://a/b/c/'
  '..' -> 'http://a/b/'
  '../' -> 'http://a/b/'
  '../g' -> 'http://a/b/g'
  '../..' -> 'http://a/'
  '../../' -> 'http://a/'
  '../../g' -> 'http://a/g'
  '../../../g' -> 'http://a/g'
  '../../../../g' -> 'http://a/g'
  '/./g' -> 'http://a/g'
  '/../g' -> 'http://a/g'
  'g.' -> 'http://a/b/c/g.'
  '.g' -> 'http://a/b/c/.g'
  'g..' -> 'http://a/b/c/g..'
  '..g' -> 'http://a/b/c/..g'
  './../g' -> 'http://a/b/g'
  './g/.' -> 'http://a/b/c/g/'
  'g/./h' -> 'http://a/b/c/g/h'
  'g/../h' -> 'http://a/b/c/h'
  'g;x=1/./y' -> 'http://a/b/c/g;x=1/y'
  'g;x=1/../y' -> 'http://a/b/c/y'
  'g?y/./x' -> 'http://a/b/c/g?y/./x'
  'g?y/../x' -> 'http://a/b/c/g?y/../x'
  'g#s/./x' -> 'http://a/b/c/g#s/./x'
  'g#s/../x' -> 'http://a/b/c/g#s/../x'
  'http:g' -> 'http://a/b/c/g'
  'http://other/x/../y' -> 'http://other/x/../y'
  'https://a/b' -> 'https://a/b'
-- base 'http://a/b/c/'
  'd' -> 'http://a/b/c/d'
  '../../../..' -> 'http://a/'
  '//' -> 'http://a/b/c/'
-- base 'https://shop.example.com/catalog/shoes/index.html?page=2'
  '../bags/' -> 'https://shop.example.com/catalog/bags/'
  'item.html?id=7#reviews' -> 'https://shop.example.com/catalog/shoes/item.html?id=7#reviews'
  '/' -> 'https://shop.example.com/'
  'mailto:x@y' -> 'mailto:x@y'
  '#top' -> 'https://shop.example.com/catalog/shoes/index.html?page=2#top'
-- base 'mailto:a@b'
  'c@d' -> 'c@d'
-- base ''
  'anything' -> 'anything'
-- base 'file:///home/user/docs/'
  '../music/song.mp3' -> 'file:///home/user/music/song.mp3'
-- base 'svn+ssh://svn.example.org/repo/trunk/src/'
  '../../branches/x' -> 'svn+ssh://svn.example.org/repo/branches/x'
-- base 'tel:+1'
  '2' -> '2'
