fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/access.log", file_0())?;
    put("data/joins.txt", file_1())?;
    put("data/queries.txt", file_2())?;
    put("data/quotes.txt", file_3())?;
    put("data/urls.txt", file_4())?;
    Ok(())
}

// ------------------------------------------------------------ the cases

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn show_split() -> Result[(), String] {
    println("== split");
    let lines = lines_of(read("data/urls.txt")?);
    for i in 0..lines.len() {
        let url = unescape(lines[i]);
        println(py_repr(url));
        let s = match urlsplit(url, "") {
            Ok(s) => s,
            Err(e) => {
                println(f"  Error: ValueError: {e}");
                continue;
            }
        };
        println(f"  split {s.repr()}");
        println(f"  parse {urlparse(url, "")?.repr()}");
        let port = match s.port() {
            Ok(Some(p)) => f"{p}",
            Ok(None) => "None".to_string(),
            Err(e) => f"Error: ValueError: {e}",
        };
        println(f"  username={opt_repr(s.username())} password={opt_repr(s.password())} hostname={opt_repr(s.hostname())} port={port}");
        println(f"  unsplit {py_repr(unsplit(s))}");
        let (u, f) = urldefrag(url)?;
        println(f"  defrag DefragResult(url={py_repr(u)}, fragment={py_repr(f)})");
    }
    Ok(())
}

fn show_join() -> Result[(), String] {
    println("== join");
    let lines = lines_of(read("data/joins.txt")?);
    let mut base = String.new();
    for i in 0..lines.len() {
        let line = lines[i].clone();
        if line == "base" or starts_with(line, "base ") {
            base = slice_from(line, 5);
            println(f"-- base {py_repr(base)}");
            continue;
        }
        let rel = if line == "<empty>" { String.new() } else { line };
        println(f"  {py_repr(rel)} -> {py_repr(urljoin(base, rel)?)}");
    }
    Ok(())
}

fn show_quote() -> Result[(), String] {
    println("== quote");
    let lines = lines_of(read("data/quotes.txt")?);
    for i in 0..lines.len() {
        let t = lines[i].clone();
        println(py_repr(t));
        println(f"  quote {py_repr(quote(t, "/"))}");
        println(f"  quote safe='' {py_repr(quote(t, ""))}");
        println(f"  quote_plus {py_repr(quote_plus(t, ""))}");
        println(f"  unquote {py_repr(unquote(t))}");
        println(f"  unquote_plus {py_repr(unquote_plus(t))}");
    }
    Ok(())
}

fn show_query() -> Result[(), String] {
    println("== query");
    let lines = lines_of(read("data/queries.txt")?);
    for i in 0..lines.len() {
        let q = if lines[i] == "<empty>" { String.new() } else { lines[i].clone() };
        println(py_repr(q));
        println(f"  qsl {pairs_repr(parse_qsl(q, false, false, "&")?)}");
        let kept = parse_qsl(q, true, false, "&")?;
        println(f"  qsl blank {pairs_repr(kept)}");
        match parse_qsl(q, true, true, "&") {
            Ok(v) => println(f"  qsl strict {pairs_repr(v)}"),
            Err(e) => println(f"  qsl strict Error: ValueError: {e}"),
        }
        println(f"  qsl ';' {pairs_repr(parse_qsl(q, false, false, ";")?)}");
        let d = parse_qs(kept);
        println(f"  qs {d.repr()}");
        println(f"  encode {py_repr(urlencode(kept, "", true))}");
        println(f"  encode doseq {py_repr(urlencode_multi(d))}");
        println(f"  encode quote {py_repr(urlencode(kept, "/", false))}");
    }
    Ok(())
}

// ------------------------------------------------------------ the access log

const SITE: Str = "https://shop.example.com/";

// The URL with its host lower-cased, a default port dropped, its path
// unquoted and quoted again, its query sorted by name and no fragment.
fn canonical(url: Str) -> Result[String, String] {
    let s = urlsplit(url, "")?;
    let mut host = s.hostname().unwrap_or(String.new());
    if has_byte(host, b':') {
        host = f"[{host}]";
    }
    let port = s.port()?;
    let netloc = match port {
        None => host,
        Some(p) => {
            let default = (s.scheme == "http" and p == 80) or (s.scheme == "https" and p == 443);
            if default { host } else { f"{host}:{p}" }
        }
    };
    let mut path = quote(unquote(s.path), "/");
    if path.len() == 0 {
        path = "/".to_string();
    }
    // sorted() on the names, which is stable
    let mut pairs = parse_qsl(s.query, true, false, "&")?;
    for i in 1..pairs.len() {
        let mut j = i;
        while j > 0 and pairs[j - 1].name > pairs[j].name {
            pairs.swap(j - 1, j);
            j -= 1;
        }
    }
    Ok(urlunsplit(s.scheme, netloc, path, urlencode(pairs, "", true), ""))
}

struct Hit {
    ip: String,
    method: String,
    target: String,
    status: i64,
    referer: String,
}

// A line of the combined log format.
fn parse_log_line(line: Str) -> Hit {
    let q = split_on(line, b'"');
    let head = split_ws(q[0]);
    let request = split_on(q[1], b' ');
    let tail = split_ws(q[2]);
    let mut status: i64 = 0;
    let sb = to_bytes(tail[0]);
    for i in 0..sb.len() {
        status = status * 10 + (sb[i] - b'0') as i64;
    }
    Hit { ip: head[0].clone(), method: request[0].clone(), target: request[1].clone(), status: status, referer: q[3].clone() }
}

fn write_file(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn show_report() -> Result[(), String] {
    println("== report");
    let mut pages: Vec[String] = Vec.new();
    let mut page_n: Vec[i64] = Vec.new();
    let mut hosts: Vec[String] = Vec.new();
    let mut host_n: Vec[i64] = Vec.new();
    let mut terms: Vec[String] = Vec.new();
    let mut term_n: Vec[i64] = Vec.new();
    let mut params: Vec[String] = Vec.new();
    let mut param_n: Vec[i64] = Vec.new();
    let lines = lines_of(read("data/access.log")?);
    for i in 0..lines.len() {
        let r = parse_log_line(lines[i]);
        let url = urljoin(SITE, r.target)?;
        let s = urlsplit(url, "")?;
        let where_ = if s.netloc == "shop.example.com" { "site" } else { "OFFSITE" };
        let c = canonical(url)?;
        println(f"{r.ip} {r.method} {r.status} {where_} {c}");
        if where_ == "site" and r.status < 400 {
            bump(mut pages, mut page_n, urlsplit(c, "")?.path);
        }
        let qs = parse_qsl(s.query, true, false, "&")?;
        for k in 0..qs.len() {
            bump(mut params, mut param_n, qs[k].name);
            if qs[k].name == "q" and s.path == "/search" {
                bump(mut terms, mut term_n, qs[k].value);
            }
        }
        if r.referer == "-" {
            continue;
        }
        let rs = match urlsplit(r.referer, "") {
            Ok(rs) => rs,
            Err(e) => {
                println(f"  referer {py_repr(r.referer)}: Error: ValueError: {e}");
                continue;
            }
        };
        let rc = match canonical(r.referer) {
            Ok(rc) => rc,
            Err(e) => {
                println(f"  referer {py_repr(r.referer)}: Error: ValueError: {e}");
                continue;
            }
        };
        println(f"  referer {rc}");
        let mut rh = rs.hostname().unwrap_or(String.new());
        if starts_with(rh, "www.") {
            rh = slice_from(rh, 4);
        }
        bump(mut hosts, mut host_n, rh);
        if rh == "google.com" or rh == "bing.com" {
            let rq = parse_qsl(rs.query, false, false, "&")?;
            for k in 0..rq.len() {
                if rq[k].name == "q" {
                    bump(mut terms, mut term_n, rq[k].value);
                }
            }
        }
    }
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    let mut out = String.new();
    let order = sort_counts(pages, page_n);
    for k in 0..order.len() {
        let i = order[k];
        out.push_str(f"{page_n[i]} {urljoin(SITE, quote(pages[i], "/"))?}\n");
    }
    write_file("data/out/pages.txt", out)?;
    let mut out = String.new();
    let order = sort_counts(terms, term_n);
    for k in 0..order.len() {
        let i = order[k];
        let pairs = [Pair { name: "q".to_string(), value: terms[i].clone() }, Pair { name: "n".to_string(), value: f"{term_n[i]}" }];
        out.push_str(f"{urlencode(pairs, "", true)}\n");
    }
    write_file("data/out/terms.txt", out)?;
    let names = ["pages.txt", "terms.txt"];
    for k in 0..names.len() {
        println(f"-- data/out/{names[k]}");
        let back = lines_of(read(f"data/out/{names[k]}")?);
        for i in 0..back.len() {
            println(back[i]);
        }
    }
    println("-- referers");
    let order = sort_counts(hosts, host_n);
    for k in 0..order.len() {
        println(f"{host_n[order[k]]} {hosts[order[k]]}");
    }
    println("-- params");
    let order = sort_counts(params, param_n);
    for k in 0..order.len() {
        println(f"{param_n[order[k]]} {py_repr(params[order[k]])}");
    }
    println("-- terms read back");
    let back = lines_of(read("data/out/terms.txt")?);
    for i in 0..back.len() {
        // dict(parse_qsl(line)): the last value of a name wins
        let pairs = parse_qsl(back[i], false, false, "&")?;
        let mut q = String.new();
        let mut n = String.new();
        for k in 0..pairs.len() {
            if pairs[k].name == "q" {
                q = pairs[k].value.clone();
            }
            if pairs[k].name == "n" {
                n = pairs[k].value.clone();
            }
        }
        println(f"{n} {py_repr(q)}");
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    show_split()?;
    show_join()?;
    show_quote()?;
    show_query()?;
    show_report()?;
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_urlparse: {e}");
    }
}
