// ------------------------------------------------------------ Python str helpers

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

// str.isprintable(), for the characters property files hold.
fn py_printable(c: char) -> bool {
    let n = c as i64;
    if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x206f) or n == 0x3000 or n == 0xfeff or n == 0xfffe or n == 0xffff or (n >= 0xfff9 and n <= 0xfffb) {
        return false;
    }
    not (n >= 0xe000 and n <= 0xf8ff)
}

// repr() of a str.
fn py_repr_str(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if py_printable(c) {
            out.push(c);
        } else {
            let n = c as i64;
            if n < 0x100 {
                out.push_str(f"\\x{hex_digits(n, 2)}");
            } else if n < 0x10000 {
                out.push_str(f"\\u{hex_digits(n, 4)}");
            } else {
                out.push_str(f"\\U{hex_digits(n, 8)}");
            }
        }
    }
    out.push(q);
    out
}
// ------------------------------------------------------------ int()
//
// Python's int() of a str, as parse_uri runs it on digits, period and
// counter (from mini_sexpdata).

// The non-ASCII characters str.isspace() is true for.
fn uni_space(c: char) -> bool {
    let n = c as i64;
    n == 0x85 or n == 0xa0 or n == 0x1680 or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029
        or n == 0x202f or n == 0x205f or n == 0x3000
}

// The value of a Unicode decimal digit (category Nd), or -1. Each block
// of ten digits starts at one of these zeros (Unicode 15.1, as Python
// 3.13 has it).
fn uni_digit(c: char) -> i64 {
    let zeros: Vec[i64] = vec![
        0x30, 0x660, 0x6f0, 0x7c0, 0x966, 0x9e6, 0xa66, 0xae6,
        0xb66, 0xbe6, 0xc66, 0xce6, 0xd66, 0xde6, 0xe50, 0xed0,
        0xf20, 0x1040, 0x1090, 0x17e0, 0x1810, 0x1946, 0x19d0, 0x1a80,
        0x1a90, 0x1b50, 0x1bb0, 0x1c40, 0x1c50, 0xa620, 0xa8d0, 0xa900,
        0xa9d0, 0xa9f0, 0xaa50, 0xabf0, 0xff10, 0x104a0, 0x10d30, 0x11066,
        0x110f0, 0x11136, 0x111d0, 0x112f0, 0x11450, 0x114d0, 0x11650, 0x116c0,
        0x11730, 0x118e0, 0x11950, 0x11c50, 0x11d50, 0x11da0, 0x11f50, 0x16a60,
        0x16ac0, 0x16b50, 0x1d7ce, 0x1d7d8, 0x1d7e2, 0x1d7ec, 0x1d7f6, 0x1e140,
        0x1e2f0, 0x1e4f0, 0x1e950, 0x1fbf0,
    ];
    let n = c as i64;
    for z in zeros.iter() {
        if n >= *z and n < *z + 10 {
            return n - *z;
        }
    }
    -1
}

fn is_ascii_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn ascii_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}'
}

// What float() and int() do first: Unicode white space becomes a space
// and a Unicode decimal digit its ASCII digit; any other non-ASCII
// character makes the text invalid. Then the white space at the ends is
// stripped and underscores between digits removed.
fn number_text(cs: ref Vec[char]) -> Option[Vec[char]] {
    let mut t: Vec[char] = Vec.new();
    for c in cs.iter() {
        let n = *c as u32;
        if n < 128 {
            t.push(*c);
        } else if uni_space(*c) {
            t.push(' ');
        } else if uni_digit(*c) >= 0 {
            t.push(char.try_from(48 + uni_digit(*c) as u32).unwrap_or('?'));
        } else {
            return None;
        }
    }
    let mut a = 0;
    while a < t.len() and ascii_space(t[a]) {
        a += 1;
    }
    let mut b = t.len();
    while b > a and ascii_space(t[b - 1]) {
        b -= 1;
    }
    let mut out: Vec[char] = Vec.new();
    let mut prev = ' ';
    for i in a..b {
        let c = t[i];
        if c == '_' {
            if not is_ascii_digit(prev) {
                return None;
            }
        } else {
            if prev == '_' and not is_ascii_digit(c) {
                return None;
            }
            out.push(c);
        }
        prev = c;
    }
    if prev == '_' {
        return None;
    }
    Some(out)
}

// The digits of an int, with a '-' when it is below zero.
fn norm_int(neg: bool, ds: ref Vec[char]) -> String {
    let mut s = String.new();
    let mut started = false;
    for c in ds.iter() {
        if *c != '0' {
            started = true;
        }
        if started {
            s.push(*c);
        }
    }
    if not started {
        return "0".to_string();
    }
    if neg { f"-{s}" } else { s }
}

// int() of a str; None where it raises ValueError.
fn py_int(cs: ref Vec[char]) -> Option[String] {
    let t = number_text(cs)?;
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i == t.len() {
        return None;
    }
    let mut ds: Vec[char] = Vec.new();
    while i < t.len() {
        if not is_ascii_digit(t[i]) {
            return None;
        }
        ds.push(t[i]);
        i += 1;
    }
    Some(norm_int(neg, ds))
}
// ------------------------------------------------------------ urllib.parse (from mini_urlparse)

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// A word character, as `\w` and `\b` see it.
fn is_word(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c >= 128
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn contains_str(v: ref Vec[String], s: Str) -> bool {
    for i in 0..v.len() {
        if v[i] == s {
            return true;
        }
    }
    false
}

// A stable sort of strings.
fn sort_strings(v: own Vec[String]) -> Vec[String] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    py_repr_str(s.to_string())
}


fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn byte_at(s: Str, i: i64) -> u8 {
    let b = to_bytes(s);
    if i >= 0 and i < b.len() { b[i] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn spaces(n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(" ");
    }
    out
}


// ------------------------------------------------------------ more text

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn replace_byte(s: Str, c: u8, with: Str) -> String {
    let b = to_bytes(s);
    let w = to_bytes(with);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if b[i] == c {
            for k in 0..w.len() {
                out.push(w[k]);
            }
        } else {
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

fn opt_repr(v: ref Option[String]) -> String {
    match v {
        Some(s) => py_repr(s),
        None => "None".to_string(),
    }
}

// The data files spell tabs, line ends and control characters as \t,
// \n, \r and \xNN.
fn unescape(line: Str) -> String {
    let b = to_bytes(line);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'\\' and i + 1 < b.len() {
            let n = b[i + 1];
            if n == b't' {
                out.push(b'\t');
                i += 2;
                continue;
            }
            if n == b'n' {
                out.push(b'\n');
                i += 2;
                continue;
            }
            if n == b'r' {
                out.push(b'\r');
                i += 2;
                continue;
            }
            if n == b'\\' {
                out.push(b'\\');
                i += 2;
                continue;
            }
            if n == b'x' and i + 3 < b.len() {
                out.push(hex_val(b[i + 2]) * 16 + hex_val(b[i + 3]));
                i += 4;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    from_bytes(out)
}

fn push_str_bytes(out: mut ref Vec[u8], s: Str) {
    let b = to_bytes(s);
    for i in 0..b.len() {
        out.push(b[i]);
    }
}

// bytes.decode('utf-8', 'replace'): each maximal ill-formed subpart
// becomes one U+FFFD, as CPython's decoder does it.
fn utf8_replace(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c < 0x80 {
            out.push(c);
            i += 1;
            continue;
        }
        let mut need: i64 = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c >= 0xC2 and c <= 0xDF {
            need = 1;
        } else if c >= 0xE0 and c <= 0xEF {
            need = 2;
            if c == 0xE0 {
                lo = 0xA0;
            }
            if c == 0xED {
                hi = 0x9F;
            }
        } else if c >= 0xF0 and c <= 0xF4 {
            need = 3;
            if c == 0xF0 {
                lo = 0x90;
            }
            if c == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            push_str_bytes(mut out, "\u{FFFD}");
            i += 1;
            continue;
        }
        let mut j = i + 1;
        let mut ok = true;
        for k in 0..need {
            if j >= b.len() {
                ok = false;
                break;
            }
            let d = b[j];
            let (l, h) = if k == 0 { (lo, hi) } else { (0x80 as u8, 0xBF as u8) };
            if d < l or d > h {
                ok = false;
                break;
            }
            j += 1;
        }
        if ok {
            for k in i..j {
                out.push(b[k]);
            }
        } else {
            push_str_bytes(mut out, "\u{FFFD}");
        }
        i = j;
    }
    from_bytes(out)
}

// ------------------------------------------------------------ ipaddress

// IPv4Address's parser: four decimal octets, no leading zeros.
fn is_ipv4(s: Str) -> bool {
    let parts = split_on(s, b'.');
    if parts.len() != 4 {
        return false;
    }
    for i in 0..parts.len() {
        let b = to_bytes(parts[i]);
        if b.len() == 0 or b.len() > 3 {
            return false;
        }
        let mut n: i64 = 0;
        for k in 0..b.len() {
            if not is_digit(b[k]) {
                return false;
            }
            n = n * 10 + (b[k] - b'0') as i64;
        }
        if n > 255 or (b.len() > 1 and b[0] == b'0') {
            return false;
        }
    }
    true
}

fn is_hextet(s: Str) -> bool {
    let b = to_bytes(s);
    if b.len() == 0 or b.len() > 4 {
        return false;
    }
    for k in 0..b.len() {
        if not is_hex(b[k]) {
            return false;
        }
    }
    true
}

// IPv6Address's parser: at most one `::`, eight hextets in all, an IPv4
// tail, and a `%scope`.
fn is_ipv6(s: Str) -> bool {
    let (addr, has_scope, scope) = partition(s, b'%');
    if has_scope and (scope.len() == 0 or has_byte(scope, b'%')) {
        return false;
    }
    let mut parts = split_on(addr, b':');
    if parts.len() < 3 {
        return false;
    }
    let last = parts[parts.len() - 1].clone();
    if has_byte(last, b'.') {
        if not is_ipv4(last) {
            return false;
        }
        parts.pop();
        parts.push("0".to_string());
        parts.push("0".to_string());
    }
    if parts.len() > 9 {
        return false;
    }
    let n = parts.len();
    let mut skip: i64 = -1;
    for i in 1..n - 1 {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return false;
            }
            skip = i;
        }
    }
    let mut hi = n;
    let mut lo: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = n - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi > 0 {
                return false;
            }
        }
        if parts[n - 1].len() == 0 {
            lo -= 1;
            if lo > 0 {
                return false;
            }
        }
        if 8 - (hi + lo) < 1 {
            return false;
        }
    } else if n != 8 or parts[0].len() == 0 or parts[n - 1].len() == 0 {
        return false;
    }
    for i in 0..hi {
        if not is_hextet(parts[i]) {
            return false;
        }
    }
    for i in n - lo..n {
        if not is_hextet(parts[i]) {
            return false;
        }
    }
    true
}

// urllib.parse's _check_bracketed_host.
fn check_bracketed_host(host: Str) -> Result[(), String] {
    let b = to_bytes(host);
    if b.len() > 0 and (b[0] == b'v' or b[0] == b'V') {
        // \A[vV][a-fA-F0-9]+\..+\Z
        let mut i: i64 = 1;
        while i < b.len() and is_hex(b[i]) {
            i += 1;
        }
        if i == 1 or i >= b.len() or b[i] != b'.' or i + 1 >= b.len() {
            return Err("IPvFuture address is invalid".to_string());
        }
        return Ok(());
    }
    if is_ipv4(host) {
        return Err("An IPv4 address cannot be in brackets".to_string());
    }
    if not is_ipv6(host) {
        return Err(f"{py_repr(host)} does not appear to be an IPv4 or IPv6 address");
    }
    Ok(())
}

// ------------------------------------------------------------ split and parse

fn uses_relative(s: Str) -> bool {
    contains_str(["", "ftp", "http", "gopher", "nntp", "imap", "wais", "file", "https", "shttp", "mms", "prospero", "rtsp", "rtsps", "rtspu", "sftp", "svn", "svn+ssh", "ws", "wss"], s)
}

fn uses_netloc(s: Str) -> bool {
    contains_str(["", "ftp", "http", "gopher", "nntp", "telnet", "imap", "wais", "file", "mms", "https", "shttp", "snews", "prospero", "rtsp", "rtsps", "rtspu", "rsync", "svn", "svn+ssh", "sftp", "nfs", "git", "git+ssh", "ws", "wss", "itms-services"], s)
}

fn uses_params(s: Str) -> bool {
    contains_str(["", "ftp", "hdl", "prospero", "http", "imap", "https", "shttp", "rtsp", "rtsps", "rtspu", "sip", "sips", "mms", "sftp", "tel"], s)
}

fn is_scheme_char(c: u8) -> bool {
    is_alnum(c) or c == b'+' or c == b'-' or c == b'.'
}

#[derive(Clone)]
struct Split {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
    fragment: String,
}

#[derive(Clone)]
struct Parsed {
    scheme: String,
    netloc: String,
    path: String,
    params: String,
    query: String,
    fragment: String,
}

impl Split {
    fn repr(ref self) -> String {
        f"SplitResult(scheme={py_repr(self.scheme)}, netloc={py_repr(self.netloc)}, path={py_repr(self.path)}, query={py_repr(self.query)}, fragment={py_repr(self.fragment)})"
    }

    // _userinfo
    fn username(ref self) -> Option[String] {
        let (userinfo, have_info, _) = rpartition(self.netloc, b'@');
        if not have_info {
            return None;
        }
        let (user, _, _) = partition(userinfo, b':');
        Some(user)
    }

    fn password(ref self) -> Option[String] {
        let (userinfo, have_info, _) = rpartition(self.netloc, b'@');
        if not have_info {
            return None;
        }
        let (_, have_password, password) = partition(userinfo, b':');
        if have_password { Some(password) } else { None }
    }

    // _hostinfo: the host and the port as written.
    fn hostinfo(ref self) -> (String, Option[String]) {
        let (_, _, hostinfo) = rpartition(self.netloc, b'@');
        let (_, have_open_br, bracketed) = partition(hostinfo, b'[');
        let mut host = String.new();
        let mut port = String.new();
        if have_open_br {
            let (h, _, rest) = partition(bracketed, b']');
            let (_, _, p) = partition(rest, b':');
            host = h;
            port = p;
        } else {
            let (h, _, p) = partition(hostinfo, b':');
            host = h;
            port = p;
        }
        if port.len() == 0 { (host, None) } else { (host, Some(port)) }
    }

    fn hostname(ref self) -> Option[String] {
        let (host, _) = self.hostinfo();
        if host.len() == 0 {
            return None;
        }
        // a scope's zone keeps its case
        let (h, percent, zone) = partition(host, b'%');
        if percent { Some(f"{lower(h)}%{zone}") } else { Some(lower(h)) }
    }

    fn port(ref self) -> Result[Option[i64], String] {
        let (_, port) = self.hostinfo();
        let p = match port {
            Some(p) => p,
            None => return Ok(None),
        };
        let b = to_bytes(p);
        let mut n: i64 = 0;
        for i in 0..b.len() {
            if not is_digit(b[i]) {
                return Err(f"Port could not be cast to integer value as {py_repr(p)}");
            }
            if n <= 1000000 {
                n = n * 10 + (b[i] - b'0') as i64;
            }
        }
        if n > 65535 {
            return Err("Port out of range 0-65535".to_string());
        }
        Ok(Some(n))
    }
}

impl Parsed {
    fn repr(ref self) -> String {
        f"ParseResult(scheme={py_repr(self.scheme)}, netloc={py_repr(self.netloc)}, path={py_repr(self.path)}, params={py_repr(self.params)}, query={py_repr(self.query)}, fragment={py_repr(self.fragment)})"
    }
}

// _splitnetloc: the netloc runs to the first of / ? #.
fn split_netloc(url: Str, start: i64) -> (String, String) {
    let b = to_bytes(url);
    let mut delim = b.len();
    for i in start..b.len() {
        if b[i] == b'/' or b[i] == b'?' or b[i] == b'#' {
            delim = i;
            break;
        }
    }
    (byte_str(b, start, delim), byte_str(b, delim, b.len()))
}

fn check_bracketed_netloc(netloc: Str) -> Result[(), String] {
    let (_, _, host_and_port) = rpartition(netloc, b'@');
    let (before, have_open_br, bracketed) = partition(host_and_port, b'[');
    if have_open_br {
        if before.len() > 0 {
            return Err("Invalid IPv6 URL".to_string());
        }
        let (host, _, port) = partition(bracketed, b']');
        if port.len() > 0 and first_byte(port) != b':' {
            return Err("Invalid IPv6 URL".to_string());
        }
        return check_bracketed_host(host);
    }
    let (host, _, _) = partition(host_and_port, b':');
    check_bracketed_host(host)
}

fn urlsplit(url_in: Str, scheme_in: Str) -> Result[Split, String] {
    // lstrip the C0 controls and space, then drop every tab and line end
    let ub = to_bytes(url_in);
    let mut st: i64 = 0;
    while st < ub.len() and ub[st] <= 32 {
        st += 1;
    }
    let mut kept: Vec[u8] = Vec.new();
    for i in st..ub.len() {
        let c = ub[i];
        if c != b'\t' and c != b'\r' and c != b'\n' {
            kept.push(c);
        }
    }
    let mut url = from_bytes(kept);
    let mut scheme = strip_scheme(scheme_in);
    let mut netloc = String.new();
    let mut query = String.new();
    let mut fragment = String.new();
    let i = find_byte(url, b':');
    if i > 0 and is_alpha(first_byte(url)) {
        let b = to_bytes(url);
        let mut all = true;
        for k in 0..i {
            if not is_scheme_char(b[k]) {
                all = false;
                break;
            }
        }
        if all {
            scheme = lower(byte_str(b, 0, i));
            url = byte_str(b, i + 1, b.len());
        }
    }
    if starts_with(url, "//") {
        let (n, rest) = split_netloc(url, 2);
        netloc = n;
        url = rest;
        let open = has_byte(netloc, b'[');
        let close = has_byte(netloc, b']');
        if open != close {
            return Err("Invalid IPv6 URL".to_string());
        }
        if open and close {
            check_bracketed_netloc(netloc)?;
        }
    }
    if has_byte(url, b'#') {
        let (u, _, f) = partition(url, b'#');
        url = u;
        fragment = f;
    }
    if has_byte(url, b'?') {
        let (u, _, q) = partition(url, b'?');
        url = u;
        query = q;
    }
    Ok(Split { scheme: scheme, netloc: netloc, path: url, query: query, fragment: fragment })
}

// The scheme argument: C0 controls and space stripped at both ends, tabs
// and line ends dropped.
fn strip_scheme(s: Str) -> String {
    let b = to_bytes(s);
    let mut st: i64 = 0;
    let mut en = b.len();
    while st < en and b[st] <= 32 {
        st += 1;
    }
    while en > st and b[en - 1] <= 32 {
        en -= 1;
    }
    let mut out: Vec[u8] = Vec.new();
    for i in st..en {
        if b[i] != b'\t' and b[i] != b'\r' and b[i] != b'\n' {
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

// _splitparams: the params follow the `;` in the last segment.
fn split_params(url: Str) -> (String, String) {
    let i = if has_byte(url, b'/') {
        let b = to_bytes(url);
        let mut at: i64 = -1;
        for k in rfind_byte(url, b'/')..b.len() {
            if b[k] == b';' {
                at = k;
                break;
            }
        }
        if at < 0 {
            return (url.to_string(), String.new());
        }
        at
    } else {
        find_byte(url, b';')
    };
    (slice(url, 0, i), slice_from(url, i + 1))
}

fn urlparse(url: Str, scheme: Str) -> Result[Parsed, String] {
    let s = urlsplit(url, scheme)?;
    let mut path = s.path.clone();
    let mut params = String.new();
    if uses_params(s.scheme) and has_byte(path, b';') {
        let (p, a) = split_params(path);
        path = p;
        params = a;
    }
    Ok(Parsed { scheme: s.scheme, netloc: s.netloc, path: path, params: params, query: s.query, fragment: s.fragment })
}

fn urlunsplit(scheme: Str, netloc: Str, path: Str, query: Str, fragment: Str) -> String {
    let mut url = path.to_string();
    if netloc.len() > 0 {
        if url.len() > 0 and first_byte(url) != b'/' {
            url = f"/{url}";
        }
        url = f"//{netloc}{url}";
    } else if starts_with(url, "//") {
        url = f"//{url}";
    } else if scheme.len() > 0 and uses_netloc(scheme) and (url.len() == 0 or first_byte(url) == b'/') {
        url = f"//{url}";
    }
    if scheme.len() > 0 {
        url = f"{scheme}:{url}";
    }
    if query.len() > 0 {
        url = f"{url}?{query}";
    }
    if fragment.len() > 0 {
        url = f"{url}#{fragment}";
    }
    url
}

fn unsplit(s: ref Split) -> String {
    urlunsplit(s.scheme, s.netloc, s.path, s.query, s.fragment)
}

fn urlunparse(p: ref Parsed) -> String {
    let path = if p.params.len() > 0 { f"{p.path};{p.params}" } else { p.path.clone() };
    urlunsplit(p.scheme, p.netloc, path, p.query, p.fragment)
}

fn urljoin(base: Str, url: Str) -> Result[String, String] {
    if base.len() == 0 {
        return Ok(url.to_string());
    }
    if url.len() == 0 {
        return Ok(base.to_string());
    }
    let b = urlparse(base, "")?;
    let mut u = urlparse(url, b.scheme)?;
    if u.scheme != b.scheme or not uses_relative(u.scheme) {
        return Ok(url.to_string());
    }
    if uses_netloc(u.scheme) {
        if u.netloc.len() > 0 {
            return Ok(urlunparse(u));
        }
        u.netloc = b.netloc.clone();
    }
    if u.path.len() == 0 and u.params.len() == 0 {
        u.path = b.path.clone();
        u.params = b.params.clone();
        if u.query.len() == 0 {
            u.query = b.query.clone();
        }
        return Ok(urlunparse(u));
    }
    let mut base_parts = split_on(b.path, b'/');
    if base_parts[base_parts.len() - 1].len() > 0 {
        // the last segment is not a directory
        base_parts.pop();
    }
    let mut segments: Vec[String] = Vec.new();
    if first_byte(u.path) == b'/' {
        segments = split_on(u.path, b'/');
    } else {
        let rel = split_on(u.path, b'/');
        let mut all = base_parts.clone();
        for i in 0..rel.len() {
            all.push(rel[i].clone());
        }
        // drop the empty segments between the first and the last
        for i in 0..all.len() {
            if i == 0 or i == all.len() - 1 or all[i].len() > 0 {
                segments.push(all[i].clone());
            }
        }
    }
    let mut resolved: Vec[String] = Vec.new();
    for i in 0..segments.len() {
        if segments[i] == ".." {
            if resolved.len() > 0 {
                resolved.pop();
            }
        } else if segments[i] != "." {
            resolved.push(segments[i].clone());
        }
    }
    let last = segments[segments.len() - 1].clone();
    if last == "." or last == ".." {
        resolved.push(String.new());
    }
    let joined = join(resolved, "/");
    u.path = if joined.len() > 0 { joined } else { "/".to_string() };
    Ok(urlunparse(u))
}

fn urldefrag(url: Str) -> Result[(String, String), String] {
    if not has_byte(url, b'#') {
        return Ok((url.to_string(), String.new()));
    }
    let mut p = urlparse(url, "")?;
    let frag = p.fragment.clone();
    p.fragment = String.new();
    Ok((urlunparse(p), frag))
}

// ------------------------------------------------------------ quoting

fn always_safe(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c == b'.' or c == b'-' or c == b'~'
}

// quote: every byte of the UTF-8 that is neither always safe nor in
// `safe` becomes %XX.
fn quote(s: Str, safe: Str) -> String {
    let b = to_bytes(s);
    let sb = to_bytes(safe);
    let hex = to_bytes("0123456789ABCDEF");
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        let mut ok = c < 128 and always_safe(c);
        for k in 0..sb.len() {
            if sb[k] < 128 and sb[k] == c {
                ok = true;
            }
        }
        if ok {
            out.push(c);
        } else {
            out.push(b'%');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        }
    }
    from_bytes(out)
}

fn quote_plus(s: Str, safe: Str) -> String {
    if not has_byte(s, b' ') {
        return quote(s, safe);
    }
    replace_byte(quote(s, f"{safe} "), b' ', "+")
}

// _unquote_impl on ASCII: %XX with two hex digits is a byte, anything
// else stays as written.
fn unquote_bytes(b: ref Vec[u8], from: i64, to: i64, out: mut ref Vec[u8]) {
    let mut i = from;
    while i < to {
        if b[i] == b'%' and i + 2 < to and is_hex(b[i + 1]) and is_hex(b[i + 2]) {
            out.push(hex_val(b[i + 1]) * 16 + hex_val(b[i + 2]));
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
}

// unquote: the ASCII runs are unquoted and decoded as UTF-8 one run at a
// time; the rest is kept as it is.
fn unquote(s: Str) -> String {
    if not has_byte(s, b'%') {
        return s.to_string();
    }
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let st = i;
        if b[i] < 128 {
            while i < b.len() and b[i] < 128 {
                i += 1;
            }
            let mut run: Vec[u8] = Vec.new();
            unquote_bytes(b, st, i, mut run);
            push_str_bytes(mut out, utf8_replace(run));
        } else {
            while i < b.len() and b[i] >= 128 {
                out.push(b[i]);
                i += 1;
            }
        }
    }
    from_bytes(out)
}

fn unquote_plus(s: Str) -> String {
    unquote(replace_byte(s, b'+', " "))
}

// ------------------------------------------------------------ queries

#[derive(Clone)]
struct Pair {
    name: String,
    value: String,
}

fn parse_qsl(qs: Str, keep_blank: bool, strict: bool, sep: Str) -> Result[Vec[Pair], String] {
    let mut r: Vec[Pair] = Vec.new();
    if qs.len() == 0 {
        return Ok(r);
    }
    let fields = split_on(qs, first_byte(sep));
    for i in 0..fields.len() {
        let nv = fields[i].clone();
        if nv.len() == 0 and not strict {
            continue;
        }
        let (name, has_eq, value) = partition(nv, b'=');
        if not has_eq and strict {
            return Err(f"bad query field: {py_repr(nv)}");
        }
        if value.len() > 0 or keep_blank {
            r.push(Pair { name: unquote_plus(name), value: unquote_plus(value) });
        }
    }
    Ok(r)
}

fn pairs_repr(v: ref Vec[Pair]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for i in 0..v.len() {
        parts.push(f"({py_repr(v[i].name)}, {py_repr(v[i].value)})");
    }
    f"[{join(parts, ", ")}]"
}

// parse_qs: the values of each name, the names in the order first seen.
struct Multi {
    names: Vec[String],
    values: Vec[Vec[String]],
}

impl Multi {
    fn repr(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for i in 0..self.names.len() {
            let mut vs: Vec[String] = Vec.new();
            let list = self.values[i].clone();
            for k in 0..list.len() {
                vs.push(py_repr(list[k]));
            }
            parts.push(f"{py_repr(self.names[i])}: [{join(vs, ", ")}]");
        }
        f"{{{join(parts, ", ")}}}"
    }
}

fn parse_qs(pairs: ref Vec[Pair]) -> Multi {
    let mut m = Multi { names: Vec.new(), values: Vec.new() };
    for i in 0..pairs.len() {
        let mut at: i64 = -1;
        for k in 0..m.names.len() {
            if m.names[k] == pairs[i].name {
                at = k;
            }
        }
        if at < 0 {
            m.names.push(pairs[i].name.clone());
            m.values.push(Vec.new());
            at = m.names.len() - 1;
        }
        m.values[at].push(pairs[i].value.clone());
    }
    m
}

// urlencode over pairs, with quote_plus or quote.
fn urlencode(pairs: ref Vec[Pair], safe: Str, plus: bool) -> String {
    let mut l: Vec[String] = Vec.new();
    for i in 0..pairs.len() {
        let k = if plus { quote_plus(pairs[i].name, safe) } else { quote(pairs[i].name, safe) };
        let v = if plus { quote_plus(pairs[i].value, safe) } else { quote(pairs[i].value, safe) };
        l.push(f"{k}={v}");
    }
    join(l, "&")
}

// urlencode(d, doseq=True): one name=value for each value in the lists.
fn urlencode_multi(m: ref Multi) -> String {
    let mut pairs: Vec[Pair] = Vec.new();
    for i in 0..m.names.len() {
        let list = m.values[i].clone();
        for k in 0..list.len() {
            pairs.push(Pair { name: m.names[i].clone(), value: list[k].clone() });
        }
    }
    urlencode(pairs, "", true)
}

// ------------------------------------------------------------ the files

// ------------------------------------------------------------ hashes and HMAC


// The message padded to whole 64- or 128-byte blocks, with its bit
// length in `lenbytes` bytes, big- or little-endian.
fn md_pad(msg: ref Vec[u8], block: i64, lenbytes: i64, big: bool) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = msg.len() * 8;
    m.push(0x80);
    while m.len() % block != block - lenbytes {
        m.push(0);
    }
    for k in 0..lenbytes {
        let shift = if big { 8 * (lenbytes - 1 - k) } else { 8 * k };
        let b = if shift >= 64 { 0 } else { (bits >> shift) & 0xFF };
        m.push(b as u8);
    }
    m
}

fn le32(b: ref Vec[u8], i: i64) -> u32 {
    (b[i] as u32) | ((b[i + 1] as u32) << 8) | ((b[i + 2] as u32) << 16) | ((b[i + 3] as u32) << 24)
}

fn be32(b: ref Vec[u8], i: i64) -> u32 {
    ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32)
}

fn be64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    for k in 0..8 {
        v = (v << 8) | (b[i + k] as u64);
    }
    v
}

fn le64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    let mut k: i64 = 7;
    while k >= 0 {
        v = (v << 8) | (b[i + k] as u64);
        k -= 1;
    }
    v
}

fn push_le32(out: mut ref Vec[u8], x: u32) {
    for k in 0..4 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
    }
}

fn push_be32(out: mut ref Vec[u8], x: u32) {
    let mut k: i64 = 3;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
        k -= 1;
    }
}

fn push_be64(out: mut ref Vec[u8], x: u64) {
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u64)) & 0xFFu64) as u8);
        k -= 1;
    }
}



fn sha1(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, true);
    let mut h: Vec[u32] = Vec.new();
    for x in [0x67452301u32, 0xEFCDAB89u32, 0x98BADCFEu32, 0x10325476u32, 0xC3D2E1F0u32] {
        h.push(x);
    }
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..80 {
        w.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..80 {
            w[t] = (w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]).rotate_left(1);
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        for t in 0..80 {
            let mut f: u32 = 0;
            let mut k: u32 = 0;
            if t < 20 {
                f = (b & c) | ((b ^ 0xFFFFFFFFu32) & d);
                k = 0x5A827999u32;
            } else if t < 40 {
                f = b ^ c ^ d;
                k = 0x6ED9EBA1u32;
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8F1BBCDCu32;
            } else {
                f = b ^ c ^ d;
                k = 0xCA62C1D6u32;
            }
            let tmp = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[t]);
            e = d;
            d = c;
            c = b.rotate_left(30);
            b = a;
            a = tmp;
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_be32(mut out, x);
    }
    out
}

const SHA256_K: Array[u32, 64] = [
    0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32, 0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
    0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32, 0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
    0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32, 0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
    0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32, 0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
    0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32, 0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
    0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32, 0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
    0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32, 0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
    0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32, 0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32,
];

// SHA-256, or SHA-224 with its own initial values and a shorter result.
fn sha256_family(msg: ref Vec[u8], is224: bool) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, true);
    let mut h: Vec[u32] = Vec.new();
    if is224 {
        for x in [0xc1059ed8u32, 0x367cd507u32, 0x3070dd17u32, 0xf70e5939u32, 0xffc00b31u32, 0x68581511u32, 0x64f98fa7u32, 0xbefa4fa4u32] {
            h.push(x);
        }
    } else {
        for x in [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32, 0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32] {
            h.push(x);
        }
    }
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..64 {
        w.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..64 {
            let s0 = w[t - 15].rotate_right(7) ^ w[t - 15].rotate_right(18) ^ (w[t - 15] >> 3u32);
            let s1 = w[t - 2].rotate_right(17) ^ w[t - 2].rotate_right(19) ^ (w[t - 2] >> 10u32);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
        }
        let mut v: Vec[u32] = h.clone();
        for t in 0..64 {
            let e = v[4];
            let a = v[0];
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & v[5]) ^ ((e ^ 0xFFFFFFFFu32) & v[6]);
            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA256_K[t]).wrapping_add(w[t]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & v[1]) ^ (a & v[2]) ^ (v[1] & v[2]);
            let t2 = s0.wrapping_add(maj);
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3].wrapping_add(t1);
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1.wrapping_add(t2);
        }
        for i in 0..8 {
            h[i] = h[i].wrapping_add(v[i]);
        }
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    let n = if is224 { 7 } else { 8 };
    for i in 0..n {
        push_be32(mut out, h[i]);
    }
    out
}

const SHA512_K: Array[u64, 80] = [
    0x428a2f98d728ae22u64, 0x7137449123ef65cdu64, 0xb5c0fbcfec4d3b2fu64, 0xe9b5dba58189dbbcu64,
    0x3956c25bf348b538u64, 0x59f111f1b605d019u64, 0x923f82a4af194f9bu64, 0xab1c5ed5da6d8118u64,
    0xd807aa98a3030242u64, 0x12835b0145706fbeu64, 0x243185be4ee4b28cu64, 0x550c7dc3d5ffb4e2u64,
    0x72be5d74f27b896fu64, 0x80deb1fe3b1696b1u64, 0x9bdc06a725c71235u64, 0xc19bf174cf692694u64,
    0xe49b69c19ef14ad2u64, 0xefbe4786384f25e3u64, 0x0fc19dc68b8cd5b5u64, 0x240ca1cc77ac9c65u64,
    0x2de92c6f592b0275u64, 0x4a7484aa6ea6e483u64, 0x5cb0a9dcbd41fbd4u64, 0x76f988da831153b5u64,
    0x983e5152ee66dfabu64, 0xa831c66d2db43210u64, 0xb00327c898fb213fu64, 0xbf597fc7beef0ee4u64,
    0xc6e00bf33da88fc2u64, 0xd5a79147930aa725u64, 0x06ca6351e003826fu64, 0x142929670a0e6e70u64,
    0x27b70a8546d22ffcu64, 0x2e1b21385c26c926u64, 0x4d2c6dfc5ac42aedu64, 0x53380d139d95b3dfu64,
    0x650a73548baf63deu64, 0x766a0abb3c77b2a8u64, 0x81c2c92e47edaee6u64, 0x92722c851482353bu64,
    0xa2bfe8a14cf10364u64, 0xa81a664bbc423001u64, 0xc24b8b70d0f89791u64, 0xc76c51a30654be30u64,
    0xd192e819d6ef5218u64, 0xd69906245565a910u64, 0xf40e35855771202au64, 0x106aa07032bbd1b8u64,
    0x19a4c116b8d2d0c8u64, 0x1e376c085141ab53u64, 0x2748774cdf8eeb99u64, 0x34b0bcb5e19b48a8u64,
    0x391c0cb3c5c95a63u64, 0x4ed8aa4ae3418acbu64, 0x5b9cca4f7763e373u64, 0x682e6ff3d6b2b8a3u64,
    0x748f82ee5defb2fcu64, 0x78a5636f43172f60u64, 0x84c87814a1f0ab72u64, 0x8cc702081a6439ecu64,
    0x90befffa23631e28u64, 0xa4506cebde82bde9u64, 0xbef9a3f7b2c67915u64, 0xc67178f2e372532bu64,
    0xca273eceea26619cu64, 0xd186b8c721c0c207u64, 0xeada7dd6cde0eb1eu64, 0xf57d4f7fee6ed178u64,
    0x06f067aa72176fbau64, 0x0a637dc5a2c898a6u64, 0x113f9804bef90daeu64, 0x1b710b35131c471bu64,
    0x28db77f523047d84u64, 0x32caab7b40c72493u64, 0x3c9ebe0a15c9bebcu64, 0x431d67c49c100d4cu64,
    0x4cc5d4becb3e42b6u64, 0x597f299cfc657e2au64, 0x5fcb6fab3ad6faecu64, 0x6c44198c4a475817u64,
];

const SHA512_IV: Array[u64, 8] = [
    0x6a09e667f3bcc908u64, 0xbb67ae8584caa73bu64, 0x3c6ef372fe94f82bu64, 0xa54ff53a5f1d36f1u64,
    0x510e527fade682d1u64, 0x9b05688c2b3e6c1fu64, 0x1f83d9abfb41bd6bu64, 0x5be0cd19137e2179u64,
];

const SHA384_IV: Array[u64, 8] = [
    0xcbbb9d5dc1059ed8u64, 0x629a292a367cd507u64, 0x9159015a3070dd17u64, 0x152fecd8f70e5939u64,
    0x67332667ffc00b31u64, 0x8eb44a8768581511u64, 0xdb0c2e0d64f98fa7u64, 0x47b5481dbefa4fa4u64,
];

// SHA-512, or SHA-384 with its own initial values and a shorter result.
fn sha512_family(msg: ref Vec[u8], is384: bool) -> Vec[u8] {
    let m = md_pad(msg, 128, 16, true);
    let mut h: Vec[u64] = Vec.new();
    for i in 0..8 {
        h.push(if is384 { SHA384_IV[i] } else { SHA512_IV[i] });
    }
    let mut w: Vec[u64] = Vec.new();
    for _ in 0..80 {
        w.push(0u64);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be64(m, blk + 8 * t);
        }
        for t in 16..80 {
            let s0 = w[t - 15].rotate_right(1) ^ w[t - 15].rotate_right(8) ^ (w[t - 15] >> 7u64);
            let s1 = w[t - 2].rotate_right(19) ^ w[t - 2].rotate_right(61) ^ (w[t - 2] >> 6u64);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
        }
        let mut v: Vec[u64] = h.clone();
        for t in 0..80 {
            let e = v[4];
            let a = v[0];
            let s1 = e.rotate_right(14) ^ e.rotate_right(18) ^ e.rotate_right(41);
            let ch = (e & v[5]) ^ ((e ^ 0xFFFFFFFFFFFFFFFFu64) & v[6]);
            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA512_K[t]).wrapping_add(w[t]);
            let s0 = a.rotate_right(28) ^ a.rotate_right(34) ^ a.rotate_right(39);
            let maj = (a & v[1]) ^ (a & v[2]) ^ (v[1] & v[2]);
            let t2 = s0.wrapping_add(maj);
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3].wrapping_add(t1);
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1.wrapping_add(t2);
        }
        for i in 0..8 {
            h[i] = h[i].wrapping_add(v[i]);
        }
        blk += 128;
    }
    let mut out: Vec[u8] = Vec.new();
    let n = if is384 { 6 } else { 8 };
    for i in 0..n {
        push_be64(mut out, h[i]);
    }
    out
}

// ------------------------------------------------------------ HMAC (RFC 2104)

// hashlib's digest for a name pyotp can be given.
fn digest_of(name: Str, msg: ref Vec[u8]) -> Vec[u8] {
    if name == "sha224" {
        return sha256_family(msg, true);
    }
    if name == "sha256" {
        return sha256_family(msg, false);
    }
    if name == "sha384" {
        return sha512_family(msg, true);
    }
    if name == "sha512" {
        return sha512_family(msg, false);
    }
    sha1(msg)
}

fn block_of(name: Str) -> i64 {
    if name == "sha384" or name == "sha512" { 128 } else { 64 }
}

// hmac.new(key, msg, digest).digest()
fn hmac(name: Str, key: ref Vec[u8], msg: ref Vec[u8]) -> Vec[u8] {
    let block = block_of(name);
    let mut k = if key.len() > block { digest_of(name, key) } else { key.clone() };
    while k.len() < block {
        k.push(0);
    }
    let mut inner: Vec[u8] = Vec.new();
    let mut outer: Vec[u8] = Vec.new();
    for i in 0..block {
        inner.push(k[i] ^ 0x36);
        outer.push(k[i] ^ 0x5c);
    }
    for b in msg.iter() {
        inner.push(*b);
    }
    let ih = digest_of(name, inner);
    for b in ih.iter() {
        outer.push(*b);
    }
    digest_of(name, outer)
}
// ------------------------------------------------------------ errors

// A Python exception: its type and str().
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: Str) -> Exc {
    exc("ValueError", msg.to_string())
}

fn err_line(e: ref Exc) -> String {
    f"error: {e.kind}: {e.msg}"
}

// ------------------------------------------------------------ base32

const B32_ALPHABET: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";

fn b32encode(b: ref Vec[u8]) -> String {
    let tab = to_bytes(B32_ALPHABET);
    let leftover = b.len() % 5;
    let mut s = b.clone();
    if leftover > 0 {
        for _ in 0..5 - leftover {
            s.push(0);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < s.len() {
        let mut c: i64 = 0;
        for k in 0..5 {
            c = (c << 8) | s[i + k] as i64;
        }
        let mut sh: i64 = 35;
        while sh >= 0 {
            out.push(tab[(c >> sh) & 31]);
            sh -= 5;
        }
        i += 5;
    }
    let pad = if leftover == 1 { 6 } else if leftover == 2 { 4 } else if leftover == 3 { 3 } else if leftover == 4 { 1 } else { 0 };
    for k in 0..pad {
        let at = out.len() - 1 - k;
        out[at] = b'=';
    }
    from_bytes(out)
}

// base64.b32decode(s, casefold=True) of a str.
fn b32decode(text: ref String) -> Result[Vec[u8], Exc] {
    for c in text.chars() {
        if c as u32 >= 128 {
            return Err(value_error("string argument should contain only ASCII characters"));
        }
    }
    if text.len() % 8 != 0 {
        return Err(exc("Error", "Incorrect padding".to_string()));
    }
    let mut s = to_bytes(upper(text));
    let l = s.len();
    while s.len() > 0 and s[s.len() - 1] == b'=' {
        s.pop();
    }
    let padchars = l - s.len();
    let tab = to_bytes(B32_ALPHABET);
    let mut decoded: Vec[u8] = Vec.new();
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < s.len() {
        acc = 0;
        let end = if i + 8 < s.len() { i + 8 } else { s.len() };
        for k in i..end {
            let mut v: i64 = -1;
            for t in 0..tab.len() {
                if tab[t] == s[k] {
                    v = t;
                }
            }
            if v < 0 {
                return Err(exc("Error", "Non-base32 digit found".to_string()));
            }
            acc = (acc << 5) + v;
        }
        let mut sh: i64 = 32;
        while sh >= 0 {
            decoded.push(((acc >> sh) & 255) as u8);
            sh -= 8;
        }
        i += 8;
    }
    if l % 8 != 0 or not (padchars == 0 or padchars == 1 or padchars == 3 or padchars == 4 or padchars == 6) {
        return Err(exc("Error", "Incorrect padding".to_string()));
    }
    if padchars > 0 and decoded.len() > 0 {
        acc = acc << (5 * padchars);
        let leftover = (43 - 5 * padchars) / 8;
        for _ in 0..5 {
            decoded.pop();
        }
        let mut sh: i64 = 32;
        for _ in 0..leftover {
            decoded.push(((acc >> sh) & 255) as u8);
            sh -= 8;
        }
    }
    Ok(decoded)
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b.iter() {
        out.push_str(hex_digits(*x as i64, 2));
    }
    out
}

// ------------------------------------------------------------ NFKC equality

// unicodedata.normalize("NFKC", s): two strings have the same NFKC form
// exactly when they have the same NFKD form, so this is NFKD.
fn nfkd(t: ref Map[char, String], s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        match t.get(c) {
            Some(d) => out.push_str(d),
            None => out.push(c),
        }
    }
    out
}

// utils.strings_equal
fn strings_equal(t: ref Map[char, String], a: ref String, b: ref String) -> bool {
    nfkd(t, a) == nfkd(t, b)
}

// ------------------------------------------------------------ times

// datetime.fromtimestamp(t), datetime.fromisoformat(s) without an offset
// (both read in UTC, as TZ=UTC has it), or one with an offset.
enum When {
    Stamp(i64),
    Naive(i64),
    Aware(i64, i64),
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = floor_div(y, 400);
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// The year of a time in seconds from the epoch.
fn year_of(t: i64) -> i64 {
    let z = floor_div(t, 86400) + 719468;
    let era = floor_div(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400;
    if m <= 2 { y + 1 } else { y }
}

fn digits_at(cs: ref Vec[char], a: i64, n: i64) -> Option[i64] {
    if a + n > cs.len() {
        return None;
    }
    let mut v: i64 = 0;
    for i in a..a + n {
        if not is_ascii_digit(cs[i]) {
            return None;
        }
        v = v * 10 + (cs[i] as i64 - 48);
    }
    Some(v)
}

// datetime.fromisoformat for YYYY-MM-DD[T ]HH:MM:SS[.ffffff][Z|+HH:MM].
fn parse_iso(s: ref String) -> Option[When] {
    let cs: Vec[char] = s.chars().collect();
    let y = digits_at(cs, 0, 4)?;
    let mo = digits_at(cs, 5, 2)?;
    let d = digits_at(cs, 8, 2)?;
    let h = digits_at(cs, 11, 2)?;
    let mi = digits_at(cs, 14, 2)?;
    let se = digits_at(cs, 17, 2)?;
    let mut i = 19;
    if i < cs.len() and cs[i] == '.' {
        i += 1;
        while i < cs.len() and is_ascii_digit(cs[i]) {
            i += 1;
        }
    }
    let local = days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + se;
    if i >= cs.len() {
        return Some(When.Naive(local));
    }
    if cs[i] == 'Z' {
        return Some(When.Aware(local, 0));
    }
    let sign = if cs[i] == '-' { -1 } else { 1 };
    let oh = digits_at(cs, i + 1, 2)?;
    let om = digits_at(cs, i + 4, 2)?;
    Some(When.Aware(local, sign * (oh * 3600 + om * 60)))
}

// What a job gives as a time: an int timestamp or an ISO date and time.
fn when_of(text: ref String) -> When {
    match py_int(text.chars().collect()) {
        Some(d) => When.Stamp(i64.parse(d).unwrap_or(0)),
        None => parse_iso(text).unwrap_or(When.Naive(0)),
    }
}

// The seconds a time stands for, as int(dt.timestamp()) gives them.
fn stamp_of(w: ref When) -> i64 {
    match w {
        When.Stamp(t) => *t,
        When.Naive(t) => *t,
        When.Aware(local, off) => *local - *off,
    }
}

fn year_error(y: i64) -> Exc {
    value_error(f"year {y} is out of range")
}

// TOTP.timecode, after at()'s fromtimestamp for an int: int(t / interval)
// with Python's true division.
fn timecode(w: ref When, interval: i64) -> Result[i64, Exc] {
    let t = match w {
        When.Stamp(t) => {
            // fromtimestamp, and its look a day back for a fold
            let y = year_of(*t);
            if y < 1 or y > 9999 {
                return Err(year_error(y));
            }
            let back = year_of(*t - 86400);
            if back < 1 {
                return Err(year_error(back));
            }
            *t
        }
        When.Naive(t) => *t,
        When.Aware(local, off) => {
            let utc = *local - *off;
            let y = year_of(utc);
            if y < 1 or y > 9999 {
                return Err(exc("OverflowError", "date value out of range".to_string()));
            }
            if interval == 0 {
                return Err(exc("ZeroDivisionError", "division by zero".to_string()));
            }
            utc
        }
    };
    if interval == 0 {
        return Err(exc("ZeroDivisionError", "float division by zero".to_string()));
    }
    let q = (t as f64) / (interval as f64);
    Ok(q as i64)
}

// ------------------------------------------------------------ pyotp

const HOTP: i64 = 0;
const TOTP: i64 = 1;
const STEAM: i64 = 2;
const STEAM_CHARS: Str = "23456789BCDFGHJKMNPQRTVWXY";

// An OTP object: HOTP, TOTP, or contrib.Steam (a TOTP).
#[derive(Clone)]
struct Otp {
    kind: i64,
    secret: String,
    digits: i64,
    digest: String,
    name: String,
    issuer: Option[String],
    interval: i64,
    initial_count: i128,
}

fn class_name(kind: i64) -> String {
    if kind == HOTP {
        "HOTP".to_string()
    } else if kind == TOTP {
        "TOTP".to_string()
    } else {
        "Steam".to_string()
    }
}

// A keyword argument: its name, and an int, a str or a digest name.
#[derive(Clone)]
struct Kw {
    key: String,
    int: i128,
    text: Option[String],
}

fn kw_int(key: Str, v: i128) -> Kw {
    Kw { key: key.to_string(), int: v, text: None }
}

fn kw_str(key: Str, v: ref String) -> Kw {
    Kw { key: key.to_string(), int: 0, text: Some(v.clone()) }
}

// d[key] = value: a key already there keeps its place.
fn kw_set(kws: mut ref Vec[Kw], kw: own Kw) {
    for i in 0..kws.len() {
        if kws[i].key == kw.key {
            kws[i] = kw;
            return;
        }
    }
    kws.push(kw);
}

fn kw_text(kw: ref Kw) -> String {
    match kw.text {
        Some(s) => s.clone(),
        None => String.new(),
    }
}

// Class(s, **kwargs), with the TypeError Python gives a keyword the class
// does not take.
fn new_otp(kind: i64, secret: ref String, kws: ref Vec[Kw]) -> Result[Otp, Exc] {
    let allowed: Vec[Str] = if kind == HOTP {
        vec!["digits", "digest", "name", "issuer", "initial_count"]
    } else if kind == TOTP {
        vec!["digits", "digest", "name", "issuer", "interval"]
    } else {
        vec!["name", "issuer", "interval", "digits"]
    };
    for kw in kws.iter() {
        let mut ok = false;
        for a in allowed.iter() {
            if kw.key == *a {
                ok = true;
            }
        }
        if not ok {
            return Err(exc("TypeError", f"{class_name(kind)}.__init__() got an unexpected keyword argument '{kw.key}'"));
        }
    }
    let mut otp = Otp {
        kind: kind,
        secret: secret.clone(),
        digits: 6,
        digest: "sha1".to_string(),
        name: String.new(),
        issuer: None,
        interval: 30,
        initial_count: 0,
    };
    for kw in kws.iter() {
        if kw.key == "digits" {
            otp.digits = kw.int as i64;
        } else if kw.key == "digest" {
            otp.digest = kw_text(kw);
        } else if kw.key == "name" {
            otp.name = kw_text(kw);
        } else if kw.key == "issuer" {
            otp.issuer = kw.text.clone();
        } else if kw.key == "interval" {
            otp.interval = kw.int as i64;
        } else {
            otp.initial_count = kw.int;
        }
    }
    if kind == STEAM {
        // Steam passes digits=10 and no interval on to TOTP.__init__
        otp.digits = 10;
        otp.interval = 30;
    }
    if otp.digest == "md5" {
        return Err(value_error("selected digest function must generate digest size greater than or equals to 18 bytes"));
    }
    if otp.digits > 10 {
        return Err(value_error("digits must be no greater than 10"));
    }
    if otp.name.len() == 0 {
        otp.name = "Secret".to_string();
    }
    Ok(otp)
}

fn pow10(n: i64) -> i64 {
    let mut p: i64 = 1;
    for _ in 0..n {
        p *= 10;
    }
    p
}

// OTP.int_to_bytestring: big-endian, at least eight bytes.
fn int_to_bytestring(v: i128) -> Vec[u8] {
    let mut rev: Vec[u8] = Vec.new();
    let mut i = v;
    while i != 0 {
        rev.push((i & 255) as u8);
        i = i >> 8;
    }
    while rev.len() < 8 {
        rev.push(0);
    }
    let mut out: Vec[u8] = Vec.new();
    let mut k = rev.len() - 1;
    while k >= 0 {
        out.push(rev[k]);
        k -= 1;
    }
    out
}

impl Otp {
    // OTP.byte_secret
    fn byte_secret(ref self) -> Result[Vec[u8], Exc] {
        let mut s = self.secret.clone();
        let missing = s.chars().count() % 8;
        if missing != 0 {
            for _ in 0..8 - missing {
                s.push('=');
            }
        }
        b32decode(s)
    }

    // OTP.generate_otp
    fn hotp_value(ref self, input: i128) -> Result[String, Exc] {
        if input < 0 {
            return Err(value_error("input must be positive integer"));
        }
        let h = hmac(self.digest, self.byte_secret()?, int_to_bytestring(input));
        let off = (h[h.len() - 1] & 15) as i64;
        let code = (((h[off] & 0x7f) as i64) << 24) | ((h[off + 1] as i64) << 16) | ((h[off + 2] as i64) << 8) | (h[off + 3] as i64);
        let s = f"{10000000000 + code % pow10(self.digits)}";
        if self.digits == 0 {
            return Ok(s);
        }
        let cs: Vec[char] = s.chars().collect();
        let mut out = String.new();
        for i in cs.len() - self.digits..cs.len() {
            out.push(cs[i]);
        }
        Ok(out)
    }

    fn generate_otp(ref self, input: i128) -> Result[String, Exc] {
        let code = self.hotp_value(input)?;
        if self.kind != STEAM {
            return Ok(code);
        }
        let chars: Vec[char] = STEAM_CHARS.chars().collect();
        let mut n = i64.parse(code).unwrap_or(0);
        let mut out = String.new();
        for _ in 0..5 {
            out.push(chars[n % 26]);
            n = n / 26;
        }
        Ok(out)
    }

    // HOTP.at
    fn at_count(ref self, count: i128) -> Result[String, Exc] {
        self.generate_otp(self.initial_count + count)
    }

    // TOTP.at
    fn at_time(ref self, w: ref When, offset: i64) -> Result[String, Exc] {
        let tc = timecode(w, self.interval)?;
        self.generate_otp((tc + offset) as i128)
    }

    fn verify_count(ref self, t: ref Map[char, String], otp: ref String, counter: i128) -> Result[bool, Exc] {
        Ok(strings_equal(t, otp, self.at_count(counter)?))
    }

    fn verify_time(ref self, t: ref Map[char, String], otp: ref String, w: ref When, window: i64) -> Result[bool, Exc] {
        if window != 0 {
            let mut i = -window;
            while i <= window {
                if strings_equal(t, otp, self.at_time(w, i)?) {
                    return Ok(true);
                }
                i += 1;
            }
            return Ok(false);
        }
        Ok(strings_equal(t, otp, self.at_time(w, 0)?))
    }

    // provisioning_uri(name, initial_count / issuer_name, **kwargs)
    fn provisioning_uri(ref self, name: ref String, issuer_name: ref String, initial_count: i128, extra: ref Vec[Pair]) -> Result[String, Exc] {
        let n = if name.len() > 0 { name.clone() } else { self.name.clone() };
        let issuer = if issuer_name.len() > 0 { Some(issuer_name.clone()) } else { self.issuer.clone() };
        let count: Option[i128] = if self.kind == HOTP {
            Some(if initial_count != 0 { initial_count } else { self.initial_count })
        } else {
            None
        };
        let period: Option[i64] = if self.kind == HOTP { None } else { Some(self.interval) };
        build_uri(self.secret, n, count, issuer, self.digest, self.digits, period, extra)
    }

    fn describe(ref self) -> String {
        let extra = if self.kind == HOTP { f"initial_count={self.initial_count}" } else { f"interval={self.interval}" };
        let issuer = match self.issuer {
            Some(s) => py_repr_str(s),
            None => "None".to_string(),
        };
        f"{class_name(self.kind)} name={py_repr_str(self.name)} issuer={issuer} digits={self.digits} digest={self.digest} {extra} secret={py_repr_str(self.secret)}"
    }
}

// utils.build_uri
fn build_uri(secret: ref String, name: ref String, initial_count: Option[i128], issuer: ref Option[String], algorithm: ref String,
             digits: i64, period: Option[i64], extra: ref Vec[Pair]) -> Result[String, Exc] {
    let mut args: Vec[Pair] = Vec.new();
    args.push(Pair { name: "secret".to_string(), value: secret.clone() });
    let mut label = quote(name, "/");
    if let Some(i) = issuer {
        label = f"{quote(i, "/")}:{label}";
        args.push(Pair { name: "issuer".to_string(), value: i.clone() });
    }
    if let Some(c) = initial_count {
        args.push(Pair { name: "counter".to_string(), value: f"{c}" });
    }
    if *algorithm != "sha1" {
        args.push(Pair { name: "algorithm".to_string(), value: upper(algorithm) });
    }
    if digits != 6 {
        args.push(Pair { name: "digits".to_string(), value: f"{digits}" });
    }
    if let Some(p) = period {
        if p != 30 {
            args.push(Pair { name: "period".to_string(), value: f"{p}" });
        }
    }
    for p in extra.iter() {
        if p.name == "image" {
            let u = urlparse(p.value, "").unwrap_or(Parsed {
                scheme: String.new(),
                netloc: String.new(),
                path: String.new(),
                params: String.new(),
                query: String.new(),
                fragment: String.new(),
            });
            if u.scheme != "https" or u.netloc.len() == 0 or u.path.len() == 0 {
                return Err(exc("ValueError", f"{u.repr()} is not a valid url"));
            }
        }
        let mut found = false;
        for a in args.iter_mut() {
            if a.name == p.name {
                a.value = p.value.clone();
                found = true;
            }
        }
        if not found {
            args.push(p.clone());
        }
    }
    let kind = if initial_count.is_some() { "hotp" } else { "totp" };
    Ok(f"otpauth://{kind}/{label}?{urlencode(args, "", true).replace("+", "%20")}")
}

// int() of a URI parameter, with its ValueError.
fn uri_int(v: ref String) -> Result[i128, Exc] {
    match py_int(v.chars().collect()) {
        Some(d) => Ok(i128.parse(d).unwrap_or(0)),
        None => Err(value_error_s(f"invalid literal for int() with base 10: {py_repr_str(v)}")),
    }
}

fn value_error_s(msg: own String) -> Exc {
    exc("ValueError", msg)
}

// pyotp.parse_uri
fn parse_uri(uri: ref String) -> Result[Otp, Exc] {
    let mut secret = String.new();
    let mut encoder: Option[String] = None;
    let mut digits: Option[i128] = None;
    let mut data: Vec[Kw] = Vec.new();
    let p = match urlparse(uri, "") {
        Ok(p) => p,
        Err(e) => return Err(value_error_s(e)),
    };
    if p.scheme != "otpauth" {
        return Err(value_error("Not an otpauth URI"));
    }
    let path: Vec[char] = p.path.chars().collect();
    let mut rest = String.new();
    for i in 1..path.len() {
        rest.push(path[i]);
    }
    let (issuer, has_colon, account) = partition(rest, b':');
    if not has_colon {
        kw_set(mut data, kw_str("name", unquote(issuer)));
    } else {
        kw_set(mut data, kw_str("issuer", unquote(issuer)));
        kw_set(mut data, kw_str("name", unquote(account)));
    }
    let pairs = parse_qsl(p.query, false, false, "&").unwrap_or(Vec.new());
    for pr in pairs.iter() {
        let key = pr.name.clone();
        let value = pr.value.clone();
        if key == "secret" {
            secret = value;
        } else if key == "issuer" {
            for kw in data.iter() {
                if kw.key == "issuer" {
                    if let Some(old) = kw.text {
                        if *old != value {
                            return Err(value_error("If issuer is specified in both label and parameters, it should be equal."));
                        }
                    }
                }
            }
            kw_set(mut data, kw_str("issuer", value));
        } else if key == "algorithm" {
            let d = if value == "SHA1" {
                "sha1"
            } else if value == "SHA256" {
                "sha256"
            } else if value == "SHA512" {
                "sha512"
            } else {
                return Err(value_error("Invalid value for algorithm, must be SHA1, SHA256 or SHA512"));
            };
            kw_set(mut data, kw_str("digest", d.to_string()));
        } else if key == "encoder" {
            encoder = Some(value);
        } else if key == "digits" {
            let n = uri_int(value)?;
            digits = Some(n);
            kw_set(mut data, kw_int("digits", n));
        } else if key == "period" {
            kw_set(mut data, kw_int("interval", uri_int(value)?));
        } else if key == "counter" {
            kw_set(mut data, kw_int("initial_count", uri_int(value)?));
        }
    }
    let steam = encoder == Some("steam".to_string());
    if not steam {
        if let Some(n) = digits {
            if n != 6 and n != 7 and n != 8 {
                return Err(value_error("Digits may only be 6, 7, or 8"));
            }
        }
    }
    if secret.len() == 0 {
        return Err(value_error("No secret found in URI"));
    }
    if steam {
        return new_otp(STEAM, secret, data);
    }
    if p.netloc == "totp" {
        return new_otp(TOTP, secret, data);
    }
    if p.netloc == "hotp" {
        return new_otp(HOTP, secret, data);
    }
    Err(value_error("Not a supported OTP type"))
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

// bytes.fromhex: pairs of hex digits, spaces between them allowed.
fn unhex(s: ref String) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if c != b' ' {
            digits.push(c);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < digits.len() {
        out.push((hex_val(digits[i]) * 16 + hex_val(digits[i + 1])) as u8);
        i += 2;
    }
    out
}
// CR shows as <CR> and other control characters as <xNN>, so
// expected.out stays a plain LF text file.
fn show(text: ref String) -> String {
    let mut out = String.new();
    for c in text.chars() {
        let n = c as i64;
        if c == '\r' {
            out.push_str("<CR>");
        } else if (n < 0x20 and c != '\t' and c != '\n') or n == 0x7f {
            out.push_str(f"<x{hex_digits(n, 2)}>");
        } else {
            out.push(c);
        }
    }
    out
}
fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push_str("\n");
}

// ------------------------------------------------------------ the jobs

// A job's key=value fields, in order.
fn fields(args: ref Vec[String]) -> Vec[Pair] {
    let mut out: Vec[Pair] = Vec.new();
    for a in args.iter() {
        let (k, _, v) = partition(a, b'=');
        out.push(Pair { name: k, value: v });
    }
    out
}

fn field(fs: ref Vec[Pair], key: Str) -> Option[String] {
    for p in fs.iter() {
        if p.name == key {
            return Some(p.value.clone());
        }
    }
    None
}

fn field_or(fs: ref Vec[Pair], key: Str) -> String {
    field(fs, key).unwrap_or(String.new())
}

fn int_of(s: ref String) -> i128 {
    i128.parse(s.clone()).unwrap_or(0)
}

fn kind_of(name: ref String) -> i64 {
    if *name == "hotp" {
        HOTP
    } else if *name == "totp" {
        TOTP
    } else {
        STEAM
    }
}

// The class's keyword arguments among a job's fields.
fn make(kind: i64, fs: ref Vec[Pair]) -> Result[Otp, Exc] {
    let skip: Vec[Str] = vec!["kind", "secret", "at", "otp", "counter", "for_time", "counter_offset", "valid_window"];
    let mut kws: Vec[Kw] = Vec.new();
    for p in fs.iter() {
        let mut skipped = p.name.starts_with("p.");
        for s in skip.iter() {
            if p.name == *s {
                skipped = true;
            }
        }
        if skipped {
            continue;
        }
        if p.name == "digits" or p.name == "interval" or p.name == "initial_count" {
            kw_set(mut kws, Kw { key: p.name.clone(), int: int_of(p.value), text: None });
        } else {
            kw_set(mut kws, Kw { key: p.name.clone(), int: 0, text: Some(p.value.clone()) });
        }
    }
    new_otp(kind, field_or(fs, "secret"), kws)
}

fn split_commas(s: ref String) -> Vec[String] {
    split_on(s, b',')
}

fn first_code(otp: ref Otp) -> String {
    if otp.kind == HOTP {
        match otp.at_count(0) {
            Ok(c) => f"at(0) = {c}",
            Err(e) => err_line(e),
        }
    } else {
        match otp.at_time(When.Stamp(1709993107), 0) {
            Ok(c) => f"at(1709993107) = {c}",
            Err(e) => err_line(e),
        }
    }
}

fn codes_job(kind: i64, args: ref Vec[String], out: mut ref String) {
    let fs = fields(args);
    let otp = match make(kind, fs) {
        Ok(o) => o,
        Err(e) => {
            emit(mut out, err_line(e));
            return;
        }
    };
    let offset = int_of(field_or(fs, "counter_offset")) as i64;
    for t in split_commas(field_or(fs, "at")).iter() {
        let r = if kind == HOTP { otp.at_count(int_of(t)) } else { otp.at_time(when_of(t), offset) };
        match r {
            Ok(c) => emit(mut out, f"at({t}) = {c}"),
            Err(e) => emit(mut out, f"at({t}): {err_line(e)}"),
        }
    }
}

fn verify_hotp_job(t: ref Map[char, String], args: ref Vec[String], out: mut ref String) {
    let fs = fields(args);
    let otp = make(HOTP, fs).unwrap_or(blank_otp());
    let code = field_or(fs, "otp");
    for c in split_commas(field_or(fs, "counter")).iter() {
        match otp.verify_count(t, code, int_of(c)) {
            Ok(ok) => emit(mut out, show(f"verify({py_repr_str(code)}, {c}) = {py_bool(ok)}")),
            Err(e) => emit(mut out, show(f"verify({py_repr_str(code)}, {c}): {err_line(e)}")),
        }
    }
}

fn verify_totp_job(t: ref Map[char, String], args: ref Vec[String], out: mut ref String) {
    let fs = fields(args);
    let otp = make(TOTP, fs).unwrap_or(blank_otp());
    let code = field_or(fs, "otp");
    let window = int_of(field_or(fs, "valid_window")) as i64;
    for w in split_commas(field_or(fs, "for_time")).iter() {
        match otp.verify_time(t, code, when_of(w), window) {
            Ok(ok) => emit(mut out, show(f"verify({py_repr_str(code)}, {w}) = {py_bool(ok)}")),
            Err(e) => emit(mut out, show(f"verify({py_repr_str(code)}, {w}): {err_line(e)}")),
        }
    }
}

fn blank_otp() -> Otp {
    Otp {
        kind: TOTP,
        secret: String.new(),
        digits: 6,
        digest: "sha1".to_string(),
        name: "Secret".to_string(),
        issuer: None,
        interval: 30,
        initial_count: 0,
    }
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn parse_back(uri: ref String, out: mut ref String) {
    match parse_uri(uri) {
        Ok(back) => {
            emit(mut out, f"  parsed: {back.describe()}");
            emit(mut out, f"  {first_code(back)}");
        }
        Err(e) => emit(mut out, f"  parsed: {err_line(e)}"),
    }
}

fn provision_job(args: ref Vec[String], out: mut ref String) {
    let fs = fields(args);
    let otp = match make(kind_of(field_or(fs, "kind")), fs) {
        Ok(o) => o,
        Err(e) => {
            emit(mut out, err_line(e));
            return;
        }
    };
    let mut name = String.new();
    let mut issuer = String.new();
    let mut count: i128 = 0;
    let mut extra: Vec[Pair] = Vec.new();
    for p in fs.iter() {
        if not p.name.starts_with("p.") {
            continue;
        }
        let key = slice_from(p.name, 2);
        if key == "name" {
            name = p.value.clone();
        } else if key == "issuer_name" {
            issuer = p.value.clone();
        } else if key == "initial_count" and otp.kind == HOTP {
            count = int_of(p.value);
        } else {
            extra.push(Pair { name: key, value: p.value.clone() });
        }
    }
    match otp.provisioning_uri(name, issuer, count, extra) {
        Ok(uri) => {
            emit(mut out, uri);
            parse_back(uri, mut out);
        }
        Err(e) => emit(mut out, err_line(e)),
    }
}

fn secret_job(args: ref Vec[String], out: mut ref String) {
    let otp = new_otp(HOTP, args[0], Vec.new()).unwrap_or(blank_otp());
    match otp.byte_secret() {
        Ok(b) => emit(mut out, hex_of(b)),
        Err(e) => emit(mut out, err_line(e)),
    }
}

// random_base32 and random_hex: only their length checks are printed.
fn random_job(args: ref Vec[String], out: mut ref String) {
    let n = int_of(args[1]) as i64;
    let least = if args[0] == "base32" { 32 } else { 40 };
    if n < least or n < 32 {
        emit(mut out, "error: ValueError: Secrets should be at least 160 bits");
    } else {
        emit(mut out, f"{n} characters");
    }
}

fn uris_job(args: ref Vec[String], out: mut ref String) {
    for line in lines_of(read_text(args[0])).iter() {
        emit(mut out, show(line));
        let otp = match parse_uri(line) {
            Ok(o) => o,
            Err(e) => {
                emit(mut out, f"  {err_line(e)}");
                continue;
            }
        };
        emit(mut out, f"  {otp.describe()}");
        emit(mut out, f"  {first_code(otp)}");
        match otp.provisioning_uri(String.new(), String.new(), 0, Vec.new()) {
            Ok(uri) => emit(mut out, f"  uri: {uri}"),
            Err(e) => emit(mut out, f"  uri: {err_line(e)}"),
        }
    }
}

// ------------------------------------------------------------ programs

// "%-40s"
fn pad_right(s: ref String, width: i64) -> String {
    let mut out = s.clone();
    let mut n = s.chars().count();
    while n < width {
        out.push(' ');
        n += 1;
    }
    out
}

fn pad_left(s: ref String, width: i64) -> String {
    let mut out = String.new();
    let mut n = s.chars().count();
    while n < width {
        out.push(' ');
        n += 1;
    }
    out.push_str(s);
    out
}

fn py_mod(a: i64, b: i64) -> i64 {
    let r = a % b;
    if r != 0 and ((r < 0) != (b < 0)) { r + b } else { r }
}

struct Account {
    issuer_key: String,
    name_key: String,
    otp: Otp,
}

fn authenticator_job(args: ref Vec[String], out: mut ref String) {
    let w = when_of(args[1]);
    let stamp = stamp_of(w);
    let mut accounts: Vec[Account] = Vec.new();
    for line in lines_of(read_text(args[0])).iter() {
        if let Ok(otp) = parse_uri(line) {
            let issuer = match otp.issuer.clone() {
                Some(s) => s.to_lowercase(),
                None => String.new(),
            };
            accounts.push(Account { issuer_key: issuer, name_key: otp.name.to_lowercase(), otp: otp });
        }
    }
    accounts.sort_by(|a, b| account_cmp(a, b));
    for a in accounts.iter() {
        let otp = a.otp.clone();
        let label = match otp.issuer.clone() {
            Some(i) => f"{i} ({otp.name})",
            None => otp.name.clone(),
        };
        if otp.kind == HOTP {
            let code = match otp.at_count(0) {
                Ok(c) => c,
                Err(e) => err_line(e),
            };
            emit(mut out, f"{pad_right(label, 40)} {code}  counter {otp.initial_count}");
            continue;
        }
        match otp.at_time(w, 0) {
            Ok(code) => {
                let left = otp.interval - py_mod(stamp, otp.interval);
                let next = otp.at_time(w, 1).unwrap_or(String.new());
                emit(mut out, f"{pad_right(label, 40)} {code}  {pad_left(f"{left}", 2)}s left, next {next}");
            }
            Err(e) => emit(mut out, f"{pad_right(label, 40)} {err_line(e)}"),
        }
    }
}

fn str_cmp(a: ref String, b: ref String) -> Ordering {
    if a < b {
        Ordering.Less
    } else if a == b {
        Ordering.Equal
    } else {
        Ordering.Greater
    }
}

fn account_cmp(a: ref Account, b: ref Account) -> Ordering {
    let c = str_cmp(a.issuer_key, b.issuer_key);
    if c != Ordering.Equal {
        return c;
    }
    str_cmp(a.name_key, b.name_key)
}

// A user's TOTP from users.tsv's "key=value ..." settings.
fn user_otp(secret: ref String, opts: ref String) -> Otp {
    let mut kws: Vec[Kw] = Vec.new();
    for o in split_ws(opts).iter() {
        let (k, _, v) = partition(o, b'=');
        if k == "digest" {
            kws.push(kw_str("digest", v));
        } else {
            kws.push(Kw { key: k, int: int_of(v), text: None });
        }
    }
    new_otp(TOTP, secret, kws).unwrap_or(blank_otp())
}

struct User {
    name: String,
    otp: Otp,
    last_step: i64,
    fails: i64,
    locked_until: i64,
}

fn login_job(t: ref Map[char, String], args: ref Vec[String], out: mut ref String) {
    let mut users: Vec[User] = Vec.new();
    for line in lines_of(read_text(args[0])).iter() {
        let f = split_on(line, b'\t');
        users.push(User { name: f[0].clone(), otp: user_otp(f[1], f[2]), last_step: -1, fails: 0, locked_until: 0 });
    }
    for line in lines_of(read_text(args[1])).iter() {
        let f = split_on(line, b'\t');
        let w = when_of(f[0]);
        let now = stamp_of(w);
        let head = show(f"{f[0]} {f[1]} {py_repr_str(f[2])}:");
        let mut found: i64 = -1;
        for i in 0..users.len() {
            if users[i].name == f[1] {
                found = i;
            }
        }
        if found < 0 {
            emit(mut out, f"{head} no such user");
            continue;
        }
        if users[found].locked_until > now {
            emit(mut out, f"{head} locked for {users[found].locked_until - now}s more");
            continue;
        }
        let code = f[2].replace(" ", "").replace("-", "");
        let step = timecode(w, users[found].otp.interval).unwrap_or(0);
        let mut matched: Option[i64] = None;
        for i in vec![-1, 0, 1] {
            let c = users[found].otp.at_time(w, i).unwrap_or(String.new());
            if strings_equal(t, code, c) {
                matched = Some(step + i);
                break;
            }
        }
        match matched {
            None => {
                users[found].fails += 1;
                if users[found].fails >= 3 {
                    users[found].locked_until = now + 300;
                    users[found].fails = 0;
                    emit(mut out, f"{head} wrong code; locked for 300s");
                } else {
                    emit(mut out, f"{head} wrong code ({users[found].fails} of 3)");
                }
            }
            Some(m) => {
                if m <= users[found].last_step {
                    emit(mut out, f"{head} replayed code from step {m}");
                } else {
                    users[found].last_step = m;
                    users[found].fails = 0;
                    let drift = m - step;
                    let note = if drift == 0 { String.new() } else if drift > 0 { f" (drift +{drift})" } else { f" (drift {drift})" };
                    emit(mut out, f"{head} accepted at step {m}{note}");
                }
            }
        }
    }
}

struct Token {
    serial: String,
    otp: Otp,
    counter: i128,
    pending: Option[i128],
}

// The first counter in [from, to) whose code is `code`.
fn find_counter(t: ref Map[char, String], otp: ref Otp, code: ref String, from: i128, to: i128) -> Option[i128] {
    let mut c = from;
    while c < to {
        if otp.verify_count(t, code, c).unwrap_or(false) {
            return Some(c);
        }
        c += 1;
    }
    None
}

fn tokens_job(t: ref Map[char, String], args: ref Vec[String], out: mut ref String) {
    let mut tokens: Vec[Token] = Vec.new();
    for line in lines_of(read_text(args[0])).iter() {
        let f = split_on(line, b'\t');
        let otp = new_otp(HOTP, f[1], Vec.new()).unwrap_or(blank_otp());
        tokens.push(Token { serial: f[0].clone(), otp: otp, counter: int_of(f[2]), pending: None });
    }
    for line in lines_of(read_text(args[1])).iter() {
        let f = split_on(line, b'\t');
        let code = f[1].clone();
        let head = f"{f[0]} {code}:";
        let mut at: i64 = -1;
        for i in 0..tokens.len() {
            if tokens[i].serial == f[0] {
                at = i;
            }
        }
        if at < 0 {
            emit(mut out, f"{head} unknown token");
            continue;
        }
        let counter = tokens[at].counter;
        if let Some(c) = find_counter(t, tokens[at].otp, code, counter, counter + 10) {
            tokens[at].counter = c + 1;
            tokens[at].pending = None;
            emit(mut out, f"{head} accepted at {c}, next {tokens[at].counter}");
            continue;
        }
        if let Some(p) = tokens[at].pending {
            if tokens[at].otp.verify_count(t, code, p + 1).unwrap_or(false) {
                tokens[at].counter = p + 2;
                tokens[at].pending = None;
                emit(mut out, f"{head} resynchronised at {p + 1}, next {tokens[at].counter}");
                continue;
            }
        }
        tokens[at].pending = find_counter(t, tokens[at].otp, code, counter, counter + 100);
        if tokens[at].pending.is_some() {
            emit(mut out, f"{head} out of sync; press again");
        } else {
            emit(mut out, f"{head} rejected");
        }
    }
}

fn enrol_job(args: ref Vec[String], out: mut ref String) {
    let w = when_of(args[1]);
    for line in lines_of(read_text(args[0])).iter() {
        let f = split_on(line, b'\t');
        let email = f[0].clone();
        let issuer = f[1].clone();
        let secret = b32encode(sha1(to_bytes(email)));
        let mut kws: Vec[Kw] = vec![kw_str("name", email)];
        if issuer.len() > 0 {
            kws.push(kw_str("issuer", issuer));
        }
        let otp = new_otp(TOTP, secret, kws).unwrap_or(blank_otp());
        let mut extra: Vec[Pair] = Vec.new();
        for e in split_ws(f[2]).iter() {
            let (k, _, v) = partition(e, b'=');
            extra.push(Pair { name: k, value: v });
        }
        let shown = if issuer.len() > 0 { issuer.clone() } else { "no issuer".to_string() };
        emit(mut out, show(f"{email} ({shown}):"));
        let uri = match otp.provisioning_uri(String.new(), String.new(), 0, extra) {
            Ok(u) => u,
            Err(e) => {
                emit(mut out, f"  {err_line(e)}");
                continue;
            }
        };
        emit(mut out, f"  {uri}");
        let back = parse_uri(uri).unwrap_or(blank_otp());
        let same = back.secret == otp.secret and back.name == otp.name and back.issuer == otp.issuer;
        let verdict = if same { "ok".to_string() } else { f"differs: {back.describe()}" };
        let code = back.at_time(w, 0).unwrap_or(String.new());
        emit(mut out, f"  round trip {verdict}, code {code}");
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let t = nfkd_table();
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())).iter() {
        let job = split_on(line, b'\t');
        emit(mut out, show(f"== {join(job, " ")}"));
        let mut args: Vec[String] = Vec.new();
        for i in 1..job.len() {
            args.push(job[i].clone());
        }
        let kind = job[0].clone();
        if kind == "hotp" or kind == "totp" or kind == "steam" {
            codes_job(kind_of(kind), args, mut out);
        } else if kind == "verify_hotp" {
            verify_hotp_job(t, args, mut out);
        } else if kind == "verify_totp" {
            verify_totp_job(t, args, mut out);
        } else if kind == "provision" {
            provision_job(args, mut out);
        } else if kind == "secret" {
            secret_job(args, mut out);
        } else if kind == "random" {
            random_job(args, mut out);
        } else if kind == "uris" {
            uris_job(args, mut out);
        } else if kind == "authenticator" {
            authenticator_job(args, mut out);
        } else if kind == "login" {
            login_job(t, args, mut out);
        } else if kind == "tokens" {
            tokens_job(t, args, mut out);
        } else {
            enrol_job(args, mut out);
        }
    }
    print(out);
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    v
}

