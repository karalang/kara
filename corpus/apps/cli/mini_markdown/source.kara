    t.push_str("|\u{41d}\u{435}\u{434} \u{431}\u{44b}\u{43b} \u{43e}\u{434}\u{43d}\u{438}\u{43c} \u{438}\u{437} \u{43f}\u{435}\u{440}\u{432}\u{44b}\u{445} \u{43f}\u{435}\u{440}\u{441}\u{43e}\u{43d}\u{430}\u{436}\u{435}\u{439} \u{432} \u{43c}\u{443}\u{43b}\u{44c}\u{442}\u{441}\u{435}\u{440}\u{438}\u{430}\u{43b}\u{435}, \u{43a}\u{43e}\u{442}\u{43e}\u{440}\u{44b}\u{439} \u{43d}\u{435} \u{431}\u{44b}\u{43b} \u{447}\u{43b}\u{435}\u{43d}\u{43e}\u{43c} \u{441}\u{435}\u{43c}\u{44c}\u{438} \u{421}\u{438}\u{43c}\u{43f}\u{441}\u{43e}\u{43d}\u{43e}\u{432}. \u{41d}\u{430}\u{447}\u{438}\u{43d}\u{430}\u{44f} \u{441} \u{43f}\u{435}\u{440}\u{432}\u{44b}\u{445} \u{441}\u{435}\u{440}\u{438}\u{439}, \u{43e}\u{43d} \u{440}\u{435}\u{433}\u{443}\u{43b}\u{44f}\u{440}\u{43d}\u{43e} \u{43f}\u{43e}\u{44f}\u{432}\u{43b}\u{44f}\u{435}\u{442}\u{441}\u{44f} \u{432} \u{ab}\u{421}\u{438}\u{43c}\u{43f}\u{441}\u{43e}\u{43d}\u{430}\u{445}\u{bb}. \u{421}\u{447}\u{438}\u{442}\u{430}\u{435}\u{442}\u{441}\u{44f}, \u{447}\u{442}\u{43e} \u{41d}\u{435}\u{434} \u{424}\u{43b}\u{430}\u{43d}\u{434}\u{435}\u{440}\u{441} \u{431}\u{44b}\u{43b} \u{43d}\u{430}\u{437}\u{432}\u{430}\u{43d} \u{432} \u{447}\u{435}\u{441}\u{442}\u{44c} \u{443}\u{43b}\u{438}\u{446}\u{44b} *Northeast Flanders St.* \u{432} [\u{41f}\u{43e}\u{440}\u{442}\u{43b}\u{435}\u{43d}\u{434}\u{435}](http://www.portland.gov), \u{41e}\u{440}\u{435}\u{433}\u{43e}\u{43d}, \u{440}\u{43e}\u{434}\u{43d}\u{43e}\u{43c} \u{433}\u{43e}\u{440}\u{43e}\u{434}\u{435} \u{441}\u{43e}\u{437}\u{434}\u{430}\u{442}\u{435}\u{43b}\u{44f} \u{43c}\u{443}\u{43b}\u{44c}\u{442}\u{441}\u{435}\u{440}\u{438}\u{430}\u{43b}\u{430} \u{41c}\u{44d}\u{442}\u{442}\u{430} \u{413}\u{440}\u{435}\u{439}\u{43d}\u{438}\u{43d}\u{433}\u{430}]]. \u{41d}\u{430}\u{434}\u{43f}\u{438}\u{441}\u{44c} \u{43d}\u{430} \u{443}\u{43a}\u{430}\u{437}\u{430}\u{442}\u{435}\u{43b}\u{435} \u{443}\u{43b}\u{438}\u{446}\u{44b} *NE Flanders St.* \u{445}\u{443}\u{43b}\u{438}\u{433}\u{430}\u{43d}\u{44b} \u{447}\u{430}\u{4