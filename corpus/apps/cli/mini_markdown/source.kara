    t.push_str("|**\u{b89}\u{bb0}\u{bc1}\u{ba4}\u{bc1}** 13\u{b86}\u{bae}\u{bcd} \u{ba8}\u{bc2}\u{bb1}\u{bcd}\u{bb1}\u{bbe}\u{ba3}\u{bcd}\u{b9f}\u{bbf}\u{bb2}\u{bcd} \u{b89}\u{bb0}\u{bc1}\u{bb5}\u{bbe}\u{ba9} \u{b92}\u{bb0}\u{bc1} \u{b87}\u{ba8}\u{bcd}\u{ba4}\u{bcb}-\u{b90}\u{bb0}\u{bcb}\u{baa}\u{bcd}\u{baa}\u{bbf}\u{baf} \u{bae}\u{bca}\u{bb4}\u{bbf}\u{baf}\u{bbe}\u{b95}\u{bc1}\u{bae}\u{bcd}. \u{b89}\u{bb0}\u{bc1}\u{ba4}\u{bc1}, \u{bb9}\u{bbf}\u{ba8}\u{bcd}\u{ba4}\u{bbf}\u{baf}\u{bc1}\u{b9f}\u{ba9}\u{bcd} \u{b9a}\u{bc7}\u{bb0}\u{bcd}\u{ba4}\u{bcd}\u{ba4}\u{bc1} \"\u{bb9}\u{bbf}\u{ba8}\u{bcd}\u{ba4}\u{bc1}\u{bb8}\u{bcd}\u{ba4}\u{bbe}\u{ba9}\u{bbf}\" \u{b8e}\u{ba9} \u{b85}\u{bb4}\u{bc8}\u{b95}\u{bcd}\u{b95}\u{baa}\u{bcd}\u{baa}\u{b9f}\u{bc1}\u{b95}\u{bbf}\u{ba9}\u{bcd}\u{bb1}\u{ba4}\u{bc1}. \u{bae}\u{ba3}\u{bcd}\u{b9f}\u{bb0}\u{bbf}\u{ba9}\u{bcd}, \u{b86}\u{b99}\u{bcd}\u{b95}\u{bbf}\u{bb2}\u{bae}\u{bcd} \u{b86}\u{b95}\u{bbf}\u{baf}\u{bb5}\u{bb1}\u{bcd}\u{bb1}\u{bc1}\u{b95}\u{bcd}\u{b95}\u{bc1} \u{b85}\u{b9f}\u{bc1}\u{ba4}\u{bcd}\u{ba4}\u{baa}\u{b9f}\u{bbf}\u{baf}\u{bbe}\u{b95} \u{bae}\u{bc2}\u{ba9}\u{bcd}\u{bb1}\u{bbe}\u{bb5}\u{ba4}\u{bc1} \u{b95}\u{bc2}\u{b9f}\u{bbf}\u{baf} \u{b85}\u{bb3}\u{bb5}\u{bc1} \u{bae}\u{b95}\u{bcd}\u{b95}\u{bb3}\u{bbe}\u{bb2}\u{bcd} \u{baa}\u{bc1}\u{bb0}\u{bbf}\u{ba8}\u{bcd}\u{ba4}\u{bc1} \u{b95}\u{bca}\u{bb3}\u{bcd}\u{bb3}\u{baa}\u{bcd}\u{baa}\u{b9f}\u{b95}\u{bcd}\u{b95}\u{bc2}\u{b9f}\u{bbf}\u{baf}\u{ba4}\u{bc1} \u{bb9}\u{bbf}\u{ba8}\u{bcd}\u{ba4}\u{bc1}\u{bb8}\u{bcd}\u{ba4}\u{bbe}\u{ba9}\u{bbf}\u{baf}\u{bc7}\u{baf}\u{bbe}\u{b95}\u{bc1}\u{bae}\u{bcd}. \u{ba4}\u{bbe}\u{baf}\u{bcd} \u{bae}\u{bca}\u{bb4}\u{bbf}\u{baf}\u{bbe}\u{b95}\u{baa}\u{bcd} \u{baa}\u{bc7}\u{b9a}\u{bc1}\u{baa}\u{bb5}\u{bb0}\u{bcd}\u{b95}\u{bb3}\u{bcd} \u{b8e}\u{ba3}\u{bcd}\u{ba3}\u{bbf}\u{b95}\u{bcd}\u{b95}\u{bc8}\u{baf}\u{bbf}\u{ba9}\u{bcd} \u{b85}\u{b9f}\u{bbf}\u{baa}\u{bcd}\u{baa}\u{b9f}\u{bc8}\u{baf}\u{bbf}\u{bb2}\u{bcd} \u{b89}\u{bb0}\u{bc1}\u{ba4}\u{bc1} \u{b89}\u{bb2}\u{b95}\u{bbf}\u{ba9}\u{bcd} 20 \u{b86}\u{bb5}\u{ba4}\u{bc1} \u{baa}\u{bc6}\u{bb0}\u{bbf}\u{baf} \u{bae}\u{bca}\u{bb4}\u{bbf}\u{baf}\u{bbe}\u{b95}\u{bc1}\u{bae}\u{bcd}. 6 \u{b95}\u{bcb}\u{b9f}\u{bbf} \u{bae}\u{b95}\u{bcd}\u{b95}\u{bb3}\u{bcd} \u{b87}\u{ba4}\u{ba9}\u{bc8}\u{ba4}\u{bcd} \u{ba4}\u{bbe}\u{baf}\u{bcd} \u{bae}\u{bca}\u{bb4}\u{bbf}\u{baf}\u{bbe}\u{b95}\u{b95}\u{bcd} \u{b95}\u{bca}\u{ba3}\u{bcd}\u{b9f}\u{bc1}\u{bb3}\u{bcd}\u{bb3}\u{bbe}\u{bb0}\u{bcd}\u{b95}\u{bb3}\u{bcd}. \u{b87}\u{bb0}\u{ba3}\u{bcd}\u{b9f}\u{bbe}\u{bb5}\u{ba4}\u{bc1} \u{bae}\u{bca}\u{bb4}\u{bbf}\u{baf}\u{bbe}\u{b95}\u{b95}\u{bcd} \u{b95}\u{bca}\u{ba3}\u{bcd}\u{b9f}\u{bc1}\u{bb3}\u{bcd}\u{bb3}\u{bb5}\u{bb0}\u{bcd}\u{b95}\u{bb3}\u{bcd} \u{b89}\u{b9f}\u{bcd}\u{baa}\u{b9f} 11 \u{b95}\u{bcb}\u{b9f}\u{bbf}\u{baa}\u{bcd} \u{baa}\u{bc7}\u{bb0}\u{bcd} \u{b87}\u{ba4}\u{ba9}\u{bc8}\u{baa}\u{bcd} \u{baa}\u{bc7}\u{b9a}\u{bc1}\u{b95}\u{bbf}\u{bb1}\u{bbe}\u{bb0}\u{bcd}\u{b95}\u{bb3}\u{bcd}. \u{b89}\u{bb0}\u{bc1}\u{ba4}\u{bc1} \u{baa}\u{bbe}\u{b95}\u{bbf}\u{bb8}\u{bcd}\u{ba4}\u{bbe}\u{ba9}\u{bbf}\u{ba9}\u{bcd} \u{b85}\u{bb0}\u{b9a}\u{b95}\u{bb0}\u{bc1}\u{bae} \u{bae}\u{bca}\u{bb4}\u{bbf}\u{baf}\u{bbe}\u{b95}\u{bb5}\u{bc1}\u{bae}\u{bcd}, \u{b87}\u{ba8}\u{bcd}\u{ba4}\u{bbf}\u{baf}\u{bbe}\u{bb5}\u{bbf}\u{ba9}\u{bcd} \u{b85}\u{bb0}\u{b9a}\u{b95}\u{bb0}\u{bc1}\u{bae} \u{bae}\u{bca}\u{bb4}\u{bbf}\u{b95}\u{bb3}\u{bc1}\u{bb3}\u{bcd} \u{b92}\u{ba9}\u{bcd}\u{bb1}\u{bbe}\u{b95}\u{bb5}\u{bc1}\u{bae}\u{bcd} \u{bb5}\u{bbf}\u{bb3}\u{b99}\u{bcd}\u{b95}\u{bc1}\u{b95}\u{bbf}\u{bb1}\u{ba4}\u{bc1}.\n|\n|\u{627}\u{631}\u{62f}\u{648} \u{6c1}\u{646}\u{62f}\u{648}\u{622}\u{631}\u{6cc}\u{627}\u{626}\u{6cc} \u{632}\u{628}\u{627}\u{646}\u{648}\u{6ba} \u{6a9}\u{6cc} \u{6c1}\u{646}\u{62f}\u{648}\u{64a}\u{648}\u{631}\u{67e}\u{6cc} \u{634}\u{627}\u{62e} \u{6a9}\u{6cc} \u{627}\u{6cc}\u{6a9} \u{632}\u{628}\u{627}\u{646} \u{6c1}\u{6d2} \u{62c}\u{648} \u{62a}\u{64a}\u{631}\u{6be}\u{648}\u{64a}\u{6ba} \u{635}\u{62f}\u{6cc} \u{645}\u{64a}\u{6ba} \u{628}\u{631} \u{635}\u{63a}\u{64a}\u{631} \u{645}\u{64a}\u{6ba} \u{67e}\u{64a}\u{62f}\u{627} \u{6c1}\u{648}\u{626}\u{6cc} \u{640} \u{627}\u{631}\u{62f}\u{648} \u{67e}\u{627}\u{6a9}\u{633}\u{62a}\u{627}\u{646} \u{6a9}\u{6cc} \u{633}\u{631}\u{6a9}\u{627}\u{631}\u{6cc} \u{632}\u{628}\u{627}\u{646} \u{6c1}\u{6d2} \u{627}\u{648}\u{631} \u{628}\u{6be}\u{627}\u{631}\u{62a} \u{6a9}\u{6cc} \u{633}\u{631}\u{6a9}\u{627}\u{631}\u{6cc} \u{632}\u{628}\u{627}\u{646}\u{648}\u{6ba} \u{645}\u{64a}\u{6ba} \u{633}\u{6d2} \u{627}\u{64a}\u{6a9} \u{6c1}\u{6d2}\u{6d4} \u{627}\u{631}\u{62f}\u{648} \u{628}\u{6be}\u{627}\u{631}\u{62a} \u{645}\u{64a}\u{6ba} 5 \u{6a9}\u{631}\u{648}\u{691} \u{627}\u{648}\u{631} \u{67e}\u{627}\u{6a9}\u{633}\u{62a}\u{627}\u{646} \u{645}\u{64a}\u{6ba} 1 \u{6a9}\u{631}\u{648}\u{691} \u{644}\u{648}\u{6af}\u{648}\u{6ba} \u{6a9}\u{6cc} \u{645}\u{627}\u{62f}\u{631}\u{6cc} \u{632}\u{628}\u{627}\u{646} \u{6c1}\u{6d2} \u{645}\u{6af}\u{631} \u{627}\u{633}\u{6d2} \u{628}\u{6be}\u{627}\u{631}\u{62a} \u{627}\u{648}\u{631} \u{67e}\u{627}\u{6a9}\u{633}\u{62a}\u{627}\u{646} \u{6a9}\u{6d2} \u{62a}\u{642}\u{631}\u{6cc}\u{628}\u{627}\u{64b} 50 \u{6a9}\u{631}\u{648}\u{691} \u{644}\u{648}\u{6af} \u{628}\u{648}\u{644} \u{627}\u{648}\u{631} \u{633}\u{645}\u{62c}\u{6be} \u{633}\u{6a9}\u{62a}\u{6d2} \u{6be}\u{6cc}\u{6ba} \u{6d4} \u{62c}\u{646} \u{645}\u{6cc}\u{6ba} \u{633}\u{6d2} \u{62a}\u{642}\u{631}\u{6cc}\u{628}\u{627}\u{64b} 10.5 \u{6a9}\u{631}\u{648}\u{691} \u{644}\u{648}\u{6af} \u{627}\u{633}\u{6d2} \u{628}\u{627}\u{642}\u{627}\u{639}\u{62f}\u{6c1} \u{628}\u{648}\u{644}\u{62a}\u{6d2} \u{6be}\u{6cc}\u{6ba}\u{6d4}\n|\n|\u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646}\n|=====\n|\n|**\u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646}** \u{644}\u{63a}\u{629} \u{628}\u{631}\u{645}\u{62c}\u{629} \u{62d}\u{62f}\u{64a}\u{62b}\u{629} \u{628}\u{633}\u{64a}\u{637}\u{629}\u{60c} \u{648}\u{627}\u{636}\u{62d}\u{629}\u{60c} \u{633}\u{631}\u{64a}\u{639}\u{629} \u{60c} \u{62a}\u{633}\u{62a}\u{62e}\u{62f}\u{645} \u{623}\u{633}\u{644}\u{648}\u{628} \u{627}\u{644}\u{628}\u{631}\u{645}\u{62c}\u{629} \u{627}\u{644}\u{643}\u{627}\u{626}\u{646}\u{64a}\u{629} (OOP) \u{648}\u{642}\u{627}\u{628}\u{644}\u{629} \u{644}\u{644}\u{62a}\u{637}\u{648}\u{64a}\u{631} \u{628}\u{627}\u{644}\u{625}\u{636}\u{627}\u{641}\u{629} \u{625}\u{644}\u{649} \u{623}\u{646}\u{647}\u{627} \u{645}\u{62c}\u{627}\u{646}\u{64a}\u{629} \u{648} \u{645}\u{641}\u{62a}\u{648}\u{62d}\u{629} \u{627}\u{644}\u{645}\u{635}\u{62f}\u{631}. \u{635}\u{64f}\u{646}\u{641}\u{62a} \u{628}\u{627}\u{644}\u{623}\u{633}\u{627}\u{633} \u{643}\u{644}\u{63a}\u{629} \u{62a}\u{641}\u{633}\u{64a}\u{631}\u{64a}\u{629} \u{60c} \u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646} \u{645}\u{635}\u{645}\u{645}\u{629} \u{623}\u{635}\u{644}\u{627}\u{64b} \u{644}\u{644}\u{623}\u{62f}\u{627}\u{621} \u{628}\u{639}\u{636} \u{627}\u{644}\u{645}\u{647}\u{627}\u{645} \u{627}\u{644}\u{62e}\u{627}\u{635}\u{629} \u{623}\u{648} \u{627}\u{644}\u{645}\u{62d}\u{62f}\u{648}\u{62f}\u{629}. \u{625}\u{644}\u{627} \u{623}\u{646}\u{647} \u{64a}\u{645}\u{643}\u{646} \u{627}\u{633}\u{62a}\u{62e}\u{62f}\u{627}\u{645}\u{647}\u{627} \u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646} \u{644}\u{625}\u{646}\u{62c}\u{627}\u{632} \u{627}\u{644}\u{645}\u{634}\u{627}\u{631}\u{64a}\u{639} \u{627}\u{644}\u{636}\u{62e}\u{645}\u{647} \u{643}\u{623}\u{64a} \u{644}\u{63a}\u{629} \u{628}\u{631}\u{645}\u{62c}\u{64a}\u{629} \u{623}\u{62e}\u{631}\u{649}\u{60c}  \u{63a}\u{627}\u{644}\u{628}\u{627}\u{64b} \u{645}\u{627} \u{64a}\u{64f}\u{646}\u{635}\u{62d} \u{627}\u{644}\u{645}\u{628}\u{62a}\u{62f}\u{626}\u{64a}\u{646} \u{641}\u{64a} \u{645}\u{64a}\u{62f}\u{627}\u{646} \u{627}\u{644}\u{628}\u{631}\u{645}\u{62c}\u{629} \u{628}\u{62a}\u{639}\u{644}\u{645} \u{647}\u{630}\u{647} \u{627}\u{644}\u{644}\u{63a}\u{629} \u{644}\u{623}\u{646}\u{647}\u{627} \u{645}\u{646} \u{628}\u{64a}\u{646} \u{623}\u{633}\u{647}\u{644} \u{627}\u{644}\u{644}\u{63a}\u{627}\u{62a} \u{627}\u{644}\u{628}\u{631}\u{645}\u{62c}\u{64a}\u{629} \u{62a}\u{639}\u{644}\u{645}\u{627}\u{64b}.\n|\n||||||||||||||||||||||||||||||THIS SHOULD BE RTL|||||||||||||||||||||||||\n|\n");
    t.push_str("|(\u{646}\u{634}\u{623}\u{62a} \u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646} \u{641}\u{64a} \u{645}\u{631}\u{643}\u{632} CWI (\u{645}\u{631}\u{643}\u{632} \u{627}\u{644}\u{639}\u{644}\u{648}\u{645} \u{648}\u{627}\u{644}\u{62d}\u{627}\u{633}\u{628} \u{627}\u{644}\u{622}\u{644}\u{64a}) \u{628}\u{623}\u{645}\u{633}\u{62a}\u{631}\u{62f}\u{627}\u{645} \u{639}\u{644}\u{649} \u{64a}\u{62f} \u{62c}\u{648}\u{64a}\u{62f}\u{648} \u{641}\u{627}\u{646} \u{631}\u{64f}\u{632}\u{648}\u{645}. \u{62a}\u{645} \u{62a}\u{637}\u{648}\u{64a}\u{631}\u{647}\u{627} \u{628}\u{644}\u{63a}\u{629} C. \u{623}\u{637}\u{644}\u{642} \u{641}\u{627}\u{646} \u{631}\u{64f}\u{632}\u{648}\u{645} \u{627}\u{633}\u{645} \"\u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646}\" \u{639}\u{644}\u{649} \u{644}\u{63a}\u{62a}\u{647} \u{62a}\u{639}\u{628}\u{64a}\u{631}\u{64b}\u{627} \u{639}\u{646} \u{625}\u{639}\u{62c}\u{627}\u{628}\u{647} \u{628}\u{641}\u{650}\u{631}\u{642}\u{64e}\u{629} \u{645}\u{633}\u{631}\u{62d}\u{64a}\u{629} \u{647}\u{632}\u{644}\u{64a}\u{629} \u{634}\u{647}\u{64a}\u{631}\u{629} \u{645}\u{646} \u{628}\u{631}\u{64a}\u{637}\u{627}\u{646}\u{64a}\u{627}\u{60c} \u{643}\u{627}\u{646}\u{62a} \u{62a}\u{637}\u{644}\u{642} \u{639}\u{644}\u{649} \u{646}\u{641}\u{633}\u{647}\u{627} \u{627}\u{633}\u{645} \u{645}\u{648}\u{646}\u{62a}\u{64a} \u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646} Monty Python.\n|\n|\u{62a}\u{62a}\u{645}\u{64a}\u{632} \u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646} \u{628}\u{645}\u{62c}\u{62a}\u{645}\u{639}\u{647}\u{627} \u{627}\u{644}\u{646}\u{634}\u{637} \u{60c} \u{643}\u{645}\u{627} \u{623}\u{646} \u{644}\u{647}\u{627} \u{627}\u{644}\u{643}\u{62b}\u{64a}\u{631} \u{645}\u{646} \u{627}\u{644}\u{645}\u{643}\u{62a}\u{628}\u{627}\u{62a} \u{627}\u{644}\u{628}\u{631}\u{645}\u{62c}\u{64a}\u{629} \u{630}\u{627}\u{62a} \u{627}\u{644}\u{623}\u{63a}\u{631}\u{627}\u{636} \u{627}\u{644}\u{62e}\u{627}\u{635}\u{629} \u{648}\u{627}\u{644}\u{62a}\u{64a} \u{628}\u{631}\u{645}\u{62c}\u{647}\u{627} \u{623}\u{634}\u{62e}\u{627}\u{635} \u{645}\u{646} \u{645}\u{62c}\u{62a}\u{645}\u{639} \u{647}\u{630}\u{647} \u{627}\u{644}\u{644}\u{63a}\u{629} \u{60c} \u{645}\u{62b}\u{644}\u{627}\u{64b} \u{645}\u{643}\u{62a}\u{628}\u{629} PyGame \u{627}\u{644}\u{62a}\u{64a} \u{62a}\u{648}\u{641}\u{631} \u{645}\u{62c}\u{645}\u{648}\u{639}\u{647} \u{645}\u{646} \u{627}\u{644}\u{648}\u{638}\u{627}\u{626}\u{641} \u{645}\u{646} \u{627}\u{62c}\u{644} \u{628}\u{631}\u{645}\u{62c}\u{629} \u{627}\u{644}\u{627}\u{644}\u{639}\u{627}\u{628}. \u{648}\u{64a}\u{645}\u{643}\u{646} \u{644}\u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646} \u{627}\u{644}\u{62a}\u{639}\u{627}\u{645}\u{644} \u{645}\u{639} \u{627}\u{644}\u{639}\u{62f}\u{64a}\u{62f} \u{645}\u{646} \u{623}\u{646}\u{648}\u{627}\u{639} \u{642}\u{648}\u{627}\u{639}\u{62f} \u{627}\u{644}\u{628}\u{64a}\u{627}\u{646}\u{627}\u{62a} \u{645}\u{62b}\u{644} MySQL \u{648}\u{63a}\u{64a}\u{631}\u{647}.\n|\n|##\u{623}\u{645}\u{62b}\u{644}\u{629} \n|\u{645}\u{62b}\u{627}\u{644} Hello World!\n|\n|    print \"Hello World!\"\n|\n|\n|\u{645}\u{62b}\u{627}\u{644} \u{644}\u{627}\u{633}\u{62a}\u{62e}\u{631}\u{627}\u{62c} \u{627}\u{644}\u{645}\u{636}\u{631}\u{648}\u{628} Factorial :\n|\n|    num = 1\n|    x = raw_input('Insert the number please ')\n|    x = int(x)\n| \n|    if x > 69:\n|     print 'Math Error !'\n|    else:\n|     while x > 1:\n|      num *= x\n|      x = x-1\n| \n|     print num\n|\n|\n|\n|##\u{648}\u{635}\u{644}\u{627}\u{62a} \u{62e}\u{627}\u{631}\u{62c}\u{64a}\u{629} \n|* [\u{627}\u{644}\u{645}\u{648}\u{642}\u{639} \u{627}\u{644}\u{631}\u{633}\u{645}\u{64a} \u{644}\u{644}\u{63a}\u{629} \u{628}\u{627}\u{64a}\u{62b}\u{648}\u{646}](http://www.python.org)\n|\n| \u{628}\u{630}\u{631}\u{629} \u{62d}\u{627}\u{633} \n|\n|\n|**\u{41d}\u{435}\u{434}\u{432}\u{430}\u{440}\u{434} \u{ab}\u{41d}\u{435}\u{434}\u{bb} \u{424}\u{43b}\u{430}\u{43d}\u{434}\u{435}\u{440}\u{441}** (Nedward \u{ab}Ned\u{bb} Flanders) \u{2014} \u{432}\u{44b}\u{43c}\u{44b}\u{448}\u{43b}\u{435}\u{43d