// The files under data/, in path order. Each body is built by
// a run of functions, a few kilobytes of text apiece.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    let mut t0 = String.new();
    data_0_0(mut t0);
    data_0_1(mut t0);
    data_0_2(mut t0);
    data_0_3(mut t0);
    data_0_4(mut t0);
    v.push(DataFile { path: "jobs.txt".to_string(), body: t0 });
    let mut t1 = String.new();
    data_1_0(mut t1);
    v.push(DataFile { path: "site/api.md".to_string(), body: t1 });
    let mut t2 = String.new();
    data_2_0(mut t2);
    v.push(DataFile { path: "site/changelog.md".to_string(), body: t2 });
    let mut t3 = String.new();
    data_3_0(mut t3);
    v.push(DataFile { path: "site/configuration.md".to_string(), body: t3 });
    let mut t4 = String.new();
    data_4_0(mut t4);
    v.push(DataFile { path: "site/faq.md".to_string(), body: t4 });
    let mut t5 = String.new();
    data_5_0(mut t5);
    v.push(DataFile { path: "site/index.md".to_string(), body: t5 });
    let mut t6 = String.new();
    data_6_0(mut t6);
    v.push(DataFile { path: "site/install.md".to_string(), body: t6 });
    let mut t7 = String.new();
    data_7_0(mut t7);
    v.push(DataFile { path: "site/publishing.md".to_string(), body: t7 });
    v
}

