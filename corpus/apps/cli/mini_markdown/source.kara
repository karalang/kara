// unicodedata.normalize('NFKD', c) with the non-ASCII dropped, for
// every non-ASCII character that keeps something (Unicode 15.1.0).
fn nfkd_ascii() -> Map[i64, String] {
    let mut m: Map[i64, String] = Map.new();
    add_nfkd_0(mut m);
    add_nfkd_1(mut m);
    add_nfkd_2(mut m);
    add_nfkd_3(mut m);
    add_nfkd_4(mut m);
    add_nfkd_5(mut m);
    add_nfkd_6(mut m);
    add_nfkd_7(mut m);
    m
}

