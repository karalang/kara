// mini_markdown: Python-Markdown 3.11.2 (BSD-3-Clause), ported from the
// vendored markdown/ package: the block parser, the inline patterns and
// the delimiter processor for emphasis, the tree and postprocessors, the
// html.parser-based raw-HTML extractor, and the abbr, admonition,
// attr_list, codehilite (without Pygments), def_list, extra, fenced_code,
// footnotes, legacy_attrs, legacy_em, md_in_html, meta, nl2br,
// sane_lists, smarty, tables, toc and wikilinks extensions. It runs the
// library's own test cases (data/jobs.txt) and builds a small site.
//
// Regular expressions go through a port of CPython's sre (the mini_re
// app's engine) over code points; strings are UTF-8 with byte offsets.

// ============================================================ regex engine
// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn cp_lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum RNode {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[RNode]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[RNode]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[RNode]),
    Atomic(Vec[RNode]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[RNode]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[RNode], Vec[RNode]),
    Failure,
}

fn is_repeat(n: ref RNode) -> bool {
    match n {
        RNode.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref RNode) -> bool {
    match n {
        RNode.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[RNode]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            RNode.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            RNode.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            RNode.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            RNode.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            RNode.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            RNode.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            RNode.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            RNode.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            RNode.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            RNode.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[RNode, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(RNode.In(items, false));
    }
    match t.b {
        65 => return Ok(RNode.At(at_beginning_string())),
        98 => return Ok(RNode.At(at_boundary())),
        66 => return Ok(RNode.At(at_non_boundary())),
        90 => return Ok(RNode.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(RNode.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(RNode.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(RNode.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(RNode.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(RNode.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(RNode.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[RNode], ReErr] {
    let mut items: Vec[Vec[RNode]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[RNode] = Vec.new();
    out.push(RNode.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[RNode]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(RNode.NotLit(c));
            } else {
                out.push(RNode.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(RNode.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[RNode]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(RNode.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(RNode.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[RNode] = Vec.new();
    match last {
        RNode.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(RNode.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[RNode], ReErr] {
    let mut out: Vec[RNode] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(RNode.Any);
        } else if c == 94 {
            out.push(RNode.At(at_beginning()));
        } else if c == 36 {
            out.push(RNode.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(RNode.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[RNode]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(RNode.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(RNode.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(RNode.Assert(dir, true, p));
            } else {
                out.push(RNode.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[RNode] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(RNode.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(RNode.Atomic(p));
    } else {
        out.push(RNode.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[RNode],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[RNode], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                RNode.Lit(c) => {
                    let v = if icase { cp_lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                RNode.NotLit(c) => {
                    let v = if icase { cp_lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                RNode.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                RNode.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                RNode.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                RNode.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                RNode.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                RNode.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                RNode.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                RNode.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                RNode.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                RNode.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                RNode.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[RNode], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, s: ref Vec[i64], kind: i64, ascii: bool, pos: i64) -> bool {
        let n = s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(s[pos - 1], ascii);
        let after = pos < n and is_word(s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, s: ref Vec[i64], pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[r] + 1;
                    if not ((count >= max and max != maxrepeat()) or pos == self.lasts[r]) {
                        self.set_count(r, count);
                        self.set_last(r, pos);
                        pc = body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < s.len() and (if icase { cp_lower(s[pos], ascii) == c } else { s[pos] == c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < s.len() and (if icase { cp_lower(s[pos], ascii) != c } else { s[pos] != c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < s.len() and s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < s.len() and in_set(prog.sets[set], s[pos], icase, ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(s, kind, ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(slot, pos);
                        if (slot & 1) == 1 {
                            self.set_lastindex(slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = a;
                    }
                    Op.Jmp(a) => pc = a,
                    Op.RepInit(r, until) => {
                        self.set_count(r, -1);
                        self.set_last(r, -1);
                        pc = until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[r] + 1;
                        if count < min {
                            self.set_count(r, count);
                            pc = body;
                        } else if greedy {
                            if (count < max or max == maxrepeat()) and pos != self.lasts[r] {
                                choices.push(Choice { pc: exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(r, count);
                                self.set_last(r, pos);
                                pc = body;
                            } else {
                                pc = exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = s[a + k];
                                    let y = s[pos + k];
                                    let eq = if icase { cp_lower(x, ascii) == cp_lower(y, ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if width < 0 { pos } else { pos - width };
                        let found = from >= 0 and self.run(prog, s, sub, from, false) >= 0;
                        if negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = next;
                            }
                        } else if found {
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, s, sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == l,
            Item.Range(lo, hi) => c >= lo and c <= hi,
            Item.Cat(k) => {
                let kind = k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = cp_lower(c, ascii);
        if cp_lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and cp_lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, s: ref Vec[i64], from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, s, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}


// ======================================================== regex layer
// Python-Markdown's patterns run on the engine above, over code points.
// Text in this program is UTF-8 with byte offsets, so a search turns its
// subject into code points once (the last subject is kept) and turns the
// spans it finds back into byte offsets.

struct Rx {
    prog: Program,
    m: Matcher,
}

// A match, in byte offsets. A group that took no part is (-1, -1).
#[derive(Clone)]
struct M {
    start: i64,
    end: i64,
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

struct Re {
    rxs: Vec[Rx],
    ids: Map[String, i64],
    subj: String,
    cps: Vec[i64],
    // byte offset of each code point, then the length
    boff: Vec[i64],
    // code-point index of each byte offset
    cpi: Vec[i64],
    loaded: bool,
}

fn new_re() -> Re {
    Re {
        rxs: Vec.new(),
        ids: Map.new(),
        subj: String.new(),
        cps: Vec.new(),
        boff: Vec.new(),
        cpi: Vec.new(),
        loaded: false,
    }
}

fn utf8_len(c: i64) -> i64 {
    if c < 0x80 {
        1
    } else if c < 0x800 {
        2
    } else if c < 0x10000 {
        3
    } else {
        4
    }
}

impl Re {
    // The compiled pattern's id, compiling it the first time.
    fn id(mut ref self, pattern: Str, flags: i64) -> i64 {
        let key = f"{flags}:{pattern}";
        match self.ids.get(key.clone()) {
            Some(v) => return *v,
            None => {}
        }
        let cps = codepoints(pattern.bytes());
        let prog = match compile(cps, flags) {
            Ok(p) => p,
            Err(e) => panic(f"cannot compile {pattern}: {err_text(e)}"),
        };
        let m = new_matcher(prog);
        self.rxs.push(Rx { prog: prog, m: m });
        let id = self.rxs.len() - 1;
        self.ids.insert(key, id);
        id
    }

    fn load(mut ref self, s: ref String) {
        if self.loaded and self.subj.len() == s.len() and self.subj == *s {
            return;
        }
        self.subj = s.clone();
        self.cps = codepoints(s.bytes());
        self.boff.clear();
        self.cpi.clear();
        let mut b = 0;
        let mut k = 0;
        while k < self.cps.len() {
            self.boff.push(b);
            let w = utf8_len(self.cps[k]);
            let mut j = 0;
            while j < w {
                self.cpi.push(k);
                j += 1;
            }
            b += w;
            k += 1;
        }
        self.boff.push(b);
        self.cpi.push(k);
        self.loaded = true;
    }

    fn to_m(ref self, f: ref Found) -> M {
        let mut spans: Vec[(i64, i64)] = Vec.new();
        for sp in f.spans.iter() {
            let (a, b) = *sp;
            if a < 0 {
                spans.push((-1, -1));
            } else {
                spans.push((self.boff[a], self.boff[b]));
            }
        }
        M { start: self.boff[f.start], end: self.boff[f.end], spans: spans, lastindex: f.lastindex }
    }

    fn cp_at(ref self, byte: i64) -> i64 {
        if byte <= 0 {
            return 0;
        }
        if byte >= self.cpi.len() {
            return self.cps.len();
        }
        self.cpi[byte]
    }

    // mode 0 search, 1 match, 2 fullmatch, from byte offset `pos`.
    fn run(mut ref self, id: i64, s: ref String, pos: i64, must_advance: bool, mode: i64) -> Option[M] {
        self.load(s);
        let from = self.cp_at(pos);
        let rx = mut ref self.rxs[id];
        let found = find(mut rx.m, rx.prog, self.cps, from, must_advance, mode);
        match found {
            Some(f) => Some(self.to_m(f)),
            None => None,
        }
    }

    fn search(mut ref self, id: i64, s: ref String, pos: i64) -> Option[M] {
        self.run(id, s, pos, false, 0)
    }

    fn match_at(mut ref self, id: i64, s: ref String, pos: i64) -> Option[M] {
        self.run(id, s, pos, false, 1)
    }

    // finditer from byte offset `pos`.
    fn find_all(mut ref self, id: i64, s: ref String, pos: i64) -> Vec[M] {
        let mut out: Vec[M] = Vec.new();
        let mut at = pos;
        let mut must_advance = false;
        while at <= s.len() {
            match self.run(id, s, at, must_advance, 0) {
                Some(m) => {
                    must_advance = m.end == m.start;
                    at = m.end;
                    out.push(m);
                }
                None => break,
            }
        }
        out
    }

    // re.sub with a fixed replacement that has no group references.
    fn sub(mut ref self, id: i64, s: ref String, repl: Str) -> String {
        let ms = self.find_all(id, s, 0);
        if ms.len() == 0 {
            return s.clone();
        }
        let mut out = String.new();
        let mut last = 0;
        for m in ms.iter() {
            out.push_str(s[last..m.start]);
            out.push_str(repl);
            last = m.end;
        }
        out.push_str(s[last..s.len()]);
        out
    }

    fn sub_count(mut ref self, id: i64, s: ref String, repl: Str, count: i64) -> String {
        let ms = self.find_all(id, s, 0);
        let mut out = String.new();
        let mut last = 0;
        let mut n = 0;
        for m in ms.iter() {
            if count > 0 and n >= count {
                break;
            }
            out.push_str(s[last..m.start]);
            out.push_str(repl);
            last = m.end;
            n += 1;
        }
        out.push_str(s[last..s.len()]);
        out
    }
}

fn has(m: ref M, g: i64) -> bool {
    m.spans[g - 1].0 >= 0
}

// Group g's text, or "" when it took no part (group 0 is the match).
fn grp(s: ref String, m: ref M, g: i64) -> String {
    if g == 0 {
        return s[m.start..m.end].to_string();
    }
    let (a, b) = m.spans[g - 1];
    if a < 0 {
        return String.new();
    }
    s[a..b].to_string()
}

fn gstart(m: ref M, g: i64) -> i64 {
    if g == 0 { m.start } else { m.spans[g - 1].0 }
}

fn gend(m: ref M, g: i64) -> i64 {
    if g == 0 { m.end } else { m.spans[g - 1].1 }
}

// re.escape: Python 3.7's set of special characters.
fn re_escape(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if "()[]{}?*+-|^$\\.&~# \t\n\r\u{b}\u{c}".contains(c.to_string()) {
            out.push('\\');
        }
        out.push(c);
    }
    out
}

// ===================================================== Python strings
// str methods as Python has them, over byte offsets. Slices clamp as
// Python's do, and a cut that would fall inside a character moves to the
// character's end.

fn is_cont(b: u8) -> bool {
    (b as i64 & 0xC0) == 0x80
}

fn boundary(s: ref String, i: i64) -> i64 {
    let n = s.len();
    if i <= 0 {
        return 0;
    }
    if i >= n {
        return n;
    }
    let bs = s.bytes();
    let mut k = i;
    while k < n and is_cont(bs[k]) {
        k += 1;
    }
    k
}

// s[a:b] with Python's clamping, for 0 <= a, b.
fn sl(s: ref String, a: i64, b: i64) -> String {
    let lo = boundary(s, a);
    let hi = boundary(s, b);
    if hi <= lo {
        return String.new();
    }
    s[lo..hi].to_string()
}

fn after(s: ref String, a: i64) -> String {
    sl(s, a, s.len())
}

fn upto(s: ref String, b: i64) -> String {
    sl(s, 0, b)
}

fn is_py_space(c: char) -> bool {
    is_space(c as i64, false)
}

fn lstrip_ws(s: ref String) -> String {
    let mut k = 0;
    for c in s.chars() {
        if not is_py_space(c) {
            break;
        }
        k += utf8_len(c as i64);
    }
    after(s, k)
}

fn rstrip_ws(s: ref String) -> String {
    let mut k = s.len();
    for c in s.chars().rev() {
        if not is_py_space(c) {
            break;
        }
        k -= utf8_len(c as i64);
    }
    upto(s, k)
}

fn strip_ws(s: ref String) -> String {
    rstrip_ws(lstrip_ws(s))
}

fn is_blank(s: ref String) -> bool {
    for c in s.chars() {
        if not is_py_space(c) {
            return false;
        }
    }
    true
}

// strip(chars) for an ASCII set.
fn in_set_b(set: Str, b: u8) -> bool {
    for x in set.bytes().iter() {
        if *x == b {
            return true;
        }
    }
    false
}

fn lstrip_set(s: ref String, set: Str) -> String {
    let bs = s.bytes();
    let mut k = 0;
    while k < bs.len() and in_set_b(set, bs[k]) {
        k += 1;
    }
    after(s, k)
}

fn rstrip_set(s: ref String, set: Str) -> String {
    let bs = s.bytes();
    let mut k = bs.len();
    while k > 0 and in_set_b(set, bs[k - 1]) {
        k -= 1;
    }
    upto(s, k)
}

fn strip_set(s: ref String, set: Str) -> String {
    rstrip_set(lstrip_set(s, set), set)
}

fn find_from(s: ref String, pat: Str, from_i: i64) -> i64 {
    let a = boundary(s, from_i);
    if a > s.len() {
        return -1;
    }
    match s[a..s.len()].find(pat) {
        Some(k) => a + k,
        None => -1,
    }
}

fn find_s(s: ref String, pat: Str) -> i64 {
    match s.find(pat) {
        Some(k) => k,
        None => -1,
    }
}

fn rfind_s(s: ref String, pat: Str) -> i64 {
    match s.rfind(pat) {
        Some(k) => k,
        None => -1,
    }
}

fn split_on(s: ref String, sep: Str) -> Vec[String] {
    s.split(sep).map(|p| p.to_string()).collect()
}

// str.split() with no separator.
fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut in_word = false;
    for c in s.chars() {
        if is_py_space(c) {
            if in_word {
                out.push(cur.clone());
                cur.clear();
                in_word = false;
            }
        } else {
            cur.push(c);
            in_word = true;
        }
    }
    if in_word {
        out.push(cur);
    }
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for p in parts.iter() {
        if not first {
            out.push_str(sep);
        }
        out.push_str(p);
        first = false;
    }
    out
}

fn repeat(s: Str, n: i64) -> String {
    let mut out = String.new();
    let mut k = 0;
    while k < n {
        out.push_str(s);
        k += 1;
    }
    out
}

fn spaces(n: i64) -> String {
    repeat(" ", n)
}

fn char_count(s: ref String) -> i64 {
    let mut n = 0;
    for b in s.bytes().iter() {
        if not is_cont(*b) {
            n += 1;
        }
    }
    n
}

fn count_s(s: ref String, pat: Str) -> i64 {
    let mut n = 0;
    let mut at = 0;
    loop {
        let k = find_from(s, pat, at);
        if k < 0 {
            break;
        }
        n += 1;
        at = k + pat.len();
    }
    n
}

fn lower(s: ref String) -> String {
    s.to_lowercase()
}

fn pad4(n: i64) -> String {
    let t = f"{n}";
    if t.len() >= 4 {
        return t;
    }
    repeat("0", 4 - t.len()) + t
}

// str.expandtabs(tabsize).
fn expandtabs(s: ref String, size: i64) -> String {
    let mut out = String.new();
    let mut col = 0;
    for c in s.chars() {
        if c == '\t' {
            let n = size - col % size;
            out.push_str(spaces(n));
            col += n;
        } else if c == '\n' or c == '\r' {
            out.push(c);
            col = 0;
        } else {
            out.push(c);
            col += 1;
        }
    }
    out
}

fn first_char(s: ref String) -> Option[char] {
    s.chars().next()
}

fn last_char(s: ref String) -> Option[char] {
    s.chars().rev().next()
}

fn parse_int(s: ref String) -> i64 {
    let t = strip_ws(s);
    let mut neg = false;
    let mut v = 0;
    let mut k = 0;
    for c in t.chars() {
        if k == 0 and (c == '-' or c == '+') {
            neg = c == '-';
        } else if c >= '0' and c <= '9' {
            v = v * 10 + (c as i64 - 48);
        }
        k += 1;
    }
    if neg { -v } else { v }
}

// Python's repr of a str.
fn py_repr(s: ref String) -> String {
    repr_of(codepoints(s.bytes()))
}

fn opt_text(o: ref Option[String]) -> String {
    match o {
        Some(t) => t.clone(),
        None => String.new(),
    }
}

fn truthy(o: ref Option[String]) -> bool {
    match o {
        Some(t) => t.len() > 0,
        None => false,
    }
}

// str.capitalize for the ASCII first letter Python-Markdown passes it.
fn capitalize(s: ref String) -> String {
    let mut out = String.new();
    let mut first = true;
    for c in s.chars() {
        if first {
            out.push_str(c.to_string().to_uppercase());
            first = false;
        } else {
            out.push_str(c.to_string().to_lowercase());
        }
    }
    out
}

// The text '{}' stands for in a str.format with one argument.
fn format1(fmt: ref String, arg: ref String) -> String {
    let mut out = String.new();
    let cs: Vec[char] = fmt.chars().collect();
    let mut k = 0;
    while k < cs.len() {
        let c = cs[k];
        if c == '{' and k + 1 < cs.len() and cs[k + 1] == '{' {
            out.push('{');
            k += 2;
        } else if c == '}' and k + 1 < cs.len() and cs[k + 1] == '}' {
            out.push('}');
            k += 2;
        } else if c == '{' and k + 1 < cs.len() and cs[k + 1] == '}' {
            out.push_str(arg);
            k += 2;
        } else if c == '{' and k + 2 < cs.len() and cs[k + 1] == '0' and cs[k + 2] == '}' {
            out.push_str(arg);
            k += 3;
        } else {
            out.push(c);
            k += 1;
        }
    }
    out
}

// ===================================================== element tree
// ElementTree's Element, as an arena: an element is an index into
// `Tree.nodes`. There are no parent links, because Python-Markdown puts
// one element under two parents (the table of contents at two markers)
// and asks for parents only through maps it builds itself. Text and tail
// carry whether they are an AtomicString, which inline processing leaves
// alone; assigning a plain value clears the mark, as Python's str
// concatenation does.

struct Node {
    tag: String,
    text: Option[String],
    text_atomic: bool,
    tail: Option[String],
    tail_atomic: bool,
    attrs: Vec[(String, String)],
    kids: Vec[i64],
}

struct Tree {
    nodes: Vec[Node],
}

impl Tree {
    fn el(mut ref self, tag: Str) -> i64 {
        self.nodes.push(Node {
            tag: tag.to_string(),
            text: None,
            text_atomic: false,
            tail: None,
            tail_atomic: false,
            attrs: Vec.new(),
            kids: Vec.new(),
        });
        self.nodes.len() - 1
    }

    fn sub(mut ref self, parent: i64, tag: Str) -> i64 {
        let id = self.el(tag);
        self.nodes[parent].kids.push(id);
        id
    }

    fn tag(ref self, id: i64) -> String {
        self.nodes[id].tag.clone()
    }

    fn is(ref self, id: i64, tag: Str) -> bool {
        self.nodes[id].tag == tag
    }

    fn len(ref self, id: i64) -> i64 {
        self.nodes[id].kids.len()
    }

    fn kid(ref self, id: i64, k: i64) -> i64 {
        self.nodes[id].kids[k]
    }

    fn kids(ref self, id: i64) -> Vec[i64] {
        self.nodes[id].kids.clone()
    }

    fn last(ref self, id: i64) -> i64 {
        let n = self.nodes[id].kids.len();
        if n == 0 { -1 } else { self.nodes[id].kids[n - 1] }
    }

    fn text(ref self, id: i64) -> Option[String] {
        self.nodes[id].text.clone()
    }

    fn tail(ref self, id: i64) -> Option[String] {
        self.nodes[id].tail.clone()
    }

    fn text_s(ref self, id: i64) -> String {
        opt_text(self.nodes[id].text)
    }

    fn tail_s(ref self, id: i64) -> String {
        opt_text(self.nodes[id].tail)
    }

    fn has_text(ref self, id: i64) -> bool {
        truthy(self.nodes[id].text)
    }

    fn has_tail(ref self, id: i64) -> bool {
        truthy(self.nodes[id].tail)
    }

    // Python's `el.text is None` / `el.tail is None`.
    fn text_none(ref self, id: i64) -> bool {
        self.nodes[id].text.is_none()
    }

    fn tail_none(ref self, id: i64) -> bool {
        self.nodes[id].tail.is_none()
    }

    fn set_text(mut ref self, id: i64, t: own String) {
        self.nodes[id].text = Some(t);
        self.nodes[id].text_atomic = false;
    }

    fn set_text_atomic(mut ref self, id: i64, t: own String) {
        self.nodes[id].text = Some(t);
        self.nodes[id].text_atomic = true;
    }

    fn set_text_opt(mut ref self, id: i64, t: own Option[String], atomic: bool) {
        self.nodes[id].text = t;
        self.nodes[id].text_atomic = atomic;
    }

    fn clear_text(mut ref self, id: i64) {
        self.nodes[id].text = None;
        self.nodes[id].text_atomic = false;
    }

    fn set_tail(mut ref self, id: i64, t: own String) {
        self.nodes[id].tail = Some(t);
        self.nodes[id].tail_atomic = false;
    }

    fn set_tail_atomic(mut ref self, id: i64, t: own String) {
        self.nodes[id].tail = Some(t);
        self.nodes[id].tail_atomic = true;
    }

    fn set_tail_opt(mut ref self, id: i64, t: own Option[String], atomic: bool) {
        self.nodes[id].tail = t;
        self.nodes[id].tail_atomic = atomic;
    }

    fn clear_tail(mut ref self, id: i64) {
        self.nodes[id].tail = None;
        self.nodes[id].tail_atomic = false;
    }

    fn get(ref self, id: i64, key: Str) -> Option[String] {
        for kv in self.nodes[id].attrs.iter() {
            if kv.0 == key {
                return Some(kv.1.clone());
            }
        }
        None
    }

    fn get_or(ref self, id: i64, key: Str, d: Str) -> String {
        match self.get(id, key) {
            Some(v) => v,
            None => d.to_string(),
        }
    }

    fn has_attr(ref self, id: i64, key: Str) -> bool {
        for kv in self.nodes[id].attrs.iter() {
            if kv.0 == key {
                return true;
            }
        }
        false
    }

    fn set(mut ref self, id: i64, key: Str, val: own String) {
        let mut k = 0;
        while k < self.nodes[id].attrs.len() {
            if self.nodes[id].attrs[k].0 == key {
                self.nodes[id].attrs[k] = (key.to_string(), val);
                return;
            }
            k += 1;
        }
        self.nodes[id].attrs.push((key.to_string(), val));
    }

    fn del(mut ref self, id: i64, key: Str) -> Option[String] {
        let mut k = 0;
        while k < self.nodes[id].attrs.len() {
            if self.nodes[id].attrs[k].0 == key {
                let (_, v) = self.nodes[id].attrs.remove(k);
                return Some(v);
            }
            k += 1;
        }
        None
    }

    fn append(mut ref self, parent: i64, child: i64) {
        self.nodes[parent].kids.push(child);
    }

    // list.insert: an index past the end appends.
    fn insert(mut ref self, parent: i64, at: i64, child: i64) {
        let n = self.nodes[parent].kids.len();
        let k = if at > n { n } else if at < 0 { if n + at < 0 { 0 } else { n + at } } else { at };
        self.nodes[parent].kids.insert(k, child);
    }

    fn index_of(ref self, parent: i64, child: i64) -> i64 {
        let mut k = 0;
        while k < self.nodes[parent].kids.len() {
            if self.nodes[parent].kids[k] == child {
                return k;
            }
            k += 1;
        }
        -1
    }

    fn remove(mut ref self, parent: i64, child: i64) {
        let k = self.index_of(parent, child);
        if k >= 0 {
            self.nodes[parent].kids.remove(k);
        }
    }

    // Element.clear: no text, tail, attributes or children.
    fn clear(mut ref self, id: i64) {
        self.nodes[id].text = None;
        self.nodes[id].text_atomic = false;
        self.nodes[id].tail = None;
        self.nodes[id].tail_atomic = false;
        self.nodes[id].attrs.clear();
        self.nodes[id].kids.clear();
    }

    // Element.iter(): the element and its descendants, in document order.
    fn iter(ref self, root: i64) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        self.walk(root, mut out);
        out
    }

    fn walk(ref self, id: i64, out: mut ref Vec[i64]) {
        out.push(id);
        for k in self.nodes[id].kids.iter() {
            self.walk(*k, mut out);
        }
    }

    fn iter_tag(ref self, root: i64, tag: Str) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for id in self.iter(root).iter() {
            if self.nodes[*id].tag == tag {
                out.push(*id);
            }
        }
        out
    }

    fn itertext(ref self, id: i64) -> String {
        let mut out = String.new();
        self.itertext_into(id, mut out);
        out
    }

    fn itertext_into(ref self, id: i64, out: mut ref String) {
        match self.nodes[id].text {
            Some(t) => out.push_str(t),
            None => {}
        }
        for k in self.nodes[id].kids.iter() {
            self.itertext_into(*k, mut out);
            match self.nodes[*k].tail {
                Some(t) => out.push_str(t),
                None => {}
            }
        }
    }

    // copy.deepcopy of an element; a child seen twice is copied once.
    fn deepcopy(mut ref self, id: i64) -> i64 {
        let mut memo: Map[i64, i64] = Map.new();
        self.copy_into(id, mut memo)
    }

    fn copy_into(mut ref self, id: i64, memo: mut ref Map[i64, i64]) -> i64 {
        match memo.get(id) {
            Some(v) => return *v,
            None => {}
        }
        let n = Node {
            tag: self.nodes[id].tag.clone(),
            text: self.nodes[id].text.clone(),
            text_atomic: self.nodes[id].text_atomic,
            tail: self.nodes[id].tail.clone(),
            tail_atomic: self.nodes[id].tail_atomic,
            attrs: self.nodes[id].attrs.clone(),
            kids: Vec.new(),
        };
        self.nodes.push(n);
        let c = self.nodes.len() - 1;
        memo.insert(id, c);
        let kids = self.nodes[id].kids.clone();
        for k in kids.iter() {
            let ck = self.copy_into(*k, mut memo);
            self.nodes[c].kids.push(ck);
        }
        c
    }
}

// --------------------------------------------------------- serializer

fn html_empty(tag: ref String) -> bool {
    let t = lower(tag);
    t == "area" or t == "base" or t == "basefont" or t == "br" or t == "col" or t == "embed" or t == "frame" or t == "hr" or t == "img" or t == "input" or t == "isindex" or t == "link" or t == "meta" or t == "param" or t == "plaintext" or t == "source" or t == "track" or t == "wbr"
}

fn is_alnum_b(b: u8) -> bool {
    let c = b as i64;
    (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_digit_b(b: u8) -> bool {
    let c = b as i64;
    c >= 48 and c <= 57
}

fn is_hex_b(b: u8) -> bool {
    let c = b as i64;
    is_digit_b(b) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

// Whether the '&' at bs[i] starts what RE_AMP's lookahead calls an
// entity: &#digits; &#xhex; or &name; (any case).
fn amp_is_entity(bs: ref Slice[u8], i: i64) -> bool {
    let n = bs.len();
    let mut k = i + 1;
    if k < n and bs[k] == b'#' {
        let mut j = k + 1;
        while j < n and is_digit_b(bs[j]) {
            j += 1;
        }
        if j > k + 1 and j < n and bs[j] == b';' {
            return true;
        }
        if k + 1 < n and (bs[k + 1] == b'x' or bs[k + 1] == b'X') {
            j = k + 2;
            while j < n and is_hex_b(bs[j]) {
                j += 1;
            }
            if j > k + 2 and j < n and bs[j] == b';' {
                return true;
            }
        }
        return false;
    }
    while k < n and is_alnum_b(bs[k]) {
        k += 1;
    }
    k > i + 1 and k < n and bs[k] == b';'
}

fn escape_into(s: ref String, attr: bool, newline: bool, out: mut ref String) {
    let bs = s.bytes();
    let mut last = 0;
    let mut k = 0;
    while k < bs.len() {
        let b = bs[k];
        let rep = if b == b'&' {
            if amp_is_entity(bs, k) { "" } else { "&amp;" }
        } else if b == b'<' {
            "&lt;"
        } else if b == b'>' {
            "&gt;"
        } else if attr and b == b'"' {
            "&quot;"
        } else if newline and b == b'\n' {
            "&#10;"
        } else {
            ""
        };
        if rep.len() > 0 {
            out.push_str(s[last..k]);
            out.push_str(rep);
            last = k + 1;
        }
        k += 1;
    }
    out.push_str(s[last..bs.len()]);
}

fn escape_cdata(s: ref String) -> String {
    let mut out = String.new();
    escape_into(s, false, false, mut out);
    out
}

fn escape_attrib_html(s: ref String) -> String {
    let mut out = String.new();
    escape_into(s, true, false, mut out);
    out
}

fn sorted_attrs(attrs: ref Vec[(String, String)]) -> Vec[(String, String)] {
    let mut v = attrs.clone();
    v.sort_by(|a, b| {
        if a.0 < b.0 {
            Ordering.Less
        } else if a.0 > b.0 {
            Ordering.Greater
        } else if a.1 < b.1 {
            Ordering.Less
        } else if a.1 > b.1 {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    });
    v
}

fn serialize_into(t: ref Tree, id: i64, xhtml: bool, out: mut ref String) {
    let n = ref t.nodes[id];
    out.push('<');
    out.push_str(n.tag);
    for kv in sorted_attrs(n.attrs).iter() {
        let v = escape_attrib_html(kv.1);
        if kv.0 == v and not xhtml {
            out.push(' ');
            out.push_str(v);
        } else {
            out.push(' ');
            out.push_str(kv.0);
            out.push_str("=\"");
            out.push_str(v);
            out.push('"');
        }
    }
    let empty = html_empty(n.tag);
    if xhtml and empty {
        out.push_str(" />");
    } else {
        out.push('>');
        match n.text {
            Some(text) => {
                if text.len() > 0 {
                    let tl = lower(n.tag);
                    if tl == "script" or tl == "style" {
                        out.push_str(text);
                    } else {
                        escape_into(text, false, false, mut out);
                    }
                }
            }
            None => {}
        }
        for k in n.kids.iter() {
            serialize_into(t, *k, xhtml, mut out);
        }
        if not empty {
            out.push_str("</");
            out.push_str(n.tag);
            out.push('>');
        }
    }
    match n.tail {
        Some(tail) => {
            if tail.len() > 0 {
                escape_into(tail, false, false, mut out);
            }
        }
        None => {}
    }
}

fn serialize(t: ref Tree, id: i64, xhtml: bool) -> String {
    let mut out = String.new();
    serialize_into(t, id, xhtml, mut out);
    out
}

// ElementTree's own tostring(method='html') for an empty element:
// attributes in order, & > and " escaped, and no closing tag.
fn et_tostring_empty(tag: ref String, attrs: ref Vec[(String, String)]) -> String {
    let mut out = f"<{tag}";
    for kv in attrs.iter() {
        let v = kv.1.replace("&", "&amp;").replace(">", "&gt;").replace("\"", "&quot;");
        out.push_str(f" {kv.0}=\"{v}\"");
    }
    out.push('>');
    if not html_empty(tag) {
        out.push_str(f"</{tag}>");
    }
    out
}

// ========================================================= html.parser
// Python 3.13.16's html.parser.HTMLParser with convert_charrefs off, as
// markdown/htmlparser.py patches it (its own starttagopen, endtagopen,
// piclose, entityref and locatetagend, and the _HTMLParser fixes for
// "</>" and "</" before a non-letter), then HTMLExtractor on top, and
// md_in_html's HTMLExtractorExtra when `extra` is set. Where Python calls
// self.method, the methods here dispatch on `extra`; a super() call goes
// to the base_ function.
//
// Positions are byte offsets. The parser's column (`offset`) is kept in
// characters as well, because HTMLExtractor compares it with 3.

const CDATA_TAGS: Str = " script style xmp iframe noembed noframes ";

struct Hp {
    extra: bool,
    rawdata: String,
    lineno: i64,
    offset: i64,
    offset_b: i64,
    lasttag: String,
    // -1 for interesting_normal, else a compiled pattern
    interesting: i64,
    cdata_elem: Option[String],
    support_cdata: bool,
    escapable: bool,
    starttag_text: Option[String],
    inraw: bool,
    intail: bool,
    stack: Vec[String],
    inline_stack: Vec[String],
    cache: Vec[String],
    cleandoc: Vec[String],
    lineno_start_cache: Vec[i64],
    mdstack: Vec[String],
    // "" stands for None
    mdstate: Vec[String],
    mdstarted: Vec[bool],
    tb_stack: Vec[i64],
    tb_data: Vec[String],
    tb_last: i64,
    tb_tail: bool,
    tb_root: i64,
}

// An attribute value of None (an attribute with no '=').
struct Attr {
    name: String,
    value: Option[String],
}

fn new_hp(extra: bool) -> Hp {
    Hp {
        extra: extra,
        rawdata: String.new(),
        lineno: 1,
        offset: 0,
        offset_b: 0,
        lasttag: "???".to_string(),
        interesting: -1,
        cdata_elem: None,
        support_cdata: true,
        escapable: true,
        starttag_text: None,
        inraw: false,
        intail: false,
        stack: Vec.new(),
        inline_stack: Vec.new(),
        cache: Vec.new(),
        cleandoc: Vec.new(),
        lineno_start_cache: vec![0],
        mdstack: Vec.new(),
        mdstate: Vec.new(),
        mdstarted: Vec.new(),
        tb_stack: Vec.new(),
        tb_data: Vec.new(),
        tb_last: -1,
        tb_tail: false,
        tb_root: -1,
    }
}

fn in_words(words: Str, w: ref String) -> bool {
    words.contains(f" {w} ")
}

fn has_s(v: ref Vec[String], s: ref String) -> bool {
    for x in v.iter() {
        if *x == *s {
            return true;
        }
    }
    false
}

fn starts_at(s: ref String, pat: Str, i: i64) -> bool {
    if i < 0 or i + pat.len() > s.len() {
        return false;
    }
    let bs = s.bytes();
    let ps = pat.bytes();
    let mut k = 0;
    while k < ps.len() {
        if bs[i + k] != ps[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn byte_at(s: ref String, i: i64) -> i64 {
    if i < 0 or i >= s.len() {
        return -1;
    }
    s.bytes()[i] as i64
}

fn is_letter_b(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

// The start of the character that ends at byte k.
fn prev_char_start(s: ref String, k: i64) -> i64 {
    let bs = s.bytes();
    let mut j = k - 1;
    while j > 0 and is_cont(bs[j]) {
        j -= 1;
    }
    j
}

// blank_line_re.match(s[pos:]): two lines of nothing but spaces.
fn blank_line_at(s: ref String, pos: i64) -> bool {
    let bs = s.bytes();
    let n = bs.len();
    let mut k = if pos < 0 { 0 } else { pos };
    let mut lines = 0;
    while lines < 2 {
        while k < n and bs[k] == b' ' {
            k += 1;
        }
        if k < n and bs[k] == b'\n' {
            k += 1;
            lines += 1;
        } else {
            return false;
        }
    }
    true
}

// inner_blank_line_re.search(s): the first "\n[ \t]*\n", as its span.
fn inner_blank(s: ref String) -> (i64, i64) {
    let bs = s.bytes();
    let n = bs.len();
    let mut i = 0;
    while i < n {
        if bs[i] == b'\n' {
            let mut k = i + 1;
            while k < n and (bs[k] == b' ' or bs[k] == b'\t') {
                k += 1;
            }
            if k < n and bs[k] == b'\n' {
                return (i, k + 1);
            }
        }
        i += 1;
    }
    (-1, -1)
}

fn has_inner_blank(s: ref String) -> bool {
    inner_blank(s).0 >= 0
}

fn feed_html(p: mut ref Hp, md: mut ref Md, data: ref String) {
    p.rawdata.push_str(data);
    goahead(mut p, mut md, false);
}

fn close_html(p: mut ref Hp, md: mut ref Md) {
    goahead(mut p, mut md, true);
    if p.rawdata.len() > 0 {
        let rest = p.rawdata.clone();
        handle_data(mut p, mut md, rest);
    }
    if p.cache.len() > 0 {
        let joined = join(p.cache, "");
        let ph = store_html(mut md, joined);
        p.cleandoc.push(ph);
        p.cache.clear();
    }
    if p.extra and p.mdstack.len() > 0 {
        let tag = p.mdstack[0].clone();
        handle_endtag(mut p, mut md, tag);
    }
}

fn updatepos(p: mut ref Hp, i: i64, j: i64) -> i64 {
    if i >= j {
        return j;
    }
    let piece = sl(p.rawdata, i, j);
    let nlines = count_s(piece, "\n");
    if nlines > 0 {
        p.lineno += nlines;
        let pos = i + rfind_s(piece, "\n");
        p.offset_b = j - (pos + 1);
        p.offset = char_count(sl(p.rawdata, pos + 1, j));
    } else {
        p.offset_b += j - i;
        p.offset += char_count(piece);
    }
    j
}

fn line_offset(p: mut ref Hp) -> i64 {
    let mut ii = p.lineno_start_cache.len() - 1;
    while ii < p.lineno - 1 {
        let last = p.lineno_start_cache[ii];
        let mut lf = find_from(p.rawdata, "\n", last);
        if lf == -1 {
            lf = p.rawdata.len();
        }
        p.lineno_start_cache.push(lf + 1);
        ii += 1;
    }
    p.lineno_start_cache[p.lineno - 1]
}

fn here(p: mut ref Hp) -> i64 {
    line_offset(mut p) + p.offset_b
}

fn at_line_start(p: mut ref Hp) -> bool {
    if p.offset == 0 {
        return true;
    }
    if p.offset > 3 {
        return false;
    }
    let lo = line_offset(mut p);
    is_blank(sl(p.rawdata, lo, lo + p.offset_b))
}

fn get_endtag_text(p: mut ref Hp, tag: ref String) -> String {
    let start = here(mut p);
    let k = find_from(p.rawdata, ">", start);
    if k >= 0 {
        return sl(p.rawdata, start, k + 1);
    }
    f"</{tag}>"
}

fn set_cdata_mode(p: mut ref Hp, md: mut ref Md, elem: ref String) {
    let e = lower(elem);
    p.cdata_elem = Some(e.clone());
    p.escapable = false;
    if e == "plaintext" {
        p.interesting = md.re.id("\\Z", 32);
    } else {
        let pat = f"</{e}(?=[\\t\\n\\r\\f />])";
        p.interesting = md.re.id(pat, 2 | 256);
    }
}

fn clear_cdata_mode(p: mut ref Hp) {
    p.interesting = -1;
    p.cdata_elem = None;
    p.escapable = true;
}

fn goahead(p: mut ref Hp, md: mut ref Md, end: bool) {
    let rawdata = p.rawdata.clone();
    let mut i = 0;
    let n = rawdata.len();
    let bs = rawdata.bytes();
    while i < n {
        let mut j = n;
        if p.interesting < 0 {
            let mut k = i;
            while k < n and bs[k] != b'&' and bs[k] != b'<' {
                k += 1;
            }
            j = k;
        } else {
            match md.re.search(p.interesting, rawdata, i) {
                Some(m) => j = m.start,
                None => {
                    if p.cdata_elem.is_some() {
                        break;
                    }
                    j = n;
                }
            }
        }
        if i < j {
            handle_data(mut p, mut md, sl(rawdata, i, j));
        }
        i = updatepos(mut p, i, j);
        if i == n {
            break;
        }
        if bs[i] == b'<' {
            let mut k = 0;
            let sto = md.re.id(P_HP_STARTTAGOPEN, F_HP_STARTTAGOPEN);
            if md.re.match_at(sto, rawdata, i).is_some() {
                k = parse_starttag(mut p, mut md, i);
            } else if starts_at(rawdata, "</", i) {
                k = parse_endtag(mut p, mut md, i);
            } else if starts_at(rawdata, "<!--", i) {
                k = parse_comment(mut p, mut md, i);
            } else if starts_at(rawdata, "<?", i) {
                k = parse_pi(mut p, mut md, i);
            } else if starts_at(rawdata, "<!", i) {
                k = parse_html_declaration(mut p, mut md, i);
            } else if i + 1 < n or end {
                handle_data(mut p, mut md, "<".to_string());
                k = i + 1;
            } else {
                break;
            }
            if k < 0 {
                if not end {
                    break;
                }
                if md.re.match_at(sto, rawdata, i).is_some() {
                    // nothing
                } else if starts_at(rawdata, "</", i) {
                    let eto = md.re.id(P_HP_ENDTAGOPEN, F_HP_ENDTAGOPEN);
                    if i + 2 == n {
                        handle_data(mut p, mut md, "</".to_string());
                    } else if md.re.match_at(eto, rawdata, i).is_some() {
                        // nothing
                    } else {
                        handle_comment(mut p, mut md, after(rawdata, i + 2));
                    }
                } else if starts_at(rawdata, "<!--", i) {
                    let mut jj = n;
                    for suffix in ["--!", "--", "-"] {
                        if n - (i + 4) >= suffix.len() and rawdata.ends_with(suffix) {
                            jj -= suffix.len();
                            break;
                        }
                    }
                    handle_comment(mut p, mut md, sl(rawdata, i + 4, jj));
                } else if starts_at(rawdata, "<![CDATA[", i) and p.support_cdata {
                    unknown_decl(mut p, mut md, after(rawdata, i + 3));
                } else if lower(sl(rawdata, i, i + 9)) == "<!doctype" {
                    handle_decl(mut p, mut md, after(rawdata, i + 2));
                } else if starts_at(rawdata, "<!", i) {
                    handle_comment(mut p, mut md, after(rawdata, i + 2));
                } else if starts_at(rawdata, "<?", i) {
                    handle_pi(mut p, mut md, after(rawdata, i + 2));
                } else {
                    panic("we should not get here!");
                }
                k = n;
            }
            i = updatepos(mut p, i, k);
        } else if starts_at(rawdata, "&#", i) {
            let cr = md.re.id(P_HP_CHARREF, F_HP_CHARREF);
            match md.re.match_at(cr, rawdata, i) {
                Some(m) => {
                    let whole = grp(rawdata, m, 0);
                    let name = sl(whole, 2, prev_char_start(whole, whole.len()));
                    handle_charref(mut p, mut md, name);
                    let mut k = m.end;
                    if byte_at(rawdata, k - 1) != ';' as i64 {
                        k = prev_char_start(rawdata, k);
                    }
                    i = updatepos(mut p, i, k);
                    continue;
                }
                None => {}
            }
            let icr = md.re.id(P_HP_INCOMPLETE_CHARREF, F_HP_INCOMPLETE_CHARREF);
            if md.re.match_at(icr, rawdata, i).is_some() {
                if end {
                    handle_charref(mut p, mut md, after(rawdata, i + 2));
                    i = updatepos(mut p, i, n);
                    break;
                }
                break;
            } else if char_count(after(rawdata, i)) > 3 {
                handle_data(mut p, mut md, "&#".to_string());
                i = updatepos(mut p, i, i + 2);
            } else {
                break;
            }
        } else if bs[i] == b'&' {
            let er = md.re.id(P_HP_ENTITYREF, F_HP_ENTITYREF);
            match md.re.match_at(er, rawdata, i) {
                Some(m) => {
                    let name = grp(rawdata, m, 1);
                    handle_entityref(mut p, mut md, name);
                    let mut k = m.end;
                    if byte_at(rawdata, k - 1) != ';' as i64 {
                        k = prev_char_start(rawdata, k);
                    }
                    i = updatepos(mut p, i, k);
                    continue;
                }
                None => {}
            }
            if i + 1 < n {
                handle_data(mut p, mut md, "&".to_string());
                i = updatepos(mut p, i, i + 1);
            } else {
                break;
            }
        } else {
            panic("interesting.search() lied");
        }
    }
    if end and i < n {
        handle_data(mut p, mut md, sl(rawdata, i, n));
        i = updatepos(mut p, i, n);
    }
    p.rawdata = after(rawdata, i);
}

fn check_for_whole_start_tag(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let lte = md.re.id(P_HP_LOCATETAGEND, F_HP_LOCATETAGEND);
    let raw = p.rawdata.clone();
    let m = md.re.match_at(lte, raw, i + 1).unwrap();
    let j = m.end;
    if byte_at(raw, j - 1) != '>' as i64 {
        return -1;
    }
    j
}

// HTMLExtractor.parse_starttag.
fn parse_starttag(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    if sl(rawdata, i, i + 3) == "</>" {
        handle_data(mut p, mut md, "</>".to_string());
        return i + 3;
    }
    p.starttag_text = None;
    let endpos = check_for_whole_start_tag(mut p, mut md, i);
    if endpos < 0 {
        handle_data(mut p, mut md, sl(rawdata, i, i + 1));
        return i + 1;
    }
    p.starttag_text = Some(sl(rawdata, i, endpos));
    let mut attrs: Vec[Attr] = Vec.new();
    let tf = md.re.id(P_HP_TAGFIND_TOLERANT, F_HP_TAGFIND_TOLERANT);
    let m = md.re.match_at(tf, rawdata, i + 1).unwrap();
    let mut k = m.end;
    let tag = lower(grp(rawdata, m, 1));
    p.lasttag = tag.clone();
    let af = md.re.id(P_HP_ATTRFIND_TOLERANT, F_HP_ATTRFIND_TOLERANT);
    while k < endpos {
        let am = match md.re.match_at(af, rawdata, k) {
            Some(x) => x,
            None => break,
        };
        let attrname = grp(rawdata, am, 1);
        let rest = grp(rawdata, am, 2);
        let mut value: Option[String] = None;
        if rest.len() > 0 {
            let mut v = grp(rawdata, am, 3);
            let quoted = v.len() >= 1 and ((v.starts_with("'") and v.ends_with("'")) or (v.starts_with("\"") and v.ends_with("\"")));
            if quoted {
                v = sl(v, 1, v.len() - 1);
            }
            if v.len() > 0 {
                v = unescape(v, md.ents);
            }
            value = Some(v);
        }
        attrs.push(Attr { name: lower(attrname), value: value });
        k = am.end;
    }
    let end = strip_ws(sl(rawdata, k, endpos));
    if end != ">" and end != "/>" {
        handle_data(mut p, mut md, sl(rawdata, i, endpos));
        return endpos;
    }
    if end.ends_with("/>") {
        handle_startendtag(mut p, mut md, tag, attrs);
    } else {
        if in_words(CDATA_TAGS, tag) {
            set_cdata_mode(mut p, mut md, tag);
        }
        handle_starttag(mut p, mut md, tag, attrs);
    }
    endpos
}

// _HTMLParser.parse_endtag, then HTMLParser.parse_endtag.
fn parse_endtag(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    let c = byte_at(rawdata, i + 2);
    let is_data = c < 0 or not is_letter_b(c);
    let pos = if is_data { -1 } else { base_parse_endtag(mut p, mut md, i) };
    if pos == -1 {
        handle_data(mut p, mut md, sl(rawdata, i, i + 2));
        return i + 2;
    }
    pos
}

fn base_parse_endtag(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    if find_from(rawdata, ">", i + 2) < 0 {
        return -1;
    }
    let lte = md.re.id(P_HP_LOCATETAGEND, F_HP_LOCATETAGEND);
    let m = md.re.match_at(lte, rawdata, i + 2).unwrap();
    let j = m.end;
    if byte_at(rawdata, j - 1) != '>' as i64 {
        return -1;
    }
    let tf = md.re.id(P_HP_TAGFIND_TOLERANT, F_HP_TAGFIND_TOLERANT);
    let tm = md.re.match_at(tf, rawdata, i + 2).unwrap();
    let tag = lower(grp(rawdata, tm, 1));
    handle_endtag(mut p, mut md, tag);
    clear_cdata_mode(mut p);
    j
}

// HTMLExtractor.parse_comment.
fn parse_comment(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    let cc = md.re.id(P_HP_COMMENTCLOSE, F_HP_COMMENTCLOSE);
    match md.re.search(cc, rawdata, i + 4) {
        Some(m) => {
            handle_comment(mut p, mut md, sl(rawdata, i + 4, m.start));
            m.end
        }
        None => {
            handle_data(mut p, mut md, "<".to_string());
            i + 1
        }
    }
}

fn parse_pi(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let go = at_line_start(mut p) or p.intail or (p.extra and p.mdstack.len() > 0);
    if go {
        return base_parse_pi(mut p, mut md, i);
    }
    handle_data(mut p, mut md, "<?".to_string());
    i + 2
}

fn base_parse_pi(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    let pc = md.re.id(P_HP_PICLOSE, F_HP_PICLOSE);
    match md.re.search(pc, rawdata, i + 2) {
        Some(m) => {
            handle_pi(mut p, mut md, sl(rawdata, i + 2, m.start));
            m.end
        }
        None => -1,
    }
}

fn parse_html_declaration(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    let go = at_line_start(mut p) or p.intail or (p.extra and p.mdstack.len() > 0);
    if go {
        if sl(rawdata, i, i + 3) == "<![" and sl(rawdata, i, i + 9) != "<![CDATA[" {
            let result = parse_bogus_comment(mut p, mut md, i);
            if result == -1 {
                handle_data(mut p, mut md, sl(rawdata, i, i + 1));
                return i + 1;
            }
            return result;
        }
        return base_parse_html_declaration(mut p, mut md, i);
    }
    handle_data(mut p, mut md, "<!".to_string());
    i + 2
}

fn base_parse_html_declaration(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    if sl(rawdata, i, i + 4) == "<!--" {
        return parse_comment(mut p, mut md, i);
    } else if sl(rawdata, i, i + 9) == "<![CDATA[" and p.support_cdata {
        let j = find_from(rawdata, "]]>", i + 9);
        if j < 0 {
            return -1;
        }
        unknown_decl(mut p, mut md, sl(rawdata, i + 3, j));
        return j + 3;
    } else if lower(sl(rawdata, i, i + 9)) == "<!doctype" {
        let gtpos = find_from(rawdata, ">", i + 9);
        if gtpos == -1 {
            return -1;
        }
        handle_decl(mut p, mut md, sl(rawdata, i + 2, gtpos));
        return gtpos + 1;
    }
    parse_bogus_comment(mut p, mut md, i)
}

// HTMLExtractor.parse_bogus_comment (report=0 to the base).
fn parse_bogus_comment(p: mut ref Hp, md: mut ref Md, i: i64) -> i64 {
    let rawdata = p.rawdata.clone();
    let k = find_from(rawdata, ">", i + 2);
    if k == -1 {
        return -1;
    }
    let pos = k + 1;
    handle_empty_tag(mut p, mut md, sl(rawdata, i, pos), false);
    pos
}

fn starttag_text(p: ref Hp) -> String {
    opt_text(p.starttag_text)
}

// ------------------------------------------------ handlers, dispatched

fn handle_starttag(p: mut ref Hp, md: mut ref Md, tag: ref String, attrs: ref Vec[Attr]) {
    if p.extra {
        extra_handle_starttag(mut p, mut md, tag, attrs);
    } else {
        base_handle_starttag(mut p, mut md, tag, attrs);
    }
}

fn handle_endtag(p: mut ref Hp, md: mut ref Md, tag: ref String) {
    if p.extra {
        extra_handle_endtag(mut p, mut md, tag);
    } else {
        base_handle_endtag(mut p, mut md, tag);
    }
}

fn handle_startendtag(p: mut ref Hp, md: mut ref Md, tag: ref String, attrs: ref Vec[Attr]) {
    if p.extra {
        let mut data = starttag_text(p);
        if *tag == "hr" {
            let d = attr_dict(attrs);
            if dict_has(d, "markdown") {
                let rest = dict_without(d, "markdown");
                data = et_tostring_empty(tag, rest);
            }
        }
        let blk = is_block_level(md, tag);
        handle_empty_tag(mut p, mut md, data, blk);
    } else {
        let data = starttag_text(p);
        let blk = is_block_level(md, tag);
        handle_empty_tag(mut p, mut md, data, blk);
    }
}

fn handle_data(p: mut ref Hp, md: mut ref Md, data: own String) {
    if p.extra {
        if p.intail and data.contains("\n") {
            p.intail = false;
        }
        if p.inraw or p.mdstack.len() == 0 {
            base_handle_data(mut p, data);
        } else {
            let k = p.mdstarted.len() - 1;
            p.mdstarted[k] = false;
            p.tb_data.push(data);
        }
    } else {
        base_handle_data(mut p, data);
    }
}

fn handle_empty_tag(p: mut ref Hp, md: mut ref Md, data: own String, is_block: bool) {
    if p.extra and not (p.inraw or p.mdstack.len() == 0) {
        if at_line_start(mut p) and is_block {
            let ph = store_html(mut md, data);
            handle_data(mut p, mut md, f"\n{ph}\n\n");
        } else if p.mdstate.len() > 0 and p.mdstate[p.mdstate.len() - 1] == "off" {
            let ph = store_html(mut md, data);
            handle_data(mut p, mut md, ph);
        } else {
            handle_data(mut p, mut md, data);
        }
        return;
    }
    base_handle_empty_tag(mut p, mut md, data, is_block);
}

fn handle_charref(p: mut ref Hp, md: mut ref Md, name: own String) {
    handle_empty_tag(mut p, mut md, f"&#{name};", false);
}

fn handle_entityref(p: mut ref Hp, md: mut ref Md, name: own String) {
    handle_empty_tag(mut p, mut md, f"&{name};", false);
}

fn handle_comment(p: mut ref Hp, md: mut ref Md, data: own String) {
    let text = f"<!--{data}-->";
    let is_block = has_inner_blank(data) or not inline_close_follows(mut p, mut md, text);
    handle_empty_tag(mut p, mut md, text, is_block);
}

fn handle_decl(p: mut ref Hp, md: mut ref Md, data: own String) {
    handle_empty_tag(mut p, mut md, f"<!{data}>", true);
}

fn handle_pi(p: mut ref Hp, md: mut ref Md, data: own String) {
    handle_empty_tag(mut p, mut md, f"<?{data}?>", true);
}

fn unknown_decl(p: mut ref Hp, md: mut ref Md, data: own String) {
    let end = if data.starts_with("CDATA[") { "]]>" } else { "]>" };
    handle_empty_tag(mut p, mut md, f"<![{data}{end}", true);
}

// ---------------------------------------------------- HTMLExtractor

fn base_handle_starttag(p: mut ref Hp, md: mut ref Md, tag: ref String, attrs: ref Vec[Attr]) {
    if *tag == "hr" {
        handle_startendtag(mut p, mut md, tag, attrs);
        return;
    }
    if is_block_level(md, tag) and (p.intail or (at_line_start(mut p) and not p.inraw)) {
        p.inraw = true;
        p.cleandoc.push("\n".to_string());
    }
    let text = starttag_text(p);
    if p.inraw {
        p.stack.push(tag.clone());
        p.cache.push(text);
    } else {
        p.cleandoc.push(text);
        open_inline_tag(mut p, md, tag);
        if in_words(CDATA_TAGS, tag) {
            clear_cdata_mode(mut p);
        }
    }
}

fn base_handle_endtag(p: mut ref Hp, md: mut ref Md, tag: ref String) {
    let text = get_endtag_text(mut p, tag);
    if p.inraw {
        p.cache.push(text.clone());
        if has_s(p.stack, tag) {
            while p.stack.len() > 0 {
                let top = p.stack.pop().unwrap();
                if top == *tag {
                    break;
                }
            }
        }
        if p.stack.len() == 0 {
            let at = here(mut p) + text.len();
            if blank_line_at(p.rawdata, at) {
                p.cache.push("\n".to_string());
            } else {
                p.intail = true;
            }
            p.inraw = false;
            let joined = join(p.cache, "");
            let ph = store_html(mut md, joined);
            p.cleandoc.push(ph);
            p.cleandoc.push("\n\n".to_string());
            p.cache.clear();
        }
    } else {
        p.cleandoc.push(text);
        close_inline_tag(mut p, tag);
    }
}

fn open_inline_tag(p: mut ref Hp, md: ref Md, tag: ref String) {
    if not is_block_level(md, tag) and not in_words(" area base br col embed hr img input link meta param source track wbr ", tag) {
        p.inline_stack.push(tag.clone());
    }
}

fn close_inline_tag(p: mut ref Hp, tag: ref String) {
    if has_s(p.inline_stack, tag) {
        while p.inline_stack.len() > 0 {
            let top = p.inline_stack.pop().unwrap();
            if top == *tag {
                break;
            }
        }
    }
}

fn inline_close_follows(p: mut ref Hp, md: mut ref Md, text: ref String) -> bool {
    if p.inline_stack.len() == 0 {
        return false;
    }
    let at = here(mut p) + text.len();
    let tail = after(p.rawdata, at);
    let (a, _) = inner_blank(tail);
    let rest = if a >= 0 { upto(tail, a) } else { tail };
    let tags = p.inline_stack.clone();
    for tag in tags.iter() {
        let pat = f"</\\s*{re_escape(tag)}\\s*>";
        let id = md.re.id(pat, 2 | 32);
        if md.re.search(id, rest, 0).is_some() {
            return true;
        }
    }
    false
}

fn base_handle_data(p: mut ref Hp, data: own String) {
    if p.intail and data.contains("\n") {
        p.intail = false;
    }
    if p.inraw {
        p.cache.push(data);
    } else {
        if has_inner_blank(data) {
            p.inline_stack.clear();
        }
        p.cleandoc.push(data);
    }
}

fn base_handle_empty_tag(p: mut ref Hp, md: mut ref Md, data0: own String, is_block: bool) {
    let mut data = data0;
    if p.inraw or p.intail {
        p.cache.push(data);
    } else if at_line_start(mut p) and is_block {
        let at = here(mut p) + data.len();
        if blank_line_at(p.rawdata, at) {
            data.push('\n');
        } else {
            p.intail = true;
        }
        let item = if p.cleandoc.len() > 0 { p.cleandoc[p.cleandoc.len() - 1].clone() } else { String.new() };
        if not item.ends_with("\n\n") and item.ends_with("\n") {
            p.cleandoc.push("\n".to_string());
        }
        let ph = store_html(mut md, data);
        p.cleandoc.push(ph);
        p.cleandoc.push("\n\n".to_string());
    } else {
        p.cleandoc.push(data);
    }
}

// --------------------------------------------- HTMLExtractorExtra

const SPAN_TAGS: Str = " address dd dt h1 h2 h3 h4 h5 h6 legend li p summary td th ";
const RAW_TAGS: Str = " canvas math option pre script style textarea ";

fn block_level_tag(md: ref Md, tag: ref String) -> bool {
    has_s(md.block_level, tag)
}

fn block_tag(md: ref Md, tag: ref String) -> bool {
    block_level_tag(md, tag) and not in_words(SPAN_TAGS, tag) and not in_words(RAW_TAGS, tag) and *tag != "hr"
}

fn span_and_blocks_tag(md: ref Md, tag: ref String) -> bool {
    block_tag(md, tag) or in_words(SPAN_TAGS, tag)
}

// {key: value if value is not None else key}, in first-seen key order.
fn attr_dict(attrs: ref Vec[Attr]) -> Vec[(String, String)] {
    let mut d: Vec[(String, String)] = Vec.new();
    for a in attrs.iter() {
        let v = match a.value {
            Some(x) => x.clone(),
            None => a.name.clone(),
        };
        let mut found = false;
        let mut k = 0;
        while k < d.len() {
            if d[k].0 == a.name {
                d[k] = (a.name.clone(), v.clone());
                found = true;
                break;
            }
            k += 1;
        }
        if not found {
            d.push((a.name.clone(), v));
        }
    }
    d
}

fn dict_has(d: ref Vec[(String, String)], key: Str) -> bool {
    for kv in d.iter() {
        if kv.0 == key {
            return true;
        }
    }
    false
}

fn dict_get(d: ref Vec[(String, String)], key: Str, dflt: Str) -> String {
    for kv in d.iter() {
        if kv.0 == key {
            return kv.1.clone();
        }
    }
    dflt.to_string()
}

fn dict_without(d: ref Vec[(String, String)], key: Str) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for kv in d.iter() {
        if kv.0 != key {
            out.push(kv.clone());
        }
    }
    out
}

fn get_state(p: ref Hp, md: ref Md, tag: ref String, attrs: ref Vec[(String, String)]) -> String {
    let mut md_attr = dict_get(attrs, "markdown", "0");
    if md_attr == "markdown" {
        md_attr = "1".to_string();
    }
    let parent_state = if p.mdstate.len() > 0 { p.mdstate[p.mdstate.len() - 1].clone() } else { String.new() };
    if parent_state == "off" or (parent_state == "span" and md_attr != "0") {
        md_attr = parent_state.clone();
    }
    if (md_attr == "1" and block_tag(md, tag)) or (md_attr == "block" and span_and_blocks_tag(md, tag)) {
        return "block".to_string();
    }
    if (md_attr == "1" and in_words(SPAN_TAGS, tag)) or (md_attr == "span" and span_and_blocks_tag(md, tag)) {
        return "span".to_string();
    }
    if block_level_tag(md, tag) {
        return "off".to_string();
    }
    String.new()
}

fn top_state_off(p: ref Hp) -> bool {
    p.mdstate.len() > 0 and p.mdstate[p.mdstate.len() - 1] == "off"
}

fn extra_handle_starttag(p: mut ref Hp, md: mut ref Md, tag: ref String, attrs: ref Vec[Attr]) {
    if *tag == "hr" and (at_line_start(mut p) or p.intail) {
        let d = attr_dict(attrs);
        let data = if dict_has(d, "markdown") {
            et_tostring_empty(tag, dict_without(d, "markdown"))
        } else {
            starttag_text(p)
        };
        handle_empty_tag(mut p, mut md, data, true);
        return;
    }
    let started = p.mdstarted.len() > 0 and p.mdstarted[p.mdstarted.len() - 1];
    if block_level_tag(md, tag) and (at_line_start(mut p) or p.intail or started) {
        let d = attr_dict(attrs);
        let state = get_state(p, md, tag, d);
        if p.inraw or ((state == "" or state == "off") and p.mdstack.len() == 0) {
            // The dict reaches HTMLExtractor, which only uses it for <hr>.
            base_handle_starttag(mut p, mut md, tag, Vec.new());
        } else {
            if has_s(p.mdstack, "p".to_string()) and block_level_tag(md, tag) {
                extra_handle_endtag(mut p, mut md, "p".to_string());
            }
            p.mdstate.push(state.clone());
            p.mdstack.push(tag.clone());
            p.mdstarted.push(true);
            let mut d2 = d.clone();
            let sv = if state == "" { NONE_ATTR.to_string() } else { state.clone() };
            let mut found = false;
            let mut k = 0;
            while k < d2.len() {
                if d2[k].0 == "markdown" {
                    d2[k] = ("markdown".to_string(), sv.clone());
                    found = true;
                }
                k += 1;
            }
            if not found {
                d2.push(("markdown".to_string(), sv));
            }
            tb_start(mut p, mut md, tag, d2);
        }
    } else if p.inraw {
        base_handle_starttag(mut p, mut md, tag, attrs);
    } else {
        let text = starttag_text(p);
        if top_state_off(p) {
            let ph = store_html(mut md, text);
            handle_data(mut p, mut md, ph);
        } else {
            handle_data(mut p, mut md, text);
        }
        open_inline_tag(mut p, md, tag);
        if in_words(CDATA_TAGS, tag) {
            clear_cdata_mode(mut p);
        }
    }
}

fn extra_handle_endtag(p: mut ref Hp, md: mut ref Md, tag: ref String) {
    if block_level_tag(md, tag) {
        if p.inraw {
            base_handle_endtag(mut p, mut md, tag);
        } else if has_s(p.mdstack, tag) {
            while p.mdstack.len() > 0 {
                let item = p.mdstack.pop().unwrap();
                p.mdstate.pop();
                p.mdstarted.pop();
                tb_end(mut p, mut md);
                if item == *tag {
                    break;
                }
            }
            if p.mdstack.len() == 0 {
                let element = tb_close(mut p, mut md);
                let item = if p.cleandoc.len() > 0 { p.cleandoc[p.cleandoc.len() - 1].clone() } else { String.new() };
                if not item.ends_with("\n\n") and item.ends_with("\n") {
                    p.cleandoc.push("\n".to_string());
                }
                let mut current = element;
                let mut last: Vec[i64] = Vec.new();
                while current >= 0 {
                    let kids = md.t.kids(current);
                    for child in kids.iter() {
                        md.t.remove(current, *child);
                        let text = md.t.text_s(current);
                        let mut tail = md.t.tail_s(*child);
                        md.t.clear_tail(*child);
                        let state = md.t.get_or(*child, "markdown", "off");
                        if tail != "\n" {
                            tail = "\n".to_string() + rstrip_set(tail, "\n");
                        }
                        let text2 = if text.ends_with("\n\n") { text } else { rstrip_set(text, "\n") + "\n\n".to_string() };
                        if state == "span" or state == "block" {
                            let ph = store_el(mut md, *child);
                            md.t.set_text(current, f"{text2}{ph}{tail}");
                            last.push(*child);
                        } else {
                            let _ = md.t.del(*child, "markdown");
                            for c in md.t.iter(*child).iter() {
                                let _ = md.t.del(*c, "markdown");
                            }
                            let ph = store_el(mut md, *child);
                            md.t.set_text(current, f"{text2}{ph}{tail}");
                        }
                    }
                    current = if last.len() > 0 { last.remove(0) } else { -1 };
                }
                let ph = store_el(mut md, element);
                p.cleandoc.push(ph);
                p.cleandoc.push("\n\n".to_string());
                let et = get_endtag_text(mut p, tag);
                let at = here(mut p) + et.len();
                if not blank_line_at(p.rawdata, at) {
                    p.intail = true;
                }
            }
        } else {
            let text = get_endtag_text(mut p, tag);
            if top_state_off(p) {
                let ph = store_html(mut md, text);
                handle_data(mut p, mut md, ph);
            } else {
                handle_data(mut p, mut md, text);
            }
        }
    } else if p.inraw {
        base_handle_endtag(mut p, mut md, tag);
    } else {
        let text = get_endtag_text(mut p, tag);
        if top_state_off(p) {
            let ph = store_html(mut md, text);
            handle_data(mut p, mut md, ph);
        } else {
            handle_data(mut p, mut md, text);
        }
        close_inline_tag(mut p, tag);
    }
}

// ---------------------------------------------------- TreeBuilder

fn tb_flush(p: mut ref Hp, md: mut ref Md) {
    if p.tb_data.len() > 0 {
        if p.tb_last >= 0 {
            let text = join(p.tb_data, "");
            if p.tb_tail {
                md.t.set_tail(p.tb_last, text);
            } else {
                md.t.set_text(p.tb_last, text);
            }
        }
        p.tb_data.clear();
    }
}

fn tb_start(p: mut ref Hp, md: mut ref Md, tag: ref String, attrs: own Vec[(String, String)]) {
    tb_flush(mut p, mut md);
    let e = md.t.el(tag);
    md.t.nodes[e].attrs = attrs;
    if p.tb_stack.len() > 0 {
        let top = p.tb_stack[p.tb_stack.len() - 1];
        md.t.append(top, e);
    } else if p.tb_root < 0 {
        p.tb_root = e;
    }
    p.tb_stack.push(e);
    p.tb_last = e;
    p.tb_tail = false;
}

fn tb_end(p: mut ref Hp, md: mut ref Md) {
    tb_flush(mut p, mut md);
    p.tb_last = p.tb_stack.pop().unwrap();
    p.tb_tail = true;
}

fn tb_close(p: mut ref Hp, md: mut ref Md) -> i64 {
    tb_flush(mut p, mut md);
    let root = p.tb_root;
    p.tb_root = -1;
    p.tb_last = -1;
    p.tb_tail = false;
    p.tb_stack.clear();
    root
}

// ============================================================ Markdown
// The Markdown class: its registries of processors (a processor here is a
// kind number and the state the Markdown object keeps for it), the
// HtmlStash, the references, the extensions' settings and convert().

const NONE_ATTR: Str = "\u{1}None";

const STX: Str = "\u{2}";
const ETX: Str = "\u{3}";
const INLINE_PH_PREFIX: Str = "\u{2}klzzwxh:";
const AMP_SUBSTITUTE: Str = "\u{2}amp\u{3}";
const FN_BACKLINK_TEXT: Str = "\u{2}zz1337820767766393qq\u{3}";
const NBSP_PLACEHOLDER: Str = "\u{2}qq3936677670287331zz\u{3}";

// preprocessors
const K_NORMALIZE: i64 = 1;
const K_HTML_BLOCK: i64 = 2;
const K_HTML_BLOCK_EXTRA: i64 = 3;
const K_FENCED: i64 = 4;
const K_META: i64 = 5;
// block processors
const B_EMPTY: i64 = 10;
const B_INDENT: i64 = 11;
const B_CODE: i64 = 12;
const B_HASH: i64 = 13;
const B_SETEXT: i64 = 14;
const B_HR: i64 = 15;
const B_OLIST: i64 = 16;
const B_ULIST: i64 = 17;
const B_QUOTE: i64 = 18;
const B_REFERENCE: i64 = 19;
const B_PARAGRAPH: i64 = 20;
const B_ADMONITION: i64 = 21;
const B_ABBR: i64 = 22;
const B_DEFINDENT: i64 = 23;
const B_DEFLIST: i64 = 24;
const B_FOOTNOTE: i64 = 25;
const B_TABLE: i64 = 26;
const B_MD_BLOCK: i64 = 27;
const B_SANE_OLIST: i64 = 28;
const B_SANE_ULIST: i64 = 29;
// inline patterns
const I_BACKTICK: i64 = 40;
const I_ESCAPE: i64 = 41;
const I_REFERENCE: i64 = 42;
const I_LINK: i64 = 43;
const I_IMAGE_LINK: i64 = 44;
const I_IMAGE_REF: i64 = 45;
const I_SHORT_REF: i64 = 46;
const I_SHORT_IMAGE_REF: i64 = 47;
const I_AUTOLINK: i64 = 48;
const I_AUTOMAIL: i64 = 49;
const I_SUBST_TAG: i64 = 50;
const I_HTML: i64 = 51;
const I_DELIM: i64 = 52;
const I_FOOTNOTE: i64 = 53;
const I_WIKILINK: i64 = 54;
const I_SUBST_TEXT: i64 = 55;
// tree processors
const T_INLINE: i64 = 60;
const T_PRETTIFY: i64 = 61;
const T_UNESCAPE: i64 = 62;
const T_ABBR: i64 = 63;
const T_ATTR_LIST: i64 = 64;
const T_HILITE: i64 = 65;
const T_FOOTNOTE: i64 = 66;
const T_FN_REORDER: i64 = 67;
const T_FN_DUP: i64 = 68;
const T_LEGACY_ATTRS: i64 = 69;
const T_SMARTY: i64 = 70;
const T_TOC: i64 = 71;
// postprocessors
const Q_RAW_HTML: i64 = 80;
const Q_RAW_HTML_EXTRA: i64 = 81;
const Q_AMP: i64 = 82;
const Q_FOOTNOTE: i64 = 83;

// A configuration value, as Python-Markdown's settings hold them.
#[derive(Clone)]
enum Val {
    Null,
    Bool(bool),
    Int(i64),
    Str(String),
}

fn val_truthy(v: ref Val) -> bool {
    match v {
        Val.Null => false,
        Val.Bool(b) => b,
        Val.Int(i) => i != 0,
        Val.Str(s) => s.len() > 0,
    }
}

fn val_str(v: ref Val) -> String {
    match v {
        Val.Null => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(i) => f"{i}",
        Val.Str(s) => s.clone(),
    }
}

fn val_int(v: ref Val) -> i64 {
    match v {
        Val.Null => 0,
        Val.Bool(b) => if b { 1 } else { 0 },
        Val.Int(i) => i,
        Val.Str(s) => parse_int(s),
    }
}

fn val_is_bool(v: ref Val) -> bool {
    match v {
        Val.Bool(_) => true,
        _ => false,
    }
}

fn val_is_null(v: ref Val) -> bool {
    match v {
        Val.Null => true,
        _ => false,
    }
}

fn val_is_true(v: ref Val) -> bool {
    match v {
        Val.Bool(b) => b,
        _ => false,
    }
}

// util.parseBoolValue. An unparseable string with fail_on_errors set
// raises in Python; none of the jobs gives one.
fn parse_bool_value(v: ref Val, fail_on_errors: bool, preserve_none: bool) -> Val {
    match v {
        Val.Str(s) => {
            let l = lower(s);
            if preserve_none and l == "none" {
                return Val.Null;
            }
            if l == "true" or l == "yes" or l == "y" or l == "on" or l == "1" {
                return Val.Bool(true);
            }
            if l == "false" or l == "no" or l == "n" or l == "off" or l == "0" or l == "none" {
                return Val.Bool(false);
            }
            if fail_on_errors {
                panic(f"Cannot parse bool value: {py_repr(s)}");
            }
            Val.Null
        }
        Val.Null => if preserve_none { Val.Null } else { Val.Bool(false) },
        _ => Val.Bool(val_truthy(v)),
    }
}

// An extension's config dict: key, [value, description] in order.
#[derive(Clone)]
struct Cfg {
    items: Vec[(String, Val)],
}

impl Cfg {
    fn get(ref self, key: Str) -> Val {
        for kv in self.items.iter() {
            if kv.0 == key {
                return kv.1.clone();
            }
        }
        Val.Str(String.new())
    }

    fn has(ref self, key: Str) -> bool {
        for kv in self.items.iter() {
            if kv.0 == key {
                return true;
            }
        }
        false
    }

    fn s(ref self, key: Str) -> String {
        val_str(self.get(key))
    }

    fn put(mut ref self, key: Str, v: own Val) {
        let mut k = 0;
        while k < self.items.len() {
            if self.items[k].0 == key {
                self.items[k] = (key.to_string(), v);
                return;
            }
            k += 1;
        }
        self.items.push((key.to_string(), v));
    }

    // Extension.setConfig.
    fn set_config(mut ref self, key: Str, value: ref Val) {
        if not self.has(key) {
            panic(f"KeyError: {key}");
        }
        let cur = self.get(key);
        let mut v = value.clone();
        if val_is_bool(cur) {
            v = parse_bool_value(v, true, false);
        }
        if val_is_null(cur) {
            v = parse_bool_value(v, true, true);
        }
        self.put(key, v);
    }
}

fn cfg_of(pairs: Vec[(Str, Val)]) -> Cfg {
    let mut items: Vec[(String, Val)] = Vec.new();
    for kv in pairs.iter() {
        items.push((kv.0.to_string(), kv.1.clone()));
    }
    Cfg { items: items }
}

fn vs(s: Str) -> Val {
    Val.Str(s.to_string())
}

#[derive(Clone)]
struct Reg {
    name: String,
    prio: i64,
    kind: i64,
    rx: i64,
    arg: i64,
}

// Registry.register: a name registered again replaces the old entry, and
// iteration is a stable sort by priority, highest first.
fn reg_add(r: mut ref Vec[Reg], name: Str, prio: i64, kind: i64, rx: i64, arg: i64) {
    let mut k = 0;
    while k < r.len() {
        if r[k].name == name {
            r.remove(k);
            break;
        }
        k += 1;
    }
    r.push(Reg { name: name.to_string(), prio: prio, kind: kind, rx: rx, arg: arg });
    r.sort_by(|a, b| {
        if a.prio > b.prio {
            Ordering.Less
        } else if a.prio < b.prio {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    });
}

fn reg_has(r: ref Vec[Reg], name: Str) -> bool {
    for x in r.iter() {
        if x.name == name {
            return true;
        }
    }
    false
}

// What the HtmlStash holds: raw HTML, or an element (md_in_html).
struct Stashed {
    is_el: bool,
    html: String,
    el: i64,
}

// A stashed inline node: an element, or text.
struct Inl {
    is_el: bool,
    el: i64,
    text: String,
}

// One InlineProcessor tree processor's state.
struct Ip {
    stashed: Vec[Inl],
    ancestors: Vec[String],
    parent_map: Map[i64, i64],
}

fn new_ip() -> Ip {
    Ip { stashed: Vec.new(), ancestors: Vec.new(), parent_map: Map.new() }
}

// A part of a smarty substitution: a group of the match, or text that
// goes to the HtmlStash.
#[derive(Clone)]
struct Part {
    group: i64,
    text: String,
}

#[derive(Clone)]
struct Tok {
    level: i64,
    id: String,
    name: String,
    html: String,
    label: String,
    children: Vec[Tok],
}

struct Md {
    re: Re,
    t: Tree,
    ents: Map[String, String],
    cp_names: Map[i64, String],
    nfkd: Map[i64, String],
    tab_length: i64,
    escaped: Vec[String],
    block_level: Vec[String],
    xhtml: bool,
    references: Map[String, (String, Option[String])],
    stash: Vec[Stashed],
    html_counter: i64,
    state: Vec[String],
    root: i64,
    pre: Vec[Reg],
    blocks: Vec[Reg],
    inl: Vec[Reg],
    trees: Vec[Reg],
    posts: Vec[Reg],
    smarty_inl: Vec[Reg],
    smarty_parts: Vec[Vec[Part]],
    registered: Vec[String],
    // extension settings
    hilite_cfg: Cfg,
    fenced_cfg: Cfg,
    fn_cfg: Cfg,
    toc_cfg: Cfg,
    wiki_cfg: Cfg,
    tables_cfg: Cfg,
    smarty_cfg: Cfg,
    // processor state
    olist_startswith: String,
    hr_start: i64,
    hr_end: i64,
    table_border: i64,
    table_sep: Vec[String],
    adm_sibling: i64,
    adm_indent: i64,
    fenced_checked: bool,
    fenced_hilite: bool,
    fenced_attr_list: bool,
    abbrs: Vec[(String, String)],
    fn_order: Vec[String],
    fn_notes: Vec[(String, String)],
    fn_unique_prefix: i64,
    fn_found_refs: Vec[(String, i64)],
    fn_used_refs: Vec[String],
    has_meta: bool,
    meta: Vec[(String, Vec[String])],
    toc: String,
    toc_tokens: Vec[Tok],
    toc_ran: bool,
    ips: Vec[Ip],
    dp: Dp,
}

fn new_md(re: own Re, ents: own Map[String, String], cp_names: own Map[i64, String], nfkd: own Map[i64, String]) -> Md {
    let mut bl: Vec[String] = Vec.new();
    for t in "address article aside blockquote details div dl fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header hgroup hr main menu nav ol p pre section table ul canvas colgroup dd body dt group html iframe li legend math map noscript output object option progress script style summary tbody td textarea tfoot th thead tr video center".split(" ") {
        bl.push(t.to_string());
    }
    let mut esc: Vec[String] = Vec.new();
    for c in "\\`*_{}[]()>#+-.!".chars() {
        esc.push(c.to_string());
    }
    Md {
        re: re,
        t: Tree { nodes: Vec.new() },
        ents: ents,
        cp_names: cp_names,
        nfkd: nfkd,
        tab_length: 4,
        escaped: esc,
        block_level: bl,
        xhtml: true,
        references: Map.new(),
        stash: Vec.new(),
        html_counter: 0,
        state: Vec.new(),
        root: -1,
        pre: Vec.new(),
        blocks: Vec.new(),
        inl: Vec.new(),
        trees: Vec.new(),
        posts: Vec.new(),
        smarty_inl: Vec.new(),
        smarty_parts: Vec.new(),
        registered: Vec.new(),
        hilite_cfg: Cfg { items: Vec.new() },
        fenced_cfg: Cfg { items: Vec.new() },
        fn_cfg: Cfg { items: Vec.new() },
        toc_cfg: Cfg { items: Vec.new() },
        wiki_cfg: Cfg { items: Vec.new() },
        tables_cfg: Cfg { items: Vec.new() },
        smarty_cfg: Cfg { items: Vec.new() },
        olist_startswith: "1".to_string(),
        hr_start: -1,
        hr_end: -1,
        table_border: 0,
        table_sep: Vec.new(),
        adm_sibling: -1,
        adm_indent: 0,
        fenced_checked: false,
        fenced_hilite: false,
        fenced_attr_list: false,
        abbrs: Vec.new(),
        fn_order: Vec.new(),
        fn_notes: Vec.new(),
        fn_unique_prefix: 0,
        fn_found_refs: Vec.new(),
        fn_used_refs: Vec.new(),
        has_meta: false,
        meta: Vec.new(),
        toc: String.new(),
        toc_tokens: Vec.new(),
        toc_ran: false,
        ips: vec![new_ip(), new_ip()],
        dp: new_dp(),
    }
}

fn is_block_level(md: ref Md, tag: ref String) -> bool {
    let t = rstrip_set(lower(tag), "/");
    has_s(md.block_level, t)
}

fn store_html(md: mut ref Md, html: own String) -> String {
    md.stash.push(Stashed { is_el: false, html: html, el: -1 });
    let ph = html_placeholder(md.html_counter);
    md.html_counter += 1;
    ph
}

fn store_el(md: mut ref Md, el: i64) -> String {
    md.stash.push(Stashed { is_el: true, html: String.new(), el: el });
    let ph = html_placeholder(md.html_counter);
    md.html_counter += 1;
    ph
}

fn html_placeholder(n: i64) -> String {
    f"\u{2}wzxhzdk:{n}\u{3}"
}

fn has_ext(md: ref Md, name: Str) -> bool {
    for x in md.registered.iter() {
        if *x == name {
            return true;
        }
    }
    false
}

// ------------------------------------------------------ building

fn build(md: mut ref Md, exts: ref Vec[(String, Vec[(String, Val)])]) {
    reg_add(mut md.pre, "normalize_whitespace", 30, K_NORMALIZE, -1, 0);
    reg_add(mut md.pre, "html_block", 20, K_HTML_BLOCK, -1, 0);

    reg_add(mut md.blocks, "empty", 100, B_EMPTY, -1, 0);
    reg_add(mut md.blocks, "indent", 90, B_INDENT, -1, 0);
    reg_add(mut md.blocks, "code", 80, B_CODE, -1, 0);
    reg_add(mut md.blocks, "hashheader", 70, B_HASH, -1, 0);
    reg_add(mut md.blocks, "setextheader", 60, B_SETEXT, -1, 0);
    reg_add(mut md.blocks, "hr", 50, B_HR, -1, 0);
    reg_add(mut md.blocks, "olist", 40, B_OLIST, -1, 0);
    reg_add(mut md.blocks, "ulist", 30, B_ULIST, -1, 0);
    reg_add(mut md.blocks, "quote", 20, B_QUOTE, -1, 0);
    reg_add(mut md.blocks, "reference", 15, B_REFERENCE, -1, 0);
    reg_add(mut md.blocks, "paragraph", 10, B_PARAGRAPH, -1, 0);

    let fl = 16 | 32;
    let rx_bt = md.re.id(P_BACKTICK, fl);
    reg_add(mut md.inl, "backtick", 190, I_BACKTICK, rx_bt, 0);
    let rx_esc = md.re.id(P_ESCAPE, fl);
    reg_add(mut md.inl, "escape", 180, I_ESCAPE, rx_esc, 0);
    let rx_link = md.re.id(P_LINK, fl);
    reg_add(mut md.inl, "reference", 170, I_REFERENCE, rx_link, 0);
    reg_add(mut md.inl, "link", 160, I_LINK, rx_link, 0);
    let rx_img = md.re.id(P_IMAGE_LINK, fl);
    reg_add(mut md.inl, "image_link", 150, I_IMAGE_LINK, rx_img, 0);
    reg_add(mut md.inl, "image_reference", 140, I_IMAGE_REF, rx_img, 0);
    reg_add(mut md.inl, "short_reference", 130, I_SHORT_REF, rx_link, 0);
    reg_add(mut md.inl, "short_image_ref", 125, I_SHORT_IMAGE_REF, rx_img, 0);
    let rx_al = md.re.id(P_AUTOLINK, fl);
    reg_add(mut md.inl, "autolink", 120, I_AUTOLINK, rx_al, 0);
    let rx_am = md.re.id(P_AUTOMAIL, fl);
    reg_add(mut md.inl, "automail", 110, I_AUTOMAIL, rx_am, 0);
    let rx_lb = md.re.id(P_LINE_BREAK, fl);
    reg_add(mut md.inl, "linebreak", 100, I_SUBST_TAG, rx_lb, 0);
    let rx_html = md.re.id(P_HTML, fl);
    reg_add(mut md.inl, "html", 90, I_HTML, rx_html, 0);
    let rx_ent = md.re.id(P_ENTITY, fl);
    reg_add(mut md.inl, "entity", 80, I_HTML, rx_ent, 0);
    dp_add(mut md, "*", false);
    reg_add(mut md.inl, "em_strong", 60, I_DELIM, -1, 0);
    dp_add(mut md, "_", true);

    reg_add(mut md.trees, "inline", 20, T_INLINE, -1, 0);
    reg_add(mut md.trees, "prettify", 10, T_PRETTIFY, -1, 0);
    reg_add(mut md.trees, "unescape", 0, T_UNESCAPE, -1, 0);

    reg_add(mut md.posts, "raw_html", 30, Q_RAW_HTML, -1, 0);
    reg_add(mut md.posts, "amp_substitute", 20, Q_AMP, -1, 0);

    for e in exts.iter() {
        add_extension(mut md, e.0, e.1);
    }
    reset_md(mut md);
}

fn add_extension(md: mut ref Md, name: ref String, cfg: ref Vec[(String, Val)]) {
    if *name == "extra" {
        for sub in ["fenced_code", "footnotes", "attr_list", "def_list", "tables", "abbr", "md_in_html"] {
            let mut sc: Vec[(String, Val)] = Vec.new();
            let prefix = f"{sub}.";
            for kv in cfg.iter() {
                if kv.0.starts_with(prefix) {
                    sc.push((after(kv.0, prefix.len()), kv.1.clone()));
                }
            }
            add_extension(mut md, sub.to_string(), sc);
        }
        return;
    }
    if *name == "abbr" {
        md.registered.push("abbr".to_string());
        reg_add(mut md.trees, "abbr", 7, T_ABBR, -1, 0);
        reg_add(mut md.blocks, "abbr", 16, B_ABBR, -1, 0);
    } else if *name == "admonition" {
        md.registered.push("admonition".to_string());
        reg_add(mut md.blocks, "admonition", 105, B_ADMONITION, -1, 0);
    } else if *name == "attr_list" {
        reg_add(mut md.trees, "attr_list", 8, T_ATTR_LIST, -1, 0);
        md.registered.push("attr_list".to_string());
    } else if *name == "codehilite" {
        let mut c = cfg_of(vec![
            ("linenums", Val.Null),
            ("guess_lang", Val.Bool(true)),
            ("css_class", vs("codehilite")),
            ("pygments_style", vs("default")),
            ("noclasses", Val.Bool(false)),
            ("use_pygments", Val.Bool(true)),
            ("lang_prefix", vs("language-")),
            ("pygments_formatter", vs("html")),
        ]);
        for kv in cfg.iter() {
            if c.has(kv.0) {
                c.set_config(kv.0, kv.1);
            } else {
                let mut v = kv.1.clone();
                if let Val.Str(s) = kv.1 {
                    let l = lower(s);
                    if l == "none" or l == "true" or l == "yes" or l == "y" or l == "on" or l == "1" or l == "false" or l == "no" or l == "n" or l == "off" or l == "0" {
                        v = parse_bool_value(kv.1, true, true);
                    }
                }
                c.put(kv.0, v);
            }
        }
        md.hilite_cfg = c;
        reg_add(mut md.trees, "hilite", 30, T_HILITE, -1, 0);
        md.registered.push("codehilite".to_string());
    } else if *name == "def_list" {
        reg_add(mut md.blocks, "defindent", 85, B_DEFINDENT, -1, 0);
        reg_add(mut md.blocks, "deflist", 25, B_DEFLIST, -1, 0);
    } else if *name == "fenced_code" {
        let mut c = cfg_of(vec![("lang_prefix", vs("language-"))]);
        for kv in cfg.iter() {
            c.set_config(kv.0, kv.1);
        }
        md.fenced_cfg = c;
        md.registered.push("fenced_code".to_string());
        reg_add(mut md.pre, "fenced_code_block", 25, K_FENCED, -1, 0);
    } else if *name == "footnotes" {
        let mut c = cfg_of(vec![
            ("PLACE_MARKER", vs("///Footnotes Go Here///")),
            ("UNIQUE_IDS", Val.Bool(false)),
            ("BACKLINK_TEXT", vs("&#8617;")),
            ("SUPERSCRIPT_TEXT", vs("{}")),
            ("BACKLINK_TITLE", vs("Jump back to footnote %d in the text")),
            ("SEPARATOR", vs(":")),
            ("USE_DEFINITION_ORDER", Val.Bool(true)),
        ]);
        for kv in cfg.iter() {
            c.set_config(kv.0, kv.1);
        }
        let bt = c.s("BACKLINK_TITLE").replace("%d", "{}");
        c.set_config("BACKLINK_TITLE", Val.Str(bt));
        md.fn_cfg = c;
        fn_reset(mut md);
        md.registered.push("footnotes".to_string());
        reg_add(mut md.blocks, "footnote", 17, B_FOOTNOTE, -1, 0);
        let rx = md.re.id(P_FN_INLINE, 16 | 32);
        reg_add(mut md.inl, "footnote", 175, I_FOOTNOTE, rx, 0);
        reg_add(mut md.trees, "footnote", 50, T_FOOTNOTE, -1, 0);
        if not val_truthy(md.fn_cfg.get("USE_DEFINITION_ORDER")) {
            reg_add(mut md.trees, "footnote-reorder", 19, T_FN_REORDER, -1, 0);
        }
        reg_add(mut md.trees, "footnote-duplicate", 15, T_FN_DUP, -1, 0);
        reg_add(mut md.posts, "footnote", 25, Q_FOOTNOTE, -1, 0);
    } else if *name == "legacy_attrs" {
        reg_add(mut md.trees, "legacyattrs", 15, T_LEGACY_ATTRS, -1, 0);
    } else if *name == "legacy_em" {
        dp_add(mut md, "_", false);
    } else if *name == "md_in_html" {
        reg_add(mut md.pre, "html_block", 20, K_HTML_BLOCK_EXTRA, -1, 0);
        reg_add(mut md.blocks, "markdown_block", 105, B_MD_BLOCK, -1, 0);
        reg_add(mut md.posts, "raw_html", 30, Q_RAW_HTML_EXTRA, -1, 0);
    } else if *name == "meta" {
        md.registered.push("meta".to_string());
        md.has_meta = true;
        reg_add(mut md.pre, "meta", 27, K_META, -1, 0);
    } else if *name == "nl2br" {
        let rx = md.re.id(P_NL, 16 | 32);
        reg_add(mut md.inl, "nl", 5, I_SUBST_TAG, rx, 0);
    } else if *name == "sane_lists" {
        reg_add(mut md.blocks, "olist", 40, B_SANE_OLIST, -1, 0);
        reg_add(mut md.blocks, "ulist", 30, B_SANE_ULIST, -1, 0);
    } else if *name == "smarty" {
        add_smarty(mut md, cfg);
    } else if *name == "tables" {
        let mut c = cfg_of(vec![("use_align_attribute", Val.Bool(false))]);
        for kv in cfg.iter() {
            c.set_config(kv.0, kv.1);
        }
        md.tables_cfg = c;
        if not has_s(md.escaped, "|".to_string()) {
            md.escaped.push("|".to_string());
        }
        reg_add(mut md.blocks, "table", 75, B_TABLE, -1, 0);
    } else if *name == "toc" {
        let mut c = cfg_of(vec![
            ("marker", vs("[TOC]")),
            ("title", vs("")),
            ("title_class", vs("toctitle")),
            ("toc_class", vs("toc")),
            ("anchorlink", Val.Bool(false)),
            ("anchorlink_class", vs("toclink")),
            ("permalink", Val.Int(0)),
            ("permalink_class", vs("headerlink")),
            ("permalink_title", vs("Permanent link")),
            ("permalink_leading", Val.Bool(false)),
            ("baselevel", vs("1")),
            ("separator", vs("-")),
            ("toc_depth", Val.Int(6)),
        ]);
        for kv in cfg.iter() {
            c.set_config(kv.0, kv.1);
        }
        md.toc_cfg = c;
        md.registered.push("toc".to_string());
        reg_add(mut md.trees, "toc", 5, T_TOC, -1, 0);
    } else if *name == "wikilinks" {
        let mut c = cfg_of(vec![
            ("base_url", vs("/")),
            ("end_url", vs("/")),
            ("html_class", vs("wikilink")),
        ]);
        for kv in cfg.iter() {
            c.set_config(kv.0, kv.1);
        }
        md.wiki_cfg = c;
        let rx = md.re.id(P_WIKILINK, 16 | 32);
        reg_add(mut md.inl, "wikilink", 75, I_WIKILINK, rx, 0);
    } else {
        panic(f"Failed loading extension \"{name}\".");
    }
}

fn add_smarty(md: mut ref Md, cfg: ref Vec[(String, Val)]) {
    let mut c = cfg_of(vec![
        ("smart_quotes", Val.Bool(true)),
        ("smart_angled_quotes", Val.Bool(false)),
        ("smart_dashes", Val.Bool(true)),
        ("smart_ellipses", Val.Bool(true)),
    ]);
    for kv in cfg.iter() {
        c.set_config(kv.0, kv.1);
    }
    md.smarty_cfg = c;
    let fl = 16 | 32;
    if val_truthy(md.smarty_cfg.get("smart_ellipses")) {
        smarty_pat(mut md, "smarty-ellipses", 10, P_SMARTY_ELLIPSES, vec![(0, "&hellip;")]);
    }
    if val_truthy(md.smarty_cfg.get("smart_quotes")) {
        let lsquo: Str = "&lsquo;";
        let rsquo: Str = "&rsquo;";
        let ldquo: Str = "&ldquo;";
        let rdquo: Str = "&rdquo;";
        smarty_pat(mut md, "smarty-quotes-0", 30, P_SMARTY_QUOTES_0, vec![(0, rsquo)]);
        smarty_pat(mut md, "smarty-quotes-1", 29, P_SMARTY_QUOTES_1, vec![(0, rdquo)]);
        smarty_pat(mut md, "smarty-quotes-2", 28, P_SMARTY_QUOTES_2, vec![(0, "&ldquo;&lsquo;")]);
        smarty_pat(mut md, "smarty-quotes-3", 27, P_SMARTY_QUOTES_3, vec![(0, "&lsquo;&ldquo;")]);
        smarty_pat(mut md, "smarty-quotes-4", 26, P_SMARTY_QUOTES_4, vec![(0, "&rsquo;&rdquo;")]);
        smarty_pat(mut md, "smarty-quotes-5", 25, P_SMARTY_QUOTES_5, vec![(0, "&rdquo;&rsquo;")]);
        smarty_pat(mut md, "smarty-quotes-6", 24, P_SMARTY_QUOTES_6, vec![(0, rsquo)]);
        smarty_pat(mut md, "smarty-quotes-7", 23, P_SMARTY_QUOTES_7, vec![(1, ""), (0, lsquo)]);
        smarty_pat(mut md, "smarty-quotes-8", 22, P_SMARTY_QUOTES_8, vec![(0, rsquo)]);
        smarty_pat(mut md, "smarty-quotes-9", 21, P_SMARTY_QUOTES_9, vec![(0, rsquo), (1, "")]);
        smarty_pat(mut md, "smarty-quotes-10", 20, P_SMARTY_QUOTES_10, vec![(0, lsquo)]);
        smarty_pat(mut md, "smarty-quotes-11", 19, P_SMARTY_QUOTES_11, vec![(1, ""), (0, ldquo)]);
        smarty_pat(mut md, "smarty-quotes-12", 18, P_SMARTY_QUOTES_12, vec![(0, rdquo)]);
        smarty_pat(mut md, "smarty-quotes-13", 17, P_SMARTY_QUOTES_13, vec![(0, rdquo)]);
        smarty_pat(mut md, "smarty-quotes-14", 16, P_SMARTY_QUOTES_14, vec![(0, ldquo)]);
    }
    if val_truthy(md.smarty_cfg.get("smart_angled_quotes")) {
        smarty_pat(mut md, "smarty-left-angle-quotes", 40, P_SMARTY_LEFT_ANGLE_QUOTES, vec![(0, "&laquo;")]);
        smarty_pat(mut md, "smarty-right-angle-quotes", 35, P_SMARTY_RIGHT_ANGLE_QUOTES, vec![(0, "&raquo;")]);
        let rx = md.re.id(P_HTML_STRICT, fl);
        reg_add(mut md.inl, "html", 90, I_HTML, rx, 0);
    }
    if val_truthy(md.smarty_cfg.get("smart_dashes")) {
        smarty_pat(mut md, "smarty-em-dashes", 50, P_SMARTY_EM_DASHES, vec![(0, "&mdash;")]);
        smarty_pat(mut md, "smarty-en-dashes", 45, P_SMARTY_EN_DASHES, vec![(0, "&ndash;")]);
    }
    reg_add(mut md.trees, "smarty", 6, T_SMARTY, -1, 0);
    md.escaped.push("\"".to_string());
    md.escaped.push("'".to_string());
}

// A SubstituteTextPattern: each part is a group number (when not 0) or
// text for the HtmlStash.
fn smarty_pat(md: mut ref Md, name: Str, prio: i64, pattern: Str, parts: Vec[(i64, Str)]) {
    let rx = md.re.id(pattern, 16 | 32);
    let mut ps: Vec[Part] = Vec.new();
    for p in parts.iter() {
        ps.push(Part { group: p.0, text: p.1.to_string() });
    }
    md.smarty_parts.push(ps);
    let arg = md.smarty_parts.len() - 1;
    reg_add(mut md.smarty_inl, name, prio, I_SUBST_TEXT, rx, arg);
}

fn fn_reset(md: mut ref Md) {
    md.fn_order.clear();
    md.fn_notes.clear();
    md.fn_unique_prefix += 1;
    md.fn_found_refs.clear();
    md.fn_used_refs.clear();
}

// Markdown.reset and the registered extensions' reset().
fn reset_md(md: mut ref Md) {
    md.stash.clear();
    md.html_counter = 0;
    md.references.clear();
    dp_reset(mut md.dp);
    let regs = md.registered.clone();
    for r in regs.iter() {
        if *r == "abbr" {
            md.abbrs.clear();
        } else if *r == "footnotes" {
            fn_reset(mut md);
        } else if *r == "meta" {
            md.meta.clear();
        } else if *r == "toc" {
            md.toc = String.new();
            md.toc_tokens.clear();
        }
    }
}

// ------------------------------------------------------- convert

fn convert(md: mut ref Md, source: ref String) -> String {
    if is_blank(source) {
        return String.new();
    }
    let mut lines = split_on(source, "\n");
    let pres = md.pre.clone();
    for r in pres.iter() {
        lines = run_preprocessor(mut md, r.kind, lines);
    }
    let root = md.t.el("div");
    md.root = root;
    parse_chunk(mut md, root, join(lines, "\n"));
    let trees = md.trees.clone();
    for r in trees.iter() {
        run_treeprocessor(mut md, r.kind, root);
    }
    let mut output = serialize(md.t, root, md.xhtml);
    let a = find_s(output, "<div>");
    let b = rfind_s(output, "</div>");
    if a >= 0 and b >= 0 {
        output = strip_ws(sl(output, a + 5, b));
    } else if strip_ws(output).ends_with("<div />") {
        output = String.new();
    } else {
        panic(f"Markdown failed to strip top-level tags. Document={py_repr(strip_ws(output))}");
    }
    run_postprocessors(mut md, output).0
}

// The postprocessors in order, and the result stripped.
fn run_postprocessors(md: mut ref Md, text0: own String) -> (String, String) {
    let mut text = text0;
    let posts = md.posts.clone();
    for r in posts.iter() {
        text = run_postprocessor(mut md, r.kind, text);
    }
    let s = strip_ws(text);
    (s, text)
}

// ======================================================== block parser
// BlockParser and the block processors, core and extension ones. A
// processor's test() and run() are the two functions here, dispatched on
// its kind; run() answers false where Python's returns False (the block
// was not handled and the next processor tries it).

fn isstate(md: ref Md, s: Str) -> bool {
    md.state.len() > 0 and md.state[md.state.len() - 1] == s
}

fn set_state(md: mut ref Md, s: Str) {
    md.state.push(s.to_string());
}

fn reset_state(md: mut ref Md) {
    md.state.pop();
}

// "None" where Python formats a None.
fn pystr(o: ref Option[String]) -> String {
    match o {
        Some(t) => t.clone(),
        None => "None".to_string(),
    }
}

fn parse_chunk(md: mut ref Md, parent: i64, text: ref String) {
    let mut blocks = split_on(text, "\n\n");
    parse_blocks(mut md, parent, mut blocks);
}

fn parse_one(md: mut ref Md, parent: i64, block: own String) {
    let mut blocks = vec![block];
    parse_blocks(mut md, parent, mut blocks);
}

fn parse_blocks(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    while blocks.len() > 0 {
        let procs = md.blocks.clone();
        for r in procs.iter() {
            let first = blocks[0].clone();
            if block_test(mut md, r.kind, parent, first) {
                if block_run(mut md, r.kind, parent, mut blocks) {
                    break;
                }
            }
        }
    }
}

fn pop0(blocks: mut ref Vec[String]) -> String {
    blocks.remove(0)
}

fn push0(blocks: mut ref Vec[String], s: own String) {
    blocks.insert(0, s);
}

// BlockProcessor.detab.
fn detab(text: ref String, length: i64) -> (String, String) {
    let pre = spaces(length);
    let lines = split_on(text, "\n");
    let mut newtext: Vec[String] = Vec.new();
    for line in lines.iter() {
        if line.starts_with(pre) {
            newtext.push(after(line, length));
        } else if is_blank(line) {
            newtext.push(String.new());
        } else {
            break;
        }
    }
    let mut rest: Vec[String] = Vec.new();
    let mut k = newtext.len();
    while k < lines.len() {
        rest.push(lines[k].clone());
        k += 1;
    }
    (join(newtext, "\n"), join(rest, "\n"))
}

fn loose_detab(text: ref String, tab: i64, level: i64) -> String {
    let pre = spaces(tab * level);
    let mut lines = split_on(text, "\n");
    let mut k = 0;
    while k < lines.len() {
        if lines[k].starts_with(pre) {
            lines[k] = after(lines[k], tab * level);
        }
        k += 1;
    }
    join(lines, "\n")
}

fn code_escape(text: ref String) -> String {
    text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

fn tag_in(md: ref Md, id: i64, tags: Str) -> bool {
    in_words(tags, md.t.nodes[id].tag)
}

fn last_tag_in(md: ref Md, id: i64, tags: Str) -> bool {
    let l = md.t.last(id);
    l >= 0 and tag_in(md, l, tags)
}

fn is_pre_code(md: ref Md, id: i64) -> bool {
    id >= 0 and md.t.is(id, "pre") and md.t.len(id) > 0 and md.t.is(md.t.kid(id, 0), "code")
}

// Moves an element's text into a new <p> at its start.
fn text_to_p(md: mut ref Md, id: i64) {
    let p = md.t.el("p");
    let text = md.t.text(id);
    let atomic = md.t.nodes[id].text_atomic;
    md.t.set_text_opt(p, text, atomic);
    md.t.set_text(id, String.new());
    md.t.insert(id, 0, p);
}

fn block_test(md: mut ref Md, kind: i64, parent: i64, block: ref String) -> bool {
    let tab = md.tab_length;
    if kind == B_EMPTY {
        return block.len() == 0 or block.starts_with("\n");
    }
    if kind == B_INDENT or kind == B_DEFINDENT {
        let (items, lists) = indent_types(kind);
        if not block.starts_with(spaces(tab)) or isstate(md, "detabbed") {
            return false;
        }
        return tag_in(md, parent, items) or last_tag_in(md, parent, lists);
    }
    if kind == B_CODE {
        return block.starts_with(spaces(tab));
    }
    if kind == B_HASH {
        let rx = md.re.id(P_HASH, F_HASH);
        return md.re.search(rx, block, 0).is_some();
    }
    if kind == B_SETEXT {
        let rx = md.re.id(P_SETEXT, F_SETEXT);
        return md.re.match_at(rx, block, 0).is_some();
    }
    if kind == B_HR {
        let rx = md.re.id(P_HR, F_HR);
        match md.re.search(rx, block, 0) {
            Some(m) => {
                md.hr_start = m.start;
                md.hr_end = m.end;
                return true;
            }
            None => return false,
        }
    }
    if kind == B_OLIST or kind == B_SANE_OLIST {
        let rx = md.re.id(P_OL, F_OL);
        return md.re.match_at(rx, block, 0).is_some();
    }
    if kind == B_ULIST or kind == B_SANE_ULIST {
        let rx = md.re.id(P_UL, F_UL);
        return md.re.match_at(rx, block, 0).is_some();
    }
    if kind == B_QUOTE {
        let rx = md.re.id(P_QUOTE, F_QUOTE);
        return md.re.search(rx, block, 0).is_some();
    }
    if kind == B_ADMONITION {
        let rx = md.re.id(P_ADMONITION, F_ADMONITION);
        if md.re.search(rx, block, 0).is_some() {
            return true;
        }
        let (sib, _, _) = adm_parse_content(mut md, parent, block);
        return sib >= 0;
    }
    if kind == B_DEFLIST {
        let rx = md.re.id(P_DEF, F_DEF);
        return md.re.search(rx, block, 0).is_some();
    }
    if kind == B_TABLE {
        return table_test(mut md, block);
    }
    true
}

fn block_run(md: mut ref Md, kind: i64, parent: i64, blocks: mut ref Vec[String]) -> bool {
    if kind == B_EMPTY {
        run_empty(mut md, parent, mut blocks);
    } else if kind == B_INDENT or kind == B_DEFINDENT {
        run_indent(mut md, kind, parent, mut blocks);
    } else if kind == B_CODE {
        run_code(mut md, parent, mut blocks);
    } else if kind == B_HASH {
        run_hash(mut md, parent, mut blocks);
    } else if kind == B_SETEXT {
        run_setext(mut md, parent, mut blocks);
    } else if kind == B_HR {
        run_hr(mut md, parent, mut blocks);
    } else if kind == B_OLIST or kind == B_ULIST or kind == B_SANE_OLIST or kind == B_SANE_ULIST {
        run_list(mut md, kind, parent, mut blocks);
    } else if kind == B_QUOTE {
        run_quote(mut md, parent, mut blocks);
    } else if kind == B_REFERENCE {
        return run_reference(mut md, mut blocks);
    } else if kind == B_PARAGRAPH {
        run_paragraph(mut md, parent, mut blocks);
    } else if kind == B_ADMONITION {
        run_admonition(mut md, parent, mut blocks);
    } else if kind == B_ABBR {
        return run_abbr_block(mut md, mut blocks);
    } else if kind == B_DEFLIST {
        return run_deflist(mut md, parent, mut blocks);
    } else if kind == B_FOOTNOTE {
        return run_footnote_block(mut md, mut blocks);
    } else if kind == B_TABLE {
        run_table(mut md, parent, mut blocks);
    } else if kind == B_MD_BLOCK {
        return run_md_block(mut md, parent, mut blocks);
    } else {
        panic(f"block processor {kind}");
    }
    true
}

fn run_empty(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let block = pop0(mut blocks);
    let mut filler = "\n\n";
    if block.len() > 0 {
        filler = "\n";
        let rest = after(block, 1);
        if rest.len() > 0 {
            push0(mut blocks, rest);
        }
    }
    let sibling = md.t.last(parent);
    if is_pre_code(md, sibling) {
        let code = md.t.kid(sibling, 0);
        let t = pystr(md.t.text(code));
        md.t.set_text_atomic(code, f"{t}{filler}");
    }
}

// ITEM_TYPES and LIST_TYPES of ListIndentProcessor and DefListIndentProcessor.
fn indent_types(kind: i64) -> (Str, Str) {
    if kind == B_DEFINDENT {
        (" dd li ", " dl ol ul ")
    } else {
        (" li ", " ul ol ")
    }
}

fn run_indent(md: mut ref Md, kind: i64, parent: i64, blocks: mut ref Vec[String]) {
    let (items, lists) = indent_types(kind);
    let block0 = pop0(mut blocks);
    let (level, sibling) = indent_level(mut md, kind, parent, block0);
    let block = loose_detab(block0, md.tab_length, level);
    set_state(mut md, "detabbed");
    if tag_in(md, parent, items) {
        if md.t.len(parent) > 0 and last_tag_in(md, parent, lists) {
            let l = md.t.last(parent);
            parse_one(mut md, l, block);
        } else {
            parse_one(mut md, parent, block);
        }
    } else if tag_in(md, sibling, items) {
        parse_one(mut md, sibling, block);
    } else if md.t.len(sibling) > 0 and last_tag_in(md, sibling, items) {
        let l = md.t.last(sibling);
        if md.t.has_text(l) {
            text_to_p(mut md, l);
        }
        parse_chunk(mut md, l, block);
    } else {
        let tag = if kind == B_DEFINDENT { "dd" } else { "li" };
        let li = md.t.sub(sibling, tag);
        parse_one(mut md, li, block);
    }
    reset_state(mut md);
}

fn indent_level(md: mut ref Md, kind: i64, parent0: i64, block: ref String) -> (i64, i64) {
    let (items, lists) = indent_types(kind);
    let rx = md.re.id(P_LIST_INDENT, F_LIST_INDENT);
    let indent = match md.re.match_at(rx, block, 0) {
        Some(m) => grp(block, m, 1).len() / md.tab_length,
        None => 0,
    };
    let mut level = if isstate(md, "list") { 1 } else { 0 };
    let mut parent = parent0;
    while indent > level {
        let child = md.t.last(parent);
        if child >= 0 and (tag_in(md, child, lists) or tag_in(md, child, items)) {
            if tag_in(md, child, lists) {
                level += 1;
            }
            parent = child;
        } else {
            break;
        }
    }
    (level, parent)
}

fn run_code(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let sibling = md.t.last(parent);
    let block0 = pop0(mut blocks);
    let tab = md.tab_length;
    let mut rest = String.new();
    if is_pre_code(md, sibling) {
        let code = md.t.kid(sibling, 0);
        let (b, r) = detab(block0, tab);
        rest = r;
        let t = pystr(md.t.text(code));
        md.t.set_text_atomic(code, f"{t}\n{code_escape(rstrip_ws(b))}\n");
    } else {
        let pre = md.t.sub(parent, "pre");
        let code = md.t.sub(pre, "code");
        let (b, r) = detab(block0, tab);
        rest = r;
        md.t.set_text_atomic(code, f"{code_escape(rstrip_ws(b))}\n");
    }
    if rest.len() > 0 {
        push0(mut blocks, rest);
    }
}

fn quote_clean(md: mut ref Md, line: ref String) -> String {
    let rx = md.re.id(P_QUOTE, F_QUOTE);
    let m = md.re.match_at(rx, line, 0);
    if strip_ws(line) == ">" {
        return String.new();
    }
    match m {
        Some(mm) => grp(line, mm, 2),
        None => line.clone(),
    }
}

fn run_quote(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let mut block = pop0(mut blocks);
    let rx = md.re.id(P_QUOTE, F_QUOTE);
    match md.re.search(rx, block, 0) {
        Some(m) => {
            let before = upto(block, m.start);
            parse_one(mut md, parent, before);
            let mut cleaned: Vec[String] = Vec.new();
            for line in split_on(after(block, m.start), "\n").iter() {
                cleaned.push(quote_clean(mut md, line));
            }
            block = join(cleaned, "\n");
        }
        None => {}
    }
    let sibling = md.t.last(parent);
    let quote = if sibling >= 0 and md.t.is(sibling, "blockquote") { sibling } else { md.t.sub(parent, "blockquote") };
    set_state(mut md, "blockquote");
    parse_chunk(mut md, quote, block);
    reset_state(mut md);
}

fn list_items(md: mut ref Md, kind: i64, block: ref String) -> Vec[String] {
    let child_pat = if kind == B_SANE_OLIST { P_SANE_OL_CHILD } else if kind == B_SANE_ULIST { P_SANE_UL_CHILD } else { P_OL_CHILD };
    let child_rx = md.re.id(child_pat, 32);
    let indent_rx = md.re.id(P_OL_INDENT, F_OL_INDENT);
    let is_ol = kind == B_OLIST or kind == B_SANE_OLIST;
    let pre = spaces(md.tab_length);
    let mut items: Vec[String] = Vec.new();
    for line in split_on(block, "\n").iter() {
        match md.re.match_at(child_rx, line, 0) {
            Some(m) => {
                if items.len() == 0 and is_ol {
                    let g1 = grp(line, m, 1);
                    let irx = md.re.id(P_INTEGER, F_INTEGER);
                    let im = md.re.match_at(irx, g1, 0).unwrap();
                    md.olist_startswith = grp(g1, im, 0);
                }
                items.push(grp(line, m, 3));
            }
            None => {
                let n = items.len();
                if md.re.match_at(indent_rx, line, 0).is_some() {
                    if items[n - 1].starts_with(pre) {
                        items[n - 1] = f"{items[n - 1]}\n{line}";
                    } else {
                        items.push(line.clone());
                    }
                } else {
                    items[n - 1] = f"{items[n - 1]}\n{line}";
                }
            }
        }
    }
    items
}

fn run_list(md: mut ref Md, kind: i64, parent: i64, blocks: mut ref Vec[String]) {
    let tag = if kind == B_OLIST or kind == B_SANE_OLIST { "ol" } else { "ul" };
    let lazy_ol = kind != B_SANE_OLIST;
    let siblings = if kind == B_SANE_OLIST { " ol " } else if kind == B_SANE_ULIST { " ul " } else { " ol ul " };
    let block = pop0(mut blocks);
    let mut items = list_items(mut md, kind, block);
    let sibling = md.t.last(parent);
    let mut lst = -1;
    if sibling >= 0 and tag_in(md, sibling, siblings) {
        lst = sibling;
        let last_li = md.t.last(lst);
        if md.t.has_text(last_li) {
            text_to_p(mut md, last_li);
        }
        let lch = md.t.last(last_li);
        if lch >= 0 and md.t.has_tail(lch) {
            let p = md.t.sub(last_li, "p");
            md.t.set_text(p, lstrip_ws(md.t.tail_s(lch)));
            md.t.set_tail(lch, String.new());
        }
        let li = md.t.sub(lst, "li");
        set_state(mut md, "looselist");
        let first = items.remove(0);
        parse_one(mut md, li, first);
        reset_state(mut md);
    } else if md.t.is(parent, "ol") or md.t.is(parent, "ul") {
        lst = parent;
    } else {
        lst = md.t.sub(parent, tag);
        if not lazy_ol and md.olist_startswith != "1" {
            let st = md.olist_startswith.clone();
            md.t.set(lst, "start", st);
        }
    }
    set_state(mut md, "list");
    let pre = spaces(md.tab_length);
    for item in items.iter() {
        if item.starts_with(pre) {
            let l = md.t.last(lst);
            parse_one(mut md, l, item.clone());
        } else {
            let li = md.t.sub(lst, "li");
            parse_one(mut md, li, item.clone());
        }
    }
    reset_state(mut md);
}

fn run_hash(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let block = pop0(mut blocks);
    let rx = md.re.id(P_HASH, F_HASH);
    match md.re.search(rx, block, 0) {
        Some(m) => {
            let before = upto(block, m.start);
            let mut aft = after(block, m.end);
            if before.len() > 0 {
                parse_one(mut md, parent, before);
            }
            let level = grp(block, m, 1).len();
            let h = md.t.sub(parent, f"h{level}");
            md.t.set_text(h, strip_ws(grp(block, m, 2)));
            if aft.len() > 0 {
                if isstate(md, "looselist") {
                    aft = loose_detab(aft, md.tab_length, 1);
                }
                push0(mut blocks, aft);
            }
        }
        None => {}
    }
}

fn run_setext(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let lines = split_on(pop0(mut blocks), "\n");
    let level = if lines[1].starts_with("=") { 1 } else { 2 };
    let h = md.t.sub(parent, f"h{level}");
    md.t.set_text(h, strip_ws(lines[0]));
    if lines.len() > 2 {
        let mut rest: Vec[String] = Vec.new();
        let mut k = 2;
        while k < lines.len() {
            rest.push(lines[k].clone());
            k += 1;
        }
        push0(mut blocks, join(rest, "\n"));
    }
}

fn run_hr(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let block = pop0(mut blocks);
    let start = md.hr_start;
    let end = md.hr_end;
    let prelines = rstrip_set(upto(block, start), "\n");
    if prelines.len() > 0 {
        parse_one(mut md, parent, prelines);
    }
    md.t.sub(parent, "hr");
    let postlines = lstrip_set(after(block, end), "\n");
    if postlines.len() > 0 {
        push0(mut blocks, postlines);
    }
}

fn run_reference(md: mut ref Md, blocks: mut ref Vec[String]) -> bool {
    let block = pop0(mut blocks);
    let rx = md.re.id(P_REFERENCE, F_REFERENCE);
    match md.re.search(rx, block, 0) {
        Some(m) => {
            let id = lower(strip_ws(grp(block, m, 1)));
            let link = rstrip_set(lstrip_set(grp(block, m, 2), "<"), ">");
            let g5 = grp(block, m, 5);
            let title: Option[String] = if g5.len() > 0 {
                Some(g5)
            } else if has(m, 6) {
                Some(grp(block, m, 6))
            } else {
                None
            };
            md.references.insert(id, (link, title));
            let rest = after(block, m.end);
            if not is_blank(rest) {
                push0(mut blocks, lstrip_set(rest, "\n"));
            }
            let before = upto(block, m.start);
            if not is_blank(before) {
                push0(mut blocks, rstrip_set(before, "\n"));
            }
            true
        }
        None => {
            push0(mut blocks, block);
            false
        }
    }
}

fn run_paragraph(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let block = pop0(mut blocks);
    if is_blank(block) {
        return;
    }
    if isstate(md, "list") {
        let sibling = md.t.last(parent);
        if sibling >= 0 {
            if md.t.has_tail(sibling) {
                let t = md.t.tail_s(sibling);
                md.t.set_tail(sibling, f"{t}\n{block}");
            } else {
                md.t.set_tail(sibling, f"\n{block}");
            }
        } else if md.t.has_text(parent) {
            let t = md.t.text_s(parent);
            md.t.set_text(parent, f"{t}\n{block}");
        } else {
            md.t.set_text(parent, lstrip_ws(block));
        }
    } else {
        let p = md.t.sub(parent, "p");
        md.t.set_text(p, lstrip_ws(block));
    }
}

// --------------------------------------------------------- admonition

fn adm_parse_content(md: mut ref Md, parent: i64, block0: ref String) -> (i64, String, String) {
    let tab = md.tab_length;
    let old_block = block0.clone();
    let mut block = block0.clone();
    let mut the_rest = String.new();
    if md.adm_sibling >= 0 {
        let sibling = md.adm_sibling;
        let (b, r) = detab(block, md.adm_indent);
        md.adm_sibling = -1;
        md.adm_indent = 0;
        return (sibling, b, r);
    }
    let mut sibling = md.t.last(parent);
    if sibling < 0 or not md.t.is(sibling, "div") or find_s(md.t.get_or(sibling, "class", ""), "admonition") == -1 {
        sibling = -1;
    } else {
        let mut last_child = md.t.last(sibling);
        let mut indent = 0;
        while last_child >= 0 {
            if sibling >= 0 and block.starts_with(spaces(tab * 2)) and tag_in(md, last_child, " ul ol dl ") {
                sibling = md.t.last(last_child);
                last_child = if sibling >= 0 { md.t.last(sibling) } else { -1 };
                block = after(block, tab);
                indent += tab;
            } else {
                last_child = -1;
            }
        }
        if not block.starts_with(spaces(tab)) {
            sibling = -1;
        }
        if sibling >= 0 {
            indent += tab;
            let (b, r) = detab(old_block, indent);
            block = b;
            the_rest = r;
            md.adm_sibling = sibling;
            md.adm_indent = indent;
        }
    }
    (sibling, block, the_rest)
}

fn run_admonition(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let block0 = pop0(mut blocks);
    let rx = md.re.id(P_ADMONITION, F_ADMONITION);
    let m = md.re.search(rx, block0, 0);
    let mut block = String.new();
    let mut the_rest = String.new();
    let mut sibling = -1;
    match m {
        Some(ref mm) => {
            if mm.start > 0 {
                parse_one(mut md, parent, upto(block0, mm.start));
            }
            let (b, r) = detab(after(block0, mm.end), md.tab_length);
            block = b;
            the_rest = r;
        }
        None => {
            let (s, b, r) = adm_parse_content(mut md, parent, block0);
            sibling = s;
            block = b;
            the_rest = r;
        }
    }
    let mut div = -1;
    match m {
        Some(mm) => {
            let mut klass = lower(grp(block0, mm, 1));
            let srx = md.re.id(P_SPACES, F_SPACES);
            klass = md.re.sub(srx, klass, " ");
            let title: Option[String] = if not has(mm, 2) {
                let first = split_on(klass, " ")[0].clone();
                Some(capitalize(first))
            } else {
                let t = grp(block0, mm, 2);
                if t.len() == 0 { None } else { Some(t) }
            };
            div = md.t.sub(parent, "div");
            md.t.set(div, "class", f"admonition {klass}");
            match title {
                Some(t) => {
                    if t.len() > 0 {
                        let p = md.t.sub(div, "p");
                        md.t.set_text(p, t);
                        md.t.set(p, "class", "admonition-title".to_string());
                    }
                }
                None => {}
            }
        }
        None => {
            if (md.t.is(sibling, "li") or md.t.is(sibling, "dd")) and md.t.has_text(sibling) {
                let text = md.t.text(sibling);
                let atomic = md.t.nodes[sibling].text_atomic;
                md.t.set_text(sibling, String.new());
                let p = md.t.sub(sibling, "p");
                md.t.set_text_opt(p, text, atomic);
            }
            div = sibling;
        }
    }
    parse_chunk(mut md, div, block);
    if the_rest.len() > 0 {
        push0(mut blocks, the_rest);
    }
}

// ---------------------------------------------------------------- abbr

fn odict_get(d: ref Vec[(String, String)], key: ref String) -> Option[String] {
    for kv in d.iter() {
        if kv.0 == *key {
            return Some(kv.1.clone());
        }
    }
    None
}

fn odict_set(d: mut ref Vec[(String, String)], key: ref String, val: own String) {
    let mut k = 0;
    while k < d.len() {
        if d[k].0 == *key {
            d[k] = (key.clone(), val);
            return;
        }
        k += 1;
    }
    d.push((key.clone(), val));
}

fn odict_pop(d: mut ref Vec[(String, String)], key: ref String) {
    let mut k = 0;
    while k < d.len() {
        if d[k].0 == *key {
            d.remove(k);
            return;
        }
        k += 1;
    }
}

fn run_abbr_block(md: mut ref Md, blocks: mut ref Vec[String]) -> bool {
    let block = pop0(mut blocks);
    let rx = md.re.id(P_ABBR_DEF, F_ABBR_DEF);
    match md.re.search(rx, block, 0) {
        Some(m) => {
            let abbr = strip_ws(grp(block, m, 1));
            let title = strip_ws(grp(block, m, 2));
            if title.len() > 0 and abbr.len() > 0 {
                if title == "''" or title == "\"\"" {
                    odict_pop(mut md.abbrs, abbr);
                } else {
                    odict_set(mut md.abbrs, abbr, title);
                }
                let rest = after(block, m.end);
                if not is_blank(rest) {
                    push0(mut blocks, lstrip_set(rest, "\n"));
                }
                let before = upto(block, m.start);
                if not is_blank(before) {
                    push0(mut blocks, rstrip_set(before, "\n"));
                }
                return true;
            }
        }
        None => {}
    }
    push0(mut blocks, block);
    false
}

// ------------------------------------------------------------ def_list

fn run_deflist(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) -> bool {
    let raw_block = pop0(mut blocks);
    let rx = md.re.id(P_DEF, F_DEF);
    let m = md.re.search(rx, raw_block, 0).unwrap();
    let mut terms: Vec[String] = Vec.new();
    for term in split_on(upto(raw_block, m.start), "\n").iter() {
        if not is_blank(term) {
            terms.push(strip_ws(term));
        }
    }
    let block = after(raw_block, m.end);
    let nrx = md.re.id(P_DEF_NO_INDENT, F_DEF_NO_INDENT);
    let mut d = String.new();
    let mut the_rest = String.new();
    if md.re.match_at(nrx, block, 0).is_some() {
        d = block;
    } else {
        let (a, b) = detab(block, md.tab_length);
        d = a;
        the_rest = b;
    }
    let g2 = grp(raw_block, m, 2);
    if d.len() > 0 {
        d = f"{g2}\n{d}";
    } else {
        d = g2;
    }
    let mut sibling = md.t.last(parent);
    if terms.len() == 0 and sibling < 0 {
        push0(mut blocks, raw_block);
        return false;
    }
    let mut state = "list";
    if terms.len() == 0 and md.t.is(sibling, "p") {
        state = "looselist";
        terms = split_on(md.t.text_s(sibling), "\n");
        md.t.remove(parent, sibling);
        sibling = md.t.last(parent);
    }
    let mut dl = -1;
    if sibling >= 0 and md.t.is(sibling, "dl") {
        dl = sibling;
        let l = md.t.last(dl);
        if terms.len() == 0 and l >= 0 and md.t.is(l, "dd") and md.t.len(l) > 0 {
            state = "looselist";
        }
    } else {
        dl = md.t.sub(parent, "dl");
    }
    for term in terms.iter() {
        let dt = md.t.sub(dl, "dt");
        md.t.set_text(dt, term.clone());
    }
    set_state(mut md, state);
    let dd = md.t.sub(dl, "dd");
    parse_one(mut md, dd, d);
    reset_state(mut md);
    if the_rest.len() > 0 {
        push0(mut blocks, the_rest);
    }
    true
}

// ----------------------------------------------------------- footnotes

fn fn_detab(block: ref String) -> String {
    let mut lines = split_on(block, "\n");
    let mut k = 0;
    while k < lines.len() {
        if lines[k].starts_with("    ") {
            lines[k] = after(lines[k], 4);
        }
        k += 1;
    }
    join(lines, "\n")
}

fn run_footnote_block(md: mut ref Md, blocks: mut ref Vec[String]) -> bool {
    let block = pop0(mut blocks);
    let rx = md.re.id(P_FN_BLOCK, F_FN_BLOCK);
    match md.re.search(rx, block, 0) {
        Some(m) => {
            let id = grp(block, m, 1);
            let mut fn_blocks: Vec[String] = vec![grp(block, m, 2)];
            let therest = lstrip_set(after(block, m.end), "\n");
            match md.re.search(rx, therest, 0) {
                Some(m2) => {
                    let before = rstrip_set(upto(therest, m2.start), "\n");
                    fn_blocks[0] = lstrip_set(f"{fn_blocks[0]}\n{fn_detab(before)}", "\n");
                    push0(mut blocks, after(therest, m2.start));
                }
                None => {
                    fn_blocks[0] = strip_set(f"{fn_blocks[0]}\n{fn_detab(therest)}", "\n");
                    let more = detect_tabbed(mut md, mut blocks);
                    fn_blocks.extend(more);
                }
            }
            let footnote = join(fn_blocks, "\n\n");
            odict_set(mut md.fn_notes, id, rstrip_ws(footnote));
            let before = upto(block, m.start);
            if not is_blank(before) {
                push0(mut blocks, rstrip_set(before, "\n"));
            }
            true
        }
        None => {
            push0(mut blocks, block);
            false
        }
    }
}

fn detect_tabbed(md: mut ref Md, blocks: mut ref Vec[String]) -> Vec[String] {
    let rx = md.re.id(P_FN_BLOCK, F_FN_BLOCK);
    let mut out: Vec[String] = Vec.new();
    while blocks.len() > 0 {
        if blocks[0].starts_with("    ") {
            let block = pop0(mut blocks);
            match md.re.search(rx, block, 0) {
                Some(m) => {
                    let before = rstrip_set(upto(block, m.start), "\n");
                    out.push(fn_detab(before));
                    push0(mut blocks, after(block, m.start));
                    break;
                }
                None => out.push(fn_detab(block)),
            }
        } else {
            break;
        }
    }
    out
}

// -------------------------------------------------------------- tables

fn table_test(md: mut ref Md, block: ref String) -> bool {
    let mut is_table = false;
    let mut rows: Vec[String] = Vec.new();
    for row in split_on(block, "\n").iter() {
        rows.push(strip_set(row, " "));
    }
    if rows.len() > 1 {
        let header0 = rows[0].clone();
        md.table_border = 0;
        if header0.starts_with("|") {
            md.table_border = md.table_border | 1;
        }
        let erx = md.re.id(P_TABLE_END_BORDER, F_TABLE_END_BORDER);
        if md.re.search(erx, header0, 0).is_some() {
            md.table_border = md.table_border | 2;
        }
        let row = split_row(mut md, header0);
        let row0_len = row.len();
        is_table = row0_len > 1;
        if not is_table and row0_len == 1 and md.table_border != 0 {
            let mut index = 1;
            while index < rows.len() {
                is_table = rows[index].starts_with("|");
                if not is_table {
                    is_table = md.re.search(erx, rows[index], 0).is_some();
                }
                if not is_table {
                    break;
                }
                index += 1;
            }
        }
        if is_table {
            let row1 = split_row(mut md, rows[1]);
            let mut ok = row1.len() == row0_len;
            if ok {
                for cell in row1.iter() {
                    for c in cell.chars() {
                        if not (c == '|' or c == ':' or c == '-' or c == ' ') {
                            ok = false;
                        }
                    }
                }
            }
            is_table = ok;
            if is_table {
                md.table_sep = row1;
            }
        }
    }
    is_table
}

fn run_table(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) {
    let block = split_on(pop0(mut blocks), "\n");
    let header = strip_set(block[0], " ");
    let mut rows: Vec[String] = Vec.new();
    if block.len() >= 3 {
        let mut k = 2;
        while k < block.len() {
            rows.push(block[k].clone());
            k += 1;
        }
    }
    let mut align: Vec[String] = Vec.new();
    for c0 in md.table_sep.clone().iter() {
        let c = strip_set(c0, " ");
        if c.starts_with(":") and c.ends_with(":") {
            align.push("center".to_string());
        } else if c.starts_with(":") {
            align.push("left".to_string());
        } else if c.ends_with(":") {
            align.push("right".to_string());
        } else {
            align.push(String.new());
        }
    }
    let table = md.t.sub(parent, "table");
    let thead = md.t.sub(table, "thead");
    build_row(mut md, header, thead, align);
    let tbody = md.t.sub(table, "tbody");
    if rows.len() == 0 {
        let tr = md.t.sub(tbody, "tr");
        let mut count = align.len();
        while count > 0 {
            md.t.sub(tr, "td");
            count -= 1;
        }
    } else {
        for row in rows.iter() {
            build_row(mut md, strip_set(row, " "), tbody, align);
        }
    }
}

fn build_row(md: mut ref Md, row: ref String, parent: i64, align: ref Vec[String]) {
    let tr = md.t.sub(parent, "tr");
    let tag = if md.t.is(parent, "thead") { "th" } else { "td" };
    let cells = split_row(mut md, row);
    let use_align = val_truthy(md.tables_cfg.get("use_align_attribute"));
    let mut i = 0;
    while i < align.len() {
        let c = md.t.sub(tr, tag);
        if i < cells.len() {
            md.t.set_text(c, strip_set(cells[i], " "));
        } else {
            md.t.set_text(c, String.new());
        }
        let a = align[i].clone();
        if a.len() > 0 {
            if use_align {
                md.t.set(c, "align", a);
            } else {
                md.t.set(c, "style", f"text-align: {a};");
            }
        }
        i += 1;
    }
}

fn split_row(md: mut ref Md, row0: ref String) -> Vec[String] {
    let mut row = row0.clone();
    if md.table_border != 0 {
        if row.starts_with("|") {
            row = after(row, 1);
        }
        let erx = md.re.id(P_TABLE_END_BORDER, F_TABLE_END_BORDER);
        row = md.re.sub(erx, row, "");
    }
    split_cells(mut md, row)
}

fn split_cells(md: mut ref Md, row: ref String) -> Vec[String] {
    let rx = md.re.id(P_TABLE_PIPES, F_TABLE_PIPES);
    let mut pipes: Vec[i64] = Vec.new();
    let mut tics: Vec[i64] = Vec.new();
    let mut tic_points: Vec[(i64, i64, i64)] = Vec.new();
    let mut tic_region: Vec[(i64, i64)] = Vec.new();
    for m in md.re.find_all(rx, row, 0).iter() {
        if has(m, 2) and gend(m, 2) > gstart(m, 2) {
            tics.push(gend(m, 2) - gstart(m, 2) - 1);
            tic_points.push((gstart(m, 2), gend(m, 2) - 1, 1));
        } else if has(m, 3) and gend(m, 3) > gstart(m, 3) {
            tics.push(gend(m, 3) - gstart(m, 3));
            tic_points.push((gstart(m, 3), gend(m, 3) - 1, 0));
        } else if has(m, 5) and gend(m, 5) > gstart(m, 5) {
            pipes.push(gstart(m, 5));
        }
    }
    let mut pos = 0;
    let tic_len = tics.len();
    while pos < tic_len {
        let tic_size = tics[pos] - tic_points[pos].2;
        let mut index = -1;
        if tic_size != 0 {
            let mut k = pos + 1;
            while k < tic_len {
                if tics[k] == tic_size {
                    index = k - pos;
                    break;
                }
                k += 1;
            }
        }
        if index < 0 {
            pos += 1;
        } else {
            tic_region.push((tic_points[pos].0, tic_points[pos + index].1));
            pos += index + 1;
        }
    }
    let mut good: Vec[i64] = Vec.new();
    for pipe in pipes.iter() {
        let mut throw_out = false;
        for region in tic_region.iter() {
            if *pipe < region.0 {
                break;
            } else if region.0 <= *pipe and *pipe <= region.1 {
                throw_out = true;
                break;
            }
        }
        if not throw_out {
            good.push(*pipe);
        }
    }
    let mut elements: Vec[String] = Vec.new();
    let mut at = 0;
    for pipe in good.iter() {
        elements.push(sl(row, at, *pipe));
        at = *pipe + 1;
    }
    elements.push(after(row, at));
    elements
}

// ---------------------------------------------------------- md_in_html

fn placeholder_index(md: mut ref Md, s: ref String, m: ref M) -> i64 {
    parse_int(grp(s, m, 1))
}

fn run_md_block(md: mut ref Md, parent: i64, blocks: mut ref Vec[String]) -> bool {
    let rx = md.re.id(P_HTML_PH, F_HTML_PH);
    let first = blocks[0].clone();
    match md.re.match_at(rx, first, 0) {
        Some(m) => {
            let index = placeholder_index(mut md, first, m);
            if index < md.stash.len() and md.stash[index].is_el {
                let element = md.stash[index].el;
                let block = pop0(mut blocks);
                md.t.append(parent, element);
                parse_element_content(mut md, element);
                md.stash[index] = Stashed { is_el: false, html: String.new(), el: -1 };
                let content = after(block, m.end);
                if content.len() > 0 {
                    push0(mut blocks, content);
                }
                return true;
            }
            false
        }
        None => false,
    }
}

fn parse_element_content(md: mut ref Md, element: i64) {
    let md_attr = match md.t.del(element, "markdown") {
        Some(v) => v,
        None => "off".to_string(),
    };
    if md_attr == "block" {
        if md.t.has_text(element) {
            let block = rstrip_set(md.t.text_s(element), "\n");
            md.t.set_text(element, String.new());
            let mut blocks = split_on(block, "\n\n");
            parse_blocks(mut md, element, mut blocks);
        }
    } else if md_attr == "span" {
        let block = md.t.text_s(element);
        md.t.set_text(element, String.new());
        let mut child = -1;
        let mut start = 0;
        let rx = md.re.id(P_HTML_PH, F_HTML_PH);
        for m in md.re.find_all(rx, block, 0).iter() {
            let index = parse_int(grp(block, m, 1));
            let end = m.start;
            let piece = sl(block, start, end);
            if index < md.stash.len() and md.stash[index].is_el {
                let el = md.stash[index].el;
                if child < 0 {
                    let t = md.t.text_s(element);
                    md.t.set_text(element, t + piece);
                } else {
                    let t = md.t.tail_s(child);
                    md.t.set_tail(child, t + piece);
                }
                md.t.append(element, el);
                parse_element_content(mut md, el);
                child = el;
                if md.t.tail(child).is_none() {
                    md.t.set_tail(child, String.new());
                }
                md.stash[index] = Stashed { is_el: false, html: String.new(), el: -1 };
            } else if child < 0 {
                let t = md.t.text_s(element);
                md.t.set_text(element, t + piece);
            } else {
                let t = md.t.tail_s(child);
                md.t.set_tail(child, t + piece);
            }
            start = end;
        }
        let piece = after(block, start);
        if child < 0 {
            let t = md.t.text_s(element);
            md.t.set_text(element, t + piece);
        } else {
            let t = md.t.tail_s(child);
            md.t.set_tail(child, t + piece);
        }
    } else {
        let t = md.t.text_s(element);
        md.t.set_text_atomic(element, t);
        for child in md.t.kids(element).iter() {
            parse_element_content(mut md, *child);
            if md.t.has_tail(*child) {
                let tl = md.t.tail_s(*child);
                md.t.set_tail_atomic(*child, tl);
            }
        }
    }
}

// ===================================================== inline patterns
// treeprocessors.InlineProcessor and inlinepatterns: each pattern's
// regular expression is searched from a start index, its handleMatch
// returns a node (an element or text) and the span it replaces, and the
// node is stashed behind a placeholder until the text is rebuilt around
// it. The ancestor lists Python keeps are only read by ANCESTOR_EXCLUDES,
// which no pattern sets, so they are not kept here.

// A handleMatch result: kind 0 no node, 1 element, 2 text; ok false for
// Python's (None, None, None).
struct Hm {
    kind: i64,
    el: i64,
    text: String,
    start: i64,
    end: i64,
    ok: bool,
}

fn hm_none(start: i64, end: i64) -> Hm {
    Hm { kind: 0, el: -1, text: String.new(), start: start, end: end, ok: true }
}

fn hm_skip() -> Hm {
    Hm { kind: 0, el: -1, text: String.new(), start: -1, end: -1, ok: false }
}

fn hm_el(el: i64, start: i64, end: i64) -> Hm {
    Hm { kind: 1, el: el, text: String.new(), start: start, end: end, ok: true }
}

fn hm_text(text: own String, start: i64, end: i64) -> Hm {
    Hm { kind: 2, el: -1, text: text, start: start, end: end, ok: true }
}

fn inline_regs(md: ref Md, w: i64) -> Vec[Reg] {
    if w == 0 { md.inl.clone() } else { md.smarty_inl.clone() }
}

// The stash index an id names, or -1 ('%04d' ids).
fn stash_index(md: ref Md, w: i64, id: ref String) -> i64 {
    if id.len() == 0 {
        return -1;
    }
    for c in id.chars() {
        if c < '0' or c > '9' {
            return -1;
        }
    }
    let n = parse_int(id);
    if n < md.ips[w].stashed.len() and pad4(n) == *id {
        return n;
    }
    -1
}

fn stash_node(md: mut ref Md, w: i64, node: own Inl) -> String {
    let id = pad4(md.ips[w].stashed.len());
    md.ips[w].stashed.push(node);
    f"{INLINE_PH_PREFIX}{id}{ETX}"
}

fn handle_inline(md: mut ref Md, w: i64, data0: own String, atomic: bool, pattern_index: i64) -> String {
    if atomic {
        return data0;
    }
    let pats = inline_regs(md, w);
    let mut data = data0;
    let mut start = 0;
    let mut pi = pattern_index;
    let count = pats.len();
    while pi < count {
        let (d, matched, s) = apply_pattern(mut md, w, pats[pi], data, pi, start);
        data = d;
        start = s;
        if not matched {
            pi += 1;
        }
    }
    data
}

fn apply_pattern(md: mut ref Md, w: i64, pat: ref Reg, data: own String, pattern_index: i64, start_index: i64) -> (String, bool, i64) {
    let rx = if pat.kind == I_DELIM { md.dp.rx } else { pat.rx };
    let mut at = start_index;
    let mut must_advance = false;
    let mut res = hm_skip();
    let mut found = false;
    while at <= data.len() {
        let m = match md.re.run(rx, data, at, must_advance, 0) {
            Some(x) => x,
            None => break,
        };
        must_advance = m.end == m.start;
        at = m.end;
        let h = handle_match(mut md, w, pat, m, data);
        if not h.ok {
            continue;
        }
        res = h;
        found = true;
        break;
    }
    if not found {
        return (data, false, 0);
    }
    if res.kind == 0 {
        return (data, true, res.end);
    }
    let mut node = Inl { is_el: false, el: -1, text: String.new() };
    if res.kind == 1 {
        let el = res.el;
        if not md.t.nodes[el].text_atomic {
            let mut group = vec![el];
            group.extend(md.t.kids(el));
            for child in group.iter() {
                if md.t.has_text(*child) and not md.t.nodes[*child].text_atomic {
                    let t = md.t.text_s(*child);
                    let nt = handle_inline(mut md, w, t, false, pattern_index + 1);
                    md.t.set_text(*child, nt);
                }
                if md.t.has_tail(*child) and not md.t.nodes[*child].tail_atomic {
                    let t = md.t.tail_s(*child);
                    let nt = handle_inline(mut md, w, t, false, pattern_index);
                    md.t.set_tail(*child, nt);
                }
            }
        }
        node = Inl { is_el: true, el: el, text: String.new() };
    } else {
        node = Inl { is_el: false, el: -1, text: res.text };
    }
    let placeholder = stash_node(mut md, w, node);
    let out = upto(data, res.start) + placeholder.clone() + after(data, res.end);
    (out, true, res.start + placeholder.len())
}

// ------------------------------------------------- placeholders

// linkText: text joins the last result's tail, or the parent's tail or
// text.
fn link_text(md: mut ref Md, result: ref Vec[i64], parent: i64, is_text: bool, text: ref String, atomic: bool) {
    if text.len() == 0 {
        return;
    }
    if result.len() > 0 {
        let r = result[result.len() - 1];
        if md.t.has_tail(r) {
            let t = md.t.tail_s(r);
            md.t.set_tail(r, t + text.clone());
        } else {
            md.t.set_tail_opt(r, Some(text.clone()), atomic);
        }
    } else if not is_text {
        if md.t.has_tail(parent) {
            let t = md.t.tail_s(parent);
            md.t.set_tail(parent, t + text.clone());
        } else {
            md.t.set_tail_opt(parent, Some(text.clone()), atomic);
        }
    } else if md.t.has_text(parent) {
        let t = md.t.text_s(parent);
        md.t.set_text(parent, t + text.clone());
    } else {
        md.t.set_text_opt(parent, Some(text.clone()), atomic);
    }
}

fn process_placeholders(md: mut ref Md, w: i64, data0: ref Option[String], atomic: bool, parent: i64, is_text: bool) -> Vec[i64] {
    let mut result: Vec[i64] = Vec.new();
    let mut data = opt_text(data0);
    let rx = md.re.id(P_INLINE_PH, F_INLINE_PH);
    let mut start = 0;
    while data.len() > 0 {
        let index = find_from(data, INLINE_PH_PREFIX, start);
        if index != -1 {
            let mut id = String.new();
            let mut ph_end = index + 1;
            let mut has_id = false;
            match md.re.search(rx, data, index) {
                Some(m) => {
                    id = grp(data, m, 1);
                    ph_end = m.end;
                    has_id = true;
                }
                None => {}
            }
            let si = if has_id { stash_index(md, w, id) } else { -1 };
            if si >= 0 {
                let node_is_el = md.ips[w].stashed[si].is_el;
                if index > 0 {
                    let text = sl(data, start, index);
                    link_text(mut md, result, parent, is_text, text, false);
                }
                if node_is_el {
                    let node = md.ips[w].stashed[si].el;
                    let mut group = vec![node];
                    group.extend(md.t.kids(node));
                    for child in group.iter() {
                        if md.t.has_tail(*child) and not is_blank(md.t.tail_s(*child)) {
                            process_element_text(mut md, w, node, *child, false);
                        }
                        if md.t.has_text(*child) and not is_blank(md.t.text_s(*child)) {
                            process_element_text(mut md, w, *child, *child, true);
                        }
                    }
                    start = ph_end;
                    result.push(node);
                } else {
                    let text = md.ips[w].stashed[si].text.clone();
                    link_text(mut md, result, parent, is_text, text, false);
                    start = ph_end;
                    continue;
                }
            } else {
                let end = index + INLINE_PH_PREFIX.len();
                let text = sl(data, start, end);
                link_text(mut md, result, parent, is_text, text, false);
                start = end;
            }
        } else {
            let text = after(data, start);
            link_text(mut md, result, parent, is_text, text, atomic);
            data = String.new();
        }
    }
    result
}

fn process_element_text(md: mut ref Md, w: i64, node: i64, subnode: i64, is_text: bool) {
    let mut text: Option[String] = None;
    let mut atomic = false;
    if is_text {
        text = md.t.text(subnode);
        atomic = md.t.nodes[subnode].text_atomic;
        md.t.clear_text(subnode);
    } else {
        text = md.t.tail(subnode);
        atomic = md.t.nodes[subnode].tail_atomic;
        md.t.clear_tail(subnode);
    }
    let mut res = process_placeholders(mut md, w, text, atomic, subnode, is_text);
    let pos = if not is_text and node != subnode { md.t.index_of(node, subnode) + 1 } else { 0 };
    res.reverse();
    for c in res.iter() {
        md.t.insert(node, pos, *c);
    }
}

fn run_inline(md: mut ref Md, w: i64, tree: i64) {
    md.ips[w].stashed.clear();
    let mut stack: Vec[i64] = vec![tree];
    while stack.len() > 0 {
        let curr = stack.remove(0);
        let mut queue: Vec[(i64, Vec[i64])] = Vec.new();
        let mut k = 0;
        while k < md.t.len(curr) {
            let child = md.t.kid(curr, k);
            if md.t.has_text(child) and not md.t.nodes[child].text_atomic {
                let text = md.t.text_s(child);
                md.t.clear_text(child);
                let handled = handle_inline(mut md, w, text, false, 0);
                let lst = process_placeholders(mut md, w, Some(handled), false, child, true);
                for x in lst.iter() {
                    stack.push(*x);
                }
                queue.push((child, lst));
            }
            if md.t.has_tail(child) {
                let atomic = md.t.nodes[child].tail_atomic;
                let tail = handle_inline(mut md, w, md.t.tail_s(child), atomic, 0);
                let dumby = md.t.el("d");
                md.t.clear_tail(child);
                let mut tail_result = process_placeholders(mut md, w, Some(tail), atomic, dumby, false);
                if md.t.has_tail(dumby) {
                    let dt = md.t.tail(dumby);
                    let da = md.t.nodes[dumby].tail_atomic;
                    md.t.set_tail_opt(child, dt, da);
                }
                let pos = md.t.index_of(curr, child) + 1;
                tail_result.reverse();
                for c in tail_result.iter() {
                    md.t.insert(curr, pos, *c);
                }
            }
            if md.t.len(child) > 0 {
                stack.push(child);
            }
            k += 1;
        }
        for entry in queue.iter() {
            let mut i = 0;
            for c in entry.1.iter() {
                md.t.insert(entry.0, i, *c);
                i += 1;
            }
        }
    }
}

// ------------------------------------------------- handleMatch

fn handle_match(md: mut ref Md, w: i64, pat: ref Reg, m: ref M, data: ref String) -> Hm {
    let k = pat.kind;
    if k == I_BACKTICK {
        return backtick_match(mut md, m, data);
    }
    if k == I_ESCAPE {
        let c = grp(data, m, 1);
        if has_s(md.escaped, c) {
            let code = first_char(c).unwrap() as i64;
            return hm_text(f"{STX}{code}{ETX}", m.start, m.end);
        }
        return hm_none(m.start, m.end);
    }
    if k == I_LINK or k == I_IMAGE_LINK {
        let (text, index, handled) = get_text(data, m.end);
        if not handled {
            return hm_skip();
        }
        let (href, title, index2, handled2) = get_link(mut md, data, index);
        if not handled2 {
            return hm_skip();
        }
        if k == I_LINK {
            let el = md.t.el("a");
            md.t.set_text(el, text);
            md.t.set(el, "href", href);
            match title {
                Some(t) => md.t.set(el, "title", t),
                None => {}
            }
            return hm_el(el, m.start, index2);
        }
        let el = md.t.el("img");
        md.t.set(el, "src", href);
        match title {
            Some(t) => md.t.set(el, "title", t),
            None => {}
        }
        let alt = pattern_unescape(mut md, text);
        md.t.set(el, "alt", alt);
        return hm_el(el, m.start, index2);
    }
    if k == I_REFERENCE or k == I_SHORT_REF or k == I_IMAGE_REF or k == I_SHORT_IMAGE_REF {
        let (text, index, handled) = get_text(data, m.end);
        if not handled {
            return hm_skip();
        }
        let mut id = String.new();
        let mut end = index;
        if k == I_SHORT_REF or k == I_SHORT_IMAGE_REF {
            id = lower(text);
        } else {
            let rx = md.re.id(P_REF_LINK, F_REF_LINK);
            match md.re.match_at(rx, data, index) {
                Some(rm) => {
                    id = lower(grp(data, rm, 1));
                    end = rm.end;
                    if id.len() == 0 {
                        id = lower(text);
                    }
                }
                None => return hm_skip(),
            }
        }
        let nrx = md.re.id(P_NEWLINE_CLEANUP, F_NEWLINE_CLEANUP);
        id = md.re.sub(nrx, id, " ");
        let (href, title) = match md.references.get(id.clone()) {
            Some(v) => v.clone(),
            None => return hm_none(m.start, end),
        };
        let has_title = truthy(title);
        if k == I_REFERENCE or k == I_SHORT_REF {
            let el = md.t.el("a");
            md.t.set(el, "href", href);
            if has_title {
                md.t.set(el, "title", opt_text(title));
            }
            md.t.set_text(el, text);
            return hm_el(el, m.start, end);
        }
        let el = md.t.el("img");
        md.t.set(el, "src", href);
        if has_title {
            md.t.set(el, "title", opt_text(title));
        }
        let alt = pattern_unescape(mut md, text);
        md.t.set(el, "alt", alt);
        return hm_el(el, m.start, end);
    }
    if k == I_AUTOLINK {
        let g = grp(data, m, 1);
        let el = md.t.el("a");
        let href = pattern_unescape(mut md, g);
        md.t.set(el, "href", href);
        md.t.set_text_atomic(el, g);
        return hm_el(el, m.start, m.end);
    }
    if k == I_AUTOMAIL {
        let el = md.t.el("a");
        let mut email = pattern_unescape(mut md, grp(data, m, 1));
        if email.starts_with("mailto:") {
            email = after(email, 7);
        }
        let mut letters = String.new();
        for c in email.chars() {
            let code = c as i64;
            match md.cp_names.get(code) {
                Some(name) => letters.push_str(f"{AMP_SUBSTITUTE}{name};"),
                None => letters.push_str(f"{AMP_SUBSTITUTE}#{code};"),
            }
        }
        md.t.set_text_atomic(el, letters);
        let mut mailto = String.new();
        for c in f"mailto:{email}".chars() {
            mailto.push_str(f"{AMP_SUBSTITUTE}#{c as i64};");
        }
        md.t.set(el, "href", mailto);
        return hm_el(el, m.start, m.end);
    }
    if k == I_SUBST_TAG {
        let el = md.t.el("br");
        return hm_el(el, m.start, m.end);
    }
    if k == I_HTML {
        let raw = backslash_unescape(html_unescape_placeholders(mut md, grp(data, m, 1)));
        let ph = store_html(mut md, raw);
        return hm_text(ph, m.start, m.end);
    }
    if k == I_DELIM {
        return delim_match(mut md, m, data);
    }
    if k == I_FOOTNOTE {
        return footnote_match(mut md, m, data);
    }
    if k == I_WIKILINK {
        let g = grp(data, m, 1);
        if not is_blank(g) {
            let mut base_url = md.wiki_cfg.s("base_url");
            let mut end_url = md.wiki_cfg.s("end_url");
            let mut html_class = md.wiki_cfg.s("html_class");
            if md.has_meta {
                for kv in md.meta.iter() {
                    if kv.0 == "wiki_base_url" {
                        base_url = kv.1[0].clone();
                    } else if kv.0 == "wiki_end_url" {
                        end_url = kv.1[0].clone();
                    } else if kv.0 == "wiki_html_class" {
                        html_class = kv.1[0].clone();
                    }
                }
            }
            let label = strip_ws(g);
            let urx = md.re.id(P_WIKI_URL, F_WIKI_URL);
            let clean = md.re.sub(urx, label, "_");
            let a = md.t.el("a");
            md.t.set_text(a, label);
            md.t.set(a, "href", f"{base_url}{clean}{end_url}");
            if html_class.len() > 0 {
                md.t.set(a, "class", html_class);
            }
            return hm_el(a, m.start, m.end);
        }
        return hm_text(String.new(), m.start, m.end);
    }
    if k == I_SUBST_TEXT {
        let parts = md.smarty_parts[pat.arg].clone();
        let mut result = String.new();
        for part in parts.iter() {
            if part.group > 0 {
                result.push_str(grp(data, m, part.group));
            } else {
                let ph = store_html(mut md, part.text.clone());
                result.push_str(ph);
            }
        }
        return hm_text(result, m.start, m.end);
    }
    panic(f"inline pattern {k}");
}

fn backtick_match(md: mut ref Md, m: ref M, data: ref String) -> Hm {
    if has(m, 1) and gend(m, 1) > gstart(m, 1) {
        let g = grp(data, m, 1);
        return hm_text(g.replace("\\\\", f"{STX}92{ETX}"), m.start, m.end);
    }
    let begin = m.start;
    let bs = data.bytes();
    let last = bs.len();
    let mut start = begin;
    let mut max_ticks = 0;
    while start < last and bs[start] == b'`' {
        max_ticks += 1;
        start += 1;
    }
    if max_ticks == 0 {
        return hm_skip();
    }
    let mut longest = 0;
    let mut end = 0;
    let mut i = start;
    let mut found = false;
    let mut res_start = 0;
    let mut res_end = 0;
    while i < last {
        let mut span = 0;
        while i < last and bs[i] == b'`' {
            span += 1;
            i += 1;
        }
        if span == 0 {
            i += 1;
            continue;
        }
        if max_ticks == span {
            found = true;
            res_start = start;
            res_end = i - span;
            break;
        }
        if span > longest {
            longest = span;
            end = i;
        }
    }
    if not found and longest > 0 {
        found = true;
        res_start = start - (max_ticks - longest);
        res_end = end - longest;
    }
    if not found {
        return hm_skip();
    }
    let el = md.t.el("code");
    md.t.set_text_atomic(el, code_escape(strip_ws(sl(data, res_start, res_end))));
    hm_el(el, begin, res_end + (res_start - begin))
}

// LinkInlineProcessor.getText: the text up to the matching ']'.
fn get_text(data: ref String, index0: i64) -> (String, i64, bool) {
    let mut bracket_count = 1;
    let mut text = String.new();
    let mut index = index0;
    for c in after(data, index0).chars() {
        if c == ']' {
            bracket_count -= 1;
        } else if c == '[' {
            bracket_count += 1;
        }
        index += utf8_len(c as i64);
        if bracket_count == 0 {
            break;
        }
        text.push(c);
    }
    (text, index, bracket_count == 0)
}

fn get_link(md: mut ref Md, data: ref String, index0: i64) -> (String, Option[String], i64, bool) {
    let mut href = String.new();
    let mut title: Option[String] = None;
    let mut handled = false;
    let mut index = index0;
    let rx = md.re.id(P_RE_LINK, F_RE_LINK);
    match md.re.match_at(rx, data, index0) {
        Some(m) => {
            if has(m, 1) and gend(m, 1) > gstart(m, 1) {
                href = strip_ws(sl(data, gstart(m, 1) + 1, gend(m, 1) - 1));
                if has(m, 2) and gend(m, 2) > gstart(m, 2) {
                    title = Some(sl(data, gstart(m, 2) + 1, gend(m, 2) - 1));
                }
                index = m.end;
                handled = true;
            } else {
                let mut bracket_count = 1;
                let mut backtrack_count = 1;
                let start_index = m.end;
                index = start_index;
                let mut last_bracket = -1;
                let mut quote: Option[char] = None;
                let mut start_quote = -1;
                let mut exit_quote = -1;
                let mut ignore_matches = false;
                let mut alt_quote: Option[char] = None;
                let mut start_alt_quote = -1;
                let mut exit_alt_quote = -1;
                let mut last: Option[char] = None;
                for c in after(data, start_index).chars() {
                    if c == '(' {
                        if not ignore_matches {
                            bracket_count += 1;
                        } else if backtrack_count > 0 {
                            backtrack_count -= 1;
                        }
                    } else if c == ')' {
                        if (exit_quote != -1 and quote == last) or (exit_alt_quote != -1 and alt_quote == last) {
                            bracket_count = 0;
                        } else if not ignore_matches {
                            bracket_count -= 1;
                        } else if backtrack_count > 0 {
                            backtrack_count -= 1;
                            if backtrack_count == 0 {
                                last_bracket = index + 1;
                            }
                        }
                    } else if c == '\'' or c == '"' {
                        if quote.is_none() {
                            ignore_matches = true;
                            backtrack_count = bracket_count;
                            bracket_count = 1;
                            start_quote = index + 1;
                            quote = Some(c);
                        } else if Some(c) != quote and alt_quote.is_none() {
                            start_alt_quote = index + 1;
                            alt_quote = Some(c);
                        } else if Some(c) == quote {
                            exit_quote = index + 1;
                        } else if alt_quote.is_some() and Some(c) == alt_quote {
                            exit_alt_quote = index + 1;
                        }
                    }
                    index += utf8_len(c as i64);
                    if bracket_count == 0 {
                        if exit_quote >= 0 and quote == last {
                            href = sl(data, start_index, start_quote - 1);
                            title = Some(sl(data, start_quote, exit_quote - 1));
                        } else if exit_alt_quote >= 0 and alt_quote == last {
                            href = sl(data, start_index, start_alt_quote - 1);
                            title = Some(sl(data, start_alt_quote, exit_alt_quote - 1));
                        } else {
                            href = sl(data, start_index, index - 1);
                        }
                        break;
                    }
                    if c != ' ' {
                        last = Some(c);
                    }
                }
                if bracket_count != 0 and backtrack_count == 0 {
                    href = sl(data, start_index, last_bracket - 1);
                    index = last_bracket;
                    bracket_count = 0;
                }
                handled = bracket_count == 0;
            }
        }
        None => {}
    }
    match title {
        Some(ref t) => {
            let un = pattern_unescape(mut md, strip_ws(t));
            let dq = dequote(un);
            let crx = md.re.id(P_TITLE_CLEAN, F_TITLE_CLEAN);
            title = Some(md.re.sub(crx, dq, " "));
        }
        None => {}
    }
    let h = strip_ws(pattern_unescape(mut md, href));
    (h, title, index, handled)
}

fn dequote(s: ref String) -> String {
    if (s.starts_with("\"") and s.ends_with("\"")) or (s.starts_with("'") and s.ends_with("'")) {
        let n = char_count(s);
        if n < 2 {
            return String.new();
        }
        return sl(s, 1, s.len() - 1);
    }
    s.clone()
}

// Pattern.unescape: the main inline stash's placeholders, as text.
fn pattern_unescape(md: mut ref Md, text: ref String) -> String {
    if not text.contains(INLINE_PH_PREFIX) {
        return text.clone();
    }
    let rx = md.re.id(P_INLINE_PH, F_INLINE_PH);
    let ms = md.re.find_all(rx, text, 0);
    let mut out = String.new();
    let mut last = 0;
    for m in ms.iter() {
        out.push_str(sl(text, last, m.start));
        let id = grp(text, m, 1);
        let si = stash_index(md, 0, id);
        if si >= 0 {
            if md.ips[0].stashed[si].is_el {
                let el = md.ips[0].stashed[si].el;
                out.push_str(md.t.itertext(el));
            } else {
                out.push_str(md.ips[0].stashed[si].text);
            }
        }
        last = m.end;
    }
    out.push_str(after(text, last));
    out
}

// HtmlInlineProcessor.unescape: placeholders become their HTML (an
// element serialized) or a backslash and their text.
fn html_unescape_placeholders(md: mut ref Md, text: own String) -> String {
    if not text.contains(INLINE_PH_PREFIX) {
        return text;
    }
    let rx = md.re.id(P_INLINE_PH, F_INLINE_PH);
    let ms = md.re.find_all(rx, text, 0);
    let mut out = String.new();
    let mut last = 0;
    for m in ms.iter() {
        out.push_str(sl(text, last, m.start));
        let id = grp(text, m, 1);
        let si = stash_index(md, 0, id);
        if si >= 0 {
            if md.ips[0].stashed[si].is_el {
                let el = md.ips[0].stashed[si].el;
                let s = serialize(md.t, el, md.xhtml);
                out.push_str(html_unescape_placeholders(mut md, s));
            } else {
                out.push('\\');
                out.push_str(md.ips[0].stashed[si].text);
            }
        }
        last = m.end;
    }
    out.push_str(after(text, last));
    out
}

// UnescapeTreeprocessor.unescape: STX digits ETX back to the character.
fn backslash_unescape(text: own String) -> String {
    if not text.contains(STX) {
        return text;
    }
    let bs = text.bytes();
    let n = bs.len();
    let mut out = String.new();
    let mut last = 0;
    let mut i = 0;
    while i < n {
        if bs[i] == 2 {
            let mut j = i + 1;
            let mut v = 0;
            while j < n and is_digit_b(bs[j]) {
                v = v * 10 + (bs[j] as i64 - 48);
                j += 1;
            }
            if j > i + 1 and j < n and bs[j] == 3 {
                out.push_str(sl(text, last, i));
                push_code(mut out, v);
                i = j + 1;
                last = i;
                continue;
            }
        }
        i += 1;
    }
    out.push_str(after(text, last));
    out
}

// ---------------------------------------------- footnote references

fn footnote_match(md: mut ref Md, m: ref M, data: ref String) -> Hm {
    let id = grp(data, m, 1);
    if odict_get(md.fn_notes, id).is_none() {
        return hm_skip();
    }
    if not has_s(md.fn_order, id) {
        md.fn_order.push(id.clone());
    }
    let mut num = 0;
    if not val_truthy(md.fn_cfg.get("USE_DEFINITION_ORDER")) {
        let mut k = 0;
        while k < md.fn_order.len() {
            if md.fn_order[k] == id {
                num = k + 1;
                break;
            }
            k += 1;
        }
    } else {
        let mut k = 0;
        while k < md.fn_notes.len() {
            if md.fn_notes[k].0 == id {
                num = k + 1;
                break;
            }
            k += 1;
        }
    }
    let sup = md.t.el("sup");
    let a = md.t.sub(sup, "a");
    let ref_id = make_footnote_ref_id(mut md, id, true);
    md.t.set(sup, "id", ref_id);
    md.t.set(a, "href", "#".to_string() + make_footnote_id(md, id));
    md.t.set(a, "class", "footnote-ref".to_string());
    let st = md.fn_cfg.s("SUPERSCRIPT_TEXT");
    md.t.set_text(a, format1(st, f"{num}"));
    hm_el(sup, m.start, m.end)
}

fn make_footnote_id(md: ref Md, id: ref String) -> String {
    let sep = md.fn_cfg.s("SEPARATOR");
    if val_truthy(md.fn_cfg.get("UNIQUE_IDS")) {
        return f"fn{sep}{md.fn_unique_prefix}-{id}";
    }
    f"fn{sep}{id}"
}

fn make_footnote_ref_id(md: mut ref Md, id: ref String, found: bool) -> String {
    let sep = md.fn_cfg.s("SEPARATOR");
    let r = if val_truthy(md.fn_cfg.get("UNIQUE_IDS")) {
        f"fnref{sep}{md.fn_unique_prefix}-{id}"
    } else {
        f"fnref{sep}{id}"
    };
    unique_ref(mut md, r, found)
}

fn unique_ref(md: mut ref Md, reference0: own String, found: bool) -> String {
    if not found {
        return reference0;
    }
    let sep = md.fn_cfg.s("SEPARATOR");
    let original = reference0.clone();
    let mut reference = reference0;
    let rx = md.re.id(P_FN_REF_ID, F_FN_REF_ID);
    while has_s(md.fn_used_refs, reference) {
        let k = find_s(reference, sep);
        let r = upto(reference, k);
        let rest = after(reference, k + sep.len());
        match md.re.match_at(rx, r, 0) {
            Some(m) => {
                let n = parse_int(grp(r, m, 2)) + 1;
                reference = f"{grp(r, m, 1)}{n}{sep}{rest}";
            }
            None => {
                reference = f"{r}2{sep}{rest}";
            }
        }
    }
    md.fn_used_refs.push(reference.clone());
    let mut k = 0;
    let mut seen = false;
    while k < md.fn_found_refs.len() {
        if md.fn_found_refs[k].0 == original {
            md.fn_found_refs[k].1 += 1;
            seen = true;
            break;
        }
        k += 1;
    }
    if not seen {
        md.fn_found_refs.push((original, 1));
    }
    reference
}

// ===================================================== delimiters
// inlinepatterns.Delimiter and DelimiterProcessor: '*' and '_' runs are
// paired into strong and em regions by a stack per token; the regions
// are cached, built into nested elements a run at a time, and handed
// back across the inline processor's later calls with an offset for the
// text the earlier placeholders shortened. Positions are byte offsets;
// the tokens are ASCII, so token arithmetic matches Python's.

#[derive(Clone)]
struct Region {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    t0: String,
    t1: String,
    size: i64,
}

struct Delim {
    token: String,
    t0: String,
    t1: String,
    tag_count: i64,
    double: bool,
    max_size: i64,
    smart: bool,
    boundary: i64,
    bad: i64,
    stack: Vec[(i64, i64, bool, i64)],
}

struct Dp {
    regions: Vec[Region],
    stack: Vec[(i64, i64, bool, i64)],
    tokens: Vec[String],
    delims: Vec[Delim],
    cache_index: i64,
    cache_pos: i64,
    rx: i64,
}

fn new_dp() -> Dp {
    Dp {
        regions: vec![],
        stack: vec![],
        tokens: vec![],
        delims: vec![],
        cache_index: 0,
        cache_pos: 0,
        rx: -1,
    }
}

fn dp_find(dp: ref Dp, token: ref String) -> i64 {
    let mut i = 0;
    while i < dp.delims.len() {
        if dp.delims[i].token == *token {
            return i;
        }
        i += 1;
    }
    -1
}

// DelimiterProcessor.add with tags 'strong,em' (the only tags used).
fn dp_add(md: mut ref Md, token: Str, smart: bool) {
    let tok = token.to_string();
    let (bp, bf, xp, xf) = if tok == "*" {
        (P_DELIM_STAR, F_DELIM_STAR, P_DELIM_STAR_BAD, F_DELIM_STAR_BAD)
    } else if smart {
        (P_DELIM_USMART, F_DELIM_USMART, P_DELIM_USMART_BAD, F_DELIM_USMART_BAD)
    } else {
        (P_DELIM_UPLAIN, F_DELIM_UPLAIN, P_DELIM_UPLAIN_BAD, F_DELIM_UPLAIN_BAD)
    };
    let boundary = md.re.id(bp, bf);
    let bad = md.re.id(xp, xf);
    let d = Delim {
        token: tok.clone(),
        t0: "strong".to_string(),
        t1: "em".to_string(),
        tag_count: 2,
        double: false,
        max_size: 2,
        smart: smart,
        boundary: boundary,
        bad: bad,
        stack: vec![],
    };
    if not md.dp.tokens.contains(tok) {
        md.dp.tokens.push(tok.clone());
    }
    let i = dp_find(md.dp, tok);
    if i >= 0 {
        md.dp.delims[i] = d;
    } else {
        md.dp.delims.push(d);
    }
    let mut parts: Vec[String] = vec![];
    for t in md.dp.tokens.iter() {
        parts.push(re_escape(t));
    }
    let pat = join(parts, "|");
    md.dp.rx = md.re.id(pat, 16 | 32);
}

fn dp_reset(dp: mut ref Dp) {
    let mut i = 0;
    while i < dp.delims.len() {
        dp.delims[i].stack.clear();
        i += 1;
    }
    dp.regions.clear();
    dp.stack.clear();
    dp.cache_index = 0;
    dp.cache_pos = 0;
}

// any(d.stack for d in delimiters if d is not delimiters[except]).
fn dp_any_stack(dp: ref Dp, except: i64) -> bool {
    let mut i = 0;
    while i < dp.delims.len() {
        if i != except and dp.delims[i].stack.len() > 0 {
            return true;
        }
        i += 1;
    }
    false
}

fn dp_stack_len(dp: ref Dp, di: i64) -> i64 {
    dp.delims[di].stack.len()
}

fn dp_top(dp: ref Dp, di: i64) -> (i64, i64, bool, i64) {
    let s = dp.delims[di].stack.len();
    dp.delims[di].stack[s - 1]
}

fn dp_pop(dp: mut ref Dp, di: i64) -> (i64, i64, bool, i64) {
    match dp.delims[di].stack.pop() {
        Some(x) => x,
        None => panic("pop from an empty deque"),
    }
}

fn dp_push(dp: mut ref Dp, di: i64, e: (i64, i64, bool, i64)) {
    dp.delims[di].stack.push(e);
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn dp_add_region(dp: mut ref Dp, di: i64, a: i64, b: i64, c: i64, d: i64, size: i64) {
    let t0 = dp.delims[di].t0.clone();
    let t1 = dp.delims[di].t1.clone();
    dp.regions.push(Region { a: a, b: b, c: c, d: d, t0: t0, t1: t1, size: size });
    let mut k = 0;
    while k < dp.delims.len() {
        while dp.delims[k].stack.len() > 0 {
            let p = dp_top(dp, k).0;
            if imax(p, a) <= imin(p, d - 1) {
                dp.delims[k].stack.pop();
                continue;
            }
            break;
        }
        k += 1;
    }
}

fn dp_get_match(md: mut ref Md, data: ref String, start: i64) -> Option[M] {
    let n = md.dp.delims.len();
    let mut i = 0;
    while i < n {
        let b = md.dp.delims[i].boundary;
        match md.re.match_at(b, data, start) {
            Some(m) => return Some(m),
            None => {}
        }
        i += 1;
    }
    None
}

fn dp_search(md: mut ref Md, data: ref String, start: i64) -> Option[M] {
    let mut i = start;
    while i < data.len() {
        let c = byte_at(data, i);
        if c == 42 or c == 95 {
            let di = dp_find(md.dp, sl(data, i, i + 1));
            if di >= 0 {
                let b = md.dp.delims[di].boundary;
                match md.re.match_at(b, data, i) {
                    Some(m) => {
                        if not (md.dp.delims[di].stack.len() == 0 and m.lastindex == 2) {
                            return Some(m);
                        }
                    }
                    None => {}
                }
            }
        }
        i += 1;
    }
    None
}

// DelimiterProcessor._build_element: (element, regions consumed).
fn dp_build_element(md: mut ref Md, data: ref String, start: i64, off: i64) -> (i64, i64) {
    let regions = md.dp.regions.clone();
    let mut el = -1;
    let mut last = -1;
    let mut prev = -1;
    let mut outer: Vec[i64] = vec![];
    let mut outer_r: Vec[i64] = vec![];
    let end = regions.len();
    let mut idx = 0;
    let mut i = start;
    while i < end {
        idx += 1;
        let r = regions[i].clone();
        if r.a >= regions[start].d {
            idx -= 1;
            break;
        }
        let el1 = if r.size == 2 { md.t.el(r.t0) } else { md.t.el(r.t1) };
        if idx > 1 {
            let pv = regions[prev].clone();
            if md.t.text_none(last) {
                if pv.c < r.a {
                    md.t.set_text(last, sl(data, pv.b + off, pv.c + off));
                } else {
                    md.t.set_text(last, sl(data, pv.b + off, r.a + off));
                }
            }
            let otop = outer[outer.len() - 1];
            let orr = regions[outer_r[outer_r.len() - 1]].clone();
            if last != otop and md.t.tail_none(last) {
                if r.a < orr.d {
                    md.t.set_tail(last, sl(data, pv.d + off, r.a + off));
                } else {
                    md.t.set_tail(last, sl(data, pv.d + off, orr.c + off));
                    md.t.set_tail(otop, sl(data, orr.d + off, r.a + off));
                }
            }
        }
        if el < 0 {
            el = el1;
            last = el;
            outer.push(el);
            outer_r.push(i);
        } else {
            while outer_r.len() > 1 and r.d > regions[outer_r[outer_r.len() - 1]].d {
                outer.pop();
                outer_r.pop();
            }
            md.t.append(outer[outer.len() - 1], el1);
            if i + 1 < end {
                if r.d > regions[i + 1].d {
                    outer.push(el1);
                    outer_r.push(i);
                }
            }
            last = el1;
        }
        prev = i;
        i += 1;
    }
    while outer.len() > 0 {
        let pv = regions[prev].clone();
        if md.t.text_none(last) {
            md.t.set_text(last, sl(data, pv.b + off, pv.c + off));
        }
        let otop = outer[outer.len() - 1];
        let orr = regions[outer_r[outer_r.len() - 1]].clone();
        if md.t.tail_none(last) and last != otop {
            md.t.set_tail(last, sl(data, pv.d + off, orr.c + off));
        }
        last = match outer.pop() {
            Some(x) => x,
            None => -1,
        };
        prev = match outer_r.pop() {
            Some(x) => x,
            None => -1,
        };
    }
    (el, idx)
}

fn dp_increment_next_position(dp: mut ref Dp, start: i64, count: i64) {
    dp.cache_index += count;
    if dp.cache_index < dp.regions.len() {
        dp.cache_pos = dp.regions[dp.cache_index].a;
        while dp.stack.len() > 0 {
            let entry = dp.stack.remove(0);
            if start < entry.0 and entry.0 <= dp.cache_pos {
                dp.cache_pos = entry.0;
                break;
            }
        }
    } else {
        dp_reset(mut dp);
    }
}

fn dp_cached(md: mut ref Md, pos: i64, data: ref String) -> Hm {
    let ci = md.dp.cache_index;
    let offset = if pos != md.dp.cache_pos { pos - md.dp.cache_pos } else { pos - md.dp.regions[ci].a };
    let start = md.dp.regions[ci].a;
    let end = md.dp.regions[ci].d;
    let (el, count) = dp_build_element(mut md, data, ci, offset);
    dp_increment_next_position(mut md.dp, start, count);
    hm_el(el, start + offset, end + offset)
}

// DelimiterProcessor.handleMatch.
fn delim_match(md: mut ref Md, m: ref M, data: ref String) -> Hm {
    if md.dp.regions.len() > 0 {
        return dp_cached(mut md, m.start, data);
    }
    let first = match dp_get_match(mut md, data, m.start) {
        Some(x) => x,
        None => {
            let di = dp_find(md.dp, sl(data, m.start, m.end));
            let bad = md.dp.delims[di].bad;
            return match md.re.match_at(bad, data, m.start) {
                Some(b) => hm_none(b.start, b.end),
                None => panic("delimiter without a run"),
            };
        }
    };
    if first.lastindex == 2 {
        return hm_none(first.start, first.end);
    }
    let mut di = dp_find(md.dp, sl(data, m.start, m.start + 1));
    let mut start = first.start;
    let mut end = first.end;
    let length = end - start;
    if md.dp.delims[di].double and length < 2 {
        return hm_none(m.start, m.end);
    }
    let amb0 = first.lastindex != 3;
    dp_push(mut md.dp, di, (start, start + length, amb0, length));

    while dp_any_stack(md.dp, -1) {
        let m2 = match dp_search(mut md, data, end) {
            Some(x) => x,
            None => break,
        };
        di = dp_find(md.dp, sl(data, m2.start, m2.start + 1));
        start = m2.start;
        end = m2.end;
        let tag_count = md.dp.delims[di].tag_count;
        let max_size = md.dp.delims[di].max_size;
        let double = md.dp.delims[di].double;
        let mut current = m2.end - m2.start;
        let mut is_start = m2.lastindex != 2;
        let mut is_end = not is_start or m2.lastindex != 3;
        let is_ambiguous = is_start and is_end;
        let mut last = if dp_stack_len(md.dp, di) > 0 { dp_top(md.dp, di).3 } else { 0 };

        // Closing tokens: *em*, **strong**, ***strong,em***, *em**, ...
        if dp_stack_len(md.dp, di) > 0 and is_end and ((not is_ambiguous and current > last) or current == last or current >= 3) {
            is_start = false;
            let original = current;
            while dp_stack_len(md.dp, di) > 0 and current != 0 and last <= current {
                let delimiter = dp_pop(mut md.dp, di);
                let cap = if tag_count == 2 and delimiter.3 == 3 { 1 } else { max_size };
                let size = imin(delimiter.3, cap);
                dp_add_region(mut md.dp, di, delimiter.1 - size, delimiter.1, start, start + size, size);
                start += size;
                current -= size;
                if size < delimiter.3 and (not double or (delimiter.3 - size) != 1) {
                    let nw = delimiter.3 - size;
                    dp_push(mut md.dp, di, (delimiter.0, delimiter.1 - size, delimiter.2, nw));
                }
                if dp_stack_len(md.dp, di) == 0 {
                    if dp_any_stack(md.dp, di) {
                        md.dp.delims[di].stack.clear();
                        continue;
                    }
                    is_end = false;
                    break;
                }
                last = dp_top(md.dp, di).3;
            }
            if original >= 3 and current != 0 and is_ambiguous {
                dp_push(mut md.dp, di, (m2.start + (original - current), end, false, current));
                is_end = false;
            } else {
                is_end = current != 0 and dp_stack_len(md.dp, di) > 0 and last > current;
            }
        }

        // ***em*, ***strong**, **em*
        if dp_stack_len(md.dp, di) > 0 and is_end and (last >= 3 or not is_ambiguous) and last > current {
            let mut delimiter = dp_pop(mut md.dp, di);
            while dp_stack_len(md.dp, di) > 0 and delimiter.3 != 3 and delimiter.2 {
                delimiter = dp_pop(mut md.dp, di);
                last = delimiter.3;
            }
            if delimiter.2 and delimiter.3 != 3 {
                if dp_any_stack(md.dp, di) {
                    md.dp.delims[di].stack.clear();
                    continue;
                }
                break;
            }
            is_start = false;
            let ds = delimiter.0;
            let mut de = delimiter.1;
            while current != 0 and (not double or current != 1) {
                let cap = if tag_count == 2 and current == 3 { 1 } else { max_size };
                let size = imin(current, cap);
                let nw = last - size;
                dp_add_region(mut md.dp, di, ds + nw, de, start, start + size, size);
                start += size;
                current -= size;
                last -= size;
                de -= size;
            }
            if last != 0 and (not double or last > 1) {
                dp_push(mut md.dp, di, (ds, de, false, last));
            }
        }

        // Opening tokens: *em ...*, **strong ...*, ***em ...*
        if is_start and (not double or current != 1) {
            dp_push(mut md.dp, di, (start, end, is_ambiguous, current));
        }
    }

    let mut k = 0;
    while k < md.dp.delims.len() {
        let s = md.dp.delims[k].stack.clone();
        md.dp.stack.extend(s);
        k += 1;
    }
    md.dp.stack.sort_by(|a, b| {
        if a.0 < b.0 {
            Ordering.Less
        } else if a.0 > b.0 {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    });

    if md.dp.regions.len() > 0 {
        md.dp.regions.sort_by(|a, b| {
            if a.a < b.a {
                Ordering.Less
            } else if a.a > b.a {
                Ordering.Greater
            } else {
                Ordering.Equal
            }
        });
        let s0 = md.dp.regions[0].a;
        let e0 = md.dp.regions[0].d;
        let (el, count) = dp_build_element(mut md, data, 0, 0);
        dp_increment_next_position(mut md.dp, s0, count);
        return hm_el(el, s0, e0);
    }
    let s1 = m.start;
    let ns = md.dp.stack.len();
    let e1 = if ns > 0 { md.dp.stack[ns - 1].1 } else { m.end };
    dp_reset(mut md.dp);
    hm_none(s1, e1)
}

// ===================================================== tree processors
// treeprocessors.Prettify/Unescape and the extensions' tree processors:
// abbr, attr_list, codehilite's hiliter, footnotes (build, reorder,
// duplicates) and legacy_attrs. toc has its own section.

fn run_treeprocessor(md: mut ref Md, kind: i64, root: i64) {
    if kind == T_INLINE {
        run_inline(mut md, 0, root);
    } else if kind == T_SMARTY {
        run_inline(mut md, 1, root);
    } else if kind == T_PRETTIFY {
        run_prettify(mut md, root);
    } else if kind == T_UNESCAPE {
        run_unescape(mut md, root);
    } else if kind == T_ABBR {
        run_abbr(mut md, root);
    } else if kind == T_ATTR_LIST {
        run_attr_list(mut md, root);
    } else if kind == T_HILITE {
        run_hilite(mut md, root);
    } else if kind == T_FOOTNOTE {
        run_footnotes(mut md, root);
    } else if kind == T_FN_REORDER {
        run_fn_reorder(mut md, root);
    } else if kind == T_FN_DUP {
        run_fn_duplicates(mut md, root);
    } else if kind == T_LEGACY_ATTRS {
        run_legacy_attrs(mut md, root);
    } else if kind == T_TOC {
        run_toc(mut md, root);
    } else {
        panic(f"unknown treeprocessor {kind}");
    }
}

// Python's `if s:` on an Optional text.
fn truthy_s(o: ref Option[String]) -> bool {
    match o {
        Some(s) => s.len() > 0,
        None => false,
    }
}

// ----------------------------------------------------------- prettify

fn prettify_tree(md: mut ref Md, elem: i64) {
    let tag = md.t.tag(elem);
    if is_block_level(md, tag) and tag != "code" and tag != "pre" {
        let empty = match md.t.text(elem) {
            Some(s) => is_blank(s),
            None => true,
        };
        if empty and md.t.len(elem) > 0 {
            let first = md.t.tag(md.t.kid(elem, 0));
            if is_block_level(md, first) {
                md.t.set_text(elem, "\n".to_string());
            }
        }
        for e in md.t.kids(elem).iter() {
            let et = md.t.tag(*e);
            if is_block_level(md, et) {
                prettify_tree(mut md, *e);
            }
        }
    }
    let tail_empty = match md.t.tail(elem) {
        Some(s) => is_blank(s),
        None => true,
    };
    if tail_empty {
        md.t.set_tail(elem, "\n".to_string());
    }
}

fn run_prettify(md: mut ref Md, root: i64) {
    prettify_tree(mut md, root);
    for br in md.t.iter_tag(root, "br").iter() {
        match md.t.tail(*br) {
            Some(s) => {
                if is_blank(s) {
                    md.t.set_tail(*br, "\n".to_string());
                } else {
                    md.t.set_tail(*br, f"\n{s}");
                }
            }
            None => md.t.set_tail(*br, "\n".to_string()),
        }
    }
    for pre in md.t.iter_tag(root, "pre").iter() {
        if md.t.len(*pre) > 0 and md.t.is(md.t.kid(*pre, 0), "code") {
            let code = md.t.kid(*pre, 0);
            if md.t.len(code) == 0 and not md.t.text_none(code) {
                let t = rstrip_ws(md.t.text_s(code)) + "\n";
                md.t.set_text_atomic(code, t);
            }
        }
    }
}

// ----------------------------------------------------------- unescape

fn run_unescape(md: mut ref Md, root: i64) {
    for el in md.t.iter(root).iter() {
        let e = *el;
        if truthy_s(md.t.text(e)) and not md.t.is(e, "code") {
            let t = backslash_unescape(md.t.text_s(e));
            md.t.set_text(e, t);
        }
        if truthy_s(md.t.tail(e)) {
            let t = backslash_unescape(md.t.tail_s(e));
            md.t.set_tail(e, t);
        }
        let attrs = md.t.nodes[e].attrs.clone();
        for kv in attrs.iter() {
            md.t.set(e, kv.0, backslash_unescape(kv.1.clone()));
        }
    }
}

// --------------------------------------------------------------- abbr

fn run_abbr(md: mut ref Md, root: i64) {
    if md.abbrs.len() == 0 {
        return;
    }
    let mut keys: Vec[String] = Vec.new();
    for kv in md.abbrs.iter() {
        keys.push(kv.0.clone());
    }
    keys.sort_by(|a, b| {
        let la = char_count(a);
        let lb = char_count(b);
        if la > lb {
            Ordering.Less
        } else if la < lb {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    });
    let mut parts: Vec[String] = Vec.new();
    for k in keys.iter() {
        parts.push(re_escape(k));
    }
    let pat = f"\\b(?:{join(parts, "|")})\\b";
    let rx = md.re.id(pat, 32);
    abbr_iter(mut md, rx, root, -1);
}

fn abbr_element(md: mut ref Md, title: own String, text: own String, tail: own String) -> i64 {
    let a = md.t.el("abbr");
    md.t.set(a, "title", title);
    md.t.set_text_atomic(a, text);
    md.t.set_tail(a, tail);
    a
}

fn abbr_title(md: ref Md, key: ref String) -> String {
    match odict_get(md.abbrs, key) {
        Some(v) => v,
        None => panic(f"KeyError: {py_repr(key)}"),
    }
}

fn abbr_iter(md: mut ref Md, rx: i64, el: i64, parent: i64) {
    let kids = md.t.kids(el);
    let mut k = kids.len() - 1;
    while k >= 0 {
        abbr_iter(mut md, rx, kids[k], el);
        k -= 1;
    }
    if truthy_s(md.t.text(el)) and not md.t.nodes[el].text_atomic {
        let mut text = md.t.text_s(el);
        let ms = md.re.find_all(rx, text, 0);
        let mut i = ms.len() - 1;
        while i >= 0 {
            let m = ms[i].clone();
            let key = sl(text, m.start, m.end);
            let title = abbr_title(md, key);
            if title.len() > 0 {
                let a = abbr_element(mut md, title, key, after(text, m.end));
                md.t.insert(el, 0, a);
                text = upto(text, m.start);
            }
            i -= 1;
        }
        md.t.set_text(el, text);
    }
    if parent >= 0 and truthy_s(md.t.tail(el)) {
        let mut tail = md.t.tail_s(el);
        let index = md.t.index_of(parent, el) + 1;
        if not md.t.nodes[el].tail_atomic {
            let ms = md.re.find_all(rx, tail, 0);
            let mut i = ms.len() - 1;
            while i >= 0 {
                let m = ms[i].clone();
                let key = sl(tail, m.start, m.end);
                let title = abbr_title(md, key);
                let a = abbr_element(mut md, title, key, after(tail, m.end));
                md.t.insert(parent, index, a);
                tail = upto(tail, m.start);
                i -= 1;
            }
            md.t.set_tail(el, tail);
        }
    }
}

// ---------------------------------------------------------- attr_list

fn is_header_tag(tag: ref String) -> bool {
    *tag == "h1" or *tag == "h2" or *tag == "h3" or *tag == "h4" or *tag == "h5" or *tag == "h6"
}

fn split_once(s: ref String, sep: ref String) -> Option[(String, String)] {
    let i = find_s(s, sep);
    if i < 0 {
        return None;
    }
    Some((upto(s, i), after(s, i + sep.len())))
}

// attr_list.get_attrs_and_remainder: re.Scanner over the five phrases.
fn get_attrs_and_remainder(md: mut ref Md, s: ref String) -> (Vec[(String, String)], String) {
    let sc = md.re.id(P_ATTR_SCAN, F_ATTR_SCAN);
    let mut out: Vec[(String, String)] = Vec.new();
    let mut i = 0;
    loop {
        let m = match md.re.match_at(sc, s, i) {
            Some(x) => x,
            None => break,
        };
        let j = m.end;
        if i == j {
            break;
        }
        let t = sl(s, m.start, m.end);
        let g = m.lastindex;
        let eq = "=".to_string();
        if g == 1 or g == 2 or g == 3 {
            match split_once(t, eq) {
                Some((k, v)) => {
                    if g == 1 {
                        out.push((k, strip_set(v, "\"")));
                    } else if g == 2 {
                        out.push((k, strip_set(v, "'")));
                    } else {
                        out.push((k, v));
                    }
                }
                None => {}
            }
        } else if g == 4 {
            if t.starts_with(".") {
                out.push((".".to_string(), after(t, 1)));
            } else if t.starts_with("#") {
                out.push(("id".to_string(), after(t, 1)));
            } else {
                out.push((t.clone(), t));
            }
        }
        i = j;
    }
    let rest = after(s, i);
    let idx = find_s(rest, "}");
    let rem = if idx >= 0 { after(rest, idx) } else { String.new() };
    (out, rem)
}

fn sanitize_name(md: mut ref Md, name: ref String) -> String {
    let rx = md.re.id(P_NAME, F_NAME);
    md.re.sub(rx, name, "_")
}

fn assign_attrs(md: mut ref Md, elem: i64, attrs_string: ref String, strict: bool) -> String {
    let (attrs, remainder) = get_attrs_and_remainder(mut md, attrs_string);
    if strict and remainder.len() > 0 {
        return remainder;
    }
    for kv in attrs.iter() {
        if kv.0 == "." {
            match md.t.get(elem, "class") {
                Some(cls) => {
                    if cls.len() > 0 {
                        md.t.set(elem, "class", f"{cls} {kv.1}");
                    } else {
                        md.t.set(elem, "class", kv.1.clone());
                    }
                }
                None => md.t.set(elem, "class", kv.1.clone()),
            }
        } else {
            let k = sanitize_name(mut md, kv.0);
            md.t.set(elem, k, kv.1.clone());
        }
    }
    remainder
}

// Attributes at the end of a child's tail; true when assigned.
fn attr_tail(md: mut ref Md, elem: i64, c: i64, rx: i64, header: bool) {
    let tl = md.t.tail_s(c);
    match md.re.search(rx, tl, 0) {
        Some(m) => {
            if assign_attrs(mut md, elem, grp(tl, m, 1), true).len() == 0 {
                let mut nt = upto(tl, m.start);
                if header {
                    nt = rstrip_ws(rstrip_set(nt, "#"));
                }
                md.t.set_tail(c, nt);
            }
        }
        None => {}
    }
}

fn attr_text(md: mut ref Md, elem: i64, rx: i64, header: bool) {
    let tx = md.t.text_s(elem);
    match md.re.search(rx, tx, 0) {
        Some(m) => {
            if assign_attrs(mut md, elem, grp(tx, m, 1), true).len() == 0 {
                let mut nt = upto(tx, m.start);
                if header {
                    nt = rstrip_ws(rstrip_set(nt, "#"));
                }
                md.t.set_text(elem, nt);
            }
        }
        None => {}
    }
}

fn run_attr_list(md: mut ref Md, root: i64) {
    let hdr = md.re.id(P_ATTR_HEADER, F_ATTR_HEADER);
    let blk = md.re.id(P_ATTR_BLOCK, F_ATTR_BLOCK);
    let inl = md.re.id(P_ATTR_INLINE, F_ATTR_INLINE);
    for e in md.t.iter(root).iter() {
        let elem = *e;
        let tag = md.t.tag(elem);
        if is_block_level(md, tag) {
            let mut rx = blk;
            if is_header_tag(tag) or tag == "dt" or tag == "td" or tag == "th" {
                rx = hdr;
            }
            let n = md.t.len(elem);
            if n > 0 and tag == "li" {
                let mut pos = -1;
                let mut i = 0;
                while i < n {
                    let ct = md.t.tag(md.t.kid(elem, i));
                    if ct == "ul" or ct == "ol" {
                        pos = i;
                        break;
                    }
                    i += 1;
                }
                if pos < 0 and truthy_s(md.t.tail(md.t.kid(elem, n - 1))) {
                    attr_tail(mut md, elem, md.t.kid(elem, n - 1), rx, false);
                } else if pos > 0 and truthy_s(md.t.tail(md.t.kid(elem, pos - 1))) {
                    attr_tail(mut md, elem, md.t.kid(elem, pos - 1), rx, false);
                } else if truthy_s(md.t.text(elem)) {
                    attr_text(mut md, elem, rx, false);
                }
            } else if n > 0 and truthy_s(md.t.tail(md.t.kid(elem, n - 1))) {
                attr_tail(mut md, elem, md.t.kid(elem, n - 1), rx, is_header_tag(tag));
            } else if truthy_s(md.t.text(elem)) {
                attr_text(mut md, elem, rx, is_header_tag(tag));
            }
        } else if truthy_s(md.t.tail(elem)) {
            let tl = md.t.tail_s(elem);
            match md.re.match_at(inl, tl, 0) {
                Some(m) => {
                    let remainder = assign_attrs(mut md, elem, grp(tl, m, 1), false);
                    md.t.set_tail(elem, after(tl, m.end) + remainder);
                }
                None => {}
            }
        }
    }
}

// ---------------------------------------------------------- codehilite

fn code_unescape(text: ref String) -> String {
    text.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")
}

// CodeHilite.hilite without Pygments: the JavaScript-highlighter
// wrapping, after _parseHeader has read a shebang line.
fn codehilite_html(md: mut ref Md, src0: ref String, lang0: own Option[String], linenos0: own Val, cssclass: ref String, lang_prefix: ref String, shebang: bool) -> String {
    let mut src = strip_set(src0, "\n");
    let mut lang = lang0;
    let mut linenos = linenos0;
    if lang.is_none() and shebang {
        let mut lines = split_on(src, "\n");
        let fl = lines.remove(0);
        let rx = md.re.id(P_SHEBANG, F_SHEBANG);
        match md.re.search(rx, fl, 0) {
            Some(m) => {
                lang = Some(lower(grp(fl, m, 3)));
                if grp(fl, m, 2).len() > 0 {
                    lines.insert(0, fl.clone());
                }
                if val_is_null(linenos) and grp(fl, m, 1).len() > 0 {
                    linenos = Val.Bool(true);
                }
            }
            None => lines.insert(0, fl.clone()),
        }
        src = strip_set(join(lines, "\n"), "\n");
    }
    let txt = src.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;");
    let mut classes: Vec[String] = Vec.new();
    match lang {
        Some(l) => {
            if l.len() > 0 {
                classes.push(f"{lang_prefix}{l}");
            }
        }
        None => {}
    }
    if val_truthy(linenos) {
        classes.push("linenums".to_string());
    }
    let mut class_str = String.new();
    if classes.len() > 0 {
        class_str = f" class=\"{join(classes, " ")}\"";
    }
    f"<pre class=\"{cssclass}\"><code{class_str}>{txt}\n</code></pre>\n"
}

// The CodeHilite options a config dict gives: linenos and cssclass.
fn hilite_linenos(cfg: ref Cfg) -> Val {
    if cfg.has("linenos") {
        cfg.get("linenos")
    } else if cfg.has("linenums") {
        cfg.get("linenums")
    } else {
        Val.Null
    }
}

fn hilite_cssclass(cfg: ref Cfg) -> String {
    if cfg.has("cssclass") {
        cfg.s("cssclass")
    } else if cfg.has("css_class") {
        cfg.s("css_class")
    } else {
        "codehilite".to_string()
    }
}

fn hilite_lang_prefix(cfg: ref Cfg) -> String {
    if cfg.has("lang_prefix") {
        cfg.s("lang_prefix")
    } else {
        "language-".to_string()
    }
}

fn run_hilite(md: mut ref Md, root: i64) {
    let cfg = md.hilite_cfg.clone();
    for b in md.t.iter_tag(root, "pre").iter() {
        let block = *b;
        if md.t.len(block) == 1 and md.t.is(md.t.kid(block, 0), "code") {
            let code = md.t.kid(block, 0);
            if md.t.text_none(code) {
                continue;
            }
            let src = code_unescape(md.t.text_s(code));
            let lang = if cfg.has("lang") { Some(cfg.s("lang")) } else { None };
            let html = codehilite_html(mut md, src, lang, hilite_linenos(cfg), hilite_cssclass(cfg), hilite_lang_prefix(cfg), true);
            let ph = store_html(mut md, html);
            md.t.clear(block);
            md.t.nodes[block].tag = "p".to_string();
            md.t.set_text(block, ph);
        }
    }
}

// ----------------------------------------------------------- footnotes

fn make_footnotes_div(md: mut ref Md) -> i64 {
    if md.fn_notes.len() == 0 {
        return -1;
    }
    let div = md.t.el("div");
    md.t.set(div, "class", "footnote".to_string());
    md.t.sub(div, "hr");
    let ol = md.t.sub(div, "ol");
    let surrogate = md.t.el("div");
    let notes = md.fn_notes.clone();
    let title_fmt = md.fn_cfg.s("BACKLINK_TITLE");
    let mut index = 1;
    for kv in notes.iter() {
        let li = md.t.sub(ol, "li");
        let fid = make_footnote_id(md, kv.0);
        md.t.set(li, "id", fid);
        parse_chunk(mut md, surrogate, kv.1);
        for e in md.t.kids(surrogate).iter() {
            md.t.append(li, *e);
            md.t.remove(surrogate, *e);
        }
        let backlink = md.t.el("a");
        let rid = make_footnote_ref_id(mut md, kv.0, false);
        md.t.set(backlink, "href", f"#{rid}");
        md.t.set(backlink, "class", "footnote-backref".to_string());
        md.t.set(backlink, "title", format1(title_fmt, f"{index}"));
        md.t.set_text(backlink, FN_BACKLINK_TEXT.to_string());
        if md.t.len(li) > 0 {
            let node = md.t.last(li);
            if md.t.is(node, "p") {
                let t = md.t.text_s(node) + NBSP_PLACEHOLDER.to_string();
                md.t.set_text(node, t);
                md.t.append(node, backlink);
            } else {
                let p = md.t.sub(li, "p");
                md.t.append(p, backlink);
            }
        }
        index += 1;
    }
    div
}

fn find_footnotes_placeholder(md: ref Md, element: i64, marker: ref String) -> Option[(i64, i64, bool)] {
    for c in md.t.kids(element).iter() {
        let child = *c;
        if truthy_s(md.t.text(child)) and md.t.text_s(child).contains(marker) {
            return Some((child, element, true));
        }
        if truthy_s(md.t.tail(child)) and md.t.tail_s(child).contains(marker) {
            return Some((child, element, false));
        }
        match find_footnotes_placeholder(md, child, marker) {
            Some(r) => return Some(r),
            None => {}
        }
    }
    None
}

fn run_footnotes(md: mut ref Md, root: i64) {
    let div = make_footnotes_div(mut md);
    if div < 0 {
        return;
    }
    let marker = md.fn_cfg.s("PLACE_MARKER");
    match find_footnotes_placeholder(md, root, marker) {
        Some((child, parent, is_text)) => {
            let ind = md.t.index_of(parent, child);
            if is_text {
                md.t.remove(parent, child);
                md.t.insert(parent, ind, div);
            } else {
                md.t.insert(parent, ind + 1, div);
                md.t.clear_tail(child);
            }
        }
        None => md.t.append(root, div),
    }
}

fn fn_order_key(md: ref Md, li: i64, sep: ref String) -> i64 {
    let idv = md.t.get_or(li, "id", "");
    let id = match split_once(idv, sep) {
        Some((_, rest)) => rest,
        None => idv,
    };
    let mut i = 0;
    while i < md.fn_order.len() {
        if md.fn_order[i] == id {
            return i;
        }
        i += 1;
    }
    md.fn_notes.len()
}

fn reorder_footnotes(md: mut ref Md, parent: i64) {
    let mut old = -1;
    for c in md.t.kids(parent).iter() {
        if md.t.is(*c, "ol") {
            old = *c;
            break;
        }
    }
    md.t.remove(parent, old);
    let sep = md.fn_cfg.s("SEPARATOR");
    let mut items: Vec[(i64, i64)] = Vec.new();
    for c in md.t.kids(old).iter() {
        if md.t.is(*c, "li") {
            items.push((fn_order_key(md, *c, sep), *c));
        }
    }
    items.sort_by(|a, b| {
        if a.0 < b.0 {
            Ordering.Less
        } else if a.0 > b.0 {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    });
    let new_list = md.t.sub(parent, "ol");
    let title_fmt = md.fn_cfg.s("BACKLINK_TITLE");
    let mut index = 1;
    for it in items.iter() {
        let item = it.1;
        for d in md.t.iter(item).iter() {
            if *d != item and md.t.is(*d, "a") and md.t.get_or(*d, "class", "") == "footnote-backref" {
                md.t.set(*d, "title", format1(title_fmt, f"{index}"));
                break;
            }
        }
        md.t.append(new_list, item);
        index += 1;
    }
}

fn run_fn_reorder(md: mut ref Md, root: i64) {
    if md.fn_notes.len() == 0 {
        return;
    }
    let mut same = md.fn_order.len() == md.fn_notes.len();
    if same {
        let mut i = 0;
        while i < md.fn_order.len() {
            if md.fn_order[i] != md.fn_notes[i].0 {
                same = false;
            }
            i += 1;
        }
    }
    if not same {
        for d in md.t.iter_tag(root, "div").iter() {
            if md.t.get_or(*d, "class", "") == "footnote" {
                reorder_footnotes(mut md, *d);
                break;
            }
        }
    }
}

fn fn_num_duplicates(md: ref Md, li: i64, sep: ref String) -> i64 {
    let idv = md.t.get_or(li, "id", "");
    let (f, rest) = match split_once(idv, sep) {
        Some(x) => x,
        None => panic("ValueError: not enough values to unpack (expected 2, got 1)"),
    };
    let link_id = f"{f}ref{sep}{rest}";
    for kv in md.fn_found_refs.iter() {
        if kv.0 == link_id {
            return kv.1;
        }
    }
    0
}

fn fn_add_duplicates(md: mut ref Md, li: i64, duplicates: i64, sep: ref String) {
    for l in md.t.iter_tag(li, "a").iter() {
        let link = *l;
        if md.t.get_or(link, "class", "") == "footnote-backref" {
            let href = md.t.get_or(link, "href", "");
            let (r, rest) = match split_once(href, sep) {
                Some(x) => x,
                None => panic("ValueError: not enough values to unpack (expected 2, got 1)"),
            };
            let mut links: Vec[i64] = Vec.new();
            let mut index = 2;
            while index <= duplicates {
                let sib = md.t.deepcopy(link);
                md.t.set(sib, "href", f"{r}{index}{sep}{rest}");
                links.push(sib);
                index += 1;
            }
            let el = md.t.last(li);
            for s in links.iter() {
                md.t.append(el, *s);
            }
            break;
        }
    }
}

fn run_fn_duplicates(md: mut ref Md, root: i64) {
    let sep = md.fn_cfg.s("SEPARATOR");
    for d in md.t.iter_tag(root, "div").iter() {
        if md.t.get_or(*d, "class", "") == "footnote" {
            let ols = md.t.iter_tag(*d, "ol");
            if ols.len() > 0 {
                let ol = ols[0];
                for li in md.t.kids(ol).iter() {
                    let count = fn_num_duplicates(md, *li, sep);
                    if count > 1 {
                        fn_add_duplicates(mut md, *li, count, sep);
                    }
                }
            }
        }
    }
}

// -------------------------------------------------------- legacy_attrs

fn legacy_handle(md: mut ref Md, el: i64, txt: ref String) -> String {
    let rx = md.re.id(P_LEGACY_ATTR, F_LEGACY_ATTR);
    let ms = md.re.find_all(rx, txt, 0);
    let mut out = String.new();
    let mut last = 0;
    for m in ms.iter() {
        out.push_str(sl(txt, last, m.start));
        let k = sanitize_name(mut md, grp(txt, m, 1));
        md.t.set(el, k, grp(txt, m, 2).replace("\n", " "));
        last = m.end;
    }
    out.push_str(after(txt, last));
    out
}

fn run_legacy_attrs(md: mut ref Md, root: i64) {
    for e in md.t.iter(root).iter() {
        let el = *e;
        match md.t.get(el, "alt") {
            Some(alt) => {
                let v = legacy_handle(mut md, el, alt);
                md.t.set(el, "alt", v);
            }
            None => {}
        }
        if truthy_s(md.t.text(el)) and not md.t.nodes[el].text_atomic {
            let v = legacy_handle(mut md, el, md.t.text_s(el));
            md.t.set_text(el, v);
        }
        if truthy_s(md.t.tail(el)) and not md.t.nodes[el].tail_atomic {
            let v = legacy_handle(mut md, el, md.t.tail_s(el));
            md.t.set_tail(el, v);
        }
    }
}

// ================================================================ toc
// extensions/toc.py: ids from slugified header text, made unique, a
// nested token list, the rendered <div class="toc"> put where the marker
// paragraph was, and anchor and permalink links on each header.

fn hdr_match(tag: ref String) -> bool {
    let bs = tag.bytes();
    if bs.len() < 2 {
        return false;
    }
    (bs[0] == 104 or bs[0] == 72) and bs[1] >= 49 and bs[1] <= 54
}

fn tag_level(tag: ref String) -> i64 {
    let bs = tag.bytes();
    bs[bs.len() - 1] as i64 - 48
}

// slugify: NFKD with the non-ASCII dropped, strip what is not a word,
// space or hyphen, lowercase, and join the runs with the separator.
fn slugify(md: mut ref Md, value: ref String, sep: ref String) -> String {
    let mut a = String.new();
    for c in value.chars() {
        let cp = c as i64;
        if cp < 128 {
            a.push(c);
        } else {
            match md.nfkd.get(cp) {
                Some(s) => a.push_str(s),
                None => {}
            }
        }
    }
    let strip_rx = md.re.id(P_SLUG_STRIP, F_SLUG_STRIP);
    let v = lower(strip_ws(md.re.sub(strip_rx, a, "")));
    let sep_rx = md.re.id(P_SLUG_SEP, F_SLUG_SEP);
    md.re.sub(sep_rx, v, sep)
}

fn toc_unique(md: mut ref Md, id0: own String, ids: mut ref Vec[String]) -> String {
    let rx = md.re.id(P_IDCOUNT, F_IDCOUNT);
    let mut id = id0;
    while ids.contains(id) or id.len() == 0 {
        id = match md.re.match_at(rx, id, 0) {
            Some(m) => f"{grp(id, m, 1)}_{parse_int(grp(id, m, 2)) + 1}",
            None => f"{id}_1",
        };
    }
    ids.push(id.clone());
    id
}

fn strip_tags(text0: ref String) -> String {
    let mut text = text0.clone();
    loop {
        let s = find_s(text, "<!--");
        if s < 0 {
            break;
        }
        let e = find_from(text, "-->", s);
        if e < 0 {
            break;
        }
        text = upto(text, s) + after(text, e + 3);
    }
    loop {
        let s = find_s(text, "<");
        if s < 0 {
            break;
        }
        let e = find_from(text, ">", s);
        if e < 0 {
            break;
        }
        text = upto(text, s) + after(text, e + 1);
    }
    join(split_ws(text), " ")
}

fn render_inner_html(md: mut ref Md, el: i64) -> String {
    let text = backslash_unescape(serialize(md.t, el, md.xhtml));
    let start = find_s(text, ">") + 1;
    let end = rfind_s(text, "<");
    let inner = strip_ws(sl(text, start, end));
    run_postprocessors(mut md, inner).0
}

fn sup_parents(md: ref Md, node: i64, out: mut ref Vec[i64]) {
    for c in md.t.kids(node).iter() {
        if md.t.is(*c, "sup") and not out.contains(node) {
            out.push(node);
        }
        sup_parents(md, *c, mut out);
    }
}

fn remove_fnrefs(md: mut ref Md, root: i64) -> i64 {
    if md.t.iter_tag(root, "sup").len() == 0 {
        return root;
    }
    let r = md.t.deepcopy(root);
    let mut parents: Vec[i64] = Vec.new();
    sup_parents(md, r, mut parents);
    for p in parents.iter() {
        let parent = *p;
        let mut carry = String.new();
        let kids = md.t.kids(parent);
        let mut k = kids.len() - 1;
        while k >= 0 {
            let child = kids[k];
            if md.t.is(child, "sup") and md.t.get_or(child, "id", "").starts_with("fnref") {
                carry = md.t.tail_s(child) + carry;
                md.t.remove(parent, child);
            } else if carry.len() > 0 {
                let t = md.t.tail_s(child) + carry;
                md.t.set_tail(child, t);
                carry = String.new();
            }
            k -= 1;
        }
        if carry.len() > 0 {
            let t = md.t.text_s(parent) + carry;
            md.t.set_text(parent, t);
        }
    }
    r
}

// Flat toc entries, before nesting.
struct Flat {
    tok: Tok,
    kids: Vec[i64],
}

fn materialize(flat: ref Vec[Flat], i: i64) -> Tok {
    let mut t = flat[i].tok.clone();
    for k in flat[i].kids.iter() {
        t.children.push(materialize(flat, *k));
    }
    t
}

fn nest_toc_tokens(toks: own Vec[Tok]) -> Vec[Tok] {
    let mut flat: Vec[Flat] = Vec.new();
    for t in toks.iter() {
        flat.push(Flat { tok: t.clone(), kids: Vec.new() });
    }
    let mut ordered: Vec[i64] = Vec.new();
    let n = flat.len();
    if n > 0 {
        let mut last = 0;
        let mut levels: Vec[i64] = vec![flat[0].tok.level];
        ordered.push(0);
        let mut parents: Vec[i64] = Vec.new();
        let mut i = 1;
        while i < n {
            let cur = flat[i].tok.level;
            if cur < levels[levels.len() - 1] {
                levels.pop();
                let mut to_pop = 0;
                let mut k = parents.len() - 1;
                while k >= 0 {
                    if cur <= flat[parents[k]].tok.level {
                        to_pop += 1;
                    } else {
                        break;
                    }
                    k -= 1;
                }
                if to_pop > 0 {
                    let nl = if levels.len() > to_pop { levels.len() - to_pop } else { 0 };
                    levels.truncate(nl);
                    let np = if parents.len() > to_pop { parents.len() - to_pop } else { 0 };
                    parents.truncate(np);
                }
                levels.push(cur);
            }
            if cur == levels[levels.len() - 1] {
                if parents.len() > 0 {
                    let p = parents[parents.len() - 1];
                    flat[p].kids.push(i);
                } else {
                    ordered.push(i);
                }
            } else {
                flat[last].kids.push(i);
                parents.push(last);
                levels.push(cur);
            }
            last = i;
            i += 1;
        }
    }
    let mut out: Vec[Tok] = Vec.new();
    for i in ordered.iter() {
        out.push(materialize(flat, *i));
    }
    out
}

fn build_toc_ul(md: mut ref Md, toks: ref Vec[Tok], parent: i64) {
    let ul = md.t.sub(parent, "ul");
    for item in toks.iter() {
        let li = md.t.sub(ul, "li");
        let link = md.t.sub(li, "a");
        md.t.set_text(link, item.name.clone());
        md.t.set(link, "href", f"#{item.id}");
        if item.children.len() > 0 {
            build_toc_ul(mut md, item.children, li);
        }
    }
}

fn toc_replace_marker(md: mut ref Md, node: i64, elem: i64, marker: ref String) {
    let mut i = 0;
    while i < md.t.len(node) {
        let child = md.t.kid(node, i);
        let tag = md.t.tag(child);
        if not hdr_match(tag) and tag != "pre" and tag != "code" {
            let text = strip_ws(md.t.itertext(child));
            if text.len() > 0 {
                if truthy_s(md.t.text(child)) and strip_ws(md.t.text_s(child)) == *marker and md.t.len(child) == 0 {
                    let mut k = 0;
                    while k < md.t.len(node) {
                        if md.t.kid(node, k) == child {
                            md.t.nodes[node].kids[k] = elem;
                            break;
                        }
                        k += 1;
                    }
                }
            }
            toc_replace_marker(mut md, child, elem, marker);
        }
        i += 1;
    }
}

fn toc_add_anchor(md: mut ref Md, c: i64, elem_id: ref String, cls: ref String) {
    let anchor = md.t.el("a");
    let atomic = md.t.nodes[c].text_atomic;
    md.t.set_text_opt(anchor, md.t.text(c), atomic);
    md.t.set(anchor, "href", f"#{elem_id}");
    md.t.set(anchor, "class", cls.clone());
    md.t.set_text(c, String.new());
    for e in md.t.kids(c).iter() {
        md.t.append(anchor, *e);
    }
    md.t.nodes[c].kids.clear();
    md.t.append(c, anchor);
}

fn toc_add_permalink(md: mut ref Md, c: i64, elem_id: ref String, text: ref String, cls: ref String, title: ref String, leading: bool) {
    let p = md.t.el("a");
    md.t.set_text(p, text.clone());
    md.t.set(p, "href", f"#{elem_id}");
    md.t.set(p, "class", cls.clone());
    if title.len() > 0 {
        md.t.set(p, "title", title.clone());
    }
    if leading {
        let atomic = md.t.nodes[c].text_atomic;
        md.t.set_tail_opt(p, md.t.text(c), atomic);
        md.t.set_text(c, String.new());
        md.t.insert(c, 0, p);
    } else {
        md.t.append(c, p);
    }
}

fn run_toc(md: mut ref Md, doc: i64) {
    let cfg = md.toc_cfg.clone();
    let marker = cfg.s("marker");
    let title = cfg.get("title");
    let base_level = val_int(cfg.get("baselevel")) - 1;
    let sep = cfg.s("separator");
    let toc_class = cfg.s("toc_class");
    let title_class = cfg.get("title_class");
    let use_anchors = val_truthy(parse_bool_value(cfg.get("anchorlink"), true, false));
    let anchorlink_class = cfg.s("anchorlink_class");
    let mut use_permalinks = parse_bool_value(cfg.get("permalink"), false, false);
    if val_is_null(use_permalinks) {
        use_permalinks = cfg.get("permalink");
    }
    let permalink_class = cfg.s("permalink_class");
    let permalink_title = cfg.get("permalink_title");
    let permalink_leading = val_truthy(parse_bool_value(cfg.get("permalink_leading"), false, false));
    let depth = cfg.get("toc_depth");
    let mut toc_top = 1;
    let mut toc_bottom = 6;
    match depth {
        Val.Str(s) => {
            if s.contains("-") {
                let parts = split_on(s, "-");
                toc_top = parse_int(parts[0]);
                toc_bottom = parse_int(parts[1]);
            } else {
                toc_bottom = parse_int(s);
            }
        }
        _ => toc_bottom = val_int(depth),
    }
    // A permalink is added unless the value is False or None.
    let add_permalinks = match use_permalinks {
        Val.Null => false,
        Val.Bool(b) => b,
        Val.Int(i) => i != 0,
        Val.Str(_) => true,
    };
    let permalink_text = if val_is_true(use_permalinks) {
        f"{AMP_SUBSTITUTE}para;"
    } else {
        val_str(use_permalinks)
    };

    let mut used: Vec[String] = Vec.new();
    for e in md.t.iter(doc).iter() {
        match md.t.get(*e, "id") {
            Some(v) => {
                if not used.contains(v) {
                    used.push(v);
                }
            }
            None => {}
        }
    }
    let mut toks: Vec[Tok] = Vec.new();
    for e in md.t.iter(doc).iter() {
        let el = *e;
        if not hdr_match(md.t.tag(el)) {
            continue;
        }
        let mut level = tag_level(md.t.tag(el)) + base_level;
        if level > 6 {
            level = 6;
        }
        md.t.nodes[el].tag = f"h{level}";
        let rf = remove_fnrefs(mut md, el);
        let innerhtml = render_inner_html(mut md, rf);
        let mut name = strip_tags(innerhtml);
        if not md.t.has_attr(el, "id") {
            let plain = unescape(name, md.ents);
            let slug = slugify(mut md, plain, sep);
            let id = toc_unique(mut md, slug, mut used);
            md.t.set(el, "id", id);
        }
        let mut label = String.new();
        if md.t.has_attr(el, "data-toc-label") {
            let raw = md.t.get_or(el, "data-toc-label", "");
            label = run_postprocessors(mut md, backslash_unescape(raw)).0;
            name = escape_cdata(strip_tags(label));
            let _ = md.t.del(el, "data-toc-label");
        }
        let lv = tag_level(md.t.tag(el));
        let elem_id = md.t.get_or(el, "id", "");
        if lv >= toc_top and lv <= toc_bottom {
            toks.push(Tok {
                level: lv,
                id: backslash_unescape(elem_id.clone()),
                name: name,
                html: innerhtml,
                label: label,
                children: Vec.new(),
            });
        }
        if use_anchors {
            toc_add_anchor(mut md, el, elem_id, anchorlink_class);
        }
        if add_permalinks {
            toc_add_permalink(mut md, el, elem_id, permalink_text, permalink_class, val_str_or_empty(permalink_title), permalink_leading);
        }
    }
    let nested = nest_toc_tokens(toks);
    let div = md.t.el("div");
    md.t.set(div, "class", toc_class);
    if val_truthy(title) {
        let header = md.t.sub(div, "span");
        if val_truthy(title_class) {
            md.t.set(header, "class", val_str(title_class));
        }
        md.t.set_text(header, val_str(title));
    }
    build_toc_ul(mut md, nested, div);
    run_prettify(mut md, div);
    if marker.len() > 0 {
        toc_replace_marker(mut md, doc, div, marker);
    }
    let ser = serialize(md.t, div, md.xhtml);
    md.toc = run_postprocessors(mut md, ser).1;
    md.toc_tokens = nested;
}

// A config string where only truthiness and text are read.
fn val_str_or_empty(v: ref Val) -> String {
    if val_truthy(v) { val_str(v) } else { String.new() }
}

// =========================================== pre- and postprocessors
// preprocessors.NormalizeWhitespace and HtmlBlockPreprocessor (and the
// md_in_html variant), fenced_code's and meta's preprocessors, and the
// raw-HTML, ampersand and footnote postprocessors.

fn run_preprocessor(md: mut ref Md, kind: i64, lines: own Vec[String]) -> Vec[String] {
    if kind == K_NORMALIZE {
        let mut source = join(lines, "\n");
        source = source.replace(STX, "").replace(ETX, "");
        source = source.replace("\r\n", "\n").replace("\r", "\n") + "\n\n";
        source = expandtabs(source, md.tab_length);
        let rx = md.re.id(P_NORMALIZE, F_NORMALIZE);
        source = md.re.sub(rx, source, "\n");
        return split_on(source, "\n");
    }
    if kind == K_HTML_BLOCK or kind == K_HTML_BLOCK_EXTRA {
        let source = join(lines, "\n");
        let mut p = new_hp(kind == K_HTML_BLOCK_EXTRA);
        feed_html(mut p, mut md, source);
        close_html(mut p, mut md);
        let mut out = String.new();
        for piece in p.cleandoc.iter() {
            out.push_str(piece);
        }
        return split_on(out, "\n");
    }
    if kind == K_FENCED {
        return run_fenced(mut md, lines);
    }
    if kind == K_META {
        return run_meta(mut md, lines);
    }
    panic(f"unknown preprocessor {kind}")
}

// ------------------------------------------------------- fenced code

fn fenced_escape(txt: ref String) -> String {
    txt.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

const FENCED_BOOL_OPTIONS: Str = "linenums guess_lang noclasses use_pygments";

// util.parse_hl_lines, as the list Python would print.
fn hl_lines_repr(expr: ref String) -> String {
    let mut nums: Vec[String] = Vec.new();
    for w in split_ws(expr).iter() {
        let mut ok = w.len() > 0;
        for c in w.chars() {
            if c < '0' or c > '9' {
                ok = false;
            }
        }
        if not ok {
            return "[]".to_string();
        }
        nums.push(f"{parse_int(w)}");
    }
    f"[{join(nums, ", ")}]"
}

fn cfg_put(cfg: mut ref Vec[(String, Val)], k: ref String, val: own Val) {
    let mut i = 0;
    while i < cfg.len() {
        if cfg[i].0 == *k {
            cfg[i] = (k.clone(), val);
            return;
        }
        i += 1;
    }
    cfg.push((k.clone(), val));
}

// FencedBlockPreprocessor.handle_attrs: (id, classes, config).
fn fenced_handle_attrs(attrs: ref Vec[(String, String)]) -> (String, Vec[String], Vec[(String, Val)]) {
    let mut id = String.new();
    let mut classes: Vec[String] = Vec.new();
    let mut configs: Vec[(String, Val)] = Vec.new();
    for kv in attrs.iter() {
        if kv.0 == "id" {
            id = kv.1.clone();
        } else if kv.0 == "." {
            classes.push(kv.1.clone());
        } else if kv.0 == "hl_lines" {
            cfg_put(mut configs, kv.0, Val.Str(hl_lines_repr(kv.1)));
        } else if has_word(FENCED_BOOL_OPTIONS, kv.0) {
            cfg_put(mut configs, kv.0, parse_bool_value(Val.Str(kv.1.clone()), false, true));
        } else {
            cfg_put(mut configs, kv.0, Val.Str(kv.1.clone()));
        }
    }
    (id, classes, configs)
}

fn has_word(words: Str, w: ref String) -> bool {
    for x in words.split(" ") {
        if x == *w {
            return true;
        }
    }
    false
}

fn kv_get(cfg: ref Vec[(String, Val)], key: Str) -> Option[Val] {
    for kv in cfg.iter() {
        if kv.0 == key {
            return Some(kv.1.clone());
        }
    }
    None
}

fn run_fenced(md: mut ref Md, lines: own Vec[String]) -> Vec[String] {
    if not md.fenced_checked {
        md.fenced_hilite = has_ext(md, "codehilite");
        md.fenced_attr_list = has_ext(md, "attr_list");
        md.fenced_checked = true;
    }
    let rx = md.re.id(P_FENCED, F_FENCED);
    let mut text = join(lines, "\n");
    let mut index = 0;
    loop {
        let m = match md.re.search(rx, text, index) {
            Some(x) => x,
            None => break,
        };
        let mut lang: Option[String] = None;
        let mut id = String.new();
        let mut classes: Vec[String] = Vec.new();
        let mut config: Vec[(String, Val)] = Vec.new();
        let attrs_s = grp(text, m, 4);
        if attrs_s.len() > 0 {
            let (attrs, remainder) = get_attrs_and_remainder(mut md, attrs_s);
            if remainder.len() > 0 {
                index = gend(m, 4);
                continue;
            }
            let (i2, c2, f2) = fenced_handle_attrs(attrs);
            id = i2;
            classes = c2;
            config = f2;
            if classes.len() > 0 {
                lang = Some(classes.remove(0));
            }
        } else {
            let l = grp(text, m, 6);
            if l.len() > 0 {
                lang = Some(l);
            }
            let hl = grp(text, m, 9);
            if hl.len() > 0 {
                config.push(("hl_lines".to_string(), Val.Str(hl_lines_repr(hl))));
            }
        }
        let code_s = grp(text, m, 10);
        let use_pyg = match kv_get(config, "use_pygments") {
            Some(v) => val_truthy(v),
            None => true,
        };
        let mut code = String.new();
        if md.fenced_hilite and val_truthy(md.hilite_cfg.get("use_pygments")) and use_pyg {
            let mut local = md.hilite_cfg.clone();
            for kv in config.iter() {
                local.put(kv.0, kv.1.clone());
            }
            if classes.len() > 0 {
                let cc = f"{join(classes, " ")} {local.s("css_class")}";
                local.put("css_class", Val.Str(cc));
            }
            code = codehilite_html(mut md, code_s, lang, hilite_linenos(local), hilite_cssclass(local), hilite_lang_prefix(local), false);
        } else {
            let mut id_attr = String.new();
            let mut lang_attr = String.new();
            let mut class_attr = String.new();
            let mut kv_pairs = String.new();
            match lang {
                Some(l) => {
                    if l.len() > 0 {
                        let prefix = md.fenced_cfg.s("lang_prefix");
                        lang_attr = f" class=\"{prefix}{escape_attrib_html(l)}\"";
                    }
                }
                None => {}
            }
            if classes.len() > 0 {
                class_attr = f" class=\"{escape_attrib_html(join(classes, " "))}\"";
            }
            if id.len() > 0 {
                id_attr = f" id=\"{escape_attrib_html(id)}\"";
            }
            let pyg_false = match kv_get(config, "use_pygments") {
                Some(v) => not val_truthy(v),
                None => true,
            };
            if md.fenced_attr_list and config.len() > 0 and pyg_false {
                for kv in config.iter() {
                    if kv.0 != "use_pygments" {
                        let k = sanitize_name(mut md, kv.0);
                        kv_pairs.push_str(f" {k}=\"{escape_attrib_html(val_str(kv.1))}\"");
                    }
                }
            }
            let esc = fenced_escape(code_s);
            code = f"<pre{id_attr}{class_attr}><code{lang_attr}{kv_pairs}>{esc}</code></pre>";
        }
        let placeholder = store_html(mut md, code);
        let start = m.start;
        text = f"{upto(text, m.start)}\n{placeholder}\n{after(text, m.end)}";
        index = start + 1 + placeholder.len();
    }
    split_on(text, "\n")
}

// -------------------------------------------------------------- meta

fn run_meta(md: mut ref Md, lines0: own Vec[String]) -> Vec[String] {
    let mut lines = lines0;
    let meta_rx = md.re.id(P_META, F_META);
    let more_rx = md.re.id(P_META_MORE, F_META_MORE);
    let begin_rx = md.re.id(P_META_BEGIN, F_META_BEGIN);
    let end_rx = md.re.id(P_META_END, F_META_END);
    let mut meta: Vec[(String, Vec[String])] = Vec.new();
    let mut key = String.new();
    if lines.len() > 0 and md.re.match_at(begin_rx, lines[0], 0).is_some() {
        lines.remove(0);
    }
    while lines.len() > 0 {
        let line = lines.remove(0);
        let m1 = md.re.match_at(meta_rx, line, 0);
        if is_blank(line) or md.re.match_at(end_rx, line, 0).is_some() {
            break;
        }
        match m1 {
            Some(m) => {
                key = strip_ws(lower(grp(line, m, 1)));
                let value = strip_ws(grp(line, m, 2));
                meta_append(mut meta, key, value);
            }
            None => {
                let m2 = md.re.match_at(more_rx, line, 0);
                match m2 {
                    Some(mm) => {
                        if key.len() > 0 {
                            meta_append(mut meta, key, strip_ws(grp(line, mm, 1)));
                        } else {
                            lines.insert(0, line);
                            break;
                        }
                    }
                    None => {
                        lines.insert(0, line);
                        break;
                    }
                }
            }
        }
    }
    md.meta = meta;
    lines
}

fn meta_append(meta: mut ref Vec[(String, Vec[String])], key: ref String, value: own String) {
    let mut i = 0;
    while i < meta.len() {
        if meta[i].0 == *key {
            meta[i].1.push(value);
            return;
        }
        i += 1;
    }
    meta.push((key.clone(), vec![value]));
}

// ------------------------------------------------------ postprocessors

fn run_postprocessor(md: mut ref Md, kind: i64, text: own String) -> String {
    if kind == Q_RAW_HTML or kind == Q_RAW_HTML_EXTRA {
        if md.html_counter == 0 {
            return text;
        }
        let rx = md.re.id(P_RAW_HTML, F_RAW_HTML);
        return raw_html_sub(mut md, rx, text, kind == Q_RAW_HTML_EXTRA);
    }
    if kind == Q_AMP {
        return text.replace(AMP_SUBSTITUTE, "&");
    }
    if kind == Q_FOOTNOTE {
        let bt = md.fn_cfg.s("BACKLINK_TEXT");
        return text.replace(FN_BACKLINK_TEXT, bt).replace(NBSP_PLACEHOLDER, "&#160;");
    }
    panic(f"unknown postprocessor {kind}")
}

fn stash_to_string(md: ref Md, key: i64, extra: bool) -> String {
    let s = ref md.stash[key];
    if s.is_el {
        if extra {
            return serialize(md.t, s.el, md.xhtml);
        }
        return f"<Element '{md.t.tag(s.el)}'>";
    }
    s.html.clone()
}

fn raw_isblocklevel(md: mut ref Md, html: ref String) -> bool {
    let rx = md.re.id(P_BLOCK_LEVEL, F_BLOCK_LEVEL);
    match md.re.match_at(rx, html, 0) {
        Some(m) => {
            let g = grp(html, m, 1);
            if g.starts_with("!") or g.starts_with("?") or g.starts_with("@") or g.starts_with("%") {
                return true;
            }
            is_block_level(md, g)
        }
        None => false,
    }
}

fn raw_html_sub(md: mut ref Md, rx: i64, text: ref String, extra: bool) -> String {
    let ms = md.re.find_all(rx, text, 0);
    if ms.len() == 0 {
        return text.clone();
    }
    let mut out = String.new();
    let mut last = 0;
    for m in ms.iter() {
        out.push_str(sl(text, last, m.start));
        let g1 = grp(text, m, 1);
        let wrapped = g1.len() > 0;
        let key = if wrapped { parse_int(g1) } else { parse_int(grp(text, m, 2)) };
        if key >= md.html_counter {
            out.push_str(sl(text, m.start, m.end));
        } else {
            let html = stash_to_string(md, key, extra);
            if not wrapped or raw_isblocklevel(mut md, html) {
                out.push_str(raw_html_sub(mut md, rx, html, extra));
            } else {
                out.push_str(raw_html_sub(mut md, rx, f"<p>{html}</p>", extra));
            }
        }
        last = m.end;
    }
    out.push_str(after(text, last));
    out
}

// ============================================================ unescape
// html.unescape (Python 3.13's html/__init__.py), taken from the
// mini_htmlparser app: numeric references through the replacement
// table, named ones by the longest html5 name that prefixes the text.

fn ch_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn ch_hex(c: char) -> bool {
    ch_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn ch_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        match char.try_from(c as i64 + 32) {
            Ok(l) => l,
            Err(_) => c,
        }
    } else {
        c
    }
}

fn chars_text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

// The numeric-character-reference-end-state table of html/__init__.py.
fn invalid_charref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn invalid_codepoint(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

fn push_code(out: mut ref String, num: i64) {
    match char.try_from(num) {
        Ok(c) => out.push(c),
        Err(_) => out.push('\u{fffd}'),
    }
}

fn numeric_ref(num: i64, out: mut ref String) {
    match invalid_charref(num) {
        Some(v) => {
            push_code(mut out, v);
            return;
        }
        None => {}
    }
    if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
        out.push('\u{fffd}');
        return;
    }
    if invalid_codepoint(num) {
        return;
    }
    push_code(mut out, num);
}

// The digits raw[lo..hi] in base 10 or 16, held at 0x110000 once past
// the last code point, as int() then the range check would decide.
fn ref_number(raw: ref Vec[char], lo: i64, hi: i64, base: i64) -> i64 {
    let mut n = 0;
    let mut k = lo;
    while k < hi {
        let c = raw[k];
        let d = if ch_digit(c) {
            c as i64 - '0' as i64
        } else {
            ch_lower(c) as i64 - 'a' as i64 + 10
        };
        n = n * base + d;
        if n > 0x10ffff {
            n = 0x110000;
        }
        k += 1;
    }
    n
}

// A named reference's text, the name possibly ending in ';'.
fn named_ref(name: ref Vec[char], ents: ref Map[String, String], out: mut ref String) {
    let whole = chars_text(name, 0, name.len());
    match ents.get(whole.clone()) {
        Some(v) => {
            out.push_str(v);
            return;
        }
        None => {}
    }
    // The longest name the standard allows as a prefix.
    let mut x = name.len() - 1;
    while x > 1 {
        match ents.get(chars_text(name, 0, x)) {
            Some(v) => {
                out.push_str(v);
                out.push_str(chars_text(name, x, name.len()));
                return;
            }
            None => {}
        }
        x -= 1;
    }
    out.push('&');
    out.push_str(whole);
}

fn named_class(c: char) -> bool {
    not (c == '\t' or c == '\n' or c == '\u{c}' or c == ' ' or c == '<' or c == '&' or c == '#' or c == ';')
}

// html.unescape over raw[lo..hi].
fn unescape_chars(raw: ref Vec[char], lo: i64, hi: i64, ents: ref Map[String, String]) -> String {
    let mut out = String.new();
    let mut p = lo;
    while p < hi {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        if p + 1 < hi and raw[p + 1] == '#' {
            if p + 2 < hi and ch_digit(raw[p + 2]) {
                let mut q = p + 2;
                while q < hi and ch_digit(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 2, q, 10), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else if p + 3 < hi and (raw[p + 2] == 'x' or raw[p + 2] == 'X') and ch_hex(raw[p + 3]) {
                let mut q = p + 3;
                while q < hi and ch_hex(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 3, q, 16), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else {
                out.push('&');
                p += 1;
            }
            continue;
        }
        let mut q = p + 1;
        while q < hi and q - (p + 1) < 32 and named_class(raw[q]) {
            q += 1;
        }
        if q == p + 1 {
            out.push('&');
            p += 1;
            continue;
        }
        if q < hi and raw[q] == ';' {
            q += 1;
        }
        let name: Vec[char] = raw[p + 1..q].iter().collect();
        named_ref(name, ents, mut out);
        p = q;
    }
    out
}

fn unescape(s: ref String, ents: ref Map[String, String]) -> String {
    if not s.contains("&") {
        return s.clone();
    }
    let raw: Vec[char] = s.chars().collect();
    unescape_chars(raw, 0, raw.len(), ents)
}

// ================================================================ main
// The job runner of oracle.py: each job of data/jobs.txt is converted by
// a fresh Markdown with its extensions and configs, and printed with its
// toc and toc_tokens when asked; then the site under data/site/ is built
// into data/out/ with the meta, toc, extra, admonition, codehilite,
// smarty and wikilinks extensions.

#[derive(Clone)]
struct Job {
    name: String,
    exts: Vec[(String, Vec[(String, Val)])],
    attrs: Vec[String],
    src: Vec[String],
}

// The jobs file's escapes: \\, \r and \xHH.
fn job_unesc(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if c == '\\' and i + 1 < cs.len() {
            let d = cs[i + 1];
            if d == '\\' {
                out.push('\\');
                i += 2;
                continue;
            }
            if d == 'r' {
                out.push('\r');
                i += 2;
                continue;
            }
            if d == 'x' and i + 3 < cs.len() {
                let h = chars_text(cs, i + 2, i + 4);
                let mut v = 0;
                for ch in h.chars() {
                    let dv = if ch_digit(ch) { ch as i64 - 48 } else { ch_lower(ch) as i64 - 87 };
                    v = v * 16 + dv;
                }
                push_code(mut out, v);
                i += 4;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    out
}

fn job_value(t: ref String, v: ref String) -> Val {
    if *t == "b" {
        return Val.Bool(*v == "True");
    }
    if *t == "n" {
        return Val.Null;
    }
    if *t == "i" {
        return Val.Int(parse_int(v));
    }
    Val.Str(job_unesc(v))
}

// str.split(sep, n): at most n splits.
fn split_n(s: ref String, sep: Str, n: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut rest = s.clone();
    while out.len() < n {
        let i = find_s(rest, sep);
        if i < 0 {
            break;
        }
        out.push(upto(rest, i));
        rest = after(rest, i + sep.len());
    }
    out.push(rest);
    out
}

fn read_jobs(text: ref String) -> (Vec[Job], Vec[String]) {
    let mut jobs: Vec[Job] = Vec.new();
    let mut site: Vec[String] = Vec.new();
    let mut cur = Job { name: String.new(), exts: Vec.new(), attrs: Vec.new(), src: Vec.new() };
    let mut have = false;
    let mut in_src = false;
    for line in split_on(text, "\n").iter() {
        if have and in_src {
            if line.starts_with("|") {
                cur.src.push(job_unesc(after(line, 1)));
                continue;
            }
            in_src = false;
        }
        if line.starts_with("#job ") {
            cur = Job { name: after(line, 5), exts: Vec.new(), attrs: Vec.new(), src: Vec.new() };
            have = true;
            in_src = false;
        } else if line.starts_with("#ext ") {
            cur.exts.push((after(line, 5), Vec.new()));
        } else if line.starts_with("#cfg ") {
            let parts = split_n(after(line, 5), " ", 3);
            let v = job_value(parts[2], parts[3]);
            let mut k = cur.exts.len() - 1;
            while k >= 0 {
                if cur.exts[k].0 == parts[0] {
                    let mut set = false;
                    let mut i = 0;
                    while i < cur.exts[k].1.len() {
                        if cur.exts[k].1[i].0 == parts[1] {
                            cur.exts[k].1[i] = (parts[1].clone(), v.clone());
                            set = true;
                        }
                        i += 1;
                    }
                    if not set {
                        cur.exts[k].1.push((parts[1].clone(), v.clone()));
                    }
                    break;
                }
                k -= 1;
            }
        } else if line.starts_with("#attr ") {
            cur.attrs.push(after(line, 6));
        } else if *line == "#src" {
            in_src = true;
        } else if *line == "#end" {
            jobs.push(cur.clone());
            have = false;
        } else if line.starts_with("#site ") {
            site = split_on(after(line, 6), " ");
        }
    }
    (jobs, site)
}

fn tokens_repr(toks: ref Vec[Tok]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for t in toks.iter() {
        parts.push(f"{{'level': {t.level}, 'id': {py_repr(t.id)}, 'name': {py_repr(t.name)}, 'html': {py_repr(t.html)}, 'data-toc-label': {py_repr(t.label)}, 'children': {tokens_repr(t.children)}}}");
    }
    f"[{join(parts, ", ")}]"
}

fn flatten_toks(toks: ref Vec[Tok], out: mut ref Vec[Tok]) {
    for t in toks.iter() {
        out.push(t.clone());
        flatten_toks(t.children, mut out);
    }
}

fn fnv1a(bs: ref Slice[u8]) -> i64 {
    let mut h = 0x811c9dc5;
    for b in bs.iter() {
        h = ((h ^ (*b as i64)) * 0x01000193) & 0xffffffff;
    }
    h
}

fn hex8(v: i64) -> String {
    let digits = "0123456789abcdef";
    let mut out = String.new();
    let mut k = 28;
    while k >= 0 {
        let d = (v >> k) & 15;
        out.push_str(sl(digits.to_string(), d, d + 1));
        k -= 4;
    }
    out
}

// The shared tables a Markdown needs, moved in and out of each one.
struct Tables {
    re: Re,
    ents: Map[String, String],
    cp_names: Map[i64, String],
    nfkd: Map[i64, String],
}

fn open_md(tb: mut ref Tables) -> Md {
    let re = mem.replace(mut tb.re, new_re());
    let ents = mem.replace(mut tb.ents, Map.new());
    let cpn = mem.replace(mut tb.cp_names, Map.new());
    let nfkd = mem.replace(mut tb.nfkd, Map.new());
    new_md(re, ents, cpn, nfkd)
}

fn close_md(tb: mut ref Tables, md: mut ref Md) {
    tb.re = mem.replace(mut md.re, new_re());
    tb.ents = mem.replace(mut md.ents, Map.new());
    tb.cp_names = mem.replace(mut md.cp_names, Map.new());
    tb.nfkd = mem.replace(mut md.nfkd, Map.new());
}

fn run_job(tb: mut ref Tables, n: i64, job: ref Job) {
    let mut names: Vec[String] = Vec.new();
    for e in job.exts.iter() {
        names.push(e.0.clone());
    }
    let label = if names.len() > 0 { join(names, ", ") } else { "-".to_string() };
    println(f"== {n} {job.name} | {label}");
    let mut md = open_md(mut tb);
    build(mut md, job.exts);
    let out = convert(mut md, join(job.src, "\n"));
    println(out);
    if job.attrs.contains("toc".to_string()) {
        println("-- toc");
        println(md.toc.clone());
    }
    if job.attrs.contains("toc_tokens".to_string()) {
        println("-- toc_tokens");
        println(tokens_repr(md.toc_tokens));
    }
    close_md(mut tb, mut md);
}

const SITE_EXTENSIONS: Str = "meta toc extra admonition codehilite smarty wikilinks";

struct Page {
    order: i64,
    stem: String,
    title: String,
    body: String,
    toc: String,
    meta: Vec[(String, Vec[String])],
    tokens: Vec[Tok],
}

fn page_html(title: ref String, nav: ref String, toc: ref String, body: ref String) -> String {
    f"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>{title} - Harbor</title>\n</head>\n<body>\n<nav>\n{nav}\n</nav>\n<aside>\n{toc}\n</aside>\n<main>\n{body}\n</main>\n</body>\n</html>\n"
}

fn meta_first(meta: ref Vec[(String, Vec[String])], key: Str) -> Option[String] {
    for kv in meta.iter() {
        if kv.0 == key {
            return Some(kv.1[0].clone());
        }
    }
    None
}

fn run_site(tb: mut ref Tables, pages: ref Vec[String]) -> Result[(), String] {
    let mut names: Vec[String] = Vec.new();
    for x in SITE_EXTENSIONS.split(" ") {
        names.push(x.to_string());
    }
    println(f"== site | {join(names, ", ")}");
    let mut built: Vec[Page] = Vec.new();
    for name in pages.iter() {
        let text = match fs.read_to_string(f"data/site/{name}") {
            Ok(t) => t,
            Err(e) => return Err(f"cannot read {name}: {e}"),
        };
        let mut exts: Vec[(String, Vec[(String, Val)])] = Vec.new();
        for x in names.iter() {
            let mut cfg: Vec[(String, Val)] = Vec.new();
            if *x == "toc" {
                cfg.push(("permalink".to_string(), Val.Bool(true)));
                cfg.push(("toc_depth".to_string(), Val.Str("2-3".to_string())));
            }
            exts.push((x.clone(), cfg));
        }
        let mut md = open_md(mut tb);
        build(mut md, exts);
        let body = convert(mut md, text);
        let stem = upto(name, name.len() - 3);
        let title = meta_first(md.meta, "title") ?? stem.clone();
        let order = match meta_first(md.meta, "order") {
            Some(o) => parse_int(o),
            None => 99,
        };
        built.push(Page {
            order: order,
            stem: stem,
            title: title,
            body: body,
            toc: md.toc.clone(),
            meta: md.meta.clone(),
            tokens: md.toc_tokens.clone(),
        });
        close_md(mut tb, mut md);
    }
    built.sort_by(|a, b| {
        if a.order < b.order {
            Ordering.Less
        } else if a.order > b.order {
            Ordering.Greater
        } else if a.stem < b.stem {
            Ordering.Less
        } else if a.stem > b.stem {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    });
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    for p in built.iter() {
        println(f"-- {p.stem}.md: {p.title} (order {p.order})");
        println(p.body.clone());
        println("-- toc");
        println(p.toc.clone());
        println("-- meta");
        let mut keys: Vec[String] = Vec.new();
        for kv in p.meta.iter() {
            keys.push(kv.0.clone());
        }
        keys.sort();
        for k in keys.iter() {
            for kv in p.meta.iter() {
                if kv.0 == *k {
                    println(f"{k}: {join(kv.1, " | ")}");
                }
            }
        }
    }
    println("-- search");
    for p in built.iter() {
        let mut flat: Vec[Tok] = Vec.new();
        flatten_toks(p.tokens, mut flat);
        for t in flat.iter() {
            println(f"{p.stem}.html#{t.id} {t.level} {t.name}");
        }
    }
    println("-- files");
    for p in built.iter() {
        let mut items: Vec[String] = Vec.new();
        for q in built.iter() {
            let cls = if q.stem == p.stem { " class=\"active\"" } else { "" };
            items.push(f"<li{cls}><a href=\"{q.stem}.html\">{q.title}</a></li>");
        }
        let nav = f"<ul>\n{join(items, "\n")}\n</ul>";
        let page = page_html(p.title, nav, p.toc, p.body);
        let path = f"data/out/{p.stem}.html";
        if let Err(e) = fs.write(path.clone(), page) {
            return Err(f"cannot write {path}: {e}");
        }
        let back = match fs.read_to_string(path.clone()) {
            Ok(t) => t,
            Err(e) => return Err(f"cannot read {path}: {e}"),
        };
        println(f"out/{p.stem}.html {back.len()} bytes fnv {hex8(fnv1a(back.bytes()))}");
    }
    Ok(())
}

struct DataFile {
    path: String,
    body: String,
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/site".to_string()) {
        return Err(f"cannot create data/site: {e}");
    }
    for file in data_files() {
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let (jobs, site) = read_jobs(text);
    let mut tb = Tables {
        re: new_re(),
        ents: html5_entities(),
        cp_names: codepoint_names(),
        nfkd: nfkd_ascii(),
    };
    let mut n = 1;
    for job in jobs.iter() {
        run_job(mut tb, n, job);
        n += 1;
    }
    if site.len() > 0 {
        if let Err(e) = run_site(mut tb, site) {
            eprintln(e);
        }
    }
}

// ============================================================ data

const P_INLINE_PH: Str = "\u{2}klzzwxh:([0-9]+)\u{3}";
const F_INLINE_PH: i64 = 32;
const P_HTML_PH: Str = "\u{2}wzxhzdk:([0-9]+)\u{3}";
const F_HTML_PH: i64 = 32;
const P_NORMALIZE: Str = "(?<=\\n) +\\n";
const F_NORMALIZE: i64 = 32;
const P_BLOCK_LEVEL: Str = "^\\<\\/?([^ >]+)";
const F_BLOCK_LEVEL: i64 = 32;
const P_RAW_HTML: Str = "<p>\u{2}wzxhzdk:([0-9]+)\u{3}</p>|\u{2}wzxhzdk:([0-9]+)\u{3}";
const F_RAW_HTML: i64 = 32;
const P_AMP: Str = "&(?!(?:\\#[0-9]+|\\#x[0-9a-f]+|[0-9a-z]+);)";
const F_AMP: i64 = 34;
const P_LIST_INDENT: Str = "^(([ ]{4})+)";
const F_LIST_INDENT: i64 = 32;
const P_QUOTE: Str = "(^|\\n)[ ]{0,3}>[ ]?(.*)";
const F_QUOTE: i64 = 32;
const P_OL: Str = "^[ ]{0,3}\\d+\\.[ ]+(.*)";
const F_OL: i64 = 32;
const P_OL_CHILD: Str = "^[ ]{0,3}((\\d+\\.)|[*+-])[ ]+(.*)";
const F_OL_CHILD: i64 = 32;
const P_OL_INDENT: Str = "^[ ]{4,7}((\\d+\\.)|[*+-])[ ]+.*";
const F_OL_INDENT: i64 = 32;
const P_UL: Str = "^[ ]{0,3}[*+-][ ]+(.*)";
const F_UL: i64 = 32;
const P_INTEGER: Str = "(\\d+)";
const F_INTEGER: i64 = 32;
const P_HASH: Str = "(?:^|\\n)(?P<level>#{1,6})(?P<header>(?:\\\\.|[^\\\\])*?)#*(?:\\n|$)";
const F_HASH: i64 = 32;
const P_SETEXT: Str = "^.*?\\n(?:=+|-+)[ ]*(\\n|$)";
const F_SETEXT: i64 = 40;
const P_HR: Str = "^[ ]{0,3}(?=(?P<atomicgroup>(-+[ ]{0,2}){3,}|(_+[ ]{0,2}){3,}|(\\*+[ ]{0,2}){3,}))(?P=atomicgroup)[ ]*$";
const F_HR: i64 = 40;
const P_REFERENCE: Str = "^[ ]{0,3}\\[([^\\[\\]]*)\\]:[ ]*(?:\\n[ ]*)?([^\\s]+)[ ]*(?:\\n[ ]*)?(([\"\\'])(.*)\\4[ ]*|\\((.*)\\)[ ]*)?$";
const F_REFERENCE: i64 = 40;
const P_BACKTICK: Str = "(?:(?<!\\\\)((?:\\\\{2})+)(?=`+)|(?<!\\\\)`)";
const F_BACKTICK: i64 = 48;
const P_ESCAPE: Str = "\\\\(.)";
const F_ESCAPE: i64 = 48;
const P_LINK: Str = "(?<!\\!)\\[";
const F_LINK: i64 = 48;
const P_IMAGE_LINK: Str = "\\!\\[";
const F_IMAGE_LINK: i64 = 48;
const P_AUTOLINK: Str = "<((?:[Ff]|[Hh][Tt])[Tt][Pp][Ss]?://[^<>]*)>";
const F_AUTOLINK: i64 = 48;
const P_AUTOMAIL: Str = "<([^<> !]+@[^@<> ]+)>";
const F_AUTOMAIL: i64 = 48;
const P_LINE_BREAK: Str = "  \\n";
const F_LINE_BREAK: i64 = 48;
