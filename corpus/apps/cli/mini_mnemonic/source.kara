const SHA512_IV: Array[u64, 8] = [
    0x6a09e667f3bcc908u64, 0xbb67ae8584caa73bu64, 0x3c6ef372fe94f82bu64, 0xa54ff53a5f1d36f1u64,
    0x510e527fade682d1u64, 0x9b05688c2b3e6c1fu64, 0x1f83d9abfb41bd6bu64, 0x5be0cd19137e2179u64,
];

// SHA-512 (compress512 is further down).
fn sha512(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 128, 16, true);
    let mut h: Vec[u64] = Vec.new();
    for i in 0..8 {
        h.push(SHA512_IV[i]);
    }
    let mut w = blank80();
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be64(m, blk + 8 * t);
        }
        compress512(mut h, mut w);
        blk += 128;
    }
    let mut out: Vec[u8] = Vec.new();
    for i in 0..8 {
        push_be64(mut out, h[i]);
    }
    out
}

// ------------------------------------------------------------ HMAC-SHA512 and PBKDF2

// hmac.new(key, msg, hashlib.sha512).digest()
fn hmac512(key: ref Vec[u8], msg: ref Vec[u8]) -> Vec[u8] {
    let mut k = if key.len() > 128 { sha512(key) } else { key.clone() };
    while k.len() < 128 {
        k.push(0);
    }
    let mut inner: Vec[u8] = Vec.new();
    let mut outer: Vec[u8] = Vec.new();
    for i in 0..128 {
        inner.push(k[i] ^ 0x36);
        outer.push(k[i] ^ 0x5c);
    }
    for b in msg.iter() {
        inner.push(*b);
    }
    let ih = sha512(inner);
    for b in ih.iter() {
        outer.push(*b);
    }
    sha512(outer)
}


// One SHA-512 compression of the 16 words at the front of w into h.
fn compress512(h: mut ref Vec[u64], w: mut ref Vec[u64]) {
    for t in 16..80 {
        let x = w[t - 15];
        let y = w[t - 2];
        let s0 = ((x >> 1u64) | (x << 63u64)) ^ ((x >> 8u64) | (x << 56u64)) ^ (x >> 7u64);
        let s1 = ((y >> 19u64) | (y << 45u64)) ^ ((y >> 61u64) | (y << 3u64)) ^ (y >> 6u64);
        w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
    }
    let mut a = h[0];
    let mut b = h[1];
    let mut c = h[2];
    let mut d = h[3];
    let mut e = h[4];
    let mut f = h[5];
    let mut g = h[6];
    let mut hh = h[7];
    for t in 0..80 {
        let s1 = ((e >> 14u64) | (e << 50u64)) ^ ((e >> 18u64) | (e << 46u64)) ^ ((e >> 41u64) | (e << 23u64));
        let ch = (e & f) ^ ((e ^ 0xFFFFFFFFFFFFFFFFu64) & g);
        let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA512_K[t]).wrapping_add(w[t]);
        let s0 = ((a >> 28u64) | (a << 36u64)) ^ ((a >> 34u64) | (a << 30u64)) ^ ((a >> 39u64) | (a << 25u64));
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = s0.wrapping_add(maj);
        hh = g;
        g = f;
        f = e;
        e = d.wrapping_add(t1);
        d = c;
        c = b;
        b = a;
        a = t1.wrapping_add(t2);
    }
    h[0] = h[0].wrapping_add(a);
    h[1] = h[1].wrapping_add(b);
    h[2] = h[2].wrapping_add(c);
    h[3] = h[3].wrapping_add(d);
    h[4] = h[4].wrapping_add(e);
    h[5] = h[5].wrapping_add(f);
    h[6] = h[6].wrapping_add(g);
    h[7] = h[7].wrapping_add(hh);
}

fn words_of(b: ref Vec[u8]) -> Vec[u64] {
    let mut w: Vec[u64] = Vec.new();
    for t in 0..b.len() / 8 {
        w.push(be64(b, 8 * t));
    }
    w
}

fn blank80() -> Vec[u64] {
    let mut w: Vec[u64] = Vec.new();
    for _ in 0..80 {
        w.push(0u64);
    }
    w
}

// The state after hashing one 128-byte block of key XOR pad.
fn pad_state(key: ref Vec[u8], pad: u8) -> Vec[u64] {
    let mut k: Vec[u8] = Vec.new();
    for i in 0..128 {
        k.push(if i < key.len() { key[i] ^ pad } else { pad });
    }
    let mut h: Vec[u64] = Vec.new();
    for i in 0..8 {
        h.push(SHA512_IV[i]);
    }
    let mut w = blank80();
    let kw = words_of(k);
    for t in 0..16 {
        w[t] = kw[t];
    }
    compress512(mut h, mut w);
    h
}

// SHA-512 of 64 bytes (8 words) after one 128-byte block already in st.
fn finish64(st: ref Vec[u64], words: ref Vec[u64], w: mut ref Vec[u64]) -> Vec[u64] {
    let mut h = st.clone();
    for t in 0..8 {
        w[t] = words[t];
    }
    w[8] = 0x8000000000000000u64;
    for t in 9..15 {
        w[t] = 0u64;
    }
    w[15] = 1536u64;
    compress512(mut h, mut w);
    h
}

// hashlib.pbkdf2_hmac("sha512", password, salt, rounds), 64 bytes.
fn pbkdf2_sha512(password: ref Vec[u8], salt: ref Vec[u8], rounds: i64) -> Vec[u8] {
    let key = if password.len() > 128 { sha512(password) } else { password.clone() };
    let ist = pad_state(key, 0x36);
    let ost = pad_state(key, 0x5c);
    let mut msg = salt.clone();
    msg.push(0);
    msg.push(0);
    msg.push(0);
    msg.push(1);
    let mut ipad: Vec[u8] = Vec.new();
    let mut opad: Vec[u8] = Vec.new();
    for i in 0..128 {
        ipad.push(if i < key.len() { key[i] ^ 0x36 } else { 0x36 });
        opad.push(if i < key.len() { key[i] ^ 0x5c } else { 0x5c });
    }
    let mut inner = ipad.clone();
    inner.extend(msg);
    let mut outer = opad.clone();
    outer.extend(sha512(inner));
    let first = sha512(outer);
    let mut u = words_of(first);
    let mut t = u.clone();
    let mut w = blank80();
    for _ in 1..rounds {
        let ih = finish64(ist, u, mut w);
        u = finish64(ost, ih, mut w);
        for i in 0..8 {
            t[i] = t[i] ^ u[i];
        }
    }
    let mut out: Vec[u8] = Vec.new();
    for i in 0..8 {
        push_be64(mut out, t[i]);
    }
    out
}
// ------------------------------------------------------------ Mnemonic

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: own String) -> Exc {
    exc("ValueError", msg)
}

fn config_error(msg: own String) -> Exc {
    exc("ConfigurationError", msg)
}

fn err_line(e: ref Exc) -> String {
    f"error: {e.kind}: {e.msg}"
}

// A Mnemonic: its language, its wordlist, and two lookups the package
// does by scanning the list (wordlist.index and startswith over every
// word), kept as a map and a sorted copy.
struct Mn {
    language: String,
    wordlist: Vec[String],
    index: Map[String, i64],
    sorted: Vec[String],
    delimiter: String,
}

fn mn_from(language: ref String, words: own Vec[String]) -> Result[Mn, Exc] {
    if words.len() != 2048 {
        return Err(config_error("Wordlist must contain 2048 words.".to_string()));
    }
    let mut index: Map[String, i64] = Map.new();
    for i in 0..words.len() {
        if not index.contains_key(words[i]) {
            index.insert(words[i].clone(), i);
        }
    }
    let mut sorted = words.clone();
    sorted.sort();
    let delimiter = if language == "japanese" { "\u{3000}".to_string() } else { " ".to_string() };
    Ok(Mn { language: language.clone(), wordlist: words, index: index, sorted: sorted, delimiter: delimiter })
}

fn wordlist_path(language: ref String) -> String {
    f"data/wordlist/{language}.txt"
}

fn is_file(path: ref String) -> bool {
    match fs.metadata(path.clone()) {
        Ok(m) => m.is_file,
        Err(_) => false,
    }
}

// Mnemonic(language): the wordlist file read as readlines() and strip().
fn load_mn(language: ref String) -> Result[Mn, Exc] {
    let path = wordlist_path(language);
    if not is_file(path) {
        return Err(config_error("Language not detected".to_string()));
    }
    let text = match fs.read_to_string(path.clone()) {
        Ok(s) => s,
        Err(_) => "".to_string(),
    };
    let mut words: Vec[String] = Vec.new();
    for line in lines_of(text).iter() {
        words.push(strip_ws(line));
    }
    mn_from(language, words)
}

// Mnemonic.list_languages(), sorted.
fn list_languages() -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    match fs.read_dir("data/wordlist".to_string()) {
        Ok(names) => {
            for n in names.iter() {
                if n.ends_with(".txt") {
                    out.push(split_on(n, b'.')[0].clone());
                }
            }
        }
        Err(_) => {}
    }
    out.sort();
    out
}

// Every language's Mnemonic, read once, and the NFKD tables.
struct Ctx {
    t: Tables,
    langs: Vec[Mn],
}

// Mnemonic(language), as a position in ctx.langs.
fn mn_of(ctx: ref Ctx, language: ref String) -> Result[i64, Exc] {
    if not is_file(wordlist_path(language)) {
        return Err(config_error("Language not detected".to_string()));
    }
    for i in 0..ctx.langs.len() {
        if ctx.langs[i].language == *language {
            return Ok(i);
        }
    }
    Err(config_error("Language not detected".to_string()))
}

fn lower_bound(v: ref Vec[String], key: ref String) -> i64 {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v[mid] < *key {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

// any(c.startswith(prefix) for c in wordlist)
fn has_prefix(m: ref Mn, prefix: ref String) -> bool {
    let i = lower_bound(m.sorted, prefix);
    i < m.sorted.len() and m.sorted[i].starts_with(prefix)
}

fn knows(m: ref Mn, word: ref String) -> bool {
    m.index.contains_key(word)
}

fn expand_word(m: ref Mn, prefix: ref String) -> String {
    if knows(m, prefix) {
        return prefix.clone();
    }
    let i = lower_bound(m.sorted, prefix);
    let one = i < m.sorted.len() and m.sorted[i].starts_with(prefix);
    let two = i + 1 < m.sorted.len() and m.sorted[i + 1].starts_with(prefix);
    if one and not two { m.sorted[i].clone() } else { prefix.clone() }
}

fn expand(m: ref Mn, mnemonic: ref String) -> String {
    let mut parts: Vec[String] = Vec.new();
    for w in split_on(mnemonic, b' ').iter() {
        parts.push(expand_word(m, w));
    }
    join(parts, " ")
}

fn bits_of(bytes: ref Vec[u8], count: i64) -> Vec[bool] {
    let mut out: Vec[bool] = Vec.new();
    for i in 0..count {
        out.push((bytes[i / 8] >> ((7 - i % 8) as u8)) & 1 == 1);
    }
    out
}

fn to_mnemonic(m: ref Mn, data: ref Vec[u8]) -> Result[String, Exc] {
    let n = data.len();
    if not (n == 16 or n == 20 or n == 24 or n == 28 or n == 32) {
        return Err(value_error(f"Data length should be one of the following: [16, 20, 24, 28, 32], but it is not {n}."));
    }
    let mut b = bits_of(data, n * 8);
    let h = sha256(data);
    for x in bits_of(h, n * 8 / 32) {
        b.push(x);
    }
    let mut words: Vec[String] = Vec.new();
    for i in 0..b.len() / 11 {
        let mut idx = 0;
        for k in 0..11 {
            idx = idx * 2 + if b[i * 11 + k] { 1 } else { 0 };
        }
        words.push(m.wordlist[idx].clone());
    }
    Ok(join(words, m.delimiter))
}

fn valid_count(n: i64) -> bool {
    n == 12 or n == 15 or n == 18 or n == 21 or n == 24
}

// The 11 bits of each index, packed into bytes: the entropy is the
// first 4 bytes per 33 bits, and the checksum is the top bits of the
// byte after it.
fn packed(indices: ref Vec[i64]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut acc: i64 = 0;
    let mut nb: i64 = 0;
    for ndx in indices.iter() {
        acc = (acc << 11) | *ndx;
        nb += 11;
        while nb >= 8 {
            out.push(((acc >> (nb - 8)) & 0xFF) as u8);
            nb -= 8;
        }
        acc = acc & ((1 << nb) - 1);
    }
    if nb > 0 {
        out.push(((acc << (8 - nb)) & 0xFF) as u8);
    }
    out
}

fn entropy_part(bytes: ref Vec[u8], cs: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for i in 0..cs * 4 {
        out.push(bytes[i]);
    }
    out
}

fn checksum_ok(indices: ref Vec[i64]) -> bool {
    let cs = indices.len() * 11 / 33;
    let bytes = packed(indices);
    let h = sha256(entropy_part(bytes, cs));
    let shift = (8 - cs) as u8;
    (bytes[cs * 4] >> shift) == (h[0] >> shift)
}

fn check(t: ref Tables, m: ref Mn, mnemonic: ref String) -> bool {
    let list = split_on(nfkd(t, mnemonic), b' ');
    if not valid_count(list.len()) {
        return false;
    }
    let mut indices: Vec[i64] = Vec.new();
    for w in list.iter() {
        match m.index.get(w) {
            Some(i) => indices.push(*i),
            None => {
                return false;
            }
        }
    }
    checksum_ok(indices)
}

fn to_entropy(t: ref Tables, m: ref Mn, words: ref Vec[String]) -> Result[Vec[u8], Exc] {
    if not valid_count(words.len()) {
        return Err(value_error(f"Number of words must be one of the following: [12, 15, 18, 21, 24], but it is not ({words.len()})."));
    }
    let mut indices: Vec[i64] = Vec.new();
    for w in words.iter() {
        let nw = nfkd(t, w);
        match m.index.get(nw) {
            Some(i) => indices.push(*i),
            None => {
                return Err(value_error(f"{py_repr_str(nw)} is not in list"));
            }
        }
    }
    if not checksum_ok(indices) {
        return Err(value_error("Failed checksum.".to_string()));
    }
    let cs = indices.len() * 11 / 33;
    let entropy = entropy_part(packed(indices), cs);
    Ok(entropy)
}

fn to_entropy_text(t: ref Tables, m: ref Mn, words: ref String) -> Result[Vec[u8], Exc] {
    to_entropy(t, m, split_on(words, b' '))
}

fn quoted_list(v: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for w in v.iter() {
        parts.push(py_repr_str(w));
    }
    join(parts, ", ")
}

// Mnemonic.detect_language(code)
fn detect_language(ctx: ref Ctx, code: ref String) -> Result[String, Exc] {
    let norm = nfkd(ctx.t, code);
    let mut words: Vec[String] = Vec.new();
    for w in split_ws(norm) {
        if not words.contains(w) {
            words.push(w.clone());
        }
    }
    let mut possible: Vec[i64] = Vec.new();
    for i in 0..ctx.langs.len() {
        possible.push(i);
    }
    for word in words.iter() {
        let mut keep: Vec[i64] = Vec.new();
        for p in possible.iter() {
            if has_prefix(ctx.langs[*p], word) {
                keep.push(*p);
            }
        }
        possible = keep;
        if possible.len() == 0 {
            return Err(config_error(f"Language unrecognized for {py_repr_str(word)}"));
        }
    }
    if possible.len() == 1 {
        return Ok(ctx.langs[possible[0]].language.clone());
    }
    let mut complete: Vec[i64] = Vec.new();
    for word in words.iter() {
        let mut exact: Vec[i64] = Vec.new();
        for p in possible.iter() {
            if knows(ctx.langs[*p], word) {
                exact.push(*p);
            }
        }
        if exact.len() == 1 and not complete.contains(exact[0]) {
            complete.push(exact[0]);
        }
    }
    if complete.len() == 1 {
        return Ok(ctx.langs[complete[0]].language.clone());
    }
    let mut names: Vec[String] = Vec.new();
    for p in possible.iter() {
        names.push(ctx.langs[*p].language.clone());
    }
    Err(config_error(f"Language ambiguous between {join(names, ", ")}"))
}

fn to_seed(t: ref Tables, mnemonic: ref String, passphrase: ref String) -> Vec[u8] {
    let m = nfkd(t, mnemonic);
    let p = f"mnemonic{nfkd(t, passphrase)}";
    pbkdf2_sha512(m.bytes().to_vec(), p.bytes().to_vec(), 2048)
}

// base58 as the package does it: leading zero bytes add nothing.
fn b58encode(v: ref Vec[u8]) -> String {
    let alphabet: Vec[char] = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz".chars().collect();
    let mut num: Vec[i64] = Vec.new();
    for b in v.iter() {
        num.push(*b as i64);
    }
    let mut start = 0;
    let mut digits: Vec[char] = Vec.new();
    loop {
        while start < num.len() and num[start] == 0 {
            start += 1;
        }
        if start == num.len() {
            break;
        }
        let mut rem: i64 = 0;
        for i in start..num.len() {
            let cur = rem * 256 + num[i];
            num[i] = cur / 58;
            rem = cur % 58;
        }
        digits.push(alphabet[rem]);
    }
    let mut out = String.new();
    let mut k = digits.len();
    while k > 0 {
        k -= 1;
        out.push(digits[k]);
    }
    out
}

fn to_hd_master_key(seed: ref Vec[u8], testnet: bool) -> Result[String, Exc] {
    if seed.len() != 64 {
        return Err(value_error("Provided seed should have length of 64".to_string()));
    }
    let i = hmac512("Bitcoin seed".bytes().to_vec(), seed);
    let mut x: Vec[u8] = Vec.new();
    let version: Vec[u8] = if testnet { vec![0x04, 0x35, 0x83, 0x94] } else { vec![0x04, 0x88, 0xad, 0xe4] };
    x.extend(version);
    for _ in 0..9 {
        x.push(0);
    }
    for k in 32..64 {
        x.push(i[k]);
    }
    x.push(0);
    for k in 0..32 {
        x.push(i[k]);
    }
    let h = sha256(sha256(x));
    for k in 0..4 {
        x.push(h[k]);
    }
    Ok(b58encode(x))
}

fn distance(a: ref String, b: ref String) -> i64 {
    let ac: Vec[char] = a.chars().collect();
    let bc: Vec[char] = b.chars().collect();
    let mut prev: Vec[i64] = Vec.new();
    for j in 0..bc.len() + 1 {
        prev.push(j);
    }
    for i in 0..ac.len() {
        let mut cur: Vec[i64] = Vec.new();
        cur.push(i + 1);
        for j in 0..bc.len() {
            let sub = prev[j] + if ac[i] != bc[j] { 1 } else { 0 };
            let mut best = prev[j + 1] + 1;
            if cur[j] + 1 < best {
                best = cur[j] + 1;
            }
            if sub < best {
                best = sub;
            }
            cur.push(best);
        }
        prev = cur;
    }
    prev[bc.len()]
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

// bytes.fromhex: pairs of hex digits, spaces between them allowed.
fn unhex(s: ref String) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if c != b' ' {
            digits.push(c);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < digits.len() {
        out.push((hex_val(digits[i]) * 16 + hex_val(digits[i + 1])) as u8);
        i += 2;
    }
    out
}
// ------------------------------------------------------------ jobs

fn show(text: ref String) -> String {
    let mut out = String.new();
    for c in text.chars() {
        let n = c as i64;
        if c == '\r' {
            out.push_str("<CR>");
        } else if (n < 0x20 and c != '\t' and c != '\n') or (n >= 0x7f and n <= 0x9f) {
            out.push_str(f"<x{hex_digits(n, 2)}>");
        } else {
            out.push(c);
        }
    }
    out
}

// Every line goes out through show().
fn emit(out: mut ref String, line: ref String) {
    out.push_str(show(line));
    out.push_str("\n");
}

fn short(p: ref String) -> String {
    let words = split_ws(p);
    f"{words[0]} ... {words[words.len() - 1]} ({words.len()} words)"
}

fn prefix_of(s: ref String, n: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut out = String.new();
    for i in 0..n {
        if i < cs.len() {
            out.push(cs[i]);
        }
    }
    out
}

fn vectors_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let lang = args[0].clone();
    let m = ref ctx.langs[mn_of(ctx, lang).unwrap_or(0)];
    for row in lines_of(read_text("vectors.tsv".to_string())).iter() {
        let f = split_on(row, b'\t');
        if f[0] != lang {
            continue;
        }
        let code = match to_mnemonic(m, unhex(f[1])) {
            Ok(c) => c,
            Err(e) => err_line(e),
        };
        let mut notes: Vec[String] = Vec.new();
        notes.push(if code == f[2] { "mnemonic ok".to_string() } else { f"mnemonic differs: {code}" });
        notes.push(f"check {py_bool(check(ctx.t, m, f[2]))}");
        match to_entropy(ctx.t, m, split_ws(code)) {
            Ok(back) => {
                let h = hex_of(back);
                notes.push(if h == f[1] { "entropy ok".to_string() } else { f"entropy {h}" });
            }
            Err(e) => notes.push(f"entropy {err_line(e)}"),
        }
        let key = match to_hd_master_key(unhex(f[3]), false) {
            Ok(k) => k,
            Err(e) => err_line(e),
        };
        notes.push(if key == f[4] { "xprv ok".to_string() } else { f"xprv {key}" });
        emit(mut out, f"{prefix_of(f[1], 8)} {short(code)}: {join(notes, ", ")}");
    }
}

fn key_line(seed: ref Vec[u8], testnet: bool) -> String {
    match to_hd_master_key(seed, testnet) {
        Ok(k) => k,
        Err(e) => err_line(e),
    }
}

fn seed_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let s = to_seed(ctx.t, args[0], args[1]);
    emit(mut out, f"seed {hex_of(s)}");
    emit(mut out, f"xprv {key_line(s, false)}");
    emit(mut out, f"tprv {key_line(s, true)}");
}

fn mnemonic_line(ctx: ref Ctx, lang: ref String, hx: ref String) -> Result[String, Exc] {
    let i = mn_of(ctx, lang)?;
    to_mnemonic(ctx.langs[i], unhex(hx))
}

fn to_mnemonic_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    match mnemonic_line(ctx, args[0], args[1]) {
        Ok(s) => emit(mut out, s),
        Err(e) => emit(mut out, err_line(e)),
    }
}

fn check_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let m = ref ctx.langs[mn_of(ctx, args[0]).unwrap_or(0)];
    emit(mut out, f"check = {py_bool(check(ctx.t, m, args[1]))}");
}

fn to_entropy_job(ctx: ref Ctx, args: ref Vec[String], split: bool, out: mut ref String) {
    let m = ref ctx.langs[mn_of(ctx, args[0]).unwrap_or(0)];
    let words = if split { split_ws(args[1]) } else { split_on(args[1], b' ') };
    match to_entropy(ctx.t, m, words) {
        Ok(e) => emit(mut out, f"to_entropy = {hex_of(e)}"),
        Err(x) => emit(mut out, f"to_entropy: {err_line(x)}"),
    }
}

fn expand_word_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let m = ref ctx.langs[mn_of(ctx, args[0]).unwrap_or(0)];
    emit(mut out, f"expand_word({py_repr_str(args[1])}) = {py_repr_str(expand_word(m, args[1]))}");
}

fn expand_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let m = ref ctx.langs[mn_of(ctx, args[0]).unwrap_or(0)];
    emit(mut out, f"expand = {py_repr_str(expand(m, args[1]))}");
}

fn detect_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    match detect_language(ctx, args[0]) {
        Ok(lang) => emit(mut out, f"detect_language = {lang}"),
        Err(e) => emit(mut out, err_line(e)),
    }
}

fn master_job(args: ref Vec[String], out: mut ref String) {
    emit(mut out, key_line(unhex(args[0]), args[1] == "test"));
}

fn b58_job(args: ref Vec[String], out: mut ref String) {
    emit(mut out, f"b58encode = {py_repr_str(b58encode(unhex(args[0])))}");
}

// Only the strength check: the package takes the entropy from the
// secrets module, so the words themselves are not compared.
fn generate_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let n = i64.parse(args[0]).unwrap_or(0);
    if n == 128 or n == 160 or n == 192 or n == 224 or n == 256 {
        let mut data: Vec[u8] = Vec.new();
        for k in 0..n / 8 {
            data.push((k * 37 % 256) as u8);
        }
        let m = ref ctx.langs[mn_of(ctx, "english".to_string()).unwrap_or(0)];
        let words = split_on(to_mnemonic(m, data).unwrap_or("".to_string()), b' ');
        emit(mut out, f"generate({n}): {words.len()} words");
        return;
    }
    emit(mut out, err_line(value_error("Invalid strength value. Allowed values are [128, 160, 192, 224, 256].".to_string())));
}

fn new_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    match mn_of(ctx, args[0]) {
        Ok(i) => {
            let m = ref ctx.langs[i];
            let n = m.wordlist.len();
            emit(mut out, f"{m.language}: {n} words, first {py_repr_str(m.wordlist[0])}, last {py_repr_str(m.wordlist[n - 1])}, delimiter {py_repr_str(m.delimiter)}");
        }
        Err(e) => emit(mut out, err_line(e)),
    }
}

fn custom_lines(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) -> Result[(), Exc] {
    let parts = split_on(read_text(args[0]), b'\n');
    let mut words: Vec[String] = Vec.new();
    for i in 0..parts.len() - 1 {
        words.push(strip_ws(parts[i]));
    }
    let m = mn_from("custom".to_string(), words)?;
    let code = to_mnemonic(m, unhex(args[1]))?;
    emit(mut out, code);
    let e = to_entropy_text(ctx.t, m, code)?;
    emit(mut out, f"check {py_bool(check(ctx.t, m, code))}, to_entropy {hex_of(e)}");
    Ok(())
}

fn custom_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    if let Err(e) = custom_lines(ctx, args, mut out) {
        emit(mut out, err_line(e));
    }
}

fn ascii_number(t: ref String) -> bool {
    if t.len() == 0 {
        return false;
    }
    for b in t.bytes() {
        if not is_digit(b) {
            return false;
        }
    }
    true
}

fn rstrip_dots(s: ref String) -> String {
    let b = to_bytes(s);
    let mut n = b.len();
    while n > 0 and b[n - 1] == b'.' {
        n -= 1;
    }
    byte_str(b, 0, n)
}

// A recovery backup as written down: numbers ("7." or "07") place the
// word after them; other tokens are words in order. Abbreviations are
// expanded, in the language the words point to.
fn backup_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let text = read_text(args[0]);
    let mut placed: Vec[(i64, String)] = Vec.new();
    let mut loose: Vec[String] = Vec.new();
    let mut pending: Option[i64] = None;
    for line in split_on(text, b'\n').iter() {
        if line.starts_with("#") {
            continue;
        }
        for tok in split_ws(line) {
            let t = rstrip_dots(tok);
            if ascii_number(t) {
                pending = Some(i64.parse(t).unwrap_or(0));
                continue;
            }
            match pending {
                Some(k) => {
                    let w = tok.to_lowercase();
                    let mut found = false;
                    for p in placed.iter_mut() {
                        if p.0 == k {
                            p.1 = w.clone();
                            found = true;
                        }
                    }
                    if not found {
                        placed.push((k, w));
                    }
                    pending = None;
                }
                None => loose.push(tok.to_lowercase()),
            }
        }
    }
    let mut words: Vec[String] = Vec.new();
    if placed.len() > 0 and placed.len() >= loose.len() {
        placed.sort_by(|a, b| a.0.cmp(b.0));
        for p in placed.iter() {
            words.push(p.1.clone());
        }
    } else {
        words = loose;
    }
    let lang = match detect_language(ctx, join(words, " ")) {
        Ok(l) => l,
        Err(e) => {
            emit(mut out, f"{words.len()} words; {err_line(e)}");
            return;
        }
    };
    let m = ref ctx.langs[mn_of(ctx, lang).unwrap_or(0)];
    let mut expanded: Vec[String] = Vec.new();
    let mut unknown: Vec[String] = Vec.new();
    for w in words.iter() {
        let x = expand_word(m, nfkd(ctx.t, w));
        if not knows(m, x) {
            unknown.push(x.clone());
        }
        expanded.push(x);
    }
    emit(mut out, f"{words.len()} words, {lang}");
    emit(mut out, f"  {join(expanded, m.delimiter)}");
    if unknown.len() > 0 {
        emit(mut out, f"  not in the {lang} list: {quoted_list(unknown)}");
    }
    emit(mut out, f"  check {py_bool(check(ctx.t, m, join(expanded, " ")))}");
    match to_entropy(ctx.t, m, expanded) {
        Ok(e) => emit(mut out, f"  entropy {hex_of(e)}"),
        Err(e) => emit(mut out, f"  entropy {err_line(e)}"),
    }
}

fn with_word(words: ref Vec[String], i: i64, w: ref String) -> String {
    let mut v = words.clone();
    v[i] = w.clone();
    join(v, " ")
}

fn recover_job(ctx: ref Ctx, args: ref Vec[String], out: mut ref String) {
    let lang = args[0].clone();
    let p = args[1].clone();
    let m = ref ctx.langs[mn_of(ctx, lang).unwrap_or(0)];
    let words = split_on(p, b' ');
    if check(ctx.t, m, p) {
        emit(mut out, "valid as typed".to_string());
        return;
    }
    let mut norm: Vec[String] = Vec.new();
    for w in words.iter() {
        norm.push(nfkd(ctx.t, w));
    }
    let mut unknown: Vec[i64] = Vec.new();
    for i in 0..norm.len() {
        if not knows(m, norm[i]) {
            unknown.push(i);
        }
    }
    if unknown.len() > 1 {
        let mut shown: Vec[String] = Vec.new();
        for i in unknown.iter() {
            shown.push(words[*i].clone());
        }
        emit(mut out, f"{unknown.len()} words not in the {lang} list: {quoted_list(shown)}");
        return;
    }
    if unknown.len() == 1 {
        let i = unknown[0];
        let mut pool: Vec[String] = Vec.new();
        for w in m.wordlist.iter() {
            if words[i] == "?" or distance(norm[i], w) <= 2 {
                pool.push(w.clone());
            }
        }
        let mut found: Vec[String] = Vec.new();
        for w in pool.iter() {
            if check(ctx.t, m, with_word(norm, i, w)) {
                found.push(w.clone());
            }
        }
        let s = if pool.len() == 1 { "" } else { "s" };
        emit(mut out, f"word {i + 1} ({py_repr_str(words[i])}): {pool.len()} candidate{s}, {found.len()} with a valid checksum");
        let mut first: Vec[String] = Vec.new();
        for k in 0..found.len() {
            if k < 8 {
                first.push(found[k].clone());
            }
        }
        let more = if found.len() > 8 { " ..." } else { "" };
        emit(mut out, f"  {join(first, ", ")}{more}");
        if found.len() == 1 {
            let fixed = split_on(with_word(norm, i, found[0]), b' ');
            match to_entropy(ctx.t, m, fixed) {
                Ok(e) => emit(mut out, f"  entropy {hex_of(e)}"),
                Err(e) => emit(mut out, f"  entropy {err_line(e)}"),
            }
        }
        return;
    }
    let mut swaps: Vec[i64] = Vec.new();
    for i in 0..norm.len() - 1 {
        if norm[i] != norm[i + 1] {
            let mut v = norm.clone();
            v.swap(i, i + 1);
            if check(ctx.t, m, join(v, " ")) {
                swaps.push(i);
            }
        }
    }
    let one = swaps.len() == 1;
    let s = if one { "" } else { "s" };
    let es = if one { "es" } else { "" };
    emit(mut out, f"every word is in the list but the checksum fails; {swaps.len()} adjacent swap{s} fix{es} it");
    for i in swaps.iter() {
        emit(mut out, f"  words {*i + 1} and {*i + 2} ({norm[*i]}, {norm[*i + 1]})");
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut langs: Vec[Mn] = Vec.new();
    for name in list_languages() {
        match load_mn(name) {
            Ok(m) => langs.push(m),
            Err(e) => eprintln(err_line(e)),
        }
    }
    let ctx = Ctx { t: Tables { decomp: nfkd_table(), ccc: ccc_table() }, langs: langs };
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())).iter() {
        let job = split_on(line, b'\t');
        emit(mut out, f"== {join(job, " ")}");
        let mut args: Vec[String] = Vec.new();
        for i in 1..job.len() {
            args.push(job[i].clone());
        }
        let kind = job[0].clone();
        if kind == "vectors" {
            vectors_job(ctx, args, mut out);
        } else if kind == "seed" {
            seed_job(ctx, args, mut out);
        } else if kind == "to_mnemonic" {
            to_mnemonic_job(ctx, args, mut out);
        } else if kind == "check" {
            check_job(ctx, args, mut out);
        } else if kind == "to_entropy" {
            to_entropy_job(ctx, args, false, mut out);
        } else if kind == "to_entropy_split" {
            to_entropy_job(ctx, args, true, mut out);
        } else if kind == "expand_word" {
            expand_word_job(ctx, args, mut out);
        } else if kind == "expand" {
            expand_job(ctx, args, mut out);
        } else if kind == "detect" {
            detect_job(ctx, args, mut out);
        } else if kind == "master" {
            master_job(args, mut out);
        } else if kind == "b58" {
            b58_job(args, mut out);
        } else if kind == "generate" {
            generate_job(ctx, args, mut out);
        } else if kind == "new" {
            new_job(ctx, args, mut out);
        } else if kind == "list_languages" {
            emit(mut out, join(list_languages(), ", "));
        } else if kind == "custom" {
            custom_job(ctx, args, mut out);
        } else if kind == "backup" {
            backup_job(ctx, args, mut out);
        } else {
            recover_job(ctx, args, mut out);
        }
    }
    print(out);
}
// NFKD for the characters of tables.py's BLOCKS that it changes,
// from Python's unicodedata.
fn nfkd_table() -> Map[char, String] {
    let mut m: Map[char, String] = Map.new();
    nfkd_part_0(mut m);
    nfkd_part_1(mut m);
    nfkd_part_2(mut m);
    nfkd_part_3(mut m);
    nfkd_part_4(mut m);
    nfkd_part_5(mut m);
    nfkd_part_6(mut m);
    m
}

