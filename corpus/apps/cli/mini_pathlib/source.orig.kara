fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/ops.txt", file_0())?;
    put("data/paths.txt", file_1())?;
    put("data/rules.txt", file_2())?;
    make_dir("data/tree")?;
    put("data/tree/.env", file_3())?;
    put("data/tree/.gitignore", file_4())?;
    make_dir("data/tree/.venv/lib")?;
    put("data/tree/.venv/lib/site.py", file_5())?;
    put("data/tree/README.md", file_6())?;
    make_dir("data/tree/a-b")?;
    put("data/tree/a-b/c.txt", file_7())?;
    make_dir("data/tree/a")?;
    put("data/tree/a/b.txt", file_8())?;
    make_dir("data/tree/build/lib/pkg")?;
    put("data/tree/build/lib/pkg/core.py", file_9())?;
    make_dir("data/tree/dist")?;
    put("data/tree/dist/pkg-1.0-py3-none-any.whl", file_10())?;
    put("data/tree/dist/pkg-1.0.tar.gz", file_11())?;
    make_dir("data/tree/docs/_build/html")?;
    put("data/tree/docs/_build/html/index.html", file_12())?;
    make_dir("data/tree/docs/api")?;
    put("data/tree/docs/api/core.md", file_13())?;
    make_dir("data/tree/docs")?;
    put("data/tree/docs/index.md", file_14())?;
    put("data/tree/pyproject.toml", file_15())?;
    make_dir("data/tree/scripts")?;
    put("data/tree/scripts/release.sh", file_16())?;
    make_dir("data/tree/src/pkg-extras")?;
    put("data/tree/src/pkg-extras/plugin.py", file_17())?;
    make_dir("data/tree/src/pkg.egg-info")?;
