// ------------------------------------------------------------ the tree

const ROOT: Str = "data/tree";

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

// Every path under the tree, relative to it, with whether it is a
// directory.
fn walk(dir: Str, out: mut ref Vec[PPath], dirs: mut ref Vec[bool]) -> Result[(), String] {
    let full = if dir.len() > 0 { f"{ROOT}/{dir}" } else { ROOT.to_string() };
    let names = match fs.read_dir(full.clone()) {
        Ok(v) => v,
        Err(e) => return Err(f"cannot list {full}: {e}"),
    };
    for i in 0..names.len() {
        let rel = if dir.len() > 0 { f"{dir}/{names[i]}" } else { names[i].clone() };
        let is_dir = match fs.metadata(f"{ROOT}/{rel}") {
            Ok(m) => m.is_dir,
            Err(e) => return Err(f"cannot stat {rel}: {e}"),
        };
        out.push(path_of(false, rel));
        dirs.push(is_dir);
        if is_dir {
            walk(rel, out, dirs)?;
        }
    }
    Ok(())
}

fn show_tree() -> Result[(), String] {
    let mut paths: Vec[PPath] = Vec.new();
    let mut is_dir: Vec[bool] = Vec.new();
    walk("", mut paths, mut is_dir)?;
    // sorted as pathlib sorts, segment by segment
    let mut order: Vec[i64] = Vec.new();
    for i in 0..paths.len() {
        order.push(i);
    }
    for i in 1..order.len() {
        let mut j = i;
        while j > 0 and path_lt(paths[order[j]], paths[order[j - 1]]) {
            order.swap(j - 1, j);
            j -= 1;
        }
    }
    println("== tree");
    for k in 0..order.len() {
        let i = order[k];
        println(f"{path_str(paths[i])}{if is_dir[i] { "/" } else { "" }}");
    }
    let mut verbs: Vec[String] = Vec.new();
    let mut pats: Vec[String] = Vec.new();
    for line in lines_of(read("data/rules.txt")?) {
        if line.len() == 0 or first_byte(line) == b'#' {
            continue;
        }
        let (verb, _, pat) = partition(line, b' ');
        verbs.push(verb);
        pats.push(pat);
    }
    println("== select");
    let mut chosen: Vec[PPath] = Vec.new();
    for k in 0..order.len() {
        let i = order[k];
        if is_dir[i] {
            continue;
        }
        let p = paths[i].clone();
        let mut keep = false;
        let mut why = "-".to_string();
        for r in 0..pats.len() {
            if full_match(p, pats[r]) {
                keep = verbs[r] == "include";
                why = f"{r + 1}:{verbs[r]} {pats[r]}";
            }
        }
        println(f"{if keep { "+" } else { "-" }} {path_str(p)}  ({why})");
        if keep {
            chosen.push(p);
        }
    }
    println("== sdist");
    let mut kinds: Vec[String] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    for p in chosen {
        let mut k = join(suffixes(p), "");
        if k.len() == 0 {
            k = "(none)".to_string();
        }
        let mut at: i64 = -1;
        for j in 0..kinds.len() {
            if kinds[j] == k {
                at = j;
            }
        }
        if at < 0 {
            kinds.push(k);
            counts.push(1);
        } else {
            counts[at] += 1;
        }
    }
    for i in 1..kinds.len() {
        let mut j = i;
        while j > 0 and kinds[j] < kinds[j - 1] {
            kinds.swap(j - 1, j);
            counts.swap(j - 1, j);
            j -= 1;
        }
    }
    for i in 0..kinds.len() {
        println(f"{kinds[i]} {counts[i]}");
    }
    println("== install");
    let base = path_of(true, "C:/Users/dev/AppData/Local/pkg");
    let src = path_of(false, "src");
    for p in chosen {
        if not full_match(p, "src/**/*.py") {
            continue;
        }
        let rel = relative_to(p, src, false)?;
        let dest = join_to(base, as_posix(rel));
        println(f"{path_str(p)} -> {path_str(dest)}");
        println(f"  {as_uri(dest)?}");
        let pyc = with_suffix(dest, ".pyc")?;
        println(f"  {path_str(relative_to(pyc, join_to(base, "pkg"), true)?)}");
    }
    println("== objects");
    let obj_root = path_of(false, "build/obj");
    for p in chosen {
        if not path_match(p, "_native/*.c")? {
            continue;
        }
        let obj = join_to(obj_root, path_str(with_suffix(relative_to(p, src, false)?, ".o")?));
        let up = relative_to(parent(obj), parent(p), true)?;
        println(f"{path_str(p)} -> {path_str(obj)} ({path_str(up)})");
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    println("== paths");
    for line in lines_of(read("data/paths.txt")?) {
        let (fl, _, s) = partition(line, b'\t');
        show_path(fl, s);
    }
    println("== ops");
    for line in lines_of(read("data/ops.txt")?) {
        op(split_on(line, b'\t'));
    }
    show_tree()
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_pathlib: {e}");
    }
}
