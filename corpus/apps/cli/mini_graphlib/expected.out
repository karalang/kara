  ValueError: prepare() must be called first
  ValueError: prepare() must be called first
  ValueError: prepare() must be called first
== steps | a:;b:a | done:a
  ValueError: prepare() must be called first
== steps | a:;b:a | prepare ready done:b
  prepare
  ready ('a',)
  ValueError: node 'b' was not passed out (still not ready)
== steps | a:;b:a | prepare ready done:a done:a
  prepare
  ready ('a',)
  done a
  ValueError: node 'a' was already marked done
== steps | a:;b:a | prepare ready done:zz
  prepare
  ready ('a',)
  ValueError: node 'zz' was not added using add()
== steps | a:;b:a | prepare add:c:a
  prepare
  ValueError: Nodes cannot be added after a call to prepare()
== steps | a:;b:a | prepare prepare
  prepare
  ValueError: cannot prepare() more than once
== steps | a:;b:a;c:b | prepare active ready active done:a active ready done:b ready done:c active ready
  prepare
  active True
  ready ('a',)
  active True
  done a
  active True
  ready ('b',)
  done b
  ready ('c',)
  done c
  active False
  ready ()
== steps | a:b;b:a;c: | prepare ready done:c ready active
  CycleError: nodes are in a cycle ['a', 'b', 'a']
  ready ('c',)
  done c
  ready ()
  active False
