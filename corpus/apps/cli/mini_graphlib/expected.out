== order | d:b,c;b:a;c:a
  ['a', 'b', 'c', 'd']
== order | a:;b:;c:
  ['a', 'b', 'c']
== order | c:a,b;a:;b:a
  ['a', 'b', 'c']
== order | -
  []
== order | x:x
  CycleError: nodes are in a cycle ['x', 'x']
== order | a:b;b:c;c:a
  CycleError: nodes are in a cycle ['a', 'c', 'b', 'a']
== order | q:p;p:o;o:n;n:p
  CycleError: nodes are in a cycle ['p', 'n', 'o', 'p']
== order | z:y;y:x;w:v;v:z
  ['x', 'y', 'z', 'v', 'w']
== order | b:a,a;c:b;a:
  ['a', 'b', 'c']
== waves | d:b,c;b:a;c:a;e:a
  wave 1: ('a',)
  wave 2: ('b', 'c', 'e')
  wave 3: ('d',)
== waves | lib:base;app:lib,ui;ui:base;tests:app;base:
  wave 1: ('base',)
  wave 2: ('lib', 'ui')
  wave 3: ('app',)
  wave 4: ('tests',)
