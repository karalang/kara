fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/app.ini", file_0())?;
    put("data/buildout.cfg", file_1())?;
    make_dir("data/conf.d")?;
    put("data/conf.d/broken.ini", file_2())?;
    put("data/conf.d/local.ini", file_3())?;
    put("data/defaults.ini", file_4())?;
    put("data/dupoption.ini", file_5())?;
    put("data/dupsection.ini", file_6())?;
    put("data/git.ini", file_7())?;
    put("data/jobs.txt", file_8())?;
    put("data/my.cnf", file_9())?;
    put("data/noheader.ini", file_10())?;
    put("data/php.ini", file_11())?;
    put("data/setup.cfg", file_12())?;
    put("data/tabs.ini", file_13())?;
    put("data/unit.service", file_14())?;
    put("data/valueless.ini", file_15())?;
    Ok(())
}

// ------------------------------------------------------------ the jobs

fn read_file(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

// A `parser` line's options.
fn new_parser(words: ref Vec[String]) -> Result[Config, String] {
    let mut c = new_config();
    for i in 1..words.len() {
        let b = to_bytes(words[i]);
        let eq = find_byte(b, b'=', 0);
        if eq < 0 {
            return Err(f"bad parser option {words[i]}");
        }
        let k = byte_str(b, 0, eq);
        let v = byte_str(b, eq + 1, b.len());
        let mut chars: Vec[String] = Vec.new();
        let vb = to_bytes(v);
        for j in 0..vb.len() {
            chars.push(byte_str(vb, j, j + 1));
        }
        if k == "interpolation" {
            c.interp = if v == "basic" {
                INTERP_BASIC
            } else if v == "extended" {
                INTERP_EXTENDED
            } else {
                INTERP_NONE
            };
        } else if k == "strict" {
            c.strict = v == "1";
        } else if k == "empty_lines" {
            c.empty_lines = v == "1";
        } else if k == "no_value" {
            c.no_value = v == "1";
        } else if k == "inline" {
            c.inline = chars;
        } else if k == "comments" {
            c.full = chars;
        } else if k == "delimiters" {
            c.delimiters = chars;
        } else if k == "default" {
            c.default_section = v.clone();
            c.defaults.name = v;
        } else {
            return Err(f"bad parser option {k}");
        }
    }
    Ok(c)
}

fn words_from(w: ref Vec[String], from: i64, to: i64) -> String {
    let mut parts: Vec[String] = Vec.new();
    for i in from..to {
        parts.push(w[i].clone());
    }
    join(parts, " ")
}

fn dump(c: ref Config) {
    let mut names: Vec[String] = [c.default_section.clone()];
    let rest = c.section_names();
    for i in 0..rest.len() {
        names.push(rest[i].clone());
    }
    for n in 0..names.len() {
        let s = names[n].clone();
        println(f"  [{s}]");
        let raw = if n == 0 {
            c.defaults.clone()
        } else {
            match c.items(s, true) {
                Ok(d) => d,
                Err(e) => {
                    println(f"    {e}");
                    continue;
                }
            }
        };
        for i in 0..raw.keys.len() {
            println(f"    {raw.keys[i]} = {opt_repr(raw.vals[i])}");
            match c.get(s, raw.keys[i], false) {
                Ok(got) => {
                    if got != raw.vals[i] {
                        println(f"      -> {opt_repr(got)}");
                    }
                }
                Err(e) => println(f"      -> {e}"),
            }
        }
    }
}

// One job line other than parser, dump and write: its result's repr.
fn run_job(c: mut ref Config, w: ref Vec[String]) -> Result[String, String] {
    let cmd = w[0].clone();
    let n = w.len();
    if cmd == "read" {
        let mut names: Vec[String] = Vec.new();
        for i in 1..n {
            names.push(w[i].clone());
        }
        return Ok(list_repr(c.read(names)?));
    }
    if cmd == "sections" {
        return Ok(list_repr(c.section_names()));
    }
    if cmd == "get" or cmd == "getint" or cmd == "getboolean" or cmd == "has" or cmd == "remove-option" {
        let s = words_from(w, 1, n - 1);
        let o = w[n - 1].clone();
        if cmd == "get" {
            return Ok(opt_repr(c.get(s, o, false)?));
        }
        if cmd == "getint" {
            return Ok(f"{c.getint(s, o)?}");
        }
        if cmd == "getboolean" {
            return Ok(py_bool(c.getboolean(s, o)?));
        }
        if cmd == "has" {
            return Ok(py_bool(c.has_option(s, o)));
        }
        return Ok(py_bool(c.remove_option(s, o)?));
    }
    if cmd == "set" {
        c.set(w[1], w[2], words_from(w, 3, n))?;
        return Ok(opt_repr(c.get(w[1], w[2], true)?));
    }
    let s = words_from(w, 1, n);
    if cmd == "items" {
        let d = c.items(s, false)?;
        let mut parts: Vec[String] = Vec.new();
        for i in 0..d.keys.len() {
            parts.push(f"({py_repr(d.keys[i])}, {opt_repr(d.vals[i])})");
        }
        return Ok(f"[{join(parts, ", ")}]");
    }
    if cmd == "add" {
        c.add_section(s)?;
        return Ok("None".to_string());
    }
    if cmd == "remove-section" {
        return Ok(py_bool(c.remove_section(s)));
    }
    Err(f"unknown job {cmd}")
}

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = lines_of(read_file("data/jobs.txt")?);
    let mut c = new_config();
    for j in 0..jobs.len() {
        let line = jobs[j].clone();
        if strip(line).len() == 0 or to_bytes(line)[0] == b'#' {
            continue;
        }
        let w = split_ws(line);
        if w[0] == "parser" {
            println(f"== {line}");
            c = new_parser(w)?;
        } else if w[0] == "dump" {
            println("-- dump");
            dump(c);
        } else if w[0] == "write" {
            println("-- write");
            let text = c.write();
            let ls = lines_of(text);
            for i in 0..ls.len() {
                println(f"  |{ls[i]}");
            }
        } else {
            match run_job(mut c, w) {
                Ok(r) => println(f"{line}: {r}"),
                Err(e) => println(f"{line}: {e}"),
            }
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_ini: {e}");
    }
}
