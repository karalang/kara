// mini_mrjob: MapReduce jobs in the shape of mrjob's. A job is a list of
// steps, each a mapper, an optional combiner and a reducer. A run splits
// the step's input into map tasks, combines each task's pairs, partitions
// them by a hash of the key, sorts each partition and reduces it, and the
// next step reads what the last one wrote. The tasks of each stage go to a
// pool of worker tasks that share one channel behind a mutex and count what
// they do in atomics and a locked table.
// README.md is the spec; oracle.py is the reference.

import std.encoding.hex_decode;
import std.sync.{channel, Sender, Receiver, Mutex, Atomic};

const WORKERS: i64 = 4;
const CAPACITY: i64 = 64;

// ------------------------------------------------------------ tokens

fn is_name(s: Str) -> bool {
    let b = s.bytes();
    b.len() > 0 and b.len() <= 32 and b[0] >= b'a' and b[0] <= b'z'
        and b.iter().all(|c| (c >= b'a' and c <= b'z') or (c >= b'0' and c <= b'9') or c == b'_')
}

// An i64 written as an optional `-` and 1 to 9 digits.
fn number(s: Str) -> Option[i64] {
    let d = s.strip_prefix("-") ?? s;
    if d.len() == 0 or d.len() > 9 or not d.bytes().iter().all(|c| c >= b'0' and c <= b'9') {
        return None;
    }
    i64.parse(s).ok()
}

fn words(line: Str) -> Vec[String] {
    let body = match line.split_once("#") {
        Some((before, _)) => before,
        None => line,
    };
    body.split_whitespace().map(|w| w.to_string()).collect()
}

fn joined(parts: Slice[String], sep: Str) -> String {
    let mut out = String.new();
    for (i, p) in parts.iter().enumerate() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(p);
    }
    out
}

fn plural(n: i64, word: Str) -> String {
    if n == 1 { f"{n} {word}" } else { f"{n} {word}s" }
}

// The runs of ASCII letters in a line, lowercased.
fn tokens(text: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in text.chars() {
        let c = c.to_ascii_lowercase();
        if c >= 'a' and c <= 'z' {
            cur.push(c);
        } else if not cur.is_empty() {
            out.push(cur);
            cur = String.new();
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// ------------------------------------------------------------ values

#[derive(Clone, PartialEq, Eq)]
enum Value {
    Int(i64),
    Text(String),
    List(Vec[Value]),
}

impl PartialOrd for Value {
    fn partial_cmp(ref self, other: ref Value) -> Option[Ordering] {
        Some(self.cmp(other))
    }
}

impl Ord for Value {
    fn cmp(ref self, other: ref Value) -> Ordering {
        match (self, other) {
            (Value.Int(a), Value.Int(b)) => a.cmp(b),
            (Value.Text(a), Value.Text(b)) => a.cmp(b),
            (Value.List(a), Value.List(b)) => {
                for (x, y) in a.iter().zip(b.iter()) {
                    let o = x.cmp(y);
                    if not o.is_eq() {
                        return o;
                    }
                }
                a.len().cmp(b.len())
            }
            _ => rank(self).cmp(rank(other)),
        }
    }
}

fn rank(v: ref Value) -> i64 {
    match v {
        Value.Int(_) => 0,
        Value.Text(_) => 1,
        Value.List(_) => 2,
    }
}

fn kind(v: ref Value) -> Str {
    match v {
        Value.Int(_) => "an int",
        Value.Text(_) => "text",
        Value.List(_) => "a list",
    }
}

fn json(v: ref Value) -> String {
    match v {
        Value.Int(n) => n.to_string(),
        Value.Text(s) => {
            let mut out = String.from("\"");
            for c in s.chars() {
                if c == '"' or c == '\\' {
                    out.push('\\');
                }
                out.push(c);
            }
            out.push('"');
            out
        }
        Value.List(items) => {
            let parts: Vec[String] = items.iter().map(|x| json(x)).collect();
            f"[{joined(parts, ",")}]"
        }
    }
}

// FNV-1a, 32 bits, over the key's JSON text.
fn fnv(s: Str) -> i64 {
    let mut h: i64 = 2166136261;
    for b in s.bytes() {
        h = h ^ b;
        h = (h * 16777619) % 4294967296;
    }
    h
}

// ------------------------------------------------------------ steps

#[derive(Clone, Copy, PartialEq)]
enum Mapper { Words, Bigrams, Lengths, Index, Pack, FirstLetter, Total }

#[derive(Clone, Copy, PartialEq)]
enum Reducer { Sum, Max, Count, Collect, Top3 }

fn mapper_of(name: Str) -> Option[Mapper] {
    match name {
        "words" => Some(Mapper.Words),
        "bigrams" => Some(Mapper.Bigrams),
        "lengths" => Some(Mapper.Lengths),
        "index" => Some(Mapper.Index),
        "pack" => Some(Mapper.Pack),
        "first_letter" => Some(Mapper.FirstLetter),
        "total" => Some(Mapper.Total),
        _ => None,
    }
}

fn mapper_name(m: Mapper) -> Str {
    match m {
        Mapper.Words => "words",
        Mapper.Bigrams => "bigrams",
        Mapper.Lengths => "lengths",
        Mapper.Index => "index",
        Mapper.Pack => "pack",
        Mapper.FirstLetter => "first_letter",
        Mapper.Total => "total",
    }
}

fn reducer_of(name: Str) -> Option[Reducer] {
    match name {
        "sum" => Some(Reducer.Sum),
        "max" => Some(Reducer.Max),
        "count" => Some(Reducer.Count),
        "collect" => Some(Reducer.Collect),
        "top3" => Some(Reducer.Top3),
        _ => None,
    }
}

fn reducer_name(r: Reducer) -> Str {
    match r {
        Reducer.Sum => "sum",
        Reducer.Max => "max",
        Reducer.Count => "count",
        Reducer.Collect => "collect",
        Reducer.Top3 => "top3",
    }
}

#[derive(Clone, Copy)]
struct Step {
    mapper: Mapper,
    combiner: Option[Reducer],
    reducer: Reducer,
}

fn step_name(s: Step) -> String {
    match s.combiner {
        Some(c) => f"{mapper_name(s.mapper)}|{reducer_name(c)}|{reducer_name(s.reducer)}",
        None => f"{mapper_name(s.mapper)}|{reducer_name(s.reducer)}",
    }
}

// A record a mapper reads: a line of an input file, or a pair a step wrote.
#[derive(Clone)]
enum Rec {
    Line(String, i64, String),
    Pair(Value, Value),
}

fn stem(path: Str) -> Str {
    let name = match path.rsplit_once("/") {
        Some((_, n)) => n,
        None => path,
    };
    match name.rsplit_once(".") {
        Some((s, _)) => s,
        None => name,
    }
}

fn map_one(m: Mapper, rec: ref Rec, out: mut ref Vec[(Value, Value)]) -> Result[(), String] {
    match rec {
        Rec.Line(path, no, text) => {
            let ws = tokens(text);
            match m {
                Mapper.Words => {
                    for w in ws.into_iter() {
                        out.push((Value.Text(w), Value.Int(1)));
                    }
                }
                Mapper.Bigrams => {
                    for i in 1..ws.len() {
                        out.push((Value.Text(f"{ws[i - 1]} {ws[i]}"), Value.Int(1)));
                    }
                }
                Mapper.Lengths => {
                    for w in ws.iter() {
                        out.push((Value.Int(w.len()), Value.Int(1)));
                    }
                }
                Mapper.Index => {
                    let at = f"{stem(path)}:{no}";
                    for w in ws.into_iter() {
                        out.push((Value.Text(w), Value.Text(at.clone())));
                    }
                }
                _ => return Err(f"TypeError: {mapper_name(m)} expects a pair, got a line"),
            }
        }
        Rec.Pair(k, v) => match m {
            Mapper.Pack => out.push((Value.Text("all"), Value.List([v.clone(), k.clone()]))),
            Mapper.Total => out.push((Value.Text("total"), v.clone())),
            Mapper.FirstLetter => match k {
                Value.Text(s) => {
                    let first: String = s.chars().take(1).collect();
                    out.push((Value.Text(first), v.clone()));
                }
                other => return Err(f"TypeError: first_letter expects a text key, got {kind(other)}"),
            },
            _ => return Err(f"TypeError: {mapper_name(m)} expects a line, got a pair"),
        },
    }
    Ok(())
}

fn reduce_one(r: Reducer, vals: own Vec[Value]) -> Result[Value, String] {
    match r {
        Reducer.Sum | Reducer.Max => {
            let mut ints: Vec[i64] = Vec.new();
            for v in vals.iter() {
                match v {
                    Value.Int(n) => ints.push(n),
                    other => return Err(f"TypeError: {reducer_name(r)} expects ints, got {kind(other)}"),
                }
            }
            if r == Reducer.Max {
                return Ok(Value.Int(ints.iter().max() ?? 0));
            }
            let mut total: i64 = 0;
            for n in ints.iter() {
                total = total.checked_add(*n).ok_or("OverflowError: sum does not fit in 64 bits")?;
            }
            Ok(Value.Int(total))
        }
        Reducer.Count => Ok(Value.Int(vals.len())),
        Reducer.Collect => {
            let mut s = vals;
            s.sort();
            s.dedup();
            Ok(Value.List(s))
        }
        Reducer.Top3 => {
            let mut s = vals;
            s.sort_by(|a, b| b.cmp(a));
            s.truncate(3);
            Ok(Value.List(s))
        }
    }
}

// Sorts pairs by key, keeping their order within a key, and reduces each
// key's values.
fn reduce_all(r: Reducer, pairs: own Vec[(Value, Value)]) -> Result[Vec[(Value, Value)], String] {
    let mut pairs = pairs;
    pairs.sort_by(|a, b| a.0.cmp(b.0));
    let mut out: Vec[(Value, Value)] = Vec.new();
    let mut key: Option[Value] = None;
    let mut vals: Vec[Value] = Vec.new();
    for (k, v) in pairs.into_iter() {
        if let Some(cur) = key {
            if cur == k {
                vals.push(v);
                key = Some(cur);
                continue;
            }
            out.push((cur, reduce_one(r, vals)?));
            vals = Vec.new();
        }
        key = Some(k);
        vals.push(v);
    }
    if let Some(cur) = key {
        out.push((cur, reduce_one(r, vals)?));
    }
    Ok(out)
}

// ------------------------------------------------------------ the pool

enum Work {
    Map(Vec[Rec]),
    Reduce(Vec[(Value, Value)]),
}

struct Task {
    slot: i64,
    step: Step,
    reduces: i64,
    work: Work,
}

// A map task's pairs after its combiner, by partition, and how many the
// mapper wrote; a reduce task's output is its one partition.
struct Out {
    emitted: i64,
    parts: Vec[Vec[(Value, Value)]],
}

struct Done {
    slot: i64,
    result: Result[Out, String],
}

sync struct Pool {
    inbox: Mutex[Receiver[Task]],
    tasks: Atomic[i64],
    records: Atomic[i64],
    failed: Atomic[i64],
    by_kind: Mutex[SortedMap[String, i64]],
}

fn map_task(step: Step, reduces: i64, recs: ref Vec[Rec]) -> Result[Out, String] {
    let mut pairs: Vec[(Value, Value)] = Vec.new();
    for rec in recs.iter() {
        map_one(step.mapper, rec, mut pairs)?;
    }
    let emitted = pairs.len();
    if let Some(c) = step.combiner {
        pairs = reduce_all(c, pairs)?;
    }
    let mut parts: Vec[Vec[(Value, Value)]] = Vec.new();
    for _ in 0..reduces {
        parts.push(Vec.new());
    }
    for (k, v) in pairs.into_iter() {
        let p = fnv(json(k)) % reduces;
        parts[p].push((k, v));
    }
    Ok(Out { emitted: emitted, parts: parts })
}

fn perform(pool: Pool, task: own Task) -> Result[Out, String] {
    let (name, n, result) = match task.work {
        Work.Map(recs) => ("map", recs.len(), map_task(task.step, task.reduces, recs)),
        Work.Reduce(pairs) => {
            let n = pairs.len();
            let result = reduce_all(task.step.reducer, pairs).map(|out| Out { emitted: n, parts: [out] });
            ("reduce", n, result)
        }
    };
    pool.tasks.fetch_add(1);
    pool.records.fetch_add(n);
    if result.is_err() {
        pool.failed.fetch_add(1);
    }
    {
        let g = pool.by_kind.lock();
        let had = g.value.get(name) ?? 0;
        g.value.insert(name.to_string(), had + 1);
    }
    result
}

fn worker(pool: Pool, out: own Sender[Done]) {
    loop {
        let next = {
            let g = pool.inbox.lock();
            g.value.recv()
        };
        let Some(task) = next else {
            return;
        };
        let slot = task.slot;
        let result = perform(pool, task);
        if out.send(Done { slot: slot, result: result }).is_err() {
            return;
        }
    }
}

// ------------------------------------------------------------ jobs

struct Opts {
    maps: i64,
    reduces: i64,
    show: i64,
}

struct Mr {
    inputs: Map[String, Vec[Rec]],
    jobs: SortedMap[String, Vec[Step]],
    runs: Map[String, i64],
    to_workers: Sender[Task],
    from_workers: Receiver[Done],
}

// Contiguous chunks, the first `n % k` one record longer.
fn chunks(recs: ref Vec[Rec], k: i64) -> Vec[Vec[Rec]] {
    let base = recs.len() / k;
    let extra = recs.len() % k;
    let mut out: Vec[Vec[Rec]] = Vec.new();
    let mut at = 0;
    for i in 0..k {
        let size = if i < extra { base + 1 } else { base };
        out.push(recs[at..at + size].to_vec());
        at += size;
    }
    out
}

impl Mr {
    fn new(to_workers: own Sender[Task], from_workers: own Receiver[Done]) -> Mr {
        Mr {
            inputs: Map.new(),
            jobs: SortedMap.new(),
            runs: Map.new(),
            to_workers: to_workers,
            from_workers: from_workers,
        }
    }

    // Hands the stage's tasks to the workers and puts each result in its
    // slot, whatever order they finish in.
    fn stage(ref self, step: Step, reduces: i64, works: own Vec[Work]) -> Result[Vec[Result[Out, String]], String] {
        let n = works.len();
        for (i, work) in works.into_iter().enumerate() {
            let task = Task { slot: i, step: step, reduces: reduces, work: work };
            self.to_workers.send(task).map_err(|_| "the workers are gone")?;
        }
        let mut slots: Vec[Option[Result[Out, String]]] = Vec.new();
        for _ in 0..n {
            slots.push(None);
        }
        for _ in 0..n {
            let Some(done) = self.from_workers.recv() else {
                return Err("the workers are gone".to_string());
            };
            slots[done.slot] = Some(done.result);
        }
        Ok(slots.into_iter().map(|s| s.unwrap()).collect())
    }

    fn run(mut ref self, job: Str, input: Str, o: Opts) -> Result[(), String] {
        self.runs[job.to_string()] += 1;
        println(f"  run {job} on {input} (maps {o.maps}, reduces {o.reduces})");
        let steps = self.jobs[job].clone();
        let mut recs = self.inputs[input].clone();
        for (si, step) in steps.iter().enumerate() {
            let head = f"  step {si + 1} {step_name(*step)}";
            let n_in = recs.len();
            let works: Vec[Work] = chunks(recs, o.maps).into_iter().map(|c| Work.Map(c)).collect();
            let mut emitted = 0;
            let mut ins: Vec[Vec[(Value, Value)]] = Vec.new();
            for _ in 0..o.reduces {
                ins.push(Vec.new());
            }
            for (i, r) in self.stage(*step, o.reduces, works)?.into_iter().enumerate() {
                match r {
                    Ok(out) => {
                        emitted += out.emitted;
                        for (p, part) in out.parts.into_iter().enumerate() {
                            ins[p].extend(part);
                        }
                    }
                    Err(e) => {
                        println(f"{head}: failed in map task {i}: {e}");
                        return Ok(());
                    }
                }
            }
            let combined: i64 = ins.iter().map(|p| p.len()).sum();
            let sizes: Vec[String] = ins.iter().map(|p| p.len().to_string()).collect();
            let works: Vec[Work] = ins.into_iter().map(|p| Work.Reduce(p)).collect();
            let mut out: Vec[(Value, Value)] = Vec.new();
            for (i, r) in self.stage(*step, o.reduces, works)?.into_iter().enumerate() {
                match r {
                    Ok(done) => {
                        for part in done.parts.into_iter() {
                            out.extend(part);
                        }
                    }
                    Err(e) => {
                        println(f"{head}: failed in reduce task {i}: {e}");
                        return Ok(());
                    }
                }
            }
            let comb = if step.combiner.is_some() { f", {combined} combined" } else { String.new() };
            println(f"{head}: map {n_in} in, {emitted} out{comb}; reduce [{joined(sizes, ", ")}] in, {out.len()} out");
            recs = out.into_iter().map(|(k, v)| Rec.Pair(k, v)).collect();
        }
        println(f"  output: {plural(recs.len(), "record")}");
        for rec in recs.iter().take(o.show) {
            if let Rec.Pair(k, v) = rec {
                println(f"    {json(k)}\t{json(v)}");
            }
        }
        if recs.len() > o.show {
            println(f"    ... {recs.len() - o.show} more");
        }
        Ok(())
    }

    fn input(mut ref self, w: ref Vec[String]) -> Result[(), String] {
        if w.len() < 3 {
            return Err("usage: input <name> <path>...".to_string());
        }
        let name = w[1].clone();
        if not is_name(name) {
            return Err(f"bad name '{name}'");
        }
        if self.inputs.contains_key(name) {
            return Err(f"input {name} already exists");
        }
        let mut recs: Vec[Rec] = Vec.new();
        for path in w[2..].iter() {
            let text = fs.read_to_string(f"data/{path}").map_err(|_| f"cannot read {path}")?;
            let mut lines: Vec[Str] = text.split("\n").collect();
            if lines.last().is_some_and(|l| l.is_empty()) {
                lines.pop();
            }
            for (i, line) in lines.iter().enumerate() {
                recs.push(Rec.Line(path.clone(), i + 1, line.to_string()));
            }
        }
        println(f"  {name}: {plural(w.len() - 2, "file")}, {recs.len()} lines");
        self.inputs.insert(name, recs);
        Ok(())
    }

    fn job(mut ref self, w: ref Vec[String]) -> Result[(), String] {
        if w.len() < 3 {
            return Err("usage: job <name> <step>...".to_string());
        }
        let name = w[1].clone();
        if not is_name(name) {
            return Err(f"bad name '{name}'");
        }
        if self.jobs.contains_key(name) {
            return Err(f"job {name} already exists");
        }
        let mut steps: Vec[Step] = Vec.new();
        for s in w[2..].iter() {
            let parts: Vec[Str] = s.split("|").collect();
            if parts.len() != 2 and parts.len() != 3 {
                return Err(f"bad step '{s}': want mapper|reducer or mapper|combiner|reducer");
            }
            let mapper = mapper_of(parts[0]).ok_or(f"unknown mapper '{parts[0]}'")?;
            let mut combiner: Option[Reducer] = None;
            if parts.len() == 3 {
                let c = reducer_of(parts[1]);
                if c != Some(Reducer.Sum) and c != Some(Reducer.Max) {
                    return Err(f"bad combiner '{parts[1]}': only sum and max can combine");
                }
                combiner = c;
            }
            let last = parts[parts.len() - 1];
            let reducer = reducer_of(last).ok_or(f"unknown reducer '{last}'")?;
            steps.push(Step { mapper: mapper, combiner: combiner, reducer: reducer });
        }
        println(f"  {name}: {plural(steps.len(), "step")}");
        self.runs.insert(name.clone(), 0);
        self.jobs.insert(name, steps);
        Ok(())
    }

    fn start(mut ref self, w: ref Vec[String]) -> Result[(), String] {
        if w.len() < 3 {
            return Err("usage: run <job> <input> [maps=<n>] [reduces=<n>] [show=<n>]".to_string());
        }
        let job = w[1].clone();
        let input = w[2].clone();
        if not self.jobs.contains_key(job) {
            return Err(f"no job '{job}'");
        }
        if not self.inputs.contains_key(input) {
            return Err(f"no input '{input}'");
        }
        let mut given: Map[String, i64] = Map.new();
        for o in w[3..].iter() {
            let Some((k, v)) = o.split_once("=") else {
                return Err(f"unknown option '{o}'");
            };
            if k != "maps" and k != "reduces" and k != "show" {
                return Err(f"unknown option '{o}'");
            }
            if given.contains_key(k) {
                return Err(f"option {k} given twice");
            }
            let (lo, hi) = if k == "show" { (0, 1000) } else { (1, 64) };
            let n = number(v).filter(|n| *n >= lo and *n <= hi).ok_or(f"bad value for {k}: '{v}'")?;
            given.insert(k.to_string(), n);
        }
        let opts = Opts {
            maps: given.get("maps") ?? 4,
            reduces: given.get("reduces") ?? 3,
            show: given.get("show") ?? 10,
        };
        self.run(job, input, opts)
    }

    fn list(ref self) {
        for (name, steps) in self.jobs.iter() {
            let names: Vec[String] = steps.iter().map(|s| step_name(*s)).collect();
            let runs = self.runs.get(name) ?? 0;
            println(f"  {name}: {joined(names, " ")} ({plural(runs, "run")})");
        }
    }

    fn command(mut ref self, w: ref Vec[String]) -> Result[(), String] {
        match w[0].as_str() {
            "input" => self.input(w),
            "job" => self.job(w),
            "run" => self.start(w),
            "jobs" => {
                if w.len() != 1 {
                    return Err("usage: jobs".to_string());
                }
                self.list();
                Ok(())
            }
            other => Err(f"unknown command '{other}'"),
        }
    }
}

// ------------------------------------------------------------ main

fn play(text: Str, to_workers: own Sender[Task], from_workers: own Receiver[Done]) {
    let mut mr = Mr.new(to_workers, from_workers);
    println(f"== script ({WORKERS} workers)");
    for (i, line) in text.split("\n").enumerate() {
        let w = words(line);
        if w.is_empty() {
            continue;
        }
        println(f"> {joined(w, " ")}");
        if let Err(e) = mr.command(w) {
            println(f"  error: script.txt:{i + 1}: {e}");
        }
    }
    println("== end");
    println(f"  {mr.inputs.len()} inputs, {mr.jobs.len()} jobs");
}   // mr drops here, which closes the workers' channel

fn run() -> Result[(), String] {
    fs.create_dir_all("data/input").map_err(|e| f"cannot create data/input: {e}")?;
    write_data()?;
    let text = fs.read_to_string("data/script.txt").map_err(|e| f"cannot read data/script.txt: {e}")?;
    let (to_workers, inbox): (Sender[Task], Receiver[Task]) = channel(CAPACITY);
    let (outbox, from_workers): (Sender[Done], Receiver[Done]) = channel(CAPACITY);
    let pool = Pool {
        inbox: Mutex.new(inbox),
        tasks: Atomic.new(0),
        records: Atomic.new(0),
        failed: Atomic.new(0),
        by_kind: Mutex.new(SortedMap.new()),
    };
    {
        let workers = TaskGroup.new();
        for _ in 0..WORKERS {
            let out = outbox.clone();
            workers.spawn(|| worker(pool, out));
        }
        play(text, to_workers, from_workers);
    }   // every worker has seen the channel close; the group joins them
    let kinds = {
        let g = pool.by_kind.lock();
        let parts: Vec[String] = g.value.iter().map(|(k, n)| f"{k} {n}").collect();
        if parts.is_empty() { "none".to_string() } else { joined(parts, ", ") }
    };
    println(f"  {WORKERS} workers: {pool.tasks.load()} tasks, {pool.records.load()} records in, {pool.failed.load()} failed");
    println(f"  by kind: {kinds}");
    Ok(())
}

fn put_bytes(path: Str, hex: Str) -> Result[(), String] {
    let digits: String = hex.chars().filter(|c| not c.is_whitespace()).collect();
    let bytes = hex_decode(digits).map_err(|e| f"bad data for {path}: {e}")?;
    fs.write_bytes(path, bytes).map_err(|e| f"cannot write {path}: {e}")
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/input/empty.txt", file_0())?;
    put_bytes("data/input/harbor.txt", file_1())?;
    put_bytes("data/input/orchard.txt", file_2())?;
    put_bytes("data/script.txt", file_3())?;
    Ok(())
}

