// mini_xlsxwriter: a port of XlsxWriter 3.2.0 (BSD-2-Clause, John McNamara),
// the Python library that writes Excel .xlsx files.
//
// It builds a workbook from cell writes (strings, numbers, formulas, array
// and dynamic-array formulas, booleans, dates and times, hyperlinks, rich
// strings), cell formats (fonts, fills, borders, alignment, protection,
// number formats), column and row settings, merged ranges, autofilters,
// data validation, tables with total rows, defined names, panes, page
// setup and protection, and packages it the way XlsxWriter does: every XML
// part byte for byte, then a zip file written to disk and read back. The
// jobs come from data/jobs.txt; oracle.py runs the same jobs on the
// vendored library and wrote expected.out.

// ------------------------------------------------------------ values

// A date, a time or a timedelta, as the jobs pass them.
#[derive(Clone)]
struct When {
    kind: i64, // 0 datetime, 1 date, 2 time, 3 timedelta
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
}

// A Python value as the jobs pass it. Fmt is a format by its index in the
// book's list (0 the default format, 1 the hyperlink format).
#[derive(Clone)]
enum Val {
    Nil,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Time(When),
    Fmt(i64),
    List(Vec[Val]),
    Dict(Vec[(String, Val)]),
}

// An exception: its class and its message.
#[derive(Clone)]
struct PyErr {
    cls: String,
    msg: String,
}

fn raise(cls: Str, msg: ref String) -> PyErr {
    PyErr { cls: cls.to_string(), msg: msg.clone() }
}

fn is_finite(x: f64) -> bool {
    x == x and x - x == 0.0
}

// str() of a value, as "%s" formats it.
#[allow(mutual_recursion_note)]
fn pystr(v: ref Val) -> String {
    match v {
        Val.Nil => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Float(x) => float_repr(x),
        Val.Str(s) => s.clone(),
        Val.Fmt(i) => f"<Format {i}>",
        Val.Time(_) => "<datetime>".to_string(),
        Val.List(items) => {
            let mut out = "[".to_string();
            for i in 0..items.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(pyrepr(items[i]));
            }
            out.push_str("]");
            out
        }
        Val.Dict(_) => "{...}".to_string(),
    }
}

#[allow(mutual_recursion_note)]
fn pyrepr(v: ref Val) -> String {
    match v {
        Val.Str(s) => {
            let q = if s.contains("'") and not s.contains("\"") { "\"" } else { "'" };
            let mut out = q.to_string();
            for c in s.chars() {
                if c == '\\' {
                    out.push_str("\\\\");
                } else if c == '\n' {
                    out.push_str("\\n");
                } else if q == "'" and c == '\'' {
                    out.push_str("\\'");
                } else {
                    out.push(c);
                }
            }
            out.push_str(q);
            out
        }
        _ => pystr(v),
    }
}

// repr() of a float: Kāra prints the shortest round-trip digits as Python
// does, but spells the special values differently.
fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if not is_finite(x) {
        return if x > 0.0 { "inf".to_string() } else { "-inf".to_string() };
    }
    f"{x}"
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.Nil => false,
        Val.Bool(b) => b,
        Val.Int(n) => n != 0,
        Val.Float(x) => x != 0.0,
        Val.Str(s) => s.len() > 0,
        Val.Time(_) => true,
        Val.Fmt(_) => true,
        Val.List(items) => items.len() > 0,
        Val.Dict(items) => items.len() > 0,
    }
}

fn is_num(v: ref Val) -> bool {
    match v {
        Val.Bool(_) => true,
        Val.Int(_) => true,
        Val.Float(_) => true,
        _ => false,
    }
}

// The value of a number (a bool counts as 0 or 1, as in Python).
fn num(v: ref Val) -> f64 {
    match v {
        Val.Bool(b) => if b { 1.0 } else { 0.0 },
        Val.Int(n) => n as f64,
        Val.Float(x) => x,
        _ => 0.0,
    }
}

// int() of a number.
fn as_int(v: ref Val) -> i64 {
    match v {
        Val.Bool(b) => if b { 1 } else { 0 },
        Val.Int(n) => n,
        Val.Float(x) => x as i64,
        _ => 0,
    }
}

// value == n, for the integer comparisons the library makes.
fn eq_int(v: ref Val, n: i64) -> bool {
    is_num(v) and num(v) == (n as f64)
}

fn is_nil(v: ref Val) -> bool {
    match v {
        Val.Nil => true,
        _ => false,
    }
}

fn is_str(v: ref Val) -> bool {
    match v {
        Val.Str(_) => true,
        _ => false,
    }
}

fn str_of(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => String.new(),
    }
}

fn fmt_of(v: ref Val) -> Option[i64] {
    match v {
        Val.Fmt(i) => Some(i),
        _ => None,
    }
}

fn sv(text: Str) -> Val {
    Val.Str(text.to_string())
}

fn arg(args: ref Vec[Val], i: i64) -> Val {
    if i < args.len() { args[i].clone() } else { Val.Nil }
}

fn arg_or(args: ref Vec[Val], i: i64, d: own Val) -> Val {
    if i < args.len() { args[i].clone() } else { d }
}

fn dget(d: ref Vec[(String, Val)], key: Str) -> Option[Val] {
    for i in 0..d.len() {
        let (k, v) = d[i].clone();
        if k == key {
            return Some(v);
        }
    }
    None
}

fn dget_or(d: ref Vec[(String, Val)], key: Str, dflt: own Val) -> Val {
    match dget(d, key) {
        Some(v) => v,
        None => dflt,
    }
}

fn dhas(d: ref Vec[(String, Val)], key: Str) -> bool {
    for i in 0..d.len() {
        if d[i].0 == key {
            return true;
        }
    }
    false
}

// d[key] = v, keeping the key's place when it is already there.
fn dset(d: mut ref Vec[(String, Val)], key: Str, v: own Val) {
    for i in 0..d.len() {
        if d[i].0 == key {
            d[i] = (key.to_string(), v);
            return;
        }
    }
    d.push((key.to_string(), v));
}

fn dict_of(v: ref Val) -> Vec[(String, Val)] {
    match v {
        Val.Dict(d) => d.clone(),
        _ => Vec.new(),
    }
}

// ------------------------------------------------------------ job tokens

fn hexval(c: u8) -> i64 {
    if c >= b'0' and c <= b'9' {
        (c - b'0') as i64
    } else if c >= b'a' and c <= b'f' {
        (c - b'a') as i64 + 10
    } else {
        (c - b'A') as i64 + 10
    }
}

// The text of a %XX-escaped token (the escapes are UTF-8 bytes).
fn unpct(t: Str) -> String {
    let b = t.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        if b[i] == b'%' {
            out.push((hexval(b[i + 1]) * 16 + hexval(b[i + 2])) as u8);
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    String.from_utf8(out).unwrap_or("?".to_string())
}

fn parse_int(t: Str) -> i64 {
    let b = t.bytes();
    let mut i: i64 = 0;
    let mut neg = false;
    if b.len() > 0 and b[0] == b'-' {
        neg = true;
        i = 1;
    }
    let mut v: i64 = 0;
    while i < b.len() {
        v = v * 10 + ((b[i] - b'0') as i64);
        i += 1;
    }
    if neg { -v } else { v }
}

fn parse_float_token(t: Str) -> f64 {
    if t == "nan" {
        return 0.0 / 0.0;
    }
    if t == "inf" {
        return 1.0 / 0.0;
    }
    if t == "-inf" {
        return -1.0 / 0.0;
    }
    f64.parse(t).unwrap_or(0.0)
}

struct Toks {
    t: Vec[String],
    i: i64,
}

impl Toks {
    fn next(mut ref self) -> String {
        let x = self.t[self.i].clone();
        self.i += 1;
        x
    }

    fn done(self) -> bool {
        self.i >= self.t.len()
    }
}

// "2026-10-01T09:30:00.000000" and its parts, by position.
fn when_of(kind: i64, t: ref String) -> When {
    let b = t.bytes();
    let num_at = |a: i64, n: i64| {
        let mut v: i64 = 0;
        for k in 0..n {
            v = v * 10 + ((b[a + k] - b'0') as i64);
        }
        v
    };
    if kind == 0 {
        When { kind: 0, y: num_at(0, 4), mo: num_at(5, 2), d: num_at(8, 2), h: num_at(11, 2),
               mi: num_at(14, 2), s: num_at(17, 2), us: num_at(20, 6) }
    } else if kind == 1 {
        When { kind: 1, y: num_at(0, 4), mo: num_at(5, 2), d: num_at(8, 2), h: 0, mi: 0, s: 0, us: 0 }
    } else {
        When { kind: 2, y: 0, mo: 0, d: 0, h: num_at(0, 2), mi: num_at(3, 2), s: num_at(6, 2),
               us: num_at(9, 6) }
    }
}

#[allow(mutual_recursion_note)]
fn parse_val(p: mut ref Toks, base: i64) -> Val {
    let t = p.next();
    let c = t.bytes()[0];
    let rest = t.substring(1);
    if c == b'N' {
        Val.Nil
    } else if c == b'T' {
        Val.Bool(true)
    } else if c == b'F' {
        Val.Bool(false)
    } else if c == b'i' {
        Val.Int(parse_int(rest))
    } else if c == b'f' {
        Val.Float(parse_float_token(rest))
    } else if c == b's' {
        Val.Str(unpct(rest))
    } else if c == b'R' {
        let (n, ch) = rest.split_once(":").unwrap();
        let unit = unpct(ch);
        let mut out = String.new();
        for _ in 0..parse_int(n) {
            out.push_str(unit);
        }
        Val.Str(out)
    } else if c == b'C' {
        let mut out = String.new();
        for _ in 0..parse_int(rest) {
            let part = parse_val(mut p, base);
            out.push_str(str_of(part));
        }
        Val.Str(out)
    } else if c == b'@' {
        if rest == "u" { Val.Fmt(1) } else { Val.Fmt(base + parse_int(rest)) }
    } else if c == b'd' {
        Val.Time(when_of(0, rest))
    } else if c == b'D' {
        Val.Time(when_of(1, rest))
    } else if c == b't' {
        Val.Time(when_of(2, rest))
    } else if c == b'x' {
        let parts: Vec[String] = rest.split(",").map(|x| x.to_string()).collect();
        Val.Time(When { kind: 3, y: 0, mo: 0, d: parse_int(parts[0]), h: 0, mi: 0,
                        s: parse_int(parts[1]), us: parse_int(parts[2]) })
    } else if c == b'L' {
        let mut out: Vec[Val] = Vec.new();
        for _ in 0..parse_int(rest) {
            out.push(parse_val(mut p, base));
        }
        Val.List(out)
    } else {
        let mut out: Vec[(String, Val)] = Vec.new();
        for _ in 0..parse_int(rest) {
            let k = parse_val(mut p, base);
            let v = parse_val(mut p, base);
            out.push((str_of(k), v));
        }
        Val.Dict(out)
    }
}

// ------------------------------------------------------------ numbers as text

fn to_bytes(t: Str) -> Vec[u8] {
    t.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

// The exact decimal expansion of a positive finite double: its digits,
// without leading or trailing zeros, and the position of the point (the
// value is 0.DIGITS times ten to the power `decpt`). Eighty places hold
// every binary digit of a value from 2^-28 up.
fn exact_digits(ax: f64) -> (Vec[u8], i64) {
    let text = if ax >= 0.00000001 { f"{ax:.80}" } else { f"{ax:.1080}" };
    let b = to_bytes(text);
    let mut all: Vec[u8] = Vec.new();
    let mut point: i64 = -1;
    for i in 0..b.len() {
        if b[i] == b'.' {
            point = all.len();
        } else {
            all.push(b[i]);
        }
    }
    if point < 0 {
        point = all.len();
    }
    let mut st: i64 = 0;
    while st < all.len() and all[st] == b'0' {
        st += 1;
    }
    let mut e = all.len();
    while e > st and all[e - 1] == b'0' {
        e -= 1;
    }
    let mut d: Vec[u8] = Vec.new();
    for i in st..e {
        d.push(all[i]);
    }
    (d, point - st)
}

// The digits rounded to the first `keep` of them, half to even on the exact
// value (as printf rounds). The result has exactly `keep` digits, or
// `keep + 1` when rounding carried into a new leading digit, with the point
// moved by one.
fn round_digits(d: ref Vec[u8], decpt: i64, keep: i64) -> (Vec[u8], i64) {
    let mut out: Vec[u8] = Vec.new();
    for i in 0..keep {
        out.push(if i < d.len() { d[i] } else { b'0' });
    }
    if keep >= d.len() {
        return (out, decpt);
    }
    let next = d[keep];
    let mut up = false;
    if next > b'5' {
        up = true;
    } else if next == b'5' {
        let mut rest = false;
        for i in (keep + 1)..d.len() {
            if d[i] != b'0' {
                rest = true;
            }
        }
        if rest {
            up = true;
        } else {
            let prev = if keep > 0 { (out[keep - 1] - b'0') as i64 } else { 0 };
            up = prev % 2 == 1;
        }
    }
    if not up {
        return (out, decpt);
    }
    let mut i = keep - 1;
    while i >= 0 {
        if out[i] == b'9' {
            out[i] = b'0';
            i -= 1;
        } else {
            out[i] = out[i] + 1;
            return (out, decpt);
        }
    }
    let mut carried: Vec[u8] = Vec.new();
    carried.push(b'1');
    for j in 0..out.len() {
        carried.push(out[j]);
    }
    (carried, decpt + 1)
}

// "%.<prec>g" (or "%.<prec>G") of a finite value.
fn fmt_g(x: f64, prec: i64, upper: bool) -> String {
    let neg = x < 0.0 or (x == 0.0 and 1.0 / x < 0.0);
    let ax = if x < 0.0 { 0.0 - x } else { x };
    let mut out = if neg { "-".to_string() } else { String.new() };
    if ax == 0.0 {
        out.push_str("0");
        return out;
    }
    let (d, decpt) = exact_digits(ax);
    let (rd, dp) = round_digits(d, decpt, prec);
    let ex = dp - 1;
    // The digits that are kept, without trailing zeros.
    let mut n = rd.len();
    while n > 1 and rd[n - 1] == b'0' {
        n -= 1;
    }
    let mut b: Vec[u8] = Vec.new();
    if ex < -4 or ex >= prec {
        b.push(rd[0]);
        if n > 1 {
            b.push(b'.');
            for i in 1..n {
                b.push(rd[i]);
            }
        }
        b.push(if upper { b'E' } else { b'e' });
        b.push(if ex < 0 { b'-' } else { b'+' });
        let a = if ex < 0 { 0 - ex } else { ex };
        if a < 10 {
            b.push(b'0');
        }
        for c in f"{a}".bytes() {
            b.push(*c);
        }
    } else if ex < 0 {
        b.push(b'0');
        b.push(b'.');
        for _ in 0..(0 - ex - 1) {
            b.push(b'0');
        }
        for i in 0..n {
            b.push(rd[i]);
        }
    } else {
        for i in 0..(ex + 1) {
            b.push(if i < n { rd[i] } else { b'0' });
        }
        if n > ex + 1 {
            b.push(b'.');
            for i in (ex + 1)..n {
                b.push(rd[i]);
            }
        }
    }
    out.push_str(from_bytes(b));
    out
}

// "%.16G" % number, as the cell writer formats a number.
fn num_text(v: ref Val) -> String {
    match v {
        Val.Int(n) => fmt_g(n as f64, 16, true),
        _ => fmt_g(num(v), 16, true),
    }
}

// float(text): Python's float() grammar, for strings_to_numbers and the
// data validation checks. None when float() raises ValueError.
fn py_float(text: ref String) -> Option[f64] {
    let t = text.trim().to_string();
    let b = to_bytes(t);
    if b.len() == 0 {
        return None;
    }
    let mut i: i64 = 0;
    let mut neg = false;
    if b[0] == b'+' or b[0] == b'-' {
        neg = b[0] == b'-';
        i = 1;
    }
    let word = t.substring(i).to_lowercase();
    if word == "inf" or word == "infinity" {
        return Some(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if word == "nan" {
        return Some(0.0 / 0.0);
    }
    // Digits with single underscores between them, a fraction, an exponent.
    let mut clean: Vec[u8] = Vec.new();
    if neg {
        clean.push(b'-');
    }
    let mut digits: i64 = 0;
    let mut part = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if c >= b'0' and c <= b'9' {
            clean.push(c);
            prev_digit = true;
            if part < 2 {
                digits += 1;
            }
        } else if c == b'_' {
            if not prev_digit or i + 1 >= b.len() or b[i + 1] < b'0' or b[i + 1] > b'9' {
                return None;
            }
            prev_digit = false;
        } else if c == b'.' and part == 0 {
            clean.push(c);
            part = 1;
            prev_digit = false;
        } else if (c == b'e' or c == b'E') and part < 2 {
            if digits == 0 {
                return None;
            }
            clean.push(b'e');
            part = 2;
            prev_digit = false;
            if i + 1 < b.len() and (b[i + 1] == b'+' or b[i + 1] == b'-') {
                clean.push(b[i + 1]);
                i += 1;
            }
            if i + 1 >= b.len() {
                return None;
            }
        } else {
            return None;
        }
        i += 1;
    }
    if digits == 0 {
        return None;
    }
    if part == 2 and not prev_digit {
        return None;
    }
    f64.parse(from_bytes(clean)).ok()
}

// ------------------------------------------------------------ xml

fn needs_escape(t: ref String) -> bool {
    for c in t.bytes() {
        if *c == b'"' or *c == b'&' or *c == b'<' or *c == b'>' or *c == b'\n' {
            return true;
        }
    }
    false
}

fn esc_attr(t: ref String) -> String {
    if not needs_escape(t) {
        return t.clone();
    }
    t.replace("&", "&amp;").replace("\"", "&quot;").replace("<", "&lt;").replace(">", "&gt;")
        .replace("\n", "&#xA;")
}

fn esc_data(t: ref String) -> String {
    if not needs_escape(t) {
        return t.clone();
    }
    t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

fn is_hex(c: char) -> bool {
    (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn hex4(n: i64) -> String {
    let digits = "0123456789ABCDEF".to_string();
    let db = digits.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut k: i64 = 3;
    while k >= 0 {
        out.push(db[(n >> (k * 4)) & 15]);
        k -= 1;
    }
    from_bytes(out)
}

// _escape_control_characters(): a literal "_xHHHH_" gets "_x005F" in front
// of it, the C0 controls other than tab and newline become "_xHHHH_", and
// so do U+FFFE and U+FFFF.
fn esc_ctl(t: ref String) -> String {
    let cs: Vec[char] = t.chars().collect();
    let mut plain = true;
    for c in cs.iter() {
        let n = *c as u32 as i64;
        if *c == '_' or n < 32 or n == 0xFFFE or n == 0xFFFF {
            plain = false;
        }
    }
    if plain {
        return t.clone();
    }
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < cs.len() {
        if cs[i] == '_' and i + 6 < cs.len() and cs[i + 1] == 'x' and is_hex(cs[i + 2])
            and is_hex(cs[i + 3]) and is_hex(cs[i + 4]) and is_hex(cs[i + 5]) and cs[i + 6] == '_' {
            out.push_str("_x005F");
            for k in 0..7 {
                out.push(cs[i + k]);
            }
            i += 7;
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    let cs2: Vec[char] = out.chars().collect();
    let mut res = String.new();
    for c in cs2.iter() {
        let n = *c as u32 as i64;
        if (n <= 8) or (n >= 11 and n <= 31) or n == 0xFFFE or n == 0xFFFF {
            res.push_str("_x");
            res.push_str(hex4(n));
            res.push_str("_");
        } else {
            res.push(*c);
        }
    }
    res
}

// An attribute list, each value already str()-ed.
struct Attrs {
    v: Vec[(String, String)],
}

fn attrs() -> Attrs {
    Attrs { v: Vec.new() }
}

impl Attrs {
    fn add(mut ref self, k: Str, val: ref String) {
        self.v.push((k.to_string(), val.clone()));
    }

    fn addi(mut ref self, k: Str, n: i64) {
        self.v.push((k.to_string(), f"{n}"));
    }

    fn addv(mut ref self, k: Str, val: ref Val) {
        self.v.push((k.to_string(), pystr(val)));
    }
}

fn attr_text(a: ref Attrs, encode: bool) -> String {
    let mut out = String.new();
    for i in 0..a.v.len() {
        let (k, v) = a.v[i].clone();
        out.push_str(" ");
        out.push_str(k);
        out.push_str("=\"");
        out.push_str(if encode { esc_attr(v) } else { v });
        out.push_str("\"");
    }
    out
}

fn decl(out: mut ref String) {
    out.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n");
}

fn start(out: mut ref String, tag: Str, a: ref Attrs) {
    out.push_str("<");
    out.push_str(tag);
    out.push_str(attr_text(a, true));
    out.push_str(">");
}

fn start0(out: mut ref String, tag: Str) {
    out.push_str("<");
    out.push_str(tag);
    out.push_str(">");
}

fn end(out: mut ref String, tag: Str) {
    out.push_str("</");
    out.push_str(tag);
    out.push_str(">");
}

fn empty(out: mut ref String, tag: Str, a: ref Attrs) {
    out.push_str("<");
    out.push_str(tag);
    out.push_str(attr_text(a, true));
    out.push_str("/>");
}

fn empty0(out: mut ref String, tag: Str) {
    out.push_str("<");
    out.push_str(tag);
    out.push_str("/>");
}

fn empty1(out: mut ref String, tag: Str, k: Str, v: ref String) {
    let mut a = attrs();
    a.add(k, v);
    empty(mut out, tag, a);
}

fn data_el(out: mut ref String, tag: Str, text: ref String, a: ref Attrs) {
    out.push_str("<");
    out.push_str(tag);
    out.push_str(attr_text(a, true));
    out.push_str(">");
    out.push_str(esc_ctl(esc_data(text)));
    out.push_str("</");
    out.push_str(tag);
    out.push_str(">");
}

fn data0(out: mut ref String, tag: Str, text: ref String) {
    data_el(mut out, tag, text, attrs());
}

// ------------------------------------------------------------ cell names

fn col_name(col: i64) -> String {
    let mut n = col + 1;
    let mut letters: Vec[u8] = Vec.new();
    while n > 0 {
        let mut r = n % 26;
        if r == 0 {
            r = 26;
        }
        letters.insert(0, (64 + r) as u8);
        n = (n - 1) / 26;
    }
    from_bytes(letters)
}

fn cell_ref(row: i64, col: i64) -> String {
    let c = col_name(col);
    let r = row + 1;
    f"{c}{r}"
}

fn abs_cell(row: i64, col: i64) -> String {
    let c = col_name(col);
    let r = row + 1;
    f"${c}${r}"
}

fn range_ref(r1: i64, c1: i64, r2: i64, c2: i64) -> String {
    let a = cell_ref(r1, c1);
    let b = cell_ref(r2, c2);
    if a == b { a } else { f"{a}:{b}" }
}

// xl_cell_to_rowcol(): "$B$3" to (2, 1). The pattern is matched at the
// start: up to three capitals, then digits.
fn cell_to_rowcol(t: ref String) -> Result[(i64, i64), PyErr] {
    if t.len() == 0 {
        return Ok((0, 0));
    }
    let b = to_bytes(t);
    let mut i: i64 = 0;
    if b[i] == b'$' {
        i += 1;
    }
    let mut col: i64 = 0;
    let mut letters: i64 = 0;
    while i < b.len() and letters < 3 and b[i] >= b'A' and b[i] <= b'Z' {
        col = col * 26 + ((b[i] - b'A') as i64 + 1);
        letters += 1;
        i += 1;
    }
    if i < b.len() and b[i] == b'$' {
        i += 1;
    }
    let mut row: i64 = 0;
    let mut digits: i64 = 0;
    while i < b.len() and b[i] >= b'0' and b[i] <= b'9' {
        row = row * 10 + ((b[i] - b'0') as i64);
        digits += 1;
        i += 1;
    }
    if letters == 0 or digits == 0 {
        return Err(raise("AttributeError", "'NoneType' object has no attribute 'group'"));
    }
    Ok((row - 1, col - 1))
}

fn is_alnum_str(t: ref String) -> bool {
    if t.len() == 0 {
        return false;
    }
    for c in t.chars() {
        if not c.is_alphanumeric() {
            return false;
        }
    }
    true
}

// quote_sheetname(): a name that is not all letters and digits is quoted,
// with its apostrophes doubled.
fn quote_sheet(name: ref String) -> String {
    if not is_alnum_str(name) and not name.starts_with("'") {
        let inner = name.replace("'", "''");
        return f"'{inner}'";
    }
    name.clone()
}

fn xl_color(color: ref String) -> (String, bool) {
    let named = named_color(color);
    let c = if named.len() > 0 and named != "Automatic" { named } else { color.clone() };
    let b = to_bytes(c);
    let mut ok = b.len() >= 7 and b[0] == b'#';
    if ok {
        for i in 1..7 {
            let ch = b[i] as char;
            if not is_hex(ch) {
                ok = false;
            }
        }
    }
    let mut body = c.clone();
    while body.starts_with("#") {
        body = body.substring(1);
    }
    let up = body.to_uppercase();
    (f"FF{up}", ok)
}

fn named_color(c: ref String) -> String {
    let names = ["black", "blue", "brown", "cyan", "gray", "green", "lime", "magenta", "navy",
                 "orange", "pink", "purple", "red", "silver", "white", "yellow", "automatic"];
    let rgbs = ["#000000", "#0000FF", "#800000", "#00FFFF", "#808080", "#008000", "#00FF00",
                "#FF00FF", "#000080", "#FF6600", "#FF00FF", "#800080", "#FF0000", "#C0C0C0",
                "#FFFFFF", "#FFFF00", "Automatic"];
    for i in 0..17 {
        if names[i] == c {
            return rgbs[i].to_string();
        }
    }
    String.new()
}

// Format._get_color(): a named colour becomes its #RRGGBB.
fn get_color(v: ref Val) -> Val {
    match v {
        Val.Str(c) => {
            let n = named_color(c);
            if n.len() > 0 { Val.Str(n) } else { v.clone() }
        }
        _ => v.clone(),
    }
}

// Python's \w, on one character.
fn is_word(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

// ------------------------------------------------------------ formats

// A Format. The properties a user sets keep the Python value they were set
// to, because the format's key is made of their str() and the XML writes
// them with "%s".
#[derive(Clone)]
struct Format {
    num_format: Val,
    num_format_index: i64,
    font_index: i64,
    has_font: bool,
    has_dxf_font: bool,
    bold: Val,
    underline: Val,
    italic: Val,
    font_name: Val,
    font_size: Val,
    font_color: Val,
    font_strikeout: Val,
    font_outline: Val,
    font_shadow: Val,
    font_script: Val,
    font_family: Val,
    font_charset: Val,
    font_scheme: Val,
    font_condense: Val,
    font_extend: Val,
    theme: Val,
    hyperlink: bool,
    xf_id: i64,
    hidden: Val,
    locked: Val,
    text_h_align: Val,
    text_wrap: Val,
    text_v_align: Val,
    rotation: Val,
    fg_color: Val,
    bg_color: Val,
    pattern: Val,
    has_fill: bool,
    has_dxf_fill: bool,
    fill_index: i64,
    border_index: i64,
    has_border: bool,
    has_dxf_border: bool,
    bottom: Val,
    bottom_color: Val,
    diag_border: Val,
    diag_color: Val,
    diag_type: Val,
    left: Val,
    left_color: Val,
    right: Val,
    right_color: Val,
    top: Val,
    top_color: Val,
    indent: Val,
    shrink: Val,
    reading_order: Val,
    just_distrib: Val,
    color_indexed: Val,
    font_only: Val,
    quote_prefix: Val,
    xf_index: Option[i64],
    dxf_index: Option[i64],
    dxf_fg_color: Val,
    dxf_bg_color: Val,
    key: Option[String],
}

fn new_format() -> Format {
    Format {
        num_format: sv("General"), num_format_index: 0, font_index: 0, has_font: false,
        has_dxf_font: false, bold: Val.Int(0), underline: Val.Int(0), italic: Val.Int(0),
        font_name: sv("Calibri"), font_size: Val.Int(11), font_color: Val.Int(0),
        font_strikeout: Val.Int(0), font_outline: Val.Int(0), font_shadow: Val.Int(0),
        font_script: Val.Int(0), font_family: Val.Int(2), font_charset: Val.Int(0),
        font_scheme: sv("minor"), font_condense: Val.Int(0), font_extend: Val.Int(0),
        theme: Val.Int(0), hyperlink: false, xf_id: 0, hidden: Val.Int(0), locked: Val.Int(1),
        text_h_align: Val.Int(0), text_wrap: Val.Int(0), text_v_align: Val.Int(0),
        rotation: Val.Int(0), fg_color: Val.Int(0), bg_color: Val.Int(0), pattern: Val.Int(0),
        has_fill: false, has_dxf_fill: false, fill_index: 0, border_index: 0, has_border: false,
        has_dxf_border: false, bottom: Val.Int(0), bottom_color: Val.Int(0),
        diag_border: Val.Int(0), diag_color: Val.Int(0), diag_type: Val.Int(0), left: Val.Int(0),
        left_color: Val.Int(0), right: Val.Int(0), right_color: Val.Int(0), top: Val.Int(0),
        top_color: Val.Int(0), indent: Val.Int(0), shrink: Val.Int(0), reading_order: Val.Int(0),
        just_distrib: Val.Int(0), color_indexed: Val.Int(0), font_only: Val.Int(0),
        quote_prefix: Val.Bool(false), xf_index: None, dxf_index: None,
        dxf_fg_color: Val.Int(0), dxf_bg_color: Val.Int(0), key: None,
    }
}

fn is_zero(v: ref Val) -> bool {
    is_num(v) and num(v) == 0.0
}

fn set_align(f: mut ref Format, v: ref Val) {
    let a = pystr(v).to_lowercase();
    if a == "left" {
        f.text_h_align = Val.Int(1);
    }
    if a == "centre" or a == "center" {
        f.text_h_align = Val.Int(2);
    }
    if a == "right" {
        f.text_h_align = Val.Int(3);
    }
    if a == "fill" {
        f.text_h_align = Val.Int(4);
    }
    if a == "justify" {
        f.text_h_align = Val.Int(5);
    }
    if a == "center_across" or a == "centre_across" {
        f.text_h_align = Val.Int(6);
    }
    if a == "distributed" or a == "justify_distributed" {
        f.text_h_align = Val.Int(7);
    }
    if a == "justify_distributed" {
        f.just_distrib = Val.Int(1);
    }
    if a == "top" {
        f.text_v_align = Val.Int(1);
    }
    if a == "vcentre" or a == "vcenter" {
        f.text_v_align = Val.Int(2);
    }
    if a == "bottom" {
        f.text_v_align = Val.Int(3);
    }
    if a == "vjustify" {
        f.text_v_align = Val.Int(4);
    }
    if a == "vdistributed" {
        f.text_v_align = Val.Int(5);
    }
}

// getattr(self, "set_" + key)(value), for each property of add_format().
// A warning goes to `warns`.
fn set_prop(f: mut ref Format, key: ref String, v: ref Val, warns: mut ref Vec[String]) -> Result[(), PyErr] {
    if key == "font_name" or key == "font" {
        f.font_name = v.clone();
    } else if key == "font_size" or key == "size" {
        f.font_size = v.clone();
    } else if key == "font_color" or key == "color" {
        f.font_color = get_color(v);
    } else if key == "bold" {
        f.bold = v.clone();
    } else if key == "italic" {
        f.italic = v.clone();
    } else if key == "underline" {
        f.underline = v.clone();
    } else if key == "font_strikeout" {
        f.font_strikeout = v.clone();
    } else if key == "font_script" {
        f.font_script = v.clone();
    } else if key == "font_outline" {
        f.font_outline = v.clone();
    } else if key == "font_shadow" {
        f.font_shadow = v.clone();
    } else if key == "num_format" {
        f.num_format = v.clone();
    } else if key == "locked" {
        f.locked = v.clone();
    } else if key == "hidden" {
        f.hidden = v.clone();
    } else if key == "align" or key == "valign" {
        set_align(mut f, v);
    } else if key == "center_across" {
        f.text_h_align = Val.Int(6);
    } else if key == "text_wrap" {
        f.text_wrap = v.clone();
    } else if key == "rotation" {
        let mut r = as_int(v);
        if r == 270 {
            r = 255;
        } else if r >= -90 and r <= 90 {
            if r < 0 {
                r = -r + 90;
            }
        } else {
            warns.push("Rotation rotation outside range: -90 <= angle <= 90".to_string());
            return Ok(());
        }
        f.rotation = Val.Int(r);
    } else if key == "indent" {
        f.indent = v.clone();
    } else if key == "shrink" {
        f.shrink = v.clone();
    } else if key == "text_justlast" {
        // Stored, never written.
    } else if key == "pattern" {
        f.pattern = v.clone();
    } else if key == "bg_color" {
        f.bg_color = get_color(v);
    } else if key == "fg_color" {
        f.fg_color = get_color(v);
    } else if key == "border" {
        f.bottom = v.clone();
        f.top = v.clone();
        f.left = v.clone();
        f.right = v.clone();
    } else if key == "border_color" {
        f.bottom_color = get_color(v);
        f.top_color = get_color(v);
        f.left_color = get_color(v);
        f.right_color = get_color(v);
    } else if key == "bottom" {
        f.bottom = v.clone();
    } else if key == "bottom_color" {
        f.bottom_color = get_color(v);
    } else if key == "top" {
        f.top = v.clone();
    } else if key == "top_color" {
        f.top_color = get_color(v);
    } else if key == "left" {
        f.left = v.clone();
    } else if key == "left_color" {
        f.left_color = get_color(v);
    } else if key == "right" {
        f.right = v.clone();
    } else if key == "right_color" {
        f.right_color = get_color(v);
    } else if key == "diag_type" {
        f.diag_type = v.clone();
    } else if key == "diag_color" {
        f.diag_color = get_color(v);
    } else if key == "diag_border" {
        f.diag_border = v.clone();
    } else if key == "quote_prefix" {
        f.quote_prefix = v.clone();
    } else if key == "reading_order" {
        f.reading_order = v.clone();
    } else if key == "font_family" {
        f.font_family = v.clone();
    } else if key == "font_charset" {
        f.font_charset = v.clone();
    } else if key == "font_scheme" {
        f.font_scheme = v.clone();
    } else if key == "font_condense" {
        f.font_condense = v.clone();
    } else if key == "font_extend" {
        f.font_extend = v.clone();
    } else if key == "theme" {
        f.theme = v.clone();
    } else if key == "hyperlink" {
        f.xf_id = 1;
        f.underline = Val.Int(1);
        f.theme = Val.Int(10);
        f.hyperlink = truthy(v);
    } else if key == "color_indexed" {
        f.color_indexed = v.clone();
    } else if key == "font_only" {
        f.font_only = v.clone();
    } else if key == "xf_index" {
        f.xf_index = Some(as_int(v));
    } else {
        return Err(raise("AttributeError", f"'Format' object has no attribute 'set_{key}'"));
    }
    Ok(())
}

fn join_keys(parts: ref Vec[String]) -> String {
    parts.join(":")
}

fn font_key(f: ref Format) -> String {
    let parts = [pystr(f.bold), pystr(f.font_color), pystr(f.font_charset),
                        pystr(f.font_family), pystr(f.font_outline), pystr(f.font_script),
                        pystr(f.font_shadow), pystr(f.font_strikeout), pystr(f.font_name),
                        pystr(f.italic), pystr(f.font_size), pystr(f.underline), pystr(f.theme)];
    join_keys(parts)
}

fn border_key(f: ref Format) -> String {
    let parts = [pystr(f.bottom), pystr(f.bottom_color), pystr(f.diag_border),
                        pystr(f.diag_color), pystr(f.diag_type), pystr(f.left),
                        pystr(f.left_color), pystr(f.right), pystr(f.right_color),
                        pystr(f.top), pystr(f.top_color)];
    join_keys(parts)
}

fn fill_key(f: ref Format) -> String {
    let a = pystr(f.pattern);
    let b = pystr(f.bg_color);
    let c = pystr(f.fg_color);
    f"{a}:{b}:{c}"
}

fn align_key(f: ref Format) -> String {
    let parts = [pystr(f.text_h_align), pystr(f.text_v_align), pystr(f.indent),
                        pystr(f.rotation), pystr(f.text_wrap), pystr(f.shrink),
                        pystr(f.reading_order)];
    join_keys(parts)
}

fn format_key(f: ref Format) -> String {
    let parts = [font_key(f), border_key(f), fill_key(f), align_key(f), pystr(f.num_format),
                        pystr(f.locked), pystr(f.quote_prefix), pystr(f.hidden)];
    join_keys(parts)
}

// The book's formats and the key tables _get_xf_index() and
// _get_dxf_index() share.
struct Formats {
    list: Vec[Format],
    xf_keys: Map[String, i64],
    dxf_keys: Map[String, i64],
    warns: Vec[String],
}

impl Formats {
    fn cached_key(mut ref self, i: i64) -> String {
        match self.list[i].key.clone() {
            Some(k) => k,
            None => {
                let k = format_key(self.list[i]);
                self.list[i].key = Some(k.clone());
                k
            }
        }
    }

    // _get_xf_index(): the first format with a key gets the next index; a
    // later one with the same key shares it but keeps no index of its own.
    fn xf_index(mut ref self, i: i64) -> i64 {
        match self.list[i].xf_index {
            Some(x) => x,
            None => {
                let k = self.cached_key(i);
                match self.xf_keys.get(k) {
                    Some(x) => *x,
                    None => {
                        let idx = 1 + self.xf_keys.len();
                        self.xf_keys.insert(k, idx);
                        self.list[i].xf_index = Some(idx);
                        idx
                    }
                }
            }
        }
    }

    fn dxf_index(mut ref self, i: i64) -> i64 {
        match self.list[i].dxf_index {
            Some(x) => x,
            None => {
                let k = self.cached_key(i);
                match self.dxf_keys.get(k) {
                    Some(x) => *x,
                    None => {
                        let idx = self.dxf_keys.len();
                        self.dxf_keys.insert(k, idx);
                        self.list[i].dxf_index = Some(idx);
                        idx
                    }
                }
            }
        }
    }

    fn add(mut ref self, defaults: ref Vec[(String, Val)], props: ref Vec[(String, Val)]) -> Result[i64, PyErr] {
        // format_properties = defaults.copy(); .update(properties): a key
        // in both keeps its first place.
        let mut merged = defaults.clone();
        for i in 0..props.len() {
            let (k, v) = props[i].clone();
            dset(mut merged, k, v);
        }
        let mut f = new_format();
        for i in 0..merged.len() {
            let (k, v) = merged[i].clone();
            set_prop(mut f, k, v, mut self.warns)?;
        }
        self.list.push(f);
        Ok(self.list.len() - 1)
    }
}

// _get_align_properties(): whether alignment changed, and its attributes.
fn align_props(f: ref Format) -> (bool, Attrs) {
    let mut a = attrs();
    let mut h = as_int(f.text_h_align);
    let v = as_int(f.text_v_align);
    let indent = f.indent.clone();
    let mut shrink = truthy(f.shrink);
    let mut just = truthy(f.just_distrib);
    if not (h != 0 or v != 0 or truthy(indent) or truthy(f.rotation) or truthy(f.text_wrap)
            or shrink or truthy(f.reading_order)) {
        return (false, a);
    }
    if truthy(indent) and h != 1 and h != 3 and h != 7 and v != 1 and v != 3 and v != 5 {
        h = 1;
    }
    if truthy(f.text_wrap) {
        shrink = false;
    }
    if h == 4 or h == 5 or h == 7 {
        shrink = false;
    }
    if h != 7 {
        just = false;
    }
    if truthy(indent) {
        just = false;
    }
    let names = ["", "left", "center", "right", "fill", "justify", "centerContinuous", "distributed"];
    if h >= 1 and h <= 7 {
        a.add("horizontal", names[h].to_string());
    }
    if just {
        a.addi("justifyLastLine", 1);
    }
    if v == 1 {
        a.add("vertical", "top".to_string());
    }
    if v == 2 {
        a.add("vertical", "center".to_string());
    }
    if v == 4 {
        a.add("vertical", "justify".to_string());
    }
    if v == 5 {
        a.add("vertical", "distributed".to_string());
    }
    if truthy(f.rotation) {
        a.addv("textRotation", f.rotation);
    }
    if truthy(indent) {
        a.addv("indent", indent);
    }
    if truthy(f.text_wrap) {
        a.addi("wrapText", 1);
    }
    if shrink {
        a.addi("shrinkToFit", 1);
    }
    if eq_int(f.reading_order, 1) {
        a.addi("readingOrder", 1);
    }
    if eq_int(f.reading_order, 2) {
        a.addi("readingOrder", 2);
    }
    (true, a)
}

fn protection_props(f: ref Format) -> Attrs {
    let mut a = attrs();
    if not truthy(f.locked) {
        a.addi("locked", 0);
    }
    if truthy(f.hidden) {
        a.addi("hidden", 1);
    }
    a
}

// What the workbook's _prepare_format_properties() leaves for styles.xml.
struct StyleData {
    xf: Vec[i64],
    dxf: Vec[i64],
    font_count: i64,
    num_formats: Vec[String],
    border_count: i64,
    fill_count: i64,
}

fn has_border_key(k: ref String) -> bool {
    for c in k.bytes() {
        if *c != b'0' and *c != b':' {
            return true;
        }
    }
    false
}

fn prepare_formats(fm: mut ref Formats) -> StyleData {
    // _prepare_formats(): the formats by their xf and dxf indices.
    let mut nxf: i64 = 0;
    let mut ndxf: i64 = 0;
    for i in 0..fm.list.len() {
        if fm.list[i].xf_index.is_some() {
            nxf += 1;
        }
        if fm.list[i].dxf_index.is_some() {
            ndxf += 1;
        }
    }
    let mut xf: Vec[i64] = Vec.filled(nxf, -1);
    let mut dxf: Vec[i64] = Vec.filled(ndxf, -1);
    for i in 0..fm.list.len() {
        if let Some(x) = fm.list[i].xf_index {
            xf[x] = i;
        }
        if let Some(x) = fm.list[i].dxf_index {
            dxf[x] = i;
        }
    }
    // _prepare_fonts().
    let mut fonts: Map[String, i64] = Map.new();
    let mut index: i64 = 0;
    for j in 0..xf.len() {
        let i = xf[j];
        let k = font_key(fm.list[i]);
        match fonts.get(k) {
            Some(x) => {
                fm.list[i].font_index = *x;
                fm.list[i].has_font = false;
            }
            None => {
                fonts.insert(k, index);
                fm.list[i].font_index = index;
                fm.list[i].has_font = true;
                index += 1;
            }
        }
    }
    let font_count = index;
    for j in 0..dxf.len() {
        let i = dxf[j];
        let f = fm.list[i].clone();
        if truthy(f.font_color) or truthy(f.bold) or truthy(f.italic) or truthy(f.underline)
            or truthy(f.font_strikeout) {
            fm.list[i].has_dxf_font = true;
        }
    }
    // _prepare_num_formats().
    let mut unique: Map[String, i64] = Map.new();
    let mut num_formats: Vec[String] = Vec.new();
    let mut nindex: i64 = 164;
    let mut order = xf.clone();
    for j in 0..dxf.len() {
        order.push(dxf[j]);
    }
    for j in 0..order.len() {
        let i = order[j];
        let nf = fm.list[i].num_format.clone();
        if not is_str(nf) {
            let mut n = as_int(nf);
            if n == 0 {
                n = 1;
            }
            fm.list[i].num_format_index = n;
            continue;
        }
        let t = str_of(nf);
        if t == "0" {
            fm.list[i].num_format_index = 1;
            continue;
        }
        if t == "General" {
            fm.list[i].num_format_index = 0;
            continue;
        }
        match unique.get(t) {
            Some(x) => {
                fm.list[i].num_format_index = *x;
            }
            None => {
                unique.insert(t.clone(), nindex);
                fm.list[i].num_format_index = nindex;
                nindex += 1;
                let has_xf = match fm.list[i].xf_index {
                    Some(x) => x != 0,
                    None => false,
                };
                if has_xf {
                    num_formats.push(t);
                }
            }
        }
    }
    // _prepare_borders().
    let mut borders: Map[String, i64] = Map.new();
    let mut bindex: i64 = 0;
    for j in 0..xf.len() {
        let i = xf[j];
        let k = border_key(fm.list[i]);
        match borders.get(k) {
            Some(x) => {
                fm.list[i].border_index = *x;
                fm.list[i].has_border = false;
            }
            None => {
                borders.insert(k, bindex);
                fm.list[i].border_index = bindex;
                fm.list[i].has_border = true;
                bindex += 1;
            }
        }
    }
    for j in 0..dxf.len() {
        let i = dxf[j];
        if has_border_key(border_key(fm.list[i])) {
            fm.list[i].has_dxf_border = true;
        }
    }
    // _prepare_fills(): indices 0 and 1 are Excel's own two fills.
    let mut fills: Map[String, i64] = Map.new();
    fills.insert("0:0:0".to_string(), 0);
    fills.insert("17:0:0".to_string(), 1);
    let mut findex: i64 = 2;
    for j in 0..dxf.len() {
        let i = dxf[j];
        let f = fm.list[i].clone();
        if truthy(f.pattern) or truthy(f.bg_color) or truthy(f.fg_color) {
            fm.list[i].has_dxf_fill = true;
            fm.list[i].dxf_bg_color = f.bg_color.clone();
            fm.list[i].dxf_fg_color = f.fg_color.clone();
        }
    }
    for j in 0..xf.len() {
        let i = xf[j];
        let mut f = fm.list[i].clone();
        if eq_int(f.pattern, 1) and not is_zero(f.bg_color) and not is_zero(f.fg_color) {
            let tmp = f.fg_color.clone();
            f.fg_color = f.bg_color.clone();
            f.bg_color = tmp;
        }
        if num(f.pattern) <= 1.0 and not is_zero(f.bg_color) and is_zero(f.fg_color) {
            f.fg_color = f.bg_color.clone();
            f.bg_color = Val.Int(0);
            f.pattern = Val.Int(1);
        }
        if num(f.pattern) <= 1.0 and is_zero(f.bg_color) and not is_zero(f.fg_color) {
            f.pattern = Val.Int(1);
        }
        let k = fill_key(f);
        match fills.get(k) {
            Some(x) => {
                f.fill_index = *x;
                f.has_fill = false;
            }
            None => {
                fills.insert(k, findex);
                f.fill_index = findex;
                f.has_fill = true;
                findex += 1;
            }
        }
        fm.list[i] = f;
    }
    StyleData { xf: xf, dxf: dxf, font_count: font_count, num_formats: num_formats,
                border_count: bindex, fill_count: findex }
}

// ------------------------------------------------------------ styles.xml

fn palette(c: ref Val) -> String {
    let t = pystr(c);
    if t == "Automatic" {
        return t;
    }
    let body = if t.starts_with("#") { t.substring(1) } else { t };
    let up = body.to_uppercase();
    f"FF{up}"
}

fn underline_el(out: mut ref String, u: ref Val) {
    let mut a = attrs();
    if eq_int(u, 2) {
        a.add("val", "double".to_string());
    } else if eq_int(u, 33) {
        a.add("val", "singleAccounting".to_string());
    } else if eq_int(u, 34) {
        a.add("val", "doubleAccounting".to_string());
    }
    empty(mut out, "u", a);
}

fn style_font(out: mut ref String, f: ref Format, dxf: bool, hyper: mut ref (bool, i64)) {
    start0(mut out, "font");
    if truthy(f.font_condense) {
        empty1(mut out, "condense", "val", "0".to_string());
    }
    if truthy(f.font_extend) {
        empty1(mut out, "extend", "val", "0".to_string());
    }
    if truthy(f.bold) {
        empty0(mut out, "b");
    }
    if truthy(f.italic) {
        empty0(mut out, "i");
    }
    if truthy(f.font_strikeout) {
        empty0(mut out, "strike");
    }
    if truthy(f.font_outline) {
        empty0(mut out, "outline");
    }
    if truthy(f.font_shadow) {
        empty0(mut out, "shadow");
    }
    if truthy(f.underline) {
        underline_el(mut out, f.underline);
    }
    if eq_int(f.font_script, 1) {
        empty1(mut out, "vertAlign", "val", "superscript".to_string());
    }
    if eq_int(f.font_script, 2) {
        empty1(mut out, "vertAlign", "val", "subscript".to_string());
    }
    if not dxf {
        empty1(mut out, "sz", "val", pystr(f.font_size));
    }
    if eq_int(f.theme, -1) {
        // No colour at all.
    } else if truthy(f.theme) {
        empty1(mut out, "color", "theme", pystr(f.theme));
    } else if truthy(f.color_indexed) {
        empty1(mut out, "color", "indexed", pystr(f.color_indexed));
    } else if truthy(f.font_color) {
        let c = palette(f.font_color);
        if c != "Automatic" {
            empty1(mut out, "color", "rgb", c);
        }
    } else if not dxf {
        empty1(mut out, "color", "theme", "1".to_string());
    }
    if not dxf {
        empty1(mut out, "name", "val", pystr(f.font_name));
        if truthy(f.font_family) {
            empty1(mut out, "family", "val", pystr(f.font_family));
        }
        if truthy(f.font_charset) {
            empty1(mut out, "charset", "val", pystr(f.font_charset));
        }
        if pystr(f.font_name) == "Calibri" and is_str(f.font_name) and not f.hyperlink {
            empty1(mut out, "scheme", "val", pystr(f.font_scheme));
        }
        if f.hyperlink {
            hyper.0 = true;
            if hyper.1 == 0 {
                hyper.1 = f.font_index;
            }
        }
    }
    end(mut out, "font");
}

fn pattern_name(p: i64) -> String {
    let names = ["none", "solid", "mediumGray", "darkGray", "lightGray", "darkHorizontal",
                 "darkVertical", "darkDown", "darkUp", "darkGrid", "darkTrellis",
                 "lightHorizontal", "lightVertical", "lightDown", "lightUp", "lightGrid",
                 "lightTrellis", "gray125", "gray0625"];
    names[p].to_string()
}

fn default_fill(out: mut ref String, pattern: Str) {
    start0(mut out, "fill");
    empty1(mut out, "patternFill", "patternType", pattern.to_string());
    end(mut out, "fill");
}

fn style_fill(out: mut ref String, f: ref Format, dxf: bool) {
    let pattern = as_int(f.pattern);
    let bg = if dxf { f.dxf_bg_color.clone() } else { f.bg_color.clone() };
    let fg = if dxf { f.dxf_fg_color.clone() } else { f.fg_color.clone() };
    if not truthy(fg) and not truthy(bg) {
        default_fill(mut out, pattern_name(pattern));
        return;
    }
    start0(mut out, "fill");
    if dxf and pattern <= 1 {
        start0(mut out, "patternFill");
    } else {
        let mut a = attrs();
        a.add("patternType", pattern_name(pattern));
        start(mut out, "patternFill", a);
    }
    if truthy(fg) {
        let c = palette(fg);
        if c != "Automatic" {
            empty1(mut out, "fgColor", "rgb", c);
        }
    }
    if truthy(bg) {
        let c = palette(bg);
        if c != "Automatic" {
            empty1(mut out, "bgColor", "rgb", c);
        }
    } else if not dxf and pattern <= 1 {
        empty1(mut out, "bgColor", "indexed", "64".to_string());
    }
    end(mut out, "patternFill");
    end(mut out, "fill");
}

fn sub_border(out: mut ref String, kind: Str, style: ref Val, color: ref Val) {
    if not truthy(style) {
        empty0(mut out, kind);
        return;
    }
    let names = ["none", "thin", "medium", "dashed", "dotted", "thick", "double", "hair",
                 "mediumDashed", "dashDot", "mediumDashDot", "dashDotDot", "mediumDashDotDot",
                 "slantDashDot"];
    let mut a = attrs();
    a.add("style", names[as_int(style)].to_string());
    start(mut out, kind, a);
    if truthy(color) and pystr(color) != "Automatic" {
        empty1(mut out, "color", "rgb", palette(color));
    } else {
        empty1(mut out, "color", "auto", "1".to_string());
    }
    end(mut out, kind);
}

fn style_border(out: mut ref String, f: ref Format, dxf: bool) {
    let mut a = attrs();
    let dt = as_int(f.diag_type);
    if dt == 1 {
        a.addi("diagonalUp", 1);
    } else if dt == 2 {
        a.addi("diagonalDown", 1);
    } else if dt == 3 {
        a.addi("diagonalUp", 1);
        a.addi("diagonalDown", 1);
    }
    let mut diag = f.diag_border.clone();
    if truthy(f.diag_type) and not truthy(diag) {
        diag = Val.Int(1);
    }
    start(mut out, "border", a);
    sub_border(mut out, "left", f.left, f.left_color);
    sub_border(mut out, "right", f.right, f.right_color);
    sub_border(mut out, "top", f.top, f.top_color);
    sub_border(mut out, "bottom", f.bottom, f.bottom_color);
    if not dxf {
        sub_border(mut out, "diagonal", diag, f.diag_color);
    }
    if dxf {
        sub_border(mut out, "vertical", Val.Nil, Val.Nil);
        sub_border(mut out, "horizontal", Val.Nil, Val.Nil);
    }
    end(mut out, "border");
}

fn builtin_num_format(id: i64) -> String {
    let codes = ["General", "0", "0.00", "#,##0", "#,##0.00", "($#,##0_);($#,##0)",
                 "($#,##0_);[Red]($#,##0)", "($#,##0.00_);($#,##0.00)",
                 "($#,##0.00_);[Red]($#,##0.00)", "0%", "0.00%", "0.00E+00", "# ?/?", "# ??/??",
                 "m/d/yy", "d-mmm-yy", "d-mmm", "mmm-yy", "h:mm AM/PM", "h:mm:ss AM/PM", "h:mm",
                 "h:mm:ss", "m/d/yy h:mm"];
    if id >= 0 and id <= 22 {
        return codes[id].to_string();
    }
    let hi = ["(#,##0_);(#,##0)", "(#,##0_);[Red](#,##0)", "(#,##0.00_);(#,##0.00)",
              "(#,##0.00_);[Red](#,##0.00)", "_(* #,##0_);_(* (#,##0);_(* \"-\"_);_(_)",
              "_($* #,##0_);_($* (#,##0);_($* \"-\"_);_(_)",
              "_(* #,##0.00_);_(* (#,##0.00);_(* \"-\"??_);_(_)",
              "_($* #,##0.00_);_($* (#,##0.00);_($* \"-\"??_);_(_)", "mm:ss", "[h]:mm:ss",
              "mm:ss.0", "##0.0E+0", "@"];
    if id >= 37 and id <= 49 {
        return hi[id - 37].to_string();
    }
    "General".to_string()
}

fn num_fmt_el(out: mut ref String, id: i64, code: ref String) {
    let c = if id < 164 { builtin_num_format(id) } else { code.clone() };
    let mut a = attrs();
    a.addi("numFmtId", id);
    a.add("formatCode", c);
    empty(mut out, "numFmt", a);
}

fn style_xf(out: mut ref String, f: ref Format) {
    let mut a = attrs();
    a.addi("numFmtId", f.num_format_index);
    a.addi("fontId", f.font_index);
    a.addi("fillId", f.fill_index);
    a.addi("borderId", f.border_index);
    a.addi("xfId", f.xf_id);
    if truthy(f.quote_prefix) {
        a.addi("quotePrefix", 1);
    }
    if f.num_format_index > 0 {
        a.addi("applyNumberFormat", 1);
    }
    if f.font_index > 0 and not f.hyperlink {
        a.addi("applyFont", 1);
    }
    if f.fill_index > 0 {
        a.addi("applyFill", 1);
    }
    if f.border_index > 0 {
        a.addi("applyBorder", 1);
    }
    let (apply_align, align) = align_props(f);
    let has_align = apply_align and align.v.len() > 0;
    if apply_align or f.hyperlink {
        a.addi("applyAlignment", 1);
    }
    let prot = protection_props(f);
    let mut has_protect = false;
    if prot.v.len() > 0 or f.hyperlink {
        a.addi("applyProtection", 1);
        if not f.hyperlink {
            has_protect = true;
        }
    }
    if has_align or has_protect {
        start(mut out, "xf", a);
        if has_align {
            empty(mut out, "alignment", align);
        }
        if has_protect {
            empty(mut out, "protection", prot);
        }
        end(mut out, "xf");
    } else {
        empty(mut out, "xf", a);
    }
}

fn styles_xml(fm: ref Formats, sd: ref StyleData) -> String {
    let mut out = String.new();
    decl(mut out);
    let mut a = attrs();
    a.add("xmlns", "http://schemas.openxmlformats.org/spreadsheetml/2006/main".to_string());
    start(mut out, "styleSheet", a);
    if sd.num_formats.len() > 0 {
        let mut na = attrs();
        na.addi("count", sd.num_formats.len());
        start(mut out, "numFmts", na);
        for i in 0..sd.num_formats.len() {
            num_fmt_el(mut out, 164 + i, sd.num_formats[i]);
        }
        end(mut out, "numFmts");
    }
    let mut hyper: (bool, i64) = (false, 0);
    let mut fa = attrs();
    fa.addi("count", sd.font_count);
    start(mut out, "fonts", fa);
    for j in 0..sd.xf.len() {
        let f = fm.list[sd.xf[j]].clone();
        if f.has_font {
            style_font(mut out, f, false, mut hyper);
        }
    }
    end(mut out, "fonts");
    let mut fl = attrs();
    fl.addi("count", sd.fill_count);
    start(mut out, "fills", fl);
    default_fill(mut out, "none");
    default_fill(mut out, "gray125");
    for j in 0..sd.xf.len() {
        let f = fm.list[sd.xf[j]].clone();
        if f.has_fill {
            style_fill(mut out, f, false);
        }
    }
    end(mut out, "fills");
    let mut ba = attrs();
    ba.addi("count", sd.border_count);
    start(mut out, "borders", ba);
    for j in 0..sd.xf.len() {
        let f = fm.list[sd.xf[j]].clone();
        if f.has_border {
            style_border(mut out, f, false);
        }
    }
    end(mut out, "borders");
    // cellStyleXfs: a second one for the hyperlink style.
    let mut ca = attrs();
    ca.addi("count", if hyper.0 { 2 } else { 1 });
    start(mut out, "cellStyleXfs", ca);
    let mut x0 = attrs();
    x0.addi("numFmtId", 0);
    x0.addi("fontId", 0);
    x0.addi("fillId", 0);
    x0.addi("borderId", 0);
    empty(mut out, "xf", x0);
    if hyper.0 {
        let mut x1 = attrs();
        x1.addi("numFmtId", 0);
        x1.addi("fontId", hyper.1);
        x1.addi("fillId", 0);
        x1.addi("borderId", 0);
        x1.addi("applyNumberFormat", 0);
        x1.addi("applyFill", 0);
        x1.addi("applyBorder", 0);
        x1.addi("applyAlignment", 0);
        x1.addi("applyProtection", 0);
        start(mut out, "xf", x1);
        empty1(mut out, "alignment", "vertical", "top".to_string());
        empty1(mut out, "protection", "locked", "0".to_string());
        end(mut out, "xf");
    }
    end(mut out, "cellStyleXfs");
    let mut xfs = sd.xf.clone();
    if xfs.len() > 0 and truthy(fm.list[xfs[xfs.len() - 1]].font_only) {
        xfs.pop();
    }
    let mut xa = attrs();
    xa.addi("count", xfs.len());
    start(mut out, "cellXfs", xa);
    for j in 0..xfs.len() {
        style_xf(mut out, fm.list[xfs[j]]);
    }
    end(mut out, "cellXfs");
    let mut sa = attrs();
    sa.addi("count", if hyper.0 { 2 } else { 1 });
    start(mut out, "cellStyles", sa);
    if hyper.0 {
        let mut h = attrs();
        h.add("name", "Hyperlink".to_string());
        h.addi("xfId", 1);
        h.addi("builtinId", 8);
        empty(mut out, "cellStyle", h);
    }
    let mut n = attrs();
    n.add("name", "Normal".to_string());
    n.addi("xfId", 0);
    n.addi("builtinId", 0);
    empty(mut out, "cellStyle", n);
    end(mut out, "cellStyles");
    let mut da = attrs();
    da.addi("count", sd.dxf.len());
    if sd.dxf.len() > 0 {
        start(mut out, "dxfs", da);
        let mut unused: (bool, i64) = (false, 0);
        for j in 0..sd.dxf.len() {
            let f = fm.list[sd.dxf[j]].clone();
            start0(mut out, "dxf");
            if f.has_dxf_font {
                style_font(mut out, f, true, mut unused);
            }
            if f.num_format_index != 0 {
                num_fmt_el(mut out, f.num_format_index, pystr(f.num_format));
            }
            if f.has_dxf_fill {
                style_fill(mut out, f, true);
            }
            if f.has_dxf_border {
                style_border(mut out, f, true);
            }
            end(mut out, "dxf");
        }
        end(mut out, "dxfs");
    } else {
        empty(mut out, "dxfs", da);
    }
    let mut ta = attrs();
    ta.addi("count", 0);
    ta.add("defaultTableStyle", "TableStyleMedium9".to_string());
    ta.add("defaultPivotStyle", "PivotStyleLight16".to_string());
    empty(mut out, "tableStyles", ta);
    end(mut out, "styleSheet");
    out
}

// ------------------------------------------------------------ dates

fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = if y >= 0 { y / 400 } else { (y - 399) / 400 };
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// datetime_to_excel_datetime(): days since 1899-12-31, with the 1900 leap
// year Excel believes in.
fn excel_time(w: ref When) -> f64 {
    let epoch = days_from_civil(1899, 12, 31);
    let mut days: i64 = 0;
    let mut secs: i64 = 0;
    let mut us: i64 = 0;
    if w.kind == 0 {
        days = days_from_civil(w.y, w.mo, w.d) - epoch;
        secs = w.h * 3600 + w.mi * 60 + w.s;
        us = w.us;
    } else if w.kind == 1 {
        days = days_from_civil(w.y, w.mo, w.d) - epoch;
    } else if w.kind == 2 {
        secs = w.h * 3600 + w.mi * 60 + w.s;
        us = w.us;
    } else {
        // timedelta(days, seconds, microseconds), normalized as Python does.
        let total = (w.d * 86400 + w.s) * 1000000 + w.us;
        let day_us: i64 = 86400 * 1000000;
        days = if total >= 0 { total / day_us } else { -((-total + day_us - 1) / day_us) };
        let rest = total - days * day_us;
        secs = rest / 1000000;
        us = rest % 1000000;
    }
    let mut t = (days as f64) + ((secs as f64) + (us as f64) / 1000000.0) / 86400.0;
    if w.kind == 0 and w.y == 1900 and w.mo == 1 and w.d == 1 {
        t -= 1.0;
    }
    if w.kind != 3 and t > 59.0 {
        t += 1.0;
    }
    t
}

// ------------------------------------------------------------ strings

fn clen(t: ref String) -> i64 {
    let mut n: i64 = 0;
    for _ in t.chars() {
        n += 1;
    }
    n
}

fn cprefix(t: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k: i64 = 0;
    for c in t.chars() {
        if k >= n {
            break;
        }
        out.push(c);
        k += 1;
    }
    out
}

// Python's str.isspace() on one character.
fn py_space(c: char) -> bool {
    let n = c as u32 as i64;
    (n >= 9 and n <= 13) or (n >= 28 and n <= 32) or n == 0x85 or n == 0xA0 or n == 0x1680
        or (n >= 0x2000 and n <= 0x200A) or n == 0x2028 or n == 0x2029 or n == 0x202F
        or n == 0x205F or n == 0x3000
}

// preserve_whitespace(): a leading or trailing space.
fn preserve_ws(t: ref String) -> bool {
    let cs: Vec[char] = t.chars().collect();
    cs.len() > 0 and (py_space(cs[0]) or py_space(cs[cs.len() - 1]))
}

// The shared string table.
struct Sst {
    map: Map[String, i64],
    arr: Vec[String],
    count: i64,
}

fn new_sst() -> Sst {
    Sst { map: Map.new(), arr: Vec.new(), count: 0 }
}

fn sst_index(sst: mut ref Sst, t: ref String) -> i64 {
    sst.count += 1;
    match sst.map.get(t) {
        Some(i) => *i,
        None => {
            let i = sst.arr.len();
            sst.map.insert(t.clone(), i);
            sst.arr.push(t.clone());
            i
        }
    }
}

// CHAR_WIDTHS, for autofit(): "HH:N" pairs, the character's code point
// in hex and its width in pixels.
fn char_widths() -> Map[char, i64] {
    let mut m: Map[char, i64] = Map.new();
    let parts: Vec[String] = char_width_spec().split(" ").map(|p| p.to_string()).collect();
    for p in parts.iter() {
        if let Some((h, w)) = p.split_once(":") {
            let mut code: i64 = 0;
            for c in h.bytes() {
                code = code * 16 + hexval(*c);
            }
            if let Ok(c) = char.try_from(code as u32) {
                m.insert(c, parse_int(w));
            }
        }
    }
    m
}

fn pixel_width(widths: ref Map[char, i64], t: ref String) -> i64 {
    let mut n: i64 = 0;
    for c in t.chars() {
        n += match widths.get(c) {
            Some(w) => *w,
            None => 8,
        };
    }
    n
}

// ------------------------------------------------------------ formulas

// One of _prepare_formula()'s re.sub() rules: "\bNAME\(" where a "." in
// NAME matches any character, or the "\SINGLE\(" rule, which is "\S"
// followed by "INGLE(".
#[derive(Clone)]
struct SubRule {
    word: bool,
    pat: Vec[char],
    rep: String,
    future: bool,
}

fn sub_rules() -> Vec[SubRule] {
    let mut out: Vec[SubRule] = Vec.new();
    let lines: Vec[String] = formula_rule_spec().split("\n").map(|p| p.to_string()).collect();
    for line in lines.iter() {
        if line.len() == 0 {
            continue;
        }
        let f: Vec[String] = line.split(" ").map(|p| p.to_string()).collect();
        out.push(SubRule { word: f[0] == "b", pat: f[1].chars().collect(), rep: f[2].clone(),
                           future: f[3] == "1" });
    }
    out
}

fn dyn_names() -> Vec[Vec[char]] {
    let mut out: Vec[Vec[char]] = Vec.new();
    let parts: Vec[String] = dynamic_function_spec().split(" ").map(|p| p.to_string()).collect();
    for p in parts.iter() {
        if p.len() > 0 {
            out.push(p.chars().collect());
        }
    }
    out
}

fn match_at(cs: ref Vec[char], i: i64, pat: ref Vec[char]) -> bool {
    if i + pat.len() > cs.len() {
        return false;
    }
    for k in 0..pat.len() {
        let c = cs[i + k];
        if pat[k] == '.' {
            if c == '\n' {
                return false;
            }
        } else if c != pat[k] {
            return false;
        }
    }
    true
}

fn word_start(cs: ref Vec[char], i: i64) -> bool {
    i == 0 or not is_word(cs[i - 1])
}

fn apply_rule(t: ref String, r: ref SubRule) -> String {
    let cs: Vec[char] = t.chars().collect();
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < cs.len() {
        let hit = if r.word {
            word_start(cs, i) and match_at(cs, i, r.pat)
        } else {
            not py_space(cs[i]) and cs[i] != '\n' and match_at(cs, i + 1, r.pat)
        };
        if hit {
            out.push_str(r.rep);
            i += r.pat.len() + (if r.word { 0 } else { 1 });
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

// re_dynamic_function.search(): a dynamic array function call anywhere.
fn has_dynamic(t: ref String, names: ref Vec[Vec[char]]) -> bool {
    let cs: Vec[char] = t.chars().collect();
    for i in 0..cs.len() {
        if word_start(cs, i) {
            for n in names.iter() {
                if match_at(cs, i, n) {
                    return true;
                }
            }
        }
    }
    false
}

// The tables the worksheets share.
struct Lib {
    rules: Vec[SubRule],
    dyn_names: Vec[Vec[char]],
    widths: Map[char, i64],
}

fn new_lib() -> Lib {
    Lib { rules: sub_rules(), dyn_names: dyn_names(), widths: char_widths() }
}

fn prepare_formula(lib: ref Lib, f0: ref String, future: bool) -> String {
    let mut f = f0.clone();
    if f.starts_with("{") {
        f = f.substring(1);
    }
    if f.starts_with("=") {
        f = f.substring(1);
    }
    if f.ends_with("}") {
        f = cprefix(f, clen(f) - 1);
    }
    if f.contains("_xlfn.") {
        return f;
    }
    for r in lib.rules.iter() {
        if r.future and not future {
            break;
        }
        f = apply_rule(f, r);
    }
    f
}

fn lstrip_eq(t: ref String) -> String {
    let mut s = t.clone();
    while s.starts_with("=") {
        s = s.substring(1);
    }
    s
}

// ------------------------------------------------------------ worksheets

#[derive(Clone)]
enum Cell {
    Str(i64, Option[i64]),
    Num(Val, Option[i64]),
    Blank(Option[i64]),
    Bool(i64, Option[i64]),
    Formula(String, Option[i64], Val),
    Array(String, Option[i64], Val, String, bool),
    Date(f64, Option[i64]),
    Rich(i64, Option[i64], String),
}

fn cell_fmt(c: ref Cell) -> Option[i64] {
    match c {
        Cell.Str(_, f) => f,
        Cell.Num(_, f) => f,
        Cell.Blank(f) => f,
        Cell.Bool(_, f) => f,
        Cell.Formula(_, f, _) => f,
        Cell.Array(_, f, _, _, _) => f,
        Cell.Date(_, f) => f,
        Cell.Rich(_, f, _) => f,
    }
}

// col_info[col]: [width, cell_format, hidden, level, collapsed, autofit].
#[derive(Clone)]
struct ColInfo {
    width: Val,
    fmt: Option[i64],
    hidden: Val,
    level: Val,
    collapsed: Val,
    autofit: bool,
}

// Python's == between two of the values a column setting holds.
fn py_eq(a: ref Val, b: ref Val) -> bool {
    if is_num(a) and is_num(b) {
        return num(a) == num(b);
    }
    match (a, b) {
        (Val.Nil, Val.Nil) => true,
        (Val.Str(x), Val.Str(y)) => x == y,
        (Val.Fmt(x), Val.Fmt(y)) => x == y,
        _ => false,
    }
}

fn col_eq(a: ref ColInfo, b: ref ColInfo) -> bool {
    py_eq(a.width, b.width) and a.fmt == b.fmt and py_eq(a.hidden, b.hidden)
        and py_eq(a.level, b.level) and py_eq(a.collapsed, b.collapsed) and a.autofit == b.autofit
}

#[derive(Clone)]
struct RowInfo {
    height: Val,
    fmt: Option[i64],
    hidden: Val,
    level: Val,
    collapsed: Val,
}

#[derive(Clone)]
struct Link {
    link_type: i64,
    url: String,
    anchor: Option[String],
    tip: Val,
}

#[derive(Clone)]
struct TCol {
    id: i64,
    name: String,
    total_string: String,
    total_function: String,
    custom_total: String,
    formula: String,
    format: Option[i64],
}

#[derive(Clone)]
struct Table {
    id: i64,
    name: Option[String],
    range: String,
    autofilter: Option[String],
    columns: Vec[TCol],
    style: String,
    show_first_col: Val,
    show_last_col: Val,
    show_row_stripes: Val,
    show_col_stripes: Val,
    header_row_count: Val,
    totals_row_shown: Val,
}

#[derive(Clone)]
struct Valid {
    cells: Vec[(i64, i64, i64, i64)],
    opts: Vec[(String, Val)],
}

// The workbook state a worksheet reaches through worksheet_meta.
struct Meta {
    activesheet: i64,
    firstsheet: i64,
}

fn key_of(row: i64, col: i64) -> i64 {
    row * 16384 + col
}

struct Sheet {
    name: String,
    index: i64,
    strings_to_numbers: bool,
    strings_to_formulas: bool,
    strings_to_urls: bool,
    nan_inf_to_errors: bool,
    use_future_functions: bool,
    default_date_format: Option[i64],
    max_url_length: i64,
    dim_rowmin: i64,
    dim_rowmax: i64,
    dim_colmin: i64,
    dim_colmax: i64,
    col_info: SortedMap[i64, ColInfo],
    set_rows: SortedMap[i64, RowInfo],
    table: SortedMap[i64, Cell],
    merge: Vec[(i64, i64, i64, i64)],
    merged_cells: Map[i64, String],
    table_cells: Map[i64, String],
    hyperlinks: SortedMap[i64, Link],
    hlink_count: i64,
    tables: Vec[Table],
    validations: Vec[Valid],
    selections: Vec[(String, String, String)],
    panes: Vec[i64],
    hidden: i64,
    selected: i64,
    tab_color: String,
    top_left_cell: String,
    page_setup_changed: bool,
    paper_size: Val,
    orientation: i64,
    print_options_changed: bool,
    hcenter: bool,
    vcenter: bool,
    print_gridlines: bool,
    screen_gridlines: bool,
    print_headers: bool,
    row_col_headers: bool,
    header_footer_changed: bool,
    header: String,
    footer: String,
    header_footer_aligns: Val,
    header_footer_scales: Val,
    margin_left: Val,
    margin_right: Val,
    margin_top: Val,
    margin_bottom: Val,
    margin_header: Val,
    margin_footer: Val,
    repeat_row_range: String,
    repeat_col_range: String,
    print_area_range: String,
    page_order: i64,
    black_white: bool,
    page_start: Val,
    fit_page: bool,
    fit_width: Val,
    fit_height: Val,
    hbreaks: Vec[Val],
    vbreaks: Vec[Val],
    protect_options: Vec[(String, Val)],
    protected_ranges: Vec[(String, String, String)],
    zoom: i64,
    print_scale: i64,
    is_right_to_left: bool,
    show_zeros: bool,
    outline_row_level: i64,
    outline_col_level: i64,
    outline_style: Val,
    outline_below: Val,
    outline_right: Val,
    outline_on: Val,
    outline_changed: bool,
    default_row_height: Val,
    default_row_zeroed: bool,
    autofilter_area: String,
    autofilter_ref: String,
    filter_range: (i64, i64),
    filter_on: bool,
    filter_cols: SortedMap[i64, Vec[Val]],
    filter_cells: Set[i64],
    rel_count: i64,
    external_hyper_links: Vec[(String, String, String)],
    external_table_links: Vec[(String, String, String)],
    page_view: i64,
    has_dynamic_arrays: bool,
    warns: Vec[String],
}

fn new_sheet(name: ref String, index: i64) -> Sheet {
    Sheet {
        name: name.clone(), index: index, strings_to_numbers: false, strings_to_formulas: true,
        strings_to_urls: true, nan_inf_to_errors: false, use_future_functions: false,
        default_date_format: None, max_url_length: 2079, dim_rowmin: -1, dim_rowmax: -1,
        dim_colmin: -1, dim_colmax: -1, col_info: SortedMap.new(), set_rows: SortedMap.new(),
        table: SortedMap.new(), merge: Vec.new(), merged_cells: Map.new(),
        table_cells: Map.new(), hyperlinks: SortedMap.new(), hlink_count: 0, tables: Vec.new(),
        validations: Vec.new(), selections: Vec.new(), panes: Vec.new(), hidden: 0,
        selected: 0, tab_color: String.new(), top_left_cell: String.new(),
        page_setup_changed: false, paper_size: Val.Int(0), orientation: 1,
        print_options_changed: false, hcenter: false, vcenter: false, print_gridlines: false,
        screen_gridlines: true, print_headers: false, row_col_headers: false,
        header_footer_changed: false, header: String.new(), footer: String.new(),
        header_footer_aligns: Val.Bool(true), header_footer_scales: Val.Bool(true),
        margin_left: Val.Float(0.7), margin_right: Val.Float(0.7), margin_top: Val.Float(0.75),
        margin_bottom: Val.Float(0.75), margin_header: Val.Float(0.3),
        margin_footer: Val.Float(0.3), repeat_row_range: String.new(),
        repeat_col_range: String.new(), print_area_range: String.new(), page_order: 0,
        black_white: false, page_start: Val.Int(0), fit_page: false, fit_width: Val.Int(0),
        fit_height: Val.Int(0), hbreaks: Vec.new(), vbreaks: Vec.new(),
        protect_options: Vec.new(), protected_ranges: Vec.new(), zoom: 100, print_scale: 100,
        is_right_to_left: false, show_zeros: true, outline_row_level: 0, outline_col_level: 0,
        outline_style: Val.Int(0), outline_below: Val.Int(1), outline_right: Val.Int(1),
        outline_on: Val.Int(1), outline_changed: false, default_row_height: Val.Int(15),
        default_row_zeroed: false, autofilter_area: String.new(), autofilter_ref: String.new(),
        filter_range: (0, 0), filter_on: false, filter_cols: SortedMap.new(),
        filter_cells: Set.new(), rel_count: 0, external_hyper_links: Vec.new(),
        external_table_links: Vec.new(), page_view: 0, has_dynamic_arrays: false,
        warns: Vec.new(),
    }
}

// What a write needs besides the sheet: the shared strings, the formula
// tables, and the formats (a table column format's dxf index is taken
// when the table is added).
struct Ctx {
    sst: Sst,
    lib: Lib,
    fm: Formats,
    meta: Meta,
}

fn warn(sh: mut ref Sheet, msg: ref String) {
    sh.warns.push(msg.clone());
}

impl Sheet {
    // _check_dimensions(): 0, or -1 when the cell is outside the sheet.
    fn check_dims(mut ref self, row: i64, col: i64, ignore_row: bool, ignore_col: bool) -> i64 {
        if row < 0 or col < 0 {
            return -1;
        }
        if row >= 1048576 or col >= 16384 {
            return -1;
        }
        if not ignore_row {
            if self.dim_rowmin < 0 or row < self.dim_rowmin {
                self.dim_rowmin = row;
            }
            if self.dim_rowmax < 0 or row > self.dim_rowmax {
                self.dim_rowmax = row;
            }
        }
        if not ignore_col {
            if self.dim_colmin < 0 or col < self.dim_colmin {
                self.dim_colmin = col;
            }
            if self.dim_colmax < 0 or col > self.dim_colmax {
                self.dim_colmax = col;
            }
        }
        0
    }

    fn put(mut ref self, row: i64, col: i64, c: own Cell) {
        self.table.insert(key_of(row, col), c);
    }
}

fn fmt_arg(v: ref Val) -> Option[i64] {
    fmt_of(v)
}

fn write_string(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col: i64, t: ref String,
                f: Option[i64]) -> i64 {
    let mut err: i64 = 0;
    if sh.check_dims(row, col, false, false) != 0 {
        return -1;
    }
    let mut s = t.clone();
    if clen(s) > 32767 {
        s = cprefix(s, 32767);
        err = -2;
    }
    let idx = sst_index(mut cx.sst, s);
    sh.put(row, col, Cell.Str(idx, f));
    err
}

#[allow(mutual_recursion_note)]
fn write_number(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col: i64, n: ref Val,
                f: Option[i64]) -> Result[i64, PyErr] {
    let x = num(n);
    if x != x or not is_finite(x) {
        if sh.nan_inf_to_errors {
            if x != x {
                return write_formula(mut sh, mut cx, row, col, "#NUM!", f, sv("#NUM!"));
            } else if x > 0.0 {
                return write_formula(mut sh, mut cx, row, col, "1/0", f, sv("#DIV/0!"));
            } else {
                return write_formula(mut sh, mut cx, row, col, "-1/0", f, sv("#DIV/0!"));
            }
        }
        return Err(raise("TypeError",
                         "NAN/INF not supported in write_number() without 'nan_inf_to_errors' Workbook() option"));
    }
    if sh.check_dims(row, col, false, false) != 0 {
        return Ok(-1);
    }
    sh.put(row, col, Cell.Num(n.clone(), f));
    Ok(0)
}

fn write_blank(sh: mut ref Sheet, row: i64, col: i64, f: Option[i64]) -> i64 {
    if f.is_none() {
        return 0;
    }
    if sh.check_dims(row, col, false, false) != 0 {
        return -1;
    }
    sh.put(row, col, Cell.Blank(f));
    0
}

#[allow(mutual_recursion_note)]
fn write_formula(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col: i64, formula: ref String,
                 f: Option[i64], value: ref Val) -> Result[i64, PyErr] {
    if sh.check_dims(row, col, false, false) != 0 {
        return Ok(-1);
    }
    if formula.len() == 0 {
        warn(mut sh, "Formula can't be None or empty");
        return Ok(-1);
    }
    if has_dynamic(formula, cx.lib.dyn_names) {
        return write_array_formula(mut sh, mut cx, row, col, row, col, formula, f, value, true);
    }
    if formula.starts_with("{") and formula.ends_with("}") {
        return write_array_formula(mut sh, mut cx, row, col, row, col, formula, f, value, false);
    }
    let pf = prepare_formula(cx.lib, formula, sh.use_future_functions);
    sh.put(row, col, Cell.Formula(pf, f, value.clone()));
    Ok(0)
}

#[allow(mutual_recursion_note)]
fn write_array_formula(sh: mut ref Sheet, cx: mut ref Ctx, r1: i64, c1: i64, r2: i64, c2: i64,
                       formula: ref String, f: Option[i64], value: ref Val,
                       dynamic: bool) -> Result[i64, PyErr] {
    let (fr, lr) = if r1 > r2 { (r2, r1) } else { (r1, r2) };
    let (fc, lc) = if c1 > c2 { (c2, c1) } else { (c1, c2) };
    if sh.check_dims(fr, fc, false, false) != 0 {
        return Ok(-1);
    }
    if sh.check_dims(lr, lc, false, false) != 0 {
        return Ok(-1);
    }
    let range = if fr == lr and fc == lc {
        cell_ref(fr, fc)
    } else {
        let a = cell_ref(fr, fc);
        let b = cell_ref(lr, lc);
        f"{a}:{b}"
    };
    let pf = prepare_formula(cx.lib, formula, sh.use_future_functions);
    sh.put(fr, fc, Cell.Array(pf, f, value.clone(), range, dynamic));
    for row in fr..lr + 1 {
        for col in fc..lc + 1 {
            if row != fr or col != fc {
                write_number(mut sh, mut cx, row, col, Val.Int(0), f)?;
            }
        }
    }
    if dynamic {
        sh.has_dynamic_arrays = true;
    }
    Ok(0)
}

fn write_datetime(sh: mut ref Sheet, row: i64, col: i64, w: ref When, f: Option[i64]) -> i64 {
    if sh.check_dims(row, col, false, false) != 0 {
        return -1;
    }
    let n = excel_time(w);
    let fmt = if f.is_none() { sh.default_date_format } else { f };
    sh.put(row, col, Cell.Date(n, fmt));
    0
}

fn write_boolean(sh: mut ref Sheet, row: i64, col: i64, b: ref Val, f: Option[i64]) -> i64 {
    if sh.check_dims(row, col, false, false) != 0 {
        return -1;
    }
    sh.put(row, col, Cell.Bool(if truthy(b) { 1 } else { 0 }, f));
    0
}

fn type_name(v: ref Val) -> String {
    match v {
        Val.List(_) => "<class 'list'>".to_string(),
        Val.Dict(_) => "<class 'dict'>".to_string(),
        _ => "<class 'xlsxwriter.format.Format'>".to_string(),
    }
}

fn url_like(t: ref String) -> bool {
    t.starts_with("http://") or t.starts_with("https://") or t.starts_with("ftp://")
        or t.starts_with("ftps://") or t.starts_with("mailto:") or t.starts_with("internal:")
        or t.starts_with("external:")
}

// _write(): by the type of the token. rest is what follows the token.
#[allow(mutual_recursion_note)]
fn write_any(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col: i64, args: ref Vec[Val]) -> Result[i64, PyErr] {
    if args.len() == 0 {
        return Err(raise("TypeError", "write() takes at least 4 arguments (3 given)"));
    }
    let token = args[0].clone();
    let a1 = arg(args, 1);
    match token {
        Val.Nil => Ok(write_blank(mut sh, row, col, fmt_arg(a1))),
        Val.Bool(_) => Ok(write_boolean(mut sh, row, col, token, fmt_arg(a1))),
        Val.Int(_) => write_number(mut sh, mut cx, row, col, token, fmt_arg(a1)),
        Val.Float(_) => write_number(mut sh, mut cx, row, col, token, fmt_arg(a1)),
        Val.Str(t) => write_token_string(mut sh, mut cx, row, col, t, args),
        Val.Time(w) => Ok(write_datetime(mut sh, row, col, w, fmt_arg(a1))),
        _ => {
            let tn = type_name(token);
            Err(raise("TypeError", f"Unsupported type {tn} in write()"))
        }
    }
}

#[allow(mutual_recursion_note)]
fn write_token_string(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col: i64, t: ref String,
                      args: ref Vec[Val]) -> Result[i64, PyErr] {
    let a1 = arg(args, 1);
    if t.len() == 0 {
        // _write_blank(row, col, token, cell_format): the format is the
        // argument after the token.
        return Ok(write_blank(mut sh, row, col, fmt_arg(a1)));
    }
    if sh.strings_to_formulas and t.starts_with("=") {
        return write_formula(mut sh, mut cx, row, col, t, fmt_arg(a1), arg_or(args, 2, Val.Int(0)));
    }
    if t.starts_with("{=") and t.ends_with("}") {
        return write_formula(mut sh, mut cx, row, col, t, fmt_arg(a1), arg_or(args, 2, Val.Int(0)));
    }
    if t.contains(":") and sh.strings_to_urls and url_like(t) {
        return write_url(mut sh, mut cx, row, col, t, a1, arg(args, 2), arg(args, 3));
    }
    if sh.strings_to_numbers {
        if let Some(x) = py_float(t) {
            if sh.nan_inf_to_errors or (x == x and is_finite(x)) {
                return write_number(mut sh, mut cx, row, col, Val.Float(x), fmt_arg(a1));
            }
        }
    }
    Ok(write_string(mut sh, mut cx, row, col, t, fmt_arg(a1)))
}

fn write_row(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col0: i64, data: ref Val,
             f: ref Val) -> Result[i64, PyErr] {
    let items = match data {
        Val.List(v) => v.clone(),
        Val.Str(t) => {
            let mut v: Vec[Val] = Vec.new();
            for c in t.chars() {
                v.push(Val.Str(c.to_string()));
            }
            v
        }
        _ => return Err(raise("TypeError", "object is not iterable")),
    };
    let mut col = col0;
    for tok in items.iter() {
        let err = write_any(mut sh, mut cx, row, col, [tok.clone(), f.clone()])?;
        if err != 0 {
            return Ok(err);
        }
        col += 1;
    }
    Ok(0)
}

fn write_column(sh: mut ref Sheet, cx: mut ref Ctx, row0: i64, col: i64, data: ref Val,
                f: ref Val) -> Result[i64, PyErr] {
    let items = match data {
        Val.List(v) => v.clone(),
        _ => return Err(raise("TypeError", "object is not iterable")),
    };
    let mut row = row0;
    for tok in items.iter() {
        let err = write_any(mut sh, mut cx, row, col, [tok.clone(), f.clone()])?;
        if err != 0 {
            return Ok(err);
        }
        row += 1;
    }
    Ok(0)
}

// ------------------------------------------------------------ urls

fn has_pct_escape(t: ref String) -> bool {
    let cs: Vec[char] = t.chars().collect();
    for i in 0..cs.len() {
        if cs[i] == '%' and i + 2 < cs.len() and is_hex(cs[i + 1]) and is_hex(cs[i + 2]) {
            return true;
        }
    }
    false
}

fn escape_url(t: ref String) -> String {
    if has_pct_escape(t) {
        return t.clone();
    }
    t.replace("%", "%25").replace("\"", "%22").replace(" ", "%20").replace("<", "%3c")
        .replace(">", "%3e").replace("[", "%5b").replace("]", "%5d").replace("^", "%5e")
        .replace("`", "%60").replace("{", "%7b").replace("}", "%7d")
}

fn write_url(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col: i64, url0: ref String,
             f: ref Val, string: ref Val, tip: ref Val) -> Result[i64, PyErr] {
    if sh.check_dims(row, col, false, false) != 0 {
        return Ok(-1);
    }
    let mut url = url0.clone();
    let mut s = if is_nil(string) { url.clone() } else { str_of(string) };
    let mut link_type: i64 = 1;
    if url.starts_with("internal:") {
        url = url.replace("internal:", "");
        s = s.replace("internal:", "");
        link_type = 2;
    }
    let mut external = false;
    if url.starts_with("external:") {
        url = url.replace("external:", "").replace("/", "\\");
        s = s.replace("external:", "").replace("/", "\\");
        external = true;
    }
    s = s.replace("mailto:", "");
    if clen(s) > 32767 {
        warn(mut sh, "Ignoring URL since it exceeds Excel's string limit of 32767 characters");
        return Ok(-2);
    }
    let mut anchor: Option[String] = Some(s.clone());
    if link_type == 1 {
        match url.find("#") {
            Some(p) => {
                let head = url.substring(0, p);
                let tail = url.substring(p + 1);
                url = head;
                anchor = Some(tail);
            }
            None => {
                anchor = None;
            }
        }
        url = escape_url(url);
        if not external {
            if let Some(a) = anchor.clone() {
                anchor = Some(escape_url(a));
            }
        }
        let uc: Vec[char] = url.chars().collect();
        let drive = uc.len() >= 2 and is_word(uc[0]) and uc[1] == ':';
        if drive or url.starts_with("\\") {
            url = f"file:///{url}";
        }
        if url.starts_with(".\\") {
            url = url.substring(2);
        }
    }
    let tmp = match anchor.clone() {
        Some(a) => a,
        None => String.new(),
    };
    let max = sh.max_url_length;
    if clen(url) > max or clen(tmp) > max {
        warn(mut sh, f"Ignoring URL '{url}' with link or location/anchor > {max} characters since it exceeds Excel's limit for URLS");
        return Ok(-3);
    }
    sh.hlink_count += 1;
    if sh.hlink_count > 65530 {
        warn(mut sh, f"Ignoring URL '{url}' since it exceeds Excel's limit of 65,530 URLS per worksheet.");
        return Ok(-4);
    }
    let fmt = match fmt_of(f) {
        Some(i) => Some(i),
        None => Some(1),
    };
    write_string(mut sh, mut cx, row, col, s, fmt);
    sh.hyperlinks.insert(key_of(row, col), Link { link_type: link_type, url: url, anchor: anchor,
                                                   tip: tip.clone() });
    Ok(0)
}

// ------------------------------------------------------------ rich strings

fn ws_palette(c: ref Val) -> String {
    let t = pystr(c);
    let body = if t.starts_with("#") { t.substring(1) } else { t };
    let up = body.to_uppercase();
    f"FF{up}"
}

fn rich_font(out: mut ref String, f: ref Format) -> Result[(), PyErr] {
    start0(mut out, "rPr");
    if truthy(f.bold) {
        empty0(mut out, "b");
    }
    if truthy(f.italic) {
        empty0(mut out, "i");
    }
    if truthy(f.font_strikeout) {
        empty0(mut out, "strike");
    }
    if truthy(f.font_outline) {
        empty0(mut out, "outline");
    }
    if truthy(f.font_shadow) {
        empty0(mut out, "shadow");
    }
    if truthy(f.underline) {
        let mut a = attrs();
        if eq_int(f.underline, 2) {
            a.add("val", "double");
        } else if eq_int(f.underline, 33) {
            a.add("val", "singleAccounting");
        } else if eq_int(f.underline, 34) {
            a.add("val", "doubleAccounting");
        }
        empty(mut out, "u", a);
    }
    if eq_int(f.font_script, 1) {
        empty1(mut out, "vertAlign", "val", "superscript");
    }
    if eq_int(f.font_script, 2) {
        empty1(mut out, "vertAlign", "val", "subscript");
    }
    empty1(mut out, "sz", "val", pystr(f.font_size));
    if eq_int(f.theme, -1) {
        // no colour
    } else if truthy(f.theme) or truthy(f.color_indexed) {
        // _write_color() writes to the worksheet's own file handle, which
        // is None until the worksheet is assembled.
        return Err(raise("AttributeError", "'NoneType' object has no attribute 'write'"));
    } else if truthy(f.font_color) {
        empty1(mut out, "color", "rgb", ws_palette(f.font_color));
    } else {
        empty1(mut out, "color", "theme", "1");
    }
    empty1(mut out, "rFont", "val", pystr(f.font_name));
    empty1(mut out, "family", "val", pystr(f.font_family));
    if pystr(f.font_name) == "Calibri" and not f.hyperlink {
        empty1(mut out, "scheme", "val", pystr(f.font_scheme));
    }
    end(mut out, "rPr");
    Ok(())
}

fn write_rich_string(sh: mut ref Sheet, cx: mut ref Ctx, row: i64, col: i64,
                     args: ref Vec[Val]) -> Result[i64, PyErr] {
    let mut tokens = args.clone();
    let mut cell_format: Option[i64] = None;
    let mut raw = String.new();
    if sh.check_dims(row, col, false, false) != 0 {
        return Ok(-1);
    }
    if tokens.len() > 0 {
        if let Some(i) = fmt_of(tokens[tokens.len() - 1]) {
            cell_format = Some(i);
            tokens.pop();
        }
    }
    if tokens.len() <= 2 {
        warn(mut sh, "You must specify more than 2 format/fragments for rich strings. Ignoring input in write_rich_string().");
        return Ok(-5);
    }
    // Fragments: -1 the default Format(), else a format index; or a string.
    let mut frags: Vec[(i64, String, bool)] = Vec.new();
    let mut prev_format = true;
    let mut pos: i64 = 0;
    for t in tokens.iter() {
        match fmt_of(t) {
            None => {
                let s = str_of(t);
                if not prev_format {
                    frags.push((-1, String.new(), true));
                }
                frags.push((0, s.clone(), false));
                if s.len() == 0 {
                    warn(mut sh, "Excel doesn't allow empty strings in rich strings. Ignoring input in write_rich_string().");
                    return Ok(-4);
                }
                raw.push_str(s);
                prev_format = false;
            }
            Some(i) => {
                if prev_format and pos > 0 {
                    warn(mut sh, "Excel doesn't allow 2 consecutive formats in rich strings. Ignoring input in write_rich_string().");
                    return Ok(-3);
                }
                frags.push((i, String.new(), true));
                prev_format = true;
            }
        }
        pos += 1;
    }
    let mut out = String.new();
    if not frags[0].2 {
        start0(mut out, "r");
    }
    let dflt = new_format();
    for fr in frags.iter() {
        let (i, s, is_fmt) = fr.clone();
        if is_fmt {
            start0(mut out, "r");
            if i < 0 {
                rich_font(mut out, dflt)?;
            } else {
                let f = cx.fm.list[i].clone();
                rich_font(mut out, f)?;
            }
        } else {
            let mut a = attrs();
            if preserve_ws(s) {
                a.add("xml:space", "preserve");
            }
            data_el(mut out, "t", s, a);
            end(mut out, "r");
        }
    }
    if clen(raw) > 32767 {
        warn(mut sh, "String length must be less than or equal to Excel's limit of 32,767 characters in write_rich_string().");
        return Ok(-2);
    }
    let idx = sst_index(mut cx.sst, out);
    sh.put(row, col, Cell.Rich(idx, cell_format, raw));
    Ok(0)
}

// ------------------------------------------------------------ ranges

fn merge_range(sh: mut ref Sheet, cx: mut ref Ctx, r1: i64, c1: i64, r2: i64, c2: i64,
               data: ref Val, f: ref Val) -> Result[Val, PyErr] {
    if r1 == r2 and c1 == c2 {
        warn(mut sh, "Can't merge single cell");
        return Ok(Val.Nil);
    }
    let (fr, lr) = if r1 > r2 { (r2, r1) } else { (r1, r2) };
    let (fc, lc) = if c1 > c2 { (c2, c1) } else { (c1, c2) };
    if sh.check_dims(fr, fc, false, false) != 0 {
        return Ok(Val.Int(-1));
    }
    if sh.check_dims(lr, lc, false, false) != 0 {
        return Ok(Val.Int(-1));
    }
    let range = range_ref(fr, fc, lr, lc);
    for row in fr..lr + 1 {
        for col in fc..lc + 1 {
            let k = key_of(row, col);
            if let Some(prev) = sh.merged_cells.get(k) {
                let p = prev.clone();
                return Err(raise("OverlappingRange", f"Merge range '{range}' overlaps previous merge range '{p}'."));
            }
            if let Some(prev) = sh.table_cells.get(k) {
                let p = prev.clone();
                return Err(raise("OverlappingRange", f"Merge range '{range}' overlaps previous table range '{p}'."));
            }
            sh.merged_cells.insert(k, range.clone());
        }
    }
    sh.merge.push((fr, fc, lr, lc));
    write_any(mut sh, mut cx, fr, fc, [data.clone(), f.clone()])?;
    for row in fr..lr + 1 {
        for col in fc..lc + 1 {
            if row == fr and col == fc {
                continue;
            }
            write_blank(mut sh, row, col, fmt_of(f));
        }
    }
    Ok(Val.Int(0))
}

fn clamp_level(v: ref Val) -> Val {
    if num(v) < 0.0 {
        Val.Int(0)
    } else if num(v) > 7.0 {
        Val.Int(7)
    } else {
        v.clone()
    }
}

fn set_column(sh: mut ref Sheet, c1: i64, c2: i64, width: ref Val, f: ref Val,
              options: ref Val) -> i64 {
    let opts = dict_of(options);
    let (fc, lc) = if c1 > c2 { (c2, c1) } else { (c1, c2) };
    let hidden = dget_or(opts, "hidden", Val.Bool(false));
    let collapsed = dget_or(opts, "collapsed", Val.Bool(false));
    let level0 = dget_or(opts, "level", Val.Int(0));
    let ignore_col = not (fmt_of(f).is_some() or (truthy(width) and truthy(hidden)));
    if sh.check_dims(0, lc, true, ignore_col) != 0 {
        return -1;
    }
    if sh.check_dims(0, fc, true, ignore_col) != 0 {
        return -1;
    }
    let level = clamp_level(level0);
    if as_int(level) > sh.outline_col_level {
        sh.outline_col_level = as_int(level);
    }
    for col in fc..lc + 1 {
        sh.col_info.insert(col, ColInfo { width: width.clone(), fmt: fmt_of(f), hidden: hidden.clone(),
                                          level: level.clone(), collapsed: collapsed.clone(),
                                          autofit: false });
    }
    0
}

fn set_row(sh: mut ref Sheet, row: i64, height0: ref Val, f: ref Val, options: ref Val) -> i64 {
    let opts = dict_of(options);
    let min_col = if sh.dim_colmin >= 0 { sh.dim_colmin } else { 0 };
    if sh.check_dims(row, min_col, false, false) != 0 {
        return -1;
    }
    let mut height = if is_nil(height0) { sh.default_row_height.clone() } else { height0.clone() };
    let mut hidden = dget_or(opts, "hidden", Val.Bool(false));
    let collapsed = dget_or(opts, "collapsed", Val.Bool(false));
    let level0 = dget_or(opts, "level", Val.Int(0));
    if eq_int(height, 0) {
        hidden = Val.Int(1);
        height = sh.default_row_height.clone();
    }
    let level = clamp_level(level0);
    if as_int(level) > sh.outline_row_level {
        sh.outline_row_level = as_int(level);
    }
    sh.set_rows.insert(row, RowInfo { height: height, fmt: fmt_of(f), hidden: hidden, level: level,
                                      collapsed: collapsed });
    0
}

fn pixels_to_width(px: i64) -> f64 {
    let p = px as f64;
    if px <= 12 { p / 12.0 } else { (p - 5.0) / 7.0 }
}

fn autofit(sh: mut ref Sheet, cx: ref Ctx) {
    if sh.dim_rowmax < 0 {
        return;
    }
    let mut widest: SortedMap[i64, i64] = SortedMap.new();
    for (k, cell) in sh.table.iter() {
        let row = *k / 16384;
        let col = *k % 16384;
        let mut length: i64 = 0;
        match cell {
            Cell.Str(i, _) => {
                length = text_width(cx.lib.widths, cx.sst.arr[i]);
            }
            Cell.Rich(_, _, raw) => {
                length = text_width(cx.lib.widths, raw);
            }
            Cell.Num(n, _) => {
                length = 7 * clen(pystr(n));
            }
            Cell.Date(_, _) => {
                length = 68;
            }
            Cell.Bool(b, _) => {
                length = if b != 0 { 31 } else { 36 };
            }
            Cell.Formula(_, _, v) => {
                length = formula_width(cx.lib.widths, v);
            }
            Cell.Array(_, _, v, _, _) => {
                length = formula_width(cx.lib.widths, v);
            }
            Cell.Blank(_) => {}
        }
        if sh.filter_cells.contains(key_of(row, col)) and length > 0 {
            length += 16;
        }
        let have = match widest.get(col) {
            Some(w) => *w,
            None => 0,
        };
        if length > have {
            widest.insert(col, length);
        }
    }
    for (c, px) in widest.iter() {
        let col = *c;
        let mut width = pixels_to_width(*px + 7);
        if width > 255.0 {
            width = 255.0;
        }
        match sh.col_info.get(col) {
            Some(info) => {
                let mut ci = info.clone();
                if not is_nil(ci.width) and not ci.autofit {
                    if width > num(ci.width) {
                        ci.width = Val.Float(width);
                        ci.autofit = true;
                    }
                } else {
                    ci.width = Val.Float(width);
                    ci.autofit = true;
                }
                sh.col_info.insert(col, ci);
            }
            None => {
                sh.col_info.insert(col, ColInfo { width: Val.Float(width), fmt: None,
                                                  hidden: Val.Bool(false), level: Val.Int(0),
                                                  collapsed: Val.Bool(false), autofit: true });
            }
        }
    }
}

fn text_width(widths: ref Map[char, i64], t: ref String) -> i64 {
    if not t.contains("\n") {
        return pixel_width(widths, t);
    }
    let mut best: i64 = 0;
    let parts: Vec[String] = t.split("\n").map(|p| p.to_string()).collect();
    for p in parts.iter() {
        let w = pixel_width(widths, p);
        if w > best {
            best = w;
        }
    }
    best
}

// A formula's cached value: a number (a bool counts) longer when it is
// positive, a string by its pixel width.
fn formula_width(widths: ref Map[char, i64], v: ref Val) -> i64 {
    match v {
        Val.Str(t) => pixel_width(widths, t),
        _ => {
            if is_num(v) and num(v) > 0.0 { 7 * clen(pystr(v)) } else { 0 }
        }
    }
}

// ------------------------------------------------------------ validation

fn dict_get_str(d: ref Vec[(String, Val)], k: Str) -> String {
    match dget(d, k) {
        Some(v) => pystr(v),
        None => String.new(),
    }
}

fn val_type(t: ref String) -> String {
    let keys = ["any", "any value", "whole number", "whole", "integer", "decimal", "list", "date",
                "time", "text length", "length", "custom"];
    let vals = ["none", "none", "whole", "whole", "whole", "decimal", "list", "date", "time",
                "textLength", "textLength", "custom"];
    for i in 0..keys.len() {
        if keys[i] == t {
            return vals[i].to_string();
        }
    }
    String.new()
}

fn criteria_type(t: ref String) -> String {
    let keys = ["between", "not between", "equal to", "=", "==", "not equal to", "!=", "<>",
                "greater than", ">", "less than", "<", "greater than or equal to", ">=",
                "less than or equal to", "<="];
    let vals = ["between", "notBetween", "equal", "equal", "equal", "notEqual", "notEqual",
                "notEqual", "greaterThan", "greaterThan", "lessThan", "lessThan",
                "greaterThanOrEqual", "greaterThanOrEqual", "lessThanOrEqual", "lessThanOrEqual"];
    for i in 0..keys.len() {
        if keys[i] == t {
            return vals[i].to_string();
        }
    }
    String.new()
}

fn csv_join(items: ref Vec[Val]) -> String {
    let mut out = String.new();
    for i in 0..items.len() {
        if i > 0 {
            out.push_str(",");
        }
        out.push_str(pystr(items[i]));
    }
    out
}

fn data_validation(sh: mut ref Sheet, r1: i64, c1: i64, r2: i64, c2: i64,
                   options: ref Val) -> Result[i64, PyErr] {
    if sh.check_dims(r1, c1, true, true) != 0 {
        return Ok(-1);
    }
    if sh.check_dims(r2, c2, true, true) != 0 {
        return Ok(-1);
    }
    let mut o = dict_of(options);
    let valid = ["validate", "criteria", "value", "source", "minimum", "maximum", "ignore_blank",
                 "dropdown", "show_input", "input_title", "input_message", "show_error",
                 "error_title", "error_message", "error_type", "other_cells", "multi_range"];
    for i in 0..o.len() {
        let k = o[i].0.clone();
        let mut known = false;
        for v in valid.iter() {
            if *v == k {
                known = true;
            }
        }
        if not known {
            warn(mut sh, f"Unknown parameter '{k}' in data_validation()");
            return Ok(-2);
        }
    }
    if let Some(v) = dget(o, "source") {
        dset(mut o, "value", v);
    }
    if let Some(v) = dget(o, "minimum") {
        dset(mut o, "value", v);
    }
    if not dhas(o, "validate") {
        warn(mut sh, "Parameter 'validate' is required in data_validation()");
        return Ok(-2);
    }
    let vt = val_type(dict_get_str(o, "validate"));
    if vt.len() == 0 {
        let raw = dict_get_str(o, "validate");
        warn(mut sh, f"Unknown validation type '{raw}' for parameter 'validate' in data_validation()");
        return Ok(-2);
    }
    dset(mut o, "validate", Val.Str(vt.clone()));
    if vt == "none" and is_nil(dget_or(o, "input_title", Val.Nil))
        and is_nil(dget_or(o, "input_message", Val.Nil)) {
        return Ok(-2);
    }
    if vt == "none" or vt == "list" or vt == "custom" {
        dset(mut o, "criteria", sv("between"));
        dset(mut o, "maximum", Val.Nil);
    }
    if not dhas(o, "criteria") {
        warn(mut sh, "Parameter 'criteria' is required in data_validation()");
        return Ok(-2);
    }
    let ct = criteria_type(dict_get_str(o, "criteria"));
    if ct.len() == 0 {
        let raw = dict_get_str(o, "criteria");
        warn(mut sh, f"Unknown criteria type '{raw}' for parameter 'criteria' in data_validation()");
        return Ok(-2);
    }
    dset(mut o, "criteria", Val.Str(ct.clone()));
    if ct == "between" or ct == "notBetween" {
        if not dhas(o, "maximum") {
            warn(mut sh, "Parameter 'maximum' is required in data_validation() when using 'between' or 'not between' criteria");
            return Ok(-2);
        }
    } else {
        dset(mut o, "maximum", Val.Nil);
    }
    match dget(o, "error_type") {
        None => dset(mut o, "error_type", Val.Int(0)),
        Some(e) => {
            let t = pystr(e);
            let n = if t == "stop" { 0 } else if t == "warning" { 1 } else if t == "information" { 2 } else { -1 };
            if n < 0 or not is_str(e) {
                warn(mut sh, f"Unknown criteria type '{t}' for parameter 'error_type' in data_validation()");
                return Ok(-2);
            }
            dset(mut o, "error_type", Val.Int(n));
        }
    }
    if vt == "date" or vt == "time" {
        let value = match dget(o, "value") {
            Some(v) => v,
            None => return Err(raise("KeyError", "'value'")),
        };
        if let Val.Time(w) = value {
            let t = fmt_g(excel_time(w), 16, false);
            dset(mut o, "value", Val.Str(t));
            let mx = dget_or(o, "maximum", Val.Nil);
            if let Val.Time(w2) = mx {
                let t2 = fmt_g(excel_time(w2), 16, false);
                dset(mut o, "maximum", Val.Str(t2));
            }
        }
    }
    let limits = [("input_title", 32, "input title"), ("error_title", 32, "error title"),
                  ("input_message", 255, "input message"), ("error_message", 255, "error message")];
    for lim in limits.iter() {
        let (k, n, what) = lim.clone();
        let v = dget_or(o, k, Val.Nil);
        if truthy(v) and clen(pystr(v)) > n {
            let t = pystr(v);
            warn(mut sh, f"Length of {what} '{t}' exceeds Excel's limit of {n}");
            return Ok(-2);
        }
    }
    if vt == "list" {
        if let Some(Val.List(items)) = dget(o, "value") {
            let formula = csv_join(items);
            if clen(formula) > 255 {
                warn(mut sh, f"Length of list items '{formula}' exceeds Excel's limit of 255, use a formula range instead");
                return Ok(-2);
            }
        }
    }
    for k in ["ignore_blank", "dropdown", "show_input", "show_error"].iter() {
        if not dhas(o, *k) {
            dset(mut o, *k, Val.Int(1));
        }
    }
    let mut cells: Vec[(i64, i64, i64, i64)] = [(r1, c1, r2, c2)];
    if let Some(Val.List(more)) = dget(o, "other_cells") {
        for m in more.iter() {
            if let Val.List(q) = m {
                cells.push((as_int(q[0]), as_int(q[1]), as_int(q[2]), as_int(q[3])));
            }
        }
    }
    if let Some(mr) = dget(o, "multi_range") {
        dset(mut o, "multi_range", Val.Str(pystr(mr).replace("$", "")));
    }
    sh.validations.push(Valid { cells: cells, opts: o });
    Ok(0)
}

// ------------------------------------------------------------ tables

fn name_ok(name: ref String) -> bool {
    // ^[\w\\][\w\\.]*$ and not ^\d
    let cs: Vec[char] = name.chars().collect();
    if cs.len() == 0 {
        return false;
    }
    if not (is_word(cs[0]) or cs[0] == '\\') {
        return false;
    }
    for i in 1..cs.len() {
        if not (is_word(cs[i]) or cs[i] == '\\' or cs[i] == '.') {
            return false;
        }
    }
    not (cs[0] >= '0' and cs[0] <= '9')
}

fn is_ascii_letter(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn all_digits(cs: ref Vec[char], from: i64) -> bool {
    if from >= cs.len() {
        return false;
    }
    for i in from..cs.len() {
        if not is_digit(cs[i]) {
            return false;
        }
    }
    true
}

// ^[a-zA-Z][a-zA-Z]?[a-dA-D]?\d+$
fn looks_like_cell(name: ref String) -> bool {
    let cs: Vec[char] = name.chars().collect();
    if cs.len() == 0 or not is_ascii_letter(cs[0]) {
        return false;
    }
    let ad = |c: char| (c >= 'a' and c <= 'd') or (c >= 'A' and c <= 'D');
    // Try the optional letters every way the regex can.
    if all_digits(cs, 1) {
        return true;
    }
    if cs.len() > 1 and is_ascii_letter(cs[1]) and all_digits(cs, 2) {
        return true;
    }
    if cs.len() > 1 and ad(cs[1]) and all_digits(cs, 2) {
        return true;
    }
    if cs.len() > 2 and is_ascii_letter(cs[1]) and ad(cs[2]) and all_digits(cs, 3) {
        return true;
    }
    false
}

fn is_rc(c: char) -> bool {
    c == 'r' or c == 'c' or c == 'R' or c == 'C'
}

// ^[rcRC]$ or ^[rcRC]\d+[rcRC]\d+$
fn looks_like_rc(name: ref String) -> bool {
    let cs: Vec[char] = name.chars().collect();
    if cs.len() == 1 and is_rc(cs[0]) {
        return true;
    }
    if cs.len() < 4 or not is_rc(cs[0]) {
        return false;
    }
    let mut i: i64 = 1;
    while i < cs.len() and is_digit(cs[i]) {
        i += 1;
    }
    if i == 1 or i >= cs.len() or not is_rc(cs[i]) {
        return false;
    }
    all_digits(cs, i + 1)
}

fn table_function_formula(sh: mut ref Sheet, func: ref String, col_name: ref String) -> String {
    let name = col_name.replace("'", "''").replace("#", "'#").replace("]", "']").replace("[", "'[");
    let names = ["average", "countNums", "count", "max", "min", "stdDev", "sum", "var"];
    let nums = [101, 102, 103, 104, 105, 107, 109, 110];
    for i in 0..names.len() {
        if names[i] == func {
            let n = nums[i];
            return f"SUBTOTAL({n},[{name}])";
        }
    }
    warn(mut sh, f"Unsupported function '{func}' in add_table()");
    String.new()
}

fn add_table(sh: mut ref Sheet, cx: mut ref Ctx, r1: i64, c1: i64, r2: i64, c2: i64,
             options: ref Val) -> Result[i64, PyErr] {
    let mut o = dict_of(options);
    if sh.check_dims(r1, c1, true, true) != 0 {
        return Ok(-1);
    }
    if sh.check_dims(r2, c2, true, true) != 0 {
        return Ok(-1);
    }
    let (fr, lr) = if r1 > r2 { (r2, r1) } else { (r1, r2) };
    let (fc, lc) = if c1 > c2 { (c2, c1) } else { (c1, c2) };
    let range = range_ref(fr, fc, lr, lc);
    for row in fr..lr + 1 {
        for col in fc..lc + 1 {
            let k = key_of(row, col);
            if let Some(prev) = sh.table_cells.get(k) {
                let p = prev.clone();
                return Err(raise("OverlappingRange", f"Table range '{range}' overlaps previous table range '{p}'."));
            }
            if let Some(prev) = sh.merged_cells.get(k) {
                let p = prev.clone();
                return Err(raise("OverlappingRange", f"Table range '{range}' overlaps previous merge range '{p}'."));
            }
            sh.table_cells.insert(k, range.clone());
        }
    }
    let valid = ["autofilter", "banded_columns", "banded_rows", "columns", "data", "first_column",
                 "header_row", "last_column", "name", "style", "total_row"];
    for i in 0..o.len() {
        let k = o[i].0.clone();
        let mut known = false;
        for v in valid.iter() {
            if *v == k {
                known = true;
            }
        }
        if not known {
            warn(mut sh, f"Unknown parameter '{k}' in add_table()");
            return Ok(-2);
        }
    }
    let banded_rows = dget_or(o, "banded_rows", Val.Bool(true));
    dset(mut o, "banded_rows", banded_rows);
    let header_row = dget_or(o, "header_row", Val.Bool(true));
    dset(mut o, "header_row", header_row);
    let autofilter0 = dget_or(o, "autofilter", Val.Bool(true));
    dset(mut o, "autofilter", autofilter0);
    let header = truthy(dget_or(o, "header_row", Val.Nil));
    let mut num_rows = lr - fr;
    if header {
        num_rows -= 1;
    }
    if num_rows < 0 {
        warn(mut sh, "Must have at least one data row in in add_table()");
        return Ok(-2);
    }
    let mut t = Table {
        id: 0, name: None, range: String.new(), autofilter: None, columns: Vec.new(),
        style: String.new(),
        show_first_col: dget_or(o, "first_column", Val.Bool(false)),
        show_last_col: dget_or(o, "last_column", Val.Bool(false)),
        show_row_stripes: dget_or(o, "banded_rows", Val.Bool(false)),
        show_col_stripes: dget_or(o, "banded_columns", Val.Bool(false)),
        header_row_count: dget_or(o, "header_row", Val.Int(0)),
        totals_row_shown: dget_or(o, "total_row", Val.Bool(false)),
    };
    if let Some(nv) = dget(o, "name") {
        let name = pystr(nv);
        t.name = Some(name.clone());
        if name.contains(" ") {
            warn(mut sh, f"Name '{name}' in add_table() cannot contain spaces");
            return Ok(-2);
        }
        if not name_ok(name) {
            warn(mut sh, f"Invalid Excel characters in add_table(): '{name}'");
            return Ok(-2);
        }
        if looks_like_cell(name) {
            warn(mut sh, f"Name looks like a cell name in add_table(): '{name}'");
            return Ok(-2);
        }
        if looks_like_rc(name) {
            warn(mut sh, f"Invalid name '{name}' like a RC cell ref in add_table()");
            return Ok(-2);
        }
    }
    t.style = match dget(o, "style") {
        Some(v) => if is_nil(v) { String.new() } else { pystr(v).replace(" ", "") },
        None => "TableStyleMedium9".to_string(),
    };
    let mut first_data = fr;
    let mut last_data = lr;
    if header {
        first_data += 1;
    }
    let total_row = truthy(dget_or(o, "total_row", Val.Nil));
    if total_row {
        last_data -= 1;
    }
    t.range = range_ref(fr, fc, lr, lc);
    let a_range = range_ref(fr, fc, last_data, lc);
    let mut autofilter = truthy(dget_or(o, "autofilter", Val.Nil));
    if not header {
        autofilter = false;
    }
    if autofilter {
        t.autofilter = Some(a_range.clone());
    }
    let user_cols = match dget(o, "columns") {
        Some(Val.List(v)) => Some(v),
        _ => None,
    };
    let mut col_formats: Map[i64, Option[i64]] = Map.new();
    let mut seen: Set[String] = Set.new();
    let mut col_id: i64 = 1;
    for col_num in fc..lc + 1 {
        let mut cd = TCol { id: col_id, name: f"Column{col_id}", total_string: String.new(),
                            total_function: String.new(), custom_total: String.new(),
                            formula: String.new(), format: None };
        let mut name_format: Option[i64] = None;
        if let Some(cols) = user_cols.clone() {
            let user = if col_id <= cols.len() { cols[col_id - 1].clone() } else { Val.Nil };
            if truthy(user) {
                let ud = dict_of(user);
                let xformat = fmt_of(dget_or(ud, "format", Val.Nil));
                let h = dget_or(ud, "header", Val.Nil);
                if truthy(h) {
                    cd.name = pystr(h);
                }
                let lower = cd.name.to_lowercase();
                if seen.contains(lower) {
                    warn(mut sh, f"Duplicate header name in add_table(): '{lower}'");
                    return Ok(-2);
                }
                seen.insert(lower);
                name_format = fmt_of(dget_or(ud, "header_format", Val.Nil));
                let fv = dget_or(ud, "formula", Val.Nil);
                if truthy(fv) {
                    let mut formula = pystr(fv);
                    if formula.starts_with("=") {
                        formula = lstrip_eq(formula);
                    }
                    formula = formula.replace("@", "[#This Row],");
                    cd.formula = prepare_formula(cx.lib, formula, true);
                }
                let tf = dget_or(ud, "total_function", Val.Nil);
                if truthy(tf) {
                    let mut func = pystr(tf);
                    if func == "count_nums" {
                        func = "countNums".to_string();
                    }
                    if func == "std_dev" {
                        func = "stdDev".to_string();
                    }
                    let subtotals = ["average", "countNums", "count", "max", "min", "stdDev",
                                     "sum", "var"];
                    let mut is_sub = false;
                    for s in subtotals.iter() {
                        if *s == func {
                            is_sub = true;
                        }
                    }
                    let formula = if is_sub {
                        table_function_formula(mut sh, func, cd.name)
                    } else {
                        let f = prepare_formula(cx.lib, func, true);
                        cd.custom_total = f.clone();
                        func = "custom".to_string();
                        f
                    };
                    cd.total_function = func;
                    let value = dget_or(ud, "total_value", Val.Int(0));
                    write_formula(mut sh, mut cx, lr, col_num, formula, xformat, value)?;
                } else {
                    let ts = dget_or(ud, "total_string", Val.Nil);
                    if truthy(ts) {
                        cd.total_string = pystr(ts);
                        write_string(mut sh, mut cx, lr, col_num, pystr(ts),
                                     fmt_of(dget_or(ud, "format", Val.Nil)));
                    }
                }
                if let Some(xi) = xformat {
                    cd.format = Some(cx.fm.dxf_index(xi));
                }
                col_formats.insert(col_id - 1, xformat);
            }
        }
        let header_name = cd.name.clone();
        t.columns.push(cd);
        if header {
            write_string(mut sh, mut cx, fr, col_num, header_name, name_format);
        }
        col_id += 1;
    }
    if let Some(Val.List(data)) = dget(o, "data") {
        let mut i: i64 = 0;
        for row in first_data..last_data + 1 {
            let mut j: i64 = 0;
            for col in fc..lc + 1 {
                if i < data.len() {
                    if let Val.List(rowdata) = data[i].clone() {
                        if j < rowdata.len() {
                            let tok = rowdata[j].clone();
                            let f = match col_formats.get(j) {
                                Some(x) => match *x {
                                    Some(xi) => Val.Fmt(xi),
                                    None => Val.Nil,
                                },
                                None => Val.Nil,
                            };
                            write_any(mut sh, mut cx, row, col, [tok, f])?;
                        }
                    }
                }
                j += 1;
            }
            i += 1;
        }
    }
    let mut ci: i64 = 0;
    for col_num in fc..lc + 1 {
        let formula = t.columns[ci].formula.clone();
        if formula.len() > 0 {
            let ff = match col_formats.get(ci) {
                Some(x) => *x,
                None => None,
            };
            for row in first_data..last_data + 1 {
                write_formula(mut sh, mut cx, row, col_num, formula, ff, Val.Int(0))?;
            }
        }
        ci += 1;
    }
    sh.tables.push(t);
    if autofilter {
        for col in fc..lc + 1 {
            sh.filter_cells.insert(key_of(fr, col));
        }
    }
    Ok(0)
}

// ------------------------------------------------------------ filters, panes, pages

fn name_area(sh: ref Sheet, r1: i64, c1: i64, r2: i64, c2: i64) -> String {
    let cc1 = col_name(c1);
    let cc2 = col_name(c2);
    let rr1 = r1 + 1;
    let rr2 = r2 + 1;
    let mut only = false;
    let (a, b) = if r1 == 0 and r2 == 1048575 {
        only = true;
        (f"${cc1}", f"${cc2}")
    } else if c1 == 0 and c2 == 16383 {
        only = true;
        (f"${rr1}", f"${rr2}")
    } else {
        (f"${cc1}${rr1}", f"${cc2}${rr2}")
    };
    let area = if a == b and not only { a } else { f"{a}:{b}" };
    let q = quote_sheet(sh.name);
    f"{q}!{area}"
}

fn autofilter(sh: mut ref Sheet, r1: i64, c1: i64, r2: i64, c2: i64) {
    let (fr, lr) = if r2 < r1 { (r2, r1) } else { (r1, r2) };
    let (fc, lc) = if c2 < c1 { (c2, c1) } else { (c1, c2) };
    sh.autofilter_area = name_area(sh, fr, fc, lr, lc);
    sh.autofilter_ref = range_ref(fr, fc, lr, lc);
    sh.filter_range = (fc, lc);
    for col in fc..lc + 1 {
        sh.filter_cells.insert(key_of(fr, col));
    }
}

fn filter_column_list(sh: mut ref Sheet, colv: ref Val, filters: ref Val) -> Result[(), PyErr] {
    if sh.autofilter_area.len() == 0 {
        warn(mut sh, "Must call autofilter() before filter_column()");
        return Ok(());
    }
    let mut col: i64 = 0;
    match colv {
        Val.Str(t) => {
            let letters = t.clone();
            let (_, c) = cell_to_rowcol(f"{t}1")?;
            col = c;
            if col >= 16384 {
                warn(mut sh, f"Invalid column '{letters}'");
                return Ok(());
            }
        }
        _ => {
            col = as_int(colv);
        }
    }
    let (first, last) = sh.filter_range;
    if col < first or col > last {
        warn(mut sh, f"Column '{col}' outside autofilter() column range ({first},{last})");
        return Ok(());
    }
    let items = match filters {
        Val.List(v) => v.clone(),
        _ => Vec.new(),
    };
    sh.filter_cols.insert(col, items);
    sh.filter_on = true;
    Ok(())
}

fn set_selection(sh: mut ref Sheet, r1: i64, c1: i64, r2: i64, c2: i64) {
    let active = cell_ref(r1, c1);
    let (fr, lr) = if r1 > r2 { (r2, r1) } else { (r1, r2) };
    let (fc, lc) = if c1 > c2 { (c2, c1) } else { (c1, c2) };
    let sqref = range_ref(fr, fc, lr, lc);
    if sqref == "A1" {
        return;
    }
    sh.selections = [(String.new(), active, sqref)];
}

fn encode_password(pw: ref String) -> String {
    let cs: Vec[char] = pw.chars().collect();
    let mut hash: i64 = 0;
    let mut i = cs.len() - 1;
    while i >= 0 {
        hash = ((hash >> 14) & 1) | ((hash << 1) & 32767);
        hash = hash ^ (cs[i] as u32 as i64);
        i -= 1;
    }
    hash = ((hash >> 14) & 1) | ((hash << 1) & 32767);
    hash = hash ^ cs.len();
    hash = hash ^ 52811;
    let digits = "0123456789ABCDEF".to_string();
    let db = digits.bytes();
    let mut out: Vec[u8] = Vec.new();
    if hash == 0 {
        out.push(b'0');
    }
    while hash > 0 {
        out.insert(0, db[hash & 15]);
        hash = hash >> 4;
    }
    from_bytes(out)
}

fn protect(sh: mut ref Sheet, pw: ref Val, options: ref Val) {
    let password = if pystr(pw) != "" { encode_password(pystr(pw)) } else { String.new() };
    let mut d: Vec[(String, Val)] = Vec.new();
    let names = ["sheet", "content", "objects", "scenarios", "format_cells", "format_columns",
                 "format_rows", "insert_columns", "insert_rows", "insert_hyperlinks",
                 "delete_columns", "delete_rows", "select_locked_cells", "sort", "autofilter",
                 "pivot_tables", "select_unlocked_cells"];
    for n in names.iter() {
        let on = *n == "sheet" or *n == "select_locked_cells" or *n == "select_unlocked_cells";
        d.push((n.to_string(), Val.Bool(on)));
    }
    let o = dict_of(options);
    for i in 0..o.len() {
        let (k, v) = o[i].clone();
        if dhas(d, k) {
            dset(mut d, k, v);
        } else {
            warn(mut sh, f"Unknown protection object: '{k}'");
        }
    }
    d.push(("password".to_string(), Val.Str(password)));
    sh.protect_options = d;
}

fn set_header_footer(sh: mut ref Sheet, text0: ref Val, options: ref Val, margin: ref Val,
                     is_header: bool) {
    let what = if is_header { "Header" } else { "Footer" };
    let lower = if is_header { "header" } else { "footer" };
    let orig = pystr(text0);
    let text = orig.replace("&[Picture]", "&G");
    if clen(text) > 255 {
        warn(mut sh, f"{what} string cannot be longer than Excel's limit of 255 characters");
        return;
    }
    let mut o: Vec[(String, Val)] = match options {
        Val.Nil => Vec.new(),
        Val.Dict(d) => d.clone(),
        _ => [("margin".to_string(), options.clone())],
    };
    if not is_nil(margin) {
        dset(mut o, "margin", margin.clone());
    }
    let mut images: i64 = 0;
    for k in ["image_left", "image_center", "image_right"].iter() {
        if truthy(dget_or(o, *k, Val.Nil)) {
            images += 1;
        }
    }
    let placeholders = count_sub(text, "&G");
    if placeholders != images {
        warn(mut sh, f"Number of {lower} images ({images}) doesn't match placeholder count ({placeholders}) in string: {orig}");
        return;
    }
    if let Some(v) = dget(o, "align_with_margins") {
        sh.header_footer_aligns = v;
    }
    if let Some(v) = dget(o, "scale_with_doc") {
        sh.header_footer_scales = v;
    }
    let m = dget_or(o, "margin", Val.Float(0.3));
    if is_header {
        sh.header = text;
        sh.margin_header = m;
    } else {
        sh.footer = text;
        sh.margin_footer = m;
    }
    sh.header_footer_changed = true;
}

fn count_sub(t: ref String, pat: Str) -> i64 {
    let mut n: i64 = 0;
    let mut rest = t.clone();
    loop {
        match rest.find(pat) {
            Some(p) => {
                n += 1;
                rest = rest.substring(p + pat.len());
            }
            None => break,
        }
    }
    n
}

fn repeat_columns(sh: mut ref Sheet, c1: i64, c2v: ref Val) {
    let c2 = if is_nil(c2v) { c1 } else { as_int(c2v) };
    let a = col_name(c1);
    let b = col_name(c2);
    let q = quote_sheet(sh.name);
    sh.repeat_col_range = f"{q}!${a}:${b}";
}

fn repeat_rows(sh: mut ref Sheet, r1: i64, r2v: ref Val) {
    let r2 = if is_nil(r2v) { r1 } else { as_int(r2v) };
    let a = r1 + 1;
    let b = r2 + 1;
    let q = quote_sheet(sh.name);
    sh.repeat_row_range = f"{q}!${a}:${b}";
}

// ------------------------------------------------------------ worksheet xml

fn add_s(a: mut ref Attrs, k: Str, v: Str) {
    a.add(k, v.to_string());
}

fn col_info_xml(out: mut ref String, fm: mut ref Formats, c1: i64, c2: i64, ci: ref ColInfo) {
    let mut custom = true;
    let mut xf: i64 = 0;
    if let Some(i) = ci.fmt {
        xf = fm.xf_index(i);
    }
    let mut width: f64 = 0.0;
    if is_nil(ci.width) {
        if not truthy(ci.hidden) {
            width = 8.43;
            custom = false;
        }
    } else {
        width = num(ci.width);
        if width == 8.43 {
            custom = false;
        }
    }
    let mut wtext = String.new();
    if width > 0.0 {
        if width < 1.0 {
            width = (((width * 12.0 + 0.5) as i64) as f64 / 7.0 * 256.0) as i64 as f64 / 256.0;
        } else {
            width = (((((width * 7.0 + 0.5) as i64) + 5) as f64) / 7.0 * 256.0) as i64 as f64 / 256.0;
        }
        wtext = fmt_g(width, 16, false);
    } else if is_nil(ci.width) or not is_num(ci.width) {
        wtext = fmt_g(0.0, 16, false);
    } else {
        wtext = fmt_g(num(ci.width), 16, false);
    }
    let mut a = attrs();
    a.addi("min", c1 + 1);
    a.addi("max", c2 + 1);
    a.add("width", wtext);
    if xf != 0 {
        a.addi("style", xf);
    }
    if truthy(ci.hidden) {
        a.add("hidden", "1");
    }
    if ci.autofit {
        a.add("bestFit", "1");
    }
    if custom {
        a.add("customWidth", "1");
    }
    if truthy(ci.level) {
        a.addv("outlineLevel", ci.level);
    }
    if truthy(ci.collapsed) {
        a.add("collapsed", "1");
    }
    empty(mut out, "col", a);
}

fn cols_xml(out: mut ref String, sh: ref Sheet, fm: mut ref Formats) {
    if sh.col_info.len() == 0 {
        return;
    }
    start0(mut out, "cols");
    let mut first: i64 = -1;
    let mut last: i64 = -1;
    let mut prev: Option[ColInfo] = None;
    for (c, ci) in sh.col_info.iter() {
        let col = *c;
        match prev.clone() {
            None => {
                first = col;
                last = col;
                prev = Some(ci.clone());
            }
            Some(p) => {
                if col == last + 1 and col_eq(ci, p) {
                    last = col;
                } else {
                    col_info_xml(mut out, mut fm, first, last, p);
                    first = col;
                    last = col;
                    prev = Some(ci.clone());
                }
            }
        }
    }
    if let Some(p) = prev {
        col_info_xml(mut out, mut fm, first, last, p);
    }
    end(mut out, "cols");
}

fn row_start(out: mut ref String, sh: ref Sheet, fm: mut ref Formats, row: i64, spans: ref String,
             props: ref Option[RowInfo], empty_row: bool) {
    let (height, fmt, hidden, level, collapsed) = match props {
        Some(p) => (p.height.clone(), p.fmt, p.hidden.clone(), p.level.clone(), p.collapsed.clone()),
        None => (sh.default_row_height.clone(), None, Val.Int(0), Val.Int(0), Val.Int(0)),
    };
    let mut a = attrs();
    a.addi("r", row + 1);
    let mut xf: i64 = 0;
    if let Some(i) = fmt {
        xf = fm.xf_index(i);
    }
    if spans.len() > 0 {
        a.add("spans", spans);
    }
    if xf != 0 {
        a.addi("s", xf);
    }
    if fmt.is_some() {
        add_s(mut a, "customFormat", "1");
    }
    let changed = num(height) != 15.0;
    if changed {
        a.add("ht", fmt_g(num(height), 6, false));
    }
    if truthy(hidden) {
        add_s(mut a, "hidden", "1");
    }
    if changed {
        add_s(mut a, "customHeight", "1");
    }
    if truthy(level) {
        a.addv("outlineLevel", level);
    }
    if truthy(collapsed) {
        add_s(mut a, "collapsed", "1");
    }
    out.push_str("<row");
    out.push_str(attr_text(a, false));
    out.push_str(if empty_row { "/>" } else { ">" });
}

fn is_error_code(t: ref String) -> bool {
    t == "#DIV/0!" or t == "#N/A" or t == "#NAME?" or t == "#NULL!" or t == "#NUM!" or t == "#REF!"
        or t == "#VALUE!"
}

fn cell_xml(out: mut ref String, sh: ref Sheet, fm: mut ref Formats, row: i64, col: i64,
            cell: ref Cell) {
    let mut a = attrs();
    a.add("r", cell_ref(row, col));
    let row_fmt = match sh.set_rows.get(row) {
        Some(ri) => ri.fmt,
        None => None,
    };
    if let Some(i) = cell_fmt(cell) {
        a.addi("s", fm.xf_index(i));
    } else if let Some(i) = row_fmt {
        a.addi("s", fm.xf_index(i));
    } else if let Some(ci) = sh.col_info.get(col) {
        if let Some(i) = ci.fmt {
            a.addi("s", fm.xf_index(i));
        }
    }
    match cell {
        Cell.Num(n, _) => {
            out.push_str("<c");
            out.push_str(attr_text(a, true));
            out.push_str("><v>");
            out.push_str(num_text(n));
            out.push_str("</v></c>");
        }
        Cell.Date(x, _) => {
            out.push_str("<c");
            out.push_str(attr_text(a, true));
            out.push_str("><v>");
            out.push_str(fmt_g(x, 16, true));
            out.push_str("</v></c>");
        }
        Cell.Str(i, _) => {
            out.push_str("<c");
            out.push_str(attr_text(a, true));
            out.push_str(f" t=\"s\"><v>{i}</v></c>");
        }
        Cell.Rich(i, _, _) => {
            out.push_str("<c");
            out.push_str(attr_text(a, true));
            out.push_str(f" t=\"s\"><v>{i}</v></c>");
        }
        Cell.Formula(f, _, v) => {
            let mut value = pystr(v);
            match v {
                Val.Bool(b) => {
                    a.add("t", "b");
                    value = if b { "1".to_string() } else { "0".to_string() };
                }
                Val.Str(t) => {
                    if t.len() == 0 {
                        // nothing
                    } else if is_error_code(t) {
                        a.add("t", "e");
                    } else {
                        a.add("t", "str");
                    }
                }
                _ => {}
            }
            out.push_str("<c");
            out.push_str(attr_text(a, true));
            out.push_str("><f>");
            out.push_str(esc_data(f));
            out.push_str("</f><v>");
            out.push_str(esc_data(value));
            out.push_str("</v></c>");
        }
        Cell.Array(f, _, v, range, dynamic) => {
            if dynamic {
                a.add("cm", "1");
            }
            let numeric = match v {
                Val.Str(t) => py_float(t).is_some(),
                _ => true,
            };
            if not numeric {
                a.add("t", "str");
            }
            start(mut out, "c", a);
            let mut fa = attrs();
            fa.add("t", "array");
            fa.add("ref", range);
            data_el(mut out, "f", f, fa);
            let value = if is_nil(v) { String.new() } else { pystr(v) };
            data0(mut out, "v", value);
            end(mut out, "c");
        }
        Cell.Blank(_) => {
            empty(mut out, "c", a);
        }
        Cell.Bool(b, _) => {
            a.add("t", "b");
            start(mut out, "c", a);
            data0(mut out, "v", f"{b}");
            end(mut out, "c");
        }
    }
}

fn sheet_data_xml(out: mut ref String, sh: ref Sheet, fm: mut ref Formats) {
    if sh.dim_rowmin < 0 {
        empty0(mut out, "sheetData");
        return;
    }
    start0(mut out, "sheetData");
    // _calculate_spans(): the column span of each block of 16 rows.
    let mut spans: Map[i64, (i64, i64)] = Map.new();
    let mut rows: SortedMap[i64, bool] = SortedMap.new();
    for (k, _) in sh.table.iter() {
        let row = *k / 16384;
        let col = *k % 16384;
        rows.insert(row, true);
        let b = row / 16;
        let (lo, hi) = match spans.get(b) {
            Some(p) => *p,
            None => (col, col),
        };
        spans.insert(b, (if col < lo { col } else { lo }, if col > hi { col } else { hi }));
    }
    for (r, _) in sh.set_rows.iter() {
        if rows.get(*r).is_none() {
            rows.insert(*r, false);
        }
    }
    let mut cells: Vec[(i64, Cell)] = Vec.new();
    for (k, c) in sh.table.iter() {
        cells.push((*k, c.clone()));
    }
    let mut ci: i64 = 0;
    for (r, has) in rows.iter() {
        let row = *r;
        if row < sh.dim_rowmin or row > sh.dim_rowmax {
            continue;
        }
        let span = match spans.get(row / 16) {
            Some(p) => {
                let (lo, hi) = *p;
                let a = lo + 1;
                let b = hi + 1;
                f"{a}:{b}"
            }
            None => String.new(),
        };
        let props = match sh.set_rows.get(row) {
            Some(p) => Some(p.clone()),
            None => None,
        };
        if *has {
            row_start(mut out, sh, mut fm, row, span, props, false);
            while ci < cells.len() and cells[ci].0 / 16384 == row {
                let (k, c) = cells[ci].clone();
                cell_xml(mut out, sh, mut fm, row, k % 16384, c);
                ci += 1;
            }
            end(mut out, "row");
        } else {
            row_start(mut out, sh, mut fm, row, span, props, true);
        }
    }
    end(mut out, "sheetData");
}

fn selection_xml(out: mut ref String, sel: ref (String, String, String)) {
    let (pane, active, sqref) = sel.clone();
    let mut a = attrs();
    if pane.len() > 0 {
        a.add("pane", pane);
    }
    if active.len() > 0 {
        a.add("activeCell", active);
    }
    if sqref.len() > 0 {
        a.add("sqref", sqref);
    }
    empty(mut out, "selection", a);
}

fn x_split_width(w: f64) -> f64 {
    let pixels = if w < 1.0 { (w * 12.0 + 0.5) as i64 } else { ((w * 7.0 + 0.5) as i64) + 5 };
    let points = (pixels as f64) * 3.0 / 4.0;
    points * 20.0 + 390.0
}

fn panes_xml(out: mut ref String, sh: mut ref Sheet) {
    if sh.panes.len() == 0 {
        return;
    }
    let row = sh.panes[0];
    let col = sh.panes[1];
    let mut top_row = sh.panes[2];
    let mut left_col = sh.panes[3];
    let pane_type = sh.panes[4];
    let mut active_cell = String.new();
    let mut sqref = String.new();
    let mut has_sel = false;
    if sh.selections.len() > 0 {
        let (_, ac, sq) = sh.selections[0].clone();
        active_cell = ac;
        sqref = sq;
        sh.selections = Vec.new();
        has_sel = true;
    }
    let mut a = attrs();
    if pane_type == 2 {
        let mut y = row as f64;
        let mut x = col as f64;
        if row != 0 {
            y = ((20 * row + 300) as i64) as f64;
        }
        if col != 0 {
            x = x_split_width(col as f64);
        }
        if top_row == row and left_col == col {
            top_row = (0.5 + (y - 300.0) / 20.0 / 15.0) as i64;
            left_col = (0.5 + (x - 390.0) / 20.0 / 3.0 * 4.0 / 64.0) as i64;
        }
        let tl = cell_ref(top_row, left_col);
        if not has_sel {
            active_cell = tl.clone();
            sqref = tl.clone();
        }
        let active_pane = pane_selections(mut sh, row, col, top_row, left_col, active_cell, sqref);
        if col != 0 {
            a.add("xSplit", fmt_g(x, 16, false));
        }
        if row != 0 {
            a.add("ySplit", fmt_g(y, 16, false));
        }
        a.add("topLeftCell", tl);
        if has_sel {
            a.add("activePane", active_pane);
        }
    } else {
        let tl = cell_ref(top_row, left_col);
        let active_pane = pane_selections(mut sh, row, col, row, col, active_cell, sqref);
        if col != 0 {
            a.addi("xSplit", col);
        }
        if row != 0 {
            a.addi("ySplit", row);
        }
        a.add("topLeftCell", tl);
        a.add("activePane", active_pane);
        a.add("state", if pane_type == 0 { "frozen" } else if pane_type == 1 { "frozenSplit" } else { "split" });
    }
    empty(mut out, "pane", a);
}

// The selections a pane leaves, and its active pane. The cells named for
// the top-right and bottom-left panes are (0, c) and (r, 0).
fn pane_selections(sh: mut ref Sheet, row: i64, col: i64, r: i64, c: i64, active: ref String,
                   sqref: ref String) -> String {
    if row != 0 and col != 0 {
        let row_cell = cell_ref(r, 0);
        let col_cell = cell_ref(0, c);
        sh.selections.push(("topRight".to_string(), col_cell.clone(), col_cell));
        sh.selections.push(("bottomLeft".to_string(), row_cell.clone(), row_cell));
        sh.selections.push(("bottomRight".to_string(), active.clone(), sqref.clone()));
        "bottomRight".to_string()
    } else if col != 0 {
        sh.selections.push(("topRight".to_string(), active.clone(), sqref.clone()));
        "topRight".to_string()
    } else {
        sh.selections.push(("bottomLeft".to_string(), active.clone(), sqref.clone()));
        "bottomLeft".to_string()
    }
}

fn sheet_view_xml(out: mut ref String, sh: mut ref Sheet) {
    let mut a = attrs();
    if not sh.screen_gridlines {
        a.add("showGridLines", "0");
    }
    if sh.row_col_headers {
        a.add("showRowColHeaders", "0");
    }
    if not sh.show_zeros {
        a.add("showZeros", "0");
    }
    if sh.is_right_to_left {
        a.add("rightToLeft", "1");
    }
    if sh.selected != 0 {
        a.add("tabSelected", "1");
    }
    if not truthy(sh.outline_on) {
        a.add("showOutlineSymbols", "0");
    }
    if sh.page_view == 1 {
        a.add("view", "pageLayout");
    } else if sh.page_view == 2 {
        a.add("view", "pageBreakPreview");
    }
    if sh.top_left_cell.len() > 0 {
        a.add("topLeftCell", sh.top_left_cell);
    }
    if sh.zoom != 100 {
        a.addi("zoomScale", sh.zoom);
        if sh.page_view == 0 {
            a.addi("zoomScaleNormal", sh.zoom);
        }
        if sh.page_view == 1 {
            a.addi("zoomScalePageLayoutView", sh.zoom);
        }
        if sh.page_view == 2 {
            a.addi("zoomScaleSheetLayoutView", sh.zoom);
        }
    }
    a.add("workbookViewId", "0");
    if sh.panes.len() > 0 or sh.selections.len() > 0 {
        start(mut out, "sheetView", a);
        panes_xml(mut out, mut sh);
        let sels = sh.selections.clone();
        for s in sels.iter() {
            selection_xml(mut out, s);
        }
        end(mut out, "sheetView");
    } else {
        empty(mut out, "sheetView", a);
    }
}

fn protection_xml(out: mut ref String, sh: ref Sheet) {
    if sh.protect_options.len() == 0 {
        return;
    }
    let o = sh.protect_options.clone();
    let on = |k: Str| truthy(dget_or(o, k, Val.Nil));
    let mut a = attrs();
    if on("password") {
        a.add("password", dict_get_str(o, "password"));
    }
    if on("sheet") {
        a.add("sheet", "1");
    }
    if on("content") {
        a.add("content", "1");
    }
    if not on("objects") {
        a.add("objects", "1");
    }
    if not on("scenarios") {
        a.add("scenarios", "1");
    }
    let zeros = [("format_cells", "formatCells"), ("format_columns", "formatColumns"),
                 ("format_rows", "formatRows"), ("insert_columns", "insertColumns"),
                 ("insert_rows", "insertRows"), ("insert_hyperlinks", "insertHyperlinks"),
                 ("delete_columns", "deleteColumns"), ("delete_rows", "deleteRows")];
    for z in zeros.iter() {
        let (k, name) = z.clone();
        if on(k) {
            a.add(name, "0");
        }
    }
    if not on("select_locked_cells") {
        a.add("selectLockedCells", "1");
    }
    if on("sort") {
        a.add("sort", "0");
    }
    if on("autofilter") {
        a.add("autoFilter", "0");
    }
    if on("pivot_tables") {
        a.add("pivotTables", "0");
    }
    if not on("select_unlocked_cells") {
        a.add("selectUnlockedCells", "1");
    }
    empty(mut out, "sheetProtection", a);
}

fn sort_strings(v: mut ref Vec[String]) {
    let n = v.len();
    for i in 1..n {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
    }
}

fn autofilter_xml(out: mut ref String, sh: ref Sheet) {
    if sh.autofilter_ref.len() == 0 {
        return;
    }
    let mut a = attrs();
    a.add("ref", sh.autofilter_ref);
    if not sh.filter_on {
        empty(mut out, "autoFilter", a);
        return;
    }
    start(mut out, "autoFilter", a);
    let (c1, c2) = sh.filter_range;
    for col in c1..c2 + 1 {
        if let Some(filters) = sh.filter_cols.get(col) {
            let mut fa = attrs();
            fa.addi("colId", col - c1);
            start(mut out, "filterColumn", fa);
            let mut non_blanks: Vec[String] = Vec.new();
            for f in filters.iter() {
                if pystr(f).to_lowercase() != "blanks" {
                    non_blanks.push(pystr(f));
                }
            }
            let mut ba = attrs();
            if filters.len() != non_blanks.len() {
                ba.add("blank", "1");
            }
            if filters.len() == 1 and non_blanks.len() == 0 {
                empty(mut out, "filters", ba);
            } else {
                start(mut out, "filters", ba);
                sort_strings(mut non_blanks);
                for f in non_blanks.iter() {
                    empty1(mut out, "filter", "val", f);
                }
                end(mut out, "filters");
            }
            end(mut out, "filterColumn");
        }
    }
    end(mut out, "autoFilter");
}

fn formula_text(v: ref Val, is_first: bool) -> String {
    if is_first {
        if let Val.List(items) = v {
            let j = csv_join(items);
            return f"\"{j}\"";
        }
    }
    match v {
        Val.Str(t) => {
            if py_float(t).is_none() and t.starts_with("=") {
                lstrip_eq(t)
            } else {
                t.clone()
            }
        }
        _ => pystr(v),
    }
}

fn validation_xml(out: mut ref String, v: ref Valid) {
    let o = v.opts.clone();
    let mut sqref = String.new();
    for c in v.cells.iter() {
        let (r1, c1, r2, c2) = *c;
        if sqref.len() > 0 {
            sqref.push_str(" ");
        }
        let (fr, lr) = if r1 > r2 { (r2, r1) } else { (r1, r2) };
        let (fc, lc) = if c1 > c2 { (c2, c1) } else { (c1, c2) };
        sqref.push_str(range_ref(fr, fc, lr, lc));
    }
    if truthy(dget_or(o, "multi_range", Val.Nil)) {
        sqref = dict_get_str(o, "multi_range");
    }
    let vt = dict_get_str(o, "validate");
    let ct = dict_get_str(o, "criteria");
    let mut a = attrs();
    if vt != "none" {
        a.add("type", vt);
        if ct != "between" {
            a.add("operator", ct);
        }
    }
    let et = as_int(dget_or(o, "error_type", Val.Int(0)));
    if et == 1 {
        a.add("errorStyle", "warning");
    }
    if et == 2 {
        a.add("errorStyle", "information");
    }
    if truthy(dget_or(o, "ignore_blank", Val.Nil)) {
        a.add("allowBlank", "1");
    }
    if not truthy(dget_or(o, "dropdown", Val.Nil)) {
        a.add("showDropDown", "1");
    }
    if truthy(dget_or(o, "show_input", Val.Nil)) {
        a.add("showInputMessage", "1");
    }
    if truthy(dget_or(o, "show_error", Val.Nil)) {
        a.add("showErrorMessage", "1");
    }
    let texts = [("error_title", "errorTitle"), ("error_message", "error"),
                 ("input_title", "promptTitle"), ("input_message", "prompt")];
    for t in texts.iter() {
        let (k, name) = t.clone();
        if dhas(o, k) {
            a.add(name, dict_get_str(o, k));
        }
    }
    a.add("sqref", sqref);
    if vt == "none" {
        empty(mut out, "dataValidation", a);
        return;
    }
    start(mut out, "dataValidation", a);
    data0(mut out, "formula1", formula_text(dget_or(o, "value", Val.Nil), true));
    let mx = dget_or(o, "maximum", Val.Nil);
    if not is_nil(mx) {
        data0(mut out, "formula2", formula_text(mx, false));
    }
    end(mut out, "dataValidation");
}

fn hyperlinks_xml(out: mut ref String, sh: mut ref Sheet) {
    if sh.hyperlinks.len() == 0 {
        return;
    }
    let mut display: Option[String] = None;
    let mut refs: Vec[(Link, i64, i64, i64, Option[String])] = Vec.new();
    let links: Vec[(i64, Link)] = sh.hyperlinks.iter().map(|(k, l)| (*k, l.clone())).collect();
    for kl in links.iter() {
        let (k, link) = kl.clone();
        if let Some(c) = sh.table.get(k) {
            match c {
                Cell.Str(_, _) => {}
                _ => {
                    display = Some(link.url.clone());
                }
            }
        }
        let mut rid: i64 = 0;
        if link.link_type == 1 {
            sh.rel_count += 1;
            rid = sh.rel_count;
            sh.external_hyper_links.push(("/hyperlink".to_string(), link.url.clone(),
                                          "External".to_string()));
        }
        refs.push((link, k / 16384, k % 16384, rid, display.clone()));
    }
    start0(mut out, "hyperlinks");
    for r in refs.iter() {
        let (link, row, col, rid, disp) = r.clone();
        let mut a = attrs();
        a.add("ref", cell_ref(row, col));
        if link.link_type == 1 {
            a.add("r:id", f"rId{rid}");
            if let Some(loc) = link.anchor.clone() {
                a.add("location", loc);
            }
            if let Some(d) = disp {
                a.add("display", d);
            }
            if not is_nil(link.tip) {
                a.addv("tooltip", link.tip);
            }
        } else {
            // _write_hyperlink_internal(row, col, url, str, tip): the
            // location is the url and the display the link's string.
            let _ = disp;
            a.add("location", link.url);
            if not is_nil(link.tip) {
                a.addv("tooltip", link.tip);
            }
            a.add("display", match link.anchor.clone() {
                Some(d) => d,
                None => "None".to_string(),
            });
        }
        empty(mut out, "hyperlink", a);
    }
    end(mut out, "hyperlinks");
}

fn sorted_breaks(v: ref Vec[Val]) -> Vec[i64] {
    let mut s: SortedMap[i64, bool] = SortedMap.new();
    for b in v.iter() {
        let n = as_int(b);
        if n != 0 {
            s.insert(n, true);
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for (k, _) in s.iter() {
        if out.len() < 1023 {
            out.push(*k);
        }
    }
    out
}

fn breaks_xml(out: mut ref String, tag: Str, v: ref Vec[Val], max: i64) {
    let b = sorted_breaks(v);
    if b.len() == 0 {
        return;
    }
    let mut a = attrs();
    a.addi("count", b.len());
    a.addi("manualBreakCount", b.len());
    start(mut out, tag, a);
    for n in b.iter() {
        let mut ba = attrs();
        ba.addi("id", *n);
        ba.addi("max", max);
        ba.add("man", "1");
        empty(mut out, "brk", ba);
    }
    end(mut out, tag);
}

fn page_xml(out: mut ref String, sh: ref Sheet) {
    if sh.print_options_changed {
        let mut a = attrs();
        if sh.hcenter {
            a.add("horizontalCentered", "1");
        }
        if sh.vcenter {
            a.add("verticalCentered", "1");
        }
        if sh.print_headers {
            a.add("headings", "1");
        }
        if sh.print_gridlines {
            a.add("gridLines", "1");
        }
        empty(mut out, "printOptions", a);
    }
    let mut m = attrs();
    m.addv("left", sh.margin_left);
    m.addv("right", sh.margin_right);
    m.addv("top", sh.margin_top);
    m.addv("bottom", sh.margin_bottom);
    m.addv("header", sh.margin_header);
    m.addv("footer", sh.margin_footer);
    empty(mut out, "pageMargins", m);
    if sh.page_setup_changed {
        let mut a = attrs();
        if truthy(sh.paper_size) {
            a.addv("paperSize", sh.paper_size);
        }
        if sh.print_scale != 100 {
            a.addi("scale", sh.print_scale);
        }
        if sh.fit_page and not eq_int(sh.fit_width, 1) {
            a.addv("fitToWidth", sh.fit_width);
        }
        if sh.fit_page and not eq_int(sh.fit_height, 1) {
            a.addv("fitToHeight", sh.fit_height);
        }
        if sh.page_order != 0 {
            a.add("pageOrder", "overThenDown");
        }
        if num(sh.page_start) > 1.0 {
            a.addv("firstPageNumber", sh.page_start);
        }
        a.add("orientation", if sh.orientation != 0 { "portrait" } else { "landscape" });
        if sh.black_white {
            a.add("blackAndWhite", "1");
        }
        if not eq_int(sh.page_start, 0) {
            a.add("useFirstPageNumber", "1");
        }
        empty(mut out, "pageSetup", a);
    }
    let mut h = attrs();
    if not truthy(sh.header_footer_scales) {
        h.add("scaleWithDoc", "0");
    }
    if not truthy(sh.header_footer_aligns) {
        h.add("alignWithMargins", "0");
    }
    if sh.header_footer_changed {
        start(mut out, "headerFooter", h);
        if sh.header.len() > 0 {
            data0(mut out, "oddHeader", sh.header);
        }
        if sh.footer.len() > 0 {
            data0(mut out, "oddFooter", sh.footer);
        }
        end(mut out, "headerFooter");
    }
    breaks_xml(mut out, "rowBreaks", sh.hbreaks, 16383);
    breaks_xml(mut out, "colBreaks", sh.vbreaks, 1048575);
}

fn dimension_ref(sh: ref Sheet) -> String {
    if sh.dim_rowmin < 0 and sh.dim_colmin < 0 {
        "A1".to_string()
    } else if sh.dim_rowmin < 0 {
        if sh.dim_colmin == sh.dim_colmax {
            cell_ref(0, sh.dim_colmin)
        } else {
            let a = cell_ref(0, sh.dim_colmin);
            let b = cell_ref(0, sh.dim_colmax);
            f"{a}:{b}"
        }
    } else if sh.dim_rowmin == sh.dim_rowmax and sh.dim_colmin == sh.dim_colmax {
        cell_ref(sh.dim_rowmin, sh.dim_colmin)
    } else {
        let a = cell_ref(sh.dim_rowmin, sh.dim_colmin);
        let b = cell_ref(sh.dim_rowmax, sh.dim_colmax);
        f"{a}:{b}"
    }
}

fn sheet_xml(sh: mut ref Sheet, fm: mut ref Formats) -> String {
    let mut out = String.new();
    decl(mut out);
    let mut wa = attrs();
    wa.add("xmlns", "http://schemas.openxmlformats.org/spreadsheetml/2006/main");
    wa.add("xmlns:r", "http://schemas.openxmlformats.org/officeDocument/2006/relationships");
    start(mut out, "worksheet", wa);
    // sheetPr
    if sh.fit_page or sh.filter_on or sh.tab_color.len() > 0 or sh.outline_changed {
        let mut a = attrs();
        if sh.filter_on {
            a.add("filterMode", "1");
        }
        if sh.fit_page or sh.tab_color.len() > 0 or sh.outline_changed {
            start(mut out, "sheetPr", a);
            if sh.tab_color.len() > 0 {
                empty1(mut out, "tabColor", "rgb", sh.tab_color);
            }
            if sh.outline_changed {
                let mut oa = attrs();
                if truthy(sh.outline_style) {
                    oa.add("applyStyles", "1");
                }
                if not truthy(sh.outline_below) {
                    oa.add("summaryBelow", "0");
                }
                if not truthy(sh.outline_right) {
                    oa.add("summaryRight", "0");
                }
                if not truthy(sh.outline_on) {
                    oa.add("showOutlineSymbols", "0");
                }
                empty(mut out, "outlinePr", oa);
            }
            if sh.fit_page {
                empty1(mut out, "pageSetUpPr", "fitToPage", "1");
            }
            end(mut out, "sheetPr");
        } else {
            empty(mut out, "sheetPr", a);
        }
    }
    empty1(mut out, "dimension", "ref", dimension_ref(sh));
    start0(mut out, "sheetViews");
    sheet_view_xml(mut out, mut sh);
    end(mut out, "sheetViews");
    let mut fa = attrs();
    fa.addv("defaultRowHeight", sh.default_row_height);
    if num(sh.default_row_height) != 15.0 {
        fa.add("customHeight", "1");
    }
    if sh.default_row_zeroed {
        fa.add("zeroHeight", "1");
    }
    if sh.outline_row_level != 0 {
        fa.addi("outlineLevelRow", sh.outline_row_level);
    }
    if sh.outline_col_level != 0 {
        fa.addi("outlineLevelCol", sh.outline_col_level);
    }
    empty(mut out, "sheetFormatPr", fa);
    cols_xml(mut out, sh, mut fm);
    sheet_data_xml(mut out, sh, mut fm);
    protection_xml(mut out, sh);
    if sh.protected_ranges.len() > 0 {
        start0(mut out, "protectedRanges");
        for pr in sh.protected_ranges.iter() {
            let (range, name, pw) = pr.clone();
            let mut a = attrs();
            if pw.len() > 0 {
                a.add("password", pw);
            }
            a.add("sqref", range);
            a.add("name", name);
            empty(mut out, "protectedRange", a);
        }
        end(mut out, "protectedRanges");
    }
    autofilter_xml(mut out, sh);
    if sh.merge.len() > 0 {
        let mut a = attrs();
        a.addi("count", sh.merge.len());
        start(mut out, "mergeCells", a);
        for m in sh.merge.iter() {
            let (r1, c1, r2, c2) = *m;
            let a1 = cell_ref(r1, c1);
            let b1 = cell_ref(r2, c2);
            empty1(mut out, "mergeCell", "ref", f"{a1}:{b1}");
        }
        end(mut out, "mergeCells");
    }
    if sh.validations.len() > 0 {
        let mut a = attrs();
        a.addi("count", sh.validations.len());
        start(mut out, "dataValidations", a);
        for v in sh.validations.iter() {
            validation_xml(mut out, v);
        }
        end(mut out, "dataValidations");
    }
    hyperlinks_xml(mut out, mut sh);
    page_xml(mut out, sh);
    if sh.tables.len() > 0 {
        let mut a = attrs();
        a.addi("count", sh.tables.len());
        start(mut out, "tableParts", a);
        for _ in 0..sh.tables.len() {
            sh.rel_count += 1;
            let r = sh.rel_count;
            empty1(mut out, "tablePart", "r:id", f"rId{r}");
        }
        end(mut out, "tableParts");
    }
    end(mut out, "worksheet");
    out
}

// ------------------------------------------------------------ tables part

fn table_xml(t: ref Table) -> String {
    let mut out = String.new();
    decl(mut out);
    let mut a = attrs();
    a.add("xmlns", "http://schemas.openxmlformats.org/spreadsheetml/2006/main");
    a.addi("id", t.id);
    let name = match t.name.clone() {
        Some(n) => n,
        None => String.new(),
    };
    a.add("name", name);
    a.add("displayName", name);
    a.add("ref", t.range);
    if not truthy(t.header_row_count) {
        a.add("headerRowCount", "0");
    }
    if truthy(t.totals_row_shown) {
        a.add("totalsRowCount", "1");
    } else {
        a.add("totalsRowShown", "0");
    }
    start(mut out, "table", a);
    if let Some(af) = t.autofilter.clone() {
        empty1(mut out, "autoFilter", "ref", af);
    }
    let mut ca = attrs();
    ca.addi("count", t.columns.len());
    start(mut out, "tableColumns", ca);
    for c in t.columns.iter() {
        let mut a = attrs();
        a.addi("id", c.id);
        a.add("name", c.name);
        if c.total_string.len() > 0 {
            a.add("totalsRowLabel", c.total_string);
        } else if c.total_function.len() > 0 {
            a.add("totalsRowFunction", c.total_function);
        }
        if let Some(d) = c.format {
            a.addi("dataDxfId", d);
        }
        if c.formula.len() > 0 or c.custom_total.len() > 0 {
            start(mut out, "tableColumn", a);
            if c.formula.len() > 0 {
                data0(mut out, "calculatedColumnFormula", c.formula);
            }
            if c.custom_total.len() > 0 {
                data0(mut out, "totalsRowFormula", c.custom_total);
            }
            end(mut out, "tableColumn");
        } else {
            empty(mut out, "tableColumn", a);
        }
    }
    end(mut out, "tableColumns");
    let mut sa = attrs();
    if t.style.len() > 0 and t.style != "None" {
        sa.add("name", t.style);
    }
    sa.addi("showFirstColumn", as_int(t.show_first_col));
    sa.addi("showLastColumn", as_int(t.show_last_col));
    sa.addi("showRowStripes", as_int(t.show_row_stripes));
    sa.addi("showColumnStripes", as_int(t.show_col_stripes));
    empty(mut out, "tableStyleInfo", sa);
    end(mut out, "table");
    out
}

// ------------------------------------------------------------ workbook

struct Wb {
    strings_to_numbers: bool,
    strings_to_formulas: bool,
    strings_to_urls: bool,
    nan_inf_to_errors: bool,
    use_future_functions: bool,
    default_date_format: Option[i64],
    default_format_properties: Vec[(String, Val)],
    max_url_length: i64,
    sheetname_count: i64,
    defined_names: Vec[(String, i64, String, bool)],
    named_ranges: Vec[String],
    doc_properties: Vec[(String, Val)],
    window_width: i64,
    window_height: i64,
    tab_ratio: i64,
    calc_mode: String,
    calc_on_load: bool,
    calc_id: Val,
    read_only: i64,
    has_metadata: bool,
    warns: Vec[String],
}

fn new_book(options: ref Vec[(String, Val)], cx: mut ref Ctx) -> Result[Wb, PyErr] {
    let mut max_url = as_int(dget_or(options, "max_url_length", Val.Int(2079)));
    if max_url < 255 {
        max_url = 2079;
    }
    let mut wb = Wb {
        strings_to_numbers: truthy(dget_or(options, "strings_to_numbers", Val.Bool(false))),
        strings_to_formulas: truthy(dget_or(options, "strings_to_formulas", Val.Bool(true))),
        strings_to_urls: truthy(dget_or(options, "strings_to_urls", Val.Bool(true))),
        nan_inf_to_errors: truthy(dget_or(options, "nan_inf_to_errors", Val.Bool(false))),
        use_future_functions: truthy(dget_or(options, "use_future_functions", Val.Bool(false))),
        default_date_format: None,
        default_format_properties: dict_of(dget_or(options, "default_format_properties", Val.Nil)),
        max_url_length: max_url, sheetname_count: 0, defined_names: Vec.new(),
        named_ranges: Vec.new(), doc_properties: Vec.new(), window_width: 16095,
        window_height: 9660, tab_ratio: 600, calc_mode: "auto".to_string(), calc_on_load: true,
        calc_id: Val.Int(124519), read_only: 0, has_metadata: false, warns: Vec.new(),
    };
    add_format(mut wb, mut cx, [("xf_index".to_string(), Val.Int(0))])?;
    add_format(mut wb, mut cx, [("hyperlink".to_string(), Val.Bool(true))])?;
    let ddf = dget_or(options, "default_date_format", Val.Nil);
    if not is_nil(ddf) {
        let i = add_format(mut wb, mut cx, [("num_format".to_string(), ddf)])?;
        wb.default_date_format = Some(i);
    }
    Ok(wb)
}

fn add_format(wb: mut ref Wb, cx: mut ref Ctx, props: ref Vec[(String, Val)]) -> Result[i64, PyErr] {
    cx.fm.add(wb.default_format_properties, props)
}

fn has_invalid_sheet_char(t: ref String) -> bool {
    for c in t.chars() {
        if c == '[' or c == ']' or c == ':' or c == '*' or c == '?' or c == '/' or c == '\\' {
            return true;
        }
    }
    false
}

fn add_worksheet(wb: mut ref Wb, sheets: mut ref Vec[Sheet], name0: ref Val) -> Result[i64, PyErr] {
    wb.sheetname_count += 1;
    let mut name = if is_nil(name0) { String.new() } else { pystr(name0) };
    if name.len() == 0 {
        let n = wb.sheetname_count;
        name = f"Sheet{n}";
    }
    if clen(name) > 31 {
        return Err(raise("InvalidWorksheetName", f"Excel worksheet name '{name}' must be <= 31 chars."));
    }
    if has_invalid_sheet_char(name) {
        return Err(raise("InvalidWorksheetName", f"Invalid Excel character '[]:*?/\\' in sheetname '{name}'."));
    }
    if name.starts_with("'") or name.ends_with("'") {
        return Err(raise("InvalidWorksheetName", f"Sheet name cannot start or end with an apostrophe \"{name}\"."));
    }
    let lower = name.to_lowercase();
    for s in sheets.iter() {
        if s.name.to_lowercase() == lower {
            return Err(raise("DuplicateWorksheetName", f"Sheetname '{name}', with case ignored, is already in use."));
        }
    }
    let mut sh = new_sheet(name, sheets.len());
    sh.strings_to_numbers = wb.strings_to_numbers;
    sh.strings_to_formulas = wb.strings_to_formulas;
    sh.strings_to_urls = wb.strings_to_urls;
    sh.nan_inf_to_errors = wb.nan_inf_to_errors;
    sh.use_future_functions = wb.use_future_functions;
    sh.default_date_format = wb.default_date_format;
    sh.max_url_length = wb.max_url_length;
    sheets.push(sh);
    Ok(sheets.len() - 1)
}

fn sheet_index_of(sheets: ref Vec[Sheet], name: ref String) -> i64 {
    let mut n = name.clone();
    while n.starts_with("'") {
        n = n.substring(1);
    }
    while n.ends_with("'") {
        n = n.substring(0, n.len() - 1);
    }
    for s in sheets.iter() {
        if s.name == n {
            return s.index;
        }
    }
    -1
}

fn define_name(wb: mut ref Wb, sheets: ref Vec[Sheet], name0: ref String,
               formula0: ref String) -> Val {
    let formula = if formula0.starts_with("=") { lstrip_eq(formula0) } else { formula0.clone() };
    let mut name = name0.clone();
    let mut sheet_index: i64 = -1;
    let bangs = count_sub(name, "!");
    if bangs == 1 and not name.starts_with("!") and not name.ends_with("!") {
        let (a, b) = match name.split_once("!") {
            Some((x, y)) => (x.to_string(), y.to_string()),
            None => (String.new(), String.new()),
        };
        sheet_index = sheet_index_of(sheets, a);
        name = b;
        if sheet_index < 0 {
            wb.warns.push(f"Unknown sheet name '{a}' in defined_name()");
            return Val.Int(-1);
        }
    }
    if not name_ok(name) {
        wb.warns.push(f"Invalid Excel characters in defined_name(): '{name}'");
        return Val.Int(-1);
    }
    if looks_like_cell(name) {
        wb.warns.push(f"Name looks like a cell name in defined_name(): '{name}'");
        return Val.Int(-1);
    }
    if looks_like_rc(name) {
        wb.warns.push(f"Invalid name '{name}' like a RC cell ref in defined_name()");
        return Val.Int(-1);
    }
    wb.defined_names.push((name, sheet_index, formula, false));
    Val.Nil
}

fn name_sort_key(n: ref (String, i64, String, bool)) -> String {
    let (name, _, range, _) = n.clone();
    let a = name.replace("_xlnm.", "").to_lowercase();
    let mut r = range.clone();
    while r.starts_with("'") {
        r = r.substring(1);
    }
    let b = r.to_lowercase();
    f"{a}::{b}"
}

fn prepare_defined_names(wb: mut ref Wb, sheets: ref Vec[Sheet]) {
    let mut names = wb.defined_names.clone();
    for sh in sheets.iter() {
        if sh.autofilter_area.len() > 0 {
            names.push(("_xlnm._FilterDatabase".to_string(), sh.index, sh.autofilter_area.clone(), true));
        }
        if sh.print_area_range.len() > 0 {
            names.push(("_xlnm.Print_Area".to_string(), sh.index, sh.print_area_range.clone(), false));
        }
        if sh.repeat_col_range.len() > 0 or sh.repeat_row_range.len() > 0 {
            let r = if sh.repeat_col_range.len() > 0 and sh.repeat_row_range.len() > 0 {
                let a = sh.repeat_col_range.clone();
                let b = sh.repeat_row_range.clone();
                f"{a},{b}"
            } else {
                let a = sh.repeat_col_range.clone();
                let b = sh.repeat_row_range.clone();
                f"{a}{b}"
            };
            names.push(("_xlnm.Print_Titles".to_string(), sh.index, r, false));
        }
    }
    // A stable sort on the key.
    let keys: Vec[String] = names.iter().map(|n| name_sort_key(n)).collect();
    let mut order: Vec[i64] = Vec.new();
    for i in 0..names.len() {
        order.push(i);
    }
    for i in 1..order.len() {
        let mut j = i;
        while j > 0 and keys[order[j - 1]] > keys[order[j]] {
            let t = order[j];
            order[j] = order[j - 1];
            order[j - 1] = t;
            j -= 1;
        }
    }
    let mut sorted: Vec[(String, i64, String, bool)] = Vec.new();
    for i in order.iter() {
        sorted.push(names[*i].clone());
    }
    let mut ranges: Vec[String] = Vec.new();
    for n in sorted.iter() {
        let (name, index, range, _) = n.clone();
        if name == "_xlnm._FilterDatabase" {
            continue;
        }
        if let Some((sheet, _)) = range.split_once("!") {
            let s = sheet.to_string();
            if name.starts_with("_xlnm.") {
                let t = name.replace("_xlnm.", "");
                ranges.push(f"{s}!{t}");
            } else if index != -1 {
                ranges.push(f"{s}!{name}");
            } else {
                ranges.push(name);
            }
        }
    }
    wb.defined_names = sorted;
    wb.named_ranges = ranges;
}

fn prepare_tables(sheets: mut ref Vec[Sheet]) -> Result[(), PyErr] {
    let mut table_id: i64 = 0;
    let mut seen: Set[String] = Set.new();
    for si in 0..sheets.len() {
        let n = sheets[si].tables.len();
        if n == 0 {
            continue;
        }
        let mut id = table_id + 1;
        for ti in 0..n {
            sheets[si].tables[ti].id = id;
            if sheets[si].tables[ti].name.is_none() {
                sheets[si].tables[ti].name = Some(f"Table{id}");
            }
            let name = match sheets[si].tables[ti].name.clone() {
                Some(x) => x,
                None => String.new(),
            };
            let lower = name.to_lowercase();
            if seen.contains(lower) {
                return Err(raise("DuplicateTableName", f"Duplicate name '{name}' used in worksheet.add_table()."));
            }
            seen.insert(lower);
            sheets[si].external_table_links.push(("/table".to_string(),
                                                  f"../tables/table{id}.xml", String.new()));
            id += 1;
        }
        table_id += n;
    }
    Ok(())
}

// ------------------------------------------------------------ package parts

fn rels_xml(rels: ref Vec[(String, String, String)]) -> String {
    let mut out = String.new();
    decl(mut out);
    let mut ra = attrs();
    ra.add("xmlns", "http://schemas.openxmlformats.org/package/2006/relationships");
    start(mut out, "Relationships", ra);
    let mut id: i64 = 1;
    for r in rels.iter() {
        let (t, target, mode) = r.clone();
        let mut a = attrs();
        a.add("Id", f"rId{id}");
        a.add("Type", t);
        a.add("Target", target);
        id += 1;
        if mode.len() > 0 {
            a.add("TargetMode", mode);
        }
        empty(mut out, "Relationship", a);
    }
    end(mut out, "Relationships");
    out
}

fn doc_rel(kind: Str, target: ref String) -> (String, String, String) {
    (f"http://schemas.openxmlformats.org/officeDocument/2006/relationships{kind}", target.clone(),
     String.new())
}

fn content_types_xml(sheets: ref Vec[Sheet], table_count: i64, has_sst: bool,
                     has_metadata: bool) -> String {
    let pkg = "application/vnd.openxmlformats-package.";
    let doc = "application/vnd.openxmlformats-officedocument.";
    let mut out = String.new();
    decl(mut out);
    let mut ta = attrs();
    ta.add("xmlns", "http://schemas.openxmlformats.org/package/2006/content-types");
    start(mut out, "Types", ta);
    let defaults = [("rels".to_string(), f"{pkg}relationships+xml"),
                    ("xml".to_string(), "application/xml".to_string())];
    for d in defaults.iter() {
        let (e, c) = d.clone();
        let mut a = attrs();
        a.add("Extension", e);
        a.add("ContentType", c);
        empty(mut out, "Default", a);
    }
    let mut ov: Vec[(String, String)] = [
        ("/docProps/app.xml".to_string(), f"{doc}extended-properties+xml"),
        ("/docProps/core.xml".to_string(), f"{pkg}core-properties+xml"),
        ("/xl/styles.xml".to_string(), f"{doc}spreadsheetml.styles+xml"),
        ("/xl/theme/theme1.xml".to_string(), f"{doc}theme+xml"),
        ("/xl/workbook.xml".to_string(), f"{doc}spreadsheetml.sheet.main+xml"),
    ];
    for i in 0..sheets.len() {
        let n = i + 1;
        ov.push((f"/xl/worksheets/sheet{n}.xml", f"{doc}spreadsheetml.worksheet+xml"));
    }
    for i in 0..table_count {
        let n = i + 1;
        ov.push((f"/xl/tables/table{n}.xml", f"{doc}spreadsheetml.table+xml"));
    }
    if has_sst {
        ov.push(("/xl/sharedStrings.xml".to_string(), f"{doc}spreadsheetml.sharedStrings+xml"));
    }
    if has_metadata {
        ov.push(("/xl/metadata.xml".to_string(), f"{doc}spreadsheetml.sheetMetadata+xml"));
    }
    for o in ov.iter() {
        let (p, c) = o.clone();
        let mut a = attrs();
        a.add("PartName", p);
        a.add("ContentType", c);
        empty(mut out, "Override", a);
    }
    end(mut out, "Types");
    out
}

fn workbook_xml(wb: ref Wb, sheets: ref Vec[Sheet], meta: ref Meta) -> String {
    let mut out = String.new();
    decl(mut out);
    let mut a = attrs();
    a.add("xmlns", "http://schemas.openxmlformats.org/spreadsheetml/2006/main");
    a.add("xmlns:r", "http://schemas.openxmlformats.org/officeDocument/2006/relationships");
    start(mut out, "workbook", a);
    let mut fv = attrs();
    fv.add("appName", "xl");
    fv.add("lastEdited", "4");
    fv.add("lowestEdited", "4");
    fv.add("rupBuild", "4505");
    empty(mut out, "fileVersion", fv);
    if wb.read_only != 0 {
        empty1(mut out, "fileSharing", "readOnlyRecommended", "1");
    }
    empty1(mut out, "workbookPr", "defaultThemeVersion", "124226");
    start0(mut out, "bookViews");
    let mut v = attrs();
    v.add("xWindow", "240");
    v.add("yWindow", "15");
    v.addi("windowWidth", wb.window_width);
    v.addi("windowHeight", wb.window_height);
    if wb.tab_ratio != 600 {
        v.addi("tabRatio", wb.tab_ratio);
    }
    if meta.firstsheet > 0 {
        v.addi("firstSheet", meta.firstsheet + 1);
    }
    if meta.activesheet > 0 {
        v.addi("activeTab", meta.activesheet);
    }
    empty(mut out, "workbookView", v);
    end(mut out, "bookViews");
    start0(mut out, "sheets");
    let mut id: i64 = 1;
    for sh in sheets.iter() {
        let mut sa = attrs();
        sa.add("name", sh.name);
        sa.addi("sheetId", id);
        if sh.hidden == 1 {
            sa.add("state", "hidden");
        } else if sh.hidden == 2 {
            sa.add("state", "veryHidden");
        }
        sa.add("r:id", f"rId{id}");
        empty(mut out, "sheet", sa);
        id += 1;
    }
    end(mut out, "sheets");
    if wb.defined_names.len() > 0 {
        start0(mut out, "definedNames");
        for n in wb.defined_names.iter() {
            let (name, sheet_id, range, hidden) = n.clone();
            let mut na = attrs();
            na.add("name", name);
            if sheet_id != -1 {
                na.addi("localSheetId", sheet_id);
            }
            if hidden {
                na.add("hidden", "1");
            }
            data_el(mut out, "definedName", range, na);
        }
        end(mut out, "definedNames");
    }
    let mut c = attrs();
    c.addv("calcId", wb.calc_id);
    if wb.calc_mode == "manual" {
        c.add("calcMode", wb.calc_mode);
        c.add("calcOnSave", "0");
    } else if wb.calc_mode == "autoNoTable" {
        c.add("calcMode", wb.calc_mode);
    }
    if wb.calc_on_load {
        c.add("fullCalcOnLoad", "1");
    }
    empty(mut out, "calcPr", c);
    end(mut out, "workbook");
    out
}

fn sst_xml(sst: ref Sst) -> String {
    let mut out = String.new();
    decl(mut out);
    let mut a = attrs();
    a.add("xmlns", "http://schemas.openxmlformats.org/spreadsheetml/2006/main");
    a.addi("count", sst.count);
    a.addi("uniqueCount", sst.arr.len());
    start(mut out, "sst", a);
    for s0 in sst.arr.iter() {
        let s = esc_ctl(s0);
        if s.starts_with("<r>") and s.ends_with("</r>") {
            out.push_str("<si>");
            out.push_str(s);
            out.push_str("</si>");
        } else {
            out.push_str(if preserve_ws(s) { "<si><t xml:space=\"preserve\">" } else { "<si><t>" });
            out.push_str(esc_data(s));
            out.push_str("</t></si>");
        }
    }
    end(mut out, "sst");
    out
}

fn iso_date(v: ref Val) -> String {
    match v {
        Val.Time(w) => {
            let (y, mo, d, h, mi, s) = (w.y, w.mo, w.d, w.h, w.mi, w.s);
            f"{y:04}-{mo:02}-{d:02}T{h:02}:{mi:02}:{s:02}Z"
        }
        _ => pystr(v),
    }
}

fn core_xml(props: ref Vec[(String, Val)]) -> String {
    let mut out = String.new();
    decl(mut out);
    let mut a = attrs();
    a.add("xmlns:cp", "http://schemas.openxmlformats.org/package/2006/metadata/core-properties");
    a.add("xmlns:dc", "http://purl.org/dc/elements/1.1/");
    a.add("xmlns:dcterms", "http://purl.org/dc/terms/");
    a.add("xmlns:dcmitype", "http://purl.org/dc/dcmitype/");
    a.add("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance");
    start(mut out, "cp:coreProperties", a);
    if let Some(v) = dget(props, "title") {
        data0(mut out, "dc:title", pystr(v));
    }
    if let Some(v) = dget(props, "subject") {
        data0(mut out, "dc:subject", pystr(v));
    }
    data0(mut out, "dc:creator", pystr(dget_or(props, "author", sv(""))));
    if let Some(v) = dget(props, "keywords") {
        data0(mut out, "cp:keywords", pystr(v));
    }
    if let Some(v) = dget(props, "comments") {
        data0(mut out, "dc:description", pystr(v));
    }
    data0(mut out, "cp:lastModifiedBy", pystr(dget_or(props, "author", sv(""))));
    let created = iso_date(dget_or(props, "created", Val.Nil));
    let mut ta = attrs();
    ta.add("xsi:type", "dcterms:W3CDTF");
    data_el(mut out, "dcterms:created", created, ta);
    data_el(mut out, "dcterms:modified", created, ta);
    if let Some(v) = dget(props, "category") {
        data0(mut out, "cp:category", pystr(v));
    }
    if let Some(v) = dget(props, "status") {
        data0(mut out, "cp:contentStatus", pystr(v));
    }
    end(mut out, "cp:coreProperties");
    out
}

fn vt_vector(out: mut ref String, base: Str, items: ref Vec[(String, String)]) {
    let mut a = attrs();
    a.addi("size", items.len());
    a.add("baseType", base.to_string());
    start(mut out, "vt:vector", a);
    for it in items.iter() {
        let (kind, text) = it.clone();
        if base == "variant" {
            start0(mut out, "vt:variant");
        }
        out.push_str("<vt:");
        out.push_str(kind);
        out.push_str(">");
        out.push_str(esc_ctl(esc_data(text)));
        out.push_str("</vt:");
        out.push_str(kind);
        out.push_str(">");
        if base == "variant" {
            end(mut out, "vt:variant");
        }
    }
    end(mut out, "vt:vector");
}

fn app_xml(wb: ref Wb, sheets: ref Vec[Sheet]) -> String {
    let props = wb.doc_properties.clone();
    let mut parts: Vec[(String, String)] = Vec.new();
    let mut pairs: Vec[(String, String)] = Vec.new();
    let mut count: i64 = 0;
    for sh in sheets.iter() {
        if sh.hidden != 2 {
            parts.push(("lpstr".to_string(), sh.name.clone()));
            count += 1;
        }
    }
    if count != 0 {
        pairs.push(("lpstr".to_string(), "Worksheets".to_string()));
        pairs.push(("i4".to_string(), f"{count}"));
    }
    if wb.named_ranges.len() > 0 {
        pairs.push(("lpstr".to_string(), "Named Ranges".to_string()));
        let n = wb.named_ranges.len();
        pairs.push(("i4".to_string(), f"{n}"));
    }
    for r in wb.named_ranges.iter() {
        parts.push(("lpstr".to_string(), r.clone()));
    }
    let mut out = String.new();
    decl(mut out);
    let mut a = attrs();
    a.add("xmlns", "http://schemas.openxmlformats.org/officeDocument/2006/extended-properties");
    a.add("xmlns:vt", "http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes");
    start(mut out, "Properties", a);
    data0(mut out, "Application", "Microsoft Excel");
    data0(mut out, "DocSecurity", f"{wb.read_only}");
    data0(mut out, "ScaleCrop", "false");
    start0(mut out, "HeadingPairs");
    vt_vector(mut out, "variant", pairs);
    end(mut out, "HeadingPairs");
    start0(mut out, "TitlesOfParts");
    vt_vector(mut out, "lpstr", parts);
    end(mut out, "TitlesOfParts");
    if let Some(v) = dget(props, "manager") {
        data0(mut out, "Manager", pystr(v));
    }
    data0(mut out, "Company", pystr(dget_or(props, "company", sv(""))));
    data0(mut out, "LinksUpToDate", "false");
    data0(mut out, "SharedDoc", "false");
    let hb = dget_or(props, "hyperlink_base", Val.Nil);
    if not is_nil(hb) {
        data0(mut out, "HyperlinkBase", pystr(hb));
    }
    data0(mut out, "HyperlinksChanged", "false");
    data0(mut out, "AppVersion", "12.0000");
    end(mut out, "Properties");
    out
}

fn metadata_xml() -> String {
    let mut out = String.new();
    decl(mut out);
    out.push_str(unpct(metadata_body()));
    out
}

// The dynamic array metadata part, %-encoded because it holds braces.
fn metadata_body() -> String {
    let mut s = String.new();
    s.push_str("<metadata xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" ");
    s.push_str("xmlns:xda=\"http://schemas.microsoft.com/office/spreadsheetml/2017/dynamicarray\">");
    s.push_str("<metadataTypes count=\"1\"><metadataType name=\"XLDAPR\" minSupportedVersion=\"120000\" ");
    s.push_str("copy=\"1\" pasteAll=\"1\" pasteValues=\"1\" merge=\"1\" splitFirst=\"1\" rowColShift=\"1\" ");
    s.push_str("clearFormats=\"1\" clearComments=\"1\" assign=\"1\" coerce=\"1\" cellMeta=\"1\"/>");
    s.push_str("</metadataTypes><futureMetadata name=\"XLDAPR\" count=\"1\"><bk><extLst>");
    s.push_str("<ext uri=\"%7Bbdbb8cdc-fa1e-496e-a857-3c3f30c029c3%7D\">");
    s.push_str("<xda:dynamicArrayProperties fDynamic=\"1\" fCollapsed=\"0\"/></ext></extLst></bk>");
    s.push_str("</futureMetadata><cellMetadata count=\"1\"><bk><rc t=\"1\" v=\"0\"/></bk></cellMetadata>");
    s.push_str("</metadata>");
    s
}

// ------------------------------------------------------------ zip

fn crc_table() -> Vec[i64] {
    let mut t: Vec[i64] = Vec.new();
    for n in 0..256 {
        let mut c: i64 = n;
        for _ in 0..8 {
            if (c & 1) != 0 {
                c = 0xEDB88320 ^ (c >> 1);
            } else {
                c = c >> 1;
            }
        }
        t.push(c);
    }
    t
}

fn crc32(table: ref Vec[i64], data: ref Vec[u8]) -> i64 {
    let mut c: i64 = 0xFFFFFFFF;
    for b in data.iter() {
        c = table[(c ^ (*b as i64)) & 255] ^ (c >> 8);
    }
    c ^ 0xFFFFFFFF
}

fn put16(v: mut ref Vec[u8], n: i64) {
    v.push((n & 255) as u8);
    v.push(((n >> 8) & 255) as u8);
}

fn put32(v: mut ref Vec[u8], n: i64) {
    put16(mut v, n & 0xFFFF);
    put16(mut v, (n >> 16) & 0xFFFF);
}

fn get16(v: ref Vec[u8], at: i64) -> i64 {
    (v[at] as i64) | ((v[at + 1] as i64) << 8)
}

fn get32(v: ref Vec[u8], at: i64) -> i64 {
    get16(v, at) | (get16(v, at + 2) << 16)
}

// A stored (uncompressed) zip of the parts, dated 1980-01-01 as the
// library dates them.
fn zip_parts(table: ref Vec[i64], parts: ref Vec[(String, String)]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut central: Vec[u8] = Vec.new();
    for p in parts.iter() {
        let (name, text) = p.clone();
        let data = to_bytes(text);
        let nb = to_bytes(name);
        let crc = crc32(table, data);
        let offset = out.len();
        put32(mut out, 0x04034b50);
        put16(mut out, 20);
        put16(mut out, 0);
        put16(mut out, 0);
        put16(mut out, 0);
        put16(mut out, 0x0021);
        put32(mut out, crc);
        put32(mut out, data.len());
        put32(mut out, data.len());
        put16(mut out, nb.len());
        put16(mut out, 0);
        out.extend_from_slice(nb.as_slice());
        out.extend_from_slice(data.as_slice());
        put32(mut central, 0x02014b50);
        put16(mut central, 20);
        put16(mut central, 20);
        put16(mut central, 0);
        put16(mut central, 0);
        put16(mut central, 0);
        put16(mut central, 0x0021);
        put32(mut central, crc);
        put32(mut central, data.len());
        put32(mut central, data.len());
        put16(mut central, nb.len());
        put16(mut central, 0);
        put16(mut central, 0);
        put16(mut central, 0);
        put16(mut central, 0);
        put32(mut central, 0);
        put32(mut central, offset);
        central.extend_from_slice(nb.as_slice());
    }
    let cd_offset = out.len();
    let cd_size = central.len();
    out.extend_from_slice(central.as_slice());
    put32(mut out, 0x06054b50);
    put16(mut out, 0);
    put16(mut out, 0);
    put16(mut out, parts.len());
    put16(mut out, parts.len());
    put32(mut out, cd_size);
    put32(mut out, cd_offset);
    put16(mut out, 0);
    out
}

// What the read-back finds: each entry's name, size and stored CRC-32,
// and the first entry whose data does not match its CRC.
struct ZipEntry {
    name: String,
    size: i64,
    crc: i64,
}

fn read_zip(table: ref Vec[i64], z: ref Vec[u8]) -> Result[(Vec[ZipEntry], String), String] {
    if z.len() < 22 {
        return Err("too short".to_string());
    }
    let eocd = z.len() - 22;
    if get32(z, eocd) != 0x06054b50 {
        return Err("no end of central directory".to_string());
    }
    let count = get16(z, eocd + 10);
    let mut at = get32(z, eocd + 16);
    let mut entries: Vec[ZipEntry] = Vec.new();
    let mut bad = String.new();
    for _ in 0..count {
        if get32(z, at) != 0x02014b50 {
            return Err("bad central directory entry".to_string());
        }
        let crc = get32(z, at + 16);
        let size = get32(z, at + 24);
        let nlen = get16(z, at + 28);
        let elen = get16(z, at + 30);
        let clen2 = get16(z, at + 32);
        let local = get32(z, at + 42);
        let mut nb: Vec[u8] = Vec.new();
        for k in 0..nlen {
            nb.push(z[at + 46 + k]);
        }
        let name = from_bytes(nb);
        at = at + 46 + nlen + elen + clen2;
        let lnlen = get16(z, local + 26);
        let lelen = get16(z, local + 28);
        let start = local + 30 + lnlen + lelen;
        let mut data: Vec[u8] = Vec.new();
        for k in 0..size {
            data.push(z[start + k]);
        }
        if crc32(table, data) != crc and bad.len() == 0 {
            bad = name.clone();
        }
        entries.push(ZipEntry { name: name, size: size, crc: crc });
    }
    Ok((entries, bad))
}

fn hex8(n: i64) -> String {
    let digits = "0123456789abcdef".to_string();
    let db = digits.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(db[(n >> (k * 4)) & 15]);
        k -= 1;
    }
    from_bytes(out)
}

fn pad_right(t: ref String, w: i64) -> String {
    let mut s = t.clone();
    let mut n = clen(s);
    while n < w {
        s.push_str(" ");
        n += 1;
    }
    s
}

fn pad_left(t: ref String, w: i64) -> String {
    let mut s = String.new();
    let mut n = clen(t);
    while n < w {
        s.push_str(" ");
        n += 1;
    }
    s.push_str(t);
    s
}

// close(): prepares the book and writes every part, in the packager's
// order. The parts, and the summary counts.
fn close_book(wb: mut ref Wb, sheets: mut ref Vec[Sheet], cx: mut ref Ctx) -> Result[(Vec[(String, String)], i64), PyErr] {
    if sheets.len() == 0 {
        add_worksheet(mut wb, mut sheets, Val.Nil)?;
    }
    if cx.meta.activesheet == 0 {
        sheets[0].selected = 1;
        sheets[0].hidden = 0;
    }
    prepare_defined_names(mut wb, sheets);
    prepare_tables(mut sheets)?;
    for sh in sheets.iter() {
        if sh.has_dynamic_arrays {
            wb.has_metadata = true;
        }
    }
    let mut table_count: i64 = 0;
    for sh in sheets.iter() {
        table_count += sh.tables.len();
    }
    let has_sst = cx.sst.count > 0;
    let mut parts: Vec[(String, String)] = Vec.new();
    parts.push(("[Content_Types].xml".to_string(),
                content_types_xml(sheets, table_count, has_sst, wb.has_metadata)));
    let mut root: Vec[(String, String, String)] = Vec.new();
    root.push(doc_rel("/officeDocument", "xl/workbook.xml"));
    root.push(("http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties".to_string(),
               "docProps/core.xml".to_string(), String.new()));
    root.push(doc_rel("/extended-properties", "docProps/app.xml"));
    parts.push(("_rels/.rels".to_string(), rels_xml(root)));
    let mut wbr: Vec[(String, String, String)] = Vec.new();
    for i in 0..sheets.len() {
        let n = i + 1;
        wbr.push(doc_rel("/worksheet", f"worksheets/sheet{n}.xml"));
    }
    wbr.push(doc_rel("/theme", "theme/theme1.xml"));
    wbr.push(doc_rel("/styles", "styles.xml"));
    if has_sst {
        wbr.push(doc_rel("/sharedStrings", "sharedStrings.xml"));
    }
    if wb.has_metadata {
        wbr.push(doc_rel("/sheetMetadata", "metadata.xml"));
    }
    parts.push(("xl/_rels/workbook.xml.rels".to_string(), rels_xml(wbr)));
    for i in 0..sheets.len() {
        let n = i + 1;
        let x = sheet_xml(mut sheets[i], mut cx.fm);
        parts.push((f"xl/worksheets/sheet{n}.xml", x));
    }
    let sd = prepare_formats(mut cx.fm);
    parts.push(("xl/workbook.xml".to_string(), workbook_xml(wb, sheets, cx.meta)));
    let mut tn: i64 = 1;
    for sh in sheets.iter() {
        for t in sh.tables.iter() {
            parts.push((f"xl/tables/table{tn}.xml", table_xml(t)));
            tn += 1;
        }
    }
    if has_sst {
        parts.push(("xl/sharedStrings.xml".to_string(), sst_xml(cx.sst)));
    }
    parts.push(("xl/styles.xml".to_string(), styles_xml(cx.fm, sd)));
    parts.push(("xl/theme/theme1.xml".to_string(), unpct(theme_text())));
    for i in 0..sheets.len() {
        let mut links: Vec[(String, String, String)] = Vec.new();
        for l in sheets[i].external_hyper_links.iter() {
            let (k, target, mode) = l.clone();
            links.push(doc_rel_mode(k, target, mode));
        }
        for l in sheets[i].external_table_links.iter() {
            let (k, target, mode) = l.clone();
            links.push(doc_rel_mode(k, target, mode));
        }
        if links.len() > 0 {
            let n = i + 1;
            parts.push((f"xl/worksheets/_rels/sheet{n}.xml.rels", rels_xml(links)));
        }
    }
    parts.push(("docProps/core.xml".to_string(), core_xml(wb.doc_properties)));
    parts.push(("docProps/app.xml".to_string(), app_xml(wb, sheets)));
    if wb.has_metadata {
        parts.push(("xl/metadata.xml".to_string(), metadata_xml()));
    }
    Ok((parts, sd.xf.len()))
}

fn doc_rel_mode(kind: ref String, target: ref String, mode: ref String) -> (String, String, String) {
    (f"http://schemas.openxmlformats.org/officeDocument/2006/relationships{kind}", target.clone(),
     mode.clone())
}

// ------------------------------------------------------------ the job runner

// The A1 forms the decorators accept: convert_cell_args turns "B3" into
// (2, 1), convert_range_args "A1:C4" into four numbers, and
// convert_column_args "B:D" into two columns.
fn cell_args(args: ref Vec[Val]) -> Result[Vec[Val], PyErr] {
    if args.len() == 0 {
        return Ok(args.clone());
    }
    match args[0].clone() {
        Val.Str(t) => {
            let (r, c) = cell_to_rowcol(t)?;
            let mut out: Vec[Val] = [Val.Int(r), Val.Int(c)];
            for i in 1..args.len() {
                out.push(args[i].clone());
            }
            Ok(out)
        }
        _ => Ok(args.clone()),
    }
}

fn range_args(args: ref Vec[Val]) -> Result[Vec[Val], PyErr] {
    if args.len() == 0 {
        return Ok(args.clone());
    }
    match args[0].clone() {
        Val.Str(t) => {
            let (r1, c1, r2, c2) = match t.split_once(":") {
                Some((a, b)) => {
                    let (r1, c1) = cell_to_rowcol(a.to_string())?;
                    let (r2, c2) = cell_to_rowcol(b.to_string())?;
                    (r1, c1, r2, c2)
                }
                None => {
                    let (r, c) = cell_to_rowcol(t)?;
                    (r, c, r, c)
                }
            };
            let mut out: Vec[Val] = [Val.Int(r1), Val.Int(c1), Val.Int(r2), Val.Int(c2)];
            for i in 1..args.len() {
                out.push(args[i].clone());
            }
            Ok(out)
        }
        _ => Ok(args.clone()),
    }
}

fn column_args(args: ref Vec[Val]) -> Result[Vec[Val], PyErr] {
    if args.len() == 0 {
        return Ok(args.clone());
    }
    match args[0].clone() {
        Val.Str(t) => {
            let (a, b) = match t.split_once(":") {
                Some((x, y)) => (x.to_string(), y.to_string()),
                None => return Err(raise("ValueError", "not enough values to unpack (expected 2, got 1)")),
            };
            let (_, c1) = cell_to_rowcol(f"{a}1")?;
            let (_, c2) = cell_to_rowcol(f"{b}1")?;
            let mut out: Vec[Val] = [Val.Int(c1), Val.Int(c2)];
            for i in 1..args.len() {
                out.push(args[i].clone());
            }
            Ok(out)
        }
        _ => Ok(args.clone()),
    }
}

fn int_arg(args: ref Vec[Val], i: i64) -> i64 {
    as_int(arg(args, i))
}

fn ok_int(n: i64) -> Result[Val, PyErr] {
    Ok(Val.Int(n))
}

fn when_arg(v: ref Val) -> Result[When, PyErr] {
    match v {
        Val.Time(w) => Ok(w.clone()),
        _ => Err(raise("TypeError", "Unknown or unsupported datetime type")),
    }
}

fn is_cell_method(m: ref String) -> bool {
    let names = ["write", "write_string", "write_number", "write_blank", "write_formula",
                 "write_datetime", "write_boolean", "write_row", "write_column", "write_url",
                 "write_rich_string", "set_top_left_cell", "freeze_panes"];
    for n in names.iter() {
        if *n == m {
            return true;
        }
    }
    false
}

fn is_range_method(m: ref String) -> bool {
    let names = ["write_array_formula", "write_dynamic_array_formula", "merge_range",
                 "data_validation", "add_table", "set_selection", "autofilter", "print_area"];
    for n in names.iter() {
        if *n == m {
            return true;
        }
    }
    false
}

fn sheet_call(sh: mut ref Sheet, cx: mut ref Ctx, method: ref String,
              args0: ref Vec[Val]) -> Result[Val, PyErr] {
    let args = if is_cell_method(method) {
        cell_args(args0)?
    } else if is_range_method(method) {
        range_args(args0)?
    } else if method == "set_column" or method == "repeat_columns" {
        column_args(args0)?
    } else {
        args0.clone()
    };
    let r = int_arg(args, 0);
    let c = int_arg(args, 1);
    let m = method.as_str();
    if m == "write" {
        let rest: Vec[Val] = args.iter().skip(2).map(|v| v.clone()).collect();
        return Ok(Val.Int(write_any(mut sh, mut cx, r, c, rest)?));
    }
    if m == "write_string" {
        return ok_int(write_string(mut sh, mut cx, r, c, str_of(arg(args, 2)), fmt_of(arg(args, 3))));
    }
    if m == "write_number" {
        return Ok(Val.Int(write_number(mut sh, mut cx, r, c, arg(args, 2), fmt_of(arg(args, 3)))?));
    }
    if m == "write_blank" {
        return ok_int(write_blank(mut sh, r, c, fmt_of(arg(args, 3))));
    }
    if m == "write_formula" {
        return Ok(Val.Int(write_formula(mut sh, mut cx, r, c, str_of(arg(args, 2)), fmt_of(arg(args, 3)),
                                        arg_or(args, 4, Val.Int(0)))?));
    }
    if m == "write_array_formula" or m == "write_dynamic_array_formula" {
        let formula = str_of(arg(args, 4));
        let dynamic = m == "write_dynamic_array_formula" or has_dynamic(formula, cx.lib.dyn_names);
        return Ok(Val.Int(write_array_formula(mut sh, mut cx, r, c, int_arg(args, 2), int_arg(args, 3),
                                              formula, fmt_of(arg(args, 5)),
                                              arg_or(args, 6, Val.Int(0)), dynamic)?));
    }
    if m == "write_datetime" {
        let w = when_arg(arg(args, 2))?;
        return ok_int(write_datetime(mut sh, r, c, w, fmt_of(arg(args, 3))));
    }
    if m == "write_boolean" {
        return ok_int(write_boolean(mut sh, r, c, arg(args, 2), fmt_of(arg(args, 3))));
    }
    if m == "write_row" {
        return Ok(Val.Int(write_row(mut sh, mut cx, r, c, arg(args, 2), arg(args, 3))?));
    }
    if m == "write_column" {
        return Ok(Val.Int(write_column(mut sh, mut cx, r, c, arg(args, 2), arg(args, 3))?));
    }
    if m == "write_url" {
        return Ok(Val.Int(write_url(mut sh, mut cx, r, c, str_of(arg(args, 2)), arg(args, 3),
                                    arg(args, 4), arg(args, 5))?));
    }
    if m == "write_rich_string" {
        let rest: Vec[Val] = args.iter().skip(2).map(|v| v.clone()).collect();
        return Ok(Val.Int(write_rich_string(mut sh, mut cx, r, c, rest)?));
    }
    if m == "merge_range" {
        return merge_range(mut sh, mut cx, r, c, int_arg(args, 2), int_arg(args, 3), arg(args, 4),
                           arg(args, 5));
    }
    if m == "set_column" {
        return ok_int(set_column(mut sh, r, c, arg(args, 2), arg(args, 3), arg(args, 4)));
    }
    if m == "set_row" {
        return ok_int(set_row(mut sh, r, arg(args, 1), arg(args, 2), arg(args, 3)));
    }
    if m == "set_default_row" {
        let h = arg(args, 0);
        let height = if is_nil(h) { sh.default_row_height.clone() } else { h };
        if num(height) != 15.0 {
            sh.default_row_height = height;
        }
        if truthy(arg(args, 1)) {
            sh.default_row_zeroed = true;
        }
        return Ok(Val.Nil);
    }
    if m == "autofit" {
        autofit(mut sh, cx);
        return Ok(Val.Nil);
    }
    if m == "data_validation" {
        return Ok(Val.Int(data_validation(mut sh, r, c, int_arg(args, 2), int_arg(args, 3),
                                          arg(args, 4))?));
    }
    if m == "add_table" {
        return Ok(Val.Int(add_table(mut sh, mut cx, r, c, int_arg(args, 2), int_arg(args, 3),
                                    arg(args, 4))?));
    }
    if m == "autofilter" {
        autofilter(mut sh, r, c, int_arg(args, 2), int_arg(args, 3));
        return Ok(Val.Nil);
    }
    if m == "filter_column_list" {
        filter_column_list(mut sh, arg(args, 0), arg(args, 1))?;
        return Ok(Val.Nil);
    }
    if m == "freeze_panes" {
        let top = if is_nil(arg(args, 2)) { r } else { int_arg(args, 2) };
        let left = if is_nil(arg(args, 3)) { c } else { int_arg(args, 3) };
        sh.panes = [r, c, top, left, int_arg(args, 4)];
        return Ok(Val.Nil);
    }
    if m == "set_selection" {
        set_selection(mut sh, r, c, int_arg(args, 2), int_arg(args, 3));
        return Ok(Val.Nil);
    }
    if m == "set_top_left_cell" {
        if not (r == 0 and c == 0) {
            sh.top_left_cell = cell_ref(r, c);
        }
        return Ok(Val.Nil);
    }
    if m == "protect" {
        protect(mut sh, arg_or(args, 0, sv("")), arg(args, 1));
        return Ok(Val.Nil);
    }
    if m == "unprotect_range" {
        let cr = arg(args, 0);
        if is_nil(cr) {
            warn(mut sh, "Cell range must be specified in unprotect_range()");
            return ok_int(-1);
        }
        let range = lstrip_eq(pystr(cr)).replace("$", "");
        sh.protected_ranges.push((range, String.new(), String.new()));
        let n = sh.protected_ranges.len();
        let name = if is_nil(arg(args, 1)) { f"Range{n}" } else { pystr(arg(args, 1)) };
        let pw = arg(args, 2);
        let password = if truthy(pw) { encode_password(pystr(pw)) } else { String.new() };
        sh.protected_ranges[n - 1] = (sh.protected_ranges[n - 1].0.clone(), name, password);
        return Ok(Val.Nil);
    }
    if m == "set_zoom" {
        let mut z = arg_or(args, 0, Val.Int(100));
        if num(z) < 10.0 or num(z) > 400.0 {
            let n = as_int(z);
            warn(mut sh, f"Zoom factor {n} outside range: 10 <= zoom <= 400");
            z = Val.Int(100);
        }
        sh.zoom = as_int(z);
        return Ok(Val.Nil);
    }
    if m == "set_print_scale" {
        let s = arg(args, 0);
        if num(s) < 10.0 or num(s) > 400.0 {
            let n = as_int(s);
            warn(mut sh, f"Print scale '{n}' outside range: 10 <= scale <= 400");
            return Ok(Val.Nil);
        }
        sh.fit_page = false;
        sh.print_scale = as_int(s);
        sh.page_setup_changed = true;
        return Ok(Val.Nil);
    }
    if m == "set_start_page" {
        sh.page_start = arg(args, 0);
        return Ok(Val.Nil);
    }
    if m == "set_paper" {
        if truthy(arg(args, 0)) {
            sh.paper_size = arg(args, 0);
            sh.page_setup_changed = true;
        }
        return Ok(Val.Nil);
    }
    if m == "set_landscape" or m == "set_portrait" {
        sh.orientation = if m == "set_landscape" { 0 } else { 1 };
        sh.page_setup_changed = true;
        return Ok(Val.Nil);
    }
    if m == "set_page_view" {
        sh.page_view = as_int(arg_or(args, 0, Val.Int(1)));
        return Ok(Val.Nil);
    }
    if m == "set_header" or m == "set_footer" {
        set_header_footer(mut sh, arg_or(args, 0, sv("")), arg(args, 1), arg(args, 2),
                          m == "set_header");
        return Ok(Val.Nil);
    }
    if m == "set_margins" {
        sh.margin_left = arg_or(args, 0, Val.Float(0.7));
        sh.margin_right = arg_or(args, 1, Val.Float(0.7));
        sh.margin_top = arg_or(args, 2, Val.Float(0.75));
        sh.margin_bottom = arg_or(args, 3, Val.Float(0.75));
        return Ok(Val.Nil);
    }
    if m == "repeat_rows" {
        repeat_rows(mut sh, r, arg(args, 1));
        return Ok(Val.Nil);
    }
    if m == "repeat_columns" {
        repeat_columns(mut sh, r, arg(args, 1));
        return Ok(Val.Nil);
    }
    if m == "print_area" {
        let (r2, c2) = (int_arg(args, 2), int_arg(args, 3));
        if r == 0 and c == 0 and r2 == 1048575 and c2 == 16383 {
            return Ok(Val.Nil);
        }
        sh.print_area_range = name_area(sh, r, c, r2, c2);
        return ok_int(0);
    }
    if m == "fit_to_pages" {
        sh.fit_page = true;
        sh.fit_width = arg(args, 0);
        sh.fit_height = arg(args, 1);
        sh.page_setup_changed = true;
        return Ok(Val.Nil);
    }
    if m == "set_h_pagebreaks" or m == "set_v_pagebreaks" {
        let b = match arg(args, 0) {
            Val.List(v) => v,
            _ => Vec.new(),
        };
        if m == "set_h_pagebreaks" {
            sh.hbreaks = b;
        } else {
            sh.vbreaks = b;
        }
        return Ok(Val.Nil);
    }
    if m == "center_horizontally" {
        sh.print_options_changed = true;
        sh.hcenter = true;
        return Ok(Val.Nil);
    }
    if m == "center_vertically" {
        sh.print_options_changed = true;
        sh.vcenter = true;
        return Ok(Val.Nil);
    }
    if m == "print_row_col_headers" {
        sh.print_headers = true;
        sh.print_options_changed = true;
        return Ok(Val.Nil);
    }
    if m == "hide_row_col_headers" {
        sh.row_col_headers = true;
        return Ok(Val.Nil);
    }
    if m == "hide_zero" {
        sh.show_zeros = false;
        return Ok(Val.Nil);
    }
    if m == "right_to_left" {
        sh.is_right_to_left = true;
        return Ok(Val.Nil);
    }
    if m == "hide_gridlines" {
        let o = arg_or(args, 0, Val.Int(1));
        if eq_int(o, 0) {
            sh.print_gridlines = true;
            sh.screen_gridlines = true;
            sh.print_options_changed = true;
        } else if eq_int(o, 1) {
            sh.print_gridlines = false;
            sh.screen_gridlines = true;
        } else {
            sh.print_gridlines = false;
            sh.screen_gridlines = false;
        }
        return Ok(Val.Nil);
    }
    if m == "print_across" {
        sh.page_order = 1;
        sh.page_setup_changed = true;
        return Ok(Val.Nil);
    }
    if m == "print_black_and_white" {
        sh.black_white = true;
        sh.page_setup_changed = true;
        return Ok(Val.Nil);
    }
    if m == "activate" {
        sh.hidden = 0;
        sh.selected = 1;
        cx.meta.activesheet = sh.index;
        return Ok(Val.Nil);
    }
    if m == "select" {
        sh.selected = 1;
        sh.hidden = 0;
        return Ok(Val.Nil);
    }
    if m == "hide" or m == "very_hidden" {
        sh.hidden = if m == "hide" { 1 } else { 2 };
        sh.selected = 0;
        return Ok(Val.Nil);
    }
    if m == "set_first_sheet" {
        sh.hidden = 0;
        cx.meta.firstsheet = sh.index;
        return Ok(Val.Nil);
    }
    if m == "set_tab_color" {
        let color = pystr(arg(args, 0));
        let (c2, ok) = xl_color(color);
        if not ok {
            warn(mut sh, f"Color '{color}' isn't a valid Excel color");
        }
        sh.tab_color = c2;
        return Ok(Val.Nil);
    }
    if m == "outline_settings" {
        sh.outline_on = arg_or(args, 0, Val.Int(1));
        sh.outline_below = arg_or(args, 1, Val.Int(1));
        sh.outline_right = arg_or(args, 2, Val.Int(1));
        sh.outline_style = arg_or(args, 3, Val.Int(0));
        sh.outline_changed = true;
        return Ok(Val.Nil);
    }
    Err(raise("AttributeError", f"'Worksheet' object has no attribute '{method}'"))
}

// What a workbook call returns: a value to print, a new sheet, or a new
// format (the last two are recorded, not printed).
fn book_call(wb: mut ref Wb, sheets: mut ref Vec[Sheet], cx: mut ref Ctx, method: ref String,
             args: ref Vec[Val]) -> Result[Val, PyErr] {
    let m = method.as_str();
    if m == "add_worksheet" {
        add_worksheet(mut wb, mut sheets, arg(args, 0))?;
        return Ok(Val.Nil);
    }
    if m == "add_format" {
        let props = dict_of(arg(args, 0));
        add_format(mut wb, mut cx, props)?;
        return Ok(Val.Nil);
    }
    if m == "define_name" {
        return Ok(define_name(mut wb, sheets, pystr(arg(args, 0)), pystr(arg(args, 1))));
    }
    if m == "set_properties" {
        wb.doc_properties = dict_of(arg(args, 0));
        return Ok(Val.Nil);
    }
    if m == "set_size" {
        let w = arg(args, 0);
        let h = arg(args, 1);
        wb.window_width = if truthy(w) { (num(w) * 1440.0 / 96.0) as i64 } else { 16095 };
        wb.window_height = if truthy(h) { (num(h) * 1440.0 / 96.0) as i64 } else { 9660 };
        return Ok(Val.Nil);
    }
    if m == "set_tab_ratio" {
        let r = arg(args, 0);
        if is_nil(r) {
            return Ok(Val.Nil);
        }
        if num(r) < 0.0 or num(r) > 100.0 {
            let n = as_int(r);
            wb.warns.push(f"Tab ratio '{n}' outside: 0 <= tab_ratio <= 100");
        } else {
            wb.tab_ratio = (num(r) * 10.0) as i64;
        }
        return Ok(Val.Nil);
    }
    if m == "set_calc_mode" {
        let mode = pystr(arg(args, 0));
        wb.calc_mode = mode.clone();
        if mode == "manual" {
            wb.calc_on_load = false;
        } else if mode == "auto_except_tables" {
            wb.calc_mode = "autoNoTable".to_string();
        }
        if truthy(arg(args, 1)) {
            wb.calc_id = arg(args, 1);
        }
        return Ok(Val.Nil);
    }
    if m == "read_only_recommended" {
        wb.read_only = 2;
        return Ok(Val.Nil);
    }
    Err(raise("AttributeError", f"'Workbook' object has no attribute '{method}'"))
}

fn take_warns(n: i64, label: ref String, wb: mut ref Wb, sheets: mut ref Vec[Sheet],
              cx: mut ref Ctx) {
    let mut all: Vec[String] = Vec.new();
    for i in 0..sheets.len() {
        for w in sheets[i].warns.iter() {
            all.push(w.clone());
        }
        sheets[i].warns = Vec.new();
    }
    for w in cx.fm.warns.iter() {
        all.push(w.clone());
    }
    cx.fm.warns = Vec.new();
    for w in wb.warns.iter() {
        all.push(w.clone());
    }
    wb.warns = Vec.new();
    for w in all.iter() {
        println(f"  {n} {label} warns: {w}");
    }
}

fn split_sp(t: ref String) -> Vec[String] {
    t.split(" ").map(|p| p.to_string()).collect()
}

fn run_book(lines: ref Vec[String], crc: ref Vec[i64]) {
    let head = split_sp(lines[0]);
    let name = unpct(head[1]);
    let mut hp = Toks { t: head.clone(), i: 2 };
    let options = dict_of(parse_val(mut hp, 0));
    let mut cx = Ctx {
        sst: new_sst(), lib: new_lib(),
        fm: Formats { list: Vec.new(), xf_keys: Map.new(), dxf_keys: Map.new(), warns: Vec.new() },
        meta: Meta { activesheet: 0, firstsheet: 0 },
    };
    let mut wb = match new_book(options, mut cx) {
        Ok(b) => b,
        Err(e) => {
            println(f"  book raised {e.cls}: {e.msg}");
            return;
        }
    };
    let base = cx.fm.list.len();
    let mut sheets: Vec[Sheet] = Vec.new();
    println(f"== {name}");
    let mut parts: Vec[(String, String)] = Vec.new();
    let mut xf_count: i64 = 0;
    let mut closed_ok = true;
    for n in 1..lines.len() {
        let toks = split_sp(lines[n]);
        if toks[0] == "close" {
            match close_book(mut wb, mut sheets, mut cx) {
                Ok((p, x)) => {
                    parts = p;
                    xf_count = x;
                }
                Err(e) => {
                    closed_ok = false;
                    println(f"  {n} close raised {e.cls}: {e.msg}");
                }
            }
            take_warns(n, "close", mut wb, mut sheets, mut cx);
            continue;
        }
        let target = toks[0].clone();
        let method = toks[1].clone();
        let mut p = Toks { t: toks.clone(), i: 2 };
        let mut args: Vec[Val] = Vec.new();
        while not p.done() {
            args.push(parse_val(mut p, base));
        }
        let label = f"{target}.{method}";
        let res = if target == "wb" {
            book_call(mut wb, mut sheets, mut cx, method, args)
        } else {
            let si = parse_int(target.substring(1));
            sheet_call(mut sheets[si], mut cx, method, args)
        };
        let ret = match res {
            Ok(v) => v,
            Err(e) => {
                println(f"  {n} {label} raised {e.cls}: {e.msg}");
                Val.Nil
            }
        };
        take_warns(n, label, mut wb, mut sheets, mut cx);
        if not is_nil(ret) and not eq_int(ret, 0) {
            let shown = pyrepr(ret);
            println(f"  {n} {label} -> {shown}");
        }
    }
    if not closed_ok {
        println("  no file written");
        return;
    }
    let z = zip_parts(crc, parts);
    let path = f"mini_xlsxwriter_{name}";
    if fs.write_bytes(path, z).is_err() {
        println(f"  could not write {path}");
        return;
    }
    let back = match fs.read_bytes(path) {
        Ok(b) => b,
        Err(_) => {
            println(f"  could not read {path}");
            return;
        }
    };
    let _ = fs.remove_file(path);
    let (entries, bad) = match read_zip(crc, back) {
        Ok(r) => r,
        Err(e) => {
            println(f"  bad zip: {e}");
            return;
        }
    };
    let mut tables: i64 = 0;
    for sh in sheets.iter() {
        tables += sh.tables.len();
    }
    let ne = entries.len();
    let ns = sheets.len();
    let nu = cx.sst.arr.len();
    let nc = cx.sst.count;
    let nn = wb.defined_names.len();
    println(f"  {ne} parts, {ns} sheets, {nu} strings ({nc} uses), {xf_count} cell formats, {tables} tables, {nn} names");
    for e in entries.iter() {
        let nm = pad_right(e.name, 40);
        let sz = pad_left(f"{e.size}", 7);
        let h = hex8(e.crc);
        println(f"  {nm} {sz} {h}");
    }
    if bad.len() == 0 {
        println("  read back: crc ok");
    } else {
        println(f"  read back: bad crc in {bad}");
    }
}

fn main() {
    let crc = crc_table();
    let lines: Vec[String] = jobs_text().split("\n").map(|p| p.to_string()).collect();
    let mut book: Vec[String] = Vec.new();
    for line in lines.iter() {
        if line.len() == 0 {
            continue;
        }
        book.push(line.clone());
        if line == "close" {
            run_book(book, crc);
            book = Vec.new();
        }
    }
}

// Generated by gen_kara.py from data/ and the vendored xlsxwriter.

fn jobs_text() -> String {
    let mut s = String.new();
