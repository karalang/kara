fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("manifest.txt".to_string(), file_0()));
    v.push(("jobs.txt".to_string(), file_1()));
    v
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    for (name, text) in data_files().into_iter() {
        let path = f"data/{name}";
        if let Err(e) = fs.write(path.clone(), text) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

// ------------------------------------------------------------ the jobs

fn run() -> Result[(), String] {
    write_data()?;
    build_tree()?;
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    for line in lines_of(text) {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let mut job = Job { out: String.new(), err: String.new(), status: 0, quit: false };
        let w = shell_words(line);
        if w[0] == "find" {
            let args: Vec[String] = w[1..].to_vec();
            find(mut job, args);
        } else if w[0] == "reset" {
            build_tree()?;
        }
        let mut out = f"$ {line}\n";
        out.push_str(job.out);
        out.push_str(job.err);
        if job.status != 0 {
            out.push_str(f"[exit status {job.status}]\n");
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
