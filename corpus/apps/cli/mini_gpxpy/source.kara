// mini_gpxpy: a port of gpxpy 1.6.2 (Apache 2.0, see LICENSE-gpxpy and
// NOTICE-gpxpy), the GPS track library, and of its gpxinfo command.
//
// - an ElementTree-style XML parser (namespaces in Clark notation,
//   entities, CDATA, expat's error messages);
// - gpxpy's field lists for GPX 1.0 and 1.1, which drive both reading
//   and writing, its timestamp regex and SimpleTZ offsets;
// - the geo module (haversine and flat-earth distances, courses,
//   Ramer-Douglas-Peucker);
// - track statistics (moving and stopped time, max speed with outliers
//   dropped, uphill and downhill, bounds, nearest locations) and edits
//   (simplify, reduce, smooth, fill in missing data, split, join, move,
//   shift and refill the times).
//
// The run writes the GPX files under data/ (gpxpy's own test files and
// a few more from mk.py), then for each one prints gpxinfo's report,
// writes the XML back out in both versions, parses its own output again
// and runs a set of track operations. expected.out is the output of
// oracle.py, which does the same with gpxpy itself.

// ---------------------------------------------------------------- objects

// gpxpy's objects are described by lists of fields (gpx_10_fields and
// gpx_11_fields) that drive both parsing and writing. The port keeps
// that design: an object is a class and one value per attribute name.
#[derive(Clone)]
enum Val {
    Nil,
    Str(String),
    Num(f64),
    Int(i64),
    Time(Stamp),
    One(Vec[Obj]),
    Elems(Vec[Elem]),
}

// lists[L_MAIN] holds a route's or a segment's points, a track's
// segments and a GPX's waypoints; a GPX also has routes and tracks.
#[derive(Clone)]
struct Obj {
    cls: i64,
    vals: Vec[Val],
    lists: Vec[Vec[Obj]],
}

const L_MAIN: i64 = 0;
const L_ROUTES: i64 = 1;
const L_TRACKS: i64 = 2;

const C_GPX: i64 = 0;
const C_BOUNDS: i64 = 1;
const C_WAYPOINT: i64 = 2;
const C_ROUTE: i64 = 3;
const C_ROUTEPOINT: i64 = 4;
const C_TRACK: i64 = 5;
const C_SEGMENT: i64 = 6;
const C_TRACKPOINT: i64 = 7;

// Attribute names; an object has a value for every one, Nil where its
// class has no such attribute.
fn slot_names() -> Vec[Str] {
    vec![
        "latitude", "longitude", "elevation", "time", "course", "speed",
        "magnetic_variation", "geoid_height", "name", "comment", "description", "source",
        "link", "link_text", "link_type", "symbol", "type", "type_of_gpx_fix",
        "satellites", "horizontal_dilution", "vertical_dilution", "position_dilution",
        "age_of_dgps_data", "dgps_id", "extensions", "number", "points", "segments",
        "version", "creator", "author_name", "author_email", "author_link",
        "author_link_text", "author_link_type", "copyright_author", "copyright_year",
        "copyright_license", "keywords", "bounds", "metadata_extensions", "waypoints",
        "routes", "tracks", "min_latitude", "max_latitude", "min_longitude", "max_longitude",
    ]
}

const S_LATITUDE: i64 = 0;
const S_LONGITUDE: i64 = 1;
const S_ELEVATION: i64 = 2;
const S_TIME: i64 = 3;
const S_SPEED: i64 = 5;
const S_NAME: i64 = 8;
const S_DESCRIPTION: i64 = 10;
const S_HDOP: i64 = 19;
const S_VDOP: i64 = 20;
const S_PDOP: i64 = 21;
const S_POINTS: i64 = 26;
const S_SEGMENTS: i64 = 27;
const S_VERSION: i64 = 28;
const S_CREATOR: i64 = 29;
const S_AUTHOR_NAME: i64 = 30;
const S_AUTHOR_EMAIL: i64 = 31;
const S_BOUNDS: i64 = 39;
const S_WAYPOINTS: i64 = 41;
const S_ROUTES: i64 = 42;
const S_TRACKS: i64 = 43;
const S_EXTENSIONS: i64 = 24;
const S_METADATA_EXTENSIONS: i64 = 40;
const N_SLOTS: i64 = 48;
const S_MIN_LAT: i64 = 44;
const S_MAX_LAT: i64 = 45;
const S_MIN_LON: i64 = 46;
const S_MAX_LON: i64 = 47;

fn slot_of(name: Str) -> i64 {
    let names = slot_names();
    let mut i = 0;
    while i < names.len() {
        if names[i] == name {
            return i;
        }
        i += 1;
    }
    -1
}

const K_MARK: i64 = 0;
const K_SIMPLE: i64 = 1;
const K_COMPLEX: i64 = 2;
const K_EMAIL: i64 = 3;
const K_EXT: i64 = 4;

const T_STR: i64 = 0;
const T_FLOAT: i64 = 1;
const T_INT: i64 = 2;
const T_TIME: i64 = 3;

#[derive(Clone)]
struct Field {
    kind: i64,
    // the marker text for K_MARK, else the attribute name
    name: String,
    slot: i64,
    tag: Option[String],
    attribute: Option[String],
    conv: i64,
    possible: Vec[String],
    mandatory: bool,
    cls: i64,
    is_list: bool,
    empty_body: bool,
    list: i64,
    // a marker's dependent attributes, as slots
    deps: Vec[i64],
}

fn base_field(kind: i64, name: Str) -> Field {
    Field {
        kind: kind, name: name.to_string(), slot: slot_of(name), tag: None, attribute: None, conv: T_STR,
        possible: Vec.new(), mandatory: false, cls: -1, is_list: false, empty_body: false, list: -1, deps: Vec.new(),
    }
}

fn mark(text: Str) -> Field {
    let mut f = base_field(K_MARK, text);
    let parts: Vec[Str] = text.split(":").collect();
    let mut k = 1;
    while k < parts.len() {
        let name = if parts[k].starts_with("@") { parts[k][1..] } else { parts[k] };
        f.deps.push(slot_of(name));
        k += 1;
    }
    f
}

// GPXField(name, tag)
fn tagf(name: Str, tag: Str, conv: i64) -> Field {
    let mut f = base_field(K_SIMPLE, name);
    f.tag = Some(tag.to_string());
    f.conv = conv;
    f
}

fn plain(name: Str) -> Field {
    tagf(name, name, T_STR)
}

// GPXField(name, attribute=...)
fn attrf(name: Str, attribute: Str, conv: i64) -> Field {
    let mut f = base_field(K_SIMPLE, name);
    f.attribute = Some(attribute.to_string());
    f.conv = conv;
    f
}

fn complexf(name: Str, tag: Str, cls: i64, is_list: bool, empty_body: bool) -> Field {
    let mut f = base_field(K_COMPLEX, name);
    f.tag = Some(tag.to_string());
    f.cls = cls;
    f.is_list = is_list;
    f.empty_body = empty_body;
    f.list = if name == "routes" { L_ROUTES } else if name == "tracks" { L_TRACKS } else { L_MAIN };
    f
}

fn emailf(name: Str, tag: Str) -> Field {
    let mut f = base_field(K_EMAIL, name);
    f.tag = Some(tag.to_string());
    f
}

fn extf(name: Str, tag: Str, is_list: bool) -> Field {
    let mut f = base_field(K_EXT, name);
    f.tag = Some(tag.to_string());
    f.is_list = is_list;
    f
}

fn fix_field() -> Field {
    let mut f = tagf("type_of_gpx_fix", "fix", T_STR);
    for p in ["none", "2d", "3d", "dgps", "pps", "3"] {
        f.possible.push(p.to_string());
    }
    f
}

fn point_fields_10(track: bool) -> Vec[Field] {
    let mut v = vec![
        attrf("latitude", "lat", T_FLOAT),
        attrf("longitude", "lon", T_FLOAT),
        tagf("elevation", "ele", T_FLOAT),
        tagf("time", "time", T_TIME),
    ];
    v[0].mandatory = true;
    v[1].mandatory = true;
    if track {
        v.push(tagf("course", "course", T_FLOAT));
        v.push(tagf("speed", "speed", T_FLOAT));
    }
    v.push(tagf("magnetic_variation", "magvar", T_FLOAT));
    v.push(tagf("geoid_height", "geoidheight", T_FLOAT));
    v.push(plain("name"));
    v.push(tagf("comment", "cmt", T_STR));
    v.push(tagf("description", "desc", T_STR));
    v.push(tagf("source", "src", T_STR));
    v.push(tagf("link", "url", T_STR));
    v.push(tagf("link_text", "urlname", T_STR));
    v.push(tagf("symbol", "sym", T_STR));
    v.push(plain("type"));
    v.push(fix_field());
    v.push(tagf("satellites", "sat", T_INT));
    v.push(tagf("horizontal_dilution", "hdop", T_FLOAT));
    v.push(tagf("vertical_dilution", "vdop", T_FLOAT));
    v.push(tagf("position_dilution", "pdop", T_FLOAT));
    v.push(tagf("age_of_dgps_data", "ageofdgpsdata", T_FLOAT));
    v.push(tagf("dgps_id", "dgpsid", T_INT));
    v
}

fn link_group() -> Vec[Field] {
    vec![
        mark("link:@link"),
        attrf("link", "href", T_STR),
        tagf("link_text", "text", T_STR),
        tagf("link_type", "type", T_STR),
        mark("/link"),
    ]
}

fn point_fields_11() -> Vec[Field] {
    let mut v = vec![
        attrf("latitude", "lat", T_FLOAT),
        attrf("longitude", "lon", T_FLOAT),
        tagf("elevation", "ele", T_FLOAT),
        tagf("time", "time", T_TIME),
        tagf("magnetic_variation", "magvar", T_FLOAT),
        tagf("geoid_height", "geoidheight", T_FLOAT),
        plain("name"),
        tagf("comment", "cmt", T_STR),
        tagf("description", "desc", T_STR),
        tagf("source", "src", T_STR),
    ];
    v[0].mandatory = true;
    v[1].mandatory = true;
    for f in link_group().into_iter() {
        v.push(f);
    }
    v.push(tagf("symbol", "sym", T_STR));
    v.push(plain("type"));
    v.push(fix_field());
    v.push(tagf("satellites", "sat", T_INT));
    v.push(tagf("horizontal_dilution", "hdop", T_FLOAT));
    v.push(tagf("vertical_dilution", "vdop", T_FLOAT));
    v.push(tagf("position_dilution", "pdop", T_FLOAT));
    v.push(tagf("age_of_dgps_data", "ageofdgpsdata", T_FLOAT));
    v.push(tagf("dgps_id", "dgpsid", T_INT));
    v.push(extf("extensions", "extensions", true));
    v
}

// The fields of a route or a track, around its list of children.
fn group_fields(version11: bool, children: own Field) -> Vec[Field] {
    let mut v = vec![
        plain("name"),
        tagf("comment", "cmt", T_STR),
        tagf("description", "desc", T_STR),
        tagf("source", "src", T_STR),
    ];
    if version11 {
        for f in link_group().into_iter() {
            v.push(f);
        }
        v.push(tagf("number", "number", T_INT));
        v.push(plain("type"));
        v.push(extf("extensions", "extensions", true));
    } else {
        v.push(tagf("link", "url", T_STR));
        v.push(tagf("link_text", "urlname", T_STR));
        v.push(tagf("number", "number", T_INT));
    }
    v.push(children);
    v
}

fn gpx_fields_10() -> Vec[Field] {
    vec![
        attrf("version", "version", T_STR),
        attrf("creator", "creator", T_STR),
        plain("name"),
        tagf("description", "desc", T_STR),
        tagf("author_name", "author", T_STR),
        tagf("author_email", "email", T_STR),
        tagf("link", "url", T_STR),
        tagf("link_text", "urlname", T_STR),
        tagf("time", "time", T_TIME),
        plain("keywords"),
        complexf("bounds", "bounds", C_BOUNDS, false, true),
        complexf("waypoints", "wpt", C_WAYPOINT, true, false),
        complexf("routes", "rte", C_ROUTE, true, false),
        complexf("tracks", "trk", C_TRACK, true, false),
    ]
}

fn gpx_fields_11() -> Vec[Field] {
    vec![
        attrf("version", "version", T_STR),
        attrf("creator", "creator", T_STR),
        mark("metadata:name:description:author_name:author_email:author_link:copyright_author:copyright_year:copyright_license:link:time:keywords:bounds"),
        tagf("name", "name", T_STR),
        tagf("description", "desc", T_STR),
        mark("author:author_name:author_email:author_link"),
        tagf("author_name", "name", T_STR),
        emailf("author_email", "email"),
        mark("link:@author_link"),
        attrf("author_link", "href", T_STR),
        tagf("author_link_text", "text", T_STR),
        tagf("author_link_type", "type", T_STR),
        mark("/link"),
        mark("/author"),
        mark("copyright:copyright_author:copyright_year:copyright_license"),
        attrf("copyright_author", "author", T_STR),
        tagf("copyright_year", "year", T_STR),
        tagf("copyright_license", "license", T_STR),
        mark("/copyright"),
        mark("link:@link"),
        attrf("link", "href", T_STR),
        tagf("link_text", "text", T_STR),
        tagf("link_type", "type", T_STR),
        mark("/link"),
        tagf("time", "time", T_TIME),
        plain("keywords"),
        complexf("bounds", "bounds", C_BOUNDS, false, true),
        extf("metadata_extensions", "extensions", true),
        mark("/metadata"),
        complexf("waypoints", "wpt", C_WAYPOINT, true, false),
        complexf("routes", "rte", C_ROUTE, true, false),
        complexf("tracks", "trk", C_TRACK, true, false),
        extf("extensions", "extensions", true),
    ]
}

fn bounds_fields() -> Vec[Field] {
    vec![
        attrf("min_latitude", "minlat", T_FLOAT),
        attrf("max_latitude", "maxlat", T_FLOAT),
        attrf("min_longitude", "minlon", T_FLOAT),
        attrf("max_longitude", "maxlon", T_FLOAT),
    ]
}

// (gpx_10_fields, gpx_11_fields) by class
struct Schema {
    v10: Vec[Vec[Field]],
    v11: Vec[Vec[Field]],
}

fn new_schema() -> Schema {
    let v10 = vec![
        gpx_fields_10(),
        bounds_fields(),
        point_fields_10(false),
        group_fields(false, complexf("points", "rtept", C_ROUTEPOINT, true, false)),
        point_fields_10(false),
        group_fields(false, complexf("segments", "trkseg", C_SEGMENT, true, false)),
        vec![complexf("points", "trkpt", C_TRACKPOINT, true, false)],
        point_fields_10(true),
    ];
    let v11 = vec![
        gpx_fields_11(),
        bounds_fields(),
        point_fields_11(),
        group_fields(true, complexf("points", "rtept", C_ROUTEPOINT, true, false)),
        point_fields_11(),
        group_fields(true, complexf("segments", "trkseg", C_SEGMENT, true, false)),
        vec![complexf("points", "trkpt", C_TRACKPOINT, true, false), extf("extensions", "extensions", true)],
        point_fields_11(),
    ];
    Schema { v10: v10, v11: v11 }
}

// A new object with the class's defaults: lists empty, the rest None.
fn new_obj(cls: i64) -> Obj {
    let n = N_SLOTS;
    let mut vals: Vec[Val] = Vec.new();
    let mut i = 0;
    while i < n {
        vals.push(Val.Nil);
        i += 1;
    }
    if cls != C_BOUNDS {
        vals[S_EXTENSIONS] = Val.Elems(Vec.new());
    }
    if cls == C_GPX {
        vals[S_METADATA_EXTENSIONS] = Val.Elems(Vec.new());
    }
    if cls == C_WAYPOINT or cls == C_ROUTEPOINT or cls == C_TRACKPOINT {
        // Location.__init__(latitude or 0, longitude or 0)
        vals[S_LATITUDE] = Val.Int(0);
        vals[S_LONGITUDE] = Val.Int(0);
    }
    Obj { cls: cls, vals: vals, lists: vec![Vec.new(), Vec.new(), Vec.new()] }
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.Nil => false,
        Val.Str(s) => s.len() > 0,
        Val.Num(x) => *x != 0.0,
        Val.Int(i) => *i != 0,
        Val.Time(_) => true,
        Val.One(_) => true,
        Val.Elems(v) => v.len() > 0,
    }
}

impl Obj {
    fn num(ref self, slot: i64) -> Option[f64] {
        match ref self.vals[slot] {
            Val.Num(x) => Some(*x),
            Val.Int(i) => Some(*i as f64),
            _ => None,
        }
    }

    fn f(ref self, slot: i64) -> f64 {
        self.num(slot).unwrap_or(0.0)
    }

    fn time(ref self) -> Option[Stamp] {
        match ref self.vals[S_TIME] {
            Val.Time(t) => Some(t.clone()),
            _ => None,
        }
    }

    fn text(ref self, slot: i64) -> Option[String] {
        match ref self.vals[slot] {
            Val.Str(s) => Some(s.clone()),
            _ => None,
        }
    }
}
// ---------------------------------------------------------------- datetimes

// A datetime: local fields and, when aware, gpxpy's SimpleTZ offset in
// minutes.
#[derive(Clone)]
struct Stamp {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    minute: i64,
    second: i64,
    micro: i64,
    tz: Option[i64],
}

fn is_leap(y: i64) -> bool {
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

// Days since 0001-01-01.
fn ordinal(y: i64, m: i64, d: i64) -> i64 {
    let yy = y - 1;
    let mut days = yy * 365 + yy / 4 - yy / 100 + yy / 400;
    let mut k = 1;
    while k < m {
        days += days_in_month(y, k);
        k += 1;
    }
    days + d - 1
}

const US_PER_DAY: i64 = 86400000000;

impl Stamp {
    fn local_us(ref self) -> i64 {
        let secs = self.hour * 3600 + self.minute * 60 + self.second;
        ordinal(self.year, self.month, self.day) * US_PER_DAY + secs * 1000000 + self.micro
    }

    fn utc_us(ref self) -> i64 {
        match self.tz {
            Some(m) => self.local_us() - m * 60000000,
            None => self.local_us(),
        }
    }

    // self + timedelta(microseconds=delta), keeping the offset.
    fn plus(ref self, delta: i64) -> Stamp {
        let total = self.local_us() + delta;
        let mut days = total / US_PER_DAY;
        let mut rest = total % US_PER_DAY;
        if rest < 0 {
            rest += US_PER_DAY;
            days -= 1;
        }
        // Back from the ordinal: count 400-year cycles, then years.
        let mut y = 1 + (days / 146097) * 400;
        let mut left = days % 146097;
        loop {
            let n = if is_leap(y) { 366 } else { 365 };
            if left < n {
                break;
            }
            left -= n;
            y += 1;
        }
        let mut m = 1;
        loop {
            let n = days_in_month(y, m);
            if left < n {
                break;
            }
            left -= n;
            m += 1;
        }
        let secs = rest / 1000000;
        Stamp {
            year: y,
            month: m,
            day: left + 1,
            hour: secs / 3600,
            minute: secs / 60 % 60,
            second: secs % 60,
            micro: rest % 1000000,
            tz: self.tz,
        }
    }

    fn same_as(ref self, other: ref Stamp) -> bool {
        if self.tz.is_some() != other.tz.is_some() {
            return false;
        }
        self.utc_us() == other.utc_us()
    }

    // datetime.isoformat(sep): the offset as +HH:MM when aware.
    fn iso(ref self, sep: Str) -> String {
        let mut s = f"{pad(self.year, 4)}-{pad(self.month, 2)}-{pad(self.day, 2)}{sep}{pad(self.hour, 2)}:{pad(self.minute, 2)}:{pad(self.second, 2)}";
        if self.micro != 0 {
            s.push_str(f".{pad(self.micro, 6)}");
        }
        if let Some(m) = self.tz {
            let sign = if m < 0 { "-" } else { "+" };
            let a = if m < 0 { -m } else { m };
            s.push_str(f"{sign}{pad(a / 60, 2)}:{pad(a % 60, 2)}");
        }
        s
    }
}

fn pad(v: i64, width: i64) -> String {
    let mut s = f"{v}";
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

// str(datetime)
fn stamp_str(t: ref Stamp) -> String {
    t.iso(" ")
}

// gpxfield.format_time
fn format_time(t: ref Stamp) -> String {
    t.iso("T").replace("+00:00", "Z")
}

// Seconds as timedelta.total_seconds() gives them.
fn total_seconds(us: i64) -> f64 {
    us as f64 / 1000000.0
}

// timedelta / n, rounded half to even like CPython's divide_nearest.
fn div_nearest(a: i64, n: i64) -> i64 {
    let mut q = a / n;
    let mut r = a % n;
    if r < 0 {
        r += n;
        q -= 1;
    }
    let twice = 2 * r;
    if twice > n or (twice == n and q % 2 != 0) {
        q += 1;
    }
    q
}

// timedelta(seconds=x) for a float x, as CPython's delta_new rounds it.
fn delta_from_seconds(x: f64) -> i64 {
    let v = x * 1000000.0;
    let ip = v.trunc();
    let left = v - ip;
    let sum = ip as i64;
    if left == 0.0 {
        return sum;
    }
    let mut whole = left.round();
    if (whole - left).abs() == 0.5 {
        let odd = if sum % 2 != 0 { 1.0 } else { 0.0 };
        whole = 2.0 * ((left + odd) * 0.5).round() - odd;
    }
    sum + whole as i64
}

fn digit_run(cs: ref Vec[char], at: i64, n: i64) -> bool {
    let mut i = 0;
    while i < n {
        if at + i >= cs.len() {
            return false;
        }
        let c = cs[at + i];
        if c < '0' or c > '9' {
            return false;
        }
        i += 1;
    }
    true
}

fn number_at(cs: ref Vec[char], at: i64, n: i64) -> i64 {
    let mut v = 0;
    let mut i = 0;
    while i < n {
        v = v * 10 + (cs[at + i] as i64 - 48);
        i += 1;
    }
    v
}

fn ends_at(cs: ref Vec[char], at: i64) -> bool {
    at == cs.len() or (at == cs.len() - 1 and cs[at] == '\n')
}

// The tail of RE_TIMESTAMP from `at`: the fraction, the zone and `$`,
// trying the alternatives in the regex's order. Returns the fraction
// digits (without the dot) and the zone text.
fn match_tail(cs: ref Vec[char], at: i64) -> Option[(String, Option[String])] {
    let mut fracs: Vec[i64] = Vec.new();
    if at < cs.len() and cs[at] == '.' {
        let mut n = 0;
        while n < 15 and digit_run(cs, at + 1 + n, 1) {
            n += 1;
        }
        while n >= 1 {
            fracs.push(n);
            n -= 1;
        }
    }
    fracs.push(0);
    for fl in fracs.iter() {
        let p = if *fl > 0 { at + 1 + *fl } else { at };
        let frac = if *fl > 0 { slice_chars(cs, at + 1, p) } else { String.new() };
        // Z
        if p < cs.len() and cs[p] == 'Z' and ends_at(cs, p + 1) {
            return Some((frac, Some("Z".to_string())));
        }
        // [+-−][0-9]{2}:?(?:[0-9]{2})?
        if p < cs.len() and cs[p] as i64 >= 0x2B and cs[p] as i64 <= 0x2212 and digit_run(cs, p + 1, 2) {
            let q = p + 3;
            let colons = if q < cs.len() and cs[q] == ':' { [1, 0] } else { [0, -1] };
            for colon in colons {
                if colon < 0 {
                    continue;
                }
                let r = q + colon;
                if digit_run(cs, r, 2) and ends_at(cs, r + 2) {
                    return Some((frac, Some(slice_chars(cs, p, r + 2))));
                }
                if ends_at(cs, r) {
                    return Some((frac, Some(slice_chars(cs, p, r))));
                }
            }
        }
        if ends_at(cs, p) {
            return Some((frac, None));
        }
    }
    None
}

fn slice_chars(cs: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut i = lo;
    while i < hi {
        s.push(cs[i]);
        i += 1;
    }
    s
}

// RE_TIMESTAMP.match with the regex's backtracking over the 1-or-2
// digit fields: the six numbers, the fraction and the zone.
fn match_timestamp(s: ref String) -> Option[(Vec[i64], String, Option[String])] {
    let cs: Vec[char] = s.chars().collect();
    if not digit_run(cs, 0, 4) or cs.len() < 5 or cs[4] != '-' {
        return None;
    }
    let year = number_at(cs, 0, 4);
    for ml in [2, 1] {
        if not digit_run(cs, 5, ml) or 5 + ml >= cs.len() or cs[5 + ml] != '-' {
            continue;
        }
        let d0 = 6 + ml;
        for dl in [2, 1] {
            if not digit_run(cs, d0, dl) or d0 + dl >= cs.len() or (cs[d0 + dl] != 'T' and cs[d0 + dl] != ' ') {
                continue;
            }
            let h0 = d0 + dl + 1;
            for hl in [2, 1] {
                if not digit_run(cs, h0, hl) or h0 + hl >= cs.len() or cs[h0 + hl] != ':' {
                    continue;
                }
                let m0 = h0 + hl + 1;
                for mil in [2, 1] {
                    if not digit_run(cs, m0, mil) or m0 + mil >= cs.len() or cs[m0 + mil] != ':' {
                        continue;
                    }
                    let s0 = m0 + mil + 1;
                    for sl in [2, 1] {
                        if not digit_run(cs, s0, sl) {
                            continue;
                        }
                        if let Some((frac, zone)) = match_tail(cs, s0 + sl) {
                            let nums = vec![year, number_at(cs, 5, ml), number_at(cs, d0, dl), number_at(cs, h0, hl), number_at(cs, m0, mil), number_at(cs, s0, sl)];
                            return Some((nums, frac, zone));
                        }
                    }
                }
            }
        }
    }
    None
}

fn ascii_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return false;
        }
    }
    true
}

// SimpleTZ(s).offset
fn simple_tz(text: ref String) -> i64 {
    let cs: Vec[char] = text.chars().collect();
    if cs.len() < 2 {
        return 0;
    }
    let mut mult = 1;
    let mut from = 0;
    if cs[0] == '\u{2212}' or cs[0] == '-' {
        mult = -1;
        from = 1;
    } else if cs[0] == '+' {
        from = 1;
    }
    let rest = slice_chars(cs, from, cs.len());
    let rc: Vec[char] = rest.chars().collect();
    let head = slice_chars(rc, 0, if rc.len() < 2 { rc.len() } else { 2 });
    let hour = if ascii_digits(head) { number_at(rc, 0, head.len()) } else { 0 };
    let mut minute = 0;
    if rc.len() >= 4 {
        let tail = slice_chars(rc, rc.len() - 2, rc.len());
        if ascii_digits(tail) {
            minute = number_at(rc, rc.len() - 2, 2);
        }
    }
    mult * (hour * 60 + minute)
}

// gpxfield.parse_time behind TimeConverter, which turns every error into
// None.
fn parse_time(s: ref String) -> Option[Stamp] {
    if s.len() == 0 {
        return None;
    }
    match match_timestamp(s) {
        None => None,
        Some((n, frac, zone)) => {
            let fc: Vec[char] = frac.chars().collect();
            let f6 = slice_chars(fc, 0, if fc.len() < 6 { fc.len() } else { 6 });
            let mut micro = 0;
            if f6.len() > 0 {
                let mut padded = f6.clone();
                while padded.len() < 6 {
                    padded.push('0');
                }
                let pc: Vec[char] = padded.chars().collect();
                micro = number_at(pc, 0, 6);
            }
            if n[0] < 1 or n[1] < 1 or n[1] > 12 or n[2] < 1 or n[2] > days_in_month(n[0], n[1]) or n[3] > 23 or n[4] > 59 or n[5] > 59 {
                return None;
            }
            let tz = match zone {
                Some(z) => Some(simple_tz(z)),
                None => None,
            };
            Some(Stamp { year: n[0], month: n[1], day: n[2], hour: n[3], minute: n[4], second: n[5], micro: micro, tz: tz })
        }
    }
}
// ---------------------------------------------------------------- XML

// An ElementTree element: a tag in Clark notation ({uri}local) when it
// has a namespace, the attributes in document order, the text before
// the first child, and the tail after the element.
#[derive(Clone)]
struct Elem {
    tag: String,
    attrib: Vec[(String, String)],
    text: Option[String],
    tail: Option[String],
    children: Vec[Elem],
}

impl Elem {
    fn get(ref self, name: Str) -> Option[String] {
        for (k, v) in self.attrib.iter() {
            if *k == name {
                return Some(v.clone());
            }
        }
        None
    }

    // Element.find(tag) for a plain tag: the first child with that tag.
    fn find(ref self, tag: ref String) -> Option[i64] {
        let mut i = 0;
        while i < self.children.len() {
            if self.children[i].tag == *tag {
                return Some(i);
            }
            i += 1;
        }
        None
    }
}

// An element being built: its qualified name, its namespace scope and
// the data seen since the last start or end tag.
struct Open {
    qname: String,
    elem: Elem,
    scope: Vec[(String, String)],
}

struct XmlParser {
    cs: Vec[char],
    pos: i64,
    line: i64,
    line_start: i64,
}

fn xml_error(msg: Str, line: i64, col: i64) -> String {
    f"{msg}: line {line}, column {col}"
}

fn is_name_start(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or c == ':' or c as i64 >= 0xC0
}

fn is_name_char(c: char) -> bool {
    is_name_start(c) or (c >= '0' and c <= '9') or c == '-' or c == '.' or c as i64 == 0xB7
}

fn is_xml_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

impl XmlParser {
    fn at(ref self, i: i64) -> char {
        if i < self.cs.len() { self.cs[i] } else { '\u{0}' }
    }

    fn starts(ref self, s: Str) -> bool {
        let mut i = self.pos;
        for c in s.chars() {
            if i >= self.cs.len() or self.cs[i] != c {
                return false;
            }
            i += 1;
        }
        true
    }

    fn col_of(ref self, i: i64) -> i64 {
        i - self.line_start
    }

    // Moves to `to`, counting lines.
    fn advance_to(mut ref self, to: i64) {
        while self.pos < to {
            if self.cs[self.pos] == '\n' {
                self.line += 1;
                self.line_start = self.pos + 1;
            }
            self.pos += 1;
        }
    }

    fn err_here(ref self, msg: Str) -> String {
        xml_error(msg, self.line, self.col_of(self.pos))
    }

    fn skip_space(mut ref self) {
        while self.pos < self.cs.len() and is_xml_space(self.cs[self.pos]) {
            self.advance_to(self.pos + 1);
        }
    }

    fn name(mut ref self) -> Result[String, String] {
        if self.pos >= self.cs.len() {
            return Err(self.err_here("no element found"));
        }
        if not is_name_start(self.cs[self.pos]) {
            return Err(self.err_here("not well-formed (invalid token)"));
        }
        let from = self.pos;
        while self.pos < self.cs.len() and is_name_char(self.cs[self.pos]) {
            self.pos += 1;
        }
        Ok(slice_chars(self.cs, from, self.pos))
    }

    // A character or entity reference at `pos` (on '&').
    fn reference(mut ref self, out: mut ref String) -> Result[(), String] {
        let start = self.pos;
        let mut j = self.pos + 1;
        let mut body = String.new();
        while j < self.cs.len() and self.cs[j] != ';' {
            body.push(self.cs[j]);
            j += 1;
        }
        if j >= self.cs.len() {
            return Err(self.err_here("not well-formed (invalid token)"));
        }
        if body.starts_with("#") {
            let hex = body.starts_with("#x");
            let digits = if hex { body[2..].to_string() } else { body[1..].to_string() };
            let mut v: i64 = 0;
            let mut ok = digits.len() > 0;
            for c in digits.chars() {
                let d = if c >= '0' and c <= '9' {
                    c as i64 - 48
                } else if hex and c >= 'a' and c <= 'f' {
                    c as i64 - 87
                } else if hex and c >= 'A' and c <= 'F' {
                    c as i64 - 55
                } else {
                    -1
                };
                if d < 0 {
                    ok = false;
                    break;
                }
                v = v * (if hex { 16 } else { 10 }) + d;
                if v > 0x10FFFF {
                    ok = false;
                    break;
                }
            }
            match char.try_from(v as u32) {
                Ok(c) if ok => out.push(c),
                _ => return Err(xml_error("reference to invalid character number", self.line, self.col_of(start))),
            }
        } else if body == "lt" {
            out.push('<');
        } else if body == "gt" {
            out.push('>');
        } else if body == "amp" {
            out.push('&');
        } else if body == "quot" {
            out.push('"');
        } else if body == "apos" {
            out.push('\'');
        } else {
            return Err(xml_error("undefined entity", self.line, self.col_of(start)));
        }
        self.pos = j + 1;
        Ok(())
    }

    // An attribute value, with expat's normalization: references are
    // replaced, and literal tabs and line ends become spaces.
    fn attr_value(mut ref self) -> Result[String, String] {
        let quote = self.at(self.pos);
        if quote != '"' and quote != '\'' {
            return Err(self.err_here("not well-formed (invalid token)"));
        }
        self.pos += 1;
        let mut out = String.new();
        loop {
            if self.pos >= self.cs.len() {
                return Err(self.err_here("unclosed token"));
            }
            let c = self.cs[self.pos];
            if c == quote {
                self.pos += 1;
                return Ok(out);
            }
            if c == '<' {
                return Err(self.err_here("not well-formed (invalid token)"));
            }
            if c == '&' {
                self.reference(mut out)?;
                continue;
            }
            if c == '\r' {
                out.push(' ');
                if self.at(self.pos + 1) == '\n' {
                    self.pos += 1;
                }
                self.pos += 1;
                continue;
            }
            if c == '\n' or c == '\t' {
                out.push(' ');
                self.advance_to(self.pos + 1);
                continue;
            }
            // a run of plain characters
            let from = self.pos;
            while self.pos < self.cs.len() {
                let d = self.cs[self.pos];
                if d == quote or d == '<' or d == '&' or d == '\r' or d == '\n' or d == '\t' {
                    break;
                }
                self.pos += 1;
            }
            out.push_str(slice_chars(self.cs, from, self.pos));
        }
    }

    // Skips to just after `end`, counting lines.
    fn skip_past(mut ref self, end: Str, what: Str) -> Result[(), String] {
        while self.pos < self.cs.len() {
            if self.starts(end) {
                let n = end.len();
                self.advance_to(self.pos + n);
                return Ok(());
            }
            self.advance_to(self.pos + 1);
        }
        Err(self.err_here(what))
    }
}

fn resolve_name(qname: ref String, scopes: ref Vec[Open], extra: ref Vec[(String, String)], is_attr: bool) -> Option[String] {
    let (prefix, local) = match qname.find(":") {
        Some(i) => (qname[..i].to_string(), qname[i + 1..].to_string()),
        None => (String.new(), qname.clone()),
    };
    if prefix.len() == 0 and is_attr {
        return Some(qname.clone());
    }
    if prefix == "xml" {
        return Some(f"{{http://www.w3.org/XML/1998/namespace}}{local}");
    }
    for (p, uri) in extra.iter() {
        if *p == prefix {
            return if uri.len() == 0 { Some(local) } else { Some(f"{{{uri}}}{local}") };
        }
    }
    let mut k = scopes.len() - 1;
    while k >= 0 {
        for (p, uri) in scopes[k].scope.iter() {
            if *p == prefix {
                return if uri.len() == 0 { Some(local) } else { Some(f"{{{uri}}}{local}") };
            }
        }
        k -= 1;
    }
    if prefix.len() == 0 { Some(local) } else { None }
}

fn add_data(stack: mut ref Vec[Open], data: ref String) {
    // Text goes to the last finished child's tail, or the open element's text.
    if data.len() == 0 or stack.len() == 0 {
        return;
    }
    let top = stack.len() - 1;
    let n = stack[top].elem.children.len();
    if n > 0 {
        let child = mut ref stack[top].elem.children[n - 1];
        let mut t = match child.tail.clone() { Some(t) => t, None => String.new() };
        t.push_str(data);
        child.tail = Some(t);
    } else {
        let mut t = match stack[top].elem.text.clone() { Some(t) => t, None => String.new() };
        t.push_str(data);
        stack[top].elem.text = Some(t);
    }
}

// xml.etree.ElementTree.XML over expat: the root element, or expat's
// error message with its line and column.
fn parse_xml(text: ref String) -> Result[Elem, String] {
    let mut p = XmlParser { cs: text.chars().collect(), pos: 0, line: 1, line_start: 0 };
    if p.at(0) == '\u{feff}' {
        p.pos = 1;
        p.line_start = 1;
    }
    let mut stack: Vec[Open] = Vec.new();
    let mut root: Option[Elem] = None;
    let mut data = String.new();
    while p.pos < p.cs.len() {
        let c = p.cs[p.pos];
        if c == '<' {
            let next = p.at(p.pos + 1);
            if next == '!' and p.starts("<!--") {
                p.skip_past("-->", "unclosed token")?;
                continue;
            }
            if next == '!' and p.starts("<![CDATA[") {
                p.pos += 9;
                while p.pos < p.cs.len() and not p.starts("]]>") {
                    let ch = p.cs[p.pos];
                    if ch == '\r' {
                        data.push('\n');
                        if p.at(p.pos + 1) == '\n' {
                            p.pos += 1;
                        }
                        p.pos += 1;
                        continue;
                    }
                    data.push(ch);
                    p.advance_to(p.pos + 1);
                }
                if p.pos >= p.cs.len() {
                    return Err(p.err_here("unclosed CDATA section"));
                }
                p.pos += 3;
                continue;
            }
            if next == '?' {
                p.skip_past("?>", "unclosed token")?;
                continue;
            }
            if next == '!' {
                p.skip_past(">", "unclosed token")?;
                continue;
            }
            add_data(mut stack, data);
            data = String.new();
            if next == '/' {
                p.pos += 2;
                let name_line = p.line;
                let name_col = p.col_of(p.pos);
                let name = p.name()?;
                p.skip_space();
                if p.at(p.pos) != '>' {
                    return Err(p.err_here("not well-formed (invalid token)"));
                }
                p.pos += 1;
                if stack.len() == 0 or stack[stack.len() - 1].qname != name {
                    return Err(xml_error("mismatched tag", name_line, name_col));
                }
                if let Some(open) = stack.pop() {
                    let elem = open.elem;
                    if stack.len() == 0 {
                        root = Some(elem);
                    } else {
                        let top = stack.len() - 1;
                        stack[top].elem.children.push(elem);
                    }
                }
                continue;
            }
            let tag_line = p.line;
            let tag_col = p.col_of(p.pos);
            if root.is_some() {
                return Err(xml_error("junk after document element", tag_line, tag_col));
            }
            p.pos += 1;
            let qname = p.name()?;
            let mut raw: Vec[(String, String, i64, i64)] = Vec.new();
            let mut empty = false;
            loop {
                let had_space = p.pos < p.cs.len() and is_xml_space(p.cs[p.pos]);
                p.skip_space();
                if p.pos >= p.cs.len() {
                    return Err(p.err_here("no element found"));
                }
                let ch = p.cs[p.pos];
                if ch == '>' {
                    p.pos += 1;
                    break;
                }
                if ch == '/' and p.at(p.pos + 1) == '>' {
                    p.pos += 2;
                    empty = true;
                    break;
                }
                if not had_space {
                    return Err(p.err_here("not well-formed (invalid token)"));
                }
                let al = p.line;
                let ac = p.col_of(p.pos);
                let an = p.name()?;
                p.skip_space();
                if p.at(p.pos) != '=' {
                    return Err(p.err_here("not well-formed (invalid token)"));
                }
                p.pos += 1;
                p.skip_space();
                let av = p.attr_value()?;
                for (k, _, _, _) in raw.iter() {
                    if *k == an {
                        return Err(xml_error("duplicate attribute", al, ac));
                    }
                }
                raw.push((an, av, al, ac));
            }
            let mut scope: Vec[(String, String)] = Vec.new();
            for (k, v, _, _) in raw.iter() {
                if *k == "xmlns" {
                    scope.push((String.new(), v.clone()));
                } else if k.starts_with("xmlns:") {
                    scope.push((k[6..].to_string(), v.clone()));
                }
            }
            let tag = match resolve_name(qname, stack, scope, false) {
                Some(t) => t,
                None => return Err(xml_error("unbound prefix", tag_line, tag_col)),
            };
            let mut attrib: Vec[(String, String)] = Vec.new();
            for (k, v, _, _) in raw.iter() {
                if *k == "xmlns" or k.starts_with("xmlns:") {
                    continue;
                }
                match resolve_name(k, stack, scope, true) {
                    Some(n) => attrib.push((n, v.clone())),
                    None => return Err(xml_error("unbound prefix", tag_line, tag_col)),
                }
            }
            let elem = Elem { tag: tag, attrib: attrib, text: None, tail: None, children: Vec.new() };
            if empty {
                if stack.len() == 0 {
                    root = Some(elem);
                } else {
                    let top = stack.len() - 1;
                    stack[top].elem.children.push(elem);
                }
            } else {
                stack.push(Open { qname: qname, elem: elem, scope: scope });
            }
            continue;
        }
        if c == '&' {
            if stack.len() == 0 {
                return Err(p.err_here("not well-formed (invalid token)"));
            }
            p.reference(mut data)?;
            continue;
        }
        if c == '\r' {
            data.push('\n');
            if p.at(p.pos + 1) == '\n' {
                p.pos += 1;
            }
            p.pos += 1;
            p.line += 1;
            p.line_start = p.pos;
            continue;
        }
        if stack.len() == 0 and not is_xml_space(c) {
            if root.is_some() {
                return Err(p.err_here("junk after document element"));
            }
            return Err(p.err_here("syntax error"));
        }
        if stack.len() == 0 {
            data.push(c);
            p.advance_to(p.pos + 1);
            continue;
        }
        // a run of plain text
        let from = p.pos;
        while p.pos < p.cs.len() {
            let d = p.cs[p.pos];
            if d == '<' or d == '&' or d == '\r' {
                break;
            }
            if d == '\n' {
                p.line += 1;
                p.line_start = p.pos + 1;
            }
            p.pos += 1;
        }
        data.push_str(slice_chars(p.cs, from, p.pos));
    }
    if stack.len() > 0 or root.is_none() {
        return Err(p.err_here("no element found"));
    }
    match root {
        Some(r) => Ok(r),
        None => Err(p.err_here("no element found")),
    }
}
// ---------------------------------------------------------------- conversions

fn is_py_space(c: char) -> bool {
    let o = c as i64;
    (o >= 9 and o <= 13) or (o >= 0x1C and o <= 0x20) or o == 0x85 or o == 0xA0 or o == 0x1680
        or (o >= 0x2000 and o <= 0x200A) or o == 0x2028 or o == 0x2029 or o == 0x202F or o == 0x205F or o == 0x3000
}

// str.strip()
fn py_strip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    let mut b = cs.len();
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    slice_chars(cs, a, b)
}

// repr() of a str
fn py_repr(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let q = if has_single and not has_double { '"' } else { '\'' };
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if o < 0x20 or o == 0x7F {
            out.push_str("\\x");
            out.push(ds[o / 16]);
            out.push(ds[o % 16]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// The digits of a Python numeric literal with its underscores removed,
// or None where an underscore is not between two digits.
fn digits_part(cs: ref Vec[char], from: i64) -> (String, i64) {
    let mut out = String.new();
    let mut i = from;
    while i < cs.len() {
        let c = cs[i];
        if c >= '0' and c <= '9' {
            out.push(c);
            i += 1;
        } else if c == '_' and out.len() > 0 and i + 1 < cs.len() and cs[i + 1] >= '0' and cs[i + 1] <= '9' {
            i += 1;
        } else {
            break;
        }
    }
    (out, i)
}

// float(s) for a stripped s.
fn py_float(s: ref String) -> Option[f64] {
    // Without underscores Python accepts what f64.parse accepts.
    if not s.contains("_") {
        return f64.parse(s).ok();
    }
    let low = s.to_lowercase();
    let cs: Vec[char] = low.chars().collect();
    let mut i = 0;
    let mut sign = String.new();
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        sign.push(cs[i]);
        i += 1;
    }
    let rest = slice_chars(cs, i, cs.len());
    if rest == "inf" or rest == "infinity" {
        return if sign == "-" { Some(-1.0 / 0.0) } else { Some(1.0 / 0.0) };
    }
    if rest == "nan" {
        return Some(0.0 / 0.0);
    }
    let (whole, j) = digits_part(cs, i);
    let mut k = j;
    let mut frac = String.new();
    if k < cs.len() and cs[k] == '.' {
        let (f, k2) = digits_part(cs, k + 1);
        frac = f;
        k = k2;
    }
    if whole.len() == 0 and frac.len() == 0 {
        return None;
    }
    let mut exp = String.new();
    if k < cs.len() and cs[k] == 'e' {
        let mut m = k + 1;
        let mut es = String.new();
        if m < cs.len() and (cs[m] == '+' or cs[m] == '-') {
            es.push(cs[m]);
            m += 1;
        }
        let (ed, m2) = digits_part(cs, m);
        if ed.len() == 0 {
            return None;
        }
        exp = f"e{es}{ed}";
        k = m2;
    }
    if k != cs.len() {
        return None;
    }
    let w = if whole.len() == 0 { "0".to_string() } else { whole };
    let f = if frac.len() == 0 { "0".to_string() } else { frac };
    f64.parse(f"{sign}{w}.{f}{exp}").ok()
}

// int(s) for a stripped s.
fn py_int(s: ref String) -> Option[i64] {
    let cs: Vec[char] = s.chars().collect();
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let (d, j) = digits_part(cs, i);
    if d.len() == 0 or j != cs.len() {
        return None;
    }
    let mut v: i64 = 0;
    for c in d.chars() {
        v = v * 10 + (c as i64 - 48);
    }
    Some(if neg { -v } else { v })
}

// utils.make_str for a float: str(), or '.10f' stripped of zeros when
// str() uses an exponent.
fn float_str(x: f64) -> String {
    let s = py_float_repr(x);
    if not s.contains("e") {
        return s;
    }
    let mut t = f"{x:.10}";
    while t.ends_with("0") {
        t = t[..t.len() - 1].to_string();
    }
    if t.ends_with(".") {
        t = t[..t.len() - 1].to_string();
    }
    t
}

fn py_float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

fn val_str(v: ref Val) -> String {
    match v {
        Val.Nil => "None".to_string(),
        Val.Str(s) => s.clone(),
        Val.Num(x) => float_str(*x),
        Val.Int(i) => f"{i}",
        Val.Time(t) => stamp_str(t),
        _ => "?".to_string(),
    }
}

// str.lstrip(c)
fn lstrip_char(s: ref String, c: char) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut i = 0;
    while i < cs.len() and cs[i] == c {
        i += 1;
    }
    slice_chars(cs, i, cs.len())
}

// saxutils.escape
fn xml_escape(s: ref String) -> String {
    s.replace("&", "&amp;").replace(">", "&gt;").replace("<", "&lt;")
}

// ---------------------------------------------------------------- reading

struct GpxError {
    kind: String,
    msg: String,
}

fn gpx_error(msg: ref String) -> GpxError {
    GpxError { kind: "GPXException".to_string(), msg: msg.clone() }
}

fn opt_text(o: ref Option[String]) -> String {
    match o {
        Some(s) => s.clone(),
        None => "None".to_string(),
    }
}

// GPXField.from_xml
fn simple_from_xml(f: ref Field, node: ref Elem) -> Result[Val, GpxError] {
    let mut result: Option[String] = None;
    if let Some(a) = ref f.attribute {
        result = node.get(a.as_str());
    } else if let Some(t) = ref f.tag {
        if let Some(i) = node.find(t) {
            result = node.children[i].text.clone();
        }
    }
    let raw = match result {
        None => {
            if f.mandatory {
                return Err(gpx_error(f"{f.name} is mandatory in {opt_text(f.tag)} (got None)"));
            }
            return Ok(Val.Nil);
        }
        Some(r) => r,
    };
    let value = if f.conv == T_FLOAT {
        let s = py_strip(raw);
        match py_float(s) {
            Some(x) => Val.Num(x),
            None => return Err(gpx_error(f"Invalid value for <{opt_text(f.tag)}>... {raw} (could not convert string to float: {py_repr(s)})")),
        }
    } else if f.conv == T_INT {
        let s = py_strip(raw);
        match py_int(s) {
            Some(x) => Val.Int(x),
            None => return Err(gpx_error(f"Invalid value for <{opt_text(f.tag)}>... {raw} (invalid literal for int() with base 10: {py_repr(s)})")),
        }
    } else if f.conv == T_TIME {
        match parse_time(raw) {
            Some(t) => Val.Time(t),
            None => Val.Nil,
        }
    } else {
        Val.Str(raw.clone())
    };
    if f.possible.len() > 0 {
        let s = match ref value {
            Val.Str(s) => s.clone(),
            _ => String.new(),
        };
        let mut found = false;
        for p in f.possible.iter() {
            if *p == s {
                found = true;
            }
        }
        if not found {
            let mut parts: Vec[String] = Vec.new();
            for p in f.possible.iter() {
                parts.push(py_repr(p));
            }
            return Err(gpx_error(f"Invalid value \"{s}\", possible: ({parts.join(", ")})"));
        }
    }
    Ok(value)
}

// gpx_fields_from_xml
fn fields_from_xml(schema: ref Schema, cls: i64, node: ref Elem, version: ref Option[String]) -> Result[Obj, GpxError] {
    let mut result = new_obj(cls);
    let v11 = match version {
        Some(v) => *v == "1.1",
        None => false,
    };
    let fields = if v11 { ref schema.v11[cls] } else { ref schema.v10[cls] };
    // node_path below the object's own node: Some(element) or None
    let mut path: Vec[Option[Elem]] = Vec.new();
    for f in fields.iter() {
        if f.kind == K_MARK {
            let (tag, _) = split_once(f.name, ":");
            if tag.starts_with("/") {
                path.pop();
            } else {
                let next = if path.len() == 0 {
                    match node.find(tag) {
                        Some(i) => Some(node.children[i].clone()),
                        None => None,
                    }
                } else {
                    match ref path[path.len() - 1] {
                        Some(cur) => match cur.find(tag) {
                            Some(i) => Some(cur.children[i].clone()),
                            None => None,
                        },
                        None => None,
                    }
                };
                path.push(next);
            }
            continue;
        }
        let current: Option[Elem] = if path.len() == 0 { None } else { path[path.len() - 1].clone() };
        let have = path.len() == 0 or current.is_some();
        if have {
            let value = match ref current {
                Some(cur) => field_from_xml(schema, f, cur, version)?,
                None => field_from_xml(schema, f, node, version)?,
            };
            store(mut result, f, value);
        } else if f.attribute.is_some() {
            let value = field_from_xml(schema, f, node, version)?;
            store(mut result, f, value);
        }
    }
    Ok(result)
}

// A list field's objects go to the object's list, the rest to its value.
fn store(obj: mut ref Obj, f: ref Field, value: own Val) {
    if f.kind == K_COMPLEX and f.is_list {
        if let Val.One(objs) = value {
            obj.lists[f.list] = objs;
        }
    } else {
        obj.vals[f.slot] = value;
    }
}

fn split_once(s: ref String, sep: Str) -> (String, String) {
    match s.find(sep) {
        Some(i) => (s[..i].to_string(), s[i + sep.len()..].to_string()),
        None => (s.clone(), String.new()),
    }
}

fn field_from_xml(schema: ref Schema, f: ref Field, node: ref Elem, version: ref Option[String]) -> Result[Val, GpxError] {
    if f.kind == K_SIMPLE {
        return simple_from_xml(f, node);
    }
    let tag = opt_text(f.tag);
    if f.kind == K_COMPLEX {
        if f.is_list {
            let mut out: Vec[Obj] = Vec.new();
            for child in node.children.iter() {
                if child.tag == tag {
                    out.push(fields_from_xml(schema, f.cls, child, version)?);
                }
            }
            return Ok(Val.One(out));
        }
        return match node.find(tag) {
            Some(i) => Ok(Val.One(vec![fields_from_xml(schema, f.cls, node.children[i], version)?])),
            None => Ok(Val.Nil),
        };
    }
    if f.kind == K_EMAIL {
        return match node.find(tag) {
            None => Ok(Val.Str(String.new())),
            Some(i) => {
                let e = ref node.children[i];
                Ok(Val.Str(f"{opt_text(e.get("id"))}@{opt_text(e.get("domain"))}"))
            }
        };
    }
    // K_EXT
    match node.find(tag) {
        None => Ok(Val.Elems(Vec.new())),
        Some(i) => Ok(Val.Elems(node.children[i].children.clone())),
    }
}

// ---------------------------------------------------------------- writing

// utils.to_xml(tag, content=..., escape=True)
fn tag_xml(tag: ref String, content: ref String, indent: ref String) -> String {
    f"\n{indent}<{tag}>{xml_escape(content)}</{tag}>"
}

fn simple_to_xml(f: ref Field, value: ref Val, indent: ref String) -> String {
    if let Val.Nil = value {
        return String.new();
    }
    if let Some(a) = ref f.attribute {
        return f"{a}=\"{val_str(value)}\"";
    }
    let content = match value {
        Val.Time(t) => format_time(t),
        _ => val_str(value),
    };
    match ref f.tag {
        Some(t) => tag_xml(t, content, indent),
        None => String.new(),
    }
}

// GPXExtensionsField._resolve_prefix
fn resolve_prefix(qname: ref String, nsmap: ref Vec[(String, String)]) -> String {
    if not qname.contains("}") {
        return qname.clone();
    }
    let (uri0, local) = split_once(qname, "}");
    let uri = lstrip_char(uri0, '{');
    for (prefix, ns) in nsmap.iter() {
        if *ns == uri {
            return f"{prefix}:{local}";
        }
    }
    f"{uri}:{local}"
}

fn etree_to_xml(node: ref Elem, nsmap: ref Vec[(String, String)], indent0: ref String, pretty: bool) -> String {
    let indent = if pretty { indent0.clone() } else { String.new() };
    let mut out = String.new();
    let name = resolve_prefix(node.tag, nsmap);
    out.push_str(f"\n{indent}<{name}");
    for (k, v) in node.attrib.iter() {
        out.push_str(f" {resolve_prefix(k, nsmap)}=\"{v}\"");
    }
    out.push_str(">");
    if let Some(t) = ref node.text {
        out.push_str(py_strip(t));
    }
    let deeper = f"{indent}  ";
    for child in node.children.iter() {
        out.push_str(etree_to_xml(child, nsmap, deeper, pretty));
    }
    let tail = match ref node.tail {
        Some(t) => py_strip(t),
        None => String.new(),
    };
    if node.children.len() > 0 {
        out.push_str(f"\n{indent}");
    }
    out.push_str(f"</{name}>{tail}");
    out
}

fn field_to_xml(schema: ref Schema, obj: ref Obj, f: ref Field, value: ref Val, version: ref String, nsmap: ref Vec[(String, String)], indent0: ref String, pretty: bool) -> String {
    let indent = if pretty { indent0.clone() } else { String.new() };
    if f.kind == K_SIMPLE {
        return simple_to_xml(f, value, indent);
    }
    let tag = opt_text(f.tag);
    if f.kind == K_COMPLEX {
        if f.is_list {
            let mut out = String.new();
            for o in obj.lists[f.list].iter() {
                out.push_str(fields_to_xml(schema, o, tag, version, Vec.new(), nsmap, indent, false, pretty));
            }
            return out;
        }
        return match value {
            Val.One(objs) => fields_to_xml(schema, objs[0], tag, version, Vec.new(), Vec.new(), indent, f.empty_body, pretty),
            _ => String.new(),
        };
    }
    if f.kind == K_EMAIL {
        let s = match value {
            Val.Str(s) => s.clone(),
            _ => String.new(),
        };
        if s.len() == 0 {
            return String.new();
        }
        let (id, domain) = match s.find("@") {
            Some(i) => (s[..i].to_string(), s[i + 1..].to_string()),
            None => (s.clone(), "unknown".to_string()),
        };
        return f"\n{indent}<{tag} id=\"{id}\" domain=\"{domain}\" />";
    }
    let elems = match value {
        Val.Elems(e) => e.clone(),
        _ => Vec.new(),
    };
    if elems.len() == 0 or *version != "1.1" {
        return String.new();
    }
    let mut out = f"\n{indent}<{tag}>";
    let deeper = f"{indent}  ";
    for e in elems.iter() {
        out.push_str(etree_to_xml(e, nsmap, deeper, pretty));
    }
    out.push_str(f"\n{indent}</{tag}>");
    out
}

// _check_dependents: ('/' + tag, tag) when no named attribute has data.
fn check_dependents(obj: ref Obj, f: ref Field) -> (String, String) {
    if f.name.contains(":") {
        let (tag, _) = split_once(f.name, ":");
        for slot in f.deps.iter() {
            if truthy(obj.vals[*slot]) {
                return (String.new(), tag);
            }
        }
        return (f"/{tag}", tag);
    }
    (String.new(), f.name.clone())
}

// gpx_fields_to_xml
fn fields_to_xml(schema: ref Schema, obj: ref Obj, tag: ref String, version: ref String, custom: ref Vec[(String, String)], nsmap: ref Vec[(String, String)], indent0: ref String, empty_body: bool, pretty: bool) -> String {
    let fields = if *version == "1.1" { ref schema.v11[obj.cls] } else { ref schema.v10[obj.cls] };
    let mut indent = if pretty { indent0.clone() } else { String.new() };
    let mut tag_open = tag.len() > 0;
    let mut body = String.new();
    if tag.len() > 0 {
        body.push_str(f"\n{indent}<{tag}");
        if *tag == "gpx" {
            let mut default = String.new();
            let mut others: Vec[(String, String)] = Vec.new();
            for (k, v) in nsmap.iter() {
                if *k == "defaultns" {
                    default = v.clone();
                } else {
                    others.push((k.clone(), v.clone()));
                }
            }
            body.push_str(f" xmlns=\"{default}\"");
            others.sort_by(|a, b| a.0.cmp(b.0));
            for (k, v) in others.iter() {
                body.push_str(f" xmlns:{k}=\"{v}\"");
            }
        }
        let mut keys = custom.clone();
        keys.sort_by(|a, b| a.0.cmp(b.0));
        for (k, v) in keys.iter() {
            body.push_str(f" {k}=\"{v}\"");
        }
    }
    let mut suppress = String.new();
    for f in fields.iter() {
        if f.kind == K_MARK {
            if suppress.len() > 0 {
                if suppress == f.name {
                    suppress = String.new();
                }
            } else {
                let (s, name) = check_dependents(obj, f);
                suppress = s;
                if suppress.len() == 0 {
                    if tag_open {
                        body.push_str(">");
                        tag_open = false;
                    }
                    if name.starts_with("/") {
                        body.push_str(f"\n{indent}<{name}>");
                        if pretty and indent.len() > 1 {
                            indent = indent[..indent.len() - 2].to_string();
                        }
                    } else {
                        if pretty {
                            indent.push_str("  ");
                        }
                        body.push_str(f"\n{indent}<{name}");
                        tag_open = true;
                    }
                }
            }
            continue;
        }
        if suppress.len() > 0 {
            continue;
        }
        let value = ref obj.vals[f.slot];
        let deeper = if pretty { f"{indent}  " } else { String.new() };
        if f.attribute.is_some() {
            body.push_str(" ");
            body.push_str(simple_to_xml(f, value, deeper));
        } else if not is_nil(value) or (f.kind == K_COMPLEX and f.is_list) {
            if tag_open {
                body.push_str(">");
                tag_open = false;
            }
            let x = field_to_xml(schema, obj, f, value, version, nsmap, deeper, pretty);
            body.push_str(x);
        }
    }
    if tag.len() > 0 {
        if empty_body {
            body.push_str(" />");
        } else {
            if tag_open {
                body.push_str(">");
            }
            body.push_str(f"\n{indent}</{tag}>");
        }
    }
    body
}

fn is_nil(v: ref Val) -> bool {
    match v {
        Val.Nil => true,
        _ => false,
    }
}
// ---------------------------------------------------------------- geo

const PI: f64 = 3.141592653589793;
const EARTH_RADIUS: f64 = 6378137.0;

fn one_degree() -> f64 {
    (2.0 * PI * EARTH_RADIUS) / 360.0
}

// math.radians and math.degrees
fn radians(x: f64) -> f64 {
    x * (PI / 180.0)
}

fn degrees(x: f64) -> f64 {
    x * (180.0 / PI)
}

// Python's float %: the result takes the divisor's sign.
fn py_mod(a: f64, b: f64) -> f64 {
    let m = a % b;
    if m != 0.0 and (m < 0.0) != (b < 0.0) { m + b } else { m }
}

// sum() of floats, compensated as CPython 3.12 does (Neumaier).
fn fsum(xs: ref Vec[f64]) -> f64 {
    let mut s = 0.0;
    let mut c = 0.0;
    for x in xs.iter() {
        let t = s + *x;
        if s.abs() >= x.abs() {
            c += (s - t) + *x;
        } else {
            c += (*x - t) + s;
        }
        s = t;
    }
    if c != 0.0 and c - c == 0.0 { s + c } else { s }
}

fn haversine_distance(lat1d: f64, lon1d: f64, lat2d: f64, lon2d: f64) -> f64 {
    let d_lon = radians(lon1d - lon2d);
    let lat1 = radians(lat1d);
    let lat2 = radians(lat2d);
    let d_lat = lat1 - lat2;
    let a = (d_lat / 2.0).sin().pow(2.0) + (d_lon / 2.0).sin().pow(2.0) * lat1.cos() * lat2.cos();
    let c = 2.0 * a.sqrt().asin();
    EARTH_RADIUS * c
}

fn get_course(lat1d: f64, lon1d: f64, lat2d: f64, lon2d: f64, loxodromic: bool) -> f64 {
    let mut d_lon = radians(lon2d - lon1d);
    let lat1 = radians(lat1d);
    let lat2 = radians(lat2d);
    let mut x = 0.0;
    let mut y = 0.0;
    if not loxodromic {
        y = d_lon.sin() * lat2.cos();
        x = lat1.cos() * lat2.sin() - lat1.sin() * lat2.cos() * d_lon.cos();
    } else {
        let radian_circle = 2.0 * PI;
        if d_lon.abs() > PI {
            if d_lon > 0.0 {
                d_lon = -(radian_circle - d_lon);
            } else {
                d_lon = radian_circle + d_lon;
            }
        }
        y = d_lon;
        let delta = PI / 4.0;
        x = ((delta + 0.5 * lat2).tan() / (delta + 0.5 * lat1).tan()).ln();
    }
    py_mod(degrees(y.atan2(x)), 360.0)
}

// geo.distance
fn distance(lat1: f64, lon1: f64, ele1: Option[f64], lat2: f64, lon2: f64, ele2: Option[f64]) -> f64 {
    if (lat1 - lat2).abs() > 0.2 or (lon1 - lon2).abs() > 0.2 {
        return haversine_distance(lat1, lon1, lat2, lon2);
    }
    let coef = radians(lat1).cos();
    let x = lat1 - lat2;
    let y = (lon1 - lon2) * coef;
    let distance_2d = (x * x + y * y).sqrt() * one_degree();
    match (ele1, ele2) {
        (Some(a), Some(b)) if a != b => (distance_2d.pow(2.0) + (a - b).pow(2.0)).sqrt(),
        _ => distance_2d,
    }
}

// Location.distance_2d and distance_3d
fn dist2(a: ref Obj, b: ref Obj) -> f64 {
    distance(a.f(S_LATITUDE), a.f(S_LONGITUDE), None, b.f(S_LATITUDE), b.f(S_LONGITUDE), None)
}

fn dist3(a: ref Obj, b: ref Obj) -> f64 {
    distance(a.f(S_LATITUDE), a.f(S_LONGITUDE), a.num(S_ELEVATION), b.f(S_LATITUDE), b.f(S_LONGITUDE), b.num(S_ELEVATION))
}

fn length_of(points: ref Vec[Obj], three_d: bool) -> f64 {
    let mut total = 0.0;
    let mut i = 1;
    while i < points.len() {
        let d = if three_d { dist3(points[i], points[i - 1]) } else { dist2(points[i], points[i - 1]) };
        if d != 0.0 {
            total += d;
        }
        i += 1;
    }
    total
}

fn calculate_max_speed(sd: ref Vec[(f64, f64)], percentile: f64, ignore_nonstandard: bool) -> Option[f64] {
    if not ignore_nonstandard {
        // max() keeps the first of equal values
        let mut best = sd[0].0;
        for (s, _) in sd.iter() {
            if *s > best {
                best = *s;
            }
        }
        return Some(best);
    }
    let size = sd.len();
    if size < 2 {
        return None;
    }
    let mut distances: Vec[f64] = Vec.new();
    for (_, d) in sd.iter() {
        distances.push(*d);
    }
    let average = fsum(distances) / size as f64;
    let mut squares: Vec[f64] = Vec.new();
    for d in distances.iter() {
        squares.push((*d - average).pow(2.0));
    }
    let deviation = (fsum(squares) / size as f64).sqrt();
    let mut speeds: Vec[f64] = Vec.new();
    for (s, d) in sd.iter() {
        if (*d - average).abs() <= deviation * 1.5 {
            speeds.push(*s);
        }
    }
    if speeds.len() == 0 {
        return None;
    }
    speeds.sort_by(|a, b| a.partial_cmp(b).unwrap());
    let mut index = (speeds.len() as f64 * (1.0 - percentile)) as i64;
    if index >= speeds.len() {
        index = speeds.len() - 1;
    }
    Some(speeds[index])
}

fn calculate_uphill_downhill(all: ref Vec[Option[f64]]) -> (f64, f64) {
    let mut e: Vec[f64] = Vec.new();
    for x in all.iter() {
        if let Some(v) = x {
            e.push(*v);
        }
    }
    let size = e.len();
    let mut smoothed: Vec[f64] = Vec.new();
    let mut n = 0;
    while n < size {
        if n > 0 and n < size - 1 {
            smoothed.push(e[n - 1] * 0.3 + e[n] * 0.4 + e[n + 1] * 0.3);
        } else {
            smoothed.push(e[n]);
        }
        n += 1;
    }
    let mut up = 0.0;
    let mut down = 0.0;
    let mut i = 1;
    while i < smoothed.len() {
        let d = smoothed[i] - smoothed[i - 1];
        if d > 0.0 {
            up += d;
        } else {
            down -= d;
        }
        i += 1;
    }
    (up, down)
}

fn elevation_angle(a: ref Obj, b: ref Obj) -> Option[f64] {
    match (a.num(S_ELEVATION), b.num(S_ELEVATION)) {
        (Some(e1), Some(e2)) => {
            let rise = e2 - e1;
            let run = dist2(b, a);
            if run == 0.0 {
                return Some(0.0);
            }
            Some(degrees((rise / run).atan()))
        }
        _ => None,
    }
}

fn distance_from_line(p: ref Obj, l1: ref Obj, l2: ref Obj) -> f64 {
    let a = dist2(l1, l2);
    if a == 0.0 {
        return dist2(l1, p);
    }
    let b = dist2(l1, p);
    let c = dist2(l2, p);
    let s = (a + b + c) / 2.0;
    2.0 * (s * (s - a) * (s - b) * (s - c)).abs().sqrt() / a
}

fn line_coefficients(p1: ref Obj, p2: ref Obj) -> (f64, f64, f64) {
    if p1.f(S_LONGITUDE) == p2.f(S_LONGITUDE) {
        return (0.0, 1.0, -p1.f(S_LONGITUDE));
    }
    let a = (p1.f(S_LATITUDE) - p2.f(S_LATITUDE)) / (p1.f(S_LONGITUDE) - p2.f(S_LONGITUDE));
    let b = p1.f(S_LATITUDE) - p1.f(S_LONGITUDE) * a;
    (1.0, -a, -b)
}

// Ramer-Douglas-Peucker on indices into `points`.
fn simplify_polyline(points: ref Vec[Obj], lo: i64, hi: i64, max_distance: f64, out: mut ref Vec[i64]) {
    // points[lo..=hi]; appends the kept indices except the last
    if hi - lo + 1 < 3 {
        let mut i = lo;
        while i < hi {
            out.push(i);
            i += 1;
        }
        return;
    }
    let (a, b, c) = line_coefficients(points[lo], points[hi]);
    let mut best = 0.0;
    let mut best_at = lo + 1;
    let mut i = lo + 1;
    while i < hi {
        let p = ref points[i];
        let d = (a * p.f(S_LATITUDE) + b * p.f(S_LONGITUDE) + c).abs();
        if d > best {
            best = d;
            best_at = i;
        }
        i += 1;
    }
    let real = distance_from_line(points[best_at], points[lo], points[hi]);
    if real < max_distance {
        out.push(lo);
        return;
    }
    simplify_polyline(points, lo, best_at, max_distance, mut out);
    simplify_polyline(points, best_at, hi, max_distance, mut out);
}

// LocationDelta.move for both kinds of delta.
fn move_point(p: mut ref Obj, by_angle: bool, a: f64, b: f64) {
    let lat = p.f(S_LATITUDE);
    let lon = p.f(S_LONGITUDE);
    if by_angle {
        let coef = radians(lat).cos();
        let vertical = radians(90.0 - b).sin() / one_degree();
        let horizontal = radians(90.0 - b).cos() / one_degree();
        p.vals[S_LATITUDE] = Val.Num(lat + a * vertical);
        p.vals[S_LONGITUDE] = Val.Num(lon + a * horizontal / coef);
    } else {
        p.vals[S_LATITUDE] = Val.Num(lat + a);
        p.vals[S_LONGITUDE] = Val.Num(lon + b);
    }
}
// ---------------------------------------------------------------- track points

// A GPX file: its object tree and what the parser kept from the raw
// text (the namespace prefixes and the schema locations).
#[derive(Clone)]
struct Gpx {
    root: Obj,
    nsmap: Vec[(String, String)],
    schema_locations: Vec[String],
}

// dict-style assignment: replaces the value of a known key in place.
fn ns_set(nsmap: mut ref Vec[(String, String)], key: Str, value: ref String) {
    let mut i = 0;
    while i < nsmap.len() {
        if nsmap[i].0 == key {
            nsmap[i] = (key.to_string(), value.clone());
            return;
        }
        i += 1;
    }
    nsmap.push((key.to_string(), value.clone()));
}

fn nonzero(x: Option[f64]) -> bool {
    match x {
        Some(v) => v != 0.0,
        None => false,
    }
}

// datetime - datetime, in microseconds
fn diff_us(a: ref Stamp, b: ref Stamp) -> i64 {
    a.utc_us() - b.utc_us()
}

fn later(a: ref Stamp, b: ref Stamp) -> bool {
    a.utc_us() > b.utc_us()
}

fn stamp_or_none(t: ref Option[Stamp]) -> String {
    match t {
        Some(s) => stamp_str(s),
        None => "None".to_string(),
    }
}

// GPXTrackPoint.time_difference
fn time_difference(a: ref Obj, b: ref Obj) -> Option[f64] {
    match (a.time(), b.time()) {
        (Some(t1), Some(t2)) => {
            if t1.same_as(t2) {
                return Some(0.0);
            }
            let d = diff_us(t1, t2);
            Some(total_seconds(if d < 0 { -d } else { d }))
        }
        _ => None,
    }
}

// GPXTrackPoint.speed_between
fn speed_between(a: ref Obj, b: ref Obj) -> Option[f64] {
    let seconds = time_difference(a, b);
    let mut length = dist3(a, b);
    if length == 0.0 {
        length = dist2(a, b);
    }
    match seconds {
        Some(s) if s != 0.0 => Some(length / s),
        _ => None,
    }
}

// GPXTrackSegment.get_speed
fn get_speed(points: ref Vec[Obj], i: i64) -> Option[f64] {
    let n = points.len();
    let mut s1: Option[f64] = None;
    let mut s2: Option[f64] = None;
    if i > 0 and i < n {
        s1 = speed_between(points[i], points[i - 1]);
    }
    if i >= 0 and i < n - 1 {
        s2 = speed_between(points[i], points[i + 1]);
    }
    if nonzero(s1) {
        s1 = Some(s1.unwrap().abs());
    }
    if nonzero(s2) {
        s2 = Some(s2.unwrap().abs());
    }
    if nonzero(s1) and nonzero(s2) {
        return Some((s1.unwrap() + s2.unwrap()) / 2.0);
    }
    if nonzero(s1) {
        return s1;
    }
    s2
}

// ---------------------------------------------------------------- statistics

// Most statistics walk the tracks, then the segments, adding up at each
// level as gpxpy does (the order of float additions is kept).

fn track_length(t: ref Obj, three_d: bool) -> f64 {
    let mut total = 0.0;
    for s in t.lists[L_MAIN].iter() {
        let d = length_of(s.lists[L_MAIN], three_d);
        if d != 0.0 {
            total += d;
        }
    }
    total
}

fn gpx_length(tracks: ref Vec[Obj], three_d: bool) -> f64 {
    let mut total = 0.0;
    for t in tracks.iter() {
        let d = track_length(t, three_d);
        if d != 0.0 {
            total += d;
        }
    }
    total
}

#[derive(Clone)]
struct Moving {
    moving_time: f64,
    stopped_time: f64,
    moving_distance: f64,
    stopped_distance: f64,
    max_speed: f64,
}

fn no_moving() -> Moving {
    Moving { moving_time: 0.0, stopped_time: 0.0, moving_distance: 0.0, stopped_distance: 0.0, max_speed: 0.0 }
}

// GPXTrackSegment.get_moving_data with the default threshold of 1 km/h
fn seg_moving(points: ref Vec[Obj], raw: bool) -> Moving {
    let percentile = if raw { 0.0 } else { 0.05 };
    let mut m = no_moving();
    let mut sd: Vec[(f64, f64)] = Vec.new();
    let mut i = 1;
    while i < points.len() {
        let prev = ref points[i - 1];
        let point = ref points[i];
        if let (Some(t1), Some(t0)) = (point.time(), prev.time()) {
            let distance = if nonzero(point.num(S_ELEVATION)) and nonzero(prev.num(S_ELEVATION)) {
                dist3(point, prev)
            } else {
                dist2(point, prev)
            };
            let seconds = total_seconds(diff_us(t1, t0));
            if seconds > 0.0 {
                let speed_kmh = (distance / 1000.0) / (seconds / 3600.0);
                if distance != 0.0 {
                    if speed_kmh <= 1.0 {
                        m.stopped_time += seconds;
                        m.stopped_distance += distance;
                    } else {
                        m.moving_time += seconds;
                        m.moving_distance += distance;
                    }
                    if m.moving_time != 0.0 {
                        sd.push((distance / seconds, distance));
                    }
                }
            }
        }
        i += 1;
    }
    if sd.len() > 0 {
        m.max_speed = calculate_max_speed(sd, percentile, not raw).unwrap_or(0.0);
    }
    m
}

fn add_moving(total: mut ref Moving, m: ref Moving) {
    total.moving_time += m.moving_time;
    total.stopped_time += m.stopped_time;
    total.moving_distance += m.moving_distance;
    total.stopped_distance += m.stopped_distance;
    if m.max_speed > total.max_speed {
        total.max_speed = m.max_speed;
    }
}

fn gpx_moving(tracks: ref Vec[Obj], raw: bool) -> Moving {
    let mut total = no_moving();
    for t in tracks.iter() {
        let mut tm = no_moving();
        for s in t.lists[L_MAIN].iter() {
            add_moving(mut tm, seg_moving(s.lists[L_MAIN], raw));
        }
        add_moving(mut total, tm);
    }
    total
}

fn seg_time_bounds(points: ref Vec[Obj]) -> (Option[Stamp], Option[Stamp]) {
    let mut start: Option[Stamp] = None;
    let mut end: Option[Stamp] = None;
    for p in points.iter() {
        if let Some(t) = p.time() {
            if start.is_none() {
                start = Some(t.clone());
            }
            end = Some(t);
        }
    }
    (start, end)
}

fn gpx_time_bounds(tracks: ref Vec[Obj]) -> (Option[Stamp], Option[Stamp]) {
    let mut start: Option[Stamp] = None;
    let mut end: Option[Stamp] = None;
    for t in tracks.iter() {
        let mut ts: Option[Stamp] = None;
        let mut te: Option[Stamp] = None;
        for s in t.lists[L_MAIN].iter() {
            let (a, b) = seg_time_bounds(s.lists[L_MAIN]);
            if ts.is_none() and a.is_some() {
                ts = a;
            }
            if b.is_some() {
                te = b;
            }
        }
        if start.is_none() {
            start = ts;
        }
        if te.is_some() {
            end = te;
        }
    }
    (start, end)
}

// min() and max() of two floats, keeping the first of equal ones
fn min2(a: f64, b: f64) -> f64 {
    if b < a { b } else { a }
}

fn max2(a: f64, b: f64) -> f64 {
    if b > a { b } else { a }
}

type Bounds = (f64, f64, f64, f64);

fn max_bounds(a: ref Bounds, b: ref Bounds) -> Bounds {
    (min2(a.0, b.0), max2(a.1, b.1), min2(a.2, b.2), max2(a.3, b.3))
}

fn seg_bounds(points: ref Vec[Obj]) -> Option[Bounds] {
    let mut lo_lat: Option[f64] = None;
    let mut hi_lat: Option[f64] = None;
    let mut lo_lon: Option[f64] = None;
    let mut hi_lon: Option[f64] = None;
    for p in points.iter() {
        let lat = p.f(S_LATITUDE);
        let lon = p.f(S_LONGITUDE);
        if lo_lat.is_none() or lat < lo_lat.unwrap() {
            lo_lat = Some(lat);
        }
        if hi_lat.is_none() or lat > hi_lat.unwrap() {
            hi_lat = Some(lat);
        }
        if lo_lon.is_none() or lon < lo_lon.unwrap() {
            lo_lon = Some(lon);
        }
        if hi_lon.is_none() or lon > hi_lon.unwrap() {
            hi_lon = Some(lon);
        }
    }
    if nonzero(lo_lat) and nonzero(hi_lat) and nonzero(lo_lon) and nonzero(hi_lon) {
        return Some((lo_lat.unwrap(), hi_lat.unwrap(), lo_lon.unwrap(), hi_lon.unwrap()));
    }
    None
}

fn gpx_bounds(tracks: ref Vec[Obj]) -> Option[Bounds] {
    let mut result: Option[Bounds] = None;
    for t in tracks.iter() {
        let mut tb: Option[Bounds] = None;
        for s in t.lists[L_MAIN].iter() {
            let sb = seg_bounds(s.lists[L_MAIN]);
            tb = match (tb, sb) {
                (None, x) => x,
                (Some(a), Some(b)) => Some(max_bounds(a, b)),
                (Some(a), None) => Some(a),
            };
        }
        result = match (result, tb) {
            (None, x) => x,
            (Some(r), Some(b)) => Some(max_bounds(b, r)),
            (Some(r), None) => Some(r),
        };
    }
    result
}

fn min_max(v: ref Vec[f64]) -> (Option[f64], Option[f64]) {
    if v.len() == 0 {
        return (None, None);
    }
    let mut lo = v[0];
    let mut hi = v[0];
    for x in v.iter() {
        lo = min2(lo, *x);
        hi = max2(hi, *x);
    }
    (Some(lo), Some(hi))
}

fn push_extremes(out: mut ref Vec[f64], mm: (Option[f64], Option[f64])) {
    if let Some(a) = mm.0 {
        out.push(a);
    }
    if let Some(b) = mm.1 {
        out.push(b);
    }
}

fn gpx_elevation_extremes(tracks: ref Vec[Obj]) -> (Option[f64], Option[f64]) {
    let mut all: Vec[f64] = Vec.new();
    for t in tracks.iter() {
        let mut tv: Vec[f64] = Vec.new();
        for s in t.lists[L_MAIN].iter() {
            let mut sv: Vec[f64] = Vec.new();
            for p in s.lists[L_MAIN].iter() {
                if let Some(e) = p.num(S_ELEVATION) {
                    sv.push(e);
                }
            }
            push_extremes(mut tv, min_max(sv));
        }
        push_extremes(mut all, min_max(tv));
    }
    min_max(all)
}

fn seg_duration(points: ref Vec[Obj]) -> Option[f64] {
    let n = points.len();
    if n < 2 {
        return Some(0.0);
    }
    let first = if points[0].time().is_some() { points[0].time() } else { points[1].time() };
    let last = if points[n - 1].time().is_some() { points[n - 1].time() } else { points[n - 2].time() };
    match (first, last) {
        (Some(a), Some(b)) => {
            if later(a, b) {
                None
            } else {
                Some(total_seconds(diff_us(b, a)))
            }
        }
        _ => None,
    }
}

fn gpx_duration(tracks: ref Vec[Obj]) -> Option[f64] {
    let mut result = 0.0;
    for t in tracks.iter() {
        let mut tr = 0.0;
        for s in t.lists[L_MAIN].iter() {
            match seg_duration(s.lists[L_MAIN]) {
                Some(d) => tr += d,
                None => return None,
            }
        }
        result += tr;
    }
    Some(result)
}

fn seg_uphill(points: ref Vec[Obj]) -> (f64, f64) {
    if points.len() == 0 {
        return (0.0, 0.0);
    }
    let mut e: Vec[Option[f64]] = Vec.new();
    for p in points.iter() {
        e.push(p.num(S_ELEVATION));
    }
    calculate_uphill_downhill(e)
}

fn gpx_uphill(tracks: ref Vec[Obj]) -> (f64, f64) {
    let mut up = 0.0;
    let mut down = 0.0;
    for t in tracks.iter() {
        let mut tu = 0.0;
        let mut td = 0.0;
        for s in t.lists[L_MAIN].iter() {
            let (a, b) = seg_uphill(s.lists[L_MAIN]);
            tu += a;
            td += b;
        }
        up += tu;
        down += td;
    }
    (up, down)
}

// has_times and has_elevations: 75% of a segment's points; a track needs
// one such segment for times and all of them for elevations, the GPX all
// of its tracks.
fn seg_has(points: ref Vec[Obj], times: bool) -> bool {
    if points.len() == 0 {
        return true;
    }
    let mut found = 0;
    for p in points.iter() {
        let ok = if times { p.time().is_some() } else { nonzero(p.num(S_ELEVATION)) };
        if ok {
            found += 1;
        }
    }
    points.len() > 2 and found as f64 / points.len() as f64 > 0.75
}

fn gpx_has(tracks: ref Vec[Obj], times: bool) -> bool {
    if tracks.len() == 0 {
        return false;
    }
    for t in tracks.iter() {
        let segs = ref t.lists[L_MAIN];
        if segs.len() == 0 {
            return false;
        }
        let mut any = false;
        let mut all = true;
        for s in segs.iter() {
            if seg_has(s.lists[L_MAIN], times) {
                any = true;
            } else {
                all = false;
            }
        }
        if (times and not any) or (not times and not all) {
            return false;
        }
    }
    true
}

fn track_points_no(tracks: ref Vec[Obj]) -> i64 {
    let mut n = 0;
    for t in tracks.iter() {
        for s in t.lists[L_MAIN].iter() {
            n += s.lists[L_MAIN].len();
        }
    }
    n
}

// GPX.get_points_data: (track, segment, point, distance from the start);
// the flag says whether any distance was added (the sum starts as the
// int 0).
fn points_data(tracks: ref Vec[Obj], two_d: bool) -> (Vec[(i64, i64, i64, f64)], bool) {
    let mut out: Vec[(i64, i64, i64, f64)] = Vec.new();
    let mut from_start = 0.0;
    let mut added = false;
    let mut have_prev = false;
    let mut prev = (0, 0, 0);
    let mut ti = 0;
    while ti < tracks.len() {
        let segs = ref tracks[ti].lists[L_MAIN];
        let mut si = 0;
        while si < segs.len() {
            let pts = ref segs[si].lists[L_MAIN];
            let mut pi = 0;
            while pi < pts.len() {
                if have_prev and pi > 0 {
                    let q = ref tracks[prev.0].lists[L_MAIN][prev.1].lists[L_MAIN][prev.2];
                    let d = if two_d { dist2(pts[pi], q) } else { dist3(pts[pi], q) };
                    from_start += d;
                    added = true;
                }
                out.push((ti, si, pi, from_start));
                prev = (ti, si, pi);
                have_prev = true;
                pi += 1;
            }
            si += 1;
        }
        ti += 1;
    }
    (out, added)
}

fn point_at(tracks: ref Vec[Obj], t: i64, s: i64, p: i64) -> ref Obj {
    ref tracks[t].lists[L_MAIN][s].lists[L_MAIN][p]
}

// Location(lat, lon).distance_2d(point)
fn loc_dist(lat: f64, lon: f64, p: ref Obj) -> f64 {
    distance(lat, lon, None, p.f(S_LATITUDE), p.f(S_LONGITUDE), None)
}

// GPX.get_nearest_locations, counted
fn nearest_locations(tracks: ref Vec[Obj], lat: f64, lon: f64, threshold_distance: f64) -> i64 {
    let (points, _) = points_data(tracks, false);
    if points.len() == 0 {
        return 0;
    }
    let threshold = points[points.len() - 1].3 * threshold_distance;
    let mut found = 0;
    let mut candidate: Option[f64] = None;
    for (t, s, p, _) in points.iter() {
        let d = loc_dist(lat, lon, point_at(tracks, *t, *s, *p));
        if d < threshold {
            if candidate.is_none() or d < candidate.unwrap() {
                candidate = Some(d);
            }
        } else {
            if candidate.is_some() {
                found += 1;
            }
            candidate = None;
        }
    }
    if candidate.is_some() {
        found += 1;
    }
    found
}

// GPX.get_nearest_location: the first point nearest to the location
fn nearest_location(tracks: ref Vec[Obj], lat: f64, lon: f64) -> Option[(i64, i64, i64)] {
    let mut best: Option[(f64, i64, i64, i64)] = None;
    let mut ti = 0;
    while ti < tracks.len() {
        let segs = ref tracks[ti].lists[L_MAIN];
        let mut si = 0;
        while si < segs.len() {
            let pts = ref segs[si].lists[L_MAIN];
            let mut pi = 0;
            while pi < pts.len() {
                let p = ref pts[pi];
                let d = distance(p.f(S_LATITUDE), p.f(S_LONGITUDE), None, lat, lon, None);
                let better = match best {
                    None => true,
                    Some((b, _, _, _)) => d < b,
                };
                if better {
                    best = Some((d, ti, si, pi));
                }
                pi += 1;
            }
            si += 1;
        }
        ti += 1;
    }
    match best {
        Some((_, t, s, p)) => Some((t, s, p)),
        None => None,
    }
}

// GPXTrack.get_center: the mean, or Location(0, 0) (ints) for no points
fn track_center(t: ref Obj) -> Option[(f64, f64, bool)] {
    if t.lists[L_MAIN].len() == 0 {
        return None;
    }
    let mut sum_lat = 0.0;
    let mut sum_lon = 0.0;
    let mut n = 0;
    for s in t.lists[L_MAIN].iter() {
        for p in s.lists[L_MAIN].iter() {
            n += 1;
            sum_lat += p.f(S_LATITUDE);
            sum_lon += p.f(S_LONGITUDE);
        }
    }
    if n == 0 {
        return Some((0.0, 0.0, true));
    }
    Some((sum_lat / n as f64, sum_lon / n as f64, false))
}

fn seg_location_at(points: ref Vec[Obj], time: ref Stamp) -> Option[i64] {
    if points.len() == 0 {
        return None;
    }
    let first = points[0].time();
    let last = points[points.len() - 1].time();
    if first.is_none() and last.is_none() {
        return None;
    }
    if let (Some(a), Some(b)) = (ref first, ref last) {
        if later(a, time) or later(time, b) {
            return None;
        }
    }
    let mut i = 0;
    while i < points.len() {
        if let Some(t) = points[i].time() {
            if not later(time, t) {
                return Some(i);
            }
        }
        i += 1;
    }
    None
}

// ---------------------------------------------------------------- editing

fn simplify_points(points: own Vec[Obj], max_distance: f64) -> Vec[Obj] {
    if points.len() < 3 {
        return points;
    }
    let mut keep: Vec[i64] = Vec.new();
    simplify_polyline(points, 0, points.len() - 1, max_distance, mut keep);
    keep.push(points.len() - 1);
    let mut out: Vec[Obj] = Vec.new();
    for i in keep.iter() {
        out.push(points[*i].clone());
    }
    out
}

fn reduce_segment(points: ref Vec[Obj], min_distance: f64) -> Vec[Obj] {
    let mut out: Vec[Obj] = Vec.new();
    for p in points.iter() {
        if out.len() > 0 {
            let d = dist3(out[out.len() - 1], p);
            if d >= min_distance {
                out.push(p.clone());
            }
        } else {
            out.push(p.clone());
        }
    }
    out
}

// GPX.reduce_points
fn reduce_points(g: mut ref Gpx, max_points_no: Option[i64], min_distance: Option[f64]) {
    let tracks = ref g.root.lists[L_TRACKS];
    let points_no = track_points_no(tracks);
    let given = nonzero(min_distance);
    if let Some(m) = max_points_no {
        if points_no <= m and not given {
            return;
        }
    }
    let length = gpx_length(tracks, true);
    let lo = min_distance.unwrap_or(0.0);
    let most = match max_points_no {
        Some(m) => m,
        None => 1000000000,
    };
    let limit = max2(lo, (length / most as f64).ceil());
    let mut ti = 0;
    while ti < g.root.lists[L_TRACKS].len() {
        let mut si = 0;
        while si < g.root.lists[L_TRACKS][ti].lists[L_MAIN].len() {
            let reduced = reduce_segment(g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN], limit);
            g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN] = reduced;
            si += 1;
        }
        ti += 1;
    }
}

fn smooth_points(input: own Vec[Obj], vertical: bool, horizontal: bool, remove_extremes: bool) -> Vec[Obj] {
    let mut points = input;
    let n = points.len();
    if n <= 3 {
        return points;
    }
    let mut elevations: Vec[f64] = Vec.new();
    let mut latitudes: Vec[f64] = Vec.new();
    let mut longitudes: Vec[f64] = Vec.new();
    for p in points.iter() {
        elevations.push(p.num(S_ELEVATION).unwrap_or(0.0));
        latitudes.push(p.f(S_LATITUDE));
        longitudes.push(p.f(S_LONGITUDE));
    }
    let mut avg_distance = 0.0;
    let mut avg_elevation_delta = 1.0;
    if remove_extremes {
        let mut distances: Vec[f64] = Vec.new();
        let mut deltas: Vec[f64] = Vec.new();
        let mut i = 1;
        while i < n {
            let d = dist2(points[i - 1], points[i]);
            if d != 0.0 {
                distances.push(d);
            }
            if let (Some(c), Some(p)) = (points[i].num(S_ELEVATION), points[i - 1].num(S_ELEVATION)) {
                deltas.push((c - p).abs());
            }
            i += 1;
        }
        if distances.len() > 0 {
            avg_distance = 1.0 * fsum(distances) / distances.len() as f64;
        }
        if deltas.len() > 0 {
            avg_elevation_delta = 1.0 * fsum(deltas) / deltas.len() as f64;
        }
    }
    let threshold_2d = 1.75 * avg_distance;
    let threshold_elevation = avg_elevation_delta * 5.0;
    let mut out: Vec[Obj] = vec![points[0].clone()];
    let mut i = 1;
    while i < n - 1 {
        let mut keep = false;
        let mut removed = false;
        if vertical and elevations[i - 1] != 0.0 and elevations[i] != 0.0 and elevations[i + 1] != 0.0 {
            let old = points[i].num(S_ELEVATION).unwrap_or(0.0);
            let new_elevation = 0.4 * elevations[i - 1] + 0.2 * elevations[i] + 0.4 * elevations[i + 1];
            if remove_extremes {
                let d1 = (old - elevations[i - 1]).abs();
                let d2 = (old - elevations[i + 1]).abs();
                if min2(d1, d2) < threshold_elevation and (old - new_elevation).abs() < threshold_2d {
                    keep = true;
                } else {
                    removed = true;
                }
            } else {
                points[i].vals[S_ELEVATION] = Val.Num(new_elevation);
                keep = true;
            }
        } else {
            keep = true;
        }
        if horizontal {
            let old_lat = points[i].f(S_LATITUDE);
            let old_lon = points[i].f(S_LONGITUDE);
            let new_lat = 0.4 * latitudes[i - 1] + 0.2 * latitudes[i] + 0.4 * latitudes[i + 1];
            let new_lon = 0.4 * longitudes[i - 1] + 0.2 * longitudes[i] + 0.4 * longitudes[i + 1];
            if not remove_extremes {
                points[i].vals[S_LATITUDE] = Val.Num(new_lat);
                points[i].vals[S_LONGITUDE] = Val.Num(new_lon);
            }
            let d1 = distance(latitudes[i - 1], longitudes[i - 1], None, latitudes[i], longitudes[i], None);
            let d2 = distance(latitudes[i + 1], longitudes[i + 1], None, latitudes[i], longitudes[i], None);
            let across = distance(latitudes[i - 1], longitudes[i - 1], None, latitudes[i + 1], longitudes[i + 1], None);
            if d1 + d2 > across * 1.5 and remove_extremes {
                let moved = distance(old_lat, old_lon, None, new_lat, new_lon, None);
                if moved < threshold_2d {
                    keep = true;
                } else {
                    removed = true;
                }
            } else {
                keep = true;
            }
        }
        if keep and not removed {
            out.push(points[i].clone());
        }
        i += 1;
    }
    out.push(points[n - 1].clone());
    out
}

// Every segment of every track through f.
fn edit_segments(g: mut ref Gpx, how: i64) {
    let mut ti = 0;
    while ti < g.root.lists[L_TRACKS].len() {
        let mut si = 0;
        while si < g.root.lists[L_TRACKS][ti].lists[L_MAIN].len() {
            let pts = g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN].clone();
            let edited = if how == E_SIMPLIFY {
                simplify_points(pts, 10.0)
            } else if how == E_SMOOTH {
                smooth_points(pts, true, false, false)
            } else {
                smooth_points(pts, true, true, true)
            };
            g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN] = edited;
            si += 1;
        }
        ti += 1;
    }
}

const E_SIMPLIFY: i64 = 0;
const E_SMOOTH: i64 = 1;
const E_SMOOTH_ALL: i64 = 2;

// the data add_missing_data looks for
const D_ELEVATION: i64 = 0;
const D_TIME: i64 = 1;
const D_SPEED: i64 = 2;

fn data_slot(kind: i64) -> i64 {
    if kind == D_ELEVATION { S_ELEVATION } else if kind == D_TIME { S_TIME } else { S_SPEED }
}

fn interval_ratios(points: ref Vec[Obj], interval: ref Vec[i64], start: i64, end: i64) -> Vec[f64] {
    let mut distances: Vec[f64] = Vec.new();
    let mut from_start = 0.0;
    let mut prev = start;
    for i in interval.iter() {
        from_start += dist3(points[*i], points[prev]);
        distances.push(from_start);
        prev = *i;
    }
    let last = interval[interval.len() - 1];
    let d = dist3(points[last], points[end]);
    let total = if d != 0.0 { distances[distances.len() - 1] + d } else { 0.0 };
    let mut out: Vec[f64] = Vec.new();
    for x in distances.iter() {
        out.push(if total != 0.0 { *x / total } else { 0.0 });
    }
    out
}

fn fill_interval(points: mut ref Vec[Obj], kind: i64, interval: ref Vec[i64], start: i64, end: i64) {
    let ratios = interval_ratios(points, interval, start, end);
    if kind == D_ELEVATION {
        if let (Some(s), Some(e)) = (points[start].num(S_ELEVATION), points[end].num(S_ELEVATION)) {
            let mut k = 0;
            while k < interval.len() {
                points[interval[k]].vals[S_ELEVATION] = Val.Num(s + ratios[k] * (e - s));
                k += 1;
            }
        }
    } else if kind == D_TIME {
        if let (Some(s), Some(e)) = (points[start].time(), points[end].time()) {
            let between = total_seconds(diff_us(e, s));
            let mut k = 0;
            while k < interval.len() {
                points[interval[k]].vals[S_TIME] = Val.Time(s.plus(delta_from_seconds(ratios[k] * between)));
                k += 1;
            }
        }
    } else {
        if points[start].time().is_none() or points[end].time().is_none() {
            return;
        }
        let first = interval[0];
        let last = interval[interval.len() - 1];
        let mut steps: Vec[(Option[f64], f64)] = Vec.new();
        steps.push((time_difference(points[first], points[start]), dist3(points[first], points[start])));
        let mut k = 1;
        while k < interval.len() {
            let a = ref points[interval[k - 1]];
            let b = ref points[interval[k]];
            steps.push((time_difference(a, b), dist3(a, b)));
            k += 1;
        }
        steps.push((time_difference(points[last], points[end]), dist3(points[last], points[end])));
        let mut k = 0;
        while k < interval.len() {
            let (tl, dl) = steps[k];
            let (tr, dr) = steps[k + 1];
            if nonzero(tl) and nonzero(tr) and dl != 0.0 and dr != 0.0 {
                points[interval[k]].vals[S_SPEED] = Val.Num((dl + dr) / (tl.unwrap() + tr.unwrap()));
            }
            k += 1;
        }
    }
}

// GPXTrackSegment.add_missing_data
fn add_missing(points: mut ref Vec[Obj], kind: i64) {
    let slot = data_slot(kind);
    let mut interval: Vec[i64] = Vec.new();
    let mut start: Option[i64] = None;
    let mut i = 0;
    while i < points.len() {
        let missing = is_nil(points[i].vals[slot]);
        if missing and i > 0 {
            if start.is_none() {
                start = Some(i - 1);
            }
            interval.push(i);
        } else {
            if interval.len() > 0 and start.is_some() {
                fill_interval(mut points, kind, interval, start.unwrap(), i);
                start = None;
                interval = Vec.new();
            }
        }
        i += 1;
    }
}

fn add_missing_all(g: mut ref Gpx, kind: i64) {
    let mut ti = 0;
    while ti < g.root.lists[L_TRACKS].len() {
        let mut si = 0;
        while si < g.root.lists[L_TRACKS][ti].lists[L_MAIN].len() {
            add_missing(mut g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN], kind);
            si += 1;
        }
        ti += 1;
    }
}

fn count_points(tracks: ref Vec[Obj], slot: i64, missing: bool) -> i64 {
    let mut n = 0;
    for t in tracks.iter() {
        for s in t.lists[L_MAIN].iter() {
            for p in s.lists[L_MAIN].iter() {
                if is_nil(p.vals[slot]) == missing {
                    n += 1;
                }
            }
        }
    }
    n
}

fn move_all(g: mut ref Gpx, by_angle: bool, a: f64, b: f64) {
    let mut ri = 0;
    while ri < g.root.lists[L_ROUTES].len() {
        let mut pi = 0;
        while pi < g.root.lists[L_ROUTES][ri].lists[L_MAIN].len() {
            move_point(mut g.root.lists[L_ROUTES][ri].lists[L_MAIN][pi], by_angle, a, b);
            pi += 1;
        }
        ri += 1;
    }
    let mut wi = 0;
    while wi < g.root.lists[L_MAIN].len() {
        move_point(mut g.root.lists[L_MAIN][wi], by_angle, a, b);
        wi += 1;
    }
    let mut ti = 0;
    while ti < g.root.lists[L_TRACKS].len() {
        let mut si = 0;
        while si < g.root.lists[L_TRACKS][ti].lists[L_MAIN].len() {
            let mut pi = 0;
            while pi < g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN].len() {
                move_point(mut g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN][pi], by_angle, a, b);
                pi += 1;
            }
            si += 1;
        }
        ti += 1;
    }
}

fn shift_time(o: mut ref Obj, delta: i64) {
    if let Some(t) = o.time() {
        o.vals[S_TIME] = Val.Time(t.plus(delta));
    }
}

fn shift_points(points: mut ref Vec[Obj], delta: i64) {
    let mut i = 0;
    while i < points.len() {
        shift_time(mut points[i], delta);
        i += 1;
    }
}

// GPX.adjust_time(delta, all=True)
fn adjust_time(g: mut ref Gpx, delta: i64) {
    shift_time(mut g.root, delta);
    let mut ti = 0;
    while ti < g.root.lists[L_TRACKS].len() {
        let mut si = 0;
        while si < g.root.lists[L_TRACKS][ti].lists[L_MAIN].len() {
            shift_points(mut g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN], delta);
            si += 1;
        }
        ti += 1;
    }
    shift_points(mut g.root.lists[L_MAIN], delta);
    let mut ri = 0;
    while ri < g.root.lists[L_ROUTES].len() {
        shift_points(mut g.root.lists[L_ROUTES][ri].lists[L_MAIN], delta);
        ri += 1;
    }
}

// GPX.fill_time_data_with_regular_intervals(start_time, end_time)
fn fill_time(g: mut ref Gpx, start: ref Stamp, end: ref Stamp) {
    let n = track_points_no(g.root.lists[L_TRACKS]);
    let step = div_nearest(diff_us(end, start), n - 1);
    g.root.vals[S_TIME] = Val.Time(start.clone());
    let mut i = 0;
    let mut ti = 0;
    while ti < g.root.lists[L_TRACKS].len() {
        let mut si = 0;
        while si < g.root.lists[L_TRACKS][ti].lists[L_MAIN].len() {
            let mut pi = 0;
            while pi < g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN].len() {
                g.root.lists[L_TRACKS][ti].lists[L_MAIN][si].lists[L_MAIN][pi].vals[S_TIME] = Val.Time(start.plus(i * step));
                i += 1;
                pi += 1;
            }
            si += 1;
        }
        ti += 1;
    }
}

// GPXTrack.split(segment_no, point_no) and GPXTrack.join(segment_no)
fn split_track(t: mut ref Obj, seg: i64, at: i64) {
    let segs = t.lists[L_MAIN].clone();
    let mut out: Vec[Obj] = Vec.new();
    let mut i = 0;
    while i < segs.len() {
        if i == seg {
            let pts = ref segs[i].lists[L_MAIN];
            let mut a = new_obj(C_SEGMENT);
            let mut b = new_obj(C_SEGMENT);
            let mut k = 0;
            while k < pts.len() {
                if k <= at {
                    a.lists[L_MAIN].push(pts[k].clone());
                } else {
                    b.lists[L_MAIN].push(pts[k].clone());
                }
                k += 1;
            }
            out.push(a);
            out.push(b);
        } else {
            out.push(segs[i].clone());
        }
        i += 1;
    }
    t.lists[L_MAIN] = out;
}

fn join_track(t: mut ref Obj, seg: i64) {
    let other = seg + 1;
    if other >= t.lists[L_MAIN].len() {
        return;
    }
    let moved = t.lists[L_MAIN][other].lists[L_MAIN].clone();
    for p in moved.into_iter() {
        t.lists[L_MAIN][seg].lists[L_MAIN].push(p);
    }
    t.lists[L_MAIN].remove(other);
}
// ---------------------------------------------------------------- parsing

fn is_re_space(c: char) -> bool {
    is_py_space(c)
}

fn starts_at(cs: ref Vec[char], at: i64, s: Str) -> bool {
    let mut i = at;
    for c in s.chars() {
        if i >= cs.len() or cs[i] != c {
            return false;
        }
        i += 1;
    }
    true
}

fn index_from(cs: ref Vec[char], from: i64, c: char) -> i64 {
    let mut i = from;
    while i < cs.len() {
        if cs[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

// re.findall(r'\sxmlns:?[^=]*="[^"]+"', xml): (prefix, uri) of each
fn find_namespaces(cs: ref Vec[char]) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        if i + 1 < cs.len() and cs[i + 1] == 'x' and is_re_space(cs[i]) and starts_at(cs, i + 1, "xmlns") {
            // [^=]* runs to the first '=', which must open a quoted value
            let eq = index_from(cs, i + 6, '=');
            if eq >= 0 and eq + 1 < cs.len() and cs[eq + 1] == '"' {
                let close = index_from(cs, eq + 2, '"');
                if close > eq + 2 {
                    let prefix = lstrip_char(slice_chars(cs, i + 6, eq), ':');
                    let uri = slice_chars(cs, eq + 2, close);
                    out.push((prefix, uri));
                    i = close + 1;
                    continue;
                }
            }
        }
        i += 1;
    }
    out
}

// re.search(r'\sxsi:schemaLocation="[^"]+"', xml), its value split
fn find_schema_locations(cs: ref Vec[char]) -> Option[Vec[String]] {
    let mut i = 0;
    while i < cs.len() {
        if is_re_space(cs[i]) and starts_at(cs, i + 1, "xsi:schemaLocation=\"") {
            let from = i + 21;
            let close = index_from(cs, from, '"');
            if close > from {
                let value = slice_chars(cs, from, close);
                return Some(py_split(value));
            }
        }
        i += 1;
    }
    None
}

// str.split()
fn py_split(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if is_py_space(c) {
            if cur.len() > 0 {
                out.push(cur.clone());
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// re.sub(r"""\sxmlns=(['"])[^'"]+\1""", '', xml, count=1)
fn remove_default_namespace(cs: ref Vec[char]) -> String {
    let mut i = 0;
    while i < cs.len() {
        if is_re_space(cs[i]) and starts_at(cs, i + 1, "xmlns=") and i + 7 < cs.len() {
            let q = cs[i + 7];
            if q == '\'' or q == '"' {
                let mut j = i + 8;
                while j < cs.len() and cs[j] != '\'' and cs[j] != '"' {
                    j += 1;
                }
                if j > i + 8 and j < cs.len() and cs[j] == q {
                    let mut out = slice_chars(cs, 0, i);
                    out.push_str(slice_chars(cs, j + 1, cs.len()));
                    return out;
                }
            }
        }
        i += 1;
    }
    slice_chars(cs, 0, cs.len())
}

// gpxpy.parse
fn parse_gpx(schema: ref Schema, xml: ref String) -> Result[Gpx, GpxError] {
    let cs: Vec[char] = xml.chars().collect();
    let mut nsmap: Vec[(String, String)] = Vec.new();
    for (prefix, uri) in find_namespaces(cs).into_iter() {
        let key = if prefix.len() == 0 { "defaultns".to_string() } else { prefix };
        ns_set(mut nsmap, key.as_str(), uri);
    }
    let schema_locations = find_schema_locations(cs).unwrap_or(Vec.new());
    let text = remove_default_namespace(cs);
    let root = match parse_xml(text) {
        Ok(r) => r,
        Err(e) => return Err(GpxError { kind: "GPXXMLSyntaxException".to_string(), msg: f"Error parsing XML: {e}" }),
    };
    let version = root.get("version");
    let obj = fields_from_xml(schema, C_GPX, root, version)?;
    Ok(Gpx { root: obj, nsmap: nsmap, schema_locations: schema_locations })
}

const DEFAULT_CREATOR: Str = "gpx.py -- https://github.com/tkrajina/gpxpy";

// GPX.to_xml, which also sets the version, the creator, the namespaces
// and the schema locations it writes.
fn to_xml(schema: ref Schema, g: mut ref Gpx, version: Option[String], pretty: bool) -> Result[String, GpxError] {
    let v = match version {
        Some(v) if v.len() > 0 => v.clone(),
        _ => match g.root.text(S_VERSION) {
            Some(v) if v.len() > 0 => v,
            _ => "1.1".to_string(),
        },
    };
    if v != "1.0" and v != "1.1" {
        return Err(gpx_error(f"Invalid version {v}"));
    }
    g.root.vals[S_VERSION] = Val.Str(v.clone());
    if not truthy(g.root.vals[S_CREATOR]) {
        g.root.vals[S_CREATOR] = Val.Str(DEFAULT_CREATOR.to_string());
    }
    ns_set(mut g.nsmap, "xsi", "http://www.w3.org/2001/XMLSchema-instance".to_string());
    let path = v.replace(".", "/");
    ns_set(mut g.nsmap, "defaultns", f"http://www.topografix.com/GPX/{path}");
    if g.schema_locations.len() == 0 {
        g.schema_locations = vec![f"http://www.topografix.com/GPX/{path}", f"http://www.topografix.com/GPX/{path}/gpx.xsd"];
    }
    let custom = vec![("xsi:schemaLocation".to_string(), g.schema_locations.join(" "))];
    let content = fields_to_xml(schema, g.root, "gpx".to_string(), v, custom, g.nsmap, String.new(), false, pretty);
    Ok(f"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n{py_strip(content)}")
}

// ---------------------------------------------------------------- gpxinfo

const KM_TO_MILES: f64 = 0.621371;
const M_TO_FEET: f64 = 3.28084;

struct Units {
    seconds: bool,
    miles: bool,
}

fn format_duration(u: ref Units, t: f64) -> String {
    if t == 0.0 {
        return "n/a".to_string();
    }
    let s = t as i64;
    if u.seconds {
        return f"{s}";
    }
    let mins = s / 60;
    f"{pad(mins / 60, 2)}:{pad(mins % 60, 2)}:{pad(s % 60, 2)}"
}

fn format_long_length(u: ref Units, length: f64) -> String {
    if u.miles {
        f"{length / 1000.0 * KM_TO_MILES:.3}miles"
    } else {
        f"{length / 1000.0:.3}km"
    }
}

fn format_short_length(u: ref Units, length: f64) -> String {
    if u.miles {
        f"{length * M_TO_FEET:.2}ft"
    } else {
        f"{length:.2}m"
    }
}

fn format_speed(u: ref Units, speed: f64) -> String {
    if u.miles {
        f"{speed * KM_TO_MILES * 3600.0 / 1000.0:.2}mph"
    } else {
        f"{speed:.2}m/s = {speed * 3600.0 / 1000.0:.2}km/h"
    }
}

// print_gpx_part_info for a GPX (its tracks) or for one segment, which
// is measured as a GPX with one track of that one segment (the sums come
// out the same).
fn print_part_info(u: ref Units, tracks: ref Vec[Obj], indent: Str) {
    println(f"{indent}Length 2D: {format_long_length(u, gpx_length(tracks, false))}");
    println(f"{indent}Length 3D: {format_long_length(u, gpx_length(tracks, true))}");
    let m = gpx_moving(tracks, false);
    let raw = gpx_moving(tracks, true);
    println(f"{indent}Moving time: {format_duration(u, m.moving_time)}");
    println(f"{indent}Stopped time: {format_duration(u, m.stopped_time)}");
    println(f"{indent}Max speed: {format_speed(u, m.max_speed)} (raw: {format_speed(u, raw.max_speed)})");
    let avg = if m.moving_time > 0.0 { format_speed(u, m.moving_distance / m.moving_time) } else { "?".to_string() };
    println(f"{indent}Avg speed: {avg}");
    let (up, down) = gpx_uphill(tracks);
    println(f"{indent}Total uphill: {format_short_length(u, up)}");
    println(f"{indent}Total downhill: {format_short_length(u, down)}");
    let (start, end) = gpx_time_bounds(tracks);
    println(f"{indent}Started: {stamp_or_none(start)}");
    println(f"{indent}Ended: {stamp_or_none(end)}");
    let n = track_points_no(tracks);
    println(f"{indent}Points: {n}");
    if n > 0 {
        let mut distances: Vec[f64] = Vec.new();
        let mut prev: Option[(i64, i64, i64)] = None;
        let mut ti = 0;
        while ti < tracks.len() {
            let segs = ref tracks[ti].lists[L_MAIN];
            let mut si = 0;
            while si < segs.len() {
                let mut pi = 0;
                while pi < segs[si].lists[L_MAIN].len() {
                    if let Some((a, b, c)) = prev {
                        distances.push(dist2(segs[si].lists[L_MAIN][pi], point_at(tracks, a, b, c)));
                    }
                    prev = Some((ti, si, pi));
                    pi += 1;
                }
                si += 1;
            }
            ti += 1;
        }
        println(f"{indent}Avg distance between points: {format_short_length(u, fsum(distances) / n as f64)}");
    }
    println("");
}

fn print_gpx_info(u: ref Units, g: ref Gpx, name: ref String) {
    println(f"File: {name}");
    let r = ref g.root;
    if truthy(r.vals[S_NAME]) {
        println(f"  GPX name: {val_str(r.vals[S_NAME])}");
    }
    if truthy(r.vals[S_DESCRIPTION]) {
        println(f"  GPX description: {val_str(r.vals[S_DESCRIPTION])}");
    }
    if truthy(r.vals[S_AUTHOR_NAME]) {
        println(f"  Author: {val_str(r.vals[S_AUTHOR_NAME])}");
    }
    if truthy(r.vals[S_AUTHOR_EMAIL]) {
        println(f"  Email: {val_str(r.vals[S_AUTHOR_EMAIL])}");
    }
    print_part_info(u, r.lists[L_TRACKS], "    ");
    let mut ti = 0;
    for t in r.lists[L_TRACKS].iter() {
        let mut si = 0;
        for s in t.lists[L_MAIN].iter() {
            println(f"    Track #{ti}, Segment #{si}");
            let mut one = new_obj(C_TRACK);
            one.lists[L_MAIN].push(s.clone());
            print_part_info(u, vec![one], "        ");
            si += 1;
        }
        ti += 1;
    }
}

// ---------------------------------------------------------------- the run

fn crc32(text: ref String) -> i64 {
    let mut crc = 0xFFFFFFFF;
    for b in text.bytes() {
        crc = crc ^ *b as i64;
        for _ in 0..8 {
            if crc & 1 == 1 {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc = crc >> 1;
            }
        }
    }
    crc ^ 0xFFFFFFFF
}

fn hex8(v: i64) -> String {
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    let mut k = 28;
    while k >= 0 {
        s.push(ds[(v >> k) & 15]);
        k -= 4;
    }
    s
}

fn show_xml(label: ref String, xml: ref String) {
    let lines: Vec[String] = xml.split("\n").map(|l| l.to_string()).collect();
    println(f"-- {label}: {lines.len()} lines, {xml.len()} bytes, crc32 {hex8(crc32(xml))}");
    if xml.len() <= 6000 {
        for line in lines.iter() {
            println(f"   |{line}");
        }
    }
}

fn opt_num(x: ref Option[f64]) -> String {
    match x {
        Some(v) => f"{v}",
        None => "None".to_string(),
    }
}

// a sum that starts as the int 0 and only gains a float when nonzero
fn int_zero(x: f64) -> String {
    if x == 0.0 { "0".to_string() } else { f"{x}" }
}

// Location.elevation_angle, printed: the int 0 when the points coincide
fn elevation_angle_str(a: ref Obj, b: ref Obj) -> String {
    match (a.num(S_ELEVATION), b.num(S_ELEVATION)) {
        (Some(e1), Some(e2)) => {
            let rise = e2 - e1;
            let run = dist2(b, a);
            if run == 0.0 {
                return "0".to_string();
            }
            f"{degrees((rise / run).atan())}"
        }
        _ => "None".to_string(),
    }
}

fn operations(schema: ref Schema, parsed: ref Gpx) {
    let tracks = ref parsed.root.lists[L_TRACKS];
    if track_points_no(tracks) == 0 {
        return;
    }
    println("-- operations");
    match gpx_bounds(tracks) {
        Some((a, b, c, d)) => println(f"   bounds: {a} {b} {c} {d}"),
        None => println("   bounds: None"),
    }
    let (lo, hi) = gpx_elevation_extremes(tracks);
    println(f"   elevation extremes: {opt_num(lo)} {opt_num(hi)}");
    println(f"   duration: {opt_num(gpx_duration(tracks))}");
    let ht = if gpx_has(tracks, true) { "True" } else { "False" };
    let he = if gpx_has(tracks, false) { "True" } else { "False" };
    println(f"   has times: {ht}, has elevations: {he}");
    let (data, added) = points_data(tracks, false);
    let last = if added { f"{data[data.len() - 1].3}" } else { "0".to_string() };
    println(f"   points data: {data.len()} points, the last {last} m from the start");
    let (data2, added2) = points_data(tracks, true);
    let last2 = if added2 { f"{data2[data2.len() - 1].3}" } else { "0".to_string() };
    println(f"   points data in 2D: the last {last2} m from the start");
    if let Some((clat, clon, ints)) = track_center(tracks[0]) {
        if ints {
            println("   center of track 0: 0 0");
        } else {
            println(f"   center of track 0: {clat} {clon}");
        }
        if let Some((t, s, p)) = nearest_location(tracks, clat, clon) {
            let q = point_at(tracks, t, s, p);
            println(f"   nearest to it: track {t} segment {s} point {p} at {q.f(S_LATITUDE)} {q.f(S_LONGITUDE)}");
        }
        println(f"   near it (5% of the length): {nearest_locations(tracks, clat, clon, 0.05)} passes");
    }
    if let (Some(start), Some(end)) = gpx_time_bounds(tracks) {
        let mid = start.plus(div_nearest(diff_us(end, start), 2));
        let mut found: Vec[String] = Vec.new();
        for t in tracks.iter() {
            for s in t.lists[L_MAIN].iter() {
                if let Some(i) = seg_location_at(s.lists[L_MAIN], mid) {
                    let p = ref s.lists[L_MAIN][i];
                    found.push(f"{p.f(S_LATITUDE)} {p.f(S_LONGITUDE)}");
                }
            }
        }
        println(f"   location at {stamp_str(mid)}: {found.join(", ")}");
    }
    let mut seg: Option[Obj] = None;
    for t in tracks.iter() {
        for s in t.lists[L_MAIN].iter() {
            if s.lists[L_MAIN].len() >= 2 and seg.is_none() {
                seg = Some(s.clone());
            }
        }
    }
    if let Some(s) = ref seg {
        let pts = ref s.lists[L_MAIN];
        let p = ref pts[0];
        let q = ref pts[1];
        let lox = get_course(p.f(S_LATITUDE), p.f(S_LONGITUDE), q.f(S_LATITUDE), q.f(S_LONGITUDE), true);
        let great = get_course(p.f(S_LATITUDE), p.f(S_LONGITUDE), q.f(S_LATITUDE), q.f(S_LONGITUDE), false);
        println(f"   course from point 0 to 1: {lox} loxodromic, {great} great circle");
        println(f"   elevation angle: {elevation_angle_str(p, q)}");
        let mut known = 0;
        let mut fastest: Option[f64] = None;
        let mut i = 0;
        while i < pts.len() {
            if let Some(v) = get_speed(pts, i) {
                known += 1;
                if fastest.is_none() or v > fastest.unwrap() {
                    fastest = Some(v);
                }
            }
            i += 1;
        }
        let tail = match fastest {
            Some(v) => f", fastest {v} m/s",
            None => String.new(),
        };
        println(f"   speeds: {known} of {pts.len()} known{tail}");
        let m = seg_moving(pts, false);
        println(f"   first segment moving data: {m.moving_time} {m.stopped_time} {m.moving_distance} {m.stopped_distance} {m.max_speed}");
    }

    let mut g = parsed.clone();
    edit_segments(mut g, E_SIMPLIFY);
    println(f"   simplify(): {track_points_no(g.root.lists[L_TRACKS])} points, {int_zero(gpx_length(g.root.lists[L_TRACKS], false))} m in 2D");
    let mut g = parsed.clone();
    reduce_points(mut g, None, Some(30.0));
    println(f"   reduce_points(min_distance=30): {track_points_no(g.root.lists[L_TRACKS])} points");
    let mut g = parsed.clone();
    reduce_points(mut g, Some(20), None);
    println(f"   reduce_points(max_points_no=20): {track_points_no(g.root.lists[L_TRACKS])} points");
    let mut g = parsed.clone();
    edit_segments(mut g, E_SMOOTH);
    let (up, down) = gpx_uphill(g.root.lists[L_TRACKS]);
    println(f"   smooth(): uphill {int_zero(up)} downhill {int_zero(down)}");
    let mut g = parsed.clone();
    edit_segments(mut g, E_SMOOTH_ALL);
    println(f"   smooth(horizontal, remove_extremes): {track_points_no(g.root.lists[L_TRACKS])} points, {int_zero(gpx_length(g.root.lists[L_TRACKS], false))} m in 2D");

    let mut g = parsed.clone();
    let before = count_points(g.root.lists[L_TRACKS], S_ELEVATION, true);
    add_missing_all(mut g, D_ELEVATION);
    if before > 0 {
        println(f"   add_missing_elevations(): {before} missing, {count_points(g.root.lists[L_TRACKS], S_ELEVATION, true)} left");
    }
    let mut g = parsed.clone();
    let before = count_points(g.root.lists[L_TRACKS], S_TIME, true);
    add_missing_all(mut g, D_TIME);
    if before > 0 {
        println(f"   add_missing_times(): {before} missing, {count_points(g.root.lists[L_TRACKS], S_TIME, true)} left");
    }
    let mut g = parsed.clone();
    add_missing_all(mut g, D_SPEED);
    println(f"   add_missing_speeds(): {count_points(g.root.lists[L_TRACKS], S_SPEED, false)} with a speed");

    let mut g = parsed.clone();
    if g.root.lists[L_TRACKS][0].lists[L_MAIN].len() > 0 and g.root.lists[L_TRACKS][0].lists[L_MAIN][0].lists[L_MAIN].len() >= 4 {
        let n = g.root.lists[L_TRACKS][0].lists[L_MAIN][0].lists[L_MAIN].len();
        split_track(mut g.root.lists[L_TRACKS][0], 0, n / 2);
        let mut sizes: Vec[String] = Vec.new();
        for s in g.root.lists[L_TRACKS][0].lists[L_MAIN].iter() {
            sizes.push(f"{s.lists[L_MAIN].len()}");
        }
        println(f"   split(0, 0, {n / 2}): {sizes.len()} segments of {sizes.join(" ")}");
        join_track(mut g.root.lists[L_TRACKS][0], 0);
        let t0 = ref g.root.lists[L_TRACKS][0];
        println(f"   join(0): {t0.lists[L_MAIN].len()} segments, {t0.lists[L_MAIN][0].lists[L_MAIN].len()} points in the first");
    }

    let mut g = parsed.clone();
    move_all(mut g, true, 1000.0, 45.0);
    if let Some((t, s, p)) = first_point(g.root.lists[L_TRACKS]) {
        let q = point_at(g.root.lists[L_TRACKS], t, s, p);
        println(f"   moved 1000 m at 45 degrees: {q.f(S_LATITUDE)} {q.f(S_LONGITUDE)}");
    }
    let mut g = parsed.clone();
    move_all(mut g, false, -0.5, 0.25);
    if let Some((t, s, p)) = first_point(g.root.lists[L_TRACKS]) {
        let q = point_at(g.root.lists[L_TRACKS], t, s, p);
        println(f"   moved by -0.5 and 0.25 degrees: {q.f(S_LATITUDE)} {q.f(S_LONGITUDE)}");
    }
    let mut g = parsed.clone();
    adjust_time(mut g, 3630000250);
    let (start, _) = gpx_time_bounds(g.root.lists[L_TRACKS]);
    println(f"   adjust_time(1:00:30.000250): starts {stamp_or_none(start)}");

    let mut g = parsed.clone();
    if not gpx_has(g.root.lists[L_TRACKS], true) and track_points_no(g.root.lists[L_TRACKS]) >= 2 {
        let start = Stamp { year: 2024, month: 5, day: 1, hour: 9, minute: 30, second: 0, micro: 0, tz: Some(0) };
        let end = start.plus(7207000000);
        fill_time(mut g, start, end);
        println("   fill_time_data_with_regular_intervals(09:30 to 11:30:07):");
        print_part_info(Units { seconds: false, miles: false }, g.root.lists[L_TRACKS], "     ");
    }
}

fn first_point(tracks: ref Vec[Obj]) -> Option[(i64, i64, i64)] {
    let mut ti = 0;
    while ti < tracks.len() {
        let segs = ref tracks[ti].lists[L_MAIN];
        let mut si = 0;
        while si < segs.len() {
            if segs[si].lists[L_MAIN].len() > 0 {
                return Some((ti, si, 0));
            }
            si += 1;
        }
        ti += 1;
    }
    None
}

fn other_version(v: ref String) -> String {
    if *v == "1.1" { "1.0".to_string() } else { "1.1".to_string() }
}

fn show_result(label: ref String, r: ref Result[String, GpxError]) {
    match r {
        Ok(x) => show_xml(label, x),
        Err(e) => println(f"-- {label}: {e.kind}: {e.msg}"),
    }
}

fn run_file(schema: ref Schema, name: ref String, text: ref String) {
    println(f"== {name}");
    let parsed = match parse_gpx(schema, text) {
        Ok(g) => g,
        Err(e) => {
            println(f"   {e.kind}: {e.msg}");
            return;
        }
    };
    let mut g = parsed.clone();
    print_gpx_info(Units { seconds: false, miles: false }, g, name);
    if *name == "korita-zbevnica.gpx" or *name == "watch-run.gpx" {
        println("gpxinfo -s -m:");
        print_part_info(Units { seconds: true, miles: true }, g.root.lists[L_TRACKS], "    ");
    }
    let first = to_xml(schema, mut g, None, true);
    let version = g.root.text(S_VERSION).unwrap_or(String.new());
    show_result(f"to_xml() as GPX {version}", first);
    if let Ok(xml) = ref first {
        let again = match parse_gpx(schema, xml) {
            Ok(h) => {
                let mut h = h;
                to_xml(schema, mut h, None, true)
            }
            Err(e) => Err(e),
        };
        let same = match ref again {
            Ok(a) => *a == *xml,
            Err(_) => false,
        };
        println(f"-- parsed again: {if same { "the same XML" } else { "DIFFERENT XML" }}");
        if not same {
            show_result("the second XML".to_string(), again);
        }
    }
    let other = other_version(version);
    let second = to_xml(schema, mut g, Some(other.clone()), true);
    show_result(f"to_xml('{other}')", second);
    // gpxpy parses the file again here, which gives the same objects
    let mut flat = parsed.clone();
    show_result("to_xml(prettyprint=False)".to_string(), to_xml(schema, mut flat, None, false));
    operations(schema, parsed);
}

// Python's universal newlines, as open() reads text.
fn universal_newlines(s: ref String) -> String {
    s.replace("\r\n", "\n").replace("\r", "\n")
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    for (name, text) in data_files().into_iter() {
        let path = f"data/{name}";
        if let Err(e) = fs.write(path.clone(), text) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let schema = new_schema();
    let mut names: Vec[String] = Vec.new();
    for (name, _) in data_files().into_iter() {
        names.push(name);
    }
    names.sort();
    for name in names.iter() {
        let path = f"data/{name}";
        let text = match fs.read_to_string(path.clone()) {
            Ok(t) => t,
            Err(e) => return Err(f"cannot read {path}: {e}"),
        };
        run_file(schema, name, universal_newlines(text));
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
