= True
call get s:balance
send b'*2\r\n$3\r\nGET\r\n$7\r\nbalance\r\n'
= b'100'
pipe multi
= None
pipe multi
! RedisError: Cannot issue nested calls to MULTI
call set s:balance i:90
= queued
pipe execute
send b'*1\r\n$5\r\nMULTI\r\n*3\r\n$3\r\nSET\r\n$7\r\nbalance\r\n$2\r\n90\r\n*1\r\n$4\r\nEXEC\r\n'
= [True]
pipe watch s:balance
send b'*2\r\n$5\r\nWATCH\r\n$7\r\nbalance\r\n'
= True
pipe unwatch
send b'*1\r\n$7\r\nUNWATCH\r\n'
= True
pipe unwatch
= True
pipe watch s:balance
send b'*2\r\n$5\r\nWATCH\r\n$7\r\nbalance\r\n'
= True
pipe multi
= None
call set s:balance i:80
= queued
