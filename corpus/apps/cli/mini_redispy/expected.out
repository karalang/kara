== strings
client
call set s:greeting s:hello
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*3\r\n$3\r\nSET\r\n$8\r\ngreeting\r\n$5\r\nhello\r\n'
= True
call get s:greeting
send b'*2\r\n$3\r\nGET\r\n$8\r\ngreeting\r\n'
= b'hello'
call get s:missing
send b'*2\r\n$3\r\nGET\r\n$7\r\nmissing\r\n'
= None
call set s:session s:abc ex=i:30 nx=T:
send b'*6\r\n$3\r\nSET\r\n$7\r\nsession\r\n$3\r\nabc\r\n$2\r\nEX\r\n$2\r\n30\r\n$2\r\nNX\r\n'
= True
call set s:session s:abc px=i:1500 xx=T: keepttl=T:
send b'*7\r\n$3\r\nSET\r\n$7\r\nsession\r\n$3\r\nabc\r\n$2\r\nPX\r\n$4\r\n1500\r\n$7\r\nKEEPTTL\r\n$2\r\nXX\r\n'
= None
call set s:session s:def get=T:
send b'*4\r\n$3\r\nSET\r\n$7\r\nsession\r\n$3\r\ndef\r\n$3\r\nGET\r\n'
= b'abc'
call set s:counter i:10 ex=s:15
send b'*5\r\n$3\r\nSET\r\n$7\r\ncounter\r\n$2\r\n10\r\n$2\r\nEX\r\n$2\r\n15\r\n'
= True
call set s:counter i:10 ex=f:1.5
! DataError: ex must be datetime.timedelta or int
call set s:counter i:10 px=s:15
! DataError: px must be datetime.timedelta or int
call set s:stamp s:x exat=i:1700000000 pxat=i:1700000000123
send b'*7\r\n$3\r\nSET\r\n$5\r\nstamp\r\n$1\r\nx\r\n$4\r\nEXAT\r\n$10\r\n1700000000\r\n$4\r\nPXAT\r\n$13\r\n1700000000123\r\n'
= True
call incr s:counter
send b'*3\r\n$6\r\nINCRBY\r\n$7\r\ncounter\r\n$1\r\n1\r\n'
= 11
call incrby s:counter i:5
send b'*3\r\n$6\r\nINCRBY\r\n$7\r\ncounter\r\n$1\r\n5\r\n'
= 16
call decrby s:counter i:2
send b'*3\r\n$6\r\nDECRBY\r\n$7\r\ncounter\r\n$1\r\n2\r\n'
= 14
call decr s:counter
send b'*3\r\n$6\r\nDECRBY\r\n$7\r\ncounter\r\n$1\r\n1\r\n'
= 13
call incrbyfloat s:counter f:0.75
send b'*3\r\n$11\r\nINCRBYFLOAT\r\n$7\r\ncounter\r\n$4\r\n0.75\r\n'
= 13.75
call append s:greeting s:%20world
send b'*3\r\n$6\r\nAPPEND\r\n$8\r\ngreeting\r\n$6\r\n world\r\n'
= 11
call getrange s:greeting i:3 i:7
send b'*4\r\n$8\r\nGETRANGE\r\n$8\r\ngreeting\r\n$1\r\n3\r\n$1\r\n7\r\n'
= b'lo wo'
call setrange s:greeting i:6 s:WORLD
send b'*4\r\n$8\r\nSETRANGE\r\n$8\r\ngreeting\r\n$1\r\n6\r\n$5\r\nWORLD\r\n'
= 11
call strlen s:greeting
send b'*2\r\n$6\r\nSTRLEN\r\n$8\r\ngreeting\r\n'
= 11
call getdel s:greeting
send b'*2\r\n$6\r\nGETDEL\r\n$8\r\ngreeting\r\n'
= b'hello WORLD'
call setex s:tmp i:60 s:v
send b'*4\r\n$5\r\nSETEX\r\n$3\r\ntmp\r\n$2\r\n60\r\n$1\r\nv\r\n'
= True
call psetex s:tmp i:60000 s:v
send b'*4\r\n$6\r\nPSETEX\r\n$3\r\ntmp\r\n$5\r\n60000\r\n$1\r\nv\r\n'
= True
call setnx s:lock s:me
send b'*3\r\n$5\r\nSETNX\r\n$4\r\nlock\r\n$2\r\nme\r\n'
= True
call setnx s:lock s:you
send b'*3\r\n$5\r\nSETNX\r\n$4\r\nlock\r\n$3\r\nyou\r\n'
= False
call mset { s:a s:1 s:b s:2 s:c i:3 }
send b'*7\r\n$4\r\nMSET\r\n$1\r\na\r\n$1\r\n1\r\n$1\r\nb\r\n$1\r\n2\r\n$1\r\nc\r\n$1\r\n3\r\n'
= True
call msetnx { s:a s:9 s:d s:4 }
send b'*5\r\n$6\r\nMSETNX\r\n$1\r\na\r\n$1\r\n9\r\n$1\r\nd\r\n$1\r\n4\r\n'
= False
call mget [ s:a s:b s:x ] s:d
send b'*5\r\n$4\r\nMGET\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nx\r\n$1\r\nd\r\n'
= [b'1', b'2', None, b'4']
call mget s:a
send b'*2\r\n$4\r\nMGET\r\n$1\r\na\r\n'
= [b'1']
call mget [ ]
send b'*1\r\n$4\r\nMGET\r\n'
= []
call getex s:tmp ex=i:5 px=i:5
send b'*6\r\n$5\r\nGETEX\r\n$3\r\ntmp\r\n$2\r\nEX\r\n$1\r\n5\r\n$2\r\nPX\r\n$1\r\n5\r\n'
= b'v'
call getex s:tmp ex=i:5 px=i:6 exat=i:7
! DataError: ``ex``, ``px``, ``exat``, ``pxat``, and ``persist`` are mutually exclusive.
call getex s:tmp ex=i:5 persist=T:
! DataError: ``ex``, ``px``, ``exat``, ``pxat``, and ``persist`` are mutually exclusive.
call getex s:tmp persist=T:
send b'*3\r\n$5\r\nGETEX\r\n$3\r\ntmp\r\n$7\r\nPERSIST\r\n'
= b'v'
call lcs s:k1 s:k2
send b'*3\r\n$3\r\nLCS\r\n$2\r\nk1\r\n$2\r\nk2\r\n'
= b'mytext'
call lcs s:k1 s:k2 len=T:
send b'*4\r\n$3\r\nLCS\r\n$2\r\nk1\r\n$2\r\nk2\r\n$3\r\nLEN\r\n'
= 6
close

== argument encoding
client
call set s:i i:-42
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*3\r\n$3\r\nSET\r\n$1\r\ni\r\n$3\r\n-42\r\n'
= True
call set s:f f:1.5
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$3\r\n1.5\r\n'
= True
call set s:f f:0.1
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$3\r\n0.1\r\n'
= True
call set s:f f:1e-05
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$5\r\n1e-05\r\n'
= True
call set s:f f:1e+16
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$5\r\n1e+16\r\n'
= True
call set s:f f:3.0
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$3\r\n3.0\r\n'
= True
call set s:f f:-0.0
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$4\r\n-0.0\r\n'
= True
call set s:f f:123456789.125
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$13\r\n123456789.125\r\n'
= True
call set s:f f:inf
send b'*3\r\n$3\r\nSET\r\n$1\r\nf\r\n$3\r\ninf\r\n'
= True
call set s:big i:12345678901234567
send b'*3\r\n$3\r\nSET\r\n$3\r\nbig\r\n$17\r\n12345678901234567\r\n'
= True
call set s:flag T:
! DataError: Invalid input of type: 'bool'. Convert to a bytes, string, int or float first.
call set s:none N:
! DataError: Invalid input of type: 'NoneType'. Convert to a bytes, string, int or float first.
call set s:list [ s:a ]
! DataError: Invalid input of type: 'list'. Convert to a bytes, string, int or float first.
call set b:bin%00key b:%00%01%FF%7F
send b'*3\r\n$3\r\nSET\r\n$7\r\nbin\x00key\r\n$4\r\n\x00\x01\xff\x7f\r\n'
= True
call set s:caf%C3%A9 s:na%C3%AFve%20%E2%98%95
send b'*3\r\n$3\r\nSET\r\n$5\r\ncaf\xc3\xa9\r\n$10\r\nna\xc3\xafve \xe2\x98\x95\r\n'
= True
call set s:quote s:it's%20%22quoted%22
send b'*3\r\n$3\r\nSET\r\n$5\r\nquote\r\n$13\r\nit\'s "quoted"\r\n'
= True
call execute_command s:SET s:raw s:v
send b'*3\r\n$3\r\nSET\r\n$3\r\nraw\r\n$1\r\nv\r\n'
= True
call execute_command b:SET%20EX b:x
send b'*3\r\n$3\r\nSET\r\n$2\r\nEX\r\n$1\r\nx\r\n'
= b'OK'
call execute_command s:ping
send b'*1\r\n$4\r\nping\r\n'
= True
close

== big values
client
call set s:blob r:x*7000
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*3\r\n$3\r\nSET\r\n$4\r\nblob\r\n$7000\r\n'
send <7000 bytes, fnv f1a95925>
send b'\r\n'
= True
call get s:blob
send b'*2\r\n$3\r\nGET\r\n$4\r\nblob\r\n'
= <6503 chars, fnv 6f113caf>
call mset { s:a r:z*5990 s:b s:short }
send <6024 bytes, fnv 968d4fc1>
send b'b'
send b'\r\n$5\r\nshort\r\n'
= True
close

== keys
client
call delete s:a s:b s:c
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*4\r\n$3\r\nDEL\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n'
= 2
call exists s:a
send b'*2\r\n$6\r\nEXISTS\r\n$1\r\na\r\n'
= 1
call expire s:a i:100
send b'*3\r\n$6\r\nEXPIRE\r\n$1\r\na\r\n$3\r\n100\r\n'
= True
call expire s:a i:100 nx=T: xx=T: gt=T: lt=T:
send b'*7\r\n$6\r\nEXPIRE\r\n$1\r\na\r\n$3\r\n100\r\n$2\r\nNX\r\n$2\r\nXX\r\n$2\r\nGT\r\n$2\r\nLT\r\n'
= False
call pexpire s:a i:2500 gt=T:
send b'*4\r\n$7\r\nPEXPIRE\r\n$1\r\na\r\n$4\r\n2500\r\n$2\r\nGT\r\n'
= True
call ttl s:a
send b'*2\r\n$3\r\nTTL\r\n$1\r\na\r\n'
= 97
call pttl s:gone
send b'*2\r\n$4\r\nPTTL\r\n$4\r\ngone\r\n'
= -2
call type s:a
send b'*2\r\n$4\r\nTYPE\r\n$1\r\na\r\n'
= b'string'
call type s:gone
send b'*2\r\n$4\r\nTYPE\r\n$4\r\ngone\r\n'
= b'none'
call rename s:a s:a2
send b'*3\r\n$6\r\nRENAME\r\n$1\r\na\r\n$2\r\na2\r\n'
= True
call rename s:gone s:x
send b'*3\r\n$6\r\nRENAME\r\n$4\r\ngone\r\n$1\r\nx\r\n'
! ResponseError: no such key
call renamenx s:a2 s:b
send b'*3\r\n$8\r\nRENAMENX\r\n$2\r\na2\r\n$1\r\nb\r\n'
= False
call keys s:user:*
send b'*2\r\n$4\r\nKEYS\r\n$6\r\nuser:*\r\n'
= [b'user:1', b'user:2', b'user:10']
call scan
send b'*2\r\n$4\r\nSCAN\r\n$1\r\n0\r\n'
= (0, [b'k1', b'k2'])
call scan i:0 match=s:user:* count=i:100 _type=s:string
send b'*8\r\n$4\r\nSCAN\r\n$1\r\n0\r\n$5\r\nMATCH\r\n$6\r\nuser:*\r\n$5\r\nCOUNT\r\n$3\r\n100\r\n$4\r\nTYPE\r\n$6\r\nstring\r\n'
= (17, [b'user:1'])
call copy s:a2 s:a3 destination_db=i:2 replace=T:
send b'*6\r\n$4\r\nCOPY\r\n$2\r\na2\r\n$2\r\na3\r\n$2\r\nDB\r\n$1\r\n2\r\n$7\r\nREPLACE\r\n'
= True
call persist s:a2
send b'*2\r\n$7\r\nPERSIST\r\n$2\r\na2\r\n'
= True
call unlink s:x s:y s:z
send b'*4\r\n$6\r\nUNLINK\r\n$1\r\nx\r\n$1\r\ny\r\n$1\r\nz\r\n'
= 3
call touch s:x s:y
send b'*3\r\n$5\r\nTOUCH\r\n$1\r\nx\r\n$1\r\ny\r\n'
= 2
call randomkey
send b'*1\r\n$9\r\nRANDOMKEY\r\n'
= b'user:2'
call randomkey
send b'*1\r\n$9\r\nRANDOMKEY\r\n'
= None
call object s:encoding s:a2
send b'*3\r\n$6\r\nOBJECT\r\n$8\r\nencoding\r\n$2\r\na2\r\n'
= b'embstr'
call object s:refcount s:a2
send b'*3\r\n$6\r\nOBJECT\r\n$8\r\nrefcount\r\n$2\r\na2\r\n'
= 5
close

== sort
client
call sort s:ids
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*2\r\n$4\r\nSORT\r\n$3\r\nids\r\n'
= [b'3', b'1', b'2']
call sort s:ids by=s:weight_* desc=T: alpha=T: start=i:0 num=i:3
send b'*9\r\n$4\r\nSORT\r\n$3\r\nids\r\n$2\r\nBY\r\n$8\r\nweight_*\r\n$5\r\nLIMIT\r\n$1\r\n0\r\n$1\r\n3\r\n$4\r\nDESC\r\n$5\r\nALPHA\r\n'
= [b'c', b'b', b'a']
call sort s:ids get=[ s:name_* s:age_* ] groups=T:
send b'*6\r\n$4\r\nSORT\r\n$3\r\nids\r\n$3\r\nGET\r\n$6\r\nname_*\r\n$3\r\nGET\r\n$5\r\nage_*\r\n'
= [(b'alice', b'30'), (b'bob', b'25')]
call sort s:ids get=s:name_* groups=T:
! DataError: when using "groups" the "get" argument must be specified and contain at least two keys
call sort s:ids start=i:2
! DataError: ``start`` and ``num`` must both be specified
call sort s:ids get=s:# store=s:sorted
send b'*6\r\n$4\r\nSORT\r\n$3\r\nids\r\n$3\r\nGET\r\n$1\r\n#\r\n$5\r\nSTORE\r\n$6\r\nsorted\r\n'
= 3
call sort s:empty get=[ s:a s:b ] groups=T:
send b'*6\r\n$4\r\nSORT\r\n$5\r\nempty\r\n$3\r\nGET\r\n$1\r\na\r\n$3\r\nGET\r\n$1\r\nb\r\n'
= []
close

== hashes
client
call hset s:user:1 s:name s:Ada
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*4\r\n$4\r\nHSET\r\n$6\r\nuser:1\r\n$4\r\nname\r\n$3\r\nAda\r\n'
= 1
call hset s:user:1 mapping={ s:age i:36 s:lang s:en }
send b'*6\r\n$4\r\nHSET\r\n$6\r\nuser:1\r\n$3\r\nage\r\n$2\r\n36\r\n$4\r\nlang\r\n$2\r\nen\r\n'
= 2
call hset s:user:1 s:k s:v items=[ s:x s:1 s:y s:2 ] mapping={ s:z s:3 }
send b'*10\r\n$4\r\nHSET\r\n$6\r\nuser:1\r\n$1\r\nx\r\n$1\r\n1\r\n$1\r\ny\r\n$1\r\n2\r\n$1\r\nk\r\n$1\r\nv\r\n$1\r\nz\r\n$1\r\n3\r\n'
= 2
call hset s:user:1
! DataError: 'hset' with no key value pairs
call hget s:user:1 s:name
send b'*3\r\n$4\r\nHGET\r\n$6\r\nuser:1\r\n$4\r\nname\r\n'
= b'Ada'
call hgetall s:user:1
send b'*2\r\n$7\r\nHGETALL\r\n$6\r\nuser:1\r\n'
= {b'name': b'Ada', b'age': b'36', b'lang': b'en'}
call hgetall s:nobody
send b'*2\r\n$7\r\nHGETALL\r\n$6\r\nnobody\r\n'
= {}
call hmget s:user:1 [ s:name s:email ]
send b'*4\r\n$5\r\nHMGET\r\n$6\r\nuser:1\r\n$4\r\nname\r\n$5\r\nemail\r\n'
= [b'Ada', None]
call hmget s:user:1 s:name s:age
send b'*4\r\n$5\r\nHMGET\r\n$6\r\nuser:1\r\n$4\r\nname\r\n$3\r\nage\r\n'
= [b'Ada', b'36']
call hdel s:user:1 s:lang s:none
send b'*4\r\n$4\r\nHDEL\r\n$6\r\nuser:1\r\n$4\r\nlang\r\n$4\r\nnone\r\n'
= 1
call hincrby s:user:1 s:age
send b'*4\r\n$7\r\nHINCRBY\r\n$6\r\nuser:1\r\n$3\r\nage\r\n$1\r\n1\r\n'
= 37
call hincrbyfloat s:user:1 s:age f:0.5
send b'*4\r\n$12\r\nHINCRBYFLOAT\r\n$6\r\nuser:1\r\n$3\r\nage\r\n$3\r\n0.5\r\n'
= 37.5
call hkeys s:user:1
send b'*2\r\n$5\r\nHKEYS\r\n$6\r\nuser:1\r\n'
= [b'name', b'age']
call hvals s:user:1
send b'*2\r\n$5\r\nHVALS\r\n$6\r\nuser:1\r\n'
= [b'Ada', b'37.5']
call hlen s:user:1
send b'*2\r\n$4\r\nHLEN\r\n$6\r\nuser:1\r\n'
= 2
call hexists s:user:1 s:name
send b'*3\r\n$7\r\nHEXISTS\r\n$6\r\nuser:1\r\n$4\r\nname\r\n'
= True
call hsetnx s:user:1 s:name s:Bob
send b'*4\r\n$6\r\nHSETNX\r\n$6\r\nuser:1\r\n$4\r\nname\r\n$3\r\nBob\r\n'
= 0
call hrandfield s:user:1 count=i:2 withvalues=T:
send b'*4\r\n$10\r\nHRANDFIELD\r\n$6\r\nuser:1\r\n$1\r\n2\r\n$10\r\nWITHVALUES\r\n'
= [b'age', b'37.5', b'name', b'Ada']
call hstrlen s:user:1 s:name
send b'*3\r\n$7\r\nHSTRLEN\r\n$6\r\nuser:1\r\n$4\r\nname\r\n'
= 3
call hscan s:user:1 match=s:* count=i:10
send b'*7\r\n$5\r\nHSCAN\r\n$6\r\nuser:1\r\n$1\r\n0\r\n$5\r\nMATCH\r\n$1\r\n*\r\n$5\r\nCOUNT\r\n$2\r\n10\r\n'
= (0, {b'name': b'Ada', b'age': b'37.5'})
call hscan s:user:1 no_values=T:
send b'*4\r\n$5\r\nHSCAN\r\n$6\r\nuser:1\r\n$1\r\n0\r\n$8\r\nNOVALUES\r\n'
= (0, [b'name', b'age'])
call hscan s:user:1 no_values=F:
send b'*4\r\n$5\r\nHSCAN\r\n$6\r\nuser:1\r\n$1\r\n0\r\n$8\r\nNOVALUES\r\n'
= (0, {b'name': b'age'})
call hscan s:empty
send b'*3\r\n$5\r\nHSCAN\r\n$5\r\nempty\r\n$1\r\n0\r\n'
= (0, {})
close

== lists
client
call lpush s:q s:a s:b s:c
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*5\r\n$5\r\nLPUSH\r\n$1\r\nq\r\n$1\r\na\r\n$1\r\nb\r\n$1\r\nc\r\n'
= 3
call rpush s:q i:1 f:2.5
send b'*4\r\n$5\r\nRPUSH\r\n$1\r\nq\r\n$1\r\n1\r\n$3\r\n2.5\r\n'
= 5
call lpop s:q
send b'*2\r\n$4\r\nLPOP\r\n$1\r\nq\r\n'
= b'c'
call lpop s:q count=i:2
send b'*3\r\n$4\r\nLPOP\r\n$1\r\nq\r\n$1\r\n2\r\n'
= [b'b', b'a']
call rpop s:empty
send b'*2\r\n$4\r\nRPOP\r\n$5\r\nempty\r\n'
= None
call rpop s:q i:1
send b'*3\r\n$4\r\nRPOP\r\n$1\r\nq\r\n$1\r\n1\r\n'
= [b'2.5']
call lrange s:q i:0 i:-1
send b'*4\r\n$6\r\nLRANGE\r\n$1\r\nq\r\n$1\r\n0\r\n$2\r\n-1\r\n'
= [b'1']
call llen s:q
send b'*2\r\n$4\r\nLLEN\r\n$1\r\nq\r\n'
= 1
call lindex s:q i:0
send b'*3\r\n$6\r\nLINDEX\r\n$1\r\nq\r\n$1\r\n0\r\n'
= b'1'
call lset s:q i:0 s:one
send b'*4\r\n$4\r\nLSET\r\n$1\r\nq\r\n$1\r\n0\r\n$3\r\none\r\n'
= True
call lset s:q i:9 s:x
send b'*4\r\n$4\r\nLSET\r\n$1\r\nq\r\n$1\r\n9\r\n$1\r\nx\r\n'
! ResponseError: index out of range
call ltrim s:q i:0 i:99
send b'*4\r\n$5\r\nLTRIM\r\n$1\r\nq\r\n$1\r\n0\r\n$2\r\n99\r\n'
= True
call blpop [ s:q s:r ] timeout=i:1
send b'*4\r\n$5\r\nBLPOP\r\n$1\r\nq\r\n$1\r\nr\r\n$1\r\n1\r\n'
= (b'q', b'one')
call brpop s:q timeout=N:
send b'*3\r\n$5\r\nBRPOP\r\n$1\r\nq\r\n$1\r\n0\r\n'
= None
call lpos s:q s:x
send b'*3\r\n$4\r\nLPOS\r\n$1\r\nq\r\n$1\r\nx\r\n'
= 2
call lpos s:q s:x rank=i:-1 count=i:2 maxlen=i:100
send b'*9\r\n$4\r\nLPOS\r\n$1\r\nq\r\n$1\r\nx\r\n$4\r\nRANK\r\n$2\r\n-1\r\n$5\r\nCOUNT\r\n$1\r\n2\r\n$6\r\nMAXLEN\r\n$3\r\n100\r\n'
= [2, 6]
call lmove s:q s:r
send b'*5\r\n$5\r\nLMOVE\r\n$1\r\nq\r\n$1\r\nr\r\n$4\r\nLEFT\r\n$5\r\nRIGHT\r\n'
= b'one'
call lmove s:q s:r s:RIGHT s:LEFT
send b'*5\r\n$5\r\nLMOVE\r\n$1\r\nq\r\n$1\r\nr\r\n$5\r\nRIGHT\r\n$4\r\nLEFT\r\n'
= b'one'
call linsert s:q s:BEFORE s:one s:zero
send b'*5\r\n$7\r\nLINSERT\r\n$1\r\nq\r\n$6\r\nBEFORE\r\n$3\r\none\r\n$4\r\nzero\r\n'
= 4
call lrem s:q i:0 s:x
send b'*4\r\n$4\r\nLREM\r\n$1\r\nq\r\n$1\r\n0\r\n$1\r\nx\r\n'
= 2
close

== sets
client
call sadd s:tags s:red s:green s:blue
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*5\r\n$4\r\nSADD\r\n$4\r\ntags\r\n$3\r\nred\r\n$5\r\ngreen\r\n$4\r\nblue\r\n'
= 3
call srem s:tags s:green
send b'*3\r\n$4\r\nSREM\r\n$4\r\ntags\r\n$5\r\ngreen\r\n'
= 1
call smembers s:tags
send b'*2\r\n$8\r\nSMEMBERS\r\n$4\r\ntags\r\n'
= {b'blue', b'red'}
call smembers s:none
send b'*2\r\n$8\r\nSMEMBERS\r\n$4\r\nnone\r\n'
= set()
call sismember s:tags s:red
send b'*3\r\n$9\r\nSISMEMBER\r\n$4\r\ntags\r\n$3\r\nred\r\n'
= 1
call smismember s:tags [ s:red s:pink ]
send b'*4\r\n$10\r\nSMISMEMBER\r\n$4\r\ntags\r\n$3\r\nred\r\n$4\r\npink\r\n'
= [1, 0]
call scard s:tags
send b'*2\r\n$5\r\nSCARD\r\n$4\r\ntags\r\n'
= 2
call sinter [ s:tags s:warm ]
send b'*3\r\n$6\r\nSINTER\r\n$4\r\ntags\r\n$4\r\nwarm\r\n'
= {b'red'}
call sunion s:tags s:warm
send b'*3\r\n$6\r\nSUNION\r\n$4\r\ntags\r\n$4\r\nwarm\r\n'
= {b'blue', b'orange', b'red'}
call sdiff s:tags s:warm
send b'*3\r\n$5\r\nSDIFF\r\n$4\r\ntags\r\n$4\r\nwarm\r\n'
= {b'blue'}
call spop s:tags
send b'*2\r\n$4\r\nSPOP\r\n$4\r\ntags\r\n'
= b'blue'
call spop s:tags count=i:0
send b'*3\r\n$4\r\nSPOP\r\n$4\r\ntags\r\n$1\r\n0\r\n'
= [b'red']
call srandmember s:tags i:-2
send b'*3\r\n$11\r\nSRANDMEMBER\r\n$4\r\ntags\r\n$2\r\n-2\r\n'
= [b'red', b'red']
call sscan s:tags match=s:r*
send b'*5\r\n$5\r\nSSCAN\r\n$4\r\ntags\r\n$1\r\n0\r\n$5\r\nMATCH\r\n$2\r\nr*\r\n'
= (0, [b'red'])
call smove s:tags s:warm s:red
send b'*4\r\n$5\r\nSMOVE\r\n$4\r\ntags\r\n$4\r\nwarm\r\n$3\r\nred\r\n'
= True
close

== sorted sets
client
call zadd s:board { s:ada i:10 s:bob f:7.5 s:cy i:12 }
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*8\r\n$4\r\nZADD\r\n$5\r\nboard\r\n$2\r\n10\r\n$3\r\nada\r\n$3\r\n7.5\r\n$3\r\nbob\r\n$2\r\n12\r\n$2\r\ncy\r\n'
= 3
call zadd s:board { s:ada i:1 } nx=T: xx=T:
! DataError: ZADD allows either 'nx' or 'xx', not both
call zadd s:board { s:ada i:1 } gt=T: lt=T:
! DataError: ZADD allows either 'gt' or 'lt', not both
call zadd s:board { s:ada i:1 s:bob i:2 } incr=T:
! DataError: ZADD option 'incr' only works when passing a single element/score pair
call zadd s:board { s:ada i:1 } nx=T: gt=T:
! DataError: Only one of 'nx', 'lt', or 'gr' may be defined.
call zadd s:board { }
! DataError: ZADD requires at least one element/score pair
call zadd s:board { s:ada i:1 } incr=T:
send b'*5\r\n$4\r\nZADD\r\n$5\r\nboard\r\n$4\r\nINCR\r\n$1\r\n1\r\n$3\r\nada\r\n'
= 11.0
call zadd s:board { s:ada i:1 } incr=T: xx=T: lt=T:
send b'*7\r\n$4\r\nZADD\r\n$5\r\nboard\r\n$2\r\nXX\r\n$4\r\nINCR\r\n$2\r\nLT\r\n$1\r\n1\r\n$3\r\nada\r\n'
= None
call zadd s:board { s:dee i:3 } ch=T: xx=T: gt=T:
send b'*7\r\n$4\r\nZADD\r\n$5\r\nboard\r\n$2\r\nXX\r\n$2\r\nCH\r\n$2\r\nGT\r\n$1\r\n3\r\n$3\r\ndee\r\n'
= 1
call zrange s:board i:0 i:-1
send b'*4\r\n$6\r\nZRANGE\r\n$5\r\nboard\r\n$1\r\n0\r\n$2\r\n-1\r\n'
= [b'bob', b'ada', b'cy']
call zrange s:board i:0 i:-1 withscores=T:
send b'*5\r\n$6\r\nZRANGE\r\n$5\r\nboard\r\n$1\r\n0\r\n$2\r\n-1\r\n$10\r\nWITHSCORES\r\n'
= [(b'bob', 7.5), (b'ada', 11.0), (b'cy', 12.0)]
call zrange s:board i:0 i:1 desc=T: withscores=T:
send b'*5\r\n$9\r\nZREVRANGE\r\n$5\r\nboard\r\n$1\r\n0\r\n$1\r\n1\r\n$10\r\nWITHSCORES\r\n'
= [(b'cy', 12.0), (b'ada', 11.0)]
call zrange s:board s:(8 s:+inf byscore=T: offset=i:0 num=i:2
send b'*8\r\n$6\r\nZRANGE\r\n$5\r\nboard\r\n$2\r\n(8\r\n$4\r\n+inf\r\n$7\r\nBYSCORE\r\n$5\r\nLIMIT\r\n$1\r\n0\r\n$1\r\n2\r\n'
= [b'ada', b'cy']
call zrange s:board s:+inf s:(8 byscore=T: desc=T: offset=i:0 num=i:2
send b'*9\r\n$6\r\nZRANGE\r\n$5\r\nboard\r\n$4\r\n+inf\r\n$2\r\n(8\r\n$7\r\nBYSCORE\r\n$3\r\nREV\r\n$5\r\nLIMIT\r\n$1\r\n0\r\n$1\r\n2\r\n'
= [b'cy', b'ada']
call zrange s:board i:0 i:1 byscore=T: bylex=T:
! DataError: ``byscore`` and ``bylex`` can not be specified together.
call zrange s:board s:[a s:[z bylex=T: withscores=T:
! DataError: ``withscores`` not supported in combination with ``bylex``.
call zrange s:board i:0 i:1 offset=i:1
! DataError: ``offset`` and ``num`` must both be specified.
call zrangebyscore s:board s:-inf i:11 start=i:0 num=i:1 withscores=T:
send b'*8\r\n$13\r\nZRANGEBYSCORE\r\n$5\r\nboard\r\n$4\r\n-inf\r\n$2\r\n11\r\n$5\r\nLIMIT\r\n$1\r\n0\r\n$1\r\n1\r\n$10\r\nWITHSCORES\r\n'
= [(b'ada', 11.0)]
call zrangebyscore s:board i:0 i:1 start=i:0
! DataError: ``start`` and ``num`` must both be specified
call zrevrange s:board i:0 i:1
send b'*4\r\n$9\r\nZREVRANGE\r\n$5\r\nboard\r\n$1\r\n0\r\n$1\r\n1\r\n'
= [b'cy', b'ada']
call zscore s:board s:bob
send b'*3\r\n$6\r\nZSCORE\r\n$5\r\nboard\r\n$3\r\nbob\r\n'
= 7.5
call zscore s:board s:nobody
send b'*3\r\n$6\r\nZSCORE\r\n$5\r\nboard\r\n$6\r\nnobody\r\n'
= None
call zscore s:board s:infinite
send b'*3\r\n$6\r\nZSCORE\r\n$5\r\nboard\r\n$8\r\ninfinite\r\n'
= inf
call zscore s:board s:neg
send b'*3\r\n$6\r\nZSCORE\r\n$5\r\nboard\r\n$3\r\nneg\r\n'
= -inf
call zincrby s:board f:2.0 s:bob
send b'*4\r\n$7\r\nZINCRBY\r\n$5\r\nboard\r\n$3\r\n2.0\r\n$3\r\nbob\r\n'
= 9.5
call zrank s:board s:bob
send b'*3\r\n$5\r\nZRANK\r\n$5\r\nboard\r\n$3\r\nbob\r\n'
= 0
call zrank s:board s:bob withscore=T:
send b'*4\r\n$5\r\nZRANK\r\n$5\r\nboard\r\n$3\r\nbob\r\n$9\r\nWITHSCORE\r\n'
= [0, b'9.5']
call zrank s:board s:nobody
send b'*3\r\n$5\r\nZRANK\r\n$5\r\nboard\r\n$6\r\nnobody\r\n'
= None
call zrem s:board s:dee
send b'*3\r\n$4\r\nZREM\r\n$5\r\nboard\r\n$3\r\ndee\r\n'
= 1
call zcard s:board
send b'*2\r\n$5\r\nZCARD\r\n$5\r\nboard\r\n'
= 3
call zcount s:board s:(9 s:+inf
send b'*4\r\n$6\r\nZCOUNT\r\n$5\r\nboard\r\n$2\r\n(9\r\n$4\r\n+inf\r\n'
= 2
call zpopmin s:board
send b'*2\r\n$7\r\nZPOPMIN\r\n$5\r\nboard\r\n'
= [(b'bob', 9.5)]
call zpopmin s:board i:2
send b'*3\r\n$7\r\nZPOPMIN\r\n$5\r\nboard\r\n$1\r\n2\r\n'
= [(b'ada', 11.0), (b'cy', 12.0)]
call zpopmin s:empty
send b'*2\r\n$7\r\nZPOPMIN\r\n$5\r\nempty\r\n'
= []
call zmscore s:board [ s:ada s:x ]
send b'*4\r\n$7\r\nZMSCORE\r\n$5\r\nboard\r\n$3\r\nada\r\n$1\r\nx\r\n'
= [11.0, None]
call zmscore s:board [ ]
! DataError: ZMSCORE members must be a non-empty list
call zscan s:board
send b'*3\r\n$5\r\nZSCAN\r\n$5\r\nboard\r\n$1\r\n0\r\n'
= (0, [(b'ada', 11.0), (b'cy', 12.0)])
call zscan s:board score_cast_func=c:int
send b'*3\r\n$5\r\nZSCAN\r\n$5\r\nboard\r\n$1\r\n0\r\n'
= (0, [(b'ada', 11)])
call zscan s:board score_cast_func=c:int
send b'*3\r\n$5\r\nZSCAN\r\n$5\r\nboard\r\n$1\r\n0\r\n'
! ValueError: invalid literal for int() with base 10: b'11.5'
call zrange s:board i:0 i:0 withscores=T: score_cast_func=c:int
send b'*5\r\n$6\r\nZRANGE\r\n$5\r\nboard\r\n$1\r\n0\r\n$1\r\n0\r\n$10\r\nWITHSCORES\r\n'
= [(b'ada', 11)]
call zunionstore s:out [ s:a s:b ]
send b'*5\r\n$11\r\nZUNIONSTORE\r\n$3\r\nout\r\n$1\r\n2\r\n$1\r\na\r\n$1\r\nb\r\n'
= 4
call zunionstore s:out { s:a i:2 s:b f:0.5 } aggregate=s:max
send b'*10\r\n$11\r\nZUNIONSTORE\r\n$3\r\nout\r\n$1\r\n2\r\n$1\r\na\r\n$1\r\nb\r\n$7\r\nWEIGHTS\r\n$1\r\n2\r\n$3\r\n0.5\r\n$9\r\nAGGREGATE\r\n$3\r\nmax\r\n'
= 4
call zunionstore s:out [ s:a ] aggregate=s:avg
! DataError: aggregate can be sum, min or max.
close

== streams
client
call xadd s:events { s:type s:login s:user s:ada }
connect #1
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*7\r\n$4\r\nXADD\r\n$6\r\nevents\r\n$1\r\n*\r\n$4\r\ntype\r\n$5\r\nlogin\r\n$4\r\nuser\r\n$3\r\nada\r\n'
= b'1700000000000-0'
call xadd s:events { s:type s:logout } maxlen=i:1000
send b'*8\r\n$4\r\nXADD\r\n$6\r\nevents\r\n$6\r\nMAXLEN\r\n$1\r\n~\r\n$4\r\n1000\r\n$1\r\n*\r\n$4\r\ntype\r\n$6\r\nlogout\r\n'
= b'1700000000001-0'
call xadd s:events { s:t i:1 } maxlen=i:10 approximate=F: limit=i:5 nomkstream=T: id=s:1700000000002-0
send b'*10\r\n$4\r\nXADD\r\n$6\r\nevents\r\n$6\r\nMAXLEN\r\n$2\r\n10\r\n$5\r\nLIMIT\r\n$1\r\n5\r\n$10\r\nNOMKSTREAM\r\n$15\r\n1700000000002-0\r\n$1\r\nt\r\n$1\r\n1\r\n'
= b'1700000000002-0'
call xadd s:events { s:t i:2 } minid=s:1699999999999-0 nomkstream=T:
send b'*9\r\n$4\r\nXADD\r\n$6\r\nevents\r\n$5\r\nMINID\r\n$1\r\n~\r\n$15\r\n1699999999999-0\r\n$10\r\nNOMKSTREAM\r\n$1\r\n*\r\n$1\r\nt\r\n$1\r\n2\r\n'
= None
call xadd s:events { s:t i:1 } maxlen=i:10 minid=s:0
! DataError: Only one of ```maxlen``` or ```minid``` may be specified
call xadd s:events { }
! DataError: XADD fields must be a non-empty dict
call xadd s:events { s:t i:1 } maxlen=i:-1
! DataError: XADD maxlen must be non-negative integer
call xrange s:events
send b'*4\r\n$6\r\nXRANGE\r\n$6\r\nevents\r\n$1\r\n-\r\n$1\r\n+\r\n'
= [(b'1700000000000-0', {b'type': b'login', b'user': b'ada'}), (b'1700000000001-0', {b'type': b'logout'})]
call xrange s:events min=s:- max=s:+ count=i:1
send b'*6\r\n$6\r\nXRANGE\r\n$6\r\nevents\r\n$1\r\n-\r\n$1\r\n+\r\n$5\r\nCOUNT\r\n$1\r\n1\r\n'
= [(b'1700000000000-0', {b'type': b'login', b'user': b'ada'})]
call xrange s:events count=i:0
! DataError: XRANGE count must be a positive integer
