= True
pipe reset
send b'*1\r\n$7\r\nUNWATCH\r\n'
= None
pipe watch s:a
send b'*2\r\n$5\r\nWATCH\r\n$1\r\na\r\n'
= True
call get s:a
send b'*2\r\n$3\r\nGET\r\n$1\r\na\r\n'
close
connect #2
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$8\r\nLIB-NAME\r\n$8\r\nredis-py\r\n'
send b'*4\r\n$6\r\nCLIENT\r\n$7\r\nSETINFO\r\n$7\r\nLIB-VER\r\n$5\r\n5.2.1\r\n'
send b'*1\r\n$7\r\nUNWATCH\r\n'
