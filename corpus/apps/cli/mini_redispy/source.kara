// mini_redispy: a port of redis-py 5.2.1 (MIT; Redis Inc. and its
// contributors), the Python client that most Python services use to talk
// to Redis: Django and Flask caches, Celery and RQ queues, rate limiters,
// session stores. This is its pure Python path: the RESP2 and RESP3
// parsers over a socket buffer, the command packer, the encoder, the
// connection's handshake (AUTH, HELLO, CLIENT SETNAME, CLIENT SETINFO,
// SELECT), the connection pool and its stale-data check, retries, the
// command methods and the reply callbacks for strings, keys, hashes,
// lists, sets, sorted sets, streams, geo, scripts, bits and the server,
// pipelines, MULTI/EXEC transactions and WATCH, and parse_url().
//
// The other end of the socket is a scripted server. data/jobs.txt gives
// each job a client, the replies the server sends (one per command it
// receives, or "close" or "hang"), and the calls to make. The program
// prints what the client sent, what it connected and closed, and what each
// call returned or raised, the way oracle.py prints it from the real
// redis-py talking to the same script.

// ------------------------------------------------------------ text helpers

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn str_of(cs: ref Vec[char], from: i64, to: i64) -> String {
    let mut out = String.new();
    let mut i = from;
    while i < to {
        out.push(cs[i]);
        i += 1;
    }
    out
}

fn bytes_of(s: ref String) -> Vec[u8] {
    s.bytes().to_vec()
}

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = from;
    while i < to {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn append(a: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b {
        a.push(x);
    }
}

fn push_text(a: mut ref Vec[u8], s: ref String) {
    for x in s.bytes() {
        a.push(x);
    }
}

fn same_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn bytes_lit(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn upper(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'a' and c <= 'z' {
            out.push(chr(c as i64 - 32));
        } else {
            out.push(c);
        }
    }
    out
}

fn lower(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(chr(c as i64 + 32));
        } else {
            out.push(c);
        }
    }
    out
}

// str.split(sep) on a one-or-more-character separator.
fn split_str(s: ref String, sep: Str) -> Vec[String] {
    let cs = chars_of(s);
    let ps: Vec[char] = sep.chars().collect();
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i + ps.len() <= cs.len() {
        let mut hit = true;
        for k in 0..ps.len() {
            if cs[i + k] != ps[k] {
                hit = false;
                break;
            }
        }
        if hit {
            out.push(str_of(cs, start, i));
            i += ps.len();
            start = i;
        } else {
            i += 1;
        }
    }
    out.push(str_of(cs, start, cs.len()));
    out
}

// str.split(sep, 1).
fn split_once(s: ref String, sep: Str) -> Vec[String] {
    let parts = split_str(s, sep);
    if parts.len() <= 2 {
        return parts;
    }
    let mut rest = parts[1].clone();
    for i in 2..parts.len() {
        rest.push_str(sep);
        rest.push_str(parts[i]);
    }
    vec![parts[0].clone(), rest]
}

// str.rsplit(sep, 1).
fn rsplit_once(s: ref String, sep: Str) -> Vec[String] {
    let parts = split_str(s, sep);
    if parts.len() <= 2 {
        return parts;
    }
    let mut head = parts[0].clone();
    for i in 1..parts.len() - 1 {
        head.push_str(sep);
        head.push_str(parts[i]);
    }
    vec![head, parts[parts.len() - 1].clone()]
}

fn is_space(c: char) -> bool {
    let n = c as i64;
    (n >= 9 and n <= 13) or (n >= 28 and n <= 32) or n == 0x85 or n == 0xA0 or n == 0x1680 or (n >= 0x2000 and n <= 0x200A) or n == 0x2028 or n == 0x2029 or n == 0x202F or n == 0x205F or n == 0x3000
}

// str.split() with no separator: runs of whitespace, ends dropped.
fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut inword = false;
    for c in s.chars() {
        if is_space(c) {
            if inword {
                out.push(cur.clone());
                cur = String.new();
                inword = false;
            }
        } else {
            cur.push(c);
            inword = true;
        }
    }
    if inword {
        out.push(cur);
    }
    out
}

fn strip(s: ref String) -> String {
    let cs = chars_of(s);
    let mut a = 0;
    let mut e = cs.len();
    while a < e and is_space(cs[a]) {
        a += 1;
    }
    while e > a and is_space(cs[e - 1]) {
        e -= 1;
    }
    str_of(cs, a, e)
}

fn is_line_break(c: char) -> bool {
    let n = c as i64;
    (n >= 10 and n <= 13) or (n >= 28 and n <= 30) or n == 0x85 or n == 0x2028 or n == 0x2029
}

// str.splitlines().
fn splitlines(s: ref String) -> Vec[String] {
    let cs = chars_of(s);
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i < cs.len() {
        if is_line_break(cs[i]) {
            out.push(str_of(cs, start, i));
            if cs[i] == '\r' and i + 1 < cs.len() and cs[i + 1] == '\n' {
                i += 1;
            }
            i += 1;
            start = i;
        } else {
            i += 1;
        }
    }
    if start < cs.len() {
        out.push(str_of(cs, start, cs.len()));
    }
    out
}

// bytes.split() with no separator (ASCII whitespace).
fn split_bytes_ws(b: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for x in b {
        if x == b' ' or x == b'\t' or x == b'\n' or x == b'\r' or x == 11 or x == 12 {
            if cur.len() > 0 {
                out.push(cur.clone());
                cur = Vec.new();
            }
        } else {
            cur.push(x);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

fn has_byte(b: ref Vec[u8], x: u8) -> bool {
    for y in b {
        if y == x {
            return true;
        }
    }
    false
}

const MASK32: i64 = 4294967295;

fn fnv(data: ref Vec[u8]) -> i64 {
    let mut h: i64 = 2166136261;
    for b in data {
        h = ((h ^ (b as i64)) * 16777619) & MASK32;
    }
    h
}

// ------------------------------------------------------------ repr

// Whether str.isprintable() holds: the controls, the C1 range, the spaces
// other than U+0020, the line and paragraph separators, the format
// characters and the private use area are not printable.
fn printable(n: i64) -> bool {
    if n < 32 or (n >= 127 and n <= 160) or n == 173 or n == 0x1680 {
        return false;
    }
    if (n >= 0x2000 and n <= 0x200F) or (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) {
        return false;
    }
    if n == 0x3000 or n == 0xFEFF or (n >= 0xFFF9 and n <= 0xFFFB) {
        return false;
    }
    if n >= 0xD800 and n <= 0xDFFF {
        return false;
    }
    not (n >= 0xE000 and n <= 0xF8FF)
}

// repr() of a str.
fn str_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if not printable(n) {
            if n < 256 {
                out.push_str(f"\\x{n:02x}");
            } else if n < 0x10000 {
                out.push_str(f"\\u{n:04x}");
            } else {
                out.push_str(f"\\U{n:08x}");
            }
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// repr() of a bytes.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b {
        if x == b'\'' {
            has_single = true;
        }
        if x == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let mut out = String.new();
    out.push('b');
    out.push(chr(q as i64));
    for c in b {
        if c == q or c == b'\\' {
            out.push('\\');
            out.push(chr(c as i64));
        } else if c == b'\n' {
            out.push_str("\\n");
        } else if c == b'\r' {
            out.push_str("\\r");
        } else if c == b'\t' {
            out.push_str("\\t");
        } else if c < 32 or c >= 127 {
            let n = c as i64;
            out.push_str(f"\\x{n:02x}");
        } else {
            out.push(chr(c as i64));
        }
    }
    out.push(chr(q as i64));
    out
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == f64.INFINITY {
        return "inf".to_string();
    }
    if x == -f64.INFINITY {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    f"{x}"
}

// ------------------------------------------------------------ exceptions

// A Python exception: its class and str(e). For the exceptions redis-py
// raises that is args[0].
#[derive(Clone)]
struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

fn data_error(msg: Str) -> Exc {
    exc("DataError", msg.to_string())
}

fn conn_error(msg: Str) -> Exc {
    exc("ConnectionError", msg.to_string())
}

fn timeout_error() -> Exc {
    exc("TimeoutError", "Timeout reading from socket".to_string())
}

const SERVER_CLOSED: Str = "Connection closed by server.";

// The base class of each exception class the port raises.
fn parent_of(cls: ref String) -> String {
    let p = match cls.as_str() {
        "ConnectionError" => "RedisError",
        "TimeoutError" => "RedisError",
        "AuthenticationError" => "ConnectionError",
        "BusyLoadingError" => "ConnectionError",
        "InvalidResponse" => "RedisError",
        "ResponseError" => "RedisError",
        "DataError" => "RedisError",
        "WatchError" => "RedisError",
        "NoScriptError" => "ResponseError",
        "OutOfMemoryError" => "ResponseError",
        "ExecAbortError" => "ResponseError",
        "ReadOnlyError" => "ResponseError",
        "NoPermissionError" => "ResponseError",
        "ModuleError" => "ResponseError",
        "AuthenticationWrongNumberOfArgsError" => "ResponseError",
        "UnicodeDecodeError" => "ValueError",
        "RedisError" => "Exception",
        "ValueError" => "Exception",
        "KeyError" => "LookupError",
        "IndexError" => "LookupError",
        "LookupError" => "Exception",
        "TypeError" => "Exception",
        "AttributeError" => "Exception",
        _ => "",
    };
    p.to_string()
}

// isinstance(e, base).
fn is_a(e: ref Exc, base: Str) -> bool {
    let mut c = e.cls.clone();
    while c.len() > 0 {
        if c == base {
            return true;
        }
        c = parent_of(c);
    }
    false
}

// ------------------------------------------------------------ values

#[derive(Clone)]
enum Val {
    Non,
    Bool(bool),
    Int(i64),
    Big(String),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[Val]),
    Tuple(Vec[Val]),
    Set(Vec[Val]),
    Dict(Vec[Val], Vec[Val]),
    Err(String, String),
    Cls(String),
}

fn vs(s: Str) -> Val {
    Val.Str(s.to_string())
}

fn vstr(s: ref String) -> Val {
    Val.Str(s.clone())
}

fn vb(s: Str) -> Val {
    Val.Bytes(bytes_lit(s))
}

fn vexc(e: ref Exc) -> Val {
    Val.Err(e.cls.clone(), e.msg.clone())
}

fn is_none(v: ref Val) -> bool {
    match v {
        Val.Non => true,
        _ => false,
    }
}

fn is_list(v: ref Val) -> bool {
    match v {
        Val.List(_) => true,
        _ => false,
    }
}

fn is_dict(v: ref Val) -> bool {
    match v {
        Val.Dict(_, _) => true,
        _ => false,
    }
}

fn is_text(v: ref Val) -> bool {
    match v {
        Val.Str(_) => true,
        Val.Bytes(_) => true,
        _ => false,
    }
}

fn is_bool(v: ref Val) -> bool {
    match v {
        Val.Bool(_) => true,
        _ => false,
    }
}

// isinstance(v, int): a bool is one.
fn is_int(v: ref Val) -> bool {
    match v {
        Val.Bool(_) => true,
        Val.Int(_) => true,
        Val.Big(_) => true,
        _ => false,
    }
}

fn is_exc(v: ref Val) -> bool {
    match v {
        Val.Err(_, _) => true,
        _ => false,
    }
}

fn int_val(v: ref Val) -> i64 {
    match v {
        Val.Bool(b) => if b { 1 } else { 0 },
        Val.Int(n) => n,
        _ => 0,
    }
}

fn type_name(v: ref Val) -> String {
    let n = match v {
        Val.Non => "NoneType",
        Val.Bool(_) => "bool",
        Val.Int(_) => "int",
        Val.Big(_) => "int",
        Val.Float(_) => "float",
        Val.Str(_) => "str",
        Val.Bytes(_) => "bytes",
        Val.List(_) => "list",
        Val.Tuple(_) => "tuple",
        Val.Set(_) => "set",
        Val.Dict(_, _) => "dict",
        Val.Err(_, _) => "Exception",
        Val.Cls(_) => "type",
    };
    n.to_string()
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.Non => false,
        Val.Bool(b) => b,
        Val.Int(n) => n != 0,
        Val.Big(_) => true,
        Val.Float(x) => x != 0.0,
        Val.Str(s) => s.len() > 0,
        Val.Bytes(b) => b.len() > 0,
        Val.List(xs) => xs.len() > 0,
        Val.Tuple(xs) => xs.len() > 0,
        Val.Set(xs) => xs.len() > 0,
        Val.Dict(ks, _) => ks.len() > 0,
        Val.Err(_, _) => true,
        Val.Cls(_) => true,
    }
}

fn items_of(v: ref Val) -> Vec[Val] {
    match v {
        Val.List(xs) => xs.clone(),
        Val.Tuple(xs) => xs.clone(),
        Val.Set(xs) => xs.clone(),
        Val.Dict(ks, _) => ks.clone(),
        _ => Vec.new(),
    }
}

fn len_of(v: ref Val) -> i64 {
    match v {
        Val.Str(s) => s.chars().count() as i64,
        Val.Bytes(b) => b.len() as i64,
        _ => items_of(v).len() as i64,
    }
}

fn at(v: ref Val, i: i64) -> Val {
    let xs = items_of(v);
    let j = if i < 0 { xs.len() as i64 + i } else { i };
    if j < 0 or j >= xs.len() as i64 {
        return Val.Non;
    }
    xs[j].clone()
}

// a == b, as Python compares them.
fn py_eq(a: ref Val, b: ref Val) -> bool {
    match a {
        Val.Non => is_none(b),
        Val.Bool(_) => num_eq(a, b),
        Val.Int(_) => num_eq(a, b),
        Val.Float(_) => num_eq(a, b),
        Val.Big(x) => match b {
            Val.Big(y) => x == y,
            _ => false,
        },
        Val.Str(x) => match b {
            Val.Str(y) => x == y,
            _ => false,
        },
        Val.Bytes(x) => match b {
            Val.Bytes(y) => same_bytes(x, y),
            _ => false,
        },
        Val.List(xs) => match b {
            Val.List(ys) => all_eq(xs, ys),
            _ => false,
        },
        Val.Tuple(xs) => match b {
            Val.Tuple(ys) => all_eq(xs, ys),
            _ => false,
        },
        Val.Set(xs) => match b {
            Val.Set(ys) => xs.len() == ys.len() and all_in(xs, ys),
            _ => false,
        },
        Val.Dict(ks, xs) => match b {
            Val.Dict(ls, ys) => {
                if ks.len() != ls.len() {
                    return false;
                }
                for i in 0..ks.len() {
                    let j = index_of(ls, ks[i]);
                    if j < 0 or not py_eq(xs[i], ys[j]) {
                        return false;
                    }
                }
                true
            }
            _ => false,
        },
        Val.Err(_, _) => false,
        Val.Cls(x) => match b {
            Val.Cls(y) => x == y,
            _ => false,
        },
    }
}

fn num_eq(a: ref Val, b: ref Val) -> bool {
    match b {
        Val.Bool(_) => {}
        Val.Int(_) => {}
        Val.Float(_) => {}
        _ => return false,
    }
    match a {
        Val.Float(x) => match b {
            Val.Float(y) => x == y,
            _ => x == int_val(b) as f64,
        },
        _ => match b {
            Val.Float(y) => int_val(a) as f64 == y,
            _ => int_val(a) == int_val(b),
        },
    }
}

fn all_eq(xs: ref Vec[Val], ys: ref Vec[Val]) -> bool {
    if xs.len() != ys.len() {
        return false;
    }
    for i in 0..xs.len() {
        if not py_eq(xs[i], ys[i]) {
            return false;
        }
    }
    true
}

fn all_in(xs: ref Vec[Val], ys: ref Vec[Val]) -> bool {
    for x in xs {
        if index_of(ys, x) < 0 {
            return false;
        }
    }
    true
}

fn index_of(xs: ref Vec[Val], v: ref Val) -> i64 {
    for i in 0..xs.len() {
        if py_eq(xs[i], v) {
            return i as i64;
        }
    }
    -1
}

fn set_add(xs: mut ref Vec[Val], v: own Val) {
    if index_of(xs, v) < 0 {
        xs.push(v);
    }
}

fn set_of(xs: ref Vec[Val]) -> Val {
    let mut out: Vec[Val] = Vec.new();
    for x in xs {
        set_add(mut out, x.clone());
    }
    Val.Set(out)
}

// d[k] = v on a dict's key and value lists.
fn dict_put(ks: mut ref Vec[Val], vals: mut ref Vec[Val], k: own Val, v: own Val) {
    let i = index_of(ks, k);
    if i >= 0 {
        vals[i] = v;
    } else {
        ks.push(k);
        vals.push(v);
    }
}

fn dict_get(d: ref Val, k: ref Val) -> Option[Val] {
    match d {
        Val.Dict(ks, xs) => {
            let i = index_of(ks, k);
            if i >= 0 {
                Some(xs[i].clone())
            } else {
                None
            }
        }
        _ => None,
    }
}

fn dget(d: ref Val, k: Str) -> Option[Val] {
    dict_get(d, vs(k))
}

fn dset(d: mut ref Val, k: own Val, v: own Val) {
    match d {
        Val.Dict(ks, xs) => dict_put(mut ks, mut xs, k, v),
        _ => {}
    }
}

fn new_dict() -> Val {
    Val.Dict(Vec.new(), Vec.new())
}

fn dict_has(d: ref Val, k: Str) -> bool {
    match dget(d, k) {
        Some(_) => true,
        None => false,
    }
}

// d[k] for a str key, raising KeyError as Python does.
fn dkey(d: ref Val, k: Str) -> Result[Val, Exc] {
    match dget(d, k) {
        Some(v) => Ok(v),
        None => Err(exc("KeyError", str_repr(k.to_string()))),
    }
}

fn dict_keys(d: ref Val) -> Vec[Val] {
    match d {
        Val.Dict(ks, _) => ks.clone(),
        _ => Vec.new(),
    }
}

fn dict_vals(d: ref Val) -> Vec[Val] {
    match d {
        Val.Dict(_, xs) => xs.clone(),
        _ => Vec.new(),
    }
}

// ------------------------------------------------------------ showing values

fn show(v: ref Val) -> String {
    match v {
        Val.Non => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Big(s) => s.clone(),
        Val.Float(x) => float_repr(x),
        Val.Str(s) => str_repr(s),
        Val.Bytes(b) => bytes_repr(b),
        Val.List(xs) => f"[{show_items(xs)}]",
        Val.Tuple(xs) => {
            if xs.len() == 1 {
                f"({show(xs[0])},)"
            } else {
                f"({show_items(xs)})"
            }
        }
        Val.Set(xs) => {
            if xs.len() == 0 {
                return "set()".to_string();
            }
            let mut parts: Vec[String] = Vec.new();
            for x in xs {
                parts.push(show(x));
            }
            parts.sort();
            let mut out = "{".to_string();
            for i in 0..parts.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(parts[i]);
            }
            out.push_str("}");
            out
        }
        Val.Dict(ks, xs) => {
            let mut out = "{".to_string();
            for i in 0..ks.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(show(ks[i]));
                out.push_str(": ");
                out.push_str(show(xs[i]));
            }
            out.push_str("}");
            out
        }
        Val.Err(cls, msg) => f"{cls}({str_repr(msg)})",
        Val.Cls(name) => f"<class '{name}'>",
    }
}

fn show_items(xs: ref Vec[Val]) -> String {
    let mut out = String.new();
    for i in 0..xs.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(show(xs[i]));
    }
    out
}

// str(v) for the values safe_str() and the annotations see.
fn py_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.Err(_, msg) => msg.clone(),
        _ => show(v),
    }
}

// ------------------------------------------------------------ UTF-8

// The length of the bad sequence at b[i], and whether the data ended in
// it, the way CPython's decoder sizes an error; 0 when b[i..] starts with
// a valid character, whose length goes in the second slot.
fn utf8_step(b: ref Vec[u8], i: i64) -> (i64, i64, bool) {
    let c = b[i] as i64;
    if c < 0x80 {
        return (0, 1, false);
    }
    let mut need = 0;
    let mut lo = 0x80;
    let mut hi = 0xBF;
    if c >= 0xC2 and c <= 0xDF {
        need = 1;
    } else if c >= 0xE0 and c <= 0xEF {
        need = 2;
        if c == 0xE0 {
            lo = 0xA0;
        }
        if c == 0xED {
            hi = 0x9F;
        }
    } else if c >= 0xF0 and c <= 0xF4 {
        need = 3;
        if c == 0xF0 {
            lo = 0x90;
        }
        if c == 0xF4 {
            hi = 0x8F;
        }
    } else {
        return (1, 0, false);
    }
    let n = b.len() as i64;
    for k in 1..need + 1 {
        if i + k >= n {
            return (k, 0, true);
        }
        let d = b[i + k] as i64;
        let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xBF) };
        if d < l or d > h {
            return (k, 0, false);
        }
    }
    (0, need + 1, false)
}

fn decode_strict(b: ref Vec[u8]) -> Result[String, Exc] {
    let mut i = 0;
    let n = b.len() as i64;
    while i < n {
        let (bad, good, ended) = utf8_step(b, i);
        if bad > 0 {
            let lead = b[i] as i64;
            let why2 = if ended { "unexpected end of data" } else if lead < 0xC2 or lead > 0xF4 { "invalid start byte" } else { "invalid continuation byte" };
            let msg = if bad == 1 {
                let x = b[i] as i64;
                f"'utf-8' codec can't decode byte 0x{x:02x} in position {i}: {why2}"
            } else {
                f"'utf-8' codec can't decode bytes in position {i}-{i + bad - 1}: {why2}"
            };
            return Err(exc("UnicodeDecodeError", msg));
        }
        i += good;
    }
    match String.from_utf8(b.clone()) {
        Ok(s) => Ok(s),
        Err(_) => Ok(String.new()),
    }
}

// bytes.decode("utf-8", errors="replace").
fn decode_replace(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    let n = b.len() as i64;
    while i < n {
        let (bad, good, _) = utf8_step(b, i);
        if bad > 0 {
            out.push(0xEF);
            out.push(0xBF);
            out.push(0xBD);
            i += bad;
        } else {
            for k in 0..good {
                out.push(b[i + k]);
            }
            i += good;
        }
    }
    match String.from_utf8(out) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

// str_if_bytes().
fn str_if_bytes(v: ref Val) -> Val {
    match v {
        Val.Bytes(b) => Val.Str(decode_replace(b)),
        _ => v.clone(),
    }
}

fn text_of(v: ref Val) -> String {
    match str_if_bytes(v) {
        Val.Str(s) => s,
        other => py_str(other),
    }
}

// ------------------------------------------------------------ int() and float()

fn digit_run_ok(cs: ref Vec[char], a: i64, e: i64) -> bool {
    // digits with single underscores between them
    if a >= e {
        return false;
    }
    let mut prev_us = true;
    for i in a..e {
        let c = cs[i];
        if c == '_' {
            if prev_us {
                return false;
            }
            prev_us = true;
        } else if c >= '0' and c <= '9' {
            prev_us = false;
        } else {
            return false;
        }
    }
    not prev_us
}

fn no_us(cs: ref Vec[char], a: i64, e: i64) -> String {
    let mut out = String.new();
    for i in a..e {
        if cs[i] != '_' {
            out.push(cs[i]);
        }
    }
    out
}

// int(text): an int (a Big past 64 bits), or None where Python raises.
fn int_text(s: ref String) -> Option[Val] {
    let cs = chars_of(strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    if not digit_run_ok(cs, i, cs.len()) {
        return None;
    }
    let ds = no_us(cs, i, cs.len());
    let dc = chars_of(ds);
    let mut k = 0;
    while k + 1 < dc.len() and dc[k] == '0' {
        k += 1;
    }
    let digits = str_of(dc, k, dc.len());
    if not fits_i64(digits) {
        let sign = if neg { "-" } else { "" };
        return Some(Val.Big(f"{sign}{digits}"));
    }
    let mut n: i64 = 0;
    for c in digits.chars() {
        n = n * 10 + (c as i64 - 48);
    }
    Some(Val.Int(if neg { -n } else { n }))
}

fn fits_i64(digits: ref String) -> bool {
    if digits.len() < 19 {
        return true;
    }
    if digits.len() > 19 {
        return false;
    }
    let lim: Vec[char] = "9223372036854775807".chars().collect();
    let ds = chars_of(digits);
    for i in 0..19 {
        if ds[i] != lim[i] {
            return ds[i] < lim[i];
        }
    }
    true
}

fn word_is(s: ref String, w: Str) -> bool {
    lower(s) == w
}

// float(text), or None where Python raises.
fn float_text(s: ref String) -> Option[f64] {
    let t = strip(s);
    let cs = chars_of(t);
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let body = str_of(cs, i, cs.len());
    if word_is(body, "inf") or word_is(body, "infinity") {
        return Some(if neg { -f64.INFINITY } else { f64.INFINITY });
    }
    if word_is(body, "nan") {
        return Some(f64.NAN);
    }
    // mantissa
    let n = cs.len() as i64;
    let mut j = i;
    while j < n and cs[j] != '.' and cs[j] != 'e' and cs[j] != 'E' {
        j += 1;
    }
    let int_part_ok = j > i and digit_run_ok(cs, i, j);
    let mut frac_ok = true;
    let mut has_frac = false;
    let mut k = j;
    if k < n and cs[k] == '.' {
        k += 1;
        let f0 = k;
        while k < n and cs[k] != 'e' and cs[k] != 'E' {
            k += 1;
        }
        if k > f0 {
            has_frac = true;
            frac_ok = digit_run_ok(cs, f0, k);
        }
    }
    if not (int_part_ok or has_frac) or not frac_ok or (j > i and not int_part_ok) {
        return None;
    }
    let mut exp = String.new();
    if k < n {
        // e[sign]digits
        let mut e = k + 1;
        let mut esign = String.new();
        if e < n and (cs[e] == '+' or cs[e] == '-') {
            esign.push(cs[e]);
            e += 1;
        }
        if not digit_run_ok(cs, e, n) {
            return None;
        }
        exp = f"e{esign}{no_us(cs, e, n)}";
    }
    let mut text = if neg { "-".to_string() } else { String.new() };
    let ip = no_us(cs, i, j);
    text.push_str(if ip.len() == 0 { "0".to_string() } else { ip });
    text.push('.');
    let fp = if has_frac { no_us(cs, j + 1, k) } else { "0".to_string() };
    text.push_str(fp);
    text.push_str(exp);
    f64.parse(text).ok()
}

// The repr() Python's int() and float() errors quote: the bytes or str.
fn arg_repr(v: ref Val) -> String {
    show(v)
}

// int(v) for a reply value.
fn py_int(v: ref Val) -> Result[Val, Exc] {
    match v {
        Val.Int(_) => Ok(v.clone()),
        Val.Big(_) => Ok(v.clone()),
        Val.Bool(b) => Ok(Val.Int(if b { 1 } else { 0 })),
        Val.Float(x) => Ok(Val.Int(x as i64)),
        Val.Str(s) => match int_text(s) {
            Some(n) => Ok(n),
            None => Err(exc("ValueError", f"invalid literal for int() with base 10: {arg_repr(v)}")),
        },
        Val.Bytes(b) => match int_text(decode_replace(b)) {
            Some(n) => Ok(n),
            None => Err(exc("ValueError", f"invalid literal for int() with base 10: {arg_repr(v)}")),
        },
        Val.Non => Err(exc("TypeError", "int() argument must be a string, a bytes-like object or a real number, not 'NoneType'".to_string())),
        _ => Err(exc("TypeError", f"int() argument must be a string, a bytes-like object or a real number, not '{type_name(v)}'")),
    }
}

// float(v) for a reply value.
fn py_float(v: ref Val) -> Result[Val, Exc] {
    match v {
        Val.Float(_) => Ok(v.clone()),
        Val.Int(n) => Ok(Val.Float(n as f64)),
        Val.Bool(b) => Ok(Val.Float(if b { 1.0 } else { 0.0 })),
        Val.Big(s) => Ok(Val.Float(float_text(s).unwrap_or(0.0))),
        Val.Str(s) => match float_text(s) {
            Some(x) => Ok(Val.Float(x)),
            None => Err(exc("ValueError", f"could not convert string to float: {arg_repr(v)}")),
        },
        Val.Bytes(b) => match float_text(decode_replace(b)) {
            Some(x) => Ok(Val.Float(x)),
            None => Err(exc("ValueError", f"could not convert string to float: {arg_repr(v)}")),
        },
        _ => Err(exc("TypeError", f"float() argument must be a string or a real number, not '{type_name(v)}'")),
    }
}

// A score_cast_func: float or int.
fn cast(func: ref String, v: ref Val) -> Result[Val, Exc] {
    if func == "int" {
        py_int(v)
    } else {
        py_float(v)
    }
}

// bool(v).
fn py_bool(v: ref Val) -> Val {
    Val.Bool(truthy(v))
}

// ------------------------------------------------------------ the encoder

// Encoder.encode().
fn encode(v: ref Val) -> Result[Vec[u8], Exc] {
    match v {
        Val.Bytes(b) => Ok(b.clone()),
        Val.Bool(_) => Err(data_error("Invalid input of type: 'bool'. Convert to a bytes, string, int or float first.")),
        Val.Int(n) => Ok(bytes_of(f"{n}")),
        Val.Big(s) => Ok(bytes_of(s)),
        Val.Float(x) => Ok(bytes_of(float_repr(x))),
        Val.Str(s) => Ok(bytes_of(s)),
        _ => Err(exc("DataError", f"Invalid input of type: '{type_name(v)}'. Convert to a bytes, string, int or float first.")),
    }
}

// ------------------------------------------------------------ the scripted server

// What the server does with one command it receives: send bytes, close
// the connection, or never answer.
#[derive(Clone)]
enum Unit {
    Data(Vec[u8]),
    Close,
    Hang,
}

// A connection of the pool. The socket half is the server's end of one TCP
// connection (what it has read, what it has sent and the client has not
// read yet, whether it closed); the parser half is the client's socket
// buffer. A reconnect opens a new socket and a new buffer.
struct Conn {
    sock: bool,
    inbox: Vec[u8],
    sout: Vec[u8],
    eof: bool,
    nonblock: bool,
    has_buf: bool,
    buf: Vec[u8],
    pos: i64,
    resp3: bool,
}

fn new_conn() -> Conn {
    Conn { sock: false, inbox: Vec.new(), sout: Vec.new(), eof: false, nonblock: false, has_buf: false, buf: Vec.new(), pos: 0, resp3: false }
}

// The connection_kwargs of the pool.
struct Cfg {
    protocol: i64,
    decode: bool,
    lib_name: Val,
    lib_version: Val,
    password: Val,
    username: Val,
    db: Val,
    client_name: Val,
    retry_on_timeout: bool,
}

fn default_cfg() -> Cfg {
    Cfg { protocol: 2, decode: false, lib_name: vs("redis-py"), lib_version: vs("5.2.1"), password: Val.Non, username: Val.Non, db: Val.Non, client_name: Val.Non, retry_on_timeout: false }
}

// A Pipeline: its command stack, its WATCH and MULTI state, and the
// connection it holds while watching or executing (-1 for none).
struct Pipe {
    transaction: bool,
    explicit: bool,
    watching: bool,
    stack: Vec[Cmd],
    conn: i64,
}

fn new_pipe(transaction: bool) -> Pipe {
    Pipe { transaction: transaction, explicit: false, watching: false, stack: Vec.new(), conn: -1 }
}

struct World {
    out: Vec[String],
    units: Vec[Unit],
    next: i64,
    connects: i64,
    conns: Vec[Conn],
    avail: Vec[i64],
    in_use: Vec[i64],
    cfg: Cfg,
    pipe: Pipe,
    piping: bool,
}

fn emit(w: mut ref World, line: own String) {
    w.out.push(line);
}

fn wire(data: ref Vec[u8]) -> String {
    if data.len() > 160 {
        let h = fnv(data);
        return f"<{data.len()} bytes, fnv {h:08x}>";
    }
    bytes_repr(data)
}

fn digits_at(b: ref Vec[u8], a: i64, e: i64) -> i64 {
    let mut n = 0;
    let mut neg = false;
    for i in a..e {
        if b[i] == b'-' {
            neg = true;
        } else {
            n = n * 10 + (b[i] as i64 - 48);
        }
    }
    if neg { -n } else { n }
}

fn find_crlf(b: ref Vec[u8], from: i64) -> i64 {
    let mut i = from;
    while i + 1 < b.len() as i64 {
        if b[i] == b'\r' and b[i + 1] == b'\n' {
            return i;
        }
        i += 1;
    }
    -1
}

// How many complete RESP arrays buf holds, and the bytes they take.
fn command_count(buf: ref Vec[u8]) -> (i64, i64) {
    let mut n = 0;
    let mut pos: i64 = 0;
    let len = buf.len() as i64;
    loop {
        if pos >= len or buf[pos] != b'*' {
            return (n, pos);
        }
        let end = find_crlf(buf, pos);
        if end < 0 {
            return (n, pos);
        }
        let count = digits_at(buf, pos + 1, end);
        let mut p = end + 2;
        let mut ok = true;
        for _ in 0..count {
            let e = find_crlf(buf, p);
            if e < 0 {
                ok = false;
                break;
            }
            let size = digits_at(buf, p + 1, e);
            p = e + 2 + size + 2;
            if p > len {
                ok = false;
                break;
            }
        }
        if not ok {
            return (n, pos);
        }
        n += 1;
        pos = p;
    }
}

// socket.sendall(): the server reads what it can and answers each
// complete command with its next unit (none once it has closed).
fn sendall(w: mut ref World, ci: i64, data: ref Vec[u8]) {
    emit(mut w, f"send {wire(data)}");
    append(mut w.conns[ci].inbox, data);
    let (n, used) = command_count(w.conns[ci].inbox);
    let rest = sub(w.conns[ci].inbox, used, w.conns[ci].inbox.len() as i64);
    w.conns[ci].inbox = rest;
    for _ in 0..n {
        if w.conns[ci].eof {
            break;
        }
        let k = w.next;
        if k >= w.units.len() as i64 {
            continue;
        }
        w.next += 1;
        match w.units[k].clone() {
            Unit.Close => w.conns[ci].eof = true,
            Unit.Hang => {}
            Unit.Data(d) => append(mut w.conns[ci].sout, d),
        }
    }
}

// socket.recv(65536): Err(true) is socket.timeout, Err(false) the
// BlockingIOError a non-blocking socket raises when there is nothing yet.
fn recv(w: mut ref World, ci: i64) -> Result[Vec[u8], bool] {
    let have = w.conns[ci].sout.len() as i64;
    if have > 0 {
        let take = if have > 65536 { 65536 } else { have };
        let data = sub(w.conns[ci].sout, 0, take);
        let rest = sub(w.conns[ci].sout, take, have);
        w.conns[ci].sout = rest;
        return Ok(data);
    }
    if w.conns[ci].eof {
        return Ok(Vec.new());
    }
    if w.conns[ci].nonblock {
        return Err(false);
    }
    Err(true)
}

// ------------------------------------------------------------ the socket buffer

// SocketBuffer._read_from_socket(): reads until it has `length` more bytes
// (one recv when length < 0), appending them after what is buffered.
fn read_from_socket(w: mut ref World, ci: i64, length: i64, nonblock: bool, raise_on_timeout: bool) -> Result[bool, Exc] {
    if nonblock {
        w.conns[ci].nonblock = true;
    }
    let mut marker = 0;
    let mut result: Result[bool, Exc] = Ok(true);
    loop {
        match recv(mut w, ci) {
            Ok(data) => {
                if data.len() == 0 {
                    result = Err(conn_error(SERVER_CLOSED));
                    break;
                }
                append(mut w.conns[ci].buf, data);
                marker += data.len() as i64;
                if length >= 0 and length > marker {
                    continue;
                }
                break;
            }
            Err(is_timeout) => {
                if is_timeout {
                    result = if raise_on_timeout { Err(timeout_error()) } else { Ok(false) };
                } else {
                    result = if not raise_on_timeout { Ok(false) } else { Err(conn_error("Error while reading from socket: (11, 'Resource temporarily unavailable')")) };
                }
                break;
            }
        }
    }
    if nonblock {
        w.conns[ci].nonblock = false;
    }
    result
}

fn unread(w: ref World, ci: i64) -> i64 {
    w.conns[ci].buf.len() as i64 - w.conns[ci].pos
}

// BytesIO.read(n) on the buffer; a negative n reads everything.
fn buf_take(w: mut ref World, ci: i64, n: i64) -> Vec[u8] {
    let left = unread(w, ci);
    let k = if n < 0 or n > left { left } else { n };
    let p = w.conns[ci].pos;
    let data = sub(w.conns[ci].buf, p, p + k);
    w.conns[ci].pos = p + k;
    data
}

// BytesIO.readline() on the buffer.
fn buf_line(w: mut ref World, ci: i64) -> Vec[u8] {
    let p = w.conns[ci].pos;
    let len = w.conns[ci].buf.len() as i64;
    let mut e = p;
    while e < len and w.conns[ci].buf[e] != b'\n' {
        e += 1;
    }
    if e < len {
        e += 1;
    }
    let data = sub(w.conns[ci].buf, p, e);
    w.conns[ci].pos = e;
    data
}

fn drop2(data: ref Vec[u8]) -> Vec[u8] {
    if data.len() < 2 {
        return Vec.new();
    }
    sub(data, 0, data.len() as i64 - 2)
}

fn no_buffer(name: Str) -> Exc {
    exc("AttributeError", f"'NoneType' object has no attribute '{name}'")
}

// SocketBuffer.read(length).
fn sb_read(w: mut ref World, ci: i64, length: i64) -> Result[Vec[u8], Exc] {
    if not w.conns[ci].has_buf {
        return Err(no_buffer("read"));
    }
    let want = length + 2;
    let mut data = buf_take(mut w, ci, want);
    let missing = want - data.len() as i64;
    if missing != 0 {
        read_from_socket(mut w, ci, missing, false, true)?;
        let more = buf_take(mut w, ci, missing);
        append(mut data, more);
    }
    Ok(drop2(data))
}

fn ends_crlf(data: ref Vec[u8]) -> bool {
    let n = data.len();
    n >= 2 and data[n - 2] == b'\r' and data[n - 1] == b'\n'
}

// SocketBuffer.readline().
fn sb_readline(w: mut ref World, ci: i64) -> Result[Vec[u8], Exc] {
    if not w.conns[ci].has_buf {
        return Err(no_buffer("readline"));
    }
    let mut data = buf_line(mut w, ci);
    while not ends_crlf(data) {
        read_from_socket(mut w, ci, -1, false, true)?;
        let more = buf_line(mut w, ci);
        append(mut data, more);
    }
    Ok(drop2(data))
}

fn sb_purge(w: mut ref World, ci: i64) {
    if w.conns[ci].has_buf and unread(w, ci) == 0 {
        w.conns[ci].buf = Vec.new();
        w.conns[ci].pos = 0;
    }
}

// ------------------------------------------------------------ the parsers

// BaseParser.parse_error(): the exception class for an error reply.
fn parse_error(response: ref String) -> Exc {
    let code = split_str(response, " ")[0].clone();
    let cs = chars_of(response);
    let rest = if code.chars().count() + 1 >= cs.len() { String.new() } else { str_of(cs, code.chars().count() as i64 + 1, cs.len() as i64) };
    let cls = match code.as_str() {
        "ERR" => match rest.as_str() {
            "max number of clients reached" => "ConnectionError",
            "invalid password" => "AuthenticationError",
            "wrong number of arguments for 'auth' command" => "AuthenticationWrongNumberOfArgsError",
            "wrong number of arguments for 'AUTH' command" => "AuthenticationWrongNumberOfArgsError",
            "Error loading the extension. Please check the server logs." => "ModuleError",
            "Error unloading module: the module exports one or more module-side data types, can't unload" => "ModuleError",
            "Error unloading module: no such module with that name" => "ModuleError",
            "Error unloading module: operation not possible." => "ModuleError",
            "AUTH <password> called without any password configured for the default user. Are you sure your configuration is correct?" => "AuthenticationError",
            "Client sent AUTH, but no password is set" => "AuthenticationError",
            _ => "ResponseError",
        },
        "OOM" => "OutOfMemoryError",
        "WRONGPASS" => "AuthenticationError",
        "EXECABORT" => "ExecAbortError",
        "LOADING" => "BusyLoadingError",
        "NOSCRIPT" => "NoScriptError",
        "READONLY" => "ReadOnlyError",
        "NOAUTH" => "AuthenticationError",
        "NOPERM" => "NoPermissionError",
        _ => "",
    };
    if cls.len() == 0 {
        return exc("ResponseError", response.clone());
    }
    exc(cls, rest)
}

fn decode_val(w: ref World, v: own Val, disable: bool) -> Result[Val, Exc] {
    if w.cfg.decode and not disable {
        match v {
            Val.Bytes(b) => return Ok(Val.Str(decode_strict(b)?)),
            _ => {}
        }
    }
    Ok(v)
}

fn same_text(b: ref Vec[u8], s: Str) -> bool {
    same_bytes(b, bytes_lit(s))
}

fn reply_int(b: ref Vec[u8]) -> Result[i64, Exc] {
    match py_int(Val.Bytes(b.clone()))? {
        Val.Int(n) => Ok(n),
        _ => Ok(0),
    }
}

// _RESP2Parser._read_response().
fn read2(w: mut ref World, ci: i64, disable: bool) -> Result[Val, Exc] {
    let raw = sb_readline(mut w, ci)?;
    if raw.len() == 0 {
        return Err(conn_error(SERVER_CLOSED));
    }
    let byte = raw[0];
    let response = sub(raw, 1, raw.len() as i64);
    if byte == b'-' {
        let error = parse_error(decode_replace(response));
        if is_a(error, "ConnectionError") {
            return Err(error);
        }
        return Ok(vexc(error));
    }
    let mut v = Val.Bytes(response.clone());
    if byte == b'+' {
        // single value
    } else if byte == b':' {
        return py_int(v);
    } else if byte == b'$' and same_text(response, "-1") {
        return Ok(Val.Non);
    } else if byte == b'$' {
        let n = reply_int(response)?;
        v = Val.Bytes(sb_read(mut w, ci, n)?);
    } else if byte == b'*' and same_text(response, "-1") {
        return Ok(Val.Non);
    } else if byte == b'*' {
        let n = reply_int(response)?;
        let mut items: Vec[Val] = Vec.new();
        for _ in 0..n {
            items.push(read2(mut w, ci, disable)?);
        }
        v = Val.List(items);
    } else {
        return Err(exc("InvalidResponse", f"Protocol Error: {bytes_repr(raw)}"));
    }
    decode_val(w, v, disable)
}

fn is_invalidate(v: ref Val) -> bool {
    match v {
        Val.Bytes(b) => same_text(b, "invalidate"),
        Val.Str(s) => s == "invalidate",
        _ => false,
    }
}

// _RESP3Parser._read_response().
fn read3(w: mut ref World, ci: i64, disable: bool) -> Result[Val, Exc] {
    let raw = sb_readline(mut w, ci)?;
    if raw.len() == 0 {
        return Err(conn_error(SERVER_CLOSED));
    }
    let byte = raw[0];
    let response = sub(raw, 1, raw.len() as i64);
    if byte == b'-' or byte == b'!' {
        let mut text = response.clone();
        if byte == b'!' {
            let n = reply_int(response)?;
            text = sb_read(mut w, ci, n)?;
        }
        let error = parse_error(decode_replace(text));
        if is_a(error, "ConnectionError") {
            return Err(error);
        }
        return Ok(vexc(error));
    }
    let mut v = Val.Bytes(response.clone());
    if byte == b'+' {
        // single value
    } else if byte == b'_' {
        return Ok(Val.Non);
    } else if byte == b':' or byte == b'(' {
        return py_int(v);
    } else if byte == b',' {
        return py_float(v);
    } else if byte == b'#' {
        return Ok(Val.Bool(same_text(response, "t")));
    } else if byte == b'$' {
        let n = reply_int(response)?;
        v = Val.Bytes(sb_read(mut w, ci, n)?);
    } else if byte == b'=' {
        let n = reply_int(response)?;
        let data = sb_read(mut w, ci, n)?;
        v = Val.Bytes(if data.len() > 4 { sub(data, 4, data.len() as i64) } else { Vec.new() });
    } else if byte == b'*' or byte == b'~' {
        let n = reply_int(response)?;
        let mut items: Vec[Val] = Vec.new();
        for _ in 0..n {
            items.push(read3(mut w, ci, disable)?);
        }
        v = Val.List(items);
    } else if byte == b'%' {
        let n = reply_int(response)?;
        let mut ks: Vec[Val] = Vec.new();
        let mut xs: Vec[Val] = Vec.new();
        for _ in 0..n {
            let k = read3(mut w, ci, disable)?;
            let x = read3(mut w, ci, disable)?;
            dict_put(mut ks, mut xs, k, x);
        }
        v = Val.Dict(ks, xs);
    } else if byte == b'>' {
        let n = reply_int(response)?;
        let mut items: Vec[Val] = Vec.new();
        for _ in 0..n {
            items.push(read3(mut w, ci, disable)?);
        }
        // The push handler logs a pub/sub message and drops an
        // invalidation; either way the reply is the next response.
        let _ = is_invalidate(at(Val.List(items), 0));
        return read3(mut w, ci, disable);
    } else {
        return Err(exc("InvalidResponse", f"Protocol Error: {bytes_repr(raw)}"));
    }
    match v {
        Val.Bytes(_) => decode_val(w, v, disable),
        _ => Ok(v),
    }
}

// The parser's read_response(): rewinds the buffer on an error, purges it
// after a whole reply.
fn parser_read(w: mut ref World, ci: i64, disable: bool) -> Result[Val, Exc] {
    let pos = w.conns[ci].pos;
    let r = if w.conns[ci].resp3 { read3(mut w, ci, disable) } else { read2(mut w, ci, disable) };
    match r {
        Ok(v) => {
            sb_purge(mut w, ci);
            Ok(v)
        }
        Err(e) => {
            if w.conns[ci].has_buf {
                w.conns[ci].pos = pos;
            }
            Err(e)
        }
    }
}

// ------------------------------------------------------------ the connection

fn disconnect(w: mut ref World, ci: i64) {
    w.conns[ci].has_buf = false;
    w.conns[ci].buf = Vec.new();
    w.conns[ci].pos = 0;
    if not w.conns[ci].sock {
        return;
    }
    w.conns[ci].sock = false;
    emit(mut w, "close".to_string());
}

fn connect(w: mut ref World, ci: i64) -> Result[(), Exc] {
    if w.conns[ci].sock {
        return Ok(());
    }
    w.connects += 1;
    let n = w.connects;
    emit(mut w, f"connect #{n}");
    w.conns[ci].sock = true;
    w.conns[ci].inbox = Vec.new();
    w.conns[ci].sout = Vec.new();
    w.conns[ci].eof = false;
    w.conns[ci].nonblock = false;
    match on_connect(mut w, ci) {
        Ok(_) => Ok(()),
        Err(e) => {
            if is_a(e, "RedisError") {
                disconnect(mut w, ci);
            }
            Err(e)
        }
    }
}

fn is_ok_reply(v: ref Val) -> bool {
    match str_if_bytes(v) {
        Val.Str(s) => s == "OK",
        _ => false,
    }
}

// Sends a handshake command and reads its reply; a ResponseError is
// swallowed when `quiet` (CLIENT SETINFO).
fn hs_command(w: mut ref World, ci: i64, args: own Vec[Val], quiet: bool) -> Result[Val, Exc] {
    let r = match send_command(mut w, ci, args) {
        Ok(_) => read_response(mut w, ci, false),
        Err(e) => Err(e),
    };
    match r {
        Ok(v) => Ok(v),
        Err(e) => {
            if quiet and is_a(e, "ResponseError") {
                Ok(Val.Non)
            } else {
                Err(e)
            }
        }
    }
}

// Connection.on_connect(): AUTH or HELLO, CLIENT SETNAME, CLIENT SETINFO
// and SELECT.
fn on_connect(w: mut ref World, ci: i64) -> Result[(), Exc] {
    w.conns[ci].has_buf = true;
    w.conns[ci].buf = Vec.new();
    w.conns[ci].pos = 0;
    let proto = w.cfg.protocol;
    w.conns[ci].resp3 = proto == 3;
    let mut auth: Vec[Val] = Vec.new();
    if truthy(w.cfg.username) or truthy(w.cfg.password) {
        let user = if truthy(w.cfg.username) { w.cfg.username.clone() } else { vs("") };
        let pass = if truthy(w.cfg.password) { w.cfg.password.clone() } else { vs("") };
        if truthy(user) {
            auth.push(user);
        }
        auth.push(pass);
    }
    if auth.len() > 0 and proto != 2 {
        if auth.len() == 1 {
            auth.insert(0, vs("default"));
        }
        let mut args = vec![vs("HELLO"), Val.Int(proto), vs("AUTH")];
        for a in auth {
            args.push(a.clone());
        }
        hs_command(mut w, ci, args, false)?;
    } else if auth.len() > 0 {
        let mut args = vec![vs("AUTH")];
        for a in auth {
            args.push(a.clone());
        }
        let reply = match hs_command(mut w, ci, args, false) {
            Ok(v) => v,
            Err(e) => {
                if e.cls == "AuthenticationWrongNumberOfArgsError" {
                    let last = auth[auth.len() - 1].clone();
                    hs_command(mut w, ci, vec![vs("AUTH"), last], false)?
                } else {
                    return Err(e);
                }
            }
        };
        if not is_ok_reply(reply) {
            return Err(exc("AuthenticationError", "Invalid Username or Password".to_string()));
        }
    } else if proto != 2 {
        let meta = hs_command(mut w, ci, vec![vs("HELLO"), Val.Int(proto)], false)?;
        if not is_dict(meta) {
            return Err(exc("AttributeError", f"'{type_name(meta)}' object has no attribute 'get'"));
        }
        let want = Val.Int(proto);
        let a = dict_get(meta, vb("proto")).unwrap_or(Val.Non);
        let b = dict_get(meta, vs("proto")).unwrap_or(Val.Non);
        if not py_eq(a, want) and not py_eq(b, want) {
            return Err(conn_error("Invalid RESP version"));
        }
    }
    if truthy(w.cfg.client_name) {
        let name = w.cfg.client_name.clone();
        let r = hs_command(mut w, ci, vec![vs("CLIENT"), vs("SETNAME"), name], false)?;
        if not is_ok_reply(r) {
            return Err(conn_error("Error setting client name"));
        }
    }
    if truthy(w.cfg.lib_name) {
        let name = w.cfg.lib_name.clone();
        hs_command(mut w, ci, vec![vs("CLIENT"), vs("SETINFO"), vs("LIB-NAME"), name], true)?;
    }
    if truthy(w.cfg.lib_version) {
        let ver = w.cfg.lib_version.clone();
        hs_command(mut w, ci, vec![vs("CLIENT"), vs("SETINFO"), vs("LIB-VER"), ver], true)?;
    }
    if truthy(w.cfg.db) {
        let db = w.cfg.db.clone();
        let r = hs_command(mut w, ci, vec![vs("SELECT"), db], false)?;
        if not is_ok_reply(r) {
            return Err(conn_error("Invalid Database"));
        }
    }
    Ok(())
}

const CUTOFF: i64 = 6000;

fn crlf() -> Vec[u8] {
    bytes_lit("\r\n")
}

// PythonRespSerializer.pack(): the chunks one command is sent in.
fn pack(args: ref Vec[Val]) -> Result[Vec[Vec[u8]], Exc] {
    let mut items: Vec[Val] = Vec.new();
    match args[0].clone() {
        Val.Str(s) => {
            for part in split_bytes_ws(bytes_of(s)) {
                items.push(Val.Bytes(part.clone()));
            }
        }
        Val.Bytes(b) => {
            if has_byte(b, b' ') {
                for part in split_bytes_ws(b) {
                    items.push(Val.Bytes(part.clone()));
                }
            } else {
                items.push(Val.Bytes(b));
            }
        }
        other => items.push(other),
    }
    for i in 1..args.len() {
        items.push(args[i].clone());
    }
    let mut output: Vec[Vec[u8]] = Vec.new();
    let mut buff: Vec[u8] = Vec.new();
    push_text(mut buff, f"*{items.len()}\r\n");
    for it in items {
        let arg = encode(it)?;
        let n = arg.len() as i64;
        if buff.len() as i64 > CUTOFF or n > CUTOFF {
            push_text(mut buff, f"${n}\r\n");
            output.push(buff.clone());
            output.push(arg);
            buff = crlf();
        } else {
            push_text(mut buff, f"${n}\r\n");
            append(mut buff, arg);
            append(mut buff, crlf());
        }
    }
    output.push(buff);
    Ok(output)
}

// Connection.pack_commands(): several commands, in as few writes as the
// cutoff allows.
fn pack_commands(cmds: ref Vec[Vec[Val]]) -> Result[Vec[Vec[u8]], Exc] {
    let mut output: Vec[Vec[u8]] = Vec.new();
    let mut pieces: Vec[u8] = Vec.new();
    let mut have = false;
    let mut buffer_length = 0;
    for cmd in cmds {
        for chunk in pack(cmd)? {
            let n = chunk.len() as i64;
            if buffer_length > CUTOFF or n > CUTOFF {
                if have {
                    output.push(pieces.clone());
                }
                buffer_length = 0;
                pieces = Vec.new();
                have = false;
            }
            if n > CUTOFF {
                output.push(chunk.clone());
            } else {
                append(mut pieces, chunk);
                have = true;
                buffer_length += n;
            }
        }
    }
    if have {
        output.push(pieces);
    }
    Ok(output)
}

fn send_packed(w: mut ref World, ci: i64, chunks: ref Vec[Vec[u8]]) -> Result[(), Exc] {
    if not w.conns[ci].sock {
        connect(mut w, ci)?;
    }
    for c in chunks {
        sendall(mut w, ci, c);
    }
    Ok(())
}

fn send_command(w: mut ref World, ci: i64, args: ref Vec[Val]) -> Result[(), Exc] {
    let chunks = pack(args)?;
    send_packed(mut w, ci, chunks)
}

// Connection.read_response(): disconnects on any error, raises an error
// reply.
fn read_response(w: mut ref World, ci: i64, disable: bool) -> Result[Val, Exc] {
    match parser_read(mut w, ci, disable) {
        Ok(v) => match v {
            Val.Err(cls, msg) => Err(Exc { cls: cls, msg: msg }),
            other => Ok(other),
        },
        Err(e) => {
            disconnect(mut w, ci);
            Err(e)
        }
    }
}

fn can_read(w: mut ref World, ci: i64) -> Result[bool, Exc] {
    if not w.conns[ci].sock {
        connect(mut w, ci)?;
    }
    if not w.conns[ci].has_buf {
        return Ok(false);
    }
    if unread(w, ci) > 0 {
        return Ok(true);
    }
    read_from_socket(mut w, ci, -1, true, false)
}

// ------------------------------------------------------------ the pool

fn ready(w: mut ref World, ci: i64) -> Result[(), Exc] {
    connect(mut w, ci)?;
    let problem = match can_read(mut w, ci) {
        Ok(true) => true,
        Ok(false) => false,
        Err(e) => {
            if not is_a(e, "ConnectionError") {
                return Err(e);
            }
            true
        }
    };
    if problem {
        disconnect(mut w, ci);
        connect(mut w, ci)?;
        if can_read(mut w, ci)? {
            return Err(conn_error("Connection not ready"));
        }
    }
    Ok(())
}

fn get_connection(w: mut ref World) -> Result[i64, Exc] {
    let ci = match w.avail.pop() {
        Some(c) => c,
        None => {
            w.conns.push(new_conn());
            w.conns.len() as i64 - 1
        }
    };
    w.in_use.push(ci);
    match ready(mut w, ci) {
        Ok(_) => Ok(ci),
        Err(e) => {
            release(mut w, ci);
            Err(e)
        }
    }
}

fn release(w: mut ref World, ci: i64) {
    let mut keep: Vec[i64] = Vec.new();
    for c in w.in_use {
        if c != ci {
            keep.push(c);
        }
    }
    w.in_use = keep;
    w.avail.push(ci);
}

fn pool_disconnect(w: mut ref World) {
    let mut all: Vec[i64] = w.avail.clone();
    for c in w.in_use {
        all.push(c);
    }
    for c in all {
        disconnect(mut w, c);
    }
}

// ------------------------------------------------------------ commands

// The options a command method passes to execute_command(): the ones the
// reply callbacks read, plus EMPTY_RESPONSE and NEVER_DECODE.
#[derive(Clone)]
struct Opts {
    get: bool,
    groups: i64,
    withscores: bool,
    score_cast: String,
    no_values: bool,
    full: bool,
    parse_justid: bool,
    parse_detail: bool,
    as_score: bool,
    never_decode: bool,
    empty_response: bool,
    len: bool,
    idx: bool,
    withmatchlen: bool,
    geo: bool,
    store: bool,
    store_dist: bool,
    withdist: bool,
    withcoord: bool,
    withhash: bool,
}

fn no_opts() -> Opts {
    Opts { get: false, groups: 0, withscores: false, score_cast: "float".to_string(), no_values: false, full: false, parse_justid: false, parse_detail: false, as_score: false, never_decode: false, empty_response: false, len: false, idx: false, withmatchlen: false, geo: false, store: false, store_dist: false, withdist: false, withcoord: false, withhash: false }
}

#[derive(Clone)]
struct Cmd {
    args: Vec[Val],
    opts: Opts,
}

// ------------------------------------------------------------ the callback tables

fn one_of(n: ref String, names: Str) -> bool {
    for x in split_str(names.to_string(), "|") {
        if x == *n {
            return true;
        }
    }
    false
}

// The callback of a command name: _RedisCallbacks with the RESP2 or RESP3
// table over it, as Redis.__init__ builds response_callbacks.
fn cb_id(n: ref String, p3: bool) -> String {
    let id = if p3 { cb_resp3(n) } else { cb_resp2(n) };
    if id.len() > 0 {
        return id;
    }
    cb_base(n)
}

fn cb_resp3(n: ref String) -> String {
    let id = if one_of(n, "SDIFF|SINTER|SMEMBERS|SUNION") {
        "set"
    } else if one_of(n, "ZRANGE|ZINTER|ZPOPMAX|ZPOPMIN|ZRANGEBYSCORE|ZREVRANGE|ZREVRANGEBYSCORE|ZUNION|HGETALL") {
        "same"
    } else if one_of(n, "XREAD|XREADGROUP") {
        "xread3"
    } else if *n == "ACL LOG" {
        "acl_log3"
    } else if *n == "COMMAND" {
        "command3"
    } else if *n == "CONFIG GET" {
        "config_get3"
    } else if *n == "MEMORY STATS" {
        "memory_stats3"
    } else if *n == "SENTINEL MASTER" {
        "sentinel_state3"
    } else if *n == "SENTINEL MASTERS" {
        "sentinel_masters3"
    } else if one_of(n, "SENTINEL SENTINELS|SENTINEL SLAVES") {
        "sentinel_slaves3"
    } else if *n == "STRALGO" {
        "stralgo3"
    } else if one_of(n, "XINFO CONSUMERS|XINFO GROUPS") {
        "str_keys3"
    } else {
        ""
    };
    id.to_string()
}

fn cb_resp2(n: ref String) -> String {
    let id = if one_of(n, "SDIFF|SINTER|SMEMBERS|SUNION") {
        "set"
    } else if one_of(n, "ZDIFF|ZINTER|ZPOPMAX|ZPOPMIN|ZRANGE|ZRANGEBYSCORE|ZRANK|ZREVRANGE|ZREVRANGEBYSCORE|ZREVRANK|ZUNION") {
        "zset_score_pairs"
    } else if one_of(n, "ZINCRBY|ZSCORE") {
        "float_or_none"
    } else if one_of(n, "BGREWRITEAOF|BGSAVE") {
        "true"
    } else if one_of(n, "BLPOP|BRPOP") {
        "tuple_or_none"
    } else if one_of(n, "BZPOPMAX|BZPOPMIN") {
        "bzpop"
    } else if one_of(n, "ACL CAT|ACL HELP|ACL LIST|ACL USERS|CLIENT TRACKINGINFO|CLUSTER GETKEYSINSLOT|COMMAND GETKEYS|GEOHASH") {
        "str_list"
    } else if one_of(n, "ACL GENPASS|ACL WHOAMI|CLIENT GETNAME|RESET") {
        "str_if_bytes"
    } else if *n == "CONFIG GET" {
        "config_get"
    } else if *n == "DEBUG OBJECT" {
        "debug_object"
    } else if *n == "GEOPOS" {
        "geopos"
    } else if *n == "HGETALL" {
        "hgetall"
    } else if *n == "MEMORY STATS" {
        "memory_stats"
    } else if *n == "MODULE LIST" {
        "module_list"
    } else if *n == "SENTINEL MASTER" {
        "sentinel_master"
    } else if *n == "SENTINEL MASTERS" {
        "sentinel_masters"
    } else if one_of(n, "SENTINEL SENTINELS|SENTINEL SLAVES") {
        "sentinel_slaves"
    } else if *n == "STRALGO" {
        "stralgo"
    } else if one_of(n, "XINFO CONSUMERS|XINFO GROUPS") {
        "list_of_dicts"
    } else if *n == "ZADD" {
        "zadd"
    } else if *n == "ZMSCORE" {
        "zmscore"
    } else {
        ""
    };
    id.to_string()
}

fn cb_base(n: ref String) -> String {
    let id = if one_of(n, "AUTH|COPY|EXPIRE|EXPIREAT|HEXISTS|HMSET|MOVE|MSETNX|PERSIST|PSETEX|PEXPIRE|PEXPIREAT|RENAMENX|SETEX|SETNX|SMOVE|CLIENT UNBLOCK|MODULE LOAD|MODULE UNLOAD|XGROUP DESTROY") {
        "bool"
    } else if one_of(n, "HINCRBYFLOAT|INCRBYFLOAT") {
        "float"
    } else if one_of(n, "ASKING|FLUSHALL|FLUSHDB|LSET|LTRIM|MSET|PFMERGE|READONLY|READWRITE|RENAME|SAVE|SELECT|SHUTDOWN|SLAVEOF|SWAPDB|WATCH|UNWATCH") {
        "bool_ok"
    } else if one_of(n, "ACL LOAD|ACL SETUSER|ACL SAVE|CLIENT PAUSE|CLIENT SETINFO|CLIENT SETNAME|CONFIG RESETSTAT|CONFIG SET|FUNCTION DELETE|FUNCTION FLUSH|FUNCTION RESTORE|MEMORY PURGE|QUIT|SCRIPT FLUSH|SCRIPT KILL|SENTINEL CKQUORUM|SENTINEL FAILOVER|SENTINEL FLUSHCONFIG|SENTINEL MONITOR|SENTINEL RESET|SENTINEL REMOVE|SENTINEL SET|SLOWLOG RESET|XGROUP CREATE|XGROUP SETID") {
        "bool_ok"
    } else if one_of(n, "CLUSTER ADDSLOTS|CLUSTER ADDSLOTSRANGE|CLUSTER DELSLOTS|CLUSTER DELSLOTSRANGE|CLUSTER FAILOVER|CLUSTER FORGET|CLUSTER MEET|CLUSTER REPLICATE|CLUSTER RESET|CLUSTER SAVECONFIG|CLUSTER SET-CONFIG-EPOCH|CLUSTER SETSLOT") {
        "bool_ok"
    } else if one_of(n, "XREAD|XREADGROUP") {
        "xread"
    } else if one_of(n, "GEORADIUS|GEORADIUSBYMEMBER|GEOSEARCH") {
        "geosearch"
    } else if one_of(n, "XRANGE|XREVRANGE") {
        "stream_list"
    } else if *n == "ACL GETUSER" {
        "acl_getuser"
    } else if *n == "ACL LOG" {
        "acl_log"
    } else if *n == "CLIENT INFO" {
        "client_info"
    } else if *n == "CLIENT KILL" {
        "client_kill"
    } else if *n == "CLIENT LIST" {
        "client_list"
    } else if *n == "CLUSTER INFO" {
        "cluster_info"
    } else if one_of(n, "CLUSTER NODES|CLUSTER REPLICAS|CLUSTER SLAVES") {
        "cluster_nodes"
    } else if *n == "COMMAND" {
        "command"
    } else if *n == "GEODIST" {
        "float_or_none"
    } else if *n == "HSCAN" {
        "hscan"
    } else if *n == "INFO" {
        "info"
    } else if *n == "PING" {
        "ping"
    } else if one_of(n, "PUBSUB NUMSUB|PUBSUB SHARDNUMSUB") {
        "pubsub_numsub"
    } else if *n == "SET" {
        "set_result"
    } else if one_of(n, "SCAN|SSCAN") {
        "scan"
    } else if *n == "SCRIPT EXISTS" {
        "bool_list"
    } else if *n == "SCRIPT LOAD" {
        "str_if_bytes"
    } else if *n == "SENTINEL GET-MASTER-ADDR-BY-NAME" {
        "sentinel_get_master"
    } else if *n == "SLOWLOG GET" {
        "slowlog_get"
    } else if *n == "SORT" {
        "sort"
    } else if *n == "TIME" {
        "time"
    } else if *n == "XAUTOCLAIM" {
        "xautoclaim"
    } else if *n == "XCLAIM" {
        "xclaim"
    } else if *n == "XINFO STREAM" {
        "xinfo_stream"
    } else if *n == "XPENDING" {
        "xpending"
    } else if *n == "ZSCAN" {
        "zscan"
    } else {
        ""
    };
    id.to_string()
}

// Redis.parse_response()'s last step: the callback for args[0], looked up
// case-insensitively (a bytes name never matches).
fn run_callback(w: ref World, name: ref Val, r: own Val, o: ref Opts) -> Result[Val, Exc] {
    let n = match name {
        Val.Str(s) => upper(s),
        _ => return Ok(r),
    };
    let id = cb_id(n, w.cfg.protocol == 3);
    if id.len() == 0 {
        return Ok(r);
    }
    apply_cb(w, id, r, o)
}

fn not_subscriptable(v: ref Val) -> Exc {
    exc("TypeError", f"'{type_name(v)}' object is not subscriptable")
}

// r[i] for a list or tuple, with Python's errors.
fn idx(v: ref Val, i: i64) -> Result[Val, Exc] {
    match v {
        Val.List(xs) => {
            let j = if i < 0 { xs.len() as i64 + i } else { i };
            if j < 0 or j >= xs.len() as i64 {
                return Err(exc("IndexError", "list index out of range".to_string()));
            }
            Ok(xs[j].clone())
        }
        Val.Tuple(xs) => {
            let j = if i < 0 { xs.len() as i64 + i } else { i };
            if j < 0 or j >= xs.len() as i64 {
                return Err(exc("IndexError", "tuple index out of range".to_string()));
            }
            Ok(xs[j].clone())
        }
        _ => Err(not_subscriptable(v)),
    }
}

fn not_iterable(v: ref Val) -> Exc {
    exc("TypeError", f"'{type_name(v)}' object is not iterable")
}

// iter(v) for the values callbacks walk.
fn iter_of(v: ref Val) -> Result[Vec[Val], Exc] {
    match v {
        Val.List(xs) => Ok(xs.clone()),
        Val.Tuple(xs) => Ok(xs.clone()),
        Val.Set(xs) => Ok(xs.clone()),
        Val.Dict(ks, _) => Ok(ks.clone()),
        Val.Bytes(b) => {
            let mut out: Vec[Val] = Vec.new();
            for x in b {
                out.push(Val.Int(x as i64));
            }
            Ok(out)
        }
        Val.Str(s) => {
            let mut out: Vec[Val] = Vec.new();
            for c in s.chars() {
                let mut t = String.new();
                t.push(c);
                out.push(Val.Str(t));
            }
            Ok(out)
        }
        _ => Err(not_iterable(v)),
    }
}

// a, b = v
fn unpack2(v: ref Val) -> Result[(Val, Val), Exc] {
    let xs = iter_of(v)?;
    if xs.len() > 2 {
        return Err(exc("ValueError", "too many values to unpack (expected 2)".to_string()));
    }
    if xs.len() < 2 {
        return Err(exc("ValueError", f"not enough values to unpack (expected 2, got {xs.len()})"));
    }
    Ok((xs[0].clone(), xs[1].clone()))
}

// pairs_to_dict(response, decode_keys, decode_string_values).
fn pairs_to_dict(r: ref Val, decode_keys: bool, decode_values: bool) -> Result[Val, Exc] {
    if is_none(r) {
        return Ok(new_dict());
    }
    let xs = iter_of(r)?;
    let mut ks: Vec[Val] = Vec.new();
    let mut vals: Vec[Val] = Vec.new();
    let mut i = 0;
    while i + 1 < xs.len() {
        let k = if decode_keys { str_if_bytes(xs[i]) } else { xs[i].clone() };
        let x = if decode_values { str_if_bytes(xs[i + 1]) } else { xs[i + 1].clone() };
        dict_put(mut ks, mut vals, k, x);
        i += 2;
    }
    Ok(Val.Dict(ks, vals))
}

fn str_keys(d: ref Val) -> Result[Val, Exc] {
    if not is_dict(d) {
        return Err(exc("AttributeError", f"'{type_name(d)}' object has no attribute 'items'"));
    }
    let mut out = new_dict();
    let ks = dict_keys(d);
    let xs = dict_vals(d);
    for i in 0..ks.len() {
        dset(mut out, str_if_bytes(ks[i]), xs[i].clone());
    }
    Ok(out)
}

fn str_list(r: ref Val) -> Result[Val, Exc] {
    let mut out: Vec[Val] = Vec.new();
    for x in iter_of(r)? {
        out.push(str_if_bytes(x));
    }
    Ok(Val.List(out))
}

fn text_eq(v: ref Val, s: Str) -> bool {
    match str_if_bytes(v) {
        Val.Str(t) => t == s,
        _ => false,
    }
}

fn bool_ok(r: ref Val) -> Val {
    Val.Bool(text_eq(r, "OK"))
}

fn float_or_none(r: ref Val) -> Result[Val, Exc] {
    if is_none(r) {
        return Ok(Val.Non);
    }
    py_float(r)
}

// parse_stream_list().
fn stream_list(r: ref Val) -> Result[Val, Exc] {
    if is_none(r) {
        return Ok(Val.Non);
    }
    let mut data: Vec[Val] = Vec.new();
    for x in iter_of(r)? {
        if is_none(x) {
            data.push(Val.Tuple(vec![Val.Non, Val.Non]));
        } else {
            data.push(Val.Tuple(vec![idx(x, 0)?, pairs_to_dict(idx(x, 1)?, false, false)?]));
        }
    }
    Ok(Val.List(data))
}

// The values of zip(it, map(cast, it)) over a flat reply.
fn score_pairs(r: ref Val, func: ref String) -> Result[Val, Exc] {
    let xs = iter_of(r)?;
    let mut out: Vec[Val] = Vec.new();
    let mut i = 0;
    while i + 1 < xs.len() {
        out.push(Val.Tuple(vec![xs[i].clone(), cast(func, xs[i + 1])?]));
        i += 2;
    }
    Ok(Val.List(out))
}

// parse_info()'s get_value().
fn info_value(value: ref String) -> Val {
    if not value.contains(",") and not value.contains("=") {
        if value.contains(".") {
            match float_text(value) {
                Some(x) => return Val.Float(x),
                None => return vstr(value),
            }
        }
        match int_text(value) {
            Some(n) => return n,
            None => return vstr(value),
        }
    } else if not value.contains("=") {
        let mut out: Vec[Val] = Vec.new();
        for v in split_str(value, ",") {
            if v.len() > 0 {
                out.push(info_value(v));
            }
        }
        return Val.List(out);
    }
    let mut d = new_dict();
    for item in split_str(value, ",") {
        if item.len() == 0 {
            continue;
        }
        if item.contains("=") {
            let kv = rsplit_once(item, "=");
            dset(mut d, vstr(kv[0]), info_value(kv[1]));
        } else {
            dset(mut d, vstr(item), Val.Bool(true));
        }
    }
    d
}

fn parse_info(r: ref Val) -> Result[Val, Exc] {
    let text = match str_if_bytes(r) {
        Val.Str(s) => s,
        other => return Err(exc("AttributeError", f"'{type_name(other)}' object has no attribute 'splitlines'")),
    };
    let mut info = new_dict();
    for line in splitlines(text) {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        if line.contains(":") {
            let mut kv = split_once(line, ":");
            if kv[0] == "cmdstat_host" {
                kv = rsplit_once(line, ":");
            }
            if kv[0] == "module" {
                let mut mods = dget(info, "modules").unwrap_or(Val.List(Vec.new()));
                match mods {
                    Val.List(xs) => {
                        let mut ys = xs.clone();
                        ys.push(info_value(kv[1]));
                        mods = Val.List(ys);
                    }
                    _ => {}
                }
                dset(mut info, vs("modules"), mods);
            } else {
                dset(mut info, vstr(kv[0]), info_value(kv[1]));
            }
        } else {
            let mut raw = dget(info, "__raw__").unwrap_or(Val.List(Vec.new()));
            match raw {
                Val.List(xs) => {
                    let mut ys = xs.clone();
                    ys.push(vstr(line));
                    raw = Val.List(ys);
                }
                _ => {}
            }
            dset(mut info, vs("__raw__"), raw);
        }
    }
    Ok(info)
}

fn seq_error(i: i64, n: i64) -> Exc {
    exc("ValueError", f"dictionary update sequence element #{i} has length {n}; 2 is required")
}

// dict(pairs) where each element is a list of two strings.
fn dict_from_splits(parts: ref Vec[Vec[String]]) -> Result[Val, Exc] {
    let mut d = new_dict();
    for i in 0..parts.len() {
        if parts[i].len() != 2 {
            return Err(seq_error(i as i64, parts[i].len() as i64));
        }
        dset(mut d, vstr(parts[i][0]), vstr(parts[i][1]));
    }
    Ok(d)
}

fn text_or_err(v: ref Val, method: Str) -> Result[String, Exc] {
    match str_if_bytes(v) {
        Val.Str(s) => Ok(s),
        other => Err(exc("AttributeError", f"'{type_name(other)}' object has no attribute '{method}'")),
    }
}

fn parse_debug_object(r: ref Val) -> Result[Val, Exc] {
    let body = text_or_err(r, "split")?;
    let text = f"type:{body}";
    let mut parts: Vec[Vec[String]] = Vec.new();
    for kv in split_ws(text) {
        parts.push(split_str(kv, ":"));
    }
    let mut d = dict_from_splits(parts)?;
    for field in ["refcount", "serializedlength", "lru", "lru_seconds_idle"] {
        match dget(d, field) {
            Some(v) => {
                let n = py_int(v)?;
                dset(mut d, vs(field), n);
            }
            None => {}
        }
    }
    Ok(d)
}

fn parse_client_list(r: ref Val) -> Result[Val, Exc] {
    let text = text_or_err(r, "splitlines")?;
    let mut clients: Vec[Val] = Vec.new();
    for c in splitlines(text) {
        let mut parts: Vec[Vec[String]] = Vec.new();
        for pair in split_str(c, " ") {
            parts.push(split_once(pair, "="));
        }
        clients.push(dict_from_splits(parts)?);
    }
    Ok(Val.List(clients))
}

const CLIENT_INT_KEYS: Str = "id|age|idle|db|sub|psub|multi|qbuf|qbuf-free|obl|argv-mem|oll|omem|tot-mem";

fn parse_client_info(r: ref Val) -> Result[Val, Exc] {
    let text = text_or_err(r, "strip")?;
    let mut d = new_dict();
    for info in split_ws(strip(text)) {
        let kv = split_str(info, "=");
        if kv.len() > 2 {
            return Err(exc("ValueError", "too many values to unpack (expected 2)".to_string()));
        }
        if kv.len() < 2 {
            return Err(exc("ValueError", "not enough values to unpack (expected 2, got 1)".to_string()));
        }
        dset(mut d, vstr(kv[0]), vstr(kv[1]));
    }
    for k in split_str(CLIENT_INT_KEYS.to_string(), "|") {
        let v = dkey(d, k.as_str())?;
        let n = py_int(v)?;
        dset(mut d, vstr(k), n);
    }
    Ok(d)
}

fn parse_config_get(r: ref Val) -> Result[Val, Exc] {
    let mut xs: Vec[Val] = Vec.new();
    for x in iter_of(r)? {
        xs.push(if is_none(x) { Val.Non } else { str_if_bytes(x) });
    }
    if xs.len() == 0 {
        return Ok(new_dict());
    }
    pairs_to_dict(Val.List(xs), false, false)
}

fn parse_hscan(r: ref Val, o: ref Opts) -> Result[Val, Exc] {
    let (cursor, items) = unpack2(r)?;
    let payload = if o.no_values {
        if truthy(items) { items.clone() } else { Val.List(Vec.new()) }
    } else if truthy(items) {
        pairs_to_dict(items, false, false)?
    } else {
        new_dict()
    };
    Ok(Val.Tuple(vec![py_int(cursor)?, payload]))
}

fn parse_scan(r: ref Val) -> Result[Val, Exc] {
    let (cursor, items) = unpack2(r)?;
    Ok(Val.Tuple(vec![py_int(cursor)?, items]))
}

fn parse_zscan(r: ref Val, o: ref Opts) -> Result[Val, Exc] {
    let (cursor, items) = unpack2(r)?;
    Ok(Val.Tuple(vec![py_int(cursor)?, score_pairs(items, o.score_cast)?]))
}

fn join_bytes(items: ref Val, sep: u8) -> Result[Val, Exc] {
    let mut out: Vec[u8] = Vec.new();
    let xs = iter_of(items)?;
    for i in 0..xs.len() {
        if i > 0 {
            out.push(sep);
        }
        match xs[i].clone() {
            Val.Bytes(b) => append(mut out, b),
            other => return Err(exc("TypeError", f"sequence item {i}: expected a bytes-like object, {type_name(other)} found")),
        }
    }
    Ok(Val.Bytes(out))
}

fn parse_slowlog_get(r: ref Val) -> Result[Val, Exc] {
    let mut out: Vec[Val] = Vec.new();
    for item in iter_of(r)? {
        let mut d = new_dict();
        dset(mut d, vs("id"), idx(item, 0)?);
        dset(mut d, vs("start_time"), py_int(idx(item, 1)?)?);
        dset(mut d, vs("duration"), py_int(idx(item, 2)?)?);
        let n = len_of(item);
        if is_list(idx(item, 3)?) {
            dset(mut d, vs("command"), join_bytes(idx(item, 3)?, b' ')?);
            if n >= 6 {
                dset(mut d, vs("client_address"), idx(item, 4)?);
                dset(mut d, vs("client_name"), idx(item, 5)?);
            }
        } else {
            dset(mut d, vs("complexity"), idx(item, 3)?);
            dset(mut d, vs("command"), join_bytes(idx(item, 4)?, b' ')?);
            if n >= 7 {
                dset(mut d, vs("client_address"), idx(item, 5)?);
                dset(mut d, vs("client_name"), idx(item, 6)?);
            }
        }
        out.push(d);
    }
    Ok(Val.List(out))
}

fn tuple_of(v: ref Val) -> Result[Val, Exc] {
    Ok(Val.Tuple(iter_of(v)?))
}

fn parse_stralgo(r: ref Val, o: ref Opts) -> Result[Val, Exc] {
    if o.len {
        return py_int(r);
    }
    if o.idx {
        let mut matches: Vec[Val] = Vec.new();
        for m in iter_of(idx(r, 1)?)? {
            let parts = iter_of(m)?;
            let mut row: Vec[Val] = Vec.new();
            if o.withmatchlen {
                row.push(py_int(idx(m, -1)?)?);
                for k in 0..parts.len() - 1 {
                    row.push(tuple_of(parts[k])?);
                }
            } else {
                for p in parts {
                    row.push(tuple_of(p)?);
                }
            }
            matches.push(Val.List(row));
        }
        let mut d = new_dict();
        dset(mut d, str_if_bytes(idx(r, 0)?), Val.List(matches));
        dset(mut d, str_if_bytes(idx(r, 2)?), py_int(idx(r, 3)?)?);
        return Ok(d);
    }
    Ok(str_if_bytes(r))
}

fn parse_cluster_info(r: ref Val) -> Result[Val, Exc] {
    let text = text_or_err(r, "splitlines")?;
    let mut parts: Vec[Vec[String]] = Vec.new();
    for line in splitlines(text) {
        if line.len() > 0 {
            parts.push(split_str(line, ":"));
        }
    }
    dict_from_splits(parts)
}

fn parse_slots(ranges: ref Vec[String]) -> (Val, Val) {
    let mut slots: Vec[Val] = Vec.new();
    let mut migrations: Vec[Val] = Vec.new();
    for s in ranges {
        let cs = chars_of(s);
        if s.contains("->-") or s.contains("-<-") {
            let inner = str_of(cs, 1, cs.len() as i64 - 1);
            let (sep, state) = if s.contains("->-") { ("->-", "migrating") } else { ("-<-", "importing") };
            let kv = split_once(inner, sep);
            let mut d = new_dict();
            dset(mut d, vs("slot"), vstr(kv[0]));
            dset(mut d, vs("node_id"), vstr(kv[1]));
            dset(mut d, vs("state"), vs(state));
            migrations.push(d);
        } else {
            let mut parts: Vec[Val] = Vec.new();
            for p in split_str(s, "-") {
                parts.push(vstr(p));
            }
            slots.push(Val.List(parts));
        }
    }
    (Val.List(slots), Val.List(migrations))
}

fn parse_node_line(line: ref String) -> Result[(Val, Val), Exc] {
    let items = split_str(line, " ");
    if items.len() < 8 {
        return Err(exc("ValueError", f"not enough values to unpack (expected 8, got {items.len()})"));
    }
    let addr = items[1].clone();
    let at_parts = split_str(addr, "@");
    let ip = at_parts[0].clone();
    let hostname = if addr.contains("@") and addr.contains(",") { split_str(at_parts[1], ",")[1].clone() } else { String.new() };
    let mut d = new_dict();
    dset(mut d, vs("node_id"), vstr(items[0]));
    dset(mut d, vs("hostname"), vstr(hostname));
    dset(mut d, vs("flags"), vstr(items[2]));
    dset(mut d, vs("master_id"), vstr(items[3]));
    dset(mut d, vs("last_ping_sent"), vstr(items[4]));
    dset(mut d, vs("last_pong_rcvd"), vstr(items[5]));
    dset(mut d, vs("epoch"), vstr(items[6]));
    dset(mut d, vs("slots"), Val.List(Vec.new()));
    dset(mut d, vs("migrations"), Val.List(Vec.new()));
    dset(mut d, vs("connected"), Val.Bool(items[7] == "connected"));
    if items.len() >= 9 {
        let mut rest: Vec[String] = Vec.new();
        for i in 8..items.len() {
            rest.push(items[i].clone());
        }
        let (slots, migrations) = parse_slots(rest);
        dset(mut d, vs("slots"), slots);
        dset(mut d, vs("migrations"), migrations);
    }
    Ok((vstr(ip), d))
}

// bytes.splitlines() and str.splitlines() for the cluster node list.
fn lines_of(v: ref Val) -> Vec[Val] {
    match v {
        Val.Str(s) => {
            let mut out: Vec[Val] = Vec.new();
            for l in splitlines(s) {
                out.push(vstr(l));
            }
            out
        }
        Val.Bytes(b) => {
            let mut out: Vec[Val] = Vec.new();
            let mut cur: Vec[u8] = Vec.new();
            let mut i = 0;
            let n = b.len() as i64;
            while i < n {
                let c = b[i];
                if c == b'\n' or c == b'\r' {
                    out.push(Val.Bytes(cur.clone()));
                    cur = Vec.new();
                    if c == b'\r' and i + 1 < n and b[i + 1] == b'\n' {
                        i += 1;
                    }
                } else {
                    cur.push(c);
                }
                i += 1;
            }
            if cur.len() > 0 {
                out.push(Val.Bytes(cur));
            }
            out
        }
        _ => items_of(v),
    }
}

fn parse_cluster_nodes(r: ref Val) -> Result[Val, Exc] {
    let mut d = new_dict();
    for node in lines_of(r) {
        let line = text_or_err(node, "split")?;
        let (ip, nd) = parse_node_line(line)?;
        dset(mut d, ip, nd);
    }
    Ok(d)
}

fn coord(ll: ref Val) -> Result[Val, Exc] {
    Ok(Val.Tuple(vec![py_float(idx(ll, 0)?)?, py_float(idx(ll, 1)?)?]))
}

fn parse_geosearch(r: ref Val, o: ref Opts) -> Result[Val, Exc] {
    if not o.geo {
        return Ok(r.clone());
    }
    if o.store or o.store_dist {
        return Ok(r.clone());
    }
    let list = if is_list(r) { items_of(r) } else { vec![r.clone()] };
    if not o.withdist and not o.withcoord and not o.withhash {
        return Ok(Val.List(list));
    }
    let mut fs: Vec[i64] = vec![0];
    if o.withdist {
        fs.push(1);
    }
    if o.withhash {
        fs.push(2);
    }
    if o.withcoord {
        fs.push(3);
    }
    let mut out: Vec[Val] = Vec.new();
    for row in list {
        let vals = iter_of(row)?;
        let mut cells: Vec[Val] = Vec.new();
        let mut k = 0;
        while k < fs.len() and k < vals.len() {
            let v = vals[k].clone();
            cells.push(match fs[k] {
                0 => v,
                1 => py_float(v)?,
                2 => py_int(v)?,
                _ => coord(v)?,
            });
            k += 1;
        }
        out.push(Val.List(cells));
    }
    Ok(Val.List(out))
}

fn parse_command(r: ref Val, p3: bool) -> Result[Val, Exc] {
    let mut cmds = new_dict();
    for c in iter_of(r)? {
        let mut d = new_dict();
        let name = str_if_bytes(idx(c, 0)?);
        dset(mut d, vs("name"), name.clone());
        if p3 {
            dset(mut d, vs("arity"), idx(c, 1)?);
            let mut flags: Vec[Val] = Vec.new();
            for f in iter_of(idx(c, 2)?)? {
                set_add(mut flags, str_if_bytes(f));
            }
            dset(mut d, vs("flags"), Val.Set(flags));
        } else {
            dset(mut d, vs("arity"), py_int(idx(c, 1)?)?);
            dset(mut d, vs("flags"), str_list(idx(c, 2)?)?);
        }
        dset(mut d, vs("first_key_pos"), idx(c, 3)?);
        dset(mut d, vs("last_key_pos"), idx(c, 4)?);
        dset(mut d, vs("step_count"), idx(c, 5)?);
        if p3 {
            dset(mut d, vs("acl_categories"), idx(c, 6)?);
        }
        if len_of(c) > 7 {
            dset(mut d, vs("tips"), idx(c, 7)?);
            dset(mut d, vs("key_specifications"), idx(c, 8)?);
            dset(mut d, vs("subcommands"), idx(c, 9)?);
        }
        dset(mut cmds, name, d);
    }
    Ok(cmds)
}

fn parse_pubsub_numsub(r: ref Val) -> Result[Val, Exc] {
    let xs = iter_of(r)?;
    let mut out: Vec[Val] = Vec.new();
    let mut i = 0;
    while i + 1 < xs.len() {
        out.push(Val.Tuple(vec![xs[i].clone(), xs[i + 1].clone()]));
        i += 2;
    }
    Ok(Val.List(out))
}

// list(str_if_bytes(v).split(" ")) as parse_acl_getuser splits a field.
fn split_field(v: ref Val) -> Result[Val, Exc] {
    let text = text_or_err(v, "split")?;
    let mut out: Vec[Val] = Vec.new();
    for p in split_str(text, " ") {
        out.push(vstr(p));
    }
    Ok(Val.List(out))
}

fn is_blank_list(v: ref Val) -> bool {
    match v {
        Val.List(xs) => xs.len() == 1 and py_eq(xs[0], vs("")),
        _ => false,
    }
}

fn parse_acl_getuser(r: ref Val) -> Result[Val, Exc] {
    if is_none(r) {
        return Ok(Val.Non);
    }
    let mut d = if is_list(r) { pairs_to_dict(r, true, false)? } else { str_keys(r)? };
    let flags = str_list(dkey(d, "flags")?)?;
    dset(mut d, vs("flags"), flags);
    let pw = str_list(dkey(d, "passwords")?)?;
    dset(mut d, vs("passwords"), pw);
    let cmds = str_if_bytes(dkey(d, "commands")?);
    dset(mut d, vs("commands"), cmds);
    let keys = dkey(d, "keys")?;
    if is_text(keys) {
        dset(mut d, vs("keys"), split_field(keys)?);
    }
    if is_blank_list(dkey(d, "keys")?) {
        dset(mut d, vs("keys"), Val.List(Vec.new()));
    }
    if dict_has(d, "channels") {
        let ch = dkey(d, "channels")?;
        if is_text(ch) {
            dset(mut d, vs("channels"), split_field(ch)?);
        }
        if is_blank_list(dkey(d, "channels")?) {
            dset(mut d, vs("channels"), Val.List(Vec.new()));
        }
    }
    if dict_has(d, "selectors") {
        let sel = dkey(d, "selectors")?;
        let items = iter_of(sel)?;
        if items.len() > 0 and is_list(items[0]) {
            let mut out: Vec[Val] = Vec.new();
            for s in items {
                out.push(str_list(s)?);
            }
            dset(mut d, vs("selectors"), Val.List(out));
        } else if items.len() > 0 {
            let mut out: Vec[Val] = Vec.new();
            for s in items {
                if not is_dict(s) {
                    return Err(exc("AttributeError", f"'{type_name(s)}' object has no attribute 'items'"));
                }
                let mut m = new_dict();
                let ks = dict_keys(s);
                let xs = dict_vals(s);
                for i in 0..ks.len() {
                    dset(mut m, str_if_bytes(ks[i]), str_if_bytes(xs[i]));
                }
                out.push(m);
            }
            dset(mut d, vs("selectors"), Val.List(out));
        }
    }
    let mut commands: Vec[Val] = Vec.new();
    let mut categories: Vec[Val] = Vec.new();
    let ctext = text_or_err(dkey(d, "commands")?, "split")?;
    for c in split_str(ctext, " ") {
        if c.contains("@") {
            categories.push(vstr(c));
        } else {
            commands.push(vstr(c));
        }
    }
    dset(mut d, vs("commands"), Val.List(commands));
    dset(mut d, vs("categories"), Val.List(categories));
    let enabled = index_of(items_of(dkey(d, "flags")?), vs("on")) >= 0;
    dset(mut d, vs("enabled"), Val.Bool(enabled));
    Ok(d)
}

fn parse_acl_log(r: ref Val) -> Result[Val, Exc] {
    if is_none(r) {
        return Ok(Val.Non);
    }
    if not is_list(r) {
        return Ok(bool_ok(r));
    }
    let mut data: Vec[Val] = Vec.new();
    for log in items_of(r) {
        let mut d = pairs_to_dict(log, true, true)?;
        let ci = dget(d, "client-info").unwrap_or(vs(""));
        dset(mut d, vs("client-info"), parse_client_info(ci)?);
        let age = py_float(dkey(d, "age-seconds")?)?;
        dset(mut d, vs("age-seconds"), age);
        data.push(d);
    }
    Ok(Val.List(data))
}

fn sentinel_typed(key: ref Val) -> bool {
    match key {
        Val.Str(k) => one_of(k, "can-failover-its-master|config-epoch|down-after-milliseconds|failover-timeout|info-refresh|last-hello-message|last-ok-ping-reply|last-ping-reply|last-ping-sent|master-link-down-time|master-port|num-other-sentinels|num-slaves|o-down-time|pending-commands|parallel-syncs|port|quorum|role-reported-time|s-down-time|slave-priority|slave-repl-offset|voted-leader-epoch"),
        _ => false,
    }
}

const SENTINEL_FLAGS: Str = "is_master:master|is_slave:slave|is_sdown:s_down|is_odown:o_down|is_sentinel:sentinel|is_disconnected:disconnected|is_master_down:master_down";

fn flag_set(v: ref Val) -> Result[Vec[Val], Exc] {
    let text = text_or_err(v, "split")?;
    let mut out: Vec[Val] = Vec.new();
    for f in split_str(text, ",") {
        set_add(mut out, vstr(f));
    }
    Ok(out)
}

// parse_sentinel_state() over an already-decoded flat list.
fn sentinel_state(item: ref Val) -> Result[Val, Exc] {
    let xs = iter_of(item)?;
    let mut d = new_dict();
    let mut i = 0;
    while i + 1 < xs.len() {
        let k = xs[i].clone();
        let mut v = xs[i + 1].clone();
        if sentinel_typed(k) {
            match py_int(v) {
                Ok(n) => v = n,
                Err(_) => {}
            }
        }
        dset(mut d, k, v);
        i += 2;
    }
    let flags = flag_set(dkey(d, "flags")?)?;
    for pair in split_str(SENTINEL_FLAGS.to_string(), "|") {
        let nf = split_str(pair, ":");
        let on = index_of(flags, vstr(nf[1])) >= 0;
        dset(mut d, vstr(nf[0]), Val.Bool(on));
    }
    Ok(d)
}

fn decoded_list(v: ref Val) -> Result[Val, Exc] {
    str_list(v)
}

fn sentinel_state3(r: ref Val) -> Result[Val, Exc] {
    let mut d = new_dict();
    for key in iter_of(r)? {
        let raw = match dict_get(r, key) {
            Some(x) => x,
            None => return Err(exc("TypeError", f"{type_name(r)} indices must be integers or slices, not {type_name(key)}")),
        };
        let mut done = false;
        if sentinel_typed(key) {
            match py_int(str_if_bytes(raw)) {
                Ok(n) => {
                    dset(mut d, str_if_bytes(key), n);
                    done = true;
                }
                Err(_) => {}
            }
        }
        if not done {
            let sk = str_if_bytes(key);
            match dict_get(r, sk) {
                Some(x) => dset(mut d, sk, x),
                None => return Err(exc("KeyError", show(sk))),
            }
        }
    }
    let flags = flag_set(dkey(d, "flags")?)?;
    dset(mut d, vs("flags"), Val.Set(flags));
    Ok(d)
}

fn xinfo_stream(r: ref Val, o: ref Opts) -> Result[Val, Exc] {
    let mut d = if is_list(r) { pairs_to_dict(r, true, false)? } else { str_keys(r)? };
    if not o.full {
        let first = dget(d, "first-entry").unwrap_or(Val.Non);
        if not is_none(first) and not is_none(idx(first, 0)?) {
            dset(mut d, vs("first-entry"), Val.Tuple(vec![idx(first, 0)?, pairs_to_dict(idx(first, 1)?, false, false)?]));
        }
        let last = dkey(d, "last-entry")?;
        if not is_none(last) and not is_none(idx(last, 0)?) {
            dset(mut d, vs("last-entry"), Val.Tuple(vec![idx(last, 0)?, pairs_to_dict(idx(last, 1)?, false, false)?]));
        }
        return Ok(d);
    }
    let mut entries = new_dict();
    for e in iter_of(dkey(d, "entries")?)? {
        let (id, entry) = unpack2(e)?;
        dset(mut entries, id, pairs_to_dict(entry, false, false)?);
    }
    dset(mut d, vs("entries"), entries);
    let groups = items_of(dkey(d, "groups")?);
    if groups.len() > 0 and is_list(groups[0]) {
        let mut gs: Vec[Val] = Vec.new();
        for g in groups {
            let mut gd = pairs_to_dict(g, true, false)?;
            let cons = dkey(gd, "consumers")?;
            if truthy(cons) and not is_none(idx(cons, 0)?) {
                let mut cs: Vec[Val] = Vec.new();
                for c in iter_of(cons)? {
                    cs.push(pairs_to_dict(c, true, false)?);
                }
                dset(mut gd, vs("consumers"), Val.List(cs));
            }
            gs.push(gd);
        }
        dset(mut d, vs("groups"), Val.List(gs));
    } else {
        let mut gs: Vec[Val] = Vec.new();
        for g in groups {
            gs.push(str_keys(g)?);
        }
        dset(mut d, vs("groups"), Val.List(gs));
    }
    Ok(d)
}

fn parse_xpending(r: ref Val, o: ref Opts) -> Result[Val, Exc] {
    if o.parse_detail {
        let names = ["message_id", "consumer", "time_since_delivered", "times_delivered"];
        let mut out: Vec[Val] = Vec.new();
        for row in iter_of(r)? {
            let vals = iter_of(row)?;
            let mut d = new_dict();
            let mut k = 0;
            while k < 4 and k < vals.len() {
                dset(mut d, vs(names[k]), vals[k].clone());
                k += 1;
            }
            out.push(d);
        }
        return Ok(Val.List(out));
    }
    let mut consumers: Vec[Val] = Vec.new();
    let c3 = idx(r, 3)?;
    if truthy(c3) {
        for c in iter_of(c3)? {
            let (n, p) = unpack2(c)?;
            let mut d = new_dict();
            dset(mut d, vs("name"), n);
            dset(mut d, vs("pending"), py_int(p)?);
            consumers.push(d);
        }
    }
    let mut d = new_dict();
    dset(mut d, vs("pending"), idx(r, 0)?);
    dset(mut d, vs("min"), idx(r, 1)?);
    dset(mut d, vs("max"), idx(r, 2)?);
    dset(mut d, vs("consumers"), Val.List(consumers));
    Ok(d)
}

fn parse_memory_stats(r: ref Val) -> Result[Val, Exc] {
    let mut stats = pairs_to_dict(r, true, true)?;
    let ks = dict_keys(stats);
    let xs = dict_vals(stats);
    for i in 0..ks.len() {
        let k = text_of(ks[i]);
        if k.starts_with("db.") and is_list(xs[i]) {
            dset(mut stats, ks[i].clone(), pairs_to_dict(xs[i], true, true)?);
        }
    }
    Ok(stats)
}

// The callbacks themselves.
fn apply_cb(w: ref World, id: ref String, r: own Val, o: ref Opts) -> Result[Val, Exc] {
    let p3 = w.cfg.protocol == 3;
    match id.as_str() {
        "bool" => Ok(py_bool(r)),
        "float" => py_float(r),
        "bool_ok" => Ok(bool_ok(r)),
        "true" => Ok(Val.Bool(true)),
        "same" => Ok(r),
        "set" => {
            if truthy(r) {
                Ok(set_of(iter_of(r)?))
            } else {
                Ok(Val.Set(Vec.new()))
            }
        }
        "zset_score_pairs" => {
            if not truthy(r) or not o.withscores {
                return Ok(r);
            }
            score_pairs(r, o.score_cast)
        }
        "float_or_none" => float_or_none(r),
        "tuple_or_none" => if truthy(r) { tuple_of(r) } else { Ok(Val.Non) },
        "bzpop" => {
            if not truthy(r) {
                return Ok(Val.Non);
            }
            Ok(Val.Tuple(vec![idx(r, 0)?, idx(r, 1)?, py_float(idx(r, 2)?)?]))
        }
        "str_list" => str_list(r),
        "str_if_bytes" => Ok(str_if_bytes(r)),
        "config_get" => parse_config_get(r),
        "debug_object" => parse_debug_object(r),
        "geopos" => {
            let mut out: Vec[Val] = Vec.new();
            for ll in iter_of(r)? {
                out.push(if is_none(ll) { Val.Non } else { coord(ll)? });
            }
            Ok(Val.List(out))
        }
        "hgetall" => if truthy(r) { pairs_to_dict(r, false, false) } else { Ok(new_dict()) },
        "memory_stats" => parse_memory_stats(r),
        "module_list" => {
            let mut out: Vec[Val] = Vec.new();
            for m in iter_of(r)? {
                out.push(pairs_to_dict(m, false, false)?);
            }
            Ok(Val.List(out))
        }
        "sentinel_master" => sentinel_state(decoded_list(r)?),
        "sentinel_masters" => {
            let mut d = new_dict();
            for item in iter_of(r)? {
                let st = sentinel_state(decoded_list(item)?)?;
                let name = dkey(st, "name")?;
                dset(mut d, name, st);
            }
            Ok(d)
        }
        "sentinel_slaves" => {
            let mut out: Vec[Val] = Vec.new();
            for item in iter_of(r)? {
                out.push(sentinel_state(decoded_list(item)?)?);
            }
            Ok(Val.List(out))
        }
        "stralgo" => parse_stralgo(r, o),
        "list_of_dicts" => {
            let mut out: Vec[Val] = Vec.new();
            for x in iter_of(r)? {
                out.push(pairs_to_dict(x, true, false)?);
            }
            Ok(Val.List(out))
        }
        "zadd" => {
            if is_none(r) {
                return Ok(Val.Non);
            }
            if o.as_score { py_float(r) } else { py_int(r) }
        }
        "zmscore" => {
            let mut out: Vec[Val] = Vec.new();
            for s in iter_of(r)? {
                out.push(if is_none(s) { Val.Non } else { py_float(s)? });
            }
            Ok(Val.List(out))
        }
        "xread" => {
            if is_none(r) {
                return Ok(Val.List(Vec.new()));
            }
            let mut out: Vec[Val] = Vec.new();
            for x in iter_of(r)? {
                out.push(Val.List(vec![idx(x, 0)?, stream_list(idx(x, 1)?)?]));
            }
            Ok(Val.List(out))
        }
        "xread3" => {
            if is_none(r) {
                return Ok(new_dict());
            }
            if not is_dict(r) {
                return Err(exc("AttributeError", f"'{type_name(r)}' object has no attribute 'items'"));
            }
            let mut d = new_dict();
            let ks = dict_keys(r);
            let xs = dict_vals(r);
            for i in 0..ks.len() {
                dset(mut d, ks[i].clone(), Val.List(vec![stream_list(xs[i])?]));
            }
            Ok(d)
        }
        "geosearch" => parse_geosearch(r, o),
        "stream_list" => stream_list(r),
        "acl_getuser" => parse_acl_getuser(r),
        "acl_log" => parse_acl_log(r),
        "acl_log3" => {
            if not is_list(r) {
                return Ok(bool_ok(r));
            }
            let mut out: Vec[Val] = Vec.new();
            for x in items_of(r) {
                if not is_dict(x) {
                    return Err(exc("AttributeError", f"'{type_name(x)}' object has no attribute 'items'"));
                }
                let mut m = new_dict();
                let ks = dict_keys(x);
                let xs = dict_vals(x);
                for i in 0..ks.len() {
                    dset(mut m, str_if_bytes(ks[i]), str_if_bytes(xs[i]));
                }
                out.push(m);
            }
            Ok(Val.List(out))
        }
        "client_info" => parse_client_info(r),
        "client_kill" => {
            match r {
                Val.Int(_) => Ok(r),
                Val.Bool(_) => Ok(r),
                _ => Ok(Val.Bool(text_eq(r, "OK"))),
            }
        }
        "client_list" => parse_client_list(r),
        "cluster_info" => parse_cluster_info(r),
        "cluster_nodes" => parse_cluster_nodes(r),
        "command" => parse_command(r, false),
        "command3" => parse_command(r, true),
        "config_get3" => {
            if not is_dict(r) {
                return Err(exc("AttributeError", f"'{type_name(r)}' object has no attribute 'items'"));
            }
            let mut m = new_dict();
            let ks = dict_keys(r);
            let xs = dict_vals(r);
            for i in 0..ks.len() {
                let k = if is_none(ks[i]) { Val.Non } else { str_if_bytes(ks[i]) };
                let x = if is_none(xs[i]) { Val.Non } else { str_if_bytes(xs[i]) };
                dset(mut m, k, x);
            }
            Ok(m)
        }
        "memory_stats3" => str_keys(r),
        "sentinel_state3" => sentinel_state3(r),
        "sentinel_masters3" => {
            let mut out: Vec[Val] = Vec.new();
            for m in iter_of(r)? {
                out.push(sentinel_state(m)?);
            }
            Ok(Val.List(out))
        }
        "sentinel_slaves3" => {
            let mut out: Vec[Val] = Vec.new();
            for m in iter_of(r)? {
                out.push(sentinel_state3(m)?);
            }
            Ok(Val.List(out))
        }
        "stralgo3" => {
            if is_dict(r) {
                let mut m = new_dict();
                let ks = dict_keys(r);
                let xs = dict_vals(r);
                for i in 0..ks.len() {
                    dset(mut m, str_if_bytes(ks[i]), str_if_bytes(xs[i]));
                }
                Ok(m)
            } else {
                Ok(str_if_bytes(r))
            }
        }
        "str_keys3" => {
            let mut out: Vec[Val] = Vec.new();
            for x in iter_of(r)? {
                out.push(str_keys(x)?);
            }
            Ok(Val.List(out))
        }
        "hscan" => parse_hscan(r, o),
        "info" => parse_info(r),
        "ping" => Ok(Val.Bool(text_eq(r, "PONG"))),
        "pubsub_numsub" => parse_pubsub_numsub(r),
        "set_result" => {
            if o.get {
                return Ok(r);
            }
            if not truthy(r) {
                return Ok(r);
            }
            Ok(Val.Bool(text_eq(r, "OK")))
        }
        "scan" => parse_scan(r),
        "bool_list" => {
            let mut out: Vec[Val] = Vec.new();
            for x in iter_of(r)? {
                out.push(py_bool(x));
            }
            Ok(Val.List(out))
        }
        "sentinel_get_master" => {
            if not truthy(r) {
                return Ok(r);
            }
            Ok(Val.Tuple(vec![idx(r, 0)?, py_int(idx(r, 1)?)?]))
        }
        "slowlog_get" => parse_slowlog_get(r),
        "sort" => {
            if not truthy(r) or o.groups == 0 {
                return Ok(r);
            }
            let xs = iter_of(r)?;
            let n = o.groups;
            let rows = xs.len() as i64 / n;
            let mut out: Vec[Val] = Vec.new();
            for k in 0..rows {
                let mut t: Vec[Val] = Vec.new();
                for j in 0..n {
                    t.push(xs[k * n + j].clone());
                }
                out.push(Val.Tuple(t));
            }
            Ok(Val.List(out))
        }
        "time" => Ok(Val.Tuple(vec![py_int(idx(r, 0)?)?, py_int(idx(r, 1)?)?])),
        "xautoclaim" => {
            if o.parse_justid {
                return idx(r, 1);
            }
            let mut xs = items_of(r);
            if xs.len() < 2 {
                return Err(exc("IndexError", "list index out of range".to_string()));
            }
            xs[1] = stream_list(xs[1])?;
            Ok(Val.List(xs))
        }
        "xclaim" => if o.parse_justid { Ok(r) } else { stream_list(r) },
        "xinfo_stream" => xinfo_stream(r, o),
        "xpending" => parse_xpending(r, o),
        "zscan" => parse_zscan(r, o),
        _ => {
            let _ = p3;
            Ok(r)
        }
    }
}

// ------------------------------------------------------------ command methods

// A call as a job line gives it: the positional arguments and the keyword
// ones, bound to a method's parameters by position or by name.
struct Call {
    args: Vec[Val],
    kn: Vec[String],
    kv: Vec[Val],
}

fn given(c: ref Call, i: i64, name: Str) -> bool {
    if i >= 0 and i < c.args.len() as i64 {
        return true;
    }
    for k in 0..c.kn.len() {
        if c.kn[k] == name {
            return true;
        }
    }
    false
}

// The parameter at position i or named `name`, None when the call leaves
// it out.
fn arg(c: ref Call, i: i64, name: Str) -> Val {
    if i >= 0 and i < c.args.len() as i64 {
        return c.args[i].clone();
    }
    for k in 0..c.kn.len() {
        if c.kn[k] == name {
            return c.kv[k].clone();
        }
    }
    Val.Non
}

// The parameter with a default other than None.
fn argd(c: ref Call, i: i64, name: Str, d: own Val) -> Val {
    if given(c, i, name) {
        arg(c, i, name)
    } else {
        d
    }
}

fn flag(c: ref Call, i: i64, name: Str) -> bool {
    truthy(arg(c, i, name))
}

// *args from position `from` on.
fn rest(c: ref Call, from: i64) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    let mut i = from;
    while i < c.args.len() as i64 {
        out.push(c.args[i].clone());
        i += 1;
    }
    out
}

fn mk(name: Str, pieces: own Vec[Val]) -> Cmd {
    let mut args = vec![vs(name)];
    for p in pieces {
        args.push(p.clone());
    }
    Cmd { args: args, opts: no_opts() }
}

fn extend(a: mut ref Vec[Val], b: ref Vec[Val]) {
    for x in b {
        a.push(x.clone());
    }
}

fn int_neg(v: ref Val) -> bool {
    match v {
        Val.Int(n) => n < 0,
        Val.Big(s) => s.starts_with("-"),
        Val.Float(x) => x < 0.0,
        _ => false,
    }
}

fn int_below1(v: ref Val) -> bool {
    match v {
        Val.Int(n) => n < 1,
        Val.Bool(b) => not b,
        Val.Big(s) => s.starts_with("-"),
        Val.Float(x) => x < 1.0,
        _ => false,
    }
}

// v in ("a", "b", ...) for a str v.
fn str_in(v: ref Val, names: Str) -> bool {
    match v {
        Val.Str(s) => one_of(s, names),
        _ => false,
    }
}

fn is_str(v: ref Val, s: Str) -> bool {
    match v {
        Val.Str(x) => x == s,
        _ => false,
    }
}

fn no_attr(v: ref Val, name: Str) -> Exc {
    exc("AttributeError", f"'{type_name(v)}' object has no attribute '{name}'")
}

fn str_upper(v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Str(s) => Ok(upper(s)),
        _ => Err(no_attr(v, "upper")),
    }
}

fn str_lower(v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Str(s) => Ok(lower(s)),
        _ => Err(no_attr(v, "lower")),
    }
}

fn not_iter(v: ref Val) -> Exc {
    exc("TypeError", f"'{type_name(v)}' object is not iterable")
}

// for x in v, over a str's characters too.
fn iterate(v: ref Val) -> Result[Vec[Val], Exc] {
    match v {
        Val.Str(s) => {
            let mut out: Vec[Val] = Vec.new();
            for ch in s.chars() {
                let mut t = String.new();
                t.push(ch);
                out.push(Val.Str(t));
            }
            Ok(out)
        }
        Val.Bytes(b) => {
            let mut out: Vec[Val] = Vec.new();
            for x in b {
                out.push(Val.Int(x as i64));
            }
            Ok(out)
        }
        Val.List(xs) => Ok(xs.clone()),
        Val.Tuple(xs) => Ok(xs.clone()),
        Val.Set(xs) => Ok(xs.clone()),
        Val.Dict(ks, _) => Ok(ks.clone()),
        _ => Err(not_iter(v)),
    }
}

// mapping.items(), flattened to key, value, key, value.
fn pairs_of(v: ref Val) -> Result[Vec[Val], Exc] {
    match v {
        Val.Dict(ks, xs) => {
            let mut out: Vec[Val] = Vec.new();
            for i in 0..ks.len() {
                out.push(ks[i].clone());
                out.push(xs[i].clone());
            }
            Ok(out)
        }
        _ => Err(no_attr(v, "items")),
    }
}

// list_or_args(): a str or bytes is one key, any other iterable a list of
// them, anything else one key; then the extra args.
fn list_or_args(keys: ref Val, more: ref Vec[Val]) -> Vec[Val] {
    let mut out: Vec[Val] = match keys {
        Val.Str(_) => vec![keys.clone()],
        Val.Bytes(_) => vec![keys.clone()],
        Val.List(xs) => xs.clone(),
        Val.Tuple(xs) => xs.clone(),
        Val.Set(xs) => xs.clone(),
        Val.Dict(ks, _) => ks.clone(),
        _ => vec![keys.clone()],
    };
    extend(mut out, more);
    out
}

// str(v) as a command argument.
fn str_arg(v: ref Val) -> Val {
    Val.Str(py_str(v))
}

// The name a score_cast_func token names: float or int.
fn cast_name(v: ref Val) -> String {
    match v {
        Val.Cls(s) => {
            let parts = split_str(s, ".");
            parts[parts.len() - 1].clone()
        }
        _ => "float".to_string(),
    }
}

// int(v) where the method catches the TypeError that None (or a list)
// raises: None when it does.
fn int_or_skip(v: ref Val) -> Result[Option[Val], Exc] {
    match py_int(v) {
        Ok(n) => Ok(Some(n)),
        Err(e) => {
            if e.cls == "TypeError" {
                Ok(None)
            } else {
                Err(e)
            }
        }
    }
}

const LIST_NAMES: Str = "blpop|brpop|lindex|linsert|llen|lmove|lpop|lpos|lpush|lrange|lrem|lset|ltrim|rpop|rpush";
const SET_NAMES: Str = "sadd|scard|sdiff|sinter|sismember|smembers|smismember|smove|spop|srandmember|srem|sscan|sunion";
const STRING_NAMES: Str = "append|bitcount|bitop|bitpos|copy|decr|decrby|delete|exists|expire|get|getbit|getdel|getex|getrange|incr|incrby|incrbyfloat|keys|lcs|mget|mset|msetnx|object|persist|pexpire|pfadd|pfcount|pfmerge|psetex|pttl|randomkey|rename|renamenx|scan|set|setbit|setex|setnx|setrange|sort|strlen|touch|ttl|type|unlink";

// The command a Redis method sends, and the options it passes to
// execute_command(), or the error the method raises first.
fn build(w: ref World, n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if n.starts_with("x") {
        build_stream(n, c)
    } else if n.starts_with("z") {
        build_zset(n, c)
    } else if n.starts_with("geo") {
        build_geo(n, c)
    } else if n.starts_with("h") {
        build_hash(n, c)
    } else if one_of(n, LIST_NAMES) {
        build_list(n, c)
    } else if one_of(n, SET_NAMES) {
        build_set(n, c)
    } else if one_of(n, STRING_NAMES) {
        build_string(n, c)
    } else {
        build_server(w, n, c)
    }
}

fn unknown(n: ref String) -> Exc {
    exc("AttributeError", f"'Redis' object has no attribute '{n}'")
}

fn expiry_flags(p: mut ref Vec[Val], c: ref Call, from: i64) {
    if flag(c, from, "nx") {
        p.push(vs("NX"));
    }
    if flag(c, from + 1, "xx") {
        p.push(vs("XX"));
    }
    if flag(c, from + 2, "gt") {
        p.push(vs("GT"));
    }
    if flag(c, from + 3, "lt") {
        p.push(vs("LT"));
    }
}

fn is_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for ch in s.chars() {
        if ch < '0' or ch > '9' {
            return false;
        }
    }
    true
}

fn build_string(n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "append" {
        return Ok(mk("APPEND", vec![arg(c, 0, "key"), arg(c, 1, "value")]));
    }
    if *n == "bitcount" {
        let start = arg(c, 1, "start");
        let end = arg(c, 2, "end");
        let mode = arg(c, 3, "mode");
        let mut p = vec![arg(c, 0, "key")];
        if not is_none(start) and not is_none(end) {
            p.push(start);
            p.push(end);
        } else if not is_none(start) or not is_none(end) {
            return Err(data_error("Both start and end must be specified"));
        }
        if not is_none(mode) {
            p.push(mode);
        }
        return Ok(mk("BITCOUNT", p));
    }
    if *n == "bitop" {
        let mut p = vec![arg(c, 0, "operation"), arg(c, 1, "dest")];
        extend(mut p, rest(c, 2));
        return Ok(mk("BITOP", p));
    }
    if *n == "bitpos" {
        let bit = arg(c, 1, "bit");
        if not py_eq(bit, Val.Int(0)) and not py_eq(bit, Val.Int(1)) {
            return Err(data_error("bit must be 0 or 1"));
        }
        let start = arg(c, 2, "start");
        let end = arg(c, 3, "end");
        let mode = arg(c, 4, "mode");
        let mut p = vec![arg(c, 0, "key"), bit];
        if not is_none(start) {
            p.push(start.clone());
        }
        if not is_none(start) and not is_none(end) {
            p.push(end);
        } else if is_none(start) and not is_none(end) {
            return Err(data_error("start argument is not set, when end is specified"));
        }
        if not is_none(mode) {
            p.push(mode);
        }
        return Ok(mk("BITPOS", p));
    }
    if *n == "copy" {
        let mut p = vec![arg(c, 0, "source"), arg(c, 1, "destination")];
        let db = arg(c, 2, "destination_db");
        if not is_none(db) {
            p.push(vs("DB"));
            p.push(db);
        }
        if flag(c, 3, "replace") {
            p.push(vs("REPLACE"));
        }
        return Ok(mk("COPY", p));
    }
    if *n == "decrby" or *n == "decr" {
        return Ok(mk("DECRBY", vec![arg(c, 0, "name"), argd(c, 1, "amount", Val.Int(1))]));
    }
    if *n == "incrby" or *n == "incr" {
        return Ok(mk("INCRBY", vec![arg(c, 0, "name"), argd(c, 1, "amount", Val.Int(1))]));
    }
    if *n == "incrbyfloat" {
        return Ok(mk("INCRBYFLOAT", vec![arg(c, 0, "name"), argd(c, 1, "amount", Val.Float(1.0))]));
    }
    if *n == "delete" {
        return Ok(mk("DEL", rest(c, 0)));
    }
    if *n == "exists" {
        return Ok(mk("EXISTS", rest(c, 0)));
    }
    if *n == "expire" or *n == "pexpire" {
        let mut p = vec![arg(c, 0, "name"), arg(c, 1, "time")];
        expiry_flags(mut p, c, 2);
        return Ok(mk(if *n == "expire" { "EXPIRE" } else { "PEXPIRE" }, p));
    }
    if *n == "get" {
        return Ok(mk("GET", vec![arg(c, 0, "name")]));
    }
    if *n == "getdel" {
        return Ok(mk("GETDEL", vec![arg(c, 0, "name")]));
    }
    if *n == "getex" {
        let ex = arg(c, 1, "ex");
        let px = arg(c, 2, "px");
        let exat = arg(c, 3, "exat");
        let pxat = arg(c, 4, "pxat");
        let persist = flag(c, 5, "persist");
        let mut opset: Vec[Val] = Vec.new();
        set_add(mut opset, ex.clone());
        set_add(mut opset, px.clone());
        set_add(mut opset, exat.clone());
        set_add(mut opset, pxat.clone());
        if opset.len() > 2 or (opset.len() > 1 and persist) {
            return Err(data_error("``ex``, ``px``, ``exat``, ``pxat``, and ``persist`` are mutually exclusive."));
        }
        let mut p = vec![arg(c, 0, "name")];
        if not is_none(ex) {
            p.push(vs("EX"));
            p.push(ex);
        }
        if not is_none(px) {
            p.push(vs("PX"));
            p.push(px);
        }
        if not is_none(exat) {
            p.push(vs("EXAT"));
            p.push(exat);
        }
        if not is_none(pxat) {
            p.push(vs("PXAT"));
            p.push(pxat);
        }
        if persist {
            p.push(vs("PERSIST"));
        }
        return Ok(mk("GETEX", p));
    }
    if *n == "getbit" {
        return Ok(mk("GETBIT", vec![arg(c, 0, "name"), arg(c, 1, "offset")]));
    }
    if *n == "getrange" {
        return Ok(mk("GETRANGE", vec![arg(c, 0, "key"), arg(c, 1, "start"), arg(c, 2, "end")]));
    }
    if *n == "keys" {
        return Ok(mk("KEYS", vec![argd(c, 0, "pattern", vs("*"))]));
    }
    if *n == "lcs" {
        let mut p = vec![arg(c, 0, "key1"), arg(c, 1, "key2")];
        if flag(c, 2, "len") {
            p.push(vs("LEN"));
        }
        if flag(c, 3, "idx") {
            p.push(vs("IDX"));
        }
        let mml = argd(c, 4, "minmatchlen", Val.Int(0));
        if not py_eq(mml, Val.Int(0)) {
            p.push(vs("MINMATCHLEN"));
            p.push(mml);
        }
        if flag(c, 5, "withmatchlen") {
            p.push(vs("WITHMATCHLEN"));
        }
        return Ok(mk("LCS", p));
    }
    if *n == "mget" {
        let keys = list_or_args(arg(c, 0, "keys"), rest(c, 1));
        let mut cmd = mk("MGET", keys.clone());
        if keys.len() == 0 {
            cmd.opts.empty_response = true;
        }
        return Ok(cmd);
    }
    if *n == "mset" or *n == "msetnx" {
        let items = pairs_of(arg(c, 0, "mapping"))?;
        return Ok(mk(if *n == "mset" { "MSET" } else { "MSETNX" }, items));
    }
    if *n == "object" {
        return Ok(mk("OBJECT", vec![arg(c, 0, "infotype"), arg(c, 1, "key")]));
    }
    if *n == "persist" {
        return Ok(mk("PERSIST", vec![arg(c, 0, "name")]));
    }
    if *n == "pfadd" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, rest(c, 1));
        return Ok(mk("PFADD", p));
    }
    if *n == "pfcount" {
        return Ok(mk("PFCOUNT", rest(c, 0)));
    }
    if *n == "pfmerge" {
        let mut p = vec![arg(c, 0, "dest")];
        extend(mut p, rest(c, 1));
        return Ok(mk("PFMERGE", p));
    }
    if *n == "psetex" {
        return Ok(mk("PSETEX", vec![arg(c, 0, "name"), arg(c, 1, "time_ms"), arg(c, 2, "value")]));
    }
    if *n == "pttl" {
        return Ok(mk("PTTL", vec![arg(c, 0, "name")]));
    }
    if *n == "randomkey" {
        return Ok(mk("RANDOMKEY", Vec.new()));
    }
    if *n == "rename" or *n == "renamenx" {
        return Ok(mk(if *n == "rename" { "RENAME" } else { "RENAMENX" }, vec![arg(c, 0, "src"), arg(c, 1, "dst")]));
    }
    if *n == "scan" {
        let mut p = vec![argd(c, 0, "cursor", Val.Int(0))];
        let m = arg(c, 1, "match");
        if not is_none(m) {
            p.push(vb("MATCH"));
            p.push(m);
        }
        let count = arg(c, 2, "count");
        if not is_none(count) {
            p.push(vb("COUNT"));
            p.push(count);
        }
        let t = arg(c, 3, "_type");
        if not is_none(t) {
            p.push(vb("TYPE"));
            p.push(t);
        }
        return Ok(mk("SCAN", p));
    }
    if *n == "set" {
        let mut p = vec![arg(c, 0, "name"), arg(c, 1, "value")];
        let ex = arg(c, 2, "ex");
        if not is_none(ex) {
            p.push(vs("EX"));
            if is_int(ex) {
                p.push(ex);
            } else {
                match ex {
                    Val.Str(ref s) => {
                        if is_digits(s) {
                            p.push(py_int(ex)?);
                        } else {
                            return Err(data_error("ex must be datetime.timedelta or int"));
                        }
                    }
                    _ => return Err(data_error("ex must be datetime.timedelta or int")),
                }
            }
        }
        let px = arg(c, 3, "px");
        if not is_none(px) {
            p.push(vs("PX"));
            if is_int(px) {
                p.push(px);
            } else {
                return Err(data_error("px must be datetime.timedelta or int"));
            }
        }
        let exat = arg(c, 8, "exat");
        if not is_none(exat) {
            p.push(vs("EXAT"));
            p.push(exat);
        }
        let pxat = arg(c, 9, "pxat");
        if not is_none(pxat) {
            p.push(vs("PXAT"));
            p.push(pxat);
        }
        if flag(c, 6, "keepttl") {
            p.push(vs("KEEPTTL"));
        }
        if flag(c, 4, "nx") {
            p.push(vs("NX"));
        }
        if flag(c, 5, "xx") {
            p.push(vs("XX"));
        }
        let mut cmd = Cmd { args: Vec.new(), opts: no_opts() };
        if flag(c, 7, "get") {
            p.push(vs("GET"));
            cmd.opts.get = true;
        }
        cmd.args.push(vs("SET"));
        extend(mut cmd.args, p);
        return Ok(cmd);
    }
    if *n == "setbit" {
        let v = if flag(c, 2, "value") { 1 } else { 0 };
        return Ok(mk("SETBIT", vec![arg(c, 0, "name"), arg(c, 1, "offset"), Val.Int(v)]));
    }
    if *n == "setex" {
        return Ok(mk("SETEX", vec![arg(c, 0, "name"), arg(c, 1, "time"), arg(c, 2, "value")]));
    }
    if *n == "setnx" {
        return Ok(mk("SETNX", vec![arg(c, 0, "name"), arg(c, 1, "value")]));
    }
    if *n == "setrange" {
        return Ok(mk("SETRANGE", vec![arg(c, 0, "name"), arg(c, 1, "offset"), arg(c, 2, "value")]));
    }
    if *n == "sort" {
        let start = arg(c, 1, "start");
        let num = arg(c, 2, "num");
        if (not is_none(start) and is_none(num)) or (not is_none(num) and is_none(start)) {
            return Err(data_error("``start`` and ``num`` must both be specified"));
        }
        let mut p = vec![arg(c, 0, "name")];
        let by = arg(c, 3, "by");
        if not is_none(by) {
            p.push(vb("BY"));
            p.push(by);
        }
        if not is_none(start) and not is_none(num) {
            p.push(vb("LIMIT"));
            p.push(start);
            p.push(num);
        }
        let get = arg(c, 4, "get");
        if not is_none(get) {
            if is_text(get) {
                p.push(vb("GET"));
                p.push(get.clone());
            } else {
                for g in iterate(get)? {
                    p.push(vb("GET"));
                    p.push(g.clone());
                }
            }
        }
        if flag(c, 5, "desc") {
            p.push(vb("DESC"));
        }
        if flag(c, 6, "alpha") {
            p.push(vb("ALPHA"));
        }
        let store = arg(c, 7, "store");
        if not is_none(store) {
            p.push(vb("STORE"));
            p.push(store);
        }
        let groups = flag(c, 8, "groups");
        if groups {
            if not truthy(get) or is_text(get) or len_of(get) < 2 {
                return Err(data_error("when using \"groups\" the \"get\" argument must be specified and contain at least two keys"));
            }
        }
        let mut cmd = mk("SORT", p);
        if groups {
            cmd.opts.groups = len_of(get);
        }
        return Ok(cmd);
    }
    if *n == "strlen" {
        return Ok(mk("STRLEN", vec![arg(c, 0, "name")]));
    }
    if *n == "touch" {
        return Ok(mk("TOUCH", rest(c, 0)));
    }
    if *n == "ttl" {
        return Ok(mk("TTL", vec![arg(c, 0, "name")]));
    }
    if *n == "type" {
        return Ok(mk("TYPE", vec![arg(c, 0, "name")]));
    }
    if *n == "unlink" {
        return Ok(mk("UNLINK", rest(c, 0)));
    }
    Err(unknown(n))
}

fn build_list(n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "blpop" or *n == "brpop" {
        let mut timeout = argd(c, 1, "timeout", Val.Int(0));
        if is_none(timeout) {
            timeout = Val.Int(0);
        }
        let mut keys = list_or_args(arg(c, 0, "keys"), Vec.new());
        keys.push(timeout);
        return Ok(mk(if *n == "blpop" { "BLPOP" } else { "BRPOP" }, keys));
    }
    if *n == "lindex" {
        return Ok(mk("LINDEX", vec![arg(c, 0, "name"), arg(c, 1, "index")]));
    }
    if *n == "linsert" {
        return Ok(mk("LINSERT", vec![arg(c, 0, "name"), arg(c, 1, "where"), arg(c, 2, "refvalue"), arg(c, 3, "value")]));
    }
    if *n == "llen" {
        return Ok(mk("LLEN", vec![arg(c, 0, "name")]));
    }
    if *n == "lmove" {
        return Ok(mk("LMOVE", vec![arg(c, 0, "first_list"), arg(c, 1, "second_list"), argd(c, 2, "src", vs("LEFT")), argd(c, 3, "dest", vs("RIGHT"))]));
    }
    if *n == "lpop" or *n == "rpop" {
        let name = if *n == "lpop" { "LPOP" } else { "RPOP" };
        let count = arg(c, 1, "count");
        if not is_none(count) {
            return Ok(mk(name, vec![arg(c, 0, "name"), count]));
        }
        return Ok(mk(name, vec![arg(c, 0, "name")]));
    }
    if *n == "lpush" or *n == "rpush" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, rest(c, 1));
        return Ok(mk(if *n == "lpush" { "LPUSH" } else { "RPUSH" }, p));
    }
    if *n == "lrange" {
        return Ok(mk("LRANGE", vec![arg(c, 0, "name"), arg(c, 1, "start"), arg(c, 2, "end")]));
    }
    if *n == "lrem" {
        return Ok(mk("LREM", vec![arg(c, 0, "name"), arg(c, 1, "count"), arg(c, 2, "value")]));
    }
    if *n == "lset" {
        return Ok(mk("LSET", vec![arg(c, 0, "name"), arg(c, 1, "index"), arg(c, 2, "value")]));
    }
    if *n == "ltrim" {
        return Ok(mk("LTRIM", vec![arg(c, 0, "name"), arg(c, 1, "start"), arg(c, 2, "end")]));
    }
    if *n == "lpos" {
        let mut p = vec![arg(c, 0, "name"), arg(c, 1, "value")];
        let rank = arg(c, 2, "rank");
        if not is_none(rank) {
            p.push(vs("RANK"));
            p.push(rank);
        }
        let count = arg(c, 3, "count");
        if not is_none(count) {
            p.push(vs("COUNT"));
            p.push(count);
        }
        let maxlen = arg(c, 4, "maxlen");
        if not is_none(maxlen) {
            p.push(vs("MAXLEN"));
            p.push(maxlen);
        }
        return Ok(mk("LPOS", p));
    }
    Err(unknown(n))
}

fn build_set(n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "sadd" or *n == "srem" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, rest(c, 1));
        return Ok(mk(if *n == "sadd" { "SADD" } else { "SREM" }, p));
    }
    if *n == "scard" {
        return Ok(mk("SCARD", vec![arg(c, 0, "name")]));
    }
    if *n == "sdiff" or *n == "sinter" or *n == "sunion" {
        let keys = list_or_args(arg(c, 0, "keys"), rest(c, 1));
        return Ok(mk(if *n == "sdiff" { "SDIFF" } else if *n == "sinter" { "SINTER" } else { "SUNION" }, keys));
    }
    if *n == "sismember" {
        return Ok(mk("SISMEMBER", vec![arg(c, 0, "name"), arg(c, 1, "value")]));
    }
    if *n == "smembers" {
        return Ok(mk("SMEMBERS", vec![arg(c, 0, "name")]));
    }
    if *n == "smismember" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, list_or_args(arg(c, 1, "values"), rest(c, 2)));
        return Ok(mk("SMISMEMBER", p));
    }
    if *n == "smove" {
        return Ok(mk("SMOVE", vec![arg(c, 0, "src"), arg(c, 1, "dst"), arg(c, 2, "value")]));
    }
    if *n == "spop" or *n == "srandmember" {
        let more = if *n == "spop" { arg(c, 1, "count") } else { arg(c, 1, "number") };
        let mut p = vec![arg(c, 0, "name")];
        if not is_none(more) {
            p.push(more);
        }
        return Ok(mk(if *n == "spop" { "SPOP" } else { "SRANDMEMBER" }, p));
    }
    if *n == "sscan" {
        let mut p = vec![arg(c, 0, "name"), argd(c, 1, "cursor", Val.Int(0))];
        let m = arg(c, 2, "match");
        if not is_none(m) {
            p.push(vb("MATCH"));
            p.push(m);
        }
        let count = arg(c, 3, "count");
        if not is_none(count) {
            p.push(vb("COUNT"));
            p.push(count);
        }
        return Ok(mk("SSCAN", p));
    }
    Err(unknown(n))
}

fn build_hash(n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "hdel" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, rest(c, 1));
        return Ok(mk("HDEL", p));
    }
    if *n == "hexists" or *n == "hget" or *n == "hstrlen" {
        let name = if *n == "hexists" { "HEXISTS" } else if *n == "hget" { "HGET" } else { "HSTRLEN" };
        return Ok(mk(name, vec![arg(c, 0, "name"), arg(c, 1, "key")]));
    }
    if *n == "hgetall" or *n == "hkeys" or *n == "hlen" or *n == "hvals" {
        let name = if *n == "hgetall" { "HGETALL" } else if *n == "hkeys" { "HKEYS" } else if *n == "hlen" { "HLEN" } else { "HVALS" };
        return Ok(mk(name, vec![arg(c, 0, "name")]));
    }
    if *n == "hincrby" {
        return Ok(mk("HINCRBY", vec![arg(c, 0, "name"), arg(c, 1, "key"), argd(c, 2, "amount", Val.Int(1))]));
    }
    if *n == "hincrbyfloat" {
        return Ok(mk("HINCRBYFLOAT", vec![arg(c, 0, "name"), arg(c, 1, "key"), argd(c, 2, "amount", Val.Float(1.0))]));
    }
    if *n == "hset" {
        let key = arg(c, 1, "key");
        let value = arg(c, 2, "value");
        let mapping = arg(c, 3, "mapping");
        let items = arg(c, 4, "items");
        if is_none(key) and not truthy(mapping) and not truthy(items) {
            return Err(data_error("'hset' with no key value pairs"));
        }
        let mut p = vec![arg(c, 0, "name")];
        if truthy(items) {
            extend(mut p, iterate(items)?);
        }
        if not is_none(key) {
            p.push(key);
            p.push(value);
        }
        if truthy(mapping) {
            extend(mut p, pairs_of(mapping)?);
        }
        return Ok(mk("HSET", p));
    }
    if *n == "hsetnx" {
        return Ok(mk("HSETNX", vec![arg(c, 0, "name"), arg(c, 1, "key"), arg(c, 2, "value")]));
    }
    if *n == "hmget" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, list_or_args(arg(c, 1, "keys"), rest(c, 2)));
        return Ok(mk("HMGET", p));
    }
    if *n == "hrandfield" {
        let mut p = vec![arg(c, 0, "key")];
        let count = arg(c, 1, "count");
        if not is_none(count) {
            p.push(count);
        }
        if flag(c, 2, "withvalues") {
            p.push(vs("WITHVALUES"));
        }
        return Ok(mk("HRANDFIELD", p));
    }
    if *n == "hscan" {
        let mut p = vec![arg(c, 0, "name"), argd(c, 1, "cursor", Val.Int(0))];
        let m = arg(c, 2, "match");
        if not is_none(m) {
            p.push(vb("MATCH"));
            p.push(m);
        }
        let count = arg(c, 3, "count");
        if not is_none(count) {
            p.push(vb("COUNT"));
            p.push(count);
        }
        let nv = arg(c, 4, "no_values");
        if not is_none(nv) {
            p.push(vb("NOVALUES"));
        }
        let mut cmd = mk("HSCAN", p);
        cmd.opts.no_values = truthy(nv);
        return Ok(cmd);
    }
    Err(unknown(n))
}

fn zrevrange_cmd(name: own Val, start: own Val, end: own Val, withscores: bool, cast: ref Val) -> Cmd {
    let mut cmd = mk("ZREVRANGE", vec![name, start, end]);
    if withscores {
        cmd.args.push(vb("WITHSCORES"));
    }
    cmd.opts.withscores = withscores;
    cmd.opts.score_cast = cast_name(cast);
    cmd
}

fn float_cls() -> Val {
    Val.Cls("builtins.float".to_string())
}

fn build_zset(n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "zadd" {
        let mapping = arg(c, 1, "mapping");
        let nx = flag(c, 2, "nx");
        let xx = flag(c, 3, "xx");
        let ch = flag(c, 4, "ch");
        let incr = flag(c, 5, "incr");
        let gt = flag(c, 6, "gt");
        let lt = flag(c, 7, "lt");
        if not truthy(mapping) {
            return Err(data_error("ZADD requires at least one element/score pair"));
        }
        if nx and xx {
            return Err(data_error("ZADD allows either 'nx' or 'xx', not both"));
        }
        if gt and lt {
            return Err(data_error("ZADD allows either 'gt' or 'lt', not both"));
        }
        if incr and len_of(mapping) != 1 {
            return Err(data_error("ZADD option 'incr' only works when passing a single element/score pair"));
        }
        if nx and (gt or lt) {
            return Err(data_error("Only one of 'nx', 'lt', or 'gr' may be defined."));
        }
        let mut cmd = mk("ZADD", vec![arg(c, 0, "name")]);
        if nx {
            cmd.args.push(vb("NX"));
        }
        if xx {
            cmd.args.push(vb("XX"));
        }
        if ch {
            cmd.args.push(vb("CH"));
        }
        if incr {
            cmd.args.push(vb("INCR"));
            cmd.opts.as_score = true;
        }
        if gt {
            cmd.args.push(vb("GT"));
        }
        if lt {
            cmd.args.push(vb("LT"));
        }
        let pairs = pairs_of(mapping)?;
        let mut i = 0;
        while i + 1 < pairs.len() {
            cmd.args.push(pairs[i + 1].clone());
            cmd.args.push(pairs[i].clone());
            i += 2;
        }
        return Ok(cmd);
    }
    if *n == "zcard" {
        return Ok(mk("ZCARD", vec![arg(c, 0, "name")]));
    }
    if *n == "zcount" {
        return Ok(mk("ZCOUNT", vec![arg(c, 0, "name"), arg(c, 1, "min"), arg(c, 2, "max")]));
    }
    if *n == "zincrby" {
        return Ok(mk("ZINCRBY", vec![arg(c, 0, "name"), arg(c, 1, "amount"), arg(c, 2, "value")]));
    }
    if *n == "zpopmin" {
        let mut p = vec![arg(c, 0, "name")];
        let count = arg(c, 1, "count");
        if not is_none(count) {
            p.push(count);
        }
        let mut cmd = mk("ZPOPMIN", p);
        cmd.opts.withscores = true;
        return Ok(cmd);
    }
    if *n == "zrange" {
        let name = arg(c, 0, "name");
        let start = arg(c, 1, "start");
        let end = arg(c, 2, "end");
        let desc = flag(c, 3, "desc");
        let withscores = flag(c, 4, "withscores");
        let cast = argd(c, 5, "score_cast_func", float_cls());
        let byscore = flag(c, 6, "byscore");
        let bylex = flag(c, 7, "bylex");
        let offset = arg(c, 8, "offset");
        let num = arg(c, 9, "num");
        if not byscore and not bylex and is_none(offset) and is_none(num) and desc {
            return Ok(zrevrange_cmd(name, start, end, withscores, cast));
        }
        if byscore and bylex {
            return Err(data_error("``byscore`` and ``bylex`` can not be specified together."));
        }
        if (not is_none(offset) and is_none(num)) or (not is_none(num) and is_none(offset)) {
            return Err(data_error("``offset`` and ``num`` must both be specified."));
        }
        if bylex and withscores {
            return Err(data_error("``withscores`` not supported in combination with ``bylex``."));
        }
        let mut cmd = mk("ZRANGE", vec![name, start, end]);
        if byscore {
            cmd.args.push(vs("BYSCORE"));
        }
        if bylex {
            cmd.args.push(vs("BYLEX"));
        }
        if desc {
            cmd.args.push(vs("REV"));
        }
        if not is_none(offset) and not is_none(num) {
            cmd.args.push(vs("LIMIT"));
            cmd.args.push(offset);
            cmd.args.push(num);
        }
        if withscores {
            cmd.args.push(vs("WITHSCORES"));
        }
        cmd.opts.withscores = withscores;
        cmd.opts.score_cast = cast_name(cast);
        return Ok(cmd);
    }
    if *n == "zrevrange" {
        let cast = argd(c, 4, "score_cast_func", float_cls());
        return Ok(zrevrange_cmd(arg(c, 0, "name"), arg(c, 1, "start"), arg(c, 2, "end"), flag(c, 3, "withscores"), cast));
    }
    if *n == "zrangebyscore" {
        let start = arg(c, 3, "start");
        let num = arg(c, 4, "num");
        if (not is_none(start) and is_none(num)) or (not is_none(num) and is_none(start)) {
            return Err(data_error("``start`` and ``num`` must both be specified"));
        }
        let mut cmd = mk("ZRANGEBYSCORE", vec![arg(c, 0, "name"), arg(c, 1, "min"), arg(c, 2, "max")]);
        if not is_none(start) and not is_none(num) {
            cmd.args.push(vs("LIMIT"));
            cmd.args.push(start);
            cmd.args.push(num);
        }
        let withscores = flag(c, 5, "withscores");
        if withscores {
            cmd.args.push(vs("WITHSCORES"));
        }
        cmd.opts.withscores = withscores;
        cmd.opts.score_cast = cast_name(argd(c, 6, "score_cast_func", float_cls()));
        return Ok(cmd);
    }
    if *n == "zrank" {
        if flag(c, 2, "withscore") {
            return Ok(mk("ZRANK", vec![arg(c, 0, "name"), arg(c, 1, "value"), vs("WITHSCORE")]));
        }
        return Ok(mk("ZRANK", vec![arg(c, 0, "name"), arg(c, 1, "value")]));
    }
    if *n == "zrem" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, rest(c, 1));
        return Ok(mk("ZREM", p));
    }
    if *n == "zscore" {
        return Ok(mk("ZSCORE", vec![arg(c, 0, "name"), arg(c, 1, "value")]));
    }
    if *n == "zunionstore" {
        return zaggregate("ZUNIONSTORE", arg(c, 0, "dest"), arg(c, 1, "keys"), arg(c, 2, "aggregate"));
    }
    if *n == "zmscore" {
        let members = arg(c, 1, "members");
        if not truthy(members) {
            return Err(data_error("ZMSCORE members must be a non-empty list"));
        }
        let ms = match members {
            Val.List(xs) => xs.clone(),
            _ => return Err(exc("TypeError", f"can only concatenate list (not \"{type_name(members)}\") to list")),
        };
        let mut p = vec![arg(c, 0, "key")];
        extend(mut p, ms);
        return Ok(mk("ZMSCORE", p));
    }
    if *n == "zscan" {
        let mut p = vec![arg(c, 0, "name"), argd(c, 1, "cursor", Val.Int(0))];
        let m = arg(c, 2, "match");
        if not is_none(m) {
            p.push(vb("MATCH"));
            p.push(m);
        }
        let count = arg(c, 3, "count");
        if not is_none(count) {
            p.push(vb("COUNT"));
            p.push(count);
        }
        let mut cmd = mk("ZSCAN", p);
        cmd.opts.score_cast = cast_name(argd(c, 4, "score_cast_func", float_cls()));
        return Ok(cmd);
    }
    Err(unknown(n))
}

fn zaggregate(command: Str, dest: own Val, keys: own Val, aggregate: own Val) -> Result[Cmd, Exc] {
    let mut p: Vec[Val] = Vec.new();
    if not is_none(dest) {
        p.push(dest);
    }
    p.push(Val.Int(len_of(keys)));
    let mut weights: Vec[Val] = Vec.new();
    if is_dict(keys) {
        extend(mut p, dict_keys(keys));
        weights = dict_vals(keys);
    } else {
        extend(mut p, iterate(keys)?);
    }
    if weights.len() > 0 {
        p.push(vb("WEIGHTS"));
        extend(mut p, weights);
    }
    if truthy(aggregate) {
        let u = str_upper(aggregate)?;
        if u == "SUM" or u == "MIN" or u == "MAX" {
            p.push(vb("AGGREGATE"));
            p.push(aggregate);
        } else {
            return Err(data_error("aggregate can be sum, min or max."));
        }
    }
    Ok(mk(command, p))
}

fn stream_count(p: mut ref Vec[Val], count: ref Val, msg: Str) -> Result[(), Exc] {
    if not is_none(count) {
        if not is_int(count) or int_below1(count) {
            return Err(data_error(msg));
        }
        p.push(vb("COUNT"));
        p.push(str_arg(count));
    }
    Ok(())
}

fn stream_block(p: mut ref Vec[Val], block: ref Val, msg: Str) -> Result[(), Exc] {
    if not is_none(block) {
        if not is_int(block) or int_neg(block) {
            return Err(data_error(msg));
        }
        p.push(vb("BLOCK"));
        p.push(str_arg(block));
    }
    Ok(())
}

fn build_stream(n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "xack" {
        let mut p = vec![arg(c, 0, "name"), arg(c, 1, "groupname")];
        extend(mut p, rest(c, 2));
        return Ok(mk("XACK", p));
    }
    if *n == "xadd" {
        let fields = arg(c, 1, "fields");
        let id = argd(c, 2, "id", vs("*"));
        let maxlen = arg(c, 3, "maxlen");
        let approximate = truthy(argd(c, 4, "approximate", Val.Bool(true)));
        let nomkstream = flag(c, 5, "nomkstream");
        let minid = arg(c, 6, "minid");
        let limit = arg(c, 7, "limit");
        let mut p = vec![arg(c, 0, "name")];
        if not is_none(maxlen) and not is_none(minid) {
            return Err(data_error("Only one of ```maxlen``` or ```minid``` may be specified"));
        }
        if not is_none(maxlen) {
            if not is_int(maxlen) or int_neg(maxlen) {
                return Err(data_error("XADD maxlen must be non-negative integer"));
            }
            p.push(vb("MAXLEN"));
            if approximate {
                p.push(vb("~"));
            }
            p.push(str_arg(maxlen));
        }
        if not is_none(minid) {
            p.push(vb("MINID"));
            if approximate {
                p.push(vb("~"));
            }
            p.push(minid);
        }
        if not is_none(limit) {
            p.push(vb("LIMIT"));
            p.push(limit);
        }
        if nomkstream {
            p.push(vb("NOMKSTREAM"));
        }
        p.push(id);
        if not is_dict(fields) or len_of(fields) == 0 {
            return Err(data_error("XADD fields must be a non-empty dict"));
        }
        extend(mut p, pairs_of(fields)?);
        return Ok(mk("XADD", p));
    }
    if *n == "xautoclaim" {
        let mit = arg(c, 3, "min_idle_time");
        match int_or_skip(mit)? {
            Some(v) => {
                if int_neg(v) {
                    return Err(data_error("XAUTOCLAIM min_idle_time must be a nonnegative integer"));
                }
            }
            None => {}
        }
        let mut cmd = mk("XAUTOCLAIM", vec![arg(c, 0, "name"), arg(c, 1, "groupname"), arg(c, 2, "consumername"), mit, argd(c, 4, "start_id", vs("0-0"))]);
        let count = arg(c, 5, "count");
        match int_or_skip(count)? {
            Some(v) => {
                if int_neg(v) {
                    return Err(data_error("XPENDING count must be a integer >= 0"));
                }
                cmd.args.push(vb("COUNT"));
                cmd.args.push(count);
            }
            None => {}
        }
        if flag(c, 6, "justid") {
            cmd.args.push(vb("JUSTID"));
            cmd.opts.parse_justid = true;
        }
        return Ok(cmd);
    }
    if *n == "xclaim" {
        let mit = arg(c, 3, "min_idle_time");
        if not is_int(mit) or int_neg(mit) {
            return Err(data_error("XCLAIM min_idle_time must be a non negative integer"));
        }
        let ids = arg(c, 4, "message_ids");
        let ok_ids = match ids {
            Val.List(ref xs) => xs.len() > 0,
            Val.Tuple(ref xs) => xs.len() > 0,
            _ => false,
        };
        if not ok_ids {
            return Err(data_error("XCLAIM message_ids must be a non empty list or tuple of message IDs to claim"));
        }
        let mut cmd = mk("XCLAIM", vec![arg(c, 0, "name"), arg(c, 1, "groupname"), arg(c, 2, "consumername"), str_arg(mit)]);
        extend(mut cmd.args, items_of(ids));
        let idle = arg(c, 5, "idle");
        if not is_none(idle) {
            if not is_int(idle) {
                return Err(data_error("XCLAIM idle must be an integer"));
            }
            cmd.args.push(vb("IDLE"));
            cmd.args.push(str_arg(idle));
        }
        let time = arg(c, 6, "time");
        if not is_none(time) {
            if not is_int(time) {
                return Err(data_error("XCLAIM time must be an integer"));
            }
            cmd.args.push(vb("TIME"));
            cmd.args.push(str_arg(time));
        }
        let rc = arg(c, 7, "retrycount");
        if not is_none(rc) {
            if not is_int(rc) {
                return Err(data_error("XCLAIM retrycount must be an integer"));
            }
            cmd.args.push(vb("RETRYCOUNT"));
            cmd.args.push(str_arg(rc));
        }
        let force = arg(c, 8, "force");
        if truthy(force) {
            if not is_bool(force) {
                return Err(data_error("XCLAIM force must be a boolean"));
            }
            cmd.args.push(vb("FORCE"));
        }
        let justid = arg(c, 9, "justid");
        if truthy(justid) {
            if not is_bool(justid) {
                return Err(data_error("XCLAIM justid must be a boolean"));
            }
            cmd.args.push(vb("JUSTID"));
            cmd.opts.parse_justid = true;
        }
        return Ok(cmd);
    }
    if *n == "xdel" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, rest(c, 1));
        return Ok(mk("XDEL", p));
    }
    if *n == "xgroup_create" {
        let mut p = vec![arg(c, 0, "name"), arg(c, 1, "groupname"), argd(c, 2, "id", vs("$"))];
        if flag(c, 3, "mkstream") {
            p.push(vb("MKSTREAM"));
        }
        let er = arg(c, 4, "entries_read");
        if not is_none(er) {
            p.push(vs("ENTRIESREAD"));
            p.push(er);
        }
        return Ok(mk("XGROUP CREATE", p));
    }
    if *n == "xinfo_groups" {
        return Ok(mk("XINFO GROUPS", vec![arg(c, 0, "name")]));
    }
    if *n == "xinfo_stream" {
        let mut cmd = mk("XINFO STREAM", vec![arg(c, 0, "name")]);
        if flag(c, 1, "full") {
            cmd.args.push(vb("FULL"));
            cmd.opts.full = true;
        }
        return Ok(cmd);
    }
    if *n == "xlen" {
        return Ok(mk("XLEN", vec![arg(c, 0, "name")]));
    }
    if *n == "xpending" {
        return Ok(mk("XPENDING", vec![arg(c, 0, "name"), arg(c, 1, "groupname")]));
    }
    if *n == "xpending_range" {
        let min = arg(c, 2, "min");
        let max = arg(c, 3, "max");
        let count = arg(c, 4, "count");
        let consumer = arg(c, 5, "consumername");
        let idle = arg(c, 6, "idle");
        if is_none(min) and is_none(max) and is_none(count) {
            if not is_none(idle) or not is_none(consumer) {
                return Err(data_error("if XPENDING is provided with idle time or consumername, it must be provided with min, max and count parameters"));
            }
            return Ok(mk("XPENDING", vec![arg(c, 0, "name"), arg(c, 1, "groupname")]));
        }
        let mut cmd = mk("XPENDING", vec![arg(c, 0, "name"), arg(c, 1, "groupname")]);
        if is_none(min) or is_none(max) or is_none(count) {
            return Err(data_error("XPENDING must be provided with min, max and count parameters, or none of them."));
        }
        match int_or_skip(idle)? {
            Some(v) => {
                if int_neg(v) {
                    return Err(data_error("XPENDING idle must be a integer >= 0"));
                }
                cmd.args.push(vs("IDLE"));
                cmd.args.push(idle);
            }
            None => {}
        }
        match int_or_skip(count)? {
            Some(v) => {
                if int_neg(v) {
                    return Err(data_error("XPENDING count must be a integer >= 0"));
                }
                cmd.args.push(min);
                cmd.args.push(max);
                cmd.args.push(count);
            }
            None => {}
        }
        if truthy(consumer) {
            cmd.args.push(consumer);
        }
        cmd.opts.parse_detail = true;
        return Ok(cmd);
    }
    if *n == "xrange" {
        let mut p = vec![arg(c, 0, "name"), argd(c, 1, "min", vs("-")), argd(c, 2, "max", vs("+"))];
        stream_count(mut p, arg(c, 3, "count"), "XRANGE count must be a positive integer")?;
        return Ok(mk("XRANGE", p));
    }
    if *n == "xrevrange" {
        let mut p = vec![arg(c, 0, "name"), argd(c, 1, "max", vs("+")), argd(c, 2, "min", vs("-"))];
        stream_count(mut p, arg(c, 3, "count"), "XREVRANGE count must be a positive integer")?;
        return Ok(mk("XREVRANGE", p));
    }
    if *n == "xread" {
        let streams = arg(c, 0, "streams");
        let mut p: Vec[Val] = Vec.new();
        stream_block(mut p, arg(c, 2, "block"), "XREAD block must be a non-negative integer")?;
        stream_count(mut p, arg(c, 1, "count"), "XREAD count must be a positive integer")?;
        if not is_dict(streams) or len_of(streams) == 0 {
            return Err(data_error("XREAD streams must be a non empty dict"));
        }
        p.push(vb("STREAMS"));
        extend(mut p, dict_keys(streams));
        extend(mut p, dict_vals(streams));
        return Ok(mk("XREAD", p));
    }
    if *n == "xreadgroup" {
        let streams = arg(c, 2, "streams");
        let mut p = vec![vb("GROUP"), arg(c, 0, "groupname"), arg(c, 1, "consumername")];
        stream_count(mut p, arg(c, 3, "count"), "XREADGROUP count must be a positive integer")?;
        stream_block(mut p, arg(c, 4, "block"), "XREADGROUP block must be a non-negative integer")?;
        if flag(c, 5, "noack") {
            p.push(vb("NOACK"));
        }
        if not is_dict(streams) or len_of(streams) == 0 {
            return Err(data_error("XREADGROUP streams must be a non empty dict"));
        }
        p.push(vb("STREAMS"));
        extend(mut p, dict_keys(streams));
        extend(mut p, dict_vals(streams));
        return Ok(mk("XREADGROUP", p));
    }
    if *n == "xtrim" {
        let maxlen = arg(c, 1, "maxlen");
        let approximate = truthy(argd(c, 2, "approximate", Val.Bool(true)));
        let minid = arg(c, 3, "minid");
        let limit = arg(c, 4, "limit");
        if not is_none(maxlen) and not is_none(minid) {
            return Err(data_error("Only one of ``maxlen`` or ``minid`` may be specified"));
        }
        if is_none(maxlen) and is_none(minid) {
            return Err(data_error("One of ``maxlen`` or ``minid`` must be specified"));
        }
        let mut p = vec![arg(c, 0, "name")];
        if not is_none(maxlen) {
            p.push(vb("MAXLEN"));
        }
        if not is_none(minid) {
            p.push(vb("MINID"));
        }
        if approximate {
            p.push(vb("~"));
        }
        if not is_none(maxlen) {
            p.push(maxlen);
        }
        if not is_none(minid) {
            p.push(minid);
        }
        if not is_none(limit) {
            p.push(vb("LIMIT"));
            p.push(limit);
        }
        return Ok(mk("XTRIM", p));
    }
    Err(unknown(n))
}

const GEO_UNITS: Str = "m|km|mi|ft";

fn build_geo(n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "geoadd" {
        let values = arg(c, 1, "values");
        let nx = flag(c, 2, "nx");
        let xx = flag(c, 3, "xx");
        if nx and xx {
            return Err(data_error("GEOADD allows either 'nx' or 'xx', not both"));
        }
        if len_of(values) % 3 != 0 {
            return Err(data_error("GEOADD requires places with lon, lat and name values"));
        }
        let mut p = vec![arg(c, 0, "name")];
        if nx {
            p.push(vs("NX"));
        }
        if xx {
            p.push(vs("XX"));
        }
        if flag(c, 4, "ch") {
            p.push(vs("CH"));
        }
        extend(mut p, iterate(values)?);
        return Ok(mk("GEOADD", p));
    }
    if *n == "geodist" {
        let mut p = vec![arg(c, 0, "name"), arg(c, 1, "place1"), arg(c, 2, "place2")];
        let unit = arg(c, 3, "unit");
        if truthy(unit) and not str_in(unit, GEO_UNITS) {
            return Err(data_error("GEODIST invalid unit"));
        } else if truthy(unit) {
            p.push(unit);
        }
        return Ok(mk("GEODIST", p));
    }
    if *n == "geohash" or *n == "geopos" {
        let mut p = vec![arg(c, 0, "name")];
        extend(mut p, rest(c, 1));
        return Ok(mk(if *n == "geohash" { "GEOHASH" } else { "GEOPOS" }, p));
    }
    if *n == "georadius" {
        let unit = arg(c, 4, "unit");
        let withdist = flag(c, 5, "withdist");
        let withcoord = flag(c, 6, "withcoord");
        let withhash = flag(c, 7, "withhash");
        let count = arg(c, 8, "count");
        let sort = arg(c, 9, "sort");
        let store = arg(c, 10, "store");
        let store_dist = arg(c, 11, "store_dist");
        let any = flag(c, 12, "any");
        let mut cmd = mk("GEORADIUS", vec![arg(c, 0, "name"), arg(c, 1, "longitude"), arg(c, 2, "latitude"), arg(c, 3, "radius")]);
        if truthy(unit) and not str_in(unit, GEO_UNITS) {
            return Err(data_error("GEORADIUS invalid unit"));
        } else if truthy(unit) {
            cmd.args.push(unit);
        } else {
            cmd.args.push(vs("m"));
        }
        if any and is_none(count) {
            return Err(data_error("``any`` can't be provided without ``count``"));
        }
        if withdist {
            cmd.args.push(vs("WITHDIST"));
        }
        if withcoord {
            cmd.args.push(vs("WITHCOORD"));
        }
        if withhash {
            cmd.args.push(vs("WITHHASH"));
        }
        if not is_none(count) {
            cmd.args.push(vs("COUNT"));
            cmd.args.push(count);
            if any {
                cmd.args.push(vs("ANY"));
            }
        }
        if truthy(sort) {
            if is_str(sort, "ASC") {
                cmd.args.push(vs("ASC"));
            } else if is_str(sort, "DESC") {
                cmd.args.push(vs("DESC"));
            } else {
                return Err(data_error("GEORADIUS invalid sort"));
            }
        }
        if truthy(store) and truthy(store_dist) {
            return Err(data_error("GEORADIUS store and store_dist cant be set together"));
        }
        if truthy(store) {
            cmd.args.push(vb("STORE"));
            cmd.args.push(store.clone());
        }
        if truthy(store_dist) {
            cmd.args.push(vb("STOREDIST"));
            cmd.args.push(store_dist.clone());
        }
        cmd.opts.geo = true;
        cmd.opts.store = truthy(store);
        cmd.opts.store_dist = truthy(store_dist);
        cmd.opts.withdist = withdist;
        cmd.opts.withcoord = withcoord;
        cmd.opts.withhash = withhash;
        return Ok(cmd);
    }
    if *n == "geosearch" {
        let member = arg(c, 1, "member");
        let lon = arg(c, 2, "longitude");
        let lat = arg(c, 3, "latitude");
        let unit = argd(c, 4, "unit", vs("m"));
        let radius = arg(c, 5, "radius");
        let width = arg(c, 6, "width");
        let height = arg(c, 7, "height");
        let sort = arg(c, 8, "sort");
        let count = arg(c, 9, "count");
        let any = flag(c, 10, "any");
        let withcoord = flag(c, 11, "withcoord");
        let withdist = flag(c, 12, "withdist");
        let withhash = flag(c, 13, "withhash");
        let mut cmd = mk("GEOSEARCH", vec![arg(c, 0, "name")]);
        if is_none(member) {
            if is_none(lon) or is_none(lat) {
                return Err(data_error("GEOSEARCH must have member or longitude and latitude"));
            }
        }
        if truthy(member) {
            if truthy(lon) or truthy(lat) {
                return Err(data_error("GEOSEARCH member and longitude or latitude cant be set together"));
            }
            cmd.args.push(vb("FROMMEMBER"));
            cmd.args.push(member.clone());
        }
        if not is_none(lon) and not is_none(lat) {
            cmd.args.push(vb("FROMLONLAT"));
            cmd.args.push(lon.clone());
            cmd.args.push(lat.clone());
        }
        if is_none(radius) {
            if is_none(width) or is_none(height) {
                return Err(data_error("GEOSEARCH must have radius or width and height"));
            }
        }
        if is_none(unit) {
            return Err(data_error("GEOSEARCH must have unit"));
        }
        if not one_of(str_lower(unit)?, GEO_UNITS) {
            return Err(data_error("GEOSEARCH invalid unit"));
        }
        if truthy(radius) {
            if truthy(width) or truthy(height) {
                return Err(data_error("GEOSEARCH radius and width or height cant be set together"));
            }
            cmd.args.push(vb("BYRADIUS"));
            cmd.args.push(radius.clone());
            cmd.args.push(unit.clone());
        }
        if truthy(width) and truthy(height) {
            cmd.args.push(vb("BYBOX"));
            cmd.args.push(width.clone());
            cmd.args.push(height.clone());
            cmd.args.push(unit.clone());
        }
        if truthy(sort) {
            let u = str_upper(sort)?;
            if u == "ASC" {
                cmd.args.push(vb("ASC"));
            } else if u == "DESC" {
                cmd.args.push(vb("DESC"));
            } else {
                return Err(data_error("GEOSEARCH invalid sort"));
            }
        }
        if truthy(count) {
            cmd.args.push(vb("COUNT"));
            cmd.args.push(count.clone());
            if any {
                cmd.args.push(vb("ANY"));
            }
        } else if any {
            return Err(data_error("GEOSEARCH ``any`` can't be provided without count"));
        }
        if withdist {
            cmd.args.push(vb("WITHDIST"));
        }
        if withcoord {
            cmd.args.push(vb("WITHCOORD"));
        }
        if withhash {
            cmd.args.push(vb("WITHHASH"));
        }
        cmd.opts.geo = true;
        cmd.opts.withdist = withdist;
        cmd.opts.withcoord = withcoord;
        cmd.opts.withhash = withhash;
        return Ok(cmd);
    }
    Err(unknown(n))
}

fn build_server(w: ref World, n: ref String, c: ref Call) -> Result[Cmd, Exc] {
    if *n == "execute_command" {
        let mut cmd = Cmd { args: c.args.clone(), opts: no_opts() };
        cmd.opts.idx = flag(c, -1, "idx");
        cmd.opts.len = flag(c, -1, "len");
        cmd.opts.withmatchlen = flag(c, -1, "withmatchlen");
        return Ok(cmd);
    }
    if *n == "acl_getuser" {
        return Ok(mk("ACL GETUSER", vec![arg(c, 0, "username")]));
    }
    if *n == "acl_log" {
        let count = arg(c, 0, "count");
        let mut p: Vec[Val] = Vec.new();
        if not is_none(count) {
            if not is_int(count) {
                return Err(data_error("ACL LOG count must be an integer"));
            }
            p.push(count);
        }
        return Ok(mk("ACL LOG", p));
    }
    if *n == "client_kill_filter" {
        let mut p: Vec[Val] = Vec.new();
        let t = arg(c, 1, "_type");
        if not is_none(t) {
            if not one_of(lower(py_str(t)), "normal|master|slave|pubsub") {
                return Err(data_error("CLIENT KILL type must be one of ('normal', 'master', 'slave', 'pubsub')"));
            }
            p.push(vb("TYPE"));
            p.push(t);
        }
        let skipme = arg(c, 3, "skipme");
        if not is_none(skipme) {
            if not is_bool(skipme) {
                return Err(data_error("CLIENT KILL skipme must be a bool"));
            }
            p.push(vb("SKIPME"));
            p.push(if truthy(skipme) { vb("YES") } else { vb("NO") });
        }
        let names = vec!["_id", "addr", "laddr", "user", "maxage"];
        let words = vec!["ID", "ADDR", "LADDR", "USER", "MAXAGE"];
        let places = vec![0, 2, 4, 5, 6];
        for k in 0..names.len() {
            let v = arg(c, places[k], names[k]);
            if not is_none(v) {
                p.push(vb(words[k]));
                p.push(v);
            }
        }
        if p.len() == 0 {
            return Err(data_error("CLIENT KILL <filter> <value> ... ... <filter> <value> must specify at least one filter"));
        }
        return Ok(mk("CLIENT KILL", p));
    }
    if *n == "client_info" {
        return Ok(mk("CLIENT INFO", Vec.new()));
    }
    if *n == "client_list" {
        let mut p: Vec[Val] = Vec.new();
        let t = arg(c, 0, "_type");
        if not is_none(t) {
            if not one_of(lower(py_str(t)), "normal|master|replica|pubsub") {
                return Err(data_error("CLIENT LIST _type must be one of ('normal', 'master', 'replica', 'pubsub')"));
            }
            p.push(vb("TYPE"));
            p.push(t);
        }
        let ids = argd(c, 1, "client_id", Val.List(Vec.new()));
        if not is_list(ids) {
            return Err(data_error("client_id must be a list"));
        }
        if truthy(ids) {
            p.push(vb("ID"));
            let mut joined = String.new();
            let xs = items_of(ids);
            for i in 0..xs.len() {
                if i > 0 {
                    joined.push(' ');
                }
                match xs[i].clone() {
                    Val.Str(s) => joined.push_str(s),
                    other => return Err(exc("TypeError", f"sequence item {i}: expected str instance, {type_name(other)} found")),
                }
            }
            p.push(Val.Str(joined));
        }
        return Ok(mk("CLIENT LIST", p));
    }
    if *n == "client_getname" {
        return Ok(mk("CLIENT GETNAME", Vec.new()));
    }
    if *n == "client_setname" {
        return Ok(mk("CLIENT SETNAME", vec![arg(c, 0, "name")]));
    }
    if *n == "config_get" {
        let mut p = vec![argd(c, 0, "pattern", vs("*"))];
        extend(mut p, rest(c, 1));
        return Ok(mk("CONFIG GET", p));
    }
    if *n == "config_set" {
        let mut p = vec![arg(c, 0, "name"), arg(c, 1, "value")];
        extend(mut p, rest(c, 2));
        return Ok(mk("CONFIG SET", p));
    }
    if *n == "dbsize" {
        return Ok(mk("DBSIZE", Vec.new()));
    }
    if *n == "debug_object" {
        return Ok(mk("DEBUG OBJECT", vec![arg(c, 0, "key")]));
    }
    if *n == "echo" {
        return Ok(mk("ECHO", vec![arg(c, 0, "value")]));
    }
    if *n == "flushdb" {
        let mut p: Vec[Val] = Vec.new();
        if flag(c, 0, "asynchronous") {
            p.push(vb("ASYNC"));
        }
        return Ok(mk("FLUSHDB", p));
    }
    if *n == "swapdb" {
        return Ok(mk("SWAPDB", vec![arg(c, 0, "first"), arg(c, 1, "second")]));
    }
    if *n == "info" {
        let section = arg(c, 0, "section");
        if is_none(section) {
            return Ok(mk("INFO", Vec.new()));
        }
        let mut p = vec![section];
        extend(mut p, rest(c, 1));
        return Ok(mk("INFO", p));
    }
    if *n == "memory_stats" {
        return Ok(mk("MEMORY STATS", Vec.new()));
    }
    if *n == "ping" {
        return Ok(mk("PING", Vec.new()));
    }
    if *n == "slowlog_get" {
        let mut p: Vec[Val] = Vec.new();
        let num = arg(c, 0, "num");
        if not is_none(num) {
            p.push(num);
        }
        let mut cmd = mk("SLOWLOG GET", p);
        if w.cfg.decode {
            cmd.opts.never_decode = true;
        }
        return Ok(cmd);
    }
    if *n == "time" {
        return Ok(mk("TIME", Vec.new()));
    }
    if *n == "module_list" {
        return Ok(mk("MODULE LIST", Vec.new()));
    }
    if *n == "sentinel_get_master_addr_by_name" {
        return Ok(mk("SENTINEL GET-MASTER-ADDR-BY-NAME", vec![arg(c, 0, "service_name")]));
    }
    if *n == "publish" {
        return Ok(mk("PUBLISH", vec![arg(c, 0, "channel"), arg(c, 1, "message")]));
    }
    if *n == "pubsub_channels" {
        return Ok(mk("PUBSUB CHANNELS", vec![argd(c, 0, "pattern", vs("*"))]));
    }
    if *n == "pubsub_numsub" {
        return Ok(mk("PUBSUB NUMSUB", rest(c, 0)));
    }
    if *n == "eval" or *n == "evalsha" {
        let mut p = vec![arg(c, 0, "script"), arg(c, 1, "numkeys")];
        extend(mut p, rest(c, 2));
        return Ok(mk(if *n == "eval" { "EVAL" } else { "EVALSHA" }, p));
    }
    if *n == "script_exists" {
        return Ok(mk("SCRIPT EXISTS", rest(c, 0)));
    }
    if *n == "script_load" {
        return Ok(mk("SCRIPT LOAD", vec![arg(c, 0, "script")]));
    }
    Err(unknown(n))
}

// ------------------------------------------------------------ the client

// What a pipeline method returns when it queues the command: the pipeline
// itself, which the job prints as "queued".
const PIPELINE_CLS: Str = "redis.client.Pipeline";

fn queued() -> Val {
    Val.Cls(PIPELINE_CLS.to_string())
}

fn is_queued(v: ref Val) -> bool {
    match v {
        Val.Cls(s) => s == PIPELINE_CLS,
        _ => false,
    }
}

// Retry's supported errors, and the ones the connection retries on.
fn supported(e: ref Exc) -> bool {
    is_a(e, "ConnectionError") or is_a(e, "TimeoutError")
}

fn retry_on(w: ref World, e: ref Exc) -> bool {
    w.cfg.retry_on_timeout and is_a(e, "TimeoutError")
}

fn retries(w: ref World) -> i64 {
    if w.cfg.retry_on_timeout { 1 } else { 0 }
}

// Redis.parse_response(): read the reply, then run the command's callback.
fn parse_reply(w: mut ref World, ci: i64, cmd: ref Cmd) -> Result[Val, Exc] {
    let r = match read_response(mut w, ci, cmd.opts.never_decode) {
        Ok(v) => v,
        Err(e) => {
            if cmd.opts.empty_response and is_a(e, "ResponseError") {
                return Ok(Val.List(Vec.new()));
            }
            return Err(e);
        }
    };
    run_callback(w, cmd.args[0], r, cmd.opts)
}

fn send_parse(w: mut ref World, ci: i64, cmd: ref Cmd) -> Result[Val, Exc] {
    send_command(mut w, ci, cmd.args)?;
    parse_reply(mut w, ci, cmd)
}

fn with_retry(w: mut ref World, ci: i64, cmd: ref Cmd) -> Result[Val, Exc] {
    let mut failures = 0;
    loop {
        match send_parse(mut w, ci, cmd) {
            Ok(v) => return Ok(v),
            Err(e) => {
                if not supported(e) {
                    return Err(e);
                }
                failures += 1;
                disconnect(mut w, ci);
                if not retry_on(w, e) {
                    return Err(e);
                }
                if failures > retries(w) {
                    return Err(e);
                }
            }
        }
    }
}

// Redis._execute_command(): a connection from the pool for one command,
// with the retry around sending it and parsing the reply.
fn client_exec(w: mut ref World, cmd: ref Cmd) -> Result[Val, Exc] {
    let ci = get_connection(mut w)?;
    let r = with_retry(mut w, ci, cmd);
    release(mut w, ci);
    r
}

fn exec_cmd(w: mut ref World, cmd: own Cmd) -> Result[Val, Exc] {
    if w.piping {
        pipe_exec_command(mut w, cmd)
    } else {
        client_exec(mut w, cmd)
    }
}

// ------------------------------------------------------------ the pipeline

// Pipeline.parse_response(): Redis's, then the WATCH state.
fn pipe_parse(w: mut ref World, ci: i64, cmd: ref Cmd) -> Result[Val, Exc] {
    let r = parse_reply(mut w, ci, cmd)?;
    match cmd.args[0].clone() {
        Val.Str(s) => {
            if one_of(s, "DISCARD|EXEC|UNWATCH") {
                w.pipe.watching = false;
            } else if s == "WATCH" {
                w.pipe.watching = true;
            }
        }
        _ => {}
    }
    Ok(r)
}

fn watch_lost() -> Exc {
    exc("WatchError", "A ConnectionError occurred on while watching one or more keys".to_string())
}

fn pipe_exec_command(w: mut ref World, cmd: own Cmd) -> Result[Val, Exc] {
    if (w.pipe.watching or is_str(cmd.args[0], "WATCH")) and not w.pipe.explicit {
        return immediate(mut w, cmd);
    }
    w.pipe.stack.push(cmd);
    Ok(queued())
}

// Pipeline.immediate_execute_command(): while WATCHing, commands run at
// once on the pipeline's connection.
fn immediate(w: mut ref World, cmd: ref Cmd) -> Result[Val, Exc] {
    if w.pipe.conn < 0 {
        let got = get_connection(mut w)?;
        w.pipe.conn = got;
    }
    let ci = w.pipe.conn;
    let mut failures = 0;
    loop {
        let attempt = match send_command(mut w, ci, cmd.args) {
            Ok(_) => pipe_parse(mut w, ci, cmd),
            Err(e) => Err(e),
        };
        match attempt {
            Ok(v) => return Ok(v),
            Err(e) => {
                if not supported(e) {
                    return Err(e);
                }
                failures += 1;
                disconnect(mut w, ci);
                if w.pipe.watching {
                    pipe_reset(mut w)?;
                    return Err(watch_lost());
                }
                if not retry_on(w, e) {
                    pipe_reset(mut w)?;
                    return Err(e);
                }
                if failures > retries(w) {
                    return Err(e);
                }
            }
        }
    }
}

// Pipeline.reset(): UNWATCH if watching, then give the connection back.
fn pipe_reset(w: mut ref World) -> Result[(), Exc] {
    w.pipe.stack = Vec.new();
    if w.pipe.watching and w.pipe.conn >= 0 {
        let ci = w.pipe.conn;
        let r = match send_command(mut w, ci, vec![vs("UNWATCH")]) {
            Ok(_) => read_response(mut w, ci, false),
            Err(e) => Err(e),
        };
        match r {
            Ok(_) => {}
            Err(e) => {
                if is_a(e, "ConnectionError") {
                    disconnect(mut w, ci);
                } else {
                    return Err(e);
                }
            }
        }
    }
    w.pipe.watching = false;
    w.pipe.explicit = false;
    if w.pipe.conn >= 0 {
        let ci = w.pipe.conn;
        release(mut w, ci);
        w.pipe.conn = -1;
    }
    Ok(())
}

fn pipe_multi(w: mut ref World) -> Result[Val, Exc] {
    if w.pipe.explicit {
        return Err(exc("RedisError", "Cannot issue nested calls to MULTI".to_string()));
    }
    if w.pipe.stack.len() > 0 {
        return Err(exc("RedisError", "Commands without an initial WATCH have already been issued".to_string()));
    }
    w.pipe.explicit = true;
    Ok(Val.Non)
}

fn pipe_watch(w: mut ref World, names: own Vec[Val]) -> Result[Val, Exc] {
    if w.pipe.explicit {
        return Err(exc("RedisError", "Cannot issue a WATCH after a MULTI".to_string()));
    }
    pipe_exec_command(mut w, mk("WATCH", names))
}

fn pipe_unwatch(w: mut ref World) -> Result[Val, Exc] {
    if not w.pipe.watching {
        return Ok(Val.Bool(true));
    }
    let r = pipe_exec_command(mut w, mk("UNWATCH", Vec.new()))?;
    if truthy(r) {
        Ok(r)
    } else {
        Ok(Val.Bool(true))
    }
}

fn exc_of(v: ref Val) -> Exc {
    match v {
        Val.Err(cls, msg) => Exc { cls: cls.clone(), msg: msg.clone() },
        _ => exc("TypeError", "exceptions must derive from BaseException".to_string()),
    }
}

// Pipeline.annotate_exception().
fn annotate(e: ref Exc, number: i64, args: ref Vec[Val]) -> Exc {
    let mut cmd = String.new();
    for i in 0..args.len() {
        if i > 0 {
            cmd.push(' ');
        }
        cmd.push_str(text_of(args[i]));
    }
    Exc { cls: e.cls.clone(), msg: f"Command # {number} ({cmd}) of pipeline caused error: {e.msg}" }
}

fn is_response_error(v: ref Val) -> bool {
    match v {
        Val.Err(cls, msg) => is_a(Exc { cls: cls.clone(), msg: msg.clone() }, "ResponseError"),
        _ => false,
    }
}

fn raise_first_error(cmds: ref Vec[Cmd], response: ref Vec[Val]) -> Result[(), Exc] {
    for i in 0..response.len() {
        if is_response_error(response[i]) {
            return Err(annotate(exc_of(response[i]), i + 1, cmds[i].args));
        }
    }
    Ok(())
}

fn blank_cmd() -> Cmd {
    Cmd { args: vec![vs("_")], opts: no_opts() }
}

// Pipeline._execute_transaction(): MULTI, the commands and EXEC in one
// write, then their replies.
fn exec_transaction(w: mut ref World, ci: i64, cmds: ref Vec[Cmd], raise_on_error: bool) -> Result[Val, Exc] {
    let mut all: Vec[Vec[Val]] = vec![vec![vs("MULTI")]];
    for c in cmds {
        if not c.opts.empty_response {
            all.push(c.args.clone());
        }
    }
    all.push(vec![vs("EXEC")]);
    let packed = pack_commands(all)?;
    send_packed(mut w, ci, packed)?;
    let blank = blank_cmd();
    let mut err_at: Vec[i64] = Vec.new();
    let mut err_val: Vec[Val] = Vec.new();
    match pipe_parse(mut w, ci, blank) {
        Ok(_) => {}
        Err(e) => {
            if is_a(e, "ResponseError") {
                err_at.push(0);
                err_val.push(vexc(e));
            } else {
                return Err(e);
            }
        }
    }
    for i in 0..cmds.len() {
        if cmds[i].opts.empty_response {
            err_at.push(i);
            err_val.push(Val.List(Vec.new()));
        } else {
            match pipe_parse(mut w, ci, blank) {
                Ok(_) => {}
                Err(e) => {
                    if is_a(e, "ResponseError") {
                        let a = annotate(e, i + 1, cmds[i].args);
                        err_at.push(i);
                        err_val.push(vexc(a));
                    } else {
                        return Err(e);
                    }
                }
            }
        }
    }
    let response = match pipe_parse(mut w, ci, blank) {
        Ok(v) => v,
        Err(e) => {
            if e.cls == "ExecAbortError" and err_at.len() > 0 {
                return Err(exc_of(err_val[0]));
            }
            return Err(e);
        }
    };
    w.pipe.watching = false;
    if is_none(response) {
        return Err(exc("WatchError", "Watched variable changed.".to_string()));
    }
    let mut items = match response {
        Val.List(xs) => xs,
        other => {
            if err_at.len() > 0 {
                return Err(no_attr(other, "insert"));
            }
            return Err(exc("TypeError", f"object of type '{type_name(other)}' has no len()"));
        }
    };
    for k in 0..err_at.len() {
        let at = if err_at[k] > items.len() { items.len() } else { err_at[k] };
        items.insert(at, err_val[k].clone());
    }
    if items.len() != cmds.len() {
        disconnect(mut w, ci);
        return Err(exc("ResponseError", "Wrong number of response items from pipeline execution".to_string()));
    }
    if raise_on_error {
        raise_first_error(cmds, items)?;
    }
    let mut data: Vec[Val] = Vec.new();
    for i in 0..items.len() {
        let r = items[i].clone();
        if is_exc(r) {
            data.push(r);
        } else {
            data.push(run_callback(w, cmds[i].args[0], r, cmds[i].opts)?);
        }
    }
    Ok(Val.List(data))
}

// Pipeline._execute_pipeline(): the commands in one write, then each
// reply parsed with its own options.
fn exec_pipeline(w: mut ref World, ci: i64, cmds: ref Vec[Cmd], raise_on_error: bool) -> Result[Val, Exc] {
    let mut all: Vec[Vec[Val]] = Vec.new();
    for c in cmds {
        all.push(c.args.clone());
    }
    let packed = pack_commands(all)?;
    send_packed(mut w, ci, packed)?;
    let mut response: Vec[Val] = Vec.new();
    for c in cmds {
        match pipe_parse(mut w, ci, c) {
            Ok(v) => response.push(v),
            Err(e) => {
                if is_a(e, "ResponseError") {
                    response.push(vexc(e));
                } else {
                    return Err(e);
                }
            }
        }
    }
    if raise_on_error {
        raise_first_error(cmds, response)?;
    }
    Ok(Val.List(response))
}

fn execute_retry(w: mut ref World, ci: i64, cmds: ref Vec[Cmd], txn: bool, raise_on_error: bool) -> Result[Val, Exc] {
    let mut failures = 0;
    loop {
        let attempt = if txn {
            exec_transaction(mut w, ci, cmds, raise_on_error)
        } else {
            exec_pipeline(mut w, ci, cmds, raise_on_error)
        };
        match attempt {
            Ok(v) => return Ok(v),
            Err(e) => {
                if not supported(e) {
                    return Err(e);
                }
                failures += 1;
                disconnect(mut w, ci);
                if w.pipe.watching {
                    return Err(watch_lost());
                }
                if not retry_on(w, e) {
                    pipe_reset(mut w)?;
                    return Err(e);
                }
                if failures > retries(w) {
                    return Err(e);
                }
            }
        }
    }
}

// Pipeline.execute(): the stack as a transaction or a plain pipeline,
// and a reset whatever happens.
fn pipe_execute(w: mut ref World, raise_on_error: bool) -> Result[Val, Exc] {
    let stack = w.pipe.stack.clone();
    if stack.len() == 0 and not w.pipe.watching {
        return Ok(Val.List(Vec.new()));
    }
    let txn = w.pipe.transaction or w.pipe.explicit;
    if w.pipe.conn < 0 {
        let got = get_connection(mut w)?;
        w.pipe.conn = got;
    }
    let ci = w.pipe.conn;
    let r = execute_retry(mut w, ci, stack, txn, raise_on_error);
    match pipe_reset(mut w) {
        Ok(_) => r,
        Err(e) => Err(e),
    }
}

// ------------------------------------------------------------ BITFIELD

// A BitFieldOperation: the operations so far and the last OVERFLOW.
struct Bitfield {
    key: Val,
    default_overflow: Val,
    ops: Vec[Val],
    last: Val,
}

fn bf_overflow(b: mut ref Bitfield, overflow: ref Val) -> Result[(), Exc] {
    let o = vstr(str_upper(overflow)?);
    if not py_eq(o, b.last) {
        b.last = o.clone();
        b.ops.push(vs("OVERFLOW"));
        b.ops.push(o);
    }
    Ok(())
}

fn bf_reset(b: mut ref Bitfield) -> Result[(), Exc] {
    b.ops = Vec.new();
    b.last = vs("WRAP");
    let o = if truthy(b.default_overflow) { b.default_overflow.clone() } else { b.last.clone() };
    bf_overflow(mut b, o)
}

fn bf_command(b: ref Bitfield) -> Vec[Val] {
    let mut cmd = vec![vs("BITFIELD"), b.key.clone()];
    extend(mut cmd, b.ops);
    cmd
}

// ------------------------------------------------------------ parse_url()

fn hex_digit(b: u8) -> i64 {
    if b >= b'0' and b <= b'9' {
        (b - b'0') as i64
    } else if b >= b'a' and b <= b'f' {
        (b - b'a') as i64 + 10
    } else if b >= b'A' and b <= b'F' {
        (b - b'A') as i64 + 10
    } else {
        -1
    }
}

// urllib.parse.unquote(): %XX escapes, decoded as UTF-8 with errors
// replaced.
fn unquote(s: ref String) -> String {
    if not s.contains("%") {
        return s.clone();
    }
    let b = bytes_of(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'%' and i + 2 < b.len() and hex_digit(b[i + 1]) >= 0 and hex_digit(b[i + 2]) >= 0 {
            out.push((hex_digit(b[i + 1]) * 16 + hex_digit(b[i + 2])) as u8);
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    decode_replace(out)
}

fn plus_to_space(s: ref String) -> String {
    let mut out = String.new();
    for ch in s.chars() {
        out.push(if ch == '+' { ' ' } else { ch });
    }
    out
}

// The parts urlsplit() gives a URL.
struct SplitUrl {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
}

fn find_char(cs: ref Vec[char], from: i64, set: Str) -> i64 {
    let mut i = from;
    while i < cs.len() {
        for x in set.chars() {
            if cs[i] == x {
                return i;
            }
        }
        i += 1;
    }
    -1
}

fn urlsplit(url: ref String) -> Result[SplitUrl, Exc] {
    let mut cs = chars_of(url);
    let mut scheme = String.new();
    let colon = find_char(cs, 0, ":");
    if colon > 0 {
        let mut ok = true;
        for i in 0..colon {
            let ch = cs[i];
            let alpha = (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z');
            if i == 0 and not alpha {
                ok = false;
            }
            if not alpha and not (ch >= '0' and ch <= '9') and ch != '+' and ch != '-' and ch != '.' {
                ok = false;
            }
        }
        if ok {
            scheme = lower(str_of(cs, 0, colon));
            cs = chars_of(str_of(cs, colon + 1, cs.len()));
        }
    }
    let mut netloc = String.new();
    let mut start = 0;
    if cs.len() >= 2 and cs[0] == '/' and cs[1] == '/' {
        let end = find_char(cs, 2, "/?#");
        let e = if end < 0 { cs.len() } else { end };
        netloc = str_of(cs, 2, e);
        start = e;
        let open = netloc.contains("[");
        let close = netloc.contains("]");
        if (open and not close) or (close and not open) {
            return Err(exc("ValueError", "Invalid IPv6 URL".to_string()));
        }
    }
    let mut rest = str_of(cs, start, cs.len());
    if rest.contains("#") {
        rest = split_once(rest, "#")[0].clone();
    }
    let mut query = String.new();
    if rest.contains("?") {
        let parts = split_once(rest, "?");
        query = parts[1].clone();
        rest = parts[0].clone();
    }
    Ok(SplitUrl { scheme: scheme, netloc: netloc, path: rest, query: query })
}

// str.partition(sep) and str.rpartition(sep).
fn partition(s: ref String, sep: Str) -> (String, bool, String) {
    let parts = split_once(s, sep);
    if parts.len() == 2 {
        (parts[0].clone(), true, parts[1].clone())
    } else {
        (s.clone(), false, String.new())
    }
}

fn rpartition(s: ref String, sep: Str) -> (String, bool, String) {
    let parts = rsplit_once(s, sep);
    if parts.len() == 2 {
        (parts[0].clone(), true, parts[1].clone())
    } else {
        (String.new(), false, s.clone())
    }
}

// SplitResult.username and .password.
fn userinfo(u: ref SplitUrl) -> (Val, Val) {
    let (info, have_info, _) = rpartition(u.netloc, "@");
    if not have_info {
        return (Val.Non, Val.Non);
    }
    let (user, have_pass, pass) = partition(info, ":");
    (Val.Str(user), if have_pass { Val.Str(pass) } else { Val.Non })
}

// SplitResult._hostinfo: the host and the port text.
fn hostinfo(u: ref SplitUrl) -> (String, String) {
    let (_, _, host) = rpartition(u.netloc, "@");
    let (_, have_open, bracketed) = partition(host, "[");
    if have_open {
        let (hostname, _, after) = partition(bracketed, "]");
        let (_, _, port) = partition(after, ":");
        (hostname, port)
    } else {
        let (hostname, _, port) = partition(host, ":");
        (hostname, port)
    }
}

// SplitResult.port.
fn url_port(u: ref SplitUrl) -> Result[Val, Exc] {
    let (_, port) = hostinfo(u);
    if port.len() == 0 {
        return Ok(Val.Non);
    }
    if not is_digits(port) {
        return Err(exc("ValueError", f"Port could not be cast to integer value as {str_repr(port)}"));
    }
    let mut n: i64 = 0;
    for ch in port.chars() {
        n = n * 10 + (ch as i64 - 48);
        if n > 1000000 {
            n = 1000000;
        }
    }
    if n > 65535 {
        return Err(exc("ValueError", "Port out of range 0-65535".to_string()));
    }
    Ok(Val.Int(n))
}

const FALSE_STRINGS: Str = "0|F|FALSE|N|NO";

fn to_bool(value: ref String) -> Val {
    if value.len() == 0 {
        return Val.Non;
    }
    if one_of(upper(value), FALSE_STRINGS) {
        return Val.Bool(false);
    }
    Val.Bool(true)
}

// URL_QUERY_ARGUMENT_PARSERS: the parsed value, None when the parser
// raises, or the text itself for a name without a parser.
fn query_value(name: ref String, value: ref String) -> Result[Val, Exc] {
    let bad = exc("ValueError", f"Invalid value for '{name}' in connection URL.");
    if one_of(name, "db|max_connections|health_check_interval") {
        return match int_text(value) {
            Some(v) => Ok(v),
            None => Err(bad),
        };
    }
    if one_of(name, "socket_timeout|socket_connect_timeout|timeout") {
        return match float_text(value) {
            Some(x) => Ok(Val.Float(x)),
            None => Err(bad),
        };
    }
    if one_of(name, "socket_keepalive|retry_on_timeout|ssl_check_hostname") {
        return Ok(to_bool(value));
    }
    if *name == "retry_on_error" {
        let mut out: Vec[Val] = Vec.new();
        for ch in value.chars() {
            let mut t = String.new();
            t.push(ch);
            out.push(Val.Str(t));
        }
        return Ok(Val.List(out));
    }
    Ok(Val.Str(value.clone()))
}

// redis.connection.parse_url().
fn parse_url(url: ref String) -> Result[Val, Exc] {
    if not (url.starts_with("redis://") or url.starts_with("rediss://") or url.starts_with("unix://")) {
        return Err(exc("ValueError", "Redis URL must specify one of the following schemes (redis://, rediss://, unix://)".to_string()));
    }
    let u = urlsplit(url)?;
    let mut kwargs = new_dict();
    // parse_qs(): blank values dropped, the first value of each name kept
    let mut names: Vec[String] = Vec.new();
    let mut firsts: Vec[String] = Vec.new();
    for part in split_str(u.query, "&") {
        if part.len() == 0 {
            continue;
        }
        let nv = split_once(part, "=");
        if nv.len() != 2 or nv[1].len() == 0 {
            continue;
        }
        let name = unquote(plus_to_space(nv[0]));
        let value = unquote(plus_to_space(nv[1]));
        let mut seen = false;
        for x in names {
            if x == name {
                seen = true;
            }
        }
        if not seen {
            names.push(name);
            firsts.push(value);
        }
    }
    for i in 0..names.len() {
        let value = unquote(firsts[i]);
        let v = query_value(names[i], value)?;
        dset(mut kwargs, Val.Str(names[i].clone()), v);
    }
    let (user, pass) = userinfo(u);
    if truthy(user) {
        dset(mut kwargs, vs("username"), Val.Str(unquote(text_of(user))));
    }
    if truthy(pass) {
        dset(mut kwargs, vs("password"), Val.Str(unquote(text_of(pass))));
    }
    if u.scheme == "unix" {
        if u.path.len() > 0 {
            dset(mut kwargs, vs("path"), Val.Str(unquote(u.path)));
        }
        dset(mut kwargs, vs("connection_class"), Val.Cls("redis.connection.UnixDomainSocketConnection".to_string()));
    } else {
        let (host, _) = hostinfo(u);
        if host.len() > 0 {
            dset(mut kwargs, vs("host"), Val.Str(unquote(lower(host))));
        }
        let port = url_port(u)?;
        if truthy(port) {
            dset(mut kwargs, vs("port"), port);
        }
        if u.path.len() > 0 and not dict_has(kwargs, "db") {
            let mut digits = String.new();
            for ch in unquote(u.path).chars() {
                if ch != '/' {
                    digits.push(ch);
                }
            }
            match int_text(digits) {
                Some(v) => dset(mut kwargs, vs("db"), v),
                None => {}
            }
        }
        if u.scheme == "rediss" {
            dset(mut kwargs, vs("connection_class"), Val.Cls("redis.connection.SSLConnection".to_string()));
        }
    }
    Ok(kwargs)
}

// ------------------------------------------------------------ the job language

// Undoes gen_kara.py's escapes of the characters a string literal treats
// specially.
fn unesc(s: ref String) -> String {
    let cs = chars_of(s);
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < cs.len() {
        if cs[i] == '~' and i + 1 < cs.len() {
            let c = cs[i + 1];
            out.push(if c == 't' { '~' } else if c == 'b' { '\\' } else if c == 'q' { '"' } else if c == 'o' { '{' } else { '}' });
            i += 2;
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

// A job token's %XX escapes.
fn unescape(text: ref String) -> Vec[u8] {
    let raw = bytes_of(text);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < raw.len() {
        if raw[i] == b'%' and i + 2 < raw.len() {
            out.push((hex_digit(raw[i + 1]) * 16 + hex_digit(raw[i + 2])) as u8);
            i += 3;
        } else {
            out.push(raw[i]);
            i += 1;
        }
    }
    out
}

fn unescape_str(text: ref String) -> String {
    match decode_strict(unescape(text)) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

fn parse_tokens(toks: ref Vec[String], from: i64, stop: Str) -> (Vec[Val], i64) {
    let mut vals: Vec[Val] = Vec.new();
    let mut i = from;
    while i < toks.len() and toks[i] != stop {
        let (v, j) = parse_value(toks, i);
        vals.push(v);
        i = j;
    }
    (vals, i + 1)
}

fn parse_value(toks: ref Vec[String], i: i64) -> (Val, i64) {
    let t = toks[i].clone();
    if t == "[" {
        let (vals, j) = parse_tokens(toks, i + 1, "]");
        return (Val.List(vals), j);
    }
    if t == "(" {
        let (vals, j) = parse_tokens(toks, i + 1, ")");
        return (Val.Tuple(vals), j);
    }
    if t == "{" {
        let (vals, j) = parse_tokens(toks, i + 1, "}");
        let mut d = new_dict();
        let mut k = 0;
        while k + 1 < vals.len() {
            dset(mut d, vals[k].clone(), vals[k + 1].clone());
            k += 2;
        }
        return (d, j);
    }
    let cs = chars_of(t);
    let kind = cs[0];
    let payload = str_of(cs, 2, cs.len());
    let v = if kind == 's' {
        Val.Str(unescape_str(payload))
    } else if kind == 'b' {
        Val.Bytes(unescape(payload))
    } else if kind == 'i' {
        int_text(payload).unwrap_or(Val.Non)
    } else if kind == 'f' {
        Val.Float(float_text(payload).unwrap_or(0.0))
    } else if kind == 'N' {
        Val.Non
    } else if kind == 'T' {
        Val.Bool(true)
    } else if kind == 'F' {
        Val.Bool(false)
    } else if kind == 'r' {
        let parts = rsplit_once(payload, "*");
        let unit = unescape_str(parts[0]);
        let times = match int_text(parts[1]) {
            Some(Val.Int(n)) => n,
            _ => 0,
        };
        let mut s = String.new();
        for _ in 0..times {
            s.push_str(unit);
        }
        Val.Str(s)
    } else {
        Val.Cls(f"builtins.{payload}")
    };
    (v, i + 1)
}

// parse_args(): positional values, and name=value keyword ones.
fn parse_args(toks: ref Vec[String]) -> Call {
    let mut c = Call { args: Vec.new(), kn: Vec.new(), kv: Vec.new() };
    let mut i = 0;
    while i < toks.len() {
        let cs = chars_of(toks[i]);
        let eq = find_char(cs, 0, "=");
        if eq > 0 and cs[1] != ':' {
            let name = str_of(cs, 0, eq);
            let mut sub = vec![str_of(cs, eq + 1, cs.len())];
            let mut k = i + 1;
            while k < toks.len() {
                sub.push(toks[k].clone());
                k += 1;
            }
            let (v, j) = parse_value(sub, 0);
            c.kn.push(name);
            c.kv.push(v);
            i = i + j;
        } else {
            let (v, j) = parse_value(toks, i);
            c.args.push(v);
            i = j;
        }
    }
    c
}

fn kwarg(c: ref Call, name: Str, d: own Val) -> Val {
    argd(c, -1, name, d)
}

fn join_from(toks: ref Vec[String], from: i64) -> String {
    let mut out = String.new();
    let mut i = from;
    while i < toks.len() {
        if i > from {
            out.push(' ');
        }
        out.push_str(toks[i]);
        i += 1;
    }
    out
}

const LIMIT: i64 = 400;

fn outcome(w: mut ref World, r: own Result[Val, Exc]) {
    match r {
        Ok(v) => {
            if is_queued(v) {
                emit(mut w, "= queued".to_string());
            } else {
                let body = show(v);
                let n = body.chars().count() as i64 + 2;
                if n > LIMIT {
                    let h = fnv(bytes_of(body));
                    let k = n - 2;
                    emit(mut w, f"= <{k} chars, fnv {h:08x}>");
                } else {
                    emit(mut w, f"= {body}");
                }
            }
        }
        Err(e) => emit(mut w, f"! {e.cls}: {e.msg}"),
    }
}

fn make_cfg(c: ref Call) -> Cfg {
    let mut cfg = default_cfg();
    cfg.protocol = int_val(kwarg(c, "proto", Val.Int(2)));
    cfg.decode = truthy(kwarg(c, "decode", Val.Bool(false)));
    cfg.lib_name = kwarg(c, "lib_name", vs("redis-py"));
    cfg.lib_version = kwarg(c, "lib_version", vs("5.2.1"));
    cfg.password = kwarg(c, "password", Val.Non);
    cfg.username = kwarg(c, "username", Val.Non);
    cfg.db = kwarg(c, "db", Val.Non);
    cfg.client_name = kwarg(c, "client_name", Val.Non);
    cfg.retry_on_timeout = truthy(kwarg(c, "retry_on_timeout", Val.Bool(false)));
    cfg
}

fn do_call(w: mut ref World, name: ref String, c: ref Call) -> Result[Val, Exc] {
    let cmd = build(w, name, c)?;
    exec_cmd(mut w, cmd)
}

fn run_bitfield(w: mut ref World, toks: ref Vec[String]) -> Result[Val, Exc] {
    let mut groups: Vec[Vec[String]] = Vec.new();
    let mut cur: Vec[String] = Vec.new();
    let mut i = 1;
    while i < toks.len() {
        if toks[i] == "|" {
            groups.push(cur.clone());
            cur = Vec.new();
        } else {
            cur.push(toks[i].clone());
        }
        i += 1;
    }
    groups.push(cur);
    let head = parse_args(groups[0]);
    let mut b = Bitfield { key: arg(head, 0, "key"), default_overflow: arg(head, 1, "default_overflow"), ops: Vec.new(), last: vs("WRAP") };
    bf_reset(mut b)?;
    let mut g = 1;
    while g < groups.len() {
        let name = groups[g][0].clone();
        let mut rest_toks: Vec[String] = Vec.new();
        let mut k = 1;
        while k < groups[g].len() {
            rest_toks.push(groups[g][k].clone());
            k += 1;
        }
        let c = parse_args(rest_toks);
        if name == "execute" {
            let command = bf_command(b);
            bf_reset(mut b)?;
            return exec_cmd(mut w, Cmd { args: command, opts: no_opts() });
        } else if name == "overflow" {
            bf_overflow(mut b, arg(c, 0, "overflow"))?;
        } else if name == "incrby" {
            let o = arg(c, 3, "overflow");
            if not is_none(o) {
                bf_overflow(mut b, o)?;
            }
            b.ops.push(vs("INCRBY"));
            b.ops.push(arg(c, 0, "fmt"));
            b.ops.push(arg(c, 1, "offset"));
            b.ops.push(arg(c, 2, "increment"));
        } else if name == "get" {
            b.ops.push(vs("GET"));
            b.ops.push(arg(c, 0, "fmt"));
            b.ops.push(arg(c, 1, "offset"));
        } else if name == "set" {
            b.ops.push(vs("SET"));
            b.ops.push(arg(c, 0, "fmt"));
            b.ops.push(arg(c, 1, "offset"));
            b.ops.push(arg(c, 2, "value"));
        } else if name == "reset" {
            bf_reset(mut b)?;
        }
        g += 1;
    }
    Ok(Val.List(bf_command(b)))
}

fn pipe_op(w: mut ref World, what: ref String, c: ref Call) -> Result[Val, Exc] {
    if *what == "execute" {
        pipe_execute(mut w, truthy(argd(c, 0, "raise_on_error", Val.Bool(true))))
    } else if *what == "multi" {
        pipe_multi(mut w)
    } else if *what == "reset" {
        pipe_reset(mut w)?;
        Ok(Val.Non)
    } else if *what == "unwatch" {
        pipe_unwatch(mut w)
    } else if *what == "watch" {
        pipe_watch(mut w, c.args.clone())
    } else {
        Err(exc("AttributeError", f"'Pipeline' object has no attribute '{what}'"))
    }
}

// A pipeline the job lets go of: Pipeline.__del__() resets it and
// swallows any error.
fn drop_pipe(w: mut ref World) {
    if w.piping {
        match pipe_reset(mut w) {
            Ok(_) => {}
            Err(_) => {}
        }
        w.piping = false;
    }
}

fn new_world() -> World {
    World { out: Vec.new(), units: Vec.new(), next: 0, connects: 0, conns: Vec.new(), avail: Vec.new(), in_use: Vec.new(), cfg: default_cfg(), pipe: new_pipe(true), piping: false }
}

fn main() {
    let text = unesc(jobs_text());
    let mut w = new_world();
    let mut have_client = false;
    for line in split_str(text, "\n") {
        if line.len() == 0 {
            continue;
        }
        let toks = split_str(line, " ");
        let head = toks[0].clone();
        if head == "job" {
            if have_client {
                pool_disconnect(mut w);
            }
            emit(mut w, String.new());
            emit(mut w, f"== {join_from(toks, 1)}");
            w.units = Vec.new();
            w.next = 0;
            w.connects = 0;
            have_client = false;
            drop_pipe(mut w);
        } else if head == "client" {
            emit(mut w, join_from(toks, 0));
            let mut rest_toks: Vec[String] = Vec.new();
            for k in 1..toks.len() {
                rest_toks.push(toks[k].clone());
            }
            let c = parse_args(rest_toks);
            w.cfg = make_cfg(c);
            w.conns = Vec.new();
            w.avail = Vec.new();
            w.in_use = Vec.new();
            w.pipe = new_pipe(true);
            w.piping = false;
            have_client = true;
        } else if head == "reply" {
            if toks[1] == "@close" {
                w.units.push(Unit.Close);
            } else if toks[1] == "@hang" {
                w.units.push(Unit.Hang);
            } else {
                w.units.push(Unit.Data(unescape(toks[1])));
            }
        } else if head == "call" {
            emit(mut w, f"call {join_from(toks, 1)}");
            let mut rest_toks: Vec[String] = Vec.new();
            for k in 2..toks.len() {
                rest_toks.push(toks[k].clone());
            }
            let c = parse_args(rest_toks);
            let r = do_call(mut w, toks[1], c);
            outcome(mut w, r);
        } else if head == "bitfield" {
            emit(mut w, f"bitfield {join_from(toks, 1)}");
            let r = run_bitfield(mut w, toks);
            outcome(mut w, r);
        } else if head == "pipe" {
            emit(mut w, f"pipe {join_from(toks, 1)}");
            let mut rest_toks: Vec[String] = Vec.new();
            for k in 2..toks.len() {
                rest_toks.push(toks[k].clone());
            }
            let c = parse_args(rest_toks);
            let what = toks[1].clone();
            if what == "begin" {
                drop_pipe(mut w);
                w.pipe = new_pipe(truthy(kwarg(c, "transaction", Val.Bool(true))));
                w.piping = true;
                emit(mut w, "= pipeline".to_string());
            } else if what == "end" {
                drop_pipe(mut w);
                emit(mut w, "= client".to_string());
            } else {
                let r = pipe_op(mut w, what, c);
                outcome(mut w, r);
            }
        } else if head == "url" {
            emit(mut w, f"url {toks[1]}");
            let r = parse_url(unescape_str(toks[1]));
            outcome(mut w, r);
        }
    }
    if have_client {
        pool_disconnect(mut w);
    }
    let mut i = 1;
    while i < w.out.len() {
        println(w.out[i]);
        i += 1;
    }
}

