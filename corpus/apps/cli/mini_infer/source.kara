// mini_infer: a type checker for a subset of OCaml, the way an editor's
// language server runs one. It lexes and parses .ml source, infers every
// type with Hindley-Milner inference (union-find variables and levels-based
// generalisation, as OCaml's typer does), reports the first type error in
// each top-level item with OCaml's wording, warns about non-exhaustive and
// unused match cases (Maranget's usefulness algorithm), and answers
// "what is the type under the cursor". The jobs in data/jobs.txt check six
// programs, hover over them, and check one-line programs.

// ------------------------------------------------------------ lexer

#[derive(Copy, Clone)]
struct Loc {
    sl: i64,
    sc: i64,
    el: i64,
    ec: i64,
    so: i64,
    eo: i64,
}

fn join(a: Loc, b: Loc) -> Loc {
    Loc { sl: a.sl, sc: a.sc, el: b.el, ec: b.ec, so: a.so, eo: b.eo }
}

#[derive(Copy, Clone, PartialEq, Eq)]
enum TokK {
    IntLit,
    TextLit,
    LIdent,
    UIdent,
    TyVar,
    Kw,
    Sym,
    Eof,
}

#[derive(Clone)]
struct Tok {
    kind: TokK,
    text: String,
    span: Loc,
}

#[derive(Clone)]
struct Diag {
    span: Loc,
    level: String,
    msg: String,
    notes: Vec[String],
}

fn diag(span: Loc, msg: own String) -> Diag {
    Diag { span: span, level: "error".to_string(), msg: msg, notes: Vec.new() }
}

fn is_keyword(s: Str) -> bool {
    match s {
        "let" | "rec" | "and" | "in" | "fun" | "function" | "if" | "then" | "else" => true,
        "match" | "with" | "when" | "type" | "of" | "true" | "false" | "mod" => true,
        _ => false,
    }
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_lower(c: u8) -> bool {
    c >= b'a' and c <= b'z'
}

fn is_upper(c: u8) -> bool {
    c >= b'A' and c <= b'Z'
}

fn is_ident_char(c: u8) -> bool {
    is_digit(c) or is_lower(c) or is_upper(c) or c == b'_' or c == b'\''
}

fn bytes_text(b: ref Vec[u8], a: i64, e: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    for k in a..e {
        out.push(b[k]);
    }
    String.from_utf8(out).unwrap_or(String.new())
}

// The two-character symbols, longest match first; then the single ones.
fn syms2() -> Vec[String] {
    [";;", "::", "->", "<>", "<=", ">=", "||", "&&"].to_vec()
}

fn is_sym1(c: u8) -> bool {
    match c {
        b'(' | b')' | b'[' | b']' | b'{' | b'}' | b',' | b';' | b':' | b'=' => true,
        b'<' | b'>' | b'+' | b'-' | b'*' | b'/' | b'^' | b'|' | b'.' | b'@' => true,
        _ => false,
    }
}

struct Lx {
    b: Vec[u8],
    i: i64,
    line: i64,
    col: i64,
}

impl Lx {
    fn at(ref self, k: i64) -> u8 {
        let j = self.i + k;
        if j < self.b.len() { self.b[j] } else { 0 }
    }

    fn adv(mut ref self, k: i64) {
        for _ in 0..k {
            if self.b[self.i] == b'\n' {
                self.line += 1;
                self.col = 1;
            } else {
                self.col += 1;
            }
            self.i += 1;
        }
    }

    fn here(ref self, w: i64) -> Loc {
        Loc { sl: self.line, sc: self.col, el: self.line, ec: self.col + w, so: self.i, eo: self.i + w }
    }
}

fn lex(src: Str) -> Result[Vec[Tok], Diag] {
    let mut lx = Lx { b: src.bytes().to_vec(), i: 0, line: 1, col: 1 };
    let n = lx.b.len();
    let mut toks: Vec[Tok] = Vec.new();
    loop {
        // whitespace and nested comments
        while lx.i < n {
            let c = lx.at(0);
            if c == b' ' or c == b'\t' or c == b'\r' or c == b'\n' {
                lx.adv(1);
            } else if c == b'(' and lx.at(1) == b'*' {
                let start = lx.here(2);
                let mut depth = 0;
                loop {
                    if lx.i >= n {
                        return Err(diag(start, "this comment is not terminated".to_string()));
                    }
                    if lx.at(0) == b'(' and lx.at(1) == b'*' {
                        depth += 1;
                        lx.adv(2);
                    } else if lx.at(0) == b'*' and lx.at(1) == b')' {
                        depth -= 1;
                        lx.adv(2);
                        if depth == 0 {
                            break;
                        }
                    } else {
                        lx.adv(1);
                    }
                }
            } else {
                break;
            }
        }
        if lx.i >= n {
            toks.push(Tok { kind: TokK.Eof, text: String.new(), span: lx.here(0) });
            return Ok(toks);
        }
        let (sl, sc, so) = (lx.line, lx.col, lx.i);
        let c = lx.at(0);
        let mut kind = TokK.Sym;
        let mut text = String.new();
        if is_digit(c) {
            let mut j = lx.i;
            while j < n and is_digit(lx.b[j]) {
                j += 1;
            }
            kind = TokK.IntLit;
            text = bytes_text(lx.b, lx.i, j);
            lx.adv(j - lx.i);
        } else if c == b'"' {
            let start = lx.here(1);
            lx.adv(1);
            let mut buf: Vec[u8] = Vec.new();
            loop {
                if lx.i >= n or lx.at(0) == b'\n' {
                    return Err(diag(start, "this string literal is not terminated".to_string()));
                }
                let d = lx.at(0);
                if d == b'"' {
                    lx.adv(1);
                    break;
                }
                if d == b'\\' {
                    let e = lx.at(1);
                    let esc: u8 = match e {
                        b'n' => b'\n',
                        b't' => b'\t',
                        b'\\' => b'\\',
                        b'"' => b'"',
                        _ => 0,
                    };
                    if esc == 0 {
                        let what = if e == 0 { String.new() } else { bytes_text(lx.b, lx.i + 1, lx.i + 2) };
                        return Err(diag(lx.here(2), f"illegal backslash escape in string: \\{what}"));
                    }
                    buf.push(esc);
                    lx.adv(2);
                } else {
                    buf.push(d);
                    lx.adv(1);
                }
            }
            kind = TokK.TextLit;
            text = String.from_utf8(buf).unwrap_or(String.new());
        } else if c == b'\'' and is_lower(lx.at(1)) {
            let mut j = lx.i + 1;
            while j < n and is_ident_char(lx.b[j]) {
                j += 1;
            }
            kind = TokK.TyVar;
            text = bytes_text(lx.b, lx.i + 1, j);
            lx.adv(j - lx.i);
        } else if is_lower(c) or is_upper(c) or c == b'_' {
            let mut j = lx.i;
            while j < n and is_ident_char(lx.b[j]) {
                j += 1;
            }
            text = bytes_text(lx.b, lx.i, j);
            if text == "_" {
                kind = TokK.Sym;
            } else if is_upper(c) {
                kind = TokK.UIdent;
            } else if is_keyword(text) {
                kind = TokK.Kw;
            } else {
                kind = TokK.LIdent;
            }
            lx.adv(j - lx.i);
        } else {
            let two = if lx.i + 2 <= n { bytes_text(lx.b, lx.i, lx.i + 2) } else { String.new() };
            let mut found = false;
            for s in syms2().iter() {
                if two == *s {
                    found = true;
                }
            }
            if found {
                text = two;
            } else if is_sym1(c) {
                text = bytes_text(lx.b, lx.i, lx.i + 1);
            } else {
                let ch = bytes_text(lx.b, lx.i, lx.i + 1);
                return Err(diag(lx.here(1), f"illegal character ({ch})"));
            }
            kind = TokK.Sym;
            lx.adv(text.len());
        }
        toks.push(Tok { kind: kind, text: text, span: Loc { sl: sl, sc: sc, el: lx.line, ec: lx.col, so: so, eo: lx.i } });
    }
}

// ------------------------------------------------------------ syntax
// One node type for expressions and patterns; `kind` names the form and
// the other fields are used as the form needs them.

#[derive(Copy, Clone, PartialEq, Eq)]
enum Nk {
    EInt,
    EText,
    EBool,
    EUnit,
    EVar,
    EPath,
    ECtor,
    ETuple,
    EList,
    EOp,
    ENeg,
    EApp,
    EFun,
    EFunction,
    EMatch,
    EIf,
    ESeq,
    EConstraint,
    ELet,
    ERecord,
    EWith,
    EField,
    PWild,
    PVar,
    PInt,
    PText,
    PBool,
    PUnit,
    PTuple,
    PCons,
    PList,
    PCtor,
    PRecord,
    PConstraint,
}

#[derive(Clone)]
struct Node {
    kind: Nk,
    span: Loc,
    name: String,
    kids: Vec[Node],
    pats: Vec[Node],
    arms: Vec[Arm],
    binds: Vec[Binding],
    fields: Vec[FieldE],
    ty: Vec[TyExpr],
    flag: bool,
}

#[derive(Clone)]
struct Arm {
    pat: Node,
    guard: Vec[Node],
    body: Node,
}

#[derive(Clone)]
struct Binding {
    pat: Node,
    rhs: Node,
    span: Loc,
}

// A record field in an expression or pattern; `value` is empty for the
// field of an access `e.f`.
#[derive(Clone)]
struct FieldE {
    name: String,
    span: Loc,
    value: Vec[Node],
}

#[derive(Copy, Clone, PartialEq, Eq)]
enum TyK {
    TVar,
    TCon,
    TArrow,
    TTuple,
}

#[derive(Clone)]
struct TyExpr {
    kind: TyK,
    span: Loc,
    name: String,
    args: Vec[TyExpr],
}

#[derive(Clone)]
struct CtorDecl {
    name: String,
    span: Loc,
    args: Vec[TyExpr],
}

#[derive(Clone)]
struct FieldDecl {
    name: String,
    span: Loc,
    ty: TyExpr,
}

const DECL_VARIANT: i64 = 0;
const DECL_RECORD: i64 = 1;
const DECL_ALIAS: i64 = 2;

#[derive(Clone)]
struct TypeDecl {
    name: String,
    params: Vec[String],
    span: Loc,
    kind: i64,
    ctors: Vec[CtorDecl],
    fields: Vec[FieldDecl],
    alias: Vec[TyExpr],
}

#[derive(Clone)]
struct Item {
    is_type: bool,
    span: Loc,
    flag: bool,
    binds: Vec[Binding],
    decls: Vec[TypeDecl],
}

fn node(kind: Nk, span: Loc) -> Node {
    Node {
        kind: kind,
        span: span,
        name: String.new(),
        kids: Vec.new(),
        pats: Vec.new(),
        arms: Vec.new(),
        binds: Vec.new(),
        fields: Vec.new(),
        ty: Vec.new(),
        flag: false,
    }
}

fn named(kind: Nk, span: Loc, name: Str) -> Node {
    let mut n = node(kind, span);
    n.name = name.to_string();
    n
}

fn with_kids(kind: Nk, span: Loc, kids: own Vec[Node]) -> Node {
    let mut n = node(kind, span);
    n.kids = kids;
    n
}

fn tyexpr(kind: TyK, span: Loc, name: Str, args: own Vec[TyExpr]) -> TyExpr {
    TyExpr { kind: kind, span: span, name: name.to_string(), args: args }
}

// ------------------------------------------------------------ parser

const NLEVELS: i64 = 7;

// The binary operators by level, loosest first.
fn level_ops(lvl: i64) -> Vec[String] {
    match lvl {
        0 => ["||"].to_vec(),
        1 => ["&&"].to_vec(),
        2 => ["=", "<>", "<", ">", "<=", ">="].to_vec(),
        3 => ["^", "@"].to_vec(),
        4 => ["::"].to_vec(),
        5 => ["+", "-"].to_vec(),
        _ => ["*", "/", "mod"].to_vec(),
    }
}

fn level_right(lvl: i64) -> bool {
    lvl == 3 or lvl == 4
}

struct Ps {
    toks: Vec[Tok],
    i: i64,
    last: Loc,
}

impl Ps {
    fn idx(ref self, k: i64) -> i64 {
        let j = self.i + k;
        if j < self.toks.len() { j } else { self.toks.len() - 1 }
    }

    fn kind(ref self, k: i64) -> TokK {
        self.toks[self.idx(k)].kind
    }

    fn tok(ref self, k: i64) -> Tok {
        self.toks[self.idx(k)].clone()
    }

    fn at_k(ref self, text: Str, k: i64) -> bool {
        let j = self.idx(k);
        let kd = self.toks[j].kind;
        (kd == TokK.Sym or kd == TokK.Kw) and self.toks[j].text == text
    }

    fn at(ref self, text: Str) -> bool {
        self.at_k(text, 0)
    }

    fn next(mut ref self) -> Tok {
        let t = self.toks[self.i].clone();
        if t.kind != TokK.Eof {
            self.i += 1;
        }
        self.last = t.span;
        t
    }

    fn fail(ref self) -> Diag {
        diag(self.toks[self.idx(0)].span, "syntax error".to_string())
    }

    fn expect(mut ref self, text: Str) -> Result[Tok, Diag] {
        if not self.at(text) {
            return Err(self.fail());
        }
        Ok(self.next())
    }

    fn start(ref self) -> Loc {
        self.toks[self.idx(0)].span
    }

    fn done(ref self, s: Loc) -> Loc {
        join(s, self.last)
    }

    // ---- items

    fn program(mut ref self) -> Result[Vec[Item], Diag] {
        let mut items: Vec[Item] = Vec.new();
        loop {
            while self.at(";;") {
                self.next();
            }
            if self.kind(0) == TokK.Eof {
                return Ok(items);
            }
            if self.at("let") {
                items.push(self.let_item()?);
            } else if self.at("type") {
                items.push(self.type_item()?);
            } else {
                return Err(self.fail());
            }
        }
    }

    fn let_item(mut ref self) -> Result[Item, Diag] {
        let s = self.start();
        self.expect("let")?;
        let mut rec = false;
        if self.at("rec") {
            self.next();
            rec = true;
        }
        let mut binds: Vec[Binding] = Vec.new();
        binds.push(self.binding()?);
        while self.at("and") {
            self.next();
            binds.push(self.binding()?);
        }
        if self.at("in") {
            return Err(self.fail());
        }
        Ok(Item { is_type: false, span: self.done(s), flag: rec, binds: binds, decls: Vec.new() })
    }

    fn type_item(mut ref self) -> Result[Item, Diag] {
        let s = self.start();
        self.expect("type")?;
        let mut decls: Vec[TypeDecl] = Vec.new();
        decls.push(self.type_decl()?);
        while self.at("and") {
            self.next();
            decls.push(self.type_decl()?);
        }
        Ok(Item { is_type: true, span: self.done(s), flag: false, binds: Vec.new(), decls: decls })
    }

    fn type_decl(mut ref self) -> Result[TypeDecl, Diag] {
        let mut params: Vec[String] = Vec.new();
        if self.kind(0) == TokK.TyVar {
            params.push(self.next().text);
        } else if self.at("(") and self.kind(1) == TokK.TyVar {
            self.next();
            loop {
                if self.kind(0) != TokK.TyVar {
                    return Err(self.fail());
                }
                params.push(self.next().text);
                if self.at(",") {
                    self.next();
                    continue;
                }
                self.expect(")")?;
                break;
            }
        }
        if self.kind(0) != TokK.LIdent {
            return Err(self.fail());
        }
        let t = self.next();
        self.expect("=")?;
        let mut d = TypeDecl {
            name: t.text,
            params: params,
            span: t.span,
            kind: DECL_VARIANT,
            ctors: Vec.new(),
            fields: Vec.new(),
            alias: Vec.new(),
        };
        if self.at("{") {
            self.next();
            loop {
                if self.kind(0) != TokK.LIdent {
                    return Err(self.fail());
                }
                let f = self.next();
                self.expect(":")?;
                let te = self.type_expr()?;
                d.fields.push(FieldDecl { name: f.text, span: f.span, ty: te });
                if self.at(";") {
                    self.next();
                    if self.at("}") {
                        break;
                    }
                    continue;
                }
                break;
            }
            self.expect("}")?;
            d.kind = DECL_RECORD;
            return Ok(d);
        }
        if not (self.at("|") or self.kind(0) == TokK.UIdent) {
            d.alias.push(self.type_expr()?);
            d.kind = DECL_ALIAS;
            return Ok(d);
        }
        if self.at("|") {
            self.next();
        }
        loop {
            if self.kind(0) != TokK.UIdent {
                return Err(self.fail());
            }
            let c = self.next();
            let mut args: Vec[TyExpr] = Vec.new();
            if self.at("of") {
                self.next();
                args.push(self.type_app()?);
                while self.at("*") {
                    self.next();
                    args.push(self.type_app()?);
                }
            }
            d.ctors.push(CtorDecl { name: c.text, span: c.span, args: args });
            if self.at("|") {
                self.next();
                continue;
            }
            break;
        }
        Ok(d)
    }

    // ---- type expressions: arrow < tuple < application

    fn type_expr(mut ref self) -> Result[TyExpr, Diag] {
        let s = self.start();
        let a = self.type_tuple()?;
        if self.at("->") {
            self.next();
            let b = self.type_expr()?;
            return Ok(tyexpr(TyK.TArrow, self.done(s), "", vec![a, b]));
        }
        Ok(a)
    }

    fn type_tuple(mut ref self) -> Result[TyExpr, Diag] {
        let s = self.start();
        let a = self.type_app()?;
        if not self.at("*") {
            return Ok(a);
        }
        let mut items = vec![a];
        while self.at("*") {
            self.next();
            items.push(self.type_app()?);
        }
        Ok(tyexpr(TyK.TTuple, self.done(s), "", items))
    }

    fn type_app(mut ref self) -> Result[TyExpr, Diag] {
        let s = self.start();
        let k = self.kind(0);
        let mut base = if k == TokK.TyVar {
            let t = self.next();
            tyexpr(TyK.TVar, t.span, t.text, Vec.new())
        } else if k == TokK.LIdent {
            let t = self.next();
            tyexpr(TyK.TCon, t.span, t.text, Vec.new())
        } else if self.at("(") {
            self.next();
            let first = self.type_expr()?;
            if self.at(",") {
                let mut args = vec![first];
                while self.at(",") {
                    self.next();
                    args.push(self.type_expr()?);
                }
                self.expect(")")?;
                if self.kind(0) != TokK.LIdent {
                    return Err(self.fail());
                }
                let c = self.next();
                tyexpr(TyK.TCon, self.done(s), c.text, args)
            } else {
                self.expect(")")?;
                first
            }
        } else {
            return Err(self.fail());
        };
        while self.kind(0) == TokK.LIdent {
            let c = self.next();
            base = tyexpr(TyK.TCon, self.done(s), c.text, vec![base]);
        }
        Ok(base)
    }

    // ---- bindings

    fn binding(mut ref self) -> Result[Binding, Diag] {
        let s = self.start();
        if self.kind(0) == TokK.LIdent and self.pat_atom_start(1) {
            let t = self.next();
            let name = named(Nk.PVar, t.span, t.text);
            let mut params: Vec[Node] = Vec.new();
            while self.pat_atom_start(0) {
                params.push(self.pat_atom()?);
            }
            let mut ann: Vec[TyExpr] = Vec.new();
            if self.at(":") {
                self.next();
                ann.push(self.type_expr()?);
            }
            self.expect("=")?;
            let mut body = self.seq()?;
            // B-2026-11-01-7: `f(body.span, vec![body])` reads `body.span` after
            // the later argument has moved `body`, so the MIR builder
            // refuses it; the span is copied first. Revert to reading
            // `body.span` in the call when the row is fixed.
            let body_span = body.span;
            if ann.len() > 0 {
                let mut c = with_kids(Nk.EConstraint, body_span, vec![body]);
                c.ty = ann;
                body = c;
            }
            let rhs_span = join(params[0].span, body_span);
            let mut rhs = with_kids(Nk.EFun, rhs_span, vec![body]);
            rhs.pats = params;
            return Ok(Binding { pat: name, rhs: rhs, span: self.done(s) });
        }
        let mut pat = self.pattern()?;
        if self.at(":") {
            self.next();
            let ann = self.type_expr()?;
            let mut c = with_kids(Nk.PConstraint, self.done(s), vec![pat]);
            c.ty = vec![ann];
            pat = c;
        }
        self.expect("=")?;
        let rhs = self.seq()?;
        Ok(Binding { pat: pat, rhs: rhs, span: self.done(s) })
    }

    // ---- expressions

    fn seq(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        let e = self.tuple()?;
        if self.at(";") {
            self.next();
            let rest = self.seq()?;
            return Ok(with_kids(Nk.ESeq, self.done(s), vec![e, rest]));
        }
        Ok(e)
    }

    fn tuple(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        let e = self.binop(0)?;
        if not self.at(",") {
            return Ok(e);
        }
        let mut items = vec![e];
        while self.at(",") {
            self.next();
            items.push(self.binop(0)?);
        }
        Ok(with_kids(Nk.ETuple, self.done(s), items))
    }

    fn at_op(ref self, ops: ref Vec[String]) -> bool {
        let k = self.kind(0);
        if k != TokK.Sym and k != TokK.Kw {
            return false;
        }
        let j = self.idx(0);
        for o in ops.iter() {
            if self.toks[j].text == *o {
                return true;
            }
        }
        false
    }

    fn binop(mut ref self, lvl: i64) -> Result[Node, Diag] {
        if lvl == NLEVELS {
            return self.unary();
        }
        let ops = level_ops(lvl);
        let s = self.start();
        let mut lhs = self.binop(lvl + 1)?;
        while self.at_op(ops) {
            let op = self.next();
            let rhs = if level_right(lvl) { self.binop(lvl)? } else { self.binop(lvl + 1)? };
            let mut n = with_kids(Nk.EOp, self.done(s), vec![lhs, rhs]);
            n.name = op.text;
            lhs = n;
            if level_right(lvl) {
                break;
            }
        }
        Ok(lhs)
    }

    fn unary(mut ref self) -> Result[Node, Diag] {
        if self.at("-") {
            let s = self.start();
            self.next();
            let e = self.unary()?;
            return Ok(with_kids(Nk.ENeg, self.done(s), vec![e]));
        }
        self.app()
    }

    fn prefix_start(ref self) -> bool {
        self.at("let") or self.at("fun") or self.at("function") or self.at("if") or self.at("match")
    }

    fn atom_start(ref self) -> bool {
        let k = self.kind(0);
        if k == TokK.IntLit or k == TokK.TextLit or k == TokK.LIdent or k == TokK.UIdent {
            return true;
        }
        self.at("true") or self.at("false") or self.at("(") or self.at("[") or self.at("{")
    }

    fn app(mut ref self) -> Result[Node, Diag] {
        if self.prefix_start() {
            return self.prefix();
        }
        let s = self.start();
        let head = if self.kind(0) == TokK.UIdent and not self.at_k(".", 1) {
            let t = self.next();
            if self.atom_start() {
                let arg = self.postfix()?;
                let mut c = with_kids(Nk.ECtor, self.done(s), vec![arg]);
                c.name = t.text;
                c
            } else {
                named(Nk.ECtor, t.span, t.text)
            }
        } else {
            self.postfix()?
        };
        if not self.atom_start() {
            return Ok(head);
        }
        let mut kids = vec![head];
        while self.atom_start() {
            kids.push(self.postfix()?);
        }
        Ok(with_kids(Nk.EApp, self.done(s), kids))
    }

    fn postfix(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        let mut e = if self.kind(0) == TokK.UIdent and self.at_k(".", 1) and self.kind(2) == TokK.LIdent {
            // a module path, M.x: there are no modules, so it is unbound
            let m = self.next();
            self.next();
            let x = self.next();
            let mut p = named(Nk.EPath, self.done(s), m.text + "." + x.text);
            p.fields.push(FieldE { name: m.text, span: m.span, value: Vec.new() });
            p
        } else if self.kind(0) == TokK.UIdent {
            // a constructor as an argument takes no argument of its own
            let t = self.next();
            named(Nk.ECtor, t.span, t.text)
        } else {
            self.atom()?
        };
        while self.at(".") {
            self.next();
            if self.kind(0) != TokK.LIdent {
                return Err(self.fail());
            }
            let f = self.next();
            let mut n = with_kids(Nk.EField, self.done(s), vec![e]);
            n.name = f.text.clone();
            n.fields.push(FieldE { name: f.text, span: f.span, value: Vec.new() });
            e = n;
        }
        Ok(e)
    }

    fn atom(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        let k = self.kind(0);
        if k == TokK.IntLit {
            let t = self.next();
            return Ok(named(Nk.EInt, t.span, t.text));
        }
        if k == TokK.TextLit {
            let t = self.next();
            return Ok(named(Nk.EText, t.span, t.text));
        }
        if k == TokK.LIdent {
            let t = self.next();
            return Ok(named(Nk.EVar, t.span, t.text));
        }
        if self.at("true") or self.at("false") {
            let t = self.next();
            return Ok(named(Nk.EBool, t.span, t.text));
        }
        if self.at("(") {
            self.next();
            if self.at(")") {
                self.next();
                return Ok(node(Nk.EUnit, self.done(s)));
            }
            let e = self.seq()?;
            if self.at(":") {
                self.next();
                let ty = self.type_expr()?;
                self.expect(")")?;
                let mut c = with_kids(Nk.EConstraint, self.done(s), vec![e]);
                c.ty = vec![ty];
                return Ok(c);
            }
            self.expect(")")?;
            return Ok(e);
        }
        if self.at("[") {
            self.next();
            let mut items: Vec[Node] = Vec.new();
            if not self.at("]") {
                items.push(self.tuple()?);
                while self.at(";") {
                    self.next();
                    if self.at("]") {
                        break;
                    }
                    items.push(self.tuple()?);
                }
            }
            self.expect("]")?;
            return Ok(with_kids(Nk.EList, self.done(s), items));
        }
        if self.at("{") {
            self.next();
            let mut base: Vec[Node] = Vec.new();
            if not (self.kind(0) == TokK.LIdent and self.at_k("=", 1)) {
                base.push(self.postfix()?);
                self.expect("with")?;
            }
            let mut fields: Vec[FieldE] = Vec.new();
            loop {
                if self.kind(0) != TokK.LIdent {
                    return Err(self.fail());
                }
                let f = self.next();
                self.expect("=")?;
                let v = self.binop(0)?;
                fields.push(FieldE { name: f.text, span: f.span, value: vec![v] });
                if self.at(";") {
                    self.next();
                    if self.at("}") {
                        break;
                    }
                    continue;
                }
                break;
            }
            self.expect("}")?;
            let mut n = if base.len() == 0 {
                node(Nk.ERecord, self.done(s))
            } else {
                with_kids(Nk.EWith, self.done(s), base)
            };
            n.fields = fields;
            return Ok(n);
        }
        Err(self.fail())
    }

    fn prefix(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        if self.at("let") {
            self.next();
            let mut rec = false;
            if self.at("rec") {
                self.next();
                rec = true;
            }
            let mut binds: Vec[Binding] = Vec.new();
            binds.push(self.binding()?);
            while self.at("and") {
                self.next();
                binds.push(self.binding()?);
            }
            self.expect("in")?;
            let body = self.seq()?;
            let mut n = with_kids(Nk.ELet, self.done(s), vec![body]);
            n.binds = binds;
            n.flag = rec;
            return Ok(n);
        }
        if self.at("fun") {
            self.next();
            let mut params = vec![self.pat_atom()?];
            while self.pat_atom_start(0) {
                params.push(self.pat_atom()?);
            }
            self.expect("->")?;
            let body = self.seq()?;
            let mut n = with_kids(Nk.EFun, self.done(s), vec![body]);
            n.pats = params;
            return Ok(n);
        }
        if self.at("function") {
            self.next();
            let arms = self.arms()?;
            let mut n = node(Nk.EFunction, self.done(s));
            n.arms = arms;
            return Ok(n);
        }
        if self.at("if") {
            self.next();
            let c = self.seq()?;
            self.expect("then")?;
            let a = self.tuple()?;
            if self.at("else") {
                self.next();
                let b = self.tuple()?;
                return Ok(with_kids(Nk.EIf, self.done(s), vec![c, a, b]));
            }
            return Ok(with_kids(Nk.EIf, self.done(s), vec![c, a]));
        }
        self.expect("match")?;
        let e = self.seq()?;
        self.expect("with")?;
        let arms = self.arms()?;
        let mut n = with_kids(Nk.EMatch, self.done(s), vec![e]);
        n.arms = arms;
        Ok(n)
    }

    fn arms(mut ref self) -> Result[Vec[Arm], Diag] {
        if self.at("|") {
            self.next();
        }
        let mut arms: Vec[Arm] = Vec.new();
        loop {
            let p = self.pattern()?;
            let mut g: Vec[Node] = Vec.new();
            if self.at("when") {
                self.next();
                g.push(self.seq()?);
            }
            self.expect("->")?;
            let body = self.seq()?;
            arms.push(Arm { pat: p, guard: g, body: body });
            if self.at("|") {
                self.next();
                continue;
            }
            return Ok(arms);
        }
    }

    // ---- patterns

    fn pat_atom_start(ref self, k: i64) -> bool {
        let kd = self.kind(k);
        if kd == TokK.IntLit or kd == TokK.TextLit or kd == TokK.LIdent or kd == TokK.UIdent {
            return true;
        }
        self.at_k("_", k) or self.at_k("true", k) or self.at_k("false", k) or self.at_k("(", k) or self.at_k("[", k) or self.at_k("{", k)
    }

    fn pattern(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        let p = self.pat_cons()?;
        if not self.at(",") {
            return Ok(p);
        }
        let mut items = vec![p];
        while self.at(",") {
            self.next();
            items.push(self.pat_cons()?);
        }
        Ok(with_kids(Nk.PTuple, self.done(s), items))
    }

    fn pat_cons(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        let h = self.pat_app()?;
        if self.at("::") {
            self.next();
            let t = self.pat_cons()?;
            return Ok(with_kids(Nk.PCons, self.done(s), vec![h, t]));
        }
        Ok(h)
    }

    fn pat_app(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        if self.kind(0) == TokK.UIdent {
            let t = self.next();
            if self.pat_atom_start(0) {
                let arg = self.pat_atom()?;
                let mut c = with_kids(Nk.PCtor, self.done(s), vec![arg]);
                c.name = t.text;
                return Ok(c);
            }
            return Ok(named(Nk.PCtor, t.span, t.text));
        }
        if self.at("-") and self.kind(1) == TokK.IntLit {
            self.next();
            let n = self.next();
            return Ok(named(Nk.PInt, self.done(s), "-" + n.text));
        }
        self.pat_atom()
    }

    fn pat_atom(mut ref self) -> Result[Node, Diag] {
        let s = self.start();
        let k = self.kind(0);
        if self.at("_") {
            let t = self.next();
            return Ok(node(Nk.PWild, t.span));
        }
        if k == TokK.LIdent {
            let t = self.next();
            return Ok(named(Nk.PVar, t.span, t.text));
        }
        if k == TokK.UIdent {
            let t = self.next();
            return Ok(named(Nk.PCtor, t.span, t.text));
        }
        if k == TokK.IntLit {
            let t = self.next();
            return Ok(named(Nk.PInt, t.span, t.text));
        }
        if k == TokK.TextLit {
            let t = self.next();
            return Ok(named(Nk.PText, t.span, t.text));
        }
        if self.at("true") or self.at("false") {
            let t = self.next();
            return Ok(named(Nk.PBool, t.span, t.text));
        }
        if self.at("(") {
            self.next();
            if self.at(")") {
                self.next();
                return Ok(node(Nk.PUnit, self.done(s)));
            }
            let p = self.pattern()?;
            if self.at(":") {
                self.next();
                let ty = self.type_expr()?;
                self.expect(")")?;
                let mut c = with_kids(Nk.PConstraint, self.done(s), vec![p]);
                c.ty = vec![ty];
                return Ok(c);
            }
            self.expect(")")?;
            return Ok(p);
        }
        if self.at("[") {
            self.next();
            let mut items: Vec[Node] = Vec.new();
            if not self.at("]") {
                items.push(self.pat_cons()?);
                while self.at(";") {
                    self.next();
                    if self.at("]") {
                        break;
                    }
                    items.push(self.pat_cons()?);
                }
            }
            self.expect("]")?;
            return Ok(with_kids(Nk.PList, self.done(s), items));
        }
        if self.at("{") {
            self.next();
            let mut fields: Vec[FieldE] = Vec.new();
            loop {
                if self.kind(0) != TokK.LIdent {
                    return Err(self.fail());
                }
                let f = self.next();
                let p = if self.at("=") {
                    self.next();
                    self.pattern()?
                } else {
                    named(Nk.PVar, f.span, f.text)
                };
                fields.push(FieldE { name: f.text, span: f.span, value: vec![p] });
                if self.at(";") {
                    self.next();
                    if self.at("}") {
                        break;
                    }
                    continue;
                }
                break;
            }
            self.expect("}")?;
            let mut n = node(Nk.PRecord, self.done(s));
            n.fields = fields;
            return Ok(n);
        }
        Err(self.fail())
    }
}

fn parse_program(src: Str) -> Result[Vec[Item], Diag] {
    let toks = lex(src)?;
    let first = toks[0].span;
    let mut p = Ps { toks: toks, i: 0, last: first };
    p.program()
}

// ------------------------------------------------------------ types
// The types live in an arena of parallel vectors: each type is an index.
// A variable has a link (-1 while free) and a level; GENERIC marks a
// generalised variable.

const GENERIC: i64 = 1073741824;

#[derive(Copy, Clone, PartialEq, Eq)]
enum Ty {
    TyVar,
    TyCon,
    TyArrow,
    TyTuple,
}

const KIND_ABSTRACT: i64 = 0;
const KIND_VARIANT: i64 = 1;
const KIND_RECORD: i64 = 2;
const KIND_ALIAS: i64 = 3;

#[derive(Clone)]
struct TypeInfo {
    name: String,
    arity: i64,
    kind: i64,
    params: Vec[i64],
    ctors: Vec[String],
    arities: Vec[i64],
    fields: Vec[String],
    param_names: Vec[String],
    body: Vec[TyExpr],
    expanding: bool,
}

#[derive(Clone)]
struct CtorInfo {
    name: String,
    tinfo: i64,
    index: i64,
    args: Vec[i64],
    result: i64,
}

#[derive(Clone)]
struct FieldInfo {
    name: String,
    tinfo: i64,
    index: i64,
    ty: i64,
    result: i64,
}

#[derive(Clone)]
struct EnvE {
    name: String,
    ty: i64,
    bid: i64,
}

#[derive(Copy, Clone)]
struct Rec {
    span: Loc,
    ty: i64,
}

#[derive(Clone)]
struct ItemRec {
    span: Loc,
    ok: bool,
    recs: Vec[Rec],
}

// A variable a pattern binds, before it enters the environment.
#[derive(Clone)]
struct Bound {
    name: String,
    ty: i64,
    span: Loc,
}

// A variable in the environment, for the unused-variable warning.
#[derive(Clone)]
struct Pushed {
    name: String,
    span: Loc,
    bid: i64,
}

// A failed unification: the innermost pair that clashed, or a variable
// and the type it occurs in.
#[derive(Copy, Clone)]
struct UErr {
    occurs: bool,
    a: i64,
    b: i64,
}

#[derive(Copy, Clone)]
struct TrailE {
    link: bool,
    t: i64,
    old: i64,
}

const MODE_SCHEME: i64 = 0;
const MODE_DECL: i64 = 1;
const MODE_ANN: i64 = 2;

// ------------------------------------------------------------ patterns for the match warnings
// A simple pattern is a wildcard or a constructor of a family with its
// arguments (Maranget, "Warnings for pattern matching"). A tag is a
// constructor index, or the literal itself for int and string.

#[derive(Copy, Clone, PartialEq, Eq)]
enum FamK {
    Variant,
    Boolean,
    UnitF,
    ListF,
    TupleF,
    RecordF,
    IntF,
    StringF,
}

#[derive(Copy, Clone, PartialEq, Eq)]
struct Fam {
    kind: FamK,
    info: i64,
}

#[derive(Clone)]
struct Tag {
    n: i64,
    s: String,
}

#[derive(Clone)]
struct SPat {
    wild: bool,
    fam: Fam,
    tag: Tag,
    args: Vec[SPat],
}

fn wild() -> SPat {
    SPat { wild: true, fam: Fam { kind: FamK.UnitF, info: 0 }, tag: Tag { n: 0, s: String.new() }, args: Vec.new() }
}

fn sp(kind: FamK, info: i64, n: i64, args: own Vec[SPat]) -> SPat {
    SPat { wild: false, fam: Fam { kind: kind, info: info }, tag: Tag { n: n, s: String.new() }, args: args }
}

fn wilds(n: i64) -> Vec[SPat] {
    let mut v: Vec[SPat] = Vec.new();
    for _ in 0..n {
        v.push(wild());
    }
    v
}

fn same_tag(a: ref Tag, b: ref Tag) -> bool {
    a.n == b.n and a.s == b.s
}

fn slice(v: ref Vec[SPat], a: i64, b: i64) -> Vec[SPat] {
    let mut out: Vec[SPat] = Vec.new();
    for k in a..b {
        out.push(v[k].clone());
    }
    out
}

fn specialize(rows: ref Vec[Vec[SPat]], tag: ref Tag, arity: i64) -> Vec[Vec[SPat]] {
    let mut out: Vec[Vec[SPat]] = Vec.new();
    for r in rows.iter() {
        let h = ref r[0];
        if h.wild {
            let mut row = wilds(arity);
            for k in 1..r.len() {
                row.push(r[k].clone());
            }
            out.push(row);
        } else if same_tag(h.tag, tag) {
            let mut row = h.args.clone();
            for k in 1..r.len() {
                row.push(r[k].clone());
            }
            out.push(row);
        }
    }
    out
}

fn default_rows(rows: ref Vec[Vec[SPat]]) -> Vec[Vec[SPat]] {
    let mut out: Vec[Vec[SPat]] = Vec.new();
    for r in rows.iter() {
        if r[0].wild {
            out.push(slice(r, 1, r.len()));
        }
    }
    out
}

// The family of the first column and its distinct head tags.
fn heads(rows: ref Vec[Vec[SPat]]) -> (Option[Fam], Vec[Tag]) {
    let mut fam: Option[Fam] = None;
    let mut tags: Vec[Tag] = Vec.new();
    for r in rows.iter() {
        let h = ref r[0];
        if not h.wild {
            fam = Some(h.fam);
            let mut seen = false;
            for t in tags.iter() {
                if same_tag(t, h.tag) {
                    seen = true;
                }
            }
            if not seen {
                tags.push(h.tag.clone());
            }
        }
    }
    (fam, tags)
}

// ------------------------------------------------------------ helpers

fn rep(s: Str, n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(s);
    }
    out
}

fn imax(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn imin(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn levenshtein(a: Str, b: Str) -> i64 {
    let ab = a.bytes().to_vec();
    let bb = b.bytes().to_vec();
    let mut prev: Vec[i64] = Vec.new();
    for j in 0..bb.len() + 1 {
        prev.push(j);
    }
    for i in 1..ab.len() + 1 {
        let mut cur: Vec[i64] = vec![i];
        for j in 1..bb.len() + 1 {
            let cost = if ab[i - 1] == bb[j - 1] { 0 } else { 1 };
            cur.push(imin(imin(prev[j] + 1, cur[j - 1] + 1), prev[j - 1] + cost));
        }
        prev = cur;
    }
    prev[bb.len()]
}

fn inside(s: Loc, line: i64, col: i64) -> bool {
    let after_start = s.sl < line or (s.sl == line and s.sc <= col);
    let before_end = line < s.el or (line == s.el and col < s.ec);
    after_start and before_end
}

fn letter(k: i64) -> String {
    bytes_text([b'a' + k as u8].to_vec(), 0, 1)
}

fn var_name(i: i64) -> String {
    let l = letter(i % 26);
    if i >= 26 { f"'{l}{i / 26}" } else { f"'{l}" }
}

fn prelude_values() -> Vec[(String, String)] {
    [
        ("not", "bool -> bool"),
        ("print_string", "string -> unit"),
        ("print_endline", "string -> unit"),
        ("print_int", "int -> unit"),
        ("string_of_int", "int -> string"),
        ("string_of_bool", "bool -> string"),
        ("int_of_string", "string -> int"),
        ("string_length", "string -> int"),
        ("failwith", "string -> 'a"),
        ("fst", "'a * 'b -> 'a"),
        ("snd", "'a * 'b -> 'b"),
        ("ignore", "'a -> unit"),
        ("compare", "'a -> 'a -> int"),
        ("max", "'a -> 'a -> 'a"),
        ("min", "'a -> 'a -> 'a"),
    ].to_vec()
}

fn op_schemes() -> Vec[(String, String)] {
    [
        ("+", "int -> int -> int"),
        ("-", "int -> int -> int"),
        ("*", "int -> int -> int"),
        ("/", "int -> int -> int"),
        ("mod", "int -> int -> int"),
        ("^", "string -> string -> string"),
        ("@", "'a list -> 'a list -> 'a list"),
        ("&&", "bool -> bool -> bool"),
        ("||", "bool -> bool -> bool"),
        ("=", "'a -> 'a -> bool"),
        ("<>", "'a -> 'a -> bool"),
        ("<", "'a -> 'a -> bool"),
        (">", "'a -> 'a -> bool"),
        ("<=", "'a -> 'a -> bool"),
        (">=", "'a -> 'a -> bool"),
        ("::", "'a -> 'a list -> 'a list"),
    ].to_vec()
}

// ------------------------------------------------------------ the checker

struct Checker {
    fname: String,
    lines: Vec[String],
    tkind: Vec[Ty],
    tname: Vec[String],
    targs: Vec[Vec[i64]],
    tlink: Vec[i64],
    tlevel: Vec[i64],
    level: i64,
    trail: Vec[TrailE],
    env: Vec[EnvE],
    used: Vec[bool],
    types: Map[String, i64],
    tinfos: Vec[TypeInfo],
    ctors: Map[String, i64],
    cinfos: Vec[CtorInfo],
    fields: Map[String, i64],
    finfos: Vec[FieldInfo],
    ann_vars: Map[String, i64],
    records: Vec[Rec],
    out: Vec[String],
    items: Vec[ItemRec],
    op_names: Vec[String],
    op_types: Vec[i64],
    t_int: i64,
    t_bool: i64,
    t_string: i64,
    t_unit: i64,
}

fn new_checker(fname: Str, src: Str) -> Checker {
    let mut lines: Vec[String] = Vec.new();
    for l in src.split("\n") {
        lines.push(l.to_string());
    }
    let mut c = Checker {
        fname: fname.to_string(),
        lines: lines,
        tkind: Vec.new(),
        tname: Vec.new(),
        targs: Vec.new(),
        tlink: Vec.new(),
        tlevel: Vec.new(),
        level: 0,
        trail: Vec.new(),
        env: Vec.new(),
        used: Vec.new(),
        types: Map.new(),
        tinfos: Vec.new(),
        ctors: Map.new(),
        cinfos: Vec.new(),
        fields: Map.new(),
        finfos: Vec.new(),
        ann_vars: Map.new(),
        records: Vec.new(),
        out: Vec.new(),
        items: Vec.new(),
        op_names: Vec.new(),
        op_types: Vec.new(),
        t_int: 0,
        t_bool: 0,
        t_string: 0,
        t_unit: 0,
    };
    c.t_int = c.con("int", Vec.new());
    c.t_bool = c.con("bool", Vec.new());
    c.t_string = c.con("string", Vec.new());
    c.t_unit = c.con("unit", Vec.new());
    for (nm, ar) in [("int", 0), ("bool", 0), ("string", 0), ("unit", 0), ("list", 1)].to_vec() {
        let ti = c.new_typeinfo(nm, ar, KIND_ABSTRACT);
        c.types.insert(nm.to_string(), ti);
    }
    c.prelude_type("type 'a option = None | Some of 'a");
    for (nm, s) in prelude_values() {
        let t = c.scheme(s);
        c.bind(nm, t);
    }
    for (op, s) in op_schemes() {
        let t = c.scheme(s);
        c.op_names.push(op.clone());
        c.op_types.push(t);
    }
    c
}

impl Checker {
    // ---- the arena

    fn new_ty(mut ref self, kind: Ty, name: Str, args: own Vec[i64], level: i64) -> i64 {
        self.tkind.push(kind);
        self.tname.push(name.to_string());
        self.targs.push(args);
        self.tlink.push(-1);
        self.tlevel.push(level);
        self.tkind.len() - 1
    }

    fn con(mut ref self, name: Str, args: own Vec[i64]) -> i64 {
        self.new_ty(Ty.TyCon, name, args, 0)
    }

    fn arrow(mut ref self, a: i64, b: i64) -> i64 {
        self.new_ty(Ty.TyArrow, "", vec![a, b], 0)
    }

    fn tuple_ty(mut ref self, items: own Vec[i64]) -> i64 {
        self.new_ty(Ty.TyTuple, "", items, 0)
    }

    fn var(mut ref self) -> i64 {
        let l = self.level;
        self.new_ty(Ty.TyVar, "", Vec.new(), l)
    }

    fn generic_var(mut ref self) -> i64 {
        self.new_ty(Ty.TyVar, "", Vec.new(), GENERIC)
    }

    fn repr(ref self, t: i64) -> i64 {
        let mut t = t;
        while self.tkind[t] == Ty.TyVar and self.tlink[t] >= 0 {
            t = self.tlink[t];
        }
        t
    }

    fn new_typeinfo(mut ref self, name: Str, arity: i64, kind: i64) -> i64 {
        self.tinfos.push(TypeInfo {
            name: name.to_string(),
            arity: arity,
            kind: kind,
            params: Vec.new(),
            ctors: Vec.new(),
            arities: Vec.new(),
            fields: Vec.new(),
            param_names: Vec.new(),
            body: Vec.new(),
            expanding: false,
        });
        self.tinfos.len() - 1
    }

    fn scheme(mut ref self, text: Str) -> i64 {
        let toks = match lex(text) {
            Ok(t) => t,
            Err(_) => return self.generic_var(),
        };
        let first = toks[0].span;
        let mut p = Ps { toks: toks, i: 0, last: first };
        let te = match p.type_expr() {
            Ok(te) => te,
            Err(_) => return self.generic_var(),
        };
        let mut vars: Map[String, i64] = Map.new();
        match self.convert(te, mut vars, MODE_SCHEME) {
            Ok(t) => t,
            Err(_) => self.generic_var(),
        }
    }

    fn prelude_type(mut ref self, text: Str) {
        let toks = match lex(text) {
            Ok(t) => t,
            Err(_) => return,
        };
        let first = toks[0].span;
        let mut p = Ps { toks: toks, i: 0, last: first };
        if let Ok(item) = p.type_item() {
            let _ = self.declare_types(item);
        }
    }

    // ---- the environment

    fn bind(mut ref self, name: Str, t: i64) -> i64 {
        let bid = self.used.len();
        self.used.push(false);
        self.env.push(EnvE { name: name.to_string(), ty: t, bid: bid });
        bid
    }

    fn lookup(mut ref self, name: Str) -> Option[i64] {
        let mut k = self.env.len() - 1;
        while k >= 0 {
            if self.env[k].name == name {
                let bid = self.env[k].bid;
                self.used[bid] = true;
                return Some(self.env[k].ty);
            }
            k -= 1;
        }
        None
    }

    fn truncate_env(mut ref self, mark: i64) {
        while self.env.len() > mark {
            self.env.pop();
        }
    }

    fn suggest(ref self, name: Str) -> Option[String] {
        let mut best: Option[String] = None;
        let mut bestd = 99;
        let mut seen: Set[String] = Set.new();
        for e in self.env.iter() {
            if seen.contains(e.name) {
                continue;
            }
            seen.insert(e.name.clone());
            let d = levenshtein(name, e.name);
            if d <= 2 and d < name.len() {
                let better = match best {
                    None => true,
                    Some(ref b) => d < bestd or (d == bestd and e.name < *b),
                };
                if better {
                    best = Some(e.name.clone());
                    bestd = d;
                }
            }
        }
        best
    }

    // ---- type expressions

    // MODE_SCHEME makes each 'a a generic variable; MODE_DECL allows only
    // the declaration's parameters; MODE_ANN shares annotation variables
    // across the item.
    fn convert(mut ref self, te: ref TyExpr, vars: mut ref Map[String, i64], mode: i64) -> Result[i64, Diag] {
        if te.kind == TyK.TVar {
            if let Some(v) = vars.get(te.name.clone()) {
                return Ok(v);
            }
            if mode == MODE_DECL {
                return Err(diag(te.span, f"the type variable '{te.name} is unbound in this type declaration"));
            }
            let v = if mode == MODE_SCHEME { self.generic_var() } else { self.new_ty(Ty.TyVar, "", Vec.new(), 1) };
            vars.insert(te.name.clone(), v);
            return Ok(v);
        }
        if te.kind == TyK.TArrow {
            let a = self.convert(te.args[0], mut vars, mode)?;
            let b = self.convert(te.args[1], mut vars, mode)?;
            return Ok(self.arrow(a, b));
        }
        if te.kind == TyK.TTuple {
            let mut items: Vec[i64] = Vec.new();
            for x in te.args.iter() {
                items.push(self.convert(x, mut vars, mode)?);
            }
            return Ok(self.tuple_ty(items));
        }
        let info = match self.types.get(te.name.clone()) {
            Some(i) => *i,
            None => return Err(diag(te.span, f"unbound type constructor {te.name}")),
        };
        let arity = self.tinfos[info].arity;
        if arity != te.args.len() {
            return Err(diag(te.span, f"the type constructor {te.name} expects {arity} argument(s), but is here applied to {te.args.len()} argument(s)"));
        }
        let mut args: Vec[i64] = Vec.new();
        for x in te.args.iter() {
            args.push(self.convert(x, mut vars, mode)?);
        }
        if self.tinfos[info].kind == KIND_ALIAS {
            // an abbreviation is expanded where it is used
            if self.tinfos[info].expanding {
                return Err(diag(te.span, f"the type abbreviation {te.name} is cyclic"));
            }
            let body = self.tinfos[info].body[0].clone();
            let mut inner: Map[String, i64] = Map.new();
            for k in 0..args.len() {
                inner.insert(self.tinfos[info].param_names[k].clone(), args[k]);
            }
            self.tinfos[info].expanding = true;
            let r = self.convert(body, mut inner, MODE_DECL);
            self.tinfos[info].expanding = false;
            return r;
        }
        Ok(self.con(te.name, args))
    }

    fn convert_ann(mut ref self, te: ref TyExpr) -> Result[i64, Diag] {
        let mut vars = self.ann_vars.clone();
        let r = self.convert(te, mut vars, MODE_ANN);
        self.ann_vars = vars;
        r
    }

    // ---- unification

    // None on success, else the innermost pair that failed. A failure
    // undoes every link it made.
    fn unify(mut ref self, a: i64, b: i64) -> Option[UErr] {
        let mark = self.trail.len();
        let r = self.unify_rec(a, b);
        if r.is_some() {
            while self.trail.len() > mark {
                let e = self.trail.pop().unwrap();
                if e.link {
                    self.tlink[e.t] = -1;
                } else {
                    self.tlevel[e.t] = e.old;
                }
            }
        } else {
            while self.trail.len() > mark {
                self.trail.pop();
            }
        }
        r
    }

    fn occurs_adjust(mut ref self, v: i64, t: i64) -> bool {
        let t = self.repr(t);
        if t == v {
            return true;
        }
        if self.tkind[t] == Ty.TyVar {
            if self.tlevel[t] > self.tlevel[v] {
                self.trail.push(TrailE { link: false, t: t, old: self.tlevel[t] });
                self.tlevel[t] = self.tlevel[v];
            }
            return false;
        }
        let args = self.targs[t].clone();
        for x in args {
            if self.occurs_adjust(v, x) {
                return true;
            }
        }
        false
    }

    fn unify_rec(mut ref self, a: i64, b: i64) -> Option[UErr] {
        let a = self.repr(a);
        let b = self.repr(b);
        if a == b {
            return None;
        }
        let ka = self.tkind[a];
        let kb = self.tkind[b];
        if ka == Ty.TyVar or kb == Ty.TyVar {
            let (v, t) = if ka == Ty.TyVar { (a, b) } else { (b, a) };
            if self.occurs_adjust(v, t) {
                return Some(UErr { occurs: true, a: v, b: t });
            }
            self.trail.push(TrailE { link: true, t: v, old: -1 });
            self.tlink[v] = t;
            return None;
        }
        if ka != kb or self.tname[a] != self.tname[b] or self.targs[a].len() != self.targs[b].len() {
            return Some(UErr { occurs: false, a: a, b: b });
        }
        let xs = self.targs[a].clone();
        let ys = self.targs[b].clone();
        for k in 0..xs.len() {
            let r = self.unify_rec(xs[k], ys[k]);
            if r.is_some() {
                return r;
            }
        }
        None
    }

    fn explain(mut ref self, r: UErr, top_a: i64, top_b: i64) -> Vec[String] {
        if r.occurs {
            let n = self.show(vec![r.a, r.b], vec![top_a, top_b]);
            return vec![f"the type variable {n[0]} occurs inside {n[1]}"];
        }
        let ra = self.repr(r.a);
        let rb = self.repr(r.b);
        let ta = self.repr(top_a);
        let tb = self.repr(top_b);
        if (ra == ta and rb == tb) or (ra == tb and rb == ta) {
            return Vec.new();
        }
        let n = self.show(vec![r.a, r.b], vec![top_a, top_b]);
        vec![f"type {n[0]} is not compatible with type {n[1]}"]
    }

    fn check_ty(mut ref self, span: Loc, actual: i64, expected: i64) -> Result[(), Diag] {
        if let Some(r) = self.unify(actual, expected) {
            let s = self.show(vec![actual, expected], Vec.new());
            let mut d = diag(span, f"this expression has type {s[0]} but an expression was expected of type {s[1]}");
            d.notes = self.explain(r, actual, expected);
            return Err(d);
        }
        Ok(())
    }

    fn check_pat_ty(mut ref self, span: Loc, actual: i64, expected: i64) -> Result[(), Diag] {
        if let Some(r) = self.unify(actual, expected) {
            let s = self.show(vec![actual, expected], Vec.new());
            let mut d = diag(span, f"this pattern matches values of type {s[0]} but a pattern was expected which matches values of type {s[1]}");
            d.notes = self.explain(r, actual, expected);
            return Err(d);
        }
        Ok(())
    }

    // ---- levels

    fn instantiate(mut ref self, t: i64, mapping: mut ref Map[i64, i64]) -> i64 {
        let t = self.repr(t);
        let k = self.tkind[t];
        if k == Ty.TyVar {
            if self.tlevel[t] != GENERIC {
                return t;
            }
            if let Some(v) = mapping.get(t) {
                return v;
            }
            let v = self.var();
            mapping.insert(t, v);
            return v;
        }
        if self.targs[t].len() == 0 {
            return t;
        }
        let xs = self.targs[t].clone();
        let mut args: Vec[i64] = Vec.new();
        for x in xs {
            args.push(self.instantiate(x, mut mapping));
        }
        let name = self.tname[t].clone();
        self.new_ty(k, name, args, 0)
    }

    fn inst(mut ref self, t: i64) -> i64 {
        let mut m: Map[i64, i64] = Map.new();
        self.instantiate(t, mut m)
    }

    fn generalize(mut ref self, t: i64) {
        let t = self.repr(t);
        if self.tkind[t] == Ty.TyVar {
            if self.tlevel[t] > self.level and self.tlevel[t] != GENERIC {
                self.tlevel[t] = GENERIC;
            }
            return;
        }
        let xs = self.targs[t].clone();
        for x in xs {
            self.generalize(x);
        }
    }

    // ---- printing

    fn show(ref self, ts: Vec[i64], prior: Vec[i64]) -> Vec[String] {
        let mut names: Map[i64, String] = Map.new();
        for t in prior {
            self.show_one(t, mut names, 0);
        }
        let mut out: Vec[String] = Vec.new();
        for t in ts {
            out.push(self.show_one(t, mut names, 0));
        }
        out
    }

    fn show1(ref self, t: i64) -> String {
        let mut names: Map[i64, String] = Map.new();
        self.show_one(t, mut names, 0)
    }

    // ctx: 0 top, 1 arrow lhs, 2 tuple item, 3 type argument.
    fn show_one(ref self, t: i64, names: mut ref Map[i64, String], ctx: i64) -> String {
        let t = self.repr(t);
        let k = self.tkind[t];
        if k == Ty.TyVar {
            if let Some(n) = names.get(t) {
                return n.clone();
            }
            let n = var_name(names.len());
            names.insert(t, n.clone());
            return n;
        }
        if k == Ty.TyArrow {
            let a = self.show_one(self.targs[t][0], mut names, 1);
            let b = self.show_one(self.targs[t][1], mut names, 0);
            let s = a + " -> " + b;
            return if ctx >= 1 { "(" + s + ")" } else { s };
        }
        if k == Ty.TyTuple {
            let mut parts: Vec[String] = Vec.new();
            for x in self.targs[t].iter() {
                parts.push(self.show_one(*x, mut names, 2));
            }
            let s = parts.join(" * ");
            return if ctx >= 2 { "(" + s + ")" } else { s };
        }
        let n = self.targs[t].len();
        if n == 0 {
            return self.tname[t].clone();
        }
        if n == 1 {
            return self.show_one(self.targs[t][0], mut names, 3) + " " + self.tname[t];
        }
        let mut parts: Vec[String] = Vec.new();
        for x in self.targs[t].iter() {
            parts.push(self.show_one(*x, mut names, 0));
        }
        "(" + parts.join(", ") + ") " + self.tname[t]
    }

    // ---- diagnostics

    fn emit(mut ref self, d: ref Diag) {
        let sp = d.span;
        self.out.push(f"{self.fname}:{sp.sl}:{sp.sc}-{sp.el}:{sp.ec}: {d.level}: {d.msg}");
        let line = if sp.sl - 1 < self.lines.len() { self.lines[sp.sl - 1].clone() } else { String.new() };
        self.out.push(f"{sp.sl:>4} | {line}");
        let width = if sp.el == sp.sl { imax(1, sp.ec - sp.sc) } else { imax(1, line.len() - sp.sc + 1) };
        self.out.push("     | " + rep(" ", sp.sc - 1) + rep("^", width));
        for n in d.notes.iter() {
            self.out.push("  " + n);
        }
    }

    fn warn(mut ref self, span: Loc, num: i64, msg: Str, notes: own Vec[String]) {
        let d = Diag { span: span, level: f"warning {num}", msg: msg.to_string(), notes: notes };
        self.emit(d);
    }

    // ---- type declarations

    fn declare_types(mut ref self, item: ref Item) -> Result[(), Diag] {
        let saved = self.types.clone();
        let r = self.declare_inner(item);
        if r.is_err() {
            self.types = saved;
        }
        r
    }

    fn declare_inner(mut ref self, item: ref Item) -> Result[(), Diag] {
        let mut infos: Vec[i64] = Vec.new();
        for d in item.decls.iter() {
            let kind = if d.kind == DECL_RECORD { KIND_RECORD } else if d.kind == DECL_ALIAS { KIND_ALIAS } else { KIND_VARIANT };
            let ti = self.new_typeinfo(d.name, d.params.len(), kind);
            for _ in 0..d.params.len() {
                let v = self.generic_var();
                self.tinfos[ti].params.push(v);
            }
            self.tinfos[ti].param_names = d.params.clone();
            self.tinfos[ti].body = d.alias.clone();
            self.types.insert(d.name.clone(), ti);
            infos.push(ti);
        }
        let mut new_ctors: Vec[CtorInfo] = Vec.new();
        let mut new_fields: Vec[FieldInfo] = Vec.new();
        for k in 0..item.decls.len() {
            let d = ref item.decls[k];
            let ti = infos[k];
            let mut vars: Map[String, i64] = Map.new();
            for j in 0..d.params.len() {
                vars.insert(d.params[j].clone(), self.tinfos[ti].params[j]);
            }
            let ps = self.tinfos[ti].params.clone();
            let result = self.con(d.name, ps);
            if d.kind == DECL_ALIAS {
                self.convert(d.alias[0], mut vars, MODE_DECL)?;
            } else if d.kind == DECL_VARIANT {
                for idx in 0..d.ctors.len() {
                    let c = ref d.ctors[idx];
                    let mut targs: Vec[i64] = Vec.new();
                    for a in c.args.iter() {
                        targs.push(self.convert(a, mut vars, MODE_DECL)?);
                    }
                    self.tinfos[ti].ctors.push(c.name.clone());
                    self.tinfos[ti].arities.push(targs.len());
                    new_ctors.push(CtorInfo { name: c.name.clone(), tinfo: ti, index: idx, args: targs, result: result });
                }
            } else {
                for idx in 0..d.fields.len() {
                    let f = ref d.fields[idx];
                    let t = self.convert(f.ty, mut vars, MODE_DECL)?;
                    self.tinfos[ti].fields.push(f.name.clone());
                    new_fields.push(FieldInfo { name: f.name.clone(), tinfo: ti, index: idx, ty: t, result: result });
                }
            }
        }
        for c in new_ctors {
            self.cinfos.push(c.clone());
            self.ctors.insert(c.name.clone(), self.cinfos.len() - 1);
        }
        for f in new_fields {
            self.finfos.push(f.clone());
            self.fields.insert(f.name.clone(), self.finfos.len() - 1);
        }
        Ok(())
    }

    // ---- hover records

    fn note(mut ref self, span: Loc, t: i64) {
        self.records.push(Rec { span: span, ty: t });
    }

    // ---- expressions

    fn check(mut ref self, e: ref Node, expected: i64) -> Result[(), Diag] {
        if e.kind == Nk.EFun or e.kind == Nk.EFunction {
            // the expected type reaches the parameters before the body
            self.infer_fun(e, Some(expected))?;
            return Ok(());
        }
        let t = self.infer(e)?;
        self.check_ty(e.span, t, expected)
    }

    fn infer_fun(mut ref self, e: ref Node, expected: Option[i64]) -> Result[i64, Diag] {
        let r = self.var();
        self.note(e.span, r);
        if e.kind == Nk.EFunction {
            let ts = self.var();
            let res = self.var();
            let t = self.arrow(ts, res);
            if let Some(x) = expected {
                self.check_ty(e.span, t, x)?;
            }
            self.match_arms(e, ts, res)?;
            let _ = self.unify(r, t);
            return Ok(r);
        }
        let mut tps: Vec[i64] = Vec.new();
        for _ in 0..e.pats.len() {
            tps.push(self.var());
        }
        let rb = self.var();
        let mut t = rb;
        let mut k = tps.len() - 1;
        while k >= 0 {
            t = self.arrow(tps[k], t);
            k -= 1;
        }
        if let Some(x) = expected {
            self.check_ty(e.span, t, x)?;
        }
        let mark = self.env.len();
        let mut binds: Vec[Bound] = Vec.new();
        for k in 0..e.pats.len() {
            self.check_pat(e.pats[k], tps[k], mut binds)?;
        }
        self.push_binds(binds);
        for p in e.pats.iter() {
            self.exhaustive_one(p, p.span);
        }
        self.check(e.kids[0], rb)?;
        self.truncate_env(mark);
        let _ = self.unify(r, t);
        Ok(r)
    }

    fn op_type(ref self, name: Str) -> i64 {
        for k in 0..self.op_names.len() {
            if self.op_names[k] == name {
                return self.op_types[k];
            }
        }
        self.op_types[0]
    }

    fn infer(mut ref self, e: ref Node) -> Result[i64, Diag] {
        match e.kind {
            Nk.EInt => {
                let t = self.t_int;
                self.note(e.span, t);
                Ok(t)
            }
            Nk.EText => {
                let t = self.t_string;
                self.note(e.span, t);
                Ok(t)
            }
            Nk.EBool => {
                let t = self.t_bool;
                self.note(e.span, t);
                Ok(t)
            }
            Nk.EUnit => {
                let t = self.t_unit;
                self.note(e.span, t);
                Ok(t)
            }
            Nk.EVar => {
                let s = match self.lookup(e.name) {
                    Some(s) => s,
                    None => {
                        let mut msg = f"unbound value {e.name}";
                        if let Some(h) = self.suggest(e.name) {
                            msg = msg + f" (did you mean {h}?)";
                        }
                        return Err(diag(e.span, msg));
                    }
                };
                let t = self.inst(s);
                self.note(e.span, t);
                Ok(t)
            }
            Nk.EPath => Err(diag(e.fields[0].span, f"unbound module {e.fields[0].name}")),
            Nk.ECtor => {
                let r = self.var();
                self.note(e.span, r);
                let ci = match self.ctors.get(e.name.clone()) {
                    Some(c) => *c,
                    None => return Err(diag(e.span, f"unbound constructor {e.name}")),
                };
                let mode = self.ctor_args(e, ci)?;
                let mut mapping: Map[i64, i64] = Map.new();
                let res = self.instantiate(self.cinfos[ci].result, mut mapping);
                let decl = self.cinfos[ci].args.clone();
                let mut targs: Vec[i64] = Vec.new();
                for a in decl {
                    targs.push(self.instantiate(a, mut mapping));
                }
                if mode == ARGS_ONE {
                    self.check(e.kids[0], targs[0])?;
                } else if mode == ARGS_TUPLE {
                    for k in 0..targs.len() {
                        self.check(e.kids[0].kids[k], targs[k])?;
                    }
                }
                let _ = self.unify(r, res);
                Ok(r)
            }
            Nk.ETuple => {
                let r = self.var();
                self.note(e.span, r);
                let mut ts: Vec[i64] = Vec.new();
                for x in e.kids.iter() {
                    ts.push(self.infer(x)?);
                }
                let t = self.tuple_ty(ts);
                let _ = self.unify(r, t);
                Ok(r)
            }
            Nk.EList => {
                let a = self.var();
                let t = self.con("list", vec![a]);
                self.note(e.span, t);
                for x in e.kids.iter() {
                    self.check(x, a)?;
                }
                Ok(t)
            }
            Nk.EOp => {
                let r = self.var();
                self.note(e.span, r);
                let ot = self.inst(self.op_type(e.name));
                let a = self.targs[ot][0];
                let rest = self.targs[ot][1];
                let b = self.targs[rest][0];
                let res = self.targs[rest][1];
                self.check(e.kids[0], a)?;
                self.check(e.kids[1], b)?;
                let _ = self.unify(r, res);
                Ok(r)
            }
            Nk.ENeg => {
                let t = self.t_int;
                self.note(e.span, t);
                self.check(e.kids[0], t)?;
                Ok(t)
            }
            Nk.EApp => {
                let r = self.var();
                self.note(e.span, r);
                let f = ref e.kids[0];
                let mut tf = self.infer(f)?;
                let t0 = tf;
                for n in 1..e.kids.len() {
                    let mut t = self.repr(tf);
                    if self.tkind[t] == Ty.TyVar {
                        let a = self.var();
                        let b = self.var();
                        let ar = self.arrow(a, b);
                        let _ = self.unify(t, ar);
                        t = self.repr(tf);
                    }
                    if self.tkind[t] != Ty.TyArrow {
                        let s = self.show1(t0);
                        if n == 1 {
                            return Err(diag(f.span, f"this expression has type {s}. This is not a function; it cannot be applied"));
                        }
                        return Err(diag(f.span, f"this function has type {s}. It is applied to too many arguments"));
                    }
                    let pa = self.targs[t][0];
                    self.check(e.kids[n], pa)?;
                    tf = self.targs[t][1];
                }
                let _ = self.unify(r, tf);
                Ok(r)
            }
            Nk.EFun | Nk.EFunction => self.infer_fun(e, None),
            Nk.EMatch => {
                let r = self.var();
                self.note(e.span, r);
                let ts = self.infer(e.kids[0])?;
                let res = self.var();
                self.match_arms(e, ts, res)?;
                let _ = self.unify(r, res);
                Ok(r)
            }
            Nk.EIf => {
                let r = self.var();
                self.note(e.span, r);
                let tb = self.t_bool;
                self.check(e.kids[0], tb)?;
                if e.kids.len() == 2 {
                    let tu = self.t_unit;
                    self.check(e.kids[1], tu)?;
                    let _ = self.unify(r, tu);
                    return Ok(r);
                }
                let ta = self.infer(e.kids[1])?;
                self.check(e.kids[2], ta)?;
                let _ = self.unify(r, ta);
                Ok(r)
            }
            Nk.ESeq => {
                let r = self.var();
                self.note(e.span, r);
                let tu = self.t_unit;
                self.check(e.kids[0], tu)?;
                let t = self.infer(e.kids[1])?;
                let _ = self.unify(r, t);
                Ok(r)
            }
            Nk.EConstraint => {
                let r = self.var();
                self.note(e.span, r);
                let t = self.convert_ann(e.ty[0])?;
                self.check(e.kids[0], t)?;
                let _ = self.unify(r, t);
                Ok(r)
            }
            Nk.ELet => {
                let r = self.var();
                self.note(e.span, r);
                let mark = self.env.len();
                let names = self.let_bindings(e.binds, e.flag)?;
                let tb = self.infer(e.kids[0])?;
                for p in names.iter() {
                    if not self.used[p.bid] and not p.name.starts_with("_") {
                        self.warn(p.span, 26, f"unused variable {p.name}", Vec.new());
                    }
                }
                self.truncate_env(mark);
                let _ = self.unify(r, tb);
                Ok(r)
            }
            Nk.ERecord => {
                let r = self.var();
                self.note(e.span, r);
                let info = self.record_fields(e)?;
                let mut mapping: Map[i64, i64] = Map.new();
                let fi0 = self.fields.get(e.fields[0].name.clone()) ?? 0;
                let res = self.instantiate(self.finfos[fi0].result, mut mapping);
                let mut missing: Vec[String] = Vec.new();
                for fname in self.tinfos[info].fields.iter() {
                    let mut seen = false;
                    for f in e.fields.iter() {
                        if f.name == *fname {
                            seen = true;
                        }
                    }
                    if not seen {
                        missing.push(fname.clone());
                    }
                }
                if missing.len() > 0 {
                    return Err(diag(e.span, "some record fields are undefined: " + missing.join(" ")));
                }
                for f in e.fields.iter() {
                    let fi = self.fields.get(f.name.clone()) ?? 0;
                    let ft = self.instantiate(self.finfos[fi].ty, mut mapping);
                    self.check(f.value[0], ft)?;
                }
                let _ = self.unify(r, res);
                Ok(r)
            }
            Nk.EWith => {
                let r = self.var();
                self.note(e.span, r);
                self.record_fields(e)?;
                let mut mapping: Map[i64, i64] = Map.new();
                let fi0 = self.fields.get(e.fields[0].name.clone()) ?? 0;
                let res = self.instantiate(self.finfos[fi0].result, mut mapping);
                self.check(e.kids[0], res)?;
                for f in e.fields.iter() {
                    let fi = self.fields.get(f.name.clone()) ?? 0;
                    let ft = self.instantiate(self.finfos[fi].ty, mut mapping);
                    self.check(f.value[0], ft)?;
                }
                let _ = self.unify(r, res);
                Ok(r)
            }
            Nk.EField => {
                let r = self.var();
                self.note(e.span, r);
                let fname = ref e.fields[0];
                let fi = match self.fields.get(fname.name.clone()) {
                    Some(f) => *f,
                    None => return Err(diag(fname.span, f"unbound record field {fname.name}")),
                };
                let mut mapping: Map[i64, i64] = Map.new();
                let res = self.instantiate(self.finfos[fi].result, mut mapping);
                self.check(e.kids[0], res)?;
                let ft = self.instantiate(self.finfos[fi].ty, mut mapping);
                let _ = self.unify(r, ft);
                Ok(r)
            }
            _ => Err(diag(e.span, "not an expression".to_string())),
        }
    }

    // How a constructor's sub-terms are written, checking the arity:
    // none, one argument, a syntactic tuple of n, or `C _` for all n.
    fn ctor_args(ref self, e: ref Node, ci: i64) -> Result[i64, Diag] {
        let n = self.cinfos[ci].args.len();
        let mut got = 0;
        let mut mode = ARGS_NONE;
        if e.kids.len() > 0 {
            let k = e.kids[0].kind;
            if n >= 2 and (k == Nk.ETuple or k == Nk.PTuple) {
                got = e.kids[0].kids.len();
                mode = ARGS_TUPLE;
            } else if n >= 2 and k == Nk.PWild {
                return Ok(ARGS_ALL_WILD);
            } else {
                got = 1;
                mode = ARGS_ONE;
            }
        }
        if got != n {
            let name = self.cinfos[ci].name.clone();
            return Err(diag(e.span, f"the constructor {name} expects {n} argument(s), but is applied here to {got} argument(s)"));
        }
        Ok(mode)
    }

    fn record_fields(ref self, e: ref Node) -> Result[i64, Diag] {
        let f0 = ref e.fields[0];
        let first = match self.fields.get(f0.name.clone()) {
            Some(f) => f,
            None => return Err(diag(f0.span, f"unbound record field {f0.name}")),
        };
        let ti = self.finfos[first].tinfo;
        let mut seen: Set[String] = Set.new();
        for f in e.fields.iter() {
            let fi = match self.fields.get(f.name.clone()) {
                Some(x) => x,
                None => return Err(diag(f.span, f"unbound record field {f.name}")),
            };
            let other = self.finfos[fi].tinfo;
            if other != ti {
                let a = self.tinfos[other].name.clone();
                let b = self.tinfos[ti].name.clone();
                return Err(diag(f.span, f"the record field {f.name} belongs to the type {a} but is mixed here with fields of type {b}"));
            }
            if seen.contains(f.name) {
                return Err(diag(f.span, f"the record field {f.name} is defined several times"));
            }
            seen.insert(f.name.clone());
        }
        Ok(ti)
    }

    fn push_binds(mut ref self, binds: ref Vec[Bound]) -> Vec[Pushed] {
        let mut out: Vec[Pushed] = Vec.new();
        for b in binds.iter() {
            let bid = self.bind(b.name, b.ty);
            out.push(Pushed { name: b.name.clone(), span: b.span, bid: bid });
        }
        out
    }

    fn match_arms(mut ref self, e: ref Node, ts: i64, res: i64) -> Result[(), Diag] {
        let mut rows: Vec[(SPat, bool, Loc)] = Vec.new();
        for arm in e.arms.iter() {
            let mark = self.env.len();
            let mut binds: Vec[Bound] = Vec.new();
            self.check_pat(arm.pat, ts, mut binds)?;
            self.push_binds(binds);
            if arm.guard.len() > 0 {
                let tb = self.t_bool;
                self.check(arm.guard[0], tb)?;
            }
            self.check(arm.body, res)?;
            self.truncate_env(mark);
            rows.push((self.simple(arm.pat), arm.guard.len() > 0, arm.pat.span));
        }
        self.match_warnings(rows, e.span);
        Ok(())
    }

    // Binds the names of a let; returns the simple variables, for the
    // unused-variable warning.
    fn let_bindings(mut ref self, binds: ref Vec[Binding], rec: bool) -> Result[Vec[Pushed], Diag] {
        self.level += 1;
        let mut allb: Vec[Bound] = Vec.new();
        let mut tps: Vec[i64] = Vec.new();
        for b in binds.iter() {
            let tp = self.var();
            if rec {
                let p = if b.pat.kind == Nk.PConstraint { ref b.pat.kids[0] } else { ref b.pat };
                if p.kind != Nk.PVar {
                    return Err(diag(b.pat.span, "only variables are allowed as left-hand side of let rec".to_string()));
                }
                let rhs = if b.rhs.kind == Nk.EConstraint { ref b.rhs.kids[0] } else { ref b.rhs };
                if rhs.kind != Nk.EFun and rhs.kind != Nk.EFunction {
                    return Err(diag(b.rhs.span, "this kind of expression is not allowed as right-hand side of let rec".to_string()));
                }
            }
            self.check_pat(b.pat, tp, mut allb)?;
            tps.push(tp);
        }
        if rec {
            let mark = self.env.len();
            self.push_binds(allb);
            for k in 0..binds.len() {
                self.check(binds[k].rhs, tps[k])?;
            }
            self.truncate_env(mark);
        } else {
            for k in 0..binds.len() {
                self.check(binds[k].rhs, tps[k])?;
            }
        }
        self.level -= 1;
        for b in allb.iter() {
            self.generalize(b.ty);
        }
        for b in binds.iter() {
            if b.pat.kind != Nk.PVar {
                self.exhaustive_one(b.pat, b.pat.span);
            }
        }
        let ids = self.push_binds(allb);
        let mut out: Vec[Pushed] = Vec.new();
        for p in ids {
            let mut simple = false;
            for b in binds.iter() {
                if b.pat.kind == Nk.PVar and b.pat.name == p.name {
                    simple = true;
                }
            }
            if simple {
                out.push(p.clone());
            }
        }
        Ok(out)
    }

    // ---- patterns

    fn check_pat(mut ref self, p: ref Node, expected: i64, binds: mut ref Vec[Bound]) -> Result[(), Diag] {
        self.note(p.span, expected);
        match p.kind {
            Nk.PWild => Ok(()),
            Nk.PVar => {
                for b in binds.iter() {
                    if b.name == p.name {
                        return Err(diag(p.span, f"variable {p.name} is bound several times in this matching"));
                    }
                }
                binds.push(Bound { name: p.name.clone(), ty: expected, span: p.span });
                Ok(())
            }
            Nk.PInt => {
                let t = self.t_int;
                self.check_pat_ty(p.span, t, expected)
            }
            Nk.PText => {
                let t = self.t_string;
                self.check_pat_ty(p.span, t, expected)
            }
            Nk.PBool => {
                let t = self.t_bool;
                self.check_pat_ty(p.span, t, expected)
            }
            Nk.PUnit => {
                let t = self.t_unit;
                self.check_pat_ty(p.span, t, expected)
            }
            Nk.PTuple => {
                let mut vs: Vec[i64] = Vec.new();
                for _ in 0..p.kids.len() {
                    vs.push(self.var());
                }
                let t = self.tuple_ty(vs.clone());
                self.check_pat_ty(p.span, t, expected)?;
                for k in 0..p.kids.len() {
                    self.check_pat(p.kids[k], vs[k], mut binds)?;
                }
                Ok(())
            }
            Nk.PCons | Nk.PList => {
                let a = self.var();
                let lt = self.con("list", vec![a]);
                self.check_pat_ty(p.span, lt, expected)?;
                if p.kind == Nk.PCons {
                    self.check_pat(p.kids[0], a, mut binds)?;
                    self.check_pat(p.kids[1], lt, mut binds)?;
                } else {
                    for x in p.kids.iter() {
                        self.check_pat(x, a, mut binds)?;
                    }
                }
                Ok(())
            }
            Nk.PCtor => {
                let ci = match self.ctors.get(p.name.clone()) {
                    Some(c) => *c,
                    None => return Err(diag(p.span, f"unbound constructor {p.name}")),
                };
                let mode = self.ctor_args(p, ci)?;
                let mut mapping: Map[i64, i64] = Map.new();
                let res = self.instantiate(self.cinfos[ci].result, mut mapping);
                let decl = self.cinfos[ci].args.clone();
                let mut targs: Vec[i64] = Vec.new();
                for a in decl {
                    targs.push(self.instantiate(a, mut mapping));
                }
                self.check_pat_ty(p.span, res, expected)?;
                if mode == ARGS_ONE {
                    self.check_pat(p.kids[0], targs[0], mut binds)?;
                } else if mode == ARGS_TUPLE {
                    for k in 0..targs.len() {
                        self.check_pat(p.kids[0].kids[k], targs[k], mut binds)?;
                    }
                } else if mode == ARGS_ALL_WILD {
                    for k in 0..targs.len() {
                        self.note(p.kids[0].span, targs[k]);
                    }
                }
                Ok(())
            }
            Nk.PRecord => {
                self.record_fields(p)?;
                let mut mapping: Map[i64, i64] = Map.new();
                let fi0 = self.fields.get(p.fields[0].name.clone()) ?? 0;
                let res = self.instantiate(self.finfos[fi0].result, mut mapping);
                self.check_pat_ty(p.span, res, expected)?;
                for f in p.fields.iter() {
                    let fi = self.fields.get(f.name.clone()) ?? 0;
                    let ft = self.instantiate(self.finfos[fi].ty, mut mapping);
                    self.check_pat(f.value[0], ft, mut binds)?;
                }
                Ok(())
            }
            Nk.PConstraint => {
                let t = self.convert_ann(p.ty[0])?;
                self.check_pat_ty(p.span, t, expected)?;
                self.check_pat(p.kids[0], t, mut binds)
            }
            _ => Err(diag(p.span, "not a pattern".to_string())),
        }
    }

    // ---- the match warnings

    fn simple(ref self, p: ref Node) -> SPat {
        match p.kind {
            Nk.PWild | Nk.PVar => wild(),
            Nk.PConstraint => self.simple(p.kids[0]),
            Nk.PInt => sp(FamK.IntF, 0, i64.parse(p.name).unwrap_or(0), Vec.new()),
            Nk.PText => {
                let mut s = sp(FamK.StringF, 0, 0, Vec.new());
                s.tag.s = p.name.clone();
                s
            }
            Nk.PBool => sp(FamK.Boolean, 0, if p.name == "true" { 1 } else { 0 }, Vec.new()),
            Nk.PUnit => sp(FamK.UnitF, 0, 0, Vec.new()),
            Nk.PTuple => {
                let mut args: Vec[SPat] = Vec.new();
                for x in p.kids.iter() {
                    args.push(self.simple(x));
                }
                sp(FamK.TupleF, p.kids.len(), 0, args)
            }
            Nk.PCons => sp(FamK.ListF, 0, 1, vec![self.simple(p.kids[0]), self.simple(p.kids[1])]),
            Nk.PList => {
                let mut r = sp(FamK.ListF, 0, 0, Vec.new());
                let mut k = p.kids.len() - 1;
                while k >= 0 {
                    r = sp(FamK.ListF, 0, 1, vec![self.simple(p.kids[k]), r]);
                    k -= 1;
                }
                r
            }
            Nk.PCtor => {
                let ci = self.ctors.get(p.name.clone()) ?? 0;
                let c = ref self.cinfos[ci];
                let n = c.args.len();
                let mut args: Vec[SPat] = Vec.new();
                if p.kids.len() > 0 {
                    let a = ref p.kids[0];
                    if n >= 2 and a.kind == Nk.PTuple {
                        for x in a.kids.iter() {
                            args.push(self.simple(x));
                        }
                    } else if n >= 2 and a.kind == Nk.PWild {
                        args = wilds(n);
                    } else {
                        args.push(self.simple(a));
                    }
                }
                sp(FamK.Variant, c.tinfo, c.index, args)
            }
            Nk.PRecord => {
                let fi0 = self.fields.get(p.fields[0].name.clone()) ?? 0;
                let ti = self.finfos[fi0].tinfo;
                let mut args = wilds(self.tinfos[ti].fields.len());
                for f in p.fields.iter() {
                    let fi = self.fields.get(f.name.clone()) ?? 0;
                    args[self.finfos[fi].index] = self.simple(f.value[0]);
                }
                sp(FamK.RecordF, ti, 0, args)
            }
            _ => wild(),
        }
    }

    // The constructors of a finite family as (tag, arity); None for int
    // and string.
    fn signature(ref self, fam: Fam) -> Option[Vec[(i64, i64)]] {
        match fam.kind {
            FamK.Variant => {
                let mut v: Vec[(i64, i64)] = Vec.new();
                let ar = ref self.tinfos[fam.info].arities;
                for k in 0..ar.len() {
                    v.push((k, ar[k]));
                }
                Some(v)
            }
            FamK.Boolean => Some(vec![(0, 0), (1, 0)]),
            FamK.UnitF => Some(vec![(0, 0)]),
            FamK.ListF => Some(vec![(0, 0), (1, 2)]),
            FamK.TupleF => Some(vec![(0, fam.info)]),
            FamK.RecordF => Some(vec![(0, self.tinfos[fam.info].fields.len())]),
            _ => None,
        }
    }

    // A vector of n patterns that no row matches, or None when the rows
    // are exhaustive.
    fn missing(ref self, rows: ref Vec[Vec[SPat]], n: i64) -> Option[Vec[SPat]] {
        if n == 0 {
            return if rows.len() == 0 { Some(Vec.new()) } else { None };
        }
        let (fam, tags) = heads(rows);
        let sig = match fam {
            Some(f) => self.signature(f),
            None => None,
        };
        if let Some(ref sg) = sig {
            if tags.len() == sg.len() {
                let f = fam.unwrap();
                for (tag, ar) in sg.iter() {
                    let t = Tag { n: tag, s: String.new() };
                    let w = self.missing(specialize(rows, t, ar), ar + n - 1);
                    if let Some(w) = w {
                        let mut out = vec![SPat { wild: false, fam: f, tag: t, args: slice(w, 0, ar) }];
                        for k in ar..w.len() {
                            out.push(w[k].clone());
                        }
                        return Some(out);
                    }
                }
                return None;
            }
        }
        let w = match self.missing(default_rows(rows), n - 1) {
            Some(w) => w,
            None => return None,
        };
        let f = match fam {
            Some(f) => f,
            None => {
                let mut out = vec![wild()];
                out.extend(w);
                return Some(out);
            }
        };
        let mut head = wild();
        if let Some(ref sg) = sig {
            for (tag, ar) in sg.iter() {
                let mut present = false;
                for t in tags.iter() {
                    if t.n == tag {
                        present = true;
                    }
                }
                if not present {
                    head = SPat { wild: false, fam: f, tag: Tag { n: tag, s: String.new() }, args: wilds(ar) };
                    break;
                }
            }
        } else if f.kind == FamK.IntF {
            let mut v = 0;
            loop {
                let mut present = false;
                for t in tags.iter() {
                    if t.n == v {
                        present = true;
                    }
                }
                if not present {
                    break;
                }
                v += 1;
            }
            head = sp(FamK.IntF, 0, v, Vec.new());
        } else {
            let mut cands: Vec[String] = vec![String.new()];
            for k in 0..26 {
                cands.push(letter(k));
            }
            for cand in cands {
                let mut present = false;
                for t in tags.iter() {
                    if t.s == cand {
                        present = true;
                    }
                }
                if not present {
                    head = sp(FamK.StringF, 0, 0, Vec.new());
                    head.tag.s = cand.clone();
                    break;
                }
            }
        }
        let mut out = vec![head];
        out.extend(w);
        Some(out)
    }

    fn useful(ref self, rows: ref Vec[Vec[SPat]], q: ref Vec[SPat]) -> bool {
        if q.len() == 0 {
            return rows.len() == 0;
        }
        let h = ref q[0];
        if not h.wild {
            let mut q2 = h.args.clone();
            for k in 1..q.len() {
                q2.push(q[k].clone());
            }
            return self.useful(specialize(rows, h.tag, h.args.len()), q2);
        }
        let (fam, tags) = heads(rows);
        let sig = match fam {
            Some(f) => self.signature(f),
            None => None,
        };
        if let Some(ref sg) = sig {
            if tags.len() == sg.len() {
                for (tag, ar) in sg.iter() {
                    let mut q2 = wilds(ar);
                    for k in 1..q.len() {
                        q2.push(q[k].clone());
                    }
                    let t = Tag { n: tag, s: String.new() };
                    if self.useful(specialize(rows, t, ar), q2) {
                        return true;
                    }
                }
                return false;
            }
        }
        self.useful(default_rows(rows), slice(q, 1, q.len()))
    }

    // ctx: 0 top, 1 constructor argument or cons head.
    fn show_pat(ref self, p: ref SPat, ctx: i64) -> String {
        if p.wild {
            return "_".to_string();
        }
        let args = ref p.args;
        match p.fam.kind {
            FamK.IntF => f"{p.tag.n}",
            FamK.StringF => "\"" + p.tag.s + "\"",
            FamK.Boolean => if p.tag.n == 1 { "true".to_string() } else { "false".to_string() },
            FamK.UnitF => "()".to_string(),
            FamK.TupleF => {
                let mut parts: Vec[String] = Vec.new();
                for a in args.iter() {
                    parts.push(self.show_pat(a, 0));
                }
                "(" + parts.join(", ") + ")"
            }
            FamK.ListF => {
                if p.tag.n == 0 {
                    return "[]".to_string();
                }
                let s = self.show_pat(args[0], 1) + " :: " + self.show_pat(args[1], 0);
                if ctx >= 1 { "(" + s + ")" } else { s }
            }
            FamK.RecordF => {
                let names = ref self.tinfos[p.fam.info].fields;
                let mut parts: Vec[String] = Vec.new();
                for k in 0..args.len() {
                    parts.push(names[k] + " = " + self.show_pat(args[k], 0));
                }
                "{" + parts.join("; ") + "}"
            }
            FamK.Variant => {
                let name = self.tinfos[p.fam.info].ctors[p.tag.n].clone();
                if args.len() == 0 {
                    return name;
                }
                let s = if args.len() == 1 {
                    name + " " + self.show_pat(args[0], 1)
                } else {
                    let mut parts: Vec[String] = Vec.new();
                    for a in args.iter() {
                        parts.push(self.show_pat(a, 0));
                    }
                    name + " (" + parts.join(", ") + ")"
                };
                if ctx >= 1 { "(" + s + ")" } else { s }
            }
        }
    }

    fn match_warnings(mut ref self, rows: ref Vec[(SPat, bool, Loc)], span: Loc) {
        let mut matrix: Vec[Vec[SPat]] = Vec.new();
        for (p, guarded, _) in rows.iter() {
            if not guarded {
                matrix.push(vec![p.clone()]);
            }
        }
        if let Some(w) = self.missing(matrix, 1) {
            let ex = self.show_pat(w[0], 0);
            self.warn(span, 8, "this pattern-matching is not exhaustive", vec!["here is an example of a case that is not matched: " + ex]);
        }
        let mut prev: Vec[Vec[SPat]] = Vec.new();
        for (p, guarded, pspan) in rows.iter() {
            let q = vec![p.clone()];
            if not self.useful(prev, q) {
                self.warn(*pspan, 11, "this match case is unused", Vec.new());
            }
            if not guarded {
                prev.push(vec![p.clone()]);
            }
        }
    }

    fn exhaustive_one(mut ref self, p: ref Node, span: Loc) {
        let rows = vec![vec![self.simple(p)]];
        if let Some(w) = self.missing(rows, 1) {
            let ex = self.show_pat(w[0], 0);
            self.warn(span, 8, "this pattern-matching is not exhaustive", vec!["here is an example of a case that is not matched: " + ex]);
        }
    }

    // ---- items

    fn run(mut ref self, items: ref Vec[Item]) {
        for item in items.iter() {
            self.records = Vec.new();
            self.ann_vars = Map.new();
            let mark = self.env.len();
            let r = self.run_item(item);
            let ok = r.is_ok();
            if let Err(d) = r {
                self.emit(d);
                self.level = 0;
                self.truncate_env(mark);
                if not item.is_type {
                    let mut names: Vec[String] = Vec.new();
                    for b in item.binds.iter() {
                        pat_names(b.pat, mut names);
                    }
                    for nm in names {
                        let v = self.generic_var();
                        self.bind(nm, v);
                    }
                }
            }
            let recs = self.records.clone();
            self.items.push(ItemRec { span: item.span, ok: ok, recs: recs });
        }
    }

    fn run_item(mut ref self, item: ref Item) -> Result[(), Diag] {
        if item.is_type {
            self.declare_types(item)?;
            for d in item.decls.iter() {
                let mut ps: Vec[String] = Vec.new();
                for n in d.params.iter() {
                    ps.push("'" + n);
                }
                let pre = if ps.len() == 1 {
                    ps[0] + " "
                } else if ps.len() > 1 {
                    "(" + ps.join(", ") + ") "
                } else {
                    String.new()
                };
                self.out.push(f"type {pre}{d.name}");
            }
            return Ok(());
        }
        self.level = 0;
        let mark = self.env.len();
        self.let_bindings(item.binds, item.flag)?;
        for k in mark..self.env.len() {
            let s = self.show1(self.env[k].ty);
            let name = self.env[k].name.clone();
            self.out.push(f"val {name} : {s}");
        }
        Ok(())
    }

    fn hover(ref self, line: i64, col: i64) -> String {
        for it in self.items.iter() {
            if not inside(it.span, line, col) {
                continue;
            }
            if not it.ok {
                return f"{line}:{col}: no type (this item has an error)";
            }
            let mut best: Option[Rec] = None;
            for r in it.recs.iter() {
                if inside(r.span, line, col) {
                    let better = match best {
                        None => true,
                        Some(b) => r.span.eo - r.span.so < b.span.eo - b.span.so,
                    };
                    if better {
                        best = Some(*r);
                    }
                }
            }
            return match best {
                Some(b) => {
                    let s = self.show1(b.ty);
                    f"{b.span.sl}:{b.span.sc}-{b.span.el}:{b.span.ec}: {s}"
                }
                None => f"{line}:{col}: nothing here",
            };
        }
        f"{line}:{col}: nothing here"
    }
}

const ARGS_NONE: i64 = 0;
const ARGS_ONE: i64 = 1;
const ARGS_TUPLE: i64 = 2;
const ARGS_ALL_WILD: i64 = 3;

fn pat_names(p: ref Node, names: mut ref Vec[String]) {
    if p.kind == Nk.PVar {
        names.push(p.name.clone());
    }
    for x in p.kids.iter() {
        pat_names(x, mut names);
    }
    for f in p.fields.iter() {
        for v in f.value.iter() {
            pat_names(v, mut names);
        }
    }
}

// ------------------------------------------------------------ driver

fn analyse(fname: Str, src: Str) -> (Checker, bool) {
    let mut c = new_checker(fname, src);
    match parse_program(src) {
        Ok(items) => {
            c.run(items);
            (c, true)
        }
        Err(d) => {
            c.emit(d);
            (c, false)
        }
    }
}

fn unescape(s: Str) -> String {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'\\' and i + 1 < b.len() {
            let c = b[i + 1];
            out.push(if c == b'n' { b'\n' } else if c == b't' { b'\t' } else { c });
            i += 2;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    String.from_utf8(out).unwrap_or(String.new())
}

fn transcript(job: String) -> String {
    let mut out: Vec[String] = Vec.new();
    out.push("$ " + job);
    let words: Vec[String] = job.split(" ").map(|w| w.to_string()).collect();
    let mode = words[0].clone();
    if mode == "snip" {
        let src = unescape(job.substring(5));
        let (c, _) = analyse("snip.ml", src);
        out.extend(c.out);
    } else if mode == "check" or mode == "hover" {
        let name = words[1].clone();
        match fs.read_to_string("data/" + name) {
            Ok(src) => {
                let (c, parsed) = analyse(name, src);
                if mode == "check" {
                    out.extend(c.out);
                } else {
                    for k in 2..words.len() {
                        let pos = words[k].clone();
                        if not parsed {
                            out.push(f"{pos}: no type (the file does not parse)");
                            continue;
                        }
                        let (l, col) = match pos.split_once(":") {
                            Some((a, b)) => (i64.parse(a).unwrap_or(0), i64.parse(b).unwrap_or(0)),
                            None => (0, 0),
                        };
                        out.push(c.hover(l, col));
                    }
                }
            }
            Err(e) => out.push(f"! cannot read {name}: {e}"),
        }
    } else {
        out.push(f"unknown job {mode}");
    }
    out.join("\n") + "\n"
}

fn is_hexd(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in jobs.split("\n") {
        let t = l.strip_suffix("\r") ?? l;
        if t.trim().len() > 0 {
            lines.push(t.to_string());
        }
    }
    // Every job in a task of its own; the transcript prints in job order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for line in lines {
        handles.push(group.spawn(|| transcript(line)));
    }
    for h in handles.into_iter() {
        print(h.join());
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/bank.ml", unhex(file_0()))?;
    put_bytes("data/interp.ml", unhex(file_1()))?;
    put_bytes("data/jobs.txt", unhex(file_2()))?;
    put_bytes("data/json.ml", unhex(file_3()))?;
    put_bytes("data/lists.ml", unhex(file_4()))?;
    put_bytes("data/queue.ml", unhex(file_5()))?;
    put_bytes("data/shapes.ml", unhex(file_6()))?;
    Ok(())
}

