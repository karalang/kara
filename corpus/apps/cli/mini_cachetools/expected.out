job 11: script Cache(maxsize=40, getsizeof='checked')
  set 'home' '<html>home</html>' -> None
  set 'about' 'about us' -> None
  repr -> Cache({'home': '<html>home</html>', 'about': 'about us'}, maxsize=40, currsize=25)
  set 'docs' 'documentation index page' -> None
  repr -> Cache({'about': 'about us', 'docs': 'documentation index page'}, maxsize=40, currsize=32)
  currsize -> 32
  set 'about' 'about us, longer now' -> None
  repr -> Cache({'about': 'about us, longer now'}, maxsize=40, currsize=20)
  set 'huge' 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' -> ValueError('value too large')
  repr -> Cache({'about': 'about us, longer now'}, maxsize=40, currsize=20)
  set 'empty' '' -> None
  repr -> Cache({'about': 'about us, longer now', 'empty': ''}, maxsize=40, currsize=20)
  set 'home' 'h' -> None
  set 'blog' 'a blog post body' -> None
  repr -> Cache({'about': 'about us, longer now', 'empty': '', 'home': 'h', 'blog': 'a blog post body'}, maxsize=40, currsize=37)
  set 'bad' '!bad' -> ValueError('value size must be non-negative')
  repr -> Cache({'about': 'about us, longer now', 'empty': '', 'home': 'h', 'blog': 'a blog post body'}, maxsize=40, currsize=37)
  set 'edge' 'yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy' -> None
  repr -> Cache({'edge': 'yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy'}, maxsize=40, currsize=40)
  pop 'edge' -> 'yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy'
  currsize -> 0
  update (('a', 'aa'), ('b', 'bbb'), ('c', 'c')) -> None
  repr -> Cache({'a': 'aa', 'b': 'bbb', 'c': 'c'}, maxsize=40, currsize=6)
  del 'a' -> None
  del 'a' -> KeyError('a')
  repr -> Cache({'b': 'bbb', 'c': 'c'}, maxsize=40, currsize=4)
