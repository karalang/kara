// mini_mimetypes: Python 3.13's mimetypes module, ported from
// mimetypes.py. A MimeTypes database maps file extensions to media types
// and back, with a strict table (the registered types) and a lenient one
// (common types that are not registered), plus the suffix map that turns
// `.tgz` into `.tar.gz` and the encodings map for `.gz`, `.Z`, `.bz2`,
// `.xz` and `.br`.
//
// The port covers guess_type over paths and URLs (with the parts of
// urllib.parse.urlsplit it runs, IPv6 bracket checks included, and data:
// URLs), guess_file_type, guess_extension, guess_all_extensions,
// add_type, reading mime.types files the way readfp splits them,
// read_mime_types, the module-level database with init() and its
// knownfiles, and `python -m mimetypes` with getopt's errors.
//
// The run writes data/ first: data/jobs.tsv, the mime.types files and
// the inputs of the programs. The last jobs are programs: a static file
// server choosing Content-type as http.server does, an nginx `types`
// block compared with mime.types, an upload validator, an object store
// upload plan, mail attachments, content negotiation over Accept
// headers, a CDN log summed by type and a shared-drive inventory.

// ------------------------------------------------------------ text

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// str.split(sep, 1)
fn split_once(s: ref String, sep: char) -> Option[(String, String)] {
    let v = chars(s);
    for i in 0..v.len() {
        if v[i] == sep {
            return Some((slice(v, 0, i), slice(v, i + 1, v.len())));
        }
    }
    None
}

fn join(parts: ref Vec[String], sep: ref String) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn slice(v: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = lo;
    while i < hi {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn has_char(s: ref String, c: char) -> bool {
    for d in s.chars() {
        if d == c {
            return true;
        }
    }
    false
}

// str.find(c, start); -1 when absent
fn find_from(v: ref Vec[char], c: char, start: i64) -> i64 {
    let mut i = start;
    while i < v.len() {
        if v[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn rfind_char(v: ref Vec[char], c: char) -> i64 {
    let mut i = v.len() - 1;
    while i >= 0 {
        if v[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

// The characters str.split() and str.strip() treat as whitespace.
fn is_py_space(c: char) -> bool {
    let n = c as u32;
    (n >= 9 and n <= 13) or (n >= 28 and n <= 32) or n == 0x85 or n == 0xa0 or n == 0x1680
        or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029 or n == 0x202f
        or n == 0x205f or n == 0x3000
}

fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if is_py_space(c) {
            if not cur.is_empty() {
                out.push(cur);
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn strip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and is_py_space(v[lo]) {
        lo += 1;
    }
    while hi > lo and is_py_space(v[hi - 1]) {
        hi -= 1;
    }
    slice(v, lo, hi)
}

fn pad_left(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let w = s.chars().count();
    for _ in w..n {
        out.push(' ');
    }
    out.push_str(s);
    out
}

fn pad_right(s: ref String, n: i64) -> String {
    let mut out = s.clone();
    let w = s.chars().count();
    for _ in w..n {
        out.push(' ');
    }
    out
}

fn lower(s: ref String) -> String {
    s.to_lowercase()
}

const HEX: Str = "0123456789abcdef";

fn hex2(n: u32) -> String {
    let d = chars(HEX.to_string());
    let mut out = String.new();
    out.push(d[((n >> 4) & 15) as i64]);
    out.push(d[(n & 15) as i64]);
    out
}

fn hex_val(c: char) -> i64 {
    let d = chars(HEX.to_string());
    let l = lower(f"{c}");
    let lc = chars(l)[0];
    for i in 0..16 {
        if d[i] == lc {
            return i;
        }
    }
    -1
}

fn is_hex_digit(c: char) -> bool {
    (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_ascii_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

// ------------------------------------------------------------ Python reprs

fn repr_str(s: ref String) -> String {
    let q = if has_char(s, '\'') and not has_char(s, '"') { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as u32;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if n < 32 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
            out.push_str(f"\\x{hex2(n)}");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn repr_opt(s: ref Option[String]) -> String {
    match s {
        Some(t) => repr_str(t),
        None => "None".to_string(),
    }
}

fn repr_pair(t: ref (Option[String], Option[String])) -> String {
    f"({repr_opt(t.0)}, {repr_opt(t.1)})"
}

fn repr_strs(v: ref Vec[String]) -> String {
    let r: Vec[String] = v.iter().map(|s| repr_str(s)).collect();
    f"[{join(r, ", ")}]"
}

fn opt_or(s: ref Option[String], d: Str) -> String {
    match s {
        Some(t) => t.clone(),
        None => d.to_string(),
    }
}

// ------------------------------------------------------------ an ordered str -> str map

// A Python dict of str to str: lookups through a Map, and the keys in
// the order they were first set, as the dict keeps them.
struct OMap {
    keys: Vec[String],
    m: Map[String, String],
}

impl OMap {
    fn new() -> OMap {
        OMap { keys: Vec.new(), m: Map.new() }
    }

    fn set(mut ref self, k: ref String, v: ref String) {
        if not self.m.contains_key(k) {
            self.keys.push(k.clone());
        }
        self.m.insert(k.clone(), v.clone());
    }

    fn get(ref self, k: ref String) -> Option[String] {
        match self.m.get(k) {
            Some(v) => Some(v.clone()),
            None => None,
        }
    }

    fn has(ref self, k: ref String) -> bool {
        self.m.contains_key(k)
    }

    fn len(ref self) -> i64 {
        self.keys.len()
    }

    fn copy(ref self) -> OMap {
        let mut o = OMap.new();
        for k in self.keys.iter() {
            o.set(k, self.m.get(k).unwrap());
        }
        o
    }

    // repr() of the dict, or of the entries `keep` says yes to.
    fn repr_where(ref self, keep: ref OMap, only_new: bool) -> String {
        let mut parts: Vec[String] = Vec.new();
        for k in self.keys.iter() {
            let v = self.m.get(k).unwrap();
            if only_new {
                match keep.get(k) {
                    Some(d) => {
                        if d == *v {
                            continue;
                        }
                    }
                    None => {}
                }
            }
            parts.push(f"{repr_str(k)}: {repr_str(v)}");
        }
        f"{{{join(parts, ", ")}}}"
    }
}

// ------------------------------------------------------------ errors

struct Exc {
    kind: String,
    msg: String,
}

fn value_error(msg: ref String) -> Exc {
    Exc { kind: "ValueError".to_string(), msg: msg.clone() }
}

fn not_found(path: ref String) -> Exc {
    Exc {
        kind: "FileNotFoundError".to_string(),
        msg: f"[Errno 2] No such file or directory: {repr_str(path)}",
    }
}

fn show_exc(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

// ------------------------------------------------------------ urllib.parse, the parts guess_type runs

const SCHEME_CHARS: Str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-.";

fn is_scheme_char(c: char) -> bool {
    for d in SCHEME_CHARS.chars() {
        if d == c {
            return true;
        }
    }
    false
}

const USES_PARAMS: Array[Str, 16] = [
    "", "ftp", "hdl", "prospero", "http", "imap", "https", "shttp", "rtsp", "rtsps", "rtspu",
    "sip", "sips", "mms", "sftp", "tel",
];

struct Split {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
    fragment: String,
}

// ipaddress.IPv4Address's parse: four decimal octets, no leading zeros.
fn is_ipv4(s: ref String) -> bool {
    let parts = split_on(s, '.');
    if parts.len() != 4 {
        return false;
    }
    for p in parts.iter() {
        let v = chars(p);
        if v.len() == 0 or v.len() > 3 {
            return false;
        }
        for c in v.iter() {
            if not is_digit(*c) {
                return false;
            }
        }
        if v.len() > 1 and v[0] == '0' {
            return false;
        }
        let n = i64.parse(p).unwrap_or(999);
        if n > 255 {
            return false;
        }
    }
    true
}

fn is_hextet(s: ref String) -> bool {
    let v = chars(s);
    if v.len() == 0 or v.len() > 4 {
        return false;
    }
    for c in v.iter() {
        if not is_hex_digit(*c) {
            return false;
        }
    }
    true
}

// ipaddress.IPv6Address's parse (_ip_int_from_string), as a yes or no.
fn is_ipv6(s: ref String) -> bool {
    let mut addr = s.clone();
    match split_once(s, '%') {
        Some((a, scope)) => {
            if scope.is_empty() or has_char(scope, '%') {
                return false;
            }
            addr = a;
        }
        None => {}
    }
    let mut parts = split_on(addr, ':');
    if parts.len() < 3 {
        return false;
    }
    let last = parts[parts.len() - 1].clone();
    if has_char(last, '.') {
        if not is_ipv4(last) {
            return false;
        }
        parts.pop();
        parts.push("0".to_string());
        parts.push("0".to_string());
    }
    if parts.len() > 9 {
        return false;
    }
    let n = parts.len();
    let mut skip: i64 = -1;
    let mut i = 1;
    while i < n - 1 {
        if parts[i].is_empty() {
            if skip >= 0 {
                return false;
            }
            skip = i;
        }
        i += 1;
    }
    let mut hi: i64 = 0;
    let mut lo: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = n - skip - 1;
        if parts[0].is_empty() {
            hi -= 1;
            if hi != 0 {
                return false;
            }
        }
        if parts[n - 1].is_empty() {
            lo -= 1;
            if lo != 0 {
                return false;
            }
        }
        if 8 - (hi + lo) < 1 {
            return false;
        }
    } else {
        if n != 8 {
            return false;
        }
        if parts[0].is_empty() or parts[n - 1].is_empty() {
            return false;
        }
        hi = n;
        lo = 0;
    }
    for k in 0..hi {
        if not is_hextet(parts[k]) {
            return false;
        }
    }
    for k in 0..lo {
        if not is_hextet(parts[n - lo + k]) {
            return false;
        }
    }
    true
}

// _check_bracketed_host
fn check_bracketed_host(host: ref String) -> Result[(), Exc] {
    if host.starts_with("v") or host.starts_with("V") {
        // \A[vV][a-fA-F0-9]+\..+\Z
        let v = chars(host);
        let mut i = 1;
        while i < v.len() and is_hex_digit(v[i]) {
            i += 1;
        }
        let mut ok = i > 1 and i < v.len() and v[i] == '.';
        if ok {
            let rest = slice(v, i + 1, v.len());
            ok = not rest.is_empty() and not has_char(rest, '\n');
        }
        if not ok {
            return Err(value_error("IPvFuture address is invalid"));
        }
        return Ok(());
    }
    if is_ipv4(host) {
        return Err(value_error("An IPv4 address cannot be in brackets"));
    }
    if not is_ipv6(host) {
        return Err(value_error(f"{repr_str(host)} does not appear to be an IPv4 or IPv6 address"));
    }
    Ok(())
}

// str.partition(c)
fn partition(s: ref String, c: char) -> (String, bool, String) {
    match split_once(s, c) {
        Some((a, b)) => (a, true, b),
        None => (s.clone(), false, String.new()),
    }
}

fn rpartition_after(s: ref String, c: char) -> String {
    let v = chars(s);
    let i = rfind_char(v, c);
    if i < 0 {
        s.clone()
    } else {
        slice(v, i + 1, v.len())
    }
}

fn check_bracketed_netloc(netloc: ref String) -> Result[(), Exc] {
    let hp = rpartition_after(netloc, '@');
    let (before, have, bracketed) = partition(hp, '[');
    let mut host = String.new();
    if have {
        if not before.is_empty() {
            return Err(value_error("Invalid IPv6 URL"));
        }
        let (h, _, port) = partition(bracketed, ']');
        if not port.is_empty() and not port.starts_with(":") {
            return Err(value_error("Invalid IPv6 URL"));
        }
        host = h;
    } else {
        let (h, _, _) = partition(hp, ':');
        host = h;
    }
    check_bracketed_host(host)
}

fn is_c0_or_space(c: char) -> bool {
    (c as u32) <= 32
}

fn urlsplit(url0: ref String) -> Result[Split, Exc] {
    // url.lstrip(C0 control or space), then drop tab, CR and LF
    let v0 = chars(url0);
    let mut lo = 0;
    while lo < v0.len() and is_c0_or_space(v0[lo]) {
        lo += 1;
    }
    let mut url = String.new();
    for k in lo..v0.len() {
        let c = v0[k];
        if c != '\t' and c != '\r' and c != '\n' {
            url.push(c);
        }
    }
    let mut scheme = String.new();
    let mut netloc = String.new();
    let mut query = String.new();
    let mut fragment = String.new();
    let v = chars(url);
    let i = find_from(v, ':', 0);
    if i > 0 and (v[0] as u32) < 128 and is_ascii_alpha(v[0]) {
        let mut all = true;
        for k in 0..i {
            if not is_scheme_char(v[k]) {
                all = false;
                break;
            }
        }
        if all {
            scheme = lower(slice(v, 0, i));
            url = slice(v, i + 1, v.len());
        }
    }
    if url.starts_with("//") {
        let w = chars(url);
        let mut delim = w.len();
        for c in ['/', '?', '#'] {
            let d = find_from(w, c, 2);
            if d >= 0 and d < delim {
                delim = d;
            }
        }
        netloc = slice(w, 2, delim);
        url = slice(w, delim, w.len());
        let ob = has_char(netloc, '[');
        let cb = has_char(netloc, ']');
        if (ob and not cb) or (cb and not ob) {
            return Err(value_error("Invalid IPv6 URL"));
        }
        if ob and cb {
            check_bracketed_netloc(netloc)?;
        }
    }
    if has_char(url, '#') {
        let (a, b) = split_once(url, '#').unwrap();
        url = a;
        fragment = b;
    }
    if has_char(url, '?') {
        let (a, b) = split_once(url, '?').unwrap();
        url = a;
        query = b;
    }
    Ok(Split { scheme, netloc, path: url, query, fragment })
}

// urlparse(url).path: urlsplit, then the params cut off for the schemes
// that have them.
fn urlparse_path(url: ref String) -> Result[(String, String), Exc] {
    let s = urlsplit(url)?;
    let mut path = s.path.clone();
    let mut uses = false;
    for u in USES_PARAMS {
        if s.scheme == u {
            uses = true;
        }
    }
    if uses and has_char(path, ';') {
        let v = chars(path);
        if has_char(path, '/') {
            let i = find_from(v, ';', rfind_char(v, '/'));
            if i >= 0 {
                path = slice(v, 0, i);
            }
        } else {
            let i = find_from(v, ';', 0);
            path = slice(v, 0, i);
        }
    }
    Ok((s.scheme, path))
}

// ------------------------------------------------------------ posixpath.splitext

fn splitext(p: ref String) -> (String, String) {
    let v = chars(p);
    let sep = rfind_char(v, '/');
    let dot = rfind_char(v, '.');
    if dot > sep {
        let mut k = sep + 1;
        while k < dot {
            if v[k] != '.' {
                return (slice(v, 0, dot), slice(v, dot, v.len()));
            }
            k += 1;
        }
    }
    (p.clone(), String.new())
}

// ------------------------------------------------------------ the database

struct MimeTypes {
    encodings_map: OMap,
    suffix_map: OMap,
    strict_map: OMap,
    lax_map: OMap,
    strict_inv: Map[String, Vec[String]],
    lax_inv: Map[String, Vec[String]],
}

fn default_suffix_map() -> OMap {
    let mut m = OMap.new();
    for (k, v) in [
        (".svgz", ".svg.gz"), (".tgz", ".tar.gz"), (".taz", ".tar.gz"), (".tz", ".tar.gz"),
        (".tbz2", ".tar.bz2"), (".txz", ".tar.xz"),
    ] {
        m.set(k.to_string(), v.to_string());
    }
    m
}

fn default_encodings_map() -> OMap {
    let mut m = OMap.new();
    for (k, v) in [(".gz", "gzip"), (".Z", "compress"), (".bz2", "bzip2"), (".xz", "xz"), (".br", "br")] {
        m.set(k.to_string(), v.to_string());
    }
    m
}

