        (".gtar", "application/x-gtar"), (".hdf", "application/x-hdf"),
        (".h5", "application/x-hdf5"), (".latex", "application/x-latex"),
        (".mif", "application/x-mif"), (".cdf", "application/x-netcdf"),
        (".nc", "application/x-netcdf"), (".p12", "application/x-pkcs12"),
        (".pfx", "application/x-pkcs12"), (".ram", "application/x-pn-realaudio"),
        (".pyc", "application/x-python-code"), (".pyo", "application/x-python-code"),
