        (".aac", "audio/aac"), (".adts", "audio/aac"), (".loas", "audio/aac"), (".ass", "audio/aac"),
        (".au", "audio/basic"), (".snd", "audio/basic"), (".mp3", "audio/mpeg"),
        (".mp2", "audio/mpeg"), (".opus", "audio/opus"), (".aif", "audio/x-aiff"),
        (".aifc", "audio/x-aiff"), (".aiff", "audio/x-aiff"), (".ra", "audio/x-pn-realaudio"),
        (".wav", "audio/x-wav"), (".avif", "image/avif"), (".bmp", "image/bmp"),
        (".gif", "image/gif"), (".ief", "image/ief"), (".jpg", "image/jpeg"),
        (".jpe", "image/jpeg"), (".jpeg", "image/jpeg"), (".heic", "image/heic"),
        (".heif", "image/heif"), (".png", "image/png"), (".svg", "image/svg+xml"),
        (".tiff", "image/tiff"), (".tif", "image/tiff"), (".ico", "image/vnd.microsoft.icon"),
        (".webp", "image/webp"), (".ras", "image/x-cmu-raster"),
        (".pnm", "image/x-portable-anymap"), (".pbm", "image/x-portable-bitmap"),
        (".pgm", "image/x-portable-graymap"), (".ppm", "image/x-portable-pixmap"),
        (".rgb", "image/x-rgb"), (".xbm", "image/x-xbitmap"), (".xpm", "image/x-xpixmap"),
        (".xwd", "image/x-xwindowdump"), (".eml", "message/rfc822"), (".mht", "message/rfc822"),
        (".mhtml", "message/rfc822"), (".nws", "message/rfc822"), (".css", "text/css"),
        (".csv", "text/csv"), (".html", "text/html"), (".htm", "text/html"),
        (".md", "text/markdown"), (".markdown", "text/markdown"), (".n3", "text/n3"),
        (".txt", "text/plain"), (".bat", "text/plain"), (".c", "text/plain"), (".h", "text/plain"),
        (".ksh", "text/plain"), (".pl", "text/plain"), (".srt", "text/plain"),
        (".rtx", "text/richtext"), (".rtf", "text/rtf"), (".tsv", "text/tab-separated-values"),
        (".vtt", "text/vtt"), (".py", "text/x-python"), (".rst", "text/x-rst"),
        (".etx", "text/x-setext"), (".sgm", "text/x-sgml"), (".sgml", "text/x-sgml"),
        (".vcf", "text/x-vcard"), (".xml", "text/xml"), (".mp4", "video/mp4"),
        (".mpeg", "video/mpeg"), (".m1v", "video/mpeg"), (".mpa", "video/mpeg"),
        (".mpe", "video/mpeg"), (".mpg", "video/mpeg"), (".mov", "video/quicktime"),
        (".qt", "video/quicktime"), (".webm", "video/webm"), (".avi", "video/x-msvideo"),
        (".movie", "video/x-sgi-movie"),
    ]
}

fn default_common_types() -> Vec[(Str, Str)] {
    vec![
        (".rtf", "application/rtf"), (".midi", "audio/midi"), (".mid", "audio/midi"),
        (".jpg", "image/jpg"), (".pict", "image/pict"), (".pct", "image/pict"),
        (".pic", "image/pict"), (".xul", "text/xul"),
    ]
}

fn read_file(path: ref String) -> Result[String, Exc] {
    match fs.read_to_string(path.clone()) {
        Ok(t) => Ok(t),
        Err(_) => Err(not_found(path)),
    }
}

impl MimeTypes {
    fn new() -> MimeTypes {
        let mut db = MimeTypes {
            encodings_map: default_encodings_map(),
            suffix_map: default_suffix_map(),
            strict_map: OMap.new(),
            lax_map: OMap.new(),
            strict_inv: Map.new(),
            lax_inv: Map.new(),
        };
        for (ext, t) in default_types() {
            db.add_type(t.to_string(), ext.to_string(), true);
        }
        for (ext, t) in default_common_types() {
            db.add_type(t.to_string(), ext.to_string(), false);
        }
        db
    }

    // MimeTypes(filenames, strict)
    fn with_files(files: ref Vec[String], strict: bool) -> Result[MimeTypes, Exc] {
        let mut db = MimeTypes.new();
        for f in files.iter() {
            db.read(f, strict)?;
        }
        Ok(db)
    }

    fn add_type(mut ref self, t: ref String, ext: ref String, strict: bool) {
        if t.is_empty() {
            return;
        }
        if strict {
            self.strict_map.set(ext, t);
            if not self.strict_inv.contains_key(t) {
                self.strict_inv.insert(t.clone(), Vec.new());
            }
            let exts = self.strict_inv.get_mut(t).unwrap();
            if not exts.contains(ext) {
                exts.push(ext.clone());
            }
        } else {
            self.lax_map.set(ext, t);
            if not self.lax_inv.contains_key(t) {
                self.lax_inv.insert(t.clone(), Vec.new());
            }
            let exts = self.lax_inv.get_mut(t).unwrap();
            if not exts.contains(ext) {
                exts.push(ext.clone());
            }
        }
    }

    fn guess_type(ref self, url: ref String, strict: bool) -> Result[(Option[String], Option[String]), Exc] {
        let (scheme, path) = urlparse_path(url)?;
        if scheme.chars().count() <= 1 {
            return Ok(self.guess_file_type(url, strict));
        }
        if scheme == "data" {
            let v = chars(path);
            let comma = find_from(v, ',', 0);
            if comma < 0 {
                return Ok((None, None));
            }
            let mut semi: i64 = -1;
            for k in 0..comma {
                if v[k] == ';' {
                    semi = k;
                    break;
                }
            }
            let mut t = if semi >= 0 { slice(v, 0, semi) } else { slice(v, 0, comma) };
            if has_char(t, '=') or not has_char(t, '/') {
                t = "text/plain".to_string();
            }
            return Ok((Some(t), None));
        }
        Ok(self.guess_path(path, strict))
    }

    fn guess_file_type(ref self, path: ref String, strict: bool) -> (Option[String], Option[String]) {
        self.guess_path(path, strict)
    }

    fn guess_path(ref self, path: ref String, strict: bool) -> (Option[String], Option[String]) {
        let mut (base, ext) = splitext(path);
        loop {
            match self.suffix_map.get(lower(ext)) {
                Some(s) => {
                    let (b, e) = splitext(f"{base}{s}");
                    base = b;
                    ext = e;
                }
                None => break,
            }
        }
        let mut encoding: Option[String] = None;
        match self.encodings_map.get(ext) {
            Some(e) => {
                encoding = Some(e);
                let (b, x) = splitext(base);
                base = b;
                ext = x;
            }
            None => {}
        }
        let ext = lower(ext);
        match self.strict_map.get(ext) {
            Some(t) => return (Some(t), encoding),
            None => {}
        }
        if strict {
            return (None, encoding);
        }
        (self.lax_map.get(ext), encoding)
    }

    fn guess_all_extensions(ref self, t: ref String, strict: bool) -> Vec[String] {
        let t = lower(t);
        let mut out: Vec[String] = match self.strict_inv.get(t) {
            Some(v) => v.clone(),
            None => Vec.new(),
        };
        if not strict {
            match self.lax_inv.get(t) {
                Some(v) => {
                    for e in v.iter() {
                        if not out.contains(e) {
                            out.push(e.clone());
                        }
                    }
                }
                None => {}
            }
        }
        out
    }

    fn guess_extension(ref self, t: ref String, strict: bool) -> Option[String] {
        let v = self.guess_all_extensions(t, strict);
        if v.is_empty() {
            None
        } else {
            Some(v[0].clone())
        }
    }

    fn read(mut ref self, path: ref String, strict: bool) -> Result[(), Exc] {
        let text = read_file(path)?;
        self.readfp(text, strict);
        Ok(())
    }

    // readfp: one line at a time (readline keeps the line ending), split
    // on whitespace, cut at the first word that starts with '#'.
    fn readfp(mut ref self, text: ref String, strict: bool) {
        for line in split_on(text, '\n') {
            let mut words: Vec[String] = Vec.new();
            for w in split_ws(line).into_iter() {
                if w.starts_with("#") {
                    break;
                }
                words.push(w);
            }
            if words.is_empty() {
                continue;
            }
            let t = words[0].clone();
            for k in 1..words.len() {
                self.add_type(t, f".{words[k]}", strict);
            }
        }
    }
}

// read_mime_types(file): the strict map of a fresh database that has read
// the file, or None when it cannot be opened.
fn read_mime_types(path: ref String) -> Option[OMap] {
    match read_file(path) {
        Ok(text) => {
            let mut db = MimeTypes.new();
            db.readfp(text, true);
            Some(db.strict_map.copy())
        }
        Err(_) => None,
    }
}

// ------------------------------------------------------------ the module

// mimetypes' module state: knownfiles and the database init() made.
const KNOWNFILES: Array[Str, 3] = ["data/system/mime.types", "data/apache/mime.types", "data/missing/mime.types"];

struct Module {
    db: Option[MimeTypes],
}

fn is_file(path: ref String) -> bool {
    fs.read_to_string(path.clone()).is_ok()
}

impl Module {
    fn new() -> Module {
        Module { db: None }
    }

    fn init(mut ref self, files: Option[Vec[String]]) {
        let mut list: Vec[String] = Vec.new();
        let fresh = files.is_none() or self.db.is_none();
        if fresh {
            for k in KNOWNFILES {
                list.push(k.to_string());
            }
        }
        match files {
            Some(fs_) => {
                for f in fs_.iter() {
                    list.push(f.clone());
                }
            }
            None => {}
        }
        let mut db = if fresh {
            MimeTypes.new()
        } else {
            self.db.take().unwrap()
        };
        for f in list.iter() {
            if is_file(f) {
                let _ = db.read(f, true);
            }
        }
        self.db = Some(db);
    }

    fn ensure(mut ref self) {
        if self.db.is_none() {
            self.init(None);
        }
    }

    fn guess_type(mut ref self, url: ref String, strict: bool) -> Result[(Option[String], Option[String]), Exc] {
        self.ensure();
        match self.db {
            Some(ref d) => d.guess_type(url, strict),
            None => Ok((None, None)),
        }
    }

    fn guess_extension(mut ref self, t: ref String, strict: bool) -> Option[String] {
        self.ensure();
        match self.db {
            Some(ref d) => d.guess_extension(t, strict),
            None => None,
        }
    }

    fn add_type(mut ref self, t: ref String, ext: ref String, strict: bool) {
        self.ensure();
        match self.db {
            Some(mut ref d) => d.add_type(t, ext, strict),
            None => {}
        }
    }
}

// ------------------------------------------------------------ the jobs

// A '\\' and a '\xNN' in a job argument stand for one character.
fn unesc(s: ref String) -> String {
    let v = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        if v[i] == '\\' and i + 1 < v.len() {
            if v[i + 1] == '\\' {
                out.push('\\');
                i += 2;
                continue;
            }
            if v[i + 1] == 'x' and i + 3 < v.len() {
                let n = hex_val(v[i + 2]) * 16 + hex_val(v[i + 3]);
                out.push((n as u8) as char);
                i += 4;
                continue;
            }
        }
        out.push(v[i]);
        i += 1;
    }
    out
}

fn strict_arg(flag: ref String) -> String {
    if flag == "1" { String.new() } else { ", strict=False".to_string() }
}

fn show_pair(head: ref String, r: ref Result[(Option[String], Option[String]), Exc]) {
    match r {
        Ok(t) => println(f"{head} = {repr_pair(t)}"),
        Err(e) => println(f"{head} -> {show_exc(e)}"),
    }
}

fn data_paths(f: ref Vec[String], from: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut i = from;
    while i < f.len() {
        out.push(f"data/{f[i]}");
        i += 1;
    }
    out
}

fn run_job(name: ref String, lines: ref Vec[String], m: mut ref Module, defaults: ref OMap) {
    println(f"== {name}");
    let mut db = MimeTypes.new();
    m.ensure();
    for line in lines.iter() {
        let f: Vec[String] = split_on(line, '\t').iter().map(|x| unesc(x)).collect();
        let op = f[0].clone();
        let flag = if f.len() > 1 { f[1].clone() } else { String.new() };
        let s = flag == "1";
        let arg = if f.len() > 2 { f[2].clone() } else { String.new() };
        let sa = strict_arg(flag);
        if op == "type" {
            show_pair(f"guess_type({repr_str(arg)}{sa})", db.guess_type(arg, s));
        } else if op == "ftype" {
            let r: Result[(Option[String], Option[String]), Exc] = Ok(db.guess_file_type(arg, s));
            show_pair(f"guess_file_type({repr_str(arg)}{sa})", r);
        } else if op == "ext" {
            println(f"guess_extension({repr_str(arg)}{sa}) = {repr_opt(db.guess_extension(arg, s))}");
        } else if op == "exts" {
            println(f"guess_all_extensions({repr_str(arg)}{sa}) = {repr_strs(db.guess_all_extensions(arg, s))}");
        } else if op == "gtype" {
            show_pair(f"mimetypes.guess_type({repr_str(arg)}{sa})", m.guess_type(arg, s));
        } else if op == "gext" {
            println(f"mimetypes.guess_extension({repr_str(arg)}{sa}) = {repr_opt(m.guess_extension(arg, s))}");
        } else if op == "add" {
            db.add_type(f[2], f[3], s);
            println(f"add_type({repr_str(f[2])}, {repr_str(f[3])}{sa})");
        } else if op == "gadd" {
            m.add_type(f[2], f[3], s);
            println(f"mimetypes.add_type({repr_str(f[2])}, {repr_str(f[3])}{sa})");
        } else if op == "read" {
            let path = f"data/{f[2]}";
            match db.read(path, s) {
                Ok(_) => println(f"read({repr_str(path)}{sa})"),
                Err(e) => println(f"read({repr_str(path)}{sa}) -> {show_exc(e)}"),
            }
        } else if op == "readmt" {
            let path = f"data/{f[1]}";
            match read_mime_types(path) {
                None => println(f"read_mime_types({repr_str(path)}) = None"),
                Some(r) => println(
                    f"read_mime_types({repr_str(path)}) = {r.len()} entries; from the file: {r.repr_where(defaults, true)}",
                ),
            }
        } else if op == "init" {
            let files = data_paths(f, 1);
            if files.is_empty() {
                m.init(None);
                println("mimetypes.init()");
            } else {
                m.init(Some(files.clone()));
                println(f"mimetypes.init({repr_strs(files)})");
            }
        } else if op == "maps" {
            m.ensure();
            match m.db {
                Some(ref d) => {
                    println(f"suffix_map = {d.suffix_map.repr_where(defaults, false)}");
                    println(f"encodings_map = {d.encodings_map.repr_where(defaults, false)}");
                    println(
                        f"types_map: {d.strict_map.len()} entries; from files: {d.strict_map.repr_where(defaults, true)}",
                    );
                    println(f"common_types = {d.lax_map.repr_where(defaults, false)}");
                }
                None => {}
            }
        } else if op == "new" or op == "new0" {
            let files = data_paths(f, 1);
            let st = op == "new";
            let sa2 = if st { String.new() } else { ", strict=False".to_string() };
            match MimeTypes.with_files(files, st) {
                Ok(d) => {
                    db = d;
                    println(f"MimeTypes({repr_strs(files)}{sa2})");
                }
                Err(e) => println(f"MimeTypes({repr_strs(files)}{sa2}) -> {show_exc(e)}"),
            }
        } else {
            println(f"bad op {op}");
        }
    }
}

// ------------------------------------------------------------ python -m mimetypes

const USAGE: Array[Str, 9] = [
    "Usage: mimetypes.py [options] type",
    "",
    "Options:",
    "    --help / -h       -- print this message and exit",
    "    --lenient / -l    -- additionally search of some common, but non-standard",
    "                         types.",
    "    --extension / -e  -- guess extension instead of type",
    "",
    "More than one type argument may be given.",
];

// getopt.long_has_args over ["help", "lenient", "extension"], none of
// which take an argument.
fn long_has_args(opt: ref String) -> Result[String, String] {
    let mut possible: Vec[String] = Vec.new();
    for o in ["help", "lenient", "extension"] {
        if o.starts_with(opt.as_str()) {
            possible.push(o.to_string());
        }
    }
    if possible.is_empty() {
        return Err(f"option --{opt} not recognized");
    }
    if possible.contains(opt) {
        return Ok(opt.clone());
    }
    if possible.len() > 1 {
        return Err(f"option --{opt} not a unique prefix");
    }
    Ok(possible[0].clone())
}

// getopt.getopt(args, 'hle', ['help', 'lenient', 'extension'])
fn getopt(argv: ref Vec[String]) -> Result[(Vec[String], Vec[String]), String] {
    let mut opts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < argv.len() and argv[i].starts_with("-") and argv[i] != "-" {
        let a = argv[i].clone();
        i += 1;
        if a == "--" {
            break;
        }
        let w = chars(a);
        if a.starts_with("--") {
            let body = slice(w, 2, w.len());
            let bw = chars(body);
            let eq = find_from(bw, '=', 0);
            let name = if eq >= 0 { slice(bw, 0, eq) } else { body.clone() };
            let full = long_has_args(name)?;
            if eq >= 0 {
                return Err(f"option --{full} must not have an argument");
            }
            opts.push(f"--{full}");
            continue;
        }
        for j in 1..w.len() {
            let c = w[j];
            if c != 'h' and c != 'l' and c != 'e' {
                return Err(f"option -{c} not recognized");
            }
            opts.push(f"-{c}");
        }
    }
    let mut rest: Vec[String] = Vec.new();
    while i < argv.len() {
        rest.push(argv[i].clone());
        i += 1;
    }
    Ok((opts, rest))
}

fn cli_line(out: mut ref Vec[String], s: ref String) {
    out.push(s.clone());
}

fn usage(out: mut ref Vec[String], msg: ref String) {
    for u in USAGE {
        cli_line(mut out, u.to_string());
    }
    cli_line(mut out, String.new());
    if not msg.is_empty() {
        cli_line(mut out, msg);
    }
}

// mimetypes._main(); the lines it prints and the exit status.
fn cli_main(argv: ref Vec[String], m: mut ref Module, out: mut ref Vec[String]) -> i64 {
    let (opts, args) = match getopt(argv) {
        Ok(r) => r,
        Err(msg) => {
            usage(mut out, msg);
            return 1;
        }
    };
    let mut strict = true;
    let mut extension = false;
    for o in opts.iter() {
        if o == "-h" or o == "--help" {
            usage(mut out, String.new());
            return 0;
        } else if o == "-l" or o == "--lenient" {
            strict = false;
        } else if o == "-e" or o == "--extension" {
            extension = true;
        }
    }
    for g in args.iter() {
        if extension {
            match m.guess_extension(g, strict) {
                Some(e) => cli_line(mut out, e),
                None => cli_line(mut out, f"I don't know anything about type {g}"),
            }
        } else {
            match m.guess_type(g, strict) {
                Ok((Some(t), enc)) => cli_line(mut out, f"type: {t} encoding: {opt_or(enc, "None")}"),
                Ok((None, _)) => cli_line(mut out, f"I don't know anything about type {g}"),
                Err(e) => cli_line(mut out, show_exc(e)),
            }
        }
    }
    0
}

fn run_cli(args: ref Vec[String]) {
    let line = strip(f"$ python -m mimetypes {join(args, " ")}");
    println(line);
    let mut m = Module.new();
    let mut out: Vec[String] = Vec.new();
    let code = cli_main(args, mut m, mut out);
    for l in out.iter() {
        if l.is_empty() {
            println("");
        } else {
            println(f"  {l}");
        }
    }
    println(f"exit {code}");
}

// ------------------------------------------------------------ the run

fn run() -> Result[(), String] {
    let text = match fs.read_to_string("data/jobs.tsv") {
        Ok(t) => t,
        Err(e) => return Err(f"OSError: {e}"),
    };
    let mut jobs = split_on(text, '\n');
    jobs.pop();
    let defaults = MimeTypes.new().strict_map.copy();
    let mut i = 0;
    while i < jobs.len() {
        let f = split_on(jobs[i], '\t');
        if f[0] == "job" {
            let mut body: Vec[String] = Vec.new();
            i += 1;
            while i < jobs.len() {
                let head = split_on(jobs[i], '\t')[0].clone();
                if head == "job" or head == "cli" or head == "program" {
                    break;
                }
                body.push(jobs[i].clone());
                i += 1;
            }
            let mut m = Module.new();
            run_job(f[1], body, mut m, defaults);
            continue;
        }
        if f[0] == "cli" {
            let mut args: Vec[String] = Vec.new();
            for k in 1..f.len() {
                args.push(f[k].clone());
            }
            run_cli(args);
        } else if f[0] == "program" {
            run_program(f[1]);
        }
        i += 1;
    }
    Ok(())
}

fn dirname(p: ref String) -> String {
    let v = chars(p);
    let i = rfind_char(v, '/');
    if i < 0 { ".".to_string() } else { slice(v, 0, i) }
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        let p = f"data/{file.path}";
        match fs.create_dir_all(dirname(p)) {
            Ok(_) => {}
            Err(e) => return Err(f"OSError: {e}"),
        }
        match fs.write(p.clone(), file.body.clone()) {
            Ok(_) => {}
            Err(e) => return Err(f"OSError: {e}"),
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    body: String,
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ------------------------------------------------------------ programs

fn data_lines(path: Str) -> Vec[String] {
    let text = match fs.read_to_string(f"data/{path}") {
        Ok(t) => t,
        Err(_) => String.new(),
    };
    let mut out: Vec[String] = Vec.new();
    for l in split_on(text, '\n').into_iter() {
        if strip(l).is_empty() or l.starts_with("#") {
            continue;
        }
        out.push(l);
    }
    out
}

fn site_db() -> MimeTypes {
    let mut db = MimeTypes.new();
    let _ = db.read("data/system/mime.types".to_string(), true);
    let _ = db.read("data/apache/mime.types".to_string(), true);
    let _ = db.read("data/local/mime.types".to_string(), false);
    db
}

fn with_charset(t: ref String) -> String {
    let textish = [
        "application/javascript", "text/javascript", "application/json", "application/xml",
        "image/svg+xml", "application/manifest+json",
    ];
    let mut yes = t.starts_with("text/");
    for x in textish {
        if t == x {
            yes = true;
        }
    }
    if yes { f"{t}; charset=utf-8" } else { t.clone() }
}

fn type_of(db: ref MimeTypes, p: ref String, strict: bool) -> (Option[String], Option[String]) {
    match db.guess_type(p, strict) {
        Ok(r) => r,
        Err(_) => (None, None),
    }
}

// http.server's SimpleHTTPRequestHandler.guess_type, over the module's
// database.
fn handler_guess(m: mut ref Module, path: ref String) -> String {
    let (_, ext) = splitext(path);
    let hmap = [
        (".gz", "application/gzip"), (".Z", "application/octet-stream"),
        (".bz2", "application/x-bzip2"), (".xz", "application/x-xz"),
    ];
    for (k, v) in hmap {
        if ext == k {
            return v.to_string();
        }
    }
    let el = lower(ext);
    for (k, v) in hmap {
        if el == k {
            return v.to_string();
        }
    }
    m.ensure();
    let g = match m.db {
        Some(ref d) => d.guess_file_type(path, true).0,
        None => None,
    };
    match g {
        Some(t) => t,
        None => "application/octet-stream".to_string(),
    }
}

fn prog_server() {
    println("== program: static file server");
    let mut m = Module.new();
    m.init(None);
    println("Content-type, as http.server picks it:");
    for p in data_lines("server/requests.txt") {
        let t = if p.ends_with("/") {
            "text/html; charset=utf-8 (directory listing)".to_string()
        } else {
            handler_guess(mut m, p)
        };
        println(f"  {pad_right(p, 36)} {t}");
    }
    let db = site_db();
    let disk = data_lines("server/precompressed.txt");
    println("precompressed variants:");
    for l in data_lines("server/accept.txt") {
        let parts = split_on(l, '\t');
        let path = parts[0].clone();
        let ae = parts[1].clone();
        let toks: Vec[String] = split_on(ae, ',').iter().map(|t| lower(strip(split_on(t, ';')[0]))).collect();
        let pv = chars(path);
        let rel = slice(pv, 1, pv.len());
        let mut enc: Option[(String, String)] = None;
        for (want, suf) in [("br", ".br"), ("gzip", ".gz")] {
            let w = want.to_string();
            let star = "*".to_string();
            if (toks.contains(w) or toks.contains(star)) and disk.contains(f"{rel}{suf}") {
                enc = Some((w, suf.to_string()));
                break;
            }
        }
        let ctype = match type_of(db, rel, true).0 {
            Some(t) => with_charset(t),
            None => "application/octet-stream".to_string(),
        };
        match enc {
            Some((e, suf)) => println(
                f"  {path} [{ae}] -> {rel}{suf}: Content-Type {ctype}, Content-Encoding {e}, Vary: Accept-Encoding",
            ),
            None => println(f"  {path} [{ae}] -> {rel}: Content-Type {ctype}, Vary: Accept-Encoding"),
        }
    }
}

fn prog_nginx() {
    println("== program: nginx types block");
    let mut db = MimeTypes.new();
    let mut order: Vec[String] = Vec.new();
    let mut exts_of: Map[String, Vec[String]] = Map.new();
    let mut stmts = 0;
    let text = match fs.read_to_string("data/nginx/mime.types") {
        Ok(t) => t,
        Err(_) => String.new(),
    };
    let mut inside = false;
    for raw in split_on(text, '\n') {
        let l = strip(raw);
        if l.is_empty() or l.starts_with("#") {
            continue;
        }
        if l == "types {" {
            inside = true;
            continue;
        }
        if l == "}" {
            inside = false;
            continue;
        }
        if not inside or not l.ends_with(";") {
            println(f"  skipped: {repr_str(l)}");
            continue;
        }
        let lv = chars(l);
        let words = split_ws(slice(lv, 0, lv.len() - 1));
        stmts += 1;
        let t = words[0].clone();
        if not exts_of.contains_key(t) {
            order.push(t.clone());
            exts_of.insert(t.clone(), Vec.new());
        }
        for k in 1..words.len() {
            db.add_type(t, f".{words[k]}", true);
            exts_of.get_mut(t).unwrap().push(words[k].clone());
        }
    }
    println(f"{stmts} statements, {order.len()} types");
    let sysdb = site_db();
    println("where nginx and the site's mime.types disagree:");
    let mut n = 0;
    for t in order.iter() {
        for e in exts_of.get(t).unwrap().iter() {
            let a = type_of(db, f"x.{e}", true).0;
            let b = type_of(sysdb, f"x.{e}", true).0;
            if a != b {
                n += 1;
                println(f"  {pad_right(f".{e}", 7)} nginx {opt_or(a, "None")}, mime.types {opt_or(b, "None")}");
            }
        }
    }
    println(f"  {n} extensions differ");
    let mut out: Vec[String] = Vec.new();
    for t in order.iter() {
        out.push(f"{pad_right(t, 40)}{join(exts_of.get(t).unwrap(), " ")}");
    }
    println(f"as a mime.types file ({out.len()} lines), the first five and the octet-stream line:");
    for k in 0..5 {
        println(f"  {out[k]}");
    }
    for l in out.iter() {
        if l.starts_with("application/octet-stream") {
            println(f"  {l}");
        }
    }
    let mut back = MimeTypes.new();
    back.readfp(f"{join(out, "\n")}\n", true);
    let mut same = 0;
    let mut total = 0;
    for t in order.iter() {
        for e in exts_of.get(t).unwrap().iter() {
            total += 1;
            let x = f"x.{e}";
            if type_of(back, x, true) == type_of(db, x, true) {
                same += 1;
            }
        }
    }
    println(f"read back: {same} of {total} extensions guess the same");
    let os = "application/octet-stream".to_string();
    println(
        f"guess_extension('application/octet-stream') nginx {opt_or(db.guess_extension(os, true), "None")}, read back {opt_or(back.guess_extension(os, true), "None")}",
    );
}

fn prog_uploads() {
    println("== program: upload validator");
    let db = site_db();
    let mut policy: Map[String, i64] = Map.new();
    for l in data_lines("uploads/policy.conf") {
        let w = split_ws(l);
        policy.insert(w[0].clone(), i64.parse(w[1]).unwrap_or(0));
    }
    let mut ok = 0;
    let lines = data_lines("uploads/uploads.tsv");
    for i in 0..lines.len() {
        let parts = split_on(lines[i], '\t');
        let name = parts[0].clone();
        let size = i64.parse(parts[2]).unwrap_or(0);
        let declared = lower(strip(split_on(parts[1], ';')[0]));
        let (t, enc) = type_of(db, name, true);
        let (base, ext) = splitext(name);
        let inner = if ext.is_empty() { None } else { type_of(db, base, true).0 };
        let verdict = match t {
            None => "reject: the name gives no known type".to_string(),
            Some(t) => {
                if enc.is_some() {
                    f"reject: {enc.unwrap()}-compressed {t}"
                } else if inner.is_some() and (t == "application/x-msdownload" or t == "application/octet-stream") {
                    f"reject: an executable named like {inner.unwrap()}"
                } else if not policy.contains_key(t) {
                    f"reject: {t} is not accepted"
                } else if declared != t {
                    f"reject: sent as {declared} but the name says {t}"
                } else if size > *policy.get(t).unwrap() {
                    f"reject: {size} bytes, over the {policy.get(t).unwrap()} limit"
                } else {
                    ok += 1;
                    let num = pad_left(f"{i + 1}", 3).replace(" ", "0");
                    f"accept as upload-{num}{opt_or(db.guess_extension(t, true), "None")}"
                }
            }
        };
        println(f"  {pad_right(name, 18)} {verdict}");
    }
    println(f"{ok} accepted");
}

fn bump(m: mut ref Map[String, i64], k: ref String, by: i64) {
    let cur = match m.get(k) {
        Some(v) => *v,
        None => 0,
    };
    m.insert(k.clone(), cur + by);
}

fn sorted_keys(m: ref Map[String, i64]) -> Vec[String] {
    let mut v: Vec[String] = m.keys().map(|k| k.clone()).collect();
    v.sort();
    v
}

fn major_of(t: ref String) -> String {
    split_on(t, '/')[0].clone()
}

fn prog_objstore() {
    println("== program: object store upload plan");
    let db = site_db();
    let mut by: Map[String, i64] = Map.new();
    for p in data_lines("objstore/manifest.txt") {
        let (t, enc) = type_of(db, p, false);
        let ctype = match t {
            Some(ref x) => with_charset(x),
            None => "application/octet-stream".to_string(),
        };
        let cache = match t {
            None => "public, max-age=300",
            Some(ref x) => {
                if p.contains("/assets/") or x.starts_with("font/") or x.starts_with("image/") {
                    "public, max-age=31536000, immutable"
                } else if x == "text/html" {
                    "no-cache"
                } else {
                    "public, max-age=300"
                }
            }
        };
        let extra = match enc {
            Some(ref e) => {
                if e == "gzip" or e == "br" { f"; Content-Encoding: {e}" } else { String.new() }
            }
            None => String.new(),
        };
        println(f"  {p}: Content-Type: {ctype}{extra}; Cache-Control: {cache}");
        let major = major_of(opt_or(t, "application/octet-stream"));
        bump(mut by, major, 1);
    }
    let parts: Vec[String] = sorted_keys(by).iter().map(|k| f"{k} {by.get(k).unwrap()}").collect();
    println(f"objects by major type: {join(parts, ", ")}");
}

fn prog_mail() {
    println("== program: mail attachments");
    let db = site_db();
    for p in data_lines("mail/attachments.txt") {
        let (t, encoding) = type_of(db, p, true);
        let ctype = if t.is_none() or encoding.is_some() {
            "application/octet-stream".to_string()
        } else {
            t.unwrap()
        };
        let (maintype, subtype) = split_once(ctype, '/').unwrap();
        let c = if maintype == "text" {
            "MIMEText"
        } else if maintype == "image" {
            "MIMEImage"
        } else if maintype == "audio" {
            "MIMEAudio"
        } else {
            "MIMEBase"
        };
        println(f"  {repr_str(p)}: {c}, Content-Type: {maintype}/{subtype}; name={repr_str(p)}");
    }
}

fn parse_accept(h: ref String) -> Vec[(String, f64)] {
    let mut out: Vec[(String, f64)] = Vec.new();
    for part0 in split_on(h, ',') {
        let part = strip(part0);
        if part.is_empty() {
            continue;
        }
        let bits: Vec[String] = split_on(part, ';').iter().map(|b| strip(b)).collect();
        let mut q = 1.0;
        for k in 1..bits.len() {
            if bits[k].starts_with("q=") {
                let bv = chars(bits[k]);
                q = f64.parse(slice(bv, 2, bv.len())).unwrap_or(0.0);
            }
        }
        out.push((lower(bits[0]), q));
    }
    if out.is_empty() {
        out.push(("*/*".to_string(), 1.0));
    }
    out
}

fn match_q(rng: ref Vec[(String, f64)], t: ref String) -> Option[f64] {
    let mut best_spec = 0;
    let mut best_q = 0.0;
    for (r, q) in rng.iter() {
        let mut spec = 0;
        if r == t {
            spec = 3;
        } else if r.ends_with("/*") {
            let rv = chars(r);
            if major_of(t) == slice(rv, 0, rv.len() - 2) {
                spec = 2;
            }
        }
        if spec == 0 and r == "*/*" {
            spec = 1;
        }
        if spec == 0 {
            continue;
        }
        if spec > best_spec {
            best_spec = spec;
            best_q = *q;
        }
    }
    if best_spec == 0 { None } else { Some(best_q) }
}

fn fmt3(x: f64) -> String {
    let n = (x * 1000.0).round() as i64;
    let frac = pad_left(f"{n % 1000}", 3).replace(" ", "0");
    f"{n / 1000}.{frac}"
}

fn prog_negotiate() {
    println("== program: content negotiation");
    let db = site_db();
    let mut variants: Map[String, Vec[String]] = Map.new();
    for l in data_lines("negotiate/variants.txt") {
        let parts = split_on(l, '\t');
        variants.insert(parts[0].clone(), split_ws(parts[1]));
    }
    let text = match fs.read_to_string("data/negotiate/requests.txt") {
        Ok(t) => t,
        Err(_) => String.new(),
    };
    for l in split_on(text, '\n') {
        if l.is_empty() or l.starts_with("#") {
            continue;
        }
        let parts = split_on(l, '\t');
        let name = parts[0].clone();
        let accept = parts[1].clone();
        let rng = parse_accept(accept);
        let mut best: Option[(String, f64, String)] = None;
        for f in variants.get(name).unwrap().iter() {
            let t = match type_of(db, f, true).0 {
                Some(t) => t,
                None => continue,
            };
            let q = match match_q(rng, t) {
                Some(q) => q,
                None => continue,
            };
            if q <= 0.0 {
                continue;
            }
            let better = match best {
                None => true,
                Some(ref b) => q > b.1,
            };
            if better {
                best = Some((f.clone(), q, t));
            }
        }
        match best {
            None => println(f"  {name} [{accept}] -> 406 Not Acceptable"),
            Some((f, q, t)) => println(f"  {name} [{accept}] -> {f} ({t}, q={fmt3(q)})"),
        }
    }
}

fn prog_cdnlog() {
    println("== program: CDN log by type");
    let db = site_db();
    let mut bytes_by: Map[String, i64] = Map.new();
    let mut hits_by: Map[String, i64] = Map.new();
    let mut naive_wrong = 0;
    let mut bad = 0;
    for l in data_lines("cdnlog/access.log") {
        let v = chars(l);
        let q1 = find_from(v, '"', 0);
        let q2 = find_from(v, '"', q1 + 1);
        let req = split_on(slice(v, q1 + 1, q2), ' ');
        let rest = split_ws(slice(v, q2 + 1, v.len()));
        if req.len() != 3 or rest.len() != 2 {
            bad += 1;
            continue;
        }
        let target = req[1].clone();
        let naive = type_of(db, target, true).0;
        let path = match urlsplit(target) {
            Ok(s) => s.path,
            Err(_) => target.clone(),
        };
        let t = type_of(db, path, true).0;
        if naive != t {
            naive_wrong += 1;
            println(
                f"  {target}: guess_type on the raw target says {opt_or(naive, "None")}, on the path {opt_or(t, "None")}",
            );
        }
        let key = opt_or(t, "(unknown)");
        bump(mut bytes_by, key, i64.parse(rest[1]).unwrap_or(0));
        bump(mut hits_by, key, 1);
    }
    println(f"{bad} unparsable lines; {naive_wrong} targets need the query or fragment cut first");
    let mut keys = sorted_keys(bytes_by);
    keys.sort_by(|a, b| {
        let x = *bytes_by.get(a).unwrap();
        let y = *bytes_by.get(b).unwrap();
        if x != y { y.cmp(x) } else { a.cmp(b) }
    });
    for k in keys.iter() {
        let h = pad_left(f"{hits_by.get(k).unwrap()}", 3);
        let b = pad_left(f"{bytes_by.get(k).unwrap()}", 10);
        println(f"  {pad_right(k, 28)} {h} hits {b} bytes");
    }
}

fn prog_inventory() {
    println("== program: shared-drive inventory");
    let db = site_db();
    let mut size_by: Map[String, i64] = Map.new();
    let mut count_by: Map[String, i64] = Map.new();
    let mut renames: Vec[String] = Vec.new();
    let mut unknown: Vec[String] = Vec.new();
    for l in data_lines("inventory/files.txt") {
        let v = chars(l);
        let sp = rfind_char(v, ' ');
        let path = slice(v, 0, sp);
        let size = i64.parse(slice(v, sp + 1, v.len())).unwrap_or(0);
        let (t, enc) = type_of(db, path, true);
        let major = match t {
            None => {
                unknown.push(path.clone());
                "(unknown)".to_string()
            }
            Some(ref x) => {
                if enc.is_none() {
                    match db.guess_extension(x, true) {
                        Some(canon) => {
                            let (_, ext) = splitext(path);
                            if ext != canon {
                                renames.push(f"  {path} ({x}): {canon}");
                            }
                        }
                        None => {}
                    }
                }
                major_of(x)
            }
        };
        bump(mut size_by, major, size);
        bump(mut count_by, major, 1);
    }
    println("by major type:");
    for k in sorted_keys(size_by).iter() {
        let c = pad_left(f"{count_by.get(k).unwrap()}", 3);
        let s = pad_left(f"{size_by.get(k).unwrap()}", 11);
        println(f"  {pad_right(k, 12)} {c} files {s} bytes");
    }
    println(f"{renames.len()} files whose extension is not the type's first one:");
    for r in renames.iter() {
        println(r);
    }
    println(f"{unknown.len()} with no known type: {join(unknown, ", ")}");
}

fn run_program(name: ref String) {
    if name == "server" {
        prog_server();
    } else if name == "nginx" {
        prog_nginx();
    } else if name == "uploads" {
        prog_uploads();
    } else if name == "objstore" {
        prog_objstore();
    } else if name == "mail" {
        prog_mail();
    } else if name == "negotiate" {
        prog_negotiate();
    } else if name == "cdnlog" {
        prog_cdnlog();
    } else if name == "inventory" {
        prog_inventory();
    }
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# This file maps Internet media types to unique file extension(s).\n");
    t.push_str("# Apache's copy, trimmed. Where it disagrees with the system file,\n");
    t.push_str("# it is read later and wins.\n");
    t.push_str("#\n");
    t.push_str("# MIME type (lowercased)\t\t\tExtensions\n");
    t.push_str("# ============================================\t==========\n");
    t.push_str("application/ecmascript\t\t\t\tes ecma\n");
    t.push_str("application/java-archive\t\t\tjar\n");
    t.push_str("application/vnd.apple.installer+xml\t\tmpkg\n");
    t.push_str("application/vnd.apple.mpegurl\t\t\tm3u8\n");
    t.push_str("application/x-msdownload\t\t\texe dll com bat msi\n");
    t.push_str("text/javascript\t\t\t\t\tjs\n");
    t.push_str("text/x-asm\t\t\t\t\ts asm\n");
    t.push_str("text/x-fortran\t\t\t\t\tf for f77 f90\n");
    t.push_str("text/x-pascal\t\t\t\t\tp pas\n");
    t.push_str("text/x-vcalendar\t\t\t\tvcs\n");
    t.push_str("video/mp2t\t\t\t\t\tts\n");
    t.push_str("video/x-flv\t\t\t\t\tflv\n");
    t.push_str("Application/X-Shockwave-Flash\t\tswf\n");
    t.push_str("application/x-photoshop\t\t\tPSD\n");
    v.push(DataFile { path: "apache/mime.types".to_string(), body: t });
    let mut t = String.new();
    t.push_str("text/x-crlf crlf\u{d}\n");
    t.push_str("text/x-formfeed\u{c}");
    t.push_str("ff\n");
    t.push_str("text/x-vtab\u{b}");
    t.push_str("vt\n");
    t.push_str("text/x-nbsp nbsp\n");
    t.push_str("text/x-dup dupe\n");
    t.push_str("text/x-dup2 dupe\n");
    t.push_str("text/x-dup dupe dupe2\n");
    v.push(DataFile { path: "broken/odd.types".to_string(), body: t });
    let mut t = String.new();
    t.push_str("203.0.113.10 - - [20/Oct/2026:10:00:01 +0000] \"GET /index.html HTTP/2.0\" 200 5120\n");
    t.push_str("203.0.113.10 - - [20/Oct/2026:10:00:01 +0000] \"GET /css/site.css HTTP/2.0\" 200 18210\n");
    t.push_str("203.0.113.10 - - [20/Oct/2026:10:00:01 +0000] \"GET /js/app.min.js?v=8f3a HTTP/2.0\" 200 92012\n");
    t.push_str("203.0.113.11 - - [20/Oct/2026:10:00:02 +0000] \"GET /img/hero.webp HTTP/2.0\" 200 210334\n");
    t.push_str("203.0.113.11 - - [20/Oct/2026:10:00:02 +0000] \"GET /img/thumbs/1.jpg HTTP/2.0\" 200 12001\n");
