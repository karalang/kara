// mini_olefile: olefile 0.47, the pure-Python reader of OLE2 compound
// files (Microsoft's Compound File Binary format: old .doc, .xls, .ppt,
// Outlook .msg, Thumbs.db and many others), as the records office of a
// law firm working through a matter's intake folder:
// - OleFileIO: the header and its checks, the FAT with its DIFAT, the
//   MiniFAT and the mini stream, the directory as olefile walks its
//   red-black tree, every defect with its level (raise_defects decides
//   which ones raise and which go to parsing_issues), and the
//   duplicate-stream checks;
// - OleStream's reading of a sector chain, with each defect a damaged
//   chain gives;
// - listdir, exists, get_type, get_size, getclsid, getmtime, getctime,
//   openstream and the case-insensitive path lookup;
// - getproperties and get_userdefined_properties with every property
//   type olefile parses, its vectors, its misreadings of padded strings,
//   and the errors it turns into defects;
// - OleMetadata from SummaryInformation and DocumentSummaryInformation;
// - an intake report that sorts each file into archive, review,
//   quarantine or rejected and writes a manifest.
//
// The inputs are data/jobs.txt and the files beside it, made by mk.py.
// expected.out is the output of oracle.py, which runs the same jobs
// through olefile itself (the copy in olefile.py).

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else {
        c - b'a' + 10
    }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    for file in data_files() {
        let (name, body) = file;
        let p = f"data/{name}";
        if let Err(e) = fs.write_bytes(p.clone(), unhex(body)) {
            return Err(f"cannot write {p}: {e}");
        }
    }
    Ok(())
}
// ------------------------------------------------------------ text

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}
fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut s = String.new();
    let mut first = true;
    for p in parts.iter() {
        if not first {
            s.push_str(sep);
        }
        s.push_str(p);
        first = false;
    }
    s
}
fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if is_space(c) {
            if cur.len() > 0 {
                out.push(cur);
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}
fn is_space(c: char) -> bool {
    let n = c as u32;
    (n >= 9 and n <= 13) or n == 32 or (n >= 0x1c and n <= 0x1f) or n == 0x85 or n == 0xa0
        or n == 0x1680 or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029
        or n == 0x202f or n == 0x205f or n == 0x3000
}
fn hex2(n: i64) -> String {
    f"{n:02x}"
}

// repr(str)
fn repr_str(s: ref String) -> String {
    let has_sq = s.contains("'");
    let has_dq = s.contains("\"");
    let q = if has_sq and not has_dq { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as u32;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
            out.push_str(f"\\x{hex2(n as i64)}");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn repr_list(items: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for s in items.iter() {
        parts.push(repr_str(s));
    }
    f"[{join(parts, ", ")}]"
}

// repr(bytes)
fn repr_bytes(b: ref Vec[u8]) -> String {
    let mut has_sq = false;
    let mut has_dq = false;
    for x in b.iter() {
        if *x == b'\'' {
            has_sq = true;
        }
        if *x == b'"' {
            has_dq = true;
        }
    }
    let q: u8 = if has_sq and not has_dq { b'"' } else { b'\'' };
    let mut out = "b".to_string();
    out.push(q as char);
    for x in b.iter() {
        let c = *x;
        if c == q or c == b'\\' {
            out.push('\\');
            out.push(c as char);
        } else if c == b'\t' {
            out.push_str("\\t");
        } else if c == b'\n' {
            out.push_str("\\n");
        } else if c == b'\r' {
            out.push_str("\\r");
        } else if c < 0x20 or c >= 0x7f {
            out.push_str(f"\\x{hex2(c as i64)}");
        } else {
            out.push(c as char);
        }
    }
    out.push(q as char);
    out
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b.iter() {
        s.push_str(hex2(*x as i64));
    }
    s
}

// bytes.decode('utf-16-le', 'replace')
fn decode_utf16(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        if i + 1 >= b.len() {
            out.push('\u{fffd}');
            break;
        }
        let u = (b[i] as u32) | ((b[i + 1] as u32) << 8);
        if u < 0xd800 or u > 0xdfff {
            out.push(char.try_from(u).unwrap_or('\u{fffd}'));
            i += 2;
        } else if u <= 0xdbff {
            if i + 3 >= b.len() {
                out.push('\u{fffd}');
                break;
            }
            let u2 = (b[i + 2] as u32) | ((b[i + 3] as u32) << 8);
            if u2 >= 0xdc00 and u2 <= 0xdfff {
                let cp = 0x10000 + ((u - 0xd800) << 10) + (u2 - 0xdc00);
                out.push(char.try_from(cp).unwrap_or('\u{fffd}'));
                i += 4;
            } else {
                out.push('\u{fffd}');
                i += 2;
            }
        } else {
            out.push('\u{fffd}');
            i += 2;
        }
    }
    out
}

// str.strip('\0')
fn strip_nul(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    let mut e = cs.len();
    while a < e and cs[a] == '\0' {
        a += 1;
    }
    while e > a and cs[e - 1] == '\0' {
        e -= 1;
    }
    let mut out = String.new();
    while a < e {
        out.push(cs[a]);
        a += 1;
    }
    out
}

fn latin1(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b.iter() {
        out.push(*x as char);
    }
    out
}

fn starts_with(s: ref String, p: Str) -> bool {
    s.starts_with(p)
}
// ------------------------------------------------------------ errors

// A Python exception: its class name and str(e).
#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: String,
}

fn perr(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn err_text(e: ref PyErr) -> String {
    f"! {e.kind}: {repr_str(e.msg)}"
}

fn struct_err(n: i64) -> PyErr {
    perr("error", f"unpack requires a buffer of {n} bytes")
}

fn not_found() -> PyErr {
    perr("OSError", "file not found".to_string())
}

// ------------------------------------------------------------ bytes

fn sub_bytes(b: ref Vec[u8], a: i64, e: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = if a < 0 { 0 } else { a };
    let end = if e > b.len() { b.len() } else { e };
    while i < end {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn concat(a: ref Vec[u8], b: ref Vec[u8]) -> Vec[u8] {
    let mut out = a.clone();
    for x in b.iter() {
        out.push(*x);
    }
    out
}

fn decode(b: ref Vec[u8], enc: Str, errors: ref String) -> Result[String, PyErr] {
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        if c < 0x80 {
            out.push(c as char);
            i += 1;
            continue;
        }
        if enc == "ascii" {
            if errors == "replace" {
                out.push('\u{fffd}');
                i += 1;
                continue;
            }
            return Err(perr("UnicodeDecodeError", f"'ascii' codec can't decode byte 0x{hex2(c as i64)} in position {i}: ordinal not in range(128)"));
        }
        let mut need = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xbf;
        let mut cp: u32 = 0;
        if c >= 0xc2 and c <= 0xdf {
            need = 1;
            cp = (c & 0x1f) as u32;
        } else if c >= 0xe0 and c <= 0xef {
            need = 2;
            cp = (c & 0x0f) as u32;
            if c == 0xe0 {
                lo = 0xa0;
            }
            if c == 0xed {
                hi = 0x9f;
            }
        } else if c >= 0xf0 and c <= 0xf4 {
            need = 3;
            cp = (c & 0x07) as u32;
            if c == 0xf0 {
                lo = 0x90;
            }
            if c == 0xf4 {
                hi = 0x8f;
            }
        }
        let mut reason = String.new();
        let mut got = 0;
        if need == 0 {
            reason = "invalid start byte".to_string();
            got = 1;
        } else {
            let mut k = 1;
            while k <= need {
                if i + k >= b.len() {
                    reason = "unexpected end of data".to_string();
                    break;
                }
                let x = b[i + k];
                let (l, h) = if k == 1 { (lo, hi) } else { (0x80 as u8, 0xbf as u8) };
                if x < l or x > h {
                    reason = "invalid continuation byte".to_string();
                    break;
                }
                cp = (cp << 6) | ((x & 0x3f) as u32);
                k += 1;
            }
            got = k;
        }
        if reason.len() == 0 {
            out.push(char.try_from(cp).unwrap_or('\u{fffd}'));
            i += need + 1;
            continue;
        }
        if errors == "replace" {
            out.push('\u{fffd}');
            i += got;
            continue;
        }
        let pos = if got == 1 { f"byte 0x{hex2(c as i64)} in position {i}" } else { f"bytes in position {i}-{i + got - 1}" };
        return Err(perr("UnicodeDecodeError", f"'utf-8' codec can't decode {pos}: {reason}"));
    }
    Ok(out)
}

fn adler32(b: ref Vec[u8]) -> u64 {
    let mut a: u64 = 1;
    let mut s: u64 = 0;
    for x in b.iter() {
        a = (a + (*x as u64)) % 65521;
        s = (s + a) % 65521;
    }
    (s << 16) | a
}

fn le_u32(b: ref Vec[u8], o: i64) -> i64 {
    let u = ((b[o + 3] as u32) << 24) | ((b[o + 2] as u32) << 16) | ((b[o + 1] as u32) << 8) | (b[o] as u32);
    u as i64
}

fn le_u16(b: ref Vec[u8], o: i64) -> i64 {
    ((b[o] as i64) | ((b[o + 1] as i64) << 8))
}

fn le_u64(b: ref Vec[u8], o: i64) -> u64 {
    let mut u: u64 = 0;
    let mut k = 7;
    while k >= 0 {
        u = (u << 8) | (b[o + k] as u64);
        k -= 1;
    }
    u
}

// olefile's i16(c, o) and i32(c, o): struct.unpack of c[o:o+n].
fn i16(b: ref Vec[u8], o: i64) -> Result[i64, PyErr] {
    if o < 0 or o + 2 > b.len() {
        return Err(struct_err(2));
    }
    Ok(le_u16(b, o))
}

fn i32(b: ref Vec[u8], o: i64) -> Result[i64, PyErr] {
    if o < 0 or o + 4 > b.len() {
        return Err(struct_err(4));
    }
    Ok(le_u32(b, o))
}

fn hexu(n: i64, w: i64) -> String {
    let digits = "0123456789ABCDEF".bytes().to_vec();
    let mut s = String.new();
    let mut k = w - 1;
    while k >= 0 {
        s.push(digits[(n >> (4 * k)) & 15] as char);
        k -= 1;
    }
    s
}

// olefile's _clsid(): the CLSID as text, or "" when it is all zeros.
fn clsid_text(c: ref Vec[u8]) -> Result[String, PyErr] {
    if c.len() != 16 {
        return Err(perr("AssertionError", String.new()));
    }
    let mut zero = true;
    for x in c.iter() {
        if *x != 0 {
            zero = false;
        }
    }
    if zero {
        return Ok(String.new());
    }
    let mut s = f"{hexu(le_u32(c, 0), 8)}-{hexu(le_u16(c, 4), 4)}-{hexu(le_u16(c, 6), 4)}-";
    s.push_str(f"{hexu(c[8] as i64, 2)}{hexu(c[9] as i64, 2)}-");
    let mut i = 10;
    while i < 16 {
        s.push_str(hexu(c[i] as i64, 2));
        i += 1;
    }
    Ok(s)
}

// ------------------------------------------------------------ datetime

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

// A datetime.datetime, as microseconds since 1601-01-01.
#[derive(Clone)]
struct DateTime {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    minute: i64,
    second: i64,
    micro: i64,
}

// datetime.datetime(1601, 1, 1) + timedelta(microseconds=us)
fn date_from_micros(us: i64) -> Result[DateTime, PyErr] {
    let mut days = us / 86400000000;
    let rest = us % 86400000000;
    if days > 3067670 {
        return Err(perr("OverflowError", "date value out of range".to_string()));
    }
    let n400 = days / 146097;
    days = days % 146097;
    let mut n100 = days / 36524;
    if n100 == 4 {
        n100 = 3;
    }
    days -= n100 * 36524;
    let n4 = days / 1461;
    days = days % 1461;
    let mut n1 = days / 365;
    if n1 == 4 {
        n1 = 3;
    }
    days -= n1 * 365;
    let year = 1601 + 400 * n400 + 100 * n100 + 4 * n4 + n1;
    let mut month = 1;
    while days >= days_in_month(year, month) {
        days -= days_in_month(year, month);
        month += 1;
    }
    let secs = rest / 1000000;
    Ok(DateTime {
        year: year,
        month: month,
        day: days + 1,
        hour: secs / 3600,
        minute: (secs / 60) % 60,
        second: secs % 60,
        micro: rest % 1000000,
    })
}

// olefile's filetime2datetime()
fn filetime_date(ft: u64) -> Result[DateTime, PyErr] {
    date_from_micros((ft / 10) as i64)
}

fn date_repr(d: ref DateTime) -> String {
    let mut parts: Vec[String] = Vec.new();
    parts.push(f"{d.year}");
    parts.push(f"{d.month}");
    parts.push(f"{d.day}");
    parts.push(f"{d.hour}");
    parts.push(f"{d.minute}");
    if d.second != 0 or d.micro != 0 {
        parts.push(f"{d.second}");
    }
    if d.micro != 0 {
        parts.push(f"{d.micro}");
    }
    f"datetime.datetime({join(parts, ", ")})"
}

fn date_str(d: ref DateTime) -> String {
    let mut s = f"{d.year:04}-{d.month:02}-{d.day:02} {d.hour:02}:{d.minute:02}:{d.second:02}";
    if d.micro != 0 {
        s.push_str(f".{d.micro:06}");
    }
    s
}

// ------------------------------------------------------------ Python values

// What a property reads as.
#[derive(Clone)]
enum Val {
    Nothing,
    Bool(bool),
    Int(i64),
    Bytes(Vec[u8]),
    Text(String),
    Date(DateTime),
    List(Vec[Val]),
}

fn val_repr(v: ref Val) -> String {
    match v {
        Val.Nothing => "None".to_string(),
        Val.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{*n}",
        Val.Bytes(b) => repr_bytes(b),
        Val.Text(s) => repr_str(s),
        Val.Date(d) => date_repr(d),
        Val.List(xs) => {
            let mut parts: Vec[String] = Vec.new();
            for x in xs.iter() {
                parts.push(val_repr(x));
            }
            f"[{join(parts, ", ")}]"
        }
    }
}

// str(value)
fn val_str(v: ref Val) -> String {
    match v {
        Val.Text(s) => s.clone(),
        Val.Date(d) => date_str(d),
        _ => val_repr(v),
    }
}

fn is_none(v: ref Val) -> bool {
    match v {
        Val.Nothing => true,
        _ => false,
    }
}
// ------------------------------------------------------------ OleFileIO

const ENDOFCHAIN: i64 = 0xFFFFFFFE;
const FREESECT: i64 = 0xFFFFFFFF;
const DIFSECT: i64 = 0xFFFFFFFC;
const FATSECT: i64 = 0xFFFFFFFD;
const NOSTREAM: i64 = 0xFFFFFFFF;
const UNKNOWN_SIZE: i64 = 0x7FFFFFFF;

const STGTY_EMPTY: i64 = 0;
const STGTY_STORAGE: i64 = 1;
const STGTY_STREAM: i64 = 2;
const STGTY_ROOT: i64 = 5;

const DEFECT_UNSURE: i64 = 10;
const DEFECT_POTENTIAL: i64 = 20;
const DEFECT_INCORRECT: i64 = 30;
const DEFECT_FATAL: i64 = 40;

fn magic() -> Vec[u8] {
    [0xD0 as u8, 0xCF as u8, 0x11 as u8, 0xE0 as u8, 0xA1 as u8, 0xB1 as u8, 0x1A as u8, 0xE1 as u8]
}

// An OleDirectoryEntry. Its kids are directory indexes, so an entry
// two storages point at is one object, as it is in Python.
#[derive(Clone)]
struct DirEntry {
    sid: i64,
    namelength: i64,
    entry_type: i64,
    sid_left: i64,
    sid_right: i64,
    sid_child: i64,
    clsid: String,
    create_time: u64,
    modify_time: u64,
    isect_start: i64,
    size: i64,
    name: String,
    is_minifat: bool,
    used: bool,
    kids: Vec[i64],
    kid_names: Vec[String],
}

fn blank_entry() -> DirEntry {
    DirEntry {
        sid: 0,
        namelength: 0,
        entry_type: 0,
        sid_left: NOSTREAM,
        sid_right: NOSTREAM,
        sid_child: NOSTREAM,
        clsid: String.new(),
        create_time: 0,
        modify_time: 0,
        isect_start: 0,
        size: 0,
        name: String.new(),
        is_minifat: false,
        used: false,
        kids: Vec.new(),
        kid_names: Vec.new(),
    }
}

struct Ole {
    level: i64,
    issues: Vec[(String, String)],
    fp: Vec[u8],
    filesize: i64,
    used_fat: Vec[i64],
    used_minifat: Vec[i64],
    minor_version: i64,
    dll_version: i64,
    byte_order: i64,
    num_dir_sectors: i64,
    num_fat_sectors: i64,
    first_dir_sector: i64,
    first_mini_fat_sector: i64,
    num_mini_fat_sectors: i64,
    first_difat_sector: i64,
    num_difat_sectors: i64,
    sector_size: i64,
    mini_sector_size: i64,
    minisectorcutoff: i64,
    nb_sect: i64,
    header_clsid: String,
    fat: Vec[i64],
    minifat: Vec[i64],
    ministream: Vec[u8],
    has_ministream: bool,
    directory: Vec[u8],
    entries: Vec[DirEntry],
    loaded: Vec[bool],
}

impl Ole {
    // _raise_defect(): raise at or above the chosen level, else record.
    fn defect_as(mut ref self, level: i64, msg: own String, kind: ref String) -> Result[(), PyErr] {
        if level >= self.level {
            if *kind == "UnicodeDecodeError" {
                // UnicodeDecodeError(message) itself fails: it wants five arguments.
                return Err(perr("TypeError", "function takes exactly 5 arguments (1 given)".to_string()));
            }
            return Err(PyErr { kind: kind.clone(), msg: msg });
        }
        self.issues.push((kind.clone(), msg));
        Ok(())
    }

    fn defect(mut ref self, level: i64, msg: Str) -> Result[(), PyErr] {
        self.defect_as(level, msg.to_string(), "OleFileError".to_string())
    }

    fn check_duplicate_stream(mut ref self, first_sect: i64, minifat: bool) -> Result[(), PyErr] {
        if not minifat {
            if first_sect == DIFSECT or first_sect == FATSECT or first_sect == ENDOFCHAIN or first_sect == FREESECT {
                return Ok(());
            }
        }
        let used = if minifat { self.used_minifat.clone() } else { self.used_fat.clone() };
        for s in used.iter() {
            if *s == first_sect {
                return self.defect(DEFECT_INCORRECT, "Stream referenced twice");
            }
        }
        if minifat {
            self.used_minifat.push(first_sect);
        } else {
            self.used_fat.push(first_sect);
        }
        Ok(())
    }

    // getsect()
    fn getsect(mut ref self, sect: i64) -> Result[Vec[u8], PyErr] {
        let off = self.sector_size * (sect + 1);
        let sector = sub_bytes(self.fp, off, off + self.sector_size);
        if sector.len() != self.sector_size {
            self.defect(DEFECT_FATAL, "incomplete OLE sector")?;
        }
        Ok(sector)
    }

    // loadfat_sect(): the FAT sectors a list of sector indexes names.
    fn loadfat_sect(mut ref self, sect: ref Vec[i64]) -> Result[(), PyErr] {
        for x in sect.iter() {
            let isect = *x;
            if isect == ENDOFCHAIN or isect == FREESECT {
                break;
            }
            let s = self.getsect(isect)?;
            let mut i = 0;
            while i + 4 <= s.len() {
                self.fat.push(le_u32(s, i));
                i += 4;
            }
        }
        Ok(())
    }

    fn loadfat(mut ref self, header: ref Vec[u8]) -> Result[(), PyErr] {
        let mut first: Vec[i64] = Vec.new();
        let mut i = 76;
        while i < 512 {
            first.push(le_u32(header, i));
            i += 4;
        }
        self.fat = Vec.new();
        self.loadfat_sect(first)?;
        if self.num_difat_sectors != 0 {
            if self.num_fat_sectors <= 109 {
                self.defect(DEFECT_INCORRECT, "incorrect DIFAT, not enough sectors")?;
            }
            if self.first_difat_sector >= self.nb_sect {
                self.defect(DEFECT_FATAL, "incorrect DIFAT, first index out of range")?;
            }
            let per = self.sector_size / 4 - 1;
            let nb_difat = (self.num_fat_sectors - 109 + per - 1) / per;
            if self.num_difat_sectors != nb_difat {
                return Err(perr("OSError", "incorrect DIFAT".to_string()));
            }
            let mut isect_difat = self.first_difat_sector;
            let mut k = 0;
            while k < nb_difat {
                let sector = self.getsect(isect_difat)?;
                let mut difat: Vec[i64] = Vec.new();
                let mut j = 0;
                while j + 4 <= sector.len() {
                    difat.push(le_u32(sector, j));
                    j += 4;
                }
                let mut head: Vec[i64] = Vec.new();
                let mut j2 = 0;
                while j2 < per and j2 < difat.len() {
                    head.push(difat[j2]);
                    j2 += 1;
                }
                self.loadfat_sect(head)?;
                isect_difat = difat[per];
                k += 1;
            }
            if isect_difat != ENDOFCHAIN and isect_difat != FREESECT {
                return Err(perr("OSError", "incorrect end of DIFAT".to_string()));
            }
        }
        if self.fat.len() > self.nb_sect {
            let n = if self.nb_sect < 0 { 0 } else { self.nb_sect };
            self.fat.truncate(n);
        }
        Ok(())
    }

    // OleStream.__init__(): a stream's bytes, read along its sector
    // chain in the FAT, or in the MiniFAT over the mini stream.
    fn read_chain(mut ref self, mini: bool, start: i64, size_in: i64) -> Result[Vec[u8], PyErr] {
        let fat = if mini { self.minifat.clone() } else { self.fat.clone() };
        let sectorsize = if mini { self.mini_sector_size } else { self.sector_size };
        let offset = if mini { 0 } else { self.sector_size };
        let mut size = size_in;
        let mut unknown_size = false;
        if size == UNKNOWN_SIZE {
            size = fat.len() * sectorsize;
            unknown_size = true;
        }
        let nb_sectors = (size + (sectorsize - 1)) / sectorsize;
        if nb_sectors > fat.len() {
            self.defect(DEFECT_INCORRECT, "malformed OLE document, stream too large")?;
        }
        let mut data: Vec[u8] = Vec.new();
        let mut sect = start;
        if size == 0 and sect != ENDOFCHAIN {
            self.defect(DEFECT_INCORRECT, "incorrect OLE sector index for empty stream")?;
        }
        let mut i = 0;
        while i < nb_sectors {
            if sect == ENDOFCHAIN {
                if unknown_size {
                    break;
                }
                self.defect(DEFECT_INCORRECT, "incomplete OLE stream")?;
            }
            if sect < 0 or sect >= fat.len() {
                self.defect(DEFECT_INCORRECT, "incorrect OLE FAT, sector index out of range")?;
                break;
            }
            let pos = offset + sectorsize * sect;
            let sector_data = if mini { sub_bytes(self.ministream, pos, pos + sectorsize) } else { sub_bytes(self.fp, pos, pos + sectorsize) };
            if sector_data.len() != sectorsize and sect != fat.len() - 1 {
                self.defect(DEFECT_INCORRECT, "incomplete OLE sector")?;
            }
            for x in sector_data.iter() {
                data.push(*x);
            }
            sect = fat[sect];
            i += 1;
        }
        if data.len() >= size {
            data.truncate(size);
        } else if not unknown_size {
            self.defect(DEFECT_INCORRECT, "OLE stream size is less than declared")?;
        }
        Ok(data)
    }

    fn loadminifat(mut ref self) -> Result[(), PyErr] {
        let stream_size = self.num_mini_fat_sectors * self.sector_size;
        let nb_minisectors = (self.entries[0].size + self.mini_sector_size - 1) / self.mini_sector_size;
        let used_size = nb_minisectors * 4;
        if used_size > stream_size {
            self.defect(DEFECT_INCORRECT, "OLE MiniStream is larger than MiniFAT")?;
        }
        let s = self.read_chain(false, self.first_mini_fat_sector, stream_size)?;
        if s.len() % 4 != 0 {
            return Err(perr("ValueError", "bytes length not a multiple of item size".to_string()));
        }
        self.minifat = Vec.new();
        let mut i = 0;
        while i + 4 <= s.len() {
            self.minifat.push(le_u32(s, i));
            i += 4;
        }
        if self.minifat.len() > nb_minisectors {
            self.minifat.truncate(nb_minisectors);
        }
        Ok(())
    }

    // _open(): a stream in the FAT or, below the cutoff, the MiniFAT.
    fn open_stream_at(mut ref self, start: i64, size: i64, force_fat: bool) -> Result[Vec[u8], PyErr] {
        if size < self.minisectorcutoff and not force_fat {
            if not self.has_ministream {
                self.loadminifat()?;
                let root_start = self.entries[0].isect_start;
                let root_size = self.entries[0].size;
                self.ministream = self.read_chain(false, root_start, root_size)?;
                self.has_ministream = true;
            }
            return self.read_chain(true, start, size);
        }
        self.read_chain(false, start, size)
    }

    // OleDirectoryEntry.__init__()
    fn make_entry(mut ref self, raw: ref Vec[u8], sid: i64) -> Result[DirEntry, PyErr] {
        let mut e = blank_entry();
        e.sid = sid;
        let name_raw = sub_bytes(raw, 0, 64);
        e.namelength = le_u16(raw, 64);
        e.entry_type = raw[66] as i64;
        e.sid_left = le_u32(raw, 68);
        e.sid_right = le_u32(raw, 72);
        e.sid_child = le_u32(raw, 76);
        let clsid = sub_bytes(raw, 80, 96);
        e.create_time = le_u64(raw, 100);
        e.modify_time = le_u64(raw, 108);
        e.isect_start = le_u32(raw, 116);
        let size_low = le_u32(raw, 120);
        let size_high = le_u32(raw, 124);
        let t = e.entry_type;
        if t != STGTY_ROOT and t != STGTY_STORAGE and t != STGTY_STREAM and t != STGTY_EMPTY {
            self.defect(DEFECT_INCORRECT, "unhandled OLE storage type")?;
        }
        if t == STGTY_ROOT and sid != 0 {
            self.defect(DEFECT_INCORRECT, "duplicate OLE root entry")?;
        }
        if sid == 0 and t != STGTY_ROOT {
            self.defect(DEFECT_INCORRECT, "incorrect OLE root entry")?;
        }
        if e.namelength > 64 {
            self.defect(DEFECT_INCORRECT, "incorrect DirEntry name length >64 bytes")?;
            e.namelength = 64;
        }
        // name_raw[:(namelength-2)], with Python's negative slice ends
        let mut cut = e.namelength - 2;
        if cut < 0 {
            cut = 64 + cut;
        }
        e.name = decode_utf16(sub_bytes(name_raw, 0, cut));
        if self.sector_size == 512 {
            if size_high != 0 and size_high != 0xFFFFFFFF {
                self.defect(DEFECT_UNSURE, "incorrect OLE stream size")?;
            }
            e.size = size_low;
        } else {
            e.size = size_low + (size_high << 32);
        }
        e.clsid = clsid_text(clsid)?;
        if t == STGTY_STORAGE and e.size != 0 {
            self.defect(DEFECT_POTENTIAL, "OLE storage with size>0")?;
        }
        e.is_minifat = false;
        if (t == STGTY_ROOT or t == STGTY_STREAM) and e.size > 0 {
            e.is_minifat = e.size < self.minisectorcutoff and t == STGTY_STREAM;
            self.check_duplicate_stream(e.isect_start, e.is_minifat)?;
        }
        Ok(e)
    }

    // _load_direntry()
    fn load_direntry(mut ref self, sid: i64) -> Result[i64, PyErr] {
        if sid < 0 or sid >= self.entries.len() {
            self.defect(DEFECT_FATAL, "OLE directory index out of range")?;
        }
        if self.loaded[sid] {
            self.defect(DEFECT_INCORRECT, "double reference for OLE stream/storage")?;
            return Ok(sid);
        }
        let raw = sub_bytes(self.directory, sid * 128, sid * 128 + 128);
        let e = self.make_entry(raw, sid)?;
        self.entries[sid] = e;
        self.loaded[sid] = true;
        Ok(sid)
    }

    // OleDirectoryEntry.append_kids(), for the storage `parent`.
    fn append_kids(mut ref self, parent: i64, child_sid: i64) -> Result[(), PyErr] {
        if child_sid == NOSTREAM {
            return Ok(());
        }
        if child_sid < 0 or child_sid >= self.entries.len() {
            return self.defect(DEFECT_INCORRECT, "OLE DirEntry index out of range");
        }
        let child = self.load_direntry(child_sid)?;
        if self.entries[child].used {
            return self.defect(DEFECT_INCORRECT, "OLE Entry referenced more than once");
        }
        self.entries[child].used = true;
        let left = self.entries[child].sid_left;
        self.append_kids(parent, left)?;
        let name_lower = self.entries[child].name.to_lowercase();
        let mut dup = false;
        for n in self.entries[parent].kid_names.iter() {
            if *n == name_lower {
                dup = true;
            }
        }
        if dup {
            self.defect(DEFECT_INCORRECT, "Duplicate filename in OLE storage")?;
        }
        self.entries[parent].kids.push(child);
        self.entries[parent].kid_names.push(name_lower);
        let right = self.entries[child].sid_right;
        self.append_kids(parent, right)?;
        self.build_storage_tree(child)
    }

    // build_storage_tree(): the kids, then sorted by name (a stable sort).
    fn build_storage_tree(mut ref self, sid: i64) -> Result[(), PyErr] {
        let child = self.entries[sid].sid_child;
        if child != NOSTREAM {
            self.append_kids(sid, child)?;
            let mut kids = self.entries[sid].kids.clone();
            let mut i = 1;
            while i < kids.len() {
                let k = kids[i];
                let mut j = i;
                while j > 0 and self.entries[k].name < self.entries[kids[j - 1]].name {
                    kids[j] = kids[j - 1];
                    j -= 1;
                }
                kids[j] = k;
                i += 1;
            }
            self.entries[sid].kids = kids;
        }
        Ok(())
    }

    fn loaddirectory(mut ref self, sect: i64) -> Result[(), PyErr] {
        self.directory = self.open_stream_at(sect, UNKNOWN_SIZE, true)?;
        let max_entries = self.directory.len() / 128;
        self.entries = Vec.new();
        self.loaded = Vec.new();
        let mut i = 0;
        while i < max_entries {
            self.entries.push(blank_entry());
            self.loaded.push(false);
            i += 1;
        }
        self.load_direntry(0)?;
        self.build_storage_tree(0)
    }

    // _find(): case-insensitive, by '/'-separated path.
    fn find(ref self, filename: ref String) -> Result[i64, PyErr] {
        let mut node = 0;
        for name in split_on(filename, '/').iter() {
            let want = name.to_lowercase();
            let mut found = -1;
            for k in self.entries[node].kids.iter() {
                if self.entries[*k].name.to_lowercase() == want {
                    found = *k;
                    break;
                }
            }
            if found < 0 {
                return Err(not_found());
            }
            node = found;
        }
        Ok(node)
    }

    fn list_into(mut ref self, files: mut ref Vec[Vec[String]], prefix: ref Vec[String], node: i64, streams: bool, storages: bool) -> Result[(), PyErr] {
        let mut here = prefix.clone();
        here.push(self.entries[node].name.clone());
        let kids = self.entries[node].kids.clone();
        for k in kids.iter() {
            let t = self.entries[*k].entry_type;
            let mut p: Vec[String] = Vec.new();
            let mut i = 1;
            while i < here.len() {
                p.push(here[i].clone());
                i += 1;
            }
            p.push(self.entries[*k].name.clone());
            if t == STGTY_STORAGE {
                if storages {
                    files.push(p);
                }
                self.list_into(files, here, *k, streams, storages)?;
            } else if t == STGTY_STREAM {
                if streams {
                    files.push(p);
                }
            } else {
                self.defect(DEFECT_INCORRECT, "The directory tree contains an entry which is not a stream nor a storage.")?;
            }
        }
        Ok(())
    }

    fn listdir(mut ref self, streams: bool, storages: bool) -> Result[Vec[Vec[String]], PyErr] {
        let mut files: Vec[Vec[String]] = Vec.new();
        let none: Vec[String] = Vec.new();
        self.list_into(mut files, none, 0, streams, storages)?;
        Ok(files)
    }

    fn exists(ref self, p: ref String) -> bool {
        match self.find(p) {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn openstream(mut ref self, p: ref String) -> Result[Vec[u8], PyErr] {
        let sid = self.find(p)?;
        if self.entries[sid].entry_type != STGTY_STREAM {
            return Err(perr("OSError", "this file is not a stream".to_string()));
        }
        let start = self.entries[sid].isect_start;
        let size = self.entries[sid].size;
        self.open_stream_at(start, size, false)
    }

    fn get_size(ref self, p: ref String) -> Result[i64, PyErr] {
        let sid = self.find(p)?;
        if self.entries[sid].entry_type != STGTY_STREAM {
            return Err(perr("TypeError", "object is not an OLE stream".to_string()));
        }
        Ok(self.entries[sid].size)
    }
}

// OleFileIO(filename, raise_defects=level): open() as olefile runs it.
fn open_ole(name: ref String, level: i64) -> Result[Ole, PyErr] {
    let fp = fs.read_bytes(f"data/{name}").unwrap_or(Vec.new());
    let mut ole = Ole {
        level: level,
        issues: Vec.new(),
        fp: fp,
        filesize: 0,
        used_fat: Vec.new(),
        used_minifat: Vec.new(),
        minor_version: 0,
        dll_version: 0,
        byte_order: 0,
        num_dir_sectors: 0,
        num_fat_sectors: 0,
        first_dir_sector: 0,
        first_mini_fat_sector: 0,
        num_mini_fat_sectors: 0,
        first_difat_sector: 0,
        num_difat_sectors: 0,
        sector_size: 0,
        mini_sector_size: 0,
        minisectorcutoff: 0,
        nb_sect: 0,
        header_clsid: String.new(),
        fat: Vec.new(),
        minifat: Vec.new(),
        ministream: Vec.new(),
        has_ministream: false,
        directory: Vec.new(),
        entries: Vec.new(),
        loaded: Vec.new(),
    };
    ole.filesize = ole.fp.len();
    let header = sub_bytes(ole.fp, 0, 512);
    if header.len() != 512 or sub_bytes(header, 0, 8) != magic() {
        ole.defect_as(DEFECT_FATAL, "not an OLE2 structured storage file".to_string(), "NotOleFileError".to_string())?;
    }
    let mut clsid_zero = true;
    let mut i = 8;
    while i < 24 {
        if header[i] != 0 {
            clsid_zero = false;
        }
        i += 1;
    }
    ole.minor_version = le_u16(header, 24);
    ole.dll_version = le_u16(header, 26);
    ole.byte_order = le_u16(header, 28);
    let sector_shift = le_u16(header, 30);
    let mini_sector_shift = le_u16(header, 32);
    let reserved1 = le_u16(header, 34);
    let reserved2 = le_u32(header, 36);
    ole.num_dir_sectors = le_u32(header, 40);
    ole.num_fat_sectors = le_u32(header, 44);
    ole.first_dir_sector = le_u32(header, 48);
    let transaction = le_u32(header, 52);
    let cutoff = le_u32(header, 56);
    ole.first_mini_fat_sector = le_u32(header, 60);
    ole.num_mini_fat_sectors = le_u32(header, 64);
    ole.first_difat_sector = le_u32(header, 68);
    ole.num_difat_sectors = le_u32(header, 72);
    if not clsid_zero {
        ole.defect(DEFECT_INCORRECT, "incorrect CLSID in OLE header")?;
    }
    if ole.dll_version != 3 and ole.dll_version != 4 {
        ole.defect(DEFECT_INCORRECT, "incorrect DllVersion in OLE header")?;
    }
    if ole.byte_order != 0xFFFE {
        ole.defect(DEFECT_INCORRECT, "incorrect ByteOrder in OLE header")?;
    }
    ole.sector_size = 1 << sector_shift;
    if ole.sector_size != 512 and ole.sector_size != 4096 {
        ole.defect(DEFECT_INCORRECT, "incorrect sector_size in OLE header")?;
    }
    if (ole.dll_version == 3 and ole.sector_size != 512) or (ole.dll_version == 4 and ole.sector_size != 4096) {
        ole.defect(DEFECT_INCORRECT, "sector_size does not match DllVersion in OLE header")?;
    }
    ole.mini_sector_size = 1 << mini_sector_shift;
    if ole.mini_sector_size != 64 {
        ole.defect(DEFECT_INCORRECT, "incorrect mini_sector_size in OLE header")?;
    }
    if reserved1 != 0 or reserved2 != 0 {
        ole.defect(DEFECT_INCORRECT, "incorrect OLE header (non-null reserved bytes)")?;
    }
    if ole.sector_size == 512 and ole.num_dir_sectors != 0 {
        ole.defect(DEFECT_INCORRECT, "incorrect number of directory sectors in OLE header")?;
    }
    if transaction != 0 {
        ole.defect(DEFECT_POTENTIAL, "incorrect OLE header (transaction_signature_number>0)")?;
    }
    ole.minisectorcutoff = cutoff;
    if cutoff != 0x1000 {
        ole.defect(DEFECT_INCORRECT, "incorrect mini_stream_cutoff_size in OLE header")?;
        ole.minisectorcutoff = 0x1000;
    }
    ole.nb_sect = (ole.filesize + ole.sector_size - 1) / ole.sector_size - 1;
    ole.header_clsid = clsid_text(sub_bytes(header, 8, 24))?;
    let first_dir = ole.first_dir_sector;
    ole.check_duplicate_stream(first_dir, false)?;
    if ole.num_mini_fat_sectors != 0 {
        let s = ole.first_mini_fat_sector;
        ole.check_duplicate_stream(s, false)?;
    }
    if ole.num_difat_sectors != 0 {
        let s = ole.first_difat_sector;
        ole.check_duplicate_stream(s, false)?;
    }
    ole.loadfat(header)?;
    ole.loaddirectory(first_dir)?;
    Ok(ole)
}
// ------------------------------------------------------------ property sets

const VT_I2: i64 = 2;
const VT_I4: i64 = 3;
const VT_BSTR: i64 = 8;
const VT_ERROR: i64 = 10;
const VT_BOOL: i64 = 11;
const VT_VARIANT: i64 = 12;
const VT_UI1: i64 = 17;
const VT_UI2: i64 = 18;
const VT_UI4: i64 = 19;
const VT_INT: i64 = 22;
const VT_UINT: i64 = 23;
const VT_LPSTR: i64 = 30;
const VT_LPWSTR: i64 = 31;
const VT_FILETIME: i64 = 64;
const VT_BLOB: i64 = 65;
const VT_CF: i64 = 71;
const VT_CLSID: i64 = 72;
const VT_VECTOR: i64 = 0x1000;

// The BytesIO an opened stream is read through.
struct Rd {
    data: Vec[u8],
    pos: i64,
}

impl Rd {
    fn read(mut ref self, n: i64) -> Vec[u8] {
        let end = if n < 0 { self.data.len() } else { self.pos + n };
        let b = sub_bytes(self.data, self.pos, end);
        if self.pos < self.data.len() {
            self.pos += b.len();
        }
        b
    }
}

fn drop_nuls(b: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for x in b.iter() {
        if *x != 0 {
            out.push(*x);
        }
    }
    out
}

fn filetime_at(s: ref Vec[u8], o: i64) -> Result[u64, PyErr] {
    let lo = i32(s, o)?;
    let hi = i32(s, o + 4)?;
    Ok((lo as u64) + ((hi as u64) << 32))
}

// A FILETIME as getproperties returns it: a datetime, or whole seconds.
fn time_val(ft: u64, convert: bool, pid: i64, no_conversion: ref Vec[i64]) -> Result[Val, PyErr] {
    let mut skip = false;
    for x in no_conversion.iter() {
        if *x == pid {
            skip = true;
        }
    }
    if convert and not skip {
        return Ok(Val.Date(filetime_date(ft)?));
    }
    Ok(Val.Int((ft / 10000000) as i64))
}

fn byte_at(s: ref Vec[u8], o: i64) -> Result[i64, PyErr] {
    if o < 0 or o >= s.len() {
        return Err(perr("IndexError", "index out of range".to_string()));
    }
    Ok(s[o] as i64)
}

// _parse_property_basic(): the value and the size it took.
fn parse_basic(s: ref Vec[u8], offset: i64, pid: i64, t: i64, convert: bool, no_conversion: ref Vec[i64]) -> Result[(Val, i64), PyErr] {
    if t == VT_I2 {
        let mut v = i16(s, offset)?;
        if v >= 32768 {
            v -= 65536;
        }
        return Ok((Val.Int(v), 2));
    }
    if t == VT_UI2 {
        return Ok((Val.Int(i16(s, offset)?), 2));
    }
    if t == VT_I4 or t == VT_INT or t == VT_ERROR or t == VT_UI4 or t == VT_UINT {
        return Ok((Val.Int(i32(s, offset)?), 4));
    }
    if t == VT_BSTR or t == VT_LPSTR {
        let count = i32(s, offset)?;
        let v = drop_nuls(sub_bytes(s, offset + 4, offset + 4 + count - 1));
        return Ok((Val.Bytes(v), 4 + count));
    }
    if t == VT_BLOB or t == VT_CF {
        let count = i32(s, offset)?;
        return Ok((Val.Bytes(sub_bytes(s, offset + 4, offset + 4 + count)), 4 + count));
    }
    if t == VT_LPWSTR {
        // olefile reads the count from the string's first four bytes
        let count = i32(s, offset + 4)?;
        let v = decode_utf16(sub_bytes(s, offset + 4, offset + 4 + count * 2));
        return Ok((Val.Text(v), 4 + count * 2));
    }
    if t == VT_FILETIME {
        let ft = filetime_at(s, offset)?;
        return Ok((time_val(ft, convert, pid, no_conversion)?, 8));
    }
    if t == VT_UI1 {
        return Ok((Val.Int(byte_at(s, offset)?), 1));
    }
    if t == VT_CLSID {
        return Ok((Val.Text(clsid_text(sub_bytes(s, offset, offset + 16))?), 16));
    }
    if t == VT_BOOL {
        return Ok((Val.Bool(i16(s, offset)? != 0), 2));
    }
    Ok((Val.Nothing, 0))
}

// _parse_property()
fn parse_property(s: ref Vec[u8], offset: i64, pid: i64, t: i64, convert: bool, no_conversion: ref Vec[i64]) -> Result[Val, PyErr] {
    if t <= VT_BLOB or t == VT_CLSID or t == VT_CF {
        let (v, _) = parse_basic(s, offset, pid, t, convert, no_conversion)?;
        return Ok(v);
    }
    if t == VT_VECTOR | VT_VARIANT {
        let mut off = 4;
        let count = i32(s, offset)?;
        let mut values: Vec[Val] = Vec.new();
        let mut k = 0;
        while k < count {
            let t2 = i32(s, offset + off)?;
            let (v, sz) = parse_basic(s, offset + off + 4, pid, t2, convert, no_conversion)?;
            values.push(v);
            off += sz + 4;
            k += 1;
        }
        return Ok(Val.List(values));
    }
    if t & VT_VECTOR != 0 {
        let base = t ^ VT_VECTOR;
        let mut off = 4;
        let count = i32(s, offset)?;
        let mut values: Vec[Val] = Vec.new();
        let mut k = 0;
        while k < count {
            let (v, sz) = parse_basic(s, offset + off, pid, base, convert, no_conversion)?;
            values.push(v);
            off += sz;
            k += 1;
        }
        return Ok(Val.List(values));
    }
    Ok(Val.Nothing)
}

// The property set header: the section, as olefile reads it ("****"
// standing in for its size).
fn section_of(fp: mut ref Rd) -> Result[Vec[u8], PyErr] {
    let s = fp.read(28);
    clsid_text(sub_bytes(s, 8, 24))?;
    let s2 = fp.read(20);
    clsid_text(sub_bytes(s2, 0, 16))?;
    fp.pos = i32(s2, 16)?;
    let n = fp.read(4);
    let size = i32(n, 0)?;
    let body = fp.read(size - 4);
    let sec = concat("****".bytes().to_vec(), body);
    i32(sec, 4)?;
    Ok(sec)
}

fn one_property(s: ref Vec[u8], i: i64, pid: mut ref i64, convert: bool, no_conversion: ref Vec[i64]) -> Result[Val, PyErr] {
    *pid = i32(s, 8 + i * 8)?;
    let offset = i32(s, 12 + i * 8)?;
    let t = i32(s, offset)?;
    parse_property(s, offset + 4, *pid, t, convert, no_conversion)
}

fn dict_put(d: mut ref Vec[(i64, Val)], k: i64, v: own Val) {
    let mut i = 0;
    while i < d.len() {
        if d[i].0 == k {
            d[i] = (k, v);
            return;
        }
        i += 1;
    }
    d.push((k, v));
}

fn dict_get(d: ref Vec[(i64, Val)], k: i64) -> Val {
    for item in d.iter() {
        let (key, v) = item;
        if *key == k {
            return v.clone();
        }
    }
    Val.Nothing
}

impl Ole {
    fn getproperties(mut ref self, filename: ref String, convert: bool, no_conversion: ref Vec[i64]) -> Result[Vec[(i64, Val)], PyErr] {
        let data = self.openstream(filename)?;
        let mut fp = Rd { data: data, pos: 0 };
        let mut props: Vec[(i64, Val)] = Vec.new();
        let s = match section_of(mut fp) {
            Ok(s) => s,
            Err(exc) => {
                let msg = f"Error while parsing properties header in stream {repr_str(filename)}: {exc.msg}";
                self.defect_as(DEFECT_INCORRECT, msg, exc.kind)?;
                return Ok(props);
            }
        };
        let mut num_props = le_u32(s, 4);
        if num_props > s.len() / 8 {
            num_props = s.len() / 8;
        }
        let mut i = 0;
        while i < num_props {
            let mut pid = 0;
            match one_property(s, i, mut pid, convert, no_conversion) {
                Ok(v) => dict_put(mut props, pid, v),
                Err(exc) => {
                    let msg = f"Error while parsing property id {pid} in stream {repr_str(filename)}: {exc.msg}";
                    self.defect_as(DEFECT_INCORRECT, msg, exc.kind)?;
                }
            }
            i += 1;
        }
        Ok(props)
    }

    fn get_userdefined_properties(mut ref self, filename: ref String, convert: bool, no_conversion: ref Vec[i64]) -> Result[Vec[(String, Val)], PyErr] {
        let user_fmtid = "D5CDD505-2E9C-101B-9397-08002B2CF9AE".to_string();
        let stream = self.openstream(filename)?;
        let mut fp = Rd { data: stream, pos: 0 };
        let mut data: Vec[(String, Val)] = Vec.new();
        let s = fp.read(28);
        clsid_text(sub_bytes(s, 8, 24))?;
        let sections_count = i32(s, 24)?;
        if let Err(exc) = self.user_sections(mut fp, sections_count, user_fmtid, mut data, filename, convert, no_conversion) {
            let msg = f"Error while parsing properties header in stream {repr_str(filename)}: {exc.msg}";
            self.defect_as(DEFECT_INCORRECT, msg, exc.kind)?;
            return Ok(data);
        }
        Ok(data)
    }

    // The body of get_userdefined_properties' try. A property's defect
    // that raises lands in that try's handler too, which wraps it again.
    fn user_sections(mut ref self, fp: mut ref Rd, sections_count: i64, user_fmtid: ref String, data: mut ref Vec[(String, Val)], filename: ref String, convert: bool, no_conversion: ref Vec[i64]) -> Result[(), PyErr] {
        let mut n = 0;
        while n < sections_count {
            let s = fp.read(20);
            let fmtid = clsid_text(sub_bytes(s, 0, 16))?;
            if fmtid == *user_fmtid {
                fp.pos = i32(s, 16)?;
                let head = fp.read(4);
                let size = i32(head, 0)?;
                let body = fp.read(size - 4);
                let s = concat("****".bytes().to_vec(), body);
                let mut num_props = i32(s, 4)?;
                let mut index = 8 + 8 * num_props;
                let entry_count = i32(sub_bytes(s, index, index + 4), 0)?;
                index += 4;
                let mut k = 0;
                while k < entry_count {
                    let str_size = i32(sub_bytes(s, index + 4, index + 8), 0)?;
                    let raw = sub_bytes(s, index + 8, index + 8 + str_size);
                    let name = decode(raw, "utf-8", "strict".to_string())?;
                    data.push((strip_nul(name), Val.Nothing));
                    index = index + 8 + str_size;
                    k += 1;
                }
                if num_props > s.len() / 8 {
                    num_props = s.len() / 8;
                }
                let mut i = 2;
                while i < num_props {
                    let mut pid = 0;
                    match user_property(s, i, mut pid, convert, no_conversion) {
                        Ok(v) => {
                            if i - 2 < data.len() {
                                let name = data[i - 2].0.clone();
                                data[i - 2] = (name, v);
                            } else {
                                let msg = f"Error while parsing property id {pid} in stream {repr_str(filename)}: list index out of range";
                                self.defect_as(DEFECT_INCORRECT, msg, "IndexError".to_string())?;
                            }
                        }
                        Err(exc) => {
                            let msg = f"Error while parsing property id {pid} in stream {repr_str(filename)}: {exc.msg}";
                            self.defect_as(DEFECT_INCORRECT, msg, exc.kind)?;
                        }
                    }
                    i += 1;
                }
            }
            n += 1;
        }
        Ok(())
    }
}

// One property of a user-defined section, with the offsets olefile
// uses there.
fn user_property(s: ref Vec[u8], i: i64, pid: mut ref i64, convert: bool, no_conversion: ref Vec[i64]) -> Result[Val, PyErr] {
    *pid = i32(s, 8 + i * 8)?;
    let offset = i32(s, 12 + i * 8)?;
    let t = i32(s, offset)?;
    if t == VT_I2 {
        let mut v = i16(s, offset + 4)?;
        if v >= 32768 {
            v -= 65536;
        }
        return Ok(Val.Int(v));
    }
    if t == 1 {
        let str_size = i32(s, offset + 8)?;
        return Ok(Val.Bytes(sub_bytes(s, offset + 12, offset + 12 + str_size - 1)));
    }
    if t == VT_UI2 {
        return Ok(Val.Int(i16(s, offset + 4)?));
    }
    if t == VT_I4 or t == VT_INT or t == VT_ERROR or t == VT_UI4 or t == VT_UINT {
        return Ok(Val.Int(i32(s, offset + 4)?));
    }
    if t == VT_BSTR or t == VT_LPSTR {
        let count = i32(s, offset + 4)?;
        return Ok(Val.Bytes(drop_nuls(sub_bytes(s, offset + 8, offset + 8 + count - 1))));
    }
    if t == VT_BLOB or t == VT_CF {
        let count = i32(s, offset + 4)?;
        return Ok(Val.Bytes(sub_bytes(s, offset + 8, offset + 8 + count)));
    }
    if t == VT_LPWSTR {
        let count = i32(s, offset + 4)?;
        return Ok(Val.Text(decode_utf16(sub_bytes(s, offset + 8, offset + 8 + count * 2))));
    }
    if t == VT_FILETIME {
        let ft = filetime_at(s, offset + 4)?;
        return time_val(ft, convert, *pid, no_conversion);
    }
    if t == VT_UI1 {
        return Ok(Val.Int(byte_at(s, offset + 4)?));
    }
    if t == VT_CLSID {
        return Ok(Val.Text(clsid_text(sub_bytes(s, offset + 4, offset + 20))?));
    }
    if t == VT_BOOL {
        return Ok(Val.Bool(i16(s, offset + 4)? != 0));
    }
    Ok(Val.Nothing)
}

// ------------------------------------------------------------ OleMetadata

fn summary_attribs() -> Vec[String] {
    let names = ["codepage", "title", "subject", "author", "keywords", "comments",
        "template", "last_saved_by", "revision_number", "total_edit_time",
        "last_printed", "create_time", "last_saved_time", "num_pages",
        "num_words", "num_chars", "thumbnail", "creating_application",
        "security"];
    let mut out: Vec[String] = Vec.new();
    for n in names.iter() {
        out.push(n.to_string());
    }
    out
}

fn docsum_attribs() -> Vec[String] {
    let names = ["codepage_doc", "category", "presentation_target", "bytes", "lines", "paragraphs",
        "slides", "notes", "hidden_slides", "mm_clips",
        "scale_crop", "heading_pairs", "titles_of_parts", "manager",
        "company", "links_dirty", "chars_with_spaces", "unused", "shared_doc",
        "link_base", "hlinks", "hlinks_changed", "version", "dig_sig",
        "content_type", "content_status", "language", "doc_version"];
    let mut out: Vec[String] = Vec.new();
    for n in names.iter() {
        out.push(n.to_string());
    }
    out
}

// The attributes in SUMMARY_ATTRIBS + DOCSUM_ATTRIBS order, each with
// its value (Nothing when absent).
fn get_metadata(ole: mut ref Ole) -> Result[Vec[(String, Val)], PyErr] {
    let mut md: Vec[(String, Val)] = Vec.new();
    let sa = summary_attribs();
    let da = docsum_attribs();
    let mut svals: Vec[Val] = Vec.new();
    let mut dvals: Vec[Val] = Vec.new();
    for _ in sa.iter() {
        svals.push(Val.Nothing);
    }
    for _ in da.iter() {
        dvals.push(Val.Nothing);
    }
    let sum = "\u{5}SummaryInformation".to_string();
    if ole.exists(sum) {
        let props = ole.getproperties(sum, true, [10])?;
        let mut i = 0;
        while i < sa.len() {
            svals[i] = dict_get(props, i + 1);
            i += 1;
        }
    }
    let doc = "\u{5}DocumentSummaryInformation".to_string();
    if ole.exists(doc) {
        let none: Vec[i64] = Vec.new();
        let props = ole.getproperties(doc, true, none)?;
        let mut i = 0;
        while i < da.len() {
            dvals[i] = dict_get(props, i + 1);
            i += 1;
        }
    }
    let mut i = 0;
    while i < sa.len() {
        md.push((sa[i].clone(), svals[i].clone()));
        i += 1;
    }
    let mut j = 0;
    while j < da.len() {
        md.push((da[j].clone(), dvals[j].clone()));
        j += 1;
    }
    Ok(md)
}

fn md_get(md: ref Vec[(String, Val)], name: Str) -> Val {
    for item in md.iter() {
        let (k, v) = item;
        if *k == name {
            return v.clone();
        }
    }
    Val.Nothing
}
// ------------------------------------------------------------ the jobs

fn kind_name(t: i64) -> String {
    if t == 0 {
        "empty".to_string()
    } else if t == 1 {
        "storage".to_string()
    } else if t == 2 {
        "stream".to_string()
    } else if t == 3 {
        "lockbytes".to_string()
    } else if t == 4 {
        "property".to_string()
    } else if t == 5 {
        "root".to_string()
    } else {
        f"type {t}"
    }
}

fn unescape(p: ref String) -> String {
    p.replace("\\x05", "\u{5}").replace("\\x01", "\u{1}").replace("\\x03", "\u{3}")
}

fn is_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return false;
        }
    }
    true
}

fn level_of(args: ref Vec[String], i: i64) -> i64 {
    if i >= 0 and args.len() > i and is_digits(args[i]) {
        let mut n = 0;
        for c in args[i].chars() {
            n = n * 10 + ((c as u32) - 48) as i64;
        }
        return n;
    }
    DEFECT_FATAL
}

fn print_issues(ole: ref Ole) {
    if ole.issues.len() > 0 {
        println("  issues:");
        for item in ole.issues.iter() {
            let (t, m) = item;
            println(f"    {t}: {m}");
        }
    }
}

fn job_open(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let ole = open_ole(args[0], level_of(args, 1))?;
    let mut loaded = 0;
    for l in ole.loaded.iter() {
        if *l {
            loaded += 1;
        }
    }
    println(f"  sectors {ole.sector_size}/{ole.mini_sector_size} cutoff {ole.minisectorcutoff} nb_sect {ole.nb_sect} fat {ole.fat.len()} entries {ole.entries.len()} loaded {loaded}");
    println(f"  version {ole.minor_version}.{ole.dll_version} byte order {hexu(ole.byte_order, 4)} difat {ole.num_fat_sectors}/{ole.num_difat_sectors}");
    println(f"  header clsid {repr_str(ole.header_clsid)} root {repr_str(ole.entries[0].name)} root clsid {repr_str(ole.entries[0].clsid)}");
    Ok(Some(ole))
}

fn walk(ole: ref Ole, sid: i64, depth: i64, onpath: ref Vec[i64]) {
    let e = ole.entries[sid].clone();
    let mut line = "  ".to_string();
    let mut d = 0;
    while d < depth {
        line.push_str("  ");
        d += 1;
    }
    line.push_str(f"{repr_str(e.name)} {kind_name(e.entry_type)}");
    if e.entry_type == STGTY_STREAM or e.entry_type == STGTY_ROOT {
        line.push_str(f" {e.size}");
        if e.is_minifat {
            line.push_str(" mini");
        }
    }
    if e.clsid.len() > 0 {
        line.push_str(" {");
        line.push_str(e.clsid);
        line.push('}');
    }
    for p in onpath.iter() {
        if *p == e.sid {
            println(f"{line} (again)");
            return;
        }
    }
    println(line);
    let mut path = onpath.clone();
    path.push(e.sid);
    for k in e.kids.iter() {
        walk(ole, *k, depth + 1, path);
    }
}

fn job_tree(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let ole = open_ole(args[0], level_of(args, 1))?;
    let none: Vec[i64] = Vec.new();
    walk(ole, 0, 0, none);
    Ok(Some(ole))
}

fn job_list(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let mut ole = open_ole(args[0], level_of(args, 2))?;
    let mode = if args.len() > 1 { args[1].clone() } else { "streams".to_string() };
    match ole.listdir(mode != "storages", mode != "streams") {
        Ok(paths) => {
            for p in paths.iter() {
                println(f"  {repr_list(p)}");
            }
        }
        Err(e) => println(f"  {err_text(e)}"),
    }
    Ok(Some(ole))
}

fn show_time(ole: ref Ole, p: ref String, label: Str, modify: bool) {
    match ole.find(p) {
        Ok(sid) => {
            let ft = if modify { ole.entries[sid].modify_time } else { ole.entries[sid].create_time };
            if ft == 0 {
                println(f"  {label} None");
            } else {
                match filetime_date(ft) {
                    Ok(d) => println(f"  {label} {date_str(d)}"),
                    Err(e) => println(f"  {label} {err_text(e)}"),
                }
            }
        }
        Err(e) => println(f"  {label} {err_text(e)}"),
    }
}

fn job_entry(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let ole = open_ole(args[0], DEFECT_FATAL)?;
    let p = unescape(args[1]);
    let t = match ole.find(p) {
        Ok(sid) => f"{ole.entries[sid].entry_type}",
        Err(_) => "False".to_string(),
    };
    let ex = if ole.exists(p) { "True" } else { "False" };
    println(f"  exists {ex} type {t}");
    match ole.get_size(p) {
        Ok(n) => println(f"  size {n}"),
        Err(e) => println(f"  size {err_text(e)}"),
    }
    match ole.find(p) {
        Ok(sid) => println(f"  clsid {repr_str(ole.entries[sid].clsid)}"),
        Err(e) => println(f"  clsid {err_text(e)}"),
    }
    show_time(ole, p, "mtime", true);
    show_time(ole, p, "ctime", false);
    Ok(Some(ole))
}

fn job_stream(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let mut ole = open_ole(args[0], DEFECT_FATAL)?;
    let p = unescape(args[1]);
    ole.level = level_of(args, 2);
    match ole.openstream(p) {
        Ok(data) => {
            println(f"  {data.len()} bytes adler32 {adler32(data):08x}");
            println(f"  head {hex_of(sub_bytes(data, 0, 24))}");
        }
        Err(e) => println(f"  {err_text(e)}"),
    }
    Ok(Some(ole))
}

fn job_props(args: ref Vec[String], user: bool) -> Result[Option[Ole], PyErr] {
    let mut ole = open_ole(args[0], DEFECT_FATAL)?;
    let p = unescape(args[1]);
    let mut convert = false;
    let mut i = 2;
    while i < args.len() {
        if args[i] == "convert" {
            convert = true;
        }
        i += 1;
    }
    ole.level = level_of(args, args.len() - 1);
    if user {
        match ole.get_userdefined_properties(p, convert, [10]) {
            Ok(props) => {
                println(f"  {props.len()} properties");
                for item in props.iter() {
                    let (k, v) = item;
                    println(f"  {repr_str(k)}: {val_repr(v)}");
                }
            }
            Err(e) => println(f"  {err_text(e)}"),
        }
    } else {
        match ole.getproperties(p, convert, [10]) {
            Ok(props) => {
                println(f"  {props.len()} properties");
                for item in props.iter() {
                    let (k, v) = item;
                    println(f"  {*k}: {val_repr(v)}");
                }
            }
            Err(e) => println(f"  {err_text(e)}"),
        }
    }
    Ok(Some(ole))
}

fn job_meta(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let mut ole = open_ole(args[0], DEFECT_FATAL)?;
    match get_metadata(mut ole) {
        Ok(md) => {
            for item in md.iter() {
                let (k, v) = item;
                if not is_none(v) {
                    println(f"  {k}: {val_repr(v)}");
                }
            }
        }
        Err(e) => println(f"  {err_text(e)}"),
    }
    Ok(Some(ole))
}

fn job_extract(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let mut ole = open_ole(args[0], DEFECT_FATAL)?;
    let p = unescape(args[1]);
    match ole.openstream(p) {
        Ok(data) => {
            let out = f"data/out/{args[2]}";
            if let Err(e) = fs.write_bytes(out, data.clone()) {
                println(f"  ! OSError: {e}");
            } else {
                println(f"  wrote out/{args[2]}, {data.len()} bytes adler32 {adler32(data):08x}");
            }
        }
        Err(e) => println(f"  {err_text(e)}"),
    }
    Ok(Some(ole))
}

// ------------------------------------------------------------ the intake report

fn text_of(v: ref Val) -> String {
    match v {
        Val.Bytes(b) => latin1(b),
        _ => val_str(v),
    }
}

fn kind_of(ole: ref Ole) -> String {
    let c = ole.entries[0].clsid.clone();
    if c == "00020906-0000-0000-C000-000000000046" {
        return "word".to_string();
    }
    if c == "00020820-0000-0000-C000-000000000046" {
        return "excel".to_string();
    }
    if c == "00020D0B-0000-0000-C000-000000000046" {
        return "outlook".to_string();
    }
    if ole.exists("WordDocument".to_string()) {
        return "word".to_string();
    }
    if ole.exists("Workbook".to_string()) or ole.exists("Book".to_string()) {
        return "excel".to_string();
    }
    if ole.exists("__substg1.0_0037001F".to_string()) {
        return "outlook".to_string();
    }
    "unknown".to_string()
}

fn utf16_stream(ole: mut ref Ole, p: ref String) -> Result[Option[String], PyErr] {
    if not ole.exists(p) {
        return Ok(None);
    }
    Ok(Some(decode_utf16(ole.openstream(p)?)))
}

fn opt_str(s: ref Option[String]) -> String {
    match s {
        Some(x) => x.clone(),
        None => "None".to_string(),
    }
}

fn or_empty(s: ref Option[String]) -> String {
    match s {
        Some(x) => x.clone(),
        None => String.new(),
    }
}

fn opt_repr(s: ref Option[String]) -> String {
    match s {
        Some(x) => repr_str(x),
        None => "None".to_string(),
    }
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.Nothing => false,
        Val.Bool(b) => *b,
        Val.Int(n) => *n != 0,
        Val.Bytes(b) => b.len() > 0,
        Val.Text(s) => s.len() > 0,
        Val.Date(_) => true,
        Val.List(xs) => xs.len() > 0,
    }
}

// What the report reads from one file: the outlook or document lines,
// and the flags they raise.
fn read_one(ole: mut ref Ole, kind: ref String, flags: mut ref Vec[String], title: mut ref String) -> Result[(), PyErr] {
    if *kind == "outlook" {
        let subject = utf16_stream(mut ole, "__substg1.0_0037001F".to_string())?;
        let sender = utf16_stream(mut ole, "__substg1.0_0C1A001F".to_string())?;
        let addr = utf16_stream(mut ole, "__substg1.0_0C1F001F".to_string())?;
        *title = or_empty(subject);
        println(f"    outlook message {opt_repr(subject)} from {opt_str(sender)} <{opt_str(addr)}>");
        let mut atts: Vec[String] = Vec.new();
        for p in ole.listdir(false, true)?.iter() {
            if p.len() == 1 and p[0].starts_with("__attach_version1.0_#") {
                atts.push(p[0].clone());
            }
        }
        for a in atts.iter() {
            let fname = utf16_stream(mut ole, f"{a}/__substg1.0_3707001F")?;
            let size = ole.get_size(f"{a}/__substg1.0_37010102")?;
            println(f"    attachment {opt_str(fname)}, {size} bytes");
        }
        if atts.len() > 0 {
            flags.push(f"{atts.len()} attachments");
        }
    } else {
        let md = get_metadata(mut ole)?;
        let t = md_get(md, "title");
        *title = if is_none(t) { String.new() } else { text_of(t) };
        println(f"    {kind} document {repr_str(*title)} by {text_of(md_get(md, "author"))}, last saved by {text_of(md_get(md, "last_saved_by"))}");
        let created = md_get(md, "create_time");
        let saved = md_get(md, "last_saved_time");
        if not is_none(created) or not is_none(saved) {
            println(f"    created {val_str(created)}, saved {val_str(saved)}");
        }
        let pages = md_get(md, "num_pages");
        if truthy(pages) {
            println(f"    {val_str(pages)} pages, {val_str(md_get(md, "num_words"))} words");
        }
        let company = md_get(md, "company");
        if not is_none(company) {
            println(f"    company {text_of(company)}");
        }
        let wd = "WordDocument".to_string();
        if *kind == "word" and ole.exists(wd) {
            let fib = sub_bytes(ole.openstream(wd)?, 0, 12);
            if fib.len() >= 12 and fib[0] == 0xEC and fib[1] == 0xA5 and (fib[11] & 0x01) != 0 {
                flags.push("encrypted".to_string());
            }
        }
    }
    if ole.exists("Macros".to_string()) or ole.exists("_VBA_PROJECT_CUR".to_string()) or ole.exists("VBA".to_string()) {
        flags.push("macros".to_string());
    }
    if ole.exists("ObjectPool".to_string()) {
        flags.push("embedded objects".to_string());
    }
    Ok(())
}

fn has(flags: ref Vec[String], f: Str) -> bool {
    for x in flags.iter() {
        if *x == f {
            return true;
        }
    }
    false
}

fn report_one(name: ref String, manifest: mut ref Vec[(String, String, String, String, i64)]) -> String {
    println(f"  {name}");
    let mut ole = match open_ole(name, DEFECT_FATAL) {
        Ok(o) => o,
        Err(e) => {
            println(f"    rejected: {err_text(e)}");
            manifest.push((name.clone(), "-".to_string(), "rejected".to_string(), String.new(), 0));
            return "rejected".to_string();
        }
    };
    let kind = kind_of(ole);
    let mut flags: Vec[String] = Vec.new();
    let mut title = String.new();
    if let Err(e) = read_one(mut ole, kind, mut flags, mut title) {
        println(f"    unreadable: {err_text(e)}");
        flags.push("unreadable".to_string());
    }
    let n = ole.issues.len();
    if n > 0 {
        flags.push(f"{n} defects");
        let mut i = 0;
        while i < n and i < 3 {
            let (t, m) = ole.issues[i].clone();
            println(f"    defect {t}: {m}");
            i += 1;
        }
    }
    let strict = match open_ole(name, DEFECT_INCORRECT) {
        Ok(_) => "ok".to_string(),
        Err(e) => {
            println(f"    strict open: {err_text(e)}");
            "rejected".to_string()
        }
    };
    let decision = if has(flags, "macros") or has(flags, "encrypted") or has(flags, "unreadable") or strict == "rejected" {
        "quarantine".to_string()
    } else if n > 0 {
        "review".to_string()
    } else {
        "archive".to_string()
    };
    let shown = if flags.len() > 0 { join(flags, ", ") } else { "none".to_string() };
    println(f"    flags: {shown}; strict {strict}; {decision}");
    manifest.push((name.clone(), kind, decision.clone(), title, n));
    decision
}

fn job_report(args: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let mut manifest: Vec[(String, String, String, String, i64)] = Vec.new();
    let order = ["archive", "review", "quarantine", "rejected"];
    let mut counts: Vec[i64] = [0, 0, 0, 0];
    for name in args.iter() {
        let d = report_one(name, mut manifest);
        let mut i = 0;
        while i < 4 {
            if d == order[i] {
                counts[i] += 1;
            }
            i += 1;
        }
    }
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < 4 {
        if counts[i] > 0 {
            parts.push(f"{order[i]} {counts[i]}");
        }
        i += 1;
    }
    println(f"  {join(parts, ", ")}");
    let mut lines: Vec[String] = Vec.new();
    lines.push("file,kind,decision,title,defects".to_string());
    for row in manifest.iter() {
        let (name, kind, decision, title, n) = row;
        let mut t = title.replace("\"", "\"\"");
        if t.contains(",") or t.contains("\"") {
            t = f"\"{t}\"";
        }
        lines.push(f"{name},{kind},{decision},{t},{*n}");
    }
    let mut text = join(lines, "\r\n");
    text.push_str("\r\n");
    let data = text.bytes().to_vec();
    if let Err(e) = fs.write_bytes("data/out/manifest.csv".to_string(), data.clone()) {
        println(f"  ! OSError: {e}");
    }
    println(f"  wrote out/manifest.csv, {data.len()} bytes adler32 {adler32(data):08x}");
    Ok(None)
}

fn run_job(words: ref Vec[String]) -> Result[Option[Ole], PyErr] {
    let mut args: Vec[String] = Vec.new();
    let mut i = 1;
    while i < words.len() {
        args.push(words[i].clone());
        i += 1;
    }
    let w = words[0].clone();
    if w == "open" {
        job_open(args)
    } else if w == "tree" {
        job_tree(args)
    } else if w == "list" {
        job_list(args)
    } else if w == "entry" {
        job_entry(args)
    } else if w == "stream" {
        job_stream(args)
    } else if w == "props" {
        job_props(args, false)
    } else if w == "userprops" {
        job_props(args, true)
    } else if w == "meta" {
        job_meta(args)
    } else if w == "extract" {
        job_extract(args)
    } else {
        job_report(args)
    }
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let text = match fs.read_bytes("data/jobs.txt".to_string()) {
        Ok(b) => latin1(b),
        Err(_) => String.new(),
    };
    for line in split_on(text, '\n').iter() {
        let words = split_ws(line);
        if words.len() == 0 {
            continue;
        }
        println(f"== {line}");
        match run_job(words) {
            Ok(Some(ole)) => print_issues(ole),
            Ok(None) => {}
            Err(e) => println(f"  {err_text(e)}"),
        }
    }
}
