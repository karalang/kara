// mini_humanize: humanize 4.16.0, the library that turns numbers, sizes
// and time spans into the words a person reads ("3.2 MB", "1.2 million",
// "2 hours ago", "1st"), ported from humanize/number.py, filesize.py,
// time.py, lists.py and i18n.py, together with the parts of Python 3.13
// it stands on: gettext's .mo loader, plural rules and fallback chains,
// locale name expansion, %-formatting and format specs, timedelta,
// Fraction.limit_denominator and strftime.
//
// The run writes the catalogs of the data section into data/locale/ and
// runs every job of data/jobs.jsonl: an activate job switches the
// language the way humanize.activate() does, loading catalogs from
// data/locale/, and a call job calls one humanize function and prints
// the repr() of what it returns, or the exception it raises.

import std.time.{SystemTime};

// ------------------------------------------------------------ characters

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn slice(v: ref Vec[char], lo: i64, hi: i64) -> Vec[char] {
    let mut a = lo;
    let mut b = hi;
    if a < 0 {
        a = 0;
    }
    if b > v.len() {
        b = v.len();
    }
    if a >= b {
        return Vec.new();
    }
    v[a..b].to_vec()
}

fn width(s: ref String) -> i64 {
    s.chars().count()
}

fn spaces(n: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(' ');
    }
    s
}

fn repeat(s: ref String, n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(s);
    }
    out
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// str.isspace, which str.strip, str.split and float() use.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and py_space(v[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, lo, hi))
}

fn py_rstrip(s: ref String) -> String {
    let v = chars(s);
    let mut hi = v.len();
    while hi > 0 and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, 0, hi))
}

fn ascii_lower(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(char.try_from(c as i64 + 32).unwrap_or(c));
        } else {
            out.push(c);
        }
    }
    out
}

// str.rfind(c), in code points.
fn rfind(v: ref Vec[char], c: char) -> i64 {
    let mut k = v.len() - 1;
    while k >= 0 {
        if v[k] == c {
            return k;
        }
        k -= 1;
    }
    -1
}

// `needle in hay`
fn contains_seq(hay: ref Vec[char], needle: ref Vec[char]) -> bool {
    if needle.is_empty() {
        return true;
    }
    let mut i = 0;
    while i + needle.len() <= hay.len() {
        let mut ok = true;
        for k in 0..needle.len() {
            if hay[i + k] != needle[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return true;
        }
        i += 1;
    }
    false
}

// str.splitlines()
fn line_break(c: char) -> bool {
    c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' or c == '\u{1c}' or c == '\u{1d}' or c == '\u{1e}'
        or c == '\u{85}' or c == '\u{2028}' or c == '\u{2029}'
}

fn splitlines(s: ref String) -> Vec[String] {
    let v = chars(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if line_break(c) {
            out.push(cur);
            cur = String.new();
            if c == '\r' and i + 1 < v.len() and v[i + 1] == '\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// re.split("[\r\n]", s)
fn split_rn(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\r' or c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn has_line_break(s: ref String) -> bool {
    s.contains("\n") or s.contains("\r")
}

fn hex_digits(v: i64, n: i64) -> String {
    let mut s = f"{v:x}";
    while s.len() < n {
        s = f"0{s}";
    }
    s
}

fn printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) or (c >= 0x205F and c <= 0x206F) {
        return false;
    }
    if c == 0x3000 or c == 0xFEFF or (c >= 0xE000 and c <= 0xF8FF) {
        return false;
    }
    true
}

// repr(str)
fn repr_str(s: ref String) -> String {
    let single = s.contains("'");
    let double = s.contains("\"");
    let q = if single and not double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if printable(o) {
            out.push(c);
        } else if o < 0x100 {
            out.push_str(f"\\x{hex_digits(o, 2)}");
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            out.push_str(f"\\U{hex_digits(o, 8)}");
        }
    }
    out.push(q);
    out
}

// s.encode("unicode_escape").decode()
fn unicode_escape(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        let o = c as i64;
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if o >= 0x20 and o < 0x7f {
            out.push(c);
        } else if o < 0x100 {
            out.push_str(f"\\x{hex_digits(o, 2)}");
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            out.push_str(f"\\U{hex_digits(o, 8)}");
        }
    }
    out
}

fn hex_value(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

// s.encode("utf-8").decode("unicode_escape"), for the escapes above.
fn unicode_unescape(s: ref String) -> String {
    let v = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        if v[i] != '\\' or i + 1 >= v.len() {
            out.push(v[i]);
            i += 1;
            continue;
        }
        let e = v[i + 1];
        let n = if e == 'x' { 2 } else if e == 'u' { 4 } else if e == 'U' { 8 } else { 0 };
        if n > 0 {
            let mut code = 0;
            for k in 0..n {
                code = code * 16 + hex_value(v[i + 2 + k]);
            }
            out.push(char.try_from(code).unwrap_or('?'));
            i += 2 + n;
        } else {
            if e == 't' {
                out.push('\t');
            } else if e == 'n' {
                out.push('\n');
            } else if e == 'r' {
                out.push('\r');
            } else {
                out.push(e);
            }
            i += 2;
        }
    }
    out
}

// ------------------------------------------------------------ JSON

#[derive(Clone)]
enum JValue {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    List(Vec[JValue]),
    Obj(Vec[(String, JValue)]),
}

fn push_utf8(out: mut ref Vec[u8], c: u32) {
    if c < 0x80 {
        out.push(c as u8);
    } else if c < 0x800 {
        out.push((0xC0 | (c >> 6)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else if c < 0x10000 {
        out.push((0xE0 | (c >> 12)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (c >> 18)) as u8);
        out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    }
}

struct JsonReader {
    b: Vec[u8],
    at: i64,
}

impl JsonReader {
    fn ws(mut ref self) {
        while self.at < self.b.len() {
            let c = self.b[self.at];
            if c == b' ' or c == b'\n' or c == b'\r' or c == b'\t' {
                self.at += 1;
            } else {
                break;
            }
        }
    }

    fn eat(mut ref self, word: Str) -> bool {
        let w = word.bytes();
        if self.at + w.len() > self.b.len() {
            return false;
        }
        for k in 0..w.len() {
            if self.b[self.at + k] != w[k] {
                return false;
            }
        }
        self.at += w.len();
        true
    }

    fn value(mut ref self) -> Result[JValue, String] {
        self.ws();
        if self.at >= self.b.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.b[self.at];
        if c == b'{' {
            self.at += 1;
            let mut m: Vec[(String, JValue)] = Vec.new();
            self.ws();
            if self.eat("}") {
                return Ok(JValue.Obj(m));
            }
            loop {
                self.ws();
                let k = self.string()?;
                self.ws();
                if not self.eat(":") {
                    return Err(f"expected ':' at {self.at}");
                }
                let v = self.value()?;
                m.push((k, v));
                self.ws();
                if self.eat("}") {
                    return Ok(JValue.Obj(m));
                }
                if not self.eat(",") {
                    return Err(f"expected ',' at {self.at}");
                }
            }
        }
        if c == b'[' {
            self.at += 1;
            let mut items: Vec[JValue] = Vec.new();
            self.ws();
            if self.eat("]") {
                return Ok(JValue.List(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.eat("]") {
                    return Ok(JValue.List(items));
                }
                if not self.eat(",") {
                    return Err(f"expected ',' at {self.at}");
                }
            }
        }
        if c == b'"' {
            return Ok(JValue.Str(self.string()?));
        }
        if self.eat("true") {
            return Ok(JValue.Bool(true));
        }
        if self.eat("false") {
            return Ok(JValue.Bool(false));
        }
        if self.eat("null") {
            return Ok(JValue.Null);
        }
        self.number()
    }

    fn hex4(mut ref self) -> u32 {
        let mut v: u32 = 0;
        for _ in 0..4 {
            let c = self.b[self.at];
            self.at += 1;
            let d = if c >= b'0' and c <= b'9' {
                c - b'0'
            } else if c >= b'a' and c <= b'f' {
                c - b'a' + 10
            } else {
                c - b'A' + 10
            };
            v = v * 16 + d as u32;
        }
        v
    }

    fn string(mut ref self) -> Result[String, String] {
        if not self.eat("\"") {
            return Err(f"expected string at {self.at}");
        }
        let mut out: Vec[u8] = Vec.new();
        loop {
            if self.at >= self.b.len() {
                return Err("unterminated string".to_string());
            }
            let c = self.b[self.at];
            self.at += 1;
            if c == b'"' {
                break;
            }
            if c != b'\\' {
                out.push(c);
                continue;
            }
            let e = self.b[self.at];
            self.at += 1;
            if e == b'n' {
                out.push(10);
            } else if e == b't' {
                out.push(9);
            } else if e == b'r' {
                out.push(13);
            } else if e == b'b' {
                out.push(8);
            } else if e == b'f' {
                out.push(12);
            } else if e == b'u' {
                let mut cp = self.hex4();
                if cp >= 0xD800 and cp < 0xDC00 and self.eat("\\u") {
                    let lo = self.hex4();
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                }
                push_utf8(mut out, cp);
            } else {
                out.push(e);
            }
        }
        Ok(String.from_utf8(out).unwrap_or("?".to_string()))
    }

    fn number(mut ref self) -> Result[JValue, String] {
        let start = self.at;
        let mut float = false;
        while self.at < self.b.len() {
            let c = self.b[self.at];
            if c >= b'0' and c <= b'9' {
                self.at += 1;
            } else if c == b'-' or c == b'+' {
                self.at += 1;
            } else if c == b'.' or c == b'e' or c == b'E' {
                float = true;
                self.at += 1;
            } else {
                break;
            }
        }
        let t = String.from_utf8(self.b[start..self.at].to_vec()).unwrap_or(String.new());
        if t.is_empty() {
            return Err(f"bad value at {start}");
        }
        if float {
            return match f64.parse(t) {
                Ok(f) => Ok(JValue.Float(f)),
                Err(_) => Err(f"bad number {t}"),
            };
        }
        match i64.parse(t) {
            Ok(i) => Ok(JValue.Int(i)),
            Err(_) => Err(f"bad number {t}"),
        }
    }
}

fn parse_json(t: ref String) -> Result[JValue, String] {
    let mut r = JsonReader { b: t.bytes().to_vec(), at: 0 };
    r.value()
}

fn get(o: ref JValue, key: Str) -> Option[JValue] {
    if let JValue.Obj(items) = o {
        for (k, v) in items.iter() {
            if k == key {
                return Some(v.clone());
            }
        }
    }
    None
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    f"{x}"
}

// ------------------------------------------------------------ Python's int() and float()

// The digits of s[lo..hi] with Python's underscores: each '_' sits between
// two digits. None if anything else is there.
fn digits_with_underscores(v: ref Vec[char], lo: i64, hi: i64) -> Option[String] {
    let mut out = String.new();
    for k in lo..hi {
        let c = v[k];
        if is_digit(c) {
            out.push(c);
        } else if c == '_' and k > lo and k + 1 < hi and is_digit(v[k - 1]) and is_digit(v[k + 1]) {
            continue;
        } else {
            return None;
        }
    }
    Some(out)
}

// Can int(s) convert it?
fn py_int_ok(s: ref String) -> bool {
    let v = chars(py_strip(s));
    let mut i = 0;
    if i < v.len() and (v[i] == '+' or v[i] == '-') {
        i += 1;
    }
    if i >= v.len() {
        return false;
    }
    match digits_with_underscores(v, i, v.len()) {
        Some(d) => not d.is_empty(),
        None => false,
    }
}

// float(s), or None where it raises.
fn py_float(s: ref String) -> Option[f64] {
    let v = chars(py_strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < v.len() and (v[i] == '+' or v[i] == '-') {
        neg = v[i] == '-';
        i += 1;
    }
    let rest = ascii_lower(text(slice(v, i, v.len())));
    if rest == "inf" or rest == "infinity" {
        return Some(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if rest == "nan" {
        return Some(0.0 / 0.0);
    }
    let n = v.len();
    let mut k = i;
    while k < n and (is_digit(v[k]) or v[k] == '_') {
        k += 1;
    }
    let int_part = digits_with_underscores(v, i, k)?;
    let mut frac_part = String.new();
    if k < n and v[k] == '.' {
        let f0 = k + 1;
        k += 1;
        while k < n and (is_digit(v[k]) or v[k] == '_') {
            k += 1;
        }
        frac_part = digits_with_underscores(v, f0, k)?;
    }
    if int_part.is_empty() and frac_part.is_empty() {
        return None;
    }
    let mut exp_part = "0".to_string();
    if k < n and (v[k] == 'e' or v[k] == 'E') {
        k += 1;
        let mut sign = String.new();
        if k < n and (v[k] == '+' or v[k] == '-') {
            sign.push(v[k]);
            k += 1;
        }
        let e0 = k;
        while k < n and (is_digit(v[k]) or v[k] == '_') {
            k += 1;
        }
        let e = digits_with_underscores(v, e0, k)?;
        if e.is_empty() {
            return None;
        }
        exp_part = f"{sign}{e}";
    }
    if k != n {
        return None;
    }
    let ip = if int_part.is_empty() { "0".to_string() } else { int_part };
    let fp = if frac_part.is_empty() { "0".to_string() } else { frac_part };
    let sign = if neg { "-" } else { "" };
    let lit = f"{sign}{ip}.{fp}e{exp_part}";
    match f64.parse(lit) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

fn is_inf_or_nan(x: f64) -> bool {
    x != x or x == 1.0 / 0.0 or x == -1.0 / 0.0
}

// ------------------------------------------------------------ format specs

fn value_error(msg: ref String) -> String {
    f"ValueError: {msg}"
}

struct Spec {
    fill: char,
    align: char,
    sign: char,
    no_neg_0: bool,
    alternate: bool,
    width: i64,
    // 0 none, 1 ',' every 3, 2 '_' every 3, 3 '_' every 4
    sep: i64,
    precision: i64,
    kind: char,
}

fn is_align(c: char) -> bool {
    c == '<' or c == '>' or c == '=' or c == '^'
}

// A presentation type in an error message.
fn code_text(c: char) -> String {
    let o = c as i64;
    if o > 32 and o < 128 {
        f"'{c}'"
    } else {
        f"'\\x{o:x}'"
    }
}

fn unknown_code(c: char, tname: Str) -> String {
    value_error(f"Unknown format code {code_text(c)} for object of type '{tname}'")
}

fn both_seps() -> String {
    value_error("Cannot specify both ',' and '_'.")
}

// The digits at sp[pos..]: (value, digit count, position after them).
fn spec_integer(sp: ref Vec[char], pos: i64) -> Result[(i64, i64, i64), String] {
    let mut acc = 0;
    let mut n = 0;
    let mut p = pos;
    while p < sp.len() and is_digit(sp[p]) {
        let d = sp[p] as i64 - 48;
        if acc > (9223372036854775807 - d) / 10 {
            return Err(value_error("Too many decimal digits in format string"));
        }
        acc = acc * 10 + d;
        n += 1;
        p += 1;
    }
    Ok((acc, n, p))
}

// parse_internal_render_format_spec in Python/formatter_unicode.c.
fn parse_spec(sp: ref Vec[char], tname: Str, default_type: char, default_align: char) -> Result[Spec, String] {
    let mut f = Spec {
        fill: ' ',
        align: default_align,
        sign: '\u{0}',
        no_neg_0: false,
        alternate: false,
        width: -1,
        sep: 0,
        precision: -1,
        kind: default_type,
    };
    let end = sp.len();
    let mut pos = 0;
    let mut fill_given = false;
    let mut align_given = false;
    if end - pos >= 2 and is_align(sp[pos + 1]) {
        f.align = sp[pos + 1];
        f.fill = sp[pos];
        fill_given = true;
        align_given = true;
        pos += 2;
    } else if end - pos >= 1 and is_align(sp[pos]) {
        f.align = sp[pos];
        align_given = true;
        pos += 1;
    }
    if pos < end and (sp[pos] == ' ' or sp[pos] == '+' or sp[pos] == '-') {
        f.sign = sp[pos];
        pos += 1;
    }
    if pos < end and sp[pos] == 'z' {
        f.no_neg_0 = true;
        pos += 1;
    }
    if pos < end and sp[pos] == '#' {
        f.alternate = true;
        pos += 1;
    }
    if not fill_given and pos < end and sp[pos] == '0' {
        f.fill = '0';
        if not align_given and default_align == '>' {
            f.align = '=';
        }
        pos += 1;
    }
    let (w, width_digits, after_width) = spec_integer(sp, pos)?;
    pos = after_width;
    if width_digits > 0 {
        f.width = w;
    }
    if pos < end and sp[pos] == ',' {
        f.sep = 1;
        pos += 1;
    }
    if pos < end and sp[pos] == '_' {
        if f.sep != 0 {
            return Err(both_seps());
        }
        f.sep = 2;
        pos += 1;
    }
    if pos < end and sp[pos] == ',' and f.sep == 2 {
        return Err(both_seps());
    }
    if pos < end and sp[pos] == '.' {
        pos += 1;
        let (precision, precision_digits, after_precision) = spec_integer(sp, pos)?;
        pos = after_precision;
        if precision_digits == 0 {
            return Err(value_error("Format specifier missing precision"));
        }
        f.precision = precision;
    }
    if end - pos > 1 {
        return Err(value_error(f"Invalid format specifier '{text(sp)}' for object of type '{tname}'"));
    }
    if end - pos == 1 {
        f.kind = sp[pos];
    }
    if f.sep != 0 {
        let t = f.kind;
        let grouped = t == 'd' or t == 'e' or t == 'f' or t == 'g' or t == 'E' or t == 'G' or t == '%' or t == 'F' or t == '\u{0}';
        let radix = t == 'b' or t == 'o' or t == 'x' or t == 'X';
        if radix and f.sep == 2 {
            f.sep = 3;
        } else if not grouped {
            let which = if f.sep == 1 { "," } else { "_" };
            return Err(value_error(f"Cannot specify '{which}' with {code_text(t)}."));
        }
    }
    Ok(f)
}

fn fill_run(c: char, n: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(c);
    }
    s
}

// body padded to the spec's width (body is n code points long).
fn pad_to(body: ref String, n: i64, w: i64, align: char, fill: char) -> String {
    let total = if w > n { w } else { n };
    let left = if align == '>' {
        total - n
    } else if align == '^' {
        (total - n) / 2
    } else {
        0
    };
    f"{fill_run(fill, left)}{body}{fill_run(fill, total - n - left)}"
}

// _PyUnicode_InsertThousandsGrouping: digits in groups of g, zero-filled
// out to min_width (which counts the separators).
fn group_digits(d: ref String, min_width: i64, g: i64, sep: char) -> String {
    let cs = chars(d);
    let mut remaining = cs.len();
    let mut pos = cs.len();
    let mut m = min_width;
    let mut groups: Vec[String] = Vec.new();
    let mut done = false;
    while not done {
        let mut l = remaining;
        if m > l {
            l = m;
        }
        if l < 1 {
            l = 1;
        }
        if l > g {
            l = g;
        }
        let n_zeros = if l > remaining { l - remaining } else { 0 };
        let n_chars = if remaining < l { remaining } else { l };
        groups.push(f"{fill_run('0', n_zeros)}{text(slice(cs, pos - n_chars, pos))}");
        pos -= n_chars;
        remaining -= n_chars;
        m -= l;
        if remaining <= 0 and m <= 0 {
            done = true;
        } else {
            m -= 1;
        }
    }
    let mut out = String.new();
    let mut k = groups.len() - 1;
    while k >= 0 {
        out.push_str(groups[k]);
        if k > 0 {
            out.push(sep);
        }
        k -= 1;
    }
    out
}

// calc_number_spec + fill_number: sign, prefix, digits (grouped here) and
// the remainder (a fraction, exponent or '%'), padded per the spec.
fn fill_number(sign: ref String, prefix: ref String, digits: ref String, remainder: ref String, f: ref Spec) -> String {
    let n_sign = width(sign);
    let n_prefix = width(prefix);
    let n_rem = width(remainder);
    let grouped = if f.sep == 0 {
        digits.clone()
    } else {
        let min_width = if f.fill == '0' and f.align == '=' {
            f.width - n_sign - n_prefix - n_rem
        } else {
            0
        };
        let sep = if f.sep == 1 { ',' } else { '_' };
        let g = if f.sep == 3 { 4 } else { 3 };
        group_digits(digits, min_width, g, sep)
    };
    let n = n_sign + n_prefix + width(grouped) + n_rem;
    let padding = if f.width > n { f.width - n } else { 0 };
    if f.align == '=' {
        f"{sign}{prefix}{fill_run(f.fill, padding)}{grouped}{remainder}"
    } else {
        pad_to(f"{sign}{prefix}{grouped}{remainder}", n, f.width, f.align, f.fill)
    }
}

fn sign_text(negative: bool, f: ref Spec) -> String {
    if negative {
        "-".to_string()
    } else if f.sign == '+' {
        "+".to_string()
    } else if f.sign == ' ' {
        " ".to_string()
    } else {
        String.new()
    }
}

// n in the given base, with lower- or upper-case letters.
fn to_base(n: u64, base: u64, upper: bool) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let mut rev: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        let d = (m % base) as i64;
        let c = if d < 10 { 48 + d } else if upper { 55 + d } else { 87 + d };
        rev.push(char.try_from(c).unwrap_or('?'));
        m = m / base;
    }
    rev.reverse();
    text(rev)
}

// format(v, spec) for an int: format_long_internal, or
// format_float_internal on float(v) for the float types.
fn format_int(v: i64, spec: ref String) -> Result[String, String] {
    let sp = chars(spec);
    if sp.is_empty() {
        return Ok(v.to_string());
    }
    let f = parse_spec(sp, "int", 'd', '>')?;
    let t = f.kind;
    if t == 'e' or t == 'E' or t == 'f' or t == 'F' or t == 'g' or t == 'G' or t == '%' {
        return Ok(format_float_spec(v as f64, f));
    }
    if not (t == 'b' or t == 'c' or t == 'd' or t == 'o' or t == 'x' or t == 'X' or t == 'n') {
        return Err(unknown_code(t, "int"));
    }
    if f.precision != -1 {
        return Err(value_error("Precision not allowed in integer format specifier"));
    }
    if f.no_neg_0 {
        return Err(value_error("Negative zero coercion (z) not allowed in integer format specifier"));
    }
    if t == 'c' {
        if f.sign != '\u{0}' {
            return Err(value_error("Sign not allowed with integer format specifier 'c'"));
        }
        if f.alternate {
            return Err(value_error("Alternate form (#) not allowed with integer format specifier 'c'"));
        }
        if v < 0 or v > 0x10ffff {
            return Err("OverflowError: %c arg not in range(0x110000)".to_string());
        }
        let mut one = String.new();
        one.push(char.try_from(v).unwrap_or('?'));
        return Ok(fill_number("", "", "", one, f));
    }
    let base: u64 = if t == 'b' {
        2
    } else if t == 'o' {
        8
    } else if t == 'x' or t == 'X' {
        16
    } else {
        10
    };
    let prefix = if not f.alternate or base == 10 {
        String.new()
    } else if t == 'b' {
        "0b".to_string()
    } else if t == 'o' {
        "0o".to_string()
    } else if t == 'x' {
        "0x".to_string()
    } else {
        "0X".to_string()
    };
    let a: u64 = if v < 0 { ((0 - (v + 1)) as u64) + 1 } else { v as u64 };
    let digits = to_base(a, base, t == 'X');
    Ok(fill_number(sign_text(v < 0, f), prefix, digits, "", f))
}

// format(True, spec): bool's own str() for an empty spec, an int otherwise.
fn format_bool(b: bool, spec: ref String) -> Result[String, String] {
    if spec.is_empty() {
        return Ok(if b { "True".to_string() } else { "False".to_string() });
    }
    format_int(if b { 1 } else { 0 }, spec)
}

// ------------------------------------------------------------ floats

// The exact decimal value of a positive finite x: big-endian digits d
// (no leading zero) and an exponent e, with x == d * 10^e.
fn exact_decimal(x: f64) -> (Vec[i64], i64) {
    let bits = x.to_bits() as i64;
    let e = (bits >> 52) & 0x7FF;
    let mut mant = bits & 0xFFFFFFFFFFFFF;
    let mut e2 = 0;
    if e == 0 {
        e2 = -1074;
    } else {
        mant = mant | 0x10000000000000;
        e2 = e - 1075;
    }
    while e2 < 0 and mant % 2 == 0 {
        mant = mant / 2;
        e2 += 1;
    }
    // Little-endian decimal digits of mant * 2^e2 (or * 5^-e2).
    let mut n: Vec[i64] = Vec.new();
    let mut t = mant;
    while t > 0 {
        n.push(t % 10);
        t = t / 10;
    }
    let factor = if e2 >= 0 { 2 } else { 5 };
    let times = if e2 >= 0 { e2 } else { 0 - e2 };
    for _ in 0..times {
        let mut carry = 0;
        for i in 0..n.len() {
            let v = n[i] * factor + carry;
            n[i] = v % 10;
            carry = v / 10;
        }
        while carry > 0 {
            n.push(carry % 10);
            carry = carry / 10;
        }
    }
    n.reverse();
    (n, if e2 >= 0 { 0 } else { e2 })
}

// The first `keep` digits of d (zero-padded), rounded half to even on the
// rest. When the rounding carries out, the result has keep + 1 digits.
fn round_digits(d: ref Vec[i64], keep: i64) -> Vec[i64] {
    let mut r: Vec[i64] = Vec.new();
    for i in 0..keep {
        r.push(if i < d.len() { d[i] } else { 0 });
    }
    if keep < 0 or keep >= d.len() {
        return r;
    }
    let first = d[keep];
    let mut rest = false;
    for i in (keep + 1)..d.len() {
        if d[i] != 0 {
            rest = true;
        }
    }
    let odd = keep > 0 and r[keep - 1] % 2 == 1;
    let up = first > 5 or (first == 5 and (rest or odd));
    if not up {
        return r;
    }
    let mut i = keep - 1;
    while i >= 0 {
        if r[i] == 9 {
            r[i] = 0;
            i -= 1;
        } else {
            r[i] += 1;
            return r;
        }
    }
    r.insert(0, 1);
    r
}

fn digit_text(d: ref Vec[i64], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    for i in lo..hi {
        s.push(char.try_from(48 + d[i]).unwrap_or('?'));
    }
    s
}

// x >= 0 to `precision` places ('f').
fn fixed_text(x: f64, precision: i64, alt: bool) -> String {
    let mut n: Vec[i64] = Vec.new();
    if x != 0.0 {
        let (d, e) = exact_decimal(x);
        let keep = d.len() + e + precision;
        if keep >= 0 {
            n = round_digits(d, keep);
        }
    }
    // n is round(x * 10^precision); give it precision + 1 digits at least.
    while n.len() < precision + 1 {
        n.insert(0, 0);
    }
    let mut lead = 0;
    while lead < n.len() - precision - 1 and n[lead] == 0 {
        lead += 1;
    }
    let point = n.len() - precision;
    let mut s = digit_text(n, lead, point);
    if precision > 0 {
        s.push('.');
        s.push_str(digit_text(n, point, n.len()));
    } else if alt {
        s.push('.');
    }
    s
}

// x >= 0 rounded to p significant digits: (exactly p digits, the decimal
// exponent of the first).
fn significant(x: f64, p: i64) -> (Vec[i64], i64) {
    if x == 0.0 {
        let mut z: Vec[i64] = Vec.new();
        for _ in 0..p {
            z.push(0);
        }
        return (z, 0);
    }
    let (d, e) = exact_decimal(x);
    let mut exp = d.len() + e - 1;
    let mut r = round_digits(d, p);
    if r.len() > p {
        r.pop();
        exp += 1;
    }
    (r, exp)
}

fn exp_text(e: i64, upper: bool) -> String {
    let mark = if upper { 'E' } else { 'e' };
    let sign = if e < 0 { '-' } else { '+' };
    let a = if e < 0 { -e } else { e };
    if a < 10 {
        f"{mark}{sign}0{a}"
    } else {
        f"{mark}{sign}{a}"
    }
}

// PyOS_double_to_string of x >= 0 for the types e, f, g and r.
fn float_body(x: f64, t: char, precision: i64, alt: bool, add_dot_0: bool) -> String {
    let upper = t == 'E' or t == 'F' or t == 'G';
    if x != x {
        return if upper { "NAN".to_string() } else { "nan".to_string() };
    }
    if x == 1.0 / 0.0 {
        return if upper { "INF".to_string() } else { "inf".to_string() };
    }
    if t == 'f' or t == 'F' {
        return fixed_text(x, precision, alt);
    }
    if t == 'r' {
        let mut s = float_repr(x);
        if alt and not s.contains(".") {
            s = match s.find("e") {
                Some(k) => f"{s[0..k]}.{s[k..]}",
                None => f"{s}.",
            };
        }
        return s;
    }
    if t == 'e' or t == 'E' {
        let (d, e) = significant(x, precision + 1);
        let mut s = digit_text(d, 0, 1);
        if precision > 0 or alt {
            s.push('.');
        }
        s.push_str(digit_text(d, 1, d.len()));
        s.push_str(exp_text(e, upper));
        return s;
    }
    // 'g'
    let p = if precision == 0 { 1 } else { precision };
    let (d, e) = significant(x, p);
    let mut n = d.len();
    if not alt {
        while n > 1 and d[n - 1] == 0 {
            n -= 1;
        }
    }
    let decpt = e + 1;
    let limit = if add_dot_0 { p - 1 } else { p };
    let mut s = String.new();
    if decpt <= -4 or decpt > limit {
        s.push_str(digit_text(d, 0, 1));
        if n > 1 or alt {
            s.push('.');
        }
        s.push_str(digit_text(d, 1, n));
        s.push_str(exp_text(e, upper));
        return s;
    }
    if decpt <= 0 {
        s.push_str("0.");
        for _ in 0..(0 - decpt) {
            s.push('0');
        }
        s.push_str(digit_text(d, 0, n));
    } else if decpt >= n {
        s.push_str(digit_text(d, 0, n));
        for _ in 0..(decpt - n) {
            s.push('0');
        }
        if alt {
            s.push('.');
        }
    } else {
        s.push_str(digit_text(d, 0, decpt));
        s.push('.');
        s.push_str(digit_text(d, decpt, n));
    }
    if add_dot_0 and not s.contains(".") {
        s.push_str(".0");
    }
    s
}

fn all_zero_digits(s: ref String) -> bool {
    for c in s.chars() {
        if c >= '1' and c <= '9' {
            return false;
        }
        if c == 'e' or c == 'E' {
            break;
        }
    }
    true
}

// format_float_internal in Python/formatter_unicode.c.
fn format_float_spec(x: f64, f: ref Spec) -> String {
    let mut t = f.kind;
    let mut precision = f.precision;
    let mut default_precision = 6;
    let mut add_dot_0 = false;
    let mut pct = false;
    if t == '\u{0}' {
        add_dot_0 = true;
        t = 'r';
        default_precision = 0;
    }
    if t == 'n' {
        t = 'g';
    }
    let mut val = x;
    if t == '%' {
        t = 'f';
        val = val * 100.0;
        pct = true;
    }
    if precision < 0 {
        precision = default_precision;
    } else if t == 'r' {
        t = 'g';
    }
    let mut negative = val.to_bits() >> 63 == 1 and val == val;
    let a = if negative { 0.0 - val } else { val };
    let body = chars(float_body(a, t, precision, f.alternate, add_dot_0));
    if negative and f.no_neg_0 and val == val and val != -1.0 / 0.0 and all_zero_digits(text(body)) {
        negative = false;
    }
    let mut k = 0;
    while k < body.len() and is_digit(body[k]) {
        k += 1;
    }
    let mut rem = text(slice(body, k, body.len()));
    if pct {
        rem.push('%');
    }
    fill_number(sign_text(negative, f), "", text(slice(body, 0, k)), rem, f)
}

// format(x, spec) for a float.
fn format_float(x: f64, spec: ref String) -> Result[String, String] {
    let f = parse_spec(chars(spec), "float", '\u{0}', '>')?;
    let t = f.kind;
    if not (t == '\u{0}' or t == 'e' or t == 'E' or t == 'f' or t == 'F' or t == 'g' or t == 'G' or t == 'n' or t == '%') {
        return Err(unknown_code(t, "float"));
    }
    Ok(format_float_spec(x, f))
}

// ------------------------------------------------------------ bytes (for the catalogs)

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn b_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    b_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    b_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if b_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn b_slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (b_slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (b_slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if b_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and b_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

// ------------------------------------------------------------ the .po compiler

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for i in from..to {
        out.push(b[i]);
    }
    out
}

fn has_prefix(b: ref Vec[u8], p: Str) -> bool {
    starts_at(b, 0, p)
}

fn append(a: mut ref Vec[u8], b: ref Vec[u8]) {
    for i in 0..b.len() {
        a.push(b[i]);
    }
}

fn b_contains_seq(b: ref Vec[u8], p: Str) -> bool {
    for i in 0..b.len() {
        if starts_at(b, i, p) {
            return true;
        }
    }
    false
}

fn contains_u8(b: ref Vec[u8], c: u8) -> bool {
    for i in 0..b.len() {
        if b[i] == c {
            return true;
        }
    }
    false
}

fn strip_bytes(b: ref Vec[u8]) -> Vec[u8] {
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    sub(b, i, j)
}

// bytes.decode("latin-1"): one code point per byte.
fn latin1(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        push_code_point(mut out, b[i] as i64);
    }
    from_bytes(out)
}
// ------------------------------------------------------------ plural forms

fn is_word(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c >= 0x80
}

// gettext._tokenize: the tokens, with each invalid one kept so that the
// error is raised only when the parser reaches it, as the generator
// does. The last token is "".
#[derive(Clone)]
struct PTok {
    invalid: bool,
    text: String,
}

fn tokenize(s: Str) -> Vec[PTok] {
    let b = to_bytes(s);
    let mut out: Vec[PTok] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c == b' ' or c == b'\t' {
            i += 1;
            continue;
        }
        if b_digit(c) {
            let mut j = i;
            while j < b.len() and b_digit(b[j]) {
                j += 1;
            }
            if j == b.len() or not is_word(b[j]) {
                out.push(PTok { invalid: false, text: byte_str(b, i, j) });
                i = j;
                continue;
            }
        }
        if c == b'n' and (i + 1 == b.len() or not is_word(b[i + 1])) {
            out.push(PTok { invalid: false, text: "n".to_string() });
            i += 1;
            continue;
        }
        if c == b'(' or c == b')' or c == b'-' or c == b'*' or c == b'/' or c == b'%' or c == b'+' or c == b'?' or c == b':' {
            out.push(PTok { invalid: false, text: byte_str(b, i, i + 1) });
            i += 1;
            continue;
        }
        if c == b'>' or c == b'<' or c == b'!' {
            let n = if i + 1 < b.len() and b[i + 1] == b'=' { 2 } else { 1 };
            out.push(PTok { invalid: false, text: byte_str(b, i, i + n) });
            i += n;
            continue;
        }
        if i + 1 < b.len() and ((c == b'=' and b[i + 1] == b'=') or (c == b'&' and b[i + 1] == b'&') or (c == b'|' and b[i + 1] == b'|')) {
            out.push(PTok { invalid: false, text: byte_str(b, i, i + 2) });
            i += 2;
            continue;
        }
        // \w+ or any one character
        let mut j = i + 1;
        if is_word(c) {
            while j < b.len() and is_word(b[j]) {
                j += 1;
            }
        } else if c >= 0x80 {
            while j < b.len() and b[j] >= 0x80 and b[j] < 0xC0 {
                j += 1;
            }
        }
        out.push(PTok { invalid: true, text: byte_str(b, i, j) });
        i = j;
    }
    out.push(PTok { invalid: false, text: String.new() });
    out
}

const NUM: i64 = 0;
const VAR: i64 = 1;
const NOT: i64 = 2;
const BIN: i64 = 3;
const COND: i64 = 4;

// An expression node; a, b and c index other nodes.
#[derive(Clone)]
struct PNode {
    kind: i64,
    op: String,
    v: i64,
    a: i64,
    b: i64,
    c: i64,
}

struct Plural {
    toks: Vec[PTok],
    at: i64,
    nodes: Vec[PNode],
}

fn binary_priority(t: Str) -> i64 {
    if t == "||" {
        1
    } else if t == "&&" {
        2
    } else if t == "==" or t == "!=" {
        3
    } else if t == "<" or t == ">" or t == "<=" or t == ">=" {
        4
    } else if t == "+" or t == "-" {
        5
    } else if t == "*" or t == "/" or t == "%" {
        6
    } else {
        0
    }
}

fn py_op(t: Str) -> String {
    if t == "||" {
        "or".to_string()
    } else if t == "&&" {
        "and".to_string()
    } else if t == "/" {
        "//".to_string()
    } else {
        t.to_string()
    }
}

fn unexpected(t: Str) -> String {
    if t.len() > 0 { f"unexpected token in plural form: {t}" } else { "unexpected end of plural form".to_string() }
}

impl Plural {
    fn next(mut ref self) -> Result[String, String] {
        let t = self.toks[self.at].clone();
        self.at += 1;
        if t.invalid {
            return Err(f"invalid token in plural form: {t.text}");
        }
        Ok(t.text)
    }

    fn node(mut ref self, kind: i64, op: Str, v: i64, a: i64, b: i64, c: i64) -> i64 {
        self.nodes.push(PNode { kind: kind, op: op.to_string(), v: v, a: a, b: b, c: c });
        self.nodes.len() - 1
    }

    // gettext._parse: the Python text, the node, and the next token.
    fn parse(mut ref self, priority: i64) -> Result[(String, i64, String), String] {
        let mut result = String.new();
        let mut nots: i64 = 0;
        let mut tok = self.next()?;
        while tok == "!" {
            result.push_str("not ");
            nots += 1;
            tok = self.next()?;
        }
        let mut node: i64 = -1;
        if tok == "(" {
            let (sub, sn, close) = self.parse(-1)?;
            result = f"{result}({sub})";
            node = sn;
            if close != ")" {
                return Err("unbalanced parenthesis in plural form".to_string());
            }
        } else if tok == "n" {
            result.push_str("n");
            node = self.node(VAR, "", 0, -1, -1, -1);
        } else {
            let b = to_bytes(tok);
            if b.len() == 0 or not all_digits(b) {
                return Err(unexpected(tok));
            }
            let mut v: i64 = 0;
            for i in 0..b.len() {
                v = v * 10 + (b[i] - b'0') as i64;
            }
            result.push_str(f"{v}");
            node = self.node(NUM, "", v, -1, -1, -1);
        }
        for _ in 0..nots {
            node = self.node(NOT, "", 0, node, -1, -1);
        }
        if starts_with(result, "not ") {
            result = f"({result})";
        }
        tok = self.next()?;
        let mut j: i64 = 100;
        while binary_priority(tok) > 0 {
            let i = binary_priority(tok);
            if i < priority {
                break;
            }
            if (i == 3 or i == 4) and (j == 3 or j == 4) {
                result = f"({result})";
            }
            let (right, rn, after) = self.parse(i + 1)?;
            result = f"{result} {py_op(tok)} {right}";
            node = self.node(BIN, tok, 0, node, rn, -1);
            tok = after;
            j = i;
        }
        if j == priority and priority == 4 {
            result = f"({result})";
        }
        if tok == "?" and priority <= 0 {
            let (yes, yn, colon) = self.parse(0)?;
            if colon != ":" {
                return Err(unexpected(colon));
            }
            let (no, nn, after) = self.parse(-1)?;
            result = f"{yes} if {result} else {no}";
            node = self.node(COND, "", 0, node, yn, nn);
            tok = after;
            if priority == 0 {
                result = f"({result})";
            }
        }
        Ok((result, node, tok))
    }
}

fn all_digits(b: ref Vec[u8]) -> bool {
    for i in 0..b.len() {
        if not b_digit(b[i]) {
            return false;
        }
    }
    true
}

// A compiled Plural-Forms expression: the Python source c2py builds and
// the tree that computes it.
#[derive(Clone)]
struct PluralFn {
    source: String,
    nodes: Vec[PNode],
    root: i64,
}

// gettext.c2py
fn c2py(s: Str) -> Result[PluralFn, String] {
    if code_points(s).len() > 1000 {
        return Err("plural form expression is too long".to_string());
    }
    let mut p = Plural { toks: tokenize(s), at: 0, nodes: Vec.new() };
    let (result, root, tok) = p.parse(-1)?;
    if tok.len() > 0 {
        return Err(unexpected(tok));
    }
    let rb = to_bytes(result);
    let mut depth: i64 = 0;
    for i in 0..rb.len() {
        if rb[i] == b'(' {
            depth += 1;
            if depth > 20 {
                return Err("plural form expression is too complex".to_string());
            }
        } else if rb[i] == b')' {
            depth -= 1;
        }
    }
    Ok(PluralFn { source: result, nodes: p.nodes, root: root })
}

fn germanic() -> PluralFn {
    c2py("n != 1").unwrap_or(PluralFn { source: String.new(), nodes: Vec.new(), root: -1 })
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// The value under Python's rules: // and % round down, `and` and `or`
// give one of their operands, and only the branch taken is evaluated.
fn eval_node(f: ref PluralFn, i: i64, n: i64) -> Result[i64, String] {
    let k = f.nodes[i].clone();
    if k.kind == NUM {
        return Ok(k.v);
    }
    if k.kind == VAR {
        return Ok(n);
    }
    if k.kind == NOT {
        let x = eval_node(f, k.a, n)?;
        return Ok(if x == 0 { 1 } else { 0 });
    }
    if k.kind == COND {
        let c = eval_node(f, k.a, n)?;
        return if c != 0 { eval_node(f, k.b, n) } else { eval_node(f, k.c, n) };
    }
    let x = eval_node(f, k.a, n)?;
    if k.op == "&&" {
        return if x == 0 { Ok(x) } else { eval_node(f, k.b, n) };
    }
    if k.op == "||" {
        return if x != 0 { Ok(x) } else { eval_node(f, k.b, n) };
    }
    let y = eval_node(f, k.b, n)?;
    let r = if k.op == "==" {
        if x == y { 1 } else { 0 }
    } else if k.op == "!=" {
        if x != y { 1 } else { 0 }
    } else if k.op == "<" {
        if x < y { 1 } else { 0 }
    } else if k.op == ">" {
        if x > y { 1 } else { 0 }
    } else if k.op == "<=" {
        if x <= y { 1 } else { 0 }
    } else if k.op == ">=" {
        if x >= y { 1 } else { 0 }
    } else if k.op == "+" {
        x + y
    } else if k.op == "-" {
        x - y
    } else if k.op == "*" {
        x * y
    } else if k.op == "/" {
        if y == 0 {
            return Err("integer division or modulo by zero".to_string());
        }
        floor_div(x, y)
    } else {
        if y == 0 {
            return Err("integer modulo by zero".to_string());
        }
        x - floor_div(x, y) * y
    };
    Ok(r)
}

fn plural_of(f: ref PluralFn, n: i64) -> Result[i64, String] {
    eval_node(f, f.root, n)
}

// ------------------------------------------------------------ GNUTranslations

struct Catalog {
    info_keys: Vec[String],
    info_vals: Vec[String],
    charset: Option[String],
    plural: PluralFn,
    // msgid (with any context) -> msgstr
    single: Map[String, String],
    // "index|msgid" -> msgstr
    plurals: Map[String, String],
    count: i64,
}

fn u32_at(b: ref Vec[u8], at: i64, big: bool) -> Result[i64, String] {
    if at < 0 or at + 4 > b.len() {
        return Err("struct.error: unpack requires a buffer of 4 bytes".to_string());
    }
    let mut x: i64 = 0;
    for k in 0..4 {
        let byte = if big { b[at + k] } else { b[at + 3 - k] };
        x = (x << 8) | (byte as i64);
    }
    Ok(x)
}

// str(bytes, charset)
fn decode(b: ref Vec[u8], charset: Str) -> String {
    let c = lower(charset);
    if c == "iso-8859-1" or c == "latin-1" or c == "latin1" or c == "iso8859-1" {
        return latin1(b);
    }
    from_bytes(b.clone())
}

fn os_error(msg: Str, path: Str) -> String {
    f"OSError: [Errno 0] {msg}: {py_repr(path)}"
}

fn set_info(c: mut ref Catalog, k: Str, v: Str) {
    for i in 0..c.info_keys.len() {
        if c.info_keys[i] == k {
            c.info_vals[i] = v.to_string();
            return;
        }
    }
    c.info_keys.push(k.to_string());
    c.info_vals.push(v.to_string());
}

fn add_info(c: mut ref Catalog, k: Str, more: Str) {
    for i in 0..c.info_keys.len() {
        if c.info_keys[i] == k {
            c.info_vals[i] = f"{c.info_vals[i]}\n{more}";
        }
    }
}

// The metadata entry: "Key: value" lines, continuation lines, and the
// charset and plural rule it sets.
fn parse_header(c: mut ref Catalog, tmsg: ref Vec[u8]) -> Result[(), String] {
    let mut lastk = String.new();
    for line in split_on(from_bytes(tmsg.clone()), b'\n') {
        let item = strip(line);
        if item.len() == 0 {
            continue;
        }
        if starts_with(item, "#-#-#-#-#") and ends_with(item, "#-#-#-#-#") {
            continue;
        }
        if has_byte(item, b':') {
            let (k0, _, v0) = partition(item, b':');
            let k = lower(strip(k0));
            let v = strip(v0);
            set_info(mut c, k, v);
            lastk = k.clone();
            if k == "content-type" {
                let at = find_str(v, "charset=");
                c.charset = Some(slice_from(v, at + 8));
            } else if k == "plural-forms" {
                let parts = split_on(v, b';');
                let at = find_str(parts[1], "plural=");
                c.plural = match c2py(slice_from(parts[1], at + 7)) {
                    Ok(f) => f,
                    Err(e) => return Err(f"ValueError: {e}"),
                };
            }
        } else if lastk.len() > 0 {
            add_info(mut c, lastk, item);
        }
    }
    Ok(())
}

fn ends_with(s: Str, p: Str) -> bool {
    let b = to_bytes(s);
    starts_at(b, b.len() - p.len(), p)
}

fn load_mo(buf: ref Vec[u8], path: Str) -> Result[Catalog, String] {
    let mut c = Catalog {
        info_keys: Vec.new(),
        info_vals: Vec.new(),
        charset: None,
        plural: germanic(),
        single: Map.new(),
        plurals: Map.new(),
        count: 0,
    };
    let buflen = buf.len();
    let magic = u32_at(buf, 0, false)?;
    let big = if magic == 0x950412de {
        false
    } else if magic == 0xde120495 {
        true
    } else {
        return Err(os_error("Bad magic number", path));
    };
    let version = u32_at(buf, 4, big)?;
    let msgcount = u32_at(buf, 8, big)?;
    let mut masteridx = u32_at(buf, 12, big)?;
    let mut transidx = u32_at(buf, 16, big)?;
    let major = version >> 16;
    if major != 0 and major != 1 {
        return Err(os_error(f"Bad version number {major}", path));
    }
    for _ in 0..msgcount {
        let mlen = u32_at(buf, masteridx, big)?;
        let moff = u32_at(buf, masteridx + 4, big)?;
        let tlen = u32_at(buf, transidx, big)?;
        let toff = u32_at(buf, transidx + 4, big)?;
        let mend = moff + mlen;
        let tend = toff + tlen;
        if not (mend < buflen and tend < buflen) {
            return Err(os_error("File is corrupt", path));
        }
        let msg = sub(buf, moff, mend);
        let tmsg = sub(buf, toff, tend);
        if mlen == 0 {
            parse_header(mut c, tmsg)?;
        }
        let charset = c.charset.clone().unwrap_or("ascii".to_string());
        if contains_u8(msg, 0) {
            let mut z: i64 = 0;
            while msg[z] != 0 {
                z += 1;
            }
            let msgid1 = decode(sub(msg, 0, z), charset);
            let mut st: i64 = 0;
            let mut form: i64 = 0;
            for i in 0..tmsg.len() + 1 {
                if i == tmsg.len() or tmsg[i] == 0 {
                    let key = f"{form}|{msgid1}";
                    if not c.plurals.contains_key(key) {
                        c.count += 1;
                    }
                    c.plurals.insert(key, decode(sub(tmsg, st, i), charset));
                    form += 1;
                    st = i + 1;
                }
            }
        } else {
            let key = decode(msg, charset);
            if not c.single.contains_key(key) {
                c.count += 1;
            }
            c.single.insert(key, decode(tmsg, charset));
        }
        masteridx += 8;
        transidx += 8;
    }
    Ok(c)
}

fn get_single(c: ref Catalog, k: Str) -> Option[String] {
    match c.single.get(k) {
        Some(v) => Some(v.clone()),
        None => None,
    }
}

fn get_plural(c: ref Catalog, k: Str, n: i64) -> Option[String] {
    let i = match plural_of(c.plural, n) {
        Ok(i) => i,
        Err(_) => return None,
    };
    match c.plurals.get(f"{i}|{k}") {
        Some(v) => Some(v.clone()),
        None => None,
    }
}

// gettext and pgettext down a chain of catalogs and their fallbacks.
fn lookup(chain: ref Vec[Catalog], at: i64, key: Str, message: Str) -> String {
    if at == chain.len() {
        return message.to_string();
    }
    if let Some(v) = get_single(chain[at], key) {
        return v;
    }
    if let Some(v) = get_plural(chain[at], key, 1) {
        return v;
    }
    lookup(chain, at + 1, key, message)
}

// ngettext and npgettext
fn nlookup(chain: ref Vec[Catalog], at: i64, key: Str, one: Str, many: Str, n: i64) -> String {
    if at == chain.len() {
        return if n == 1 { one.to_string() } else { many.to_string() };
    }
    if let Some(v) = get_plural(chain[at], key, n) {
        return v;
    }
    nlookup(chain, at + 1, key, one, many, n)
}

fn gettext(chain: ref Vec[Catalog], msg: Str) -> String {
    lookup(chain, 0, msg, msg)
}

fn pgettext(chain: ref Vec[Catalog], ctx: Str, msg: Str) -> String {
    lookup(chain, 0, f"{ctx}\u{4}{msg}", msg)
}

fn ngettext(chain: ref Vec[Catalog], one: Str, many: Str, n: i64) -> String {
    nlookup(chain, 0, one, one, many, n)
}

fn npgettext(chain: ref Vec[Catalog], ctx: Str, one: Str, many: Str, n: i64) -> String {
    nlookup(chain, 0, f"{ctx}\u{4}{one}", one, many, n)
}

// ------------------------------------------------------------ the files


// ------------------------------------------------------------ Python values

// What a job argument is in Python. Times are microseconds: a timedelta's
// length, or a datetime counted from 0001-01-01; a date is a day number
// with 1 for 0001-01-01.
#[derive(Clone)]
enum Val {
    Nil,
    Bool(bool),
    Int(i128),
    Float(f64),
    Str(String),
    List(Vec[Val]),
    Td(i128),
    Dt(i128),
    Date(i64),
    Func(String),
}

const DAY_US: i128 = 86400000000;

fn floor_div128(a: i128, b: i128) -> i128 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn py_mod128(a: i128, b: i128) -> i128 {
    a - floor_div128(a, b) * b
}

fn type_name(v: ref Val) -> String {
    match v {
        Val.Nil => "NoneType".to_string(),
        Val.Bool(_) => "bool".to_string(),
        Val.Int(_) => "int".to_string(),
        Val.Float(_) => "float".to_string(),
        Val.Str(_) => "str".to_string(),
        Val.List(_) => "list".to_string(),
        Val.Td(_) => "datetime.timedelta".to_string(),
        Val.Dt(_) => "datetime.datetime".to_string(),
        Val.Date(_) => "datetime.date".to_string(),
        Val.Func(_) => "function".to_string(),
    }
}

// str(v), and repr(v) for the values a job prints.
fn val_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => val_repr(v),
    }
}

fn val_repr(v: ref Val) -> String {
    match v {
        Val.Nil => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(i) => i.to_string(),
        Val.Float(x) => float_repr(x),
        Val.Str(s) => repr_str(s),
        Val.List(items) => {
            let parts: Vec[String] = items.iter().map(|x| val_repr(x)).collect();
            f"[{parts.join(", ")}]"
        }
        Val.Td(us) => f"timedelta({us} us)",
        Val.Dt(us) => f"datetime({us} us)",
        Val.Date(d) => f"date({d})",
        Val.Func(name) => f"<function {name}>",
    }
}

// float(v)
fn py_float_of(v: ref Val) -> Result[f64, String] {
    match v {
        Val.Bool(b) => Ok(if b { 1.0 } else { 0.0 }),
        Val.Int(i) => Ok(i as f64),
        Val.Float(x) => Ok(x),
        Val.Str(s) => match py_float(s) {
            Some(x) => Ok(x),
            None => Err(f"ValueError: could not convert string to float: {repr_str(s)}"),
        },
        _ => Err(f"TypeError: float() argument must be a string or a real number, not '{type_name(v)}'"),
    }
}

// int(x) for a float
fn float_to_int(x: f64) -> Result[i128, String] {
    if x != x {
        return Err("ValueError: cannot convert float NaN to integer".to_string());
    }
    if x == 1.0 / 0.0 or x == -1.0 / 0.0 {
        return Err("OverflowError: cannot convert float infinity to integer".to_string());
    }
    Ok(x as i128)
}

// int(v)
fn py_int_of(v: ref Val) -> Result[i128, String] {
    match v {
        Val.Bool(b) => Ok(if b { 1 } else { 0 }),
        Val.Int(i) => Ok(i),
        Val.Float(x) => float_to_int(x),
        Val.Str(s) => {
            if py_int_ok(s) {
                let cleaned = py_strip(s).replace("_", "");
                match i128.parse(cleaned) {
                    Ok(n) => return Ok(n),
                    Err(_) => {}
                }
            }
            Err(f"ValueError: invalid literal for int() with base 10: {repr_str(s)}")
        }
        _ => Err(f"TypeError: int() argument must be a string, a bytes-like object or a real number, not '{type_name(v)}'"),
    }
}

// The exceptions humanize catches when it tries a conversion.
fn caught(e: ref String) -> bool {
    e.starts_with("ValueError") or e.starts_with("TypeError")
}

fn is_finite(x: f64) -> bool {
    not is_inf_or_nan(x)
}

// _format_not_finite
fn not_finite(x: f64) -> String {
    if x != x {
        "NaN".to_string()
    } else if x < 0.0 {
        "-Inf".to_string()
    } else {
        "+Inf".to_string()
    }
}

// round(x) to an int, halves to even.
fn py_round(x: f64) -> Result[i128, String] {
    float_to_int(x)?;
    let f = x.floor();
    let d = x - f;
    let r = if d > 0.5 {
        f + 1.0
    } else if d < 0.5 {
        f
    } else if (f / 2.0).floor() * 2.0 == f {
        f
    } else {
        f + 1.0
    };
    Ok(r as i128)
}

// round(x, n) for n >= 0: the nearest float to x's correctly rounded
// n-place decimal.
fn round_to(x: f64, n: i64) -> f64 {
    match format_float(x, f".{n}f") {
        Ok(s) => py_float(s).unwrap_or(x),
        Err(_) => x,
    }
}

// divmod(a, b) for floats (float_divmod in Objects/floatobject.c).
fn py_divmod(a: f64, b: f64) -> (f64, f64) {
    let mut m = a % b;
    let mut div = (a - m) / b;
    if m != 0.0 {
        if (b < 0.0) != (m < 0.0) {
            m += b;
            div -= 1.0;
        }
    } else {
        m = if b < 0.0 { -0.0 } else { 0.0 };
    }
    let mut floordiv = 0.0;
    if div != 0.0 {
        floordiv = div.floor();
        if div - floordiv > 0.5 {
            floordiv += 1.0;
        }
    } else {
        floordiv = if a / b < 0.0 { -0.0 } else { 0.0 };
    }
    (floordiv, m)
}

fn pow128(b: i128, e: i64) -> i128 {
    let mut r: i128 = 1;
    for _ in 0..e {
        r = r * b;
    }
    r
}

// a / 10^k for ints, correctly rounded as Python's int division is.
fn div_pow10(a: i128, k: i64) -> f64 {
    let neg = a < 0;
    let mut d = if neg { (0 - a).to_string() } else { a.to_string() };
    while d.len() <= k {
        d = f"0{d}";
    }
    let cut = d.len() - k;
    let lit = f"{d[0..cut]}.{d[cut..d.len()]}";
    let x = f64.parse(lit).unwrap_or(0.0);
    if neg { 0.0 - x } else { x }
}

// x == 10^k, compared exactly as Python compares a float with an int.
fn equals_pow10(x: f64, k: i64) -> bool {
    k <= 22 and x == (pow128(10, k) as f64)
}

// ------------------------------------------------------------ format() and str.format

// v grouped by threes with commas: format(int, ",")
fn group_int(v: i128) -> String {
    let neg = v < 0;
    let d = if neg { (0 - v).to_string() } else { v.to_string() };
    let g = group_digits(d, 0, 3, ',');
    if neg { f"-{g}" } else { g }
}

// format(v, spec)
fn format_val(v: ref Val, spec: ref String) -> Result[String, String] {
    match v {
        Val.Int(i) => {
            if spec.is_empty() {
                Ok(i.to_string())
            } else if spec == "," {
                Ok(group_int(i))
            } else {
                format_int(i as i64, spec)
            }
        }
        Val.Bool(b) => format_bool(b, spec),
        Val.Float(x) => format_float(x, spec),
        Val.Str(s) => {
            if spec.is_empty() {
                Ok(s.clone())
            } else {
                Err(value_error(f"Unknown format code '{spec}' for object of type 'str'"))
            }
        }
        _ => Ok(val_str(v)),
    }
}

// fmt.format(v) for a template with replacement fields "{}", "{0}",
// "{:spec}" or "{0:spec}", and "{{" / "}}".
fn str_format(fmt: ref String, v: ref Val) -> Result[String, String] {
    let c = chars(fmt);
    let mut out = String.new();
    let mut i = 0;
    while i < c.len() {
        if c[i] == '{' and i + 1 < c.len() and c[i + 1] == '{' {
            out.push('{');
            i += 2;
        } else if c[i] == '}' and i + 1 < c.len() and c[i + 1] == '}' {
            out.push('}');
            i += 2;
        } else if c[i] == '{' {
            let mut j = i + 1;
            while j < c.len() and c[j] != '}' {
                j += 1;
            }
            if j >= c.len() {
                return Err(value_error("expected '}' before end of string"));
            }
            let field = text(slice(c, i + 1, j));
            let fc = chars(field);
            let mut k = 0;
            while k < fc.len() and fc[k] != ':' {
                k += 1;
            }
            let name = text(slice(fc, 0, k));
            if name != "" and name != "0" {
                return Err(f"IndexError: Replacement index {name} out of range for positional args tuple");
            }
            let spec = if k < fc.len() { text(slice(fc, k + 1, fc.len())) } else { String.new() };
            out.push_str(format_val(v, spec)?);
            i = j + 1;
        } else if c[i] == '}' {
            return Err(value_error("Single '}' encountered in format string"));
        } else {
            out.push(c[i]);
            i += 1;
        }
    }
    Ok(out)
}

// fmt % args: the conversions d, i, f, F, e, E, g, G, s and r with their
// flags, width and precision.
fn pct(fmt: ref String, args: ref Vec[Val]) -> Result[String, String] {
    let c = chars(fmt);
    let mut out = String.new();
    let mut i = 0;
    let mut used = 0;
    while i < c.len() {
        if c[i] != '%' {
            out.push(c[i]);
            i += 1;
            continue;
        }
        i += 1;
        if i < c.len() and c[i] == '%' {
            out.push('%');
            i += 1;
            continue;
        }
        let mut left = false;
        let mut zero = false;
        let mut sign = String.new();
        let mut alt = false;
        while i < c.len() and (c[i] == '-' or c[i] == '+' or c[i] == ' ' or c[i] == '#' or c[i] == '0') {
            if c[i] == '-' {
                left = true;
            } else if c[i] == '0' {
                zero = true;
            } else if c[i] == '#' {
                alt = true;
            } else if c[i] == '+' or sign.is_empty() {
                sign = c[i].to_string();
            }
            i += 1;
        }
        let mut w = String.new();
        while i < c.len() and is_digit(c[i]) {
            w.push(c[i]);
            i += 1;
        }
        let mut prec = String.new();
        if i < c.len() and c[i] == '.' {
            prec.push('.');
            i += 1;
            while i < c.len() and is_digit(c[i]) {
                prec.push(c[i]);
                i += 1;
            }
            if prec == "." {
                prec.push('0');
            }
        }
        if i >= c.len() {
            return Err(value_error("incomplete format"));
        }
        let t = c[i];
        i += 1;
        if used >= args.len() {
            return Err("TypeError: not enough arguments for format string".to_string());
        }
        let arg = args[used].clone();
        used += 1;
        let align = if left { "<" } else if zero and t != 's' and t != 'r' { "0" } else { "" };
        let hash = if alt { "#" } else { "" };
        let body = if t == 's' or t == 'r' {
            let s = if t == 's' { val_str(arg) } else { val_repr(arg) };
            let shown = if prec.is_empty() {
                s
            } else {
                let n = i64.parse(prec[1..prec.len()]).unwrap_or(0);
                text(slice(chars(s), 0, n))
            };
            let spec = if left { f"<{w}" } else { f">{w}" };
            pad_str(shown, spec)
        } else if t == 'd' or t == 'i' {
            let n = match arg {
                Val.Float(x) => float_to_int(x)?,
                Val.Str(_) => return Err(f"TypeError: %{t} format: a real number is required, not str"),
                Val.Nil => return Err(f"TypeError: %{t} format: a real number is required, not NoneType"),
                _ => py_int_of(arg)?,
            };
            format_val(Val.Int(n), f"{align}{sign}{w}d")?
        } else if t == 'f' or t == 'F' or t == 'e' or t == 'E' or t == 'g' or t == 'G' {
            let x = match arg {
                Val.Str(_) => return Err("TypeError: must be real number, not str".to_string()),
                Val.Nil => return Err("TypeError: must be real number, not NoneType".to_string()),
                _ => py_float_of(arg)?,
            };
            let p = if prec.is_empty() { ".6".to_string() } else { prec.clone() };
            format_float(x, f"{align}{sign}{hash}{w}{p}{t}")?
        } else {
            return Err(value_error(f"unsupported format character '{t}' (0x{(t as i64):x}) at index {i - 1}"));
        };
        out.push_str(body);
    }
    if used < args.len() {
        return Err("TypeError: not all arguments converted during string formatting".to_string());
    }
    Ok(out)
}

fn pad_str(s: ref String, spec: ref String) -> String {
    let w = i64.parse(spec[1..spec.len()]).unwrap_or(0);
    let n = width(s);
    if n >= w {
        return s.clone();
    }
    if spec.starts_with("<") { f"{s}{spaces(w - n)}" } else { f"{spaces(w - n)}{s}" }
}

fn pct1(fmt: ref String, v: ref Val) -> Result[String, String] {
    let mut args: Vec[Val] = Vec.new();
    args.push(v.clone());
    pct(fmt, args)
}

// ------------------------------------------------------------ timedelta and datetime

// timedelta(seconds=x) for a float, as delta_new rounds it: whole
// microseconds exactly, the leftover fraction half to even.
fn td_from_seconds(x: f64) -> i128 {
    let ip = x.trunc();
    let frac = x - ip;
    let mut sum: i128 = (ip as i128) * 1000000;
    if frac == 0.0 {
        return sum;
    }
    let d = 1000000.0 * frac;
    let ip2 = d.trunc();
    let leftover = d - ip2;
    sum += ip2 as i128;
    if leftover != 0.0 {
        // C round(): halves away from zero
        let mut whole = if leftover < 0.0 { 0.0 - (0.0 - leftover + 0.5).floor() } else { (leftover + 0.5).floor() };
        let diff = whole - leftover;
        if diff == 0.5 or diff == -0.5 {
            let odd = if py_mod128(sum, 2) == 1 { 1.0 } else { 0.0 };
            let half = (leftover + odd) * 0.5;
            let r = if half < 0.0 { 0.0 - (0.0 - half + 0.5).floor() } else { (half + 0.5).floor() };
            whole = 2.0 * r - odd;
        }
        sum += whole as i128;
    }
    sum
}

fn td_days(us: i128) -> i128 {
    floor_div128(us, DAY_US)
}

fn td_seconds(us: i128) -> i128 {
    floor_div128(py_mod128(us, DAY_US), 1000000)
}

fn td_micros(us: i128) -> i128 {
    py_mod128(us, 1000000)
}

// _abs_timedelta (and abs())
fn td_abs(us: i128) -> i128 {
    if us < 0 { 0 - us } else { us }
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn month_days(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if is_leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

// date.toordinal()
fn ordinal_of(y: i64, m: i64, d: i64) -> i64 {
    let py = y - 1;
    let mut n = py * 365 + py / 4 - py / 100 + py / 400;
    for k in 1..m {
        n += month_days(y, k);
    }
    n + d
}

// date.fromordinal()
fn date_of(ord: i64) -> (i64, i64, i64) {
    let mut y = (ord - 1) / 366 + 1;
    while ordinal_of(y + 1, 1, 1) <= ord {
        y += 1;
    }
    let mut m = 1;
    while m < 12 and ordinal_of(y, m + 1, 1) <= ord {
        m += 1;
    }
    (y, m, ord - ordinal_of(y, m, 1) + 1)
}

fn month_name(m: i64) -> String {
    let names = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October",
        "November", "December"];
    names[m - 1].to_string()
}

fn weekday_name(wd: i64) -> String {
    let names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    names[wd].to_string()
}

fn pad2(n: i64) -> String {
    if n < 10 { f"0{n}" } else { n.to_string() }
}

// date.strftime(fmt) in the C locale, for %a %A %b %B %d %j %m %y %Y %%.
fn strftime(ord: i64, fmt: ref String) -> String {
    let (y, m, d) = date_of(ord);
    let wd = (ord + 6) % 7;
    let c = chars(fmt);
    let mut out = String.new();
    let mut i = 0;
    while i < c.len() {
        if c[i] == '%' and i + 1 < c.len() {
            let k = c[i + 1];
            if k == 'a' {
                out.push_str(weekday_name(wd)[0..3]);
            } else if k == 'A' {
                out.push_str(weekday_name(wd));
            } else if k == 'b' {
                out.push_str(month_name(m)[0..3]);
            } else if k == 'B' {
                out.push_str(month_name(m));
            } else if k == 'd' {
                out.push_str(pad2(d));
            } else if k == 'm' {
                out.push_str(pad2(m));
            } else if k == 'y' {
                out.push_str(pad2(y % 100));
            } else if k == 'Y' {
                out.push_str(y.to_string());
            } else if k == 'j' {
                let j = ord - ordinal_of(y, 1, 1) + 1;
                out.push_str(if j < 10 { f"00{j}" } else if j < 100 { f"0{j}" } else { j.to_string() });
            } else if k == '%' {
                out.push('%');
            } else {
                out.push('%');
                out.push(k);
            }
            i += 2;
        } else {
            out.push(c[i]);
            i += 1;
        }
    }
    out
}

// date.today(), in UTC.
fn today() -> i64 {
    let ms = SystemTime.now().since_epoch().as_ms();
    ordinal_of(1970, 1, 1) + ms / 86400000
}

// ------------------------------------------------------------ i18n

// humanize's translation state: the active locale name (None for
// English), the translations humanize has made for each name it was
// given (_TRANSLATIONS), and the catalogs gettext has read, by path.
struct H {
    locale: Option[String],
    names: Vec[String],
    chains: Vec[Vec[i64]],
    paths: Vec[String],
    cats: Vec[Catalog],
}

fn chain_of(h: ref H) -> Vec[i64] {
    if let Some(n) = h.locale.clone() {
        for i in 0..h.names.len() {
            if h.names[i] == n {
                return h.chains[i].clone();
            }
        }
    }
    Vec.new()
}

// _gettext and _pgettext: down the chain, the message itself last.
fn tr_key(h: ref H, key: ref String, message: ref String) -> String {
    for i in chain_of(h).iter() {
        let c = ref h.cats[*i];
        if let Some(v) = get_single(c, key) {
            return v;
        }
        if let Some(v) = get_plural(c, key, 1) {
            return v;
        }
    }
    message.clone()
}

fn tr(h: ref H, message: Str) -> String {
    tr_key(h, message.to_string(), message.to_string())
}

fn ptr(h: ref H, ctx: ref String, message: Str) -> String {
    tr_key(h, f"{ctx}\u{4}{message}", message.to_string())
}

// _ngettext
fn ntr(h: ref H, one: Str, many: Str, n: i64) -> String {
    for i in chain_of(h).iter() {
        if let Some(v) = get_plural(h.cats[*i], one, n) {
            return v;
        }
    }
    if n == 1 { one.to_string() } else { many.to_string() }
}

fn thousands_separator(h: ref H) -> String {
    let l = h.locale.clone().unwrap_or(String.new());
    if l == "de_DE" or l == "it_IT" or l == "pt_BR" {
        ".".to_string()
    } else if l == "fr_FR" or l == "hu_HU" or l == "lv" {
        " ".to_string()
    } else {
        ",".to_string()
    }
}

fn decimal_separator(h: ref H) -> String {
    let l = h.locale.clone().unwrap_or(String.new());
    if l == "de_DE" or l == "it_IT" or l == "pt_BR" or l == "hu_HU" or l == "lv" {
        ",".to_string()
    } else {
        ".".to_string()
    }
}

// locale.normalize's alias table, for the names this program meets: the
// language and territory a name stands for.
fn locale_alias(key: ref String) -> Option[String] {
    let table = [
        ("ar", "ar_AA"), ("de", "de_DE"), ("de_at", "de_AT"), ("de_ch", "de_CH"), ("de_de", "de_DE"),
        ("german", "de_DE"), ("es", "es_ES"), ("es_es", "es_ES"), ("fr", "fr_FR"), ("fr_ca", "fr_CA"),
        ("fr_fr", "fr_FR"), ("hu", "hu_HU"), ("hu_hu", "hu_HU"), ("it", "it_IT"), ("it_it", "it_IT"),
        ("ja", "ja_JP"), ("ja_jp", "ja_JP"), ("lv", "lv_LV"), ("lv_lv", "lv_LV"), ("pl", "pl_PL"),
        ("pl_pl", "pl_PL"), ("pt", "pt_PT"), ("pt_br", "pt_BR"), ("pt_pt", "pt_PT"), ("ru", "ru_RU"),
        ("ru_ru", "ru_RU"), ("sk", "sk_SK"), ("sk_sk", "sk_SK"), ("sl", "sl_SI"), ("sl_si", "sl_SI"),
        ("uk", "uk_UA"), ("uk_ua", "uk_UA"), ("zh", "zh_CN"), ("zh_cn", "zh_CN"),
    ];
    for (k, v) in table.iter() {
        if *k == *key {
            return Some(v.to_string());
        }
    }
    None
}

// gettext's _expand_lang after locale.normalize, without the forms that
// carry a codeset (no catalog directory is named with one).
fn expand_locale(name: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if *name == "C" {
        return out;
    }
    let c = chars(name);
    let mut rest = c.clone();
    let mut modifier = String.new();
    let mut at = 0;
    while at < rest.len() and rest[at] != '@' {
        at += 1;
    }
    if at < rest.len() {
        modifier = text(slice(rest, at, rest.len()));
        rest = slice(rest, 0, at);
    }
    let mut dot = 0;
    while dot < rest.len() and rest[dot] != '.' {
        dot += 1;
    }
    rest = slice(rest, 0, dot);
    let mut code = text(rest);
    if let Some(v) = locale_alias(ascii_lower(code)) {
        code = v;
    }
    let cc = chars(code);
    let mut us = 0;
    while us < cc.len() and cc[us] != '_' {
        us += 1;
    }
    let lang = text(slice(cc, 0, us));
    let terr = text(slice(cc, us, cc.len()));
    if not modifier.is_empty() {
        if not terr.is_empty() {
            out.push(f"{lang}{terr}{modifier}");
        }
        out.push(f"{lang}{modifier}");
    }
    if not terr.is_empty() {
        out.push(f"{lang}{terr}");
    }
    out.push(lang);
    out
}

// humanize.activate(locale, path="data/locale")
fn activate(h: mut ref H, name: ref Option[String]) -> Result[(), String] {
    let n = match name {
        None => {
            h.locale = None;
            return Ok(());
        }
        Some(n) => n.clone(),
    };
    if n.starts_with("en") {
        h.locale = None;
        return Ok(());
    }
    for k in h.names.iter() {
        if *k == n {
            h.locale = Some(n);
            return Ok(());
        }
    }
    let mut files: Vec[String] = Vec.new();
    for lang in expand_locale(n) {
        let path = f"data/locale/{lang}/LC_MESSAGES/humanize.mo";
        if fs.exists(path.clone()) and not files.contains(path) {
            files.push(path);
        }
    }
    if files.is_empty() {
        return Err("FileNotFoundError: [Errno 2] No translation file found for domain: 'humanize'".to_string());
    }
    let mut chain: Vec[i64] = Vec.new();
    for path in files.iter() {
        let mut found = -1;
        for i in 0..h.paths.len() {
            if h.paths[i] == *path {
                found = i;
            }
        }
        if found < 0 {
            let buf = match fs.read_bytes(path.clone()) {
                Ok(b) => b,
                Err(e) => return Err(f"OSError: {e}"),
            };
            let cat = load_mo(buf, path.as_str())?;
            h.paths.push(path.clone());
            h.cats.push(cat);
            found = h.cats.len() - 1;
        }
        chain.push(found);
    }
    h.names.push(n.clone());
    h.chains.push(chain);
    h.locale = Some(n);
    Ok(())
}

// ------------------------------------------------------------ numbers

fn ok_str(s: ref String) -> Result[Val, String] {
    Ok(Val.Str(s.clone()))
}

// The str(value) humanize returns when a conversion fails, or the
// exception it lets through.
fn fallback(e: ref String, v: ref Val) -> Result[Val, String] {
    if caught(e) {
        ok_str(val_str(v))
    } else {
        Err(e.clone())
    }
}

fn ordinal_suffix(d: i128) -> Str {
    if d == 1 {
        "st"
    } else if d == 2 {
        "nd"
    } else if d == 3 {
        "rd"
    } else {
        "th"
    }
}

fn ordinal(h: ref H, v: ref Val, gender: ref String) -> Result[Val, String] {
    let x = match py_float_of(v) {
        Ok(x) => x,
        Err(e) => return fallback(e, v),
    };
    if not is_finite(x) {
        return ok_str(not_finite(x));
    }
    let n = match py_int_of(v) {
        Ok(n) => n,
        Err(e) => return fallback(e, v),
    };
    let g = if *gender == "male" { "male" } else { "female" };
    let m = py_mod128(n, 100);
    let digit = if m == 11 or m == 12 or m == 13 { 0 } else { py_mod128(n, 10) };
    ok_str(f"{n}{ptr(h, f"{digit} ({g})", ordinal_suffix(digit))}")
}

fn intcomma(h: ref H, v: ref Val, ndigits: ref Val) -> Result[Val, String] {
    let ts = thousands_separator(h);
    let ds = decimal_separator(h);
    let mut value = v.clone();
    if let Val.Str(s) = v {
        let s2 = s.replace(ts.as_str(), "").replace(ds.as_str(), ".");
        value = Val.Str(s2.clone());
        let x = match py_float_of(value) {
            Ok(x) => x,
            Err(e) => return fallback(e, value),
        };
        if not is_finite(x) {
            return ok_str(not_finite(x));
        }
        if s2.contains(".") {
            value = Val.Float(x);
        } else {
            value = match py_int_of(value) {
                Ok(n) => Val.Int(n),
                Err(e) => return fallback(e, value),
            };
        }
    } else {
        let x = match py_float_of(v) {
            Ok(x) => x,
            Err(e) => return fallback(e, v),
        };
        if not is_finite(x) {
            return ok_str(not_finite(x));
        }
    }
    let spec = match ndigits {
        Val.Nil => ",".to_string(),
        Val.Int(n) => f",.{n}f",
        _ => return Err("TypeError: ndigits must be an int".to_string()),
    };
    let result = format_val(value, spec)?;
    if ts != "," or ds != "." {
        let mut out = String.new();
        for c in result.chars() {
            if c == ',' {
                out.push_str(ts);
            } else if c == '.' {
                out.push_str(ds);
            } else {
                out.push(c);
            }
        }
        return ok_str(out);
    }
    ok_str(result)
}

fn power_names(i: i64) -> (String, String) {
    let names = [
        ("thousand", "thousand"), ("million", "million"), ("billion", "billion"), ("trillion", "trillion"),
        ("quadrillion", "quadrillion"), ("quintillion", "quintillion"), ("sextillion", "sextillion"),
        ("septillion", "septillion"), ("octillion", "octillion"), ("nonillion", "nonillion"),
        ("decillion", "decillion"), ("googol", "googol"),
    ];
    names[i].clone()
}

// powers[i]: 10^(3i + 3) up to decillion, then a googol. Ints here stay
// below 2^127, so they never reach a googol.
fn power_exp(i: i64) -> i64 {
    if i == 11 { 100 } else { 3 * i + 3 }
}

fn intword(h: ref H, v: ref Val, format: ref String) -> Result[Val, String] {
    let x = match py_float_of(v) {
        Ok(x) => x,
        Err(e) => return fallback(e, v),
    };
    if not is_finite(x) {
        return ok_str(not_finite(x));
    }
    let mut n = match py_int_of(v) {
        Ok(n) => n,
        Err(e) => return fallback(e, v),
    };
    let mut prefix = "";
    if n < 0 {
        n = 0 - n;
        prefix = "-";
    }
    if n < 1000 {
        return ok_str(f"{prefix}{n}");
    }
    // bisect.bisect_right(powers, n)
    let mut ord = 0;
    while ord < 11 and pow128(10, power_exp(ord)) <= n {
        ord += 1;
    }
    let largest = ord == 12;
    ord -= 1;
    let chopped = div_pow10(n, power_exp(ord));
    let mut rounded = match py_float(pct1(format, Val.Float(chopped))?) {
        Some(r) => r,
        None => return Err(f"ValueError: could not convert string to float: {repr_str(pct1(format, Val.Float(chopped))?)}"),
    };
    let power = pow128(10, power_exp(ord)) as f64;
    if not largest and ord + 1 < 11 and equals_pow10(rounded * power, power_exp(ord + 1)) {
        ord += 1;
        rounded = 1.0;
    }
    let (one, many) = power_names(ord);
    let unit = ntr(h, one.as_str(), many.as_str(), rounded.ceil() as i64);
    let number = pct1(format, Val.Float(rounded))?.replace(".", decimal_separator(h).as_str());
    ok_str(f"{prefix}{number} {unit}")
}

fn apnumber(h: ref H, v: ref Val) -> Result[Val, String] {
    let x = match py_float_of(v) {
        Ok(x) => x,
        Err(e) => return fallback(e, v),
    };
    if not is_finite(x) {
        return ok_str(not_finite(x));
    }
    let n = match py_int_of(v) {
        Ok(n) => n,
        Err(e) => return fallback(e, v),
    };
    if n < 0 or n >= 10 {
        return ok_str(n.to_string());
    }
    let words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"];
    ok_str(tr(h, words[n as i64]))
}

fn gcd128(a: i128, b: i128) -> i128 {
    let mut x = if a < 0 { 0 - a } else { a };
    let mut y = if b < 0 { 0 - b } else { b };
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    x
}

// Fraction(x) for a finite float: its exact value in lowest terms.
fn fraction_of(x: f64) -> (i128, i128) {
    if x == 0.0 {
        return (0, 1);
    }
    let bits = x.to_bits() as i64;
    let e = (bits >> 52) & 0x7FF;
    let mut mant = (bits & 0xFFFFFFFFFFFFF) as i128;
    let mut e2 = 0;
    if e == 0 {
        e2 = -1074;
    } else {
        mant = mant | 0x10000000000000;
        e2 = e - 1075;
    }
    let neg = bits < 0;
    let mut num = mant;
    let mut den: i128 = 1;
    if e2 >= 0 {
        num = num * pow128(2, e2);
    } else {
        den = pow128(2, 0 - e2);
    }
    let g = gcd128(num, den);
    num = num / g;
    den = den / g;
    (if neg { 0 - num } else { num }, den)
}

// Fraction.limit_denominator
fn limit_denominator(num: i128, den: i128, max: i128) -> (i128, i128) {
    if den <= max {
        return (num, den);
    }
    let mut p0: i128 = 0;
    let mut q0: i128 = 1;
    let mut p1: i128 = 1;
    let mut q1: i128 = 0;
    let mut n = num;
    let mut d = den;
    loop {
        let a = floor_div128(n, d);
        let q2 = q0 + a * q1;
        if q2 > max {
            break;
        }
        let np1 = p0 + a * p1;
        p0 = p1;
        q0 = q1;
        p1 = np1;
        q1 = q2;
        let nd = n - a * d;
        n = d;
        d = nd;
    }
    let k = floor_div128(max - q0, q1);
    if 2 * d * (q0 + k * q1) <= den {
        (p1, q1)
    } else {
        (p0 + k * p1, q0 + k * q1)
    }
}

fn fractional(v: ref Val) -> Result[Val, String] {
    let number = match py_float_of(v) {
        Ok(x) => x,
        Err(e) => return fallback(e, v),
    };
    if not is_finite(number) {
        return ok_str(not_finite(number));
    }
    let whole = number as i128;
    let (fnum, fden) = fraction_of(number - (whole as f64));
    let (num, den) = limit_denominator(fnum, fden, 1000);
    if whole != 0 and num == 0 and den == 1 {
        return ok_str(whole.to_string());
    }
    if whole == 0 {
        return ok_str(f"{num}/{den}");
    }
    let a = if num < 0 { 0 - num } else { num };
    ok_str(f"{whole} {a}/{den}")
}

fn superscript(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        let sup = if c == '0' {
            '⁰'
        } else if c == '1' {
            '¹'
        } else if c == '2' {
            '²'
        } else if c == '3' {
            '³'
        } else if c == '4' {
            '⁴'
        } else if c == '5' {
            '⁵'
        } else if c == '6' {
            '⁶'
        } else if c == '7' {
            '⁷'
        } else if c == '8' {
            '⁸'
        } else if c == '9' {
            '⁹'
        } else if c == '-' {
            '⁻'
        } else {
            c
        };
        out.push(sup);
    }
    out
}

fn scientific(v: ref Val, precision: ref Val) -> Result[Val, String] {
    let x = match py_float_of(v) {
        Ok(x) => x,
        Err(e) => return fallback(e, v),
    };
    if not is_finite(x) {
        return ok_str(not_finite(x));
    }
    let p = py_int_of(precision)?;
    let n = format_float(x, f".{p}e")?;
    let parts: Vec[String] = n.split("e").map(|s| s.to_string()).collect();
    let e = i64.parse(parts[1].replace("+", "")).unwrap_or(0);
    ok_str(f"{parts[0]} x 10{superscript(e.to_string())}")
}

fn num_of(v: ref Val) -> f64 {
    py_float_of(v).unwrap_or(0.0)
}

fn clamp(h: ref H, v: ref Val, format: ref Val, floor: ref Val, ceil: ref Val, floor_token: ref String,
         ceil_token: ref String) -> Result[Val, String] {
    if let Val.Nil = v {
        return Ok(Val.Nil);
    }
    let x = py_float_of(v)?;
    if not is_finite(x) {
        return ok_str(not_finite(x));
    }
    let mut value = v.clone();
    let mut token = String.new();
    let has_floor = match floor {
        Val.Nil => false,
        _ => true,
    };
    let has_ceil = match ceil {
        Val.Nil => false,
        _ => true,
    };
    if has_floor and x < num_of(floor) {
        value = floor.clone();
        token = floor_token.clone();
    } else if has_ceil and x > num_of(ceil) {
        value = ceil.clone();
        token = ceil_token.clone();
    }
    match format {
        Val.Str(f) => ok_str(f"{token}{str_format(f, value)?}"),
        Val.Func(name) => {
            let r = if name == "intword" {
                intword(h, value, "%.1f".to_string())?
            } else {
                naturalsize(h, value, false, false, "%.1f".to_string())?
            };
            ok_str(f"{token}{val_str(r)}")
        }
        _ => Err("ValueError: Invalid format. Must be either a valid formatting string, or a function that accepts value and returns a string.".to_string()),
    }
}

fn metric(v: ref Val, unit: ref String, precision: i64) -> Result[Val, String] {
    let mut value = py_float_of(v)?;
    if not is_finite(value) {
        return ok_str(not_finite(value));
    }
    let mut exponent: i64 = if value != 0.0 { (value.abs().log10()).floor() as i64 } else { 0 };
    if exponent >= 33 or exponent < -30 {
        let s = scientific(v, Val.Int((precision - 1) as i128))?;
        return ok_str(f"{val_str(s)}{unit}");
    }
    let old_bucket = floor_div128(exponent as i128, 3) as i64 * 3;
    value = if old_bucket >= 0 {
        value / (pow128(10, old_bucket) as f64)
    } else {
        value / (10.0).pow(old_bucket as f64)
    };
    let mut digits = precision - (py_mod128(exponent as i128, 3) as i64) - 1;
    if digits < 0 {
        digits = 0;
    }
    if exponent < 30 and round_to(value.abs(), digits) >= 1000.0 {
        exponent += 3 - (py_mod128(exponent as i128, 3) as i64);
        let new_bucket = floor_div128(exponent as i128, 3) as i64 * 3;
        value = value / (pow128(10, new_bucket - old_bucket) as f64);
        digits = precision - (py_mod128(exponent as i128, 3) as i64) - 1;
        if digits < 0 {
            digits = 0;
        }
    }
    let prefix = if exponent >= 3 {
        chars("kMGTPEZYRQ")[exponent / 3 - 1].to_string()
    } else if exponent < 0 {
        chars("mμnpfazyrq")[(0 - exponent - 1) / 3].to_string()
    } else {
        String.new()
    };
    let shown = format_float(value, f".{digits}f")?;
    let space = if (unit.is_empty() and prefix.is_empty()) or *unit == "°" or *unit == "′" or *unit == "″" {
        ""
    } else {
        " "
    };
    ok_str(f"{shown}{space}{prefix}{unit}")
}

fn natural_list(v: ref Val) -> Result[Val, String] {
    let items = match v {
        Val.List(items) => items.clone(),
        _ => return Err("TypeError: natural_list() needs a list".to_string()),
    };
    let strs: Vec[String] = items.iter().map(|x| val_str(x)).collect();
    if strs.is_empty() {
        return ok_str(String.new());
    }
    if strs.len() == 1 {
        return ok_str(strs[0]);
    }
    if strs.len() == 2 {
        return ok_str(f"{strs[0]} and {strs[1]}");
    }
    let head: Vec[String] = strs[0..strs.len() - 1].to_vec();
    ok_str(f"{head.join(", ")} and {strs[strs.len() - 1]}")
}

// ------------------------------------------------------------ file sizes

fn size_suffix(binary: bool, gnu: bool, i: i64) -> String {
    let decimal = ["kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB", "RB", "QB"];
    let bin = ["KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB", "RiB", "QiB"];
    if gnu {
        chars("KMGTPEZYRQ")[i].to_string()
    } else if binary {
        bin[i].to_string()
    } else {
        decimal[i].to_string()
    }
}

fn naturalsize(h: ref H, v: ref Val, binary: bool, gnu: bool, format: ref String) -> Result[Val, String] {
    let base: i128 = if gnu or binary { 1024 } else { 1000 };
    let bytes = py_float_of(v)?;
    let abs_bytes = bytes.abs();
    if abs_bytes == 1.0 and not gnu {
        return ok_str(pct1(tr(h, "%d Byte"), Val.Int(float_to_int(bytes)?))?);
    }
    if abs_bytes < (base as f64) {
        let n = float_to_int(bytes)?;
        if gnu {
            return ok_str(f"{n}B");
        }
        return ok_str(pct1(tr(h, "%d Bytes"), Val.Int(n))?);
    }
    let l = abs_bytes.ln() / (base as f64).ln();
    let mut exp: i64 = if l < 10.0 { l as i64 } else { 10 };
    if exp < 10 {
        let m = abs_bytes / (pow128(base, exp) as f64);
        let r = pct1(format, Val.Float(m))?;
        if py_float(r).unwrap_or(0.0).abs() >= (base as f64) {
            exp += 1;
        }
    }
    let space = if gnu { "" } else { " " };
    let shown = pct1(format, Val.Float(bytes / (pow128(base, exp) as f64)))?;
    let suffix = size_suffix(binary, gnu, exp - 1);
    ok_str(f"{shown}{space}{tr(h, suffix.as_str())}")
}

// ------------------------------------------------------------ time

const MICROSECONDS: i64 = 0;
const MILLISECONDS: i64 = 1;
const SECONDS: i64 = 2;
const MINUTES: i64 = 3;
const HOURS: i64 = 4;
const DAYS: i64 = 5;
const MONTHS_U: i64 = 6;
const YEARS: i64 = 7;

// Unit[name.upper()]
fn unit_of(name: ref String) -> Result[i64, String] {
    let u = name.to_uppercase();
    let names = ["MICROSECONDS", "MILLISECONDS", "SECONDS", "MINUTES", "HOURS", "DAYS", "MONTHS", "YEARS"];
    for i in 0..8 {
        if u == names[i] {
            return Ok(i);
        }
    }
    Err(f"KeyError: {repr_str(u)}")
}

// timedelta(seconds=v) for a number.
fn td_of(v: ref Val) -> Result[i128, String] {
    match v {
        Val.Int(i) => Ok(i * 1000000),
        Val.Bool(b) => Ok(if b { 1000000 } else { 0 }),
        Val.Float(x) => Ok(td_from_seconds(x)),
        _ => Err(f"TypeError: unsupported type for timedelta seconds component: {type_name(v)}"),
    }
}

fn naturaldelta(h: ref H, v: ref Val, months: bool, minimum_unit: ref String) -> Result[Val, String] {
    let min_unit = unit_of(minimum_unit)?;
    if min_unit != SECONDS and min_unit != MILLISECONDS and min_unit != MICROSECONDS {
        return Err(f"ValueError: Minimum unit '{minimum_unit}' not supported");
    }
    let us = match v {
        Val.Td(t) => t,
        _ => {
            if let Err(e) = py_int_of(v) {
                return fallback(e, v);
            }
            let x = match py_float_of(v) {
                Ok(x) => x,
                Err(e) => return fallback(e, v),
            };
            td_from_seconds(x)
        }
    };
    let delta = td_abs(us);
    let all_days = td_days(delta);
    let seconds = td_seconds(delta) as i64;
    let micro = td_micros(delta) as i64;
    let mut years = (all_days / 365) as i64;
    let days = (all_days % 365) as i64;
    let num_months = py_round((days as f64) / 30.5)? as i64;
    if years == 0 and days < 1 {
        if seconds == 0 {
            if min_unit == MICROSECONDS and micro < 1000 {
                return ok_str(pct1(ntr(h, "%d microsecond", "%d microseconds", micro), Val.Int(micro as i128))?);
            }
            if min_unit == MILLISECONDS or (min_unit == MICROSECONDS and micro >= 1000 and micro < 1000000) {
                let ms = (micro as f64) / 1000.0;
                return ok_str(pct1(ntr(h, "%d millisecond", "%d milliseconds", ms as i64), Val.Float(ms))?);
            }
            return ok_str(tr(h, "a moment"));
        }
        if seconds == 1 {
            return ok_str(tr(h, "a second"));
        }
        if seconds < 60 {
            return ok_str(pct1(ntr(h, "%d second", "%d seconds", seconds), Val.Int(seconds as i128))?);
        }
        if seconds < 3600 {
            let minutes = py_round((seconds as f64) / 60.0)? as i64;
            if minutes == 1 {
                return ok_str(tr(h, "a minute"));
            }
            if minutes == 60 {
                return ok_str(tr(h, "an hour"));
            }
            return ok_str(pct1(ntr(h, "%d minute", "%d minutes", minutes), Val.Int(minutes as i128))?);
        }
        let hours = py_round((seconds as f64) / 3600.0)? as i64;
        if hours == 1 {
            return ok_str(tr(h, "an hour"));
        }
        if hours == 24 {
            return ok_str(tr(h, "a day"));
        }
        return ok_str(pct1(ntr(h, "%d hour", "%d hours", hours), Val.Int(hours as i128))?);
    } else if years == 0 {
        if days == 1 {
            return ok_str(tr(h, "a day"));
        }
        if not months or num_months == 0 {
            return ok_str(pct1(ntr(h, "%d day", "%d days", days), Val.Int(days as i128))?);
        }
        if num_months == 1 {
            return ok_str(tr(h, "a month"));
        }
        if num_months == 12 {
            return ok_str(tr(h, "a year"));
        }
        return ok_str(pct1(ntr(h, "%d month", "%d months", num_months), Val.Int(num_months as i128))?);
    } else if years == 1 {
        if num_months == 0 and days == 0 {
            return ok_str(tr(h, "a year"));
        }
        if num_months == 0 {
            return ok_str(pct1(ntr(h, "1 year, %d day", "1 year, %d days", days), Val.Int(days as i128))?);
        }
        if months {
            if num_months == 1 {
                return ok_str(tr(h, "1 year, 1 month"));
            }
            if num_months == 12 {
                years += 1;
                return ok_str(pct1(ntr(h, "%d year", "%d years", years), Val.Int(years as i128))?);
            }
            return ok_str(pct1(ntr(h, "1 year, %d month", "1 year, %d months", num_months), Val.Int(num_months as i128))?);
        }
        return ok_str(pct1(ntr(h, "1 year, %d day", "1 year, %d days", days), Val.Int(days as i128))?);
    }
    let fmt = ntr(h, "%d year", "%d years", years).replace("%d", "%s");
    let n = val_str(intcomma(h, Val.Int(years as i128), Val.Nil)?);
    ok_str(pct1(fmt, Val.Str(n))?)
}

// _date_and_delta: Some(the date's offset from now, abs(delta)), or None
// when value is not a time. `now` is the job's `when`, or 0 for a value
// that never needs the actual time.
fn date_and_delta(v: ref Val, now: i128, precise: bool) -> Result[Option[(i128, i128)], String] {
    let delta = match v {
        Val.Dt(d) => now - d,
        Val.Td(t) => t,
        _ => {
            let n = if precise {
                v.clone()
            } else {
                match v {
                    Val.Float(x) => match py_round(x) {
                        Ok(i) => Val.Int(i),
                        Err(e) => {
                            if caught(e) {
                                return Ok(None);
                            }
                            return Err(e);
                        }
                    },
                    Val.Int(_) => v.clone(),
                    Val.Bool(b) => Val.Int(if b { 1 } else { 0 }),
                    _ => return Ok(None),
                }
            };
            match td_of(n) {
                Ok(t) => t,
                Err(_) => return Ok(None),
            }
        }
    };
    Ok(Some((now - delta, td_abs(delta))))
}

fn naturaltime(h: ref H, v: ref Val, future: bool, months: bool, minimum_unit: ref String, when: ref Val)
        -> Result[Val, String] {
    let now = match when {
        Val.Dt(d) => d,
        _ => 0,
    };
    let (date, delta) = match date_and_delta(v, now, false)? {
        Some(p) => p,
        None => return ok_str(val_str(v)),
    };
    let mut fut = future;
    match v {
        Val.Dt(_) => fut = date > now,
        Val.Td(_) => fut = date > now,
        _ => {}
    }
    let ago = if fut { tr(h, "%s from now") } else { tr(h, "%s ago") };
    let d = val_str(naturaldelta(h, Val.Td(delta), months, minimum_unit)?);
    if d == tr(h, "a moment") {
        return ok_str(tr(h, "now"));
    }
    ok_str(pct1(ago, Val.Str(d))?)
}

// _rounding_by_fmt
fn rounding_by_fmt(format: ref String, x: f64) -> Result[f64, String] {
    let r = pct1(format, Val.Float(x))?;
    if py_int_ok(r) {
        return Ok(py_float(r).unwrap_or(0.0));
    }
    match py_float(r) {
        Some(y) => Ok(y),
        None => Err(f"ValueError: could not convert string to float: {repr_str(r)}"),
    }
}

// _quotient_and_remainder
fn quot_rem(value: f64, divisor: f64, unit: i64, min_unit: i64, suppress: ref Vec[bool], format: ref String)
        -> Result[(f64, f64), String] {
    if unit == min_unit {
        return Ok((rounding_by_fmt(format, value / divisor)?, 0.0));
    }
    if suppress[unit] {
        return Ok((0.0, value));
    }
    let (q, r) = py_divmod(value, divisor);
    Ok((q, r.trunc()))
}

fn fract(x: f64) -> f64 {
    x - x.trunc()
}

fn precisedelta(h: ref H, v: ref Val, minimum_unit: ref String, suppress: ref Vec[String], format: ref String)
        -> Result[Val, String] {
    let (_, delta) = match date_and_delta(v, 0, true)? {
        Some(p) => p,
        None => return ok_str(val_str(v)),
    };
    let mut sup: Vec[bool] = Vec.new();
    for _ in 0..8 {
        sup.push(false);
    }
    for s in suppress.iter() {
        sup[unit_of(s)?] = true;
    }
    let mut min_unit = unit_of(minimum_unit)?;
    if sup[min_unit] {
        let mut found = -1;
        for u in 0..8 {
            if found < 0 and u > min_unit and not sup[u] {
                found = u;
            }
        }
        if found < 0 {
            return Err("ValueError: Minimum unit is suppressed and no suitable replacement was found".to_string());
        }
        min_unit = found;
    }
    for u in 0..min_unit {
        sup[u] = true;
    }
    let mut days = td_days(delta) as f64;
    let mut secs = td_seconds(delta) as f64;
    let mut usecs = td_micros(delta) as f64;
    let mut (years, d1) = quot_rem(days, 365.0, YEARS, min_unit, sup, format)?;
    days = d1;
    let mut (months, d2) = quot_rem(days, 30.5, MONTHS_U, min_unit, sup, format)?;
    days = d2;
    secs = days * 24.0 * 3600.0 + secs;
    let (d3, s1) = quot_rem(secs, 86400.0, DAYS, min_unit, sup, format)?;
    days = d3;
    secs = s1;
    let mut (hours, s2) = quot_rem(secs, 3600.0, HOURS, min_unit, sup, format)?;
    secs = s2;
    let mut (minutes, s3) = quot_rem(secs, 60.0, MINUTES, min_unit, sup, format)?;
    secs = s3;
    usecs = secs * 1000000.0 + usecs;
    let (s4, u1) = quot_rem(usecs, 1000000.0, SECONDS, min_unit, sup, format)?;
    secs = s4;
    usecs = u1;
    let mut (msecs, u2) = quot_rem(usecs, 1000.0, MILLISECONDS, min_unit, sup, format)?;
    usecs = u2;
    if msecs >= 1000.0 and not sup[SECONDS] {
        msecs -= 1000.0;
        secs += 1.0;
    }
    if secs >= 60.0 and not sup[MINUTES] {
        secs -= 60.0;
        minutes += 1.0;
    }
    if minutes >= 60.0 and not sup[HOURS] {
        minutes -= 60.0;
        hours += 1.0;
    }
    if hours >= 24.0 and not sup[DAYS] {
        hours -= 24.0;
        days += 1.0;
    }
    if days >= 31.0 and not sup[MONTHS_U] {
        days -= 31.0;
        months += 1.0;
    }
    if months >= 12.0 and not sup[YEARS] {
        months -= 12.0;
        years += 1.0;
    }
    let fmts = [
        ("%d year", "%d years", years), ("%d month", "%d months", months), ("%d day", "%d days", days),
        ("%d hour", "%d hours", hours), ("%d minute", "%d minutes", minutes), ("%d second", "%d seconds", secs),
        ("%d millisecond", "%d milliseconds", msecs), ("%d microsecond", "%d microseconds", usecs),
    ];
    let mut texts: Vec[String] = Vec.new();
    for k in 0..8 {
        let unit = YEARS - k;
        let (one, many, value) = fmts[k].clone();
        if value > 0.0 or (texts.is_empty() and unit == min_unit) {
            let n = if value > 1.0 and value < 2.0 { 2 } else { value as i64 };
            let fmt_txt = ntr(h, one.as_str(), many.as_str(), n);
            if unit == min_unit and fract(value) > 0.0 {
                texts.push(pct1(fmt_txt.replace("%d", format.as_str()), Val.Float(value))?);
            } else if unit == YEARS {
                let shown = if fract(value) == 0.0 {
                    intcomma(h, Val.Int(value as i128), Val.Nil)?
                } else {
                    intcomma(h, Val.Float(value), Val.Nil)?
                };
                texts.push(pct1(fmt_txt.replace("%d", "%s"), shown)?);
                continue;
            } else {
                texts.push(pct1(fmt_txt, Val.Float(value))?);
            }
        }
        if unit == min_unit {
            break;
        }
    }
    if texts.len() == 1 {
        return ok_str(texts[0]);
    }
    let head: Vec[String] = texts[0..texts.len() - 1].to_vec();
    let mut args: Vec[Val] = Vec.new();
    args.push(Val.Str(head.join(", ")));
    args.push(Val.Str(texts[texts.len() - 1].clone()));
    ok_str(pct(tr(h, "%s and %s"), args)?)
}

fn day_of(v: ref Val) -> Option[i64] {
    match v {
        Val.Date(d) => Some(d),
        Val.Dt(us) => Some((floor_div128(us, DAY_US) as i64) + 1),
        _ => None,
    }
}

fn naturalday(h: ref H, v: ref Val, format: ref String) -> Result[Val, String] {
    let d = match day_of(v) {
        Some(d) => d,
        None => return ok_str(val_str(v)),
    };
    let delta = d - today();
    if delta == 0 {
        return ok_str(tr(h, "today"));
    }
    if delta == 1 {
        return ok_str(tr(h, "tomorrow"));
    }
    if delta == -1 {
        return ok_str(tr(h, "yesterday"));
    }
    ok_str(strftime(d, format))
}

fn naturaldate(h: ref H, v: ref Val) -> Result[Val, String] {
    let d = match day_of(v) {
        Some(d) => d,
        None => return ok_str(val_str(v)),
    };
    let delta = d - today();
    let a = if delta < 0 { 0 - delta } else { delta };
    if (a as f64) >= 5.0 * 365.0 / 12.0 {
        return naturalday(h, v, "%b %d %Y".to_string());
    }
    naturalday(h, v, "%b %d".to_string())
}

// ------------------------------------------------------------ jobs

fn jint(j: ref JValue, i: i64) -> i128 {
    if let JValue.List(items) = j {
        if i < items.len() {
            if let JValue.Int(n) = items[i] {
                return n as i128;
            }
        }
    }
    0
}

fn val_of(j: ref JValue) -> Val {
    match j {
        JValue.Null => Val.Nil,
        JValue.Bool(b) => Val.Bool(b),
        JValue.Int(i) => Val.Int(i as i128),
        JValue.Float(x) => Val.Float(x),
        JValue.Str(s) => Val.Str(s.clone()),
        JValue.List(items) => Val.List(items.iter().map(|x| val_of(x)).collect()),
        JValue.Obj(_) => {
            if let Some(t) = get(j, "td") {
                return Val.Td(((jint(t, 0) * 86400 + jint(t, 1)) * 1000000) + jint(t, 2));
            }
            if let Some(t) = get(j, "dt") {
                let day = ordinal_of(jint(t, 0) as i64, jint(t, 1) as i64, jint(t, 2) as i64) as i128 - 1;
                let secs = day * 86400 + jint(t, 3) * 3600 + jint(t, 4) * 60 + jint(t, 5);
                return Val.Dt(secs * 1000000 + jint(t, 6));
            }
            if let Some(t) = get(j, "date") {
                return Val.Date(ordinal_of(jint(t, 0) as i64, jint(t, 1) as i64, jint(t, 2) as i64));
            }
            if let Some(JValue.Str(s)) = get(j, "big") {
                return Val.Int(i128.parse(s).unwrap_or(0));
            }
            if let Some(JValue.Str(s)) = get(j, "float") {
                return Val.Float(py_float(s).unwrap_or(0.0));
            }
            if let Some(JValue.Str(s)) = get(j, "fn") {
                return Val.Func(s);
            }
            Val.Nil
        }
    }
}

// A call's arguments: positional, then by keyword.
struct CallArgs {
    pos: Vec[Val],
    kw: Vec[(String, Val)],
}

impl CallArgs {
    fn at(ref self, i: i64, name: Str, default: own Val) -> Val {
        if i >= 0 and i < self.pos.len() {
            return self.pos[i].clone();
        }
        for (k, v) in self.kw.iter() {
            if k == name {
                return v.clone();
            }
        }
        default
    }

    fn string(ref self, i: i64, name: Str, default: Str) -> String {
        match self.at(i, name, Val.Str(default.to_string())) {
            Val.Str(s) => s,
            other => val_str(other),
        }
    }

    fn flag(ref self, i: i64, name: Str, default: bool) -> bool {
        match self.at(i, name, Val.Bool(default)) {
            Val.Bool(b) => b,
            Val.Int(n) => n != 0,
            _ => default,
        }
    }

    fn strings(ref self, i: i64, name: Str) -> Vec[String] {
        match self.at(i, name, Val.List(Vec.new())) {
            Val.List(items) => items.iter().map(|x| val_str(x)).collect(),
            _ => Vec.new(),
        }
    }
}

fn args_of(j: ref JValue) -> CallArgs {
    let mut a = CallArgs { pos: Vec.new(), kw: Vec.new() };
    if let Some(JValue.List(items)) = get(j, "args") {
        for it in items.iter() {
            a.pos.push(val_of(it));
        }
    }
    if let Some(JValue.Obj(items)) = get(j, "kw") {
        for (k, v) in items.iter() {
            a.kw.push((k.clone(), val_of(v)));
        }
    }
    a
}

fn call(h: ref H, f: ref String, a: ref CallArgs) -> Result[Val, String] {
    let v = a.at(0, "value", Val.Nil);
    if f == "ordinal" {
        ordinal(h, v, a.string(1, "gender", "male"))
    } else if f == "intcomma" {
        intcomma(h, v, a.at(1, "ndigits", Val.Nil))
    } else if f == "intword" {
        intword(h, v, a.string(1, "format", "%.1f"))
    } else if f == "apnumber" {
        apnumber(h, v)
    } else if f == "fractional" {
        fractional(v)
    } else if f == "scientific" {
        scientific(v, a.at(1, "precision", Val.Int(2)))
    } else if f == "clamp" {
        clamp(h, v, a.at(1, "format", Val.Str("{:}".to_string())), a.at(2, "floor", Val.Nil),
            a.at(3, "ceil", Val.Nil), a.string(4, "floor_token", "<"), a.string(5, "ceil_token", ">"))
    } else if f == "metric" {
        let p = match a.at(2, "precision", Val.Int(3)) {
            Val.Int(n) => n as i64,
            _ => 3,
        };
        metric(v, a.string(1, "unit", ""), p)
    } else if f == "natural_list" {
        natural_list(v)
    } else if f == "naturalsize" {
        naturalsize(h, v, a.flag(1, "binary", false), a.flag(2, "gnu", false), a.string(3, "format", "%.1f"))
    } else if f == "naturaldelta" {
        naturaldelta(h, v, a.flag(1, "months", true), a.string(2, "minimum_unit", "seconds"))
    } else if f == "naturaltime" {
        naturaltime(h, v, a.flag(1, "future", false), a.flag(2, "months", true), a.string(3, "minimum_unit", "seconds"),
            a.at(4, "when", Val.Nil))
    } else if f == "precisedelta" {
        precisedelta(h, v, a.string(1, "minimum_unit", "seconds"), a.strings(2, "suppress"), a.string(3, "format", "%0.2f"))
    } else if f == "naturalday" {
        naturalday(h, v, a.string(1, "format", "%b %d"))
    } else if f == "naturaldate" {
        naturaldate(h, v)
    } else {
        Err(f"AttributeError: module 'humanize' has no attribute {repr_str(f)}")
    }
}

fn run_job(h: mut ref H, j: ref JValue) -> Result[String, String] {
    let kind = match get(j, "kind") {
        Some(JValue.Str(s)) => s,
        _ => String.new(),
    };
    if kind == "activate" {
        let name = match get(j, "locale") {
            Some(JValue.Str(s)) => Some(s),
            _ => None,
        };
        activate(mut h, name)?;
        return Ok("ok".to_string());
    }
    if kind == "deactivate" {
        h.locale = None;
        return Ok("ok".to_string());
    }
    if kind == "remove" {
        if let Some(JValue.Str(p)) = get(j, "path") {
            if let Err(e) = fs.remove_file(p.clone()) {
                return Err(f"OSError: {e}");
            }
        }
        return Ok("ok".to_string());
    }
    let f = match get(j, "fn") {
        Some(JValue.Str(s)) => s,
        _ => String.new(),
    };
    let r = call(h, f, args_of(j))?;
    Ok(val_repr(r))
}

// ------------------------------------------------------------ data

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.jsonl".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.jsonl: {e}");
            return;
        }
    };
    let mut h = H { locale: None, names: Vec.new(), chains: Vec.new(), paths: Vec.new(), cats: Vec.new() };
    for line in jobs.lines() {
        println(f"== {line}");
        let j = match parse_json(line.to_string()) {
            Ok(v) => v,
            Err(e) => {
                println(f"  bad job: {e}");
                continue;
            }
        };
        match run_job(mut h, j) {
            Ok(s) => println(f"  {s}"),
            Err(e) => println(f"  {e}"),
        }
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    data_part_7(mut v);
    data_part_8(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("{\"kind\": \"activate\", \"locale\": null}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [0], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [1], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [2], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [3], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [4], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [11], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [12], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [13], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [21], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [22], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [23], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [101], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [102], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [111], \"kw\": {}}\n");
    t.push_str("{\"kind\": \"call\", \"fn\": \"ordinal\", \"args\": [112], \"kw\": {}}\n");
