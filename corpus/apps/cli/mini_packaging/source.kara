// mini_packaging — a port of PyPA `packaging` 26.3 (Apache-2.0 OR BSD):
// the version logic every `pip install` runs through. It parses a PEP 440
// version string, renders its canonical form, and orders two versions by the
// PEP 440 comparison key.
//
// Each job is `<op>\t<payload>`:
//   norm <version>       → str(Version(version)), the canonical PEP 440 form,
//                          or INVALID when packaging raises InvalidVersion;
//   cmp  <a>\x1f<b>       → "<", "=" or ">" for the ordering of the two.
//
// A version is parsed into: an epoch, a release tuple, an optional
// pre-release (letter normalized to a/b/rc + number), an optional post and
// dev release (numbers), and an optional local segment (a list of
// dot/underscore/hyphen-separated parts, each a number or a lowercased
// string). Rendering reproduces Version.__str__; comparison reproduces
// _cmpkey: release trailing zeros are stripped, the pre/post/dev state folds
// into a six-integer suffix rank (dev-only sorts before alpha; no-pre sorts
// after rc; no-post before post; dev before no-dev), and local parts compare
// as (number, "") for digits and (-1, string) for words so words sort before
// numbers and a version with no local sorts before one with a local.
//
// Scope: the PEP 440 version grammar and ordering. Specifier-set matching
// (`>=1,<2`, `~=`, `==x.*`) and requirement/marker parsing are out of scope
// (see README). Job inputs are well-formed PEP 440 strings (plus a handful of
// deliberately invalid ones); the hand-written parser matches the library's
// anchored regex on exactly this grammar.
//
// jobs_text() (appended by gen_kara.py) carries data/jobs.tsv verbatim.

struct Ver {
    b: Vec[i64],
    pos: i64,
    n: i64,
    valid: bool,
    epoch: i64,
    rel: Vec[i64],
    has_pre: bool,
    pre_letter: String,
    pre_rank: i64,
    pre_n: i64,
    has_post: bool,
    post_n: i64,
    has_dev: bool,
    dev_n: i64,
    has_local: bool,
    loc_prim: Vec[i64],
    loc_sec: Vec[String],
}

fn new_ver() -> Ver {
    Ver {
        b: Vec.new(),
        pos: 0,
        n: 0,
        valid: false,
        epoch: 0,
        rel: Vec.new(),
        has_pre: false,
        pre_letter: String.new(),
        pre_rank: 0,
        pre_n: 0,
        has_post: false,
        post_n: 0,
        has_dev: false,
        dev_n: 0,
        has_local: false,
        loc_prim: Vec.new(),
        loc_sec: Vec.new(),
    }
}

fn str_bytes(s: Str) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() {
        v.push(b as i64);
    }
    v
}

fn lower_byte(x: i64) -> i64 {
    if x >= 65 and x <= 90 {
        x + 32
    } else {
        x
    }
}

fn is_digit(x: i64) -> bool {
    x >= 48 and x <= 57
}

fn is_alnum(x: i64) -> bool {
    let l = lower_byte(x);
    is_digit(x) or (l >= 97 and l <= 122)
}

fn is_sep(x: i64) -> bool {
    x == 46 or x == 95 or x == 45
}

fn int_to_str(v: i64) -> String {
    if v == 0 {
        return "0".to_string();
    }
    let mut n = v;
    let mut neg = false;
    if n < 0 {
        neg = true;
        n = -n;
    }
    let mut digs: Vec[i64] = Vec.new();
    while n > 0 {
        digs.push(n % 10);
        n = n / 10;
    }
    let tbl = "0123456789".to_string();
    let mut o = String.new();
    if neg {
        o.push_str("-");
    }
    let mut i = digs.len();
    while i > 0 {
        i = i - 1;
        o.push_str(tbl.substring(digs[i], digs[i] + 1));
    }
    o
}

fn str_cmp(a: Str, b: Str) -> i64 {
    let ab = str_bytes(a);
    let bb = str_bytes(b);
    let an = ab.len();
    let bn = bb.len();
    let mut i = 0;
    while i < an and i < bn {
        if ab[i] < bb[i] {
            return -1;
        }
        if ab[i] > bb[i] {
            return 1;
        }
        i = i + 1;
    }
    if an < bn {
        -1
    } else if an > bn {
        1
    } else {
        0
    }
}

impl Ver {
    fn peek(ref self) -> i64 {
        if self.pos < self.n {
            self.b[self.pos]
        } else {
            -1
        }
    }

    // Read a run of decimal digits starting at pos; returns the value.
    // Sets no state; advances pos past the digits.
    fn read_uint(mut ref self) -> i64 {
        let mut acc = 0;
        while self.pos < self.n and is_digit(self.b[self.pos]) {
            acc = acc * 10 + (self.b[self.pos] - 48);
            self.pos = self.pos + 1;
        }
        acc
    }

    // Case-insensitively match the lowercase literal `tok` at pos. On a match,
    // advance pos past it and return true; otherwise leave pos unchanged.
    fn match_tok(mut ref self, tok: Str) -> bool {
        let tb = str_bytes(tok);
        let tn = tb.len();
        if self.pos + tn > self.n {
            return false;
        }
        let mut i = 0;
        while i < tn {
            if lower_byte(self.b[self.pos + i]) != tb[i] {
                return false;
            }
            i = i + 1;
        }
        self.pos = self.pos + tn;
        true
    }

    // Match a pre-release keyword in the regex alternation order
    // (alpha|a|beta|b|preview|pre|c|rc), setting letter + rank. Returns true
    // on a match, with pos advanced past the keyword.
    fn match_pre(mut ref self) -> bool {
        if self.match_tok("alpha") {
            self.pre_letter = "a".to_string();
            self.pre_rank = 0;
            return true;
        }
        if self.match_tok("a") {
            self.pre_letter = "a".to_string();
            self.pre_rank = 0;
            return true;
        }
        if self.match_tok("beta") {
            self.pre_letter = "b".to_string();
            self.pre_rank = 1;
            return true;
        }
        if self.match_tok("b") {
            self.pre_letter = "b".to_string();
            self.pre_rank = 1;
            return true;
        }
        if self.match_tok("preview") {
            self.pre_letter = "rc".to_string();
            self.pre_rank = 2;
            return true;
        }
        if self.match_tok("pre") {
            self.pre_letter = "rc".to_string();
            self.pre_rank = 2;
            return true;
        }
        if self.match_tok("c") {
            self.pre_letter = "rc".to_string();
            self.pre_rank = 2;
            return true;
        }
        if self.match_tok("rc") {
            self.pre_letter = "rc".to_string();
            self.pre_rank = 2;
            return true;
        }
        false
    }

    fn parse(mut ref self, s: Str) {
        self.b = str_bytes(s);
        self.pos = 0;
        self.n = self.b.len();

        // optional leading v / V
        if self.peek() == 118 or self.peek() == 86 {
            self.pos = self.pos + 1;
        }

        // optional epoch: <digits>not   — only an epoch if a 'not ' follows.
        let save = self.pos;
        let _e = self.read_uint();
        if self.pos > save and self.peek() == 33 {
            // reparse the epoch value from the saved span
            let mut acc = 0;
            let mut i = save;
            while i < self.pos {
                acc = acc * 10 + (self.b[i] - 48);
                i = i + 1;
            }
            self.epoch = acc;
            self.pos = self.pos + 1; // consume 'not '
        } else {
            self.pos = save; // those digits belong to the release
        }

        // release: [0-9]+(\.[0-9]+)*  — at least one digit required.
        if self.pos >= self.n or not is_digit(self.b[self.pos]) {
            self.valid = false;
            return;
        }
        self.rel.push(self.read_uint());
        let mut more = true;
        while more {
            if self.peek() == 46 and self.pos + 1 < self.n and is_digit(self.b[self.pos + 1]) {
                self.pos = self.pos + 1; // consume '.'
                self.rel.push(self.read_uint());
            } else {
                more = false;
            }
        }

        // pre-release: [._-]? (keyword) [._-]? [0-9]?
        let sp = self.pos;
        if self.pos < self.n and is_sep(self.b[self.pos]) {
            self.pos = self.pos + 1;
        }
        if self.match_pre() {
            self.has_pre = true;
            if self.pos < self.n and is_sep(self.b[self.pos]) {
                self.pos = self.pos + 1;
            }
            self.pre_n = self.read_uint();
        } else {
            self.pos = sp;
        }

        // post-release: either  -<digits>  or  [._-]? (post|rev|r) [._-]? <digits>?
        if self.peek() == 45 and self.pos + 1 < self.n and is_digit(self.b[self.pos + 1]) {
            self.pos = self.pos + 1; // consume '-'
            self.has_post = true;
            self.post_n = self.read_uint();
        } else {
            let pp = self.pos;
            if self.pos < self.n and is_sep(self.b[self.pos]) {
                self.pos = self.pos + 1;
            }
            let mut got = false;
            if self.match_tok("post") {
                got = true;
            } else if self.match_tok("rev") {
                got = true;
            } else if self.match_tok("r") {
                got = true;
            }
            if got {
                self.has_post = true;
                if self.pos < self.n and is_sep(self.b[self.pos]) {
                    self.pos = self.pos + 1;
                }
                self.post_n = self.read_uint();
            } else {
                self.pos = pp;
            }
        }

        // dev-release: [._-]? dev [._-]? <digits>?
        let dp = self.pos;
        if self.pos < self.n and is_sep(self.b[self.pos]) {
            self.pos = self.pos + 1;
        }
        if self.match_tok("dev") {
            self.has_dev = true;
            if self.pos < self.n and is_sep(self.b[self.pos]) {
                self.pos = self.pos + 1;
            }
            self.dev_n = self.read_uint();
        } else {
            self.pos = dp;
        }

        // local: +<part>([._-]<part>)*  where part is [a-z0-9]+
        if self.peek() == 43 {
            self.pos = self.pos + 1;
            let mut ok = true;
            let mut cont = true;
            while cont {
                let start = self.pos;
                while self.pos < self.n and is_alnum(self.b[self.pos]) {
                    self.pos = self.pos + 1;
                }
                if self.pos == start {
                    ok = false;
                    cont = false;
                } else {
                    // classify the part: all-digits -> int, else lowercased string
                    let mut all_dig = true;
                    let mut i = start;
                    while i < self.pos {
                        if not is_digit(self.b[i]) {
                            all_dig = false;
                        }
                        i = i + 1;
                    }
                    if all_dig {
                        let mut acc = 0;
                        let mut j = start;
                        while j < self.pos {
                            acc = acc * 10 + (self.b[j] - 48);
                            j = j + 1;
                        }
                        self.loc_prim.push(acc);
                        self.loc_sec.push(String.new());
                    } else {
                        let mut w = String.new();
                        let mut j = start;
                        while j < self.pos {
                            let lb = lower_byte(self.b[j]);
                            let mut ch: Vec[i64] = Vec.new();
                            ch.push(lb);
                            w.push_str(String.from_utf8(bytes_u8(ch)).unwrap_or("".to_string()));
                            j = j + 1;
                        }
                        self.loc_prim.push(-1);
                        self.loc_sec.push(w);
                    }
                    if self.peek() == 46 or self.peek() == 95 or self.peek() == 45 {
                        self.pos = self.pos + 1;
                    } else {
                        cont = false;
                    }
                }
            }
            if ok {
                self.has_local = true;
            } else {
                self.valid = false;
                return;
            }
        }

        // the regex is anchored: any trailing input is invalid.
        self.valid = self.pos == self.n;
    }
}

fn bytes_u8(v: Vec[i64]) -> Vec[u8] {
    let mut o: Vec[u8] = Vec.new();
    for x in v {
        o.push(x as u8);
    }
    o
}

fn ver_str(v: Ver) -> String {
    let mut o = String.new();
    if v.epoch > 0 {
        o.push_str(int_to_str(v.epoch));
        o.push_str("!");
    }
    let mut i = 0;
    while i < v.rel.len() {
        if i > 0 {
            o.push_str(".");
        }
        o.push_str(int_to_str(v.rel[i]));
        i = i + 1;
    }
    if v.has_pre {
        o.push_str(v.pre_letter.clone());
        o.push_str(int_to_str(v.pre_n));
    }
    if v.has_post {
        o.push_str(".post");
        o.push_str(int_to_str(v.post_n));
    }
    if v.has_dev {
        o.push_str(".dev");
        o.push_str(int_to_str(v.dev_n));
    }
    if v.has_local {
        o.push_str("+");
        let mut k = 0;
        while k < v.loc_prim.len() {
            if k > 0 {
                o.push_str(".");
            }
            if v.loc_prim[k] >= 0 and v.loc_sec[k] == "" {
                o.push_str(int_to_str(v.loc_prim[k]));
            } else {
                o.push_str(v.loc_sec[k].clone());
            }
            k = k + 1;
        }
    }
    o
}

// trimmed release length (trailing zeros removed)
fn rel_trim_len(v: Ver) -> i64 {
    let mut i = v.rel.len();
    while i > 0 and v.rel[i - 1] == 0 {
        i = i - 1;
    }
    i
}

// pre_rank component of the comparison suffix
fn suffix_pre_rank(v: Ver) -> i64 {
    if not v.has_pre and not v.has_post and v.has_dev {
        -1
    } else if not v.has_pre {
        3
    } else {
        v.pre_rank
    }
}

fn ver_cmp(a: Ver, b: Ver) -> i64 {
    if a.epoch != b.epoch {
        if a.epoch < b.epoch {
            return -1;
        }
        return 1;
    }

    // release, trailing zeros stripped, shorter prefix sorts first
    let an = rel_trim_len(a);
    let bn = rel_trim_len(b);
    let mut i = 0;
    while i < an and i < bn {
        if a.rel[i] < b.rel[i] {
            return -1;
        }
        if a.rel[i] > b.rel[i] {
            return 1;
        }
        i = i + 1;
    }
    if an < bn {
        return -1;
    }
    if an > bn {
        return 1;
    }

    // six-integer suffix: (pre_rank, pre_n, post_rank, post_n, dev_rank, dev_n)
    let apr = suffix_pre_rank(a);
    let bpr = suffix_pre_rank(b);
    let mut asuf: Vec[i64] = Vec.new();
    asuf.push(apr);
    if a.has_pre {
        asuf.push(a.pre_n);
    } else {
        asuf.push(0);
    }
    if a.has_post {
        asuf.push(1);
        asuf.push(a.post_n);
    } else {
        asuf.push(0);
        asuf.push(0);
    }
    if a.has_dev {
        asuf.push(0);
        asuf.push(a.dev_n);
    } else {
        asuf.push(1);
        asuf.push(0);
    }
    let mut bsuf: Vec[i64] = Vec.new();
    bsuf.push(bpr);
    if b.has_pre {
        bsuf.push(b.pre_n);
    } else {
        bsuf.push(0);
    }
    if b.has_post {
        bsuf.push(1);
        bsuf.push(b.post_n);
    } else {
        bsuf.push(0);
        bsuf.push(0);
    }
    if b.has_dev {
        bsuf.push(0);
        bsuf.push(b.dev_n);
    } else {
        bsuf.push(1);
        bsuf.push(0);
    }
    let mut s = 0;
    while s < 6 {
        if asuf[s] < bsuf[s] {
            return -1;
        }
        if asuf[s] > bsuf[s] {
            return 1;
        }
        s = s + 1;
    }

    // local: no-local sorts before any local; then part by part
    if not a.has_local and not b.has_local {
        return 0;
    }
    if not a.has_local {
        return -1;
    }
    if not b.has_local {
        return 1;
    }
    let la = a.loc_prim.len();
    let lb = b.loc_prim.len();
    let mut k = 0;
    while k < la and k < lb {
        if a.loc_prim[k] < b.loc_prim[k] {
            return -1;
        }
        if a.loc_prim[k] > b.loc_prim[k] {
            return 1;
        }
        let c = str_cmp(a.loc_sec[k], b.loc_sec[k]);
        if c != 0 {
            return c;
        }
        k = k + 1;
    }
    if la < lb {
        -1
    } else if la > lb {
        1
    } else {
        0
    }
}

fn split_us(payload: Str) -> Vec[String] {
    let v = str_bytes(payload);
    let n = v.len();
    let mut fields: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == 31 {
            fields.push(payload.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    fields
}

fn show_payload(payload: Str) -> String {
    let v = str_bytes(payload);
    let n = v.len();
    let mut o = String.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == 31 {
            o.push_str(payload.substring(start, i));
            if i < n {
                o.push_str(" | ");
            }
            start = i + 1;
        }
        i = i + 1;
    }
    o
}

fn run_job(op: Str, payload: Str) -> String {
    if op == "norm" {
        let mut v = new_ver();
        v.parse(payload);
        if v.valid {
            return ver_str(v);
        }
        return "INVALID".to_string();
    }
    // cmp
    let parts = split_us(payload);
    let mut a = new_ver();
    a.parse(parts[0].clone());
    let mut b = new_ver();
    b.parse(parts[1].clone());
    let c = ver_cmp(a, b);
    if c < 0 {
        "<".to_string()
    } else if c > 0 {
        ">".to_string()
    } else {
        "=".to_string()
    }
}

fn split_fields(line: Str) -> Vec[String] {
    let v = str_bytes(line);
    let n = v.len();
    let mut fields: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == 9 {
            fields.push(line.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    fields
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data);
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut line_start = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > line_start {
                let line = data.substring(line_start, i);
                let fields = split_fields(line);
                let op = fields[0].clone();
                let payload = fields[1].clone();
                out.push_str("== ");
                out.push_str(op.clone());
                out.push_str(" ");
                out.push_str(show_payload(payload.clone()));
                out.push_str("\n  ");
                out.push_str(run_job(op, payload));
                out.push_str("\n");
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

// data/jobs.tsv, as mk.py writes it.
fn jobs_text() -> String {
    let mut s = String.new();
    s.push_str("norm\t1.0\n");
    s.push_str("norm\t1.0.0\n");
    s.push_str("norm\tv2.3.4\n");
    s.push_str("norm\t0.1\n");
    s.push_str("norm\t1!2.0\n");
    s.push_str("norm\t2!1.0\n");
    s.push_str("norm\t1.0a1\n");
    s.push_str("norm\t1.0alpha1\n");
    s.push_str("norm\t1.0a\n");
    s.push_str("norm\t1.0b2\n");
    s.push_str("norm\t1.0beta2\n");
    s.push_str("norm\t1.0c3\n");
    s.push_str("norm\t1.0pre3\n");
    s.push_str("norm\t1.0preview3\n");
    s.push_str("norm\t1.0rc3\n");
    s.push_str("norm\t1.0.post1\n");
    s.push_str("norm\t1.0-1\n");
    s.push_str("norm\t1.0rev2\n");
    s.push_str("norm\t1.0r2\n");
    s.push_str("norm\t1.0.dev4\n");
    s.push_str("norm\t1.0a2.dev3\n");
    s.push_str("norm\t1.0.post1.dev2\n");
    s.push_str("norm\t1.0+ubuntu.1\n");
    s.push_str("norm\t1.0+abc.5\n");
    s.push_str("norm\t1.0+5\n");
    s.push_str("norm\t1.0.0.0\n");
    s.push_str("norm\t1.2.3.4.5\n");
    s.push_str("norm\t10.20.30\n");
    s.push_str("norm\t2.0.dev0\n");
    s.push_str("norm\t1!1.0rc2.post3.dev4+local.7\n");
    s.push_str("norm\t\n");
    s.push_str("norm\tfoo\n");
    s.push_str("norm\t1.0.0.0a.b\n");
    s.push_str("norm\t1..0\n");
    s.push_str("norm\t1.0+\n");
    s.push_str("norm\t1.0-\n");
    s.push_str("norm\t1.0.0rc\n");
    s.push_str("norm\t01!1.0junk\n");
    s.push_str("cmp\t1.0\x1f1.0.0\n");
    s.push_str("cmp\t1.0\x1f1.1\n");
    s.push_str("cmp\t1.0a1\x1f1.0a2\n");
    s.push_str("cmp\t1.0a2\x1f1.0b1\n");
    s.push_str("cmp\t1.0b1\x1f1.0rc1\n");
    s.push_str("cmp\t1.0rc1\x1f1.0\n");
    s.push_str("cmp\t1.0.dev1\x1f1.0a1\n");
    s.push_str("cmp\t1.0\x1f1.0.post1\n");
    s.push_str("cmp\t1.0.post1\x1f1.0.post1.dev1\n");
    s.push_str("cmp\t1.0.post1.dev1\x1f1.0.post1\n");
