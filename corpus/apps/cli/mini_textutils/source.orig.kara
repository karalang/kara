sort	-k1.2,1.4	hosts-a.txt
sort	-c	hosts-b.txt
sort	-c	versions.txt
sort	-m	hosts-a.txt	hosts-b.txt
cut	-d:	-f1,6	passwd
cut	-d:	-f5-	passwd
cut	-d,	-f2,4	--output-delimiter= | 	inventory.csv
cut	-c1-8,30-	access.log
cut	-d	 	-f1	access.log	|	sort	|	uniq	-c	|	sort	-rn
cut	-d:	-f1	--complement	passwd
cut	-d,	-s	-f1	words.txt
cut	-f2	cols.txt
cut	-d:	passwd
cut	-f	0	cols.txt
uniq	dups.txt
sort	dups.txt	|	uniq	-c
sort	dups.txt	|	uniq	-d
sort	dups.txt	|	uniq	-u
sort	-f	dups.txt	|	uniq	-ci
uniq	-f	1	-c	dups.txt
uniq	-s	6	dups.txt
cat	words.txt	|	tr	a-z	A-Z
cat	words.txt	|	tr	-s	 
cat	words.txt	|	tr	-d	aeiou
cat	words.txt	|	tr	-cs	[:alpha:]	\\n	|	tr	[:upper:]	[:lower:]	|	sort	|	uniq	-c	|	sort	-k1,1nr	-k2,2	|	head	-n	5
cat	passwd	|	tr	:	\\t	|	head	-n	2
cat	inventory.csv	|	tr	-d	\\r	|	tr	,	;
cat	words.txt	|	tr	abc	x
cat	words.txt	|	tr	-ds	a-z	 
cat	noeol.txt	|	tr	\\n	,
tr	a-z
tr	z-a	x
wc	words.txt
wc	-l	passwd	access.log	noeol.txt
cat	words.txt	|	wc	-w
wc	-c	-l	noeol.txt
cat	access.log	|	wc
wc	missing.txt	passwd
head	-n	2	passwd	noeol.txt
head	-n	-9	ids.txt
head	-c	20	access.log
tail	-n	3	ids.txt
tail	-n	+11	ids.txt
tail	-n	1	noeol.txt
tail	-c	7	noeol.txt
head	-n	x	ids.txt
join	-t	\u{0b}	names.tsv	orders.tsv
join	-t	\u{0b}	-a	1	-a	2	-e	NONE	-o	0,1.2,2.2,2.3	names.tsv	orders.tsv
join	-t	\u{0b}	-v	2	names.tsv	orders.tsv
join	-t	\u{0b}	-1	1	-2	1	-o	2.2,1.2	orders.tsv	names.tsv
join	-t	\u{0b}	unsorted.tsv	orders.tsv
comm	hosts-a.txt	hosts-b.txt
comm	-12	hosts-a.txt	hosts-b.txt
comm	-3	hosts-a.txt	hosts-b.txt
comm	-23	hosts-a.txt	hosts-b.txt
paste	hosts-a.txt	hosts-b.txt
paste	-d,	-s	hosts-a.txt
paste	-d	:-	ids.txt	hosts-a.txt	hosts-b.txt
cut	-d:	-f1	passwd	|	paste	-s	-d	 
nl	words.txt
nl	-b	a	-n	rz	-w	3	-s	. 	hosts-a.txt
tac	noeol.txt
tac	hosts-a.txt
cat	sizes.txt	|	numfmt	--to=iec	--field=1
cat	sizes.txt	|	numfmt	--to=si	--suffix=B	--field=1	--padding=6
numfmt	--from=iec	1K	2.5M	1G	512
cut	-f1	du.txt	|	numfmt	--from=iec	|	paste	-sd+
numfmt	--to=iec	--padding=8	1023	1024	1536	10240	1048575
numfmt	abc

"""
}

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    put("data/access.log", file_access_log())?;
    put("data/cols.txt", file_cols_txt())?;
    put("data/du.txt", file_du_txt())?;
    put("data/dups.txt", file_dups_txt())?;
    put("data/hosts-a.txt", file_hosts_a_txt())?;
    put("data/hosts-b.txt", file_hosts_b_txt())?;
    put("data/ids.txt", file_ids_txt())?;
    put("data/inventory.csv", file_inventory_csv())?;
    put("data/mixed.txt", file_mixed_txt())?;
    put("data/names.tsv", file_names_tsv())?;
    put("data/noeol.txt", file_noeol_txt())?;
    put("data/orders.tsv", file_orders_tsv())?;
    put("data/passwd", file_passwd())?;
    put("data/sizes.txt", file_sizes_txt())?;
    put("data/unsorted.tsv", file_unsorted_tsv())?;
    put("data/versions.txt", file_versions_txt())?;
    put("data/words.txt", file_words_txt())?;
    put("jobs.tsv", jobs_tsv())?;
    Ok(())
}

// ------------------------------------------------------------ the pipelines

// Runs one stage: `args[0]` is the tool, `stdin` what the previous stage
// printed.
fn run_tool(argv: ref Vec[String], stdin: Str, dir: Str) -> Io {
    let tool = argv[0].clone();
    let mut args: Vec[String] = Vec.new();
    for i in 1..argv.len() {
        args.push(argv[i].clone());
    }
    if tool == "sort" {
        sort_tool(args, stdin, dir)
    } else if tool == "cut" {
        cut_tool(args, stdin, dir)
    } else if tool == "uniq" {
        uniq_tool(args, stdin, dir)
    } else if tool == "tr" {
        tr_tool(args, stdin)
    } else if tool == "wc" {
        wc_tool(args, stdin, dir)
    } else if tool == "head" {
        head_tail(args, stdin, dir, false)
    } else if tool == "tail" {
        head_tail(args, stdin, dir, true)
    } else if tool == "join" {
        join_tool(args, stdin, dir)
    } else if tool == "comm" {
        comm_tool(args, stdin, dir)
    } else if tool == "paste" {
        paste_tool(args, stdin, dir)
    } else if tool == "nl" {
        nl_tool(args, stdin, dir)
    } else if tool == "tac" {
        tac_tool(args, stdin, dir)
    } else if tool == "cat" {
        cat_tool(args, stdin, dir)
    } else if tool == "numfmt" {
        numfmt_tool(args, stdin)
    } else {
        fail("sh", f"{tool}: command not found", 127)
    }
}

// An argument as a shell would need it written.
fn quote(a: Str) -> String {
    let b = a.bytes();
    let mut plain = b.len() > 0;
    for i in 0..b.len() {
        let c = b[i];
        let ok = is_alpha(c) or is_digit(c) or c == b'_' or c == b'.' or c == b'/' or c == b'=' or c == b'+' or c == b':' or c == b',' or c == b'%' or c == b'@' or c == b'-';
        if not ok {
            plain = false;
        }
    }
    if plain {
        return a.to_string();
    }
    let mut out: Vec[u8] = Vec.new();
    out.push(b'\'');
    for i in 0..b.len() {
        if b[i] == b'\'' {
            push_bytes(mut out, "'\\''");
        } else {
            out.push(b[i]);
        }
    }
    out.push(b'\'');
    from_bytes(out)
}

// Prints text, marking a missing final newline.
fn show(text: Str) {
    print(text);
    if text.len() > 0 and not text.ends_with("\n") {
        println("[no newline at end]");
    }
}

// A job line's arguments: tab-separated, a vertical tab standing for a
// tab inside one.
fn job_args(line: Str) -> Vec[String] {
    let b = to_bytes(line);
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if b[i] == b'\t' {
            out.push(from_bytes(cur));
            cur = Vec.new();
        } else if b[i] == 11 {
            cur.push(b'\t');
        } else {
            cur.push(b[i]);
        }
    }
    out.push(from_bytes(cur));
    out
}

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = match fs.read_to_string("jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read jobs.tsv: {e}"),
    };
    let lines = lines_of(jobs);
    for j in 0..lines.len() {
        let args = job_args(lines[j]);
        let mut shown = String.new();
        let mut stages: Vec[Vec[String]] = Vec.new();
        let mut cur: Vec[String] = Vec.new();
        for k in 0..args.len() {
            if k > 0 {
                shown.push_str(" ");
            }
            if args[k] == "|" {
                shown.push_str("|");
                stages.push(cur);
                cur = Vec.new();
            } else {
                shown.push_str(quote(args[k]));
                cur.push(args[k].clone());
            }
        }
        stages.push(cur);
        println(f"$ {shown}");
        let mut data = String.new();
        let mut errs: Vec[String] = Vec.new();
        let mut status: i64 = 0;
        for s in 0..stages.len() {
            let res = run_tool(stages[s], data, "data");
            data = res.out;
            errs.push(res.err);
            status = res.status;
        }
        show(data);
        for e in 0..errs.len() {
            show(errs[e]);
        }
        if status != 0 {
            println(f"[exit {status}]");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_textutils: {e}");
    }
}
