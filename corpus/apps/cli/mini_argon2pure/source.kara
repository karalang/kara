    s.push_str("up s h:7878a7e0c6fec966bc970eae7aae4e91cb7d359873942ceb91de3dd2a7fc8b5160ca7d195bf5ab253c570aee257acd0eca14d0b0f68b8e36\ndig s\nb2 h:\nnew s\nup s b:\nup s b:\nup s h:d5d3abc493ef7a492173d46eb1da2c4614b83903b7d974a6e9318a42ee3b8391cae24895b73006d05adc099e769731d5dd6e5c023a58d778431b07fe93978474b4fdc4895192d452e15a4fcb55ccef418c433a7a6912625c7b0db897347a58eedd9b7c8fed31fdbc9ac3b46edd0f235e8eca9b56edf757cfddc341fe2104be85\nup s b:\ndig s\nb2 h:d5d3abc493ef7a492173d46eb1da2c4614b83903b7d974a6e9318a42ee3b8391cae24895b73006d05adc099e769731d5dd6e5c023a58d778431b07fe93978474b4fdc4895192d452e15a4fcb55ccef418c433a7a6912625c7b0db897347a58eedd9b7c8fed31fdbc9ac3b46edd0f235e8eca9b56edf757cfddc341fe2104be85\nnew k key=b:secret len=20\nup k b:message\ndig k\ndig k\nup k b:more\nnew z len=99\njob BLAKE2b chains from argon2pure's tests\nchain keyed\nchain unkeyed\nchain various\njob Argon2's variable-length hash H'\nhp 1 b:password\nhp 4 b:password\nhp 32 b:password\nhp 63 b:password\nhp 64 b:password\nhp 65 b:password\nhp 96 b:password\nhp 128 b:password\nhp 129 b:password\nhp 1024 b:password\nhp 72 h:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f4041424344454647\njob A login service's password store\npolicy type=id t=1 m=8 p=1\npepper b:not-a-real-pepper\nreg alice b:alice-1027-Quartz\nreg bob b:bob-2623-Lumen\nreg carol b:carol-8824-Lumen\nreg dave b:dave-2099-Tulip\nreg alice b:again\nlogin alice b:alice-1027-Quartz\n");
    s.push_str("login alice b:alice-1027-Quartz!\nlogin bob b:BOB-2623-LUMEN\nlogin mallory b:guess\nsave users.db\ndrop\nlogin carol b:carol-8824-Lumen\nload users.db\nlogin carol b:carol-8824-Lumen\njob The policy is raised and logins rehash\npolicy type=id t=2 m=16 p=2\nlogin alice b:alice-1027-Quartz\nlogin alice b:alice-1027-Quartz\nlogin bob b:wrong\nlogin bob b:bob-2623-Lumen\nreg erin b:erin-1338-Ember\nreg frank b:frank-7665-Tulip\nforget dave\nlogin dave b:dave-2099-Tulip\nsave users.db\ndrop\nload users.db\nlogin alice b:alice-1027-Quartz\nlogin bob b:bob-2623-Lumen\nlogin carol b:carol-8824-Lumen\nlogin dave b:dave-2099-Tulip\nlogin erin b:erin-1338-Ember\nlogin frank b:frank-7665-Tulip\njob A new pepper locks out every old hash\npepper b:another-fake-pepper\nlogin erin b:erin-1338-Ember\npepper b:not-a-real-pepper\nlogin erin b:erin-1338-Ember\njob Hashes from elsewhere\npolicy type=i t=1 m=8 p=1\npepper b:\ncheck $argon2i$v=19$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF+okoGQVesHuKy5T9L/UnPmibNBB9qqrO2mSPHhs b:password\ncheck $argon2i$v=19$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF+okoGQVesHuKy5T9L/UnPmibNBB9qqrO2mSPHhs b:Password\ncheck $argon2i$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF+okoGQVesHuKy5T9L/UnPmibNBB9qqrO2mSPHhs b:password\ncheck $argon2i$v=16$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF+okoGQVesHuKy5T9L/UnPmibNBB9qqrO2mSPHhs b:password\ncheck argon2i$v=19$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF b:password\ncheck $argon2x$v=19$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF b:password\ncheck $argon2i$v=20$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF b:password\ncheck $argon2i$v=19$t=1,m=16,p=2$cmFuZG9tc2FsdA$AWPF b:password\ncheck $argon2i$v=19$m=16,t=1,p=2$cmFuZG9tc2FsdA b:password\ncheck $argon2i$v=19$m=16,t=1,p=2$cmFuZG9tc2Fsd$AWPF+okoGQVesHuKy5T9L/UnPmibNBB9qqrO2mSPHhs b:password\ncheck $argon2i$v=19$m=16,t=1,p=2$cmFuZG9tc2FsdA$AWPF*okoGQVesHuKy5T9L/UnPmibNBB9qqrO2mSPHhs b:password\ncheck $argon2i$v=19$m=4,t=1,p=1$cmFuZG9tc2FsdA$AWPF+okoGQVesHuKy5T9L/UnPmibNBB9qqrO2mSPHhs b:password\ncheck $argon2i$v=19$m=16,