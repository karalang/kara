// mini_textwrap: Python 3.13's textwrap module (TextWrapper with all its
// options, wrap, fill, shorten, dedent and indent), ported from
// Lib/textwrap.py, plus a small `fmt` that refills each paragraph of a file.
//
// The run writes the text files of the data section into data/, writes
// data/jobs.tsv, and runs every job in it. Text is handled as Vec[char],
// since every width and length in textwrap counts code points.

// ------------------------------------------------------------ characters

// textwrap's _whitespace: the only characters its regexes treat as space.
fn is_ws(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\u{b}' or c == '\u{c}' or c == '\r'
}

// str.isspace, which str.strip and str.split use: Unicode White_Space plus
// the four ASCII separators U+001C..U+001F.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

// The regex class \w.
fn is_word(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

// textwrap's `letter`, [^\d\W]: a word character that is not a digit.
fn is_letter(c: char) -> bool {
    is_word(c) and not c.is_ascii_digit()
}

// textwrap's `word_punct`, [\w!"'&.,?].
fn is_word_punct(c: char) -> bool {
    is_word(c) or c == '!' or c == '"' or c == '\'' or c == '&' or c == '.' or c == ',' or c == '?'
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn is_blank(v: ref Vec[char]) -> bool {
    v.iter().all(|c| py_space(*c))
}

fn lstrip(v: ref Vec[char]) -> Vec[char] {
    let mut i = 0;
    while i < v.len() and py_space(v[i]) {
        i += 1;
    }
    v[i..].to_vec()
}

fn rstrip(v: ref Vec[char]) -> Vec[char] {
    let mut n = v.len();
    while n > 0 and py_space(v[n - 1]) {
        n -= 1;
    }
    v[0..n].to_vec()
}

fn concat(parts: ref Vec[Vec[char]]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for p in parts.iter() {
        for c in p.iter() {
            out.push(*c);
        }
    }
    out
}

fn total_len(parts: ref Vec[Vec[char]]) -> i64 {
    let mut n = 0;
    for p in parts.iter() {
        n += p.len();
    }
    n
}

// str.split() with no argument: runs of whitespace separate the words.
fn py_split(v: ref Vec[char]) -> Vec[Vec[char]] {
    let mut words: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if py_space(*c) {
            if not cur.is_empty() {
                words.push(cur);
                cur = Vec.new();
            }
        } else {
            cur.push(*c);
        }
    }
    if not cur.is_empty() {
        words.push(cur);
    }
    words
}

// str.split(sep) for a one-character separator: always at least one piece.
fn split_on(v: ref Vec[char], sep: char) -> Vec[Vec[char]] {
    let mut pieces: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if *c == sep {
            pieces.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    pieces.push(cur);
    pieces
}

fn join_on(pieces: ref Vec[Vec[char]], sep: char) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for i in 0..pieces.len() {
        if i > 0 {
            out.push(sep);
        }
        for c in pieces[i].iter() {
            out.push(*c);
        }
    }
    out
}

fn starts_with(v: ref Vec[char], prefix: ref Vec[char]) -> bool {
    if prefix.len() > v.len() {
        return false;
    }
    for i in 0..prefix.len() {
        if v[i] != prefix[i] {
            return false;
        }
    }
    true
}

// ------------------------------------------------------------ TextWrapper

struct Wrapper {
    width: i64,
    initial_indent: Vec[char],
    subsequent_indent: Vec[char],
    expand_tabs: bool,
    tabsize: i64,
    replace_whitespace: bool,
    fix_sentence_endings: bool,
    break_long_words: bool,
    break_on_hyphens: bool,
    drop_whitespace: bool,
    max_lines: Option[i64],
    placeholder: Vec[char],
}

impl Wrapper {
    fn new(width: i64) -> Wrapper {
        Wrapper {
            width: width,
            initial_indent: Vec.new(),
            subsequent_indent: Vec.new(),
            expand_tabs: true,
            tabsize: 8,
            replace_whitespace: true,
            fix_sentence_endings: false,
            break_long_words: true,
            break_on_hyphens: true,
            drop_whitespace: true,
            max_lines: None,
            placeholder: chars(" [...]"),
        }
    }

    // _munge_whitespace: str.expandtabs, then every _whitespace character
    // becomes a space.
    fn munge(ref self, t: ref Vec[char]) -> Vec[char] {
        let mut out: Vec[char] = Vec.new();
        if self.expand_tabs {
            let mut col = 0;
            for c in t.iter() {
                if *c == '\t' {
                    if self.tabsize > 0 {
                        let incr = self.tabsize - col % self.tabsize;
                        for _ in 0..incr {
                            out.push(' ');
                        }
                        col += incr;
                    }
                } else if *c == '\n' or *c == '\r' {
                    out.push(*c);
                    col = 0;
                } else {
                    out.push(*c);
                    col += 1;
                }
            }
        } else {
            out = t.clone();
        }
        if self.replace_whitespace {
            for i in 0..out.len() {
                if is_ws(out[i]) {
                    out[i] = ' ';
                }
            }
        }
        out
    }

    // _split: wordsep_re (or wordsep_simple_re) splits the text into
    // chunks that tile it.
    fn split(ref self, t: ref Vec[char]) -> Vec[Vec[char]] {
        let n = t.len();
        let mut chunks: Vec[Vec[char]] = Vec.new();
        let mut i = 0;
        while i < n {
            let mut end = i;
            if is_ws(t[i]) {
                while end < n and is_ws(t[end]) {
                    end += 1;
                }
            } else if not self.break_on_hyphens {
                while end < n and not is_ws(t[end]) {
                    end += 1;
                }
            } else {
                end = match em_dash_at(t, i) {
                    Some(e) => e,
                    None => word_end(t, i),
                };
            }
            chunks.push(t[i..end].to_vec());
            i = end;
        }
        chunks
    }

    // _fix_sentence_endings
    fn fix_endings(ref self, chunks: mut ref Vec[Vec[char]]) {
        let mut i = 0;
        while i + 1 < chunks.len() {
            if chunks[i + 1] == vec![' '] and sentence_end(chunks[i]) {
                chunks[i + 1] = vec![' ', ' '];
                i += 2;
            } else {
                i += 1;
            }
        }
    }

    // _handle_long_word
    fn handle_long_word(ref self, rev: mut ref Vec[Vec[char]], cur_line: mut ref Vec[Vec[char]], cur_len: i64, width: i64) {
        let space_left = if width < 1 { 1 } else { width - cur_len };
        if self.break_long_words {
            let mut end = space_left;
            let last = rev.len() - 1;
            let chunk = rev[last].clone();
            if self.break_on_hyphens and chunk.len() > space_left {
                // chunk.rfind('-', 0, space_left)
                let mut hyphen = -1;
                let mut k = space_left;
                while k > 0 {
                    k -= 1;
                    if chunk[k] == '-' {
                        hyphen = k;
                        break;
                    }
                }
                if hyphen > 0 and chunk[0..hyphen].iter().any(|c| *c != '-') {
                    end = hyphen + 1;
                }
            }
            if end > chunk.len() {
                end = chunk.len();
            }
            cur_line.push(chunk[0..end].to_vec());
            rev[last] = chunk[end..].to_vec();
        } else if cur_line.is_empty() {
            cur_line.push(rev.pop().unwrap());
        }
    }

    // _wrap_chunks
    fn wrap_chunks(ref self, chunks: own Vec[Vec[char]]) -> Result[Vec[Vec[char]], String] {
        let mut lines: Vec[Vec[char]] = Vec.new();
        if self.width <= 0 {
            return Err(f"invalid width {self.width} (must be > 0)");
        }
        if let Some(ml) = self.max_lines {
            let indent = if ml > 1 { self.subsequent_indent.clone() } else { self.initial_indent.clone() };
            if indent.len() + lstrip(self.placeholder).len() > self.width {
                return Err("placeholder too large for max width".to_string());
            }
        }
        let mut rev = chunks;
        rev.reverse();
        while not rev.is_empty() {
            let mut cur_line: Vec[Vec[char]] = Vec.new();
            let mut cur_len = 0;
            let indent = if lines.is_empty() { self.initial_indent.clone() } else { self.subsequent_indent.clone() };
            let width = self.width - indent.len();
            if self.drop_whitespace and is_blank(rev[rev.len() - 1]) and not lines.is_empty() {
                rev.pop();
            }
            while not rev.is_empty() {
                let l = rev[rev.len() - 1].len();
                if cur_len + l <= width {
                    cur_line.push(rev.pop().unwrap());
                    cur_len += l;
                } else {
                    break;
                }
            }
            if not rev.is_empty() and rev[rev.len() - 1].len() > width {
                self.handle_long_word(mut rev, mut cur_line, cur_len, width);
                cur_len = total_len(cur_line);
            }
            if self.drop_whitespace and not cur_line.is_empty() and is_blank(cur_line[cur_line.len() - 1]) {
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if cur_line.is_empty() {
                continue;
            }
            let fits = match self.max_lines {
                None => true,
                Some(ml) => {
                    lines.len() + 1 < ml
                        or ((rev.is_empty() or (self.drop_whitespace and rev.len() == 1 and is_blank(rev[0]))) and cur_len <= width)
                }
            };
            if fits {
                let mut line = indent.clone();
                for c in concat(cur_line).iter() {
                    line.push(*c);
                }
                lines.push(line);
                continue;
            }
            // Truncate with the placeholder, and stop.
            let mut placed = false;
            while not cur_line.is_empty() {
                if not is_blank(cur_line[cur_line.len() - 1]) and cur_len + self.placeholder.len() <= width {
                    cur_line.push(self.placeholder.clone());
                    let mut line = indent.clone();
                    for c in concat(cur_line).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                    placed = true;
                    break;
                }
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if not placed {
                let mut done = false;
                if not lines.is_empty() {
                    let last = lines.len() - 1;
                    let prev_line = rstrip(lines[last]);
                    if prev_line.len() + self.placeholder.len() <= self.width {
                        let mut line = prev_line;
                        for c in self.placeholder.iter() {
                            line.push(*c);
                        }
                        lines[last] = line;
                        done = true;
                    }
                }
                if not done {
                    let mut line = indent.clone();
                    for c in lstrip(self.placeholder).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                }
            }
            break;
        }
        Ok(lines)
    }

    fn wrap(ref self, t: ref Vec[char]) -> Result[Vec[Vec[char]], String] {
        let mut chunks = self.split(self.munge(t));
        if self.fix_sentence_endings {
            self.fix_endings(mut chunks);
        }
        self.wrap_chunks(chunks)
    }

    fn fill(ref self, t: ref Vec[char]) -> Result[Vec[char], String] {
        match self.wrap(t) {
            Ok(lines) => Ok(join_on(lines, '\n')),
            Err(e) => Err(e),
        }
    }
}

// The em-dash alternative of wordsep_re, (?<=word_punct) -{2,} (?=\w),
// tried at i: the end of the dash run.
fn em_dash_at(t: ref Vec[char], i: i64) -> Option[i64] {
    if i == 0 or not is_word_punct(t[i - 1]) {
        return None;
    }
    let mut k = i;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    if k - i >= 2 and k < t.len() and is_word(t[k]) {
        Some(k)
    } else {
        None
    }
}

// (?=-{2,}\w) at j.
fn dashes_then_word(t: ref Vec[char], j: i64) -> bool {
    let mut k = j;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    k - j >= 2 and k < t.len() and is_word(t[k])
}

// The word alternative of wordsep_re, tried at i (a non-space): the lazy
// \S+? grows one character at a time until one of its three endings
// matches.
fn word_end(t: ref Vec[char], i: i64) -> i64 {
    let n = t.len();
    let mut j = i + 1;
    loop {
        // A hyphen inside a compound word: -(?:(?<=lt{2}-)|(?<=lt-lt-))(?=lt-?lt)
        if j < n and t[j] == '-' {
            let behind = (j >= 2 and is_letter(t[j - 2]) and is_letter(t[j - 1]))
                or (j >= 3 and is_letter(t[j - 3]) and t[j - 2] == '-' and is_letter(t[j - 1]));
            let ahead = j + 1 < n and is_letter(t[j + 1])
                and ((j + 2 < n and is_letter(t[j + 2])) or (j + 3 < n and t[j + 2] == '-' and is_letter(t[j + 3])));
            if behind and ahead {
                return j + 1;
            }
        }
        // The end of the word: (?=ws|\Z)
        if j == n or is_ws(t[j]) {
            return j;
        }
        // An em-dash follows: (?<=word_punct)(?=-{2,}\w)
        if is_word_punct(t[j - 1]) and dashes_then_word(t, j) {
            return j;
        }
        j += 1;
    }
}

// sentence_end_re, [a-z][\.\!\?][\"\']?\Z, searched in a chunk.
fn sentence_end(c: ref Vec[char]) -> bool {
    let mut n = c.len();
    if n > 0 and (c[n - 1] == '"' or c[n - 1] == '\'') {
        n -= 1;
    }
    n >= 2 and c[n - 2] >= 'a' and c[n - 2] <= 'z' and (c[n - 1] == '.' or c[n - 1] == '!' or c[n - 1] == '?')
}

// ------------------------------------------------------------ the module functions

// textwrap.shorten
fn shorten(w: own Wrapper, t: ref Vec[char]) -> Result[Vec[char], String] {
    let mut w = w;
    w.max_lines = Some(1);
    let words = py_split(t);
    w.fill(join_on(words, ' '))
}

fn is_tab_or_space(c: char) -> bool {
    c == ' ' or c == '\t'
}

// textwrap.dedent
fn dedent(t: ref Vec[char]) -> Vec[char] {
    // _whitespace_only_re: a line of only spaces and tabs becomes empty.
    let mut lines = split_on(t, '\n');
    for i in 0..lines.len() {
        if not lines[i].is_empty() and lines[i].iter().all(|c| is_tab_or_space(*c)) {
            lines[i] = Vec.new();
        }
    }
    // _leading_whitespace_re: the indent of every line with other text.
    let mut margin: Option[Vec[char]] = None;
    for line in lines.iter() {
        let mut k = 0;
        while k < line.len() and is_tab_or_space(line[k]) {
            k += 1;
        }
        if k == line.len() {
            continue;
        }
        let indent = line[0..k].to_vec();
        margin = match margin {
            None => Some(indent),
            Some(m) => {
                if starts_with(indent, m) {
                    Some(m)
                } else if starts_with(m, indent) {
                    Some(indent)
                } else {
                    let mut i = 0;
                    while i < m.len() and i < indent.len() and m[i] == indent[i] {
                        i += 1;
                    }
                    Some(m[0..i].to_vec())
                }
            }
        };
    }
    if let Some(m) = margin {
        if not m.is_empty() {
            for i in 0..lines.len() {
                if starts_with(lines[i], m) {
                    lines[i] = lines[i][m.len()..].to_vec();
                }
            }
        }
    }
    join_on(lines, '\n')
}

// str.splitlines(keepends=True)
fn splitlines_keep(t: ref Vec[char]) -> Vec[Vec[char]] {
    let mut out: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    let mut i = 0;
    while i < t.len() {
        let c = t[i];
        cur.push(c);
        if c == '\r' and i + 1 < t.len() and t[i + 1] == '\n' {
            cur.push('\n');
            i += 1;
            out.push(cur);
            cur = Vec.new();
        } else if c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' or c == '\u{1c}' or c == '\u{1d}'
            or c == '\u{1e}' or c == '\u{85}' or c == '\u{2028}' or c == '\u{2029}' {
            out.push(cur);
            cur = Vec.new();
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// textwrap.indent; `all` stands for the predicate `lambda line: True`.
fn indent(t: ref Vec[char], prefix: ref Vec[char], all: bool) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for line in splitlines_keep(t).iter() {
        // str.isspace() is false for an empty string, but splitlines
        // never yields one.
        if all or not is_blank(line) {
            for c in prefix.iter() {
                out.push(*c);
            }
        }
        for c in line.iter() {
            out.push(*c);
        }
    }
    out
}

// ------------------------------------------------------------ jobs

// A field's markers stand for control characters; "@name" is a file.
fn field(f: ref String) -> Result[Vec[char], String] {
    if f.starts_with("@") {
        let path = f"data/{f[1..].to_string()}";
        return match fs.read_to_string(path) {
            Ok(s) => Ok(chars(s)),
            Err(e) => Err(f"cannot read {f}: {e}"),
        };
    }
    let mut out: Vec[char] = Vec.new();
    for c in f.chars() {
        out.push(match c {
            '⏎' => '\n',
            '⇥' => '\t',
            '¤' => '\u{a0}',
            '␍' => '\r',
            '␋' => '\u{b}',
            '␌' => '\u{c}',
            _ => c,
        });
    }
    Ok(out)
}

fn show(v: ref Vec[char]) -> String {
    let mut s = String.new();
    for c in v.iter() {
        s.push(match *c {
            '\n' => '⏎',
            '\t' => '⇥',
            '\u{a0}' => '¤',
            '\r' => '␍',
            '\u{b}' => '␋',
            '\u{c}' => '␌',
            _ => *c,
        });
    }
    s
}

fn options(width: i64, spec: ref String) -> Wrapper {
    let mut w = Wrapper.new(width);
    if spec == "-" {
        return w;
    }
    for part in spec.split(",") {
        let eq = match part.find("=") {
            Some(i) => i,
            None => continue,
        };
        let key = part[0..eq].to_string();
        let value = part[eq + 1..].to_string();
        let flag = value == "1";
        let num: i64 = match i64.parse(value).ok() {
            Some(n) => n,
            None => 0,
        };
        if key == "ii" {
            w.initial_indent = chars(value);
        } else if key == "si" {
            w.subsequent_indent = chars(value);
        } else if key == "ph" {
            w.placeholder = chars(value);
        } else if key == "tabs" {
            w.expand_tabs = flag;
        } else if key == "ts" {
            w.tabsize = num;
        } else if key == "rw" {
            w.replace_whitespace = flag;
        } else if key == "fse" {
            w.fix_sentence_endings = flag;
        } else if key == "blw" {
            w.break_long_words = flag;
        } else if key == "boh" {
            w.break_on_hyphens = flag;
        } else if key == "dw" {
            w.drop_whitespace = flag;
        } else if key == "ml" {
            w.max_lines = Some(num);
        }
    }
    w
}

fn show_lines(out: mut ref String, lines: ref Vec[Vec[char]]) {
    for l in lines.iter() {
        out.push_str(f"  |{show(l)}|\n");
    }
}

fn show_one(out: mut ref String, r: Result[Vec[char], String]) {
    match r {
        Ok(v) => out.push_str(f"  |{show(v)}|\n"),
        Err(e) => out.push_str(f"ValueError: {e}\n"),
    }
}

fn run(f: ref Vec[String], out: mut ref String) -> Result[(), String] {
    let kind = f[0].clone();
    if kind == "dedent" {
        let t = field(f[1])?;
        show_one(mut out, Ok(dedent(t)));
        return Ok(());
    }
    if kind == "indent" {
        let prefix = field(f[1])?;
        let t = field(f[3])?;
        show_one(mut out, Ok(indent(t, prefix, f[2] == "all")));
        return Ok(());
    }
    let width: i64 = match i64.parse(f[1].clone()).ok() {
        Some(n) => n,
        None => return Err(f"bad width {f[1]}"),
    };
    if kind == "fmt" {
        let t = field(f[2])?;
        let w = Wrapper.new(width);
        // text.split("\n\n")
        let mut paras: Vec[Vec[char]] = Vec.new();
        let mut cur: Vec[char] = Vec.new();
        let mut i = 0;
        while i < t.len() {
            if t[i] == '\n' and i + 1 < t.len() and t[i + 1] == '\n' {
                paras.push(cur);
                cur = Vec.new();
                i += 2;
            } else {
                cur.push(t[i]);
                i += 1;
            }
        }
        paras.push(cur);
        for k in 0..paras.len() {
            if k > 0 {
                out.push_str("  --\n");
            }
            match w.fill(paras[k]) {
                Ok(filled) => show_lines(mut out, split_on(filled, '\n')),
                Err(e) => out.push_str(f"ValueError: {e}\n"),
            }
        }
        return Ok(());
    }
    let w = options(width, f[2]);
    let t = field(f[3])?;
    if kind == "wrap" {
        match w.wrap(t) {
            Ok(lines) => {
                show_lines(mut out, lines);
                out.push_str(f"({lines.len()} lines)\n");
            }
            Err(e) => out.push_str(f"ValueError: {e}\n"),
        }
    } else if kind == "fill" {
        show_one(mut out, w.fill(t));
    } else if kind == "shorten" {
        show_one(mut out, shorten(w, t));
    } else {
        return Err(f"unknown job {kind}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    for (name, contents) in data_files() {
        if let Err(e) = fs.write(f"data/{name}", contents) {
            eprintln(f"cannot write {name}: {e}");
            return;
        }
    }
    if let Err(e) = fs.write("data/jobs.tsv".to_string(), jobs_text()) {
        eprintln(f"cannot write jobs.tsv: {e}");
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"cannot read jobs.tsv: {e}");
            return;
        }
    };
    let mut out = String.new();
    for line in jobs.lines() {
        let f: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        out.push_str(f"== {f.join(" | ")}\n");
        if let Err(e) = run(f, mut out) {
            out.push_str(f"error: {e}\n");
        }
    }
    print(out);
}

// ------------------------------------------------------------ data

// The text files under data/, as (name, contents).
fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    let mut t = String.new();
    t.push_str("Fix the off-by-one in the ring buffer's wrap-around logic -- the reader could observe a half-written slot when the writer lapped it. This affects every multi-producer queue built on top of it, e.g. the log shipper and the metrics pipeline.  See https://example.org/issues/4711-ring-buffer-wraparound-race for the full write-up.\n");
    t.push_str("\n");
    t.push_str("Reviewed-by: A. N. Other <another@example.org>\n");
    v.push(("commit.txt".to_string(), t));
    let mut t = String.new();
    t.push_str("    Parse a configuration file.\n");
    t.push_str("\n");
    t.push_str("    The file is read line by line; each line is either a comment,\n");
    t.push_str("    a section header or a key-value pair.\n");
    t.push_str("      \n");
    t.push_str("        Nested examples keep their extra indent.\n");
    t.push_str("    \tA tab after the margin stays.\n");
    t.push_str("\n");
    t.push_str("    Returns a dict of dicts.\n");
    v.push(("docstring.txt".to_string(), t));
    let mut t = String.new();
    t.push_str("  two spaces\n");
    t.push_str("\tone tab\n");
    t.push_str("  \ttwo spaces then a tab\n");
    t.push_str("\n");
    t.push_str("  back to two\n");
    v.push(("mixed.txt".to_string(), t));
    let mut t = String.new();
    t.push_str("Kāra's ownership model has three tiers: owned values, borrowed references and reference-counted shared values. Most code never needs the third.\n");
    t.push_str("\n");
    t.push_str("A long identifier like configuration_loader_with_environment_overrides_and_defaults does not fit on one line, nor does https://docs.example.org/very/long/path/to/a/page.html at all.\n");
    t.push_str("\n");
    t.push_str("Distances are written 10 km and 2 h; the no-break space keeps each pair together. Café, naïve and façade are words too.\n");
    t.push_str("\n");
    t.push_str("Short.\n");
    v.push(("notes.md".to_string(), t));
    let mut t = String.new();
    t.push_str("name\tsize\tmodified\n");
    t.push_str("a.txt\t12\t2026-10-18\n");
    t.push_str("longer-name.json\t4096\t2026-01-02\n");
    t.push_str("x\t1\t\tdouble tab\n");
    v.push(("tabs.txt".to_string(), t));
    v
}

