== choice(), shuffle() and sample()
seed('deck') -> next random() 0.34663308033173434
choice(['red', 'green', 'blue']) = 'green'
choice(['solo']) = 'solo'
choice([]) -> IndexError: Cannot choose from an empty sequence
shuffle(['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h']) -> ['c', 'f', 'g', 'd', 'a', 'b', 'h', 'e']
shuffle([]) -> []
shuffle(['x']) -> ['x']
shuffle(['AS', '2S', '3S', '4S', '5S', '6S', '7S', '8S', '9S', 'TS', 'JS', 'QS', 'KS', 'AH', '2H', '3H', '4H', '5H', '6H', '7H', '8H', '9H', 'TH', 'JH', 'QH', 'KH', 'AD', '2D', '3D', '4D', '5D', '6D', '7D', '8D', '9D', 'TD', 'JD', 'QD', 'KD', 'AC', '2C', '3C', '4C', '5C', '6C', '7C', '8C', '9C', 'TC', 'JC', 'QC', 'KC']) -> ['AD', 'KC', 'JC', '2D', '6C', '9S', '7C', 'KS', 'AC', '6H', 'TC', '3H', '5D', '2C', 'JD', '9C', 'AH', 'TH', 'TS', '9H', '8C', '2H', '3C', '3D', '4C', '3S', '2S', 'JS', '4S', 'JH', '8H', '5H', '5S', '8D', '7D', 'KH', '7H', '4D', 'QD', '6S', 'AS', 'KD', '9D', '5C', '8S', 'QS', '4H', 'QH', '7S', '6D', 'QC', 'TD']
sample(['red', 'green', 'blue', 'cyan', 'magenta'], 3) = ['blue', 'red', 'green']
sample(['red', 'green', 'blue', 'cyan', 'magenta'], 5) = ['cyan', 'green', 'red', 'blue', 'magenta']
sample(['red', 'green', 'blue', 'cyan', 'magenta'], 0) = []
sample(['red', 'green', 'blue'], 4) -> ValueError: Sample larger than population or is negative
sample(['red', 'green', 'blue'], -1) -> ValueError: Sample larger than population or is negative
sample(range(0, 100), 5) = [56, 99, 19, 32, 83]
sample(range(0, 10), 10) = [8, 3, 5, 2, 4, 9, 6, 0, 7, 1]
sample(range(0, 1000000), 6) = [168166, 380407, 492934, 872072, 529533, 476268]
sample(range(0, 30), 6) = [4, 17, 27, 20, 23, 6]
sample(range(0, 30), 7) = [26, 11, 2, 0, 29, 6, 24]
sample(range(0, 60), 25) = [7, 45, 25, 33, 43, 56, 55, 59, 2, 30, 48, 36, 20, 47, 53, 8, 34, 58, 44, 24, 17, 13, 22, 41, 14]
sample(['AS', '2S', '3S', '4S', '5S', '6S', '7S', '8S', '9S', 'TS', 'JS', 'QS', 'KS', 'AH', '2H', '3H', '4H', '5H', '6H', '7H', '8H', '9H', 'TH', 'JH', 'QH', 'KH', 'AD', '2D', '3D', '4D', '5D', '6D', '7D', '8D', '9D', 'TD', 'JD', 'QD', 'KD', 'AC', '2C', '3C', '4C', '5C', '6C', '7C', '8C', '9C', 'TC', 'JC', 'QC', 'KC'], 13) = ['JS', '8S', '4D', '2C', '9H', '9C', '7C', '5C', 'QS', '2S', '6D', '4H', '8H']
sample(['red', 'blue'], 5, counts=[4, 2]) = ['red', 'blue', 'red', 'red', 'red']
sample(['red', 'blue'], 6, counts=[4, 2]) = ['blue', 'red', 'red', 'red', 'blue', 'red']
sample(['red', 'blue'], 7, counts=[4, 2]) -> ValueError: Sample larger than population or is negative
sample(['red', 'blue', 'green'], 2, counts=[4, 2]) -> ValueError: The number of counts does not match the population
sample(['red', 'blue'], 1, counts=[-1, 0]) -> ValueError: Counts must be non-negative
sample(['a', 'b', 'c'], 3, counts=[0, 3, 0]) = ['b', 'b', 'b']

== choices()
seed(99) -> next random() 0.40397807494366633
choices(['heads', 'tails'], k=10) = ['heads', 'heads', 'heads', 'heads', 'tails', 'heads', 'heads', 'tails', 'tails', 'tails']
choices(['a', 'b', 'c'], weights=[10, 5, 1], k=12) = ['a', 'a', 'a', 'a', 'b', 'a', 'a', 'b', 'a', 'b', 'b', 'a']
choices(['a', 'b', 'c'], cum_weights=[10, 15, 16], k=12) = ['c', 'a', 'b', 'a', 'a', 'a', 'a', 'a', 'c', 'a', 'a', 'b']
choices(['a', 'b', 'c'], weights=[0.5, 0.25, 0.25], k=6) = ['b', 'c', 'a', 'a', 'c', 'a']
choices(['a', 'b', 'c'], weights=[1, 2], k=3) -> ValueError: The number of weights does not match the population
choices(['a', 'b'], weights=[1, 2], cum_weights=[1, 3], k=3) -> TypeError: Cannot specify both weights and cumulative weights
choices(['a', 'b'], weights=[0, 0], k=3) -> ValueError: Total of weights must be greater than zero
choices(['a', 'b'], weights=[-1, 0.5], k=3) -> ValueError: Total of weights must be greater than zero
choices(['a', 'b'], weights=[1, inf], k=3) -> ValueError: Total of weights must be finite
choices([], k=1) -> IndexError: list index out of range
choices([], k=0) = []
choices([], weights=[], k=1) -> IndexError: list index out of range
choices(['x'], k=4) = ['x', 'x', 'x', 'x']
choices(['a', 'b', 'c'], k=0) = []

