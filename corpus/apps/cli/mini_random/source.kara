    t.push_str("job\tprogram: synthetic test data\n");
    t.push_str("program\tsynth\tsynth/lists.txt\n");
    t.push_str("job\tprogram: weather station simulator\n");
    t.push_str("program\tsensor\tsensor/station.conf\n");
    v.push(DataFile { path: "jobs.tsv".to_string(), body: t });
}

fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# checkout service, Black Friday rehearsal\n");
    t.push_str("seed = checkout-load-2026-10\n");
    t.push_str("rate = 12.5\n");
    t.push_str("requests = 300\n");
    t.push_str("error_rate = 0.02\n");
    t.push_str("endpoint GET /api/cart 5 3.2 0.35\n");
    t.push_str("endpoint POST /api/cart/items 3 3.6 0.40\n");
    t.push_str("endpoint GET /api/products 8 2.9 0.30\n");
    t.push_str("endpoint POST /api/checkout 1 4.8 0.55\n");
    t.push_str("endpoint GET /healthz 1 0.4 0.10\n");
    v.push(DataFile { path: "loadgen/checkout.conf".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# search, steady traffic\n");
    t.push_str("seed = search-steady\n");
    t.push_str("rate = 40\n");
    t.push_str("requests = 200\n");
    t.push_str("error_rate = 0.005\n");
    t.push_str("endpoint GET /search 9 3.9 0.6\n");
    t.push_str("endpoint GET /suggest 6 2.3 0.25\n");
    v.push(DataFile { path: "loadgen/search.conf".to_string(), body: t });
}

