fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/basics.m4", file_0())?;
    put("data/divert.m4", file_1())?;
    put("data/eof.m4", file_2())?;
    put("data/eofarg.m4", file_3())?;
    put("data/errors.m4", file_4())?;
    put("data/eval.m4", file_5())?;
    put("data/exit.m4", file_6())?;
    put("data/jobs.txt", file_7())?;
    make_dir("data/lib")?;
    put("data/lib/common.m4", file_8())?;
    put("data/lib/local.m4", file_9())?;
    put("data/loops.m4", file_10())?;
    put("data/main.m4", file_11())?;
    put("data/quotes.m4", file_12())?;
    put("data/second.m4", file_13())?;
    put("data/site.m4", file_14())?;
    put("data/text.m4", file_15())?;
    Ok(())
}

// ------------------------------------------------------------ the jobs

// Output that does not end in a newline is marked, so the next line
// starts on its own line.
fn show(text: Str) {
    print(text);
    if text.len() > 0 and not text.ends_with("\n") {
        println("[no newline at end]");
    }
}

// Runs one m4 command line in data/; returns its output, its messages
// and its exit status.
fn run_m4(args: ref Vec[String]) -> (String, String, i64) {
    let mut m = new_m4("data");
    let mut files: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < args.len() {
        let a = args[i].clone();
        if a.starts_with("-D") or a.starts_with("-U") {
            let mut spec = byte_str(to_bytes(a), 2, a.len());
            if spec.len() == 0 and i + 1 < args.len() {
                i += 1;
                spec = args[i].clone();
            }
            if a.starts_with("-U") {
                m.undefine(spec);
            } else {
                let b = to_bytes(spec);
                let mut eq = b.len();
                for k in 0..b.len() {
                    if b[k] == b'=' {
                        eq = k;
                        break;
                    }
                }
                let name = byte_str(b, 0, eq);
                let value = if eq < b.len() { byte_str(b, eq + 1, b.len()) } else { String.new() };
                m.set_def(name, Def { builtin: -1, text: value }, false);
            }
        } else {
            files.push(a);
        }
        i += 1;
    }
    let code = match m.run_files(files) {
        Ok(_) => m.status,
        Err(c) => c,
    };
    (from_bytes(m.out.clone()), from_bytes(m.err.clone()), code)
}

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    let lines = split_on(jobs, b'\n');
    for k in 0..lines.len() {
        let line = lines[k].clone();
        if line.len() == 0 {
            continue;
        }
        println(f"$ m4 {line}");
        let (out, err, code) = run_m4(split_ws(line));
        show(out);
        if err.len() > 0 {
            println("-- stderr");
            show(err);
        }
        if code != 0 {
            println(f"[exit {code}]");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_m4: {e}");
    }
}
