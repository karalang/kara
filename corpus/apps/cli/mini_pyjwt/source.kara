// mini_pyjwt: PyJWT 2.10.1 (jwt.encode / decode / decode_complete,
// get_unverified_header, PyJWS for raw and detached payloads, PyJWK and
// PyJWKSet, HMACAlgorithm's JWK conversion) as it runs without the
// cryptography package, so with HMAC (HS256/384/512) and "none":
// - the token shape and its errors: the three segments, base64url as
//   binascii's lenient decoder reads it, the header and payload loaded by
//   json.loads with each of its messages and positions, and UTF-8 decode
//   errors;
// - signatures with SHA-2 and HMAC written here from FIPS 180-4 and RFC
//   2104, and the PEM and SSH key checks HMAC keys go through;
// - the claims: exp, nbf and iat through int() with leeway, aud (with
//   strict_aud), iss, sub, jti and required claims, with the options that
//   switch each off, and the decoder-level options;
// - JWKs and JWK sets, including what a key that needs cryptography does
//   to a whole set;
// - an API gateway that checks bearer tokens against a JWK set by kid,
//   audience and scope over an access log, and a token issuer that writes
//   tokens for a user list to a file and checks them at later times.
//
// The inputs are data/jobs.jsonl and the files beside it, made by mk.py.
// expected.out is the output of oracle.py, which runs the same jobs
// through PyJWT itself (the copy in jwt/).

// ------------------------------------------------------------ Python values

// A value json.loads gives: integers keep their digits, so one past 64
// bits prints as Python prints it; objects keep their keys in order, and
// a repeated key keeps its first place and takes its last value.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(String),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

#[derive(Clone)]
struct Member {
    key: String,
    val: J,
}

// A raised exception: its class name and str().
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn failure(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

// ------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i] as u8);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}


// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(cps_string(text)), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and is_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
            if is_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, cps_string(key), val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own String, val: own J) {
    let mut j = 0;
    while j < members.len() {
        if members[j].key == key {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// A str from code points. A lone surrogate, which a str can hold but a
// Kara String cannot, becomes U+FFFD.
fn cps_string(cps: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in cps.iter() {
        if is_surrogate(*c) {
            push_utf8(mut out, 0xFFFD);
        } else {
            push_utf8(mut out, *c);
        }
    }
    String.from_utf8(out).unwrap()
}

fn string_cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

// json.loads on a str.
fn loads_cps(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}

fn loads_str(text: ref String) -> Result[J, Exc] {
    loads_cps(string_cps(text))
}

// The error bytes.decode("utf-8") raises: the bad byte, or the bytes from
// a sequence's start up to the one that does not fit.
fn utf8_error(b: ref Vec[u8], start: i64, end: i64, reason: Str) -> Exc {
    if end - start == 1 {
        return exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{b[start]:02x} in position {start}: {reason}");
    }
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {start}-{end - 1}: {reason}")
}

fn is_cont(c: u8) -> bool {
    c >= 0x80 and c <= 0xBF
}

// bytes.decode("utf-8", "surrogatepass"), as json.loads decodes bytes.
// An encoded surrogate (ED A0..BF 80..BF) is let through.
fn utf8_decode(b: ref Vec[u8]) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let c = b[i];
        if c < 0x80 {
            out.push(c as i64);
            i += 1;
            continue;
        }
        if c < 0xC2 or c > 0xF4 {
            return Err(utf8_error(b, i, i + 1, "invalid start byte"));
        }
        let need = if c < 0xE0 { 1 } else if c < 0xF0 { 2 } else { 3 };
        // The range the second byte must fall in.
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c == 0xE0 {
            lo = 0xA0;
        } else if c == 0xF0 {
            lo = 0x90;
        } else if c == 0xF4 {
            hi = 0x8F;
        }
        // ED A0..BF starts a surrogate, which strict UTF-8 rejects at the
        // second byte; when the third byte does not complete it, the error
        // is that one.
        let surrogate = c == 0xED and n > i + 1 and b[i + 1] >= 0xA0 and b[i + 1] <= 0xBF;
        if surrogate and (n <= i + 2 or not is_cont(b[i + 2])) {
            return Err(utf8_error(b, i, i + 1, "invalid continuation byte"));
        }
        let mut k = 1;
        while k <= need {
            if i + k >= n {
                return Err(utf8_error(b, i, n, "unexpected end of data"));
            }
            let d = b[i + k];
            let ok = if k == 1 { d >= lo and d <= hi } else { is_cont(d) };
            if not ok {
                return Err(utf8_error(b, i, i + k, "invalid continuation byte"));
            }
            k += 1;
        }
        let mut cp = if need == 1 { (c as i64) & 0x1F } else if need == 2 { (c as i64) & 0x0F } else { (c as i64) & 0x07 };
        for j in 1..(need + 1) {
            cp = (cp << 6) | ((b[i + j] as i64) & 0x3F);
        }
        out.push(cp);
        i += need + 1;
    }
    Ok(out)
}

// json.loads on bytes: the encoding is detected (only UTF-8, with or
// without its BOM, is handled here), the bytes are decoded, and the text
// is loaded. A decode error is a ValueError, as JSONDecodeError is.
fn loads_bytes(b: ref Vec[u8]) -> Result[J, Exc] {
    let mut body = b.clone();
    if b.len() >= 3 and b[0] == 0xEF and b[1] == 0xBB and b[2] == 0xBF {
        body = Vec.new();
        for i in 3..b.len() {
            body.push(b[i]);
        }
    }
    let cps = utf8_decode(body)?;
    loads_cps(cps)
}

// ------------------------------------------------------------ json.dumps

fn push_u_escape(out: mut ref String, cp: i64) {
    out.push_str("\\u");
    out.push_str(hex4(cp));
}

// encode_basestring_ascii, or encode_basestring without ensure_ascii.
fn encode_str(ensure_ascii: bool, s: ref String, out: mut ref String) {
    out.push('"');
    for ch in s.chars() {
        let c = ch as i64;
        if c == 34 {
            out.push_str("\\\"");
        } else if c == 92 {
            out.push_str("\\\\");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 8 {
            out.push_str("\\b");
        } else if c == 12 {
            out.push_str("\\f");
        } else if c < 0x20 {
            push_u_escape(mut out, c);
        } else if not ensure_ascii or c <= 0x7E {
            out.push(ch);
        } else if c >= 0x10000 {
            let n = c - 0x10000;
            push_u_escape(mut out, 0xD800 | ((n >> 10) & 0x3FF));
            push_u_escape(mut out, 0xDC00 | (n & 0x3FF));
        } else {
            push_u_escape(mut out, c);
        }
    }
    out.push('"');
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

// float.__repr__, or NaN / Infinity / -Infinity, as allow_nan writes them.
fn float_json(x: f64) -> String {
    if x != x {
        "NaN".to_string()
    } else if x == 1.0 / 0.0 {
        "Infinity".to_string()
    } else if x == -1.0 / 0.0 {
        "-Infinity".to_string()
    } else {
        f"{x}"
    }
}

// The order an object's members are written in: as stored, or by key.
fn member_order(sort_keys: bool, members: ref Vec[Member]) -> Vec[i64] {
    let mut order: Vec[i64] = Vec.new();
    for i in 0..members.len() {
        order.push(i);
    }
    if sort_keys {
        let mut k = 1;
        while k < order.len() {
            let cur = order[k];
            let mut j = k;
            while j > 0 and members[order[j - 1]].key > members[cur].key {
                order[j] = order[j - 1];
                j -= 1;
            }
            order[j] = cur;
            k += 1;
        }
    }
    order
}

struct Dump {
    item_sep: String,
    key_sep: String,
    sort_keys: bool,
}

// separators=(",", ":"), as PyJWT writes headers and payloads.
fn compact(sort_keys: bool) -> Dump {
    Dump { item_sep: ",".to_string(), key_sep: ":".to_string(), sort_keys: sort_keys }
}

fn encode(o: ref Dump, v: ref J, out: mut ref String) {
    match v {
        J.Null => out.push_str("null"),
        J.Bool(b) => out.push_str(if *b { "true" } else { "false" }),
        J.Int(digits) => out.push_str(digits),
        J.Float(x) => out.push_str(float_json(*x)),
        J.Str(s) => encode_str(true, s, mut out),
        J.Arr(items) => {
            out.push('[');
            for i in 0..items.len() {
                if i > 0 {
                    out.push_str(o.item_sep);
                }
                encode(o, items[i], mut out);
            }
            out.push(']');
        }
        J.Obj(members) => {
            out.push('{');
            let order = member_order(o.sort_keys, members);
            for i in 0..order.len() {
                if i > 0 {
                    out.push_str(o.item_sep);
                }
                let m = ref members[order[i]];
                encode_str(true, m.key, mut out);
                out.push_str(o.key_sep);
                encode(o, m.val, mut out);
            }
            out.push('}');
        }
    }
}

fn dumps(o: ref Dump, v: ref J) -> String {
    let mut out = String.new();
    encode(o, v, mut out);
    out
}

// ------------------------------------------------------------ repr and str

// str.isprintable outside ASCII: controls, format characters, separators
// other than space, surrogates and private use are not printable.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x8E2 or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let quote = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for ch in s.chars() {
        let c = ch as i64;
        if ch == quote or ch == '\\' {
            out.push('\\');
            out.push(ch);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 0x20 or c == 0x7F {
            out.push_str(f"\\x{hex_n(c, 2)}");
        } else if c < 0x7F or is_printable(c) {
            out.push(ch);
        } else if c <= 0xFF {
            out.push_str(f"\\x{hex_n(c, 2)}");
        } else if c <= 0xFFFF {
            out.push_str(f"\\u{hex_n(c, 4)}");
        } else {
            out.push_str(f"\\U{hex_n(c, 8)}");
        }
    }
    out.push(quote);
    out
}

fn repr(v: ref J) -> String {
    match v {
        J.Null => "None".to_string(),
        J.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        J.Int(digits) => digits.clone(),
        J.Float(x) => float_repr(*x),
        J.Str(s) => str_repr(s),
        J.Arr(items) => {
            let mut out = "[".to_string();
            for i in 0..items.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(repr(items[i]));
            }
            out.push(']');
            out
        }
        J.Obj(members) => {
            let mut out = "{".to_string();
            for i in 0..members.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(str_repr(members[i].key));
                out.push_str(": ");
                out.push_str(repr(members[i].val));
            }
            out.push('}');
            out
        }
    }
}

// str(v)
fn py_str(v: ref J) -> String {
    match v {
        J.Str(s) => s.clone(),
        _ => repr(v),
    }
}

// repr(bytes)
fn bytes_repr(b: ref Vec[u8]) -> String {
    let has_single = b.contains(39);
    let has_double = b.contains(34);
    let quote: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = "b".to_string();
    out.push(quote as char);
    for c in b.iter() {
        let x = *c;
        if x == quote or x == 92 {
            out.push('\\');
            out.push(x as char);
        } else if x == 9 {
            out.push_str("\\t");
        } else if x == 10 {
            out.push_str("\\n");
        } else if x == 13 {
            out.push_str("\\r");
        } else if x < 0x20 or x >= 0x7F {
            out.push_str(f"\\x{x:02x}");
        } else {
            out.push(x as char);
        }
    }
    out.push(quote as char);
    out
}

fn type_name(v: ref J) -> String {
    let n = match v {
        J.Null => "NoneType",
        J.Bool(_) => "bool",
        J.Int(_) => "int",
        J.Float(_) => "float",
        J.Str(_) => "str",
        J.Arr(_) => "list",
        J.Obj(_) => "dict",
    };
    n.to_string()
}

fn truthy(v: ref J) -> bool {
    match v {
        J.Null => false,
        J.Bool(b) => *b,
        J.Int(d) => d != "0",
        J.Float(x) => *x != 0.0,
        J.Str(s) => s.len() > 0,
        J.Arr(items) => items.len() > 0,
        J.Obj(members) => members.len() > 0,
    }
}

// The number a bool, int or float compares as.
fn num_of(v: ref J) -> Option[f64] {
    match v {
        J.Bool(b) => Some(if *b { 1.0 } else { 0.0 }),
        J.Int(d) => Some(f64.parse(d).unwrap_or(0.0)),
        J.Float(x) => Some(*x),
        _ => None,
    }
}

fn is_number(v: ref J) -> bool {
    num_of(v).is_some()
}

// a == b, with Python's rules: True == 1 == 1.0, and dicts compare by
// their members, not their order.
fn py_eq(a: ref J, b: ref J) -> bool {
    if let J.Int(x) = a {
        if let J.Int(y) = b {
            return x == y;
        }
    }
    if is_number(a) and is_number(b) {
        return num_of(a).unwrap() == num_of(b).unwrap();
    }
    match a {
        J.Null => match b {
            J.Null => true,
            _ => false,
        },
        J.Str(x) => match b {
            J.Str(y) => x == y,
            _ => false,
        },
        J.Arr(xs) => match b {
            J.Arr(ys) => {
                if xs.len() != ys.len() {
                    return false;
                }
                for i in 0..xs.len() {
                    if not py_eq(xs[i], ys[i]) {
                        return false;
                    }
                }
                true
            }
            _ => false,
        },
        J.Obj(xs) => match b {
            J.Obj(ys) => {
                if xs.len() != ys.len() {
                    return false;
                }
                for m in xs.iter() {
                    match j_get(b, m.key.as_str()) {
                        Some(v) => {
                            if not py_eq(m.val, v) {
                                return false;
                            }
                        }
                        None => return false,
                    }
                }
                true
            }
            _ => false,
        },
        _ => false,
    }
}

fn jstr(text: Str) -> J {
    J.Str(text.to_string())
}

// d.get(key) on a dict; None for anything else.
fn j_get(d: ref J, key: Str) -> Option[J] {
    if let J.Obj(members) = d {
        for m in members.iter() {
            if m.key == key {
                return Some(m.val.clone());
            }
        }
    }
    None
}

fn j_has(d: ref J, key: Str) -> bool {
    j_get(d, key).is_some()
}

fn j_get_or_null(d: ref J, key: Str) -> J {
    match j_get(d, key) {
        Some(v) => v,
        None => J.Null,
    }
}

// d[key] = val, keeping the key's place when it is there already.
fn j_set(d: mut ref J, key: Str, val: own J) {
    if let J.Obj(members) = d {
        put_member(mut members, key.to_string(), val);
    }
}

fn j_del(d: mut ref J, key: Str) {
    if let J.Obj(members) = d {
        let mut kept: Vec[Member] = Vec.new();
        for m in members.iter() {
            if m.key != key {
                kept.push(m.clone());
            }
        }
        *members = kept;
    }
}

fn is_dict(v: ref J) -> bool {
    match v {
        J.Obj(_) => true,
        _ => false,
    }
}

fn is_str(v: ref J) -> bool {
    match v {
        J.Str(_) => true,
        _ => false,
    }
}

fn is_null(v: ref J) -> bool {
    match v {
        J.Null => true,
        _ => false,
    }
}

// x in container: a list's items, a dict's keys, or a substring of a str.
fn contains(container: ref J, x: ref J) -> Result[bool, Exc] {
    match container {
        J.Arr(items) => {
            for it in items.iter() {
                if py_eq(it, x) {
                    return Ok(true);
                }
            }
            Ok(false)
        }
        J.Obj(members) => {
            for m in members.iter() {
                if py_eq(J.Str(m.key.clone()), x) {
                    return Ok(true);
                }
            }
            Ok(false)
        }
        J.Str(text) => match x {
            J.Str(sub) => Ok(text.contains(sub.as_str())),
            _ => Err(exc("TypeError", f"'in <string>' requires string as left operand, not {type_name(x)}")),
        },
        _ => Err(exc("TypeError", f"argument of type '{type_name(container)}' is not iterable")),
    }
}

fn str_bytes(text: ref String) -> Vec[u8] {
    text.bytes().to_vec()
}

fn bytes_str(b: ref Vec[u8]) -> String {
    String.from_utf8(b.clone()).unwrap()
}
// ------------------------------------------------------------ SHA-2 (FIPS 180-4) and HMAC (RFC 2104)

// The message padded to whole 64- or 128-byte blocks, with its bit
// length in `lenbytes` bytes, big- or little-endian.
fn md_pad(msg: ref Vec[u8], block: i64, lenbytes: i64, big: bool) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = msg.len() * 8;
    m.push(0x80);
    while m.len() % block != block - lenbytes {
        m.push(0);
    }
    for k in 0..lenbytes {
        let shift = if big { 8 * (lenbytes - 1 - k) } else { 8 * k };
        let b = if shift >= 64 { 0 } else { (bits >> shift) & 0xFF };
        m.push(b as u8);
    }
    m
}


fn be32(b: ref Vec[u8], i: i64) -> u32 {
    ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32)
}

fn be64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    for k in 0..8 {
        v = (v << 8) | (b[i + k] as u64);
    }
    v
}


fn push_be32(out: mut ref Vec[u8], x: u32) {
    let mut k: i64 = 3;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
        k -= 1;
    }
}

fn push_be64(out: mut ref Vec[u8], x: u64) {
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u64)) & 0xFFu64) as u8);
        k -= 1;
    }
}


const SHA256_K: Array[u32, 64] = [
    0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32, 0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
    0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32, 0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
    0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32, 0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
    0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32, 0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
    0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32, 0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
    0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32, 0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
    0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32, 0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
    0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32, 0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32,
];

// SHA-256, or SHA-224 with its own initial values and a shorter result.
fn sha256_family(msg: ref Vec[u8], is224: bool) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, true);
    let mut h: Vec[u32] = Vec.new();
    if is224 {
        for x in [0xc1059ed8u32, 0x367cd507u32, 0x3070dd17u32, 0xf70e5939u32, 0xffc00b31u32, 0x68581511u32, 0x64f98fa7u32, 0xbefa4fa4u32] {
            h.push(x);
        }
    } else {
        for x in [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32, 0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32] {
            h.push(x);
        }
    }
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..64 {
        w.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..64 {
            let s0 = w[t - 15].rotate_right(7) ^ w[t - 15].rotate_right(18) ^ (w[t - 15] >> 3u32);
            let s1 = w[t - 2].rotate_right(17) ^ w[t - 2].rotate_right(19) ^ (w[t - 2] >> 10u32);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
        }
        let mut v: Vec[u32] = h.clone();
        for t in 0..64 {
            let e = v[4];
            let a = v[0];
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & v[5]) ^ ((e ^ 0xFFFFFFFFu32) & v[6]);
            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA256_K[t]).wrapping_add(w[t]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & v[1]) ^ (a & v[2]) ^ (v[1] & v[2]);
            let t2 = s0.wrapping_add(maj);
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3].wrapping_add(t1);
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1.wrapping_add(t2);
        }
        for i in 0..8 {
            h[i] = h[i].wrapping_add(v[i]);
        }
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    let n = if is224 { 7 } else { 8 };
    for i in 0..n {
        push_be32(mut out, h[i]);
    }
    out
}

const SHA512_K: Array[u64, 80] = [
    0x428a2f98d728ae22u64, 0x7137449123ef65cdu64, 0xb5c0fbcfec4d3b2fu64, 0xe9b5dba58189dbbcu64,
