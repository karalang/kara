    0x72be5d74f27b896fu64, 0x80deb1fe3b1696b1u64, 0x9bdc06a725c71235u64, 0xc19bf174cf692694u64,
    0xe49b69c19ef14ad2u64, 0xefbe4786384f25e3u64, 0x0fc19dc68b8cd5b5u64, 0x240ca1cc77ac9c65u64,
    0x2de92c6f592b0275u64, 0x4a7484aa6ea6e483u64, 0x5cb0a9dcbd41fbd4u64, 0x76f988da831153b5u64,
    0x983e5152ee66dfabu64, 0xa831c66d2db43210u64, 0xb00327c898fb213fu64, 0xbf597fc7beef0ee4u64,
    0xc6e00bf33da88fc2u64, 0xd5a79147930aa725u64, 0x06ca6351e003826fu64, 0x142929670a0e6e70u64,
    0x27b70a8546d22ffcu64, 0x2e1b21385c26c926u64, 0x4d2c6dfc5ac42aedu64, 0x53380d139d95b3dfu64,
    0x650a73548baf63deu64, 0x766a0abb3c77b2a8u64, 0x81c2c92e47edaee6u64, 0x92722c851482353bu64,
    0xa2bfe8a14cf10364u64, 0xa81a664bbc423001u64, 0xc24b8b70d0f89791u64, 0xc76c51a30654be30u64,
    0xd192e819d6ef5218u64, 0xd69906245565a910u64, 0xf40e35855771202au64, 0x106aa07032bbd1b8u64,
    0x19a4c116b8d2d0c8u64, 0x1e376c085141ab53u64, 0x2748774cdf8eeb99u64, 0x34b0bcb5e19b48a8u64,
    0x391c0cb3c5c95a63u64, 0x4ed8aa4ae3418acbu64, 0x5b9cca4f7763e373u64, 0x682e6ff3d6b2b8a3u64,
    0x748f82ee5defb2fcu64, 0x78a5636f43172f60u64, 0x84c87814a1f0ab72u64, 0x8cc702081a6439ecu64,
    0x90befffa23631e28u64, 0xa4506cebde82bde9u64, 0xbef9a3f7b2c67915u64, 0xc67178f2e372532bu64,
    0xca273eceea26619cu64, 0xd186b8c721c0c207u64, 0xeada7dd6cde0eb1eu64, 0xf57d4f7fee6ed178u64,
    0x06f067aa72176fbau64, 0x0a637dc5a2c898a6u64, 0x113f9804bef90daeu64, 0x1b710b35131c471bu64,
    0x28db77f523047d84u64, 0x32caab7b40c72493u64, 0x3c9ebe0a15c9bebcu64, 0x431d67c49c100d4cu64,
    0x4cc5d4becb3e42b6u64, 0x597f299cfc657e2au64, 0x5fcb6fab3ad6faecu64, 0x6c44198c4a475817u64,
];

const SHA512_IV: Array[u64, 8] = [
    0x6a09e667f3bcc908u64, 0xbb67ae8584caa73bu64, 0x3c6ef372fe94f82bu64, 0xa54ff53a5f1d36f1u64,
    0x510e527fade682d1u64, 0x9b05688c2b3e6c1fu64, 0x1f83d9abfb41bd6bu64, 0x5be0cd19137e2179u64,
];

const SHA384_IV: Array[u64, 8] = [
    0xcbbb9d5dc1059ed8u64, 0x629a292a367cd507u64, 0x9159015a3070dd17u64, 0x152fecd8f70e5939u64,
    0x67332667ffc00b31u64, 0x8eb44a8768581511u64, 0xdb0c2e0d64f98fa7u64, 0x47b5481dbefa4fa4u64,
];

// SHA-512, or SHA-384 with its own initial values and a shorter result.
fn sha512_family(msg: ref Vec[u8], is384: bool) -> Vec[u8] {
    let m = md_pad(msg, 128, 16, true);
    let mut h: Vec[u64] = Vec.new();
    for i in 0..8 {
        h.push(if is384 { SHA384_IV[i] } else { SHA512_IV[i] });
    }
    let mut w: Vec[u64] = Vec.new();
    for _ in 0..80 {
        w.push(0u64);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be64(m, blk + 8 * t);
        }
        for t in 16..80 {
            let s0 = w[t - 15].rotate_right(1) ^ w[t - 15].rotate_right(8) ^ (w[t - 15] >> 7u64);
            let s1 = w[t - 2].rotate_right(19) ^ w[t - 2].rotate_right(61) ^ (w[t - 2] >> 6u64);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
        }
        let mut v: Vec[u64] = h.clone();
        for t in 0..80 {
            let e = v[4];
            let a = v[0];
            let s1 = e.rotate_right(14) ^ e.rotate_right(18) ^ e.rotate_right(41);
            let ch = (e & v[5]) ^ ((e ^ 0xFFFFFFFFFFFFFFFFu64) & v[6]);
            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA512_K[t]).wrapping_add(w[t]);
            let s0 = a.rotate_right(28) ^ a.rotate_right(34) ^ a.rotate_right(39);
            let maj = (a & v[1]) ^ (a & v[2]) ^ (v[1] & v[2]);
            let t2 = s0.wrapping_add(maj);
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3].wrapping_add(t1);
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1.wrapping_add(t2);
        }
        for i in 0..8 {
            h[i] = h[i].wrapping_add(v[i]);
        }
        blk += 128;
    }
    let mut out: Vec[u8] = Vec.new();
    let n = if is384 { 6 } else { 8 };
    for i in 0..n {
        push_be64(mut out, h[i]);
    }
    out
}


// hashlib.sha256 / sha384 / sha512 by digest size in bits.
fn sha2(bits: i64, msg: ref Vec[u8]) -> Vec[u8] {
    if bits == 256 {
        sha256_family(msg, false)
    } else if bits == 384 {
        sha512_family(msg, true)
    } else {
        sha512_family(msg, false)
    }
}

// hmac.new(key, msg, hash).digest(): a key longer than the block is hashed
// first, then padded with zeros to the block.
fn hmac_digest(bits: i64, key: ref Vec[u8], msg: ref Vec[u8]) -> Vec[u8] {
    let block = if bits == 256 { 64 } else { 128 };
    let mut k = if key.len() > block { sha2(bits, key) } else { key.clone() };
    while k.len() < block {
        k.push(0);
    }
    let mut inner: Vec[u8] = Vec.new();
    let mut outer: Vec[u8] = Vec.new();
    for b in k.iter() {
        inner.push(*b ^ 0x36);
        outer.push(*b ^ 0x5c);
    }
    for b in msg.iter() {
        inner.push(*b);
    }
    let ih = sha2(bits, inner);
    for b in ih.iter() {
        outer.push(*b);
    }
    sha2(bits, outer)
}

// hmac.compare_digest: equal length and equal bytes, looking at all of them.
fn compare_digest(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut diff: u8 = 0;
    for i in 0..a.len() {
        diff = diff | (a[i] ^ b[i]);
    }
    diff == 0
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b.iter() {
        s.push_str(f"{*x:02x}");
    }
    s
}

fn hex_val(c: u8) -> u8 {
    if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

// ------------------------------------------------------------ base64url

const B64URL: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

// base64.urlsafe_b64encode(b).replace(b"=", b"")
fn base64url_encode(b: ref Vec[u8]) -> String {
    let alpha = B64URL.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let n = b.len() - i;
        let x0 = b[i] as i64;
        let x1 = if n > 1 { b[i + 1] as i64 } else { 0 };
        let x2 = if n > 2 { b[i + 2] as i64 } else { 0 };
        let v = (x0 << 16) | (x1 << 8) | x2;
        out.push(alpha[(v >> 18) & 63]);
        out.push(alpha[(v >> 12) & 63]);
        if n > 1 {
            out.push(alpha[(v >> 6) & 63]);
        }
        if n > 2 {
            out.push(alpha[v & 63]);
        }
        i += 3;
    }
    String.from_utf8(out).unwrap()
}

// The value of a base64 character once - and _ are read as + and /, or
// -1 for one that binascii skips.
fn b64_value(c: u8) -> i64 {
    if c >= 65 and c <= 90 {
        (c - 65) as i64
    } else if c >= 97 and c <= 122 {
        (c - 71) as i64
    } else if c >= 48 and c <= 57 {
        (c as i64) + 4
    } else if c == 43 or c == 45 {
        62
    } else if c == 47 or c == 95 {
        63
    } else {
        -1
    }
}

// utils.base64url_decode: pad to a multiple of four, then
// base64.urlsafe_b64decode, which is binascii.a2b_base64 in its lenient
// mode: characters outside the alphabet are skipped, and enough padding
// after two or three characters of a group ends the input.
fn base64url_decode(input: ref Vec[u8]) -> Result[Vec[u8], Exc] {
    let mut b = input.clone();
    let rem = b.len() % 4;
    if rem > 0 {
        for _ in 0..(4 - rem) {
            b.push(61);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut quad = 0;
    let mut left = 0;
    let mut pads = 0;
    let mut done = false;
    for c in b.iter() {
        if *c == 61 {
            if quad >= 2 {
                pads += 1;
                if quad + pads >= 4 {
                    done = true;
                    break;
                }
            }
            continue;
        }
        let v = b64_value(*c);
        if v < 0 {
            continue;
        }
        pads = 0;
        if quad == 0 {
            quad = 1;
            left = v;
        } else if quad == 1 {
            quad = 2;
            out.push(((left << 2) | (v >> 4)) as u8);
            left = v & 0xF;
        } else if quad == 2 {
            quad = 3;
            out.push((((left << 4) | (v >> 2)) & 0xFF) as u8);
            left = v & 3;
        } else {
            quad = 0;
            out.push((((left << 6) | v) & 0xFF) as u8);
            left = 0;
        }
    }
    if not done and quad != 0 {
        if quad == 1 {
            let n = out.len() / 3 * 4 + 1;
            return Err(exc("Error", f"Invalid base64-encoded string: number of data characters ({n}) cannot be 1 more than a multiple of 4"));
        }
        return Err(exc("Error", "Incorrect padding".to_string()));
    }
    Ok(out)
}

// ------------------------------------------------------------ keys and algorithms

// The algorithms PyJWT has without the cryptography package.
#[derive(Clone)]
enum Alg {
    NoneAlg,
    Hmac(i64),
}

fn alg_class(a: ref Alg) -> String {
    match a {
        Alg.NoneAlg => "NoneAlgorithm".to_string(),
        Alg.Hmac(_) => "HMACAlgorithm".to_string(),
    }
}

// get_default_algorithms()
fn default_alg(name: Str) -> Option[Alg] {
    if name == "none" {
        Some(Alg.NoneAlg)
    } else if name == "HS256" {
        Some(Alg.Hmac(256))
    } else if name == "HS384" {
        Some(Alg.Hmac(384))
    } else if name == "HS512" {
        Some(Alg.Hmac(512))
    } else {
        None
    }
}

fn requires_cryptography(name: ref J) -> bool {
    if let J.Str(n) = name {
        for x in ["RS256", "RS384", "RS512", "ES256", "ES256K", "ES384", "ES521", "ES512", "PS256", "PS384", "PS512", "EdDSA"] {
            if n == x {
                return true;
            }
        }
    }
    false
}

// A key as PyJWT is handed one.
#[derive(Clone)]
enum Key {
    Text(String),
    Bytes(Vec[u8]),
    Jwk(PyJWK),
    Other(J),
}

fn is_jwk(k: ref Key) -> bool {
    match k {
        Key.Jwk(_) => true,
        _ => false,
    }
}

// utils.force_bytes
fn force_bytes(k: ref Key) -> Result[Vec[u8], Exc] {
    match k {
        Key.Text(t) => Ok(str_bytes(t)),
        Key.Bytes(b) => Ok(b.clone()),
        _ => Err(exc("TypeError", "Expected a string value".to_string())),
    }
}

fn force_bytes_j(v: ref J) -> Result[Vec[u8], Exc] {
    match v {
        J.Str(t) => Ok(str_bytes(t)),
        _ => Err(exc("TypeError", "Expected a string value".to_string())),
    }
}

fn at_bytes(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = pat.bytes().to_vec();
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn dash_or_space(b: ref Vec[u8], i: i64) -> bool {
    i < b.len() and (b[i] == 45 or b[i] == 32)
}

const PEMS: Array[Str, 16] = [
    "CERTIFICATE", "TRUSTED CERTIFICATE", "PRIVATE KEY", "PUBLIC KEY", "ENCRYPTED PRIVATE KEY",
    "OPENSSH PRIVATE KEY", "DSA PRIVATE KEY", "RSA PRIVATE KEY", "RSA PUBLIC KEY", "EC PRIVATE KEY",
    "DH PARAMETERS", "NEW CERTIFICATE REQUEST", "CERTIFICATE REQUEST", "SSH2 PUBLIC KEY",
    "SSH2 ENCRYPTED PRIVATE KEY", "X509 CRL",
];

// Whether an END line for `name` starts just past the newline at `nl`.
fn pem_end_at(b: ref Vec[u8], nl: i64, name: Str) -> bool {
    let mut i = nl + 1;
    if not at_bytes(b, i, "----") or not dash_or_space(b, i + 4) {
        return false;
    }
    i += 5;
    if not at_bytes(b, i, "END ") or not at_bytes(b, i + 4, name) {
        return false;
    }
    i += 4 + name.len();
    dash_or_space(b, i) and at_bytes(b, i + 1, "----")
}

// The BEGIN line for `name` at `p`, and where its body starts, if it is
// one.
fn pem_begin_at(b: ref Vec[u8], p: i64, name: Str) -> Option[i64] {
    if not at_bytes(b, p, "----") or not dash_or_space(b, p + 4) {
        return None;
    }
    let mut i = p + 5;
    if not at_bytes(b, i, "BEGIN ") or not at_bytes(b, i + 6, name) {
        return None;
    }
    i += 6 + name.len();
    if not dash_or_space(b, i) or not at_bytes(b, i + 1, "----") {
        return None;
    }
    i += 5;
    if i < b.len() and b[i] == 13 {
        i += 1;
    }
    if i < b.len() and b[i] == 10 {
        return Some(i + 1);
    }
    None
}

// utils.is_pem_format: a search for
//   ----[- ]BEGIN (NAME)[- ]----\r?\n.+?\r?\n----[- ]END \1[- ]----
// with . matching newlines too.
fn is_pem_format(b: ref Vec[u8]) -> bool {
    for p in 0..b.len() {
        for name in PEMS {
            if let Some(body) = pem_begin_at(b, p, name) {
                let mut nl = body + 1;
                while nl < b.len() {
                    if b[nl] == 10 and pem_end_at(b, nl, name) {
                        return true;
                    }
                    nl += 1;
                }
            }
        }
    }
    false
}

fn is_ssh_key(b: ref Vec[u8]) -> bool {
    for f in ["ssh-ed25519", "ssh-rsa", "ssh-dss", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521"] {
        if at_bytes(b, 0, f) {
            return true;
        }
    }
    false
}

// Algorithm.prepare_key: HMAC wants bytes that are not an asymmetric key;
// "none" wants no key at all, an empty string counting as none.
fn prepare_key(a: ref Alg, key: ref Key) -> Result[Vec[u8], Exc] {
    match a {
        Alg.NoneAlg => {
            let empty = match key {
                Key.Text(t) => t.len() == 0,
                Key.Other(v) => is_null(v),
                _ => false,
            };
            if not empty {
                return Err(exc("InvalidKeyError", "When alg = \"none\", key value must be None.".to_string()));
            }
            Ok(Vec.new())
        }
        Alg.Hmac(_) => {
            let b = force_bytes(key)?;
            if is_pem_format(b) or is_ssh_key(b) {
                return Err(exc("InvalidKeyError", "The specified key is an asymmetric key or x509 certificate and should not be used as an HMAC secret.".to_string()));
            }
            Ok(b)
        }
    }
}

fn sign(a: ref Alg, msg: ref Vec[u8], key: ref Vec[u8]) -> Vec[u8] {
    match a {
        Alg.NoneAlg => Vec.new(),
        Alg.Hmac(bits) => hmac_digest(*bits, key, msg),
    }
}

fn verify(a: ref Alg, msg: ref Vec[u8], key: ref Vec[u8], sig: ref Vec[u8]) -> bool {
    match a {
        Alg.NoneAlg => false,
        Alg.Hmac(bits) => compare_digest(sig, hmac_digest(*bits, key, msg)),
    }
}

// HMACAlgorithm.to_jwk
fn hmac_to_jwk(key: ref Key, as_dict: bool) -> Result[String, Exc] {
    let k = base64url_encode(force_bytes(key)?);
    let mut d = J.Obj(Vec.new());
    j_set(mut d, "k", J.Str(k));
    j_set(mut d, "kty", jstr("oct"));
    if as_dict {
        return Ok(repr(d));
    }
    let o = Dump { item_sep: ", ".to_string(), key_sep: ": ".to_string(), sort_keys: false };
    Ok(str_repr(dumps(o, d)))
}

// HMACAlgorithm.from_jwk: a JSON string or a dict.
fn hmac_from_jwk(jwk: ref J) -> Result[Vec[u8], Exc] {
    let obj = match jwk {
        J.Str(text) => match loads_str(text) {
            Ok(v) => v,
            Err(_) => return Err(exc("InvalidKeyError", "Key is not valid JSON".to_string())),
        },
        J.Obj(_) => jwk.clone(),
        _ => return Err(exc("InvalidKeyError", "Key is not valid JSON".to_string())),
    };
    if not is_dict(obj) {
        return Err(no_get(obj));
    }
    if not py_eq(j_get_or_null(obj, "kty"), jstr("oct")) {
        return Err(exc("InvalidKeyError", "Not an HMAC key".to_string()));
    }
    let k = match j_get(obj, "k") {
        Some(k) => k,
        None => return Err(exc("KeyError", "'k'".to_string())),
    };
    base64url_decode(force_bytes_j(k)?)
}

// The AttributeError for calling .get on something that is not a dict.
fn no_get(v: ref J) -> Exc {
    exc("AttributeError", f"'{type_name(v)}' object has no attribute 'get'")
}

// ------------------------------------------------------------ JWK

#[derive(Clone)]
struct PyJWK {
    data: J,
    algorithm_name: String,
    alg: Alg,
    key: Vec[u8],
}

impl PyJWK {
    fn key_type(ref self) -> J {
        j_get_or_null(self.data, "kty")
    }

    fn key_id(ref self) -> J {
        j_get_or_null(self.data, "kid")
    }

    fn public_key_use(ref self) -> J {
        j_get_or_null(self.data, "use")
    }
}

fn eq_str(v: ref J, text: Str) -> bool {
    py_eq(v, jstr(text))
}

// PyJWK(jwk_data, algorithm): the algorithm is the one given, else the
// key's "alg", else one picked from its kty and crv.
fn new_jwk(data: ref J, algorithm: ref J) -> Result[PyJWK, Exc] {
    if not is_dict(data) {
        return Err(no_get(data));
    }
    let kty = j_get_or_null(data, "kty");
    if not truthy(kty) {
        return Err(exc("InvalidKeyError", f"kty is not found: {repr(data)}"));
    }
    let mut alg = algorithm.clone();
    if not truthy(alg) {
        alg = j_get_or_null(data, "alg");
    }
    if not truthy(alg) {
        let crv = j_get_or_null(data, "crv");
        let name = if eq_str(kty, "EC") {
            if eq_str(crv, "P-256") or not truthy(crv) {
                "ES256"
            } else if eq_str(crv, "P-384") {
                "ES384"
            } else if eq_str(crv, "P-521") {
                "ES512"
            } else if eq_str(crv, "secp256k1") {
                "ES256K"
            } else {
                return Err(exc("InvalidKeyError", f"Unsupported crv: {py_str(crv)}"));
            }
        } else if eq_str(kty, "RSA") {
            "RS256"
        } else if eq_str(kty, "oct") {
            "HS256"
        } else if eq_str(kty, "OKP") {
            if not truthy(crv) {
                return Err(exc("InvalidKeyError", f"crv is not found: {repr(data)}"));
            }
            if eq_str(crv, "Ed25519") {
                "EdDSA"
            } else {
                return Err(exc("InvalidKeyError", f"Unsupported crv: {py_str(crv)}"));
            }
        } else {
            return Err(exc("InvalidKeyError", f"Unsupported kty: {py_str(kty)}"));
        };
        alg = jstr(name);
    }
    if requires_cryptography(alg) {
        return Err(exc("MissingCryptographyError", f"{py_str(alg)} requires 'cryptography' to be installed."));
    }
    let name = match alg {
        J.Str(n) => n.clone(),
        _ => String.new(),
    };
    let a = match default_alg(name.as_str()) {
        Some(a) => a,
        None => return Err(exc("PyJWKError", f"Unable to find an algorithm for key: {repr(data)}")),
    };
    let key = match a {
        Alg.NoneAlg => return Err(exc("NotImplementedError", String.new())),
        Alg.Hmac(_) => hmac_from_jwk(data)?,
    };
    Ok(PyJWK { data: data.clone(), algorithm_name: name, alg: a, key: key })
}

fn jwk_from_json(text: ref String, algorithm: ref J) -> Result[PyJWK, Exc] {
    let obj = loads_str(text)?;
    new_jwk(obj, algorithm)
}

// The exceptions under PyJWTError.
fn is_pyjwt_error(e: ref Exc) -> bool {
    for n in ["PyJWTError", "InvalidTokenError", "DecodeError", "InvalidSignatureError", "ExpiredSignatureError",
              "InvalidAudienceError", "InvalidIssuerError", "InvalidIssuedAtError", "ImmatureSignatureError",
              "InvalidKeyError", "InvalidAlgorithmError", "MissingRequiredClaimError", "PyJWKError",
              "MissingCryptographyError", "PyJWKSetError", "PyJWKClientError", "PyJWKClientConnectionError",
              "InvalidSubjectError", "InvalidJTIError"] {
        if e.kind == n {
            return true;
        }
    }
    false
}

#[derive(Clone)]
struct PyJWKSet {
    keys: Vec[PyJWK],
}

// PyJWKSet(keys): keys PyJWK cannot use are skipped, except that a key
// needing the cryptography package fails the whole set.
fn new_jwk_set(keys: ref J) -> Result[PyJWKSet, Exc] {
    if not truthy(keys) {
        return Err(exc("PyJWKSetError", "The JWK Set did not contain any keys".to_string()));
    }
    let items = match keys {
        J.Arr(items) => items.clone(),
        _ => return Err(exc("PyJWKSetError", "Invalid JWK Set value".to_string())),
    };
    let mut out: Vec[PyJWK] = Vec.new();
    for k in items.iter() {
        match new_jwk(k, J.Null) {
            Ok(j) => out.push(j),
            Err(e) => {
                if e.kind == "MissingCryptographyError" or not is_pyjwt_error(e) {
                    return Err(e);
                }
            }
        }
    }
    if out.len() == 0 {
        return Err(exc("PyJWKSetError", "The JWK Set did not contain any usable keys. Perhaps 'cryptography' is not installed?".to_string()));
    }
    Ok(PyJWKSet { keys: out })
}

fn jwk_set_from_dict(obj: ref J) -> Result[PyJWKSet, Exc] {
    if not is_dict(obj) {
        return Err(no_get(obj));
    }
    let keys = match j_get(obj, "keys") {
        Some(k) => k,
        None => J.Arr(Vec.new()),
    };
    new_jwk_set(keys)
}

fn jwk_set_from_json(text: ref String) -> Result[PyJWKSet, Exc] {
    let obj = loads_str(text)?;
    jwk_set_from_dict(obj)
}

impl PyJWKSet {
    fn find(ref self, kid: ref J) -> Result[PyJWK, Exc] {
        for k in self.keys.iter() {
            if py_eq(k.key_id(), kid) {
                return Ok(k.clone());
            }
        }
        Err(exc("KeyError", str_repr(f"keyset has no key for kid: {py_str(kid)}")))
    }
}

// ------------------------------------------------------------ JWS

#[derive(Clone)]
struct PyJWS {
    valid: Vec[String],
}

fn default_jws() -> PyJWS {
    let mut v: Vec[String] = Vec.new();
    for n in ["none", "HS256", "HS384", "HS512"] {
        v.push(n.to_string());
    }
    PyJWS { valid: v }
}

impl PyJWS {
    // get_algorithm_by_name: the algorithm has to be one PyJWT has and one
    // this instance allows.
    fn algorithm_by_name(ref self, name: ref J) -> Result[Alg, Exc] {
        match name {
            J.Arr(_) => return Err(exc("TypeError", "unhashable type: 'list'".to_string())),
            J.Obj(_) => return Err(exc("TypeError", "unhashable type: 'dict'".to_string())),
            J.Str(n) => {
                if self.valid.contains(n) {
                    if let Some(a) = default_alg(n.as_str()) {
                        return Ok(a);
                    }
                }
            }
            _ => {}
        }
        if requires_cryptography(name) {
            return Err(exc("NotImplementedError", f"Algorithm '{py_str(name)}' could not be found. Do you have cryptography installed?"));
        }
        Err(exc("NotImplementedError", "Algorithm not supported".to_string()))
    }
}

fn validate_headers(headers: ref J) -> Result[(), Exc] {
    if let Some(kid) = j_get(headers, "kid") {
        if not is_str(kid) {
            return Err(exc("InvalidTokenError", "Key ID header parameter must be a string".to_string()));
        }
    }
    Ok(())
}

fn is_false(v: ref J) -> bool {
    match v {
        J.Bool(b) => not *b,
        _ => false,
    }
}

// PyJWS.encode
fn jws_encode(jws: ref PyJWS, payload: ref Vec[u8], key: ref Key, algorithm: ref J, headers: ref J,
              detached_arg: bool, sort_headers: bool) -> Result[String, Exc] {
    let mut detached = detached_arg;
    let mut alg = if is_null(algorithm) {
        match key {
            Key.Jwk(k) => J.Str(k.algorithm_name.clone()),
            _ => jstr("HS256"),
        }
    } else {
        algorithm.clone()
    };
    let have_headers = truthy(headers);
    if have_headers {
        let ha = j_get_or_null(headers, "alg");
        if truthy(ha) {
            alg = ha;
        }
        if let Some(b) = j_get(headers, "b64") {
            if is_false(b) {
                detached = true;
            }
        }
    }
    let mut header = J.Obj(Vec.new());
    j_set(mut header, "typ", jstr("JWT"));
    j_set(mut header, "alg", alg.clone());
    if have_headers {
        validate_headers(headers)?;
        if let J.Obj(members) = headers {
            for m in members.iter() {
                j_set(mut header, m.key.as_str(), m.val.clone());
            }
        }
    }
    if not truthy(j_get_or_null(header, "typ")) {
        j_del(mut header, "typ");
    }
    if detached {
        j_set(mut header, "b64", J.Bool(false));
    } else if j_has(header, "b64") {
        j_del(mut header, "b64");
    }
    let json_header = dumps(compact(sort_headers), header);
    let head = base64url_encode(str_bytes(json_header));
    let body = if detached { bytes_str(payload) } else { base64url_encode(payload) };
    let signing_input = str_bytes(f"{head}.{body}");
    let a = jws.algorithm_by_name(alg)?;
    let raw_key = match key {
        Key.Jwk(k) => Key.Bytes(k.key.clone()),
        _ => key.clone(),
    };
    let prepared = prepare_key(a, raw_key)?;
    let signature = base64url_encode(sign(a, signing_input, prepared));
    if detached {
        return Ok(f"{head}..{signature}");
    }
    Ok(f"{head}.{body}.{signature}")
}

// A token as decode() is handed one.
#[derive(Clone)]
enum Token {
    Text(String),
    Bytes(Vec[u8]),
    Other(J),
}

#[derive(Clone)]
struct Loaded {
    payload: Vec[u8],
    signing_input: Vec[u8],
    header: J,
    signature: Vec[u8],
}

fn decode_error(msg: own String) -> Exc {
    exc("DecodeError", msg)
}

fn slice_bytes(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for i in from..to {
        out.push(b[i]);
    }
    out
}

fn rfind_dot(b: ref Vec[u8]) -> i64 {
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == 46 {
            return i;
        }
        i -= 1;
    }
    -1
}

fn find_dot(b: ref Vec[u8]) -> i64 {
    for i in 0..b.len() {
        if b[i] == 46 {
            return i;
        }
    }
    -1
}

// PyJWS._load: three base64url segments, the first a JSON object.
fn jws_load(token: ref Token) -> Result[Loaded, Exc] {
    let jwt = match token {
        Token.Text(t) => str_bytes(t),
        Token.Bytes(b) => b.clone(),
        Token.Other(_) => return Err(decode_error("Invalid token type. Token must be a <class 'bytes'>".to_string())),
    };
    let last = rfind_dot(jwt);
    if last < 0 {
        return Err(decode_error("Not enough segments".to_string()));
    }
    let signing_input = slice_bytes(jwt, 0, last);
    let crypto = slice_bytes(jwt, last + 1, jwt.len());
    let first = find_dot(signing_input);
    if first < 0 {
        return Err(decode_error("Not enough segments".to_string()));
    }
    let header_seg = slice_bytes(signing_input, 0, first);
    let payload_seg = slice_bytes(signing_input, first + 1, signing_input.len());
    let header_data = match base64url_decode(header_seg) {
        Ok(b) => b,
        Err(_) => return Err(decode_error("Invalid header padding".to_string())),
    };
    let header = match loads_bytes(header_data) {
        Ok(h) => h,
        Err(e) => return Err(decode_error(f"Invalid header string: {e.msg}")),
    };
    if not is_dict(header) {
        return Err(decode_error("Invalid header string: must be a json object".to_string()));
    }
    let payload = match base64url_decode(payload_seg) {
        Ok(b) => b,
        Err(_) => return Err(decode_error("Invalid payload padding".to_string())),
    };
    let signature = match base64url_decode(crypto) {
        Ok(b) => b,
        Err(_) => return Err(decode_error("Invalid crypto padding".to_string())),
    };
    Ok(Loaded { payload: payload, signing_input: signing_input, header: header, signature: signature })
}

fn get_unverified_header(token: ref Token) -> Result[J, Exc] {
    let l = jws_load(token)?;
    validate_headers(l.header)?;
    Ok(l.header)
}

fn invalid_alg(msg: Str) -> Exc {
    exc("InvalidAlgorithmError", msg.to_string())
}

// PyJWS._verify_signature
fn verify_signature(jws: ref PyJWS, signing_input: ref Vec[u8], header: ref J, signature: ref Vec[u8], key: ref Key,
                    algorithms_arg: ref J) -> Result[(), Exc] {
    let mut algorithms = algorithms_arg.clone();
    if is_null(algorithms) {
        if let Key.Jwk(k) = key {
            let mut one: Vec[J] = Vec.new();
            one.push(J.Str(k.algorithm_name.clone()));
            algorithms = J.Arr(one);
        }
    }
    let alg = match j_get(header, "alg") {
        Some(a) => a,
        None => return Err(invalid_alg("Algorithm not specified")),
    };
    if not truthy(alg) {
        return Err(invalid_alg("The specified alg value is not allowed"));
    }
    if not is_null(algorithms) and not contains(algorithms, alg)? {
        return Err(invalid_alg("The specified alg value is not allowed"));
    }
    let (a, prepared) = match key {
        Key.Jwk(k) => (k.alg.clone(), k.key.clone()),
        _ => {
            let a = match jws.algorithm_by_name(alg) {
                Ok(a) => a,
                Err(e) => {
                    if e.kind == "NotImplementedError" {
                        return Err(invalid_alg("Algorithm not supported"));
                    }
                    return Err(e);
                }
            };
            let p = prepare_key(a, key)?;
            (a, p)
        }
    };
    if not verify(a, signing_input, prepared, signature) {
        return Err(exc("InvalidSignatureError", "Signature verification failed".to_string()));
    }
    Ok(())
}

// What decode_complete returns.
#[derive(Clone)]
struct Decoded {
    payload: Vec[u8],
    header: J,
    signature: Vec[u8],
}

// PyJWS.decode_complete
fn jws_decode_complete(jws: ref PyJWS, token: ref Token, key: ref Key, algorithms: ref J, options: ref J,
                       detached: ref Option[Vec[u8]]) -> Result[Decoded, Exc] {
    let mut verify_sig = true;
    if let Some(v) = j_get(options, "verify_signature") {
        verify_sig = truthy(v);
    }
    if verify_sig and not truthy(algorithms) and not is_jwk(key) {
        return Err(decode_error("It is required that you pass in a value for the \"algorithms\" argument when calling decode().".to_string()));
    }
    let l = jws_load(token)?;
    let mut payload = l.payload.clone();
    let mut signing_input = l.signing_input.clone();
    if let Some(b) = j_get(l.header, "b64") {
        if is_false(b) {
            let d = match detached {
                Some(d) => d.clone(),
                None => return Err(decode_error("It is required that you pass in a value for the \"detached_payload\" argument to decode a message having the b64 header set to false.".to_string())),
            };
            let cut = rfind_dot(signing_input);
            let mut si = if cut < 0 { signing_input.clone() } else { slice_bytes(signing_input, 0, cut) };
            si.push(46);
            for x in d.iter() {
                si.push(*x);
            }
            payload = d;
            signing_input = si;
        }
    }
    if verify_sig {
        verify_signature(jws, signing_input, l.header, l.signature, key, algorithms)?;
    }
    Ok(Decoded { payload: payload, header: l.header, signature: l.signature })
}

// ------------------------------------------------------------ JWT

fn default_options() -> J {
    let mut o = J.Obj(Vec.new());
    for n in ["verify_signature", "verify_exp", "verify_nbf", "verify_iat", "verify_aud", "verify_iss", "verify_sub", "verify_jti"] {
        j_set(mut o, n, J.Bool(true));
    }
    j_set(mut o, "require", J.Arr(Vec.new()));
    o
}

// {**a, **b}
fn merge(a: ref J, b: ref J) -> J {
    let mut out = a.clone();
    if let J.Obj(members) = b {
        for m in members.iter() {
            j_set(mut out, m.key.as_str(), m.val.clone());
        }
    }
    out
}

fn set_default(d: mut ref J, key: Str, val: own J) {
    if not j_has(d, key) {
        j_set(mut d, key, val);
    }
}

// PyJWT.encode
fn jwt_encode(payload: ref J, key: ref Key, algorithm: ref J, headers: ref J, sort_headers: bool) -> Result[String, Exc] {
    if not is_dict(payload) {
        return Err(exc("TypeError", "Expecting a dict object, as JWT only supports JSON objects as payloads.".to_string()));
    }
    let body = dumps(compact(false), payload);
    jws_encode(default_jws(), str_bytes(body), key, algorithm, headers, false, sort_headers)
}

// The arguments decode() takes after the token and key.
struct DecodeArgs {
    algorithms: J,
    options: J,
    audience: J,
    issuer: J,
    subject: J,
    leeway: f64,
    detached: Option[Vec[u8]],
}

fn no_args() -> DecodeArgs {
    DecodeArgs {
        algorithms: J.Null, options: J.Null, audience: J.Null, issuer: J.Null, subject: J.Null,
        leeway: 0.0, detached: None,
    }
}

struct Decoder {
    options: J,
}

fn new_decoder(options: ref J) -> Decoder {
    Decoder { options: merge(default_options(), options) }
}

impl Decoder {
    // PyJWT.decode_complete: the header and signature as PyJWS gives them,
    // and the payload loaded and its claims checked.
    fn decode_complete(ref self, token: ref Token, key: ref Key, a: ref DecodeArgs, now: f64) -> Result[(J, J, Vec[u8]), Exc] {
        let mut options = if is_dict(a.options) { a.options.clone() } else { J.Obj(Vec.new()) };
        set_default(mut options, "verify_signature", J.Bool(true));
        if not truthy(j_get_or_null(options, "verify_signature")) {
            for n in ["verify_exp", "verify_nbf", "verify_iat", "verify_aud", "verify_iss", "verify_sub", "verify_jti"] {
                set_default(mut options, n, J.Bool(false));
            }
        }
        let d = jws_decode_complete(default_jws(), token, key, a.algorithms, options, a.detached)?;
        let payload = match loads_bytes(d.payload) {
            Ok(p) => p,
            Err(e) => return Err(decode_error(f"Invalid payload string: {e.msg}")),
        };
        if not is_dict(payload) {
            return Err(decode_error("Invalid payload string: must be a json object".to_string()));
        }
        let merged = merge(self.options, options);
        validate_claims(payload, merged, a, now)?;
        Ok((d.header, payload, d.signature))
    }

    fn decode(ref self, token: ref Token, key: ref Key, a: ref DecodeArgs, now: f64) -> Result[J, Exc] {
        let (_, payload, _) = self.decode_complete(token, key, a, now)?;
        Ok(payload)
    }
}

// The value int() gives, kept exact while it fits in 64 bits.
#[derive(Clone)]
enum PyInt {
    Small(i64),
    Huge(f64),
}

fn int_of_digits(neg: bool, digits: ref String) -> PyInt {
    if digits.len() <= 18 {
        let n = i64.parse(digits).unwrap_or(0);
        return PyInt.Small(if neg { 0 - n } else { n });
    }
    let x = f64.parse(digits).unwrap_or(0.0);
    PyInt.Huge(if neg { 0.0 - x } else { x })
}

fn is_py_space(c: char) -> bool {
    let o = c as i64;
    o == 32 or (o >= 9 and o <= 13) or (o >= 0x1C and o <= 0x1F) or o == 0x85 or o == 0xA0
}

// int(text) in base 10: surrounding white space, a sign, and digits that
// single underscores may separate. None for the ValueError.
fn int_of_str(text: ref String) -> Option[PyInt] {
    let cs: Vec[char] = text.chars().collect();
    let mut lo = 0;
    let mut hi = cs.len();
    while lo < hi and is_py_space(cs[lo]) {
        lo += 1;
    }
    while hi > lo and is_py_space(cs[hi - 1]) {
        hi -= 1;
    }
    let mut neg = false;
    if lo < hi and (cs[lo] == '+' or cs[lo] == '-') {
        neg = cs[lo] == '-';
        lo += 1;
    }
    let mut digits = String.new();
    let mut last_digit = false;
    let mut i = lo;
    while i < hi {
        let c = cs[i];
        if c >= '0' and c <= '9' {
            digits.push(c);
            last_digit = true;
        } else if c == '_' and last_digit and i + 1 < hi and cs[i + 1] >= '0' and cs[i + 1] <= '9' {
            last_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if digits.len() == 0 {
        return None;
    }
    while digits.len() > 1 and digits.starts_with("0") {
        digits = digits.substring(1, digits.len()).to_string();
    }
    Some(int_of_digits(neg, digits))
}

// int(v): Ok(None) is the ValueError the claim checks catch; other errors
// are raised.
fn py_int(v: ref J) -> Result[Option[PyInt], Exc] {
    match v {
        J.Bool(b) => Ok(Some(PyInt.Small(if *b { 1 } else { 0 }))),
        J.Int(d) => {
            let neg = d.starts_with("-");
            let digits = if neg { d.substring(1, d.len()).to_string() } else { d.clone() };
            Ok(Some(int_of_digits(neg, digits)))
        }
        J.Float(x) => {
            if *x != *x {
                return Ok(None);
            }
            if *x == 1.0 / 0.0 or *x == -1.0 / 0.0 {
                return Err(exc("OverflowError", "cannot convert float infinity to integer".to_string()));
            }
            let t = x.trunc();
            if t < 9.0e18 and t > -9.0e18 {
                Ok(Some(PyInt.Small(t as i64)))
            } else {
                Ok(Some(PyInt.Huge(t)))
            }
        }
        J.Str(text) => Ok(int_of_str(text)),
        _ => Err(exc("TypeError", f"int() argument must be a string, a bytes-like object or a real number, not '{type_name(v)}'")),
    }
}

// The sign of n - x, as Python compares an int with a float exactly.
fn cmp_int_float(n: ref PyInt, x: f64) -> i64 {
    match n {
        PyInt.Huge(h) => if *h < x { -1 } else if *h > x { 1 } else { 0 },
        PyInt.Small(i) => {
            let f = *i as f64;
            if f < x {
                -1
            } else if f > x {
                1
            } else {
                let xi = x as i64;
                if *i < xi { -1 } else if *i > xi { 1 } else { 0 }
            }
        }
    }
}

fn int_claim(payload: ref J, name: Str, kind: Str, msg: Str) -> Result[PyInt, Exc] {
    match py_int(j_get_or_null(payload, name))? {
        Some(n) => Ok(n),
        None => Err(exc(kind, msg.to_string())),
    }
}

fn missing_claim(claim: ref String) -> Exc {
    exc("MissingRequiredClaimError", f"Token is missing the \"{claim}\" claim")
}

// _validate_claims, in PyJWT's order.
fn validate_claims(payload: ref J, options: ref J, a: ref DecodeArgs, now: f64) -> Result[(), Exc] {
    match a.audience {
        J.Null => {}
        J.Str(_) => {}
        J.Arr(_) => {}
        J.Obj(_) => {}
        _ => return Err(exc("TypeError", "audience must be a string, iterable or None".to_string())),
    }
    // for claim in options["require"]
    let require = j_get_or_null(options, "require");
    let mut claims: Vec[J] = Vec.new();
    match require {
        J.Arr(items) => claims = items.clone(),
        J.Str(text) => {
            for c in text.chars() {
                let mut one = String.new();
                one.push(c);
                claims.push(J.Str(one));
            }
        }
        J.Obj(members) => {
            for m in members.iter() {
                claims.push(J.Str(m.key.clone()));
            }
        }
        _ => {}
    }
    for c in claims.iter() {
        let present = match c {
            J.Str(name) => match j_get(payload, name.as_str()) {
                Some(v) => not is_null(v),
                None => false,
            },
            _ => false,
        };
        if not present {
            return Err(missing_claim(py_str(c)));
        }
    }
    if j_has(payload, "iat") and truthy(j_get_or_null(options, "verify_iat")) {
        let iat = int_claim(payload, "iat", "InvalidIssuedAtError", "Issued At claim (iat) must be an integer.")?;
        if cmp_int_float(iat, now + a.leeway) > 0 {
            return Err(exc("ImmatureSignatureError", "The token is not yet valid (iat)".to_string()));
        }
    }
    if j_has(payload, "nbf") and truthy(j_get_or_null(options, "verify_nbf")) {
        let nbf = int_claim(payload, "nbf", "DecodeError", "Not Before claim (nbf) must be an integer.")?;
        if cmp_int_float(nbf, now + a.leeway) > 0 {
            return Err(exc("ImmatureSignatureError", "The token is not yet valid (nbf)".to_string()));
        }
    }
    if j_has(payload, "exp") and truthy(j_get_or_null(options, "verify_exp")) {
        let exp = int_claim(payload, "exp", "DecodeError", "Expiration Time claim (exp) must be an integer.")?;
        if cmp_int_float(exp, now - a.leeway) <= 0 {
            return Err(exc("ExpiredSignatureError", "Signature has expired".to_string()));
        }
    }
    if truthy(j_get_or_null(options, "verify_iss")) {
        validate_iss(payload, a.issuer)?;
    }
    if truthy(j_get_or_null(options, "verify_aud")) {
        validate_aud(payload, a.audience, truthy(j_get_or_null(options, "strict_aud")))?;
    }
    if truthy(j_get_or_null(options, "verify_sub")) {
        if let Some(sub) = j_get(payload, "sub") {
            if not is_str(sub) {
                return Err(exc("InvalidSubjectError", "Subject must be a string".to_string()));
            }
            if not is_null(a.subject) and not py_eq(sub, a.subject) {
                return Err(exc("InvalidSubjectError", "Invalid subject".to_string()));
            }
        }
    }
    if truthy(j_get_or_null(options, "verify_jti")) {
        if let Some(jti) = j_get(payload, "jti") {
            if not is_str(jti) {
                return Err(exc("InvalidJTIError", "JWT ID must be a string".to_string()));
            }
        }
    }
    Ok(())
}

fn bad_aud(msg: Str) -> Exc {
    exc("InvalidAudienceError", msg.to_string())
}

fn validate_aud(payload: ref J, audience: ref J, strict: bool) -> Result[(), Exc] {
    let claim = j_get_or_null(payload, "aud");
    if is_null(audience) {
        if not truthy(claim) {
            return Ok(());
        }
        return Err(bad_aud("Invalid audience"));
    }
    if not truthy(claim) {
        return Err(missing_claim("aud".to_string()));
    }
    if strict {
        if not is_str(audience) {
            return Err(bad_aud("Invalid audience (strict)"));
        }
        if not is_str(claim) {
            return Err(bad_aud("Invalid claim format in token (strict)"));
        }
        if not py_eq(audience, claim) {
            return Err(bad_aud("Audience doesn't match (strict)"));
        }
        return Ok(());
    }
    let claims = match claim {
        J.Str(_) => one_item(claim),
        J.Arr(items) => items.clone(),
        _ => return Err(bad_aud("Invalid claim format in token")),
    };
    for c in claims.iter() {
        if not is_str(c) {
            return Err(bad_aud("Invalid claim format in token"));
        }
    }
    let wanted: Vec[J] = match audience {
        J.Str(_) => one_item(audience),
        J.Arr(items) => items.clone(),
        J.Obj(members) => {
            let mut keys: Vec[J] = Vec.new();
            for m in members.iter() {
                keys.push(J.Str(m.key.clone()));
            }
            keys
        }
        _ => Vec.new(),
    };
    let list = J.Arr(claims);
    for w in wanted.iter() {
        if contains(list, w)? {
            return Ok(());
        }
    }
    Err(bad_aud("Audience doesn't match"))
}

fn validate_iss(payload: ref J, issuer: ref J) -> Result[(), Exc] {
    if is_null(issuer) {
        return Ok(());
    }
    let iss = match j_get(payload, "iss") {
        Some(v) => v,
        None => return Err(missing_claim("iss".to_string())),
    };
    let ok = if is_str(issuer) { py_eq(iss, issuer) } else { contains(issuer, iss)? };
    if not ok {
        return Err(exc("InvalidIssuerError", "Invalid issuer".to_string()));
    }
    Ok(())
}

fn one_item(v: ref J) -> Vec[J] {
    let mut out: Vec[J] = Vec.new();
    out.push(v.clone());
    out
}

// ------------------------------------------------------------ job values

fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = if y >= 0 { y } else { y - 399 } / 400;
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn int_at(items: ref Vec[J], i: i64) -> i64 {
    if i < items.len() {
        if let J.Int(d) = items[i] {
            return i64.parse(d).unwrap_or(0);
        }
    }
    0
}

// timegm(dt.utctimetuple()) for [y, mo, d, h, mi, s, us, offset minutes]:
// the microseconds are dropped.
fn timegm_of(items: ref Vec[J], aware: bool) -> i64 {
    let days = days_from_civil(int_at(items, 0), int_at(items, 1), int_at(items, 2));
    let mut t = days * 86400 + int_at(items, 3) * 3600 + int_at(items, 4) * 60 + int_at(items, 5);
    if aware and items.len() > 7 {
        t -= int_at(items, 7) * 60;
    }
    t
}

fn num(v: ref J) -> f64 {
    num_of(v).unwrap_or(0.0)
}

// A dict with one "$" key stands for a Python value JSON has no form for.
// Datetimes only appear as the exp, iat and nbf claims, which PyJWT turns
// into seconds, so they are those seconds here.
fn conv(v: ref J) -> J {
    match v {
        J.Obj(members) => {
            if members.len() == 1 {
                let m = ref members[0];
                if let J.Arr(items) = m.val {
                    if m.key == "$dt" {
                        return J.Int(f"{timegm_of(items, true)}");
                    }
                    if m.key == "$naive" {
                        return J.Int(f"{timegm_of(items, false)}");
                    }
                }
                if m.key == "$td" {
                    return J.Float(num(m.val));
                }
            }
            let mut out: Vec[Member] = Vec.new();
            for m in members.iter() {
                out.push(Member { key: m.key.clone(), val: conv(m.val) });
            }
            J.Obj(out)
        }
        J.Arr(items) => {
            let mut out: Vec[J] = Vec.new();
            for it in items.iter() {
                out.push(conv(it));
            }
            J.Arr(out)
        }
        _ => v.clone(),
    }
}

fn key_of(v: ref J) -> Result[Key, Exc] {
    if let Some(h) = j_get(v, "$bytes") {
        return Ok(Key.Bytes(unhex(py_str(h))));
    }
    if let Some(d) = j_get(v, "$jwk") {
        let alg = j_get_or_null(v, "$alg");
        return Ok(Key.Jwk(new_jwk(conv(d), alg)?));
    }
    match v {
        J.Str(t) => Ok(Key.Text(t.clone())),
        _ => Ok(Key.Other(conv(v))),
    }
}

struct Job {
    tokens: Vec[String],
    now: f64,
}

fn token_of(job: ref Job, spec: ref J) -> Token {
    if let Some(r) = j_get(spec, "ref") {
        let mut t = job.tokens[num(r) as i64].clone();
        if let Some(seg) = j_get(spec, "seg") {
            let mut parts: Vec[String] = Vec.new();
            for p in t.split(".") {
                parts.push(p.to_string());
            }
            parts[num(seg) as i64] = py_str(j_get_or_null(spec, "value"));
            t = join(parts, ".");
        }
        if let Some(extra) = j_get(spec, "append") {
            t = f"{t}{py_str(extra)}";
        }
        return Token.Text(t);
    }
    if let Some(h) = j_get(spec, "$bytes") {
        return Token.Bytes(unhex(py_str(h)));
    }
    match spec {
        J.Str(t) => Token.Text(t.clone()),
        _ => Token.Other(spec.clone()),
    }
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn jws_of(op: ref J) -> PyJWS {
    if let Some(J.Arr(items)) = j_get(op, "allowed") {
        let mut valid: Vec[String] = Vec.new();
        for it in items.iter() {
            let n = py_str(it);
            if not valid.contains(n) {
                valid.push(n);
            }
        }
        return PyJWS { valid: valid };
    }
    default_jws()
}

fn opt(op: ref J, name: Str) -> J {
    conv(j_get_or_null(op, name))
}

fn decode_args(op: ref J) -> DecodeArgs {
    let mut a = no_args();
    a.algorithms = opt(op, "algorithms");
    a.options = opt(op, "options");
    a.audience = opt(op, "audience");
    a.issuer = opt(op, "issuer");
    a.subject = opt(op, "subject");
    a.leeway = num(opt(op, "leeway"));
    if let Some(d) = j_get(op, "detached") {
        a.detached = Some(str_bytes(py_str(d)));
    }
    a
}

fn decode_key(op: ref J) -> Result[Key, Exc] {
    match j_get(op, "key") {
        Some(k) => key_of(k),
        None => Ok(Key.Text(String.new())),
    }
}

fn sort_headers_of(op: ref J) -> bool {
    match j_get(op, "sort_headers") {
        Some(v) => truthy(v),
        None => true,
    }
}

fn print_err(e: ref Exc) {
    println(f"  error: {failure(e)}");
}

fn op_encode(job: mut ref Job, op: ref J) -> Result[(), Exc] {
    let key = key_of(j_get_or_null(op, "key"))?;
    match jwt_encode(opt(op, "payload"), key, opt(op, "algorithm"), opt(op, "headers"), sort_headers_of(op)) {
        Ok(t) => {
            println(f"  token: {t}");
            job.tokens.push(t);
        }
        Err(e) => print_err(e),
    }
    Ok(())
}

fn op_decode(job: ref Job, op: ref J) -> Result[(), Exc] {
    let key = decode_key(op)?;
    let a = decode_args(op);
    let dec = new_decoder(opt(op, "instance"));
    let token = token_of(job, j_get_or_null(op, "token"));
    if truthy(j_get_or_null(op, "complete")) {
        match dec.decode_complete(token, key, a, job.now) {
            Ok((h, p, sig)) => {
                println(f"  header: {repr(h)}");
                println(f"  payload: {repr(p)}");
                println(f"  signature: {hex_of(sig)}");
            }
            Err(e) => print_err(e),
        }
    } else {
        match dec.decode(token, key, a, job.now) {
            Ok(p) => println(f"  payload: {repr(p)}"),
            Err(e) => print_err(e),
        }
    }
    Ok(())
}

fn op_jws_encode(job: mut ref Job, op: ref J) -> Result[(), Exc] {
    let key = key_of(j_get_or_null(op, "key"))?;
    let payload = str_bytes(py_str(j_get_or_null(op, "payload")));
    let detached = truthy(j_get_or_null(op, "detached"));
    match jws_encode(jws_of(op), payload, key, opt(op, "algorithm"), opt(op, "headers"), detached, sort_headers_of(op)) {
        Ok(t) => {
            println(f"  token: {t}");
            job.tokens.push(t);
        }
        Err(e) => print_err(e),
    }
    Ok(())
}

fn op_jws_decode(job: ref Job, op: ref J) -> Result[(), Exc] {
    let key = decode_key(op)?;
    let a = decode_args(op);
    let options = if is_dict(a.options) { a.options.clone() } else { J.Obj(Vec.new()) };
    let token = token_of(job, j_get_or_null(op, "token"));
    match jws_decode_complete(jws_of(op), token, key, a.algorithms, options, a.detached) {
        Ok(d) => {
            println(f"  header: {repr(d.header)}");
            println(f"  payload: {bytes_repr(d.payload)}");
        }
        Err(e) => print_err(e),
    }
    Ok(())
}

fn op_algorithms(op: ref J) {
    let w = jws_of(op);
    let mut names = w.valid.clone();
    names.sort();
    let mut shown: Vec[J] = Vec.new();
    for n in names.iter() {
        shown.push(J.Str(n.clone()));
    }
    println(f"  algorithms: {repr(J.Arr(shown))}");
    if let J.Arr(items) = j_get_or_null(op, "names") {
        for name in items.iter() {
            match w.algorithm_by_name(name) {
                Ok(a) => println(f"  {repr(name)}: {alg_class(a)}"),
                Err(e) => println(f"  {repr(name)}: {failure(e)}"),
            }
        }
    }
}

fn op_jwk(op: ref J) {
    let data = j_get_or_null(op, "data");
    let alg = j_get_or_null(op, "algorithm");
    let made = match data {
        J.Str(text) => jwk_from_json(text, alg),
        _ => new_jwk(conv(data), alg),
    };
    match made {
        Ok(k) => println(f"  alg={k.algorithm_name} kty={repr(k.key_type())} kid={repr(k.key_id())} use={repr(k.public_key_use())} {alg_class(k.alg)} key={bytes_repr(k.key)}"),
        Err(e) => print_err(e),
    }
}

fn op_jwks(op: ref J) {
    let data = j_get_or_null(op, "data");
    let made = match data {
        J.Str(text) => jwk_set_from_json(text),
        _ => jwk_set_from_dict(conv(data)),
    };
    let ks = match made {
        Ok(ks) => ks,
        Err(e) => {
            print_err(e);
            return;
        }
    };
    let mut ids: Vec[J] = Vec.new();
    for k in ks.keys.iter() {
        ids.push(k.key_id());
    }
    println(f"  keys: {repr(J.Arr(ids))}");
    if let J.Arr(kids) = j_get_or_null(op, "kids") {
        for kid in kids.iter() {
            match ks.find(kid) {
                Ok(k) => println(f"  {repr(kid)}: {k.algorithm_name} {bytes_repr(k.key)}"),
                Err(e) => println(f"  {repr(kid)}: {failure(e)}"),
            }
        }
    }
}

fn op_to_jwk(op: ref J) -> Result[(), Exc] {
    let key = key_of(j_get_or_null(op, "key"))?;
    match hmac_to_jwk(key, truthy(j_get_or_null(op, "as_dict"))) {
        Ok(text) => println(f"  jwk: {text}"),
        Err(e) => print_err(e),
    }
    Ok(())
}

fn op_from_jwk(op: ref J) {
    match hmac_from_jwk(opt(op, "jwk")) {
        Ok(k) => println(f"  key: {bytes_repr(k)}"),
        Err(e) => print_err(e),
    }
}

fn op_b64(op: ref J) {
    if let J.Arr(items) = j_get_or_null(op, "decode") {
        for it in items.iter() {
            let text = py_str(it);
            match base64url_decode(str_bytes(text)) {
                Ok(b) => println(f"  {str_repr(text)} -> {hex_of(b)}"),
                Err(e) => println(f"  {str_repr(text)} -> {failure(e)}"),
            }
        }
    }
    if let J.Arr(items) = j_get_or_null(op, "encode") {
        for it in items.iter() {
            let h = py_str(it);
            println(f"  {h} -> {base64url_encode(unhex(h))}");
        }
    }
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn op_keys(op: ref J) -> Result[(), Exc] {
    let alg = Alg.Hmac(256);
    if let J.Arr(items) = j_get_or_null(op, "keys") {
        for it in items.iter() {
            let key = key_of(it)?;
            let verdict = match prepare_key(alg, key) {
                Ok(_) => "ok".to_string(),
                Err(e) => failure(e),
            };
            match force_bytes(key) {
                Ok(b) => println(f"  pem={py_bool(is_pem_format(b))} ssh={py_bool(is_ssh_key(b))} {verdict}"),
                Err(_) => println(f"  {verdict}"),
            }
        }
    }
    Ok(())
}

fn run_op(job: mut ref Job, op: ref J) -> Result[(), Exc] {
    if let Some(n) = j_get(op, "now") {
        job.now = num(n);
    }
    let kind = py_str(j_get_or_null(op, "op"));
    if kind == "encode" {
        op_encode(mut job, op)?;
    } else if kind == "decode" {
        op_decode(job, op)?;
    } else if kind == "header" {
        match get_unverified_header(token_of(job, j_get_or_null(op, "token"))) {
            Ok(h) => println(f"  header: {repr(h)}"),
            Err(e) => print_err(e),
        }
    } else if kind == "jws_encode" {
        op_jws_encode(mut job, op)?;
    } else if kind == "jws_decode" {
        op_jws_decode(job, op)?;
    } else if kind == "algorithms" {
        op_algorithms(op);
    } else if kind == "jwk" {
        op_jwk(op);
    } else if kind == "jwks" {
        op_jwks(op);
    } else if kind == "to_jwk" {
        op_to_jwk(op)?;
    } else if kind == "from_jwk" {
        op_from_jwk(op);
    } else if kind == "b64" {
        op_b64(op);
    } else if kind == "keys" {
        op_keys(op)?;
    } else if kind == "gateway" {
        gateway(mut job, op)?;
    } else if kind == "issue" {
        issue(mut job, op)?;
    } else {
        return Err(exc("SystemExit", f"unknown op {kind}"));
    }
    Ok(())
}

// ------------------------------------------------------------ programs

fn read_text(path: ref String) -> Result[String, Exc] {
    match fs.read_to_string(path.clone()) {
        Ok(t) => Ok(t),
        Err(e) => Err(exc("OSError", f"{path}: {e}")),
    }
}

// The lines of a file, each without its newline, skipping empty ones.
fn text_lines(text: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for l in text.split("\n") {
        if l.len() > 0 {
            out.push(l.to_string());
        }
    }
    out
}

fn split_ws(text: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in text.split_whitespace() {
        out.push(w.to_string());
    }
    out
}

#[derive(Clone)]
struct Route {
    prefix: String,
    aud: String,
    scope: String,
}

struct Gateway {
    keyset: Option[PyJWKSet],
    routes: Vec[Route],
    issuer: J,
    leeway: f64,
}

// An API gateway: each request's bearer token is checked against the JWK
// set by its kid, then against the route's audience and scope.
fn gateway(job: mut ref Job, op: ref J) -> Result[(), Exc] {
    let base = f"data/{py_str(j_get_or_null(op, "dir"))}";
    let text = read_text(f"{base}/{py_str(j_get_or_null(op, "jwks"))}")?;
    let keyset = match jwk_set_from_json(text) {
        Ok(ks) => {
            println(f"  keyset: {ks.keys.len()} keys");
            Some(ks)
        }
        Err(e) => {
            println(f"  keyset: {failure(e)}");
            None
        }
    };
    let mut routes: Vec[Route] = Vec.new();
    for line in text_lines(read_text(f"{base}/routes.txt")?) {
        if line.trim().len() > 0 and not line.starts_with("#") {
            let w = split_ws(line);
            routes.push(Route { prefix: w[0].clone(), aud: w[1].clone(), scope: w[2].clone() });
        }
    }
    let gw = Gateway { keyset: keyset, routes: routes, issuer: j_get_or_null(op, "issuer"), leeway: num(j_get_or_null(op, "leeway")) };
    let mut statuses: Vec[(i64, i64)] = Vec.new();
    let mut callers: Vec[(String, i64)] = Vec.new();
    for line in text_lines(read_text(f"{base}/access.log")?) {
        let parts: Vec[Str] = line.split(" ").collect();
        let ts = parts[0].to_string();
        job.now = f64.parse(ts).unwrap_or(0.0);
        let (status, why) = handle(gw, parts[2].to_string(), parts[3].to_string(), job.now);
        println(f"  {ts} {parts[1]} {parts[2]} -> {status} {why}");
        bump_status(mut statuses, status);
        if status == 200 {
            bump_caller(mut callers, why);
        }
    }
    statuses.sort();
    callers.sort();
    let mut sp: Vec[String] = Vec.new();
    for (k, v) in statuses.iter() {
        sp.push(f"{k}={v}");
    }
    let mut cp: Vec[String] = Vec.new();
    for (k, v) in callers.iter() {
        cp.push(f"{k}={v}");
    }
    println(f"  statuses: {join(sp, ", ")}");
    println(f"  callers: {join(cp, ", ")}");
    Ok(())
}

fn bump_status(counts: mut ref Vec[(i64, i64)], status: i64) {
    for i in 0..counts.len() {
        if counts[i].0 == status {
            counts[i].1 += 1;
            return;
        }
    }
    counts.push((status, 1));
}

fn bump_caller(counts: mut ref Vec[(String, i64)], who: ref String) {
    for i in 0..counts.len() {
        if counts[i].0 == *who {
            counts[i].1 += 1;
            return;
        }
    }
    counts.push((who.clone(), 1));
}

fn handle(gw: ref Gateway, path: ref String, token: ref String, now: f64) -> (i64, String) {
    let mut best: Option[Route] = None;
    for r in gw.routes.iter() {
        if path.starts_with(r.prefix.as_str()) {
            let longer = match ref best {
                Some(b) => r.prefix.len() > b.prefix.len(),
                None => true,
            };
            if longer {
                best = Some(r.clone());
            }
        }
    }
    let route = match best {
        Some(r) => r,
        None => return (404, "no route".to_string()),
    };
    if token == "-" {
        if route.aud == "-" and route.scope == "-" {
            return (200, "anonymous".to_string());
        }
        return (401, "missing token".to_string());
    }
    let keyset = match gw.keyset {
        Some(ks) => ks.clone(),
        None => return (503, "no keys".to_string()),
    };
    let tok = Token.Text(token.clone());
    let header = match get_unverified_header(tok) {
        Ok(h) => h,
        Err(e) => return (401, failure(e)),
    };
    let kid = j_get_or_null(header, "kid");
    if is_null(kid) {
        return (401, "no kid".to_string());
    }
    let key = match keyset.find(kid) {
        Ok(k) => k,
        Err(_) => return (401, f"unknown kid {py_str(kid)}"),
    };
    let usage = key.public_key_use();
    if not is_null(usage) and not eq_str(usage, "sig") {
        return (401, f"key {py_str(kid)} is for {py_str(usage)}");
    }
    let mut a = no_args();
    a.audience = if route.aud == "-" { J.Null } else { J.Str(route.aud.clone()) };
    a.issuer = gw.issuer.clone();
    a.leeway = gw.leeway;
    let mut options = J.Obj(Vec.new());
    let mut req: Vec[J] = Vec.new();
    req.push(jstr("exp"));
    req.push(jstr("sub"));
    j_set(mut options, "require", J.Arr(req));
    a.options = options;
    let payload = match new_decoder(J.Null).decode(tok, Key.Jwk(key), a, now) {
        Ok(p) => p,
        Err(e) => return (401, failure(e)),
    };
    let scope = match j_get(payload, "scope") {
        Some(v) => v,
        None => jstr(""),
    };
    let scopes = match scope {
        J.Str(text) => split_ws(text),
        _ => return (403, "scope is not a string".to_string()),
    };
    if route.scope != "-" and not scopes.contains(route.scope) {
        return (403, f"needs {route.scope}");
    }
    (200, py_str(j_get_or_null(payload, "sub")))
}

// A token issuer: one token per user in users.csv, written to a file,
// read back and checked at several times.
fn issue(job: mut ref Job, op: ref J) -> Result[(), Exc] {
    let base = f"data/{py_str(j_get_or_null(op, "dir"))}";
    let secret_text = match fs.read_bytes(f"{base}/secret.key") {
        Ok(b) => b,
        Err(e) => return Err(exc("OSError", f"{e}")),
    };
    let mut secret = secret_text.clone();
    while secret.len() > 0 and secret[secret.len() - 1] == 10 {
        secret.pop();
    }
    let start = num(j_get_or_null(op, "now"));
    job.now = start;
    let now = start as i64;
    let issuer = j_get_or_null(op, "issuer");
    let mut headers = J.Obj(Vec.new());
    j_set(mut headers, "kid", j_get_or_null(op, "kid"));
    let mut out = String.new();
    let rows = text_lines(read_text(f"{base}/users.csv")?);
    for r in 1..rows.len() {
        let f: Vec[Str] = rows[r].split(",").collect();
        let user = f[0].to_string();
        let roles = f[1].to_string();
        let ttl = i64.parse(f[2]).unwrap_or(0);
        let aud = f[3].to_string();
        let mut payload = J.Obj(Vec.new());
        j_set(mut payload, "sub", J.Str(user.clone()));
        j_set(mut payload, "iss", issuer.clone());
        j_set(mut payload, "iat", J.Int(f"{now}"));
        j_set(mut payload, "nbf", J.Int(f"{now}"));
        j_set(mut payload, "exp", J.Int(f"{now + ttl}"));
        j_set(mut payload, "roles", split_bar(roles));
        if aud.len() > 0 {
            j_set(mut payload, "aud", if aud.contains("|") { split_bar(aud) } else { J.Str(aud.clone()) });
        }
        match jwt_encode(payload, Key.Bytes(secret.clone()), jstr(f[4]), headers, true) {
            Ok(t) => out.push_str(f"{user} {t}\n"),
            Err(e) => println(f"  {user}: {failure(e)}"),
        }
    }
    if let Err(e) = fs.create_dir_all(f"{base}/out") {
        return Err(exc("OSError", f"{e}"));
    }
    if let Err(e) = fs.write(f"{base}/out/tokens.txt", out) {
        return Err(exc("OSError", f"{e}"));
    }
    let mut issued: Vec[(String, String)] = Vec.new();
    for line in text_lines(read_text(f"{base}/out/tokens.txt")?) {
        let w = split_ws(line);
        issued.push((w[0].clone(), w[1].clone()));
    }
    println(f"  issued {issued.len()} tokens");
    let mut algs: Vec[J] = Vec.new();
    for n in ["HS256", "HS384", "HS512"] {
        algs.push(jstr(n));
    }
    if let J.Arr(checks) = j_get_or_null(op, "checks") {
        for at in checks.iter() {
            job.now = start + num(at);
            for (user, t) in issued.iter() {
                let mut a = no_args();
                a.algorithms = J.Arr(algs.clone());
                a.audience = j_get_or_null(op, "audience");
                a.issuer = issuer.clone();
                match new_decoder(J.Null).decode(Token.Text(t.clone()), Key.Bytes(secret.clone()), a, job.now) {
                    Ok(p) => println(f"  +{repr(at)} {user}: ok roles={repr(j_get_or_null(p, "roles"))}"),
                    Err(e) => println(f"  +{repr(at)} {user}: {failure(e)}"),
                }
            }
        }
    }
    Ok(())
}

fn split_bar(text: ref String) -> J {
    let mut items: Vec[J] = Vec.new();
    if text.len() > 0 {
        for p in text.split("|") {
            items.push(J.Str(p.to_string()));
        }
    }
    J.Arr(items)
}

fn run() -> Result[(), String] {
    let text = match fs.read_to_string("data/jobs.jsonl") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.jsonl: {e}"),
    };
    let mut job = Job { tokens: Vec.new(), now: 0.0 };
    for line in text_lines(text) {
        let spec = match loads_str(line) {
            Ok(v) => v,
            Err(e) => return Err(failure(e)),
        };
        println(f"== {py_str(j_get_or_null(spec, "name"))}");
        job.tokens = Vec.new();
        if let J.Arr(ops) = j_get_or_null(spec, "ops") {
            for op in ops.iter() {
                if let Err(e) = run_op(mut job, op) {
                    return Err(failure(e));
                }
            }
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}


// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("1761048025 GET /health -\n");
