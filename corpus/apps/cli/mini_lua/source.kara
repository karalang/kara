    """
-- tables as arrays, records, sets and matrices
local t = {10, 20, 30, x = 1, ["y z"] = 2, [100] = "hundred"}
print(#t, t[1], t.x, t["y z"], t[100], t[4])
t[#t + 1] = 40
table.insert(t, 50)
