fn oop_lua() -> String {
    """
-- classes with metatables
local Account = {}
Account.__index = Account

function Account.new(owner, balance)
  local self = setmetatable({}, Account)
  self.owner = owner
  self.balance = balance or 0
  return self
end

function Account:deposit(v)
  self.balance = self.balance + v
  return self
end

function Account:withdraw(v)
  if v > self.balance then
    error("insufficient funds")
  end
  self.balance = self.balance - v
end

Account.__tostring = function(a)
  return "Account(" .. a.owner .. ", " .. a.balance .. ")"
end

local acc = Account.new("ada", 100)
acc:deposit(50):deposit(25)
print(acc.balance, tostring(acc))
print(acc)
local ok, err = pcall(acc.withdraw, acc, 1000)
print(ok, err)
acc:withdraw(75)
print(acc.balance)

local Savings = setmetatable({}, {__index = Account})
Savings.__index = Savings
Savings.__tostring = Account.__tostring

function Savings.new(owner, balance, rate)
  local self = Account.new(owner, balance)
  self.rate = rate
  return setmetatable(self, Savings)
end

function Savings:interest()
  return self.balance * self.rate
end

local s = Savings.new("grace", 1000, 0.05)
s:deposit(200)
print(s.balance, s:interest(), tostring(s), getmetatable(s) == Savings)
print(rawget(s, "deposit"), s.deposit == Account.deposit)

local Stack = {}
Stack.__index = Stack
function Stack.new() return setmetatable({items = {}, size = 0}, Stack) end
function Stack:push(v) self.size = self.size + 1; self.items[self.size] = v end
function Stack:pop()
  if self.size == 0 then return nil end
  local v = self.items[self.size]
  self.items[self.size] = nil
  self.size = self.size - 1
  return v
end
local st = Stack.new()
for _, w in ipairs({"a", "b", "c"}) do st:push(w) end
print(st:pop(), st:pop(), st.size, st:pop(), st:pop())

local defaults = setmetatable({}, {__index = function(t, k) return k .. "?" end})
defaults.known = "yes"
print(defaults.known, defaults.missing)

local Vec = {}
Vec.__index = Vec
local function vec(x, y) return setmetatable({x = x, y = y}, Vec) end
Vec.__add = function(a, b) return vec(a.x + b.x, a.y + b.y) end
Vec.__eq = function(a, b) return a.x == b.x and a.y == b.y end
Vec.__tostring = function(v) return "(" .. v.x .. ", " .. v.y .. ")" end
Vec.__lt = function(a, b) return a.x < b.x end
local p = vec(1, 2) + vec(3, 4)
print(tostring(p), p == vec(4, 6), p == vec(0, 0), vec(1, 0) < vec(2, 0))

"""
}

fn strings_lua() -> String {
    """
-- Lua patterns
print(("hello world"):find("wor"), ("hello"):find("l"), ("hello"):find("xyz"))
print(("a.b.c"):find(".", 1, true), ("a.b.c"):find("%."), ("abc"):find("b", 3))
print(("key = value"):match("(%w+)%s*=%s*(%w+)"))
print(("2026-10-15"):match("(%d+)-(%d+)-(%d+)"))
print(("  padded  "):match("^%s*(.-)%s*$") .. "|")
print(("[tag]"):match("%[(.*)%]"), ("x=1, y=22, z=333"):match("y=(%d+)"))
print(("hello"):match(".-(l+)(.*)"))
local parts = {}
for k, v in ("a=1, b=2, c=3"):gmatch("(%w+)=(%w+)") do parts[#parts + 1] = k .. ":" .. v end
print(table.concat(parts, " "))
local words = {}
for w in ("The rain in Spain stays mainly"):gmatch("%a+") do words[#words + 1] = w:lower() end
print(#words, table.concat(words, ","))
print(("hello world"):gsub("o", "0"))
print(("hello world"):gsub("(%w+)", "<%1>"))
print(("hello world"):gsub("%w+", function(w) return w:upper() end, 1))
print(("$name is $age"):gsub("%$(%w+)", {name = "Ada", age = 36}))
print(("abc"):gsub("", "-"))
print(("one two  three"):gsub("%s+", " "))
print(("x1y22z333"):gsub("%d+", function(d) return "[" .. #d .. "]" end))
print(("CamelCaseString"):gsub("(%u)", " %1"))
print(("trim me   "):gsub("%s+$", ""))
print(("a,b,,c"):find(",,"), ("%d"):gsub("%%", "pct"))
print(string.rep("ab", 3, "-"), ("abc"):reverse(), ("x"):byte(), ("ABC"):byte(2))
print(("hello"):sub(2), ("hello"):sub(10), ("hello"):sub(0), ("hello"):sub(-100, 2))
print(("f(a,b)"):match("^(%w+)%((.-)%)$"))
print(("192.168.1.20"):match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$"))
print(("path/to/file.txt"):match("([^/]+)$"), ("path/to/file.txt"):match("^(.*)/"))
print(("file.tar.gz"):match("^(.-)%.(.*)$"))
print(("  x  "):len(), ("%5.1f"):format(3.14159), ("<%s>"):format("fmt"))

"""
}

fn errors_lua() -> String {
    """
-- errors and pcall
local function risky(n)
  if n > 2 then
    error("too big: " .. n)
  end
  return n * 2
end
print(pcall(risky, 1))
print(pcall(risky, 5))
print(pcall(error, "plain", 0))
local ok, e = pcall(error, {code = 42})
print(ok, type(e), e.code)
print(pcall(function() error("level two", 2) end))
local function outer()
  local function inner() error("deep") end
  inner()
end
print(pcall(outer))
print(pcall(assert, false, "assertion text"))
print(pcall(assert, 1 == 1, "never"))
print(select("#", pcall(assert, nil)))
local ok2, msg = pcall(function()
  local ok3, inner = pcall(error, "first")
  error("second after " .. inner, 0)
end)
print(ok2, msg)
local results = {}
for i = 1, 4 do
  local ok4, v = pcall(risky, i)
  results[#results + 1] = ok4 and tostring(v) or "fail"
end
print(table.concat(results, " "))
local function retry(times, f)
  local last
  for attempt = 1, times do
    local ok5, v = pcall(f, attempt)
    if ok5 then return v, attempt end
    last = v
  end
  return nil, last
end
print(retry(3, function(n) if n < 3 then error("not yet", 0) end return "done" end))
print(retry(2, function(n) error("never " .. n, 0) end))

"""
}

fn logs_lua() -> String {
    """
-- an access-log report: parse each line with a pattern, aggregate, rank
local pattern = '^(%S+) %S+ %S+ %[([^%]]+)%] "(%u+) (%S+) [^"]*" (%d+) (%d+) (%d+)ms "([^"]*)"$'
local by_status, by_path, by_ip = {}, {}, {}
local bytes, slow, total, bad = 0, {}, 0, 0
for line in io.lines("data/access.log") do
  local ip, when, method, path, status, size, ms, agent = line:match(pattern)
  if not ip then
    bad = bad + 1
  else
    total = total + 1
    status = tonumber(status)
    by_status[status] = (by_status[status] or 0) + 1
    path = path:gsub("%?.*$", "")
    local p = by_path[path] or {hits = 0, ms = 0, errors = 0}
    p.hits = p.hits + 1
    p.ms = p.ms + tonumber(ms)
    if status >= 500 then p.errors = p.errors + 1 end
    by_path[path] = p
    by_ip[ip] = (by_ip[ip] or 0) + 1
    bytes = bytes + tonumber(size)
    if tonumber(ms) >= 800 then
      slow[#slow + 1] = string.format("%s %s %s %dms", when:match(":(%d+:%d+:%d+)"), method, path, ms)
    end
  end
end
print(string.format("%d requests, %d unparsed, %.1f KiB sent", total, bad, bytes / 1024))
local codes = {}
for code in pairs(by_status) do codes[#codes + 1] = code end
table.sort(codes)
for _, code in ipairs(codes) do
  print(string.format("  %d %3d %5.1f%%", code, by_status[code], 100 * by_status[code] / total))
end
local paths = {}
for path, p in pairs(by_path) do paths[#paths + 1] = {path = path, p = p} end
table.sort(paths, function(a, b)
  if a.p.hits ~= b.p.hits then return a.p.hits > b.p.hits end
  return a.path < b.path
end)
print("top paths:")
for i = 1, 5 do
  local e = paths[i]
  print(string.format("  %-18s %3d hits  avg %6.1fms  %d errors", e.path, e.p.hits, e.p.ms / e.p.hits, e.p.errors))
end
local ips = {}
for ip, n in pairs(by_ip) do ips[#ips + 1] = ip end
table.sort(ips, function(a, b) return by_ip[a] > by_ip[b] or (by_ip[a] == by_ip[b] and a < b) end)
io.write("clients:")
for _, ip in ipairs(ips) do io.write(" ", ip, "=", by_ip[ip]) end
print()
print("slow requests (" .. #slow .. "):")
for i = 1, math.min(4, #slow) do print("  " .. slow[i]) end
local out = io.open("report.txt", "w")
out:write("total=", total, "\\n", "bytes=", bytes, "\\n")
out:close()
local back = {}
for l in io.lines("report.txt") do back[#back + 1] = l end
print("report.txt: " .. table.concat(back, ";"))

"""
}

