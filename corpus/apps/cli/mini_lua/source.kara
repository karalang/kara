fn main() {
    let names: Array[Str, 7] = ["basics", "closures", "tables", "oop", "strings", "errors", "logs"];
    let texts: Array[String, 7] = [basics_lua(), closures_lua(), tables_lua(), oop_lua(), strings_lua(), errors_lua(), logs_lua()];
    for dir in ["scripts", "data"] {
        if let Err(e) = fs.create_dir_all(dir.to_string()) {
            println(f"cannot create {dir}: {e}");
            return;
        }
    }
    for i in 0..7 {
        fs.write(f"scripts/{names[i]}.lua", texts[i].clone()).unwrap();
    }
    fs.write("data/access.log".to_string(), access_log()).unwrap();
    for i in 0..7 {
        let path = f"scripts/{names[i]}.lua";
        println(f"== {path}");
        run_file(path);
    }
    let _ = fs.remove_file("report.txt".to_string());
}
