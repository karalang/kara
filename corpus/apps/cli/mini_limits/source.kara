// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
        // and the set takes in the extra cases of each letter in it
        if not hit and not ascii {
            for x in extra_cases(lo).iter() {
                let xu = upper(*x, ascii);
                if in_items(set, *x, ascii) or (lower(xu, ascii) == *x and in_items(set, xu, ascii)) {
                    hit = true;
                }
            }
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = *g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if *g == 0 { (m.start, m.end) } else { m.spans[*g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}


// --------------------------------------------------- Unicode strings


// ------------------------------------------------------------ urllib.parse

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn u_is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or u_is_alpha(c)
}

// A word character, as `\w` and `\b` see it.
fn u_is_word(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c >= 128
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn u_lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}


// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn contains_str(v: ref Vec[String], s: Str) -> bool {
    for i in 0..v.len() {
        if v[i] == s {
            return true;
        }
    }
    false
}

// A stable sort of strings.
fn sort_strings(v: own Vec[String]) -> Vec[String] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}


fn u_upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn byte_at(s: Str, i: i64) -> u8 {
    let b = to_bytes(s);
    if i >= 0 and i < b.len() { b[i] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn spaces(n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(" ");
    }
    out
}


// ------------------------------------------------------------ more text

fn u_is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn u_slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (u_slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (u_slice(s, 0, i), true, slice_from(s, i + 1))
}

fn replace_byte(s: Str, c: u8, with: Str) -> String {
    let b = to_bytes(s);
    let w = to_bytes(with);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if b[i] == c {
            for k in 0..w.len() {
                out.push(w[k]);
            }
        } else {
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

fn opt_repr(v: ref Option[String]) -> String {
    match v {
        Some(s) => py_repr(s),
        None => "None".to_string(),
    }
}

// The data files spell tabs, line ends and control characters as \t,
// \n, \r and \xNN.
fn unescape(line: Str) -> String {
    let b = to_bytes(line);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'\\' and i + 1 < b.len() {
            let n = b[i + 1];
            if n == b't' {
                out.push(b'\t');
                i += 2;
                continue;
            }
            if n == b'n' {
                out.push(b'\n');
                i += 2;
                continue;
            }
            if n == b'r' {
                out.push(b'\r');
                i += 2;
                continue;
            }
            if n == b'\\' {
                out.push(b'\\');
                i += 2;
                continue;
            }
            if n == b'x' and i + 3 < b.len() {
                out.push(hex_val(b[i + 2]) * 16 + hex_val(b[i + 3]));
                i += 4;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    from_bytes(out)
}

fn push_str_bytes(out: mut ref Vec[u8], s: Str) {
    let b = to_bytes(s);
    for i in 0..b.len() {
        out.push(b[i]);
    }
}

// bytes.decode('utf-8', 'replace'): each maximal ill-formed subpart
// becomes one U+FFFD, as CPython's decoder does it.
fn utf8_replace(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c < 0x80 {
            out.push(c);
            i += 1;
            continue;
        }
        let mut need: i64 = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c >= 0xC2 and c <= 0xDF {
            need = 1;
        } else if c >= 0xE0 and c <= 0xEF {
            need = 2;
            if c == 0xE0 {
                lo = 0xA0;
            }
            if c == 0xED {
                hi = 0x9F;
            }
        } else if c >= 0xF0 and c <= 0xF4 {
            need = 3;
            if c == 0xF0 {
                lo = 0x90;
            }
            if c == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            push_str_bytes(mut out, "\u{FFFD}");
            i += 1;
            continue;
        }
        let mut j = i + 1;
        let mut ok = true;
        for k in 0..need {
            if j >= b.len() {
                ok = false;
                break;
            }
            let d = b[j];
            let (l, h) = if k == 0 { (lo, hi) } else { (0x80 as u8, 0xBF as u8) };
            if d < l or d > h {
                ok = false;
                break;
            }
            j += 1;
        }
        if ok {
            for k in i..j {
                out.push(b[k]);
            }
        } else {
            push_str_bytes(mut out, "\u{FFFD}");
        }
        i = j;
    }
    from_bytes(out)
}

// A stable sort of (name, count) pairs: the highest count first, then
// by name.
fn sort_counts(names: ref Vec[String], counts: ref Vec[i64]) -> Vec[i64] {
    let mut order: Vec[i64] = Vec.new();
    for i in 0..names.len() {
        order.push(i);
    }
    for i in 1..order.len() {
        let mut j = i;
        while j > 0 {
            let a = order[j - 1];
            let b = order[j];
            let after = counts[a] < counts[b] or (counts[a] == counts[b] and names[a] > names[b]);
            if not after {
                break;
            }
            order.swap(j - 1, j);
            j -= 1;
        }
    }
    order
}

fn bump(names: mut ref Vec[String], counts: mut ref Vec[i64], name: Str) {
    for i in 0..names.len() {
        if names[i] == name {
            counts[i] += 1;
            return;
        }
    }
    names.push(name.to_string());
    counts.push(1);
}

// ------------------------------------------------------------ ipaddress

// IPv4Address's parser: four decimal octets, no leading zeros.
fn is_ipv4(s: Str) -> bool {
    let parts = split_on(s, b'.');
    if parts.len() != 4 {
        return false;
    }
    for i in 0..parts.len() {
        let b = to_bytes(parts[i]);
        if b.len() == 0 or b.len() > 3 {
            return false;
        }
        let mut n: i64 = 0;
        for k in 0..b.len() {
            if not is_digit(b[k]) {
                return false;
            }
            n = n * 10 + (b[k] - b'0') as i64;
        }
        if n > 255 or (b.len() > 1 and b[0] == b'0') {
            return false;
        }
    }
    true
}

fn is_hextet(s: Str) -> bool {
    let b = to_bytes(s);
    if b.len() == 0 or b.len() > 4 {
        return false;
    }
    for k in 0..b.len() {
        if not u_is_hex(b[k]) {
            return false;
        }
    }
    true
}

// IPv6Address's parser: at most one `::`, eight hextets in all, an IPv4
// tail, and a `%scope`.
fn is_ipv6(s: Str) -> bool {
    let (addr, has_scope, scope) = partition(s, b'%');
    if has_scope and (scope.len() == 0 or has_byte(scope, b'%')) {
        return false;
    }
    let mut parts = split_on(addr, b':');
    if parts.len() < 3 {
        return false;
    }
    let last = parts[parts.len() - 1].clone();
    if has_byte(last, b'.') {
        if not is_ipv4(last) {
            return false;
        }
        parts.pop();
        parts.push("0".to_string());
        parts.push("0".to_string());
    }
    if parts.len() > 9 {
        return false;
    }
    let n = parts.len();
    let mut skip: i64 = -1;
    for i in 1..n - 1 {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return false;
            }
            skip = i;
        }
    }
    let mut hi = n;
    let mut lo: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = n - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi > 0 {
                return false;
            }
        }
        if parts[n - 1].len() == 0 {
            lo -= 1;
            if lo > 0 {
                return false;
            }
        }
        if 8 - (hi + lo) < 1 {
            return false;
        }
    } else if n != 8 or parts[0].len() == 0 or parts[n - 1].len() == 0 {
        return false;
    }
    for i in 0..hi {
        if not is_hextet(parts[i]) {
            return false;
        }
    }
    for i in n - lo..n {
        if not is_hextet(parts[i]) {
            return false;
        }
    }
    true
}

// urllib.parse's _check_bracketed_host.
fn check_bracketed_host(host: Str) -> Result[(), String] {
    let b = to_bytes(host);
    if b.len() > 0 and (b[0] == b'v' or b[0] == b'V') {
        // \A[vV][a-fA-F0-9]+\..+\Z
        let mut i: i64 = 1;
        while i < b.len() and u_is_hex(b[i]) {
            i += 1;
        }
        if i == 1 or i >= b.len() or b[i] != b'.' or i + 1 >= b.len() {
            return Err("IPvFuture address is invalid".to_string());
        }
        return Ok(());
    }
    if is_ipv4(host) {
        return Err("An IPv4 address cannot be in brackets".to_string());
    }
    if not is_ipv6(host) {
        return Err(f"{py_repr(host)} does not appear to be an IPv4 or IPv6 address");
    }
    Ok(())
}

// ------------------------------------------------------------ split and parse

fn uses_relative(s: Str) -> bool {
    contains_str(["", "ftp", "http", "gopher", "nntp", "imap", "wais", "file", "https", "shttp", "mms", "prospero", "rtsp", "rtsps", "rtspu", "sftp", "svn", "svn+ssh", "ws", "wss"], s)
}

fn uses_netloc(s: Str) -> bool {
    contains_str(["", "ftp", "http", "gopher", "nntp", "telnet", "imap", "wais", "file", "mms", "https", "shttp", "snews", "prospero", "rtsp", "rtsps", "rtspu", "rsync", "svn", "svn+ssh", "sftp", "nfs", "git", "git+ssh", "ws", "wss", "itms-services"], s)
}

fn uses_params(s: Str) -> bool {
    contains_str(["", "ftp", "hdl", "prospero", "http", "imap", "https", "shttp", "rtsp", "rtsps", "rtspu", "sip", "sips", "mms", "sftp", "tel"], s)
}

fn is_scheme_char(c: u8) -> bool {
    is_alnum(c) or c == b'+' or c == b'-' or c == b'.'
}

#[derive(Clone)]
struct Split {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
    fragment: String,
}

#[derive(Clone)]
struct UrlParsed {
    scheme: String,
    netloc: String,
    path: String,
    params: String,
    query: String,
    fragment: String,
}

impl Split {
    fn repr(ref self) -> String {
        f"SplitResult(scheme={py_repr(self.scheme)}, netloc={py_repr(self.netloc)}, path={py_repr(self.path)}, query={py_repr(self.query)}, fragment={py_repr(self.fragment)})"
    }

    // _userinfo
    fn username(ref self) -> Option[String] {
        let (userinfo, have_info, _) = rpartition(self.netloc, b'@');
        if not have_info {
            return None;
        }
        let (user, _, _) = partition(userinfo, b':');
        Some(user)
    }

    fn password(ref self) -> Option[String] {
        let (userinfo, have_info, _) = rpartition(self.netloc, b'@');
        if not have_info {
            return None;
        }
        let (_, have_password, password) = partition(userinfo, b':');
        if have_password { Some(password) } else { None }
    }

    // _hostinfo: the host and the port as written.
    fn hostinfo(ref self) -> (String, Option[String]) {
        let (_, _, hostinfo) = rpartition(self.netloc, b'@');
        let (_, have_open_br, bracketed) = partition(hostinfo, b'[');
        let mut host = String.new();
        let mut port = String.new();
        if have_open_br {
            let (h, _, rest) = partition(bracketed, b']');
            let (_, _, p) = partition(rest, b':');
            host = h;
            port = p;
        } else {
            let (h, _, p) = partition(hostinfo, b':');
            host = h;
            port = p;
        }
        if port.len() == 0 { (host, None) } else { (host, Some(port)) }
    }

    fn hostname(ref self) -> Option[String] {
        let (host, _) = self.hostinfo();
        if host.len() == 0 {
            return None;
        }
        // a scope's zone keeps its case
        let (h, percent, zone) = partition(host, b'%');
        if percent { Some(f"{u_lower(h)}%{zone}") } else { Some(u_lower(h)) }
    }

    fn port(ref self) -> Result[Option[i64], String] {
        let (_, port) = self.hostinfo();
        let p = match port {
            Some(p) => p,
            None => return Ok(None),
        };
        let b = to_bytes(p);
        let mut n: i64 = 0;
        for i in 0..b.len() {
            if not is_digit(b[i]) {
                return Err(f"Port could not be cast to integer value as {py_repr(p)}");
            }
            if n <= 1000000 {
                n = n * 10 + (b[i] - b'0') as i64;
            }
        }
        if n > 65535 {
            return Err("Port out of range 0-65535".to_string());
        }
        Ok(Some(n))
    }
}

impl UrlParsed {
    fn repr(ref self) -> String {
        f"ParseResult(scheme={py_repr(self.scheme)}, netloc={py_repr(self.netloc)}, path={py_repr(self.path)}, params={py_repr(self.params)}, query={py_repr(self.query)}, fragment={py_repr(self.fragment)})"
    }
}

// _splitnetloc: the netloc runs to the first of / ? #.
fn split_netloc(url: Str, start: i64) -> (String, String) {
    let b = to_bytes(url);
    let mut delim = b.len();
    for i in start..b.len() {
        if b[i] == b'/' or b[i] == b'?' or b[i] == b'#' {
            delim = i;
            break;
        }
    }
    (byte_str(b, start, delim), byte_str(b, delim, b.len()))
}

fn check_bracketed_netloc(netloc: Str) -> Result[(), String] {
    let (_, _, host_and_port) = rpartition(netloc, b'@');
    let (before, have_open_br, bracketed) = partition(host_and_port, b'[');
    if have_open_br {
        if before.len() > 0 {
            return Err("Invalid IPv6 URL".to_string());
        }
        let (host, _, port) = partition(bracketed, b']');
        if port.len() > 0 and first_byte(port) != b':' {
            return Err("Invalid IPv6 URL".to_string());
        }
        return check_bracketed_host(host);
    }
    let (host, _, _) = partition(host_and_port, b':');
    check_bracketed_host(host)
}

fn urlsplit(url_in: Str, scheme_in: Str) -> Result[Split, String] {
    // lstrip the C0 controls and space, then drop every tab and line end
    let ub = to_bytes(url_in);
    let mut st: i64 = 0;
    while st < ub.len() and ub[st] <= 32 {
        st += 1;
    }
    let mut kept: Vec[u8] = Vec.new();
    for i in st..ub.len() {
        let c = ub[i];
        if c != b'\t' and c != b'\r' and c != b'\n' {
            kept.push(c);
        }
    }
    let mut url = from_bytes(kept);
    let mut scheme = strip_scheme(scheme_in);
    let mut netloc = String.new();
    let mut query = String.new();
    let mut fragment = String.new();
    let i = find_byte(url, b':');
    if i > 0 and u_is_alpha(first_byte(url)) {
        let b = to_bytes(url);
        let mut all = true;
        for k in 0..i {
            if not is_scheme_char(b[k]) {
                all = false;
                break;
            }
        }
        if all {
            scheme = u_lower(byte_str(b, 0, i));
            url = byte_str(b, i + 1, b.len());
        }
    }
    if starts_with(url, "//") {
        let (n, rest) = split_netloc(url, 2);
        netloc = n;
        url = rest;
        let open = has_byte(netloc, b'[');
        let close = has_byte(netloc, b']');
        if open != close {
            return Err("Invalid IPv6 URL".to_string());
        }
        if open and close {
            check_bracketed_netloc(netloc)?;
        }
    }
    if has_byte(url, b'#') {
        let (u, _, f) = partition(url, b'#');
        url = u;
        fragment = f;
    }
    if has_byte(url, b'?') {
        let (u, _, q) = partition(url, b'?');
        url = u;
        query = q;
    }
    Ok(Split { scheme: scheme, netloc: netloc, path: url, query: query, fragment: fragment })
}

// The scheme argument: C0 controls and space stripped at both ends, tabs
// and line ends dropped.
fn strip_scheme(s: Str) -> String {
    let b = to_bytes(s);
    let mut st: i64 = 0;
    let mut en = b.len();
    while st < en and b[st] <= 32 {
        st += 1;
    }
    while en > st and b[en - 1] <= 32 {
        en -= 1;
    }
    let mut out: Vec[u8] = Vec.new();
    for i in st..en {
        if b[i] != b'\t' and b[i] != b'\r' and b[i] != b'\n' {
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

// _splitparams: the params follow the `;` in the last segment.
fn split_params(url: Str) -> (String, String) {
    let i = if has_byte(url, b'/') {
        let b = to_bytes(url);
        let mut at: i64 = -1;
        for k in rfind_byte(url, b'/')..b.len() {
            if b[k] == b';' {
                at = k;
                break;
            }
        }
        if at < 0 {
            return (url.to_string(), String.new());
        }
        at
    } else {
        find_byte(url, b';')
    };
    (u_slice(url, 0, i), slice_from(url, i + 1))
}

fn urlparse(url: Str, scheme: Str) -> Result[UrlParsed, String] {
    let s = urlsplit(url, scheme)?;
    let mut path = s.path.clone();
    let mut params = String.new();
    if uses_params(s.scheme) and has_byte(path, b';') {
        let (p, a) = split_params(path);
        path = p;
        params = a;
    }
    Ok(UrlParsed { scheme: s.scheme, netloc: s.netloc, path: path, params: params, query: s.query, fragment: s.fragment })
}

fn urlunsplit(scheme: Str, netloc: Str, path: Str, query: Str, fragment: Str) -> String {
    let mut url = path.to_string();
    if netloc.len() > 0 {
        if url.len() > 0 and first_byte(url) != b'/' {
            url = f"/{url}";
        }
        url = f"//{netloc}{url}";
    } else if starts_with(url, "//") {
        url = f"//{url}";
    } else if scheme.len() > 0 and uses_netloc(scheme) and (url.len() == 0 or first_byte(url) == b'/') {
        url = f"//{url}";
    }
    if scheme.len() > 0 {
        url = f"{scheme}:{url}";
    }
    if query.len() > 0 {
        url = f"{url}?{query}";
    }
    if fragment.len() > 0 {
        url = f"{url}#{fragment}";
    }
    url
}

fn unsplit(s: ref Split) -> String {
    urlunsplit(s.scheme, s.netloc, s.path, s.query, s.fragment)
}

fn urlunparse(p: ref UrlParsed) -> String {
    let path = if p.params.len() > 0 { f"{p.path};{p.params}" } else { p.path.clone() };
    urlunsplit(p.scheme, p.netloc, path, p.query, p.fragment)
}

fn urljoin(base: Str, url: Str) -> Result[String, String] {
    if base.len() == 0 {
        return Ok(url.to_string());
    }
    if url.len() == 0 {
        return Ok(base.to_string());
    }
    let b = urlparse(base, "")?;
    let mut u = urlparse(url, b.scheme)?;
    if u.scheme != b.scheme or not uses_relative(u.scheme) {
        return Ok(url.to_string());
    }
    if uses_netloc(u.scheme) {
        if u.netloc.len() > 0 {
            return Ok(urlunparse(u));
        }
        u.netloc = b.netloc.clone();
    }
    if u.path.len() == 0 and u.params.len() == 0 {
        u.path = b.path.clone();
        u.params = b.params.clone();
        if u.query.len() == 0 {
            u.query = b.query.clone();
        }
        return Ok(urlunparse(u));
    }
    let mut base_parts = split_on(b.path, b'/');
    if base_parts[base_parts.len() - 1].len() > 0 {
        // the last segment is not a directory
        base_parts.pop();
    }
    let mut segments: Vec[String] = Vec.new();
    if first_byte(u.path) == b'/' {
        segments = split_on(u.path, b'/');
    } else {
        let rel = split_on(u.path, b'/');
        let mut all = base_parts.clone();
        for i in 0..rel.len() {
            all.push(rel[i].clone());
        }
        // drop the empty segments between the first and the last
        for i in 0..all.len() {
            if i == 0 or i == all.len() - 1 or all[i].len() > 0 {
                segments.push(all[i].clone());
            }
        }
    }
    let mut resolved: Vec[String] = Vec.new();
    for i in 0..segments.len() {
        if segments[i] == ".." {
            if resolved.len() > 0 {
                resolved.pop();
            }
        } else if segments[i] != "." {
            resolved.push(segments[i].clone());
        }
    }
    let last = segments[segments.len() - 1].clone();
    if last == "." or last == ".." {
        resolved.push(String.new());
    }
    let joined = join(resolved, "/");
    u.path = if joined.len() > 0 { joined } else { "/".to_string() };
    Ok(urlunparse(u))
}

fn urldefrag(url: Str) -> Result[(String, String), String] {
    if not has_byte(url, b'#') {
        return Ok((url.to_string(), String.new()));
    }
    let mut p = urlparse(url, "")?;
    let frag = p.fragment.clone();
    p.fragment = String.new();
    Ok((urlunparse(p), frag))
}

// ------------------------------------------------------------ quoting

fn always_safe(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c == b'.' or c == b'-' or c == b'~'
}

// quote: every byte of the UTF-8 that is neither always safe nor in
// `safe` becomes %XX.
fn quote(s: Str, safe: Str) -> String {
    let b = to_bytes(s);
    let sb = to_bytes(safe);
    let hex = to_bytes("0123456789ABCDEF");
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        let mut ok = c < 128 and always_safe(c);
        for k in 0..sb.len() {
            if sb[k] < 128 and sb[k] == c {
                ok = true;
            }
        }
        if ok {
            out.push(c);
        } else {
            out.push(b'%');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        }
    }
    from_bytes(out)
}

fn quote_plus(s: Str, safe: Str) -> String {
    if not has_byte(s, b' ') {
        return quote(s, safe);
    }
    replace_byte(quote(s, f"{safe} "), b' ', "+")
}

// _unquote_impl on ASCII: %XX with two hex digits is a byte, anything
// else stays as written.
fn unquote_bytes(b: ref Vec[u8], from: i64, to: i64, out: mut ref Vec[u8]) {
    let mut i = from;
    while i < to {
        if b[i] == b'%' and i + 2 < to and u_is_hex(b[i + 1]) and u_is_hex(b[i + 2]) {
            out.push(hex_val(b[i + 1]) * 16 + hex_val(b[i + 2]));
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
}

// unquote: the ASCII runs are unquoted and decoded as UTF-8 one run at a
// time; the rest is kept as it is.
fn unquote(s: Str) -> String {
    if not has_byte(s, b'%') {
        return s.to_string();
    }
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let st = i;
        if b[i] < 128 {
            while i < b.len() and b[i] < 128 {
                i += 1;
            }
            let mut run: Vec[u8] = Vec.new();
            unquote_bytes(b, st, i, mut run);
            push_str_bytes(mut out, utf8_replace(run));
        } else {
            while i < b.len() and b[i] >= 128 {
                out.push(b[i]);
                i += 1;
            }
        }
    }
    from_bytes(out)
}

fn unquote_plus(s: Str) -> String {
    unquote(replace_byte(s, b'+', " "))
}

// ------------------------------------------------------------ queries

#[derive(Clone)]
struct Pair {
    name: String,
    value: String,
}

fn parse_qsl(qs: Str, keep_blank: bool, strict: bool, sep: Str) -> Result[Vec[Pair], String] {
    let mut r: Vec[Pair] = Vec.new();
    if qs.len() == 0 {
        return Ok(r);
    }
    let fields = split_on(qs, first_byte(sep));
    for i in 0..fields.len() {
        let nv = fields[i].clone();
        if nv.len() == 0 and not strict {
            continue;
        }
        let (name, has_eq, value) = partition(nv, b'=');
        if not has_eq and strict {
            return Err(f"bad query field: {py_repr(nv)}");
        }
        if value.len() > 0 or keep_blank {
            r.push(Pair { name: unquote_plus(name), value: unquote_plus(value) });
        }
    }
    Ok(r)
}

fn pairs_repr(v: ref Vec[Pair]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for i in 0..v.len() {
        parts.push(f"({py_repr(v[i].name)}, {py_repr(v[i].value)})");
    }
    f"[{join(parts, ", ")}]"
}

// parse_qs: the values of each name, the names in the order first seen.
struct Multi {
    names: Vec[String],
    values: Vec[Vec[String]],
}

impl Multi {
    fn repr(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for i in 0..self.names.len() {
            let mut vs: Vec[String] = Vec.new();
            let list = self.values[i].clone();
            for k in 0..list.len() {
                vs.push(py_repr(list[k]));
            }
            parts.push(f"{py_repr(self.names[i])}: [{join(vs, ", ")}]");
        }
        f"{{{join(parts, ", ")}}}"
    }
}

fn parse_qs(pairs: ref Vec[Pair]) -> Multi {
    let mut m = Multi { names: Vec.new(), values: Vec.new() };
    for i in 0..pairs.len() {
        let mut at: i64 = -1;
        for k in 0..m.names.len() {
            if m.names[k] == pairs[i].name {
                at = k;
            }
        }
        if at < 0 {
            m.names.push(pairs[i].name.clone());
            m.values.push(Vec.new());
            at = m.names.len() - 1;
        }
        m.values[at].push(pairs[i].value.clone());
    }
    m
}

// urlencode over pairs, with quote_plus or quote.
fn urlencode(pairs: ref Vec[Pair], safe: Str, plus: bool) -> String {
    let mut l: Vec[String] = Vec.new();
    for i in 0..pairs.len() {
        let k = if plus { quote_plus(pairs[i].name, safe) } else { quote(pairs[i].name, safe) };
        let v = if plus { quote_plus(pairs[i].value, safe) } else { quote(pairs[i].value, safe) };
        l.push(f"{k}={v}");
    }
    join(l, "&")
}

// urlencode(d, doseq=True): one name=value for each value in the lists.
fn urlencode_multi(m: ref Multi) -> String {
    let mut pairs: Vec[Pair] = Vec.new();
    for i in 0..m.names.len() {
        let list = m.values[i].clone();
        for k in 0..list.len() {
            pairs.push(Pair { name: m.names[i].clone(), value: list[k].clone() });
        }
    }
    urlencode(pairs, "", true)
}


// ------------------------------------------------------------ values

// What a job's number means to Python: an int, or a float when it has a
// point or an exponent.
fn num_is_float(text: ref String) -> bool {
    text.contains(".") or text.contains("e") or text.contains("E")
}

fn num_f64(text: ref String) -> f64 {
    match f64.parse(text) {
        Ok(x) => x,
        Err(_) => 0.0,
    }
}

fn num_i64(text: ref String) -> i64 {
    match i64.parse(text) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn j_f64(j: ref J, key: Str) -> f64 {
    match j_get(j, key) {
        J.N(t) => num_f64(t),
        _ => 0.0,
    }
}

fn j_i64(j: ref J, key: Str) -> i64 {
    match j_get(j, key) {
        J.N(t) => if num_is_float(t) { num_f64(t) as i64 } else { num_i64(t) },
        _ => 0,
    }
}

fn j_list(j: ref J, key: Str) -> Vec[J] {
    match j_get(j, key) {
        J.A(items) => items,
        _ => Vec.new(),
    }
}

// repr() of a value read from the jobs.
fn value_repr(v: ref J) -> String {
    match v {
        J.S(s) => py_repr(s),
        J.N(t) => if num_is_float(t) { f"{num_f64(t)}" } else { f"{num_i64(t)}" },
        J.B(b) => if *b { "True".to_string() } else { "False".to_string() },
        J.Null => "None".to_string(),
        _ => "?".to_string(),
    }
}

// str() of a value, as safe_string gives it.
fn value_str(v: ref J) -> String {
    match v {
        J.S(s) => s.clone(),
        _ => value_repr(v),
    }
}

// int() of a value.
fn value_int(v: ref J) -> i64 {
    match v {
        J.S(s) => num_i64(strip(s)),
        J.N(t) => if num_is_float(t) { num_f64(t) as i64 } else { num_i64(t) },
        J.B(b) => if *b { 1 } else { 0 },
        _ => 0,
    }
}

// Python's truth value of a value.
fn value_truthy(v: ref J) -> bool {
    match v {
        J.S(s) => s.len() > 0,
        J.N(t) => num_f64(t) != 0.0,
        J.B(b) => *b,
        J.Null => false,
        _ => true,
    }
}

fn tuple_repr(vs: ref Vec[J]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for v in vs.iter() {
        parts.push(value_repr(v));
    }
    if parts.len() == 1 {
        return f"({parts[0]},)";
    }
    f"({join(parts, ", ")})"
}

fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in b.iter() {
        if *c == b'\'' {
            has_single = true;
        }
        if *c == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for c in b.iter() {
        let c = *c;
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn unhex_bytes(s: ref String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

// Python's float %: the result takes the sign of the divisor.
fn py_mod(a: f64, b: f64) -> f64 {
    let r = a % b;
    if r != 0.0 and (r < 0.0) != (b < 0.0) {
        return r + b;
    }
    r
}

fn bool_text(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn ceil_int(x: f64) -> i64 {
    x.ceil() as i64
}

// ------------------------------------------------------------ errors

// A Python exception: ValueError or limits' ConfigurationError.
struct Exc {
    kind: String,
    msg: String,
}

fn value_error(msg: own String) -> Exc {
    Exc { kind: "ValueError".to_string(), msg: msg }
}

fn config_error(msg: own String) -> Exc {
    Exc { kind: "ConfigurationError".to_string(), msg: msg }
}

fn exc_text(e: ref Exc) -> String {
    f"! {e.kind}: {e.msg}"
}

// ------------------------------------------------------------ items

// TIME_TYPES, in the order the item classes are defined, which is the
// order GRANULARITIES holds them in and granularity_from_string tries.
fn gran_name(g: i64) -> String {
    match g {
        0 => "year".to_string(),
        1 => "month".to_string(),
        2 => "day".to_string(),
        3 => "hour".to_string(),
        4 => "minute".to_string(),
        _ => "second".to_string(),
    }
}

fn gran_seconds(g: i64) -> i64 {
    match g {
        0 => 60 * 60 * 24 * 30 * 12,
        1 => 60 * 60 * 24 * 30,
        2 => 60 * 60 * 24,
        3 => 60 * 60,
        4 => 60,
        _ => 1,
    }
}

fn gran_class(g: i64) -> String {
    match g {
        0 => "RateLimitItemPerYear".to_string(),
        1 => "RateLimitItemPerMonth".to_string(),
        2 => "RateLimitItemPerDay".to_string(),
        3 => "RateLimitItemPerHour".to_string(),
        4 => "RateLimitItemPerMinute".to_string(),
        _ => "RateLimitItemPerSecond".to_string(),
    }
}

fn gran_of_name(name: ref String) -> i64 {
    let mut g = 0;
    while g < 6 {
        if gran_name(g) == *name {
            return g;
        }
        g += 1;
    }
    5
}

#[derive(Clone)]
struct Limit {
    gran: i64,
    amount: i64,
    multiples: i64,
    namespace: String,
}

fn new_item(gran: i64, amount: i64, multiples: i64) -> Limit {
    Limit { gran: gran, amount: amount, multiples: if multiples == 0 { 1 } else { multiples }, namespace: "LIMITER".to_string() }
}

impl Limit {
    fn repr(ref self) -> String {
        f"{self.amount} per {self.multiples} {gran_name(self.gran)}"
    }

    fn get_expiry(ref self) -> i64 {
        gran_seconds(self.gran) * self.multiples
    }

    fn key_for(ref self, ids: ref Vec[String]) -> String {
        let mut parts: Vec[String] = ids.clone();
        parts.push(f"{self.amount}");
        parts.push(f"{self.multiples}");
        parts.push(gran_name(self.gran));
        f"{self.namespace}/{join(parts, "/")}"
    }

    fn eq(ref self, other: ref Limit) -> bool {
        self.amount == other.amount and self.gran == other.gran and self.multiples == other.multiples
    }

    fn lt(ref self, other: ref Limit) -> bool {
        gran_seconds(self.gran) < gran_seconds(other.gran)
    }

    // the rest of the order, as functools.total_ordering derives it
    fn le(ref self, other: ref Limit) -> bool {
        self.lt(other) or self.eq(other)
    }

    fn gt(ref self, other: ref Limit) -> bool {
        not self.lt(other) and not self.eq(other)
    }

    fn ge(ref self, other: ref Limit) -> bool {
        not self.lt(other)
    }
}

fn items_repr(items: ref Vec[Limit]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for i in items.iter() {
        parts.push(i.repr());
    }
    f"[{join(parts, ", ")}]"
}

// ------------------------------------------------------------ parsing

// util.py's three patterns, compiled with the re engine.
struct Patterns {
    separators: Program,
    single: Program,
    expr: Program,
}

fn single_source() -> String {
    "\n    \\s*([0-9]+)\n    \\s*(/|\\s*per\\s*)\n    \\s*([0-9]+)?\n    \\s*([a-z]+)\n    \\s*\n    ".to_string()
}

fn compile_text(p: ref String, flags: i64) -> Result[Program, String] {
    match compile(codepoints(p.bytes()), flags) {
        Ok(prog) => Ok(prog),
        Err(e) => Err(f"cannot compile {p}: {err_text(e)}"),
    }
}

fn new_patterns() -> Result[Patterns, String] {
    let sep = "[,;|]{1}".to_string();
    let single = single_source();
    let expr = f"^{single}(:?{sep}{single})*$";
    let flags = flag_i() | flag_x();
    Ok(Patterns {
        separators: compile_text(sep, 0)?,
        single: compile_text(single, flags)?,
        expr: compile_text(expr, flags)?,
    })
}

// pattern.match(s): one attempt at the start.
fn re_match(prog: ref Program, s: ref Vec[i64]) -> Option[Found] {
    let mut m = new_matcher(prog, s);
    find(mut m, prog, 0, false, 1)
}

// pattern.split(s) for a pattern without groups.
fn re_split(prog: ref Program, s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut last = 0;
    for m in all_matches(prog, s, 0).iter() {
        out.push(slice(s, last, m.start));
        last = m.end;
    }
    out.push(slice(s, last, s.len()));
    out
}

fn group_cps(s: ref Vec[i64], m: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(slice(s, a, b)) }
}

fn digits_int(cps: ref Vec[i64]) -> i64 {
    let mut n: i64 = 0;
    for c in cps.iter() {
        n = n * 10 + (*c - 48);
    }
    n
}

fn py_lower(s: ref String) -> String {
    let mut out = String.new();
    for ch in s.chars() {
        out.push(ch.to_lowercase());
    }
    out
}

fn granularity_from_string(text: ref String) -> Result[i64, Exc] {
    let low = py_lower(text);
    let mut g = 0;
    while g < 6 {
        let name = gran_name(g);
        if low == name or low == f"{name}s" {
            return Ok(g);
        }
        g += 1;
    }
    Err(value_error(f"no granularity matched for {text}"))
}

fn parse_many(p: ref Patterns, text: ref String) -> Result[Vec[Limit], Exc] {
    let s = codepoints(text.bytes());
    if re_match(p.expr, s).is_none() {
        return Err(value_error(f"couldn't parse rate limit string '{text}'"));
    }
    let mut items: Vec[Limit] = Vec.new();
    for piece in re_split(p.separators, s).iter() {
        if let Some(m) = re_match(p.single, piece) {
            let amount = digits_int(group_cps(piece, m, 1).unwrap_or(Vec.new()));
            let multiples = match group_cps(piece, m, 3) {
                Some(d) => digits_int(d),
                None => 0,
            };
            let g = granularity_from_string(to_string(group_cps(piece, m, 4).unwrap_or(Vec.new())))?;
            items.push(new_item(g, amount, multiples));
        }
    }
    Ok(items)
}

fn parse_one(p: ref Patterns, text: Str) -> Result[Limit, Exc] {
    let items = parse_many(p, text.to_string())?;
    Ok(items[0].clone())
}

// ------------------------------------------------------------ the clock

// time.time(), as the jobs set it.
struct Clock {
    now: f64,
}

// ------------------------------------------------------------ memory storage

#[derive(Clone)]
struct MwEntry {
    atime: f64,
    expiry: f64,
}

// MemoryStorage: a Counter of hits with their expiry times, and a list
// of entries per moving window, newest first. Its timer never fires
// here, so expired entries stay until a sweep.
struct Memory {
    storage: Map[String, i64],
    expirations: Map[String, f64],
    events: Map[String, Vec[MwEntry]],
}

fn new_memory() -> Memory {
    Memory { storage: Map.new(), expirations: Map.new(), events: Map.new() }
}

// bisect.bisect_left over keys that rise along the list.
fn bisect_left_keys(keys: ref Vec[f64], x: f64) -> i64 {
    let mut lo = 0;
    let mut hi = keys.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if keys[mid] < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn sorted_keys_i(m: ref Map[String, i64]) -> Vec[String] {
    let mut ks: Vec[String] = Vec.new();
    for k in m.keys() {
        ks.push(k.clone());
    }
    sort_strings(ks)
}

fn sliding_window_keys(key: ref String, expiry: i64, at: f64) -> (String, String) {
    let e = expiry as f64;
    let prev = ((at - e) / e) as i64;
    let cur = (at / e) as i64;
    (f"{key}/{prev}", f"{key}/{cur}")
}

impl Memory {
    fn count(ref self, key: ref String) -> i64 {
        match self.storage.get(key) {
            Some(n) => *n,
            None => 0,
        }
    }

    fn incr(mut ref self, c: ref Clock, key: ref String, expiry: f64, amount: i64) -> i64 {
        self.get(c, key);
        let n = self.count(key) + amount;
        self.storage.insert(key.clone(), n);
        if n == amount {
            self.expirations.insert(key.clone(), c.now + expiry);
        }
        self.count(key)
    }

    fn decr(mut ref self, c: ref Clock, key: ref String, amount: i64) -> i64 {
        self.get(c, key);
        let n = self.count(key) - amount;
        self.storage.insert(key.clone(), if n > 0 { n } else { 0 });
        self.count(key)
    }

    fn get(mut ref self, c: ref Clock, key: ref String) -> i64 {
        let at = match self.expirations.get(key) {
            Some(t) => *t,
            None => 0.0,
        };
        if at <= c.now {
            self.storage.remove(key);
            self.expirations.remove(key);
        }
        self.count(key)
    }

    fn clear(mut ref self, key: ref String) {
        self.storage.remove(key);
        self.expirations.remove(key);
        self.events.remove(key);
    }

    fn acquire_entry(mut ref self, c: ref Clock, key: ref String, limit: i64, expiry: i64, amount: i64) -> bool {
        if amount > limit {
            return false;
        }
        if not self.events.contains_key(key) {
            self.events.insert(key.clone(), Vec.new());
        }
        let timestamp = c.now;
        let list = match self.events.get(key) {
            Some(l) => l.clone(),
            None => Vec.new(),
        };
        let at = limit - amount;
        if at < list.len() and list[at].atime >= timestamp - (expiry as f64) {
            return false;
        }
        let mut fresh: Vec[MwEntry] = Vec.new();
        let mut k = 0;
        while k < amount {
            fresh.push(MwEntry { atime: c.now, expiry: c.now + (expiry as f64) });
            k += 1;
        }
        for e in list.iter() {
            fresh.push(e.clone());
        }
        self.events.insert(key.clone(), fresh);
        true
    }

    fn get_expiry(ref self, c: ref Clock, key: ref String) -> f64 {
        match self.expirations.get(key) {
            Some(t) => *t,
            None => c.now,
        }
    }

    fn get_moving_window(ref self, c: ref Clock, key: ref String, expiry: i64) -> (f64, i64) {
        let timestamp = c.now;
        let list = match self.events.get(key) {
            Some(l) => l.clone(),
            None => Vec.new(),
        };
        if list.len() > 0 {
            let mut keys: Vec[f64] = Vec.new();
            for e in list.iter() {
                keys.push(-e.atime);
            }
            let oldest = bisect_left_keys(keys, -(timestamp - (expiry as f64)));
            // events[oldest - 1], which is the last entry when oldest is 0
            let at = if oldest == 0 { list.len() - 1 } else { oldest - 1 };
            return (list[at].atime, oldest);
        }
        (timestamp, 0)
    }

    fn sliding_info(mut ref self, c: ref Clock, prev_key: ref String, cur_key: ref String, expiry: i64) -> (i64, f64, i64, f64) {
        let now = c.now;
        let e = expiry as f64;
        let previous_count = self.get(c, prev_key);
        let current_count = self.get(c, cur_key);
        let previous_ttl = if previous_count == 0 { 0.0 } else { (1.0 - py_mod((now - e) / e, 1.0)) * e };
        let current_ttl = (1.0 - py_mod(now / e, 1.0)) * e + e;
        (previous_count, previous_ttl, current_count, current_ttl)
    }

    fn acquire_sliding(mut ref self, c: ref Clock, key: ref String, limit: i64, expiry: i64, amount: i64) -> bool {
        if amount > limit {
            return false;
        }
        let (prev_key, cur_key) = sliding_window_keys(key, expiry, c.now);
        let (previous_count, previous_ttl, current_count, _) = self.sliding_info(c, prev_key, cur_key, expiry);
        let e = expiry as f64;
        let weighted = (previous_count as f64) * previous_ttl / e + (current_count as f64);
        if (weighted.floor() as i64) + amount > limit {
            return false;
        }
        let now_count = self.incr(c, cur_key, 2.0 * e, amount);
        let weighted = (previous_count as f64) * previous_ttl / e + (now_count as f64);
        if (weighted.floor() as i64) > limit {
            self.decr(c, cur_key, amount);
            return false;
        }
        true
    }

    fn get_sliding_window(mut ref self, c: ref Clock, key: ref String, expiry: i64) -> (i64, f64, i64, f64) {
        let (prev_key, cur_key) = sliding_window_keys(key, expiry, c.now);
        self.sliding_info(c, prev_key, cur_key, expiry)
    }

    fn clear_sliding(mut ref self, c: ref Clock, key: ref String, expiry: i64) {
        let (prev_key, cur_key) = sliding_window_keys(key, expiry, c.now);
        self.clear(prev_key);
        self.clear(cur_key);
    }

    fn reset(mut ref self) -> i64 {
        let n = if self.storage.len() > self.events.len() { self.storage.len() } else { self.events.len() };
        self.storage = Map.new();
        self.expirations = Map.new();
        self.events = Map.new();
        n
    }

    // __expire_events, the timer's work
    fn sweep(mut ref self, c: ref Clock) {
        let mut names: Vec[String] = Vec.new();
        for k in self.events.keys() {
            names.push(k.clone());
        }
        for k in names.iter() {
            let list = match self.events.get(k) {
                Some(l) => l.clone(),
                None => Vec.new(),
            };
            if list.len() > 0 {
                let mut keys: Vec[f64] = Vec.new();
                for e in list.iter() {
                    keys.push(-e.expiry);
                }
                let oldest = bisect_left_keys(keys, -c.now);
                let mut kept: Vec[MwEntry] = Vec.new();
                let mut i = 0;
                while i < oldest {
                    kept.push(list[i].clone());
                    i += 1;
                }
                self.events.insert(k.clone(), kept);
            }
        }
        let mut expired: Vec[String] = Vec.new();
        for (k, t) in self.expirations.iter() {
            if *t <= c.now {
                expired.push(k.clone());
            }
        }
        for k in expired.iter() {
            self.storage.remove(k);
            self.expirations.remove(k);
        }
    }

    fn state(ref self) -> String {
        let mut counters: Vec[String] = Vec.new();
        for k in sorted_keys_i(self.storage).iter() {
            let at = match self.expirations.get(k) {
                Some(t) => f"{*t}",
                None => "None".to_string(),
            };
            counters.push(f"{k}={self.count(k)}@{at}");
        }
        let mut names: Vec[String] = Vec.new();
        for k in self.events.keys() {
            names.push(k.clone());
        }
        let mut events: Vec[String] = Vec.new();
        for k in sort_strings(names).iter() {
            let n = match self.events.get(k) {
                Some(l) => l.len(),
                None => 0,
            };
            events.push(f"{k}:{n}");
        }
        f"counters [{join(counters, ", ")}] events [{join(events, ", ")}] expirations {self.expirations.len()}"
    }
}

// ------------------------------------------------------------ strategies

fn strategy_of(name: ref String) -> i64 {
    if name == "fixed-window" {
        0
    } else if name == "moving-window" {
        1
    } else {
        2
    }
}

fn strategy_name(s: i64) -> String {
    match s {
        0 => "fixed-window".to_string(),
        1 => "moving-window".to_string(),
        _ => "sliding-window-counter".to_string(),
    }
}

struct WindowStats {
    reset_time: f64,
    remaining: i64,
}

fn stats_repr(s: ref WindowStats) -> String {
    f"WindowStats(reset_time={s.reset_time}, remaining={s.remaining})"
}

fn max_i(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// A RateLimiter: one of the three strategies over a storage.
struct Limiter {
    kind: i64,
    store: Memory,
}

fn new_limiter(kind: i64) -> Limiter {
    Limiter { kind: kind, store: new_memory() }
}

impl Limiter {
    fn hit(mut ref self, c: ref Clock, item: ref Limit, ids: ref Vec[String], cost: i64) -> bool {
        let key = item.key_for(ids);
        if self.kind == 0 {
            self.store.incr(c, key, item.get_expiry() as f64, cost) <= item.amount
        } else if self.kind == 1 {
            self.store.acquire_entry(c, key, item.amount, item.get_expiry(), cost)
        } else {
            self.store.acquire_sliding(c, key, item.amount, item.get_expiry(), cost)
        }
    }

    fn weighted(ref self, item: ref Limit, previous_count: i64, previous_expires_in: f64, current_count: i64) -> f64 {
        (previous_count as f64) * previous_expires_in / (item.get_expiry() as f64) + (current_count as f64)
    }

    fn test(mut ref self, c: ref Clock, item: ref Limit, ids: ref Vec[String], cost: i64) -> bool {
        let key = item.key_for(ids);
        if self.kind == 0 {
            self.store.get(c, key) < item.amount - cost + 1
        } else if self.kind == 1 {
            let (_, n) = self.store.get_moving_window(c, key, item.get_expiry());
            n <= item.amount - cost
        } else {
            let (pc, pe, cc, _) = self.store.get_sliding_window(c, key, item.get_expiry());
            self.weighted(item, pc, pe, cc) < ((item.amount - cost + 1) as f64)
        }
    }

    fn stats(mut ref self, c: ref Clock, item: ref Limit, ids: ref Vec[String]) -> WindowStats {
        let key = item.key_for(ids);
        if self.kind == 0 {
            let remaining = max_i(0, item.amount - self.store.get(c, key));
            let reset = self.store.get_expiry(c, key);
            return WindowStats { reset_time: reset, remaining: remaining };
        }
        if self.kind == 1 {
            let (start, n) = self.store.get_moving_window(c, key, item.get_expiry());
            return WindowStats { reset_time: start + (item.get_expiry() as f64), remaining: item.amount - n };
        }
        let (pc, pe, cc, ce) = self.store.get_sliding_window(c, key, item.get_expiry());
        let remaining = max_i(0, item.amount - (self.weighted(item, pc, pe, cc).floor() as i64));
        let now = c.now;
        if pc == 0 and cc == 0 {
            return WindowStats { reset_time: now, remaining: remaining };
        }
        let expiry = item.get_expiry() as f64;
        let inf = 1.0 / 0.0;
        let mut previous_reset_in = inf;
        let mut current_reset_in = inf;
        if pc != 0 {
            previous_reset_in = py_mod(pe, expiry / (pc as f64));
        }
        if cc != 0 {
            current_reset_in = py_mod(ce, expiry);
        }
        let soonest = if current_reset_in < previous_reset_in { current_reset_in } else { previous_reset_in };
        WindowStats { reset_time: now + soonest, remaining: remaining }
    }

    fn clear(mut ref self, c: ref Clock, item: ref Limit, ids: ref Vec[String]) {
        let key = item.key_for(ids);
        if self.kind == 2 {
            self.store.clear_sliding(c, key, item.get_expiry());
        } else {
            self.store.clear(key);
        }
    }
}

fn ids_of(a: Str, b: Str) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(a.to_string());
    v.push(b.to_string());
    v
}

// ------------------------------------------------------------ storage URIs

fn opt_str_repr(v: ref Option[String]) -> String {
    match v {
        Some(s) => py_repr(s),
        None => "None".to_string(),
    }
}

struct UriOptions {
    scheme: String,
    username: Option[String],
    password: Option[String],
    locations: Vec[(String, i64)],
    path: String,
    query: Multi,
}

impl UriOptions {
    fn repr(ref self) -> String {
        let mut locs: Vec[String] = Vec.new();
        for (h, p) in self.locations.iter() {
            locs.push(f"({py_repr(h)}, {p})");
        }
        f"StorageURIOptions(scheme={py_repr(self.scheme)}, username={opt_str_repr(self.username)}, password={opt_str_repr(self.password)}, locations=[{join(locs, ", ")}], path={py_repr(self.path)}, query={self.query.repr()})"
    }

    fn empty(ref self) -> bool {
        self.username.is_none() and self.password.is_none() and not (self.locations.len() > 0 or self.path.len() > 0 or self.query.names.len() > 0)
    }
}

fn split_of(p: ref UrlParsed) -> Split {
    Split { scheme: p.scheme.clone(), netloc: p.netloc.clone(), path: p.path.clone(), query: p.query.clone(), fragment: p.fragment.clone() }
}

// The host and port of one location, or why there is none.
fn location(loc: ref String) -> Result[(Option[String], Option[i64]), String] {
    let sub = split_of(urlparse(f"fake://{strip(loc)}", "")?);
    let port = sub.port()?;
    Ok((sub.hostname(), port))
}

fn parse_storage_uri(uri: ref String) -> Result[UriOptions, Exc] {
    let parsed = match urlparse(uri, "") {
        Ok(p) => p,
        Err(e) => return Err(value_error(e)),
    };
    let sp = split_of(parsed);
    let sep = find_byte(parsed.netloc, b'@') + 1;
    let hosts = slice_from(parsed.netloc, sep);
    let mut locations: Vec[(String, i64)] = Vec.new();
    if hosts.len() > 0 {
        for loc in split_on(hosts, b',').iter() {
            match location(loc) {
                Ok((Some(h), Some(p))) => locations.push((h, p)),
                Ok(_) => return Err(config_error(f"Missing host or port in location {loc}")),
                Err(_) => return Err(config_error(f"Unable to parse storage uri {uri}")),
            }
        }
    }
    let pairs = match parse_qsl(parsed.query, false, false, "&") {
        Ok(p) => p,
        Err(e) => return Err(value_error(e)),
    };
    Ok(UriOptions {
        scheme: parsed.scheme.clone(),
        username: sp.username(),
        password: sp.password(),
        locations: locations,
        path: parsed.path.clone(),
        query: parse_qs(pairs),
    })
}

fn schemes() -> Vec[String] {
    let names = ["async+memcached", "async+memory", "async+mongodb", "async+mongodb+srv", "async+redis",
        "async+redis+cluster", "async+redis+sentinel", "async+redis+unix", "async+rediss", "async+valkey",
        "async+valkey+cluster", "async+valkey+sentinel", "async+valkey+unix", "async+valkeys", "memcached",
        "memory", "mongodb", "mongodb+srv", "redis", "redis+cluster", "redis+sentinel", "redis+unix", "rediss",
        "valkey", "valkey+cluster", "valkey+sentinel", "valkey+unix", "valkeys"];
    let mut out: Vec[String] = Vec.new();
    for n in names.iter() {
        out.push(n.to_string());
    }
    out
}

// The ConfigurationError for a module the storage needs and the run
// does not have.
fn missing(name: Str, version: Str) -> Exc {
    let mut msg = f"'{name}' prerequisite not available.";
    if version.len() > 0 {
        msg = f"{msg} A minimum version of {version} is required.";
    }
    config_error(f"{msg} See https://limits.readthedocs.io/en/stable/storage.html#supported-versions for more details.")
}

fn starts_valkey(s: ref String) -> bool {
    s.starts_with("valkey")
}

// storage_from_string: the class the scheme names, or the error its
// constructor raises without redis, valkey or pymemcache installed.
fn storage_from_string(text: ref String) -> Result[String, Exc] {
    let scheme = match urlparse(text, "") {
        Ok(p) => p.scheme,
        Err(e) => return Err(value_error(e)),
    };
    if not contains_str(schemes(), scheme) {
        return Err(config_error(f"unknown storage scheme : {text}"));
    }
    if scheme == "memory" {
        return Ok("limits.storage.memory.MemoryStorage".to_string());
    }
    if scheme == "async+memory" {
        return Ok("limits.aio.storage.memory.MemoryStorage".to_string());
    }
    let valkey = starts_valkey(text);
    if scheme == "redis+cluster" or scheme == "valkey+cluster" {
        parse_storage_uri(text)?;
        return Err(if valkey { missing("valkey", "6.0") } else { missing("redis", "4.2.0") });
    }
    if scheme == "redis+sentinel" or scheme == "valkey+sentinel" {
        let o = parse_storage_uri(text)?;
        if o.path.len() == 0 {
            return Err(config_error("'service_name' not provided".to_string()));
        }
        return Err(if valkey { missing("valkey.sentinel", "6.0") } else { missing("redis.sentinel", "3.0") });
    }
    if scheme == "memcached" {
        parse_storage_uri(text)?;
        return Err(missing("pymemcache", ""));
    }
    if scheme.starts_with("redis") or scheme.starts_with("valkey") {
        return Err(if valkey { missing("valkey", "6.0") } else { missing("redis", "3.0") });
    }
    Err(config_error(f"{scheme} is not ported"))
}

// ------------------------------------------------------------ the jobs

fn clock_at(c: mut ref Clock, t: f64) {
    c.now = t;
}

fn op_parse(p: ref Patterns, op: ref J) {
    let text = j_str(op, "text");
    match parse_many(p, text) {
        Err(e) => println(f"{py_repr(text)}: {exc_text(e)}"),
        Ok(items) => {
            println(f"{py_repr(text)}: {items_repr(items)}");
            let mut ids: Vec[String] = Vec.new();
            ids.push("203.0.113.5".to_string());
            for i in items.iter() {
                println(f"  {gran_class(i.gran)} expiry={i.get_expiry()} key={py_repr(i.key_for(ids))}");
            }
        }
    }
}

fn op_parse_bytes(op: ref J) {
    let b = unhex_bytes(j_str(op, "hex"));
    let shown = bytes_repr(b);
    println(f"{shown}: ! ValueError: couldn't parse rate limit string '{shown}'");
}

fn op_item(op: ref J) {
    let g = gran_of_name(j_str(op, "cls"));
    let amount = j_get(op, "amount");
    let multiples = j_get(op, "multiples");
    let ns = j_str(op, "namespace");
    let mut item = new_item(g, value_int(amount), if value_truthy(multiples) { value_int(multiples) } else { 1 });
    item.namespace = ns.clone();
    println(f"{gran_class(g)}({value_repr(amount)}, {value_repr(multiples)}, namespace={py_repr(ns)}): {item.repr()} expiry={item.get_expiry()}");
    let mut ids: Vec[String] = Vec.new();
    for v in j_list(op, "ids").iter() {
        ids.push(value_str(v));
    }
    println(f"  key {py_repr(item.key_for(ids))}");
}

fn op_key_for(p: ref Patterns, op: ref J) -> Result[(), Exc] {
    let item = parse_one(p, j_str(op, "limit"))?;
    let vs = j_list(op, "ids");
    let mut ids: Vec[String] = Vec.new();
    for v in vs.iter() {
        ids.push(value_str(v));
    }
    println(f"key_for{tuple_repr(vs)} of {item.repr()}: {py_repr(item.key_for(ids))}");
    Ok(())
}

fn op_key_for_bytes(p: ref Patterns, op: ref J) -> Result[(), Exc] {
    let item = parse_one(p, j_str(op, "limit"))?;
    let b = unhex_bytes(j_str(op, "hex"));
    let mut ids: Vec[String] = Vec.new();
    ids.push(from_bytes(b.clone()));
    println(f"key_for({bytes_repr(b)}) of {item.repr()}: {py_repr(item.key_for(ids))}");
    Ok(())
}

fn op_compare(p: ref Patterns, op: ref J) -> Result[(), Exc] {
    let a = parse_one(p, j_str(op, "a"))?;
    let b = parse_one(p, j_str(op, "b"))?;
    println(f"{a.repr()} vs {b.repr()}: == {bool_text(a.eq(b))}, < {bool_text(a.lt(b))}, <= {bool_text(a.le(b))}, > {bool_text(a.gt(b))}, >= {bool_text(a.ge(b))}");
    Ok(())
}

fn op_compare_ns(p: ref Patterns, op: ref J) -> Result[(), Exc] {
    let mut a = parse_one(p, j_str(op, "a"))?;
    a.namespace = j_str(op, "na");
    let mut b = parse_one(p, j_str(op, "b"))?;
    b.namespace = j_str(op, "nb");
    let mut x: Vec[String] = Vec.new();
    x.push("x".to_string());
    println(f"{a.repr()} in {py_repr(a.namespace)} vs {b.repr()} in {py_repr(b.namespace)}: == {bool_text(a.eq(b))}, keys {py_repr(a.key_for(x))} {py_repr(b.key_for(x))}");
    Ok(())
}

fn op_sort(p: ref Patterns, op: ref J) -> Result[(), Exc] {
    let mut items: Vec[Limit] = Vec.new();
    for s in j_strs(op, "limits").iter() {
        items.push(parse_one(p, s)?);
    }
    println(f"sorted {items_repr(items)}");
    // sorted() is stable and asks only <
    let mut sorted = items.clone();
    let mut i = 1;
    while i < sorted.len() {
        let mut j = i;
        while j > 0 and sorted[j].lt(sorted[j - 1]) {
            sorted.swap(j - 1, j);
            j -= 1;
        }
        i += 1;
    }
    println(f"  -> {items_repr(sorted)}");
    let mut lo = items[0].clone();
    let mut hi = items[0].clone();
    for it in items.iter() {
        if it.lt(lo) {
            lo = it.clone();
        }
        if it.gt(hi) {
            hi = it.clone();
        }
    }
    println(f"  min {lo.repr()}, max {hi.repr()}");
    Ok(())
}

fn op_granularity(op: ref J) {
    for text in j_strs(op, "texts").iter() {
        match granularity_from_string(text) {
            Ok(g) => println(f"granularity {py_repr(text)}: {gran_class(g)}"),
            Err(e) => println(f"granularity {py_repr(text)}: {exc_text(e)}"),
        }
    }
}

fn op_storage(op: ref J, st: mut ref Memory, c: mut ref Clock) {
    let kind = j_str(op, "op");
    let key = j_str(op, "key");
    if kind == "at" {
        clock_at(mut c, j_f64(op, "t"));
        println(f"at {c.now}");
    } else if kind == "advance" {
        c.now = c.now + j_f64(op, "dt");
        println(f"at {c.now}");
    } else if kind == "check" {
        println("check -> True");
    } else if kind == "incr" {
        let expiry = j_i64(op, "expiry");
        let amount = j_i64(op, "amount");
        let n = st.incr(c, key, expiry as f64, amount);
        println(f"incr {key} {expiry} +{amount} -> {n}");
    } else if kind == "decr" {
        let amount = j_i64(op, "amount");
        let n = st.decr(c, key, amount);
        println(f"decr {key} -{amount} -> {n}");
    } else if kind == "get" {
        let n = st.get(c, key);
        println(f"get {key} -> {n}");
    } else if kind == "get_expiry" {
        println(f"get_expiry {key} -> {st.get_expiry(c, key)}");
    } else if kind == "clear" {
        st.clear(key);
        println(f"clear {key}");
    } else if kind == "acquire" {
        let limit = j_i64(op, "limit");
        let expiry = j_i64(op, "expiry");
        let amount = j_i64(op, "amount");
        let r = st.acquire_entry(c, key, limit, expiry, amount);
        println(f"acquire_entry {key} limit={limit} expiry={expiry} amount={amount} -> {bool_text(r)}");
    } else if kind == "window" {
        let (start, n) = st.get_moving_window(c, key, j_i64(op, "expiry"));
        println(f"get_moving_window {key} -> ({start}, {n})");
    } else if kind == "acquire_sliding" {
        let limit = j_i64(op, "limit");
        let expiry = j_i64(op, "expiry");
        let amount = j_i64(op, "amount");
        let r = st.acquire_sliding(c, key, limit, expiry, amount);
        println(f"acquire_sliding_window_entry {key} limit={limit} expiry={expiry} amount={amount} -> {bool_text(r)}");
    } else if kind == "sliding" {
        let (pc, pt, cc, ct) = st.get_sliding_window(c, key, j_i64(op, "expiry"));
        println(f"get_sliding_window {key} -> ({pc}, {pt}, {cc}, {ct})");
    } else if kind == "clear_sliding" {
        st.clear_sliding(c, key, j_i64(op, "expiry"));
        println(f"clear_sliding_window {key}");
    } else if kind == "reset" {
        println(f"reset -> {st.reset()}");
    } else if kind == "state" {
        println(f"state {st.state()}");
    } else if kind == "sweep" {
        st.sweep(c);
        println("sweep");
    }
}

fn op_strategy_step(p: ref Patterns, op: ref J, lim: mut ref Limiter, c: mut ref Clock) -> Result[(), Exc] {
    let kind = j_str(op, "op");
    if kind == "at" {
        clock_at(mut c, j_f64(op, "t"));
        return Ok(());
    }
    let item = parse_one(p, j_str(op, "limit"))?;
    let ids = j_strs(op, "ids");
    let cost = j_i64(op, "cost");
    let head = f"{c.now} {kind} {item.repr()} {join(ids, "/")}";
    if kind == "hit" {
        let r = lim.hit(c, item, ids, cost);
        println(f"{head} cost={cost} -> {bool_text(r)}");
    } else if kind == "test" {
        let r = lim.test(c, item, ids, cost);
        println(f"{head} cost={cost} -> {bool_text(r)}");
    } else if kind == "stats" {
        let s = lim.stats(c, item, ids);
        println(f"{head} -> {stats_repr(s)}");
    } else if kind == "clear" {
        lim.clear(c, item, ids);
        println(head);
    }
    Ok(())
}

fn op_uri(op: ref J) {
    let text = j_str(op, "text");
    match parse_storage_uri(text) {
        Ok(o) => println(f"{py_repr(text)}: {o.repr()} empty={bool_text(o.empty())}"),
        Err(e) => println(f"{py_repr(text)}: {exc_text(e)}"),
    }
}

fn op_from_string(op: ref J) {
    let text = j_str(op, "text");
    match storage_from_string(text) {
        Ok(name) => println(f"storage_from_string({py_repr(text)}): {name}"),
        Err(e) => println(f"storage_from_string({py_repr(text)}): {exc_text(e)}"),
    }
}

// ------------------------------------------------------------ the gateway

fn data_lines(name: Str) -> Result[Vec[String], String] {
    let text = read_data(f"data/{name}")?;
    let mut out: Vec[String] = Vec.new();
    for line in text.lines() {
        if strip(line).len() == 0 or line.starts_with("#") {
            continue;
        }
        out.push(line.to_string());
    }
    Ok(out)
}

fn stats_text(item: ref Limit, s: ref WindowStats) -> String {
    f"limit={item.repr()} remaining={s.remaining} reset={s.reset_time}"
}

struct Route {
    method: String,
    path: String,
    strategy: i64,
    items: Vec[Limit],
    key: String,
    cost: String,
}

#[derive(Clone)]
struct Count {
    name: String,
    status: i64,
    n: i64,
}

fn bump_count(counts: mut ref Vec[Count], name: ref String, status: i64) {
    let mut k = 0;
    while k < counts.len() {
        if counts[k].name == *name and counts[k].status == status {
            counts[k].n += 1;
            return;
        }
        k += 1;
    }
    counts.push(Count { name: name.clone(), status: status, n: 1 });
}

fn tail_from(words: ref Vec[String], k: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut i = k;
    while i < words.len() {
        out.push(words[i].clone());
        i += 1;
    }
    out
}

fn parse_err(e: ref Exc) -> String {
    exc_text(e)
}

fn words_of(line: Str) -> Vec[String] {
    split_ws(line)
}

fn op_gateway(p: ref Patterns, c: mut ref Clock) -> Result[(), String] {
    // the three strategies share one storage, so one limiter switches
    let mut lim = new_limiter(0);
    let mut default: Vec[Limit] = Vec.new();
    let mut exempt: Vec[String] = Vec.new();
    let mut routes: Vec[Route] = Vec.new();
    for line in data_lines("routes.conf")?.iter() {
        let words = words_of(line);
        if words[0] == "default" {
            let rest = tail_from(words, 1);
            default = parse_many(p, join(rest, " ")).map_err(|e| parse_err(e))?;
        } else if words[0] == "exempt" {
            exempt.push(words[1].clone());
        } else if words[0] == "route" {
            let mut rest = tail_from(words, 4);
            let mut cost = String.new();
            if rest[rest.len() - 1].starts_with("cost=") {
                let last = rest.pop().unwrap_or(String.new());
                cost = slice_from(last, 5);
            }
            let key = rest.pop().unwrap_or(String.new());
            let text = join(rest, " ");
            let items = if text == "-" { default.clone() } else { parse_many(p, text).map_err(|e| parse_err(e))? };
            let shown_cost = if cost.len() > 0 { f" cost={cost}" } else { String.new() };
            println(f"route {words[1]} {words[2]}: {words[3]} {items_repr(items)} by {key}{shown_cost}");
            routes.push(Route { method: words[1].clone(), path: words[2].clone(), strategy: strategy_of(words[3]), items: items, key: key, cost: cost });
        }
    }
    let mut counts: Vec[Count] = Vec.new();
    let mut refused: Vec[Count] = Vec.new();
    for line in data_lines("access.log")?.iter() {
        let f = words_of(line);
        let now = num_f64(f[0]);
        c.now = now;
        let ip = f[1].clone();
        let method = f[3 + 1].clone();
        let path = f[5].clone();
        let head = f"{now} {ip} {method} {path}";
        let scope = f"{method} {path}";
        let mut found: i64 = -1;
        let mut known_path = false;
        let mut k = 0;
        while k < routes.len() {
            if routes[k].path == path {
                known_path = true;
                if routes[k].method == method {
                    found = k;
                }
            }
            k += 1;
        }
        if found < 0 {
            let status = if known_path { 405 } else { 404 };
            println(f"{head} -> {status}");
            bump_count(mut counts, scope, status);
            continue;
        }
        let route = routes[found].clone_route();
        if contains_str(exempt, ip) {
            println(f"{head} -> 200 exempt");
            bump_count(mut counts, scope, 200);
            continue;
        }
        let mut key = if route.key == "ip" { ip.clone() } else if route.key == "user" { f[2].clone() } else { f[3].clone() };
        if key == "-" {
            key = ip.clone();
        }
        let rows = num_i64(f[6]);
        let cost = if route.cost == "rows" { max_i(1, rows) } else { 1 };
        let ids = ids_of(scope, key);
        lim.kind = route.strategy;
        let mut breached: i64 = -1;
        let mut i = 0;
        while i < route.items.len() {
            if not lim.hit(c, route.items[i], ids, cost) {
                breached = i;
                break;
            }
            i += 1;
        }
        if breached >= 0 {
            let item = route.items[breached].clone();
            let s = lim.stats(c, item, ids);
            let retry = ceil_int(s.reset_time - now);
            println(f"{head} as {key} cost={cost} -> 429 {stats_text(item, s)} retry-after={retry}");
            bump_count(mut counts, scope, 429);
            bump_count(mut refused, key, 0);
            continue;
        }
        let mut current: i64 = -1;
        let mut best = WindowStats { reset_time: 0.0, remaining: 0 };
        let mut i = 0;
        while i < route.items.len() {
            let s = lim.stats(c, route.items[i], ids);
            if current < 0 or s.remaining < best.remaining {
                current = i;
                best = s;
            }
            i += 1;
        }
        println(f"{head} as {key} cost={cost} -> 200 {stats_text(route.items[current], best)}");
        bump_count(mut counts, scope, 200);
    }
    println("responses:");
    // sorted by (scope, status)
    let mut i = 1;
    while i < counts.len() {
        let mut j = i;
        while j > 0 and (counts[j].name < counts[j - 1].name or (counts[j].name == counts[j - 1].name and counts[j].status < counts[j - 1].status)) {
            counts.swap(j - 1, j);
            j -= 1;
        }
        i += 1;
    }
    for cn in counts.iter() {
        println(f"  {cn.name} {cn.status}: {cn.n}");
    }
    println("refused clients:");
    let mut i = 1;
    while i < refused.len() {
        let mut j = i;
        while j > 0 and (refused[j].n > refused[j - 1].n or (refused[j].n == refused[j - 1].n and refused[j].name < refused[j - 1].name)) {
            refused.swap(j - 1, j);
            j -= 1;
        }
        i += 1;
    }
    for cn in refused.iter() {
        println(f"  {cn.name}: {cn.n}");
    }
    println(f"storage: {lim.store.storage.len()} counters, {lim.store.events.len()} moving windows");
    Ok(())
}

impl Route {
    fn clone_route(ref self) -> Route {
        Route { method: self.method.clone(), path: self.path.clone(), strategy: self.strategy, items: self.items.clone(), key: self.key.clone(), cost: self.cost.clone() }
    }
}

fn op_logins(p: ref Patterns, c: mut ref Clock) -> Result[(), String] {
    let mut lim = new_limiter(1);
    let per_user = parse_one(p, "3/minute").map_err(|e| parse_err(e))?;
    let per_ip = parse_one(p, "10/hour").map_err(|e| parse_err(e))?;
    let mut blocked: Vec[Count] = Vec.new();
    for line in data_lines("logins.log")?.iter() {
        let f = words_of(line);
        let now = num_f64(f[0]);
        c.now = now;
        let ip = f[1].clone();
        let user = f[2].clone();
        let head = f"{now} {ip} {user}";
        let ip_ids = ids_of("login", ip);
        let user_ids = ids_of("login", user);
        let mut stop: i64 = -1;
        if not lim.test(c, per_ip, ip_ids, 1) {
            stop = 0;
        } else if not lim.test(c, per_user, user_ids, 1) {
            stop = 1;
        }
        if stop >= 0 {
            let (item, ids, who) = if stop == 0 { (per_ip.clone(), ip_ids, ip.clone()) } else { (per_user.clone(), user_ids, user.clone()) };
            let s = lim.stats(c, item, ids);
            println(f"{head}: blocked by {item.repr()} for {who}, retry in {ceil_int(s.reset_time - now)}s");
            bump_count(mut blocked, ip, 0);
            continue;
        }
        lim.hit(c, per_ip, ip_ids, 1);
        lim.hit(c, per_user, user_ids, 1);
        if f[3] == "ok" {
            lim.clear(c, per_user, user_ids);
            let s = lim.stats(c, per_ip, ip_ids);
            println(f"{head}: signed in, {s.remaining} left for {ip}");
        } else {
            let s = lim.stats(c, per_user, user_ids);
            let start = s.reset_time - (per_user.get_expiry() as f64);
            println(f"{head}: wrong password, {s.remaining} left for {user} (window from {start})");
        }
    }
    let mut names: Vec[String] = Vec.new();
    for cn in blocked.iter() {
        names.push(cn.name.clone());
    }
    for ip in sort_strings(names).iter() {
        for cn in blocked.iter() {
            if cn.name == *ip {
                println(f"blocked {ip}: {cn.n}");
            }
        }
    }
    Ok(())
}

fn add_to(counts: mut ref Vec[Count], name: ref String, n: i64) {
    let mut k = 0;
    while k < counts.len() {
        if counts[k].name == *name {
            counts[k].n += n;
            return;
        }
        k += 1;
    }
    counts.push(Count { name: name.clone(), status: 0, n: n });
}

fn total_of(counts: ref Vec[Count], name: ref String) -> i64 {
    for cn in counts.iter() {
        if cn.name == *name {
            return cn.n;
        }
    }
    0
}

fn op_exports(p: ref Patterns, c: mut ref Clock) -> Result[(), String] {
    let mut lim = new_limiter(2);
    let quota = parse_one(p, "1000/hour").map_err(|e| parse_err(e))?;
    let mut done: Vec[Count] = Vec.new();
    let mut lost: Vec[Count] = Vec.new();
    for line in data_lines("exports.log")?.iter() {
        let f = words_of(line);
        let now = num_f64(f[0]);
        c.now = now;
        let tenant = f[1].clone();
        let n = num_i64(f[2]);
        let ids = ids_of("export", tenant);
        let ok = lim.hit(c, quota, ids, n);
        let s = lim.stats(c, quota, ids);
        let verdict = if ok { "accepted" } else { "refused" };
        println(f"{now} {tenant} {n} rows -> {verdict}, remaining={s.remaining} reset={s.reset_time}");
        add_to(mut done, tenant, if ok { n } else { 0 });
        add_to(mut lost, tenant, if ok { 0 } else { n });
    }
    let mut names: Vec[String] = Vec.new();
    for cn in done.iter() {
        names.push(cn.name.clone());
    }
    for t in sort_strings(names).iter() {
        println(f"{t}: {total_of(done, t)} rows exported, {total_of(lost, t)} refused");
    }
    Ok(())
}

fn op_boundary(p: ref Patterns, op: ref J, c: mut ref Clock) -> Result[(), String] {
    let item = parse_one(p, j_str(op, "limit")).map_err(|e| parse_err(e))?;
    let mut lims: Vec[Limiter] = Vec.new();
    let mut names: Vec[String] = Vec.new();
    let mut k = 0;
    while k < 3 {
        lims.push(new_limiter(k));
        names.push(strategy_name(k));
        k += 1;
    }
    println(f"{item.repr()}: {join(names, " | ")}");
    let mut taken: Vec[i64] = vec![0, 0, 0];
    let mut ids: Vec[String] = Vec.new();
    ids.push("client".to_string());
    for t in j_list(op, "times").iter() {
        if let J.N(text) = t {
            c.now = num_f64(text);
        }
        let mut cells: Vec[String] = Vec.new();
        let mut k = 0;
        while k < 3 {
            let ok = lims[k].hit(c, item, ids, 1);
            if ok {
                taken[k] += 1;
            }
            let s = lims[k].stats(c, item, ids);
            let mark = if ok { "ok " } else { "429" };
            cells.push(f"{mark} {s.remaining} {s.reset_time}");
            k += 1;
        }
        println(f"{c.now}: {join(cells, " | ")}");
    }
    let mut served: Vec[String] = Vec.new();
    let mut k = 0;
    while k < 3 {
        served.push(f"{names[k]} {taken[k]}");
        k += 1;
    }
    println(f"served: {join(served, ", ")}");
    Ok(())
}

fn read_data(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(s) => Ok(s),
        Err(e) => Err(f"{path}: {e}"),
    }
}

fn exc_to_string(e: ref Exc) -> String {
    exc_text(e)
}

fn run() -> Result[(), String] {
    let p = new_patterns()?;
    let mut c = Clock { now: 0.0 };
    let jobs = read_data("data/jobs.jsonl")?;
    for line in jobs.lines() {
        if line.len() == 0 {
            continue;
        }
        let j = json_line(line.to_string())?;
        println(f"== {j_str(j, "name")}");
        let mut store = new_memory();
        let mut lim = new_limiter(0);
        let mut has_limiter = false;
        if let J.A(ops) = j_get(j, "ops") {
            for op in ops.iter() {
                let kind = j_str(op, "op");
                if kind == "parse" {
                    op_parse(p, op);
                } else if kind == "parse_bytes" {
                    op_parse_bytes(op);
                } else if kind == "item" {
                    op_item(op);
                } else if kind == "key_for" {
                    op_key_for(p, op).map_err(|e| exc_to_string(e))?;
                } else if kind == "key_for_bytes" {
                    op_key_for_bytes(p, op).map_err(|e| exc_to_string(e))?;
                } else if kind == "compare" {
                    op_compare(p, op).map_err(|e| exc_to_string(e))?;
                } else if kind == "compare_ns" {
                    op_compare_ns(p, op).map_err(|e| exc_to_string(e))?;
                } else if kind == "sort" {
                    op_sort(p, op).map_err(|e| exc_to_string(e))?;
                } else if kind == "granularity" {
                    op_granularity(op);
                } else if kind == "strategy" {
                    lim = new_limiter(strategy_of(j_str(op, "name")));
                    has_limiter = true;
                } else if kind == "uri" {
                    op_uri(op);
                } else if kind == "from_string" {
                    op_from_string(op);
                } else if kind == "gateway" {
                    op_gateway(p, mut c)?;
                } else if kind == "logins" {
                    op_logins(p, mut c)?;
                } else if kind == "exports" {
                    op_exports(p, mut c)?;
                } else if kind == "boundary" {
                    op_boundary(p, op, mut c)?;
                } else if has_limiter {
                    op_strategy_step(p, op, mut lim, mut c).map_err(|e| exc_to_string(e))?;
                } else {
                    op_storage(op, mut store, mut c);
                }
            }
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}


