// mini_graphviz: the source-building side of the Python `graphviz`
// package. Graphs and digraphs are assembled a statement at a time, with
// the package's quoting of DOT identifiers, attribute lists, clusters and
// nested subgraphs, copies, clears and saved `.gv` files.
// README.md is the spec; oracle.py is the reference.

import std.encoding.hex_decode;

// ------------------------------------------------------------ text

/// A script word as text: `\s` is a space and `\N` a newline; any other
/// character, a backslash included, is itself.
fn text(word: Str) -> String {
    word.replace("\\s", " ").replace("\\N", "\n")
}

/// A name or value as the package sees it: the text, and whether it is a
/// `nohtml` string, which is never taken for an HTML-like label.
#[derive(Clone)]
struct Val {
    s: String,
    nohtml: bool,
}

fn plain(s: Str) -> Val {
    Val { s: s.to_string(), nohtml: false }
}

/// A first `!` makes the rest nohtml; a first `%` makes it
/// `escape(rest)`, every backslash doubled, also nohtml.
fn value(word: Str) -> Val {
    if word.starts_with("!") {
        Val { s: text(word[1..]), nohtml: true }
    } else if word.starts_with("%") {
        Val { s: text(word[1..]).replace("\\", "\\\\"), nohtml: true }
    } else {
        plain(text(word))
    }
}

/// Python's `repr` of a string, for the characters the script uses.
fn py_repr(s: Str) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == q {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// ------------------------------------------------------------ quoting

/// A Python `$` also matches before a final newline.
fn without_final_newline(s: Str) -> Str {
    if s.ends_with("\n") {
        s[0..s.len() - 1]
    } else {
        s
    }
}

fn is_digits(s: Str) -> bool {
    not s.is_empty() and s.chars().all(|c| c >= '0' and c <= '9')
}

/// `[a-zA-Z_][a-zA-Z0-9_]*`
fn is_name(s: Str) -> bool {
    let mut first = true;
    for c in s.chars() {
        let letter = c == '_' or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z');
        let digit = c >= '0' and c <= '9';
        if not (letter or (digit and not first)) {
            return false;
        }
        first = false;
    }
    not first
}

/// `-?(\.[0-9]+|[0-9]+(\.[0-9]*)?)`
fn is_number(s: Str) -> bool {
    let t = if s.starts_with("-") { s[1..] } else { s };
    if t.starts_with(".") {
        return is_digits(t[1..]);
    }
    match t.find(".") {
        Some(i) => {
            let rest = t[i + 1..];
            is_digits(t[0..i]) and (rest.is_empty() or is_digits(rest))
        }
        None => is_digits(t),
    }
}

fn is_id(s: Str) -> bool {
    let core = without_final_newline(s);
    is_name(core) or is_number(core)
}

fn is_keyword(s: Str) -> bool {
    let lower = s.to_lowercase();
    ["node", "edge", "graph", "digraph", "subgraph", "strict"].contains(lower.as_str())
}

/// `<.*>$`, the dot matching newlines too.
fn is_html(s: Str) -> bool {
    s.starts_with("<") and (s.ends_with(">") or s.ends_with(">\n"))
}

/// Whether the run of backslashes at the end, or before a final newline,
/// is odd.
fn odd_final_backslashes(s: Str) -> bool {
    let mut n = 0;
    for c in without_final_newline(s).chars().rev() {
        if c != '\\' {
            break;
        }
        n += 1;
    }
    n % 2 == 1
}

fn push_backslashes(out: mut ref String, n: i64) {
    for _ in 0..n {
        out.push('\\');
    }
}

/// Each `"`, with the backslashes before it, becomes the run (one
/// backslash fewer if it is odd) and `\"`.
fn escape_quotes(s: Str) -> String {
    let mut out = String.new();
    let mut run = 0;
    for c in s.chars() {
        if c == '\\' {
            run += 1;
            continue;
        }
        if c == '"' {
            push_backslashes(mut out, run - run % 2);
            out.push_str("\\\"");
        } else {
            push_backslashes(mut out, run);
            out.push(c);
        }
        run = 0;
    }
    push_backslashes(mut out, run);
    out
}

/// The package's `quote`: a DOT identifier, quoted when it has to be.
fn quote(v: Val, warnings: mut ref Vec[String]) -> String {
    let s = v.s.as_str();
    if is_html(s) and not v.nohtml {
        return v.s.clone();
    }
    if not is_id(s) or is_keyword(s) {
        if odd_final_backslashes(s) {
            warnings.push(f"expect syntax error scanning invalid quoted string: {py_repr(s)}");
        }
        return f"\"{escape_quotes(s)}\"";
    }
    v.s.clone()
}

/// `node[:port[:compass]]`, the parts as plain strings.
fn quote_edge(v: Val, warnings: mut ref Vec[String]) -> String {
    let s = v.s.as_str();
    let Some(i) = s.find(":") else {
        return quote(v, mut warnings);
    };
    let mut parts: Vec[String] = [quote(plain(s[0..i]), mut warnings)];
    let rest = s[i + 1..];
    if not rest.is_empty() {
        match rest.find(":") {
            Some(j) => {
                parts.push(quote(plain(rest[0..j]), mut warnings));
                let compass = rest[j + 1..];
                if not compass.is_empty() {
                    parts.push(compass.to_string());
                }
            }
            None => parts.push(quote(plain(rest), mut warnings)),
        }
    }
    parts.join(":")
}

/// `label=v` first when there is a label, then each attribute in key
/// order, keys and values quoted.
fn a_list(label: Option[Val], attrs: SortedMap[String, Val], warnings: mut ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    if let Some(l) = label {
        parts.push(f"label={quote(l, mut warnings)}");
    }
    for (k, v) in attrs.iter() {
        let key = quote(plain(k), mut warnings);
        parts.push(f"{key}={quote(v, mut warnings)}");
    }
    parts.join(" ")
}

fn attr_list(label: Option[Val], attrs: SortedMap[String, Val], warnings: mut ref Vec[String]) -> String {
    let content = a_list(label, attrs, mut warnings);
    if content.is_empty() {
        String.new()
    } else {
        f" [{content}]"
    }
}

// ------------------------------------------------------------ graphs

#[derive(Clone)]
struct Graph {
    directed: bool,
    strict: bool,
    // An empty name or comment is none, as the package's `if self.name`
    // reads it.
    name: Val,
    comment: String,
    graph_attr: SortedMap[String, Val],
    node_attr: SortedMap[String, Val],
    edge_attr: SortedMap[String, Val],
    // Verbatim source lines, each ending with a newline.
    body: Vec[String],
}

impl Graph {
    fn class_name(ref self) -> Str {
        if self.directed { "Digraph" } else { "Graph" }
    }

    /// The source's lines, as the package's `__iter__` yields them; as a
    /// subgraph, with a `subgraph` head and never strict.
    fn lines(ref self, subgraph: bool, warnings: mut ref Vec[String]) -> Result[Vec[String], String] {
        let mut out: Vec[String] = Vec.new();
        if not self.comment.is_empty() {
            out.push(f"// {self.comment}\n");
        }
        if subgraph and self.strict {
            return Err("subgraphs cannot be strict");
        }
        let name = if self.name.s.is_empty() {
            String.new()
        } else {
            f"{quote(self.name, mut warnings)} "
        };
        if subgraph {
            if name.is_empty() {
                out.push("{\n");
            } else {
                out.push(f"subgraph {name}{{\n");
            }
        } else {
            let strict = if self.strict { "strict " } else { "" };
            let kind = if self.directed { "digraph" } else { "graph" };
            out.push(f"{strict}{kind} {name}{{\n");
        }
        let none: Option[Val] = None;
        for (kw, attrs) in [("graph", self.graph_attr.clone()), ("node", self.node_attr.clone()), ("edge", self.edge_attr.clone())].iter() {
            if not attrs.is_empty() {
                out.push(f"\t{kw}{attr_list(none, attrs, mut warnings)}\n");
            }
        }
        for line in self.body.iter() {
            out.push(line.clone());
        }
        out.push("}\n");
        Ok(out)
    }

    fn source(ref self, warnings: mut ref Vec[String]) -> Result[String, String] {
        Ok(self.lines(false, warnings)?.join(""))
    }

    /// The package's `subgraph(other)`: the other graph's lines, each
    /// indented by a tab.
    fn add_subgraph(mut ref self, other: Graph, warnings: mut ref Vec[String]) -> Result[(), String] {
        if other.directed != self.directed {
            return Err(f"<graphviz.graphs.{self.class_name()} object> cannot add subgraph of different kind: <graphviz.graphs.{other.class_name()} object>");
        }
        let lines = other.lines(true, warnings)?;
        for line in lines.iter() {
            self.body.push(f"\t{line}");
        }
        Ok(())
    }

    fn clear(mut ref self, keep_attrs: bool) {
        if not keep_attrs {
            self.graph_attr.clear();
            self.node_attr.clear();
            self.edge_attr.clear();
        }
        self.body.clear();
    }
}

// ------------------------------------------------------------ the script

/// `K=V` words as a dict sorted by key; a repeated key keeps its last value.
fn pairs(words: Slice[String]) -> Result[SortedMap[String, Val], String] {
    let mut out: SortedMap[String, Val] = SortedMap.new();
    for w in words.iter() {
        let Some(i) = w.find("=") else {
            return Err(f"bad attribute {w}");
        };
        out.insert(text(w[0..i]), value(w[i + 1..]));
    }
    Ok(out)
}

/// The options of `begin` and `subgraph`, as a graph of the given kind.
fn options(words: Slice[String], directed: bool, allow_strict: bool) -> Result[Graph, String] {
    let mut g = Graph {
        directed,
        strict: false,
        name: plain(""),
        comment: String.new(),
        graph_attr: SortedMap.new(),
        node_attr: SortedMap.new(),
        edge_attr: SortedMap.new(),
        body: Vec.new(),
    };
    let mut named = false;
    let mut commented = false;
    for w in words.iter() {
        if w == "strict" and allow_strict {
            g.strict = true;
            continue;
        }
        let Some(i) = w.find("=") else {
            return Err(f"bad option {w}");
        };
        let k = w[0..i];
        let v = value(w[i + 1..]);
        if k == "name" or k == "comment" {
            if (k == "name" and named) or (k == "comment" and commented) {
                return Err(f"repeated option {k}");
            }
            if k == "name" {
                named = true;
                g.name = v;
            } else {
                commented = true;
                g.comment = v.s;
            }
            continue;
        }
        let Some(d) = k.find(".") else {
            return Err(f"bad option {w}");
        };
        let key = text(k[d + 1..]);
        match k[0..d] {
            "graph" => { g.graph_attr.insert(key, v); }
            "node" => { g.node_attr.insert(key, v); }
            "edge" => { g.edge_attr.insert(key, v); }
            _ => return Err(f"bad option {w}"),
        };
    }
    Ok(g)
}

fn is_file_name(s: Str) -> bool {
    if not s.ends_with(".gv") {
        return false;
    }
    let stem = s[0..s.len() - 3];
    not stem.is_empty() and stem.chars().all(|c| c == '_' or (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9'))
}

/// A graph open for statements: a top-level one under its key, or a
/// subgraph (an empty key).
struct Frame {
    key: String,
    g: Graph,
}

struct Player {
    docs: Map[String, Graph],
    stack: Vec[Frame],
}

impl Player {
    /// The index of the innermost open graph.
    fn open(ref self, cmd: Str) -> Result[i64, String] {
        if self.stack.is_empty() {
            return Err(f"{cmd} needs an open graph");
        }
        Ok(self.stack.len() - 1)
    }

    fn doc(ref self, key: Str) -> Result[ref Graph, String] {
        match self.docs.get(key) {
            Some(g) => Ok(g),
            None => Err(f"no graph {key}"),
        }
    }

    fn run(mut ref self, words: Slice[String], warnings: mut ref Vec[String]) -> Result[Vec[String], String] {
        let cmd = words[0].as_str();
        let none: Vec[String] = Vec.new();
        match cmd {
            "begin" => {
                if not self.stack.is_empty() {
                    return Err(f"begin inside {self.stack[0].key}");
                }
                if words.len() < 3 or not ["graph", "digraph"].contains(words[2].as_str()) {
                    return Err("usage: begin KEY graph|digraph [OPTION ...]");
                }
                if self.docs.contains_key(words[1]) {
                    return Err(f"graph {words[1]} exists");
                }
                let g = options(words[3..], words[2] == "digraph", true)?;
                self.stack.push(Frame { key: words[1].clone(), g });
                Ok(none)
            }
            "subgraph" => {
                let i = self.open(cmd)?;
                let g = options(words[1..], self.stack[i].g.directed, false)?;
                self.stack.push(Frame { key: String.new(), g });
                Ok(none)
            }
            "end" => {
                if words.len() != 1 {
                    return Err("usage: end");
                }
                let i = self.open(cmd)?;
                let Some(f) = self.stack.pop() else {
                    return Err("end needs an open graph");
                };
                if i > 0 {
                    self.stack[i - 1].g.add_subgraph(f.g, warnings)?;
                    return Ok(none);
                }
                let n = f.g.body.len();
                self.docs.insert(f.key.clone(), f.g);
                Ok([f"  built {f.key}: {n} body lines"])
            }
            "node" => {
                let i = self.open(cmd)?;
                if words.len() < 2 {
                    return Err("usage: node NAME [K=V ...]");
                }
                let mut attrs = pairs(words[2..])?;
                let label = attrs.remove("label");
                let name = quote(value(words[1]), mut warnings);
                let list = attr_list(label, attrs, mut warnings);
                self.stack[i].g.body.push(f"\t{name}{list}\n");
                Ok(none)
            }
            "edge" => {
                let i = self.open(cmd)?;
                if words.len() < 3 {
                    return Err("usage: edge TAIL HEAD [K=V ...]");
                }
                let mut attrs = pairs(words[3..])?;
                let label = attrs.remove("label");
                let tail = quote_edge(value(words[1]), mut warnings);
                let head = quote_edge(value(words[2]), mut warnings);
                let list = attr_list(label, attrs, mut warnings);
                let op = if self.stack[i].g.directed { "->" } else { "--" };
                self.stack[i].g.body.push(f"\t{tail} {op} {head}{list}\n");
                Ok(none)
            }
            "edges" => {
                let i = self.open(cmd)?;
                let ends = words[1..];
                if ends.is_empty() or ends.len() % 2 == 1 {
                    return Err("usage: edges TAIL HEAD [TAIL HEAD ...]");
                }
                let op = if self.stack[i].g.directed { "->" } else { "--" };
                let mut k = 0;
                while k < ends.len() {
                    let tail = quote_edge(value(ends[k]), mut warnings);
                    let head = quote_edge(value(ends[k + 1]), mut warnings);
                    self.stack[i].g.body.push(f"\t{tail} {op} {head}\n");
                    k += 2;
                }
                Ok(none)
            }
            "attr" => {
                let i = self.open(cmd)?;
                let mut rest = words[1..];
                let mut kw: Option[String] = None;
                if not rest.is_empty() and not rest[0].contains("=") {
                    kw = Some(rest[0].clone());
                    rest = rest[1..];
                }
                let attrs = pairs(rest)?;
                if let Some(ref k) = kw {
                    if not ["graph", "node", "edge"].contains(k.to_lowercase().as_str()) {
                        return Err(f"attr statement must target graph, node, or edge: {py_repr(k)}");
                    }
                }
                if attrs.is_empty() {
                    return Ok(none);
                }
                let none_label: Option[Val] = None;
                let line = match kw {
                    None => f"\t{a_list(none_label, attrs, mut warnings)}\n",
                    Some(k) => f"\t{k}{attr_list(none_label, attrs, mut warnings)}\n",
                };
                self.stack[i].g.body.push(line);
                Ok(none)
            }
            "include" => {
                let i = self.open(cmd)?;
                if words.len() != 2 {
                    return Err("usage: include KEY");
                }
                let other = self.doc(words[1])?.clone();
                self.stack[i].g.add_subgraph(other, warnings)?;
                Ok(none)
            }
            "print" | "copy" | "clear" | "save" => {
                if not self.stack.is_empty() {
                    return Err(f"{cmd} inside {self.stack[0].key}");
                }
                self.built(cmd, words, warnings)
            }
            _ => Err(f"unknown command {cmd}"),
        }
    }

    /// `print`, `copy`, `clear` and `save`, on built graphs.
    fn built(mut ref self, cmd: Str, words: Slice[String], warnings: mut ref Vec[String]) -> Result[Vec[String], String] {
        let none: Vec[String] = Vec.new();
        match cmd {
            "print" => {
                if words.len() != 2 {
                    return Err("usage: print KEY");
                }
                let src = self.doc(words[1])?.source(warnings)?;
                let parts: Vec[Str] = src.split("\n").collect();
                let mut out: Vec[String] = Vec.new();
                for p in parts[0..parts.len() - 1].iter() {
                    out.push(f"  {p}");
                }
                Ok(out)
            }
            "copy" => {
                if words.len() != 3 {
                    return Err("usage: copy KEY NEW");
                }
                let g = self.doc(words[1])?.clone();
                if self.docs.contains_key(words[2]) {
                    return Err(f"graph {words[2]} exists");
                }
                self.docs.insert(words[2].clone(), g);
                Ok(none)
            }
            "clear" => {
                let keep = words.len() == 3 and words[2] == "keep";
                if not (words.len() == 2 or keep) {
                    return Err("usage: clear KEY [keep]");
                }
                self.doc(words[1])?;
                if let Some(g) = self.docs.get_mut(words[1]) {
                    g.clear(keep);
                }
                Ok(none)
            }
            _ => {
                if words.len() != 3 {
                    return Err("usage: save KEY FILE");
                }
                let g = self.doc(words[1])?;
                if not is_file_name(words[2]) {
                    return Err(f"bad file name {words[2]}");
                }
                let src = g.source(warnings)?;
                let path = f"data/out/{words[2]}";
                fs.write(path, src).map_err(|e| f"cannot write {path}: {e}")?;
                let back = fs.read_to_string(path).map_err(|e| f"cannot read {path}: {e}")?;
                let lines: Vec[Str] = back.split("\n").collect();
                let n = lines.len() - 1;
                let mut out: Vec[String] = [f"  saved out/{words[2]}: {n} lines, {back.len()} bytes"];
                for l in lines[0..n].iter() {
                    out.push(f"  {l}");
                }
                Ok(out)
            }
        }
    }
}

fn play(script: Str) {
    let mut player = Player { docs: Map.new(), stack: Vec.new() };
    println("== mini_graphviz");
    for (i, line) in script.split("\n").enumerate() {
        let words: Vec[String] = line.split_whitespace().map(|w| w.to_string()).collect();
        if words.is_empty() or words[0].starts_with("#") {
            continue;
        }
        println(f"> {words.join(" ")}");
        let mut warnings: Vec[String] = Vec.new();
        let result = player.run(words, warnings);
        for w in warnings.iter() {
            println(f"  warning: script.txt:{i + 1}: {w}");
        }
        match result {
            Ok(lines) => {
                for l in lines.iter() {
                    println(l);
                }
            }
            Err(e) => println(f"  error: script.txt:{i + 1}: {e}"),
        }
    }
    println("== end");
    println(f"  {player.docs.len()} graphs built");
}

fn run() -> Result[(), String] {
    fs.create_dir_all("data/out").map_err(|e| f"cannot create data/out: {e}")?;
    write_data()?;
    let text = fs.read_to_string("data/script.txt").map_err(|e| f"cannot read data/script.txt: {e}")?;
    play(text);
    Ok(())
}

fn put_bytes(path: Str, hex: Str) -> Result[(), String] {
    let digits: String = hex.chars().filter(|c| not c.is_whitespace()).collect();
    let bytes = hex_decode(digits).map_err(|e| f"bad data for {path}: {e}")?;
    fs.write_bytes(path, bytes).map_err(|e| f"cannot write {path}: {e}")
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/script.txt", file_0())?;
    Ok(())
}

