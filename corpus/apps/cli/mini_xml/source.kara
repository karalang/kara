fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data/bad")?;
    put("data/bad/amp.xml", file_0())?;
    put("data/bad/attrlt.xml", file_1())?;
    put("data/bad/badname.xml", file_2())?;
    put("data/bad/badtoken.xml", file_3())?;
    put("data/bad/cdata.xml", file_4())?;
    put("data/bad/charref.xml", file_5())?;
    put("data/bad/close.xml", file_6())?;
    put("data/bad/decl.xml", file_7())?;
    put("data/bad/dupattr.xml", file_8())?;
    put("data/bad/empty.xml", file_9())?;
    put("data/bad/entity.xml", file_10())?;
    put("data/bad/junk.xml", file_11())?;
    put("data/bad/mismatch.xml", file_12())?;
    put("data/bad/noquote.xml", file_13())?;
    put("data/bad/prefix.xml", file_14())?;
    put("data/bad/text.xml", file_15())?;
    put("data/bad/unclosed.xml", file_16())?;
    put("data/bad/unterminated.xml", file_17())?;
    make_dir("data")?;
    put("data/config.xml", file_18())?;
    put("data/feed.xml", file_19())?;
    put("data/icon.svg", file_20())?;
    put("data/pom.xml", file_21())?;
    put("data/queries.txt", file_22())?;
    put("data/sitemap.xml", file_23())?;
    Ok(())
}

// ------------------------------------------------------------ the report

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

impl Tree {
    fn dump(ref self, e: i64, depth: i64) {
        let mut line = String.new();
        for _ in 0..depth {
            line.push_str("  ");
        }
        line.push_str(self.els[e].tag);
        for k in 0..self.els[e].keys.len() {
            line.push_str(f" {self.els[e].keys[k]}={py_repr(self.els[e].vals[k])}");
        }
        if strip(self.els[e].text).len() > 0 {
            line.push_str(f" text={py_repr(self.els[e].text)}");
        }
        if strip(self.els[e].tail).len() > 0 {
            line.push_str(f" tail={py_repr(self.els[e].tail)}");
        }
        println(line);
        for k in 0..self.els[e].kids.len() {
            self.dump(self.els[e].kids[k], depth + 1);
        }
    }

    fn show(ref self, e: Option[i64]) -> String {
        match e {
            Some(e) => {
                let t = strip(self.els[e].text);
                if t.len() > 0 { f"{self.els[e].tag} {py_repr(t)}" } else { self.els[e].tag.clone() }
            }
            None => "None".to_string(),
        }
    }
}

fn query(t: ref Tree, method: Str, path: Str) -> Result[(), String] {
    if method == "findall" {
        let found = t.findall(0, path)?;
        for i in 0..found.len() {
            println(f"  {t.show(Some(found[i]))}");
        }
    } else if method == "find" {
        println(f"  {t.show(t.find(0, path)?)}");
    } else if method == "findtext" {
        match t.findtext(0, path)? {
            Some(s) => println(f"  {py_repr(s)}"),
            None => println("  None"),
        }
    } else if method == "itertext" {
        match t.find(0, path)? {
            Some(e) => println(f"  {py_repr(t.all_text(e))}"),
            None => return Err(f"{path}: nothing to iterate"),
        }
    } else {
        return Err(f"unknown method {method}");
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let docs = ["feed.xml", "pom.xml", "icon.svg", "config.xml", "sitemap.xml"];
    let mut names: Vec[String] = Vec.new();
    let mut trees: Vec[Tree] = Vec.new();
    for d in 0..docs.len() {
        let name = docs[d].clone();
        let t = parse_xml(read(f"data/{name}")?).map_err(|e| f"{name}: {e}")?;
        println(f"== {name}");
        t.dump(0, 0);
        println("-- serialized");
        println(t.tostring(0));
        names.push(name.to_string());
        trees.push(t);
    }
    println("== queries");
    let qs = lines_of(read("data/queries.txt")?);
    for i in 0..qs.len() {
        let parts = split_on(qs[i], b'|');
        println(f"{parts[0]} {parts[1]} {parts[2]}");
        let mut at: i64 = -1;
        for k in 0..names.len() {
            if names[k] == parts[0] {
                at = k;
            }
        }
        if at < 0 {
            return Err(f"no document {parts[0]}");
        }
        if let Err(e) = query(trees[at], parts[1], parts[2]) {
            println(f"  SyntaxError: {e}");
        }
    }
    println("== errors");
    let mut bad = match fs.read_dir("data/bad".to_string()) {
        Ok(v) => v,
        Err(e) => return Err(f"cannot list data/bad: {e}"),
    };
    bad.sort();
    for i in 0..bad.len() {
        match parse_xml(read(f"data/bad/{bad[i]}")?) {
            Ok(_) => println(f"{bad[i]}: parsed"),
            Err(e) => println(f"{bad[i]}: {e}"),
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_xml: {e}");
    }
}
