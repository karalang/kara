    <ns0:circle cx="28" cy="28" r="26" fill="url(#g1)" />
    <ns0:path d="M16 40 L28 14 L40 40 Z" fill="none" stroke="white" stroke-width="3" />
    <ns0:use ns1:href="#g1" x="2" />
    <ns0:text x="32" y="60" font-size="8" text-anchor="middle">kāra</ns0:text>
