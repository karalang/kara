== feed.xml
rss version='2.0'
  channel
    title text='Kara Releases'
    link text='https://example.org/releases'
    {http://www.w3.org/2005/Atom}link href='https://example.org/feed.xml' rel='self' type='application/rss+xml'
    description text='News & releases from the Kara project — weekly'
    item
      title text='Version 0.9 — "MIR everywhere"'
      link text='https://example.org/releases/0.9'
      {http://purl.org/dc/elements/1.1/}creator text='Gowtham'
      category text='compiler'
      category text='release'
      pubDate text='Wed, 14 Oct 2026 09:00:00 GMT'
      description text='<p>The <b>MIR</b> backend is now the default & legacy is frozen.</p>'
    item
      title text='Version 0.8'
      link text='https://example.org/releases/0.8'
      {http://purl.org/dc/elements/1.1/}creator text='Release bot'
      category text='release'
      pubDate text='Mon, 05 Oct 2026 09:00:00 GMT'
      description text="Bugs fixed: 41. It's faster."
      enclosure url='https://example.org/kara-0.8.tar.gz' length='1048576' type='application/gzip'
    item
      title text='Security notice'
      link text='https://example.org/notices/1'
      category text='security'
      description text='Upgrade to 0.8.1 if you use <TaskGroup>.'
-- serialized
<rss xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:ns0="http://www.w3.org/2005/Atom" version="2.0">
  <channel>
    <title>Kara Releases</title>
    <link>https://example.org/releases</link>
    <ns0:link href="https://example.org/feed.xml" rel="self" type="application/rss+xml" />
    <description>News &amp; releases from the Kara project — weekly</description>
    <item>
      <title>Version 0.9 — "MIR everywhere"</title>
      <link>https://example.org/releases/0.9</link>
      <dc:creator>Gowtham</dc:creator>
      <category>compiler</category>
      <category>release</category>
      <pubDate>Wed, 14 Oct 2026 09:00:00 GMT</pubDate>
      <description>&lt;p&gt;The &lt;b&gt;MIR&lt;/b&gt; backend is now the default &amp; legacy is frozen.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Version 0.8</title>
      <link>https://example.org/releases/0.8</link>
      <dc:creator>Release bot</dc:creator>
      <category>release</category>
      <pubDate>Mon, 05 Oct 2026 09:00:00 GMT</pubDate>
      <description>Bugs fixed: 41. It's faster.</description>
      <enclosure url="https://example.org/kara-0.8.tar.gz" length="1048576" type="application/gzip" />
    </item>
    <item>
      <title>Security notice</title>
      <link>https://example.org/notices/1</link>
      <category>security</category>
      <description>Upgrade to 0.8.1 if you use &lt;TaskGroup&gt;.</description>
    </item>
  </channel>
</rss>
