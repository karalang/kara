== config.xml
config env='production' owner='Acme & Sons'
  server host='0.0.0.0' port='8443' tls='on'
    timeout unit='s' text='30'
    limits connections='1024' requests-per-second='250'
  database url='postgres://db:5432/orders' pool='20' text='primary'
  database url='postgres://replica:5432/orders' pool='5' readonly='true' text='replica'
  feature name='beta-ui' enabled='false'
  feature name='new-pricing' enabled='true' text='rollout 25%'
  banner text='Welcome to Acme & Sons.\tTabs and\nnew lines are kept.'
  note attr='line one line two\nthree tab'
-- serialized
<config env="production" owner="Acme &amp; Sons">
  <server host="0.0.0.0" port="8443" tls="on">
    <timeout unit="s">30</timeout>
    <limits connections="1024" requests-per-second="250" />
  </server>
  <database url="postgres://db:5432/orders" pool="20">primary</database>
  <database url="postgres://replica:5432/orders" pool="5" readonly="true">replica</database>
  <feature name="beta-ui" enabled="false" />
  <feature name="new-pricing" enabled="true">rollout 25%</feature>
  <banner>Welcome to Acme &amp; Sons.	Tabs and
new lines are kept.</banner>
  <note attr="line one line two&#10;three tab" />
</config>
