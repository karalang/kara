  <ns0:defs>
    <ns0:linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><ns0:stop offset="0" stop-color="#ff6a00" /><ns0:stop offset="1" stop-color="#ee0979" /></ns0:linearGradient>
  </ns0:defs>
