    <ns0:dependency>
      <ns0:groupId>com.fasterxml.jackson.core</ns0:groupId>
      <ns0:artifactId>jackson-databind</ns0:artifactId>
      <ns0:version>${jackson.version}</ns0:version>
    </ns0:dependency>
    <ns0:dependency>
      <ns0:groupId>org.postgresql</ns0:groupId>
      <ns0:artifactId>postgresql</ns0:artifactId>
      <ns0:version>42.7.4</ns0:version>
      <ns0:scope>runtime</ns0:scope>
    </ns0:dependency>
    <ns0:dependency>
      <ns0:groupId>org.junit.jupiter</ns0:groupId>
      <ns0:artifactId>junit-jupiter</ns0:artifactId>
      <ns0:version>5.11.0</ns0:version>
      <ns0:scope>test</ns0:scope>
    </ns0:dependency>
  </ns0:dependencies>
</ns0:project>
