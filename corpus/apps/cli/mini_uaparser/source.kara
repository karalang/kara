// mini_uaparser: ua-parser 0.18.0 (Python), with the user agent,
// operating system and device parsers of uap-core's regexes.yaml, run
// over the user agents of a web shop's access log. See README.md.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

// s[start:end], clamped to the string the way Python clamps a slice
fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = if start < 0 { 0 } else { start };
    let stop = if end > s.len() { s.len() } else { end };
    while i < stop {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

#[derive(Clone)]
struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    // a literal every match contains, lowered (see required_runs)
    // the subject (lowered) can only match if it holds one of these
    // (no strings: no such test)
    needs: Vec[Vec[i64]],
    // the characters a match can start with, lowered; empty for any
    firsts: Vec[i64],
    // for each ASCII character, whether its lowered form is in firsts
    first_tab: Vec[bool],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    let needs = need_set(p.nodes);
    let firsts = first_set(p.nodes, 0, (p.flags & flag_i()) != 0).unwrap_or(Vec.new());
    let mut first_tab: Vec[bool] = Vec.new();
    let mut ch = 0;
    while ch < 128 {
        first_tab.push(in_firsts(firsts, lower(ch, false)));
        ch += 1;
    }
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names, needs: needs, firsts: firsts, first_tab: first_tab })
}

// The characters a match can start with, lowered, when the pattern
// opens with literals or a set of them (sre's INFO charset): None when
// it can start with anything, or with nothing.
fn first_set(nodes: ref Vec[Node], from: i64, icase: bool) -> Option[Vec[i64]] {
    let mut i = from;
    while i < nodes.len() {
        match nodes[i] {
            Node.At(_) => {}
            Node.Assert(_, _, _) => {}
            Node.Lit(c) => return Some(vec![lower(c, false)]),
            Node.In(items, negate) => {
                if negate or icase {
                    return None;
                }
                let mut out: Vec[i64] = Vec.new();
                for it in items.iter() {
                    match it {
                        Item.Lit(c) => out.push(lower(c, false)),
                        _ => return None,
                    }
                }
                return Some(out);
            }
            Node.Group(_, on, _, inner) => {
                return first_set(inner, 0, icase or (on & flag_i()) != 0);
            }
            Node.Repeat(_, min, _, inner) => {
                if min < 1 {
                    return None;
                }
                return first_set(inner, 0, icase);
            }
            Node.Branch(alts) => {
                let mut out: Vec[i64] = Vec.new();
                for alt in alts.iter() {
                    let f = first_set(alt, 0, icase)?;
                    for c in f {
                        out.push(c);
                    }
                }
                return Some(out);
            }
            _ => return None,
        }
        i += 1;
    }
    None
}

// Runs of literal characters every match must contain, lowered (so a
// test against the lowered subject is necessary whatever the flags):
// a search can skip a subject that lacks the longest of them.
fn required_runs(nodes: ref Vec[Node], runs: mut ref Vec[Vec[i64]], cur: mut ref Vec[i64]) {
    for n in nodes.iter() {
        match n {
            Node.Lit(c) => cur.push(lower(c, false)),
            Node.In(items, false) => match one_char(items) {
                Some(c) => cur.push(c),
                None => {
                    runs.push(cur.clone());
                    cur.clear();
                }
            },
            Node.Group(_, _, _, inner) => required_runs(inner, mut runs, mut cur),
            Node.At(_) => {}
            Node.Assert(_, _, _) => {}
            Node.Repeat(_, min, _, inner) => {
                runs.push(cur.clone());
                cur.clear();
                if min >= 1 {
                    required_runs(inner, mut runs, mut cur);
                    runs.push(cur.clone());
                    cur.clear();
                }
            }
            _ => {
                runs.push(cur.clone());
                cur.clear();
            }
        }
    }
}

// A set like [Ss] whose members all lower to one character.
fn one_char(items: ref Vec[Item]) -> Option[i64] {
    let mut c = -1;
    for it in items.iter() {
        match it {
            Item.Lit(x) => {
                let l = lower(x, false);
                if c >= 0 and l != c {
                    return None;
                }
                c = l;
            }
            _ => return None,
        }
    }
    if c >= 0 { Some(c) } else { None }
}

// The longest run of characters every match holds.
fn longest_run(nodes: ref Vec[Node]) -> Vec[i64] {
    let mut runs: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    required_runs(nodes, mut runs, mut cur);
    runs.push(cur);
    let mut need: Vec[i64] = Vec.new();
    for r in runs {
        if r.len() > need.len() {
            need = r.clone();
        }
    }
    need
}

fn shortest(set: ref Vec[Vec[i64]]) -> i64 {
    let mut n = -1;
    for r in set.iter() {
        if n < 0 or r.len() < n {
            n = r.len();
        }
    }
    n
}

// Strings one of which every match holds (lowered): the longest
// required run, or, when an alternation every match passes through gives
// longer ones, one run for each of its branches. Empty when there is
// nothing to test.
fn need_set(nodes: ref Vec[Node]) -> Vec[Vec[i64]] {
    let mut best: Vec[Vec[i64]] = Vec.new();
    let run = longest_run(nodes);
    if run.len() > 0 {
        best.push(run);
    }
    for n in nodes.iter() {
        let cand = match n {
            Node.Group(_, _, _, inner) => need_set(inner),
            Node.Atomic(inner) => need_set(inner),
            Node.Repeat(_, min, _, inner) => if min >= 1 { need_set(inner) } else { Vec.new() },
            Node.Branch(alts) => {
                let mut set: Vec[Vec[i64]] = Vec.new();
                let mut ok = true;
                for a in alts.iter() {
                    let sub = need_set(a);
                    if sub.len() == 0 {
                        ok = false;
                        break;
                    }
                    for r in sub.iter() {
                        set.push(r.clone());
                    }
                }
                if ok { set } else { Vec.new() }
            }
            _ => Vec.new(),
        };
        if cand.len() > 0 and (best.len() == 0 or shortest(cand) > shortest(best)) {
            best = cand;
        }
    }
    best
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// Whether a match can start at c: the first-character prefilter.
fn can_start(prog: ref Program, c: i64) -> bool {
    if c >= 0 and c < 128 {
        return prog.first_tab[c];
    }
    in_firsts(prog.firsts, lower(c, false))
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        if mode == 0 and prog.firsts.len() > 0 {
            while start < m.s.len() and not can_start(prog, m.s[start]) {
                start += 1;
            }
            if start >= m.s.len() {
                return None;
            }
        }
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

// ----------------------------------------------------------- ua_parser

#[derive(Clone)]
struct UaDef {
    pat: String,
    flags: i64,
    family: Option[String],
    v1: Option[String],
    v2: Option[String],
}

#[derive(Clone)]
struct OsDef {
    pat: String,
    flags: i64,
    os: Option[String],
    v1: Option[String],
    v2: Option[String],
    v3: Option[String],
    v4: Option[String],
}

#[derive(Clone)]
struct DevDef {
    pat: String,
    flags: i64,
    device: Option[String],
    brand: Option[String],
    model: Option[String],
}

// What UserAgentParser.Parse, OSParser.Parse and DeviceParser.Parse
// return.
#[derive(Clone)]
struct UaHit {
    family: Option[String],
    v1: Option[String],
    v2: Option[String],
    v3: Option[String],
}

#[derive(Clone)]
struct OsHit {
    os: Option[String],
    v1: Option[String],
    v2: Option[String],
    v3: Option[String],
    v4: Option[String],
}

#[derive(Clone)]
struct DevHit {
    device: Option[String],
    brand: Option[String],
    model: Option[String],
}

// The dicts ParseUserAgent, ParseOS and ParseDevice return.
#[derive(Clone)]
struct UaRes {
    family: String,
    major: Option[String],
    minor: Option[String],
    patch: Option[String],
}

#[derive(Clone)]
struct OsRes {
    family: String,
    major: Option[String],
    minor: Option[String],
    patch: Option[String],
    patch_minor: Option[String],
}

#[derive(Clone)]
struct DevRes {
    family: String,
    brand: Option[String],
    model: Option[String],
}

// A dict of _PARSE_CACHE: the string and the results in the order they
// were added (0 user_agent, 1 os, 2 device).
#[derive(Clone)]
struct CacheEntry {
    string: String,
    order: Vec[i64],
    ua: Option[UaRes],
    os: Option[OsRes],
    dev: Option[DevRes],
}

// One list of parsers, compiled, with the prefilter text of each.
struct Compiled {
    progs: Vec[Program],
    needs: Vec[Vec[String]],
}

struct State {
    ua_defs: Vec[UaDef],
    os_defs: Vec[OsDef],
    dev_defs: Vec[DevDef],
    ua: Compiled,
    os: Compiled,
    dev: Compiled,
    // the dicts _lookup made, and _PARSE_CACHE, which names some of them
    entries: Vec[CacheEntry],
    cache: Map[String, i64],
    warnings: Vec[String],
    fills: i64,
}

fn max_cache_size() -> i64 { 200 }

fn js_warning() -> Str { "DeprecationWarning: javascript overrides are deprecated and will be removed next release" }

fn compile_all(pats: ref Vec[(String, i64)]) -> Compiled {
    let mut c = Compiled { progs: Vec.new(), needs: Vec.new() };
    for (p, f) in pats.iter() {
        match compile(cps(p), f) {
            Ok(pr) => {
                let mut ns: Vec[String] = Vec.new();
                for r in pr.needs.iter() {
                    ns.push(to_string(r));
                }
                c.needs.push(ns);
                c.progs.push(pr);
            }
            Err(e) => panic(f"cannot compile {p}: {err_text(e)}"),
        }
    }
    c
}

fn new_state() -> State {
    let ua_defs = ua_defs();
    let os_defs = os_defs();
    let dev_defs = dev_defs();
    let mut up: Vec[(String, i64)] = Vec.new();
    for d in ua_defs.iter() { up.push((d.pat.clone(), d.flags)); }
    let mut op: Vec[(String, i64)] = Vec.new();
    for d in os_defs.iter() { op.push((d.pat.clone(), d.flags)); }
    let mut dp: Vec[(String, i64)] = Vec.new();
    for d in dev_defs.iter() { dp.push((d.pat.clone(), d.flags)); }
    State {
        ua: compile_all(up),
        os: compile_all(op),
        dev: compile_all(dp),
        ua_defs: ua_defs,
        os_defs: os_defs,
        dev_defs: dev_defs,
        entries: Vec.new(),
        cache: Map.new(),
        warnings: Vec.new(),
        fills: 0,
    }
}

fn truthy(o: ref Option[String]) -> bool {
    match o {
        Some(s) => s.len() > 0,
        None => false,
    }
}

// `x or None`
fn or_none(o: own Option[String]) -> Option[String] {
    if truthy(o) { o } else { None }
}

// `%s` of a str or None
fn show(o: ref Option[String]) -> String {
    match o {
        Some(s) => s.clone(),
        None => "None".to_string(),
    }
}

fn group(s: ref Vec[i64], f: ref Found, g: i64) -> Option[String] {
    let (a, b) = f.spans[g - 1];
    if a < 0 { None } else { Some(to_string(slice(s, a, b))) }
}

// re.search on one compiled pattern. The prefilter only skips a
// pattern whose required text is not in the lowered string, which it
// cannot match.
fn search(c: ref Compiled, i: i64, s: ref Vec[i64], lowered: ref String) -> Option[Found] {
    if c.needs[i].len() > 0 {
        let mut any = false;
        for t in c.needs[i].iter() {
            if lowered.contains(t.as_str()) {
                any = true;
                break;
            }
        }
        if not any {
            return None;
        }
    }
    let mut m = new_matcher(c.progs[i], s);
    find(mut m, c.progs[i], 0, false, 0)
}

// MultiReplace: $N becomes group N (or '' when it took no part), then
// the ends are stripped, and '' is None.
fn multi_replace(t: ref String, s: ref Vec[i64], f: ref Found, ngroups: i64) -> Option[String] {
    let src = cps(t);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < src.len() {
        if src[i] == 36 and i + 1 < src.len() and src[i + 1] >= 48 and src[i + 1] <= 57 {
            let index = src[i + 1] - 48 - 1;
            if index < ngroups {
                let (a, b) = f.spans[index];
                if a >= 0 {
                    let mut k = a;
                    while k < b {
                        out.push(s[k]);
                        k += 1;
                    }
                }
            }
            i += 2;
        } else {
            out.push(src[i]);
            i += 1;
        }
    }
    let mut lo = 0;
    let mut hi = out.len();
    while lo < hi and is_space(out[lo], false) { lo += 1; }
    while hi > lo and is_space(out[hi - 1], false) { hi -= 1; }
    if lo == hi { None } else { Some(to_string(slice(out, lo, hi))) }
}

fn ua_hit(d: ref UaDef, s: ref Vec[i64], f: ref Found) -> UaHit {
    let mut h = UaHit { family: None, v1: None, v2: None, v3: None };
    if truthy(d.family) {
        let r = d.family.clone().unwrap();
        if r.contains("$1") {
            let g = show(group(s, f, 1));
            h.family = Some(r.replace("$1", g.as_str()));
        } else {
            h.family = Some(r);
        }
    } else {
        h.family = group(s, f, 1);
    }
    if truthy(d.v1) {
        h.v1 = d.v1.clone();
    } else if f.lastindex >= 2 {
        h.v1 = or_none(group(s, f, 2));
    }
    if truthy(d.v2) {
        h.v2 = d.v2.clone();
    } else if f.lastindex >= 3 {
        h.v2 = or_none(group(s, f, 3));
    }
    if f.lastindex >= 4 {
        h.v3 = or_none(group(s, f, 4));
    }
    h
}

fn os_part(r: ref Option[String], g: i64, s: ref Vec[i64], f: ref Found, ngroups: i64) -> Option[String] {
    if truthy(r) {
        multi_replace(r.clone().unwrap(), s, f, ngroups)
    } else if f.lastindex >= g {
        group(s, f, g)
    } else {
        None
    }
}

fn os_hit(d: ref OsDef, s: ref Vec[i64], f: ref Found, ngroups: i64) -> OsHit {
    OsHit {
        os: os_part(d.os, 1, s, f, ngroups),
        v1: os_part(d.v1, 2, s, f, ngroups),
        v2: os_part(d.v2, 3, s, f, ngroups),
        v3: os_part(d.v3, 4, s, f, ngroups),
        v4: os_part(d.v4, 5, s, f, ngroups),
    }
}

fn dev_hit(d: ref DevDef, s: ref Vec[i64], f: ref Found, ngroups: i64) -> DevHit {
    let device = if truthy(d.device) { multi_replace(d.device.clone().unwrap(), s, f, ngroups) } else { group(s, f, 1) };
    let brand = if truthy(d.brand) { multi_replace(d.brand.clone().unwrap(), s, f, ngroups) } else { None };
    let model = if truthy(d.model) {
        multi_replace(d.model.clone().unwrap(), s, f, ngroups)
    } else if ngroups > 0 {
        group(s, f, 1)
    } else {
        None
    };
    DevHit { device: device, brand: brand, model: model }
}

fn lowered_of(s: ref Vec[i64]) -> String {
    let mut low: Vec[i64] = Vec.new();
    for c in s.iter() {
        low.push(lower(c, false));
    }
    to_string(low)
}

// The loops of _ParseUserAgent, _ParseOS and _ParseDevice: the first
// parser that gives a truthy name, or what the last one gave.
fn ua_loop(st: ref State, ua: ref String) -> UaHit {
    let s = cps(ua);
    let lowered = lowered_of(s);
    let mut h = UaHit { family: None, v1: None, v2: None, v3: None };
    let mut i = 0;
    while i < st.ua_defs.len() {
        h = match search(st.ua, i, s, lowered) {
            Some(f) => ua_hit(st.ua_defs[i], s, f),
            None => UaHit { family: None, v1: None, v2: None, v3: None },
        };
        if truthy(h.family) {
            return h;
        }
        i += 1;
    }
    h
}

fn os_loop(st: ref State, ua: ref String) -> OsHit {
    let s = cps(ua);
    let lowered = lowered_of(s);
    let mut h = OsHit { os: None, v1: None, v2: None, v3: None, v4: None };
    let mut i = 0;
    while i < st.os_defs.len() {
        h = match search(st.os, i, s, lowered) {
            Some(f) => os_hit(st.os_defs[i], s, f, st.os.progs[i].groups),
            None => OsHit { os: None, v1: None, v2: None, v3: None, v4: None },
        };
        if truthy(h.os) {
            return h;
        }
        i += 1;
    }
    h
}

fn dev_loop(st: ref State, ua: ref String) -> DevHit {
    let s = cps(ua);
    let lowered = lowered_of(s);
    let mut h = DevHit { device: None, brand: None, model: None };
    let mut i = 0;
    while i < st.dev_defs.len() {
        h = match search(st.dev, i, s, lowered) {
            Some(f) => dev_hit(st.dev_defs[i], s, f, st.dev.progs[i].groups),
            None => DevHit { device: None, brand: None, model: None },
        };
        if truthy(h.device) {
            return h;
        }
        i += 1;
    }
    h
}

// ------------------------------------------------------------- the cache

fn bit(bits: ref Vec[(String, String)], key: Str) -> Option[String] {
    for (k, v) in bits.iter() {
        if k == key {
            return Some(v.clone());
        }
    }
    None
}

// (ua, tuple(sorted(args.items())))
fn cache_key(ua: ref String, bits: ref Vec[(String, String)]) -> String {
    let mut keys: Vec[String] = Vec.new();
    for (k, _) in bits.iter() {
        keys.push(k.clone());
    }
    keys.sort();
    let mut t = ua.clone();
    t.push_str("\u{0}");
    for k in keys.iter() {
        t.push_str(k.as_str());
        t.push_str("\u{1}");
        t.push_str(bit(bits, k.as_str()).unwrap().as_str());
        t.push_str("\u{2}");
    }
    t
}

fn lookup(st: mut ref State, ua: ref String, bits: ref Vec[(String, String)]) -> i64 {
    let key = cache_key(ua, bits);
    match st.cache.get(key) {
        Some(i) => return i,
        None => {}
    }
    if st.cache.len() >= max_cache_size() {
        st.cache.clear();
    }
    st.entries.push(CacheEntry { string: ua.clone(), order: Vec.new(), ua: None, os: None, dev: None });
    let idx = st.entries.len() - 1;
    st.cache.insert(key, idx);
    idx
}

fn warn(st: mut ref State, msg: Str) {
    st.warnings.push(msg.to_string());
}

fn parse_ua_raw(st: mut ref State, ua: ref String, bits: ref Vec[(String, String)]) -> UaRes {
    if bits.len() > 0 {
        warn(mut st, js_warning());
    }
    let mut h = UaHit { family: None, v1: None, v2: None, v3: None };
    let fam = bit(bits, "js_user_agent_family");
    if truthy(fam) {
        h.family = fam;
        h.v1 = or_none(bit(bits, "js_user_agent_v1"));
        h.v2 = or_none(bit(bits, "js_user_agent_v2"));
        h.v3 = or_none(bit(bits, "js_user_agent_v3"));
    } else {
        h = ua_loop(st, ua);
    }
    match bit(bits, "js_user_agent_string") {
        Some(js) => {
            if js.len() > 0 and js.contains("Chrome/") and ua.contains("chromeframe") {
                let o = parse_ua(mut st, js, Vec.new());
                h.family = Some(f"Chrome Frame ({show(h.family)} {show(h.v1)})");
                h.v1 = o.major;
                h.v2 = o.minor;
                h.v3 = o.patch;
            }
        }
        None => {}
    }
    UaRes {
        family: if truthy(h.family) { h.family.unwrap() } else { "Other".to_string() },
        major: or_none(h.v1),
        minor: or_none(h.v2),
        patch: or_none(h.v3),
    }
}

fn parse_os_raw(st: mut ref State, ua: ref String, bits: ref Vec[(String, String)]) -> OsRes {
    if bits.len() > 0 {
        warn(mut st, js_warning());
    }
    let h = os_loop(st, ua);
    OsRes {
        family: if truthy(h.os) { h.os.unwrap() } else { "Other".to_string() },
        major: h.v1,
        minor: h.v2,
        patch: h.v3,
        patch_minor: h.v4,
    }
}

fn parse_dev_raw(st: mut ref State, ua: ref String, bits: ref Vec[(String, String)]) -> DevRes {
    if bits.len() > 0 {
        warn(mut st, js_warning());
    }
    let h = dev_loop(st, ua);
    DevRes {
        family: match h.device {
            Some(d) => d,
            None => "Other".to_string(),
        },
        brand: h.brand,
        model: h.model,
    }
}

// ParseUserAgent, ParseOS and ParseDevice: the cached result, or a new
// one stored in the dict _lookup gave (which a nested call may have
// dropped from the cache meanwhile).
fn parse_ua(st: mut ref State, ua: ref String, bits: own Vec[(String, String)]) -> UaRes {
    let idx = lookup(mut st, ua, bits);
    match st.entries[idx].ua.clone() {
        Some(r) => return r,
        None => {}
    }
    let r = parse_ua_raw(mut st, ua, bits);
    st.entries[idx].ua = Some(r.clone());
    st.entries[idx].order.push(0);
    r
}

fn parse_os(st: mut ref State, ua: ref String, bits: own Vec[(String, String)]) -> OsRes {
    let idx = lookup(mut st, ua, bits);
    match st.entries[idx].os.clone() {
        Some(r) => return r,
        None => {}
    }
    let r = parse_os_raw(mut st, ua, bits);
    st.entries[idx].os = Some(r.clone());
    st.entries[idx].order.push(1);
    r
}

fn parse_dev(st: mut ref State, ua: ref String, bits: own Vec[(String, String)]) -> DevRes {
    let idx = lookup(mut st, ua, bits);
    match st.entries[idx].dev.clone() {
        Some(r) => return r,
        None => {}
    }
    let r = parse_dev_raw(mut st, ua, bits);
    st.entries[idx].dev = Some(r.clone());
    st.entries[idx].order.push(2);
    r
}

// Parse: the whole dict.
fn parse_all(st: mut ref State, ua: ref String, bits: own Vec[(String, String)]) -> CacheEntry {
    let idx = lookup(mut st, ua, bits);
    if st.entries[idx].order.len() == 3 {
        return st.entries[idx].clone();
    }
    if st.entries[idx].ua.is_none() {
        let r = parse_ua_raw(mut st, ua, bits);
        st.entries[idx].ua = Some(r);
        st.entries[idx].order.push(0);
    }
    if st.entries[idx].os.is_none() {
        let r = parse_os_raw(mut st, ua, bits);
        st.entries[idx].os = Some(r);
        st.entries[idx].order.push(1);
    }
    if st.entries[idx].dev.is_none() {
        let r = parse_dev_raw(mut st, ua, bits);
        st.entries[idx].dev = Some(r);
        st.entries[idx].order.push(2);
    }
    st.entries[idx].clone()
}

// ------------------------------------------------------------ pretty

fn starts_digit(s: ref String) -> bool {
    let c = cps(s);
    c.len() > 0 and is_decimal(c[0])
}

fn pretty_ua(family: ref Option[String], v1: ref Option[String], v2: ref Option[String], v3: ref Option[String]) -> Option[String] {
    let (f, a, b, c) = (show(family), show(v1), show(v2), show(v3));
    if truthy(v3) {
        if starts_digit(c) {
            return Some(f"{f} {a}.{b}.{c}");
        }
        return Some(f"{f} {a}.{b}{c}");
    } else if truthy(v2) {
        return Some(f"{f} {a}.{b}");
    } else if truthy(v1) {
        return Some(f"{f} {a}");
    }
    family.clone()
}

fn pretty_os(os: ref Option[String], v1: ref Option[String], v2: ref Option[String], v3: ref Option[String], v4: ref Option[String]) -> Option[String] {
    let (f, a, b, c, d) = (show(os), show(v1), show(v2), show(v3), show(v4));
    if truthy(v4) {
        return Some(f"{f} {a}.{b}.{c}.{d}");
    }
    if truthy(v3) {
        if starts_digit(c) {
            return Some(f"{f} {a}.{b}.{c}");
        }
        return Some(f"{f} {a}.{b}{c}");
    } else if truthy(v2) {
        return Some(f"{f} {a}.{b}");
    } else if truthy(v1) {
        return Some(f"{f} {a}");
    }
    os.clone()
}

// ------------------------------------------------------------- repr

fn py_repr(s: ref String) -> String {
    repr_of(cps(s))
}

fn opt_repr(o: ref Option[String]) -> String {
    match o {
        Some(s) => py_repr(s),
        None => "None".to_string(),
    }
}

fn ua_repr(r: ref UaRes) -> String {
    f"{{'family': {py_repr(r.family)}, 'major': {opt_repr(r.major)}, 'minor': {opt_repr(r.minor)}, 'patch': {opt_repr(r.patch)}}}"
}

fn os_repr(r: ref OsRes) -> String {
    f"{{'family': {py_repr(r.family)}, 'major': {opt_repr(r.major)}, 'minor': {opt_repr(r.minor)}, 'patch': {opt_repr(r.patch)}, 'patch_minor': {opt_repr(r.patch_minor)}}}"
}

fn dev_repr(r: ref DevRes) -> String {
    f"{{'family': {py_repr(r.family)}, 'brand': {opt_repr(r.brand)}, 'model': {opt_repr(r.model)}}}"
}

fn entry_repr(e: ref CacheEntry) -> String {
    let mut t = f"{{'string': {py_repr(e.string)}";
    for k in e.order.iter() {
        if k == 0 {
            t.push_str(f", 'user_agent': {ua_repr(e.ua.clone().unwrap())}");
        } else if k == 1 {
            t.push_str(f", 'os': {os_repr(e.os.clone().unwrap())}");
        } else {
            t.push_str(f", 'device': {dev_repr(e.dev.clone().unwrap())}");
        }
    }
    t.push_str("}");
    t
}

fn spans_repr(f: ref Found) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut g = 0;
    while g < f.lastindex {
        let (a, b) = f.spans[g];
        parts.push(f"({a}, {b})");
        g += 1;
    }
    f"[{parts.join(", ")}]"
}

// ------------------------------------------------------------ report

struct Count {
    name: String,
    n: i64,
}

fn bump(counts: mut ref Vec[Count], name: ref String, n: i64) {
    for c in counts.iter_mut() {
        if c.name == name {
            c.n += n;
            return;
        }
    }
    counts.push(Count { name: name.clone(), n: n });
}

fn pad5(n: i64) -> String {
    let mut t = f"{n}";
    while t.len() < 5 {
        t = f" {t}";
    }
    t
}

fn table(title: Str, counts: own Vec[Count]) {
    let mut v = counts;
    v.sort_by(|a, b| {
        if a.n != b.n {
            if a.n > b.n { Ordering.Less } else { Ordering.Greater }
        } else if a.name < b.name {
            Ordering.Less
        } else if a.name > b.name {
            Ordering.Greater
        } else {
            Ordering.Equal
        }
    });
    println(f"  {title}:");
    for c in v.iter() {
        println(f"    {pad5(c.n)}  {c.name}");
    }
}

fn lines_of(text: ref String) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for line in text.split("\n") {
        v.push(line.to_string());
    }
    v.pop();
    v
}

fn report(st: mut ref State) {
    let log_re = match compile(cps("^(\\S+) \\S+ \\S+ \\[([^\\]]+)\\] \"(\\S+) (\\S+) [^\"]*\" (\\d{3}) (\\d+|-) \"([^\"]*)\" \"([^\"]*)\"$".to_string()), 32) {
        Ok(p) => p,
        Err(e) => panic(err_text(e)),
    };
    let mut browsers: Vec[Count] = Vec.new();
    let mut oses: Vec[Count] = Vec.new();
    let mut devices: Vec[Count] = Vec.new();
    let mut brands: Vec[Count] = Vec.new();
    let mut errors: Vec[Count] = Vec.new();
    let mut bot_paths: Vec[Count] = Vec.new();
    let mut agents: Vec[String] = Vec.new();
    let mut bad = 0;
    let mut total = 0;
    let mut bot_requests = 0;
    let mut bot_bytes = 0;
    let mut human_bytes = 0;
    for line in lines_of(file_access_log()).iter() {
        let s = cps(line);
        let mut m = new_matcher(log_re, s);
        let f = match find(mut m, log_re, 0, false, 1) {
            Some(f) => f,
            None => {
                bad += 1;
                continue;
            }
        };
        total += 1;
        let ua = group(s, f, 8).unwrap();
        let r = parse_all(mut st, ua, Vec.new());
        if not agents.contains(ua) {
            agents.push(ua.clone());
        }
        let u = r.ua.unwrap();
        let o = r.os.unwrap();
        let d = r.dev.unwrap();
        bump(mut browsers, pretty_ua(Some(u.family.clone()), u.major, u.minor, None).unwrap(), 1);
        bump(mut oses, pretty_os(Some(o.family.clone()), o.major, None, None, None).unwrap(), 1);
        bump(mut devices, d.family, 1);
        bump(mut brands, if truthy(d.brand) { d.brand.clone().unwrap() } else { "(none)".to_string() }, 1);
        let size_text = group(s, f, 6).unwrap();
        let size = if size_text == "-" { 0 } else { int_of(size_text) };
        if d.family == "Spider" {
            bot_requests += 1;
            bot_bytes += size;
            bump(mut bot_paths, group(s, f, 4).unwrap(), 1);
        } else {
            human_bytes += size;
        }
        let status = int_of(group(s, f, 5).unwrap());
        if status >= 400 {
            bump(mut errors, f"{u.family} {status}", 1);
        }
    }
    println(f"  {total} requests, {bad} lines not in the log format, {agents.len()} user agents");
    table("browsers", browsers);
    table("operating systems", oses);
    table("devices", devices);
    table("brands", brands);
    println(f"  bots: {bot_requests} requests, {bot_bytes} bytes (others {human_bytes} bytes)");
    table("bot paths", bot_paths);
    table("errors", errors);
}

// --------------------------------------------------------------- jobs

fn int_of(s: ref String) -> i64 {
    let n: Option[i64] = s.parse();
    n.unwrap()
}

fn opt_arg(s: ref String) -> Option[String] {
    if s == "~" { None } else { Some(s.clone()) }
}

fn bits_of(spec: ref String) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for part in spec.split("|") {
        let (k, v) = match part.find("=") {
            Some(i) => (part[0..i].to_string(), part[i + 1..part.len()].to_string()),
            None => (part.to_string(), String.new()),
        };
        out.push((k, v));
    }
    out
}

fn get_filters(args: ref Vec[Option[String]]) -> String {
    let names = ["js_user_agent_string", "js_user_agent_family", "js_user_agent_v1", "js_user_agent_v2", "js_user_agent_v3"];
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < 5 {
        if truthy(args[i]) {
            parts.push(f"'{names[i]}': {opt_repr(args[i])}");
        }
        i += 1;
    }
    f"{{{parts.join(", ")}}}"
}

fn with_overrides(st: mut ref State, ua: ref String, a: ref Vec[Option[String]]) -> String {
    warn(mut st, "DeprecationWarning: Use Parse (or a specialised parser)");
    let js_string = a[0].clone();
    let mut h = UaHit { family: None, v1: None, v2: None, v3: None };
    if truthy(a[1]) {
        h.family = a[1].clone();
        h.v1 = a[2].clone();
        h.v2 = a[3].clone();
        h.v3 = a[4].clone();
    } else {
        h = ua_loop(st, ua);
    }
    if truthy(js_string) {
        let js = js_string.unwrap();
        if js.contains("Chrome/") and ua.contains("chromeframe") {
            h.family = Some(f"Chrome Frame ({show(h.family)} {show(h.v1)})");
            let d = parse_ua(mut st, js, Vec.new());
            h.v1 = d.major;
            h.v2 = d.minor;
            h.v3 = d.patch;
        }
    }
    let family = if truthy(h.family) { h.family.unwrap() } else { "Other".to_string() };
    f"({py_repr(family)}, {opt_repr(h.v1)}, {opt_repr(h.v2)}, {opt_repr(h.v3)})"
}

fn match_spans(st: ref State, kind: ref String, idx: i64, text: ref String) -> String {
    if kind == "ua" {
        spans_in(st.ua, idx, text)
    } else if kind == "os" {
        spans_in(st.os, idx, text)
    } else {
        spans_in(st.dev, idx, text)
    }
}

fn spans_in(c: ref Compiled, idx: i64, text: ref String) -> String {
    let s = cps(text);
    let mut m = new_matcher(c.progs[idx], s);
    match find(mut m, c.progs[idx], 0, false, 0) {
        Some(f) => {
            if f.lastindex < 0 {
                return "! TypeError: unsupported operand type(s) for +: 'NoneType' and 'int'".to_string();
            }
            spans_repr(f)
        }
        None => "[]".to_string(),
    }
}

fn run_job(st: mut ref State, uas: ref Vec[String], job: ref Vec[String]) {
    let kind = job[0].as_str();
    if kind == "parse" {
        let ua = uas[int_of(job[1])].clone();
        println(entry_repr(parse_all(mut st, ua, Vec.new())));
    } else if kind == "report" {
        report(mut st);
    } else if kind == "ua" {
        println(ua_repr(parse_ua(mut st, uas[int_of(job[1])], Vec.new())));
    } else if kind == "os" {
        println(os_repr(parse_os(mut st, uas[int_of(job[1])], Vec.new())));
    } else if kind == "device" {
        println(dev_repr(parse_dev(mut st, uas[int_of(job[1])], Vec.new())));
    } else if kind == "ua_js" {
        println(ua_repr(parse_ua(mut st, uas[int_of(job[1])], bits_of(job[2]))));
    } else if kind == "parse_js" {
        println(entry_repr(parse_all(mut st, uas[int_of(job[1])], bits_of(job[2]))));
    } else if kind == "os_js" {
        println(os_repr(parse_os(mut st, uas[int_of(job[1])], bits_of(job[2]))));
    } else if kind == "cache" {
        println(f"{st.cache.len()}");
    } else if kind == "clear" {
        st.cache.clear();
    } else if kind == "pretty_ua" or kind == "pretty" {
        if kind == "pretty" {
            warn(mut st, "DeprecationWarning: Use PrettyUserAgent");
        }
        println(opt_repr(pretty_ua(opt_arg(job[1]), opt_arg(job[2]), opt_arg(job[3]), opt_arg(job[4]))));
    } else if kind == "pretty_os" {
        println(opt_repr(pretty_os(opt_arg(job[1]), opt_arg(job[2]), opt_arg(job[3]), opt_arg(job[4]), opt_arg(job[5]))));
    } else if kind == "pretty_parse" {
        let r = parse_all(mut st, uas[int_of(job[1])], Vec.new());
        let u = r.ua.unwrap();
        let o = r.os.unwrap();
        println(opt_repr(pretty_ua(Some(u.family.clone()), u.major, u.minor, u.patch)));
        println(opt_repr(pretty_os(Some(o.family.clone()), o.major, o.minor, o.patch, o.patch_minor)));
    } else if kind == "jsov" {
        let mut a: Vec[Option[String]] = Vec.new();
        for k in 2..7 {
            a.push(opt_arg(job[k]));
        }
        println(with_overrides(mut st, uas[int_of(job[1])], a));
    } else if kind == "filters" {
        let mut a: Vec[Option[String]] = Vec.new();
        for k in 2..7 {
            a.push(opt_arg(job[k]));
        }
        println(get_filters(a));
    } else if kind == "spans" {
        let text = if job[3] == "~" { uas[0].clone() } else { job[3].clone() };
        println(match_spans(st, job[1], int_of(job[2]), text));
    } else if kind == "fill" {
        let n = int_of(job[1]);
        for _ in 0..n {
            st.fills += 1;
            let mut bits: Vec[(String, String)] = Vec.new();
            bits.push(("js_user_agent_family".to_string(), f"F{st.fills}"));
            let _ = parse_ua(mut st, "".to_string(), bits);
        }
    }
}

fn job_header(job: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for a in job.iter() {
        if a.len() == 0 or a.contains(" ") {
            parts.push(py_repr(a));
        } else {
            parts.push(a.clone());
        }
    }
    f"-- {parts.join(" ")}"
}

fn main() {
    let mut st = new_state();
    let uas = lines_of(file_agents_txt());
    for line in lines_of(file_jobs_tsv()).iter() {
        let mut job: Vec[String] = Vec.new();
        for p in line.split("\t") {
            job.push(p.to_string());
        }
        println(job_header(job));
        st.warnings.clear();
        run_job(mut st, uas, job);
        let mut shown: Vec[Count] = Vec.new();
        for w in st.warnings.iter() {
            bump(mut shown, w, 1);
        }
        for c in shown.iter() {
            println(f"  warning x{c.n} {c.name}");
        }
    }
}

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn in_firsts(set: ref Vec[i64], c: i64) -> bool {
    for x in set {
        if x == c {
            return true;
        }
    }
    false
}

