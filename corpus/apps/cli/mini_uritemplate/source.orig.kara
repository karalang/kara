fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# client\tlink\tbound by the client\tper call\n");
    t.push_str("cli\ttiles\t{\"z\": 4}\t{\"x\": 193, \"y\": 244, \"style\": \"dark\"}\n");
    t.push_str("cli\tevents\t{\"org\": \"ops\", \"format\": \"ndjson\"}\t{\"types\": [\"release\", \"push\"]}\n");
    t.push_str("web\tcompare\t{\"owner\": \"acme\", \"repo\": \"rocket\"}\t{\"base\": \"v1.0\", \"head\": \"fix/#12\"}\n");
    t.push_str("cli\tcontents\t{\"owner\": \"ops\", \"repo\": \"infra\"}\t{\"path\": \"x/y?z#w\"}\n");
    t.push_str("cli\tevents\t{\"org\": \"acme\", \"format\": \"\"}\t{\"since\": \"2024-01-01T00:00:00Z\", \"types\": [\"release\", \"push\"]}\n");
    t.push_str("cli\tmatrix\t{\"os\": \"macos\"}\t{\"arch\": [\"arm64\", \"x86_64\", \"riscv64\"]}\n");
    t.push_str("web\ttiles\t{\"z\": 8}\t{\"x\": 1840, \"y\": 3613, \"style\": \"dark\"}\n");
    t.push_str("bot\tsearch\t{\"sort\": \"indexed\"}\t{\"q\": \"TODO in:file\", \"page\": 4}\n");
