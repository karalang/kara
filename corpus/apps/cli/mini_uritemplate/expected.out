== spec-examples: Level 2 Examples
-- vars hello, path, var
-- case '{+var}'
   'value' [match]
-- case '{+hello}'
   'Hello%20World!' [match]
-- case '{+path}/here'
   '/foo/bar/here' [match]
-- case 'here?ref={+path}'
   'here?ref=/foo/bar' [match]
== spec-examples: Level 3 Examples
-- vars empty, hello, path, var, x, y
-- case 'map?{x,y}'
   'map?1024,768' [match]
-- case '{x,hello,y}'
   '1024,Hello%20World%21,768' [match]
-- case '{+x,hello,y}'
   '1024,Hello%20World!,768' [match]
-- case '{+path,x}/here'
   '/foo/bar,1024/here' [match]
-- case '{#x,hello,y}'
   '#1024,Hello%20World!,768' [match]
-- case '{#path,x}/here'
   '#/foo/bar,1024/here' [match]
-- case 'X{.var}'
   'X.value' [match]
-- case 'X{.x,y}'
   'X.1024.768' [match]
-- case '{/var}'
   '/value' [match]
-- case '{/var,x}/here'
   '/value/1024/here' [match]
-- case '{;x,y}'
   ';x=1024;y=768' [match]
-- case '{;x,y,empty}'
   ';x=1024;y=768;empty' [match]
-- case '{?x,y}'
   '?x=1024&y=768' [match]
-- case '{?x,y,empty}'
   '?x=1024&y=768&empty=' [match]
-- case '?fixed=yes{&x}'
   '?fixed=yes&x=1024' [match]
-- case '{&x,y,empty}'
   '&x=1024&y=768&empty=' [match]
== spec-examples: Level 4 Examples
-- vars hello, keys, list, path, var
-- case '{var:3}'
   'val' [match]
-- case '{var:30}'
   'value' [match]
-- case '{list}'
   'red,green,blue' [match]
-- case '{list*}'
   'red,green,blue' [match]
-- case '{keys}'
   'comma,%2C,dot,.,semi,%3B' [one of 6]
-- case '{keys*}'
   'comma=%2C,dot=.,semi=%3B' [one of 6]
-- case '{+path:6}/here'
   '/foo/b/here' [match]
-- case '{+list}'
   'red,green,blue' [match]
-- case '{+list*}'
   'red,green,blue' [match]
-- case '{+keys}'
   'comma,,,dot,.,semi,;' [one of 6]
-- case '{+keys*}'
   'comma=,,dot=.,semi=;' [one of 6]
-- case '{#path:6}/here'
   '#/foo/b/here' [match]
-- case '{#list}'
   '#red,green,blue' [match]
-- case '{#list*}'
   '#red,green,blue' [match]
-- case '{#keys}'
   '#comma,,,dot,.,semi,;' [one of 6]
-- case '{#keys*}'
   '#comma=,,dot=.,semi=;' [one of 6]
-- case 'X{.var:3}'
   'X.val' [match]
-- case 'X{.list}'
   'X.red,green,blue' [match]
-- case 'X{.list*}'
   'X.red.green.blue' [match]
-- case 'X{.keys}'
   'X.comma,%2C,dot,.,semi,%3B' [one of 6]
-- case '{/var:1,var}'
   '/v/value' [match]
-- case '{/list}'
   '/red,green,blue' [match]
-- case '{/list*}'
   '/red/green/blue' [match]
-- case '{/list*,path:4}'
   '/red/green/blue/%2Ffoo' [match]
-- case '{/keys}'
   '/comma,%2C,dot,.,semi,%3B' [one of 6]
-- case '{/keys*}'
   '/comma=%2C/dot=./semi=%3B' [one of 6]
-- case '{;hello:5}'
   ';hello=Hello' [match]
-- case '{;list}'
   ';list=red,green,blue' [match]
-- case '{;list*}'
   ';list=red;list=green;list=blue' [match]
-- case '{;keys}'
   ';keys=comma,%2C,dot,.,semi,%3B' [one of 6]
-- case '{;keys*}'
   ';comma=%2C;dot=.;semi=%3B' [one of 6]
-- case '{?var:3}'
   '?var=val' [match]
-- case '{?list}'
   '?list=red,green,blue' [match]
-- case '{?list*}'
   '?list=red&list=green&list=blue' [match]
-- case '{?keys}'
   '?keys=comma,%2C,dot,.,semi,%3B' [one of 6]
-- case '{?keys*}'
   '?comma=%2C&dot=.&semi=%3B' [one of 6]
-- case '{&var:3}'
   '&var=val' [match]
-- case '{&list}'
   '&list=red,green,blue' [match]
-- case '{&list*}'
   '&list=red&list=green&list=blue' [match]
-- case '{&keys}'
   '&keys=comma,%2C,dot,.,semi,%3B' [one of 6]
-- case '{&keys*}'
   '&comma=%2C&dot=.&semi=%3B' [one of 6]
== spec-examples-by-section: 3.2.1 Variable Expansion
-- vars base, count, dom, dub, empty, empty_keys, half, hello, keys, list, path, undef, v, var, who, x, y
-- case '{count}'
   'one,two,three' [match]
-- case '{count*}'
   'one,two,three' [match]
-- case '{/count}'
   '/one,two,three' [match]
-- case '{/count*}'
   '/one/two/three' [match]
-- case '{;count}'
   ';count=one,two,three' [match]
-- case '{;count*}'
   ';count=one;count=two;count=three' [match]
-- case '{?count}'
   '?count=one,two,three' [match]
-- case '{?count*}'
   '?count=one&count=two&count=three' [match]
-- case '{&count*}'
   '&count=one&count=two&count=three' [match]
