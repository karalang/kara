== negative-tests: Failure Tests
-- vars  leading_space, default-graph-uri, empty, example, hello, id, keys, list, path, query, searchTerms, trailing_space , var, with space, x, y, ~thing
-- case '{/id*'
   '{/id*' [expanded, failure expected]
-- case '/id*}'
   '/id*}' [expanded, failure expected]
-- case '{/?id}'
   '' [expanded, failure expected]
-- case '{var:prefix}'
   error: ValueError: invalid literal for int() with base 10: 'prefix' [failure expected]
-- case '{hello:2*}'
   'He' [expanded, failure expected]
-- case '{??hello}'
   '' [expanded, failure expected]
-- case '{!hello}'
   '!Hello%20World%21' [expanded, failure expected]
-- case '{with space}'
   'fail' [expanded, failure expected]
-- case '{ leading_space}'
   'Hi%21' [expanded, failure expected]
-- case '{trailing_space }'
   'Bye%21' [expanded, failure expected]
-- case '{=path}'
   'path' [expanded, failure expected]
-- case '{$var}'
   '' [expanded, failure expected]
-- case '{|var*}'
   '|value' [expanded, failure expected]
-- case '{*keys?}'
   '' [expanded, failure expected]
-- case '{?empty=default,var}'
   '?empty=&var=value' [expanded, failure expected]
-- case '{var}{-prefix|/-/|var}'
   'value' [expanded, failure expected]
-- case '?q={searchTerms}&amp;c={example:color?}'
   error: ValueError: invalid literal for int() with base 10: 'color?' [failure expected]
-- case 'x{?empty|foo=none}'
   'x?empty|foo=none' [expanded, failure expected]
-- case '/h{#hello+}'
   '/h' [expanded, failure expected]
-- case '/h#{hello+}'
   '/h#' [expanded, failure expected]
-- case '{keys:1}'
   'comma,%2C,dot,.,semi,%3B' [expanded, failure expected]
-- case '{+keys:1}'
   'comma,,,dot,.,semi,;' [expanded, failure expected]
-- case '{;keys:1*}'
   ';comma=%2C;dot=.;semi=%3B' [expanded, failure expected]
-- case '?{-join|&|var,list}'
   '?red,green,blue' [expanded, failure expected]
-- case '/people/{~thing}'
   '/people/some-user' [expanded, failure expected]
-- case '/{default-graph-uri}'
   '/http%3A%2F%2Fwww.example%2Fbook%2F,http%3A%2F%2Fwww.example%2Fpapers%2F' [expanded, failure expected]
-- case '/sparql{?query,default-graph-uri}'
   '/sparql?query=PREFIX%20dc%3A%20%3Chttp%3A%2F%2Fpurl.org%2Fdc%2Felements%2F1.1%2F%3E%20SELECT%20%3Fbook%20%3Fwho%20WHERE%20%7B%20%3Fbook%20dc%3Acreator%20%3Fwho%20%7D&default-graph-uri=http%3A%2F%2Fwww.example%2Fbook%2F,http%3A%2F%2Fwww.example%2Fpapers%2F' [expanded, failure expected]
-- case '/sparql{?query){&default-graph-uri*}'
   '/sparql' [expanded, failure expected]
-- case '/resolution{?x, y}'
   '/resolution?x=1024' [expanded, failure expected]
== edge cases
-- vars big, dict, emoji, empty, empty_dict, empty_list, f, list, long, n, neg, no, nothing, nums, pairs, path, pct, q, t, tiny, whole, word, zero
-- expand '{n}'
   '42'
-- expand '{zero}'
   '0'
-- expand '{neg}'
   '-7'
-- expand '{f}'
   '2.5'
-- expand '{big}'
   '1e%2B22'
-- expand '{tiny}'
   '0.0001'
-- expand '{whole}'
   '3.0'
-- expand '{t}'
   'True'
-- expand '{no}'
   'False'
-- expand '{nothing}'
   ''
-- expand '{empty}'
   ''
-- expand '{?empty}'
   '?empty='
-- expand '{;empty}'
   ';empty'
-- expand '{/empty}'
   '/'
-- expand '{.empty}'
   '.'
-- expand '{&empty}'
   '&empty='
-- expand '{word}'
   'dr%C3%BCcken'
-- expand '{+word}'
   'dr%C3%BCcken'
-- expand '{emoji}'
   'a%F0%9F%98%80b'
-- expand '{emoji:2}'
   'a%F0%9F%98%80'
-- expand '{pct}'
   '50%25'
-- expand '{+pct}'
   '50%25'
-- expand '{#pct}'
   '#50%25'
-- expand '{path}'
   '%2Fa%20b%2Fc'
-- expand '{+path}'
   '/a%20b/c'
-- expand '{/path}'
   '/%2Fa%20b%2Fc'
-- expand '{list}'
   'x,y%20z,None,3'
-- expand '{list*}'
   'x,y%20z,None,3'
-- expand '{/list}'
   '/x,y%20z,3'
-- expand '{/list*}'
   '/x/y%20z/3'
-- expand '{?list}'
   '?list=x,y%20z,None,3'
