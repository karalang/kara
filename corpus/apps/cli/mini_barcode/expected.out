== cli list
  $ python-barcode list
  |
  | python-barcode available barcode formats:
  | codabar, code128, code39, ean, ean13, ean13-guard, ean14, ean8, ean8-guard, gs1, gs1_128, gtin, isbn, isbn10, isbn13, issn, itf, jan, nw-7, pzn, upc, upca
  |
  |
  | Available image formats
  | Standard: svg
  | Pillow: disabled
  |
  |
  exit 0
== cli version
  $ python-barcode -v
  | python-barcode 0.16.1
  exit 0
  $ python-barcode --version
  | python-barcode 0.16.1
  exit 0
== cli create code39
  $ python-barcode create WIKIPEDIA data/out/cli/wiki
  | New barcode saved as ./data/out/cli/wiki.svg.
  exit 0
== cli create ean13
  $ python-barcode create -b EAN13 400638133393 data/out/cli/ean
  | New barcode saved as ./data/out/cli/ean.svg.
  exit 0
== cli create isbn10 with text
  $ python-barcode create --barcode=isbn10 0132354187 data/out/cli/./sub/../book --text 'ISBN 0-13-235418-7'
  | New barcode saved as ./data/out/cli/book.svg.
  exit 0
== cli create abbreviated
  $ python-barcode create --barc upca --tex UPC 03600029145 data/out/cli/upc
  | New barcode saved as ./data/out/cli/upc.svg.
  exit 0
== cli create attached short option
  $ python-barcode create -bitf 1234 data/out/cli/itf
  | New barcode saved as ./data/out/cli/itf.svg.
  exit 0
== cli create empty text
  $ python-barcode create --text '' -b ean 590123412345 data/out/cli/empty-text
  | New barcode saved as ./data/out/cli/empty-text.svg.
  exit 0
== cli errors
  $ python-barcode
  ! usage: python-barcode [-h] [-v] {create,list} ...
  ! python-barcode: error: You need to tell me what to do.
  exit 2
  $ python-barcode frob
  ! usage: python-barcode [-h] [-v] {create,list} ...
  ! python-barcode: error: argument {create,list}: invalid choice: 'frob' (choose from 'create', 'list')
  exit 2
  $ python-barcode create x
  ! usage: python-barcode create [-h] [-c] [-b BARCODE] [--text TEXT] code output
  ! python-barcode create: error: the following arguments are required: output
  exit 2
  $ python-barcode create x o --bogus
  ! usage: python-barcode [-h] [-v] {create,list} ...
  ! python-barcode: error: unrecognized arguments: --bogus
  exit 2
  $ python-barcode create -b qr x o
  ! usage: python-barcode [-h] [-v] {create,list} ...
  ! python-barcode: error: Unknown barcode qr. Try list action for available barcodes.
  exit 2
  $ python-barcode create x o --text
  ! usage: python-barcode create [-h] [-c] [-b BARCODE] [--text TEXT] code output
  ! python-barcode create: error: argument --text: expected one argument
  exit 2
  $ python-barcode create -b ean13 12 data/out/cli/bad
  raised NumberOfDigitsError: EAN must have 12 digits, received 2.
