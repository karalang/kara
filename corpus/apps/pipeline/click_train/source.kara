// pipeline/click_train: an ad click-through-rate model trained on a day
// of impression logs at a time, the shape of a nightly ads or
// recommendations job. Four days of impressions are generated and written
// as CSV shards, read back and parsed, hashed into features, reported on,
// and then fed to an online logistic regression one day after another; a
// fifth day is held out to score the model, which is saved and reloaded.
//
// Everything is integer arithmetic. Probabilities and weights are Q16
// (65536 is 1.0), the sigmoid is a table with linear steps between its
// entries, and `/` truncates toward zero.

const PER_DAY: i64 = 4000;
const N_USERS: i64 = 3000;
const N_ADS: i64 = 40;
const BUCKETS: i64 = 4096;
const BIAS: i64 = 4096;
const ONE: i64 = 65536;
const LR_DIV: i64 = 32;
const ZMAX: i64 = 524288;

struct Imp {
    ts: i64,
    user: i64,
    ad: i64,
    hour: i64,
    device: i64,
    country: i64,
    clicked: i64,
}

struct Day {
    name: String,
    imps: Vec[Imp],
}

enum JobError {
    Bad(String),
}

impl JobError {
    fn describe(ref self) -> String {
        match self {
            JobError.Bad(m) => m.clone(),
        }
    }
}

fn abs(v: i64) -> i64 {
    if v < 0 { -v } else { v }
}

fn device_name(d: i64) -> String {
    if d == 0 {
        "desktop".to_string()
    } else if d == 1 {
        "mobile".to_string()
    } else {
        "tablet".to_string()
    }
}

fn country_name(c: i64) -> String {
    if c == 0 {
        "US".to_string()
    } else if c == 1 {
        "IN".to_string()
    } else if c == 2 {
        "DE".to_string()
    } else if c == 3 {
        "BR".to_string()
    } else {
        "JP".to_string()
    }
}

fn lcg(state: i64) -> i64 {
    (state * 1103515245 + 12345) % 2147483648
}

// ---------------------------------------------------------------- generation

// The click probability, in basis points, of the hidden model the logs
// come from: a base rate per ad, a device and an evening lift, a market
// lift, and a user-to-ad affinity.
fn true_rate(imp: ref Imp) -> i64 {
    let mut p = 150 + (imp.ad * 37 % 11) * 40;
    if imp.device == 1 {
        p += 60;
    } else if imp.device == 2 {
        p -= 40;
    }
    if imp.hour >= 18 and imp.hour <= 22 {
        p += 80;
    }
    if imp.country == 4 {
        p += 50;
    }
    if imp.user % 7 == imp.ad % 7 {
        p += 200;
    }
    p
}

// One day's impression log as CSV: ts,user,ad,hour,device,country,clicked.
fn gen_day(day: i64) -> String {
    let mut s = 1000003 * day + 12345;
    let mut out = "ts,user,ad,hour,device,country,clicked\n".to_string();
    for i in 0..PER_DAY {
        let ts = 1761264000 + day * 86400 + i * 86400 / PER_DAY;
        let hour = i * 24 / PER_DAY;
        s = lcg(s);
        let user = (s / 16) % N_USERS;
        s = lcg(s);
        let r = (s / 16) % 1000;
        let ad = r * r / 25000;
        s = lcg(s);
        let dv = (s / 16) % 100;
        let device = if dv < 55 { 1 } else if dv < 90 { 0 } else { 2 };
        s = lcg(s);
        let country = (s / 16) % 5;
        let mut imp = Imp { ts, user, ad, hour, device, country, clicked: 0 };
        s = lcg(s);
        if (s / 16) % 10000 < true_rate(imp) {
            imp.clicked = 1;
        }
        out.push_str(f"{ts},{user},{ad},{hour},{device_name(device)},{country_name(country)},{imp.clicked}\n");
    }
    out
}

// ---------------------------------------------------------------- parsing

fn parse_num(field: ref String, what: ref String, name: ref String, line: i64) -> Result[i64, JobError] {
    match i64.parse(field) {
        Ok(v) => Ok(v),
        Err(_) => Err(JobError.Bad(f"{name} line {line}: bad {what} {field}")),
    }
}

fn parse_day(name: ref String, data: ref Vec[u8]) -> Result[Day, JobError] {
    let text = match String.from_utf8(data.clone()) {
        Ok(t) => t,
        Err(_) => return Err(JobError.Bad(f"{name}: not UTF-8")),
    };
    let mut imps: Vec[Imp] = Vec.new();
    let mut line_no = 0;
    for line in text.lines() {
        line_no += 1;
        if line_no == 1 {
            if line != "ts,user,ad,hour,device,country,clicked" {
                return Err(JobError.Bad(f"{name}: unexpected header {line}"));
            }
            continue;
        }
        let f: Vec[String] = line.split(",").map(|x| x.to_string()).collect();
        if f.len() != 7 {
            return Err(JobError.Bad(f"{name} line {line_no}: expected 7 fields, got {f.len()}"));
        }
        let device = if f[4] == "desktop" {
            0
        } else if f[4] == "mobile" {
            1
        } else if f[4] == "tablet" {
            2
        } else {
            return Err(JobError.Bad(f"{name} line {line_no}: unknown device {f[4]}"));
        };
        let mut country = -1;
        for c in 0..5 {
            if f[5] == country_name(c) {
                country = c;
            }
        }
        if country < 0 {
            return Err(JobError.Bad(f"{name} line {line_no}: unknown country {f[5]}"));
        }
        imps.push(Imp {
            ts: parse_num(f[0], "ts", name, line_no)?,
            user: parse_num(f[1], "user", name, line_no)?,
            ad: parse_num(f[2], "ad", name, line_no)?,
            hour: parse_num(f[3], "hour", name, line_no)?,
            device,
            country,
            clicked: parse_num(f[6], "clicked", name, line_no)?,
        });
    }
    Ok(Day { name: name.clone(), imps })
}

// ---------------------------------------------------------------- features

// A 32-bit integer mix (two rounds of xor-shift and multiply).
fn mix32(x: i64) -> i64 {
    let mut h = x % 4294967296;
    h = ((h / 65536) ^ h) * 73244475 % 4294967296;
    h = ((h / 65536) ^ h) * 73244475 % 4294967296;
    (h / 65536) ^ h
}

fn bucket(field: i64, value: i64) -> i64 {
    mix32(field * 1000003 + value) % BUCKETS
}

// The hashing trick: eight features per impression, the bias and seven
// hashed into BUCKETS weights (user, ad, hour, device, market, and the
// ad-by-device and ad-by-hour crosses).
fn featurize(d: ref Day) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for imp in d.imps.iter() {
        out.push(BIAS);
        out.push(bucket(1, imp.user));
        out.push(bucket(2, imp.ad));
        out.push(bucket(3, imp.hour));
        out.push(bucket(4, imp.device));
        out.push(bucket(5, imp.country));
        out.push(bucket(6, imp.ad * 8 + imp.device));
        out.push(bucket(7, imp.ad * 24 + imp.hour));
    }
    out
}

// ---------------------------------------------------------------- reports

fn pct(num: i64, den: i64) -> String {
    if den == 0 {
        return "-".to_string();
    }
    let bp = num * 10000 / den;
    let frac = bp % 100;
    let pad = if frac < 10 { "0" } else { "" };
    f"{bp / 100}.{pad}{frac}%"
}

fn ctr_by_device(d: ref Day) -> String {
    let mut out = f"{d.name} by device:";
    for dev in 0..3 {
        let mut (n, c) = (0, 0);
        for imp in d.imps.iter() {
            if imp.device == dev {
                n += 1;
                c += imp.clicked;
            }
        }
        out.push_str(f" {device_name(dev)} {pct(c, n)} of {n}");
    }
    out
}

// Clicks per hour as a bar of the 24 hours, one character per hour.
fn ctr_by_hour(d: ref Day) -> String {
    let marks: Vec[char] = " .:-=+*#".chars().collect();
    let mut bar = String.new();
    for h in 0..24 {
        let mut (n, c) = (0, 0);
        for imp in d.imps.iter() {
            if imp.hour == h {
                n += 1;
                c += imp.clicked;
            }
        }
        let level = if n == 0 { 0 } else { c * 1000 / n / 8 };
        bar.push(marks[if level > 7 { 7 } else { level }]);
    }
    f"{d.name} by hour: [{bar}]"
}

fn top_ads(d: ref Day) -> String {
    let mut clicks: Vec[(i64, i64)] = Vec.new();
    for ad in 0..N_ADS {
        let mut c = 0;
        for imp in d.imps.iter() {
            if imp.ad == ad {
                c += imp.clicked;
            }
        }
        clicks.push((-c, ad));
    }
    clicks.sort();
    let mut out = f"{d.name} top ads:";
    for i in 0..5 {
        let (nc, ad) = clicks[i];
        out.push_str(f" ad{ad}={-nc}");
    }
    out
}

fn market_mix(d: ref Day) -> String {
    let mut out = f"{d.name} markets:";
    for c in 0..5 {
        let mut n = 0;
        for imp in d.imps.iter() {
            if imp.country == c {
                n += 1;
            }
        }
        out.push_str(f" {country_name(c)} {pct(n, d.imps.len())}");
    }
    out
}

// How the hashing trick filled the table: buckets used and the fullest.
fn bucket_load(name: ref String, feats: ref Vec[i64]) -> String {
    let mut load: Vec[i64] = Vec.new();
    for _ in 0..BUCKETS + 1 {
        load.push(0);
    }
    for f in feats.iter() {
        load[*f] += 1;
    }
    let mut (used, top, top_at) = (0, 0, 0);
    for b in 0..BUCKETS {
        if load[b] > 0 {
            used += 1;
        }
        if load[b] > top {
            top = load[b];
            top_at = b;
        }
    }
    f"{name} features: {feats.len()} hashed into {used} of {BUCKETS} buckets, fullest {top_at} with {top}"
}

// ---------------------------------------------------------------- the model

fn predict(w: ref Vec[i64], feats: ref Vec[i64], at: i64) -> i64 {
    let mut z = 0;
    for k in 0..8 {
        z += w[feats[at * 8 + k]];
    }
    sigmoid(z)
}

// The logistic function in Q16, from a table of 1/(1+e^-x) at every half
// unit over [-8, 8], linear in between.
fn sigmoid(z: i64) -> i64 {
    let t = [22, 36, 60, 98, 162, 267, 439, 720, 1179, 1921, 3108, 4971, 7812, 11955, 17625, 24743, 32768,
             40793, 47911, 53581, 57724, 60565, 62428, 63615, 64357, 64816, 65097, 65269, 65374, 65438, 65476,
             65500, 65514];
    if z <= -ZMAX {
        return t[0];
    }
    if z >= ZMAX {
        return t[32];
    }
    let u = z + ZMAX;
    let i = u / (ONE / 2);
    let f = u % (ONE / 2);
    t[i] + (t[i + 1] - t[i]) * f / (ONE / 2)
}

// A fraction in [0, 1) given in ten-thousandths, as "0.dddd".
fn frac4(v: i64) -> String {
    let pad = if v < 10 { "000" } else if v < 100 { "00" } else if v < 1000 { "0" } else { "" };
    f"0.{pad}{v}"
}

fn brier(sum: i64, n: i64) -> String {
    frac4(sum * 10000 / (n * ONE))
}

// One day of online learning: each impression is scored before the model
// learns from it (progressive validation), then every active weight moves
// by the error over LR_DIV.
fn train_day(w: mut ref Vec[i64], d: ref Day, feats: ref Vec[i64]) -> String {
    let mut (sq, clicks, predicted) = (0, 0, 0);
    for i in 0..d.imps.len() {
        let p = predict(w, feats, i);
        let y = d.imps[i].clicked * ONE;
        let err = y - p;
        sq += err * err / ONE;
        clicks += d.imps[i].clicked;
        predicted += p;
        let step = err / LR_DIV;
        for k in 0..8 {
            w[feats[i * 8 + k]] += step;
        }
    }
    let n = d.imps.len();
    f"train {d.name}: {n} impressions, {clicks} clicks, mean prediction {pct(predicted / ONE, n)}, progressive brier {brier(sq, n)}"
}

// Area under the ROC curve over the held-out day, ties counted as half.
fn auc(scores: ref Vec[(i64, i64)]) -> String {
    let mut s = scores.clone();
    s.sort();
    let mut (pos, neg, num) = (0, 0, 0);
    let mut i = 0;
    let mut below = 0;
    while i < s.len() {
        let mut j = i;
        let mut (tp, tn) = (0, 0);
        while j < s.len() and s[j].0 == s[i].0 {
            if s[j].1 == 1 {
                tp += 1;
            } else {
                tn += 1;
            }
            j += 1;
        }
        num += tp * (2 * below + tn);
        below += tn;
        pos += tp;
        neg += tn;
        i = j;
    }
    f"auc {frac4(num * 10000 / (2 * pos * neg))}"
}

fn evaluate(w: ref Vec[i64], d: ref Day, feats: ref Vec[i64]) -> Vec[String] {
    let mut lines: Vec[String] = Vec.new();
    let mut scores: Vec[(i64, i64)] = Vec.new();
    let mut sq = 0;
    for i in 0..d.imps.len() {
        let p = predict(w, feats, i);
        let err = d.imps[i].clicked * ONE - p;
        sq += err * err / ONE;
        scores.push((p, d.imps[i].clicked));
    }
    lines.push(f"holdout {d.name}: brier {brier(sq, d.imps.len())}, {auc(scores)}");
    // Calibration: predicted against actual rate in five bands of p.
    let edges = [0, 1638, 2621, 3604, 4915, 65537];
    for b in 0..5 {
        let mut (n, c, ps) = (0, 0, 0);
        for sc in scores.iter() {
            let (p, y) = *sc;
            if p >= edges[b] and p < edges[b + 1] {
                n += 1;
                c += y;
                ps += p;
            }
        }
        lines.push(f"  band {b}: {n} impressions, predicted {pct(ps / ONE, n)}, actual {pct(c, n)}");
    }
    lines
}

fn top_weights(w: ref Vec[i64]) -> String {
    let mut ws: Vec[(i64, i64)] = Vec.new();
    for b in 0..BUCKETS {
        ws.push((-w[b], b));
    }
    ws.sort();
    let mut out = f"bias {w[BIAS]}, strongest buckets:";
    for i in 0..5 {
        let (nw, b) = ws[i];
        out.push_str(f" {b}={-nw}");
    }
    out
}

// ---------------------------------------------------------------- the file

fn crc_table() -> Vec[i64] {
    let mut t: Vec[i64] = Vec.new();
    for n in 0..256 {
        let mut c = n;
        for _ in 0..8 {
            c = if c % 2 == 1 { 3988292384 ^ (c / 2) } else { c / 2 };
        }
        t.push(c);
    }
    t
}

fn crc32(t: ref Vec[i64], d: ref Vec[u8]) -> i64 {
    let mut c: i64 = 4294967295;
    for b in d.iter() {
        c = t[(c ^ (*b as i64)) % 256] ^ (c / 256);
    }
    c ^ 4294967295
}

fn file_line(name: ref String, t: ref Vec[i64], d: ref Vec[u8]) -> String {
    f"{name}: {d.len()} bytes, crc32 {crc32(t, d):08x}"
}

// The weights as big-endian 32-bit two's complement.
fn save_model(w: ref Vec[i64]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for v in w.iter() {
        let u = if *v < 0 { *v + 4294967296 } else { *v };
        out.push((u / 16777216) as u8);
        out.push((u / 65536 % 256) as u8);
        out.push((u / 256 % 256) as u8);
        out.push((u % 256) as u8);
    }
    out
}

fn load_model(b: ref Vec[u8]) -> Vec[i64] {
    let mut w: Vec[i64] = Vec.new();
    let mut i = 0;
    while i + 4 <= b.len() {
        let u = (b[i] as i64) * 16777216 + (b[i + 1] as i64) * 65536 + (b[i + 2] as i64) * 256 + (b[i + 3] as i64);
        w.push(if u >= 2147483648 { u - 4294967296 } else { u });
        i += 4;
    }
    w
}

fn read_file(path: ref String) -> Result[Vec[u8], JobError] {
    match fs.read_bytes(path) {
        Ok(b) => Ok(b),
        Err(_) => Err(JobError.Bad(f"could not read {path}")),
    }
}

fn run() -> Result[(), JobError] {
    let tc = crc_table();

    // Four days of logs, each from its own seed (the hot group).
    let csv1 = gen_day(1);
    let csv2 = gen_day(2);
    let csv3 = gen_day(3);
    let csv4 = gen_day(4);

    // Four writes, one shard per day.
    let w1 = fs.write_bytes("day1.csv", csv1.bytes().to_vec());
    let w2 = fs.write_bytes("day2.csv", csv2.bytes().to_vec());
    let w3 = fs.write_bytes("day3.csv", csv3.bytes().to_vec());
    let w4 = fs.write_bytes("day4.csv", csv4.bytes().to_vec());
    if w1.is_err() or w2.is_err() or w3.is_err() or w4.is_err() {
        return Err(JobError.Bad("could not write the shards".to_string()));
    }

    // A shard cut off mid-line, to show the parser's error.
    let whole = read_file("day4.csv")?;
    if fs.write_bytes("day4_cut.csv", whole[0..5000].to_vec()).is_err() {
        return Err(JobError.Bad("could not write day4_cut.csv".to_string()));
    }

    // Four reads, then four parses.
    let r1 = fs.read_bytes("day1.csv");
    let r2 = fs.read_bytes("day2.csv");
    let r3 = fs.read_bytes("day3.csv");
    let r4 = fs.read_bytes("day4.csv");
    let (b1, b2, b3, b4) = match (r1, r2, r3, r4) {
        (Ok(a), Ok(b), Ok(c), Ok(d)) => (a, b, c, d),
        _ => return Err(JobError.Bad("could not read the shards".to_string())),
    };
    println(file_line("day1.csv", tc, b1));
    println(file_line("day2.csv", tc, b2));
    println(file_line("day3.csv", tc, b3));
    println(file_line("day4.csv", tc, b4));
    let d1 = parse_day("day1", b1)?;
    let d2 = parse_day("day2", b2)?;
    let d3 = parse_day("day3", b3)?;
    let d4 = parse_day("day4", b4)?;
    match parse_day("day4_cut", read_file("day4_cut.csv")?) {
        Ok(d) => println(f"day4_cut: parsed {d.imps.len()} impressions"),
        Err(e) => println(e.describe()),
    }

    // Four featurizations (the other hot group).
    let f1 = featurize(d1);
    let f2 = featurize(d2);
    let f3 = featurize(d3);
    let f4 = featurize(d4);

    // Reports that only read the parsed days and their features.
    let a1 = ctr_by_device(d1);
    let a2 = ctr_by_device(d2);
    let a3 = ctr_by_device(d3);
    let a4 = ctr_by_device(d4);
    let h1 = ctr_by_hour(d1);
    let h2 = ctr_by_hour(d2);
    let h3 = ctr_by_hour(d3);
    let h4 = ctr_by_hour(d4);
    let t1 = top_ads(d1);
    let t2 = top_ads(d2);
    let t3 = top_ads(d3);
    let t4 = top_ads(d4);
    let m1 = market_mix(d1);
    let m2 = market_mix(d2);
    let m3 = market_mix(d3);
    let m4 = market_mix(d4);
    let l1 = bucket_load(d1.name, f1);
    let l2 = bucket_load(d2.name, f2);
    let l3 = bucket_load(d3.name, f3);
    let l4 = bucket_load(d4.name, f4);
    for line in [a1, a2, a3, a4, h1, h2, h3, h4, t1, t2, t3, t4, m1, m2, m3, m4, l1, l2, l3, l4] {
        println(line);
    }

    // Training: each day moves the weights the next day starts from, so
    // the days go in order.
    let mut w: Vec[i64] = Vec.new();
    for _ in 0..BUCKETS + 1 {
        w.push(0);
    }
    let e1 = train_day(mut w, d1, f1);
    let e2 = train_day(mut w, d2, f2);
    let e3 = train_day(mut w, d3, f3);
    let e4 = train_day(mut w, d4, f4);
    for line in [e1, e2, e3, e4] {
        println(line);
    }
    println(top_weights(w));

    // The held-out fifth day.
    let hold = parse_day("day5", gen_day(5).bytes().to_vec())?;
    let hf = featurize(hold);
    for line in evaluate(w, hold, hf) {
        println(line);
    }

    // Save the model, load it back, and check it scores the same.
    let saved = save_model(w);
    if fs.write_bytes("model.bin", saved).is_err() {
        return Err(JobError.Bad("could not write model.bin".to_string()));
    }
    let back = load_model(read_file("model.bin")?);
    println(file_line("model.bin", tc, read_file("model.bin")?));
    let same = back == w;
    println(f"reloaded {back.len()} weights, identical: {same}");
    for line in evaluate(back, hold, hf) {
        println(line);
    }

    for p in ["day1.csv", "day2.csv", "day3.csv", "day4.csv", "day4_cut.csv", "model.bin"] {
        let _ = fs.remove_file(p);
    }
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(e) => println(f"click_train failed: {e.describe()}"),
    }
}
