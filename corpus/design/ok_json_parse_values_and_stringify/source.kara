import std.json.{Json, JsonError};

fn show(t: Str) {
    match Json.parse(t) {
        Ok(v) => println(v.stringify()),
        Err(e) => println(f"ERR {e.line}:{e.column} {e.message}"),
    }
}

fn main() {
    let cases = [
        "null", "true", " false ", "0", "-0", "-0.0", "1", "-1", "1.5", "1e3", "1E3", "1e-7", "1e21", "1.0",
        "0.1", "123456789012345678", "9223372036854775807", "-9223372036854775808",
        "9223372036854775808", "-9223372036854775809", "1e400", "-1e400", "5e-324", "2.5e-400",
        "\"a\\\"b\\\\c\\/d\\b\\f\\n\\r\\t\"", "\"\\u0041\\u00e9\\u20ac\"", "\"\\ud83d\\ude00\"", "\"é😀\"",
        "\"\\u0001\\u001f\\u007f\"", "[]", "{}", "[1,[2,[3]]]", "{\"b\":1,\"a\":2}", "{\"a\":1,\"b\":2,\"a\":3}",
        " [ 1 , 2 ] ",
    ];
    for c in cases { show(c); }
}
