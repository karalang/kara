fn main() {
    let mut d: VecDeque[i64] = VecDeque.new();
    d.push_back(3);
    d.push_back(1);
    d.push_front(2);
    let mut v = Vec.from_iter(d.into_iter());
    v.sort();
    for x in v.iter() {
        println(x);
    }
    let mut w: Vec[String] = Vec.new();
    w.push("a".to_string());
    w.push("b".to_string());
    w.push("c".to_string());
    let mut o: Vec[String] = Vec.new();
    o.push("x".to_string());
    o.push("y".to_string());
    w[1..3].clone_from_slice(o);
    println(w.join(","));
    println(o.len());
}
