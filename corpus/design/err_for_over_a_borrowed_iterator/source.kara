// design.md § `Iterator` and `Iterable`: "An `Iterator` is consumed. `for x
// in it` moves `it`". A bare parameter borrows (core-semantics §4.1), and a
// borrowed iterator cannot be consumed or advanced: take it as `own I`, or as
// `mut ref I` and loop over `it.by_ref()` (B-2026-11-04-17).
fn total[I: Iterator[Item = i64]](it: I) -> i64 {
    let mut t = 0;
    for x in it {
        t += x;
    }
    t
}

fn main() {
    println(total([1, 2, 3].into_iter()));
}
