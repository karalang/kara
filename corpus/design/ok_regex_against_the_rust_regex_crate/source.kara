import std.regex.{Regex, Match, Captures};

fn ms(v: Vec[Match]) -> String { let mut s = String.new(); for m in v { s.push_str(f"[{m.start},{m.end}:{m.text}]"); } s }
fn g(c: Captures) -> String { let mut s = f"{c.len()}"; let mut i = 0; while i < c.len() { match c.get(i) { Some(m) => s.push_str(f" {i}={m.start}..{m.end}:{m.text}"), None => s.push_str(f" {i}=None") } i += 1; } s }
fn main() {
    match Regex.compile("a*") { Ok(re) => { println(f"{re.is_match("baaab")} {ms(re.find_all("baaab"))}"); match re.find("baaab") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("baaab") { println(g(c)); } let sp = re.split("baaab"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\d+") { Ok(re) => { println(f"{re.is_match("a1b٣٤c")} {ms(re.find_all("a1b٣٤c"))}"); match re.find("a1b٣٤c") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("a1b٣٤c") { println(g(c)); } let sp = re.split("a1b٣٤c"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("[0-9]+") { Ok(re) => { println(f"{re.is_match("a1b٣٤c")} {ms(re.find_all("a1b٣٤c"))}"); match re.find("a1b٣٤c") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("a1b٣٤c") { println(g(c)); } let sp = re.split("a1b٣٤c"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(?-u:\\d)+") { Ok(re) => { println(f"{re.is_match("x12٣")} {ms(re.find_all("x12٣"))}"); match re.find("x12٣") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("x12٣") { println(g(c)); } let sp = re.split("x12٣"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\w+") { Ok(re) => { println(f"{re.is_match("héllo wörld_9")} {ms(re.find_all("héllo wörld_9"))}"); match re.find("héllo wörld_9") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("héllo wörld_9") { println(g(c)); } let sp = re.split("héllo wörld_9"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\s+") { Ok(re) => { println(f"{re.is_match("a  　b")} {ms(re.find_all("a  　b"))}"); match re.find("a  　b") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("a  　b") { println(g(c)); } let sp = re.split("a  　b"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile(".") { Ok(re) => { println(f"{re.is_match("é😀")} {ms(re.find_all("é😀"))}"); match re.find("é😀") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("é😀") { println(g(c)); } let sp = re.split("é😀"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("^\\w+$") { Ok(re) => { println(f"{re.is_match("abc\ndef")} {ms(re.find_all("abc\ndef"))}"); match re.find("abc\ndef") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("abc\ndef") { println(g(c)); } let sp = re.split("abc\ndef"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(?m)^\\w+$") { Ok(re) => { println(f"{re.is_match("abc\ndef")} {ms(re.find_all("abc\ndef"))}"); match re.find("abc\ndef") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("abc\ndef") { println(g(c)); } let sp = re.split("abc\ndef"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("a.b") { Ok(re) => { println(f"{re.is_match("a\nb")} {ms(re.find_all("a\nb"))}"); match re.find("a\nb") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("a\nb") { println(g(c)); } let sp = re.split("a\nb"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(?s)a.b") { Ok(re) => { println(f"{re.is_match("a\nb")} {ms(re.find_all("a\nb"))}"); match re.find("a\nb") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("a\nb") { println(g(c)); } let sp = re.split("a\nb"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(?i)straße") { Ok(re) => { println(f"{re.is_match("STRASSE straße STRAßE")} {ms(re.find_all("STRASSE straße STRAßE"))}"); match re.find("STRASSE straße STRAßE") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("STRASSE straße STRAßE") { println(g(c)); } let sp = re.split("STRASSE straße STRAßE"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(?x) a \\s* b  # c") { Ok(re) => { println(f"{re.is_match("a  b")} {ms(re.find_all("a  b"))}"); match re.find("a  b") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("a  b") { println(g(c)); } let sp = re.split("a  b"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\bcat\\b") { Ok(re) => { println(f"{re.is_match("cat concat cat.")} {ms(re.find_all("cat concat cat."))}"); match re.find("cat concat cat.") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("cat concat cat.") { println(g(c)); } let sp = re.split("cat concat cat."); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\p{Greek}+") { Ok(re) => { println(f"{re.is_match("abc αβγ")} {ms(re.find_all("abc αβγ"))}"); match re.find("abc αβγ") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("abc αβγ") { println(g(c)); } let sp = re.split("abc αβγ"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\p{Lu}") { Ok(re) => { println(f"{re.is_match("aBcÉ")} {ms(re.find_all("aBcÉ"))}"); match re.find("aBcÉ") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("aBcÉ") { println(g(c)); } let sp = re.split("aBcÉ"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(a)|b") { Ok(re) => { println(f"{re.is_match("b")} {ms(re.find_all("b"))}"); match re.find("b") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("b") { println(g(c)); } let sp = re.split("b"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(?P<y>\\d{4})-(?<m>\\d{2})") { Ok(re) => { println(f"{re.is_match("on 2026-11 and 1999-01")} {ms(re.find_all("on 2026-11 and 1999-01"))}"); match re.find("on 2026-11 and 1999-01") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("on 2026-11 and 1999-01") { println(g(c)); } let sp = re.split("on 2026-11 and 1999-01"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("") { Ok(re) => { println(f"{re.is_match("aé")} {ms(re.find_all("aé"))}"); match re.find("aé") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("aé") { println(g(c)); } let sp = re.split("aé"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("x*") { Ok(re) => { println(f"{re.is_match("")} {ms(re.find_all(""))}"); match re.find("") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("") { println(g(c)); } let sp = re.split(""); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(a+)(b)?") { Ok(re) => { println(f"{re.is_match("aab aa")} {ms(re.find_all("aab aa"))}"); match re.find("aab aa") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("aab aa") { println(g(c)); } let sp = re.split("aab aa"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\A\\d") { Ok(re) => { println(f"{re.is_match("1\n2")} {ms(re.find_all("1\n2"))}"); match re.find("1\n2") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("1\n2") { println(g(c)); } let sp = re.split("1\n2"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("\\d\\z") { Ok(re) => { println(f"{re.is_match("1\n2")} {ms(re.find_all("1\n2"))}"); match re.find("1\n2") { Some(m) => println(f"first {m.start} {m.end}"), None => println("first none") } for c in re.captures_all("1\n2") { println(g(c)); } let sp = re.split("1\n2"); println(f"split {sp.len()} {sp}"); } Err(e) => println("ERR") }
    match Regex.compile("(\\w+)=(\\d+)") { Ok(re) => println(f"<{re.replace("a=1 b=22", "$2=$1")}> <{re.replace_all("a=1 b=22", "$2=$1")}>"), Err(_) => println("ERR") }
    match Regex.compile("(\\w+)=(\\d+)") { Ok(re) => println(f"<{re.replace("a=1 b=22", "${1}x")}> <{re.replace_all("a=1 b=22", "${1}x")}>"), Err(_) => println("ERR") }
    match Regex.compile("(\\w+)=(\\d+)") { Ok(re) => println(f"<{re.replace("a=1 b=22", "$1x")}> <{re.replace_all("a=1 b=22", "$1x")}>"), Err(_) => println("ERR") }
    match Regex.compile("(?P<k>\\w+)=(?P<v>\\d+)") { Ok(re) => println(f"<{re.replace("a=1", "$v:$k $$ $9 ${nope}")}> <{re.replace_all("a=1", "$v:$k $$ $9 ${nope}")}>"), Err(_) => println("ERR") }
    match Regex.compile("(a)|b") { Ok(re) => println(f"<{re.replace("ab", "[$1]")}> <{re.replace_all("ab", "[$1]")}>"), Err(_) => println("ERR") }
    match Regex.compile("\\d") { Ok(re) => println(f"<{re.replace("a1b2", "#")}> <{re.replace_all("a1b2", "#")}>"), Err(_) => println("ERR") }
    match Regex.compile("") { Ok(re) => println(f"<{re.replace("ab", "-")}> <{re.replace_all("ab", "-")}>"), Err(_) => println("ERR") }
    match Regex.compile("x*") { Ok(re) => println(f"<{re.replace("axb", "-")}> <{re.replace_all("axb", "-")}>"), Err(_) => println("ERR") }
    match Regex.compile("(?P<y>\\d{4})-(?<m>\\d{2})") { Ok(re) => match re.captures("x 2026-11") { Some(c) => println(f"{c.name("y").is_some()} {c.name("m").is_some()} {c.name("z").is_none()} {c.get(9).is_none()}"), None => println("none") }, Err(_) => println("ERR") }
    match Regex.compile("(") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("a{2,1}") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("(?<!a)b") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("(a)\\1") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("[z-a]") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("(?P<n>a)(?P<n>b)") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("\\p{Nope}") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("a**") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    match Regex.compile("(?=a)") { Ok(_) => println("compiled"), Err(e) => println(f"err {e.message.len() > 0}") }
    let e = Regex.escape("a.b*c(d)[e]{f}|g^$\\h+?");
    println(e);
    match Regex.compile(e) { Ok(re) => println(re.is_match("a.b*c(d)[e]{f}|g^$\\h+?")), Err(_) => println("ERR") }
    let mut s = String.new(); for _ in 0..30 { s.push('a'); } s.push('!');
    match Regex.compile("(a+)+$") { Ok(re) => println(re.is_match(s)), Err(_) => println("ERR") }
}
