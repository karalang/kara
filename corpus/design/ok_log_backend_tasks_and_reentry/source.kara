import std.log;
import std.log.{info, warn, Backend, Record};
import std.sync.{TaskGroup};
import std.json.{Json};

// Counts the records it receives and their `i` fields; prints on "end".
struct Tally { n: i64, sum: i64, in_task: i64 }
impl Backend for Tally {
    fn emit(mut ref self, record: Record) {
        if record.msg == "end" {
            println(f"records {self.n} sum {self.sum} in tasks {self.in_task}");
            // Logged from inside emit: goes to the default backend (stderr).
            info("from inside emit");
            return;
        }
        self.n += 1;
        if record.task_id.is_some() { self.in_task += 1; }
        for (k, v) in record.fields.iter() {
            if k == "i" { match v { Json.Int(n) => { self.sum += n; } _ => {} } }
        }
    }
}

fn work(i: i64) -> i64 { warn("spawned", i: i); i }

fn main() {
    log.init(Tally { n: 0, sum: 0, in_task: 0 });
    warn("outside", i: 100);
    let g = TaskGroup.new();
    let a = g.spawn(|| work(1));
    let b = g.spawn(|| work(2));
    println(a.join() + b.join());
    let (x, y) = par { { warn("par", i: 10); 1 }, { warn("par", i: 20); 2 } };
    println(x + y);
    info("end");
    info("end");
}
