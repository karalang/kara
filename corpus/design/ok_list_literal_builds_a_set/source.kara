// design.md §5 Collection literals: `[a, b, c]` is a `Vec` by default and
// follows the expected type: with an `Array[T, N]` or `Set[T]` annotation it
// builds that type (B-2026-11-04-58).
fn count(s: Set[i64]) -> i64 {
    s.len()
}

fn main() {
    let a: Array[i64, 3] = [1, 2, 3];
    println(a[2]);
    let s: Set[i64] = [1, 2, 2, 3];
    println(s.len());
    println(s.contains(2));
    println(count([4, 4, 5]));
    let t: Set[String] = ["a".to_string(), "a".to_string(), "b".to_string()];
    println(t.len());
    let e: Set[i64] = [];
    println(e.is_empty());
}
