fn main() {
    println("aaa".replace("a", "bb"));
    println("abc".replace("", "-"));
    println("abc".replace("x", "y"));
    println("straße".to_uppercase());
    println("ÀÉÎ".to_lowercase());
    println("İ".to_lowercase().len());
    let v: Str = "view";
    let o: String = v.to_string();
    let c: String = v.clone();
    println(f"{o} {c}");
    let s = "héllo";
    println(s[0..1]);
    println(s[1..3]);
    println(s[3..]);
    println(s[..3]);
    println(f"[{s.substring(1)}] [{s.substring(3, 5)}] [{s.substring(-2, 1)}] [{s.substring(4, 3)}] [{s.substring(9)}] [{s.substring(0, 99)}]");
}
