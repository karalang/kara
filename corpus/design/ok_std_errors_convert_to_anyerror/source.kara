// Every standard-library error type implements `Error`, so `?` converts it
// into `AnyError` (design.md §10 "`Error` and `AnyError`").
import std.json.{Json};
import std.pool.{Pool};
import std.time.{Duration};

struct Conn { id: i64 }

struct Refused { }

impl Display for Refused {
    fn to_string(ref self) -> String { "refused" }
}

fn connect() -> Result[Conn, Refused] { Err(Refused { }) }

fn parse_int(text: Str) -> Result[i64, AnyError] {
    match Json.parse(text)? {
        Json.Int(n) => Ok(n),
        _ => Ok(0),
    }
}

fn recv_closed() -> Result[i64, AnyError] {
    let (tx, rx): (Sender[i64], Receiver[i64]) = channel(1);
    {
        let _gone = tx;
    }
    let n = rx.recv_timeout(Duration.ms(10))?;
    Ok(n)
}

fn acquire_failing() -> Result[i64, AnyError] {
    let pool: Pool[Conn, Refused] = Pool.new(connect, 2, 2);
    let c = pool.acquire(Duration.ms(10))?;
    Ok(c.val.id)
}

fn main() {
    match parse_int("42") {
        Ok(n) => println(f"parsed {n}"),
        Err(e) => println(f"unexpected: {e}"),
    }
    match parse_int("[1,") {
        Ok(_) => println("unexpected"),
        Err(e) => println(f"json: {e}"),
    }
    match recv_closed() {
        Ok(_) => println("unexpected"),
        Err(e) => println(f"recv: {e}"),
    }
    match acquire_failing() {
        Ok(_) => println("unexpected"),
        Err(e) => println(f"pool: {e}"),
    }
}
