// design.md § Debugger contract, element 4: `std.runtime` is importable as
// a module (`runtime.list_tasks()`) and item by item. Outside any `par {}`
// block, with nothing suspended, both lists are empty, with the runtime
// debug metadata or without it (B-2026-11-05-34).
import std.runtime;
import std.runtime.{list_par_blocks, TaskInfo};

fn main() {
    let tasks: Vec[TaskInfo] = runtime.list_tasks();
    let blocks = list_par_blocks();
    println(f"{tasks.len()} {blocks.len()}");
}
