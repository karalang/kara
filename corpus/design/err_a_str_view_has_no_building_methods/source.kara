// docs/library/strings.md § Building: `String` only. A `Str` is a borrowed,
// read-only view, so `push_str` on one is refused at check; the owned
// `String` that `.to_string()` gives is what builds (B-2026-11-06-31).
fn greet(name: Str) -> String {
    name.push_str("!");
    name.to_string()
}

fn main() {
    println(greet("kara"));
}
