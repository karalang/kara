fn main() {
    let mut s = String.new();
    println(f"[{s}] {s.len()}");
    let mut t = String.with_capacity(-1);
    t.push('é');
    t.push('😀');
    t.push_str("ab");
    println(f"{t} {t.len()}");
    println(f"{String.from_utf8([104, 105])} {String.from_utf8([255]).is_err()}");
    println(String.from_utf8_lossy([104, 105, 255]));
    println(String.from_utf8_lossy([0xE2, 0x82]).len());
    let st: Str = t.as_str();
    println(st.len());
    s.extend("xyz".chars());
    let parts: Vec[String] = ["p".to_string(), "q".to_string()];
    s.extend(parts);
    println(s);
    s.retain(|c| c != 'y');
    println(s);
    println(f"{s.pop()} {s}");
    let mut e = String.new();
    println(e.pop());
    let mut u = "héllo".to_string();
    u.truncate(99);
    println(u);
    u.truncate(3);
    println(u);
    u.truncate(-1);
    println(f"[{u}] {u.len()}");
    u.reserve(-5);
    u.reserve(10);
    u.push_str("ok");
    println(u);
    s.clear();
    println(f"[{s}] {s.is_empty()}");
    let a = "ab".to_string();
    let b = "cd".to_string();
    let c = a + b;
    println(f"{c} {a} {b}");
}
