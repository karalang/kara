fn sorted(d: SortedMap[i32, i64]) {
    println(d.len());
}

fn hashed(d: Map[i32, i8]) {
    let mut t: i8 = 0;
    for (_, v) in d.iter() {
        t += v;
    }
    println(t);
}

fn pairs(v: Vec[(i64, u64)]) {
    println(v[0].1);
}

fn main() {
    let mut d = SortedMap.new();
    d.insert(1, 2);
    d.insert(3, 4);
    println(d.contains_key(1));
    sorted(d);
    let mut e = Map.new();
    e.insert(5, 6);
    e.insert(7, 8);
    hashed(e);
    let mut f = SortedMap.new();
    f.insert(1, 9000000000);
    println(f"{f}");
    let mut w = Vec.new();
    w.push((1, 18446744073709551615));
    pairs(w);
}
