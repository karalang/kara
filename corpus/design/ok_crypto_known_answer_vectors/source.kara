import std.crypto.sha2.{sha256, sha384, sha512, Sha256, Sha384, Sha512};
import std.crypto.hmac.{hmac_sha256, hmac_sha384, hmac_sha512, HmacSha256, HmacSha512};
import std.crypto.{constant_time_eq};
import std.crypto.legacy.{sha1, Sha1};
import std.encoding.{hex_encode, hex_decode, base64_encode};

fn h(s: Str) -> Vec[u8] { hex_decode(s).unwrap() }

fn main() {
    let m: Str = "";
    println(f"{hex_encode(sha256(m.bytes()))} {hex_encode(sha384(m.bytes()))}");
    println(f"{hex_encode(sha512(m.bytes()))} {hex_encode(sha1(m.bytes()))}");
    let mut a = Sha256.new(); let mut b = Sha512.new(); let mut c = Sha1.new(); let mut d = Sha384.new(); let n = m.len(); let half = n / 3;
    a.update(m.bytes()[0..half]); a.update(m.bytes()[half..n]); b.update(m.bytes()[0..half]); b.update(m.bytes()[half..n]); c.update(m.bytes()[0..half]); c.update(m.bytes()[half..n]); d.update(m.bytes()); d.update(m.bytes()[0..0]);
    println(f"{hex_encode(a.finish()) == hex_encode(sha256(m.bytes()))} {hex_encode(b.finish()) == hex_encode(sha512(m.bytes()))} {hex_encode(c.finish()) == hex_encode(sha1(m.bytes()))} {hex_encode(d.finish()) == hex_encode(sha384(m.bytes()))}");
    let m: Str = "abc";
    println(f"{hex_encode(sha256(m.bytes()))} {hex_encode(sha384(m.bytes()))}");
    println(f"{hex_encode(sha512(m.bytes()))} {hex_encode(sha1(m.bytes()))}");
    let mut a = Sha256.new(); let mut b = Sha512.new(); let mut c = Sha1.new(); let mut d = Sha384.new(); let n = m.len(); let half = n / 3;
    a.update(m.bytes()[0..half]); a.update(m.bytes()[half..n]); b.update(m.bytes()[0..half]); b.update(m.bytes()[half..n]); c.update(m.bytes()[0..half]); c.update(m.bytes()[half..n]); d.update(m.bytes()); d.update(m.bytes()[0..0]);
    println(f"{hex_encode(a.finish()) == hex_encode(sha256(m.bytes()))} {hex_encode(b.finish()) == hex_encode(sha512(m.bytes()))} {hex_encode(c.finish()) == hex_encode(sha1(m.bytes()))} {hex_encode(d.finish()) == hex_encode(sha384(m.bytes()))}");
    let m: Str = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
    println(f"{hex_encode(sha256(m.bytes()))} {hex_encode(sha384(m.bytes()))}");
    println(f"{hex_encode(sha512(m.bytes()))} {hex_encode(sha1(m.bytes()))}");
    let mut a = Sha256.new(); let mut b = Sha512.new(); let mut c = Sha1.new(); let mut d = Sha384.new(); let n = m.len(); let half = n / 3;
    a.update(m.bytes()[0..half]); a.update(m.bytes()[half..n]); b.update(m.bytes()[0..half]); b.update(m.bytes()[half..n]); c.update(m.bytes()[0..half]); c.update(m.bytes()[half..n]); d.update(m.bytes()); d.update(m.bytes()[0..0]);
    println(f"{hex_encode(a.finish()) == hex_encode(sha256(m.bytes()))} {hex_encode(b.finish()) == hex_encode(sha512(m.bytes()))} {hex_encode(c.finish()) == hex_encode(sha1(m.bytes()))} {hex_encode(d.finish()) == hex_encode(sha384(m.bytes()))}");
    let m: Str = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
    println(f"{hex_encode(sha256(m.bytes()))} {hex_encode(sha384(m.bytes()))}");
    println(f"{hex_encode(sha512(m.bytes()))} {hex_encode(sha1(m.bytes()))}");
    let mut a = Sha256.new(); let mut b = Sha512.new(); let mut c = Sha1.new(); let mut d = Sha384.new(); let n = m.len(); let half = n / 3;
    a.update(m.bytes()[0..half]); a.update(m.bytes()[half..n]); b.update(m.bytes()[0..half]); b.update(m.bytes()[half..n]); c.update(m.bytes()[0..half]); c.update(m.bytes()[half..n]); d.update(m.bytes()); d.update(m.bytes()[0..0]);
    println(f"{hex_encode(a.finish()) == hex_encode(sha256(m.bytes()))} {hex_encode(b.finish()) == hex_encode(sha512(m.bytes()))} {hex_encode(c.finish()) == hex_encode(sha1(m.bytes()))} {hex_encode(d.finish()) == hex_encode(sha384(m.bytes()))}");
    let m: Str = "";
    println(f"{hex_encode(sha256(m.bytes()))} {hex_encode(sha384(m.bytes()))}");
    println(f"{hex_encode(sha512(m.bytes()))} {hex_encode(sha1(m.bytes()))}");
    let mut a = Sha256.new(); let mut b = Sha512.new(); let mut c = Sha1.new(); let mut d = Sha384.new(); let n = m.len(); let half = n / 3;
    a.update(m.bytes()[0..half]); a.update(m.bytes()[half..n]); b.update(m.bytes()[0..half]); b.update(m.bytes()[half..n]); c.update(m.bytes()[0..half]); c.update(m.bytes()[half..n]); d.update(m.bytes()); d.update(m.bytes()[0..0]);
    println(f"{hex_encode(a.finish()) == hex_encode(sha256(m.bytes()))} {hex_encode(b.finish()) == hex_encode(sha512(m.bytes()))} {hex_encode(c.finish()) == hex_encode(sha1(m.bytes()))} {hex_encode(d.finish()) == hex_encode(sha384(m.bytes()))}");
    let mut big = Sha256.new(); let chunk: Vec[u8] = Vec.filled(1000, 97u8); for _ in 0..1000 { big.update(chunk); } println(hex_encode(big.finish()));
    let key = h("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"); let data = h("4869205468657265");
    println(f"{hex_encode(hmac_sha256(key, data))} {hex_encode(hmac_sha384(key, data))}");
    println(hex_encode(hmac_sha512(key, data)));
    let mut x = HmacSha256.new(key); x.update(data[0..data.len() / 2]); x.update(data[data.len() / 2..data.len()]); let mut y = HmacSha512.new(key); y.update(data);
    println(f"{hex_encode(x.finish()) == hex_encode(hmac_sha256(key, data))} {hex_encode(y.finish()) == hex_encode(hmac_sha512(key, data))}");
    let key = h("4a656665"); let data = h("7768617420646f2079612077616e7420666f72206e6f7468696e673f");
    println(f"{hex_encode(hmac_sha256(key, data))} {hex_encode(hmac_sha384(key, data))}");
    println(hex_encode(hmac_sha512(key, data)));
    let mut x = HmacSha256.new(key); x.update(data[0..data.len() / 2]); x.update(data[data.len() / 2..data.len()]); let mut y = HmacSha512.new(key); y.update(data);
    println(f"{hex_encode(x.finish()) == hex_encode(hmac_sha256(key, data))} {hex_encode(y.finish()) == hex_encode(hmac_sha512(key, data))}");
    let key = h("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"); let data = h("dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd");
    println(f"{hex_encode(hmac_sha256(key, data))} {hex_encode(hmac_sha384(key, data))}");
    println(hex_encode(hmac_sha512(key, data)));
    let mut x = HmacSha256.new(key); x.update(data[0..data.len() / 2]); x.update(data[data.len() / 2..data.len()]); let mut y = HmacSha512.new(key); y.update(data);
    println(f"{hex_encode(x.finish()) == hex_encode(hmac_sha256(key, data))} {hex_encode(y.finish()) == hex_encode(hmac_sha512(key, data))}");
    let key = h("0102030405060708090a0b0c0d0e0f10111213141516171819"); let data = h("cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd");
    println(f"{hex_encode(hmac_sha256(key, data))} {hex_encode(hmac_sha384(key, data))}");
    println(hex_encode(hmac_sha512(key, data)));
    let mut x = HmacSha256.new(key); x.update(data[0..data.len() / 2]); x.update(data[data.len() / 2..data.len()]); let mut y = HmacSha512.new(key); y.update(data);
    println(f"{hex_encode(x.finish()) == hex_encode(hmac_sha256(key, data))} {hex_encode(y.finish()) == hex_encode(hmac_sha512(key, data))}");
    let key = h("0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c"); let data = h("546573742057697468205472756e636174696f6e");
    println(f"{hex_encode(hmac_sha256(key, data))} {hex_encode(hmac_sha384(key, data))}");
    println(hex_encode(hmac_sha512(key, data)));
    let mut x = HmacSha256.new(key); x.update(data[0..data.len() / 2]); x.update(data[data.len() / 2..data.len()]); let mut y = HmacSha512.new(key); y.update(data);
    println(f"{hex_encode(x.finish()) == hex_encode(hmac_sha256(key, data))} {hex_encode(y.finish()) == hex_encode(hmac_sha512(key, data))}");
    let key = h("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"); let data = h("54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374");
    println(f"{hex_encode(hmac_sha256(key, data))} {hex_encode(hmac_sha384(key, data))}");
    println(hex_encode(hmac_sha512(key, data)));
    let mut x = HmacSha256.new(key); x.update(data[0..data.len() / 2]); x.update(data[data.len() / 2..data.len()]); let mut y = HmacSha512.new(key); y.update(data);
    println(f"{hex_encode(x.finish()) == hex_encode(hmac_sha256(key, data))} {hex_encode(y.finish()) == hex_encode(hmac_sha512(key, data))}");
    let key = h("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"); let data = h("");
    println(f"{hex_encode(hmac_sha256(key, data))} {hex_encode(hmac_sha384(key, data))}");
    println(hex_encode(hmac_sha512(key, data)));
    let mut x = HmacSha256.new(key); x.update(data[0..data.len() / 2]); x.update(data[data.len() / 2..data.len()]); let mut y = HmacSha512.new(key); y.update(data);
    println(f"{hex_encode(x.finish()) == hex_encode(hmac_sha256(key, data))} {hex_encode(y.finish()) == hex_encode(hmac_sha512(key, data))}");
    println(base64_encode(sha1("dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11".bytes())));
    println(f"{constant_time_eq("ab".bytes(), "ab".bytes())} {constant_time_eq("ab".bytes(), "ac".bytes())} {constant_time_eq("ab".bytes(), "abc".bytes())} {constant_time_eq("".bytes(), "".bytes())}");
}
