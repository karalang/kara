// design.md § Slice and array patterns: written `..mut ref rest` over a
// `mut ref Array[T, N]`, the rest is a `mut ref Array[T, K]` into the
// array itself, disjoint from the elements the pattern binds beside it.
fn bump(a: mut ref Array[i64, 4]) {
    let [_, ..mut ref rest, _] = a;
    rest[0] = 9;
    rest[1] += 5;
}

fn ends(a: mut ref Array[i64, 5]) {
    let [mut ref first, ..mut ref mid, mut ref last] = a;
    *first += 100;
    mid[0] = mid[2] * 10;
    *last += 200;
    mid[1] = *first + *last;
    println(f"{mid.len()} {mid}");
}

fn nested(a: mut ref Array[i64, 6]) {
    let [_, ..mut ref r] = a;
    let [_, ..mut ref s, _] = r;
    s[0] = -1;
    s[2] = -3;
}

fn total(a: ref Array[i64, 3]) -> i64 {
    let mut t = 0;
    for x in a.iter() {
        t += *x;
    }
    t
}

fn pass_on(a: mut ref Array[i64, 5]) {
    let [h, ..mut ref r, _] = a;
    println(f"{total(r)}");
    for x in r.iter_mut() {
        *x = *x * h;
    }
    r.sort();
    r.reverse();
    a[0] = 0;
}

fn whole(a: mut ref Array[String, 4]) {
    let [_, ..mut ref r] = a;
    let c = r.clone();
    r[0].push_str("!");
    println(f"{r} {c}");
    *r = ["x", "y", "z"];
}

fn empty(a: mut ref Array[i64, 2]) {
    let [mut ref x, mut ref y, ..mut ref r] = a;
    *x += r.len();
    *y += 1;
}

fn main() {
    let mut a: Array[i64, 4] = [1, 2, 3, 4];
    bump(mut a);
    println(f"{a}");
    let mut b: Array[i64, 5] = [1, 2, 3, 4, 5];
    ends(mut b);
    println(f"{b}");
    let mut c: Array[i64, 6] = [1, 2, 3, 4, 5, 6];
    nested(mut c);
    println(f"{c}");
    let mut d: Array[i64, 5] = [2, 1, 3, 4, 5];
    pass_on(mut d);
    println(f"{d}");
    let mut s: Array[String, 4] = ["a", "b", "c", "d"];
    whole(mut s);
    println(f"{s}");
    let mut e: Array[i64, 2] = [7, 8];
    empty(mut e);
    println(f"{e}");
}
