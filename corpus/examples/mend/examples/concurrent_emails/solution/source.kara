// concurrent_emails: three welcome lines built concurrently, with a
// sent-count the three `par` branches share. A plain counter written from
// two branches is refused at compile time (E0418, core-semantics.md §11.2);
// an `Atomic` in a `sync struct` is a concurrency primitive the branches
// may all update, so the parallelism stays.
sync struct Counter { count: Atomic[i64] }

fn send_welcome(user_id: i64, counter: Counter) -> String {
    let _ = counter.count.fetch_add(1);
    f"welcome user {user_id}"
}

fn main() {
    let counter = Counter { count: Atomic.new(0) };
    let (first, second, third) = par {
        send_welcome(1, counter),
        send_welcome(2, counter),
        send_welcome(3, counter),
    };
    println(first);
    println(second);
    println(third);
    println(f"sent {counter.count.load()}");
    println("done");
}
