// cs.724 §9.6: kind, `escaping` and the effect clause are independent, so
// `escaping MutFn(Event) -> i64 with writes(Log)` is one parameter type (the
// spec's example with a result added so the stored closure can be observed).
// The handler escapes (pushed), so `seen` is copied in; it is a MutFn: its
// own copy accumulates 2, then 5.
// Expected: 2, 5, 0.
effect resource Log;
struct Event { k: i64 }
struct Bus { handlers: Vec[MutFn(Event) -> i64 with writes(Log)] }
fn subscribe(bus: mut ref Bus, h: escaping MutFn(Event) -> i64 with writes(Log)) {
    bus.handlers.push(h);
}
fn main() {
    let mut bus = Bus { handlers: Vec.new() };
    let mut seen = 0;
    subscribe(mut bus, |e| { seen += e.k; seen });
    let mut h = bus.handlers.remove(0);
    println(h(Event { k: 2 }));
    println(h(Event { k: 3 }));
    println(seen);
}
