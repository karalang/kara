// core-semantics §5.6: `h.r = t` borrows `t` (design.md § Views), so `t`
// may not be dropped while `h` is still used.
struct Holder {
    r: ref String,
}

fn main() {
    let a = "a".to_string();
    let mut h = Holder { r: a };
    {
        let t = "t".to_string();
        h.r = t;
    }
    println(f"{h.r}");
}
