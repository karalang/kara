effect resource OrderDb;
effect resource Log;

struct Event { n: i64 }

// The spec's stored-callback bus (design.md § Effect variables): `E` is
// the set of effects its handlers have, solved for each bus where it is
// built and filled.
struct EventBus[with E] {
    handlers: Vec[Fn(Event) with E],
}

impl[with E] EventBus[with E] {
    fn register(mut ref self, h: escaping Fn(Event) with E) {
        self.handlers.push(h);
    }

    fn emit(self, e: Event) with E {
        for h in self.handlers { h(e); }
    }
}

fn record(e: Event) with writes(OrderDb) { }
fn note(e: Event) with writes(Log) { }

// Within one function `E` is the union of every handler bound, in any
// order. `add_note` sees the bus through a parameter whose type argument
// fixes `E` = {writes(OrderDb)}, so the handler it binds must fit that set;
// `note` brings `writes(Log)`, outside it, and is refused, naming where the
// set was fixed.
fn add_note(bus: mut ref EventBus[with writes(OrderDb)]) {
    bus.register(note);
}

fn audit() {
    let mut bus = EventBus { handlers: Vec.new() };
    bus.register(record);
    add_note(mut bus);
    bus.emit(Event { n: 7 });
}

fn main() {
    audit();
}
