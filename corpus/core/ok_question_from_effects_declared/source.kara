// design.md §10, Results and propagation: once the public function
// declares the effects of the `From` impl its `?` converts through, it
// is accepted, and the conversion runs.
effect resource Log;

pub struct Low {}

pub struct High {
    pub n: i64,
}

fn note() with writes(Log) {
}

impl From[Low] for High {
    fn from(e: own Low) -> High with writes(Log) {
        note();
        High { n: 1 }
    }
}

fn low() -> Result[i64, Low] {
    Err(Low {})
}

pub fn high() -> Result[i64, High] with writes(Log) {
    let v = low()?;
    Ok(v)
}

fn main() {
    match high() {
        Ok(v) => println(f"{v}"),
        Err(e) => println(f"error {e.n}"),
    }
}
