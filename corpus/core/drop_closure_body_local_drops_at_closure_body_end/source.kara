// cs.531 (a scope ends at the end of a closure body). The closure's local `t`
// drops when each call's body ends, before the caller prints the result:
// before, in1, d1, got7, in1, d1, end.
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
fn main() {
    let f = || {
        let t = R { id: 1 };
        println(f"in{t.id}");
        7
    };
    println("before");
    let n = f();
    println(f"got{n}");
    let m = f();
    println(f"end{m - 7}");
}
