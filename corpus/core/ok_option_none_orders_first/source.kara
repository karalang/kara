// None is less than every Some(x), and Ok(x) is less than every Err(e)
// (docs/library/core-types.md, Option and Result § Ordering; B-2026-11-08-24).

fn main() {
    let mut v: Vec[Option[i64]] = [Some(2), None, Some(1)];
    v.sort();
    println(f"{v}");

    let none: Option[i64] = None;
    println(f"{none < Some(0)} {Some(0) > none} {none <= none} {Some(-5) < Some(3)}");
    println(f"{none.cmp(Some(0)) == Ordering.Less} {Some(1).cmp(none) == Ordering.Greater}");

    let w: Vec[Option[i64]] = [Some(3), None, Some(7)];
    println(f"{w.iter().max()} {w.iter().min()}");

    let mut s: SortedSet[Option[i64]] = SortedSet.new();
    s.insert(Some(4));
    s.insert(None);
    s.insert(Some(-1));
    let mut line = "";
    for x in s.iter() {
        line = f"{line}{x};";
    }
    println(line);

    let mut q: PriorityQueue[Option[i64]] = PriorityQueue.new();
    q.push(Some(9));
    q.push(None);
    q.push(Some(2));
    println(f"{q.pop()} {q.pop()} {q.pop()}");

    let mut t: Vec[(Option[i64], i64)] = [(Some(1), 0), (None, 5), (None, 2)];
    t.sort();
    println(f"{t}");

    let mut nested: Vec[Option[Option[i64]]] = [Some(Some(1)), Some(None), None];
    nested.sort();
    println(f"{nested}");

    let mut r: Vec[Result[i64, i64]] = [Err(1), Ok(5), Err(0), Ok(3)];
    r.sort();
    println(f"{r}");
    let ok: Result[i64, i64] = Ok(100);
    let err: Result[i64, i64] = Err(-100);
    println(f"{ok < err}");
}
