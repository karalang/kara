struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
// cs.654-655 §9.1: `r` drops at the end of the inner block while `f`, which
// reads it, is still live, so the capture is by move instead. The closure
// owns R4: nothing drops at the inner block's end, `f()` still reads 4, and
// R4 drops with `f` at main's end. (The initial `|| 0` holds nothing.)
// `val(r)` passes `r` whole, so the captured place is `r` itself, not the
// Copy field `r.id` (design.md, "Where a captured path stops").
// Expected: block end, after block, 4, d4.
fn val(r: R) -> i64 { r.id }
fn main() {
    let mut f: Fn() -> i64 = || 0;
    {
        let r = R { id: 4 };
        f = || val(r);
        println("block end");
    }
    println("after block");
    println(f());
}
