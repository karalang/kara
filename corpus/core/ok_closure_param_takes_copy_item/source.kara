// cs.437, cs.438, cs.442: a closure parameter takes its type from the
// function type it is checked against, so with a `Copy` item a predicate
// gets a copy: in `(1..n).find(|j| w[j] == 13)` `j` is an `i64`, and in
// `s.chars().filter(|c| c == 'Q')` `c` is a `char`.
// w = [0, 5, 13, 13]: first j in 1..4 with w[j] == 13 is 2.
// "aQbQQ" has three Qs. Prints "2 3".
fn main() {
    let w: Vec[i64] = [0, 5, 13, 13];
    let n = 4;
    let j = (1..n).find(|j| w[j] == 13);
    let s = "aQbQQ".to_string();
    let q = s.chars().filter(|c| c == 'Q').count();
    println(f"{j ?? -1} {q}");
}
