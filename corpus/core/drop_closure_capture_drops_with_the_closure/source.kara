// cs.522 (a closure's captured values are holders, dropped with the closure).
// `make` returns the closure, so it escapes and captures `t` by move (§9.3).
// In the block, `x` is pushed before `g`, so at the block's end `g` drops first,
// taking its capture (d1), then `x` (d2), all before "after".
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
fn make(t: own R) -> Fn() -> i64 {
    || see(t)
}
fn main() {
    {
        let x = R { id: 2 };
        let g = make(R { id: 1 });
        println(f"call{g()}");
        println(f"inner end{x.id}");
    }
    println("after");
}
