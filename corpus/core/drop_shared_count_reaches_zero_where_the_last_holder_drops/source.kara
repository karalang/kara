// cs.611 (an optimiser may remove a matched increment/decrement pair on a
// shared handle only if no count reaches zero at a different point). §6.1:
// using a handle as a value increments, each holder releases at its drop.
// Part 1: `holder = Some(a)` takes a second count; a's release at the inner
// brace leaves 1; the Drop body runs when holder's old value is dropped by the
// assignment (dS1 before "end1"). Part 2: c copies b's handle and releases it
// at its block's end; b's own release at the outer block's end is the last
// (dS2 between "b alive" and "after b").
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
shared struct S { id: i64 }
impl Drop for S { fn drop(mut ref self) { println(f"dS{self.id}"); } }
fn main() {
    let mut holder: Option[S] = None;
    {
        let a = S { id: 1 };
        holder = Some(a);
        println(f"inner end{a.id}");
    }
    println(f"after inner{holder.is_some()}");
    holder = None;
    println("end1");
    {
        let b = S { id: 2 };
        {
            let c = b;
            println(f"c alive{c.id}");
        }
        println(f"b alive{b.id}");
    }
    println("after b");
}
