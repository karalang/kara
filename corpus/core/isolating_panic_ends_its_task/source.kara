struct Noisy { name: String }

impl Drop for Noisy {
    fn drop(mut ref self) {
        println(f"drop {self.name}");
    }
}

fn risky(n: i64) -> i64 {
    let _g = Noisy { name: f"risky {n}" };
    if n == 2 {
        panic("bad request");
    }
    n * 10
}

fn show(name: String, r: Result[i64, TaskFailed]) {
    match r {
        Ok(v) => println(f"{name} {v}"),
        Err(TaskFailed.Panicked { message, location }) => {
            let at = location.contains(":");
            println(f"{name} panicked: {message} (located {at})");
        }
        Err(TaskFailed.Cancelled) => println(f"{name} cancelled"),
    }
}

// Only task b prints: §11.1 orders nothing between tasks, so prints from
// several tasks have no specified order on more than one worker. Every
// handle is joined before main prints.
fn steady(n: i64) -> i64 {
    n * 10
}

fn main() {
    let g = TaskGroup.isolating();
    let a = g.spawn(|| steady(1));
    let b = g.spawn(|| {
        defer println("defer in b");
        let _h = Noisy { name: "b's own" };
        risky(2)
    });
    let c = g.spawn(|| steady(3));
    let ra = a.join();
    let rb = b.join();
    let rc = c.join();
    show("a", ra);
    show("b", rb);
    show("c", rc);
    println("main goes on");
}
