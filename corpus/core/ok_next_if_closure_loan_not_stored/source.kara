fn main() {
    let v: Vec[i64] = [1, 2, 3, 10, 11];
    let mut p = v.iter().map(|x| x + 0).peekable();
    let mut runs: Vec[i64] = Vec.new();
    while let Some(x) = p.next() {
        let mut c = 1;
        while let Some(_) = p.next_if(|y| y - x <= 2) {
            c += 1;
        }
        runs.push(c);
    }
    println(f"{runs}");
}
