// cs.610 (an optimiser may never move, add or remove a `Drop` body call). The
// guard `_g` is never read after its `let`; its Drop body must still run
// exactly at the end of `work`'s body each call (dg0 dg1 dg2 before s6), and
// the never-read `h` drops at main's end, not at its last use, after "end".
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
struct Guard { id: i64 }
impl Drop for Guard { fn drop(mut ref self) { println(f"dg{self.id}"); } }
fn work(i: i64) -> i64 {
    let _g = Guard { id: i };
    i * 2
}
fn main() {
    let h = Guard { id: 9 };
    let mut s = 0;
    for i in 0..3 {
        s = s + work(i);
    }
    println(f"s{s}");
    println("end");
}
