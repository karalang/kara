struct Hits {
    s: Str,
    pos: i64,
}

impl Iterator for Hits {
    type Item = (i64, Str);

    fn next(mut ref self) -> Option[(i64, Str)] {
        if self.pos >= self.s.len() {
            return None;
        }
        let at = self.pos;
        self.pos = at + 2;
        Some((at, self.s.slice(at, at + 1)))
    }
}

struct Own {
    s: String,
    pos: i64,
}

impl Iterator for Own {
    type Item = Str;

    fn next(mut ref self) -> Option[Str] {
        if self.pos >= self.s.len() {
            return None;
        }
        let at = self.pos;
        self.pos = at + 1;
        Some(self.s.slice(at, at + 1))
    }
}

fn main() {
    let o = Own { s: String.from("pq"), pos: 0 };
    for x in o {
        println(x);
    }
}
