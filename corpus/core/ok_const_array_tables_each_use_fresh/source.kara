// design.md § Constants, "Each use is a fresh value": a constant array is
// the same value at every use, however the compiled backend builds it.
// Tables of tuples, scalars of several widths, floats, chars and nested
// arrays are walked by `for`, indexed, and copied into a `let mut` that is
// then changed, which leaves the constant as it was (B-2026-11-18-39: the
// compiled backend now builds a literal of constants from a constant
// global and unrolls a short loop over one).
struct Step { dx: i64, dy: i64, cost: i32 }

const MOVES: Array[(i64, i64), 8] = [(1, 2), (2, 1), (2, -1), (1, -2), (-1, -2), (-2, -1), (-2, 1), (-1, 2)];
const MIXED: Array[(i64, bool), 3] = [(7, true), (-8, false), (9, true)];
const SMALL: Array[i32, 5] = [-3, 1, 4, -1, 5];
const BYTES: Array[u8, 4] = [255, 0, 17, 128];
const RATES: Array[f64, 3] = [0.5, -1.25, 3.0];
const LETTERS: Array[char, 3] = ['k', 'ā', 'z'];
const GRID: Array[Array[i64, 2], 3] = [[1, 2], [3, 4], [5, 6]];
const STEPS: Array[Step, 2] = [Step { dx: 1, dy: 0, cost: 3 }, Step { dx: 0, dy: -1, cost: 4 }];

fn reach(x: i64, y: i64) -> i64 {
    // Every knight move from (x, y) that stays on a 5 x 5 board, queued.
    let mut queue = VecDeque.new();
    for (dx, dy) in MOVES {
        let nx = x + dx;
        let ny = y + dy;
        if nx >= 0 and ny >= 0 and nx < 5 and ny < 5 {
            queue.push_back((nx, ny, dx * dy));
        }
    }
    let mut total = 0;
    while let Some((a, b, c)) = queue.pop_front() {
        total = total + a * 10 + b + c;
    }
    total
}

fn main() {
    println(f"{reach(0, 0)} {reach(2, 2)} {reach(4, 1)}");
    let mut sum = 0;
    for (v, keep) in MIXED {
        if keep {
            sum = sum + v;
        }
    }
    println(f"mixed {sum}");
    let mut small = 0;
    for s in SMALL {
        small = small * 2 + s;
    }
    println(f"small {small} {SMALL[0]} {SMALL[4]}");
    let mut bytes = 0;
    for b in BYTES {
        bytes = bytes * 3 + b;
    }
    println(f"bytes {bytes}");
    let mut rate = 0.0;
    for r in RATES {
        rate = rate * 2.0 + r;
    }
    println(f"rates {rate}");
    let mut word = String.new();
    for c in LETTERS {
        word.push(c);
    }
    println(f"letters {word}");
    let mut cells = 0;
    for row in GRID {
        for v in row {
            cells = cells * 7 + v;
        }
    }
    println(f"grid {cells} {GRID[2][1]}");
    let mut cost = 0;
    for s in STEPS {
        cost = cost + s.dx * 100 + s.dy * 10 + s.cost;
    }
    println(f"steps {cost}");
    // A copy is the user's own: changing it leaves the constant alone.
    let mut moves = MOVES;
    moves[0] = (0, 0);
    let (fx, fy) = MOVES[0];
    let (cx, cy) = moves[0];
    println(f"fresh {fx} {fy} {cx} {cy}");
    for round in 0..2 {
        let mut g = GRID;
        g[round][0] = 100;
        println(f"round {round}: {g[0][0]} {g[1][0]} {GRID[0][0]} {GRID[1][0]}");
    }
}
