// A `par` branch is a task, and a function value is CrossTask only when
// everything its environment reaches is (core semantics §6.3, §11.3): the
// closure `f` captures the `shared` handle `a`, so a branch may not call it,
// as it may not name `a` itself.
shared struct N { id: i64, mut items: Vec[i64] }
fn n(i: i64) -> N { N { id: i, items: Vec.new() } }
fn main() {
    let a = n(1);
    let f = || a.id;
    let (x, y) = par { f(), 2 };
    println(x + y);
}
