// cs.581 (review-thread ruling 2026-11-27): an errdefer belongs to its scope.
// The inner block ends normally, so its errdefer is discarded, and the later
// failure return runs only the function-level errdefer. The loop's errdefer is
// left by `break` and discarded the same way.
fn step(fail: bool) -> Result[i64, String] {
    errdefer println("outer errdefer");
    {
        errdefer println("inner errdefer");
        println("inner block");
    }
    let mut i = 0;
    while i < 3 {
        errdefer println("loop errdefer");
        i += 1;
        if i == 2 { break; }
    }
    if fail { return Err(f"late {i}"); }
    Ok(i)
}
fn main() {
    match step(true) { Ok(v) => println(v), Err(e) => println(f"err {e}") }
    match step(false) { Ok(v) => println(v), Err(e) => println(f"err {e}") }
}
