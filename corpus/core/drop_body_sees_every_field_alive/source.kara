// cs.590 (the type's own `Drop` body runs first, with every field still alive),
// cs.593. W's body reads both fields (dW 1 2), then the fields drop in reverse
// declaration order: d2 d1.
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
struct W { a: R, b: R }
impl Drop for W {
    fn drop(mut ref self) { println(f"dW {self.a.id} {self.b.id}"); }
}
fn main() {
    let w = W { a: R { id: 1 }, b: R { id: 2 } };
    println("end");
}
