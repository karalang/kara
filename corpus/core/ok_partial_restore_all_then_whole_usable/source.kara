struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
// cs.204 §3.6: once every moved part is restored the root is usable as a
// whole again. Both fields move out (eat1 d1, eat2 d2), both are assigned
// back (no drops), then `p` moves whole into `consume`, which prints and then
// drops it at its end, fields last first: d4, d3.
// Expected: eat1, d1, eat2, d2, consume 3 4, d4, d3, end.
struct P { a: R, b: R }
fn eat(r: own R) { println(f"eat{r.id}"); }
fn consume(p: own P) { println(f"consume {p.a.id} {p.b.id}"); }
fn main() {
    let mut p = P { a: R { id: 1 }, b: R { id: 2 } };
    eat(p.a);
    eat(p.b);
    p.a = R { id: 3 };
    p.b = R { id: 4 };
    consume(p);
    println("end");
}
