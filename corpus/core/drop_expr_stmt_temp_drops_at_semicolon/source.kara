// cs.548 (a temporary of an expression statement `e;` drops at the `;`). Each
// discarded value drops before the next statement prints.
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
fn main() {
    R { id: 1 };
    println("next");
    r(2);
    println("end");
}
