// cs.542 (parameters are introduced before the body, in parameter order, so
// they drop after the body's locals, last parameter first), cs.519. The body
// local x (d9) drops first, then c, b, a: d3 d2 d1, all before "after".
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
fn three(a: own R, b: own R, c: own R) {
    let x = R { id: 9 };
    println(f"body{a.id}{b.id}{c.id}{x.id}");
}
fn main() {
    three(R { id: 1 }, R { id: 2 }, R { id: 3 });
    println("after");
}
