// cs.581 ("however that value was produced"). The failure value here comes
// from a tail call and from `return` of a call, not a literal `Err(...)`: the
// function still returns the failure variant, so each errdefer runs.
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
fn step(ok: bool) -> Result[i64, String] {
    if ok { Ok(1) } else { Err("e".to_string()) }
}
fn tail_call(ok: bool) -> Result[i64, String] {
    errdefer println("errdefer tail call");
    step(ok)
}
fn return_call(ok: bool) -> Result[i64, String] {
    errdefer println("errdefer return call");
    return step(ok);
}
fn main() {
    println(f"a {tail_call(true).is_ok()}");
    println(f"b {tail_call(false).is_ok()}");
    println(f"c {return_call(true).is_ok()}");
    println(f"d {return_call(false).is_ok()}");
}
