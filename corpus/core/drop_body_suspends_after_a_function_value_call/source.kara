import std.time.{Duration, sleep};
struct Slow { n: i64 }
impl Drop for Slow { fn drop(mut ref self) { sleep(Duration.ms(1)); println(f"slow drop {self.n}"); } }
fn slow_fn(n: i64) -> Fn() -> i64 { let s = Slow { n: n }; || s.n }
fn taker(n: i64) -> OnceFn() -> i64 { let s = Slow { n: n }; || { let t = s; println("taken"); t.n } }
fn sleeper(n: i64) -> Fn() -> i64 { let s = Slow { n: n }; || { sleep(Duration.ms(1)); s.n } }
fn run(f: own OnceFn() -> i64) -> i64 { f() }
fn mk() -> Fn() -> i64 { sleep(Duration.ms(1)); let s = Slow { n: 7 }; || s.n }
fn main() {
    {
        let t = taker(1);
        println(f"taker {t()}");
    }
    {
        let t = taker(2);
        println("taker not called");
    }
    {
        let s = sleeper(3);
        println(f"sleeper {s()} {s()}");
    }
    {
        let o: OnceFn() -> i64 = slow_fn(4);
        println(f"widened {o()}");
    }
    {
        let m: MutFn() -> i64 = slow_fn(5);
        println("widened not called");
    }
    println(f"run {run(slow_fn(6))}");
    {
        let w: OnceFn() -> i64 = mk();
        println(f"widened from a suspending call {w()}");
    }
    println("end");
}
