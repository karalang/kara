// cs.555 (a `match` / `if let` scrutinee temporary drops at the end of the
// whole construct). G's pattern binds only the Copy `id`, so the G temporary
// stays whole and drops after the arm/body/else has run (dgN after the body),
// and when the construct sits inside a `let`, before the statement's later
// `say` (dg3 before say5, dg4 before say6).
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
struct G { id: i64, ok: bool }
impl Drop for G { fn drop(mut ref self) { println(f"dg{self.id}"); } }
fn g(i: i64, ok: bool) -> G { G { id: i, ok: ok } }
fn main() {
    if let G { id, ok: true } = g(2, true) {
        println(f"body{id}");
    } else {
        println("else");
    }
    println("next");
    if let G { id, ok: true } = g(1, false) {
        println(f"body{id}");
    } else {
        println("else");
    }
    let k = (if let G { id, ok: true } = g(3, true) { id } else { 0 }) + say(5);
    println(f"k{k}");
    let j = (match g(4, true) {
        G { id, ok } => {
            println(f"arm{id}{ok}");
            id
        }
    }) + say(6);
    println(f"j{j}");
}
