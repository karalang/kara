// Core semantics §8.2: the place `m.entry(1).or_insert(..).n` runs first,
// so `or_insert` lends `m` mutably for the store, and the value's `m[1]`
// reads `m` while that loan is live: a borrow error (B-2026-11-01-16).
struct Bag { n: i64 }

fn main() {
    let mut m: Map[i64, Bag] = Map.new();
    m.entry(1).or_insert(Bag { n: 1 }).n = m[1].n * 2;
    println(f"{m[1].n}");
}
