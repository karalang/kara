// cs.311: while a `mut ref place` binding is live, §5.6 applies: no place
// overlapping `w.p` may be used except through `up`. The println reads `w.p.hits`
// while `up` is still live (used on the next line), so the program is refused
// at the println (line 10).
struct P { hits: i64 }
struct W { p: P }
fn main() {
    let mut w = W { p: P { hits: 0 } };
    let up = mut ref w.p;
    println(f"{w.p.hits}");
    up.hits += 1;
}
