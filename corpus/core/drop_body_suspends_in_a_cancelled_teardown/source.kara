import std.time.{Duration, sleep, timeout};
import std.sync.{Receiver, TaskGroup};
struct N { s: String }
impl Drop for N { fn drop(mut ref self) { println(f"drop {self.s}"); } }
fn nn(s: Str) -> N { N { s: s.to_string() } }
struct Slow { n: i64 }
impl Drop for Slow { fn drop(mut ref self) { sleep(Duration.ms(5)); println(f"slow drop {self.n}"); } }
fn w(rx: own Receiver[i64]) -> i64 { let s = Slow { n: 3 }; rx.recv().unwrap_or(0) }
fn main() { let (tx, rx) = channel(1); let g = TaskGroup.new(); let h = g.spawn(|| w(rx)); sleep(Duration.ms(20)); g.cancel(); println(h.try_join().is_err()); let _ = tx; }
