fn p(x: i64) -> i64 { println(f"p{x}"); x }
fn add(a: i64, b: i64) -> i64 { a + b }
struct S { a: i64, b: i64 }
fn main() {
    let s = add(p(1), p(2));
    let t = S { b: p(4), a: p(3) };
    let u = p(5) + p(6) * p(7);
    let mut v: Vec[i64] = [0, 0];
    v[p(1)] = p(8);
    println(f"{s} {t.a} {t.b} {u} {v[1]}");
}
