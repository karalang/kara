// cs.656 §9.1 (B-2026-11-27-48): `r` is declared after `f`, so it drops first
// and the closure assigned to `f` takes it by move; reading `r.id` afterwards
// is refused (E0514: R has a Drop body).
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
// cs.656 §9.1: the non-Copy place `r` dies before `f`, so it is moved into the
// closure (§3), and a later use of `r` is E0500. (`val(r)` captures `r` whole.)
fn val(r: R) -> i64 { r.id }
fn main() {
    let mut f: Fn() -> i64 = || 0;
    {
        let r = R { id: 4 };
        f = || val(r);
        println(r.id);
    }
    println(f());
}
