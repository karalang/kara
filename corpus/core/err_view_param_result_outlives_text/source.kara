struct Cursor { src: Str, pos: i64 }
fn parse_until(c: mut ref Cursor, stop: char) -> Str {
    let start = c.pos;
    let n = c.src.len();
    while c.pos < n and c.src.char_at(c.pos) != Some(stop) {
        c.pos += 1;
    }
    let out = c.src.slice(start, c.pos);
    if c.pos < n { c.pos += 1; }
    out
}

fn main() {
    let r = {
        let text = "ab,cd".to_string();
        let mut c = Cursor { src: text.as_str(), pos: 0 };
        parse_until(mut c, ',')
    };
    println(r);
}
