// cs.556 (a `while let` scrutinee temporary drops at the end of each
// iteration's body). Each G drops after its iteration's body line; the last,
// non-matching test's G (dg2) drops before "done".
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
struct G { id: i64, ok: bool }
impl Drop for G { fn drop(mut ref self) { println(f"dg{self.id}"); } }
fn g(i: i64, ok: bool) -> G { G { id: i, ok: ok } }
fn main() {
    let mut i = 0;
    while let G { id, ok: true } = g(i, i < 2) {
        println(f"body{id}");
        i = i + 1;
    }
    println("done");
}
