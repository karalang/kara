// cs.698 §9.5: while the group lives, a captured place may not be moved.
// `data_v` (declared before `g`) is borrowed by the task until `g` drops.
import std.sync.{TaskGroup};
fn total(v: ref Vec[i64]) -> i64 { v.len() }
fn main() {
    let data_v: Vec[i64] = [1, 2, 3];
    let g = TaskGroup.new();
    let h = g.spawn(|| total(data_v));
    println(h.join());
    let taken = data_v;
    println(taken.len());
}
