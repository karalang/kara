// cs.175 §3.1: an operator is a call to the impl method it resolves to, and the
// operands take that method's declared modes. This `add` takes `own self` and
// `own rhs`, so `a + b` moves `a`; reading `a.n` afterwards is E0500 (§3.2).
struct V { n: i64 }
impl Add for V {
    type Output = V;
    fn add(own self, rhs: own V) -> V { V { n: self.n + rhs.n } }
}
fn main() {
    let a = V { n: 1 };
    let b = V { n: 2 };
    let c = a + b;
    println(c.n);
    println(a.n);
}
