// Core semantics §8.2: in `p = v` the place's operands run first, then the
// value. A `Copy` key of a map index place is read before the value, which
// may write it (B-2026-11-01-28), and a place rooted in a call returning a
// shared handle runs that call first (B-2026-11-01-29).

struct K { k: i64 }
shared struct H { mut n: i64 }

fn get(h: H) -> H {
    println("place");
    h
}

fn main() {
    let mut m: Map[i64, i64] = Map.new();
    let mut k = 1;
    m[k] = { k = 2; 5 };
    println(f"{m.contains_key(1)} {m.contains_key(2)}");

    let mut s = K { k: 1 };
    let mut f: Map[i64, i64] = Map.new();
    f[s.k] = { s.k = 2; 5 };
    println(f"{f.contains_key(1)} {f.contains_key(2)}");

    let mut sm: SortedMap[i64, i64] = SortedMap.new();
    let mut q = 1;
    sm[q] = { q = 2; 5 };
    println(f"{sm.contains_key(1)} {sm.contains_key(2)}");

    let mut vm: Vec[Map[i64, i64]] = vec![Map.new(), Map.new()];
    let mut i = 0;
    let mut j = 1;
    vm[i][j] = { i = 1; j = 2; 5 };
    println(f"{vm[0].contains_key(1)} {vm[1].contains_key(2)}");

    let h = H { n: 1 };
    get(h).n = { println("value"); 3 };
    println(h.n);
}
