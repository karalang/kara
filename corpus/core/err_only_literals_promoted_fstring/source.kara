// cs.355, cs.356: only literals are promoted; an f-string in a `ref` slot
// is a temporary, so a result borrowing it may not outlive the statement
// (§5.5). Refused at the `let` (line 8).
fn pick(a: String, b: String) -> ref String { if a.len() > b.len() { a } else { b } }
fn main() {
    let s = "abc".to_string();
    let n = 1;
    let r = pick(s, f"x{n}");
    println(r);
}
