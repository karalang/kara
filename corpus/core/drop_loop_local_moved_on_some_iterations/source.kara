// cs.534 (a place moved during an iteration and initialized again in the next
// one is tracked per iteration; its drop at the end of each iteration runs only
// if it is initialized then), cs.533. `x` is initialized afresh each iteration;
// on even iterations it moves into `take` (which drops it, §4.2), so the
// iteration's end drops nothing; on odd ones it drops at the iteration's end,
// after the `end` line.
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn r(i: i64) -> R { R { id: i } }
fn see(x: R) -> i64 { x.id }
fn say(i: i64) -> i64 { println(f"say{i}"); i }
fn add(a: i64, b: i64) -> i64 { a + b }
fn take(x: own R) { println(f"took{x.id}"); }
fn main() {
    for i in 0..4 {
        let x = R { id: i };
        if i % 2 == 0 {
            take(x);
        }
        println(f"end{i}");
    }
    println("done");
}
