import std.time.{Duration, sleep};
import std.sync.{TaskGroup};
struct Slow { n: i64 }
impl Drop for Slow { fn drop(mut ref self) { println("drop starts"); sleep(Duration.ms(50)); println(f"slow drop {self.n}"); } }
fn work() -> i64 { { let s = Slow { n: 7 }; } println("after the drop"); sleep(Duration.ms(50)); 1 }
fn main() { let g = TaskGroup.new(); let h = g.spawn(|| work()); sleep(Duration.ms(10)); g.cancel(); println(h.try_join().is_err()); println("end"); }
