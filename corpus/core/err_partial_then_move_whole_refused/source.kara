// cs.201 §3.6: after a partial move the root cannot be moved as a whole:
// `let q = parcel;` after `parcel.b` moved out is an error.
struct P { a: String, b: String }
fn main() {
    let parcel = P { a: "a".to_string(), b: "b".to_string() };
    let x = parcel.b;
    let q = parcel;
    println(x);
    println(q.a);
}
