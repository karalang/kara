// LeetCode #1503: Last Moment Before All Ants Fall Out of a Plank -- the
// statement simulated. Positions are doubled so two ants always meet at a
// point, and time runs in half units. At each tick the ants at an end
// walking off it fall, two ants on one point turn round, and every ant
// steps. O(n * ants).

fn last_moment(n: i64, left: Vec[i64], right: Vec[i64]) -> i64 {
    let mut pos: Vec[i64] = Vec.new();
    let mut dir: Vec[i64] = Vec.new();
    for p in left.iter() {
        pos.push(2 * *p);
        dir.push(-1);
    }
    for p in right.iter() {
        pos.push(2 * *p);
        dir.push(1);
    }
    let mut on = Vec.filled(pos.len(), true);
    let mut alive = pos.len();
    let mut at: Vec[i64] = Vec.filled(2 * n + 1, -1);
    let mut tick = 0;
    let mut last = 0;
    while alive > 0 {
        for i in 0..pos.len() {
            if on[i] and ((pos[i] == 0 and dir[i] == -1) or (pos[i] == 2 * n and dir[i] == 1)) {
                on[i] = false;
                alive -= 1;
                last = tick;
            }
        }
        for i in 0..pos.len() {
            if on[i] {
                let other = at[pos[i]];
                if other >= 0 {
                    dir[i] = -dir[i];
                    dir[other] = -dir[other];
                } else {
                    at[pos[i]] = i;
                }
            }
        }
        for i in 0..pos.len() {
            if on[i] {
                at[pos[i]] = -1;
                pos[i] += dir[i];
            }
        }
        tick += 1;
    }
    last / 2
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// A plank of 1 to `most` units; each position 0..=n holds a left ant, a
// right ant or none, with chance `fill` in 100 of holding one.
fn random_plank(most: i64, seed: mut ref i64) -> (i64, Vec[i64], Vec[i64]) {
    let n = next_random(mut seed) % most + 1;
    let fill = next_random(mut seed) % 100 + 1;
    let mut left: Vec[i64] = Vec.new();
    let mut right: Vec[i64] = Vec.new();
    for p in 0..n + 1 {
        if next_random(mut seed) % 100 < fill {
            if next_random(mut seed) % 2 == 0 {
                left.push(p);
            } else {
                right.push(p);
            }
        }
    }
    (n, left, right)
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let (n, left, right) = random_plank(most, mut seed);
        let answer = last_moment(n, left, right);
        total += answer;
        check = mix(check, answer);
    }
    println(f"{count} planks of 1 to {most} units: sum {total}, checksum {check}");
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    "[" + parts.join(", ") + "]"
}

fn main() {
    let examples: Vec[(i64, Vec[i64], Vec[i64])] = [
        (4, [4, 3], [0, 1]),
        (7, [], [0, 1, 2, 3, 4, 5, 6, 7]),
        (7, [0, 1, 2, 3, 4, 5, 6, 7], []),
        (1, [0], [1]),
        (1, [1], [0]),
        (20, [], []),
        (9, [5], [4]),
        (10, [2, 6], [3, 7]),
    ];
    for (n, left, right) in examples.iter() {
        println(f"n = {n}, left = {show(left)}, right = {show(right)} -> {last_moment(n, left, right)}");
    }
    let mut seed = 1503;
    batch(3000, 12, mut seed);
    batch(300, 100, mut seed);
    batch(5, 600, mut seed);
}
