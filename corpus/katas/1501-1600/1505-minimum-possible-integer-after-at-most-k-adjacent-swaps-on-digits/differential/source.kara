// LeetCode #1505: Minimum Possible Integer After at Most K Adjacent Swaps On
// Digits -- the differential.
//
// Three arms against the statement read literally, on 2000 problems, with
// six properties. The iterator arm (B-2026-11-08-12) and LeetCode's Rust
// template (B-2026-11-08-13) do not check yet and join when they do.
//
// P1  the answer is the statement read literally: the least number that
//     at most k adjacent swaps reach, by breadth-first search (up to 6
//     digits, k up to 8)
// P2  the answer has the same digits as the number
// P3  one more swap allowed never makes the answer larger
// P4  with k at least n (n - 1) / 2 the answer is the digits sorted
// P5  the answer is at most k adjacent swaps from the number
// P6  each arm agrees with at least one of the other two

// ---- swaps.kara: the ★ arm: per-digit queues and a Fenwick tree
fn taken_before(tree: Vec[i64], i: i64) -> i64 {
    let mut s = 0;
    let mut at = i;
    while at > 0 {
        s += tree[at];
        at -= at & -at;
    }
    s
}

fn take(tree: mut ref Vec[i64], i: i64) {
    let mut at = i + 1;
    while at < tree.len() {
        tree[at] += 1;
        at += at & -at;
    }
}

fn star_arm(num: String, k: i64) -> String {
    let digits = num.bytes().to_vec();
    let n = digits.len();
    let mut where: Vec[Vec[i64]] = Vec.filled(10, Vec.new());
    for i in 0..n {
        where[digits[i] as i64 - 48].push(i);
    }
    let mut head = Vec.filled(10, 0);
    let mut tree = Vec.filled(n + 1, 0);
    let mut left = k;
    let mut out = String.new();
    for _ in 0..n {
        for d in 0..10 {
            if head[d] < where[d].len() {
                let i = where[d][head[d]];
                let cost = i - taken_before(tree, i);
                if cost <= left {
                    left -= cost;
                    head[d] += 1;
                    take(mut tree, i);
                    out.push((48 + d) as u8 as char);
                    break;
                }
            }
        }
    }
    out
}

// ---- swaps_window.kara: the next k + 1 digits' smallest, rotated to the front
fn window_arm(num: String, k: i64) -> String {
    let mut digits = num.bytes().to_vec();
    let n = digits.len();
    let mut left = k;
    for i in 0..n {
        if left == 0 {
            break;
        }
        let end = n.min(i + left + 1);
        let mut best = i;
        for j in i + 1..end {
            if digits[j] < digits[best] {
                best = j;
            }
        }
        let d = digits[best];
        let mut j = best;
        while j > i {
            digits[j] = digits[j - 1];
            j -= 1;
        }
        digits[i] = d;
        left -= best - i;
    }
    String.from_utf8(digits).unwrap()
}

// ---- swaps_sorted.kara: the taken indices in a sorted Vec
fn below_sorted(taken: Vec[i64], i: i64) -> i64 {
    let mut lo = 0;
    let mut hi = taken.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if taken[mid] < i {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn sorted_arm(num: String, k: i64) -> String {
    let digits = num.bytes().to_vec();
    let n = digits.len();
    let mut queues: Vec[VecDeque[i64]] = Vec.filled(10, VecDeque.new());
    for i in 0..n {
        queues[digits[i] as i64 - 48].push_back(i);
    }
    let mut taken: Vec[i64] = Vec.new();
    let mut left = k;
    let mut out = String.new();
    for _ in 0..n {
        for d in 0..10 {
            match queues[d].front() {
                Some(i) => {
                    let at = below_sorted(taken, *i);
                    let cost = *i - at;
                    if cost <= left {
                        left -= cost;
                        taken.insert(at, *i);
                        queues[d].pop_front();
                        out.push((48 + d) as u8 as char);
                        break;
                    }
                }
                None => {}
            }
        }
    }
    out
}

// ---- the statement read literally: every number k adjacent swaps reach
fn literal(num: String, k: i64) -> String {
    let mut seen: Set[String] = Set.new();
    let mut frontier: Vec[String] = [num.clone()];
    seen.insert(num.clone());
    let mut best = num.clone();
    for _ in 0..k {
        let mut next: Vec[String] = Vec.new();
        for s in frontier.iter() {
            let b = s.bytes().to_vec();
            for i in 0..b.len() - 1 {
                let mut c = b.clone();
                c.swap(i, i + 1);
                let t = String.from_utf8(c).unwrap();
                if seen.insert(t.clone()) {
                    if t < best {
                        best = t.clone();
                    }
                    next.push(t);
                }
            }
        }
        frontier = next;
    }
    best
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(a: i64, num: String, k: i64) -> String {
    if a == 0 {
        star_arm(num.clone(), k)
    } else if a == 1 {
        window_arm(num.clone(), k)
    } else {
        sorted_arm(num.clone(), k)
    }
}

fn arm_name(a: i64) -> String {
    ["star", "window", "sorted"][a].to_string()
}

// The adjacent swaps that turn `from` into `to`: each digit of `to` taken
// from the first unused copy in `from`, counting the unused digits it
// passes.
fn swaps_between(from: String, to: String) -> i64 {
    let f = from.bytes().to_vec();
    let t = to.bytes().to_vec();
    let mut used = Vec.filled(f.len(), false);
    let mut swaps = 0;
    for c in t.iter() {
        let mut passed = 0;
        for i in 0..f.len() {
            if not used[i] {
                if f[i] == *c {
                    used[i] = true;
                    break;
                }
                passed += 1;
            }
        }
        swaps += passed;
    }
    swaps
}

fn main() {
    let arms = 3;
    let problems = 2000;
    let mut seed = 15050;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first: the digits and k
        let n = next_random(mut seed) % 6 + 1;
        let digits = next_random(mut seed) % 5 + 1;
        let mut num = String.new();
        for _ in 0..n {
            num.push((48 + next_random(mut seed) % digits) as u8 as char);
        }
        let k = next_random(mut seed) % 9;
        let mut sorted_bytes = num.bytes().to_vec();
        sorted_bytes.sort();
        let sorted = String.from_utf8(sorted_bytes).unwrap();

        let truth = literal(num, k);
        let mut answers: Vec[String] = Vec.new();
        for a in 0..arms {
            let answer = arm(a, num, k);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            let mut mine = answer.bytes().to_vec();
            mine.sort();
            if String.from_utf8(mine).unwrap() != sorted {
                fails[2] += 1;
            }
            if arm(a, num, k + 1) > answer {
                fails[3] += 1;
            }
            if k >= n * (n - 1) / 2 and answer != sorted {
                fails[4] += 1;
            }
            if fails[2] == 0 and swaps_between(num, answer) > k {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 1 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                    shown += 1;
                }
            }
        }
        for b in answers[0].bytes().iter() {
            check = mix(check, *b as i64 - 48);
        }
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
