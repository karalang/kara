// LeetCode #1505: Minimum Possible Integer After at Most K Adjacent Swaps On
// Digits -- the window greedy with iterators: the next k + 1 digits'
// smallest by `enumerate` and `min_by_key` (the first of equals), then
// `remove` and `insert` to bring it to the front.

fn min_integer(num: String, k: i64) -> String {
    let mut digits = num.bytes().to_vec();
    let n = digits.len();
    let mut left = k;
    for i in 0..n {
        let end = n.min(i + left + 1);
        let (offset, _) = digits[i..end].iter().enumerate().min_by_key(|(_, d)| *d).unwrap();
        let d = digits.remove(i + offset);
        digits.insert(i, d);
        left -= offset;
    }
    String.from_utf8(digits).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 1 to `most_n` digits drawn from the first 1 to 10 digits, and k in
// 0..=most_k.
fn random_case(most_n: i64, most_k: i64, seed: mut ref i64) -> (String, i64) {
    let n = next_random(mut seed) % most_n + 1;
    let digits = next_random(mut seed) % 10 + 1;
    let mut num = String.new();
    for _ in 0..n {
        num.push((48 + next_random(mut seed) % digits) as u8 as char);
    }
    (num, next_random(mut seed) % (most_k + 1))
}

fn batch(count: i64, most_n: i64, most_k: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let (num, k) = random_case(most_n, most_k, mut seed);
        for b in min_integer(num, k).bytes().iter() {
            check = mix(check, *b as i64 - 48);
        }
    }
    println(f"{count} numbers of 1 to {most_n} digits, k up to {most_k}: checksum {check}");
}

fn main() {
    let examples: Vec[(String, i64)] = [
        ("4321".to_string(), 4),
        ("100".to_string(), 1),
        ("36789".to_string(), 1000),
        ("22".to_string(), 22),
        ("9438957234785635408".to_string(), 23),
        ("5".to_string(), 0),
        ("54321".to_string(), 10),
        ("1032".to_string(), 2),
    ];
    for (num, k) in examples.iter() {
        println(f"{num}, k = {k} -> {min_integer(num.clone(), k)}");
    }
    let mut seed = 1505;
    batch(3000, 8, 30, mut seed);
    batch(300, 200, 3000, mut seed);
    batch(3, 1500, 1000000, mut seed);
}
