// LeetCode #1506: Find Root of N-Ary Tree -- the benchmark, the
// same algorithm as root.kara. Every value but
// the root's appears exactly once as some node's child, so the sum of all
// values less the sum of all children's values is the root's. O(n) time,
// O(1) space.

shared struct Node {
    val: i64,
    children: Vec[Node],
}

fn find_root(nodes: Vec[Node]) -> Node {
    let mut total = 0;
    for node in nodes.iter() {
        total += node.val;
        for child in node.children.iter() {
            total -= child.val;
        }
    }
    for node in nodes.iter() {
        if node.val == total {
            return node.clone();
        }
    }
    nodes[0].clone()
}

// ---- test harness ---------------------------------------------------------

fn build(vals: Vec[i64], kids: Vec[Vec[i64]]) -> Vec[Node] {
    let n = vals.len();
    let mut made: Vec[Option[Node]] = Vec.filled(n, None);
    for i in (0..n).rev() {
        let children: Vec[Node] = kids[i].iter().map(|c| made[*c].clone().unwrap()).collect();
        made[i] = Some(Node { val: vals[i], children });
    }
    made.iter().map(|m| m.clone().unwrap()).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 1 to `most` nodes with distinct values in 0..=50000, each node after the
// first the child of an earlier one, built leaves first, then shuffled.
fn random_tree(most: i64, seed: mut ref i64) -> Vec[Node] {
    let n = next_random(mut seed) % most + 1;
    let mut vals: Vec[i64] = Vec.new();
    let mut seen: Set[i64] = Set.new();
    while vals.len() < n {
        let v = (next_random(mut seed) * 65536 + next_random(mut seed)) % 50001;
        if seen.insert(v) {
            vals.push(v);
        }
    }
    let mut kids: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 1..n {
        kids[next_random(mut seed) % i].push(i);
    }
    let mut nodes = build(vals, kids);
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        nodes.swap(i, j);
    }
    nodes
}

// Built once, then each tree's root found ten times.
fn main() {
    let mut seed = 1506;
    let mut trees: Vec[Vec[Node]] = Vec.new();
    for _ in 0..20 {
        trees.push(random_tree(50000, mut seed));
    }
    let mut check = 0;
    for _ in 0..10 {
        for nodes in trees.iter() {
            let root = find_root(nodes.clone());
            check = mix(check, root.val);
        }
    }
    println(f"200 roots over 20 trees of up to 50000 nodes: checksum {check}");
}
