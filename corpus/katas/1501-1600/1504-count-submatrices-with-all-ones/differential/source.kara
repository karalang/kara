// LeetCode #1504: Count Submatrices With All Ones -- the differential.
//
// Five arms against the statement read literally, on 2000 problems, with
// six properties.
//
// P1  the count is the statement read literally: every rectangle checked
//     cell by cell (matrices of up to 5 x 5)
// P2  the matrix transposed leaves the count
// P3  the matrix turned half round leaves the count
// P4  one more cell set to 1 never lowers the count
// P5  the count is at least the number of ones and at most
//     m (m + 1) / 2 * n (n + 1) / 2, which an all-ones matrix reaches
// P6  each arm agrees with at least two of the other four

// ---- submat.kara: the ★ arm: heights and a stack
fn star_arm(mat: Vec[Vec[i64]]) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut heights = Vec.filled(n, 0);
    let mut total = 0;
    for i in 0..m {
        for j in 0..n {
            heights[j] = if mat[i][j] == 1 { heights[j] + 1 } else { 0 };
        }
        let mut ending = Vec.filled(n, 0);
        let mut stack: Vec[i64] = Vec.new();
        for j in 0..n {
            while not stack.is_empty() and heights[stack[stack.len() - 1]] >= heights[j] {
                stack.pop();
            }
            ending[j] = if stack.is_empty() {
                heights[j] * (j + 1)
            } else {
                let k = stack[stack.len() - 1];
                ending[k] + heights[j] * (j - k)
            };
            stack.push(j);
            total += ending[j];
        }
    }
    total
}

// ---- submat_left.kara: heights and a walk left
fn left_arm(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat[0].len();
    let mut heights = Vec.filled(n, 0);
    let mut total = 0;
    for row in mat.iter() {
        for j in 0..n {
            heights[j] = if row[j] == 1 { heights[j] + 1 } else { 0 };
        }
        for j in 0..n {
            let mut least = heights[j];
            let mut k = j;
            while least > 0 {
                total += least;
                if k == 0 {
                    break;
                }
                k -= 1;
                least = least.min(heights[k]);
            }
        }
    }
    total
}

// ---- submat_rows.kara: row bands and runs
fn rows_arm(mat: Vec[Vec[i64]]) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut total = 0;
    for top in 0..m {
        let mut all = Vec.filled(n, true);
        for bottom in top..m {
            let mut run = 0;
            for j in 0..n {
                all[j] = all[j] and mat[bottom][j] == 1;
                if all[j] {
                    run += 1;
                    total += run;
                } else {
                    run = 0;
                }
            }
        }
    }
    total
}

// ---- submat_iter.kara: scan, take_while, sum
fn iter_arm(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat[0].len();
    let rows: Vec[Vec[i64]] = mat.iter().scan(Vec.filled(n, 0), |heights, row| {
        let next: Vec[i64] = heights.iter().zip(row.iter()).map(|(h, x)| if *x == 1 { *h + 1 } else { 0 }).collect();
        Some((next.clone(), next))
    }).collect();
    rows.iter().map(|heights| {
        (0..n).map(|j| {
            heights[0..j + 1].iter().rev().scan(heights[j], |least, h| {
                let now = least.min(*h);
                Some((now, now))
            }).take_while(|least| *least > 0).sum()
        }).sum()
    }).sum()
}

// ---- submat_solution.kara: LeetCode's Rust template
struct Solution {}

impl Solution {
    pub fn num_submat(mat: Vec[Vec[i32]]) -> i32 {
        let n = mat[0].len();
        let mut heights: Vec[i32] = Vec.filled(n, 0);
        // both `i32`s written until B-2026-11-07-57: neither `Vec.filled(n, 0)` nor
        // `ans += least` fixes a literal's type yet
        let mut ans: i32 = 0;
        for row in ref mat {
            for j in 0..n {
                heights[j] = if row[j] == 1 { heights[j] + 1 } else { 0 };
            }
            for j in 0..n {
                let mut least = heights[j];
                for k in (0..=j).rev() {
                    least = least.min(heights[k]);
                    if least == 0 {
                        break;
                    }
                    ans += least;
                }
            }
        }
        ans
    }
}

fn rust_arm(mat: Vec[Vec[i64]]) -> i64 {
    let m: Vec[Vec[i32]] = mat.iter().map(|r| r.iter().map(|x| *x as i32).collect()).collect();
    Solution.num_submat(m)
}

// ---- the statement read literally: every rectangle, checked cell by cell
fn literal(mat: Vec[Vec[i64]]) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut count = 0;
    for r1 in 0..m {
        for r2 in r1..m {
            for c1 in 0..n {
                for c2 in c1..n {
                    let mut all = true;
                    for r in r1..r2 + 1 {
                        for c in c1..c2 + 1 {
                            if mat[r][c] != 1 {
                                all = false;
                            }
                        }
                    }
                    if all {
                        count += 1;
                    }
                }
            }
        }
    }
    count
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, mat: Vec[Vec[i64]]) -> i64 {
    if k == 0 {
        star_arm(mat.clone())
    } else if k == 1 {
        left_arm(mat.clone())
    } else if k == 2 {
        rows_arm(mat.clone())
    } else if k == 3 {
        iter_arm(mat.clone())
    } else {
        rust_arm(mat.clone())
    }
}

fn arm_name(k: i64) -> String {
    ["star", "left", "rows", "iter", "rust"][k].to_string()
}

fn main() {
    let arms = 5;
    let problems = 2000;
    let mut seed = 15040;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first: the matrix and a cell to set
        let m = next_random(mut seed) % 5 + 1;
        let n = next_random(mut seed) % 5 + 1;
        let ones = next_random(mut seed) % 101;
        let mut mat: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(if next_random(mut seed) % 100 < ones { 1 } else { 0 });
            }
            mat.push(row);
        }
        let set_r = next_random(mut seed) % m;
        let set_c = next_random(mut seed) % n;
        let mut transposed: Vec[Vec[i64]] = Vec.new();
        for c in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for r in 0..m {
                row.push(mat[r][c]);
            }
            transposed.push(row);
        }
        let mut turned: Vec[Vec[i64]] = Vec.new();
        for r in (0..m).rev() {
            let mut row = mat[r].clone();
            row.reverse();
            turned.push(row);
        }
        let mut more = mat.clone();
        more[set_r][set_c] = 1;
        let mut cells = 0;
        for row in mat.iter() {
            for x in row.iter() {
                cells += *x;
            }
        }
        let most = m * (m + 1) / 2 * (n * (n + 1) / 2);

        let truth = literal(mat);
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, mat);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(k, transposed) != answer {
                fails[2] += 1;
            }
            if arm(k, turned) != answer {
                fails[3] += 1;
            }
            if arm(k, more) < answer {
                fails[4] += 1;
            }
            if answer < cells or answer > most or (cells == m * n and answer != most) {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, answers[0]);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
