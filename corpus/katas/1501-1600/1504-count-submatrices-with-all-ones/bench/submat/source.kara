// LeetCode #1504: Count Submatrices With All Ones -- the benchmark,
// the same algorithm as submat.kara. Row by
// row, each column's height of ones ending at that row; the all-ones
// rectangles with bottom-right corner (i, j) are those ending at the
// nearest shorter column k to the left, plus `heights[j] * (j - k)` new
// ones. A stack of increasing heights finds k. O(m n).

fn count_submatrices(mat: Vec[Vec[i64]]) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut heights = Vec.filled(n, 0);
    let mut total = 0;
    for i in 0..m {
        for j in 0..n {
            heights[j] = if mat[i][j] == 1 { heights[j] + 1 } else { 0 };
        }
        let mut ending = Vec.filled(n, 0);
        let mut stack: Vec[i64] = Vec.new();
        for j in 0..n {
            while not stack.is_empty() and heights[stack[stack.len() - 1]] >= heights[j] {
                stack.pop();
            }
            ending[j] = if stack.is_empty() {
                heights[j] * (j + 1)
            } else {
                let k = stack[stack.len() - 1];
                ending[k] + heights[j] * (j - k)
            };
            stack.push(j);
            total += ending[j];
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// A `size` x `size` matrix, each cell a one with chance `ones` in 100.
fn random_square(size: i64, ones: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut mat: Vec[Vec[i64]] = Vec.new();
    for _ in 0..size {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..size {
            row.push(if next_random(mut seed) % 100 < ones { 1 } else { 0 });
        }
        mat.push(row);
    }
    mat
}

// Built once, then every matrix counted.
fn main() {
    let mut seed = 1504;
    let mut mats: Vec[Vec[Vec[i64]]] = Vec.new();
    for i in 0..400 {
        mats.push(random_square(150, 50 + i % 50, mut seed));
    }
    let mut total = 0;
    let mut check = 0;
    for mat in mats.iter() {
        let answer = count_submatrices(mat.clone());
        total += answer;
        check = mix(check, answer);
    }
    println(f"400 matrices of 150 x 150: sum {total}, checksum {check}");
}
