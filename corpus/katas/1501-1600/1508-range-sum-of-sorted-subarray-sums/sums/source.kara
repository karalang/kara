// LeetCode #1508: Range Sum of Sorted Subarray Sums -- the ★ arm: the sum
// of the k smallest subarray sums, by a binary search for the k-th
// smallest and a two-pointer sweep that counts and adds every sum at most
// a bound; the answer is the difference of two such prefixes. Every number
// is positive, so a window's sum grows with its right end.
// O(n log(sum)).

const MOD: i64 = 1000000007;

// How many subarray sums are at most `bound`, and their total.
fn at_most(prefix: Vec[i64], twice: Vec[i64], bound: i64) -> (i64, i64) {
    let n = prefix.len() - 1;
    let mut count = 0;
    let mut total = 0;
    let mut i = 0;
    for j in 1..n + 1 {
        while prefix[j] - prefix[i] > bound {
            i += 1;
        }
        count += j - i;
        total += (j - i) * prefix[j] - (twice[j] - twice[i]);
    }
    (count, total)
}

// The sum of the `k` smallest subarray sums.
fn smallest(prefix: Vec[i64], twice: Vec[i64], k: i64) -> i64 {
    if k == 0 {
        return 0;
    }
    let mut lo = 1;
    let mut hi = prefix[prefix.len() - 1];
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (count, _) = at_most(prefix, twice, mid);
        if count >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    let (count, total) = at_most(prefix, twice, lo);
    total - (count - k) * lo
}

fn range_sum(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut twice: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        twice[i + 1] = twice[i] + prefix[i];
    }
    (smallest(prefix, twice, right) - smallest(prefix, twice, left - 1)) % MOD
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` numbers from 1 to 100, each with a random
// range of places in the sorted sums.
fn batch(count: i64, most: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % 100 + 1);
        }
        let total = n * (n + 1) / 2;
        let a = next_random(mut seed) % total + 1;
        let b = next_random(mut seed) % total + 1;
        check = mix(check, range_sum(nums, n, a.min(b), a.max(b)));
    }
    check
}

fn main() {
    println(f"[1, 2, 3, 4], 1 to 5 -> {range_sum([1, 2, 3, 4], 4, 1, 5)}");
    println(f"[1, 2, 3, 4], 3 to 4 -> {range_sum([1, 2, 3, 4], 4, 3, 4)}");
    println(f"[1, 2, 3, 4], 1 to 10 -> {range_sum([1, 2, 3, 4], 4, 1, 10)}");
    println(f"[7], 1 to 1 -> {range_sum([7], 1, 1, 1)}");
    println(f"[5, 5, 5], 2 to 5 -> {range_sum([5, 5, 5], 3, 2, 5)}");
    let big: Vec[i64] = (0..1000).map(|i| 100 - i % 7).collect();
    println(f"1000 numbers, 1 to 500500 -> {range_sum(big, 1000, 1, 500500)}");
    let mut seed = 1508;
    println(f"3000 arrays of 1 to 8 numbers: checksum {batch(3000, 8, mut seed)}");
    println(f"300 arrays of 1 to 100 numbers: checksum {batch(300, 100, mut seed)}");
    println(f"3 arrays of 1 to 1000 numbers: checksum {batch(3, 1000, mut seed)}");
}
