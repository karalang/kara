// LeetCode #1508: Range Sum of Sorted Subarray Sums -- the bench: 40 arrays
// of 1000 numbers built once, then 25 ranges of places asked of each, by
// the ★ arm: the sum of the k smallest subarray sums, by a binary search
// for the k-th smallest and a two-pointer sweep that counts and adds every
// sum at most a bound.

const MOD: i64 = 1000000007;

// How many subarray sums are at most `bound`, and their total.
fn at_most(prefix: Vec[i64], twice: Vec[i64], bound: i64) -> (i64, i64) {
    let n = prefix.len() - 1;
    let mut count = 0;
    let mut total = 0;
    let mut i = 0;
    for j in 1..n + 1 {
        while prefix[j] - prefix[i] > bound {
            i += 1;
        }
        count += j - i;
        total += (j - i) * prefix[j] - (twice[j] - twice[i]);
    }
    (count, total)
}

// The sum of the `k` smallest subarray sums.
fn smallest(prefix: Vec[i64], twice: Vec[i64], k: i64) -> i64 {
    if k == 0 {
        return 0;
    }
    let mut lo = 1;
    let mut hi = prefix[prefix.len() - 1];
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (count, _) = at_most(prefix, twice, mid);
        if count >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    let (count, total) = at_most(prefix, twice, lo);
    total - (count - k) * lo
}

fn range_sum(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut twice: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        twice[i + 1] = twice[i] + prefix[i];
    }
    (smallest(prefix, twice, right) - smallest(prefix, twice, left - 1)) % MOD
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1508;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..40 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            nums.push(next_random(mut seed) % 100 + 1);
        }
        arrays.push(nums);
    }
    let total = 1000 * 1001 / 2;
    let mut check = 0;
    for _ in 0..25 {
        for nums in arrays.iter() {
            let a = next_random(mut seed) % total + 1;
            let b = next_random(mut seed) % total + 1;
            check = (check * 31 + range_sum(nums, 1000, a.min(b), a.max(b)) + 1) % 1000000007;
        }
    }
    println(f"1000 ranges over 40 arrays of 1000 numbers: checksum {check}");
}
