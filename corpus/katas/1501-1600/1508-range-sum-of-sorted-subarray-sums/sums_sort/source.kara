// LeetCode #1508: Range Sum of Sorted Subarray Sums -- every subarray sum
// in a Vec, sorted, and the places from `left` to `right` added.
// O(n^2 log n).

const MOD: i64 = 1000000007;

fn range_sum(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut sums: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut sum = 0;
        for j in i..n {
            sum += nums[j];
            sums.push(sum);
        }
    }
    sums.sort();
    let mut answer = 0;
    for k in left - 1..right {
        answer = (answer + sums[k]) % MOD;
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` numbers from 1 to 100, each with a random
// range of places in the sorted sums.
fn batch(count: i64, most: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % 100 + 1);
        }
        let total = n * (n + 1) / 2;
        let a = next_random(mut seed) % total + 1;
        let b = next_random(mut seed) % total + 1;
        check = mix(check, range_sum(nums, n, a.min(b), a.max(b)));
    }
    check
}

fn main() {
    println(f"[1, 2, 3, 4], 1 to 5 -> {range_sum([1, 2, 3, 4], 4, 1, 5)}");
    println(f"[1, 2, 3, 4], 3 to 4 -> {range_sum([1, 2, 3, 4], 4, 3, 4)}");
    println(f"[1, 2, 3, 4], 1 to 10 -> {range_sum([1, 2, 3, 4], 4, 1, 10)}");
    println(f"[7], 1 to 1 -> {range_sum([7], 1, 1, 1)}");
    println(f"[5, 5, 5], 2 to 5 -> {range_sum([5, 5, 5], 3, 2, 5)}");
    let big: Vec[i64] = (0..1000).map(|i| 100 - i % 7).collect();
    println(f"1000 numbers, 1 to 500500 -> {range_sum(big, 1000, 1, 500500)}");
    let mut seed = 1508;
    println(f"3000 arrays of 1 to 8 numbers: checksum {batch(3000, 8, mut seed)}");
    println(f"300 arrays of 1 to 100 numbers: checksum {batch(300, 100, mut seed)}");
    println(f"3 arrays of 1 to 1000 numbers: checksum {batch(3, 1000, mut seed)}");
}
