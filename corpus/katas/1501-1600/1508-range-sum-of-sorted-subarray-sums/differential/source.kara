// LeetCode #1508: Range Sum of Sorted Subarray Sums -- the differential.
//
// Five arms against the statement read literally, on 2000 problems, with
// six properties.
//
// P1  the answer is the statement read literally: every subarray summed
//     on its own, the sums sorted, the places from left to right added
// P2  the places split anywhere: left to mid plus mid + 1 to right is
//     left to right
// P3  the numbers reversed leave the answer
// P4  every number tripled triples the answer
// P5  all the places add to each number times the subarrays holding it
// P6  each arm agrees with at least three of the other four

const MOD: i64 = 1000000007;

// ---- sums.kara: the ★ arm: binary search and two pointers
// How many subarray sums are at most `bound`, and their total.
fn at_most(prefix: Vec[i64], twice: Vec[i64], bound: i64) -> (i64, i64) {
    let n = prefix.len() - 1;
    let mut count = 0;
    let mut total = 0;
    let mut i = 0;
    for j in 1..n + 1 {
        while prefix[j] - prefix[i] > bound {
            i += 1;
        }
        count += j - i;
        total += (j - i) * prefix[j] - (twice[j] - twice[i]);
    }
    (count, total)
}

// The sum of the `k` smallest subarray sums.
fn smallest(prefix: Vec[i64], twice: Vec[i64], k: i64) -> i64 {
    if k == 0 {
        return 0;
    }
    let mut lo = 1;
    let mut hi = prefix[prefix.len() - 1];
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (count, _) = at_most(prefix, twice, mid);
        if count >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    let (count, total) = at_most(prefix, twice, lo);
    total - (count - k) * lo
}

fn star_arm(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut twice: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        twice[i + 1] = twice[i] + prefix[i];
    }
    (smallest(prefix, twice, right) - smallest(prefix, twice, left - 1)) % MOD
}

// ---- sums_heap.kara: a heap merging the runs from each start
fn heap_arm(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut heap: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    for i in 0..n {
        heap.push((nums[i], i));
    }
    let mut answer = 0;
    for k in 1..right + 1 {
        let (sum, end) = heap.pop().unwrap();
        if k >= left {
            answer = (answer + sum) % MOD;
        }
        if end + 1 < n {
            heap.push((sum + nums[end + 1], end + 1));
        }
    }
    answer
}

// ---- sums_sort.kara: every sum, sorted
fn sort_arm(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut sums: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut sum = 0;
        for j in i..n {
            sum += nums[j];
            sums.push(sum);
        }
    }
    sums.sort();
    let mut answer = 0;
    for k in left - 1..right {
        answer = (answer + sums[k]) % MOD;
    }
    answer
}

// ---- sums_iter.kara: scan, flat_map, sort, skip, take
fn iter_arm(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut sums: Vec[i64] = (0..n)
        .flat_map(|i| nums[i..].iter().scan(0, |run, x| {
            let next = run + x;
            Some((next, next))
        }))
        .collect();
    sums.sort();
    sums.iter().skip(left - 1).take(right - left + 1).fold(0, |acc, s| (acc + s) % MOD)
}

// ---- sums_solution.kara: LeetCode's Rust template through karac fix
struct Solution {}

impl Solution {
    pub fn range_sum(nums: Vec[i32], n: i32, left: i32, right: i32) -> i32 {
        let n = n as usize;
        let mut sums: Vec[i64] = Vec.with_capacity((n * (n + 1) / 2) as i64);
        for i in 0..n {
            let mut sum: i64 = 0;
            for j in i..n {
                sum += nums[j];
                sums.push(sum);
            }
        }
        sums.sort();
        let total: i64 = sums[(left - 1) as usize..right as usize].iter().sum();
        (total % 1_000_000_007) as i32
    }
}

fn solution_arm(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.range_sum(narrow, n as i32, left as i32, right as i32) as i64
}
// ---- the statement read literally ----------------------------------------

fn literal(nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    let mut sums: Vec[i64] = Vec.new();
    for i in 0..n {
        for j in i..n {
            let mut sum = 0;
            for k in i..j + 1 {
                sum += nums[k];
            }
            // insertion keeps the sums sorted
            let mut at = sums.len();
            while at > 0 and sums[at - 1] > sum {
                at -= 1;
            }
            sums.insert(at, sum);
        }
    }
    let mut answer = 0;
    for place in left..right + 1 {
        answer += sums[place - 1];
    }
    answer % MOD
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, nums: Vec[i64], n: i64, left: i64, right: i64) -> i64 {
    if k == 0 {
        star_arm(nums, n, left, right)
    } else if k == 1 {
        heap_arm(nums, n, left, right)
    } else if k == 2 {
        sort_arm(nums, n, left, right)
    } else if k == 3 {
        iter_arm(nums, n, left, right)
    } else {
        solution_arm(nums, n, left, right)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "heap", "sort", "iter", "solution"][k].to_string()
}

fn main() {
    let arms = 5;
    let problems = 2000;
    let mut seed = 15080;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 10 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % 100 + 1);
        }
        let total = n * (n + 1) / 2;
        let a = next_random(mut seed) % total + 1;
        let b = next_random(mut seed) % total + 1;
        let left = a.min(b);
        let right = a.max(b);
        let mid = left + next_random(mut seed) % (right - left + 1);
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let tripled: Vec[i64] = nums.iter().map(|x| 3 * x).collect();
        let mut weighted = 0;
        for i in 0..n {
            weighted += nums[i] * (i + 1) * (n - i);
        }

        let truth = literal(nums, n, left, right);
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, nums, n, left, right);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            // `mid` may be `right`, leaving the second part empty
            let second = if mid < right { arm(k, nums, n, mid + 1, right) } else { 0 };
            if (arm(k, nums, n, left, mid) + second) % MOD != answer {
                fails[2] += 1;
            }
            if arm(k, reversed, n, left, right) != answer {
                fails[3] += 1;
            }
            if arm(k, tripled, n, left, right) != 3 * answer % MOD {
                fails[4] += 1;
            }
            if arm(k, nums, n, 1, total) != weighted % MOD {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 3 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, answers[0]);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
