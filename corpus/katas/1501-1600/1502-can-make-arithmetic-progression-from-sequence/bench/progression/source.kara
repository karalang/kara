// LeetCode #1502: Can Make Arithmetic Progression From Sequence -- the
// benchmark, the same algorithm as progression.kara. Sorted, a progression has every gap equal to the first. O(n log n).

fn can_make(arr: own Vec[i64]) -> bool {
    let mut a = arr;
    a.sort();
    let d = a[1] - a[0];
    for i in 1..a.len() - 1 {
        if a[i + 1] - a[i] != d {
            return false;
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 2 to `most` numbers: a progression, a progression with one number moved
// by one, or numbers from a small range; shuffled.
fn random_array(most: i64, seed: mut ref i64) -> Vec[i64] {
    let n = next_random(mut seed) % (most - 1) + 2;
    let kind = next_random(mut seed) % 3;
    let mut arr: Vec[i64] = Vec.new();
    if kind == 2 {
        let spread = next_random(mut seed) % 50 + 1;
        for _ in 0..n {
            arr.push(next_random(mut seed) % spread - spread / 2);
        }
    } else {
        let start = next_random(mut seed) % 2001 - 1000;
        let d = next_random(mut seed) % 21 - 10;
        for i in 0..n {
            arr.push(start + i * d);
        }
        if kind == 1 {
            let at = next_random(mut seed) % n;
            arr[at] += if next_random(mut seed) % 2 == 0 { 1 } else { -1 };
        }
    }
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        arr.swap(i, j);
    }
    arr
}

// Built once, then each array copied and answered.
fn main() {
    let mut seed = 1502;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..3000 {
        arrays.push(random_array(1000, mut seed));
    }
    let mut can = 0;
    let mut check = 0;
    for _ in 0..10 {
        for arr in arrays.iter() {
            let answer = if can_make(arr.clone()) { 1 } else { 0 };
            can += answer;
            check = mix(check, answer);
        }
    }
    println(f"30000 answers over 3000 arrays of 2 to 1000 numbers: {can} can, checksum {check}");
}
