// LeetCode #1502: Can Make Arithmetic Progression From Sequence -- the ★
// arm. Sorted, a progression has every gap equal to the first. O(n log n).

fn can_make(arr: own Vec[i64]) -> bool {
    let mut a = arr;
    a.sort();
    let d = a[1] - a[0];
    for i in 1..a.len() - 1 {
        if a[i + 1] - a[i] != d {
            return false;
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 2 to `most` numbers: a progression, a progression with one number moved
// by one, or numbers from a small range; shuffled.
fn random_array(most: i64, seed: mut ref i64) -> Vec[i64] {
    let n = next_random(mut seed) % (most - 1) + 2;
    let kind = next_random(mut seed) % 3;
    let mut arr: Vec[i64] = Vec.new();
    if kind == 2 {
        let spread = next_random(mut seed) % 50 + 1;
        for _ in 0..n {
            arr.push(next_random(mut seed) % spread - spread / 2);
        }
    } else {
        let start = next_random(mut seed) % 2001 - 1000;
        let d = next_random(mut seed) % 21 - 10;
        for i in 0..n {
            arr.push(start + i * d);
        }
        if kind == 1 {
            let at = next_random(mut seed) % n;
            arr[at] += if next_random(mut seed) % 2 == 0 { 1 } else { -1 };
        }
    }
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        arr.swap(i, j);
    }
    arr
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut can = 0;
    let mut check = 0;
    for _ in 0..count {
        let answer = if can_make(random_array(most, mut seed)) { 1 } else { 0 };
        can += answer;
        check = mix(check, answer);
    }
    println(f"{count} arrays of 2 to {most} numbers: {can} can, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [[3, 5, 1], [1, 2, 4], [1, 1], [0, 0, 0, 1], [-5, 5], [10, -2, 4, 1, 7], [1, 100, 50], [7, 7, 7]];
    for arr in examples.iter() {
        let shown: Vec[String] = arr.iter().map(|x| f"{x}").collect();
        println(f"[{shown.join(", ")}] -> {can_make(arr.clone())}");
    }
    let mut seed = 1502;
    batch(20000, 8, mut seed);
    batch(2000, 200, mut seed);
    batch(40, 1000, mut seed);
}
