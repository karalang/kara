// LeetCode #1502: Can Make Arithmetic Progression From Sequence -- the
// differential.
//
// Four arms against the statement read literally, on 3000 problems, with
// six properties. The fifth arm, LeetCode's Rust template, does not check
// yet (B-2026-11-08-11) and joins when it does.
//
// P1  the answer is the statement read literally: some order of the
//     numbers has every gap equal (arrays of up to 6 numbers)
// P2  the numbers shuffled leave the answer
// P3  every number mapped to a * x + b (a not 0) leaves the answer
// P4  a progression stays one with the next term appended
// P5  two numbers always make one, and a progression's span divides
//     evenly into n - 1 steps
// P6  each arm agrees with at least two of the other three

// ---- progression.kara: the ★ arm: sort, every gap equal to the first
fn star_arm(arr: own Vec[i64]) -> bool {
    let mut a = arr;
    a.sort();
    let d = a[1] - a[0];
    for i in 1..a.len() - 1 {
        if a[i + 1] - a[i] != d {
            return false;
        }
    }
    true
}

// ---- progression_seen.kara: the step from min and max, each number on its own step
fn seen_arm(arr: own Vec[i64]) -> bool {
    let n = arr.len();
    let mut lo = arr[0];
    let mut hi = arr[0];
    for x in arr.iter() {
        lo = lo.min(*x);
        hi = hi.max(*x);
    }
    if (hi - lo) % (n - 1) != 0 {
        return false;
    }
    let d = (hi - lo) / (n - 1);
    if d == 0 {
        return true;
    }
    let mut seen = Vec.filled(n, false);
    for x in arr.iter() {
        if (*x - lo) % d != 0 {
            return false;
        }
        let k = (*x - lo) / d;
        if seen[k] {
            return false;
        }
        seen[k] = true;
    }
    true
}

// ---- progression_place.kara: each number swapped to its step's index
fn place_arm(arr: own Vec[i64]) -> bool {
    let mut a = arr;
    let n = a.len();
    let mut lo = a[0];
    let mut hi = a[0];
    for i in 0..n {
        lo = lo.min(a[i]);
        hi = hi.max(a[i]);
    }
    if (hi - lo) % (n - 1) != 0 {
        return false;
    }
    let d = (hi - lo) / (n - 1);
    if d == 0 {
        return true;
    }
    let mut i = 0;
    while i < n {
        if (a[i] - lo) % d != 0 {
            return false;
        }
        let k = (a[i] - lo) / d;
        if k == i {
            i += 1;
        } else if a[k] == a[i] {
            return false;
        } else {
            a.swap(i, k);
        }
    }
    true
}

// ---- progression_iter.kara: zip with itself one on, all
fn iter_arm(arr: own Vec[i64]) -> bool {
    let mut a = arr;
    a.sort();
    let d = a[1] - a[0];
    a.iter().zip(a.iter().skip(1)).all(|(x, y)| *y - *x == d)
}

// ---- the statement read literally: every order of the numbers
fn some_order(a: mut ref Vec[i64], k: i64) -> bool {
    let n = a.len();
    if k == n {
        let d = a[1] - a[0];
        for i in 1..n - 1 {
            if a[i + 1] - a[i] != d {
                return false;
            }
        }
        return true;
    }
    for i in k..n {
        a.swap(k, i);
        let found = some_order(mut a, k + 1);
        a.swap(k, i);
        if found {
            return true;
        }
    }
    false
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, arr: Vec[i64]) -> bool {
    if k == 0 {
        star_arm(arr.clone())
    } else if k == 1 {
        seen_arm(arr.clone())
    } else if k == 2 {
        place_arm(arr.clone())
    } else {
        iter_arm(arr.clone())
    }
}

fn arm_name(k: i64) -> String {
    ["star", "seen", "place", "iter"][k].to_string()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15020;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first: the numbers, a shuffle, a map
        let n = next_random(mut seed) % 7 + 2;
        let kind = next_random(mut seed) % 3;
        let mut arr: Vec[i64] = Vec.new();
        if kind == 2 {
            let spread = next_random(mut seed) % 12 + 1;
            for _ in 0..n {
                arr.push(next_random(mut seed) % spread - spread / 2);
            }
        } else {
            let start = next_random(mut seed) % 41 - 20;
            let d = next_random(mut seed) % 9 - 4;
            for i in 0..n {
                arr.push(start + i * d);
            }
            if kind == 1 {
                let at = next_random(mut seed) % n;
                arr[at] += if next_random(mut seed) % 2 == 0 { 1 } else { -1 };
            }
            for i in (1..n).rev() {
                let j = next_random(mut seed) % (i + 1);
                arr.swap(i, j);
            }
        }
        let mut shuffled = arr.clone();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            shuffled.swap(i, j);
        }
        let scale = (next_random(mut seed) % 3 + 1) * (if next_random(mut seed) % 2 == 0 { 1 } else { -1 });
        let shift = next_random(mut seed) % 101 - 50;
        let mapped: Vec[i64] = arr.iter().map(|x| scale * *x + shift).collect();
        let mut lo = arr[0];
        let mut hi = arr[0];
        for x in arr.iter() {
            lo = lo.min(*x);
            hi = hi.max(*x);
        }
        let mut longer = arr.clone();
        if n >= 2 {
            longer.push(hi + (hi - lo) / (n - 1));
        }

        let literal = if n <= 6 {
            let mut copy = arr.clone();
            some_order(mut copy, 0)
        } else {
            false
        };
        let mut answers: Vec[bool] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, arr);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if n <= 6 and answer != literal {
                fails[1] += 1;
            }
            if arm(k, shuffled) != answer {
                fails[2] += 1;
            }
            if arm(k, mapped) != answer {
                fails[3] += 1;
            }
            if answer and not arm(k, longer) {
                fails[4] += 1;
            }
            if (n == 2 and not answer) or (answer and (hi - lo) % (n - 1) != 0) {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, if answers[0] { 1 } else { 0 });
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
