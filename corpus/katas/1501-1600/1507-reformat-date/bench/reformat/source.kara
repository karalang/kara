// LeetCode #1507: Reformat Date -- the bench: 100000 dates built once,
// then each reformatted ten times by the ★ arm.

fn reformat_date(date: String) -> String {
    let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    let parts: Vec[String] = date.split(" ").map(|p| p.to_string()).collect();
    let digits: String = parts[0].chars().take_while(|c| c.is_ascii_digit()).collect();
    let day = i64.parse(digits).unwrap();
    let month = months.iter().position(|m| *m == parts[1]).unwrap() + 1;
    f"{parts[2]}-{month:02}-{day:02}"
}

fn suffix(day: i64) -> String {
    if day == 1 or day == 21 or day == 31 {
        "st"
    } else if day == 2 or day == 22 {
        "nd"
    } else if day == 3 or day == 23 {
        "rd"
    } else {
        "th"
    }
}

fn days_in(month: i64, year: i64) -> i64 {
    let days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0);
    if month == 1 and leap {
        29
    } else {
        days[month]
    }
}

fn write_date(day: i64, month: i64, year: i64) -> String {
    let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    f"{day}{suffix(day)} {names[month]} {year}"
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1507;
    let mut dates: Vec[String] = Vec.new();
    for _ in 0..100000 {
        let year = 1900 + next_random(mut seed) % 201;
        let month = next_random(mut seed) % 12;
        let day = 1 + next_random(mut seed) % days_in(month, year);
        dates.push(write_date(day, month, year));
    }
    let mut check = 0;
    for _ in 0..10 {
        for date in dates.iter() {
            let out = reformat_date(date);
            for b in out.bytes() {
                check = mix(check, b);
            }
        }
    }
    println(f"1000000 dates reformatted, 100000 built once: checksum {check}");
}
