// LeetCode #1507: Reformat Date -- the ★ arm: split on spaces, the day's
// leading digits, the month's place in the table, and the year as it is.

fn reformat_date(date: String) -> String {
    let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    let parts: Vec[String] = date.split(" ").map(|p| p.to_string()).collect();
    let digits: String = parts[0].chars().take_while(|c| c.is_ascii_digit()).collect();
    let day = i64.parse(digits).unwrap();
    let month = months.iter().position(|m| *m == parts[1]).unwrap() + 1;
    f"{parts[2]}-{month:02}-{day:02}"
}

// ---- the harness: the same in every arm --------------------------------

fn suffix(day: i64) -> String {
    if day == 1 or day == 21 or day == 31 {
        "st"
    } else if day == 2 or day == 22 {
        "nd"
    } else if day == 3 or day == 23 {
        "rd"
    } else {
        "th"
    }
}

fn days_in(month: i64, year: i64) -> i64 {
    let days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0);
    if month == 1 and leap {
        29
    } else {
        days[month]
    }
}

// A date in the statement's form: month counts from 0.
fn write_date(day: i64, month: i64, year: i64) -> String {
    let names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    f"{day}{suffix(day)} {names[month]} {year}"
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn fold(check: i64, out: String) -> i64 {
    let mut c = check;
    for b in out.bytes() {
        c = mix(c, b);
    }
    c
}

fn main() {
    let examples = ["20th Oct 2052", "6th Jun 1933", "26th May 1960", "1st Jan 1900", "31st Dec 2100", "22nd Feb 2000", "3rd Mar 2003", "29th Feb 2096"];
    for date in examples.iter() {
        println(f"{date} -> {reformat_date(date)}");
    }
    let mut check = 0;
    let mut count = 0;
    for year in [1900, 1901, 2000, 2052, 2100].iter() {
        for month in 0..12 {
            for day in 1..days_in(month, *year) + 1 {
                check = fold(check, reformat_date(write_date(day, month, *year)));
                count += 1;
            }
        }
    }
    println(f"{count} dates, every day of five years: checksum {check}");
    let mut seed = 1507;
    check = 0;
    for _ in 0..3000 {
        let year = 1900 + next_random(mut seed) % 201;
        let month = next_random(mut seed) % 12;
        let day = 1 + next_random(mut seed) % days_in(month, year);
        check = fold(check, reformat_date(write_date(day, month, year)));
    }
    println(f"3000 random dates from 1900 to 2100: checksum {check}");
}
