// LeetCode #740: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random lists.

// ---- ★ arm ----------------------------------------------------------

fn delete_and_earn_star(nums: Vec[i64]) -> i64 {
    let mut top = 0;
    for x in nums.iter() {
        if *x > top {
            top = *x;
        }
    }
    let mut points: Vec[i64] = Vec.new();
    for _ in 0..top + 1 {
        points.push(0);
    }
    for x in nums.iter() {
        points[*x] += *x;
    }
    let mut take = 0;
    let mut skip = 0;
    for v in 0..top + 1 {
        let taken = skip + points[v];
        skip = if take > skip { take } else { skip };
        take = taken;
    }
    if take > skip { take } else { skip }
}

// ---- sorted arm -----------------------------------------------------

fn delete_and_earn_sorted(nums: Vec[i64]) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut take = 0;
    let mut skip = 0;
    let mut last = -10;
    let mut i = 0;
    while i < sorted.len() {
        let v = sorted[i];
        let mut worth = 0;
        while i < sorted.len() and sorted[i] == v {
            worth += v;
            i += 1;
        }
        let best = if take > skip { take } else { skip };
        if v == last + 1 {
            take = skip + worth;
        } else {
            take = best + worth;
        }
        skip = best;
        last = v;
    }
    if take > skip { take } else { skip }
}

// ---- totals arm -----------------------------------------------------

fn delete_and_earn_totals(nums: Vec[i64]) -> i64 {
    let mut worth: SortedMap[i64, i64] = SortedMap.new();
    for x in nums.iter() {
        let before = worth.get(*x).unwrap_or(0);
        worth.insert(*x, before + *x);
    }
    let mut values: Vec[i64] = Vec.new();
    let mut best: Vec[i64] = Vec.new();
    for (v, w) in worth.iter() {
        let k = values.len();
        let prev = if k == 0 { 0 } else { best[k - 1] };
        let before = if k > 0 and values[k - 1] == *v - 1 {
            if k >= 2 { best[k - 2] } else { 0 }
        } else {
            prev
        };
        let here = if before + *w > prev { before + *w } else { prev };
        values.push(*v);
        best.push(here);
    }
    if best.len() == 0 { 0 } else { best[best.len() - 1] }
}

// ---- runs arm -------------------------------------------------------

fn best_of_run_runs(points: Vec[i64], from: i64, to: i64) -> i64 {
    let mut take = 0;
    let mut skip = 0;
    for v in from..to {
        let taken = skip + points[v];
        skip = if take > skip { take } else { skip };
        take = taken;
    }
    if take > skip { take } else { skip }
}

fn delete_and_earn_runs(nums: Vec[i64]) -> i64 {
    let mut top = 0;
    for x in nums.iter() {
        if *x > top {
            top = *x;
        }
    }
    let mut points: Vec[i64] = Vec.new();
    for _ in 0..top + 2 {
        points.push(0);
    }
    for x in nums.iter() {
        points[*x] += *x;
    }
    let mut total = 0;
    let mut v = 1;
    while v <= top {
        if points[v] == 0 {
            v += 1;
        } else {
            let start = v;
            while points[v] > 0 {
                v += 1;
            }
            total += best_of_run_runs(points, start, v);
        }
    }
    total
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, nums: Vec[i64]) -> i64 {
    if which == 0 {
        delete_and_earn_star(nums)
    } else if which == 1 {
        delete_and_earn_sorted(nums)
    } else if which == 2 {
        delete_and_earn_totals(nums)
    } else {
        delete_and_earn_runs(nums)
    }
}

// The definition, as the problem states it: play every order of moves.
// A move takes one number still present, earns it, and deletes every
// copy of the numbers one less and one more; the best game is found by
// trying each distinct number present as the next move, the list kept
// as counts by value.
fn best_game(counts: mut ref Vec[i64]) -> i64 {
    let mut best = 0;
    for v in 1..counts.len() - 1 {
        if counts[v] > 0 {
            let below = counts[v - 1];
            let above = counts[v + 1];
            counts[v] -= 1;
            counts[v - 1] = 0;
            counts[v + 1] = 0;
            let got = v + best_game(mut counts);
            counts[v] += 1;
            counts[v - 1] = below;
            counts[v + 1] = above;
            if got > best {
                best = got;
            }
        }
    }
    best
}

fn definition(nums: Vec[i64]) -> i64 {
    let mut counts: Vec[i64] = Vec.new();
    for _ in 0..30 {
        counts.push(0);
    }
    for x in nums.iter() {
        counts[*x] += 1;
    }
    best_game(mut counts)
}

fn main() {
    let mut seed = 7400;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut points = 0;
    let cases = 3000;
    for _ in 0..cases {
        // 1 to 7 numbers from 1 to r for a random r from 1 to 9, so that
        // repeats and neighbours are common
        let n = 1 + next_random(mut seed) % 7;
        let r = 1 + next_random(mut seed) % 9;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % r);
        }
        let want = definition(nums);
        points += want;
        // the numbers in reverse order
        let mut reversed: Vec[i64] = Vec.new();
        let mut k = n;
        while k > 0 {
            k -= 1;
            reversed.push(nums[k]);
        }
        // every number made one larger
        let mut shifted: Vec[i64] = Vec.new();
        for x in nums.iter() {
            shifted.push(*x + 1);
        }
        // a second list of numbers from 12 to 14, kept apart from the
        // first by a gap of two at least
        let m = 1 + next_random(mut seed) % 4;
        let mut far: Vec[i64] = Vec.new();
        for _ in 0..m {
            far.push(12 + next_random(mut seed) % 3);
        }
        let mut both = nums.clone();
        for x in far.iter() {
            both.push(*x);
        }
        for which in 0..arms {
            let got = answer_with(which, nums);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the numbers in another order, the same answer.
            checks += 1;
            if answer_with(which, reversed) != got {
                fails[1] += 1;
            }
            // P3: every number one larger earns the same choice of
            // values, each worth one more a copy: the answer grows by the
            // number of copies taken, between 0 and n.
            checks += 1;
            let more = answer_with(which, shifted) - got;
            if more < 0 or more > n {
                fails[2] += 1;
            }
            // P4: two lists whose values never touch are two games, and
            // played together earn the sum of their answers.
            checks += 1;
            if answer_with(which, both) != got + answer_with(which, far) {
                fails[3] += 1;
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{cases} cases ({points} points in all), {arms} arms, {checks} checks, {total} failures");
}
