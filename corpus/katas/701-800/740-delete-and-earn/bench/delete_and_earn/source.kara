// LeetCode #740: Delete and Earn -- house robber over values.
//
// Taking a number earns it and deletes every number one less or one
// more, so every copy of a value is taken together or not at all, and
// two neighbouring values cannot both be taken. Total the points each
// value is worth, then walk the values in order keeping the best total
// with the last value taken and with it left. O(n + m) for the largest
// value m.

fn delete_and_earn(nums: Vec[i64]) -> i64 {
    let mut top = 0;
    for x in nums.iter() {
        if *x > top {
            top = *x;
        }
    }
    let mut points: Vec[i64] = Vec.new();
    for _ in 0..top + 1 {
        points.push(0);
    }
    for x in nums.iter() {
        points[*x] += *x;
    }
    let mut take = 0;
    let mut skip = 0;
    for v in 0..top + 1 {
        let taken = skip + points[v];
        skip = if take > skip { take } else { skip };
        take = taken;
    }
    if take > skip { take } else { skip }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20,000 random numbers from 1 to 10,000, made once; in each of
    // 5,000 rounds 20 random numbers change to a random value and the
    // most points are found again and summed.
    let mut seed: i64 = 740;
    let n = 20000;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(1 + next_random(mut seed) % 10000);
    }
    let mut total = 0;
    for _ in 0..5000 {
        for _ in 0..20 {
            let j = next_random(mut seed) % n;
            nums[j] = 1 + next_random(mut seed) % 10000;
        }
        total += delete_and_earn(nums);
    }
    println(f"5000 rounds of 20000 numbers: {total} points in all");
}
