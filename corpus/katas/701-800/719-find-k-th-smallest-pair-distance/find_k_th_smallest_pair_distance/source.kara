// LeetCode #719: Find K-th Smallest Pair Distance -- binary search on
// the distance.
//
// Sort the numbers. For a distance d, the pairs at most d apart can be
// counted in one pass with two pointers: for each right end, move the
// left end on while it is more than d below. The answer is the least d
// with at least k such pairs, found by binary search between 0 and the
// largest distance. O(n log n + n log W), W the largest distance.

fn smallest_distance_pair(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut lo = 0;
    let mut hi = sorted[n - 1] - sorted[0];
    while lo < hi {
        let mid = (lo + hi) / 2;
        let mut count = 0;
        let mut left = 0;
        for right in 0..n {
            while sorted[right] - sorted[left] > mid {
                left += 1;
            }
            count += right - left;
        }
        if count >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(seed: mut ref i64, n: i64, top: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1));
    }
    nums
}

fn show(nums: Vec[i64], k: i64) {
    println(f"{nums}, k = {k} -> {smallest_distance_pair(nums, k)}");
}

fn main() {
    show([1, 3, 1], 1);
    show([1, 1, 1], 2);
    show([1, 6, 1], 3);
    show([0, 1000000], 1);
    show([5, 5], 1);
    show([9, 4, 7, 1, 10], 1);
    show([9, 4, 7, 1, 10], 5);
    show([9, 4, 7, 1, 10], 10);
    let mut seed: i64 = 719;
    let a = random_nums(mut seed, 400, 1000000);
    let pairs = 400 * 399 / 2;
    println(f"400 numbers to 10^6: k = 1 -> {smallest_distance_pair(a, 1)}, middle -> {smallest_distance_pair(a, pairs / 2)}, last -> {smallest_distance_pair(a, pairs)}");
    let b = random_nums(mut seed, 400, 10);
    println(f"400 numbers to 10: k = 1 -> {smallest_distance_pair(b, 1)}, middle -> {smallest_distance_pair(b, pairs / 2)}, last -> {smallest_distance_pair(b, pairs)}");
    let mut sum = 0;
    for _ in 0..300 {
        let n = 2 + next_random(mut seed) % 40;
        let top = next_random(mut seed) % 50;
        let nums = random_nums(mut seed, n, top);
        let k = 1 + next_random(mut seed) % (n * (n - 1) / 2);
        sum = (sum * 131 + smallest_distance_pair(nums, k)) % 1000000007;
    }
    println(f"300 random arrays: checksum {sum}");
}
