// LeetCode #719: Find K-th Smallest Pair Distance -- binary search
// twice over.
//
// The ★ arm's search on the distance, but each count finds, for every
// number, how many later numbers lie within d of it by its own binary
// search in the sorted list. O(n log n log W).

// The index of the first value above x in sorted[from..].
fn first_above(sorted: Vec[i64], from: i64, x: i64) -> i64 {
    let mut lo = from;
    let mut hi = sorted.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if sorted[mid] > x {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn smallest_distance_pair(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut lo = 0;
    let mut hi = sorted[n - 1] - sorted[0];
    while lo < hi {
        let mid = (lo + hi) / 2;
        let mut count = 0;
        for i in 0..n {
            count += first_above(sorted, i + 1, sorted[i] + mid) - (i + 1);
        }
        if count >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(seed: mut ref i64, n: i64, top: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1));
    }
    nums
}

fn show(nums: Vec[i64], k: i64) {
    println(f"{nums}, k = {k} -> {smallest_distance_pair(nums, k)}");
}

fn main() {
    show([1, 3, 1], 1);
    show([1, 1, 1], 2);
    show([1, 6, 1], 3);
    show([0, 1000000], 1);
    show([5, 5], 1);
    show([9, 4, 7, 1, 10], 1);
    show([9, 4, 7, 1, 10], 5);
    show([9, 4, 7, 1, 10], 10);
    let mut seed: i64 = 719;
    let a = random_nums(mut seed, 400, 1000000);
    let pairs = 400 * 399 / 2;
    println(f"400 numbers to 10^6: k = 1 -> {smallest_distance_pair(a, 1)}, middle -> {smallest_distance_pair(a, pairs / 2)}, last -> {smallest_distance_pair(a, pairs)}");
    let b = random_nums(mut seed, 400, 10);
    println(f"400 numbers to 10: k = 1 -> {smallest_distance_pair(b, 1)}, middle -> {smallest_distance_pair(b, pairs / 2)}, last -> {smallest_distance_pair(b, pairs)}");
    let mut sum = 0;
    for _ in 0..300 {
        let n = 2 + next_random(mut seed) % 40;
        let top = next_random(mut seed) % 50;
        let nums = random_nums(mut seed, n, top);
        let k = 1 + next_random(mut seed) % (n * (n - 1) / 2);
        sum = (sum * 131 + smallest_distance_pair(nums, k)) % 1000000007;
    }
    println(f"300 random arrays: checksum {sum}");
}
