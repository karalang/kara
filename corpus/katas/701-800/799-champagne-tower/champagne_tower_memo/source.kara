// LeetCode 799 — Champagne Tower, what reaches a glass, asked upwards.
//
// What reaches glass (r, c) is half the overflow of the glass above it
// on the left, (r - 1, c - 1), plus half that of the one above on the
// right, (r - 1, c), where there are such glasses. Ask that from the
// queried glass up, keeping each answer so no glass is worked out
// twice. O(r²).
fn champagne_tower(poured: i64, query_row: i64, query_glass: i64) -> f64 {
    let mut known: Map[(i64, i64), f64] = Map.new();
    let got = reaching(poured, query_row, query_glass, mut known);
    if got > 1.0 { 1.0 } else { got }
}

fn reaching(poured: i64, r: i64, c: i64, known: mut ref Map[(i64, i64), f64]) -> f64 {
    if r == 0 {
        return poured as f64;
    }
    if let Some(amount) = known.get((r, c)) {
        return *amount;
    }
    let mut amount = 0.0;
    if c > 0 {
        let over = reaching(poured, r - 1, c - 1, mut known) - 1.0;
        if over > 0.0 {
            amount += over / 2.0;
        }
    }
    if c < r {
        let over = reaching(poured, r - 1, c, mut known) - 1.0;
        if over > 0.0 {
            amount += over / 2.0;
        }
    }
    known.insert((r, c), amount);
    amount
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(poured: i64, query_row: i64, query_glass: i64) {
    let got = champagne_tower(poured, query_row, query_glass);
    println(f"poured = {poured}, glass ({query_row}, {query_glass}) -> {got:.5}");
}

fn main() {
    show(1, 1, 1);
    show(2, 1, 1);
    show(100000009, 33, 17);
    show(0, 0, 0);
    show(1, 0, 0);
    show(4, 2, 1);
    show(4, 2, 0);
    show(25, 6, 0);
    show(1000000000, 99, 0);
    show(1000000000, 99, 49);
    let mut seed = 799;
    let mut total = 0.0;
    let mut check = 0;
    for i in 0..300 {
        let poured = if i % 2 == 0 {
            next_random(mut seed) % 200
        } else {
            (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001
        };
        let query_row = next_random(mut seed) % 100;
        let query_glass = next_random(mut seed) % (query_row + 1);
        let got = champagne_tower(poured, query_row, query_glass);
        total += got;
        check = (check * 31 + (got * 1000000.0) as i64) % 1000000007;
    }
    println(f"300 random glasses: {total:.5} cups in all, checksum {check}");
}
