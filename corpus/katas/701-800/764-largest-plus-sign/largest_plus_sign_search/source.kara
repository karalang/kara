// LeetCode 764 — Largest Plus Sign, binary search on the order.
//
// A plus of order k holds one of every smaller order, so the orders that
// fit are 1 up to the answer, and the answer can be found by binary
// search. Whether order k fits anywhere is a matter of counting: with
// running counts of the mines along each row and column, a cell's arms are
// clear when the row from c - k + 1 to c + k - 1 and the column from
// r - k + 1 to r + k - 1 hold no mine. O(n^2 log n).

fn fits(n: i64, k: i64, rows: ref Vec[Vec[i64]], columns: ref Vec[Vec[i64]]) -> bool {
    for r in k - 1..n - k + 1 {
        for c in k - 1..n - k + 1 {
            if rows[r][c + k] - rows[r][c - k + 1] == 0 and columns[c][r + k] - columns[c][r - k + 1] == 0 {
                return true;
            }
        }
    }
    false
}

fn order_of_largest_plus_sign(n: i64, mines: Vec[Vec[i64]]) -> i64 {
    // rows[r][c] counts the mines in row r before column c, and columns[c][r]
    // the mines in column c before row r.
    let mut rows: Vec[Vec[i64]] = Vec.new();
    let mut columns: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let mut zeros: Vec[i64] = Vec.new();
        for _ in 0..n + 1 {
            zeros.push(0);
        }
        rows.push(zeros.clone());
        columns.push(zeros);
    }
    for mine in mines.iter() {
        rows[mine[0]][mine[1] + 1] += 1;
        columns[mine[1]][mine[0] + 1] += 1;
    }
    for i in 0..n {
        for j in 1..n + 1 {
            rows[i][j] += rows[i][j - 1];
            columns[i][j] += columns[i][j - 1];
        }
    }
    let mut low = 0;
    let mut high = (n + 1) / 2;
    while low < high {
        let middle = (low + high + 1) / 2;
        if fits(n, middle, rows, columns) {
            low = middle;
        } else {
            high = middle - 1;
        }
    }
    low
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` distinct random mines in an n x n grid.
fn random_mines(n: i64, count: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut taken: Set[i64] = Set.new();
    let mut mines: Vec[Vec[i64]] = Vec.new();
    while mines.len() < count {
        let r = next_random(mut seed) % n;
        let c = next_random(mut seed) % n;
        if not taken.contains(r * n + c) {
            taken.insert(r * n + c);
            mines.push([r, c]);
        }
    }
    mines
}

fn show(n: i64, mines: Vec[Vec[i64]]) {
    let order = order_of_largest_plus_sign(n, mines.clone());
    println(f"n = {n}, mines {mines} -> {order}");
}

fn main() {
    show(5, [[4, 2]]);
    show(1, [[0, 0]]);
    show(2, [[0, 0]]);
    show(3, [[0, 0]]);
    show(3, [[1, 1]]);
    show(10, [[0, 0]]);
    show(4, [[0, 1], [1, 3], [2, 0], [3, 2]]);
    show(500, [[0, 0], [249, 250], [499, 499]]);
    let mut seed = 764;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let count = 1 + next_random(mut seed) % (n * n / 4 + 1);
        let order = order_of_largest_plus_sign(n, random_mines(n, count, mut seed));
        total += order;
        check = (check * 31 + order) % 1000000007;
    }
    println(f"300 random grids: orders adding up to {total}, checksum {check}");
}
