// LeetCode 764 — Largest Plus Sign, from the nearest mines.
//
// Keep each row's and each column's mines in sorted lists, with the walls
// just outside the grid as mines too. A cell's arm in a direction reaches
// to just short of the nearest mine that way, found by binary search, so
// the order centred on a cell is the smallest of its four distances.
// O(n^2 log n).

// The index in the sorted `list` of the first value above `x`.
fn first_above(list: ref Vec[i64], x: i64) -> i64 {
    let mut low = 0;
    let mut high = list.len();
    while low < high {
        let middle = (low + high) / 2;
        if list[middle] <= x {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    low
}

fn order_of_largest_plus_sign(n: i64, mines: Vec[Vec[i64]]) -> i64 {
    let mut rows: Vec[Vec[i64]] = Vec.new();
    let mut columns: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        rows.push([-1, n]);
        columns.push([-1, n]);
    }
    for mine in mines.iter() {
        rows[mine[0]].push(mine[1]);
        columns[mine[1]].push(mine[0]);
    }
    for i in 0..n {
        rows[i].sort();
        columns[i].sort();
    }
    let mut best = 0;
    for r in 0..n {
        for c in 0..n {
            let a = first_above(rows[r], c);
            let b = first_above(columns[c], r);
            if rows[r][a - 1] == c {
                continue;
            }
            let across = (c - rows[r][a - 1]).min(rows[r][a] - c);
            let down = (r - columns[c][b - 1]).min(columns[c][b] - r);
            best = best.max(across.min(down));
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` distinct random mines in an n x n grid.
fn random_mines(n: i64, count: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut taken: Set[i64] = Set.new();
    let mut mines: Vec[Vec[i64]] = Vec.new();
    while mines.len() < count {
        let r = next_random(mut seed) % n;
        let c = next_random(mut seed) % n;
        if not taken.contains(r * n + c) {
            taken.insert(r * n + c);
            mines.push([r, c]);
        }
    }
    mines
}

fn show(n: i64, mines: Vec[Vec[i64]]) {
    let order = order_of_largest_plus_sign(n, mines.clone());
    println(f"n = {n}, mines {mines} -> {order}");
}

fn main() {
    show(5, [[4, 2]]);
    show(1, [[0, 0]]);
    show(2, [[0, 0]]);
    show(3, [[0, 0]]);
    show(3, [[1, 1]]);
    show(10, [[0, 0]]);
    show(4, [[0, 1], [1, 3], [2, 0], [3, 2]]);
    show(500, [[0, 0], [249, 250], [499, 499]]);
    let mut seed = 764;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let count = 1 + next_random(mut seed) % (n * n / 4 + 1);
        let order = order_of_largest_plus_sign(n, random_mines(n, count, mut seed));
        total += order;
        check = (check * 31 + order) % 1000000007;
    }
    println(f"300 random grids: orders adding up to {total}, checksum {check}");
}
