// LeetCode #701: Insert into a Binary Search Tree -- bench program for
// the loop arm.
//
// 10 orders of the even numbers 0 to 99,998 are shuffled once; then in
// each of 5 rounds a tree is grown from each order by inserting its
// values one at a time with the loop arm, and the tree's height goes
// into a checksum.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn insert_into_bst(root: Option[TreeNode], val: i64) -> Option[TreeNode] {
    let fresh = TreeNode { val: val, left: None, right: None };
    let mut at = match root {
        None => return Some(fresh),
        Some(r) => r,
    };
    loop {
        if val < at.val {
            match at.left {
                Some(l) => at = l,
                None => {
                    at.left = Some(fresh);
                    return root;
                }
            }
        } else {
            match at.right {
                Some(r) => at = r,
                None => {
                    at.right = Some(fresh);
                    return root;
                }
            }
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn height(root: Option[TreeNode]) -> i64 {
    let mut best = 0;
    let mut stack: Vec[(TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        stack.push((r, 1));
    }
    while let Some(top) = stack.pop() {
        let (n, depth) = top;
        best = best.max(depth);
        if let Some(r) = n.right {
            stack.push((r, depth + 1));
        }
        if let Some(l) = n.left {
            stack.push((l, depth + 1));
        }
    }
    best
}

fn main() {
    let mut seed = 701;
    let n = 50000;
    let mut orders: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut values: Vec[i64] = Vec.new();
        for i in 0..n {
            values.push(2 * i);
        }
        for i in 1..n {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            let t = values[i];
            values[i] = values[j];
            values[j] = t;
        }
        orders.push(values);
    }
    let rounds = 5;
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..rounds {
        for order in orders.iter() {
            let mut root: Option[TreeNode] = None;
            for v in order.iter() {
                root = insert_into_bst(root, *v);
            }
            let h = height(root);
            total += h;
            checksum = (checksum * 31 + h) % 1000000007;
        }
    }
    println(f"{rounds} rounds of 10 trees grown to {n}: heights sum to {total}, checksum {checksum}");
}
