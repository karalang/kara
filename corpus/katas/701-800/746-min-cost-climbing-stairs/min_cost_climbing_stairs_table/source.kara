// LeetCode 746 — Min Cost Climbing Stairs, a table of each step's total.
//
// Let paid[i] be the least spent by a climb that steps on step i,
// paying its cost: paid[0] = cost[0], paid[1] = cost[1], and each later
// step adds its cost to the cheaper of the two steps it can be reached
// from. The top is reached from the last step or the one before, so the
// answer is the cheaper of those two. O(n) time and space.

fn min_cost_climbing_stairs(cost: Vec[i64]) -> i64 {
    let n = cost.len();
    let mut paid: Vec[i64] = Vec.new();
    paid.push(cost[0]);
    paid.push(cost[1]);
    for i in 2..n {
        let cheaper = if paid[i - 1] < paid[i - 2] { paid[i - 1] } else { paid[i - 2] };
        paid.push(cost[i] + cheaper);
    }
    if paid[n - 1] < paid[n - 2] { paid[n - 1] } else { paid[n - 2] }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(cost: Vec[i64]) {
    println(f"{cost} -> {min_cost_climbing_stairs(cost)}");
}

fn main() {
    show([10, 15, 20]);
    show([1, 100, 1, 1, 1, 100, 1, 1, 100, 1]);
    show([0, 0]);
    show([5, 3]);
    show([0, 0, 0, 1]);
    show([1, 0, 0, 1, 0, 0, 1]);
    show([999, 999, 999, 999, 999]);

    let mut seed = 746;
    let mut big: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        big.push(next_random(mut seed) % 1000);
    }
    println(f"1000 random steps: {min_cost_climbing_stairs(big)}");
    let mut most: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        most.push(999);
    }
    println(f"1000 steps of 999: {min_cost_climbing_stairs(most)}");

    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 2 + next_random(mut seed) % 14;
        let mut cost: Vec[i64] = Vec.new();
        for _ in 0..n {
            cost.push(next_random(mut seed) % 20);
        }
        let got = min_cost_climbing_stairs(cost);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"300 random stairs: costs sum to {total}, checksum {check}");
}
