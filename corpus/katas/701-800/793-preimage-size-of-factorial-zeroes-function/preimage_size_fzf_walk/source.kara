// LeetCode 793 — Preimage Size of Factorial Zeroes Function, a short
// walk.
//
// f(x), the zeroes at the end of x!, is x/5 + x/25 + ..., which lies
// between x/4 - log₅ x - 1 and x/4. So the least x with f(x) at least k
// is near 4k, a little above: start at the multiple of 5 at or below 4k
// and step 5 at a time until f reaches k; there are five x when it
// lands on k, and none when it steps over. O(log² k).
fn zeroes(x: i64) -> i64 {
    let mut count = 0;
    let mut p = x / 5;
    while p > 0 {
        count += p;
        p /= 5;
    }
    count
}

fn preimage_size_fzf(k: i64) -> i64 {
    let mut x = 4 * k / 5 * 5;
    while zeroes(x) < k {
        x += 5;
    }
    if zeroes(x) == k { 5 } else { 0 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(k: i64) {
    println(f"k = {k} -> {preimage_size_fzf(k)}");
}

fn main() {
    show(0);
    show(5);
    show(3);
    show(6);
    show(11);
    show(29);
    show(30);
    show(1000000000);
    let mut seed = 793;
    let mut fives = 0;
    let mut check = 0;
    for _ in 0..300 {
        // k up to a billion, made of two random numbers.
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001;
        let answer = preimage_size_fzf(k);
        if answer == 5 {
            fives += 1;
        }
        check = (check * 131 + k % 1000 + answer) % 1000000007;
    }
    println(f"300 random k: {fives} with five, checksum {check}");
}
