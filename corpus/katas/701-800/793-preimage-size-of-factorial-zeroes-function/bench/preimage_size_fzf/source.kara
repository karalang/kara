// LeetCode 793 — Preimage Size of Factorial Zeroes Function: the bench.
//
// Each of 4,000,000 rounds draws a random k up to a billion, LeetCode's
// largest, and asks the ★ arm how many x have k zeroes at the end of
// x!, by binary search for the least x with at least k.
fn zeroes(x: i64) -> i64 {
    let mut count = 0;
    let mut p = x / 5;
    while p > 0 {
        count += p;
        p /= 5;
    }
    count
}

fn preimage_size_fzf(k: i64) -> i64 {
    let mut lo = 0;
    let mut hi = 5 * k + 5;
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if zeroes(mid) < k {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if zeroes(lo) == k { 5 } else { 0 }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 793;
    let rounds = 4000000;
    let mut fives = 0;
    let mut check = 0;
    for _ in 0..rounds {
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001;
        let answer = preimage_size_fzf(k);
        if answer == 5 {
            fives += 1;
        }
        check = (check * 131 + k % 1000 + answer) % 1000000007;
    }
    println(f"{rounds} values of k: {fives} with five, checksum {check}");
}
