// LeetCode 771 — Jewels and Stones, a bitmask.
//
// There are 52 letters, so one bit each of a 64-bit mask marks the
// jewels: a to z take bits 0 to 25 and A to Z bits 26 to 51.

fn bit_of(b: u8) -> i64 {
    if b >= 97 { b as i64 - 97 } else { b as i64 - 65 + 26 }
}

fn num_jewels_in_stones(jewels: String, stones: String) -> i64 {
    let mut mask = 0;
    for b in jewels.bytes() {
        mask = mask | 1 << bit_of(b);
    }
    let mut count = 0;
    for b in stones.bytes() {
        count += mask >> bit_of(b) & 1;
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(jewels: String, stones: String) {
    let count = num_jewels_in_stones(jewels, stones);
    println(f"\"{jewels}\" \"{stones}\" -> {count}");
}

// A random string of `n` letters from the first `kinds` of aAbBcC...
fn random_letters(seed: mut ref i64, n: i64, kinds: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        let k = next_random(mut seed) % kinds;
        let base = if k % 2 == 0 { 97 } else { 65 };
        out.push((base + k / 2) as u8 as char);
    }
    out
}

fn main() {
    show("aA", "aAAbbbb");
    show("z", "ZZ");
    show("abc", "");
    show("", "abc");
    show("zZ", "zZzZzZ");
    show("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", "theQuickBrownFoxJumps");
    show("aa", "a");
    let mut seed = 771;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let kinds = 1 + next_random(mut seed) % 52;
        let jewels = random_letters(mut seed, next_random(mut seed) % 51, kinds);
        let stones = random_letters(mut seed, next_random(mut seed) % 51, kinds);
        let count = num_jewels_in_stones(jewels, stones);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"300 random pairs: {total} jewels in all, checksum {check}");
}
