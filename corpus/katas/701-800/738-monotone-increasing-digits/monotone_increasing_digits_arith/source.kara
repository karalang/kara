// LeetCode #738: Monotone Increasing Digits -- arithmetic from the
// right.
//
// No list of digits: walk the places from the units up, and wherever a
// digit is larger than the one to its right, cut the number below that
// place to zeros and subtract one, which lowers the digit and turns
// everything to its right into 9s. A lowered digit is then compared
// with the next place to its left in turn. O(d) for d digits.

fn monotone_increasing_digits(n: i64) -> i64 {
    let mut x = n;
    let mut p = 1;
    while p * 10 <= x {
        let here = (x / p) % 10;
        let left = (x / (p * 10)) % 10;
        if left > here {
            x = (x / (p * 10)) * (p * 10) - 1;
        }
        p *= 10;
    }
    x
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n} -> {monotone_increasing_digits(n)}");
}

fn main() {
    show(10);
    show(1234);
    show(332);
    show(0);
    show(9);
    show(120);
    show(100);
    show(1000000000);
    show(999999999);
    show(111111110);
    show(123454321);
    show(668841);
    show(77777);
    show(101010101);
    let mut seed: i64 = 738;
    let mut sum = 0;
    let mut kept = 0;
    for _ in 0..10000 {
        let digits = 1 + next_random(mut seed) % 10;
        let mut n = 0;
        for _ in 0..digits {
            n = n * 10 + next_random(mut seed) % 10;
        }
        if n > 1000000000 {
            n = n % 1000000001;
        }
        let m = monotone_increasing_digits(n);
        if m == n {
            kept += 1;
        }
        sum = (sum * 131 + m % 1000003 + 1) % 1000000007;
    }
    println(f"10000 random numbers: {kept} already monotone, checksum {sum}");
    let mut total = 0;
    for n in 0..100000 {
        total += monotone_increasing_digits(n);
    }
    println(f"0 to 99999: answers sum to {total}");
}
