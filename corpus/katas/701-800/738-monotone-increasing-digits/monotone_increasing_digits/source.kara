// LeetCode #738: Monotone Increasing Digits -- one drop, then nines.
//
// A number has monotone increasing digits when each digit is no larger
// than the one after it. Return the largest such number no greater
// than n. Find the first place where a digit is larger than the next;
// lower that digit by one, step back over the equal digits before it
// so that the lowered digit is the first of them, and make every digit
// after it a 9. O(d) for d digits.

fn monotone_increasing_digits(n: i64) -> i64 {
    let mut digits: Vec[i64] = Vec.new();
    let mut x = n;
    while x > 0 {
        digits.push(x % 10);
        x /= 10;
    }
    digits.reverse();
    let mut i = 0;
    while i + 1 < digits.len() and digits[i] <= digits[i + 1] {
        i += 1;
    }
    if i + 1 < digits.len() {
        while i > 0 and digits[i - 1] == digits[i] {
            i -= 1;
        }
        digits[i] -= 1;
        for j in i + 1..digits.len() {
            digits[j] = 9;
        }
    }
    let mut out = 0;
    for d in digits.iter() {
        out = out * 10 + *d;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n} -> {monotone_increasing_digits(n)}");
}

fn main() {
    show(10);
    show(1234);
    show(332);
    show(0);
    show(9);
    show(120);
    show(100);
    show(1000000000);
    show(999999999);
    show(111111110);
    show(123454321);
    show(668841);
    show(77777);
    show(101010101);
    let mut seed: i64 = 738;
    let mut sum = 0;
    let mut kept = 0;
    for _ in 0..10000 {
        let digits = 1 + next_random(mut seed) % 10;
        let mut n = 0;
        for _ in 0..digits {
            n = n * 10 + next_random(mut seed) % 10;
        }
        if n > 1000000000 {
            n = n % 1000000001;
        }
        let m = monotone_increasing_digits(n);
        if m == n {
            kept += 1;
        }
        sum = (sum * 131 + m % 1000003 + 1) % 1000000007;
    }
    println(f"10000 random numbers: {kept} already monotone, checksum {sum}");
    let mut total = 0;
    for n in 0..100000 {
        total += monotone_increasing_digits(n);
    }
    println(f"0 to 99999: answers sum to {total}");
}
