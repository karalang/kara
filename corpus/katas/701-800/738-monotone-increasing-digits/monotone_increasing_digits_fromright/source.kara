// LeetCode #738: Monotone Increasing Digits -- from the right, on the
// decimal text.
//
// Work on the digits of n as text. Walk from the right: wherever a
// digit is larger than the one after it, lower it by one and remember
// that every digit from the next place on must become a 9. Lowering a
// digit can make it smaller than the one before it, which the walk
// meets next. Then fill the 9s from the leftmost remembered place.
// O(d) for d digits.

fn monotone_increasing_digits(n: i64) -> i64 {
    let mut digits: Vec[u8] = Vec.new();
    for b in n.to_string().bytes() {
        digits.push(b);
    }
    let mut nines = digits.len();
    let mut i = digits.len();
    while i > 1 {
        i -= 1;
        if digits[i - 1] > digits[i] {
            digits[i - 1] -= 1;
            nines = i;
        }
    }
    for j in nines..digits.len() {
        digits[j] = b'9';
    }
    let mut out = 0;
    for b in digits.iter() {
        out = out * 10 + (*b - b'0') as i64;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n} -> {monotone_increasing_digits(n)}");
}

fn main() {
    show(10);
    show(1234);
    show(332);
    show(0);
    show(9);
    show(120);
    show(100);
    show(1000000000);
    show(999999999);
    show(111111110);
    show(123454321);
    show(668841);
    show(77777);
    show(101010101);
    let mut seed: i64 = 738;
    let mut sum = 0;
    let mut kept = 0;
    for _ in 0..10000 {
        let digits = 1 + next_random(mut seed) % 10;
        let mut n = 0;
        for _ in 0..digits {
            n = n * 10 + next_random(mut seed) % 10;
        }
        if n > 1000000000 {
            n = n % 1000000001;
        }
        let m = monotone_increasing_digits(n);
        if m == n {
            kept += 1;
        }
        sum = (sum * 131 + m % 1000003 + 1) % 1000000007;
    }
    println(f"10000 random numbers: {kept} already monotone, checksum {sum}");
    let mut total = 0;
    for n in 0..100000 {
        total += monotone_increasing_digits(n);
    }
    println(f"0 to 99999: answers sum to {total}");
}
