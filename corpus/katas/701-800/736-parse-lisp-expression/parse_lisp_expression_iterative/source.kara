// LeetCode #736: Parse Lisp Expression -- no recursion, a stack of forms.
//
// Read the tokens left to right with an explicit stack of the forms
// that are open. An opening parenthesis pushes a form; a number or a
// variable is a value; a closing parenthesis pops a form and computes
// its value. Every value goes to the form on top of the stack: an
// operand of an add or a mult, the value of a let's pending name, or a
// let's last expression. In a let, a name followed by anything but the
// closing parenthesis is a name to assign. The assignments in force are
// one list, cut back when a let closes. O(n) tokens.

struct Form {
    op: String,
    args: Vec[i64],
    pending: String,
    start: i64,
}

fn split_tokens(expression: String) -> Vec[String] {
    let mut tokens: Vec[String] = Vec.new();
    let mut word = String.new();
    for c in expression.chars() {
        if c == '(' or c == ')' or c == ' ' {
            if word.len() > 0 {
                tokens.push(word);
                word = String.new();
            }
            if c != ' ' {
                tokens.push(c.to_string());
            }
        } else {
            word.push(c);
        }
    }
    if word.len() > 0 {
        tokens.push(word);
    }
    tokens
}

fn evaluate(expression: String) -> i64 {
    let tokens = split_tokens(expression);
    let mut env: Vec[(String, i64)] = Vec.new();
    let mut stack: Vec[Form] = Vec.new();
    let mut i = 0;
    let mut answer = 0;
    while i < tokens.len() {
        let t = tokens[i].clone();
        i += 1;
        if t == "(" {
            stack.push(Form { op: tokens[i].clone(), args: Vec.new(), pending: String.new(), start: env.len() });
            i += 1;
            continue;
        }
        let top = stack.len() - 1;
        if top >= 0 and stack[top].op == "let" and stack[top].pending.len() == 0 and t != ")" and tokens[i] != ")" {
            stack[top].pending = t;
            continue;
        }
        let mut value = 0;
        if t == ")" {
            let form = stack.pop().unwrap();
            if form.op == "add" {
                value = form.args[0] + form.args[1];
            } else if form.op == "mult" {
                value = form.args[0] * form.args[1];
            } else {
                value = form.args[0];
                env.truncate(form.start);
            }
        } else {
            let first = t.bytes()[0];
            if first == b'-' or (first >= b'0' and first <= b'9') {
                value = i64.parse(t).unwrap();
            } else {
                let mut k = env.len();
                while k > 0 {
                    k -= 1;
                    if env[k].0 == t {
                        value = env[k].1;
                        break;
                    }
                }
            }
        }
        if stack.len() == 0 {
            answer = value;
        } else {
            let top = stack.len() - 1;
            if stack[top].pending.len() > 0 {
                let name = stack[top].pending.clone();
                env.push((name, value));
                stack[top].pending = String.new();
            } else {
                stack[top].args.push(value);
            }
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random expression of at most `depth` levels of forms, using only
// the variables in `names`, which are those assigned around it.
fn random_expr(seed: mut ref i64, depth: i64, names: Vec[String]) -> String {
    let kinds = if depth == 0 { 2 } else { 5 };
    let kind = next_random(mut seed) % kinds;
    if kind == 0 or (kind == 1 and names.len() == 0) {
        return f"{next_random(mut seed) % 21 - 10}";
    }
    if kind == 1 {
        return names[next_random(mut seed) % names.len()].clone();
    }
    if kind == 2 or kind == 3 {
        let a = random_expr(mut seed, depth - 1, names);
        let b = random_expr(mut seed, depth - 1, names);
        let op = if kind == 2 { "add" } else { "mult" };
        return f"({op} {a} {b})";
    }
    let pool = ["x", "y", "z", "a1", "b2"];
    let mut inner = names.clone();
    let mut text = "(let".to_string();
    let count = 1 + next_random(mut seed) % 3;
    for _ in 0..count {
        let name = pool[next_random(mut seed) % 5].to_string();
        let v = random_expr(mut seed, depth - 1, inner);
        text = f"{text} {name} {v}";
        if not inner.contains(name) {
            inner.push(name);
        }
    }
    let body = random_expr(mut seed, depth - 1, inner);
    f"{text} {body})"
}

fn show(e: String) {
    println(f"{e} -> {evaluate(e.clone())}");
}

fn main() {
    show("(let x 2 (mult x (let x 3 y 4 (add x y))))".to_string());
    show("(let x 3 x 2 x)".to_string());
    show("(let x 1 y 2 x (add x y) (add x y))".to_string());
    show("(add 1 2)".to_string());
    show("(mult 3 (add 2 3))".to_string());
    show("(let a1 3 b2 (add a1 1) b2)".to_string());
    show("(let x 2 (add (let x 3 (let x 4 x)) x))".to_string());
    show("(let x -2 y x y)".to_string());
    show("(mult -3 (add 4 -6))".to_string());
    show("-7".to_string());
    // 80 lets, each inside the last, each variable one more than the
    // one before.
    let mut deep = "(let v0 1".to_string();
    for i in 1..80 {
        deep = f"{deep} (let v{i} (add v{i - 1} 1)";
    }
    deep = f"{deep} v79";
    for _ in 0..80 {
        deep = f"{deep})";
    }
    println(f"80 nested lets, {deep.len()} characters -> {evaluate(deep)}");
    let mut chain = "150".to_string();
    let mut k = 149;
    while k > 0 {
        chain = f"(add {k} {chain})";
        k -= 1;
    }
    println(f"adds of 1 to 150, {chain.len()} characters -> {evaluate(chain)}");
    let mut doubling = "(let x 1".to_string();
    for _ in 0..30 {
        doubling = f"{doubling} (let x (add x x)";
    }
    doubling = f"{doubling} x";
    for _ in 0..31 {
        doubling = f"{doubling})";
    }
    println(f"x doubled in 30 lets that each hide the last, {doubling.len()} characters -> {evaluate(doubling)}");
    let mut seed: i64 = 736;
    let mut sum = 0;
    let mut chars = 0;
    for _ in 0..300 {
        let e = random_expr(mut seed, 1 + next_random(mut seed) % 3, Vec.new());
        chars += e.len();
        let v = evaluate(e);
        sum = (sum * 131 + (v % 1000000007 + 1000000007) % 1000000007) % 1000000007;
    }
    println(f"300 random expressions, {chars} characters: checksum {sum}");
}
