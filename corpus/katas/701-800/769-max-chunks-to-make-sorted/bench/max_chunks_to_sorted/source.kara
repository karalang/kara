// LeetCode 769 — Max Chunks To Make Sorted: benchmark, the ★ arm.
//
// LeetCode stops at 10 values, too few to time, so this uses sixty-four
// permutations of 2,000, built once: each is sorted and then given a
// random number of swaps of near places, so that chunks form. 150,000
// rounds each count the next one's chunks.

fn max_chunks_to_sorted(arr: Vec[i64]) -> i64 {
    let mut chunks = 0;
    let mut largest = 0;
    for i in 0..arr.len() {
        largest = largest.max(arr[i]);
        if largest == i {
            chunks += 1;
        }
    }
    chunks
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 150000;
    let n = 2000;
    let mut seed = 769;
    let mut pool: Vec[Vec[i64]] = Vec.new();
    for _ in 0..64 {
        let mut arr: Vec[i64] = Vec.new();
        for i in 0..n {
            arr.push(i);
        }
        let swaps = next_random(mut seed) % n;
        for _ in 0..swaps {
            let i = next_random(mut seed) % n;
            let j = (i + 1 + next_random(mut seed) % 4).min(n - 1);
            arr.swap(i, j);
        }
        pool.push(arr);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..rounds {
        let chunks = max_chunks_to_sorted(pool[round % 64]);
        total += chunks;
        check = (check * 31 + chunks) % 1000000007;
    }
    println(f"{rounds} permutations of 2000: {total} chunks in all, checksum {check}");
}
