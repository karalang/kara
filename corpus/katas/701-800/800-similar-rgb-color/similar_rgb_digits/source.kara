// LeetCode 800 — Similar RGB Color, from the first digit.
//
// A part written with hex digits d and e is 16d + e, and the doubled
// digit dd is 17d, so the part is above dd when e > d, below it when
// e < d, and on it when they are equal. The nearest doubled digit is
// therefore dd, or the one next to it on the side of e, whichever is
// closer: d - 1, d or d + 1. O(1).
fn similar_rgb(color: Str) -> String {
    let digits = "0123456789abcdef";
    let b = color.bytes();
    let mut out = String.new();
    out.push('#');
    for p in 0..3 {
        let d = digit_value(b[1 + 2 * p]);
        let e = digit_value(b[2 + 2 * p]);
        let part = 16 * d + e;
        let mut k = d;
        if e > d and 17 * (d + 1) - part < part - 17 * d {
            k = d + 1;
        } else if e < d and part - 17 * (d - 1) < 17 * d - part {
            k = d - 1;
        }
        let c = digits.bytes()[k] as char;
        out.push(c);
        out.push(c);
    }
    out
}

fn digit_value(c: u8) -> i64 {
    if c >= 97 { c as i64 - 87 } else { c as i64 - 48 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(color: Str) {
    println(f"{color} -> {similar_rgb(color)}");
}

fn main() {
    show("#09f166");
    show("#4e3fe1");
    show("#000000");
    show("#ffffff");
    show("#080808");
    show("#090909");
    show("#f7f7f7");
    show("#123456");
    show("#abcdef");
    let digits = "0123456789abcdef";
    let mut seed = 800;
    let mut same = 0;
    let mut check = 0;
    for i in 0..300 {
        // Any colour, or every other time one with each part's two
        // digits alike, which is its own answer.
        let mut color = String.new();
        color.push('#');
        for _ in 0..3 {
            let d = digits.bytes()[next_random(mut seed) % 16] as char;
            color.push(d);
            if i % 2 == 0 {
                color.push(digits.bytes()[next_random(mut seed) % 16] as char);
            } else {
                color.push(d);
            }
        }
        let got = similar_rgb(color);
        if got == color {
            same += 1;
        }
        for c in got.bytes() {
            check = (check * 131 + c as i64) % 1000000007;
        }
    }
    println(f"300 random colours: {same} already shorthand, checksum {check}");
}
