// LeetCode #732: My Calendar III -- starts and ends, merged.
//
// Keep every start and every end in two sorted lists, each new one put
// in its place by binary search. Walk both lists together as a sweep:
// a start adds a booking and an end takes one away, with ends first
// where the two meet, since a booking is over at its end. The most
// bookings seen at once is the answer. O(n) per booking.

struct MyCalendarThree {
    starts: Vec[i64],
    ends: Vec[i64],
}

fn place(v: mut ref Vec[i64], x: i64) {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v[mid] <= x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    v.insert(lo, x);
}

impl MyCalendarThree {
    fn new() -> MyCalendarThree {
        MyCalendarThree { starts: Vec.new(), ends: Vec.new() }
    }

    fn book(mut ref self, start: i64, end: i64) -> i64 {
        place(mut self.starts, start);
        place(mut self.ends, end);
        let n = self.starts.len();
        let mut i = 0;
        let mut j = 0;
        let mut now = 0;
        let mut most = 0;
        while i < n {
            if self.ends[j] <= self.starts[i] {
                now -= 1;
                j += 1;
            } else {
                now += 1;
                i += 1;
                if now > most {
                    most = now;
                }
            }
        }
        most
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 lists of 1,000 random bookings of up to 10^6, ending before
    // 10^9 even when moved by the round number, made once.
    let mut seed: i64 = 732;
    let mut lists: Vec[Vec[(i64, i64)]] = Vec.new();
    for _ in 0..20 {
        let mut bookings: Vec[(i64, i64)] = Vec.new();
        for _ in 0..1000 {
            let s = (next_random(mut seed) * 32768 + next_random(mut seed)) % 998999000;
            let len = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000;
            bookings.push((s, s + len));
        }
        lists.push(bookings);
    }
    // 40 rounds: every list is booked into a fresh calendar, moved
    // later by the round number, and every answer summed.
    let mut sum = 0;
    for round in 0..40 {
        for d in 0..20 {
            let mut cal = MyCalendarThree.new();
            for b in lists[d].iter() {
                sum += cal.book(b.0 + round, b.1 + round);
            }
        }
    }
    println(f"40 rounds of 20 lists of 1000 bookings: answers sum {sum}");
}
