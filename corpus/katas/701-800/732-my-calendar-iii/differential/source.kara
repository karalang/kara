// LeetCode #732: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random runs of
// bookings.

// ---- ★ arm ----------------------------------------------------------

struct MyCalendarThreeStar {
    starts: Vec[i64],
    ends: Vec[i64],
}

fn place(v: mut ref Vec[i64], x: i64) {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v[mid] <= x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    v.insert(lo, x);
}

impl MyCalendarThreeStar {
    fn new() -> MyCalendarThreeStar {
        MyCalendarThreeStar { starts: Vec.new(), ends: Vec.new() }
    }

    fn book(mut ref self, start: i64, end: i64) -> i64 {
        place(mut self.starts, start);
        place(mut self.ends, end);
        let n = self.starts.len();
        let mut i = 0;
        let mut j = 0;
        let mut now = 0;
        let mut most = 0;
        while i < n {
            if self.ends[j] <= self.starts[i] {
                now -= 1;
                j += 1;
            } else {
                now += 1;
                i += 1;
                if now > most {
                    most = now;
                }
            }
        }
        most
    }
}

// ---- sweep arm ------------------------------------------------------

struct MyCalendarThreeSweep {
    delta: SortedMap[i64, i64],
}

impl MyCalendarThreeSweep {
    fn new() -> MyCalendarThreeSweep {
        MyCalendarThreeSweep { delta: SortedMap.new() }
    }

    fn change(mut ref self, at: i64, by: i64) {
        let old = match self.delta.get(at) {
            Some(v) => *v,
            None => 0,
        };
        self.delta.insert(at, old + by);
    }

    fn book(mut ref self, start: i64, end: i64) -> i64 {
        self.change(start, 1);
        self.change(end, -1);
        let mut covered = 0;
        let mut most = 0;
        for d in self.delta.values() {
            covered += *d;
            if covered > most {
                most = covered;
            }
        }
        most
    }
}

// ---- segtree arm ----------------------------------------------------

shared struct Node {
    mut added: i64,
    mut most: i64,
    mut left: Option[Node],
    mut right: Option[Node],
}

fn fresh() -> Node {
    Node { added: 0, most: 0, left: None, right: None }
}

fn most_of(child: Option[Node]) -> i64 {
    match child {
        Some(c) => c.most,
        None => 0,
    }
}

fn add(node: Node, lo: i64, hi: i64, start: i64, end: i64) {
    if start <= lo and hi <= end {
        node.added += 1;
        node.most += 1;
        return;
    }
    let mid = lo + (hi - lo) / 2;
    if start < mid {
        if node.left.is_none() {
            node.left = Some(fresh());
        }
        if let Some(l) = node.left {
            add(l, lo, mid, start, end);
        }
    }
    if mid < end {
        if node.right.is_none() {
            node.right = Some(fresh());
        }
        if let Some(r) = node.right {
            add(r, mid, hi, start, end);
        }
    }
    let l = most_of(node.left);
    let r = most_of(node.right);
    node.most = node.added + if l > r { l } else { r };
}

struct MyCalendarThreeSegtree {
    root: Node,
}

impl MyCalendarThreeSegtree {
    fn new() -> MyCalendarThreeSegtree {
        MyCalendarThreeSegtree { root: fresh() }
    }

    fn book(mut ref self, start: i64, end: i64) -> i64 {
        add(self.root, 0, 1000000000, start, end);
        self.root.most
    }
}

// ---- pieces arm -----------------------------------------------------

struct MyCalendarThreePieces {
    pieces: Vec[(i64, i64, i64)],
    deepest: i64,
}

impl MyCalendarThreePieces {
    fn new() -> MyCalendarThreePieces {
        MyCalendarThreePieces { pieces: Vec.new(), deepest: 0 }
    }

    fn book(mut ref self, start: i64, end: i64) -> i64 {
        let mut next: Vec[(i64, i64, i64)] = Vec.new();
        let mut at = start;
        let mut deepest = 1;
        for p in self.pieces.iter() {
            if p.1 <= start {
                next.push(*p);
            } else if p.0 >= end {
                if at < end {
                    next.push((at, end, 1));
                    at = end;
                }
                next.push(*p);
            } else {
                if p.0 < start {
                    next.push((p.0, start, p.2));
                }
                if p.0 > at {
                    next.push((at, p.0, 1));
                }
                let lo = if p.0 > start { p.0 } else { start };
                let hi = if p.1 < end { p.1 } else { end };
                next.push((lo, hi, p.2 + 1));
                if p.2 + 1 > deepest {
                    deepest = p.2 + 1;
                }
                at = hi;
                if p.1 > end {
                    next.push((end, p.1, p.2));
                }
            }
        }
        if at < end {
            next.push((at, end, 1));
        }
        self.pieces = next;
        if deepest > self.deepest {
            self.deepest = deepest;
        }
        self.deepest
    }
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn run(which: i64, bookings: Vec[(i64, i64)]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if which == 0 {
        let mut cal = MyCalendarThreeStar.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    } else if which == 1 {
        let mut cal = MyCalendarThreeSweep.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    } else if which == 2 {
        let mut cal = MyCalendarThreeSegtree.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    } else {
        let mut cal = MyCalendarThreePieces.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    }
    out
}

// The definition: how many bookings hold each minute, 0 to 1199; each
// booking holds its minutes once more, and the answer is the most any
// minute is held.
fn definition(bookings: Vec[(i64, i64)]) -> Vec[i64] {
    let mut held: Vec[i64] = vec![0; 1200];
    let mut out: Vec[i64] = Vec.new();
    let mut most = 0;
    for b in bookings.iter() {
        for x in b.0..b.1 {
            held[x] += 1;
            if held[x] > most {
                most = held[x];
            }
        }
        out.push(most);
    }
    out
}

// How many of the first `upto` bookings hold minute `x`.
fn holding(bookings: Vec[(i64, i64)], upto: i64, x: i64) -> i64 {
    let mut n = 0;
    for k in 0..upto {
        if bookings[k].0 <= x and x < bookings[k].1 {
            n += 1;
        }
    }
    n
}

fn main() {
    let mut seed = 7320;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut deepest = 0;
    let cases = 3000;
    for _ in 0..cases {
        // 1 to 20 bookings of 1 to 15 minutes starting in 0 to 79, so
        // most answers are from 1 to 5.
        let n = 1 + next_random(mut seed) % 20;
        let mut bookings: Vec[(i64, i64)] = Vec.new();
        for _ in 0..n {
            let s = next_random(mut seed) % 80;
            bookings.push((s, s + 1 + next_random(mut seed) % 15));
        }
        let want = definition(bookings.clone());
        deepest += want[n - 1];
        let mut shifted: Vec[(i64, i64)] = Vec.new();
        for b in bookings.iter() {
            shifted.push((b.0 + 1000, b.1 + 1000));
        }
        for which in 0..arms {
            let got = run(which, bookings.clone());
            // P1: the definition's answers.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: after each booking, the most bookings so far that
            // hold the start of one of them.
            checks += 1;
            let mut ok = got.len() == n;
            if ok {
                for i in 0..n {
                    let mut most = 0;
                    for j in 0..i + 1 {
                        let h = holding(bookings, i + 1, bookings[j].0);
                        if h > most {
                            most = h;
                        }
                    }
                    if got[i] != most {
                        ok = false;
                    }
                }
            }
            if not ok {
                fails[1] += 1;
            }
            // P3: every booking 1000 minutes later, the same answers.
            checks += 1;
            if run(which, shifted.clone()) != got {
                fails[2] += 1;
            }
            // P4: the bookings in reverse, the same last answer.
            checks += 1;
            let mut back: Vec[(i64, i64)] = Vec.new();
            let mut i = n;
            while i > 0 {
                i -= 1;
                back.push(bookings[i]);
            }
            let again = run(which, back);
            if got.len() != n or again[n - 1] != got[n - 1] {
                fails[3] += 1;
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{cases} runs (last answers summing to {deepest}), {arms} arms, {checks} checks, {total} failures");
}
