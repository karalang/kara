// LeetCode 775 — Global and Local Inversions, counting with a Fenwick
// tree.
//
// Count both kinds and compare. Local inversions are one pass. For the
// global ones, walk left to right with a Fenwick tree over the values
// seen so far: the values seen that are greater than nums[i] are the
// inversions ending at i. O(n log n).

struct Fenwick {
    tree: Vec[i64],
}

impl Fenwick {
    fn new(n: i64) -> Fenwick {
        Fenwick { tree: Vec.filled(n + 1, 0) }
    }

    // One more of value v.
    fn add(mut ref self, v: i64) {
        let mut i = v + 1;
        while i < self.tree.len() {
            self.tree[i] += 1;
            i += i & -i;
        }
    }

    // How many values seen are below v.
    fn below(self, v: i64) -> i64 {
        let mut total = 0;
        let mut i = v;
        while i > 0 {
            total += self.tree[i];
            i -= i & -i;
        }
        total
    }
}

fn is_ideal_permutation(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut local = 0;
    for i in 1..n {
        if nums[i - 1] > nums[i] {
            local += 1;
        }
    }
    let mut seen = Fenwick.new(n);
    let mut global = 0;
    for i in 0..n {
        global += i - seen.below(nums[i]);
        seen.add(nums[i]);
    }
    global == local
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The values 0..n in order, then each adjacent pair swapped with chance
// one in two, never two overlapping: an ideal permutation.
fn ideal(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for v in 0..n {
        nums.push(v);
    }
    let mut i = 0;
    while i + 1 < n {
        if next_random(mut seed) % 2 == 0 {
            nums.swap(i, i + 1);
            i += 2;
        } else {
            i += 1;
        }
    }
    nums
}

// A permutation of 0..n uniformly at random (Fisher-Yates).
fn shuffled(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for v in 0..n {
        nums.push(v);
    }
    let mut i = n - 1;
    while i > 0 {
        nums.swap(i, next_random(mut seed) % (i + 1));
        i -= 1;
    }
    nums
}

fn show(nums: Vec[i64]) {
    let answer = is_ideal_permutation(nums);
    println(f"{nums} -> {answer}");
}

fn main() {
    show([1, 0, 2]);
    show([1, 2, 0]);
    show([0]);
    show([1, 0]);
    show([0, 2, 1, 3]);
    show([2, 0, 1]);
    show([0, 1, 3, 2, 5, 4]);
    show([1, 0, 3, 2, 4, 6, 5, 7, 9, 8]);
    show([0, 1, 2, 4, 5, 3]);
    let mut seed = 775;
    // The largest LeetCode allows: an ideal permutation of 100,000, then
    // the same with its last two pairs crossed.
    let mut big = ideal(mut seed, 100000);
    let answer = is_ideal_permutation(big);
    println(f"100000 values, ideal -> {answer}");
    big.swap(99996, 99999);
    let answer = is_ideal_permutation(big);
    println(f"100000 values, a far swap at the end -> {answer}");
    let mut ideals = 0;
    let mut check = 0;
    for case in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let mut nums = if case % 3 == 0 { shuffled(mut seed, n) } else { ideal(mut seed, n) };
        if case % 3 == 2 {
            // One more swap, of two values up to three places apart.
            let i = next_random(mut seed) % n;
            let j = (i + 1 + next_random(mut seed) % 3).min(n - 1);
            nums.swap(i, j);
        }
        let answer = is_ideal_permutation(nums);
        if answer {
            ideals += 1;
        }
        check = (check * 31 + if answer { n } else { 1000 - n }) % 1000000007;
    }
    println(f"300 random permutations: {ideals} ideal, checksum {check}");
}
