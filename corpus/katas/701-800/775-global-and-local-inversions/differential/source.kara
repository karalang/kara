// LeetCode #775: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random permutations.

// ---- ★ arm ----------------------------------------------------------

fn is_ideal_permutation_star(nums: Vec[i64]) -> bool {
    for i in 0..nums.len() {
        if (nums[i] - i).abs() > 1 {
            return false;
        }
    }
    true
}

// ---- suffix arm -----------------------------------------------------

fn is_ideal_permutation_suffix(nums: Vec[i64]) -> bool {
    let n = nums.len();
    if n < 3 {
        return true;
    }
    let mut least = nums[n - 1];
    let mut i = n - 3;
    while i >= 0 {
        if nums[i] > least {
            return false;
        }
        least = least.min(nums[i + 1]);
        i -= 1;
    }
    true
}

// ---- fenwick arm ----------------------------------------------------

struct Fenwick_fenwick {
    tree: Vec[i64],
}

impl Fenwick_fenwick {
    fn new(n: i64) -> Fenwick_fenwick {
        Fenwick_fenwick { tree: Vec.filled(n + 1, 0) }
    }

    // One more of value v.
    fn add(mut ref self, v: i64) {
        let mut i = v + 1;
        while i < self.tree.len() {
            self.tree[i] += 1;
            i += i & -i;
        }
    }

    // How many values seen are below v.
    fn below(self, v: i64) -> i64 {
        let mut total = 0;
        let mut i = v;
        while i > 0 {
            total += self.tree[i];
            i -= i & -i;
        }
        total
    }
}

fn is_ideal_permutation_fenwick(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut local = 0;
    for i in 1..n {
        if nums[i - 1] > nums[i] {
            local += 1;
        }
    }
    let mut seen = Fenwick_fenwick.new(n);
    let mut global = 0;
    for i in 0..n {
        global += i - seen.below(nums[i]);
        seen.add(nums[i]);
    }
    global == local
}

// ---- merge arm ------------------------------------------------------

// Sorts values[lo..hi] through scratch and returns its inversions.
fn sort_count_merge(values: mut ref Vec[i64], scratch: mut ref Vec[i64], lo: i64, hi: i64) -> i64 {
    if hi - lo < 2 {
        return 0;
    }
    let mid = (lo + hi) / 2;
    let mut count = sort_count_merge(mut values, mut scratch, lo, mid) + sort_count_merge(mut values, mut scratch, mid, hi);
    let mut i = lo;
    let mut j = mid;
    let mut k = lo;
    while i < mid or j < hi {
        if j == hi or (i < mid and values[i] <= values[j]) {
            scratch[k] = values[i];
            i += 1;
        } else {
            scratch[k] = values[j];
            count += mid - i;
            j += 1;
        }
        k += 1;
    }
    for t in lo..hi {
        values[t] = scratch[t];
    }
    count
}

fn is_ideal_permutation_merge(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut local = 0;
    for i in 1..n {
        if nums[i - 1] > nums[i] {
            local += 1;
        }
    }
    let mut values = nums.clone();
    let mut scratch = Vec.filled(n, 0);
    sort_count_merge(mut values, mut scratch, 0, n) == local
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, nums: Vec[i64]) -> bool {
    if which == 0 {
        is_ideal_permutation_star(nums)
    } else if which == 1 {
        is_ideal_permutation_suffix(nums)
    } else if which == 2 {
        is_ideal_permutation_fenwick(nums)
    } else {
        is_ideal_permutation_merge(nums)
    }
}

// The definition: count every pair i < j with nums[i] > nums[j], count
// every i with nums[i] > nums[i + 1], and compare.
fn definition(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut global = 0;
    for i in 0..n {
        for j in i + 1..n {
            if nums[i] > nums[j] {
                global += 1;
            }
        }
    }
    let mut local = 0;
    for i in 1..n {
        if nums[i - 1] > nums[i] {
            local += 1;
        }
    }
    global == local
}

// A permutation of 0..n of one of three kinds: uniformly at random; ideal,
// adjacent pairs swapped at random without overlapping; or ideal and then
// two values up to three places apart swapped.
fn permutation(seed: mut ref i64, n: i64, kind: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for v in 0..n {
        nums.push(v);
    }
    if kind == 0 {
        let mut i = n - 1;
        while i > 0 {
            nums.swap(i, next_random(mut seed) % (i + 1));
            i -= 1;
        }
        return nums;
    }
    let mut i = 0;
    while i + 1 < n {
        if next_random(mut seed) % 2 == 0 {
            nums.swap(i, i + 1);
            i += 2;
        } else {
            i += 1;
        }
    }
    if kind == 2 {
        let a = next_random(mut seed) % n;
        let b = (a + 1 + next_random(mut seed) % 3).min(n - 1);
        nums.swap(a, b);
    }
    nums
}

fn main() {
    let arms = 4;
    let mut seed = 7750;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1600;
    let mut ideals = 0;
    for case in 0..cases {
        // 1,500 small permutations, then 100 of up to 400 values.
        let n = if case < 1500 { 1 + next_random(mut seed) % 60 } else { 61 + next_random(mut seed) % 340 };
        let nums = permutation(mut seed, n, case % 3);
        let m = 1 + next_random(mut seed) % 30;
        let other = permutation(mut seed, m, next_random(mut seed) % 3);
        let mut inverse = Vec.filled(n, 0);
        let mut turned: Vec[i64] = Vec.new();
        for i in 0..n {
            inverse[nums[i]] = i;
            turned.push(n - 1 - nums[n - 1 - i]);
        }
        let mut joined = nums.clone();
        for v in other.iter() {
            joined.push(n + v);
        }
        let want = definition(nums);
        if want {
            ideals += 1;
        }
        for which in 0..arms {
            let got = answer_with(which, nums);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the inverse permutation gives the same answer.
            checks += 1;
            if answer_with(which, inverse) != got {
                fails[1] += 1;
            }
            // P3: turned end for end, each value v becoming n - 1 - v,
            // gives the same answer.
            checks += 1;
            if answer_with(which, turned) != got {
                fails[2] += 1;
            }
            // P4: another permutation joined on above it is ideal exactly
            // when both are.
            checks += 1;
            if answer_with(which, joined) != (got and answer_with(which, other)) {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} permutations ({ideals} ideal), {arms} arms, {checks} checks, {failures} failures");
}
