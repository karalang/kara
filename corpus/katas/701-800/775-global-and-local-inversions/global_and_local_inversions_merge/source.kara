// LeetCode 775 — Global and Local Inversions, counting by merge sort.
//
// Count both kinds and compare. Local inversions are one pass. For the
// global ones, sort a copy by merging: when the right half's head is
// taken first, it is inverted with every value left in the left half.
// O(n log n).

// Sorts values[lo..hi] through scratch and returns its inversions.
fn sort_count(values: mut ref Vec[i64], scratch: mut ref Vec[i64], lo: i64, hi: i64) -> i64 {
    if hi - lo < 2 {
        return 0;
    }
    let mid = (lo + hi) / 2;
    let mut count = sort_count(mut values, mut scratch, lo, mid) + sort_count(mut values, mut scratch, mid, hi);
    let mut i = lo;
    let mut j = mid;
    let mut k = lo;
    while i < mid or j < hi {
        if j == hi or (i < mid and values[i] <= values[j]) {
            scratch[k] = values[i];
            i += 1;
        } else {
            scratch[k] = values[j];
            count += mid - i;
            j += 1;
        }
        k += 1;
    }
    for t in lo..hi {
        values[t] = scratch[t];
    }
    count
}

fn is_ideal_permutation(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut local = 0;
    for i in 1..n {
        if nums[i - 1] > nums[i] {
            local += 1;
        }
    }
    let mut values = nums.clone();
    let mut scratch = Vec.filled(n, 0);
    sort_count(mut values, mut scratch, 0, n) == local
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The values 0..n in order, then each adjacent pair swapped with chance
// one in two, never two overlapping: an ideal permutation.
fn ideal(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for v in 0..n {
        nums.push(v);
    }
    let mut i = 0;
    while i + 1 < n {
        if next_random(mut seed) % 2 == 0 {
            nums.swap(i, i + 1);
            i += 2;
        } else {
            i += 1;
        }
    }
    nums
}

// A permutation of 0..n uniformly at random (Fisher-Yates).
fn shuffled(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for v in 0..n {
        nums.push(v);
    }
    let mut i = n - 1;
    while i > 0 {
        nums.swap(i, next_random(mut seed) % (i + 1));
        i -= 1;
    }
    nums
}

fn show(nums: Vec[i64]) {
    let answer = is_ideal_permutation(nums);
    println(f"{nums} -> {answer}");
}

fn main() {
    show([1, 0, 2]);
    show([1, 2, 0]);
    show([0]);
    show([1, 0]);
    show([0, 2, 1, 3]);
    show([2, 0, 1]);
    show([0, 1, 3, 2, 5, 4]);
    show([1, 0, 3, 2, 4, 6, 5, 7, 9, 8]);
    show([0, 1, 2, 4, 5, 3]);
    let mut seed = 775;
    // The largest LeetCode allows: an ideal permutation of 100,000, then
    // the same with its last two pairs crossed.
    let mut big = ideal(mut seed, 100000);
    let answer = is_ideal_permutation(big);
    println(f"100000 values, ideal -> {answer}");
    big.swap(99996, 99999);
    let answer = is_ideal_permutation(big);
    println(f"100000 values, a far swap at the end -> {answer}");
    let mut ideals = 0;
    let mut check = 0;
    for case in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let mut nums = if case % 3 == 0 { shuffled(mut seed, n) } else { ideal(mut seed, n) };
        if case % 3 == 2 {
            // One more swap, of two values up to three places apart.
            let i = next_random(mut seed) % n;
            let j = (i + 1 + next_random(mut seed) % 3).min(n - 1);
            nums.swap(i, j);
        }
        let answer = is_ideal_permutation(nums);
        if answer {
            ideals += 1;
        }
        check = (check * 31 + if answer { n } else { 1000 - n }) % 1000000007;
    }
    println(f"300 random permutations: {ideals} ideal, checksum {check}");
}
