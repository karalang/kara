// LeetCode 748 — Shortest Completing Word, bench: the ★ arm (letter
// counts) on a list of 1000 words that keeps changing, against a new
// plate each round.

fn shortest_completing_word(license_plate: String, words: Vec[String]) -> String {
    let mut need: Vec[i64] = Vec.new();
    for _ in 0..26 {
        need.push(0);
    }
    for b in license_plate.bytes().iter() {
        let c = *b;
        if c >= b'a' and c <= b'z' {
            need[(c - b'a') as i64] += 1;
        } else if c >= b'A' and c <= b'Z' {
            need[(c - b'A') as i64] += 1;
        }
    }
    let mut best = -1;
    for i in 0..words.len() {
        if best != -1 and words[i].len() >= words[best].len() {
            continue;
        }
        let mut have: Vec[i64] = Vec.new();
        for _ in 0..26 {
            have.push(0);
        }
        for b in words[i].bytes().iter() {
            have[(*b - b'a') as i64] += 1;
        }
        let mut complete = true;
        for c in 0..26 {
            if have[c] < need[c] {
                complete = false;
            }
        }
        if complete {
            best = i;
        }
    }
    words[best].clone()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64) -> String {
    let mut s = String.new();
    let n = 1 + next_random(mut seed) % 15;
    for _ in 0..n {
        s.push((97 + next_random(mut seed) % 6) as u8 as char);
    }
    s
}

fn random_plate(seed: mut ref i64) -> String {
    let mut s = String.new();
    let n = 1 + next_random(mut seed) % 7;
    for _ in 0..n {
        let kind = next_random(mut seed) % 6;
        let code = if kind < 2 {
            97 + next_random(mut seed) % 6
        } else if kind < 4 {
            65 + next_random(mut seed) % 6
        } else if kind == 4 {
            48 + next_random(mut seed) % 10
        } else {
            32
        };
        s.push(code as u8 as char);
    }
    s
}

fn main() {
    let rounds = 100000;
    let n = 1000;
    let mut seed = 748;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..n {
        words.push(random_word(mut seed));
    }
    let mut letters = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for _ in 0..5 {
            let i = next_random(mut seed) % (n - 1);
            words[i] = random_word(mut seed);
        }
        let plate = random_plate(mut seed);
        // the plate's own letters, lower-cased, as the last word, so
        // that some word completes the plate
        let mut last = String.new();
        for b in plate.bytes().iter() {
            let c = *b;
            if c >= b'a' and c <= b'z' {
                last.push(c as char);
            } else if c >= b'A' and c <= b'Z' {
                last.push((c + 32) as char);
            }
        }
        if last.len() == 0 {
            last.push('a');
        }
        words[n - 1] = last;
        let got = shortest_completing_word(plate, words);
        letters += got.len();
        for b in got.bytes().iter() {
            check = (check * 31 + *b as i64) % 1000000007;
        }
    }
    println(f"{rounds} plates against 1000 words: answers {letters} letters long in all, checksum {check}");
}
