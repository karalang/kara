// LeetCode #760: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random pairs of lists.

// ---- ★ arm ----------------------------------------------------------

fn anagram_mappings_star(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[i64] {
    let mut positions: Map[i64, Vec[i64]] = Map.new();
    for j in 0..nums2.len() {
        if positions.contains_key(nums2[j]) {
            positions.get_mut(nums2[j]).unwrap().push(j);
        } else {
            positions.insert(nums2[j], [j]);
        }
    }
    let mut used: Map[i64, i64] = Map.new();
    let mut mapping: Vec[i64] = Vec.new();
    for x in nums1.iter() {
        let k = used.get(*x) ?? 0;
        mapping.push(positions.get(*x).unwrap()[k]);
        used.insert(*x, k + 1);
    }
    mapping
}

// ---- sorting arm ----------------------------------------------------

fn anagram_mappings_sorted(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[i64] {
    let n = nums1.len();
    let mut order1: Vec[(i64, i64)] = Vec.new();
    let mut order2: Vec[(i64, i64)] = Vec.new();
    for i in 0..n {
        order1.push((nums1[i], i));
        order2.push((nums2[i], i));
    }
    order1.sort();
    order2.sort();
    let mut mapping: Vec[i64] = Vec.new();
    for _ in 0..n {
        mapping.push(0);
    }
    for k in 0..n {
        mapping[order1[k].1] = order2[k].1;
    }
    mapping
}

// ---- scanning arm ---------------------------------------------------

fn anagram_mappings_scan(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[i64] {
    let mut taken: Vec[bool] = Vec.new();
    for _ in 0..nums2.len() {
        taken.push(false);
    }
    let mut mapping: Vec[i64] = Vec.new();
    for x in nums1.iter() {
        let mut j = 0;
        while taken[j] or nums2[j] != *x {
            j += 1;
        }
        taken[j] = true;
        mapping.push(j);
    }
    mapping
}

// ---- queue arm ------------------------------------------------------

fn anagram_mappings_queues(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[i64] {
    let mut queues: Map[i64, VecDeque[i64]] = Map.new();
    for j in 0..nums2.len() {
        if not queues.contains_key(nums2[j]) {
            queues.insert(nums2[j], VecDeque.new());
        }
        queues.get_mut(nums2[j]).unwrap().push_back(j);
    }
    nums1.iter().map(|x| queues.get_mut(*x).unwrap().pop_front().unwrap()).collect()
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, nums1: Vec[i64], nums2: Vec[i64]) -> Vec[i64] {
    if which == 0 {
        anagram_mappings_star(nums1, nums2)
    } else if which == 1 {
        anagram_mappings_sorted(nums1, nums2)
    } else if which == 2 {
        anagram_mappings_scan(nums1, nums2)
    } else {
        anagram_mappings_queues(nums1, nums2)
    }
}

// The definition: the k-th occurrence of a value in `nums1`, counting
// from the left, maps to the k-th occurrence of it in `nums2`.
fn definition(nums1: ref Vec[i64], nums2: ref Vec[i64]) -> Vec[i64] {
    let mut mapping: Vec[i64] = Vec.new();
    for i in 0..nums1.len() {
        let mut k = 0;
        for j in 0..i {
            if nums1[j] == nums1[i] {
                k += 1;
            }
        }
        let mut seen = 0;
        for j in 0..nums2.len() {
            if nums2[j] == nums1[i] {
                if seen == k {
                    mapping.push(j);
                }
                seen += 1;
            }
        }
    }
    mapping
}

fn main() {
    let arms = 4;
    let mut seed = 7600;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 3000;
    let mut repeats = 0;
    for _ in 0..cases {
        // up to 30 values from a range of 1 to 12, so that repeats are
        // common, or now and then up to 10^5
        let n = 1 + next_random(mut seed) % 30;
        let widest = if next_random(mut seed) % 4 == 0 { 100001 } else { 12 };
        let range = 1 + next_random(mut seed) % widest;
        let mut nums1: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums1.push(next_random(mut seed) * 4 % range);
        }
        let mut nums2 = nums1.clone();
        for i in 0..n {
            let j = i + next_random(mut seed) % (n - i);
            nums2.swap(i, j);
        }
        for i in 1..n {
            let mut repeated = false;
            for j in 0..i {
                if nums1[j] == nums1[i] {
                    repeated = true;
                }
            }
            if repeated {
                repeats += 1;
            }
        }
        let mut renamed1: Vec[i64] = Vec.new();
        let mut renamed2: Vec[i64] = Vec.new();
        for i in 0..n {
            renamed1.push(nums1[i] * 7 + 3);
            renamed2.push(nums2[i] * 7 + 3);
        }
        let want = definition(nums1, nums2);
        for which in 0..arms {
            let got = answer_with(which, nums1.clone(), nums2.clone());
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: a mapping: each index of `nums2` once, and equal values
            // at both ends.
            checks += 1;
            let mut hit: Vec[i64] = Vec.new();
            for _ in 0..n {
                hit.push(0);
            }
            let mut ok = got.len() == n;
            if ok {
                for i in 0..n {
                    if got[i] < 0 or got[i] >= n or nums2[got[i]] != nums1[i] {
                        ok = false;
                    } else {
                        hit[got[i]] += 1;
                    }
                }
                for c in hit.iter() {
                    if *c != 1 {
                        ok = false;
                    }
                }
            }
            if not ok {
                fails[1] += 1;
            }
            // P3: the lists swapped give the inverse mapping.
            checks += 1;
            let back = answer_with(which, nums2.clone(), nums1.clone());
            let mut inverse = back.len() == n and ok;
            if inverse {
                for i in 0..n {
                    if back[got[i]] != i {
                        inverse = false;
                    }
                }
            }
            if not inverse {
                fails[2] += 1;
            }
            // P4: renaming the values one to one, x to 7x + 3, changes
            // nothing.
            checks += 1;
            if answer_with(which, renamed1.clone(), renamed2.clone()) != got {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} pairs ({repeats} repeated values), {arms} arms, {checks} checks, {failures} failures");
}
