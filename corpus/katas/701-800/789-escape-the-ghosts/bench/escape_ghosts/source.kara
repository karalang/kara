// LeetCode 789 — Escape The Ghosts: the bench.
//
// 64 boards of 100 ghosts, LeetCode's most, anywhere within 10,000 of
// you, are made once. Each of 10,000,000 rounds asks the next board
// whether you can escape to a random target within 1,000 of you,
// answered with the ★ arm, which stops at the first ghost no farther
// from the target than you.

fn escape_ghosts(ghosts: Vec[Vec[i64]], target: Vec[i64]) -> bool {
    let mine = target[0].abs() + target[1].abs();
    for g in ghosts.iter() {
        if (g[0] - target[0]).abs() + (g[1] - target[1]).abs() <= mine {
            return false;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 789;
    let mut boards: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..64 {
        let mut ghosts: Vec[Vec[i64]] = Vec.new();
        for _ in 0..100 {
            ghosts.push([next_random(mut seed) % 20001 - 10000, next_random(mut seed) % 20001 - 10000]);
        }
        boards.push(ghosts);
    }
    let rounds = 10000000;
    let mut escapes = 0;
    let mut check = 0;
    for r in 0..rounds {
        let target = [next_random(mut seed) % 2001 - 1000, next_random(mut seed) % 2001 - 1000];
        if escape_ghosts(boards[r % 64], target) {
            escapes += 1;
            check = (check * 31 + r % 1000) % 1000000007;
        }
    }
    println(f"{rounds} rounds of 100-ghost boards: {escapes} escapes, checksum {check}");
}
