// LeetCode #705: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random calls.

// ---- star arm -------------------------------------------------------

struct SetChained {
    mut buckets: Vec[Vec[i64]],
}

impl SetChained {
    fn new() -> SetChained {
        let mut buckets: Vec[Vec[i64]] = Vec.new();
        for _ in 0..1009 {
            buckets.push(Vec.new());
        }
        SetChained { buckets: buckets }
    }

    fn add(mut ref self, key: i64) {
        let b = key % 1009;
        if not self.buckets[b].contains(key) {
            self.buckets[b].push(key);
        }
    }

    fn remove(mut ref self, key: i64) {
        let b = key % 1009;
        let n = self.buckets[b].len();
        for i in 0..n {
            if self.buckets[b][i] == key {
                self.buckets[b].swap_remove(i);
                return;
            }
        }
    }

    fn contains(self, key: i64) -> bool {
        self.buckets[key % 1009].contains(key)
    }
}

// ---- bits arm -------------------------------------------------------

struct SetBits {
    mut words: Vec[u64],
}

impl SetBits {
    fn new() -> SetBits {
        let mut words: Vec[u64] = Vec.new();
        for _ in 0..15626 {
            words.push(0);
        }
        SetBits { words: words }
    }

    fn add(mut ref self, key: i64) {
        self.words[key / 64] = self.words[key / 64] | (1u64 << (key % 64));
    }

    fn remove(mut ref self, key: i64) {
        self.words[key / 64] = self.words[key / 64] & ~(1u64 << (key % 64));
    }

    fn contains(self, key: i64) -> bool {
        (self.words[key / 64] >> (key % 64)) & 1 == 1
    }
}

// ---- probing arm ----------------------------------------------------

struct SetProbing {
    mut slots: Vec[i64],
    mut used: i64,
}

// A slot never held a key, and a slot whose key was removed.
const EMPTY: i64 = -1;
const GONE: i64 = -2;

impl SetProbing {
    fn new() -> SetProbing {
        let mut slots: Vec[i64] = Vec.new();
        for _ in 0..16 {
            slots.push(EMPTY);
        }
        SetProbing { slots: slots, used: 0 }
    }

    // Where `key` sits, or else the first tombstone or empty slot on its
    // path, where it would go.
    fn find(self, key: i64) -> i64 {
        let n = self.slots.len();
        let mut at = (key * 2654435761) % n;
        let mut free = -1;
        loop {
            let s = self.slots[at];
            if s == key {
                return at;
            }
            if s == EMPTY {
                return if free >= 0 { free } else { at };
            }
            if s == GONE and free < 0 {
                free = at;
            }
            at = (at + 1) % n;
        }
    }

    fn add(mut ref self, key: i64) {
        let at = self.find(key);
        if self.slots[at] == key {
            return;
        }
        if self.slots[at] == EMPTY {
            self.used += 1;
        }
        self.slots[at] = key;
        if 2 * self.used > self.slots.len() {
            self.grow();
        }
    }

    fn remove(mut ref self, key: i64) {
        let at = self.find(key);
        if self.slots[at] == key {
            self.slots[at] = GONE;
        }
    }

    fn contains(self, key: i64) -> bool {
        self.slots[self.find(key)] == key
    }

    fn grow(mut ref self) {
        let mut old: Vec[i64] = Vec.new();
        for s in self.slots.iter() {
            if *s >= 0 {
                old.push(*s);
            }
        }
        let n = 2 * self.slots.len();
        self.slots = Vec.new();
        for _ in 0..n {
            self.slots.push(EMPTY);
        }
        self.used = 0;
        for k in old.iter() {
            self.add(*k);
        }
    }
}

// ---- stdlib arm -----------------------------------------------------

struct SetStd {
    mut keys: Set[i64],
}

impl SetStd {
    fn new() -> SetStd {
        SetStd { keys: Set.new() }
    }

    fn add(mut ref self, key: i64) {
        self.keys.insert(key);
    }

    fn remove(mut ref self, key: i64) {
        self.keys.remove(key);
    }

    fn contains(self, key: i64) -> bool {
        self.keys.contains(key)
    }
}

// ---- the definition and the properties ------------------------------------

// The calls in order, 0 `add`, 1 `remove`, 2 `contains`; each answer 1
// for true, 0 for false and -1 for a call with none.
fn run(which: i64, ops: Vec[i64], keys: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if which == 0 {
        let mut s = SetChained.new();
        for i in 0..ops.len() {
            if ops[i] == 0 {
                s.add(keys[i]);
                out.push(-1);
            } else if ops[i] == 1 {
                s.remove(keys[i]);
                out.push(-1);
            } else {
                out.push(if s.contains(keys[i]) { 1 } else { 0 });
            }
        }
    } else if which == 1 {
        let mut s = SetBits.new();
        for i in 0..ops.len() {
            if ops[i] == 0 {
                s.add(keys[i]);
                out.push(-1);
            } else if ops[i] == 1 {
                s.remove(keys[i]);
                out.push(-1);
            } else {
                out.push(if s.contains(keys[i]) { 1 } else { 0 });
            }
        }
    } else if which == 2 {
        let mut s = SetProbing.new();
        for i in 0..ops.len() {
            if ops[i] == 0 {
                s.add(keys[i]);
                out.push(-1);
            } else if ops[i] == 1 {
                s.remove(keys[i]);
                out.push(-1);
            } else {
                out.push(if s.contains(keys[i]) { 1 } else { 0 });
            }
        }
    } else {
        let mut s = SetStd.new();
        for i in 0..ops.len() {
            if ops[i] == 0 {
                s.add(keys[i]);
                out.push(-1);
            } else if ops[i] == 1 {
                s.remove(keys[i]);
                out.push(-1);
            } else {
                out.push(if s.contains(keys[i]) { 1 } else { 0 });
            }
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The definition: a list of the keys held, in no order, searched from
// end to end on every call.
fn definition(ops: Vec[i64], keys: Vec[i64]) -> Vec[i64] {
    let mut held: Vec[i64] = Vec.new();
    let mut out: Vec[i64] = Vec.new();
    for i in 0..ops.len() {
        let mut at = -1;
        for j in 0..held.len() {
            if held[j] == keys[i] {
                at = j;
            }
        }
        if ops[i] == 0 {
            if at < 0 {
                held.push(keys[i]);
            }
            out.push(-1);
        } else if ops[i] == 1 {
            if at >= 0 {
                held.remove(at);
            }
            out.push(-1);
        } else {
            out.push(if at >= 0 { 1 } else { 0 });
        }
    }
    out
}

// Key number `k` of a case: itself, or spread so keys share a remainder
// by 1,009 or by 64, or counted down from the largest key.
fn spread(k: i64, mode: i64) -> i64 {
    if mode == 0 {
        k
    } else if mode == 1 {
        k * 1009
    } else if mode == 2 {
        k * 64
    } else {
        1000000 - k
    }
}

fn main() {
    let mut seed = 7050;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut found = 0;
    let cases = 1000;
    for _ in 0..cases {
        // 1 to 60 calls on key numbers below a random 1 to 200, spread
        // one of four ways.
        let n = 1 + next_random(mut seed) % 60;
        let top = 1 + next_random(mut seed) % 200;
        let mode = next_random(mut seed) % 4;
        let mut ops: Vec[i64] = Vec.new();
        let mut keys: Vec[i64] = Vec.new();
        let mut mirrored: Vec[i64] = Vec.new();
        let mut doubled_ops: Vec[i64] = Vec.new();
        let mut doubled_keys: Vec[i64] = Vec.new();
        for _ in 0..n {
            let op = next_random(mut seed) % 3;
            let key = spread(next_random(mut seed) % top, mode);
            ops.push(op);
            keys.push(key);
            mirrored.push(1000000 - key);
            doubled_ops.push(op);
            doubled_keys.push(key);
            if op != 2 {
                doubled_ops.push(op);
                doubled_keys.push(key);
            }
        }
        // The same calls, then `contains` for every key number below
        // `top`.
        let mut full_ops = ops.clone();
        let mut full_keys = keys.clone();
        for k in 0..top {
            full_ops.push(2);
            full_keys.push(spread(k, mode));
        }
        let want = definition(ops, keys);
        let want_full = definition(full_ops, full_keys);
        for a in want.iter() {
            if *a == 1 {
                found += 1;
            }
        }
        for which in 0..arms {
            let got = run(which, ops, keys);
            // P1: the definition's answers.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: every key k replaced by 1,000,000 - k, the same answers.
            checks += 1;
            if run(which, ops, mirrored) != got {
                fails[1] += 1;
            }
            // P3: every `add` and `remove` made twice in a row, the same
            // answers to the `contains` calls.
            checks += 1;
            let twice = run(which, doubled_ops, doubled_keys);
            let mut seen: Vec[i64] = Vec.new();
            for i in 0..doubled_ops.len() {
                if doubled_ops[i] == 2 {
                    seen.push(twice[i]);
                }
            }
            let mut asked: Vec[i64] = Vec.new();
            for i in 0..n {
                if ops[i] == 2 {
                    asked.push(got[i]);
                }
            }
            if seen != asked {
                fails[2] += 1;
            }
            // P4: afterwards, every key number below `top` is held
            // exactly when the definition holds it.
            checks += 1;
            if run(which, full_ops, full_keys) != want_full {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut total = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
        }
        total += fails[p];
    }
    println(f"{report}{cases} sequences ({found} lookups found), {arms} arms, {checks} checks, {total} failures");
}
