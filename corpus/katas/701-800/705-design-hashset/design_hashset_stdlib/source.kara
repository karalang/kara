// LeetCode #705: Design HashSet -- the standard library's.
//
// The stdlib `Set`, a hash set, with the three calls passed through.
// Nothing here walks the set, so its per-run iteration order never
// shows. O(1) expected for each.

struct MyHashSet {
    mut keys: Set[i64],
}

impl MyHashSet {
    fn new() -> MyHashSet {
        MyHashSet { keys: Set.new() }
    }

    fn add(mut ref self, key: i64) {
        self.keys.insert(key);
    }

    fn remove(mut ref self, key: i64) {
        self.keys.remove(key);
    }

    fn contains(self, key: i64) -> bool {
        self.keys.contains(key)
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The calls `ops` names in order, 0 for `add`, 1 for `remove` and 2 for
// `contains`, each on the key beside it; what each returns, `null` for
// the first two as LeetCode prints it.
fn run(ops: Vec[i64], keys: Vec[i64]) -> Vec[String] {
    let mut set = MyHashSet.new();
    let mut out: Vec[String] = Vec.new();
    for i in 0..ops.len() {
        if ops[i] == 0 {
            set.add(keys[i]);
            out.push("null");
        } else if ops[i] == 1 {
            set.remove(keys[i]);
            out.push("null");
        } else {
            out.push(f"{set.contains(keys[i])}");
        }
    }
    out
}

fn show(ops: Vec[i64], keys: Vec[i64]) {
    let names = ["add", "remove", "contains"];
    let mut calls: Vec[String] = Vec.new();
    for i in 0..ops.len() {
        calls.push(f"{names[ops[i]]}({keys[i]})");
    }
    println(f"{calls.join(", ")}: [{run(ops, keys).join(", ")}]");
}

// `n` random calls on keys below `top`: a third of them each kind, so
// the set stays about as full as it is empty.
fn random_calls(n: i64, top: i64, seed: mut ref i64) -> (Vec[i64], Vec[i64]) {
    let mut ops: Vec[i64] = Vec.new();
    let mut keys: Vec[i64] = Vec.new();
    for _ in 0..n {
        ops.push(next_random(mut seed) % 3);
        keys.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top);
    }
    (ops, keys)
}

fn checksum(answers: Vec[String]) -> i64 {
    let mut sum = 0;
    let mut yes = 0;
    for a in answers.iter() {
        let v = if a == "true" { 1 } else if a == "false" { 2 } else { 3 };
        if a == "true" {
            yes += 1;
        }
        sum = (sum * 7 + v) % 1000000007;
    }
    sum * 100000 + yes
}

fn main() {
    // The LeetCode example.
    show(vec![0, 0, 2, 2, 0, 2, 1, 2], vec![1, 2, 1, 3, 2, 2, 2, 2]);
    // The smallest and largest keys; removing a key never added and one
    // twice; adding one back after its removal.
    show(vec![2, 0, 0, 2, 2, 1, 2, 2], vec![0, 0, 1000000, 0, 1000000, 0, 0, 1000000]);
    show(vec![1, 2, 0, 1, 1, 2, 0, 2], vec![5, 5, 5, 5, 5, 5, 5, 5]);
    // Keys that share a remainder by 1,009 and by 64, the sizes two arms
    // lean on: 0, 1,009, 2,018 ... and 64, 128 ...
    show(vec![0, 0, 0, 1, 2, 2, 2, 0, 2], vec![0, 1009, 2018, 1009, 0, 1009, 2018, 3027, 3027]);
    show(vec![0, 0, 1, 2, 2, 2], vec![64, 128, 64, 64, 128, 192]);
    // The problem's most, 10,000 calls: on keys up to 1,000,000; on keys
    // below 100, so most are repeats; and every key from 0 to 4,999
    // added, the odd ones removed, then all looked up.
    let mut seed: i64 = 705;
    for top in [1000001, 100] {
        let (ops, keys) = random_calls(10000, top, mut seed);
        println(f"10000 calls on keys below {top}: checksum {checksum(run(ops, keys))}");
    }
    let mut ops: Vec[i64] = Vec.new();
    let mut keys: Vec[i64] = Vec.new();
    for k in 0..5000 {
        ops.push(0);
        keys.push(k);
    }
    for k in 0..2500 {
        ops.push(1);
        keys.push(2 * k + 1);
    }
    for k in 0..2500 {
        ops.push(2);
        keys.push(2 * k + next_random(mut seed) % 2);
    }
    println(f"5000 added, odd ones removed, 2500 looked up: checksum {checksum(run(ops, keys))}");
    // 300 random sequences of 1 to 200 calls on keys below a random 1
    // to 3,000.
    let mut sum = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 200;
        let top = 1 + next_random(mut seed) % 3000;
        let (ops, keys) = random_calls(n, top, mut seed);
        sum = (sum * 31 + checksum(run(ops, keys))) % 1000000007;
    }
    println(f"300 random sequences: checksum {sum}");
}
