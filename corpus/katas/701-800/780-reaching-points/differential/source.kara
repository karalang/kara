// LeetCode #780: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties
// on random pairs of points.

// ---- ★ arm ----------------------------------------------------------

fn reaching_points_star(sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    let mut x = tx;
    let mut y = ty;
    while x > sx and y > sy and x != y {
        if x > y {
            x %= y;
        } else {
            y %= x;
        }
    }
    if x == sx and y == sy {
        return true;
    }
    if x == sx and y > sy {
        return (y - sy) % x == 0;
    }
    if y == sy and x > sx {
        return (x - sx) % y == 0;
    }
    false
}

// ---- recursive arm --------------------------------------------------

fn reaching_points_recursive(sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    if tx < sx or ty < sy {
        return false;
    }
    if tx == sx and ty == sy {
        return true;
    }
    if tx == ty {
        return false;
    }
    if tx > ty {
        // Undo k moves of y into x, as many as keep tx above ty, or all
        // the way down to sx when ty is already sy.
        if ty == sy {
            return (tx - sx) % ty == 0;
        }
        let k = (tx - 1) / ty;
        reaching_points_recursive(sx, sy, tx - k * ty, ty)
    } else {
        if tx == sx {
            return (ty - sy) % tx == 0;
        }
        let k = (ty - 1) / tx;
        reaching_points_recursive(sx, sy, tx, ty - k * tx)
    }
}

// ---- doubling arm ---------------------------------------------------

// v less as many d's as keeps it at least `floor`.
fn reduce_doubling(v: i64, d: i64, floor: i64) -> i64 {
    let mut left = v;
    let mut step = d;
    while left - step * 2 >= floor {
        step *= 2;
    }
    while step >= d {
        if left - step >= floor {
            left -= step;
        }
        step /= 2;
    }
    left
}

fn reaching_points_doubling(sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    let mut x = tx;
    let mut y = ty;
    loop {
        if x < sx or y < sy {
            return false;
        }
        if x == sx and y == sy {
            return true;
        }
        if x == y {
            return false;
        }
        if x > y {
            let next = reduce_doubling(x, y, if y == sy { sx } else { 1 });
            if next == x {
                return false;
            }
            x = next;
        } else {
            let next = reduce_doubling(y, x, if x == sx { sy } else { 1 });
            if next == y {
                return false;
            }
            y = next;
        }
    }
}

// ---- segments arm ---------------------------------------------------

#[derive(Clone, Copy)]
struct Run_segments {
    x_moves: bool,
    fixed: i64,
    top: i64,
    bottom: i64,
}

fn runs_back_segments(tx: i64, ty: i64) -> Vec[Run_segments] {
    let mut runs: Vec[Run_segments] = Vec.new();
    let mut x = tx;
    let mut y = ty;
    while x != y {
        if x > y {
            // x falls by y while it stays positive.
            let bottom = if x % y == 0 { y } else { x % y };
            runs.push(Run_segments { x_moves: true, fixed: y, top: x, bottom: bottom });
            x = bottom;
        } else {
            let bottom = if y % x == 0 { x } else { y % x };
            runs.push(Run_segments { x_moves: false, fixed: x, top: y, bottom: bottom });
            y = bottom;
        }
    }
    runs
}

fn reaching_points_segments(sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    if sx == tx and sy == ty {
        return true;
    }
    for run in runs_back_segments(tx, ty).iter() {
        let r = *run;
        let (s_moving, s_fixed) = if r.x_moves { (sx, sy) } else { (sy, sx) };
        if s_fixed == r.fixed and s_moving >= r.bottom and s_moving <= r.top and (r.top - s_moving) % r.fixed == 0 {
            return true;
        }
    }
    false
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    if which == 0 {
        reaching_points_star(sx, sy, tx, ty)
    } else if which == 1 {
        reaching_points_recursive(sx, sy, tx, ty)
    } else if which == 2 {
        reaching_points_doubling(sx, sy, tx, ty)
    } else {
        reaching_points_segments(sx, sy, tx, ty)
    }
}

// The definition: every point reached from (sx, sy) by the moves, found
// by depth first search over the points no larger than (tx, ty).
fn definition(sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    if sx > tx or sy > ty {
        return false;
    }
    let width = ty + 1;
    let mut seen: Vec[bool] = Vec.filled((tx + 1) * width, false);
    let mut stack: Vec[(i64, i64)] = Vec.new();
    seen[sx * width + sy] = true;
    stack.push((sx, sy));
    while let Some((x, y)) = stack.pop() {
        if x == tx and y == ty {
            return true;
        }
        if x + y <= tx and not seen[(x + y) * width + y] {
            seen[(x + y) * width + y] = true;
            stack.push((x + y, y));
        }
        if x + y <= ty and not seen[x * width + x + y] {
            seen[x * width + x + y] = true;
            stack.push((x, x + y));
        }
    }
    false
}

// A point reached from (x, y) by `moves` random moves.
fn walk(seed: mut ref i64, x: i64, y: i64, moves: i64) -> (i64, i64) {
    let mut a = x;
    let mut b = y;
    for _ in 0..moves {
        if next_random(mut seed) % 2 == 0 {
            a += b;
        } else {
            b += a;
        }
    }
    (a, b)
}

fn main() {
    let arms = 4;
    let mut seed = 7800;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 2000;
    let mut yes = 0;
    for case in 0..cases {
        // 1,600 small pairs, a start of 1 to 10 and an end of at most
        // 80, where the definition's search is cheap, then 400 with a
        // start up to 1,000 and an end after up to 40 moves. A quarter
        // of the ends are reached by moves, a quarter are such an end
        // with one coordinate moved by one, a quarter are reached from
        // another start near this one, and a quarter are random.
        let small = case < 1600;
        let top = if small { 10 } else { 1000 };
        let sx = 1 + next_random(mut seed) % top;
        let sy = 1 + next_random(mut seed) % top;
        let moves = next_random(mut seed) % if small { 8 } else { 41 };
        let kind = case % 4;
        let (tx, ty) = if kind == 0 {
            walk(mut seed, sx, sy, moves)
        } else if kind == 1 {
            let (a, b) = walk(mut seed, sx, sy, moves);
            let by = if next_random(mut seed) % 2 == 0 { 1 } else { -1 };
            if next_random(mut seed) % 2 == 0 { (if a + by > 0 { a + by } else { a + 1 }, b) } else { (a, if b + by > 0 { b + by } else { b + 1 }) }
        } else if kind == 2 {
            let ox = if sx > 1 and next_random(mut seed) % 2 == 0 { sx - 1 } else { sx + 1 };
            let oy = if sy > 1 and next_random(mut seed) % 2 == 0 { sy - 1 } else { sy };
            walk(mut seed, ox, oy, moves)
        } else {
            (1 + next_random(mut seed) % (8 * top), 1 + next_random(mut seed) % (8 * top))
        };
        let small_end = small and tx <= 80 and ty <= 80;
        let want = if small_end { definition(sx, sy, tx, ty) } else { answer_with(0, sx, sy, tx, ty) };
        if want {
            yes += 1;
        }
        let (fx, fy) = walk(mut seed, tx, ty, 1 + next_random(mut seed) % 6);
        let scale = 2 + next_random(mut seed) % 999;
        for which in 0..arms {
            let got = answer_with(which, sx, sy, tx, ty);
            // P1: the definition's answer, on the small pairs.
            if small_end {
                checks += 1;
                if got != want {
                    fails[0] += 1;
                }
            }
            // P2: the coordinates swapped give the same answer.
            checks += 1;
            if answer_with(which, sy, sx, ty, tx) != got {
                fails[1] += 1;
            }
            // P3: moves compose: the end reaches a point a few moves on,
            // and so does the start when it reaches the end.
            checks += 1;
            if not answer_with(which, tx, ty, fx, fy) or (got and not answer_with(which, sx, sy, fx, fy)) {
                fails[2] += 1;
            }
            // P4: all four coordinates multiplied by the same number give
            // the same answer, since the moves are linear.
            checks += 1;
            if answer_with(which, sx * scale, sy * scale, tx * scale, ty * scale) != got {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} pairs ({yes} reachable), {arms} arms, {checks} checks, {failures} failures");
}
