// LeetCode 780 — Reaching Points, subtraction by doubling.
//
// Walk backwards as in the ★ arm, but without a division: undo a run of
// moves on the larger coordinate by subtracting the smaller one in
// doubling multiples, as long division does in binary. The run goes as
// far as it can while the larger coordinate stays positive, or, once the
// smaller coordinate is already the start's, while it stays at least
// the start's. O(log² max(tx, ty)).

// v less as many d's as keeps it at least `floor`.
fn reduce(v: i64, d: i64, floor: i64) -> i64 {
    let mut left = v;
    let mut step = d;
    while left - step * 2 >= floor {
        step *= 2;
    }
    while step >= d {
        if left - step >= floor {
            left -= step;
        }
        step /= 2;
    }
    left
}

fn reaching_points(sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    let mut x = tx;
    let mut y = ty;
    loop {
        if x < sx or y < sy {
            return false;
        }
        if x == sx and y == sy {
            return true;
        }
        if x == y {
            return false;
        }
        if x > y {
            let next = reduce(x, y, if y == sy { sx } else { 1 });
            if next == x {
                return false;
            }
            x = next;
        } else {
            let next = reduce(y, x, if x == sx { sy } else { 1 });
            if next == y {
                return false;
            }
            y = next;
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(sx: i64, sy: i64, tx: i64, ty: i64) {
    let answer = reaching_points(sx, sy, tx, ty);
    println(f"({sx}, {sy}) -> ({tx}, {ty}): {answer}");
}

// A point reached from (x, y) by `moves` random moves.
fn walk(seed: mut ref i64, x: i64, y: i64, moves: i64) -> (i64, i64) {
    let mut a = x;
    let mut b = y;
    for _ in 0..moves {
        if next_random(mut seed) % 2 == 0 {
            a += b;
        } else {
            b += a;
        }
    }
    (a, b)
}

fn main() {
    show(1, 1, 3, 5);
    show(1, 1, 2, 2);
    show(1, 1, 1, 1);
    show(1, 1, 1000000000, 1);
    show(1, 1, 1000000000, 999999999);
    show(3, 7, 3, 4);
    show(9, 5, 12, 8);
    show(2, 4, 2, 1000000000);
    show(2, 4, 2, 999999999);
    show(35, 13, 960682455, 554650274);
    show(35, 13, 960682455, 554650273);
    let mut seed = 780;
    let mut yes = 0;
    let mut check = 0;
    for case in 0..400 {
        let sx = 1 + next_random(mut seed) % 20;
        let sy = 1 + next_random(mut seed) % 20;
        let (tx, ty) = if case % 2 == 0 {
            walk(mut seed, sx, sy, next_random(mut seed) % 30)
        } else {
            (sx + next_random(mut seed) % 2000, sy + next_random(mut seed) % 2000)
        };
        let answer = reaching_points(sx, sy, tx, ty);
        if answer {
            yes += 1;
        }
        check = (check * 31 + if answer { tx % 1000 } else { ty % 1000 } + 1) % 1000000007;
    }
    println(f"400 random pairs: {yes} reachable, checksum {check}");
}
