// LeetCode 780 — Reaching Points, one undone move at a time, recursively.
//
// Run backwards, the last move is forced: the larger coordinate came
// from adding the smaller one, and equal coordinates came from nothing.
// Undo it and ask again, but undo a whole run of moves on the same
// coordinate at once, down to the start's value when that is in reach,
// so that the depth is that of Euclid's algorithm. O(log max(tx, ty)).

fn reaching_points(sx: i64, sy: i64, tx: i64, ty: i64) -> bool {
    if tx < sx or ty < sy {
        return false;
    }
    if tx == sx and ty == sy {
        return true;
    }
    if tx == ty {
        return false;
    }
    if tx > ty {
        // Undo k moves of y into x, as many as keep tx above ty, or all
        // the way down to sx when ty is already sy.
        if ty == sy {
            return (tx - sx) % ty == 0;
        }
        let k = (tx - 1) / ty;
        reaching_points(sx, sy, tx - k * ty, ty)
    } else {
        if tx == sx {
            return (ty - sy) % tx == 0;
        }
        let k = (ty - 1) / tx;
        reaching_points(sx, sy, tx, ty - k * tx)
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(sx: i64, sy: i64, tx: i64, ty: i64) {
    let answer = reaching_points(sx, sy, tx, ty);
    println(f"({sx}, {sy}) -> ({tx}, {ty}): {answer}");
}

// A point reached from (x, y) by `moves` random moves.
fn walk(seed: mut ref i64, x: i64, y: i64, moves: i64) -> (i64, i64) {
    let mut a = x;
    let mut b = y;
    for _ in 0..moves {
        if next_random(mut seed) % 2 == 0 {
            a += b;
        } else {
            b += a;
        }
    }
    (a, b)
}

fn main() {
    show(1, 1, 3, 5);
    show(1, 1, 2, 2);
    show(1, 1, 1, 1);
    show(1, 1, 1000000000, 1);
    show(1, 1, 1000000000, 999999999);
    show(3, 7, 3, 4);
    show(9, 5, 12, 8);
    show(2, 4, 2, 1000000000);
    show(2, 4, 2, 999999999);
    show(35, 13, 960682455, 554650274);
    show(35, 13, 960682455, 554650273);
    let mut seed = 780;
    let mut yes = 0;
    let mut check = 0;
    for case in 0..400 {
        let sx = 1 + next_random(mut seed) % 20;
        let sy = 1 + next_random(mut seed) % 20;
        let (tx, ty) = if case % 2 == 0 {
            walk(mut seed, sx, sy, next_random(mut seed) % 30)
        } else {
            (sx + next_random(mut seed) % 2000, sy + next_random(mut seed) % 2000)
        };
        let answer = reaching_points(sx, sy, tx, ty);
        if answer {
            yes += 1;
        }
        check = (check * 31 + if answer { tx % 1000 } else { ty % 1000 } + 1) % 1000000007;
    }
    println(f"400 random pairs: {yes} reachable, checksum {check}");
}
