// LeetCode 787 — Cheapest Flights Within K Stops: the bench.
//
// 64 networks of 100 cities, LeetCode's most, are made once, each with
// 1,000 different flights at prices from 1 to 10,000. Each of 20,000
// rounds asks the next network for the cheapest way between two random
// cities with a random k from 0 to 99, answered with the ★ arm,
// Bellman-Ford for k + 1 rounds.

fn find_cheapest_price(n: i64, flights: Vec[Vec[i64]], src: i64, dst: i64, k: i64) -> i64 {
    let unreached = i64.MAX;
    let mut cost: Vec[i64] = Vec.new();
    for _ in 0..n {
        cost.push(unreached);
    }
    cost[src] = 0;
    for _ in 0..k + 1 {
        let before = cost.clone();
        for f in flights.iter() {
            let (from, to, price) = (f[0], f[1], f[2]);
            if before[from] != unreached and before[from] + price < cost[to] {
                cost[to] = before[from] + price;
            }
        }
    }
    if cost[dst] == unreached { -1 } else { cost[dst] }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 787;
    let mut networks: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..64 {
        let mut taken: Vec[bool] = Vec.new();
        for _ in 0..10000 {
            taken.push(false);
        }
        let mut flights: Vec[Vec[i64]] = Vec.new();
        while flights.len() < 1000 {
            let from = next_random(mut seed) % 100;
            let to = next_random(mut seed) % 100;
            if from != to and not taken[from * 100 + to] {
                taken[from * 100 + to] = true;
                flights.push([from, to, 1 + next_random(mut seed) % 10000]);
            }
        }
        networks.push(flights);
    }
    let rounds = 20000;
    let mut found = 0;
    let mut check = 0;
    for r in 0..rounds {
        let src = next_random(mut seed) % 100;
        let dst = (src + 1 + next_random(mut seed) % 99) % 100;
        let k = next_random(mut seed) % 100;
        let answer = find_cheapest_price(100, networks[r % 64], src, dst, k);
        if answer != -1 {
            found += 1;
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"{rounds} rounds of 100-city networks: {found} with a way, checksum {check}");
}
