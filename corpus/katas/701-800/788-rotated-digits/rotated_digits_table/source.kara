// LeetCode 788 — Rotated Digits, a table built from the shorter numbers.
//
// Each number is one of three kinds: it turns into itself (only 0, 1 and
// 8), it turns into another number, or it does not turn into a number.
// Ordered that way, the kind of x is the larger of the kinds of x / 10
// and of its last digit, so one pass from 0 to n fills a table of kinds
// and counts the second kind. O(n).
fn rotated_digits(n: i64) -> i64 {
    let digit_kind = [0, 0, 1, 2, 2, 1, 1, 2, 0, 1];
    let mut kind: Vec[i64] = Vec.new();
    let mut good = 0;
    for x in 0..n + 1 {
        let k = if x < 10 { digit_kind[x] } else { kind[x / 10].max(digit_kind[x % 10]) };
        kind.push(k);
        if k == 1 {
            good += 1;
        }
    }
    good
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    for n in [10, 1, 2, 9, 100, 857, 1000, 2019, 9999, 10000] {
        println(f"n = {n} -> {rotated_digits(n)}");
    }
    let mut seed = 788;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 10000;
        let good = rotated_digits(n);
        sum += good;
        check = (check * 31 + good) % 1000000007;
    }
    println(f"300 random n: answers sum to {sum}, checksum {check}");
}
