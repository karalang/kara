// LeetCode 788 — Rotated Digits, digit by digit.
//
// Turned upside down, 0, 1 and 8 stay themselves, 2 and 5 swap, 6 and 9
// swap, and 3, 4 and 7 are no digit at all. A number is good when every
// digit turns into a digit and at least one, a 2, 5, 6 or 9, turns into
// another. Check every number up to n. O(n log n).
fn rotated_digits(n: i64) -> i64 {
    let mut good = 0;
    for x in 1..n + 1 {
        let mut rest = x;
        let mut valid = true;
        let mut changed = false;
        while rest > 0 {
            let d = rest % 10;
            if d == 3 or d == 4 or d == 7 {
                valid = false;
                break;
            }
            if d == 2 or d == 5 or d == 6 or d == 9 {
                changed = true;
            }
            rest /= 10;
        }
        if valid and changed {
            good += 1;
        }
    }
    good
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    for n in [10, 1, 2, 9, 100, 857, 1000, 2019, 9999, 10000] {
        println(f"n = {n} -> {rotated_digits(n)}");
    }
    let mut seed = 788;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 10000;
        let good = rotated_digits(n);
        sum += good;
        check = (check * 31 + good) % 1000000007;
    }
    println(f"300 random n: answers sum to {sum}, checksum {check}");
}
