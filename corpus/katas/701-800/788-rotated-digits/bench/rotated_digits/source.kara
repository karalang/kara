// LeetCode 788 — Rotated Digits: the bench.
//
// Each of 50,000 rounds counts the good numbers up to a random n from 1
// to 10,000, LeetCode's most, with the ★ arm, which checks every number
// digit by digit.

fn rotated_digits(n: i64) -> i64 {
    let mut good = 0;
    for x in 1..n + 1 {
        let mut rest = x;
        let mut valid = true;
        let mut changed = false;
        while rest > 0 {
            let d = rest % 10;
            if d == 3 or d == 4 or d == 7 {
                valid = false;
                break;
            }
            if d == 2 or d == 5 or d == 6 or d == 9 {
                changed = true;
            }
            rest /= 10;
        }
        if valid and changed {
            good += 1;
        }
    }
    good
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 788;
    let rounds = 50000;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..rounds {
        let n = 1 + next_random(mut seed) % 10000;
        let good = rotated_digits(n);
        sum += good;
        check = (check * 31 + good) % 1000000007;
    }
    println(f"{rounds} rounds of n up to 10000: answers sum to {sum}, checksum {check}");
}
