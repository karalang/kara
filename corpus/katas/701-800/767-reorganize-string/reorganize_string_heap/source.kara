// LeetCode 767 — Reorganize String, a heap of counts.
//
// Keep the letters in a priority queue by how many are left, most first.
// Take the top letter; if it would repeat the letter just written, take
// the next one instead and put the first back. When only the letter just
// written is left, there is no answer. O(n log 26).

fn reorganize_string(s: String) -> String {
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[b as i64 - 97] += 1;
    }
    // smallest first, so counts go in negated
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    for k in 0..26 {
        if counts[k] > 0 {
            queue.push((-counts[k], k));
        }
    }
    let mut out = String.new();
    let mut last = -1;
    while let Some((left, k)) = queue.pop() {
        if k != last {
            out.push((97 + k) as u8 as char);
            last = k;
            if left + 1 < 0 {
                queue.push((left + 1, k));
            }
        } else {
            match queue.pop() {
                Some((other, j)) => {
                    out.push((97 + j) as u8 as char);
                    last = j;
                    if other + 1 < 0 {
                        queue.push((other + 1, j));
                    }
                    queue.push((left, k));
                }
                None => {
                    return String.new();
                }
            }
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// What the answer is: none, or a rearrangement of `s` with no two
// neighbours equal. The arms may choose different rearrangements.
fn verdict(s: String, answer: String) -> String {
    if answer.len() == 0 {
        return "none".to_string();
    }
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[b as i64 - 97] += 1;
    }
    for b in answer.bytes() {
        counts[b as i64 - 97] -= 1;
    }
    let mut prev: u8 = 0;
    let mut ok = answer.len() == s.len();
    for b in answer.bytes() {
        if b == prev {
            ok = false;
        }
        prev = b;
    }
    for k in 0..26 {
        if counts[k] != 0 {
            ok = false;
        }
    }
    if ok { "rearranged".to_string() } else { f"WRONG {answer}" }
}

fn show(s: String) {
    let answer = reorganize_string(s);
    let v = verdict(s, answer);
    println(f"{s} -> {v}");
}

fn main() {
    show("aab");
    show("aaab");
    show("a");
    show("aa");
    show("ab");
    show("aaabb");
    show("aaabbb");
    show("vvvlo");
    show("aaaabbbcc");
    show("aaaaabbbc");
    show("aaaaaabbc");
    let mut seed = 767;
    let mut possible = 0;
    let mut check = 0;
    for round in 0..300 {
        let n = 1 + next_random(mut seed) % 40;
        let letters = 1 + next_random(mut seed) % 5;
        let mut bytes: Vec[u8] = Vec.new();
        for _ in 0..n {
            // letter 0 drawn about twice as often as the others
            let k = next_random(mut seed) % (letters + 1);
            bytes.push((97 + if k == letters { 0 } else { k }) as u8);
        }
        let s = String.from_utf8(bytes).unwrap();
        let answer = reorganize_string(s);
        let v = verdict(s, answer);
        if v == "rearranged" {
            possible += 1;
        } else if v != "none" {
            println(f"{s} -> {v}");
        }
        check = (check * 31 + answer.len() + round) % 1000000007;
    }
    println(f"300 random strings: {possible} rearranged, checksum {check}");
}
