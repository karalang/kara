// LeetCode 767 — Reorganize String: benchmark, the ★ arm.
//
// Sixty-four random strings of 500 letters, the most LeetCode allows,
// built once, each from a random number of letters with the first drawn
// twice as often. 400,000 rounds each reorganize the next of them and
// fold the answer's length and one of its letters into a checksum.

fn reorganize_string(s: String) -> String {
    let n = s.len();
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[b as i64 - 97] += 1;
    }
    let mut most = 0;
    for k in 1..26 {
        if counts[k] > counts[most] {
            most = k;
        }
    }
    if counts[most] > (n + 1) / 2 {
        return String.new();
    }
    let mut out: Vec[u8] = Vec.new();
    for _ in 0..n {
        out.push(0);
    }
    let mut place = 0;
    for step in 0..27 {
        let k = if step == 0 { most } else { step - 1 };
        if step > 0 and k == most {
            continue;
        }
        for _ in 0..counts[k] {
            if place >= n {
                place = 1;
            }
            out[place] = (97 + k) as u8;
            place += 2;
        }
    }
    String.from_utf8(out).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 400000;
    let mut seed = 767;
    let mut pool: Vec[String] = Vec.new();
    for _ in 0..64 {
        let letters = 1 + next_random(mut seed) % 26;
        let mut bytes: Vec[u8] = Vec.new();
        for _ in 0..500 {
            let k = next_random(mut seed) % (letters + 1);
            bytes.push((97 + if k == letters { 0 } else { k }) as u8);
        }
        pool.push(String.from_utf8(bytes).unwrap());
    }
    let mut possible = 0;
    let mut check = 0;
    for round in 0..rounds {
        let answer = reorganize_string(pool[round % 64]);
        let mut letter = 0;
        if answer.len() > 0 {
            possible += 1;
            letter = answer.bytes()[round % 500] as i64;
        }
        check = (check * 31 + answer.len() + letter) % 1000000007;
    }
    println(f"{rounds} strings of 500 letters: {possible} rearranged, checksum {check}");
}
