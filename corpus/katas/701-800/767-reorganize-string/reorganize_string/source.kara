// LeetCode 767 — Reorganize String, the most common letter first.
//
// A letter can be kept from its neighbours only if it fills at most every
// other place, so if any letter makes up more than half of the string,
// rounded up, there is no answer. Otherwise put the most common letter in
// places 0, 2, 4 and so on, and deal the other letters, one letter after
// another, into the even places left and then the odd ones. Two copies of
// a letter end up next to each other only if that letter wraps round from
// the last even place to place 1, and only the most common letter could
// be that long, but it went first. O(n).

fn reorganize_string(s: String) -> String {
    let n = s.len();
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[b as i64 - 97] += 1;
    }
    let mut most = 0;
    for k in 1..26 {
        if counts[k] > counts[most] {
            most = k;
        }
    }
    if counts[most] > (n + 1) / 2 {
        return String.new();
    }
    let mut out: Vec[u8] = Vec.new();
    for _ in 0..n {
        out.push(0);
    }
    let mut place = 0;
    for step in 0..27 {
        let k = if step == 0 { most } else { step - 1 };
        if step > 0 and k == most {
            continue;
        }
        for _ in 0..counts[k] {
            if place >= n {
                place = 1;
            }
            out[place] = (97 + k) as u8;
            place += 2;
        }
    }
    String.from_utf8(out).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// What the answer is: none, or a rearrangement of `s` with no two
// neighbours equal. The arms may choose different rearrangements.
fn verdict(s: String, answer: String) -> String {
    if answer.len() == 0 {
        return "none".to_string();
    }
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[b as i64 - 97] += 1;
    }
    for b in answer.bytes() {
        counts[b as i64 - 97] -= 1;
    }
    let mut prev: u8 = 0;
    let mut ok = answer.len() == s.len();
    for b in answer.bytes() {
        if b == prev {
            ok = false;
        }
        prev = b;
    }
    for k in 0..26 {
        if counts[k] != 0 {
            ok = false;
        }
    }
    if ok { "rearranged".to_string() } else { f"WRONG {answer}" }
}

fn show(s: String) {
    let answer = reorganize_string(s);
    let v = verdict(s, answer);
    println(f"{s} -> {v}");
}

fn main() {
    show("aab");
    show("aaab");
    show("a");
    show("aa");
    show("ab");
    show("aaabb");
    show("aaabbb");
    show("vvvlo");
    show("aaaabbbcc");
    show("aaaaabbbc");
    show("aaaaaabbc");
    let mut seed = 767;
    let mut possible = 0;
    let mut check = 0;
    for round in 0..300 {
        let n = 1 + next_random(mut seed) % 40;
        let letters = 1 + next_random(mut seed) % 5;
        let mut bytes: Vec[u8] = Vec.new();
        for _ in 0..n {
            // letter 0 drawn about twice as often as the others
            let k = next_random(mut seed) % (letters + 1);
            bytes.push((97 + if k == letters { 0 } else { k }) as u8);
        }
        let s = String.from_utf8(bytes).unwrap();
        let answer = reorganize_string(s);
        let v = verdict(s, answer);
        if v == "rearranged" {
            possible += 1;
        } else if v != "none" {
            println(f"{s} -> {v}");
        }
        check = (check * 31 + answer.len() + round) % 1000000007;
    }
    println(f"300 random strings: {possible} rearranged, checksum {check}");
}
