// LeetCode 767 — Reorganize String, the commonest letter that fits.
//
// Write one place at a time, each time the letter with most copies left
// that differs from the one just written. Taking the commonest letter
// keeps any letter from piling up at the end. If no letter fits, there is
// no answer. O(26 n).

fn reorganize_string(s: String) -> String {
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[b as i64 - 97] += 1;
    }
    let mut out = String.new();
    let mut last = -1;
    for _ in 0..s.len() {
        let mut best = -1;
        for k in 0..26 {
            if k != last and counts[k] > 0 and (best < 0 or counts[k] > counts[best]) {
                best = k;
            }
        }
        if best < 0 {
            return String.new();
        }
        out.push((97 + best) as u8 as char);
        counts[best] -= 1;
        last = best;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// What the answer is: none, or a rearrangement of `s` with no two
// neighbours equal. The arms may choose different rearrangements.
fn verdict(s: String, answer: String) -> String {
    if answer.len() == 0 {
        return "none".to_string();
    }
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[b as i64 - 97] += 1;
    }
    for b in answer.bytes() {
        counts[b as i64 - 97] -= 1;
    }
    let mut prev: u8 = 0;
    let mut ok = answer.len() == s.len();
    for b in answer.bytes() {
        if b == prev {
            ok = false;
        }
        prev = b;
    }
    for k in 0..26 {
        if counts[k] != 0 {
            ok = false;
        }
    }
    if ok { "rearranged".to_string() } else { f"WRONG {answer}" }
}

fn show(s: String) {
    let answer = reorganize_string(s);
    let v = verdict(s, answer);
    println(f"{s} -> {v}");
}

fn main() {
    show("aab");
    show("aaab");
    show("a");
    show("aa");
    show("ab");
    show("aaabb");
    show("aaabbb");
    show("vvvlo");
    show("aaaabbbcc");
    show("aaaaabbbc");
    show("aaaaaabbc");
    let mut seed = 767;
    let mut possible = 0;
    let mut check = 0;
    for round in 0..300 {
        let n = 1 + next_random(mut seed) % 40;
        let letters = 1 + next_random(mut seed) % 5;
        let mut bytes: Vec[u8] = Vec.new();
        for _ in 0..n {
            // letter 0 drawn about twice as often as the others
            let k = next_random(mut seed) % (letters + 1);
            bytes.push((97 + if k == letters { 0 } else { k }) as u8);
        }
        let s = String.from_utf8(bytes).unwrap();
        let answer = reorganize_string(s);
        let v = verdict(s, answer);
        if v == "rearranged" {
            possible += 1;
        } else if v != "none" {
            println(f"{s} -> {v}");
        }
        check = (check * 31 + answer.len() + round) % 1000000007;
    }
    println(f"300 random strings: {possible} rearranged, checksum {check}");
}
