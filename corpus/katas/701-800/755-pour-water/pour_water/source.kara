// LeetCode 755 — Pour Water, one drop at a time.
//
// Each drop lands on index k and first tries the left: it walks left
// while the next column is no higher, remembering the first column it
// meets that is lower than the best so far. If it found one lower than
// where it started it settles there; if not it tries the right the same
// way, and failing that it stays on k. O(V x n).

fn pour_water(heights: Vec[i64], volume: i64, k: i64) -> Vec[i64] {
    let mut h = heights.clone();
    let n = h.len();
    for _ in 0..volume {
        let mut best = k;
        for d in [-1, 1] {
            let mut i = k;
            while i + d >= 0 and i + d < n and h[i + d] <= h[i] {
                if h[i + d] < h[best] {
                    best = i + d;
                }
                i += d;
            }
            if best != k {
                break;
            }
        }
        h[best] += 1;
    }
    h
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(heights: Vec[i64], volume: i64, k: i64) {
    let after = pour_water(heights.clone(), volume, k);
    println(f"{heights}, V = {volume}, K = {k} -> {after}");
}

fn main() {
    show([2, 1, 1, 2, 1, 2, 2], 4, 3);
    show([1, 2, 3, 4], 2, 2);
    show([3, 1, 3], 5, 1);
    show([5], 3, 0);
    show([1, 1, 1, 1], 0, 2);
    show([0, 0, 0, 0, 0], 7, 2);
    show([4, 3, 2, 1, 0], 6, 0);
    show([0, 1, 2, 3, 4], 6, 4);
    show([2, 0, 2, 0, 2], 3, 2);
    show([3, 2, 1, 2, 1, 2, 3], 9, 3);
    let mut seed = 755;
    let mut water = 0;
    let mut check = 0;
    for _ in 0..200 {
        let n = 1 + next_random(mut seed) % 100;
        let mut heights: Vec[i64] = Vec.new();
        for _ in 0..n {
            heights.push(next_random(mut seed) % 100);
        }
        let volume = next_random(mut seed) % 2001;
        let k = next_random(mut seed) % n;
        let after = pour_water(heights, volume, k);
        for x in after.iter() {
            water += *x;
            check = (check * 31 + *x) % 1000000007;
        }
    }
    println(f"200 random landscapes: {water} units of ground and water in all, checksum {check}");
}
