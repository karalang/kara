// LeetCode 755 — Pour Water, with iterator chains.
//
// For one side, the columns a drop can reach are the run, outward from
// k, over which the ground never rises: `take_while` on consecutive
// pairs finds how far that run goes, and a `fold` over it keeps the
// first column of the lowest height. The drop settles there if it is
// lower than k, trying the left side before the right. O(V x n).

fn lowest_reach(h: ref Vec[i64], k: i64, d: i64) -> i64 {
    let n = h.len();
    let steps = (1..n)
        .take_while(|s| {
            let at = k + d * s;
            at >= 0 and at < n and h[at] <= h[at - d]
        })
        .count();
    (1..steps + 1).map(|s| k + d * s).fold(k, |best, at| if h[at] < h[best] { at } else { best })
}

fn pour_water(heights: Vec[i64], volume: i64, k: i64) -> Vec[i64] {
    let mut h = heights.clone();
    for _ in 0..volume {
        let left = lowest_reach(h, k, -1);
        let at = if left != k { left } else { lowest_reach(h, k, 1) };
        h[at] += 1;
    }
    h
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(heights: Vec[i64], volume: i64, k: i64) {
    let after = pour_water(heights.clone(), volume, k);
    println(f"{heights}, V = {volume}, K = {k} -> {after}");
}

fn main() {
    show([2, 1, 1, 2, 1, 2, 2], 4, 3);
    show([1, 2, 3, 4], 2, 2);
    show([3, 1, 3], 5, 1);
    show([5], 3, 0);
    show([1, 1, 1, 1], 0, 2);
    show([0, 0, 0, 0, 0], 7, 2);
    show([4, 3, 2, 1, 0], 6, 0);
    show([0, 1, 2, 3, 4], 6, 4);
    show([2, 0, 2, 0, 2], 3, 2);
    show([3, 2, 1, 2, 1, 2, 3], 9, 3);
    let mut seed = 755;
    let mut water = 0;
    let mut check = 0;
    for _ in 0..200 {
        let n = 1 + next_random(mut seed) % 100;
        let mut heights: Vec[i64] = Vec.new();
        for _ in 0..n {
            heights.push(next_random(mut seed) % 100);
        }
        let volume = next_random(mut seed) % 2001;
        let k = next_random(mut seed) % n;
        let after = pour_water(heights, volume, k);
        for x in after.iter() {
            water += *x;
            check = (check * 31 + *x) % 1000000007;
        }
    }
    println(f"200 random landscapes: {water} units of ground and water in all, checksum {check}");
}
