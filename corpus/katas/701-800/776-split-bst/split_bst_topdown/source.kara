// LeetCode 776 — Split BST, top-down with two tails.
//
// Walk the one path the target picks. The small tree grows down its right
// edge and the large tree down its left: a node no greater than the target
// hangs as the right child of the small tree's last node and the walk goes
// right, and a greater one hangs as the left child of the large tree's
// last node and the walk goes left. The two tails are cut at the end.
// Two placeholder heads keep the first node from being a special case.
// O(height) time, O(1) extra space.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn split_bst(root: Option[TreeNode], target: i64) -> (Option[TreeNode], Option[TreeNode]) {
    let small_head = TreeNode { val: 0, left: None, right: None };
    let large_head = TreeNode { val: 0, left: None, right: None };
    let mut small_tail = small_head;
    let mut large_tail = large_head;
    let mut cursor = root;
    while let Some(node) = cursor {
        if node.val <= target {
            cursor = node.right;
            small_tail.right = Some(node);
            small_tail = node;
        } else {
            cursor = node.left;
            large_tail.left = Some(node);
            large_tail = node;
        }
    }
    small_tail.right = None;
    large_tail.left = None;
    (small_head.right, large_head.left)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Inserts v into the search tree rooted at root (v not already there)
// and returns the root.
fn insert(root: Option[TreeNode], v: i64) -> Option[TreeNode] {
    let fresh = TreeNode { val: v, left: None, right: None };
    let Some(top) = root else {
        return Some(fresh);
    };
    let mut node = top;
    loop {
        if v < node.val {
            match node.left {
                Some(l) => node = l,
                None => {
                    node.left = Some(fresh);
                    break;
                }
            }
        } else {
            match node.right {
                Some(r) => node = r,
                None => {
                    node.right = Some(fresh);
                    break;
                }
            }
        }
    }
    Some(top)
}

fn tree_of(values: Vec[i64]) -> Option[TreeNode] {
    let mut root: Option[TreeNode] = None;
    for v in values {
        root = insert(root, v);
    }
    root
}

// LeetCode's level-order form, `null` for a missing child, trailing nulls
// left off.
fn level_order(root: Option[TreeNode]) -> String {
    let mut items: Vec[String] = Vec.new();
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    while let Some(slot) = queue.pop_front() {
        match slot {
            Some(node) => {
                items.push(node.val.to_string());
                queue.push_back(node.left);
                queue.push_back(node.right);
            }
            None => items.push(String.from("null")),
        }
    }
    while items.len() > 0 and items[items.len() - 1] == "null" {
        items.pop();
    }
    f"[{items.join(",")}]"
}

fn show(values: Vec[i64], target: i64) {
    let before = level_order(tree_of(values));
    let (small, large) = split_bst(tree_of(values), target);
    println(f"{before}, target = {target} -> {level_order(small)} {level_order(large)}");
}

fn main() {
    show([4, 2, 6, 1, 3, 5, 7], 2);
    show([1], 1);
    show([1], 0);
    show([5, 3, 8, 1, 4, 7, 9, 2, 6], 4);
    show([5, 3, 8, 1, 4, 7, 9, 2, 6], 6);
    show([5, 3, 8, 1, 4, 7, 9, 2, 6], 0);
    show([5, 3, 8, 1, 4, 7, 9, 2, 6], 9);
    show([1, 2, 3, 4, 5, 6, 7, 8], 4);
    show([8, 7, 6, 5, 4, 3, 2, 1], 4);
    show([10, 1, 20, 2, 19, 3, 18, 4, 17], 10);
    let mut seed = 776;
    let mut check = 0;
    let mut small_nodes = 0;
    for _ in 0..300 {
        // 1 to 50 distinct values from 0 to 1000, LeetCode's limits.
        let n = 1 + next_random(mut seed) % 50;
        let mut used: Set[i64] = Set.new();
        let mut values: Vec[i64] = Vec.new();
        while values.len() < n {
            let v = next_random(mut seed) % 1001;
            if not used.contains(v) {
                used.insert(v);
                values.push(v);
            }
        }
        let target = next_random(mut seed) % 1001;
        let (small, large) = split_bst(tree_of(values), target);
        let text = f"{level_order(small)}|{level_order(large)}";
        for b in text.bytes() {
            check = (check * 31 + b as i64) % 1000000007;
        }
        for v in values.iter() {
            if v <= target {
                small_nodes += 1;
            }
        }
    }
    println(f"300 random trees: {small_nodes} nodes in the small trees, checksum {check}");
}
