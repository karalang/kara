// LeetCode #791: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties
// on random strings.

// ---- ★ arm ----------------------------------------------------------

fn custom_sort_string_star(order: String, s: String) -> String {
    let mut count: Vec[i64] = Vec.new();
    for _ in 0..26 {
        count.push(0);
    }
    for b in s.bytes() {
        count[(b - b'a') as i64] += 1;
    }
    let mut named: Vec[bool] = Vec.new();
    for _ in 0..26 {
        named.push(false);
    }
    let mut out = String.new();
    for c in order.chars() {
        let at = (c as i64) - ('a' as i64);
        named[at] = true;
        for _ in 0..count[at] {
            out.push(c);
        }
    }
    for c in s.chars() {
        if not named[(c as i64) - ('a' as i64)] {
            out.push(c);
        }
    }
    out
}

// ---- sort_by arm ----------------------------------------------------

fn custom_sort_string_sortby(order: String, s: String) -> String {
    let mut rank: Vec[i64] = Vec.new();
    for _ in 0..26 {
        rank.push(26);
    }
    let mut place = 0;
    for c in order.chars() {
        rank[(c as i64) - ('a' as i64)] = place;
        place += 1;
    }
    let mut letters: Vec[char] = s.chars().collect();
    letters.sort_by(|a, b| rank[(a as i64) - ('a' as i64)].cmp(rank[(b as i64) - ('a' as i64)]));
    let mut out = String.new();
    for c in letters.iter() {
        out.push(*c);
    }
    out
}

// ---- buckets arm ----------------------------------------------------

fn custom_sort_string_buckets(order: String, s: String) -> String {
    let mut bucket_of: Map[char, i64] = Map.new();
    let mut place = 0;
    for c in order.chars() {
        bucket_of.insert(c, place);
        place += 1;
    }
    let mut buckets: Vec[String] = Vec.new();
    for _ in 0..place + 1 {
        buckets.push(String.new());
    }
    for c in s.chars() {
        let at = match bucket_of.get(c) {
            Some(b) => *b,
            None => place,
        };
        buckets[at].push(c);
    }
    let mut out = String.new();
    for b in buckets.iter() {
        out.push_str(b);
    }
    out
}

// ---- filter arm -----------------------------------------------------

fn custom_sort_string_filter(order: String, s: String) -> String {
    let mut out = String.new();
    for c in order.chars() {
        let same: String = s.chars().filter(|x| x == c).collect();
        out.push_str(same);
    }
    let rest: String = s.chars().filter(|x| not order.chars().any(|o| o == x)).collect();
    out.push_str(rest);
    out
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, order: String, s: String) -> String {
    if which == 0 {
        custom_sort_string_star(order, s)
    } else if which == 1 {
        custom_sort_string_sortby(order, s)
    } else if which == 2 {
        custom_sort_string_buckets(order, s)
    } else {
        custom_sort_string_filter(order, s)
    }
}

// A letter's place in order, or 26 when order does not name it.
fn rank_of(order: Vec[char], c: char) -> i64 {
    for i in 0..order.len() {
        if order[i] == c {
            return i;
        }
    }
    26
}

// The definition: the letters of s by insertion sort on their rank, each
// moved left only past letters of a larger rank, so equal ranks keep
// their order in s.
fn definition(order: String, s: String) -> String {
    let named: Vec[char] = order.chars().collect();
    let mut letters: Vec[char] = s.chars().collect();
    for i in 1..letters.len() {
        let mut j = i;
        while j > 0 and rank_of(named, letters[j - 1]) > rank_of(named, letters[j]) {
            letters.swap(j - 1, j);
            j -= 1;
        }
    }
    let mut out = String.new();
    for c in letters.iter() {
        out.push(*c);
    }
    out
}

fn letter_counts(s: String) -> Vec[i64] {
    let mut count: Vec[i64] = Vec.new();
    for _ in 0..26 {
        count.push(0);
    }
    for b in s.bytes() {
        count[(b - b'a') as i64] += 1;
    }
    count
}

fn make_case(seed: mut ref i64, kind: i64) -> (String, String) {
    // kind 0: any order and s; kind 1: order all 26 letters; kind 2: s
    // only from letters order does not name, or from a few letters; kind
    // 3: s only from order's letters.
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut pool = letters.clone();
    let mut i = 25;
    while i > 0 {
        pool.swap(i, next_random(mut seed) % (i + 1));
        i -= 1;
    }
    let size = if kind == 1 { 26 } else { 1 + next_random(mut seed) % 26 };
    let mut order = String.new();
    for j in 0..size {
        order.push(pool[j]);
    }
    let n = 1 + next_random(mut seed) % (if next_random(mut seed) % 4 == 0 { 200 } else { 12 });
    let mut s = String.new();
    for _ in 0..n {
        let c = if kind == 2 {
            if size < 26 { pool[size + next_random(mut seed) % (26 - size)] } else { pool[next_random(mut seed) % 3] }
        } else if kind == 3 {
            pool[next_random(mut seed) % size]
        } else {
            letters[next_random(mut seed) % 26]
        };
        s.push(c);
    }
    (order, s)
}

fn main() {
    let arms = 4;
    let mut seed = 7910;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1600;
    let mut total = 0;
    for case in 0..cases {
        let (order, s) = make_case(mut seed, case % 4);
        let want = definition(order, s);
        total += want.len();
        let named: Vec[char] = order.chars().collect();
        for which in 0..arms {
            let got = answer_with(which, order, s);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the same letters as s, as many of each.
            checks += 1;
            if letter_counts(got) != letter_counts(s) {
                fails[1] += 1;
            }
            // P3: the letters' ranks never go down.
            checks += 1;
            let ranks: Vec[i64] = got.chars().map(|c| rank_of(named, c)).collect();
            let mut rising = true;
            for k in 1..ranks.len() {
                if ranks[k - 1] > ranks[k] {
                    rising = false;
                }
            }
            if not rising {
                fails[2] += 1;
            }
            // P4: the letters order does not name come in the order s
            // has them.
            checks += 1;
            let rest_got: String = got.chars().filter(|c| rank_of(named, c) == 26).collect();
            let rest_s: String = s.chars().filter(|c| rank_of(named, c) == 26).collect();
            if rest_got != rest_s {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} cases ({total} letters), {arms} arms, {checks} checks, {failures} failures");
}
