// LeetCode 751 — IP to CIDR, bench: the ★ arm (greedy by the lowest
// set bit) on half a million ranges from a pool of 1000 addresses.

fn address(ip: String) -> i64 {
    let mut x = 0;
    for part in ip.split(".") {
        x = x * 256 + i64.parse(part).unwrap();
    }
    x
}

fn dotted(x: i64) -> String {
    f"{x / 16777216 % 256}.{x / 65536 % 256}.{x / 256 % 256}.{x % 256}"
}

fn ip_to_cidr(ip: String, n: i64) -> Vec[String] {
    let mut x = address(ip);
    let mut left = n;
    let mut out: Vec[String] = Vec.new();
    while left > 0 {
        let mut size = if x == 0 { 4294967296 } else { x & (0 - x) };
        while size > left {
            size /= 2;
        }
        let mut bits = 0;
        while (1 << bits) < size {
            bits += 1;
        }
        out.push(f"{dotted(x)}/{32 - bits}");
        x += size;
        left -= size;
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let queries = 500000;
    let mut seed = 751;
    let mut pool: Vec[String] = Vec.new();
    for _ in 0..1000 {
        let a = next_random(mut seed) % 255;
        let b = next_random(mut seed) % 256;
        let c = next_random(mut seed) % 256;
        let d = next_random(mut seed) % 256;
        pool.push(f"{a}.{b}.{c}.{d}");
    }
    let mut blocks = 0;
    let mut check = 0;
    for q in 0..queries {
        let n = 1 + next_random(mut seed) % 1000;
        let found = ip_to_cidr(pool[q % 1000], n);
        blocks += found.len();
        for block in found.iter() {
            check = (check * 31 + block.len()) % 1000000007;
        }
    }
    println(f"{queries} ranges: {blocks} blocks in all, checksum {check}");
}
