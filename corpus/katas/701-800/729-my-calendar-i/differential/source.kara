// LeetCode #729: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random runs of
// bookings.

// ---- ★ arm ----------------------------------------------------------

struct MyCalendarStar {
    booked: Vec[(i64, i64)],
}

impl MyCalendarStar {
    fn new() -> MyCalendarStar {
        MyCalendarStar { booked: Vec.new() }
    }

    fn book(mut ref self, start: i64, end: i64) -> bool {
        for b in self.booked.iter() {
            if start < b.1 and b.0 < end {
                return false;
            }
        }
        self.booked.push((start, end));
        true
    }
}

// ---- sorted arm -----------------------------------------------------

struct MyCalendarSorted {
    starts: Vec[i64],
    ends: Vec[i64],
}

impl MyCalendarSorted {
    fn new() -> MyCalendarSorted {
        MyCalendarSorted { starts: Vec.new(), ends: Vec.new() }
    }

    fn book(mut ref self, start: i64, end: i64) -> bool {
        // The first booking that starts at or after `start`.
        let mut lo = 0;
        let mut hi = self.starts.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.starts[mid] < start {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo > 0 and self.ends[lo - 1] > start {
            return false;
        }
        if lo < self.starts.len() and self.starts[lo] < end {
            return false;
        }
        self.starts.insert(lo, start);
        self.ends.insert(lo, end);
        true
    }
}

// ---- ordered arm ----------------------------------------------------

struct MyCalendarOrdered {
    by_start: SortedMap[i64, i64],
}

impl MyCalendarOrdered {
    fn new() -> MyCalendarOrdered {
        MyCalendarOrdered { by_start: SortedMap.new() }
    }

    fn book(mut ref self, start: i64, end: i64) -> bool {
        if let Some((_, before_end)) = self.by_start.floor(start) {
            if before_end > start {
                return false;
            }
        }
        if let Some((after_start, _)) = self.by_start.ceiling(start) {
            if after_start < end {
                return false;
            }
        }
        self.by_start.insert(start, end);
        true
    }
}

// ---- tree arm -------------------------------------------------------

shared struct Node {
    start: i64,
    end: i64,
    mut left: Option[Node],
    mut right: Option[Node],
}

struct MyCalendarTree {
    root: Option[Node],
}

impl MyCalendarTree {
    fn new() -> MyCalendarTree {
        MyCalendarTree { root: None }
    }

    fn book(mut ref self, start: i64, end: i64) -> bool {
        let leaf = Node { start: start, end: end, left: None, right: None };
        match self.root {
            None => {
                self.root = Some(leaf);
                return true;
            }
            Some(top) => {
                let mut node = top;
                loop {
                    if end <= node.start {
                        match node.left {
                            None => {
                                node.left = Some(leaf);
                                return true;
                            }
                            Some(next) => {
                                node = next;
                            }
                        }
                    } else if start >= node.end {
                        match node.right {
                            None => {
                                node.right = Some(leaf);
                                return true;
                            }
                            Some(next) => {
                                node = next;
                            }
                        }
                    } else {
                        return false;
                    }
                }
            }
        }
    }
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn run(which: i64, bookings: Vec[(i64, i64)]) -> Vec[bool] {
    let mut out: Vec[bool] = Vec.new();
    if which == 0 {
        let mut cal = MyCalendarStar.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    } else if which == 1 {
        let mut cal = MyCalendarSorted.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    } else if which == 2 {
        let mut cal = MyCalendarOrdered.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    } else {
        let mut cal = MyCalendarTree.new();
        for b in bookings.iter() {
            out.push(cal.book(b.0, b.1));
        }
    }
    out
}

// The definition: a row of taken minutes, 0 to 1199; a booking is
// accepted when every minute it covers is free, and then takes them.
fn definition(bookings: Vec[(i64, i64)]) -> Vec[bool] {
    let mut taken: Vec[bool] = vec![false; 1200];
    let mut out: Vec[bool] = Vec.new();
    for b in bookings.iter() {
        let mut free = true;
        for x in b.0..b.1 {
            if taken[x] {
                free = false;
            }
        }
        if free {
            for x in b.0..b.1 {
                taken[x] = true;
            }
        }
        out.push(free);
    }
    out
}

fn overlap(a: (i64, i64), b: (i64, i64)) -> bool {
    a.0 < b.1 and b.0 < a.1
}

fn main() {
    let mut seed = 7290;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut refused = 0;
    let cases = 3000;
    for _ in 0..cases {
        // 1 to 20 bookings of 1 to 15 minutes starting in 0 to 99, so
        // clashes, touching ends and free slots are all common.
        let n = 1 + next_random(mut seed) % 20;
        let mut bookings: Vec[(i64, i64)] = Vec.new();
        for _ in 0..n {
            let s = next_random(mut seed) % 100;
            bookings.push((s, s + 1 + next_random(mut seed) % 15));
        }
        let want = definition(bookings.clone());
        for w in want.iter() {
            if not *w {
                refused += 1;
            }
        }
        let mut shifted: Vec[(i64, i64)] = Vec.new();
        for b in bookings.iter() {
            shifted.push((b.0 + 1000, b.1 + 1000));
        }
        for which in 0..arms {
            let got = run(which, bookings.clone());
            // P1: the definition's answers.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the accepted bookings never overlap, and each refused
            // one overlaps one accepted before it.
            checks += 1;
            let mut ok = got.len() == n;
            if ok {
                for i in 0..n {
                    let mut clash = false;
                    for j in 0..i {
                        if got[j] and overlap(bookings[i], bookings[j]) {
                            clash = true;
                        }
                    }
                    if got[i] == clash {
                        ok = false;
                    }
                }
            }
            if not ok {
                fails[1] += 1;
            }
            // P3: every booking 1000 minutes later, the same answers.
            checks += 1;
            if run(which, shifted.clone()) != got {
                fails[2] += 1;
            }
            // P4: the accepted bookings alone, last first, all accepted.
            checks += 1;
            let mut kept: Vec[(i64, i64)] = Vec.new();
            let mut i = got.len();
            while i > 0 {
                i -= 1;
                if got[i] {
                    kept.push(bookings[i]);
                }
            }
            for r in run(which, kept).iter() {
                if not *r {
                    fails[3] += 1;
                    break;
                }
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{cases} runs ({refused} bookings refused), {arms} arms, {checks} checks, {total} failures");
}
