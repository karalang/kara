// LeetCode 749 — Contain Virus, flood fill each day.
//
// Each day, flood-fill the infected cells into regions with a stack,
// counting for each region the clean cells it threatens (each once) and
// the walls it would need (one for each side it shares with a clean
// cell). Wall off the region that threatens the most cells, the first
// found on a tie, and let every other region infect the cells it
// threatens. Stop when no region threatens a cell. O(days x m x n).

fn contain_virus(is_infected: Vec[Vec[i64]]) -> i64 {
    let m = is_infected.len();
    let n = is_infected[0].len();
    // 0 clean, 1 infected, 2 walled off
    let mut g: Vec[i64] = Vec.new();
    for r in 0..m {
        for c in 0..n {
            g.push(is_infected[r][c]);
        }
    }
    let mut walls = 0;
    loop {
        let mut region: Vec[i64] = Vec.new();
        let mut mark: Vec[i64] = Vec.new();
        for _ in 0..m * n {
            region.push(-1);
            mark.push(-1);
        }
        let mut cells: Vec[Vec[i64]] = Vec.new();
        let mut threats: Vec[Vec[i64]] = Vec.new();
        let mut needs: Vec[i64] = Vec.new();
        for start in 0..m * n {
            if g[start] != 1 or region[start] != -1 {
                continue;
            }
            let id = cells.len();
            let mut mine: Vec[i64] = Vec.new();
            let mut threat: Vec[i64] = Vec.new();
            let mut need = 0;
            let mut stack: Vec[i64] = Vec.new();
            stack.push(start);
            region[start] = id;
            while stack.len() > 0 {
                let at = stack.pop().unwrap();
                mine.push(at);
                let r = at / n;
                let c = at % n;
                let mut next: Vec[i64] = Vec.new();
                if r > 0 {
                    next.push(at - n);
                }
                if r < m - 1 {
                    next.push(at + n);
                }
                if c > 0 {
                    next.push(at - 1);
                }
                if c < n - 1 {
                    next.push(at + 1);
                }
                for x in next.iter() {
                    let y = *x;
                    if g[y] == 0 {
                        need += 1;
                        if mark[y] != id {
                            mark[y] = id;
                            threat.push(y);
                        }
                    } else if g[y] == 1 and region[y] == -1 {
                        region[y] = id;
                        stack.push(y);
                    }
                }
            }
            cells.push(mine);
            threats.push(threat);
            needs.push(need);
        }
        let mut best = -1;
        for id in 0..cells.len() {
            if threats[id].len() > 0 and (best == -1 or threats[id].len() > threats[best].len()) {
                best = id;
            }
        }
        if best == -1 {
            break;
        }
        walls += needs[best];
        for id in 0..cells.len() {
            if id == best {
                for x in cells[id].iter() {
                    g[*x] = 2;
                }
            } else {
                for x in threats[id].iter() {
                    g[*x] = 1;
                }
            }
        }
    }
    walls
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(text: String) {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for row in text.split("/") {
        let mut cells: Vec[i64] = Vec.new();
        for c in row.chars() {
            cells.push(if c == '1' { 1 } else { 0 });
        }
        grid.push(cells);
    }
    println(f"{text} -> {contain_virus(grid)}");
}

// An m x n grid in which each cell is infected with chance
// `percent` in 100.
fn random_grid(seed: mut ref i64, m: i64, n: i64, percent: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < percent { 1 } else { 0 });
        }
        grid.push(row);
    }
    grid
}

fn main() {
    show(String.from("01000001/01000001/00000001/00000000"));
    show(String.from("111/101/111"));
    show(String.from("111000000/101011111/111000000"));
    show(String.from("0"));
    show(String.from("1"));
    show(String.from("10"));
    show(String.from("1111/1111"));
    show(String.from("1000/0000/0000/0001"));
    show(String.from("10101/01010/10101"));
    show(String.from("00000/00100/00000"));

    let mut seed = 749;
    for percent in [1, 3, 10, 30] {
        let grid = random_grid(mut seed, 50, 50, percent);
        println(f"50 x 50, {percent}% infected: {contain_virus(grid)} walls");
    }

    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let m = 1 + next_random(mut seed) % 8;
        let n = 1 + next_random(mut seed) % 8;
        let percent = 5 + next_random(mut seed) % 40;
        let grid = random_grid(mut seed, m, n, percent);
        let w = contain_virus(grid);
        total += w;
        check = (check * 31 + w) % 1000000007;
    }
    println(f"300 random grids: {total} walls in all, checksum {check}");
}
