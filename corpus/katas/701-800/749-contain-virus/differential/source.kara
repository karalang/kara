// LeetCode #749: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random grids.

// ---- ★ arm ----------------------------------------------------------

fn contain_virus_star(is_infected: Vec[Vec[i64]]) -> i64 {
    let m = is_infected.len();
    let n = is_infected[0].len();
    // 0 clean, 1 infected, 2 walled off
    let mut g: Vec[i64] = Vec.new();
    for r in 0..m {
        for c in 0..n {
            g.push(is_infected[r][c]);
        }
    }
    let mut walls = 0;
    loop {
        let mut region: Vec[i64] = Vec.new();
        let mut mark: Vec[i64] = Vec.new();
        for _ in 0..m * n {
            region.push(-1);
            mark.push(-1);
        }
        let mut cells: Vec[Vec[i64]] = Vec.new();
        let mut threats: Vec[Vec[i64]] = Vec.new();
        let mut needs: Vec[i64] = Vec.new();
        for start in 0..m * n {
            if g[start] != 1 or region[start] != -1 {
                continue;
            }
            let id = cells.len();
            let mut mine: Vec[i64] = Vec.new();
            let mut threat: Vec[i64] = Vec.new();
            let mut need = 0;
            let mut stack: Vec[i64] = Vec.new();
            stack.push(start);
            region[start] = id;
            while stack.len() > 0 {
                let at = stack.pop().unwrap();
                mine.push(at);
                let r = at / n;
                let c = at % n;
                let mut next: Vec[i64] = Vec.new();
                if r > 0 {
                    next.push(at - n);
                }
                if r < m - 1 {
                    next.push(at + n);
                }
                if c > 0 {
                    next.push(at - 1);
                }
                if c < n - 1 {
                    next.push(at + 1);
                }
                for x in next.iter() {
                    let y = *x;
                    if g[y] == 0 {
                        need += 1;
                        if mark[y] != id {
                            mark[y] = id;
                            threat.push(y);
                        }
                    } else if g[y] == 1 and region[y] == -1 {
                        region[y] = id;
                        stack.push(y);
                    }
                }
            }
            cells.push(mine);
            threats.push(threat);
            needs.push(need);
        }
        let mut best = -1;
        for id in 0..cells.len() {
            if threats[id].len() > 0 and (best == -1 or threats[id].len() > threats[best].len()) {
                best = id;
            }
        }
        if best == -1 {
            break;
        }
        walls += needs[best];
        for id in 0..cells.len() {
            if id == best {
                for x in cells[id].iter() {
                    g[*x] = 2;
                }
            } else {
                for x in threats[id].iter() {
                    g[*x] = 1;
                }
            }
        }
    }
    walls
}

// ---- sets arm -------------------------------------------------------

fn contain_virus_sets(is_infected: Vec[Vec[i64]]) -> i64 {
    let m = is_infected.len();
    let n = is_infected[0].len();
    let mut g = is_infected.clone();
    let mut walls = 0;
    loop {
        let mut seen: Vec[Vec[bool]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[bool] = Vec.new();
            for _ in 0..n {
                row.push(false);
            }
            seen.push(row);
        }
        let mut cells: Vec[Vec[(i64, i64)]] = Vec.new();
        let mut threats: Vec[Set[(i64, i64)]] = Vec.new();
        let mut needs: Vec[i64] = Vec.new();
        for r0 in 0..m {
            for c0 in 0..n {
                if g[r0][c0] != 1 or seen[r0][c0] {
                    continue;
                }
                let mut mine: Vec[(i64, i64)] = Vec.new();
                let mut threat: Set[(i64, i64)] = Set.new();
                let mut need = 0;
                let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
                queue.push_back((r0, c0));
                seen[r0][c0] = true;
                while let Some((r, c)) = queue.pop_front() {
                    mine.push((r, c));
                    for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
                        let nr = r + dr;
                        let nc = c + dc;
                        if nr < 0 or nr >= m or nc < 0 or nc >= n {
                            continue;
                        }
                        if g[nr][nc] == 0 {
                            need += 1;
                            threat.insert((nr, nc));
                        } else if g[nr][nc] == 1 and not seen[nr][nc] {
                            seen[nr][nc] = true;
                            queue.push_back((nr, nc));
                        }
                    }
                }
                cells.push(mine);
                threats.push(threat);
                needs.push(need);
            }
        }
        let mut best = -1;
        for id in 0..cells.len() {
            if threats[id].len() > 0 and (best == -1 or threats[id].len() > threats[best].len()) {
                best = id;
            }
        }
        if best == -1 {
            break;
        }
        walls += needs[best];
        for id in 0..cells.len() {
            if id == best {
                for (r, c) in cells[id].iter() {
                    g[*r][*c] = 2;
                }
            } else {
                for (r, c) in threats[id].iter() {
                    g[*r][*c] = 1;
                }
            }
        }
    }
    walls
}

// ---- unionfind arm --------------------------------------------------

fn find_unionfind(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut a = x;
    while parent[a] != a {
        parent[a] = parent[parent[a]];
        a = parent[a];
    }
    a
}

fn contain_virus_unionfind(is_infected: Vec[Vec[i64]]) -> i64 {
    let m = is_infected.len();
    let n = is_infected[0].len();
    let mut g: Vec[i64] = Vec.new();
    for r in 0..m {
        for c in 0..n {
            g.push(is_infected[r][c]);
        }
    }
    let mut walls = 0;
    loop {
        let mut parent: Vec[i64] = Vec.new();
        let mut size: Vec[i64] = Vec.new();
        for i in 0..m * n {
            parent.push(i);
            size.push(1);
        }
        for i in 0..m * n {
            if g[i] != 1 {
                continue;
            }
            let mut others: Vec[i64] = Vec.new();
            if i % n < n - 1 and g[i + 1] == 1 {
                others.push(i + 1);
            }
            if i / n < m - 1 and g[i + n] == 1 {
                others.push(i + n);
            }
            for j in others.iter() {
                let a = find_unionfind(mut parent, i);
                let b = find_unionfind(mut parent, *j);
                if a != b {
                    if size[a] < size[b] {
                        parent[a] = b;
                        size[b] += size[a];
                    } else {
                        parent[b] = a;
                        size[a] += size[b];
                    }
                }
            }
        }
        // the first cell of each set, in reading order
        let mut first: Vec[i64] = Vec.new();
        let mut threat: Vec[i64] = Vec.new();
        let mut need: Vec[i64] = Vec.new();
        for _ in 0..m * n {
            first.push(-1);
            threat.push(0);
            need.push(0);
        }
        for i in 0..m * n {
            if g[i] == 1 {
                let root = find_unionfind(mut parent, i);
                if first[root] == -1 {
                    first[root] = i;
                }
            }
        }
        for i in 0..m * n {
            if g[i] != 0 {
                continue;
            }
            let mut near: Vec[i64] = Vec.new();
            if i / n > 0 and g[i - n] == 1 {
                near.push(find_unionfind(mut parent, i - n));
            }
            if i / n < m - 1 and g[i + n] == 1 {
                near.push(find_unionfind(mut parent, i + n));
            }
            if i % n > 0 and g[i - 1] == 1 {
                near.push(find_unionfind(mut parent, i - 1));
            }
            if i % n < n - 1 and g[i + 1] == 1 {
                near.push(find_unionfind(mut parent, i + 1));
            }
            for k in 0..near.len() {
                need[near[k]] += 1;
                let mut again = false;
                for j in 0..k {
                    if near[j] == near[k] {
                        again = true;
                    }
                }
                if not again {
                    threat[near[k]] += 1;
                }
            }
        }
        let mut best = -1;
        for i in 0..m * n {
            if first[i] != -1 and threat[i] > 0 {
                if best == -1 or threat[i] > threat[best] or (threat[i] == threat[best] and first[i] < first[best]) {
                    best = i;
                }
            }
        }
        if best == -1 {
            break;
        }
        walls += need[best];
        let mut next = g.clone();
        for i in 0..m * n {
            if g[i] == 1 {
                if find_unionfind(mut parent, i) == best {
                    next[i] = 2;
                }
            } else if g[i] == 0 {
                let mut caught = false;
                if i / n > 0 and g[i - n] == 1 and find_unionfind(mut parent, i - n) != best {
                    caught = true;
                }
                if i / n < m - 1 and g[i + n] == 1 and find_unionfind(mut parent, i + n) != best {
                    caught = true;
                }
                if i % n > 0 and g[i - 1] == 1 and find_unionfind(mut parent, i - 1) != best {
                    caught = true;
                }
                if i % n < n - 1 and g[i + 1] == 1 and find_unionfind(mut parent, i + 1) != best {
                    caught = true;
                }
                if caught {
                    next[i] = 1;
                }
            }
        }
        g = next;
    }
    walls
}

// ---- recur arm ------------------------------------------------------

fn visit_recur(g: ref Vec[Vec[i64]], seen: mut ref Vec[Vec[bool]], r: i64, c: i64, mine: mut ref Vec[(i64, i64)], touched: mut ref Vec[i64]) {
    let m = g.len();
    let n = g[0].len();
    if r < 0 or r >= m or c < 0 or c >= n {
        return;
    }
    if g[r][c] == 0 {
        touched.push(r * n + c);
        return;
    }
    if g[r][c] != 1 or seen[r][c] {
        return;
    }
    seen[r][c] = true;
    mine.push((r, c));
    visit_recur(g, mut seen, r - 1, c, mut mine, mut touched);
    visit_recur(g, mut seen, r + 1, c, mut mine, mut touched);
    visit_recur(g, mut seen, r, c - 1, mut mine, mut touched);
    visit_recur(g, mut seen, r, c + 1, mut mine, mut touched);
}

fn contain_virus_recur(is_infected: Vec[Vec[i64]]) -> i64 {
    let m = is_infected.len();
    let n = is_infected[0].len();
    let mut g = is_infected.clone();
    let mut walls = 0;
    loop {
        let mut seen: Vec[Vec[bool]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[bool] = Vec.new();
            for _ in 0..n {
                row.push(false);
            }
            seen.push(row);
        }
        let mut cells: Vec[Vec[(i64, i64)]] = Vec.new();
        let mut threats: Vec[Vec[i64]] = Vec.new();
        let mut needs: Vec[i64] = Vec.new();
        for r in 0..m {
            for c in 0..n {
                if g[r][c] == 1 and not seen[r][c] {
                    let mut mine: Vec[(i64, i64)] = Vec.new();
                    let mut touched: Vec[i64] = Vec.new();
                    visit_recur(g, mut seen, r, c, mut mine, mut touched);
                    needs.push(touched.len());
                    touched.sort();
                    touched.dedup();
                    cells.push(mine);
                    threats.push(touched);
                }
            }
        }
        let mut best = -1;
        for id in 0..cells.len() {
            if threats[id].len() > 0 and (best == -1 or threats[id].len() > threats[best].len()) {
                best = id;
            }
        }
        if best == -1 {
            break;
        }
        walls += needs[best];
        for id in 0..cells.len() {
            if id == best {
                for (r, c) in cells[id].iter() {
                    g[*r][*c] = 2;
                }
            } else {
                for x in threats[id].iter() {
                    g[*x / n][*x % n] = 1;
                }
            }
        }
    }
    walls
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, grid: Vec[Vec[i64]]) -> i64 {
    if which == 0 {
        contain_virus_star(grid)
    } else if which == 1 {
        contain_virus_sets(grid)
    } else if which == 2 {
        contain_virus_unionfind(grid)
    } else {
        contain_virus_recur(grid)
    }
}

fn near(g: Vec[Vec[i64]], r: i64, c: i64) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
        if r + dr >= 0 and r + dr < g.len() and c + dc >= 0 and c + dc < g[0].len() {
            out.push((r + dr, c + dc));
        }
    }
    out
}

// The definition, as the problem states it, day by day. Every infected
// cell starts labelled with its own place in reading order, and labels
// fall to the least among infected neighbours until none changes, so
// each region carries its first cell's place. The region threatening
// the most clean cells (counted from each clean cell, so each once) is
// walled, one wall for each side it shares with a clean cell, the
// earliest such region on a tie; every clean cell next to any other
// region is infected. `tied` is set if any day had a tie.
fn definition(grid: Vec[Vec[i64]], tied: mut ref bool) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut g = grid.clone();
    let mut walls = 0;
    loop {
        let mut label: Vec[Vec[i64]] = Vec.new();
        for r in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for c in 0..n {
                row.push(if g[r][c] == 1 { r * n + c } else { -1 });
            }
            label.push(row);
        }
        let mut changed = true;
        while changed {
            changed = false;
            for r in 0..m {
                for c in 0..n {
                    if g[r][c] != 1 {
                        continue;
                    }
                    for (a, b) in near(g, r, c).iter() {
                        if g[*a][*b] == 1 and label[*a][*b] < label[r][c] {
                            label[r][c] = label[*a][*b];
                            changed = true;
                        }
                    }
                }
            }
        }
        let mut best = -1;
        let mut most = 0;
        for l in 0..m * n {
            let mut threat = 0;
            for r in 0..m {
                for c in 0..n {
                    if g[r][c] != 0 {
                        continue;
                    }
                    let mut touches = false;
                    for (a, b) in near(g, r, c).iter() {
                        if g[*a][*b] == 1 and label[*a][*b] == l {
                            touches = true;
                        }
                    }
                    if touches {
                        threat += 1;
                    }
                }
            }
            if threat > 0 and threat == most {
                *tied = true;
            }
            if threat > most {
                most = threat;
                best = l;
            }
        }
        if best == -1 {
            break;
        }
        let mut next = g.clone();
        for r in 0..m {
            for c in 0..n {
                if g[r][c] == 1 and label[r][c] == best {
                    next[r][c] = 2;
                    for (a, b) in near(g, r, c).iter() {
                        if g[*a][*b] == 0 {
                            walls += 1;
                        }
                    }
                } else if g[r][c] == 0 {
                    for (a, b) in near(g, r, c).iter() {
                        if g[*a][*b] == 1 and label[*a][*b] != best {
                            next[r][c] = 1;
                        }
                    }
                }
            }
        }
        g = next;
    }
    walls
}

fn main() {
    let mut seed = 7490;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut total = 0;
    let mut untied = 0;
    let cases = 3000;
    for _ in 0..cases {
        // 1 to 6 rows of 1 to 6 cells, each infected with a chance of
        // 5 to 50 in 100
        let m = 1 + next_random(mut seed) % 6;
        let n = 1 + next_random(mut seed) % 6;
        let percent = 5 + next_random(mut seed) % 46;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(if next_random(mut seed) % 100 < percent { 1 } else { 0 });
            }
            grid.push(row);
        }
        let mut tied = false;
        let want = definition(grid, mut tied);
        total += want;
        if not tied {
            untied += 1;
        }
        let mut flipped: Vec[Vec[i64]] = Vec.new();
        let mut mirrored: Vec[Vec[i64]] = Vec.new();
        let mut turned: Vec[Vec[i64]] = Vec.new();
        for c in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for r in 0..m {
                row.push(grid[r][c]);
            }
            flipped.push(row);
        }
        for r in 0..m {
            let mut row: Vec[i64] = Vec.new();
            let mut back: Vec[i64] = Vec.new();
            for c in 0..n {
                row.push(grid[r][n - 1 - c]);
                back.push(grid[m - 1 - r][n - 1 - c]);
            }
            mirrored.push(row);
            turned.push(back);
        }
        for which in 0..arms {
            let got = answer_with(which, grid);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2 to P4 only where no day had a tie, as LeetCode promises:
            // a tie is broken by reading order, which these change.
            if tied {
                continue;
            }
            // P2: the grid transposed, the same answer.
            checks += 1;
            if answer_with(which, flipped) != got {
                fails[1] += 1;
            }
            // P3: every row reversed, the same answer.
            checks += 1;
            if answer_with(which, mirrored) != got {
                fails[2] += 1;
            }
            // P4: the grid turned half round, the same answer.
            checks += 1;
            if answer_with(which, turned) != got {
                fails[3] += 1;
            }
        }
    }
    let mut failures = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        failures += fails[i];
    }
    println(f"{cases} grids ({untied} with no tie, walls {total} in all), {arms} arms, {checks} checks, {failures} failures");
}
