// LeetCode 749 — Contain Virus, recursive search.
//
// The star arm's day with a recursive depth-first search for each
// region. The clean cells a region touches are collected with repeats,
// one for each side, so their number is the walls it needs; sorted and
// with repeats removed, they are the cells it threatens.

fn visit(g: ref Vec[Vec[i64]], seen: mut ref Vec[Vec[bool]], r: i64, c: i64, mine: mut ref Vec[(i64, i64)], touched: mut ref Vec[i64]) {
    let m = g.len();
    let n = g[0].len();
    if r < 0 or r >= m or c < 0 or c >= n {
        return;
    }
    if g[r][c] == 0 {
        touched.push(r * n + c);
        return;
    }
    if g[r][c] != 1 or seen[r][c] {
        return;
    }
    seen[r][c] = true;
    mine.push((r, c));
    visit(g, mut seen, r - 1, c, mut mine, mut touched);
    visit(g, mut seen, r + 1, c, mut mine, mut touched);
    visit(g, mut seen, r, c - 1, mut mine, mut touched);
    visit(g, mut seen, r, c + 1, mut mine, mut touched);
}

fn contain_virus(is_infected: Vec[Vec[i64]]) -> i64 {
    let m = is_infected.len();
    let n = is_infected[0].len();
    let mut g = is_infected.clone();
    let mut walls = 0;
    loop {
        let mut seen: Vec[Vec[bool]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[bool] = Vec.new();
            for _ in 0..n {
                row.push(false);
            }
            seen.push(row);
        }
        let mut cells: Vec[Vec[(i64, i64)]] = Vec.new();
        let mut threats: Vec[Vec[i64]] = Vec.new();
        let mut needs: Vec[i64] = Vec.new();
        for r in 0..m {
            for c in 0..n {
                if g[r][c] == 1 and not seen[r][c] {
                    let mut mine: Vec[(i64, i64)] = Vec.new();
                    let mut touched: Vec[i64] = Vec.new();
                    visit(g, mut seen, r, c, mut mine, mut touched);
                    needs.push(touched.len());
                    touched.sort();
                    touched.dedup();
                    cells.push(mine);
                    threats.push(touched);
                }
            }
        }
        let mut best = -1;
        for id in 0..cells.len() {
            if threats[id].len() > 0 and (best == -1 or threats[id].len() > threats[best].len()) {
                best = id;
            }
        }
        if best == -1 {
            break;
        }
        walls += needs[best];
        for id in 0..cells.len() {
            if id == best {
                for (r, c) in cells[id].iter() {
                    g[*r][*c] = 2;
                }
            } else {
                for x in threats[id].iter() {
                    g[*x / n][*x % n] = 1;
                }
            }
        }
    }
    walls
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(text: String) {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for row in text.split("/") {
        let mut cells: Vec[i64] = Vec.new();
        for c in row.chars() {
            cells.push(if c == '1' { 1 } else { 0 });
        }
        grid.push(cells);
    }
    println(f"{text} -> {contain_virus(grid)}");
}

// An m x n grid in which each cell is infected with chance
// `percent` in 100.
fn random_grid(seed: mut ref i64, m: i64, n: i64, percent: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < percent { 1 } else { 0 });
        }
        grid.push(row);
    }
    grid
}

fn main() {
    show(String.from("01000001/01000001/00000001/00000000"));
    show(String.from("111/101/111"));
    show(String.from("111000000/101011111/111000000"));
    show(String.from("0"));
    show(String.from("1"));
    show(String.from("10"));
    show(String.from("1111/1111"));
    show(String.from("1000/0000/0000/0001"));
    show(String.from("10101/01010/10101"));
    show(String.from("00000/00100/00000"));

    let mut seed = 749;
    for percent in [1, 3, 10, 30] {
        let grid = random_grid(mut seed, 50, 50, percent);
        println(f"50 x 50, {percent}% infected: {contain_virus(grid)} walls");
    }

    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let m = 1 + next_random(mut seed) % 8;
        let n = 1 + next_random(mut seed) % 8;
        let percent = 5 + next_random(mut seed) % 40;
        let grid = random_grid(mut seed, m, n, percent);
        let w = contain_virus(grid);
        total += w;
        check = (check * 31 + w) % 1000000007;
    }
    println(f"300 random grids: {total} walls in all, checksum {check}");
}
