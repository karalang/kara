// LeetCode #742: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random trees.

// ---- ★ arm ----------------------------------------------------------

struct Node {
    val: i64,
    mut left: i64,
    mut right: i64,
}

fn find_closest_leaf_star(nodes: Vec[Node], k: i64) -> i64 {
    let n = nodes.len();
    let mut parent: Vec[i64] = Vec.new();
    let mut start = 0;
    for i in 0..n {
        parent.push(-1);
        if nodes[i].val == k {
            start = i;
        }
    }
    for i in 0..n {
        if nodes[i].left != -1 {
            parent[nodes[i].left] = i;
        }
        if nodes[i].right != -1 {
            parent[nodes[i].right] = i;
        }
    }
    let mut seen: Vec[bool] = Vec.new();
    for _ in 0..n {
        seen.push(false);
    }
    seen[start] = true;
    let mut layer: Vec[i64] = [start];
    loop {
        let mut best = -1;
        for x in layer.iter() {
            let node = ref nodes[*x];
            if node.left == -1 and node.right == -1 and (best == -1 or node.val < best) {
                best = node.val;
            }
        }
        if best != -1 {
            return best;
        }
        let mut next: Vec[i64] = Vec.new();
        for x in layer.iter() {
            for y in [nodes[*x].left, nodes[*x].right, parent[*x]] {
                if y != -1 and not seen[y] {
                    seen[y] = true;
                    next.push(y);
                }
            }
        }
        layer = next;
    }
}

// ---- down arm -------------------------------------------------------

// The nearest leaf below node i, as (distance, value), for every node.
fn below_down(nodes: Vec[Node], i: i64, near: mut ref Vec[(i64, i64)]) {
    let node = ref nodes[i];
    if node.left == -1 and node.right == -1 {
        near[i] = (0, node.val);
        return;
    }
    let mut best = (1000000, 0);
    for c in [node.left, node.right] {
        if c != -1 {
            below_down(nodes, c, mut near);
            let got = (near[c].0 + 1, near[c].1);
            if got < best {
                best = got;
            }
        }
    }
    near[i] = best;
}

// The path from node i down to the node holding k, appended to `path`;
// false when k is not below i.
fn path_to_down(nodes: Vec[Node], i: i64, k: i64, path: mut ref Vec[i64]) -> bool {
    if i == -1 {
        return false;
    }
    path.push(i);
    if nodes[i].val == k or path_to_down(nodes, nodes[i].left, k, mut path) or path_to_down(nodes, nodes[i].right, k, mut path) {
        return true;
    }
    path.pop();
    false
}

fn find_closest_leaf_down(nodes: Vec[Node], k: i64) -> i64 {
    let mut near: Vec[(i64, i64)] = Vec.new();
    for _ in 0..nodes.len() {
        near.push((0, 0));
    }
    below_down(nodes, 0, mut near);
    let mut path: Vec[i64] = Vec.new();
    path_to_down(nodes, 0, k, mut path);
    let mut best = (1000000, 0);
    let last = path.len() - 1;
    for j in 0..path.len() {
        let a = path[j];
        let got = (last - j + near[a].0, near[a].1);
        if got < best {
            best = got;
        }
    }
    best.1
}

// ---- lca arm --------------------------------------------------------

fn find_closest_leaf_lca(nodes: Vec[Node], k: i64) -> i64 {
    let n = nodes.len();
    let mut parent: Vec[i64] = Vec.new();
    let mut depth: Vec[i64] = Vec.new();
    for _ in 0..n {
        parent.push(-1);
        depth.push(0);
    }
    // nodes come in level order, so a parent is always before its
    // children
    let mut start = 0;
    for i in 0..n {
        if nodes[i].val == k {
            start = i;
        }
        for c in [nodes[i].left, nodes[i].right] {
            if c != -1 {
                parent[c] = i;
                depth[c] = depth[i] + 1;
            }
        }
    }
    let mut best_distance = n + 1;
    let mut best = 0;
    for leaf in 0..n {
        if nodes[leaf].left != -1 or nodes[leaf].right != -1 {
            continue;
        }
        let mut a = start;
        let mut b = leaf;
        while depth[a] > depth[b] {
            a = parent[a];
        }
        while depth[b] > depth[a] {
            b = parent[b];
        }
        while a != b {
            a = parent[a];
            b = parent[b];
        }
        let distance = depth[start] + depth[leaf] - 2 * depth[a];
        if distance < best_distance or (distance == best_distance and nodes[leaf].val < best) {
            best_distance = distance;
            best = nodes[leaf].val;
        }
    }
    best
}

// ---- enum arm -------------------------------------------------------

shared enum Tree {
    Empty,
    Branch(i64, Tree, Tree),
}

fn grow_enum(nodes: Vec[Node], i: i64) -> Tree {
    if i == -1 {
        return Tree.Empty;
    }
    Tree.Branch(nodes[i].val, grow_enum(nodes, nodes[i].left), grow_enum(nodes, nodes[i].right))
}

// Returns (distance to the nearest leaf below, its value, distance from
// k up to this root or -1 when k is not inside), updating `best` with
// every candidate.
fn walk_enum(tree: Tree, k: i64, best: mut ref (i64, i64)) -> (i64, i64, i64) {
    match tree {
        Tree.Empty => (1000000, 0, -1),
        Tree.Branch(val, left, right) => {
            let l = walk_enum(left, k, mut best);
            let r = walk_enum(right, k, mut best);
            let mut down = (0, val);
            if l.0 < 1000000 or r.0 < 1000000 {
                down = if (l.0, l.1) <= (r.0, r.1) { (l.0 + 1, l.1) } else { (r.0 + 1, r.1) };
            }
            let mut up = -1;
            if val == k {
                up = 0;
                if down < *best {
                    *best = down;
                }
            } else if l.2 >= 0 {
                up = l.2 + 1;
                let other = (up + r.0 + 1, r.1);
                if r.0 < 1000000 and other < *best {
                    *best = other;
                }
            } else if r.2 >= 0 {
                up = r.2 + 1;
                let other = (up + l.0 + 1, l.1);
                if l.0 < 1000000 and other < *best {
                    *best = other;
                }
            }
            (down.0, down.1, up)
        }
    }
}

fn find_closest_leaf_enum(nodes: Vec[Node], k: i64) -> i64 {
    let mut best = (1000000, 0);
    walk_enum(grow_enum(nodes, 0), k, mut best);
    best.1
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, nodes: Vec[Node], k: i64) -> i64 {
    if which == 0 {
        find_closest_leaf_star(nodes, k)
    } else if which == 1 {
        find_closest_leaf_down(nodes, k)
    } else if which == 2 {
        find_closest_leaf_lca(nodes, k)
    } else {
        find_closest_leaf_enum(nodes, k)
    }
}

// A random tree of n nodes, each added as a child of an earlier node
// with a free place, valued by a random order of 1 to n.
fn random_tree(seed: mut ref i64, n: i64) -> Vec[Node] {
    let mut values: Vec[i64] = Vec.new();
    for v in 1..n + 1 {
        values.push(v);
    }
    for i in 0..n {
        let j = i + next_random(mut seed) % (n - i);
        let t = values[i];
        values[i] = values[j];
        values[j] = t;
    }
    let mut nodes: Vec[Node] = Vec.new();
    nodes.push(Node { val: values[0], left: -1, right: -1 });
    for i in 1..n {
        loop {
            let p = next_random(mut seed) % i;
            if next_random(mut seed) % 2 == 0 {
                if nodes[p].left == -1 {
                    nodes[p].left = i;
                    break;
                }
            } else if nodes[p].right == -1 {
                nodes[p].right = i;
                break;
            }
        }
        nodes.push(Node { val: values[i], left: -1, right: -1 });
    }
    nodes
}

fn copy_of(nodes: Vec[Node]) -> Vec[Node] {
    let mut out: Vec[Node] = Vec.new();
    for x in nodes.iter() {
        out.push(Node { val: x.val, left: x.left, right: x.right });
    }
    out
}

// The definition, as the problem states it: the leaf with the fewest
// edges between it and k. Mark every parent and child one edge apart,
// find every distance by Floyd and Warshall's triple loop, and take
// the nearest leaf, the smaller value on a tie.
fn definition(nodes: Vec[Node], k: i64) -> i64 {
    let n = nodes.len();
    let far = 1000;
    let mut d: Vec[Vec[i64]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..n {
            row.push(if i == j { 0 } else { far });
        }
        d.push(row);
    }
    for i in 0..n {
        for c in [nodes[i].left, nodes[i].right] {
            if c != -1 {
                d[i][c] = 1;
                d[c][i] = 1;
            }
        }
    }
    for m in 0..n {
        for i in 0..n {
            for j in 0..n {
                if d[i][m] + d[m][j] < d[i][j] {
                    d[i][j] = d[i][m] + d[m][j];
                }
            }
        }
    }
    let mut start = 0;
    for i in 0..n {
        if nodes[i].val == k {
            start = i;
        }
    }
    let mut best = far;
    let mut answer = 0;
    for i in 0..n {
        if nodes[i].left == -1 and nodes[i].right == -1 {
            if d[start][i] < best or (d[start][i] == best and nodes[i].val < answer) {
                best = d[start][i];
                answer = nodes[i].val;
            }
        }
    }
    answer
}

fn main() {
    let mut seed = 7420;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut leaf_k = 0;
    let cases = 3000;
    for _ in 0..cases {
        let n = 1 + next_random(mut seed) % 15;
        let nodes = random_tree(mut seed, n);
        let k = 1 + next_random(mut seed) % n;
        let want = definition(nodes, k);
        if want == k {
            leaf_k += 1;
        }
        // every node's two children swapped
        let mut mirrored = copy_of(nodes);
        for i in 0..n {
            let t = mirrored[i].left;
            mirrored[i].left = mirrored[i].right;
            mirrored[i].right = t;
        }
        // every value v made 2v + 1, which keeps their order
        let mut relabelled = copy_of(nodes);
        for i in 0..n {
            relabelled[i].val = 2 * relabelled[i].val + 1;
        }
        // when k has one child and so a free place, a leaf of value 100
        // hung there; `leaf_child` is the smaller value of a leaf child
        // of k, or -1
        let mut at = 0;
        for i in 0..n {
            if nodes[i].val == k {
                at = i;
            }
        }
        let one_child = (nodes[at].left == -1) != (nodes[at].right == -1);
        let mut leaf_child = -1;
        for c in [nodes[at].left, nodes[at].right] {
            if c != -1 and nodes[c].left == -1 and nodes[c].right == -1 {
                if leaf_child == -1 or nodes[c].val < leaf_child {
                    leaf_child = nodes[c].val;
                }
            }
        }
        let mut hung = copy_of(nodes);
        hung.push(Node { val: 100, left: -1, right: -1 });
        if hung[at].left == -1 {
            hung[at].left = n;
        } else {
            hung[at].right = n;
        }
        for which in 0..arms {
            let got = answer_with(which, nodes, k);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the mirrored tree, the same answer.
            checks += 1;
            if answer_with(which, mirrored, k) != got {
                fails[1] += 1;
            }
            // P3: the values renamed in the same order, the answer
            // renamed the same way.
            checks += 1;
            if answer_with(which, relabelled, 2 * k + 1) != 2 * got + 1 {
                fails[2] += 1;
            }
            // P4: a new leaf hung below k is the answer exactly when no
            // leaf was next to k; otherwise the answer stays.
            if one_child {
                checks += 1;
                let expect = if leaf_child == -1 { 100 } else { got };
                if answer_with(which, hung, k) != expect {
                    fails[3] += 1;
                }
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{cases} trees ({leaf_k} with k a leaf), {arms} arms, {checks} checks, {total} failures");
}
