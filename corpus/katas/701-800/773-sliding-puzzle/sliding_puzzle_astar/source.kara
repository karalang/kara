// LeetCode 773 — Sliding Puzzle, A* search.
//
// A board is the integer its six digits spell. Take states from a
// min-heap in order of moves made plus the tiles' total Manhattan
// distance from home, which never overestimates and drops by at most one
// a move, so the first time 123450 leaves the heap its moves are fewest.
// An unsolvable board empties the heap after its 360 reachable states.

fn power_of_ten(p: i64) -> i64 {
    let mut result = 1;
    for _ in 0..p {
        result *= 10;
    }
    result
}

fn digit(state: i64, p: i64) -> i64 {
    state / power_of_ten(5 - p) % 10
}

// The sum over tiles 1 to 5 of rows plus columns from home, tile t's
// home being cell t - 1.
fn manhattan(state: i64) -> i64 {
    let mut total = 0;
    for p in 0..6 {
        let tile = digit(state, p);
        if tile != 0 {
            total += (p / 3 - (tile - 1) / 3).abs() + (p % 3 - (tile - 1) % 3).abs();
        }
    }
    total
}

fn sliding_puzzle(board: Vec[Vec[i64]]) -> i64 {
    let neighbours: Vec[Vec[i64]] = [[1, 3], [0, 2, 4], [1, 5], [0, 4], [1, 3, 5], [2, 4]];
    let mut start = 0;
    for row in board {
        for x in row {
            start = start * 10 + *x;
        }
    }
    let mut best: Map[i64, i64] = Map.new();
    best.insert(start, 0);
    let mut heap: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    heap.push((manhattan(start), 0, start));
    while let Some((_, made, state)) = heap.pop() {
        if state == 123450 {
            return made;
        }
        if made > (best.get(state) ?? 0) {
            continue;
        }
        let mut zero = 0;
        while digit(state, zero) != 0 {
            zero += 1;
        }
        for next in neighbours[zero] {
            let tile = digit(state, *next);
            let moved = state + tile * power_of_ten(5 - zero) - tile * power_of_ten(5 - *next);
            let known = best.get(moved) ?? -1;
            if known < 0 or made + 1 < known {
                best.insert(moved, made + 1);
                heap.push((made + 1 + manhattan(moved), made + 1, moved));
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn show(board: Vec[Vec[i64]]) {
    let answer = sliding_puzzle(board);
    println(f"{board} -> {answer}");
}

// The next order of `cells` in dictionary order; false after the last.
fn next_order(cells: mut ref Vec[i64]) -> bool {
    let mut i = cells.len() - 2;
    while i >= 0 and cells[i] >= cells[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = cells.len() - 1;
    while cells[j] <= cells[i] {
        j -= 1;
    }
    cells.swap(i, j);
    let mut lo = i + 1;
    let mut hi = cells.len() - 1;
    while lo < hi {
        cells.swap(lo, hi);
        lo += 1;
        hi -= 1;
    }
    true
}

fn main() {
    show([[1, 2, 3], [4, 0, 5]]);
    show([[1, 2, 3], [5, 4, 0]]);
    show([[4, 1, 2], [5, 0, 3]]);
    show([[1, 2, 3], [4, 5, 0]]);
    show([[3, 2, 4], [1, 5, 0]]);
    show([[0, 1, 2], [3, 4, 5]]);
    let mut cells: Vec[i64] = [0, 1, 2, 3, 4, 5];
    let mut boards = 0;
    let mut solvable = 0;
    let mut total = 0;
    let mut most = 0;
    let mut check = 0;
    loop {
        let board = [[cells[0], cells[1], cells[2]], [cells[3], cells[4], cells[5]]];
        let answer = sliding_puzzle(board);
        boards += 1;
        if answer >= 0 {
            solvable += 1;
            total += answer;
            if answer > most {
                most = answer;
            }
        }
        check = (check * 31 + answer + 1) % 1000000007;
        if not next_order(mut cells) {
            break;
        }
    }
    println(f"all {boards} boards: {solvable} solvable, {total} moves in all, at most {most}, checksum {check}");
}
