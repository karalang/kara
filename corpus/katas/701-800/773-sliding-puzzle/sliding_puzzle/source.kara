// LeetCode 773 — Sliding Puzzle, breadth-first search over strings.
//
// Write the board as six digits, row by row, and search outward from it,
// each step swapping the 0 with a neighbouring cell. The first time
// "123450" leaves the queue its distance is the answer; if the queue
// empties first, the board cannot be solved. At most 6! = 720 states.

fn sliding_puzzle(board: Vec[Vec[i64]]) -> i64 {
    let neighbours: Vec[Vec[i64]] = [[1, 3], [0, 2, 4], [1, 5], [0, 4], [1, 3, 5], [2, 4]];
    let mut start = String.new();
    for row in board {
        for x in row {
            start.push((48 + *x) as u8 as char);
        }
    }
    let mut seen: Set[String] = Set.new();
    seen.insert(start.clone());
    let mut queue: VecDeque[(String, i64)] = VecDeque.new();
    queue.push_back((start, 0));
    loop {
        match queue.pop_front() {
            None => return -1,
            Some((state, steps)) => {
                if state == "123450" {
                    return steps;
                }
                let bytes = state.bytes().to_vec();
                let mut zero = 0;
                while bytes[zero] != b'0' {
                    zero += 1;
                }
                for next in neighbours[zero] {
                    let mut moved = bytes.clone();
                    moved.swap(zero, *next);
                    let text = String.from_utf8(moved).unwrap();
                    if not seen.contains(text) {
                        seen.insert(text.clone());
                        queue.push_back((text, steps + 1));
                    }
                }
            }
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn show(board: Vec[Vec[i64]]) {
    let answer = sliding_puzzle(board);
    println(f"{board} -> {answer}");
}

// The next order of `cells` in dictionary order; false after the last.
fn next_order(cells: mut ref Vec[i64]) -> bool {
    let mut i = cells.len() - 2;
    while i >= 0 and cells[i] >= cells[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = cells.len() - 1;
    while cells[j] <= cells[i] {
        j -= 1;
    }
    cells.swap(i, j);
    let mut lo = i + 1;
    let mut hi = cells.len() - 1;
    while lo < hi {
        cells.swap(lo, hi);
        lo += 1;
        hi -= 1;
    }
    true
}

fn main() {
    show([[1, 2, 3], [4, 0, 5]]);
    show([[1, 2, 3], [5, 4, 0]]);
    show([[4, 1, 2], [5, 0, 3]]);
    show([[1, 2, 3], [4, 5, 0]]);
    show([[3, 2, 4], [1, 5, 0]]);
    show([[0, 1, 2], [3, 4, 5]]);
    let mut cells: Vec[i64] = [0, 1, 2, 3, 4, 5];
    let mut boards = 0;
    let mut solvable = 0;
    let mut total = 0;
    let mut most = 0;
    let mut check = 0;
    loop {
        let board = [[cells[0], cells[1], cells[2]], [cells[3], cells[4], cells[5]]];
        let answer = sliding_puzzle(board);
        boards += 1;
        if answer >= 0 {
            solvable += 1;
            total += answer;
            if answer > most {
                most = answer;
            }
        }
        check = (check * 31 + answer + 1) % 1000000007;
        if not next_order(mut cells) {
            break;
        }
    }
    println(f"all {boards} boards: {solvable} solvable, {total} moves in all, at most {most}, checksum {check}");
}
