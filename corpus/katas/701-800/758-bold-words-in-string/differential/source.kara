// LeetCode #758: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random strings.

// ---- ★ arm ----------------------------------------------------------

fn bold_words_star(words: Vec[String], s: String) -> String {
    let n = s.len();
    let mut bold: Vec[bool] = Vec.new();
    for _ in 0..n {
        bold.push(false);
    }
    for word in words.iter() {
        let mut from = 0;
        while from < n {
            match s[from..].find(word.clone()) {
                Some(at) => {
                    for i in from + at..from + at + word.len() {
                        bold[i] = true;
                    }
                    from = from + at + 1;
                }
                None => break,
            }
        }
    }
    let mut out = String.new();
    let chars: Vec[char] = s.chars().collect();
    for i in 0..n {
        if bold[i] and (i == 0 or not bold[i - 1]) {
            out.push_str("<b>");
        }
        out.push(chars[i]);
        if bold[i] and (i == n - 1 or not bold[i + 1]) {
            out.push_str("</b>");
        }
    }
    out
}

// ---- automaton arm --------------------------------------------------

fn bold_words_automaton(words: Vec[String], s: String) -> String {
    let mut next: Vec[i64] = Vec.new();
    let mut longest: Vec[i64] = Vec.new();
    for _ in 0..26 {
        next.push(-1);
    }
    longest.push(0);
    for word in words.iter() {
        let mut node = 0;
        for c in word.bytes() {
            let slot = node * 26 + (c - b'a') as i64;
            if next[slot] < 0 {
                next[slot] = longest.len();
                longest.push(0);
                for _ in 0..26 {
                    next.push(-1);
                }
            }
            node = next[slot];
        }
        if word.len() > longest[node] {
            longest[node] = word.len();
        }
    }
    let mut fail: Vec[i64] = Vec.new();
    for _ in 0..longest.len() {
        fail.push(0);
    }
    let mut queue: Vec[i64] = Vec.new();
    for c in 0..26 {
        if next[c] < 0 {
            next[c] = 0;
        } else {
            queue.push(next[c]);
        }
    }
    let mut head = 0;
    while head < queue.len() {
        let node = queue[head];
        head += 1;
        if longest[fail[node]] > longest[node] {
            longest[node] = longest[fail[node]];
        }
        for c in 0..26 {
            let child = next[node * 26 + c];
            if child < 0 {
                next[node * 26 + c] = next[fail[node] * 26 + c];
            } else {
                fail[child] = next[fail[node] * 26 + c];
                queue.push(child);
            }
        }
    }
    let n = s.len();
    let mut bold: Vec[bool] = Vec.new();
    for _ in 0..n {
        bold.push(false);
    }
    let mut state = 0;
    let bytes = s.bytes();
    for i in 0..n {
        state = next[state * 26 + (bytes[i] - b'a') as i64];
        let mut j = i;
        while j > i - longest[state] {
            bold[j] = true;
            j -= 1;
        }
    }
    let mut out = String.new();
    for i in 0..n {
        if bold[i] and (i == 0 or not bold[i - 1]) {
            out.push_str("<b>");
        }
        out.push(bytes[i] as char);
        if bold[i] and (i == n - 1 or not bold[i + 1]) {
            out.push_str("</b>");
        }
    }
    out
}

// ---- hashing arm ----------------------------------------------------

fn bold_words_hashing(words: Vec[String], s: String) -> String {
    let modulus = 1000000007;
    let base = 131;
    let n = s.len();
    let bytes = s.bytes();
    let mut bold: Vec[bool] = Vec.new();
    for _ in 0..n {
        bold.push(false);
    }
    let mut lengths: Set[i64] = Set.new();
    let mut known: Set[String] = Set.new();
    for word in words.iter() {
        lengths.insert(word.len());
        known.insert(word.clone());
    }
    for size in lengths.iter() {
        let size = *size;
        if size > n {
            continue;
        }
        let mut hashes: Set[i64] = Set.new();
        for word in words.iter() {
            if word.len() == size {
                let mut h = 0;
                for c in word.bytes() {
                    h = (h * base + c as i64) % modulus;
                }
                hashes.insert(h);
            }
        }
        // base^(size - 1), to take the leaving character out of the hash
        let mut high = 1;
        for _ in 0..size - 1 {
            high = high * base % modulus;
        }
        let mut h = 0;
        for i in 0..n {
            if i >= size {
                h = (h - bytes[i - size] as i64 * high % modulus + modulus) % modulus;
            }
            h = (h * base + bytes[i] as i64) % modulus;
            if i + 1 >= size and hashes.contains(h) {
                let start = i + 1 - size;
                if known.contains(s[start..i + 1].to_string()) {
                    for j in start..i + 1 {
                        bold[j] = true;
                    }
                }
            }
        }
    }
    let mut out = String.new();
    for i in 0..n {
        if bold[i] and (i == 0 or not bold[i - 1]) {
            out.push_str("<b>");
        }
        out.push(bytes[i] as char);
        if bold[i] and (i == n - 1 or not bold[i + 1]) {
            out.push_str("</b>");
        }
    }
    out
}

// ---- reach arm ------------------------------------------------------

fn bold_words_reach(words: Vec[String], s: String) -> String {
    let mut known: Set[String] = Set.new();
    let mut longest = 0;
    for word in words.iter() {
        known.insert(word.clone());
        if word.len() > longest {
            longest = word.len();
        }
    }
    let n = s.len();
    let mut out = String.new();
    let mut reach = 0;
    let mut open = false;
    for i in 0..n {
        for size in 1..longest + 1 {
            if i + size <= n and i + size > reach and known.contains(s[i..i + size].to_string()) {
                reach = i + size;
            }
        }
        if i < reach and not open {
            out.push_str("<b>");
            open = true;
        } else if i >= reach and open {
            out.push_str("</b>");
            open = false;
        }
        out.push_str(s[i..i + 1]);
    }
    if open {
        out.push_str("</b>");
    }
    out
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, words: Vec[String], s: String) -> String {
    if which == 0 {
        bold_words_star(words, s)
    } else if which == 1 {
        bold_words_automaton(words, s)
    } else if which == 2 {
        bold_words_hashing(words, s)
    } else {
        bold_words_reach(words, s)
    }
}

fn random_text(seed: mut ref i64, length: i64, letters: i64) -> String {
    let mut text = String.new();
    for _ in 0..length {
        text.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    text
}

// The definition: a character is bold when some word, placed at some
// start at or before it, matches `s` letter by letter and covers it.
// Tags then open before the first bold character of each run and close
// after its last.
fn definition(words: ref Vec[String], s: ref String) -> String {
    let b = s.bytes();
    let n = b.len();
    let mut out = String.new();
    let mut before = false;
    for i in 0..n {
        let mut bold = false;
        for word in words.iter() {
            let w = word.bytes();
            for start in 0..i + 1 {
                if start + w.len() > i and start + w.len() <= n {
                    let mut same = true;
                    for k in 0..w.len() {
                        if b[start + k] != w[k] {
                            same = false;
                        }
                    }
                    if same {
                        bold = true;
                    }
                }
            }
        }
        if bold and not before {
            out.push_str("<b>");
        }
        if before and not bold {
            out.push_str("</b>");
        }
        out.push(b[i] as char);
        before = bold;
    }
    if before {
        out.push_str("</b>");
    }
    out
}

// The text with its tags taken out, which characters were inside tags,
// and whether the tags alternate open and close with nothing empty
// between them and no run closed right where the next opens.
fn parse(answer: ref String) -> (String, Vec[bool], bool) {
    let b = answer.bytes();
    let mut text = String.new();
    let mut marks: Vec[bool] = Vec.new();
    let mut open = false;
    let mut good = true;
    let mut i = 0;
    let mut last_tag = -10;
    while i < b.len() {
        if b[i] == b'<' {
            if i + 3 <= b.len() and answer[i..i + 3] == "<b>" {
                if open or last_tag == i {
                    good = false;
                }
                open = true;
                i += 3;
            } else if i + 4 <= b.len() and answer[i..i + 4] == "</b>" {
                if not open or last_tag == i {
                    good = false;
                }
                open = false;
                i += 4;
            } else {
                good = false;
                i += 1;
            }
            last_tag = i;
        } else {
            text.push(b[i] as char);
            marks.push(open);
            i += 1;
        }
    }
    if open {
        good = false;
    }
    (text, marks, good)
}

fn rename(text: ref String, perm: ref Vec[i64]) -> String {
    let mut out = String.new();
    for c in text.bytes() {
        out.push((b'a' + perm[(c - b'a') as i64] as u8) as char);
    }
    out
}

fn main() {
    let arms = 4;
    let mut seed = 7580;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 2000;
    let mut runs = 0;
    for _ in 0..cases {
        // short strings over two to four letters and a few short words,
        // so that occurrences overlap, touch and nest
        let letters = 2 + next_random(mut seed) % 3;
        let length = 1 + next_random(mut seed) % 40;
        let s = random_text(mut seed, length, letters);
        let count = next_random(mut seed) % 9;
        let mut words: Vec[String] = Vec.new();
        for _ in 0..count {
            let size = 1 + next_random(mut seed) % 5;
            words.push(random_text(mut seed, size, letters));
        }
        let mut perm = [0, 1, 2, 3, 4, 5];
        for i in 0..6 {
            let j = i + next_random(mut seed) % (6 - i);
            perm.swap(i, j);
        }
        let renamed = rename(s, perm);
        let mut renamed_words: Vec[String] = Vec.new();
        for w in words.iter() {
            renamed_words.push(rename(w, perm));
        }
        let mut more = words.clone();
        let size = 1 + next_random(mut seed) % 5;
        more.push(random_text(mut seed, size, letters));
        let want = definition(words, s);
        for which in 0..arms {
            let got = answer_with(which, words.clone(), s.clone());
            if which == 0 {
                runs += (got.len() - s.len()) / 7;
            }
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the tags taken out leave `s`, and they alternate, with
            // no empty pair and none closing where the next opens.
            checks += 1;
            let (text, marks, good) = parse(got);
            if text != s or not good {
                fails[1] += 1;
            }
            // P3: renaming the letters renames the answer's text and
            // bolds the same characters.
            checks += 1;
            let (rtext, rmarks, rgood) = parse(answer_with(which, renamed_words.clone(), renamed.clone()));
            if rtext != renamed or rmarks != marks or not rgood {
                fails[2] += 1;
            }
            // P4: one more word never takes a character out of bold.
            checks += 1;
            let (_, mmarks, _) = parse(answer_with(which, more.clone(), s.clone()));
            let mut lost = false;
            for i in 0..marks.len() {
                if marks[i] and not mmarks[i] {
                    lost = true;
                }
            }
            if lost or mmarks.len() != marks.len() {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} strings ({runs} bold runs), {arms} arms, {checks} checks, {failures} failures");
}
