// LeetCode 753 — Cracking the Safe, the textbook search.
//
// Start from n zeros and keep a set of the codes typed so far. At each
// step try the digits 0 to k-1 after the last n-1 typed: a digit that
// makes a new code is typed and the search goes on; if it gets stuck
// before every code is in, the digit is taken back. The codes and the
// typed text stay strings throughout; `String` has no `pop`, so a digit
// is taken back by keeping all but the last byte. O(k^n) steps when
// nothing is taken back.

fn search(typed: mut ref String, seen: mut ref Set[String], n: i64, k: i64, total: i64) -> bool {
    if seen.len() == total {
        return true;
    }
    let tail = typed[typed.len() - (n - 1)..].to_string();
    for d in 0..k {
        let code = f"{tail}{d}";
        if not seen.contains(code) {
            seen.insert(code.clone());
            typed.push_str(f"{d}");
            if search(mut typed, mut seen, n, k, total) {
                return true;
            }
            *typed = typed[..typed.len() - 1].to_string();
            seen.remove(code);
        }
    }
    false
}

fn crack_safe(n: i64, k: i64) -> String {
    let mut total = 1;
    for _ in 0..n {
        total *= k;
    }
    let mut typed = String.new();
    for _ in 0..n {
        typed.push('0');
    }
    let mut seen: Set[String] = Set.new();
    seen.insert(typed.clone());
    search(mut typed, mut seen, n, k, total);
    typed
}

// ---- test harness ---------------------------------------------------------

// What the answer is, judged: its length against the shortest possible,
// k^n + n - 1, and whether every code appears in it exactly once.
fn judged(text: String, n: i64, k: i64) -> String {
    let mut total = 1;
    for _ in 0..n {
        total *= k;
    }
    let bytes = text.bytes();
    let mut seen: Vec[i64] = Vec.new();
    for _ in 0..total {
        seen.push(0);
    }
    let mut bad = 0;
    let mut i = 0;
    while i + n <= bytes.len() {
        let mut code = 0;
        for j in i..i + n {
            let d = (bytes[j] - b'0') as i64;
            if d < 0 or d >= k {
                bad += 1;
            }
            code = code * k + d;
        }
        if code >= 0 and code < total {
            seen[code] += 1;
        }
        i += 1;
    }
    let mut once = 0;
    for c in seen.iter() {
        if *c == 1 {
            once += 1;
        }
    }
    let shortest = total + n - 1;
    let size = if text.len() == shortest { "shortest" } else { "NOT SHORTEST" };
    let codes = if once == total and bad == 0 { "every code once" } else { "CODES WRONG" };
    f"{text.len()} digits, {size}, {codes}"
}

fn show(n: i64, k: i64) {
    println(f"n = {n}, k = {k}: {judged(crack_safe(n, k), n, k)}");
}

fn main() {
    show(1, 2);
    show(2, 2);
    show(1, 1);
    show(4, 1);
    show(1, 10);
    show(3, 2);
    show(2, 10);
    show(3, 10);
    show(4, 8);
    let mut safes = 0;
    let mut digits = 0;
    let mut good = 0;
    for n in 1..5 {
        for k in 1..11 {
            let mut total = 1;
            for _ in 0..n {
                total *= k;
            }
            if total <= 4096 {
                safes += 1;
                let text = crack_safe(n, k);
                digits += text.len();
                if judged(text, n, k).ends_with("shortest, every code once") {
                    good += 1;
                }
            }
        }
    }
    println(f"all {safes} safes: {digits} digits in all, {good} shortest with every code once");
}
