// LeetCode #733: Flood Fill -- depth first, with a stack of places.
//
// The region is every pixel reachable from (sr, sc) by steps up, down,
// left and right through pixels of the starting pixel's color. Push the
// start; pop a place, and if it still has the old color, paint it and
// push its four neighbours. When the new color is the old one there is
// nothing to do, and painting would never stop. O(m n) time and space.

fn flood_fill(image: own Vec[Vec[i64]], sr: i64, sc: i64, color: i64) -> Vec[Vec[i64]] {
    let mut img = image;
    let old = img[sr][sc];
    if old == color {
        return img;
    }
    let m = img.len();
    let n = img[0].len();
    let mut stack: Vec[(i64, i64)] = Vec.new();
    stack.push((sr, sc));
    while let Some((r, c)) = stack.pop() {
        if r < 0 or r >= m or c < 0 or c >= n or img[r][c] != old {
            continue;
        }
        img[r][c] = color;
        stack.push((r + 1, c));
        stack.push((r - 1, c));
        stack.push((r, c + 1));
        stack.push((r, c - 1));
    }
    img
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // A 1000 x 1000 image, two thirds 0s and the rest 1s, made once.
    let mut seed: i64 = 733;
    let size = 1000;
    let mut img: Vec[Vec[i64]] = Vec.new();
    for _ in 0..size {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..size {
            row.push(if next_random(mut seed) % 3 == 0 { 1 } else { 0 });
        }
        img.push(row);
    }
    // 40 rounds: fill from a random place with 2, a color the
    // image does not have, count the 2s in that place's row, then fill
    // back with the place's own color, which restores the image.
    let mut sum = 0;
    for _ in 0..40 {
        let r = (next_random(mut seed) * 32768 + next_random(mut seed)) % size;
        let c = (next_random(mut seed) * 32768 + next_random(mut seed)) % size;
        let old = img[r][c];
        img = flood_fill(img, r, c, 2);
        for x in 0..size {
            if img[r][x] == 2 {
                sum += 1;
            }
        }
        img = flood_fill(img, r, c, old);
    }
    let mut zeros = 0;
    for r in 0..size {
        for c in 0..size {
            if img[r][c] == 0 {
                zeros += 1;
            }
        }
    }
    println(f"40 rounds on a 1000 x 1000 image: {sum} painted in their rows, {zeros} 0s after");
}
