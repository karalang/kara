// LeetCode 792 — Number of Matching Subsequences: the bench.
//
// 16 strings of 50,000 letters, LeetCode's longest, each over the
// first 13 to 26 letters of the alphabet, and 64 lists of 5,000 words,
// LeetCode's most, each word of 1 to 50 letters over all 26, are made
// once. Each of 4,000 rounds counts the words of one list that one
// string spells, with the ★ arm: every word waits in the bucket of the
// next letter it needs.
fn num_matching_subseq(s: Str, words: Vec[String]) -> i64 {
    // waiting[c]: (word, letters matched) for the words that need c next.
    let mut waiting: Vec[Vec[(i64, i64)]] = Vec.new();
    for _ in 0..26 {
        waiting.push(Vec.new());
    }
    for i in 0..words.len() {
        let first = words[i].bytes()[0];
        waiting[(first - b'a') as i64].push((i, 0));
    }
    let mut count = 0;
    for b in s.bytes() {
        let moving = mem.take(mut waiting[(b - b'a') as i64]);
        for (w, matched) in moving {
            let word = words[w].bytes();
            if matched + 1 == word.len() {
                count += 1;
            } else {
                waiting[(word[matched + 1] - b'a') as i64].push((w, matched + 1));
            }
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..len {
        word.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    word
}

fn main() {
    let mut seed = 792;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..16 {
        let letters = 13 + next_random(mut seed) % 14;
        strings.push(random_word(mut seed, 50000, letters));
    }
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..64 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..5000 {
            words.push(random_word(mut seed, 1 + next_random(mut seed) % 50, 26));
        }
        lists.push(words);
    }
    let rounds = 4000;
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        let count = num_matching_subseq(strings[r % 16], lists[(r / 16) % 64]);
        total += count;
        check = (check * 131 + count + 1) % 1000000007;
    }
    println(f"{rounds} rounds of 5000 words: {total} matching, checksum {check}");
}
