// LeetCode 790 — Domino and Tromino Tiling, one recurrence.
//
// Taking ragged ends out of the ★ arm's two counts leaves one for the
// full boards alone: f(n) = 2 f(n - 1) + f(n - 3), from f(0) = 1,
// f(1) = 1 and f(2) = 2. Three numbers carried along. O(n).
fn num_tilings(n: i64) -> i64 {
    let modulus = 1000000007;
    if n <= 2 {
        return n;
    }
    let mut (a, b, c) = (1, 1, 2);
    for _ in 3..n + 1 {
        let next = (2 * c + a) % modulus;
        a = b;
        b = c;
        c = next;
    }
    c
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    for n in [3, 1, 2, 4, 5, 10, 27, 28, 100, 999, 1000] {
        println(f"n = {n} -> {num_tilings(n)}");
    }
    let mut seed = 790;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 1000;
        let ways = num_tilings(n);
        sum = (sum + ways) % 1000000007;
        check = (check * 31 + ways) % 1000000007;
    }
    println(f"300 random n: answers sum to {sum}, checksum {check}");
}
