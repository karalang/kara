// LeetCode 790 — Domino and Tromino Tiling, a matrix power.
//
// The recurrence f(n) = 2 f(n - 1) + f(n - 3) moves the vector
// (f(i), f(i - 1), f(i - 2)) one step on by a 3 × 3 matrix, so raising
// it to the power n - 2 by repeated squaring takes (f(2), f(1), f(0))
// to (f(n), f(n - 1), f(n - 2)). O(log n).
fn multiply(a: Vec[Vec[i64]], b: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let modulus = 1000000007;
    let mut out: Vec[Vec[i64]] = Vec.new();
    for i in 0..3 {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..3 {
            let mut sum = 0;
            for k in 0..3 {
                sum = (sum + a[i][k] * b[k][j]) % modulus;
            }
            row.push(sum);
        }
        out.push(row);
    }
    out
}

fn num_tilings(n: i64) -> i64 {
    let modulus = 1000000007;
    if n <= 2 {
        return n;
    }
    let mut result: Vec[Vec[i64]] = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
    let mut step: Vec[Vec[i64]] = [[2, 0, 1], [1, 0, 0], [0, 1, 0]];
    let mut power = n - 2;
    while power > 0 {
        if power % 2 == 1 {
            result = multiply(result, step);
        }
        step = multiply(step, step);
        power /= 2;
    }
    (result[0][0] * 2 + result[0][1] + result[0][2]) % modulus
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    for n in [3, 1, 2, 4, 5, 10, 27, 28, 100, 999, 1000] {
        println(f"n = {n} -> {num_tilings(n)}");
    }
    let mut seed = 790;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 1000;
        let ways = num_tilings(n);
        sum = (sum + ways) % 1000000007;
        check = (check * 31 + ways) % 1000000007;
    }
    println(f"300 random n: answers sum to {sum}, checksum {check}");
}
