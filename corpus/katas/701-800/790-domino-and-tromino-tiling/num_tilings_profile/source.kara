// LeetCode 790 — Domino and Tromino Tiling, column by column.
//
// Go along the columns keeping, for each way the current column may
// already be partly covered by pieces from the one before (none, top,
// bottom or both), how many ways lead there. Each column is filled from
// the top, every piece covering its first open square and perhaps
// reaching into the next column, which gives how the next column starts.
// O(n), with the pieces placed by search rather than by formula.
fn place(covered: i64, row: i64, next: i64, ways: i64, counts: mut ref Vec[i64]) {
    let modulus = 1000000007;
    if row == 2 {
        counts[next] = (counts[next] + ways) % modulus;
        return;
    }
    let here = 1 << row;
    if covered & here != 0 {
        place(covered, row + 1, next, ways, mut counts);
        return;
    }
    let other = 3 - here;
    // A vertical domino.
    if covered & other == 0 {
        place(covered | 3, row + 1, next, ways, mut counts);
    }
    // A horizontal domino.
    if next & here == 0 {
        place(covered | here, row + 1, next | here, ways, mut counts);
    }
    // The trominoes in this column and the next that cover this square:
    // with the other square here and one of the next column's, or with
    // both of the next column's.
    if covered & other == 0 {
        if next & here == 0 {
            place(covered | 3, row + 1, next | here, ways, mut counts);
        }
        if next & other == 0 {
            place(covered | 3, row + 1, next | other, ways, mut counts);
        }
    }
    if next == 0 {
        place(covered | here, row + 1, 3, ways, mut counts);
    }
}

fn num_tilings(n: i64) -> i64 {
    let mut counts: Vec[i64] = [1, 0, 0, 0];
    for _ in 0..n {
        let mut after: Vec[i64] = [0, 0, 0, 0];
        for covered in 0..4 {
            if counts[covered] != 0 {
                place(covered, 0, 0, counts[covered], mut after);
            }
        }
        counts = after;
    }
    counts[0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    for n in [3, 1, 2, 4, 5, 10, 27, 28, 100, 999, 1000] {
        println(f"n = {n} -> {num_tilings(n)}");
    }
    let mut seed = 790;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 1000;
        let ways = num_tilings(n);
        sum = (sum + ways) % 1000000007;
        check = (check * 31 + ways) % 1000000007;
    }
    println(f"300 random n: answers sum to {sum}, checksum {check}");
}
