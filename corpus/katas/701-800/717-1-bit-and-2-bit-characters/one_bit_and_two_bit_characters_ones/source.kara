// LeetCode #717: 1-bit and 2-bit Characters -- count the ones at the end.
//
// A 0 always ends a character, so a decoding restarts after every 0.
// Only the run of 1s just before the final 0 decides: they pair off
// into two-bit characters, and an odd one left over takes the final 0
// with it. The last character is one bit when that run is even. O(n)
// in the worst case, reading only the tail.

fn is_one_bit_character(bits: Vec[i64]) -> bool {
    let mut ones = 0;
    let mut i = bits.len() - 2;
    while i >= 0 and bits[i] == 1 {
        ones += 1;
        i -= 1;
    }
    ones % 2 == 0
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(bits: Vec[i64]) {
    println(f"{bits} -> {is_one_bit_character(bits)}");
}

fn main() {
    show([1, 0, 0]);
    show([1, 1, 1, 0]);
    show([0]);
    show([1, 0]);
    show([0, 0]);
    show([1, 1, 0]);
    show([0, 1, 0]);
    show([1, 1, 1, 1, 0]);
    show([0, 1, 1, 1, 0]);
    // n - 1 ones and a 0, for every n up to the problem's most, 1,000.
    let mut odd = 0;
    for n in 1..1001 {
        let mut bits: Vec[i64] = Vec.new();
        for _ in 0..n - 1 {
            bits.push(1);
        }
        bits.push(0);
        if is_one_bit_character(bits) {
            odd += 1;
        }
    }
    println(f"1 to 1000 bits, all ones but the last: {odd} one-bit endings");
    // 2,000 random strings of 1 to 1,000 bits ending in 0, from three
    // densities of ones.
    let mut seed: i64 = 717;
    let mut sum = 0;
    let mut yes = 0;
    for t in 0..2000 {
        let n = 1 + next_random(mut seed) % 1000;
        let density = 1 + t % 3;
        let mut bits: Vec[i64] = Vec.new();
        for _ in 0..n - 1 {
            bits.push(if next_random(mut seed) % 4 < density { 1 } else { 0 });
        }
        bits.push(0);
        let answer = if is_one_bit_character(bits) { 1 } else { 0 };
        yes += answer;
        sum = (sum * 131 + answer + n) % 1000000007;
    }
    println(f"2000 random strings: {yes} one-bit endings, checksum {sum}");
}
