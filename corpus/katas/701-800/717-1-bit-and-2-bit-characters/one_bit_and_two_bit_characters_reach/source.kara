// LeetCode #717: 1-bit and 2-bit Characters -- which bits start a
// character.
//
// Mark every bit at which a character can start: the first can, and
// from a start a 0 marks the next bit and a 1 marks the one after. The
// last character is one bit when the last bit is a start. O(n) time and
// space.

fn is_one_bit_character(bits: Vec[i64]) -> bool {
    let n = bits.len();
    let mut start: Vec[bool] = Vec.new();
    for _ in 0..n + 1 {
        start.push(false);
    }
    start[0] = true;
    for i in 0..n {
        if start[i] {
            if bits[i] == 0 {
                start[i + 1] = true;
            } else if i + 2 <= n {
                start[i + 2] = true;
            }
        }
    }
    start[n - 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(bits: Vec[i64]) {
    println(f"{bits} -> {is_one_bit_character(bits)}");
}

fn main() {
    show([1, 0, 0]);
    show([1, 1, 1, 0]);
    show([0]);
    show([1, 0]);
    show([0, 0]);
    show([1, 1, 0]);
    show([0, 1, 0]);
    show([1, 1, 1, 1, 0]);
    show([0, 1, 1, 1, 0]);
    // n - 1 ones and a 0, for every n up to the problem's most, 1,000.
    let mut odd = 0;
    for n in 1..1001 {
        let mut bits: Vec[i64] = Vec.new();
        for _ in 0..n - 1 {
            bits.push(1);
        }
        bits.push(0);
        if is_one_bit_character(bits) {
            odd += 1;
        }
    }
    println(f"1 to 1000 bits, all ones but the last: {odd} one-bit endings");
    // 2,000 random strings of 1 to 1,000 bits ending in 0, from three
    // densities of ones.
    let mut seed: i64 = 717;
    let mut sum = 0;
    let mut yes = 0;
    for t in 0..2000 {
        let n = 1 + next_random(mut seed) % 1000;
        let density = 1 + t % 3;
        let mut bits: Vec[i64] = Vec.new();
        for _ in 0..n - 1 {
            bits.push(if next_random(mut seed) % 4 < density { 1 } else { 0 });
        }
        bits.push(0);
        let answer = if is_one_bit_character(bits) { 1 } else { 0 };
        yes += answer;
        sum = (sum * 131 + answer + n) % 1000000007;
    }
    println(f"2000 random strings: {yes} one-bit endings, checksum {sum}");
}
