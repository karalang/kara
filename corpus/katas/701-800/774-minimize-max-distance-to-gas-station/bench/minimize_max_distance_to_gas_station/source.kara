// LeetCode 774 — Minimize Max Distance to Gas Station: benchmark, the ★
// arm. Sixty-four random roads of 2,000 stations, LeetCode's limit,
// spread over up to 10^8, each with k from 1 to 10^6, built once; ROUNDS
// rounds each solve the next of them and add up the answers.

const ROUNDS: i64 = 2000;

fn minmax_gas_dist(stations: Vec[i64], k: i64) -> f64 {
    let mut lo = 0.0;
    let mut hi = 0.0;
    for i in 1..stations.len() {
        let gap = (stations[i] - stations[i - 1]) as f64;
        if gap > hi {
            hi = gap;
        }
    }
    hi += 1.0;
    for _ in 0..100 {
        let mid = (lo + hi) / 2.0;
        let mut needed = 0;
        for i in 1..stations.len() {
            needed += ((stations[i] - stations[i - 1]) as f64 / mid) as i64;
        }
        if needed <= k {
            hi = mid;
        } else {
            lo = mid;
        }
    }
    let mut longest = 0.0;
    for i in 1..stations.len() {
        let gap = (stations[i] - stations[i - 1]) as f64;
        let piece = gap / ((gap / hi) as i64 + 1) as f64;
        if piece > longest {
            longest = piece;
        }
    }
    longest
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 774;
    let mut roads: Vec[Vec[i64]] = Vec.new();
    let mut ks: Vec[i64] = Vec.new();
    for _ in 0..64 {
        let mut stations: Vec[i64] = [next_random(mut seed) % 100];
        for _ in 1..2000 {
            let last = stations[stations.len() - 1];
            stations.push(last + 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 50000);
        }
        roads.push(stations);
        ks.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000);
    }
    let mut total = 0.0;
    for round in 0..ROUNDS {
        total += minmax_gas_dist(roads[round % 64], ks[round % 64]);
    }
    println(f"{ROUNDS} roads of 2000 stations: answers sum to {total:.5}");
}
