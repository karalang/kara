// LeetCode #728: Self Dividing Numbers -- the digits' least common
// multiple.
//
// A number is divisible by each of its digits exactly when it is
// divisible by their least common multiple, and that multiple for n
// comes from the one for n / 10 and the last digit, 0 standing for a
// zero digit. Fill them from 1 up to right, then keep the numbers in
// range with a multiple that divides them. O(right * log 2520) time,
// O(right) space.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn self_dividing_numbers(left: i64, right: i64) -> Vec[i64] {
    let mut l: Vec[i64] = vec![1; right + 1];
    for n in 1..right + 1 {
        let d = n % 10;
        let up = l[n / 10];
        l[n] = if d == 0 or up == 0 { 0 } else { up / gcd(up, d) * d };
    }
    let mut out: Vec[i64] = Vec.new();
    for n in left..right + 1 {
        if l[n] != 0 and n % l[n] == 0 {
            out.push(n);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(left: i64, right: i64) {
    println(f"{left}..{right} -> {self_dividing_numbers(left, right)}");
}

fn main() {
    show(1, 22);
    show(47, 85);
    show(1, 1);
    show(10, 10);
    show(100, 130);
    show(9990, 10000);
    show(1111, 1150);
    let all = self_dividing_numbers(1, 10000);
    let mut sum = 0;
    for n in all.iter() {
        sum += *n;
    }
    println(f"1..10000 -> {all.len()} numbers, sum {sum}, largest {all[all.len() - 1]}");
    let mut seed: i64 = 728;
    let mut found = 0;
    let mut check = 0;
    for _ in 0..300 {
        let a = 1 + next_random(mut seed) % 10000;
        let b = 1 + next_random(mut seed) % 10000;
        let left = if a < b { a } else { b };
        let right = if a < b { b } else { a };
        let got = self_dividing_numbers(left, right);
        found += got.len();
        for n in got.iter() {
            check = (check * 131 + *n) % 1000000007;
        }
        check = (check * 131 + 1) % 1000000007;
    }
    println(f"300 random ranges: {found} numbers, checksum {check}");
}
