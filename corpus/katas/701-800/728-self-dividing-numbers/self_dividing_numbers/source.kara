// LeetCode #728: Self Dividing Numbers -- each digit, by remainders.
//
// A number is self-dividing when none of its digits is 0 and it is
// divisible by every one of them. Peel the digits off with % 10 and
// / 10, stopping at the first 0 or the first digit that does not divide
// the number. O((right - left) * d) time for d digits.

fn self_dividing(n: i64) -> bool {
    let mut rest = n;
    while rest > 0 {
        let d = rest % 10;
        if d == 0 or n % d != 0 {
            return false;
        }
        rest /= 10;
    }
    true
}

fn self_dividing_numbers(left: i64, right: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for n in left..right + 1 {
        if self_dividing(n) {
            out.push(n);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(left: i64, right: i64) {
    println(f"{left}..{right} -> {self_dividing_numbers(left, right)}");
}

fn main() {
    show(1, 22);
    show(47, 85);
    show(1, 1);
    show(10, 10);
    show(100, 130);
    show(9990, 10000);
    show(1111, 1150);
    let all = self_dividing_numbers(1, 10000);
    let mut sum = 0;
    for n in all.iter() {
        sum += *n;
    }
    println(f"1..10000 -> {all.len()} numbers, sum {sum}, largest {all[all.len() - 1]}");
    let mut seed: i64 = 728;
    let mut found = 0;
    let mut check = 0;
    for _ in 0..300 {
        let a = 1 + next_random(mut seed) % 10000;
        let b = 1 + next_random(mut seed) % 10000;
        let left = if a < b { a } else { b };
        let right = if a < b { b } else { a };
        let got = self_dividing_numbers(left, right);
        found += got.len();
        for n in got.iter() {
            check = (check * 131 + *n) % 1000000007;
        }
        check = (check * 131 + 1) % 1000000007;
    }
    println(f"300 random ranges: {found} numbers, checksum {check}");
}
