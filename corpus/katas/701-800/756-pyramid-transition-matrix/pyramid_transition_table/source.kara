// LeetCode 756 — Pyramid Transition Matrix, a table from the top down.
//
// Number the rows of each width in base 6, letters A to F as 0 to 5.
// Every row of width one is the top of a pyramid. A row one wider can be
// finished exactly when some row that can be finished stands on it, so
// from each such row mark every row it can stand on: choose the first
// block below, then each next one so that the pair carries the block
// above. Widen the table up to the bottom's width and read the bottom.

fn mark(above: ref Vec[i64], i: i64, last: i64, code: i64, below: mut ref Vec[bool], fits: ref Vec[bool]) {
    if i == above.len() {
        below[code] = true;
        return;
    }
    for x in 0..6 {
        if fits[(last * 6 + x) * 6 + above[i]] {
            mark(above, i + 1, x, code * 6 + x, mut below, fits);
        }
    }
}

fn pyramid_transition(bottom: String, allowed: Vec[String]) -> bool {
    let mut fits: Vec[bool] = Vec.new();
    for _ in 0..216 {
        fits.push(false);
    }
    for triple in allowed.iter() {
        let b = triple.bytes();
        fits[((b[0] - b'A') as i64 * 6 + (b[1] - b'A') as i64) * 6 + (b[2] - b'A') as i64] = true;
    }
    let mut good: Vec[bool] = Vec.new();
    for _ in 0..6 {
        good.push(true);
    }
    let mut width = 1;
    let mut size = 6;
    while width < bottom.len() {
        let mut below: Vec[bool] = Vec.new();
        for _ in 0..size * 6 {
            below.push(false);
        }
        for code in 0..size {
            if good[code] {
                let mut above: Vec[i64] = Vec.new();
                let mut rest = code;
                for _ in 0..width {
                    above.insert(0, rest % 6);
                    rest /= 6;
                }
                for first in 0..6 {
                    mark(above, 0, first, first, mut below, fits);
                }
            }
        }
        good = below;
        width += 1;
        size *= 6;
    }
    let mut code = 0;
    for c in bottom.bytes() {
        code = code * 6 + (c - b'A') as i64;
    }
    good[code]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letter(x: i64) -> String {
    let mut s = String.new();
    s.push((b'A' + x as u8) as char);
    s
}

fn show(bottom: String, allowed: Vec[String]) {
    let n = allowed.len();
    let answer = pyramid_transition(bottom.clone(), allowed);
    println(f"{bottom} with {n} triples -> {answer}");
}

fn main() {
    show(String.from("BCD"), [String.from("BCC"), String.from("CDE"), String.from("CEA"), String.from("FFF")]);
    show(String.from("AAAA"), [String.from("AAB"), String.from("AAC"), String.from("BCD"), String.from("BBE"), String.from("DEF")]);
    show(String.from("AB"), [String.from("ABC")]);
    show(String.from("AB"), [String.from("BAC")]);
    show(String.from("AB"), Vec.new());
    show(String.from("FFFFFF"), [String.from("FFF")]);
    show(String.from("ABCDEF"), [String.from("FFF")]);
    let mut seed = 756;
    let mut yes = 0;
    let mut check = 0;
    for round in 0..300 {
        let width = 2 + next_random(mut seed) % 5;
        let mut bottom = String.new();
        for _ in 0..width {
            bottom.push_str(letter(next_random(mut seed) % 6));
        }
        let count = next_random(mut seed) % 60;
        let mut allowed: Vec[String] = Vec.new();
        for _ in 0..count {
            let mut t = String.new();
            for _ in 0..3 {
                t.push_str(letter(next_random(mut seed) % 6));
            }
            allowed.push(t);
        }
        if pyramid_transition(bottom, allowed) {
            yes += 1;
            check = (check * 31 + round) % 1000000007;
        }
    }
    println(f"300 random pyramids: {yes} can be built, checksum {check}");
}
