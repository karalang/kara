// LeetCode #745: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random filters.

// ---- ★ arm ----------------------------------------------------------

struct WordFilterStar {
    keys: Map[String, i64],
}

impl WordFilterStar {
    fn new(words: Vec[String]) -> WordFilterStar {
        let mut keys: Map[String, i64] = Map.new();
        for i in 0..words.len() {
            let w = ref words[i];
            let n = w.len();
            for p in 0..n + 1 {
                for s in 0..n + 1 {
                    let mut key = String.from(w.slice(0, p));
                    key.push('{');
                    key.push_str(w.slice(s, n));
                    keys.insert(key, i);
                }
            }
        }
        WordFilterStar { keys: keys }
    }

    fn f(self, pref: String, suff: String) -> i64 {
        let mut key = pref.clone();
        key.push('{');
        key.push_str(suff.as_str());
        match self.keys.get(key) {
            Some(i) => i,
            None => -1,
        }
    }
}

// ---- scan arm -------------------------------------------------------

struct WordFilterScan {
    words: Vec[String],
}

impl WordFilterScan {
    fn new(words: Vec[String]) -> WordFilterScan {
        WordFilterScan { words: words.clone() }
    }

    fn f(self, pref: String, suff: String) -> i64 {
        let mut i = self.words.len() - 1;
        while i >= 0 {
            let w = ref self.words[i];
            if w.starts_with(pref.clone()) and w.ends_with(suff.clone()) {
                return i;
            }
            i -= 1;
        }
        -1
    }
}

// ---- trie arm -------------------------------------------------------

struct WordFilterTrie {
    next: Vec[i64],
    last: Vec[i64],
}

impl WordFilterTrie {
    fn new(words: Vec[String]) -> WordFilterTrie {
        let mut next: Vec[i64] = Vec.new();
        let mut last: Vec[i64] = Vec.new();
        for _ in 0..27 {
            next.push(0);
        }
        last.push(-1);
        for i in 0..words.len() {
            let w = words[i].bytes();
            let n = w.len();
            for s in 0..n + 1 {
                let mut node = 0;
                last[node] = i;
                for j in s..2 * n + 1 {
                    let c = if j < n { (w[j] - b'a') as i64 } else if j == n { 26 } else { (w[j - n - 1] - b'a') as i64 };
                    if next[node * 27 + c] == 0 {
                        next[node * 27 + c] = last.len();
                        for _ in 0..27 {
                            next.push(0);
                        }
                        last.push(-1);
                    }
                    node = next[node * 27 + c];
                    last[node] = i;
                }
            }
        }
        WordFilterTrie { next: next, last: last }
    }

    fn f(self, pref: String, suff: String) -> i64 {
        let mut node = 0;
        for b in suff.bytes().iter() {
            node = self.next[node * 27 + (*b - b'a') as i64];
            if node == 0 {
                return -1;
            }
        }
        node = self.next[node * 27 + 26];
        if node == 0 {
            return -1;
        }
        for b in pref.bytes().iter() {
            node = self.next[node * 27 + (*b - b'a') as i64];
            if node == 0 {
                return -1;
            }
        }
        self.last[node]
    }
}

// ---- lists arm ------------------------------------------------------

struct WordFilterLists {
    starts: Map[String, Vec[i64]],
    ends: Map[String, Vec[i64]],
}

fn add_to_lists(index: mut ref Map[String, Vec[i64]], key: own String, i: i64) {
    if index.contains_key(key.clone()) {
        index.get_mut(key).unwrap().push(i);
    } else {
        index.insert(key, [i]);
    }
}

impl WordFilterLists {
    fn new(words: Vec[String]) -> WordFilterLists {
        let mut starts: Map[String, Vec[i64]] = Map.new();
        let mut ends: Map[String, Vec[i64]] = Map.new();
        for i in 0..words.len() {
            let w = ref words[i];
            let n = w.len();
            for p in 1..n + 1 {
                add_to_lists(mut starts, String.from(w.slice(0, p)), i);
                add_to_lists(mut ends, String.from(w.slice(n - p, n)), i);
            }
        }
        WordFilterLists { starts: starts, ends: ends }
    }

    fn f(self, pref: String, suff: String) -> i64 {
        let a = match self.starts.get(pref) {
            Some(list) => list,
            None => return -1,
        };
        let b = match self.ends.get(suff) {
            Some(list) => list,
            None => return -1,
        };
        let mut i = a.len() - 1;
        let mut j = b.len() - 1;
        while i >= 0 and j >= 0 {
            if a[i] == b[j] {
                return a[i];
            } else if a[i] > b[j] {
                i -= 1;
            } else {
                j -= 1;
            }
        }
        -1
    }
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, words: Vec[String], pref: String, suff: String) -> i64 {
    if which == 0 {
        WordFilterStar.new(words).f(pref, suff)
    } else if which == 1 {
        WordFilterScan.new(words).f(pref, suff)
    } else if which == 2 {
        WordFilterTrie.new(words).f(pref, suff)
    } else {
        WordFilterLists.new(words).f(pref, suff)
    }
}

fn random_word(seed: mut ref i64, longest: i64, letters: i64) -> String {
    let mut s = String.new();
    let n = 1 + next_random(mut seed) % longest;
    for _ in 0..n {
        s.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    s
}

fn reversed(s: String) -> String {
    let b = s.bytes();
    let mut out = String.new();
    let mut i = b.len() - 1;
    while i >= 0 {
        out.push(b[i] as char);
        i -= 1;
    }
    out
}

// The definition, as the problem states it: the largest index of a word
// that begins with `pref` and ends with `suff`, letter by letter, or -1.
fn definition(words: Vec[String], pref: String, suff: String) -> i64 {
    let p = pref.bytes();
    let s = suff.bytes();
    let mut answer = -1;
    for i in 0..words.len() {
        let w = words[i].bytes();
        if p.len() > w.len() or s.len() > w.len() {
            continue;
        }
        let mut ok = true;
        for j in 0..p.len() {
            if w[j] != p[j] {
                ok = false;
            }
        }
        for j in 0..s.len() {
            if w[w.len() - s.len() + j] != s[j] {
                ok = false;
            }
        }
        if ok {
            answer = i;
        }
    }
    answer
}

fn main() {
    let mut seed = 7450;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut found = 0;
    let cases = 3000;
    for _ in 0..cases {
        // 1 to 8 words of 1 to 4 letters from a to c, and a query of
        // 1 or 2 random letters each way or, half the time, a prefix
        // and a suffix of one of the words
        let n = 1 + next_random(mut seed) % 8;
        let mut words: Vec[String] = Vec.new();
        for _ in 0..n {
            words.push(random_word(mut seed, 4, 3));
        }
        let mut pref = random_word(mut seed, 2, 3);
        let mut suff = random_word(mut seed, 2, 3);
        if next_random(mut seed) % 2 == 0 {
            let w = ref words[next_random(mut seed) % n];
            let len = w.len();
            pref = String.from(w.slice(0, 1 + next_random(mut seed) % len));
            suff = String.from(w.slice(len - 1 - next_random(mut seed) % len, len));
        }
        let want = definition(words, pref.clone(), suff.clone());
        if want != -1 {
            found += 1;
        }
        // one more word, the prefix and the suffix written together
        let mut joined = words.clone();
        let mut both = pref.clone();
        both.push_str(suff.as_str());
        joined.push(both);
        // every word reversed, asked with the suffix and prefix reversed
        let mut backwards: Vec[String] = Vec.new();
        for w in words.iter() {
            backwards.push(reversed(w.clone()));
        }
        // every word written twice in a row
        let mut twice: Vec[String] = Vec.new();
        for w in words.iter() {
            twice.push(w.clone());
            twice.push(w.clone());
        }
        for which in 0..arms {
            let got = answer_with(which, words, pref.clone(), suff.clone());
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the added word matches, and it is the last.
            checks += 1;
            if answer_with(which, joined, pref.clone(), suff.clone()) != n {
                fails[1] += 1;
            }
            // P3: the reversed words answer the reversed question alike.
            checks += 1;
            if answer_with(which, backwards, reversed(suff.clone()), reversed(pref.clone())) != got {
                fails[2] += 1;
            }
            // P4: each word twice, the second copy of the same word.
            checks += 1;
            let expect = if got == -1 { -1 } else { 2 * got + 1 };
            if answer_with(which, twice, pref.clone(), suff.clone()) != expect {
                fails[3] += 1;
            }
        }
    }
    let mut failures = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        failures += fails[i];
    }
    println(f"{cases} filters ({found} queries found), {arms} arms, {checks} checks, {failures} failures");
}
