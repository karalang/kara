// LeetCode 745 — Prefix and Suffix Search, a trie of wrapped words.
//
// For every suffix s of a word w, put s + '{' + w in one trie, so that
// a path spelling suff + '{' + pref exists exactly when some word has
// that suffix and that prefix. Each node remembers the largest index
// of a word whose insertion passed through it, which, since the words
// go in in order, is the last one. A query walks one path of up to 15
// letters. Nodes are rows of 27 children, a to z and '{', in one flat
// `Vec`, 0 for no child.

struct WordFilter {
    next: Vec[i64],
    last: Vec[i64],
}

impl WordFilter {
    fn new(words: Vec[String]) -> WordFilter {
        let mut next: Vec[i64] = Vec.new();
        let mut last: Vec[i64] = Vec.new();
        for _ in 0..27 {
            next.push(0);
        }
        last.push(-1);
        for i in 0..words.len() {
            let w = words[i].bytes();
            let n = w.len();
            for s in 0..n + 1 {
                let mut node = 0;
                last[node] = i;
                for j in s..2 * n + 1 {
                    let c = if j < n { (w[j] - b'a') as i64 } else if j == n { 26 } else { (w[j - n - 1] - b'a') as i64 };
                    if next[node * 27 + c] == 0 {
                        next[node * 27 + c] = last.len();
                        for _ in 0..27 {
                            next.push(0);
                        }
                        last.push(-1);
                    }
                    node = next[node * 27 + c];
                    last[node] = i;
                }
            }
        }
        WordFilter { next: next, last: last }
    }

    fn f(self, pref: String, suff: String) -> i64 {
        let mut node = 0;
        for b in suff.bytes().iter() {
            node = self.next[node * 27 + (*b - b'a') as i64];
            if node == 0 {
                return -1;
            }
        }
        node = self.next[node * 27 + 26];
        if node == 0 {
            return -1;
        }
        for b in pref.bytes().iter() {
            node = self.next[node * 27 + (*b - b'a') as i64];
            if node == 0 {
                return -1;
            }
        }
        self.last[node]
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn words_of(text: String) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for w in text.split(" ") {
        words.push(String.from(w));
    }
    words
}

// One filter and its queries, given as "pref suff" pairs.
fn show(text: String, queries: Vec[(String, String)]) {
    let filter = WordFilter.new(words_of(text.clone()));
    let mut line = String.from("[");
    line.push_str(text.as_str());
    line.push_str("]:");
    for q in queries.iter() {
        let got = filter.f(q.0.clone(), q.1.clone());
        line.push_str(f" f({q.0}, {q.1}) = {got}".as_str());
    }
    println(line);
}

fn random_word(seed: mut ref i64, longest: i64, letters: i64) -> String {
    let mut s = String.new();
    let n = 1 + next_random(mut seed) % longest;
    for _ in 0..n {
        s.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    s
}

fn main() {
    show(String.from("apple"), [(String.from("a"), String.from("e"))]);
    show(String.from("apple apply ape pale"), [(String.from("a"), String.from("e")), (String.from("ap"), String.from("y")), (String.from("p"), String.from("e")), (String.from("apple"), String.from("apple")), (String.from("b"), String.from("e"))]);
    show(String.from("abc abc"), [(String.from("a"), String.from("c")), (String.from("abc"), String.from("abc"))]);
    show(String.from("a ab ba"), [(String.from("a"), String.from("a")), (String.from("ab"), String.from("ab")), (String.from("aba"), String.from("a")), (String.from("b"), String.from("a"))]);
    show(String.from("abcdefg gfedcba"), [(String.from("abcdefg"), String.from("g")), (String.from("g"), String.from("gfedcba")), (String.from("abc"), String.from("cba"))]);

    let mut seed = 745;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..10000 {
        words.push(random_word(mut seed, 7, 5));
    }
    let filter = WordFilter.new(words);
    let mut found = 0;
    let mut sum = 0;
    for _ in 0..3000 {
        let pref = random_word(mut seed, 4, 5);
        let suff = random_word(mut seed, 4, 5);
        let got = filter.f(pref, suff);
        if got != -1 {
            found += 1;
            sum += got;
        }
    }
    println(f"10000 words of up to 7 letters from a to e, 3000 queries: {found} found, indices sum to {sum}");

    let mut hits = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 10;
        let mut small: Vec[String] = Vec.new();
        for _ in 0..n {
            small.push(random_word(mut seed, 4, 3));
        }
        let filter = WordFilter.new(small);
        for _ in 0..10 {
            let pref = random_word(mut seed, 3, 3);
            let suff = random_word(mut seed, 3, 3);
            let got = filter.f(pref, suff);
            if got != -1 {
                hits += 1;
            }
            check = (check * 31 + got + 2) % 1000000007;
        }
    }
    println(f"300 random filters, 3000 queries: {hits} found, checksum {check}");
}
