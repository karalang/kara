// LeetCode #714: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random prices.

// ---- ★ arm ----------------------------------------------------------

fn max_profit_star(prices: Vec[i64], fee: i64) -> i64 {
    let mut cash = 0;
    let mut hold = -prices[0];
    for i in 1..prices.len() {
        let sold = hold + prices[i] - fee;
        if sold > cash {
            cash = sold;
        }
        let bought = cash - prices[i];
        if bought > hold {
            hold = bought;
        }
    }
    cash
}

// ---- table arm ------------------------------------------------------

fn max_profit_table(prices: Vec[i64], fee: i64) -> i64 {
    let n = prices.len();
    let mut best: Vec[Vec[i64]] = Vec.new();
    best.push([0, -prices[0]]);
    for i in 1..n {
        let rest = best[i - 1][0];
        let held = best[i - 1][1];
        let sell = held + prices[i] - fee;
        let buy = rest - prices[i];
        let cash = if sell > rest { sell } else { rest };
        let hold = if buy > held { buy } else { held };
        best.push([cash, hold]);
    }
    best[n - 1][0]
}

// ---- greedy arm -----------------------------------------------------

fn max_profit_greedy(prices: Vec[i64], fee: i64) -> i64 {
    let mut buy = prices[0] + fee;
    let mut profit = 0;
    for i in 1..prices.len() {
        if prices[i] + fee < buy {
            buy = prices[i] + fee;
        } else if prices[i] > buy {
            profit += prices[i] - buy;
            buy = prices[i];
        }
    }
    profit
}

// ---- suffix arm -----------------------------------------------------

fn max_profit_suffix(prices: Vec[i64], fee: i64) -> i64 {
    let n = prices.len();
    let mut free: Vec[i64] = Vec.new();
    let mut held: Vec[i64] = Vec.new();
    for _ in 0..n + 1 {
        free.push(0);
        held.push(0);
    }
    let mut i = n - 1;
    while i >= 0 {
        let wait_free = free[i + 1];
        let buy = held[i + 1] - prices[i];
        free[i] = if buy > wait_free { buy } else { wait_free };
        let wait_held = held[i + 1];
        let sell = free[i + 1] + prices[i] - fee;
        held[i] = if sell > wait_held { sell } else { wait_held };
        i -= 1;
    }
    free[0]
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn profit(which: i64, prices: Vec[i64], fee: i64) -> i64 {
    if which == 0 {
        max_profit_star(prices, fee)
    } else if which == 1 {
        max_profit_table(prices, fee)
    } else if which == 2 {
        max_profit_greedy(prices, fee)
    } else {
        max_profit_suffix(prices, fee)
    }
}

// The definition: every set of days of even size, read in order as
// buy, sell, buy, sell, ...; each pair earns the sale less the purchase
// and the fee. The best total, or 0 for no trade. A sale and a purchase
// on the same day never beat holding through it, so no set needs a day
// twice.
fn definition(prices: Vec[i64], fee: i64) -> i64 {
    let n = prices.len();
    let mut best = 0;
    for mask in 0..(1 << n) {
        let mut days: Vec[i64] = Vec.new();
        for d in 0..n {
            if (mask >> d) & 1 == 1 {
                days.push(d);
            }
        }
        if days.len() % 2 == 1 {
            continue;
        }
        let mut total = 0;
        let mut t = 0;
        while t < days.len() {
            total += prices[days[t + 1]] - prices[days[t]] - fee;
            t += 2;
        }
        if total > best {
            best = total;
        }
    }
    best
}

fn main() {
    let mut seed = 7140;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut earned = 0;
    let cases = 3000;
    for _ in 0..cases {
        let n = 1 + next_random(mut seed) % 11;
        let top = 1 + next_random(mut seed) % 20;
        let mut prices: Vec[i64] = Vec.new();
        for _ in 0..n {
            prices.push(1 + next_random(mut seed) % top);
        }
        let fee = next_random(mut seed) % 6;
        let lift = 1 + next_random(mut seed) % 1000;
        let want = definition(prices, fee);
        if want > 0 {
            earned += 1;
        }
        let mut lifted: Vec[i64] = Vec.new();
        let mut doubled: Vec[i64] = Vec.new();
        for p in prices.iter() {
            lifted.push(*p + lift);
            doubled.push(*p * 2);
        }
        for which in 0..arms {
            let got = profit(which, prices, fee);
            // P1: the definition's profit.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: every price raised by the same amount, the same
            // profit.
            checks += 1;
            if profit(which, lifted, fee) != got {
                fails[1] += 1;
            }
            // P3: every price and the fee doubled, the profit doubled.
            checks += 1;
            if profit(which, doubled, 2 * fee) != 2 * got {
                fails[2] += 1;
            }
            // P4: a fee one higher loses at most one per trade, and
            // there are at most n / 2 trades.
            checks += 1;
            let dearer = profit(which, prices, fee + 1);
            if dearer > got or got - dearer > n / 2 {
                fails[3] += 1;
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{cases} price lists ({earned} with a profit), {arms} arms, {checks} checks, {total} failures");
}
