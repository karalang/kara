// LeetCode 798 — Smallest Rotation with Highest Score, a difference
// array over the rotations.
//
// Rotating by k puts nums[i] at index (i - k) mod n, where it scores
// when that index is at least nums[i]. So nums[i] scores for the k from
// i + 1 round to i - nums[i], a run of n - nums[i] rotations that may
// wrap past n - 1 to 0. Add 1 over each run in a difference array, add
// it up, and take the first k with the most. O(n).
fn best_rotation(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut change: Vec[i64] = Vec.new();
    for _ in 0..n + 1 {
        change.push(0);
    }
    for i in 0..n {
        let first = (i + 1) % n;
        let last = (i - nums[i] + n) % n;
        change[first] += 1;
        change[last + 1] -= 1;
        if first > last {
            // The run wraps past n - 1, so last + 1 comes before first
            // and the two marks take 1 off the gap between its two
            // pieces; adding 1 everywhere makes that 0 and the pieces 1.
            change[0] += 1;
            change[n] -= 1;
        }
    }
    let mut best = 0;
    let mut best_score = -1;
    let mut score = 0;
    for k in 0..n {
        score += change[k];
        if score > best_score {
            best_score = score;
            best = k;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    let mut text = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            text.push_str(", ");
        }
        text.push_str(f"{nums[i]}");
    }
    println(f"nums = [{text}] -> {best_rotation(nums)}");
}

fn main() {
    show(vec![2, 3, 1, 4, 0]);
    show(vec![1, 3, 0, 2, 4]);
    show(vec![0]);
    show(vec![0, 0, 0, 0, 0]);
    show(vec![4, 4, 4, 4, 4]);
    show(vec![0, 1, 2, 3, 4]);
    show(vec![4, 3, 2, 1, 0]);
    show(vec![1, 0]);
    let mut seed = 798;
    let mut total = 0;
    let mut check = 0;
    for i in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let top = 1 + next_random(mut seed) % n;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top);
        }
        let k = best_rotation(nums);
        total += k;
        check = (check * 131 + k + i) % 1000000007;
    }
    println(f"300 random arrays: rotations adding up to {total}, checksum {check}");
}
