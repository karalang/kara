// LeetCode #709: To Lower Case -- character by character.
//
// Walk the characters; an uppercase letter, 'A' to 'Z', becomes the
// lowercase one 32 code points above it, and every other character is
// copied as it is. O(n).

fn to_lower_case(s: String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push((c as u32 + 32) as u8 as char);
        } else {
            out.push(c);
        }
    }
    out
}

// ---- benchmark ------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10,000 random printable strings of 100 characters, made once.
    let mut seed: i64 = 709;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..10000 {
        let mut s = String.new();
        for _ in 0..100 {
            s.push((32 + next_random(mut seed) % 95) as u8 as char);
        }
        strings.push(s);
    }
    // Each round lowers every string into a kept result, replacing the
    // one before, and reads a byte of it that moves with the round; the
    // last round's results are summed in full.
    let mut results: Vec[String] = Vec.new();
    for s in strings.iter() {
        results.push(s.clone());
    }
    let mut sum = 0;
    for round in 0..50 {
        for i in 0..10000 {
            results[i] = to_lower_case(strings[i]);
            sum += results[i].bytes()[(round + i) % 100] as i64;
        }
    }
    for t in results.iter() {
        for b in t.bytes() {
            sum += b as i64;
        }
    }
    println(f"50 rounds of 10000 strings of 100 characters: sum {sum}");
}
