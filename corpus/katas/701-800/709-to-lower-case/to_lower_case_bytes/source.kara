// LeetCode #709: To Lower Case -- bytes, in place.
//
// Take the string's bytes and set bit 5 (0x20) on each uppercase
// letter, which is the whole difference between 'A' and 'a' in ASCII;
// then read the bytes back as a string. Every byte stays below 128, so
// they are still valid UTF-8. O(n).

fn to_lower_case(s: String) -> String {
    let mut bytes = s.bytes().to_vec();
    for i in 0..bytes.len() {
        if bytes[i] >= b'A' and bytes[i] <= b'Z' {
            bytes[i] = bytes[i] | 0x20;
        }
    }
    String.from_utf8(bytes).expect("ASCII bytes stay valid UTF-8")
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: String) {
    println(f"\"{s}\" -> \"{to_lower_case(s)}\"");
}

// `n` random printable ASCII characters, from ' ' to '~'.
fn random_string(n: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((32 + next_random(mut seed) % 95) as u8 as char);
    }
    s
}

fn checksum(s: String) -> i64 {
    let mut sum = 0;
    for b in s.bytes() {
        sum = (sum * 131 + b as i64) % 1000000007;
    }
    sum
}

fn main() {
    // The LeetCode examples.
    show("Hello");
    show("here");
    show("LOVELY");
    // One character; the letters either side of 'A' to 'Z' ('@', '[',
    // '`', '{'); every printable character, in order.
    show("Q");
    show("@AZ[`az{");
    let mut all = String.new();
    for b in 32..127 {
        all.push(b as u8 as char);
    }
    show(all);
    // The problem's longest, 100 characters, and 1,000 random strings
    // of 1 to 100.
    let mut seed: i64 = 709;
    show(random_string(100, mut seed));
    let mut sum = 0;
    let mut changed = 0;
    for _ in 0..1000 {
        let n = 1 + next_random(mut seed) % 100;
        let s = random_string(n, mut seed);
        let t = to_lower_case(s.clone());
        if t != s {
            changed += 1;
        }
        sum = (sum * 31 + checksum(t)) % 1000000007;
    }
    println(f"1000 random strings: {changed} changed, checksum {sum}");
}
