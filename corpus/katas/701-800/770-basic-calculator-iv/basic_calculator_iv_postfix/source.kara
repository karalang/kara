// LeetCode 770 — Basic Calculator IV, shunting-yard to postfix.
//
// Turn the tokens into postfix order with Dijkstra's shunting-yard: an
// operand goes straight out, an operator first sends out every operator
// waiting on the stack that binds at least as tightly, and a closing
// bracket sends out everything back to its opening one. Then evaluate the
// postfix with a stack of polynomials, kept as maps from a term's sorted,
// `*`-joined variables to its coefficient.

fn tokenize(expression: String) -> Vec[String] {
    let mut tokens: Vec[String] = Vec.new();
    let mut word = String.new();
    for c in expression.chars() {
        if c.is_ascii_alphanumeric() {
            word.push(c);
        } else {
            if word.len() > 0 {
                tokens.push(word.clone());
                word = String.new();
            }
            if c != ' ' {
                tokens.push(c.to_string());
            }
        }
    }
    if word.len() > 0 {
        tokens.push(word);
    }
    tokens
}

fn joined(names: Vec[String]) -> String {
    let mut key = String.new();
    for i in 0..names.len() {
        if i > 0 {
            key.push('*');
        }
        key.push_str(names[i]);
    }
    key
}

fn names_of(key: String) -> Vec[String] {
    let mut names: Vec[String] = Vec.new();
    if key.len() > 0 {
        for name in key.split("*") {
            names.push(name.to_string());
        }
    }
    names
}

fn add_into(total: mut ref Map[String, i64], p: Map[String, i64], sign: i64) {
    for (key, coef) in p {
        let sum = (total.get(key) ?? 0) + sign * coef;
        total.insert(key.clone(), sum);
    }
}

fn multiply(a: Map[String, i64], b: Map[String, i64]) -> Map[String, i64] {
    let mut product: Map[String, i64] = Map.new();
    for (ka, ca) in a {
        for (kb, cb) in b {
            let mut names = names_of(ka);
            for name in names_of(kb).into_iter() {
                names.push(name);
            }
            names.sort();
            let key = joined(names);
            let sum = (product.get(key) ?? 0) + ca * cb;
            product.insert(key, sum);
        }
    }
    product
}

fn binding(op: String) -> i64 {
    if op == "*" { 2 } else if op == "(" { 0 } else { 1 }
}

fn basic_calculator_iv(expression: String, evalvars: Vec[String], evalints: Vec[i64]) -> Vec[String] {
    let mut known: Map[String, i64] = Map.new();
    for i in 0..evalvars.len() {
        known.insert(evalvars[i].clone(), evalints[i]);
    }
    let mut out: Vec[String] = Vec.new();
    let mut ops: Vec[String] = Vec.new();
    for token in tokenize(expression).into_iter() {
        if token == "(" {
            ops.push(token);
        } else if token == ")" {
            while ops[ops.len() - 1] != "(" {
                out.push(ops.pop().unwrap());
            }
            ops.pop();
        } else if token == "+" or token == "-" or token == "*" {
            while ops.len() > 0 and binding(ops[ops.len() - 1]) >= binding(token) {
                out.push(ops.pop().unwrap());
            }
            ops.push(token);
        } else {
            out.push(token);
        }
    }
    while ops.len() > 0 {
        out.push(ops.pop().unwrap());
    }
    let mut stack: Vec[Map[String, i64]] = Vec.new();
    for token in out {
        if token == "+" or token == "-" or token == "*" {
            let b = stack.pop().unwrap();
            let mut a = stack.pop().unwrap();
            if token == "*" {
                stack.push(multiply(a, b));
            } else {
                add_into(mut a, b, if token == "+" { 1 } else { -1 });
                stack.push(a);
            }
        } else {
            let mut p: Map[String, i64] = Map.new();
            if token.chars().next().unwrap().is_ascii_digit() {
                p.insert(String.new(), i64.parse(token).unwrap());
            } else {
                match known.get(token) {
                    Some(value) => {
                        p.insert(String.new(), *value);
                    }
                    None => {
                        p.insert(token.clone(), 1);
                    }
                }
            }
            stack.push(p);
        }
    }
    let poly = stack.pop().unwrap();
    // highest degree first, then by the variables, the constant last
    let mut terms: Vec[(i64, String, i64)] = Vec.new();
    for (key, coef) in poly {
        if coef != 0 {
            terms.push((-names_of(key).len(), key.clone(), coef));
        }
    }
    terms.sort();
    let mut answer: Vec[String] = Vec.new();
    for (_, key, coef) in terms {
        if key.len() == 0 {
            answer.push(f"{coef}");
        } else {
            answer.push(f"{coef}*{key}");
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn quoted(answer: Vec[String]) -> String {
    let mut out = "[".to_string();
    for i in 0..answer.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"\"{answer[i]}\"");
    }
    out.push_str("]");
    out
}

fn show(expression: String, evalvars: Vec[String], evalints: Vec[i64]) {
    let answer = basic_calculator_iv(expression, evalvars, evalints);
    let shown = quoted(answer);
    println(f"{expression} -> {shown}");
}

// A random expression of about `size` leaves over the variables a to d,
// x and y, and numbers up to 9, with + - * and brackets.
fn random_expression(seed: mut ref i64, size: i64) -> String {
    if size <= 1 {
        let pick = next_random(mut seed) % 9;
        if pick < 3 {
            return f"{next_random(mut seed) % 10}";
        }
        let names = ["a", "b", "c", "d", "x", "y"];
        return names[pick - 3].to_string();
    }
    let left = 1 + next_random(mut seed) % (size - 1);
    let a = random_expression(mut seed, left);
    let b = random_expression(mut seed, size - left);
    let ops = [" + ", " - ", " * "];
    let op = ops[next_random(mut seed) % 3].to_string();
    if next_random(mut seed) % 3 == 0 {
        f"({a}{op}{b})"
    } else {
        f"{a}{op}{b}"
    }
}

fn main() {
    show("e + 8 - a + 5", ["e"], [1]);
    show("e - 8 + temperature - pressure", ["e", "temperature"], [1, 12]);
    show("(e + 8) * (e - 8)", [], []);
    show("7 - 7", [], []);
    show("a * b * c + b * a * c * 4", [], []);
    show("((a - b) * (b - c) + (c - a)) * ((a - b) + (b - c) * (c - a))", [], []);
    show("x * y - y * x + 0", [], []);
    show("a * 0 + 12 * (b - b) - 3", ["b"], [5]);
    let mut seed = 770;
    let mut terms = 0;
    let mut check = 0;
    for _ in 0..300 {
        let size = 1 + next_random(mut seed) % 12;
        let expression = random_expression(mut seed, size);
        let mut evalvars: Vec[String] = Vec.new();
        let mut evalints: Vec[i64] = Vec.new();
        if next_random(mut seed) % 2 == 0 {
            evalvars.push("x".to_string());
            evalints.push(next_random(mut seed) % 7 - 3);
        }
        let answer = basic_calculator_iv(expression, evalvars, evalints);
        terms += answer.len();
        for t in answer {
            for b in t.bytes() {
                check = (check * 31 + b as i64) % 1000000007;
            }
        }
    }
    println(f"300 random expressions: {terms} terms in all, checksum {check}");
}
