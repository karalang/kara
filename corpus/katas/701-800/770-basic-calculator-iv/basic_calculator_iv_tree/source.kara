// LeetCode 770 — Basic Calculator IV, an expression tree.
//
// Parse the tokens by precedence climbing into a tree of `shared enum`
// nodes, then evaluate the tree. Here a polynomial is a list of terms
// sorted by their variables, sorted and joined by `*` ("" for the
// constant), with no zero coefficients: a sum merges two such lists, and
// a product forms every pair and sorts and combines them.

shared enum Expr {
    Num(i64),
    Var(String),
    Op(String, Expr, Expr),
}

struct Tokens {
    list: Vec[String],
    at: i64,
}

fn tokenize(expression: String) -> Vec[String] {
    let mut tokens: Vec[String] = Vec.new();
    let mut word = String.new();
    for c in expression.chars() {
        if c.is_ascii_alphanumeric() {
            word.push(c);
        } else {
            if word.len() > 0 {
                tokens.push(word.clone());
                word = String.new();
            }
            if c != ' ' {
                tokens.push(c.to_string());
            }
        }
    }
    if word.len() > 0 {
        tokens.push(word);
    }
    tokens
}

fn joined(names: Vec[String]) -> String {
    let mut key = String.new();
    for i in 0..names.len() {
        if i > 0 {
            key.push('*');
        }
        key.push_str(names[i]);
    }
    key
}

fn names_of(key: String) -> Vec[String] {
    let mut names: Vec[String] = Vec.new();
    if key.len() > 0 {
        for name in key.split("*") {
            names.push(name.to_string());
        }
    }
    names
}

// Everything up to the first operator binding more loosely than `min`.
fn parse(t: mut ref Tokens, min: i64) -> Expr {
    let mut left = atom(mut t);
    while t.at < t.list.len() {
        let op = t.list[t.at].clone();
        let power = if op == "*" { 2 } else if op == "+" or op == "-" { 1 } else { 0 };
        if power == 0 or power < min {
            break;
        }
        t.at += 1;
        let right = parse(mut t, power + 1);
        left = Expr.Op(op, left, right);
    }
    left
}

fn atom(t: mut ref Tokens) -> Expr {
    let token = t.list[t.at].clone();
    t.at += 1;
    if token == "(" {
        let inside = parse(mut t, 1);
        t.at += 1;
        inside
    } else if token.chars().next().unwrap().is_ascii_digit() {
        Expr.Num(i64.parse(token).unwrap())
    } else {
        Expr.Var(token)
    }
}

// Sorts the terms, adds up those with the same variables and drops zeros.
fn normal(terms: own Vec[(String, i64)]) -> Vec[(String, i64)] {
    let mut terms = terms;
    terms.sort();
    let mut out: Vec[(String, i64)] = Vec.new();
    for (key, coef) in terms {
        if out.len() > 0 and out[out.len() - 1].0 == key {
            let last = out.len() - 1;
            out[last].1 += coef;
        } else {
            out.push((key.clone(), coef));
        }
    }
    let mut kept: Vec[(String, i64)] = Vec.new();
    for (key, coef) in out {
        if coef != 0 {
            kept.push((key.clone(), coef));
        }
    }
    kept
}

fn plus(a: Vec[(String, i64)], b: Vec[(String, i64)], sign: i64) -> Vec[(String, i64)] {
    let mut out: Vec[(String, i64)] = Vec.new();
    let mut (i, j) = (0, 0);
    while i < a.len() or j < b.len() {
        if j == b.len() or (i < a.len() and a[i].0 < b[j].0) {
            out.push(a[i].clone());
            i += 1;
        } else if i == a.len() or b[j].0 < a[i].0 {
            out.push((b[j].0.clone(), sign * b[j].1));
            j += 1;
        } else {
            let coef = a[i].1 + sign * b[j].1;
            if coef != 0 {
                out.push((a[i].0.clone(), coef));
            }
            i += 1;
            j += 1;
        }
    }
    out
}

fn times(a: Vec[(String, i64)], b: Vec[(String, i64)]) -> Vec[(String, i64)] {
    let mut terms: Vec[(String, i64)] = Vec.new();
    for (ka, ca) in a {
        for (kb, cb) in b {
            let mut names: Vec[String] = Vec.new();
            for part in [ka, kb] {
                if part.len() > 0 {
                    for name in part.split("*") {
                        names.push(name.to_string());
                    }
                }
            }
            names.sort();
            terms.push((joined(names), ca * cb));
        }
    }
    normal(terms)
}

fn evaluate(e: Expr, known: Map[String, i64]) -> Vec[(String, i64)] {
    match e {
        Expr.Num(n) => normal([(String.new(), n)]),
        Expr.Var(name) => match known.get(name) {
            Some(value) => normal([(String.new(), *value)]),
            None => [(name.clone(), 1)],
        },
        Expr.Op(op, a, b) => {
            let pa = evaluate(a, known);
            let pb = evaluate(b, known);
            if op == "*" {
                times(pa, pb)
            } else {
                plus(pa, pb, if op == "+" { 1 } else { -1 })
            }
        }
    }
}

fn basic_calculator_iv(expression: String, evalvars: Vec[String], evalints: Vec[i64]) -> Vec[String] {
    let mut known: Map[String, i64] = Map.new();
    for i in 0..evalvars.len() {
        known.insert(evalvars[i].clone(), evalints[i]);
    }
    let mut t = Tokens { list: tokenize(expression), at: 0 };
    let tree = parse(mut t, 1);
    // highest degree first, then by the variables, the constant last
    let mut terms: Vec[(i64, String, i64)] = Vec.new();
    for (key, coef) in evaluate(tree, known) {
        let degree = if key.len() == 0 { 0 } else { key.split("*").count() };
        terms.push((-degree, key.clone(), coef));
    }
    terms.sort();
    let mut answer: Vec[String] = Vec.new();
    for (_, key, coef) in terms {
        if key.len() == 0 {
            answer.push(f"{coef}");
        } else {
            answer.push(f"{coef}*{key}");
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn quoted(answer: Vec[String]) -> String {
    let mut out = "[".to_string();
    for i in 0..answer.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"\"{answer[i]}\"");
    }
    out.push_str("]");
    out
}

fn show(expression: String, evalvars: Vec[String], evalints: Vec[i64]) {
    let answer = basic_calculator_iv(expression, evalvars, evalints);
    let shown = quoted(answer);
    println(f"{expression} -> {shown}");
}

// A random expression of about `size` leaves over the variables a to d,
// x and y, and numbers up to 9, with + - * and brackets.
fn random_expression(seed: mut ref i64, size: i64) -> String {
    if size <= 1 {
        let pick = next_random(mut seed) % 9;
        if pick < 3 {
            return f"{next_random(mut seed) % 10}";
        }
        let names = ["a", "b", "c", "d", "x", "y"];
        return names[pick - 3].to_string();
    }
    let left = 1 + next_random(mut seed) % (size - 1);
    let a = random_expression(mut seed, left);
    let b = random_expression(mut seed, size - left);
    let ops = [" + ", " - ", " * "];
    let op = ops[next_random(mut seed) % 3].to_string();
    if next_random(mut seed) % 3 == 0 {
        f"({a}{op}{b})"
    } else {
        f"{a}{op}{b}"
    }
}

fn main() {
    show("e + 8 - a + 5", ["e"], [1]);
    show("e - 8 + temperature - pressure", ["e", "temperature"], [1, 12]);
    show("(e + 8) * (e - 8)", [], []);
    show("7 - 7", [], []);
    show("a * b * c + b * a * c * 4", [], []);
    show("((a - b) * (b - c) + (c - a)) * ((a - b) + (b - c) * (c - a))", [], []);
    show("x * y - y * x + 0", [], []);
    show("a * 0 + 12 * (b - b) - 3", ["b"], [5]);
    let mut seed = 770;
    let mut terms = 0;
    let mut check = 0;
    for _ in 0..300 {
        let size = 1 + next_random(mut seed) % 12;
        let expression = random_expression(mut seed, size);
        let mut evalvars: Vec[String] = Vec.new();
        let mut evalints: Vec[i64] = Vec.new();
        if next_random(mut seed) % 2 == 0 {
            evalvars.push("x".to_string());
            evalints.push(next_random(mut seed) % 7 - 3);
        }
        let answer = basic_calculator_iv(expression, evalvars, evalints);
        terms += answer.len();
        for t in answer {
            for b in t.bytes() {
                check = (check * 31 + b as i64) % 1000000007;
            }
        }
    }
    println(f"300 random expressions: {terms} terms in all, checksum {check}");
}
