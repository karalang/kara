// LeetCode 770 — Basic Calculator IV: benchmark, the ★ arm.
//
// Sixty-four random expressions of 40 leaves, near LeetCode's limit of
// 250 characters, built once, over the variables a to d, x and y with x
// given a value. 20,000 rounds each simplify the next of them and fold
// the answer's characters into a checksum.

struct Reader {
    tokens: Vec[String],
    at: i64,
    known: Map[String, i64],
}

fn tokenize(expression: String) -> Vec[String] {
    let mut tokens: Vec[String] = Vec.new();
    let mut word = String.new();
    for c in expression.chars() {
        if c.is_ascii_alphanumeric() {
            word.push(c);
        } else {
            if word.len() > 0 {
                tokens.push(word.clone());
                word = String.new();
            }
            if c != ' ' {
                tokens.push(c.to_string());
            }
        }
    }
    if word.len() > 0 {
        tokens.push(word);
    }
    tokens
}

fn joined(names: Vec[String]) -> String {
    let mut key = String.new();
    for i in 0..names.len() {
        if i > 0 {
            key.push('*');
        }
        key.push_str(names[i]);
    }
    key
}

fn names_of(key: String) -> Vec[String] {
    let mut names: Vec[String] = Vec.new();
    if key.len() > 0 {
        for name in key.split("*") {
            names.push(name.to_string());
        }
    }
    names
}

fn add_into(total: mut ref Map[String, i64], p: Map[String, i64], sign: i64) {
    for (key, coef) in p {
        let sum = (total.get(key) ?? 0) + sign * coef;
        total.insert(key.clone(), sum);
    }
}

fn multiply(a: Map[String, i64], b: Map[String, i64]) -> Map[String, i64] {
    let mut product: Map[String, i64] = Map.new();
    for (ka, ca) in a {
        for (kb, cb) in b {
            let mut names = names_of(ka);
            for name in names_of(kb).into_iter() {
                names.push(name);
            }
            names.sort();
            let key = joined(names);
            let sum = (product.get(key) ?? 0) + ca * cb;
            product.insert(key, sum);
        }
    }
    product
}

impl Reader {
    fn peek(self) -> String {
        if self.at < self.tokens.len() { self.tokens[self.at].clone() } else { String.new() }
    }

    fn expression(mut ref self) -> Map[String, i64] {
        let mut total = self.term();
        while self.peek() == "+" or self.peek() == "-" {
            let sign = if self.peek() == "+" { 1 } else { -1 };
            self.at += 1;
            let next = self.term();
            add_into(mut total, next, sign);
        }
        total
    }

    fn term(mut ref self) -> Map[String, i64] {
        let mut product = self.factor();
        while self.peek() == "*" {
            self.at += 1;
            let next = self.factor();
            product = multiply(product, next);
        }
        product
    }

    fn factor(mut ref self) -> Map[String, i64] {
        let token = self.peek();
        self.at += 1;
        let mut p: Map[String, i64] = Map.new();
        if token == "(" {
            p = self.expression();
            self.at += 1;
        } else if token.chars().next().unwrap().is_ascii_digit() {
            p.insert(String.new(), i64.parse(token).unwrap());
        } else {
            match self.known.get(token) {
                Some(value) => {
                    p.insert(String.new(), *value);
                }
                None => {
                    p.insert(token, 1);
                }
            }
        }
        p
    }
}

fn basic_calculator_iv(expression: String, evalvars: Vec[String], evalints: Vec[i64]) -> Vec[String] {
    let mut known: Map[String, i64] = Map.new();
    for i in 0..evalvars.len() {
        known.insert(evalvars[i].clone(), evalints[i]);
    }
    let mut parser = Reader { tokens: tokenize(expression), at: 0, known: known };
    let poly = parser.expression();
    // highest degree first, then by the variables, the constant last
    let mut terms: Vec[(i64, String, i64)] = Vec.new();
    for (key, coef) in poly {
        if coef != 0 {
            terms.push((-names_of(key).len(), key.clone(), coef));
        }
    }
    terms.sort();
    let mut answer: Vec[String] = Vec.new();
    for (_, key, coef) in terms {
        if key.len() == 0 {
            answer.push(f"{coef}");
        } else {
            answer.push(f"{coef}*{key}");
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random expression of about `size` leaves over the variables a to d,
// x and y, and numbers up to 9, with + - * and brackets.
fn random_expression(seed: mut ref i64, size: i64) -> String {
    if size <= 1 {
        let pick = next_random(mut seed) % 9;
        if pick < 3 {
            return f"{next_random(mut seed) % 10}";
        }
        let names = ["a", "b", "c", "d", "x", "y"];
        return names[pick - 3].to_string();
    }
    let left = 1 + next_random(mut seed) % (size - 1);
    let a = random_expression(mut seed, left);
    let b = random_expression(mut seed, size - left);
    let ops = [" + ", " - ", " * "];
    let op = ops[next_random(mut seed) % 3].to_string();
    if next_random(mut seed) % 3 == 0 {
        f"({a}{op}{b})"
    } else {
        f"{a}{op}{b}"
    }
}

fn main() {
    let rounds = 20000;
    let mut seed = 770;
    let mut pool: Vec[String] = Vec.new();
    let mut longest = 0;
    for _ in 0..64 {
        let e = random_expression(mut seed, 40);
        longest = longest.max(e.len());
        pool.push(e);
    }
    let mut terms = 0;
    let mut check = 0;
    for round in 0..rounds {
        let answer = basic_calculator_iv(pool[round % 64], ["x"], [round % 7 - 3]);
        terms += answer.len();
        for t in answer {
            for b in t.bytes() {
                check = (check * 31 + b as i64) % 1000000007;
            }
        }
    }
    println(f"{rounds} expressions of up to {longest} characters: {terms} terms in all, checksum {check}");
}
