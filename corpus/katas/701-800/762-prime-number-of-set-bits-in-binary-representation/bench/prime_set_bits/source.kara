// LeetCode 762 — Prime Number of Set Bits in Binary Representation:
// benchmark, the ★ arm.
//
// 10,000 random ranges of 10,001 numbers from 1 to 10^6, the widest
// LeetCode allows.

fn count_prime_set_bits(left: i64, right: i64) -> i64 {
    let mut count = 0;
    for n in left..right + 1 {
        let mut bits = 0;
        let mut rest = n;
        while rest > 0 {
            rest &= rest - 1;
            bits += 1;
        }
        match bits {
            2 | 3 | 5 | 7 | 11 | 13 | 17 | 19 => count += 1,
            _ => {}
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 10000;
    let mut seed = 762;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        let left = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 990000;
        let count = count_prime_set_bits(left, left + 10000);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"{rounds} ranges of 10001 numbers: {total} counted, checksum {check}");
}
