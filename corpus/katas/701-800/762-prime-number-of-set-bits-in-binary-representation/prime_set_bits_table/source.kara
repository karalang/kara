// LeetCode 762 — Prime Number of Set Bits in Binary Representation, from
// a table.
//
// Build the bit counts of 0 to 1023 from smaller ones, since n has the bits
// of n / 2 and one more if n is odd, and sieve the primes up to 64. A
// number's bits are then those of its 10-bit pieces, looked up and added.
// O(right - left).

fn count_prime_set_bits(left: i64, right: i64) -> i64 {
    let mut bits: Vec[i64] = [0];
    for n in 1..1024 {
        bits.push(bits[n / 2] + n % 2);
    }
    let mut prime: Vec[bool] = Vec.new();
    for k in 0..65 {
        prime.push(k >= 2);
    }
    for k in 2..9 {
        if prime[k] {
            let mut multiple = k * k;
            while multiple <= 64 {
                prime[multiple] = false;
                multiple += k;
            }
        }
    }
    let mut count = 0;
    for n in left..right + 1 {
        let mut total = 0;
        let mut rest = n;
        while rest > 0 {
            total += bits[rest % 1024];
            rest /= 1024;
        }
        if prime[total] {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(left: i64, right: i64) {
    let count = count_prime_set_bits(left, right);
    println(f"[{left}, {right}] -> {count}");
}

fn main() {
    show(6, 10);
    show(10, 15);
    show(1, 1);
    show(3, 3);
    show(1, 10000);
    show(990000, 1000000);
    show(524287, 524288);
    let mut seed = 762;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let left = 1 + wide_random(mut seed) % 1000000;
        let right = left + wide_random(mut seed) % 10001;
        let count = count_prime_set_bits(left, right);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"300 random ranges: {total} numbers counted, checksum {check}");
}
