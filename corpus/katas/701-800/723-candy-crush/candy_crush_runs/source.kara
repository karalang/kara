// LeetCode #723: Candy Crush -- whole runs measured.
//
// Each row and each column is cut into maximal runs of one candy, and
// every run of three or more is marked whole. Then each column's
// survivors are gathered from the bottom into a list and written back
// below the empty cells.

fn candy_crush(board: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut b = board.clone();
    let m = b.len();
    let n = b[0].len();
    let mut any = true;
    while any {
        any = false;
        let mut crush: Vec[Vec[bool]] = Vec.new();
        for _ in 0..m {
            crush.push(vec![false; n]);
        }
        for r in 0..m {
            let mut start = 0;
            while start < n {
                let mut end = start + 1;
                while end < n and b[r][end] == b[r][start] {
                    end += 1;
                }
                if b[r][start] != 0 and end - start >= 3 {
                    for c in start..end {
                        crush[r][c] = true;
                    }
                    any = true;
                }
                start = end;
            }
        }
        for c in 0..n {
            let mut start = 0;
            while start < m {
                let mut end = start + 1;
                while end < m and b[end][c] == b[start][c] {
                    end += 1;
                }
                if b[start][c] != 0 and end - start >= 3 {
                    for r in start..end {
                        crush[r][c] = true;
                    }
                    any = true;
                }
                start = end;
            }
        }
        for c in 0..n {
            let mut kept: Vec[i64] = Vec.new();
            let mut r = m - 1;
            while r >= 0 {
                if not crush[r][c] and b[r][c] != 0 {
                    kept.push(b[r][c]);
                }
                r -= 1;
            }
            for k in 0..m {
                b[m - 1 - k][c] = if k < kept.len() { kept[k] } else { 0 };
            }
        }
    }
    b
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_board(m: i64, n: i64, kinds: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut board: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(1 + next_random(mut seed) % kinds);
        }
        board.push(row);
    }
    board
}

fn fold(board: Vec[Vec[i64]], start: i64) -> i64 {
    let mut sum = start;
    for row in board.iter() {
        for v in row.iter() {
            sum = (sum * 31 + *v) % 1000000007;
        }
    }
    sum
}

fn empty(board: Vec[Vec[i64]]) -> i64 {
    let mut count = 0;
    for row in board.iter() {
        for v in row.iter() {
            if *v == 0 {
                count += 1;
            }
        }
    }
    count
}

fn show(board: Vec[Vec[i64]]) {
    println(f"{candy_crush(board)}");
}

fn main() {
    show([
        [110, 5, 112, 113, 114], [210, 211, 5, 213, 214], [310, 311, 3, 313, 314],
        [410, 411, 412, 5, 414], [5, 1, 512, 3, 3], [610, 4, 1, 613, 614],
        [710, 1, 2, 713, 714], [810, 1, 2, 1, 1], [1, 1, 2, 2, 2], [4, 1, 4, 4, 1014],
    ]);
    show([[1, 3, 5, 5, 2], [3, 4, 3, 3, 1], [3, 2, 4, 5, 2], [2, 4, 4, 5, 5], [1, 4, 4, 1, 1]]);
    show([[1, 2, 3], [4, 5, 6], [7, 8, 9]]);
    show([[7, 7, 7], [7, 7, 7], [7, 7, 7]]);
    show([[1, 1, 1], [2, 2, 1], [3, 4, 1]]);
    show([[2, 2, 2, 2, 2], [1, 3, 3, 3, 3], [4, 5, 6, 7, 8]]);
    show([[1, 5, 6], [2, 7, 8], [2, 9, 4], [2, 1, 1]]);
    show([[1, 2, 3], [1, 2, 3], [1, 4, 3], [5, 4, 6], [5, 4, 6], [5, 7, 6]]);
    let mut seed: i64 = 723;
    for kinds in 3..6 {
        let board = random_board(50, 50, kinds, mut seed);
        let after = candy_crush(board);
        println(f"50 x 50 board of {kinds} kinds: {empty(after)} empty, checksum {fold(after, 0)}");
    }
    let mut sum = 0;
    for _ in 0..300 {
        let m = 3 + next_random(mut seed) % 6;
        let n = 3 + next_random(mut seed) % 6;
        let kinds = 1 + next_random(mut seed) % 4;
        sum = fold(candy_crush(random_board(m, n, kinds, mut seed)), sum);
    }
    println(f"300 random boards: checksum {sum}");
}
