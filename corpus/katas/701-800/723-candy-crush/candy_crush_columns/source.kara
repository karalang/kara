// LeetCode #723: Candy Crush -- the board kept as columns.
//
// Hold each column as a list of its candies from the bottom up, with
// no empty cells, so a drop is only removing entries from a list. A
// candy at height h of column c has neighbours at height h of the
// columns beside it, when those are tall enough. Runs are found on
// that layout, the crushed entries removed, and the board rebuilt from
// the columns at the end.

fn candy_crush(board: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let m = board.len();
    let n = board[0].len();
    let mut cols: Vec[Vec[i64]] = Vec.new();
    for c in 0..n {
        let mut col: Vec[i64] = Vec.new();
        let mut r = m - 1;
        while r >= 0 {
            if board[r][c] != 0 {
                col.push(board[r][c]);
            }
            r -= 1;
        }
        cols.push(col);
    }
    loop {
        let mut crush: Vec[Vec[bool]] = Vec.new();
        for c in 0..n {
            crush.push(vec![false; cols[c].len()]);
        }
        let mut any = false;
        for c in 0..n {
            for h in 0..cols[c].len() {
                let v = cols[c][h];
                if h + 2 < cols[c].len() and cols[c][h + 1] == v and cols[c][h + 2] == v {
                    crush[c][h] = true;
                    crush[c][h + 1] = true;
                    crush[c][h + 2] = true;
                    any = true;
                }
                if c + 2 < n and h < cols[c + 1].len() and h < cols[c + 2].len() and cols[c + 1][h] == v and cols[c + 2][h] == v {
                    crush[c][h] = true;
                    crush[c + 1][h] = true;
                    crush[c + 2][h] = true;
                    any = true;
                }
            }
        }
        if not any {
            break;
        }
        for c in 0..n {
            let mut kept: Vec[i64] = Vec.new();
            for h in 0..cols[c].len() {
                if not crush[c][h] {
                    kept.push(cols[c][h]);
                }
            }
            cols[c] = kept;
        }
    }
    let mut b: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        b.push(vec![0; n]);
    }
    for c in 0..n {
        for h in 0..cols[c].len() {
            b[m - 1 - h][c] = cols[c][h];
        }
    }
    b
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_board(m: i64, n: i64, kinds: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut board: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(1 + next_random(mut seed) % kinds);
        }
        board.push(row);
    }
    board
}

fn fold(board: Vec[Vec[i64]], start: i64) -> i64 {
    let mut sum = start;
    for row in board.iter() {
        for v in row.iter() {
            sum = (sum * 31 + *v) % 1000000007;
        }
    }
    sum
}

fn empty(board: Vec[Vec[i64]]) -> i64 {
    let mut count = 0;
    for row in board.iter() {
        for v in row.iter() {
            if *v == 0 {
                count += 1;
            }
        }
    }
    count
}

fn show(board: Vec[Vec[i64]]) {
    println(f"{candy_crush(board)}");
}

fn main() {
    show([
        [110, 5, 112, 113, 114], [210, 211, 5, 213, 214], [310, 311, 3, 313, 314],
        [410, 411, 412, 5, 414], [5, 1, 512, 3, 3], [610, 4, 1, 613, 614],
        [710, 1, 2, 713, 714], [810, 1, 2, 1, 1], [1, 1, 2, 2, 2], [4, 1, 4, 4, 1014],
    ]);
    show([[1, 3, 5, 5, 2], [3, 4, 3, 3, 1], [3, 2, 4, 5, 2], [2, 4, 4, 5, 5], [1, 4, 4, 1, 1]]);
    show([[1, 2, 3], [4, 5, 6], [7, 8, 9]]);
    show([[7, 7, 7], [7, 7, 7], [7, 7, 7]]);
    show([[1, 1, 1], [2, 2, 1], [3, 4, 1]]);
    show([[2, 2, 2, 2, 2], [1, 3, 3, 3, 3], [4, 5, 6, 7, 8]]);
    show([[1, 5, 6], [2, 7, 8], [2, 9, 4], [2, 1, 1]]);
    show([[1, 2, 3], [1, 2, 3], [1, 4, 3], [5, 4, 6], [5, 4, 6], [5, 7, 6]]);
    let mut seed: i64 = 723;
    for kinds in 3..6 {
        let board = random_board(50, 50, kinds, mut seed);
        let after = candy_crush(board);
        println(f"50 x 50 board of {kinds} kinds: {empty(after)} empty, checksum {fold(after, 0)}");
    }
    let mut sum = 0;
    for _ in 0..300 {
        let m = 3 + next_random(mut seed) % 6;
        let n = 3 + next_random(mut seed) % 6;
        let kinds = 1 + next_random(mut seed) % 4;
        sum = fold(candy_crush(random_board(m, n, kinds, mut seed)), sum);
    }
    println(f"300 random boards: checksum {sum}");
}
