// LeetCode #723: Candy Crush -- crushed cells marked by their sign.
//
// One round: every run of three equal candies, across or down, is
// found by looking at each cell and the two after it, and its cells
// are marked by turning them negative, which keeps their value for the
// runs that overlap them. Then each column drops: the positive cells
// are copied down from the bottom and the rest of the column is
// emptied. Rounds repeat until one marks nothing. O((m * n)^2) at
// worst, since each round crushes at least three candies.

fn candy_crush(board: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut b = board.clone();
    let m = b.len();
    let n = b[0].len();
    let mut stable = false;
    while not stable {
        stable = true;
        for r in 0..m {
            for c in 0..n - 2 {
                let v = b[r][c].abs();
                if v != 0 and b[r][c + 1].abs() == v and b[r][c + 2].abs() == v {
                    b[r][c] = -v;
                    b[r][c + 1] = -v;
                    b[r][c + 2] = -v;
                    stable = false;
                }
            }
        }
        for r in 0..m - 2 {
            for c in 0..n {
                let v = b[r][c].abs();
                if v != 0 and b[r + 1][c].abs() == v and b[r + 2][c].abs() == v {
                    b[r][c] = -v;
                    b[r + 1][c] = -v;
                    b[r + 2][c] = -v;
                    stable = false;
                }
            }
        }
        for c in 0..n {
            let mut write = m - 1;
            let mut r = m - 1;
            while r >= 0 {
                if b[r][c] > 0 {
                    b[write][c] = b[r][c];
                    write -= 1;
                }
                r -= 1;
            }
            while write >= 0 {
                b[write][c] = 0;
                write -= 1;
            }
        }
    }
    b
}

// ---- benchmark ------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 40 boards of 50 x 50 candies of 5 kinds, made once.
    let mut seed: i64 = 723;
    let mut boards: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..40 {
        let mut board: Vec[Vec[i64]] = Vec.new();
        for _ in 0..50 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..50 {
                row.push(1 + next_random(mut seed) % 5);
            }
            board.push(row);
        }
        boards.push(board);
    }
    // 100 rounds: one candy of every board changes kind, then every board
    // is crushed (the function works on its own copy), the empty cells
    // of every result summed.
    let mut sum = 0;
    for round in 0..100 {
        for d in 0..40 {
            let r = (round * 7 + d) % 50;
            let c = (round * 13 + d * 3) % 50;
            boards[d][r][c] = 1 + (boards[d][r][c] + round) % 5;
            let after = candy_crush(boards[d]);
            for row in after.iter() {
                for v in row.iter() {
                    if *v == 0 {
                        sum += 1;
                    }
                }
            }
        }
    }
    println(f"100 rounds of 40 boards of 50 x 50: {sum} empty cells");
}
