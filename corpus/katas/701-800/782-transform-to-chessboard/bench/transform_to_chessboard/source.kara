// Benchmark for #782: Transform to Chessboard -- the ★ arm (the corner
// rule and two counts).
//
// Swapping rows or columns keeps two facts about the board: for any rows
// r, s and columns c, d, the four cells where they cross hold an even
// number of 1s exactly when they did before, and every row keeps its
// number of 1s. A chessboard has an even number in every such rectangle
// and its rows and columns half 1s. So the board can be made one exactly
// when every rectangle with the top left corner is even and the first
// row and column are as near half 1s as n allows; then the rows and the
// columns can be put in order apart. For each, count the places where
// the first column (or row) disagrees with 0101...: each swap fixes two,
// and when n is even the other pattern, 1010..., may need fewer. O(n²).

fn moves_to_chessboard(board: Vec[Vec[i64]]) -> i64 {
    let n = board.len();
    for r in 0..n {
        for c in 0..n {
            if board[0][0] ^ board[r][0] ^ board[0][c] ^ board[r][c] == 1 {
                return -1;
            }
        }
    }
    let mut row_ones = 0;
    let mut col_ones = 0;
    let mut row_off = 0;
    let mut col_off = 0;
    for i in 0..n {
        row_ones += board[0][i];
        col_ones += board[i][0];
        if board[i][0] == i % 2 {
            row_off += 1;
        }
        if board[0][i] == i % 2 {
            col_off += 1;
        }
    }
    if row_ones != n / 2 and row_ones != (n + 1) / 2 {
        return -1;
    }
    if col_ones != n / 2 and col_ones != (n + 1) / 2 {
        return -1;
    }
    if n % 2 == 1 {
        // Only one pattern has the right count; its places off are even.
        if row_off % 2 == 1 {
            row_off = n - row_off;
        }
        if col_off % 2 == 1 {
            col_off = n - col_off;
        }
    } else {
        if n - row_off < row_off {
            row_off = n - row_off;
        }
        if n - col_off < col_off {
            col_off = n - col_off;
        }
    }
    (row_off + col_off) / 2
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 boards of 30 by 30 (LeetCode's most), built once. Each is a
    // chessboard with its rows and columns shuffled; a quarter then have
    // one random cell flipped, and a quarter have their first row
    // replaced by a random row and every other row by it or its flip,
    // so that only the counts can be wrong. Then 2,000,000 rounds each
    // answer the next board.
    let count = 64;
    let n = 30;
    let mut seed: i64 = 782;
    let mut boards: Vec[Vec[Vec[i64]]] = Vec.new();
    for g in 0..count {
        let mut row_of: Vec[i64] = Vec.new();
        let mut col_of: Vec[i64] = Vec.new();
        for i in 0..n {
            row_of.push(i);
            col_of.push(i);
        }
        let mut i = n - 1;
        while i > 0 {
            row_of.swap(i, next_random(mut seed) % (i + 1));
            col_of.swap(i, next_random(mut seed) % (i + 1));
            i -= 1;
        }
        let mut board: Vec[Vec[i64]] = Vec.new();
        for r in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for c in 0..n {
                row.push((row_of[r] + col_of[c]) % 2);
            }
            board.push(row);
        }
        if g % 4 == 1 {
            let r = next_random(mut seed) % n;
            let c = next_random(mut seed) % n;
            board[r][c] = 1 - board[r][c];
        } else if g % 4 == 3 {
            for c in 0..n {
                board[0][c] = next_random(mut seed) % 2;
            }
            for r in 1..n {
                let flip = next_random(mut seed) % 2;
                for c in 0..n {
                    board[r][c] = board[0][c] ^ flip;
                }
            }
        }
        boards.push(board);
    }
    let mut solvable: i64 = 0;
    let mut checksum: i64 = 0;
    for round in 0..2000000 {
        let g = (round * 7) % count;
        let answer = moves_to_chessboard(boards[g]);
        if answer >= 0 {
            solvable += 1;
        }
        checksum = (checksum * 31 + answer + 2 + g) % 1000000007;
    }
    println(f"2000000 rounds of 30 x 30 boards: {solvable} solvable, checksum {checksum}");
}
