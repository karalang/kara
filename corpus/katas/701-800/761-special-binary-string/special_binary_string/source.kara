// LeetCode 761 — Special Binary String, splitting and sorting.
//
// A special string is a run of "mountains", each a 1, a special string
// and a 0. Swapping two consecutive special substrings can reorder the
// mountains at any one level however we like, so the largest string makes
// each mountain's inside as large as it can be, recursively, and then puts
// the mountains in descending order. O(n^2) for a string of length n.

fn make_largest_special(s: String) -> String {
    let chars: Vec[char] = s.chars().collect();
    let mut mountains: Vec[String] = Vec.new();
    let mut depth = 0;
    let mut start = 0;
    for i in 0..chars.len() {
        if chars[i] == '1' {
            depth += 1;
        } else {
            depth -= 1;
        }
        if depth == 0 {
            let inside = make_largest_special(s[start + 1..i].to_string());
            mountains.push(f"1{inside}0");
            start = i + 1;
        }
    }
    mountains.sort_by(|a, b| b.cmp(a));
    mountains.join("")
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random special string of 2m characters: a 1 whenever the string so
// far is balanced, a 0 once all m 1s are used, and otherwise either.
fn random_special(m: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    let mut ones = 0;
    let mut depth = 0;
    for _ in 0..2 * m {
        if ones < m and (depth == 0 or next_random(mut seed) % 2 == 0) {
            s.push('1');
            ones += 1;
            depth += 1;
        } else {
            s.push('0');
            depth -= 1;
        }
    }
    s
}

fn show(s: String) {
    let largest = make_largest_special(s.clone());
    println(f"{s} -> {largest}");
}

fn main() {
    show("11011000");
    show("10");
    show("1100");
    show("101100");
    show("10101010");
    show("110100");
    show("1011011000");
    show("1101001110001100");
    let mut seed = 761;
    let mut changed = 0;
    let mut check = 0;
    for _ in 0..300 {
        let m = 1 + next_random(mut seed) % 25;
        let s = random_special(m, mut seed);
        let largest = make_largest_special(s.clone());
        if largest != s {
            changed += 1;
        }
        for c in largest.chars() {
            check = (check * 2 + if c == '1' { 1 } else { 0 }) % 1000000007;
        }
    }
    println(f"300 random strings: {changed} changed, checksum {check}");
}
