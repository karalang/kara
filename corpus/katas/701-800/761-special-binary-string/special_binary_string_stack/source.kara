// LeetCode 761 — Special Binary String, with a stack of levels.
//
// Read the string once. Each 1 opens a level; each 0 closes the level on
// top, sorts the mountains found in it into descending order, and wraps
// them in a 1 and a 0 as one mountain of the level below. The bottom level,
// sorted, is the answer. No recursion; O(n^2) for the strings built.

fn make_largest_special(s: String) -> String {
    let mut levels: Vec[Vec[String]] = [Vec.new()];
    for c in s.chars() {
        if c == '1' {
            levels.push(Vec.new());
        } else {
            let mut inside = levels.pop().unwrap();
            inside.sort_by(|a, b| b.cmp(a));
            let below = levels.len() - 1;
            levels[below].push(f"1{inside.join("")}0");
        }
    }
    let mut mountains = levels.pop().unwrap();
    mountains.sort_by(|a, b| b.cmp(a));
    mountains.join("")
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random special string of 2m characters: a 1 whenever the string so
// far is balanced, a 0 once all m 1s are used, and otherwise either.
fn random_special(m: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    let mut ones = 0;
    let mut depth = 0;
    for _ in 0..2 * m {
        if ones < m and (depth == 0 or next_random(mut seed) % 2 == 0) {
            s.push('1');
            ones += 1;
            depth += 1;
        } else {
            s.push('0');
            depth -= 1;
        }
    }
    s
}

fn show(s: String) {
    let largest = make_largest_special(s.clone());
    println(f"{s} -> {largest}");
}

fn main() {
    show("11011000");
    show("10");
    show("1100");
    show("101100");
    show("10101010");
    show("110100");
    show("1011011000");
    show("1101001110001100");
    let mut seed = 761;
    let mut changed = 0;
    let mut check = 0;
    for _ in 0..300 {
        let m = 1 + next_random(mut seed) % 25;
        let s = random_special(m, mut seed);
        let largest = make_largest_special(s.clone());
        if largest != s {
            changed += 1;
        }
        for c in largest.chars() {
            check = (check * 2 + if c == '1' { 1 } else { 0 }) % 1000000007;
        }
    }
    println(f"300 random strings: {changed} changed, checksum {check}");
}
