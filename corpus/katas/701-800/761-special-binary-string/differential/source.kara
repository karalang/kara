// LeetCode #761: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random special strings.

// ---- ★ arm ----------------------------------------------------------

fn make_largest_special_star(s: String) -> String {
    let chars: Vec[char] = s.chars().collect();
    let mut mountains: Vec[String] = Vec.new();
    let mut depth = 0;
    let mut start = 0;
    for i in 0..chars.len() {
        if chars[i] == '1' {
            depth += 1;
        } else {
            depth -= 1;
        }
        if depth == 0 {
            let inside = make_largest_special_star(s[start + 1..i].to_string());
            mountains.push(f"1{inside}0");
            start = i + 1;
        }
    }
    mountains.sort_by(|a, b| b.cmp(a));
    mountains.join("")
}

// ---- stack arm ------------------------------------------------------

fn make_largest_special_stack(s: String) -> String {
    let mut levels: Vec[Vec[String]] = [Vec.new()];
    for c in s.chars() {
        if c == '1' {
            levels.push(Vec.new());
        } else {
            let mut inside = levels.pop().unwrap();
            inside.sort_by(|a, b| b.cmp(a));
            let below = levels.len() - 1;
            levels[below].push(f"1{inside.join("")}0");
        }
    }
    let mut mountains = levels.pop().unwrap();
    mountains.sort_by(|a, b| b.cmp(a));
    mountains.join("")
}

// ---- tree arm -------------------------------------------------------

fn make_largest_special_tree(s: String) -> String {
    let mut parent: Vec[i64] = [0];
    let mut children: Vec[Vec[i64]] = [Vec.new()];
    let mut at = 0;
    for c in s.chars() {
        if c == '1' {
            let node = parent.len();
            parent.push(at);
            children.push(Vec.new());
            children[at].push(node);
            at = node;
        } else {
            at = parent[at];
        }
    }
    let mut form: Vec[String] = Vec.new();
    for _ in 0..parent.len() {
        form.push(String.new());
    }
    let mut node = parent.len() - 1;
    while node >= 0 {
        let mut parts: Vec[String] = Vec.new();
        for child in children[node].iter() {
            parts.push(form[*child].clone());
        }
        parts.sort_by(|a, b| b.cmp(a));
        if node == 0 {
            form[0] = parts.join("");
        } else {
            form[node] = f"1{parts.join("")}0";
        }
        node -= 1;
    }
    form[0].clone()
}

// ---- climbing arm ---------------------------------------------------

// The end of the shortest special substring that starts at `i`: the first
// point where its 1s and 0s balance, unless the 0s pull ahead first.
fn special_end_climb(c: ref Vec[char], i: i64) -> Option[i64] {
    let mut depth = 0;
    for j in i..c.len() {
        if c[j] == '1' {
            depth += 1;
        } else {
            depth -= 1;
        }
        if depth < 0 {
            return None;
        }
        if depth == 0 {
            return Some(j + 1);
        }
    }
    None
}

// The first swap of c[i..j] and c[j..k] that makes the string larger.
fn find_swap_climb(c: ref Vec[char]) -> Option[(i64, i64, i64)] {
    let n = c.len();
    for i in 0..n {
        let mut j = i;
        while j < n {
            match special_end_climb(c, j) {
                Some(end) => j = end,
                None => break,
            }
            let mut k = j;
            while k < n {
                match special_end_climb(c, k) {
                    Some(end) => k = end,
                    None => break,
                }
                // compare c[j..k] followed by c[i..j] with c[i..k]
                let mut t = 0;
                while t < k - i {
                    let swapped = if t < k - j { c[j + t] } else { c[i + t - (k - j)] };
                    if swapped != c[i + t] {
                        if swapped == '1' {
                            return Some((i, j, k));
                        }
                        break;
                    }
                    t += 1;
                }
            }
        }
    }
    None
}

fn make_largest_special_climb(s: String) -> String {
    let mut c: Vec[char] = s.chars().collect();
    loop {
        match find_swap_climb(c) {
            Some((i, j, k)) => {
                let mut moved: Vec[char] = Vec.new();
                for t in j..k {
                    moved.push(c[t]);
                }
                for t in i..j {
                    moved.push(c[t]);
                }
                for t in 0..k - i {
                    c[i + t] = moved[t];
                }
            }
            None => break,
        }
    }
    let mut out = String.new();
    for ch in c.iter() {
        out.push(*ch);
    }
    out
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, s: String) -> String {
    if which == 0 {
        make_largest_special_star(s)
    } else if which == 1 {
        make_largest_special_stack(s)
    } else if which == 2 {
        make_largest_special_tree(s)
    } else {
        make_largest_special_climb(s)
    }
}

fn random_special(m: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    let mut ones = 0;
    let mut depth = 0;
    for _ in 0..2 * m {
        if ones < m and (depth == 0 or next_random(mut seed) % 2 == 0) {
            s.push('1');
            ones += 1;
            depth += 1;
        } else {
            s.push('0');
            depth -= 1;
        }
    }
    s
}

fn is_special(s: ref String) -> bool {
    let mut depth = 0;
    for c in s.chars() {
        if c == '1' {
            depth += 1;
        } else if c == '0' {
            depth -= 1;
        } else {
            return false;
        }
        if depth < 0 {
            return false;
        }
    }
    depth == 0 and s.len() > 0
}

// Every move from `s`: each pair of consecutive non-empty special
// substrings, swapped.
fn moves(s: ref String) -> Vec[String] {
    let n = s.len();
    let mut out: Vec[String] = Vec.new();
    for i in 0..n {
        for j in i + 1..n {
            if is_special(s[i..j].to_string()) {
                for k in j + 1..n + 1 {
                    if is_special(s[j..k].to_string()) {
                        out.push(f"{s[0..i]}{s[j..k]}{s[i..j]}{s[k..n]}");
                    }
                }
            }
        }
    }
    out
}

// The definition: the largest of all the strings the moves can reach.
fn definition(s: ref String) -> String {
    let mut seen: Set[String] = Set.new();
    let mut queue: Vec[String] = [s.clone()];
    seen.insert(s.clone());
    let mut best = s.clone();
    let mut head = 0;
    while head < queue.len() {
        let at = queue[head].clone();
        head += 1;
        if at > best {
            best = at.clone();
        }
        for next in moves(at).iter() {
            if not seen.contains(next.clone()) {
                seen.insert(next.clone());
                queue.push(next.clone());
            }
        }
    }
    best
}

fn main() {
    let arms = 4;
    let mut seed = 7610;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let small = 1500;
    let cases = 1800;
    let mut changed = 0;
    for case in 0..cases {
        // up to 14 characters for the definition, up to 50 for the rest
        let m = if case < small { 1 + next_random(mut seed) % 7 } else { 1 + next_random(mut seed) % 25 };
        let s = random_special(m, mut seed);
        let options = moves(s.clone());
        let moved = if options.len() > 0 {
            options[next_random(mut seed) % options.len()].clone()
        } else {
            s.clone()
        };
        let want = if case < small { definition(s.clone()) } else { String.new() };
        for which in 0..arms {
            let got = answer_with(which, s.clone());
            if which == 0 and got != s {
                changed += 1;
            }
            // P1: the definition's answer.
            if case < small {
                checks += 1;
                if got != want {
                    fails[0] += 1;
                }
            }
            // P2: a special string as long as `s`, no smaller, and its
            // own answer.
            checks += 1;
            if not is_special(got.clone()) or got.len() != s.len() or got < s or answer_with(which, got.clone()) != got {
                fails[1] += 1;
            }
            // P3: one move made first changes nothing.
            checks += 1;
            if answer_with(which, moved.clone()) != got {
                fails[2] += 1;
            }
            // P4: wrapped in a 1 and a 0, the answer is wrapped too.
            checks += 1;
            if answer_with(which, f"1{s}0") != f"1{got}0" {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} strings ({changed} changed), {arms} arms, {checks} checks, {failures} failures");
}
