// LeetCode #704: Binary Search -- the standard library's.
//
// `Vec.binary_search` returns the index of an element equal to the one
// asked for, or `None`; the values are distinct, so that index is the
// only one. O(log n) time, O(1) space.

fn search(nums: Vec[i64], target: i64) -> i64 {
    match nums.binary_search(target) {
        Some(i) => i,
        None => -1,
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], target: i64) {
    println(f"{nums} target {target}: {search(nums, target)}");
}

// Increasing values from `low` to at most 9,999, each 1 to `gap` above
// the one before, `n` of them at most.
fn random_sorted(n: i64, low: i64, gap: i64, seed: mut ref i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut v = low;
    while out.len() < n and v <= 9999 {
        out.push(v);
        v += 1 + next_random(mut seed) % gap;
    }
    out
}

fn main() {
    // The two LeetCode examples; then the first and last values, one
    // below and above them all, and one between two values.
    let example = vec![-1, 0, 3, 5, 9, 12];
    show(example, 9);
    show(example, 2);
    show(example, -1);
    show(example, 12);
    show(example, -9999);
    show(example, 9999);
    show(example, 4);
    // One value: it, below it and above it; two values, each and
    // between them.
    show(vec![5], 5);
    show(vec![5], 4);
    show(vec![5], 6);
    show(vec![-9999, 9999], -9999);
    show(vec![-9999, 9999], 9999);
    show(vec![-9999, 9999], 0);
    // The problem's largest, 10,000 values -9,999, -9,997 ... 9,999,
    // searched for every number from -9,999 to 9,999, half of them
    // there.
    let mut big: Vec[i64] = Vec.new();
    for i in 0..10000 {
        big.push(-9999 + 2 * i);
    }
    let mut found = 0;
    let mut sum = 0;
    for target in -9999..10000 {
        let at = search(big, target);
        if at >= 0 {
            found += 1;
        }
        sum = (sum * 31 + at + 1) % 1000000007;
    }
    println(f"10000 values, 19999 targets: {found} found, checksum {sum}");
    // 1,000 random arrays of 1 to 300 values from a random start, each
    // 1 to a random 1 to 60 above the last, each searched for a random
    // target, half of the time one of its values.
    let mut seed: i64 = 704;
    let mut found = 0;
    let mut sum = 0;
    for _ in 0..1000 {
        let n = 1 + next_random(mut seed) % 300;
        let low = next_random(mut seed) % 19999 - 9999;
        let gap = 1 + next_random(mut seed) % 60;
        let nums = random_sorted(n, low, gap, mut seed);
        let mut target = next_random(mut seed) % 19999 - 9999;
        if next_random(mut seed) % 2 == 0 {
            target = nums[next_random(mut seed) % nums.len()];
        }
        let at = search(nums, target);
        if at >= 0 {
            found += 1;
        }
        sum = (sum * 31 + at + 1) % 1000000007;
    }
    println(f"1000 random arrays: {found} found, checksum {sum}");
}
