// LeetCode 785 — Is Graph Bipartite?, two colours by depth first search.
//
// The same two-colouring, done by recursion: colour a node, then each
// uncoloured neighbour with the other colour, recursively, failing as
// soon as an edge joins two nodes of one colour. O(n + e) time and
// O(n) stack.

fn paint(graph: Vec[Vec[i64]], u: i64, c: i64, colour: mut ref Vec[i64]) -> bool {
    colour[u] = c;
    for v in graph[u].iter() {
        if colour[*v] == c {
            return false;
        }
        if colour[*v] == -1 and not paint(graph, *v, 1 - c, mut colour) {
            return false;
        }
    }
    true
}

fn is_bipartite(graph: Vec[Vec[i64]]) -> bool {
    let n = graph.len();
    let mut colour: Vec[i64] = Vec.new();
    for _ in 0..n {
        colour.push(-1);
    }
    for u in 0..n {
        if colour[u] == -1 and not paint(graph, u, 0, mut colour) {
            return false;
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The adjacency lists of n nodes joined by the given edges.
fn from_edges(n: i64, edges: Vec[(i64, i64)]) -> Vec[Vec[i64]] {
    let mut graph: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        graph.push(Vec.new());
    }
    for (a, b) in edges.iter() {
        graph[a].push(b);
        graph[b].push(a);
    }
    graph
}

fn cycle(n: i64) -> Vec[Vec[i64]] {
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for i in 0..n {
        edges.push((i, (i + 1) % n));
    }
    from_edges(n, edges)
}

// n nodes, each pair joined with chance density / 1000. kind 0: only
// pairs on different sides of a random split; kind 1: that and one edge
// inside a side; kind 2: any pair.
fn random_graph(seed: mut ref i64, n: i64, density: i64, kind: i64) -> Vec[Vec[i64]] {
    let mut side: Vec[i64] = Vec.new();
    for _ in 0..n {
        side.push(next_random(mut seed) % 2);
    }
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for a in 0..n {
        for b in a + 1..n {
            if (kind == 2 or side[a] != side[b]) and next_random(mut seed) % 1000 < density {
                edges.push((a, b));
            }
        }
    }
    if kind == 1 {
        let a = next_random(mut seed) % n;
        let mut b = next_random(mut seed) % n;
        let mut tries = 0;
        while (b == a or side[b] != side[a]) and tries < n {
            b = (b + 1) % n;
            tries += 1;
        }
        if b != a and side[b] == side[a] {
            edges.push((a, b));
        }
    }
    from_edges(n, edges)
}

fn show(graph: Vec[Vec[i64]]) {
    let answer = is_bipartite(graph);
    println(f"{graph} -> {answer}");
}

fn main() {
    show([[1, 2, 3], [0, 2], [0, 1, 3], [0, 2]]);
    show([[1, 3], [0, 2], [1, 3], [0, 2]]);
    show([[]]);
    show([[1], [0]]);
    show([[1, 2], [0, 2], [0, 1], []]);
    show(from_edges(7, [(0, 1), (1, 2), (2, 3), (3, 0), (4, 5), (5, 6), (6, 4)]));
    show(from_edges(7, [(0, 1), (1, 2), (2, 3), (3, 0), (4, 5), (5, 6)]));
    println(f"a cycle of 100 -> {is_bipartite(cycle(100))}");
    println(f"a cycle of 99 -> {is_bipartite(cycle(99))}");
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for a in 0..50 {
        for b in 50..100 {
            edges.push((a, b));
        }
    }
    println(f"two sides of 50, every pair across joined -> {is_bipartite(from_edges(100, edges))}");
    edges.push((0, 49));
    println(f"that and one edge inside a side -> {is_bipartite(from_edges(100, edges))}");
    let mut seed = 785;
    let mut tree: Vec[(i64, i64)] = Vec.new();
    for i in 1..100 {
        tree.push((next_random(mut seed) % i, i));
    }
    println(f"a random tree of 100 -> {is_bipartite(from_edges(100, tree))}");
    let mut yes = 0;
    let mut check = 0;
    for g in 0..300 {
        let n = 1 + next_random(mut seed) % 100;
        let density = 1 + next_random(mut seed) % 60;
        let answer = is_bipartite(random_graph(mut seed, n, density, g % 3));
        if answer {
            yes += 1;
        }
        check = (check * 31 + n * (if answer { 2 } else { 1 })) % 1000000007;
    }
    println(f"300 random graphs: {yes} bipartite, checksum {check}");
}
