// LeetCode 785 — Is Graph Bipartite?: the bench.
//
// 64 graphs of 100 nodes, LeetCode's most, are built once: each node is
// put on a random side and each pair across joined with chance 1 in 10,
// and every other graph then has one edge added inside a side. Each round
// answers the next graph with the ★ arm, two colours by breadth first
// search.

fn is_bipartite(graph: Vec[Vec[i64]]) -> bool {
    let n = graph.len();
    let mut colour: Vec[i64] = Vec.new();
    for _ in 0..n {
        colour.push(-1);
    }
    let mut queue: VecDeque[i64] = VecDeque.new();
    for start in 0..n {
        if colour[start] != -1 {
            continue;
        }
        colour[start] = 0;
        queue.push_back(start);
        while let Some(u) = queue.pop_front() {
            for v in graph[u].iter() {
                if colour[*v] == -1 {
                    colour[*v] = 1 - colour[u];
                    queue.push_back(*v);
                } else if colour[*v] == colour[u] {
                    return false;
                }
            }
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 785;
    let mut graphs: Vec[Vec[Vec[i64]]] = Vec.new();
    for g in 0..64 {
        let mut side: Vec[i64] = Vec.new();
        for _ in 0..100 {
            side.push(next_random(mut seed) % 2);
        }
        let mut graph: Vec[Vec[i64]] = Vec.new();
        for _ in 0..100 {
            graph.push(Vec.new());
        }
        for a in 0..100 {
            for b in a + 1..100 {
                if side[a] != side[b] and next_random(mut seed) % 10 == 0 {
                    graph[a].push(b);
                    graph[b].push(a);
                }
            }
        }
        if g % 2 == 1 {
            let a = next_random(mut seed) % 100;
            let mut b = (a + 1) % 100;
            while side[b] != side[a] {
                b = (b + 1) % 100;
            }
            graph[a].push(b);
            graph[b].push(a);
        }
        graphs.push(graph);
    }
    let rounds = 500000;
    let mut yes = 0;
    let mut check = 0;
    for r in 0..rounds {
        let answer = is_bipartite(graphs[r % 64]);
        if answer {
            yes += 1;
        }
        check = (check * 31 + (if answer { 2 } else { 1 }) + r % 7) % 1000000007;
    }
    println(f"{rounds} rounds of 100-node graphs: {yes} bipartite, checksum {check}");
}
