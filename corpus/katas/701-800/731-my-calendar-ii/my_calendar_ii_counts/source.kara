// LeetCode #731: My Calendar II -- a sweep over booking boundaries.
//
// An ordered map counts, at each boundary, how many bookings start
// there less how many end there, so a running sum over the map in
// order is how many bookings cover each stretch. Add the new booking
// and sum up to its end: no stretch outside it has changed, so if any
// reaches three it is inside the booking, which is taken out again.
// O(n) per booking.

struct MyCalendarTwo {
    delta: SortedMap[i64, i64],
}

impl MyCalendarTwo {
    fn new() -> MyCalendarTwo {
        MyCalendarTwo { delta: SortedMap.new() }
    }

    fn change(mut ref self, at: i64, by: i64) {
        let old = match self.delta.get(at) {
            Some(v) => *v,
            None => 0,
        };
        if old + by == 0 {
            self.delta.remove(at);
        } else {
            self.delta.insert(at, old + by);
        }
    }

    fn book(mut ref self, start: i64, end: i64) -> bool {
        self.change(start, 1);
        self.change(end, -1);
        let mut covered = 0;
        for (_, d) in self.delta.range(0, end) {
            covered += *d;
            if covered >= 3 {
                self.change(start, -1);
                self.change(end, 1);
                return false;
            }
        }
        true
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn run(bookings: Vec[(i64, i64)]) -> Vec[bool] {
    let mut cal = MyCalendarTwo.new();
    let mut out: Vec[bool] = Vec.new();
    for b in bookings.iter() {
        out.push(cal.book(b.0, b.1));
    }
    out
}

fn show(bookings: Vec[(i64, i64)]) {
    println(f"{bookings} -> {run(bookings)}");
}

fn count(what: String, bookings: Vec[(i64, i64)]) {
    let mut yes = 0;
    for r in run(bookings).iter() {
        if *r {
            yes += 1;
        }
    }
    println(f"{what} -> {yes} accepted");
}

fn main() {
    show([(10, 20), (50, 60), (10, 40), (5, 15), (5, 10), (25, 55)]);
    show([(0, 10), (0, 10), (0, 10), (10, 20), (10, 20), (5, 15)]);
    show([(24, 40), (43, 50), (27, 43), (5, 21), (30, 40), (14, 29), (3, 19), (3, 14), (25, 39), (6, 19)]);
    show([(0, 1000000000), (0, 1), (999999999, 1000000000), (0, 1000000000)]);
    show([(5, 6), (5, 6), (5, 6), (4, 5), (6, 7), (4, 7), (4, 7)]);
    let mut seed: i64 = 731;
    let mut random: Vec[(i64, i64)] = Vec.new();
    for _ in 0..1000 {
        let s = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000;
        let len = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000;
        let e = if s + len > 1000000000 { 1000000000 } else { s + len };
        random.push((s, e));
    }
    count("1000 random bookings up to 10^9".to_string(), random);
    let mut rising: Vec[(i64, i64)] = Vec.new();
    for i in 0..1000 {
        rising.push((i * 10, i * 10 + 25));
    }
    count("1000 bookings, each over the next two, rising".to_string(), rising);
    let mut falling: Vec[(i64, i64)] = Vec.new();
    for i in 0..1000 {
        falling.push((10000 - i * 10, 10025 - i * 10));
    }
    count("1000 bookings, each over the next two, falling".to_string(), falling);
    let mut nested: Vec[(i64, i64)] = Vec.new();
    for i in 0..1000 {
        nested.push((500 - i / 2, 501 + i / 2));
    }
    count("1000 bookings around one point".to_string(), nested);
    let mut sum = 0;
    let mut accepted = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 20;
        let mut bookings: Vec[(i64, i64)] = Vec.new();
        for _ in 0..n {
            let s = next_random(mut seed) % 100;
            let e = s + 1 + next_random(mut seed) % 15;
            bookings.push((s, e));
        }
        for r in run(bookings).iter() {
            let v = if *r { 1 } else { 0 };
            accepted += v;
            sum = (sum * 131 + v + 1) % 1000000007;
        }
    }
    println(f"300 random runs: {accepted} accepted, checksum {sum}");
}
