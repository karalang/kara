// LeetCode #710: Random Pick with Blacklist -- remap the blacklisted
// numbers below the line.
//
// Of n numbers, bound = n - (blacklist length) are allowed. Draw r from
// 0 to bound - 1. An allowed r is the answer as it is; each blacklisted
// number below bound is mapped, once, to an allowed number at or above
// bound, and there are exactly as many of those as there are
// blacklisted numbers below bound. So every draw is one lookup: O(1)
// per pick, O(B) to build and to hold, B the blacklist length.

struct Solution {
    bound: i64,
    remap: Map[i64, i64],
    mut seed: i64,
}

impl Solution {
    fn new(n: i64, blacklist: Vec[i64], seed: i64) -> Solution {
        let bound = n - blacklist.len();
        let mut high: Set[i64] = Set.new();
        for b in blacklist.iter() {
            if *b >= bound {
                high.insert(*b);
            }
        }
        // Hand each blacklisted number below bound the next allowed
        // number down from the top.
        let mut remap: Map[i64, i64] = Map.new();
        let mut last = n - 1;
        for b in blacklist.iter() {
            if *b < bound {
                while high.contains(last) {
                    last -= 1;
                }
                remap.insert(*b, last);
                last -= 1;
            }
        }
        Solution { bound: bound, remap: remap, seed: seed }
    }

    // The allowed number a draw of r stands for.
    fn pick_from(ref self, r: i64) -> i64 {
        match self.remap.get(r) {
            Some(x) => x,
            None => r,
        }
    }

    fn pick(mut ref self) -> i64 {
        let r = random_below(mut self.seed, self.bound);
        self.pick_from(r)
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The random source `pick` draws from, in place of the language's own:
// two 15-bit draws make 30 bits, reduced to 0 to bound - 1.
fn random_below(seed: mut ref i64, bound: i64) -> i64 {
    let hi = next_random(mut seed);
    let lo = next_random(mut seed);
    (hi * 32768 + lo) % bound
}

// `count` different numbers from 0 to n - 1, in the order drawn.
fn random_blacklist(n: i64, count: i64, seed: mut ref i64) -> Vec[i64] {
    let mut seen: Set[i64] = Set.new();
    let mut out: Vec[i64] = Vec.new();
    while out.len() < count {
        let x = random_below(mut seed, n);
        if not seen.contains(x) {
            seen.insert(x);
            out.push(x);
        }
    }
    out
}

// What does not depend on which allowed number a draw is mapped to:
// whether every draw, taken once, covers the allowed numbers exactly;
// how many picks were not allowed; and, of the picks, how many
// different numbers came up and how often, as a checksum of the sorted
// counts.
fn run(n: i64, blacklist: Vec[i64], picks: i64, seed: i64) -> String {
    let mut s = Solution.new(n, blacklist.clone(), seed);
    let mut black: Set[i64] = Set.new();
    for b in blacklist.iter() {
        black.insert(*b);
    }
    let bound = n - blacklist.len();
    let mut out = f"n = {n}, {blacklist.len()} blacklisted";
    if n <= 300000 {
        let mut all: Vec[i64] = Vec.new();
        for r in 0..bound {
            all.push(s.pick_from(r));
        }
        all.sort();
        let mut want: Vec[i64] = Vec.new();
        for x in 0..n {
            if not black.contains(x) {
                want.push(x);
            }
        }
        if all == want {
            out = out + ", every draw a different allowed number";
        } else {
            out = out + ", the draws do NOT cover the allowed numbers";
        }
    } else {
        // Too many to take every draw: take each blacklisted number
        // below bound as a draw, and the last 1,000 draws.
        let mut draws: Set[i64] = Set.new();
        for b in blacklist.iter() {
            if *b < bound {
                draws.insert(*b);
            }
        }
        for r in bound - 1000..bound {
            draws.insert(r);
        }
        let mut got: Set[i64] = Set.new();
        let mut ok = true;
        for r in draws.iter() {
            let x = s.pick_from(*r);
            if x < 0 or x >= n or black.contains(x) or got.contains(x) {
                ok = false;
            }
            got.insert(x);
        }
        let verdict = if ok { "each" } else { "NOT each" };
        out = out + f", {draws.len()} draws, {verdict} allowed, all different";
    }
    let mut counts: Map[i64, i64] = Map.new();
    let mut bad = 0;
    for _ in 0..picks {
        let x = s.pick();
        if x < 0 or x >= n or black.contains(x) {
            bad += 1;
        }
        let c = match counts.get(x) {
            Some(v) => v,
            None => 0,
        };
        counts.insert(x, c + 1);
    }
    let mut sorted: Vec[i64] = Vec.new();
    for (_, c) in counts.iter() {
        sorted.push(*c);
    }
    sorted.sort();
    let mut sum = 0;
    for c in sorted.iter() {
        sum = (sum * 131 + *c) % 1000000007;
    }
    let different = sorted.len();
    f"{out}; {picks} picks: {bad} not allowed, {different} seen, counts {sum}"
}

fn main() {
    println(run(7, [2, 3, 5], 7, 1));
    println(run(7, [2, 3, 5], 10000, 2));
    println(run(1, [], 100, 3));
    println(run(2, [0], 100, 4));
    println(run(2, [1], 100, 5));
    println(run(10, [], 10000, 6));
    println(run(10, [0, 1, 2, 3, 5, 6, 7, 8, 9], 1000, 7));
    println(run(10, [9, 8, 7, 6, 5], 1000, 8));
    println(run(10, [0, 1, 2, 3, 4], 1000, 9));
    println(run(1000000000, [0, 999999999], 20000, 10));
    let mut seed: i64 = 710;
    let big = random_blacklist(1000000000, 100000, mut seed);
    println(run(1000000000, big, 20000, 11));
    let half = random_blacklist(200000, 100000, mut seed);
    println(run(200000, half, 20000, 12));
    let most = random_blacklist(300000, 299990, mut seed);
    println(run(300000, most, 20000, 13));
    // 300 random small cases, the lines folded into one checksum.
    let mut sum = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let count = next_random(mut seed) % n;
        let blacklist = random_blacklist(n, count, mut seed);
        let line = run(n, blacklist, 200, next_random(mut seed));
        for b in line.bytes() {
            sum = (sum * 131 + b as i64) % 1000000007;
        }
    }
    println(f"300 random cases: checksum {sum}");
}
