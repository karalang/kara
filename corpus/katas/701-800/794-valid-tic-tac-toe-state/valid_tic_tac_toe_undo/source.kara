// LeetCode 794 — Valid Tic-Tac-Toe State, taking moves back.
//
// The empty board is valid. Any other board is valid when the player
// who moved last, X when the counts are unequal and O when they are
// equal, has a mark whose removal leaves a valid board on which nobody
// has a line yet, since play would have stopped there. Each board met
// is settled once, kept in a `Map` from the board to its answer.
fn has_line(cells: String, mark: char) -> bool {
    let c: Vec[char] = cells.chars().collect();
    let lines = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
    lines.iter().any(|l| c[l[0]] == mark and c[l[1]] == mark and c[l[2]] == mark)
}

fn settle(cells: String, known: mut ref Map[String, bool]) -> bool {
    if let Some(answer) = known.get(cells) {
        return answer;
    }
    let x = cells.chars().filter(|c| c == 'X').count();
    let o = cells.chars().filter(|c| c == 'O').count();
    let answer = if x == 0 and o == 0 {
        true
    } else if x != o and x != o + 1 {
        false
    } else {
        let last = if x == o + 1 { 'X' } else { 'O' };
        let marks: Vec[char] = cells.chars().collect();
        let mut found = false;
        for i in 0..9 {
            if not found and marks[i] == last {
                let mut before = marks.clone();
                before[i] = ' ';
                let earlier: String = before.iter().collect();
                if not has_line(earlier, 'X') and not has_line(earlier, 'O') and settle(earlier, mut known) {
                    found = true;
                }
            }
        }
        found
    };
    known.insert(cells.clone(), answer);
    answer
}

fn valid_tic_tac_toe(board: Vec[String]) -> bool {
    let mut known: Map[String, bool] = Map.new();
    settle(f"{board[0]}{board[1]}{board[2]}", mut known)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn board_of(rows: Array[Str, 3]) -> Vec[String] {
    rows.iter().map(|r| r.to_string()).collect()
}

fn show(rows: Array[Str, 3]) {
    let board = board_of(rows);
    let shown = board.clone();
    let answer = valid_tic_tac_toe(board);
    println(f"[\"{shown[0]}\", \"{shown[1]}\", \"{shown[2]}\"] -> {answer}");
}

// A random board: cells filled at random, or a random game played for a
// random number of moves, going on past a line one time in four.
fn random_board(seed: mut ref i64) -> Vec[String] {
    let mut cells: Vec[char] = Vec.new();
    for _ in 0..9 {
        cells.push(' ');
    }
    if next_random(mut seed) % 2 == 0 {
        let marks = [' ', 'X', 'O'];
        for i in 0..9 {
            cells[i] = marks[next_random(mut seed) % 3];
        }
    } else {
        let moves = next_random(mut seed) % 10;
        let mut mover = 'X';
        for _ in 0..moves {
            let mut empty: Vec[i64] = Vec.new();
            for i in 0..9 {
                if cells[i] == ' ' {
                    empty.push(i);
                }
            }
            cells[empty[next_random(mut seed) % empty.len()]] = mover;
            mover = if mover == 'X' { 'O' } else { 'X' };
        }
    }
    let mut board: Vec[String] = Vec.new();
    for r in 0..3 {
        let mut row = String.new();
        for c in 0..3 {
            row.push(cells[r * 3 + c]);
        }
        board.push(row);
    }
    board
}

fn main() {
    show(["O  ", "   ", "   "]);
    show(["XOX", " X ", "   "]);
    show(["XOX", "O O", "XOX"]);
    show(["   ", "   ", "   "]);
    show(["XXX", "OO ", "   "]);
    show(["XXX", "XOO", "OO "]);
    show(["XXX", "   ", "OOO"]);
    show(["XO ", "XO ", "XO "]);
    show(["XOX", "XOO", "XXO"]);
    let mut seed = 794;
    let mut valid = 0;
    let mut check = 0;
    for i in 0..300 {
        let board = random_board(mut seed);
        if valid_tic_tac_toe(board) {
            valid += 1;
            check = (check * 131 + i) % 1000000007;
        }
    }
    println(f"300 random boards: {valid} valid, checksum {check}");
}
