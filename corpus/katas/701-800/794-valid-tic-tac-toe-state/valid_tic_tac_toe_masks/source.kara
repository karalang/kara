// LeetCode 794 — Valid Tic-Tac-Toe State, with bit masks.
//
// Each player's marks as nine bits, cell r * 3 + c at bit r * 3 + c.
// The marks are counted with `count_ones`, and a player has a line when
// one of the eight line masks is all inside its bits; then the rules of
// the ★ arm. O(9).
fn has_line(bits: i64) -> bool {
    for line in [0b000000111, 0b000111000, 0b111000000, 0b001001001, 0b010010010, 0b100100100, 0b100010001, 0b001010100] {
        if bits & line == line {
            return true;
        }
    }
    false
}

fn valid_tic_tac_toe(board: Vec[String]) -> bool {
    let mut xs = 0;
    let mut os = 0;
    for r in 0..3 {
        let row = board[r].bytes();
        for c in 0..3 {
            if row[c] == b'X' {
                xs |= 1 << (r * 3 + c);
            } else if row[c] == b'O' {
                os |= 1 << (r * 3 + c);
            }
        }
    }
    let x = xs.count_ones();
    let o = os.count_ones();
    let x_won = has_line(xs);
    let o_won = has_line(os);
    if x == o + 1 {
        not o_won
    } else if x == o {
        not x_won
    } else {
        false
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn board_of(rows: Array[Str, 3]) -> Vec[String] {
    rows.iter().map(|r| r.to_string()).collect()
}

fn show(rows: Array[Str, 3]) {
    let board = board_of(rows);
    let shown = board.clone();
    let answer = valid_tic_tac_toe(board);
    println(f"[\"{shown[0]}\", \"{shown[1]}\", \"{shown[2]}\"] -> {answer}");
}

// A random board: cells filled at random, or a random game played for a
// random number of moves, going on past a line one time in four.
fn random_board(seed: mut ref i64) -> Vec[String] {
    let mut cells: Vec[char] = Vec.new();
    for _ in 0..9 {
        cells.push(' ');
    }
    if next_random(mut seed) % 2 == 0 {
        let marks = [' ', 'X', 'O'];
        for i in 0..9 {
            cells[i] = marks[next_random(mut seed) % 3];
        }
    } else {
        let moves = next_random(mut seed) % 10;
        let mut mover = 'X';
        for _ in 0..moves {
            let mut empty: Vec[i64] = Vec.new();
            for i in 0..9 {
                if cells[i] == ' ' {
                    empty.push(i);
                }
            }
            cells[empty[next_random(mut seed) % empty.len()]] = mover;
            mover = if mover == 'X' { 'O' } else { 'X' };
        }
    }
    let mut board: Vec[String] = Vec.new();
    for r in 0..3 {
        let mut row = String.new();
        for c in 0..3 {
            row.push(cells[r * 3 + c]);
        }
        board.push(row);
    }
    board
}

fn main() {
    show(["O  ", "   ", "   "]);
    show(["XOX", " X ", "   "]);
    show(["XOX", "O O", "XOX"]);
    show(["   ", "   ", "   "]);
    show(["XXX", "OO ", "   "]);
    show(["XXX", "XOO", "OO "]);
    show(["XXX", "   ", "OOO"]);
    show(["XO ", "XO ", "XO "]);
    show(["XOX", "XOO", "XXO"]);
    let mut seed = 794;
    let mut valid = 0;
    let mut check = 0;
    for i in 0..300 {
        let board = random_board(mut seed);
        if valid_tic_tac_toe(board) {
            valid += 1;
            check = (check * 131 + i) % 1000000007;
        }
    }
    println(f"300 random boards: {valid} valid, checksum {check}");
}
