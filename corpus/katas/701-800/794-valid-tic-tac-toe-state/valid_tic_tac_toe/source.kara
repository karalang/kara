// LeetCode 794 — Valid Tic-Tac-Toe State, by the rules.
//
// X moves first and the players take turns, so X has as many marks as
// O or one more. The game stops at a win, so when X has a line X made
// the last move and has one mark more, and when O has a line O made it
// and the counts are equal; both having lines is then impossible, as it
// needs both. O(9).
fn wins(cells: Vec[u8], mark: u8) -> bool {
    let lines = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
    for line in lines {
        if cells[line[0]] == mark and cells[line[1]] == mark and cells[line[2]] == mark {
            return true;
        }
    }
    false
}

fn valid_tic_tac_toe(board: Vec[String]) -> bool {
    let mut cells: Vec[u8] = Vec.new();
    for row in board {
        for b in row.bytes() {
            cells.push(b);
        }
    }
    let x = cells.iter().filter(|c| c == b'X').count();
    let o = cells.iter().filter(|c| c == b'O').count();
    if x != o and x != o + 1 {
        return false;
    }
    if wins(cells, b'X') and x != o + 1 {
        return false;
    }
    if wins(cells, b'O') and x != o {
        return false;
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn board_of(rows: Array[Str, 3]) -> Vec[String] {
    rows.iter().map(|r| r.to_string()).collect()
}

fn show(rows: Array[Str, 3]) {
    let board = board_of(rows);
    let shown = board.clone();
    let answer = valid_tic_tac_toe(board);
    println(f"[\"{shown[0]}\", \"{shown[1]}\", \"{shown[2]}\"] -> {answer}");
}

// A random board: cells filled at random, or a random game played for a
// random number of moves, going on past a line one time in four.
fn random_board(seed: mut ref i64) -> Vec[String] {
    let mut cells: Vec[char] = Vec.new();
    for _ in 0..9 {
        cells.push(' ');
    }
    if next_random(mut seed) % 2 == 0 {
        let marks = [' ', 'X', 'O'];
        for i in 0..9 {
            cells[i] = marks[next_random(mut seed) % 3];
        }
    } else {
        let moves = next_random(mut seed) % 10;
        let mut mover = 'X';
        for _ in 0..moves {
            let mut empty: Vec[i64] = Vec.new();
            for i in 0..9 {
                if cells[i] == ' ' {
                    empty.push(i);
                }
            }
            cells[empty[next_random(mut seed) % empty.len()]] = mover;
            mover = if mover == 'X' { 'O' } else { 'X' };
        }
    }
    let mut board: Vec[String] = Vec.new();
    for r in 0..3 {
        let mut row = String.new();
        for c in 0..3 {
            row.push(cells[r * 3 + c]);
        }
        board.push(row);
    }
    board
}

fn main() {
    show(["O  ", "   ", "   "]);
    show(["XOX", " X ", "   "]);
    show(["XOX", "O O", "XOX"]);
    show(["   ", "   ", "   "]);
    show(["XXX", "OO ", "   "]);
    show(["XXX", "XOO", "OO "]);
    show(["XXX", "   ", "OOO"]);
    show(["XO ", "XO ", "XO "]);
    show(["XOX", "XOO", "XXO"]);
    let mut seed = 794;
    let mut valid = 0;
    let mut check = 0;
    for i in 0..300 {
        let board = random_board(mut seed);
        if valid_tic_tac_toe(board) {
            valid += 1;
            check = (check * 131 + i) % 1000000007;
        }
    }
    println(f"300 random boards: {valid} valid, checksum {check}");
}
