// LeetCode #713: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random arrays.

// ---- ★ arm ----------------------------------------------------------

fn num_subarray_product_less_than_k_star(nums: Vec[i64], k: i64) -> i64 {
    if k <= 1 {
        return 0;
    }
    let mut product = 1;
    let mut left = 0;
    let mut count = 0;
    for right in 0..nums.len() {
        product *= nums[right];
        while product >= k {
            product /= nums[left];
            left += 1;
        }
        count += right - left + 1;
    }
    count
}

// ---- starts arm -----------------------------------------------------

fn num_subarray_product_less_than_k_starts(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut end = 0;
    let mut product = 1;
    let mut count = 0;
    for start in 0..n {
        if end < start {
            end = start;
            product = 1;
        }
        while end < n and product * nums[end] < k {
            product *= nums[end];
            end += 1;
        }
        count += end - start;
        if end > start {
            product /= nums[start];
        }
    }
    count
}

// ---- brute arm ------------------------------------------------------

fn num_subarray_product_less_than_k_brute(nums: Vec[i64], k: i64) -> i64 {
    let mut count = 0;
    for start in 0..nums.len() {
        let mut product = 1;
        for end in start..nums.len() {
            product *= nums[end];
            if product >= k {
                break;
            }
            count += 1;
        }
    }
    count
}

// ---- logs arm -------------------------------------------------------

fn num_subarray_product_less_than_k_logs(nums: Vec[i64], k: i64) -> i64 {
    if k <= 1 {
        return 0;
    }
    let limit = (k as f64).ln() - 1e-9;
    let mut prefix: Vec[f64] = [0.0];
    for x in nums.iter() {
        let last = prefix[prefix.len() - 1];
        prefix.push(last + (*x as f64).ln());
    }
    let n = nums.len();
    let mut count = 0;
    for start in 0..n {
        // The first end, start < end <= n + 1, whose sum reaches limit.
        let mut lo = start + 1;
        let mut hi = n + 1;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if prefix[mid] - prefix[start] < limit {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        count += lo - 1 - start;
    }
    count
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn count(which: i64, nums: Vec[i64], k: i64) -> i64 {
    if which == 0 {
        num_subarray_product_less_than_k_star(nums, k)
    } else if which == 1 {
        num_subarray_product_less_than_k_starts(nums, k)
    } else if which == 2 {
        num_subarray_product_less_than_k_brute(nums, k)
    } else {
        num_subarray_product_less_than_k_logs(nums, k)
    }
}

// The definition: every pair of ends, each product built from scratch
// and held at k once it reaches k, so it cannot overflow.
fn definition(nums: Vec[i64], k: i64) -> i64 {
    let mut total = 0;
    for i in 0..nums.len() {
        for j in i..nums.len() {
            let mut product = 1;
            for t in i..j + 1 {
                product = product * nums[t];
                if product > k {
                    product = k;
                }
            }
            if product < k {
                total += 1;
            }
        }
    }
    total
}

fn random_nums(seed: mut ref i64) -> Vec[i64] {
    let n = next_random(mut seed) % 13;
    let top = 1 + next_random(mut seed) % 12;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(1 + next_random(mut seed) % top);
    }
    nums
}

fn joined(a: Vec[i64], b: Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    for x in b.iter() {
        out.push(*x);
    }
    out
}

fn main() {
    let mut seed = 7130;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut counted = 0;
    let cases = 3000;
    for _ in 0..cases {
        let a = random_nums(mut seed);
        let b = random_nums(mut seed);
        let k = next_random(mut seed) % 300;
        let want = definition(a, k);
        counted += want;
        let mut reversed = a.clone();
        reversed.reverse();
        // a and b with a number of at least k between them, which no
        // counted subarray can cross; 1 when k is 0 or 1.
        let wall = if k > 1 { k } else { 1 };
        let mut walled = a.clone();
        walled.push(wall);
        for x in b.iter() {
            walled.push(*x);
        }
        let both = joined(a, b);
        for which in 0..arms {
            let got = count(which, a, k);
            // P1: the definition's count.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the array reversed has the same count.
            checks += 1;
            if count(which, reversed, k) != got {
                fails[1] += 1;
            }
            // P3: across a wall of k or more, the two sides add up.
            checks += 1;
            if count(which, walled, k) != got + count(which, b, k) {
                fails[2] += 1;
            }
            // P4: joined, a and b count at least their sum and at most
            // their sum plus every subarray that crosses the join.
            checks += 1;
            let sides = got + count(which, b, k);
            let j = count(which, both, k);
            if j < sides or j > sides + a.len() * b.len() {
                fails[3] += 1;
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{cases} arrays ({counted} subarrays), {arms} arms, {checks} checks, {total} failures");
}
