// LeetCode #783: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties
// on random search trees.

// ---- ★ arm ----------------------------------------------------------

// The smallest gap in the subtree at `node` to a bound, with -1 for a
// bound that does not exist.
fn closest_star(node: Option[TreeNode], low: i64, high: i64) -> i64 {
    let Some(n) = node else {
        return i64.MAX;
    };
    let mut best = i64.MAX;
    if low != -1 {
        best = best.min(n.val - low);
    }
    if high != -1 {
        best = best.min(high - n.val);
    }
    best = best.min(closest_star(n.left, low, n.val));
    best.min(closest_star(n.right, n.val, high))
}

fn min_diff_in_bst_star(root: Option[TreeNode]) -> i64 {
    closest_star(root, -1, -1)
}

// ---- subtrees arm ---------------------------------------------------

struct Summary_subtrees {
    least: i64,
    most: i64,
    best: i64,
}

fn summary_subtrees(n: TreeNode) -> Summary_subtrees {
    let mut out = Summary_subtrees { least: n.val, most: n.val, best: i64.MAX };
    if let Some(l) = n.left {
        let s = summary_subtrees(l);
        out.least = s.least;
        out.best = out.best.min(s.best).min(n.val - s.most);
    }
    if let Some(r) = n.right {
        let s = summary_subtrees(r);
        out.most = s.most;
        out.best = out.best.min(s.best).min(s.least - n.val);
    }
    out
}

fn min_diff_in_bst_subtrees(root: Option[TreeNode]) -> i64 {
    match root {
        Some(n) => summary_subtrees(n).best,
        None => i64.MAX,
    }
}

// ---- sortedset arm --------------------------------------------------

fn min_diff_in_bst_sortedset(root: Option[TreeNode]) -> i64 {
    let mut values: SortedSet[i64] = SortedSet.new();
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    if let Some(r) = root {
        queue.push_back(r);
    }
    while let Some(n) = queue.pop_front() {
        values.insert(n.val);
        if let Some(l) = n.left {
            queue.push_back(l);
        }
        if let Some(r) = n.right {
            queue.push_back(r);
        }
    }
    let mut best = i64.MAX;
    let mut prev = -1;
    for v in values.iter() {
        if prev != -1 {
            best = best.min(*v - prev);
        }
        prev = *v;
    }
    best
}

// ---- descending arm -------------------------------------------------

fn min_diff_in_bst_descending(root: Option[TreeNode]) -> i64 {
    let mut stack: Vec[TreeNode] = Vec.new();
    let mut cur = root;
    let mut best = i64.MAX;
    let mut prev = -1;
    loop {
        while let Some(n) = cur {
            stack.push(n);
            cur = n.right;
        }
        let Some(n) = stack.pop() else {
            break;
        };
        if prev != -1 {
            best = best.min(prev - n.val);
        }
        prev = n.val;
        cur = n.left;
    }
    best
}

// ---- the definition and the properties ------------------------------------

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, root: Option[TreeNode]) -> i64 {
    if which == 0 {
        min_diff_in_bst_star(root)
    } else if which == 1 {
        min_diff_in_bst_subtrees(root)
    } else if which == 2 {
        min_diff_in_bst_sortedset(root)
    } else {
        min_diff_in_bst_descending(root)
    }
}

fn insert(root: Option[TreeNode], v: i64) -> Option[TreeNode] {
    let Some(r) = root else {
        return Some(TreeNode { val: v, left: None, right: None });
    };
    let mut at = r;
    loop {
        if v < at.val {
            match at.left {
                Some(l) => {
                    at = l;
                }
                None => {
                    at.left = Some(TreeNode { val: v, left: None, right: None });
                    break;
                }
            }
        } else {
            match at.right {
                Some(c) => {
                    at = c;
                }
                None => {
                    at.right = Some(TreeNode { val: v, left: None, right: None });
                    break;
                }
            }
        }
    }
    Some(r)
}

fn build(values: Vec[i64]) -> Option[TreeNode] {
    let mut root: Option[TreeNode] = None;
    for v in values.iter() {
        root = insert(root, *v);
    }
    root
}

// The definition: the smallest gap between any two of the values.
fn definition(values: Vec[i64]) -> i64 {
    let mut best = i64.MAX;
    for i in 0..values.len() {
        for j in i + 1..values.len() {
            let gap = if values[i] > values[j] { values[i] - values[j] } else { values[j] - values[i] };
            best = best.min(gap);
        }
    }
    best
}

fn shuffled(seed: mut ref i64, values: Vec[i64]) -> Vec[i64] {
    let mut out = values.clone();
    let mut i = out.len() - 1;
    while i > 0 {
        out.swap(i, next_random(mut seed) % (i + 1));
        i -= 1;
    }
    out
}

fn sorted(values: Vec[i64]) -> Vec[i64] {
    let mut out = values.clone();
    out.sort();
    out
}

// The sorted values from `lo` to `hi`, middle first, then each half the
// same way: the order that inserts a balanced tree.
fn middle_first(ordered: Vec[i64], lo: i64, hi: i64, out: mut ref Vec[i64]) {
    if lo > hi {
        return;
    }
    let mid = (lo + hi) / 2;
    out.push(ordered[mid]);
    middle_first(ordered, lo, mid - 1, mut out);
    middle_first(ordered, mid + 1, hi, mut out);
}

// n distinct values from 0 to `top`, in a random order.
fn random_values(seed: mut ref i64, n: i64, top: i64) -> Vec[i64] {
    let mut taken: Set[i64] = Set.new();
    let mut values: Vec[i64] = Vec.new();
    while values.len() < n {
        let hi = next_random(mut seed);
        let v = (hi * 32768 + next_random(mut seed)) % (top + 1);
        if not taken.contains(v) {
            taken.insert(v);
            values.push(v);
        }
    }
    values
}

// The multiples of `step` from 0 to (n - 2) * step, and one more value 1
// above one of them: the only gap of 1. The pair is 0 and 1 a third of
// the time, the largest value and the one below it a third, and
// anywhere else the rest.
fn planted_values(seed: mut ref i64, n: i64, step: i64) -> Vec[i64] {
    let mut values: Vec[i64] = Vec.new();
    for i in 0..n - 1 {
        values.push(i * step);
    }
    let top = (n - 2) * step;
    let where = next_random(mut seed) % 3;
    values.push(if where == 0 { 1 } else if where == 1 { top - 1 } else { (next_random(mut seed) % (n - 2)) * step + 1 });
    shuffled(mut seed, values)
}

// The values in the order of a kind of tree. kind 0: as they are; kind 1:
// ascending or descending, a chain; kind 2: middle first, a balanced
// tree; kind 3: the two ends alternately, a zigzag path.
fn arranged(seed: mut ref i64, values: own Vec[i64], kind: i64) -> Vec[i64] {
    if kind == 0 {
        return values;
    }
    let n = values.len();
    let ordered = sorted(values);
    if kind == 1 {
        if next_random(mut seed) % 2 == 0 {
            return ordered;
        }
        let mut out: Vec[i64] = Vec.new();
        let mut i = n - 1;
        while i >= 0 {
            out.push(ordered[i]);
            i -= 1;
        }
        return out;
    }
    let mut out: Vec[i64] = Vec.new();
    if kind == 2 {
        middle_first(ordered, 0, n - 1, mut out);
        return out;
    }
    let mut lo = 0;
    let mut hi = n - 1;
    while lo <= hi {
        out.push(ordered[lo]);
        lo += 1;
        if lo <= hi {
            out.push(ordered[hi]);
            hi -= 1;
        }
    }
    out
}

fn main() {
    let arms = 4;
    let mut seed = 7830;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 2000;
    let mut gaps = 0;
    for case in 0..cases {
        // 2 to 100 values, LeetCode's range. A fifth of the trees hold
        // the planted values, 3 to 100 of them, spaced from 3 to 1,000
        // apart. Of the rest a third are on 0 to about 2n, so gaps of 1
        // are common, a third on up to about 2,000 and a third on up to
        // 100,000, LeetCode's limit. A quarter of each kind.
        let planted = case % 5 == 4;
        let mut n = 2 + next_random(mut seed) % 99;
        let mut top = 0;
        let mut drawn: Vec[i64] = Vec.new();
        if planted {
            n = 3 + next_random(mut seed) % 98;
            let step = 3 + next_random(mut seed) % 998;
            top = (n - 2) * step;
            drawn = planted_values(mut seed, n, step);
        } else {
            let spread = case % 3;
            top = n - 1 + next_random(mut seed) % (if spread == 0 { n + 1 } else if spread == 1 { 2000 } else { 100000 - n + 1 });
            drawn = random_values(mut seed, n, top);
        }
        let values = arranged(mut seed, drawn, case % 4);
        let want = definition(values);
        gaps += want;
        let root = build(values);
        let other = build(shuffled(mut seed, values));
        let mut mirrored_values: Vec[i64] = Vec.new();
        for v in values.iter() {
            mirrored_values.push(top - *v);
        }
        let mirrored = build(mirrored_values);
        // For P4, one more value, not among them, inserted last.
        let mut x = next_random(mut seed) % (top + 2);
        while values.contains(x) {
            x = (x + 1) % (top + 2);
        }
        let mut nearest = i64.MAX;
        for v in values.iter() {
            nearest = nearest.min(if *v > x { *v - x } else { x - *v });
        }
        let mut grown_values = values.clone();
        grown_values.push(x);
        let grown = build(grown_values);
        for which in 0..arms {
            let got = answer_with(which, root);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the same values inserted in another order, a tree of
            // another shape, give the same answer.
            checks += 1;
            if answer_with(which, other) != got {
                fails[1] += 1;
            }
            // P3: every value v made top - v, the tree's mirror image,
            // gives the same answer.
            checks += 1;
            if answer_with(which, mirrored) != got {
                fails[2] += 1;
            }
            // P4: one more value gives the least of the answer and that
            // value's gap to its nearest.
            checks += 1;
            if answer_with(which, grown) != got.min(nearest) {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} trees (smallest gaps sum to {gaps}), {arms} arms, {checks} checks, {failures} failures");
}
