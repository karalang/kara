// LeetCode 783 — Minimum Distance Between BST Nodes: the bench.
//
// 64 search trees of 100 values from 0 to 100,000, LeetCode's limits,
// are built once: half by inserting the values in a random order, a
// quarter middle first (balanced) and a quarter in ascending order (a
// chain). Each round answers the next tree with the ★ arm, ancestor
// bounds.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn closest(node: Option[TreeNode], low: i64, high: i64) -> i64 {
    let Some(n) = node else {
        return i64.MAX;
    };
    let mut best = i64.MAX;
    if low != -1 {
        best = best.min(n.val - low);
    }
    if high != -1 {
        best = best.min(high - n.val);
    }
    best = best.min(closest(n.left, low, n.val));
    best.min(closest(n.right, n.val, high))
}

fn min_diff_in_bst(root: Option[TreeNode]) -> i64 {
    closest(root, -1, -1)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn insert(root: Option[TreeNode], v: i64) -> Option[TreeNode] {
    let Some(r) = root else {
        return Some(TreeNode { val: v, left: None, right: None });
    };
    let mut at = r;
    loop {
        if v < at.val {
            match at.left {
                Some(l) => {
                    at = l;
                }
                None => {
                    at.left = Some(TreeNode { val: v, left: None, right: None });
                    break;
                }
            }
        } else {
            match at.right {
                Some(c) => {
                    at = c;
                }
                None => {
                    at.right = Some(TreeNode { val: v, left: None, right: None });
                    break;
                }
            }
        }
    }
    Some(r)
}

// The sorted values from `lo` to `hi`, middle first, then each half the
// same way: the order that inserts a balanced tree.
fn middle_first(ordered: Vec[i64], lo: i64, hi: i64, out: mut ref Vec[i64]) {
    if lo > hi {
        return;
    }
    let mid = (lo + hi) / 2;
    out.push(ordered[mid]);
    middle_first(ordered, lo, mid - 1, mut out);
    middle_first(ordered, mid + 1, hi, mut out);
}

fn main() {
    let mut seed = 783;
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    for t in 0..64 {
        let mut taken: Set[i64] = Set.new();
        let mut values: Vec[i64] = Vec.new();
        while values.len() < 100 {
            let hi = next_random(mut seed);
            let v = (hi * 32768 + next_random(mut seed)) % 100001;
            if not taken.contains(v) {
                taken.insert(v);
                values.push(v);
            }
        }
        if t % 4 >= 2 {
            values.sort();
        }
        if t % 4 == 2 {
            let mut order: Vec[i64] = Vec.new();
            middle_first(values, 0, 99, mut order);
            values = order;
        }
        let mut root: Option[TreeNode] = None;
        for v in values.iter() {
            root = insert(root, *v);
        }
        trees.push(root);
    }
    let rounds = 2000000;
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        let answer = min_diff_in_bst(trees[r % 64]);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{rounds} rounds of 100-value trees: gaps sum to {total}, checksum {check}");
}
