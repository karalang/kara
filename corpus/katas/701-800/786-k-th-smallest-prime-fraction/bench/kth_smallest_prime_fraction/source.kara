// LeetCode 786 — K-th Smallest Prime Fraction: the bench.
//
// 64 arrays of 1,000 numbers, LeetCode's most, are made once: 1 and 999
// different primes below 30,000 picked at random. Each of 64 rounds asks
// the next array for a random k-th smallest fraction, answered with the ★
// arm, a heap of the next fraction for each denominator.

struct Fraction {
    i: i64,
    j: i64,
    num: i64,
    den: i64,
}

impl PartialEq for Fraction {
    fn eq(ref self, other: ref Fraction) -> bool {
        self.num * other.den == other.num * self.den
    }
}

impl Eq for Fraction {}

impl PartialOrd for Fraction {
    fn partial_cmp(ref self, other: ref Fraction) -> Option[Ordering] {
        Some(self.cmp(other))
    }
}

impl Ord for Fraction {
    fn cmp(ref self, other: ref Fraction) -> Ordering {
        (self.num * other.den).cmp(other.num * self.den)
    }
}

fn kth_smallest_prime_fraction(arr: Vec[i64], k: i64) -> Vec[i64] {
    let n = arr.len();
    let mut heap: PriorityQueue[Fraction] = PriorityQueue.new();
    for j in 1..n {
        heap.push(Fraction { i: 0, j: j, num: arr[0], den: arr[j] });
    }
    for _ in 0..k - 1 {
        let Some(f) = heap.pop() else {
            break;
        };
        if f.i + 1 < f.j {
            heap.push(Fraction { i: f.i + 1, j: f.j, num: arr[f.i + 1], den: f.den });
        }
    }
    let Some(f) = heap.pop() else {
        return [];
    };
    [f.num, f.den]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut composite: Vec[bool] = Vec.new();
    for _ in 0..30000 {
        composite.push(false);
    }
    let mut primes: Vec[i64] = Vec.new();
    for p in 2..30000 {
        if not composite[p] {
            primes.push(p);
            let mut m = p * p;
            while m < 30000 {
                composite[m] = true;
                m += p;
            }
        }
    }
    let mut seed = 786;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..64 {
        let mut taken: Vec[bool] = Vec.new();
        for _ in 0..primes.len() {
            taken.push(false);
        }
        let mut count = 0;
        while count < 999 {
            let at = next_random(mut seed) % primes.len();
            if not taken[at] {
                taken[at] = true;
                count += 1;
            }
        }
        let mut arr: Vec[i64] = [1];
        for at in 0..primes.len() {
            if taken[at] {
                arr.push(primes[at]);
            }
        }
        arrays.push(arr);
    }
    let rounds = 64;
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        let k = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 499500;
        let answer = kth_smallest_prime_fraction(arrays[r % 64], k);
        sum += answer[0] + answer[1];
        check = (check * 31 + answer[0] * 7 + answer[1]) % 1000000007;
    }
    println(f"{rounds} rounds of 1000-number arrays: terms sum to {sum}, checksum {check}");
}
