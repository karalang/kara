// LeetCode 786 — K-th Smallest Prime Fraction, a heap of the next
// fraction for each denominator.
//
// For a fixed denominator arr[j] the fractions arr[i] / arr[j] grow with
// i, so the fractions are n - 1 sorted lists to merge. Start a
// smallest-first heap with the least fraction of each list, arr[0] /
// arr[j]; each time the least is taken out, put in the next one of its
// list. The k-th one taken out is the answer. O(n + k log n).

struct Fraction {
    i: i64,
    j: i64,
    num: i64,
    den: i64,
}

impl PartialEq for Fraction {
    fn eq(ref self, other: ref Fraction) -> bool {
        self.num * other.den == other.num * self.den
    }
}

impl Eq for Fraction {}

impl PartialOrd for Fraction {
    fn partial_cmp(ref self, other: ref Fraction) -> Option[Ordering] {
        Some(self.cmp(other))
    }
}

impl Ord for Fraction {
    fn cmp(ref self, other: ref Fraction) -> Ordering {
        (self.num * other.den).cmp(other.num * self.den)
    }
}

fn kth_smallest_prime_fraction(arr: Vec[i64], k: i64) -> Vec[i64] {
    let n = arr.len();
    let mut heap: PriorityQueue[Fraction] = PriorityQueue.new();
    for j in 1..n {
        heap.push(Fraction { i: 0, j: j, num: arr[0], den: arr[j] });
    }
    for _ in 0..k - 1 {
        let Some(f) = heap.pop() else {
            break;
        };
        if f.i + 1 < f.j {
            heap.push(Fraction { i: f.i + 1, j: f.j, num: arr[f.i + 1], den: f.den });
        }
    }
    let Some(f) = heap.pop() else {
        return [];
    };
    [f.num, f.den]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The primes below `limit`, by the sieve of Eratosthenes.
fn primes_below(limit: i64) -> Vec[i64] {
    let mut composite: Vec[bool] = Vec.new();
    for _ in 0..limit {
        composite.push(false);
    }
    let mut out: Vec[i64] = Vec.new();
    for p in 2..limit {
        if not composite[p] {
            out.push(p);
            let mut m = p * p;
            while m < limit {
                composite[m] = true;
                m += p;
            }
        }
    }
    out
}

fn show(arr: Vec[i64], k: i64) {
    let answer = kth_smallest_prime_fraction(arr, k);
    println(f"arr = {arr}, k = {k} -> {answer}");
}

fn main() {
    show([1, 2, 3, 5], 3);
    show([1, 7], 1);
    show([1, 2, 3, 5], 1);
    show([1, 2, 3, 5], 6);
    show([1, 13, 17, 59], 4);
    show([1, 2, 29989], 2);
    let primes = primes_below(30000);
    let mut arr: Vec[i64] = [1];
    for t in 0..999 {
        arr.push(primes[t]);
    }
    let all = 999 * 1000 / 2;
    for k in [1, 2, 1000, 250000, all - 1, all] {
        let answer = kth_smallest_prime_fraction(arr, k);
        println(f"1 and the first 999 primes, k = {k} -> {answer}");
    }
    let mut seed = 786;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 2 + next_random(mut seed) % 59;
        let mut taken: Set[i64] = Set.new();
        let mut picked: Vec[i64] = Vec.new();
        while picked.len() < n - 1 {
            let p = primes[next_random(mut seed) % primes.len()];
            if not taken.contains(p) {
                taken.insert(p);
                picked.push(p);
            }
        }
        picked.sort();
        let mut arr: Vec[i64] = [1];
        for p in picked.iter() {
            arr.push(*p);
        }
        let k = 1 + next_random(mut seed) % (n * (n - 1) / 2);
        let answer = kth_smallest_prime_fraction(arr, k);
        sum += answer[0] + answer[1];
        check = (check * 31 + answer[0] * 7 + answer[1]) % 1000000007;
    }
    println(f"300 random arrays: terms sum to {sum}, checksum {check}");
}
