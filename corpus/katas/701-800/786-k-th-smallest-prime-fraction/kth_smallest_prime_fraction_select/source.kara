// LeetCode 786 — K-th Smallest Prime Fraction, quickselect.
//
// Make every pair (i, j) with i < j, then find the k-th smallest without
// sorting them all: split the range around the value of its middle pair
// into the fractions less than it and the rest, and go on in the side
// that holds position k - 1. O(n²) on average.

fn less(a: (i64, i64), b: (i64, i64)) -> bool {
    a.0 * b.1 < b.0 * a.1
}

fn kth_smallest_prime_fraction(arr: Vec[i64], k: i64) -> Vec[i64] {
    let n = arr.len();
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for j in 1..n {
        for i in 0..j {
            pairs.push((arr[i], arr[j]));
        }
    }
    let want = k - 1;
    let mut lo = 0;
    let mut hi = pairs.len() - 1;
    while lo < hi {
        // Lomuto's partition of pairs[lo..=hi] around its middle pair,
        // moved to the end first.
        pairs.swap((lo + hi) / 2, hi);
        let pivot = pairs[hi];
        let mut store = lo;
        for at in lo..hi {
            if less(pairs[at], pivot) {
                pairs.swap(at, store);
                store += 1;
            }
        }
        pairs.swap(store, hi);
        if store == want {
            break;
        }
        if store < want {
            lo = store + 1;
        } else {
            hi = store - 1;
        }
    }
    let (num, den) = pairs[want];
    [num, den]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The primes below `limit`, by the sieve of Eratosthenes.
fn primes_below(limit: i64) -> Vec[i64] {
    let mut composite: Vec[bool] = Vec.new();
    for _ in 0..limit {
        composite.push(false);
    }
    let mut out: Vec[i64] = Vec.new();
    for p in 2..limit {
        if not composite[p] {
            out.push(p);
            let mut m = p * p;
            while m < limit {
                composite[m] = true;
                m += p;
            }
        }
    }
    out
}

fn show(arr: Vec[i64], k: i64) {
    let answer = kth_smallest_prime_fraction(arr, k);
    println(f"arr = {arr}, k = {k} -> {answer}");
}

fn main() {
    show([1, 2, 3, 5], 3);
    show([1, 7], 1);
    show([1, 2, 3, 5], 1);
    show([1, 2, 3, 5], 6);
    show([1, 13, 17, 59], 4);
    show([1, 2, 29989], 2);
    let primes = primes_below(30000);
    let mut arr: Vec[i64] = [1];
    for t in 0..999 {
        arr.push(primes[t]);
    }
    let all = 999 * 1000 / 2;
    for k in [1, 2, 1000, 250000, all - 1, all] {
        let answer = kth_smallest_prime_fraction(arr, k);
        println(f"1 and the first 999 primes, k = {k} -> {answer}");
    }
    let mut seed = 786;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 2 + next_random(mut seed) % 59;
        let mut taken: Set[i64] = Set.new();
        let mut picked: Vec[i64] = Vec.new();
        while picked.len() < n - 1 {
            let p = primes[next_random(mut seed) % primes.len()];
            if not taken.contains(p) {
                taken.insert(p);
                picked.push(p);
            }
        }
        picked.sort();
        let mut arr: Vec[i64] = [1];
        for p in picked.iter() {
            arr.push(*p);
        }
        let k = 1 + next_random(mut seed) % (n * (n - 1) / 2);
        let answer = kth_smallest_prime_fraction(arr, k);
        sum += answer[0] + answer[1];
        check = (check * 31 + answer[0] * 7 + answer[1]) % 1000000007;
    }
    println(f"300 random arrays: terms sum to {sum}, checksum {check}");
}
