// LeetCode 797 — All Paths From Source to Target: the bench.
//
// 1,024 graphs of 15 nodes, LeetCode's most, are made once: a random
// order of the nodes with 0 first and 14 last, each edge from earlier in
// it to later taken with a chance of 1 to 4 in 5. Each of 40,960 rounds
// lists every path of the next graph with the ★ arm, adding up the
// paths, the nodes on them and a checksum of each path that does not
// depend on their order.
fn all_paths_source_target(graph: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut paths: Vec[Vec[i64]] = Vec.new();
    let mut path: Vec[i64] = Vec.new();
    path.push(0);
    walk(graph, 0, mut path, mut paths);
    paths
}

fn walk(graph: Vec[Vec[i64]], node: i64, path: mut ref Vec[i64], paths: mut ref Vec[Vec[i64]]) {
    if node == graph.len() - 1 {
        paths.push(path.clone());
        return;
    }
    for next in graph[node].iter() {
        path.push(*next);
        walk(graph, *next, mut path, mut paths);
        path.pop();
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 15;
    let mut seed = 797;
    let mut graphs: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..1024 {
        let mut order: Vec[i64] = Vec.new();
        order.push(0);
        for i in 1..n - 1 {
            order.push(i);
        }
        for i in 2..n - 1 {
            let j = 1 + next_random(mut seed) % i;
            let t = order[i];
            order[i] = order[j];
            order[j] = t;
        }
        order.push(n - 1);
        let chance = 1 + next_random(mut seed) % 4;
        let mut graph: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            graph.push(Vec.new());
        }
        for a in 0..n {
            for b in a + 1..n {
                if next_random(mut seed) % 5 < chance {
                    graph[order[a]].push(order[b]);
                }
            }
        }
        graphs.push(graph);
    }
    let rounds = 40960;
    let mut count = 0;
    let mut nodes = 0;
    let mut check = 0;
    for r in 0..rounds {
        let paths = all_paths_source_target(graphs[r % 1024]);
        count += paths.len();
        for path in paths.iter() {
            nodes += path.len();
            let mut h = 0;
            for v in path.iter() {
                h = (h * 31 + *v + 1) % 1000000007;
            }
            check = (check + h) % 1000000007;
        }
    }
    println(f"{rounds} graphs: {count} paths through {nodes} nodes, checksum {check}");
}
