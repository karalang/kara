// LeetCode #795: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties
// on random arrays and bounds.

// ---- ★ arm ----------------------------------------------------------

fn num_subarray_bounded_max_star(nums: Vec[i64], left: i64, right: i64) -> i64 {
    let mut too_big = -1;
    let mut in_range = -1;
    let mut count = 0;
    for i in 0..nums.len() {
        if nums[i] > right {
            too_big = i;
        } else if nums[i] >= left {
            in_range = i;
        }
        if in_range > too_big {
            count += in_range - too_big;
        }
    }
    count
}

// ---- at-most arm ----------------------------------------------------

fn all_at_most_atmost(nums: Vec[i64], bound: i64) -> i64 {
    let mut count = 0;
    let mut run = 0;
    for x in nums {
        if x <= bound {
            run += 1;
            count += run;
        } else {
            run = 0;
        }
    }
    count
}

fn num_subarray_bounded_max_atmost(nums: Vec[i64], left: i64, right: i64) -> i64 {
    all_at_most_atmost(nums, right) - all_at_most_atmost(nums, left - 1)
}

// ---- stack arm ------------------------------------------------------

fn num_subarray_bounded_max_stack(nums: Vec[i64], left: i64, right: i64) -> i64 {
    let n = nums.len();
    // before[i]: the last place before i with a number at least nums[i],
    // or -1; after[i]: the first place after i with a larger number, or n.
    let mut before: Vec[i64] = Vec.new();
    let mut after: Vec[i64] = Vec.new();
    for _ in 0..n {
        before.push(-1);
        after.push(n);
    }
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while stack.len() > 0 and nums[stack[stack.len() - 1]] < nums[i] {
            let top = stack.pop().unwrap();
            after[top] = i;
        }
        if stack.len() > 0 {
            before[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    let mut count = 0;
    for i in 0..n {
        if nums[i] >= left and nums[i] <= right {
            count += (i - before[i]) * (after[i] - i);
        }
    }
    count
}

// ---- scan arm -------------------------------------------------------

fn num_subarray_bounded_max_scan(nums: Vec[i64], left: i64, right: i64) -> i64 {
    let mut count = 0;
    for start in 0..nums.len() {
        let mut largest = nums[start];
        let mut end = start;
        while end < nums.len() and nums[end] <= right {
            largest = largest.max(nums[end]);
            if largest >= left {
                count += 1;
            }
            end += 1;
        }
    }
    count
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, nums: Vec[i64], left: i64, right: i64) -> i64 {
    if which == 0 {
        num_subarray_bounded_max_star(nums, left, right)
    } else if which == 1 {
        num_subarray_bounded_max_atmost(nums, left, right)
    } else if which == 2 {
        num_subarray_bounded_max_stack(nums, left, right)
    } else {
        num_subarray_bounded_max_scan(nums, left, right)
    }
}

// The definition: every subarray, its maximum found afresh.
fn definition(nums: Vec[i64], left: i64, right: i64) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for i in 0..n {
        for j in i..n {
            let mut largest = nums[i];
            for k in i..j + 1 {
                if nums[k] > largest {
                    largest = nums[k];
                }
            }
            if largest >= left and largest <= right {
                count += 1;
            }
        }
    }
    count
}

fn main() {
    let arms = 4;
    let mut seed = 7950;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1600;
    let mut total = 0;
    for case in 0..cases {
        // kind 0: few different numbers; kind 1: up to a billion; kind 2:
        // a range that takes in every number or none; kind 3: runs of
        // one number.
        let kind = case % 4;
        let n = 1 + next_random(mut seed) % 30;
        let top = if kind == 1 { 1000000001 } else { 1 + next_random(mut seed) % 8 };
        let mut nums: Vec[i64] = Vec.new();
        while nums.len() < n {
            let x = if kind == 1 { (next_random(mut seed) * 32768 + next_random(mut seed)) % top } else { next_random(mut seed) % top };
            let times = if kind == 3 { 1 + next_random(mut seed) % 5 } else { 1 };
            for _ in 0..times {
                if nums.len() < n {
                    nums.push(x);
                }
            }
        }
        let (left, right) = if kind == 2 {
            if next_random(mut seed) % 2 == 0 { (0, top) } else { (top, top + 5) }
        } else {
            let a = nums[next_random(mut seed) % n] + next_random(mut seed) % 3 - 1;
            let b = nums[next_random(mut seed) % n] + next_random(mut seed) % 3 - 1;
            (a.min(b).max(0), a.max(b).max(0))
        };
        let want = definition(nums, left, right);
        total += want;
        let mut reversed = nums.clone();
        reversed.reverse();
        let cut = left + next_random(mut seed) % (right - left + 1);
        for which in 0..arms {
            let got = answer_with(which, nums, left, right);
            // P1: the definition's count.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the array backwards has the same count.
            checks += 1;
            if answer_with(which, reversed, left, right) != got {
                fails[1] += 1;
            }
            // P3: the range cut in two at any number gives counts that
            // add up to the whole.
            checks += 1;
            let low = if cut > left { answer_with(which, nums, left, cut - 1) } else { 0 };
            if low + answer_with(which, nums, cut, right) != got {
                fails[2] += 1;
            }
            // P4: a range taking in every number counts every subarray,
            // n (n + 1) / 2 of them.
            checks += 1;
            if answer_with(which, nums, 0, 1000000000) != n * (n + 1) / 2 {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} cases ({total} subarrays), {arms} arms, {checks} checks, {failures} failures");
}
