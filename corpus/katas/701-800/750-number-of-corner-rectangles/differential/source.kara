// LeetCode #750: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random grids.

// ---- ★ arm ----------------------------------------------------------

fn count_corner_rectangles_star(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut total = 0;
    for a in 0..m {
        for b in a + 1..m {
            let mut k = 0;
            for c in 0..n {
                if grid[a][c] == 1 and grid[b][c] == 1 {
                    k += 1;
                }
            }
            total += k * (k - 1) / 2;
        }
    }
    total
}

// ---- colpairs arm ---------------------------------------------------

fn count_corner_rectangles_colpairs(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid[0].len();
    let mut seen: Vec[i64] = Vec.new();
    for _ in 0..n * n {
        seen.push(0);
    }
    let mut total = 0;
    for row in grid.iter() {
        let mut ones: Vec[i64] = Vec.new();
        for c in 0..n {
            if row[c] == 1 {
                ones.push(c);
            }
        }
        for i in 0..ones.len() {
            for j in i + 1..ones.len() {
                let key = ones[i] * n + ones[j];
                total += seen[key];
                seen[key] += 1;
            }
        }
    }
    total
}

// ---- bits arm -------------------------------------------------------

fn count_corner_rectangles_bits(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let words = (n + 63) / 64;
    let mut rows: Vec[Vec[u64]] = Vec.new();
    for r in 0..m {
        let mut bits: Vec[u64] = Vec.new();
        for _ in 0..words {
            bits.push(0);
        }
        for c in 0..n {
            if grid[r][c] == 1 {
                bits[c / 64] = bits[c / 64] | (1 as u64 << (c % 64) as u64);
            }
        }
        rows.push(bits);
    }
    let mut total = 0;
    for a in 0..m {
        for b in a + 1..m {
            let mut k = 0;
            for w in 0..words {
                k += (rows[a][w] & rows[b][w]).count_ones();
            }
            total += k * (k - 1) / 2;
        }
    }
    total
}

// ---- map arm --------------------------------------------------------

fn count_corner_rectangles_map(grid: Vec[Vec[i64]]) -> i64 {
    let mut pairs: Map[(i64, i64), i64] = Map.new();
    for row in grid.iter() {
        let mut ones: Vec[i64] = Vec.new();
        for c in 0..row.len() {
            if row[c] == 1 {
                ones.push(c);
            }
        }
        for i in 0..ones.len() {
            for j in i + 1..ones.len() {
                let key = (ones[i], ones[j]);
                let now = match pairs.get(key) {
                    Some(k) => k,
                    None => 0,
                };
                pairs.insert(key, now + 1);
            }
        }
    }
    let mut total = 0;
    for (_, k) in pairs.iter() {
        total += *k * (*k - 1) / 2;
    }
    total
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, grid: Vec[Vec[i64]]) -> i64 {
    if which == 0 {
        count_corner_rectangles_star(grid)
    } else if which == 1 {
        count_corner_rectangles_colpairs(grid)
    } else if which == 2 {
        count_corner_rectangles_bits(grid)
    } else {
        count_corner_rectangles_map(grid)
    }
}

// The definition, as the problem states it: every choice of two rows
// r1 < r2 and two columns c1 < c2 whose four corner cells are all 1.
fn definition(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut count = 0;
    for r1 in 0..m {
        for r2 in r1 + 1..m {
            for c1 in 0..n {
                for c2 in c1 + 1..n {
                    if grid[r1][c1] == 1 and grid[r1][c2] == 1 and grid[r2][c1] == 1 and grid[r2][c2] == 1 {
                        count += 1;
                    }
                }
            }
        }
    }
    count
}

fn main() {
    let mut seed = 7500;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut total = 0;
    let cases = 3000;
    for _ in 0..cases {
        // 1 to 7 rows of 1 to 7 cells, each 1 with a chance of 20 to 90
        // in 100
        let m = 1 + next_random(mut seed) % 7;
        let n = 1 + next_random(mut seed) % 7;
        let percent = 20 + next_random(mut seed) % 71;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(if next_random(mut seed) % 100 < percent { 1 } else { 0 });
            }
            grid.push(row);
        }
        let want = definition(grid);
        total += want;
        let mut flipped: Vec[Vec[i64]] = Vec.new();
        for c in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for r in 0..m {
                row.push(grid[r][c]);
            }
            flipped.push(row);
        }
        // a row of zeros put in at a random place
        let mut padded: Vec[Vec[i64]] = Vec.new();
        let at = next_random(mut seed) % (m + 1);
        for r in 0..m + 1 {
            if r == at {
                let mut zeros: Vec[i64] = Vec.new();
                for _ in 0..n {
                    zeros.push(0);
                }
                padded.push(zeros);
            }
            if r < m {
                padded.push(grid[r].clone());
            }
        }
        // the first row again at the end, and the grid without its first row
        let mut doubled = grid.clone();
        doubled.push(grid[0].clone());
        let mut rest: Vec[Vec[i64]] = Vec.new();
        for r in 1..m {
            rest.push(grid[r].clone());
        }
        let mut first_ones = 0;
        for c in 0..n {
            first_ones += grid[0][c];
        }
        for which in 0..arms {
            let got = answer_with(which, grid);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the grid transposed, the same answer.
            checks += 1;
            if answer_with(which, flipped) != got {
                fails[1] += 1;
            }
            // P3: a row of zeros added, the same answer.
            checks += 1;
            if answer_with(which, padded) != got {
                fails[2] += 1;
            }
            // P4: the first row added again. The new rectangles are the
            // ones the first row makes with each other row, which is the
            // answer less the answer without the first row, and the ones
            // it makes with its copy, a pair of its 1s each.
            checks += 1;
            let without = if m == 1 { 0 } else { answer_with(which, rest) };
            let expect = got + (got - without) + first_ones * (first_ones - 1) / 2;
            if answer_with(which, doubled) != expect {
                fails[3] += 1;
            }
        }
    }
    let mut failures = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        failures += fails[i];
    }
    println(f"{cases} grids ({total} rectangles in all), {arms} arms, {checks} checks, {failures} failures");
}
