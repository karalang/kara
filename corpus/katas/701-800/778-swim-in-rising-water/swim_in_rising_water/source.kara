// LeetCode 778 — Swim in Rising Water, Dijkstra on the highest square.
//
// At time t every square of elevation at most t is under water, and the
// swimmer moves freely between such neighbours. So the answer is the
// least, over all ways from the top left to the bottom right, of the
// highest square on the way. Dijkstra with that highest square as a
// way's cost: a smallest-first `PriorityQueue` of (highest so far,
// square) settles the squares in order of their cost, and the bottom
// right's cost is the answer. O(n² log n).

fn swim_in_water(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut done: Vec[bool] = Vec.filled(n * n, false);
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    queue.push((grid[0][0], 0));
    while let Some((t, at)) = queue.pop() {
        if done[at] {
            continue;
        }
        done[at] = true;
        let r = at / n;
        let c = at % n;
        if r == n - 1 and c == n - 1 {
            return t;
        }
        for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)] {
            let nr = r + dr;
            let nc = c + dc;
            if nr >= 0 and nr < n and nc >= 0 and nc < n and not done[nr * n + nc] {
                let h = grid[nr][nc];
                queue.push((if h > t { h } else { t }, nr * n + nc));
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// An n by n grid holding 0 to n² - 1 in a random order.
fn random_grid(seed: mut ref i64, n: i64) -> Vec[Vec[i64]] {
    let mut values: Vec[i64] = Vec.new();
    for v in 0..n * n {
        values.push(v);
    }
    let mut i = n * n - 1;
    while i > 0 {
        values.swap(i, next_random(mut seed) % (i + 1));
        i -= 1;
    }
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for r in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for c in 0..n {
            row.push(values[r * n + c]);
        }
        grid.push(row);
    }
    grid
}

// 0 to n² - 1 laid along the rows, every other row backwards.
fn snake(n: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for r in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for c in 0..n {
            row.push(if r % 2 == 0 { r * n + c } else { r * n + n - 1 - c });
        }
        grid.push(row);
    }
    grid
}

fn show(grid: Vec[Vec[i64]]) {
    let answer = swim_in_water(grid);
    println(f"{grid} -> {answer}");
}

fn main() {
    show([[0, 2], [1, 3]]);
    show([[0, 1, 2, 3, 4], [24, 23, 22, 21, 5], [12, 13, 14, 15, 16], [11, 17, 18, 19, 20], [10, 9, 8, 7, 6]]);
    show([[0]]);
    show([[3, 0], [1, 2]]);
    show([[0, 3], [2, 1]]);
    show([[0, 8, 7], [1, 6, 5], [2, 3, 4]]);
    show([[0, 7, 8], [6, 1, 2], [5, 4, 3]]);
    let mut seed = 778;
    let answer = swim_in_water(random_grid(mut seed, 50));
    println(f"random 50 x 50 -> {answer}");
    let answer = swim_in_water(snake(50));
    println(f"snake 50 x 50 -> {answer}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 20;
        let answer = swim_in_water(random_grid(mut seed, n));
        total += answer;
        check = (check * 31 + answer * 50 + n) % 1000000007;
    }
    println(f"300 random grids: answers sum to {total}, checksum {check}");
}
