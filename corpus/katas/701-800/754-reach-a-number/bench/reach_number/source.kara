// LeetCode 754 — Reach a Number, bench: the ★ arm (step by step) on
// random targets.

fn reach_number(target: i64) -> i64 {
    let t = target.abs();
    let mut k = 0;
    let mut sum = 0;
    while sum < t or (sum - t) % 2 != 0 {
        k += 1;
        sum += k;
    }
    k
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 30000;
    let mut seed = 754;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        let mut target = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1;
        if next_random(mut seed) % 2 == 0 {
            target = -target;
        }
        let moves = reach_number(target);
        total += moves;
        check = (check * 31 + moves) % 1000000007;
    }
    println(f"{rounds} targets: {total} moves in all, checksum {check}");
}
