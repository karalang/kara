// LeetCode 754 — Reach a Number, step by step.
//
// Only the distance matters, since the moves can be mirrored, so aim at
// t = |target|. After k moves of every sign, the sum of 1..k, the walk
// can reach t exactly when that sum is at least t and differs from it by
// an even number: flipping move i lowers the sum by 2i, and every even
// amount up to the sum is a sum of distinct flips. So keep moving until
// both hold. O(sqrt(t)).

fn reach_number(target: i64) -> i64 {
    let t = target.abs();
    let mut k = 0;
    let mut sum = 0;
    while sum < t or (sum - t) % 2 != 0 {
        k += 1;
        sum += k;
    }
    k
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(target: i64) {
    println(f"target = {target} -> {reach_number(target)}");
}

fn main() {
    show(2);
    show(3);
    show(1);
    show(-1);
    show(4);
    show(5);
    show(-6);
    show(1000000000);
    show(-1000000000);
    show(999961560);
    show(999961561);
    let mut seed = 754;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let mut target = next_random(mut seed) * 32768 + next_random(mut seed);
        target = target % 1000000000 + 1;
        if next_random(mut seed) % 2 == 0 {
            target = -target;
        }
        let moves = reach_number(target);
        total += moves;
        check = (check * 31 + moves) % 1000000007;
    }
    println(f"1000 random targets: {total} moves in all, checksum {check}");
}
