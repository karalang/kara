// LeetCode 754 — Reach a Number, by binary search.
//
// Search 0 to 100,000 moves for the first k whose sum 1 + ... + k is at
// least t = |target| (the sums only grow, so a binary search finds it),
// then take one move at a time until the excess over t is even, which
// takes at most two. O(log t).

fn reach_number(target: i64) -> i64 {
    let t = target.abs();
    let mut low = 0;
    let mut high = 100000;
    while low < high {
        let mid = (low + high) / 2;
        if mid * (mid + 1) / 2 >= t {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    let mut k = low;
    while (k * (k + 1) / 2 - t) % 2 != 0 {
        k += 1;
    }
    k
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(target: i64) {
    println(f"target = {target} -> {reach_number(target)}");
}

fn main() {
    show(2);
    show(3);
    show(1);
    show(-1);
    show(4);
    show(5);
    show(-6);
    show(1000000000);
    show(-1000000000);
    show(999961560);
    show(999961561);
    let mut seed = 754;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let mut target = next_random(mut seed) * 32768 + next_random(mut seed);
        target = target % 1000000000 + 1;
        if next_random(mut seed) % 2 == 0 {
            target = -target;
        }
        let moves = reach_number(target);
        total += moves;
        check = (check * 31 + moves) % 1000000007;
    }
    println(f"1000 random targets: {total} moves in all, checksum {check}");
}
