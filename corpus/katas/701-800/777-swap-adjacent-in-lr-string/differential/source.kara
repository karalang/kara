// LeetCode #777: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties
// on random pairs of strings.

// ---- ★ arm ----------------------------------------------------------

fn can_transform_star(start: String, end: String) -> bool {
    let s = start.bytes();
    let e = end.bytes();
    let n = s.len();
    if e.len() != n {
        return false;
    }
    let mut i = 0;
    let mut j = 0;
    loop {
        while i < n and s[i] == b'X' {
            i += 1;
        }
        while j < n and e[j] == b'X' {
            j += 1;
        }
        if i == n or j == n {
            return i == n and j == n;
        }
        if s[i] != e[j] {
            return false;
        }
        if s[i] == b'L' and i < j {
            return false;
        }
        if s[i] == b'R' and i > j {
            return false;
        }
        i += 1;
        j += 1;
    }
}

// ---- prefix arm -----------------------------------------------------

fn can_transform_prefix(start: String, end: String) -> bool {
    if start.len() != end.len() or start.replace("X", "") != end.replace("X", "") {
        return false;
    }
    let s = start.bytes();
    let e = end.bytes();
    let mut ls = 0;
    let mut le = 0;
    let mut rs = 0;
    let mut re = 0;
    for i in 0..s.len() {
        if s[i] == b'L' {
            ls += 1;
        } else if s[i] == b'R' {
            rs += 1;
        }
        if e[i] == b'L' {
            le += 1;
        } else if e[i] == b'R' {
            re += 1;
        }
        if le < ls or re > rs {
            return false;
        }
    }
    true
}

// ---- balance arm ----------------------------------------------------

fn can_transform_balance(start: String, end: String) -> bool {
    let s = start.bytes();
    let e = end.bytes();
    if s.len() != e.len() {
        return false;
    }
    let mut owed_r = 0;
    let mut owed_l = 0;
    for i in 0..s.len() {
        if s[i] == b'R' {
            if owed_l > 0 {
                return false;
            }
            owed_r += 1;
        }
        if e[i] == b'L' {
            if owed_r > 0 {
                return false;
            }
            owed_l += 1;
        }
        if e[i] == b'R' {
            if owed_r == 0 {
                return false;
            }
            owed_r -= 1;
        }
        if s[i] == b'L' {
            if owed_l == 0 {
                return false;
            }
            owed_l -= 1;
        }
    }
    owed_r == 0 and owed_l == 0
}

// ---- positions arm --------------------------------------------------

#[derive(Clone, Copy)]
struct Letter_positions {
    kind: u8,
    at: i64,
}

fn letters_positions(text: String) -> Vec[Letter_positions] {
    let mut out: Vec[Letter_positions] = Vec.new();
    let b = text.bytes();
    for i in 0..b.len() {
        if b[i] != b'X' {
            out.push(Letter_positions { kind: b[i], at: i });
        }
    }
    out
}

fn can_transform_positions(start: String, end: String) -> bool {
    if start.len() != end.len() {
        return false;
    }
    let from = letters_positions(start);
    let to = letters_positions(end);
    if from.len() != to.len() {
        return false;
    }
    for k in 0..from.len() {
        let a = from[k];
        let b = to[k];
        if a.kind != b.kind {
            return false;
        }
        if a.kind == b'L' and b.at > a.at {
            return false;
        }
        if a.kind == b'R' and b.at < a.at {
            return false;
        }
    }
    true
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, start: String, end: String) -> bool {
    if which == 0 {
        can_transform_star(start, end)
    } else if which == 1 {
        can_transform_prefix(start, end)
    } else if which == 2 {
        can_transform_balance(start, end)
    } else {
        can_transform_positions(start, end)
    }
}

// The definition: every string reachable from start, found breadth first
// by applying "XL" -> "LX" and "RX" -> "XR" wherever they fit.
fn definition(start: String, end: String) -> bool {
    let mut seen: Set[String] = Set.new();
    let mut queue: VecDeque[String] = VecDeque.new();
    seen.insert(start.clone());
    queue.push_back(start.clone());
    while let Some(text) = queue.pop_front() {
        if text == end {
            return true;
        }
        let b = text.bytes();
        for i in 1..b.len() {
            let fits = (b[i - 1] == b'X' and b[i] == b'L') or (b[i - 1] == b'R' and b[i] == b'X');
            if fits {
                let mut next = b.to_vec();
                next.swap(i - 1, i);
                let made = String.from_utf8(next).unwrap();
                if not seen.contains(made) {
                    seen.insert(made.clone());
                    queue.push_back(made);
                }
            }
        }
    }
    false
}

fn random_text(seed: mut ref i64, n: i64, x_in_4: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        let r = next_random(mut seed) % 8;
        if r < 2 * x_in_4 {
            out.push('X');
        } else if r % 2 == 0 {
            out.push('L');
        } else {
            out.push('R');
        }
    }
    out
}

// The text after up to `moves` random legal moves.
fn moved(seed: mut ref i64, text: String, moves: i64) -> String {
    let mut b = text.bytes().to_vec();
    let n = b.len();
    for _ in 0..moves {
        if n < 2 {
            break;
        }
        let i = next_random(mut seed) % (n - 1);
        if b[i] == b'X' and b[i + 1] == b'L' {
            b[i] = b'L';
            b[i + 1] = b'X';
        } else if b[i] == b'R' and b[i + 1] == b'X' {
            b[i] = b'X';
            b[i + 1] = b'R';
        }
    }
    String.from_utf8(b).unwrap()
}

// Reversed, with every L made an R and every R an L.
fn turned(text: String) -> String {
    let mut out = String.new();
    for c in text.chars().rev() {
        out.push(if c == 'L' { 'R' } else if c == 'R' { 'L' } else { c });
    }
    out
}

// Every L made an R and every R an L.
fn swapped(text: String) -> String {
    let mut out = String.new();
    for c in text.chars() {
        out.push(if c == 'L' { 'R' } else if c == 'R' { 'L' } else { c });
    }
    out
}

fn main() {
    let arms = 4;
    let mut seed = 7770;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1500;
    let mut yes = 0;
    for case in 0..cases {
        // 1,300 pairs of 1 to 8 letters, where the definition is cheap,
        // then 200 of up to 200 letters. A quarter of the ends are reached
        // by legal moves, a quarter are such an end with one more swap of
        // two neighbours whatever they are, a quarter are start's letters
        // shuffled, and a quarter are random.
        let small = case < 1300;
        let n = if small { 1 + next_random(mut seed) % 8 } else { 9 + next_random(mut seed) % 192 };
        let start = random_text(mut seed, n, 1 + next_random(mut seed) % 3);
        let kind = case % 4;
        let end = if kind == 3 {
            random_text(mut seed, n, 1 + next_random(mut seed) % 3)
        } else if kind == 2 {
            let mut b = start.bytes().to_vec();
            let mut i = n - 1;
            while i > 0 {
                b.swap(i, next_random(mut seed) % (i + 1));
                i -= 1;
            }
            String.from_utf8(b).unwrap()
        } else {
            let reached = moved(mut seed, start, next_random(mut seed) % (4 * n));
            if kind == 1 and n > 1 {
                let mut b = reached.bytes().to_vec();
                let i = next_random(mut seed) % (n - 1);
                b.swap(i, i + 1);
                String.from_utf8(b).unwrap()
            } else {
                reached
            }
        };
        let start_on = moved(mut seed, start, next_random(mut seed) % (2 * n));
        let end_on = moved(mut seed, end, next_random(mut seed) % (2 * n));
        let want = if small { definition(start, end) } else { answer_with(0, start, end) };
        if want {
            yes += 1;
        }
        for which in 0..arms {
            let got = answer_with(which, start, end);
            // P1: the definition's answer, on the small pairs.
            if small {
                checks += 1;
                if got != want {
                    fails[0] += 1;
                }
            }
            // P2: both strings reversed, L and R swapped, give the same
            // answer.
            checks += 1;
            if answer_with(which, turned(start), turned(end)) != got {
                fails[1] += 1;
            }
            // P3: end to start, L and R swapped, gives the same answer: a
            // move undone is the other letter's move.
            checks += 1;
            if answer_with(which, swapped(end), swapped(start)) != got {
                fails[2] += 1;
            }
            // P4: moves compose: start moved on can reach end only if start
            // can, and if start can reach end it can reach end moved on.
            checks += 1;
            if (answer_with(which, start_on, end) and not got) or (got and not answer_with(which, start, end_on)) {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} pairs ({yes} reachable), {arms} arms, {checks} checks, {failures} failures");
}
