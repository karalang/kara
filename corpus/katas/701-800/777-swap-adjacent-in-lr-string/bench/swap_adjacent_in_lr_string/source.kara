// Benchmark for #777: Swap Adjacent in LR String -- the ★ arm (two
// pointers).
//
// "XL" -> "LX" moves an L one place left through an X, and "RX" -> "XR"
// moves an R one place right; no letter ever passes another. So the
// letters must come in the same order in both strings, each L no further
// right in end than in start, and each R no further left. Walk both
// strings skipping X's and compare the letters pairwise. O(n).

fn can_transform(start: String, end: String) -> bool {
    let s = start.bytes();
    let e = end.bytes();
    let n = s.len();
    if e.len() != n {
        return false;
    }
    let mut i = 0;
    let mut j = 0;
    loop {
        while i < n and s[i] == b'X' {
            i += 1;
        }
        while j < n and e[j] == b'X' {
            j += 1;
        }
        if i == n or j == n {
            return i == n and j == n;
        }
        if s[i] != e[j] {
            return false;
        }
        if s[i] == b'L' and i < j {
            return false;
        }
        if s[i] == b'R' and i > j {
            return false;
        }
        i += 1;
        j += 1;
    }
}

// ---- benchmark --------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 pairs of 10,000 letters (LeetCode's most), built once. A start is
    // random, half X's. Half the ends are the start after 100,000 random
    // legal moves; a quarter are the start with its last "XR" turned into
    // "RX", an R moved left, and a quarter the same at a random "XR". Then
    // 20,000 rounds each answer the next pair.
    let count = 64;
    let n = 10000;
    let mut seed: i64 = 777;
    let mut starts: Vec[String] = Vec.new();
    let mut ends: Vec[String] = Vec.new();
    for g in 0..count {
        let mut s: Vec[u8] = Vec.new();
        for _ in 0..n {
            let r = next_random(mut seed) % 4;
            s.push(if r < 2 { b'X' } else if r == 2 { b'L' } else { b'R' });
        }
        let mut e = s.clone();
        if g % 4 < 2 {
            for _ in 0..100000 {
                let i = next_random(mut seed) % (n - 1);
                if e[i] == b'X' and e[i + 1] == b'L' {
                    e.swap(i, i + 1);
                } else if e[i] == b'R' and e[i + 1] == b'X' {
                    e.swap(i, i + 1);
                }
            }
        } else {
            let mut k = if g % 4 == 2 { n - 2 } else { next_random(mut seed) % (n - 1) };
            while not (e[k] == b'X' and e[k + 1] == b'R') {
                k = if k == 0 { n - 2 } else { k - 1 };
            }
            e.swap(k, k + 1);
        }
        starts.push(String.from_utf8(s).unwrap());
        ends.push(String.from_utf8(e).unwrap());
    }
    let mut yes = 0;
    let mut checksum: i64 = 0;
    for round in 0..20000 {
        let g = (round * 7) % count;
        if can_transform(starts[g], ends[g]) {
            yes += 1;
            checksum = (checksum * 31 + g + 1) % 1000000007;
        } else {
            checksum = (checksum * 31 + 7) % 1000000007;
        }
    }
    println(f"20000 rounds of {n} letters: {yes} reachable, checksum {checksum}");
}
