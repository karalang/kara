// LeetCode #730: Count Different Palindromic Subsequences -- by outer
// letter, bottom up by length.
//
// The outer-letter count of the top-down arm, filled for every interval
// in order of length, so each inside count is ready when it is needed:
// for each letter c, its first copy in the interval from a table of
// next copies and its last from a table of previous ones; add c, and
// when there are two copies, cc and c ... c around the inside. All
// modulo 10^9 + 7. O(4 n^2) time, O(n^2) space.

fn count_palindromic_subsequences(s: String) -> i64 {
    let m = 1000000007;
    let b = s.bytes();
    let n = b.len();
    // next_at[c][i]: the first c at or after i, n if none;
    // prev_at[c][j]: the last c at or before j, -1 if none.
    let mut next_at: Vec[Vec[i64]] = Vec.new();
    let mut prev_at: Vec[Vec[i64]] = Vec.new();
    for c in 0..4 {
        let letter = b'a' + c as u8;
        let mut nx: Vec[i64] = vec![n; n + 1];
        let mut i = n;
        while i > 0 {
            i -= 1;
            nx[i] = if b[i] == letter { i } else { nx[i + 1] };
        }
        let mut pv: Vec[i64] = vec![-1; n];
        for j in 0..n {
            pv[j] = if b[j] == letter { j } else if j > 0 { pv[j - 1] } else { -1 };
        }
        next_at.push(nx);
        prev_at.push(pv);
    }
    let mut count: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        count.push(vec![0; n]);
    }
    for len in 1..n + 1 {
        for i in 0..n - len + 1 {
            let j = i + len - 1;
            let mut total = 0;
            for c in 0..4 {
                let a = next_at[c][i];
                if a <= j {
                    let z = prev_at[c][j];
                    total += 1;
                    if z > a {
                        total += 1;
                        if a + 1 <= z - 1 {
                            total += count[a + 1][z - 1];
                        }
                    }
                }
            }
            count[i][j] = total % m;
        }
    }
    count[0][n - 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, kinds: i64, seed: mut ref i64) -> String {
    let mut s = "".to_string();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % kinds) as u8) as char);
    }
    s
}

fn show(s: String) {
    println(f"\"{s}\" -> {count_palindromic_subsequences(s)}");
}

fn main() {
    show("bccb".to_string());
    show("abcdabcdabcdabcdabcdabcdabcdabcddcbadcbadcbadcbadcbadcbadcbadcba".to_string());
    show("a".to_string());
    show("aaaa".to_string());
    show("abcd".to_string());
    show("aba".to_string());
    show("abba".to_string());
    show("aabbaa".to_string());
    show("dcbabcd".to_string());
    let mut seed: i64 = 730;
    let big = random_word(1000, 4, mut seed);
    println(f"1000 random letters -> {count_palindromic_subsequences(big)}");
    let two = random_word(1000, 2, mut seed);
    println(f"1000 random a's and b's -> {count_palindromic_subsequences(two)}");
    let mut same = "".to_string();
    for _ in 0..1000 {
        same.push('a');
    }
    println(f"1000 a's -> {count_palindromic_subsequences(same)}");
    let mut cycle = "".to_string();
    for _ in 0..250 {
        cycle.push_str("abcd");
    }
    println(f"abcd 250 times -> {count_palindromic_subsequences(cycle)}");
    let mut sum = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let kinds = 1 + next_random(mut seed) % 4;
        let v = count_palindromic_subsequences(random_word(n, kinds, mut seed));
        sum = (sum * 131 + v) % 1000000007;
    }
    println(f"300 random strings: checksum {sum}");
}
