// LeetCode 766 — Toeplitz Matrix, walking each diagonal.
//
// Every diagonal starts in the top row or the left column. Walk each one
// from its start and compare each cell with the first. Every cell is on
// exactly one diagonal, so this too is O(m * n).

fn same_down(matrix: Vec[Vec[i64]], row: i64, col: i64) -> bool {
    let first = matrix[row][col];
    let mut i = row + 1;
    let mut j = col + 1;
    while i < matrix.len() and j < matrix[0].len() {
        if matrix[i][j] != first {
            return false;
        }
        i += 1;
        j += 1;
    }
    true
}

fn is_toeplitz_matrix(matrix: Vec[Vec[i64]]) -> bool {
    for col in 0..matrix[0].len() {
        if not same_down(matrix, 0, col) {
            return false;
        }
    }
    for row in 1..matrix.len() {
        if not same_down(matrix, row, 0) {
            return false;
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(matrix: Vec[Vec[i64]]) {
    let answer = is_toeplitz_matrix(matrix);
    println(f"{matrix} -> {answer}");
}

fn main() {
    show([[1, 2, 3, 4], [5, 1, 2, 3], [9, 5, 1, 2]]);
    show([[1, 2], [2, 2]]);
    show([[7]]);
    show([[1, 2, 3]]);
    show([[1], [2], [3]]);
    show([[3, 8], [4, 3], [6, 4]]);
    show([[3, 8], [4, 3], [6, 5]]);
    show([[1, 2, 3], [4, 1, 2], [5, 4, 9]]);
    let mut seed = 766;
    let mut yes = 0;
    let mut check = 0;
    for round in 0..300 {
        let m = 1 + next_random(mut seed) % 20;
        let n = 1 + next_random(mut seed) % 20;
        let mut diag: Vec[i64] = Vec.new();
        for _ in 0..m + n - 1 {
            diag.push(next_random(mut seed) % 4);
        }
        let mut matrix: Vec[Vec[i64]] = Vec.new();
        for i in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for j in 0..n {
                row.push(diag[i - j + n - 1]);
            }
            matrix.push(row);
        }
        if round % 2 == 1 {
            let i = next_random(mut seed) % m;
            let j = next_random(mut seed) % n;
            matrix[i][j] = next_random(mut seed) % 4;
        }
        let answer = is_toeplitz_matrix(matrix);
        if answer {
            yes += 1;
        }
        check = (check * 31 + if answer { 1 } else { 0 } + round) % 1000000007;
    }
    println(f"300 random matrices: {yes} Toeplitz, checksum {check}");
}
