// LeetCode #703: Kth Largest Element in a Stream -- a sorted list of k.
//
// Keep the k largest values in a `Vec` in descending order, so the
// answer is the last one and dropping the smallest is a `pop`. A new
// value goes in after every value larger than it, found by a binary
// search, and the list is cut back to k. O(k) per value for the shift,
// O(k) space.

struct KthLargest {
    k: i64,
    mut desc: Vec[i64],
}

impl KthLargest {
    fn new(k: i64, nums: Vec[i64]) -> KthLargest {
        let mut s = KthLargest { k: k, desc: Vec.new() };
        for x in nums.iter() {
            s.add(*x);
        }
        s
    }

    fn add(mut ref self, val: i64) -> i64 {
        let mut lo = 0;
        let mut hi = self.desc.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.desc[mid] > val {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        self.desc.insert(lo, val);
        if self.desc.len() > self.k {
            self.desc.pop();
        }
        self.desc[self.desc.len() - 1]
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answers(k: i64, nums: Vec[i64], adds: Vec[i64]) -> Vec[i64] {
    let mut s = KthLargest.new(k, nums);
    let mut out: Vec[i64] = Vec.new();
    for v in adds.iter() {
        out.push(s.add(*v));
    }
    out
}

fn show(k: i64, nums: Vec[i64], adds: Vec[i64]) {
    println(f"k {k}, nums {nums}, adds {adds}: {answers(k, nums, adds)}");
}

fn checksum(values: Vec[i64]) -> i64 {
    let mut sum = 0;
    for v in values.iter() {
        sum = (sum * 31 + *v + 20000) % 1000000007;
    }
    sum
}

// `n` values from -10,000 to 10,000.
fn random_values(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for _ in 0..n {
        out.push(next_random(mut seed) % 20001 - 10000);
    }
    out
}

fn main() {
    // The two LeetCode examples.
    show(3, vec![4, 5, 8, 2], vec![3, 5, 10, 9, 4]);
    show(4, vec![7, 7, 7, 7, 8, 3], vec![2, 10, 9, 9]);
    // k = 1 from nothing: the running largest; k = 2 from one value; k
    // reached exactly by the first add; every value the same; values
    // only falling, and only rising.
    show(1, Vec.new(), vec![-3, -2, -4, 0, 4]);
    show(2, vec![0], vec![-1, 1, -2, -4, 3]);
    show(5, vec![1, 2, 3, 4], vec![5, 0, 6, 6, 1]);
    show(3, vec![9, 9, 9], vec![9, 9, 1, 10]);
    show(3, vec![100], vec![90, 80, 70, 60, 50]);
    show(3, vec![-100], vec![-90, -80, -70, -60, -50]);
    // The problem's largest: 10,000 values and 10,000 adds, for k of
    // 1, 5,000 and 10,000 (where the 9,999 values given leave the first
    // add to make k).
    let mut seed: i64 = 703;
    for k in [1, 5000, 10000] {
        let n = if k == 10000 { 9999 } else { 10000 };
        let nums = random_values(n, mut seed);
        let adds = random_values(10000, mut seed);
        let got = answers(k, nums, adds);
        println(f"k {k}, {n} values, 10000 adds: last {got[got.len() - 1]}, checksum {checksum(got)}");
    }
    // 300 random streams: k from 1 to 20, k - 1 to k + 29 values from a
    // range of a random 1 to 41 numbers, so some repeat a lot, and 50
    // adds from the same range.
    let mut sum = 0;
    for _ in 0..300 {
        let k = 1 + next_random(mut seed) % 20;
        let n = k - 1 + next_random(mut seed) % 31;
        let width = 1 + next_random(mut seed) % 41;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % width - width / 2);
        }
        let mut adds: Vec[i64] = Vec.new();
        for _ in 0..50 {
            adds.push(next_random(mut seed) % width - width / 2);
        }
        sum = (sum * 31 + checksum(answers(k, nums, adds))) % 1000000007;
    }
    println(f"300 random streams: checksum {sum}");
}
