// LeetCode 752 — Open the Lock, two-way breadth-first search.
//
// Search from 0000 and from the target at once, a level at a time,
// always growing the smaller frontier; the frontiers are `Set[i64]`s of
// settings. When a setting grown from one side is in the other's
// frontier, the two searches have met and the turns are the levels
// grown from both sides. Dead ends are never entered.

fn neighbours(x: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut place = 1;
    for _ in 0..4 {
        let digit = x / place % 10;
        out.push(x + ((digit + 1) % 10 - digit) * place);
        out.push(x + ((digit + 9) % 10 - digit) * place);
        place *= 10;
    }
    out
}

fn open_lock(deadends: Vec[String], target: String) -> i64 {
    let mut dead: Set[i64] = Set.new();
    for d in deadends.iter() {
        dead.insert(i64.parse(d).unwrap());
    }
    let goal = i64.parse(target).unwrap();
    if dead.contains(0) or dead.contains(goal) {
        return -1;
    }
    if goal == 0 {
        return 0;
    }
    let mut seen: Set[i64] = Set.new();
    let mut front: Set[i64] = Set.new();
    let mut back: Set[i64] = Set.new();
    front.insert(0);
    back.insert(goal);
    seen.insert(0);
    seen.insert(goal);
    let mut turns = 0;
    while front.len() > 0 and back.len() > 0 {
        if front.len() > back.len() {
            let held = front;
            front = back;
            back = held;
        }
        turns += 1;
        let mut grown: Set[i64] = Set.new();
        for x in front.iter() {
            for y in neighbours(*x).iter() {
                if back.contains(*y) {
                    return turns;
                }
                if not dead.contains(*y) and not seen.contains(*y) {
                    seen.insert(*y);
                    grown.insert(*y);
                }
            }
        }
        front = grown;
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(dead: String, target: String) {
    let mut deadends: Vec[String] = Vec.new();
    if dead.len() > 0 {
        for d in dead.split(" ") {
            deadends.push(String.from(d));
        }
    }
    println(f"[{dead}], {target} -> {open_lock(deadends, target.clone())}");
}

fn four(x: i64) -> String {
    f"{x / 1000}{x / 100 % 10}{x / 10 % 10}{x % 10}"
}

fn main() {
    show(String.from("0201 0101 0102 1212 2002"), String.from("0202"));
    show(String.from("8888"), String.from("0009"));
    show(String.from("8887 8889 8878 8898 8788 8988 7888 9888"), String.from("8888"));
    show(String.from("0000"), String.from("8888"));
    show(String.from(""), String.from("0000"));
    show(String.from(""), String.from("5555"));
    show(String.from("1000 9000 0100 0900 0010 0090 0001"), String.from("1234"));
    show(String.from("1000 9000 0100 0900 0010 0090 0001 0009"), String.from("1234"));

    let mut seed = 752;
    let mut total = 0;
    let mut stuck = 0;
    let mut check = 0;
    for round in 0..40 {
        // up to 500 random dead ends, more in later rounds
        let count = 1 + next_random(mut seed) % (12 * round + 10);
        let mut deadends: Vec[String] = Vec.new();
        for _ in 0..count {
            deadends.push(four(next_random(mut seed) % 10000));
        }
        let target = four(next_random(mut seed) % 10000);
        let turns = open_lock(deadends, target);
        if turns == -1 {
            stuck += 1;
        } else {
            total += turns;
        }
        check = (check * 31 + turns + 1) % 1000000007;
    }
    println(f"40 random locks: {stuck} cannot open, the rest take {total} turns in all, checksum {check}");
}
