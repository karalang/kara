// LeetCode #718: Maximum Length of Repeated Subarray -- one rolling row.
//
// run[j] is the length of the common run ending at nums1[i - 1] and
// nums2[j - 1]: one more than the run ending one place back on both
// when the two numbers match, else 0. Only the previous row is needed,
// and walking j downwards reads it before overwriting it. The answer is
// the longest run. O(m * n) time, O(n) space.

fn find_length(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    let m = nums1.len();
    let n = nums2.len();
    let mut run: Vec[i64] = Vec.new();
    for _ in 0..n + 1 {
        run.push(0);
    }
    let mut best = 0;
    for i in 1..m + 1 {
        let mut j = n;
        while j >= 1 {
            if nums1[i - 1] == nums2[j - 1] {
                run[j] = run[j - 1] + 1;
                if run[j] > best {
                    best = run[j];
                }
            } else {
                run[j] = 0;
            }
            j -= 1;
        }
    }
    best
}

// ---- benchmark ------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 60 random arrays of 1,000 numbers from 0 to 9, made once.
    let mut seed: i64 = 718;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..60 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            nums.push(next_random(mut seed) % 10);
        }
        arrays.push(nums);
    }
    // 40 rounds of 20 pairs, a different partner for each array every
    // round, every length summed.
    let mut sum = 0;
    for round in 0..40 {
        for k in 0..20 {
            sum += find_length(arrays[k], arrays[(k + round + 1) % 60]);
        }
    }
    println(f"40 rounds of 20 pairs of 1000 numbers: sum {sum}");
}
