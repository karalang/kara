// LeetCode 768 — Max Chunks To Make Sorted II, against a sorted copy.
//
// A chunk can end after place i exactly when the array up to i holds the
// same values, counted with repeats, as the sorted array up to i. Keep in
// a map how many more of each value the array has had than the sorted
// copy, and how many values have a count other than zero; each place
// where that number is zero ends a chunk. O(n log n) for the sort.

fn max_chunks_to_sorted(arr: Vec[i64]) -> i64 {
    let mut sorted = arr.clone();
    sorted.sort();
    let mut excess: Map[i64, i64] = Map.new();
    let mut uneven = 0;
    let mut chunks = 0;
    for i in 0..arr.len() {
        for (value, change) in [(arr[i], 1), (sorted[i], -1)] {
            let before = excess.get(value) ?? 0;
            let after = before + change;
            excess.insert(value, after);
            if before == 0 {
                uneven += 1;
            } else if after == 0 {
                uneven -= 1;
            }
        }
        if uneven == 0 {
            chunks += 1;
        }
    }
    chunks
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(arr: Vec[i64]) {
    let chunks = max_chunks_to_sorted(arr);
    println(f"{arr} -> {chunks}");
}

fn main() {
    show([5, 4, 3, 2, 1]);
    show([2, 1, 3, 4, 4]);
    show([7]);
    show([1, 2, 3, 4]);
    show([3, 3, 3]);
    show([1, 1, 0, 0, 1]);
    show([4, 2, 2, 1, 1, 5, 6, 6]);
    show([0, 100000000, 5, 100000000, 7]);
    let mut seed = 768;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let spread = 1 + next_random(mut seed) % 20;
        let mut arr: Vec[i64] = Vec.new();
        for i in 0..n {
            // values that mostly rise, so that there are chunks to find
            arr.push(i / 3 + next_random(mut seed) % spread);
        }
        let chunks = max_chunks_to_sorted(arr);
        total += chunks;
        check = (check * 31 + chunks) % 1000000007;
    }
    println(f"300 random arrays: {total} chunks in all, checksum {check}");
}
