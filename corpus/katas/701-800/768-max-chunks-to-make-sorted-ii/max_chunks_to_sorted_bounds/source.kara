// LeetCode 768 — Max Chunks To Make Sorted II, prefix maxima against
// suffix minima.
//
// A chunk can end after place i exactly when nothing up to i is greater
// than anything after it. With the smallest value of every suffix worked
// out first, one pass keeping the largest value so far counts those
// places. O(n) time and space.

fn max_chunks_to_sorted(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut suffix_min: Vec[i64] = Vec.new();
    for _ in 0..n {
        suffix_min.push(0);
    }
    suffix_min[n - 1] = arr[n - 1];
    let mut i = n - 1;
    while i > 0 {
        i -= 1;
        suffix_min[i] = arr[i].min(suffix_min[i + 1]);
    }
    let mut chunks = 1;
    let mut largest = arr[0];
    for i in 0..n - 1 {
        largest = largest.max(arr[i]);
        if largest <= suffix_min[i + 1] {
            chunks += 1;
        }
    }
    chunks
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(arr: Vec[i64]) {
    let chunks = max_chunks_to_sorted(arr);
    println(f"{arr} -> {chunks}");
}

fn main() {
    show([5, 4, 3, 2, 1]);
    show([2, 1, 3, 4, 4]);
    show([7]);
    show([1, 2, 3, 4]);
    show([3, 3, 3]);
    show([1, 1, 0, 0, 1]);
    show([4, 2, 2, 1, 1, 5, 6, 6]);
    show([0, 100000000, 5, 100000000, 7]);
    let mut seed = 768;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let spread = 1 + next_random(mut seed) % 20;
        let mut arr: Vec[i64] = Vec.new();
        for i in 0..n {
            // values that mostly rise, so that there are chunks to find
            arr.push(i / 3 + next_random(mut seed) % spread);
        }
        let chunks = max_chunks_to_sorted(arr);
        total += chunks;
        check = (check * 31 + chunks) % 1000000007;
    }
    println(f"300 random arrays: {total} chunks in all, checksum {check}");
}
