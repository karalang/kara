// LeetCode #768: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random arrays.

// ---- ★ arm ----------------------------------------------------------

fn max_chunks_to_sorted_star(arr: Vec[i64]) -> i64 {
    let mut maxima: Vec[i64] = Vec.new();
    for x in arr {
        match maxima.last() {
            Some(top) if x < top => {
                let largest = *top;
                while maxima.len() > 0 and maxima[maxima.len() - 1] > x {
                    maxima.pop();
                }
                maxima.push(largest);
            }
            _ => {
                maxima.push(x);
            }
        }
    }
    maxima.len()
}

// ---- bounds arm -----------------------------------------------------

fn max_chunks_to_sorted_bounds(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut suffix_min: Vec[i64] = Vec.new();
    for _ in 0..n {
        suffix_min.push(0);
    }
    suffix_min[n - 1] = arr[n - 1];
    let mut i = n - 1;
    while i > 0 {
        i -= 1;
        suffix_min[i] = arr[i].min(suffix_min[i + 1]);
    }
    let mut chunks = 1;
    let mut largest = arr[0];
    for i in 0..n - 1 {
        largest = largest.max(arr[i]);
        if largest <= suffix_min[i + 1] {
            chunks += 1;
        }
    }
    chunks
}

// ---- counted arm ----------------------------------------------------

fn max_chunks_to_sorted_counted(arr: Vec[i64]) -> i64 {
    let mut sorted = arr.clone();
    sorted.sort();
    let mut excess: Map[i64, i64] = Map.new();
    let mut uneven = 0;
    let mut chunks = 0;
    for i in 0..arr.len() {
        for (value, change) in [(arr[i], 1), (sorted[i], -1)] {
            let before = excess.get(value) ?? 0;
            let after = before + change;
            excess.insert(value, after);
            if before == 0 {
                uneven += 1;
            } else if after == 0 {
                uneven -= 1;
            }
        }
        if uneven == 0 {
            chunks += 1;
        }
    }
    chunks
}

// ---- ranked arm -----------------------------------------------------

fn max_chunks_to_sorted_ranked(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut order: Vec[(i64, i64)] = Vec.new();
    for i in 0..n {
        order.push((arr[i], i));
    }
    order.sort();
    let mut rank: Vec[i64] = Vec.new();
    for _ in 0..n {
        rank.push(0);
    }
    for r in 0..n {
        rank[order[r].1] = r;
    }
    let mut chunks = 0;
    let mut reach = 0;
    for i in 0..n {
        reach = reach.max(rank[i]);
        if reach == i {
            chunks += 1;
        }
    }
    chunks
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, arr: Vec[i64]) -> i64 {
    if which == 0 {
        max_chunks_to_sorted_star(arr)
    } else if which == 1 {
        max_chunks_to_sorted_bounds(arr)
    } else if which == 2 {
        max_chunks_to_sorted_counted(arr)
    } else {
        max_chunks_to_sorted_ranked(arr)
    }
}

// The definition: the most pieces, over every way of cutting the array,
// whose pieces, each sorted on its own, make the sorted array.
fn definition(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut sorted = arr.clone();
    sorted.sort();
    let mut best = 0;
    for cuts in 0..1 << (n - 1) {
        let mut pieces = 0;
        let mut ok = true;
        let mut start = 0;
        for end in 1..n + 1 {
            if end == n or cuts >> (end - 1) & 1 == 1 {
                let mut piece: Vec[i64] = Vec.new();
                for i in start..end {
                    piece.push(arr[i]);
                }
                piece.sort();
                for i in start..end {
                    if piece[i - start] != sorted[i] {
                        ok = false;
                    }
                }
                pieces += 1;
                start = end;
            }
        }
        if ok and pieces > best {
            best = pieces;
        }
    }
    best
}

fn main() {
    let arms = 4;
    let mut seed = 7680;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let small = 1500;
    let cases = 1800;
    let mut total = 0;
    for case in 0..cases {
        // up to 10 values for the definition, then up to 2000
        let n = if case < small { 1 + next_random(mut seed) % 10 } else { 1 + next_random(mut seed) % 2000 };
        let spread = 1 + next_random(mut seed) % 12;
        let climb = 1 + next_random(mut seed) % 4;
        let mut arr: Vec[i64] = Vec.new();
        let mut top = 0;
        for i in 0..n {
            let x = i / climb + next_random(mut seed) % spread;
            arr.push(x);
            top = top.max(x);
        }
        let mut scaled: Vec[i64] = Vec.new();
        let mut mirrored: Vec[i64] = Vec.new();
        for i in 0..n {
            scaled.push(3 * arr[i] + 7);
            mirrored.push(-arr[n - 1 - i]);
        }
        let mut longer = arr.clone();
        longer.push(top + next_random(mut seed) % 3);
        let want = if case < small { definition(arr) } else { 0 };
        for which in 0..arms {
            let got = answer_with(which, arr);
            if which == 0 {
                total += got;
            }
            // P1: the definition's answer.
            if case < small {
                checks += 1;
                if got != want {
                    fails[0] += 1;
                }
            }
            // P2: a rising change of every value, 3x + 7, changes nothing.
            checks += 1;
            if answer_with(which, scaled) != got {
                fails[1] += 1;
            }
            // P3: one more value, at least every other, is one more chunk.
            checks += 1;
            if answer_with(which, longer) != got + 1 {
                fails[2] += 1;
            }
            // P4: the array reversed and negated has the same answer.
            checks += 1;
            if answer_with(which, mirrored) != got {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} arrays ({total} chunks), {arms} arms, {checks} checks, {failures} failures");
}
