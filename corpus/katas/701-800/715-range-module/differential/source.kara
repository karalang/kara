// LeetCode #715: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random calls.

// ---- ★ arm ----------------------------------------------------------

struct RangeModuleStar {
    starts: Vec[i64],
    ends: Vec[i64],
}

impl RangeModuleStar {
    fn new() -> RangeModuleStar {
        RangeModuleStar { starts: Vec.new(), ends: Vec.new() }
    }

    // The index of the first range that ends after x.
    fn first_ending_after(ref self, x: i64) -> i64 {
        let mut lo = 0;
        let mut hi = self.ends.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.ends[mid] > x {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        lo
    }

    fn add_range(mut ref self, left: i64, right: i64) {
        // Every range that overlaps or touches [left, right) merges.
        let i = self.first_ending_after(left - 1);
        let mut lo = left;
        let mut hi = right;
        let mut j = i;
        while j < self.starts.len() and self.starts[j] <= right {
            if self.starts[j] < lo {
                lo = self.starts[j];
            }
            if self.ends[j] > hi {
                hi = self.ends[j];
            }
            j += 1;
        }
        if j == i {
            self.starts.insert(i, lo);
            self.ends.insert(i, hi);
        } else {
            self.starts[i] = lo;
            self.ends[i] = hi;
            for _ in i + 1..j {
                self.starts.remove(i + 1);
                self.ends.remove(i + 1);
            }
        }
    }

    fn query_range(ref self, left: i64, right: i64) -> bool {
        let i = self.first_ending_after(left);
        i < self.starts.len() and self.starts[i] <= left and self.ends[i] >= right
    }

    fn remove_range(mut ref self, left: i64, right: i64) {
        let mut i = self.first_ending_after(left);
        if i < self.starts.len() and self.starts[i] < left {
            let end = self.ends[i];
            self.ends[i] = left;
            if end > right {
                // [left, right) falls inside one range: split it.
                self.starts.insert(i + 1, right);
                self.ends.insert(i + 1, end);
                return;
            }
            i += 1;
        }
        while i < self.starts.len() and self.starts[i] < right {
            if self.ends[i] > right {
                self.starts[i] = right;
                return;
            }
            self.starts.remove(i);
            self.ends.remove(i);
        }
    }
}

// ---- sorted-map arm -------------------------------------------------

struct RangeModuleSorted {
    spans: SortedMap[i64, i64],
}

impl RangeModuleSorted {
    fn new() -> RangeModuleSorted {
        RangeModuleSorted { spans: SortedMap.new() }
    }

    fn add_range(mut ref self, left: i64, right: i64) {
        let mut lo = left;
        let mut hi = right;
        if let Some((s, e)) = self.spans.floor(left) {
            if *e >= left {
                lo = *s;
                if *e > hi {
                    hi = *e;
                }
            }
        }
        let mut gone: Vec[i64] = Vec.new();
        for (s, e) in self.spans.range_inclusive(lo, hi) {
            gone.push(*s);
            if *e > hi {
                hi = *e;
            }
        }
        for s in gone.iter() {
            self.spans.remove(*s);
        }
        self.spans.insert(lo, hi);
    }

    fn query_range(ref self, left: i64, right: i64) -> bool {
        match self.spans.floor(left) {
            Some((_, e)) => *e >= right,
            None => false,
        }
    }

    fn remove_range(mut ref self, left: i64, right: i64) {
        // A range starting before left keeps its part below left, and
        // its part from right on if it reaches past right.
        let mut before = 0;
        let mut before_end = 0;
        if let Some((s, e)) = self.spans.floor(left - 1) {
            before = *s;
            before_end = *e;
        }
        if before_end > left {
            self.spans.insert(before, left);
            if before_end > right {
                self.spans.insert(right, before_end);
            }
        }
        // Ranges starting inside [left, right) go, all but their part
        // from right on.
        let mut gone: Vec[i64] = Vec.new();
        let mut tail = 0;
        for (s, e) in self.spans.range(left, right) {
            gone.push(*s);
            if *e > right {
                tail = *e;
            }
        }
        for s in gone.iter() {
            self.spans.remove(*s);
        }
        if tail > right {
            self.spans.insert(right, tail);
        }
    }
}

// ---- rebuild arm ----------------------------------------------------

struct RangeModuleRebuild {
    spans: Vec[(i64, i64)],
}

impl RangeModuleRebuild {
    fn new() -> RangeModuleRebuild {
        RangeModuleRebuild { spans: Vec.new() }
    }

    fn add_range(mut ref self, left: i64, right: i64) {
        let mut out: Vec[(i64, i64)] = Vec.new();
        let mut lo = left;
        let mut hi = right;
        let mut placed = false;
        for span in self.spans.iter() {
            let (s, e) = *span;
            if e < lo {
                out.push((s, e));
            } else if s > hi {
                if not placed {
                    out.push((lo, hi));
                    placed = true;
                }
                out.push((s, e));
            } else {
                if s < lo {
                    lo = s;
                }
                if e > hi {
                    hi = e;
                }
            }
        }
        if not placed {
            out.push((lo, hi));
        }
        self.spans = out;
    }

    fn query_range(ref self, left: i64, right: i64) -> bool {
        for span in self.spans.iter() {
            let (s, e) = *span;
            if s <= left and e >= right {
                return true;
            }
        }
        false
    }

    fn remove_range(mut ref self, left: i64, right: i64) {
        let mut out: Vec[(i64, i64)] = Vec.new();
        for span in self.spans.iter() {
            let (s, e) = *span;
            if e <= left or s >= right {
                out.push((s, e));
            } else {
                if s < left {
                    out.push((s, left));
                }
                if e > right {
                    out.push((right, e));
                }
            }
        }
        self.spans = out;
    }
}

// ---- tree arm -------------------------------------------------------

struct RangeModuleTree {
    low: Vec[i64],
    high: Vec[i64],
    state: Vec[i64],
}

let EMPTY: i64 = 0;
let FULL: i64 = 1;
let MIXED: i64 = 2;
let TOP: i64 = 1073741824;

impl RangeModuleTree {
    fn new() -> RangeModuleTree {
        RangeModuleTree { low: [-1], high: [-1], state: [EMPTY] }
    }

    fn node(mut ref self, state: i64) -> i64 {
        self.low.push(-1);
        self.high.push(-1);
        self.state.push(state);
        self.state.len() - 1
    }

    // Set [left, right) to `to` within `at`, which spans [from, until).
    fn set(mut ref self, at: i64, from: i64, until: i64, left: i64, right: i64, to: i64) {
        if right <= from or until <= left {
            return;
        }
        if left <= from and until <= right {
            self.state[at] = to;
            return;
        }
        // Cut: a whole node hands its state down to its halves first.
        let whole = self.state[at];
        if self.low[at] == -1 {
            let a = self.node(whole);
            let b = self.node(whole);
            self.low[at] = a;
            self.high[at] = b;
        } else if whole != MIXED {
            let a = self.low[at];
            let b = self.high[at];
            self.state[a] = whole;
            self.state[b] = whole;
        }
        let mid = (from + until) / 2;
        let a = self.low[at];
        let b = self.high[at];
        self.set(a, from, mid, left, right, to);
        self.set(b, mid, until, left, right, to);
        if self.state[a] == self.state[b] and self.state[a] != MIXED {
            self.state[at] = self.state[a];
        } else {
            self.state[at] = MIXED;
        }
    }

    fn full(ref self, at: i64, from: i64, until: i64, left: i64, right: i64) -> bool {
        if right <= from or until <= left {
            return true;
        }
        if self.state[at] != MIXED {
            return self.state[at] == FULL;
        }
        let mid = (from + until) / 2;
        self.full(self.low[at], from, mid, left, right)
            and self.full(self.high[at], mid, until, left, right)
    }

    fn add_range(mut ref self, left: i64, right: i64) {
        self.set(0, 0, TOP, left, right, FULL);
    }

    fn query_range(ref self, left: i64, right: i64) -> bool {
        self.full(0, 0, TOP, left, right)
    }

    fn remove_range(mut ref self, left: i64, right: i64) {
        self.set(0, 0, TOP, left, right, EMPTY);
    }
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Each call is (kind, left, right): 0 adds, 1 removes, 2 queries. The
// answers are the queries'.
fn run(which: i64, calls: Vec[(i64, i64, i64)]) -> Vec[bool] {
    let mut answers: Vec[bool] = Vec.new();
    if which == 0 {
        let mut m = RangeModuleStar.new();
        for call in calls.iter() {
            let (kind, left, right) = *call;
            if kind == 0 {
                m.add_range(left, right);
            } else if kind == 1 {
                m.remove_range(left, right);
            } else {
                answers.push(m.query_range(left, right));
            }
        }
    } else if which == 1 {
        let mut m = RangeModuleSorted.new();
        for call in calls.iter() {
            let (kind, left, right) = *call;
            if kind == 0 {
                m.add_range(left, right);
            } else if kind == 1 {
                m.remove_range(left, right);
            } else {
                answers.push(m.query_range(left, right));
            }
        }
    } else if which == 2 {
        let mut m = RangeModuleRebuild.new();
        for call in calls.iter() {
            let (kind, left, right) = *call;
            if kind == 0 {
                m.add_range(left, right);
            } else if kind == 1 {
                m.remove_range(left, right);
            } else {
                answers.push(m.query_range(left, right));
            }
        }
    } else {
        let mut m = RangeModuleTree.new();
        for call in calls.iter() {
            let (kind, left, right) = *call;
            if kind == 0 {
                m.add_range(left, right);
            } else if kind == 1 {
                m.remove_range(left, right);
            } else {
                answers.push(m.query_range(left, right));
            }
        }
    }
    answers
}

// The definition: one flag for each number from 0 to `top`, set by an
// add and cleared by a remove one number at a time; a query asks that
// every number in the span is set.
fn definition(calls: Vec[(i64, i64, i64)], top: i64) -> Vec[bool] {
    let mut held: Vec[bool] = Vec.new();
    for _ in 0..top + 1 {
        held.push(false);
    }
    let mut answers: Vec[bool] = Vec.new();
    for call in calls.iter() {
        let (kind, left, right) = *call;
        if kind == 2 {
            let mut all = true;
            for x in left..right {
                if not held[x] {
                    all = false;
                }
            }
            answers.push(all);
        } else {
            for x in left..right {
                held[x] = kind == 0;
            }
        }
    }
    answers
}

fn main() {
    let mut seed = 7150;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut queries = 0;
    let cases = 3000;
    for _ in 0..cases {
        // Up to 30 calls on numbers from 1 to `top`, so they overlap,
        // touch and nest often.
        let top = 2 + next_random(mut seed) % 23;
        let count = 1 + next_random(mut seed) % 30;
        let mut calls: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..count {
            let kind = next_random(mut seed) % 3;
            let a = 1 + next_random(mut seed) % top;
            let b = 1 + next_random(mut seed) % top;
            if a < b {
                calls.push((kind, a, b));
            } else if b < a {
                calls.push((kind, b, a));
            }
        }
        // The same calls followed by a query of every span.
        let mut probed = calls.clone();
        for left in 1..top {
            for right in left + 1..top + 1 {
                probed.push((2, left, right));
            }
        }
        let lift = 1 + next_random(mut seed) % 900000000;
        let mut lifted: Vec[(i64, i64, i64)] = Vec.new();
        let mut mirrored: Vec[(i64, i64, i64)] = Vec.new();
        for call in calls.iter() {
            let (kind, left, right) = *call;
            lifted.push((kind, left + lift, right + lift));
            mirrored.push((kind, top + 1 - right, top + 1 - left));
        }
        let want = definition(calls.clone(), top);
        let want_probed = definition(probed.clone(), top);
        queries += want.len();
        for which in 0..arms {
            let got = run(which, calls.clone());
            // P1: every query answers as the definition does.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: afterwards, every span answers as the definition does.
            checks += 1;
            if run(which, probed.clone()) != want_probed {
                fails[1] += 1;
            }
            // P3: every number raised by the same amount, the same
            // answers.
            checks += 1;
            if run(which, lifted.clone()) != got {
                fails[2] += 1;
            }
            // P4: every span reflected, x to top + 1 - x, the same
            // answers.
            checks += 1;
            if run(which, mirrored.clone()) != got {
                fails[3] += 1;
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{cases} call sequences ({queries} queries), {arms} arms, {checks} checks, {total} failures");
}
