// LeetCode #715: Range Module -- a segment tree built as it is used.
//
// One node per span of [0, 2^30), which holds every number the problem
// allows, each either empty, full or mixed. Adding or removing sets the
// nodes that the span covers whole and marks the ones it cuts as mixed,
// creating a node's two halves only when it is first cut; a query reads
// down through the mixed nodes only. O(log C) per call, C = 2^30.

struct RangeModule {
    low: Vec[i64],
    high: Vec[i64],
    state: Vec[i64],
}

let EMPTY: i64 = 0;
let FULL: i64 = 1;
let MIXED: i64 = 2;
let TOP: i64 = 1073741824;

impl RangeModule {
    fn new() -> RangeModule {
        RangeModule { low: [-1], high: [-1], state: [EMPTY] }
    }

    fn node(mut ref self, state: i64) -> i64 {
        self.low.push(-1);
        self.high.push(-1);
        self.state.push(state);
        self.state.len() - 1
    }

    // Set [left, right) to `to` within `at`, which spans [from, until).
    fn set(mut ref self, at: i64, from: i64, until: i64, left: i64, right: i64, to: i64) {
        if right <= from or until <= left {
            return;
        }
        if left <= from and until <= right {
            self.state[at] = to;
            return;
        }
        // Cut: a whole node hands its state down to its halves first.
        let whole = self.state[at];
        if self.low[at] == -1 {
            let a = self.node(whole);
            let b = self.node(whole);
            self.low[at] = a;
            self.high[at] = b;
        } else if whole != MIXED {
            let a = self.low[at];
            let b = self.high[at];
            self.state[a] = whole;
            self.state[b] = whole;
        }
        let mid = (from + until) / 2;
        let a = self.low[at];
        let b = self.high[at];
        self.set(a, from, mid, left, right, to);
        self.set(b, mid, until, left, right, to);
        if self.state[a] == self.state[b] and self.state[a] != MIXED {
            self.state[at] = self.state[a];
        } else {
            self.state[at] = MIXED;
        }
    }

    fn full(ref self, at: i64, from: i64, until: i64, left: i64, right: i64) -> bool {
        if right <= from or until <= left {
            return true;
        }
        if self.state[at] != MIXED {
            return self.state[at] == FULL;
        }
        let mid = (from + until) / 2;
        self.full(self.low[at], from, mid, left, right)
            and self.full(self.high[at], mid, until, left, right)
    }

    fn add_range(mut ref self, left: i64, right: i64) {
        self.set(0, 0, TOP, left, right, FULL);
    }

    fn query_range(ref self, left: i64, right: i64) -> bool {
        self.full(0, 0, TOP, left, right)
    }

    fn remove_range(mut ref self, left: i64, right: i64) {
        self.set(0, 0, TOP, left, right, EMPTY);
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_below(seed: mut ref i64, bound: i64) -> i64 {
    let hi = next_random(mut seed);
    let lo = next_random(mut seed);
    (hi * 32768 + lo) % bound
}

// Each call is (kind, left, right): 0 adds, 1 removes, 2 queries. The
// answers are the queries'.
fn run(calls: Vec[(i64, i64, i64)]) -> Vec[bool] {
    let mut m = RangeModule.new();
    let mut answers: Vec[bool] = Vec.new();
    for call in calls.iter() {
        let (kind, left, right) = *call;
        if kind == 0 {
            m.add_range(left, right);
        } else if kind == 1 {
            m.remove_range(left, right);
        } else {
            answers.push(m.query_range(left, right));
        }
    }
    answers
}

// `count` random calls with left from 1 to `top` and a length from 1 to
// `longest`, kept within the problem's 10^9.
fn random_calls(seed: mut ref i64, count: i64, top: i64, longest: i64) -> Vec[(i64, i64, i64)] {
    let mut calls: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..count {
        let kind = next_random(mut seed) % 3;
        let left = 1 + random_below(mut seed, top);
        let mut right = left + 1 + random_below(mut seed, longest);
        if right > 1000000000 {
            right = 1000000000;
        }
        if left < right {
            calls.push((kind, left, right));
        }
    }
    calls
}

fn summary(name: String, answers: Vec[bool]) {
    let mut held = 0;
    let mut sum = 0;
    for a in answers.iter() {
        let bit = if *a { 1 } else { 0 };
        held += bit;
        sum = (sum * 131 + bit + 1) % 1000000007;
    }
    println(f"{name}: {answers.len()} queries, {held} held, checksum {sum}");
}

fn main() {
    println(f"{run([(0, 10, 20), (1, 14, 16), (2, 10, 14), (2, 13, 15), (2, 16, 17)])}");
    println(f"{run([(0, 1, 3), (0, 3, 5), (2, 1, 5), (1, 2, 3), (2, 1, 5), (2, 1, 2), (2, 3, 5), (2, 2, 3)])}");
    println(f"{run([(0, 1, 10), (1, 1, 2), (1, 9, 10), (2, 2, 9), (2, 1, 3), (2, 8, 10), (1, 5, 6), (2, 2, 5), (2, 5, 7), (2, 6, 9)])}");
    println(f"{run([(0, 1, 2), (0, 3, 4), (0, 5, 6), (0, 7, 8), (2, 1, 8), (0, 2, 7), (2, 1, 8), (2, 1, 9)])}");
    println(f"{run([(0, 5, 10), (1, 1, 4), (1, 11, 20), (2, 5, 10), (1, 1, 20), (2, 5, 6), (0, 1, 2), (2, 1, 2), (2, 1, 3)])}");
    println(f"{run([(2, 1, 2), (1, 1, 2), (0, 4, 6), (0, 1, 3), (2, 1, 6), (0, 3, 4), (2, 1, 6), (1, 3, 4), (2, 1, 3), (2, 4, 6)])}");
    println(f"{run([(0, 1, 1000000000), (2, 1, 1000000000), (1, 500000000, 500000001), (2, 1, 500000000), (2, 499999999, 500000002), (2, 500000001, 1000000000)])}");
    let mut seed: i64 = 715;
    summary("10000 calls up to 10^9", run(random_calls(mut seed, 10000, 999999999, 1000000000)));
    summary("10000 calls up to 100", run(random_calls(mut seed, 10000, 100, 20)));
    summary("10000 short calls up to 10^6", run(random_calls(mut seed, 10000, 1000000, 1000)));
    summary("10000 calls up to 10^9 of up to 10^6", run(random_calls(mut seed, 10000, 999999999, 1000000)));
}
