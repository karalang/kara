// LeetCode #734: Sentence Similarity -- sorted pairs, binary searched.
//
// Write each pair with its smaller word first and sort the pairs. Two
// different words are similar when, written the same way, they are
// found by binary search among the sorted pairs. O(p log p) to sort,
// O(log p) per word.

fn ordered(a: own String, b: own String) -> (String, String) {
    if a <= b { (a, b) } else { (b, a) }
}

fn are_sentences_similar(sentence1: Vec[String], sentence2: Vec[String], pairs: Vec[(String, String)]) -> bool {
    if sentence1.len() != sentence2.len() {
        return false;
    }
    let mut sorted: Vec[(String, String)] = Vec.new();
    for p in pairs.iter() {
        sorted.push(ordered(p.0.clone(), p.1.clone()));
    }
    sorted.sort();
    for i in 0..sentence1.len() {
        if sentence1[i] == sentence2[i] {
            continue;
        }
        let want = ordered(sentence1[i].clone(), sentence2[i].clone());
        let mut lo = 0;
        let mut hi = sorted.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if sorted[mid] < want {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo == sorted.len() or sorted[lo] != want {
            return false;
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn words(text: String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in text.split(" ") {
        if w.len() > 0 {
            out.push(w.to_string());
        }
    }
    out
}

fn pairs_of(text: String) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    let w = words(text);
    let mut i = 0;
    while i + 1 < w.len() {
        out.push((w[i].clone(), w[i + 1].clone()));
        i += 2;
    }
    out
}

fn show(a: String, b: String, p: String) {
    let s1 = words(a);
    let s2 = words(b);
    let pairs = pairs_of(p);
    let shown = f"{s1} and {s2} with {pairs}";
    println(f"{shown} -> {are_sentences_similar(s1, s2, pairs)}");
}

fn word(k: i64) -> String {
    f"w{k}"
}

fn main() {
    show("great acting skills".to_string(), "fine drama talent".to_string(), "great fine drama acting skills talent".to_string());
    show("great".to_string(), "great".to_string(), "".to_string());
    show("great".to_string(), "doubleplus good".to_string(), "great doubleplus".to_string());
    show("a".to_string(), "c".to_string(), "a b b c".to_string());
    show("b".to_string(), "a".to_string(), "a b".to_string());
    show("a b".to_string(), "b a".to_string(), "a b".to_string());
    show("x y z".to_string(), "x y q".to_string(), "x q y q".to_string());
    let mut seed: i64 = 734;
    // 1000 pairs over 200 words; the second sentence takes each word of
    // the first, or a word paired with it.
    let mut pairs: Vec[(String, String)] = Vec.new();
    for _ in 0..1000 {
        pairs.push((word(next_random(mut seed) % 200), word(next_random(mut seed) % 200)));
    }
    let mut s1: Vec[String] = Vec.new();
    let mut s2: Vec[String] = Vec.new();
    for _ in 0..1000 {
        let p = pairs[next_random(mut seed) % 1000].clone();
        if next_random(mut seed) % 2 == 0 {
            s1.push(p.0);
            s2.push(p.1);
        } else {
            s1.push(p.1);
            s2.push(p.0);
        }
    }
    println(f"1000 words, each paired with its counterpart -> {are_sentences_similar(s1.clone(), s2.clone(), pairs.clone())}");
    let mut changed = s2.clone();
    changed[999] = "nowhere".to_string();
    println(f"the same with the last word changed -> {are_sentences_similar(s1.clone(), changed, pairs.clone())}");
    println(f"the same with the pairs left out -> {are_sentences_similar(s1.clone(), s2.clone(), Vec.new())}");
    let mut shorter = s2.clone();
    shorter.pop();
    println(f"the same one word short -> {are_sentences_similar(s1, shorter, pairs)}");
    let mut yes = 0;
    let mut sum = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 6;
        let np = next_random(mut seed) % 7;
        let mut ps: Vec[(String, String)] = Vec.new();
        for _ in 0..np {
            ps.push((word(next_random(mut seed) % 6), word(next_random(mut seed) % 6)));
        }
        let mut a: Vec[String] = Vec.new();
        let mut b: Vec[String] = Vec.new();
        for _ in 0..n {
            let x = next_random(mut seed) % 6;
            a.push(word(x));
            let pick = next_random(mut seed) % 3;
            if pick == 0 or np == 0 {
                b.push(word(x));
            } else if pick == 1 {
                b.push(ps[next_random(mut seed) % np].1.clone());
            } else {
                b.push(word(next_random(mut seed) % 6));
            }
        }
        if next_random(mut seed) % 10 == 0 {
            b.push(word(0));
        }
        let v = if are_sentences_similar(a, b, ps) { 1 } else { 0 };
        yes += v;
        sum = (sum * 131 + v + 1) % 1000000007;
    }
    println(f"300 random cases: {yes} similar, checksum {sum}");
}
