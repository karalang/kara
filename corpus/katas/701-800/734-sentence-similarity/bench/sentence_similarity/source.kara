// LeetCode #734: Sentence Similarity -- a set of pairs.
//
// Two sentences are similar when they have the same number of words
// and each word is the same as, or a given similar pair with, the word
// in the same place in the other. Similarity is symmetric but not
// transitive. Put every pair in a set both ways round, then check the
// words place by place. O(p + n) set operations.

fn are_sentences_similar(sentence1: Vec[String], sentence2: Vec[String], pairs: Vec[(String, String)]) -> bool {
    if sentence1.len() != sentence2.len() {
        return false;
    }
    let mut similar: Set[(String, String)] = Set.new();
    for p in pairs.iter() {
        similar.insert((p.0.clone(), p.1.clone()));
        similar.insert((p.1.clone(), p.0.clone()));
    }
    for i in 0..sentence1.len() {
        let a = sentence1[i].clone();
        let b = sentence2[i].clone();
        if a != b and not similar.contains((a, b)) {
            return false;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 1,000 pairs over 5,000 words, and two sentences of 1,000 words
    // in which each place holds the two words of a random pair, made
    // once.
    let mut seed: i64 = 734;
    let mut pairs: Vec[(String, String)] = Vec.new();
    for _ in 0..1000 {
        let a = next_random(mut seed) % 5000;
        let b = next_random(mut seed) % 5000;
        pairs.push((f"w{a}", f"w{b}"));
    }
    let mut s1: Vec[String] = Vec.new();
    let mut s2: Vec[String] = Vec.new();
    for _ in 0..1000 {
        let p = next_random(mut seed) % 1000;
        if next_random(mut seed) % 2 == 0 {
            s1.push(pairs[p].0.clone());
            s2.push(pairs[p].1.clone());
        } else {
            s1.push(pairs[p].1.clone());
            s2.push(pairs[p].0.clone());
        }
    }
    // 1000 rounds: one place of the second sentence changed to a
    // random word and the sentences compared, then changed back and
    // compared again.
    let mut similar = 0;
    for _ in 0..1000 {
        let j = next_random(mut seed) % 1000;
        let x = next_random(mut seed) % 5000;
        let saved = s2[j].clone();
        s2[j] = f"w{x}";
        if are_sentences_similar(s1, s2, pairs) {
            similar += 1;
        }
        s2[j] = saved;
        if are_sentences_similar(s1, s2, pairs) {
            similar += 1;
        }
    }
    println(f"1000 rounds of 2 checks of 1000 words with 1000 pairs: {similar} similar");
}
