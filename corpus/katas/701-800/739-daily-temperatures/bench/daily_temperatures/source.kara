// LeetCode #739: Daily Temperatures -- a stack of colder days.
//
// For each day, the number of days to wait for a warmer one, or 0 when
// none comes. Walk the days keeping a stack of the days still waiting,
// whose temperatures never rise from the bottom up; a day warmer than
// the top answers it, and every day under it that it is warmer than,
// and then waits itself. Each day is pushed and popped once: O(n).

fn daily_temperatures(temperatures: Vec[i64]) -> Vec[i64] {
    let n = temperatures.len();
    let mut answer: Vec[i64] = Vec.new();
    for _ in 0..n {
        answer.push(0);
    }
    let mut waiting: Vec[i64] = Vec.new();
    for i in 0..n {
        while waiting.len() > 0 and temperatures[waiting[waiting.len() - 1]] < temperatures[i] {
            let j = waiting.pop().unwrap();
            answer[j] = i - j;
        }
        waiting.push(i);
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100,000 random days from 30 to 100, made once; in each of 300
    // rounds 100 random days change to a random temperature and every
    // day's wait is found again and summed.
    let mut seed: i64 = 739;
    let n = 100000;
    let mut t: Vec[i64] = Vec.new();
    for _ in 0..n {
        t.push(30 + next_random(mut seed) % 71);
    }
    let mut total = 0;
    for _ in 0..300 {
        for _ in 0..100 {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            t[j] = 30 + next_random(mut seed) % 71;
        }
        let answer = daily_temperatures(t);
        for a in answer.iter() {
            total += *a;
        }
    }
    println(f"300 rounds of 100000 days: {total} days waited in all");
}
