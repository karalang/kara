// LeetCode 784 — Letter Case Permutation, growing the prefixes.
//
// Keep every permutation of the string read so far, starting from the
// empty string. A digit is appended to each of them; a letter doubles
// the list, each prefix appended once with the letter in lower case and
// once in upper case. O(2^L * n).

fn letter_case_permutation(s: String) -> Vec[String] {
    let mut all: Vec[String] = [String.new()];
    for c in s.chars() {
        let mut next: Vec[String] = Vec.new();
        for prefix in all.iter() {
            if c.is_ascii_alphabetic() {
                let mut lower = prefix.clone();
                lower.push(c.to_ascii_lowercase());
                next.push(lower);
                let mut upper = prefix.clone();
                upper.push(c.to_ascii_uppercase());
                next.push(upper);
            } else {
                let mut same = prefix.clone();
                same.push(c);
                next.push(same);
            }
        }
        all = next;
    }
    all
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The permutations sorted, so every arm prints them in the same order.
fn sorted_permutations(s: String) -> Vec[String] {
    let mut all = letter_case_permutation(s);
    all.sort();
    all
}

fn show(s: String) {
    let all = sorted_permutations(s);
    println(f"\"{s}\" -> {all}");
}

fn main() {
    show("a1b2");
    show("3z4");
    show("12345");
    show("C");
    show("aBc");
    show("Zz9");
    let all = sorted_permutations("abcdefghijkl");
    let mut check = 0;
    for p in all.iter() {
        for b in p.bytes() {
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"\"abcdefghijkl\" -> {all.len()} strings, first {all[0]}, last {all[all.len() - 1]}, checksum {check}");
    let alphabet: Vec[char] = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".chars().collect();
    let mut seed = 784;
    let mut strings = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 12;
        let mut s = String.new();
        for _ in 0..n {
            s.push(alphabet[next_random(mut seed) % 62]);
        }
        let all = sorted_permutations(s);
        strings += all.len();
        for p in all.iter() {
            for b in p.bytes() {
                check = (check * 131 + b as i64) % 1000000007;
            }
        }
    }
    println(f"300 random strings: {strings} permutations, checksum {check}");
}
