// LeetCode 784 — Letter Case Permutation, one bit for each letter.
//
// With L letters there are 2^L permutations, one for each L-bit number:
// bit j of a number says whether the j-th letter is in upper case. Count
// from 0 to 2^L - 1 and spell each number out over the string. O(2^L * n).

fn letter_case_permutation(s: String) -> Vec[String] {
    let chars: Vec[char] = s.chars().collect();
    let mut letters = 0;
    for c in chars.iter() {
        if c.is_ascii_alphabetic() {
            letters += 1;
        }
    }
    let mut out: Vec[String] = Vec.new();
    for mask in 0..(1 << letters) {
        let mut word = String.new();
        let mut j = 0;
        for c in chars.iter() {
            if c.is_ascii_alphabetic() {
                word.push(if (mask >> j) & 1 == 1 { c.to_ascii_uppercase() } else { c.to_ascii_lowercase() });
                j += 1;
            } else {
                word.push(*c);
            }
        }
        out.push(word);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The permutations sorted, so every arm prints them in the same order.
fn sorted_permutations(s: String) -> Vec[String] {
    let mut all = letter_case_permutation(s);
    all.sort();
    all
}

fn show(s: String) {
    let all = sorted_permutations(s);
    println(f"\"{s}\" -> {all}");
}

fn main() {
    show("a1b2");
    show("3z4");
    show("12345");
    show("C");
    show("aBc");
    show("Zz9");
    let all = sorted_permutations("abcdefghijkl");
    let mut check = 0;
    for p in all.iter() {
        for b in p.bytes() {
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"\"abcdefghijkl\" -> {all.len()} strings, first {all[0]}, last {all[all.len() - 1]}, checksum {check}");
    let alphabet: Vec[char] = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".chars().collect();
    let mut seed = 784;
    let mut strings = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 12;
        let mut s = String.new();
        for _ in 0..n {
            s.push(alphabet[next_random(mut seed) % 62]);
        }
        let all = sorted_permutations(s);
        strings += all.len();
        for p in all.iter() {
            for b in p.bytes() {
                check = (check * 131 + b as i64) % 1000000007;
            }
        }
    }
    println(f"300 random strings: {strings} permutations, checksum {check}");
}
