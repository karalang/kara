// LeetCode #712: Minimum ASCII Delete Sum for Two Strings -- a table
// of prefixes.
//
// cost[i][j] is the least ASCII sum deleted to make the first i bytes
// of s1 equal to the first j of s2. An empty prefix costs the whole of
// the other; equal last bytes cost what the prefixes before them cost;
// otherwise delete one of the two last bytes, whichever is cheaper.
// O(m * n) time and space.

fn minimum_delete_sum(s1: String, s2: String) -> i64 {
    let a = s1.bytes().to_vec();
    let b = s2.bytes().to_vec();
    let m = a.len();
    let n = b.len();
    let mut cost: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m + 1 {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n + 1 {
            row.push(0);
        }
        cost.push(row);
    }
    for i in 1..m + 1 {
        cost[i][0] = cost[i - 1][0] + a[i - 1] as i64;
    }
    for j in 1..n + 1 {
        cost[0][j] = cost[0][j - 1] + b[j - 1] as i64;
    }
    for i in 1..m + 1 {
        for j in 1..n + 1 {
            if a[i - 1] == b[j - 1] {
                cost[i][j] = cost[i - 1][j - 1];
            } else {
                let drop_a = cost[i - 1][j] + a[i - 1] as i64;
                let drop_b = cost[i][j - 1] + b[j - 1] as i64;
                cost[i][j] = if drop_a < drop_b { drop_a } else { drop_b };
            }
        }
    }
    cost[m][n]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` random lowercase letters from the first `k` of the alphabet.
fn random_string(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((97 + next_random(mut seed) % k) as u8 as char);
    }
    s
}

fn show(s1: String, s2: String) {
    println(f"\"{s1}\", \"{s2}\" -> {minimum_delete_sum(s1, s2)}");
}

fn main() {
    show("sea", "eat");
    show("delete", "leet");
    show("a", "a");
    show("a", "b");
    show("abc", "");
    show("", "");
    show("abc", "abc");
    show("abc", "cba");
    show("zzzz", "z");
    show("ab", "ba");
    let mut seed: i64 = 712;
    let x = random_string(1000, 26, mut seed);
    let y = random_string(1000, 26, mut seed);
    println(f"1000 and 1000 letters: {minimum_delete_sum(x, y)}");
    let p = random_string(1000, 3, mut seed);
    let q = random_string(1000, 3, mut seed);
    println(f"1000 and 1000 of 3 letters: {minimum_delete_sum(p, q)}");
    let mut sum = 0;
    for _ in 0..500 {
        let k = 1 + next_random(mut seed) % 26;
        let s1 = random_string(next_random(mut seed) % 40, k, mut seed);
        let s2 = random_string(next_random(mut seed) % 40, k, mut seed);
        sum = (sum * 131 + minimum_delete_sum(s1, s2)) % 1000000007;
    }
    println(f"500 random pairs: checksum {sum}");
}
