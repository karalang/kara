// LeetCode #712: Minimum ASCII Delete Sum for Two Strings -- recursion
// with a memo.
//
// The same recurrence top-down over suffixes: what it costs to make
// s1 from byte i on equal to s2 from byte j on, remembered in a table
// of -1 until computed. O(m * n) time and space, recursion m + n deep.

fn rest_sum(v: Vec[u8], from: i64) -> i64 {
    let mut total = 0;
    for k in from..v.len() {
        total += v[k] as i64;
    }
    total
}

fn cost(a: Vec[u8], b: Vec[u8], i: i64, j: i64,
        memo: mut ref Vec[Vec[i64]]) -> i64 {
    if i == a.len() {
        return rest_sum(b, j);
    }
    if j == b.len() {
        return rest_sum(a, i);
    }
    if memo[i][j] >= 0 {
        return memo[i][j];
    }
    let best = if a[i] == b[j] {
        cost(a, b, i + 1, j + 1, mut memo)
    } else {
        let drop_a = a[i] as i64 + cost(a, b, i + 1, j, mut memo);
        let drop_b = b[j] as i64 + cost(a, b, i, j + 1, mut memo);
        if drop_a < drop_b { drop_a } else { drop_b }
    };
    memo[i][j] = best;
    best
}

fn minimum_delete_sum(s1: String, s2: String) -> i64 {
    let a = s1.bytes().to_vec();
    let b = s2.bytes().to_vec();
    let mut memo: Vec[Vec[i64]] = Vec.new();
    for _ in 0..a.len() {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..b.len() {
            row.push(-1);
        }
        memo.push(row);
    }
    cost(a, b, 0, 0, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` random lowercase letters from the first `k` of the alphabet.
fn random_string(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((97 + next_random(mut seed) % k) as u8 as char);
    }
    s
}

fn show(s1: String, s2: String) {
    println(f"\"{s1}\", \"{s2}\" -> {minimum_delete_sum(s1, s2)}");
}

fn main() {
    show("sea", "eat");
    show("delete", "leet");
    show("a", "a");
    show("a", "b");
    show("abc", "");
    show("", "");
    show("abc", "abc");
    show("abc", "cba");
    show("zzzz", "z");
    show("ab", "ba");
    let mut seed: i64 = 712;
    let x = random_string(1000, 26, mut seed);
    let y = random_string(1000, 26, mut seed);
    println(f"1000 and 1000 letters: {minimum_delete_sum(x, y)}");
    let p = random_string(1000, 3, mut seed);
    let q = random_string(1000, 3, mut seed);
    println(f"1000 and 1000 of 3 letters: {minimum_delete_sum(p, q)}");
    let mut sum = 0;
    for _ in 0..500 {
        let k = 1 + next_random(mut seed) % 26;
        let s1 = random_string(next_random(mut seed) % 40, k, mut seed);
        let s2 = random_string(next_random(mut seed) % 40, k, mut seed);
        sum = (sum * 131 + minimum_delete_sum(s1, s2)) % 1000000007;
    }
    println(f"500 random pairs: checksum {sum}");
}
