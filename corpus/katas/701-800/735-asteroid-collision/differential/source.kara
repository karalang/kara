// LeetCode #735: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random rows.

// ---- ★ arm ----------------------------------------------------------

fn asteroid_collision_star(asteroids: Vec[i64]) -> Vec[i64] {
    let mut stack: Vec[i64] = Vec.new();
    for a in asteroids.iter() {
        let mut alive = true;
        while alive and *a < 0 and stack.len() > 0 and stack[stack.len() - 1] > 0 {
            let top = stack[stack.len() - 1];
            if top < -*a {
                stack.pop();
            } else {
                if top == -*a {
                    stack.pop();
                }
                alive = false;
            }
        }
        if alive {
            stack.push(*a);
        }
    }
    stack
}

// ---- simulate arm ---------------------------------------------------

fn asteroid_collision_simulate(asteroids: Vec[i64]) -> Vec[i64] {
    let mut row = asteroids.clone();
    loop {
        let mut at = -1;
        for i in 0..row.len() - 1 {
            if row[i] > 0 and row[i + 1] < 0 {
                at = i;
                break;
            }
        }
        if at < 0 {
            return row;
        }
        let right = row[at];
        let left = -row[at + 1];
        if right > left {
            row.remove(at + 1);
        } else if right < left {
            row.remove(at);
        } else {
            row.remove(at + 1);
            row.remove(at);
        }
    }
}

// ---- inplace arm ----------------------------------------------------

fn asteroid_collision_inplace(asteroids: Vec[i64]) -> Vec[i64] {
    let mut row = asteroids.clone();
    let mut top = 0;
    for i in 0..row.len() {
        let a = row[i];
        let mut alive = true;
        while alive and a < 0 and top > 0 and row[top - 1] > 0 {
            if row[top - 1] < -a {
                top -= 1;
            } else {
                if row[top - 1] == -a {
                    top -= 1;
                }
                alive = false;
            }
        }
        if alive {
            row[top] = a;
            top += 1;
        }
    }
    row.truncate(top);
    row
}

// ---- fromright arm --------------------------------------------------

fn asteroid_collision_fromright(asteroids: Vec[i64]) -> Vec[i64] {
    let mut stack: Vec[i64] = Vec.new();
    let mut i = asteroids.len();
    while i > 0 {
        i -= 1;
        let a = asteroids[i];
        let mut alive = true;
        while alive and a > 0 and stack.len() > 0 and stack[stack.len() - 1] < 0 {
            let top = -stack[stack.len() - 1];
            if top < a {
                stack.pop();
            } else {
                if top == a {
                    stack.pop();
                }
                alive = false;
            }
        }
        if alive {
            stack.push(a);
        }
    }
    stack.reverse();
    stack
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn collide_with(which: i64, row: Vec[i64]) -> Vec[i64] {
    if which == 0 {
        asteroid_collision_star(row)
    } else if which == 1 {
        asteroid_collision_simulate(row)
    } else if which == 2 {
        asteroid_collision_inplace(row)
    } else {
        asteroid_collision_fromright(row)
    }
}

fn size_of(a: i64) -> i64 {
    if a < 0 { -a } else { a }
}

// True when some right-mover is somewhere left of a left-mover, so that
// a collision is still to come.
fn pending(row: Vec[i64]) -> bool {
    let mut seen_right = false;
    for a in row.iter() {
        if *a > 0 {
            seen_right = true;
        } else if seen_right {
            return true;
        }
    }
    false
}

// The definition, by moving the asteroids: the i-th starts at position
// 2 i, and at each step every asteroid moves one place its own way. The
// gap between a right-mover and a left-mover after it starts even and
// shrinks by 2 a step, so two asteroids meet only at the same place at
// the same time, and asteroids moving the same way never meet. Wherever
// two meet, the smaller explodes, and both if they are the same size.
// Once no right-mover is left of a left-mover nothing more can meet,
// and the survivors, left to right, are the answer.
fn definition(row: Vec[i64]) -> Vec[i64] {
    let mut pos: Vec[i64] = Vec.new();
    let mut ast: Vec[i64] = Vec.new();
    for i in 0..row.len() {
        pos.push(2 * i);
        ast.push(row[i]);
    }
    while pending(ast) {
        for i in 0..pos.len() {
            if ast[i] > 0 {
                pos[i] += 1;
            } else {
                pos[i] -= 1;
            }
        }
        let mut dead: Vec[bool] = Vec.new();
        for _ in 0..pos.len() {
            dead.push(false);
        }
        for i in 0..pos.len() {
            for j in i + 1..pos.len() {
                if pos[i] == pos[j] {
                    if size_of(ast[i]) <= size_of(ast[j]) {
                        dead[i] = true;
                    }
                    if size_of(ast[j]) <= size_of(ast[i]) {
                        dead[j] = true;
                    }
                }
            }
        }
        let mut next_pos: Vec[i64] = Vec.new();
        let mut next_ast: Vec[i64] = Vec.new();
        for i in 0..pos.len() {
            if not dead[i] {
                next_pos.push(pos[i]);
                next_ast.push(ast[i]);
            }
        }
        pos = next_pos;
        ast = next_ast;
    }
    ast
}

// True when every element of `part` appears in `whole`, in order.
fn is_subsequence(part: Vec[i64], whole: Vec[i64]) -> bool {
    let mut k = 0;
    for a in whole.iter() {
        if k < part.len() and part[k] == *a {
            k += 1;
        }
    }
    k == part.len()
}

fn main() {
    let mut seed = 7350;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut survivors = 0;
    let rows = 3000;
    for _ in 0..rows {
        // 2 to 10 asteroids of sizes 1 to 4, each way at random, so that
        // asteroids of the same size meet often.
        let n = 2 + next_random(mut seed) % 9;
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            let size = 1 + next_random(mut seed) % 4;
            if next_random(mut seed) % 2 == 0 {
                row.push(size);
            } else {
                row.push(-size);
            }
        }
        let cut = next_random(mut seed) % (n + 1);
        let want = definition(row);
        survivors += want.len();
        let mut mirrored: Vec[i64] = Vec.new();
        let mut i = n;
        while i > 0 {
            i -= 1;
            mirrored.push(-row[i]);
        }
        let mut front: Vec[i64] = Vec.new();
        let mut back: Vec[i64] = Vec.new();
        for k in 0..n {
            if k < cut {
                front.push(row[k]);
            } else {
                back.push(row[k]);
            }
        }
        for which in 0..arms {
            let got = collide_with(which, row);
            // P1: the definition's survivors.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the row reversed with every asteroid turned round, the
            // survivors reversed and turned round.
            checks += 1;
            let mut expect: Vec[i64] = Vec.new();
            let mut j = got.len();
            while j > 0 {
                j -= 1;
                expect.push(-got[j]);
            }
            if collide_with(which, mirrored) != expect {
                fails[1] += 1;
            }
            // P3: the survivors are some of the asteroids, in their
            // order, and no right-mover among them is left of a
            // left-mover.
            checks += 1;
            if not is_subsequence(got, row) or pending(got) {
                fails[2] += 1;
            }
            // P4: settling each side of a cut first, and then the two
            // sides' survivors together, leaves the same survivors.
            checks += 1;
            let mut joined = collide_with(which, front);
            for a in collide_with(which, back).iter() {
                joined.push(*a);
            }
            if collide_with(which, joined) != got {
                fails[3] += 1;
            }
        }
    }
    let mut total = 0;
    for i in 0..4 {
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
        total += fails[i];
    }
    println(f"{rows} rows ({survivors} survivors), {arms} arms, {checks} checks, {total} failures");
}
