// LeetCode 765 — Couples Holding Hands, union-find.
//
// Think of each couple as a node and each couch as an edge joining the two
// couples sitting on it. A group of k couples tangled together over k
// couches takes k - 1 swaps to untangle, so the answer is the number of
// couples less the number of groups. Union-find counts the groups.
// O(n α(n)).

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut at = x;
    while parent[at] != root {
        let next = parent[at];
        parent[at] = root;
        at = next;
    }
    root
}

fn min_swaps_couples(row: Vec[i64]) -> i64 {
    let couples = row.len() / 2;
    let mut parent: Vec[i64] = Vec.new();
    for k in 0..couples {
        parent.push(k);
    }
    let mut groups = couples;
    for couch in 0..couples {
        let a = find(mut parent, row[2 * couch] / 2);
        let b = find(mut parent, row[2 * couch + 1] / 2);
        if a != b {
            parent[a] = b;
            groups -= 1;
        }
    }
    couples - groups
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(row: Vec[i64]) {
    let swaps = min_swaps_couples(row.clone());
    println(f"{row} -> {swaps}");
}

fn main() {
    show([0, 2, 1, 3]);
    show([3, 2, 0, 1]);
    show([0, 1]);
    show([1, 0]);
    show([0, 2, 4, 1, 3, 5]);
    show([5, 4, 2, 6, 3, 1, 0, 7]);
    show([0, 3, 2, 5, 4, 7, 6, 9, 8, 1]);
    let mut seed = 765;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let couples = 1 + next_random(mut seed) % 30;
        let mut row: Vec[i64] = Vec.new();
        for p in 0..2 * couples {
            row.push(p);
        }
        for i in 0..2 * couples {
            let j = i + next_random(mut seed) % (2 * couples - i);
            row.swap(i, j);
        }
        let swaps = min_swaps_couples(row);
        total += swaps;
        check = (check * 31 + swaps) % 1000000007;
    }
    println(f"300 random rows: {total} swaps in all, checksum {check}");
}
