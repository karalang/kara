// LeetCode 765 — Couples Holding Hands, following chains.
//
// Start at a couch and walk: take its second occupant's partner, go to the
// couch where that partner sits, and continue from the partner's
// neighbour there, until the walk comes back to the couch it started at.
// The couches walked through form one cycle, which takes its length less
// one swap to fix. O(n).

fn min_swaps_couples(row: Vec[i64]) -> i64 {
    let mut seat_of: Vec[i64] = Vec.new();
    for _ in 0..row.len() {
        seat_of.push(0);
    }
    for i in 0..row.len() {
        seat_of[row[i]] = i;
    }
    let mut done: Vec[bool] = Vec.new();
    for _ in 0..row.len() / 2 {
        done.push(false);
    }
    let mut swaps = 0;
    for start in 0..row.len() / 2 {
        if done[start] {
            continue;
        }
        let mut length = 0;
        let mut seat = 2 * start;
        loop {
            done[seat / 2] = true;
            length += 1;
            // the neighbour on this couch, then where their partner sits
            let partner_seat = seat_of[row[seat ^ 1] ^ 1];
            if partner_seat / 2 == start {
                break;
            }
            seat = partner_seat;
        }
        swaps += length - 1;
    }
    swaps
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(row: Vec[i64]) {
    let swaps = min_swaps_couples(row.clone());
    println(f"{row} -> {swaps}");
}

fn main() {
    show([0, 2, 1, 3]);
    show([3, 2, 0, 1]);
    show([0, 1]);
    show([1, 0]);
    show([0, 2, 4, 1, 3, 5]);
    show([5, 4, 2, 6, 3, 1, 0, 7]);
    show([0, 3, 2, 5, 4, 7, 6, 9, 8, 1]);
    let mut seed = 765;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let couples = 1 + next_random(mut seed) % 30;
        let mut row: Vec[i64] = Vec.new();
        for p in 0..2 * couples {
            row.push(p);
        }
        for i in 0..2 * couples {
            let j = i + next_random(mut seed) % (2 * couples - i);
            row.swap(i, j);
        }
        let swaps = min_swaps_couples(row);
        total += swaps;
        check = (check * 31 + swaps) % 1000000007;
    }
    println(f"300 random rows: {total} swaps in all, checksum {check}");
}
