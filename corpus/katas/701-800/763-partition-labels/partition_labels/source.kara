// LeetCode 763 — Partition Labels, greedy on last occurrences.
//
// Record where each letter last appears. Then walk the string: the part
// that holds the current letter must reach at least to that letter's last
// appearance, so stretch the part's end to it, and close the part when the
// walk reaches its end. O(n).

fn partition_labels(s: String) -> Vec[i64] {
    let chars: Vec[char] = s.chars().collect();
    let mut last: Vec[i64] = Vec.new();
    for _ in 0..26 {
        last.push(0);
    }
    for i in 0..chars.len() {
        last[chars[i] as i64 - 'a' as i64] = i;
    }
    let mut sizes: Vec[i64] = Vec.new();
    let mut start = 0;
    let mut end = 0;
    for i in 0..chars.len() {
        end = end.max(last[chars[i] as i64 - 'a' as i64]);
        if i == end {
            sizes.push(end - start + 1);
            start = i + 1;
        }
    }
    sizes
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random string of n letters whose letters drift through the alphabet,
// so that it falls into several parts: the letter at i is drawn from a
// window of `width` letters starting near i x 26 / n.
fn random_letters(n: i64, width: i64, seed: mut ref i64) -> String {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut s = String.new();
    for i in 0..n {
        let k = (i * 26 / n + next_random(mut seed) % width).min(25);
        s.push_str(letters[k..k + 1]);
    }
    s
}

fn show(s: String) {
    let sizes = partition_labels(s.clone());
    println(f"{s} -> {sizes}");
}

fn main() {
    show("ababcbacadefegdehijhklij");
    show("eccbbbbdec");
    show("a");
    show("abc");
    show("abca");
    show("aabbcc");
    show("abacbdcedfeg");
    show("zyxwvutsrqponmlkjihgfedcbaz");
    let mut seed = 763;
    let mut parts = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 500;
        let width = 1 + next_random(mut seed) % 4;
        let sizes = partition_labels(random_letters(n, width, mut seed));
        parts += sizes.len();
        for size in sizes.iter() {
            check = (check * 31 + *size) % 1000000007;
        }
    }
    println(f"300 random strings: {parts} parts, checksum {check}");
}
