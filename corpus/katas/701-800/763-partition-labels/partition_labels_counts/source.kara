// LeetCode 763 — Partition Labels, counting what is still to come.
//
// Count every letter. Walk the string, taking one off the current letter's
// count, and keep track of how many letters have been seen but are not yet
// used up. Where that number falls to zero, nothing seen so far appears
// later, so a part can end there. O(n).

fn partition_labels(s: String) -> Vec[i64] {
    let mut remaining: Map[char, i64] = Map.new();
    for c in s.chars() {
        remaining.insert(c, remaining.get(c).unwrap_or(0) + 1);
    }
    let mut seen: Set[char] = Set.new();
    let mut open = 0;
    let mut sizes: Vec[i64] = Vec.new();
    let mut size = 0;
    for c in s.chars() {
        if not seen.contains(c) {
            seen.insert(c);
            open += 1;
        }
        let left = remaining[c] - 1;
        remaining.insert(c, left);
        if left == 0 {
            open -= 1;
        }
        size += 1;
        if open == 0 {
            sizes.push(size);
            size = 0;
        }
    }
    sizes
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random string of n letters whose letters drift through the alphabet,
// so that it falls into several parts: the letter at i is drawn from a
// window of `width` letters starting near i x 26 / n.
fn random_letters(n: i64, width: i64, seed: mut ref i64) -> String {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut s = String.new();
    for i in 0..n {
        let k = (i * 26 / n + next_random(mut seed) % width).min(25);
        s.push_str(letters[k..k + 1]);
    }
    s
}

fn show(s: String) {
    let sizes = partition_labels(s.clone());
    println(f"{s} -> {sizes}");
}

fn main() {
    show("ababcbacadefegdehijhklij");
    show("eccbbbbdec");
    show("a");
    show("abc");
    show("abca");
    show("aabbcc");
    show("abacbdcedfeg");
    show("zyxwvutsrqponmlkjihgfedcbaz");
    let mut seed = 763;
    let mut parts = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 500;
        let width = 1 + next_random(mut seed) % 4;
        let sizes = partition_labels(random_letters(n, width, mut seed));
        parts += sizes.len();
        for size in sizes.iter() {
            check = (check * 31 + *size) % 1000000007;
        }
    }
    println(f"300 random strings: {parts} parts, checksum {check}");
}
