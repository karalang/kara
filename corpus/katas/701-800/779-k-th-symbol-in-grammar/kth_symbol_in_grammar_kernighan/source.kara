// LeetCode 779 — K-th Symbol in Grammar, the 1 bits cleared one by one.
//
// The symbol is the parity of the 1 bits in k - 1 (see the ★ arm). Count
// them by clearing the lowest one, x & (x - 1), until none is left,
// flipping the answer each time. O(the number of 1 bits).

fn kth_grammar(n: i64, k: i64) -> i64 {
    let mut x = k - 1;
    let mut symbol = 0;
    while x != 0 {
        x = x & (x - 1);
        symbol = 1 - symbol;
    }
    symbol
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64, k: i64) {
    let answer = kth_grammar(n, k);
    println(f"n = {n}, k = {k} -> {answer}");
}

fn main() {
    show(1, 1);
    show(2, 1);
    show(2, 2);
    show(30, 1);
    show(30, 536870912);
    show(30, 536870911);
    show(30, 268435457);
    for n in 1..6 {
        let mut row = String.new();
        for k in 1..(1 << (n - 1)) + 1 {
            row.push_str(f"{kth_grammar(n, k)}");
        }
        println(f"row {n}: {row}");
    }
    let mut seed = 779;
    let mut ones = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = 1 + next_random(mut seed) % 30;
        let k = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % (1 << (n - 1));
        let answer = kth_grammar(n, k);
        ones += answer;
        check = (check * 3 + answer + 1) % 1000000007;
    }
    println(f"1000 random queries: {ones} ones, checksum {check}");
}
