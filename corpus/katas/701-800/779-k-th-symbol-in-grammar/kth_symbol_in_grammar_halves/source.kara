// LeetCode 779 — K-th Symbol in Grammar, the halves of a row.
//
// Row n is row n - 1 followed by row n - 1 with every symbol flipped:
// both start from row n - 2 made twice as long, the second from its
// flipped copy. So walk down from row n: when k is in the second half,
// take it to the same place in the first and flip the answer. O(n).

fn kth_grammar(n: i64, k: i64) -> i64 {
    let mut row = n;
    let mut at = k;
    let mut flipped = 0;
    while row > 1 {
        let half = 1 << (row - 2);
        if at > half {
            at -= half;
            flipped = 1 - flipped;
        }
        row -= 1;
    }
    flipped
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64, k: i64) {
    let answer = kth_grammar(n, k);
    println(f"n = {n}, k = {k} -> {answer}");
}

fn main() {
    show(1, 1);
    show(2, 1);
    show(2, 2);
    show(30, 1);
    show(30, 536870912);
    show(30, 536870911);
    show(30, 268435457);
    for n in 1..6 {
        let mut row = String.new();
        for k in 1..(1 << (n - 1)) + 1 {
            row.push_str(f"{kth_grammar(n, k)}");
        }
        println(f"row {n}: {row}");
    }
    let mut seed = 779;
    let mut ones = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = 1 + next_random(mut seed) % 30;
        let k = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % (1 << (n - 1));
        let answer = kth_grammar(n, k);
        ones += answer;
        check = (check * 3 + answer + 1) % 1000000007;
    }
    println(f"1000 random queries: {ones} ones, checksum {check}");
}
