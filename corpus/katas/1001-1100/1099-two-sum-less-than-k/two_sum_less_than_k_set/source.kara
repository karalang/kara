// LeetCode #1099: Two Sum Less Than K -- one pass with a `SortedSet` of
// the values seen so far: for each value, the largest seen one under k
// minus it is the last of `range(.., k - x)`, and then the value joins
// the set. O(n log n), the input never sorted.

fn two_sum_less_than_k(nums: Vec[i64], k: i64) -> i64 {
    let mut seen: SortedSet[i64] = SortedSet.new();
    let mut best = -1;
    for x in nums.iter() {
        if let Some(y) = seen.range(i64.MIN, k - x).next_back() {
            best = best.max(x + y);
        }
        seen.insert(x);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases: Vec[(Vec[i64], i64)] = [
        ([34, 23, 1, 24, 75, 33, 54, 8], 60),
        ([10, 20, 30], 15),
        ([5], 100),
        ([1, 1], 3),
        ([1, 1], 2),
        ([7, 7, 7, 7], 15),
        ([1000, 1000], 2000),
        ([999, 1000], 2000),
        ([1, 2, 3, 4, 5], 1),
        ([3, 9, 1, 8, 2], 11),
        ([500, 400, 600, 100], 1001),
    ];
    for (nums, k) in cases.iter() {
        println(f"{two_sum_less_than_k(nums.clone(), k)}");
    }
    // 2000 random arrays of 1 to 100 values from 1 to 1000, k from 1 to
    // 2000
    let mut seed = 1099;
    let mut found = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 100 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 1000 + 1).collect();
        let k = next_random(mut seed) % 2000 + 1;
        let best = two_sum_less_than_k(nums, k);
        if best >= 0 {
            found += 1;
            total += best;
        }
        check = (check * 31 + best + 1) % 1000000007;
    }
    println(f"2000 random arrays: {found} with a pair, sums total {total}, checksum {check}");
    // 100 values, LeetCode's most, at every k from 1 to 2000
    let nums: Vec[i64] = (0..100).map(|i| (i * 37 + 11) % 1000 + 1).collect();
    let mut sum = 0;
    for k in 1..=2000 {
        sum += two_sum_less_than_k(nums.clone(), k);
    }
    println(f"100 values, k from 1 to 2000: answers sum to {sum}");
}
