// LeetCode #1099: Two Sum Less Than K -- a differential over the six
// arms. Each answer is checked against the statement read literally and
// against five properties that do not compute the answer; see the README.

// ---- two_sum_less_than_k.kara ----

fn a0_two_sum_less_than_k(nums: Vec[i64], k: i64) -> i64 {
    let mut v = nums.clone();
    v.sort();
    let mut best = -1;
    let mut lo = 0;
    let mut hi = v.len() - 1;
    while lo < hi {
        let sum = v[lo] + v[hi];
        if sum < k {
            best = best.max(sum);
            lo += 1;
        } else {
            hi -= 1;
        }
    }
    best
}

// ---- two_sum_less_than_k_pairs.kara ----

fn a1_two_sum_less_than_k(nums: Vec[i64], k: i64) -> i64 {
    (0..nums.len())
        .flat_map(|i| (i + 1..nums.len()).map(|j| nums[i] + nums[j]))
        .filter(|s| *s < k)
        .max()
        .unwrap_or(-1)
}

// ---- two_sum_less_than_k_counts.kara ----

fn a2_two_sum_less_than_k(nums: Vec[i64], k: i64) -> i64 {
    let mut count = [0; 1001];
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut best = -1;
    let mut (lo, hi) = (1, 1000);
    while lo <= hi {
        if count[lo] == 0 {
            lo += 1;
        } else if count[hi] == 0 or lo + hi >= k {
            hi -= 1;
        } else {
            if lo < hi or count[lo] > 1 {
                best = best.max(lo + hi);
            }
            lo += 1;
        }
    }
    best
}

// ---- two_sum_less_than_k_search.kara ----

fn a3_two_sum_less_than_k(nums: Vec[i64], k: i64) -> i64 {
    let mut v = nums.clone();
    v.sort();
    let mut best = -1;
    for (i, x) in v.iter().enumerate() {
        let below = v.partition_point(|y| *y < k - x);
        let j = below.min(i);
        if j > 0 {
            best = best.max(x + v[j - 1]);
        }
    }
    best
}

// ---- two_sum_less_than_k_set.kara ----

fn a4_two_sum_less_than_k(nums: Vec[i64], k: i64) -> i64 {
    let mut seen: SortedSet[i64] = SortedSet.new();
    let mut best = -1;
    for x in nums.iter() {
        if let Some(y) = seen.range(i64.MIN, k - x).next_back() {
            best = best.max(x + y);
        }
        seen.insert(x);
    }
    best
}

// ---- two_sum_less_than_k_solution.kara ----

struct A5Solution {}

impl A5Solution {
    pub fn a5_two_sum_less_than_k(nums: own Vec[i32], k: i32) -> i32 {
        let mut nums = nums;
        nums.sort();
        let mut (i, j) = (0, nums.len() - 1);
        let mut ans: i32 = -1;
        while i < j {
            let s = nums[i] + nums[j];
            if s < k {
                ans = ans.max(s);
                i += 1;
            } else {
                j -= 1;
            }
        }
        ans
    }
}

fn a5_two_sum_less_than_k(nums: Vec[i64], k: i64) -> i64 {
    A5Solution.a5_two_sum_less_than_k(nums.iter().map(|x| x as i32).collect(), k as i32) as i64
}

// ---- the differential -----------------------------------------------------

fn arm(which: i64, nums: Vec[i64], k: i64) -> i64 {
    match which {
        0 => a0_two_sum_less_than_k(nums, k),
        1 => a1_two_sum_less_than_k(nums, k),
        2 => a2_two_sum_less_than_k(nums, k),
        3 => a3_two_sum_less_than_k(nums, k),
        4 => a4_two_sum_less_than_k(nums, k),
        _ => a5_two_sum_less_than_k(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The statement read literally: every pair i < j, the largest sum under
// k, or -1.
fn literal(nums: Vec[i64], k: i64) -> i64 {
    let mut best = -1;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            let s = nums[i] + nums[j];
            if s < k and s > best {
                best = s;
            }
        }
    }
    best
}

struct Problem {
    nums: Vec[i64],
    k: i64,
    rotate: i64,
    shift: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, p: Problem) {
    let nums = p.nums.clone();
    let k = p.k;
    let n = nums.len();
    let want = literal(nums, k);
    // P3: the values in another order, reversed and rotated
    let reordered: Vec[i64] = (0..n).map(|i| nums[(p.rotate + n - 1 - i) % n]).collect();
    // P5: every value moved up by d, as far as 1000 allows
    let top = nums.iter().max().unwrap();
    let d = p.shift % (1000 - top + 1);
    let moved: Vec[i64] = nums.iter().map(|x| x + d).collect();
    // P4: the two largest values and the two smallest, by sorting
    let mut sorted = nums.clone();
    sorted.sort();
    let (largest, smallest) = if n < 2 { (-1, -1) } else { (sorted[n - 1] + sorted[n - 2], sorted[0] + sorted[1]) };
    // P6: the values twice over
    let mut twice = nums.clone();
    twice.extend(nums.clone());
    // every sum of two values at different places, for P2
    let mut sums: SortedSet[i64] = SortedSet.new();
    for i in 0..n {
        for j in i + 1..n {
            sums.insert(nums[i] + nums[j]);
        }
    }
    for w in 0..6 {
        let answer = arm(w, nums, k);
        let what = f"arm {w}, k {k}, {n} values -> {answer}";
        // P1: the statement read literally
        expect(mut t, 1, answer == want, f"P1 {what}, every pair gives {want}");
        // P2: an answer is under k and is the sum of two of the values at
        // different places
        let made = answer == -1 or (answer < k and sums.contains(answer));
        expect(mut t, 2, made, f"P2 {what}");
        // P3: another order
        let r = arm(w, reordered, k);
        expect(mut t, 3, r == answer, f"P3 {what}, reordered -> {r}");
        // P4: a found answer a is found again under a + 1, and under a
        // something smaller is; none found stays none under k - 1. Above
        // every sum the answer is the two largest values, and one above the
        // two smallest it is those two.
        let ok = if answer >= 0 {
            arm(w, nums, answer + 1) == answer and arm(w, nums, answer) < answer
        } else {
            k == 1 or arm(w, nums, k - 1) == -1
        };
        let ends = arm(w, nums, 2001) == largest and arm(w, nums, smallest + 1) == smallest;
        expect(mut t, 4, ok and ends, f"P4 {what}");
        // P5: every value moved up by d, and k by 2d
        let m = arm(w, moved, k + 2 * d);
        expect(mut t, 5, m == if answer < 0 { -1 } else { answer + 2 * d }, f"P5 {what}, moved up {d} -> {m}");
        // P6: the values twice over never do worse, and a value that pairs
        // with nothing under k (k - 1, when that is a value) changes nothing
        let tw = arm(w, twice, k);
        let mut more = nums.clone();
        more.push(k - 1);
        let same = k < 2 or k > 1001 or arm(w, more, k) == answer;
        expect(mut t, 6, tw >= answer and same, f"P6 {what}, twice over -> {tw}");
    }
    t.cases += 1;
    t.check = (t.check * 31 + want + 1) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: [0; 7].to_vec() };
    // 2000 problems in four kinds, 500 each: 1 to 40 values from 1 to
    // 1000 and k from 1 to 2000; 1 to 6 values from 1 to 5, k from 1 to
    // 12; 2 to 20 copies of one value, k around twice it; and 2 to 30
    // values with k one of their pair sums, or one more. Every choice is
    // drawn before any arm answers.
    let mut seed = 10991;
    let mut problems: Vec[Problem] = [];
    for i in 0..2000 {
        let (nums, k) = match i % 4 {
            0 => {
                let n = next_random(mut seed) % 40 + 1;
                let v: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 1000 + 1).collect();
                (v, next_random(mut seed) % 2000 + 1)
            }
            1 => {
                let n = next_random(mut seed) % 6 + 1;
                let v: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 5 + 1).collect();
                (v, next_random(mut seed) % 12 + 1)
            }
            2 => {
                let n = next_random(mut seed) % 19 + 2;
                let x = next_random(mut seed) % 1000 + 1;
                (Vec.filled(n, x), 2 * x + next_random(mut seed) % 3 - 1)
            }
            _ => {
                let n = next_random(mut seed) % 29 + 2;
                let v: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 1000 + 1).collect();
                let a = next_random(mut seed) % n;
                let b = (a + 1 + next_random(mut seed) % (n - 1)) % n;
                let k = v[a] + v[b] + next_random(mut seed) % 2;
                (v, k)
            }
        };
        let rotate = next_random(mut seed);
        let shift = next_random(mut seed);
        problems.push(Problem { nums, k, rotate, shift });
    }
    for p in problems.iter() {
        check_case(mut t, p);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
