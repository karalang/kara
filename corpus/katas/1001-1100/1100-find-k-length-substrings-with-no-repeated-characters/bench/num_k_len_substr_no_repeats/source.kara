// Benchmark: LeetCode #1100 Find K-Length Substrings With No Repeated
// Characters -- the ★ arm, a sliding window with a count of each letter.
// 64 texts of 10^4 letters, LeetCode's longest, from the first 8 to 26
// letters, are built once; each of 10 rounds changes one letter in every
// text and counts its substrings for 4 values of k from 1 to 30, folding
// the counts into a checksum. Mirrors
// num_k_len_substr_no_repeats.rs, .c, .py and go-seq/.

fn num_k_len_substr_no_repeats(s: String, k: i64) -> i64 {
    let b = s.bytes();
    if k > 26 or k > b.len() {
        return 0;
    }
    let mut count = [0; 26];
    let mut repeated = 0;
    let mut found = 0;
    for i in 0..b.len() {
        let c = (b[i] - b'a') as i64;
        count[c] += 1;
        if count[c] == 2 {
            repeated += 1;
        }
        if i >= k {
            let out = (b[i - k] - b'a') as i64;
            count[out] -= 1;
            if count[out] == 1 {
                repeated -= 1;
            }
        }
        if i >= k - 1 and repeated == 0 {
            found += 1;
        }
    }
    found
}

// ---- the workload ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1100;
    let mut texts: Vec[Vec[char]] = [];
    for j in 0..64 {
        let alphabet = 8 + j % 19;
        texts.push((0..10000).map(|_| (b'a' + (next_random(mut seed) % alphabet) as u8) as char).collect());
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..10 {
        for j in 0..texts.len() {
            let at = (round * 7919 + j * 104729) % 10000;
            texts[j][at] = (b'a' + ((round + j) % 26) as u8) as char;
            let s: String = texts[j].iter().collect();
            for q in 0..4 {
                let k = (round * 7 + j * 3 + q * 11) % 30 + 1;
                let count = num_k_len_substr_no_repeats(s.clone(), k);
                total += count;
                check = (check * 31 + count + 1) % 1000000007;
            }
        }
    }
    println(f"10 rounds over 64 texts of 10^4 letters: {total} substrings, checksum {check}");
}
