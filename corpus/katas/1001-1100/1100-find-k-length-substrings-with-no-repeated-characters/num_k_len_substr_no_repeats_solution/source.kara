// LeetCode #1100: Find K-Length Substrings With No Repeated Characters --
// LeetCode's Rust template, written as Rust writes it and carried to Kāra
// by `karac fix`.

struct Solution {}

impl Solution {
    pub fn num_k_len_substr_no_repeats(s: String, k: i32) -> i32 {
        let s = s.bytes();
        let k = k as i64;
        if k > 26 or k > s.len() {
            return 0;
        }
        let mut cnt = [0; 26];
        let mut ans = 0;
        let mut j = 0;
        for i in 0..s.len() {
            let c = (s[i] - b'a') as i64;
            cnt[c] += 1;
            while cnt[c] > 1 {
                cnt[(s[j] - b'a') as i64] -= 1;
                j += 1;
            }
            if i - j + 1 == k {
                ans += 1;
                cnt[(s[j] - b'a') as i64] -= 1;
                j += 1;
            }
        }
        ans
    }
}

fn num_k_len_substr_no_repeats(s: String, k: i64) -> i64 {
    Solution.num_k_len_substr_no_repeats(s, k as i32) as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters drawn from the first `alphabet`.
fn random_text(seed: mut ref i64, n: i64, alphabet: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % alphabet) as u8) as char);
    }
    s
}

fn main() {
    let cases = [
        ("havefunonleetcode", 5),
        ("home", 5),
        ("a", 1),
        ("aaaa", 1),
        ("aaaa", 2),
        ("abcabc", 3),
        ("abcabc", 4),
        ("abcdefghijklmnopqrstuvwxyz", 26),
        ("abcdefghijklmnopqrstuvwxyza", 27),
        ("abab", 2),
        ("leetcode", 8),
        ("zyxwvutsrqponmlkjihgfedcbaz", 26),
    ];
    for (s, k) in cases.iter() {
        println(f"{num_k_len_substr_no_repeats(s.to_string(), k)}");
    }
    // 2000 random texts of 1 to 200 letters from 1 to 26, k from 1 to 30
    let mut seed = 1100;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 200 + 1;
        let alphabet = next_random(mut seed) % 26 + 1;
        let text = random_text(mut seed, n, alphabet);
        let k = next_random(mut seed) % 30 + 1;
        let count = num_k_len_substr_no_repeats(text, k);
        total += count;
        check = (check * 31 + count + 1) % 1000000007;
    }
    println(f"2000 random texts: {total} substrings, checksum {check}");
    // 10^4 letters, LeetCode's longest, at every k from 1 to 27, and k of
    // 10^4
    let text = random_text(mut seed, 10000, 26);
    let counts: Vec[String] = (1..=27).map(|k| num_k_len_substr_no_repeats(text.clone(), k).to_string()).collect();
    println(f"10^4 letters, k from 1 to 27: {counts.join(" ")}");
    println(f"10^4 letters, k = 10^4: {num_k_len_substr_no_repeats(text, 10000)}");
}
