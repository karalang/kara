// LeetCode #1002: Find Common Characters -- maps of counts
//
// The first word's letters counted in a `Map`; each next word counted
// in a `Map` of its own, and the answer's map cut down to the letters
// both hold, each at the smaller count. The answer comes out in the
// map's own order, which the problem allows. O(total length).
fn counts(word: ref String) -> Map[char, i64] {
    let mut m: Map[char, i64] = Map.new();
    for c in word.chars() {
        *m.entry(c).or_insert(0) += 1;
    }
    m
}

fn common_chars(words: ref Vec[String]) -> Vec[String] {
    let mut common = counts(words[0]);
    for w in 1..words.len() {
        let next = counts(words[w]);
        let mut kept: Map[char, i64] = Map.new();
        for (c, k) in common.iter() {
            let there = next.get(*c).unwrap_or(0);
            if there > 0 {
                kept.insert(*c, (*k).min(there));
            }
        }
        common = kept;
    }
    let mut ans: Vec[String] = Vec.new();
    for (c, k) in common.iter() {
        for _ in 0..*k {
            ans.push(f"{c}");
        }
    }
    ans
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// up to `most` words of up to `longest` letters, the letters drawn from
// the first `letters` of the alphabet, at least 1 of each
fn random_words(most: i64, longest: i64, letters: i64, seed: mut ref i64) -> Vec[String] {
    let count = 1 + next_random(mut seed) % most;
    let alphabet = 1 + next_random(mut seed) % letters;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        let mut word = String.new();
        for _ in 0..1 + next_random(mut seed) % longest {
            word.push_str(f"{((97 + next_random(mut seed) % alphabet) as u8) as char}");
        }
        words.push(word);
    }
    words
}

fn quoted(xs: ref Vec[String]) -> String {
    let parts: Vec[String] = xs.iter().map(|x| f"\"{x}\"").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[Vec[String]] = vec![
        vec!["bella", "label", "roller"],
        vec!["cool", "lock", "cook"],
        vec!["a"],
        vec!["abc", "def"],
        vec!["aaaa", "aa", "aaa"],
        vec!["zyx", "xyz", "yzx"],
        vec!["abcdefghijklmnopqrstuvwxyz", "zyxwvutsrqponmlkjihgfedcba"],
        vec!["ab", "ba", "ab", "bab", "c"],
        vec!["mississippi", "missouri", "simple"],
        vec!["leetcode", "codeleet", "tecodele", "elee"],
    ].iter().map(|ws| ws.iter().map(|s| s.to_string()).collect()).collect();
    for words in examples.iter() {
        let mut ans = common_chars(words);
        ans.sort();
        println(f"words = {quoted(words)} -> {quoted(ans)}");
    }
    // LeetCode's largest: 100 words of 100 letters
    let mut big: Vec[Vec[String]] = Vec.new();
    big.push((0..100).map(|_| "a".repeat(100)).collect());
    big.push((0..100).map(|i| if i == 99 { "b".repeat(100) } else { "a".repeat(100) }).collect());
    // word i runs through the alphabet from its i-th letter, so each word
    // holds every letter 3 or 4 times
    big.push((0..100).map(|i| {
        let word: String = (0..100).map(|j| ((97 + (i + j) % 26) as u8) as char).collect();
        word
    }).collect());
    for words in big.iter() {
        let mut ans = common_chars(words);
        ans.sort();
        println(f"100 words of 100 letters -> {ans.len()} common letters \"{ans.join("")}\"");
    }
    let mut seed = 1002;
    let groups: Vec[(i64, i64, i64, i64)] = vec![
        (300, 3, 5, 3),
        (3000, 10, 20, 6),
        (300, 100, 100, 26),
    ];
    for (count, most, longest, letters) in groups.iter() {
        let mut total = 0;
        let mut found = 0;
        let mut check = 0;
        for _ in 0..count {
            let words = random_words(most, longest, letters, mut seed);
            total += words.len();
            let mut ans = common_chars(words);
            ans.sort();
            found += ans.len();
            for s in ans.iter() {
                for c in s.chars() {
                    check = (check * 31 + (c as i64)) % 1000000007;
                }
            }
            check = (check * 31 + 1) % 1000000007;
        }
        println(f"{count} random lists of {total} words: {found} common letters, checksum {check}");
    }
}
