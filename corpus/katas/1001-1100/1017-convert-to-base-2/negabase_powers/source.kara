// LeetCode #1017: Convert to Base -2 -- adding powers of two
//
// 2^k is (-2)^k when k is even, and (-2)^(k+1) + (-2)^k when k is odd:
// "1" or "11" followed by k zeros. Add those forms up for the bits of n
// with base -2 addition, where a column summing to 2 or 3 leaves 0 or 1
// and carries -1 into the next column, and one summing to -1 leaves 1 and
// carries 1. O(log^2 n).

// a + b, both lowest digit first
fn add(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut sum: Vec[i64] = Vec.new();
    let mut carry = 0;
    let mut i = 0;
    while i < a.len() or i < b.len() or carry != 0 {
        let mut column = carry;
        if i < a.len() {
            column += a[i];
        }
        if i < b.len() {
            column += b[i];
        }
        if column >= 2 {
            sum.push(column - 2);
            carry = -1;
        } else if column == -1 {
            sum.push(1);
            carry = 1;
        } else {
            sum.push(column);
            carry = 0;
        }
        i += 1;
    }
    while sum.len() > 0 and sum[sum.len() - 1] == 0 {
        sum.pop();
    }
    sum
}

fn base_neg2(n: i64) -> String {
    let mut total: Vec[i64] = Vec.new();
    let mut rest = n;
    let mut k = 0;
    while rest > 0 {
        if rest % 2 == 1 {
            let mut power: Vec[i64] = Vec.filled(k, 0);
            power.push(1);
            if k % 2 == 1 {
                power.push(1);
            }
            total = add(total, power);
        }
        rest /= 2;
        k += 1;
    }
    if total.is_empty() {
        return "0".to_string();
    }
    let mut form = String.new();
    for d in total.iter().rev() {
        form.push(if d == 1 { '1' } else { '0' });
    }
    form
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// folds a string's digits into a running checksum
fn fold(check: i64, digits: Str) -> i64 {
    let mut c = check;
    for b in digits.bytes().iter() {
        c = (c * 3 + if b == b'1' { 2 } else { 1 }) % 1000000007;
    }
    (c * 3) % 1000000007
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [2, 3, 4, 0, 1, 5, 6, 7, 10, 21, 42, 100, 1365, 1366, 1000000, 999999999, 1000000000];
    for n in examples.iter() {
        println(f"n = {n} -> {base_neg2(n)}");
    }
    // every n up to 20000, then 2000 random n up to 10^9: the digits and
    // ones in all, the longest form and a checksum of the forms in order
    let mut seed = 1017;
    for round in 0..2 {
        let count = if round == 0 { 20001 } else { 2000 };
        let mut digits = 0;
        let mut ones = 0;
        let mut longest = 0;
        let mut check = 0;
        for i in 0..count {
            let n = if round == 0 { i } else { (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001 };
            let form = base_neg2(n);
            digits += form.len();
            for b in form.bytes().iter() {
                if b == b'1' {
                    ones += 1;
                }
            }
            longest = longest.max(form.len());
            check = fold(check, form);
        }
        let label = if round == 0 { "n = 0..20000" } else { "2000 random n up to 10^9" };
        println(f"{label}: {digits} digits, {ones} ones, longest {longest}, checksum {check}");
    }
}
