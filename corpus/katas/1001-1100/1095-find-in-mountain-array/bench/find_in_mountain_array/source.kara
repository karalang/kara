// Benchmark: LeetCode #1095 Find in Mountain Array -- the ★ arm, three
// binary searches through a counted `get`. 64 mountains of 10^4 values,
// LeetCode's longest, are built once, their peaks spread from end to end;
// each of 100 rounds asks every mountain for 64 targets, each a value of
// the mountain or one next to it, and folds the answers and the calls of
// `get` into a checksum. Mirrors find_in_mountain_array.rs, .c, .py and
// go-seq/.

fn find_in_mountain_array(target: i32, mountain: MountainArray) -> i32 {
    let n = mountain.length();
    let mut lo: i32 = 0;
    let mut hi = n - 1;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if mountain.get(mid) < mountain.get(mid + 1) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    let peak = lo;
    lo = 0;
    hi = peak;
    while lo <= hi {
        let mid = (lo + hi) / 2;
        let v = mountain.get(mid);
        if v == target {
            return mid;
        }
        if v < target {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    lo = peak + 1;
    hi = n - 1;
    while lo <= hi {
        let mid = (lo + hi) / 2;
        let v = mountain.get(mid);
        if v == target {
            return mid;
        }
        if v > target {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    -1
}

// ---- the mountain array ---------------------------------------------------

// LeetCode's interface, in `i32` as LeetCode gives it: the array is read only through `get` and `length`,
// and each `get` is counted (more than 100 is a wrong answer).
struct MountainArray {
    values: Vec[i32],
    calls: Atomic[i64],
}

impl MountainArray {
    fn get(self, index: i32) -> i32 {
        self.calls.fetch_add(1);
        self.values[index as i64]
    }

    fn length(self) -> i32 {
        self.values.len() as i32
    }
}

// ---- the workload ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1095;
    let mut mountains: Vec[MountainArray] = [];
    for j in 0..64 {
        let up = 1 + j * 9997 / 63;
        let down = 9999 - up;
        let mut v: Vec[i32] = [(down * 50000 + next_random(mut seed) % 20) as i32];
        for _ in 0..up {
            let last = v[v.len() - 1];
            v.push(last + 1 + (next_random(mut seed) % 50000) as i32);
        }
        for _ in 0..down {
            let last = v[v.len() - 1];
            v.push(last - 1 - (next_random(mut seed) % 50000) as i32);
        }
        mountains.push(MountainArray { values: v, calls: Atomic.new(0) });
    }
    let mut found = 0;
    let mut check = 0;
    for round in 0..100 {
        for m in mountains.iter() {
            for q in 0..64 {
                let k = (round * 7919 + q * 104729) % 10000;
                let target = m.values[k] + ((round + q) % 3) as i32 - 1;
                let at = find_in_mountain_array(target, m);
                if at >= 0 {
                    found += 1;
                }
                check = (check * 31 + at + 1) % 1000000007;
            }
        }
    }
    let calls: i64 = mountains.iter().map(|m| m.calls.load()).sum();
    println(f"100 rounds over 64 mountains of 10^4 values: {found} of 409600 found, {calls} calls of get, checksum {check}");
}
