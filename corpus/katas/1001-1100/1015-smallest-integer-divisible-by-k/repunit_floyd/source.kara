// LeetCode #1015: Smallest Integer Divisible by K -- tortoise and hare
//
// The remainders r' = (10r + 1) mod k, started from the empty repunit's
// r = 0, are eventually periodic. Floyd's two walkers, one twice as fast,
// meet inside the cycle, and walking one on until they meet again
// measures the cycle's length. Some repunit is divisible by k exactly when
// the start, 0, is on the cycle, which is when that many steps from 0 lead
// back to 0, and then the cycle's length is the answer. O(k) time, O(1)
// space.

fn step(r: i64, k: i64) -> i64 {
    (r * 10 + 1) % k
}

fn smallest_repunit_div_by_k(k: i64) -> i64 {
    let mut slow = step(0, k);
    let mut fast = step(step(0, k), k);
    while slow != fast {
        slow = step(slow, k);
        fast = step(step(fast, k), k);
    }
    // the cycle's length
    let mut length = 1;
    let mut probe = step(slow, k);
    while probe != slow {
        probe = step(probe, k);
        length += 1;
    }
    // the start, 0, is on the cycle when `length` steps lead back to it
    let mut ahead = 0;
    for _ in 0..length {
        ahead = step(ahead, k);
    }
    if ahead == 0 {
        length
    } else {
        -1
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [1, 2, 3, 5, 7, 9, 11, 13, 17, 19, 27, 41, 81, 99, 101, 9091, 99989, 99991, 99999, 100000];
    for k in examples.iter() {
        println(f"k = {k} -> {smallest_repunit_div_by_k(k)}");
    }
    // every k up to 10000: how many have no answer, the sum of the others,
    // and a checksum of all the answers in order
    let mut none = 0;
    let mut total = 0;
    let mut check = 0;
    let mut longest = 0;
    let mut longest_k = 0;
    for k in 1..10001 {
        let answer = smallest_repunit_div_by_k(k);
        if answer < 0 {
            none += 1;
        } else {
            total += answer;
            if answer > longest {
                longest = answer;
                longest_k = k;
            }
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"k = 1..10000: {none} with no answer, the rest sum to {total}, longest {longest} at k = {longest_k}, checksum {check}");
    // random k up to 100000
    let mut seed = 1015;
    let mut none = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let k = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
        let answer = smallest_repunit_div_by_k(k);
        if answer < 0 {
            none += 1;
        } else {
            total += answer;
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"1000 random k up to 100000: {none} with no answer, the rest sum to {total}, checksum {check}");
}
