// LeetCode #1015: Smallest Integer Divisible by K -- the remainders seen
//
// Walk the repunits' remainders mod k, r' = (10r + 1) mod k, keeping the
// ones met so far. Reaching 0 answers; meeting a remainder again means the
// walk has closed a cycle without 0, and it never will. Nothing about 2
// and 5 is assumed: the walk finds those cycles too. O(k) expected.

fn smallest_repunit_div_by_k(k: i64) -> i64 {
    let mut seen: Set[i64] = Set.new();
    let mut r = 1 % k;
    let mut length = 1;
    while r != 0 {
        if seen.contains(r) {
            return -1;
        }
        seen.insert(r);
        r = (r * 10 + 1) % k;
        length += 1;
    }
    length
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [1, 2, 3, 5, 7, 9, 11, 13, 17, 19, 27, 41, 81, 99, 101, 9091, 99989, 99991, 99999, 100000];
    for k in examples.iter() {
        println(f"k = {k} -> {smallest_repunit_div_by_k(k)}");
    }
    // every k up to 10000: how many have no answer, the sum of the others,
    // and a checksum of all the answers in order
    let mut none = 0;
    let mut total = 0;
    let mut check = 0;
    let mut longest = 0;
    let mut longest_k = 0;
    for k in 1..10001 {
        let answer = smallest_repunit_div_by_k(k);
        if answer < 0 {
            none += 1;
        } else {
            total += answer;
            if answer > longest {
                longest = answer;
                longest_k = k;
            }
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"k = 1..10000: {none} with no answer, the rest sum to {total}, longest {longest} at k = {longest_k}, checksum {check}");
    // random k up to 100000
    let mut seed = 1015;
    let mut none = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let k = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
        let answer = smallest_repunit_div_by_k(k);
        if answer < 0 {
            none += 1;
        } else {
            total += answer;
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"1000 random k up to 100000: {none} with no answer, the rest sum to {total}, checksum {check}");
}
