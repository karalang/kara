// Benchmark: LeetCode #1007 Minimum Domino Rotations For Equal Row -- the
// ★ arm, two candidates, on rows of 20000 dominoes, LeetCode's longest.
// Mirrors min_rotations.c, .rs, .py and go-seq/.

fn min_domino_rotations(tops: ref Vec[i64], bottoms: ref Vec[i64]) -> i64 {
    let a = rotations(tops, bottoms, tops[0]);
    let b = rotations(tops, bottoms, bottoms[0]);
    if a == -1 {
        b
    } else if b == -1 {
        a
    } else {
        a.min(b)
    }
}

fn rotations(tops: ref Vec[i64], bottoms: ref Vec[i64], v: i64) -> i64 {
    let mut to_top = 0;
    let mut to_bottom = 0;
    for i in 0..tops.len() {
        if tops[i] != v and bottoms[i] != v {
            return -1;
        }
        if tops[i] != v {
            to_top += 1;
        } else if bottoms[i] != v {
            to_bottom += 1;
        }
    }
    to_top.min(to_bottom)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 400;
    let n = 20000;
    let mut seed = 1007;
    // 20 rows of 20000 dominoes with faces 1 to 6; in row t every domino
    // shows face t % 6 + 1 on a random half, except in the odd rows, where
    // one domino in 2000 is left as drawn
    let mut all_tops: Vec[Vec[i64]] = Vec.new();
    let mut all_bottoms: Vec[Vec[i64]] = Vec.new();
    for t in 0..20 {
        let target = t % 6 + 1;
        let mut tops: Vec[i64] = Vec.new();
        let mut bottoms: Vec[i64] = Vec.new();
        for _ in 0..n {
            let mut top = 1 + next_random(mut seed) % 6;
            let mut bottom = 1 + next_random(mut seed) % 6;
            if t % 2 == 0 or next_random(mut seed) % 2000 != 0 {
                if next_random(mut seed) % 2 == 0 {
                    top = target;
                } else {
                    bottom = target;
                }
            }
            tops.push(top);
            bottoms.push(bottom);
        }
        all_tops.push(tops);
        all_bottoms.push(bottoms);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..20 {
            let t = (r + i) % 20;
            let got = min_domino_rotations(all_tops[t], all_bottoms[t]);
            total += got;
            check = (check * 31 + got + 2) % 1000000007;
        }
    }
    println(f"{rounds} rounds over 20 rows of {n} dominoes: answers sum to {total}, checksum {check}");
}
