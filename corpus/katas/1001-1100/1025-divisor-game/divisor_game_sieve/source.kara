// LeetCode #1025: Divisor Game -- a sieve of divisors
//
// List every move from every number up to n at once, from the divisor's
// side: `x` is a move from each of its multiples `2x, 3x, ...`. Then
// fill the table of winners from 2 up: the player to move at `m` wins
// when any of its moves leads to a losing number. O(n log n).

fn divisor_game(n: i64) -> bool {
    let mut divisors: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for x in 1..n / 2 + 1 {
        let mut m = 2 * x;
        while m <= n {
            divisors[m].push(x);
            m += x;
        }
    }
    let mut wins: Vec[bool] = Vec.filled(n + 1, false);
    for m in 2..n + 1 {
        wins[m] = divisors[m].iter().any(|x| not wins[m - x]);
    }
    wins[n]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    for n in vec![2, 3] {
        println(f"n = {n} -> {divisor_game(n)}");
    }
    // the winner for every n from 1 to 60, A for Alice and B for Bob
    let mut line = String.new();
    for n in 1..61 {
        line.push(if divisor_game(n) { 'A' } else { 'B' });
    }
    println(f"n = 1 to 60: {line}");
    // random games: how many Alice wins, and a checksum
    let mut seed = 1025;
    let groups: Vec[(i64, i64)] = vec![(500, 10), (300, 50), (200, 100), (60, 300), (20, 600), (10, 1000)];
    for (count, top) in groups.iter() {
        let mut wins = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = 1 + next_random(mut seed) % top;
            let alice = divisor_game(n);
            if alice {
                wins += 1;
            }
            check = (check * 131 + n * 2 + if alice { 1 } else { 0 }) % 1000000007;
        }
        println(f"{count} games, n up to {top}: Alice wins {wins}, checksum {check}");
    }
    // the largest n LeetCode allows
    println(f"n = 1000 -> {divisor_game(1000)}, n = 999 -> {divisor_game(999)}");
}
