// LeetCode #1043: Partition Array for Maximum Sum -- differential
//
// The five arms, copied here under their own names, against every
// partition tried in turn, and four properties of the answer.

// ---- bottom-up over the prefixes (partition_max.kara)

fn table_arm(arr: ref Vec[i64], k: i64) -> i64 {
    let n = arr.len();
    let mut best = Vec.filled(n + 1, 0);
    for i in 1..n + 1 {
        let mut largest = 0;
        let mut j = 1;
        while j <= k and j <= i {
            largest = largest.max(arr[i - j]);
            best[i] = best[i].max(best[i - j] + largest * j);
            j += 1;
        }
    }
    best[n]
}

// ---- top-down with a memo (partition_max_memo.kara)

fn memo_most(arr: ref Vec[i64], k: i64, i: i64, memo: mut ref Vec[Option[i64]]) -> i64 {
    if i == arr.len() {
        return 0;
    }
    if let Some(known) = memo[i] {
        return known;
    }
    let mut largest = 0;
    let mut answer = 0;
    for j in 1..k + 1 {
        if i + j > arr.len() {
            break;
        }
        largest = largest.max(arr[i + j - 1]);
        answer = answer.max(largest * j + memo_most(arr, k, i + j, mut memo));
    }
    memo[i] = Some(answer);
    answer
}

fn memo_arm(arr: ref Vec[i64], k: i64) -> i64 {
    let mut memo: Vec[Option[i64]] = Vec.filled(arr.len(), None);
    memo_most(arr, k, 0, mut memo)
}

// ---- a ring of k + 1 entries (partition_max_ring.kara)

fn ring_arm(arr: ref Vec[i64], k: i64) -> i64 {
    let size = k + 1;
    let mut ring = Vec.filled(size, 0);
    for i in 1..arr.len() + 1 {
        let mut largest = 0;
        let mut here = 0;
        for j in 1..k.min(i) + 1 {
            largest = largest.max(arr[i - j]);
            here = here.max(ring[(i - j) % size] + largest * j);
        }
        ring[i % size] = here;
    }
    ring[arr.len() % size]
}

// ---- pushing forward (partition_max_forward.kara)

fn forward_arm(arr: ref Vec[i64], k: i64) -> i64 {
    let n = arr.len();
    let mut best = Vec.filled(n + 1, 0);
    for i in 0..n {
        let mut largest = 0;
        for j in 1..k + 1 {
            if i + j > n {
                break;
            }
            largest = largest.max(arr[i + j - 1]);
            let offer = best[i] + largest * j;
            if offer > best[i + j] {
                best[i + j] = offer;
            }
        }
    }
    best[n]
}

// ---- iterator adaptors (partition_max_iter.kara)

fn iter_arm(arr: ref Vec[i64], k: i64) -> i64 {
    let n = arr.len();
    let mut best: Vec[i64] = [0];
    for i in 1..n + 1 {
        let here = (1..k.min(i) + 1).map(|j| best[i - j] + arr[i - j..i].iter().max().unwrap() * j).max().unwrap();
        best.push(here);
    }
    best[n]
}

// ---- every partition tried in turn

// Each of the n - 1 gaps between values is a cut or not; a set of cuts
// whose parts are all at most k long is a partition, worth the sum over
// its parts of the part's length times its largest value. O(2^n n).
fn every_partition(arr: ref Vec[i64], k: i64) -> i64 {
    let n = arr.len();
    let mut answer = 0;
    for cuts in 0..1 << (n - 1) {
        let mut worth = 0;
        let mut start = 0;
        let mut fits = true;
        for end in 1..n + 1 {
            if end == n or (cuts >> (end - 1)) & 1 == 1 {
                if end - start > k {
                    fits = false;
                }
                let mut largest = 0;
                for x in start..end {
                    largest = largest.max(arr[x]);
                }
                worth += largest * (end - start);
                start = end;
            }
        }
        if fits {
            answer = answer.max(worth);
        }
    }
    answer
}

// ---- the checks

fn arm(a: i64, arr: ref Vec[i64], k: i64) -> i64 {
    match a {
        0 => table_arm(arr, k),
        1 => memo_arm(arr, k),
        2 => ring_arm(arr, k),
        3 => forward_arm(arr, k),
        _ => iter_arm(arr, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_array(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1));
    }
    arr
}

struct Tally {
    cases: i64,
    tried: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// Every check on one array and k; `try_all` says whether to try every
// partition too.
fn check_case(t: mut ref Tally, arr: ref Vec[i64], k: i64, try_all: bool, seed: mut ref i64) {
    let n = arr.len();
    let answers: Vec[i64] = (0..5).map(|a| arm(a, arr, k)).collect();
    let want = if try_all { Some(every_partition(arr, k)) } else { None };
    let mut total = 0;
    let mut top = 0;
    for x in arr.iter() {
        total += x;
        top = top.max(x);
    }
    let mut reversed = arr.clone();
    reversed.reverse();
    // a second array, put after this one
    let other = random_array(next_random(mut seed) % 6 + 1, 9, mut seed);
    let mut joined = arr.clone();
    for x in other.iter() {
        joined.push(x);
    }
    for a in 0..5 {
        let answer = answers[a];
        let what = f"arm {a}, {arr}, k = {k}";
        if let Some(w) = want {
            expect(mut t, 1, answer == w, f"P1 {what}: {answer} vs every partition {w}");
        }
        let bounds = total <= answer and answer <= n * top and (k > 1 or answer == total) and (k < n or answer == n * top);
        expect(mut t, 2, bounds, f"P2 {what}: {answer} outside sum {total} to n * max {n * top}");
        if k < n {
            let wider = arm(a, arr, k + 1);
            expect(mut t, 3, wider >= answer, f"P3 {what}: k + 1 gives less, {wider}");
        }
        expect(mut t, 4, arm(a, reversed, k) == answer, f"P4 {what} reversed");
        let apart = answer + arm(a, other, k);
        let together = arm(a, joined, k);
        expect(mut t, 5, together >= apart, f"P5 {what} then {other}: {together} under {apart}");
        let mut agree = 0;
        for o in 0..5 {
            if o != a and answers[o] == answer {
                agree += 1;
            }
        }
        expect(mut t, 6, agree >= 2, f"P6 {what}: agrees with {agree}");
    }
    if try_all {
        t.tried += 1;
    }
    t.cases += 1;
    t.check = (t.check * 131 + answers[0] % 1000000007) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, tried: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    let mut seed = 10431;
    // every array of 1 to 5 values from 0 to 3, with every k
    for n in 1..6 {
        let mut count = 1;
        for _ in 0..n {
            count *= 4;
        }
        for code in 0..count {
            let mut arr: Vec[i64] = Vec.new();
            let mut c = code;
            for _ in 0..n {
                arr.push(c % 4);
                c /= 4;
            }
            for k in 1..n + 1 {
                check_case(mut t, arr, k, true, mut seed);
            }
        }
    }
    // 1000 random arrays of 6 to 10 values, every partition tried, and
    // 200 of 11 to 60, too long to try them all
    for c in 0..1200 {
        let n = if c < 1000 { next_random(mut seed) % 5 + 6 } else { next_random(mut seed) % 50 + 11 };
        let top = if c % 2 == 0 { 9 } else { 1000000000 };
        let arr = random_array(n, top, mut seed);
        let k = next_random(mut seed) % n + 1;
        check_case(mut t, arr, k, c < 1000, mut seed);
    }
    println(f"{t.cases} cases ({t.tried} with every partition tried): checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
