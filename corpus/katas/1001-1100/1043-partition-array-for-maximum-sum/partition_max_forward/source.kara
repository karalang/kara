// LeetCode #1043: Partition Array for Maximum Sum -- pushing forward from
// each prefix.
//
// The same table as partition_max.kara filled the other way: once the
// best for the first i values is known, each part that could start at i,
// j values long, offers best[i] + j * its largest to best[i + j]. Every
// entry has had all its offers by the time the sweep reaches it.
// O(n k) time, O(n) space.

fn max_sum_after_partitioning(arr: ref Vec[i64], k: i64) -> i64 {
    let n = arr.len();
    let mut best = Vec.filled(n + 1, 0);
    for i in 0..n {
        let mut largest = 0;
        for j in 1..k + 1 {
            if i + j > n {
                break;
            }
            largest = largest.max(arr[i + j - 1]);
            let offer = best[i] + largest * j;
            if offer > best[i + j] {
                best[i + j] = offer;
            }
        }
    }
    best[n]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], i64)] = [
        ([1, 15, 7, 9, 2, 5, 10], 3),
        ([1, 4, 1, 5, 7, 3, 6, 1, 9, 9, 3], 4),
        ([1], 1),
        ([1, 15, 7, 9, 2, 5, 10], 1),
        ([1, 15, 7, 9, 2, 5, 10], 7),
        ([9, 8, 7, 6, 5, 4, 3, 2, 1], 2),
        ([1, 2, 3, 4, 5, 6, 7, 8, 9], 2),
        ([5, 5, 5, 5, 5], 3),
        ([0, 0, 0, 1000000000, 0, 0, 0], 4),
        ([3, 1, 3, 1, 3, 1, 3], 2),
    ];
    for (arr, k) in examples.iter() {
        println(f"{arr}, k = {k} -> {max_sum_after_partitioning(arr, k)}");
    }
    // every array of 1 to 6 values from 0 to 3, with every k
    for n in 1..7 {
        let mut count = 1;
        for _ in 0..n {
            count *= 4;
        }
        let mut cases = 0;
        let mut total = 0;
        let mut check = 0;
        for code in 0..count {
            let mut arr: Vec[i64] = Vec.new();
            let mut c = code;
            for _ in 0..n {
                arr.push(c % 4);
                c /= 4;
            }
            for k in 1..n + 1 {
                let answer = max_sum_after_partitioning(arr, k);
                cases += 1;
                total += answer;
                check = (check * 131 + answer) % 1000000007;
            }
        }
        println(f"all {count} arrays of {n}, every k: {cases} cases, sum {total}, checksum {check}");
    }
    // 300 random arrays of 1 to 100 values up to 10^9
    let mut seed = 1043;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 100 + 1;
        let k = next_random(mut seed) % n + 1;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001);
        }
        let answer = max_sum_after_partitioning(arr, k);
        total += answer;
        check = (check * 131 + answer % 1000000007) % 1000000007;
    }
    println(f"300 random arrays: sum {total}, checksum {check}");
    // the largest: 500 values of 10^9, and 500 rising values with k = 500
    let top = Vec.filled(500, 1000000000);
    println(f"500 x 10^9, k = 1: {max_sum_after_partitioning(top, 1)}");
    let rising: Vec[i64] = (0..500).collect();
    println(f"0 to 499, k = 500: {max_sum_after_partitioning(rising, 500)}");
}
