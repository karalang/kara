// LeetCode #1043: Partition Array for Maximum Sum -- bench. The
// bottom-up table of ../partition_max.kara.
//
// best[i] is the most the first i values can sum to. The last part of
// the first i values is some j of them, 1 to k, and becomes j copies of
// their largest, so best[i] is the largest best[i - j] + j * that value.
// Growing j one value at a time keeps the largest as a running maximum.
// O(n k) time, O(n) space.

fn max_sum_after_partitioning(arr: ref Vec[i64], k: i64) -> i64 {
    let n = arr.len();
    let mut best = Vec.filled(n + 1, 0);
    for i in 1..n + 1 {
        let mut largest = 0;
        let mut j = 1;
        while j <= k and j <= i {
            largest = largest.max(arr[i - j]);
            best[i] = best[i].max(best[i - j] + largest * j);
            j += 1;
        }
    }
    best[n]
}

// ---- bench -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 400;
    let n = 500;
    let rounds = 40;
    let mut seed = 1043;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut ks: Vec[i64] = Vec.new();
    for _ in 0..count {
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001);
        }
        arrays.push(arr);
        ks.push(next_random(mut seed) % 50 + 1);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for a in 0..count {
            let answer = max_sum_after_partitioning(arrays[a], ks[a]);
            total += answer;
            check = (check * 131 + answer % 1000000007) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: total {total}, checksum {check}");
}
