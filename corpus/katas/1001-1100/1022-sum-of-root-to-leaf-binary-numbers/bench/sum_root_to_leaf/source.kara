// LeetCode #1022: Sum of Root To Leaf Binary Numbers -- bench
//
// The ★ arm (../sum_root_to_leaf.kara) on 200 random trees of 1 to 1,000
// nodes (LeetCode's sizes), no more than 31 deep, built once and each
// answered 500 times, folding the answers into a sum and a checksum. See
// ../README.md § Benchmarks.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn sum_root_to_leaf(root: Option[TreeNode]) -> i64 {
    sum_from(root, 0)
}

fn sum_from(node: Option[TreeNode], above: i64) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let value = above * 2 + n.val;
            if n.left.is_none() and n.right.is_none() {
                value
            } else {
                sum_from(n.left, value) + sum_from(n.right, value)
            }
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random tree of `n` nodes no more than 31 deep, each new node hung at
// the end of a random walk down from the root
fn random_tree(seed: mut ref i64, n: i64) -> Option[TreeNode] {
    let root = TreeNode { val: next_random(mut seed) % 2, left: None, right: None };
    let mut placed = 1;
    while placed < n {
        let mut node = root;
        let mut level = 1;
        loop {
            let go_left = next_random(mut seed) % 2 == 0;
            let next = if go_left { node.left } else { node.right };
            match next {
                Some(child) => {
                    node = child;
                    level += 1;
                    if level == 31 {
                        break;
                    }
                }
                None => {
                    let leaf = TreeNode { val: next_random(mut seed) % 2, left: None, right: None };
                    if go_left {
                        node.left = Some(leaf);
                    } else {
                        node.right = Some(leaf);
                    }
                    placed += 1;
                    break;
                }
            }
        }
    }
    Some(root)
}

fn main() {
    let count = 200;
    let rounds = 500;
    let mut seed = 1022;
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    let mut nodes = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % 1000 + 1;
        nodes += n;
        trees.push(random_tree(mut seed, n));
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for tree in trees.iter() {
            let answer = sum_root_to_leaf(tree);
            total += answer;
            check = (check * 31 + answer) % 1000000007;
        }
    }
    println(f"{count} trees, {nodes} nodes, {rounds} rounds: sum {total}, checksum {check}");
}
