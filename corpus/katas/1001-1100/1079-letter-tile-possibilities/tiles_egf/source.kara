// LeetCode #1079: Letter Tile Possibilities -- a table over lengths, one
// letter at a time: `ways[n]` is how many sequences of length `n` the
// letters so far make. Adding a letter with `c` tiles, a sequence of
// length `n + k` with `k` of the new letter is one of `ways[n]` with the
// `k` new tiles put in `C(n + k, k)` ways among its places.
// O(26 * n^2).

fn binomial(n: i64, k: i64) -> i64 {
    let mut result = 1;
    for i in 0..k {
        result = result * (n - i) / (i + 1);
    }
    result
}

fn num_tile_possibilities(tiles: String) -> i64 {
    let mut counts = [0; 26];
    for b in tiles.bytes() {
        counts[b - b'A'] += 1;
    }
    let n = tiles.len();
    let mut ways = Vec.filled(n + 1, 0);
    ways[0] = 1;
    let mut longest = 0;
    for letter in 0..26 {
        let c = counts[letter];
        if c == 0 {
            continue;
        }
        let mut next = Vec.filled(n + 1, 0);
        for len in 0..=longest {
            for k in 0..=c {
                next[len + k] += ways[len] * binomial(len + k, k);
            }
        }
        ways = next;
        longest += c;
    }
    ways.iter().skip(1).sum()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` tiles over the first `k` letters.
fn random_tiles(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'A' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

fn main() {
    // LeetCode's examples, then a few more
    let examples = ["AAB", "AAABBC", "V", "AB", "ABC", "AAAAAAA", "ABCDEFG", "AABBCCD", "ZZYYX", "QQQQQQZ"];
    for tiles in examples.iter() {
        println(f"{tiles} -> {num_tile_possibilities(tiles)}");
    }
    let mut seed = 1079;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 7 + 1;
        let k = next_random(mut seed) % 7 + 1;
        let tiles = random_tiles(n, k, mut seed);
        let count = num_tile_possibilities(tiles);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"300 random tile sets: {total} sequences in all, checksum {check}");
    // every set of 1 to 4 tiles over A to C, as a multiset
    let mut sets = 0;
    let mut all = 0;
    for n in 1..5 {
        for code in 0..3.pow(n as u32) {
            let mut tiles = String.new();
            let mut rest = code;
            let mut last = 0;
            let mut sorted = true;
            for _ in 0..n {
                let letter = rest % 3;
                if letter < last {
                    sorted = false;
                }
                last = letter;
                tiles.push((b'A' + letter as u8) as char);
                rest /= 3;
            }
            if sorted {
                sets += 1;
                all += num_tile_possibilities(tiles);
            }
        }
    }
    println(f"every multiset of 1 to 4 tiles over A to C: {sets} sets, {all} sequences");
}
