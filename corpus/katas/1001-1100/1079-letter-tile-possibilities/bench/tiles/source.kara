// LeetCode #1079 bench: the ★ arm (../tiles.kara) over 200 sets of 7
// tiles built once, over 1 to 7 letters drawn from the alphabet, each
// counted once a round in an order that changes with the round.

fn sequences(counts: mut ref Array[i64, 26]) -> i64 {
    let mut total = 0;
    for letter in 0..26 {
        if counts[letter] > 0 {
            counts[letter] -= 1;
            total += 1 + sequences(mut counts);
            counts[letter] += 1;
        }
    }
    total
}

fn num_tile_possibilities(tiles: String) -> i64 {
    let mut counts = [0; 26];
    for b in tiles.bytes() {
        counts[b - b'A'] += 1;
    }
    sequences(mut counts)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 200;
    let mut seed = 1079;
    let mut sets: Vec[String] = [];
    for _ in 0..200 {
        let d = next_random(mut seed) % 7 + 1;
        let mut alphabet: Vec[u8] = [];
        while alphabet.len() < d {
            let c = b'A' + (next_random(mut seed) % 26) as u8;
            if not alphabet.contains(c) {
                alphabet.push(c);
            }
        }
        let mut tiles = String.new();
        for _ in 0..7 {
            tiles.push(alphabet[next_random(mut seed) % d] as char);
        }
        sets.push(tiles);
    }
    let n = sets.len();
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for j in 0..n {
            let count = num_tile_possibilities(sets[(j * 7 + r) % n]);
            total += count;
            check = (check * 31 + count) % 1000000007;
        }
    }
    println(f"{rounds} rounds of {n} sets of 7 tiles: {total} sequences, checksum {check}");
}
