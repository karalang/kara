// LeetCode #1081: Smallest Subsequence of Distinct Characters -- one
// letter at a time, from bitmasks of what is still to come: `ahead[i]`
// holds a bit for every letter at or after place `i`. The next letter
// is the smallest not yet taken whose next place still has every letter
// not yet taken at or after it. O(26^2 n).

fn smallest_subsequence(s: Str) -> String {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut ahead: Vec[u32] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        ahead[i] = ahead[i + 1] | 1 << (bytes[i] - b'a') as u32;
    }
    let mut taken: u32 = 0;
    let mut at = 0;
    let mut out = String.new();
    while taken != ahead[0] {
        let wanted = ahead[0] & ~taken;
        for k in 0..26 {
            let bit: u32 = 1 << k;
            if wanted & bit == 0 {
                continue;
            }
            let mut j = at;
            while bytes[j] - b'a' != k as u8 {
                j += 1;
            }
            if ahead[j] & wanted == wanted {
                taken |= bit;
                out.push(bytes[j] as char);
                at = j + 1;
                break;
            }
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first k of the alphabet.
fn random_text(seed: mut ref i64, n: i64, k: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

fn fold(h: i64, text: Str) -> i64 {
    let mut h = h;
    for b in text.bytes() {
        h = (h * 131 + b) % 1000000007;
    }
    h
}

fn main() {
    let cases = [
        "bcabc",
        "cbacdcbc",
        "a",
        "aaaa",
        "abcabc",
        "cba",
        "bcac",
        "leetcode",
        "zyxzyxzyx",
        "ecbacba",
        "abacb",
        "thesqtitxyetpxloeevdeqifkz",
    ];
    for s in cases.iter() {
        println(f"{s} -> {smallest_subsequence(s)}");
    }
    // 300 random strings of 1 to 1000 letters over the first 1 to 26 letters
    let mut seed = 1081;
    let mut h = 0;
    let mut total = 0;
    for t in 0..300 {
        let n = next_random(mut seed) % 1000 + 1;
        let k = t % 26 + 1;
        let out = smallest_subsequence(random_text(mut seed, n, k));
        total += out.len();
        h = fold(h, out);
    }
    println(f"300 random strings: {total} letters kept, checksum {h}");
    // 1000 letters, the alphabet backwards over and over: each letter
    // of the answer comes from a later run than the one before it
    let mut long = String.new();
    for i in 0..1000 {
        long.push((b'z' - (i % 26) as u8) as char);
    }
    println(f"1000 letters, the alphabet backwards -> {smallest_subsequence(long)}");
}
