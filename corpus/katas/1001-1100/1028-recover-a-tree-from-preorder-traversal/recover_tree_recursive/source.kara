// LeetCode #1028: Recover a Tree From Preorder Traversal -- recursive descent
//
// Parse the string as the grammar it is: a subtree at depth `d` is `d`
// dashes, a number, then the subtrees of its left and right child at
// depth `d + 1`, each present only if the dashes that come next number
// exactly `d + 1`. One position into the string is shared by every call.
// O(n).

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn recover_from_preorder(traversal: Str) -> Option[TreeNode] {
    let mut at = 0;
    subtree(traversal, mut at, 0)
}

fn subtree(traversal: Str, at: mut ref i64, depth: i64) -> Option[TreeNode] {
    let bytes = traversal.bytes();
    let mut dashes = 0;
    while *at + dashes < bytes.len() and bytes[*at + dashes] == 45 {
        dashes += 1;
    }
    if *at + dashes >= bytes.len() or dashes != depth {
        return None;
    }
    *at += dashes;
    let mut value = 0;
    while *at < bytes.len() and bytes[*at] != 45 {
        value = value * 10 + (bytes[*at] - 48) as i64;
        *at += 1;
    }
    let node = TreeNode { val: value, left: None, right: None };
    node.left = subtree(traversal, mut at, depth + 1);
    node.right = subtree(traversal, mut at, depth + 1);
    Some(node)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random value from 1 to `top`, from two draws of 15 bits
fn random_value(seed: mut ref i64, top: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1
}

// a random tree of `n` nodes in which a node with one child has it on the
// left: each new node walks down from the root, and becomes the left child
// of the first node it meets without one, or, with probability 1/2, the
// right child of a node that has a left child and no right one
fn random_tree(seed: mut ref i64, n: i64, top: i64) -> TreeNode {
    let root = TreeNode { val: random_value(mut seed, top), left: None, right: None };
    let mut placed = 1;
    while placed < n {
        let leaf = TreeNode { val: random_value(mut seed, top), left: None, right: None };
        let mut node = root;
        loop {
            match node.left {
                None => {
                    node.left = Some(leaf);
                    break;
                }
                Some(l) => {
                    if next_random(mut seed) % 2 == 0 {
                        node = l;
                    } else {
                        match node.right {
                            None => {
                                node.right = Some(leaf);
                                break;
                            }
                            Some(r) => {
                                node = r;
                            }
                        }
                    }
                }
            }
        }
        placed += 1;
    }
    root
}

// the traversal the problem starts from: each node as `depth` dashes
// followed by its value, in preorder
fn traversal(node: Option[TreeNode], depth: i64, out: mut ref String) {
    if let Some(n) = node {
        for _ in 0..depth {
            out.push('-');
        }
        out.push_str(f"{n.val}");
        traversal(n.left, depth + 1, mut out);
        traversal(n.right, depth + 1, mut out);
    }
}

// LeetCode's level order: every node's children in turn, `null` for a
// missing one, with trailing nulls left off
fn level_order(root: Option[TreeNode]) -> String {
    let mut items: Vec[String] = Vec.new();
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    while let Some(entry) = queue.pop_front() {
        match entry {
            None => items.push("null".to_string()),
            Some(n) => {
                items.push(f"{n.val}");
                queue.push_back(n.left);
                queue.push_back(n.right);
            }
        }
    }
    while items.len() > 0 and items[items.len() - 1] == "null" {
        items.pop();
    }
    "[" + items.join(",") + "]"
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[String] = vec![
        "1-2--3--4-5--6--7".to_string(),
        "1-2--3---4-5--6---7".to_string(),
        "1-401--349---90--88".to_string(),
        "7".to_string(),
        "10-20".to_string(),
        "1-2--3---4----5".to_string(),
        "1000000000-1--1000000000-999999999".to_string(),
    ];
    for s in examples.iter() {
        println(f"{s} -> {level_order(recover_from_preorder(s))}");
    }
    // random trees: written out, recovered and written out again
    let mut seed = 1028;
    let groups: Vec[(i64, i64, i64)] = vec![(2000, 5, 9), (1000, 20, 100), (300, 100, 1000000000), (100, 300, 5), (20, 1000, 1000000000), (2, 1000, 1)];
    for (count, n, top) in groups.iter() {
        let mut exact = 0;
        let mut letters = 0;
        let mut check = 0;
        for _ in 0..count {
            let tree = random_tree(mut seed, n, top);
            let mut s = String.new();
            traversal(Some(tree), 0, mut s);
            letters += s.len();
            let back = level_order(recover_from_preorder(s));
            if back == level_order(Some(tree)) {
                exact += 1;
            }
            for b in back.bytes() {
                check = (check * 131 + b as i64) % 1000000007;
            }
        }
        println(f"{count} trees of {n} nodes (values up to {top}), {letters} letters: {exact} recovered exactly, checksum {check}");
    }
}
