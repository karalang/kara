// LeetCode #1028: Recover a Tree From Preorder Traversal -- differential
//
// The five arms, copied, against the statement read literally and five
// more properties. See README.md § Differential.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn d_star(traversal: Str) -> Option[TreeNode] {
    let bytes = traversal.bytes();
    let mut path: Vec[TreeNode] = Vec.new();
    let mut i = 0;
    while i < bytes.len() {
        let mut depth = 0;
        while bytes[i] == 45 {
            depth += 1;
            i += 1;
        }
        let mut value = 0;
        while i < bytes.len() and bytes[i] != 45 {
            value = value * 10 + (bytes[i] - 48) as i64;
            i += 1;
        }
        let node = TreeNode { val: value, left: None, right: None };
        while path.len() > depth {
            path.pop();
        }
        if path.len() > 0 {
            let parent = path[path.len() - 1];
            if parent.left.is_none() {
                parent.left = Some(node);
            } else {
                parent.right = Some(node);
            }
        }
        path.push(node);
    }
    if path.len() > 0 { Some(path[0]) } else { None }
}

fn d_recursive(traversal: Str) -> Option[TreeNode] {
    let mut at = 0;
    subtree(traversal, mut at, 0)
}

fn subtree(traversal: Str, at: mut ref i64, depth: i64) -> Option[TreeNode] {
    let bytes = traversal.bytes();
    let mut dashes = 0;
    while *at + dashes < bytes.len() and bytes[*at + dashes] == 45 {
        dashes += 1;
    }
    if *at + dashes >= bytes.len() or dashes != depth {
        return None;
    }
    *at += dashes;
    let mut value = 0;
    while *at < bytes.len() and bytes[*at] != 45 {
        value = value * 10 + (bytes[*at] - 48) as i64;
        *at += 1;
    }
    let node = TreeNode { val: value, left: None, right: None };
    node.left = subtree(traversal, mut at, depth + 1);
    node.right = subtree(traversal, mut at, depth + 1);
    Some(node)
}

fn d_split(traversal: Str) -> Option[TreeNode] {
    let mut last: Vec[TreeNode] = Vec.new();
    let mut depth = 0;
    for piece in traversal.split("-") {
        if piece.len() == 0 {
            depth += 1;
            continue;
        }
        let node = TreeNode { val: i64.parse(piece).unwrap(), left: None, right: None };
        if depth > 0 {
            let parent = last[depth - 1];
            if parent.left.is_none() {
                parent.left = Some(node);
            } else {
                parent.right = Some(node);
            }
        }
        if depth < last.len() {
            last[depth] = node;
        } else {
            last.push(node);
        }
        depth = 1;
    }
    if last.len() > 0 { Some(last[0]) } else { None }
}

// the string as a list of nodes, each its depth and its value
fn tokens(traversal: Str) -> Vec[(i64, i64)] {
    let bytes = traversal.bytes();
    let mut out: Vec[(i64, i64)] = Vec.new();
    let mut i = 0;
    while i < bytes.len() {
        let mut depth = 0;
        while bytes[i] == 45 {
            depth += 1;
            i += 1;
        }
        let mut value = 0;
        while i < bytes.len() and bytes[i] != 45 {
            value = value * 10 + (bytes[i] - 48) as i64;
            i += 1;
        }
        out.push((depth, value));
    }
    out
}

fn d_slices(traversal: Str) -> Option[TreeNode] {
    let list = tokens(traversal);
    build(list, 0, list.len())
}

// the subtree held by list[lo..hi], which starts with its root
fn build(list: ref Vec[(i64, i64)], lo: i64, hi: i64) -> Option[TreeNode] {
    if lo >= hi {
        return None;
    }
    let (depth, value) = list[lo];
    let mut split = hi;
    let mut seen_child = false;
    for k in lo + 1..hi {
        if list[k].0 == depth + 1 {
            if seen_child {
                split = k;
                break;
            }
            seen_child = true;
        }
    }
    Some(TreeNode { val: value, left: build(list, lo + 1, split), right: build(list, split, hi) })
}

fn d_parents(traversal: Str) -> Option[TreeNode] {
    let list = tokens(traversal);
    let nodes: Vec[TreeNode] = list.iter().map(|(_, v)| TreeNode { val: v, left: None, right: None }).collect();
    for k in 1..list.len() {
        let mut p = k - 1;
        while list[p].0 != list[k].0 - 1 {
            p -= 1;
        }
        if nodes[p].left.is_none() {
            nodes[p].left = Some(nodes[k]);
        } else {
            nodes[p].right = Some(nodes[k]);
        }
    }
    if nodes.len() > 0 { Some(nodes[0]) } else { None }
}
fn arms(s: Str) -> Vec[Option[TreeNode]] {
    vec![d_star(s), d_recursive(s), d_split(s), d_slices(s), d_parents(s)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_value(seed: mut ref i64, top: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1
}

// every tree shape of `n` nodes, in preorder with 1 for a node and 0 for a
// missing child
fn shapes(n: i64) -> Vec[String] {
    if n == 0 {
        return vec!["0".to_string()];
    }
    let mut out: Vec[String] = Vec.new();
    for l in 0..n {
        for a in shapes(l).iter() {
            for b in shapes(n - 1 - l).iter() {
                out.push("1" + a + b);
            }
        }
    }
    out
}

// the tree a preorder shape describes, from place `at`, with random values
fn build_shape(shape: ref String, at: mut ref i64, seed: mut ref i64, top: i64) -> Option[TreeNode] {
    let here = shape.bytes()[*at];
    *at += 1;
    if here == 48 {
        return None;
    }
    let node = TreeNode { val: random_value(mut seed, top), left: None, right: None };
    node.left = build_shape(shape, mut at, mut seed, top);
    node.right = build_shape(shape, mut at, mut seed, top);
    Some(node)
}

// a random tree of `n` nodes, a node with one child having it on the left
fn random_tree(seed: mut ref i64, n: i64, top: i64) -> TreeNode {
    let root = TreeNode { val: random_value(mut seed, top), left: None, right: None };
    let mut placed = 1;
    while placed < n {
        let leaf = TreeNode { val: random_value(mut seed, top), left: None, right: None };
        let mut node = root;
        loop {
            match node.left {
                None => {
                    node.left = Some(leaf);
                    break;
                }
                Some(l) => {
                    if next_random(mut seed) % 2 == 0 {
                        node = l;
                    } else {
                        match node.right {
                            None => {
                                node.right = Some(leaf);
                                break;
                            }
                            Some(r) => {
                                node = r;
                            }
                        }
                    }
                }
            }
        }
        placed += 1;
    }
    root
}

// whether no node has a right child without a left one, as the statement
// promises of the tree
fn left_first(node: ref Option[TreeNode]) -> bool {
    match node {
        None => true,
        Some(n) => not (n.left.is_none() and n.right.is_some()) and left_first(n.left) and left_first(n.right),
    }
}

// the statement's traversal: each node as `depth` dashes and its value, in
// preorder
fn write(node: ref Option[TreeNode], depth: i64, out: mut ref String) {
    if let Some(n) = node {
        for _ in 0..depth {
            out.push('-');
        }
        out.push_str(f"{n.val}");
        write(n.left, depth + 1, mut out);
        write(n.right, depth + 1, mut out);
    }
}

fn written(node: ref Option[TreeNode]) -> String {
    let mut out = String.new();
    write(node, 0, mut out);
    out
}

// LeetCode's level order, with trailing nulls left off
fn level_order(root: ref Option[TreeNode]) -> String {
    let mut items: Vec[String] = Vec.new();
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    while let Some(entry) = queue.pop_front() {
        match entry {
            None => items.push("null".to_string()),
            Some(n) => {
                items.push(f"{n.val}");
                queue.push_back(n.left);
                queue.push_back(n.right);
            }
        }
    }
    while items.len() > 0 and items[items.len() - 1] == "null" {
        items.pop();
    }
    "[" + items.join(",") + "]"
}

// every node one level deeper: a dash put in front of each node's dashes
fn deeper(s: Str) -> String {
    let bytes = s.bytes();
    let mut out = String.new();
    for i in 0..bytes.len() {
        if i == 0 or (bytes[i] == 45 and bytes[i - 1] != 45) {
            out.push('-');
        }
        out.push(bytes[i] as char);
    }
    out
}

fn count(node: ref Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => 1 + count(n.left) + count(n.right),
    }
}

fn height(node: ref Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => 1 + height(n.left).max(height(n.right)),
    }
}

fn main() {
    let mut failures: Vec[i64] = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 10281;
    // every tree of 1 to 7 nodes with no right child alone, each with
    // values below 10 and below 10^9; then 400 random trees of 8 to 60
    // nodes and 10 of 200 to 300, with values up to 9, 100 or 10^9
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    for n in 1..8 {
        for shape in shapes(n).iter() {
            for top in vec![9, 1000000000] {
                let mut at = 0;
                let tree = build_shape(shape, mut at, mut seed, top);
                if left_first(tree) {
                    trees.push(tree);
                }
            }
        }
    }
    let tops: Vec[i64] = vec![9, 100, 1000000000];
    for k in 0..410 {
        let n = if k < 400 { 8 + next_random(mut seed) % 53 } else { 200 + next_random(mut seed) % 101 };
        let top = tops[next_random(mut seed) % 3];
        trees.push(Some(random_tree(mut seed, n, top)));
    }
    for k in 0..trees.len() {
        let tree = trees[k];
        let s = written(tree);
        let got = arms(s);
        // P3: below a new root, the tree is its left subtree
        let above = random_value(mut seed, 1000000000);
        let lifted = f"{above}" + deeper(s);
        let got_lifted = arms(lifted);
        // P5: this tree and the next one, below a new root, are its two
        // subtrees
        let other = written(trees[(k + 1) % trees.len()]);
        let joined = f"{above}" + deeper(s) + deeper(other);
        let got_joined = arms(joined);
        let want = level_order(tree);
        let want_other = level_order(trees[(k + 1) % trees.len()]);
        // the counts the string itself gives: its numbers, and one more
        // than its longest run of dashes
        let mut numbers = 0;
        let mut longest = 0;
        let mut run = 0;
        let bytes = s.bytes();
        for i in 0..bytes.len() {
            if bytes[i] == 45 {
                run += 1;
            } else {
                if i == 0 or bytes[i - 1] == 45 {
                    numbers += 1;
                }
                longest = longest.max(run);
                run = 0;
            }
        }
        let shown: Vec[String] = got.iter().map(|t| level_order(t)).collect();
        for b in shown[0].bytes() {
            check = (check * 131 + b as i64) % 1000000007;
        }
        for a in 0..5 {
            let t = got[a];
            // P1: the statement read literally, as a check: written out
            // the statement's way the tree gives back the string, and no
            // node has a right child alone
            checks += 1;
            if written(t) != s or not left_first(t) {
                failures[0] += 1;
            }
            // P2: the tree the string was written from
            checks += 1;
            if shown[a] != want {
                failures[1] += 1;
            }
            // P3: the new root holds the tree on its left and nothing on
            // its right
            checks += 1;
            let lifted_ok = match got_lifted[a] {
                None => false,
                Some(r) => r.val == above and level_order(r.left) == shown[a] and r.right.is_none(),
            };
            if not lifted_ok {
                failures[2] += 1;
            }
            // P4: as many nodes as numbers, and as many levels as the
            // deepest node's dashes and one
            checks += 1;
            if count(t) != numbers or height(t) != longest + 1 {
                failures[3] += 1;
            }
            // P5: the two trees below a new root, in order
            checks += 1;
            let joined_ok = match got_joined[a] {
                None => false,
                Some(r) => r.val == above and level_order(r.left) == want and level_order(r.right) == want_other,
            };
            if not joined_ok {
                failures[4] += 1;
            }
            // P6: each arm agrees with at least two of the other four
            checks += 1;
            let mut agree = 0;
            for o in 0..5 {
                if o != a and shown[o] == shown[a] {
                    agree += 1;
                }
            }
            if agree < 2 {
                failures[5] += 1;
            }
        }
    }
    let mut total = 0;
    for p in 0..6 {
        if failures[p] > 0 {
            println(f"P{p + 1}: {failures[p]} failures");
        }
        total += failures[p];
    }
    println(f"{trees.len()} trees: checksum {check}, {checks} checks over 5 arms: {total} failures");
}
