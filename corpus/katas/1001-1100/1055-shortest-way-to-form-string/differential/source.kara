// LeetCode #1055: Shortest Way to Form String -- the differential.
//
// The five arms against the statement read literally, on 3000 random
// pairs, with six properties:
//
// P1  the answer is the statement read literally
// P2  the answer is -1 exactly when the target has a letter the source
//     lacks, and otherwise from 1 to the target's length, and 1 exactly
//     when the target is a subsequence of the source
// P3  the target twice takes at least as many pieces and at most twice as
//     many
// P4  every letter moved on by the same step through the alphabet, in both
//     strings, leaves the answer
// P5  the source twice takes half the pieces, rounded up
// P6  each arm agrees with at least two of the other four
// ---- shortest_way.kara: the ★ arm: one pass over the source per piece
fn star_arm(source: ref String, target: ref String) -> i64 {
    let s = source.bytes();
    let t = target.bytes();
    let mut pieces = 0;
    let mut i = 0;
    while i < t.len() {
        let start = i;
        for c in s {
            if i < t.len() and t[i] == c {
                i += 1;
            }
        }
        if i == start {
            return -1;
        }
        pieces += 1;
    }
    pieces
}

// ---- shortest_way_next.kara: a table of next places
fn next_arm(source: ref String, target: ref String) -> i64 {
    let s = source.bytes();
    let n = s.len();
    let mut next = Vec.filled(n + 1, [n; 26]);
    for i in (0..n).rev() {
        next[i] = next[i + 1];
        next[i][(s[i] - b'a') as usize] = i;
    }
    let mut pieces = 1;
    let mut pos = 0;
    for c in target.bytes() {
        let c = (c - b'a') as usize;
        if next[0][c] == n {
            return -1;
        }
        if next[pos][c] == n {
            pieces += 1;
            pos = 0;
        }
        pos = next[pos][c] + 1;
    }
    pieces
}

// ---- shortest_way_search.kara: binary search in each letter's places
fn search_arm(source: ref String, target: ref String) -> i64 {
    let mut places: Vec[Vec[i64]] = Vec.filled(26, Vec.new());
    for (i, c) in source.bytes().iter().enumerate() {
        places[(c - b'a') as usize].push(i);
    }
    let mut pieces = 1;
    let mut pos = 0;
    for c in target.bytes() {
        let list = ref places[(c - b'a') as usize];
        if list.is_empty() {
            return -1;
        }
        let k = list.partition_point(|p| p < pos);
        if k == list.len() {
            pieces += 1;
            pos = list[0] + 1;
        } else {
            pos = list[k] + 1;
        }
    }
    pieces
}

// ---- shortest_way_iter.kara: `position` from where the piece has got to
fn iter_arm(source: ref String, target: ref String) -> i64 {
    if not target.chars().all(|c| source.contains(c.to_string())) {
        return -1;
    }
    let s = source.bytes();
    let mut pieces = 1;
    let mut pos = 0;
    for c in target.bytes() {
        let k = match s[pos..].iter().position(|x| x == c) {
            Some(k) => pos + k,
            None => {
                pieces += 1;
                s.iter().position(|x| x == c).unwrap()
            }
        };
        pos = k + 1;
    }
    pieces
}

// ---- shortest_way_reach.kara: the fewest pieces for every prefix
fn reach_arm(source: ref String, target: ref String) -> i64 {
    let s = source.bytes();
    let t = target.bytes();
    let n = s.len();
    let m = t.len();
    let mut next = Vec.filled(n + 1, [n; 26]);
    for i in (0..n).rev() {
        next[i] = next[i + 1];
        next[i][s[i] - b'a'] = i;
    }
    let mut best = Vec.filled(m + 1, i64.MAX);
    best[0] = 0;
    for j in 0..m {
        if best[j] == i64.MAX {
            continue;
        }
        let mut pos = 0;
        let mut reach = j;
        while reach < m {
            let at = next[pos][t[reach] - b'a'];
            if at == n {
                break;
            }
            pos = at + 1;
            reach += 1;
            best[reach] = best[reach].min(best[j] + 1);
        }
    }
    if best[m] == i64.MAX { -1 } else { best[m] }
}

// ---- the statement read literally
// Whether `piece` is a subsequence of `source`: its letters in order, each
// found after the last.
fn is_subsequence(piece: Slice[u8], source: Slice[u8]) -> bool {
    let mut k = 0;
    for c in source.iter() {
        if k < piece.len() and piece[k] == c {
            k += 1;
        }
    }
    k == piece.len()
}

// Every way to cut `target` into pieces, each a subsequence of `source`:
// the fewest pieces to form each prefix, from every shorter prefix and the
// piece after it. -1 when no cutting works.
fn read_literally(source: ref String, target: ref String) -> i64 {
    let s = source.bytes();
    let t = target.bytes();
    let m = t.len();
    let mut fewest: Vec[i64] = Vec.filled(m + 1, -1);
    fewest[0] = 0;
    for i in 1..m + 1 {
        for j in 0..i {
            if fewest[j] >= 0 and is_subsequence(t[j..i], s) {
                let pieces = fewest[j] + 1;
                if fewest[i] < 0 or pieces < fewest[i] {
                    fewest[i] = pieces;
                }
            }
        }
    }
    fewest[m]
}

fn arm(a: i64, source: ref String, target: ref String) -> i64 {
    match a {
        0 => star_arm(source, target),
        1 => next_arm(source, target),
        2 => search_arm(source, target),
        3 => iter_arm(source, target),
        _ => reach_arm(source, target),
    }
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..n {
        word.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    word
}

// `word` with every letter moved on `step` places, wrapping after z.
fn shifted(word: ref String, step: i64) -> String {
    word.chars().map(|c| (97 + (c as i64 - 97 + step) % 26) as u8 as char).collect()
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// Every check on one pair.
fn check_case(t: mut ref Tally, source: ref String, target: ref String) {
    let answers: Vec[i64] = (0..5).map(|a| arm(a, source, target)).collect();
    let want = read_literally(source, target);
    let lacks = target.chars().any(|c| not source.contains(c.to_string()));
    let whole = is_subsequence(target.bytes(), source.bytes());
    let twice_target = target + target;
    let twice_source = source + source;
    let moved_source = shifted(source, 7);
    let moved_target = shifted(target, 7);
    for a in 0..5 {
        let answer = answers[a];
        let what = f"arm {a}, {source} {target} -> {answer}";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally {want}");
        let range = if lacks {
            answer == -1
        } else {
            answer >= 1 and answer <= target.len() and (answer == 1) == whole
        };
        expect(mut t, 2, range, f"P2 {what}: out of range");
        let doubled = arm(a, source, twice_target);
        let between = if answer < 0 { doubled == -1 } else { doubled >= answer and doubled <= 2 * answer };
        expect(mut t, 3, between, f"P3 {what}: target twice {doubled}");
        expect(mut t, 4, arm(a, moved_source, moved_target) == answer, f"P4 {what}: moved on 7");
        let halved = arm(a, twice_source, target);
        let half = if answer < 0 { -1 } else { (answer + 1) / 2 };
        expect(mut t, 5, halved == half, f"P5 {what}: source twice {halved}");
        let agree = (0..5).filter(|o| o != a and answers[o] == answer).count();
        expect(mut t, 6, agree >= 2, f"P6 {what}: agrees with {agree}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + answers[0] + 2) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 3000 random pairs: 2000 of a source of 1 to 6 letters and a target of
    // 1 to 12, both of 3 letters, and 1000 of 1 to 20 and 1 to 40 of 6
    let mut seed = 10551;
    for i in 0..3000 {
        let (longest, letters) = if i < 2000 { (6, 3) } else { (20, 6) };
        let source = random_word(next_random(mut seed) % longest + 1, letters, mut seed);
        let target = random_word(next_random(mut seed) % (2 * longest) + 1, letters, mut seed);
        check_case(mut t, source, target);
    }
    println(f"{t.cases} pairs: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
