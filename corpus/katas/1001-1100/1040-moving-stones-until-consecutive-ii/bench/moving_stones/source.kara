// Benchmark lane for LeetCode 1040 -- Moving Stones Until Consecutive II.
//
// BUILD ONCE + PUNCH: 400 sets of 10000 stones (the problem's most) are
// built once, half spread over 1 to 10^9 and half packed with gaps of 1 to
// 3, each shuffled so the sort has work. Then every set is solved 5 times
// with the ★ arm, which copies and sorts its input and slides the window,
// and each answer is folded into a total and a checksum.
//
// Mirrors: moving_stones.c / .rs / .py / go-seq/main.go -- same algorithm.

fn moves(stones: ref Vec[i64]) -> (i64, i64) {
    let mut s = stones.clone();
    s.sort();
    let n = s.len();
    let most = (s[n - 1] - s[1] - n + 2).max(s[n - 2] - s[0] - n + 2);
    let mut least = n;
    let mut i = 0;
    for j in 0..n {
        while s[j] - s[i] >= n {
            i += 1;
        }
        let inside = j - i + 1;
        if inside == n - 1 and s[j] - s[i] == n - 2 {
            least = least.min(2);
        } else {
            least = least.min(n - inside);
        }
    }
    (least, most)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 400;
    let size = 10000;
    let rounds = 5;
    let mut seed = 1040;
    let mut sets: Vec[Vec[i64]] = Vec.new();
    for c in 0..count {
        // distinct by construction: a running sum of positive gaps
        let widest = if c % 2 == 0 { 100000 } else { 3 };
        let mut stones: Vec[i64] = Vec.new();
        let mut at = 0;
        for _ in 0..size {
            at += (next_random(mut seed) * 32768 + next_random(mut seed)) % widest + 1;
            stones.push(at);
        }
        let mut i = size - 1;
        while i > 0 {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            let keep = stones[i];
            stones[i] = stones[j];
            stones[j] = keep;
            i -= 1;
        }
        sets.push(stones);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for stones in sets.iter() {
            let (least, most) = moves(stones);
            total += least + most;
            check = (check * 131 + least * 1000003 + most) % 1000000007;
        }
    }
    println(f"{count} sets of {size} stones, {rounds} rounds: total {total}, checksum {check}");
}
