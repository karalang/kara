// LeetCode #1014: Best Sightseeing Pair -- suffix maxima
//
// A pair i < j scores values[i] + i + values[j] - j. Read from the other
// end: a first pass stores, for each i, the largest values[j] - j over
// j > i, walking right to left; a second pass scores each i against its
// entry. O(n) time and space.

fn max_score_sightseeing_pair(values: ref Vec[i64]) -> i64 {
    let n = values.len();
    let mut second: Vec[i64] = Vec.filled(n, 0);
    second[n - 2] = values[n - 1] - (n - 1);
    for i in (0..n - 2).rev() {
        second[i] = second[i + 1].max(values[i + 1] - (i + 1));
    }
    let mut best = 0;
    for i in 0..n - 1 {
        best = best.max(values[i] + i + second[i]);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` values drawn from 1..=most
fn random_values(seed: mut ref i64, len: i64, most: i64) -> Vec[i64] {
    let mut values: Vec[i64] = Vec.new();
    for _ in 0..len {
        values.push(1 + next_random(mut seed) % most);
    }
    values
}

fn shown(values: ref Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in values.iter() {
        parts.push(x.to_string());
    }
    let inner = parts.join(",");
    f"[{inner}]"
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[Vec[i64]] = vec![
        vec![8, 1, 5, 2, 6],
        vec![1, 2],
        vec![1, 1],
        vec![1000, 1000],
        vec![1, 1000],
        vec![5, 4, 3, 2, 1],
        vec![1, 2, 3, 4, 5],
        vec![3, 1, 1, 1, 3],
        vec![1, 3, 1, 3],
        vec![7, 1, 1, 1, 1, 1, 8],
        vec![2, 2, 2, 2, 2],
        vec![10, 1, 1, 10],
        vec![1, 1000, 1, 1, 999, 1000],
    ];
    for values in examples.iter() {
        let s = shown(values);
        println(f"values = {s} -> {max_score_sightseeing_pair(values)}");
    }
    // random arrays: the sum of the answers, and a checksum of them in order
    let mut seed = 1014;
    let groups: Vec[(i64, i64, i64)] = vec![(3000, 2, 1000), (3000, 8, 10), (1000, 60, 1000), (200, 1000, 1000), (6, 50000, 1000), (6, 50000, 2)];
    for (count, len, most) in groups.iter() {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let values = random_values(mut seed, len, most);
            let answer = max_score_sightseeing_pair(values);
            total += answer;
            check = (check * 31 + answer) % 1000000007;
        }
        println(f"{count} random arrays of {len} values up to {most}: answers sum to {total}, checksum {check}");
    }
    // two spots of 1000 planted `gap` apart among values up to 10: the
    // planted pair scores 2000 - gap, and a planted spot beside a 10 scores
    // 1009, so a wide enough gap is beaten
    let mut planted = 0;
    let mut beaten = 0;
    for _ in 0..1000 {
        let mut values = random_values(mut seed, 2000, 10);
        let gap = 1 + next_random(mut seed) % 1999;
        let at = next_random(mut seed) % (2000 - gap);
        values[at] = 1000;
        values[at + gap] = 1000;
        let answer = max_score_sightseeing_pair(values);
        if answer == 2000 - gap {
            planted += 1;
        } else {
            beaten += 1;
        }
    }
    println(f"1000 planted pairs: {planted} are the best pair, {beaten} beaten");
}
