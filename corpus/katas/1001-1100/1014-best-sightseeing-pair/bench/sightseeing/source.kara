// LeetCode #1014: Best Sightseeing Pair -- bench
//
// The ★ arm (../sightseeing.kara) on one array of 50,000 values from 1 to
// 1,000, then 10,000 rounds that each set one spot to a new value and ask
// again, folding every answer into a checksum. See ../README.md §
// Benchmarks.

fn max_score_sightseeing_pair(values: ref Vec[i64]) -> i64 {
    let mut best_first = values[0];
    let mut best = 0;
    for j in 1..values.len() {
        best = best.max(best_first + values[j] - j);
        best_first = best_first.max(values[j] + j);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50000;
    let rounds = 10000;
    let mut seed = 1014;
    let mut values: Vec[i64] = Vec.new();
    for _ in 0..count {
        values.push(1 + next_random(mut seed) % 1000);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % count;
        values[at] = 1 + next_random(mut seed) % 1000;
        let answer = max_score_sightseeing_pair(values);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{rounds} rounds over {count} values: answers sum to {total}, checksum {check}");
}
