// LeetCode #1044: Longest Duplicate Substring -- binary search on the
// length, each length checked with a rolling hash.
//
// If some substring of length `len` occurs twice, so does its prefix of
// length `len - 1`, so the lengths that repeat run from 0 up to the
// answer's, and a binary search finds the longest. A length is checked by
// sliding a polynomial hash along the string: each window's hash keys the
// starts of the earlier windows with that hash, and a window whose bytes
// equal one of them repeats it. Of the windows that repeat, the answer is
// the smallest in dictionary order, so every arm returns the same one.
// O(n log n) expected.

const BASE: i64 = 131;
const MODULUS: i64 = 1_000_000_007;

fn longest_dup_substring(s: Str) -> String {
    let bytes = s.bytes();
    let mut low = 1;
    let mut high = bytes.len() - 1;
    let mut best_start = 0;
    let mut best_len = 0;
    while low <= high {
        let len = (low + high) / 2;
        match repeated_window(bytes, len) {
            Some(start) => {
                best_start = start;
                best_len = len;
                low = len + 1;
            }
            None => high = len - 1,
        }
    }
    s[best_start..best_start + best_len].to_string()
}

// The start of the smallest window of `len` bytes that occurs twice.
fn repeated_window(bytes: Slice[u8], len: i64) -> Option[i64] {
    let n = bytes.len();
    let mut lead = 1;
    for _ in 1..len {
        lead = lead * BASE % MODULUS;
    }
    let mut hash = 0;
    for i in 0..len {
        hash = (hash * BASE + bytes[i]) % MODULUS;
    }
    let mut seen: Map[i64, Vec[i64]] = Map.new();
    let mut found: Option[i64] = None;
    let mut start = 0;
    loop {
        let earlier = match seen.get(hash) {
            Some(starts) => starts.iter().any(|j| same(bytes, j, start, len)),
            None => false,
        };
        if earlier {
            found = match found {
                Some(f) if not smaller(bytes, start, f, len) => Some(f),
                _ => Some(start),
            };
        } else {
            seen.entry(hash).or_insert(Vec.new()).push(start);
        }
        if start + len == n {
            break;
        }
        hash = (hash - bytes[start] * lead % MODULUS + MODULUS) % MODULUS;
        hash = (hash * BASE + bytes[start + len]) % MODULUS;
        start += 1;
    }
    found
}

fn same(bytes: Slice[u8], a: i64, b: i64, len: i64) -> bool {
    for k in 0..len {
        if bytes[a + k] != bytes[b + k] {
            return false;
        }
    }
    true
}

// Whether the window at `a` comes before the window at `b`.
fn smaller(bytes: Slice[u8], a: i64, b: i64, len: i64) -> bool {
    for k in 0..len {
        if bytes[a + k] != bytes[b + k] {
            return bytes[a + k] < bytes[b + k];
        }
    }
    false
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn fold_into(check: mut ref i64, answer: Str) {
    *check = (*check * 131 + answer.len() + 1) % 1000000007;
    for b in answer.bytes().iter() {
        *check = (*check * 131 + b as i64) % 1000000007;
    }
}

fn show(answer: Str) -> String {
    if answer.len() <= 24 {
        f"\"{answer}\""
    } else {
        f"\"{answer[0..12]}...{answer[answer.len() - 12..answer.len()]}\" ({answer.len()} letters)"
    }
}

// A string of `n` letters drawn from the first `k` of the alphabet.
fn random_string(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    out
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples = [
        "banana",
        "abcd",
        "aa",
        "ab",
        "aaaaa",
        "abcabc",
        "mississippi",
        "abababab",
        "zxyzxyxyz",
        "theeuntheeuntheeun",
    ];
    for s in examples.iter() {
        println(f"\"{s}\" -> {show(longest_dup_substring(s))}");
    }
    // every string of 2 to 12 letters from "ab", and of 2 to 7 from "abc"
    for (k, most) in [(2, 12), (3, 7)].iter() {
        let mut cases = 0;
        let mut total = 0;
        let mut check = 0;
        for n in 2..most + 1 {
            let mut count = 1;
            for _ in 0..n {
                count *= k;
            }
            for code in 0..count {
                let mut s = String.new();
                let mut c = code;
                for _ in 0..n {
                    s.push((b'a' + (c % k) as u8) as char);
                    c /= k;
                }
                let answer = longest_dup_substring(s);
                cases += 1;
                total += answer.len();
                fold_into(mut check, answer);
            }
        }
        println(f"every string of 2 to {most} letters from {k}: {cases} cases, total length {total}, checksum {check}");
    }
    // 300 random strings of 2 to 200 letters from 2 to 26
    let mut seed = 1044;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 199 + 2;
        let k = next_random(mut seed) % 25 + 2;
        let answer = longest_dup_substring(random_string(n, k, mut seed));
        total += answer.len();
        fold_into(mut check, answer);
    }
    println(f"300 random strings: total length {total}, checksum {check}");
    // the largest: 5000 random letters, and 5000 letters of the Fibonacci word
    let wide = random_string(5000, 26, mut seed);
    println(f"5000 random letters -> {show(longest_dup_substring(wide))}");
    let mut a = "a".to_string();
    let mut b = "ab".to_string();
    while b.len() < 5000 {
        let next = f"{b}{a}";
        a = b;
        b = next;
    }
    let fib = b[0..5000];
    println(f"5000 letters of the Fibonacci word -> {show(longest_dup_substring(fib))}");
}
