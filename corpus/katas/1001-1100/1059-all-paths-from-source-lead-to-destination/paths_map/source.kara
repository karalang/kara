// LeetCode #1059: All Paths from Source Lead to Destination -- a recursive
// search over hashed tables.
//
// The graph as a `Map` from each node to its successors, the nodes on the
// current path in a `Set`, and each finished node's answer in another
// `Map`. A node with no entry in the graph has no outgoing edge. O(n + e)
// expected.

fn leads(
    u: i64,
    graph: Map[i64, Vec[i64]],
    on_path: mut ref Set[i64],
    known: mut ref Map[i64, bool],
    destination: i64,
) -> bool {
    if let Some(answer) = known.get(u) {
        return *answer;
    }
    if on_path.contains(u) {
        return false;
    }
    let answer = match graph.get(u) {
        None => u == destination,
        Some(next) => {
            on_path.insert(u);
            let all = next.iter().all(|v| leads(v, graph, mut on_path, mut known, destination));
            on_path.remove(u);
            all
        }
    };
    known.insert(u, answer);
    answer
}

fn leads_to_destination(n: i64, edges: Vec[(i64, i64)], source: i64, destination: i64) -> bool {
    let mut graph: Map[i64, Vec[i64]] = Map.new();
    for (u, v) in edges.iter() {
        graph.entry(u).or_insert(Vec.new()).push(v);
    }
    let mut on_path: Set[i64] = Set.new();
    let mut known: Map[i64, bool] = Map.new();
    leads(source, graph, mut on_path, mut known, destination)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Up to `most_edges` edges between any two of `n` nodes, self-loops and
// repeats included.
fn random_graph(n: i64, most_edges: i64, seed: mut ref i64) -> Vec[(i64, i64)] {
    let m = next_random(mut seed) % (most_edges + 1);
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for _ in 0..m {
        let u = next_random(mut seed) % n;
        let v = next_random(mut seed) % n;
        edges.push((u, v));
    }
    edges
}

// A graph that mostly leads to node n - 1: about `per_node` edges from each
// node to a later one, three in four of the nodes left without an edge given
// one to n - 1, and one time in `back` an edge to an earlier node.
fn leaning_graph(n: i64, per_node: i64, back: i64, seed: mut ref i64) -> Vec[(i64, i64)] {
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for u in 0..n - 1 {
        let k = next_random(mut seed) % (per_node + 1);
        for _ in 0..k {
            let span = (n - 1 - u).min(20);
            edges.push((u, u + 1 + next_random(mut seed) % span));
        }
        if k == 0 and next_random(mut seed) % 4 != 0 {
            edges.push((u, n - 1));
        }
        if next_random(mut seed) % back == 0 {
            edges.push((u, next_random(mut seed) % (u + 1)));
        }
    }
    edges
}

fn mix(check: i64, answer: bool, k: i64) -> i64 {
    (check * 31 + if answer { 7 + k % 13 } else { 3 }) % 1000000007
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(i64, Vec[(i64, i64)], i64, i64)] = [
        (3, [(0, 1), (0, 2)], 0, 2),
        (4, [(0, 1), (0, 3), (1, 2), (2, 1)], 0, 3),
        (4, [(0, 1), (0, 2), (1, 3), (2, 3)], 0, 3),
        (1, [], 0, 0),
        (1, [(0, 0)], 0, 0),
        (2, [(0, 1), (1, 1)], 0, 1),
        (3, [(0, 1), (0, 1), (1, 2), (1, 2)], 0, 2),
        (2, [], 0, 1),
        (3, [(1, 2), (2, 1)], 0, 0),
        (5, [(0, 1), (1, 2), (2, 3), (3, 4), (4, 2)], 0, 4),
    ];
    for (n, edges, source, destination) in examples.iter() {
        println(f"{n} {edges} {source} {destination} -> {leads_to_destination(n, edges, source, destination)}");
    }
    let mut seed = 1059;
    let mut yes = 0;
    let mut check = 0;
    for k in 0..3000 {
        let n = next_random(mut seed) % 8 + 1;
        let edges = random_graph(n, 12, mut seed);
        let source = next_random(mut seed) % n;
        let destination = next_random(mut seed) % n;
        let answer = leads_to_destination(n, edges, source, destination);
        if answer {
            yes += 1;
        }
        check = mix(check, answer, k);
    }
    println(f"3000 random graphs of 1 to 8 nodes: {yes} lead, checksum {check}");
    yes = 0;
    check = 0;
    for k in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        let edges = leaning_graph(n, 2, 8, mut seed);
        let source = next_random(mut seed) % n;
        let answer = leads_to_destination(n, edges, source, n - 1);
        if answer {
            yes += 1;
        }
        check = mix(check, answer, k);
    }
    println(f"3000 leaning graphs of 1 to 12 nodes: {yes} lead, checksum {check}");
    yes = 0;
    check = 0;
    let mut edge_count = 0;
    for k in 0..100 {
        let n = 10000;
        let edges = leaning_graph(n, 1 + k % 2, 20000 + k * 100, mut seed);
        edge_count += edges.len();
        let answer = leads_to_destination(n, edges, 0, n - 1);
        if answer {
            yes += 1;
        }
        check = mix(check, answer, k);
    }
    println(f"100 leaning graphs of 10000 nodes, {edge_count} edges: {yes} lead, checksum {check}");
    // one graph of 2000 nodes, every source
    let n = 2000;
    let edges = leaning_graph(n, 2, 1000, mut seed);
    yes = 0;
    check = 0;
    for source in 0..n {
        let answer = leads_to_destination(n, edges, source, n - 1);
        if answer {
            yes += 1;
        }
        check = mix(check, answer, source);
    }
    println(f"2000 nodes, {edges.len()} edges, every source: {yes} lead, checksum {check}");
    // a path of 10000 nodes, then the same path closed into a cycle
    let mut path: Vec[(i64, i64)] = Vec.new();
    for u in 0..9999 {
        path.push((u, u + 1));
    }
    let open = leads_to_destination(10000, path, 0, 9999);
    path.push((9999, 0));
    let closed = leads_to_destination(10000, path, 0, 9999);
    println(f"a path of 10000 nodes: {open}, closed into a cycle: {closed}");
}
