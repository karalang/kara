// LeetCode #1038: Binary Search Tree to Greater Sum Tree -- bench
// Mirrors ../gst.kara; see ../README.md § Benchmarks.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn add_greater(node: Option[TreeNode], above: i64) -> i64 {
    match node {
        None => above,
        Some(n) => {
            let total = add_greater(n.right, above) + n.val;
            n.val = total;
            add_greater(n.left, total)
        }
    }
}

fn bst_to_gst(root: Option[TreeNode]) -> Option[TreeNode] {
    add_greater(root, 0);
    root
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A search tree of the keys, inserted in the order given; every node is
// also listed in `nodes`, in the same order.
fn build(keys: ref Vec[i64], nodes: mut ref Vec[TreeNode]) -> TreeNode {
    let root = leaf(keys[0]);
    nodes.push(root);
    for i in 1..keys.len() {
        let v = keys[i];
        let fresh = leaf(v);
        nodes.push(fresh);
        let mut node = root;
        loop {
            if v < node.val {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(fresh);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(fresh);
                        break;
                    }
                }
            }
        }
    }
    root
}

fn main() {
    // 10,000 random search trees of 100 distinct keys from 0 to 100 (the
    // problem's most), built once. Then 50 times over, each tree has its
    // keys put back from the list and is converted.
    let trees = 10000;
    let rounds = 50;
    let mut seed = 1038;
    let mut pool: Vec[i64] = (0..101).collect();
    let mut roots: Vec[TreeNode] = Vec.new();
    let mut lists: Vec[Vec[TreeNode]] = Vec.new();
    let mut originals: Vec[Vec[i64]] = Vec.new();
    for _ in 0..trees {
        for i in 0..100 {
            let j = i + next_random(mut seed) % (101 - i);
            pool.swap(i, j);
        }
        let keys = pool[0..100].to_vec();
        let mut nodes: Vec[TreeNode] = Vec.new();
        roots.push(build(keys, mut nodes));
        lists.push(nodes);
        originals.push(keys);
    }
    let mut total = 0;
    let mut check: i64 = 0;
    for _ in 0..rounds {
        for t in 0..trees {
            let nodes = ref lists[t];
            let keys = ref originals[t];
            for i in 0..nodes.len() {
                nodes[i].val = keys[i];
            }
            let top = bst_to_gst(Some(roots[t])).unwrap().val;
            total += top;
            check = (check * 31 + top + 1000) % 1000000007;
        }
    }
    println(f"{trees} trees of 100 keys, {rounds} rounds: total {total}, checksum {check}");
}
