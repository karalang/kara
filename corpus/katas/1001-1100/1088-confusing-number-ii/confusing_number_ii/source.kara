// LeetCode #1088: Confusing Number II -- the ★ arm: a depth-first walk over
// the numbers made only of the digits that rotate (0, 1, 6, 8, 9), each
// carrying its rotation, built one digit at a time: appending d to a number
// of k digits puts d's rotation in front of the old rotation, at 10^k. A
// number is counted when it differs from its rotation; a walk stops at the
// first digit that takes it past n. O(the numbers up to n made of those
// digits), about 2 million for n = 10^9.

fn rotated(d: i64) -> i64 {
    match d {
        0 => 0,
        1 => 1,
        6 => 9,
        8 => 8,
        9 => 6,
        _ => -1,
    }
}

fn count_from(num: i64, rot: i64, unit: i64, n: i64) -> i64 {
    let mut total = 0;
    for d in [0, 1, 6, 8, 9] {
        let next = num * 10 + d;
        if next > n {
            break;
        }
        if next == 0 {
            continue;
        }
        let r = rotated(d) * unit + rot;
        if next != r {
            total += 1;
        }
        total += count_from(next, r, unit * 10, n);
    }
    total
}

fn confusing_number_ii(n: i64) -> i64 {
    count_from(0, 0, 1, n)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = [1, 6, 9, 10, 20, 100, 1000, 6969, 10000, 68986, 123456, 1000000];
    for n in cases.iter() {
        println(f"{n} -> {confusing_number_ii(n)}");
    }
    // every n from 1 to 1000
    let mut small = 0;
    for n in 1..=1000 {
        small += confusing_number_ii(n);
    }
    println(f"n = 1 to 1000: answers sum to {small}");
    // 200 random n up to 10^5, of 1 to 6 digits
    let mut seed = 1088;
    let mut h = 0;
    for _ in 0..200 {
        let digits = next_random(mut seed) % 6;
        let mut n = 1;
        for _ in 0..digits {
            n *= 10;
        }
        let hi = next_random(mut seed) * 32768 + next_random(mut seed);
        n = hi % n + 1;
        h = (h * 31 + confusing_number_ii(n)) % 1000000007;
    }
    println(f"200 random n: checksum {h}");
}
