// LeetCode #1088: Confusing Number II -- an explicit stack instead of
// recursion: each entry is a number made of the digits that rotate, its
// rotation and the power of ten for its next digit, as a `struct`; popping
// one pushes each digit that keeps it within n. The rotation of a digit
// comes from a `Map[i64, i64]`, and a digit that is not in it does not
// rotate. O(the numbers up to n made of those digits).

struct Partial {
    num: i64,
    rot: i64,
    unit: i64,
}

fn confusing_number_ii(n: i64) -> i64 {
    let mut turn: Map[i64, i64] = Map.new();
    turn.insert(0, 0);
    turn.insert(1, 1);
    turn.insert(6, 9);
    turn.insert(8, 8);
    turn.insert(9, 6);
    let mut count = 0;
    let mut stack: Vec[Partial] = [Partial { num: 0, rot: 0, unit: 1 }];
    while let Some(p) = stack.pop() {
        for d in 0..10 {
            if let Some(r) = turn.get(d) {
                let next = p.num * 10 + d;
                if next == 0 or next > n {
                    continue;
                }
                let rot = r * p.unit + p.rot;
                if next != rot {
                    count += 1;
                }
                stack.push(Partial { num: next, rot, unit: p.unit * 10 });
            }
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = [1, 6, 9, 10, 20, 100, 1000, 6969, 10000, 68986, 123456, 1000000];
    for n in cases.iter() {
        println(f"{n} -> {confusing_number_ii(n)}");
    }
    // every n from 1 to 1000
    let mut small = 0;
    for n in 1..=1000 {
        small += confusing_number_ii(n);
    }
    println(f"n = 1 to 1000: answers sum to {small}");
    // 200 random n up to 10^5, of 1 to 6 digits
    let mut seed = 1088;
    let mut h = 0;
    for _ in 0..200 {
        let digits = next_random(mut seed) % 6;
        let mut n = 1;
        for _ in 0..digits {
            n *= 10;
        }
        let hi = next_random(mut seed) * 32768 + next_random(mut seed);
        n = hi % n + 1;
        h = (h * 31 + confusing_number_ii(n)) % 1000000007;
    }
    println(f"200 random n: checksum {h}");
}
