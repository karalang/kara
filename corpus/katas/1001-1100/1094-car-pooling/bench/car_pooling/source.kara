// Benchmark: LeetCode #1094 Car Pooling -- the ★ arm, a difference array
// over the stops. 64 lists of 1000 trips each, LeetCode's most, of up to
// 100 passengers over stops 0 to 1000, are built once; each of 100 rounds
// changes one trip's passengers in every list and finds the smallest
// capacity the list fits, by binary search over 1 to 10^5 (17 calls), and
// folds it into a checksum. Mirrors car_pooling.rs, .c, .py and go-seq/.

fn car_pooling(trips: Vec[Vec[i64]], capacity: i64) -> bool {
    let mut change: Vec[i64] = Vec.filled(1001, 0);
    for t in trips.iter() {
        change[t[1]] += t[0];
        change[t[2]] -= t[0];
    }
    let mut aboard = 0;
    for c in change.iter() {
        aboard += c;
        if aboard > capacity {
            return false;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1094;
    let mut lists: Vec[Vec[Vec[i64]]] = [];
    for _ in 0..64 {
        let mut trips: Vec[Vec[i64]] = [];
        for _ in 0..1000 {
            let n = next_random(mut seed) % 100 + 1;
            let a = next_random(mut seed) % 1000;
            let b = a + 1 + next_random(mut seed) % (1000 - a);
            trips.push([n, a, b]);
        }
        lists.push(trips);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..100 {
        for j in 0..lists.len() {
            let k = (round * 7 + j * 13) % 1000;
            lists[j][k][0] = 1 + (lists[j][k][0] + round) % 100;
            let mut lo = 1;
            let mut hi = 100000;
            while lo < hi {
                let mid = (lo + hi) / 2;
                if car_pooling(lists[j], mid) {
                    hi = mid;
                } else {
                    lo = mid + 1;
                }
            }
            total += lo;
            check = (check * 31 + lo) % 1000000007;
        }
    }
    println(f"100 rounds over 64 lists of 1000 trips: smallest capacities sum to {total}, checksum {check}");
}
