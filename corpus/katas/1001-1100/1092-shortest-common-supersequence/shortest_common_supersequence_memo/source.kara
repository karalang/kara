// LeetCode #1092: Shortest Common Supersequence -- top-down: the shortest
// supersequence's length of the first i and j letters, by recursion with
// a `Map[(i64, i64), i64]` memo, so only the pairs the recursion reaches
// are computed. The answer is then read back from the end by asking the
// same function which step keeps the length, and reversed. O(|a| |b|) at
// most, with a recursion as deep as |a| + |b|.

fn shortest_len(x: Vec[char], y: Vec[char], i: i64, j: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i == 0 or j == 0 {
        return i + j;
    }
    if let Some(known) = memo.get((i, j)) {
        return known;
    }
    let len = if x[i - 1] == y[j - 1] {
        1 + shortest_len(x, y, i - 1, j - 1, mut memo)
    } else {
        1 + shortest_len(x, y, i - 1, j, mut memo).min(shortest_len(x, y, i, j - 1, mut memo))
    };
    memo.insert((i, j), len);
    len
}

fn shortest_common_supersequence(a: String, b: String) -> String {
    let x: Vec[char] = a.chars().collect();
    let y: Vec[char] = b.chars().collect();
    let mut memo: Map[(i64, i64), i64] = Map.new();
    let mut (i, j) = (x.len(), y.len());
    let mut out: Vec[char] = [];
    while i > 0 or j > 0 {
        if i == 0 {
            out.push(y[j - 1]);
            j -= 1;
        } else if j == 0 {
            out.push(x[i - 1]);
            i -= 1;
        } else if x[i - 1] == y[j - 1] {
            out.push(x[i - 1]);
            i -= 1;
            j -= 1;
        } else if shortest_len(x, y, i - 1, j, mut memo) <= shortest_len(x, y, i, j - 1, mut memo) {
            out.push(x[i - 1]);
            i -= 1;
        } else {
            out.push(y[j - 1]);
            j -= 1;
        }
    }
    out.reverse();
    out.iter().collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Whether `a` can be read out of `s` in order, skipping letters of `s`.
fn is_subsequence(a: String, s: String) -> bool {
    let mut it = s.chars();
    a.chars().all(|c| it.any(|d| d == c))
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    w
}

// The answer's length, and whether both words are in it: any shortest
// supersequence is right, so arms that break ties apart print alike.
fn judge(a: String, b: String) -> String {
    let s = shortest_common_supersequence(a, b);
    let ok = if is_subsequence(a, s) and is_subsequence(b, s) { "both in it" } else { "MISSING ONE" };
    f"{s.len()}, {ok}"
}

fn main() {
    let cases = [
        ("abac", "cab"),
        ("aaaaaaaa", "aaaaaaaa"),
        ("a", "b"),
        ("abc", "abc"),
        ("abc", "def"),
        ("abcde", "ace"),
        ("ace", "abcde"),
        ("geek", "eke"),
        ("aggtab", "gxtxayb"),
        ("bbbaaaba", "bbababbb"),
        ("leetcode", "codeleet"),
        ("z", "zzzzz"),
    ];
    for (a, b) in cases.iter() {
        println(f"{a} {b} -> {judge(a, b)}");
    }
    // 2000 random pairs of 1 to 12 letters from a to c
    let mut seed = 1092;
    let mut total = 0;
    let mut bad = 0;
    let mut h = 0;
    for _ in 0..2000 {
        let a = random_word(mut seed, next_random(mut seed) % 12 + 1, 3);
        let b = random_word(mut seed, next_random(mut seed) % 12 + 1, 3);
        let s = shortest_common_supersequence(a, b);
        if not (is_subsequence(a, s) and is_subsequence(b, s)) {
            bad += 1;
        }
        total += s.len();
        h = (h * 31 + s.len()) % 1000000007;
    }
    println(f"2000 random pairs: lengths sum to {total}, {bad} missing a word, checksum {h}");
    // LeetCode's longest, 1000 letters each, from 26 letters and from 4
    for letters in [26, 4] {
        let a = random_word(mut seed, 1000, letters);
        let b = random_word(mut seed, 1000, letters);
        println(f"1000 and 1000 letters from {letters}: {judge(a, b)}");
    }
}
