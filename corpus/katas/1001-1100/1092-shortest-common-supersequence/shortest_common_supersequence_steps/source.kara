// LeetCode #1092: Shortest Common Supersequence -- a table of steps: an
// `enum Step` per pair of suffixes says what the shortest supersequence of
// the rest writes first (the shared letter, `a`'s or `b`'s), filled from
// the ends with the lengths kept in two rows only, and the answer is read
// by following the steps from the first letters. O(|a| |b|) steps, O(|b|)
// lengths.

enum Step {
    Both,
    FromA,
    FromB,
}

fn shortest_common_supersequence(a: String, b: String) -> String {
    let x: Vec[char] = a.chars().collect();
    let y: Vec[char] = b.chars().collect();
    let (n, m) = (x.len(), y.len());
    let mut steps: Vec[Vec[Step]] = Vec.filled(n + 1, Vec.filled(m + 1, Step.Both));
    let mut below: Vec[i64] = (0..=m).map(|j| m - j).collect();
    for i in (0..n).rev() {
        let mut row = Vec.filled(m + 1, n - i);
        steps[i][m] = Step.FromA;
        for j in (0..m).rev() {
            if x[i] == y[j] {
                row[j] = 1 + below[j + 1];
                steps[i][j] = Step.Both;
            } else if below[j] <= row[j + 1] {
                row[j] = 1 + below[j];
                steps[i][j] = Step.FromA;
            } else {
                row[j] = 1 + row[j + 1];
                steps[i][j] = Step.FromB;
            }
        }
        below = row;
    }
    for j in 0..m {
        steps[n][j] = Step.FromB;
    }
    let mut out = String.new();
    let mut (i, j) = (0, 0);
    while i < n or j < m {
        match steps[i][j] {
            Step.Both => {
                out.push(x[i]);
                i += 1;
                j += 1;
            }
            Step.FromA => {
                out.push(x[i]);
                i += 1;
            }
            Step.FromB => {
                out.push(y[j]);
                j += 1;
            }
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Whether `a` can be read out of `s` in order, skipping letters of `s`.
fn is_subsequence(a: String, s: String) -> bool {
    let mut it = s.chars();
    a.chars().all(|c| it.any(|d| d == c))
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    w
}

// The answer's length, and whether both words are in it: any shortest
// supersequence is right, so arms that break ties apart print alike.
fn judge(a: String, b: String) -> String {
    let s = shortest_common_supersequence(a, b);
    let ok = if is_subsequence(a, s) and is_subsequence(b, s) { "both in it" } else { "MISSING ONE" };
    f"{s.len()}, {ok}"
}

fn main() {
    let cases = [
        ("abac", "cab"),
        ("aaaaaaaa", "aaaaaaaa"),
        ("a", "b"),
        ("abc", "abc"),
        ("abc", "def"),
        ("abcde", "ace"),
        ("ace", "abcde"),
        ("geek", "eke"),
        ("aggtab", "gxtxayb"),
        ("bbbaaaba", "bbababbb"),
        ("leetcode", "codeleet"),
        ("z", "zzzzz"),
    ];
    for (a, b) in cases.iter() {
        println(f"{a} {b} -> {judge(a, b)}");
    }
    // 2000 random pairs of 1 to 12 letters from a to c
    let mut seed = 1092;
    let mut total = 0;
    let mut bad = 0;
    let mut h = 0;
    for _ in 0..2000 {
        let a = random_word(mut seed, next_random(mut seed) % 12 + 1, 3);
        let b = random_word(mut seed, next_random(mut seed) % 12 + 1, 3);
        let s = shortest_common_supersequence(a, b);
        if not (is_subsequence(a, s) and is_subsequence(b, s)) {
            bad += 1;
        }
        total += s.len();
        h = (h * 31 + s.len()) % 1000000007;
    }
    println(f"2000 random pairs: lengths sum to {total}, {bad} missing a word, checksum {h}");
    // LeetCode's longest, 1000 letters each, from 26 letters and from 4
    for letters in [26, 4] {
        let a = random_word(mut seed, 1000, letters);
        let b = random_word(mut seed, 1000, letters);
        println(f"1000 and 1000 letters from {letters}: {judge(a, b)}");
    }
}
