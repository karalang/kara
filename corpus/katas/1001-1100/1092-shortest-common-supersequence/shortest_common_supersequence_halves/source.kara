// LeetCode #1092: Shortest Common Supersequence -- Hirschberg's linear-space
// LCS, then a merge: the LCS of the two words is found by splitting `a` in
// half, taking the LCS lengths of its first half against every prefix of
// `b` and of its second half, reversed, against every suffix (two rows
// each), and cutting `b` where their sum is largest; the halves recurse.
// The supersequence is then the two words merged along the LCS, each
// word's letters before the next common one written first. O(|a| |b|)
// time, O(|a| + |b|) space beyond the answer.

// The LCS lengths of `x` against every prefix of `y`, in one row.
fn lcs_row(x: Vec[char], y: Vec[char]) -> Vec[i64] {
    let mut prev = Vec.filled(y.len() + 1, 0);
    for c in x.iter() {
        let mut cur = Vec.filled(y.len() + 1, 0);
        for j in 1..=y.len() {
            cur[j] = if c == y[j - 1] { prev[j - 1] + 1 } else { prev[j].max(cur[j - 1]) };
        }
        prev = cur;
    }
    prev
}

fn lcs(x: Vec[char], y: Vec[char]) -> Vec[char] {
    if x.is_empty() or y.is_empty() {
        return [];
    }
    if x.len() == 1 {
        return if y.contains(x[0]) { [x[0]] } else { [] };
    }
    let half = x.len() / 2;
    let front = lcs_row(x[..half].to_vec(), y);
    let mut x_back = x[half..].to_vec();
    x_back.reverse();
    let mut y_back = y.clone();
    y_back.reverse();
    let back = lcs_row(x_back, y_back);
    let mut cut = 0;
    for k in 0..=y.len() {
        if front[k] + back[y.len() - k] > front[cut] + back[y.len() - cut] {
            cut = k;
        }
    }
    let mut left = lcs(x[..half].to_vec(), y[..cut].to_vec());
    left.extend(lcs(x[half..].to_vec(), y[cut..].to_vec()).iter());
    left
}

fn shortest_common_supersequence(a: String, b: String) -> String {
    let x: Vec[char] = a.chars().collect();
    let y: Vec[char] = b.chars().collect();
    let mut out = String.new();
    let mut (i, j) = (0, 0);
    for c in lcs(x, y).iter() {
        while x[i] != c {
            out.push(x[i]);
            i += 1;
        }
        while y[j] != c {
            out.push(y[j]);
            j += 1;
        }
        out.push(c);
        i += 1;
        j += 1;
    }
    out.extend(x[i..].iter());
    out.extend(y[j..].iter());
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Whether `a` can be read out of `s` in order, skipping letters of `s`.
fn is_subsequence(a: String, s: String) -> bool {
    let mut it = s.chars();
    a.chars().all(|c| it.any(|d| d == c))
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    w
}

// The answer's length, and whether both words are in it: any shortest
// supersequence is right, so arms that break ties apart print alike.
fn judge(a: String, b: String) -> String {
    let s = shortest_common_supersequence(a, b);
    let ok = if is_subsequence(a, s) and is_subsequence(b, s) { "both in it" } else { "MISSING ONE" };
    f"{s.len()}, {ok}"
}

fn main() {
    let cases = [
        ("abac", "cab"),
        ("aaaaaaaa", "aaaaaaaa"),
        ("a", "b"),
        ("abc", "abc"),
        ("abc", "def"),
        ("abcde", "ace"),
        ("ace", "abcde"),
        ("geek", "eke"),
        ("aggtab", "gxtxayb"),
        ("bbbaaaba", "bbababbb"),
        ("leetcode", "codeleet"),
        ("z", "zzzzz"),
    ];
    for (a, b) in cases.iter() {
        println(f"{a} {b} -> {judge(a, b)}");
    }
    // 2000 random pairs of 1 to 12 letters from a to c
    let mut seed = 1092;
    let mut total = 0;
    let mut bad = 0;
    let mut h = 0;
    for _ in 0..2000 {
        let a = random_word(mut seed, next_random(mut seed) % 12 + 1, 3);
        let b = random_word(mut seed, next_random(mut seed) % 12 + 1, 3);
        let s = shortest_common_supersequence(a, b);
        if not (is_subsequence(a, s) and is_subsequence(b, s)) {
            bad += 1;
        }
        total += s.len();
        h = (h * 31 + s.len()) % 1000000007;
    }
    println(f"2000 random pairs: lengths sum to {total}, {bad} missing a word, checksum {h}");
    // LeetCode's longest, 1000 letters each, from 26 letters and from 4
    for letters in [26, 4] {
        let a = random_word(mut seed, 1000, letters);
        let b = random_word(mut seed, 1000, letters);
        println(f"1000 and 1000 letters from {letters}: {judge(a, b)}");
    }
}
