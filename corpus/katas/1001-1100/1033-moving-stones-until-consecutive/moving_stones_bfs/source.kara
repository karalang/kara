// LeetCode #1033: Moving Stones Until Consecutive -- breadth-first, then step by step
//
// The fewest moves: a breadth-first search over the stones' positions,
// each move an end stone to any free place strictly between the ends,
// until the three touch. The most: move an end stone one place in each
// time, from the side with free places, counting until they touch; every
// move fills at least one free place inside the ends, so none does more.

fn sorted(a: i64, b: i64, c: i64) -> (i64, i64, i64) {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    (s[0], s[1], s[2])
}

fn num_moves_stones(a: i64, b: i64, c: i64) -> Vec[i64] {
    let start = sorted(a, b, c);
    let mut seen: Set[(i64, i64, i64)] = Set.new();
    let mut queue: VecDeque[((i64, i64, i64), i64)] = VecDeque.new();
    seen.insert(start);
    queue.push_back((start, 0));
    let mut fewest = -1;
    while let Some(((x, y, z), d)) = queue.pop_front() {
        if z - x == 2 {
            fewest = d;
            break;
        }
        for k in x + 1..z {
            if k != y {
                for next in vec![sorted(k, y, z), sorted(x, y, k)].iter() {
                    if not seen.contains(next) {
                        seen.insert(next);
                        queue.push_back((next, d + 1));
                    }
                }
            }
        }
    }
    let mut (x, y, z) = start;
    let mut most = 0;
    while z - x > 2 {
        if y - x > 1 {
            x += 1;
        } else {
            z -= 1;
        }
        most += 1;
    }
    vec![fewest, most]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(i64, i64, i64)] = vec![
        (1, 2, 5), (4, 3, 2), (3, 5, 1),
        (1, 3, 5), (1, 4, 7), (10, 1, 100), (50, 52, 49), (7, 1, 3),
    ];
    for (a, b, c) in examples.iter() {
        let moves = num_moves_stones(a, b, c);
        println(f"{a}, {b}, {c} -> [{moves[0]},{moves[1]}]");
    }
    // every three positions from 1 to `top`, in every order
    for top in vec![6, 20].iter() {
        let mut least = 0;
        let mut most = 0;
        let mut check = 0;
        let mut count = 0;
        for a in 1..top + 1 {
            for b in 1..top + 1 {
                for c in 1..top + 1 {
                    if a != b and b != c and a != c {
                        let moves = num_moves_stones(a, b, c);
                        least += moves[0];
                        most += moves[1];
                        check = (check * 131 + moves[0] * 101 + moves[1]) % 1000000007;
                        count += 1;
                    }
                }
            }
        }
        println(f"all {count} orders of three positions from 1 to {top}: minimum sum {least}, maximum sum {most}, checksum {check}");
    }
    // random positions from 1 to 100
    let mut seed = 1033;
    let mut least = 0;
    let mut most = 0;
    let mut check = 0;
    let mut count = 0;
    while count < 50 {
        let a = next_random(mut seed) % 100 + 1;
        let b = next_random(mut seed) % 100 + 1;
        let c = next_random(mut seed) % 100 + 1;
        if a != b and b != c and a != c {
            let moves = num_moves_stones(a, b, c);
            least += moves[0];
            most += moves[1];
            check = (check * 131 + moves[0] * 101 + moves[1]) % 1000000007;
            count += 1;
        }
    }
    println(f"50 random positions from 1 to 100: minimum sum {least}, maximum sum {most}, checksum {check}");
    // the widest spans
    for (a, b, c) in vec![(1, 50, 100), (1, 2, 100), (1, 99, 100), (98, 99, 100), (100, 1, 3)].iter() {
        let moves = num_moves_stones(a, b, c);
        println(f"{a}, {b}, {c} -> [{moves[0]},{moves[1]}]");
    }
}
