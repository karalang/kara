// LeetCode #1033: Moving Stones Until Consecutive -- differential
//
// The six arms, copied here under their own names, against the statement
// read literally and five properties of the answer.

// ---- by the gaps (moving_stones.kara)

fn gaps_arm(a: i64, b: i64, c: i64) -> Vec[i64] {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    let (x, y, z) = (s[0], s[1], s[2]);
    let fewest = if z - x == 2 {
        0
    } else if y - x <= 2 or z - y <= 2 {
        1
    } else {
        2
    };
    vec![fewest, z - x - 2]
}

// ---- recursion over the gaps (moving_stones_memo.kara)

fn memo_moves_from(g1: i64, g2: i64, memo: mut ref Map[(i64, i64), (i64, i64)]) -> (i64, i64) {
    if g1 == 0 and g2 == 0 {
        return (0, 0);
    }
    if let Some(known) = memo.get((g1, g2)) {
        return known;
    }
    let mut next: Vec[(i64, i64)] = Vec.new();
    for j in 0..g1 {
        next.push((j, g2));
        next.push((j, g1 - 1 - j));
    }
    for j in 0..g2 {
        next.push((g1, j));
        next.push((j, g2 - 1 - j));
    }
    let mut fewest = i64.MAX;
    let mut most = 0;
    for (h1, h2) in next.iter() {
        let (f, m) = memo_moves_from(h1, h2, mut memo);
        fewest = fewest.min(f + 1);
        most = most.max(m + 1);
    }
    memo.insert((g1, g2), (fewest, most));
    (fewest, most)
}

fn memo_arm(a: i64, b: i64, c: i64) -> Vec[i64] {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    let mut memo: Map[(i64, i64), (i64, i64)] = Map.new();
    let (fewest, most) = memo_moves_from(s[1] - s[0] - 1, s[2] - s[1] - 1, mut memo);
    vec![fewest, most]
}

// ---- a table over the gaps (moving_stones_table.kara)

fn table_arm(a: i64, b: i64, c: i64) -> Vec[i64] {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    let (top1, top2) = (s[1] - s[0] - 1, s[2] - s[1] - 1);
    let size = top1 + top2 + 1;
    let mut fewest: Vec[Vec[i64]] = Vec.filled(size, Vec.filled(size, 0));
    let mut most: Vec[Vec[i64]] = Vec.filled(size, Vec.filled(size, 0));
    for total in 1..size {
        for g1 in 0..total + 1 {
            let g2 = total - g1;
            let mut f = i64.MAX;
            let mut m = 0;
            for j in 0..g1 {
                f = f.min(fewest[j][g2] + 1).min(fewest[j][g1 - 1 - j] + 1);
                m = m.max(most[j][g2] + 1).max(most[j][g1 - 1 - j] + 1);
            }
            for j in 0..g2 {
                f = f.min(fewest[g1][j] + 1).min(fewest[j][g2 - 1 - j] + 1);
                m = m.max(most[g1][j] + 1).max(most[j][g2 - 1 - j] + 1);
            }
            fewest[g1][g2] = f;
            most[g1][g2] = m;
        }
    }
    vec![fewest[top1][top2], most[top1][top2]]
}

// ---- breadth-first, then step by step (moving_stones_bfs.kara)

fn bfs_sorted(a: i64, b: i64, c: i64) -> (i64, i64, i64) {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    (s[0], s[1], s[2])
}

fn bfs_arm(a: i64, b: i64, c: i64) -> Vec[i64] {
    let start = bfs_sorted(a, b, c);
    let mut seen: Set[(i64, i64, i64)] = Set.new();
    let mut queue: VecDeque[((i64, i64, i64), i64)] = VecDeque.new();
    seen.insert(start);
    queue.push_back((start, 0));
    let mut fewest = -1;
    while let Some(((x, y, z), d)) = queue.pop_front() {
        if z - x == 2 {
            fewest = d;
            break;
        }
        for k in x + 1..z {
            if k != y {
                for next in vec![bfs_sorted(k, y, z), bfs_sorted(x, y, k)].iter() {
                    if not seen.contains(next) {
                        seen.insert(next);
                        queue.push_back((next, d + 1));
                    }
                }
            }
        }
    }
    let mut (x, y, z) = start;
    let mut most = 0;
    while z - x > 2 {
        if y - x > 1 {
            x += 1;
        } else {
            z -= 1;
        }
        most += 1;
    }
    vec![fewest, most]
}

// ---- a board and a window (moving_stones_window.kara)

fn window_arm(a: i64, b: i64, c: i64) -> Vec[i64] {
    let low = a.min(b).min(c);
    let high = a.max(b).max(c);
    let mut board: Vec[bool] = Vec.filled(high - low + 1, false);
    for p in vec![a, b, c].iter() {
        board[p - low] = true;
    }
    let mut free = 0;
    for place in board.iter() {
        if not place {
            free += 1;
        }
    }
    let mut best = 0;
    for start in 0..board.len() {
        let mut held = 0;
        for p in start..(start + 3).min(board.len()) {
            if board[p] {
                held += 1;
            }
        }
        best = best.max(held);
    }
    vec![3 - best, free]
}

// ---- trying the moves (moving_stones_steps.kara)

fn steps_touching(p: ref Vec[i64]) -> bool {
    let mut s = p.clone();
    s.sort();
    s[2] - s[0] == 2
}

fn steps_arm(a: i64, b: i64, c: i64) -> Vec[i64] {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    let mut fewest = 2;
    if steps_touching(s) {
        fewest = 0;
    } else {
        for k in s[0] + 1..s[2] {
            if k != s[1] and (steps_touching(vec![k, s[1], s[2]]) or steps_touching(vec![s[0], s[1], k])) {
                fewest = 1;
            }
        }
    }
    let mut most = 0;
    while not steps_touching(s) {
        if s[1] - s[0] > 1 {
            s[0] += 1;
        } else {
            s[2] -= 1;
        }
        most += 1;
    }
    vec![fewest, most]
}

// ---- the checks

fn arms(a: i64, b: i64, c: i64) -> Vec[Vec[i64]] {
    vec![gaps_arm(a, b, c), memo_arm(a, b, c), table_arm(a, b, c), bfs_arm(a, b, c), window_arm(a, b, c), steps_arm(a, b, c)]
}

// The statement read literally: stones at x < y < z; a move picks up the
// stone at x or at z and puts it at any k with x < k < z and k != y; the
// game ends when the stones are at three consecutive places. The fewest
// and the most moves to the end over every way to play, searched over the
// positions themselves and kept in `seen`, which holds for every case
// because a position's answer does not depend on how it was reached.
fn literal(a: i64, b: i64, c: i64, seen: mut ref Map[(i64, i64, i64), (i64, i64)]) -> (i64, i64) {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    let (x, y, z) = (s[0], s[1], s[2]);
    if z - x == 2 {
        return (0, 0);
    }
    if let Some(known) = seen.get((x, y, z)) {
        return known;
    }
    let mut fewest = i64.MAX;
    let mut most = 0;
    for k in x + 1..z {
        if k != y {
            let (f1, m1) = literal(k, y, z, mut seen);
            let (f2, m2) = literal(x, y, k, mut seen);
            fewest = fewest.min(f1 + 1).min(f2 + 1);
            most = most.max(m1 + 1).max(m2 + 1);
        }
    }
    seen.insert((x, y, z), (fewest, most));
    (fewest, most)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut failures: Vec[i64] = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 10331;
    let mut seen: Map[(i64, i64, i64), (i64, i64)] = Map.new();
    // every order of three places from 1 to 8; then 300 random triples
    // from 1 to 25, searched in full too, and 6 from 1 to 100
    let mut cases: Vec[(i64, i64, i64)] = Vec.new();
    for a in 1..9 {
        for b in 1..9 {
            for c in 1..9 {
                if a != b and b != c and a != c {
                    cases.push((a, b, c));
                }
            }
        }
    }
    while cases.len() < 336 + 306 {
        let top = if cases.len() < 336 + 300 { 25 } else { 100 };
        let a = next_random(mut seed) % top + 1;
        let b = next_random(mut seed) % top + 1;
        let c = next_random(mut seed) % top + 1;
        if a != b and b != c and a != c {
            cases.push((a, b, c));
        }
    }
    let mut searched = 0;
    for (a, b, c) in cases.iter() {
        let got = arms(a, b, c);
        check = (check * 131 + got[0][0] * 101 + got[0][1]) % 1000000007;
        let low = a.min(b).min(c);
        let high = a.max(b).max(c);
        let wide = high - low > 24;
        let (want_fewest, want_most) = if wide { (-1, -1) } else { searched += 1; literal(a, b, c, mut seen) };
        // P2: the same stones given in another order
        let got_turned = arms(c, a, b);
        // P3: every stone moved along by the same amount
        let shift = next_random(mut seed) % 50 + 1;
        let got_shifted = arms(a + shift, b + shift, c + shift);
        // P4: the line read the other way
        let got_mirrored = arms(high + low - a, high + low - b, high + low - c);
        for k in 0..6 {
            // P1: the statement read literally, on spans of at most 25
            // places
            if not wide {
                checks += 1;
                if got[k][0] != want_fewest or got[k][1] != want_most {
                    failures[0] += 1;
                }
            }
            // P2: which stone is named first does not matter
            checks += 1;
            if got_turned[k] != got[k] {
                failures[1] += 1;
            }
            // P3: only the distances between the stones matter
            checks += 1;
            if got_shifted[k] != got[k] {
                failures[2] += 1;
            }
            // P4: a move at the low end mirrors one at the high end
            checks += 1;
            if got_mirrored[k] != got[k] {
                failures[3] += 1;
            }
            // P5: the fewest is 0, 1 or 2, and 0 exactly when the stones
            // touch; it is at most the most, and the most is at most the
            // free places between the end stones, since each move fills one
            checks += 1;
            let touching = high - low == 2;
            if got[k][0] < 0 or got[k][0] > 2 or (got[k][0] == 0) != touching or got[k][0] > got[k][1] or got[k][1] > high - low - 2 {
                failures[4] += 1;
            }
            // P6: each arm agrees with at least two of the other five
            checks += 1;
            let mut agree = 0;
            for o in 0..6 {
                if o != k and got[o] == got[k] {
                    agree += 1;
                }
            }
            if agree < 2 {
                failures[5] += 1;
            }
        }
    }
    let mut total = 0;
    for p in 0..6 {
        if failures[p] > 0 {
            println(f"P{p + 1}: {failures[p]} failures");
        }
        total += failures[p];
    }
    println(f"{cases.len()} cases ({searched} searched in full): checksum {check}, {checks} checks over 6 arms: {total} failures");
}
