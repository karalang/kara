// LeetCode #1033: Moving Stones Until Consecutive -- recursion over the gaps
//
// Only the two gaps matter: g1 free places between the low stone and the
// middle one, g2 between the middle one and the high one. Moving the low
// stone into its own gap leaves (j, g2) for any j below g1; moving it into
// the other gap splits g2 - 1 free places as (j, g2 - 1 - j); the high
// stone mirrors both. The fewest and most moves to (0, 0) are the best of
// one plus each move's, kept in a `Map` keyed by the gaps. O(g^3).

fn moves_from(g1: i64, g2: i64, memo: mut ref Map[(i64, i64), (i64, i64)]) -> (i64, i64) {
    if g1 == 0 and g2 == 0 {
        return (0, 0);
    }
    if let Some(known) = memo.get((g1, g2)) {
        return known;
    }
    let mut next: Vec[(i64, i64)] = Vec.new();
    for j in 0..g1 {
        next.push((j, g2));
        next.push((j, g1 - 1 - j));
    }
    for j in 0..g2 {
        next.push((g1, j));
        next.push((j, g2 - 1 - j));
    }
    let mut fewest = i64.MAX;
    let mut most = 0;
    for (h1, h2) in next.iter() {
        let (f, m) = moves_from(h1, h2, mut memo);
        fewest = fewest.min(f + 1);
        most = most.max(m + 1);
    }
    memo.insert((g1, g2), (fewest, most));
    (fewest, most)
}

fn num_moves_stones(a: i64, b: i64, c: i64) -> Vec[i64] {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    let mut memo: Map[(i64, i64), (i64, i64)] = Map.new();
    let (fewest, most) = moves_from(s[1] - s[0] - 1, s[2] - s[1] - 1, mut memo);
    vec![fewest, most]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(i64, i64, i64)] = vec![
        (1, 2, 5), (4, 3, 2), (3, 5, 1),
        (1, 3, 5), (1, 4, 7), (10, 1, 100), (50, 52, 49), (7, 1, 3),
    ];
    for (a, b, c) in examples.iter() {
        let moves = num_moves_stones(a, b, c);
        println(f"{a}, {b}, {c} -> [{moves[0]},{moves[1]}]");
    }
    // every three positions from 1 to `top`, in every order
    for top in vec![6, 20].iter() {
        let mut least = 0;
        let mut most = 0;
        let mut check = 0;
        let mut count = 0;
        for a in 1..top + 1 {
            for b in 1..top + 1 {
                for c in 1..top + 1 {
                    if a != b and b != c and a != c {
                        let moves = num_moves_stones(a, b, c);
                        least += moves[0];
                        most += moves[1];
                        check = (check * 131 + moves[0] * 101 + moves[1]) % 1000000007;
                        count += 1;
                    }
                }
            }
        }
        println(f"all {count} orders of three positions from 1 to {top}: minimum sum {least}, maximum sum {most}, checksum {check}");
    }
    // random positions from 1 to 100
    let mut seed = 1033;
    let mut least = 0;
    let mut most = 0;
    let mut check = 0;
    let mut count = 0;
    while count < 50 {
        let a = next_random(mut seed) % 100 + 1;
        let b = next_random(mut seed) % 100 + 1;
        let c = next_random(mut seed) % 100 + 1;
        if a != b and b != c and a != c {
            let moves = num_moves_stones(a, b, c);
            least += moves[0];
            most += moves[1];
            check = (check * 131 + moves[0] * 101 + moves[1]) % 1000000007;
            count += 1;
        }
    }
    println(f"50 random positions from 1 to 100: minimum sum {least}, maximum sum {most}, checksum {check}");
    // the widest spans
    for (a, b, c) in vec![(1, 50, 100), (1, 2, 100), (1, 99, 100), (98, 99, 100), (100, 1, 3)].iter() {
        let moves = num_moves_stones(a, b, c);
        println(f"{a}, {b}, {c} -> [{moves[0]},{moves[1]}]");
    }
}
