// LeetCode #1033: Moving Stones Until Consecutive -- a table over the gaps
//
// The same moves as the memo arm, between gap pairs (g1, g2), filled
// bottom-up: every move leaves fewer free places in all, so a table
// filled in order of g1 + g2 has every move's answer ready. fewest[g1][g2]
// and most[g1][g2] count the moves to (0, 0). O(g^3).

fn num_moves_stones(a: i64, b: i64, c: i64) -> Vec[i64] {
    let mut s: Vec[i64] = vec![a, b, c];
    s.sort();
    let (top1, top2) = (s[1] - s[0] - 1, s[2] - s[1] - 1);
    let size = top1 + top2 + 1;
    let mut fewest: Vec[Vec[i64]] = Vec.filled(size, Vec.filled(size, 0));
    let mut most: Vec[Vec[i64]] = Vec.filled(size, Vec.filled(size, 0));
    for total in 1..size {
        for g1 in 0..total + 1 {
            let g2 = total - g1;
            let mut f = i64.MAX;
            let mut m = 0;
            for j in 0..g1 {
                f = f.min(fewest[j][g2] + 1).min(fewest[j][g1 - 1 - j] + 1);
                m = m.max(most[j][g2] + 1).max(most[j][g1 - 1 - j] + 1);
            }
            for j in 0..g2 {
                f = f.min(fewest[g1][j] + 1).min(fewest[j][g2 - 1 - j] + 1);
                m = m.max(most[g1][j] + 1).max(most[j][g2 - 1 - j] + 1);
            }
            fewest[g1][g2] = f;
            most[g1][g2] = m;
        }
    }
    vec![fewest[top1][top2], most[top1][top2]]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(i64, i64, i64)] = vec![
        (1, 2, 5), (4, 3, 2), (3, 5, 1),
        (1, 3, 5), (1, 4, 7), (10, 1, 100), (50, 52, 49), (7, 1, 3),
    ];
    for (a, b, c) in examples.iter() {
        let moves = num_moves_stones(a, b, c);
        println(f"{a}, {b}, {c} -> [{moves[0]},{moves[1]}]");
    }
    // every three positions from 1 to `top`, in every order
    for top in vec![6, 20].iter() {
        let mut least = 0;
        let mut most = 0;
        let mut check = 0;
        let mut count = 0;
        for a in 1..top + 1 {
            for b in 1..top + 1 {
                for c in 1..top + 1 {
                    if a != b and b != c and a != c {
                        let moves = num_moves_stones(a, b, c);
                        least += moves[0];
                        most += moves[1];
                        check = (check * 131 + moves[0] * 101 + moves[1]) % 1000000007;
                        count += 1;
                    }
                }
            }
        }
        println(f"all {count} orders of three positions from 1 to {top}: minimum sum {least}, maximum sum {most}, checksum {check}");
    }
    // random positions from 1 to 100
    let mut seed = 1033;
    let mut least = 0;
    let mut most = 0;
    let mut check = 0;
    let mut count = 0;
    while count < 50 {
        let a = next_random(mut seed) % 100 + 1;
        let b = next_random(mut seed) % 100 + 1;
        let c = next_random(mut seed) % 100 + 1;
        if a != b and b != c and a != c {
            let moves = num_moves_stones(a, b, c);
            least += moves[0];
            most += moves[1];
            check = (check * 131 + moves[0] * 101 + moves[1]) % 1000000007;
            count += 1;
        }
    }
    println(f"50 random positions from 1 to 100: minimum sum {least}, maximum sum {most}, checksum {check}");
    // the widest spans
    for (a, b, c) in vec![(1, 50, 100), (1, 2, 100), (1, 99, 100), (98, 99, 100), (100, 1, 3)].iter() {
        let moves = num_moves_stones(a, b, c);
        println(f"{a}, {b}, {c} -> [{moves[0]},{moves[1]}]");
    }
}
