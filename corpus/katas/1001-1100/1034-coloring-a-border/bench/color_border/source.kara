// LeetCode #1034: Coloring A Border -- bench
// Mirrors ../color_border.kara; see ../README.md § Benchmarks.

fn visit(grid: ref Vec[Vec[i64]], r: i64, c: i64, color: i64, seen: mut ref Vec[Vec[bool]], out: mut ref Vec[Vec[i64]]) {
    seen[r][c] = true;
    let m = grid.len();
    let n = grid[0].len();
    let mut border = false;
    for (dr, dc) in vec![(-1, 0), (1, 0), (0, -1), (0, 1)].iter() {
        let (nr, nc) = (r + dr, c + dc);
        if nr < 0 or nr >= m or nc < 0 or nc >= n or grid[nr][nc] != grid[r][c] {
            border = true;
        } else if not seen[nr][nc] {
            visit(grid, nr, nc, color, mut seen, mut out);
        }
    }
    if border {
        out[r][c] = color;
    }
}

fn color_border(grid: ref Vec[Vec[i64]], row: i64, col: i64, color: i64) -> Vec[Vec[i64]] {
    let mut seen: Vec[Vec[bool]] = Vec.filled(grid.len(), Vec.filled(grid[0].len(), false));
    let mut out = grid.clone();
    visit(grid, row, col, color, mut seen, mut out);
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let starts = 10;
    let rounds = 20;
    let mut seed = 1034;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut asks: Vec[(i64, i64, i64, i64)] = Vec.new();
    for g in 0..count {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..50 {
            let mut line: Vec[i64] = Vec.new();
            for _ in 0..50 {
                line.push(if next_random(mut seed) % 3 == 0 { 2 } else { 1 });
            }
            grid.push(line);
        }
        grids.push(grid);
        for _ in 0..starts {
            asks.push((g, next_random(mut seed) % 50, next_random(mut seed) % 50, next_random(mut seed) % 3 + 1));
        }
    }
    let mut changed = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for (g, row, col, color) in asks.iter() {
            let grid = ref grids[g];
            let painted = color_border(grid, row, col, color);
            for r in 0..50 {
                for c in 0..50 {
                    if painted[r][c] != grid[r][c] {
                        changed += 1;
                        check = (check * 131 + r * 50 + c) % 1000000007;
                    }
                }
            }
        }
    }
    println(f"{count} grids of 50 by 50, {starts} starts each, {rounds} rounds: {changed} squares changed, checksum {check}");
}
