// LeetCode #1062: Longest Repeating Substring -- the ★ arm. A length has a
// repeat only if every shorter one does, so a binary search on the length
// asks one question per step: does some substring of length `len` occur
// twice? A rolling hash answers it, each match checked byte for byte.
// O(n log n) expected.

const MOD: i64 = 1000000007;
const BASE: i64 = 131;

// Whether two starts in `s` hold the same `len` bytes.
fn twice(s: Slice[u8], len: i64) -> bool {
    if len == 0 {
        return true;
    }
    let mut top = 1;
    for _ in 1..len {
        top = top * BASE % MOD;
    }
    let mut hash = 0;
    let mut seen: Map[i64, Vec[i64]] = Map.new();
    for i in 0..s.len() {
        if i >= len {
            hash = (hash - s[i - len] * top % MOD + MOD) % MOD;
        }
        hash = (hash * BASE + s[i]) % MOD;
        if i + 1 >= len {
            let start = i + 1 - len;
            let starts = seen.entry(hash).or_insert(Vec.new());
            for other in starts.iter() {
                if s[other..other + len] == s[start..start + len] {
                    return true;
                }
            }
            starts.push(start);
        }
    }
    false
}

fn longest_repeating(s: String) -> i64 {
    let bytes = s.bytes();
    // twice(lo) and not twice(hi)
    let mut lo = 0;
    let mut hi = bytes.len();
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2;
        if twice(bytes, mid) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters drawn from the first `k` of the alphabet.
fn random_word(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

fn main() {
    // LeetCode's examples, then a few more
    for s in ["abcd", "abbaba", "aabcaabdaab", "aaaaa", "a", "ab", "aa", "abab", "abcabcabc", "mississippi"] {
        println(f"{s} -> {longest_repeating(s)}");
    }
    let mut seed = 1062;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        let k = next_random(mut seed) % 3 + 1;
        let answer = longest_repeating(random_word(n, k, mut seed));
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"3000 strings of 1 to 12 letters over 1 to 3: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for i in 0..300 {
        let n = next_random(mut seed) % 251 + 50;
        let answer = longest_repeating(random_word(n, 2 + i % 25, mut seed));
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"300 strings of 50 to 300 letters over 2 to 26: sum {sum}, checksum {check}");
    // the longest strings: 2000 letters, over 2, 4 and 26
    for k in [2, 4, 26] {
        println(f"2000 letters over {k}: {longest_repeating(random_word(2000, k, mut seed))}");
    }
    // a Fibonacci word, rich in long repeats, and one letter 2000 times
    let mut a = "a".to_string();
    let mut b = "ab".to_string();
    while b.len() < 2000 {
        let next = b.clone() + a;
        a = b;
        b = next;
    }
    let fib = b.substring(0, 2000);
    println(f"Fibonacci word of 2000: {longest_repeating(fib)}");
    let mut same = String.new();
    for _ in 0..2000 {
        same.push('z');
    }
    println(f"2000 z's: {longest_repeating(same)}");
}
