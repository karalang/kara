// LeetCode #1057: Campus Bikes -- the benchmark: the ★ arm on 20 campuses
// of 300 workers and 400 bikes on 1000 by 1000, built once, 8 rounds.
fn assign_bikes(workers: ref Vec[(i64, i64)], bikes: ref Vec[(i64, i64)]) -> Vec[i64] {
    let mut buckets: Vec[Vec[(i64, i64)]] = Vec.filled(2000, Vec.new());
    for (w, (wx, wy)) in workers.iter().enumerate() {
        for (b, (bx, by)) in bikes.iter().enumerate() {
            let d = (wx - bx).abs() + (wy - by).abs();
            buckets[d].push((w, b));
        }
    }
    let mut bike_of = Vec.filled(workers.len(), -1);
    let mut taken = Vec.filled(bikes.len(), false);
    let mut left = workers.len();
    for bucket in buckets.iter() {
        for (w, b) in bucket.iter() {
            if left > 0 and bike_of[w] < 0 and not taken[b] {
                bike_of[w] = b;
                taken[b] = true;
                left -= 1;
            }
        }
    }
    bike_of
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_places(count: i64, seed: mut ref i64) -> Vec[(i64, i64)] {
    let mut places: Vec[(i64, i64)] = Vec.new();
    for _ in 0..count {
        let x = next_random(mut seed) % 1000;
        let y = next_random(mut seed) % 1000;
        places.push((x, y));
    }
    places
}

fn main() {
    let count = 20;
    let rounds = 8;
    let mut seed = 1057;
    let mut campuses: Vec[(Vec[(i64, i64)], Vec[(i64, i64)])] = Vec.new();
    for _ in 0..count {
        let workers = random_places(300, mut seed);
        let bikes = random_places(400, mut seed);
        campuses.push((workers, bikes));
    }
    let mut ridden = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for (workers, bikes) in campuses.iter() {
            let answer = assign_bikes(workers, bikes);
            for (w, b) in answer.iter().enumerate() {
                ridden += (workers[w].0 - bikes[b].0).abs() + (workers[w].1 - bikes[b].1).abs();
                check = (check * 131 + b + 1) % 1000000007;
            }
        }
    }
    println(f"{count} campuses of 300 workers and 400 bikes, {rounds} rounds: {ridden} ridden, checksum {check}");
}
