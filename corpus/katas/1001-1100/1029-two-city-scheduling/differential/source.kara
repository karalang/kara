// LeetCode #1029: Two City Scheduling -- differential
//
// The five arms, copied, against the statement read literally and five
// more properties. See README.md § Differential.

fn d_star(costs: Vec[Vec[i64]]) -> i64 {
    let mut order = costs.clone();
    order.sort_by_key(|c| c[0] - c[1]);
    let half = order.len() / 2;
    let mut total = 0;
    for i in 0..order.len() {
        total += if i < half { order[i][0] } else { order[i][1] };
    }
    total
}

fn d_dp(costs: Vec[Vec[i64]]) -> i64 {
    let people = costs.len();
    let half = people / 2;
    let none = i64.MAX;
    let mut cheapest: Vec[Vec[i64]] = Vec.filled(people + 1, Vec.filled(half + 1, none));
    cheapest[0][0] = 0;
    for i in 1..people + 1 {
        for j in 0..half + 1 {
            let mut best = none;
            if j > 0 and cheapest[i - 1][j - 1] != none {
                best = cheapest[i - 1][j - 1] + costs[i - 1][0];
            }
            if cheapest[i - 1][j] != none {
                best = best.min(cheapest[i - 1][j] + costs[i - 1][1]);
            }
            cheapest[i][j] = best;
        }
    }
    cheapest[people][half]
}

fn memo_least(costs: ref Vec[Vec[i64]], i: i64, left_a: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i == costs.len() {
        return 0;
    }
    if let Some(known) = memo.get((i, left_a)) {
        return known;
    }
    let left_b = costs.len() - i - left_a;
    let mut best = i64.MAX;
    if left_a > 0 {
        best = costs[i][0] + memo_least(costs, i + 1, left_a - 1, mut memo);
    }
    if left_b > 0 {
        best = best.min(costs[i][1] + memo_least(costs, i + 1, left_a, mut memo));
    }
    memo.insert((i, left_a), best);
    best
}

fn d_memo(costs: Vec[Vec[i64]]) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    memo_least(costs, 0, costs.len() / 2, mut memo)
}

fn d_buckets(costs: Vec[Vec[i64]]) -> i64 {
    let mut at: Vec[i64] = Vec.filled(1999, 0);
    let mut total = 0;
    for c in costs.iter() {
        at[c[0] - c[1] + 999] += 1;
        total += c[1];
    }
    let mut places = costs.len() / 2;
    let mut d = 0;
    while places > 0 {
        let take = at[d].min(places);
        total += take * (d - 999);
        places -= take;
        d += 1;
    }
    total
}

fn d_swaps(costs: Vec[Vec[i64]]) -> i64 {
    let people = costs.len();
    let mut in_a: Vec[bool] = Vec.new();
    for i in 0..people {
        in_a.push(i < people / 2);
    }
    let mut improved = true;
    while improved {
        improved = false;
        for i in 0..people {
            for j in 0..people {
                if in_a[i] and not in_a[j] and costs[i][1] - costs[i][0] + costs[j][0] - costs[j][1] < 0 {
                    in_a[i] = false;
                    in_a[j] = true;
                    improved = true;
                }
            }
        }
    }
    let mut total = 0;
    for i in 0..people {
        total += if in_a[i] { costs[i][0] } else { costs[i][1] };
    }
    total
}

fn arms(costs: ref Vec[Vec[i64]]) -> Vec[i64] {
    vec![d_star(costs), d_dp(costs), d_memo(costs), d_buckets(costs), d_swaps(costs)]
}

// the statement read literally: of every way to send exactly half the
// people to city a and the rest to b, the cheapest
fn literal(costs: ref Vec[Vec[i64]]) -> i64 {
    let people = costs.len();
    let mut best = i64.MAX;
    for mask in 0..(1 << people) {
        let mut to_a = 0;
        let mut total = 0;
        for i in 0..people {
            if (mask >> i) & 1 == 1 {
                to_a += 1;
                total += costs[i][0];
            } else {
                total += costs[i][1];
            }
        }
        if to_a * 2 == people {
            best = best.min(total);
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut failures: Vec[i64] = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 10291;
    // every case of 2 people with costs 1 to 4, and of 4 people with
    // costs 1 or 2; then 800 random cases of 2 to 10 people and 40 of 12
    // to 100, with costs up to 3, 20 or 950
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for code in 0..256 {
        let mut costs: Vec[Vec[i64]] = Vec.new();
        for i in 0..2 {
            costs.push(vec![(code >> (4 * i)) % 4 + 1, (code >> (4 * i + 2)) % 4 + 1]);
        }
        cases.push(costs);
    }
    for code in 0..256 {
        let mut costs: Vec[Vec[i64]] = Vec.new();
        for i in 0..4 {
            costs.push(vec![(code >> (2 * i)) % 2 + 1, (code >> (2 * i + 1)) % 2 + 1]);
        }
        cases.push(costs);
    }
    let tops: Vec[i64] = vec![3, 20, 950];
    for k in 0..840 {
        let people = if k < 800 { 2 * (1 + next_random(mut seed) % 5) } else { 2 * (6 + next_random(mut seed) % 45) };
        let top = tops[next_random(mut seed) % 3];
        let mut costs: Vec[Vec[i64]] = Vec.new();
        for _ in 0..people {
            costs.push(vec![next_random(mut seed) % top + 1, next_random(mut seed) % top + 1]);
        }
        cases.push(costs);
    }
    let mut searched = 0;
    for costs in cases.iter() {
        let people = costs.len();
        let got = arms(costs);
        check = (check * 131 + got[0]) % 1000000007;
        let want = if people <= 10 { searched += 1; literal(costs) } else { -1 };
        // P2: the people in the opposite order
        let mut reversed: Vec[Vec[i64]] = Vec.new();
        for i in 0..people {
            reversed.push(costs[people - 1 - i].clone());
        }
        let got_reversed = arms(reversed);
        // P3: every person's two costs the other way round
        let mut swapped: Vec[Vec[i64]] = Vec.new();
        for c in costs.iter() {
            swapped.push(vec![c[1], c[0]]);
        }
        let got_swapped = arms(swapped);
        // P4: every cost raised by the same amount
        let shift = next_random(mut seed) % 50 + 1;
        let mut shifted: Vec[Vec[i64]] = Vec.new();
        for c in costs.iter() {
            shifted.push(vec![c[0] + shift, c[1] + shift]);
        }
        let got_shifted = arms(shifted);
        // P5: one cost of one person raised
        let who = next_random(mut seed) % people;
        let city = next_random(mut seed) % 2;
        let rise = next_random(mut seed) % 50 + 1;
        let mut raised = costs.clone();
        raised[who][city] += rise;
        let got_raised = arms(raised);
        for a in 0..5 {
            // P1: the statement read literally, on cases of at most 10
            // people
            if people <= 10 {
                checks += 1;
                if got[a] != want {
                    failures[0] += 1;
                }
            }
            // P2: the order of the people does not matter
            checks += 1;
            if got_reversed[a] != got[a] {
                failures[1] += 1;
            }
            // P3: sending half to each city, the two cities can trade
            // names
            checks += 1;
            if got_swapped[a] != got[a] {
                failures[2] += 1;
            }
            // P4: every cost up by `shift` puts every person's fare up by
            // it
            checks += 1;
            if got_shifted[a] != got[a] + shift * people {
                failures[3] += 1;
            }
            // P5: one cost up by `rise` puts the answer up by 0 to `rise`
            checks += 1;
            if got_raised[a] < got[a] or got_raised[a] > got[a] + rise {
                failures[4] += 1;
            }
            // P6: each arm agrees with at least two of the other four
            checks += 1;
            let mut agree = 0;
            for o in 0..5 {
                if o != a and got[o] == got[a] {
                    agree += 1;
                }
            }
            if agree < 2 {
                failures[5] += 1;
            }
        }
    }
    let mut total = 0;
    for p in 0..6 {
        if failures[p] > 0 {
            println(f"P{p + 1}: {failures[p]} failures");
        }
        total += failures[p];
    }
    println(f"{cases.len()} cases ({searched} searched in full): checksum {check}, {checks} checks over 5 arms: {total} failures");
}
