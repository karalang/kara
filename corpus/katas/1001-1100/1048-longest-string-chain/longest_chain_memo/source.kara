// LeetCode #1048: Longest String Chain -- down from each word, remembered.
//
// The longest chain ending at a word is one more than the longest ending at
// any of its predecessors that is in the list, found by recursion down to
// words with none. Each word's answer is kept in a map, so it is worked out
// once. O(n L^2).

fn ending_at(w: Str, words: ref Set[String], memo: mut ref Map[String, i64]) -> i64 {
    if let Some(n) = memo.get(w) {
        return *n;
    }
    let mut best = 1;
    for i in 0..w.len() {
        let pred = w[0..i].to_string() + w[i + 1..w.len()].to_string();
        if words.contains(pred) {
            best = best.max(ending_at(pred, words, mut memo) + 1);
        }
    }
    memo.insert(w.to_string(), best);
    best
}

fn longest_str_chain(words: Slice[String]) -> i64 {
    let set: Set[String] = words.iter().cloned().collect();
    let mut memo: Map[String, i64] = Map.new();
    let mut best = 0;
    for w in words.iter() {
        best = best.max(ending_at(w, set, mut memo));
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` words of 1 to `longest` letters from the first `k` of the alphabet
fn random_words(count: i64, longest: i64, k: i64, seed: mut ref i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        let n = next_random(mut seed) % longest + 1;
        let mut w = String.new();
        for _ in 0..n {
            w.push((b'a' + (next_random(mut seed) % k) as u8) as char);
        }
        words.push(w);
    }
    words
}

fn show(words: Slice[String]) -> String {
    let parts: Vec[String] = words.iter().map(|w| f"\"{w}\"").collect();
    "[" + parts.join(",") + "]"
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[String]] = [
        ["a", "b", "ba", "bca", "bda", "bdca"],
        ["xbc", "pcxbcf", "xb", "cxbc", "pcxbc"],
        ["abcd", "dbqca"],
        ["a"],
        ["a", "a", "aa"],
        ["ab", "ba", "a"],
        ["abc", "ac", "a", "c"],
        ["a", "ab", "abc", "abcd", "abcde", "x", "xy"],
        ["ksqvsyq", "ks", "kss", "czvh", "zczpzvdhx", "zczpzvh", "zczpzvhx", "zcpzvh", "zczvh", "gr", "grukmj", "ksqvsq", "gruj", "kssq", "ksqsq", "grukkmj", "grukj", "zczpzfvdhx", "gru"],
        ["b", "c", "d", "e"],
    ]
    .iter()
    .map(|ws| ws.iter().map(|w| w.to_string()).collect())
    .collect();
    for words in examples.iter() {
        println(f"{show(words)} -> {longest_str_chain(words)}");
    }
    // 2000 random lists of 1 to 12 words of 1 to 4 letters from a, b
    let mut seed = 1048;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let count = next_random(mut seed) % 12 + 1;
        let answer = longest_str_chain(random_words(count, 4, 2, mut seed));
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"2000 random lists of a, b: total {total}, checksum {check}");
    // 300 random lists of 1 to 200 words of 1 to 8 letters from a to d
    total = 0;
    check = 0;
    for _ in 0..300 {
        let count = next_random(mut seed) % 200 + 1;
        let answer = longest_str_chain(random_words(count, 8, 4, mut seed));
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"300 random lists of a to d: total {total}, checksum {check}");
    // the largest: 1000 words of up to 16 letters, and a full chain of 16
    let big = random_words(1000, 16, 3, mut seed);
    println(f"1000 words of a, b, c -> {longest_str_chain(big)}");
    let mut ladder: Vec[String] = Vec.new();
    let mut w = String.new();
    for i in 0..16 {
        w.push((b'a' + (i % 26) as u8) as char);
        ladder.push(w.clone());
    }
    ladder.reverse();
    println(f"a ladder of 16 words, longest first -> {longest_str_chain(ladder)}");
}
