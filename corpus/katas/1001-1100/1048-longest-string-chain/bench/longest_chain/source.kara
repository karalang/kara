// LeetCode #1048: Longest String Chain -- benchmark driver.
//
// The ★ arm (longest_chain.kara) over 100 lists of 2000 words of 1 to 16
// letters from a, b, c, built once, then solved again every round. With
// three letters most short words are present, so chains run long and most
// predecessors are found in the map.

fn longest_str_chain(words: Slice[String]) -> i64 {
    let mut sorted = words.to_vec();
    sorted.sort_by_key(|w| w.len());
    let mut chain: Map[String, i64] = Map.new();
    let mut best = 0;
    for w in sorted.iter() {
        let mut here = 1;
        for i in 0..w.len() {
            let pred = f"{w[..i]}{w[i + 1..]}";
            if let Some(n) = chain.get(pred) {
                here = here.max(n + 1);
            }
        }
        chain.insert(w.clone(), here);
        best = best.max(here);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let lists = 100;
    let count = 2000;
    let rounds = 5;
    let mut seed = 1048;
    let mut all: Vec[Vec[String]] = Vec.new();
    for _ in 0..lists {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..count {
            let n = next_random(mut seed) % 16 + 1;
            let mut w = String.new();
            for _ in 0..n {
                w.push((b'a' + (next_random(mut seed) % 3) as u8) as char);
            }
            words.push(w);
        }
        all.push(words);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for words in all.iter() {
            let answer = longest_str_chain(words);
            total += answer;
            check = (check * 131 + answer) % 1000000007;
        }
    }
    println(f"{lists} lists of {count} words, {rounds} rounds: total {total}, checksum {check}");
}
