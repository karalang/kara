// LeetCode #1048: Longest String Chain -- the differential.
//
// The five arms against the statement read literally, on 3000 random word
// lists, with six properties:
//
// P1  the answer is the statement read literally
// P2  the answer is at least 1, at most the number of words, and at most
//     the number of distinct word lengths
// P3  the list reversed, and rotated by one, gives the same answer
// P4  a word of the list added again changes nothing
// P5  every word with a `z` added on the end, put in the list beside the
//     words, makes the answer one longer
// P6  each arm agrees with at least two of the other four

// ---- longest_chain.kara (the ★ arm): a map, shortest words first

fn map_arm(words: Slice[String]) -> i64 {
    let mut sorted = words.to_vec();
    sorted.sort_by_key(|w| w.len());
    let mut chain: Map[String, i64] = Map.new();
    let mut best = 0;
    for w in sorted.iter() {
        let mut here = 1;
        for i in 0..w.len() {
            let pred = f"{w[..i]}{w[i + 1..]}";
            if let Some(n) = chain.get(pred) {
                here = here.max(n + 1);
            }
        }
        chain.insert(w.clone(), here);
        best = best.max(here);
    }
    best
}

// ---- longest_chain_pairs.kara: every pair compared

fn pairs_arm_is_predecessor(short: Str, long: Str) -> bool {
    let a = short.bytes();
    let b = long.bytes();
    if a.len() + 1 != b.len() {
        return false;
    }
    let mut i = 0;
    let mut skipped = false;
    for j in 0..b.len() {
        if i < a.len() and a[i] == b[j] {
            i += 1;
        } else if skipped {
            return false;
        } else {
            skipped = true;
        }
    }
    true
}

fn pairs_arm(words: Slice[String]) -> i64 {
    let mut sorted = words.to_vec();
    sorted.sort_by_key(|w| w.len());
    let mut chain: Vec[i64] = Vec.filled(sorted.len(), 1);
    let mut best = 0;
    for i in 0..sorted.len() {
        for j in 0..i {
            if chain[j] + 1 > chain[i] and pairs_arm_is_predecessor(sorted[j], sorted[i]) {
                chain[i] = chain[j] + 1;
            }
        }
        best = best.max(chain[i]);
    }
    best
}

// ---- longest_chain_memo.kara: down from each word, remembered

fn memo_arm_ending_at(w: Str, words: ref Set[String], memo: mut ref Map[String, i64]) -> i64 {
    if let Some(n) = memo.get(w) {
        return *n;
    }
    let mut best = 1;
    for i in 0..w.len() {
        let pred = w[0..i].to_string() + w[i + 1..w.len()].to_string();
        if words.contains(pred) {
            best = best.max(memo_arm_ending_at(pred, words, mut memo) + 1);
        }
    }
    memo.insert(w.to_string(), best);
    best
}

fn memo_arm(words: Slice[String]) -> i64 {
    let set: Set[String] = words.iter().cloned().collect();
    let mut memo: Map[String, i64] = Map.new();
    let mut best = 0;
    for w in words.iter() {
        best = best.max(memo_arm_ending_at(w, set, mut memo));
    }
    best
}

// ---- longest_chain_layers.kara: one length at a time

fn layers_arm(words: Slice[String]) -> i64 {
    let mut longest = 0;
    for w in words.iter() {
        longest = longest.max(w.len());
    }
    let mut buckets: Vec[Vec[String]] = Vec.new();
    for _ in 0..longest + 1 {
        buckets.push(Vec.new());
    }
    for w in words.iter() {
        buckets[w.len()].push(w.clone());
    }
    let mut below: Map[String, i64] = Map.new();
    let mut best = 0;
    for len in 1..longest + 1 {
        let mut here: Map[String, i64] = Map.new();
        for w in buckets[len].iter() {
            let mut n = 1;
            for i in 0..len {
                let pred = w[0..i].to_string() + w[i + 1..len].to_string();
                if let Some(m) = below.get(pred) {
                    n = n.max(m + 1);
                }
            }
            here.insert(w.clone(), n);
            best = best.max(n);
        }
        below = here;
    }
    best
}

// ---- longest_chain_iter.kara: the predecessors as an iterator

fn iter_arm(words: Slice[String]) -> i64 {
    let mut sorted = words.to_vec();
    sorted.sort_by_key(|w| w.len());
    let mut chain: Map[String, i64] = Map.new();
    for w in sorted.iter() {
        let here = (0..w.len())
            .filter_map(|i| chain.get(w[0..i].to_string() + w[i + 1..w.len()].to_string()).cloned())
            .max()
            .map(|n| n + 1)
            .unwrap_or(1);
        chain.insert(w.clone(), here);
    }
    chain.values().cloned().max().unwrap_or(0)
}

// ---- the statement read literally

// `a` is a predecessor of `b` when inserting one letter somewhere in `a`,
// any letter, at any place, makes `b`. Only a `b` one letter longer can be
// made so, and the others are passed over without trying.
fn by_insertion(a: Str, b: Str) -> bool {
    if b.len() != a.len() + 1 {
        return false;
    }
    for p in 0..a.len() + 1 {
        for c in b'a'..b'z' + 1 {
            let mut grown = a[0..p].to_string();
            grown.push(c as char);
            grown.push_str(a[p..a.len()]);
            if grown == b {
                return true;
            }
        }
    }
    false
}

// The longest chain starting at word `i`: try every word as the next one.
fn longest_from(i: i64, words: Slice[String]) -> i64 {
    let mut best = 1;
    for j in 0..words.len() {
        if by_insertion(words[i], words[j]) {
            best = best.max(1 + longest_from(j, words));
        }
    }
    best
}

fn every_chain(words: Slice[String]) -> i64 {
    let mut best = 0;
    for i in 0..words.len() {
        best = best.max(longest_from(i, words));
    }
    best
}

// ---- the harness

fn arm(a: i64, words: Slice[String]) -> i64 {
    match a {
        0 => map_arm(words),
        1 => pairs_arm(words),
        2 => memo_arm(words),
        3 => layers_arm(words),
        _ => iter_arm(words),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_words(count: i64, longest: i64, k: i64, seed: mut ref i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        let n = next_random(mut seed) % longest + 1;
        let mut w = String.new();
        for _ in 0..n {
            w.push((b'a' + (next_random(mut seed) % k) as u8) as char);
        }
        words.push(w);
    }
    words
}

fn show(words: Slice[String]) -> String {
    let parts: Vec[String] = words.iter().map(|w| f"\"{w}\"").collect();
    "[" + parts.join(",") + "]"
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// Every check on one list of words.
fn check_case(t: mut ref Tally, words: Slice[String]) {
    let answers: Vec[i64] = (0..5).map(|a| arm(a, words)).collect();
    let want = every_chain(words);
    let mut lengths: Set[i64] = Set.new();
    for w in words.iter() {
        lengths.insert(w.len());
    }
    let reversed: Vec[String] = words.iter().rev().cloned().collect();
    let mut rotated: Vec[String] = words[1..words.len()].to_vec();
    rotated.push(words[0].clone());
    let mut again = words.to_vec();
    again.push(words[words.len() / 2].clone());
    let mut with_z = words.to_vec();
    for w in words.iter() {
        with_z.push(w.clone() + "z");
    }
    for a in 0..5 {
        let answer = answers[a];
        let what = f"arm {a}, {show(words)} -> {answer}";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally {want}");
        expect(mut t, 2, answer >= 1 and answer <= words.len() and answer <= lengths.len(), f"P2 {what}: out of range");
        expect(mut t, 3, arm(a, reversed) == answer and arm(a, rotated) == answer, f"P3 {what}: reversed or rotated");
        expect(mut t, 4, arm(a, again) == answer, f"P4 {what}: a word added again");
        expect(mut t, 5, arm(a, with_z) == answer + 1, f"P5 {what}: with every word and a z");
        let mut agree = 0;
        for o in 0..5 {
            if o != a and answers[o] == answer {
                agree += 1;
            }
        }
        expect(mut t, 6, agree >= 2, f"P6 {what}: agrees with {agree}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + answers[0]) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 3000 random lists: 2000 of 1 to 10 words of 1 to 4 letters from a, b,
    // where chains are long and words repeat, and 1000 of 1 to 12 words of
    // 1 to 6 letters from a, b, c
    let mut seed = 10481;
    for i in 0..3000 {
        let words = if i < 2000 {
            random_words(next_random(mut seed) % 10 + 1, 4, 2, mut seed)
        } else {
            random_words(next_random(mut seed) % 12 + 1, 6, 3, mut seed)
        };
        check_case(mut t, words);
    }
    println(f"{t.cases} lists: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
