// LeetCode #1090: Largest Values From Labels -- LeetCode's Rust template,
// written as Rust writes it and carried to Kāra by `karac fix` in three
// rounds: the `HashMap` import dropped and `HashMap<i32, i32>` made
// `Map[i32, i32]`, `sort_unstable_by` made the stable `sort_by` and `&a.0`
// the borrow it already is, `sum` typed `i32` for the return, and
// `values.into_iter()` on a borrowed parameter made `values.clone()
// .into_iter()`. The pairs sorted by value from the largest, a `Map` entry
// counting each label's uses. O(n log n).

struct Solution {}

impl Solution {
    pub fn largest_vals_from_labels(values: Vec[i32], labels: Vec[i32], num_wanted: i32, use_limit: i32) -> i32 {
        let mut items: Vec[(i32, i32)] = values.clone().into_iter().zip(labels.clone().into_iter()).collect();
        items.sort_by(|a, b| b.0.cmp(a.0));
        let mut used: Map[i32, i32] = Map.new();
        let mut taken = 0;
        let mut sum: i32 = 0;
        for (v, l) in items {
            if taken == num_wanted {
                break;
            }
            let c = used.entry(l).or_insert(0);
            if *c < use_limit {
                *c += 1;
                sum += v;
                taken += 1;
            }
        }
        sum
    }
}

fn largest_vals_from_labels(values: Vec[i64], labels: Vec[i64], num_wanted: i64, use_limit: i64) -> i64 {
    let values: Vec[i32] = values.iter().map(|x| x as i32).collect();
    let labels: Vec[i32] = labels.iter().map(|x| x as i32).collect();
    Solution.largest_vals_from_labels(values, labels, num_wanted as i32, use_limit as i32) as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(xs: Vec[i64]) -> String {
    let parts: Vec[String] = xs.iter().map(|x| f"{x}").collect();
    f"[{parts.join(", ")}]"
}

fn main() {
    let cases = [
        ([5, 4, 3, 2, 1], [1, 1, 2, 2, 3], 3, 1),
        ([5, 4, 3, 2, 1], [1, 3, 3, 3, 2], 3, 2),
        ([9, 8, 8, 7, 6], [0, 0, 0, 1, 1], 3, 1),
        ([9, 8, 8, 7, 6], [0, 0, 0, 1, 1], 3, 2),
        ([7], [4], 1, 1),
        ([0, 0, 0], [1, 2, 3], 2, 1),
        ([3, 3, 3, 3], [1, 1, 1, 1], 4, 2),
        ([3, 3, 3, 3], [1, 1, 1, 1], 1, 4),
        ([1, 2, 3, 4, 5, 6], [6, 5, 4, 3, 2, 1], 6, 1),
        ([10, 9, 8, 7, 6, 5], [1, 1, 2, 2, 3, 3], 4, 1),
        ([2, 6, 1, 2, 6], [2, 2, 2, 1, 1], 1, 1),
        ([4, 4, 4, 9, 2, 8], [0, 1, 0, 2, 1, 2], 5, 1),
    ];
    for (values, labels, num_wanted, use_limit) in cases.iter() {
        let answer = largest_vals_from_labels(values.clone(), labels.clone(), num_wanted, use_limit);
        println(f"{show(values)} {show(labels)} {num_wanted} {use_limit} -> {answer}");
    }
    // 2000 random problems of 1 to 20 items, values 0 to 20, labels 0 to 5
    let mut seed = 1090;
    let mut h = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 20 + 1;
        let mut values: Vec[i64] = [];
        let mut labels: Vec[i64] = [];
        for _ in 0..n {
            values.push(next_random(mut seed) % 21);
            labels.push(next_random(mut seed) % 6);
        }
        let num_wanted = next_random(mut seed) % n + 1;
        let use_limit = next_random(mut seed) % n + 1;
        let answer = largest_vals_from_labels(values, labels, num_wanted, use_limit);
        total += answer;
        h = (h * 31 + answer) % 1000000007;
    }
    println(f"2000 random problems: answers sum to {total}, checksum {h}");
    // one problem of 20000 items, LeetCode's largest
    let mut values: Vec[i64] = [];
    let mut labels: Vec[i64] = [];
    for _ in 0..20000 {
        values.push(next_random(mut seed) % 20001);
        labels.push(next_random(mut seed) % 20001);
    }
    println(f"20000 items: {largest_vals_from_labels(values.clone(), labels.clone(), 20000, 1)}, {largest_vals_from_labels(values.clone(), labels.clone(), 5000, 3)}, {largest_vals_from_labels(values, labels, 100, 1)}");
}
