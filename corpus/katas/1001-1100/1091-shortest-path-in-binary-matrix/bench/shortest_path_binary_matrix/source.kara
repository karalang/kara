// Benchmark: LeetCode #1091 Shortest Path in Binary Matrix -- the ★ arm,
// breadth-first search with a `VecDeque` and a grid of distances. 200
// random grids of 100 by 100 cells, LeetCode's largest, 25 to 44% of the
// cells blocked and the corners open, are built once; each of 20 rounds
// answers every grid, folding the lengths into a checksum. Mirrors
// shortest_path_binary_matrix.rs, .c, .py and go-seq/.

fn shortest_path_binary_matrix(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    if grid[0][0] == 1 or grid[n - 1][n - 1] == 1 {
        return -1;
    }
    let mut dist = Vec.filled(n, Vec.filled(n, -1));
    dist[0][0] = 1;
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    queue.push_back((0, 0));
    while let Some((r, c)) = queue.pop_front() {
        if r == n - 1 and c == n - 1 {
            return dist[r][c];
        }
        for dr in -1..=1 {
            for dc in -1..=1 {
                let (nr, nc) = (r + dr, c + dc);
                if nr >= 0 and nr < n and nc >= 0 and nc < n and grid[nr][nc] == 0 and dist[nr][nc] == -1 {
                    dist[nr][nc] = dist[r][c] + 1;
                    queue.push_back((nr, nc));
                }
            }
        }
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1091;
    let mut grids: Vec[Vec[Vec[i64]]] = [];
    for k in 0..200 {
        let blocked = 25 + k % 20;
        let mut grid: Vec[Vec[i64]] = [];
        for _ in 0..100 {
            let mut row: Vec[i64] = [];
            for _ in 0..100 {
                row.push(if next_random(mut seed) % 100 < blocked { 1 } else { 0 });
            }
            grid.push(row);
        }
        grid[0][0] = 0;
        grid[99][99] = 0;
        grids.push(grid);
    }
    let mut none = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..20 {
        for grid in grids.iter() {
            let answer = shortest_path_binary_matrix(grid);
            if answer == -1 {
                none += 1;
            } else {
                total += answer;
            }
            check = (check * 31 + answer + 1) % 1000000007;
        }
    }
    println(f"20 rounds over 200 grids of 100 by 100: {none} without a path, lengths sum to {total}, checksum {check}");
}
