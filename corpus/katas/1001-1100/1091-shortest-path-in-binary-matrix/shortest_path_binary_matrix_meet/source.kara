// LeetCode #1091: Shortest Path in Binary Matrix -- bidirectional
// breadth-first search: one search from each corner, each with its own
// `Map` from cell to length, and the smaller frontier grown a level at a
// time. When a cell one search reaches is already in the other's map, the
// two lengths meet there and their sum less one (the cell counted twice)
// is the shortest path through it; the best such sum over the whole level
// is the answer. Each search covers about half the depth.

fn grow(grid: Vec[Vec[i64]], frontier: Vec[(i64, i64)], mine: mut ref Map[(i64, i64), i64], other: Map[(i64, i64), i64], best: mut ref i64) -> Vec[(i64, i64)] {
    let n = grid.len();
    let mut next: Vec[(i64, i64)] = [];
    for (r, c) in frontier.iter() {
        let length = mine[(r, c)];
        for dr in -1..=1 {
            for dc in -1..=1 {
                let (nr, nc) = (r + dr, c + dc);
                if nr < 0 or nr >= n or nc < 0 or nc >= n or grid[nr][nc] == 1 or mine.contains_key((nr, nc)) {
                    continue;
                }
                mine.insert((nr, nc), length + 1);
                if let Some(there) = other.get((nr, nc)) {
                    *best = (*best).min(length + there);
                }
                next.push((nr, nc));
            }
        }
    }
    next
}

fn shortest_path_binary_matrix(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    if grid[0][0] == 1 or grid[n - 1][n - 1] == 1 {
        return -1;
    }
    if n == 1 {
        return 1;
    }
    let mut from_start: Map[(i64, i64), i64] = Map.new();
    let mut from_end: Map[(i64, i64), i64] = Map.new();
    from_start.insert((0, 0), 1);
    from_end.insert((n - 1, n - 1), 1);
    let mut front_a: Vec[(i64, i64)] = [(0, 0)];
    let mut front_b: Vec[(i64, i64)] = [(n - 1, n - 1)];
    let mut best = i64.MAX;
    while not front_a.is_empty() and not front_b.is_empty() {
        if front_a.len() <= front_b.len() {
            front_a = grow(grid, front_a, mut from_start, from_end, mut best);
        } else {
            front_b = grow(grid, front_b, mut from_end, from_start, mut best);
        }
        if best < i64.MAX {
            return best;
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(rows: Vec[String]) -> Vec[Vec[i64]] {
    rows.iter().map(|r| r.chars().map(|c| if c == '1' { 1 } else { 0 }).collect()).collect()
}

// A random n by n grid, each cell blocked with chance `blocked` in 100.
fn random_grid(seed: mut ref i64, n: i64, blocked: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = [];
    for _ in 0..n {
        let mut row: Vec[i64] = [];
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < blocked { 1 } else { 0 });
        }
        grid.push(row);
    }
    grid
}

fn main() {
    let cases: Vec[Vec[String]] = [
        ["01", "10"],
        ["000", "110", "110"],
        ["100", "110", "110"],
        ["0"],
        ["1"],
        ["00", "01"],
        ["0000", "1110", "0000", "0110"],
        ["00000", "11110", "00000", "01111", "00000"],
        ["0100", "0101", "0101", "0001"],
        ["000", "000", "000"],
        ["010", "111", "010"],
        ["0110", "1001", "1001", "0110"],
    ];
    for rows in cases.iter() {
        println(f"{rows.join("/")} -> {shortest_path_binary_matrix(parse(rows))}");
    }
    // 2000 random grids of 1 to 12 cells a side, a quarter to a half blocked
    let mut seed = 1091;
    let mut h = 0;
    let mut total = 0;
    let mut none = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let blocked = next_random(mut seed) % 26 + 25;
        let grid = random_grid(mut seed, n, blocked);
        let answer = shortest_path_binary_matrix(grid);
        if answer == -1 {
            none += 1;
        } else {
            total += answer;
        }
        h = (h * 31 + answer + 1) % 1000000007;
    }
    println(f"2000 random grids: {none} without a path, lengths sum to {total}, checksum {h}");
    // LeetCode's largest, 100 by 100, at three densities
    for blocked in [10, 30, 40] {
        let mut grid = random_grid(mut seed, 100, blocked);
        grid[0][0] = 0;
        grid[99][99] = 0;
        println(f"100 by 100, {blocked}% blocked: {shortest_path_binary_matrix(grid)}");
    }
}
