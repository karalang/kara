// LeetCode #1091: Shortest Path in Binary Matrix -- A*: a `PriorityQueue`
// (smallest first) of (estimate, length, row, column), where the estimate
// is the length so far plus the cells still needed with no wall in the
// way, `max(n - 1 - row, n - 1 - column)` (a diagonal step closes both
// gaps at once). That bound never overestimates and drops by at most one
// a step, so a cell's length is final when it is first popped, and the
// search reaches the corner without visiting the far side of the grid.

fn shortest_path_binary_matrix(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    if grid[0][0] == 1 or grid[n - 1][n - 1] == 1 {
        return -1;
    }
    let remaining = |r: i64, c: i64| (n - 1 - r).max(n - 1 - c);
    let mut best = Vec.filled(n, Vec.filled(n, i64.MAX));
    best[0][0] = 1;
    let mut heap: PriorityQueue[(i64, i64, i64, i64)] = PriorityQueue.new();
    heap.push((1 + remaining(0, 0), 1, 0, 0));
    while let Some((_, length, r, c)) = heap.pop() {
        if length > best[r][c] {
            continue;
        }
        if r == n - 1 and c == n - 1 {
            return length;
        }
        for dr in -1..=1 {
            for dc in -1..=1 {
                let (nr, nc) = (r + dr, c + dc);
                if nr >= 0 and nr < n and nc >= 0 and nc < n and grid[nr][nc] == 0 and length + 1 < best[nr][nc] {
                    best[nr][nc] = length + 1;
                    heap.push((length + 1 + remaining(nr, nc), length + 1, nr, nc));
                }
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(rows: Vec[String]) -> Vec[Vec[i64]] {
    rows.iter().map(|r| r.chars().map(|c| if c == '1' { 1 } else { 0 }).collect()).collect()
}

// A random n by n grid, each cell blocked with chance `blocked` in 100.
fn random_grid(seed: mut ref i64, n: i64, blocked: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = [];
    for _ in 0..n {
        let mut row: Vec[i64] = [];
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < blocked { 1 } else { 0 });
        }
        grid.push(row);
    }
    grid
}

fn main() {
    let cases: Vec[Vec[String]] = [
        ["01", "10"],
        ["000", "110", "110"],
        ["100", "110", "110"],
        ["0"],
        ["1"],
        ["00", "01"],
        ["0000", "1110", "0000", "0110"],
        ["00000", "11110", "00000", "01111", "00000"],
        ["0100", "0101", "0101", "0001"],
        ["000", "000", "000"],
        ["010", "111", "010"],
        ["0110", "1001", "1001", "0110"],
    ];
    for rows in cases.iter() {
        println(f"{rows.join("/")} -> {shortest_path_binary_matrix(parse(rows))}");
    }
    // 2000 random grids of 1 to 12 cells a side, a quarter to a half blocked
    let mut seed = 1091;
    let mut h = 0;
    let mut total = 0;
    let mut none = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let blocked = next_random(mut seed) % 26 + 25;
        let grid = random_grid(mut seed, n, blocked);
        let answer = shortest_path_binary_matrix(grid);
        if answer == -1 {
            none += 1;
        } else {
            total += answer;
        }
        h = (h * 31 + answer + 1) % 1000000007;
    }
    println(f"2000 random grids: {none} without a path, lengths sum to {total}, checksum {h}");
    // LeetCode's largest, 100 by 100, at three densities
    for blocked in [10, 30, 40] {
        let mut grid = random_grid(mut seed, 100, blocked);
        grid[0][0] = 0;
        grid[99][99] = 0;
        println(f"100 by 100, {blocked}% blocked: {shortest_path_binary_matrix(grid)}");
    }
}
