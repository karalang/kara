// LeetCode #1091: Shortest Path in Binary Matrix -- breadth-first by levels:
// the frontier is a `Vec` of the cells first reached at the current length,
// and the next one is built from their open neighbours, each cell closed
// (set to 1 in the arm's own copy of the grid) as it joins a frontier. The
// length grows by one per level until the frontier holds the bottom right
// cell or is empty. O(n^2).

fn shortest_path_binary_matrix(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut open = grid.clone();
    if open[0][0] == 1 {
        return -1;
    }
    open[0][0] = 1;
    let mut frontier: Vec[(i64, i64)] = [(0, 0)];
    let mut length = 1;
    while not frontier.is_empty() {
        let mut next: Vec[(i64, i64)] = [];
        for (r, c) in frontier.iter() {
            if r == n - 1 and c == n - 1 {
                return length;
            }
            for nr in (r - 1).max(0)..(r + 2).min(n) {
                for nc in (c - 1).max(0)..(c + 2).min(n) {
                    if open[nr][nc] == 0 {
                        open[nr][nc] = 1;
                        next.push((nr, nc));
                    }
                }
            }
        }
        frontier = next;
        length += 1;
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(rows: Vec[String]) -> Vec[Vec[i64]] {
    rows.iter().map(|r| r.chars().map(|c| if c == '1' { 1 } else { 0 }).collect()).collect()
}

// A random n by n grid, each cell blocked with chance `blocked` in 100.
fn random_grid(seed: mut ref i64, n: i64, blocked: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = [];
    for _ in 0..n {
        let mut row: Vec[i64] = [];
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < blocked { 1 } else { 0 });
        }
        grid.push(row);
    }
    grid
}

fn main() {
    let cases: Vec[Vec[String]] = [
        ["01", "10"],
        ["000", "110", "110"],
        ["100", "110", "110"],
        ["0"],
        ["1"],
        ["00", "01"],
        ["0000", "1110", "0000", "0110"],
        ["00000", "11110", "00000", "01111", "00000"],
        ["0100", "0101", "0101", "0001"],
        ["000", "000", "000"],
        ["010", "111", "010"],
        ["0110", "1001", "1001", "0110"],
    ];
    for rows in cases.iter() {
        println(f"{rows.join("/")} -> {shortest_path_binary_matrix(parse(rows))}");
    }
    // 2000 random grids of 1 to 12 cells a side, a quarter to a half blocked
    let mut seed = 1091;
    let mut h = 0;
    let mut total = 0;
    let mut none = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let blocked = next_random(mut seed) % 26 + 25;
        let grid = random_grid(mut seed, n, blocked);
        let answer = shortest_path_binary_matrix(grid);
        if answer == -1 {
            none += 1;
        } else {
            total += answer;
        }
        h = (h * 31 + answer + 1) % 1000000007;
    }
    println(f"2000 random grids: {none} without a path, lengths sum to {total}, checksum {h}");
    // LeetCode's largest, 100 by 100, at three densities
    for blocked in [10, 30, 40] {
        let mut grid = random_grid(mut seed, 100, blocked);
        grid[0][0] = 0;
        grid[99][99] = 0;
        println(f"100 by 100, {blocked}% blocked: {shortest_path_binary_matrix(grid)}");
    }
}
