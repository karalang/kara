// LeetCode #1061: Lexicographically Smallest Equivalent String -- the pairs
// as edges of a graph on the 26 letters. A depth-first walk from each letter
// not yet reached finds its class, and every letter of the class maps to the
// smallest one in it. O(26 + n + m).

fn smallest_equivalent(s1: String, s2: String, base: String) -> String {
    let mut edges: Vec[Vec[i64]] = Vec.filled(26, Vec.new());
    for (a, b) in s1.bytes().iter().zip(s2.bytes().iter()) {
        let (a, b) = (a - b'a', b - b'a');
        edges[a].push(b);
        edges[b].push(a);
    }
    let mut smallest = [-1; 26];
    for start in 0..26 {
        if smallest[start] >= 0 {
            continue;
        }
        // letters are taken in order, so `start` is the smallest of a class
        // no earlier letter reached
        smallest[start] = start;
        let mut stack = [start];
        while let Some(x) = stack.pop() {
            for y in edges[x].iter() {
                if smallest[y] < 0 {
                    smallest[y] = start;
                    stack.push(y);
                }
            }
        }
    }
    let mut out = String.new();
    for c in base.bytes() {
        out.push((b'a' + smallest[c - b'a'] as u8) as char);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters drawn from the first `k` of the alphabet.
fn random_word(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// The answer folded into a checksum, and how many of its letters moved.
fn mix(check: i64, base: String, answer: String) -> (i64, i64) {
    let mut c = check;
    let mut moved = 0;
    for (x, y) in base.bytes().iter().zip(answer.bytes().iter()) {
        c = (c * 31 + y as i64) % 1000000007;
        if x != y {
            moved += 1;
        }
    }
    (c, moved)
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(String, String, String)] = [
        ("parker", "morris", "parser"),
        ("hello", "world", "hold"),
        ("leetcode", "programs", "sourcecode"),
        ("a", "b", "b"),
        ("abc", "abc", "xyz"),
        ("abc", "bcd", "dcba"),
        ("z", "a", "zoo"),
        ("aabbcc", "bcdefa", "fed"),
        ("zyx", "wvu", "uvwxyz"),
        ("abcdefghijklmnopqrstuvwxy", "bcdefghijklmnopqrstuvwxyz", "thequickbrownfoxjumpsoverthelazydog"),
    ];
    for (s1, s2, base) in examples.iter() {
        println(f"{s1} {s2} {base} -> {smallest_equivalent(s1, s2, base)}");
    }
    let mut seed = 1061;
    let mut check = 0;
    let mut moved = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 8 + 1;
        let s1 = random_word(n, 6, mut seed);
        let s2 = random_word(n, 6, mut seed);
        let base = random_word(next_random(mut seed) % 10 + 1, 8, mut seed);
        let answer = smallest_equivalent(s1, s2, base);
        let (c, m) = mix(check, base, answer);
        check = c;
        moved += m;
    }
    println(f"3000 pairs of 1 to 8 letters over 6: {moved} letters moved, checksum {check}");
    check = 0;
    moved = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 4 + 1;
        let s1 = random_word(n, 26, mut seed);
        let s2 = random_word(n, 26, mut seed);
        let base = random_word(next_random(mut seed) % 30 + 1, 26, mut seed);
        let answer = smallest_equivalent(s1, s2, base);
        let (c, m) = mix(check, base, answer);
        check = c;
        moved += m;
    }
    println(f"3000 pairs of 1 to 4 letters over 26: {moved} letters moved, checksum {check}");
    check = 0;
    moved = 0;
    for i in 0..100 {
        let n = 1 + i % 20;
        let s1 = random_word(n, 26, mut seed);
        let s2 = random_word(n, 26, mut seed);
        let base = random_word(1000, 26, mut seed);
        let answer = smallest_equivalent(s1, s2, base);
        let (c, m) = mix(check, base, answer);
        check = c;
        moved += m;
    }
    println(f"100 bases of 1000 letters: {moved} letters moved, checksum {check}");
    // the longest strings: 1000 pairs, a base of 1000 letters
    let s1 = random_word(1000, 26, mut seed);
    let s2 = random_word(1000, 26, mut seed);
    let base = random_word(1000, 26, mut seed);
    let answer = smallest_equivalent(s1, s2, base);
    let (c, m) = mix(0, base, answer);
    println(f"1000 pairs over 26, a base of 1000: {m} letters moved, checksum {c}");
    // a chain that reaches one letter from the next: z joins a last
    let mut up = String.new();
    let mut down = String.new();
    for i in 0..25 {
        up.push((b'z' - i as u8) as char);
        down.push((b'y' - i as u8) as char);
    }
    println(f"{up} {down} zebra -> {smallest_equivalent(up, down, "zebra")}");
}
