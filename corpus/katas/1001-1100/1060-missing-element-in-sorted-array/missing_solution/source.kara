// LeetCode #1060: Missing Element in Sorted Array -- LeetCode's Rust
// template, written the way Rust writes it and carried to Kāra by `karac
// fix`: `impl Solution` over `i32` values, a half-open `lo < hi` search for
// the first index with `k` missing, and a caller that converts the values
// with `iter().map(..).collect()`. O(log n).

struct Solution {}

impl Solution {
    pub fn missing_element(nums: Vec[i32], k: i32) -> i32 {
        let n = nums.len();
        let missing = |i: i64| { nums[i] - nums[0] - i as i32 };
        if k > missing(n - 1) {
            return nums[n - 1] + k - missing(n - 1);
        }
        let mut (lo, hi) = (0, n - 1);
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if missing(mid) < k {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        nums[lo - 1] + k - missing(lo - 1)
    }
}

fn missing_element(nums: Vec[i64], k: i64) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.missing_element(nums, k as i32) as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` increasing values from `first`, each gap 1 to `widest`.
fn sorted_values(n: i64, first: i64, widest: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums = [first];
    for _ in 1..n {
        let gap = 1 + next_random(mut seed) % widest;
        nums.push(nums[nums.len() - 1] + gap);
    }
    nums
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer % 1000003) % 1000000007
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], i64)] = [
        ([4, 7, 9, 10], 1),
        ([4, 7, 9, 10], 3),
        ([1, 2, 4], 3),
        ([5], 1),
        ([1, 2, 3], 1),
        ([1, 3], 1),
        ([2, 4, 6, 8], 4),
        ([10, 11, 12, 20], 7),
        ([10, 11, 12, 20], 8),
        ([1, 10000000], 100000000),
    ];
    for (nums, k) in examples.iter() {
        println(f"{nums} {k} -> {missing_element(nums, k)}");
    }
    let mut seed = 1060;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 10 + 1;
        let nums = sorted_values(n, next_random(mut seed) % 10 + 1, 4, mut seed);
        let k = next_random(mut seed) % 20 + 1;
        let answer = missing_element(nums, k);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 arrays of 1 to 10 values, k to 20: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 50 + 1;
        let widest = if next_random(mut seed) % 2 == 0 { 1 } else { 2 };
        let nums = sorted_values(n, next_random(mut seed) % 100 + 1, widest, mut seed);
        let k = next_random(mut seed) % 60 + 1;
        let answer = missing_element(nums, k);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 dense arrays of 1 to 50 values, k to 60: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    let mut calls = 0;
    for a in 0..40 {
        let nums = sorted_values(50000, next_random(mut seed) % 100 + 1, 2 + a % 300, mut seed);
        let span = nums[nums.len() - 1] - nums[0] - (nums.len() - 1);
        for j in 0..10 {
            let k = if j < 8 {
                1 + next_random(mut seed) * 32768 % (span + 1000)
            } else {
                1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000000
            };
            let answer = missing_element(nums, k);
            sum += answer;
            check = mix(check, answer);
            calls += 1;
        }
    }
    println(f"40 arrays of 50000 values, {calls} calls: sum {sum}, checksum {check}");
    // one array of 1000 values, every k from 1 to 3000
    let nums = sorted_values(1000, 1, 3, mut seed);
    sum = 0;
    check = 0;
    for k in 1..3001 {
        let answer = missing_element(nums, k);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"1000 values to {nums[999]}, every k to 3000: sum {sum}, checksum {check}");
    // 50000 consecutive values: nothing missing inside
    let mut run: Vec[i64] = Vec.new();
    for v in 1..50001 {
        run.push(v);
    }
    println(f"1 to 50000, k = 1: {missing_element(run, 1)}, k = 100000000: {missing_element(run, 100000000)}");
}
