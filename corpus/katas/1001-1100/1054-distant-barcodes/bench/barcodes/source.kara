// LeetCode #1054: Distant Barcodes -- the benchmark: the ★ arm on 200
// arrays of 20000 barcodes built once, 25 rounds. Each array is up to 9000
// copies of one barcode and random barcodes of 1 to 10000 after them, so
// the counts run to 10000 and the most common barcode takes most of the
// even places.
fn rearrange_barcodes(barcodes: Slice[i64]) -> Vec[i64] {
    let n = barcodes.len();
    let top = *barcodes.iter().max().unwrap();
    let mut counts = Vec.filled(top + 1, 0);
    for b in barcodes.iter() {
        counts[b] += 1;
    }
    let mut most = 0;
    for v in 1..top + 1 {
        if counts[v] > counts[most] {
            most = v;
        }
    }
    let mut answer = Vec.filled(n, 0);
    let mut place = 0;
    let mut v = most;
    let mut next = 1;
    for _ in 0..n {
        while counts[v] == 0 {
            v = next;
            next += 1;
        }
        answer[place] = v;
        counts[v] -= 1;
        place += 2;
        if place >= n {
            place = 1;
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200;
    let n = 20000;
    let rounds = 25;
    let mut seed = 1054;
    let mut all: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        // 1 to 9000 copies of one barcode, then random ones
        let common = next_random(mut seed) % 10000 + 1;
        let copies = next_random(mut seed) % 9000 + 1;
        let mut barcodes: Vec[i64] = Vec.new();
        for _ in 0..copies {
            barcodes.push(common);
        }
        for _ in copies..n {
            barcodes.push(next_random(mut seed) % 10000 + 1);
        }
        all.push(barcodes);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for barcodes in all.iter() {
            let answer = rearrange_barcodes(barcodes);
            let mut h = 0;
            // every 97th place, so the fold stays small beside the call
            let mut k = 0;
            while k < n {
                h = (h * 10007 + answer[k]) % 1000000007;
                k += 97;
            }
            total += answer[1];
            check = (check * 131 + h) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} barcodes, {rounds} rounds: total {total}, checksum {check}");
}
