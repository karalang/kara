// LeetCode #1006: Clumsy Factorial -- a closed form
//
// For a >= 5, a * (a-1) / (a-2) is a + 1, since a * (a-1) = (a+1)(a-2) + 2
// and 2 < a - 2. So each full later group, -(a+1) + (a-3), adds -4, and
// the first group's a + 1 + (a-3) is cancelled down to a small remainder
// fixed by where the expression stops, which depends only on n % 4. The
// first four n are listed. O(1).
fn clumsy(n: i64) -> i64 {
    if n <= 2 {
        n
    } else if n == 3 {
        6
    } else if n == 4 {
        7
    } else if n % 4 == 0 {
        n + 1
    } else if n % 4 == 3 {
        n - 1
    } else {
        n + 2
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"n = 4 -> {clumsy(4)}");
    println(f"n = 10 -> {clumsy(10)}");
    // every n up to 16, one line
    let small: Vec[String] = (1..17).map(|n| clumsy(n).to_string()).collect();
    println(f"n = 1..16 -> {small.join(" ")}");
    // LeetCode's largest, and the three below it
    for n in [10000, 9999, 9998, 9997] {
        println(f"n = {n} -> {clumsy(n)}");
    }
    // every n up to 1000
    let mut sum = 0;
    let mut check = 0;
    for n in 1..1001 {
        let got = clumsy(n);
        sum += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"n = 1..1000: answers sum to {sum}, checksum {check}");
    // 200 random n up to 10000
    let mut seed = 1006;
    sum = 0;
    check = 0;
    for _ in 0..200 {
        let n = 1 + next_random(mut seed) % 10000;
        let got = clumsy(n);
        sum += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"200 random n up to 10000: answers sum to {sum}, checksum {check}");
}
