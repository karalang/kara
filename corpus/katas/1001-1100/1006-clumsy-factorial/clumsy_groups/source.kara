// LeetCode #1006: Clumsy Factorial -- groups of four
//
// The operators repeat every four numbers, so the expression is a run of
// groups `a * (a-1) / (a-2) + (a-3)`: the first group's product-quotient
// is added, every later one's subtracted, and each group's fourth number
// is added. The last group may be cut short after one, two or three
// numbers. Truncating a quotient and then negating it is the same as
// negating first, so each group's term is computed positive. O(n).
fn clumsy(n: i64) -> i64 {
    let mut sum = 0;
    let mut x = n;
    let mut sign = 1;
    while x > 0 {
        let mut term = x;
        x -= 1;
        if x > 0 {
            term *= x;
            x -= 1;
        }
        if x > 0 {
            term /= x;
            x -= 1;
        }
        sum += sign * term;
        if x > 0 {
            sum += x;
            x -= 1;
        }
        sign = -1;
    }
    sum
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"n = 4 -> {clumsy(4)}");
    println(f"n = 10 -> {clumsy(10)}");
    // every n up to 16, one line
    let small: Vec[String] = (1..17).map(|n| clumsy(n).to_string()).collect();
    println(f"n = 1..16 -> {small.join(" ")}");
    // LeetCode's largest, and the three below it
    for n in [10000, 9999, 9998, 9997] {
        println(f"n = {n} -> {clumsy(n)}");
    }
    // every n up to 1000
    let mut sum = 0;
    let mut check = 0;
    for n in 1..1001 {
        let got = clumsy(n);
        sum += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"n = 1..1000: answers sum to {sum}, checksum {check}");
    // 200 random n up to 10000
    let mut seed = 1006;
    sum = 0;
    check = 0;
    for _ in 0..200 {
        let n = 1 + next_random(mut seed) % 10000;
        let got = clumsy(n);
        sum += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"200 random n up to 10000: answers sum to {sum}, checksum {check}");
}
