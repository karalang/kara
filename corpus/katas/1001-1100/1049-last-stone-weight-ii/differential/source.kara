// LeetCode #1049: Last Stone Weight II -- the differential.
//
// The five arms against the statement read literally, on 3000 random lists
// of stones, with six properties:
//
// P1  the answer is the statement read literally
// P2  the answer is between 0 and the heaviest stone, and odd exactly when
//     the total is
// P3  the list reversed, and rotated by one, gives the same answer
// P4  a stone weighing the whole list added, or the list given twice,
//     leaves 0
// P5  every stone twice as heavy makes the answer twice as large
// P6  each arm agrees with at least two of the other four

// ---- last_stone.kara (the ★ arm): the sums up to half, in a table

fn table_arm(stones: Slice[i64]) -> i64 {
    let total: i64 = stones.iter().sum();
    let half = total / 2;
    let mut made = Vec.filled(half + 1, false);
    made[0] = true;
    for s in stones.iter() {
        let mut t = half;
        while t >= *s {
            if made[t - *s] {
                made[t] = true;
            }
            t -= 1;
        }
    }
    let mut best = half;
    while not made[best] {
        best -= 1;
    }
    total - 2 * best
}

// ---- last_stone_diffs.kara: every signed total, in a set

fn diffs_arm(stones: Slice[i64]) -> i64 {
    let mut diffs: Set[i64] = Set.new();
    diffs.insert(0);
    for s in stones.iter() {
        let mut next: Set[i64] = Set.new();
        for d in diffs.iter() {
            next.insert(d + s);
            next.insert(d - s);
        }
        diffs = next;
    }
    diffs.iter().map(|d| d.abs()).min().unwrap()
}

// ---- last_stone_memo.kara: down the stones, remembering

fn memo_arm_best(stones: Slice[i64], i: i64, diff: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i == stones.len() {
        return diff.abs();
    }
    if let Some(v) = memo.get((i, diff)) {
        return v;
    }
    let plus = memo_arm_best(stones, i + 1, diff + stones[i], mut memo);
    let minus = memo_arm_best(stones, i + 1, diff - stones[i], mut memo);
    let answer = plus.min(minus);
    memo.insert((i, diff), answer);
    answer
}

fn memo_arm(stones: Slice[i64]) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    memo_arm_best(stones, 0, 0, mut memo)
}

// ---- last_stone_bits.kara: the reachable sums as bits

fn bits_arm(stones: Slice[i64]) -> i64 {
    let total: i64 = stones.iter().sum();
    let words = total / 64 + 1;
    let mut bits: Vec[u64] = Vec.filled(words, 0);
    bits[0] = 1;
    for s in stones.iter() {
        let shift = *s / 64;
        let part = (*s % 64) as u32;
        let mut w = words - 1;
        while w >= shift {
            let mut moved = bits[w - shift] << part;
            if part > 0 and w - shift >= 1 {
                moved = moved | (bits[w - shift - 1] >> (64 - part));
            }
            bits[w] = bits[w] | moved;
            w -= 1;
        }
    }
    let half = total / 2;
    let mut t = half;
    while (bits[t / 64] >> ((t % 64) as u32)) & 1 == 0 {
        t -= 1;
    }
    total - 2 * t
}

// ---- last_stone_iter.kara: the ★ sums as a fold

fn iter_arm(stones: Slice[i64]) -> i64 {
    let total: i64 = stones.iter().sum();
    let half = total / 2;
    let sums: SortedSet[i64] = stones.iter().fold(SortedSet.from([0]), |made, s| {
        made.iter().flat_map(|t| [*t, *t + *s].into_iter()).filter(|t| t <= half).collect()
    });
    total - 2 * sums.iter().max().unwrap()
}

// ---- the statement read literally: smash any two, every way

// The smallest weight left from these stones, trying every pair to smash
// next: two equal stones both go, two unequal leave their difference. The
// stones are kept sorted, so a set of stones reached two ways is worked out
// once.
fn smash_every_way(stones: own Vec[i64], memo: mut ref Map[Vec[i64], i64]) -> i64 {
    let n = stones.len();
    if n == 0 {
        return 0;
    }
    if n == 1 {
        return stones[0];
    }
    if let Some(v) = memo.get(stones) {
        return v;
    }
    let mut best = -1;
    for i in 0..n {
        for j in i + 1..n {
            let mut rest: Vec[i64] = Vec.new();
            for k in 0..n {
                if k != i and k != j {
                    rest.push(stones[k]);
                }
            }
            if stones[i] != stones[j] {
                rest.push((stones[i] - stones[j]).abs());
            }
            rest.sort();
            let left = smash_every_way(rest, mut memo);
            if best < 0 or left < best {
                best = left;
            }
        }
    }
    memo.insert(stones, best);
    best
}

fn read_literally(stones: Slice[i64]) -> i64 {
    let mut memo: Map[Vec[i64], i64] = Map.new();
    let mut sorted = stones.to_vec();
    sorted.sort();
    smash_every_way(sorted, mut memo)
}

fn arm(a: i64, stones: Slice[i64]) -> i64 {
    match a {
        0 => table_arm(stones),
        1 => diffs_arm(stones),
        2 => memo_arm(stones),
        3 => bits_arm(stones),
        _ => iter_arm(stones),
    }
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_stones(count: i64, heaviest: i64, seed: mut ref i64) -> Vec[i64] {
    let mut stones: Vec[i64] = Vec.new();
    for _ in 0..count {
        stones.push(next_random(mut seed) % heaviest + 1);
    }
    stones
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// Every check on one list of stones.
fn check_case(t: mut ref Tally, stones: Slice[i64]) {
    let answers: Vec[i64] = (0..5).map(|a| arm(a, stones)).collect();
    let want = read_literally(stones);
    let total: i64 = stones.iter().sum();
    let heaviest = *stones.iter().max().unwrap();
    let reversed: Vec[i64] = stones.iter().rev().cloned().collect();
    let mut rotated: Vec[i64] = stones[1..stones.len()].to_vec();
    rotated.push(stones[0]);
    let mut with_total = stones.to_vec();
    with_total.push(total);
    let mut twice = stones.to_vec();
    twice.extend_from_slice(stones);
    let doubled: Vec[i64] = stones.iter().map(|s| 2 * s).collect();
    for a in 0..5 {
        let answer = answers[a];
        let what = f"arm {a}, {stones} -> {answer}";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally {want}");
        expect(mut t, 2, answer >= 0 and answer <= heaviest and answer % 2 == total % 2, f"P2 {what}: out of range or parity");
        expect(mut t, 3, arm(a, reversed) == answer and arm(a, rotated) == answer, f"P3 {what}: reversed or rotated");
        expect(mut t, 4, arm(a, with_total) == 0 and arm(a, twice) == 0, f"P4 {what}: the total added, or given twice");
        expect(mut t, 5, arm(a, doubled) == 2 * answer, f"P5 {what}: every stone doubled");
        let mut agree = 0;
        for o in 0..5 {
            if o != a and answers[o] == answer {
                agree += 1;
            }
        }
        expect(mut t, 6, agree >= 2, f"P6 {what}: agrees with {agree}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + answers[0]) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 3000 random lists: 2000 of 1 to 6 stones of 1 to 10, where weights
    // repeat and many splits tie, and 1000 of 1 to 7 stones of 1 to 100,
    // where a stone moves the bits arm's sums a whole word
    let mut seed = 10491;
    for i in 0..3000 {
        let stones = if i < 2000 {
            random_stones(next_random(mut seed) % 6 + 1, 10, mut seed)
        } else {
            random_stones(next_random(mut seed) % 7 + 1, 100, mut seed)
        };
        check_case(mut t, stones);
    }
    println(f"{t.cases} lists: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
