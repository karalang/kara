// LeetCode #1037: Valid Boomerang -- bench
// Mirrors ../boomerang.kara; see ../README.md § Benchmarks.

fn is_boomerang(points: ref Vec[(i64, i64)]) -> bool {
    let (ax, ay) = points[0];
    let (bx, by) = points[1];
    let (cx, cy) = points[2];
    (bx - ax) * (cy - ay) - (by - ay) * (cx - ax) != 0
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 1000000;
    let rounds = 100;
    let mut seed = 1037;
    let mut triples: Vec[Vec[(i64, i64)]] = Vec.new();
    for i in 0..count {
        if i % 3 == 0 {
            // three points a step apart on one line
            let (x, y) = (next_random(mut seed) % 34, next_random(mut seed) % 34);
            let (dx, dy) = (next_random(mut seed) % 34, next_random(mut seed) % 34);
            triples.push(vec![(x, y), (x + dx, y + dy), (x + 2 * dx, y + 2 * dy)]);
        } else {
            let mut points: Vec[(i64, i64)] = Vec.new();
            for _ in 0..3 {
                points.push((next_random(mut seed) % 101, next_random(mut seed) % 101));
            }
            triples.push(points);
        }
    }
    let mut boomerangs = 0;
    let mut check: i64 = 0;
    for _ in 0..rounds {
        for points in triples.iter() {
            let answer = is_boomerang(points);
            if answer {
                boomerangs += 1;
            }
            check = (check * 131 + if answer { 2 } else { 1 }) % 1000000007;
        }
    }
    println(f"{count} triples, {rounds} rounds: {boomerangs} boomerangs, checksum {check}");
}
