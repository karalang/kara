// LeetCode #1086: High Five -- LeetCode's Rust template, written as Rust
// writes it and carried to Kāra by `karac fix`: a `BTreeMap<i32,
// BinaryHeap<Reverse<i32>>>` keeping five per student through `entry`,
// `or_insert_with(BinaryHeap::new)` and `Reverse`, and the averages
// collected as `vec![id, sum / 5]`. O(n log 5).


struct Solution {}

impl Solution {
    pub fn high_five(items: Vec[Vec[i32]]) -> Vec[Vec[i32]] {
        let mut map: SortedMap[i32, PriorityQueue[i32]] = SortedMap.new();
        for item in items.iter() {
            let heap = map.entry(item[0]).or_insert_with(PriorityQueue.new);
            heap.push(item[1]);
            if heap.len() > 5 {
                heap.pop();
            }
        }
        map.into_iter()
            .map(|(id, heap)| {
                let sum: i32 = heap.into_iter().map(|s| s).sum();
                [id, sum / 5]
            })
            .collect()
    }
}

fn high_five(items: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let rows: Vec[Vec[i32]] = items.iter().map(|r| r.iter().map(|x| x as i32).collect()).collect();
    Solution.high_five(rows).iter().map(|r| r.iter().map(|x| x as i64).collect()).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn written(pairs: Vec[Vec[i64]]) -> String {
    let parts: Vec[String] = pairs.iter().map(|p| f"[{p[0]},{p[1]}]").collect();
    f"[{parts.join(",")}]"
}

// k students with ids drawn from 1 to `ids`, each with 5 to 9 scores,
// the items shuffled.
fn random_items(seed: mut ref i64, k: i64, ids: i64) -> Vec[Vec[i64]] {
    let mut chosen: Vec[i64] = [];
    while chosen.len() < k {
        let id = next_random(mut seed) % ids + 1;
        if not chosen.contains(id) {
            chosen.push(id);
        }
    }
    let mut items: Vec[Vec[i64]] = [];
    for id in chosen.iter() {
        let n = next_random(mut seed) % 5 + 5;
        for _ in 0..n {
            items.push([id, next_random(mut seed) % 101]);
        }
    }
    for i in (1..items.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        items.swap(i, j);
    }
    items
}

fn fold(h: i64, text: Str) -> i64 {
    let mut h = h;
    for b in text.bytes() {
        h = (h * 131 + b) % 1000000007;
    }
    h
}

fn main() {
    let cases: Vec[Vec[Vec[i64]]] = [
        [[1, 91], [1, 92], [2, 93], [2, 97], [1, 60], [2, 77], [1, 65], [1, 87], [1, 100], [2, 100], [2, 76]],
        [[1, 100], [7, 100], [1, 100], [7, 100], [1, 100], [7, 100], [1, 100], [7, 100], [1, 100], [7, 100]],
        [[3, 0], [3, 0], [3, 0], [3, 0], [3, 1]],
        [[1000, 4], [1000, 4], [1000, 4], [1000, 4], [1000, 3], [1000, 100], [2, 9], [2, 9], [2, 9], [2, 9], [2, 9]],
    ];
    for items in cases.iter() {
        println(f"{written(items)} -> {written(high_five(items))}");
    }
    // 300 random item lists of 1 to 40 students
    let mut seed = 1086;
    let mut students = 0;
    let mut h = 0;
    for _ in 0..300 {
        let k = next_random(mut seed) % 40 + 1;
        let items = random_items(mut seed, k, 1000);
        let out = high_five(items);
        students += out.len();
        h = fold(h, written(out));
    }
    println(f"300 random lists: {students} students, checksum {h}");
}
