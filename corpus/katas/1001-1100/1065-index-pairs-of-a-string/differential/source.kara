// LeetCode #1065: Index Pairs of a String -- the differential.
//
// The six arms against the statement read literally, on 2000 texts, with
// six properties:
//
// P1  the answer is the statement read literally: every pair of a start
//     and an end at or after it whose letters, compared as a `String`, are
//     one of the words, by start and then by end
// P2  the pairs are in range, strictly ascending, and each holds a word
// P3  the letters renamed by a random permutation, in the text and the
//     words alike, and the words in reverse order, leave the answer
// P4  the text and every word reversed answer the pairs mirrored
// P5  a letter appended to the text keeps every pair and adds only pairs
//     ending at it, and a word dropped removes exactly the pairs holding it
// P6  each arm agrees with at least three of the other five

// ---- index_pairs.kara: the ★ arm: every start against every word
fn star_arm(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..text.len() {
        for w in words.iter() {
            if text[i..].starts_with(w) {
                pairs.push((i, i + w.len() - 1));
            }
        }
    }
    pairs.sort();
    pairs
}

// ---- index_pairs_find.kara: each word found again and again
fn find_arm(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for w in words.iter() {
        let mut from = 0;
        while let Some(at) = text[from..].find(w) {
            let start = from + at;
            pairs.push((start, start + w.len() - 1));
            from = start + 1;
        }
    }
    pairs.sort();
    pairs
}

// ---- index_pairs_set.kara: every short substring looked up in a Set
fn set_arm(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let set: Set[String] = words.iter().cloned().collect();
    let longest = words.iter().map(|w| w.len()).max().unwrap_or(0);
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..text.len() {
        for j in i..text.len().min(i + longest) {
            if set.contains(text.substring(i, j + 1)) {
                pairs.push((i, j));
            }
        }
    }
    pairs
}

// ---- index_pairs_trie.kara: a trie walked from each start
struct Trie {
    // next[node][letter], 0 when there is no edge: node 0 is the root and
    // never a child
    next: Vec[Array[i64, 26]],
    ends: Vec[bool],
}

impl Trie {
    fn new() -> Trie {
        Trie { next: [[0; 26]], ends: [false] }
    }

    fn insert(mut ref self, word: String) {
        let mut node = 0;
        for c in word.bytes() {
            let letter = c - b'a';
            if self.next[node][letter] == 0 {
                self.next[node][letter] = self.next.len();
                self.next.push([0; 26]);
                self.ends.push(false);
            }
            node = self.next[node][letter];
        }
        self.ends[node] = true;
    }
}

fn trie_arm(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let mut trie = Trie.new();
    for w in words.iter() {
        trie.insert(w);
    }
    let b = text.bytes();
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..b.len() {
        let mut node = 0;
        let mut j = i;
        while j < b.len() and trie.next[node][b[j] - b'a'] != 0 {
            node = trie.next[node][b[j] - b'a'];
            if trie.ends[node] {
                pairs.push((i, j));
            }
            j += 1;
        }
    }
    pairs
}

// ---- index_pairs_kmp.kara: Knuth-Morris-Pratt for each word
// fail[k]: the longest proper prefix of `p[..k + 1]` that is also its
// suffix.
fn failure(p: Slice[u8]) -> Vec[i64] {
    let mut fail: Vec[i64] = Vec.filled(p.len(), 0);
    let mut k = 0;
    for i in 1..p.len() {
        while k > 0 and p[i] != p[k] {
            k = fail[k - 1];
        }
        if p[i] == p[k] {
            k += 1;
        }
        fail[i] = k;
    }
    fail
}

fn kmp_arm(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let t = text.bytes();
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for w in words.iter() {
        let p = w.bytes();
        let fail = failure(p);
        // k letters of `p` matched so far
        let mut k = 0;
        for i in 0..t.len() {
            while k > 0 and t[i] != p[k] {
                k = fail[k - 1];
            }
            if t[i] == p[k] {
                k += 1;
            }
            if k == p.len() {
                pairs.push((i + 1 - k, i));
                k = fail[k - 1];
            }
        }
    }
    pairs.sort();
    pairs
}

// ---- index_pairs_solution.kara: LeetCode's Rust template
struct Solution {}

impl Solution {
    pub fn index_pairs(text: String, words: Vec[String]) -> Vec[Vec[i32]] {
        let mut ans = Vec.new();
        for i in 0..text.len() {
            for w in ref words {
                if text[i..].starts_with(w.as_str()) {
                    ans.push([i as i32, (i + w.len() - 1) as i32]);
                }
            }
        }
        ans.sort();
        ans
    }
}

fn solution_arm(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let pairs = Solution.index_pairs(text.clone(), words.to_vec());
    pairs.iter().map(|p| (p[0] as i64, p[1] as i64)).collect()
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// Up to `count` distinct words of 1 to `longest` letters over `k`: each
// drawn at random or, every other one, cut from the text.
fn random_words(text: String, count: i64, longest: i64, k: i64, seed: mut ref i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for w in 0..count {
        let n = next_random(mut seed) % longest + 1;
        let word = if w % 2 == 1 and n <= text.len() {
            let at = next_random(mut seed) % (text.len() - n + 1);
            text.substring(at, at + n)
        } else {
            random_word(n, k, mut seed)
        };
        if not words.contains(word) {
            words.push(word);
        }
    }
    words
}

fn arm(a: i64, text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    match a {
        0 => star_arm(text, words),
        1 => find_arm(text, words),
        2 => set_arm(text, words),
        3 => trie_arm(text, words),
        4 => kmp_arm(text, words),
        _ => solution_arm(text, words),
    }
}

// Every pair of a start and an end at or after it whose letters, compared
// as a `String`, are one of the words, by start and then by end.
fn read_literally(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..text.len() {
        for j in i..text.len() {
            let piece = text.substring(i, j + 1);
            if words.iter().any(|w| w == piece) {
                pairs.push((i, j));
            }
        }
    }
    pairs
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn reversed(s: String) -> String {
    s.chars().rev().collect()
}

// Each letter renamed by `names`, a permutation of the alphabet.
fn renamed(s: String, names: Slice[u8]) -> String {
    let mut out = String.new();
    for c in s.bytes() {
        out.push(names[c - b'a'] as char);
    }
    out
}

fn check_case(t: mut ref Tally, text: String, words: Slice[String], seed: mut ref i64) {
    // every random choice drawn before any arm answers, so the problems
    // are the same whatever an arm gets wrong
    let n = text.len();
    let mut names: Vec[u8] = (0..26).map(|i| b'a' + i as u8).collect();
    for i in 0..26 {
        names.swap(i, i + next_random(mut seed) % (26 - i));
    }
    let extra = (b'a' + (next_random(mut seed) % 26) as u8) as char;
    let dropped = next_random(mut seed) % words.len();
    let renamed_text = renamed(text, names);
    let renamed_words: Vec[String] = words.iter().rev().map(|w| renamed(w, names)).collect();
    let back_text = reversed(text);
    let back_words: Vec[String] = words.iter().map(|w| reversed(w)).collect();
    let mut longer = text.clone();
    longer.push(extra);
    let fewer: Vec[String] = (0..words.len()).filter(|w| w != dropped).map(|w| words[w].clone()).collect();
    let want = read_literally(text, words);
    let answers: Vec[Vec[(i64, i64)]] = (0..6).map(|a| arm(a, text, words)).collect();
    for a in 0..6 {
        let answer = ref answers[a];
        let what = f"arm {a}, {text} {words} -> {answer}";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally {want}");
        let mut shaped = true;
        for k in 0..answer.len() {
            let (i, j) = answer[k];
            if i < 0 or j < i or j >= n or not words.contains(text.substring(i, j + 1)) {
                shaped = false;
            } else if k > 0 and answer[k - 1] >= answer[k] {
                shaped = false;
            }
        }
        expect(mut t, 2, shaped, f"P2 {what}");
        let other = arm(a, renamed_text, renamed_words);
        expect(mut t, 3, other == answer, f"P3 {what}: renamed -> {other}");
        let back = arm(a, back_text, back_words);
        let mut mirrored: Vec[(i64, i64)] = answer.iter().map(|(i, j)| (n - 1 - j, n - 1 - i)).collect();
        mirrored.sort();
        expect(mut t, 4, back == mirrored, f"P4 {what}: reversed -> {back}");
        let grown = arm(a, longer, words);
        let kept: Vec[(i64, i64)] = grown.iter().filter(|(_, j)| j < n).collect();
        let new_ok = grown.iter().all(|(_, j)| j <= n);
        expect(mut t, 5, kept == answer and new_ok, f"P5 {what}: with {extra} -> {grown}");
        let less = arm(a, text, fewer);
        let gone: Vec[(i64, i64)] = answer.iter().filter(|(i, j)| text.substring(i, j + 1) != words[dropped]).collect();
        expect(mut t, 5, less == gone, f"P5 {what}: without {words[dropped]} -> {less}");
        let agree = (0..6).filter(|o| o != a and answers[o] == answer).count();
        expect(mut t, 6, agree >= 3, f"P6 {what}: agrees with {agree}");
    }
    t.cases += 1;
    for (i, j) in want.iter() {
        t.check = (t.check * 31 + i * 101 + j + 1) % 1000000007;
    }
    t.check = (t.check * 31 + want.len()) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 texts: 1000 of 1 to 12 letters over 1 to 3 with 1 to 5 words of
    // 1 to 4, and 1000 of 1 to 40 over 2 to 26 with 1 to 10 words of 1 to 6
    let mut seed = 10651;
    for i in 0..2000 {
        let (n, k, count, longest) = if i < 1000 { (12, next_random(mut seed) % 3 + 1, 5, 4) } else { (40, next_random(mut seed) % 25 + 2, 10, 6) };
        let text = random_word(next_random(mut seed) % n + 1, k, mut seed);
        let words = random_words(text, next_random(mut seed) % count + 1, longest, k, mut seed);
        check_case(mut t, text, words, mut seed);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
