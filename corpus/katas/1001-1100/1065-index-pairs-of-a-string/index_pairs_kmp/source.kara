// LeetCode #1065: Index Pairs of a String -- Knuth-Morris-Pratt for each
// word: its failure function, then one pass over the text that falls back
// along it on a mismatch, so overlapping matches are all found, then the
// pairs sorted. O(n + m) per word.

// fail[k]: the longest proper prefix of `p[..k + 1]` that is also its
// suffix.
fn failure(p: Slice[u8]) -> Vec[i64] {
    let mut fail: Vec[i64] = Vec.filled(p.len(), 0);
    let mut k = 0;
    for i in 1..p.len() {
        while k > 0 and p[i] != p[k] {
            k = fail[k - 1];
        }
        if p[i] == p[k] {
            k += 1;
        }
        fail[i] = k;
    }
    fail
}

fn index_pairs(text: String, words: Slice[String]) -> Vec[(i64, i64)] {
    let t = text.bytes();
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for w in words.iter() {
        let p = w.bytes();
        let fail = failure(p);
        // k letters of `p` matched so far
        let mut k = 0;
        for i in 0..t.len() {
            while k > 0 and t[i] != p[k] {
                k = fail[k - 1];
            }
            if t[i] == p[k] {
                k += 1;
            }
            if k == p.len() {
                pairs.push((i + 1 - k, i));
                k = fail[k - 1];
            }
        }
    }
    pairs.sort();
    pairs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// Up to `count` distinct words of 1 to `longest` letters over `k`: each
// drawn at random or, every other one, cut from the text.
fn random_words(text: String, count: i64, longest: i64, k: i64, seed: mut ref i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for w in 0..count {
        let n = next_random(mut seed) % longest + 1;
        let word = if w % 2 == 1 and n <= text.len() {
            let at = next_random(mut seed) % (text.len() - n + 1);
            text.substring(at, at + n)
        } else {
            random_word(n, k, mut seed)
        };
        if not words.contains(word) {
            words.push(word);
        }
    }
    words
}

// The pairs folded to one number.
fn checksum(pairs: Slice[(i64, i64)]) -> i64 {
    let mut check = 0;
    for (i, j) in pairs.iter() {
        check = (check * 31 + i * 101 + j + 1) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's examples, then a few more
    let examples: Vec[(String, Vec[String])] = [
        ("thestoryofleetcodeandme", ["story", "fleet", "leetcode"]),
        ("ababa", ["aba", "ab"]),
        ("a", ["a"]),
        ("abc", ["d", "abcd"]),
        ("aaaa", ["a", "aa", "aaa"]),
        ("xyz", ["y", "xyz"]),
        ("mississippi", ["issi", "ss", "i", "pp"]),
    ];
    for (text, words) in examples.iter() {
        println(f"{text} {words} -> {index_pairs(text, words)}");
    }
    let mut seed = 1065;
    let mut count = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let k = next_random(mut seed) % 3 + 1;
        let text = random_word(next_random(mut seed) % 20 + 1, k, mut seed);
        let words = random_words(text, next_random(mut seed) % 5 + 1, 4, k, mut seed);
        let pairs = index_pairs(text, words);
        count += pairs.len();
        check = (check * 31 + checksum(pairs)) % 1000000007;
    }
    println(f"3000 texts of 1 to 20 letters: {count} pairs, checksum {check}");
    count = 0;
    check = 0;
    for _ in 0..300 {
        let k = next_random(mut seed) % 25 + 2;
        let text = random_word(next_random(mut seed) % 51 + 50, k, mut seed);
        let words = random_words(text, next_random(mut seed) % 20 + 1, 8, k, mut seed);
        let pairs = index_pairs(text, words);
        count += pairs.len();
        check = (check * 31 + checksum(pairs)) % 1000000007;
    }
    println(f"300 texts of 50 to 100 letters: {count} pairs, checksum {check}");
    // the longest: 100 letters `a` against every run of 1 to 20 of them,
    // and 100 alternating letters against the four shortest words in them
    let a: String = (0..100).map(|_| 'a').collect();
    let runs: Vec[String] = (1..21).map(|n| a.substring(0, n)).collect();
    let pairs = index_pairs(a, runs);
    println(f"100 a's, 20 runs: {pairs.len()} pairs, checksum {checksum(pairs)}");
    let ab: String = (0..100).map(|i| if i % 2 == 0 { 'a' } else { 'b' }).collect();
    let short: Vec[String] = ["ab", "ba", "aba", "bab"];
    let pairs = index_pairs(ab, short);
    println(f"100 alternating, 4 words: {pairs.len()} pairs, checksum {checksum(pairs)}");
}
