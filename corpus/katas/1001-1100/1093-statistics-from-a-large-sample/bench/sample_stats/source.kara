// Benchmark: LeetCode #1093 Statistics from a Large Sample -- the ★ arm,
// two walks over the counts. 64 count arrays of 256 places, each holding a
// sample of 6 to 258 million values, are built once; each of
// 10000 rounds punches one count in every array and answers it, folding all
// five numbers into a checksum. Mirrors sample_stats.rs, .c, .py and
// go-seq/.

fn sample_stats(count: Vec[i64]) -> Vec[f64] {
    let mut low = -1;
    let mut high = 0;
    let mut sum = 0;
    let mut total = 0;
    let mut mode = 0;
    for k in 0..count.len() {
        let c = count[k];
        if c == 0 {
            continue;
        }
        if low < 0 {
            low = k;
        }
        high = k;
        sum += k * c;
        total += c;
        if c > count[mode] {
            mode = k;
        }
    }
    // the values at places (total - 1) / 2 and total / 2, counting from 0
    let (left, right) = ((total - 1) / 2, total / 2);
    let mut seen = 0;
    let mut median_low = -1;
    let mut median_high = -1;
    for k in 0..count.len() {
        seen += count[k];
        if median_low < 0 and seen > left {
            median_low = k;
        }
        if seen > right {
            median_high = k;
            break;
        }
    }
    let mean = sum as f64 / total as f64;
    let median = (median_low + median_high) as f64 / 2.0;
    [low as f64, high as f64, mean, median, mode as f64]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1093;
    let mut samples: Vec[Vec[i64]] = [];
    for k in 0..64 {
        let mut c: Vec[i64] = Vec.filled(256, 0);
        // from 4 to 256 values present, each counted up to 3 * 10^6 times
        for _ in 0..4 + k * 4 {
            c[next_random(mut seed) % 256] = next_random(mut seed) * 91 % 3000000 + 1;
        }
        samples.push(c);
    }
    let mut modes = 0;
    let mut check = 0;
    for round in 0..10000 {
        for j in 0..samples.len() {
            let place = (round * 7 + j * 13) % 256;
            samples[j][place] += 1;
            let s = sample_stats(samples[j]);
            modes += s[4] as i64;
            for x in s.iter() {
                check = (check * 31 + (x * 1000000.0) as i64) % 1000000007;
            }
        }
    }
    println(f"10000 rounds over 64 samples: modes sum to {modes}, checksum {check}");
}
