// LeetCode #1019: Next Greater Node In Linked List -- bench
//
// The ★ arm (../next_greater.kara) on 500 random lists of 1 to 10,000
// nodes (LeetCode's sizes), built once and each answered 10 times,
// folding the answers into a sum and a checksum. See ../README.md §
// Benchmarks.

shared struct ListNode {
    mut val: i64,
    mut next: Option[ListNode],
}

fn next_larger_nodes(head: Option[ListNode]) -> Vec[i64] {
    let mut values: Vec[i64] = Vec.new();
    let mut answer: Vec[i64] = Vec.new();
    let mut waiting: Vec[i64] = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        let v = node.val;
        while not waiting.is_empty() and values[waiting[waiting.len() - 1]] < v {
            answer[waiting.pop().unwrap()] = v;
        }
        waiting.push(values.len());
        values.push(v);
        answer.push(0);
        cur = node.next;
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn from_values(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    let mut k = values.len() - 1;
    while k >= 0 {
        head = Some(ListNode { val: values[k], next: head });
        k -= 1;
    }
    head
}

fn main() {
    let count = 500;
    let rounds = 10;
    let mut seed = 1019;
    let mut lists: Vec[Option[ListNode]] = Vec.new();
    let mut nodes = 0;
    for _ in 0..count {
        let len = next_random(mut seed) % 10000 + 1;
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..len {
            values.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1);
        }
        nodes += len;
        lists.push(from_values(values));
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for head in lists.iter() {
            let answer = next_larger_nodes(head);
            for a in answer.iter() {
                total = (total + a) % 1000000007;
                check = (check * 31 + a) % 1000000007;
            }
        }
    }
    println(f"{count} lists, {nodes} nodes, {rounds} rounds: answer sum {total}, checksum {check}");
}
