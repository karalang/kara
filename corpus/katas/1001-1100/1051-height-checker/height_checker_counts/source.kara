// LeetCode #1051: Height Checker -- counting sort, walked in place.
//
// Heights run from 1 to 100, so count how many students have each height
// and walk the counts upward: the expected line is that walk, and each
// place is compared as the walk reaches it, with no sorted copy. O(n + H)
// for H heights.

fn height_checker(heights: Slice[i64]) -> i64 {
    let mut count = [0; 101];
    for h in heights.iter() {
        count[*h] += 1;
    }
    let mut moved = 0;
    let mut want = 0;
    for h in heights.iter() {
        while count[want] == 0 {
            want += 1;
        }
        if *h != want {
            moved += 1;
        }
        count[want] -= 1;
    }
    moved
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` heights of 1 to `tallest`
fn random_heights(count: i64, tallest: i64, seed: mut ref i64) -> Vec[i64] {
    let mut heights: Vec[i64] = Vec.new();
    for _ in 0..count {
        heights.push(next_random(mut seed) % tallest + 1);
    }
    heights
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [1, 1, 4, 2, 1, 3],
        [5, 1, 2, 3, 4],
        [1, 2, 3, 4, 5],
        [7],
        [2, 1],
        [3, 3, 3, 3],
        [5, 4, 3, 2, 1],
        [2, 1, 2, 1, 2],
        [1, 3, 2, 3, 1],
        [100, 1, 100, 1, 50, 50],
    ];
    for heights in examples.iter() {
        println(f"{heights} -> {height_checker(heights)}");
    }
    // 3000 random lines of 1 to 8 students of 1 to 4
    let mut seed = 1051;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let count = next_random(mut seed) % 8 + 1;
        let answer = height_checker(random_heights(count, 4, mut seed));
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"3000 random lines of 1 to 8 students of 1 to 4: total {total}, checksum {check}");
    // 1000 random lines of 1 to 100 students of 1 to 100
    total = 0;
    check = 0;
    for _ in 0..1000 {
        let count = next_random(mut seed) % 100 + 1;
        let answer = height_checker(random_heights(count, 100, mut seed));
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"1000 random lines of 1 to 100 students of 1 to 100: total {total}, checksum {check}");
    // the largest: 100 students tallest first, and 100 in order but the ends swapped
    let falling: Vec[i64] = (0..100).map(|i| 100 - i).collect();
    println(f"100 students, tallest first -> {height_checker(falling)}");
    let mut swapped: Vec[i64] = (1..101).collect();
    swapped.swap(0, 99);
    println(f"100 students in order, the ends swapped -> {height_checker(swapped)}");
}
