// LeetCode #1023: Camelcase Matching -- bench
//
// The ★ arm (../camel_match.kara) on 500 random cases of LeetCode's
// sizes, each a pattern of 1 to 100 letters and 100 queries of up to 100
// letters, half grown from the pattern by putting in letters, built once
// and each answered 150 times, folding the answers into a count and a
// checksum. See ../README.md § Benchmarks.

fn camel_match(queries: Vec[String], pattern: Str) -> Vec[bool] {
    let p: Vec[char] = pattern.chars().collect();
    let mut answers: Vec[bool] = Vec.new();
    for query in queries.iter() {
        let mut i = 0;
        let mut ok = true;
        for c in query.chars() {
            if i < p.len() and c == p[i] {
                i += 1;
            } else if c.is_ascii_uppercase() {
                ok = false;
                break;
            }
        }
        answers.push(ok and i == p.len());
    }
    answers
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random letter, a capital with probability `capitals` / 8
fn random_letter(seed: mut ref i64, capitals: i64) -> char {
    let upper = next_random(mut seed) % 8 < capitals;
    let k = next_random(mut seed) % 26;
    let base = if upper { 65 } else { 97 };
    char.try_from((base + k) as u32).unwrap()
}

fn main() {
    let count = 500;
    let rounds = 150;
    let mut seed = 1023;
    let mut cases: Vec[(String, Vec[String])] = Vec.new();
    let mut letters = 0;
    for _ in 0..count {
        let plen = 1 + next_random(mut seed) % 100;
        let mut pattern = String.new();
        for _ in 0..plen {
            pattern.push(random_letter(mut seed, 2));
        }
        let p: Vec[char] = pattern.chars().collect();
        let mut queries: Vec[String] = Vec.new();
        for k in 0..100 {
            let mut q = String.new();
            if k % 2 == 0 {
                // the pattern with letters put in, a capital among them with
                // probability 1/8 per letter
                let mut left = next_random(mut seed) % (100 - plen + 1);
                let mut at = 0;
                while at < p.len() or left > 0 {
                    if left > 0 and (at == p.len() or next_random(mut seed) % 2 == 0) {
                        q.push(random_letter(mut seed, 1));
                        left -= 1;
                    } else {
                        q.push(p[at]);
                        at += 1;
                    }
                }
            } else {
                for _ in 0..1 + next_random(mut seed) % 100 {
                    q.push(random_letter(mut seed, 2));
                }
            }
            letters += q.len();
            queries.push(q);
        }
        cases.push((pattern, queries));
    }
    let mut matched = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for (pattern, queries) in cases.iter() {
            for (k, answer) in camel_match(queries, pattern).iter().enumerate() {
                if answer {
                    matched += 1;
                    check = (check * 31 + k + 1) % 1000000007;
                }
            }
        }
    }
    println(f"{count} cases, {letters} query letters, {rounds} rounds: {matched} match, checksum {check}");
}
