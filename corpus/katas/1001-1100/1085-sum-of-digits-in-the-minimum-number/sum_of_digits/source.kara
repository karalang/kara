// LeetCode #1085: Sum of Digits in the Minimum Number -- the ★ arm: the
// least value found in one pass, its digits summed by taking the last
// one off at a time, and 1 when the sum is even. O(n).

fn sum_of_digits(nums: Vec[i64]) -> i64 {
    let mut least = nums[0];
    for v in nums.iter() {
        if v < least {
            least = v;
        }
    }
    let mut sum = 0;
    while least > 0 {
        sum += least % 10;
        least /= 10;
    }
    if sum % 2 == 0 { 1 } else { 0 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases: Vec[Vec[i64]] = [
        [34, 23, 1, 24, 75, 33, 54, 8],
        [99, 77, 33, 66, 55],
        [1],
        [100],
        [10, 100],
        [19, 28, 37],
        [100, 99, 98, 11],
        [56, 65, 47],
    ];
    for nums in cases.iter() {
        println(f"{nums} -> {sum_of_digits(nums)}");
    }
    // every single value 1 to 100: how many have an even digit sum
    let mut even = 0;
    for v in 1..=100 {
        even += sum_of_digits([v]);
    }
    println(f"1 to 100 alone: {even} answer 1");
    // 1000 random arrays of 1 to 100 values, each 1 to 100
    let mut seed = 1085;
    let mut ones = 0;
    let mut h = 0;
    for i in 0..1000 {
        let n = next_random(mut seed) % 100 + 1;
        let mut nums: Vec[i64] = [];
        for _ in 0..n {
            nums.push(next_random(mut seed) % 100 + 1);
        }
        let a = sum_of_digits(nums);
        ones += a;
        h = (h * 31 + a + i) % 1000000007;
    }
    println(f"1000 random arrays: {ones} answer 1, checksum {h}");
}
