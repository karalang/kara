// LeetCode #1067: Digit Count in Range -- digit dynamic programming: the
// numbers up to `n` written digit by digit from the top, with the count
// of `d` so far, whether the digits so far are `n`'s own (so the next is
// held to `n`'s), and whether a digit other than 0 has come yet (a 0
// before it is no digit). Once free of `n` and begun, the count of the
// rest depends only on the place and the count so far, and is remembered.
// O(log^2 n * 10).

fn walk(digits: Slice[i64], d: i64, at: i64, count: i64, held: bool, begun: bool, memo: mut ref Vec[i64]) -> i64 {
    if at == digits.len() {
        return count;
    }
    let key = at * (digits.len() + 1) + count;
    if not held and begun and memo[key] >= 0 {
        return memo[key];
    }
    let top = if held { digits[at] } else { 9 };
    let mut total = 0;
    for x in 0..=top {
        let now = begun or x != 0;
        let next = if now and x == d { count + 1 } else { count };
        total += walk(digits, d, at + 1, next, held and x == top, now, mut memo);
    }
    if not held and begun {
        memo[key] = total;
    }
    total
}

fn count_to(d: i64, n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    let mut digits: Vec[i64] = Vec.new();
    let mut rest = n;
    while rest > 0 {
        digits.push(rest % 10);
        rest /= 10;
    }
    digits.reverse();
    let mut memo: Vec[i64] = Vec.filled(digits.len() * (digits.len() + 1), -1);
    walk(digits, d, 0, 0, true, false, mut memo)
}

fn digits_count(d: i64, low: i64, high: i64) -> i64 {
    count_to(d, high) - count_to(d, low - 1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples, then a few more
    let examples: Vec[(i64, i64, i64)] = [
        (1, 1, 13),
        (3, 100, 250),
        (0, 1, 10),
        (0, 1, 100),
        (0, 100, 100),
        (7, 77, 77),
        (5, 123456, 654321),
        (0, 1000, 1999),
        (9, 1, 200000000),
        (0, 1, 200000000),
    ];
    for (d, low, high) in examples.iter() {
        println(f"d = {d}, [{low}, {high}] -> {digits_count(d, low, high)}");
    }
    let mut seed = 1067;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let d = next_random(mut seed) % 10;
        let low = next_random(mut seed) % 10000 + 1;
        let high = low + next_random(mut seed) % 2000;
        let answer = digits_count(d, low, high);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"3000 ranges below 12000: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..300 {
        let d = next_random(mut seed) % 10;
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000000 + 1;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000000 + 1;
        let answer = digits_count(d, a.min(b), a.max(b));
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"300 ranges up to 200000000: sum {sum}, checksum {check}");
    // every digit over the largest range, over each power of ten, and over
    // each number of nine nines and below
    let every: Vec[i64] = (0..10).map(|d| digits_count(d, 1, 200000000)).collect();
    println(f"1 to 200000000, each digit: {every}");
    let zeros: Vec[i64] = (1..9).map(|k| digits_count(0, 1, 10.pow(k as u32))).collect();
    println(f"0 from 1 to each power of ten: {zeros}");
    let ones: Vec[i64] = (1..9).map(|k| digits_count(1, 10.pow((k - 1) as u32), 10.pow(k as u32) - 1)).collect();
    println(f"1 over each length of number: {ones}");
    let single: Vec[i64] = (0..10).map(|d| digits_count(d, 199999990, 199999990)).collect();
    println(f"199999990 alone, each digit: {single}");
}
