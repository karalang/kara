// LeetCode #1067: Digit Count in Range -- by length, then in blocks from
// the top digit down. The numbers shorter than `n` are every number of
// each shorter length: of the L-digit ones, `d` leads 10^(L-1) of them
// unless it is 0, and each of the other L - 1 places holds it in a tenth
// of all 9 * 10^(L-1). The ones as long as `n` and not above it come in
// blocks: at each place, every digit below `n`'s there (not 0 at the top)
// begins a block of 10^k numbers whose last k digits run free, holding
// `d` k * 10^(k-1) times among those digits and once a number for each
// `d` before them. O(log n).

fn count_to(d: i64, n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    let digits: Vec[i64] = n.to_string().chars().map(|c| c.to_digit(10).unwrap() as i64).collect();
    let len = digits.len();
    let mut total = 0;
    for l in 1..len {
        let lead = if d == 0 { 0 } else { 10.pow((l - 1) as u32) };
        total += lead + (l - 1) * 9 * 10.pow((l - 1) as u32) / 10;
    }
    let mut seen = 0;
    for at in 0..len {
        let k = len - 1 - at;
        let block = 10.pow(k as u32);
        let inside = k * block / 10;
        let first = if at == 0 { 1 } else { 0 };
        for x in first..digits[at] {
            let here = if x == d { 1 } else { 0 };
            total += block * (seen + here) + inside;
        }
        if digits[at] == d {
            seen += 1;
        }
    }
    total + seen
}

fn digits_count(d: i64, low: i64, high: i64) -> i64 {
    count_to(d, high) - count_to(d, low - 1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples, then a few more
    let examples: Vec[(i64, i64, i64)] = [
        (1, 1, 13),
        (3, 100, 250),
        (0, 1, 10),
        (0, 1, 100),
        (0, 100, 100),
        (7, 77, 77),
        (5, 123456, 654321),
        (0, 1000, 1999),
        (9, 1, 200000000),
        (0, 1, 200000000),
    ];
    for (d, low, high) in examples.iter() {
        println(f"d = {d}, [{low}, {high}] -> {digits_count(d, low, high)}");
    }
    let mut seed = 1067;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let d = next_random(mut seed) % 10;
        let low = next_random(mut seed) % 10000 + 1;
        let high = low + next_random(mut seed) % 2000;
        let answer = digits_count(d, low, high);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"3000 ranges below 12000: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..300 {
        let d = next_random(mut seed) % 10;
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000000 + 1;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000000 + 1;
        let answer = digits_count(d, a.min(b), a.max(b));
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"300 ranges up to 200000000: sum {sum}, checksum {check}");
    // every digit over the largest range, over each power of ten, and over
    // each number of nine nines and below
    let every: Vec[i64] = (0..10).map(|d| digits_count(d, 1, 200000000)).collect();
    println(f"1 to 200000000, each digit: {every}");
    let zeros: Vec[i64] = (1..9).map(|k| digits_count(0, 1, 10.pow(k as u32))).collect();
    println(f"0 from 1 to each power of ten: {zeros}");
    let ones: Vec[i64] = (1..9).map(|k| digits_count(1, 10.pow((k - 1) as u32), 10.pow(k as u32) - 1)).collect();
    println(f"1 over each length of number: {ones}");
    let single: Vec[i64] = (0..10).map(|d| digits_count(d, 199999990, 199999990)).collect();
    println(f"199999990 alone, each digit: {single}");
}
