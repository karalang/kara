// LeetCode #1031: Maximum Sum of Two Non-Overlapping Subarrays -- bench
// Mirrors ../max_two.kara; see ../README.md § Benchmarks.

fn max_sum_two_no_overlap(nums: Vec[i64], first_len: i64, second_len: i64) -> i64 {
    let n = nums.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut best = 0;
    let mut best_first = 0;
    let mut best_second = 0;
    for i in first_len + second_len..n + 1 {
        best_first = best_first.max(prefix[i - second_len] - prefix[i - second_len - first_len]);
        best_second = best_second.max(prefix[i - first_len] - prefix[i - first_len - second_len]);
        best = best
            .max(best_first + prefix[i] - prefix[i - second_len])
            .max(best_second + prefix[i] - prefix[i - first_len]);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 1000;
    let rounds = 200;
    let mut seed = 1031;
    let mut cases: Vec[(Vec[i64], i64, i64)] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            nums.push(next_random(mut seed) % 1001);
        }
        let first_len = next_random(mut seed) % 999 + 1;
        let second_len = next_random(mut seed) % (1000 - first_len) + 1;
        cases.push((nums, first_len, second_len));
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for (nums, first_len, second_len) in cases.iter() {
            let answer = max_sum_two_no_overlap(nums, first_len, second_len);
            total += answer;
            check = (check * 131 + answer) % 1000000007;
        }
    }
    println(f"{count} arrays of 1000 values, {rounds} rounds: sum {total}, checksum {check}");
}
