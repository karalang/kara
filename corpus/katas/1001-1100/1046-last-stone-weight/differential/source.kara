// LeetCode #1046: Last Stone Weight -- differential
//
// The five arms, copied here under their own names, against the statement
// read literally, and five properties of the answer. See README.md §
// Differential.

// ---- a largest-first priority queue (last_stone.kara)

fn heap_arm(stones: Slice[i64]) -> i64 {
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first_from(stones.to_vec());
    loop {
        let y = match heap.pop() {
            Some(y) => y,
            None => return 0,
        };
        let x = match heap.pop() {
            Some(x) => x,
            None => return y,
        };
        if y > x {
            heap.push(y - x);
        }
    }
}

// ---- a sorted vector (last_stone_sorted.kara)

fn sorted_arm(stones: Slice[i64]) -> i64 {
    let mut pile = stones.to_vec();
    pile.sort();
    while pile.len() > 1 {
        let y = pile.pop().unwrap();
        let x = pile.pop().unwrap();
        if y > x {
            let rest = y - x;
            // the first place whose stone is not lighter than `rest`
            let mut low = 0;
            let mut high = pile.len();
            while low < high {
                let mid = (low + high) / 2;
                if pile[mid] < rest {
                    low = mid + 1;
                } else {
                    high = mid;
                }
            }
            pile.insert(low, rest);
        }
    }
    match pile.first() {
        Some(w) => w,
        None => 0,
    }
}

// ---- a count for every weight (last_stone_count.kara)

fn count_arm(stones: Slice[i64]) -> i64 {
    let mut heaviest = 0;
    for w in stones.iter() {
        heaviest = heaviest.max(w);
    }
    let mut count: Vec[i64] = Vec.filled(heaviest + 1, 0);
    for w in stones.iter() {
        count[w] += 1;
    }
    let mut y = heaviest;
    while y > 0 {
        if count[y] == 0 {
            y -= 1;
            continue;
        }
        // pairs of the same weight smash to nothing
        count[y] %= 2;
        if count[y] == 0 {
            y -= 1;
            continue;
        }
        let mut x = y - 1;
        while x > 0 and count[x] == 0 {
            x -= 1;
        }
        if x == 0 {
            return y;
        }
        count[y] -= 1;
        count[x] -= 1;
        count[y - x] += 1;
        y -= 1;
    }
    0
}

// ---- sort every turn (last_stone_resort.kara)

fn resort_arm(stones: Slice[i64]) -> i64 {
    let mut pile = stones.to_vec();
    while pile.len() > 1 {
        pile.sort();
        let y = pile.pop().unwrap();
        let x = pile.pop().unwrap();
        if y > x {
            pile.push(y - x);
        }
    }
    if pile.is_empty() { 0 } else { pile[0] }
}

// ---- the heaviest found by iterator (last_stone_iter.kara)

fn iter_arm(stones: Slice[i64]) -> i64 {
    let mut pile = stones.to_vec();
    while pile.len() > 1 {
        let y = iter_take_heaviest(mut pile);
        let x = iter_take_heaviest(mut pile);
        if y > x {
            pile.push(y - x);
        }
    }
    pile.iter().sum()
}

fn iter_take_heaviest(pile: mut ref Vec[i64]) -> i64 {
    let (at, _) = pile.iter().enumerate().max_by_key(|(_, w)| w).unwrap();
    pile.swap_remove(at)
}

// ---- the statement read literally

// Find the heaviest stone and the heaviest of the rest by looking at each
// one, smash them, and play on with what is left.
fn every_turn(stones: Slice[i64]) -> i64 {
    if stones.len() == 0 {
        return 0;
    }
    if stones.len() == 1 {
        return stones[0];
    }
    let mut first = 0;
    for i in 1..stones.len() {
        if stones[i] > stones[first] {
            first = i;
        }
    }
    let mut second = if first == 0 { 1 } else { 0 };
    for i in 0..stones.len() {
        if i != first and stones[i] > stones[second] {
            second = i;
        }
    }
    let mut rest: Vec[i64] = Vec.new();
    for i in 0..stones.len() {
        if i != first and i != second {
            rest.push(stones[i]);
        }
    }
    if stones[first] > stones[second] {
        rest.push(stones[first] - stones[second]);
    }
    every_turn(rest)
}

// ---- the harness

fn arm(a: i64, stones: Slice[i64]) -> i64 {
    match a {
        0 => heap_arm(stones),
        1 => sorted_arm(stones),
        2 => count_arm(stones),
        3 => resort_arm(stones),
        _ => iter_arm(stones),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_stones(n: i64, most: i64, seed: mut ref i64) -> Vec[i64] {
    let mut stones: Vec[i64] = Vec.new();
    for _ in 0..n {
        stones.push(next_random(mut seed) % most + 1);
    }
    stones
}

fn show(stones: Slice[i64]) -> String {
    let parts: Vec[String] = stones.iter().map(|w| w.to_string()).collect();
    "[" + parts.join(",") + "]"
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// Every check on one pile.
fn check_case(t: mut ref Tally, stones: Slice[i64]) {
    let answers: Vec[i64] = (0..5).map(|a| arm(a, stones)).collect();
    let want = every_turn(stones);
    let mut heaviest = 0;
    let mut sum = 0;
    for w in stones.iter() {
        heaviest = heaviest.max(w);
        sum += w;
    }
    let reversed: Vec[i64] = stones.iter().rev().collect();
    let mut rotated: Vec[i64] = stones[1..stones.len()].to_vec();
    rotated.push(stones[0]);
    let mut padded = stones.to_vec();
    padded.push(heaviest + 1);
    padded.push(heaviest + 1);
    for a in 0..5 {
        let answer = answers[a];
        let what = f"arm {a}, {show(stones)} -> {answer}";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally {want}");
        expect(mut t, 2, answer >= 0 and answer <= heaviest and (sum - answer) % 2 == 0, f"P2 {what}: out of range or parity");
        let floor = 2 * heaviest - sum;
        expect(mut t, 3, answer >= floor and (floor < 0 or answer == floor), f"P3 {what}: heaviest {heaviest}, sum {sum}");
        expect(mut t, 4, arm(a, reversed) == answer and arm(a, rotated) == answer, f"P4 {what}: reversed or rotated");
        expect(mut t, 5, arm(a, padded) == answer, f"P5 {what}: two stones of {heaviest + 1} added");
        let mut agree = 0;
        for o in 0..5 {
            if o != a and answers[o] == answer {
                agree += 1;
            }
        }
        expect(mut t, 6, agree >= 2, f"P6 {what}: agrees with {agree}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + answers[0] + 1) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // every pile of 1 to 6 stones of 1 to 4
    for n in 1..7 {
        let mut count = 1;
        for _ in 0..n {
            count *= 4;
        }
        for code in 0..count {
            let mut stones: Vec[i64] = Vec.new();
            let mut c = code;
            for _ in 0..n {
                stones.push(c % 4 + 1);
                c /= 4;
            }
            check_case(mut t, stones);
        }
    }
    // 1500 random piles of 1 to 30 stones: 1000 of 1 to 1000, and 500 of
    // 1 to 8, which tie often
    let mut seed = 10461;
    for c in 0..1500 {
        let n = next_random(mut seed) % 30 + 1;
        let most = if c < 1000 { 1000 } else { 8 };
        let stones = random_stones(n, most, mut seed);
        check_case(mut t, stones);
    }
    println(f"{t.cases} piles: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
