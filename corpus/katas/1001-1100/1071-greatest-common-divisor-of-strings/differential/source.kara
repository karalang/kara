// LeetCode #1071: Greatest Common Divisor of Strings -- the differential.
//
// The six arms against the statement read literally, on 2000 problems,
// with six properties:
//
// P1  the answer is the statement read literally: of every prefix of `a`,
//     the longest whose copies, laid end to end, make up both strings
// P2  the strings swapped give the same answer
// P3  the answer is empty, or as long as the gcd of the two lengths
// P4  `a` and `a` answer `a`, and `a + b` and `b` answer what `a` and `b` do
// P5  each string doubled answers the answer doubled
// P6  each arm agrees with at least three of the other five

// ---- gcd_strings.kara: the ★ arm: the two concatenations compared
fn star_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { star_gcd(b, a % b) }
}

fn star_arm(a: String, b: String) -> String {
    if a + b != b + a {
        return String.new();
    }
    a.substring(0, star_gcd(a.len(), b.len()))
}

// ---- gcd_strings_brute.kara: every length from the shorter's down
fn brute_made_of(s: String, root: String) -> bool {
    if s.len() % root.len() != 0 {
        return false;
    }
    let mut at = 0;
    while at < s.len() {
        if s.substring(at, at + root.len()) != root {
            return false;
        }
        at += root.len();
    }
    true
}

fn brute_arm(a: String, b: String) -> String {
    let mut k = a.len().min(b.len());
    while k > 0 {
        let root = a.substring(0, k);
        if brute_made_of(a, root) and brute_made_of(b, root) {
            return root;
        }
        k -= 1;
    }
    String.new()
}

// ---- gcd_strings_euclid.kara: Euclid's algorithm on the strings
fn euclid_arm(a: String, b: String) -> String {
    if a.len() < b.len() {
        return euclid_arm(b, a);
    }
    if b.is_empty() {
        return a.clone();
    }
    if not a.starts_with(b) {
        return String.new();
    }
    euclid_arm(a.substring(b.len()), b)
}

// ---- gcd_strings_period.kara: by each string's shortest root
fn period_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { period_gcd(b, a % b) }
}

fn period_root_len(s: String) -> i64 {
    let text = s.bytes();
    let n = text.len();
    let mut border: Vec[i64] = Vec.filled(n, 0);
    for i in 1..n {
        let mut k = border[i - 1];
        while k > 0 and text[i] != text[k] {
            k = border[k - 1];
        }
        if text[i] == text[k] {
            k += 1;
        }
        border[i] = k;
    }
    let p = n - border[n - 1];
    if n % p == 0 { p } else { n }
}

fn period_arm(a: String, b: String) -> String {
    let p = period_root_len(a);
    if p != period_root_len(b) or a.substring(0, p) != b.substring(0, p) {
        return String.new();
    }
    a.substring(0, p).repeat(period_gcd(a.len() / p, b.len() / p))
}

// ---- gcd_strings_letters.kara: letter by letter against `a`'s first g
fn letters_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { letters_gcd(b, a % b) }
}

fn letters_arm(a: String, b: String) -> String {
    let first: Vec[char] = a.chars().collect();
    let second: Vec[char] = b.chars().collect();
    let g = letters_gcd(first.len(), second.len());
    for i in 0..first.len() {
        if first[i] != first[i % g] {
            return String.new();
        }
    }
    for i in 0..second.len() {
        if second[i] != first[i % g] {
            return String.new();
        }
    }
    first[0..g].iter().collect()
}

// ---- gcd_strings_solution.kara: LeetCode's Rust template
struct Solution {}

fn solution_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { solution_gcd(b, a % b) }
}

impl Solution {
    pub fn gcd_of_strings(str1: String, str2: String) -> String {
        if f"{str1}{str2}" != f"{str2}{str1}" {
            return String.new();
        }
        let g = solution_gcd(str1.len(), str2.len());
        str1[..g].to_string()
    }
}

fn solution_arm(a: String, b: String) -> String {
    Solution.gcd_of_strings(a.clone(), b.clone())
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, a: String, b: String) -> String {
    match which {
        0 => star_arm(a, b),
        1 => brute_arm(a, b),
        2 => euclid_arm(a, b),
        3 => period_arm(a, b),
        4 => letters_arm(a, b),
        _ => solution_arm(a, b),
    }
}

fn random_word(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'A' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// Whether `t` divides `s`, as the statement says it: some number of
// copies of `t`, laid end to end, is `s`.
fn divides(t: String, s: String) -> bool {
    let mut laid = String.new();
    while laid.len() < s.len() {
        laid.push_str(t);
    }
    laid == s
}

// The statement read literally: the longest prefix of `a` that divides
// both (a string that divides `a` is a prefix of it).
fn literally(a: String, b: String) -> String {
    let mut best = String.new();
    for k in 1..=a.len() {
        let t = a.substring(0, k);
        if divides(t, a) and divides(t, b) {
            best = t;
        }
    }
    best
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, a: String, b: String) {
    let want = literally(a, b);
    let answers: Vec[String] = (0..6).map(|w| arm(w, a, b)).collect();
    let g = gcd(a.len(), b.len());
    for w in 0..6 {
        let answer = answers[w].clone();
        let what = f"arm {w}, \"{a}\" \"{b}\" -> \"{answer}\"";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally \"{want}\"");
        let swapped = arm(w, b, a);
        expect(mut t, 2, swapped == answer, f"P2 {what}: swapped -> \"{swapped}\"");
        expect(mut t, 3, answer.is_empty() or answer.len() == g, f"P3 {what}: gcd of the lengths {g}");
        let itself = arm(w, a, a);
        expect(mut t, 4, itself == a, f"P4 {what}: with itself -> \"{itself}\"");
        let longer = arm(w, a + b, b);
        expect(mut t, 4, longer == answer, f"P4 {what}: a + b and b -> \"{longer}\"");
        let doubled = arm(w, a + a, b + b);
        expect(mut t, 5, doubled == answer + answer, f"P5 {what}: doubled -> \"{doubled}\"");
        let agree = (0..6).filter(|o| o != w and answers[o] == answer).count();
        expect(mut t, 6, agree >= 3, f"P6 {what}: agrees with {agree}");
    }
    t.cases += 1;
    let mut fold = want.len();
    for c in want.bytes() {
        fold = (fold * 31 + c) % 1000000007;
    }
    t.check = (t.check * 31 + fold) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 problems: 1000 over one or two letters, of a root of 1 to 3
    // letters repeated 1 to 5 times, and 1000 over up to four letters of
    // up to 60; one in three has a letter of the second changed and one in
    // six a second of its own. Every choice is drawn before any arm answers.
    let mut seed = 10711;
    for i in 0..2000 {
        let (k, longest, most) = if i < 1000 { (next_random(mut seed) % 2 + 1, 3, 5) } else { (next_random(mut seed) % 4 + 1, 6, 10) };
        let root = random_word(next_random(mut seed) % longest + 1, k, mut seed);
        let a = root.repeat(next_random(mut seed) % most + 1);
        let mut b = root.repeat(next_random(mut seed) % most + 1);
        let roll = next_random(mut seed) % 6;
        if roll < 2 {
            let at = next_random(mut seed) % b.len();
            let letter = (b'A' + (next_random(mut seed) % k) as u8) as char;
            b = f"{b.substring(0, at)}{letter}{b.substring(at + 1)}";
        } else if roll == 2 {
            b = random_word(next_random(mut seed) % (longest * most) + 1, k, mut seed);
        }
        check_case(mut t, a, b);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
