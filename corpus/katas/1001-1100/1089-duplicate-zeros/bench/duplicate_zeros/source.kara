// Benchmark: LeetCode #1089 Duplicate Zeros -- the ★ arm, two passes in
// place: count the zeros, then walk back from the end writing each digit at
// its place shifted by the zeros up to it. 200 random arrays of 10^4
// digits, LeetCode's longest, a third of them 0, are built once; each of 100
// rounds copies every array and duplicates its zeros, folding two of its
// places into a checksum. Mirrors duplicate_zeros.rs, .c, .py and go-seq/.

fn duplicate_zeros(arr: mut ref Vec[i64]) {
    let n = arr.len();
    let mut zeros = 0;
    for x in arr.iter() {
        if x == 0 {
            zeros += 1;
        }
    }
    for i in (0..n).rev() {
        if i + zeros < n {
            arr[i + zeros] = arr[i];
        }
        if arr[i] == 0 {
            zeros -= 1;
            if i + zeros < n {
                arr[i + zeros] = 0;
            }
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1089;
    let mut arrays: Vec[Vec[i64]] = [];
    for _ in 0..200 {
        let mut arr: Vec[i64] = [];
        for _ in 0..10000 {
            let r = next_random(mut seed) % 15;
            arr.push(if r < 5 { 0 } else { r - 5 });
        }
        arrays.push(arr);
    }
    let mut zeros = 0;
    let mut check = 0;
    for round in 0..100 {
        for (k, a) in arrays.iter().enumerate() {
            let mut work = a.clone();
            duplicate_zeros(mut work);
            let at = (round * 7919 + k * 31) % 10000;
            if work[at] == 0 {
                zeros += 1;
            }
            check = (check * 31 + work[at] * 10 + work[9999]) % 1000000007;
        }
    }
    println(f"100 rounds over 200 arrays of 10^4 digits: {zeros} zeros sampled, checksum {check}");
}
