// LeetCode #1072: Flip Columns For Maximum Number of Equal Rows -- the
// benchmark: the ★ arm's count of row patterns over 200 matrices up to 300
// by 300 built once, each answered 30 times.

fn max_equal_rows(matrix: Vec[Vec[i64]]) -> i64 {
    let mut counts: Map[String, i64] = Map.new();
    let mut best = 0;
    for row in matrix.iter() {
        let mut key = String.new();
        for c in row.iter() {
            key.push(if *c != row[0] { '1' } else { '0' });
        }
        let seen = counts.get(key).unwrap_or(0) + 1;
        counts.insert(key, seen);
        best = best.max(seen);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_bits(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut bits = Vec.new();
    for _ in 0..n {
        bits.push(next_random(mut seed) % 2);
    }
    bits
}

// one to three patterns; each row is one of them, its complement, or one
// time in four a row of its own
fn random_matrix(rows: i64, cols: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let m = next_random(mut seed) % rows + 1;
    let n = next_random(mut seed) % cols + 1;
    let mut patterns = Vec.new();
    for _ in 0..next_random(mut seed) % 3 + 1 {
        patterns.push(random_bits(n, mut seed));
    }
    let mut matrix = Vec.new();
    for _ in 0..m {
        let roll = next_random(mut seed) % 8;
        if roll < 2 {
            matrix.push(random_bits(n, mut seed));
        } else {
            let p = patterns[next_random(mut seed) % patterns.len()].clone();
            if roll < 5 {
                matrix.push(p.iter().map(|c| 1 - c).collect());
            } else {
                matrix.push(p);
            }
        }
    }
    matrix
}

fn main() {
    let mut seed = 1072;
    let mut matrices: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..200 {
        matrices.push(random_matrix(300, 300, mut seed));
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..30 {
        for matrix in matrices.iter() {
            let x = max_equal_rows(matrix);
            total += x;
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"6000 calls: answers sum {total}, checksum {check}");
}
