// LeetCode #1020: Number of Enclaves -- bench
//
// The ★ arm (../enclaves.kara) on 100 random grids of 1 to 500 rows and
// columns (LeetCode's sizes), with land at each cell with probability 2/8
// to 6/8, built once and each answered 20 times, folding the answers into
// a sum and a checksum. See ../README.md § Benchmarks.

fn num_enclaves(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut land = grid.clone();
    let mut stack: Vec[(i64, i64)] = Vec.new();
    for i in 0..m {
        for j in 0..n {
            if (i == 0 or j == 0 or i == m - 1 or j == n - 1) and land[i][j] == 1 {
                land[i][j] = 0;
                stack.push((i, j));
            }
        }
    }
    let steps = [(1, 0), (-1, 0), (0, 1), (0, -1)];
    while let Some((i, j)) = stack.pop() {
        for (di, dj) in steps.iter() {
            let (a, b) = (i + di, j + dj);
            if a >= 0 and a < m and b >= 0 and b < n and land[a][b] == 1 {
                land[a][b] = 0;
                stack.push((a, b));
            }
        }
    }
    let mut left = 0;
    for row in land.iter() {
        for c in row.iter() {
            left += c;
        }
    }
    left
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let rounds = 20;
    let mut seed = 1020;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut cells = 0;
    for _ in 0..count {
        let m = next_random(mut seed) % 500 + 1;
        let n = next_random(mut seed) % 500 + 1;
        let land = 2 + next_random(mut seed) % 5;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(if next_random(mut seed) % 8 < land { 1 } else { 0 });
            }
            grid.push(row);
        }
        cells += m * n;
        grids.push(grid);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for grid in grids.iter() {
            let a = num_enclaves(grid);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"{count} grids, {cells} cells, {rounds} rounds: {total} enclaves, checksum {check}");
}
