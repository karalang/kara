// LeetCode #1064: Fixed Point -- the benchmark, the same binary search as
// fixed.kara.

fn fixed_point(arr: Slice[i64]) -> i64 {
    // arr[i] < i for every i below lo, and arr[i] >= i from hi on
    let mut lo = 0;
    let mut hi = arr.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if arr[mid] < mid {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < arr.len() and arr[lo] == lo { lo } else { -1 }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` distinct numbers in ascending order from `first`, each the last
// plus 1 or 2.
fn random_sorted(n: i64, first: i64, seed: mut ref i64) -> Vec[i64] {
    let mut x = first;
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push(x);
        x += 1 + next_random(mut seed) % 2;
    }
    arr
}

fn main() {
    // 8 arrays of 1000000 numbers, built once, then each answered on its
    // first 500000 suffixes
    let mut seed = 1064;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..8 {
        arrays.push(random_sorted(1000000, -100000 * a, mut seed));
    }
    let mut calls = 0;
    let mut found = 0;
    let mut check = 0;
    for arr in arrays.iter() {
        for p in 0..500000 {
            let answer = fixed_point(arr[p..]);
            if answer >= 0 {
                found += 1;
            }
            check = (check * 31 + answer + 1) % 1000000007;
            calls += 1;
        }
    }
    println(f"{calls} calls: {found} found, checksum {check}");
}
