// LeetCode #1064: Fixed Point -- the differential.
//
// The six arms against the statement read literally, on 2000 arrays, with
// six properties:
//
// P1  the answer is the statement read literally: the smallest index
//     whose number is the index, or -1 when none is
// P2  the answer is -1, or an index whose number is the index
// P3  every number raised by one, behind a negative number below them,
//     moves the answer one index later
// P4  a number above every one and above the length appended at the end
//     leaves the answer
// P5  the array cut in two: the front answers the answer when it falls
//     before the cut and -1 otherwise, and the back, every number lowered
//     by the cut, answers the answer less the cut when it falls at or
//     after the cut, -1 when there is none, and otherwise -1 or 0
// P6  each arm agrees with at least three of the other five

// ---- fixed.kara: the ★ arm: a binary search on the number less its index
fn star_arm(arr: Slice[i64]) -> i64 {
    // arr[i] < i for every i below lo, and arr[i] >= i from hi on
    let mut lo = 0;
    let mut hi = arr.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if arr[mid] < mid {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < arr.len() and arr[lo] == lo { lo } else { -1 }
}

// ---- fixed_scan.kara: every index in order
fn scan_arm(arr: Slice[i64]) -> i64 {
    arr.iter().enumerate().find(|(i, x)| x == i).map(|(i, _)| i).unwrap_or(-1)
}

// ---- fixed_partition.kara: partition_point over the numbers less their indices
fn partition_arm(arr: Slice[i64]) -> i64 {
    let shifted: Vec[i64] = arr.iter().enumerate().map(|(i, x)| x - i).collect();
    let at = shifted.partition_point(|d| d < 0);
    if at < shifted.len() and shifted[at] == 0 { at } else { -1 }
}

// ---- fixed_recursive.kara: divide and conquer
fn recursive_search(arr: Slice[i64], lo: i64, hi: i64) -> i64 {
    if lo >= hi {
        return -1;
    }
    let mid = lo + (hi - lo) / 2;
    if arr[mid] < mid {
        return recursive_search(arr, mid + 1, hi);
    }
    let left = recursive_search(arr, lo, mid);
    if left != -1 {
        left
    } else if arr[mid] == mid {
        mid
    } else {
        -1
    }
}

fn recursive_arm(arr: Slice[i64]) -> i64 {
    recursive_search(arr, 0, arr.len())
}

// ---- fixed_walk.kara: a walk to the first number not below its index
fn walk_arm(arr: Slice[i64]) -> i64 {
    let mut i = 0;
    while i < arr.len() and arr[i] < i {
        i += 1;
    }
    if i < arr.len() and arr[i] == i { i } else { -1 }
}

// ---- fixed_solution.kara: LeetCode's Rust template
struct Solution {}

impl Solution {
    pub fn fixed_point(arr: Vec[i32]) -> i32 {
        let mut (lo, hi) = (0, arr.len());
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if arr[mid] < mid as i32 {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo < arr.len() and arr[lo] == lo as i32 {
            lo as i32
        } else {
            -1
        }
    }
}

fn solution_arm(arr: Slice[i64]) -> i64 {
    let narrow: Vec[i32] = arr.iter().map(|x| x as i32).collect();
    Solution.fixed_point(narrow)
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` distinct numbers in ascending order, from `-start` up, each the last
// plus 1 to `gap`.
fn random_sorted(n: i64, start: i64, gap: i64, seed: mut ref i64) -> Vec[i64] {
    let mut x = next_random(mut seed) % (2 * start + 1) - start;
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push(x);
        x += 1 + next_random(mut seed) % gap;
    }
    arr
}

fn arm(a: i64, arr: Slice[i64]) -> i64 {
    match a {
        0 => star_arm(arr),
        1 => scan_arm(arr),
        2 => partition_arm(arr),
        3 => recursive_arm(arr),
        4 => walk_arm(arr),
        _ => solution_arm(arr),
    }
}

// The smallest index whose number is the index, or -1.
fn read_literally(arr: Slice[i64]) -> i64 {
    for i in 0..arr.len() {
        if arr[i] == i {
            return i;
        }
    }
    -1
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P6 at 1 to 6
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, arr: Slice[i64], seed: mut ref i64) {
    // every random choice drawn before any arm answers, so the problems
    // are the same whatever an arm gets wrong
    let n = arr.len();
    let front = arr[0].min(-1) - next_random(mut seed) % 3;
    let after = (arr[n - 1] + 1).max(n + 1) + next_random(mut seed) % 3;
    let cut = next_random(mut seed) % (n + 1);
    let mut moved: Vec[i64] = [front];
    moved.extend(arr.iter().map(|x| x + 1));
    let mut longer: Vec[i64] = arr.to_vec();
    longer.push(after);
    let back: Vec[i64] = arr[cut..n].iter().map(|x| x - cut).collect();
    let want = read_literally(arr);
    let answers: Vec[i64] = (0..6).map(|a| arm(a, arr)).collect();
    for a in 0..6 {
        let answer = answers[a];
        let what = f"arm {a}, {arr} -> {answer}";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally {want}");
        let shaped = answer == -1 or (answer >= 0 and answer < n and arr[answer] == answer);
        expect(mut t, 2, shaped, f"P2 {what}");
        let later = arm(a, moved);
        let moved_want = if answer == -1 { -1 } else { answer + 1 };
        expect(mut t, 3, later == moved_want, f"P3 {what}: raised behind {front} -> {later}");
        let kept = arm(a, longer);
        expect(mut t, 4, kept == answer, f"P4 {what}: with {after} at the end -> {kept}");
        let head = arm(a, arr[0..cut]);
        let head_want = if answer < cut { answer } else { -1 };
        expect(mut t, 5, head == head_want, f"P5 {what}: cut at {cut}, the front -> {head}");
        let tail = arm(a, back);
        let tail_ok = if answer == -1 { tail == -1 } else if answer >= cut { tail == answer - cut } else { tail == -1 or tail == 0 };
        expect(mut t, 5, tail_ok, f"P5 {what}: cut at {cut}, the back lowered -> {tail}");
        let agree = (0..6).filter(|o| o != a and answers[o] == answer).count();
        expect(mut t, 6, agree >= 3, f"P6 {what}: agrees with {agree}");
    }
    t.cases += 1;
    t.check = (t.check * 31 + want + 1) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 arrays: 1000 of 1 to 12 numbers from at most 5 below 0, and 1000
    // of 1 to 40 from at most 20 below 0
    let mut seed = 10641;
    for i in 0..2000 {
        let (n, start, gap) = if i < 1000 { (12, 6, 3) } else { (40, 21, 4) };
        let arr = random_sorted(next_random(mut seed) % n + 1, next_random(mut seed) % start, next_random(mut seed) % gap + 1, mut seed);
        check_case(mut t, arr, mut seed);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
