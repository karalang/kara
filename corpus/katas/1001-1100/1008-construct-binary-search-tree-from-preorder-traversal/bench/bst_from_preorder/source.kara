// LeetCode #1008 bench: the ★ arm (recursion with an upper bound) over 50
// preorders of 100 values, LeetCode's longest, drawn once; each of 4000
// rounds builds every tree, starting from a different preorder, and folds
// it into a checksum.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn bst_from_preorder(preorder: ref Vec[i64]) -> Option[TreeNode] {
    let mut next = 0;
    build(preorder, mut next, i64.MAX)
}

fn build(preorder: ref Vec[i64], next: mut ref i64, bound: i64) -> Option[TreeNode] {
    if *next == preorder.len() or preorder[*next] >= bound {
        return None;
    }
    let val = preorder[*next];
    *next += 1;
    let left = build(preorder, mut next, val);
    let right = build(preorder, mut next, bound);
    Some(TreeNode { val: val, left: left, right: right })
}

fn fold(node: ref Option[TreeNode], depth: i64) -> i64 {
    match node {
        Some(n) => (n.val * depth + fold(n.left, depth + 1) * 3 + fold(n.right, depth + 1) * 7) % 1000000007,
        None => 0,
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The preorder of a BST of `n` distinct values from 1 to `most`, inserted
// in random order: the tree is kept as arrays of children, -1 for none.
fn random_preorder(n: i64, most: i64, seed: mut ref i64) -> Vec[i64] {
    let mut seen: Vec[bool] = Vec.filled(most + 1, false);
    let mut vals: Vec[i64] = Vec.new();
    let mut left: Vec[i64] = Vec.new();
    let mut right: Vec[i64] = Vec.new();
    while vals.len() < n {
        let v = 1 + next_random(mut seed) % most;
        if seen[v] {
            continue;
        }
        seen[v] = true;
        vals.push(v);
        left.push(-1);
        right.push(-1);
        let me = vals.len() - 1;
        if me > 0 {
            let mut at = 0;
            loop {
                if v < vals[at] {
                    if left[at] == -1 {
                        left[at] = me;
                        break;
                    }
                    at = left[at];
                } else {
                    if right[at] == -1 {
                        right[at] = me;
                        break;
                    }
                    at = right[at];
                }
            }
        }
    }
    let mut out: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = vec![0];
    while stack.len() > 0 {
        let at = stack.pop().unwrap();
        out.push(vals[at]);
        if right[at] != -1 {
            stack.push(right[at]);
        }
        if left[at] != -1 {
            stack.push(left[at]);
        }
    }
    out
}

fn main() {
    let count = 50;
    let rounds = 4000;
    let mut seed = 1008;
    let mut preorders: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        preorders.push(random_preorder(100, 1000, mut seed));
    }
    let mut check = 0;
    for r in 0..rounds {
        for k in 0..count {
            let tree = bst_from_preorder(preorders[(r + k) % count]);
            check = (check * 31 + fold(tree, 1)) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} preorders of 100 values: checksum {check}");
}
