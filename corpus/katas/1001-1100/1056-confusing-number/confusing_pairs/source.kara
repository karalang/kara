// LeetCode #1056: Confusing Number -- the digits in pairs, no number built.
//
// The turned number's digit at place `i` is the turn of `n`'s digit at the
// mirror place `len - 1 - i`. So `n` is confusing when every digit turns and
// at least one place holds a digit other than its mirror's turn. A turned
// number that starts with zeros has fewer digits, and is caught at place 0:
// `n`'s first digit is never 0, its mirror's turn is. O(d) for d digits.

fn turn(c: u8) -> Option[u8] {
    match c {
        b'0' => Some(b'0'),
        b'1' => Some(b'1'),
        b'6' => Some(b'9'),
        b'8' => Some(b'8'),
        b'9' => Some(b'6'),
        _ => None,
    }
}

fn confusing_number(n: i64) -> bool {
    let s = n.to_string();
    let s = s.bytes();
    let len = s.len();
    let mut differs = false;
    for i in 0..len {
        match turn(s[len - 1 - i]) {
            Some(t) => {
                if t != s[i] {
                    differs = true;
                }
            }
            None => return false,
        }
    }
    differs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A number of 1 to 9 digits, each one of 0, 1, 6, 8 and 9.
fn random_turnable(seed: mut ref i64) -> i64 {
    let digits = [0, 1, 6, 8, 9];
    let mut n = 0;
    for _ in 0..next_random(mut seed) % 9 + 1 {
        n = n * 10 + digits[next_random(mut seed) % 5];
    }
    n
}

fn main() {
    // LeetCode's examples, then a few more
    let examples = [6, 89, 11, 25, 0, 10, 916, 69, 8000, 100];
    for n in examples {
        println(f"{n} -> {confusing_number(n)}");
    }
    // every number up to 100000: how many are confusing, their total, and a
    // checksum of every answer
    let mut count = 0;
    let mut total = 0;
    let mut check = 0;
    for n in 0..100001 {
        let answer = confusing_number(n);
        if answer {
            count += 1;
            total += n;
        }
        check = (check * 131 + if answer { 2 } else { 1 }) % 1000000007;
    }
    println(f"0 to 100000: {count} confusing, total {total}, checksum {check}");
    // 3000 random numbers of the digits that turn
    let mut seed = 1056;
    let mut count = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = random_turnable(mut seed);
        let answer = confusing_number(n);
        if answer {
            count += 1;
            total = (total + n) % 1000000007;
        }
        check = (check * 131 + if answer { 2 } else { 1 }) % 1000000007;
    }
    println(f"3000 random numbers of 0, 1, 6, 8 and 9: {count} confusing, total {total}, checksum {check}");
    // the largest
    for n in [1000000000, 999999999, 968999896, 916000001, 986101986, 818181818, 123456789] {
        println(f"{n} -> {confusing_number(n)}");
    }
}
