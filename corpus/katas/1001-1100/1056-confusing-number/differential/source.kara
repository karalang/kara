// LeetCode #1056: Confusing Number -- the differential.
//
// The five arms against the statement read literally, on 3000 numbers, with
// seven properties:
//
// P1  the answer is the statement read literally
// P2  a number with a 2, 3, 4, 5 or 7 is never confusing; one above 0 whose
//     digits all turn and that ends in 0 always is; and one digit is
//     confusing exactly when it is 6 or 9
// P3  a number whose digits all turn and that does not end in 0 is
//     confusing exactly when the number it turns into is
// P4  a number's digits followed by its digits turned, or with 0, 1 or 8
//     between them, read the same upside down: never confusing
// P5  every 6 made a 9 and every 9 a 6 leaves the answer
// P6  the digits reversed, for a number that does not end in 0, leave the
//     answer
// P7  each arm agrees with at least two of the other four
// ---- confusing.kara: the ★ arm: the digits turned one at a time
fn star_arm(n: i64) -> bool {
    let turned = [0, 1, -1, -1, -1, -1, 9, -1, 8, 6];
    let mut rest = n;
    let mut upside = 0;
    while rest > 0 {
        let d = turned[rest % 10];
        if d < 0 {
            return false;
        }
        upside = upside * 10 + d;
        rest /= 10;
    }
    upside != n
}

// ---- confusing_match.kara: a `match` for each digit, turned by recursion
fn turn_digit(d: i64) -> Option[i64] {
    match d {
        0 => Some(0),
        1 => Some(1),
        6 => Some(9),
        8 => Some(8),
        9 => Some(6),
        _ => None,
    }
}

fn upside_down_from(n: i64, acc: i64) -> Option[i64] {
    if n == 0 {
        return Some(acc);
    }
    let d = turn_digit(n % 10)?;
    upside_down_from(n / 10, acc * 10 + d)
}

fn match_arm(n: i64) -> bool {
    match upside_down_from(n, 0) {
        Some(u) => u != n,
        None => false,
    }
}

// ---- confusing_string.kara: the decimal string turned
fn string_arm(n: i64) -> bool {
    let s = n.to_string();
    let turned: Option[String] = s
        .chars()
        .rev()
        .map(|c| match c {
            '0' => Some('0'),
            '1' => Some('1'),
            '6' => Some('9'),
            '8' => Some('8'),
            '9' => Some('6'),
            _ => None,
        })
        .collect();
    match turned {
        Some(t) => i64.parse(t).unwrap() != n,
        None => false,
    }
}

// ---- confusing_pairs.kara: the digits in pairs, no number built
fn turn_byte(c: u8) -> Option[u8] {
    match c {
        b'0' => Some(b'0'),
        b'1' => Some(b'1'),
        b'6' => Some(b'9'),
        b'8' => Some(b'8'),
        b'9' => Some(b'6'),
        _ => None,
    }
}

fn pairs_arm(n: i64) -> bool {
    let s = n.to_string();
    let s = s.bytes();
    let len = s.len();
    let mut differs = false;
    for i in 0..len {
        match turn_byte(s[len - 1 - i]) {
            Some(t) => {
                if t != s[i] {
                    differs = true;
                }
            }
            None => return false,
        }
    }
    differs
}

// ---- confusing_iter.kara: `successors` and `try_fold`
const TURNED: Array[Option[i64], 10] = [Some(0), Some(1), None, None, None, None, Some(9), None, Some(8), Some(6)];

fn iter_arm(n: i64) -> bool {
    successors(Some(n), |x| if x >= 10 { Some(x / 10) } else { None })
        .map(|x| x % 10)
        .try_fold(0, |acc, d| TURNED[d as usize].map(|t| acc * 10 + t))
        .map_or(false, |u| u != n)
}

// ---- the statement read literally
// Turned upside down, the digits of `n` come in the other order and each is
// drawn as the digit it looks like; zeros the turned number starts with are
// not written. `None` when a digit looks like no digit.
fn turned_text(n: i64) -> Option[String] {
    let written = n.to_string();
    let mut turned = String.new();
    for c in written.chars().rev() {
        if c == '0' or c == '1' or c == '8' {
            turned.push(c);
        } else if c == '6' {
            turned.push('9');
        } else if c == '9' {
            turned.push('6');
        } else {
            return None;
        }
    }
    let mut shown = String.new();
    for c in turned.chars() {
        if c != '0' or not shown.is_empty() {
            shown.push(c);
        }
    }
    if shown.is_empty() { Some("0".to_string()) } else { Some(shown) }
}

// Confusing: it turns into a number, and not the one it was.
fn read_literally(n: i64) -> bool {
    match turned_text(n) {
        Some(t) => t != n.to_string(),
        None => false,
    }
}

fn arm(a: i64, n: i64) -> bool {
    match a {
        0 => star_arm(n),
        1 => match_arm(n),
        2 => string_arm(n),
        3 => pairs_arm(n),
        _ => iter_arm(n),
    }
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A number of 1 to `most` digits, each one of 0, 1, 6, 8 and 9.
fn random_turnable(most: i64, seed: mut ref i64) -> i64 {
    let digits = [0, 1, 6, 8, 9];
    let mut n = 0;
    for _ in 0..next_random(mut seed) % most + 1 {
        n = n * 10 + digits[next_random(mut seed) % 5];
    }
    n
}

fn all_turn(n: i64) -> bool {
    n.to_string().chars().all(|c| "01689".contains(c.to_string()))
}

// `n` with every 6 made a 9 and every 9 a 6.
fn swapped(n: i64) -> i64 {
    let text: String = n.to_string().chars().map(|c| if c == '6' { '9' } else if c == '9' { '6' } else { c }).collect();
    i64.parse(text).unwrap()
}

fn reversed(n: i64) -> i64 {
    let text: String = n.to_string().chars().rev().collect();
    i64.parse(text).unwrap()
}

// `n`'s digits, then `middle` (when it is not empty), then `n`'s digits
// turned: a number that reads the same upside down.
fn mirrored(n: i64, middle: ref String) -> i64 {
    let back = turned_text(n).unwrap();
    // the turned digits, with the zeros they start with kept
    let pad = n.to_string().len() - back.len();
    i64.parse(n.to_string() + middle + "0".repeat(pad) + back).unwrap()
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    // failures by property, P1 to P7 at 1 to 7
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// Every check on one number.
fn check_case(t: mut ref Tally, n: i64, middle: ref String) {
    let answers: Vec[bool] = (0..5).map(|a| arm(a, n)).collect();
    let want = read_literally(n);
    let turns = all_turn(n);
    for a in 0..5 {
        let answer = answers[a];
        let what = f"arm {a}, {n} -> {answer}";
        expect(mut t, 1, answer == want, f"P1 {what}, read literally {want}");
        let range = if not turns {
            not answer
        } else if n > 0 and n % 10 == 0 {
            answer
        } else if n < 10 {
            answer == (n == 6 or n == 9)
        } else {
            true
        };
        expect(mut t, 2, range, f"P2 {what}: out of range");
        if turns and n % 10 != 0 {
            let u = i64.parse(turned_text(n).unwrap()).unwrap();
            expect(mut t, 3, arm(a, u) == answer, f"P3 {what}: turned {u} -> {arm(a, u)}");
        }
        if turns and n < 10000000 and n % 10 != 0 {
            let m = mirrored(n, middle);
            expect(mut t, 4, not arm(a, m), f"P4 {what}: {m} reads the same");
        }
        expect(mut t, 5, arm(a, swapped(n)) == answer, f"P5 {what}: {swapped(n)} with 6 and 9 swapped");
        if n % 10 != 0 {
            expect(mut t, 6, arm(a, reversed(n)) == answer, f"P6 {what}: {reversed(n)} reversed");
        }
        let agree = (0..5).filter(|o| o != a and answers[o] == answer).count();
        expect(mut t, 7, agree >= 2, f"P7 {what}: agrees with {agree}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + if answers[0] { 2 } else { 1 } + n % 1000) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(8, 0) };
    // 3000 numbers: 1000 of 1 to 9 digits that all turn, 1000 that read the
    // same upside down, and 1000 of any digits, up to 2000 or up to 10^9
    let middles = ["".to_string(), "0".to_string(), "1".to_string(), "8".to_string()];
    let mut seed = 10561;
    for i in 0..3000 {
        let middle = ref middles[next_random(mut seed) % 4];
        let n = if i < 1000 {
            random_turnable(9, mut seed)
        } else if i < 2000 {
            let k = random_turnable(4, mut seed);
            if k % 10 == 0 { k } else { mirrored(k, middle) }
        } else if i % 2 == 0 {
            next_random(mut seed) % 2001
        } else {
            (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001
        };
        check_case(mut t, n, middle);
    }
    println(f"{t.cases} numbers: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..8).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
