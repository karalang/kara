// LeetCode #1056: Confusing Number -- the digits by `successors`, turned by
// `try_fold`.
//
// `successors` walks `n`, `n / 10`, `n / 100`, ... down to its first digit,
// and each step's `% 10` is the next digit from the end. `try_fold` builds
// the turned number from those digits, a table look-up each, stopping at
// `None` on the first digit that does not turn. O(d) for d digits.

const TURNED: Array[Option[i64], 10] = [Some(0), Some(1), None, None, None, None, Some(9), None, Some(8), Some(6)];

fn confusing_number(n: i64) -> bool {
    successors(Some(n), |x| if x >= 10 { Some(x / 10) } else { None })
        .map(|x| x % 10)
        .try_fold(0, |acc, d| TURNED[d as usize].map(|t| acc * 10 + t))
        .map_or(false, |u| u != n)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A number of 1 to 9 digits, each one of 0, 1, 6, 8 and 9.
fn random_turnable(seed: mut ref i64) -> i64 {
    let digits = [0, 1, 6, 8, 9];
    let mut n = 0;
    for _ in 0..next_random(mut seed) % 9 + 1 {
        n = n * 10 + digits[next_random(mut seed) % 5];
    }
    n
}

fn main() {
    // LeetCode's examples, then a few more
    let examples = [6, 89, 11, 25, 0, 10, 916, 69, 8000, 100];
    for n in examples {
        println(f"{n} -> {confusing_number(n)}");
    }
    // every number up to 100000: how many are confusing, their total, and a
    // checksum of every answer
    let mut count = 0;
    let mut total = 0;
    let mut check = 0;
    for n in 0..100001 {
        let answer = confusing_number(n);
        if answer {
            count += 1;
            total += n;
        }
        check = (check * 131 + if answer { 2 } else { 1 }) % 1000000007;
    }
    println(f"0 to 100000: {count} confusing, total {total}, checksum {check}");
    // 3000 random numbers of the digits that turn
    let mut seed = 1056;
    let mut count = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = random_turnable(mut seed);
        let answer = confusing_number(n);
        if answer {
            count += 1;
            total = (total + n) % 1000000007;
        }
        check = (check * 131 + if answer { 2 } else { 1 }) % 1000000007;
    }
    println(f"3000 random numbers of 0, 1, 6, 8 and 9: {count} confusing, total {total}, checksum {check}");
    // the largest
    for n in [1000000000, 999999999, 968999896, 916000001, 986101986, 818181818, 123456789] {
        println(f"{n} -> {confusing_number(n)}");
    }
}
