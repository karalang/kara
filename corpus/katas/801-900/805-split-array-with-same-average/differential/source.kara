// LeetCode #805: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties
// on random arrays.

// ---- ★ arm ----------------------------------------------------------

fn split_array_same_average_star(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let total = nums.iter().sum();
    let half = n / 2;
    let mut sums: Vec[Set[i64]] = Vec.new();
    for _ in 0..half + 1 {
        sums.push(Set.new());
    }
    sums[0].insert(0);
    for x in nums.iter() {
        let mut k = half;
        while k >= 1 {
            let before: Vec[i64] = sums[k - 1].iter().collect();
            for s in before.iter() {
                sums[k].insert(s + x);
            }
            k -= 1;
        }
    }
    for k in 1..half + 1 {
        if total * k % n == 0 and sums[k].contains(total * k / n) {
            return true;
        }
    }
    false
}

// ---- meet arm -------------------------------------------------------

fn split_array_same_average_meet(nums: Vec[i64]) -> bool {
    let n = nums.len();
    if n < 2 {
        return false;
    }
    let total = nums.iter().sum();
    let mut v: Vec[i64] = Vec.new();
    for x in nums.iter() {
        v.push(x * n - total);
    }
    let left = n / 2;
    let right = n - left;
    let mut kept: Set[i64] = Set.new();
    for mask in 1..1 << left {
        let mut sum = 0;
        for i in 0..left {
            if mask & (1 << i) != 0 {
                sum += v[i];
            }
        }
        if sum == 0 {
            return true;
        }
        if mask != (1 << left) - 1 {
            kept.insert(sum);
        }
    }
    for mask in 1..1 << right {
        let mut sum = 0;
        for i in 0..right {
            if mask & (1 << i) != 0 {
                sum += v[left + i];
            }
        }
        if sum == 0 or kept.contains(-sum) {
            return true;
        }
    }
    false
}

// ---- bits arm -------------------------------------------------------

fn split_array_same_average_bits(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let total = nums.iter().sum();
    let half = n / 2;
    let words = total / 64 + 1;
    let mut rows: Vec[Vec[u64]] = Vec.new();
    for _ in 0..half + 1 {
        let mut row: Vec[u64] = Vec.new();
        for _ in 0..words {
            row.push(0);
        }
        rows.push(row);
    }
    rows[0][0] = 1;
    for x in nums.iter() {
        let whole = x / 64;
        let part = x % 64;
        let mut k = half;
        while k >= 1 {
            // Row k |= row k - 1 shifted up by x bits, from the top word
            // down so that nothing is shifted twice.
            let mut w = words - 1;
            while w >= whole {
                let from = w - whole;
                let mut bits = rows[k - 1][from] << part;
                if part > 0 and from > 0 {
                    bits = bits | (rows[k - 1][from - 1] >> (64 - part));
                }
                rows[k][w] = rows[k][w] | bits;
                w -= 1;
            }
            k -= 1;
        }
    }
    for k in 1..half + 1 {
        if total * k % n == 0 {
            let s = total * k / n;
            if (rows[k][s / 64] >> (s % 64)) & 1 == 1 {
                return true;
            }
        }
    }
    false
}

// ---- pick arm -------------------------------------------------------

fn split_array_same_average_pick(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let total = nums.iter().sum();
    let mut sorted = nums.clone();
    sorted.sort();
    for k in 1..n / 2 + 1 {
        if total * k % n == 0 and pick_pick(sorted, 0, k, total * k / n) {
            return true;
        }
    }
    false
}

// Whether `count` of sorted[from..] sum to `want`.
fn pick_pick(sorted: Vec[i64], from: i64, count: i64, want: i64) -> bool {
    if count == 0 {
        return want == 0;
    }
    let mut i = from;
    while i < sorted.len() {
        if sorted[i] * count > want {
            return false;
        }
        if (i == from or sorted[i] != sorted[i - 1]) and pick_pick(sorted, i + 1, count - 1, want - sorted[i]) {
            return true;
        }
        i += 1;
    }
    false
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, nums: Vec[i64]) -> bool {
    if which == 0 {
        split_array_same_average_star(nums)
    } else if which == 1 {
        split_array_same_average_meet(nums)
    } else if which == 2 {
        split_array_same_average_bits(nums)
    } else {
        split_array_same_average_pick(nums)
    }
}

// The definition: try every way to cut the numbers into two nonempty
// parts, and compare the averages without dividing: sum(a) / |a| ==
// total / n exactly when sum(a) · n == total · |a|.
fn definition(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let total = nums.iter().sum();
    for mask in 1..(1 << n) - 1 {
        let mut sum = 0;
        let mut size = 0;
        for i in 0..n {
            if mask & (1 << i) != 0 {
                sum += nums[i];
                size += 1;
            }
        }
        if sum * n == total * size {
            return true;
        }
    }
    false
}

fn main() {
    let arms = 4;
    let mut seed = 8050;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1600;
    let mut total = 0;
    for case in 0..cases {
        // kind 0: numbers below 4, so that splits are common; kind 1:
        // below 100; kind 2: up to 10,000, LeetCode's most; kind 3:
        // mostly zeros with a few large numbers.
        let kind = case % 4;
        let n = 1 + next_random(mut seed) % 11;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let x = if kind == 0 {
                next_random(mut seed) % 4
            } else if kind == 1 {
                next_random(mut seed) % 100
            } else if kind == 2 {
                next_random(mut seed) % 10001
            } else if next_random(mut seed) % 4 == 0 {
                5000 + next_random(mut seed) % 5001
            } else {
                0
            };
            nums.push(x);
        }
        let want = definition(nums);
        if want {
            total += 1;
        }
        let sum = nums.iter().sum();
        let mut backwards: Vec[i64] = Vec.new();
        let mut moved: Vec[i64] = Vec.new();
        let mut twice: Vec[i64] = Vec.new();
        for i in 0..n {
            backwards.push(nums[n - 1 - i]);
            moved.push(2 * nums[i] + 3);
        }
        // Only the first five numbers, twice, to keep the cases small.
        let few = if n < 5 { n } else { 5 };
        for i in 0..few {
            twice.push(nums[i]);
        }
        for i in 0..few {
            twice.push(nums[i]);
        }
        let mut with_mean = nums.clone();
        with_mean.push(sum / n);
        for which in 0..arms {
            let got = answer_with(which, nums);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the numbers in the other order, the same answer.
            checks += 1;
            if answer_with(which, backwards) != got {
                fails[1] += 1;
            }
            // P3: every number doubled and 3 added, the same answer, as
            // both averages move the same way.
            checks += 1;
            if answer_with(which, moved) != got {
                fails[2] += 1;
            }
            // P4: any numbers given twice over can be split, into the two
            // copies; and so can the numbers with their average added,
            // when it is a whole number, into it and the rest.
            checks += 1;
            if not answer_with(which, twice) or (sum % n == 0 and not answer_with(which, with_mean)) {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} cases ({total} can be split), {arms} arms, {checks} checks, {failures} failures");
}
