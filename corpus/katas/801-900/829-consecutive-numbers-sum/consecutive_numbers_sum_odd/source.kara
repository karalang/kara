// LeetCode #829: Consecutive Numbers Sum -- the odd divisors.
//
// A run of odd length k is centred on n / k, so it exists when k divides
// n; a run of even length k is centred between two numbers, which needs
// 2n / k odd. Pairing each run with the odd one of k and 2n / k shows
// the runs match the odd divisors of n, one for one. So the answer is
// the number of divisors of n with its factors of 2 taken out, counted
// from its prime factors by trial division. O(sqrt n).

fn consecutive_numbers_sum(n: i64) -> i64 {
    let mut m = n;
    while m % 2 == 0 {
        m /= 2;
    }
    let mut divisors = 1;
    let mut p = 3;
    while p * p <= m {
        let mut e = 0;
        while m % p == 0 {
            m /= p;
            e += 1;
        }
        divisors *= e + 1;
        p += 2;
    }
    if m > 1 {
        divisors *= 2;
    }
    divisors
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n} -> {consecutive_numbers_sum(n)}");
}

fn main() {
    show(5);
    show(9);
    show(15);
    show(1);
    show(2);
    show(3);
    show(4);
    show(1024);
    show(945);
    show(1000000000);
    show(999999937);
    show(536870912);
    show(918918000);
    let mut total = 0;
    let mut check = 0;
    for n in 1..3001 {
        let r = consecutive_numbers_sum(n);
        total += r;
        check = (check * 131 + r) % 1000000007;
    }
    println(f"1 to 3000: total {total}, checksum {check}");
    let mut seed = 829;
    total = 0;
    check = 0;
    for _ in 0..100 {
        let n = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000;
        let r = consecutive_numbers_sum(n);
        total += r;
        check = (check * 131 + r) % 1000000007;
    }
    println(f"100 random up to 10^9: total {total}, checksum {check}");
}
