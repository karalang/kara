// Benchmark for #829: Consecutive Numbers Sum -- the ★ arm (each length).
//
// n has a run of k consecutive numbers exactly when n - k * (k - 1) / 2
// is a positive multiple of k, and k runs while 1 + 2 + ... + k fits.

fn consecutive_numbers_sum(n: i64) -> i64 {
    let mut count = 0;
    let mut k = 1;
    while k * (k + 1) / 2 <= n {
        if (n - k * (k - 1) / 2) % k == 0 {
            count += 1;
        }
        k += 1;
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 numbers between 5 * 10^8 and 10^9, LeetCode's largest, drawn
    // once. Each round answers the next one.
    let count = 64;
    let rounds = 16000;
    let mut seed: i64 = 829;
    let mut numbers: Vec[i64] = Vec.new();
    for _ in 0..count {
        let r = next_random(mut seed) * 32768 + next_random(mut seed);
        numbers.push(500000000 + r % 500000001);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        let r = consecutive_numbers_sum(numbers[round % count]);
        total += r;
        checksum = (checksum * 131 + r) % 1000000007;
    }
    println(f"{rounds} rounds of {count} numbers: total {total}, checksum {checksum}");
}
