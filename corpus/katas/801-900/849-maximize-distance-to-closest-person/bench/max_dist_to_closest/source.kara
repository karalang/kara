// Benchmark for #849: Maximize Distance to Closest Person -- the ★ arm (one
// pass, remembering the last person).
//
// Each person ends a stretch of empty seats: before the first person
// the best seat is the far end, between two people the middle, half
// the gap away, and after the last person the other end.

fn max_dist_to_closest(seats: Vec[i64]) -> i64 {
    let n = seats.len();
    let mut last = -1;
    let mut best = 0;
    for i in 0..n {
        if seats[i] == 1 {
            if last < 0 {
                best = i;
            } else {
                best = best.max((i - last) / 2);
            }
            last = i;
        }
    }
    best.max(n - 1 - last)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 rows drawn once, each of LeetCode's most seats, 2 * 10^4: row
    // `g` takes a seat with probability 1 in `2 << (g % 8)`, from one in
    // two to one in 256, and has at least one person and one empty seat.
    // Each round asks the next row.
    let count = 64;
    let rounds = 20000;
    let n = 20000;
    let mut seed: i64 = 849;
    let mut rows: Vec[Vec[i64]] = Vec.new();
    for g in 0..count {
        let odds = 2 << (g % 8);
        let mut seats: Vec[i64] = Vec.new();
        for _ in 0..n {
            seats.push(if next_random(mut seed) % odds == 0 { 1 } else { 0 });
        }
        let taken = next_random(mut seed) % n;
        let empty = (taken + 1 + next_random(mut seed) % (n - 1)) % n;
        seats[taken] = 1;
        seats[empty] = 0;
        rows.push(seats);
    }
    let mut total = 0;
    let mut checksum = 0;
    for round in 0..rounds {
        let d = max_dist_to_closest(rows[round % count]);
        total += d;
        checksum = (checksum * 31 + d) % 1000000007;
    }
    println(f"{rounds} rounds of {count} rows: distances sum to {total}, checksum {checksum}");
}
