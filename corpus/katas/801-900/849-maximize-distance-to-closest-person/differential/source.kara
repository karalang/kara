// LeetCode #849: differential -- the four arms against the statement.
//
// Copies of the four arms, held to five properties on random rows,
// against the statement read literally.

// ---- ★ arm ----------------------------------------------------------

fn max_dist_to_closest_star(seats: Vec[i64]) -> i64 {
    let n = seats.len();
    let mut last = -1;
    let mut best = 0;
    for i in 0..n {
        if seats[i] == 1 {
            if last < 0 {
                best = i;
            } else {
                best = best.max((i - last) / 2);
            }
            last = i;
        }
    }
    best.max(n - 1 - last)
}

// ---- two-sides arm --------------------------------------------------

fn max_dist_to_closest_sides(seats: Vec[i64]) -> i64 {
    let n = seats.len();
    let far = n + 1;
    let mut left: Vec[i64] = Vec.filled(n, far);
    let mut right: Vec[i64] = Vec.filled(n, far);
    for i in 0..n {
        if seats[i] == 1 {
            left[i] = 0;
        } else if i > 0 and left[i - 1] < far {
            left[i] = left[i - 1] + 1;
        }
    }
    for i in (0..n).rev() {
        if seats[i] == 1 {
            right[i] = 0;
        } else if i + 1 < n and right[i + 1] < far {
            right[i] = right[i + 1] + 1;
        }
    }
    let mut best = 0;
    for i in 0..n {
        if seats[i] == 0 {
            best = best.max(left[i].min(right[i]));
        }
    }
    best
}

// ---- runs arm -------------------------------------------------------

fn max_dist_to_closest_runs(seats: Vec[i64]) -> i64 {
    let n = seats.len();
    let mut runs: Vec[(i64, bool)] = Vec.new();
    let mut start = 0;
    for i in 0..n + 1 {
        if i == n or seats[i] == 1 {
            if i > start {
                runs.push((i - start, start == 0 or i == n));
            }
            start = i + 1;
        }
    }
    let mut best = 0;
    for (k, at_end) in runs.iter() {
        best = best.max(if at_end { k } else { (k + 1) / 2 });
    }
    best
}

// ---- next-person arm ------------------------------------------------

fn max_dist_to_closest_next(seats: Vec[i64]) -> i64 {
    let n = seats.len();
    let mut prev = -1;
    let mut next = 0;
    let mut best = 0;
    for i in 0..n {
        if seats[i] == 1 {
            prev = i;
        } else {
            while next < n and (seats[next] == 0 or next < i) {
                next += 1;
            }
            let ahead = if next < n { next - i } else { n };
            let behind = if prev >= 0 { i - prev } else { n };
            best = best.max(ahead.min(behind));
        }
    }
    best
}

// ---- the statement ----------------------------------------------------------

// The statement read literally: for every empty seat, the distance to
// the closest person is the least `|i - j|` over the taken seats `j`;
// Alex sits where that is largest.
fn statement(seats: Vec[i64]) -> i64 {
    let n = seats.len();
    let mut best = 0;
    for i in 0..n {
        if seats[i] == 0 {
            let mut closest = n;
            for j in 0..n {
                if seats[j] == 1 {
                    closest = closest.min((i - j).abs());
                }
            }
            best = best.max(closest);
        }
    }
    best
}

fn distance(arm: i64, seats: Vec[i64]) -> i64 {
    if arm == 0 {
        max_dist_to_closest_star(seats)
    } else if arm == 1 {
        max_dist_to_closest_sides(seats)
    } else if arm == 2 {
        max_dist_to_closest_runs(seats)
    } else {
        max_dist_to_closest_next(seats)
    }
}

// ---- harness ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "sides", "runs", "next"];
    let properties = ["answer", "reversed", "person added", "seat in front", "bounds"];
    let mut by_arm: Vec[i64] = Vec.filled(4, 0);
    let mut by_property: Vec[i64] = Vec.filled(5, 0);
    let mut failures = 0;
    let mut checks = 0;
    let mut total = 0;
    let mut seed = 849;
    for case in 0..1600 {
        let kind = case / 400;
        let n = 2 + next_random(mut seed) % 23;
        let mut seats: Vec[i64] = Vec.filled(n, 0);
        if kind == 0 {
            // few people
            for i in 0..n {
                if next_random(mut seed) % 6 == 0 {
                    seats[i] = 1;
                }
            }
        } else if kind == 1 {
            // many people
            for i in 0..n {
                if next_random(mut seed) % 3 > 0 {
                    seats[i] = 1;
                }
            }
        } else if kind == 2 {
            // one or two people anywhere, the ends included
            seats[next_random(mut seed) % n] = 1;
            if next_random(mut seed) % 2 == 0 {
                seats[next_random(mut seed) % n] = 1;
            }
        } else {
            // half and half
            for i in 0..n {
                seats[i] = next_random(mut seed) % 2;
            }
        }
        // at least one person and one empty seat
        let taken = next_random(mut seed) % n;
        let empty = (taken + 1 + next_random(mut seed) % (n - 1)) % n;
        seats[taken] = 1;
        seats[empty] = 0;
        let want = statement(seats);
        total += want;
        let mut reversed = seats.clone();
        reversed.reverse();
        let mut more = seats.clone();
        let mut free: Vec[i64] = Vec.new();
        for i in 0..n {
            if seats[i] == 0 {
                free.push(i);
            }
        }
        let fewer_free = free.len() > 1;
        if fewer_free {
            more[free[next_random(mut seed) % free.len()]] = 1;
        }
        let mut front: Vec[i64] = [0];
        front.extend(seats.clone());
        let mut lead = 0;
        while seats[lead] == 0 {
            lead += 1;
        }
        for arm in 0..4 {
            let got = distance(arm, seats);
            let front_want = if seats[0] == 1 { got } else { got.max(lead + 1) };
            let oks = [
                got == want,
                distance(arm, reversed) == got,
                not fewer_free or distance(arm, more) <= got,
                distance(arm, front) == front_want,
                got >= 1 and got <= n - 1,
            ];
            for q in 0..5 {
                checks += 1;
                if not oks[q] {
                    failures += 1;
                    by_arm[arm] += 1;
                    by_property[q] += 1;
                    if failures <= 5 {
                        println(f"FAIL {names[arm]} {properties[q]}: {seats} -> {got}, want {want}");
                    }
                }
            }
        }
    }
    println(f"1600 cases, distances sum to {total}, {checks} checks over 4 arms: {failures} failures");
    println(f"by arm: star {by_arm[0]}, sides {by_arm[1]}, runs {by_arm[2]}, next {by_arm[3]}");
    println(f"by property: answer {by_property[0]}, reversed {by_property[1]}, person added {by_property[2]}, seat in front {by_property[3]}, bounds {by_property[4]}");
}
