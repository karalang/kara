// LeetCode #848: differential -- the four arms against the statement.
//
// Copies of the four arms, held to five properties on random strings,
// against the statement read literally.

// ---- ★ arm ----------------------------------------------------------

fn shifting_letters_star(s: String, shifts: Vec[i64]) -> String {
    let mut bytes: Vec[u8] = s.bytes().to_vec();
    let mut shift = 0;
    for i in (0..bytes.len()).rev() {
        shift = (shift + shifts[i]) % 26;
        bytes[i] = b'a' + ((bytes[i] - b'a') as i64 + shift) as u8 % 26;
    }
    String.from_utf8(bytes).unwrap()
}

// ---- running-prefix arm ---------------------------------------------

fn shifting_letters_prefix(s: String, shifts: Vec[i64]) -> String {
    let mut left = 0;
    for x in shifts.iter() {
        left = (left + *x) % 26;
    }
    let mut out = String.new();
    let mut i = 0;
    for c in s.chars() {
        let code = (c as i64 - 'a' as i64 + left) % 26;
        out.push((b'a' + code as u8) as char);
        left = (left - shifts[i] % 26 + 26) % 26;
        i += 1;
    }
    out
}

// ---- iterator arm ---------------------------------------------------

fn shifting_letters_iter(s: String, shifts: Vec[i64]) -> String {
    let n = shifts.len();
    let mut suffix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        suffix[i] = (suffix[i + 1] + shifts[i]) % 26;
    }
    s.chars()
        .enumerate()
        .map(|(i, c)| (b'a' + ((c as i64 - 'a' as i64 + suffix[i]) % 26) as u8) as char)
        .collect()
}

// ---- whole-sums arm -------------------------------------------------

fn shifting_letters_wide(s: String, shifts: Vec[i64]) -> String {
    let letters: Vec[char] = s.chars().collect();
    let mut total = 0;
    let mut out: Vec[char] = Vec.new();
    for i in (0..letters.len()).rev() {
        total += shifts[i];
        let code = (letters[i] as i64 - 'a' as i64 + total % 26) % 26;
        out.push((b'a' + code as u8) as char);
    }
    out.reverse();
    let mut text = String.new();
    for c in out.iter() {
        text.push(*c);
    }
    text
}

// ---- the statement ----------------------------------------------------------

// The statement read literally: for each `i` in turn, shift each of the
// first `i + 1` letters `shifts[i]` times, one letter at a time, 'z'
// wrapping to 'a'. Twenty-six shifts bring a letter back to itself, so
// only `shifts[i] % 26` of them are made.
fn statement(s: String, shifts: Vec[i64]) -> String {
    let mut letters: Vec[char] = s.chars().collect();
    for i in 0..shifts.len() {
        for _ in 0..shifts[i] % 26 {
            for j in 0..i + 1 {
                letters[j] = if letters[j] == 'z' { 'a' } else { (letters[j] as u32 as u8 + 1) as char };
            }
        }
    }
    let mut out = String.new();
    for c in letters.iter() {
        out.push(*c);
    }
    out
}

fn shifted(arm: i64, s: String, shifts: Vec[i64]) -> String {
    if arm == 0 {
        shifting_letters_star(s, shifts)
    } else if arm == 1 {
        shifting_letters_prefix(s, shifts)
    } else if arm == 2 {
        shifting_letters_iter(s, shifts)
    } else {
        shifting_letters_wide(s, shifts)
    }
}

fn next_letter(c: char) -> char {
    if c == 'z' { 'a' } else { (c as u32 as u8 + 1) as char }
}

// ---- harness ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "prefix", "iter", "wide"];
    let properties = ["answer", "zero appended", "plus 26", "next letters", "suffix"];
    let mut by_arm: Vec[i64] = Vec.filled(4, 0);
    let mut by_property: Vec[i64] = Vec.filled(5, 0);
    let mut failures = 0;
    let mut checks = 0;
    let mut seed = 848;
    for case in 0..1600 {
        let kind = case / 400;
        let n = 1 + next_random(mut seed) % 30;
        let mut s = String.new();
        let mut shifts: Vec[i64] = Vec.new();
        for _ in 0..n {
            // few letters near the end of the alphabet, or any letters
            let letter = if kind % 2 == 0 { 23 + next_random(mut seed) % 3 } else { next_random(mut seed) % 26 };
            s.push((b'a' + letter as u8) as char);
            // shifts below 30, multiples of 26 and their neighbours, or
            // up to 10^9
            let shift = if kind < 2 {
                next_random(mut seed) % 30
            } else if kind == 2 {
                26 * (next_random(mut seed) % 4) + next_random(mut seed) % 3 - 1
            } else {
                next_random(mut seed) * 4657 % 1000000001
            };
            shifts.push(shift.max(0));
        }
        let want = statement(s, shifts);
        let extra = (b'a' + (next_random(mut seed) % 26) as u8) as char;
        let mut longer = s.clone();
        longer.push(extra);
        let mut longer_shifts = shifts.clone();
        longer_shifts.push(0);
        let plus: Vec[i64] = shifts.iter().map(|x| x + 26 * (1 + x % 3)).collect();
        let mut next_s = String.new();
        for c in s.chars() {
            next_s.push(next_letter(c));
        }
        let cut = next_random(mut seed) % n;
        let tail = s.substring(cut, n);
        let mut tail_shifts: Vec[i64] = Vec.new();
        for i in cut..n {
            tail_shifts.push(shifts[i]);
        }
        for arm in 0..4 {
            let got = shifted(arm, s, shifts);
            let mut next_got = String.new();
            for c in got.chars() {
                next_got.push(next_letter(c));
            }
            let mut with_extra = got.clone();
            with_extra.push(extra);
            let oks = [
                got == want,
                shifted(arm, longer, longer_shifts) == with_extra,
                shifted(arm, s, plus) == got,
                shifted(arm, next_s, shifts) == next_got,
                shifted(arm, tail, tail_shifts) == got.substring(cut, n),
            ];
            for q in 0..5 {
                checks += 1;
                if not oks[q] {
                    failures += 1;
                    by_arm[arm] += 1;
                    by_property[q] += 1;
                    if failures <= 5 {
                        println(f"FAIL {names[arm]} {properties[q]}: \"{s}\", {shifts} -> \"{got}\", want \"{want}\"");
                    }
                }
            }
        }
    }
    println(f"1600 cases, {checks} checks over 4 arms: {failures} failures");
    println(f"by arm: star {by_arm[0]}, prefix {by_arm[1]}, iter {by_arm[2]}, wide {by_arm[3]}");
    println(f"by property: answer {by_property[0]}, zero appended {by_property[1]}, plus 26 {by_property[2]}, next letters {by_property[3]}, suffix {by_property[4]}");
}
