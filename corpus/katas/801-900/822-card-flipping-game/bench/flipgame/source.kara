// Benchmark for #822: Card Flipping Game -- the ★ arm (a set of the doubles).
//
// A number on both sides of one card can never be good, and any other
// number on a card can, so the answer is the smallest number on any card
// that is not on both sides of one, or 0. O(n).

fn flipgame(fronts: Vec[i64], backs: Vec[i64]) -> i64 {
    let mut doubles: Set[i64] = Set.new();
    for i in 0..fronts.len() {
        if fronts[i] == backs[i] {
            doubles.insert(fronts[i]);
        }
    }
    let mut best = 0;
    for i in 0..fronts.len() {
        for x in [fronts[i], backs[i]] {
            if not doubles.contains(x) and (best == 0 or x < best) {
                best = x;
            }
        }
    }
    best
}

// ---- benchmark --------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 hands of 1,000 cards, LeetCode's largest, of numbers up to
    // 2,000, half of the cards with one number on both sides, drawn once.
    // Each round answers the next hand afresh.
    let count = 64;
    let rounds = 50000;
    let mut seed: i64 = 822;
    let mut all_fronts: Vec[Vec[i64]] = Vec.new();
    let mut all_backs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut fronts: Vec[i64] = Vec.new();
        let mut backs: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            let f = 1 + next_random(mut seed) % 2000;
            fronts.push(f);
            if next_random(mut seed) % 2 == 0 {
                backs.push(f);
            } else {
                backs.push(1 + next_random(mut seed) % 2000);
            }
        }
        all_fronts.push(fronts);
        all_backs.push(backs);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        let g = round % count;
        let answer = flipgame(all_fronts[g], all_backs[g]);
        total += answer;
        checksum = (checksum * 131 + answer) % 1000000007;
    }
    println(f"{rounds} rounds of {count} hands: total {total}, checksum {checksum}");
}
