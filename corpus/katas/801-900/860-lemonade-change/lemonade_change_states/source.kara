// LeetCode #860: Lemonade Change -- every reachable till.
//
// The till is the pair (fives, tens); twenties never pay change, so they
// are not counted. Instead of choosing how to pay a 20, keep every till
// the choices so far can reach: a 5 adds a five to each, a 10 trades a
// five for a ten in each that has a five, and a 20 takes a ten and a five
// or three fives from each that can. The queue is served exactly when
// some till survives to the end. The set holds at most one till per
// number of twenties paid with three fives, so O(n^2) time.

fn lemonade_change(bills: Vec[i64]) -> bool {
    let mut tills: Set[(i64, i64)] = Set.new();
    tills.insert((0, 0));
    for b in bills {
        let mut next: Set[(i64, i64)] = Set.new();
        for t in tills.iter() {
            let (f, n) = *t;
            if b == 5 {
                next.insert((f + 1, n));
            } else if b == 10 {
                if f > 0 {
                    next.insert((f - 1, n + 1));
                }
            } else {
                if f > 0 and n > 0 {
                    next.insert((f - 1, n - 1));
                }
                if f >= 3 {
                    next.insert((f - 3, n));
                }
            }
        }
        if next.is_empty() {
            return false;
        }
        tills = next;
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn show(bills: Vec[i64]) {
    println(f"{bills} -> {lemonade_change(bills)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a bill: 5 half the time, 10 three times in ten, 20 one time in five
fn random_bill(seed: mut ref i64) -> i64 {
    let r = next_random(mut seed) % 10;
    if r < 5 {
        5
    } else if r < 8 {
        10
    } else {
        20
    }
}

fn main() {
    show([5, 5, 5, 10, 20]);
    show([5, 5, 10, 10, 20]);
    show([5]);
    show([10]);
    show([20]);
    show([5, 10]);
    show([5, 20]);
    show([5, 5, 5, 20]);
    show([5, 5, 10, 20]);
    show([5, 5, 10, 20, 5, 5, 5, 20]);
    show([5, 5, 5, 10, 20, 20]);
    show([5, 5, 5, 5, 10, 20, 10, 20]);
    show([5, 10, 5, 20]);
    show([5, 5, 5, 5, 20, 20, 5, 10]);
    // every queue of one to seven bills
    let mut queues = 0;
    let mut served = 0;
    let mut total = 3;
    for n in 1..8 {
        for code in 0..total {
            let mut bills: Vec[i64] = Vec.new();
            let mut c = code;
            for _ in 0..n {
                bills.push(if c % 3 == 0 { 5 } else if c % 3 == 1 { 10 } else { 20 });
                c = c / 3;
            }
            queues += 1;
            if lemonade_change(bills) {
                served += 1;
            }
        }
        total = total * 3;
    }
    println(f"all {queues} queues of one to seven bills: {served} get their change");
    let mut seed = 860;
    let mut yes = 0;
    let mut check = 0;
    for r in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let mut bills: Vec[i64] = Vec.new();
        for _ in 0..n {
            bills.push(random_bill(mut seed));
        }
        let ok = lemonade_change(bills);
        if ok {
            yes += 1;
        }
        check = (check * 31 + if ok { r + 2 } else { 1 }) % 1000000007;
    }
    println(f"2000 random queues: {yes} get their change, checksum {check}");
}
