// LeetCode #860: Lemonade Change -- bench program, the ★ arm (count the
// fives and tens, pay a twenty with a ten when there is one).
//
// A queue of 100,000 bills, LeetCode's longest, built once so that every
// customer can be served; each of 1,000 rounds changes one bill, asks
// whether the queue is still served, and changes it back. A queue stops
// at its first customer without change, so a round reads the queue up to
// that customer, or to its end.

fn lemonade_change(bills: Slice[i64]) -> bool {
    let mut fives = 0;
    let mut tens = 0;
    for b in bills {
        if *b == 5 {
            fives += 1;
        } else if *b == 10 {
            if fives == 0 {
                return false;
            }
            fives -= 1;
            tens += 1;
        } else if tens > 0 and fives > 0 {
            tens -= 1;
            fives -= 1;
        } else if fives >= 3 {
            fives -= 3;
        } else {
            return false;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100000;
    let mut seed = 860;
    // a served queue: a ten only when there is a five to give, a twenty
    // only when there is change for it
    let mut bills: Vec[i64] = Vec.new();
    let mut fives = 0;
    let mut tens = 0;
    for _ in 0..n {
        let r = next_random(mut seed) % 10;
        if r >= 8 and tens > 0 and fives > 0 {
            bills.push(20);
            tens -= 1;
            fives -= 1;
        } else if r >= 8 and fives >= 3 {
            bills.push(20);
            fives -= 3;
        } else if r >= 5 and fives > 0 {
            bills.push(10);
            fives -= 1;
            tens += 1;
        } else {
            bills.push(5);
            fives += 1;
        }
    }
    let mut served = 0;
    let mut check = 0;
    for r in 0..1000 {
        let i = next_random(mut seed) % n;
        let old = bills[i];
        bills[i] = if old == 5 { 10 } else if old == 10 { 20 } else { 5 };
        let yes = lemonade_change(bills);
        bills[i] = old;
        if yes {
            served += 1;
        }
        check = (check * 31 + if yes { r + 2 } else { 1 }) % 1000000007;
    }
    println(f"1000 rounds on 100000 bills: {served} served, checksum {check}");
}
