// LeetCode #860: Lemonade Change -- differential test of the five arms
// against the statement read literally, with six properties.
//
// The statement: each customer's bill goes into the till, and the change,
// the bill less 5, must be made from some of the bills in the till. The
// literal reading keeps every bill taken, twenties included, and tries
// every way of making each change out of them.

// ---- the ★ arm: counts of fives and tens, a ten first for a twenty ---------

fn star_change(bills: Vec[i64]) -> bool {
    let mut fives = 0;
    let mut tens = 0;
    for b in bills {
        if b == 5 {
            fives += 1;
        } else if b == 10 {
            if fives == 0 {
                return false;
            }
            fives -= 1;
            tens += 1;
        } else if tens > 0 and fives > 0 {
            tens -= 1;
            fives -= 1;
        } else if fives >= 3 {
            fives -= 3;
        } else {
            return false;
        }
    }
    true
}

// ---- every reachable till --------------------------------------------------

fn states_change(bills: Vec[i64]) -> bool {
    let mut tills: Set[(i64, i64)] = Set.new();
    tills.insert((0, 0));
    for b in bills {
        let mut next: Set[(i64, i64)] = Set.new();
        for t in tills.iter() {
            let (f, n) = *t;
            if b == 5 {
                next.insert((f + 1, n));
            } else if b == 10 {
                if f > 0 {
                    next.insert((f - 1, n + 1));
                }
            } else {
                if f > 0 and n > 0 {
                    next.insert((f - 1, n - 1));
                }
                if f >= 3 {
                    next.insert((f - 3, n));
                }
            }
        }
        if next.is_empty() {
            return false;
        }
        tills = next;
    }
    true
}

// ---- a cashier counting change out of a drawer, largest first --------------

fn cashier_change(bills: Vec[i64]) -> bool {
    let denominations = [20, 10, 5];
    let mut drawer: SortedMap[i64, i64] = SortedMap.new();
    for d in denominations {
        drawer.insert(d, 0);
    }
    for b in bills {
        drawer[b] = drawer[b] + 1;
        let mut owed = b - 5;
        for d in denominations {
            let mut held = drawer[d];
            while owed >= d and held > 0 {
                owed -= d;
                held -= 1;
            }
            drawer[d] = held;
        }
        if owed > 0 {
            return false;
        }
    }
    true
}

// ---- both ways of paying every twenty --------------------------------------

fn brute_serve(bills: Slice[i64], i: i64, fives: i64, tens: i64) -> bool {
    if i == bills.len() {
        return true;
    }
    let b = bills[i];
    if b == 5 {
        return brute_serve(bills, i + 1, fives + 1, tens);
    }
    if b == 10 {
        return fives > 0 and brute_serve(bills, i + 1, fives - 1, tens + 1);
    }
    (fives > 0 and tens > 0 and brute_serve(bills, i + 1, fives - 1, tens - 1))
        or (fives >= 3 and brute_serve(bills, i + 1, fives - 3, tens))
}

fn brute_change(bills: Vec[i64]) -> bool {
    brute_serve(bills, 0, 0, 0)
}

// ---- `all` over the queue, the till in the closure -------------------------

fn all_change(bills: Vec[i64]) -> bool {
    let mut fives = 0;
    let mut tens = 0;
    bills.iter().all(|b| match b {
        5 => {
            fives += 1;
            true
        }
        10 => {
            if fives == 0 {
                return false;
            }
            fives -= 1;
            tens += 1;
            true
        }
        _ => {
            if tens > 0 and fives > 0 {
                tens -= 1;
                fives -= 1;
                true
            } else if fives >= 3 {
                fives -= 3;
                true
            } else {
                false
            }
        }
    })
}

// ---- the statement read literally ------------------------------------------

// whether the customers from `i` on can all be served from a till holding
// `held[k]` bills of `denominations[k]`, trying every way to make each
// change out of the bills held
fn literal_serve(bills: Slice[i64], i: i64, held: mut ref Vec[i64]) -> bool {
    if i == bills.len() {
        return true;
    }
    let denominations = [5, 10, 20];
    let b = bills[i];
    let k = if b == 5 { 0 } else if b == 10 { 1 } else { 2 };
    held[k] += 1;
    let owed = b - 5;
    let mut served = false;
    for a in 0..held[0] + 1 {
        for c in 0..held[1] + 1 {
            for e in 0..held[2] + 1 {
                if not served and a * denominations[0] + c * denominations[1] + e * denominations[2] == owed {
                    held[0] -= a;
                    held[1] -= c;
                    held[2] -= e;
                    served = literal_serve(bills, i + 1, mut held);
                    held[0] += a;
                    held[1] += c;
                    held[2] += e;
                }
            }
        }
    }
    held[k] -= 1;
    served
}

fn literal_change(bills: Vec[i64]) -> bool {
    let mut held: Vec[i64] = [0, 0, 0];
    literal_serve(bills, 0, mut held)
}

// ---- the properties --------------------------------------------------------

fn arms(bills: Vec[i64]) -> Vec[bool] {
    [star_change(bills), states_change(bills), cashier_change(bills), brute_change(bills), all_change(bills)]
}

// checks made, and failures by property (index 0 holds P1)
struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn expect(t: mut ref Tally, p: i64, bills: Vec[i64], want: bool) {
    let got = arms(bills);
    for k in 0..got.len() {
        t.checks += 1;
        if got[k] != want {
            t.failures[p - 1] += 1;
        }
    }
}

fn with_front(x: i64, bills: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = [x];
    for b in bills {
        out.push(*b);
    }
    out
}

fn properties(t: mut ref Tally, bills: Vec[i64]) -> bool {
    let want = literal_change(bills);
    // P1: the statement's answer
    expect(mut t, 1, bills, want);
    // P2: a five handed over first never turns a served queue away
    if want {
        expect(mut t, 2, with_front(5, bills), true);
    }
    // P3: every prefix of a served queue is served
    if want {
        for n in 1..bills.len() {
            let mut prefix: Vec[i64] = Vec.new();
            for i in 0..n {
                prefix.push(bills[i]);
            }
            expect(mut t, 3, prefix, true);
        }
    }
    // P4: a queue that does not start with a five is turned away
    if bills[0] != 5 {
        expect(mut t, 4, bills, false);
    }
    // P5: a five moved one place earlier never turns a served queue away
    if want {
        for i in 0..bills.len() - 1 {
            if bills[i] != 5 and bills[i + 1] == 5 {
                let mut moved = bills.clone();
                moved.swap(i, i + 1);
                expect(mut t, 5, moved, true);
            }
        }
    }
    // P6: a five handed over last changes nothing
    let mut longer = bills.clone();
    longer.push(5);
    expect(mut t, 6, longer, want);
    want
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut queues = 0;
    let mut served = 0;
    // every queue of one to six bills
    let mut total = 3;
    for n in 1..7 {
        for code in 0..total {
            let mut bills: Vec[i64] = Vec.new();
            let mut c = code;
            for _ in 0..n {
                bills.push(if c % 3 == 0 { 5 } else if c % 3 == 1 { 10 } else { 20 });
                c = c / 3;
            }
            queues += 1;
            if properties(mut t, bills) {
                served += 1;
            }
        }
        total = total * 3;
    }
    // random queues of up to 14 bills, mostly fives, so that most are served
    let mut seed = 860;
    for _ in 0..1408 {
        let n = 1 + next_random(mut seed) % 14;
        let mut bills: Vec[i64] = Vec.new();
        for _ in 0..n {
            let r = next_random(mut seed) % 10;
            bills.push(if r < 6 { 5 } else if r < 9 { 10 } else { 20 });
        }
        queues += 1;
        if properties(mut t, bills) {
            served += 1;
        }
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{queues} queues, {served} served, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
