// LeetCode 803 — Bricks Falling When Hit: the bench.
//
// 8 walls of 200 by 200 cells, LeetCode's largest, are made once, three
// cells in four a brick and the loose bricks taken away, each with
// 20,000 of its cells, bricks and empty alike, to hit in a random order.
// Each of 500 rounds counts the falls for the next wall with the ★ arm.
fn hit_bricks(grid: Vec[Vec[i64]], hits: Vec[(i64, i64)]) -> Vec[i64] {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut left = grid.clone();
    for k in 0..hits.len() {
        let (r, c) = hits[k];
        left[r][c] = 0;
    }
    let roof = rows * cols;
    let mut parent: Vec[i64] = Vec.new();
    let mut size: Vec[i64] = Vec.new();
    for i in 0..roof + 1 {
        parent.push(i);
        size.push(1);
    }
    for r in 0..rows {
        for c in 0..cols {
            if left[r][c] == 1 {
                join(r, c, rows, cols, left, mut parent, mut size);
            }
        }
    }
    let mut fallen: Vec[i64] = Vec.new();
    for _ in 0..hits.len() {
        fallen.push(0);
    }
    let mut k = hits.len() - 1;
    while k >= 0 {
        let (r, c) = hits[k];
        if grid[r][c] == 1 {
            let before = size[find(mut parent, roof)];
            left[r][c] = 1;
            join(r, c, rows, cols, left, mut parent, mut size);
            let after = size[find(mut parent, roof)];
            fallen[k] = (after - before - 1).max(0);
        }
        k -= 1;
    }
    fallen
}

// Join the brick at (r, c) to the roof if it is in the top row, and to
// each brick next to it.
fn join(r: i64, c: i64, rows: i64, cols: i64, left: Vec[Vec[i64]], parent: mut ref Vec[i64], size: mut ref Vec[i64]) {
    let here = r * cols + c;
    if r == 0 {
        union(mut parent, mut size, here, rows * cols);
    }
    let dr = [-1, 1, 0, 0];
    let dc = [0, 0, -1, 1];
    for d in 0..4 {
        let nr = r + dr[d];
        let nc = c + dc[d];
        if nr >= 0 and nr < rows and nc >= 0 and nc < cols and left[nr][nc] == 1 {
            union(mut parent, mut size, here, nr * cols + nc);
        }
    }
}

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn union(parent: mut ref Vec[i64], size: mut ref Vec[i64], a: i64, b: i64) {
    let ra = find(mut parent, a);
    let rb = find(mut parent, b);
    if ra == rb {
        return;
    }
    if size[ra] < size[rb] {
        parent[ra] = rb;
        size[rb] += size[ra];
    } else {
        parent[rb] = ra;
        size[ra] += size[rb];
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}
fn settled(grid: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut out: Vec[Vec[i64]] = Vec.new();
    for _ in 0..rows {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..cols {
            row.push(0);
        }
        out.push(row);
    }
    let mut stack: Vec[(i64, i64)] = Vec.new();
    for c in 0..cols {
        if grid[0][c] == 1 {
            out[0][c] = 1;
            stack.push((0, c));
        }
    }
    let dr = [-1, 1, 0, 0];
    let dc = [0, 0, -1, 1];
    while let Some((r, c)) = stack.pop() {
        for d in 0..4 {
            let nr = r + dr[d];
            let nc = c + dc[d];
            if nr >= 0 and nr < rows and nc >= 0 and nc < cols and grid[nr][nc] == 1 and out[nr][nc] == 0 {
                out[nr][nc] = 1;
                stack.push((nr, nc));
            }
        }
    }
    out
}

fn main() {
    let size = 200;
    let mut seed = 803;
    let mut walls: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut all_hits: Vec[Vec[(i64, i64)]] = Vec.new();
    for _ in 0..8 {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..size {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..size {
                row.push(if next_random(mut seed) % 4 < 3 { 1 } else { 0 });
            }
            grid.push(row);
        }
        walls.push(settled(grid));
        let mut cells: Vec[i64] = Vec.new();
        for j in 0..size * size {
            cells.push(j);
        }
        for j in 1..size * size {
            let t = next_random(mut seed) % (j + 1);
            let x = cells[j];
            cells[j] = cells[t];
            cells[t] = x;
        }
        let mut hits: Vec[(i64, i64)] = Vec.new();
        for j in 0..20000 {
            hits.push((cells[j] / size, cells[j] % size));
        }
        all_hits.push(hits);
    }
    let rounds = 500;
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        let fallen = hit_bricks(walls[r % 8], all_hits[r % 8]);
        let mut sum = 0;
        for f in fallen.iter() {
            sum += f;
        }
        total += sum;
        check = (check * 131 + sum + fallen[r % 20000]) % 1000000007;
    }
    println(f"{rounds} rounds of 20000 hits: {total} bricks fell, checksum {check}");
}
