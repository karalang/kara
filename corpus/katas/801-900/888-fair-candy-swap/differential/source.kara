// LeetCode #888: Fair Candy Swap -- differential test of the five arms
// against the statement read literally, with six properties.
//
// The statement: Alice and Bob have candy boxes of different totals,
// aliceSizes[i] candies in Alice's box i and bobSizes[j] in Bob's box j.
// They swap one box each so that afterwards both have the same total.
// Return [x, y], the candies in the box Alice gives and the box Bob
// gives; any such swap is accepted, and at least one exists. The arms
// return the one in which Alice gives her smallest box.

// ---- the ★ arm: a set of Bob's boxes --------------------------------------
fn star_fair_candy_swap(alice_sizes: Vec[i64], bob_sizes: Vec[i64]) -> Vec[i64] {
    let mut alice_total = 0;
    for i in 0..alice_sizes.len() {
        alice_total += alice_sizes[i];
    }
    let mut bob_total = 0;
    let mut bob: Set[i64] = Set.new();
    for j in 0..bob_sizes.len() {
        bob_total += bob_sizes[j];
        bob.insert(bob_sizes[j]);
    }
    let d = (bob_total - alice_total) / 2;
    let mut best = -1;
    for i in 0..alice_sizes.len() {
        let x = alice_sizes[i];
        if bob.contains(x + d) and (best < 0 or x < best) {
            best = x;
        }
    }
    [best, best + d]
}

// ---- the sorted arm: two pointers over the sorted boxes -------------------
fn sorted_fair_candy_swap(alice_sizes: Vec[i64], bob_sizes: Vec[i64]) -> Vec[i64] {
    let mut alice = alice_sizes.clone();
    let mut bob = bob_sizes.clone();
    alice.sort();
    bob.sort();
    let mut d = 0;
    for j in 0..bob.len() {
        d += bob[j];
    }
    for i in 0..alice.len() {
        d -= alice[i];
    }
    d = d / 2;
    let mut i = 0;
    let mut j = 0;
    while i < alice.len() and j < bob.len() {
        let gap = bob[j] - alice[i];
        if gap == d {
            return [alice[i], bob[j]];
        }
        if gap < d {
            j += 1;
        } else {
            i += 1;
        }
    }
    [-1, -1]
}

// ---- the search arm: a binary search in Bob's sorted boxes ----------------
fn search_fair_candy_swap(alice_sizes: Vec[i64], bob_sizes: Vec[i64]) -> Vec[i64] {
    let mut alice = alice_sizes.clone();
    let mut bob = bob_sizes.clone();
    alice.sort();
    bob.sort();
    let mut d = 0;
    for j in 0..bob.len() {
        d += bob[j];
    }
    for i in 0..alice.len() {
        d -= alice[i];
    }
    d = d / 2;
    for i in 0..alice.len() {
        let want = alice[i] + d;
        let mut lo = 0;
        let mut hi = bob.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if bob[mid] < want {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo < bob.len() and bob[lo] == want {
            return [alice[i], want];
        }
    }
    [-1, -1]
}

// ---- the counting arm: a table of the box sizes ---------------------------
fn counting_fair_candy_swap(alice_sizes: Vec[i64], bob_sizes: Vec[i64]) -> Vec[i64] {
    let mut most = 0;
    for i in 0..alice_sizes.len() {
        most = most.max(alice_sizes[i]);
    }
    for j in 0..bob_sizes.len() {
        most = most.max(bob_sizes[j]);
    }
    let mut alice: Vec[bool] = Vec.filled(most + 1, false);
    let mut bob: Vec[bool] = Vec.filled(most + 1, false);
    let mut d = 0;
    for i in 0..alice_sizes.len() {
        alice[alice_sizes[i]] = true;
        d -= alice_sizes[i];
    }
    for j in 0..bob_sizes.len() {
        bob[bob_sizes[j]] = true;
        d += bob_sizes[j];
    }
    d = d / 2;
    for x in 1..most + 1 {
        let y = x + d;
        if alice[x] and y >= 1 and y <= most and bob[y] {
            return [x, y];
        }
    }
    [-1, -1]
}

// ---- the ordered arm: ordered sets of the boxes ---------------------------
fn ordered_fair_candy_swap(alice_sizes: Vec[i64], bob_sizes: Vec[i64]) -> Vec[i64] {
    let mut alice: SortedSet[i64] = SortedSet.new();
    let mut bob: SortedSet[i64] = SortedSet.new();
    let mut d = 0;
    for i in 0..alice_sizes.len() {
        alice.insert(alice_sizes[i]);
        d -= alice_sizes[i];
    }
    for j in 0..bob_sizes.len() {
        bob.insert(bob_sizes[j]);
        d += bob_sizes[j];
    }
    d = d / 2;
    for size in alice.iter() {
        let x = *size;
        if bob.contains(x + d) {
            return [x, x + d];
        }
    }
    [-1, -1]
}

fn arm(x: i64, alice_sizes: Vec[i64], bob_sizes: Vec[i64]) -> Vec[i64] {
    match x {
        0 => star_fair_candy_swap(alice_sizes, bob_sizes),
        1 => sorted_fair_candy_swap(alice_sizes, bob_sizes),
        2 => search_fair_candy_swap(alice_sizes, bob_sizes),
        3 => counting_fair_candy_swap(alice_sizes, bob_sizes),
        _ => ordered_fair_candy_swap(alice_sizes, bob_sizes),
    }
}

// ---- the statement read literally -----------------------------------------

// every box of Alice's swapped with every box of Bob's in turn, the
// totals after the swap compared, and of the swaps that even them the one
// giving away Alice's smallest box
fn literal(alice_sizes: Vec[i64], bob_sizes: Vec[i64]) -> Vec[i64] {
    let mut alice_total = 0;
    for i in 0..alice_sizes.len() {
        alice_total += alice_sizes[i];
    }
    let mut bob_total = 0;
    for j in 0..bob_sizes.len() {
        bob_total += bob_sizes[j];
    }
    let mut best: Vec[i64] = [-1, -1];
    for i in 0..alice_sizes.len() {
        for j in 0..bob_sizes.len() {
            let x = alice_sizes[i];
            let y = bob_sizes[j];
            if alice_total - x + y == bob_total - y + x and (best[0] < 0 or x < best[0]) {
                best = [x, y];
            }
        }
    }
    best
}

// ---- properties -----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn below(seed: mut ref i64, limit: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % limit
}

// as in the arms' harness: Alice's n boxes and Bob's m, of 1 to `most`
// candies, with a swap that evens the totals
fn case_boxes(seed: mut ref i64, n: i64, m_drawn: i64, most: i64) -> Vec[Vec[i64]] {
    let m = if n + m_drawn < 3 { 2 } else { m_drawn };
    loop {
        let mut alice: Vec[i64] = Vec.new();
        let mut alice_total = 0;
        for _ in 0..n {
            let x = 1 + below(mut seed, most);
            alice.push(x);
            alice_total += x;
        }
        let mut bob: Vec[i64] = Vec.new();
        for _ in 0..m {
            bob.push(1 + below(mut seed, most));
        }
        let i = below(mut seed, n);
        let j = below(mut seed, m);
        let y = 1 + below(mut seed, most);
        bob[j] = y;
        let mut bob_total = 0;
        for k in 0..m {
            bob_total += bob[k];
        }
        let mut short = alice_total + 2 * (y - alice[i]) - bob_total;
        for k in 0..m {
            if k != j and short != 0 {
                let step = short.max(1 - bob[k]).min(most - bob[k]);
                bob[k] += step;
                short -= step;
            }
        }
        for k in 0..n {
            if k != i and short != 0 {
                let step = (0 - short).max(1 - alice[k]).min(most - alice[k]);
                alice[k] += step;
                short += step;
            }
        }
        if short == 0 and y != alice[i] {
            return [alice, bob];
        }
    }
}

fn total(boxes: Vec[i64]) -> i64 {
    let mut sum = 0;
    for i in 0..boxes.len() {
        sum += boxes[i];
    }
    sum
}

// x one of Alice's boxes, y one of Bob's, and the swap evening the totals
fn evens(alice_sizes: Vec[i64], bob_sizes: Vec[i64], swap: Vec[i64]) -> bool {
    swap.len() == 2 and alice_sizes.contains(swap[0]) and bob_sizes.contains(swap[1])
        and total(alice_sizes) - swap[0] + swap[1] == total(bob_sizes) - swap[1] + swap[0]
}

fn shuffled(seed: mut ref i64, boxes: Vec[i64]) -> Vec[i64] {
    let mut out = boxes.clone();
    for i in 0..out.len() {
        let j = i + next_random(mut seed) % (out.len() - i);
        out.swap(i, j);
    }
    out
}

fn mapped(boxes: Vec[i64], times: i64, plus: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..boxes.len() {
        out.push(boxes[i] * times + plus);
    }
    out
}

// the sizes of Alice's boxes that some swap gives away
fn swap_sizes(alice: Vec[i64], bob: Vec[i64]) -> i64 {
    let d = (total(bob) - total(alice)) / 2;
    let mut bob_set: Set[i64] = Set.new();
    for j in 0..bob.len() {
        bob_set.insert(bob[j]);
    }
    let mut sizes: Set[i64] = Set.new();
    for i in 0..alice.len() {
        if bob_set.contains(alice[i] + d) {
            sizes.insert(alice[i]);
        }
    }
    sizes.len()
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

// P1 to P6 for one pair of lists over the five arms (P1 only when
// `small`). Returns the ★ arm's swap.
fn properties(t: mut ref Tally, seed: mut ref i64, alice: Vec[i64], bob: Vec[i64], small: bool) -> Vec[i64] {
    let want = if small { literal(alice, bob) } else { [0, 0] };
    let d = (total(bob) - total(alice)) / 2;
    let mut bob_set: Set[i64] = Set.new();
    for j in 0..bob.len() {
        bob_set.insert(bob[j]);
    }
    let alice_moved = shuffled(mut seed, alice);
    let bob_moved = shuffled(mut seed, bob);
    let mut answers: Vec[Vec[i64]] = Vec.new();
    for x in 0..5 {
        answers.push(arm(x, alice, bob));
    }
    for x in 0..5 {
        let got = answers[x].clone();
        // P1: the statement's swap
        if small {
            check(mut t, 1, got == want);
        }
        // P2: a box of each, the swap evening the totals; and the same
        // with Alice and Bob exchanged
        check(mut t, 2, evens(alice, bob, got) and evens(bob, alice, arm(x, bob, alice)));
        // P3: the same lists in another order
        check(mut t, 3, arm(x, alice_moved, bob_moved) == got);
        // P4: none of Alice's smaller boxes would do
        let mut smallest = true;
        for i in 0..alice.len() {
            if alice[i] < got[0] and bob_set.contains(alice[i] + d) {
                smallest = false;
            }
        }
        check(mut t, 4, smallest);
        // P5: every box doubled doubles the swap, and with as many boxes
        // each, every box a candy more adds a candy to each side of it
        let doubled = arm(x, mapped(alice, 2, 0), mapped(bob, 2, 0)) == [got[0] * 2, got[1] * 2];
        let raised = alice.len() != bob.len() or arm(x, mapped(alice, 1, 1), mapped(bob, 1, 1)) == [got[0] + 1, got[1] + 1];
        check(mut t, 5, doubled and raised);
        // P6: the arm agrees with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and answers[y] == got {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    answers[0].clone()
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut cases = 0;
    let mut gives = 0;
    let mut takes = 0;
    let mut several = 0;
    let mut seed = 888;
    // up to 6 boxes of up to 12 candies against the statement; then up
    // to 2,000 boxes of up to 10^5 candies, as many each a third of the
    // time
    for c in 0..3040 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 6 } else { 1 + below(mut seed, 2000) };
        let mut m = if small { 1 + next_random(mut seed) % 6 } else { 1 + below(mut seed, 2000) };
        if next_random(mut seed) % 3 == 0 {
            m = n;
        }
        let boxes = if small { case_boxes(mut seed, n, m, 12) } else { case_boxes(mut seed, n, m, 100000) };
        cases += 1;
        if swap_sizes(boxes[0], boxes[1]) > 1 {
            several += 1;
        }
        let swap = properties(mut t, mut seed, boxes[0], boxes[1], small);
        gives += swap[0];
        takes += swap[1];
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{cases} cases, {several} with a choice of swaps, Alice gives {gives} candies and Bob {takes}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
