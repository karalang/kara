// LeetCode #831: Masking Personal Information -- one scan per kind.
//
// An email is read letter by letter: before the `@` only the first and
// the last letter of the name are kept, lowered; from the `@` on every
// letter is copied, lowered. A phone number is read from its end: the
// first four digits met are the ones shown, and every digit counts
// towards the length that fixes the country code. O(n).

fn mask_pii(s: String) -> String {
    let b = s.bytes();
    let n = b.len();
    let mut out = String.new();
    if s.contains("@") {
        let mut first: u8 = 0;
        let mut last: u8 = 0;
        let mut domain = false;
        for i in 0..n {
            let c = if b[i] >= b'A' and b[i] <= b'Z' { b[i] + 32 } else { b[i] };
            if domain {
                out.push(c as char);
            } else if c == b'@' {
                out.push(first as char);
                out.push_str("*****");
                out.push(last as char);
                out.push('@');
                domain = true;
            } else {
                if first == 0 {
                    first = c;
                }
                last = c;
            }
        }
        return out;
    }
    let mut digits = 0;
    // the last four digits, met in reverse
    let mut shown: Vec[u8] = Vec.new();
    let mut i = n - 1;
    while i >= 0 {
        if b[i] >= b'0' and b[i] <= b'9' {
            if digits < 4 {
                shown.push(b[i]);
            }
            digits += 1;
        }
        i -= 1;
    }
    if digits > 10 {
        out.push('+');
        for _ in 0..digits - 10 {
            out.push('*');
        }
        out.push('-');
    }
    out.push_str("***-***-");
    for k in 0..4 {
        out.push(shown[3 - k] as char);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: String) {
    println(f"\"{s}\" -> \"{mask_pii(s.clone())}\"");
}

fn random_email(seed: mut ref i64) -> String {
    let mut s = String.new();
    for part in 0..3 {
        let len = 2 + next_random(mut seed) % 9;
        for _ in 0..len {
            let r = next_random(mut seed) % 52;
            s.push(if r < 26 { (b'a' + r as u8) as char } else { (b'A' + (r - 26) as u8) as char });
        }
        if part == 0 {
            s.push('@');
        } else if part == 1 {
            s.push('.');
        }
    }
    s
}

fn random_phone(seed: mut ref i64) -> String {
    let separators = ['+', '-', '(', ')', ' '];
    let digits = 10 + next_random(mut seed) % 4;
    let mut s = String.new();
    for _ in 0..digits {
        if next_random(mut seed) % 3 == 0 {
            s.push(separators[next_random(mut seed) % 5]);
        }
        s.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
    }
    s
}

fn main() {
    show("LeetCode@LeetCode.com");
    show("AB@qq.com");
    show("1(234)567-890");
    show("ab@b.c");
    show("ZzZ@QQ.COM");
    show("1234567890");
    show("+1 (234) 567-8901");
    show("+12 345 678 9012");
    show("+(123)-456-789-0123");
    let mut seed = 831;
    let mut total = 0;
    let mut check = 0;
    for i in 0..400 {
        let s = if i % 2 == 0 { random_email(mut seed) } else { random_phone(mut seed) };
        let m = mask_pii(s);
        total += m.len();
        for b in m.bytes() {
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"400 random strings: {total} characters, checksum {check}");
}
