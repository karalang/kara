// LeetCode #831: Masking Personal Information -- the ★ arm (by the rules).
//
// An email holds an `@`: its name and domain are lowered, and the name
// kept only by its first and last letter with five `*` between. Anything
// else is a phone number: its digits are kept, the last four shown, and
// the digits before the last ten, if any, are the country code, masked
// as one `*` each after a `+`. O(n) for a string of length n.

fn mask_pii(s: String) -> String {
    match s.find("@") {
        Some(at) => {
            let lower = s.to_lowercase();
            f"{lower[0..1]}*****{lower[at - 1..]}"
        }
        None => {
            let mut digits = String.new();
            for c in s.chars() {
                if c.is_ascii_digit() {
                    digits.push(c);
                }
            }
            let n = digits.len();
            let local = f"***-***-{digits[n - 4..]}";
            if n == 10 {
                local
            } else {
                f"+{"*".repeat(n - 10)}-{local}"
            }
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: String) {
    println(f"\"{s}\" -> \"{mask_pii(s.clone())}\"");
}

fn random_email(seed: mut ref i64) -> String {
    let mut s = String.new();
    for part in 0..3 {
        let len = 2 + next_random(mut seed) % 9;
        for _ in 0..len {
            let r = next_random(mut seed) % 52;
            s.push(if r < 26 { (b'a' + r as u8) as char } else { (b'A' + (r - 26) as u8) as char });
        }
        if part == 0 {
            s.push('@');
        } else if part == 1 {
            s.push('.');
        }
    }
    s
}

fn random_phone(seed: mut ref i64) -> String {
    let separators = ['+', '-', '(', ')', ' '];
    let digits = 10 + next_random(mut seed) % 4;
    let mut s = String.new();
    for _ in 0..digits {
        if next_random(mut seed) % 3 == 0 {
            s.push(separators[next_random(mut seed) % 5]);
        }
        s.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
    }
    s
}

fn main() {
    show("LeetCode@LeetCode.com");
    show("AB@qq.com");
    show("1(234)567-890");
    show("ab@b.c");
    show("ZzZ@QQ.COM");
    show("1234567890");
    show("+1 (234) 567-8901");
    show("+12 345 678 9012");
    show("+(123)-456-789-0123");
    let mut seed = 831;
    let mut total = 0;
    let mut check = 0;
    for i in 0..400 {
        let s = if i % 2 == 0 { random_email(mut seed) } else { random_phone(mut seed) };
        let m = mask_pii(s);
        total += m.len();
        for b in m.bytes() {
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"400 random strings: {total} characters, checksum {check}");
}
