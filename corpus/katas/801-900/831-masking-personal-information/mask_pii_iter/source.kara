// LeetCode #831: Masking Personal Information -- iterator chains.
//
// An email's name masked by `chars` read at its two ends, its domain the
// rest of the lowered string by `skip`; a phone number's digits a
// `filter` over its `chars`, `collect`ed, with the country code's mask a
// `map` over a range, also `collect`ed. O(n).

fn mask_pii(s: String) -> String {
    let lower = s.to_lowercase();
    match lower.find("@") {
        Some(at) => {
            let first = lower.chars().next().unwrap();
            let last = lower.chars().nth(at - 1).unwrap();
            let domain: String = lower.chars().skip(at).collect();
            f"{first}*****{last}{domain}"
        }
        None => {
            let digits: String = s.chars().filter(|c| c.is_ascii_digit()).collect();
            let n = digits.len();
            let code: String = (0..n - 10).map(|_| '*').collect();
            let local = f"***-***-{digits[n - 4..]}";
            if code.len() > 0 { f"+{code}-{local}" } else { local }
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: String) {
    println(f"\"{s}\" -> \"{mask_pii(s.clone())}\"");
}

fn random_email(seed: mut ref i64) -> String {
    let mut s = String.new();
    for part in 0..3 {
        let len = 2 + next_random(mut seed) % 9;
        for _ in 0..len {
            let r = next_random(mut seed) % 52;
            s.push(if r < 26 { (b'a' + r as u8) as char } else { (b'A' + (r - 26) as u8) as char });
        }
        if part == 0 {
            s.push('@');
        } else if part == 1 {
            s.push('.');
        }
    }
    s
}

fn random_phone(seed: mut ref i64) -> String {
    let separators = ['+', '-', '(', ')', ' '];
    let digits = 10 + next_random(mut seed) % 4;
    let mut s = String.new();
    for _ in 0..digits {
        if next_random(mut seed) % 3 == 0 {
            s.push(separators[next_random(mut seed) % 5]);
        }
        s.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
    }
    s
}

fn main() {
    show("LeetCode@LeetCode.com");
    show("AB@qq.com");
    show("1(234)567-890");
    show("ab@b.c");
    show("ZzZ@QQ.COM");
    show("1234567890");
    show("+1 (234) 567-8901");
    show("+12 345 678 9012");
    show("+(123)-456-789-0123");
    let mut seed = 831;
    let mut total = 0;
    let mut check = 0;
    for i in 0..400 {
        let s = if i % 2 == 0 { random_email(mut seed) } else { random_phone(mut seed) };
        let m = mask_pii(s);
        total += m.len();
        for b in m.bytes() {
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"400 random strings: {total} characters, checksum {check}");
}
