// LeetCode #856: Score of Parentheses -- each `()` worth two to its depth.
//
// Unfolding the rules, a string's score is a sum with one term for each
// `()` in it: the doubling of every group around it applies to it alone,
// so a `()` inside `d` groups is worth `2^d`. One pass keeps the depth
// and adds `1 << d` at every `)` that follows a `(`.

fn score_of_parentheses(s: String) -> i64 {
    let b = s.bytes();
    let mut depth = 0;
    let mut total = 0;
    for i in 0..b.len() {
        if b[i] == b'(' {
            depth += 1;
        } else {
            depth -= 1;
            if b[i - 1] == b'(' {
                total += 1 << depth;
            }
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn show(s: String) {
    println(f"\"{s}\" -> {score_of_parentheses(s)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random balanced string of `pairs` pairs: an open while any are left,
// one time in two, or always when nothing is open.
fn random_string(seed: mut ref i64, pairs: i64) -> String {
    let mut s = String.new();
    let mut opens = 0;
    let mut balance = 0;
    while s.len() < 2 * pairs {
        if opens < pairs and (balance == 0 or next_random(mut seed) % 2 == 0) {
            s.push('(');
            opens += 1;
            balance += 1;
        } else {
            s.push(')');
            balance -= 1;
        }
    }
    s
}

// Every balanced string of `pairs` pairs, in order with `(` before `)`.
fn all_strings(pairs: i64, prefix: own String, opens: i64, closes: i64, out: mut ref Vec[String]) {
    if closes == pairs {
        out.push(prefix);
        return;
    }
    if opens < pairs {
        all_strings(pairs, f"{prefix}(", opens + 1, closes, mut out);
    }
    if closes < opens {
        all_strings(pairs, f"{prefix})", opens, closes + 1, mut out);
    }
}

fn main() {
    show("()");
    show("(())");
    show("()()");
    show("(()(()))");
    show("((()))");
    show("(()())");
    show("()(())");
    show("((())())()");
    show("((((((((((((((((((((((((()))))))))))))))))))))))))");
    show("()()()()()()()()()()()()()()()()()()()()()()()()()");
    show("(((((((((((((((((((((((())))))))))))))))))))))))()");
    let mut every: Vec[String] = Vec.new();
    for pairs in 1..9 {
        all_strings(pairs, String.new(), 0, 0, mut every);
    }
    let mut every_total = 0;
    for s in every.iter() {
        every_total += score_of_parentheses(s);
    }
    println(f"all {every.len()} balanced strings of 1 to 8 pairs: scores sum to {every_total}");
    let mut seed = 856;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let s = random_string(mut seed, 1 + next_random(mut seed) % 25);
        let k = score_of_parentheses(s);
        total += k;
        check = (check * 31 + k) % 1000000007;
    }
    println(f"300 random strings of up to 25 pairs: scores sum to {total}, checksum {check}");
}
