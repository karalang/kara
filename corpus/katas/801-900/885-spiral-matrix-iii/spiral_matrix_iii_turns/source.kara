// LeetCode #885: Spiral Matrix III -- turning right whenever it can.
//
// A spiral is the walk that turns right whenever the position to its
// right is new, and goes straight on otherwise. Starting facing north, it
// turns east at once, so the first step goes east as the problem says.
// The walk is kept on a board marking every position visited, wide enough
// to hold the spiral until it has covered the grid: max(rows, cols) rings
// around the start, the start anywhere in the grid. O(max(rows, cols)^2).

fn spiral_matrix_iii(rows: i64, cols: i64, r_start: i64, c_start: i64) -> Vec[Vec[i64]] {
    let dr = [-1, 0, 1, 0];
    let dc = [0, 1, 0, -1];
    let reach = rows.max(cols) + 1;
    let side = 2 * reach + 1;
    let mut visited: Vec[bool] = Vec.filled(side * side, false);
    // the board's position (reach, reach) is the start
    let mut br = reach;
    let mut bc = reach;
    visited[br * side + bc] = true;
    let mut out: Vec[Vec[i64]] = [[r_start, c_start]];
    let mut d = 0;
    while out.len() < rows * cols {
        let right = (d + 1) % 4;
        if not visited[(br + dr[right]) * side + bc + dc[right]] {
            d = right;
        }
        br += dr[d];
        bc += dc[d];
        visited[br * side + bc] = true;
        let r = r_start + br - reach;
        let c = c_start + bc - reach;
        if r >= 0 and r < rows and c >= 0 and c < cols {
            out.push([r, c]);
        }
    }
    out
}

// ---- test harness ----------------------------------------------------------

fn fold(check: i64, cells: Vec[Vec[i64]]) -> i64 {
    let mut c = check;
    for i in 0..cells.len() {
        c = (c * 131 + cells[i][0] * 101 + cells[i][1] + 1) % 1000000007;
    }
    c
}

fn show(rows: i64, cols: i64, r_start: i64, c_start: i64) {
    let cells = spiral_matrix_iii(rows, cols, r_start, c_start);
    let mut shown = "[";
    if cells.len() <= 12 {
        for i in 0..cells.len() {
            if i > 0 {
                shown = shown + ", ";
            }
            shown = shown + f"[{cells[i][0]}, {cells[i][1]}]";
        }
        shown = shown + "]";
    } else {
        for i in 0..4 {
            shown = shown + f"[{cells[i][0]}, {cells[i][1]}], ";
        }
        let last = cells.len() - 1;
        shown = shown + f"... [{cells[last][0]}, {cells[last][1]}]] ({cells.len()} cells, checksum {fold(0, cells)})";
    }
    println(f"rows = {rows}, cols = {cols}, rStart = {r_start}, cStart = {c_start} -> {shown}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(1, 4, 0, 0);
    show(5, 6, 1, 4);
    show(1, 1, 0, 0);
    show(3, 3, 1, 1);
    show(2, 2, 1, 1);
    show(4, 1, 2, 0);
    show(1, 5, 0, 2);
    show(100, 100, 0, 0);
    show(100, 100, 99, 99);
    show(100, 1, 37, 0);
    // small cases
    let mut seed = 885;
    let mut cells = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let out = spiral_matrix_iii(rows, cols, next_random(mut seed) % rows, next_random(mut seed) % cols);
        cells += out.len();
        check = fold(check, out);
    }
    println(f"2000 grids of up to 8 x 8: {cells} cells, checksum {check}");
    // LeetCode's sizes: up to 100 x 100
    cells = 0;
    check = 0;
    for _ in 0..100 {
        let rows = next_random(mut seed) % 100 + 1;
        let cols = next_random(mut seed) % 100 + 1;
        let out = spiral_matrix_iii(rows, cols, next_random(mut seed) % rows, next_random(mut seed) % cols);
        cells += out.len();
        check = fold(check, out);
    }
    println(f"100 grids of up to 100 x 100: {cells} cells, checksum {check}");
}
