// LeetCode #885: Spiral Matrix III -- legs clipped to the grid.
//
// The spiral's legs run east 1, south 1, west 2, north 2, east 3, and on.
// A leg lies in one row or one column, so its part inside the grid is a
// single run, found from the leg's ends without walking it: a leg in a
// row outside the grid adds nothing, and one in a row inside adds the
// columns it covers that the grid has. O(rows * cols + max(rows, cols)).

fn spiral_matrix_iii(rows: i64, cols: i64, r_start: i64, c_start: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = [[r_start, c_start]];
    let mut r = r_start;
    let mut c = c_start;
    let mut length = 1;
    while out.len() < rows * cols {
        // east, along row r from c + 1 to c + length
        if r >= 0 and r < rows {
            for x in (c + 1).max(0)..(c + length + 1).min(cols) {
                out.push([r, x]);
            }
        }
        c += length;
        // south, down column c from r + 1 to r + length
        if c >= 0 and c < cols {
            for y in (r + 1).max(0)..(r + length + 1).min(rows) {
                out.push([y, c]);
            }
        }
        r += length;
        length += 1;
        // west, along row r from c - 1 to c - length
        if r >= 0 and r < rows {
            let mut x = (c - 1).min(cols - 1);
            while x >= (c - length).max(0) {
                out.push([r, x]);
                x -= 1;
            }
        }
        c -= length;
        // north, up column c from r - 1 to r - length
        if c >= 0 and c < cols {
            let mut y = (r - 1).min(rows - 1);
            while y >= (r - length).max(0) {
                out.push([y, c]);
                y -= 1;
            }
        }
        r -= length;
        length += 1;
    }
    out
}

// ---- test harness ----------------------------------------------------------

fn fold(check: i64, cells: Vec[Vec[i64]]) -> i64 {
    let mut c = check;
    for i in 0..cells.len() {
        c = (c * 131 + cells[i][0] * 101 + cells[i][1] + 1) % 1000000007;
    }
    c
}

fn show(rows: i64, cols: i64, r_start: i64, c_start: i64) {
    let cells = spiral_matrix_iii(rows, cols, r_start, c_start);
    let mut shown = "[";
    if cells.len() <= 12 {
        for i in 0..cells.len() {
            if i > 0 {
                shown = shown + ", ";
            }
            shown = shown + f"[{cells[i][0]}, {cells[i][1]}]";
        }
        shown = shown + "]";
    } else {
        for i in 0..4 {
            shown = shown + f"[{cells[i][0]}, {cells[i][1]}], ";
        }
        let last = cells.len() - 1;
        shown = shown + f"... [{cells[last][0]}, {cells[last][1]}]] ({cells.len()} cells, checksum {fold(0, cells)})";
    }
    println(f"rows = {rows}, cols = {cols}, rStart = {r_start}, cStart = {c_start} -> {shown}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(1, 4, 0, 0);
    show(5, 6, 1, 4);
    show(1, 1, 0, 0);
    show(3, 3, 1, 1);
    show(2, 2, 1, 1);
    show(4, 1, 2, 0);
    show(1, 5, 0, 2);
    show(100, 100, 0, 0);
    show(100, 100, 99, 99);
    show(100, 1, 37, 0);
    // small cases
    let mut seed = 885;
    let mut cells = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let out = spiral_matrix_iii(rows, cols, next_random(mut seed) % rows, next_random(mut seed) % cols);
        cells += out.len();
        check = fold(check, out);
    }
    println(f"2000 grids of up to 8 x 8: {cells} cells, checksum {check}");
    // LeetCode's sizes: up to 100 x 100
    cells = 0;
    check = 0;
    for _ in 0..100 {
        let rows = next_random(mut seed) % 100 + 1;
        let cols = next_random(mut seed) % 100 + 1;
        let out = spiral_matrix_iii(rows, cols, next_random(mut seed) % rows, next_random(mut seed) % cols);
        cells += out.len();
        check = fold(check, out);
    }
    println(f"100 grids of up to 100 x 100: {cells} cells, checksum {check}");
}
