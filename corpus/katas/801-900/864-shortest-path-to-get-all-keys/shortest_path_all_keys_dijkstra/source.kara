// LeetCode #864: Shortest Path to Get All Keys -- Dijkstra over
// (point, keys held), the points being the start and the keys.
//
// A shortest walk goes from the start to its first key, then to its
// next, and so on. From a point holding some keys, a breadth-first search
// over the cells that stops at every key not yet held (a walk that
// reaches one picks it up) gives the steps to each key that can come
// next. Those are the edges of a graph over (point, keys held) states, at
// most (k + 1) * 2^k of them, and Dijkstra's algorithm with a
// `PriorityQueue` finds the nearest state holding every key.
// O(2^k * k * rows * cols) for the searches.

fn shortest_path_all_keys(grid: Vec[String]) -> i64 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut cells: Vec[u8] = Vec.new();
    for row in grid.iter() {
        cells.extend(row.bytes().to_vec());
    }
    let size = cells.len();
    // point 0 is the start, point 1 + i key i
    let mut at: Vec[i64] = Vec.filled(7, -1);
    let mut keys = 0;
    for i in 0..size {
        if cells[i] == b'@' {
            at[0] = i;
        } else if cells[i] >= b'a' and cells[i] <= b'f' {
            at[1 + (cells[i] - b'a') as i64] = i;
            keys += 1;
        }
    }
    let all = (1 << keys) - 1;
    let mut best: Vec[i64] = Vec.filled((keys + 1) << keys, -1);
    let mut queue: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    best[0] = 0;
    queue.push((0, 0, 0));
    while let Some((d, point, held)) = queue.pop() {
        if held == all {
            return d;
        }
        if d > best[held * (keys + 1) + point] {
            continue;
        }
        // breadth-first search from the point, stopping at new keys
        let mut dist: Vec[i64] = Vec.filled(size, -1);
        let mut cells_queue: VecDeque[i64] = VecDeque.new();
        dist[at[point]] = 0;
        cells_queue.push_back(at[point]);
        while let Some(cell) = cells_queue.pop_front() {
            let r = cell / cols;
            let c = cell % cols;
            for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
                let nr = r + dr;
                let nc = c + dc;
                if nr < 0 or nr >= rows or nc < 0 or nc >= cols {
                    continue;
                }
                let next = nr * cols + nc;
                let b = cells[next];
                if dist[next] >= 0 or b == b'#' {
                    continue;
                }
                if b >= b'A' and b <= b'F' and (held & (1 << (b - b'A') as i64)) == 0 {
                    continue;
                }
                dist[next] = dist[cell] + 1;
                if b >= b'a' and b <= b'f' and (held & (1 << (b - b'a') as i64)) == 0 {
                    let key = (b - b'a') as i64;
                    let now = held | (1 << key);
                    let state = now * (keys + 1) + 1 + key;
                    let total = d + dist[next];
                    if best[state] < 0 or total < best[state] {
                        best[state] = total;
                        queue.push((total, 1 + key, now));
                    }
                } else {
                    cells_queue.push_back(next);
                }
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn show(grid: Vec[String]) {
    println(f"{grid.join(" / ")} -> {shortest_path_all_keys(grid)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random grid: each cell a wall with chance `walls` in 100, then the
// start, the `keys` keys and their locks on distinct random cells.
fn random_grid(seed: mut ref i64, rows: i64, cols: i64, keys: i64, walls: i64) -> Vec[String] {
    let size = rows * cols;
    let mut cells: Vec[u8] = Vec.new();
    let mut order: Vec[i64] = Vec.new();
    for i in 0..size {
        if next_random(mut seed) % 100 < walls {
            cells.push(b'#');
        } else {
            cells.push(b'.');
        }
        order.push(i);
    }
    for i in 1..size {
        let j = next_random(mut seed) % (i + 1);
        order.swap(i, j);
    }
    cells[order[0]] = b'@';
    for i in 0..keys {
        cells[order[1 + i]] = b'a' + i as u8;
        cells[order[1 + keys + i]] = b'A' + i as u8;
    }
    let mut grid: Vec[String] = Vec.new();
    for r in 0..rows {
        let mut row = String.new();
        for c in 0..cols {
            row.push(cells[r * cols + c] as char);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    show(["@.a..", "###.#", "b.A.B"]);
    show(["@..aA", "..B#.", "....b"]);
    show(["@Aa"]);
    show(["@aA"]);
    show(["Aa@"]);
    show(["@#a", "A.."]);
    show(["a.@.b", "#####", "A...B"]);
    show(["@.....", "#####.", "a.A..b", "######", "B....."]);
    show(["b.@.a", ".###.", "..A..", ".#B#."]);
    show(["@abcdef", "ABCDEF."]);
    show(["fedcba@", "FEDCBA#"]);
    show(["@.#ab", ".#.##", "...BA"]);
    // LeetCode's largest grids, 30 by 30, with six keys
    let mut seed = 864;
    for walls in [0, 20, 30, 40] {
        let grid = random_grid(mut seed, 30, 30, 6, walls);
        println(f"30 by 30, walls {walls} in 100, six keys: {shortest_path_all_keys(grid)}");
    }
    // random grids of up to 8 by 8 with one to six keys
    let mut reached = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let rows = 1 + next_random(mut seed) % 8;
        let cols = 1 + next_random(mut seed) % 8;
        let most = (rows * cols - 1) / 2;
        if most == 0 {
            continue;
        }
        let keys = 1 + next_random(mut seed) % most.min(6);
        let walls = next_random(mut seed) % 40;
        let moves = shortest_path_all_keys(random_grid(mut seed, rows, cols, keys, walls));
        if moves >= 0 {
            reached += 1;
            total += moves;
        }
        check = (check * 31 + moves + 2) % 1000000007;
    }
    println(f"1000 random grids: {reached} with every key reached, moves sum to {total}, checksum {check}");
}
