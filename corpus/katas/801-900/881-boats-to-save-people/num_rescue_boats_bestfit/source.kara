// LeetCode #881: Boats to Save People -- the heaviest partner that fits.
//
// With the people sorted, the heaviest one left takes a boat with the
// heaviest other person it can carry, found by a binary search for the
// last weight that fits and then a union-find step to the nearest person
// at or below it not yet in a boat: `free[i + 1]` points left past the
// people who have gone, so `free[0]` means nobody. O(n log n).

fn num_rescue_boats(people: Vec[i64], limit: i64) -> i64 {
    let mut weights = people.clone();
    weights.sort();
    let n = weights.len();
    let mut free: Vec[i64] = Vec.new();
    for i in 0..n + 1 {
        free.push(i);
    }
    let mut boats = 0;
    let mut heavy = find(mut free, n);
    while heavy > 0 {
        // the person at weights[heavy - 1] takes a boat
        free[heavy] = heavy - 1;
        boats += 1;
        // the last of the people below heavy - 1 who fit beside them
        let room = limit - weights[heavy - 1];
        let mut lo = 0;
        let mut hi = heavy - 1;
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if weights[mid] <= room {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let partner = find(mut free, lo);
        if partner > 0 {
            free[partner] = partner - 1;
        }
        heavy = find(mut free, heavy - 1);
    }
    boats
}

// the nearest person at or below position i - 1 still waiting, as a
// position plus one, with path halving; 0 when there is none
fn find(free: mut ref Vec[i64], i: i64) -> i64 {
    let mut x = i;
    while free[x] != x {
        free[x] = free[free[x]];
        x = free[x];
    }
    x
}

// ---- test harness ----------------------------------------------------------

fn text(values: Vec[i64]) -> String {
    if values.len() > 6 {
        return f"[{values[0]}, {values[1]}, ... ({values.len()} people)]";
    }
    let mut out = "[";
    for i in 0..values.len() {
        if i > 0 {
            out = out + ", ";
        }
        out = out + f"{values[i]}";
    }
    out + "]"
}

fn show(people: Vec[i64], limit: i64) {
    println(f"people = {text(people)}, limit = {limit} -> {num_rescue_boats(people, limit)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show([1, 2], 3);
    show([3, 2, 2, 1], 3);
    show([3, 5, 3, 4], 5);
    show([7], 7);
    show([5, 5, 5, 5, 5], 10);
    show([1, 9, 2, 8, 3, 7, 4, 6, 5], 10);
    show([6, 6, 6, 6], 11);
    let mut halves: Vec[i64] = Vec.new();
    let mut fulls: Vec[i64] = Vec.new();
    let mut ramp: Vec[i64] = Vec.new();
    for i in 0..50000 {
        halves.push(15000);
        fulls.push(30000);
        ramp.push(i % 30000 + 1);
    }
    show(halves, 30000);
    show(fulls, 30000);
    show(ramp, 30000);
    // small cases
    let mut seed = 881;
    let mut total = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        let limit = next_random(mut seed) % 20 + 1;
        let mut people: Vec[i64] = Vec.new();
        for _ in 0..n {
            people.push(next_random(mut seed) % limit + 1);
        }
        total += num_rescue_boats(people, limit);
    }
    println(f"3000 cases of 1 to 12 people: {total} boats");
    // LeetCode's sizes: up to 50000 people, limit up to 30000
    total = 0;
    let mut check = 0;
    for _ in 0..10 {
        let n = 40000 + next_random(mut seed) % 10001;
        let limit = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 30000;
        let mut people: Vec[i64] = Vec.new();
        for _ in 0..n {
            people.push((next_random(mut seed) * 32768 + next_random(mut seed)) % limit + 1);
        }
        let boats = num_rescue_boats(people, limit);
        total += boats;
        check = (check * 131 + boats) % 1000000007;
    }
    println(f"10 cases of up to 50000 people: {total} boats, checksum {check}");
}
