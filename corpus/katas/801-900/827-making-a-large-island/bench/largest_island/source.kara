// Benchmark for #827: Making A Large Island -- the ★ arm (label, then try each 0).
//
// A breadth-first search gives every island a label and records its
// size, and each 0 adds 1 to the sizes of the distinct labels around it.

fn largest_island(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    // label[r][c]: 0 for water, k + 1 for the k-th island
    let mut label: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        label.push(Vec.filled(n, 0));
    }
    let mut size: Vec[i64] = Vec.new();
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    let dr = [-1, 1, 0, 0];
    let dc = [0, 0, -1, 1];
    for r in 0..n {
        for c in 0..n {
            if grid[r][c] == 1 and label[r][c] == 0 {
                let id = size.len() + 1;
                label[r][c] = id;
                queue.push_back((r, c));
                let mut count = 0;
                while let Some((cr, cc)) = queue.pop_front() {
                    count += 1;
                    for k in 0..4 {
                        let nr = cr + dr[k];
                        let nc = cc + dc[k];
                        if nr >= 0 and nr < n and nc >= 0 and nc < n and grid[nr][nc] == 1 and label[nr][nc] == 0 {
                            label[nr][nc] = id;
                            queue.push_back((nr, nc));
                        }
                    }
                }
                size.push(count);
            }
        }
    }
    let mut best = 0;
    for s in size.iter() {
        best = best.max(s);
    }
    for r in 0..n {
        for c in 0..n {
            if grid[r][c] == 0 {
                let mut seen: Vec[i64] = Vec.new();
                let mut made = 1;
                for k in 0..4 {
                    let nr = r + dr[k];
                    let nc = c + dc[k];
                    if nr >= 0 and nr < n and nc >= 0 and nc < n {
                        let id = label[nr][nc];
                        if id > 0 and not seen.contains(id) {
                            seen.push(id);
                            made += size[id - 1];
                        }
                    }
                }
                best = best.max(made);
            }
        }
    }
    best
}

// ---- benchmark --------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 16 grids of 500 by 500, LeetCode's largest, 55% land at random,
    // just below the density where one island spans the grid, drawn once.
    // Each round answers the next one.
    let count = 16;
    let rounds = 200;
    let n = 500;
    let mut seed: i64 = 827;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(if next_random(mut seed) % 100 < 55 { 1 } else { 0 });
            }
            grid.push(row);
        }
        grids.push(grid);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        let r = largest_island(grids[round % count]);
        total += r;
        checksum = (checksum * 131 + r) % 1000000007;
    }
    println(f"{rounds} rounds of {count} grids: total {total}, checksum {checksum}");
}
