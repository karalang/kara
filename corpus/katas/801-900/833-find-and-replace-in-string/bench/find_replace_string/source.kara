// Benchmark for #833: Find And Replace in String -- the ★ arm (a table by index).
//
// Each operation whose source occurs at its index is recorded in a table
// at that index, and one walk over the string writes each recorded
// operation's target in place of its source and copies the other letters.
fn find_replace_string(s: String, indices: Vec[i64], sources: Vec[String], targets: Vec[String]) -> String {
    let n = s.len();
    let mut at = Vec.filled(n, -1);
    for k in 0..indices.len() {
        let i = indices[k];
        if s[i..].starts_with(sources[k]) {
            at[i] = k;
        }
    }
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        let k = at[i];
        if k >= 0 {
            out.push_str(targets[k]);
            i += sources[k].len();
        } else {
            out.push_str(s[i..i + 1]);
            i += 1;
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letter(r: i64) -> char {
    (b'a' + r as u8) as char
}

fn main() {
    // 64 cases drawn once, each a string of LeetCode's largest length,
    // 1000, of the letters a and b, and LeetCode's largest number of
    // operations, 100, on disjoint stretches of 1 to 10 letters with 0 to
    // 3 letters between them, in a shuffled order. Two in three sources
    // are their stretch and match; the third has its last letter changed.
    // Each target is 1 to 7 letters. Each round runs the next case and
    // reads one letter of the answer.
    let count = 64;
    let rounds = 300000;
    let n = 1000;
    let mut seed: i64 = 833;
    let mut strings: Vec[String] = Vec.new();
    let mut all_indices: Vec[Vec[i64]] = Vec.new();
    let mut all_sources: Vec[Vec[String]] = Vec.new();
    let mut all_targets: Vec[Vec[String]] = Vec.new();
    for _ in 0..count {
        let mut s = String.new();
        for _ in 0..n {
            s.push(letter(next_random(mut seed) % 2));
        }
        let mut indices: Vec[i64] = Vec.new();
        let mut sources: Vec[String] = Vec.new();
        let mut targets: Vec[String] = Vec.new();
        let mut pos = next_random(mut seed) % 4;
        while pos < n and indices.len() < 100 {
            let room = if n - pos < 10 { n - pos } else { 10 };
            let len = 1 + next_random(mut seed) % room;
            let mut src = s[pos..pos + len].to_string();
            if next_random(mut seed) % 3 == 2 {
                let last = src.bytes()[len - 1] as i64 - 97;
                let mut changed = src[0..len - 1].to_string();
                changed.push(letter((last + 1) % 26));
                src = changed;
            }
            let mut target = String.new();
            for _ in 0..1 + next_random(mut seed) % 7 {
                target.push(letter(next_random(mut seed) % 26));
            }
            indices.push(pos);
            sources.push(src);
            targets.push(target);
            pos += len + next_random(mut seed) % 4;
        }
        let mut i = indices.len();
        while i > 1 {
            let j = next_random(mut seed) % i;
            i -= 1;
            indices.swap(i, j);
            sources.swap(i, j);
            targets.swap(i, j);
        }
        strings.push(s);
        all_indices.push(indices);
        all_sources.push(sources);
        all_targets.push(targets);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        let g = round % count;
        let out = find_replace_string(strings[g], all_indices[g], all_sources[g], all_targets[g]);
        total += out.len();
        checksum = (checksum * 131 + out.bytes()[round / count % out.len()] as i64) % 1000000007;
    }
    println(f"{rounds} rounds of {count} cases: {total} letters, checksum {checksum}");
}
