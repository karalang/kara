// Benchmark for #854: K-Similar Strings -- the ★ arm (breadth-first search
// over swaps that fix a letter).
//
// Some shortest sequence of swaps fixes the first misplaced position
// first, and does it with a swap that also leaves the swapped-in letter
// somewhere it was not wanted: swapping in a letter that was already
// right only moves the problem. So from each string only those swaps are
// tried, and a breadth-first search over the strings they reach finds
// the fewest swaps.

fn k_similarity(s1: String, s2: String) -> i64 {
    let goal = s2.bytes();
    let n = goal.len();
    let mut seen: Set[String] = Set.new();
    let mut level: Vec[Vec[u8]] = [s1.bytes().to_vec()];
    seen.insert(s1.clone());
    let mut swaps = 0;
    loop {
        let mut next: Vec[Vec[u8]] = Vec.new();
        for cur in level.iter() {
            let mut i = 0;
            while i < n and cur[i] == goal[i] {
                i += 1;
            }
            if i == n {
                return swaps;
            }
            for j in i + 1..n {
                if cur[j] == goal[i] and cur[j] != goal[j] {
                    let mut moved = cur.clone();
                    moved.swap(i, j);
                    let key = String.from_utf8(moved.clone()).unwrap();
                    if not seen.contains(key) {
                        seen.insert(key);
                        next.push(moved);
                    }
                }
            }
        }
        level = next;
        swaps += 1;
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 pairs drawn once, each of LeetCode's longest strings, 20
    // letters: pair `g` draws its first string from the first `2 + g % 5`
    // letters of `a..f` and its second is a random rearrangement of the
    // first. Each round asks the next pair.
    let count = 64;
    let rounds = 6400;
    let n = 20;
    let mut seed: i64 = 854;
    let mut firsts: Vec[String] = Vec.new();
    let mut seconds: Vec[String] = Vec.new();
    for g in 0..count {
        let letters = 2 + g % 5;
        let mut a: Vec[u8] = Vec.new();
        for _ in 0..n {
            a.push(b'a' + (next_random(mut seed) % letters) as u8);
        }
        let mut b = a.clone();
        for i in (1..n).rev() {
            b.swap(i, next_random(mut seed) % (i + 1));
        }
        firsts.push(String.from_utf8(a).unwrap());
        seconds.push(String.from_utf8(b).unwrap());
    }
    let mut total = 0;
    let mut checksum = 0;
    for round in 0..rounds {
        let g = round % count;
        let k = k_similarity(firsts[g], seconds[g]);
        total += k;
        checksum = (checksum * 31 + k) % 1000000007;
    }
    println(f"{rounds} rounds of {count} pairs: swaps sum to {total}, checksum {checksum}");
}
