// LeetCode #854: K-Similar Strings -- the ★ arm (breadth-first search over
// swaps that fix a letter).
//
// Some shortest sequence of swaps fixes the first misplaced position
// first, and does it with a swap that also leaves the swapped-in letter
// somewhere it was not wanted: swapping in a letter that was already
// right only moves the problem. So from each string only those swaps are
// tried, and a breadth-first search over the strings they reach finds
// the fewest swaps.

fn k_similarity(s1: String, s2: String) -> i64 {
    let goal = s2.bytes();
    let n = goal.len();
    let mut seen: Set[String] = Set.new();
    let mut level: Vec[Vec[u8]] = [s1.bytes().to_vec()];
    seen.insert(s1.clone());
    let mut swaps = 0;
    loop {
        let mut next: Vec[Vec[u8]] = Vec.new();
        for cur in level.iter() {
            let mut i = 0;
            while i < n and cur[i] == goal[i] {
                i += 1;
            }
            if i == n {
                return swaps;
            }
            for j in i + 1..n {
                if cur[j] == goal[i] and cur[j] != goal[j] {
                    let mut moved = cur.clone();
                    moved.swap(i, j);
                    let key = String.from_utf8(moved.clone()).unwrap();
                    if not seen.contains(key) {
                        seen.insert(key);
                        next.push(moved);
                    }
                }
            }
        }
        level = next;
        swaps += 1;
    }
}

// ---- test harness ---------------------------------------------------------

fn show(s1: String, s2: String) {
    println(f"\"{s1}\", \"{s2}\" -> {k_similarity(s1, s2)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random string of `n` letters from the first `letters` of `a..f`, and
// a random rearrangement of it.
fn random_pair(seed: mut ref i64, n: i64, letters: i64) -> (String, String) {
    let mut a: Vec[u8] = Vec.new();
    for _ in 0..n {
        a.push(b'a' + (next_random(mut seed) % letters) as u8);
    }
    let mut b = a.clone();
    for i in (1..n).rev() {
        b.swap(i, next_random(mut seed) % (i + 1));
    }
    (String.from_utf8(a).unwrap(), String.from_utf8(b).unwrap())
}

fn main() {
    show("ab", "ba");
    show("abc", "bca");
    show("a", "a");
    show("abcdef", "abcdef");
    show("abcdef", "fabcde");
    show("aaabbb", "bbbaaa");
    show("abab", "baba");
    show("abcabc", "cbacba");
    show("abccaacceecdeea", "bcaacceeccdeaae");
    show("abcdefabcdefabcdefab", "badcfebadcfebadcfeba");
    show("abcdefabcdefabcdefab", "bcdefabcdefabcdefaba");
    let mut seed = 854;
    let mut long_total = 0;
    for _ in 0..12 {
        let (a, b) = random_pair(mut seed, 20, 6);
        long_total += k_similarity(a, b);
    }
    println(f"12 random pairs of 20 letters: swaps sum to {long_total}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 12;
        let (a, b) = random_pair(mut seed, n, 1 + next_random(mut seed) % 6);
        let k = k_similarity(a, b);
        total += k;
        check = (check * 31 + k) % 1000000007;
    }
    println(f"300 random pairs: swaps sum to {total}, checksum {check}");
}
