// LeetCode #896: Monotonic Array -- the first change sets the direction.
//
// Equal neighbours say nothing. The first pair that differs fixes the
// direction, and every later pair that differs must go the same way.
// O(n), stopping at the first step against the direction.

fn is_monotonic(nums: Vec[i64]) -> bool {
    let mut direction = 0;
    for i in 1..nums.len() {
        let step = nums[i] - nums[i - 1];
        if step != 0 {
            if direction == 0 {
                direction = if step > 0 { 1 } else { -1 };
            } else if (step > 0) != (direction > 0) {
                return false;
            }
        }
    }
    true
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"nums = {nums} -> {is_monotonic(nums)}");
}

// `len` random numbers spread over `span` values centred on 0, sorted up
// for kind 1, 3 and 5 and down for kind 2 and 4; kinds 3 and 4 then swap
// two random places, and kind 5 sets one random place to a random number
fn random_case(seed: mut ref i64, kind: i64, len: i64, span: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..len {
        let r = next_random(mut seed) * 32768 + next_random(mut seed);
        nums.push(r % span - span / 2);
    }
    if kind >= 1 {
        nums.sort();
    }
    if kind == 2 or kind == 4 {
        nums.reverse();
    }
    if kind == 3 or kind == 4 {
        let i = next_random(mut seed) % len;
        let j = next_random(mut seed) % len;
        nums.swap(i, j);
    }
    if kind == 5 {
        let i = next_random(mut seed) % len;
        let r = next_random(mut seed) * 32768 + next_random(mut seed);
        nums[i] = r % span - span / 2;
    }
    nums
}

fn main() {
    show([1, 2, 2, 3]);
    show([6, 5, 4, 4]);
    show([1, 3, 2]);
    show([5]);
    show([2, 2, 2]);
    show([3, 3, 1, 1, 2]);
    show([-100000, 100000]);
    show([1, 2, 1, 2]);
    // random cases of up to 1000 numbers, a third of them up to 5, half
    // of them from at most 3 values, the rest from LeetCode's whole range
    let mut seed = 896;
    let mut monotonic = 0;
    let mut check = 0;
    for c in 0..300 {
        let kind = next_random(mut seed) % 6;
        let len = if c % 3 == 0 { 1 + next_random(mut seed) % 5 } else { 1 + next_random(mut seed) % 1000 };
        let span = if c % 2 == 0 { 1 + next_random(mut seed) % 3 } else { 200001 };
        let nums = random_case(mut seed, kind, len, span);
        let got = is_monotonic(nums);
        if got {
            monotonic += 1;
        }
        check = (check * 131 + len * 2 + if got { 1 } else { 0 }) % 1000000007;
    }
    println(f"300 cases of up to 1000 numbers: {monotonic} monotonic, checksum {check}");
    // LeetCode's largest: 100000 numbers sorted up, down, and each with
    // two places swapped
    let mut big: Vec[bool] = Vec.new();
    for kind in 1..5 {
        big.push(is_monotonic(random_case(mut seed, kind, 100000, 200001)));
    }
    println(f"4 cases of 100000 numbers: {big}");
}
