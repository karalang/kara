// LeetCode #880 bench: the ★ arm (the tape's length, then back from the
// end) on 1,000,000 queries over 1,000 encoded strings of LeetCode's sizes.

fn is_digit(b: u8) -> bool {
    let d0: u8 = b'0';
    let d9: u8 = b'9';
    b >= d0 and b <= d9
}

fn decode_at_index(s: String, k: i64) -> String {
    let bytes = s.bytes();
    let d0: u8 = b'0';
    let mut size = 0;
    for i in 0..bytes.len() {
        if is_digit(bytes[i]) {
            size *= (bytes[i] - d0) as i64;
        } else {
            size += 1;
        }
    }
    let mut k = k;
    let mut i = bytes.len() - 1;
    loop {
        k %= size;
        if k == 0 and not is_digit(bytes[i]) {
            return s[i..i + 1].to_string();
        }
        if is_digit(bytes[i]) {
            size /= (bytes[i] - d0) as i64;
        } else {
            size -= 1;
        }
        i -= 1;
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a value from 1 to limit (up to 10^9)
fn up_to(seed: mut ref i64, limit: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % limit + 1
}

// an encoded string of up to `length` characters starting with a letter,
// whose decoded length stays at most 10^18; returns the string and its
// decoded length
fn encoded(seed: mut ref i64, length: i64) -> (String, i64) {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let digits = "0123456789";
    let bound = 1000000000000000000;
    let mut s = String.new();
    let mut size = 0;
    for i in 0..length {
        let d = next_random(mut seed) % 8 + 2;
        if i > 0 and next_random(mut seed) % 3 == 0 and size * d <= bound {
            s.push_str(digits[d..d + 1]);
            size *= d;
        } else if size < bound {
            let x = next_random(mut seed) % 26;
            s.push_str(letters[x..x + 1]);
            size += 1;
        }
    }
    (s, size)
}

fn main() {
    let mut seed = 880;
    let mut strings: Vec[String] = Vec.new();
    let mut sizes: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        let length = next_random(mut seed) % 99 + 2;
        let (s, size) = encoded(mut seed, length);
        strings.push(s);
        sizes.push(size);
    }
    let mut total = 0;
    let mut check = 0;
    for q in 0..1000000 {
        let j = q % 1000;
        let k = up_to(mut seed, sizes[j].min(1000000000));
        let answer = decode_at_index(strings[j], k).bytes()[0] as i64;
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"1000000 queries over 1000 strings: letters sum to {total}, checksum {check}");
}
