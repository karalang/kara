// LeetCode #828: differential -- the four arms against the statement.
//
// Copies of the four arms, held to four properties on random strings,
// against the statement read substring by substring.

// ---- ★ arm ----------------------------------------------------------

fn unique_letter_string_star(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    // the last and the one before last position of each letter, -1 if none
    let mut last: Vec[i64] = Vec.filled(26, -1);
    let mut before: Vec[i64] = Vec.filled(26, -1);
    let mut total = 0;
    for i in 0..n {
        let c = (b[i] - b'A') as i64;
        if last[c] >= 0 {
            total += (last[c] - before[c]) * (i - last[c]);
        }
        before[c] = last[c];
        last[c] = i;
    }
    for c in 0..26 {
        if last[c] >= 0 {
            total += (last[c] - before[c]) * (n - last[c]);
        }
    }
    total
}

// ---- ending-at arm --------------------------------------------------

fn unique_letter_string_dp(s: String) -> i64 {
    let b = s.bytes();
    let mut last: Vec[i64] = Vec.filled(26, -1);
    let mut before: Vec[i64] = Vec.filled(26, -1);
    let mut ending = 0;
    let mut total = 0;
    for i in 0..b.len() {
        let c = (b[i] - b'A') as i64;
        ending += (i - last[c]) - (last[c] - before[c]);
        total += ending;
        before[c] = last[c];
        last[c] = i;
    }
    total
}

// ---- positions arm --------------------------------------------------

fn unique_letter_string_positions(s: String) -> i64 {
    let n = s.len();
    let mut at: Vec[Vec[i64]] = Vec.new();
    for _ in 0..26 {
        at.push([-1]);
    }
    let mut i = 0;
    for b in s.bytes() {
        at[(b - b'A') as i64].push(i);
        i += 1;
    }
    let mut total = 0;
    for c in 0..26 {
        at[c].push(n);
        for k in 1..at[c].len() - 1 {
            total += (at[c][k] - at[c][k - 1]) * (at[c][k + 1] - at[c][k]);
        }
    }
    total
}

// ---- iterator arm ---------------------------------------------------

fn unique_letter_string_iter(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    (0..26).map(|c| {
        let at: Vec[i64] = [-1].iter().cloned().chain((0..n).filter(|i| (b[i] - b'A') as i64 == c)).chain([n].iter().cloned()).collect();
        at.windows(3).iter().map(|w| (w[1] - w[0]) * (w[2] - w[1])).sum()
    }).sum()
}

// ---- the statement ----------------------------------------------------------

// The statement read literally: every substring, and in it the letters
// seen exactly once, the counts kept as the substring grows to the right.
fn statement(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut total = 0;
    for i in 0..n {
        let mut count: Vec[i64] = Vec.filled(26, 0);
        let mut once = 0;
        for j in i..n {
            let c = (b[j] - b'A') as i64;
            count[c] += 1;
            if count[c] == 1 {
                once += 1;
            } else if count[c] == 2 {
                once -= 1;
            }
            total += once;
        }
    }
    total
}

// the letters seen exactly once in each suffix, summed
fn suffix_unique(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut total = 0;
    for i in 0..n {
        let mut count: Vec[i64] = Vec.filled(26, 0);
        for j in i..n {
            count[(b[j] - b'A') as i64] += 1;
        }
        for c in 0..26 {
            if count[c] == 1 {
                total += 1;
            }
        }
    }
    total
}

// ---- harness ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, s: String) -> i64 {
    if arm == 0 {
        unique_letter_string_star(s)
    } else if arm == 1 {
        unique_letter_string_dp(s)
    } else if arm == 2 {
        unique_letter_string_positions(s)
    } else {
        unique_letter_string_iter(s)
    }
}

fn reversed(s: String) -> String {
    let b = s.bytes();
    let mut r = String.new();
    let mut i = b.len() - 1;
    while i >= 0 {
        r.push(b[i] as char);
        i -= 1;
    }
    r
}

fn renamed(s: String, k: i64) -> String {
    let mut r = String.new();
    for b in s.bytes() {
        r.push((b'A' + (((b - b'A') as i64 + k) % 26) as u8) as char);
    }
    r
}

fn main() {
    let names = ["star", "dp", "positions", "iter"];
    let properties = ["answer", "reversed", "renamed", "a new letter appended"];
    let mut by_arm: Vec[i64] = Vec.filled(4, 0);
    let mut by_property: Vec[i64] = Vec.filled(4, 0);
    let mut failures = 0;
    let mut checks = 0;
    let mut seed = 828;
    for case in 0..1600 {
        let kind = case / 400;
        let n = 1 + next_random(mut seed) % 20;
        let mut s = String.new();
        if kind == 0 {
            // few letters, so that most recur
            let letters = 1 + next_random(mut seed) % 3;
            for _ in 0..n {
                s.push((b'A' + (next_random(mut seed) % letters) as u8) as char);
            }
        } else if kind == 1 {
            // up to all 26, so that most do not
            let letters = 1 + next_random(mut seed) % 26;
            for _ in 0..n {
                s.push((b'A' + (next_random(mut seed) % letters) as u8) as char);
            }
        } else if kind == 2 {
            // runs of one letter
            while s.len() < n {
                let c = (b'A' + (next_random(mut seed) % 5) as u8) as char;
                let run = 1 + next_random(mut seed) % 4;
                for _ in 0..run {
                    if s.len() < n {
                        s.push(c);
                    }
                }
            }
        } else {
            // a short block repeated
            let mut block = String.new();
            for _ in 0..1 + next_random(mut seed) % 4 {
                block.push((b'A' + (next_random(mut seed) % 4) as u8) as char);
            }
            while s.len() < n {
                s.push_str(block.as_str());
            }
        }
        let want = statement(s.clone());
        let k = 1 + next_random(mut seed) % 25;
        // a letter the string does not hold
        let mut fresh = 0;
        while s.contains(((b'A' + fresh as u8) as char).to_string().as_str()) {
            fresh += 1;
        }
        let mut longer = s.clone();
        longer.push((b'A' + fresh as u8) as char);
        let added = (s.len() + 1) + suffix_unique(s.clone());
        for arm in 0..4 {
            let got = answer(arm, s.clone());
            let oks = [
                got == want,
                answer(arm, reversed(s.clone())) == got,
                answer(arm, renamed(s.clone(), k)) == got,
                answer(arm, longer.clone()) == got + added,
            ];
            for p in 0..4 {
                checks += 1;
                if not oks[p] {
                    failures += 1;
                    by_arm[arm] += 1;
                    by_property[p] += 1;
                    if failures <= 5 {
                        println(f"FAIL {names[arm]} {properties[p]}: \"{s}\" -> {got}, want {want}");
                    }
                }
            }
        }
    }
    println(f"1600 cases, {checks} checks over 4 arms: {failures} failures");
    println(f"by arm: star {by_arm[0]}, dp {by_arm[1]}, positions {by_arm[2]}, iter {by_arm[3]}");
    println(f"by property: answer {by_property[0]}, reversed {by_property[1]}, renamed {by_property[2]}, a new letter appended {by_property[3]}");
}
