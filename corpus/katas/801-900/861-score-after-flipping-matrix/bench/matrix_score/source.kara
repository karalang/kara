// LeetCode #861: Score After Flipping Matrix -- bench program, the ★ arm
// (count each column against the first).
//
// A random 20 by 20 grid, LeetCode's largest, built once; each of
// 1,000,000 rounds flips one cell, scores the grid, and flips the cell
// back. Every round reads all 400 cells.

fn matrix_score(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut score = 0;
    for j in 0..n {
        let mut ones = 0;
        for row in grid.iter() {
            if row[j] == row[0] {
                ones += 1;
            }
        }
        score = score * 2 + ones.max(m - ones);
    }
    score
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let size = 20;
    let rounds = 1000000;
    let mut seed = 861;
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..size {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..size {
            row.push(next_random(mut seed) % 2);
        }
        grid.push(row);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        let cell = next_random(mut seed) % (size * size);
        let i = cell / size;
        let j = cell % size;
        grid[i][j] = 1 - grid[i][j];
        let s = matrix_score(grid);
        grid[i][j] = 1 - grid[i][j];
        total += s;
        check = (check * 31 + s) % 1000000007;
    }
    println(f"{rounds} rounds on a {size} by {size} grid: scores sum to {total}, checksum {check}");
}
