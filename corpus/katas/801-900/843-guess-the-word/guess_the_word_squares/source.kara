// LeetCode #843: Guess the Word -- the fewest words left on average.
//
// If the secret is any possible word with equal chance, a guess whose
// answer splits the possible words into groups of sizes g0, g1, ...
// leaves g0 words with chance g0 / n, g1 with chance g1 / n, and so on,
// so on average (g0^2 + g1^2 + ...) / n. Each turn guesses the possible
// word with the smallest sum of squares, the first of them on a tie, a
// full match counting as a group of one. The answer keeps the possible
// words that share exactly that many places with the guess. O(n^2) for
// each guess, the shared places counted afresh each time.

fn places(a: String, b: String) -> i64 {
    let x: Vec[char] = a.chars().collect();
    let y: Vec[char] = b.chars().collect();
    let mut count = 0;
    for k in 0..x.len() {
        if x[k] == y[k] {
            count += 1;
        }
    }
    count
}

fn find_secret_word(words: Vec[String], master: mut ref Master) {
    let mut possible: Vec[String] = words.clone();
    while possible.len() > 0 {
        let mut best = 0;
        let mut least = -1;
        for c in 0..possible.len() {
            let mut groups = [0; 7];
            for o in 0..possible.len() {
                groups[places(possible[c], possible[o])] += 1;
            }
            let mut squares = 0;
            for g in groups {
                squares += g * g;
            }
            if least < 0 or squares < least {
                least = squares;
                best = c;
            }
        }
        let guess = possible[best].clone();
        let answer = master.guess(guess);
        if answer == 6 {
            return;
        }
        possible = possible.into_iter().filter(|w| places(w, guess) == answer).collect();
    }
}

// ---- test harness ---------------------------------------------------------

// The judge: it knows the list and the secret, counts every guess, and
// remembers whether the secret was guessed within the allowed number.
struct Master {
    words: Vec[String],
    secret: String,
    allowed: i64,
    guesses: i64,
    strays: i64,
    found: bool,
}

impl Master {
    fn new(words: Vec[String], secret: String, allowed: i64) -> Master {
        Master { words: words.clone(), secret: secret.clone(), allowed: allowed, guesses: 0, strays: 0, found: false }
    }

    // -1 for a word not in the list; otherwise the places it shares with
    // the secret
    fn guess(mut ref self, word: String) -> i64 {
        self.guesses += 1;
        if not self.words.contains(word) {
            self.strays += 1;
            return -1;
        }
        if word == self.secret and self.guesses <= self.allowed {
            self.found = true;
        }
        let a: Vec[char] = word.chars().collect();
        let b: Vec[char] = self.secret.chars().collect();
        let mut count = 0;
        for k in 0..6 {
            if a[k] == b[k] {
                count += 1;
            }
        }
        count
    }
}

fn verdict(words: Vec[String], secret: String, allowed: i64) -> String {
    let mut master = Master.new(words, secret, allowed);
    find_secret_word(words, mut master);
    if master.found {
        "You guessed the secret word correctly."
    } else {
        "Either you took too many guesses, or you did not find the secret word."
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` distinct random words of six letters from the first `k` letters;
// there must be at least `n` such words
fn random_words(seed: mut ref i64, n: i64, k: i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    while words.len() < n {
        let mut w = String.new();
        for _ in 0..6 {
            w.push((97 + next_random(mut seed) % k) as u8 as char);
        }
        if not words.contains(w) {
            words.push(w);
        }
    }
    words
}

fn main() {
    println(verdict(["acckzz", "ccbazz", "eiowzz", "abcczz"], "acckzz", 10));
    println(verdict(["hamada", "khaled"], "hamada", 10));
    println(verdict(["abcdef"], "abcdef", 10));
    // 26 words that differ only in their last letter: each guess rules
    // out one word, so the secret is found only if it is among the first
    // ten guessed
    let mut family: Vec[String] = Vec.new();
    for c in 0..26 {
        family.push(f"aaaaa{(97 + c) as u8 as char}");
    }
    println(verdict(family, "aaaaaj", 10));
    println(verdict(family, "aaaaak", 10));
    println(verdict(family, "aaaaak", 30));
    // every word of six letters from a and b, 64 of them
    let mut binary: Vec[String] = Vec.new();
    for m in 0..64 {
        let mut w = String.new();
        for k in 0..6 {
            w.push(if (m >> k) & 1 == 1 { 'b' } else { 'a' });
        }
        binary.push(w);
    }
    println(verdict(binary, "abbaba", 10));
    println(verdict(binary, "bbbbbb", 10));
    let mut seed = 843;
    let many = random_words(mut seed, 100, 26);
    println(verdict(many, many[57], 10));
    let close = random_words(mut seed, 100, 3);
    println(verdict(close, close[99], 10));
    let mut found = 0;
    let mut check = 0;
    for t in 0..300 {
        let k = 2 + next_random(mut seed) % 25;
        // there are only 64 words of six letters from two
        let n = (1 + next_random(mut seed) % 100).min(k * k * k * k * k * k);
        let words = random_words(mut seed, n, k);
        let secret = words[next_random(mut seed) % n].clone();
        let ok = verdict(words, secret, 10).starts_with("You");
        if ok {
            found += 1;
        }
        check = (check * 31 + if ok { t } else { 1000 }) % 1000000007;
    }
    println(f"300 random lists: {found} found, checksum {check}");
}
