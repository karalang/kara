// LeetCode #891: Sum of Subsequence Widths -- a count of each value.
//
// The values are small, so count them instead of sorting. Walking the
// values upwards, the c copies of a value v fill sorted positions p to
// p + c - 1: they are the largest of 2^p + ... + 2^(p+c-1) = 2^p (2^c - 1)
// subsequences and the smallest of 2^(n-p-c) (2^c - 1), the ★ arm's sums
// for those positions taken at once. O(n + largest value).

fn sum_subseq_widths(nums: Vec[i64]) -> i64 {
    let modulus = 1000000007;
    let n = nums.len();
    let mut largest = 0;
    for x in nums.iter() {
        largest = largest.max(*x);
    }
    let mut count: Vec[i64] = Vec.filled(largest + 1, 0);
    for x in nums.iter() {
        count[*x] += 1;
    }
    let mut pow: Vec[i64] = Vec.filled(n + 1, 1);
    for i in 1..n + 1 {
        pow[i] = pow[i - 1] * 2 % modulus;
    }
    let mut total = 0;
    let mut p = 0;
    for v in 0..largest + 1 {
        let c = count[v];
        if c > 0 {
            let block = pow[c] - 1;
            let as_max = pow[p] * block % modulus;
            let as_min = pow[n - p - c] * block % modulus;
            total = (total + v * (as_max - as_min)) % modulus;
            p += c;
        }
    }
    (total + modulus) % modulus
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"nums = {nums} -> {sum_subseq_widths(nums)}");
}

fn main() {
    show([2, 1, 3]);
    show([2]);
    show([7, 7, 7]);
    show([1, 2]);
    show([5, 1, 4, 2, 3, 3]);
    // 1 to 40, where the widths overflow the modulus many times
    let mut ramp: Vec[i64] = Vec.new();
    for v in 1..41 {
        ramp.push(v);
    }
    show(ramp);
    // random cases: up to 200 numbers, from 1 to 100000 or, a third of
    // the time, from 1 to 10 so that values repeat
    let mut seed = 891;
    let mut numbers = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 200;
        let top = if next_random(mut seed) % 3 == 0 { 10 } else { 100000 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % top);
        }
        let got = sum_subseq_widths(nums);
        numbers += n;
        sum = (sum + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 cases of up to 200 numbers ({numbers} in all): widths sum to {sum}, checksum {check}");
}
