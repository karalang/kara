// LeetCode #891 bench: the counting arm (a count of each value) on 400
// arrays of 100,000 numbers from 1 to 100,000, LeetCode's largest. It is
// the same algorithm in all five languages, where a sort would be each
// language's own library sort.

fn sum_subseq_widths(nums: Vec[i64]) -> i64 {
    let modulus = 1000000007;
    let n = nums.len();
    let mut largest = 0;
    for x in nums.iter() {
        largest = largest.max(*x);
    }
    let mut count: Vec[i64] = Vec.filled(largest + 1, 0);
    for x in nums.iter() {
        count[*x] += 1;
    }
    let mut pow: Vec[i64] = Vec.filled(n + 1, 1);
    for i in 1..n + 1 {
        pow[i] = pow[i - 1] * 2 % modulus;
    }
    let mut total = 0;
    let mut p = 0;
    for v in 0..largest + 1 {
        let c = count[v];
        if c > 0 {
            let block = pow[c] - 1;
            let as_max = pow[p] * block % modulus;
            let as_min = pow[n - p - c] * block % modulus;
            total = (total + v * (as_max - as_min)) % modulus;
            p += c;
        }
    }
    (total + modulus) % modulus
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 891;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..400 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(1 + next_random(mut seed) % 100000);
        }
        let got = sum_subseq_widths(nums);
        sum = (sum + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"400 arrays of 100000 numbers: widths sum to {sum}, checksum {check}");
}
