// LeetCode #891: Sum of Subsequence Widths -- sorted, with powers of two.
//
// A subsequence's width depends only on which values it holds, so sort
// them. The value at sorted position i is the largest of the 2^i
// subsequences made of it and any of the i values before it, and the
// smallest of the 2^(n-1-i) made of it and any after it; it adds itself
// to the width of the first and takes itself away from the second.
// O(n log n).

fn sum_subseq_widths(nums: Vec[i64]) -> i64 {
    let modulus = 1000000007;
    let mut a = nums.clone();
    a.sort();
    let n = a.len();
    let mut pow: Vec[i64] = Vec.filled(n, 1);
    for i in 1..n {
        pow[i] = pow[i - 1] * 2 % modulus;
    }
    let mut total = 0;
    for i in 0..n {
        total = (total + a[i] * (pow[i] - pow[n - 1 - i])) % modulus;
    }
    (total + modulus) % modulus
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"nums = {nums} -> {sum_subseq_widths(nums)}");
}

fn main() {
    show([2, 1, 3]);
    show([2]);
    show([7, 7, 7]);
    show([1, 2]);
    show([5, 1, 4, 2, 3, 3]);
    // 1 to 40, where the widths overflow the modulus many times
    let mut ramp: Vec[i64] = Vec.new();
    for v in 1..41 {
        ramp.push(v);
    }
    show(ramp);
    // random cases: up to 200 numbers, from 1 to 100000 or, a third of
    // the time, from 1 to 10 so that values repeat
    let mut seed = 891;
    let mut numbers = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 200;
        let top = if next_random(mut seed) % 3 == 0 { 10 } else { 100000 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % top);
        }
        let got = sum_subseq_widths(nums);
        numbers += n;
        sum = (sum + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 cases of up to 200 numbers ({numbers} in all): widths sum to {sum}, checksum {check}");
}
