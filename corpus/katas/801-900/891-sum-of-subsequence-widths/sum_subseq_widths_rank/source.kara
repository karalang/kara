// LeetCode #891: Sum of Subsequence Widths -- the rank of each value,
// counted.
//
// No sort: for each value, count the values below it, ties broken by
// position, and the values above. A value with b below and c above is the
// largest of 2^b subsequences and the smallest of 2^c, so it adds
// itself 2^b times and takes itself away 2^c times. O(n^2).

fn sum_subseq_widths(nums: Vec[i64]) -> i64 {
    let modulus = 1000000007;
    let n = nums.len();
    let mut pow: Vec[i64] = Vec.filled(n, 1);
    for i in 1..n {
        pow[i] = pow[i - 1] * 2 % modulus;
    }
    let mut total = 0;
    for i in 0..n {
        let mut below = 0;
        for j in 0..n {
            if nums[j] < nums[i] or (nums[j] == nums[i] and j < i) {
                below += 1;
            }
        }
        let above = n - 1 - below;
        total = (total + nums[i] * (pow[below] - pow[above])) % modulus;
    }
    (total + modulus) % modulus
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"nums = {nums} -> {sum_subseq_widths(nums)}");
}

fn main() {
    show([2, 1, 3]);
    show([2]);
    show([7, 7, 7]);
    show([1, 2]);
    show([5, 1, 4, 2, 3, 3]);
    // 1 to 40, where the widths overflow the modulus many times
    let mut ramp: Vec[i64] = Vec.new();
    for v in 1..41 {
        ramp.push(v);
    }
    show(ramp);
    // random cases: up to 200 numbers, from 1 to 100000 or, a third of
    // the time, from 1 to 10 so that values repeat
    let mut seed = 891;
    let mut numbers = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 200;
        let top = if next_random(mut seed) % 3 == 0 { 10 } else { 100000 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % top);
        }
        let got = sum_subseq_widths(nums);
        numbers += n;
        sum = (sum + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 cases of up to 200 numbers ({numbers} in all): widths sum to {sum}, checksum {check}");
}
