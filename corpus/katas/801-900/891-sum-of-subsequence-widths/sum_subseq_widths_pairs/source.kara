// LeetCode #891: Sum of Subsequence Widths -- every pair of ends.
//
// Sorted, a subsequence's width is its last value less its first. For
// each pair of positions i < j, the subsequences that start at i and end
// at j choose freely among the j - i - 1 values between, so the pair adds
// (a[j] - a[i]) * 2^(j - i - 1). O(n^2).

fn sum_subseq_widths(nums: Vec[i64]) -> i64 {
    let modulus = 1000000007;
    let mut a = nums.clone();
    a.sort();
    let n = a.len();
    let mut pow: Vec[i64] = Vec.filled(n, 1);
    for i in 1..n {
        pow[i] = pow[i - 1] * 2 % modulus;
    }
    let mut total = 0;
    for i in 0..n {
        for j in i + 1..n {
            total = (total + (a[j] - a[i]) * pow[j - i - 1]) % modulus;
        }
    }
    total
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"nums = {nums} -> {sum_subseq_widths(nums)}");
}

fn main() {
    show([2, 1, 3]);
    show([2]);
    show([7, 7, 7]);
    show([1, 2]);
    show([5, 1, 4, 2, 3, 3]);
    // 1 to 40, where the widths overflow the modulus many times
    let mut ramp: Vec[i64] = Vec.new();
    for v in 1..41 {
        ramp.push(v);
    }
    show(ramp);
    // random cases: up to 200 numbers, from 1 to 100000 or, a third of
    // the time, from 1 to 10 so that values repeat
    let mut seed = 891;
    let mut numbers = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 200;
        let top = if next_random(mut seed) % 3 == 0 { 10 } else { 100000 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % top);
        }
        let got = sum_subseq_widths(nums);
        numbers += n;
        sum = (sum + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 cases of up to 200 numbers ({numbers} in all): widths sum to {sum}, checksum {check}");
}
