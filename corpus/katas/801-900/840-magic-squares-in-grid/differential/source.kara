// LeetCode #840: differential -- the four arms against the statement.
//
// Copies of the four arms, held to five properties on random grids,
// against the statement read literally.

// ---- ★ arm ----------------------------------------------------------

fn is_magic_star(grid: Vec[Vec[i64]], r: i64, c: i64) -> bool {
    if grid[r + 1][c + 1] != 5 {
        return false;
    }
    let mut mask = 0;
    for i in r..r + 3 {
        for j in c..c + 3 {
            let v = grid[i][j];
            if v < 1 or v > 9 {
                return false;
            }
            mask |= 1 << v;
        }
    }
    if mask != 1022 {
        return false;
    }
    for k in 0..3 {
        if grid[r + k][c] + grid[r + k][c + 1] + grid[r + k][c + 2] != 15 {
            return false;
        }
        if grid[r][c + k] + grid[r + 1][c + k] + grid[r + 2][c + k] != 15 {
            return false;
        }
    }
    grid[r][c] + grid[r + 2][c + 2] == 10 and grid[r][c + 2] + grid[r + 2][c] == 10
}

fn num_magic_squares_inside_star(grid: Vec[Vec[i64]]) -> i64 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut count = 0;
    for r in 0..rows - 2 {
        for c in 0..cols - 2 {
            if is_magic_star(grid, r, c) {
                count += 1;
            }
        }
    }
    count
}

// ---- ring arm -------------------------------------------------------

fn ring_matches_ring(grid: Vec[Vec[i64]], r: i64, c: i64) -> bool {
    let lo_shu = [4, 9, 2, 7, 6, 1, 8, 3];
    let ring = [
        grid[r][c], grid[r][c + 1], grid[r][c + 2], grid[r + 1][c + 2],
        grid[r + 2][c + 2], grid[r + 2][c + 1], grid[r + 2][c], grid[r + 1][c],
    ];
    for start in [0, 2, 4, 6] {
        for step in [1, 7] {
            let mut all = true;
            for k in 0..8 {
                if ring[k] != lo_shu[(start + step * k) % 8] {
                    all = false;
                }
            }
            if all {
                return true;
            }
        }
    }
    false
}

fn num_magic_squares_inside_ring(grid: Vec[Vec[i64]]) -> i64 {
    let mut count = 0;
    for r in 0..grid.len() - 2 {
        for c in 0..grid[0].len() - 2 {
            if grid[r + 1][c + 1] == 5 and ring_matches_ring(grid, r, c) {
                count += 1;
            }
        }
    }
    count
}

// ---- every-line arm -------------------------------------------------

fn magic_window_lines(grid: Vec[Vec[i64]], r: i64, c: i64) -> bool {
    let mut values: Vec[i64] = Vec.new();
    for i in r..r + 3 {
        for j in c..c + 3 {
            values.push(grid[i][j]);
        }
    }
    values.sort();
    if values != [1, 2, 3, 4, 5, 6, 7, 8, 9] {
        return false;
    }
    let mut sums: Vec[i64] = Vec.new();
    for k in 0..3 {
        sums.push(grid[r + k][c] + grid[r + k][c + 1] + grid[r + k][c + 2]);
        sums.push(grid[r][c + k] + grid[r + 1][c + k] + grid[r + 2][c + k]);
    }
    sums.push(grid[r][c] + grid[r + 1][c + 1] + grid[r + 2][c + 2]);
    sums.push(grid[r][c + 2] + grid[r + 1][c + 1] + grid[r + 2][c]);
    sums.iter().all(|s| s == sums[0])
}

fn num_magic_squares_inside_lines(grid: Vec[Vec[i64]]) -> i64 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut count = 0;
    let mut r = 0;
    while r + 3 <= rows {
        let mut c = 0;
        while c + 3 <= cols {
            if magic_window_lines(grid, r, c) {
                count += 1;
            }
            c += 1;
        }
        r += 1;
    }
    count
}

// ---- prefix-sum arm -------------------------------------------------

fn num_magic_squares_inside_prefix(grid: Vec[Vec[i64]]) -> i64 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut across: Vec[Vec[i64]] = Vec.new();
    for i in 0..rows {
        let mut row: Vec[i64] = Vec.filled(cols + 1, 0);
        for j in 0..cols {
            row[j + 1] = row[j] + grid[i][j];
        }
        across.push(row);
    }
    let mut down: Vec[Vec[i64]] = Vec.filled(rows + 1, Vec.filled(cols, 0));
    for i in 0..rows {
        for j in 0..cols {
            down[i + 1][j] = down[i][j] + grid[i][j];
        }
    }
    let mut count = 0;
    for r in 0..rows - 2 {
        for c in 0..cols - 2 {
            let mut seen = [0; 16];
            for i in r..r + 3 {
                for j in c..c + 3 {
                    seen[grid[i][j]] += 1;
                }
            }
            let mut ones = true;
            for v in 1..10 {
                if seen[v] != 1 {
                    ones = false;
                }
            }
            let mut fifteen = true;
            for k in 0..3 {
                if across[r + k][c + 3] - across[r + k][c] != 15 or down[r + 3][c + k] - down[r][c + k] != 15 {
                    fifteen = false;
                }
            }
            let falling = grid[r][c] + grid[r + 1][c + 1] + grid[r + 2][c + 2];
            let rising = grid[r][c + 2] + grid[r + 1][c + 1] + grid[r + 2][c];
            if ones and fifteen and falling == 15 and rising == 15 {
                count += 1;
            }
        }
    }
    count
}

// ---- the statement ----------------------------------------------------------

// The statement read literally: a 3 by 3 window of the grid is a magic
// square when its nine numbers are distinct and each from 1 to 9, and its
// three rows, three columns and two diagonals all have the same sum.
fn statement(grid: Vec[Vec[i64]]) -> i64 {
    let mut count = 0;
    let rows = grid.len();
    let cols = grid[0].len();
    for r in 0..rows {
        for c in 0..cols {
            if r + 3 > rows or c + 3 > cols {
                continue;
            }
            let mut values: Vec[i64] = Vec.new();
            for i in 0..3 {
                for j in 0..3 {
                    values.push(grid[r + i][c + j]);
                }
            }
            let mut ok = true;
            for a in 0..9 {
                if values[a] < 1 or values[a] > 9 {
                    ok = false;
                }
                for b in a + 1..9 {
                    if values[a] == values[b] {
                        ok = false;
                    }
                }
            }
            let mut sums: Vec[i64] = Vec.new();
            for i in 0..3 {
                sums.push(values[3 * i] + values[3 * i + 1] + values[3 * i + 2]);
                sums.push(values[i] + values[i + 3] + values[i + 6]);
            }
            sums.push(values[0] + values[4] + values[8]);
            sums.push(values[2] + values[4] + values[6]);
            for s in sums.iter() {
                if *s != sums[0] {
                    ok = false;
                }
            }
            if ok {
                count += 1;
            }
        }
    }
    count
}

// ---- harness ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, grid: Vec[Vec[i64]]) -> i64 {
    if arm == 0 {
        num_magic_squares_inside_star(grid)
    } else if arm == 1 {
        num_magic_squares_inside_ring(grid)
    } else if arm == 2 {
        num_magic_squares_inside_lines(grid)
    } else {
        num_magic_squares_inside_prefix(grid)
    }
}

// the Lo Shu turned a quarter `turn % 4` times, mirrored first if turn >= 4
fn oriented(turn: i64) -> Vec[Vec[i64]] {
    turned_square([[4, 9, 2], [3, 5, 7], [8, 1, 6]], turn)
}

// a 3 by 3 square turned a quarter `turn % 4` times, mirrored first if
// turn >= 4
fn turned_square(base: Vec[Vec[i64]], turn: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    for i in 0..3 {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..3 {
            let mut a = i;
            let mut b = if turn >= 4 { 2 - j } else { j };
            for _ in 0..turn % 4 {
                let t = a;
                a = 2 - b;
                b = t;
            }
            row.push(base[a][b]);
        }
        out.push(row);
    }
    out
}

// a rows by cols grid of numbers 0 to 15 with `plants` 3 by 3 squares
// stamped on it: true magic squares, magic squares moved off 1 to 9,
// squares of 5s, magic squares with two cells swapped or with another
// centre, and squares of 1 to 9 whose rows and columns add up to 15 but
// not their diagonals
fn random_grid(seed: mut ref i64, rows: i64, cols: i64, plants: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..rows {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..cols {
            row.push(next_random(mut seed) % 16);
        }
        grid.push(row);
    }
    if rows < 3 or cols < 3 {
        return grid;
    }
    for _ in 0..plants {
        let turn = next_random(mut seed) % 8;
        let kind = next_random(mut seed) % 6;
        let square = if kind == 5 { turned_square([[1, 5, 9], [6, 7, 2], [8, 3, 4]], turn) } else { oriented(turn) };
        let shift = if kind == 1 { [-1, 1, 2, 6][next_random(mut seed) % 4] } else { 0 };
        let swap_a = next_random(mut seed) % 9;
        let swap_b = next_random(mut seed) % 9;
        let r = next_random(mut seed) % (rows - 2);
        let c = next_random(mut seed) % (cols - 2);
        for i in 0..3 {
            for j in 0..3 {
                let mut k = 3 * i + j;
                if kind == 3 {
                    k = if k == swap_a { swap_b } else if k == swap_b { swap_a } else { k };
                }
                grid[r + i][c + j] = if kind == 2 { 5 } else { square[k / 3][k % 3] + shift };
            }
        }
        if kind == 4 {
            grid[r + 1][c + 1] = next_random(mut seed) % 16;
        }
    }
    grid
}

fn transposed(grid: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    for j in 0..grid[0].len() {
        let mut row: Vec[i64] = Vec.new();
        for i in 0..grid.len() {
            row.push(grid[i][j]);
        }
        out.push(row);
    }
    out
}

// turned a quarter clockwise: the last row becomes the first column
fn turned(grid: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    for j in 0..grid[0].len() {
        let mut row: Vec[i64] = Vec.new();
        for i in (0..grid.len()).rev() {
            row.push(grid[i][j]);
        }
        out.push(row);
    }
    out
}

// a border of zeros all round
fn bordered(grid: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let cols = grid[0].len() + 2;
    let mut out: Vec[Vec[i64]] = Vec.new();
    out.push(Vec.filled(cols, 0));
    for row in grid.iter() {
        let mut r: Vec[i64] = Vec.new();
        r.push(0);
        for v in row.iter() {
            r.push(*v);
        }
        r.push(0);
        out.push(r);
    }
    out.push(Vec.filled(cols, 0));
    out
}

// the answers on each 3 by 3 window taken alone, added up
fn by_window(arm: i64, grid: Vec[Vec[i64]]) -> i64 {
    let mut total = 0;
    for r in 0..grid.len() {
        for c in 0..grid[0].len() {
            if r + 3 <= grid.len() and c + 3 <= grid[0].len() {
                let mut window: Vec[Vec[i64]] = Vec.new();
                for i in 0..3 {
                    let mut row: Vec[i64] = Vec.new();
                    for j in 0..3 {
                        row.push(grid[r + i][c + j]);
                    }
                    window.push(row);
                }
                total += answer(arm, window);
            }
        }
    }
    total
}

fn main() {
    let names = ["star", "ring", "lines", "prefix"];
    let properties = ["answer", "transposed", "turned", "bordered", "by window"];
    let mut by_arm: Vec[i64] = Vec.filled(4, 0);
    let mut by_property: Vec[i64] = Vec.filled(5, 0);
    let mut failures = 0;
    let mut checks = 0;
    let mut seed = 840;
    for case in 0..1600 {
        let kind = case / 400;
        let grid = if kind == 0 {
            // small grids, a few squares stamped
            let rows = 1 + next_random(mut seed) % 5;
            let cols = 1 + next_random(mut seed) % 5;
            random_grid(mut seed, rows, cols, next_random(mut seed) % 4)
        } else if kind == 1 {
            // one 3 by 3 window with one square stamped
            random_grid(mut seed, 3, 3, 1)
        } else if kind == 2 {
            // grids up to 10 by 10, many squares stamped
            let rows = 1 + next_random(mut seed) % 10;
            let cols = 1 + next_random(mut seed) % 10;
            random_grid(mut seed, rows, cols, next_random(mut seed) % 13)
        } else {
            // a true magic square with one cell of the grid then changed
            let rows = 3 + next_random(mut seed) % 4;
            let cols = 3 + next_random(mut seed) % 4;
            let mut g = random_grid(mut seed, rows, cols, 0);
            let square = oriented(next_random(mut seed) % 8);
            let r = next_random(mut seed) % (rows - 2);
            let c = next_random(mut seed) % (cols - 2);
            for i in 0..3 {
                for j in 0..3 {
                    g[r + i][c + j] = square[i][j];
                }
            }
            let i = next_random(mut seed) % rows;
            let j = next_random(mut seed) % cols;
            g[i][j] = next_random(mut seed) % 16;
            g
        };
        let want = statement(grid);
        for arm in 0..4 {
            let got = answer(arm, grid);
            let oks = [
                got == want,
                answer(arm, transposed(grid)) == got,
                answer(arm, turned(grid)) == got,
                answer(arm, bordered(grid)) == got,
                by_window(arm, grid) == got,
            ];
            for q in 0..5 {
                checks += 1;
                if not oks[q] {
                    failures += 1;
                    by_arm[arm] += 1;
                    by_property[q] += 1;
                    if failures <= 5 {
                        println(f"FAIL {names[arm]} {properties[q]}: {grid} -> {got}, want {want}");
                    }
                }
            }
        }
    }
    println(f"1600 cases, {checks} checks over 4 arms: {failures} failures");
    println(f"by arm: star {by_arm[0]}, ring {by_arm[1]}, lines {by_arm[2]}, prefix {by_arm[3]}");
    println(f"by property: answer {by_property[0]}, transposed {by_property[1]}, turned {by_property[2]}, bordered {by_property[3]}, by window {by_property[4]}");
}
