// LeetCode #826: Most Profit Assigning Work -- a table by difficulty.
//
// Difficulties and abilities are at most 100,000. The best profit at
// each difficulty goes in a table, a running maximum turns it into the
// best profit at that difficulty or below, and each worker reads their
// ability's entry. No sorting. O(n + m + D) for D the largest value.

fn max_profit_assignment(difficulty: Vec[i64], profit: Vec[i64], worker: Vec[i64]) -> i64 {
    let mut top = 0;
    for d in difficulty.iter() {
        top = top.max(d);
    }
    for w in worker.iter() {
        top = top.max(w);
    }
    let mut best: Vec[i64] = Vec.filled(top + 1, 0);
    for i in 0..difficulty.len() {
        best[difficulty[i]] = best[difficulty[i]].max(profit[i]);
    }
    for d in 1..top + 1 {
        best[d] = best[d].max(best[d - 1]);
    }
    let mut total = 0;
    for w in worker.iter() {
        total += best[w];
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(difficulty: Vec[i64], profit: Vec[i64], worker: Vec[i64]) {
    let answer = max_profit_assignment(difficulty.clone(), profit.clone(), worker.clone());
    println(f"{difficulty} {profit} {worker} -> {answer}");
}

fn draw(seed: mut ref i64, count: i64, top: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..count {
        v.push(1 + next_random(mut seed) % top);
    }
    v
}

fn main() {
    show([2, 4, 6, 8, 10], [10, 20, 30, 40, 50], [4, 5, 6, 7]);
    show([85, 47, 57], [24, 66, 99], [40, 25, 25]);
    show([5], [7], [5]);
    show([5], [7], [4]);
    show([1, 2, 3], [30, 20, 10], [3, 3, 1]);
    show([4, 4, 2], [5, 9, 1], [4, 3, 100000]);
    show([10, 10, 10], [1, 2, 3], [9, 10, 11]);
    // LeetCode's largest: 10,000 jobs and 10,000 workers, values up to
    // 100,000; random, and with profit falling as difficulty rises.
    let mut seed = 826;
    let d = draw(mut seed, 10000, 100000);
    let p = draw(mut seed, 10000, 100000);
    let w = draw(mut seed, 10000, 100000);
    println(f"10000 random jobs and workers -> {max_profit_assignment(d.clone(), p, w.clone())}");
    let falling: Vec[i64] = d.iter().map(|x| 100001 - x).collect();
    println(f"10000 jobs, profit falling with difficulty -> {max_profit_assignment(d, falling, w)}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 12;
        let m = 1 + next_random(mut seed) % 12;
        let dd = draw(mut seed, n, 30);
        let pp = draw(mut seed, n, 50);
        let ww = draw(mut seed, m, 35);
        let r = max_profit_assignment(dd, pp, ww);
        total += r;
        check = (check * 131 + r) % 1000000007;
    }
    println(f"300 random cases: total {total}, checksum {check}");
}
