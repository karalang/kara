// LeetCode #892: Surface Area of 3D Shapes -- the faces each tower shows.
//
// A tower shows its top and bottom when it has any cubes, and on each of
// its four sides the part that rises above the neighbour there, a cell
// off the grid counting as height 0. O(n^2).

fn surface_area(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut area = 0;
    for i in 0..n {
        for j in 0..n {
            let v = grid[i][j];
            if v == 0 {
                continue;
            }
            area += 2;
            area += (v - height(grid, i - 1, j)).max(0);
            area += (v - height(grid, i + 1, j)).max(0);
            area += (v - height(grid, i, j - 1)).max(0);
            area += (v - height(grid, i, j + 1)).max(0);
        }
    }
    area
}

// the tower at row i, column j, or 0 off the grid
fn height(grid: Vec[Vec[i64]], i: i64, j: i64) -> i64 {
    if i < 0 or j < 0 or i >= grid.len() or j >= grid.len() {
        0
    } else {
        grid[i][j]
    }
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(grid: Vec[Vec[i64]]) {
    println(f"grid = {grid} -> {surface_area(grid)}");
}

fn main() {
    show([[1, 2], [3, 4]]);
    show([[1, 1, 1], [1, 0, 1], [1, 1, 1]]);
    show([[2, 2, 2], [2, 1, 2], [2, 2, 2]]);
    show([[0]]);
    show([[50]]);
    show([[0, 3], [3, 0]]);
    // random grids of LeetCode's sizes: up to 50 by 50, towers up to 50
    // high, or, a third of the time, up to 3 high with a cell in three
    // empty
    let mut seed = 892;
    let mut cubes = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 50;
        let low = next_random(mut seed) % 3 == 0;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                let v = if low {
                    if next_random(mut seed) % 3 == 0 { 0 } else { 1 + next_random(mut seed) % 3 }
                } else {
                    next_random(mut seed) % 51
                };
                cubes += v;
                row.push(v);
            }
            grid.push(row);
        }
        let got = surface_area(grid);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"300 grids of up to 50 by 50 ({cubes} cubes): surface area {total}, checksum {check}");
}
