// LeetCode #892: Surface Area of 3D Shapes -- the outline of each layer.
//
// Cut the shapes into layers one cube high. Layer h holds the cells whose
// tower reaches h, and its sides are the edges of that set: the edges
// between a cell in it and a cell outside or off the grid. With a top and
// a bottom for each tower that has cubes, the layers' outlines are the
// whole surface. O(n^2 * tallest).

fn surface_area(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut tallest = 0;
    let mut area = 0;
    for row in grid.iter() {
        for v in row.iter() {
            tallest = tallest.max(*v);
            if *v > 0 {
                area += 2;
            }
        }
    }
    for h in 1..tallest + 1 {
        for i in 0..n {
            for j in 0..n {
                if grid[i][j] >= h {
                    if i == 0 or grid[i - 1][j] < h {
                        area += 1;
                    }
                    if i == n - 1 or grid[i + 1][j] < h {
                        area += 1;
                    }
                    if j == 0 or grid[i][j - 1] < h {
                        area += 1;
                    }
                    if j == n - 1 or grid[i][j + 1] < h {
                        area += 1;
                    }
                }
            }
        }
    }
    area
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(grid: Vec[Vec[i64]]) {
    println(f"grid = {grid} -> {surface_area(grid)}");
}

fn main() {
    show([[1, 2], [3, 4]]);
    show([[1, 1, 1], [1, 0, 1], [1, 1, 1]]);
    show([[2, 2, 2], [2, 1, 2], [2, 2, 2]]);
    show([[0]]);
    show([[50]]);
    show([[0, 3], [3, 0]]);
    // random grids of LeetCode's sizes: up to 50 by 50, towers up to 50
    // high, or, a third of the time, up to 3 high with a cell in three
    // empty
    let mut seed = 892;
    let mut cubes = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 50;
        let low = next_random(mut seed) % 3 == 0;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                let v = if low {
                    if next_random(mut seed) % 3 == 0 { 0 } else { 1 + next_random(mut seed) % 3 }
                } else {
                    next_random(mut seed) % 51
                };
                cubes += v;
                row.push(v);
            }
            grid.push(row);
        }
        let got = surface_area(grid);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"300 grids of up to 50 by 50 ({cubes} cubes): surface area {total}, checksum {check}");
}
