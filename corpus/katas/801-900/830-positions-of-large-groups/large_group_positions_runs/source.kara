// LeetCode #830: Positions of Large Groups -- run-length encoding first.
//
// The string is first encoded as runs, each a letter and a count, and the
// runs are then walked with the offset where each starts, keeping those of
// 3 or more. O(n).

fn large_group_positions(s: String) -> Vec[Vec[i64]] {
    let mut runs: Vec[(u8, i64)] = Vec.new();
    for c in s.bytes() {
        let k = runs.len();
        if k > 0 and runs[k - 1].0 == c {
            runs[k - 1].1 += 1;
        } else {
            runs.push((c, 1));
        }
    }
    let mut groups: Vec[Vec[i64]] = Vec.new();
    let mut at = 0;
    for (_, count) in runs.iter() {
        if count >= 3 {
            groups.push([at, at + count - 1]);
        }
        at += count;
    }
    groups
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_string(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn show(s: String) {
    println(f"\"{s}\" -> {large_group_positions(s.clone())}");
}

fn summary(label: String, s: String) {
    let groups = large_group_positions(s);
    let mut check = 0;
    for g in groups.iter() {
        check = (check * 131 + g[0] * 1009 + g[1]) % 1000000007;
    }
    println(f"{label}: {groups.len()} groups, checksum {check}");
}

fn main() {
    show("abbxxxxzzy");
    show("abc");
    show("abcdddeeeeaabbbcd");
    show("aba");
    show("a");
    show("aa");
    show("aaa");
    show("aaab");
    show("baaa");
    show("aaabbb");
    show("aabbbaaaa");
    // LeetCode's longest, 1,000 letters: random over two letters, over
    // three, and one letter throughout.
    let mut seed = 830;
    summary("1000 letters of 2", random_string(mut seed, 1000, 2));
    summary("1000 letters of 3", random_string(mut seed, 1000, 3));
    summary("1000 letters of 1", random_string(mut seed, 1000, 1));
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let letters = 1 + next_random(mut seed) % 3;
        for g in large_group_positions(random_string(mut seed, n, letters)).iter() {
            total += 1;
            check = (check * 131 + g[0] * 1009 + g[1]) % 1000000007;
        }
    }
    println(f"300 random strings: {total} groups, checksum {check}");
}
