// LeetCode 808 — Soup Servings, top down with a memo.
//
// The answer for a servings of A and b of B left, by its definition:
// 1, 0 or 1/2 once a soup is empty, else the mean of the four pours'
// answers. Each state is worked out once and kept in a map keyed by the
// pair. Past 4800 ml the answer is within 1e-5 of 1.
fn chance(a: i64, b: i64, memo: mut ref Map[(i64, i64), f64]) -> f64 {
    if a <= 0 and b <= 0 {
        return 0.5;
    }
    if a <= 0 {
        return 1.0;
    }
    if b <= 0 {
        return 0.0;
    }
    if let Some(p) = memo.get((a, b)) {
        return p;
    }
    let p = 0.25
        * (chance(a - 4, b, mut memo) + chance(a - 3, b - 1, mut memo)
            + chance(a - 2, b - 2, mut memo) + chance(a - 1, b - 3, mut memo));
    memo.insert((a, b), p);
    p
}

fn soup_servings(n: i64) -> f64 {
    if n > 4800 {
        return 1.0;
    }
    let m = (n + 24) / 25;
    let mut memo: Map[(i64, i64), f64] = Map.new();
    chance(m, m, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    for n in [50, 100, 0, 1, 25, 26, 4800, 4801, 1000000000] {
        println(f"n = {n}: {soup_servings(n):.5}");
    }
    let mut line = "every 25 ml to 300:".to_string();
    let mut n = 25;
    while n <= 300 {
        line.push_str(f" {soup_servings(n):.5}");
        n += 25;
    }
    println(line);
    // The first serving count whose answer is above 1 - 1e-5, so that
    // rounding it to five places gives 1.
    let mut m = 0;
    while soup_servings(25 * m) <= 0.99999 {
        m += 1;
    }
    println(f"first above 0.99999: {25 * m} ml, {soup_servings(25 * m):.7}");
    let mut sum = 0.0;
    let mut count = 0;
    let mut n = 0;
    while n <= 5000 {
        sum += soup_servings(n);
        count += 1;
        n += 37;
    }
    println(f"{count} sizes from 0 to 5000 ml: sum {sum:.5}");
}
