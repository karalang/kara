// LeetCode 808 — Soup Servings, a table built bottom up.
//
// Count soup in servings of 25 ml, rounding up, since a part serving
// ends the same way a whole one does: n ml is m = ceil(n / 25)
// servings. p[a][b] is the answer with a servings of A and b of B left:
// 1 if only A is empty, 0 if only B is, 1/2 if both, and otherwise the
// mean of the four states one turn on, a pour that takes more than is
// left emptying the soup. Past 4800 ml the answer is within 1e-5 of 1,
// so return 1 there. O(m²).
fn soup_servings(n: i64) -> f64 {
    if n > 4800 {
        return 1.0;
    }
    let m = (n + 24) / 25;
    let mut p = Vec.filled(m + 1, Vec.filled(m + 1, 0.0));
    for a in 0..m + 1 {
        for b in 0..m + 1 {
            p[a][b] = if a == 0 and b == 0 {
                0.5
            } else if a == 0 {
                1.0
            } else if b == 0 {
                0.0
            } else {
                let pour = [(4, 0), (3, 1), (2, 2), (1, 3)];
                let mut sum = 0.0;
                for (da, db) in pour {
                    sum += p[(a - da).max(0)][(b - db).max(0)];
                }
                0.25 * sum
            };
        }
    }
    p[m][m]
}

// ---- test harness ---------------------------------------------------------

fn main() {
    for n in [50, 100, 0, 1, 25, 26, 4800, 4801, 1000000000] {
        println(f"n = {n}: {soup_servings(n):.5}");
    }
    let mut line = "every 25 ml to 300:".to_string();
    let mut n = 25;
    while n <= 300 {
        line.push_str(f" {soup_servings(n):.5}");
        n += 25;
    }
    println(line);
    // The first serving count whose answer is above 1 - 1e-5, so that
    // rounding it to five places gives 1.
    let mut m = 0;
    while soup_servings(25 * m) <= 0.99999 {
        m += 1;
    }
    println(f"first above 0.99999: {25 * m} ml, {soup_servings(25 * m):.7}");
    let mut sum = 0.0;
    let mut count = 0;
    let mut n = 0;
    while n <= 5000 {
        sum += soup_servings(n);
        count += 1;
        n += 37;
    }
    println(f"{count} sizes from 0 to 5000 ml: sum {sum:.5}");
}
