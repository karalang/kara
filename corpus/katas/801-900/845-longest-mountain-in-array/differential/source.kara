// LeetCode #845: differential -- the four arms against the statement.
//
// Copies of the four arms, held to five properties on random arrays,
// against the statement read literally.

// ---- ★ arm ----------------------------------------------------------

fn longest_mountain_star(arr: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut up = 0;
    let mut down = 0;
    for i in 1..arr.len() {
        if (down > 0 and arr[i - 1] < arr[i]) or arr[i - 1] == arr[i] {
            up = 0;
            down = 0;
        }
        if arr[i - 1] < arr[i] {
            up += 1;
        } else if arr[i - 1] > arr[i] {
            down += 1;
        }
        if up > 0 and down > 0 {
            best = best.max(up + down + 1);
        }
    }
    best
}

// ---- rise-and-fall arm ----------------------------------------------

fn longest_mountain_runs(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut rise: Vec[i64] = Vec.filled(n, 0);
    let mut fall: Vec[i64] = Vec.filled(n, 0);
    for i in 1..n {
        if arr[i] > arr[i - 1] {
            rise[i] = rise[i - 1] + 1;
        }
    }
    for i in (0..n - 1).rev() {
        if arr[i] > arr[i + 1] {
            fall[i] = fall[i + 1] + 1;
        }
    }
    let mut best = 0;
    for i in 0..n {
        if rise[i] > 0 and fall[i] > 0 {
            best = best.max(rise[i] + fall[i] + 1);
        }
    }
    best
}

// ---- peaks arm ------------------------------------------------------

fn longest_mountain_peaks(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut best = 0;
    let mut i = 1;
    while i + 1 < n {
        if arr[i - 1] < arr[i] and arr[i] > arr[i + 1] {
            let mut left = i - 1;
            while left > 0 and arr[left - 1] < arr[left] {
                left -= 1;
            }
            let mut right = i + 1;
            while right + 1 < n and arr[right + 1] < arr[right] {
                right += 1;
            }
            best = best.max(right - left + 1);
            i = right;
        } else {
            i += 1;
        }
    }
    best
}

// ---- signs arm ------------------------------------------------------

fn longest_mountain_signs(arr: Vec[i64]) -> i64 {
    let steps: Vec[i64] = arr.windows(2).iter().map(|w| (w[1] - w[0]).signum()).collect();
    let mut runs: Vec[(i64, i64)] = Vec.new();
    for s in steps {
        if runs.len() > 0 and runs[runs.len() - 1].0 == s {
            let last = runs.len() - 1;
            runs[last].1 += 1;
        } else {
            runs.push((s, 1));
        }
    }
    let mut best = 0;
    for k in 1..runs.len() {
        if runs[k - 1].0 == 1 and runs[k].0 == -1 {
            best = best.max(runs[k - 1].1 + runs[k].1 + 1);
        }
    }
    best
}

// ---- the statement ----------------------------------------------------------

// The statement read literally: a subarray `arr[l..=r]` is a mountain
// when it has at least three elements and some `i` strictly inside it
// has every step from `l` to `i` going up and every step from `i` to `r`
// going down. Every subarray and every peak in it is tried.
fn statement(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut best = 0;
    for l in 0..n {
        for r in l + 2..n {
            let mut mountain = false;
            for i in l + 1..r {
                let mut ok = true;
                for k in l..i {
                    if arr[k] >= arr[k + 1] {
                        ok = false;
                    }
                }
                for k in i..r {
                    if arr[k] <= arr[k + 1] {
                        ok = false;
                    }
                }
                if ok {
                    mountain = true;
                }
            }
            if mountain {
                best = best.max(r - l + 1);
            }
        }
    }
    best
}

fn mountain(arm: i64, arr: Vec[i64]) -> i64 {
    if arm == 0 {
        longest_mountain_star(arr)
    } else if arm == 1 {
        longest_mountain_runs(arr)
    } else if arm == 2 {
        longest_mountain_peaks(arr)
    } else {
        longest_mountain_signs(arr)
    }
}

// ---- harness ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "runs", "peaks", "signs"];
    let properties = ["answer", "reversed", "shifted", "doubled", "walled"];
    let mut by_arm: Vec[i64] = Vec.filled(4, 0);
    let mut by_property: Vec[i64] = Vec.filled(5, 0);
    let mut failures = 0;
    let mut checks = 0;
    let mut some = 0;
    let mut seed = 845;
    for case in 0..1600 {
        let kind = case / 400;
        let n = 1 + next_random(mut seed) % 24;
        let mut arr: Vec[i64] = Vec.new();
        if kind == 0 {
            // few distinct values: many flat steps
            let top = 1 + next_random(mut seed) % 3;
            for _ in 0..n {
                arr.push(next_random(mut seed) % top);
            }
        } else if kind == 1 {
            // any values
            for _ in 0..n {
                arr.push(next_random(mut seed) % 10001);
            }
        } else if kind == 2 {
            // a walk of steps of -1, 0 or 1: long slopes and plateaus
            let mut v = 5000;
            for _ in 0..n {
                arr.push(v);
                v += next_random(mut seed) % 3 - 1;
            }
        } else {
            // mountains of random heights side by side, sharing feet or not
            while arr.len() < n {
                let up = next_random(mut seed) % 5;
                let down = next_random(mut seed) % 5;
                let base = next_random(mut seed) % 3;
                for k in 0..up + 1 {
                    arr.push(base + k);
                }
                for k in 0..down {
                    arr.push(base + up - k - 1);
                }
            }
        }
        let want = statement(arr);
        if want > 0 {
            some += 1;
        }
        let mut rev = arr.clone();
        rev.reverse();
        let shift = next_random(mut seed) % 100;
        let shifted: Vec[i64] = arr.iter().map(|x| x + shift).collect();
        let doubled: Vec[i64] = arr.iter().map(|x| x * 2).collect();
        let mut walled: Vec[i64] = arr.clone();
        let high = walled.iter().max().unwrap() + 1;
        walled.push(high);
        walled.push(high);
        walled.extend(arr.clone());
        for arm in 0..4 {
            let got = mountain(arm, arr);
            let oks = [
                got == want,
                mountain(arm, rev) == got,
                mountain(arm, shifted) == got,
                mountain(arm, doubled) == got,
                mountain(arm, walled) == got,
            ];
            for q in 0..5 {
                checks += 1;
                if not oks[q] {
                    failures += 1;
                    by_arm[arm] += 1;
                    by_property[q] += 1;
                    if failures <= 5 {
                        println(f"FAIL {names[arm]} {properties[q]}: {arr} -> {got}, want {want}");
                    }
                }
            }
        }
    }
    println(f"1600 cases, {some} with a mountain, {checks} checks over 4 arms: {failures} failures");
    println(f"by arm: star {by_arm[0]}, runs {by_arm[1]}, peaks {by_arm[2]}, signs {by_arm[3]}");
    println(f"by property: answer {by_property[0]}, reversed {by_property[1]}, shifted {by_property[2]}, doubled {by_property[3]}, walled {by_property[4]}");
}
