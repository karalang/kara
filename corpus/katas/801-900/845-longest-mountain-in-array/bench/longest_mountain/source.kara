// Benchmark for #845: Longest Mountain in Array -- the ★ arm (one pass with
// two counters).
//
// Walking the pairs of neighbours once, `up` counts the climbing steps
// of the mountain in progress and `down` its falling steps; a step up
// after a fall, or a flat step, starts afresh, and whenever both counts
// are positive the mountain so far has `up + down + 1` elements.

fn longest_mountain(arr: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut up = 0;
    let mut down = 0;
    for i in 1..arr.len() {
        if (down > 0 and arr[i - 1] < arr[i]) or arr[i - 1] == arr[i] {
            up = 0;
            down = 0;
        }
        if arr[i - 1] < arr[i] {
            up += 1;
        } else if arr[i - 1] > arr[i] {
            down += 1;
        }
        if up > 0 and down > 0 {
            best = best.max(up + down + 1);
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 arrays drawn once, each of LeetCode's most elements, 10^4, with
    // values from 0 to 10^4: array g is random values when g % 3 is 0, a
    // walk of steps of -1, 0 or 1 when it is 1, and mountains of random
    // heights up to 40 side by side when it is 2. Each round asks the
    // next array.
    let count = 64;
    let rounds = 20000;
    let n = 10000;
    let mut seed: i64 = 845;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for g in 0..count {
        let mut arr: Vec[i64] = Vec.new();
        if g % 3 == 0 {
            for _ in 0..n {
                arr.push(next_random(mut seed) % 10001);
            }
        } else if g % 3 == 1 {
            let mut v = 5000;
            for _ in 0..n {
                arr.push(v);
                v += next_random(mut seed) % 3 - 1;
            }
        } else {
            while arr.len() < n {
                let up = next_random(mut seed) % 40;
                let down = next_random(mut seed) % 40;
                let base = next_random(mut seed) % 100;
                for k in 0..up + 1 {
                    if arr.len() < n {
                        arr.push(base + k);
                    }
                }
                for k in 0..down {
                    if arr.len() < n {
                        arr.push(base + up - k - 1);
                    }
                }
            }
        }
        arrays.push(arr);
    }
    let mut total = 0;
    let mut checksum = 0;
    for round in 0..rounds {
        let m = longest_mountain(arrays[round % count]);
        total += m;
        checksum = (checksum * 31 + m) % 1000000007;
    }
    println(f"{rounds} rounds of {count} arrays: lengths sum to {total}, checksum {checksum}");
}
