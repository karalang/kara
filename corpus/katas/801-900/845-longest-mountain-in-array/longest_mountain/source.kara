// LeetCode #845: Longest Mountain in Array -- the ★ arm (one pass with two
// counters).
//
// A mountain climbs strictly and then falls strictly. Walking the pairs
// of neighbours once, `up` counts the climbing steps of the mountain in
// progress and `down` its falling steps. A step up after a fall, or any
// flat step, ends that mountain and starts afresh (a step up starts a
// new climb at once). Whenever both counts are positive the mountain so
// far has `up + down + 1` elements. O(n) time, O(1) space, as the
// follow-up asks.

fn longest_mountain(arr: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut up = 0;
    let mut down = 0;
    for i in 1..arr.len() {
        if (down > 0 and arr[i - 1] < arr[i]) or arr[i - 1] == arr[i] {
            up = 0;
            down = 0;
        }
        if arr[i - 1] < arr[i] {
            up += 1;
        } else if arr[i - 1] > arr[i] {
            down += 1;
        }
        if up > 0 and down > 0 {
            best = best.max(up + down + 1);
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn show(arr: Vec[i64]) {
    println(f"{arr} -> {longest_mountain(arr)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show([2, 1, 4, 7, 3, 2, 5]);
    show([2, 2, 2]);
    show([0]);
    show([0, 1]);
    show([1, 2, 3]);
    show([3, 2, 1]);
    show([1, 3, 2]);
    show([0, 1, 0, 1, 0]);
    show([1, 2, 2, 1]);
    show([1, 2, 3, 2, 1, 2, 3, 4, 3]);
    show([2, 1, 2, 3, 4, 3, 3, 2, 1]);
    show([0, 10000, 0]);
    show([1, 2, 1, 2, 3, 2, 1, 1, 2, 3, 4, 5, 4]);
    // LeetCode's longest arrays, 10^4 elements
    let mut one: Vec[i64] = Vec.new();
    for i in 0..10000 {
        one.push(if i < 5000 { i } else { 10000 - i });
    }
    println(f"one mountain of 10000: {longest_mountain(one)}");
    let mut zigzag: Vec[i64] = Vec.new();
    for i in 0..10000 {
        zigzag.push(i % 2);
    }
    println(f"zigzag of 10000: {longest_mountain(zigzag)}");
    let flat: Vec[i64] = Vec.filled(10000, 10000);
    println(f"10000 equal values: {longest_mountain(flat)}");
    let mut seed = 845;
    let mut long: Vec[i64] = Vec.new();
    for _ in 0..10000 {
        long.push(next_random(mut seed) % 10001);
    }
    println(f"10000 random values: {longest_mountain(long)}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..500 {
        let n = 1 + next_random(mut seed) % 40;
        let top = 1 + next_random(mut seed) % 6;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(next_random(mut seed) % top);
        }
        let m = longest_mountain(arr);
        total += m;
        check = (check * 31 + m) % 1000000007;
    }
    println(f"500 random arrays: lengths sum to {total}, checksum {check}");
}
