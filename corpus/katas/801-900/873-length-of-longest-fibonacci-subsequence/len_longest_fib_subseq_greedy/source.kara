// LeetCode #873: Length of Longest Fibonacci Subsequence -- every pair
// extended as far as it goes.
//
// The first two values fix the whole subsequence, so each pair i < j is
// followed forward: while the sum of the last two is in the array (a Set
// of its values), it is the next value. The values at least double every
// two steps, so a run below 10^9 has at most about 45 values. O(n^2 log M)
// for values up to M.

fn len_longest_fib_subseq(arr: Vec[i64]) -> i64 {
    let mut values: Set[i64] = Set.new();
    for x in arr.iter() {
        values.insert(*x);
    }
    let mut best = 0;
    for i in 0..arr.len() {
        for j in i + 1..arr.len() {
            let mut a = arr[i];
            let mut b = arr[j];
            let mut length = 2;
            while values.contains(a + b) {
                let next = a + b;
                a = b;
                b = next;
                length += 1;
            }
            if length >= 3 {
                best = best.max(length);
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n increasing values, each 1 to gap above the one before
fn increasing(seed: mut ref i64, n: i64, gap: i64) -> Vec[i64] {
    let mut arr: Vec[i64] = Vec.new();
    let mut x = 0;
    for _ in 0..n {
        x += 1 + next_random(mut seed) % gap;
        arr.push(x);
    }
    arr
}

// a value from 1 to 10^9
fn big(seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1
}

// up to n distinct values from 1 to 10^9, sorted, with a Fibonacci-like
// run of up to `run` values planted among them
fn scattered(seed: mut ref i64, n: i64, run: i64) -> Vec[i64] {
    let mut vals: Vec[i64] = Vec.new();
    let mut a = next_random(mut seed) % 1000 + 1;
    let mut b = a + next_random(mut seed) % 1000 + 1;
    vals.push(a);
    vals.push(b);
    while vals.len() < run and a + b <= 1000000000 {
        let next = a + b;
        a = b;
        b = next;
        vals.push(b);
    }
    while vals.len() < n {
        vals.push(big(mut seed));
    }
    vals.sort();
    let mut arr: Vec[i64] = Vec.new();
    for x in vals.iter() {
        if arr.len() == 0 or arr[arr.len() - 1] != *x {
            arr.push(*x);
        }
    }
    arr
}

fn show(arr: Vec[i64]) {
    let mut text: Vec[String] = Vec.new();
    for x in arr.iter() {
        text.push(f"{x}");
    }
    let shown = if text.len() > 12 { f"{text[0]}, {text[1]}, {text[2]}, ... {text[text.len() - 1]} ({text.len()} values)" } else { text.join(", ") };
    println(f"[{shown}] -> {len_longest_fib_subseq(arr)}");
}

fn main() {
    show([1, 2, 3, 4, 5, 6, 7, 8]);
    show([1, 3, 7, 11, 12, 14, 18]);
    show([1, 2, 3]);
    show([1, 2, 4]);
    show([2, 4, 7, 8, 9, 10, 14, 15, 18, 23, 32, 50]);
    show([1, 999999999, 1000000000]);
    show([1, 2, 1000000000]);
    show([5, 6, 11, 17, 28, 45, 73]);
    show([3, 4, 5, 7, 9, 12, 16, 21, 28, 37]);
    let mut fib: Vec[i64] = [1, 2];
    while fib[fib.len() - 1] + fib[fib.len() - 2] <= 1000000000 {
        fib.push(fib[fib.len() - 1] + fib[fib.len() - 2]);
    }
    show(fib);
    let mut all: Vec[i64] = Vec.new();
    for x in 1..1001 {
        all.push(x);
    }
    show(all);
    // small arrays, dense enough that runs are common
    let mut seed = 873;
    let mut total = 0;
    let mut none = 0;
    for k in 0..3000 {
        let arr = increasing(mut seed, k % 10 + 3, k % 4 + 1);
        let answer = len_longest_fib_subseq(arr);
        total += answer;
        if answer == 0 {
            none += 1;
        }
    }
    println(f"3000 arrays of 3 to 12 values: lengths sum to {total}, {none} with no run");
    // LeetCode's largest: 1000 values, dense or up to 10^9 with a run planted
    total = 0;
    let mut check = 0;
    for k in 0..4 {
        let arr = if k % 2 == 0 { increasing(mut seed, 1000, k / 2 + 2) } else { scattered(mut seed, 1000, k * 10) };
        let answer = len_longest_fib_subseq(arr);
        total += answer;
        check = (check * 131 + answer * 7 + arr[arr.len() - 1] % 1000) % 1000000007;
    }
    println(f"4 arrays of 1000 values: lengths sum to {total}, checksum {check}");
}
