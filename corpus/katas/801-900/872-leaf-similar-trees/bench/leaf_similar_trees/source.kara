// LeetCode #872: Leaf-Similar Trees -- bench program: the ★ arm (the
// leaves of each, collected by recursion) on 2,000 pairs of trees of up
// to 200 nodes, LeetCode's largest, half of them leaf-similar, each pair
// compared 50 times.
//
// A depth-first walk that goes left before right meets the leaves in
// order from left to right; each tree's walk pushes its leaves' values
// into a Vec, and the two trees are leaf-similar when the Vecs are equal.
// O(n1 + n2).

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf_similar(root1: Option[TreeNode], root2: Option[TreeNode]) -> bool {
    let mut first: Vec[i64] = Vec.new();
    let mut second: Vec[i64] = Vec.new();
    leaves(root1, mut first);
    leaves(root2, mut second);
    first == second
}

fn leaves(node: Option[TreeNode], out: mut ref Vec[i64]) {
    if let Some(n) = node {
        if n.left.is_none() and n.right.is_none() {
            out.push(n.val);
        } else {
            leaves(n.left, mut out);
            leaves(n.right, mut out);
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random tree of n nodes with values below limit: each new node hangs
// from a random node with a free side
fn random_tree(seed: mut ref i64, n: i64, limit: i64) -> Option[TreeNode] {
    let mut nodes: Vec[TreeNode] = Vec.new();
    for k in 0..n {
        let node = TreeNode { val: next_random(mut seed) % limit, left: None, right: None };
        if k > 0 {
            loop {
                let parent = nodes[next_random(mut seed) % nodes.len()];
                if next_random(mut seed) % 2 == 0 {
                    if parent.left.is_none() {
                        parent.left = Some(node);
                        break;
                    }
                } else if parent.right.is_none() {
                    parent.right = Some(node);
                    break;
                }
            }
        }
        nodes.push(node);
    }
    if n == 0 { None } else { Some(nodes[0]) }
}

// a random tree whose leaves, left to right, are vals[lo..hi]
fn tree_with_leaves(seed: mut ref i64, vals: Vec[i64], lo: i64, hi: i64, limit: i64) -> TreeNode {
    if hi - lo == 1 {
        return TreeNode { val: vals[lo], left: None, right: None };
    }
    let mid = lo + 1 + next_random(mut seed) % (hi - lo - 1);
    let left = tree_with_leaves(mut seed, vals, lo, mid, limit);
    let right = tree_with_leaves(mut seed, vals, mid, hi, limit);
    TreeNode { val: next_random(mut seed) % limit, left: Some(left), right: Some(right) }
}

fn main() {
    let mut seed = 872;
    let mut pairs: Vec[(Option[TreeNode], Option[TreeNode])] = Vec.new();
    for k in 0..2000 {
        let a = random_tree(mut seed, 200, 201);
        if k % 2 == 0 {
            let mut vals: Vec[i64] = Vec.new();
            leaves(a, mut vals);
            let b = tree_with_leaves(mut seed, vals, 0, vals.len(), 201);
            pairs.push((a, Some(b)));
        } else {
            pairs.push((a, random_tree(mut seed, 200, 201)));
        }
    }
    // a checksum of every second tree's leaves, so that each language is
    // seen to build the same trees
    let mut check = 0;
    for i in 0..pairs.len() {
        let mut vals: Vec[i64] = Vec.new();
        leaves(pairs[i].1, mut vals);
        for v in vals.iter() {
            check = (check * 31 + *v + 1) % 1000000007;
        }
    }
    let mut similar = 0;
    for _ in 0..50 {
        for i in 0..pairs.len() {
            if leaf_similar(pairs[i].0, pairs[i].1) {
                similar += 1;
            }
        }
    }
    println(f"100000 comparisons of 2000 pairs: {similar} leaf-similar, leaf checksum {check}");
}
