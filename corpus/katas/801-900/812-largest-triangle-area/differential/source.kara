// LeetCode #812: differential -- the four arms against the statement.
//
// Copies of the four arms, held to four properties on random points,
// against the shoelace area of every triangle.

// ---- ★ arm ----------------------------------------------------------

fn largest_triangle_area_star(points: Vec[(i64, i64)]) -> f64 {
    let n = points.len();
    let mut best = 0;
    for i in 0..n {
        for j in i + 1..n {
            for k in j + 1..n {
                let twice = twice_area_star(points[i], points[j], points[k]);
                if twice > best {
                    best = twice;
                }
            }
        }
    }
    best as f64 / 2.0
}

// Twice the area of the triangle abc.
fn twice_area_star(a: (i64, i64), b: (i64, i64), c: (i64, i64)) -> i64 {
    ((b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)).abs()
}

// ---- hull arm -------------------------------------------------------

fn largest_triangle_area_hull(points: Vec[(i64, i64)]) -> f64 {
    let hull = convex_hull_hull(points);
    let h = hull.len();
    let mut best = 0;
    for i in 0..h {
        for j in i + 1..h {
            for k in j + 1..h {
                best = best.max(twice_area_hull(hull[i], hull[j], hull[k]));
            }
        }
    }
    best as f64 / 2.0
}

// The corners of the convex hull, counterclockwise, with no point that
// lies on an edge; fewer than three when every point is on one line.
fn convex_hull_hull(points: Vec[(i64, i64)]) -> Vec[(i64, i64)] {
    let mut sorted = points.clone();
    sorted.sort();
    let mut hull: Vec[(i64, i64)] = Vec.new();
    // The lower chain left to right, then the upper chain right to left;
    // each pops its last corner while that corner does not turn left.
    for pass in 0..2 {
        let start = hull.len();
        for t in 0..sorted.len() {
            let p = if pass == 0 { sorted[t] } else { sorted[sorted.len() - 1 - t] };
            while hull.len() >= start + 2 and cross_hull(hull[hull.len() - 2], hull[hull.len() - 1], p) <= 0 {
                hull.pop();
            }
            hull.push(p);
        }
        // The chain's last point starts the next chain.
        hull.pop();
    }
    hull
}

// The cross product of ab and ac: positive when abc turns left.
fn cross_hull(a: (i64, i64), b: (i64, i64), c: (i64, i64)) -> i64 {
    (b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)
}

// Twice the area of the triangle abc.
fn twice_area_hull(a: (i64, i64), b: (i64, i64), c: (i64, i64)) -> i64 {
    cross_hull(a, b, c).abs()
}

// ---- rotating-calipers arm ------------------------------------------

fn largest_triangle_area_calipers(points: Vec[(i64, i64)]) -> f64 {
    let hull = convex_hull_calipers(points);
    let h = hull.len();
    let mut best = 0;
    for i in 0..h {
        let mut k = i + 2;
        for j in i + 1..h - 1 {
            if k <= j {
                k = j + 1;
            }
            while k + 1 < h and twice_area_calipers(hull[i], hull[j], hull[k + 1]) >= twice_area_calipers(hull[i], hull[j], hull[k]) {
                k += 1;
            }
            best = best.max(twice_area_calipers(hull[i], hull[j], hull[k]));
        }
    }
    best as f64 / 2.0
}

// The corners of the convex hull, counterclockwise, with no point that
// lies on an edge; fewer than three when every point is on one line.
fn convex_hull_calipers(points: Vec[(i64, i64)]) -> Vec[(i64, i64)] {
    let mut sorted = points.clone();
    sorted.sort();
    let mut hull: Vec[(i64, i64)] = Vec.new();
    // The lower chain left to right, then the upper chain right to left;
    // each pops its last corner while that corner does not turn left.
    for pass in 0..2 {
        let start = hull.len();
        for t in 0..sorted.len() {
            let p = if pass == 0 { sorted[t] } else { sorted[sorted.len() - 1 - t] };
            while hull.len() >= start + 2 and cross_calipers(hull[hull.len() - 2], hull[hull.len() - 1], p) <= 0 {
                hull.pop();
            }
            hull.push(p);
        }
        // The chain's last point starts the next chain.
        hull.pop();
    }
    hull
}

// The cross product of ab and ac: positive when abc turns left.
fn cross_calipers(a: (i64, i64), b: (i64, i64), c: (i64, i64)) -> i64 {
    (b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)
}

// Twice the area of the triangle abc.
fn twice_area_calipers(a: (i64, i64), b: (i64, i64), c: (i64, i64)) -> i64 {
    cross_calipers(a, b, c).abs()
}

// ---- iterator arm ---------------------------------------------------

fn largest_triangle_area_iter(points: Vec[(i64, i64)]) -> f64 {
    let n = points.len();
    let best = (0..n)
        .map(|i| {
            (i + 1..n)
                .map(|j| (j + 1..n).map(|k| twice_area_iter(points[i], points[j], points[k])).max().unwrap_or(0))
                .max()
                .unwrap_or(0)
        })
        .max()
        .unwrap_or(0);
    best as f64 / 2.0
}

// Twice the area of the triangle abc.
fn twice_area_iter(a: (i64, i64), b: (i64, i64), c: (i64, i64)) -> i64 {
    ((b.0 - a.0) * (c.1 - a.1) - (b.1 - a.1) * (c.0 - a.0)).abs()
}

// ---- the definition -------------------------------------------------------

// The largest area straight from the statement: every three points, each
// triangle's area by the shoelace formula, halved at the end.
fn largest_by_shoelace(points: Vec[(i64, i64)]) -> f64 {
    let mut best = 0;
    for i in 0..points.len() {
        for j in 0..points.len() {
            for k in 0..points.len() {
                let (x1, y1) = points[i];
                let (x2, y2) = points[j];
                let (x3, y3) = points[k];
                let twice = (x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2)).abs();
                best = best.max(twice);
            }
        }
    }
    best as f64 / 2.0
}

// ---- the properties -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, points: Vec[(i64, i64)]) -> f64 {
    if which == 0 {
        largest_triangle_area_star(points)
    } else if which == 1 {
        largest_triangle_area_hull(points)
    } else if which == 2 {
        largest_triangle_area_calipers(points)
    } else {
        largest_triangle_area_iter(points)
    }
}

// Adds (x, y) unless it is there already.
fn add_point(points: mut ref Vec[(i64, i64)], x: i64, y: i64) {
    for p in points.iter() {
        if p.0 == x and p.1 == y {
            return;
        }
    }
    points.push((x, y));
}

fn main() {
    let arms = 4;
    let mut seed = 8120;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut by_property = [0, 0, 0, 0];
    let cases = 1600;
    let mut flat = 0;
    for case in 0..cases {
        // kind 0: 3 to 12 points anywhere in a 9 by 9 square; kind 1: on
        // the edge of a square, so that the hull has points along its
        // edges; kind 2: on one line, one or two points off it or none;
        // kind 3: near a circle, so that most points are hull corners.
        let kind = case % 4;
        let n = 3 + next_random(mut seed) % 10;
        let mut points: Vec[(i64, i64)] = Vec.new();
        let mut tries = 0;
        while points.len() < n and tries < 1000 {
            tries += 1;
            let t = next_random(mut seed);
            if kind == 0 {
                add_point(mut points, t % 9 - 4, next_random(mut seed) % 9 - 4);
            } else if kind == 1 {
                let s = next_random(mut seed) % 9 - 4;
                let side = t % 4;
                if side == 0 { add_point(mut points, s, -4); }
                else if side == 1 { add_point(mut points, 4, s); }
                else if side == 2 { add_point(mut points, s, 4); }
                else { add_point(mut points, -4, s); }
            } else if kind == 2 {
                let s = t % 13 - 6;
                if points.len() + 2 < n or next_random(mut seed) % 3 != 0 {
                    add_point(mut points, s, 2 * s + 1);
                } else {
                    add_point(mut points, s, 2 * s + 1 + (next_random(mut seed) % 5 - 2));
                }
            } else {
                // The lattice points within one of radius 6 of the circle.
                let x = t % 15 - 7;
                let y = next_random(mut seed) % 15 - 7;
                let d = x * x + y * y;
                if d >= 30 and d <= 42 {
                    add_point(mut points, x, y);
                }
            }
        }
        if points.len() < 3 {
            add_point(mut points, 0, 0);
            add_point(mut points, 1, 0);
            add_point(mut points, 0, 1);
        }
        let want = largest_by_shoelace(points);
        if want == 0.0 {
            flat += 1;
        }
        // The same points reversed and rotated by one, shifted by (3, -2),
        // turned a quarter round, and doubled.
        let mut moved: Vec[(i64, i64)] = Vec.new();
        let mut turned: Vec[(i64, i64)] = Vec.new();
        let mut doubled: Vec[(i64, i64)] = Vec.new();
        let m = points.len();
        for t in 0..m {
            let (x, y) = points[(m - t) % m];
            moved.push((x + 3, y - 2));
            turned.push((-y, x));
            doubled.push((2 * x, 2 * y));
        }
        for which in 0..arms {
            // 1: the statement's answer.
            // 2: the same answer for the points reordered and shifted.
            // 3: the same answer for the points turned a quarter round.
            // 4: four times the answer for the points doubled.
            let ok = [
                arm(which, points.clone()) == want,
                arm(which, moved.clone()) == want,
                arm(which, turned.clone()) == want,
                arm(which, doubled.clone()) == 4.0 * want,
            ];
            for p in 0..4 {
                checks += 1;
                if not ok[p] {
                    fails[which] += 1;
                    by_property[p] += 1;
                }
            }
        }
    }
    let total = fails[0] + fails[1] + fails[2] + fails[3];
    println(f"{cases} cases ({flat} with every point on one line), {checks} checks over {arms} arms: {total} failures");
    println(f"by arm: star {fails[0]}, hull {fails[1]}, calipers {fails[2]}, iter {fails[3]}");
    println(f"by property: answer {by_property[0]}, reordered {by_property[1]}, turned {by_property[2]}, doubled {by_property[3]}");
}
