// LeetCode #882 bench: the ★ arm (Dijkstra with a priority queue) on 600
// graphs of LeetCode's sizes.

fn reachable_nodes(edges: Vec[Vec[i64]], max_moves: i64, n: i64) -> i64 {
    let mut adj: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        adj.push(Vec.new());
    }
    for e in 0..edges.len() {
        adj[edges[e][0]].push(e);
        adj[edges[e][1]].push(e);
    }
    let mut dist: Vec[i64] = Vec.filled(n, max_moves + 1);
    dist[0] = 0;
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    queue.push((0, 0));
    while let Some((d, u)) = queue.pop() {
        if d > dist[u] {
            continue;
        }
        for k in 0..adj[u].len() {
            let e = adj[u][k];
            let v = edges[e][0] + edges[e][1] - u;
            let next = d + edges[e][2] + 1;
            if next < dist[v] {
                dist[v] = next;
                queue.push((next, v));
            }
        }
    }
    let mut seen = 0;
    for u in 0..n {
        if dist[u] <= max_moves {
            seen += 1;
        }
    }
    for e in 0..edges.len() {
        let from_u = (max_moves - dist[edges[e][0]]).max(0);
        let from_v = (max_moves - dist[edges[e][1]]).max(0);
        seen += (from_u + from_v).min(edges[e][2]);
    }
    seen
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a value from 0 to limit - 1 (limit up to 10^9)
fn below(seed: mut ref i64, limit: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % limit
}

fn main() {
    let mut seed = 882;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..600 {
        // n nodes, each joined to the nodes three distinct offsets on,
        // each offset below n / 2 so that no pair repeats: 3n edges
        let n = 2000 + below(mut seed, 1001);
        let mut offsets: Vec[i64] = Vec.new();
        while offsets.len() < 3 {
            let d = 1 + below(mut seed, n / 2 - 1);
            if not offsets.contains(d) {
                offsets.push(d);
            }
        }
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for u in 0..n {
            for k in 0..3 {
                edges.push([u, (u + offsets[k]) % n, below(mut seed, 10001)]);
            }
        }
        let max_moves = below(mut seed, 200000);
        let reached = reachable_nodes(edges, max_moves, n);
        total += reached;
        check = (check * 131 + reached) % 1000000007;
    }
    println(f"600 graphs of up to 3000 nodes: {total} nodes reached, checksum {check}");
}
