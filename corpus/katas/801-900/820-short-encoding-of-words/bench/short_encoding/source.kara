// Benchmark for #820: Short Encoding of Words -- the ★ arm (a set of the words).
//
// Put every word in a set, take out every proper suffix of every word,
// and the words left each cost their length and a '#'. O(n L^2) for n
// words of up to L letters.

fn minimum_length_encoding(words: Vec[String]) -> i64 {
    let mut kept: Set[String] = Set.new();
    for word in words.iter() {
        kept.insert(word.clone());
    }
    for word in words.iter() {
        for k in 1..word.len() {
            kept.remove(word[k..]);
        }
    }
    let mut total = 0;
    for word in kept.iter() {
        total += word.len() + 1;
    }
    total
}

// ---- benchmark --------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, letters: i64, longest: i64) -> String {
    let mut word = String.new();
    let length = 1 + next_random(mut seed) % longest;
    for _ in 0..length {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

fn main() {
    // 64 lists of 2,000 words of up to 7 letters, LeetCode's largest, of
    // five letters so that many words end others, drawn once. Each round
    // answers the next list afresh.
    let count = 64;
    let rounds = 12000;
    let mut seed: i64 = 820;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..count {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..2000 {
            words.push(random_word(mut seed, 5, 7));
        }
        lists.push(words);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        let answer = minimum_length_encoding(lists[round % count]);
        total += answer;
        checksum = (checksum * 131 + answer) % 1000000007;
    }
    println(f"{rounds} rounds of {count} lists of 2000 words: total {total}, checksum {checksum}");
}
