// LeetCode #824: Goat Latin -- the ★ arm (split, growing suffix).
//
// Each word keeps its first letter if it is a vowel and otherwise moves it
// to the end, then gets "ma" and one more 'a' than the word before it. The
// run of 'a's is kept in a string that grows by one letter per word, so a
// word costs its own length plus its index: O(n + w^2) for n characters
// and w words, which the output's own size already is.

fn is_vowel(c: char) -> bool {
    "aeiouAEIOU".contains(c.to_string().as_str())
}

fn to_goat_latin(sentence: Str) -> String {
    let mut answer = String.new();
    let mut tail = String.new();
    for word in sentence.split(" ") {
        tail.push('a');
        if not answer.is_empty() {
            answer.push(' ');
        }
        let first = word.chars().next().unwrap();
        if is_vowel(first) {
            answer.push_str(word);
        } else {
            answer.push_str(word[1..]);
            answer.push(first);
        }
        answer.push_str("ma");
        answer.push_str(tail.as_str());
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"\"{s}\" -> \"{to_goat_latin(s)}\"");
}

fn random_sentence(seed: mut ref i64, words: i64, longest: i64) -> String {
    let letters = "aeiouAEIOUbcdfgBCDFGxyzXYZ";
    let mut s = String.new();
    for w in 0..words {
        if w > 0 {
            s.push(' ');
        }
        let length = 1 + next_random(mut seed) % longest;
        for _ in 0..length {
            let k = next_random(mut seed) % 26;
            s.push_str(letters[k..k + 1]);
        }
    }
    s
}

fn main() {
    show("I speak Goat Latin");
    show("The quick brown fox jumped over the lazy dog");
    show("a");
    show("b");
    show("A B");
    show("Each word consists of lowercase and uppercase letters only");
    show("aaa bbb ccc");
    show("U I O E A");
    // LeetCode's largest, 150 characters: 75 one-letter words.
    let mut seed = 824;
    let largest = random_sentence(mut seed, 75, 1);
    let goat = to_goat_latin(largest.as_str());
    println(f"75 one-letter words: {largest.len()} characters -> {goat.len()}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let words = 1 + next_random(mut seed) % 12;
        let s = random_sentence(mut seed, words, 8);
        let out = to_goat_latin(s.as_str());
        total += out.len();
        for b in out.bytes() {
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"300 random sentences: total {total}, checksum {check}");
}
