// LeetCode #884: Uncommon Words from Two Sentences -- a trie of counts.
//
// The words of both sentences are put into a trie, one node for every
// prefix met, each node with room for 26 children and a count of the
// words that end there. A depth-first walk taking the children in letter
// order then gives the words counted once, the uncommon ones, in
// alphabetical order. O(total length * 26) for the trie's room.

fn add(s: Str, next: mut ref Vec[i64], ends: mut ref Vec[i64]) {
    let bytes = s.bytes();
    let mut node = 0;
    for i in 0..bytes.len() {
        if bytes[i] == 32 {
            ends[node] += 1;
            node = 0;
        } else {
            let slot = node * 26 + (bytes[i] - 97) as i64;
            if next[slot] == 0 {
                next[slot] = ends.len();
                ends.push(0);
                for _ in 0..26 {
                    next.push(0);
                }
            }
            node = next[slot];
        }
    }
    ends[node] += 1;
}

fn collect(node: i64, word: mut ref String, next: Vec[i64], ends: Vec[i64], out: mut ref Vec[String]) {
    if ends[node] == 1 {
        out.push(word.clone());
    }
    for c in 0..26 {
        let child = next[node * 26 + c];
        if child != 0 {
            word.push((97 + c) as u8 as char);
            collect(child, mut word, next, ends, mut out);
            let _ = word.pop();
        }
    }
}

fn uncommon_from_sentences(s1: Str, s2: Str) -> Vec[String] {
    let mut next: Vec[i64] = Vec.filled(26, 0);
    let mut ends: Vec[i64] = [0];
    add(s1, mut next, mut ends);
    add(s2, mut next, mut ends);
    let mut out: Vec[String] = Vec.new();
    let mut word = String.new();
    collect(0, mut word, next, ends, mut out);
    out
}

// ---- test harness ----------------------------------------------------------

fn sorted_answer(s1: Str, s2: Str) -> Vec[String] {
    let mut words = uncommon_from_sentences(s1, s2);
    words.sort();
    words
}

fn text(words: Vec[String]) -> String {
    let mut out = "[";
    for i in 0..words.len() {
        if i > 0 {
            out = out + ", ";
        }
        out = out + words[i];
    }
    out + "]"
}

fn show(s1: Str, s2: Str) {
    let shown1 = if s1.len() > 40 { f"{s1.len()} characters" } else { f"\"{s1}\"" };
    let shown2 = if s2.len() > 40 { f"{s2.len()} characters" } else { f"\"{s2}\"" };
    println(f"s1 = {shown1}, s2 = {shown2} -> {text(sorted_answer(s1, s2))}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a sentence of at most `limit` characters, at least one word, of words of
// 1 to `longest` letters from the first `letters` of the alphabet, ending
// after each word with chance 1 in `stop`
fn sentence(seed: mut ref i64, limit: i64, longest: i64, letters: i64, stop: i64) -> String {
    let mut out = String.new();
    loop {
        let size = next_random(mut seed) % longest + 1;
        let mut word = String.new();
        for _ in 0..size {
            word.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        if out.len() == 0 {
            out = word;
        } else if out.len() + 1 + word.len() <= limit {
            out = out + " " + word;
        } else {
            return out;
        }
        if next_random(mut seed) % stop == 0 {
            return out;
        }
    }
}

fn fold(check: i64, words: Vec[String]) -> i64 {
    let mut c = check;
    for i in 0..words.len() {
        let bytes = words[i].bytes();
        for k in 0..bytes.len() {
            c = (c * 131 + bytes[k] as i64) % 1000000007;
        }
        c = (c * 131 + 44) % 1000000007;
    }
    (c * 131 + 59) % 1000000007
}

fn main() {
    show("this apple is sweet", "this apple is sour");
    show("apple apple", "banana");
    show("a", "b");
    show("a", "a");
    show("a a a", "b");
    show("x y z", "z y x");
    show("go to the store and buy the milk", "the milk is at the store");
    let mut long1 = "w";
    let mut long2 = "q";
    for i in 0..99 {
        long1 = long1 + " " + if i % 2 == 0 { "u" } else { "w" };
        long2 = long2 + " " + if i == 98 { "z" } else { "q" };
    }
    show(long1, long2);
    // small cases
    let mut seed = 884;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let s1 = sentence(mut seed, 20, 2, 3, 5);
        let s2 = sentence(mut seed, 20, 2, 3, 5);
        let words = sorted_answer(s1, s2);
        total += words.len();
        check = fold(check, words);
    }
    println(f"3000 pairs of up to 20 characters: {total} uncommon words, checksum {check}");
    // LeetCode's sizes: up to 200 characters
    total = 0;
    check = 0;
    for _ in 0..1000 {
        let s1 = sentence(mut seed, 200, 4, 5, 80);
        let s2 = sentence(mut seed, 200, 4, 5, 80);
        let words = sorted_answer(s1, s2);
        total += words.len();
        check = fold(check, words);
    }
    println(f"1000 pairs of up to 200 characters: {total} uncommon words, checksum {check}");
}
