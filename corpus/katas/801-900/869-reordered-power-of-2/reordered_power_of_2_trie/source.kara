// LeetCode #869: Reordered Power of 2 -- arranging the digits, guided by
// the powers' prefixes.
//
// The digits of n are placed one at a time, most significant first, each
// position taking a digit still unused; a prefix is extended only when
// some power of two with as many digits as n starts with it. The search
// succeeds when all the digits are placed. Every arrangement it builds is
// a prefix of a power of two, which never starts with 0, so no leading 0
// is ever placed. At most digits * (powers of that length) prefixes.

fn reordered_power_of_2(n: i64) -> bool {
    let digits = n.to_string();
    let length = digits.len();
    let mut prefixes: Set[String] = Set.new();
    let mut power = 1;
    for _ in 0..31 {
        let s = power.to_string();
        if s.len() == length {
            for end in 1..length + 1 {
                prefixes.insert(s[0..end].to_string());
            }
        }
        power *= 2;
    }
    let mut counts: Vec[i64] = Vec.filled(10, 0);
    for b in digits.bytes() {
        counts[(b - b'0') as i64] += 1;
    }
    place(String.new(), mut counts, length, prefixes)
}

// whether `prefix` extends, with the unused digits in `counts`, to a
// power of two of `length` digits
fn place(prefix: String, counts: mut ref Vec[i64], length: i64, prefixes: Set[String]) -> bool {
    if prefix.len() == length {
        return true;
    }
    for d in 0..10 {
        if counts[d] > 0 {
            let next = f"{prefix}{d}";
            if prefixes.contains(next) {
                counts[d] -= 1;
                let found = place(next, mut counts, length, prefixes);
                counts[d] += 1;
                if found {
                    return true;
                }
            }
        }
    }
    false
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random n from 1 to 10^9, LeetCode's range
fn random_n(seed: mut ref i64) -> i64 {
    let hi = next_random(mut seed);
    let lo = next_random(mut seed);
    (hi * 32768 + lo) % 1000000000 + 1
}

// the digits of x in a random order with no leading 0
fn shuffled(seed: mut ref i64, x: i64) -> i64 {
    let mut digits = x.to_string().bytes().to_vec();
    let len = digits.len();
    loop {
        for i in 1..len {
            let j = next_random(mut seed) % (i + 1);
            digits.swap(i, j);
        }
        if digits[0] != b'0' {
            break;
        }
    }
    let mut y = 0;
    for b in digits.iter() {
        y = y * 10 + (*b - b'0') as i64;
    }
    y
}

fn show(n: i64) {
    println(f"n = {n} -> {reordered_power_of_2(n)}");
}

fn main() {
    show(1);
    show(10);
    for n in [16, 61, 46, 64, 128, 821, 218, 24, 125, 1024, 2014, 4021, 536870912, 102356789, 1000000000, 999999999] {
        show(n);
    }
    // every n from 1 to 100000
    let mut count = 0;
    let mut check = 0;
    for n in 1..100001 {
        if reordered_power_of_2(n) {
            count += 1;
            check = (check * 31 + n) % 1000000007;
        }
    }
    println(f"n from 1 to 100000: {count} true, checksum {check}");
    // random n up to 10^9, and every power of two shuffled
    let mut seed = 869;
    count = 0;
    for _ in 0..20000 {
        if reordered_power_of_2(random_n(mut seed)) {
            count += 1;
        }
    }
    println(f"20000 random n up to 10^9: {count} true");
    count = 0;
    check = 0;
    let mut power = 1;
    for _ in 0..30 {
        for _ in 0..20 {
            let n = shuffled(mut seed, power);
            if reordered_power_of_2(n) {
                count += 1;
            }
            check = (check * 31 + n) % 1000000007;
        }
        power *= 2;
    }
    println(f"600 shuffled powers of two: {count} true, checksum {check}");
}
