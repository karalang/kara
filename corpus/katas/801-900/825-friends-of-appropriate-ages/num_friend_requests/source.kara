// LeetCode #825: Friends Of Appropriate Ages -- the ★ arm (counts by age).
//
// Whether x asks y depends only on their two ages, so the people are
// counted by age once and every pair of ages is tested with the
// statement's three conditions: each pair that passes adds one request
// from every person of the first age to every person of the second, but
// for a person and themself. O(n + A^2) for n people and A = 120 ages.

fn asks(x: i64, y: i64) -> bool {
    not (2 * y <= x + 14 or y > x or (y > 100 and x < 100))
}

fn num_friend_requests(ages: Vec[i64]) -> i64 {
    let mut count: Vec[i64] = Vec.filled(121, 0);
    for a in ages.iter() {
        count[a] += 1;
    }
    let mut requests = 0;
    for x in 1..121 {
        if count[x] == 0 {
            continue;
        }
        for y in 1..121 {
            if count[y] > 0 and asks(x, y) {
                requests += count[x] * count[y];
                if x == y {
                    requests -= count[x];
                }
            }
        }
    }
    requests
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(ages: Vec[i64]) {
    println(f"{ages} -> {num_friend_requests(ages.clone())}");
}

fn main() {
    show([16, 16]);
    show([16, 17, 18]);
    show([20, 30, 100, 110, 120]);
    show([1]);
    show([14, 14, 14]);
    show([15, 15]);
    show([99, 101, 100]);
    show([120, 60, 67, 68, 37, 38]);
    // LeetCode's largest, 20,000 people: random ages, and everyone 120.
    let mut seed = 825;
    let mut random: Vec[i64] = Vec.new();
    for _ in 0..20000 {
        random.push(1 + next_random(mut seed) % 120);
    }
    println(f"20000 random ages -> {num_friend_requests(random)}");
    println(f"20000 aged 120 -> {num_friend_requests(Vec.filled(20000, 120))}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let mut ages: Vec[i64] = Vec.new();
        for _ in 0..n {
            ages.push(1 + next_random(mut seed) % 120);
        }
        let r = num_friend_requests(ages);
        total += r;
        check = (check * 131 + r) % 1000000007;
    }
    println(f"300 random lists: total {total}, checksum {check}");
}
