// LeetCode #866: Prime Palindrome -- the odd-length palindromes in order.
//
// A palindrome with an even number of digits is a multiple of 11: its
// digits pair up as d * (10^i + 10^j) with i + j odd, and each such sum
// is. So 11 is the only prime among them. The odd-length palindromes
// come in increasing order from their first halves: the root r of d
// digits gives the palindrome of 2d - 1 digits that starts with r and
// ends with r reversed, the two sharing r's last digit, and a longer
// root gives a longer palindrome. Taking the roots 1, 2, 3, ... in turn,
// the first palindrome at least n that is prime is the answer, with 11
// put in its place between 7 and 101. Primality is trial division by
// the odd numbers up to the square root. About sqrt(answer) roots, each
// palindrome tested in O(sqrt(answer)).

fn prime_palindrome(n: i64) -> i64 {
    if n >= 8 and n <= 11 {
        return 11;
    }
    let mut root = 1;
    loop {
        let y = odd_palindrome(root);
        if y >= n and is_prime(y) {
            return y;
        }
        root += 1;
    }
}

// the palindrome that starts with `root` and ends with it reversed,
// sharing its last digit
fn odd_palindrome(root: i64) -> i64 {
    let mut y = root;
    let mut rest = root / 10;
    while rest > 0 {
        y = y * 10 + rest % 10;
        rest /= 10;
    }
    y
}

fn is_prime(x: i64) -> bool {
    if x < 2 {
        return false;
    }
    if x % 2 == 0 {
        return x == 2;
    }
    let mut d = 3;
    while d * d <= x {
        if x % d == 0 {
            return false;
        }
        d += 2;
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random n of 1 to 8 digits, each length as likely
fn random_n(seed: mut ref i64) -> i64 {
    let digits = 1 + next_random(mut seed) % 8;
    let mut low = 1;
    for _ in 1..digits {
        low *= 10;
    }
    let hi = next_random(mut seed);
    let lo = next_random(mut seed);
    low + (hi * 32768 + lo) % (9 * low)
}

fn digit_count_of(x: i64) -> i64 {
    let mut count = 1;
    let mut rest = x / 10;
    while rest > 0 {
        count += 1;
        rest /= 10;
    }
    count
}

fn show(n: i64) {
    println(f"n = {n} -> {prime_palindrome(n)}");
}

fn main() {
    show(6);
    show(8);
    show(13);
    for n in [1, 2, 11, 12, 102, 9990, 1000000, 9989899, 9989900, 100000000] {
        show(n);
    }
    // every n from 1 to 2000
    let mut total = 0;
    let mut check = 0;
    for n in 1..2001 {
        let p = prime_palindrome(n);
        total += p;
        check = (check * 31 + p) % 1000000007;
    }
    println(f"n from 1 to 2000: answers sum to {total}, checksum {check}");
    // random n of 1 to 8 digits
    let mut seed = 866;
    total = 0;
    check = 0;
    let mut longer = 0;
    for _ in 0..200 {
        let n = random_n(mut seed);
        let p = prime_palindrome(n);
        total += p;
        check = (check * 31 + p) % 1000000007;
        if digit_count_of(p) > digit_count_of(n) {
            longer += 1;
        }
    }
    println(f"200 random n of 1 to 8 digits: {longer} answers longer than n, answers sum to {total}, checksum {check}");
}
