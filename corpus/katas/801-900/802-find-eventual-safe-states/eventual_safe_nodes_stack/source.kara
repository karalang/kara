// LeetCode 802 — Find Eventual Safe States, depth first search with a
// stack of its own.
//
// The three-colour search without recursion: a stack of the nodes on
// the search, each with how many of its edges have been tried. A node
// whose edges are all tried is safe. Reaching a grey node, on the
// search now or found unsafe before, means every node on the stack
// leads to a cycle: they stay grey, which is kept as unsafe, and the
// stack is emptied. O(n + e).
fn eventual_safe_nodes(graph: Vec[Vec[i64]]) -> Vec[i64] {
    let n = graph.len();
    // 0 not seen yet, 1 grey (on the search or unsafe), 2 black (safe).
    let mut colour: Vec[i64] = Vec.new();
    for _ in 0..n {
        colour.push(0);
    }
    let mut stack: Vec[i64] = Vec.new();
    let mut tried: Vec[i64] = Vec.new();
    for start in 0..n {
        if colour[start] != 0 {
            continue;
        }
        colour[start] = 1;
        stack.push(start);
        tried.push(0);
        while stack.len() > 0 {
            let top = stack.len() - 1;
            let node = stack[top];
            if tried[top] == graph[node].len() {
                colour[node] = 2;
                stack.pop();
                tried.pop();
                continue;
            }
            let next = graph[node][tried[top]];
            tried[top] += 1;
            if colour[next] == 0 {
                colour[next] = 1;
                stack.push(next);
                tried.push(0);
            } else if colour[next] == 1 {
                stack.clear();
                tried.clear();
            }
        }
    }
    let mut safe: Vec[i64] = Vec.new();
    for a in 0..n {
        if colour[a] == 2 {
            safe.push(a);
        }
    }
    safe
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn text_list(list: Vec[i64]) -> String {
    let mut out = String.new();
    out.push_str("[");
    for i in 0..list.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{list[i]}");
    }
    out.push_str("]");
    out
}

fn text(graph: Vec[Vec[i64]]) -> String {
    let mut out = String.new();
    out.push_str("[");
    for i in 0..graph.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(text_list(graph[i]));
    }
    out.push_str("]");
    out
}

fn show(graph: Vec[Vec[i64]]) {
    println(f"{text(graph)} -> {text_list(eventual_safe_nodes(graph))}");
}

fn main() {
    show(vec![vec![1, 2], vec![2, 3], vec![5], vec![0], vec![5], vec![], vec![]]);
    show(vec![vec![1, 2, 3, 4], vec![1, 2], vec![3, 4], vec![0, 4], vec![]]);
    show(vec![vec![]]);
    show(vec![vec![0]]);
    show(vec![vec![1], vec![2], vec![0, 3], vec![]]);
    show(vec![vec![1], vec![2], vec![3], vec![4], vec![]]);
    show(vec![vec![1, 2], vec![3], vec![3], vec![3]]);
    let mut seed = 802;
    let mut count = 0;
    let mut check = 0;
    for i in 0..300 {
        // Each possible edge, a node to itself included, is there with a
        // chance of between 1 and 4 in 2n, so that a node has from half
        // an edge to two out on average.
        let n = 1 + next_random(mut seed) % 40;
        let chance = 1 + next_random(mut seed) % 4;
        let mut graph: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let mut out: Vec[i64] = Vec.new();
            for b in 0..n {
                if next_random(mut seed) % (2 * n) < chance {
                    out.push(b);
                }
            }
            graph.push(out);
        }
        let safe = eventual_safe_nodes(graph);
        count += safe.len();
        for v in safe.iter() {
            check = (check * 131 + v + 1) % 1000000007;
        }
        check = (check * 131 + i) % 1000000007;
    }
    println(f"300 random graphs: {count} safe nodes, checksum {check}");
}
