// LeetCode 802 — Find Eventual Safe States, to a fixed point.
//
// Start with no node known safe and sweep the nodes over and over,
// marking a node safe once every edge out of it leads to a node already
// marked, until a sweep marks nothing new. A node with no edges out is
// marked in the first sweep, and a node leading into a cycle never is.
// O(n · e) at worst, one sweep per step of the longest chain.
fn eventual_safe_nodes(graph: Vec[Vec[i64]]) -> Vec[i64] {
    let n = graph.len();
    let mut safe: Vec[bool] = Vec.new();
    for _ in 0..n {
        safe.push(false);
    }
    let mut changed = true;
    while changed {
        changed = false;
        for a in 0..n {
            if safe[a] {
                continue;
            }
            let mut all = true;
            for b in graph[a].iter() {
                if not safe[b] {
                    all = false;
                }
            }
            if all {
                safe[a] = true;
                changed = true;
            }
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for a in 0..n {
        if safe[a] {
            out.push(a);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn text_list(list: Vec[i64]) -> String {
    let mut out = String.new();
    out.push_str("[");
    for i in 0..list.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{list[i]}");
    }
    out.push_str("]");
    out
}

fn text(graph: Vec[Vec[i64]]) -> String {
    let mut out = String.new();
    out.push_str("[");
    for i in 0..graph.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(text_list(graph[i]));
    }
    out.push_str("]");
    out
}

fn show(graph: Vec[Vec[i64]]) {
    println(f"{text(graph)} -> {text_list(eventual_safe_nodes(graph))}");
}

fn main() {
    show(vec![vec![1, 2], vec![2, 3], vec![5], vec![0], vec![5], vec![], vec![]]);
    show(vec![vec![1, 2, 3, 4], vec![1, 2], vec![3, 4], vec![0, 4], vec![]]);
    show(vec![vec![]]);
    show(vec![vec![0]]);
    show(vec![vec![1], vec![2], vec![0, 3], vec![]]);
    show(vec![vec![1], vec![2], vec![3], vec![4], vec![]]);
    show(vec![vec![1, 2], vec![3], vec![3], vec![3]]);
    let mut seed = 802;
    let mut count = 0;
    let mut check = 0;
    for i in 0..300 {
        // Each possible edge, a node to itself included, is there with a
        // chance of between 1 and 4 in 2n, so that a node has from half
        // an edge to two out on average.
        let n = 1 + next_random(mut seed) % 40;
        let chance = 1 + next_random(mut seed) % 4;
        let mut graph: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let mut out: Vec[i64] = Vec.new();
            for b in 0..n {
                if next_random(mut seed) % (2 * n) < chance {
                    out.push(b);
                }
            }
            graph.push(out);
        }
        let safe = eventual_safe_nodes(graph);
        count += safe.len();
        for v in safe.iter() {
            check = (check * 131 + v + 1) % 1000000007;
        }
        check = (check * 131 + i) % 1000000007;
    }
    println(f"300 random graphs: {count} safe nodes, checksum {check}");
}
