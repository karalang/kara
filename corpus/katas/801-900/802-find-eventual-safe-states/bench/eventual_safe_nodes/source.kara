// LeetCode 802 — Find Eventual Safe States: the bench.
//
// 16 graphs of 10,000 nodes, LeetCode's most, are made once. Each node
// has 0 to 4 edges out, nearly all to one of the 50 nodes after it, and
// one edge in 1,000 back to one of the 50 before it, which makes a
// cycle there; about half the nodes come out safe. Each of the rounds
// finds the safe nodes of the next graph with the ★ arm.
fn eventual_safe_nodes(graph: Vec[Vec[i64]]) -> Vec[i64] {
    let n = graph.len();
    // 0 not seen yet, 1 grey (on the search or unsafe), 2 black (safe).
    let mut colour: Vec[i64] = Vec.new();
    for _ in 0..n {
        colour.push(0);
    }
    let mut safe: Vec[i64] = Vec.new();
    for node in 0..n {
        if is_safe(graph, node, mut colour) {
            safe.push(node);
        }
    }
    safe
}

fn is_safe(graph: Vec[Vec[i64]], node: i64, colour: mut ref Vec[i64]) -> bool {
    if colour[node] != 0 {
        return colour[node] == 2;
    }
    colour[node] = 1;
    for next in graph[node].iter() {
        if not is_safe(graph, next, mut colour) {
            return false;
        }
    }
    colour[node] = 2;
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 10000;
    let mut seed = 802;
    let mut graphs: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..16 {
        let mut graph: Vec[Vec[i64]] = Vec.new();
        for a in 0..n {
            let mut picked: Vec[i64] = Vec.new();
            let edges = next_random(mut seed) % 5;
            for _ in 0..edges {
                let b = if next_random(mut seed) % 1000 == 0 {
                    (a - 1 - next_random(mut seed) % 50).max(0)
                } else {
                    a + 1 + next_random(mut seed) % 50
                };
                if b < n {
                    picked.push(b);
                }
            }
            // In increasing order with no edge twice, as LeetCode gives.
            picked.sort();
            let mut out: Vec[i64] = Vec.new();
            for b in picked.iter() {
                if out.len() == 0 or out[out.len() - 1] != b {
                    out.push(b);
                }
            }
            graph.push(out);
        }
        graphs.push(graph);
    }
    let rounds = 4000;
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        let safe = eventual_safe_nodes(graphs[r % 16]);
        total += safe.len();
        check = (check * 131 + safe.len() + safe[safe.len() / 2]) % 1000000007;
    }
    println(f"{rounds} rounds of {n} nodes: {total} safe nodes in all, checksum {check}");
}
