// LeetCode 802 — Find Eventual Safe States, peeling from the ends.
//
// A node with no edges out is safe, and so is a node all of whose edges
// lead to safe nodes. Count each node's edges out and turn every edge
// round; then take safe nodes off a queue, starting from those with no
// edges out, and for each one count down the edges out of the nodes
// that point at it. A node whose count reaches zero is safe. Nodes on or
// leading into a cycle never reach zero. O(n + e).
fn eventual_safe_nodes(graph: Vec[Vec[i64]]) -> Vec[i64] {
    let n = graph.len();
    let mut into: Vec[Vec[i64]] = Vec.new();
    let mut left: Vec[i64] = Vec.new();
    for _ in 0..n {
        into.push(Vec.new());
    }
    for a in 0..n {
        left.push(graph[a].len());
        for b in graph[a].iter() {
            into[b].push(a);
        }
    }
    let mut queue: Vec[i64] = Vec.new();
    for a in 0..n {
        if left[a] == 0 {
            queue.push(a);
        }
    }
    let mut safe: Vec[bool] = Vec.new();
    for _ in 0..n {
        safe.push(false);
    }
    let mut head = 0;
    while head < queue.len() {
        let node = queue[head];
        head += 1;
        safe[node] = true;
        for before in into[node].iter() {
            left[before] -= 1;
            if left[before] == 0 {
                queue.push(before);
            }
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for a in 0..n {
        if safe[a] {
            out.push(a);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn text_list(list: Vec[i64]) -> String {
    let mut out = String.new();
    out.push_str("[");
    for i in 0..list.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{list[i]}");
    }
    out.push_str("]");
    out
}

fn text(graph: Vec[Vec[i64]]) -> String {
    let mut out = String.new();
    out.push_str("[");
    for i in 0..graph.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(text_list(graph[i]));
    }
    out.push_str("]");
    out
}

fn show(graph: Vec[Vec[i64]]) {
    println(f"{text(graph)} -> {text_list(eventual_safe_nodes(graph))}");
}

fn main() {
    show(vec![vec![1, 2], vec![2, 3], vec![5], vec![0], vec![5], vec![], vec![]]);
    show(vec![vec![1, 2, 3, 4], vec![1, 2], vec![3, 4], vec![0, 4], vec![]]);
    show(vec![vec![]]);
    show(vec![vec![0]]);
    show(vec![vec![1], vec![2], vec![0, 3], vec![]]);
    show(vec![vec![1], vec![2], vec![3], vec![4], vec![]]);
    show(vec![vec![1, 2], vec![3], vec![3], vec![3]]);
    let mut seed = 802;
    let mut count = 0;
    let mut check = 0;
    for i in 0..300 {
        // Each possible edge, a node to itself included, is there with a
        // chance of between 1 and 4 in 2n, so that a node has from half
        // an edge to two out on average.
        let n = 1 + next_random(mut seed) % 40;
        let chance = 1 + next_random(mut seed) % 4;
        let mut graph: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let mut out: Vec[i64] = Vec.new();
            for b in 0..n {
                if next_random(mut seed) % (2 * n) < chance {
                    out.push(b);
                }
            }
            graph.push(out);
        }
        let safe = eventual_safe_nodes(graph);
        count += safe.len();
        for v in safe.iter() {
            check = (check * 131 + v + 1) % 1000000007;
        }
        check = (check * 131 + i) % 1000000007;
    }
    println(f"300 random graphs: {count} safe nodes, checksum {check}");
}
