// LeetCode #887: Super Egg Drop -- the floors a number of moves can cover.
//
// Turn the question round: with m moves and k eggs, how many floors can
// be told apart? The first drop goes from some floor; if the egg breaks,
// m - 1 moves and k - 1 eggs settle the floors below it, and if not, m -
// 1 moves and k eggs settle those above. So floors(m, k) = floors(m - 1,
// k - 1) + floors(m - 1, k) + 1, and the answer is the least m with
// floors(m, k) >= n. One row per move, k entries each. O(k * answer).

fn super_egg_drop(k: i64, n: i64) -> i64 {
    let mut floors: Vec[i64] = Vec.filled(k + 1, 0);
    let mut moves = 0;
    while floors[k] < n {
        moves += 1;
        let mut eggs = k;
        while eggs >= 1 {
            floors[eggs] = floors[eggs - 1] + floors[eggs] + 1;
            eggs -= 1;
        }
    }
    moves
}

// ---- test harness ----------------------------------------------------------

fn show(k: i64, n: i64) {
    println(f"k = {k}, n = {n} -> {super_egg_drop(k, n)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(1, 2);
    show(2, 6);
    show(3, 14);
    show(1, 1);
    show(1, 10000);
    show(2, 10000);
    show(3, 10000);
    show(100, 10000);
    show(14, 10000);
    show(13, 8191);
    show(13, 8192);
    // small cases
    let mut seed = 887;
    let mut total = 0;
    for _ in 0..3000 {
        let k = next_random(mut seed) % 5 + 1;
        let n = next_random(mut seed) % 80 + 1;
        total += super_egg_drop(k, n);
    }
    println(f"3000 cases of up to 5 eggs and 80 floors: {total} moves");
    // LeetCode's sizes, with up to 12 eggs
    total = 0;
    let mut check = 0;
    for _ in 0..20 {
        let k = next_random(mut seed) % 12 + 1;
        let n = next_random(mut seed) % 10000 + 1;
        let moves = super_egg_drop(k, n);
        total += moves;
        check = (check * 131 + moves) % 1000000007;
    }
    println(f"20 cases of up to 12 eggs and 10000 floors: {total} moves, checksum {check}");
}
