// LeetCode #887 bench: the ★ arm (the floors a number of moves can cover)
// on 30000 cases of 2 to 9 eggs and up to 10^9 floors.

fn super_egg_drop(k: i64, n: i64) -> i64 {
    let mut floors: Vec[i64] = Vec.filled(k + 1, 0);
    let mut moves = 0;
    while floors[k] < n {
        moves += 1;
        let mut eggs = k;
        while eggs >= 1 {
            floors[eggs] = floors[eggs - 1] + floors[eggs] + 1;
            eggs -= 1;
        }
    }
    moves
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 887;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..30000 {
        let k = 2 + next_random(mut seed) % 8;
        let n = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000;
        let moves = super_egg_drop(k, n);
        total += moves;
        check = (check * 131 + moves) % 1000000007;
    }
    println(f"30000 cases of 2 to 9 eggs and up to 10^9 floors: {total} moves, checksum {check}");
}
