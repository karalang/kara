// LeetCode 804 — Unique Morse Code Words, as numbers.
//
// A word of at most 12 letters is at most 48 dots and dashes, so its
// Morse code fits in a number: start from 1, and for each dot or dash
// double it and add 0 or 1. The leading 1 keeps codes of different
// lengths apart. Sort the numbers and count each run of equal ones once.
// O(total letters + words · log words).
fn unique_morse_representations(words: Vec[String]) -> i64 {
    let codes = [".-", "-...", "-.-.", "-..", ".", "..-.", "--.", "....", "..", ".---", "-.-", ".-..", "--", "-.", "---", ".--.", "--.-", ".-.", "...", "-", "..-", "...-", ".--", "-..-", "-.--", "--.."];
    let mut keys: Vec[i64] = Vec.new();
    for word in words.iter() {
        let mut key = 1;
        for b in word.bytes() {
            for s in codes[b - 97].bytes() {
                key = key * 2 + if s == 45 { 1 } else { 0 };
            }
        }
        keys.push(key);
    }
    keys.sort();
    let mut count = 0;
    for i in 0..keys.len() {
        if i == 0 or keys[i] != keys[i - 1] {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(words: Vec[String]) {
    let mut out = String.new();
    out.push_str("[");
    for i in 0..words.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"\"{words[i]}\"");
    }
    out.push_str("]");
    println(f"{out} -> {unique_morse_representations(words)}");
}

fn list(text: String) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for word in text.split(" ") {
        words.push(word.to_string());
    }
    words
}

fn main() {
    show(list("gin zen gig msg"));
    show(list("a"));
    show(list("a et"));
    show(list("n te tn"));
    show(list("s eee ie ei i e"));
    show(list("abcdefghijkl mnopqrstuvwx yz"));
    show(list("zzzzzzzzzzzz qqqqqqqqqqqq zzzzzzzzzzzz"));
    let mut seed = 804;
    let mut total = 0;
    let mut check = 0;
    for i in 0..300 {
        // Up to 30 words of 1 to 4 letters from "eitamn", whose codes
        // are one or two dots and dashes, so that many words share a
        // code.
        let count = 1 + next_random(mut seed) % 30;
        let mut words: Vec[String] = Vec.new();
        for _ in 0..count {
            let length = 1 + next_random(mut seed) % 4;
            let mut word = String.new();
            for _ in 0..length {
                word.push_str(["e", "i", "t", "a", "m", "n"][next_random(mut seed) % 6]);
            }
            words.push(word);
        }
        let k = unique_morse_representations(words);
        total += k;
        check = (check * 131 + k + i) % 1000000007;
    }
    println(f"300 random lists: {total} codes in all, checksum {check}");
}
