// LeetCode #844: differential -- the four arms against the statement.
//
// Copies of the four arms, held to five properties on random strings,
// against the statement read literally.

// ---- ★ arm ----------------------------------------------------------

// the index of the last surviving character at or before `i`, or -1
fn next_kept_star(s: Slice[u8], i: i64) -> i64 {
    let mut i = i;
    let mut skip = 0;
    while i >= 0 {
        if s[i] == 35 {
            skip += 1;
        } else if skip > 0 {
            skip -= 1;
        } else {
            return i;
        }
        i -= 1;
    }
    -1
}

fn backspace_compare_star(s: String, t: String) -> bool {
    let a = s.bytes();
    let b = t.bytes();
    let mut i = next_kept_star(a, a.len() - 1);
    let mut j = next_kept_star(b, b.len() - 1);
    while i >= 0 and j >= 0 {
        if a[i] != b[j] {
            return false;
        }
        i = next_kept_star(a, i - 1);
        j = next_kept_star(b, j - 1);
    }
    i < 0 and j < 0
}

// ---- stack arm ------------------------------------------------------

fn typed_stack(s: String) -> Vec[char] {
    let mut stack: Vec[char] = Vec.new();
    for c in s.chars() {
        if c == '#' {
            stack.pop();
        } else {
            stack.push(c);
        }
    }
    stack
}

fn backspace_compare_stack(s: String, t: String) -> bool {
    typed_stack(s) == typed_stack(t)
}

// ---- fold arm -------------------------------------------------------

fn text_fold(s: String) -> String {
    s.chars().fold(String.new(), |acc, c| {
        let mut out = acc;
        if c == '#' {
            out.pop();
        } else {
            out.push(c);
        }
        out
    })
}

fn backspace_compare_fold(s: String, t: String) -> bool {
    text_fold(s) == text_fold(t)
}

// ---- reversed arm ---------------------------------------------------

fn survivors_reversed(s: String) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    let mut pending = 0;
    for c in s.chars().rev() {
        if c == '#' {
            pending += 1;
        } else if pending > 0 {
            pending -= 1;
        } else {
            out.push(c);
        }
    }
    out
}

fn backspace_compare_reversed(s: String, t: String) -> bool {
    survivors_reversed(s) == survivors_reversed(t)
}

// ---- the statement ----------------------------------------------------------

// The text a string leaves, read literally off the statement: while a
// '#' remains, the first one is deleted together with the character
// just before it, if there is one.
fn statement_text(s: String) -> String {
    let mut cs: Vec[char] = s.chars().collect();
    loop {
        let mut at = -1;
        for i in 0..cs.len() {
            if at < 0 and cs[i] == '#' {
                at = i;
            }
        }
        if at < 0 {
            break;
        }
        cs.remove(at);
        if at > 0 {
            cs.remove(at - 1);
        }
    }
    let mut out = String.new();
    for c in cs {
        out.push(c);
    }
    out
}

fn compare(arm: i64, s: String, t: String) -> bool {
    if arm == 0 {
        backspace_compare_star(s, t)
    } else if arm == 1 {
        backspace_compare_stack(s, t)
    } else if arm == 2 {
        backspace_compare_fold(s, t)
    } else {
        backspace_compare_reversed(s, t)
    }
}

// ---- harness ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_text(seed: mut ref i64, n: i64, k: i64, hashes: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        if next_random(mut seed) % 10 < hashes {
            s.push('#');
        } else {
            s.push((97 + next_random(mut seed) % k) as u8 as char);
        }
    }
    s
}

// `s` with `extra` letters each followed by a '#' put in at random places
fn padded(seed: mut ref i64, s: String, k: i64, extra: i64) -> String {
    let mut cs: Vec[char] = s.chars().collect();
    for _ in 0..extra {
        let at = next_random(mut seed) % (cs.len() + 1);
        cs.insert(at, '#');
        cs.insert(at, (97 + next_random(mut seed) % k) as u8 as char);
    }
    let mut out = String.new();
    for c in cs {
        out.push(c);
    }
    out
}

fn main() {
    let names = ["star", "stack", "fold", "reversed"];
    let properties = ["answer", "swapped", "padded", "hashes first", "letter after"];
    let mut by_arm: Vec[i64] = Vec.filled(4, 0);
    let mut by_property: Vec[i64] = Vec.filled(5, 0);
    let mut failures = 0;
    let mut checks = 0;
    let mut equal = 0;
    let mut seed = 844;
    for case in 0..1600 {
        let kind = case / 400;
        let k = 1 + next_random(mut seed) % 3;
        let (s, t) = if kind == 0 {
            // two short random strings
            let hashes = next_random(mut seed) % 6;
            let s = random_text(mut seed, 1 + next_random(mut seed) % 12, k, hashes);
            let t = random_text(mut seed, 1 + next_random(mut seed) % 12, k, hashes);
            (s, t)
        } else if kind == 1 {
            // a string and the same with letters put in and undone, one
            // character then changed once in three
            let s = random_text(mut seed, 1 + next_random(mut seed) % 20, k, next_random(mut seed) % 5);
            let mut t = padded(mut seed, s, k, next_random(mut seed) % 5);
            if next_random(mut seed) % 3 == 0 {
                let mut cs: Vec[char] = t.chars().collect();
                let at = next_random(mut seed) % cs.len();
                cs[at] = if next_random(mut seed) % 2 == 0 { '#' } else { 'a' };
                t = String.new();
                for c in cs {
                    t.push(c);
                }
            }
            (s, t)
        } else if kind == 2 {
            // mostly backspaces
            let hashes = 5 + next_random(mut seed) % 5;
            let s = random_text(mut seed, 1 + next_random(mut seed) % 20, k, hashes);
            let t = random_text(mut seed, 1 + next_random(mut seed) % 20, k, hashes);
            (s, t)
        } else {
            // long strings, up to LeetCode's 200 characters, the second
            // made from the first
            let s = random_text(mut seed, 100 + next_random(mut seed) % 81, k, next_random(mut seed) % 6);
            let t = padded(mut seed, s, k, next_random(mut seed) % 11);
            (s, t)
        };
        let want = statement_text(s) == statement_text(t);
        if want {
            equal += 1;
        }
        let hashes = "#".repeat(1 + next_random(mut seed) % 3);
        let extra = padded(mut seed, s, k, 1 + next_random(mut seed) % 3);
        let c = (97 + next_random(mut seed) % k) as u8 as char;
        for arm in 0..4 {
            let got = compare(arm, s, t);
            let oks = [
                got == want,
                compare(arm, t, s) == got,
                compare(arm, s, extra) and compare(arm, extra, t) == got,
                compare(arm, f"{hashes}{s}", t) == got and compare(arm, s, f"{hashes}{t}") == got,
                compare(arm, f"{s}{c}", f"{t}{c}") == got and compare(arm, f"{s}{c}#", t) == got,
            ];
            for q in 0..5 {
                checks += 1;
                if not oks[q] {
                    failures += 1;
                    by_arm[arm] += 1;
                    by_property[q] += 1;
                    if failures <= 5 {
                        println(f"FAIL {names[arm]} {properties[q]}: \"{s}\" vs \"{t}\" -> {got}, want {want}");
                    }
                }
            }
        }
    }
    println(f"1600 cases, {equal} equal, {checks} checks over 4 arms: {failures} failures");
    println(f"by arm: star {by_arm[0]}, stack {by_arm[1]}, fold {by_arm[2]}, reversed {by_arm[3]}");
    println(f"by property: answer {by_property[0]}, swapped {by_property[1]}, padded {by_property[2]}, hashes first {by_property[3]}, letter after {by_property[4]}");
}
