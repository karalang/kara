// Benchmark for #844: Backspace String Compare -- the ★ arm (two pointers
// from the back).
//
// Reading each string from the back, a count of pending backspaces says
// how many of the next characters to skip; each step finds the next
// surviving character of both strings and compares them, and the
// strings are equal when they run out together.

// the index of the last surviving character at or before `i`, or -1
fn next_kept(s: Slice[u8], i: i64) -> i64 {
    let mut i = i;
    let mut skip = 0;
    while i >= 0 {
        if s[i] == 35 {
            skip += 1;
        } else if skip > 0 {
            skip -= 1;
        } else {
            return i;
        }
        i -= 1;
    }
    -1
}

fn backspace_compare(s: String, t: String) -> bool {
    let a = s.bytes();
    let b = t.bytes();
    let mut i = next_kept(a, a.len() - 1);
    let mut j = next_kept(b, b.len() - 1);
    while i >= 0 and j >= 0 {
        if a[i] != b[j] {
            return false;
        }
        i = next_kept(a, i - 1);
        j = next_kept(b, j - 1);
    }
    i < 0 and j < 0
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 pairs drawn once, each string at most LeetCode's 200
    // characters: the first is 120 characters, a '#' with chance 3 in
    // 10 and otherwise one of the first 2, 3 or 4 letters; the second is
    // the first with 40 letters each followed by a '#' put in at random
    // places, and in every other pair one character then changed. Each
    // round compares the next pair.
    let count = 64;
    let rounds = 3500000;
    let mut seed: i64 = 844;
    let mut firsts: Vec[String] = Vec.new();
    let mut seconds: Vec[String] = Vec.new();
    for g in 0..count {
        let k = 2 + g % 3;
        let mut cs: Vec[char] = Vec.new();
        for _ in 0..120 {
            if next_random(mut seed) % 10 < 3 {
                cs.push('#');
            } else {
                cs.push((97 + next_random(mut seed) % k) as u8 as char);
            }
        }
        let mut first = String.new();
        for c in cs.iter() {
            first.push(*c);
        }
        for _ in 0..40 {
            let at = next_random(mut seed) % (cs.len() + 1);
            cs.insert(at, '#');
            cs.insert(at, (97 + next_random(mut seed) % k) as u8 as char);
        }
        if g % 2 == 1 {
            let at = next_random(mut seed) % cs.len();
            cs[at] = if cs[at] == '#' { 'a' } else { '#' };
        }
        let mut second = String.new();
        for c in cs.iter() {
            second.push(*c);
        }
        firsts.push(first);
        seconds.push(second);
    }
    let mut equal = 0;
    let mut checksum = 0;
    for round in 0..rounds {
        let g = round % count;
        let same = backspace_compare(firsts[g], seconds[g]);
        if same {
            equal += 1;
        }
        checksum = (checksum * 31 + if same { round % 1000 } else { 7 }) % 1000000007;
    }
    println(f"{rounds} rounds of {count} pairs: {equal} equal, checksum {checksum}");
}
