// LeetCode #874: Walking Robot Simulation -- differential test of the
// five arms against the statement read literally, with six properties.
//
// The statement: a robot starts at (0, 0) facing north and follows
// commands: -2 turns it 90 degrees left, -1 turns it 90 degrees right, and
// 1 <= k <= 9 moves it forward k units, one unit at a time. A unit step
// onto an obstacle is not taken and the rest of that move is skipped.
// Return the largest squared distance from the origin the robot reaches.

// ---- the ★ arm: one square at a time against a set of obstacles -----------
fn star_robot_sim(commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    let mut blocked: Set[i64] = Set.new();
    for o in obstacles.iter() {
        blocked.insert(star_square(o[0], o[1]));
    }
    let dx = [0, 1, 0, -1];
    let dy = [1, 0, -1, 0];
    let mut facing = 0;
    let mut x = 0;
    let mut y = 0;
    let mut best = 0;
    for c in commands.iter() {
        if *c == -2 {
            facing = (facing + 3) % 4;
        } else if *c == -1 {
            facing = (facing + 1) % 4;
        } else {
            for _ in 0..*c {
                let nx = x + dx[facing];
                let ny = y + dy[facing];
                if blocked.contains(star_square(nx, ny)) {
                    break;
                }
                x = nx;
                y = ny;
                best = best.max(x * x + y * y);
            }
        }
    }
    best
}

// a square as one number; the robot stays within 10^5 of the origin
fn star_square(x: i64, y: i64) -> i64 {
    (x + 200000) * 400001 + (y + 200000)
}

// ---- the pairs arm: the direction a vector turned by rotation -------------
fn pairs_robot_sim(commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    let mut blocked: Set[(i64, i64)] = Set.new();
    for o in obstacles.iter() {
        blocked.insert((o[0], o[1]));
    }
    let mut dx = 0;
    let mut dy = 1;
    let mut x = 0;
    let mut y = 0;
    let mut best = 0;
    for c in commands.iter() {
        if *c == -2 {
            let turned = (-dy, dx);
            dx = turned.0;
            dy = turned.1;
        } else if *c == -1 {
            let turned = (dy, -dx);
            dx = turned.0;
            dy = turned.1;
        } else {
            for _ in 0..*c {
                if blocked.contains((x + dx, y + dy)) {
                    break;
                }
                x += dx;
                y += dy;
                best = best.max(x * x + y * y);
            }
        }
    }
    best
}

// ---- the facing arm: the direction as an enum -----------------------------
enum Facing {
    North,
    East,
    South,
    West,
}

fn facing_left(f: Facing) -> Facing {
    match f {
        Facing.North => Facing.West,
        Facing.West => Facing.South,
        Facing.South => Facing.East,
        Facing.East => Facing.North,
    }
}

fn facing_right(f: Facing) -> Facing {
    match f {
        Facing.North => Facing.East,
        Facing.East => Facing.South,
        Facing.South => Facing.West,
        Facing.West => Facing.North,
    }
}

fn facing_step(f: Facing, x: i64, y: i64) -> (i64, i64) {
    match f {
        Facing.North => (x, y + 1),
        Facing.East => (x + 1, y),
        Facing.South => (x, y - 1),
        Facing.West => (x - 1, y),
    }
}

fn facing_robot_sim(commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    let mut blocked: Set[(i64, i64)] = Set.new();
    for o in obstacles.iter() {
        blocked.insert((o[0], o[1]));
    }
    let mut facing = Facing.North;
    let mut at = (0, 0);
    let mut best = 0;
    for c in commands.iter() {
        match *c {
            -2 => facing = facing_left(facing),
            -1 => facing = facing_right(facing),
            k => {
                for _ in 0..k {
                    let next = facing_step(facing, at.0, at.1);
                    if blocked.contains(next) {
                        break;
                    }
                    at = next;
                    best = best.max(at.0 * at.0 + at.1 * at.1);
                }
            }
        }
    }
    best
}

// ---- the jump arm: each move in one jump, by binary search ----------------
fn jump_robot_sim(commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    let mut columns: Map[i64, Vec[i64]] = Map.new();
    let mut rows: Map[i64, Vec[i64]] = Map.new();
    for o in obstacles.iter() {
        if not columns.contains_key(o[0]) {
            columns.insert(o[0], Vec.new());
        }
        columns.get_mut(o[0]).unwrap().push(o[1]);
        if not rows.contains_key(o[1]) {
            rows.insert(o[1], Vec.new());
        }
        rows.get_mut(o[1]).unwrap().push(o[0]);
    }
    for (_, ys) in columns.iter_mut() {
        ys.sort();
    }
    for (_, xs) in rows.iter_mut() {
        xs.sort();
    }
    let empty: Vec[i64] = Vec.new();
    let mut facing = 0;
    let mut x = 0;
    let mut y = 0;
    let mut best = 0;
    for c in commands.iter() {
        if *c == -2 {
            facing = (facing + 3) % 4;
        } else if *c == -1 {
            facing = (facing + 1) % 4;
        } else {
            let k = *c;
            if facing == 0 {
                let line = columns.get(x).unwrap_or(empty);
                y = jump_ahead(line, y, y + k);
            } else if facing == 2 {
                let line = columns.get(x).unwrap_or(empty);
                y = jump_behind(line, y, y - k);
            } else if facing == 1 {
                let line = rows.get(y).unwrap_or(empty);
                x = jump_ahead(line, x, x + k);
            } else {
                let line = rows.get(y).unwrap_or(empty);
                x = jump_behind(line, x, x - k);
            }
            best = best.max(x * x + y * y);
        }
    }
    best
}

// moving up a sorted line from `from` to `to`: where the robot stops
fn jump_ahead(line: Vec[i64], from: i64, to: i64) -> i64 {
    // the first obstacle above `from`
    let mut lo = 0;
    let mut hi = line.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if line[mid] <= from {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < line.len() and line[lo] <= to { line[lo] - 1 } else { to }
}

// moving down a sorted line from `from` to `to`: where the robot stops
fn jump_behind(line: Vec[i64], from: i64, to: i64) -> i64 {
    // the last obstacle below `from`
    let mut lo = 0;
    let mut hi = line.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if line[mid] < from {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo > 0 and line[lo - 1] >= to { line[lo - 1] + 1 } else { to }
}

// ---- the range arm: each move in one jump, by a range query ---------------
fn range_robot_sim(commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    let mut columns: Map[i64, SortedSet[i64]] = Map.new();
    let mut rows: Map[i64, SortedSet[i64]] = Map.new();
    for o in obstacles.iter() {
        if not columns.contains_key(o[0]) {
            columns.insert(o[0], SortedSet.new());
        }
        columns.get_mut(o[0]).unwrap().insert(o[1]);
        if not rows.contains_key(o[1]) {
            rows.insert(o[1], SortedSet.new());
        }
        rows.get_mut(o[1]).unwrap().insert(o[0]);
    }
    let mut facing = 0;
    let mut x = 0;
    let mut y = 0;
    let mut best = 0;
    for c in commands.iter() {
        if *c == -2 {
            facing = (facing + 3) % 4;
        } else if *c == -1 {
            facing = (facing + 1) % 4;
        } else {
            let k = *c;
            if facing == 0 {
                y += k;
                if let Some(line) = columns.get(x) {
                    if let Some(o) = line.range(y - k + 1, y + 1).next() {
                        y = *o - 1;
                    }
                }
            } else if facing == 2 {
                y -= k;
                if let Some(line) = columns.get(x) {
                    if let Some(o) = line.range(y, y + k).last() {
                        y = *o + 1;
                    }
                }
            } else if facing == 1 {
                x += k;
                if let Some(line) = rows.get(y) {
                    if let Some(o) = line.range(x - k + 1, x + 1).next() {
                        x = *o - 1;
                    }
                }
            } else {
                x -= k;
                if let Some(line) = rows.get(y) {
                    if let Some(o) = line.range(x, x + k).last() {
                        x = *o + 1;
                    }
                }
            }
            best = best.max(x * x + y * y);
        }
    }
    best
}

fn arm(a: i64, commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    match a {
        0 => star_robot_sim(commands, obstacles),
        1 => pairs_robot_sim(commands, obstacles),
        2 => facing_robot_sim(commands, obstacles),
        3 => jump_robot_sim(commands, obstacles),
        _ => range_robot_sim(commands, obstacles),
    }
}

// ---- the statement read literally -----------------------------------------

// the robot moved as the statement says: a turn of 90 degrees left or
// right, or k steps of one unit, each step checked against the obstacles
// as listed, and the squared distance taken at every point reached
fn literal(commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    let mut x = 0;
    let mut y = 0;
    // facing north
    let mut dx = 0;
    let mut dy = 1;
    let mut best = 0;
    for c in commands.iter() {
        if *c == -2 {
            // 90 degrees left: north to west, west to south
            let was = dx;
            dx = -dy;
            dy = was;
        } else if *c == -1 {
            // 90 degrees right: north to east, east to south
            let was = dx;
            dx = dy;
            dy = -was;
        } else {
            let mut stopped = false;
            for _ in 0..*c {
                if stopped {
                    break;
                }
                for o in obstacles.iter() {
                    if o[0] == x + dx and o[1] == y + dy {
                        stopped = true;
                    }
                }
                if not stopped {
                    x += dx;
                    y += dy;
                    if x * x + y * y > best {
                        best = x * x + y * y;
                    }
                }
            }
        }
    }
    best
}

// ---- properties -----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_commands(seed: mut ref i64, n: i64, turns: i64) -> Vec[i64] {
    let mut commands: Vec[i64] = Vec.new();
    for _ in 0..n {
        if next_random(mut seed) % turns == 0 {
            commands.push(-1 - next_random(mut seed) % 2);
        } else {
            commands.push(next_random(mut seed) % 9 + 1);
        }
    }
    commands
}

fn random_obstacles(seed: mut ref i64, n: i64, reach: i64) -> Vec[Vec[i64]] {
    let mut obstacles: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let x = next_random(mut seed) % (2 * reach + 1) - reach;
        let y = next_random(mut seed) % (2 * reach + 1) - reach;
        obstacles.push([x, y]);
    }
    obstacles
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

// the six properties for one walk, each over the five arms (P1 only when
// `small`); returns the ★ arm's answer
fn properties(t: mut ref Tally, seed: mut ref i64, commands: Vec[i64], obstacles: Vec[Vec[i64]], small: bool) -> i64 {
    let want = if small { literal(commands, obstacles) } else { 0 };
    let n = commands.len();
    // four turns in a row inserted at a random place
    let at = next_random(mut seed) % (n + 1);
    let turn = -1 - next_random(mut seed) % 2;
    let mut spun: Vec[i64] = Vec.new();
    for i in 0..n + 1 {
        if i == at {
            for _ in 0..4 {
                spun.push(turn);
            }
        }
        if i < n {
            spun.push(commands[i]);
        }
    }
    // the world turned a quarter turn clockwise, the robot turned right first
    let mut turned: Vec[i64] = [-1];
    for c in commands.iter() {
        turned.push(*c);
    }
    let mut turned_obstacles: Vec[Vec[i64]] = Vec.new();
    for o in obstacles.iter() {
        turned_obstacles.push([o[1], -o[0]]);
    }
    // the world mirrored left to right, left and right turns swapped
    let mut mirrored: Vec[i64] = Vec.new();
    for c in commands.iter() {
        mirrored.push(if *c == -1 { -2 } else if *c == -2 { -1 } else { *c });
    }
    let mut mirrored_obstacles: Vec[Vec[i64]] = Vec.new();
    for o in obstacles.iter() {
        mirrored_obstacles.push([-o[0], o[1]]);
    }
    // every move of more than 1 split in two
    let mut split: Vec[i64] = Vec.new();
    for c in commands.iter() {
        if *c > 1 {
            let first = 1 + next_random(mut seed) % (*c - 1);
            split.push(first);
            split.push(*c - first);
        } else {
            split.push(*c);
        }
    }
    // every obstacle twice, and obstacles out of the robot's reach
    let mut padded: Vec[Vec[i64]] = Vec.new();
    for o in obstacles.iter() {
        padded.push(o.clone());
        padded.push(o.clone());
    }
    let far = 9 * n + 1;
    padded.push([far, 0]);
    padded.push([0, -far]);
    padded.push([-far, far]);
    let mut star = 0;
    for x in 0..5 {
        let got = arm(x, commands, obstacles);
        if x == 0 {
            star = got;
        }
        // P1: the statement's answer
        if small {
            check(mut t, 1, got == want);
        }
        // P2: four turns the same way change nothing
        check(mut t, 2, arm(x, spun, obstacles) == got);
        // P3: the world and the robot turned a quarter turn together
        check(mut t, 3, arm(x, turned, turned_obstacles) == got);
        // P4: the world mirrored and the turns swapped
        check(mut t, 4, arm(x, mirrored, mirrored_obstacles) == got);
        // P5: a move split into two moves
        check(mut t, 5, arm(x, split, obstacles) == got);
        // P6: repeated obstacles and unreachable ones change nothing
        check(mut t, 6, arm(x, commands, padded) == got);
    }
    star
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut count = 0;
    let mut total = 0;
    let mut seed = 874;
    // short walks among nearby obstacles, the origin sometimes one of them
    for k in 0..1500 {
        let commands = random_commands(mut seed, k % 10 + 1, 3);
        let obstacles = random_obstacles(mut seed, k % 13, 3 + k % 2);
        count += 1;
        total += properties(mut t, mut seed, commands, obstacles, true);
    }
    // longer walks
    for k in 0..200 {
        let commands = random_commands(mut seed, next_random(mut seed) % 300 + 1, 2 + k % 3);
        let obstacles = random_obstacles(mut seed, next_random(mut seed) % 300, 10 + k % 40);
        count += 1;
        total += properties(mut t, mut seed, commands, obstacles, false);
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{count} walks, distances sum to {total}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
