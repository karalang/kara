// LeetCode #874: Walking Robot Simulation -- each move made in one jump,
// the obstacle in the way found by binary search.
//
// The obstacles are grouped by column (their y values, sorted) and by row
// (their x values, sorted). A move of k north from (x, y) stops below the
// first obstacle in column x above y, if it is within k; a binary search
// finds it, and the other three directions are the same with the signs or
// the axes swapped. The distance from the origin along a straight move is
// largest at one of its ends, so only the end of each move is measured.
// O((c + n) log n) for n obstacles.

fn robot_sim(commands: Vec[i64], obstacles: Vec[Vec[i64]]) -> i64 {
    let mut columns: Map[i64, Vec[i64]] = Map.new();
    let mut rows: Map[i64, Vec[i64]] = Map.new();
    for o in obstacles.iter() {
        if not columns.contains_key(o[0]) {
            columns.insert(o[0], Vec.new());
        }
        columns.get_mut(o[0]).unwrap().push(o[1]);
        if not rows.contains_key(o[1]) {
            rows.insert(o[1], Vec.new());
        }
        rows.get_mut(o[1]).unwrap().push(o[0]);
    }
    for (_, ys) in columns.iter_mut() {
        ys.sort();
    }
    for (_, xs) in rows.iter_mut() {
        xs.sort();
    }
    let empty: Vec[i64] = Vec.new();
    let mut facing = 0;
    let mut x = 0;
    let mut y = 0;
    let mut best = 0;
    for c in commands.iter() {
        if *c == -2 {
            facing = (facing + 3) % 4;
        } else if *c == -1 {
            facing = (facing + 1) % 4;
        } else {
            let k = *c;
            if facing == 0 {
                let line = columns.get(x).unwrap_or(empty);
                y = ahead(line, y, y + k);
            } else if facing == 2 {
                let line = columns.get(x).unwrap_or(empty);
                y = behind(line, y, y - k);
            } else if facing == 1 {
                let line = rows.get(y).unwrap_or(empty);
                x = ahead(line, x, x + k);
            } else {
                let line = rows.get(y).unwrap_or(empty);
                x = behind(line, x, x - k);
            }
            best = best.max(x * x + y * y);
        }
    }
    best
}

// moving up a sorted line from `from` to `to`: where the robot stops
fn ahead(line: Vec[i64], from: i64, to: i64) -> i64 {
    // the first obstacle above `from`
    let mut lo = 0;
    let mut hi = line.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if line[mid] <= from {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < line.len() and line[lo] <= to { line[lo] - 1 } else { to }
}

// moving down a sorted line from `from` to `to`: where the robot stops
fn behind(line: Vec[i64], from: i64, to: i64) -> i64 {
    // the last obstacle below `from`
    let mut lo = 0;
    let mut hi = line.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if line[mid] < from {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo > 0 and line[lo - 1] >= to { line[lo - 1] + 1 } else { to }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n commands: a turn one time in `turns`, else a move of 1 to 9
fn random_commands(seed: mut ref i64, n: i64, turns: i64) -> Vec[i64] {
    let mut commands: Vec[i64] = Vec.new();
    for _ in 0..n {
        if next_random(mut seed) % turns == 0 {
            commands.push(-1 - next_random(mut seed) % 2);
        } else {
            commands.push(next_random(mut seed) % 9 + 1);
        }
    }
    commands
}

// n obstacles with both coordinates in [-reach, reach], repeats allowed
fn random_obstacles(seed: mut ref i64, n: i64, reach: i64) -> Vec[Vec[i64]] {
    let mut obstacles: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let x = next_random(mut seed) % (2 * reach + 1) - reach;
        let y = next_random(mut seed) % (2 * reach + 1) - reach;
        obstacles.push([x, y]);
    }
    obstacles
}

fn show(commands: Vec[i64], obstacles: Vec[Vec[i64]]) {
    let mut text: Vec[String] = Vec.new();
    for c in commands.iter() {
        text.push(f"{c}");
    }
    let mut otext: Vec[String] = Vec.new();
    for o in obstacles.iter() {
        otext.push(f"[{o[0]},{o[1]}]");
    }
    let answer = robot_sim(commands, obstacles);
    println(f"commands = [{text.join(",")}], obstacles = [{otext.join(",")}] -> {answer}");
}

fn main() {
    show([4, -1, 3], []);
    show([4, -1, 4, -2, 4], [[2, 4]]);
    show([6, -1, -1, 6], [[0, 0]]);
    show([-2, -2, -1, -1], [[1, 1]]);
    show([5], [[0, 1]]);
    show([-2, 9, -2, 9], [[-9, -5]]);
    show([-1, -1, 7, -1, 3], [[0, -3], [-2, -7]]);
    show([2, -1, 2, -1, 2, -1, 2, -1, 9], [[0, 5]]);
    show([9, 9, 9, -1, 9, 9, 9], [[30000, 27], [0, 28], [0, -30000]]);
    show([1, -1, 1, -1, 1, -1, 1], [[0, 0]]);
    // short walks among a few nearby obstacles
    let mut seed = 874;
    let mut total = 0;
    let mut zero = 0;
    for k in 0..3000 {
        let commands = random_commands(mut seed, k % 10 + 1, 3);
        let obstacles = random_obstacles(mut seed, k % 12, 5);
        let answer = robot_sim(commands, obstacles);
        total += answer;
        if answer == 0 {
            zero += 1;
        }
    }
    println(f"3000 walks of 1 to 10 commands: distances sum to {total}, {zero} never leaving the origin");
    // LeetCode's largest: 10^4 commands and 10^4 obstacles, crowded near
    // the origin or spread to 3 x 10^4
    let mut check = 0;
    total = 0;
    for k in 0..12 {
        let reach = if k % 2 == 0 { 150 + 50 * k } else { 30000 };
        let commands = random_commands(mut seed, 10000, 2 + k % 3);
        let obstacles = random_obstacles(mut seed, 10000, reach);
        let answer = robot_sim(commands, obstacles);
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"12 walks of 10000 commands among 10000 obstacles: distances sum to {total}, checksum {check}");
}
