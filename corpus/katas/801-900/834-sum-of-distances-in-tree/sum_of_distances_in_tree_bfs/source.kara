// LeetCode #834: Sum of Distances in Tree -- rerooting in breadth-first order.
//
// A queue from node 0 lists the nodes level by level with their parents
// and depths. Node 0's answer is the sum of the depths. The list read
// backwards adds each subtree's size into its parent, and read forwards
// moves the root from each parent to its child, the child's subtree one
// closer and the rest one further. O(n).

fn sum_of_distances_in_tree(n: i64, edges: Vec[(i64, i64)]) -> Vec[i64] {
    let mut adj: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        adj.push(Vec.new());
    }
    for (a, b) in edges {
        adj[a].push(b);
        adj[b].push(a);
    }
    let mut parent = Vec.filled(n, -1);
    let mut depth = Vec.filled(n, -1);
    let mut queue: VecDeque[i64] = VecDeque.new();
    let mut order: Vec[i64] = Vec.new();
    depth[0] = 0;
    queue.push_back(0);
    while let Some(u) = queue.pop_front() {
        order.push(u);
        for v in adj[u] {
            if depth[v] < 0 {
                depth[v] = depth[u] + 1;
                parent[v] = u;
                queue.push_back(v);
            }
        }
    }
    let mut size = Vec.filled(n, 1);
    for u in order.iter().rev() {
        if parent[u] >= 0 {
            size[parent[u]] += size[u];
        }
    }
    let mut answer = Vec.filled(n, 0);
    answer[0] = depth.iter().sum();
    for u in order {
        if parent[u] >= 0 {
            answer[u] = answer[parent[u]] + n - 2 * size[u];
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random tree: node v > 0 hangs from a node drawn among the `reach`
// before it, the labels shuffled and each edge given either way round
fn random_tree(seed: mut ref i64, n: i64, reach: i64) -> Vec[(i64, i64)] {
    let mut label: Vec[i64] = (0..n).collect();
    let mut i = n;
    while i > 1 {
        let j = next_random(mut seed) % i;
        i -= 1;
        label.swap(i, j);
    }
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for v in 1..n {
        let lo = if v > reach { v - reach } else { 0 };
        let u = lo + next_random(mut seed) % (v - lo);
        if next_random(mut seed) % 2 == 0 {
            edges.push((label[u], label[v]));
        } else {
            edges.push((label[v], label[u]));
        }
    }
    let mut k = edges.len();
    while k > 1 {
        let j = next_random(mut seed) % k;
        k -= 1;
        edges.swap(k, j);
    }
    edges
}

fn show(n: i64, edges: Vec[(i64, i64)]) {
    println(f"n = {n}, edges = {edges} -> {sum_of_distances_in_tree(n, edges)}");
}

fn fold(check: i64, answer: Vec[i64]) -> i64 {
    let mut c = check;
    for x in answer {
        c = (c * 1000003 + x) % 1000000007;
    }
    c
}

fn main() {
    show(6, [(0, 1), (0, 2), (2, 3), (2, 4), (2, 5)]);
    show(1, []);
    show(2, [(1, 0)]);
    show(5, [(0, 1), (1, 2), (2, 3), (3, 4)]);
    show(5, [(3, 0), (3, 1), (3, 2), (3, 4)]);
    show(7, [(0, 1), (0, 2), (1, 3), (1, 4), (2, 5), (2, 6)]);
    // LeetCode's largest, 30000 nodes: a path, a star and a random tree,
    // each shown by its least and greatest answer and a checksum.
    let mut seed = 834;
    let n = 30000;
    for reach in [1, n, 3] {
        let tree = if reach == 1 {
            let mut path: Vec[(i64, i64)] = Vec.new();
            for v in 1..n {
                path.push((v - 1, v));
            }
            path
        } else if reach == n {
            let mut star: Vec[(i64, i64)] = Vec.new();
            for v in 1..n {
                star.push((0, v));
            }
            star
        } else {
            random_tree(mut seed, n, reach)
        };
        let answer = sum_of_distances_in_tree(n, tree);
        let mut lo = answer[0];
        let mut hi = answer[0];
        for x in answer {
            if x < lo {
                lo = x;
            }
            if x > hi {
                hi = x;
            }
        }
        println(f"30000 nodes, reach {reach}: least {lo}, greatest {hi}, checksum {fold(0, answer)}");
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let reach = 1 + next_random(mut seed) % n;
        let answer = sum_of_distances_in_tree(n, random_tree(mut seed, n, reach));
        for x in answer {
            total += x;
        }
        check = fold(check, answer);
    }
    println(f"300 random trees: answers total {total}, checksum {check}");
}
