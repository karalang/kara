// Benchmark for #818: Race Car -- the ★ arm (the best run to each distance).
//
// For a target t with n bits, either drive to 2^n - 1 and reverse, or
// stop one acceleration short, reverse, back up m accelerations and
// reverse again. `best[d]` holds the answer for every shorter distance,
// so one table answers t in O(t log t).

fn racecar(target: i64) -> i64 {
    let mut best = Vec.filled(target + 1, 0);
    for t in 1..target + 1 {
        let mut n = 0;
        while (1 << n) <= t {
            n += 1;
        }
        let full = (1 << n) - 1;
        if t == full {
            best[t] = n;
            continue;
        }
        let mut shortest = n + 1 + best[full - t];
        let short = (1 << (n - 1)) - 1;
        for m in 0..n - 1 {
            let back = (1 << m) - 1;
            let steps = (n - 1) + 1 + m + 1 + best[t - short + back];
            if steps < shortest {
                shortest = steps;
            }
        }
        best[t] = shortest;
    }
    best[target]
}

// ---- benchmark --------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // Each round draws a target from 1 to 10,000, LeetCode's largest, and
    // builds the table up to it afresh.
    let rounds = 40000;
    let mut seed: i64 = 818;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..rounds {
        let t = 1 + next_random(mut seed) % 10000;
        let answer = racecar(t);
        total += answer;
        checksum = (checksum * 131 + answer) % 1000000007;
    }
    println(f"{rounds} rounds of targets up to 10000: total {total}, checksum {checksum}");
}
