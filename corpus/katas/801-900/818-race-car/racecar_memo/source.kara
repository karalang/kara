// LeetCode 818 — Race Car, the same choices top down.
//
// The ★ arm's two ways to reach t, as a recursion that works out only
// the distances it needs, each once, in a table shared by the calls.
// O(t log t) at worst.

fn racecar(target: i64) -> i64 {
    let mut memo = Vec.filled(target + 1, 0);
    shortest(target, mut memo)
}

fn shortest(t: i64, memo: mut ref Vec[i64]) -> i64 {
    if memo[t] > 0 {
        return memo[t];
    }
    let mut n = 0;
    while (1 << n) <= t {
        n += 1;
    }
    let full = (1 << n) - 1;
    let mut best = n;
    if t != full {
        best = n + 1 + shortest(full - t, mut memo);
        let short = (1 << (n - 1)) - 1;
        for m in 0..n - 1 {
            let back = (1 << m) - 1;
            let steps = n + 1 + m + shortest(t - short + back, mut memo);
            if steps < best {
                best = steps;
            }
        }
    }
    memo[t] = best;
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"target = 3 -> {racecar(3)}");
    println(f"target = 6 -> {racecar(6)}");
    let mut first: Vec[i64] = Vec.new();
    for t in 1..33 {
        first.push(racecar(t));
    }
    println(f"targets 1 to 32 -> {first}");
    // LeetCode's largest, and the targets just around powers of two.
    for t in [10000, 9999, 8191, 8192, 4097, 5461] {
        println(f"target = {t} -> {racecar(t)}");
    }
    let mut seed = 818;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let t = 1 + next_random(mut seed) % 200;
        let answer = racecar(t);
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"300 random targets up to 200: total {total}, checksum {check}");
}
