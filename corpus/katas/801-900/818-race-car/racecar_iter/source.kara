// LeetCode 818 — Race Car, as iterators.
//
// The ★ arm's table built by a `fold` over the distances, each entry the
// `min` over a `map` of the ways to stop short, chained with the way
// that overshoots. O(t log t).

fn racecar(target: i64) -> i64 {
    let best = (1..target + 1).fold([0], |best, t| {
        let n = 64 - t.leading_zeros() as i64;
        let full = (1 << n) - 1;
        let answer = if t == full {
            n
        } else {
            let short = (1 << (n - 1)) - 1;
            (0..n - 1)
                .map(|m| n + 1 + m + best[t - short + (1 << m) - 1])
                .chain([n + 1 + best[full - t]].into_iter())
                .min()
                .unwrap()
        };
        let mut next = best;
        next.push(answer);
        next
    });
    best[target]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"target = 3 -> {racecar(3)}");
    println(f"target = 6 -> {racecar(6)}");
    let mut first: Vec[i64] = Vec.new();
    for t in 1..33 {
        first.push(racecar(t));
    }
    println(f"targets 1 to 32 -> {first}");
    // LeetCode's largest, and the targets just around powers of two.
    for t in [10000, 9999, 8191, 8192, 4097, 5461] {
        println(f"target = {t} -> {racecar(t)}");
    }
    let mut seed = 818;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let t = 1 + next_random(mut seed) % 200;
        let answer = racecar(t);
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"300 random targets up to 200: total {total}, checksum {check}");
}
