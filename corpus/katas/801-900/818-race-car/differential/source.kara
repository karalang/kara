// LeetCode #818: differential -- the four arms against the statement.
//
// Copies of the four arms, held to four properties on random targets,
// against the car driven by every instruction sequence, shortest first.

// ---- ★ arm ----------------------------------------------------------

fn racecar_star(target: i64) -> i64 {
    let mut best = Vec.filled(target + 1, 0);
    for t in 1..target + 1 {
        let mut n = 0;
        while (1 << n) <= t {
            n += 1;
        }
        let full = (1 << n) - 1;
        if t == full {
            best[t] = n;
            continue;
        }
        let mut shortest = n + 1 + best[full - t];
        let short = (1 << (n - 1)) - 1;
        for m in 0..n - 1 {
            let back = (1 << m) - 1;
            let steps = (n - 1) + 1 + m + 1 + best[t - short + back];
            if steps < shortest {
                shortest = steps;
            }
        }
        best[t] = shortest;
    }
    best[target]
}

// ---- search arm -----------------------------------------------------

fn racecar_bfs(target: i64) -> i64 {
    let mut seen: Set[(i64, i64)] = Set.new();
    let mut queue: VecDeque[(i64, i64, i64)] = VecDeque.new();
    queue.push_back((0, 1, 0));
    seen.insert((0, 1));
    while let Some((pos, speed, steps)) = queue.pop_front() {
        if pos == target {
            return steps;
        }
        let ahead = (pos + speed, speed * 2);
        let turned = (pos, if speed > 0 { -1 } else { 1 });
        for (p, s) in [ahead, turned] {
            if p > -target and p < 2 * target and seen.insert((p, s)) {
                queue.push_back((p, s, steps + 1));
            }
        }
    }
    -1
}

// ---- memo arm -------------------------------------------------------

fn racecar_memo(target: i64) -> i64 {
    let mut memo = Vec.filled(target + 1, 0);
    shortest_memo(target, mut memo)
}

fn shortest_memo(t: i64, memo: mut ref Vec[i64]) -> i64 {
    if memo[t] > 0 {
        return memo[t];
    }
    let mut n = 0;
    while (1 << n) <= t {
        n += 1;
    }
    let full = (1 << n) - 1;
    let mut best = n;
    if t != full {
        best = n + 1 + shortest_memo(full - t, mut memo);
        let short = (1 << (n - 1)) - 1;
        for m in 0..n - 1 {
            let back = (1 << m) - 1;
            let steps = n + 1 + m + shortest_memo(t - short + back, mut memo);
            if steps < best {
                best = steps;
            }
        }
    }
    memo[t] = best;
    best
}

// ---- iterator arm ---------------------------------------------------

fn racecar_iter(target: i64) -> i64 {
    let best = (1..target + 1).fold([0], |best, t| {
        let n = 64 - t.leading_zeros() as i64;
        let full = (1 << n) - 1;
        let answer = if t == full {
            n
        } else {
            let short = (1 << (n - 1)) - 1;
            (0..n - 1)
                .map(|m| n + 1 + m + best[t - short + (1 << m) - 1])
                .chain([n + 1 + best[full - t]].into_iter())
                .min()
                .unwrap()
        };
        let mut next = best;
        next.push(answer);
        next
    });
    best[target]
}

// ---- the definition -------------------------------------------------------

// The statement played out: from position 0 at speed 1, `A` moves the
// car by its speed and doubles the speed, `R` turns the speed to -1 or
// 1. Every sequence of instructions is tried, shortest first, by a
// search over the states it reaches, one instruction more at each
// level, and the first level that reaches a position is its answer.
// The car is kept far wider than any short run goes: within 8 times
// the farthest target either way, and at speeds up to 2^13.
fn answers_by_definition(farthest: i64) -> Vec[i64] {
    let reach = 8 * farthest;
    let speeds = 14;
    // A state is a position and a speed of ±2^e, kept as one number.
    let state = |pos: i64, e: i64, back: bool| {
        ((pos + reach) * speeds + e) * 2 + (if back { 1 } else { 0 })
    };
    let mut seen = Vec.filled((2 * reach + 1) * speeds * 2, false);
    let mut answer = Vec.filled(farthest + 1, -1);
    answer[0] = 0;
    let mut level: Vec[(i64, i64, bool)] = [(0, 0, false)];
    seen[state(0, 0, false)] = true;
    let mut steps = 0;
    while not level.is_empty() {
        steps += 1;
        let mut next: Vec[(i64, i64, bool)] = Vec.new();
        for (pos, e, back) in level.iter() {
            let speed = if back { -(1 << e) } else { 1 << e };
            let moves = [(pos + speed, e + 1, back), (pos, 0, not back)];
            for (p, f, b) in moves {
                if p <= -reach or p >= reach or f >= speeds or seen[state(p, f, b)] {
                    continue;
                }
                seen[state(p, f, b)] = true;
                if p > 0 and p <= farthest and answer[p] < 0 {
                    answer[p] = steps;
                }
                next.push((p, f, b));
            }
        }
        level = next;
    }
    answer
}

// ---- the properties -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, target: i64) -> i64 {
    if which == 0 {
        racecar_star(target)
    } else if which == 1 {
        racecar_bfs(target)
    } else if which == 2 {
        racecar_memo(target)
    } else {
        racecar_iter(target)
    }
}

fn bits(t: i64) -> i64 {
    let mut n = 0;
    while (1 << n) <= t {
        n += 1;
    }
    n
}

fn main() {
    let arms = 4;
    let farthest = 300;
    let answer = answers_by_definition(farthest);
    let mut seed = 8180;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let mut by_property = [0, 0, 0, 0];
    let cases = 1600;
    let mut longest = 0;
    for case in 0..cases {
        // kind 0: up to 40; kind 1: up to 300; kind 2: within 2 of a
        // power of two; kind 3: 2^k - 2^m, a run that stops short and
        // backs up.
        let kind = case % 4;
        let t = if kind == 0 {
            1 + next_random(mut seed) % 40
        } else if kind == 1 {
            1 + next_random(mut seed) % farthest
        } else if kind == 2 {
            let near = (1 << (1 + next_random(mut seed) % 8)) - 2 + next_random(mut seed) % 5;
            if near < 1 { 1 } else { near }
        } else {
            let k = 1 + next_random(mut seed) % 8;
            (1 << k) - (1 << (next_random(mut seed) % k))
        };
        let want = answer[t];
        if want > longest {
            longest = want;
        }
        let n = bits(t);
        let full = (1 << n) - 1;
        // A split of t into two runs, one after the other.
        let a = if t > 1 { 1 + next_random(mut seed) % (t - 1) } else { 0 };
        for which in 0..arms {
            // 1: the statement's answer.
            // 2: at least the n accelerations it takes to reach t, and
            //    exactly n only when t is 2^n - 1.
            // 3: no more than a run to a, two turns to stop and face
            //    ahead at speed 1, and a run over the rest.
            // 4: no more than driving past to 2^n - 1, one turn, and a
            //    run back over the overshoot.
            let got = arm(which, t);
            let ok = [
                got == want,
                got >= n and (got == n) == (t == full),
                a == 0 or got <= arm(which, a) + 2 + arm(which, t - a),
                t == full or got <= n + 1 + arm(which, full - t),
            ];
            for p in 0..4 {
                checks += 1;
                if not ok[p] {
                    fails[which] += 1;
                    by_property[p] += 1;
                }
            }
        }
    }
    let total = fails[0] + fails[1] + fails[2] + fails[3];
    println(f"{cases} cases (the longest run {longest} instructions), {checks} checks over {arms} arms: {total} failures");
    println(f"by arm: star {fails[0]}, bfs {fails[1]}, memo {fails[2]}, iter {fails[3]}");
    println(f"by property: answer {by_property[0]}, bits {by_property[1]}, split {by_property[2]}, overshoot {by_property[3]}");
}
