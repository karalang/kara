// LeetCode #809: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random strings
// and words.

// ---- ★ arm ----------------------------------------------------------

fn expressive_words_star(s: String, words: Vec[String]) -> i64 {
    let mut count = 0;
    for k in 0..words.len() {
        if stretchy_star(s, words[k]) {
            count += 1;
        }
    }
    count
}

fn stretchy_star(s: String, word: String) -> bool {
    let a = s.bytes();
    let b = word.bytes();
    let mut i = 0;
    let mut j = 0;
    while i < a.len() and j < b.len() {
        let c = a[i];
        if b[j] != c {
            return false;
        }
        let from_i = i;
        while i < a.len() and a[i] == c {
            i += 1;
        }
        let from_j = j;
        while j < b.len() and b[j] == c {
            j += 1;
        }
        let in_s = i - from_i;
        let in_word = j - from_j;
        if in_s < in_word or (in_s > in_word and in_s < 3) {
            return false;
        }
    }
    i == a.len() and j == b.len()
}

// ---- run-length arm -------------------------------------------------

fn expressive_words_rle(s: String, words: Vec[String]) -> i64 {
    let target = runs_rle(s);
    let mut count = 0;
    for k in 0..words.len() {
        let have = runs_rle(words[k]);
        if fits_rle(target, have) {
            count += 1;
        }
    }
    count
}

fn runs_rle(text: String) -> Vec[(u8, i64)] {
    let mut out: Vec[(u8, i64)] = Vec.new();
    for b in text.bytes() {
        let last = out.len() - 1;
        if out.len() > 0 and out[last].0 == b {
            out[last].1 += 1;
        } else {
            out.push((b, 1));
        }
    }
    out
}

fn fits_rle(target: Vec[(u8, i64)], have: Vec[(u8, i64)]) -> bool {
    if target.len() != have.len() {
        return false;
    }
    for g in 0..target.len() {
        let (c, n) = target[g];
        let (d, m) = have[g];
        if c != d or m > n or (m < n and n < 3) {
            return false;
        }
    }
    true
}

// ---- recursive arm --------------------------------------------------

fn expressive_words_recursive(s: String, words: Vec[String]) -> i64 {
    let a = s.bytes();
    let mut count = 0;
    for k in 0..words.len() {
        if matches_recursive(a, 0, words[k].bytes(), 0) {
            count += 1;
        }
    }
    count
}

fn group_end_recursive(text: Slice[u8], at: i64) -> i64 {
    let mut end = at;
    while end < text.len() and text[end] == text[at] {
        end += 1;
    }
    end
}

fn matches_recursive(a: Slice[u8], i: i64, b: Slice[u8], j: i64) -> bool {
    if i == a.len() or j == b.len() {
        return i == a.len() and j == b.len();
    }
    if a[i] != b[j] {
        return false;
    }
    let next_i = group_end_recursive(a, i);
    let next_j = group_end_recursive(b, j);
    let in_s = next_i - i;
    let in_word = next_j - j;
    let grows = in_s == in_word or (in_s > in_word and in_s >= 3);
    grows and matches_recursive(a, next_i, b, next_j)
}

// ---- iterator arm ---------------------------------------------------

fn expressive_words_iter(s: String, words: Vec[String]) -> i64 {
    let target = groups_iter(s);
    words.iter().filter(|w| fits_iter(target, groups_iter(w))).count()
}

fn groups_iter(text: String) -> Vec[(u8, i64)] {
    text.bytes().iter().fold(Vec.new(), |out: own Vec[(u8, i64)], b| {
        let mut out = out;
        if out.last().map(|g| g.0 == *b).unwrap_or(false) {
            let last = out.len() - 1;
            out[last].1 += 1;
        } else {
            out.push((*b, 1));
        }
        out
    })
}

fn fits_iter(target: Vec[(u8, i64)], have: Vec[(u8, i64)]) -> bool {
    target.len() == have.len()
        and target.iter().zip(have.iter()).all(|(t, h)| t.0 == h.0 and (t.1 == h.1 or (t.1 > h.1 and t.1 >= 3)))
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn count_with(which: i64, s: String, words: Vec[String]) -> i64 {
    if which == 0 {
        expressive_words_star(s, words)
    } else if which == 1 {
        expressive_words_rle(s, words)
    } else if which == 2 {
        expressive_words_recursive(s, words)
    } else {
        expressive_words_iter(s, words)
    }
}

// The definition, by search: starting from the word, make one group of
// one letter longer, to three letters or more, in every way that keeps
// the string no longer than s, and again from each string made, until s
// is made or nothing new is.
fn reachable(s: String, word: String) -> bool {
    let mut seen: Set[String] = Set.new();
    let mut queue: Vec[String] = Vec.new();
    seen.insert(word.clone());
    queue.push(word.clone());
    let mut at = 0;
    while at < queue.len() {
        let t = queue[at].clone();
        at += 1;
        if t == s {
            return true;
        }
        let b = t.bytes();
        let mut i = 0;
        while i < b.len() {
            let mut end = i;
            while end < b.len() and b[end] == b[i] {
                end += 1;
            }
            let len = end - i;
            for m in (len + 1).max(3)..(s.len() - b.len() + len + 1) {
                let mut u = String.new();
                for k in 0..i {
                    u.push(b[k] as char);
                }
                for _ in 0..m {
                    u.push(b[i] as char);
                }
                for k in end..b.len() {
                    u.push(b[k] as char);
                }
                if not seen.contains(u) {
                    seen.insert(u.clone());
                    queue.push(u);
                }
            }
            i = end;
        }
    }
    false
}

fn random_groups(seed: mut ref i64, groups: i64, letters: i64, longest: i64) -> Vec[(u8, i64)] {
    let mut out: Vec[(u8, i64)] = Vec.new();
    let mut last = 26;
    for _ in 0..groups {
        let mut c = next_random(mut seed) % letters;
        if c == last {
            c = (c + 1) % letters;
        }
        last = c;
        out.push(((97 + c) as u8, 1 + next_random(mut seed) % longest));
    }
    out
}

fn spell(groups: Vec[(u8, i64)]) -> String {
    let mut out = String.new();
    for (c, n) in groups {
        for _ in 0..n {
            out.push(c as char);
        }
    }
    out
}

fn reversed(text: String) -> String {
    let b = text.bytes();
    let mut out = String.new();
    for k in 0..b.len() {
        out.push(b[b.len() - 1 - k] as char);
    }
    out
}

// Every letter moved on by `by` places in the alphabet, z wrapping to a.
fn renamed(text: String, by: i64) -> String {
    let mut out = String.new();
    for c in text.bytes() {
        out.push((97 + ((c as i64) - 97 + by) % 26) as u8 as char);
    }
    out
}

// s with every group of three letters or more made one letter longer.
fn stretched(text: String) -> String {
    let b = text.bytes();
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let mut end = i;
        while end < b.len() and b[end] == b[i] {
            end += 1;
        }
        let grown = if end - i >= 3 { end - i + 1 } else { end - i };
        for _ in 0..grown {
            out.push(b[i] as char);
        }
        i = end;
    }
    out
}

fn main() {
    let arms = 4;
    let mut seed = 8090;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1600;
    let mut stretchy = 0;
    let mut words_in_all = 0;
    for case in 0..cases {
        // kind 0: up to 4 groups of up to 4 letters from a to c, and words
        // with the same letters and groups of 1 to 5; kind 1: groups of 1
        // to 3 of a and b, and words of a and b alone; kind 2: up to 3
        // groups of up to 7 letters; kind 3: words that are s with one
        // change. Each case has 6 words, one of them made at random.
        let kind = case % 4;
        let groups = if kind == 0 {
            random_groups(mut seed, 1 + next_random(mut seed) % 4, 3, 4)
        } else if kind == 1 {
            random_groups(mut seed, 1 + next_random(mut seed) % 4, 2, 3)
        } else if kind == 2 {
            random_groups(mut seed, 1 + next_random(mut seed) % 3, 3, 7)
        } else {
            random_groups(mut seed, 1 + next_random(mut seed) % 4, 4, 4)
        };
        let s = spell(groups);
        let mut words: Vec[String] = Vec.new();
        for w in 0..6 {
            if w == 0 {
                words.push(spell(random_groups(mut seed, 1 + next_random(mut seed) % 4, 3, 3)));
            } else if kind == 1 {
                let n = 1 + next_random(mut seed) % 8;
                let mut word = String.new();
                for _ in 0..n {
                    word.push((97 + next_random(mut seed) % 2) as u8 as char);
                }
                words.push(word);
            } else if kind == 3 {
                // one change: a group one shorter or one longer, a letter
                // changed, a group left out, or a letter added at the end.
                let mut changed = groups.clone();
                let g = next_random(mut seed) % changed.len();
                let how = next_random(mut seed) % 5;
                if how == 0 {
                    changed[g].1 = (changed[g].1 - 1).max(1);
                } else if how == 1 {
                    changed[g].1 += 1;
                } else if how == 2 {
                    changed[g].0 = (97 + (changed[g].0 as i64 - 97 + 1) % 4) as u8;
                } else if how == 3 and changed.len() > 1 {
                    changed.remove(g);
                } else {
                    changed.push((b'd', 1));
                }
                words.push(spell(changed));
            } else {
                let mut shrunk: Vec[(u8, i64)] = Vec.new();
                for (c, n) in groups {
                    shrunk.push((c, 1 + next_random(mut seed) % (n + 1)));
                }
                words.push(spell(shrunk));
            }
        }
        let mut want = 0;
        for w in 0..words.len() {
            if reachable(s, words[w]) {
                want += 1;
            }
        }
        stretchy += want;
        words_in_all += words.len();
        let mut back: Vec[String] = Vec.new();
        let mut moved: Vec[String] = Vec.new();
        for w in 0..words.len() {
            back.push(reversed(words[w]));
            moved.push(renamed(words[w], 1 + case % 25));
        }
        for which in 0..arms {
            let got = count_with(which, s, words);
            // P1: the definition's count, and its verdict on each word.
            checks += 1;
            let mut wrong = got != want;
            for w in 0..words.len() {
                let one: Vec[String] = vec![words[w].clone()];
                let alone = count_with(which, s, one);
                if (alone == 1) != reachable(s, words[w]) {
                    wrong = true;
                }
            }
            if wrong {
                fails[0] += 1;
            }
            // P2: s and every word written backwards give the same count.
            checks += 1;
            if count_with(which, reversed(s), back) != got {
                fails[1] += 1;
            }
            // P3: every letter renamed the same way gives the same count.
            checks += 1;
            if count_with(which, renamed(s, 1 + case % 25), moved) != got {
                fails[2] += 1;
            }
            // P4: s is stretchy from itself, and s with each group of three
            // letters or more made longer never counts fewer words.
            checks += 1;
            let itself: Vec[String] = vec![s.clone()];
            if count_with(which, s, itself) != 1 or count_with(which, stretched(s), words) < got {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} cases ({stretchy} of {words_in_all} words stretchy), {arms} arms, {checks} checks, {failures} failures");
}
