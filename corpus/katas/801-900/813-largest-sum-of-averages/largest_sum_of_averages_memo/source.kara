// LeetCode 813 — Largest Sum of Averages, memoized recursion.
//
// best(start, groups) is the largest sum of averages of nums[start..]
// cut into at most `groups` groups: the average of all of it, or a first
// group nums[start..end] and the best of the rest with one group fewer.
// Each (start, groups) is worked out once. O(k n^2).
fn largest_sum_of_averages(nums: Vec[i64], k: i64) -> f64 {
    let n = nums.len();
    let mut prefix = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut memo: Vec[f64] = Vec.filled((n + 1) * (k + 1), -1.0);
    best(prefix, 0, k, mut memo)
}

fn best(prefix: Vec[i64], start: i64, groups: i64, memo: mut ref Vec[f64]) -> f64 {
    let n = prefix.len() - 1;
    let slot = start * (memo.len() / (n + 1)) + groups;
    if memo[slot] >= 0.0 {
        return memo[slot];
    }
    let mut result = (prefix[n] - prefix[start]) as f64 / (n - start) as f64;
    if groups > 1 {
        for end in start + 1..n {
            let first = (prefix[end] - prefix[start]) as f64 / (end - start) as f64;
            let candidate = first + best(prefix, end, groups - 1, mut memo);
            if candidate > result {
                result = candidate;
            }
        }
    }
    memo[slot] = result;
    result
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], k: i64) {
    println(f"nums = {nums}, k = {k} -> {largest_sum_of_averages(nums, k):.5}");
}

fn main() {
    show(vec![9, 1, 2, 3, 9], 3);
    show(vec![1, 2, 3, 4, 5, 6, 7], 4);
    show(vec![5], 1);
    show(vec![4, 1, 7], 1);
    show(vec![4, 1, 7], 3);
    show(vec![1, 1, 1, 1], 2);
    show(vec![1, 1, 10000, 1], 2);
    show(vec![3, 10, 3, 10, 3], 2);
    // LeetCode's largest: 100 numbers up to 10000, cut into at most 1, 7, 50 and 100.
    let mut seed = 813;
    let mut big: Vec[i64] = Vec.new();
    for _ in 0..100 {
        big.push(1 + next_random(mut seed) % 10000);
    }
    for k in [1, 7, 50, 100] {
        println(f"100 numbers, k = {k} -> {largest_sum_of_averages(big, k):.5}");
    }
    let mut total = 0.0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 12;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % 50);
        }
        let k = 1 + next_random(mut seed) % n;
        total += largest_sum_of_averages(nums, k);
    }
    println(f"300 random rounds of 1 to 12 numbers: total {total:.5}");
}
