// LeetCode #838: Push Dominoes -- the nearest push on each side.
//
// For each standing domino, two passes find how far back the nearest
// `R` is with only standing dominoes between, and how far ahead the
// nearest such `L` is. With neither it stays up, with one it falls that
// way, and with both it falls toward the nearer and stays up at a tie.
// O(n).

fn push_dominoes(dominoes: String) -> String {
    let d: Vec[char] = dominoes.chars().collect();
    let n = d.len();
    let mut from_r = Vec.filled(n, -1);
    let mut last = -1;
    for i in 0..n {
        if d[i] == 'R' {
            last = i;
        } else if d[i] == 'L' {
            last = -1;
        } else if last >= 0 {
            from_r[i] = i - last;
        }
    }
    let mut to_l = Vec.filled(n, -1);
    last = -1;
    for i in (0..n).rev() {
        if d[i] == 'L' {
            last = i;
        } else if d[i] == 'R' {
            last = -1;
        } else if last >= 0 {
            to_l[i] = last - i;
        }
    }
    let mut out = String.new();
    for i in 0..n {
        let c = if d[i] != '.' {
            d[i]
        } else if from_r[i] < 0 and to_l[i] < 0 {
            '.'
        } else if to_l[i] < 0 or (from_r[i] >= 0 and from_r[i] < to_l[i]) {
            'R'
        } else if from_r[i] < 0 or to_l[i] < from_r[i] {
            'L'
        } else {
            '.'
        };
        out.push(c);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n dominoes, each pushed left with chance `pushed` in 200 and right
// with the same chance
fn random_line(seed: mut ref i64, n: i64, pushed: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        let r = next_random(mut seed) % 200;
        s.push(if r < pushed { 'L' } else if r < 2 * pushed { 'R' } else { '.' });
    }
    s
}

fn fold(check: i64, s: String) -> i64 {
    let mut c = check;
    for b in s.bytes() {
        c = (c * 31 + b as i64) % 1000000007;
    }
    c
}

fn show(dominoes: String) {
    println(f"\"{dominoes}\" -> \"{push_dominoes(dominoes)}\"");
}

fn main() {
    show("RR.L");
    show(".L.R...LR..L..");
    show(".");
    show("R");
    show("L");
    show("R.L");
    show("R..L");
    show("R...");
    show("...L");
    show("L...R");
    show("R.R.L");
    show(".L.R.");
    show("R....L.....L");
    // LeetCode's longest, 10^5 dominoes, few, some and many pushed
    let mut seed = 838;
    for pushed in [1, 10, 60] {
        let out = push_dominoes(random_line(mut seed, 100000, pushed));
        let mut counts = [0, 0, 0];
        for c in out.chars() {
            counts[if c == 'L' { 0 } else if c == 'R' { 1 } else { 2 }] += 1;
        }
        println(f"100000 dominoes, {pushed} in 200 pushed each way: {counts[0]} L, {counts[1]} R, {counts[2]} up, checksum {fold(0, out)}");
    }
    let mut check = 0;
    let mut up = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 60;
        let pushed = next_random(mut seed) % 51;
        let out = push_dominoes(random_line(mut seed, n, pushed));
        for c in out.chars() {
            if c == '.' {
                up += 1;
            }
        }
        check = fold(check, out);
    }
    println(f"300 random lines: {up} left standing, checksum {check}");
}
