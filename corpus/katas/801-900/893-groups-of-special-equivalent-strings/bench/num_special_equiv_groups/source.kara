// LeetCode #893 bench: the union-find arm (every pair of words compared
// by their counts of letters at even and at odd positions) on 300 lists of
// 1,000 words of 20 letters, LeetCode's largest; half the words are an
// earlier word moved within its group. It is the same algorithm in all
// five languages, with no set, map or library sort.

fn num_special_equiv_groups(words: Vec[String]) -> i64 {
    let n = words.len();
    let mut counts: Vec[Vec[i64]] = Vec.new();
    for word in words.iter() {
        let mut count: Vec[i64] = Vec.filled(52, 0);
        let bytes = word.bytes();
        for i in 0..bytes.len() {
            count[(bytes[i] - 97) as i64 + 26 * (i % 2)] += 1;
        }
        counts.push(count);
    }
    let mut parent: Vec[i64] = Vec.new();
    for i in 0..n {
        parent.push(i);
    }
    for i in 0..n {
        for j in i + 1..n {
            if counts[i] == counts[j] {
                let a = find(mut parent, i);
                let b = find(mut parent, j);
                if a != b {
                    parent[a] = b;
                }
            }
        }
    }
    let mut groups = 0;
    for i in 0..n {
        if find(mut parent, i) == i {
            groups += 1;
        }
    }
    groups
}

// the root of x, halving the path on the way
fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random word of `len` letters from the first `letters` of the alphabet
fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    w
}

// the word with random swaps among its even positions and among its odd
// ones, so it stays in the same group
fn shuffled(seed: mut ref i64, word: String) -> String {
    let mut b = word.bytes().to_vec();
    let n = b.len();
    for _ in 0..n {
        let i = next_random(mut seed) % n;
        let j = next_random(mut seed) % n;
        if i % 2 == j % 2 {
            b.swap(i, j);
        }
    }
    let mut out = String.new();
    for c in b.iter() {
        out.push(*c as char);
    }
    out
}

fn main() {
    let mut seed = 893;
    let mut groups = 0;
    let mut check = 0;
    for _ in 0..300 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..1000 {
            if words.len() > 0 and next_random(mut seed) % 2 == 0 {
                let k = next_random(mut seed) % words.len();
                words.push(shuffled(mut seed, words[k]));
            } else {
                words.push(random_word(mut seed, 20, 26));
            }
        }
        let got = num_special_equiv_groups(words);
        groups += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"300 lists of 1000 words of 20 letters: {groups} groups, checksum {check}");
}
