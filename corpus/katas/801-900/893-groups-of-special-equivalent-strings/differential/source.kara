// LeetCode #893: Groups of Special-Equivalent Strings -- differential test of
// the five arms against the statement read literally, with six properties.
//
// The statement: an array of strings of the same length. In one move, swap
// any two even indexed characters or any two odd indexed characters of a
// string. Two strings are special-equivalent if after any number of moves
// they are equal. A group of special-equivalent strings is a non-empty
// subset such that every pair in the group is special-equivalent and the
// group is the largest size possible. Return the number of groups.

// ---- the ★ arm: a count of letters at even and at odd positions -----------
fn star_num_special_equiv_groups(words: Vec[String]) -> i64 {
    let mut keys: Set[String] = Set.new();
    for word in words.iter() {
        let mut count: Vec[i64] = Vec.filled(52, 0);
        let mut i = 0;
        for b in word.bytes() {
            count[(b - 97) as i64 + 26 * (i % 2)] += 1;
            i += 1;
        }
        let mut key = String.new();
        for c in count.iter() {
            key = key + f"{*c},";
        }
        keys.insert(key);
    }
    keys.len()
}

// ---- the sorted arm: the even and odd letters, each sorted ----------------
fn sorted_num_special_equiv_groups(words: Vec[String]) -> i64 {
    let mut keys: Set[String] = Set.new();
    for word in words.iter() {
        let mut even: Vec[u8] = Vec.new();
        let mut odd: Vec[u8] = Vec.new();
        let bytes = word.bytes();
        for i in 0..bytes.len() {
            if i % 2 == 0 {
                even.push(bytes[i]);
            } else {
                odd.push(bytes[i]);
            }
        }
        even.sort();
        odd.sort();
        let mut key = String.new();
        for b in even.iter() {
            key.push(*b as char);
        }
        key.push('|');
        for b in odd.iter() {
            key.push(*b as char);
        }
        keys.insert(key);
    }
    keys.len()
}

// ---- the unionfind arm: union-find over every pair ------------------------
fn unionfind_num_special_equiv_groups(words: Vec[String]) -> i64 {
    let n = words.len();
    let mut counts: Vec[Vec[i64]] = Vec.new();
    for word in words.iter() {
        let mut count: Vec[i64] = Vec.filled(52, 0);
        let bytes = word.bytes();
        for i in 0..bytes.len() {
            count[(bytes[i] - 97) as i64 + 26 * (i % 2)] += 1;
        }
        counts.push(count);
    }
    let mut parent: Vec[i64] = Vec.new();
    for i in 0..n {
        parent.push(i);
    }
    for i in 0..n {
        for j in i + 1..n {
            if counts[i] == counts[j] {
                let a = unionfind_find(mut parent, i);
                let b = unionfind_find(mut parent, j);
                if a != b {
                    parent[a] = b;
                }
            }
        }
    }
    let mut groups = 0;
    for i in 0..n {
        if unionfind_find(mut parent, i) == i {
            groups += 1;
        }
    }
    groups
}

// the root of x, halving the path on the way
fn unionfind_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

// ---- the leaders arm: one word to lead each group -------------------------
fn leaders_num_special_equiv_groups(words: Vec[String]) -> i64 {
    let mut evens: Vec[Vec[u8]] = Vec.new();
    let mut odds: Vec[Vec[u8]] = Vec.new();
    for word in words.iter() {
        let even = leaders_letters(word, 0);
        let odd = leaders_letters(word, 1);
        let mut found = false;
        for g in 0..evens.len() {
            if evens[g] == even and odds[g] == odd {
                found = true;
                break;
            }
        }
        if not found {
            evens.push(even);
            odds.push(odd);
        }
    }
    evens.len()
}

// the letters at positions of one parity, sorted
fn leaders_letters(word: String, parity: i64) -> Vec[u8] {
    let bytes = word.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = parity;
    while i < bytes.len() {
        out.push(bytes[i]);
        i += 2;
    }
    out.sort();
    out
}

// ---- the keys arm: the keys sorted and the changes counted ----------------
fn keys_num_special_equiv_groups(words: Vec[String]) -> i64 {
    let mut keys: Vec[Vec[i64]] = Vec.new();
    for word in words.iter() {
        let mut key: Vec[i64] = Vec.filled(52, 0);
        let bytes = word.bytes();
        for i in 0..bytes.len() {
            key[(bytes[i] - 97) as i64 + 26 * (i % 2)] += 1;
        }
        keys.push(key);
    }
    keys.sort();
    let mut groups = 0;
    for i in 0..keys.len() {
        if i == 0 or keys[i] != keys[i - 1] {
            groups += 1;
        }
    }
    groups
}

fn arm(x: i64, words: Vec[String]) -> i64 {
    match x {
        0 => star_num_special_equiv_groups(words),
        1 => sorted_num_special_equiv_groups(words),
        2 => unionfind_num_special_equiv_groups(words),
        3 => leaders_num_special_equiv_groups(words),
        _ => keys_num_special_equiv_groups(words),
    }
}

// ---- the statement read literally -----------------------------------------

// every word one move can reach: two even positions swapped, or two odd
fn moves(word: String) -> Vec[String] {
    let bytes = word.bytes();
    let n = bytes.len();
    let mut out: Vec[String] = Vec.new();
    for i in 0..n {
        for j in i + 1..n {
            if i % 2 == j % 2 {
                let mut b = bytes.to_vec();
                b.swap(i, j);
                let mut w = String.new();
                for c in b.iter() {
                    w.push(*c as char);
                }
                out.push(w);
            }
        }
    }
    out
}

// every word any number of moves can reach from `word`, by a breadth-first
// search
fn reachable(word: String) -> Set[String] {
    let mut seen: Set[String] = Set.new();
    let mut queue: Vec[String] = Vec.new();
    seen.insert(word.clone());
    queue.push(word.clone());
    let mut head = 0;
    while head < queue.len() {
        let next = moves(queue[head]);
        head += 1;
        for w in next.iter() {
            if not seen.contains(w) {
                seen.insert(w.clone());
                queue.push(w.clone());
            }
        }
    }
    seen
}

// the groups: each word not yet placed starts one, and takes with it every
// later word its moves reach
fn literal(words: Vec[String]) -> i64 {
    let n = words.len();
    let mut placed: Vec[bool] = Vec.filled(n, false);
    let mut groups = 0;
    for i in 0..n {
        if not placed[i] {
            groups += 1;
            let reach = reachable(words[i]);
            for j in i..n {
                if reach.contains(words[j]) {
                    placed[j] = true;
                }
            }
        }
    }
    groups
}

// ---- properties -----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

// a random word of `len` letters from the first `letters` of the alphabet
fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    w
}

// the word with random swaps among its even positions and among its odd
// ones
fn shuffled(seed: mut ref i64, word: String) -> String {
    let mut b = word.bytes().to_vec();
    let n = b.len();
    for _ in 0..n {
        let i = next_random(mut seed) % n;
        let j = next_random(mut seed) % n;
        if i % 2 == j % 2 {
            b.swap(i, j);
        }
    }
    let mut out = String.new();
    for c in b.iter() {
        out.push(*c as char);
    }
    out
}

// P1 to P6 for one case over the five arms (P1 only when `small`).
// Returns the ★ arm's groups.
fn properties(t: mut ref Tally, seed: mut ref i64, words: Vec[String], small: bool) -> i64 {
    let want = if small { literal(words) } else { 0 };
    let n = words.len();
    // the words reversed, and given twice
    let mut reversed: Vec[String] = Vec.new();
    let mut twice = words.clone();
    for i in 0..n {
        reversed.push(words[n - 1 - i].clone());
        twice.push(words[i].clone());
    }
    // each word shuffled within its even and its odd positions, and every
    // letter renamed by one random permutation of the alphabet
    let mut map: Vec[i64] = Vec.new();
    for c in 0..26 {
        map.push(c);
    }
    for i in 1..26 {
        let j = next_random(mut seed) % (i + 1);
        map.swap(i, j);
    }
    let mut moved: Vec[String] = Vec.new();
    let mut renamed: Vec[String] = Vec.new();
    for w in words.iter() {
        moved.push(shuffled(mut seed, w));
        let mut r = String.new();
        for b in w.bytes() {
            r.push((97 + map[(b - 97) as i64]) as u8 as char);
        }
        renamed.push(r);
    }
    // the words cut in two at a random place
    let cut = next_random(mut seed) % (n + 1);
    let mut front: Vec[String] = Vec.new();
    let mut back: Vec[String] = Vec.new();
    for i in 0..n {
        if i < cut {
            front.push(words[i].clone());
        } else {
            back.push(words[i].clone());
        }
    }
    let mut answers: Vec[i64] = Vec.new();
    for x in 0..5 {
        answers.push(arm(x, words));
    }
    for x in 0..5 {
        let got = answers[x];
        // P1: the statement's groups
        if small {
            check(mut t, 1, got == want);
        }
        // P2: between 1 and n groups, the same for the words reversed and
        // for every word given twice
        check(mut t, 2, got >= 1 and got <= n and arm(x, reversed) == got and arm(x, twice) == got);
        // P3: each word moved within its group leaves the groups
        check(mut t, 3, arm(x, moved) == got);
        // P4: every letter renamed the same way leaves the groups
        check(mut t, 4, arm(x, renamed) == got);
        // P5: the two parts have no fewer groups than the whole between
        // them, and neither has more
        let f = if cut > 0 { arm(x, front) } else { 0 };
        let b = if cut < n { arm(x, back) } else { 0 };
        check(mut t, 5, f + b >= got and f <= got and b <= got);
        // P6: the arm agrees with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and answers[y] == got {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    answers[0]
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut seed = 893;
    let mut cases = 0;
    let mut words_in_all = 0;
    let mut groups = 0;
    // up to 8 words of up to 5 letters from 2 or 3 letters against the
    // statement; then up to 100 words of up to 20 letters from 2 to 26;
    // half the words an earlier word moved within its group
    for c in 0..3200 {
        let small = c < 3000;
        let count = if small { 1 + next_random(mut seed) % 8 } else { 1 + next_random(mut seed) % 100 };
        let len = if small { 1 + next_random(mut seed) % 5 } else { 1 + next_random(mut seed) % 20 };
        let letters = if small { 2 + next_random(mut seed) % 2 } else { 2 + next_random(mut seed) % 25 };
        let mut words: Vec[String] = Vec.new();
        for _ in 0..count {
            if words.len() > 0 and next_random(mut seed) % 2 == 0 {
                let k = next_random(mut seed) % words.len();
                words.push(shuffled(mut seed, words[k]));
            } else {
                words.push(random_word(mut seed, len, letters));
            }
        }
        cases += 1;
        words_in_all += count;
        groups += properties(mut t, mut seed, words, small);
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{cases} cases, {words_in_all} words, {groups} groups in all, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
