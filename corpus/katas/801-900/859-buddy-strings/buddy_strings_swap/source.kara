// LeetCode #859: Buddy Strings -- swap-and-compare arm (the first and last
// differences swapped, then the strings compared whole).
//
// If one swap turns `s` into `goal`, it must touch the first and the last
// position where they differ, so the only candidate is the swap of those
// two: this arm makes it on a copy of `s` and compares the copy with
// `goal`. When the strings are equal it looks for a letter that occurs
// twice, keeping the letters met so far in a `Set`. O(n) time and space.

fn buddy_strings(s: String, goal: String) -> bool {
    let a = s.bytes();
    let b = goal.bytes();
    let n = a.len();
    if n != b.len() {
        return false;
    }
    let mut i = 0;
    while i < n and a[i] == b[i] {
        i += 1;
    }
    if i == n {
        let mut seen: Set[u8] = Set.new();
        for c in a {
            if not seen.insert(*c) {
                return true;
            }
        }
        return false;
    }
    let mut j = n - 1;
    while a[j] == b[j] {
        j -= 1;
    }
    if i == j {
        return false;
    }
    let mut t: Vec[u8] = a.to_vec();
    t.swap(i, j);
    for k in 0..n {
        if t[k] != b[k] {
            return false;
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn show(s: String, goal: String) {
    println(f"s = \"{s}\", goal = \"{goal}\" -> {buddy_strings(s, goal)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letter(i: i64) -> char {
    (97 + i) as u8 as char
}

// `n` letters, each one of the first `k`
fn random_text(seed: mut ref i64, n: i64, k: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(letter(next_random(mut seed) % k));
    }
    s
}

// `s` changed by one of five edits, chosen at random: left as it is, two
// positions swapped, three positions rotated, one letter changed, or one
// letter dropped from the end
fn edited(seed: mut ref i64, s: String, k: i64) -> String {
    let mut cs: Vec[char] = s.chars().collect();
    let n = cs.len();
    let edit = next_random(mut seed) % 5;
    if edit == 1 {
        let i = next_random(mut seed) % n;
        let j = next_random(mut seed) % n;
        cs.swap(i, j);
    } else if edit == 2 and n >= 3 {
        let i = next_random(mut seed) % (n - 2);
        let t = cs[i];
        cs[i] = cs[i + 1];
        cs[i + 1] = cs[i + 2];
        cs[i + 2] = t;
    } else if edit == 3 {
        let i = next_random(mut seed) % n;
        cs[i] = letter(next_random(mut seed) % k);
    } else if edit == 4 {
        cs.pop();
    }
    let mut out = String.new();
    for c in cs {
        out.push(c);
    }
    out
}

fn main() {
    show("ab", "ba");
    show("ab", "ab");
    show("aa", "aa");
    show("aaaaaaabc", "aaaaaaacb");
    show("a", "a");
    show("a", "b");
    show("abc", "ab");
    show("abcd", "badc");
    show("abcd", "abdc");
    show("abab", "abab");
    show("abc", "abc");
    show("abc", "acd");
    show("abac", "abad");
    show("ab", "ca");
    // every pair of strings of length 3 over three letters
    let mut words: Vec[String] = Vec.new();
    for x in 0..27 {
        let mut w = String.new();
        w.push(letter(x / 9));
        w.push(letter(x / 3 % 3));
        w.push(letter(x % 3));
        words.push(w);
    }
    let mut buddies = 0;
    for s in words.iter() {
        for g in words.iter() {
            if buddy_strings(s, g) {
                buddies += 1;
            }
        }
    }
    println(f"all 729 pairs of length 3 over three letters: {buddies} are buddies");
    let mut seed = 859;
    let mut total = 0;
    let mut check = 0;
    for r in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let k = 1 + next_random(mut seed) % 26;
        let s = random_text(mut seed, n, k);
        let goal = edited(mut seed, s, k);
        let yes = buddy_strings(s, goal);
        if yes {
            total += 1;
        }
        check = (check * 31 + if yes { r + 2 } else { 1 }) % 1000000007;
    }
    println(f"2000 random pairs: {total} are buddies, checksum {check}");
}
