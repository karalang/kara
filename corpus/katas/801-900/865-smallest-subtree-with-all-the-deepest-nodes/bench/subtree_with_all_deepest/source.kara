// LeetCode #865: Smallest Subtree with all the Deepest Nodes -- bench
// program: the ★ arm, one recursive pass.
//
// `deepest(node)` returns how deep the subtree under `node` goes and the
// root of the smallest subtree holding all of that subtree's deepest
// nodes. When both children go equally deep, deepest nodes lie on both
// sides and only the node itself holds them all; otherwise the answer is
// the deeper child's. O(n) time, O(height) stack.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn subtree_with_all_deepest(root: Option[TreeNode]) -> Option[TreeNode] {
    let (_, node) = deepest(root);
    node
}

fn deepest(node: Option[TreeNode]) -> (i64, Option[TreeNode]) {
    match node {
        None => (0, None),
        Some(n) => {
            let (dl, l) = deepest(n.left);
            let (dr, r) = deepest(n.right);
            if dl == dr {
                (dl + 1, Some(n))
            } else if dl > dr {
                (dl + 1, l)
            } else {
                (dr + 1, r)
            }
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random tree of n nodes holding the values 0 to n - 1 in a random
// order: each new node hangs from a random node with a free side.
fn random_tree(seed: mut ref i64, n: i64) -> Option[TreeNode] {
    let mut vals: Vec[i64] = Vec.new();
    for v in 0..n {
        vals.push(v);
    }
    for i in 1..n {
        let j = next_random(mut seed) % (i + 1);
        vals.swap(i, j);
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for k in 0..n {
        let node = TreeNode { val: vals[k], left: None, right: None };
        if k > 0 {
            loop {
                let parent = nodes[next_random(mut seed) % nodes.len()];
                if next_random(mut seed) % 2 == 0 {
                    if parent.left.is_none() {
                        parent.left = Some(node);
                        break;
                    }
                } else if parent.right.is_none() {
                    parent.right = Some(node);
                    break;
                }
            }
        }
        nodes.push(node);
    }
    if n == 0 { None } else { Some(nodes[0]) }
}

// A random tree of 500 nodes, LeetCode's largest, built once; each round
// hangs a new leaf on a random node with a free side, finds the smallest
// subtree with all the deepest nodes, and takes the leaf off again.
fn main() {
    let n = 500;
    let rounds = 300000;
    let mut seed = 865;
    let root = random_tree(mut seed, n);
    let mut nodes: Vec[TreeNode] = Vec.new();
    let mut stack: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        stack.push(r);
    }
    while let Some(node) = stack.pop() {
        nodes.push(node);
        if let Some(child) = node.left {
            stack.push(child);
        }
        if let Some(child) = node.right {
            stack.push(child);
        }
    }
    let leaf = TreeNode { val: n, left: None, right: None };
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        let mut at = nodes[next_random(mut seed) % n];
        while at.left.is_some() and at.right.is_some() {
            at = nodes[next_random(mut seed) % n];
        }
        let on_left = at.left.is_none();
        if on_left {
            at.left = Some(leaf);
        } else {
            at.right = Some(leaf);
        }
        let found = match subtree_with_all_deepest(root) {
            Some(f) => f.val,
            None => -1,
        };
        if on_left {
            at.left = None;
        } else {
            at.right = None;
        }
        total += found;
        check = (check * 31 + found + 1) % 1000000007;
    }
    println(f"{rounds} rounds on {n} nodes: answers sum to {total}, checksum {check}");
}
