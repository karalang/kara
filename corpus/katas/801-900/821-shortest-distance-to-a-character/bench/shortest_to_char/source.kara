// Benchmark for #821: Shortest Distance to a Character -- the ★ arm (two sweeps).
//
// A sweep from the left keeps the last `c` seen and a sweep from the
// right the first, and each place keeps the nearer of the two. O(n) for
// n characters.

fn shortest_to_char(s: Str, c: char) -> Vec[i64] {
    let chars: Vec[char] = s.chars().collect();
    let n = chars.len();
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    // A place no `c` has been seen from yet is n or more away.
    let mut last = -n;
    for i in 0..n {
        if chars[i] == c {
            last = i;
        }
        answer[i] = i - last;
    }
    last = 2 * n;
    for i in (0..n).rev() {
        if chars[i] == c {
            last = i;
        }
        answer[i] = answer[i].min(last - i);
    }
    answer
}

// ---- benchmark --------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 strings of 10,000 random letters, LeetCode's largest, each with
    // a letter to look for, drawn once. Each round answers the next one.
    let count = 64;
    let rounds = 50000;
    let mut seed: i64 = 821;
    let mut strings: Vec[String] = Vec.new();
    let mut targets: Vec[char] = Vec.new();
    for _ in 0..count {
        let mut s = String.new();
        for _ in 0..10000 {
            s.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
        }
        strings.push(s);
        targets.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        let g = round % count;
        let answer = shortest_to_char(strings[g].as_str(), targets[g]);
        for d in answer.iter() {
            total += d;
        }
        checksum = (checksum * 131 + answer[round % 10000]) % 1000000007;
    }
    println(f"{rounds} rounds of {count} strings: total {total}, checksum {checksum}");
}
