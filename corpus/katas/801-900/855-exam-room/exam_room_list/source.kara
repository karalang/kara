// LeetCode #855: Exam Room -- the taken seats in a sorted vector.
//
// The taken seats are kept sorted in a plain vector. Seating looks at the
// two ends and at every pair of neighbours through `windows(2)`, takes
// the first gap that is worth the most (an end gap its whole width, a gap
// between two students half of it), and inserts the seat where a binary
// search says it belongs. Leaving finds the seat by binary search and
// removes it.

struct ExamRoom {
    n: i64,
    taken: Vec[i64],
}

impl ExamRoom {
    fn new(n: i64) -> ExamRoom {
        ExamRoom { n: n, taken: Vec.new() }
    }

    fn seat(mut ref self) -> i64 {
        if self.taken.is_empty() {
            self.taken.push(0);
            return 0;
        }
        let first = self.taken[0];
        let mut best = first;
        let mut best_seat = 0;
        for w in self.taken.windows(2) {
            let half = (w[1] - w[0]) / 2;
            if half > best {
                best = half;
                best_seat = w[0] + half;
            }
        }
        let last = self.taken[self.taken.len() - 1];
        if self.n - 1 - last > best {
            best_seat = self.n - 1;
        }
        // the first position whose seat is above the new one
        let mut lo = 0;
        let mut hi = self.taken.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.taken[mid] < best_seat {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        self.taken.insert(lo, best_seat);
        best_seat
    }

    fn leave(mut ref self, p: i64) {
        let at = self.taken.binary_search(p).unwrap();
        self.taken.remove(at);
    }
}

// ---- test harness ---------------------------------------------------------

// Runs one room. A call is `-1` for `seat()` and `p` for `leave(p)`; the
// seats returned are printed in order.
fn show(n: i64, calls: Vec[i64]) {
    let mut room = ExamRoom.new(n);
    let mut said: Vec[String] = Vec.new();
    let mut got: Vec[String] = Vec.new();
    for c in calls.iter() {
        if *c == -1 {
            said.push("seat");
            got.push(f"{room.seat()}");
        } else {
            said.push(f"leave {*c}");
            room.leave(*c);
        }
    }
    println(f"ExamRoom({n}): {said.join(", ")} -> {got.join(" ")}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random calls on a room of `n` seats: a seat when the room is
// empty, a leave when it is full, and otherwise a seat two times in
// three. Returns the sum of the seats given and a checksum of them.
fn random_room(seed: mut ref i64, n: i64, count: i64) -> (i64, i64) {
    let mut room = ExamRoom.new(n);
    let mut seated: Vec[i64] = Vec.new();
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let full = seated.len() == n;
        if not full and (seated.is_empty() or next_random(mut seed) % 3 != 0) {
            let p = room.seat();
            seated.push(p);
            total += p;
            check = (check * 31 + p) % 1000000007;
        } else {
            let i = next_random(mut seed) % seated.len();
            let p = seated.swap_remove(i);
            room.leave(p);
        }
    }
    (total, check)
}

fn main() {
    let s = -1;
    show(10, [s, s, s, s, 4, s]);
    show(1, [s]);
    show(1, [s, 0, s]);
    show(2, [s, s]);
    show(3, [s, s, s]);
    show(4, [s, s, s, s]);
    show(5, [s, s, s, s]);
    show(10, [s, s, s, 0, s]);
    show(10, [s, s, s, s, 9, s]);
    show(8, [s, s, s, 0, 7, s, s]);
    show(1000000000, [s, s, s, s]);
    let mut seed = 855;
    let (big_total, big_check) = random_room(mut seed, 1000000000, 2000);
    println(f"a room of 10^9 seats, 2000 random calls: seats sum to {big_total}, checksum {big_check}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let count = 1 + next_random(mut seed) % 60;
        let (t, c) = random_room(mut seed, n, count);
        total += t;
        check = (check * 31 + c) % 1000000007;
    }
    println(f"300 random rooms: seats sum to {total}, checksum {check}");
}
