// LeetCode #855: Exam Room -- the ★ arm (the taken seats in a sorted set,
// scanned for the widest gap).
//
// The taken seats are kept in a sorted set. To seat a student, walk them
// in order: the gap before the first taken seat is worth its whole
// width, since the student sits at seat 0; a gap between two taken
// seats is worth half its width, since the student sits in the middle;
// the gap after the last is worth its whole width again. The first gap
// worth the most wins, which is also the lowest seat. Leaving removes the
// seat from the set.

struct ExamRoom {
    n: i64,
    taken: SortedSet[i64],
}

impl ExamRoom {
    fn new(n: i64) -> ExamRoom {
        ExamRoom { n: n, taken: SortedSet.new() }
    }

    fn seat(mut ref self) -> i64 {
        let mut best = 0;
        let mut best_seat = 0;
        let mut prev = -1;
        for p in self.taken.iter() {
            let p = *p;
            if prev == -1 {
                // the gap before the first taken seat
                best = p;
                best_seat = 0;
            } else if (p - prev) / 2 > best {
                best = (p - prev) / 2;
                best_seat = prev + (p - prev) / 2;
            }
            prev = p;
        }
        if prev == -1 {
            best_seat = 0;
        } else if self.n - 1 - prev > best {
            best_seat = self.n - 1;
        }
        self.taken.insert(best_seat);
        best_seat
    }

    fn leave(mut ref self, p: i64) {
        self.taken.remove(p);
    }
}

// ---- test harness ---------------------------------------------------------

// Runs one room. A call is `-1` for `seat()` and `p` for `leave(p)`; the
// seats returned are printed in order.
fn show(n: i64, calls: Vec[i64]) {
    let mut room = ExamRoom.new(n);
    let mut said: Vec[String] = Vec.new();
    let mut got: Vec[String] = Vec.new();
    for c in calls.iter() {
        if *c == -1 {
            said.push("seat");
            got.push(f"{room.seat()}");
        } else {
            said.push(f"leave {*c}");
            room.leave(*c);
        }
    }
    println(f"ExamRoom({n}): {said.join(", ")} -> {got.join(" ")}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random calls on a room of `n` seats: a seat when the room is
// empty, a leave when it is full, and otherwise a seat two times in
// three. Returns the sum of the seats given and a checksum of them.
fn random_room(seed: mut ref i64, n: i64, count: i64) -> (i64, i64) {
    let mut room = ExamRoom.new(n);
    let mut seated: Vec[i64] = Vec.new();
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let full = seated.len() == n;
        if not full and (seated.is_empty() or next_random(mut seed) % 3 != 0) {
            let p = room.seat();
            seated.push(p);
            total += p;
            check = (check * 31 + p) % 1000000007;
        } else {
            let i = next_random(mut seed) % seated.len();
            let p = seated.swap_remove(i);
            room.leave(p);
        }
    }
    (total, check)
}

fn main() {
    let s = -1;
    show(10, [s, s, s, s, 4, s]);
    show(1, [s]);
    show(1, [s, 0, s]);
    show(2, [s, s]);
    show(3, [s, s, s]);
    show(4, [s, s, s, s]);
    show(5, [s, s, s, s]);
    show(10, [s, s, s, 0, s]);
    show(10, [s, s, s, s, 9, s]);
    show(8, [s, s, s, 0, 7, s, s]);
    show(1000000000, [s, s, s, s]);
    let mut seed = 855;
    let (big_total, big_check) = random_room(mut seed, 1000000000, 2000);
    println(f"a room of 10^9 seats, 2000 random calls: seats sum to {big_total}, checksum {big_check}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let count = 1 + next_random(mut seed) % 60;
        let (t, c) = random_room(mut seed, n, count);
        total += t;
        check = (check * 31 + c) % 1000000007;
    }
    println(f"300 random rooms: seats sum to {total}, checksum {check}");
}
