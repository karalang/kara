// LeetCode #857: Minimum Cost to Hire K Workers -- every worker as the
// one who sets the rate.
//
// Some worker in the cheapest group has the highest `wage / quality` and
// sets the rate. So try every worker as that one: the others it can hire
// are those whose rate is no higher, and the cheapest group takes the
// k - 1 smallest of their qualities besides its own. O(n^2 log n).

fn mincost_to_hire_workers(quality: Vec[i64], wage: Vec[i64], k: i64) -> f64 {
    let n = quality.len();
    let mut best_num = -1;
    let mut best_den = 1;
    for c in 0..n {
        let mut others: Vec[i64] = Vec.new();
        for j in 0..n {
            if j != c and wage[j] * quality[c] <= wage[c] * quality[j] {
                others.push(quality[j]);
            }
        }
        if others.len() < k - 1 {
            continue;
        }
        others.sort();
        let sum = quality[c] + others.iter().take(k - 1).sum();
        let num = wage[c] * sum;
        let den = quality[c];
        if best_num < 0 or num * best_den < best_num * den {
            best_num = num;
            best_den = den;
        }
    }
    best_num as f64 / best_den as f64
}

// ---- test harness ---------------------------------------------------------

fn show(quality: Vec[i64], wage: Vec[i64], k: i64) {
    let cost = mincost_to_hire_workers(quality, wage, k);
    println(f"quality = {quality}, wage = {wage}, k = {k} -> {cost:.5}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` random workers, quality from 1 to `top_q` and wage from 1 to `top_w`.
fn random_workers(seed: mut ref i64, n: i64, top_q: i64, top_w: i64) -> (Vec[i64], Vec[i64]) {
    let mut quality: Vec[i64] = Vec.new();
    let mut wage: Vec[i64] = Vec.new();
    for _ in 0..n {
        quality.push(1 + next_random(mut seed) % top_q);
        wage.push(1 + next_random(mut seed) % top_w);
    }
    (quality, wage)
}

fn main() {
    show([10, 20, 5], [70, 50, 30], 2);
    show([3, 1, 10, 10, 1], [4, 8, 2, 2, 7], 3);
    show([7], [13], 1);
    show([5, 5, 5], [10, 10, 10], 3);
    show([4, 2, 8], [8, 4, 16], 2);
    show([1, 10000], [10000, 1], 1);
    show([1, 10000], [10000, 1], 2);
    show([3, 1, 4, 1, 5, 9, 2, 6], [2, 7, 1, 8, 2, 8, 1, 8], 4);
    show([10000, 10000, 10000], [10000, 10000, 10000], 2);
    let mut seed = 857;
    let (quality, wage) = random_workers(mut seed, 1000, 10000, 10000);
    let k = 300;
    println(f"1000 random workers, k = 300 -> {mincost_to_hire_workers(quality, wage, k):.5}");
    let mut total = 0.0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let k = 1 + next_random(mut seed) % n;
        let top = 1 + next_random(mut seed) % 100;
        let (quality, wage) = random_workers(mut seed, n, top, top);
        total += mincost_to_hire_workers(quality, wage, k);
    }
    println(f"300 random groups of up to 30 workers: costs sum to {total:.5}");
}
