// Benchmark for #852: Peak Index in a Mountain Array -- the ★ arm (binary
// search on the slope).
//
// Left of the peak each value is smaller than the next, and from the
// peak on each is larger, so whether `arr[mid] < arr[mid + 1]` says
// which side of the peak `mid` is on. Halve the range around the peak
// until it holds one index. O(log n) time.

fn peak_index_in_mountain_array(arr: Vec[i64]) -> i64 {
    let mut lo = 0;
    let mut hi = arr.len() - 1;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if arr[mid] < arr[mid + 1] {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 mountains drawn once, each of LeetCode's most values, 10^5:
    // mountain `g` rises and falls by steps of 1 to `1 + g % 10` around a
    // random peak, and is moved up so that its lowest value is 0. Each
    // round asks the next mountain.
    let count = 64;
    let rounds = 30000000;
    let n = 100000;
    let mut seed: i64 = 852;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for g in 0..count {
        let step = 1 + g % 10;
        let peak = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % (n - 2);
        let mut arr: Vec[i64] = Vec.new();
        let mut v = 0;
        let mut low = 0;
        for i in 0..n {
            if i > 0 {
                if i <= peak {
                    v += 1 + next_random(mut seed) % step;
                } else {
                    v -= 1 + next_random(mut seed) % step;
                }
            }
            arr.push(v);
            low = low.min(v);
        }
        for i in 0..n {
            arr[i] -= low;
        }
        arrays.push(arr);
    }
    let mut total = 0;
    let mut checksum = 0;
    for round in 0..rounds {
        let p = peak_index_in_mountain_array(arrays[round % count]);
        total += p;
        checksum = (checksum * 31 + p) % 1000000007;
    }
    println(f"{rounds} rounds of {count} mountains: peaks sum to {total}, checksum {checksum}");
}
