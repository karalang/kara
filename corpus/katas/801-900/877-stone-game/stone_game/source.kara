// LeetCode #877: Stone Game -- the best margin of every run of piles.
//
// Whoever moves on the piles i..j takes pile i or pile j and leaves the
// other player to move on the rest, so the best margin the mover can
// reach over the other player is
// margin[i][j] = max(piles[i] - margin[i + 1][j], piles[j] - margin[i][j - 1]),
// filled in for runs of growing length. Alice moves first and wins when
// her margin over the whole row is above 0. O(n^2) time and space.

fn stone_game(piles: Vec[i64]) -> bool {
    let n = piles.len();
    let mut margin: Vec[Vec[i64]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..n {
            row.push(if i == j { piles[i] } else { 0 });
        }
        margin.push(row);
    }
    for length in 2..n + 1 {
        for i in 0..n - length + 1 {
            let j = i + length - 1;
            margin[i][j] = (piles[i] - margin[i + 1][j]).max(piles[j] - margin[i][j - 1]);
        }
    }
    margin[0][n - 1] > 0
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n piles of 1 to limit stones with an odd total, LeetCode's constraints
// for an even n
fn random_piles(seed: mut ref i64, n: i64, limit: i64) -> Vec[i64] {
    let mut piles: Vec[i64] = Vec.new();
    let mut total = 0;
    for _ in 0..n {
        let p = next_random(mut seed) % limit + 1;
        piles.push(p);
        total += p;
    }
    if total % 2 == 0 {
        let i = next_random(mut seed) % n;
        piles[i] = if piles[i] == limit { piles[i] - 1 } else { piles[i] + 1 };
    }
    piles
}

fn show(piles: Vec[i64]) {
    let mut text: Vec[String] = Vec.new();
    for p in piles.iter() {
        text.push(f"{p}");
    }
    let shown = if text.len() > 8 { f"{text[0]}, {text[1]}, ... ({text.len()} piles)" } else { text.join(", ") };
    println(f"piles = [{shown}] -> {stone_game(piles)}");
}

fn main() {
    show([5, 3, 4, 5]);
    show([3, 7, 2, 3]);
    show([1, 2]);
    show([2, 1]);
    show([1, 100, 2, 1]);
    show([500, 1, 1, 1]);
    show([1, 1, 1, 500]);
    show([2, 9, 1, 1, 1, 7]);
    let mut big: Vec[i64] = Vec.new();
    for i in 0..500 {
        big.push(if i == 0 { 500 } else { 499 + i % 2 });
    }
    show(big);
    // LeetCode's sizes: an even number of piles from 2 to 500, an odd total
    let mut seed = 877;
    let mut wins = 0;
    let mut check = 0;
    for k in 0..100 {
        let n = if k < 20 { 2 * (k + 1) } else { 2 * (next_random(mut seed) % 250 + 1) };
        let limit = if k % 2 == 0 { 500 } else { 3 };
        let answer = stone_game(random_piles(mut seed, n, limit));
        if answer {
            wins += 1;
        }
        check = (check * 3 + if answer { 1 } else { 2 }) % 1000000007;
    }
    println(f"100 games of 2 to 500 piles: Alice wins {wins}, checksum {check}");
}
