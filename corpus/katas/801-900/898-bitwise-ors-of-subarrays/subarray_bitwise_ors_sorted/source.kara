// LeetCode #898: Bitwise ORs of Subarrays -- lists in place of sets, and
// one sort.
//
// The ORs ending at i, from the shortest subarray to the longest, only
// gain bits, so they rise; a list of the different ones stays in rising
// order when arr[i] is put into each, and repeats sit side by side. Keep
// that list from place to place, append each to one long list, and
// count the different values in it after sorting it. O(n * 31 * log).

fn subarray_bitwise_ors(arr: Vec[i64]) -> i64 {
    let mut every: Vec[i64] = Vec.new();
    let mut ending: Vec[i64] = Vec.new();
    for x in arr.iter() {
        let mut next: Vec[i64] = Vec.new();
        next.push(*x);
        for y in ending.iter() {
            let v = *y | *x;
            if v != next[next.len() - 1] {
                next.push(v);
            }
        }
        for v in next.iter() {
            every.push(*v);
        }
        ending = next;
    }
    every.sort();
    let mut count = 0;
    for i in 0..every.len() {
        if i == 0 or every[i] != every[i - 1] {
            count += 1;
        }
    }
    count
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(arr: Vec[i64]) {
    println(f"arr = {arr} -> {subarray_bitwise_ors(arr)}");
}

// `len` random numbers below 2^bits; with `sparse`, each is AND-ed with a
// second one, so it has about a quarter of the bits rather than half
fn random_case(seed: mut ref i64, len: i64, bits: i64, sparse: bool) -> Vec[i64] {
    let mask = (1 << bits) - 1;
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..len {
        let mut v = (next_random(mut seed) * 32768 + next_random(mut seed)) & mask;
        if sparse {
            v = v & (next_random(mut seed) * 32768 + next_random(mut seed));
        }
        arr.push(v);
    }
    arr
}

fn main() {
    show([0]);
    show([1, 1, 2]);
    show([1, 2, 4]);
    show([0, 0, 0]);
    show([7, 7, 7, 7]);
    show([1, 2, 4, 8, 16, 32, 64, 128]);
    show([3, 5, 6, 0, 1]);
    show([1000000000, 0, 999999999, 536870912]);
    // random cases of up to 1000 numbers, a third of them up to 8, below
    // 2^1 to 2^30, half of them sparse
    let mut seed = 898;
    let mut total = 0;
    let mut check = 0;
    for c in 0..300 {
        let len = if c % 3 == 0 { 1 + next_random(mut seed) % 8 } else { 1 + next_random(mut seed) % 1000 };
        let bits = 1 + next_random(mut seed) % 30;
        let got = subarray_bitwise_ors(random_case(mut seed, len, bits, c % 2 == 0));
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"300 cases of up to 1000 numbers: {total} ORs in all, checksum {check}");
    // LeetCode's largest: 50000 numbers up to 10^9, and 50000 below 2^12
    let mut big: Vec[i64] = Vec.new();
    for _ in 0..50000 {
        big.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001);
    }
    println(f"50000 numbers up to 10^9 -> {subarray_bitwise_ors(big)}");
    println(f"50000 sparse numbers below 2^12 -> {subarray_bitwise_ors(random_case(mut seed, 50000, 12, true))}");
}
