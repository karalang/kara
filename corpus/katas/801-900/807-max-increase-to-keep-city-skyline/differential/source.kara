// LeetCode #807: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties
// on random grids.

// ---- ★ arm ----------------------------------------------------------

fn max_increase_keeping_skyline_star(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut row_max: Vec[i64] = Vec.new();
    let mut col_max: Vec[i64] = Vec.new();
    for _ in 0..n {
        row_max.push(0);
        col_max.push(0);
    }
    for i in 0..n {
        for j in 0..n {
            row_max[i] = row_max[i].max(grid[i][j]);
            col_max[j] = col_max[j].max(grid[i][j]);
        }
    }
    let mut total = 0;
    for i in 0..n {
        for j in 0..n {
            total += row_max[i].min(col_max[j]) - grid[i][j];
        }
    }
    total
}

// ---- iter arm -------------------------------------------------------

fn max_increase_keeping_skyline_iter(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let row_max: Vec[i64] = grid.iter().map(|row| row.iter().fold(0, |m, h| m.max(h))).collect();
    let col_max: Vec[i64] = (0..n).map(|j| grid.iter().fold(0, |m, row| m.max(row[j]))).collect();
    (0..n)
        .map(|i| (0..n).map(|j| row_max[i].min(col_max[j]) - grid[i][j]).sum())
        .sum()
}

// ---- transpose arm --------------------------------------------------

fn row_maxima_transpose(grid: Vec[Vec[i64]]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for row in grid.iter() {
        let mut best = 0;
        for h in row.iter() {
            if h > best {
                best = h;
            }
        }
        out.push(best);
    }
    out
}

fn max_increase_keeping_skyline_transpose(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut turned: Vec[Vec[i64]] = Vec.new();
    for j in 0..n {
        let mut column: Vec[i64] = Vec.new();
        for i in 0..n {
            column.push(grid[i][j]);
        }
        turned.push(column);
    }
    let rows = row_maxima_transpose(grid);
    let cols = row_maxima_transpose(turned);
    let mut total = 0;
    for i in 0..n {
        for j in 0..n {
            let cap = if rows[i] < cols[j] { rows[i] } else { cols[j] };
            total += cap - grid[i][j];
        }
    }
    total
}

// ---- scan arm -------------------------------------------------------

fn max_increase_keeping_skyline_scan(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut total = 0;
    for i in 0..n {
        for j in 0..n {
            let mut across = 0;
            let mut down = 0;
            for k in 0..n {
                across = across.max(grid[i][k]);
                down = down.max(grid[k][j]);
            }
            total += across.min(down) - grid[i][j];
        }
    }
    total
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer_with(which: i64, grid: Vec[Vec[i64]]) -> i64 {
    if which == 0 {
        max_increase_keeping_skyline_star(grid)
    } else if which == 1 {
        max_increase_keeping_skyline_iter(grid)
    } else if which == 2 {
        max_increase_keeping_skyline_transpose(grid)
    } else {
        max_increase_keeping_skyline_scan(grid)
    }
}

// The skyline from the four sides: the tallest of each row, then the
// tallest of each column.
fn skyline(grid: Vec[Vec[i64]]) -> Vec[i64] {
    let n = grid.len();
    let mut out: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut best = 0;
        for j in 0..n {
            if grid[i][j] > best {
                best = grid[i][j];
            }
        }
        out.push(best);
    }
    for j in 0..n {
        let mut best = 0;
        for i in 0..n {
            if grid[i][j] > best {
                best = grid[i][j];
            }
        }
        out.push(best);
    }
    out
}

// The definition, by trying: raise one building by one floor and keep it
// if the skyline is unchanged, sweeping the grid until no building can
// grow. Returns the floors added and the grid it ends with.
fn definition(grid: Vec[Vec[i64]]) -> (i64, Vec[Vec[i64]]) {
    let n = grid.len();
    let want = skyline(grid);
    let mut city = grid.clone();
    let mut added = 0;
    let mut grew = true;
    while grew {
        grew = false;
        for i in 0..n {
            for j in 0..n {
                city[i][j] += 1;
                if skyline(city) == want {
                    added += 1;
                    grew = true;
                } else {
                    city[i][j] -= 1;
                }
            }
        }
    }
    (added, city)
}

fn main() {
    let arms = 4;
    let mut seed = 8070;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1600;
    let mut total = 0;
    for case in 0..cases {
        // kind 0: heights 0 to 9; kind 1: heights 0 to 2, so that maxima
        // tie; kind 2: mostly 0 with a few tall buildings; kind 3: one row
        // or one column of the grid kept, the rest 0.
        let kind = case % 4;
        let n = 1 + next_random(mut seed) % 5;
        let keep = next_random(mut seed) % n;
        let by_row = next_random(mut seed) % 2 == 0;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for i in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for j in 0..n {
                let h = if kind == 0 {
                    next_random(mut seed) % 10
                } else if kind == 1 {
                    next_random(mut seed) % 3
                } else if kind == 2 {
                    if next_random(mut seed) % 4 == 0 { 5 + next_random(mut seed) % 5 } else { 0 }
                } else {
                    let h = next_random(mut seed) % 10;
                    if (by_row and i == keep) or (not by_row and j == keep) { h } else { 0 }
                };
                row.push(h);
            }
            grid.push(row);
        }
        let (want, raised) = definition(grid);
        total += want;
        let mut turned: Vec[Vec[i64]] = Vec.new();
        let mut flipped: Vec[Vec[i64]] = Vec.new();
        let mut lifted: Vec[Vec[i64]] = Vec.new();
        let mut doubled: Vec[Vec[i64]] = Vec.new();
        let lift = 1 + next_random(mut seed) % 5;
        for i in 0..n {
            let mut t: Vec[i64] = Vec.new();
            let mut l: Vec[i64] = Vec.new();
            let mut d: Vec[i64] = Vec.new();
            for j in 0..n {
                t.push(grid[j][i]);
                l.push(grid[i][j] + lift);
                d.push(grid[i][j] * 2);
            }
            turned.push(t);
            lifted.push(l);
            doubled.push(d);
            flipped.push(grid[n - 1 - i].clone());
        }
        for which in 0..arms {
            let got = answer_with(which, grid);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the grid turned on its diagonal, or with its rows in the
            // other order, has the same skyline headroom.
            checks += 1;
            if answer_with(which, turned) != got or answer_with(which, flipped) != got {
                fails[1] += 1;
            }
            // P3: every building the same number of floors taller gives the
            // same answer, and every building twice as tall, twice it.
            checks += 1;
            if answer_with(which, lifted) != got or answer_with(which, doubled) != 2 * got {
                fails[2] += 1;
            }
            // P4: the city the definition ends with has no room left.
            checks += 1;
            if answer_with(which, raised) != 0 {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut failures = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
            failures += fails[p];
        }
    }
    println(f"{report}{cases} cases ({total} floors), {arms} arms, {checks} checks, {failures} failures");
}
