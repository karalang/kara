// LeetCode #842: Split Array into Fibonacci Sequence -- whole strings.
//
// For each choice of the first two numbers, shortest first, the sequence
// they start is written out as one string, sum after sum, for as long as
// it is shorter than the input and the sums stay within 2^31 - 1. The
// split is found when that string is the input itself and holds at least
// three numbers. Only the first two numbers are read from the input, so
// only they are checked for a leading 0; every sum is written without
// one.

fn split_into_fibonacci(num: String) -> Vec[i64] {
    let n = num.len();
    let chars: Vec[char] = num.chars().collect();
    for i in 1..11 {
        for j in 1..11 {
            if i + j >= n {
                break;
            }
            if (i > 1 and chars[0] == '0') or (j > 1 and chars[i] == '0') {
                continue;
            }
            let mut a = 0;
            for k in 0..i {
                a = a * 10 + chars[k].to_digit(10).unwrap() as i64;
            }
            let mut b = 0;
            for k in i..i + j {
                b = b * 10 + chars[k].to_digit(10).unwrap() as i64;
            }
            if a > 2147483647 or b > 2147483647 {
                continue;
            }
            let mut seq: Vec[i64] = [a, b];
            let mut written = f"{a}{b}";
            while written.len() < n {
                let c = seq[seq.len() - 1] + seq[seq.len() - 2];
                if c > 2147483647 {
                    break;
                }
                written.push_str(c.to_string());
                seq.push(c);
            }
            if seq.len() >= 3 and written == num {
                return seq;
            }
        }
    }
    Vec.new()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a Fibonacci-like sequence from a and b written out while it stays
// within `limit` digits and 2^31 - 1, then, once in `spoil` strings, one
// digit changed
fn random_string(seed: mut ref i64, a: i64, b: i64, limit: i64, spoil: i64) -> String {
    let mut s = f"{a}{b}";
    let mut x = a;
    let mut y = b;
    loop {
        let z = x + y;
        let w = z.to_string();
        if z > 2147483647 or s.len() + w.len() > limit {
            break;
        }
        s.push_str(w);
        x = y;
        y = z;
    }
    if next_random(mut seed) % spoil == 0 {
        let mut cs: Vec[char] = s.chars().collect();
        let at = next_random(mut seed) % cs.len();
        cs[at] = (48 + next_random(mut seed) % 10) as u8 as char;
        s = String.new();
        for c in cs {
            s.push(c);
        }
    }
    s
}

fn show(num: String) {
    println(f"\"{num}\" -> {split_into_fibonacci(num)}");
}

fn main() {
    show("1101111");
    show("112358130");
    show("0123");
    show("123456579");
    show("11235813");
    show("000");
    show("0000");
    show("101");
    show("1");
    show("10");
    show("1011");
    show("214748364721474836422147483641");
    show("2147483647021474836472147483647");
    show("1023");
    // long strings, up to LeetCode's longest, 200 digits
    let mut seed = 842;
    let long = random_string(mut seed, 1, 1, 200, 1000000);
    println(f"{long.len()} digits from 1, 1: {split_into_fibonacci(long).len()} numbers");
    let long = random_string(mut seed, 0, 0, 200, 1000000);
    println(f"{long.len()} digits from 0, 0: {split_into_fibonacci(long).len()} numbers");
    let long = random_string(mut seed, 98765, 43210, 200, 1000000);
    println(f"{long.len()} digits from 98765, 43210: {split_into_fibonacci(long)}");
    let mut found = 0;
    let mut check = 0;
    for _ in 0..300 {
        let a = next_random(mut seed) % [10, 1000, 100000][next_random(mut seed) % 3];
        let b = next_random(mut seed) % [10, 1000, 100000][next_random(mut seed) % 3];
        let limit = 3 + next_random(mut seed) % 60;
        let s = random_string(mut seed, a, b, limit, 3);
        let seq = split_into_fibonacci(s);
        if seq.len() > 0 {
            found += 1;
        }
        for x in seq.iter() {
            check = (check * 31 + *x) % 1000000007;
        }
        check = (check * 31 + seq.len()) % 1000000007;
    }
    println(f"300 random strings: {found} split, checksum {check}");
}
