// LeetCode #868: Binary Gap -- bench program: the ★ arm (one pass over
// the bits) on every n from 1 to 10,000,000.
//
// The bits are read from the lowest up, remembering where the last 1
// was; each 1 after the first is adjacent to that one, every bit between
// them being 0, so the distance from it is a candidate. O(log n).

fn binary_gap(n: i64) -> i64 {
    let mut best = 0;
    let mut last = -1;
    let mut rest = n;
    let mut position = 0;
    while rest > 0 {
        if rest % 2 == 1 {
            if last >= 0 {
                best = best.max(position - last);
            }
            last = position;
        }
        rest /= 2;
        position += 1;
    }
    best
}

fn main() {
    let limit = 10000000;
    let mut total = 0;
    let mut check = 0;
    for n in 1..limit + 1 {
        let g = binary_gap(n);
        total += g;
        check = (check * 31 + g) % 1000000007;
    }
    println(f"n from 1 to {limit}: gaps sum to {total}, checksum {check}");
}
