// LeetCode #863: All Nodes Distance K in Binary Tree -- bench program, the
// ★ arm (parents, then a breadth-first search).
//
// A random tree of 500 nodes, LeetCode's largest, built once, and 200,000
// queries with a random target and a random k from 0 to 19.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn distance_k(root: Option[TreeNode], target: i64, k: i64) -> Vec[i64] {
    let mut parent: Map[i64, TreeNode] = Map.new();
    let mut start: Option[TreeNode] = None;
    let mut stack: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        stack.push(r);
    }
    while let Some(node) = stack.pop() {
        if node.val == target {
            start = Some(node);
        }
        if let Some(child) = node.left {
            parent.insert(child.val, node);
            stack.push(child);
        }
        if let Some(child) = node.right {
            parent.insert(child.val, node);
            stack.push(child);
        }
    }
    let mut found: Vec[i64] = Vec.new();
    let Some(s) = start else {
        return found;
    };
    let mut seen: Set[i64] = Set.new();
    seen.insert(s.val);
    let mut level: Vec[TreeNode] = [s];
    for _ in 0..k {
        let mut next: Vec[TreeNode] = Vec.new();
        for node in level.iter() {
            let mut near: Vec[TreeNode] = Vec.new();
            if let Some(child) = node.left {
                near.push(child);
            }
            if let Some(child) = node.right {
                near.push(child);
            }
            if let Some(up) = parent.get(node.val) {
                near.push(*up);
            }
            for m in near {
                if not seen.contains(m.val) {
                    seen.insert(m.val);
                    next.push(m);
                }
            }
        }
        level = next;
    }
    for node in level.iter() {
        found.push(node.val);
    }
    found.sort();
    found
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random tree of n nodes holding the values 0 to n - 1 in a random
// order: each new node hangs from a random node with a free side.
fn random_tree(seed: mut ref i64, n: i64) -> Option[TreeNode] {
    let mut vals: Vec[i64] = Vec.new();
    for v in 0..n {
        vals.push(v);
    }
    for i in 1..n {
        let j = next_random(mut seed) % (i + 1);
        vals.swap(i, j);
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for k in 0..n {
        let node = TreeNode { val: vals[k], left: None, right: None };
        if k > 0 {
            loop {
                let parent = nodes[next_random(mut seed) % nodes.len()];
                if next_random(mut seed) % 2 == 0 {
                    if parent.left.is_none() {
                        parent.left = Some(node);
                        break;
                    }
                } else if parent.right.is_none() {
                    parent.right = Some(node);
                    break;
                }
            }
        }
        nodes.push(node);
    }
    if n == 0 { None } else { Some(nodes[0]) }
}

fn main() {
    let n = 500;
    let queries = 200000;
    let mut seed = 863;
    let root = random_tree(mut seed, n);
    let mut total = 0;
    let mut check = 0;
    for _ in 0..queries {
        let target = next_random(mut seed) % n;
        let k = next_random(mut seed) % 20;
        let found = distance_k(root, target, k);
        total += found.len();
        for v in found.iter() {
            check = (check * 31 + *v + 1) % 1000000007;
        }
    }
    println(f"{queries} queries on {n} nodes: {total} nodes found, checksum {check}");
}
