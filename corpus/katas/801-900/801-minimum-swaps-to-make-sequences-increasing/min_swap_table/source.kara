// LeetCode 801 — Minimum Swaps To Make Sequences Increasing, a table.
//
// The two-state recurrence with a row of the table for every place:
// best[i][0] is the fewest swaps for the prefixes up to i with place i
// left alone, best[i][1] with it swapped. A state is filled from each
// state of place i - 1 that leaves both arrays going up from there.
// O(n) time and space.
fn min_swap(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    let n = nums1.len();
    let none = n + 1;
    let mut best: Vec[Array[i64, 2]] = Vec.new();
    // Each row is bound with its type written out before it is pushed:
    // a list literal passed to `push` is built as a `Vec`
    // (B-2026-10-19-32); push the literal once that is fixed.
    let first: Array[i64, 2] = [0, 1];
    best.push(first);
    for i in 1..n {
        let mut row: Array[i64, 2] = [none, none];
        for now in 0..2 {
            for before in 0..2 {
                // The two numbers at each place, in the arrays they end in.
                let (a0, b0) = if before == 0 { (nums1[i - 1], nums2[i - 1]) } else { (nums2[i - 1], nums1[i - 1]) };
                let (a1, b1) = if now == 0 { (nums1[i], nums2[i]) } else { (nums2[i], nums1[i]) };
                if a0 < a1 and b0 < b1 and best[i - 1][before] + now < row[now] {
                    row[now] = best[i - 1][before] + now;
                }
            }
        }
        best.push(row);
    }
    best[n - 1][0].min(best[n - 1][1])
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums1: Vec[i64], nums2: Vec[i64]) {
    println(f"{nums1}, {nums2} -> {min_swap(nums1, nums2)}");
}

fn main() {
    show(vec![1, 3, 5, 4], vec![1, 2, 3, 7]);
    show(vec![0, 3, 5, 8, 9], vec![2, 1, 4, 6, 9]);
    show(vec![1, 2], vec![3, 4]);
    show(vec![3, 2], vec![1, 4]);
    show(vec![0, 4, 4, 5, 9], vec![0, 1, 6, 8, 10]);
    show(vec![0, 11, 2, 13, 4, 15], vec![10, 1, 12, 3, 14, 5]);
    let mut seed = 801;
    let mut total = 0;
    let mut check = 0;
    for i in 0..300 {
        // Two increasing arrays, then some places swapped, so that some
        // set of swaps undoes it.
        let n = 2 + next_random(mut seed) % 40;
        let gap = 1 + next_random(mut seed) % 3;
        let mut a: Vec[i64] = Vec.new();
        let mut b: Vec[i64] = Vec.new();
        let mut x = next_random(mut seed) % 5;
        let mut y = next_random(mut seed) % 5;
        for _ in 0..n {
            x += 1 + next_random(mut seed) % gap;
            y += 1 + next_random(mut seed) % gap;
            if next_random(mut seed) % 2 == 0 {
                a.push(x);
                b.push(y);
            } else {
                a.push(y);
                b.push(x);
            }
        }
        let k = min_swap(a, b);
        total += k;
        check = (check * 131 + k + i) % 1000000007;
    }
    println(f"300 random pairs: {total} swaps in all, checksum {check}");
}
