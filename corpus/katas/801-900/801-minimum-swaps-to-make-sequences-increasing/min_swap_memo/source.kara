// LeetCode 801 — Minimum Swaps To Make Sequences Increasing, asked from
// the left.
//
// fewest(i, swapped) is the fewest swaps for places i onwards, given
// whether place i - 1 was swapped: try leaving place i alone and
// swapping it, whichever keeps both arrays going up, and take the
// better. Each question is answered once and kept. O(n).
fn min_swap(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    let mut known: Vec[i64] = Vec.new();
    for _ in 0..2 * nums1.len() {
        known.push(-1);
    }
    fewest(nums1, nums2, 0, 0, mut known)
}

fn fewest(nums1: Vec[i64], nums2: Vec[i64], i: i64, swapped: i64, known: mut ref Vec[i64]) -> i64 {
    let n = nums1.len();
    if i == n {
        return 0;
    }
    if known[2 * i + swapped] >= 0 {
        return known[2 * i + swapped];
    }
    let mut best = n + 1;
    for now in 0..2 {
        let (a, b) = if now == 0 { (nums1[i], nums2[i]) } else { (nums2[i], nums1[i]) };
        let fits = if i == 0 {
            true
        } else {
            let (pa, pb) = if swapped == 0 { (nums1[i - 1], nums2[i - 1]) } else { (nums2[i - 1], nums1[i - 1]) };
            pa < a and pb < b
        };
        if fits {
            let rest = now + fewest(nums1, nums2, i + 1, now, mut known);
            if rest < best {
                best = rest;
            }
        }
    }
    known[2 * i + swapped] = best;
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums1: Vec[i64], nums2: Vec[i64]) {
    println(f"{nums1}, {nums2} -> {min_swap(nums1, nums2)}");
}

fn main() {
    show(vec![1, 3, 5, 4], vec![1, 2, 3, 7]);
    show(vec![0, 3, 5, 8, 9], vec![2, 1, 4, 6, 9]);
    show(vec![1, 2], vec![3, 4]);
    show(vec![3, 2], vec![1, 4]);
    show(vec![0, 4, 4, 5, 9], vec![0, 1, 6, 8, 10]);
    show(vec![0, 11, 2, 13, 4, 15], vec![10, 1, 12, 3, 14, 5]);
    let mut seed = 801;
    let mut total = 0;
    let mut check = 0;
    for i in 0..300 {
        // Two increasing arrays, then some places swapped, so that some
        // set of swaps undoes it.
        let n = 2 + next_random(mut seed) % 40;
        let gap = 1 + next_random(mut seed) % 3;
        let mut a: Vec[i64] = Vec.new();
        let mut b: Vec[i64] = Vec.new();
        let mut x = next_random(mut seed) % 5;
        let mut y = next_random(mut seed) % 5;
        for _ in 0..n {
            x += 1 + next_random(mut seed) % gap;
            y += 1 + next_random(mut seed) % gap;
            if next_random(mut seed) % 2 == 0 {
                a.push(x);
                b.push(y);
            } else {
                a.push(y);
                b.push(x);
            }
        }
        let k = min_swap(a, b);
        total += k;
        check = (check * 131 + k + i) % 1000000007;
    }
    println(f"300 random pairs: {total} swaps in all, checksum {check}");
}
