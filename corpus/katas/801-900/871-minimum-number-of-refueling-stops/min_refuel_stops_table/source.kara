// LeetCode #871: Minimum Number of Refueling Stops -- a table over
// stations and stops.
//
// best[i][k] is the farthest the car gets using k stops among the first
// i stations, or -1 when k stops are not possible there. Station i
// either is passed by, keeping best[i][k], or is a stop, giving
// best[i][k - 1] plus its fuel when best[i][k - 1] gets to it. The
// answer is the smallest k with best[n][k] at the target. O(n^2) time and
// space.

fn min_refuel_stops(target: i64, start_fuel: i64, stations: Vec[(i64, i64)]) -> i64 {
    let n = stations.len();
    let mut best: Vec[Vec[i64]] = Vec.new();
    let mut first: Vec[i64] = Vec.filled(n + 1, -1);
    first[0] = start_fuel;
    best.push(first);
    for i in 0..n {
        let (position, fuel) = stations[i];
        let mut row: Vec[i64] = Vec.filled(n + 1, -1);
        for k in 0..n + 1 {
            row[k] = best[i][k];
            if k > 0 and best[i][k - 1] >= position and best[i][k - 1] + fuel > row[k] {
                row[k] = best[i][k - 1] + fuel;
            }
        }
        best.push(row);
    }
    for k in 0..n + 1 {
        if best[n][k] >= target {
            return k;
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random value from 0 to limit - 1, for limit up to 10^9 + 1
fn random_below(seed: mut ref i64, limit: i64) -> i64 {
    let hi = next_random(mut seed);
    let lo = next_random(mut seed);
    (hi * 32768 + lo) % limit
}

// up to n stations at distinct positions between 0 and target, each with
// fuel from 1 to max_fuel
fn random_stations(seed: mut ref i64, n: i64, target: i64, max_fuel: i64) -> Vec[(i64, i64)] {
    let mut positions: Vec[i64] = Vec.new();
    if target > 1 {
        for _ in 0..n {
            positions.push(random_below(mut seed, target - 1) + 1);
        }
    }
    positions.sort();
    positions.dedup();
    let mut stations: Vec[(i64, i64)] = Vec.new();
    for p in positions.iter() {
        stations.push((*p, random_below(mut seed, max_fuel) + 1));
    }
    stations
}

fn show(target: i64, start_fuel: i64, stations: Vec[(i64, i64)]) {
    let mut listed = String.new();
    for i in 0..stations.len() {
        if i > 0 {
            listed = listed + ", ";
        }
        listed = listed + f"[{stations[i].0}, {stations[i].1}]";
    }
    println(f"target = {target}, startFuel = {start_fuel}, stations = [{listed}] -> {min_refuel_stops(target, start_fuel, stations)}");
}

fn main() {
    show(1, 1, []);
    show(100, 1, [(10, 100)]);
    show(100, 10, [(10, 60), (20, 30), (30, 30), (60, 40)]);
    show(100, 100, []);
    show(100, 99, []);
    show(100, 50, [(50, 50)]);
    show(100, 49, [(50, 50)]);
    show(100, 10, [(10, 10), (20, 10), (30, 10), (40, 10), (50, 10), (60, 10), (70, 10), (80, 10), (90, 10)]);
    show(100, 25, [(25, 25), (50, 25), (75, 25), (80, 1000)]);
    show(1000000000, 1, [(1, 999999999)]);
    show(1000000000, 1000000000, [(1, 999999999)]);
    show(1000000000, 1, [(2, 999999999)]);
    // many small cases
    let mut seed = 871;
    let mut total = 0;
    let mut unreachable = 0;
    for k in 0..3000 {
        let target = random_below(mut seed, 100) + 1;
        let start_fuel = random_below(mut seed, target + 10) + 1;
        let stations = random_stations(mut seed, k % 9, target, 40);
        let a = min_refuel_stops(target, start_fuel, stations);
        if a < 0 {
            unreachable += 1;
        } else {
            total += a;
        }
    }
    println(f"3000 cases with a target up to 100: stops sum to {total}, {unreachable} unreachable");
    // LeetCode's largest: 500 stations, values up to 10^9
    total = 0;
    unreachable = 0;
    let mut check = 0;
    for k in 0..40 {
        let target = random_below(mut seed, 1000000000) + 1;
        let start_fuel = random_below(mut seed, target / 50 + 1) + 1;
        let max_fuel = if k % 2 == 0 { target / 20 + 1 } else { target / 100 + 1 };
        let stations = random_stations(mut seed, 500, target, max_fuel);
        let a = min_refuel_stops(target, start_fuel, stations);
        if a < 0 {
            unreachable += 1;
        } else {
            total += a;
        }
        check = (check * 1009 + a + 1) % 1000000007;
    }
    println(f"40 cases with 500 stations: stops sum to {total}, {unreachable} unreachable, checksum {check}");
}
