// LeetCode #879: Profitable Schemes -- memoized recursion over the crimes.
//
// `schemes(c, members, needed)` counts the sets of crimes c.. that fit in
// `members` and make at least `needed` more profit: crime c left out, plus
// crime c taken when its group fits. A Map keyed by the three keeps each
// count; members never rises above n nor needed above min_profit, so a
// stride one past the larger of them keeps every key apart.
// O(crimes * n * min_profit).

fn profitable_schemes(n: i64, min_profit: i64, group: Vec[i64], profit: Vec[i64]) -> i64 {
    let mut memo: Map[i64, i64] = Map.new();
    let stride = n.max(min_profit) + 1;
    schemes(group, profit, stride, 0, n, min_profit, mut memo)
}

fn schemes(group: Vec[i64], profit: Vec[i64], stride: i64, c: i64, members: i64, needed: i64, memo: mut ref Map[i64, i64]) -> i64 {
    if c == group.len() {
        return if needed == 0 { 1 } else { 0 };
    }
    let key = (c * stride + members) * stride + needed;
    if let Some(known) = memo.get(key) {
        return known;
    }
    let mut ways = schemes(group, profit, stride, c + 1, members, needed, mut memo);
    if group[c] <= members {
        ways += schemes(group, profit, stride, c + 1, members - group[c], (needed - profit[c]).max(0), mut memo);
    }
    ways %= 1000000007;
    memo.insert(key, ways);
    ways
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn text(values: Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for v in values.iter() {
        parts.push(f"{v}");
    }
    if parts.len() > 6 { f"[{parts[0]}, {parts[1]}, ... ({parts.len()} crimes)]" } else { f"[{parts.join(", ")}]" }
}

fn show(n: i64, min_profit: i64, group: Vec[i64], profit: Vec[i64]) {
    let answer = profitable_schemes(n, min_profit, group, profit);
    println(f"n = {n}, minProfit = {min_profit}, group = {text(group)}, profit = {text(profit)} -> {answer}");
}

fn main() {
    show(5, 3, [2, 2], [2, 3]);
    show(10, 5, [2, 3, 5], [6, 7, 8]);
    show(1, 1, [2], [5]);
    show(1, 0, [2], [5]);
    show(4, 0, [1, 2, 1], [0, 0, 0]);
    show(3, 10, [1, 1, 1], [3, 3, 3]);
    let mut ones: Vec[i64] = Vec.new();
    let mut hundreds: Vec[i64] = Vec.new();
    for _ in 0..100 {
        ones.push(1);
        hundreds.push(100);
    }
    show(100, 100, ones, ones);
    show(100, 0, ones, ones);
    show(100, 100, ones, hundreds);
    show(100, 100, hundreds, hundreds);
    // small cases
    let mut seed = 879;
    let mut total = 0;
    for _ in 0..3000 {
        let crimes = next_random(mut seed) % 10 + 1;
        let n = next_random(mut seed) % 12 + 1;
        let min_profit = next_random(mut seed) % 15;
        let mut group: Vec[i64] = Vec.new();
        let mut profit: Vec[i64] = Vec.new();
        for _ in 0..crimes {
            group.push(next_random(mut seed) % 5 + 1);
            profit.push(next_random(mut seed) % 6);
        }
        total = (total + profitable_schemes(n, min_profit, group, profit)) % 1000000007;
    }
    println(f"3000 cases of 1 to 10 crimes: counts sum to {total} (mod 10^9 + 7)");
    // LeetCode's sizes: 100 crimes, n and minProfit up to 100
    total = 0;
    let mut check = 0;
    for k in 0..8 {
        let n = 50 + next_random(mut seed) % 51;
        let min_profit = 50 + next_random(mut seed) % 51;
        let mut group: Vec[i64] = Vec.new();
        let mut profit: Vec[i64] = Vec.new();
        for _ in 0..100 {
            group.push(next_random(mut seed) % (if k % 2 == 0 { 100 } else { 10 }) + 1);
            profit.push(next_random(mut seed) % (if k % 2 == 0 { 101 } else { 11 }));
        }
        let answer = profitable_schemes(n, min_profit, group, profit);
        total = (total + answer) % 1000000007;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"8 cases of 100 crimes: counts sum to {total} (mod 10^9 + 7), checksum {check}");
}
