// LeetCode #837: New 21 Game -- pushing each total's chance forward.
//
// Each total i below k that Alice reaches with chance p[i] sends p[i] /
// max_pts to every total in [i + 1, i + max_pts]. Those range additions
// go into a difference list, `delta[j]` the change in the incoming chance
// at j, and a running sum of it gives each p[j] in turn. The answer is
// the sum of p[i] for i from k to n. O(n).

fn new21_game(n: i64, k: i64, max_pts: i64) -> f64 {
    let w = max_pts as f64;
    let mut delta = Vec.filled(n + 2, 0.0);
    let mut incoming = 0.0;
    let mut answer = 0.0;
    for i in 0..n + 1 {
        incoming += delta[i];
        let p = if i == 0 { 1.0 } else { incoming };
        if i < k {
            let share = p / w;
            delta[(i + 1).min(n + 1)] += share;
            delta[(i + max_pts + 1).min(n + 1)] -= share;
        } else {
            answer += p;
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64, k: i64, max_pts: i64) {
    println(f"n = {n}, k = {k}, maxPts = {max_pts}: {new21_game(n, k, max_pts):.6}");
}

fn main() {
    show(10, 1, 10);
    show(6, 1, 10);
    show(21, 17, 10);
    show(0, 0, 1);
    show(1, 1, 2);
    show(5, 3, 1);
    show(3, 3, 2);
    show(4, 3, 3);
    show(10000, 10000, 10000);
    show(10000, 5000, 10000);
    show(10000, 9999, 2);
    show(10000, 10000, 1);
    show(5000, 4999, 10000);
    // random games: n up to 10^4, k up to n, maxPts up to 10^4
    let mut seed = 837;
    let mut sum = 0.0;
    let mut above = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 10001;
        let k = next_random(mut seed) % (n + 1);
        let max_pts = 1 + next_random(mut seed) % 10000;
        let x = new21_game(n, k, max_pts);
        sum += x;
        if x > 0.5 {
            above += 1;
        }
    }
    println(f"300 random games: sum {sum:.6}, {above} above one half");
}
