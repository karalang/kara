// Benchmark for #837: New 21 Game -- the ★ arm (forward, with a sliding window).
//
// p[i] is the chance that Alice's points are ever exactly i. A total of
// i is reached by a draw from any total in the last `max_pts` below it
// at which she still draws, one below k, so p[i] is the sum of those
// chances over `max_pts`. A running window holds that sum, gaining each
// total below k as it is passed and losing the one `max_pts` back. She
// stops at the first total of k or more, so the answer is the sum of p[i]
// for i from k to n. When k is 0 she never draws, and when even her
// largest possible stop, k - 1 + max_pts, is at most n she always wins.
// O(n).

fn new21_game(n: i64, k: i64, max_pts: i64) -> f64 {
    if k == 0 or n >= k - 1 + max_pts {
        return 1.0;
    }
    let w = max_pts as f64;
    let mut p = Vec.filled(n + 1, 0.0);
    p[0] = 1.0;
    let mut window = 1.0;
    let mut answer = 0.0;
    for i in 1..n + 1 {
        p[i] = window / w;
        if i < k {
            window += p[i];
        } else {
            answer += p[i];
        }
        let gone = i - max_pts;
        if gone >= 0 and gone < k {
            window -= p[gone];
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 games drawn once, each with n from 5000 to 10^4, k from n / 2 to
    // n, and maxPts large enough that Alice can go past n, so that no game
    // takes the early return. Each round plays the next game.
    let count = 64;
    let rounds = 25000;
    let mut seed: i64 = 837;
    let mut games: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..count {
        let n = 5000 + next_random(mut seed) % 5001;
        let k = n / 2 + next_random(mut seed) % (n - n / 2 + 1);
        let least = n - k + 2;
        let max_pts = least + next_random(mut seed) % (10001 - least);
        games.push((n, k, max_pts));
    }
    let mut sum = 0.0;
    for round in 0..rounds {
        let (n, k, max_pts) = games[round % count];
        sum += new21_game(n, k, max_pts);
    }
    println(f"{rounds} rounds of {count} games: sum {sum:.6}");
}
