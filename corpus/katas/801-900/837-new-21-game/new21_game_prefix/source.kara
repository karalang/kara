// LeetCode #837: New 21 Game -- forward, with prefix sums.
//
// As in the ★ arm, p[i] is the chance that Alice's points are ever
// exactly i, the sum over `max_pts` of the chances of the totals in
// [i - max_pts, i - 1] below k. Here a prefix-sum list, `sums[t]` the sum
// of p over [0, t), gives that sum as the difference of two entries, and
// the answer is the sum of p over [k, n] read from the same list. O(n).

fn new21_game(n: i64, k: i64, max_pts: i64) -> f64 {
    let w = max_pts as f64;
    let mut p = Vec.filled(n + 1, 0.0);
    let mut sums = Vec.filled(n + 2, 0.0);
    p[0] = 1.0;
    sums[1] = 1.0;
    for i in 1..n + 1 {
        let lo = (i - max_pts).max(0);
        let hi = i.min(k);
        p[i] = if lo < hi { (sums[hi] - sums[lo]) / w } else { 0.0 };
        sums[i + 1] = sums[i] + p[i];
    }
    if k == 0 { 1.0 } else { sums[n + 1] - sums[k] }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64, k: i64, max_pts: i64) {
    println(f"n = {n}, k = {k}, maxPts = {max_pts}: {new21_game(n, k, max_pts):.6}");
}

fn main() {
    show(10, 1, 10);
    show(6, 1, 10);
    show(21, 17, 10);
    show(0, 0, 1);
    show(1, 1, 2);
    show(5, 3, 1);
    show(3, 3, 2);
    show(4, 3, 3);
    show(10000, 10000, 10000);
    show(10000, 5000, 10000);
    show(10000, 9999, 2);
    show(10000, 10000, 1);
    show(5000, 4999, 10000);
    // random games: n up to 10^4, k up to n, maxPts up to 10^4
    let mut seed = 837;
    let mut sum = 0.0;
    let mut above = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 10001;
        let k = next_random(mut seed) % (n + 1);
        let max_pts = 1 + next_random(mut seed) % 10000;
        let x = new21_game(n, k, max_pts);
        sum += x;
        if x > 0.5 {
            above += 1;
        }
    }
    println(f"300 random games: sum {sum:.6}, {above} above one half");
}
