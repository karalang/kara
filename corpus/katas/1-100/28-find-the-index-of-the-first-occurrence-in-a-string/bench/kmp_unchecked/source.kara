// Benchmark workload — KMP strStr with the needle bounds check elided via
// `Slice.get_unchecked` (the unchecked sibling of kmp.kara). The `needle[j]`
// read is the one check the monotone/source-level BCE passes can't fold — `j`
// rewinds via the LPS table, so it's not a monotone induction variable. The
// `j < nn` invariant IS true for all inputs (j starts 0, `j == nn` returns,
// every lps value is < nn), but proving it needs interprocedural table-range
// analysis; the programmer asserts it here instead. See ../README.md and
// phase-7-codegen.md § BCE table-range tier.
//
// Original KMP workload note follows.
// Benchmark workload — KMP strStr, same adversarial input as brute_force.kara.
//
// Haystack = N-1 'a' + 'b', needle = M-1 'a' + 'b' (occurs only at index
// N-M). Brute force is O(N · M) on this input; KMP is O(N + M) — the LPS
// table lets the needle cursor fall back via the matched-overlap instead of
// rescanning, so the haystack cursor never backs up. N = 2_000_000, M = 16,
// K = 100. Sink = K × (N - M); see brute_force.kara for the loop-invariant /
// Slice[u8] rationale.

fn build_lps(pat: Slice[u8], m: i64) -> Vec[i64] {
    let mut lps: Vec[i64] = Vec.filled(m, 0);
    let mut len = 0;
    let mut i = 1;
    while i < m {
        if pat[i] == pat[len] {
            len = len + 1;
            lps[i] = len;
            i = i + 1;
        } else if len > 0 {
            len = lps[len - 1];
        } else {
            lps[i] = 0;
            i = i + 1;
        }
    }
    lps
}

fn str_str(haystack: Slice[u8], needle: Slice[u8]) -> i64 {
    let hn = haystack.len();
    let nn = needle.len();
    if nn == 0 {
        return 0;
    }
    if nn > hn {
        return -1;
    }
    let lps = build_lps(needle, nn);
    let mut i = 0;
    let mut j = 0;
    while i < hn {
        // SAFETY: j < nn invariantly — j starts 0, is reset to nn only via the
        // Safety: j < nn invariantly — j starts 0, `j == nn` returns, and every lps value is < nn.
        if haystack[i] == unsafe { needle.get_unchecked(j) } {
            i = i + 1;
            j = j + 1;
            if j == nn {
                return i - nn;
            }
        } else if j > 0 {
            // SAFETY: j ∈ [1, nn-1] here (j > 0 and j < nn invariantly), so
            // Safety: j is in [1, nn-1] here, so j-1 is in [0, nn-2] < nn = lps.len().
            j = unsafe { lps.get_unchecked(j - 1) };
        } else {
            i = i + 1;
        }
    }
    -1
}

fn main() {
    let n = 2000000;
    let m = 16;

    let mut haystack: Vec[u8] = Vec.filled(n, 97u8);
    haystack[n - 1] = 98u8;

    let mut needle: Vec[u8] = Vec.filled(m, 97u8);
    needle[m - 1] = 98u8;

    let mut sum = 0;
    for _ in 0..100 {
        sum = sum + str_str(haystack, needle);
    }
    println(sum);
}
