// LeetCode #1500: Design a File Sharing System -- the benchmark. Each
// chunk's owners in a sorted Vec kept in order by binary search, each user's
// chunks in a Vec indexed by id, the ids given back by leave in a
// smallest-first PriorityQueue. Every language runs this same structure.

struct FileSharing {
    owners: Vec[Vec[i64]],
    owned: Vec[Vec[i64]],
    free: PriorityQueue[i64],
}

// Where `x` sits in the sorted `v`, or would go.
fn position(v: Vec[i64], x: i64) -> i64 {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if v[mid] < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

impl FileSharing {
    fn new(m: i64) -> FileSharing {
        FileSharing { owners: Vec.filled(m + 1, Vec.new()), owned: [Vec.new()], free: PriorityQueue.new() }
    }

    fn join(mut ref self, chunks: own Vec[i64]) -> i64 {
        let id = match self.free.pop() {
            Some(id) => id,
            None => {
                self.owned.push(Vec.new());
                self.owned.len() - 1
            }
        };
        for c in chunks.iter() {
            let at = position(self.owners[*c], id);
            self.owners[*c].insert(at, id);
        }
        self.owned[id] = chunks;
        id
    }

    fn leave(mut ref self, id: i64) {
        for c in self.owned[id].iter() {
            let at = position(self.owners[*c], id);
            self.owners[*c].remove(at);
        }
        self.owned[id].clear();
        self.free.push(id);
    }

    fn request(mut ref self, id: i64, chunk: i64) -> Vec[i64] {
        let answer = self.owners[chunk].clone();
        if not answer.is_empty() {
            let at = position(self.owners[chunk], id);
            if at == answer.len() or answer[at] != id {
                self.owners[chunk].insert(at, id);
                self.owned[id].push(chunk);
            }
        }
        answer
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// Up to `most` distinct chunks of 1..=m, in the order drawn.
fn random_chunks(m: i64, most: i64, seed: mut ref i64) -> Vec[i64] {
    let count = next_random(mut seed) % (most.min(m) + 1);
    let mut chunks: Vec[i64] = Vec.new();
    while chunks.len() < count {
        let c = next_random(mut seed) % m + 1;
        if not chunks.contains(c) {
            chunks.push(c);
        }
    }
    chunks
}

// One system of `m` chunks driven by `ops` random calls. Returns the
// number of joins, of requests, of owners returned, and a checksum of every
// answer in order.
fn simulate(m: i64, ops: i64, most: i64, seed: mut ref i64) -> (i64, i64, i64, i64) {
    let mut system = FileSharing.new(m);
    let mut live: Vec[i64] = Vec.new();
    let mut joins = 0;
    let mut requests = 0;
    let mut owners = 0;
    let mut check = 0;
    for _ in 0..ops {
        let r = next_random(mut seed) % 10;
        if live.is_empty() or r < 3 {
            let id = system.join(random_chunks(m, most, mut seed));
            live.push(id);
            joins += 1;
            check = mix(check, id);
        } else if r < 5 {
            let at = next_random(mut seed) % live.len();
            system.leave(live.swap_remove(at));
        } else {
            let user = live[next_random(mut seed) % live.len()];
            let chunk = next_random(mut seed) % m + 1;
            let answer = system.request(user, chunk);
            requests += 1;
            owners += answer.len();
            check = mix(check, answer.len());
            for id in answer.iter() {
                check = mix(check, *id);
            }
        }
    }
    (joins, requests, owners, check)
}

fn batch(count: i64, most_m: i64, ops: i64, most: i64, seed: mut ref i64) {
    let mut joins = 0;
    let mut requests = 0;
    let mut owners = 0;
    let mut check = 0;
    for _ in 0..count {
        let m = next_random(mut seed) % most_m + 1;
        let (j, r, o, c) = simulate(m, ops, most, mut seed);
        joins += j;
        requests += r;
        owners += o;
        check = mix(check, c);
    }
    println(f"{count} systems of up to {most_m} chunks, {ops} calls each: {joins} joins, {requests} requests, {owners} owners returned, checksum {check}");
}

fn main() {
    let mut seed = 1500;
    batch(40, 2000, 40000, 30, mut seed);
}
