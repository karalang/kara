// LeetCode #1500: Design a File Sharing System -- LeetCode's Rust template,
// written as Rust writes it and carried to Kāra by `karac fix`: a BTreeSet
// of owners per chunk, each user's chunks, the free ids in a BinaryHeap of
// Reverse.

struct FileSharing {
    owners: Map[i32, SortedSet[i32]],
    owned: Map[i32, Vec[i32]],
    free: PriorityQueue[Release[i32]],
    next: i32,
}

impl FileSharing {
    fn new(m: i32) -> Self {
        FileSharing { owners: Map.new(), owned: Map.new(), free: PriorityQueue.new(), next: 1 }
    }

    fn join(mut ref self, owned_chunks: own Vec[i32]) -> i32 {
        let id = match self.free.pop() {
            Some(id) => id,
            None => {
                self.next += 1;
                self.next - 1
            }
        };
        for c in ref owned_chunks {
            self.owners.entry(c).or_insert_with(SortedSet.new).insert(id);
        }
        self.owned.insert(id, owned_chunks);
        id
    }

    fn leave(mut ref self, user_id: i32) {
        if let Some(chunks) = self.owned.remove(user_id) {
            for c in chunks {
                if let Some(set) = self.owners.get_mut(c) {
                    set.remove(user_id);
                }
            }
        }
        self.free.push(user_id);
    }

    fn request(mut ref self, user_id: i32, chunk_id: i32) -> Vec[i32] {
        let ans: Vec[i32] = match self.owners.get(chunk_id) {
            Some(set) => set.iter().cloned().collect(),
            None => Vec.new(),
        };
        if not ans.is_empty() {
            if self.owners.get_mut(chunk_id).unwrap().insert(user_id) {
                self.owned.get_mut(user_id).unwrap().push(chunk_id);
            }
        }
        ans
    }
}

// The harness's i64 calls on the template's i32 ones.
struct Sharing {
    inner: FileSharing,
}

impl Sharing {
    fn new(m: i64) -> Sharing {
        Sharing { inner: FileSharing.new(m as i32) }
    }

    fn join(mut ref self, chunks: Vec[i64]) -> i64 {
        self.inner.join(chunks.iter().map(|c| *c as i32).collect()) as i64
    }

    fn leave(mut ref self, id: i64) {
        self.inner.leave(id as i32);
    }

    fn request(mut ref self, id: i64, chunk: i64) -> Vec[i64] {
        self.inner.request(id as i32, chunk as i32).iter().map(|x| *x as i64).collect()
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// Up to `most` distinct chunks of 1..=m, in the order drawn.
fn random_chunks(m: i64, most: i64, seed: mut ref i64) -> Vec[i64] {
    let count = next_random(mut seed) % (most.min(m) + 1);
    let mut chunks: Vec[i64] = Vec.new();
    while chunks.len() < count {
        let c = next_random(mut seed) % m + 1;
        if not chunks.contains(c) {
            chunks.push(c);
        }
    }
    chunks
}

fn show(ids: ref Vec[i64]) -> String {
    let parts: Vec[String] = ids.iter().map(|x| f"{x}").collect();
    "[" + parts.join(", ") + "]"
}

// One system of `m` chunks driven by `ops` random calls. Returns the
// number of joins, of requests, of owners returned, and a checksum of every
// answer in order.
fn simulate(m: i64, ops: i64, most: i64, seed: mut ref i64) -> (i64, i64, i64, i64) {
    let mut system = Sharing.new(m);
    let mut live: Vec[i64] = Vec.new();
    let mut joins = 0;
    let mut requests = 0;
    let mut owners = 0;
    let mut check = 0;
    for _ in 0..ops {
        let r = next_random(mut seed) % 10;
        if live.is_empty() or r < 3 {
            let id = system.join(random_chunks(m, most, mut seed));
            live.push(id);
            joins += 1;
            check = mix(check, id);
        } else if r < 5 {
            let at = next_random(mut seed) % live.len();
            system.leave(live.swap_remove(at));
        } else {
            let user = live[next_random(mut seed) % live.len()];
            let chunk = next_random(mut seed) % m + 1;
            let answer = system.request(user, chunk);
            requests += 1;
            owners += answer.len();
            check = mix(check, answer.len());
            for id in answer.iter() {
                check = mix(check, *id);
            }
        }
    }
    (joins, requests, owners, check)
}

fn batch(count: i64, most_m: i64, ops: i64, most: i64, seed: mut ref i64) {
    let mut joins = 0;
    let mut requests = 0;
    let mut owners = 0;
    let mut check = 0;
    for _ in 0..count {
        let m = next_random(mut seed) % most_m + 1;
        let (j, r, o, c) = simulate(m, ops, most, mut seed);
        joins += j;
        requests += r;
        owners += o;
        check = mix(check, c);
    }
    println(f"{count} systems of up to {most_m} chunks, {ops} calls each: {joins} joins, {requests} requests, {owners} owners returned, checksum {check}");
}

fn main() {
    // LeetCode's example
    let mut system = Sharing.new(4);
    let a = system.join([1, 2]);
    let b = system.join([2, 3]);
    let c = system.join([4]);
    let r1 = system.request(1, 3);
    let r2 = system.request(2, 2);
    system.leave(1);
    let r3 = system.request(2, 1);
    system.leave(2);
    let d = system.join([]);
    println(f"join -> {a}, {b}, {c}; request(1, 3) -> {show(r1)}; request(2, 2) -> {show(r2)}; leave(1); request(2, 1) -> {show(r3)}; leave(2); join -> {d}");
    let mut seed = 1500;
    batch(3000, 6, 40, 4, mut seed);
    batch(300, 30, 300, 10, mut seed);
    batch(10, 100000, 3000, 100, mut seed);
    batch(4, 5, 5000, 5, mut seed);
}
