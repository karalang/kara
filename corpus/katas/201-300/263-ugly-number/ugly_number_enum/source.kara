// LeetCode 263 — Ugly Number, by construction.
//
// The third mechanism, and the only one that never divides n at all. Instead of
// tearing n down, build the ugly numbers UP in increasing order and ask whether
// n is among them.
//
// That is the #264 three-pointer merge: every ugly number after 1 is 2, 3 or 5
// times an earlier one, so keep a cursor into the generated list for each
// multiplier, take the smallest of the three candidates, and advance every
// cursor that produced it (which is what collapses 6 = 2*3 = 3*2 to one entry).
// Stop as soon as the sequence reaches or passes n.
//
// This looks expensive and is not: the count of ugly numbers below N grows like
// (ln N)³, so there are only ~1,350 of them below 2³¹ and ~11,000 below 2⁶³. The
// enumeration finishes in a few thousand steps for ANY i64 input.
//
// Overflow is the real hazard, not cost. A candidate `u[i] * 5` can exceed i64
// even though u[i] itself is a perfectly good ugly number below n. Kāra traps on
// signed overflow rather than wrapping, so this would be a crash, not a wrong
// answer. The fix costs one comparison: a candidate is only formed when
//
//     u[i] <= n / k
//
// which (with floor division) holds exactly when u[i] * k <= n. Candidates
// beyond n are never needed anyway — the search stops at n — so the guard is
// free in every sense.

fn is_ugly(n: i64) -> bool {
    if n <= 0 {
        return false;
    }
    if n == 1 {
        return true;
    }

    let mut u: Vec[i64] = Vec.new();
    u.push(1);
    let mut i2 = 0;
    let mut i3 = 0;
    let mut i5 = 0;

    while true {
        // Form each candidate only if it cannot exceed n (and so cannot
        // overflow); `has_k` says whether multiplier k still has one.
        let mut has2 = false;
        let mut c2 = 0;
        if u[i2] <= n / 2 { has2 = true; c2 = u[i2] * 2; }
        let mut has3 = false;
        let mut c3 = 0;
        if u[i3] <= n / 3 { has3 = true; c3 = u[i3] * 3; }
        let mut has5 = false;
        let mut c5 = 0;
        if u[i5] <= n / 5 { has5 = true; c5 = u[i5] * 5; }

        if not has2 and not has3 and not has5 {
            // Every remaining ugly number is greater than n.
            return false;
        }

        let mut next = 0;
        let mut have = false;
        if has2 { next = c2; have = true; }
        if has3 and (not have or c3 < next) { next = c3; have = true; }
        if has5 and (not have or c5 < next) { next = c5; have = true; }

        if next == n {
            return true;
        }
        u.push(next);
        // Advance EVERY cursor that produced this value, or duplicates such as
        // 6 = 2*3 = 3*2 enter the list twice and the sequence stops being the
        // ugly numbers.
        if has2 and c2 == next { i2 = i2 + 1; }
        if has3 and c3 == next { i3 = i3 + 1; }
        if has5 and c5 == next { i5 = i5 + 1; }
    }
    return false;
}

fn report(n: i64) {
    if is_ugly(n) {
        println(f"{n} -> true");
    } else {
        println(f"{n} -> false");
    }
}

fn main() {
    report(1);
    report(6);
    report(8);
    report(14);
    report(0);
    report(-6);
    report(-1);
    report(2);
    report(3);
    report(5);
    report(7);
    report(30);
    report(1024);
    report(59049);
    report(9765625);
    report(2147483647);
    report(1259712);
    report(1259711);
}
