// Benchmark harness for LeetCode #291 — Word Pattern II backtracking.
//
// Build-once + punch (BENCHMARKS.md): the (pattern, string) table is built
// once, then each punch runs the full backtracking search on one entry.
// Rebuilding the strings per iteration would be a refill loop that swamps the
// measurement.
//
// A 4-distinct-letter pattern over an 18-char subject is the expensive shape:
// the search tries every way to cut the subject into four non-empty pieces,
// so each call does on the order of C(17,3) splits, each with substring
// compares plus Map insert/remove and Set insert/remove on the undo path.

fn matches(
    p: ref String,
    pi: i64,
    s: ref String,
    si: i64,
    map: mut ref Map[String, String],
    used: mut ref Set[String],
) -> bool {
    let pb = p.bytes();
    let sb = s.bytes();
    if pi >= pb.len() { return si >= sb.len(); }
    if si >= sb.len() { return false; }

    let key = p[pi..pi + 1];
    match map.get(key) {
        Some(bound) => {
            let blen = bound.len();
            if si + blen > sb.len() { return false; }
            if s[si..si + blen] != bound { return false; }
            matches(p, pi + 1, s, si + blen, map, used)
        }
        None => {
            let mut end = si + 1;
            while end <= sb.len() {
                let cand = s[si..end];
                if not used.contains(cand) {
                    let _ = map.insert(key.clone(), cand.clone());
                    used.insert(cand.clone());
                    if matches(p, pi + 1, s, end, map, used) { return true; }
                    let _ = map.remove(key.clone());
                    used.remove(cand);
                }
                end = end + 1;
            }
            false
        }
    }
}

fn word_pattern_match(p: ref String, s: ref String) -> bool {
    let mut map: Map[String, String] = Map.new();
    let mut used: Set[String] = Set.new();
    matches(p, 0, s, 0, mut map, mut used)
}

fn main() {
    let np = 8;
    let sl = 30;
    let iters = 500;

    let mut alpha: Vec[String] = Vec.new();
    alpha.push("a"); alpha.push("b"); alpha.push("c"); alpha.push("d");

    let mut subjects: Vec[String] = Vec.new();
    let mut j = 0;
    while j < np {
        let mut sj = String.new();
        let mut k = 0;
        while k < sl {
            // Even j: the two halves are built identical, so "abcabc" can
            // match and the search succeeds after finding a valid A/B/C split.
            // Odd j: the halves differ, so the search fails only after
            // exploring every split. Benching both paths, not just the
            // worst case.
            let mut kk = k;
            if j % 2 == 0 { kk = k % (sl / 2); }
            sj = sj + alpha[(kk * 7 + j * 3) % 4];
            k = k + 1;
        }
        subjects.push(sj);
        j = j + 1;
    }

    let pat = "abcabc";
    let mut sink = 0;
    let mut it = 0;
    while it < iters {
        let idx = (it * 5) % np;
        if word_pattern_match(pat, subjects[idx]) {
            sink = sink + (it + 1);
        } else {
            sink = sink + 1;
        }
        it = it + 1;
    }
    println(f"{sink}");
}
