// Benchmark harness for LeetCode #236 — LCA of a Binary Tree.
//
// Build-once + punch (BENCHMARKS.md): one 100 000-node complete binary tree is
// built as an index pool, then each punch is a full recursive post-order LCA.
//
// Contrast with #235: that kata's BST ordering lets the walk pick a direction
// and finish in O(h) ≈ 35 steps. Here there is no ordering to exploit, so the
// recursion must inspect BOTH subtrees and the cost is O(n) per query. That is
// why the punch count is 1500 rather than #235's 8 000 000 for a comparable
// runtime — the same problem shape, three orders of magnitude apart in
// per-query cost, which is the point of benching both.
//
// A complete tree (children of i are 2i+1 / 2i+2) keeps the recursion depth at
// ~17, well clear of any stack limit, while still forcing a full traversal.

struct Node {
    val: i64,
    left: i64,
    right: i64,
}

fn lca(nodes: ref Vec[Node], cur: i64, p: i64, q: i64) -> i64 {
    if cur == -1 {
        return -1;
    }
    if nodes[cur].val == p or nodes[cur].val == q {
        return cur;
    }
    let l = lca(nodes, nodes[cur].left, p, q);
    let r = lca(nodes, nodes[cur].right, p, q);
    if l != -1 and r != -1 {
        return cur;
    }
    if l != -1 {
        return l;
    }
    return r;
}

fn main() {
    let n = 100000;
    let iters = 600;

    let mut nodes: Vec[Node] = Vec.new();
    let mut i = 0;
    while i < n {
        let lc = 2 * i + 1;
        let rc = 2 * i + 2;
        let l = if lc < n { lc } else { -1 };
        let r = if rc < n { rc } else { -1 };
        nodes.push(Node { val: i, left: l, right: r });
        i = i + 1;
    }

    let mut sink = 0;
    let mut y = 2024;
    let mut it = 0;
    while it < iters {
        y = (y * 1103515245 + 12345) % 2147483648;
        let wd1 = y / 65536;
        y = (y * 1103515245 + 12345) % 2147483648;
        let p = (wd1 * 32768 + y / 65536) % n;
        y = (y * 1103515245 + 12345) % 2147483648;
        let wd0 = y / 65536;
        y = (y * 1103515245 + 12345) % 2147483648;
        let q = (wd0 * 32768 + y / 65536) % n;
        let ans = lca(nodes, 0, p, q);
        let v = if ans == -1 { -1 } else { nodes[ans].val };
        sink = (sink + v) % 1000000007;
        it = it + 1;
    }
    println(f"{sink}");
}
