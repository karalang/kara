// LeetCode 259 — 3Sum Smaller, brute force.
//
// The definition transcribed: three nested loops over `i < j < k`, counting the
// triples whose sum is below the target. O(n³), no sort, no invariant.
//
// That is exactly why it is here. The ★ file's correctness rests on two claims
// — that sorting preserves the count, and that a qualifying `(lo, hi)` implies
// `hi - lo` qualifying triples — and this file rests on neither. When the two
// disagree it is the one to believe, which makes it the differential's
// reference.
//
// It also cannot be fooled by the most likely bug in the ★ file. Counting `+ 1`
// instead of `+ (hi - lo)` produces a smaller and completely plausible number;
// only something that enumerates every triple can say which is right.

fn three_sum_smaller(nums: Slice[i64], target: i64) -> i64 {
    let n = nums.len();
    let mut count = 0;
    let mut i = 0;
    while i < n {
        let mut j = i + 1;
        while j < n {
            let mut k = j + 1;
            while k < n {
                if nums[i] + nums[j] + nums[k] < target {
                    count = count + 1;
                }
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}

fn report(nums: Slice[i64], target: i64, label: ref String) {
    println(f"{label} t={target} -> {three_sum_smaller(nums, target)}");
}

fn main() {
    // [-2,0,1,3], target 2 -> 2  ([-2,0,1] and [-2,0,3])
    let a: Array[i64, 4] = [-2, 0, 1, 3];
    report(a, 2, "[-2,0,1,3]");

    // fewer than three elements -> 0
    let b: Array[i64, 0] = [];
    report(b, 0, "[]");
    let c: Array[i64, 2] = [0, 0];
    report(c, 5, "[0,0]");

    // [0,0,0], target 1 -> 1 (the single triple sums to 0)
    let d: Array[i64, 3] = [0, 0, 0];
    report(d, 1, "[0,0,0]");

    // ...and target 0 -> 0 (strictly less than, so 0 < 0 is false)
    report(d, 0, "[0,0,0]");

    // all negative: every triple qualifies for a positive target
    let e: Array[i64, 5] = [-5, -4, -3, -2, -1];
    report(e, 0, "[-5,-4,-3,-2,-1]");

    // duplicates, which the count must not collapse
    let f: Array[i64, 5] = [1, 1, 1, 1, 1];
    report(f, 4, "[1,1,1,1,1]");

    // a case where the +1 bug and the correct count diverge sharply
    let g: Array[i64, 6] = [-10, -5, 0, 1, 2, 3];
    report(g, 5, "[-10,-5,0,1,2,3]");

    // already sorted vs reverse: sorting makes these identical
    let h: Array[i64, 5] = [3, 2, 1, 0, -1];
    report(h, 3, "[3,2,1,0,-1] (reversed)");
    let i: Array[i64, 5] = [-1, 0, 1, 2, 3];
    report(i, 3, "[-1,0,1,2,3] (sorted)");
}
