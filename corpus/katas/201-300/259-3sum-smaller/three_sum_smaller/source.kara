// LeetCode 259 — 3Sum Smaller. (Premium.)
//
// Count index triplets `i < j < k` with `nums[i] + nums[j] + nums[k] < target`.
//
// Sort, then for each `i` run two pointers over the suffix. The whole problem is
// in what happens when a triplet qualifies:
//
//     if nums[i] + nums[lo] + nums[hi] < target {
//         count = count + (hi - lo);   // NOT + 1
//         lo = lo + 1;
//     } else {
//         hi = hi - 1;
//     }
//
// **`hi - lo`, not 1.** Because the array is sorted, if the pair `(lo, hi)`
// qualifies then so does `(lo, k)` for EVERY `k` strictly between them — each
// such `nums[k] ≤ nums[hi]`, so each sum is no larger. That is `hi - lo`
// triplets counted in one step, and it is what turns an O(n³) count into O(n²).
// Writing `+ 1` gives a smaller, entirely plausible answer.
//
// Sorting is safe here because the answer counts SETS of indices, not ordered
// tuples: `i < j < k` ranges over each unordered triple exactly once, and
// reordering the array does not change which triples exist — only which indices
// name them. A problem that asked for the triples themselves could not sort.

fn three_sum_smaller(nums: Slice[i64], target: i64) -> i64 {
    let mut s: Vec[i64] = Vec.from_slice(nums);
    s.sort();
    let n = s.len();
    let mut count = 0;
    let mut i = 0;
    while i + 2 < n {
        let mut lo = i + 1;
        let mut hi = n - 1;
        while lo < hi {
            if s[i] + s[lo] + s[hi] < target {
                // Every k in (lo, hi] also qualifies — count them all at once.
                count = count + (hi - lo);
                lo = lo + 1;
            } else {
                hi = hi - 1;
            }
        }
        i = i + 1;
    }
    return count;
}

fn report(nums: Slice[i64], target: i64, label: ref String) {
    println(f"{label} t={target} -> {three_sum_smaller(nums, target)}");
}

fn main() {
    // [-2,0,1,3], target 2 -> 2  ([-2,0,1] and [-2,0,3])
    let a: Array[i64, 4] = [-2, 0, 1, 3];
    report(a, 2, "[-2,0,1,3]");

    // fewer than three elements -> 0
    let b: Array[i64, 0] = [];
    report(b, 0, "[]");
    let c: Array[i64, 2] = [0, 0];
    report(c, 5, "[0,0]");

    // [0,0,0], target 1 -> 1 (the single triple sums to 0)
    let d: Array[i64, 3] = [0, 0, 0];
    report(d, 1, "[0,0,0]");

    // ...and target 0 -> 0 (strictly less than, so 0 < 0 is false)
    report(d, 0, "[0,0,0]");

    // all negative: every triple qualifies for a positive target
    let e: Array[i64, 5] = [-5, -4, -3, -2, -1];
    report(e, 0, "[-5,-4,-3,-2,-1]");

    // duplicates, which the count must not collapse
    let f: Array[i64, 5] = [1, 1, 1, 1, 1];
    report(f, 4, "[1,1,1,1,1]");

    // a case where the +1 bug and the correct count diverge sharply
    let g: Array[i64, 6] = [-10, -5, 0, 1, 2, 3];
    report(g, 5, "[-10,-5,0,1,2,3]");

    // already sorted vs reverse: sorting makes these identical
    let h: Array[i64, 5] = [3, 2, 1, 0, -1];
    report(h, 3, "[3,2,1,0,-1] (reversed)");
    let i: Array[i64, 5] = [-1, 0, 1, 2, 3];
    report(i, 3, "[-1,0,1,2,3] (sorted)");
}
