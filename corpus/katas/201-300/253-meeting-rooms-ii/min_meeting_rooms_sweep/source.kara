// LeetCode 253 — Meeting Rooms II, chronological sweep.
//
// Forget that starts and ends are paired: sort the two coordinate lists
// separately and walk them together. At each start, release every room whose end
// has already passed, then take one. The running occupancy's maximum is the
// answer.
//
// This is exactly [#252](../252-meeting-rooms/)'s sweep with the early return
// removed — that kata stops the moment occupancy reaches 2, this one runs to the
// end and reports the peak. #252's file says as much in its own comments; this
// is the promise being kept.
//
// Decoupling the pair is legitimate because a room is freed by SOME meeting
// ending, and which one never matters — only how many are running. That is the
// same reason the heap file keys on end time alone.
//
// Two `Vec[i64]` sorts, no heap, no `sort_by` comparator: O(n log n) with a much
// smaller constant than the heap version, and a different compiler surface from
// both of its siblings.

fn min_meeting_rooms(intervals: Slice[(i64, i64)]) -> i64 {
    let n = intervals.len();
    if n == 0 {
        return 0;
    }
    let mut starts: Vec[i64] = Vec.new();
    let mut ends: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        starts.push(intervals[i].0);
        ends.push(intervals[i].1);
        i = i + 1;
    }
    starts.sort();
    ends.sort();

    let mut j = 0;
    let mut active = 0;
    let mut best = 0;
    let mut k = 0;
    while k < n {
        // `<=`, so a meeting ending exactly now frees its room in time.
        while j < n and ends[j] <= starts[k] {
            active = active - 1;
            j = j + 1;
        }
        active = active + 1;
        if active > best {
            best = active;
        }
        k = k + 1;
    }
    return best;
}

fn report(intervals: Slice[(i64, i64)], label: ref String) {
    println(f"{label} -> {min_meeting_rooms(intervals)}");
}

fn main() {
    let a: Array[(i64, i64), 3] = [(0, 30), (5, 10), (15, 20)];
    report(a, "[[0,30],[5,10],[15,20]]");
    let b: Array[(i64, i64), 2] = [(7, 10), (2, 4)];
    report(b, "[[7,10],[2,4]]");
    let c: Array[(i64, i64), 0] = [];
    report(c, "[]");
    let d: Array[(i64, i64), 1] = [(1, 5)];
    report(d, "[[1,5]]");
    let e: Array[(i64, i64), 2] = [(1, 5), (5, 10)];
    report(e, "[[1,5],[5,10]]");
    let f: Array[(i64, i64), 2] = [(1, 10), (2, 3)];
    report(f, "[[1,10],[2,3]]");
    let g: Array[(i64, i64), 4] = [(1, 3), (3, 5), (5, 7), (7, 9)];
    report(g, "[[1,3],[3,5],[5,7],[7,9]]");
    let h: Array[(i64, i64), 3] = [(1, 4), (2, 5), (3, 6)];
    report(h, "[[1,4],[2,5],[3,6]]");
    let i: Array[(i64, i64), 3] = [(1, 2), (1, 2), (1, 2)];
    report(i, "[[1,2],[1,2],[1,2]]");
    let j: Array[(i64, i64), 3] = [(9, 10), (4, 9), (4, 17)];
    report(j, "[[9,10],[4,9],[4,17]]");
    let k: Array[(i64, i64), 3] = [(2, 11), (6, 16), (11, 16)];
    report(k, "[[2,11],[6,16],[11,16]]");
}
