// Benchmark workload for LeetCode #257 — Binary Tree Paths.
//
// Build-once + punch. One RANDOM BUSHY tree of 150,000 nodes is built once, then
// every root-to-leaf path is enumerated 5 times with the ★ string-extending
// DFS.
//
// The tree is bushy on purpose. A spine is the pathological shape for this
// algorithm — see probe/ for that measurement, where the string walk holds
// O(depth²) bytes live and needs 355 MB at n=12,000 — but it is not the
// representative one, and a cross-language lane should measure the case people
// actually hit. A random tree has depth ~2·log₂(n) ≈ 37 here, so prefixes stay
// short and the work is dominated by path enumeration rather than by a
// pathological memory profile.
//
// The ★ form is benched rather than the join form because the two differ in an
// INTRA-language algorithmic property, not a cross-language one; mirroring both
// in four languages would measure the same algorithmic fact four more times.
// probe/ carries that comparison instead.
//
// Every mirror PRE-SIZES each child prefix. That is not incidental: C computes
// the exact length and mallocs once, and Go's `a + b + c` concatenation
// allocates the total in one go, so a Kara/Rust mirror that started from an
// empty String and grew would be doing strictly more allocator work than its
// siblings. Measured, before this was equalised: Rust grow-as-you-go 473 ms,
// Rust with_capacity 372 ms, C exact-malloc 332 ms -- allocation strategy
// accounted for about 70% of what looked like a C-versus-Rust language gap.
//
// The kata's own solver keeps the natural `let mut next: String = ""` form; this
// is a benchmark kernel, and equal allocator terms are what make the lane about
// path enumeration rather than about who reserves.
//
// Sink is a positional digest over the rendered paths, so path ORDER is part of
// what the mirrors must agree on.

struct Node {
    val: i64,
    mut left: i64,
    mut right: i64,
}

// Random bushy tree: each new node attaches to a uniformly chosen existing node
// that still has a free slot, giving depth ~2·log2(n).
fn build_bushy(n: i64) -> Vec[Node] {
    let mut nodes: Vec[Node] = Vec.new();
    let mut open: Vec[i64] = Vec.new(); // indices with at least one free child slot
    let mut state = 257257;
    state = (state * 1103515245 + 12345) & 2147483647;
    nodes.push(Node { val: (state / 65536) % 100 - 50, left: -1, right: -1 });
    open.push(0);

    let mut made = 1;
    while made < n {
        state = (state * 1103515245 + 12345) & 2147483647;
        let wd0 = state / 65536;
        state = (state * 1103515245 + 12345) & 2147483647;
        let pick = (wd0 * 32768 + state / 65536) % open.len();
        let parent = open[pick];
        state = (state * 1103515245 + 12345) & 2147483647;
        nodes.push(Node { val: (state / 65536) % 100 - 50, left: -1, right: -1 });
        let child = nodes.len() - 1;
        if nodes[parent].left == -1 {
            nodes[parent].left = child;
        } else {
            nodes[parent].right = child;
            // parent is full: swap-remove it from the open list
            let last = open[open.len() - 1];
            open[pick] = last;
            let _ = open.pop();
        }
        open.push(child);
        made = made + 1;
    }
    return nodes;
}

fn walk(nodes: ref Vec[Node], node: i64, prefix: ref String, out: mut ref Vec[String]) {
    let left = nodes[node].left;
    let right = nodes[node].right;
    if left == -1 and right == -1 {
        let mut done: String = "";
        done.push_str(prefix);
        out.push(done);
        return;
    }
    if left != -1 {
        let mut next: String = String.with_capacity(prefix.len() + 8);
        next.push_str(prefix);
        next.push_str("->");
        next.push_str(f"{nodes[left].val}");
        walk(nodes, left, next, out);
    }
    if right != -1 {
        let mut next: String = String.with_capacity(prefix.len() + 8);
        next.push_str(prefix);
        next.push_str("->");
        next.push_str(f"{nodes[right].val}");
        walk(nodes, right, next, out);
    }
}

fn main() {
    let n = 150000;
    let rounds = 5;
    let nodes = build_bushy(n);

    let mut sink = 0;
    let mut r = 0;
    while r < rounds {
        let mut out: Vec[String] = Vec.new();
        let mut root_s: String = "";
        root_s.push_str(f"{nodes[0].val}");
        walk(nodes, 0, root_s, mut out);

        let mut h = 1;
        let mut i = 0;
        while i < out.len() {
            let b = out[i].bytes();
            let mut k = 0;
            while k < b.len() {
                h = (h * 1000003 + (b[k] as i64)) % 1000000007;
                k = k + 1;
            }
            h = (h * 31 + 7) % 1000000007;
            i = i + 1;
        }
        sink = (sink * 131 + h) % 1000000007;
        r = r + 1;
    }
    println(sink);
}
