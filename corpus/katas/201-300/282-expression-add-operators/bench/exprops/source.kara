// LeetCode 282 bench kernel — the backtracking search over many inputs.
//
// THE SEARCH IS THE WORKLOAD and it is allocation-heavy in a way the ★ solver
// cannot avoid: every branch builds a new expression string by concatenation,
// so a 10-digit input walks ~4^9 partial strings. That is the honest cost of
// this algorithm and what the bench should measure — not a de-stringed variant
// that would run faster and answer a different question.
//
// THE SINK COUNTS AND HASHES, rather than collecting. Returning every expression
// for 64 ten-digit inputs would allocate gigabytes and measure the collector;
// the kernel accumulates a position-weighted hash of each solution's length and
// the running count instead. The search is identical — only the accept action
// differs — and a lane that pruned wrongly changes the count immediately.
//
// TARGETS ARE CHOSEN TO BE HIT. A target no expression reaches explores the same
// tree but never accepts, so the accept path would never run. Half the targets
// here are values the input can actually produce, which keeps both branches live.
//
// PARALLEL LANE. The 220 searches are over DIFFERENT inputs and share nothing,
// so this is parallelism the problem actually contains — unlike katas 279-281,
// where the sequential dependency is real and a fan-out would have to be
// manufactured.
//
// THE SINK HAD TO BECOME ORDER-INVARIANT for that lane to exist, which is the
// same change kata 270 made and for the same reason. The first version folded
// every solution into one running `hash * 31 + len` in DFS order across all
// inputs — a fold that depends on which search finished first. Each input now
// computes its own local (count, hash) and contributes
// `i * 1000003 + found * 31 + hash`, and those are SUMMED: the sum does not care
// which worker finished, while the `i` factor still catches two inputs swapping
// results, which a plain sum of counts would not.
//
// Worth being explicit that this is a sink redesign rather than a discovery: the
// original sink blocked the fan-out, and the sink was mine to choose.

fn digit_at(s: ref String, i: i64) -> i64 {
    let b = s.bytes();
    return (b[i] as i64) - 48;
}

fn search(num: ref String, target: i64, pos: i64, expr: String, cur: i64, last: i64,
          found: mut ref i64, hash: mut ref i64) {
    if pos == num.len() {
        if cur == target {
            found = found + 1;
            hash = (hash * 31 + expr.len()) % 1000000007;
        }
        return;
    }
    let mut end = pos + 1;
    while end <= num.len() {
        if end > pos + 1 and digit_at(num, pos) == 0 { return; }
        let piece = num.substring(pos, end);
        let mut n = 0;
        let mut k = pos;
        while k < end {
            n = n * 10 + digit_at(num, k);
            k = k + 1;
        }
        if pos == 0 {
            search(num, target, end, piece, n, n, found, hash);
        } else {
            search(num, target, end, expr.clone() + "+" + piece.clone(), cur + n, n, found, hash);
            search(num, target, end, expr.clone() + "-" + piece.clone(), cur - n, 0 - n, found, hash);
            search(num, target, end, expr + "*" + piece, cur - last + last * n, last * n, found, hash);
        }
        end = end + 1;
    }
}

fn make_input(idx: i64) -> String {
    // deterministic per-input digits, so a branch can build its own without
    // threading a shared seed through the parallel loop
    let mut seed = (20260820 + idx * 7919) % 2147483648;
    let mut num: String = "";
    let mut d = 0;
    while d < 9 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let dig = 1 + (seed / 19) % 6;
        if dig == 1 { num = num + "1"; }
        if dig == 2 { num = num + "2"; }
        if dig == 3 { num = num + "3"; }
        if dig == 4 { num = num + "4"; }
        if dig == 5 { num = num + "5"; }
        if dig == 6 { num = num + "6"; }
        d = d + 1;
    }
    return num;
}

fn target_for(idx: i64) -> i64 {
    let mut seed = (20260820 + idx * 7919) % 2147483648;
    let mut d = 0;
    while d < 10 { seed = (seed * 1103515245 + 12345) % 2147483648; d = d + 1; }
    return (seed / 23) % 40;
}

fn main() {
    let inputs = 220;

    let mut parts: Vec[i64] = Vec.new();
    #[par_order_free]
    for i in 0..inputs {
        let num = make_input(i);
        let target = target_for(i);
        let mut found = 0;
        let mut hash = 0;
        search(num, target, 0, "", 0, 0, mut found, mut hash);
        parts.push((i * 1000003 + found * 31 + hash) % 1000000007);
    }

    let mut sink = 0;
    let mut k = 0;
    while k < parts.len() {
        sink = (sink + parts[k]) % 1000000007;
        k = k + 1;
    }
    println(sink);
}
