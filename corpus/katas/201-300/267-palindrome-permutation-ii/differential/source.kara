// LeetCode 267 — differential harness.
//
// Runs the three generators — half-backtracking (★), half + next-permutation,
// and whole-string brute force — and checks all three against a FOURTH oracle
// that generates nothing at all.
//
// THE CLOSED FORM IS THE POINT. The number of distinct palindromic permutations
// is the number of distinct arrangements of the half multiset:
//
//     (n/2)! / prod_c (count_c / 2)!
//
// That is a formula, not an enumeration: it shares no code, no loop and no
// deduplication argument with any of the three generators. All three could
// double-count in the same way — the classic failure here — and agree with each
// other perfectly while the multinomial disagrees with all of them. It also
// covers the long inputs where the O(n!) brute force cannot follow, so the
// count stays checked after the reference drops out.
//
// The two half-based forms fail in different places: the backtracking one can
// duplicate (iterate positions rather than distinct characters and "aabb"
// yields "abba" twice), while the iterative one cannot duplicate but can
// mis-mirror (an off-by-one in the reversed tail, or forgetting the middle is
// not part of the half). The brute force asserts nothing at all and is the
// reference for content, as opposed to the multinomial which is the reference
// for count.
//
// GENERATOR DESIGN. Random strings over a wide alphabet are essentially never
// permutable, so the answer would be the empty list almost always. Half the
// families therefore CONSTRUCT permutable inputs — pairs plus an optional lone
// middle — and one deliberately breaks a constructed input to make the empty
// case arrive for a structural reason rather than by luck.

fn is_pal(a: ref Vec[i64]) -> bool {
    let n = a.len();
    let mut i = 0;
    let mut j = n - 1;
    while i < j {
        if a[i] != a[j] { return false; }
        i = i + 1;
        j = j - 1;
    }
    return true;
}

fn next_perm(a: mut ref Vec[i64]) -> bool {
    let n = a.len();
    if n < 2 { return false; }
    let mut i = n - 2;
    while i >= 0 and a[i] >= a[i + 1] { i = i - 1; }
    if i < 0 { return false; }
    let mut j = n - 1;
    while a[j] <= a[i] { j = j - 1; }
    let t = a[i]; a[i] = a[j]; a[j] = t;
    let mut lo = i + 1;
    let mut hi = n - 1;
    while lo < hi {
        let u = a[lo]; a[lo] = a[hi]; a[hi] = u;
        lo = lo + 1;
        hi = hi - 1;
    }
    return true;
}

fn render(a: ref Vec[i64]) -> String {
    let mut s = "";
    let mut i = 0;
    while i < a.len() {
        s = s + f"{a[i] as u8 as char}";
        i = i + 1;
    }
    return s;
}

fn counts_of(chars: ref Vec[i64]) -> Vec[i64] {
    let mut counts: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < 128 { counts.push(0); i = i + 1; }
    let mut p = 0;
    while p < chars.len() {
        counts[chars[p]] = counts[chars[p]] + 1;
        p = p + 1;
    }
    return counts;
}

fn build(counts: mut ref Vec[i64], half: mut ref Vec[i64], half_len: i64,
         middle: i64, out: mut ref Vec[String]) {
    if half.len() == half_len {
        let mut s = "";
        let mut i = 0;
        while i < half.len() { s = s + f"{half[i] as u8 as char}"; i = i + 1; }
        if middle >= 0 { s = s + f"{middle as u8 as char}"; }
        let mut j = half.len() - 1;
        while j >= 0 { s = s + f"{half[j] as u8 as char}"; j = j - 1; }
        out.push(s);
        return;
    }
    let mut c = 0;
    while c < 128 {
        if counts[c] > 0 {
            counts[c] = counts[c] - 1;
            half.push(c);
            build(counts, half, half_len, middle, out);
            half.pop();
            counts[c] = counts[c] + 1;
        }
        c = c + 1;
    }
}

fn gen_backtrack(chars: ref Vec[i64]) -> Vec[String] {
    let mut counts = counts_of(chars);
    let mut odd = 0;
    let mut middle = -1;
    let mut half_len = 0;
    let mut c = 0;
    while c < 128 {
        if counts[c] % 2 == 1 { odd = odd + 1; middle = c; }
        counts[c] = counts[c] / 2;
        half_len = half_len + counts[c];
        c = c + 1;
    }
    let mut out: Vec[String] = Vec.new();
    if odd > 1 { return out; }
    let mut half: Vec[i64] = Vec.new();
    build(mut counts, mut half, half_len, middle, mut out);
    return out;
}

fn gen_iter(chars: ref Vec[i64]) -> Vec[String] {
    let counts = counts_of(chars);
    let mut odd = 0;
    let mut middle = -1;
    let mut half: Vec[i64] = Vec.new();
    let mut c = 0;
    while c < 128 {
        if counts[c] % 2 == 1 { odd = odd + 1; middle = c; }
        let take = counts[c] / 2;
        let mut k = 0;
        while k < take { half.push(c); k = k + 1; }
        c = c + 1;
    }
    let mut out: Vec[String] = Vec.new();
    if odd > 1 { return out; }
    while true {
        let mut s = "";
        let mut p = 0;
        while p < half.len() { s = s + f"{half[p] as u8 as char}"; p = p + 1; }
        if middle >= 0 { s = s + f"{middle as u8 as char}"; }
        let mut q = half.len() - 1;
        while q >= 0 { s = s + f"{half[q] as u8 as char}"; q = q - 1; }
        out.push(s);
        if not next_perm(mut half) { break; }
    }
    return out;
}

fn gen_brute(chars: ref Vec[i64]) -> Vec[String] {
    let mut a: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < chars.len() { a.push(chars[i]); i = i + 1; }
    a.sort();
    let mut out: Vec[String] = Vec.new();
    if a.len() == 0 { out.push(""); return out; }
    if is_pal(a) { out.push(render(a)); }
    while next_perm(mut a) {
        if is_pal(a) { out.push(render(a)); }
    }
    return out;
}

// The fourth oracle: (half_len)! / prod (count_c/2)!, computed without
// generating anything. -1 means "no palindrome exists".
fn multinomial(chars: ref Vec[i64]) -> i64 {
    let counts = counts_of(chars);
    let mut odd = 0;
    let mut half_len = 0;
    let mut c = 0;
    while c < 128 {
        if counts[c] % 2 == 1 { odd = odd + 1; }
        half_len = half_len + counts[c] / 2;
        c = c + 1;
    }
    if odd > 1 { return -1; }
    let mut num = 1;
    let mut k = 2;
    while k <= half_len { num = num * k; k = k + 1; }
    let mut d = 0;
    while d < 128 {
        let h = counts[d] / 2;
        let mut f = 1;
        let mut m = 2;
        while m <= h { f = f * m; m = m + 1; }
        num = num / f;
        d = d + 1;
    }
    return num;
}

fn same(a: ref Vec[String], b: ref Vec[String]) -> bool {
    if a.len() != b.len() { return false; }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn main() {
    let cases = 2500;
    let mut seed = 267267;

    let mut mismatches = 0;
    let mut brute_checked = 0;
    let mut brute_disagree = 0;
    let mut count_disagree = 0;
    let mut nonempty = 0;
    let mut total_results = 0;
    let mut digest = 0;

    let mut c = 0;
    while c < cases {
        seed = (seed * 1103515245 + 12345) & 2147483647;
        let family = (seed / 65536) % 6;

        let mut chars: Vec[i64] = Vec.new();

        if family <= 1 {
            // Uniform random, short — mostly not permutable.
            let alpha = family + 2;
            seed = (seed * 1103515245 + 12345) & 2147483647;
            let n = (seed / 65536) % 9;
            let mut i = 0;
            while i < n {
                seed = (seed * 1103515245 + 12345) & 2147483647;
                chars.push(97 + (seed / 65536) % alpha);
                i = i + 1;
            }
        }
        if family == 2 or family == 3 {
            // ★ Constructed permutable: pairs plus an optional lone middle.
            let mut pairs = 3;
            let mut alpha = 3;
            if family == 3 { pairs = 5; alpha = 4; }
            seed = (seed * 1103515245 + 12345) & 2147483647;
            let np = (seed / 65536) % (pairs + 1);
            let mut i = 0;
            while i < np {
                seed = (seed * 1103515245 + 12345) & 2147483647;
                let ch = 97 + (seed / 65536) % alpha;
                chars.push(ch);
                chars.push(ch);
                i = i + 1;
            }
            seed = (seed * 1103515245 + 12345) & 2147483647;
            if (seed / 65536) % 2 == 1 {
                seed = (seed * 1103515245 + 12345) & 2147483647;
                chars.push(97 + (seed / 65536) % alpha);
            }
        }
        if family == 4 {
            // Constructed, then one character changed: usually two odd counts,
            // so the empty answer arrives structurally rather than by luck.
            seed = (seed * 1103515245 + 12345) & 2147483647;
            let np = (seed / 65536) % 3 + 1;
            let mut i = 0;
            while i < np {
                seed = (seed * 1103515245 + 12345) & 2147483647;
                let ch = 97 + (seed / 65536) % 3;
                chars.push(ch);
                chars.push(ch);
                i = i + 1;
            }
            seed = (seed * 1103515245 + 12345) & 2147483647;
            let at = (seed / 65536) % chars.len();
            seed = (seed * 1103515245 + 12345) & 2147483647;
            chars[at] = 97 + (seed / 65536) % 3;
        }
        if family == 5 {
            // A single repeated character: exactly one palindrome, always.
            seed = (seed * 1103515245 + 12345) & 2147483647;
            let n = (seed / 65536) % 9;
            seed = (seed * 1103515245 + 12345) & 2147483647;
            let ch = 97 + (seed / 65536) % 3;
            let mut i = 0;
            while i < n { chars.push(ch); i = i + 1; }
        }

        // Shuffle, so nothing leans on the constructed order.
        let m = chars.len();
        let mut sh = m - 1;
        while sh > 0 {
            seed = (seed * 1103515245 + 12345) & 2147483647;
            let j = (seed / 65536) % (sh + 1);
            let t = chars[sh]; chars[sh] = chars[j]; chars[j] = t;
            sh = sh - 1;
        }

        let a = gen_backtrack(chars);
        let b = gen_iter(chars);
        if not same(a, b) { mismatches = mismatches + 1; }

        // Reference for CONTENT, where factorial cost allows.
        if m <= 8 {
            brute_checked = brute_checked + 1;
            let d = gen_brute(chars);
            if not same(a, d) { brute_disagree = brute_disagree + 1; }
        }

        // Reference for COUNT, at every size.
        let want = multinomial(chars);
        let got = a.len();
        if want < 0 {
            if got != 0 { count_disagree = count_disagree + 1; }
        } else {
            if got != want { count_disagree = count_disagree + 1; }
        }

        if got > 0 { nonempty = nonempty + 1; }
        total_results = total_results + got;
        let mut h = 0;
        let mut k = 0;
        while k < a.len() {
            for ch in a[k].bytes() { h = (h * 31 + ch as i64) % 1000000007; }
            k = k + 1;
        }
        digest = (digest * 131 + h + got) % 1000000007;
        c = c + 1;
    }

    println(f"cases {cases}");
    println(f"non-empty answers {nonempty}");
    println(f"palindromes generated {total_results}");
    println(f"brute-force verified {brute_checked}");
    println(f"brute-force disagreements {brute_disagree}");
    println(f"multinomial disagreements {count_disagree}");
    println(f"digest {digest}");
    println(f"mismatches {mismatches}");
}
