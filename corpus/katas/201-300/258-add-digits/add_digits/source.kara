// LeetCode 258 — Add Digits.
//
// Repeatedly sum a number's digits until one digit is left. `38 -> 3+8 = 11 ->
// 1+1 = 2`.
//
// This file is the literal simulation: an inner loop that peels digits with
// `% 10` and `/ 10`, wrapped in an outer loop that repeats while the total is
// still two digits or more. It is O(log n) per pass and O(log* n) passes — in
// practice at most three for any i64, because the first pass collapses a
// 19-digit number to at most 171.
//
// The point of keeping it alongside the closed form is that it is the DEFINITION.
// `add_digits_formula.kara` computes the same value in constant time from a
// congruence, and a congruence is exactly the kind of thing that is easy to
// state slightly wrong — the simulation is what proves it right, over an
// exhaustive sweep in `differential.kara`.

fn add_digits(num: i64) -> i64 {
    let mut n = num;
    while n >= 10 {
        let mut sum = 0;
        while n > 0 {
            sum = sum + n % 10;
            n = n / 10;
        }
        n = sum;
    }
    return n;
}

fn report(n: i64) {
    println(f"{n} -> {add_digits(n)}");
}

fn main() {
    report(38);   // 3+8=11 -> 1+1=2
    report(0);    // 0 stays 0
    report(9);    // already one digit
    report(10);   // 1+0 = 1
    report(18);   // 1+8 = 9
    report(19);   // 1+9=10 -> 1
    report(99);   // 9+9=18 -> 9
    report(100);  // 1
    report(12345);
    report(999999999);
    report(2147483647);          // the LeetCode upper bound
    report(9223372036854775807); // i64.MAX — three passes
}
