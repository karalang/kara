// Benchmark harness for LeetCode #246 — Strobogrammatic Number.
//
// Build-once + punch (BENCHMARKS.md): 20,000 length-32 numbers are built ONCE,
// then 100 passes run the two-pointer check over all of them — 2,000,000 calls.
//
// THE CORPUS IS DELIBERATELY MOSTLY ACCEPTING, and that is the whole benchmark
// design. A uniform digit draw would make almost every number reject on its
// FIRST character, so the measured work would be loop entry plus an early
// return — the scan this kata is about would barely run. So every number is
// constructed strobogrammatic, and 1 in 8 is corrupted at one random position:
// that rejects, but on average halfway through, so a reject still does real
// work and the branch predictor cannot learn a fixed answer.
//
// What this measures: raw byte indexing from both ends with a 5-way map per
// pair, over 32M pair-checks, with no allocation anywhere in the measured loop.
//
// THE CORPUS IS ONE FLAT `Vec[u8]` of N*LEN bytes, indexed by offset — NOT
// 20,000 separate `String`s. That matches C (`malloc(N*LEN)`), Rust
// (`vec![0u8; N*LEN]`) and Go (`make([]byte, n*length)`) exactly. An earlier
// revision of this lane pushed 20,000 heap `String`s while the other three
// streamed one contiguous 640 KB buffer, so the punch loop chased scattered
// pointers here and walked a flat array everywhere else — a cache-locality
// difference introduced by the mirror, not a codegen property. See the README's
// § Runtime note for what that correction did to the number.
//
// Sink: a rolling polynomial hash of the 2,000,000 verdicts. Loop-carried, so
// the punch loop is not a reduction the auto-par pass can split — sequential by
// construction and directly comparable per-core.

fn lcg(state: i64) -> i64 {
    (state * 1103515245 + 12345) & 2147483647
}

// Byte-indexed, not `chars().collect()`. Kāra refuses `s[i]` outright — the
// diagnostic says "s[i] would hide an O(n) scan — Strings are UTF-8 encoded and
// characters are variable-width", and names both alternatives with their
// complexity: `char_at(i)` is O(n), `bytes()[i]` is O(1). The input here is
// ASCII digits, so `bytes()` is both correct and the honest parity choice: it
// is exactly what the C mirror does (index the bytes in place) and what Go and
// Rust do naturally (`num[i]`, `num.as_bytes()[i]`). Materialising a character
// vector per call would have made the Kāra lane do strictly more work than C
// and reported the difference as codegen quality.
//
// ASCII digit bytes: '0'=48 '1'=49 '6'=54 '8'=56 '9'=57. Zero means "does not
// survive rotation" — no digit maps to byte 0, so it is a safe sentinel here
// and avoids an Option in the hot loop (the KATA file keeps the Option[char]
// form; this is the benchmark's shape, stated rather than smuggled).
fn rotate_byte(b: u8) -> u8 {
    if b == 48u8 { return 48u8; }
    if b == 49u8 { return 49u8; }
    if b == 56u8 { return 56u8; }
    if b == 54u8 { return 57u8; }
    if b == 57u8 { return 54u8; }
    return 0u8;
}

// Offset into the flat corpus, exactly as the C mirror takes `corpus + i*LEN`.
fn is_strobogrammatic(corpus: ref Vec[u8], base: i64, len: i64) -> bool {
    let mut lo = 0;
    let mut hi = len - 1;
    while lo <= hi {
        let r = rotate_byte(corpus[base + lo]);
        if r == 0u8 or r != corpus[base + hi] {
            return false;
        }
        lo = lo + 1;
        hi = hi - 1;
    }
    return true;
}

fn main() {
    let n = 20000;
    let len = 32;
    let passes = 100;

    let mut pair_a: Vec[u8] = Vec.new();
    let mut pair_b: Vec[u8] = Vec.new();
    pair_a.push(48u8); pair_b.push(48u8);
    pair_a.push(49u8); pair_b.push(49u8);
    pair_a.push(56u8); pair_b.push(56u8);
    pair_a.push(54u8); pair_b.push(57u8);
    pair_a.push(57u8); pair_b.push(54u8);

    let mut all: Vec[u8] = Vec.new();
    all.push(48u8); all.push(49u8); all.push(50u8); all.push(51u8); all.push(52u8);
    all.push(53u8); all.push(54u8); all.push(55u8); all.push(56u8); all.push(57u8);

    // One flat buffer, like every other lane.
    let mut corpus: Vec[u8] = Vec.filled(n * len, 48u8);

    let mut state = 1;
    let mut k = 0;
    while k < n {
        let base = k * len;
        let mut lo = 0;
        let mut hi = len - 1;
        while lo < hi {
            state = lcg(state);
            let p = (state / 65536) % 5;
            corpus[base + lo] = pair_a[p];
            corpus[base + hi] = pair_b[p];
            lo = lo + 1;
            hi = hi - 1;
        }
        state = lcg(state);
        if (state / 65536) % 8 == 0 {
            state = lcg(state);
            let pos = (state / 65536) % len;
            state = lcg(state);
            corpus[base + pos] = all[(state / 65536) % 10];
        }
        k = k + 1;
    }

    let mut acc = 0;
    let mut p = 0;
    while p < passes {
        let mut i = 0;
        while i < n {
            if is_strobogrammatic(corpus, i * len, len) {
                acc = (acc * 131 + 1) % 1000000007;
            } else {
                acc = (acc * 131 + 0) % 1000000007;
            }
            i = i + 1;
        }
        p = p + 1;
    }
    println(f"{acc}");
}
