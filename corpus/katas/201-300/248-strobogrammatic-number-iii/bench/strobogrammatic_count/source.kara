// Benchmark workload for LeetCode #248 — Strobogrammatic Number III.
//
// The CLOSED-FORM counting variant is the kernel here, not the generate-and-
// filter one: #247's lane already measures allocation-heavy recursive string
// building, and this file's whole point is that it avoids exactly that for every
// interior length. Benching the generate-and-filter twin would re-measure #247.
//
// A deterministic LCG draws 1,000 [low, high] digit-string pairs of up to 8
// digits. The bounds are data-dependent on the LCG, so the boundary-vs-interior
// split differs per query and the branch does not predict away.
//
// The 8-digit cap is deliberate and was measured, not guessed. The closed form
// skips INTERIOR lengths only — both boundary lengths are still enumerated — so
// per-query cost is set by the longer bound: ~13 ms at 15 digits (4*5^6*3 =
// 187,500 strings) against ~0.4 ms at 8 (4*5^3 = 500). Sizing to 15 digits would
// have measured boundary enumeration, which is #247's lane, and reduced this one
// to ~35 queries — too few for a stable mean. At 8 digits the closed-form path
// is the one that dominates, which is what this variant exists to show.
//
// Sink = accumulated count across every query.

// LeetCode 248 — counting variant.
//
// The generate-and-filter solution in strobogrammatic_iii.kara enumerates
// every strobogrammatic number of every length in range. But only the two
// BOUNDARY lengths ever need looking at: a candidate whose length sits
// strictly between len(low) and len(high) is in range by construction. For
// those interior lengths the count is a closed form, so they need not be
// materialised at all.
//
// Count of strobogrammatic numbers with exactly L digits and no leading zero:
//   L == 1          -> 3            ("0", "1", "8")
//   L even          -> 4 * 5^(L/2 - 1)
//   L odd, L >= 3   -> 4 * 5^((L-1)/2 - 1) * 3
// The 4 is the outermost pair (five pairs minus the barred 0/0), each further
// pair is a free 5, and an odd length adds a centre worth 3. That reproduces
// 3, 4, 12, 20, 60, 100, 300 for L = 1..7 — the #247 counts.
//
// So this walks the same answer with generation confined to at most two
// lengths. On a 15-digit bound that is the difference between enumerating
// ~250k strings and enumerating the boundary lengths alone.
//
// Kept alongside the generate-and-filter version rather than replacing it:
// they are different shapes for the compiler (closed-form integer arithmetic
// with an exponent loop, versus allocation-heavy recursive string building),
// and the corpus wants both. Their outputs must agree exactly.

fn pow5(e: i64) -> i64 {
    let mut acc = 1;
    let mut i = 0;
    while i < e {
        acc = acc * 5;
        i = i + 1;
    }
    return acc;
}

fn count_of_length(len: i64) -> i64 {
    if len <= 0 {
        return 0;
    }
    if len == 1 {
        return 3;
    }
    let mut total = 4 * pow5(len / 2 - 1);
    if len % 2 == 1 {
        total = total * 3;
    }
    return total;
}

fn build(k: i64, n: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if k == 0 {
        out.push("");
        return out;
    }
    if k == 1 {
        out.push("0");
        out.push("1");
        out.push("8");
        return out;
    }

    let mut pair_a: Vec[String] = Vec.new();
    let mut pair_b: Vec[String] = Vec.new();
    pair_a.push("0"); pair_b.push("0");
    pair_a.push("1"); pair_b.push("1");
    pair_a.push("6"); pair_b.push("9");
    pair_a.push("8"); pair_b.push("8");
    pair_a.push("9"); pair_b.push("6");

    let inner = build(k - 2, n);
    let mut i = 0;
    while i < inner.len() {
        let mut p = 0;
        while p < 5 {
            if pair_a[p] == "0" and k == n {
                p = p + 1;
            } else {
                let mut s: String = pair_a[p].clone();
                s.push_str(inner[i]);
                s.push_str(pair_b[p]);
                out.push(s);
                p = p + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn cmp_digits(a: ref String, b: ref String) -> i64 {
    let xs = a.bytes();
    let ys = b.bytes();
    if xs.len() != ys.len() {
        if xs.len() < ys.len() { return -1; }
        return 1;
    }
    let mut i = 0;
    while i < xs.len() {
        if xs[i] != ys[i] {
            if xs[i] < ys[i] { return -1; }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Candidates of exactly `len` digits that satisfy the active bounds. `use_lo`
// / `use_hi` say whether this length is the low / high boundary; an interior
// length never reaches here.
fn count_bounded(len: i64, low: ref String, high: ref String, use_lo: bool, use_hi: bool) -> i64 {
    let cands = build(len, len);
    let mut n = 0;
    let mut i = 0;
    while i < cands.len() {
        let s = ref cands[i];
        let mut keep = true;
        if use_lo and cmp_digits(s, low) < 0 {
            keep = false;
        }
        if use_hi and cmp_digits(s, high) > 0 {
            keep = false;
        }
        if keep {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn count_in_range(low: ref String, high: ref String) -> i64 {
    let lo_len = low.bytes().len();
    let hi_len = high.bytes().len();
    if lo_len > hi_len {
        return 0;
    }
    if lo_len == hi_len {
        if cmp_digits(low, high) > 0 {
            return 0;
        }
        // One length carries both bounds.
        return count_bounded(lo_len, low, high, true, true);
    }

    let mut total = count_bounded(lo_len, low, high, true, false);
    total = total + count_bounded(hi_len, low, high, false, true);
    // Interior lengths are wholly in range — closed form, nothing built.
    let mut len = lo_len + 1;
    while len < hi_len {
        total = total + count_of_length(len);
        len = len + 1;
    }
    return total;
}

fn digits_of(v: i64) -> String {
    if v == 0 {
        return "0";
    }
    let mut rev: Vec[i64] = Vec.new();
    let mut x = v;
    while x > 0 {
        rev.push(x % 10);
        x = x / 10;
    }
    let mut s: String = "";
    let mut i = rev.len() - 1;
    while i >= 0 {
        s.push_str(f"{rev[i]}");
        i = i - 1;
    }
    return s;
}

fn main() {
    let queries = 1000;
    let mut state = 248248;
    let mut sink = 0;

    let mut q = 0;
    while q < queries {
        // Two magnitudes in [1, 15] digits, ordered low <= high.
        state = (state * 1103515245 + 12345) & 2147483647;
        let da = (state / 65536) % 8 + 1;
        state = (state * 1103515245 + 12345) & 2147483647;
        let db = (state / 65536) % 8 + 1;

        state = (state * 1103515245 + 12345) & 2147483647;
        let ra = (state / 65536) % 9000 + 1;
        state = (state * 1103515245 + 12345) & 2147483647;
        let rb = (state / 65536) % 9000 + 1;

        let mut a = ra;
        let mut i = 1;
        while i < da {
            a = a * 10 % 1000000000000000 + (i % 10);
            i = i + 1;
        }
        let mut b = rb;
        let mut j = 1;
        while j < db {
            b = b * 10 % 1000000000000000 + (j % 10);
            j = j + 1;
        }
        if a > b {
            let t = a;
            a = b;
            b = t;
        }

        let n = count_in_range(digits_of(a), digits_of(b));
        sink = (sink + n) % 1000000007;
        q = q + 1;
    }
    println(sink);
}
