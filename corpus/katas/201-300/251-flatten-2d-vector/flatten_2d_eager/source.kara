// LeetCode 251 — Flatten 2D Vector, eager copy.
//
// The blunt alternative to the ★ file's lazy cursor: walk the whole 2D input at
// construction and copy every element into one flat `Vec[i64]`. `has_next` is a
// bounds test and `next` is an index — the empty-row problem disappears entirely,
// because empty rows contribute nothing to the copy and there is no cursor left
// to strand on one.
//
// The trade is real and worth stating: O(total) extra space, and all of the work
// happens up front whether or not the caller drains the iterator. An iterator
// that is abandoned after one `next` has still paid for the whole flatten. The ★
// file pays per element consumed.
//
// It is here because it is the version most people write first, and because a
// differential is only as good as the independence of the things it compares —
// this one shares no traversal logic with the other two.

struct Vector2D {
    flat: Vec[i64],
    mut pos: i64,
}

fn v_new(data: Vec[Vec[i64]]) -> Vector2D {
    let mut flat: Vec[i64] = Vec.new();
    let mut r = 0;
    while r < data.len() {
        let mut c = 0;
        while c < data[r].len() {
            flat.push(data[r][c]);
            c = c + 1;
        }
        r = r + 1;
    }
    return Vector2D { flat: flat, pos: 0 };
}

fn v_has_next(v: mut ref Vector2D) -> bool {
    return v.pos < v.flat.len();
}

fn v_next(v: mut ref Vector2D) -> i64 {
    if v.pos >= v.flat.len() {
        return -1;
    }
    let x = v.flat[v.pos];
    v.pos = v.pos + 1;
    return x;
}

fn drain(v: mut ref Vector2D) -> String {
    let mut out: String = "";
    let mut first = true;
    while v_has_next(v) {
        if not v_has_next(v) {
            return "IDEMPOTENCE BROKEN";
        }
        let x = v_next(v);
        if not first {
            out.push_str(" ");
        }
        out.push_str(f"{x}");
        first = false;
    }
    if v_has_next(v) {
        return "EXHAUSTION BROKEN";
    }
    if out.len() == 0 {
        return "(empty)";
    }
    return out;
}

fn row_of(a: Slice[i64]) -> Vec[i64] {
    let mut r: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < a.len() {
        r.push(a[i]);
        i = i + 1;
    }
    return r;
}

fn main() {
    let e0: Array[i64, 0] = [];

    let mut a: Vec[Vec[i64]] = Vec.new();
    let r1: Array[i64, 2] = [1, 2];
    let r2: Array[i64, 1] = [3];
    let r3: Array[i64, 1] = [4];
    a.push(row_of(r1));
    a.push(row_of(r2));
    a.push(row_of(r3));
    let mut v1 = v_new(a);
    println(drain(mut v1));

    let b: Vec[Vec[i64]] = Vec.new();
    let mut v2 = v_new(b);
    println(drain(mut v2));

    let mut c: Vec[Vec[i64]] = Vec.new();
    c.push(row_of(e0));
    let mut v3 = v_new(c);
    println(drain(mut v3));

    let mut d: Vec[Vec[i64]] = Vec.new();
    d.push(row_of(e0));
    d.push(row_of(e0));
    d.push(row_of(e0));
    let mut v4 = v_new(d);
    println(drain(mut v4));

    let mut e: Vec[Vec[i64]] = Vec.new();
    let one: Array[i64, 1] = [1];
    e.push(row_of(e0));
    e.push(row_of(one));
    e.push(row_of(e0));
    let mut v5 = v_new(e);
    println(drain(mut v5));

    let mut f: Vec[Vec[i64]] = Vec.new();
    let sev: Array[i64, 2] = [7, 8];
    let nin: Array[i64, 1] = [9];
    f.push(row_of(e0));
    f.push(row_of(e0));
    f.push(row_of(sev));
    f.push(row_of(e0));
    f.push(row_of(e0));
    f.push(row_of(nin));
    f.push(row_of(e0));
    let mut v6 = v_new(f);
    println(drain(mut v6));

    let mut g: Vec[Vec[i64]] = Vec.new();
    let g1: Array[i64, 3] = [1, 2, 3];
    g.push(row_of(g1));
    let mut v7 = v_new(g);
    println(drain(mut v7));
}
