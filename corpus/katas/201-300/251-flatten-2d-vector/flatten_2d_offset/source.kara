// LeetCode 251 — Flatten 2D Vector, prefix offsets + binary search.
//
// A third independent shape. Build a prefix-sum table of row lengths ONCE, then
// keep a single linear position `k` in [0, total). Each `next` maps k to its
// (row, col) by binary-searching the prefix table.
//
// The point is not speed — it is O(log r) per element where the ★ cursor is
// amortized O(1), so this is the slowest of the three. The point is that a
// linear position is RANDOM-ACCESS: `seek(k)` is O(log r) here and O(k) for the
// cursor, and impossible to add to the eager copy without keeping the same
// table. That is the shape you want if the iterator ever needs to rewind or
// jump, which is the natural follow-up question this problem invites.
//
// Empty rows need no special handling at all: a zero-length row contributes a
// zero-width span to the prefix table, so no k ever lands in it. The state
// machine that the ★ file spends its `skip_empty` on is here replaced by an
// interval that is simply empty — arguably the cleanest answer to the problem's
// actual difficulty.

struct Vector2D {
    data: Vec[Vec[i64]],
    prefix: Vec[i64], // prefix[i] = number of elements before row i; len = rows+1
    mut k: i64,
}

fn v_new(data: Vec[Vec[i64]]) -> Vector2D {
    let mut prefix: Vec[i64] = Vec.new();
    prefix.push(0);
    let mut r = 0;
    let mut running = 0;
    while r < data.len() {
        running = running + data[r].len();
        prefix.push(running);
        r = r + 1;
    }
    return Vector2D { data: data, prefix: prefix, k: 0 };
}

fn v_total(v: ref Vector2D) -> i64 {
    return v.prefix[v.prefix.len() - 1];
}

fn v_has_next(v: mut ref Vector2D) -> bool {
    return v.k < v_total(v);
}

// Largest row index whose prefix is <= k. Rows of length 0 produce EQUAL
// consecutive prefix entries, so the search must land on the LAST such row —
// hence the upper-bound form (find first prefix > k, step back one) rather than
// a plain lower bound, which would stop on the first of a run of empties and
// index a zero-length row.
fn row_for(v: ref Vector2D, k: i64) -> i64 {
    let mut lo = 0;
    let mut hi = v.prefix.len() - 1; // search over prefix[1..], answer in [0, rows)
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if v.prefix[mid + 1] > k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

fn v_next(v: mut ref Vector2D) -> i64 {
    if v.k >= v_total(v) {
        return -1;
    }
    let r = row_for(v, v.k);
    let c = v.k - v.prefix[r];
    v.k = v.k + 1;
    return v.data[r][c];
}

fn drain(v: mut ref Vector2D) -> String {
    let mut out: String = "";
    let mut first = true;
    while v_has_next(v) {
        if not v_has_next(v) {
            return "IDEMPOTENCE BROKEN";
        }
        let x = v_next(v);
        if not first {
            out.push_str(" ");
        }
        out.push_str(f"{x}");
        first = false;
    }
    if v_has_next(v) {
        return "EXHAUSTION BROKEN";
    }
    if out.len() == 0 {
        return "(empty)";
    }
    return out;
}

fn row_of(a: Slice[i64]) -> Vec[i64] {
    let mut r: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < a.len() {
        r.push(a[i]);
        i = i + 1;
    }
    return r;
}

fn main() {
    let e0: Array[i64, 0] = [];

    let mut a: Vec[Vec[i64]] = Vec.new();
    let r1: Array[i64, 2] = [1, 2];
    let r2: Array[i64, 1] = [3];
    let r3: Array[i64, 1] = [4];
    a.push(row_of(r1));
    a.push(row_of(r2));
    a.push(row_of(r3));
    let mut v1 = v_new(a);
    println(drain(mut v1));

    let b: Vec[Vec[i64]] = Vec.new();
    let mut v2 = v_new(b);
    println(drain(mut v2));

    let mut c: Vec[Vec[i64]] = Vec.new();
    c.push(row_of(e0));
    let mut v3 = v_new(c);
    println(drain(mut v3));

    let mut d: Vec[Vec[i64]] = Vec.new();
    d.push(row_of(e0));
    d.push(row_of(e0));
    d.push(row_of(e0));
    let mut v4 = v_new(d);
    println(drain(mut v4));

    let mut e: Vec[Vec[i64]] = Vec.new();
    let one: Array[i64, 1] = [1];
    e.push(row_of(e0));
    e.push(row_of(one));
    e.push(row_of(e0));
    let mut v5 = v_new(e);
    println(drain(mut v5));

    let mut f: Vec[Vec[i64]] = Vec.new();
    let sev: Array[i64, 2] = [7, 8];
    let nin: Array[i64, 1] = [9];
    f.push(row_of(e0));
    f.push(row_of(e0));
    f.push(row_of(sev));
    f.push(row_of(e0));
    f.push(row_of(e0));
    f.push(row_of(nin));
    f.push(row_of(e0));
    let mut v6 = v_new(f);
    println(drain(mut v6));

    let mut g: Vec[Vec[i64]] = Vec.new();
    let g1: Array[i64, 3] = [1, 2, 3];
    g.push(row_of(g1));
    let mut v7 = v_new(g);
    println(drain(mut v7));
}
