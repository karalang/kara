// LeetCode 283 — the same algorithm, arranged to skip needless writes.
//
// The ★ version stores at every position: `n` writes regardless of input. This
// one swaps instead, and only when the cursor has actually fallen behind:
//
//     if a[i] != 0 and i != write:  swap a[i], a[write]
//     write += 1
//
// When no zero has been seen yet, `write == i` and there is nothing to do — an
// array with no zeros costs ZERO writes, against the ★ version's `n`.
//
// IT IS NOT UNIFORMLY BETTER, which is the interesting part and the reason both
// are here. A swap is two writes, so once the cursor falls behind, every
// remaining non-zero costs twice what a plain store would. On `[0,1,0,3,12]`
// this version does 6 writes and the ★ version does 5. The crossover is a
// property of the input — how early the first zero appears and how many
// non-zeros follow it — and the differential measures it over the whole space
// rather than arguing about it.
//
// The `i != write` guard is load-bearing for the count, not for correctness: a
// self-swap is a no-op, so dropping the guard leaves the answer right and the
// write count wrong. That is exactly the kind of bug a result-only harness
// cannot see, and kata 277 made the same point about API calls.

fn move_zeroes(a: mut ref Vec[i64], stores: mut ref i64) {
    let mut write = 0;
    let mut i = 0;
    while i < a.len() {
        if a[i] != 0 {
            if i != write {
                let t = a[write];
                a[write] = a[i];
                a[i] = t;
                stores = stores + 2;
            }
            write = write + 1;
        }
        i = i + 1;
    }
}

fn show(v: ref Vec[i64]) -> String {
    let mut s: String = "[";
    let mut i = 0;
    while i < v.len() {
        if i > 0 { s = s + ", "; }
        s = s + f"{v[i]}";
        i = i + 1;
    }
    return s + "]";
}

fn report(input: Vec[i64]) {
    let mut a = input;
    let before = show(a);
    let mut w = 0;
    move_zeroes(mut a, mut w);
    println(f"{before} -> {show(a)}  ({w} stores)");
}

fn main() {
    report([0, 1, 0, 3, 12]);
    report([0]);
    report([1, 2, 3]);
    report([0, 0, 0]);
    report([4, 0, 5, 0, 0, 6]);
    report([1]);
    report([0, 0, 1]);
}
