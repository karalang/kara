// Bench workload for LeetCode 286 — Walls and Gates.
//
// 16 INDEPENDENT BOARDS, each 512x512, each filled by multi-source BFS eight
// times over. Two design choices are load-bearing:
//
// BUILD ONCE, PUNCH MANY. Generating a board and solving it are both O(cells),
// with comparable per-cell constants, so a one-board-one-solve loop spends about
// 40% of its time in the LCG rather than in the algorithm (measured: 0.177s of
// 0.445s). Generating each board once and running the BFS on eight fresh copies
// of it drops that to under a tenth, so the number this prints is a BFS number.
//
// INDEPENDENT BOARDS ARE WHAT MAKE A PAR LANE HONEST. A single board's BFS is a
// wavefront over a shared visited mark and cannot be split without changing the
// algorithm. Sixteen boards share nothing, and each is ~4ms of work — far past
// the point where dispatch would be what is measured. That is the same test kata
// 285 failed (20ns per query, so no par lane) and katas 276 and 277 passed.
//
// SINK: the summed finite distance across every solve, plus the count of cells
// no gate reaches. Both are sums, so the sink is order-invariant and the par lane
// must print the same two numbers whatever order it finishes the boards in.
//
// The queue is a flat array with a head cursor rather than a deque, in all five
// languages, so the lanes measure the same data structure. See ../README.md
// § Benchmarks.

fn make_board(b: i64, n: i64) -> Vec[i64] {
    let mut g: Vec[i64] = [];
    let mut s = 777 + b * 1013;
    let mut i = 0;
    while i < n {
        s = (s * 1103515245 + 12345) % 2147483648;
        let roll = s % 100;
        if roll < 20 { g.push(-1); }
        else if roll < 21 { g.push(0); }
        else { g.push(2147483647); }
        i = i + 1;
    }
    return g;
}

// One multi-source BFS over a fresh copy of `template`. Returns the summed
// finite distance; reports the unreachable count through `out_unreachable`.
fn solve(template: ref Vec[i64], r: i64, c: i64, out_unreachable: mut ref i64) -> i64 {
    let inf = 2147483647;
    let n = r * c;
    let mut g = template.clone();

    // A flat queue: `q` holds cell indices, `head` is the next to pop. Every cell
    // is pushed at most once, so no wraparound is ever needed.
    let mut q: Vec[i64] = [];
    let mut k = 0;
    while k < n {
        if g[k] == 0 { q.push(k); }
        k = k + 1;
    }

    let mut head = 0;
    while head < q.len() {
        let cell = q[head];
        head = head + 1;
        let row = cell / c;
        let col = cell % c;
        let d = g[cell] + 1;

        if row > 0 {
            let nb = cell - c;
            if g[nb] == inf { g[nb] = d; q.push(nb); }
        }
        if row < r - 1 {
            let nb = cell + c;
            if g[nb] == inf { g[nb] = d; q.push(nb); }
        }
        if col > 0 {
            let nb = cell - 1;
            if g[nb] == inf { g[nb] = d; q.push(nb); }
        }
        if col < c - 1 {
            let nb = cell + 1;
            if g[nb] == inf { g[nb] = d; q.push(nb); }
        }
    }

    let mut total = 0;
    let mut unreachable = 0;
    let mut j = 0;
    while j < n {
        if g[j] == inf { unreachable = unreachable + 1; }
        else if g[j] > 0 { total = total + g[j]; }
        j = j + 1;
    }
    out_unreachable = unreachable;
    return total;
}

// What one board contributes to the sink. A struct rather than a pair of
// out-params so the par twin can collect one value per board and reduce after.
struct BoardResult {
    total: i64,
    unreachable: i64,
}

// Everything one board contributes: build it once, solve it `reps` times.
fn run_board(b: i64, r: i64, c: i64, reps: i64) -> BoardResult {
    let template = make_board(b, r * c);
    let mut total = 0;
    let mut unreachable = 0;
    let mut rep = 0;
    while rep < reps {
        let mut u = 0;
        total = total + solve(template, r, c, mut u);
        unreachable = unreachable + u;
        rep = rep + 1;
    }
    return BoardResult { total: total, unreachable: unreachable };
}

fn main() {
    let boards = 16;
    let r = 512;
    let c = 512;
    let reps = 8;

    let mut total = 0;
    let mut unreachable = 0;
    let mut b = 0;
    while b < boards {
        let part = run_board(b, r, c, reps);
        total = total + part.total;
        unreachable = unreachable + part.unreachable;
        b = b + 1;
    }

    println(f"{total} {unreachable}");
}
