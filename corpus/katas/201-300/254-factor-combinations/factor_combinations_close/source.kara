// LeetCode 254 — Factor Combinations, close-the-tail recursion.
//
// Same answers, inverted emission. The ★ file emits the two-factor split
// `path + [i, remaining/i]` at every divisor it finds. This one emits nothing at
// a divisor — it only recurses — and instead CLOSES a combination by appending
// whatever is left as the final factor once the divisor loop is exhausted.
//
// The close is guarded by `remaining >= start`, which is the non-decreasing rule
// applied to the last element: `start` equals the divisor chosen one level up,
// so a remainder smaller than it would break the ordering. The empty-path guard
// is what excludes the trivial `[n]` — at the top level there is no previous
// factor, so closing immediately would emit `n` alone.
//
// The two files generate in genuinely different orders (★ produces `[2,6]`
// before `[2,2,3]`; this one produces `[2,2,3]` first, because the recursion
// bottoms out before the close runs), which is exactly why the shared `render`
// sorts before printing. Two implementations that agree only after sorting are
// still a real cross-check — they agree on the SET, which is what the problem
// asks for.

fn helper(remaining: i64, start: i64, path: mut ref Vec[i64], out: mut ref Vec[Vec[i64]]) {
    let mut i = start;
    while i * i <= remaining {
        if remaining % i == 0 {
            path.push(i);
            helper(remaining / i, i, path, out);
            let _ = path.pop();
        }
        i = i + 1;
    }
    // Close: what is left becomes the final factor, if it does not break the
    // non-decreasing rule and there is something to append it to.
    if path.len() > 0 and remaining >= start {
        let mut combo: Vec[i64] = Vec.new();
        let mut k = 0;
        while k < path.len() {
            combo.push(path[k]);
            k = k + 1;
        }
        combo.push(remaining);
        out.push(combo);
    }
}

fn factor_combinations(n: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    if n < 4 {
        return out;
    }
    let mut path: Vec[i64] = Vec.new();
    helper(n, 2, mut path, mut out);
    return out;
}

// Render as `[[2,6],[2,2,3],[3,4]]`, canonicalised: each combination is already
// non-decreasing, and the LIST is sorted lexicographically so that all three
// solvers — which generate in genuinely different orders — print identically.
fn render(combos: mut ref Vec[Vec[i64]]) -> String {
    combos.sort_by(|a, b| {
        let mut i = 0;
        while i < a.len() and i < b.len() {
            if a[i] != b[i] {
                return a[i].cmp(b[i]);
            }
            i = i + 1;
        }
        return a.len().cmp(b.len())
    });
    let mut s: String = "[";
    let mut c = 0;
    while c < combos.len() {
        if c > 0 {
            s.push_str(",");
        }
        s.push_str("[");
        let mut k = 0;
        while k < combos[c].len() {
            if k > 0 {
                s.push_str(",");
            }
            s.push_str(f"{combos[c][k]}");
            k = k + 1;
        }
        s.push_str("]");
        c = c + 1;
    }
    s.push_str("]");
    return s;
}

fn report(n: i64) {
    let mut got = factor_combinations(n);
    println(f"{n} -> {render(mut got)}");
}

fn main() {
    report(1);   // []
    report(2);   // []  prime
    report(12);  // [[2,2,3],[2,6],[3,4]]
    report(32);  // powers of two, the deepest small case
    report(37);  // []  prime
    report(1);   // []
    report(16);
    report(24);
    report(36);
    report(100);
    report(96);
}
