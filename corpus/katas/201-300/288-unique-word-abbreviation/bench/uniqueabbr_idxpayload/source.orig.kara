// THE CONTROL THAT ANSWERED B-2026-08-28-76 — `uniqueabbr_noalloc.kara` with
// exactly one change: `Bucket.Sole` carries an i64 index into `dict` instead of
// an owned String, so the value `idx.get(a)` returns has nothing to drop.
//
// That one change takes the punch loop from two malloc/free callsites to zero.
// The no-alloc file removes the three allocations that are VISIBLE in the source
// — `chars().collect()`, the f-string, `abbrev`'s return — and leaves a fourth
// that is not: codegen heap-boxes the 32-byte `Bucket` that `_karac_map_get` has
// already written to a stack out-slot, and frees it, on every hit, even though
// the match only reads it. That is B-2026-09-12-28.
//
// MEASURED on an M5 Pro, 10M punches (10x this file's, to get the region past
// fan-out cost), dual binaries because KARAC_AUTO_PAR is a BUILD-time switch,
// hyperfine 7 runs. Same sink in every lane:
//
//     lane                     seq       par    speedup   user CPU par/seq  vs C
//     Sole(String)          319.29    54.81      5.83x        2.37x         0.56
//     Sole(i64), this file  193.30    19.96      9.68x        1.32x         0.93
//     C mirror              150.32    14.37     10.46x        1.34x          --
//
// So one allocation per lookup is the difference between 56% and 93% of a hand
// written C pthreads mirror's speedup, and the parallel run's CPU amplification
// does not shrink but disappears — 1.32x against C's 1.34x.
//
// THIS IS A CONTROL, NOT A PROPOSED REWRITE. It isolates what the box costs. The
// idiomatic spelling is the one in `uniqueabbr_noalloc.kara`, and the fix
// belongs in the compiler, not in the kata.

enum Bucket {
    Sole(i64),
    Conflicted,
}

fn abbrev(w: ref String) -> String {
    let cs: Vec[char] = w.chars().collect();
    let n = cs.len();
    if n <= 2 {
        return w.clone();
    }
    let mut out = String.new();
    out.push(cs[0]);
    out.push_str(f"{n - 2}");
    out.push(cs[n - 1]);
    return out;
}

// The corpus's 31-bit LCG, mirrored bit-for-bit in the C/Rust/Go/Python twins.
// The mask keeps it in range: Kara traps integer overflow by default.
fn next_rand(state: i64) -> i64 {
    return (state * 1103515245 + 12345) & 2147483647;
}

fn main() {
    let letters: Vec[char] = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j',
                              'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't',
                              'u', 'v', 'w', 'x', 'y', 'z'];
    let dict_n = 3000;
    let pool_n = 20000;
    let punches = 1000000;

    let mut seed = 12345;

    // --- dictionary -----------------------------------------------------
    let mut dict: Vec[String] = Vec.new();
    let mut i = 0;
    while i < dict_n {
        seed = next_rand(seed);
        let n = 3 + ((seed / 65536) % 8);
        let mut w = String.new();
        let mut j = 0;
        while j < n {
            seed = next_rand(seed);
            w.push(letters[(seed / 65536) % 26]);
            j = j + 1;
        }
        dict.push(w);
        i = i + 1;
    }

    // --- index (built once) ---------------------------------------------
    let mut idx: Map[String, Bucket] = Map.new();
    i = 0;
    while i < dict_n {
        let w = ref dict[i];
        let a = abbrev(w);
        match idx.get(a) {
            None => {
                let _ = idx.insert(a, Bucket.Sole(i));
            }
            Some(Bucket.Sole(pi)) => {
                if dict[pi] != w {
                    let _ = idx.insert(a, Bucket.Conflicted);
                }
            }
            Some(Bucket.Conflicted) => {}
        }
        i = i + 1;
    }

    // --- query pool: half from the dictionary, half fresh ----------------
    let mut pool: Vec[String] = Vec.new();
    i = 0;
    while i < pool_n {
        if (i % 2) == 0 {
            pool.push(dict[(i * 7) % dict_n]);
        } else {
            seed = next_rand(seed);
            let n = 3 + ((seed / 65536) % 8);
            let mut w = String.new();
            let mut j = 0;
            while j < n {
                seed = next_rand(seed);
                w.push(letters[(seed / 65536) % 26]);
                j = j + 1;
            }
            pool.push(w);
        }
        i = i + 1;
    }

    // --- precompute the abbreviations, OUTSIDE the measured loop --------
    // The control for B-2026-08-28-76: C's mirror formats into a stack buffer
    // and allocates nothing per punch, while this kata's `abbrev` builds a
    // Vec[char], an f-string and a String. Hoisting it leaves the punch loop
    // doing the lookup and nothing else, which is the C shape.
    let mut abbrs: Vec[String] = Vec.new();
    i = 0;
    while i < pool_n {
        abbrs.push(abbrev(pool[i]));
        i = i + 1;
    }

    // --- punch ----------------------------------------------------------
    let mut unique_count = 0;
    i = 0;
    while i < punches {
        let word = ref pool[i % pool_n];
        let a = ref abbrs[i % pool_n];
        let u = match idx.get(a) {
            None => true,
            Some(Bucket.Sole(wi)) => dict[wi] == word,
            Some(Bucket.Conflicted) => false,
        };
        if u {
            unique_count = unique_count + 1;
        }
        i = i + 1;
    }

    println(f"unique {unique_count}");
}
