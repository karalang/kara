// LeetCode 269 — Alien Dictionary, by exhaustion.
//
// Collect the constraints, then try every arrangement of the present letters in
// lexicographic order and return the first that satisfies all of them. Since the
// arrangements are visited in order, the first valid one IS the lexicographically
// least valid order — which is what the ★ file claims to produce, so the two must
// agree exactly rather than merely both be valid.
//
// No topological argument appears anywhere in this file. It does not peel a
// frontier, it does not reverse a finish order, and it has no notion of a cycle:
// an unsatisfiable constraint set simply exhausts the permutations and returns
// "". That is why it can adjudicate. A cycle bug in Kahn's and a state-collapse
// bug in the DFS both produce a confidently wrong non-empty string, and neither
// can detect the other's; a checker that only ever tests "does this arrangement
// satisfy these pairs" is immune to both.
//
// The cost is k! in the number of distinct letters, so this is a reference for
// small alphabets — the differential caps it and says where it stopped.

fn next_perm(a: mut ref Vec[i64]) -> bool {
    let n = a.len();
    if n < 2 { return false; }
    let mut i = n - 2;
    while i >= 0 and a[i] >= a[i + 1] { i = i - 1; }
    if i < 0 { return false; }
    let mut j = n - 1;
    while a[j] <= a[i] { j = j - 1; }
    let t = a[i]; a[i] = a[j]; a[j] = t;
    let mut lo = i + 1;
    let mut hi = n - 1;
    while lo < hi {
        let u = a[lo]; a[lo] = a[hi]; a[hi] = u;
        lo = lo + 1;
        hi = hi - 1;
    }
    return true;
}

fn alien_order(words: ref Vec[String]) -> String {
    let mut present: Vec[bool] = Vec.new();
    let mut i = 0;
    while i < 26 { present.push(false); i = i + 1; }
    let mut w = 0;
    while w < words.len() {
        for b in words[w].bytes() { present[b as i64 - 97] = true; }
        w = w + 1;
    }

    // Constraints as a flat list of (before, after) pairs.
    let mut lo_c: Vec[i64] = Vec.new();
    let mut hi_c: Vec[i64] = Vec.new();
    let mut p = 0;
    while p + 1 < words.len() {
        let mut a: Vec[i64] = Vec.new();
        for b in words[p].bytes() { a.push(b as i64 - 97); }
        let mut c: Vec[i64] = Vec.new();
        for b in words[p + 1].bytes() { c.push(b as i64 - 97); }
        let mut k = 0;
        let mut found = false;
        let mut lim = a.len();
        if c.len() < lim { lim = c.len(); }
        while k < lim {
            if a[k] != c[k] {
                lo_c.push(a[k]);
                hi_c.push(c[k]);
                found = true;
                k = lim;
            } else {
                k = k + 1;
            }
        }
        if not found and a.len() > c.len() {
            return "";
        }
        p = p + 1;
    }

    let mut letters: Vec[i64] = Vec.new();
    let mut s = 0;
    while s < 26 {
        if present[s] { letters.push(s); }
        s = s + 1;
    }
    if letters.len() == 0 { return ""; }

    // `letters` is already ascending, so permutations arrive in lex order and
    // the first satisfying arrangement is the least one.
    while true {
        // position[letter] for this arrangement
        let mut pos: Vec[i64] = Vec.new();
        let mut z = 0;
        while z < 26 { pos.push(-1); z = z + 1; }
        let mut q = 0;
        while q < letters.len() {
            pos[letters[q]] = q;
            q = q + 1;
        }
        let mut good = true;
        let mut e = 0;
        while e < lo_c.len() {
            if pos[lo_c[e]] >= pos[hi_c[e]] { good = false; e = lo_c.len(); }
            else { e = e + 1; }
        }
        if good {
            let mut out = "";
            let mut r = 0;
            while r < letters.len() {
                out = out + f"{(letters[r] + 97) as u8 as char}";
                r = r + 1;
            }
            return out;
        }
        if not next_perm(mut letters) { break; }
    }
    return "";
}

fn report(label: ref String, words: ref Vec[String]) {
    let r = alien_order(words);
    println(f"{label} -> \"{r}\"");
}

fn main() {
    let mut a: Vec[String] = Vec.new();
    a.push("wrt"); a.push("wrf"); a.push("er"); a.push("ett"); a.push("rftt");
    report("[wrt,wrf,er,ett,rftt]", a);
    let mut b: Vec[String] = Vec.new();
    b.push("z"); b.push("x");
    report("[z,x]", b);
    let mut c: Vec[String] = Vec.new();
    c.push("abc"); c.push("ab");
    report("[abc,ab]", c);
    let mut d: Vec[String] = Vec.new();
    d.push("ab"); d.push("abc");
    report("[ab,abc]", d);
    let mut e: Vec[String] = Vec.new();
    e.push("z"); e.push("x"); e.push("z");
    report("[z,x,z]", e);
    let mut f: Vec[String] = Vec.new();
    f.push("ab"); f.push("adc");
    report("[ab,adc]", f);
    let mut g: Vec[String] = Vec.new();
    g.push("zy"); g.push("zx");
    report("[zy,zx]", g);
    let mut h: Vec[String] = Vec.new();
    h.push("aaa");
    report("[aaa]", h);
    let mut i: Vec[String] = Vec.new();
    report("[]", i);
}
