// Benchmark workload for LeetCode #261 — Graph Valid Tree.
//
// Build-once + punch. One random tree on 100,000 nodes is generated once by
// parent attachment, its edge list is shuffled, and the ★ union-find validator
// is then run over it 240 times.
//
// The graph is a GENUINE TREE, so every one of the n-1 edges is processed —
// there is no cycle to trigger the early `return false`, and the lane measures
// the full merge, not a lucky exit on edge three.
//
// The edges are SHUFFLED because parent attachment emits them in topological
// order, and fed in that order every union hangs a singleton off a growing root:
// the find is one hop, path compression has nothing to compress, and the
// measurement collapses to a linear scan. Shuffled, the forest genuinely grows
// from the middle out and the finds walk real chains.
//
// Each round starts the scan at a different offset into the edge list (wrapping
// round), so no round is a repeat of the last and nothing is loop-invariant. The
// work per round is identical; only the order differs.
//
// This is the corpus's RANDOM DEPENDENT LOAD lane. The inner cost is chasing
// parent[parent[parent[...]]] through an 800 KB array in an order the prefetcher
// cannot predict, which is a different bottleneck from the sort-dominated
// (#252, #253), allocation (#254), string-building (#257), integer-division
// (#258) and branch-prediction (#259) lanes.
//
// n IS SET BY MEASUREMENT, not by taste. At n = 400,000 (a ~13 MB working set)
// this workload is unrankable on the x86 container: repeated runs of a single
// unchanged binary scattered over 368-1126 ms, sigma 22.8%, with system time
// rising from 0.4 ms to 31 ms. Same total work at n = 100,000 lands at sigma
// 2.0%, and at n = 30,000 at 1.3%. n = 100,000 is the largest size that is
// still measurable here, and it keeps the chase a real L2-miss chain (800 KB of
// parent[] alone) rather than an L1-resident one. See ../README.md for the
// full sigma-versus-n table.
//
// The sink folds the post-round parent[] array, which pins the exact
// union-by-size tie-breaking and path-compression behaviour — a mirror that
// deviates from the algorithm cannot match it by accident.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut r = x;
    while parent[r] != r {
        r = parent[r];
    }
    let mut c = x;
    while parent[c] != r {
        let nxt = parent[c];
        parent[c] = r;
        c = nxt;
    }
    return r;
}

fn main() {
    let n = 100000;
    let rounds = 240;
    let m = n - 1;

    // ---- build once ------------------------------------------------------
    let mut eu: Vec[i64] = Vec.new();
    let mut ev: Vec[i64] = Vec.new();
    let mut state = 261261;
    let mut i = 1;
    while i < n {
        state = (state * 1103515245 + 12345) & 2147483647;
        let wd1 = state / 65536;
        state = (state * 1103515245 + 12345) & 2147483647;
        eu.push((wd1 * 32768 + state / 65536) % i);
        ev.push(i);
        i = i + 1;
    }
    // Fisher-Yates over the edge list.
    let mut sh = m - 1;
    while sh > 0 {
        state = (state * 1103515245 + 12345) & 2147483647;
        let wd0 = state / 65536;
        state = (state * 1103515245 + 12345) & 2147483647;
        let j = (wd0 * 32768 + state / 65536) % (sh + 1);
        let tu = eu[sh]; eu[sh] = eu[j]; eu[j] = tu;
        let tv = ev[sh]; ev[sh] = ev[j]; ev[j] = tv;
        sh = sh - 1;
    }

    // ---- punch -----------------------------------------------------------
    let mut parent: Vec[i64] = Vec.new();
    let mut size: Vec[i64] = Vec.new();
    let mut z = 0;
    while z < n {
        parent.push(0);
        size.push(0);
        z = z + 1;
    }

    let mut sink = 0;
    let mut r = 0;
    while r < rounds {
        let mut k = 0;
        while k < n {
            parent[k] = k;
            size[k] = 1;
            k = k + 1;
        }

        let start = (r * 7919) % m;
        let mut components = n;
        let mut cyclic = false;
        let mut e = 0;
        while e < m {
            let idx = (start + e) % m;
            let ra = find(mut parent, eu[idx]);
            let rb = find(mut parent, ev[idx]);
            if ra == rb {
                cyclic = true;
                e = m;
            } else {
                if size[ra] < size[rb] {
                    parent[ra] = rb;
                    size[rb] = size[rb] + size[ra];
                } else {
                    parent[rb] = ra;
                    size[ra] = size[ra] + size[rb];
                }
                components = components - 1;
                e = e + 1;
            }
        }

        // Fold the resulting forest state, not just the verdict.
        let mut acc = 0;
        let mut p = 0;
        while p < n {
            acc = (acc * 31 + parent[p]) % 1000000007;
            p = p + 1;
        }
        let mut verdict = 0;
        if components == 1 and not cyclic { verdict = 1; }
        sink = (sink * 131 + acc + verdict) % 1000000007;
        r = r + 1;
    }

    println(sink);
}
