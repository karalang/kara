// LeetCode 252 — Meeting Rooms, sweep line.
//
// Forget that starts and ends are paired. Sort the two coordinate lists
// SEPARATELY, then sweep: walk the starts in order, releasing every meeting
// whose end has already passed, and count how many are concurrently active. The
// answer is "attendable" iff that count never reaches 2.
//
// Decoupling the pair is the whole idea, and it is the standard preparation for
// the follow-up problem (#253 asks for the MINIMUM number of rooms, which is
// exactly the maximum this counter reaches). This file computes the same
// quantity and merely stops early once it exceeds 1.
//
// The release test is `ends[j] <= starts[i]`, with the `<=` doing the same work
// the ★ file's strict `<` does: a meeting ending exactly when the next begins is
// released BEFORE the next is counted, so touching intervals never coexist.
//
// Two separate `Vec[i64]` sorts is a different compiler surface from the ★
// file's single sort of `(i64, i64)` tuples by a key.

fn can_attend_all(intervals: Slice[(i64, i64)]) -> bool {
    let n = intervals.len();
    if n <= 1 {
        return true;
    }
    let mut starts: Vec[i64] = Vec.new();
    let mut ends: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        starts.push(intervals[i].0);
        ends.push(intervals[i].1);
        i = i + 1;
    }
    starts.sort();
    ends.sort();

    let mut j = 0;
    let mut active = 0;
    let mut k = 0;
    while k < n {
        // Release everything that has already finished by this start. `<=`,
        // so a meeting ending exactly now frees its slot in time.
        while j < n and ends[j] <= starts[k] {
            active = active - 1;
            j = j + 1;
        }
        active = active + 1;
        if active > 1 {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn report(intervals: Slice[(i64, i64)], label: ref String) {
    if can_attend_all(intervals) {
        println(f"{label} -> true");
    } else {
        println(f"{label} -> false");
    }
}

fn main() {
    let a: Array[(i64, i64), 3] = [(0, 30), (5, 10), (15, 20)];
    report(a, "[[0,30],[5,10],[15,20]]");
    let b: Array[(i64, i64), 2] = [(7, 10), (2, 4)];
    report(b, "[[7,10],[2,4]]");
    let c: Array[(i64, i64), 0] = [];
    report(c, "[]");
    let d: Array[(i64, i64), 1] = [(1, 5)];
    report(d, "[[1,5]]");
    let e: Array[(i64, i64), 2] = [(1, 5), (5, 10)];
    report(e, "[[1,5],[5,10]]");
    let f: Array[(i64, i64), 2] = [(1, 10), (2, 3)];
    report(f, "[[1,10],[2,3]]");
    let g: Array[(i64, i64), 2] = [(5, 10), (1, 5)];
    report(g, "[[5,10],[1,5]]");
    let h: Array[(i64, i64), 4] = [(1, 3), (3, 5), (5, 7), (7, 9)];
    report(h, "[[1,3],[3,5],[5,7],[7,9]]");
    // [[1,2],[1,2]] -> false — identical meetings clash with each other
    let i: Array[(i64, i64), 2] = [(1, 2), (1, 2)];
    report(i, "[[1,2],[1,2]]");
    let j: Array[(i64, i64), 3] = [(1, 4), (2, 5), (3, 6)];
    report(j, "[[1,4],[2,5],[3,6]]");
}
