// LeetCode 280 — the definition, asked directly.
//
// Enumerate permutations of the input in lexicographic order and return the
// first that wiggles. O(n!·n) — hopeless past eight elements, which is why the
// differential draws its arrays short.
//
// IT IS THE ONLY SOLVER THAT NEVER CONSTRUCTS AN ARRANGEMENT. It TESTS
// arrangements against the property, so it cannot inherit a misreading of the
// property from the way it builds one. Both other solvers reorder by a rule —
// the greedy's local swap, the sorted version's pairing — and a rule that is
// subtly wrong about which index must be the peak produces a consistent,
// confident, wrong answer in both.
//
// AND IT RETURNS THE LEXICOGRAPHICALLY SMALLEST valid arrangement, which buys
// the harness a check that survives non-uniqueness: whatever the other two
// produce must be a valid arrangement that is lex-GREATER THAN OR EQUAL to this
// one. That is sharper than "both are valid" — it is a bound every correct
// solver must respect, and a solver that emitted some other multiset entirely
// would violate it immediately.

fn wiggles(v: ref Vec[i64]) -> bool {
    let mut i = 1;
    while i < v.len() {
        if i % 2 == 1 {
            if v[i] < v[i - 1] { return false; }
        } else {
            if v[i] > v[i - 1] { return false; }
        }
        i = i + 1;
    }
    return true;
}

fn wiggle_sort(nums: mut ref Vec[i64]) {
    // sort first so the permutation walk starts at the lex-smallest ordering
    let mut a = 1;
    while a < nums.len() {
        let mut b = a;
        while b > 0 and nums[b - 1] > nums[b] {
            let t = nums[b - 1];
            nums[b - 1] = nums[b];
            nums[b] = t;
            b = b - 1;
        }
        a = a + 1;
    }
    let mut more = true;
    while more {
        if wiggles(nums) { return; }
        // next permutation, in place
        let mut p = nums.len() - 2;
        while p >= 0 and nums[p] >= nums[p + 1] { p = p - 1; }
        if p < 0 {
            more = false;
        } else {
            let mut s = nums.len() - 1;
            while nums[s] <= nums[p] { s = s - 1; }
            let t = nums[p];
            nums[p] = nums[s];
            nums[s] = t;
            let mut lo = p + 1;
            let mut hi = nums.len() - 1;
            while lo < hi {
                let t2 = nums[lo];
                nums[lo] = nums[hi];
                nums[hi] = t2;
                lo = lo + 1;
                hi = hi - 1;
            }
        }
    }
}

fn show(v: ref Vec[i64]) -> String {
    let mut s: String = "[";
    let mut i = 0;
    while i < v.len() {
        if i > 0 { s = s + ", "; }
        s = s + f"{v[i]}";
        i = i + 1;
    }
    return s + "]";
}

fn main() {
    let cases: Vec[Vec[i64]] = [
        [3, 5, 2, 1, 6, 4],
        [1, 2, 3],
        [6, 6, 5, 6, 3, 8],
        [1],
        [2, 1],
        [1, 1, 1, 1],
        [5, 4, 3, 2, 1],
    ];
    let mut c = 0;
    while c < cases.len() {
        let mut v = cases[c].clone();
        let before = show(v);
        wiggle_sort(mut v);
        println(f"{before} -> {show(v)}");
        c = c + 1;
    }
}
