// LeetCode 280 — Wiggle Sort.
//
// Reorder the array so that `nums[0] <= nums[1] >= nums[2] <= nums[3] >= ...`.
// Any valid arrangement is accepted, and one always exists — the comparisons are
// non-strict, so even an array of all-equal elements already wiggles.
//
// THE ★ MECHANISM: ONE PASS, FIXING EACH POSITION LOCALLY.
//
//     for i in 1..n:
//         if i is odd  and nums[i] <  nums[i-1]:  swap
//         if i is even and nums[i] >  nums[i-1]:  swap
//
// O(n), one pass, no sorting. Each step looks only at `i` and `i-1`.
//
// WHY A LOCAL FIX CANNOT BREAK THE CONSTRAINT BEHIND IT — the part that makes
// this more than a plausible-looking trick. Say `i` is odd and we swap because
// `nums[i] < nums[i-1]`. The worry is that moving the larger value into
// position `i-1` violates the already-satisfied `nums[i-2] >= nums[i-1]`. It
// cannot: at that point `nums[i-2] >= nums[i-1]` held, and the value arriving at
// `i-1` is the OLD `nums[i]`, which was strictly smaller than the old
// `nums[i-1]`, hence smaller than `nums[i-2]` too. The constraint behind gets
// *more* satisfied, never less. The even case is the mirror image.
//
// That argument is why the greedy needs no lookahead and no second pass, and it
// is exactly what a solver that "looks right" tends to get wrong — the usual bug
// is fixing position `i` by swapping with `i+1`, which does break the pair
// behind it.
//
// THE ANSWER IS NOT UNIQUE. `[1,2,3]` admits `[1,3,2]` and `[2,3,1]`, and the
// problem takes either. So the differential cannot compare solver output as
// strings; it VALIDATES instead — see differential.kara, where validity is two
// conditions and the second is the one people forget.

fn wiggle_sort(nums: mut ref Vec[i64]) {
    let mut i = 1;
    while i < nums.len() {
        let odd = i % 2 == 1;
        if odd {
            if nums[i] < nums[i - 1] {
                let t = nums[i];
                nums[i] = nums[i - 1];
                nums[i - 1] = t;
            }
        } else {
            if nums[i] > nums[i - 1] {
                let t = nums[i];
                nums[i] = nums[i - 1];
                nums[i - 1] = t;
            }
        }
        i = i + 1;
    }
}

fn show(v: ref Vec[i64]) -> String {
    let mut s: String = "[";
    let mut i = 0;
    while i < v.len() {
        if i > 0 { s = s + ", "; }
        s = s + f"{v[i]}";
        i = i + 1;
    }
    return s + "]";
}

fn main() {
    let cases: Vec[Vec[i64]] = [
        [3, 5, 2, 1, 6, 4],
        [1, 2, 3],
        [6, 6, 5, 6, 3, 8],
        [1],
        [2, 1],
        [1, 1, 1, 1],
        [5, 4, 3, 2, 1],
    ];
    let mut c = 0;
    while c < cases.len() {
        let mut v = cases[c].clone();
        let before = show(v);
        wiggle_sort(mut v);
        println(f"{before} -> {show(v)}");
        c = c + 1;
    }
}
