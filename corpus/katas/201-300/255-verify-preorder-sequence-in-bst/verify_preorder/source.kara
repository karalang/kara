// LeetCode 255 — Verify Preorder Sequence in Binary Search Tree. (Premium.)
//
// Given a sequence of distinct integers, could it be the preorder traversal of
// some BST? No tree is ever built — the question is answerable from the sequence
// alone.
//
// The insight is about what a preorder traversal commits you to. Reading left to
// right you descend leftwards while values keep shrinking; the moment a value
// RISES above something already seen, you have stepped into that node's right
// subtree — and from then on every remaining value must exceed it, forever.
// Stepping right is irreversible.
//
// So carry a running LOWER BOUND and a stack of ancestors whose right subtree
// has not yet been entered:
//
//   * a value below the bound is impossible — reject;
//   * a value above the stack top means we just moved into that node's right
//     subtree, so pop it and raise the bound to it (repeatedly — one value can
//     close several levels at once);
//   * then push the value as the newest ancestor.
//
// O(n) time, O(n) stack. Each element is pushed once and popped at most once.
//
// The bound only ever RISES, which is the whole proof: once raised past a value,
// nothing smaller can legally appear again.

fn verify_preorder(preorder: Slice[i64]) -> bool {
    let mut stack: Vec[i64] = Vec.new();
    let mut lower = -9223372036854775807 - 1; // i64.MIN, no ancestor yet
    let mut i = 0;
    while i < preorder.len() {
        let x = preorder[i];
        if x < lower {
            return false; // below a bound we already committed to
        }
        // Rising above an ancestor means entering its right subtree.
        while stack.len() > 0 and stack[stack.len() - 1] < x {
            lower = match stack.pop() {
                Some(v) => v,
                None => lower,
            };
        }
        stack.push(x);
        i = i + 1;
    }
    return true;
}

fn report(preorder: Slice[i64], label: ref String) {
    println(f"{label} -> {verify_preorder(preorder)}");
}

fn main() {
    // [5,2,1,3,6] -> true   (the LeetCode example)
    let a: Array[i64, 5] = [5, 2, 1, 3, 6];
    report(a, "[5,2,1,3,6]");

    // [5,2,6,1,3] -> false  — 1 appears after we entered 5's right subtree
    let b: Array[i64, 5] = [5, 2, 6, 1, 3];
    report(b, "[5,2,6,1,3]");

    // [] -> true
    let c: Array[i64, 0] = [];
    report(c, "[]");

    // [1] -> true
    let d: Array[i64, 1] = [1];
    report(d, "[1]");

    // [1,2] -> true   (a right spine)
    let e: Array[i64, 2] = [1, 2];
    report(e, "[1,2]");

    // [2,1] -> true   (a left spine)
    let f: Array[i64, 2] = [2, 1];
    report(f, "[2,1]");

    // [2,3,1] -> false — 1 is below 2 after entering 2's right subtree
    let g: Array[i64, 3] = [2, 3, 1];
    report(g, "[2,3,1]");

    // [1,3,2] -> true  — 3 is 1's right child, 2 is 3's left child
    let h: Array[i64, 3] = [1, 3, 2];
    report(h, "[1,3,2]");

    // strictly increasing -> true (a pure right spine)
    let i: Array[i64, 5] = [1, 2, 3, 4, 5];
    report(i, "[1,2,3,4,5]");

    // strictly decreasing -> true (a pure left spine)
    let j: Array[i64, 5] = [5, 4, 3, 2, 1];
    report(j, "[5,4,3,2,1]");

    // [10,5,1,7,40,50] -> true
    let k: Array[i64, 6] = [10, 5, 1, 7, 40, 50];
    report(k, "[10,5,1,7,40,50]");

    // [10,5,1,7,40,50,30] -> false — 30 is below 40 after stepping right
    let l: Array[i64, 7] = [10, 5, 1, 7, 40, 50, 30];
    report(l, "[10,5,1,7,40,50,30]");

    // i64.MIN present — the sentinel must not be confusable with real data
    let m: Array[i64, 2] = [-9223372036854775808, 5];
    report(m, "[i64.MIN,5]");
}
