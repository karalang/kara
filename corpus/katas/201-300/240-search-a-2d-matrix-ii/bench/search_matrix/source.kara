// Benchmark harness for LeetCode #240 — Search a 2D Matrix II.
//
// Build-once + punch (BENCHMARKS.md): a 1000x1000 doubly-sorted matrix is built
// once as a flat row-major Vec, then each punch is one staircase query.
//
// A single query is only O(m + n) — 2000 steps — so the punch count is high
// (120 000) rather than the matrix being enormous. That keeps the working set
// at 8 MB, comfortably larger than L2, so the walk pays real cache misses as it
// strides down columns.
//
// Targets are drawn to straddle the value range: roughly half hit and half
// miss. A hit exits early at a random depth; a miss always runs the full
// m + n staircase. Benching only hits or only misses would measure one branch
// of the loop.

fn search_matrix(flat: ref Vec[i64], rows: i64, cols: i64, target: i64) -> bool {
    if rows == 0 or cols == 0 {
        return false;
    }
    let mut r = 0;
    let mut c = cols - 1;
    while r < rows and c >= 0 {
        let v = flat[r * cols + c];
        if v == target {
            return true;
        } else if v > target {
            c = c - 1;
        } else {
            r = r + 1;
        }
    }
    return false;
}

fn main() {
    let rows = 1000;
    let cols = 1000;
    let iters = 120000;

    // value = r*3 + c*5 ascends along both axes, which is exactly the
    // precondition the staircase walk relies on.
    let mut flat: Vec[i64] = Vec.new();
    let mut r = 0;
    while r < rows {
        let mut c = 0;
        while c < cols {
            flat.push(r * 3 + c * 5);
            c = c + 1;
        }
        r = r + 1;
    }
    let maxv = (rows - 1) * 3 + (cols - 1) * 5;

    let mut sink = 0;
    let mut x = 12345;
    let mut it = 0;
    while it < iters {
        x = (x * 1103515245 + 12345) % 2147483648;
        // Bit 16 upward, not the low bits — a power-of-two-modulus LCG has
        // very short periods in its low-order bits.
        let target = (x / 65536) % (maxv + 2);
        if search_matrix(flat, rows, cols, target) {
            sink = (sink + it + 1) % 1000000007;
        }
        it = it + 1;
    }
    println(f"{sink}");
}
