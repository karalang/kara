// LeetCode #2018: Check if Word Can Be Placed In Crossword -- each line read
// once by a `fold`, a wall chained on at its end. The state is the length of
// the run so far and whether it still matches the word forwards and
// backwards: the `i`th cell of a run that is to hold the word reversed must
// take the word's letter `k - 1 - i`. A wall closes the run, which fits when
// its length is the word's and one of the two still holds. O(m n).

struct Run {
    len: i64,
    forward: bool,
    backward: bool,
    found: bool,
}

fn fits_a_line(line: Vec[char], word: Vec[char]) -> bool {
    let k = word.len();
    let start = Run { len: 0, forward: true, backward: true, found: false };
    let end = line.iter().cloned().chain(['#'].into_iter()).fold(start, |run, cell| {
        if cell == '#' {
            let found = run.found or (run.len == k and (run.forward or run.backward));
            Run { len: 0, forward: true, backward: true, found: found }
        } else if run.len >= k {
            Run { len: run.len + 1, forward: false, backward: false, found: run.found }
        } else {
            let i = run.len;
            Run {
                len: i + 1,
                forward: run.forward and (cell == ' ' or cell == word[i]),
                backward: run.backward and (cell == ' ' or cell == word[k - 1 - i]),
                found: run.found,
            }
        }
    });
    end.found
}

fn place_word_in_crossword(board: Vec[Vec[char]], word: String) -> bool {
    let word: Vec[char] = word.chars().collect();
    let (m, n) = (board.len(), board[0].len());
    board.iter().any(|row| fits_a_line(row.clone(), word))
        or (0..n).any(|c| fits_a_line((0..m).map(|r| board[r][c]).collect(), word))
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn board_of(rows: Vec[String]) -> Vec[Vec[char]] {
    rows.iter().map(|row| row.chars().collect()).collect()
}

// an `m` by `n` board: each cell a wall with odds `walls` in 10, else a
// letter from the first `letters` with odds `filled` in 10, else empty
fn random_board(m: i64, n: i64, walls: i64, filled: i64, letters: i64, seed: mut ref i64) -> Vec[Vec[char]] {
    let mut board: Vec[Vec[char]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[char] = Vec.new();
        for _ in 0..n {
            if next_random(mut seed) % 10 < walls {
                row.push('#');
            } else if next_random(mut seed) % 10 < filled {
                row.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
            } else {
                row.push(' ');
            }
        }
        board.push(row);
    }
    board
}

fn random_word(length: i64, letters: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..length {
        word.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
    }
    word
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[String], String)] = [
        (["# #", "  #", "#c "], "abc"),
        ([" #a", " #c", " #a"], "ac"),
        (["# #", "  #", "# c"], "ca"),
        (["a"], "a"),
        ([" "], "ab"),
        (["#  #"], "ab"),
        (["  ", "  "], "ab"),
        (["#b#", "#a#", "# #"], "abc"),
        (["#####", "#   #", "#####"], "xyz"),
    ];
    for (rows, word) in examples {
        let board = board_of(rows.clone());
        println(f"{rows}, \"{word}\" -> {place_word_in_crossword(board, word)}");
    }
    let mut seed = 2018;
    let mut placed = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let m = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 6 + 1;
        let walls = next_random(mut seed) % 5;
        let filled = next_random(mut seed) % 6;
        let letters = next_random(mut seed) % 3 + 1;
        let length = next_random(mut seed) % 5 + 1;
        let board = random_board(m, n, walls, filled, letters, mut seed);
        let word = random_word(length, letters, mut seed);
        let answer = place_word_in_crossword(board, word);
        if answer {
            placed += 1;
        }
        check = (check * 2 + if answer { 1 } else { 0 }) % 1000000007;
    }
    println(f"3000 boards of up to 6 by 6: {placed} placed, checksum {check}");
    placed = 0;
    check = 0;
    for a in 0..6 {
        let m = [300, 1, 400, 30, 600, 2][a];
        let n = [300, 1000, 250, 3000, 150, 500][a];
        let walls = [2, 3, 1, 4, 2, 0][a];
        let length = [3, 5, 8, 2, 4, 500][a];
        let board = random_board(m, n, walls, 1, 2, mut seed);
        let word = random_word(length, 2, mut seed);
        let answer = place_word_in_crossword(board, word);
        if answer {
            placed += 1;
        }
        check = (check * 2 + if answer { 1 } else { 0 }) % 1000000007;
    }
    println(f"6 boards of up to 100000 cells: {placed} placed, checksum {check}");
}
