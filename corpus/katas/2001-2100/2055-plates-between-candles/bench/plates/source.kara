// LeetCode #2055: Plates Between Candles -- the ★ arm as a benchmark. 50
// strings of 100000 places, the constraints' limit, with candles from every
// place to one in fifty, each asked 100000 queries: plate counts and the
// nearest candles on each side, then each query answered from them. Five
// million places and five million queries.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn plates_between_candles(s: String, queries: Vec[(i64, i64)]) -> Vec[i64] {
    let places: Vec[char] = s.chars().collect();
    let n = places.len();
    let mut plates: Vec[i64] = Vec.filled(n + 1, 0);
    let mut candle_before: Vec[i64] = Vec.filled(n, -1);
    let mut last = -1;
    for i in 0..n {
        plates[i + 1] = plates[i] + if places[i] == '*' { 1 } else { 0 };
        if places[i] == '|' {
            last = i;
        }
        candle_before[i] = last;
    }
    let mut candle_after: Vec[i64] = Vec.filled(n, n);
    let mut next = n;
    for i in (0..n).rev() {
        if places[i] == '|' {
            next = i;
        }
        candle_after[i] = next;
    }
    let mut answers: Vec[i64] = Vec.new();
    for (left, right) in queries.iter() {
        let first = candle_after[left];
        let last = candle_before[right];
        answers.push(if first < last { plates[last] - plates[first] } else { 0 });
    }
    answers
}

fn main() {
    let mut seed = 2055;
    let mut total = 0;
    let mut check = 0;
    for t in 0..50 {
        let every = t + 1;
        let mut s = String.new();
        for _ in 0..100000 {
            s.push(if next_random(mut seed) % every == 0 { '|' } else { '*' });
        }
        let mut queries: Vec[(i64, i64)] = Vec.new();
        for _ in 0..100000 {
            let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            queries.push((a.min(b), a.max(b)));
        }
        for a in plates_between_candles(s, queries).iter() {
            total += a;
            check = (check * 31 + a + 1) % 1000000007;
        }
    }
    println(f"50 strings: sum {total}, checksum {check}");
}
