// LeetCode #2019: The Score of Students Solving Math Expression -- top-down:
// the values of digits `i..=j` are found by recursion over the operator the
// last step applies, each run's values kept in a `Map` from `(i, j)` to a
// sorted list so no run is worked out twice. The right answer comes from a
// stack: a `*` folds into the top, a `+` pushes. O(n^3 * 1000^2) at worst.

fn values(i: i64, j: i64, digits: Vec[i64], ops: Vec[char], memo: mut ref Map[(i64, i64), Vec[i64]]) -> Vec[i64] {
    if let Some(found) = memo.get((i, j)) {
        return found.clone();
    }
    let mut seen: Set[i64] = Set.new();
    if i == j {
        seen.insert(digits[i]);
    }
    for k in i..j {
        let left = values(i, k, digits, ops, mut memo);
        let right = values(k + 1, j, digits, ops, mut memo);
        for a in left.iter() {
            for b in right.iter() {
                let v = if ops[k] == '+' { a + b } else { a * b };
                if v <= 1000 {
                    seen.insert(v);
                }
            }
        }
    }
    let mut found: Vec[i64] = seen.iter().collect();
    found.sort();
    memo.insert((i, j), found.clone());
    found
}

fn score_of_students(s: String, answers: Vec[i64]) -> i64 {
    let mut digits: Vec[i64] = Vec.new();
    let mut ops: Vec[char] = Vec.new();
    for c in s.chars() {
        if c == '+' or c == '*' {
            ops.push(c);
        } else {
            digits.push(c as i64 - '0' as i64);
        }
    }
    let mut stack: Vec[i64] = [digits[0]];
    for k in 0..ops.len() {
        if ops[k] == '*' {
            let top = stack.pop().unwrap();
            stack.push(top * digits[k + 1]);
        } else {
            stack.push(digits[k + 1]);
        }
    }
    let correct: i64 = stack.iter().sum();
    let mut memo: Map[(i64, i64), Vec[i64]] = Map.new();
    let possible = values(0, digits.len() - 1, digits, ops, mut memo);
    let mut points = 0;
    for answer in answers.iter() {
        if answer == correct {
            points += 5;
        } else if possible.binary_search(answer).is_ok() {
            points += 2;
        }
    }
    points
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` digits, each from `0..=top`, joined by `*` with odds `times` in 10
// and `+` otherwise
fn random_expression(count: i64, top: i64, times: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for i in 0..count {
        if i > 0 {
            s.push(if next_random(mut seed) % 10 < times { '*' } else { '+' });
        }
        s.push(('0' as i64 + next_random(mut seed) % (top + 1)) as u8 as char);
    }
    s
}

// `count` answers, each from `0..=top`
fn random_answers(count: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    (0..count).map(|_| next_random(mut seed) % (top + 1)).collect()
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(String, Vec[i64])] = [
        ("7+3*1*2", [20, 13, 42]),
        ("3+5*2", [13, 0, 10, 13, 13, 16, 16]),
        ("6+0*1", [12, 9, 6, 4, 8, 6]),
        ("1+2*3+4", [11, 13, 15, 21, 15, 0]),
        ("9", [9, 0, 1000]),
        ("9*9*9*9+1*0", [0, 1, 6561, 729, 6562]),
        ("2*3+4*5", [26, 50, 70, 46, 9]),
    ];
    for (s, answers) in examples {
        println(f"\"{s}\", {answers} -> {score_of_students(s, answers)}");
    }
    let mut seed = 2019;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1500 {
        let count = next_random(mut seed) % 6 + 1;
        let top = next_random(mut seed) % 9 + 1;
        let times = next_random(mut seed) % 11;
        let s = random_expression(count, top, times, mut seed);
        let answers = random_answers(next_random(mut seed) % 8 + 1, next_random(mut seed) % 25 + 1, mut seed);
        let points = score_of_students(s, answers);
        total += points;
        check = (check * 31 + points) % 1000000007;
    }
    println(f"1500 expressions of up to 6 digits: {total} points, checksum {check}");
    total = 0;
    check = 0;
    for a in 0..6 {
        let count = [11, 11, 10, 11, 9, 11][a];
        let top = [9, 3, 5, 2, 9, 1][a];
        let times = [5, 3, 7, 6, 4, 10][a];
        let s = random_expression(count, top, times, mut seed);
        let answers = random_answers(10000, [1000, 300, 1000, 200, 1000, 20][a], mut seed);
        let points = score_of_students(s, answers);
        total += points;
        check = (check * 31 + points) % 1000000007;
    }
    println(f"6 expressions of up to 11 digits, 10000 answers each: {total} points, checksum {check}");
}
