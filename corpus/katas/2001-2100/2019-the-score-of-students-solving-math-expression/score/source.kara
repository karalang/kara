// LeetCode #2019: The Score of Students Solving Math Expression -- the ★
// arm. The right answer is read left to right, a running product closed
// into the sum at each `+`. Every answer a wrong order can give is found by
// an interval DP: the values of a run of digits are every value of its left
// part joined by the operator between them to every value of its right
// part, each kept only while it is at most 1000, since no answer is larger
// and no value ever shrinks except through `* 0`, which the shorter splits
// reach too. O(n^3 * 1000^2) at worst, far less in practice.

fn score_of_students(s: String, answers: Vec[i64]) -> i64 {
    let chars: Vec[char] = s.chars().collect();
    let digits: Vec[i64] = chars.iter().step_by(2).map(|c| c as i64 - '0' as i64).collect();
    let ops: Vec[char] = chars.iter().skip(1).step_by(2).collect();
    let n = digits.len();
    // the right answer
    let mut sum = 0;
    let mut product = digits[0];
    for i in 0..n - 1 {
        if ops[i] == '+' {
            sum += product;
            product = digits[i + 1];
        } else {
            product *= digits[i + 1];
        }
    }
    let correct = sum + product;
    // values[i][j]: every value of digits i..=j under some order
    let mut values: Vec[Vec[Set[i64]]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[Set[i64]] = Vec.new();
        for j in 0..n {
            let mut cell: Set[i64] = Set.new();
            if i == j {
                cell.insert(digits[i]);
            }
            row.push(cell);
        }
        values.push(row);
    }
    for length in 2..n + 1 {
        for i in 0..n - length + 1 {
            let j = i + length - 1;
            let mut cell: Set[i64] = Set.new();
            for k in i..j {
                for a in values[i][k].iter() {
                    for b in values[k + 1][j].iter() {
                        let v = if ops[k] == '+' { a + b } else { a * b };
                        if v <= 1000 {
                            cell.insert(v);
                        }
                    }
                }
            }
            values[i][j] = cell;
        }
    }
    let mut points = 0;
    for answer in answers.iter() {
        if answer == correct {
            points += 5;
        } else if values[0][n - 1].contains(answer) {
            points += 2;
        }
    }
    points
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` digits, each from `0..=top`, joined by `*` with odds `times` in 10
// and `+` otherwise
fn random_expression(count: i64, top: i64, times: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for i in 0..count {
        if i > 0 {
            s.push(if next_random(mut seed) % 10 < times { '*' } else { '+' });
        }
        s.push(('0' as i64 + next_random(mut seed) % (top + 1)) as u8 as char);
    }
    s
}

// `count` answers, each from `0..=top`
fn random_answers(count: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    (0..count).map(|_| next_random(mut seed) % (top + 1)).collect()
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(String, Vec[i64])] = [
        ("7+3*1*2", [20, 13, 42]),
        ("3+5*2", [13, 0, 10, 13, 13, 16, 16]),
        ("6+0*1", [12, 9, 6, 4, 8, 6]),
        ("1+2*3+4", [11, 13, 15, 21, 15, 0]),
        ("9", [9, 0, 1000]),
        ("9*9*9*9+1*0", [0, 1, 6561, 729, 6562]),
        ("2*3+4*5", [26, 50, 70, 46, 9]),
    ];
    for (s, answers) in examples {
        println(f"\"{s}\", {answers} -> {score_of_students(s, answers)}");
    }
    let mut seed = 2019;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1500 {
        let count = next_random(mut seed) % 6 + 1;
        let top = next_random(mut seed) % 9 + 1;
        let times = next_random(mut seed) % 11;
        let s = random_expression(count, top, times, mut seed);
        let answers = random_answers(next_random(mut seed) % 8 + 1, next_random(mut seed) % 25 + 1, mut seed);
        let points = score_of_students(s, answers);
        total += points;
        check = (check * 31 + points) % 1000000007;
    }
    println(f"1500 expressions of up to 6 digits: {total} points, checksum {check}");
    total = 0;
    check = 0;
    for a in 0..6 {
        let count = [11, 11, 10, 11, 9, 11][a];
        let top = [9, 3, 5, 2, 9, 1][a];
        let times = [5, 3, 7, 6, 4, 10][a];
        let s = random_expression(count, top, times, mut seed);
        let answers = random_answers(10000, [1000, 300, 1000, 200, 1000, 20][a], mut seed);
        let points = score_of_students(s, answers);
        total += points;
        check = (check * 31 + points) % 1000000007;
    }
    println(f"6 expressions of up to 11 digits, 10000 answers each: {total} points, checksum {check}");
}
