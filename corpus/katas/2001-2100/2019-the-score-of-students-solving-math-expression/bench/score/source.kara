// LeetCode #2019: The Score of Students Solving Math Expression -- the ★
// arm's benchmark. The right answer read left to right; every value a wrong
// order can give found by an interval DP over hash sets, values above 1000
// dropped.

fn score_of_students(s: String, answers: Vec[i64]) -> i64 {
    let chars: Vec[char] = s.chars().collect();
    let digits: Vec[i64] = chars.iter().step_by(2).map(|c| c as i64 - '0' as i64).collect();
    let ops: Vec[char] = chars.iter().skip(1).step_by(2).collect();
    let n = digits.len();
    // the right answer
    let mut sum = 0;
    let mut product = digits[0];
    for i in 0..n - 1 {
        if ops[i] == '+' {
            sum += product;
            product = digits[i + 1];
        } else {
            product *= digits[i + 1];
        }
    }
    let correct = sum + product;
    // values[i][j]: every value of digits i..=j under some order
    let mut values: Vec[Vec[Set[i64]]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[Set[i64]] = Vec.new();
        for j in 0..n {
            let mut cell: Set[i64] = Set.new();
            if i == j {
                cell.insert(digits[i]);
            }
            row.push(cell);
        }
        values.push(row);
    }
    for length in 2..n + 1 {
        for i in 0..n - length + 1 {
            let j = i + length - 1;
            let mut cell: Set[i64] = Set.new();
            for k in i..j {
                for a in values[i][k].iter() {
                    for b in values[k + 1][j].iter() {
                        let v = if ops[k] == '+' { a + b } else { a * b };
                        if v <= 1000 {
                            cell.insert(v);
                        }
                    }
                }
            }
            values[i][j] = cell;
        }
    }
    let mut points = 0;
    for answer in answers.iter() {
        if answer == correct {
            points += 5;
        } else if values[0][n - 1].contains(answer) {
            points += 2;
        }
    }
    points
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 200 expressions of 16 digits from 0 to 1-9 and 2000 answers up to 1000
    // each, built once; the ★ arm on each for 10 rounds
    let mut seed = 2019;
    let mut expressions: Vec[String] = Vec.new();
    let mut answer_lists: Vec[Vec[i64]] = Vec.new();
    for e in 0..200 {
        let top = e % 9 + 1;
        let times = e % 7 + 2;
        let mut s = String.new();
        for i in 0..16 {
            if i > 0 {
                s.push(if next_random(mut seed) % 10 < times { '*' } else { '+' });
            }
            s.push(('0' as i64 + next_random(mut seed) % (top + 1)) as u8 as char);
        }
        expressions.push(s);
        answer_lists.push((0..2000).map(|_| next_random(mut seed) % 1001).collect());
    }
    let mut calls = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..10 {
        for e in 0..expressions.len() {
            let points = score_of_students(expressions[e], answer_lists[e]);
            calls += 1;
            total += points;
            check = (check * 31 + points) % 1000000007;
        }
    }
    println(f"{calls} calls: {total} points, checksum {check}");
}
