// LeetCode #2033: Minimum Operations to Make a Uni-Value Grid -- the ★ arm
// as a benchmark. 20 grids of 200 by 250 values up to 10000, each value a
// base plus a multiple of the grid's `x`, built once; 30 rounds, each
// moving one cell of every grid by `x` before the ★ arm answers it: 600
// calls of 50000 values.

fn min_operations(grid: Vec[Vec[i64]], x: i64) -> i64 {
    let mut values: Vec[i64] = grid.iter().flat_map(|v| v.iter()).cloned().collect();
    let r = values[0] % x;
    if values.iter().any(|v| v % x != r) {
        return -1;
    }
    values.sort();
    let median = values[values.len() / 2];
    values.iter().map(|v| (v - median).abs() / x).sum()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2033;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for a in 0..20 {
        let x = a % 7 + 1;
        let base = next_random(mut seed) % x + 1;
        let steps = (10000 - base) / x + 1;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..200 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..250 {
                row.push(base + (next_random(mut seed) * 32768 + next_random(mut seed)) % steps * x);
            }
            grid.push(row);
        }
        grids.push(grid);
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for round in 0..30 {
        for a in 0..20 {
            let x = a % 7 + 1;
            let at = (round * 997 + a * 31) % 50000;
            let v = grids[a][at / 250][at % 250];
            grids[a][at / 250][at % 250] = if v + x <= 10000 { v + x } else { v - x };
            let answer = min_operations(grids[a], x);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
