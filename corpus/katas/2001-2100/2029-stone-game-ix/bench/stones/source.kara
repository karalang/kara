// LeetCode #2029: Stone Game IX -- the ★ arm. Only each stone's value mod 3
// matters. A stone worth 0 changes nothing but whose turn it is, so only
// the parity of their count matters; the 1s and 2s must then alternate
// after a first repeat (1, 1, 2, 1, 2, ... or 2, 2, 1, 2, 1, ...). With an
// even count of 0s Alice wins when she has both a 1 and a 2 to open with;
// with an odd count she needs one side to outnumber the other by more than
// 2. O(n).

fn stone_game_ix(stones: Vec[i64]) -> bool {
    let mut cnt = [0; 3];
    for s in stones {
        cnt[s % 3] += 1;
    }
    if cnt[0] % 2 == 0 {
        cnt[1] >= 1 and cnt[2] >= 1
    } else {
        (cnt[1] - cnt[2]).abs() > 2
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 games of 100000 stones up to 10000 built once, game `a` with odds
    // `a % 5` in 10 of a 0 and `3 a % 11` in 10 of a 1 among the rest; then
    // 100 rounds, each adding 1 to one stone of each game before the ★ arm
    // answers it
    let mut seed = 2029;
    let mut games: Vec[Vec[i64]] = Vec.new();
    for a in 0..20 {
        let mut stones: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            let base = 3 * (next_random(mut seed) % 3333);
            let residue = if next_random(mut seed) % 10 < a % 5 {
                3
            } else if next_random(mut seed) % 10 < 3 * a % 11 {
                1
            } else {
                2
            };
            stones.push(base + residue);
        }
        games.push(stones);
    }
    let mut calls = 0;
    let mut wins = 0;
    let mut check = 0;
    for round in 0..100 {
        for a in 0..20 {
            games[a][(round * 997 + a * 31) % 100000] += 1;
            let answer = stone_game_ix(games[a]);
            calls += 1;
            if answer {
                wins += 1;
            }
            check = (check * 31 + if answer { 1 } else { 2 }) % 1000000007;
        }
    }
    println(f"{calls} calls: Alice wins {wins}, checksum {check}");
}
