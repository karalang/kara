// LeetCode #2029: Stone Game IX -- the stones themselves dealt into three
// piles by value mod 3, and each game played by taking them off the piles:
// a player takes the stone that keeps the total off 0 mod 3, or, when that
// pile is empty, a stone worth 0, which passes the turn; with neither she
// loses, unless every stone is gone, when Bob wins. Alice tries both
// openings, each on its own copy of the piles. O(n).

fn play(piles: own Vec[Vec[i64]], first: i64) -> bool {
    let mut piles = piles;
    let mut total = piles[first].pop().unwrap() % 3;
    let mut alice_moves = false;
    loop {
        if piles[total].pop().is_some() {
            total = (total + total) % 3;
        } else if piles[0].pop().is_none() {
            // the player to move is stuck: she loses if any stone is left
            let left = piles[1].len() + piles[2].len();
            return not alice_moves and left > 0;
        }
        alice_moves = not alice_moves;
    }
}

fn stone_game_ix(stones: Vec[i64]) -> bool {
    let mut piles: Vec[Vec[i64]] = [Vec.new(), Vec.new(), Vec.new()];
    for s in stones {
        piles[s % 3].push(s);
    }
    (piles[1].len() > 0 and play(piles.clone(), 1)) or (piles[2].len() > 0 and play(piles.clone(), 2))
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: bool) -> i64 {
    (check * 31 + if answer { 1 } else { 0 }) % 1000000007
}

// `n` stones from 1 to `top`, each a multiple of 3 with odds `zeros` in
// 10, else 1 or 2 more than one, the 1s with odds `ones` in 10
fn draw(n: i64, top: i64, zeros: i64, ones: i64, seed: mut ref i64) -> Vec[i64] {
    let mut stones = Vec.new();
    for _ in 0..n {
        let base = 3 * (next_random(mut seed) % (top / 3));
        let pick = next_random(mut seed) % 10;
        let residue = if pick < zeros {
            3
        } else if next_random(mut seed) % 10 < ones {
            1
        } else {
            2
        };
        stones.push(base + residue);
    }
    stones
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [2, 1],
        [2],
        [5, 1, 2, 4, 3],
        [3, 6, 9],
        [1, 1, 1, 1, 2],
        [3, 1, 1, 1, 1, 2],
        [1, 2, 3],
        [7, 4, 1, 10, 3, 2],
    ];
    for stones in examples {
        println(f"{stones} -> {stone_game_ix(stones)}");
    }
    // 3000 games of 1 to 20 stones up to 30, the zeros and ones at odds of
    // their own; the answers counted and folded into a checksum
    let mut seed = 2029;
    let mut wins = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 20 + 1;
        let zeros = next_random(mut seed) % 5;
        let ones = next_random(mut seed) % 11;
        let stones = draw(n, 30, zeros, ones, mut seed);
        let answer = stone_game_ix(stones);
        if answer {
            wins += 1;
        }
        check = mix(check, answer);
    }
    println(f"3000 games of up to 20 stones: Alice wins {wins}, checksum {check}");
    // 8 games of 100000 stones up to 10000, the most the constraints allow
    wins = 0;
    check = 0;
    for a in 0..8 {
        let stones = draw(100000, 10000, [0, 1, 3, 5, 2, 4, 0, 1][a], [5, 5, 0, 10, 1, 9, 10, 0][a], mut seed);
        let answer = stone_game_ix(stones);
        if answer {
            wins += 1;
        }
        check = mix(check, answer);
    }
    println(f"8 games of 100000 stones: Alice wins {wins}, checksum {check}");
}
