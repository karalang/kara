// LeetCode #2040: Kth Smallest Product of Two Sorted Arrays -- the ★ arm
// as a benchmark. 4 pairs of sorted arrays of 50000 values a side (the most
// the constraints allow; values up to 100000, 3, 1000 and 100000 either
// side) built once, then 3 values of `k` for each: 12 calls, each a binary
// search of about 35 steps over 50000 partition points.

fn count_at_most(nums1: Vec[i64], nums2: Vec[i64], x: i64) -> i64 {
    let mut count = 0;
    for a in nums1.iter() {
        if a > 0 {
            count += nums2.partition_point(|b| a * b <= x);
        } else if a < 0 {
            count += nums2.len() - nums2.partition_point(|b| a * b > x);
        } else if x >= 0 {
            count += nums2.len();
        }
    }
    count
}

fn kth_smallest_product(nums1: Vec[i64], nums2: Vec[i64], k: i64) -> i64 {
    let mut lo = -10000000000;
    let mut hi = 10000000000;
    while lo < hi {
        let mid = lo + (hi - lo).div_euclid(2);
        if count_at_most(nums1, nums2, mid) >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn sorted_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut v: Vec[i64] = (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top).collect();
    v.sort();
    v
}

fn main() {
    let mut seed = 2040;
    let n = 50000;
    let mut pairs: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for r in 0..4 {
        let top = [100000, 3, 1000, 100000][r];
        let a = sorted_values(n, top, mut seed);
        let b = sorted_values(n, top, mut seed);
        pairs.push((a, b));
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for round in 0..3 {
        for r in 0..4 {
            let k = (round * 4 + r + 1) * (n * n / 13) + 1;
            let answer = kth_smallest_product(pairs[r].0, pairs[r].1, k);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer.rem_euclid(1000000007)) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
