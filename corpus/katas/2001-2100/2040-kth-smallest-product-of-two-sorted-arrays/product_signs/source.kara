// LeetCode #2040: Kth Smallest Product of Two Sorted Arrays -- by sign. The
// products below zero, at zero and above zero are counted first from the
// sizes of the sign groups, which says which group holds the `k`-th; then
// the search runs over that group's range only, with its own count. The
// negative products are `negative a * positive b` and `positive a *
// negative b`; the positive ones, `positive * positive` and `negative *
// negative`. O(n log m log V).

struct Signs {
    negative: Vec[i64],
    zeros: i64,
    positive: Vec[i64],
}

fn signs(xs: Vec[i64]) -> Signs {
    Signs {
        negative: xs.iter().filter(|x| x < 0).cloned().collect(),
        zeros: xs.iter().filter(|x| x == 0).count(),
        positive: xs.iter().filter(|x| x > 0).cloned().collect(),
    }
}

// products `a b <= x` over `a` in `xs` and `b` in sorted `ys`
fn pairs_at_most(xs: Vec[i64], ys: Vec[i64], x: i64) -> i64 {
    let mut count = 0;
    for a in xs.iter() {
        count += if a > 0 {
            ys.partition_point(|b| a * b <= x)
        } else {
            ys.len() - ys.partition_point(|b| a * b > x)
        };
    }
    count
}

fn kth_smallest_product(nums1: Vec[i64], nums2: Vec[i64], k: i64) -> i64 {
    let s1 = signs(nums1);
    let s2 = signs(nums2);
    let below = s1.negative.len() * s2.positive.len() + s1.positive.len() * s2.negative.len();
    let zero = s1.zeros * nums2.len() + s2.zeros * nums1.len() - s1.zeros * s2.zeros;
    if k > below and k <= below + zero {
        return 0;
    }
    // the sign groups whose products are on the `k`-th's side of zero
    let mut (groups, rank, lo, hi) = if k <= below {
        ([(s1.negative.clone(), s2.positive.clone()), (s1.positive.clone(), s2.negative.clone())], k, -10000000000, -1)
    } else {
        ([(s1.positive.clone(), s2.positive.clone()), (s1.negative.clone(), s2.negative.clone())], k - below - zero, 1, 10000000000)
    };
    while lo < hi {
        let mid = lo + (hi - lo).div_euclid(2);
        let count: i64 = groups.iter().map(|(xs, ys)| pairs_at_most(xs, ys, mid)).sum();
        if count >= rank {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer.rem_euclid(1000000007)) % 1000000007
}

// `n` sorted values from `-top` to `top`
fn sorted_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut v: Vec[i64] = (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top).collect();
    v.sort();
    v
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], Vec[i64], i64)] = [
        ([2, 5].to_vec(), [3, 4].to_vec(), 2),
        ([-4, -2, 0, 3].to_vec(), [2, 4].to_vec(), 6),
        ([-2, -1, 0, 1, 2].to_vec(), [-3, -1, 2, 4, 5].to_vec(), 3),
        ([7].to_vec(), [-6].to_vec(), 1),
        ([-100000, 100000].to_vec(), [-100000, 100000].to_vec(), 4),
        ([-100000, 100000].to_vec(), [-100000, 100000].to_vec(), 1),
        ([0, 0, 0].to_vec(), [-1, 1].to_vec(), 4),
        ([-5, -3, -1].to_vec(), [-4, -2].to_vec(), 5),
    ].to_vec();
    for (a, b, k) in examples.into_iter() {
        let shown = f"{a} {b} {k}";
        println(f"{shown} -> {kth_smallest_product(a, b, k)}");
    }
    // 2000 problems of 1 to 8 values a side, up to 1 to 20 either side
    let mut seed = 2040;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let top = next_random(mut seed) % 20 + 1;
        let a = sorted_values(next_random(mut seed) % 8 + 1, top, mut seed);
        let b = sorted_values(next_random(mut seed) % 8 + 1, top, mut seed);
        let k = next_random(mut seed) % (a.len() * b.len()) + 1;
        let answer = kth_smallest_product(a, b, k);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 problems of up to 8 values a side: sum {sum}, checksum {check}");
    // 4 large problems, the first of 50000 values a side, the most the
    // constraints allow
    sum = 0;
    check = 0;
    for r in 0..4 {
        let top = [100000, 3, 1000, 100000][r];
        let n = [50000, 10000, 5000, 1000][r];
        let a = sorted_values(n, top, mut seed);
        let b = sorted_values(n, top, mut seed);
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) * 76293 % (n * n) + 1;
        let answer = kth_smallest_product(a, b, k);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 large problems: sum {sum}, checksum {check}");
}
