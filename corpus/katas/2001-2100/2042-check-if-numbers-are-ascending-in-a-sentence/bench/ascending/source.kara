// LeetCode #2042: Check if Numbers Are Ascending in a Sentence -- the ★
// arm as a benchmark. 1000 random sentences of up to 32 tokens (words and
// numbers below 100) built once, then 1000 rounds over them: 1000000
// calls, each splitting a sentence at its spaces and parsing its tokens.

fn are_numbers_ascending(s: String) -> bool {
    let mut last = 0;
    for token in s.split(" ") {
        if let Ok(n) = i64.parse(token) {
            if n <= last {
                return false;
            }
            last = n;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a sentence of words and numbers below 100, at most 200 characters, with
// at least two numbers; each number is the last one moved by up to `drift`
// down or `climb` up, kept within 1 to 99
fn sentence(seed: mut ref i64) -> String {
    let words = 1 + next_random(mut seed) % 30;
    let climb = next_random(mut seed) % 20 + 1;
    let drift = next_random(mut seed) % 4;
    let mut last = next_random(mut seed) % 10 + 1;
    let mut tokens: Vec[String] = Vec.new();
    let mut numbers = 0;
    let mut length = 0;
    for t in 0..words + 2 {
        let token = if t >= words or next_random(mut seed) % 3 == 0 {
            last = (last + next_random(mut seed) % (climb + drift + 1) - drift).max(1).min(99);
            numbers += 1;
            f"{last}"
        } else {
            let mut word = String.new();
            for _ in 0..next_random(mut seed) % 6 + 1 {
                word.push(['a', 'b', 'c', 'x', 'y', 'z'][next_random(mut seed) % 6]);
            }
            word
        };
        if length + token.len() + 1 > 200 and numbers >= 2 {
            break;
        }
        length += token.len() + 1;
        tokens.push(token);
    }
    tokens.join(" ")
}

fn main() {
    let mut seed = 2042;
    let sentences: Vec[String] = (0..1000).map(|_| sentence(mut seed)).collect();
    let mut calls = 0;
    let mut ascending = 0;
    let mut check = 0;
    for round in 0..1000 {
        for i in 0..sentences.len() {
            let answer = are_numbers_ascending(sentences[i].clone());
            calls += 1;
            if answer {
                ascending += 1;
                check = (check * 31 + round + i) % 1000000007;
            }
        }
    }
    println(f"{calls} calls: {ascending} ascending, checksum {check}");
}
