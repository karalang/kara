// LeetCode #2025: Maximum Number of Ways to Partition an Array -- the ★
// arm. Pivot `p` (1 <= p < n) splits the array into `nums[0..p]` and
// `nums[p..n]`; let `d[p]` be the left sum minus the right sum. Changing
// `nums[i]` to `k` adds `delta = k - nums[i]` to `d[p]` for every pivot
// with `i` on its left (`p > i`) and takes it away for every pivot with
// `i` on its right (`p <= i`). So the change at `i` balances the pivots
// right of it with `d = -delta` and those left of it with `d = delta`: two
// `Map`s of `d`, one for each side, moved one pivot at a time as `i`
// sweeps. With no change, the pivots with `d = 0`. O(n).

fn ways_to_partition(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let total: i64 = nums.iter().sum();
    let mut d: Vec[i64] = Vec.new();
    let mut left = 0;
    for p in 1..n {
        left += nums[p - 1];
        d.push(left - (total - left));
    }
    let mut right: Map[i64, i64] = Map.new();
    for x in d.iter() {
        *right.entry(x).or_insert(0) += 1;
    }
    let mut best = right.get(0).unwrap_or(0);
    let mut seen: Map[i64, i64] = Map.new();
    for i in 0..n {
        // the pivots p <= i are on `seen`, the pivots p > i on `right`
        if i >= 1 {
            let x = d[i - 1];
            *right.entry(x).or_insert(0) -= 1;
            *seen.entry(x).or_insert(0) += 1;
        }
        let delta = k - nums[i];
        let ways = right.get(-delta).unwrap_or(0) + seen.get(delta).unwrap_or(0);
        best = best.max(ways);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 arrays of 50000 values from -r to r, r from 1 to 100000, and k in
    // the same range, built once; the ★ arm on each for 10 rounds
    let mut seed = 2025;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut ks: Vec[i64] = Vec.new();
    for a in 0..20 {
        let r = [1, 2, 3, 10, 100, 1000, 10000, 100000][a % 8];
        arrays.push((0..50000).map(|_| next_random(mut seed) % (2 * r + 1) - r).collect());
        ks.push(next_random(mut seed) % (2 * r + 1) - r);
    }
    let mut calls = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..10 {
        for a in 0..20 {
            let best = ways_to_partition(arrays[a], ks[a]);
            calls += 1;
            total += best;
            check = (check * 31 + best) % 1000000007;
        }
    }
    println(f"{calls} calls: total {total}, checksum {check}");
}
