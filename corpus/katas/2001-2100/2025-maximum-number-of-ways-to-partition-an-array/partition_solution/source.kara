// LeetCode #2025: Maximum Number of Ways to Partition an Array -- LeetCode's
// Rust template, carried to Kāra by `karac fix`. Prefix sums in `i64`, two
// `HashMap<i64, i32>`s, `entry().or_insert(0)` and `get().copied()`.


impl Solution {
    pub fn ways_to_partition(nums: Vec[i32], k: i32) -> i32 {
        let n = nums.len();
        let mut pre = Vec.filled(n + 1, 0);
        for i in 0..n {
            pre[i + 1] = pre[i] + nums[i];
        }
        let total = pre[n];
        let mut right: Map[i64, i32] = Map.new();
        for p in 1..n {
            *right.entry(2 * pre[p] - total).or_insert(0) += 1;
        }
        let mut ans = *right.get(0).unwrap_or(0);
        let mut left: Map[i64, i32] = Map.new();
        for i in 0..n {
            if i >= 1 {
                let d = 2 * pre[i] - total;
                *right.get_mut(d).unwrap() -= 1;
                *left.entry(d).or_insert(0) += 1;
            }
            let delta = (k - nums[i]) as i64;
            let ways = right.get(-delta).cloned().unwrap_or(0) + left.get(delta).cloned().unwrap_or(0);
            ans = ans.max(ways);
        }
        ans
    }
}

struct Solution {}

fn ways_to_partition(nums: Vec[i64], k: i64) -> i64 {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.ways_to_partition(v, k as i32) as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], i64)] = [
        ([2, -1, 2], 3),
        ([0, 0, 0], 1),
        ([22, 4, -25, -20, -15, 15, -16, 7, 19, -10, 0, -13, -14], -33),
        ([1, 1], 5),
        ([1, 2], 1),
        ([0, 0, 0, 0, 0], 0),
        ([3, -3, 3, -3], 0),
        ([5, 5, 5, 5], -5),
    ];
    for (nums, k) in examples {
        println(f"{nums}, {k} -> {ways_to_partition(nums, k)}");
    }
    // 3000 arrays of 2 to 20 values from -r to r, r from 1 to 5, and k in
    // the same range
    let mut seed = 2025;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 19 + 2;
        let r = next_random(mut seed) % 5 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (2 * r + 1) - r).collect();
        let k = next_random(mut seed) % (2 * r + 1) - r;
        let best = ways_to_partition(nums, k);
        total += best;
        check = (check * 31 + best) % 1000000007;
    }
    println(f"3000 arrays of up to 20 values: total {total}, checksum {check}");
    // 5 arrays of 1500 values from -r to r, r from 1 to 100000
    total = 0;
    check = 0;
    for a in 0..5 {
        let r = [1, 2, 10, 1000, 100000][a];
        let nums: Vec[i64] = (0..1500).map(|_| next_random(mut seed) % (2 * r + 1) - r).collect();
        let k = next_random(mut seed) % (2 * r + 1) - r;
        let best = ways_to_partition(nums, k);
        total += best;
        check = (check * 31 + best) % 1000000007;
    }
    println(f"5 arrays of 1500 values: total {total}, checksum {check}");
}
