// LeetCode #2023: Number of Pairs of Strings With Concatenation Equal to
// Target -- one pass. A `Map` holds the strings seen so far; a new string
// `x` pairs with each earlier `y` where `x + y` is the target (`x` a
// prefix, `y` the rest) and with each where `y + x` is (`x` a suffix), so
// every ordered pair is counted when its later string arrives. O(n L).

fn num_of_pairs(nums: Vec[String], target: String) -> i64 {
    let mut seen: Map[String, i64] = Map.new();
    let mut pairs = 0;
    for x in nums.iter() {
        if let Some(rest) = target.strip_prefix(x) {
            pairs += seen.get(rest).unwrap_or(0);
        }
        if target.ends_with(x) {
            let head = target[0..target.len() - x.len()];
            pairs += seen.get(head).unwrap_or(0);
        }
        *seen.entry(x.clone()).or_insert(0) += 1;
    }
    pairs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digits(seed: mut ref i64, len: i64, top: i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        s.push(('1' as i64 + next_random(mut seed) % top) as u8 as char);
    }
    s
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[String], String)] = [
        (["777", "7", "77", "77"], "7777"),
        (["123", "4", "12", "34"], "1234"),
        (["1", "1", "1"], "11"),
        (["1", "2"], "12"),
        (["12", "12"], "1212"),
        (["1", "11", "111"], "1111"),
        (["5", "55"], "555"),
        (["21", "12", "2", "1"], "2112"),
    ];
    for (nums, target) in examples {
        println(f"{nums}, {target} -> {num_of_pairs(nums, target)}");
    }
    // 3000 problems of 2 to 10 strings of 1 to 4 digits from 1-2, the
    // target with even odds two of them joined, else 2 to 8 digits
    let mut seed = 2023;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 9 + 2;
        let nums: Vec[String] = (0..n).map(|_| { let len = next_random(mut seed) % 4 + 1; digits(mut seed, len, 2) }).collect();
        let target = if next_random(mut seed) % 2 == 0 {
            let i = next_random(mut seed) % n;
            let j = next_random(mut seed) % n;
            f"{nums[i]}{nums[j]}"
        } else {
            let len = next_random(mut seed) % 7 + 2;
            digits(mut seed, len, 2)
        };
        let pairs = num_of_pairs(nums, target);
        total += pairs;
        check = (check * 31 + pairs) % 1000000007;
    }
    println(f"3000 problems of up to 10 strings: {total} pairs, checksum {check}");
    // 5 problems of 100 strings of up to 100 digits: runs of 7s against
    // targets of 2, 51, 100 and 199 7s, and digits from 1-3 against one of
    // them doubled
    total = 0;
    check = 0;
    for p in 0..5 {
        let nums: Vec[String] = if p < 4 {
            (0..100).map(|_| "7".repeat(next_random(mut seed) % 100 + 1)).collect()
        } else {
            (0..100).map(|_| { let len = next_random(mut seed) % 3 + 1; digits(mut seed, len, 3) }).collect()
        };
        let target = if p < 4 { "7".repeat([2, 51, 100, 199][p]) } else { f"{nums[7]}{nums[7]}" };
        let pairs = num_of_pairs(nums, target);
        total += pairs;
        check = (check * 31 + pairs) % 1000000007;
    }
    println(f"5 problems of 100 strings: {total} pairs, checksum {check}");
}
