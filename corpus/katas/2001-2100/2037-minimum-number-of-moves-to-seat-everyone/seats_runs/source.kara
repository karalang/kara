// LeetCode #2037: Minimum Number of Moves to Seat Everyone -- run lengths.
// Each side counted into a `SortedMap` of place to how many, then walked as
// two lists of `(place, count)` runs in order: the front runs pair off as
// many as the smaller count, and whichever run is used up is dropped.
// O(n log n) for the counts, O(distinct places) for the walk.

fn runs(places: Vec[i64]) -> Vec[(i64, i64)] {
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    for p in places.iter() {
        *counts.entry(p).or_insert(0) += 1;
    }
    counts.iter().map(|(p, c)| (p, c)).collect()
}

fn min_moves_to_seat(seats: Vec[i64], students: Vec[i64]) -> i64 {
    let mut free = runs(seats);
    let mut waiting = runs(students);
    let mut (i, j) = (0, 0);
    let mut moves = 0;
    while i < free.len() and j < waiting.len() {
        let take = free[i].1.min(waiting[j].1);
        moves += take * (free[i].0 - waiting[j].0).abs();
        free[i].1 -= take;
        waiting[j].1 -= take;
        if free[i].1 == 0 {
            i += 1;
        }
        if waiting[j].1 == 0 {
            j += 1;
        }
    }
    moves
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// `n` positions from 1 to `top`
fn random_positions(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    (0..n).map(|_| next_random(mut seed) % top + 1).collect()
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], Vec[i64])] = [
        ([3, 1, 5].to_vec(), [2, 7, 4].to_vec()),
        ([4, 1, 5, 9].to_vec(), [1, 3, 2, 6].to_vec()),
        ([2, 2, 6, 6].to_vec(), [1, 3, 2, 6].to_vec()),
        ([1].to_vec(), [100].to_vec()),
        ([7, 7, 7].to_vec(), [7, 7, 7].to_vec()),
        ([1, 100].to_vec(), [100, 1].to_vec()),
        ([5, 3, 9, 1, 1].to_vec(), [2, 2, 8, 10, 4].to_vec()),
    ].to_vec();
    for (seats, students) in examples.into_iter() {
        let room = f"{seats} {students}";
        println(f"{room} -> {min_moves_to_seat(seats, students)}");
    }
    // 2000 rooms of 1 to 100 seats at positions up to 1 to 100
    let mut seed = 2037;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 100 + 1;
        let top = next_random(mut seed) % 100 + 1;
        let seats = random_positions(n, top, mut seed);
        let students = random_positions(n, top, mut seed);
        let answer = min_moves_to_seat(seats, students);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 rooms of up to 100 seats: sum {sum}, checksum {check}");
}
