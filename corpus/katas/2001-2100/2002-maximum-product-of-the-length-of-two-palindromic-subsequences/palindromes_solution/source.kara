// LeetCode #2002: Maximum Product of the Length of Two Palindromic
// Subsequences -- LeetCode's Rust template, carried to Kāra by `karac fix`.
// The palindromic masks into a Vec, then every disjoint pair, over `usize`
// indices and `as_bytes`.

struct Solution {}

impl Solution {
    pub fn max_product(s: String) -> i32 {
        let b = s.bytes();
        let n = b.len();
        let mut pals: Vec[(i64, i32)] = Vec.new();
        for mask in 1..(1 << n) {
            let idx: Vec[i64] = (0..n).filter(|i| mask >> i & 1 == 1).collect();
            let mut (i, j) = (0, idx.len() - 1);
            let mut ok = true;
            while i < j {
                if b[idx[i]] != b[idx[j]] {
                    ok = false;
                    break;
                }
                i += 1;
                j -= 1;
            }
            if ok {
                pals.push((mask, idx.len() as i32));
            }
        }
        let mut best = 0;
        for x in 0..pals.len() {
            for y in x + 1..pals.len() {
                if pals[x].0 & pals[y].0 == 0 {
                    best = best.max(pals[x].1 * pals[y].1);
                }
            }
        }
        best
    }
}

fn max_product(s: Str) -> i64 {
    Solution.max_product(s.to_string())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_string(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        "leetcodecom", "bb", "accbcaxxcxx", "ab", "aaaaaaaaaaaa",
        "abcdefghijkl", "abacaba", "racecarlevel",
    ];
    for s in examples {
        println(f"{s} -> {max_product(s)}");
    }
    let mut seed = 2002;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..1500 {
        let n = next_random(mut seed) % 7 + 2;
        let letters = next_random(mut seed) % 3 + 1;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"1500 strings of 2 to 8 letters: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..60 {
        let n = next_random(mut seed) % 4 + 9;
        let letters = next_random(mut seed) % 4 + 2;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"60 strings of 9 to 12 letters: sum {sum}, checksum {check}");
}
