// LeetCode #2002: Maximum Product of the Length of Two Palindromic
// Subsequences -- the submask arm. `within[m]` is the longest palindromic
// subsequence using only positions in `m`: the whole of `m` when it reads
// as a palindrome, else the best with one position dropped. Each palindromic
// mask then pairs with `within` of its complement.

fn max_product(s: String) -> i64 {
    let b = s.bytes().to_vec();
    let n = b.len();
    let full = (1 << n) - 1;
    let mut own = Vec.filled(full + 1, 0);
    let mut within = Vec.filled(full + 1, 0);
    for mask in 1..full + 1 {
        let mut picked: Vec[u8] = Vec.new();
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                picked.push(b[i]);
            }
        }
        let mut reversed = picked.clone();
        reversed.reverse();
        if picked == reversed {
            own[mask] = picked.len();
        }
        within[mask] = own[mask];
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                within[mask] = within[mask].max(within[mask ^ (1 << i)]);
            }
        }
    }
    let mut best = 0;
    for mask in 1..full + 1 {
        best = best.max(own[mask] * within[full ^ mask]);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_string(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        "leetcodecom", "bb", "accbcaxxcxx", "ab", "aaaaaaaaaaaa",
        "abcdefghijkl", "abacaba", "racecarlevel",
    ];
    for s in examples {
        println(f"{s} -> {max_product(s)}");
    }
    let mut seed = 2002;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..1500 {
        let n = next_random(mut seed) % 7 + 2;
        let letters = next_random(mut seed) % 3 + 1;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"1500 strings of 2 to 8 letters: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..60 {
        let n = next_random(mut seed) % 4 + 9;
        let letters = next_random(mut seed) % 4 + 2;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"60 strings of 9 to 12 letters: sum {sum}, checksum {check}");
}
