// LeetCode #2002: Maximum Product of the Length of Two Palindromic
// Subsequences -- the pairs arm. Every palindromic mask collected with its
// length, then every two masks with no position in common multiplied.

fn is_palindrome(b: Vec[u8], mask: i64) -> bool {
    let mut picked: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if (mask >> i) & 1 == 1 {
            picked.push(b[i]);
        }
    }
    let mut i = 0;
    let mut j = picked.len() - 1;
    while i < j {
        if picked[i] != picked[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    true
}

fn max_product(s: String) -> i64 {
    let b = s.bytes().to_vec();
    let mut masks: Vec[i64] = Vec.new();
    let mut lengths: Vec[i64] = Vec.new();
    for mask in 1..(1 << b.len()) {
        if is_palindrome(b, mask) {
            masks.push(mask);
            lengths.push(mask.count_ones());
        }
    }
    let mut best = 0;
    for i in 0..masks.len() {
        for j in i + 1..masks.len() {
            if masks[i] & masks[j] == 0 {
                best = best.max(lengths[i] * lengths[j]);
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_string(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        "leetcodecom", "bb", "accbcaxxcxx", "ab", "aaaaaaaaaaaa",
        "abcdefghijkl", "abacaba", "racecarlevel",
    ];
    for s in examples {
        println(f"{s} -> {max_product(s)}");
    }
    let mut seed = 2002;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..1500 {
        let n = next_random(mut seed) % 7 + 2;
        let letters = next_random(mut seed) % 3 + 1;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"1500 strings of 2 to 8 letters: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..60 {
        let n = next_random(mut seed) % 4 + 9;
        let letters = next_random(mut seed) % 4 + 2;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"60 strings of 9 to 12 letters: sum {sum}, checksum {check}");
}
