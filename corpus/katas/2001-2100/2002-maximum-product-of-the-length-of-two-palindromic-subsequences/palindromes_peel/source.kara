// LeetCode #2002: Maximum Product of the Length of Two Palindromic
// Subsequences -- the peeling arm. A mask reads as a palindrome when its
// lowest and highest set bits name equal letters, peeled pair by pair with
// `trailing_zeros` and `leading_zeros`. The palindromic masks sorted longest
// first, the pair search stops once no longer pair can beat the best.

fn is_palindrome(b: Vec[u8], mask: i64) -> bool {
    let mut m = mask;
    while m.count_ones() > 1 {
        let lo = m.trailing_zeros();
        let hi = 63 - m.leading_zeros();
        if b[lo] != b[hi] {
            return false;
        }
        m &= ~((1 << lo) | (1 << hi));
    }
    true
}

fn max_product(s: String) -> i64 {
    let b = s.bytes().to_vec();
    let mut pals: Vec[(i64, i64)] = Vec.new();
    for mask in 1..(1 << b.len()) {
        if is_palindrome(b, mask) {
            pals.push((mask.count_ones(), mask));
        }
    }
    pals.sort_by(|x, y| y.0.cmp(x.0));
    let mut best = 0;
    for i in 0..pals.len() {
        if pals[i].0 * pals[i].0 <= best {
            break;
        }
        for j in i + 1..pals.len() {
            if pals[i].0 * pals[j].0 <= best {
                break;
            }
            if pals[i].1 & pals[j].1 == 0 {
                best = pals[i].0 * pals[j].0;
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_string(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        "leetcodecom", "bb", "accbcaxxcxx", "ab", "aaaaaaaaaaaa",
        "abcdefghijkl", "abacaba", "racecarlevel",
    ];
    for s in examples {
        println(f"{s} -> {max_product(s)}");
    }
    let mut seed = 2002;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..1500 {
        let n = next_random(mut seed) % 7 + 2;
        let letters = next_random(mut seed) % 3 + 1;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"1500 strings of 2 to 8 letters: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..60 {
        let n = next_random(mut seed) % 4 + 9;
        let letters = next_random(mut seed) % 4 + 2;
        let s = random_string(n, letters, mut seed);
        let answer = max_product(s);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"60 strings of 9 to 12 letters: sum {sum}, checksum {check}");
}
