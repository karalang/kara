// LeetCode #2047: Number of Valid Words in a Sentence -- the ★ arm as a
// benchmark. 2000 sentences of 1000 characters, the longest the constraints
// allow, built once from letters, spaces, hyphens, marks and digits; then
// 100 rounds, each counting the valid words of every sentence from a byte
// offset of 0 to 6 set by the round: 200000 calls.

fn is_valid(token: Str) -> bool {
    let cs: Vec[char] = token.chars().collect();
    let n = cs.len();
    let mut hyphens = 0;
    for i in 0..n {
        let c = cs[i];
        if c.is_ascii_digit() {
            return false;
        }
        if c == '-' {
            hyphens += 1;
            if hyphens > 1 or i == 0 or i == n - 1 {
                return false;
            }
            if not cs[i - 1].is_ascii_lowercase() or not cs[i + 1].is_ascii_lowercase() {
                return false;
            }
        }
        if (c == '!' or c == '.' or c == ',') and i != n - 1 {
            return false;
        }
    }
    true
}

fn count_valid_words(sentence: Str) -> i64 {
    let mut count = 0;
    for token in sentence.split_whitespace() {
        if is_valid(token) {
            count += 1;
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let symbols: Vec[char] = "abcdefgh--!.,9".chars().collect();
    let mut seed = 2047;
    let mut sentences: Vec[String] = Vec.new();
    for _ in 0..2000 {
        let mut s = String.new();
        for _ in 0..1000 {
            let r = next_random(mut seed) % 100;
            if r < 70 {
                s.push(symbols[next_random(mut seed) % 8]);
            } else if r < 85 {
                s.push(' ');
            } else {
                s.push(symbols[next_random(mut seed) % symbols.len()]);
            }
        }
        sentences.push(s);
    }
    let mut calls = 0;
    let mut words = 0;
    let mut check = 0;
    for r in 0..100 {
        for s in sentences.iter() {
            let n = count_valid_words(s[r % 7..s.len()]);
            calls += 1;
            words += n;
            check = (check * 31 + n) % 1000000007;
        }
    }
    println(f"{calls} calls: {words} valid words, checksum {check}");
}
