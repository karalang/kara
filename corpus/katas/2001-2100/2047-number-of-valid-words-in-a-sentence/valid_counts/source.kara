// LeetCode #2047: Number of Valid Words in a Sentence -- each token judged
// by counting and finding rather than walking it: `split(" ")` with the
// empty pieces dropped, no digit, at most one hyphen found with `find` and
// letters on both sides of it by `char_at`, at most one mark and that one
// last.

fn is_mark(c: char) -> bool {
    c == '!' or c == '.' or c == ','
}

fn is_valid(token: Str) -> bool {
    if token.chars().any(|c| c.is_ascii_digit()) {
        return false;
    }
    let n = token.len();
    match token.chars().filter(|c| c == '-').count() {
        0 => {}
        1 => {
            let at = token.find("-").unwrap();
            let before = token.char_at(at - 1);
            let after = token.char_at(at + 1);
            if at == 0 or at == n - 1 {
                return false;
            }
            if not before.is_some_and(|c| c.is_ascii_lowercase()) or not after.is_some_and(|c| c.is_ascii_lowercase()) {
                return false;
            }
        }
        _ => return false,
    }
    match token.chars().filter(|c| is_mark(c)).count() {
        0 => true,
        1 => token.char_at(n - 1).is_some_and(|c| is_mark(c)),
        _ => false,
    }
}

fn count_valid_words(sentence: Str) -> i64 {
    let mut count = 0;
    for token in sentence.split(" ") {
        if not token.is_empty() and is_valid(token) {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a sentence of `len` characters from `alphabet`, most of them letters,
// with at least one token
fn draw(len: i64, alphabet: Str, seed: mut ref i64) -> String {
    let symbols: Vec[char] = alphabet.chars().collect();
    let mut s = String.new();
    for _ in 0..len {
        let r = next_random(mut seed) % 100;
        if r < 60 {
            s.push(symbols[next_random(mut seed) % 3]);
        } else if r < 80 {
            s.push(' ');
        } else {
            s.push(symbols[next_random(mut seed) % symbols.len()]);
        }
    }
    s.push('a');
    s
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        "cat and  dog",
        "!this  1-s b8d!",
        "alice and  bob are playing stone-game10",
        "he bought 2 pencils, 3 erasers, and 1  pencil-sharpener.",
        "a-b-c a- -a a-b. a-b! ab, a!b ., ,. - !",
        "  x  ",
        "a--b a-. -. q-r-,",
    ];
    for s in examples.iter() {
        println(f"\"{s}\" -> {count_valid_words(s)}");
    }
    // 2000 sentences of 1 to 40 characters, every kind of symbol
    let mut seed = 2047;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let len = next_random(mut seed) % 40;
        let s = draw(len, "abc-!.,0123456789", mut seed);
        let n = count_valid_words(s);
        total += n;
        check = (check * 31 + n) % 1000000007;
    }
    println(f"2000 sentences: {total} valid words, checksum {check}");
    // 3000 sentences of 1000 characters, the longest the constraints allow,
    // letters weighted towards hyphens and marks
    total = 0;
    check = 0;
    for _ in 0..3000 {
        let s = draw(999, "ab---!!..,,9", mut seed);
        let n = count_valid_words(s);
        total += n;
        check = (check * 31 + n) % 1000000007;
    }
    println(f"3000 long sentences: {total} valid words, checksum {check}");
}
