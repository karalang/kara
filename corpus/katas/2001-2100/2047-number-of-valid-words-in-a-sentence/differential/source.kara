// LeetCode #2047: Number of Valid Words in a Sentence -- the differential.
// The six arms, against the statement read literally: the sentence cut into
// tokens at every space, each token tried against the three rules one by
// one. 1500 sentences of 0 to 30 characters from letters, hyphens, marks,
// digits and spaces, every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  every space doubled, and spaces added at both ends, leave the answer
// P3  the tokens in reverse order leave the answer
// P4  the sentence written twice, a space between, doubles the answer
// P5  the letters `a` and `c` swapped leave the answer
// P6  each arm agrees with at least three of the other five

import std.regex.{Regex};

// ---- valid.kara: the ★ arm, each token walked character by character
fn star_is_valid(token: Str) -> bool {
    let cs: Vec[char] = token.chars().collect();
    let n = cs.len();
    let mut hyphens = 0;
    for i in 0..n {
        let c = cs[i];
        if c.is_ascii_digit() {
            return false;
        }
        if c == '-' {
            hyphens += 1;
            if hyphens > 1 or i == 0 or i == n - 1 {
                return false;
            }
            if not cs[i - 1].is_ascii_lowercase() or not cs[i + 1].is_ascii_lowercase() {
                return false;
            }
        }
        if (c == '!' or c == '.' or c == ',') and i != n - 1 {
            return false;
        }
    }
    true
}

fn star_count_valid_words(sentence: Str) -> i64 {
    let mut count = 0;
    for token in sentence.split_whitespace() {
        if star_is_valid(token) {
            count += 1;
        }
    }
    count
}

// ---- valid_scan.kara: one pass over the bytes, no splitting
fn scan_is_letter(b: u8) -> bool {
    b >= b'a' and b <= b'z'
}

fn scan_count_valid_words(sentence: Str) -> i64 {
    let bytes = sentence.bytes();
    let n = bytes.len();
    let mut count = 0;
    let mut in_token = false;
    let mut valid = true;
    let mut hyphen = false;
    let mut marked = false;
    let mut prev: u8 = b' ';
    for i in 0..n + 1 {
        let b = if i < n { bytes[i] } else { b' ' };
        if b == b' ' {
            // a hyphen must be followed by a letter
            if in_token and valid and prev != b'-' {
                count += 1;
            }
            in_token = false;
            prev = b;
            continue;
        }
        if not in_token {
            in_token = true;
            valid = true;
            hyphen = false;
            marked = false;
        } else if marked {
            // a mark was not the last character
            valid = false;
        }
        if b >= b'0' and b <= b'9' {
            valid = false;
        } else if b == b'-' {
            if hyphen or not scan_is_letter(prev) {
                valid = false;
            }
            hyphen = true;
        } else if b == b'!' or b == b'.' or b == b',' {
            if prev == b'-' {
                valid = false;
            }
            marked = true;
        }
        prev = b;
    }
    count
}

// ---- valid_counts.kara: counts and `find`, no walk
fn counts_is_mark(c: char) -> bool {
    c == '!' or c == '.' or c == ','
}

fn counts_is_valid(token: Str) -> bool {
    if token.chars().any(|c| c.is_ascii_digit()) {
        return false;
    }
    let n = token.len();
    match token.chars().filter(|c| c == '-').count() {
        0 => {}
        1 => {
            let at = token.find("-").unwrap();
            let before = token.char_at(at - 1);
            let after = token.char_at(at + 1);
            if at == 0 or at == n - 1 {
                return false;
            }
            if not before.is_some_and(|c| c.is_ascii_lowercase()) or not after.is_some_and(|c| c.is_ascii_lowercase()) {
                return false;
            }
        }
        _ => return false,
    }
    match token.chars().filter(|c| counts_is_mark(c)).count() {
        0 => true,
        1 => token.char_at(n - 1).is_some_and(|c| counts_is_mark(c)),
        _ => false,
    }
}

fn counts_count_valid_words(sentence: Str) -> i64 {
    let mut count = 0;
    for token in sentence.split(" ") {
        if not token.is_empty() and counts_is_valid(token) {
            count += 1;
        }
    }
    count
}

// ---- valid_iter.kara: one iterator chain, `enumerate().all(..)`
fn iter_count_valid_words(sentence: Str) -> i64 {
    sentence
        .split_whitespace()
        .filter(|token| {
            let cs: Vec[char] = token.chars().collect();
            let n = cs.len();
            let letter = |i: i64| i >= 0 and i < n and cs[i].is_ascii_lowercase();
            cs.iter().filter(|c| c == '-').count() <= 1
                and cs.iter().enumerate().all(|(i, c)| match c {
                    '0'..='9' => false,
                    '-' => letter(i - 1) and letter(i + 1),
                    '!' | '.' | ',' => i == n - 1,
                    _ => true,
                })
        })
        .count()
}

// ---- valid_regex.kara: a regular expression
fn regex_count_valid_words(sentence: Str) -> i64 {
    let word = Regex.compile("^([a-z]+(-[a-z]+)?)?[!.,]?$").unwrap();
    sentence.split_whitespace().filter(|token| word.is_match(token)).count()
}

// ---- valid_solution.kara: LeetCode's Rust template, carried by `karac fix`
struct Solution {}

impl Solution {
    pub fn count_valid_words(sentence: String) -> i32 {
        sentence.split_whitespace().filter(|w| Solution.valid(w)).count() as i32
    }

    fn valid(w: Str) -> bool {
        let b = w.bytes();
        let n = b.len();
        let mut hyphen = false;
        for i in 0..n {
            let c = b[i];
            if c.is_ascii_digit() {
                return false;
            }
            if c == b'-' {
                if hyphen or i == 0 or i == n - 1 or not b[i - 1].is_ascii_lowercase() or not b[i + 1].is_ascii_lowercase() {
                    return false;
                }
                hyphen = true;
            }
            if (c == b'!' or c == b'.' or c == b',') and i != n - 1 {
                return false;
            }
        }
        true
    }
}

fn solution_count_valid_words(sentence: Str) -> i64 {
    Solution.count_valid_words(sentence.to_string())
}

// ---- the statement read literally

fn is_lower(c: char) -> bool {
    c >= 'a' and c <= 'z'
}

fn literal_valid(t: Vec[char]) -> bool {
    let n = t.len();
    // only lowercase letters, hyphens and punctuation marks
    for c in t.iter() {
        if not (is_lower(c) or c == '-' or c == '!' or c == '.' or c == ',') {
            return false;
        }
    }
    // at most one hyphen, with a lowercase letter either side
    let hyphens: Vec[i64] = (0..n).filter(|i| t[i] == '-').collect();
    if hyphens.len() > 1 {
        return false;
    }
    if hyphens.len() == 1 {
        let p = hyphens[0];
        if p == 0 or p == n - 1 or not is_lower(t[p - 1]) or not is_lower(t[p + 1]) {
            return false;
        }
    }
    // at most one mark, at the end
    let marks: Vec[i64] = (0..n).filter(|i| t[i] == '!' or t[i] == '.' or t[i] == ',').collect();
    if marks.len() > 1 {
        return false;
    }
    marks.len() == 0 or marks[0] == n - 1
}

fn tokens(s: Str) -> Vec[Vec[char]] {
    let mut out: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in s.chars() {
        if c == ' ' {
            if not cur.is_empty() {
                out.push(cur);
                cur = Vec.new();
            }
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn literal(s: Str) -> i64 {
    let mut count = 0;
    for t in tokens(s).into_iter() {
        if literal_valid(t) {
            count += 1;
        }
    }
    count
}

fn answer(arm: i64, s: Str) -> i64 {
    match arm {
        0 => star_count_valid_words(s),
        1 => scan_count_valid_words(s),
        2 => counts_count_valid_words(s),
        3 => iter_count_valid_words(s),
        4 => regex_count_valid_words(s),
        _ => solution_count_valid_words(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn draw(seed: mut ref i64) -> String {
    let symbols: Vec[char] = "abc-!.,09".chars().collect();
    let len = next_random(mut seed) % 31;
    let mut s = String.new();
    for _ in 0..len {
        let r = next_random(mut seed) % 100;
        if r < 50 {
            s.push(symbols[next_random(mut seed) % 3]);
        } else if r < 70 {
            s.push(' ');
        } else {
            s.push(symbols[next_random(mut seed) % symbols.len()]);
        }
    }
    s
}

fn spaced(s: Str) -> String {
    let mut out = String.from(" ");
    for c in s.chars() {
        out.push(c);
        if c == ' ' {
            out.push(' ');
        }
    }
    out.push_str("  ");
    out
}

fn reversed(s: Str) -> String {
    let words: Vec[String] = tokens(s).iter().rev().map(|t| t.iter().collect()).collect();
    words.join(" ")
}

fn swapped(s: Str) -> String {
    s.chars().map(|c| if c == 'a' { 'c' } else if c == 'c' { 'a' } else { c }).collect()
}

fn main() {
    let names = ["star", "scan", "counts", "iter", "regex", "solution"];
    let mut seed = 2047;
    let mut problems: Vec[String] = Vec.new();
    for _ in 0..1500 {
        problems.push(draw(mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for p in 0..problems.len() {
        let s = problems[p].as_str();
        let truth = literal(s);
        check = (check * 31 + truth) % 1000000007;
        let wide = spaced(s);
        let back = reversed(s);
        let twice = f"{s} {s}";
        let other = swapped(s);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, wide) == x,
                answer(arm, back) == x,
                answer(arm, twice) == 2 * x,
                answer(arm, other) == x,
                same >= 3,
            ];
            for k in 0..6 {
                checks += 1;
                if not verdicts[k] {
                    by_property[k] += 1;
                    if failures.len() < 10 {
                        failures.push(f"sentence {p} arm {names[arm]}: P{k + 1} fails, answer {x}, literal {truth}, \"{s}\"");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"1500 sentences: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for k in 0..6 {
            if by_property[k] > 0 {
                println(f"P{k + 1} {by_property[k]}");
            }
        }
    }
}
