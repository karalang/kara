// LeetCode #2038: Remove Colored Pieces if Both Neighbors are the Same
// Color -- the ★ arm as a benchmark. 4 rows of 100000 pieces (the most the constraints allow) built once; 100
// rounds, each flipping one piece of every row and handing the row to the
// ★ arm as a fresh string: 400 calls, each over 100000 pieces.

fn winner_of_game(colors: String) -> bool {
    let c: Vec[char] = colors.chars().collect();
    let mut (alice, bob) = (0, 0);
    for i in 1..c.len() - 1 {
        if c[i - 1] == c[i] and c[i] == c[i + 1] {
            if c[i] == 'A' {
                alice += 1;
            } else {
                bob += 1;
            }
        }
    }
    alice > bob
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2038;
    let mut rows: Vec[Vec[char]] = Vec.new();
    for r in 0..4 {
        let stay = [2, 3, 50, 1000][r];
        let mut c = if next_random(mut seed) % 2 == 0 { 'A' } else { 'B' };
        let mut row: Vec[char] = Vec.new();
        for _ in 0..100000 {
            if next_random(mut seed) % stay == 0 {
                c = if c == 'A' { 'B' } else { 'A' };
            }
            row.push(c);
        }
        rows.push(row);
    }
    let mut calls = 0;
    let mut wins = 0;
    let mut check = 0;
    for round in 0..100 {
        for r in 0..4 {
            let at = (round * 7919 + r * 104729) % 100000;
            rows[r][at] = if rows[r][at] == 'A' { 'B' } else { 'A' };
            let colors: String = rows[r].iter().collect();
            let bit = if winner_of_game(colors) { 1 } else { 0 };
            calls += 1;
            wins += bit;
            check = (check * 3 + bit + 1) % 1000000007;
        }
    }
    println(f"{calls} calls: Alice wins {wins}, checksum {check}");
}
