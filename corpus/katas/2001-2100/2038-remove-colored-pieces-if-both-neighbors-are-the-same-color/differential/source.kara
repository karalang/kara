// LeetCode #2038: Remove Colored Pieces if Both Neighbors are the Same
// Color -- the differential. The six arms, against the statement read
// literally: the game played out, every move tried, the player to move
// winning when some move leaves the other losing. 1500 rows of 1 to 10
// pieces, each with a place to double an `A`, every one drawn before any
// arm answers.
//
// P1  the answer is the game played out
// P2  the row reversed leaves the answer
// P3  Alice never wins both the row and the row with its colors swapped
// P4  an `A` doubled never turns Alice's win into a loss
// P5  every run cut to two pieces leaves Alice no move: she loses
// P6  each arm agrees with at least three of the other five

// ---- colors.kara: the ★ arm, each player's moves counted over the chars
fn star_winner_of_game(colors: String) -> bool {
    let c: Vec[char] = colors.chars().collect();
    let mut (alice, bob) = (0, 0);
    for i in 1..c.len() - 1 {
        if c[i - 1] == c[i] and c[i] == c[i + 1] {
            if c[i] == 'A' {
                alice += 1;
            } else {
                bob += 1;
            }
        }
    }
    alice > bob
}

// ---- colors_windows.kara: every window of three, counted per color
fn windows_winner_of_game(colors: String) -> bool {
    let c: Vec[char] = colors.chars().collect();
    let triples = c.windows(3);
    let moves = |color: char| triples.iter().filter(|w| w.iter().all(|x| x == color)).count();
    moves('A') > moves('B')
}

// ---- colors_runs.kara: run lengths, len - 2 moves a run
fn runs_winner_of_game(colors: String) -> bool {
    let c: Vec[char] = colors.chars().collect();
    let mut alice = 0;
    let mut bob = 0;
    for run in c.chunk_by(|a, b| a == b) {
        let moves = (run.len() - 2).max(0);
        if run[0] == 'A' {
            alice += moves;
        } else {
            bob += moves;
        }
    }
    alice > bob
}

// ---- colors_bytes.kara: one balance over the bytes
fn bytes_winner_of_game(colors: String) -> bool {
    let b = colors.bytes();
    let mut balance = 0;
    for i in 2..b.len() {
        if b[i - 2] == b[i - 1] and b[i - 1] == b[i] {
            balance += if b[i] == b'A' { 1 } else { -1 };
        }
    }
    balance > 0
}

// ---- colors_fold.kara: one fold carrying the two pieces before
fn fold_winner_of_game(colors: String) -> bool {
    let (_, _, alice, bob) = colors.chars().fold((None, None, 0, 0), |(before, last, alice, bob), c| {
        let triple = before == Some(c) and last == Some(c);
        let a = if triple and c == 'A' { alice + 1 } else { alice };
        let b = if triple and c == 'B' { bob + 1 } else { bob };
        (last, Some(c), a, b)
    });
    alice > bob
}

// ---- colors_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn solution_winner_of_game(colors: String) -> bool {
        let b = colors.bytes();
        let mut (alice, bob) = (0, 0);
        for i in 1..b.len().saturating_sub(1) {
            if b[i - 1] == b[i] and b[i] == b[i + 1] {
                if b[i] == b'A' {
                    alice += 1;
                } else {
                    bob += 1;
                }
            }
        }
        alice > bob
    }
}

struct Solution {}

fn solution_winner_of_game(colors: String) -> bool {
    Solution.solution_winner_of_game(colors)
}

// ---- the statement read literally

// whether the player to move (`turn`, 'A' or 'B') wins from `row`
fn plays_to_win(row: String, turn: char, seen: mut ref Map[String, bool]) -> bool {
    let key = f"{turn}{row}";
    if let Some(known) = seen.get(key) {
        return known;
    }
    let c: Vec[char] = row.chars().collect();
    let other = if turn == 'A' { 'B' } else { 'A' };
    let mut wins = false;
    for i in 1..c.len() - 1 {
        if not wins and c[i] == turn and c[i - 1] == turn and c[i + 1] == turn {
            let mut rest = c.clone();
            rest.remove(i);
            let next: String = rest.iter().collect();
            if not plays_to_win(next, other, mut seen) {
                wins = true;
            }
        }
    }
    seen.insert(key, wins);
    wins
}

fn literal(row: String) -> bool {
    let mut seen: Map[String, bool] = Map.new();
    plays_to_win(row.clone(), 'A', mut seen)
}

fn answer(arm: i64, row: String) -> bool {
    let r = row.clone();
    match arm {
        0 => star_winner_of_game(r),
        1 => windows_winner_of_game(r),
        2 => runs_winner_of_game(r),
        3 => bytes_winner_of_game(r),
        4 => fold_winner_of_game(r),
        _ => solution_winner_of_game(r),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Problem {
    row: String,
    doubled: String,
}

fn draw(seed: mut ref i64) -> Problem {
    let n = next_random(mut seed) % 10 + 1;
    let stay = next_random(mut seed) % 4 + 1;
    let mut c = if next_random(mut seed) % 2 == 0 { 'A' } else { 'B' };
    let mut pieces: Vec[char] = Vec.new();
    for _ in 0..n {
        if next_random(mut seed) % stay == 0 {
            c = if c == 'A' { 'B' } else { 'A' };
        }
        pieces.push(c);
    }
    // an `A` doubled where one is, or one added at the end if none is
    let a_at: Vec[i64] = (0..n).filter(|i| pieces[i] == 'A').collect();
    let mut more = pieces.clone();
    if a_at.is_empty() {
        more.push('A');
    } else {
        let i = a_at[next_random(mut seed) % a_at.len()];
        more.insert(i, 'A');
    }
    Problem { row: pieces.iter().collect(), doubled: more.iter().collect() }
}

fn main() {
    let names = ["star", "windows", "runs", "bytes", "fold", "solution"];
    let mut seed = 2038;
    let mut problems: Vec[Problem] = Vec.new();
    for _ in 0..1500 {
        problems.push(draw(mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for p in 0..problems.len() {
        let prob = ref problems[p];
        let truth = literal(prob.row);
        check = (check * 3 + if truth { 2 } else { 1 }) % 1000000007;
        let reversed: String = prob.row.chars().rev().collect();
        let swapped: String = prob.row.chars().map(|c| if c == 'A' { 'B' } else { 'A' }).collect();
        let mut cut: Vec[char] = Vec.new();
        for c in prob.row.chars() {
            let n = cut.len();
            if not (n >= 2 and cut[n - 1] == c and cut[n - 2] == c) {
                cut.push(c);
            }
        }
        let cut: String = cut.iter().collect();
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, prob.row)).collect();
        for arm in 0..6 {
            let a = got[arm];
            let mut same = 0;
            for other in 0..6 {
                if other != arm and got[other] == a {
                    same += 1;
                }
            }
            let verdicts = [
                a == truth,
                answer(arm, reversed) == a,
                not (a and answer(arm, swapped)),
                not a or answer(arm, prob.doubled),
                not answer(arm, cut),
                same >= 3,
            ];
            for k in 0..6 {
                checks += 1;
                if not verdicts[k] {
                    by_property[k] += 1;
                    if failures.len() < 10 {
                        failures.push(f"row {p} arm {names[arm]}: P{k + 1} fails, answer {a}, played out {truth}, row {prob.row}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"1500 rows: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for k in 0..6 {
            if by_property[k] > 0 {
                println(f"P{k + 1} {by_property[k]}");
            }
        }
    }
}
