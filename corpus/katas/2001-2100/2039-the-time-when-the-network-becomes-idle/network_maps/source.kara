// LeetCode #2039: The Time When the Network Becomes Idle -- maps. The
// neighbours kept in a `Map` from server to `Vec`, filled through
// `entry(..).or_insert(..)`, the hop counts in a second `Map`, and the
// answer folded over the servers' patience. O(n + edges) expected.

fn network_becomes_idle(edges: Vec[Vec[i64]], patience: Vec[i64]) -> i64 {
    let mut adjacent: Map[i64, Vec[i64]] = Map.new();
    for e in edges.iter() {
        adjacent.entry(e[0]).or_insert(Vec.new()).push(e[1]);
        adjacent.entry(e[1]).or_insert(Vec.new()).push(e[0]);
    }
    let mut hops: Map[i64, i64] = Map.new();
    hops.insert(0, 0);
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(0);
    while let Some(u) = queue.pop_front() {
        let d = hops[u];
        for v in adjacent[u].iter() {
            if not hops.contains_key(v) {
                hops.insert(v, d + 1);
                queue.push_back(v);
            }
        }
    }
    patience.iter().enumerate().skip(1).fold(0, |idle, (i, p)| {
        let round_trip = 2 * hops[i];
        idle.max((round_trip - 1) / p * p + round_trip + 1)
    })
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// a connected network of `n` servers: a random tree, each server joined to
// one of the `reach` before it, then `extra` more edges between distinct
// servers not yet joined; patience up to `top`
fn random_network(n: i64, reach: i64, extra: i64, top: i64, seed: mut ref i64) -> (Vec[Vec[i64]], Vec[i64]) {
    let mut edges: Vec[Vec[i64]] = Vec.new();
    let mut joined: Set[(i64, i64)] = Set.new();
    for v in 1..n {
        let u = v - 1 - (next_random(mut seed) * 32768 + next_random(mut seed)) % reach.min(v);
        edges.push([u, v].to_vec());
        joined.insert((u, v));
    }
    let mut tries = 0;
    while edges.len() < n - 1 + extra and tries < 4 * extra {
        tries += 1;
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let (u, v) = (a.min(b), a.max(b));
        if u != v and not joined.contains((u, v)) {
            joined.insert((u, v));
            edges.push([u, v].to_vec());
        }
    }
    let mut patience = [0].to_vec();
    for _ in 1..n {
        patience.push(next_random(mut seed) % top + 1);
    }
    (edges, patience)
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[(Vec[Vec[i64]], Vec[i64])] = [
        ([[0, 1].to_vec(), [1, 2].to_vec()].to_vec(), [0, 2, 1].to_vec()),
        ([[0, 1].to_vec(), [0, 2].to_vec(), [1, 2].to_vec()].to_vec(), [0, 10, 10].to_vec()),
        ([[0, 1].to_vec()].to_vec(), [0, 1].to_vec()),
        ([[0, 1].to_vec()].to_vec(), [0, 5].to_vec()),
        ([[0, 1].to_vec(), [1, 2].to_vec(), [2, 3].to_vec(), [3, 4].to_vec()].to_vec(), [0, 1, 3, 7, 100000].to_vec()),
        ([[3, 0].to_vec(), [2, 3].to_vec(), [1, 2].to_vec(), [0, 1].to_vec()].to_vec(), [0, 4, 3, 2].to_vec()),
    ].to_vec();
    for (edges, patience) in examples.into_iter() {
        let shown = f"{edges} {patience}";
        println(f"{shown} -> {network_becomes_idle(edges, patience)}");
    }
    // 2000 networks of 2 to 12 servers
    let mut seed = 2039;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 11 + 2;
        let extra = next_random(mut seed) % (n + 1);
        let top = next_random(mut seed) % 10 + 1;
        let (edges, patience) = random_network(n, n, extra, top, mut seed);
        let answer = network_becomes_idle(edges, patience);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 networks of up to 12 servers: sum {sum}, checksum {check}");
    // 4 networks of 100000 servers and 100000 edges, the most the constraints allow
    sum = 0;
    check = 0;
    for r in 0..4 {
        let top = [100000, 3, 1000, 1][r];
        let reach = [100000, 2, 50, 1][r];
        let (edges, patience) = random_network(100000, reach, 1, top, mut seed);
        let answer = network_becomes_idle(edges, patience);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 networks of 100000 servers: sum {sum}, checksum {check}");
}
