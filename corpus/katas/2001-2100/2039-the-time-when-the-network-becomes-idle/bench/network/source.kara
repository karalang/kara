// LeetCode #2039: The Time When the Network Becomes Idle -- the ★ arm as a
// benchmark. 4 networks of 100000 servers and 100000 edges (the most the
// constraints allow; a random tree, a chain of short branches, a bushier
// one and a path) built once; 25 rounds, each changing one server's
// patience in every network before the ★ arm answers it: 100 calls, each
// building the adjacency and searching all 100000 servers.

fn network_becomes_idle(edges: Vec[Vec[i64]], patience: Vec[i64]) -> i64 {
    let n = patience.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut hops: Vec[i64] = Vec.filled(n, -1);
    hops[0] = 0;
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(0);
    while let Some(u) = queue.pop_front() {
        for v in adjacent[u].iter() {
            if hops[v] == -1 {
                hops[v] = hops[u] + 1;
                queue.push_back(v);
            }
        }
    }
    let mut idle = 0;
    for i in 1..n {
        let round_trip = 2 * hops[i];
        let last_sent = (round_trip - 1) / patience[i] * patience[i];
        idle = idle.max(last_sent + round_trip + 1);
    }
    idle
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a connected network of `n` servers: a random tree, each server joined to
// one of the `reach` before it, then `extra` more edges between distinct
// servers not yet joined; patience up to `top`
fn random_network(n: i64, reach: i64, extra: i64, top: i64, seed: mut ref i64) -> (Vec[Vec[i64]], Vec[i64]) {
    let mut edges: Vec[Vec[i64]] = Vec.new();
    let mut joined: Set[(i64, i64)] = Set.new();
    for v in 1..n {
        let u = v - 1 - (next_random(mut seed) * 32768 + next_random(mut seed)) % reach.min(v);
        edges.push([u, v].to_vec());
        joined.insert((u, v));
    }
    let mut tries = 0;
    while edges.len() < n - 1 + extra and tries < 4 * extra {
        tries += 1;
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let (u, v) = (a.min(b), a.max(b));
        if u != v and not joined.contains((u, v)) {
            joined.insert((u, v));
            edges.push([u, v].to_vec());
        }
    }
    let mut patience = [0].to_vec();
    for _ in 1..n {
        patience.push(next_random(mut seed) % top + 1);
    }
    (edges, patience)
}

fn main() {
    let mut seed = 2039;
    let mut networks: Vec[(Vec[Vec[i64]], Vec[i64])] = Vec.new();
    for r in 0..4 {
        let top = [100000, 3, 1000, 1][r];
        let reach = [100000, 2, 50, 1][r];
        networks.push(random_network(100000, reach, 1, top, mut seed));
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for round in 0..25 {
        for r in 0..4 {
            let at = (round * 7919 + r * 104729) % 99999 + 1;
            networks[r].1[at] = networks[r].1[at] % 7 + 1;
            let answer = network_becomes_idle(networks[r].0, networks[r].1);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
