// LeetCode #2008: Maximum Earnings From Taxi -- the sorted-map arm. The
// rides sorted by where they end; a `SortedMap` from each end reached to
// the best earnings by then, kept increasing, so the best on reaching a
// ride's start is the last entry at or before it, found with
// `range_inclusive` and `next_back`. O(m log m).

fn max_taxi_earnings(n: i64, rides: Vec[(i64, i64, i64)]) -> i64 {
    let mut by_end = rides.clone();
    by_end.sort_by_key(|(_, end, _)| end);
    let mut best: SortedMap[i64, i64] = SortedMap.new();
    best.insert(0, 0);
    let mut top = 0;
    for (start, end, tip) in by_end {
        let before = match best.range_inclusive(0, start).next_back() {
            Some((_, b)) => b,
            None => 0,
        };
        let total = before + end - start + tip;
        if total > top {
            top = total;
            best.insert(end, top);
        }
    }
    top
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// `m` rides on a road of `n` points, each at most `span` long, tips up to `tip`
fn random_rides(n: i64, m: i64, span: i64, tip: i64, seed: mut ref i64) -> Vec[(i64, i64, i64)] {
    let mut rides: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..m {
        let length = next_random(mut seed) % span.min(n - 1) + 1;
        let start = next_random(mut seed) % (n - length) + 1;
        rides.push((start, start + length, next_random(mut seed) % (tip + 1)));
    }
    rides
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[(i64, Vec[(i64, i64, i64)])] = [
        (5, [(2, 5, 4), (1, 5, 1)]),
        (20, [(1, 6, 1), (3, 10, 2), (10, 12, 3), (11, 12, 2), (12, 15, 2), (13, 18, 1)]),
        (2, [(1, 2, 0)]),
        (10, [(1, 10, 0), (1, 5, 3), (5, 10, 3)]),
        (10, [(2, 3, 5), (2, 3, 7), (3, 4, 0)]),
        (6, [(1, 3, 0), (3, 6, 0), (1, 6, 1)]),
    ];
    for (n, rides) in examples.iter() {
        println(f"n = {n} {rides} -> {max_taxi_earnings(n, rides)}");
    }
    let mut seed = 2008;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 15 + 2;
        let m = next_random(mut seed) % 8 + 1;
        let span = next_random(mut seed) % 6 + 1;
        let tip = next_random(mut seed) % 5;
        let answer = max_taxi_earnings(n, random_rides(n, m, span, tip, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 roads of 2 to 16 points: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for a in 0..6 {
        let n = [1000, 100000][a % 2];
        let span = [3, 50, 1000][a % 3];
        let answer = max_taxi_earnings(n, random_rides(n, 30000, span, 100000, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"6 roads of 30000 rides: sum {sum}, checksum {check}");
}
