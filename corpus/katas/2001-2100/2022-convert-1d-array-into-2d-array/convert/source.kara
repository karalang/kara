// LeetCode #2022: Convert 1D Array Into 2D Array -- the ★ arm. The array
// fills an `m` by `n` grid exactly when it holds `m * n` values; then row
// `i` is the run `original[i * n..(i + 1) * n]`. O(m n).

fn construct_2d_array(original: Vec[i64], m: i64, n: i64) -> Vec[Vec[i64]] {
    if original.len() != m * n {
        return Vec.new();
    }
    (0..m).map(|i| original[i * n..(i + 1) * n].to_vec()).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], i64, i64)] = [
        ([1, 2, 3, 4], 2, 2),
        ([1, 2, 3], 1, 3),
        ([1, 2], 1, 1),
        ([3], 1, 1),
        ([1, 2, 3, 4, 5, 6], 3, 2),
        ([1, 2, 3, 4, 5, 6], 2, 3),
        ([1, 2, 3, 4, 5, 6], 6, 1),
        ([1, 2, 3, 4, 5, 6], 4, 2),
    ];
    for (original, m, n) in examples {
        println(f"{original}, {m}, {n} -> {construct_2d_array(original, m, n)}");
    }
    // the grids, each row read as a number in base 100003, folded into a
    // checksum; an empty answer counts as -1
    let mut seed = 2022;
    let mut built = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let len = next_random(mut seed) % 24 + 1;
        let original: Vec[i64] = (0..len).map(|_| next_random(mut seed) % 100000 + 1).collect();
        let m = next_random(mut seed) % 8 + 1;
        // half the time a shape that fits, when one with `m` rows does
        let n = if next_random(mut seed) % 2 == 0 and len % m == 0 { len / m } else { next_random(mut seed) % 8 + 1 };
        let grid = construct_2d_array(original, m, n);
        if grid.is_empty() {
            check = (check * 31 + 1000000006) % 1000000007;
        } else {
            built += 1;
            for row in grid.iter() {
                let value = row.iter().fold(0, |acc, v| (acc * 100003 + v) % 1000000007);
                check = (check * 31 + value) % 1000000007;
            }
        }
    }
    println(f"3000 arrays of up to 24 values: {built} built, checksum {check}");
    built = 0;
    check = 0;
    for a in 0..5 {
        let m = [1, 50000, 200, 317, 1000][a];
        let n = [50000, 1, 250, 157, 49][a];
        let len = [50000, 50000, 50000, 49769, 50000][a];
        let original: Vec[i64] = (0..len).map(|_| next_random(mut seed) % 100000 + 1).collect();
        let grid = construct_2d_array(original, m, n);
        if grid.is_empty() {
            check = (check * 31 + 1000000006) % 1000000007;
        } else {
            built += 1;
            for row in grid.iter() {
                let value = row.iter().fold(0, |acc, v| (acc * 100003 + v) % 1000000007);
                check = (check * 31 + value) % 1000000007;
            }
        }
    }
    println(f"5 arrays of up to 50000 values: {built} built, checksum {check}");
}
