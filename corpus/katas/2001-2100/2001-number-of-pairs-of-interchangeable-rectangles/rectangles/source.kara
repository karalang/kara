// LeetCode #2001: Number of Pairs of Interchangeable Rectangles -- the ★ arm.
// Two rectangles are interchangeable when w1 / h1 == w2 / h2. Each ratio is
// reduced by the gcd of its sides to a key that names it exactly, and every
// rectangle pairs with each one already counted under its key.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn interchangeable(rectangles: Vec[(i64, i64)]) -> i64 {
    let mut seen: Map[(i64, i64), i64] = Map.new();
    let mut pairs = 0;
    for (w, h) in rectangles {
        let g = gcd(w, h);
        let key = (w / g, h / g);
        let before = seen.get(key).unwrap_or(0);
        pairs += before;
        seen.insert(key, before + 1);
    }
    pairs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` rectangles: each a multiple of one of `shapes` base ratios with sides
// up to `side`, or (when `shapes` is 0) sides drawn freely up to `side`.
fn random_rectangles(n: i64, shapes: i64, side: i64, seed: mut ref i64) -> Vec[(i64, i64)] {
    let mut bases: Vec[(i64, i64)] = Vec.new();
    for _ in 0..shapes {
        bases.push((next_random(mut seed) % 9 + 1, next_random(mut seed) % 9 + 1));
    }
    let mut rects: Vec[(i64, i64)] = Vec.new();
    for _ in 0..n {
        if shapes == 0 {
            rects.push((next_random(mut seed) % side + 1, next_random(mut seed) % side + 1));
        } else {
            let (w, h) = bases[next_random(mut seed) % shapes];
            let m = next_random(mut seed) % (side / w.max(h)) + 1;
            rects.push((w * m, h * m));
        }
    }
    rects
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer % 1000003) % 1000000007
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[Vec[(i64, i64)]] = [
        [(4, 8), (3, 6), (10, 20), (15, 30)],
        [(4, 5), (7, 8)],
        [(1, 1)],
        [(2, 3), (3, 2)],
        [(1, 2), (2, 4), (3, 6), (4, 7)],
        [(6, 4), (9, 6), (3, 2), (12, 8), (5, 5), (7, 7)],
        [(100000, 99999), (99999, 100000), (100000, 100000)],
        [(100000, 1), (1, 100000), (100000, 1)],
    ];
    for rects in examples.iter() {
        println(f"{rects} -> {interchangeable(rects)}");
    }
    let mut seed = 2001;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 20 + 1;
        let side = next_random(mut seed) % 6 + 1;
        let rects = random_rectangles(n, 0, side, mut seed);
        let answer = interchangeable(rects);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 sets of 1 to 20 small rectangles: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let shapes = next_random(mut seed) % 5 + 1;
        let rects = random_rectangles(n, shapes, 60, mut seed);
        let answer = interchangeable(rects);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 sets of 1 to 40 rectangles of 1 to 5 shapes: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for shapes in [0, 3, 20, 80, 0, 50] {
        let side = if shapes == 0 { 100000 } else { 30000 };
        let rects = random_rectangles(20000, shapes, side, mut seed);
        let answer = interchangeable(rects);
        sum += answer;
        check = mix(check, answer);
    }
    println(f"6 sets of 20000 rectangles: sum {sum}, checksum {check}");
    let mut same: Vec[(i64, i64)] = Vec.new();
    for i in 0..100000 {
        same.push((7 * (i % 1000 + 1), 3 * (i % 1000 + 1)));
    }
    println(f"100000 rectangles of one shape: {interchangeable(same)}");
}
