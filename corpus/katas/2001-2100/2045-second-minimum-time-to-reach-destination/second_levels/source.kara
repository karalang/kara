// LeetCode #2045: Second Minimum Time to Reach Destination -- level by
// level. The frontier at level `k` holds the vertices some walk of exactly
// `k` edges reaches for the first or second distinct time; a vertex joins
// at most twice, so each level is cheap. The second level that holds `n`
// is the second smallest walk length. O(n + edges).

fn travel(steps: i64, time: i64, change: i64) -> i64 {
    let mut t = 0;
    for _ in 0..steps {
        if t / change % 2 == 1 {
            t = (t / change + 1) * change;
        }
        t += time;
    }
    t
}

fn second_minimum(n: i64, edges: Vec[Vec[i64]], time: i64, change: i64) -> i64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut visits: Vec[i64] = Vec.filled(n + 1, 0);
    let mut last_level: Vec[i64] = Vec.filled(n + 1, -1);
    visits[1] = 1;
    last_level[1] = 0;
    let mut frontier: Vec[i64] = [1].to_vec();
    let mut level = 0;
    loop {
        level += 1;
        let mut next: Vec[i64] = Vec.new();
        for u in frontier.iter() {
            for v in adjacent[u].iter() {
                if visits[v] < 2 and last_level[v] != level {
                    visits[v] += 1;
                    last_level[v] = level;
                    next.push(v);
                }
            }
        }
        if last_level[n] == level and visits[n] == 2 {
            return travel(level, time, change);
        }
        frontier = next;
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a connected graph on 1..=n: a random tree whose vertex `v` hangs from one
// of the `reach` before it, then `extra` more edges, none repeated
fn graph(n: i64, reach: i64, extra: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut edges: Vec[Vec[i64]] = Vec.new();
    let mut seen: Set[i64] = Set.new();
    for v in 2..n + 1 {
        let u = v - 1 - next_random(mut seed) % reach.min(v - 1);
        edges.push([u, v].to_vec());
        seen.insert(u * (n + 1) + v);
    }
    let mut tries = 0;
    while edges.len() < n - 1 + extra and tries < 4 * extra {
        tries += 1;
        let a = next_random(mut seed) % n + 1;
        let b = next_random(mut seed) % n + 1;
        let (u, v) = (a.min(b), a.max(b));
        if u != v and not seen.contains(u * (n + 1) + v) {
            seen.insert(u * (n + 1) + v);
            edges.push([u, v].to_vec());
        }
    }
    edges
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[(i64, Vec[Vec[i64]], i64, i64)] = [
        (5, [[1, 2].to_vec(), [1, 3].to_vec(), [1, 4].to_vec(), [3, 4].to_vec(), [4, 5].to_vec()].to_vec(), 3, 5),
        (2, [[1, 2].to_vec()].to_vec(), 3, 2),
        (3, [[1, 2].to_vec(), [2, 3].to_vec(), [1, 3].to_vec()].to_vec(), 1, 1),
        (4, [[1, 2].to_vec(), [2, 3].to_vec(), [3, 4].to_vec()].to_vec(), 1000, 1),
        (4, [[1, 2].to_vec(), [2, 3].to_vec(), [3, 4].to_vec()].to_vec(), 1, 1000),
        (3, [[1, 2].to_vec(), [1, 3].to_vec()].to_vec(), 2, 3),
    ].to_vec();
    for (n, edges, time, change) in examples.into_iter() {
        let shown = f"{n} {edges} {time} {change}";
        println(f"{shown} -> {second_minimum(n, edges, time, change)}");
    }
    // 2000 graphs of 2 to 10 vertices, a tree and up to n more edges
    let mut seed = 2045;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 9 + 2;
        let reach = next_random(mut seed) % n + 1;
        let extra = next_random(mut seed) % (n + 1);
        let edges = graph(n, reach, extra, mut seed);
        let time = next_random(mut seed) % 10 + 1;
        let change = next_random(mut seed) % 10 + 1;
        let answer = second_minimum(n, edges, time, change);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"2000 small graphs: sum {sum}, checksum {check}");
    // 4 graphs of 10000 vertices and 20000 edges, the most the constraints
    // allow: a random tree, a bushy one, a chain of short branches and a path
    sum = 0;
    check = 0;
    for r in 0..4 {
        let reach = [10000, 3, 2, 1][r];
        let edges = graph(10000, reach, 10001, mut seed);
        let time = [1000, 7, 1, 1000][r];
        let change = [1000, 3, 1000, 1][r];
        let answer = second_minimum(10000, edges, time, change);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"4 large graphs: sum {sum}, checksum {check}");
}
