// LeetCode #2045: Second Minimum Time to Reach Destination -- the ★ arm as
// a benchmark. 4 graphs of 10000 vertices and 20000 edges (the most the
// constraints allow: a random tree, a bushy one, a chain of short branches
// and a path, each with 10001 more edges) built once; then 250 rounds, each
// answering every graph with a time and a change of its own: 1000 calls.

fn travel(steps: i64, time: i64, change: i64) -> i64 {
    let mut t = 0;
    for _ in 0..steps {
        // a red light (an odd period) holds us to the next green
        if t / change % 2 == 1 {
            t = (t / change + 1) * change;
        }
        t += time;
    }
    t
}

fn second_minimum(n: i64, edges: Vec[Vec[i64]], time: i64, change: i64) -> i64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut first: Vec[i64] = Vec.filled(n + 1, -1);
    let mut second: Vec[i64] = Vec.filled(n + 1, -1);
    first[1] = 0;
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    queue.push_back((1, 0));
    while let Some((u, d)) = queue.pop_front() {
        for v in adjacent[u].iter() {
            if first[v] == -1 {
                first[v] = d + 1;
                queue.push_back((v, d + 1));
            } else if second[v] == -1 and first[v] < d + 1 {
                second[v] = d + 1;
                queue.push_back((v, d + 1));
            }
        }
    }
    travel(second[n], time, change)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a connected graph on 1..=n: a random tree whose vertex `v` hangs from one
// of the `reach` before it, then `extra` more edges, none repeated
fn graph(n: i64, reach: i64, extra: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut edges: Vec[Vec[i64]] = Vec.new();
    let mut seen: Set[i64] = Set.new();
    for v in 2..n + 1 {
        let u = v - 1 - next_random(mut seed) % reach.min(v - 1);
        edges.push([u, v].to_vec());
        seen.insert(u * (n + 1) + v);
    }
    let mut tries = 0;
    while edges.len() < n - 1 + extra and tries < 4 * extra {
        tries += 1;
        let a = next_random(mut seed) % n + 1;
        let b = next_random(mut seed) % n + 1;
        let (u, v) = (a.min(b), a.max(b));
        if u != v and not seen.contains(u * (n + 1) + v) {
            seen.insert(u * (n + 1) + v);
            edges.push([u, v].to_vec());
        }
    }
    edges
}

fn main() {
    let mut seed = 2045;
    let mut graphs: Vec[Vec[Vec[i64]]] = Vec.new();
    for r in 0..4 {
        let reach = [10000, 3, 2, 1][r];
        graphs.push(graph(10000, reach, 10001, mut seed));
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for round in 0..250 {
        for r in 0..4 {
            let time = (round * 7 + r) % 1000 + 1;
            let change = (round * 13 + r * 5) % 1000 + 1;
            let answer = second_minimum(10000, graphs[r], time, change);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
