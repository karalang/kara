// LeetCode #2021: Brightest Position on Street -- the ★ arm's benchmark. Two
// events per lamp, sorted; a sweep applies every event at a position before
// reading the brightness there.

fn brightest_position(lights: Vec[(i64, i64)]) -> i64 {
    let mut events: Vec[(i64, i64)] = Vec.new();
    for (position, range) in lights.iter() {
        events.push((position - range, 1));
        events.push((position + range + 1, -1));
    }
    events.sort();
    let mut brightness = 0;
    let mut best = 0;
    let mut answer = 0;
    let mut i = 0;
    while i < events.len() {
        let at = events[i].0;
        while i < events.len() and events[i].0 == at {
            brightness += events[i].1;
            i += 1;
        }
        if brightness > best {
            best = brightness;
            answer = at;
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 streets of 10000 lamps, built once, each lamp at a position within
    // 10^6 to 10^8 of 0 and a range up to 10^3 to 10^6; the ★ arm on each for
    // 5 rounds
    let mut seed = 2021;
    let mut streets: Vec[Vec[(i64, i64)]] = Vec.new();
    for s in 0..100 {
        let spread = [1000000, 10000000, 100000000][s % 3];
        let reach = [1000, 100000, 1000000][s % 3];
        let mut lights: Vec[(i64, i64)] = Vec.new();
        for _ in 0..10000 {
            let position = (next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * spread + 1) - spread;
            lights.push((position, next_random(mut seed) % (reach + 1)));
        }
        streets.push(lights);
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..5 {
        for lights in streets.iter() {
            let answer = brightest_position(lights);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer + 1000000000) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
