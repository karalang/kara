// LeetCode #2021: Brightest Position on Street -- the differential.
//
// All six arms against the statement read literally, on 1500 problems, with
// six properties. A problem is 1 to 10 lamps at positions from -1-20 to
// 1-20 with ranges from 0 to 0-7.
//
// P1  the answer is the statement read literally: every position from the
//     leftmost lit one to the rightmost, the lamps covering it counted, the
//     smallest of the brightest
// P2  the lamps listed in reverse order leave the answer
// P3  every lamp moved by the same distance moves the answer by it
// P4  every lamp listed twice leaves the answer
// P5  a lamp of range 0 added at the answer leaves the answer
// P6  each arm agrees with at least three of the other five

// ---- the ★ arm: two events per lamp, sorted, swept
fn star_brightest_position(lights: Vec[(i64, i64)]) -> i64 {
    let mut events: Vec[(i64, i64)] = Vec.new();
    for (position, range) in lights.iter() {
        events.push((position - range, 1));
        events.push((position + range + 1, -1));
    }
    events.sort();
    let mut brightness = 0;
    let mut best = 0;
    let mut answer = 0;
    let mut i = 0;
    while i < events.len() {
        let at = events[i].0;
        while i < events.len() and events[i].0 == at {
            brightness += events[i].1;
            i += 1;
        }
        if brightness > best {
            best = brightness;
            answer = at;
        }
    }
    answer
}

// ---- brightest_map.kara: a SortedMap of changes
fn map_brightest_position(lights: Vec[(i64, i64)]) -> i64 {
    let mut change: SortedMap[i64, i64] = SortedMap.new();
    for (position, range) in lights.iter() {
        *change.entry(position - range).or_insert(0) += 1;
        *change.entry(position + range + 1).or_insert(0) -= 1;
    }
    let mut brightness = 0;
    let mut best = 0;
    let mut answer = 0;
    for (at, delta) in change.iter() {
        brightness += delta;
        if brightness > best {
            best = brightness;
            answer = at;
        }
    }
    answer
}

// ---- brightest_brute.kara: every left end tried against every lamp
fn brute_brightest_position(lights: Vec[(i64, i64)]) -> i64 {
    let mut best = 0;
    let mut answer = 0;
    for (p, r) in lights.iter() {
        let x = p - r;
        let covering = lights.iter().filter(|(q, s)| q - s <= x and x <= q + s).count();
        if covering > best or (covering == best and x < answer) {
            best = covering;
            answer = x;
        }
    }
    answer
}

// ---- brightest_heap.kara: starts in order, a queue of ends
fn heap_brightest_position(lights: Vec[(i64, i64)]) -> i64 {
    let mut spans: Vec[(i64, i64)] = lights.iter().map(|(p, r)| (p - r, p + r)).collect();
    spans.sort();
    let mut lit: PriorityQueue[i64] = PriorityQueue.new();
    let mut best = 0;
    let mut answer = 0;
    for (start, end) in spans.iter() {
        while let Some(soonest) = lit.peek() {
            if soonest < start {
                lit.pop();
            } else {
                break;
            }
        }
        lit.push(end);
        if lit.len() > best {
            best = lit.len();
            answer = start;
        }
    }
    answer
}

// ---- brightest_search.kara: sorted starts and ends, partition_point
fn search_brightest_position(lights: Vec[(i64, i64)]) -> i64 {
    let mut starts: Vec[i64] = lights.iter().map(|(p, r)| p - r).collect();
    let mut ends: Vec[i64] = lights.iter().map(|(p, r)| p + r).collect();
    starts.sort();
    ends.sort();
    let (best, answer) = starts.iter().fold((0, 0), |(best, answer), x| {
        let started = starts.partition_point(|s| s <= x);
        let ended = ends.partition_point(|e| e < x);
        let here = started - ended;
        if here > best { (here, x) } else { (best, answer) }
    });
    answer
}

// ---- brightest_solution.kara: LeetCode's Rust template after karac fix
struct RustSolution {}

impl RustSolution {
    pub fn brightest_position(lights: Vec[Vec[i32]]) -> i32 {
        let mut diff: SortedMap[i64, i32] = SortedMap.new();
        for l in ref lights {
            let (p, r) = (l[0] as i64, l[1] as i64);
            *diff.entry(p - r).or_insert(0) += 1;
            *diff.entry(p + r + 1).or_insert(0) -= 1;
        }
        let mut (cur, best, ans) = (0, 0, 0);
        for (x, d) in diff.iter() {
            cur += d;
            if cur > best {
                best = cur;
                ans = x;
            }
        }
        ans as i32
    }
}

fn rust_brightest_position(lights: Vec[(i64, i64)]) -> i64 {
    let v: Vec[Vec[i32]] = lights.iter().map(|(p, r)| [p as i32, r as i32]).collect();
    RustSolution.brightest_position(v)
}

// ---- the literal reading and the checks ------------------------------------

fn literal(lights: Vec[(i64, i64)]) -> i64 {
    let low = lights.iter().map(|(p, r)| p - r).min().unwrap();
    let high = lights.iter().map(|(p, r)| p + r).max().unwrap();
    let mut best = -1;
    let mut answer = 0;
    for x in low..high + 1 {
        let brightness = lights.iter().filter(|(p, r)| p - r <= x and x <= p + r).count();
        if brightness > best {
            best = brightness;
            answer = x;
        }
    }
    answer
}

fn answer(arm: i64, lights: Vec[(i64, i64)]) -> i64 {
    match arm {
        0 => star_brightest_position(lights),
        1 => map_brightest_position(lights),
        2 => brute_brightest_position(lights),
        3 => heap_brightest_position(lights),
        4 => search_brightest_position(lights),
        _ => rust_brightest_position(lights),
    }
}

struct Problem {
    lights: Vec[(i64, i64)],
    shift: i64,
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn draw(seed: mut ref i64) -> Problem {
    let count = next_random(mut seed) % 10 + 1;
    let spread = next_random(mut seed) % 20 + 1;
    let reach = next_random(mut seed) % 8;
    let lights: Vec[(i64, i64)] = (0..count).map(|_| {
        let position = next_random(mut seed) % (2 * spread + 1) - spread;
        (position, next_random(mut seed) % (reach + 1))
    }).collect();
    let shift = next_random(mut seed) % 2001 - 1000;
    Problem { lights: lights, shift: shift }
}

fn main() {
    let names = ["star", "map", "brute", "heap", "search", "rust"];
    let mut seed = 2021;
    let mut problems: Vec[Problem] = Vec.new();
    for _ in 0..1500 {
        problems.push(draw(mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for p in 0..problems.len() {
        let prob = ref problems[p];
        let lights = prob.lights.clone();
        let shift = prob.shift;
        let truth = literal(lights.clone());
        check = (check * 31 + truth + 1000) % 1000000007;
        let reversed: Vec[(i64, i64)] = lights.iter().rev().cloned().collect();
        let moved: Vec[(i64, i64)] = lights.iter().map(|(q, r)| (q + shift, r)).collect();
        let twice: Vec[(i64, i64)] = lights.iter().chain(lights.iter()).cloned().collect();
        let mut got: Vec[i64] = Vec.new();
        for arm in 0..6 {
            got.push(answer(arm, lights.clone()));
        }
        for arm in 0..6 {
            let a = got[arm];
            let mut same = 0;
            for other in 0..6 {
                if other != arm and got[other] == a {
                    same += 1;
                }
            }
            let mut lit = lights.clone();
            lit.push((a, 0));
            let verdicts = [
                a == truth,
                answer(arm, reversed.clone()) == a,
                answer(arm, moved.clone()) == a + shift,
                answer(arm, twice.clone()) == a,
                answer(arm, lit) == a,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"problem {p} arm {names[arm]}: P{q + 1} fails, lights {lights}, answer {a}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"1500 problems: checksum {check}, {checks} checks over 6 arms: {total} failures");
    for f in failures {
        println(f);
    }
    for q in 0..6 {
        if by_property[q] > 0 {
            println(f"P{q + 1} {by_property[q]}");
        }
    }
}
