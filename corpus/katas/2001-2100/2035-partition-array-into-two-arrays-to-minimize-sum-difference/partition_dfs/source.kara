// LeetCode #2035: Partition Array Into Two Arrays to Minimize Sum
// Difference -- meet in the middle with the subset sums generated by a
// recursive walk (take or leave each value, into `mut ref` lists by size)
// and searched with a hand-written binary search. O(2^n n).

fn walk(half: ref Vec[i64], i: i64, sum: i64, size: i64, out: mut ref Vec[Vec[i64]]) {
    if i == half.len() {
        out[size].push(sum);
        return;
    }
    walk(half, i + 1, sum, size, mut out);
    walk(half, i + 1, sum + half[i], size + 1, mut out);
}

// the first index whose value is at least `want`, in sorted `xs`
fn lower_bound(xs: ref Vec[i64], want: i64) -> i64 {
    let mut lo = 0;
    let mut hi = xs.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if xs[mid] < want {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 2;
    let total: i64 = nums.iter().sum();
    let left_half: Vec[i64] = nums.iter().take(n).cloned().collect();
    let right_half: Vec[i64] = nums.iter().skip(n).cloned().collect();
    let mut left: Vec[Vec[i64]] = Vec.new();
    let mut right: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 1 {
        left.push(Vec.new());
        right.push(Vec.new());
    }
    walk(left_half, 0, 0, 0, mut left);
    walk(right_half, 0, 0, 0, mut right);
    for list in right.iter_mut() {
        list.sort();
    }
    let mut best = i64.MAX;
    for k in 0..n + 1 {
        let ys = ref right[n - k];
        for a in left[k].iter() {
            // 2 (a + b) >= total exactly when b >= ceil((total - 2 a) / 2)
            let d = total - 2 * a;
            let at = lower_bound(ys, d.div_euclid(2) + d.rem_euclid(2));
            for j in [at - 1, at] {
                if j >= 0 and j < ys.len() {
                    best = best.min((total - 2 * (a + ys[j])).abs());
                }
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer % 1000000007) % 1000000007
}

// `2 n` values from `-top` to `top`
fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..2 * n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, 9, 7, 3],
        [-36, 36],
        [2, -1, 0, 4, -2, -9],
        [5, 5],
        [1, 2, 3, 4, 5, 6, 7, 8],
        [10000000, -10000000, 10000000, -10000000],
        [0, 0, 0, 0, 0, 1],
        [7, -3, 12, 1, -8, 4, 9, -11, 2, 6],
    ];
    for nums in examples {
        println(f"{nums} -> {minimum_difference(nums)}");
    }
    // 2000 arrays of 2 to 12 values up to 50 either side
    let mut seed = 2035;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 6 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let answer = minimum_difference(random_values(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 arrays of up to 12 values: sum {sum}, checksum {check}");
    // 4 arrays of 30 values, the most the constraints allow
    sum = 0;
    check = 0;
    for a in 0..4 {
        let top = [10000000, 1000, 10000000, 3][a];
        let answer = minimum_difference(random_values(15, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 arrays of 30 values: sum {sum}, checksum {check}");
}
