// LeetCode #2035: Partition Array Into Two Arrays to Minimize Sum
// Difference -- the ★ arm, meet in the middle. Split the `2 n` values into
// halves of `n`. A side of the partition takes `k` values from the left half
// and `n - k` from the right. For each `k`, list the sums of the left
// half's `k`-subsets and the right half's `(n - k)`-subsets, sort the right
// lists, and for each left sum find by `partition_point` the right sum that
// brings the side closest to half the total. O(2^n n).

fn subset_sums(half: Vec[i64]) -> Vec[Vec[i64]] {
    let n = half.len();
    let mut by_size: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 1 {
        by_size.push(Vec.new());
    }
    for mask in 0..1 << n {
        let mut sum = 0;
        let mut size = 0;
        for i in 0..n {
            if mask >> i & 1 == 1 {
                sum += half[i];
                size += 1;
            }
        }
        by_size[size].push(sum);
    }
    by_size
}

fn minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 2;
    let total: i64 = nums.iter().sum();
    let left = subset_sums(nums[0..n].to_vec());
    let mut right = subset_sums(nums[n..2 * n].to_vec());
    for list in right.iter_mut() {
        list.sort();
    }
    let mut best = i64.MAX;
    for k in 0..n + 1 {
        let others = ref right[n - k];
        for a in left[k].iter() {
            // the side's sum is a + b; the difference is |total - 2 (a + b)|,
            // smallest where b is nearest (total - 2 a) / 2
            let at = others.partition_point(|b| 2 * (a + b) < total);
            if at < others.len() {
                best = best.min((total - 2 * (a + others[at])).abs());
            }
            if at > 0 {
                best = best.min((total - 2 * (a + others[at - 1])).abs());
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer % 1000000007) % 1000000007
}

// `2 n` values from `-top` to `top`
fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..2 * n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, 9, 7, 3],
        [-36, 36],
        [2, -1, 0, 4, -2, -9],
        [5, 5],
        [1, 2, 3, 4, 5, 6, 7, 8],
        [10000000, -10000000, 10000000, -10000000],
        [0, 0, 0, 0, 0, 1],
        [7, -3, 12, 1, -8, 4, 9, -11, 2, 6],
    ];
    for nums in examples {
        println(f"{nums} -> {minimum_difference(nums)}");
    }
    // 2000 arrays of 2 to 12 values up to 50 either side
    let mut seed = 2035;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 6 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let answer = minimum_difference(random_values(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 arrays of up to 12 values: sum {sum}, checksum {check}");
    // 4 arrays of 30 values, the most the constraints allow
    sum = 0;
    check = 0;
    for a in 0..4 {
        let top = [10000000, 1000, 10000000, 3][a];
        let answer = minimum_difference(random_values(15, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 arrays of 30 values: sum {sum}, checksum {check}");
}
