// LeetCode #2035: Partition Array Into Two Arrays to Minimize Sum
// Difference -- LeetCode's Rust template, carried to Kāra by `karac fix`.
// `vec![vec![]; n + 1]`, bit masks with `count_ones() as usize`,
// `sort_unstable`, and `binary_search` taken apart with `unwrap_or_else`.

impl Solution {
    pub fn minimum_difference(nums: Vec[i32]) -> i32 {
        let n = nums.len() / 2;
        let total: i32 = nums.iter().sum();
        let mut left = Vec.filled(n + 1, Vec.new());
        let mut right = Vec.filled(n + 1, Vec.new());
        for mask in 0..(1 << n) {
            let mut a: i32 = 0;
            let mut b = 0;
            for i in 0..n {
                if mask & (1 << i) != 0 {
                    a += nums[i];
                    b += nums[n + i];
                }
            }
            let size = (mask as u32).count_ones() as usize;
            left[size].push(a);
            right[size].push(b);
        }
        for r in right.iter_mut() {
            r.sort();
        }
        let mut best = i32.MAX;
        for k in 0..=n {
            let ys = ref right[n - k];
            for a in ref left[k] {
                let want = (total - 2 * a) / 2;
                let at = ys.binary_search(want).unwrap_or_else(|x| x);
                if at < ys.len() {
                    best = best.min((total - 2 * (a + ys[at])).abs());
                }
                if at > 0 {
                    best = best.min((total - 2 * (a + ys[at - 1])).abs());
                }
            }
        }
        best
    }
}

struct Solution {}

fn minimum_difference(nums: ref Vec[i64]) -> i64 {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.minimum_difference(v)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer % 1000000007) % 1000000007
}

// `2 n` values from `-top` to `top`
fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..2 * n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, 9, 7, 3],
        [-36, 36],
        [2, -1, 0, 4, -2, -9],
        [5, 5],
        [1, 2, 3, 4, 5, 6, 7, 8],
        [10000000, -10000000, 10000000, -10000000],
        [0, 0, 0, 0, 0, 1],
        [7, -3, 12, 1, -8, 4, 9, -11, 2, 6],
    ];
    for nums in examples {
        println(f"{nums} -> {minimum_difference(nums)}");
    }
    // 2000 arrays of 2 to 12 values up to 50 either side
    let mut seed = 2035;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 6 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let answer = minimum_difference(random_values(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 arrays of up to 12 values: sum {sum}, checksum {check}");
    // 4 arrays of 30 values, the most the constraints allow
    sum = 0;
    check = 0;
    for a in 0..4 {
        let top = [10000000, 1000, 10000000, 3][a];
        let answer = minimum_difference(random_values(15, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 arrays of 30 values: sum {sum}, checksum {check}");
}
