// LeetCode #2030: Smallest K-Length Subsequence With Occurrences of a
// Letter -- the ★ arm. A stack of the answer so far, kept as bytes: each
// character pops the larger ones above it while enough characters are left
// to refill the stack to `k` and enough copies of `letter` are left to keep
// `repetition`; it goes on the stack while there is room the letters still
// owed do not need. O(n).

fn smallest_subsequence(s: String, k: i64, letter: char, repetition: i64) -> String {
    let bytes = s.bytes();
    let want = letter as u32 as u8;
    let n = bytes.len();
    let mut remain = bytes.iter().filter(|b| b == want).count();
    let mut stack: Vec[u8] = Vec.new();
    let mut have = 0;
    for i in 0..n {
        let c = bytes[i];
        while stack.len() > 0
            and stack[stack.len() - 1] > c
            and stack.len() - 1 + n - i >= k
            and (stack[stack.len() - 1] != want or have - 1 + remain >= repetition)
        {
            if stack.pop().unwrap() == want {
                have -= 1;
            }
        }
        if stack.len() < k {
            if c == want {
                stack.push(c);
                have += 1;
            } else if k - stack.len() > repetition - have {
                stack.push(c);
            }
        }
        if c == want {
            remain -= 1;
        }
    }
    String.from_utf8(stack).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 strings of 50000 letters built once, string `a` from the first
    // 2 + 3 a of the alphabet, each letter a step from the last; then 20
    // rounds asking each string for a subsequence with a `k`, a letter and
    // a repetition of the round's own
    let mut seed = 2030;
    let mut texts: Vec[String] = Vec.new();
    for a in 0..10 {
        let span = 2 + 3 * a;
        let mut s = String.new();
        let mut c = 0;
        for _ in 0..50000 {
            let r = next_random(mut seed) % 10;
            if r < 4 {
                c = (c + 1) % span;
            } else if r < 7 {
                c = next_random(mut seed) % span;
            }
            s.push((97 + c) as u8 as char);
        }
        texts.push(s);
    }
    let mut calls = 0;
    let mut kept = 0;
    let mut check = 0;
    for round in 0..20 {
        for a in 0..10 {
            let s = ref texts[a];
            let k = (round * 2477 + a * 911) % 50000 + 1;
            let letter = (97 + (round + a) % (2 + 3 * a)) as u8 as char;
            let copies = s.chars().filter(|c| c == letter).count();
            let repetition = (round * 131 + a * 17) % k.min(copies) + 1;
            let got = smallest_subsequence(s, k, letter, repetition);
            calls += 1;
            let bytes = got.bytes();
            let len = bytes.len();
            kept += len;
            check = (check * 31 + len) % 1000000007;
            check = (check * 31 + bytes[0] + bytes[len / 2] + bytes[len - 1]) % 1000000007;
        }
    }
    println(f"{calls} calls: {kept} letters kept, checksum {check}");
}
