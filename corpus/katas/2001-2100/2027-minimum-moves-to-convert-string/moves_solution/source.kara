// LeetCode #2027: Minimum Moves to Convert String -- LeetCode's Rust
// template, carried to Kāra by `karac fix`. `as_bytes()`, `b'X'`, and a
// `usize` index stepped by 3.

impl Solution {
    pub fn minimum_moves(s: String) -> i32 {
        let s = s.bytes();
        let mut i: i64 = 0;
        let mut ans = 0;
        while i < s.len() {
            if s[i] == b'X' {
                ans += 1;
                i += 3;
            } else {
                i += 1;
            }
        }
        ans
    }
}

struct Solution {}

fn minimum_moves(s: String) -> i64 {
    Solution.minimum_moves(s.clone())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn key_of(seed: mut ref i64, len: i64, x_in_100: i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        s.push(if next_random(mut seed) % 100 < x_in_100 { 'X' } else { 'O' });
    }
    s
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[String] = ["XXX", "XXOX", "OOOO", "XOXOXO", "OXOOX", "OXX", "XOO", "OOXOOOXXXXOX"];
    for s in examples {
        println(f"{s} -> {minimum_moves(s)}");
    }
    // 3000 strings of 3 to 30 places, each with its own share of `X`
    let mut seed = 2027;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let len = next_random(mut seed) % 28 + 3;
        let share = next_random(mut seed) % 101;
        let moves = minimum_moves(key_of(mut seed, len, share));
        total += moves;
        check = (check * 31 + moves) % 1000000007;
    }
    println(f"3000 strings of up to 30 places: {total} moves, checksum {check}");
    // 6 strings of 1000 places, the most the constraints allow, from 1 to
    // 100 in 100 `X`
    total = 0;
    check = 0;
    for a in 0..6 {
        let moves = minimum_moves(key_of(mut seed, 1000, [1, 10, 33, 50, 90, 100][a]));
        total += moves;
        check = (check * 31 + moves) % 1000000007;
    }
    println(f"6 strings of 1000 places: {total} moves, checksum {check}");
}
