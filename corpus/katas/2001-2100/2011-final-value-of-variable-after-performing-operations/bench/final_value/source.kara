// LeetCode #2011: Final Value of Variable After Performing Operations --
// the ★ arm's benchmark. Each operation is one of four strings; a `match`
// on it says whether `X` goes up or down.

fn final_value_after_operations(operations: Vec[String]) -> i64 {
    let mut x = 0;
    for op in operations {
        match op.as_str() {
            "++X" | "X++" => x += 1,
            "--X" | "X--" => x -= 1,
            _ => {}
        }
    }
    x
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20000 lists of 100 operations built once, each list leaning up or
    // down by its own odds, then the ★ arm on each for 10 rounds
    let forms = ["++X", "X++", "--X", "X--"];
    let mut seed = 2011;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..20000 {
        let up = next_random(mut seed) % 11;
        let mut operations: Vec[String] = Vec.new();
        for _ in 0..100 {
            let down = if next_random(mut seed) % 10 < up { 0 } else { 2 };
            operations.push(forms[down + next_random(mut seed) % 2].to_string());
        }
        lists.push(operations);
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..10 {
        for a in 0..lists.len() {
            let answer = final_value_after_operations(lists[a]);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer + 100) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
