// LeetCode #2054: Two Best Non-Overlapping Events -- the events taken by
// start, each pushed as it is passed into a `PriorityQueue` of (end,
// value), soonest end first. Before an event is weighed, every one in the
// queue that ended before it starts is popped, its value kept if it is the
// best so far. O(n log n).

fn max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let mut events = events.clone();
    events.sort();
    let mut ending: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut before = 0;
    let mut best = 0;
    for (start, end, value) in events.iter() {
        while let Some((e, v)) = ending.peek() {
            if e >= start {
                break;
            }
            before = before.max(v);
            ending.pop();
        }
        best = best.max(before + value);
        ending.push((end, value));
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` events starting from 1 to `span`, each lasting up to `longest`
// more, worth 1 to `worth`
fn draw(n: i64, span: i64, longest: i64, worth: i64, seed: mut ref i64) -> Vec[(i64, i64, i64)] {
    let mut events: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..n {
        let start = (next_random(mut seed) * 32768 + next_random(mut seed)) % span + 1;
        let end = start + (next_random(mut seed) * 32768 + next_random(mut seed)) % longest;
        let value = (next_random(mut seed) * 32768 + next_random(mut seed)) % worth + 1;
        events.push((start, end, value));
    }
    events
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        [(1, 3, 2), (4, 5, 2), (2, 4, 3)],
        [(1, 3, 2), (4, 5, 2), (1, 5, 5)],
        [(1, 5, 3), (1, 5, 1), (6, 6, 5)],
        [(1, 1, 4), (1, 1, 6)],
        [(1, 2, 4), (2, 3, 6)],
        [(1, 2, 4), (3, 3, 6)],
        [(5, 9, 1), (1, 4, 7), (10, 12, 2), (2, 11, 9)],
    ];
    for e in examples.iter() {
        let events: Vec[(i64, i64, i64)] = e.iter().collect();
        println(f"{events} -> {max_two_events(events)}");
    }
    // 2000 sets of 2 to 30 short events
    let mut seed = 2054;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 29 + 2;
        let span = next_random(mut seed) % 50 + 5;
        let longest = next_random(mut seed) % 10 + 1;
        let events = draw(n, span, longest, 100, mut seed);
        let best = max_two_events(events);
        total += best;
        check = (check * 31 + best) % 1000000007;
    }
    println(f"2000 sets: sum {total}, checksum {check}");
    // 20 sets of 2000 events over the constraints' times and values
    total = 0;
    check = 0;
    for t in 0..20 {
        let longest = [1000, 1000000, 100000000, 500000000][t % 4];
        let events = draw(2000, 1000000000 - longest, longest, 1000000, mut seed);
        let best = max_two_events(events);
        total += best;
        check = (check * 31 + best) % 1000000007;
    }
    println(f"20 sets of 2000: sum {total}, checksum {check}");
}
