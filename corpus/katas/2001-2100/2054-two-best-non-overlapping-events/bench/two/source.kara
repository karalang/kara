// LeetCode #2054: Two Best Non-Overlapping Events -- the ★ arm as a
// benchmark. 50 sets of 100000 events, the constraints' limit, over times
// up to a billion and values up to a million, each lasting up to a
// thousand, a million, a hundred million or half a billion; each answered
// by sorting by start, keeping the best value from each event on, and a
// `partition_point` for each event: five million events.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let mut events = events.clone();
    events.sort();
    let n = events.len();
    let mut best_from: Vec[i64] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        best_from[i] = best_from[i + 1].max(events[i].2);
    }
    let mut best = 0;
    for (_, end, value) in events.iter() {
        let next = events.partition_point(|e| e.0 <= end);
        best = best.max(value + best_from[next]);
    }
    best
}

fn main() {
    let mut seed = 2054;
    let mut total = 0;
    let mut check = 0;
    for t in 0..50 {
        let longest = [1000, 1000000, 100000000, 500000000][t % 4];
        let span = 1000000000 - longest;
        let mut events: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..100000 {
            let start = (next_random(mut seed) * 32768 + next_random(mut seed)) % span + 1;
            let end = start + (next_random(mut seed) * 32768 + next_random(mut seed)) % longest;
            let value = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
            events.push((start, end, value));
        }
        let best = max_two_events(events);
        total += best;
        check = (check * 31 + best) % 1000000007;
    }
    println(f"50 sets: sum {total}, checksum {check}");
}
