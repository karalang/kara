// LeetCode #2054: Two Best Non-Overlapping Events -- the differential.
// The six arms, against the statement read literally: every choice of one
// event, or of two that share no moment of time, the latest start no later
// than the earliest end meaning they do. 500 sets of 2 to 30 events, every
// one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is at least the best value and at most the two best
//     values together
// P3  the events mirrored in time, each (start, end) to (100 - end,
//     100 - start), and listed backwards, have the same answer
// P4  a new event worth 1 that spans every other leaves the answer the same
// P5  a new event after every other, worth 10000000, makes the answer
//     10000000 and the best value
// P6  each arm agrees with at least three of the other five

// ---- two.kara: the ★ arm, sorted by start, `partition_point` and the best from each on
fn star_max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let mut events = events.clone();
    events.sort();
    let n = events.len();
    let mut best_from: Vec[i64] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        best_from[i] = best_from[i + 1].max(events[i].2);
    }
    let mut best = 0;
    for (_, end, value) in events.iter() {
        let next = events.partition_point(|e| e.0 <= end);
        best = best.max(value + best_from[next]);
    }
    best
}

// ---- two_brute.kara: each event alone and each pair that does not overlap
fn brute_max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let n = events.len();
    let mut best = 0;
    for i in 0..n {
        let (start, end, value) = events[i];
        best = best.max(value);
        for j in i + 1..n {
            let (s, e, v) = events[j];
            if end < s or e < start {
                best = best.max(value + v);
            }
        }
    }
    best
}

// ---- two_sweep.kara: the starts walked with a cursor over the ends
fn sweep_max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let mut by_start = events.clone();
    by_start.sort_by_key(|e| e.0);
    let mut by_end = events.clone();
    by_end.sort_by_key(|e| e.1);
    let mut passed = 0;
    let mut before = 0;
    let mut best = 0;
    for (start, _, value) in by_start.iter() {
        while passed < by_end.len() and by_end[passed].1 < start {
            before = before.max(by_end[passed].2);
            passed += 1;
        }
        best = best.max(before + value);
    }
    best
}

// ---- two_heap.kara: a `PriorityQueue` of the events passed, soonest end first
fn heap_max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let mut events = events.clone();
    events.sort();
    let mut ending: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut before = 0;
    let mut best = 0;
    for (start, end, value) in events.iter() {
        while let Some((e, v)) = ending.peek() {
            if e >= start {
                break;
            }
            before = before.max(v);
            ending.pop();
        }
        best = best.max(before + value);
        ending.push((end, value));
    }
    best
}

// ---- two_floor.kara: the best up to each end in a `SortedMap`, asked with `floor`
fn floor_max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let mut by_end = events.clone();
    by_end.sort_by_key(|e| e.1);
    let mut upto: SortedMap[i64, i64] = SortedMap.new();
    let mut running = 0;
    for (_, end, value) in by_end.iter() {
        running = running.max(value);
        upto.insert(end, running);
    }
    let mut best = 0;
    for (start, _, value) in events.iter() {
        let before = match upto.floor(start - 1) {
            Some((_, b)) => b,
            None => 0,
        };
        best = best.max(before + value);
    }
    best
}

// ---- two_solution.kara: LeetCode's Rust template, carried by `karac fix`
struct Solution {}

impl Solution {
    pub fn max_two_events(events: own Vec[Vec[i32]]) -> i32 {
        let mut events = events;
        events.sort_by_key(|e| e[0]);
        let mut heap = PriorityQueue.new();
        let mut best: i32 = 0;
        let mut ans: i32 = 0;
        for e in ref events {
            while let Some((end, val)) = heap.peek().cloned() {
                if end < e[0] {
                    best = best.max(val);
                    heap.pop();
                } else {
                    break;
                }
            }
            ans = ans.max(best + e[2]);
            heap.push((e[1], e[2]));
        }
        ans
    }
}

fn solution_max_two_events(events: Vec[(i64, i64, i64)]) -> i64 {
    let rows: Vec[Vec[i32]] = events.iter().map(|(s, e, v)| [s as i32, e as i32, v as i32]).collect();
    Solution.max_two_events(rows)
}

// ---- the statement read literally

fn literal(events: Vec[(i64, i64, i64)]) -> i64 {
    let n = events.len();
    let mut best = 0;
    for i in 0..n {
        best = best.max(events[i].2);
        for j in 0..n {
            let (a, b) = (events[i], events[j]);
            let share = a.0.max(b.0) <= a.1.min(b.1);
            if j != i and not share {
                best = best.max(a.2 + b.2);
            }
        }
    }
    best
}

fn answer(arm: i64, events: Vec[(i64, i64, i64)]) -> i64 {
    match arm {
        0 => star_max_two_events(events),
        1 => brute_max_two_events(events),
        2 => sweep_max_two_events(events),
        3 => heap_max_two_events(events),
        4 => floor_max_two_events(events),
        _ => solution_max_two_events(events),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` events as the harness draws them
fn draw(n: i64, span: i64, longest: i64, worth: i64, seed: mut ref i64) -> Vec[(i64, i64, i64)] {
    let mut events: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..n {
        let start = (next_random(mut seed) * 32768 + next_random(mut seed)) % span + 1;
        let end = start + (next_random(mut seed) * 32768 + next_random(mut seed)) % longest;
        let value = (next_random(mut seed) * 32768 + next_random(mut seed)) % worth + 1;
        events.push((start, end, value));
    }
    events
}

fn main() {
    let names = ["star", "brute", "sweep", "heap", "floor", "solution"];
    let mut seed = 2054;
    let mut problems: Vec[Vec[(i64, i64, i64)]] = Vec.new();
    for _ in 0..500 {
        let n = next_random(mut seed) % 29 + 2;
        let span = next_random(mut seed) % 50 + 5;
        let longest = next_random(mut seed) % 10 + 1;
        problems.push(draw(n, span, longest, 100, mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for events in problems.iter() {
        let truth = literal(events);
        check = (check * 31 + truth) % 1000000007;
        let mut values: Vec[i64] = events.iter().map(|e| e.2).collect();
        values.sort();
        let n = values.len();
        let top = values[n - 1];
        let mirrored: Vec[(i64, i64, i64)] = events.iter().rev().map(|(s, e, v)| (100 - e, 100 - s, v)).collect();
        let first = events.iter().map(|e| e.0).min().unwrap();
        let last = events.iter().map(|e| e.1).max().unwrap();
        let mut spanned = events.clone();
        spanned.push((first, last, 1));
        let mut after = events.clone();
        after.push((last + 1, last + 3, 10000000));
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, events)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x >= top and x <= top + values[n - 2],
                answer(arm, mirrored) == x,
                answer(arm, spanned) == x,
                answer(arm, after) == 10000000 + top,
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{events} arm {names[arm]}: P{p + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"500 sets: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
