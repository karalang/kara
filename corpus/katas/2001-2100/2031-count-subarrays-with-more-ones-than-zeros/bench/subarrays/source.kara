// LeetCode #2031: Count Subarrays With More Ones Than Zeros -- the ★ arm
// under the bench workload. Count a 1 as +1 and a 0 as -1; `seen` counts
// the prefix sums so far and `below` how many lie under the current one,
// moved one step at a time. O(n).

const MOD: i64 = 1000000007;

fn subarrays_more_ones(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    // seen[n + p]: the prefixes so far whose sum is p
    let mut seen = Vec.filled(2 * n + 1, 0);
    let mut prefix = n;
    seen[prefix] = 1;
    let mut below = 0;
    let mut total = 0;
    for x in nums {
        if x == 1 {
            below += seen[prefix];
            prefix += 1;
        } else {
            prefix -= 1;
            below -= seen[prefix];
        }
        total = (total + below) % MOD;
        seen[prefix] += 1;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 arrays of 100000 bits built once, array `a` with odds `a % 9 + 1`
    // in 10 of a 1; then 100 rounds, each flipping one bit of each array
    // before the ★ arm answers it
    let mut seed = 2031;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..20 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(if next_random(mut seed) % 10 < a % 9 + 1 { 1 } else { 0 });
        }
        arrays.push(nums);
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for round in 0..100 {
        for a in 0..20 {
            let at = (round * 997 + a * 31) % 100000;
            arrays[a][at] = 1 - arrays[a][at];
            let answer = subarrays_more_ones(arrays[a]);
            calls += 1;
            sum = (sum + answer) % MOD;
            check = (check * 31 + answer) % MOD;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
