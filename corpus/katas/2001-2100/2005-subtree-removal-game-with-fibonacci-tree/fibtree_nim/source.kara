// LeetCode #2005: Subtree Removal Game with Fibonacci Tree -- the nim arm.
// The ★ arm's recurrence with the nim-sum done by hand, one binary digit at
// a time (digits that differ give a 1), into a fixed array of every value
// the constraints can ask for.

fn nim_sum(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    let mut sum = 0;
    let mut place = 1;
    while x > 0 or y > 0 {
        if x % 2 != y % 2 {
            sum += place;
        }
        x /= 2;
        y /= 2;
        place *= 2;
    }
    sum
}

fn find_game_winner(n: i64) -> bool {
    let mut value: Array[i64, 101] = [0; 101];
    for k in 2..=n {
        let left = if k >= 3 { value[k - 2] + 1 } else { 0 };
        value[k] = nim_sum(left, value[k - 1] + 1);
    }
    value[n] != 0
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    for n in [3, 1, 2] {
        println(f"n = {n} -> {find_game_winner(n)}");
    }
    // every n the constraints allow, A where Alice wins and B where Bob does
    let mut line = String.new();
    for n in 1..=100 {
        line.push(if find_game_winner(n) { 'A' } else { 'B' });
    }
    println(f"{line}");
    // random queries
    let mut seed = 2005;
    let mut alice = 0;
    let mut check = 0;
    for _ in 0..50000 {
        let n = next_random(mut seed) % 100 + 1;
        let wins = find_game_winner(n);
        if wins {
            alice += 1;
        }
        check = (check * 31 + if wins { n } else { 0 }) % 1000000007;
    }
    println(f"50000 queries: Alice wins {alice}, checksum {check}");
}
