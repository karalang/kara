// LeetCode #2005: Subtree Removal Game with Fibonacci Tree -- the closed
// form. The values of order(1), order(2), ... run 0, 1, 3, 6, 3, 3, then 0
// again at order(7): order(k) is worth 0 exactly when its two subtrees are
// worth the same, and that comes back every six steps. Bob wins exactly
// when n leaves 1 over a multiple of 6.

fn find_game_winner(n: i64) -> bool {
    n % 6 != 1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    for n in [3, 1, 2] {
        println(f"n = {n} -> {find_game_winner(n)}");
    }
    // every n the constraints allow, A where Alice wins and B where Bob does
    let mut line = String.new();
    for n in 1..=100 {
        line.push(if find_game_winner(n) { 'A' } else { 'B' });
    }
    println(f"{line}");
    // random queries
    let mut seed = 2005;
    let mut alice = 0;
    let mut check = 0;
    for _ in 0..50000 {
        let n = next_random(mut seed) % 100 + 1;
        let wins = find_game_winner(n);
        if wins {
            alice += 1;
        }
        check = (check * 31 + if wins { n } else { 0 }) % 1000000007;
    }
    println(f"50000 queries: Alice wins {alice}, checksum {check}");
}
