// LeetCode #2005: Subtree Removal Game with Fibonacci Tree -- LeetCode's
// Rust template, carried to Kāra by `karac fix`. The ★ arm's recurrence over
// `usize` indices in a `vec!` of `i32` values.

struct Solution {}

impl Solution {
    pub fn find_game_winner(n: i32) -> bool {
        let n = n as i64;
        let mut g = Vec.filled(n + 1, 0i32);
        for k in 2..=n {
            let left = if k >= 3 { g[k - 2] + 1 } else { 0 };
            g[k] = left ^ (g[k - 1] + 1);
        }
        g[n] != 0
    }
}

fn find_game_winner(n: i64) -> bool {
    Solution.find_game_winner(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    for n in [3, 1, 2] {
        println(f"n = {n} -> {find_game_winner(n)}");
    }
    // every n the constraints allow, A where Alice wins and B where Bob does
    let mut line = String.new();
    for n in 1..=100 {
        line.push(if find_game_winner(n) { 'A' } else { 'B' });
    }
    println(f"{line}");
    // random queries
    let mut seed = 2005;
    let mut alice = 0;
    let mut check = 0;
    for _ in 0..50000 {
        let n = next_random(mut seed) % 100 + 1;
        let wins = find_game_winner(n);
        if wins {
            alice += 1;
        }
        check = (check * 31 + if wins { n } else { 0 }) % 1000000007;
    }
    println(f"50000 queries: Alice wins {alice}, checksum {check}");
}
