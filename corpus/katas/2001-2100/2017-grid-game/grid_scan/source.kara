// LeetCode #2017: Grid Game -- the iterator arm. The top row's sums after
// each column by `scan` over the row reversed, the bottom row's sums before
// each column by `scan` over the row, joined with `zip` and the largest of
// each pair's smallest taken with `min`. O(n).

fn grid_game(grid: Vec[Vec[i64]]) -> i64 {
    let mut after: Vec[i64] = grid[0].iter().rev().scan(0, |s, x| Some((s + x, s))).collect();
    after.reverse();
    let before: Vec[i64] = grid[1].iter().scan(0, |s, x| Some((s + x, s))).collect();
    after.iter().zip(before.iter()).map(|(a, b)| a.max(b)).min().unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// a grid of two rows of `n` points from 1 to `top`
fn random_grid(n: i64, top: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..2 {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[Vec[i64]]] = [
        [[2, 5, 4], [1, 5, 1]],
        [[3, 3, 1], [8, 5, 2]],
        [[1, 3, 1, 15], [1, 3, 3, 1]],
        [[7], [9]],
        [[1, 100000], [100000, 1]],
        [[5, 5, 5, 5], [5, 5, 5, 5]],
        [[20, 3, 20, 17, 2, 12, 15, 17, 4, 15], [20, 10, 13, 14, 15, 5, 2, 3, 14, 3]],
    ];
    for grid in examples {
        println(f"{grid} -> {grid_game(grid)}");
    }
    let mut seed = 2017;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = next_random(mut seed) % 20 + 1;
        let answer = grid_game(random_grid(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 grids of 1 to 12 columns: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for a in 0..4 {
        let n = [3000, 3000, 1000, 2][a];
        let top = [100000, 3, 100000, 100000][a];
        let answer = grid_game(random_grid(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 grids of up to 3000 columns: sum {sum}, checksum {check}");
}
