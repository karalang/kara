// LeetCode #2017: Grid Game -- the ★ arm's benchmark. A pass over the
// columns moves the first robot's turn along, the top row's remainder
// falling and the bottom row's start growing, and keeps the smallest of the
// second robot's larger shares.

fn grid_game(grid: Vec[Vec[i64]]) -> i64 {
    let mut top: i64 = grid[0].iter().sum();
    let mut bottom = 0;
    let mut best = i64.MAX;
    for i in 0..grid[0].len() {
        top -= grid[0][i];
        best = best.min(top.max(bottom));
        bottom += grid[1][i];
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 200 grids of 2 rows of 50000 points up to 100000, built once; the ★
    // arm on each for 10 rounds
    let mut seed = 2017;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..200 {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..2 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..50000 {
                row.push(next_random(mut seed) * 3 % 100000 + 1);
            }
            grid.push(row);
        }
        grids.push(grid);
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..10 {
        for grid in grids.iter() {
            let answer = grid_game(grid);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
