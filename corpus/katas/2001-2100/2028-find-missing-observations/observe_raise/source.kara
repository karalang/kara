// LeetCode #2028: Find Missing Observations -- every roll starts at 1 and
// one pip at a time goes to each roll in turn until the rolls reach the
// total they need; a roll at 6 takes no more. O(m + 6 n).

fn missing_rolls(rolls: Vec[i64], mean: i64, n: i64) -> Vec[i64] {
    let have: i64 = rolls.iter().sum();
    let need = mean * (rolls.len() + n) - have;
    if need < n or need > 6 * n {
        return Vec.new();
    }
    let mut out: Vec[i64] = Vec.filled(n, 1);
    let mut left = need - n;
    let mut i = 0;
    while left > 0 {
        if out[i] < 6 {
            out[i] += 1;
            left -= 1;
        }
        i = (i + 1) % n;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// An answer is right when it is empty and no `n` rolls fit, or when it
// holds `n` rolls from 1 to 6 that bring the mean to `mean` exactly. Any
// such rolls are right, and the arms pick different ones, so what is
// printed is the verdict and the forced total, not the rolls.
fn verdict(rolls: Vec[i64], mean: i64, n: i64, got: Vec[i64]) -> String {
    let need = mean * (rolls.len() + n) - rolls.iter().sum();
    let fits = need >= n and need <= 6 * n;
    if got.is_empty() {
        return if fits { "WRONG: none" } else { "none" };
    }
    let sum: i64 = got.iter().sum();
    if got.len() == n and got.iter().all(|r| r >= 1 and r <= 6) and sum == need {
        f"{n} rolls adding to {sum}"
    } else {
        f"WRONG: {got}"
    }
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], i64, i64)] = [
        ([3, 2, 4, 3], 4, 2),
        ([1, 5, 6], 3, 4),
        ([1, 2, 3, 4], 6, 4),
        ([6, 6], 6, 3),
        ([1], 1, 1),
        ([6, 6, 6], 1, 2),
        ([4, 5, 6, 2, 3, 6, 5, 4, 6, 4, 5, 1, 6, 3, 1, 4, 5, 5, 3, 2, 3, 5, 3, 2, 1, 5, 4, 3, 5, 1, 5], 4, 40),
        ([2], 4, 1),
    ];
    for (rolls, mean, n) in examples {
        let got = missing_rolls(rolls, mean, n);
        println(f"{rolls}, {mean}, {n} -> {verdict(rolls, mean, n, got)}");
    }
    // 3000 problems of 1 to 20 rolls and 1 to 20 missing, the mean from 1
    // to 6; the verdicts folded into a checksum
    let mut seed = 2028;
    let mut found = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let m = next_random(mut seed) % 20 + 1;
        let rolls: Vec[i64] = (0..m).map(|_| next_random(mut seed) % 6 + 1).collect();
        let mean = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 20 + 1;
        let got = missing_rolls(rolls, mean, n);
        let v = verdict(rolls, mean, n, got);
        if not got.is_empty() {
            found += 1;
        }
        for b in v.bytes().iter() {
            check = (check * 31 + b as i64) % 1000000007;
        }
    }
    println(f"3000 problems of up to 20 rolls: {found} answered, checksum {check}");
    // 5 problems of 100000 rolls and 100000 missing, the most the
    // constraints allow
    found = 0;
    check = 0;
    for a in 0..5 {
        let rolls: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 6 + 1).collect();
        let mean = [1, 3, 4, 6, 2][a];
        let got = missing_rolls(rolls, mean, 100000);
        let v = verdict(rolls, mean, 100000, got);
        if not got.is_empty() {
            found += 1;
        }
        for b in v.bytes().iter() {
            check = (check * 31 + b as i64) % 1000000007;
        }
    }
    println(f"5 problems of 100000 rolls: {found} answered, checksum {check}");
}
