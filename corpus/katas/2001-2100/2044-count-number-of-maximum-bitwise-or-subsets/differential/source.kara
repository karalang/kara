// LeetCode #2044: Count Number of Maximum Bitwise-OR Subsets -- the
// differential. The six arms, against the statement read literally: every
// non-empty subset listed, its OR taken, the greatest OR found, and the
// subsets that reach it counted. 1500 arrays of 1 to 10 values up to 1 to
// 60, each with a shuffle, every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the values shuffled leave the answer
// P3  the OR of everything appended adds 2^n: every old subset, and the
//     empty one, joined with it reaches the greatest OR
// P4  every value doubled leaves the answer
// P5  a value with a bit above all the others (64) appended leaves the
//     answer: a subset reaches the new greatest OR only with that value and
//     with old values that reach the old one
// P6  each arm agrees with at least three of the other five

// ---- subsets.kara: the ★ arm, take-or-skip backtracking
fn star_count_from(nums: Vec[i64], i: i64, acc: i64, target: i64) -> i64 {
    if i == nums.len() {
        return if acc == target { 1 } else { 0 };
    }
    star_count_from(nums, i + 1, acc | nums[i], target) + star_count_from(nums, i + 1, acc, target)
}

fn star_count_max_or_subsets(nums: Vec[i64]) -> i64 {
    let target = nums.iter().fold(0, |acc, x| acc | x);
    star_count_from(nums, 0, 0, target)
}

// ---- subsets_masks.kara: every mask, its OR bit by bit
fn masks_count_max_or_subsets(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut target = 0;
    for x in nums.iter() {
        target |= x;
    }
    let mut count = 0;
    for mask in 1..1 << n {
        let mut acc = 0;
        for i in 0..n {
            if mask >> i & 1 == 1 {
                acc |= nums[i];
            }
        }
        if acc == target {
            count += 1;
        }
    }
    count
}

// ---- subsets_table.kara: subsets counted by OR value
fn table_count_max_or_subsets(nums: Vec[i64]) -> i64 {
    let target = nums.iter().fold(0, |acc, x| acc | x);
    let mut size = 1;
    while size <= target {
        size *= 2;
    }
    let mut ways: Vec[i64] = Vec.filled(size, 0);
    ways[0] = 1;
    for x in nums.iter() {
        let old = ways.clone();
        for v in 0..size {
            if old[v] > 0 {
                ways[v | x] += old[v];
            }
        }
    }
    ways[target]
}

// ---- subsets_lowbit.kara: each mask's OR from the mask less its lowest bit
fn lowbit_count_max_or_subsets(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut or_of: Vec[i64] = Vec.filled(1 << n, 0);
    let mut best = 0;
    let mut count = 0;
    for mask in 1..1 << n {
        or_of[mask] = or_of[mask & (mask - 1)] | nums[mask.trailing_zeros()];
        if or_of[mask] > best {
            best = or_of[mask];
            count = 1;
        } else if or_of[mask] == best {
            count += 1;
        }
    }
    count
}

// ---- subsets_iter.kara: filter, fold and count over the masks
fn iter_count_max_or_subsets(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let target = nums.iter().fold(0, |acc, x| acc | x);
    (1..1 << n)
        .filter(|mask| (0..n).filter(|i| mask >> i & 1 == 1).fold(0, |acc, i| acc | nums[i]) == target)
        .count()
}

// ---- subsets_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn solution_count_max_or_subsets(nums: Vec[i32]) -> i32 {
        let target = nums.iter().fold(0, |a, x| a | x);
        let n = nums.len();
        let mut count = 0;
        for mask in 1..(1 << n) {
            let mut r#or = 0;
            for i in 0..n {
                if mask >> i & 1 == 1 {
                    r#or |= nums[i];
                }
            }
            if r#or == target {
                count += 1;
            }
        }
        count
    }
}

struct Solution {}

fn solution_count_max_or_subsets(nums: Vec[i64]) -> i64 {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.solution_count_max_or_subsets(v)
}

// ---- the statement read literally

fn literal(nums: Vec[i64]) -> i64 {
    // every subset as a list of positions, built one value at a time
    let mut subsets: Vec[Vec[i64]] = [Vec.new()].to_vec();
    for i in 0..nums.len() {
        let mut more: Vec[Vec[i64]] = Vec.new();
        for s in subsets.iter() {
            let mut with = s.clone();
            with.push(i);
            more.push(with);
        }
        subsets.extend(more.into_iter());
    }
    let mut ors: Vec[i64] = Vec.new();
    for s in subsets.iter() {
        if not s.is_empty() {
            let mut acc = 0;
            for i in s.iter() {
                acc = acc | nums[i];
            }
            ors.push(acc);
        }
    }
    let greatest = ors.iter().max().cloned().unwrap();
    ors.iter().filter(|v| v == greatest).count()
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    let v = nums.clone();
    match arm {
        0 => star_count_max_or_subsets(v),
        1 => masks_count_max_or_subsets(v),
        2 => table_count_max_or_subsets(v),
        3 => lowbit_count_max_or_subsets(v),
        4 => iter_count_max_or_subsets(v),
        _ => solution_count_max_or_subsets(v),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "masks", "table", "lowbit", "iter", "solution"];
    let mut seed = 2044;
    let mut problems: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for _ in 0..1500 {
        let n = next_random(mut seed) % 10 + 1;
        let top = next_random(mut seed) % 60 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let mut order: Vec[i64] = (0..n).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        problems.push((nums, order));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for p in 0..problems.len() {
        let nums = ref problems[p].0;
        let n = nums.len();
        let truth = literal(nums);
        check = (check * 31 + truth) % 1000000007;
        let shuffled: Vec[i64] = problems[p].1.iter().map(|i| nums[i]).collect();
        let total = nums.iter().fold(0, |acc, x| acc | x);
        let mut with_total = nums.clone();
        with_total.push(total);
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let mut with_high = nums.clone();
        with_high.push(64);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for other in 0..6 {
                if other != arm and got[other] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, shuffled) == x,
                answer(arm, with_total) == x + (1 << n),
                answer(arm, doubled) == x,
                answer(arm, with_high) == x,
                same >= 3,
            ];
            for k in 0..6 {
                checks += 1;
                if not verdicts[k] {
                    by_property[k] += 1;
                    if failures.len() < 10 {
                        failures.push(f"array {p} arm {names[arm]}: P{k + 1} fails, answer {x}, literal {truth}, nums {nums}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"1500 arrays: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for k in 0..6 {
            if by_property[k] > 0 {
                println(f"P{k + 1} {by_property[k]}");
            }
        }
    }
}
