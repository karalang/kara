// LeetCode #2058: Find the Minimum and Maximum Number of Nodes Between
// Critical Points -- LeetCode's Rust template (`Option<Box<ListNode>>`,
// `i32` values, `head.as_ref().unwrap().val` for the first value, a
// `while let Some(node) = cur` walk with `if let Some(next) = &node.next`,
// and `vec![..]` answers), carried by `karac fix`. The harness converts
// its `i64` values at `build` and the answer back.

// Definition for singly-linked list.
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct ListNode {
    pub val: i32,
    pub next: Option[ListNode],
}

impl ListNode {
    #[inline]
    fn new(val: i32) -> Self {
        ListNode { next: None, val }
    }
}

struct Solution {}

impl Solution {
    pub fn nodes_between_critical_points(head: Option[ListNode]) -> Vec[i32] {
        let mut prev = head.as_ref().unwrap().val;
        let mut cur = head.clone().unwrap().next;
        let mut idx: i32 = 1;
        let mut (first, last, min_d) = (-1i32, -1i32, i32.MAX);
        while let Some(node) = cur {
            if let Some(next) = ref node.next {
                if (node.val > prev and node.val > next.val) or (node.val < prev and node.val < next.val) {
                    if first == -1 {
                        first = idx;
                    } else {
                        min_d = min_d.min(idx - last);
                    }
                    last = idx;
                }
            }
            prev = node.val;
            cur = node.next;
            idx += 1;
        }
        if min_d == i32.MAX {
            [-1, -1]
        } else {
            [min_d, last - first]
        }
    }
}

fn nodes_between_critical_points(head: Option[ListNode]) -> Vec[i64] {
    Solution.nodes_between_critical_points(head).iter().map(|d| d as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v as i32, next: head });
    }
    head
}

// `n` values from 1 to `top`, so that neighbours are often equal
fn draw(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut values: Vec[i64] = Vec.new();
    for _ in 0..n {
        values.push(next_random(mut seed) % top + 1);
    }
    values
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, 1].to_vec(),
        [5, 3, 1, 2, 5, 1, 2].to_vec(),
        [1, 3, 2, 2, 3, 2, 2, 2, 7].to_vec(),
        [2, 3, 3, 2].to_vec(),
        [1, 2, 1].to_vec(),
        [1, 2, 1, 2, 1].to_vec(),
        [1, 1, 1, 1].to_vec(),
        [4, 1, 9, 9, 9, 1, 4, 4, 8, 2].to_vec(),
    ].to_vec();
    for values in examples.into_iter() {
        let shown = f"{values}";
        println(f"{shown} -> {nodes_between_critical_points(build(values))}");
    }
    // 2000 lists of 2 to 40 values, each from 1 to 2..10
    let mut seed = 2058;
    let mut found = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 39 + 2;
        let top = next_random(mut seed) % 9 + 2;
        let d = nodes_between_critical_points(build(draw(n, top, mut seed)));
        if d[0] >= 0 {
            found += 1;
        }
        total += d[0] + d[1];
        check = (check * 31 + d[0] + 2) % 1000000007;
        check = (check * 31 + d[1] + 2) % 1000000007;
    }
    println(f"2000 short lists: {found} with two critical points, sum {total}, checksum {check}");
    // 4 lists of 2000 values, from 1 to 100000, 3, 2 and 1
    found = 0;
    total = 0;
    check = 0;
    for r in 0..4 {
        let d = nodes_between_critical_points(build(draw(2000, [100000, 3, 2, 1][r], mut seed)));
        if d[0] >= 0 {
            found += 1;
        }
        total += d[0] + d[1];
        check = (check * 31 + d[0] + 2) % 1000000007;
        check = (check * 31 + d[1] + 2) % 1000000007;
    }
    println(f"4 long lists: {found} with two critical points, sum {total}, checksum {check}");
}
