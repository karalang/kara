// LeetCode #2009: Minimum Number of Operations to Make Array Continuous --
// LeetCode's Rust template, carried to Kāra by `karac fix`. Sorted and
// deduplicated, a right pointer moving forward, as in the ★ arm.

struct Solution {}

impl Solution {
    pub fn min_operations(nums: own Vec[i32]) -> i32 {
        let mut nums = nums;
        let n = nums.len();
        nums.sort();
        nums.dedup();
        let mut kept = 0;
        let mut j = 0;
        for i in 0..nums.len() {
            while j < nums.len() and (nums[j] as i64) < nums[i] + n {
                j += 1;
            }
            kept = kept.max(j - i);
        }
        (n - kept) as i32
    }
}

fn min_operations(nums: Vec[i64]) -> i64 {
    Solution.min_operations(nums.iter().map(|x| x as i32).collect()) as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// `n` values from 1 to `top`
fn random_nums(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [4, 2, 5, 3],
        [1, 2, 3, 5, 6],
        [1, 10, 100, 1000],
        [7],
        [5, 5, 5, 5],
        [1, 3, 5, 7, 9],
        [8, 5, 9, 9, 8, 4],
        [1000000000, 1, 999999999, 2],
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {min_operations(nums)}");
    }
    let mut seed = 2009;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = next_random(mut seed) % 30 + 1;
        let answer = min_operations(random_nums(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 arrays of 1 to 12 values: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for a in 0..6 {
        let top = [5000, 1000000, 1000000000][a % 3];
        let answer = min_operations(random_nums(3000, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"6 arrays of 3000 values: sum {sum}, checksum {check}");
}
