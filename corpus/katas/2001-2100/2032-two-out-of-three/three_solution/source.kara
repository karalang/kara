// LeetCode #2032: Two Out of Three -- LeetCode's Rust template, carried to
// Kāra by `karac fix`. Each array collected into a `HashSet`, then the
// values 1 to 100 kept when at least two sets hold them, as in the ★ arm's
// ascending read.


struct Solution {}

impl Solution {
    pub fn two_out_of_three(nums1: Vec[i32], nums2: Vec[i32], nums3: Vec[i32]) -> Vec[i32] {
        let s1: Set[i32] = nums1.clone().into_iter().collect();
        let s2: Set[i32] = nums2.clone().into_iter().collect();
        let s3: Set[i32] = nums3.clone().into_iter().collect();
        (1..=100)
            .filter(|x| {
                let mut c = 0;
                if s1.contains(x) {
                    c += 1;
                }
                if s2.contains(x) {
                    c += 1;
                }
                if s3.contains(x) {
                    c += 1;
                }
                c >= 2
            })
            .collect()
    }
}

fn two_out_of_three(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64]) -> Vec[i64] {
    let a: Vec[i32] = nums1.iter().map(|x| x as i32).collect();
    let b: Vec[i32] = nums2.iter().map(|x| x as i32).collect();
    let c: Vec[i32] = nums3.iter().map(|x| x as i32).collect();
    Solution.two_out_of_three(a, b, c)
        .into_iter()
        .map(|x| x as i64)
        .collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` values from 1 to `top`
fn draw(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums = Vec.new();
    for _ in 0..n {
        nums.push(next_random(mut seed) % top + 1);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(Vec[i64], Vec[i64], Vec[i64])] = [
        ([1, 1, 3, 2], [2, 3], [3]),
        ([3, 1], [2, 3], [1, 2]),
        ([1, 2, 2], [4, 3, 3], [5]),
        ([7], [7], [7]),
        ([5, 5, 5], [6], [5]),
        ([100, 1], [1, 100], [50]),
        ([9, 8, 7], [1, 2, 3], [4, 5, 6]),
        ([4, 4, 2, 2], [2, 3, 4], [3, 3, 1]),
    ];
    for (a, b, c) in examples {
        println(f"{a} {b} {c} -> {two_out_of_three(a, b, c)}");
    }
    // 3000 problems of 1 to 20 values each, from 1 to a top of their own;
    // the answers' lengths summed and their values folded into a checksum
    let mut seed = 2032;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let top = next_random(mut seed) % 30 + 1;
        let a = draw(next_random(mut seed) % 20 + 1, top, mut seed);
        let b = draw(next_random(mut seed) % 20 + 1, top, mut seed);
        let c = draw(next_random(mut seed) % 20 + 1, top, mut seed);
        let answer = two_out_of_three(a, b, c);
        total += answer.len();
        for v in answer {
            check = (check * 31 + v) % 1000000007;
        }
    }
    println(f"3000 problems of up to 20 values: {total} values kept, checksum {check}");
    // 2000 problems of 100 values each from 1 to 100, the most the
    // constraints allow
    total = 0;
    check = 0;
    for _ in 0..2000 {
        let a = draw(100, 100, mut seed);
        let b = draw(100, 100, mut seed);
        let c = draw(100, 100, mut seed);
        let answer = two_out_of_three(a, b, c);
        total += answer.len();
        for v in answer {
            check = (check * 31 + v) % 1000000007;
        }
    }
    println(f"2000 problems of 100 values: {total} values kept, checksum {check}");
}
