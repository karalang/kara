// LeetCode #2013: Detect Squares -- the differential.
//
// All six arms against the statement read literally, on 600 problems, with
// six properties. A problem is a run of adds and counts; an arm's answer is
// the list of what its counts return.
//
// P1  the answer is the statement read literally: every three of the points
//     added (copies counted apart) that make, with the query, the four
//     corners of an axis-aligned square of positive area
// P2  every point's x and y swapped leaves the answer
// P3  every point moved by the same (dx, dy) leaves the answer
// P4  every x turned into 1000 - x leaves the answer
// P5  every add made twice multiplies each count by 8
// P6  each arm agrees with at least three of the other five

// ---- squares.kara: the ★ arm: a grid of counts, rows filled on first use
struct StarSquares {
    rows: Vec[Vec[i64]],
    points: Vec[(i64, i64)],
}

impl StarSquares {
    fn new() -> StarSquares {
        StarSquares { rows: Vec.filled(1001, Vec.new()), points: Vec.new() }
    }

    fn at(self, x: i64, y: i64) -> i64 {
        if self.rows[x].is_empty() { 0 } else { self.rows[x][y] }
    }

    fn add(mut ref self, point: (i64, i64)) {
        let (x, y) = point;
        if self.rows[x].is_empty() {
            self.rows[x] = Vec.filled(1001, 0);
        }
        if self.rows[x][y] == 0 {
            self.points.push(point);
        }
        self.rows[x][y] += 1;
    }

    fn count(self, point: (i64, i64)) -> i64 {
        let (x, y) = point;
        let mut ways = 0;
        for (px, py) in self.points {
            if px != x and (px - x).abs() == (py - y).abs() {
                ways += self.at(px, py) * self.at(x, py) * self.at(px, y);
            }
        }
        ways
    }
}

fn star_arm(ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    let mut squares = StarSquares.new();
    let mut answers: Vec[i64] = Vec.new();
    for (is_count, point) in ops {
        if is_count {
            answers.push(squares.count(point));
        } else {
            squares.add(point);
        }
    }
    answers
}

// ---- squares_map.kara: a Map of counts walked for diagonal corners
struct MapSquares {
    counts: Map[(i64, i64), i64],
}

impl MapSquares {
    fn new() -> MapSquares {
        MapSquares { counts: Map.new() }
    }

    fn add(mut ref self, point: (i64, i64)) {
        *self.counts.entry(point).or_insert(0) += 1;
    }

    fn count(self, point: (i64, i64)) -> i64 {
        let (x, y) = point;
        let mut ways = 0;
        for ((px, py), c) in self.counts {
            if px != x and (px - x).abs() == (py - y).abs() {
                ways += c * self.counts.get((x, py)).cloned().unwrap_or(0)
                    * self.counts.get((px, y)).cloned().unwrap_or(0);
            }
        }
        ways
    }
}

fn map_arm(ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    let mut squares = MapSquares.new();
    let mut answers: Vec[i64] = Vec.new();
    for (is_count, point) in ops {
        if is_count {
            answers.push(squares.count(point));
        } else {
            squares.add(point);
        }
    }
    answers
}

// ---- squares_columns.kara: a Map of columns, each a Map of counts
struct ColumnSquares {
    columns: Map[i64, Map[i64, i64]],
}

impl ColumnSquares {
    fn new() -> ColumnSquares {
        ColumnSquares { columns: Map.new() }
    }

    fn add(mut ref self, point: (i64, i64)) {
        let (x, y) = point;
        *self.columns.entry(x).or_insert(Map.new()).entry(y).or_insert(0) += 1;
    }

    fn at(self, x: i64, y: i64) -> i64 {
        match self.columns.get(x) {
            Some(column) => column.get(y).cloned().unwrap_or(0),
            None => 0,
        }
    }

    fn count(self, point: (i64, i64)) -> i64 {
        let (x, y) = point;
        let Some(column) = self.columns.get(x) else {
            return 0;
        };
        let mut ways = 0;
        for (y2, c) in column {
            if y2 == y {
                continue;
            }
            let d = y2 - y;
            for px in [x - d, x + d] {
                ways += c * self.at(px, y) * self.at(px, y2);
            }
        }
        ways
    }
}

fn columns_arm(ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    let mut squares = ColumnSquares.new();
    let mut answers: Vec[i64] = Vec.new();
    for (is_count, point) in ops {
        if is_count {
            answers.push(squares.count(point));
        } else {
            squares.add(point);
        }
    }
    answers
}

// ---- squares_brute.kara: every point kept, the corners counted by walking
struct BruteSquares {
    points: Vec[(i64, i64)],
}

impl BruteSquares {
    fn new() -> BruteSquares {
        BruteSquares { points: Vec.new() }
    }

    fn add(mut ref self, point: (i64, i64)) {
        self.points.push(point);
    }

    fn count(self, point: (i64, i64)) -> i64 {
        let (x, y) = point;
        let mut ways = 0;
        for (px, py) in self.points {
            if px == x or (px - x).abs() != (py - y).abs() {
                continue;
            }
            let mut same_column = 0;
            let mut same_row = 0;
            for (qx, qy) in self.points {
                if qx == x and qy == py {
                    same_column += 1;
                }
                if qx == px and qy == y {
                    same_row += 1;
                }
            }
            ways += same_column * same_row;
        }
        ways
    }
}

fn brute_arm(ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    let mut squares = BruteSquares.new();
    let mut answers: Vec[i64] = Vec.new();
    for (is_count, point) in ops {
        if is_count {
            answers.push(squares.count(point));
        } else {
            squares.add(point);
        }
    }
    answers
}

// ---- squares_sorted.kara: a SortedMap of counts read a column at a time
struct SortedSquares {
    counts: SortedMap[(i64, i64), i64],
}

impl SortedSquares {
    fn new() -> SortedSquares {
        SortedSquares { counts: SortedMap.new() }
    }

    fn add(mut ref self, point: (i64, i64)) {
        *self.counts.entry(point).or_insert(0) += 1;
    }

    fn count(self, point: (i64, i64)) -> i64 {
        let (x, y) = point;
        let mut ways = 0;
        for ((_, y2), c) in self.counts.range_inclusive((x, 0), (x, 1000)) {
            let d = y2 - y;
            if d == 0 {
                continue;
            }
            for px in [x - d, x + d] {
                let row = self.counts.get((px, y)).cloned().unwrap_or(0);
                let corner = self.counts.get((px, y2)).cloned().unwrap_or(0);
                ways += c * row * corner;
            }
        }
        ways
    }
}

fn sorted_arm(ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    let mut squares = SortedSquares.new();
    let mut answers: Vec[i64] = Vec.new();
    for (is_count, point) in ops {
        if is_count {
            answers.push(squares.count(point));
        } else {
            squares.add(point);
        }
    }
    answers
}

// ---- squares_solution.kara: LeetCode's Rust template after karac fix
struct DetectSquares {
    cnt: Map[(i32, i32), i32],
    pts: Vec[(i32, i32)],
}

impl DetectSquares {
    fn new() -> Self {
        DetectSquares { cnt: Map.new(), pts: Vec.new() }
    }

    fn add(mut ref self, point: Vec[i32]) {
        let p = (point[0], point[1]);
        let c = self.cnt.entry(p).or_insert(0);
        if *c == 0 {
            self.pts.push(p);
        }
        *c += 1;
    }

    fn count(self, point: Vec[i32]) -> i32 {
        let (x, y) = (point[0], point[1]);
        let mut ans: i32 = 0;
        for (px, py) in ref self.pts {
            if px != x and (px - x).abs() == (py - y).abs() {
                ans += self.cnt[(px, py)]
                    * self.cnt.get((x, py)).unwrap_or(0)
                    * self.cnt.get((px, y)).unwrap_or(0);
            }
        }
        ans
    }
}

fn rust_arm(ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    let mut squares = DetectSquares.new();
    let mut answers: Vec[i64] = Vec.new();
    for (is_count, point) in ops {
        if is_count {
            answers.push(squares.count([point.0 as i32, point.1 as i32]) as i64);
        } else {
            squares.add([point.0 as i32, point.1 as i32]);
        }
    }
    answers
}

// ---- the literal reading and the checks ------------------------------------

// whether four points are the corners of an axis-aligned square of positive
// area: two x values and two y values, `side` apart, each corner once
fn is_square(points: Vec[(i64, i64)]) -> bool {
    let xs: Vec[i64] = points.iter().map(|p| p.0).collect();
    let ys: Vec[i64] = points.iter().map(|p| p.1).collect();
    let low_x = xs.iter().min().cloned().unwrap();
    let high_x = xs.iter().max().cloned().unwrap();
    let low_y = ys.iter().min().cloned().unwrap();
    let high_y = ys.iter().max().cloned().unwrap();
    if high_x == low_x or high_x - low_x != high_y - low_y {
        return false;
    }
    let corners = [(low_x, low_y), (low_x, high_y), (high_x, low_y), (high_x, high_y)];
    for c in corners {
        if points.iter().filter(|p| p == c).count() != 1 {
            return false;
        }
    }
    true
}

fn literal(ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    let mut added: Vec[(i64, i64)] = Vec.new();
    let mut answers: Vec[i64] = Vec.new();
    for (is_count, point) in ops {
        if not is_count {
            added.push(point);
            continue;
        }
        let n = added.len();
        let mut ways = 0;
        for i in 0..n {
            for j in i + 1..n {
                for k in j + 1..n {
                    if is_square([point, added[i], added[j], added[k]]) {
                        ways += 1;
                    }
                }
            }
        }
        answers.push(ways);
    }
    answers
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Problem {
    ops: Vec[(bool, (i64, i64))],
    dx: i64,
    dy: i64,
}

fn draw(seed: mut ref i64) -> Problem {
    let n = next_random(mut seed) % 25 + 1;
    let side = next_random(mut seed) % 5 + 1;
    let every = next_random(mut seed) % 3 + 2;
    let base_x = next_random(mut seed) % 900;
    let base_y = next_random(mut seed) % 900;
    let mut ops: Vec[(bool, (i64, i64))] = Vec.new();
    for _ in 0..n {
        let point = (base_x + next_random(mut seed) % side, base_y + next_random(mut seed) % side);
        ops.push((next_random(mut seed) % every == 0, point));
    }
    let dx = next_random(mut seed) % 90;
    let dy = next_random(mut seed) % 90;
    Problem { ops, dx, dy }
}

fn answer(arm: i64, ops: Vec[(bool, (i64, i64))]) -> Vec[i64] {
    match arm {
        0 => star_arm(ops),
        1 => map_arm(ops),
        2 => columns_arm(ops),
        3 => brute_arm(ops),
        4 => sorted_arm(ops),
        _ => rust_arm(ops),
    }
}

fn main() {
    let names = ["star", "map", "columns", "brute", "sorted", "rust"];
    let mut seed = 2013;
    let mut problems: Vec[Problem] = Vec.new();
    for _ in 0..600 {
        problems.push(draw(mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for p in 0..problems.len() {
        let prob = ref problems[p];
        let ops = prob.ops.clone();
        let truth = literal(ops.clone());
        for t in truth.iter() {
            check = (check * 31 + t) % 1000000007;
        }
        let swapped: Vec[(bool, (i64, i64))] = ops.iter().map(|(c, (x, y))| (c, (y, x))).collect();
        let moved: Vec[(bool, (i64, i64))] =
            ops.iter().map(|(c, (x, y))| (c, (x + prob.dx, y + prob.dy))).collect();
        let mirrored: Vec[(bool, (i64, i64))] = ops.iter().map(|(c, (x, y))| (c, (1000 - x, y))).collect();
        let mut twice: Vec[(bool, (i64, i64))] = Vec.new();
        for (c, point) in ops.iter() {
            twice.push((c, point));
            if not c {
                twice.push((c, point));
            }
        }
        let mut got: Vec[Vec[i64]] = Vec.new();
        for arm in 0..6 {
            got.push(answer(arm, ops.clone()));
        }
        for arm in 0..6 {
            let a = got[arm].clone();
            let mut same = 0;
            for other in 0..6 {
                if other != arm and got[other] == a {
                    same += 1;
                }
            }
            let eightfold: Vec[i64] = a.iter().map(|w| 8 * w).collect();
            let verdicts = [
                a == truth,
                answer(arm, swapped.clone()) == a,
                answer(arm, moved.clone()) == a,
                answer(arm, mirrored.clone()) == a,
                answer(arm, twice.clone()) == eightfold,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"problem {p} arm {names[arm]}: P{q + 1} fails, ops {ops}, answer {a}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"600 problems: checksum {check}, {checks} checks over 6 arms: {total} failures");
    for f in failures {
        println(f);
    }
    for q in 0..6 {
        if by_property[q] > 0 {
            println(f"P{q + 1} {by_property[q]}");
        }
    }
}
