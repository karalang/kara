// LeetCode #2013: Detect Squares -- LeetCode's Rust template, carried to
// Kāra by `karac fix`. A `HashMap` of counts and a list of the distinct
// points, as in the ★ arm.


struct DetectSquares {
    cnt: Map[(i32, i32), i32],
    pts: Vec[(i32, i32)],
}

impl DetectSquares {
    fn new() -> Self {
        DetectSquares { cnt: Map.new(), pts: Vec.new() }
    }

    fn add(mut ref self, point: Vec[i32]) {
        let p = (point[0], point[1]);
        let c = self.cnt.entry(p).or_insert(0);
        if *c == 0 {
            self.pts.push(p);
        }
        *c += 1;
    }

    fn count(self, point: Vec[i32]) -> i32 {
        let (x, y) = (point[0], point[1]);
        let mut ans: i32 = 0;
        for (px, py) in ref self.pts {
            if px != x and (px - x).abs() == (py - y).abs() {
                ans += self.cnt[(px, py)]
                    * self.cnt.get((x, py)).unwrap_or(0)
                    * self.cnt.get((px, y)).unwrap_or(0);
            }
        }
        ans
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// `ops` operations on points from `base` to `base + side - 1` on each axis,
// one in `every` a count and the rest adds; the counts' answers summed
fn run(ops: i64, base: i64, side: i64, every: i64, seed: mut ref i64) -> (i64, i64) {
    let mut squares = DetectSquares.new();
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..ops {
        let point = (base + next_random(mut seed) % side, base + next_random(mut seed) % side);
        if next_random(mut seed) % every == 0 {
            let ways = squares.count([point.0 as i32, point.1 as i32]) as i64;
            sum += ways;
            check = mix(check, ways);
        } else {
            squares.add([point.0 as i32, point.1 as i32]);
        }
    }
    (sum, check)
}

fn main() {
    // LeetCode's example, then a few more
    let mut squares = DetectSquares.new();
    squares.add([3, 10]);
    squares.add([11, 2]);
    squares.add([3, 2]);
    println(f"count (11, 10) -> {squares.count(vec![11, 10])}");
    println(f"count (14, 8) -> {squares.count(vec![14, 8])}");
    squares.add([11, 2]);
    println(f"count (11, 10) -> {squares.count(vec![11, 10])}");
    squares.add([3, 18]);
    squares.add([11, 18]);
    println(f"count (3, 10) -> {squares.count(vec![3, 10])}");
    println(f"count (3, 2) -> {squares.count(vec![3, 2])}");
    println(f"count (19, 10) -> {squares.count(vec![19, 10])}");
    squares.add([0, 0]);
    squares.add([1000, 1000]);
    squares.add([0, 1000]);
    println(f"count (1000, 0) -> {squares.count(vec![1000, 0])}");
    let mut seed = 2013;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..200 {
        let ops = next_random(mut seed) % 40 + 1;
        let side = next_random(mut seed) % 6 + 1;
        let every = next_random(mut seed) % 4 + 2;
        let (s, c) = run(ops, next_random(mut seed) % 990, side, every, mut seed);
        sum += s;
        check = mix(check, c);
    }
    println(f"200 runs of 1 to 40 operations: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for a in 0..4 {
        let side = [10, 20, 40, 1001][a];
        let (s, c) = run(400, 0, side, 3, mut seed);
        sum += s;
        check = mix(check, c);
    }
    println(f"4 runs of 400 operations: sum {sum}, checksum {check}");
}
