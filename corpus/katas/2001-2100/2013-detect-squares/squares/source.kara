// LeetCode #2013: Detect Squares -- the ★ arm. The points added are counted
// on a grid of 1001 by 1001 whose rows are filled in when first used; each
// distinct point is also kept once in a list. A square through the query
// point has a diagonal corner `(px, py)` with `|px - x| == |py - y| > 0`,
// and its other two corners are then `(x, py)` and `(px, y)`, so a query
// walks the distinct points and multiplies the three counts. O(1) per add,
// O(distinct) per count.

struct DetectSquares {
    rows: Vec[Vec[i64]],
    points: Vec[(i64, i64)],
}

impl DetectSquares {
    fn new() -> DetectSquares {
        DetectSquares { rows: Vec.filled(1001, Vec.new()), points: Vec.new() }
    }

    fn at(self, x: i64, y: i64) -> i64 {
        if self.rows[x].is_empty() { 0 } else { self.rows[x][y] }
    }

    fn add(mut ref self, point: (i64, i64)) {
        let (x, y) = point;
        if self.rows[x].is_empty() {
            self.rows[x] = Vec.filled(1001, 0);
        }
        if self.rows[x][y] == 0 {
            self.points.push(point);
        }
        self.rows[x][y] += 1;
    }

    fn count(self, point: (i64, i64)) -> i64 {
        let (x, y) = point;
        let mut ways = 0;
        for (px, py) in self.points {
            if px != x and (px - x).abs() == (py - y).abs() {
                ways += self.at(px, py) * self.at(x, py) * self.at(px, y);
            }
        }
        ways
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// `ops` operations on points from `base` to `base + side - 1` on each axis,
// one in `every` a count and the rest adds; the counts' answers summed
fn run(ops: i64, base: i64, side: i64, every: i64, seed: mut ref i64) -> (i64, i64) {
    let mut squares = DetectSquares.new();
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..ops {
        let point = (base + next_random(mut seed) % side, base + next_random(mut seed) % side);
        if next_random(mut seed) % every == 0 {
            let ways = squares.count(point);
            sum += ways;
            check = mix(check, ways);
        } else {
            squares.add(point);
        }
    }
    (sum, check)
}

fn main() {
    // LeetCode's example, then a few more
    let mut squares = DetectSquares.new();
    squares.add((3, 10));
    squares.add((11, 2));
    squares.add((3, 2));
    println(f"count (11, 10) -> {squares.count((11, 10))}");
    println(f"count (14, 8) -> {squares.count((14, 8))}");
    squares.add((11, 2));
    println(f"count (11, 10) -> {squares.count((11, 10))}");
    squares.add((3, 18));
    squares.add((11, 18));
    println(f"count (3, 10) -> {squares.count((3, 10))}");
    println(f"count (3, 2) -> {squares.count((3, 2))}");
    println(f"count (19, 10) -> {squares.count((19, 10))}");
    squares.add((0, 0));
    squares.add((1000, 1000));
    squares.add((0, 1000));
    println(f"count (1000, 0) -> {squares.count((1000, 0))}");
    let mut seed = 2013;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..200 {
        let ops = next_random(mut seed) % 40 + 1;
        let side = next_random(mut seed) % 6 + 1;
        let every = next_random(mut seed) % 4 + 2;
        let (s, c) = run(ops, next_random(mut seed) % 990, side, every, mut seed);
        sum += s;
        check = mix(check, c);
    }
    println(f"200 runs of 1 to 40 operations: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for a in 0..4 {
        let side = [10, 20, 40, 1001][a];
        let (s, c) = run(400, 0, side, 3, mut seed);
        sum += s;
        check = mix(check, c);
    }
    println(f"4 runs of 400 operations: sum {sum}, checksum {check}");
}
