// LeetCode #2014: Longest Subsequence Repeated k Times -- the ★ arm's
// benchmark. A breadth-first search grows the candidates one letter at a
// time from the empty string, over the letters seen at least `k` times,
// keeping each that still repeats `k` times; the last found is the answer.

// whether `t` written `k` times is a subsequence of `s`
fn repeats(s: String, t: String, k: i64) -> bool {
    let want: Vec[char] = t.chars().collect();
    let mut i = 0;
    let mut found = 0;
    for c in s.chars() {
        if c == want[i] {
            i += 1;
            if i == want.len() {
                found += 1;
                if found == k {
                    return true;
                }
                i = 0;
            }
        }
    }
    false
}

fn longest_subsequence_repeated_k(s: String, k: i64) -> String {
    let mut counts = [0; 26];
    for c in s.chars() {
        counts[c as i64 - 'a' as i64] += 1;
    }
    let mut letters: Vec[char] = Vec.new();
    for i in 0..26 {
        if counts[i] >= k {
            letters.push(('a' as i64 + i) as u8 as char);
        }
    }
    let mut queue: VecDeque[String] = VecDeque.new();
    queue.push_back(String.new());
    let mut best = String.new();
    while let Some(t) = queue.pop_front() {
        for c in letters.iter() {
            let mut next = t.clone();
            next.push(c);
            if repeats(s, next, k) {
                best = next.clone();
                queue.push_back(next);
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a string of `n` letters from the first `letters` of the alphabet: a
// pattern of up to 7 letters written out again and again, each letter of
// it kept with odds 9 in 10, with a stray letter after it with odds 1 in 10
fn random_text(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut pattern: Vec[char] = Vec.new();
    for _ in 0..next_random(mut seed) % 7 + 1 {
        pattern.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
    }
    let mut text = String.new();
    let mut at = 0;
    while text.len() < n {
        if next_random(mut seed) % 10 < 9 {
            text.push(pattern[at]);
        }
        if text.len() < n and next_random(mut seed) % 10 < 1 {
            text.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
        }
        at = (at + 1) % pattern.len();
    }
    text
}

fn main() {
    // 200 strings of 2000 letters from 2 to 9 letters, each with its own
    // k from 251 to 300, built once; the ★ arm on each for 5 rounds
    let mut seed = 2014;
    let mut cases: Vec[(String, i64)] = Vec.new();
    for c in 0..200 {
        let k = 251 + next_random(mut seed) % 50;
        cases.push((random_text(2000, c % 8 + 2, mut seed), k));
    }
    let mut calls = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..5 {
        for (s, k) in cases.iter() {
            let answer = longest_subsequence_repeated_k(s, k);
            calls += 1;
            total += answer.len();
            for c in answer.chars() {
                check = (check * 31 + (c as i64)) % 1000000007;
            }
            check = (check * 31 + answer.len()) % 1000000007;
        }
    }
    println(f"{calls} calls: total length {total}, checksum {check}");
}
