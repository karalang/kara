// LeetCode #2014: Longest Subsequence Repeated k Times -- the table arm.
// The same breadth-first search as the ★ arm, but a candidate is checked
// by jumping through a table of where each letter next occurs: `next[i][c]`
// is the first index at or after `i` holding letter `c`, or `n`. Writing
// the candidate `k` times is then `k * |t|` jumps, however long `s` is.
// O(26 n) to build the table.

// `next[i][c]`: the first index at or after `i` holding letter `c`, or `n`
fn next_table(s: String) -> Vec[Vec[i64]] {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut next: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(26, n));
    for i in (0..n).rev() {
        next[i] = next[i + 1].clone();
        next[i][letters[i] as i64 - 'a' as i64] = i;
    }
    next
}

// whether `t` written `k` times is a subsequence of the string `next` was
// built from
fn repeats(next: Vec[Vec[i64]], t: Vec[i64], k: i64) -> bool {
    let n = next.len() - 1;
    let mut at = 0;
    for _ in 0..k {
        for c in t.iter() {
            if at == n or next[at][c] == n {
                return false;
            }
            at = next[at][c] + 1;
        }
    }
    true
}

fn longest_subsequence_repeated_k(s: String, k: i64) -> String {
    let next = next_table(s);
    let mut counts = [0; 26];
    for c in s.chars() {
        counts[c as i64 - 'a' as i64] += 1;
    }
    let letters: Vec[i64] = (0..26).filter(|c| counts[c] >= k).collect();
    let mut queue: VecDeque[Vec[i64]] = VecDeque.new();
    queue.push_back(Vec.new());
    let mut best: Vec[i64] = Vec.new();
    while let Some(t) = queue.pop_front() {
        for c in letters.iter() {
            let mut grown = t.clone();
            grown.push(c);
            if repeats(next, grown, k) {
                best = grown.clone();
                queue.push_back(grown);
            }
        }
    }
    best.iter().map(|c| ('a' as i64 + c) as u8 as char).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: String) -> i64 {
    let mut check = (check * 31 + answer.len()) % 1000000007;
    for c in answer.chars() {
        check = (check * 31 + (c as i64)) % 1000000007;
    }
    check
}

// a string of `n` letters from the first `letters` of the alphabet: a
// pattern of up to `width` letters written out again and again, each letter
// of it kept with odds `keep` in 10, with a stray letter after it with odds
// `noise` in 10
fn random_text(n: i64, letters: i64, width: i64, keep: i64, noise: i64, seed: mut ref i64) -> String {
    let mut pattern: Vec[char] = Vec.new();
    for _ in 0..next_random(mut seed) % width + 1 {
        pattern.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
    }
    let mut text = String.new();
    let mut at = 0;
    while text.len() < n {
        if next_random(mut seed) % 10 < keep {
            text.push(pattern[at]);
        }
        if text.len() < n and next_random(mut seed) % 10 < noise {
            text.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
        }
        at = (at + 1) % pattern.len();
    }
    text
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        ("letsleetcode", 2),
        ("bb", 2),
        ("ab", 2),
        ("bbabbabbbbabaababab", 3),
        ("zzzzzzzzzzzzzzz", 2),
        ("abcabcabcabc", 4),
        ("cbacbacba", 3),
        ("aabbaabb", 3),
    ];
    for (s, k) in examples {
        println(f"\"{s}\", k = {k} -> \"{longest_subsequence_repeated_k(s, k)}\"");
    }
    let mut seed = 2014;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let k = next_random(mut seed) % 5 + 2;
        let n = next_random(mut seed) % (8 * k - 2).min(30) + 2;
        let letters = next_random(mut seed) % 5 + 1;
        let width = next_random(mut seed) % 4 + 1;
        let keep = next_random(mut seed) % 5 + 6;
        let noise = next_random(mut seed) % 5;
        let s = random_text(n, letters, width, keep, noise, mut seed);
        let answer = longest_subsequence_repeated_k(s, k);
        total += answer.len();
        check = mix(check, answer);
    }
    println(f"2000 strings of 2 to 31 letters: total length {total}, checksum {check}");
    total = 0;
    check = 0;
    for a in 0..6 {
        let k = [251, 260, 300, 400, 251, 285][a];
        let letters = [3, 8, 26, 2, 5, 12][a];
        let s = random_text(2000, letters, 7, 9, 2, mut seed);
        let answer = longest_subsequence_repeated_k(s, k);
        total += answer.len();
        check = mix(check, answer);
    }
    println(f"6 strings of 2000 letters: total length {total}, checksum {check}");
}
