// LeetCode #2014: Longest Subsequence Repeated k Times -- the levels arm.
// The valid candidates of each length kept in a `SortedSet`. Dropping a
// letter from a valid candidate leaves a valid one, so `t + c` is worth
// checking only when `t` without its first letter, then `c`, is already in
// the level; the answer is the last, largest, member of the last level
// that is not empty.

// whether `t` written `k` times is a subsequence of `s`
fn repeats(s: String, t: String, k: i64) -> bool {
    let want: Vec[char] = t.chars().collect();
    let mut i = 0;
    let mut found = 0;
    for c in s.chars() {
        if c == want[i] {
            i += 1;
            if i == want.len() {
                found += 1;
                if found == k {
                    return true;
                }
                i = 0;
            }
        }
    }
    false
}

fn longest_subsequence_repeated_k(s: String, k: i64) -> String {
    let mut counts: Map[char, i64] = Map.new();
    for c in s.chars() {
        *counts.entry(c).or_insert(0) += 1;
    }
    let mut level: SortedSet[String] = SortedSet.new();
    for (c, n) in counts {
        if n >= k {
            level.insert(f"{c}");
        }
    }
    let letters: Vec[String] = level.iter().cloned().collect();
    let mut best = String.new();
    while let Some(last) = level.max() {
        best = last.clone();
        let mut grown: SortedSet[String] = SortedSet.new();
        for t in level.iter() {
            for c in letters.iter() {
                let tail = f"{t.substring(1, t.len())}{c}";
                if t.len() > 1 and not level.contains(tail) {
                    continue;
                }
                let candidate = f"{t}{c}";
                if repeats(s, candidate, k) {
                    grown.insert(candidate);
                }
            }
        }
        level = grown;
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: String) -> i64 {
    let mut check = (check * 31 + answer.len()) % 1000000007;
    for c in answer.chars() {
        check = (check * 31 + (c as i64)) % 1000000007;
    }
    check
}

// a string of `n` letters from the first `letters` of the alphabet: a
// pattern of up to `width` letters written out again and again, each letter
// of it kept with odds `keep` in 10, with a stray letter after it with odds
// `noise` in 10
fn random_text(n: i64, letters: i64, width: i64, keep: i64, noise: i64, seed: mut ref i64) -> String {
    let mut pattern: Vec[char] = Vec.new();
    for _ in 0..next_random(mut seed) % width + 1 {
        pattern.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
    }
    let mut text = String.new();
    let mut at = 0;
    while text.len() < n {
        if next_random(mut seed) % 10 < keep {
            text.push(pattern[at]);
        }
        if text.len() < n and next_random(mut seed) % 10 < noise {
            text.push(('a' as i64 + next_random(mut seed) % letters) as u8 as char);
        }
        at = (at + 1) % pattern.len();
    }
    text
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        ("letsleetcode", 2),
        ("bb", 2),
        ("ab", 2),
        ("bbabbabbbbabaababab", 3),
        ("zzzzzzzzzzzzzzz", 2),
        ("abcabcabcabc", 4),
        ("cbacbacba", 3),
        ("aabbaabb", 3),
    ];
    for (s, k) in examples {
        println(f"\"{s}\", k = {k} -> \"{longest_subsequence_repeated_k(s, k)}\"");
    }
    let mut seed = 2014;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let k = next_random(mut seed) % 5 + 2;
        let n = next_random(mut seed) % (8 * k - 2).min(30) + 2;
        let letters = next_random(mut seed) % 5 + 1;
        let width = next_random(mut seed) % 4 + 1;
        let keep = next_random(mut seed) % 5 + 6;
        let noise = next_random(mut seed) % 5;
        let s = random_text(n, letters, width, keep, noise, mut seed);
        let answer = longest_subsequence_repeated_k(s, k);
        total += answer.len();
        check = mix(check, answer);
    }
    println(f"2000 strings of 2 to 31 letters: total length {total}, checksum {check}");
    total = 0;
    check = 0;
    for a in 0..6 {
        let k = [251, 260, 300, 400, 251, 285][a];
        let letters = [3, 8, 26, 2, 5, 12][a];
        let s = random_text(2000, letters, 7, 9, 2, mut seed);
        let answer = longest_subsequence_repeated_k(s, k);
        total += answer.len();
        check = mix(check, answer);
    }
    println(f"6 strings of 2000 letters: total length {total}, checksum {check}");
}
