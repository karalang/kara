// LeetCode #2036: Maximum Alternating Subarray Sum -- Kadane twice over
// the signed values. Give each value the sign its index has from an even
// start, `(-1)^t nums[t]`; a subarray starting at an even index sums to
// its signed sum, one starting at an odd index to the negated sum. Each
// pass is Kadane's scan that may restart only at a start of its parity.
// O(n).

fn best_from(signed: Vec[i64], parity: i64) -> Option[i64] {
    let mut best: Option[i64] = None;
    let mut run: Option[i64] = None;
    for t in 0..signed.len() {
        let x = signed[t];
        run = match run {
            Some(r) if t % 2 != parity or r > 0 => Some(r + x),
            Some(r) => Some(x),
            None if t % 2 == parity => Some(x),
            None => None,
        };
        if let Some(r) = run {
            best = Some(best.map_or(r, |b| b.max(r)));
        }
    }
    best
}

fn maximum_alternating_subarray_sum(nums: Vec[i64]) -> i64 {
    let even: Vec[i64] = nums.iter().enumerate().map(|(t, x)| if t % 2 == 0 { x } else { -x }).collect();
    let odd: Vec[i64] = even.iter().map(|x| -x).collect();
    let from_even = best_from(even, 0).unwrap();
    match best_from(odd, 1) {
        Some(b) => from_even.max(b),
        None => from_even,
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer.rem_euclid(1000000007)) % 1000000007
}

// `n` values from `-top` to `top`
fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, -1, 1, 2],
        [2, 2, 2, 2, 2],
        [1],
        [-5],
        [-3, -1, -4],
        [1, 100, 1],
        [5, -5, 5, -5],
        [-100000, 100000, -100000, 100000, -100000],
    ];
    for nums in examples {
        println(f"{nums} -> {maximum_alternating_subarray_sum(nums)}");
    }
    // 2000 arrays of 1 to 12 values up to 50 either side
    let mut seed = 2036;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let answer = maximum_alternating_subarray_sum(random_values(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 arrays of up to 12 values: sum {sum}, checksum {check}");
    // 4 arrays of 100000 values, the most the constraints allow
    sum = 0;
    check = 0;
    for a in 0..4 {
        let top = [100000, 1000, 100000, 3][a];
        let answer = maximum_alternating_subarray_sum(random_values(100000, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 arrays of 100000 values: sum {sum}, checksum {check}");
}
