// LeetCode #2036: Maximum Alternating Subarray Sum -- LeetCode's Rust
// template, carried to Kāra by `karac fix`. Two running sums over `i64`s
// widened from the `i32` input, the one ending on a minus seeded with
// `i64::MIN / 2` so adding to it cannot overflow.

impl Solution {
    pub fn maximum_alternating_subarray_sum(nums: Vec[i32]) -> i64 {
        let mut plus = nums[0] as i64;
        let mut minus = i64.MIN / 2;
        let mut ans = plus;
        for i in 1..nums.len() {
            let x = nums[i] as i64;
            let next_plus = x.max(minus + x);
            let next_minus = plus - x;
            plus = next_plus;
            minus = next_minus;
            ans = ans.max(plus).max(minus);
        }
        ans
    }
}

struct Solution {}

fn maximum_alternating_subarray_sum(nums: Vec[i64]) -> i64 {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.maximum_alternating_subarray_sum(v)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer.rem_euclid(1000000007)) % 1000000007
}

// `n` values from `-top` to `top`
fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, -1, 1, 2],
        [2, 2, 2, 2, 2],
        [1],
        [-5],
        [-3, -1, -4],
        [1, 100, 1],
        [5, -5, 5, -5],
        [-100000, 100000, -100000, 100000, -100000],
    ];
    for nums in examples {
        println(f"{nums} -> {maximum_alternating_subarray_sum(nums)}");
    }
    // 2000 arrays of 1 to 12 values up to 50 either side
    let mut seed = 2036;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let answer = maximum_alternating_subarray_sum(random_values(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 arrays of up to 12 values: sum {sum}, checksum {check}");
    // 4 arrays of 100000 values, the most the constraints allow
    sum = 0;
    check = 0;
    for a in 0..4 {
        let top = [100000, 1000, 100000, 3][a];
        let answer = maximum_alternating_subarray_sum(random_values(100000, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 arrays of 100000 values: sum {sum}, checksum {check}");
}
