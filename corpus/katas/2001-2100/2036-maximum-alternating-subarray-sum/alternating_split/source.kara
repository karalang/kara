// LeetCode #2036: Maximum Alternating Subarray Sum -- divide and conquer
// over the signed values `a[t] = (-1)^t nums[t]`. A subarray starting at an
// even index sums to its `a` sum, one starting at an odd index to minus
// it. Each range reports its total, its largest and smallest prefix sum,
// its largest suffix sum starting at an even index and smallest starting at
// an odd one, and its answer; two halves combine across the cut. 2 n - 1
// calls, O(n) work, recursion O(log n) deep.

struct Part {
    total: i64,
    high_prefix: i64,
    low_prefix: i64,
    high_even_suffix: Option[i64],
    low_odd_suffix: Option[i64],
    best: i64,
}

fn leaf(t: i64, value: i64) -> Part {
    let a = if t % 2 == 0 { value } else { -value };
    Part {
        total: a,
        high_prefix: a,
        low_prefix: a,
        high_even_suffix: if t % 2 == 0 { Some(a) } else { None },
        low_odd_suffix: if t % 2 == 1 { Some(a) } else { None },
        best: value,
    }
}

fn join(left: Part, right: Part) -> Part {
    let mut best = left.best.max(right.best);
    if let Some(s) = left.high_even_suffix {
        best = best.max(s + right.high_prefix);
    }
    if let Some(s) = left.low_odd_suffix {
        best = best.max(-(s + right.low_prefix));
    }
    Part {
        total: left.total + right.total,
        high_prefix: left.high_prefix.max(left.total + right.high_prefix),
        low_prefix: left.low_prefix.min(left.total + right.low_prefix),
        high_even_suffix: match (left.high_even_suffix, right.high_even_suffix) {
            (Some(l), Some(r)) => Some(r.max(l + right.total)),
            (Some(l), None) => Some(l + right.total),
            (None, r) => r,
        },
        low_odd_suffix: match (left.low_odd_suffix, right.low_odd_suffix) {
            (Some(l), Some(r)) => Some(r.min(l + right.total)),
            (Some(l), None) => Some(l + right.total),
            (None, r) => r,
        },
        best,
    }
}

fn solve(nums: Vec[i64], lo: i64, hi: i64) -> Part {
    if hi - lo == 1 {
        return leaf(lo, nums[lo]);
    }
    let mid = (lo + hi) / 2;
    join(solve(nums, lo, mid), solve(nums, mid, hi))
}

fn maximum_alternating_subarray_sum(nums: Vec[i64]) -> i64 {
    solve(nums, 0, nums.len()).best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer.rem_euclid(1000000007)) % 1000000007
}

// `n` values from `-top` to `top`
fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, -1, 1, 2],
        [2, 2, 2, 2, 2],
        [1],
        [-5],
        [-3, -1, -4],
        [1, 100, 1],
        [5, -5, 5, -5],
        [-100000, 100000, -100000, 100000, -100000],
    ];
    for nums in examples {
        println(f"{nums} -> {maximum_alternating_subarray_sum(nums)}");
    }
    // 2000 arrays of 1 to 12 values up to 50 either side
    let mut seed = 2036;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let answer = maximum_alternating_subarray_sum(random_values(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 arrays of up to 12 values: sum {sum}, checksum {check}");
    // 4 arrays of 100000 values, the most the constraints allow
    sum = 0;
    check = 0;
    for a in 0..4 {
        let top = [100000, 1000, 100000, 3][a];
        let answer = maximum_alternating_subarray_sum(random_values(100000, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 arrays of 100000 values: sum {sum}, checksum {check}");
}
