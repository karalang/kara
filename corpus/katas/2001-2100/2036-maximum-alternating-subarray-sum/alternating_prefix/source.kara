// LeetCode #2036: Maximum Alternating Subarray Sum -- alternating prefix
// sums. With `s[k]` the sum of `(-1)^t nums[t]` for `t < k`, the subarray
// `i..=j` sums to `s[j + 1] - s[i]` when `i` is even and `s[i] - s[j + 1]`
// when `i` is odd. One scan keeps the smallest `s` at an even index and the
// largest at an odd one seen so far. O(n).

fn maximum_alternating_subarray_sum(nums: Vec[i64]) -> i64 {
    let mut s = 0;
    let mut low_even = 0;
    let mut high_odd: Option[i64] = None;
    let mut best = nums[0];
    for (t, x) in nums.iter().enumerate() {
        // s is s[t]; record it as a start before stepping past t
        if t % 2 == 0 {
            low_even = low_even.min(s);
        } else {
            high_odd = Some(high_odd.map_or(s, |h| h.max(s)));
        }
        s += if t % 2 == 0 { x } else { -x };
        best = best.max(s - low_even);
        if let Some(h) = high_odd {
            best = best.max(h - s);
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer.rem_euclid(1000000007)) % 1000000007
}

// `n` values from `-top` to `top`
fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * top + 1) - top);
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [3, -1, 1, 2],
        [2, 2, 2, 2, 2],
        [1],
        [-5],
        [-3, -1, -4],
        [1, 100, 1],
        [5, -5, 5, -5],
        [-100000, 100000, -100000, 100000, -100000],
    ];
    for nums in examples {
        println(f"{nums} -> {maximum_alternating_subarray_sum(nums)}");
    }
    // 2000 arrays of 1 to 12 values up to 50 either side
    let mut seed = 2036;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let answer = maximum_alternating_subarray_sum(random_values(n, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"2000 arrays of up to 12 values: sum {sum}, checksum {check}");
    // 4 arrays of 100000 values, the most the constraints allow
    sum = 0;
    check = 0;
    for a in 0..4 {
        let top = [100000, 1000, 100000, 3][a];
        let answer = maximum_alternating_subarray_sum(random_values(100000, top, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"4 arrays of 100000 values: sum {sum}, checksum {check}");
}
