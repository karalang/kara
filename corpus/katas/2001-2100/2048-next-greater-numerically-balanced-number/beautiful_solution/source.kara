// LeetCode #2048: Next Greater Numerically Balanced Number -- LeetCode's
// Rust template (`(n + 1..).find(|&x| Self::is_balanced(x)).unwrap()`, a
// `mut x: i32` parameter, `[0; 10]` counts indexed `as usize`, `(0..10)
// .all(..)` with `||` and `d as i32`), carried by `karac fix` in one round.
// The adapter below hands the harness's `i64` to it.

struct Solution {}

impl Solution {
    pub fn next_beautiful_number(n: i32) -> i32 {
        (n + 1..).find(|x| Solution.is_balanced(x)).unwrap()
    }

    fn is_balanced(x: own i32) -> bool {
        let mut x = x;
        let mut cnt = [0; 10];
        while x > 0 {
            cnt[(x % 10) as usize] += 1;
            x /= 10;
        }
        (0..10).all(|d| cnt[d] == 0 or cnt[d] == d as i32)
    }
}

fn next_beautiful_number(n: i64) -> i64 {
    Solution.next_beautiful_number(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    for n in [1, 1000, 3000, 0, 22, 1224443, 1000000, 666665, 122333, 4444] {
        println(f"{n} -> {next_beautiful_number(n)}");
    }
    // 300 values of n below 600000
    let mut seed = 2048;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 600000;
        let x = next_beautiful_number(n);
        sum += x;
        check = (check * 31 + x) % 1000000007;
    }
    println(f"300 values below 600000: sum {sum}, checksum {check}");
    // the values of n from which the next one is furthest away: 666666,
    // the largest balanced number with six digits, and 999999 and 10^6
    sum = 0;
    check = 0;
    for n in [666666, 999999, 1000000] {
        let x = next_beautiful_number(n);
        sum += x;
        check = (check * 31 + x) % 1000000007;
    }
    println(f"3 values far from the next: sum {sum}, checksum {check}");
}
