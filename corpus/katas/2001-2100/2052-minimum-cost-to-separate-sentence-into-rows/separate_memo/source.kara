// LeetCode #2052: Minimum Cost to Separate Sentence Into Rows -- a
// memoized recursion over the first word of the rest: the rest costs
// nothing if it fits in one row, else the least over each first row that
// fits of its cost plus the rest after it, each rest worked out once and
// kept in a `Vec[Option[i64]]`. Row widths come from prefix sums of the
// word lengths. The recursion is as deep as the rows, 2500 calls at most.

fn rest(i: i64, k: i64, ends: Vec[i64], memo: mut ref Vec[Option[i64]]) -> i64 {
    let n = ends.len() - 1;
    if let Some(cost) = memo[i] {
        return cost;
    }
    // words i..j laid in one row are `ends[j] - ends[i] - 1` wide
    let mut least = i64.MAX;
    if ends[n] - ends[i] - 1 <= k {
        least = 0;
    } else {
        let mut j = i + 1;
        while j < n and ends[j] - ends[i] - 1 <= k {
            let gap = k - (ends[j] - ends[i] - 1);
            least = least.min(gap * gap + rest(j, k, ends, mut memo));
            j += 1;
        }
    }
    memo[i] = Some(least);
    least
}

fn minimum_cost(sentence: String, k: i64) -> i64 {
    // ends[j]: the letters of the first j words, each with a space after it
    let mut ends = [0].to_vec();
    for word in sentence.split(" ") {
        ends.push(ends[ends.len() - 1] + word.len() + 1);
    }
    let mut memo: Vec[Option[i64]] = Vec.filled(ends.len(), None);
    rest(0, k, ends, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` words of 1 to `longest` letters, joined by single spaces
fn sentence(count: i64, longest: i64, seed: mut ref i64) -> String {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        let len = next_random(mut seed) % longest + 1;
        let mut word = String.new();
        for _ in 0..len {
            let at = next_random(mut seed) % 26;
            word.push_str(letters.substring(at, at + 1));
        }
        words.push(word);
    }
    words.join(" ")
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        ("i love leetcode", 12),
        ("apples and bananas taste great", 7),
        ("a", 5),
        ("a b c d e f", 1),
        ("ab cd ef gh", 5),
        ("hello world", 11),
        ("the quick brown fox jumps over the lazy dog", 10),
    ];
    for (text, k) in examples.iter() {
        println(f"\"{text}\", k {k} -> {minimum_cost(text, k)}");
    }
    // 2000 sentences of 1 to 30 words, each k at least the longest word
    let mut seed = 2052;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let count = next_random(mut seed) % 30 + 1;
        let longest = next_random(mut seed) % 8 + 1;
        let text = sentence(count, longest, mut seed);
        let k = longest + next_random(mut seed) % 20;
        let cost = minimum_cost(text, k);
        sum += cost;
        check = (check * 31 + cost) % 1000000007;
    }
    println(f"2000 sentences: sum {sum}, checksum {check}");
    // 3 sentences of about 5000 characters, the most the constraints
    // allow: short words in long rows, long words in rows just wide
    // enough, and one-letter words in rows of 2
    sum = 0;
    check = 0;
    for (count, longest, k) in [(1000, 7, 200), (330, 14, 15), (2500, 1, 2)] {
        let text = sentence(count, longest, mut seed);
        let cost = minimum_cost(text, k);
        sum += cost;
        check = (check * 31 + cost) % 1000000007;
    }
    println(f"3 long sentences: sum {sum}, checksum {check}");
}
