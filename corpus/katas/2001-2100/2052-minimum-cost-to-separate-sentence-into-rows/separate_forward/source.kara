// LeetCode #2052: Minimum Cost to Separate Sentence Into Rows -- dynamic
// programming from the front. `paid[j]` is the least cost of laying out the
// first `j` words in rows that are all paid for; the last row is free, so
// the answer is the least `paid[s]` over each start `s` from which the rest
// fits in one row. Each row is grown backwards from its end, word by word,
// while it fits. O(n * k).

fn minimum_cost(sentence: String, k: i64) -> i64 {
    let lens: Vec[i64] = sentence.split(" ").map(|w| w.len()).collect();
    let n = lens.len();
    let mut paid: Vec[i64] = Vec.filled(n + 1, i64.MAX);
    paid[0] = 0;
    for j in 1..n + 1 {
        let mut width = -1;
        let mut i = j;
        while i > 0 and width + 1 + lens[i - 1] <= k {
            width += 1 + lens[i - 1];
            i -= 1;
            if paid[i] < i64.MAX {
                paid[j] = paid[j].min(paid[i] + (k - width) * (k - width));
            }
        }
    }
    let mut answer = i64.MAX;
    let mut width = -1;
    let mut s = n;
    while s > 0 and width + 1 + lens[s - 1] <= k {
        width += 1 + lens[s - 1];
        s -= 1;
        answer = answer.min(paid[s]);
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` words of 1 to `longest` letters, joined by single spaces
fn sentence(count: i64, longest: i64, seed: mut ref i64) -> String {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        let len = next_random(mut seed) % longest + 1;
        let mut word = String.new();
        for _ in 0..len {
            let at = next_random(mut seed) % 26;
            word.push_str(letters.substring(at, at + 1));
        }
        words.push(word);
    }
    words.join(" ")
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [
        ("i love leetcode", 12),
        ("apples and bananas taste great", 7),
        ("a", 5),
        ("a b c d e f", 1),
        ("ab cd ef gh", 5),
        ("hello world", 11),
        ("the quick brown fox jumps over the lazy dog", 10),
    ];
    for (text, k) in examples.iter() {
        println(f"\"{text}\", k {k} -> {minimum_cost(text, k)}");
    }
    // 2000 sentences of 1 to 30 words, each k at least the longest word
    let mut seed = 2052;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let count = next_random(mut seed) % 30 + 1;
        let longest = next_random(mut seed) % 8 + 1;
        let text = sentence(count, longest, mut seed);
        let k = longest + next_random(mut seed) % 20;
        let cost = minimum_cost(text, k);
        sum += cost;
        check = (check * 31 + cost) % 1000000007;
    }
    println(f"2000 sentences: sum {sum}, checksum {check}");
    // 3 sentences of about 5000 characters, the most the constraints
    // allow: short words in long rows, long words in rows just wide
    // enough, and one-letter words in rows of 2
    sum = 0;
    check = 0;
    for (count, longest, k) in [(1000, 7, 200), (330, 14, 15), (2500, 1, 2)] {
        let text = sentence(count, longest, mut seed);
        let cost = minimum_cost(text, k);
        sum += cost;
        check = (check * 31 + cost) % 1000000007;
    }
    println(f"3 long sentences: sum {sum}, checksum {check}");
}
