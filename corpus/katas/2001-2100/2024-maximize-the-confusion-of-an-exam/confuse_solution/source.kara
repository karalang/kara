// LeetCode #2024: Maximize the Confusion of an Exam -- LeetCode's Rust
// template, carried to Kāra by `karac fix`. A closure over `as_bytes()`
// run for `b'T'` and `b'F'`.

impl Solution {
    pub fn max_consecutive_answers(answer_key: String, k: i32) -> i32 {
        let s = answer_key.bytes();
        let longest = |c: u8| {
            let mut (l, cnt, res) = (0, 0, 0i32);
            for r in 0..s.len() {
                if s[r] != c {
                    cnt += 1;
                }
                while cnt > k {
                    if s[l] != c {
                        cnt -= 1;
                    }
                    l += 1;
                }
                res = res.max((r - l + 1) as i32);
            }
            res
        };
        longest(b'T').max(longest(b'F'))
    }
}

struct Solution {}

fn max_consecutive_answers(answer_key: String, k: i64) -> i64 {
    Solution.max_consecutive_answers(answer_key.clone(), k as i32) as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn key_of(seed: mut ref i64, len: i64, t_in_100: i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        s.push(if next_random(mut seed) % 100 < t_in_100 { 'T' } else { 'F' });
    }
    s
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(String, i64)] = [
        ("TTFF", 2),
        ("TFFT", 1),
        ("TTFTTFTT", 1),
        ("T", 1),
        ("TF", 1),
        ("FFFTFFF", 1),
        ("TFTFTFTF", 2),
        ("TTTTFFFF", 3),
    ];
    for (key, k) in examples {
        println(f"{key}, {k} -> {max_consecutive_answers(key, k)}");
    }
    // 3000 keys of 1 to 30 answers, each with its own share of `T`, and k
    // from 1 to the length
    let mut seed = 2024;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let len = next_random(mut seed) % 30 + 1;
        let share = next_random(mut seed) % 101;
        let key = key_of(mut seed, len, share);
        let k = next_random(mut seed) % len + 1;
        let best = max_consecutive_answers(key, k);
        total += best;
        check = (check * 31 + best) % 1000000007;
    }
    println(f"3000 keys of up to 30 answers: total {total}, checksum {check}");
    // 6 keys of 1500 answers, with 5 to 95 in 100 `T`s and k from 1 to 300
    total = 0;
    check = 0;
    for a in 0..6 {
        let key = key_of(mut seed, 1500, [50, 5, 95, 30, 70, 50][a]);
        let k = [1, 3, 10, 40, 100, 300][a];
        let best = max_consecutive_answers(key, k);
        total += best;
        check = (check * 31 + best) % 1000000007;
    }
    println(f"6 keys of 1500 answers: total {total}, checksum {check}");
}
