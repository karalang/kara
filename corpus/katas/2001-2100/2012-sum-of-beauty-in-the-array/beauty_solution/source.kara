// LeetCode #2012: Sum of Beauty in the Array -- LeetCode's Rust template,
// carried to Kāra by `karac fix`. A prefix-maximum and a suffix-minimum
// vector, then each middle index scored.

struct Solution {}

impl Solution {
    pub fn sum_of_beauties(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let mut pre = Vec.filled(n, 0i32);
        let mut suf = Vec.filled(n, 0i32);
        pre[0] = nums[0];
        for i in 1..n {
            pre[i] = pre[i - 1].max(nums[i]);
        }
        suf[n - 1] = nums[n - 1];
        for i in (0..n - 1).rev() {
            suf[i] = suf[i + 1].min(nums[i]);
        }
        let mut ans = 0;
        for i in 1..n - 1 {
            if pre[i - 1] < nums[i] and nums[i] < suf[i + 1] {
                ans += 2;
            } else if nums[i - 1] < nums[i] and nums[i] < nums[i + 1] {
                ans += 1;
            }
        }
        ans
    }
}

fn sum_of_beauties(nums: Vec[i64]) -> i64 {
    Solution.sum_of_beauties(nums.iter().map(|x| x as i32).collect()) as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, answer: i64) -> i64 {
    (check * 31 + answer) % 1000000007
}

// `n` values from 1 to `top`, each a step up from the last with probability
// `rise` in 10, and anywhere otherwise
fn random_nums(n: i64, top: i64, rise: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for i in 0..n {
        if i > 0 and next_random(mut seed) % 10 < rise {
            nums.push((nums[i - 1] + next_random(mut seed) % 3 + 1).min(top));
        } else {
            nums.push(next_random(mut seed) % top + 1);
        }
    }
    nums
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = [
        [1, 2, 3],
        [2, 4, 6, 4],
        [3, 2, 1],
        [1, 2, 3, 4, 5],
        [5, 1, 2, 3, 4],
        [1, 1, 1],
        [1, 3, 2, 4, 3, 5],
        [2, 1, 3, 2, 4, 3],
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {sum_of_beauties(nums)}");
    }
    let mut seed = 2012;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 10 + 3;
        let top = next_random(mut seed) % 20 + 1;
        let rise = next_random(mut seed) % 11;
        let answer = sum_of_beauties(random_nums(n, top, rise, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"3000 arrays of 3 to 12 values: sum {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for a in 0..6 {
        let top = [100, 100000][a % 2];
        let rise = [0, 5, 9][a % 3];
        let answer = sum_of_beauties(random_nums(3000, top, rise, mut seed));
        sum += answer;
        check = mix(check, answer);
    }
    println(f"6 arrays of 3000 values: sum {sum}, checksum {check}");
}
