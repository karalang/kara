// LeetCode #2012: Sum of Beauty in the Array -- the ★ arm's benchmark. A
// pass from the right keeps the smallest value after each index, and a pass
// from the left the largest before; an index between them is worth 2, one
// between its neighbours 1.

fn sum_of_beauties(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut min_after = Vec.filled(n, 0);
    min_after[n - 1] = nums[n - 1];
    for i in (0..n - 1).rev() {
        min_after[i] = min_after[i + 1].min(nums[i]);
    }
    let mut max_before = nums[0];
    let mut total = 0;
    for i in 1..n - 1 {
        if max_before < nums[i] and nums[i] < min_after[i + 1] {
            total += 2;
        } else if nums[i - 1] < nums[i] and nums[i] < nums[i + 1] {
            total += 1;
        }
        max_before = max_before.max(nums[i]);
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 1000 arrays of 2000 values up to 100000 built once, each value a step
    // up from the last with odds that grow with the array, then the ★ arm
    // on each for 5 rounds
    let mut seed = 2012;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..1000 {
        let rise = a % 11;
        let mut nums: Vec[i64] = Vec.new();
        for i in 0..2000 {
            if i > 0 and next_random(mut seed) % 10 < rise {
                nums.push((nums[i - 1] + next_random(mut seed) % 3 + 1).min(100000));
            } else {
                nums.push(next_random(mut seed) % 100000 + 1);
            }
        }
        arrays.push(nums);
    }
    let mut calls = 0;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..5 {
        for a in 0..arrays.len() {
            let answer = sum_of_beauties(arrays[a]);
            calls += 1;
            sum += answer;
            check = (check * 31 + answer) % 1000000007;
        }
    }
    println(f"{calls} calls: sum {sum}, checksum {check}");
}
