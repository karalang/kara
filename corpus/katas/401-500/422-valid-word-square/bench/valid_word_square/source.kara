// Benchmark for #422: Valid Word Square -- every cell against its mirror.
//
// Row i, column j must hold the same letter as row j, column i. For
// every letter in the rows, check that its mirror cell exists (there is
// a row j, and it is longer than i) and holds the same letter. A cell
// whose mirror is missing fails the check from its own side, so every
// cell checked once covers both directions. O(cells) time, O(1) space.

fn valid_word_square(words: Vec[String]) -> bool {
    let n = words.len();
    for i in 0..n {
        let row = words[i].bytes();
        for j in 0..row.len() {
            if j >= n {
                return false;
            }
            let mirror = words[j].bytes();
            if i >= mirror.len() or mirror[i] != row[j] {
                return false;
            }
        }
    }
    true
}

// ---- benchmark ------------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Swap the letter at row i, column j between 'a' and 'b'.
fn flip(words: mut ref Vec[String], i: i64, j: i64) {
    let bytes = words[i].bytes();
    let mut word = String.new();
    for k in 0..bytes.len() {
        let b = if k == j { 195 - bytes[k] as i64 } else { bytes[k] as i64 };
        word.push(char.try_from(b as u32).unwrap());
    }
    words[i] = word;
}

fn main() {
    let n = 500;
    let rounds = 6000;
    let mut seed: i64 = 422;
    // A symmetric grid of two letters, kept to a symmetric staircase.
    let mut grid: Vec[i64] = vec![0; n * n];
    for i in 0..n {
        for j in i..n {
            let c = step(mut seed) % 2;
            grid[i * n + j] = c;
            grid[j * n + i] = c;
        }
    }
    let mut lengths: Vec[i64] = vec![n];
    for i in 1..n {
        let last = lengths[i - 1];
        let drop = if step(mut seed) % 4 == 0 { 1 } else { 0 };
        lengths.push(max(1, last - drop));
    }
    let mut words: Vec[String] = Vec.new();
    for i in 0..n {
        let mut height = 0;
        while height < n and lengths[height] > i {
            height += 1;
        }
        let mut word = String.new();
        for j in 0..min(lengths[i], height) {
            word.push(char.try_from((97 + grid[i * n + j]) as u32).unwrap());
        }
        words.push(word);
    }
    let mut cells = 0;
    for w in words {
        cells += w.len();
    }
    // Each round flips a letter and, two rounds in three, its mirror too,
    // which keeps the square valid; on the third the lone flip is undone
    // after the check.
    let mut valid = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let i = step(mut seed) % n;
        let j = step(mut seed) % words[i].len();
        flip(mut words, i, j);
        if r % 3 != 0 {
            flip(mut words, j, i);
        }
        let answer = valid_word_square(words);
        if answer {
            valid += 1;
        }
        checksum = (checksum * 31 + if answer { r + 1 } else { 0 }) % 1000000007;
        if r % 3 == 0 {
            flip(mut words, i, j);
        }
    }
    println(f"{rounds} rounds on {n} words, {cells} letters: {valid} valid, checksum {checksum}");
}
