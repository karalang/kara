// Differential test for LeetCode #422: Valid Word Square.
//
// Copies of the four arms, each run on 1,500 random word squares of 1
// to 10 rows over three letters: a symmetric grid kept to a symmetric
// staircase of row lengths. Properties known by construction:
//   P1  after one of five changes (a letter, a row cut short, a row
//       made longer, a row added, two rows swapped) or none, the answer
//       is that of a brute force that looks for each cell's mirror by
//       scanning a list of every cell
//   P2  renaming the letters gives the same answer
//   P3  the square is valid, and so is its top-left k by k corner
//   P4  the square with an off-diagonal letter changed, with a row made
//       longer by a cell off the diagonal, or with a row added is not
//       valid
//   P5  words that all have one length are valid exactly when they
//       are as many as their length and their grid is symmetric

// ---- mirror: valid_word_square.kara

fn valid_word_square_mirror(words: Vec[String]) -> bool {
    let n = words.len();
    for i in 0..n {
        let row = words[i].bytes();
        for j in 0..row.len() {
            if j >= n {
                return false;
            }
            let mirror = words[j].bytes();
            if i >= mirror.len() or mirror[i] != row[j] {
                return false;
            }
        }
    }
    true
}

// ---- grid: valid_word_square_grid.kara

fn valid_word_square_grid(words: Vec[String]) -> bool {
    let n = words.len();
    let mut side = n;
    for w in words {
        side = max(side, w.len());
    }
    let mut grid: Vec[u8] = vec![0; side * side];
    for i in 0..n {
        let row = words[i].bytes();
        for j in 0..row.len() {
            grid[i * side + j] = row[j];
        }
    }
    for i in 0..side {
        for j in i + 1..side {
            if grid[i * side + j] != grid[j * side + i] {
                return false;
            }
        }
    }
    true
}

// ---- columns: valid_word_square_columns.kara

fn valid_word_square_columns(words: Vec[String]) -> bool {
    let n = words.len();
    for k in 0..n {
        let mut column = String.new();
        let mut r = 0;
        while r < n and words[r].len() > k {
            column.push(words[r].bytes()[k] as char);
            r += 1;
        }
        if column != words[k] {
            return false;
        }
    }
    true
}

// ---- cells: valid_word_square_cells.kara

fn valid_word_square_cells(words: Vec[String]) -> bool {
    let mut cells: Map[i64, u8] = Map.new();
    for i in 0..words.len() {
        let row = words[i].bytes();
        for j in 0..row.len() {
            cells.insert(i * 1000 + j, row[j]);
        }
    }
    for (key, letter) in cells {
        let mirror = key % 1000 * 1000 + key / 1000;
        match cells.get(mirror) {
            Some(other) => {
                if other != letter {
                    return false;
                }
            }
            None => {
                return false;
            }
        }
    }
    true
}

// ---- harness ----------------------------------------------------------

fn solve(arm: i64, words: Vec[String]) -> bool {
    if arm == 0 {
        valid_word_square_mirror(words)
    } else if arm == 1 {
        valid_word_square_grid(words)
    } else if arm == 2 {
        valid_word_square_columns(words)
    } else {
        valid_word_square_cells(words)
    }
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Words from rows of letter codes (0 is 'a').
fn spell(rows: ref Vec[Vec[i64]]) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for row in rows {
        let mut word = String.new();
        for c in row {
            word.push(char.try_from((97 + c) as u32).unwrap());
        }
        words.push(word);
    }
    words
}

// Every cell as (row, column, letter); valid when each cell's mirror is
// in the list with the same letter, found by scanning the whole list.
fn brute(rows: ref Vec[Vec[i64]]) -> bool {
    let mut cells: Vec[(i64, i64, i64)] = Vec.new();
    for i in 0..rows.len() {
        for j in 0..rows[i].len() {
            cells.push((i, j, rows[i][j]));
        }
    }
    for (i, j, c) in cells {
        let mut found = false;
        for (r, k, d) in cells {
            if r == j and k == i and d == c {
                found = true;
            }
        }
        if not found {
            return false;
        }
    }
    true
}

// failures[0] counts every failure, failures[p] those of property Pp.
fn report(p: i64, arm: i64, case: i64, ok: bool, failures: mut ref Vec[i64]) {
    if not ok {
        failures[0] += 1;
        failures[p] += 1;
        if failures[0] <= 10 {
            println(f"FAIL P{p} arm {arm} case {case}");
        }
    }
}

fn main() {
    let mut seed: i64 = 4220;
    let mut checks: i64 = 0;
    let mut failures = vec![0; 6];
    for case in 0..1500 {
        // A valid square: a symmetric grid of three letters, kept to a
        // symmetric staircase of row lengths.
        let n = 1 + step(mut seed) % 10;
        let mut grid: Vec[i64] = vec![0; n * n];
        for i in 0..n {
            for j in i..n {
                let c = step(mut seed) % 3;
                grid[i * n + j] = c;
                grid[j * n + i] = c;
            }
        }
        let mut lengths: Vec[i64] = vec![n];
        for i in 1..n {
            let last = lengths[i - 1];
            lengths.push(max(1, last - step(mut seed) % 3));
        }
        let mut square: Vec[Vec[i64]] = Vec.new();
        for i in 0..n {
            let mut height = 0;
            while height < n and lengths[height] > i {
                height += 1;
            }
            let mut row: Vec[i64] = Vec.new();
            for j in 0..min(lengths[i], height) {
                row.push(grid[i * n + j]);
            }
            square.push(row);
        }
        // P1 and P2: any of five changes, or none.
        let mut spoiled = square.clone();
        let spoil = step(mut seed) % 6;
        let r = step(mut seed) % n;
        let at = step(mut seed) % spoiled[r].len();
        if spoil == 1 {
            spoiled[r][at] = (spoiled[r][at] + 1) % 3;
        } else if spoil == 2 {
            spoiled[r].pop();
        } else if spoil == 3 {
            spoiled[r].push(step(mut seed) % 3);
        } else if spoil == 4 {
            spoiled.push(vec![step(mut seed) % 3]);
        } else if spoil == 5 {
            // Swap two rows.
            let other = step(mut seed) % n;
            let keep = spoiled[r].clone();
            spoiled[r] = spoiled[other].clone();
            spoiled[other] = keep;
        }
        let expect = brute(spoiled);
        let mut relabelled: Vec[Vec[i64]] = Vec.new();
        for row in spoiled {
            let mut out: Vec[i64] = Vec.new();
            for c in row {
                out.push((c + 1) % 3);
            }
            relabelled.push(out);
        }
        // P3: the top-left k by k corner of the valid square.
        let k = 1 + step(mut seed) % n;
        let mut corner: Vec[Vec[i64]] = Vec.new();
        for i in 0..k {
            let mut row: Vec[i64] = Vec.new();
            for j in 0..min(k, square[i].len()) {
                row.push(square[i][j]);
            }
            corner.push(row);
        }
        // P4: an off-diagonal letter changed, a row made longer, a row added.
        let mut changed = square.clone();
        let mut off = -1;
        for i in 0..n {
            if off < 0 and square[i].len() > i + 1 {
                off = i;
            }
        }
        if off >= 0 {
            changed[off][off + 1] = (changed[off][off + 1] + 1) % 3;
        }
        // Row r made longer gains the cell (r, len); unless that cell is
        // on the diagonal, its mirror is missing. Row 0 never ends there.
        let grow = if square[r].len() == r { 0 } else { r };
        let mut longer = square.clone();
        longer[grow].push(0);
        let mut taller = square.clone();
        taller.push(vec![0]);
        // P5: every word of one length; valid only when the grid is square
        // and symmetric.
        let rows5 = 1 + step(mut seed) % 5;
        let cols5 = 1 + step(mut seed) % 5;
        let mut block: Vec[Vec[i64]] = Vec.new();
        for _ in 0..rows5 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..cols5 {
                row.push(step(mut seed) % 2);
            }
            block.push(row);
        }
        let mut symmetric = rows5 == cols5;
        if symmetric {
            for i in 0..rows5 {
                for j in 0..cols5 {
                    if block[i][j] != block[j][i] {
                        symmetric = false;
                    }
                }
            }
        }
        let spoiled_words = spell(spoiled);
        let relabelled_words = spell(relabelled);
        let square_words = spell(square);
        let corner_words = spell(corner);
        let changed_words = spell(changed);
        let longer_words = spell(longer);
        let taller_words = spell(taller);
        let block_words = spell(block);
        for arm in 0..4 {
            checks += 5;
            let answer = solve(arm, spoiled_words);
            report(1, arm, case, answer == expect, mut failures);
            report(2, arm, case, solve(arm, relabelled_words) == answer, mut failures);
            report(3, arm, case, solve(arm, square_words) and solve(arm, corner_words), mut failures);
            report(4, arm, case, (off < 0 or not solve(arm, changed_words)) and not solve(arm, longer_words) and not solve(arm, taller_words), mut failures);
            report(5, arm, case, solve(arm, block_words) == symmetric, mut failures);
        }
    }
    println(f"1500 cases, 4 arms, {checks} checks, {failures[0]} failures");
    if failures[0] > 0 {
        println(f"by property: P1 {failures[1]}, P2 {failures[2]}, P3 {failures[3]}, P4 {failures[4]}, P5 {failures[5]}");
    }
}
