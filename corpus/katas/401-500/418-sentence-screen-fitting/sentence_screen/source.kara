// LeetCode #418: Sentence Screen Fitting -- one pointer into the text.
//
// Join the sentence with a space after every word, so the screen shows
// a stretch of this text repeated forever. Keep how far into it the
// screen has reached. Each row adds cols characters; if that lands on a
// space the space is skipped, otherwise the pointer backs up to the
// start of the word it split, which moves to the next row. The answer
// is how many whole texts were passed. If a word is longer than a row,
// the pointer never advances, and the answer is 0.
// O(rows * longest word) time, O(total length) space.

fn words_typing(sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    let text = sentence.join(" ") + " ";
    let bytes = text.bytes();
    let length = text.len();
    let mut at = 0;
    for _ in 0..rows {
        at += cols;
        if bytes[at % length] == b' ' {
            at += 1;
        } else {
            while at > 0 and bytes[(at - 1) % length] != b' ' {
                at -= 1;
            }
        }
    }
    at / length
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(text: Str, rows: i64, cols: i64) {
    let sentence: Vec[String] = text.split_whitespace().map(|p| p.to_string()).collect();
    println(f"\"{text}\" on {rows}x{cols}: {words_typing(sentence, rows, cols)}");
}

fn main() {
    show("hello world", 2, 8);
    show("a bcd e", 3, 6);
    show("i had apple pie", 4, 5);
    show("abc", 5, 3);
    show("abcd", 5, 3);
    show("a", 1, 1);
    show("a b", 1, 2);
    show("a b", 1, 3);
    show("try to be better", 10000, 9001);
    show("f p a", 8, 7);
    // 1,000 random sentences of 1 to 8 words of 1 to 6 letters, on
    // screens of 1 to 40 rows and 1 to 20 columns; some words do not fit.
    let mut seed: i64 = 418;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        let n = 1 + step(mut seed) % 8;
        let mut sentence: Vec[String] = Vec.new();
        for _ in 0..n {
            let length = 1 + step(mut seed) % 6;
            let mut word = String.new();
            for _ in 0..length {
                word.push(char.try_from((97 + step(mut seed) % 26) as u32).unwrap());
            }
            sentence.push(word);
        }
        let rows = 1 + step(mut seed) % 40;
        let cols = 1 + step(mut seed) % 20;
        let answer = words_typing(sentence, rows, cols);
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"1000 random sentences: total {total}, checksum {checksum}");
}
