// LeetCode #418: Sentence Screen Fitting -- a table per first word.
//
// What happens on a row depends only on the word it starts with. For
// each word i, fill one row starting there and record the word the next
// row starts with and how many sentences the row completes. Then each
// row is one table lookup. A word longer than a row makes the answer 0.
// O(n * cols + rows) time, O(n) space for n words.

fn words_typing(sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    let n = sentence.len();
    for w in sentence {
        if w.len() > cols {
            return 0;
        }
    }
    let mut next = vec![0; n];
    let mut done = vec![0; n];
    for i in 0..n {
        let mut word = i;
        let mut used = 0;
        while used + sentence[word].len() <= cols {
            used += sentence[word].len() + 1;
            word += 1;
            if word == n {
                word = 0;
                done[i] += 1;
            }
        }
        next[i] = word;
    }
    let mut word = 0;
    let mut count = 0;
    for _ in 0..rows {
        count += done[word];
        word = next[word];
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(text: Str, rows: i64, cols: i64) {
    let sentence = text.split_whitespace();
    println(f"\"{text}\" on {rows}x{cols}: {words_typing(sentence, rows, cols)}");
}

fn main() {
    show("hello world", 2, 8);
    show("a bcd e", 3, 6);
    show("i had apple pie", 4, 5);
    show("abc", 5, 3);
    show("abcd", 5, 3);
    show("a", 1, 1);
    show("a b", 1, 2);
    show("a b", 1, 3);
    show("try to be better", 10000, 9001);
    show("f p a", 8, 7);
    // 1,000 random sentences of 1 to 8 words of 1 to 6 letters, on
    // screens of 1 to 40 rows and 1 to 20 columns; some words do not fit.
    let mut seed: i64 = 418;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        let n = 1 + step(mut seed) % 8;
        let mut sentence: Vec[String] = Vec.new();
        for _ in 0..n {
            let length = 1 + step(mut seed) % 6;
            let mut word = String.new();
            for _ in 0..length {
                word.push(char.try_from((97 + step(mut seed) % 26) as u32).unwrap());
            }
            sentence.push(word);
        }
        let rows = 1 + step(mut seed) % 40;
        let cols = 1 + step(mut seed) % 20;
        let answer = words_typing(sentence, rows, cols);
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"1000 random sentences: total {total}, checksum {checksum}");
}
