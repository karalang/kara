// Differential test for LeetCode #418: Sentence Screen Fitting.
//
// Copies of the four arms, each run on 2,000 random sentences and
// screens. Properties known by construction:
//   P1  the answer is the words that fit on the first rows lines when
//       copies of the sentence are wrapped greedily, over n
//   P2  one more row, or one more column, never lowers the answer
//   P3  the sentence written twice gives half the answer, rounded down
//   P4  n words of one length L on rows of exactly m (L + 1) - 1
//       columns fit m words a row: rows * m / n
//   P5  a word longer than a row gives 0, and rows exactly one
//       sentence long give one sentence a row

// ---- pointer: sentence_screen.kara

fn words_typing_pointer(sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    let text = sentence.join(" ") + " ";
    let bytes = text.bytes();
    let length = text.len();
    let mut at = 0;
    for _ in 0..rows {
        at += cols;
        if bytes[at % length] == b' ' {
            at += 1;
        } else {
            while at > 0 and bytes[(at - 1) % length] != b' ' {
                at -= 1;
            }
        }
    }
    at / length
}

// ---- rows: sentence_screen_rows.kara

fn words_typing_rows(sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    for w in sentence {
        if w.len() > cols {
            return 0;
        }
    }
    let n = sentence.len();
    let mut word = 0;
    let mut count = 0;
    for _ in 0..rows {
        let mut used = 0;
        while used + sentence[word].len() <= cols {
            used += sentence[word].len() + 1;
            word += 1;
            if word == n {
                word = 0;
                count += 1;
            }
        }
    }
    count
}

// ---- table: sentence_screen_table.kara

fn words_typing_table(sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    let n = sentence.len();
    for w in sentence {
        if w.len() > cols {
            return 0;
        }
    }
    let mut next = vec![0; n];
    let mut done = vec![0; n];
    for i in 0..n {
        let mut word = i;
        let mut used = 0;
        while used + sentence[word].len() <= cols {
            used += sentence[word].len() + 1;
            word += 1;
            if word == n {
                word = 0;
                done[i] += 1;
            }
        }
        next[i] = word;
    }
    let mut word = 0;
    let mut count = 0;
    for _ in 0..rows {
        count += done[word];
        word = next[word];
    }
    count
}

// ---- cycle: sentence_screen_cycle.kara

fn words_typing_cycle(sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    let n = sentence.len();
    for w in sentence {
        if w.len() > cols {
            return 0;
        }
    }
    let mut next = vec![0; n];
    let mut done = vec![0; n];
    for i in 0..n {
        let mut word = i;
        let mut used = 0;
        while used + sentence[word].len() <= cols {
            used += sentence[word].len() + 1;
            word += 1;
            if word == n {
                word = 0;
                done[i] += 1;
            }
        }
        next[i] = word;
    }
    let mut seen_row = vec![-1; n];
    let mut seen_count = vec![0; n];
    let mut word = 0;
    let mut count = 0;
    let mut row = 0;
    while row < rows {
        if seen_row[word] >= 0 {
            let period = row - seen_row[word];
            let gain = count - seen_count[word];
            let periods = (rows - row) / period;
            count += periods * gain;
            row += periods * period;
            while row < rows {
                count += done[word];
                word = next[word];
                row += 1;
            }
            return count;
        }
        seen_row[word] = row;
        seen_count[word] = count;
        count += done[word];
        word = next[word];
        row += 1;
    }
    count
}

// ---- harness ----------------------------------------------------------

fn solve(arm: i64, sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    if arm == 0 {
        words_typing_pointer(sentence, rows, cols)
    } else if arm == 1 {
        words_typing_rows(sentence, rows, cols)
    } else if arm == 2 {
        words_typing_table(sentence, rows, cols)
    } else {
        words_typing_cycle(sentence, rows, cols)
    }
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(length: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    for _ in 0..length {
        w.push(char.try_from((97 + step(seed) % 26) as u32).unwrap());
    }
    w
}

// The word lengths written out for as many copies of the sentence as
// the screen could hold, wrapped greedily into lines of cols
// characters; the answer is the words on the first rows lines over n.
fn brute(sentence: Vec[String], rows: i64, cols: i64) -> i64 {
    let n = sentence.len();
    let mut stream: Vec[i64] = Vec.new();
    for _ in 0..(rows * cols / n + 2) {
        for w in sentence {
            stream.push(w.len());
        }
    }
    let mut k = 0;
    for _ in 0..rows {
        let mut line = 0;
        while k < stream.len() and stream[k] <= cols - line {
            line += stream[k] + 1;
            k += 1;
        }
    }
    k / n
}

// failures[0] counts every failure, failures[p] those of property Pp.
fn report(p: i64, arm: i64, case: i64, ok: bool, failures: mut ref Vec[i64]) {
    if not ok {
        failures[0] += 1;
        failures[p] += 1;
        if failures[0] <= 10 {
            println(f"FAIL P{p} arm {arm} case {case}");
        }
    }
}

fn main() {
    let mut seed: i64 = 4180;
    let mut checks: i64 = 0;
    let mut failures = vec![0; 6];
    for case in 0..2000 {
        let n = 1 + step(mut seed) % 6;
        let mut sentence: Vec[String] = Vec.new();
        for _ in 0..n {
            let length = 1 + step(mut seed) % 5;
            sentence.push(word(length, mut seed));
        }
        let rows = 1 + step(mut seed) % 30;
        let cols = 1 + step(mut seed) % 25;
        let best = brute(sentence, rows, cols);
        // P3: the sentence written twice.
        let mut twice: Vec[String] = Vec.new();
        for w in sentence {
            twice.push(w.clone());
        }
        for w in sentence {
            twice.push(w.clone());
        }
        // P4: m words of one length per row, exactly.
        let length = 1 + step(mut seed) % 5;
        let per_row = 1 + step(mut seed) % 4;
        let mut even: Vec[String] = Vec.new();
        for _ in 0..n {
            even.push(word(length, mut seed));
        }
        // P5: one word longer than a row, and a row exactly one sentence
        // long.
        let mut long = twice.clone();
        long.push(word(cols + 1, mut seed));
        let mut text_length = n - 1;
        for w in sentence {
            text_length += w.len();
        }
        for arm in 0..4 {
            checks += 5;
            let answer = solve(arm, sentence, rows, cols);
            report(1, arm, case, answer == best, mut failures);
            report(2, arm, case, solve(arm, sentence, rows + 1, cols) >= answer and solve(arm, sentence, rows, cols + 1) >= answer, mut failures);
            report(3, arm, case, solve(arm, twice, rows, cols) == answer / 2, mut failures);
            report(4, arm, case, solve(arm, even, rows, per_row * (length + 1) - 1) == rows * per_row / n, mut failures);
            report(5, arm, case, solve(arm, long, rows, cols) == 0 and solve(arm, sentence, rows, text_length) == rows, mut failures);
        }
    }
    println(f"2000 cases, 4 arms, {checks} checks, {failures[0]} failures");
    if failures[0] > 0 {
        println(f"by property: P1 {failures[1]}, P2 {failures[2]}, P3 {failures[3]}, P4 {failures[4]}, P5 {failures[5]}");
    }
}
