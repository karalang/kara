// Benchmark for #433: the ★ arm (min_mutation.kara) on 2,000 searches
// through one bank of 1,000 genes.

fn min_mutation(start_gene: Str, end_gene: Str, bank: Vec[String]) -> i64 {
    let mut unreached: Set[String] = Set.new();
    for gene in bank {
        unreached.insert(gene.clone());
    }
    if not unreached.contains(end_gene) {
        return -1;
    }
    unreached.remove(start_gene);
    let mut level: Vec[String] = vec![start_gene.to_string()];
    let mut steps = 0;
    while level.len() > 0 {
        let mut next: Vec[String] = Vec.new();
        for gene in level {
            if gene == end_gene {
                return steps;
            }
            let letters: Vec[char] = gene.chars().collect();
            for i in 0..letters.len() {
                for c in ['A', 'C', 'G', 'T'] {
                    if c != letters[i] {
                        let mut mutant = String.new();
                        for j in 0..letters.len() {
                            mutant.push(if j == i { c } else { letters[j] });
                        }
                        if unreached.remove(mutant) {
                            next.push(mutant);
                        }
                    }
                }
            }
        }
        level = next;
        steps += 1;
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mutate(gene: Str, seed: mut ref i64) -> String {
    let at = next_random(seed) % 8;
    let shift = 1 + next_random(seed) % 3;
    let mut out = String.new();
    let mut i = 0;
    for c in gene.chars() {
        if i == at {
            let k = match c {
                'A' => 0,
                'C' => 1,
                'G' => 2,
                _ => 3,
            };
            out.push(['A', 'C', 'G', 'T'][(k + shift) % 4]);
        } else {
            out.push(c);
        }
        i += 1;
    }
    out
}

fn main() {
    let size = 1000;
    let searches = 2000;
    let mut seed: i64 = 433;
    // The bank grows from one gene, each new gene a mutation of an
    // earlier one, so most genes are connected.
    let mut bank: Vec[String] = vec!["ACGTACGT".to_string()];
    while bank.len() < size {
        let parent = bank[next_random(mut seed) % bank.len()].clone();
        bank.push(mutate(parent, mut seed));
    }
    let mut reachable = 0;
    let mut checksum: i64 = 0;
    for _ in 0..searches {
        let start = mutate(bank[next_random(mut seed) % size], mut seed);
        let end = bank[next_random(mut seed) % size].clone();
        let answer = min_mutation(start, end, bank);
        if answer >= 0 {
            reachable += 1;
        }
        checksum = (checksum * 31 + answer + 2) % 1000000007;
    }
    println(f"{searches} searches in a bank of {size}: {reachable} reachable, checksum {checksum}");
}
