// Differential test for LeetCode #439: Ternary Expression Parser.
//
// Copies of the four arms, each run on 1,500 random expressions of 1
// to 10 levels, each branch a lone character with chance 1 in 3.
// Properties known by construction:
//   P1  the value is the one the generator chose as it built the
//       expression
//   P2  "T?e:f" and "F?f:e" have the value of e, for a random f
//   P3  putting f in place of the leaf the value comes from gives f's
//       value, and in place of any other leaf changes nothing
//   P4  the mirror image, every condition flipped and its branches
//       swapped, has the same value
//   P5  k conditions nested to the right pick the branch of the first
//       T, and k T conditions nested to the left pick the innermost
//       yes value

// ---- stack: parse_ternary.kara

fn parse_ternary_stack(expression: Str) -> char {
    let e = expression.bytes();
    let mut stack: Vec[u8] = Vec.new();
    let mut i = e.len();
    while i > 0 {
        i -= 1;
        if stack.len() > 0 and stack[stack.len() - 1] == b'?' {
            stack.pop();
            let yes = stack.pop().expect("a yes value");
            stack.pop();
            let no = stack.pop().expect("a no value");
            stack.push(if e[i] == b'T' { yes } else { no });
        } else {
            stack.push(e[i]);
        }
    }
    stack[0] as char
}

// ---- recursive: parse_ternary_recursive.kara

fn eval_at(e: Slice[u8], i: i64) -> (u8, i64) {
    if i + 1 < e.len() and e[i + 1] == b'?' {
        let (yes, after_yes) = eval_at(e, i + 2);
        let (no, after_no) = eval_at(e, after_yes + 1);
        (if e[i] == b'T' { yes } else { no }, after_no)
    } else {
        (e[i], i + 1)
    }
}

fn parse_ternary_recursive(expression: Str) -> char {
    let e = expression.bytes();
    eval_at(e, 0).0 as char
}

// ---- skip: parse_ternary_skip.kara

fn parse_ternary_skip(expression: Str) -> char {
    let e = expression.bytes();
    let mut i = 0;
    while i + 1 < e.len() and e[i + 1] == b'?' {
        if e[i] == b'T' {
            i += 2;
        } else {
            let mut open = 1;
            let mut j = i + 2;
            while open > 0 {
                if e[j] == b'?' {
                    open += 1;
                } else if e[j] == b':' {
                    open -= 1;
                }
                j += 1;
            }
            i = j;
        }
    }
    e[i] as char
}

// ---- rewrite: parse_ternary_rewrite.kara

fn parse_ternary_rewrite(expression: Str) -> char {
    let mut e = expression.bytes().to_vec();
    let mut q = e.len();
    while q > 0 {
        q -= 1;
        if e[q] == b'?' {
            e[q - 1] = if e[q - 1] == b'T' { e[q + 1] } else { e[q + 3] };
            for _ in 0..4 {
                e.remove(q);
            }
        }
    }
    e[0] as char
}

// ---- harness ----------------------------------------------------------

fn solve(arm: i64, expression: Str) -> char {
    if arm == 0 {
        parse_ternary_stack(expression)
    } else if arm == 1 {
        parse_ternary_recursive(expression)
    } else if arm == 2 {
        parse_ternary_skip(expression)
    } else {
        parse_ternary_rewrite(expression)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(seed: mut ref i64) -> char {
    let r = next_random(seed) % 12;
    if r < 10 { (b'0' + r as u8) as char } else if r == 10 { 'T' } else { 'F' }
}

// A random expression of at most depth levels, its mirror image (every
// condition flipped and its branches swapped), its value, and the
// place of the leaf that value comes from.
fn random_case(seed: mut ref i64, depth: i64) -> (String, String, char, i64) {
    if depth == 0 {
        let c = leaf(seed);
        return (f"{c}", f"{c}", c, 0);
    }
    let yes_t = next_random(seed) % 2 == 0;
    let (yes, yes_mirror, yes_value, yes_at) = random_case(seed, if next_random(seed) % 3 == 0 { 0 } else { depth - 1 });
    let (no, no_mirror, no_value, no_at) = random_case(seed, if next_random(seed) % 3 == 0 { 0 } else { depth - 1 });
    if yes_t {
        (f"T?{yes}:{no}", f"F?{no_mirror}:{yes_mirror}", yes_value, 2 + yes_at)
    } else {
        (f"F?{yes}:{no}", f"T?{no_mirror}:{yes_mirror}", no_value, 3 + yes.len() + no_at)
    }
}

// The expression with the character at place at replaced by insert.
fn substitute(expression: Str, at: i64, insert: Str) -> String {
    let before = expression[0..at];
    let after = expression[at + 1..expression.len()];
    f"{before}{insert}{after}"
}

fn report(p: i64, arm: i64, case: i64, ok: bool, failures: mut ref Vec[i64]) {
    if not ok {
        failures[0] += 1;
        failures[p] += 1;
        if failures[0] <= 10 {
            println(f"FAIL P{p} arm {arm} case {case}");
        }
    }
}

fn main() {
    let mut seed: i64 = 4390;
    let mut checks: i64 = 0;
    let mut failures = vec![0; 6];
    for case in 0..1500 {
        let (expression, mirror, want, picked) = random_case(mut seed, 1 + next_random(mut seed) % 10);
        let (other, _, other_value, _) = random_case(mut seed, next_random(mut seed) % 6);
        let wrapped_yes = f"T?{expression}:{other}";
        let wrapped_no = f"F?{other}:{expression}";
        // other in place of the leaf the value comes from, and in place
        // of another leaf, one the value does not come from.
        let e = expression.bytes();
        let mut unpicked: Vec[i64] = Vec.new();
        for i in 0..e.len() {
            if i != picked and e[i] != b'?' and e[i] != b':' and (i + 1 == e.len() or e[i + 1] != b'?') {
                unpicked.push(i);
            }
        }
        let into_picked = substitute(expression, picked, other);
        let into_unpicked = substitute(expression, unpicked[next_random(mut seed) % unpicked.len()], other);
        // k conditions nested to the right, the first T at place j (or
        // none, when j = k), and k T conditions nested to the left.
        let k = 1 + next_random(mut seed) % 30;
        let j = next_random(mut seed) % (k + 1);
        let mut right = String.new();
        for i in 0..k {
            right.push_str(if i == j { "T?" } else { "F?" });
            right.push((b'0' + (i % 10) as u8) as char);
            right.push(':');
        }
        right.push((b'0' + (k % 10) as u8) as char);
        let right_want = (b'0' + (j % 10) as u8) as char;
        let mut left = String.new();
        for _ in 0..k {
            left.push_str("T?");
        }
        left.push('7');
        for i in 0..k {
            left.push(':');
            left.push((b'0' + (i % 7) as u8) as char);
        }
        for arm in 0..4 {
            checks += 5;
            let r = solve(arm, expression);
            report(1, arm, case, r == want, mut failures);
            report(2, arm, case, solve(arm, wrapped_yes) == r and solve(arm, wrapped_no) == r, mut failures);
            report(3, arm, case, solve(arm, into_picked) == other_value and solve(arm, into_unpicked) == r, mut failures);
            report(4, arm, case, solve(arm, mirror) == r, mut failures);
            report(5, arm, case, solve(arm, right) == right_want and solve(arm, left) == '7', mut failures);
        }
    }
    println(f"1500 cases, 4 arms, {checks} checks, {failures[0]} failures");
    if failures[0] > 0 {
        println(f"by property: P1 {failures[1]}, P2 {failures[2]}, P3 {failures[3]}, P4 {failures[4]}, P5 {failures[5]}");
    }
}
