// Benchmark for #424: Longest Repeating Character Replacement -- a window that
// never shrinks.
//
// Slide a window over the string, counting its letters and the largest
// count seen in any window so far. The window is good while the letters
// other than its commonest number at most k. When it is not, slide it
// right by one instead of shrinking it: the answer can only grow when
// some letter's count passes the best seen, so the stale best does no
// harm. The window's final width is the answer. O(n) time, O(1) space.

fn character_replacement(s: Str, k: i64) -> i64 {
    let bytes = s.bytes();
    let mut count = vec![0; 26];
    let mut best = 0;
    let mut left = 0;
    for right in 0..bytes.len() {
        let c = (bytes[right] - b'A') as i64;
        count[c] += 1;
        best = max(best, count[c]);
        if right - left + 1 - best > k {
            count[(bytes[left] - b'A') as i64] -= 1;
            left += 1;
        }
    }
    bytes.len() - left
}

// ---- benchmark ------------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let size = 1000000;
    let calls = 3000;
    let mut seed: i64 = 424;
    // One text of 1,000,000 letters from A to E, written in runs of 1 to
    // 8; each call reads a slice of 10,000 to 99,999 letters of it.
    let mut text = String.new();
    while text.len() < size {
        let letter = char.try_from((65 + step(mut seed) % 5) as u32).unwrap();
        let run = 1 + step(mut seed) % 8;
        for _ in 0..run {
            if text.len() < size {
                text.push(letter);
            }
        }
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..calls {
        let length = 10000 + step(mut seed) * 3 % 90000;
        let start = step(mut seed) * 30 % (size - length);
        let k = step(mut seed) % 50;
        let answer = character_replacement(text[start..start + length], k);
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"{calls} calls: total {total}, checksum {checksum}");
}
