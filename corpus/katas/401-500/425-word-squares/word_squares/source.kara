// LeetCode #425: Word Squares -- a map of prefixes.
//
// Build each square a row at a time. Row r must start with the letters
// already in column r, which the rows above it fix: row 0's letter r,
// row 1's letter r, and so on. Index every word under each of its
// prefixes, so the candidates for a row are one lookup away, and
// backtrack over them. Words may repeat within a square.

fn extend(rows: mut ref Vec[String], length: i64, by_prefix: ref Map[String, Vec[i64]], words: ref Vec[String], found: mut ref Vec[Vec[String]]) {
    let r = rows.len();
    if r == length {
        found.push(rows.clone());
        return;
    }
    let mut prefix = String.new();
    for row in rows {
        prefix.push(row.bytes()[r] as char);
    }
    match by_prefix.get(prefix) {
        Some(candidates) => {
            for i in candidates {
                rows.push(words[i].clone());
                extend(mut rows, length, by_prefix, words, mut found);
                rows.pop();
            }
        }
        None => {}
    }
}

fn word_squares(words: Vec[String]) -> Vec[Vec[String]] {
    let length = words[0].len();
    let mut by_prefix: Map[String, Vec[i64]] = Map.new();
    for i in 0..words.len() {
        let bytes = words[i].bytes();
        let mut prefix = String.new();
        // Row r looks up a prefix of r letters, and r < length, so the
        // whole word is never looked up.
        for k in 0..length {
            by_prefix.entry(prefix.clone()).or_insert(Vec.new()).push(i);
            prefix.push(bytes[k] as char);
        }
    }
    let mut found: Vec[Vec[String]] = Vec.new();
    let mut rows: Vec[String] = Vec.new();
    extend(mut rows, length, by_prefix, words, mut found);
    found
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The squares as "row/row/row" lines, sorted, since any order is allowed.
fn lines(squares: ref Vec[Vec[String]]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for square in squares {
        out.push(square.join("/"));
    }
    out.sort();
    out
}

fn show(text: Str) {
    let words: Vec[String] = text.split_whitespace().map(|p| p.to_string()).collect();
    let found = lines(word_squares(words));
    println(f"\"{text}\": {found.len()} [{found.join(", ")}]");
}

fn main() {
    show("area lead wall lady ball");
    show("abat baba atan atal");
    show("a");
    show("ab");
    show("ab ba");
    show("aa");
    show("abc bde cef");
    show("abc bca cab");
    show("xy yz");
    show("ab bc cd");
    // 300 random lists of 3 to 30 distinct words of 2 to 4 letters
    // from a three-letter alphabet, so that squares are common.
    let mut seed: i64 = 425;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let length = 2 + step(mut seed) % 3;
        let wanted = 3 + step(mut seed) % 28;
        let mut seen: Set[String] = Set.new();
        let mut words: Vec[String] = Vec.new();
        let mut tries = 0;
        while words.len() < wanted and tries < 200 {
            tries += 1;
            let mut word = String.new();
            for _ in 0..length {
                word.push(char.try_from((97 + step(mut seed) % 3) as u32).unwrap());
            }
            if not seen.contains(word) {
                seen.insert(word.clone());
                words.push(word);
            }
        }
        let found = lines(word_squares(words));
        total += found.len();
        for line in found {
            for b in line.bytes() {
                checksum = (checksum * 31 + b as i64) % 1000000007;
            }
        }
    }
    println(f"300 random lists: {total} squares, checksum {checksum}");
}
