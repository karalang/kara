// LeetCode #402: Remove K Digits -- one removal at a time.
//
// Remove one digit k times. Each time, the best single digit to drop is
// the first one that is larger than the digit after it (the first peak),
// or the last digit if the number never falls. Rebuilding after every
// removal makes this O(n * k) time, O(n) space: the stack arm does the
// same removals in one pass.

fn remove_kdigits(num: Str, k: i64) -> String {
    let mut digits: Vec[u8] = Vec.new();
    for c in num.bytes() {
        digits.push(c);
    }
    for _ in 0..k {
        let mut at = digits.len() - 1;
        for i in 0..digits.len() - 1 {
            if digits[i] > digits[i + 1] {
                at = i;
                break;
            }
        }
        digits.remove(at);
        if digits.len() == 0 {
            break;
        }
    }
    let mut start = 0;
    while start < digits.len() and digits[start] == 48 {
        start += 1;
    }
    let mut out = String.new();
    for i in start..digits.len() {
        out.push(digits[i] as char);
    }
    if out.len() == 0 {
        out.push('0');
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(num: Str, k: i64) {
    println(f"\"{num}\", k = {k}: \"{remove_kdigits(num, k)}\"");
}

fn main() {
    show("1432219", 3);
    show("10200", 1);
    show("10", 2);
    show("9", 1);
    show("112", 1);
    show("123456", 3);
    show("654321", 3);
    show("100200", 1);
    show("10001", 4);
    show("1234567890", 9);
    show("5337", 2);
    show("43214321", 4);
    // 3,000 random numbers of 1 to 40 digits with no leading zero, and k
    // from 0 to the length.
    let mut seed: i64 = 402;
    let mut length: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + step(mut seed) % 40;
        let mut num = String.new();
        for i in 0..n {
            let d = if i == 0 { 1 + step(mut seed) % 9 } else { step(mut seed) % 10 };
            num.push((48 + d) as u8 as char);
        }
        let k = step(mut seed) % (n + 1);
        let r = remove_kdigits(num, k);
        length += r.len();
        for b in r.bytes() {
            checksum = (checksum * 31 + b as i64) % 1000000007;
        }
        checksum = (checksum * 31 + 7) % 1000000007;
    }
    println(f"3000 random numbers: {length} digits kept, checksum {checksum}");
}
