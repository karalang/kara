// LeetCode #402: Remove K Digits -- a stack that keeps digits rising.
//
// Read the digits left to right onto a stack. While removals remain and
// the top of the stack is larger than the next digit, that top digit is
// a peak: dropping it makes the number smaller than dropping anything to
// its right, so pop it. Removals left at the end come off the top, the
// largest tail. Strip leading zeros; an empty result is "0".
// O(n) time, O(n) space.

fn remove_kdigits(num: Str, k: i64) -> String {
    let mut left = k;
    let mut stack: Vec[u8] = Vec.new();
    for c in num.bytes() {
        while left > 0 and stack.len() > 0 and stack[stack.len() - 1] > c {
            stack.pop();
            left -= 1;
        }
        stack.push(c);
    }
    while left > 0 {
        stack.pop();
        left -= 1;
    }
    let mut out = String.new();
    for c in stack.iter() {
        if out.len() == 0 and *c == 48 {
            continue;
        }
        out.push(*c as char);
    }
    if out.len() == 0 {
        out.push('0');
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(num: Str, k: i64) {
    println(f"\"{num}\", k = {k}: \"{remove_kdigits(num, k)}\"");
}

fn main() {
    show("1432219", 3);
    show("10200", 1);
    show("10", 2);
    show("9", 1);
    show("112", 1);
    show("123456", 3);
    show("654321", 3);
    show("100200", 1);
    show("10001", 4);
    show("1234567890", 9);
    show("5337", 2);
    show("43214321", 4);
    // 3,000 random numbers of 1 to 40 digits with no leading zero, and k
    // from 0 to the length.
    let mut seed: i64 = 402;
    let mut length: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + step(mut seed) % 40;
        let mut num = String.new();
        for i in 0..n {
            let d = if i == 0 { 1 + step(mut seed) % 9 } else { step(mut seed) % 10 };
            num.push((48 + d) as u8 as char);
        }
        let k = step(mut seed) % (n + 1);
        let r = remove_kdigits(num, k);
        length += r.len();
        for b in r.bytes() {
            checksum = (checksum * 31 + b as i64) % 1000000007;
        }
        checksum = (checksum * 31 + 7) % 1000000007;
    }
    println(f"3000 random numbers: {length} digits kept, checksum {checksum}");
}
