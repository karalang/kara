// LeetCode #450: Delete Node in a BST -- iterative, splicing the node
// out.
//
// Find the node and its parent with a loop, no recursion. A node with
// at most one child is replaced by that child. A node with two is
// replaced by its right subtree, after its left subtree is hung under
// the smallest node of the right one, whose left is empty and whose
// values all exceed the left subtree's. No value moves between nodes,
// but the tree can grow taller. O(height) time, O(1) extra space.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// The subtree that takes the place of node once node is gone.
fn without(node: TreeNode) -> Option[TreeNode] {
    let Some(right) = node.right else {
        return node.left;
    };
    let mut lowest = right;
    while let Some(smaller) = lowest.left {
        lowest = smaller;
    }
    lowest.left = node.left;
    Some(right)
}

fn delete_node(root: Option[TreeNode], key: i64) -> Option[TreeNode] {
    let mut parent: Option[TreeNode] = None;
    let mut current = root;
    while let Some(node) = current {
        if node.val == key {
            break;
        }
        parent = Some(node);
        current = if key < node.val { node.left } else { node.right };
    }
    let Some(target) = current else {
        return root;
    };
    let replacement = without(target);
    match parent {
        None => replacement,
        Some(above) => {
            if key < above.val {
                above.left = replacement;
            } else {
                above.right = replacement;
            }
            root
        }
    }
}

// ---- test harness ---------------------------------------------------------

// Inserts v into the search tree rooted at root (v not already there)
// and returns the root.
fn insert(root: Option[TreeNode], v: i64) -> Option[TreeNode] {
    let fresh = TreeNode { val: v, left: None, right: None };
    let Some(top) = root else {
        return Some(fresh);
    };
    let mut node = top;
    loop {
        if v < node.val {
            match node.left {
                Some(l) => node = l,
                None => {
                    node.left = Some(fresh);
                    break;
                }
            }
        } else {
            match node.right {
                Some(r) => node = r,
                None => {
                    node.right = Some(fresh);
                    break;
                }
            }
        }
    }
    Some(top)
}

fn tree_of(values: Vec[i64]) -> Option[TreeNode] {
    let mut root: Option[TreeNode] = None;
    for v in values {
        root = insert(root, v);
    }
    root
}

fn walk(node: Option[TreeNode], out: mut ref Vec[i64]) {
    if let Some(n) = node {
        walk(n.left, mut out);
        out.push(n.val);
        walk(n.right, mut out);
    }
}

// Whether every value in the tree lies strictly between low and high,
// smaller values to the left and larger to the right.
fn search_tree(node: Option[TreeNode], low: i64, high: i64) -> bool {
    match node {
        Some(n) => low < n.val and n.val < high and search_tree(n.left, low, n.val) and search_tree(n.right, n.val, high),
        None => true,
    }
}

fn listed(values: Vec[i64]) -> String {
    let mut out = String.new();
    for i in 0..values.len() {
        if i > 0 {
            out.push(',');
        }
        out.push_str(f"{values[i]}");
    }
    out
}

fn show(values: Vec[i64], key: i64) {
    let root = tree_of(values);
    let after = delete_node(root, key);
    let mut left: Vec[i64] = Vec.new();
    walk(after, mut left);
    println(f"[{listed(values)}] delete {key}: [{listed(left)}], search tree {search_tree(after, i64.MIN, i64.MAX)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(vec![5, 3, 6, 2, 4, 7], 3);
    show(vec![5, 3, 6, 2, 4, 7], 0);
    show(Vec.new(), 0);
    show(vec![5, 3, 6, 2, 4, 7], 5);
    show(vec![5, 3, 6, 2, 4, 7], 7);
    show(vec![1], 1);
    show(vec![1, 2, 3, 4, 5, 6], 1);
    show(vec![6, 5, 4, 3, 2, 1], 6);
    show(vec![50, 30, 70, 20, 40, 60, 80, 35, 45, 65], 30);
    // 300 random search trees of 0 to 100 distinct values from 0 to
    // 199, inserted in random order or one time in five in ascending
    // order; 20 random keys from 0 to 199 deleted from each in turn.
    let count = 300;
    let mut seed: i64 = 450;
    let mut found = 0;
    let mut missed = 0;
    let mut left_over = 0;
    let mut all_search_trees = true;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % 101;
        let mut used: Set[i64] = Set.new();
        let mut values: Vec[i64] = Vec.new();
        while values.len() < n {
            let v = next_random(mut seed) % 200;
            if used.insert(v) {
                values.push(v);
            }
        }
        if next_random(mut seed) % 5 == 0 {
            values.sort();
        }
        let mut root = tree_of(values);
        let mut size = n;
        for _ in 0..20 {
            let key = next_random(mut seed) % 200;
            root = delete_node(root, key);
            let mut left: Vec[i64] = Vec.new();
            walk(root, mut left);
            if left.len() < size {
                found += 1;
            } else {
                missed += 1;
            }
            size = left.len();
            if not search_tree(root, i64.MIN, i64.MAX) {
                all_search_trees = false;
            }
            for v in left {
                checksum = (checksum * 31 + v) % 1000000007;
            }
        }
        left_over += size;
    }
    println(f"{count} random trees: {found} keys found, {missed} missed, {left_over} nodes left, search trees {all_search_trees}, checksum {checksum}");
}
