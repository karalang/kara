// Benchmark for #498: the ★ arm (walking the zigzag); see
// ../diagonal_traverse.kara.

fn find_diagonal_order(mat: Vec[Vec[i64]]) -> Vec[i64] {
    let m = mat.len();
    let n = mat[0].len();
    let mut out: Vec[i64] = Vec.new();
    let mut r = 0;
    let mut c = 0;
    let mut up = true;
    while out.len() < m * n {
        out.push(mat[r][c]);
        if up {
            if c == n - 1 {
                r += 1;
                up = false;
            } else if r == 0 {
                c += 1;
                up = false;
            } else {
                r -= 1;
                c += 1;
            }
        } else {
            if r == m - 1 {
                c += 1;
                up = true;
            } else if c == 0 {
                r += 1;
                up = true;
            } else {
                r += 1;
                c -= 1;
            }
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 matrices of 10,000 cells (the problem's most), in ten shapes
    // from 1 by 10,000 to 10,000 by 1, with values from -100,000 to
    // 100,000, built once. Then each is traversed 100 times; every
    // traversal is folded into the checksum, each value weighed by its
    // place.
    let rows = vec![1, 4, 10, 25, 50, 100, 200, 400, 1000, 10000];
    let mut seed: i64 = 498;
    let mut all: Vec[Vec[Vec[i64]]] = Vec.new();
    for k in 0..100 {
        let m = rows[k % 10];
        let n = 10000 / m;
        let mut mat: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(next_random(mut seed) % 200001 - 100000);
            }
            mat.push(row);
        }
        all.push(mat);
    }
    let mut checksum: i64 = 0;
    for _ in 0..100 {
        for k in 0..100 {
            let order = find_diagonal_order(all[k]);
            let mut s: i64 = 0;
            for i in 0..order.len() {
                s += order[i] * (i % 7 + 1);
            }
            checksum = (checksum * 31 + s % 1000000007 + 1000000007) % 1000000007;
        }
    }
    println(f"100 matrices of 10000 cells, 100 times each: checksum {checksum}");
}
