// LeetCode #498: Diagonal Traverse -- each diagonal, every other one
// reversed.
//
// Collect each diagonal from its top end to its bottom end; the cells
// of diagonal d are those with row + column = d. The zigzag reads the
// even diagonals upward, so those are reversed before they are added.

fn find_diagonal_order(mat: Vec[Vec[i64]]) -> Vec[i64] {
    let m = mat.len();
    let n = mat[0].len();
    let mut out: Vec[i64] = Vec.new();
    for d in 0..m + n - 1 {
        let mut diagonal: Vec[i64] = Vec.new();
        let mut r = if d < n { 0 } else { d - n + 1 };
        while r < m and r <= d {
            diagonal.push(mat[r][d - r]);
            r += 1;
        }
        if d % 2 == 0 {
            diagonal.reverse();
        }
        out.extend(diagonal);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn show(name: String, mat: Vec[Vec[i64]]) {
    println(f"{name}: {mat} -> {find_diagonal_order(mat)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show("example 1", vec![vec![1, 2, 3], vec![4, 5, 6], vec![7, 8, 9]]);
    show("example 2", vec![vec![1, 2], vec![3, 4]]);
    show("one cell", vec![vec![-100000]]);
    show("one row", vec![vec![1, 2, 3, 4, 5]]);
    show("one column", vec![vec![1], vec![2], vec![3], vec![4]]);
    show("wide", vec![vec![1, 2, 3, 4], vec![5, 6, 7, 8]]);
    show("tall", vec![vec![1, 2], vec![3, 4], vec![5, 6], vec![7, 8]]);
    show("three by five", vec![vec![1, 2, 3, 4, 5], vec![6, 7, 8, 9, 10], vec![11, 12, 13, 14, 15]]);
    // 300 random matrices of 1 to 12 by 1 to 12 with values from
    // -100,000 to 100,000; the checksum weighs each value by its place.
    let count = 300;
    let mut seed: i64 = 498;
    let mut cells = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let m = 1 + next_random(mut seed) % 12;
        let n = 1 + next_random(mut seed) % 12;
        let mut mat: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(next_random(mut seed) % 200001 - 100000);
            }
            mat.push(row);
        }
        let order = find_diagonal_order(mat);
        for v in order {
            cells += 1;
            checksum = (checksum * 31 + v + 100000) % 1000000007;
        }
    }
    println(f"{count} random matrices: {cells} cells, checksum {checksum}");
}
