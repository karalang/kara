// LeetCode #499: The Maze III -- Dijkstra over the places the ball stops.
//
// The ball stops against a wall or at the edge, or drops into the hole
// as it rolls over it, so the states are those cells. Each is settled
// with the least distance, and among equal distances the least
// instructions, the first time it leaves a priority queue ordered by
// that pair. A cell is never reached again more cheaply, since every
// roll covers at least one cell.

fn find_shortest_way(maze: Vec[Vec[i64]], ball: Vec[i64], hole: Vec[i64]) -> String {
    let rows = maze.len();
    let cols = maze[0].len();
    let moves = vec![(1, 0, "d"), (0, -1, "l"), (0, 1, "r"), (-1, 0, "u")];
    let mut done = vec![vec![false; cols]; rows];
    let mut queue: PriorityQueue[(i64, String, i64, i64)] = PriorityQueue.new();
    queue.push((0, "", ball[0], ball[1]));
    while let Some((dist, path, row, col)) = queue.pop() {
        if done[row][col] {
            continue;
        }
        done[row][col] = true;
        if row == hole[0] and col == hole[1] {
            return path;
        }
        for (dr, dc, name) in moves {
            let mut r = row;
            let mut c = col;
            let mut steps = 0;
            while r + dr >= 0 and r + dr < rows and c + dc >= 0 and c + dc < cols and maze[r + dr][c + dc] == 0 {
                r += dr;
                c += dc;
                steps += 1;
                if r == hole[0] and c == hole[1] {
                    break;
                }
            }
            if steps > 0 and not done[r][c] {
                queue.push((dist + steps, path + name, r, c));
            }
        }
    }
    "impossible"
}

// ---- test harness ---------------------------------------------------------

fn show(name: String, maze: Vec[Vec[i64]], ball: Vec[i64], hole: Vec[i64]) {
    println(f"{name}: from {ball} to {hole} -> {find_shortest_way(maze, ball, hole)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let first = vec![
        vec![0, 0, 0, 0, 0],
        vec![1, 1, 0, 0, 1],
        vec![0, 0, 0, 0, 0],
        vec![0, 1, 0, 0, 1],
        vec![0, 1, 0, 0, 0],
    ];
    show("example 1", first, vec![4, 3], vec![0, 1]);
    show("example 2", first, vec![4, 3], vec![3, 0]);
    show("example 3", vec![
        vec![0, 0, 0, 0, 0, 0, 0],
        vec![0, 0, 1, 0, 0, 1, 0],
        vec![0, 0, 0, 0, 1, 0, 0],
        vec![0, 0, 0, 0, 0, 0, 1],
    ], vec![0, 4], vec![3, 5]);
    show("two cells", vec![vec![0, 0]], vec![0, 0], vec![0, 1]);
    show("a hole mid-row", vec![vec![0, 0, 0, 0, 0]], vec![0, 4], vec![0, 2]);
    show("a column", vec![vec![0], vec![0], vec![0], vec![0]], vec![3, 0], vec![0, 0]);
    // Two ways of length 4 to the far corner: "dr" and "rd"; "dr" wins.
    show("a tie", vec![
        vec![0, 0, 0],
        vec![0, 0, 0],
        vec![0, 0, 0],
    ], vec![0, 0], vec![2, 2]);
    show("walled in", vec![
        vec![0, 1, 0],
        vec![1, 1, 0],
        vec![0, 0, 0],
    ], vec![0, 0], vec![2, 2]);
    // 300 random mazes of 1 to 12 by 1 to 12 cells, a wall in each cell
    // with odds of 1 in 5, 1 in 3 or 1 in 2 in turn, with a ball and a
    // hole in two different open cells.
    let count = 300;
    let mut seed: i64 = 499;
    let mut reached = 0;
    let mut letters = 0;
    let mut checksum: i64 = 0;
    for k in 0..count {
        let rows = 1 + next_random(mut seed) % 12;
        let cols = 1 + next_random(mut seed) % 12;
        let odds = if k % 3 == 0 { 5 } else if k % 3 == 1 { 3 } else { 2 };
        let mut maze: Vec[Vec[i64]] = Vec.new();
        let mut open: Vec[(i64, i64)] = Vec.new();
        for r in 0..rows {
            let mut line: Vec[i64] = Vec.new();
            for c in 0..cols {
                if next_random(mut seed) % odds == 0 {
                    line.push(1);
                } else {
                    line.push(0);
                    open.push((r, c));
                }
            }
            maze.push(line);
        }
        if open.len() < 2 {
            continue;
        }
        let a = next_random(mut seed) % open.len();
        let mut b = next_random(mut seed) % (open.len() - 1);
        if b >= a {
            b += 1;
        }
        let (br, bc) = open[a];
        let (hr, hc) = open[b];
        let way = find_shortest_way(maze, vec![br, bc], vec![hr, hc]);
        if way != "impossible" {
            reached += 1;
            letters += way.len();
        }
        for ch in way.chars() {
            checksum = (checksum * 31 + ch as i64) % 1000000007;
        }
    }
    println(f"{count} random mazes: the hole reached in {reached}, {letters} instructions in all, checksum {checksum}");
}
