// LeetCode #423: Reconstruct Original Digits from English -- unique letters.
//
// Count the letters. Five digits have a letter no other digit's word
// has: z only in zero, w in two, u in four, x in six, g in eight. With
// those counted, five more letters belong to one remaining digit each:
// h (three, once eight is gone), f (five, once four is gone), s (seven,
// once six is gone), o (one, once zero, two and four are gone) and i
// (nine, once five, six and eight are gone). Write each digit as many
// times as it occurs, in order. O(n) time, O(1) extra space.

fn original_digits(s: Str) -> String {
    let mut letters = vec![0; 26];
    for b in s.bytes() {
        letters[(b - b'a') as i64] += 1;
    }
    let at = |c: u8| (c - b'a') as i64;
    let mut count = vec![0; 10];
    count[0] = letters[at(b'z')];
    count[2] = letters[at(b'w')];
    count[4] = letters[at(b'u')];
    count[6] = letters[at(b'x')];
    count[8] = letters[at(b'g')];
    count[3] = letters[at(b'h')] - count[8];
    count[5] = letters[at(b'f')] - count[4];
    count[7] = letters[at(b's')] - count[6];
    count[1] = letters[at(b'o')] - count[0] - count[2] - count[4];
    count[9] = letters[at(b'i')] - count[5] - count[6] - count[8];
    let mut out = String.new();
    for d in 0..10 {
        for _ in 0..count[d] {
            out.push(char.try_from((48 + d) as u32).unwrap());
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"\"{s}\": \"{original_digits(s)}\"");
}

fn main() {
    show("owoztneoer");
    show("fviefuro");
    show("zero");
    show("nine");
    show("eightthree");
    show("neninine");
    show("seeevsixevisnsxn");
    show("owtowtowt");
    show("evunhtreoinexfestnvewerthsifieoonegi");
    show("rofuhteonree");
    // 2,000 random strings: 1 to 30 digits from 0 to 9, their English
    // words concatenated and then shuffled.
    let names = "zero one two three four five six seven eight nine".split_whitespace();
    let mut seed: i64 = 423;
    let mut letters = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        let count = 1 + step(mut seed) % 30;
        let mut pool: Vec[u8] = Vec.new();
        for _ in 0..count {
            let digit = step(mut seed) % 10;
            for b in names[digit].bytes() {
                pool.push(b);
            }
        }
        for i in 0..pool.len() {
            let j = i + step(mut seed) % (pool.len() - i);
            let keep = pool[i];
            pool[i] = pool[j];
            pool[j] = keep;
        }
        let mut s = String.new();
        for b in pool {
            s.push(b as char);
        }
        let answer = original_digits(s);
        letters += s.len();
        for b in answer.bytes() {
            checksum = (checksum * 31 + (b as i64 - 47)) % 1000000007;
        }
    }
    println(f"2000 random strings, {letters} letters: checksum {checksum}");
}
