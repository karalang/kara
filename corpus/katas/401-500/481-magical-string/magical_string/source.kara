// LeetCode #481: Magical String -- the string read while it is written.
//
// The string starts 1, 2, 2, and from then on every digit read from the
// third on says how long the next run is; the runs alternate between 1s
// and 2s. A read position walks behind the end of a `Vec` and appends
// each run as it reads its length. The read position never catches up:
// it moves on by one each time a run of at least one digit is added.

fn magical_string(n: i64) -> i64 {
    let mut s: Vec[i64] = vec![1, 2, 2];
    let mut read = 2;
    while s.len() < n {
        let next = 3 - s[s.len() - 1];
        for _ in 0..s[read] {
            s.push(next);
        }
        read += 1;
    }
    let mut ones = 0;
    for i in 0..n {
        if s[i] == 1 {
            ones += 1;
        }
    }
    ones
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"n = 6 -> {magical_string(6)}");
    println(f"n = 1 -> {magical_string(1)}");
    let mut small = String.new();
    for n in 1..21 {
        if not small.is_empty() {
            small.push_str(", ");
        }
        small.push_str(f"{magical_string(n)}");
    }
    println(f"n = 1 to 20 -> {small}");
    // Each digit is 1 exactly when the count of 1s goes up there.
    let mut digits = String.new();
    let mut before = 0;
    for n in 1..61 {
        let now = magical_string(n);
        if now > before {
            digits.push('1');
        } else {
            digits.push('2');
        }
        before = now;
    }
    println(f"first 60 digits from the counts: {digits}");
    println(f"n = 99999 -> {magical_string(99999)}");
    println(f"n = 100000 -> {magical_string(100000)}");
    // 300 random cases: n from 1 to 3000 (from 1 to 100000 for one case in
    // fifty).
    let count = 300;
    let mut seed: i64 = 481;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for c in 0..count {
        let mut n = 1 + next_random(mut seed) % 3000;
        if c % 50 == 49 {
            n = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
        }
        let ones = magical_string(n);
        total += ones;
        checksum = (checksum * 31 + ones * 7 + n) % 1000000007;
    }
    println(f"{count} random cases: 1s add up to {total}, checksum {checksum}");
}
