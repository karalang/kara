// LeetCode #496: Next Greater Element I -- from the right.
//
// Walk nums2 from its end keeping a stack of the numbers that could
// still be someone's next greater element, nearest on top. A number
// drops every candidate no greater than itself, since it hides them
// from everything further left; whatever is left on top is its answer.

fn next_greater_element(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[i64] {
    let mut next: Map[i64, i64] = Map.new();
    let mut candidates: Vec[i64] = Vec.new();
    for i in (0..nums2.len()).rev() {
        let x = nums2[i];
        while candidates.len() > 0 and candidates[candidates.len() - 1] <= x {
            candidates.pop();
        }
        let answer = if candidates.is_empty() { -1 } else { candidates[candidates.len() - 1] };
        next.insert(x, answer);
        candidates.push(x);
    }
    nums1.iter().map(|x| next[x]).collect()
}

// ---- test harness ---------------------------------------------------------

fn show(name: String, nums1: Vec[i64], nums2: Vec[i64]) {
    println(f"{name}: {nums1} in {nums2} -> {next_greater_element(nums1, nums2)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show("example 1", vec![4, 1, 2], vec![1, 3, 4, 2]);
    show("example 2", vec![2, 4], vec![1, 2, 3, 4]);
    show("one number", vec![7], vec![7]);
    show("falling", vec![1, 5, 3], vec![5, 4, 3, 2, 1]);
    show("rising", vec![1, 5, 3], vec![1, 2, 3, 4, 5]);
    show("valley", vec![9, 2, 8, 1], vec![9, 2, 8, 1, 10]);
    show("all asked", vec![3, 1, 4, 0, 2], vec![2, 0, 4, 1, 3]);
    show("largest", vec![0, 9999], vec![0, 9999, 10000]);
    // 300 random cases: nums2 is 1 to 30 distinct numbers from 0 to 99,
    // and nums1 is 1 to all of them in a random order.
    let count = 300;
    let mut seed: i64 = 496;
    let mut asked = 0;
    let mut found = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let size = 1 + next_random(mut seed) % 30;
        let mut used = vec![false; 100];
        let mut nums2: Vec[i64] = Vec.new();
        while nums2.len() < size {
            let x = next_random(mut seed) % 100;
            if not used[x] {
                used[x] = true;
                nums2.push(x);
            }
        }
        let wanted = 1 + next_random(mut seed) % size;
        let mut taken = vec![false; nums2.len()];
        let mut nums1: Vec[i64] = Vec.new();
        while nums1.len() < wanted {
            let j = next_random(mut seed) % size;
            if not taken[j] {
                taken[j] = true;
                nums1.push(nums2[j]);
            }
        }
        let answers = next_greater_element(nums1, nums2);
        for a in answers {
            asked += 1;
            if a >= 0 {
                found += 1;
            }
            checksum = (checksum * 31 + a + 2) % 1000000007;
        }
    }
    println(f"{count} random cases: {asked} asked, {found} with a greater number, checksum {checksum}");
}
