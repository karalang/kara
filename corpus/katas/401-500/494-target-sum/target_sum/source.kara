// LeetCode #494: Target Sum -- counting ways by running sum.
//
// After each number, keep how many sign choices so far reach each sum.
// The sums run from -total to total, so they live in a `Vec` shifted by
// the total; each number moves every count both up and down by itself.

fn find_target_sum_ways(nums: Vec[i64], target: i64) -> i64 {
    let mut total = 0;
    for x in nums {
        total += x;
    }
    if target > total or target < -total {
        return 0;
    }
    let width = 2 * total + 1;
    let mut ways: Vec[i64] = vec![0; width];
    ways[total] = 1;
    for x in nums {
        let mut next: Vec[i64] = vec![0; width];
        for s in 0..width {
            if ways[s] > 0 {
                next[s + x] += ways[s];
                next[s - x] += ways[s];
            }
        }
        ways = next;
    }
    ways[target + total]
}

// ---- test harness ---------------------------------------------------------

fn show(name: String, nums: Vec[i64], target: i64) {
    println(f"{name}: {nums} to {target} -> {find_target_sum_ways(nums, target)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show("example 1", vec![1, 1, 1, 1, 1], 3);
    show("example 2", vec![1], 1);
    show("zeros", vec![0, 0, 0, 1], 1);
    show("out of reach", vec![2, 3], 6);
    show("wrong parity", vec![2, 4], 1);
    show("a negative target", vec![1, 2, 3, 4], -2);
    show("all minus", vec![5, 5, 5], -15);
    // 300 random arrays of 1 to 14 numbers from 0 to 20, each with a
    // target from -30 to 30.
    let count = 300;
    let mut seed: i64 = 494;
    let mut total = 0;
    let mut reachable = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let size = 1 + next_random(mut seed) % 14;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..size {
            nums.push(next_random(mut seed) % 21);
        }
        let target = next_random(mut seed) % 61 - 30;
        let ways = find_target_sum_ways(nums, target);
        total += ways;
        if ways > 0 {
            reachable += 1;
        }
        checksum = (checksum * 31 + ways) % 1000000007;
    }
    println(f"{count} random arrays: {reachable} reachable, {total} ways, checksum {checksum}");
}
