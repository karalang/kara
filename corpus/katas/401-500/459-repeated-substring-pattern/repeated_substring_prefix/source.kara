// LeetCode #459: Repeated Substring Pattern -- the prefix function.
//
// The prefix function (KMP's failure table) gives, for the whole
// string, the longest proper prefix that is also a suffix, of length
// p. Then n - p is the shortest period of s, and s is a repeated unit
// exactly when p > 0 and that period divides n. O(n).

fn repeated_substring_pattern(s: String) -> bool {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len();
    let mut border: Vec[i64] = vec![0; n];
    for i in 1..n {
        let mut k = border[i - 1];
        while k > 0 and cs[i] != cs[k] {
            k = border[k - 1];
        }
        if cs[i] == cs[k] {
            k += 1;
        }
        border[i] = k;
    }
    let p = border[n - 1];
    p > 0 and n % (n - p) == 0
}

// ---- test harness ---------------------------------------------------------

fn show(s: String) {
    let answer = repeated_substring_pattern(s);
    println(f"\"{s}\" -> {answer}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show("abab".to_string());
    show("aba".to_string());
    show("abcabcabcabc".to_string());
    show("a".to_string());
    show("aa".to_string());
    show("ab".to_string());
    show("aabaaba".to_string());
    show("abaababaab".to_string());
    show("abcabcabd".to_string());
    show("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzy".to_string());
    // 300 random strings: half built from a repeated unit of 1 to 10
    // letters (1 to 20 copies, and a third of those with one letter
    // changed), half random over 1, 2 or 26 letters.
    let count = 300;
    let mut seed: i64 = 459;
    let mut found = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let letters = [1, 2, 3, 26][next_random(mut seed) % 4];
        let mut s = String.new();
        if next_random(mut seed) % 2 == 0 {
            let mut unit = String.new();
            let size = 1 + next_random(mut seed) % 10;
            for _ in 0..size {
                unit.push(char.try_from(97 + (next_random(mut seed) % letters) as u32).unwrap());
            }
            let copies = 1 + next_random(mut seed) % 20;
            for _ in 0..copies {
                s.push_str(unit.as_str());
            }
            if next_random(mut seed) % 3 == 0 {
                let k = next_random(mut seed) % s.len();
                let mut cs: Vec[char] = s.chars().collect();
                cs[k] = char.try_from(97 + (next_random(mut seed) % 26) as u32).unwrap();
                s = cs.iter().collect();
            }
        } else {
            let n = 1 + next_random(mut seed) % 200;
            for _ in 0..n {
                s.push(char.try_from(97 + (next_random(mut seed) % letters) as u32).unwrap());
            }
        }
        let answer = repeated_substring_pattern(s);
        if answer {
            found += 1;
        }
        checksum = (checksum * 31 + (if answer { s.len() } else { 1 })) % 1000000007;
    }
    println(f"{count} random strings: {found} repeat a substring, checksum {checksum}");
}
