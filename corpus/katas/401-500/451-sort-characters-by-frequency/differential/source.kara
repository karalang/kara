// Differential test for LeetCode #451: Sort Characters By Frequency.
//
// Copies of the four arms, each run on 1,500 random strings of 0 to 60
// characters drawn from the first 1, 3, 10 or all 62 digits and letters.
// Properties:
//   P1  the answer is a correct one: the same characters, each
//       character's copies together, runs never growing longer
//   P2  the answer is brute force's, ties broken by the smaller
//       character first
//   P3  the same characters in another order give the same answer
//   P4  renaming the characters through a shuffle of the alphabet keeps
//       the run lengths
//   P5  the string written twice gives every run doubled, in order

// ---- map: frequency_sort.kara

fn frequency_sort_map(s: Str) -> String {
    let mut counts: Map[char, i64] = Map.new();
    for c in s.chars() {
        *counts.entry(c).or_insert(0) += 1;
    }
    let mut order: Vec[(i64, char)] = Vec.new();
    for (c, n) in counts {
        order.push((-n, c));
    }
    order.sort();
    let mut out = String.new();
    for (negative, c) in order {
        for _ in 0..-negative {
            out.push(c);
        }
    }
    out
}

// ---- buckets: frequency_sort_buckets.kara

fn frequency_sort_buckets(s: Str) -> String {
    let mut counts = vec![0; 128];
    for c in s.chars() {
        counts[c as i64] += 1;
    }
    let mut buckets: Vec[Vec[char]] = Vec.new();
    for _ in 0..s.len() + 1 {
        buckets.push(Vec.new());
    }
    for code in 0..128 {
        if counts[code] > 0 {
            buckets[counts[code]].push(char.try_from(code as u32).expect("an ASCII code"));
        }
    }
    let mut out = String.new();
    let mut n = s.len();
    while n > 0 {
        for c in buckets[n] {
            for _ in 0..n {
                out.push(c);
            }
        }
        n -= 1;
    }
    out
}

// ---- sorted: frequency_sort_sorted.kara

fn frequency_sort_sorted(s: Str) -> String {
    let mut counts: Map[char, i64] = Map.new();
    for c in s.chars() {
        *counts.entry(c).or_insert(0) += 1;
    }
    let mut chars: Vec[char] = s.chars().collect();
    chars.sort_by(|a, b| {
        let (x, y) = (counts[a], counts[b]);
        if x != y { y.cmp(x) } else { a.cmp(b) }
    });
    let mut out = String.new();
    for c in chars {
        out.push(c);
    }
    out
}

// ---- heap: frequency_sort_heap.kara

fn frequency_sort_heap(s: Str) -> String {
    let mut counts: Map[char, i64] = Map.new();
    for c in s.chars() {
        *counts.entry(c).or_insert(0) += 1;
    }
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    for (c, n) in counts {
        queue.push((n, -(c as i64)));
    }
    let mut out = String.new();
    while let Some((n, negative)) = queue.pop() {
        let c = char.try_from(-negative as u32).expect("a character");
        for _ in 0..n {
            out.push(c);
        }
    }
    out
}

// ---- harness ----------------------------------------------------------

fn sort_by_frequency(arm: i64, s: Str) -> String {
    if arm == 0 {
        frequency_sort_map(s)
    } else if arm == 1 {
        frequency_sort_buckets(s)
    } else if arm == 2 {
        frequency_sort_sorted(s)
    } else {
        frequency_sort_heap(s)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The lengths of the runs of equal characters, in order.
fn runs(s: Str) -> Vec[i64] {
    let chars: Vec[char] = s.chars().collect();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < chars.len() {
        let mut j = i;
        while j < chars.len() and chars[j] == chars[i] {
            j += 1;
        }
        out.push(j - i);
        i = j;
    }
    out
}

fn valid(s: Str, out: Str) -> bool {
    let mut a: Vec[char] = s.chars().collect();
    let mut b: Vec[char] = out.chars().collect();
    let chars = b.clone();
    a.sort();
    b.sort();
    if a != b {
        return false;
    }
    let mut seen: Set[char] = Set.new();
    let mut last_run = i64.MAX;
    let mut i = 0;
    while i < chars.len() {
        let mut j = i;
        while j < chars.len() and chars[j] == chars[i] {
            j += 1;
        }
        if not seen.insert(chars[i]) or j - i > last_run {
            return false;
        }
        last_run = j - i;
        i = j;
    }
    true
}

// The expected answer, by brute force: for each count from n down, the
// characters of the alphabet occurring that often, in order.
fn reference(s: Str, alphabet: Vec[char]) -> String {
    let chars: Vec[char] = s.chars().collect();
    let mut sorted_alphabet = alphabet.clone();
    sorted_alphabet.sort();
    let mut out = String.new();
    let mut n = chars.len();
    while n > 0 {
        for a in sorted_alphabet {
            let mut count = 0;
            for c in chars {
                if c == a {
                    count += 1;
                }
            }
            if count == n {
                for _ in 0..n {
                    out.push(a);
                }
            }
        }
        n -= 1;
    }
    out
}

fn report(p: i64, arm: i64, case: i64, ok: bool, failures: mut ref Vec[i64]) {
    if not ok {
        failures[0] += 1;
        failures[p] += 1;
        if failures[0] <= 10 {
            println(f"FAIL P{p} arm {arm} case {case}");
        }
    }
}

fn main() {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".chars().collect();
    let mut seed: i64 = 4510;
    let mut checks: i64 = 0;
    let mut failures = vec![0; 6];
    for case in 0..1500 {
        // 0 to 60 characters from the first 1, 3, 10 or all 62.
        let n = next_random(mut seed) % 61;
        let k = [1, 3, 10, 62][next_random(mut seed) % 4];
        let mut chars: Vec[char] = Vec.new();
        for _ in 0..n {
            chars.push(alphabet[next_random(mut seed) % k]);
        }
        let mut s = String.new();
        for c in chars {
            s.push(c);
        }
        // The same characters in another order.
        let mut shuffled = chars.clone();
        for i in 0..n {
            shuffled.swap(i, i + next_random(mut seed) % (n - i));
        }
        let mut other_order = String.new();
        for c in shuffled {
            other_order.push(c);
        }
        // Every character renamed through a shuffle of the alphabet.
        let mut renaming = alphabet.clone();
        for i in 0..62 {
            renaming.swap(i, i + next_random(mut seed) % (62 - i));
        }
        let mut renamed = String.new();
        for c in chars {
            let mut at = 0;
            while alphabet[at] != c {
                at += 1;
            }
            renamed.push(renaming[at]);
        }
        let mut twice = s.clone();
        twice.push_str(s);
        let expected = reference(s, alphabet);
        for arm in 0..4 {
            checks += 5;
            let out = sort_by_frequency(arm, s);
            report(1, arm, case, valid(s, out), mut failures);
            report(2, arm, case, out == expected, mut failures);
            report(3, arm, case, sort_by_frequency(arm, other_order) == out, mut failures);
            report(4, arm, case, runs(sort_by_frequency(arm, renamed)) == runs(out), mut failures);
            // Doubling the string doubles every run, in the same order.
            let mut doubled = String.new();
            for c in out.chars() {
                doubled.push(c);
                doubled.push(c);
            }
            report(5, arm, case, sort_by_frequency(arm, twice) == doubled, mut failures);
        }
    }
    println(f"1500 cases, 4 arms, {checks} checks, {failures[0]} failures");
    if failures[0] > 0 {
        println(f"by property: P1 {failures[1]}, P2 {failures[2]}, P3 {failures[3]}, P4 {failures[4]}, P5 {failures[5]}");
    }
}
