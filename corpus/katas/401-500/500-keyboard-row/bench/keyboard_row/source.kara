// Benchmark for #500: the ★ arm (a row number for every letter); see
// ../keyboard_row.kara.

fn find_words(words: Vec[String]) -> Vec[String] {
    let rows = vec!["qwertyuiop", "asdfghjkl", "zxcvbnm"];
    let mut row_of = vec![0; 26];
    for r in 0..3 {
        for ch in rows[r].chars() {
            row_of[ch as i64 - 'a' as i64] = r;
        }
    }
    let mut out: Vec[String] = Vec.new();
    for word in words {
        let mut first = -1;
        let mut one_row = true;
        for ch in word.to_lowercase().chars() {
            let r = row_of[ch as i64 - 'a' as i64];
            if first < 0 {
                first = r;
            } else if r != first {
                one_row = false;
                break;
            }
        }
        if one_row {
            out.push(word.clone());
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20,000 lists of 20 words (the problem's most) of 1 to 100 letters
    // (the problem's most), each word from one row (2 in 3) or the
    // whole alphabet, a letter upper case with odds 1 in 4, built once.
    // Then each list is solved once.
    let rows = vec!["qwertyuiop", "asdfghjkl", "zxcvbnm", "abcdefghijklmnopqrstuvwxyz"];
    let mut pools: Vec[Vec[char]] = Vec.new();
    for r in 0..4 {
        pools.push(rows[r].chars().collect());
    }
    let lists = 20000;
    let mut seed: i64 = 500;
    let mut all: Vec[Vec[String]] = Vec.new();
    for _ in 0..lists {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..20 {
            let pool = if next_random(mut seed) % 3 == 0 { 3 } else { next_random(mut seed) % 3 };
            let length = 1 + next_random(mut seed) % 100;
            let mut word = String.new();
            for _ in 0..length {
                let ch = pools[pool][next_random(mut seed) % pools[pool].len()];
                if next_random(mut seed) % 4 == 0 {
                    word.push(ch.to_ascii_uppercase());
                } else {
                    word.push(ch);
                }
            }
            words.push(word);
        }
        all.push(words);
    }
    let mut kept = 0;
    let mut letters = 0;
    let mut checksum: i64 = 0;
    for k in 0..lists {
        for word in find_words(all[k]) {
            kept += 1;
            letters += word.len();
            checksum = (checksum * 31 + word.len() + word.char_at(0).unwrap() as i64) % 1000000007;
        }
    }
    println(f"{lists} lists of 20 words: {kept} words kept, {letters} letters, checksum {checksum}");
}
