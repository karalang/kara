// LeetCode #484: Find Permutation -- a stack, emptied at every I.
//
// Push 1, 2, ..., n in order. After a D the next number must be smaller,
// so hold on; after an I, or at the end, pop everything held: the
// numbers come out in reverse, which turns each run of Ds into a
// falling run, and the numbers before it are already out.

fn find_permutation(s: String) -> Vec[i64] {
    let mut perm: Vec[i64] = Vec.new();
    let mut held: Vec[i64] = Vec.new();
    let mut next = 1;
    for c in s.chars() {
        held.push(next);
        next += 1;
        if c == 'I' {
            while let Some(x) = held.pop() {
                perm.push(x);
            }
        }
    }
    held.push(next);
    while let Some(x) = held.pop() {
        perm.push(x);
    }
    perm
}

// ---- test harness ---------------------------------------------------------

fn list(v: Vec[i64]) -> String {
    let mut line = String.new();
    for x in v {
        if not line.is_empty() {
            line.push_str(", ");
        }
        line.push_str(f"{x}");
    }
    line
}

fn show(s: String) {
    println(f"'{s}' -> [{list(find_permutation(s))}]");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(String.from("I"));
    show(String.from("DI"));
    show(String.from("D"));
    show(String.from("DDDD"));
    show(String.from("IIII"));
    show(String.from("DIDID"));
    show(String.from("IDDIIDDDI"));
    show(String.from("DDIDDDIIDD"));
    // 300 random patterns of 1 to 40 letters, D with odds of 1 in 4, 1 in
    // 2 or 3 in 4 in turn.
    let count = 300;
    let mut seed: i64 = 484;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for c in 0..count {
        let mut s = String.new();
        let size = 1 + next_random(mut seed) % 40;
        for _ in 0..size {
            if next_random(mut seed) % 4 <= c % 3 {
                s.push('D');
            } else {
                s.push('I');
            }
        }
        for x in find_permutation(s) {
            total += 1;
            checksum = (checksum * 31 + x) % 1000000007;
        }
    }
    println(f"{count} random patterns: {total} numbers, checksum {checksum}");
}
