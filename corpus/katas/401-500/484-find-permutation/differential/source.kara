// Differential test for LeetCode #484: Find Permutation.
//
// Copies of the four arms, on 1,500 patterns, each two random patterns a
// and b joined as a + "I" + b (a of 0 to 14 letters, b of 1 to 15, or
// up to 6 and 7 in one case in two). Properties:
//   P1  the answer is a permutation of 1 to n that fits the pattern
//   P2  for up to 8 numbers, it is the first fitting permutation in
//       lexicographic order, found by stepping through them all
//   P3  the answer for a + "I" + b is the answer for a, then the answer
//       for b with every number moved up by a's length plus one

// ---- star: find_permutation.kara

fn find_permutation_star(s: String) -> Vec[i64] {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len() + 1;
    let mut perm: Vec[i64] = Vec.new();
    for i in 0..n {
        perm.push(i + 1);
    }
    let mut i = 0;
    while i < letters.len() {
        if letters[i] == 'D' {
            let start = i;
            while i < letters.len() and letters[i] == 'D' {
                i += 1;
            }
            // Reverse perm[start..=i].
            let mut low = start;
            let mut high = i;
            while low < high {
                perm.swap(low, high);
                low += 1;
                high -= 1;
            }
        } else {
            i += 1;
        }
    }
    perm
}

// ---- stack: find_permutation_stack.kara

fn find_permutation_stack(s: String) -> Vec[i64] {
    let mut perm: Vec[i64] = Vec.new();
    let mut held: Vec[i64] = Vec.new();
    let mut next = 1;
    for c in s.chars() {
        held.push(next);
        next += 1;
        if c == 'I' {
            while let Some(x) = held.pop() {
                perm.push(x);
            }
        }
    }
    held.push(next);
    while let Some(x) = held.pop() {
        perm.push(x);
    }
    perm
}

// ---- blocks: find_permutation_blocks.kara

fn find_permutation_blocks(s: String) -> Vec[i64] {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len() + 1;
    // last[i]: the end of i's block; first[i]: its start.
    let mut last: Vec[i64] = vec![0; n];
    let mut first: Vec[i64] = vec![0; n];
    last[n - 1] = n - 1;
    for i in (0..n - 1).rev() {
        if letters[i] == 'D' {
            last[i] = last[i + 1];
        } else {
            last[i] = i;
        }
    }
    for i in 1..n {
        if letters[i - 1] == 'D' {
            first[i] = first[i - 1];
        } else {
            first[i] = i;
        }
    }
    let mut perm: Vec[i64] = Vec.new();
    for i in 0..n {
        perm.push(first[i] + last[i] + 1 - i);
    }
    perm
}

// ---- pick: find_permutation_pick.kara

fn find_permutation_pick(s: String) -> Vec[i64] {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len() + 1;
    // falls[i]: the number of Ds starting at position i.
    let mut falls: Vec[i64] = vec![0; n];
    for i in (0..n - 1).rev() {
        if letters[i] == 'D' {
            falls[i] = falls[i + 1] + 1;
        }
    }
    let mut unused: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        unused.push(x);
    }
    let mut perm: Vec[i64] = Vec.new();
    for i in 0..n {
        perm.push(unused.remove(falls[i]));
    }
    perm
}

// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, s: String) -> Vec[i64] {
    match which {
        0 => find_permutation_star(s),
        1 => find_permutation_stack(s),
        2 => find_permutation_blocks(s),
        _ => find_permutation_pick(s),
    }
}

// Whether p is a permutation of 1 to n whose rises and falls are s.
fn fits(p: Vec[i64], s: String) -> bool {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len() + 1;
    if p.len() != n {
        return false;
    }
    let mut seen: Vec[bool] = vec![false; n + 1];
    for x in p {
        if x < 1 or x > n or seen[x] {
            return false;
        }
        seen[x] = true;
    }
    for i in 0..n - 1 {
        if (letters[i] == 'I') != (p[i] < p[i + 1]) {
            return false;
        }
    }
    true
}

// The first permutation of 1 to n, in lexicographic order, that fits s,
// by stepping through them all from 1, 2, ..., n.
fn brute(s: String) -> Vec[i64] {
    let n = s.len() + 1;
    let mut p: Vec[i64] = Vec.new();
    for i in 0..n {
        p.push(i + 1);
    }
    loop {
        if fits(p, s) {
            return p;
        }
        // The next permutation: the last rise, the smallest larger number
        // after it swapped in, and the tail reversed.
        let mut i = n - 2;
        while p[i] > p[i + 1] {
            i -= 1;
        }
        let mut j = n - 1;
        while p[j] < p[i] {
            j -= 1;
        }
        p.swap(i, j);
        let mut low = i + 1;
        let mut high = n - 1;
        while low < high {
            p.swap(low, high);
            low += 1;
            high -= 1;
        }
    }
}

fn main() {
    let names = vec!["star", "stack", "blocks", "pick"];
    let cases = 1500;
    let mut seed: i64 = 4840;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0];
    for c in 0..cases {
        // Two patterns, a of 0 to 14 letters and b of 1 to 15 (up to 6
        // and 7 for one case in two), D with odds of 1 in 4, 1 in 2 or 3
        // in 4 in turn, and their join with an I between.
        let limit = if c % 2 == 0 { 7 } else { 15 };
        let mut parts: Vec[String] = Vec.new();
        for part in 0..2 {
            let mut s = String.new();
            let size = part + next_random(mut seed) % limit;
            for _ in 0..size {
                if next_random(mut seed) % 4 <= c % 3 {
                    s.push('D');
                } else {
                    s.push('I');
                }
            }
            parts.push(s);
        }
        let a = parts[0].clone();
        let b = parts[1].clone();
        let mut joined = a.clone();
        joined.push('I');
        joined.push_str(b.as_str());
        let smallest = if joined.len() <= 7 { brute(joined) } else { Vec.new() };
        for which in 0..4 {
            let got = arm(which, joined);
            // P1: a permutation of 1 to n that fits the pattern.
            checks += 1;
            if not fits(got, joined) {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: '{joined}' gave {got}");
                }
            }
            // P2: for up to 8 numbers, the first fitting permutation in
            // lexicographic order.
            if not smallest.is_empty() {
                checks += 1;
                if got != smallest {
                    failures += 1;
                    by_property[1] += 1;
                    if failures <= 5 {
                        println(f"P2 {names[which]}: '{joined}' gave {got}, want {smallest}");
                    }
                }
            }
            // P3: an I between two patterns joins their answers, the
            // second's numbers moved up past the first's.
            checks += 1;
            let mut want = arm(which, a);
            let shift = want.len();
            for x in arm(which, b) {
                want.push(x + shift);
            }
            if got != want {
                failures += 1;
                by_property[2] += 1;
                if failures <= 5 {
                    println(f"P3 {names[which]}: '{a}' + 'I' + '{b}' gave {got}, want {want}");
                }
            }
        }
    }
    println(f"{cases} cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}");
    }
}
