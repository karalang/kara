// Benchmark for #484: the ★ arm (1 to n, each run of Ds reversed) on a
// large workload.
//
// LeetCode #484: Find Permutation -- 1 to n, each run of Ds reversed.
//
// Start from 1, 2, ..., n, the smallest permutation, which fits every I.
// A run of Ds from position a to b needs the numbers at a to b + 1 to
// fall, and the smallest way to do that, without touching anything to
// its left, is to reverse those numbers in place. Runs are separated by
// Is, so the reversals never overlap.

fn find_permutation(s: String) -> Vec[i64] {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len() + 1;
    let mut perm: Vec[i64] = Vec.new();
    for i in 0..n {
        perm.push(i + 1);
    }
    let mut i = 0;
    while i < letters.len() {
        if letters[i] == 'D' {
            let start = i;
            while i < letters.len() and letters[i] == 'D' {
                i += 1;
            }
            // Reverse perm[start..=i].
            let mut low = start;
            let mut high = i;
            while low < high {
                perm.swap(low, high);
                low += 1;
                high -= 1;
            }
        } else {
            i += 1;
        }
    }
    perm
}

// ---- benchmark ------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 patterns of 100,000 letters, D with odds from 0 in 20 to 19 in
    // 20, built once, then each solved 10 times.
    let mut patterns: Vec[String] = Vec.new();
    let mut seed: i64 = 484;
    for p in 0..20 {
        let mut s = String.new();
        for _ in 0..100000 {
            if next_random(mut seed) % 20 < p {
                s.push('D');
            } else {
                s.push('I');
            }
        }
        patterns.push(s);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..10 {
        for s in patterns.iter() {
            let perm = find_permutation(s);
            let n = perm.len();
            total += n;
            checksum = (checksum * 31 + perm[0] + perm[n / 2] * 7 + perm[n - 1] * 13) % 1000000007;
        }
    }
    println(f"200 solves of 100000 letters: {total} numbers, checksum {checksum}");
}
