// LeetCode #484: Find Permutation -- each number from its block.
//
// Cut the positions 0 to n - 1 into blocks at every I: a block runs from
// l to r with only Ds between, and holds the numbers l + 1 to r + 1,
// largest first. So position i, in the block from l to r, gets
// l + r + 1 - i. One pass from the right finds each position's r, one
// from the left its l, and the numbers follow without moving anything.

fn find_permutation(s: String) -> Vec[i64] {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len() + 1;
    // last[i]: the end of i's block; first[i]: its start.
    let mut last: Vec[i64] = vec![0; n];
    let mut first: Vec[i64] = vec![0; n];
    last[n - 1] = n - 1;
    for i in (0..n - 1).rev() {
        if letters[i] == 'D' {
            last[i] = last[i + 1];
        } else {
            last[i] = i;
        }
    }
    for i in 1..n {
        if letters[i - 1] == 'D' {
            first[i] = first[i - 1];
        } else {
            first[i] = i;
        }
    }
    let mut perm: Vec[i64] = Vec.new();
    for i in 0..n {
        perm.push(first[i] + last[i] + 1 - i);
    }
    perm
}

// ---- test harness ---------------------------------------------------------

fn list(v: Vec[i64]) -> String {
    let mut line = String.new();
    for x in v {
        if not line.is_empty() {
            line.push_str(", ");
        }
        line.push_str(f"{x}");
    }
    line
}

fn show(s: String) {
    println(f"'{s}' -> [{list(find_permutation(s))}]");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(String.from("I"));
    show(String.from("DI"));
    show(String.from("D"));
    show(String.from("DDDD"));
    show(String.from("IIII"));
    show(String.from("DIDID"));
    show(String.from("IDDIIDDDI"));
    show(String.from("DDIDDDIIDD"));
    // 300 random patterns of 1 to 40 letters, D with odds of 1 in 4, 1 in
    // 2 or 3 in 4 in turn.
    let count = 300;
    let mut seed: i64 = 484;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for c in 0..count {
        let mut s = String.new();
        let size = 1 + next_random(mut seed) % 40;
        for _ in 0..size {
            if next_random(mut seed) % 4 <= c % 3 {
                s.push('D');
            } else {
                s.push('I');
            }
        }
        for x in find_permutation(s) {
            total += 1;
            checksum = (checksum * 31 + x) % 1000000007;
        }
    }
    println(f"{count} random patterns: {total} numbers, checksum {checksum}");
}
