// LeetCode #426: Convert Binary Search Tree to Sorted Doubly Linked List
// -- in-order recursion.
//
// An in-order walk visits the values in sorted order. Keep the first
// node visited and the last; link each new node after the last (its
// `left` becomes the previous node, the previous node's `right` becomes
// it). At the end, join the last node to the first to close the ring.
// The tree's own `left` and `right` fields become the links, so no node
// is allocated. O(n) time, O(height) stack.

shared struct Node {
    val: i64,
    mut left: Option[Node],
    mut right: Option[Node],
}

fn link(node: Option[Node], first: mut ref Option[Node], last: mut ref Option[Node]) {
    match node {
        Some(n) => {
            link(n.left, mut first, mut last);
            match *last {
                Some(prev) => {
                    prev.right = Some(n);
                    n.left = Some(prev);
                }
                None => {
                    *first = Some(n);
                }
            }
            *last = Some(n);
            link(n.right, mut first, mut last);
        }
        None => {}
    }
}

fn tree_to_doubly_list(root: Option[Node]) -> Option[Node] {
    let mut first: Option[Node] = None;
    let mut last: Option[Node] = None;
    link(root, mut first, mut last);
    match (first, last) {
        (Some(head), Some(tail)) => {
            head.left = Some(tail);
            tail.right = Some(head);
            Some(head)
        }
        _ => None,
    }
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Insert into a binary search tree, returning its root.
fn insert(root: Option[Node], val: i64) -> Option[Node] {
    match root {
        Some(node) => {
            if val < node.val {
                node.left = insert(node.left, val);
            } else {
                node.right = insert(node.right, val);
            }
            Some(node)
        }
        None => Some(Node { val: val, left: None, right: None }),
    }
}

// Walk the ring both ways from its head: n steps right, then n steps
// left, checking that each step back undoes a step forward and that
// both walks come back to the head. Breaks every link afterwards, since
// a ring of strong handles is never freed.
fn read(head: Option[Node], n: i64) -> String {
    let mut forward = String.new();
    let mut backward = String.new();
    let mut ok = true;
    match head {
        Some(h) => {
            let mut cur = h;
            for i in 0..n {
                if i > 0 {
                    forward.push(' ');
                }
                forward.push_str(f"{cur.val}");
                let next = cur.right.expect("a ring has no end");
                match next.left {
                    Some(back) => {
                        if back.val != cur.val {
                            ok = false;
                        }
                    }
                    None => {
                        ok = false;
                    }
                }
                cur = next;
            }
            if cur.val != h.val {
                ok = false;
            }
            for i in 0..n {
                cur = cur.left.expect("a ring has no end");
                if i > 0 {
                    backward.push(' ');
                }
                backward.push_str(f"{cur.val}");
            }
            if cur.val != h.val {
                ok = false;
            }
            for _ in 0..n {
                let next = cur.right.expect("a ring has no end");
                cur.left = None;
                cur.right = None;
                cur = next;
            }
        }
        None => {
            if n != 0 {
                ok = false;
            }
        }
    }
    let mark = if ok { "" } else { " BROKEN" };
    f"[{forward}] back from the tail [{backward}]{mark}"
}

fn show(text: Str) {
    let mut root: Option[Node] = None;
    let mut n = 0;
    for word in text.split_whitespace() {
        root = insert(root, i64.parse(word).unwrap());
        n += 1;
    }
    println(f"{text}: {read(tree_to_doubly_list(root), n)}");
}

fn main() {
    show("4 2 5 1 3");
    show("2 1 3");
    show("");
    show("1");
    show("1 2 3 4 5");
    show("5 4 3 2 1");
    show("-7 100 0");
    show("8 4 12 2 6 10 14 1 3 5 7 9 11 13 15");
    show("3 1 2");
    show("1 3 2");
    // 2,000 random trees of 0 to 40 distinct values from -500 to 499,
    // inserted in random order.
    let mut seed: i64 = 426;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        let n = step(mut seed) % 41;
        let mut used: Set[i64] = Set.new();
        let mut root: Option[Node] = None;
        let mut count = 0;
        while count < n {
            let v = step(mut seed) % 1000 - 500;
            if not used.contains(v) {
                used.insert(v);
                root = insert(root, v);
                count += 1;
            }
        }
        let line = read(tree_to_doubly_list(root), n);
        total += n;
        for b in line.bytes() {
            checksum = (checksum * 31 + b as i64) % 1000000007;
        }
    }
    println(f"2000 random trees, {total} nodes: checksum {checksum}");
}
