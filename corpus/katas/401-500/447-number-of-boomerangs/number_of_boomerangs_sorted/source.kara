// LeetCode #447: Number of Boomerangs -- sorted distances.
//
// For each point, list the squared distances to all the others, sort
// them, and count each run of c equal distances as c * (c - 1) ordered
// pairs. O(n^2 log n) time, O(n) extra space.

fn number_of_boomerangs(points: Vec[(i64, i64)]) -> i64 {
    let n = points.len();
    let mut total = 0;
    for i in 0..n {
        let mut distances: Vec[i64] = Vec.new();
        for j in 0..n {
            if j != i {
                let dx = points[i].0 - points[j].0;
                let dy = points[i].1 - points[j].1;
                distances.push(dx * dx + dy * dy);
            }
        }
        distances.sort();
        let mut start = 0;
        while start < distances.len() {
            let mut end = start;
            while end < distances.len() and distances[end] == distances[start] {
                end += 1;
            }
            let c = end - start;
            total += c * (c - 1);
            start = end;
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn show(points: Vec[(i64, i64)]) {
    let mut s = String.from("[");
    for i in 0..points.len() {
        if i > 0 {
            s.push(',');
        }
        s.push_str(f"[{points[i].0},{points[i].1}]");
    }
    s.push(']');
    println(f"{s}: {number_of_boomerangs(points)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n distinct random points with coordinates in a square of side spread
// around the origin.
fn random_points(seed: mut ref i64, n: i64, spread: i64) -> Vec[(i64, i64)] {
    let mut seen: Set[(i64, i64)] = Set.new();
    let mut points: Vec[(i64, i64)] = Vec.new();
    while points.len() < n {
        let x = next_random(seed) % spread - spread / 2;
        let y = next_random(seed) % spread - spread / 2;
        if seen.insert((x, y)) {
            points.push((x, y));
        }
    }
    points
}

fn main() {
    show(vec![(0, 0), (1, 0), (2, 0)]);
    show(vec![(1, 1), (2, 2), (3, 3)]);
    show(vec![(1, 1)]);
    show(vec![(0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)]);
    show(vec![(0, 0), (3, 4), (-4, 3), (5, 0), (0, -5)]);
    show(vec![(-10000, -10000), (10000, 10000), (10000, -10000), (-10000, 10000)]);
    // 300 random sets of 1 to 80 distinct points (60 at most on the
    // smallest grid), on grids of side 10, 20, 1,000 or 20,001: the
    // small grids repeat distances often.
    let count = 300;
    let mut seed: i64 = 447;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let mut n = 1 + next_random(mut seed) % 80;
        let spread = [10, 20, 1000, 20001][next_random(mut seed) % 4];
        if spread == 10 {
            n = n.min(60);
        }
        let answer = number_of_boomerangs(random_points(mut seed, n, spread));
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"{count} random point sets: {total} boomerangs, checksum {checksum}");
}
