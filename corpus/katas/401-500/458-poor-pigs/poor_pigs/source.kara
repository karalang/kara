// LeetCode #458: Poor Pigs -- grow the number of outcomes until it
// covers the buckets.
//
// With T = minutes_to_test / minutes_to_die rounds, one pig ends in one
// of T + 1 states: dead after round 1, ..., dead after round T, or
// alive. Pigs are independent, so p pigs tell apart (T + 1)^p buckets,
// and the answer is the least p with (T + 1)^p >= buckets. O(log
// buckets).

fn poor_pigs(buckets: i64, minutes_to_die: i64, minutes_to_test: i64) -> i64 {
    let states = minutes_to_test / minutes_to_die + 1;
    let mut pigs = 0;
    let mut covered = 1;
    while covered < buckets {
        covered *= states;
        pigs += 1;
    }
    pigs
}


// ---- test harness ---------------------------------------------------------

fn show(buckets: i64, minutes_to_die: i64, minutes_to_test: i64) {
    let pigs = poor_pigs(buckets, minutes_to_die, minutes_to_test);
    println(f"buckets {buckets}, minutes_to_die {minutes_to_die}, minutes_to_test {minutes_to_test} -> {pigs}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(4, 15, 15);
    show(4, 15, 30);
    show(1000, 15, 60);
    show(1, 1, 1);
    show(2, 1, 1);
    show(1000, 1, 1);
    show(1000, 1, 9);
    show(1001, 1, 9);
    show(1000, 100, 100);
    show(1000, 1, 100);
    show(1000000000000, 7, 20);
    // 300 random cases: 1 to 10^12 buckets, spread over every number of
    // digits, and 1 <= minutes_to_die <= minutes_to_test <= 100.
    let count = 300;
    let mut seed: i64 = 458;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let digits = next_random(mut seed) % 13;
        let mut top = 1;
        for _ in 0..digits {
            top *= 10;
        }
        let r = (next_random(mut seed) * 65536 + next_random(mut seed)) * 65536 + next_random(mut seed);
        let buckets = 1 + r % top;
        let die = 1 + next_random(mut seed) % 100;
        let test = die + next_random(mut seed) % (101 - die);
        let pigs = poor_pigs(buckets, die, test);
        total += pigs;
        checksum = (checksum * 31 + pigs * 1000003 + buckets % 1000) % 1000000007;
    }
    println(f"{count} random cases: {total} pigs, checksum {checksum}");
}
