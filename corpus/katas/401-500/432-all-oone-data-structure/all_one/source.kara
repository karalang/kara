// LeetCode #432: All O`one Data Structure -- a list of count buckets.
//
// Keep a doubly linked list of buckets in ascending count order, each
// bucket holding the keys with that count, between two sentinels; a map
// takes each key to its bucket. `inc` moves a key to the bucket one
// count up, which is the next bucket or a new one linked in after its
// own, and `dec` moves it one count down the same way; a bucket left
// empty is unlinked. The smallest count is right after the head
// sentinel and the largest right before the tail. Every operation is
// O(1) (hashing aside).
//
// The `next` links are strong and the `prev` links `weak`, so the list
// holds no cycle of strong handles and frees itself.

shared struct Bucket {
    count: i64,
    mut keys: Set[String],
    mut prev: weak Bucket,
    mut next: Option[Bucket],
}

struct AllOne {
    head: Bucket,
    tail: Bucket,
    bucket_of: Map[String, Bucket],
}

fn bucket(count: i64) -> Bucket {
    Bucket { count: count, keys: Set.new(), prev: None, next: None }
}

// Link a new bucket of `count` in after `at`, and return it.
fn link_after(at: Bucket, count: i64) -> Bucket {
    let b = bucket(count);
    let after = at.next.expect("the tail sentinel ends the list");
    b.prev = at;
    b.next = Some(after);
    after.prev = b;
    at.next = Some(b);
    b
}

fn unlink(b: Bucket) {
    let before = b.prev.expect("the head sentinel starts the list");
    let after = b.next.expect("the tail sentinel ends the list");
    before.next = Some(after);
    after.prev = before;
}

// Any key of a bucket; "" for a sentinel.
fn any_key(b: Bucket) -> String {
    for k in b.keys {
        return k.clone();
    }
    String.new()
}

impl AllOne {
    fn new() -> AllOne {
        // The tail's count, -1, is never one more than a real count.
        let head = bucket(0);
        let tail = bucket(-1);
        head.next = Some(tail);
        tail.prev = head;
        AllOne { head: head, tail: tail, bucket_of: Map.new() }
    }

    fn inc(mut ref self, key: Str) {
        let cur = match self.bucket_of.get(key) {
            Some(b) => b,
            None => self.head,
        };
        let after = cur.next.expect("the tail sentinel ends the list");
        let up = if after.count == cur.count + 1 { after } else { link_after(cur, cur.count + 1) };
        up.keys.insert(key.to_string());
        self.bucket_of.insert(key.to_string(), up);
        if cur.count > 0 {
            cur.keys.remove(key);
            if cur.keys.len() == 0 {
                unlink(cur);
            }
        }
    }

    // The key is present, as the problem guarantees.
    fn dec(mut ref self, key: Str) {
        let cur = self.bucket_of.get(key).expect("dec of a key that is present").clone();
        if cur.count == 1 {
            self.bucket_of.remove(key);
        } else {
            let before = cur.prev.expect("the head sentinel starts the list");
            let down = if before.count == cur.count - 1 { before } else { link_after(before, cur.count - 1) };
            down.keys.insert(key.to_string());
            self.bucket_of.insert(key.to_string(), down);
        }
        cur.keys.remove(key);
        if cur.keys.len() == 0 {
            unlink(cur);
        }
    }

    fn get_max_key(self) -> String {
        let tail = self.tail;
        any_key(tail.prev.expect("the head sentinel starts the list"))
    }

    fn get_min_key(self) -> String {
        let head = self.head;
        any_key(head.next.expect("the tail sentinel ends the list"))
    }
}

// ---- test harness ---------------------------------------------------------

// A max or min answer, checked against `counts`, the harness's own count
// of every key: the key must have the largest (or smallest) count, and
// the answer is "" exactly when there are no keys. The problem lets any
// key with that count be returned, so the key is printed only when it
// is the only one; otherwise the count and how many keys share it.
fn check(kind: Str, got: String, counts: ref Map[String, i64]) -> String {
    if counts.len() == 0 {
        let mark = if got == "" { "" } else { " FAILED" };
        return f"{kind} none{mark}";
    }
    let mut want = -1;
    for (_, c) in counts {
        if want < 0 or (kind == "max" and c > want) or (kind == "min" and c < want) {
            want = c;
        }
    }
    let mut holders = 0;
    for (_, c) in counts {
        if c == want {
            holders += 1;
        }
    }
    let ok = match counts.get(got) {
        Some(c) => *c == want,
        None => false,
    };
    let mark = if ok { "" } else { " FAILED" };
    if holders == 1 {
        f"{kind} {got}{mark}"
    } else {
        f"{kind} one of {holders} at {want}{mark}"
    }
}

// Apply one operation, keeping `counts` in step; a query's answer is
// appended to `answers`.
fn apply(ds: mut ref AllOne, op: Str, key: Str, counts: mut ref Map[String, i64], answers: mut ref Vec[String]) {
    if op == "inc" {
        ds.inc(key);
        let c = match counts.get(key) {
            Some(c) => *c,
            None => 0,
        };
        counts.insert(key.to_string(), c + 1);
    } else if op == "dec" {
        ds.dec(key);
        let c = counts.get(key).expect("dec of a key that is present");
        if *c == 1 {
            counts.remove(key);
        } else {
            counts.insert(key.to_string(), *c - 1);
        }
    } else if op == "max" {
        answers.push(check("max", ds.get_max_key(), counts));
    } else {
        answers.push(check("min", ds.get_min_key(), counts));
    }
}

// Run a script of operations separated by ", ": "inc k", "dec k", "max"
// or "min".
fn run(script: Str) {
    let mut ds = AllOne.new();
    let mut counts: Map[String, i64] = Map.new();
    let mut answers: Vec[String] = Vec.new();
    for step in script.split(", ") {
        let words: Vec[Str] = step.split(" ").collect();
        let key = if words.len() > 1 { words[1].clone() } else { String.new() };
        apply(mut ds, words[0], key, mut counts, mut answers);
    }
    let mut out = String.new();
    for i in 0..answers.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(answers[i]);
    }
    println(f"{script} -> {out}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    run("inc hello, inc hello, max, min, inc leet, max, min");
    run("max, min");
    run("inc a, dec a, max, min");
    run("inc a, inc b, inc b, inc c, inc c, inc c, max, min, dec c, dec c, max, min");
    run("inc a, inc a, inc a, dec a, dec a, max, min");
    run("inc x, inc y, inc z, max, min, inc y, max, min, dec y, dec y, max, min");
    run("inc a, inc a, inc a, inc b, dec a, max, min, dec a, max, min, dec b, max, min");
    // 20,000 random operations on 50 keys: an inc, a dec of a key that is
    // present, or a query.
    let mut seed: i64 = 432;
    let mut ds = AllOne.new();
    let mut counts: Map[String, i64] = Map.new();
    let mut answers: Vec[String] = Vec.new();
    for _ in 0..20000 {
        let roll = next_random(mut seed) % 20;
        let key = f"k{next_random(mut seed) % 50}";
        if roll < 4 {
            apply(mut ds, "max", "", mut counts, mut answers);
        } else if roll < 8 {
            apply(mut ds, "min", "", mut counts, mut answers);
        } else if roll < 13 and counts.len() > 0 {
            // dec a key that is present: the first present one from a
            // random start, in key order.
            let start = next_random(mut seed) % 50;
            let mut i = 0;
            loop {
                let k = f"k{(start + i) % 50}";
                if counts.contains_key(k) {
                    apply(mut ds, "dec", k, mut counts, mut answers);
                    break;
                }
                i += 1;
            }
        } else {
            apply(mut ds, "inc", key, mut counts, mut answers);
        }
    }
    let mut failed = 0;
    let mut checksum: i64 = 0;
    for a in answers {
        if a.ends_with(" FAILED") {
            failed += 1;
        }
        for b in a.bytes() {
            checksum = (checksum * 31 + b as i64) % 1000000007;
        }
    }
    let mut total = 0;
    for (_, c) in counts {
        total += c;
    }
    println(f"20000 random operations on 50 keys: {answers.len()} queries, {failed} failed, {counts.len()} keys left, total count {total}, checksum {checksum}");
}
