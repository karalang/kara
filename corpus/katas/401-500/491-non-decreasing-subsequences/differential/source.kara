// Differential test for LeetCode #491: Non-decreasing Subsequences.
//
// Copies of the four arms, on 1,500 random arrays of 1 to 10 numbers
// from -1 to 1, -3 to 3 or -20 to 20 in turn. Properties:
//   P1  the answers, sorted, are the subsequences of two or more numbers
//       found by taking or leaving each number in turn, each once
//   P2  each answer has two or more numbers, never decreases and is a
//       subsequence of the array
//   P3  no answer is given twice
//   P4  a number above all the others, appended, gives twice as many
//       answers plus one for each distinct value
//   P5  the array reversed and negated has as many answers

// ---- star: non_decreasing_subsequences.kara

fn extend_star(nums: Vec[i64], from: i64, current: mut ref Vec[i64], out: mut ref Vec[Vec[i64]]) {
    if current.len() >= 2 {
        out.push(current.clone());
    }
    let mut tried: Set[i64] = Set.new();
    for i in from..nums.len() {
        if tried.contains(nums[i]) {
            continue;
        }
        if current.len() == 0 or nums[i] >= current[current.len() - 1] {
            tried.insert(nums[i]);
            current.push(nums[i]);
            extend_star(nums, i + 1, mut current, mut out);
            current.pop();
        }
    }
}

fn find_subsequences_star(nums: Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut current: Vec[i64] = Vec.new();
    extend_star(nums, 0, mut current, mut out);
    out
}

// ---- masks: non_decreasing_subsequences_masks.kara

fn find_subsequences_masks(nums: Vec[i64]) -> Vec[Vec[i64]] {
    let n = nums.len();
    let mut found: Set[Vec[i64]] = Set.new();
    for mask in 0..(1 << n) {
        let mut picked: Vec[i64] = Vec.new();
        let mut rising = true;
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                if picked.len() > 0 and nums[i] < picked[picked.len() - 1] {
                    rising = false;
                    break;
                }
                picked.push(nums[i]);
            }
        }
        if rising and picked.len() >= 2 {
            found.insert(picked);
        }
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    for s in found.into_iter() {
        out.push(s);
    }
    out
}

// ---- grow: non_decreasing_subsequences_grow.kara

fn find_subsequences_grow(nums: Vec[i64]) -> Vec[Vec[i64]] {
    let mut all: Vec[Vec[i64]] = Vec.new();
    let mut seen: Set[Vec[i64]] = Set.new();
    for x in nums {
        let count = all.len();
        for k in 0..count {
            if all[k][all[k].len() - 1] <= x {
                let mut longer = all[k].clone();
                longer.push(x);
                if not seen.contains(longer) {
                    seen.insert(longer.clone());
                    all.push(longer);
                }
            }
        }
        let single = vec![x];
        if not seen.contains(single) {
            seen.insert(single.clone());
            all.push(single);
        }
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    for s in all.into_iter() {
        if s.len() >= 2 {
            out.push(s);
        }
    }
    out
}

// ---- since: non_decreasing_subsequences_since.kara

fn find_subsequences_since(nums: Vec[i64]) -> Vec[Vec[i64]] {
    let mut all: Vec[Vec[i64]] = Vec.new();
    let mut since: Map[i64, i64] = Map.new();
    for x in nums {
        let count = all.len();
        let from = since.get(x) ?? 0;
        for k in from..count {
            if all[k][all[k].len() - 1] <= x {
                let mut longer = all[k].clone();
                longer.push(x);
                all.push(longer);
            }
        }
        if not since.contains_key(x) {
            all.push(vec![x]);
        }
        since.insert(x, count);
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    for s in all.into_iter() {
        if s.len() >= 2 {
            out.push(s);
        }
    }
    out
}

// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, nums: Vec[i64]) -> Vec[Vec[i64]] {
    match which {
        0 => find_subsequences_star(nums),
        1 => find_subsequences_masks(nums),
        2 => find_subsequences_grow(nums),
        _ => find_subsequences_since(nums),
    }
}

// Every subsequence, by taking or leaving each number in turn; a number
// is only taken when it is no smaller than the last one taken.
fn pick(nums: Vec[i64], i: i64, current: mut ref Vec[i64], all: mut ref Vec[Vec[i64]]) {
    if i == nums.len() {
        if current.len() >= 2 {
            all.push(current.clone());
        }
        return;
    }
    pick(nums, i + 1, mut current, mut all);
    if current.len() == 0 or nums[i] >= current[current.len() - 1] {
        current.push(nums[i]);
        pick(nums, i + 1, mut current, mut all);
        current.pop();
    }
}

// The reference: every subsequence picked, sorted, and each kept once.
fn reference(nums: Vec[i64]) -> Vec[Vec[i64]] {
    let mut all: Vec[Vec[i64]] = Vec.new();
    let mut current: Vec[i64] = Vec.new();
    pick(nums, 0, mut current, mut all);
    all.sort();
    let mut distinct: Vec[Vec[i64]] = Vec.new();
    for s in all.into_iter() {
        if distinct.len() == 0 or distinct[distinct.len() - 1] != s {
            distinct.push(s);
        }
    }
    distinct
}

// Whether `s` has two or more numbers, never decreases, and can be read
// off `nums` left to right.
fn well_formed(s: Vec[i64], nums: Vec[i64]) -> bool {
    if s.len() < 2 {
        return false;
    }
    for k in 1..s.len() {
        if s[k] < s[k - 1] {
            return false;
        }
    }
    let mut at = 0;
    for x in nums.iter() {
        if at < s.len() and *x == s[at] {
            at += 1;
        }
    }
    at == s.len()
}

fn main() {
    let names = vec!["star", "masks", "grow", "since"];
    let cases = 1500;
    let mut seed: i64 = 4910;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0, 0, 0];
    for c in 0..cases {
        // 1 to 10 numbers, from -1 to 1, -3 to 3 or -20 to 20 in turn.
        let spread = if c % 3 == 0 { 1 } else if c % 3 == 1 { 3 } else { 20 };
        let size = 1 + next_random(mut seed) % 10;
        let mut nums: Vec[i64] = Vec.new();
        let mut top = -100;
        for _ in 0..size {
            let x = next_random(mut seed) % (2 * spread + 1) - spread;
            nums.push(x);
            top = top.max(x);
        }
        let mut values: Set[i64] = Set.new();
        for x in nums.iter() {
            values.insert(*x);
        }
        let mut appended = nums.clone();
        appended.push(top + 1);
        let mut turned: Vec[i64] = Vec.new();
        for k in 0..nums.len() {
            turned.push(-nums[nums.len() - 1 - k]);
        }
        let want = reference(nums);
        for which in 0..4 {
            let got = arm(which, nums);
            let mut sorted = got.clone();
            sorted.sort();
            // P1: the subsequences picked by taking or leaving each number.
            checks += 1;
            if sorted != want {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: {nums} gave {sorted}, want {want}");
                }
            }
            // P2: each answer has two or more numbers, never decreases and
            // is a subsequence of the array.
            checks += 1;
            let mut bad = 0;
            for s in got {
                if not well_formed(s, nums) {
                    bad += 1;
                }
            }
            if bad > 0 {
                failures += 1;
                by_property[1] += 1;
                if failures <= 5 {
                    println(f"P2 {names[which]}: {nums} gave {bad} malformed in {got}");
                }
            }
            // P3: no answer is given twice.
            checks += 1;
            let mut repeats = 0;
            for k in 1..sorted.len() {
                if sorted[k] == sorted[k - 1] {
                    repeats += 1;
                }
            }
            if repeats > 0 {
                failures += 1;
                by_property[2] += 1;
                if failures <= 5 {
                    println(f"P3 {names[which]}: {nums} gave {repeats} repeats in {sorted}");
                }
            }
            // P4: a number above all the others, appended, ends a copy of
            // every answer and one more after each distinct value.
            checks += 1;
            let more = arm(which, appended).len();
            let expected = 2 * got.len() + values.len();
            if more != expected {
                failures += 1;
                by_property[3] += 1;
                if failures <= 5 {
                    println(f"P4 {names[which]}: {appended} gave {more}, want {expected}");
                }
            }
            // P5: the array reversed and negated has as many answers.
            checks += 1;
            let other = arm(which, turned).len();
            if other != got.len() {
                failures += 1;
                by_property[4] += 1;
                if failures <= 5 {
                    println(f"P5 {names[which]}: {turned} gave {other}, want {got.len()}");
                }
            }
        }
    }
    println(f"{cases} cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}, P5 {by_property[4]}");
    }
}
