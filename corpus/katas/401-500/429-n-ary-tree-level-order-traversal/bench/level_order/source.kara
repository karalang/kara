// Benchmark for #429: the breadth-first arm (level_order.kara) on 200
// random trees of 10,000 nodes.

struct Node {
    val: i64,
    children: Vec[Node],
}

fn level_order(root: own Option[Node]) -> Vec[Vec[i64]] {
    let mut levels: Vec[Vec[i64]] = Vec.new();
    let mut level: Vec[Node] = Vec.new();
    match root {
        Some(node) => level.push(node),
        None => {}
    }
    while level.len() > 0 {
        let mut row: Vec[i64] = Vec.new();
        let mut next: Vec[Node] = Vec.new();
        for node in level.into_iter() {
            row.push(node.val);
            for child in node.children.into_iter() {
                next.push(child);
            }
        }
        levels.push(row);
        level = next;
    }
    levels
}

// ---- benchmark harness ----------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build_random(i: i64, vals: ref Vec[i64], kids: ref Vec[Vec[i64]]) -> Node {
    let mut children: Vec[Node] = Vec.new();
    for k in kids[i] {
        children.push(build_random(k, vals, kids));
    }
    Node { val: vals[i], children: children }
}

fn main() {
    let n = 10000;
    let rounds = 200;
    let mut seed: i64 = 429;
    let mut rows = 0;
    let mut checksum: i64 = 0;
    for _ in 0..rounds {
        // Each node after the first hangs under one of the `reach` nodes
        // before it: a small reach makes a deep tree, a large one a
        // wide tree.
        let reach = 10 + step(mut seed) % 1000;
        let mut vals: Vec[i64] = Vec.new();
        let mut kids: Vec[Vec[i64]] = Vec.new();
        for i in 0..n {
            vals.push(step(mut seed) % 10001);
            kids.push(Vec.new());
            if i > 0 {
                let back = 1 + step(mut seed) % min(i, reach);
                kids[i - back].push(i);
            }
        }
        let levels = level_order(Some(build_random(0, vals, kids)));
        rows += levels.len();
        for row in levels {
            checksum = (checksum * 31 + row.len() * 10007 + row[0] + row[row.len() - 1]) % 1000000007;
        }
    }
    println(f"{rounds} rounds of {n} nodes: {rows} levels, checksum {checksum}");
}
