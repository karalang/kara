// Benchmark for #472: the ★ arm (shortest first, word break against the
// words before) on a large workload.
//
// LeetCode #472: Concatenated Words -- shortest first, each word broken
// against the words before it.
//
// A word is concatenated when it splits into two or more shorter words
// of the list, and every such piece is shorter than the word. So take
// the words from shortest to longest, keeping a set of those already
// seen: a word that the set can break whole (word break: which
// prefixes are made of set words) is concatenated, and it joins the set
// either way. The word itself is never in the set when it is tested, so
// any break uses at least two pieces. O(total length x longest word).

fn breaks(word: String, known: Set[String]) -> bool {
    let n = word.len();
    let mut reach = vec![false; n + 1];
    reach[0] = true;
    for end in 1..n + 1 {
        for start in 0..end {
            if reach[start] and known.contains(word[start..end]) {
                reach[end] = true;
                break;
            }
        }
    }
    reach[n]
}

fn find_all_concatenated_words_in_a_dict(words: Vec[String]) -> Vec[String] {
    let mut order = words.clone();
    order.sort_by_key(|w| w.len());
    let mut known: Set[String] = Set.new();
    let mut found: Vec[String] = Vec.new();
    for word in order {
        if not known.is_empty() and breaks(word, known) {
            found.push(word.clone());
        }
        known.insert(word.clone());
    }
    found
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10,000 distinct words: 1,000 of 2 to 5 letters from a to d, then
    // two or three of the words so far put together, a quarter of them
    // with an e on the end, each kept when new and at most 30 letters.
    let size = 10000;
    let mut seed: i64 = 472;
    let mut seen: Set[String] = Set.new();
    let mut words: Vec[String] = Vec.new();
    while words.len() < size {
        let mut w = String.new();
        if words.len() < 1000 {
            let letters = 2 + next_random(mut seed) % 4;
            for _ in 0..letters {
                w.push(char.try_from(97 + (next_random(mut seed) % 4) as u32).unwrap());
            }
        } else {
            let parts = 2 + next_random(mut seed) % 2;
            for _ in 0..parts {
                w.push_str(words[next_random(mut seed) % words.len()].as_str());
            }
            if next_random(mut seed) % 4 == 0 {
                w.push('e');
            }
        }
        if w.len() <= 30 and not seen.contains(w) {
            seen.insert(w.clone());
            words.push(w);
        }
    }
    let rounds = 10;
    let mut found = 0;
    let mut hash_sum: i64 = 0;
    for _ in 0..rounds {
        let got = find_all_concatenated_words_in_a_dict(words);
        found += got.len();
        for w in got {
            let mut h: i64 = 0;
            for b in w.bytes() {
                h = (h * 31 + (b as i64)) % 1000000007;
            }
            hash_sum = (hash_sum + h) % 1000000007;
        }
    }
    println(f"{rounds} rounds on {size} words: {found} concatenated, hash sum {hash_sum}");
}
