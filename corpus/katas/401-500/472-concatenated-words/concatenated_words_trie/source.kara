// LeetCode #472: Concatenated Words -- a trie of every word, and a
// search from each position remembered when it fails.
//
// All the words go into a trie (26 children a node, and a mark where a
// word ends). For a word, walk the trie from a position along the word;
// every mark passed is a word that ends there, and the search goes on
// from that end. The word is concatenated when the search reaches its
// end in two or more pieces, so a single piece reaching the end counts
// only when it did not start at 0. A position from which the rest
// cannot be finished is remembered, so each is tried once.

struct Trie {
    next: Vec[i64],
    ends: Vec[bool],
}

impl Trie {
    fn new() -> Trie {
        Trie { next: vec![-1; 26], ends: vec![false] }
    }

    fn insert(mut ref self, word: String) {
        let mut node = 0;
        for b in word.bytes() {
            let at = node * 26 + (b as i64) - 97;
            if self.next[at] < 0 {
                self.next[at] = self.ends.len();
                self.ends.push(false);
                for _ in 0..26 {
                    self.next.push(-1);
                }
            }
            node = self.next[at];
        }
        self.ends[node] = true;
    }
}

fn finish(trie: Trie, word: Vec[u8], start: i64, dead: mut ref Vec[bool]) -> bool {
    if dead[start] {
        return false;
    }
    let n = word.len();
    let mut node = 0;
    let mut at = start;
    while at < n {
        node = trie.next[node * 26 + (word[at] as i64) - 97];
        if node < 0 {
            break;
        }
        at += 1;
        if trie.ends[node] {
            if at == n {
                if start > 0 {
                    return true;
                }
            } else if finish(trie, word, at, dead) {
                return true;
            }
        }
    }
    dead[start] = true;
    false
}

fn find_all_concatenated_words_in_a_dict(words: Vec[String]) -> Vec[String] {
    let mut trie = Trie.new();
    for word in words {
        trie.insert(word);
    }
    let mut found: Vec[String] = Vec.new();
    for word in words {
        let letters: Vec[u8] = word.bytes().to_vec();
        let mut dead = vec![false; letters.len() + 1];
        if finish(trie, letters, 0, mut dead) {
            found.push(word.clone());
        }
    }
    found
}

// ---- test harness ---------------------------------------------------------

fn show(words: Vec[String]) {
    let mut got = find_all_concatenated_words_in_a_dict(words);
    got.sort();
    let mut line = String.new();
    for w in got {
        line.push(' ');
        line.push_str(w.as_str());
    }
    println(f"{words.len()} words -> {got.len()}:{line}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `base` random words of 1 to 4 letters, then `joined` tries at two to
// four of the words so far put together, a quarter of them with one
// more letter on the end; a word already in the list, or longer than
// the problem's 30 letters, is skipped.
fn random_words(seed: mut ref i64, letters: i64, base: i64, joined: i64) -> Vec[String] {
    let mut seen: Set[String] = Set.new();
    let mut words: Vec[String] = Vec.new();
    let mut tries = 0;
    while words.len() < base and tries < 100 {
        tries += 1;
        let mut w = String.new();
        let size = 1 + next_random(seed) % 4;
        for _ in 0..size {
            w.push(char.try_from(97 + (next_random(seed) % letters) as u32).unwrap());
        }
        if not seen.contains(w) {
            seen.insert(w.clone());
            words.push(w);
        }
    }
    for _ in 0..joined {
        let parts = 2 + next_random(seed) % 3;
        let mut w = String.new();
        for _ in 0..parts {
            w.push_str(words[next_random(seed) % words.len()].as_str());
        }
        if next_random(seed) % 4 == 0 {
            w.push(char.try_from(97 + (next_random(seed) % letters) as u32).unwrap());
        }
        if w.len() <= 30 and not seen.contains(w) {
            seen.insert(w.clone());
            words.push(w);
        }
    }
    words
}

fn main() {
    show(vec!["cat", "cats", "catsdogcats", "dog", "dogcatsdog", "hippopotamuses", "rat", "ratcatdogcat"]);
    show(vec!["cat", "dog", "catdog"]);
    show(vec!["a", "aa", "aaa", "aaaa"]);
    show(vec!["ab", "a", "b", "ba", "aba", "abab", "c"]);
    show(vec!["cat"]);
    show(vec!["xyz", "xy", "z", "yz", "x"]);
    show(vec!["abc", "ab", "cd", "abcd", "bcd", "a"]);
    // 300 random lists over 1, 2 or 3 letters.
    let count = 300;
    let mut seed: i64 = 472;
    let mut total_words = 0;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let letters = 1 + next_random(mut seed) % 3;
        let base = 2 + next_random(mut seed) % 11;
        let joined = next_random(mut seed) % 31;
        let words = random_words(mut seed, letters, base, joined);
        let mut got = find_all_concatenated_words_in_a_dict(words);
        got.sort();
        total_words += words.len();
        total += got.len();
        for w in got {
            for b in w.bytes() {
                checksum = (checksum * 31 + (b as i64)) % 1000000007;
            }
            checksum = (checksum * 31 + 1) % 1000000007;
        }
    }
    println(f"{count} random lists, {total_words} words: {total} concatenated, checksum {checksum}");
}
