// LeetCode #472: Concatenated Words -- which suffixes are made of
// words, remembered across all the words.
//
// A word is concatenated when some proper prefix of it is a word and
// the rest is made of one or more words. Whether a string is made of
// words does not depend on which word it came from, so the answers are
// kept in one map keyed by the string itself and shared by every word:
// the many words that end the same way ask once.

fn made_of_words(rest: String, all: Set[String], memo: mut ref Map[String, bool]) -> bool {
    if let Some(known) = memo.get(rest) {
        return *known;
    }
    let n = rest.len();
    let mut answer = all.contains(rest);
    let mut cut = 1;
    while not answer and cut < n {
        if all.contains(rest[..cut]) and made_of_words(rest[cut..].to_string(), all, memo) {
            answer = true;
        }
        cut += 1;
    }
    memo.insert(rest.clone(), answer);
    answer
}

fn find_all_concatenated_words_in_a_dict(words: Vec[String]) -> Vec[String] {
    let mut all: Set[String] = Set.new();
    for word in words {
        all.insert(word.clone());
    }
    let mut memo: Map[String, bool] = Map.new();
    let mut found: Vec[String] = Vec.new();
    for word in words {
        let n = word.len();
        for cut in 1..n {
            if all.contains(word[..cut]) and made_of_words(word[cut..].to_string(), all, mut memo) {
                found.push(word.clone());
                break;
            }
        }
    }
    found
}

// ---- test harness ---------------------------------------------------------

fn show(words: Vec[String]) {
    let mut got = find_all_concatenated_words_in_a_dict(words);
    got.sort();
    let mut line = String.new();
    for w in got {
        line.push(' ');
        line.push_str(w.as_str());
    }
    println(f"{words.len()} words -> {got.len()}:{line}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `base` random words of 1 to 4 letters, then `joined` tries at two to
// four of the words so far put together, a quarter of them with one
// more letter on the end; a word already in the list, or longer than
// the problem's 30 letters, is skipped.
fn random_words(seed: mut ref i64, letters: i64, base: i64, joined: i64) -> Vec[String] {
    let mut seen: Set[String] = Set.new();
    let mut words: Vec[String] = Vec.new();
    let mut tries = 0;
    while words.len() < base and tries < 100 {
        tries += 1;
        let mut w = String.new();
        let size = 1 + next_random(seed) % 4;
        for _ in 0..size {
            w.push(char.try_from(97 + (next_random(seed) % letters) as u32).unwrap());
        }
        if not seen.contains(w) {
            seen.insert(w.clone());
            words.push(w);
        }
    }
    for _ in 0..joined {
        let parts = 2 + next_random(seed) % 3;
        let mut w = String.new();
        for _ in 0..parts {
            w.push_str(words[next_random(seed) % words.len()].as_str());
        }
        if next_random(seed) % 4 == 0 {
            w.push(char.try_from(97 + (next_random(seed) % letters) as u32).unwrap());
        }
        if w.len() <= 30 and not seen.contains(w) {
            seen.insert(w.clone());
            words.push(w);
        }
    }
    words
}

fn main() {
    show(vec!["cat", "cats", "catsdogcats", "dog", "dogcatsdog", "hippopotamuses", "rat", "ratcatdogcat"]);
    show(vec!["cat", "dog", "catdog"]);
    show(vec!["a", "aa", "aaa", "aaaa"]);
    show(vec!["ab", "a", "b", "ba", "aba", "abab", "c"]);
    show(vec!["cat"]);
    show(vec!["xyz", "xy", "z", "yz", "x"]);
    show(vec!["abc", "ab", "cd", "abcd", "bcd", "a"]);
    // 300 random lists over 1, 2 or 3 letters.
    let count = 300;
    let mut seed: i64 = 472;
    let mut total_words = 0;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let letters = 1 + next_random(mut seed) % 3;
        let base = 2 + next_random(mut seed) % 11;
        let joined = next_random(mut seed) % 31;
        let words = random_words(mut seed, letters, base, joined);
        let mut got = find_all_concatenated_words_in_a_dict(words);
        got.sort();
        total_words += words.len();
        total += got.len();
        for w in got {
            for b in w.bytes() {
                checksum = (checksum * 31 + (b as i64)) % 1000000007;
            }
            checksum = (checksum * 31 + 1) % 1000000007;
        }
    }
    println(f"{count} random lists, {total_words} words: {total} concatenated, checksum {checksum}");
}
