// LeetCode #444: Sequence Reconstruction -- Kahn's topological sort.
//
// Each neighbouring pair in a sequence is an edge. The order is unique
// exactly when Kahn's algorithm never has a choice: one value with no
// unplaced predecessor at every step. Each value it places must also
// be the next one in nums, and a cycle leaves values unplaced.
// O(n + total length) time and space.

fn sequence_reconstruction(nums: Vec[i64], sequences: Vec[Vec[i64]]) -> bool {
    let n = nums.len();
    let mut next: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 1 {
        next.push(Vec.new());
    }
    let mut indegree: Vec[i64] = Vec.filled(n + 1, 0);
    for s in sequences {
        for j in 1..s.len() {
            next[s[j - 1]].push(s[j]);
            indegree[s[j]] += 1;
        }
    }
    let mut ready: VecDeque[i64] = VecDeque.new();
    for v in 1..n + 1 {
        if indegree[v] == 0 {
            ready.push_back(v);
        }
    }
    let mut placed = 0;
    while ready.len() > 0 {
        if ready.len() > 1 {
            return false;
        }
        let v = ready.pop_front().expect("one ready value");
        if nums[placed] != v {
            return false;
        }
        placed += 1;
        for w in next[v] {
            indegree[w] -= 1;
            if indegree[w] == 0 {
                ready.push_back(w);
            }
        }
    }
    placed == n
}

// ---- test harness ---------------------------------------------------------

fn list(values: Vec[i64]) -> String {
    let mut out = String.from("[");
    for i in 0..values.len() {
        if i > 0 {
            out.push(',');
        }
        out.push_str(f"{values[i]}");
    }
    out.push(']');
    out
}

fn show(nums: Vec[i64], sequences: Vec[Vec[i64]]) {
    let mut lists = String.new();
    for i in 0..sequences.len() {
        if i > 0 {
            lists.push(',');
        }
        lists.push_str(list(sequences[i]));
    }
    println(f"{list(nums)} [{lists}]: {sequence_reconstruction(nums, sequences)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(vec![1, 2, 3], vec![vec![1, 2], vec![1, 3]]);
    show(vec![1, 2, 3], vec![vec![1, 2]]);
    show(vec![1, 2, 3], vec![vec![1, 2], vec![1, 3], vec![2, 3]]);
    show(vec![1], vec![vec![1]]);
    show(vec![4, 1, 5, 2, 6, 3], vec![vec![5, 2, 6, 3], vec![4, 1, 5, 2]]);
    show(vec![2, 1], vec![vec![2], vec![1]]);
    // Two that break the constraint that every sequence is a
    // subsequence of nums: one forces another order, one a cycle.
    show(vec![1, 2, 3], vec![vec![2, 1], vec![1, 3]]);
    show(vec![1, 2, 3], vec![vec![1, 2], vec![2, 3], vec![3, 1]]);
    // 300 random cases: a shuffle of 1 to n for n up to 60, and windows
    // of it of up to 12 values, each value after a window's first left
    // out one time in ten, so that the windows are subsequences of nums
    // and cover all of its neighbouring pairs a little under half the time.
    let count = 300;
    let mut seed: i64 = 444;
    let mut true_count = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = 1 + next_random(mut seed) % 60;
        let mut nums: Vec[i64] = Vec.new();
        for v in 1..n + 1 {
            nums.push(v);
        }
        let mut i = n - 1;
        while i > 0 {
            let j = next_random(mut seed) % (i + 1);
            nums.swap(i, j);
            i -= 1;
        }
        let mut sequences: Vec[Vec[i64]] = Vec.new();
        let windows = 1 + next_random(mut seed) % (n * 2 + 2);
        for _ in 0..windows {
            let start = next_random(mut seed) % n;
            let length = 1 + next_random(mut seed) % 12;
            let mut s: Vec[i64] = Vec.new();
            for k in start..(start + length).min(n) {
                if s.len() == 0 or next_random(mut seed) % 10 != 0 {
                    s.push(nums[k]);
                }
            }
            sequences.push(s);
        }
        let answer = sequence_reconstruction(nums, sequences);
        if answer {
            true_count += 1;
        }
        checksum = (checksum * 31 + n * 2 + if answer { 1 } else { 0 }) % 1000000007;
    }
    println(f"{count} random cases: {true_count} true, checksum {checksum}");
}
