// LeetCode #457: Circular Array Loop -- peel the graph of valid steps.
//
// Keep only the steps that move and keep their direction; every index
// then has at most one way out. Count the ways in, and repeatedly remove
// indices nothing leads to, following each removal to its target. What
// survives has a way in from another survivor, and in a graph with at
// most one way out that is exactly a cycle. O(n).

fn circular_array_loop(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut next = vec![-1; n];
    let mut ways_in = vec![0; n];
    for i in 0..n {
        let j = ((i + nums[i]) % n + n) % n;
        if j != i and (nums[j] > 0) == (nums[i] > 0) {
            next[i] = j;
            ways_in[j] += 1;
        }
    }
    let mut removed = 0;
    let mut queue: Vec[i64] = Vec.new();
    for i in 0..n {
        if ways_in[i] == 0 {
            queue.push(i);
        }
    }
    let mut head = 0;
    while head < queue.len() {
        let i = queue[head];
        head += 1;
        removed += 1;
        let j = next[i];
        if j >= 0 {
            ways_in[j] -= 1;
            if ways_in[j] == 0 {
                queue.push(j);
            }
        }
    }
    removed < n
}

// ---- test harness ---------------------------------------------------------

fn listed(nums: Vec[i64]) -> String {
    let mut out = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            out.push(',');
        }
        out.push_str(f"{nums[i]}");
    }
    out
}

fn show(nums: Vec[i64]) {
    println(f"[{listed(nums)}]: {circular_array_loop(nums)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(vec![2, -1, 1, 2, 2]);
    show(vec![-1, -2, -3, -4, -5, 6]);
    show(vec![1, -1, 5, 1, 4]);
    show(vec![1]);
    show(vec![1, 1]);
    show(vec![-1, -1]);
    show(vec![1, -1]);
    show(vec![2, 2, 2]);
    show(vec![3, 1, 2]);
    show(vec![-2, 1, -1, -2, -2]);
    show(vec![1000, -1000, 999]);
    // 300 random arrays of 1 to 200 steps, each of size 1 to 3, 10 or
    // 1,000, forward with probability 1/2, 3/4, 15/16 or 1.
    let count = 300;
    let mut seed: i64 = 457;
    let mut found = 0;
    let mut checksum: i64 = 0;
    for case in 0..count {
        let n = 1 + next_random(mut seed) % 200;
        let size = [3, 10, 1000][next_random(mut seed) % 3];
        let backward = [2, 4, 16, 0][next_random(mut seed) % 4];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let step = 1 + next_random(mut seed) % size;
            if backward > 0 and next_random(mut seed) % backward == 0 {
                nums.push(-step);
            } else {
                nums.push(step);
            }
        }
        let has = circular_array_loop(nums);
        if has {
            found += 1;
        }
        checksum = (checksum * 31 + (if has { case + 1 } else { 0 })) % 1000000007;
    }
    println(f"{count} random arrays: {found} with a loop, checksum {checksum}");
}
