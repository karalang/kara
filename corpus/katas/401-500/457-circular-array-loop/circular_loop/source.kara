// LeetCode #457: Circular Array Loop -- slow and fast pointers.
//
// From each start not yet ruled out, move a slow pointer one step and a
// fast pointer two, only along steps that keep the start's direction.
// If they meet, the loop they are in is a cycle; it is valid unless it
// is a single index stepping onto itself. Otherwise every index on the
// path leads nowhere valid, so it is zeroed in a copy and never
// started from again. O(n).

fn next_index(nums: Vec[i64], i: i64) -> i64 {
    let n = nums.len();
    ((i + nums[i]) % n + n) % n
}

fn circular_array_loop(nums: Vec[i64]) -> bool {
    let mut a = nums.clone();
    let n = a.len();
    for start in 0..n {
        if a[start] == 0 {
            continue;
        }
        let forward = a[start] > 0;
        let mut slow = start;
        let mut fast = start;
        loop {
            let s = next_index(a, slow);
            let f1 = next_index(a, fast);
            if a[f1] == 0 or (a[f1] > 0) != forward {
                break;
            }
            let f2 = next_index(a, f1);
            if a[f2] == 0 or (a[f2] > 0) != forward {
                break;
            }
            slow = s;
            fast = f2;
            if slow == fast {
                if next_index(a, slow) != slow {
                    return true;
                }
                break;
            }
        }
        // Nothing on this path reaches a valid cycle: clear it.
        let mut i = start;
        while a[i] != 0 and (a[i] > 0) == forward {
            let next = next_index(a, i);
            a[i] = 0;
            i = next;
        }
    }
    false
}

// ---- test harness ---------------------------------------------------------

fn listed(nums: Vec[i64]) -> String {
    let mut out = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            out.push(',');
        }
        out.push_str(f"{nums[i]}");
    }
    out
}

fn show(nums: Vec[i64]) {
    println(f"[{listed(nums)}]: {circular_array_loop(nums)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(vec![2, -1, 1, 2, 2]);
    show(vec![-1, -2, -3, -4, -5, 6]);
    show(vec![1, -1, 5, 1, 4]);
    show(vec![1]);
    show(vec![1, 1]);
    show(vec![-1, -1]);
    show(vec![1, -1]);
    show(vec![2, 2, 2]);
    show(vec![3, 1, 2]);
    show(vec![-2, 1, -1, -2, -2]);
    show(vec![1000, -1000, 999]);
    // 300 random arrays of 1 to 200 steps, each of size 1 to 3, 10 or
    // 1,000, forward with probability 1/2, 3/4, 15/16 or 1.
    let count = 300;
    let mut seed: i64 = 457;
    let mut found = 0;
    let mut checksum: i64 = 0;
    for case in 0..count {
        let n = 1 + next_random(mut seed) % 200;
        let size = [3, 10, 1000][next_random(mut seed) % 3];
        let backward = [2, 4, 16, 0][next_random(mut seed) % 4];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let step = 1 + next_random(mut seed) % size;
            if backward > 0 and next_random(mut seed) % backward == 0 {
                nums.push(-step);
            } else {
                nums.push(step);
            }
        }
        let has = circular_array_loop(nums);
        if has {
            found += 1;
        }
        checksum = (checksum * 31 + (if has { case + 1 } else { 0 })) % 1000000007;
    }
    println(f"{count} random arrays: {found} with a loop, checksum {checksum}");
}
