// LeetCode #474: Ones and Zeroes -- 0/1 knapsack with two budgets, one
// table.
//
// Each string costs its zeros from one budget and its ones from the
// other, and is worth 1. `best[i][j]` is the most strings that fit in
// i zeros and j ones among those seen so far; a new string can be added
// to the best set for the budget it leaves behind. Going through the
// budgets from the top down reads only values from before this string,
// so each string is taken at most once. O(strings x m x n).

fn count_zeros(s: String) -> i64 {
    let mut zeros = 0;
    for c in s.chars() {
        if c == '0' {
            zeros += 1;
        }
    }
    zeros
}

fn find_max_form(strs: Vec[String], m: i64, n: i64) -> i64 {
    let mut best = vec![vec![0; n + 1]; m + 1];
    for s in strs {
        let zeros = count_zeros(s);
        let ones = s.len() - zeros;
        for i in (zeros..m + 1).rev() {
            for j in (ones..n + 1).rev() {
                let take = best[i - zeros][j - ones] + 1;
                if take > best[i][j] {
                    best[i][j] = take;
                }
            }
        }
    }
    best[m][n]
}

// ---- test harness ---------------------------------------------------------

fn show(strs: Vec[String], m: i64, n: i64) {
    let mut line = String.new();
    for s in strs {
        if not line.is_empty() {
            line.push_str(", ");
        }
        line.push_str(s.as_str());
    }
    println(f"[{line}], m = {m}, n = {n} -> {find_max_form(strs, m, n)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 1 to 20 strings of 1 to 8 binary digits, each leaning to zeros, to
// ones, or neither; m and n from 0 to 12.
fn random_strs(seed: mut ref i64) -> Vec[String] {
    let count = 1 + next_random(mut seed) % 20;
    let mut strs: Vec[String] = Vec.new();
    for _ in 0..count {
        let size = 1 + next_random(mut seed) % 8;
        let lean = next_random(mut seed) % 3;
        let mut s = String.new();
        for _ in 0..size {
            let r = next_random(mut seed) % 4;
            let zero = if lean == 0 { r != 0 } else if lean == 1 { r == 0 } else { r < 2 };
            s.push(if zero { '0' } else { '1' });
        }
        strs.push(s);
    }
    strs
}

fn main() {
    show(vec!["10", "0001", "111001", "1", "0"], 5, 3);
    show(vec!["10", "0", "1"], 1, 1);
    show(vec!["10", "0", "1"], 0, 0);
    show(vec!["0", "0", "0", "1"], 2, 0);
    show(vec!["111", "1000", "1000", "1000"], 9, 3);
    show(vec!["00", "000"], 1, 10);
    show(vec!["01", "10", "01", "10", "0011"], 4, 4);
    show(vec!["1"], 0, 1);
    // 300 random cases.
    let count = 300;
    let mut seed: i64 = 474;
    let mut strings = 0;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let strs = random_strs(mut seed);
        let m = next_random(mut seed) % 13;
        let n = next_random(mut seed) % 13;
        let got = find_max_form(strs, m, n);
        strings += strs.len();
        total += got;
        checksum = (checksum * 31 + got + 1) % 1000000007;
    }
    println(f"{count} random cases, {strings} strings: {total} chosen, checksum {checksum}");
}
