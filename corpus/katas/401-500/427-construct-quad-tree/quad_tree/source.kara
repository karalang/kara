// LeetCode #427: Construct Quad Tree -- divide, then merge.
//
// Build the four quadrants first; if all four came back as leaves with
// the same value, the region is uniform and the four leaves merge into
// one. Each cell is read once and each node built once: O(n^2) time.
//
// The tree is a `shared enum`: a region is either a leaf with its value
// or a split into four quadrants (top left, top right, bottom left,
// bottom right). A split's value and a leaf's children, which LeetCode's
// node carries, have no meaning and so no field.

shared enum Quad {
    Leaf(bool),
    Split(Quad, Quad, Quad, Quad),
}

fn build(grid: ref Vec[Vec[i64]], row: i64, col: i64, size: i64) -> Quad {
    if size == 1 {
        return Quad.Leaf(grid[row][col] == 1);
    }
    let half = size / 2;
    let top_left = build(grid, row, col, half);
    let top_right = build(grid, row, col + half, half);
    let bottom_left = build(grid, row + half, col, half);
    let bottom_right = build(grid, row + half, col + half, half);
    match (top_left, top_right, bottom_left, bottom_right) {
        (Quad.Leaf(a), Quad.Leaf(b), Quad.Leaf(c), Quad.Leaf(d)) => {
            if a == b and b == c and c == d {
                return Quad.Leaf(a);
            }
        }
        _ => {}
    }
    Quad.Split(top_left, top_right, bottom_left, bottom_right)
}

fn construct(grid: Vec[Vec[i64]]) -> Quad {
    build(grid, 0, 0, grid.len())
}

// ---- test harness ---------------------------------------------------------

// LeetCode's serialization: breadth first, each node as [isLeaf,val]
// (a split shows val 1, as LeetCode's examples do), a leaf followed by
// four nulls for its missing children, and the trailing nulls dropped.
fn serialize(root: Quad) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut queue: Vec[Option[Quad]] = vec![Some(root)];
    let mut at = 0;
    while at < queue.len() {
        let item = queue[at].clone();
        at += 1;
        match item {
            Some(Quad.Leaf(v)) => {
                let bit = if v { 1 } else { 0 };
                parts.push(f"[1,{bit}]");
                for _ in 0..4 {
                    queue.push(None);
                }
            }
            Some(Quad.Split(a, b, c, d)) => {
                parts.push("[0,1]".to_string());
                queue.push(Some(a));
                queue.push(Some(b));
                queue.push(Some(c));
                queue.push(Some(d));
            }
            None => {
                parts.push("null".to_string());
            }
        }
    }
    while parts.len() > 0 and parts[parts.len() - 1] == "null" {
        parts.pop();
    }
    let mut out = "[".to_string();
    for i in 0..parts.len() {
        if i > 0 {
            out.push(',');
        }
        out.push_str(parts[i]);
    }
    out.push(']');
    out
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random n by n grid with structure for the tree to find: blocks of
// a random power-of-two size, each all 0 or all 1, then a few cells
// flipped.
fn random_grid(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut block = 1;
    let mut j = step(seed) % 7;
    while j > 0 and block < n {
        block *= 2;
        j -= 1;
    }
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        grid.push(vec![0; n]);
    }
    for br in 0..n / block {
        for bc in 0..n / block {
            let v = step(seed) % 2;
            for r in 0..block {
                for c in 0..block {
                    grid[br * block + r][bc * block + c] = v;
                }
            }
        }
    }
    let flips = step(seed) % 4;
    for _ in 0..flips {
        let r = step(seed) % n;
        let c = step(seed) % n;
        grid[r][c] = 1 - grid[r][c];
    }
    grid
}

fn main() {
    println(serialize(construct(vec![vec![0, 1], vec![1, 0]])));
    println(serialize(construct(vec![
        vec![1, 1, 1, 1, 0, 0, 0, 0],
        vec![1, 1, 1, 1, 0, 0, 0, 0],
        vec![1, 1, 1, 1, 1, 1, 1, 1],
        vec![1, 1, 1, 1, 1, 1, 1, 1],
        vec![1, 1, 1, 1, 0, 0, 0, 0],
        vec![1, 1, 1, 1, 0, 0, 0, 0],
        vec![1, 1, 1, 1, 0, 0, 0, 0],
        vec![1, 1, 1, 1, 0, 0, 0, 0],
    ])));
    println(serialize(construct(vec![vec![0]])));
    println(serialize(construct(vec![vec![1]])));
    println(serialize(construct(vec![vec![1, 1], vec![1, 1]])));
    println(serialize(construct(vec![vec![1, 1], vec![1, 0]])));
    println(serialize(construct(vec![
        vec![0, 1, 0, 1],
        vec![1, 0, 1, 0],
        vec![0, 1, 0, 1],
        vec![1, 0, 1, 0],
    ])));
    println(serialize(construct(vec![
        vec![0, 0, 1, 1],
        vec![0, 0, 1, 1],
        vec![1, 1, 0, 0],
        vec![1, 1, 0, 1],
    ])));
    // 64 by 64, all 0 but one cell: a split at every level down to it.
    let mut one: Vec[Vec[i64]] = Vec.new();
    for _ in 0..64 {
        one.push(vec![0; 64]);
    }
    one[37][22] = 1;
    println(serialize(construct(one)));
    // 300 random grids of sizes 1 to 64.
    let mut seed: i64 = 427;
    let mut nodes = 0;
    let mut leaves = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let n = 1 << (step(mut seed) % 7);
        let text = serialize(construct(random_grid(n, mut seed)));
        for b in text.bytes() {
            checksum = (checksum * 31 + b as i64) % 1000000007;
            if b == b'[' {
                nodes += 1;
            }
        }
        leaves += text.split("[1,").len() - 1;
    }
    // The outer bracket of each list is counted as a node above.
    println(f"300 random grids: {nodes - 300} nodes, {leaves} leaves, checksum {checksum}");
}
