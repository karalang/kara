// Differential test for LeetCode #443: String Compression.
//
// Copies of the four arms, each run on 1,500 random strings of 1 to 12
// runs of a three-letter alphabet, runs of up to 1, 3, 15, 120 or 1,200
// letters. Properties known by construction:
//   P1  the compressed text is the one the generator wrote as it built
//       the runs, merging a run that repeats the previous letter
//   P2  expanding the compressed text gives back the string
//   P3  the compressed text is no longer than the string
//   P4  compressing s + t, where t starts with a letter s does not end
//       with, gives s's text followed by t's
//   P5  a run of 1 to 1,001 copies of a digit, a symbol or a space, at
//       or next to a power of ten, compresses to the character and its
//       count

// ---- pointers: compress.kara

fn compress_pointers(chars: mut ref Vec[char]) -> i64 {
    let n = chars.len();
    let mut read = 0;
    let mut write = 0;
    while read < n {
        let c = chars[read];
        let start = read;
        while read < n and chars[read] == c {
            read += 1;
        }
        chars[write] = c;
        write += 1;
        let count = read - start;
        if count > 1 {
            for digit in f"{count}".chars() {
                chars[write] = digit;
                write += 1;
            }
        }
    }
    write
}

// ---- anchor: compress_anchor.kara

fn compress_anchor(chars: mut ref Vec[char]) -> i64 {
    let n = chars.len();
    let mut anchor = 0;
    let mut write = 0;
    for read in 0..n {
        if read + 1 == n or chars[read + 1] != chars[read] {
            chars[write] = chars[anchor];
            write += 1;
            let mut count = read - anchor + 1;
            if count > 1 {
                let first = write;
                while count > 0 {
                    chars[write] = (b'0' + (count % 10) as u8) as char;
                    write += 1;
                    count /= 10;
                }
                chars[first..write].reverse();
            }
            anchor = read + 1;
        }
    }
    write
}

// ---- runs: compress_runs.kara

fn compress_runs(chars: mut ref Vec[char]) -> i64 {
    let mut runs: Vec[(char, i64)] = Vec.new();
    for i in 0..chars.len() {
        if runs.len() > 0 and runs[runs.len() - 1].0 == chars[i] {
            let last = runs.len() - 1;
            runs[last].1 += 1;
        } else {
            runs.push((chars[i], 1));
        }
    }
    let mut write = 0;
    for (c, count) in runs {
        chars[write] = c;
        write += 1;
        if count > 1 {
            for digit in f"{count}".chars() {
                chars[write] = digit;
                write += 1;
            }
        }
    }
    write
}

// ---- text: compress_text.kara

fn compress_text(chars: mut ref Vec[char]) -> i64 {
    let mut text = String.new();
    let mut i = 0;
    while i < chars.len() {
        let mut j = i;
        while j < chars.len() and chars[j] == chars[i] {
            j += 1;
        }
        text.push(chars[i]);
        if j - i > 1 {
            text.push_str(f"{j - i}");
        }
        i = j;
    }
    let mut write = 0;
    for c in text.chars() {
        chars[write] = c;
        write += 1;
    }
    write
}

// ---- harness ----------------------------------------------------------

// An arm's compressed text for s.
fn solve(arm: i64, s: Str) -> String {
    let mut chars: Vec[char] = s.chars().collect();
    let length = if arm == 0 {
        compress_pointers(mut chars)
    } else if arm == 1 {
        compress_anchor(mut chars)
    } else if arm == 2 {
        compress_runs(mut chars)
    } else {
        compress_text(mut chars)
    };
    let mut out = String.new();
    for i in 0..length {
        out.push(chars[i]);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Expands a compressed text of letters: each letter, then its count
// when digits follow it.
fn expand(text: Str) -> String {
    let b = text.bytes();
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as char;
        i += 1;
        let mut count = 0;
        while i < b.len() and b[i] >= b'0' and b[i] <= b'9' {
            count = count * 10 + (b[i] - b'0') as i64;
            i += 1;
        }
        for _ in 0..count.max(1) {
            out.push(c);
        }
    }
    out
}

fn report(p: i64, arm: i64, case: i64, ok: bool, failures: mut ref Vec[i64]) {
    if not ok {
        failures[0] += 1;
        failures[p] += 1;
        if failures[0] <= 10 {
            println(f"FAIL P{p} arm {arm} case {case}");
        }
    }
}

fn main() {
    let mut seed: i64 = 4430;
    let mut checks: i64 = 0;
    let mut failures = vec![0; 6];
    for case in 0..1500 {
        // Runs of letters from a three-letter alphabet, built with the
        // compressed text they should give: a run that repeats the
        // previous letter merges with it.
        let longest = [1, 3, 15, 120, 1200][next_random(mut seed) % 5];
        let runs = 1 + next_random(mut seed) % 12;
        let mut s = String.new();
        let mut want = String.new();
        let mut letters: Vec[char] = Vec.new();
        let mut counts: Vec[i64] = Vec.new();
        for _ in 0..runs {
            let c = (b'a' + (next_random(mut seed) % 3) as u8) as char;
            let k = 1 + next_random(mut seed) % longest;
            for _ in 0..k {
                s.push(c);
            }
            if letters.len() > 0 and letters[letters.len() - 1] == c {
                let last = counts.len() - 1;
                counts[last] += k;
            } else {
                letters.push(c);
                counts.push(k);
            }
        }
        for i in 0..letters.len() {
            want.push(letters[i]);
            if counts[i] > 1 {
                want.push_str(f"{counts[i]}");
            }
        }
        // A second string whose first letter differs from s's last.
        let last = letters[letters.len() - 1];
        let other_letter = (b'a' + ((last as u32 as u8 - b'a') as i64 + 1 + next_random(mut seed) % 2) as u8 % 3) as char;
        let mut t = String.new();
        let tk = 1 + next_random(mut seed) % 30;
        for _ in 0..tk {
            t.push(other_letter);
        }
        t.push('c');
        // A run of a digit or a symbol, at or next to a power of ten.
        let symbol = ['7', '0', '#', ' '][next_random(mut seed) % 4];
        let power = [1, 10, 100, 1000][next_random(mut seed) % 4];
        let k = (power + next_random(mut seed) % 3 - 1).max(1);
        let mut run = String.new();
        for _ in 0..k {
            run.push(symbol);
        }
        let run_want = if k > 1 { f"{symbol}{k}" } else { f"{symbol}" };
        for arm in 0..4 {
            checks += 5;
            let r = solve(arm, s);
            report(1, arm, case, r == want, mut failures);
            report(2, arm, case, expand(r) == s, mut failures);
            report(3, arm, case, r.len() <= s.len() and r.len() == want.len(), mut failures);
            let joined = f"{s}{t}";
            report(4, arm, case, solve(arm, joined) == f"{r}{solve(arm, t)}", mut failures);
            report(5, arm, case, solve(arm, run) == run_want, mut failures);
        }
    }
    println(f"1500 cases, 4 arms, {checks} checks, {failures[0]} failures");
    if failures[0] > 0 {
        println(f"by property: P1 {failures[1]}, P2 {failures[2]}, P3 {failures[3]}, P4 {failures[4]}, P5 {failures[5]}");
    }
}
