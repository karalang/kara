// LeetCode #448: Find All Numbers Disappeared in an Array -- sorting.
//
// Sort the array, then walk 1 to n beside it: a number smaller than
// the next sorted value is missing, and equal values are skipped past.
// O(n log n) time, O(1) extra space besides the sort.

fn find_disappeared_numbers(nums: own Vec[i64]) -> Vec[i64] {
    nums.sort();
    let n = nums.len();
    let mut missing: Vec[i64] = Vec.new();
    let mut at = 0;
    for x in 1..n + 1 {
        while at < n and nums[at] < x {
            at += 1;
        }
        if at == n or nums[at] != x {
            missing.push(x);
        }
    }
    missing
}

// ---- test harness ---------------------------------------------------------

fn list(values: Vec[i64]) -> String {
    let mut out = String.from("[");
    for i in 0..values.len() {
        if i > 0 {
            out.push(',');
        }
        out.push_str(f"{values[i]}");
    }
    out.push(']');
    out
}

fn show(nums: Vec[i64]) {
    println(f"{list(nums)}: {list(find_disappeared_numbers(nums.clone()))}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n numbers from [1, n]: half the time each drawn at random, otherwise
// a shuffle of 1 to n with up to a quarter of its slots overwritten by
// copies of others.
fn random_case(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    if next_random(seed) % 2 == 0 {
        for _ in 0..n {
            nums.push(1 + next_random(seed) % n);
        }
        return nums;
    }
    for x in 1..n + 1 {
        nums.push(x);
    }
    for i in 0..n {
        let j = i + next_random(seed) % (n - i);
        nums.swap(i, j);
    }
    for _ in 0..next_random(seed) % (n / 4 + 1) {
        let to = next_random(seed) % n;
        nums[to] = nums[next_random(seed) % n];
    }
    nums
}

fn main() {
    show(vec![4, 3, 2, 7, 8, 2, 3, 1]);
    show(vec![1, 1]);
    show(vec![1]);
    show(vec![2, 2]);
    show(vec![3, 1, 2]);
    show(vec![5, 5, 5, 5, 5]);
    show(vec![2, 3, 4, 5, 6, 6]);
    show(vec![1, 1, 1, 6, 6, 6]);
    // 300 random arrays of 1 to 200 numbers.
    let mut seed: i64 = 448;
    let mut found = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 200;
        for x in find_disappeared_numbers(random_case(mut seed, n)) {
            found += 1;
            checksum = (checksum * 31 + x) % 1000000007;
        }
        checksum = (checksum * 31) % 1000000007;
    }
    println(f"300 random arrays: {found} missing, checksum {checksum}");
}
