// Benchmark for #448: the ★ arm (find_disappeared.kara) on one random
// array of 1,000,000 numbers with 300,000 missing, built once, copied
// and searched 20 times over.

fn find_disappeared_numbers(nums: own Vec[i64]) -> Vec[i64] {
    for i in 0..nums.len() {
        let x = nums[i].abs();
        if nums[x - 1] > 0 {
            nums[x - 1] = -nums[x - 1];
        }
    }
    let mut missing: Vec[i64] = Vec.new();
    for i in 0..nums.len() {
        if nums[i] > 0 {
            missing.push(i + 1);
        }
    }
    missing
}

// ---- benchmark --------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_index(seed: mut ref i64, below: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % below
}

fn main() {
    let n = 1000000;
    let d = 300000;
    let rounds = 20;
    let mut seed: i64 = 448;
    // The first d of a shuffled 1..n twice, the next n - 2d once.
    let mut values: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        values.push(x);
    }
    for i in 0..n {
        let j = i + random_index(mut seed, n - i);
        values.swap(i, j);
    }
    let mut nums: Vec[i64] = Vec.new();
    for i in 0..n - d {
        nums.push(values[i]);
    }
    for i in 0..d {
        nums.push(values[i]);
    }
    for i in 0..n {
        let j = i + random_index(mut seed, n - i);
        nums.swap(i, j);
    }
    let mut found = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        let missing = find_disappeared_numbers(nums.clone());
        found += missing.len();
        for i in 0..missing.len() {
            checksum = (checksum * 31 + missing[i] + round) % 1000000007;
        }
    }
    println(f"{rounds} rounds on {n} numbers: {found} missing, checksum {checksum}");
}
