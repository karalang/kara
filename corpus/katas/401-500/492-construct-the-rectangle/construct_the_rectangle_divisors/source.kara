// LeetCode #492: Construct the Rectangle -- from the prime factors.
//
// Factor the area into primes, build every divisor from the factors,
// and take the largest one whose square is no larger than the area as
// the width.

fn construct_rectangle(area: i64) -> Vec[i64] {
    let mut primes: Vec[(i64, i64)] = Vec.new();
    let mut rest = area;
    let mut p = 2;
    while p * p <= rest {
        let mut times = 0;
        while rest % p == 0 {
            rest /= p;
            times += 1;
        }
        if times > 0 {
            primes.push((p, times));
        }
        p += 1;
    }
    if rest > 1 {
        primes.push((rest, 1));
    }
    let mut divisors: Vec[i64] = vec![1];
    for (prime, times) in primes {
        let count = divisors.len();
        let mut power = 1;
        for _ in 0..times {
            power *= prime;
            for k in 0..count {
                divisors.push(divisors[k] * power);
            }
        }
    }
    let mut best = 1;
    for d in divisors {
        if d * d <= area and d > best {
            best = d;
        }
    }
    vec![area / best, best]
}

// ---- test harness ---------------------------------------------------------

fn show(name: String, area: i64) {
    println(f"{name}: {area} -> {construct_rectangle(area)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show("example 1", 4);
    show("example 2", 37);
    show("example 3", 122122);
    show("one", 1);
    show("a prime square", 49);
    show("twice a prime", 26);
    show("ten million", 10000000);
    show("the largest prime below ten million", 9999991);
    // 300 random areas from 1 to ten million.
    let count = 300;
    let mut seed: i64 = 492;
    let mut squares = 0;
    let mut thin = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let area = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 10000000;
        let sides = construct_rectangle(area);
        if sides[0] == sides[1] {
            squares += 1;
        }
        if sides[1] == 1 {
            thin += 1;
        }
        checksum = (checksum * 31 + sides[0] - sides[1]) % 1000000007;
    }
    println(f"{count} random areas: {squares} squares, {thin} of width 1, checksum {checksum}");
}
