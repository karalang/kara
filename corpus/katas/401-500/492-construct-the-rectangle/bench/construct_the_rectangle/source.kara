// Benchmark for #492: the ★ arm (down from the square root); see
// ../construct_the_rectangle.kara.

fn construct_rectangle(area: i64) -> Vec[i64] {
    let mut width = (area as f64).sqrt() as i64;
    while width * width > area {
        width -= 1;
    }
    while (width + 1) * (width + 1) <= area {
        width += 1;
    }
    while area % width != 0 {
        width -= 1;
    }
    vec![area / width, width]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 200,000 random areas from 1 to ten million, built once, then each
    // solved once.
    let mut areas: Vec[i64] = Vec.new();
    let mut seed: i64 = 492;
    for _ in 0..200000 {
        areas.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 10000000);
    }
    let mut squares = 0;
    let mut thin = 0;
    let mut checksum: i64 = 0;
    for area in areas {
        let sides = construct_rectangle(area);
        if sides[0] == sides[1] {
            squares += 1;
        }
        if sides[1] == 1 {
            thin += 1;
        }
        checksum = (checksum * 31 + sides[0] - sides[1]) % 1000000007;
    }
    println(f"200000 areas: {squares} squares, {thin} of width 1, checksum {checksum}");
}
