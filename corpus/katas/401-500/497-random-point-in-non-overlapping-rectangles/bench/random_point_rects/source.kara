// Benchmark for #497: the ★ arm (prefix sums); see
// ../random_point_rects.kara.

// A seeded generator: 15 random bits a step, and a uniform draw below n
// built from two steps.
struct Draw {
    seed: i64,
}

impl Draw {
    fn new(seed: i64) -> Draw {
        Draw { seed: seed }
    }

    fn step(mut ref self) -> i64 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        self.seed / 65536
    }

    // Uniform in [0, n) for n up to 2^30: 30 random bits, drawn again
    // when they land in the last, incomplete run of n.
    fn below(mut ref self, n: i64) -> i64 {
        let limit = 1073741824 / n * n;
        loop {
            let high = self.step();
            let low = self.step();
            let r = high * 32768 + low;
            if r < limit {
                return r % n;
            }
        }
    }
}

struct Solution {
    rects: Vec[Vec[i64]],
    ends: Vec[i64],
    draw: Draw,
}

impl Solution {
    fn new(rects: own Vec[Vec[i64]], seed: i64) -> Solution {
        let mut ends: Vec[i64] = Vec.new();
        let mut total = 0;
        for r in rects {
            total += (r[2] - r[0] + 1) * (r[3] - r[1] + 1);
            ends.push(total);
        }
        Solution { rects: rects, ends: ends, draw: Draw.new(seed) }
    }

    fn pick(mut ref self) -> Vec[i64] {
        let k = self.draw.below(self.ends[self.ends.len() - 1]);
        // The first rectangle whose running count passes k.
        let mut low = 0;
        let mut high = self.ends.len() - 1;
        while low < high {
            let mid = (low + high) / 2;
            if self.ends[mid] > k {
                high = mid;
            } else {
                low = mid + 1;
            }
        }
        let r = ref self.rects[low];
        let before = if low == 0 { 0 } else { self.ends[low - 1] };
        let at = k - before;
        let width = r[2] - r[0] + 1;
        vec![r[0] + at % width, r[1] + at / width]
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 500 sets of 100 rectangles (the problem's most) of 1 to 2,001 on
    // a side, spread across the whole range, built once. Then each set
    // gets a fresh solution and 10,000 picks (the problem's most).
    let sets = 500;
    let mut seed: i64 = 497;
    let mut all: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..sets {
        let mut rects: Vec[Vec[i64]] = Vec.new();
        for i in 0..100 {
            let x = -1000000000 + i * 19000000 + next_random(mut seed) % 1000;
            let y = next_random(mut seed) % 30000 * 60000 - 999000000;
            let w = 1 + next_random(mut seed) % 2001;
            let h = 1 + next_random(mut seed) % 2001;
            rects.push(vec![x, y, x + w - 1, y + h - 1]);
        }
        all.push(rects);
    }
    let mut sum: i64 = 0;
    let mut checksum: i64 = 0;
    for k in 0..sets {
        let mut solution = Solution.new(all[k].clone(), k);
        for _ in 0..10000 {
            // Moved up by 10^9 so that every coordinate is at least 0.
            let p = solution.pick();
            let x = p[0] + 1000000000;
            let y = p[1] + 1000000000;
            sum += x % 1000 + y % 1000;
            checksum = (checksum * 31 + x + 2 * y) % 1000000007;
        }
    }
    println(f"{sets} sets of 100, 10000 picks each: sum of last three digits {sum}, checksum {checksum}");
}
