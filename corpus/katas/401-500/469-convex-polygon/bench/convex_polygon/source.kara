// Benchmark for #469: the ★ arm (the sign of every turn) on a large
// workload.

fn is_convex(points: Vec[(i64, i64)]) -> bool {
    let n = points.len();
    let mut sign = 0;
    for i in 0..n {
        let (x0, y0) = points[i];
        let (x1, y1) = points[(i + 1) % n];
        let (x2, y2) = points[(i + 2) % n];
        let cross = (x1 - x0) * (y2 - y1) - (y1 - y0) * (x2 - x1);
        if cross != 0 {
            let s = if cross > 0 { 1 } else { -1 };
            if sign == 0 {
                sign = s;
            } else if s != sign {
                return false;
            }
        }
    }
    true
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n vertices on the parabola y = x * x at increasing x, closed along the
// top: a convex polygon. A dent lifts one vertex just above the chord of
// its two neighbours, so it turns the other way.
fn polygon(n: i64, dent: bool, seed: mut ref i64) -> Vec[(i64, i64)] {
    let mut points: Vec[(i64, i64)] = Vec.new();
    let mut x = -(n * 2);
    for _ in 0..n {
        points.push((x, x * x));
        x += 1 + next_random(mut seed) % 3;
    }
    if dent {
        let i = 1 + next_random(mut seed) % (n - 2);
        let (xa, _) = points[i - 1];
        let (xb, yb) = points[i];
        let (xc, _) = points[i + 1];
        points[i] = (xb, yb + (xb - xa) * (xc - xb) + 1);
    }
    points
}

fn main() {
    let count = 100;
    let n = 50000;
    let rounds = 20;
    let mut seed: i64 = 469;
    let mut polygons: Vec[Vec[(i64, i64)]] = Vec.new();
    for k in 0..count {
        polygons.push(polygon(n, k % 2 == 1, mut seed));
    }
    let mut convex = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        for k in 0..count {
            let answer = is_convex(polygons[k]);
            if answer {
                convex += 1;
            }
            checksum = (checksum * 3 + if answer { 1 } else { 2 } + r) % 1000000007;
        }
    }
    println(f"{rounds} rounds on {count} polygons of {n} vertices: {convex} convex, checksum {checksum}");
}
