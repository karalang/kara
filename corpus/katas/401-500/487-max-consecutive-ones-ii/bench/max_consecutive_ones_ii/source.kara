// Benchmark for #487: the ★ arm (the run before the last 0) on a large
// workload.
//
// LeetCode #487: Max Consecutive Ones II -- the run before the last 0.
//
// With one 0 flipped, the best run ending here is the 1s since the last
// 0, plus that 0, plus the 1s just before it. So keep two counts: `run`,
// the 1s since the last 0, and `before`, the run before that 0 plus the
// 0 itself (0 before any 0 is seen). One pass, two numbers of state, so
// it works on a stream too.

fn find_max_consecutive_ones(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut before = 0;
    let mut run = 0;
    for x in nums {
        if x == 1 {
            run += 1;
        } else {
            before = run + 1;
            run = 0;
        }
        if before + run > best {
            best = before + run;
        }
    }
    best
}

// ---- benchmark ------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 arrays of 100,000 numbers, 1 with odds from 80 in 100 to 99 in
    // 100, built once, then each scanned 50 times.
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut seed: i64 = 487;
    for a in 0..20 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            if next_random(mut seed) % 100 < 80 + a {
                nums.push(1);
            } else {
                nums.push(0);
            }
        }
        arrays.push(nums);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..50 {
        for nums in arrays.iter() {
            let best = find_max_consecutive_ones(nums);
            total += best;
            checksum = (checksum * 31 + best) % 1000000007;
        }
    }
    println(f"1000 scans of 100000 numbers: runs add up to {total}, checksum {checksum}");
}
