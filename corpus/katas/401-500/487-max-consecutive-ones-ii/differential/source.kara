// Differential test for LeetCode #487: Max Consecutive Ones II.
//
// Copies of the four arms, on 1,500 random arrays a of 1 to 25 numbers,
// with a second array b of 0 to 25 (1 with odds of 1 in 2, 3 in 4 or 15
// in 16 in turn). Properties:
//   P1  the answer is the longest slice with at most one 0, every slice
//       checked
//   P2  the array reversed gives the same answer
//   P3  a, then two 0s, then b gives the larger of the answers for a then
//       a 0 and for a 0 then b
//   P4  a 1 turned to 0 never makes the answer larger, and a 0 turned to
//       1 never smaller
//   P5  a 1 more at either end never lowers the answer, and raises it by
//       at most 1

// ---- star: max_consecutive_ones_ii.kara

fn find_max_consecutive_ones_star(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut before = 0;
    let mut run = 0;
    for x in nums {
        if x == 1 {
            run += 1;
        } else {
            before = run + 1;
            run = 0;
        }
        if before + run > best {
            best = before + run;
        }
    }
    best
}

// ---- window: max_consecutive_ones_ii_window.kara

fn find_max_consecutive_ones_window(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut left = 0;
    let mut zeros = 0;
    for right in 0..nums.len() {
        if nums[right] == 0 {
            zeros += 1;
        }
        while zeros > 1 {
            if nums[left] == 0 {
                zeros -= 1;
            }
            left += 1;
        }
        best = best.max(right - left + 1);
    }
    best
}

// ---- states: max_consecutive_ones_ii_states.kara

fn find_max_consecutive_ones_states(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut plain = 0;
    let mut flipped = 0;
    for x in nums {
        if x == 1 {
            plain += 1;
            flipped += 1;
        } else {
            flipped = plain + 1;
            plain = 0;
        }
        best = best.max(flipped.max(plain));
    }
    best
}

// ---- sides: max_consecutive_ones_ii_sides.kara

fn find_max_consecutive_ones_sides(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut ending: Vec[i64] = vec![0; n];
    let mut starting: Vec[i64] = vec![0; n];
    for i in 1..n {
        if nums[i - 1] == 1 {
            ending[i] = ending[i - 1] + 1;
        }
    }
    let mut i = n - 2;
    while i >= 0 {
        if nums[i + 1] == 1 {
            starting[i] = starting[i + 1] + 1;
        }
        i -= 1;
    }
    let mut best = 0;
    let mut any_zero = false;
    for k in 0..n {
        if nums[k] == 0 {
            any_zero = true;
            best = best.max(ending[k] + 1 + starting[k]);
        }
    }
    if any_zero { best } else { n }
}

// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, nums: Vec[i64]) -> i64 {
    match which {
        0 => find_max_consecutive_ones_star(nums),
        1 => find_max_consecutive_ones_window(nums),
        2 => find_max_consecutive_ones_states(nums),
        _ => find_max_consecutive_ones_sides(nums),
    }
}

// The longest slice with at most one 0, by checking every slice.
fn brute(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() + 1 {
            let mut zeros = 0;
            for k in i..j {
                if nums[k] == 0 {
                    zeros += 1;
                }
            }
            if zeros <= 1 and j - i > best {
                best = j - i;
            }
        }
    }
    best
}

fn random_array(seed: mut ref i64, size: i64, odds: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..size {
        if next_random(seed) % 16 < odds {
            nums.push(1);
        } else {
            nums.push(0);
        }
    }
    nums
}

fn main() {
    let names = vec!["star", "window", "states", "sides"];
    let cases = 1500;
    let mut seed: i64 = 4870;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0, 0, 0];
    for c in 0..cases {
        // a of 1 to 25 numbers and b of 0 to 25, 1 with odds of 1 in 2,
        // 3 in 4 or 15 in 16 in turn.
        let odds = if c % 3 == 0 { 8 } else if c % 3 == 1 { 12 } else { 15 };
        let size = 1 + next_random(mut seed) % 25;
        let a = random_array(mut seed, size, odds);
        let size = next_random(mut seed) % 26;
        let b = random_array(mut seed, size, odds);
        let mut reversed = a.clone();
        reversed.reverse();
        let mut joined = a.clone();
        joined.push(0);
        joined.push(0);
        for x in b.iter() {
            joined.push(*x);
        }
        let mut a_zero = a.clone();
        a_zero.push(0);
        let mut zero_b: Vec[i64] = vec![0];
        for x in b.iter() {
            zero_b.push(*x);
        }
        let mut one_a: Vec[i64] = vec![1];
        for x in a.iter() {
            one_a.push(*x);
        }
        let mut a_one = a.clone();
        a_one.push(1);
        let at = next_random(mut seed) % a.len();
        let mut flipped = a.clone();
        flipped[at] = 1 - flipped[at];
        let want = brute(a);
        for which in 0..4 {
            let got = arm(which, a);
            // P1: the longest slice with at most one 0, every slice checked.
            checks += 1;
            if got != want {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: {a} gave {got}, want {want}");
                }
            }
            // P2: the array reversed gives the same answer.
            checks += 1;
            let other = arm(which, reversed);
            if other != got {
                failures += 1;
                by_property[1] += 1;
                if failures <= 5 {
                    println(f"P2 {names[which]}: {reversed} gave {other}, not {got}");
                }
            }
            // P3: a, then two 0s, then b gives the larger of the answers
            // for a then a 0 and for a 0 then b.
            checks += 1;
            let other = arm(which, joined);
            let larger = arm(which, a_zero).max(arm(which, zero_b));
            if other != larger {
                failures += 1;
                by_property[2] += 1;
                if failures <= 5 {
                    println(f"P3 {names[which]}: {joined} gave {other}, want {larger}");
                }
            }
            // P4: a 1 turned to 0 never makes the answer larger, and a 0
            // turned to 1 never smaller.
            checks += 1;
            let other = arm(which, flipped);
            if (a[at] == 1 and other > got) or (a[at] == 0 and other < got) {
                failures += 1;
                by_property[3] += 1;
                if failures <= 5 {
                    println(f"P4 {names[which]}: {flipped} gave {other}, from {got}");
                }
            }
            // P5: a 1 more at either end never lowers the answer, and
            // raises it by at most 1.
            for longer in vec![one_a.clone(), a_one.clone()] {
                checks += 1;
                let other = arm(which, longer);
                if other < got or other > got + 1 {
                    failures += 1;
                    by_property[4] += 1;
                    if failures <= 5 {
                        println(f"P5 {names[which]}: {longer} gave {other}, from {got}");
                    }
                }
            }
        }
    }
    println(f"{cases} cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}, P5 {by_property[4]}");
    }
}
