// LeetCode #487: Max Consecutive Ones II -- the 1s on each side of a 0.
//
// ending[i] counts the 1s just before index i and starting[i] the 1s
// just after it. Flipping the 0 at i gives ending[i] + 1 + starting[i];
// with no 0 at all, the whole array is the run.

fn find_max_consecutive_ones(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut ending: Vec[i64] = vec![0; n];
    let mut starting: Vec[i64] = vec![0; n];
    for i in 1..n {
        if nums[i - 1] == 1 {
            ending[i] = ending[i - 1] + 1;
        }
    }
    let mut i = n - 2;
    while i >= 0 {
        if nums[i + 1] == 1 {
            starting[i] = starting[i + 1] + 1;
        }
        i -= 1;
    }
    let mut best = 0;
    let mut any_zero = false;
    for k in 0..n {
        if nums[k] == 0 {
            any_zero = true;
            best = best.max(ending[k] + 1 + starting[k]);
        }
    }
    if any_zero { best } else { n }
}

// ---- test harness ---------------------------------------------------------

fn list(v: Vec[i64]) -> String {
    let mut line = String.new();
    for x in v {
        if not line.is_empty() {
            line.push_str(", ");
        }
        line.push_str(f"{x}");
    }
    line
}

fn show(nums: Vec[i64]) {
    println(f"[{list(nums)}] -> {find_max_consecutive_ones(nums)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(vec![1, 0, 1, 1, 0]);
    show(vec![1, 0, 1, 1, 0, 1]);
    show(vec![0]);
    show(vec![1]);
    show(vec![0, 0, 0]);
    show(vec![1, 1, 1, 1]);
    show(vec![1, 0, 0, 1, 1, 0, 1, 1, 1, 0]);
    show(vec![0, 1, 1, 1, 0, 1, 1, 1]);
    // 300 random arrays of 1 to 60 numbers, 1 with odds of 1 in 2, 3 in 4
    // or 15 in 16 in turn.
    let count = 300;
    let mut seed: i64 = 487;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for c in 0..count {
        let odds = if c % 3 == 0 { 8 } else if c % 3 == 1 { 12 } else { 15 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1 + next_random(mut seed) % 60 {
            if next_random(mut seed) % 16 < odds {
                nums.push(1);
            } else {
                nums.push(0);
            }
        }
        let best = find_max_consecutive_ones(nums);
        total += best;
        checksum = (checksum * 31 + best + nums.len()) % 1000000007;
    }
    println(f"{count} random arrays: runs add up to {total}, checksum {checksum}");
}
