// LeetCode #409: Longest Palindrome -- a set of unpaired letters.
//
// Read the letters one at a time, keeping a set of those waiting for a
// partner: a letter already in the set leaves it and makes a pair, and
// any other joins it. Every pair goes in the palindrome, and one letter
// still waiting can go in the middle. O(n) time, O(k) space for k
// distinct letters.

fn longest_palindrome(s: Str) -> i64 {
    let mut unpaired: Set[u8] = Set.new();
    let mut pairs = 0;
    for b in s.bytes() {
        if unpaired.contains(b) {
            unpaired.remove(b);
            pairs += 1;
        } else {
            unpaired.insert(b);
        }
    }
    if unpaired.len() > 0 { 2 * pairs + 1 } else { 2 * pairs }
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"\"{s}\": {longest_palindrome(s)}");
}

fn main() {
    show("abccccdd");
    show("a");
    show("Aa");
    show("bb");
    show("ccc");
    show("abc");
    show("AAAAAA");
    show("aaabbbccc");
    show("racecar");
    show("aAbBcCdD");
    show("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz");
    show("civilwartestingwhetherthatnationoranynationsoconceivedandsodedicated");
    // 3,000 random strings of 1 to 60 letters from a, b, c, A, B and C.
    let alphabet = "abcABC".bytes();
    let mut seed: i64 = 409;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + step(mut seed) % 60;
        let mut s = String.new();
        for _ in 0..n {
            s.push(alphabet[step(mut seed) % 6] as char);
        }
        let answer = longest_palindrome(s);
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"3000 random strings: total {total}, checksum {checksum}");
}
