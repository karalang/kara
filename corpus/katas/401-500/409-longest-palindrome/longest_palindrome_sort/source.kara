// LeetCode #409: Longest Palindrome -- sort, then count runs.
//
// Sort the letters so that equal ones stand together, then walk the
// runs: a run of r letters gives r rounded down to even, and a run of
// odd length leaves one letter for the middle. O(n log n) time, O(n)
// space for the sorted copy.

fn longest_palindrome(s: Str) -> i64 {
    let mut letters: Vec[u8] = Vec.new();
    for b in s.bytes() {
        letters.push(b);
    }
    letters.sort();
    let mut length = 0;
    let mut odd = false;
    let mut i = 0;
    while i < letters.len() {
        let mut j = i;
        while j < letters.len() and letters[j] == letters[i] {
            j += 1;
        }
        let run = j - i;
        length += run - run % 2;
        if run % 2 == 1 {
            odd = true;
        }
        i = j;
    }
    if odd { length + 1 } else { length }
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"\"{s}\": {longest_palindrome(s)}");
}

fn main() {
    show("abccccdd");
    show("a");
    show("Aa");
    show("bb");
    show("ccc");
    show("abc");
    show("AAAAAA");
    show("aaabbbccc");
    show("racecar");
    show("aAbBcCdD");
    show("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz");
    show("civilwartestingwhetherthatnationoranynationsoconceivedandsodedicated");
    // 3,000 random strings of 1 to 60 letters from a, b, c, A, B and C.
    let alphabet = "abcABC".bytes();
    let mut seed: i64 = 409;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + step(mut seed) % 60;
        let mut s = String.new();
        for _ in 0..n {
            s.push(alphabet[step(mut seed) % 6] as char);
        }
        let answer = longest_palindrome(s);
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"3000 random strings: total {total}, checksum {checksum}");
}
