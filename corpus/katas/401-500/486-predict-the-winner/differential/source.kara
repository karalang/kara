// Differential test for LeetCode #486: Predict the Winner.
//
// Copies of the four arms, on 1,500 random arrays of 1 to 10 numbers from
// 0 to 20, or from 0 to 10^6 in one array in five. Properties:
//   P1  the answer is whether player 1 collects at least as much as
//       player 2 when the game is played out with both totals kept, each
//       player taking the end that leaves them the most
//   P2  an array of even length is a win for player 1
//   P3  the array reversed gives the same answer
//   P4  every number times k (1 to 5) gives the same answer
//   P5  a number at least the sum of all the others, added at either end,
//       makes a win for player 1

// ---- star: predict_the_winner.kara

fn predict_the_winner_star(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut d = nums.clone();
    let mut i = n - 2;
    while i >= 0 {
        for j in i + 1..n {
            d[j] = (nums[i] - d[j]).max(nums[j] - d[j - 1]);
        }
        i -= 1;
    }
    d[n - 1] >= 0
}

// ---- memo: predict_the_winner_memo.kara

fn lead_memo(nums: Vec[i64], i: i64, j: i64, memo: mut ref Vec[Option[i64]]) -> i64 {
    if i == j {
        return nums[i];
    }
    let key = i * nums.len() + j;
    if let Some(known) = memo[key] {
        return known;
    }
    let best = (nums[i] - lead_memo(nums, i + 1, j, memo)).max(nums[j] - lead_memo(nums, i, j - 1, memo));
    memo[key] = Some(best);
    best
}

fn predict_the_winner_memo(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut memo: Vec[Option[i64]] = Vec.new();
    for _ in 0..n * n {
        memo.push(None);
    }
    lead_memo(nums, 0, n - 1, mut memo) >= 0
}

// ---- score: predict_the_winner_score.kara

fn predict_the_winner_score(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut prefix: Vec[i64] = vec![0];
    for k in 0..n {
        prefix.push(prefix[k] + nums[k]);
    }
    let mut best: Vec[Vec[i64]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[i64] = vec![0; n];
        row[i] = nums[i];
        best.push(row);
    }
    for len in 2..n + 1 {
        for i in 0..n - len + 1 {
            let j = i + len - 1;
            let sum = prefix[j + 1] - prefix[i];
            best[i][j] = sum - best[i + 1][j].min(best[i][j - 1]);
        }
    }
    2 * best[0][n - 1] >= prefix[n]
}

// ---- minimax: predict_the_winner_minimax.kara

fn first_total_minimax(nums: Vec[i64], i: i64, j: i64, first_moves: bool) -> i64 {
    if i > j {
        return 0;
    }
    let after_left = first_total_minimax(nums, i + 1, j, not first_moves);
    let after_right = first_total_minimax(nums, i, j - 1, not first_moves);
    if first_moves {
        (nums[i] + after_left).max(nums[j] + after_right)
    } else {
        after_left.min(after_right)
    }
}

fn predict_the_winner_minimax(nums: Vec[i64]) -> bool {
    let mut total = 0;
    for k in 0..nums.len() {
        total += nums[k];
    }
    2 * first_total_minimax(nums, 0, nums.len() - 1, true) >= total
}

// ---- differential harness ---------------------------------------------------

// The game played out with both totals kept: (the mover's final total,
// the other player's), each player taking the end that leaves them the
// most.
fn play(nums: Vec[i64], i: i64, j: i64) -> (i64, i64) {
    if i > j {
        return (0, 0);
    }
    let (theirs_left, mine_left) = play(nums, i + 1, j);
    let (theirs_right, mine_right) = play(nums, i, j - 1);
    if nums[i] + mine_left >= nums[j] + mine_right {
        (nums[i] + mine_left, theirs_left)
    } else {
        (nums[j] + mine_right, theirs_right)
    }
}

fn arm(which: i64, nums: Vec[i64]) -> bool {
    if which == 0 {
        predict_the_winner_star(nums)
    } else if which == 1 {
        predict_the_winner_memo(nums)
    } else if which == 2 {
        predict_the_winner_score(nums)
    } else {
        predict_the_winner_minimax(nums)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = 1500;
    let arms = 4;
    let mut seed: i64 = 4860;
    let mut checks = 0;
    let mut fails: Vec[i64] = vec![0, 0, 0, 0, 0];
    for c in 0..cases {
        let top = if c % 5 == 0 { 1000001 } else { 21 };
        let size = 1 + next_random(mut seed) % 10;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..size {
            nums.push(next_random(mut seed) * 32768 % top);
        }
        let (first, second) = play(nums, 0, size - 1);
        let want = first >= second;
        let mut reversed: Vec[i64] = Vec.new();
        for k in 0..size {
            reversed.push(nums[size - 1 - k]);
        }
        let factor = 1 + next_random(mut seed) % 5;
        let mut scaled: Vec[i64] = Vec.new();
        let mut rest = 0;
        for k in 0..size {
            scaled.push(nums[k] * factor);
            rest += nums[k];
        }
        let big = rest + next_random(mut seed) % 5;
        let mut left: Vec[i64] = vec![big];
        for k in 0..size {
            left.push(nums[k]);
        }
        let mut right = nums.clone();
        right.push(big);
        for a in 0..arms {
            let got = arm(a, nums);
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            if size % 2 == 0 {
                checks += 1;
                if not got {
                    fails[1] += 1;
                }
            }
            checks += 1;
            if arm(a, reversed) != got {
                fails[2] += 1;
            }
            checks += 1;
            if arm(a, scaled) != got {
                fails[3] += 1;
            }
            checks += 2;
            if not arm(a, left) {
                fails[4] += 1;
            }
            if not arm(a, right) {
                fails[4] += 1;
            }
        }
    }
    let mut failures = 0;
    for p in 0..5 {
        failures += fails[p];
    }
    println(f"{cases} cases, {arms} arms, {checks} checks, {failures} failures");
    for p in 0..5 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]}");
        }
    }
}
