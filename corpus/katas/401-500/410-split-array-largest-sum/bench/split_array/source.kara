// Benchmark for #410: the binary-search arm, verbatim, on 10,000 random
// arrays of 1,000 numbers (the problem's limit) from 0 to 10^6, each
// split into 1 to 50 pieces.

fn pieces_needed(nums: Vec[i64], cap: i64) -> i64 {
    let mut pieces = 1;
    let mut sum = 0;
    for i in 0..nums.len() {
        if sum + nums[i] > cap {
            pieces += 1;
            sum = nums[i];
        } else {
            sum += nums[i];
        }
    }
    pieces
}

fn split_array(nums: Vec[i64], k: i64) -> i64 {
    let mut lo = 0;
    let mut hi = 0;
    for i in 0..nums.len() {
        if nums[i] > lo {
            lo = nums[i];
        }
        hi += nums[i];
    }
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if pieces_needed(nums, mid) <= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arrays = 10000;
    let n = 1000;
    let mut seed: i64 = 410;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..arrays {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let hi = step(mut seed);
            let lo = step(mut seed);
            nums.push((hi * 32768 + lo) % 1000001);
        }
        let k = 1 + step(mut seed) % 50;
        let answer = split_array(nums, k);
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"{arrays} arrays of {n} numbers: total {total}, checksum {checksum}");
}
