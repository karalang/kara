// LeetCode #411: Minimum Unique Word Abbreviation -- depth-first search
// with pruning.
//
// Build the abbreviation left to right: at each position either keep the
// letter, or (unless a run just ended) replace a run of some length by a
// number; each choice adds 1 to the length. A branch whose length already
// reaches the best found is cut. At the end, the mask of kept letters
// must meet every same-length word's mask of differences. O(2^m n) time
// at worst, O(m) stack.

// The abbreviation that keeps the letters whose bits are set in mask and
// replaces each run of the others by its length.
fn abbreviate(t: Slice[u8], mask: i64) -> String {
    let mut out = String.new();
    let mut run = 0;
    for i in 0..t.len() {
        if (mask >> i) & 1 == 1 {
            if run > 0 {
                out.push_str(f"{run}");
                run = 0;
            }
            out.push(t[i] as char);
        } else {
            run += 1;
        }
    }
    if run > 0 {
        out.push_str(f"{run}");
    }
    out
}

struct Search {
    m: i64,
    diffs: Vec[i64],
    best_mask: i64,
    best_length: i64,
}

fn explore(s: mut ref Search, i: i64, mask: i64, length: i64, after_run: bool) {
    if length >= s.best_length {
        return;
    }
    if i == s.m {
        for d in 0..s.diffs.len() {
            if mask & s.diffs[d] == 0 {
                return;
            }
        }
        s.best_length = length;
        s.best_mask = mask;
        return;
    }
    explore(s, i + 1, mask | (1 << i), length + 1, false);
    if not after_run {
        for run in 1..s.m - i + 1 {
            explore(s, i + run, mask, length + 1, true);
        }
    }
}

fn min_abbreviation(target: Str, dictionary: Vec[String]) -> String {
    let t = target.bytes();
    let m = t.len();
    let mut diffs: Vec[i64] = Vec.new();
    for d in 0..dictionary.len() {
        let w = dictionary[d].bytes();
        if w.len() == m {
            let mut diff = 0;
            for i in 0..m {
                if w[i] != t[i] {
                    diff |= 1 << i;
                }
            }
            diffs.push(diff);
        }
    }
    let mut s = Search { m: m, diffs: diffs, best_mask: (1 << m) - 1, best_length: m + 1 };
    explore(mut s, 0, 0, 0, false);
    abbreviate(t, s.best_mask)
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Whether abbr abbreviates word (kata 408's two pointers).
fn abbreviates(abbr: Str, word: Str) -> bool {
    let w = word.bytes();
    let a = abbr.bytes();
    let mut i = 0;
    let mut j = 0;
    while i < w.len() and j < a.len() {
        if a[j] >= 48 and a[j] <= 57 {
            if a[j] == 48 {
                return false;
            }
            let mut skip = 0;
            while j < a.len() and a[j] >= 48 and a[j] <= 57 {
                skip = skip * 10 + (a[j] - 48) as i64;
                j += 1;
            }
            i += skip;
        } else {
            if w[i] != a[j] {
                return false;
            }
            i += 1;
            j += 1;
        }
    }
    i == w.len() and j == a.len()
}

// Letters plus numbers.
fn abbr_length(abbr: Str) -> i64 {
    let a = abbr.bytes();
    let mut length = 0;
    for j in 0..a.len() {
        if a[j] < 48 or a[j] > 57 or j == 0 or a[j - 1] < 48 or a[j - 1] > 57 {
            length += 1;
        }
    }
    length
}

// The answer's length, and whether it abbreviates the target and no
// word of the dictionary. Shortest answers can differ between
// approaches, so only these are printed.
fn verdict(target: Str, dictionary: Vec[String], abbr: Str) -> String {
    let mut ok = abbreviates(abbr, target);
    for d in 0..dictionary.len() {
        if abbreviates(abbr, dictionary[d]) {
            ok = false;
        }
    }
    let label = if ok { "unique" } else { "NOT UNIQUE" };
    f"length {abbr_length(abbr)}, {label}"
}

fn show(target: Str, dictionary: Vec[String]) {
    let mut words = String.new();
    for d in 0..dictionary.len() {
        if d > 0 {
            words.push_str(", ");
        }
        words.push_str(dictionary[d]);
    }
    let abbr = min_abbreviation(target, dictionary);
    println(f"{target} [{words}]: {verdict(target, dictionary, abbr)}");
}

fn main() {
    show("apple", vec!["blade"]);
    show("apple", vec!["plain", "amber", "blade"]);
    show("apple", vec![]);
    show("apple", vec!["pear", "fig", "banana"]);
    show("a", vec!["b"]);
    show("ab", vec!["aa", "bb"]);
    show("abcd", vec!["abce", "abed", "aecd", "ebcd"]);
    show("internationalization", vec!["internationalizatiom"]);
    show("aaaaaaaa", vec!["aaaaaaab", "baaaaaaa", "aaaabaaa"]);
    // 1,000 random targets of 1 to 8 letters from a and b, each with up to
    // 10 dictionary words, most of the target's length, none equal to it.
    let mut seed: i64 = 411;
    let mut total = 0;
    let mut unique = 0;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        let m = 1 + step(mut seed) % 8;
        let mut target = String.new();
        for _ in 0..m {
            target.push((97 + step(mut seed) % 2) as u8 as char);
        }
        let mut dictionary: Vec[String] = Vec.new();
        let count = step(mut seed) % 11;
        for _ in 0..count {
            let len = if step(mut seed) % 4 == 0 { 1 + step(mut seed) % 8 } else { m };
            let mut word = String.new();
            for _ in 0..len {
                word.push((97 + step(mut seed) % 2) as u8 as char);
            }
            if word != target {
                dictionary.push(word);
            }
        }
        let abbr = min_abbreviation(target, dictionary);
        let length = abbr_length(abbr);
        if verdict(target, dictionary, abbr).ends_with(", unique") {
            unique += 1;
        }
        total += length;
        checksum = (checksum * 31 + length) % 1000000007;
    }
    println(f"1000 random targets: {unique} unique, total length {total}, checksum {checksum}");
}
