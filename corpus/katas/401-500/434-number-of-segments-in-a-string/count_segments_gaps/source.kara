// LeetCode #434: Number of Segments in a String -- counting gaps.
//
// Find the first and last non-space characters. Between them, the
// segments are separated by runs of spaces, so there is one more
// segment than there are runs: count the places where a space follows
// a non-space. A string of only spaces has no segments. O(n) time,
// O(1) space.

fn count_segments(s: Str) -> i64 {
    let bytes = s.bytes();
    let mut first = 0;
    while first < bytes.len() and bytes[first] == b' ' {
        first += 1;
    }
    if first == bytes.len() {
        return 0;
    }
    let mut last = bytes.len() - 1;
    while bytes[last] == b' ' {
        last -= 1;
    }
    let mut gaps = 0;
    for i in first + 1..last + 1 {
        if bytes[i] == b' ' and bytes[i - 1] != b' ' {
            gaps += 1;
        }
    }
    gaps + 1
}

// ---- test harness ---------------------------------------------------------

fn show(s: Str) {
    println(f"\"{s}\": {count_segments(s)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show("Hello, my name is John");
    show("Hello");
    show("");
    show(" ");
    show("     ");
    show("  leading and trailing  ");
    show("a  b   c    d");
    show("!@#$%^&*()_+-=',.:");
    show("x");
    show(" x ");
    // 1,000 random strings of up to 60 characters, a third of them
    // spaces.
    let symbols = "abcXYZ019!@#,.:-'";
    let symbol_bytes = symbols.bytes();
    let mut seed: i64 = 434;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        let length = next_random(mut seed) % 61;
        let mut s = String.new();
        for _ in 0..length {
            if next_random(mut seed) % 3 == 0 {
                s.push(' ');
            } else {
                s.push(symbol_bytes[next_random(mut seed) % symbol_bytes.len()] as char);
            }
        }
        let n = count_segments(s);
        total += n;
        checksum = (checksum * 31 + n) % 1000000007;
    }
    println(f"1000 random strings: {total} segments, checksum {checksum}");
}
