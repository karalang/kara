// Benchmark for #434: the ★ arm (count_segments.kara) on 10,000 windows
// of one random text of 1,000,000 characters.

fn count_segments(s: Str) -> i64 {
    let bytes = s.bytes();
    let mut count = 0;
    for i in 0..bytes.len() {
        if bytes[i] != b' ' and (i == 0 or bytes[i - 1] == b' ') {
            count += 1;
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let size = 1000000;
    let windows = 10000;
    let mut seed: i64 = 434;
    // Words of 1 to 8 letters between runs of 1 to 3 spaces.
    let letters = "abcdefghijklmnopqrstuvwxyz".bytes();
    let mut text = String.new();
    while text.len() < size {
        let word = 1 + next_random(mut seed) % 8;
        for _ in 0..word {
            if text.len() < size {
                text.push(letters[next_random(mut seed) % 26] as char);
            }
        }
        let gap = 1 + next_random(mut seed) % 3;
        for _ in 0..gap {
            if text.len() < size {
                text.push(' ');
            }
        }
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..windows {
        let length = next_random(mut seed) % 100001;
        let start = next_random(mut seed) % (size - length + 1);
        let n = count_segments(text[start..start + length]);
        total += n;
        checksum = (checksum * 31 + n) % 1000000007;
    }
    println(f"{windows} windows of a text of {size}: {total} segments, checksum {checksum}");
}
