// LeetCode #460: LFU Cache -- a linked list per use count, O(1).
//
// The nodes live in one `Vec` and link by index. The keys used `c`
// times form a circular list behind a sentinel node of their own,
// oldest first, and `least` is the smallest count whose list is not
// empty. A use unlinks a key and appends it to the next count's list;
// an eviction unlinks the first node of `least`'s list. A node freed by
// an eviction is reused. O(1) a call, counting map lookups as O(1).

struct Node {
    key: i64,
    value: i64,
    count: i64,
    prev: i64,
    next: i64,
}

struct LFUCache {
    capacity: i64,
    nodes: Vec[Node],
    index: Map[i64, i64],
    sentinels: Map[i64, i64],
    least: i64,
    free: i64,
}

impl LFUCache {
    fn new(capacity: i64) -> LFUCache {
        LFUCache { capacity: capacity, nodes: Vec.new(), index: Map.new(), sentinels: Map.new(), least: 0, free: -1 }
    }

    fn unlink(mut ref self, i: i64) {
        let (prev, next) = (self.nodes[i].prev, self.nodes[i].next);
        self.nodes[prev].next = next;
        self.nodes[next].prev = prev;
    }

    // Appends node `i` to the list of `count`, making the list first if
    // there is none.
    fn append(mut ref self, i: i64, count: i64) {
        if not self.sentinels.contains_key(count) {
            let s = self.nodes.len();
            self.nodes.push(Node { key: -1, value: 0, count: count, prev: s, next: s });
            self.sentinels.insert(count, s);
        }
        let s = self.sentinels[count];
        let last = self.nodes[s].prev;
        self.nodes[i].count = count;
        self.nodes[i].prev = last;
        self.nodes[i].next = s;
        self.nodes[last].next = i;
        self.nodes[s].prev = i;
    }

    fn is_empty(ref self, count: i64) -> bool {
        let s = self.sentinels[count];
        self.nodes[s].next == s
    }

    fn touch(mut ref self, i: i64) {
        let count = self.nodes[i].count;
        self.unlink(i);
        if self.least == count and self.is_empty(count) {
            self.least = count + 1;
        }
        self.append(i, count + 1);
    }

    fn get(mut ref self, key: i64) -> i64 {
        if not self.index.contains_key(key) {
            return -1;
        }
        let i = self.index[key];
        self.touch(i);
        self.nodes[i].value
    }

    fn put(mut ref self, key: i64, value: i64) {
        if self.capacity == 0 {
            return;
        }
        if self.index.contains_key(key) {
            let i = self.index[key];
            self.nodes[i].value = value;
            self.touch(i);
            return;
        }
        if self.index.len() == self.capacity {
            let s = self.sentinels[self.least];
            let victim = self.nodes[s].next;
            self.unlink(victim);
            self.index.remove(self.nodes[victim].key);
            self.free = victim;
        }
        let i = if self.free >= 0 {
            let i = self.free;
            self.free = -1;
            self.nodes[i].key = key;
            self.nodes[i].value = value;
            i
        } else {
            self.nodes.push(Node { key: key, value: value, count: 0, prev: -1, next: -1 });
            self.nodes.len() - 1
        };
        self.index.insert(key, i);
        self.append(i, 1);
        self.least = 1;
    }
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let capacity = 4096;
    let calls = 10000000;
    let mut seed: i64 = 460;
    let mut cache = LFUCache.new(capacity);
    let mut hits = 0;
    let mut checksum: i64 = 0;
    for _ in 0..calls {
        // A product of two numbers below 200: small keys come up often.
        let key = (next_random(mut seed) % 200) * (next_random(mut seed) % 200);
        if next_random(mut seed) % 2 == 0 {
            cache.put(key, next_random(mut seed) % 1000000);
        } else {
            let answer = cache.get(key);
            if answer >= 0 {
                hits += 1;
            }
            checksum = (checksum * 31 + answer + 2) % 1000000007;
        }
    }
    println(f"{calls} calls on a cache of {capacity}: {hits} hits, checksum {checksum}");
}
