// LeetCode #420: Strong Password Checker -- a knapsack of deletions.
//
// Over 20 characters, the n - 20 deletions may be shared among the
// runs in any way, the rest falling elsewhere, and a run of length L
// that loses k still needs (L - k) / 3 replacements. best[d] is the
// fewest replacements over the runs so far with d deletions spent in
// them; each run tries every k it can take. No greedy order is assumed.
// O(n + d sum(L)) time for d deletions, O(d) space.

fn strong_password_checker(password: Str) -> i64 {
    let bytes = password.bytes();
    let n = password.len();
    let mut lower = 0;
    let mut upper = 0;
    let mut digit = 0;
    for b in bytes {
        if b >= b'a' and b <= b'z' {
            lower = 1;
        } else if b >= b'A' and b <= b'Z' {
            upper = 1;
        } else if b >= b'0' and b <= b'9' {
            digit = 1;
        }
    }
    let missing = 3 - lower - upper - digit;
    // The lengths of the runs of 3 or more.
    let mut runs: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and bytes[j] == bytes[i] {
            j += 1;
        }
        if j - i >= 3 {
            runs.push(j - i);
        }
        i = j;
    }
    if n < 6 {
        return max(missing, 6 - n);
    }
    let delete = max(n - 20, 0);
    let mut best = vec![0; delete + 1];
    for run in runs {
        let mut next = vec![-1; delete + 1];
        for d in 0..delete + 1 {
            for k in 0..min(run, d) + 1 {
                let cost = best[d - k] + (run - k) / 3;
                if next[d] < 0 or cost < next[d] {
                    next[d] = cost;
                }
            }
        }
        best = next;
    }
    let mut replace = best[0];
    for d in 0..delete + 1 {
        replace = min(replace, best[d]);
    }
    delete + max(missing, replace)
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(password: Str) {
    println(f"\"{password}\": {strong_password_checker(password)}");
}

fn main() {
    show("a");
    show("aA1");
    show("1337C0d3");
    show("aaa");
    show("aaaaaa");
    show("aaa111");
    show("ABABABABABABABABABAB1");
    show("aaaaaaaaaaaaaaaaaaaaa");
    show("bbaaaaaaaaaaaaaaacccccc");
    show("1111111111");
    show("aaaabbbbccccddeeddeeddeedd");
    show("..................!!!");
    // 2,000 random passwords of 1 to 40 characters from a few letters,
    // digits and a dot, written in runs so that long repeats are common.
    let pool = "aAbB1.";
    let mut seed: i64 = 420;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + step(mut seed) % 40;
        let mut password = String.new();
        while password.len() < n {
            let pick = pool.bytes()[step(mut seed) % 6];
            let run = 1 + step(mut seed) % 6;
            for _ in 0..run {
                if password.len() < n {
                    password.push(pick as char);
                }
            }
        }
        let answer = strong_password_checker(password);
        total += answer;
        checksum = (checksum * 31 + answer + n) % 1000000007;
    }
    println(f"2000 random passwords: total {total}, checksum {checksum}");
}
