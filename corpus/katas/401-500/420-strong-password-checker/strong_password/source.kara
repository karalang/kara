// LeetCode #420: Strong Password Checker -- count the runs by length mod 3.
//
// A strong password has 6 to 20 characters, a lowercase letter, an
// uppercase letter and a digit, and no character three times in a row.
// One replacement breaks a run of 3 characters for every 3 in it, and
// can supply a missing kind at the same time. Under 6 characters,
// insertions cover both a missing kind and a run. Over 20, the n - 20
// deletions come first and should shorten runs where it saves a
// replacement soonest: one deletion in a run of length 0 mod 3, then
// two in a run of length 1 mod 3, then three at a time.
// O(n) time, O(1) space.

fn strong_password_checker(password: Str) -> i64 {
    let bytes = password.bytes();
    let n = password.len();
    let mut lower = 0;
    let mut upper = 0;
    let mut digit = 0;
    for b in bytes {
        if b >= b'a' and b <= b'z' {
            lower = 1;
        } else if b >= b'A' and b <= b'Z' {
            upper = 1;
        } else if b >= b'0' and b <= b'9' {
            digit = 1;
        }
    }
    let missing = 3 - lower - upper - digit;
    let mut replace = 0;
    let mut zero_mod = 0;
    let mut one_mod = 0;
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and bytes[j] == bytes[i] {
            j += 1;
        }
        let run = j - i;
        if run >= 3 {
            replace += run / 3;
            if run % 3 == 0 {
                zero_mod += 1;
            } else if run % 3 == 1 {
                one_mod += 1;
            }
        }
        i = j;
    }
    if n < 6 {
        return max(missing, 6 - n);
    }
    if n <= 20 {
        return max(missing, replace);
    }
    let delete = n - 20;
    let mut left = delete;
    let first = min(left, zero_mod);
    replace -= first;
    left -= first;
    let second = min(left, 2 * one_mod);
    replace -= second / 2;
    left -= second;
    replace -= min(left / 3, replace);
    delete + max(missing, replace)
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(password: Str) {
    println(f"\"{password}\": {strong_password_checker(password)}");
}

fn main() {
    show("a");
    show("aA1");
    show("1337C0d3");
    show("aaa");
    show("aaaaaa");
    show("aaa111");
    show("ABABABABABABABABABAB1");
    show("aaaaaaaaaaaaaaaaaaaaa");
    show("bbaaaaaaaaaaaaaaacccccc");
    show("1111111111");
    show("aaaabbbbccccddeeddeeddeedd");
    show("..................!!!");
    // 2,000 random passwords of 1 to 40 characters from a few letters,
    // digits and a dot, written in runs so that long repeats are common.
    let pool = "aAbB1.";
    let mut seed: i64 = 420;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + step(mut seed) % 40;
        let mut password = String.new();
        while password.len() < n {
            let pick = pool.bytes()[step(mut seed) % 6];
            let run = 1 + step(mut seed) % 6;
            for _ in 0..run {
                if password.len() < n {
                    password.push(pick as char);
                }
            }
        }
        let answer = strong_password_checker(password);
        total += answer;
        checksum = (checksum * 31 + answer + n) % 1000000007;
    }
    println(f"2000 random passwords: total {total}, checksum {checksum}");
}
