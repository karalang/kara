// LeetCode #420: Strong Password Checker -- deletions from a heap.
//
// As the ★ arm, but the n - 20 deletions are made one at a time: a
// smallest-first PriorityQueue holds each run of 3 or more as
// (length mod 3, length), so every deletion shortens a run whose
// replacements it reduces soonest. A run that falls below 3 leaves the
// queue. The replacements are then counted from what is left.
// O(n + d log r) time for d deletions over r runs, O(r) space.

fn strong_password_checker(password: Str) -> i64 {
    let bytes = password.bytes();
    let n = password.len();
    let mut lower = 0;
    let mut upper = 0;
    let mut digit = 0;
    for b in bytes {
        if b >= b'a' and b <= b'z' {
            lower = 1;
        } else if b >= b'A' and b <= b'Z' {
            upper = 1;
        } else if b >= b'0' and b <= b'9' {
            digit = 1;
        }
    }
    let missing = 3 - lower - upper - digit;
    // The lengths of the runs of 3 or more.
    let mut runs: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and bytes[j] == bytes[i] {
            j += 1;
        }
        if j - i >= 3 {
            runs.push(j - i);
        }
        i = j;
    }
    if n < 6 {
        return max(missing, 6 - n);
    }
    let mut replace = 0;
    if n <= 20 {
        for run in runs {
            replace += run / 3;
        }
        return max(missing, replace);
    }
    let delete = n - 20;
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    for run in runs {
        queue.push((run % 3, run));
    }
    for _ in 0..delete {
        match queue.pop() {
            Some((_, run)) => {
                if run - 1 >= 3 {
                    queue.push(((run - 1) % 3, run - 1));
                }
            }
            None => break,
        }
    }
    while let Some((_, run)) = queue.pop() {
        replace += run / 3;
    }
    delete + max(missing, replace)
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(password: Str) {
    println(f"\"{password}\": {strong_password_checker(password)}");
}

fn main() {
    show("a");
    show("aA1");
    show("1337C0d3");
    show("aaa");
    show("aaaaaa");
    show("aaa111");
    show("ABABABABABABABABABAB1");
    show("aaaaaaaaaaaaaaaaaaaaa");
    show("bbaaaaaaaaaaaaaaacccccc");
    show("1111111111");
    show("aaaabbbbccccddeeddeeddeedd");
    show("..................!!!");
    // 2,000 random passwords of 1 to 40 characters from a few letters,
    // digits and a dot, written in runs so that long repeats are common.
    let pool = "aAbB1.";
    let mut seed: i64 = 420;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + step(mut seed) % 40;
        let mut password = String.new();
        while password.len() < n {
            let pick = pool.bytes()[step(mut seed) % 6];
            let run = 1 + step(mut seed) % 6;
            for _ in 0..run {
                if password.len() < n {
                    password.push(pick as char);
                }
            }
        }
        let answer = strong_password_checker(password);
        total += answer;
        checksum = (checksum * 31 + answer + n) % 1000000007;
    }
    println(f"2000 random passwords: total {total}, checksum {checksum}");
}
