// Differential test for LeetCode #420: Strong Password Checker.
//
// Copies of the four arms, each run on 1,500 random passwords of 1 to
// 28 characters from "aAbB1." written in runs. Properties known by
// construction:
//   P1  on every third case, the answer is the fewest edits found by a
//       dynamic program that tries deleting, keeping and replacing
//       each character and inserting before it
//   P2  the answer is at least each of: the kinds missing, the
//       characters short of 6, the characters over 20
//   P3  the answer is at most those three plus one replacement for
//       every 3 characters of every run, each fault fixed on its own
//   P4  swapping the case of every letter, or reversing the password,
//       gives the same answer
//   P5  one letter written k times needs max(2, 6 - k) under 6,
//       max(2, k / 3) up to 20, and k - 14 over 20

// ---- mod: strong_password.kara

fn strong_password_checker_mod(password: Str) -> i64 {
    let bytes = password.bytes();
    let n = password.len();
    let mut lower = 0;
    let mut upper = 0;
    let mut digit = 0;
    for b in bytes {
        if b >= b'a' and b <= b'z' {
            lower = 1;
        } else if b >= b'A' and b <= b'Z' {
            upper = 1;
        } else if b >= b'0' and b <= b'9' {
            digit = 1;
        }
    }
    let missing = 3 - lower - upper - digit;
    let mut replace = 0;
    let mut zero_mod = 0;
    let mut one_mod = 0;
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and bytes[j] == bytes[i] {
            j += 1;
        }
        let run = j - i;
        if run >= 3 {
            replace += run / 3;
            if run % 3 == 0 {
                zero_mod += 1;
            } else if run % 3 == 1 {
                one_mod += 1;
            }
        }
        i = j;
    }
    if n < 6 {
        return max(missing, 6 - n);
    }
    if n <= 20 {
        return max(missing, replace);
    }
    let delete = n - 20;
    let mut left = delete;
    let first = min(left, zero_mod);
    replace -= first;
    left -= first;
    let second = min(left, 2 * one_mod);
    replace -= second / 2;
    left -= second;
    replace -= min(left / 3, replace);
    delete + max(missing, replace)
}

// ---- heap: strong_password_heap.kara

fn strong_password_checker_heap(password: Str) -> i64 {
    let bytes = password.bytes();
    let n = password.len();
    let mut lower = 0;
    let mut upper = 0;
    let mut digit = 0;
    for b in bytes {
        if b >= b'a' and b <= b'z' {
            lower = 1;
        } else if b >= b'A' and b <= b'Z' {
            upper = 1;
        } else if b >= b'0' and b <= b'9' {
            digit = 1;
        }
    }
    let missing = 3 - lower - upper - digit;
    // The lengths of the runs of 3 or more.
    let mut runs: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and bytes[j] == bytes[i] {
            j += 1;
        }
        if j - i >= 3 {
            runs.push(j - i);
        }
        i = j;
    }
    if n < 6 {
        return max(missing, 6 - n);
    }
    let mut replace = 0;
    if n <= 20 {
        for run in runs {
            replace += run / 3;
        }
        return max(missing, replace);
    }
    let delete = n - 20;
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    for run in runs {
        queue.push((run % 3, run));
    }
    for _ in 0..delete {
        match queue.pop() {
            Some((_, run)) => {
                if run - 1 >= 3 {
                    queue.push(((run - 1) % 3, run - 1));
                }
            }
            None => break,
        }
    }
    while let Some((_, run)) = queue.pop() {
        replace += run / 3;
    }
    delete + max(missing, replace)
}

// ---- scan: strong_password_scan.kara

fn strong_password_checker_scan(password: Str) -> i64 {
    let bytes = password.bytes();
    let n = password.len();
    let mut lower = 0;
    let mut upper = 0;
    let mut digit = 0;
    for b in bytes {
        if b >= b'a' and b <= b'z' {
            lower = 1;
        } else if b >= b'A' and b <= b'Z' {
            upper = 1;
        } else if b >= b'0' and b <= b'9' {
            digit = 1;
        }
    }
    let missing = 3 - lower - upper - digit;
    // The lengths of the runs of 3 or more.
    let mut runs: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and bytes[j] == bytes[i] {
            j += 1;
        }
        if j - i >= 3 {
            runs.push(j - i);
        }
        i = j;
    }
    if n < 6 {
        return max(missing, 6 - n);
    }
    let mut runs = runs;
    if n > 20 {
        for _ in 0..n - 20 {
            let mut best = -1;
            for k in 0..runs.len() {
                if runs[k] >= 3 and (best < 0 or runs[k] % 3 < runs[best] % 3) {
                    best = k;
                }
            }
            if best < 0 {
                break;
            }
            runs[best] -= 1;
        }
    }
    let mut replace = 0;
    for run in runs {
        replace += run / 3;
    }
    max(n - 20, 0) + max(missing, replace)
}

// ---- knapsack: strong_password_knapsack.kara

fn strong_password_checker_knapsack(password: Str) -> i64 {
    let bytes = password.bytes();
    let n = password.len();
    let mut lower = 0;
    let mut upper = 0;
    let mut digit = 0;
    for b in bytes {
        if b >= b'a' and b <= b'z' {
            lower = 1;
        } else if b >= b'A' and b <= b'Z' {
            upper = 1;
        } else if b >= b'0' and b <= b'9' {
            digit = 1;
        }
    }
    let missing = 3 - lower - upper - digit;
    // The lengths of the runs of 3 or more.
    let mut runs: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and bytes[j] == bytes[i] {
            j += 1;
        }
        if j - i >= 3 {
            runs.push(j - i);
        }
        i = j;
    }
    if n < 6 {
        return max(missing, 6 - n);
    }
    let delete = max(n - 20, 0);
    let mut best = vec![0; delete + 1];
    for run in runs {
        let mut next = vec![-1; delete + 1];
        for d in 0..delete + 1 {
            for k in 0..min(run, d) + 1 {
                let cost = best[d - k] + (run - k) / 3;
                if next[d] < 0 or cost < next[d] {
                    next[d] = cost;
                }
            }
        }
        best = next;
    }
    let mut replace = best[0];
    for d in 0..delete + 1 {
        replace = min(replace, best[d]);
    }
    delete + max(missing, replace)
}

// ---- harness ----------------------------------------------------------

fn solve(arm: i64, password: Str) -> i64 {
    if arm == 0 {
        strong_password_checker_mod(password)
    } else if arm == 1 {
        strong_password_checker_heap(password)
    } else if arm == 2 {
        strong_password_checker_scan(password)
    } else {
        strong_password_checker_knapsack(password)
    }
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The kind of a pool character: 1 lowercase, 2 uppercase, 4 digit,
// 0 anything else.
fn kind(c: i64) -> i64 {
    if c == 0 or c == 2 { 1 } else if c == 1 or c == 3 { 2 } else if c == 4 { 4 } else { 0 }
}

// The fewest edits, found by trying them all: a dynamic program over
// the password's characters whose state is the length written so far
// (at most 20), the last character written (one of the six pool
// characters, or 6 for one the edit chose, which differs from every
// neighbour), how many times it repeats (1 or 2), and the kinds seen.
// At each character: delete it, keep it, or replace it with a chosen
// character of some kind; before it, or at the end, insert one.
fn brute(codes: Vec[i64]) -> i64 {
    let n = codes.len();
    let big = 1000000;
    // cost[((len * 7 + last) * 3 + repeat) * 8 + kinds]
    let size = 21 * 7 * 3 * 8;
    let mut cost = vec![big; size];
    cost[((0 * 7 + 6) * 3 + 0) * 8 + 0] = 0;
    for i in 0..n + 1 {
        // Insertions within this layer, in order of length.
        for len in 0..20 {
            for last in 0..7 {
                for repeat in 0..3 {
                    for kinds in 0..8 {
                        let here = cost[((len * 7 + last) * 3 + repeat) * 8 + kinds];
                        if here < big {
                            for k in [1, 2, 4] {
                                let to = (((len + 1) * 7 + 6) * 3 + 1) * 8 + (kinds | k);
                                if here + 1 < cost[to] {
                                    cost[to] = here + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        if i == n {
            break;
        }
        let c = codes[i];
        let mut next = vec![big; size];
        for len in 0..21 {
            for last in 0..7 {
                for repeat in 0..3 {
                    for kinds in 0..8 {
                        let here = cost[((len * 7 + last) * 3 + repeat) * 8 + kinds];
                        if here >= big {
                            continue;
                        }
                        // Delete.
                        let same = ((len * 7 + last) * 3 + repeat) * 8 + kinds;
                        if here + 1 < next[same] {
                            next[same] = here + 1;
                        }
                        if len < 20 {
                            // Keep, unless it would make three in a row.
                            let run = if c == last { repeat + 1 } else { 1 };
                            if run <= 2 {
                                let to = (((len + 1) * 7 + c) * 3 + run) * 8 + (kinds | kind(c));
                                if here < next[to] {
                                    next[to] = here;
                                }
                            }
                            // Replace with a chosen character.
                            for k in [1, 2, 4] {
                                let to = (((len + 1) * 7 + 6) * 3 + 1) * 8 + (kinds | k);
                                if here + 1 < next[to] {
                                    next[to] = here + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        cost = next;
    }
    let mut best = big;
    for len in 6..21 {
        for last in 0..7 {
            for repeat in 0..3 {
                best = min(best, cost[((len * 7 + last) * 3 + repeat) * 8 + 7]);
            }
        }
    }
    best
}

// failures[0] counts every failure, failures[p] those of property Pp.
fn report(p: i64, arm: i64, case: i64, ok: bool, failures: mut ref Vec[i64]) {
    if not ok {
        failures[0] += 1;
        failures[p] += 1;
        if failures[0] <= 10 {
            println(f"FAIL P{p} arm {arm} case {case}");
        }
    }
}

fn main() {
    let pool = "aAbB1.";
    let swapped = "AaBb1.";
    let mut seed: i64 = 4200;
    let mut checks: i64 = 0;
    let mut failures = vec![0; 6];
    for case in 0..1500 {
        let n = 1 + step(mut seed) % 28;
        let mut codes: Vec[i64] = Vec.new();
        while codes.len() < n {
            let pick = step(mut seed) % 6;
            let run = 1 + step(mut seed) % 6;
            for _ in 0..run {
                if codes.len() < n {
                    codes.push(pick);
                }
            }
        }
        let mut password = String.new();
        let mut flipped = String.new();
        let mut reversed = String.new();
        for k in 0..n {
            password.push(pool.bytes()[codes[k]] as char);
            flipped.push(swapped.bytes()[codes[k]] as char);
            reversed.push(pool.bytes()[codes[n - 1 - k]] as char);
        }
        // P2's lower bound, and P3's upper bound: each fault fixed alone.
        let mut kinds = 0;
        for c in codes {
            kinds = kinds | kind(c);
        }
        let missing = 3 - (kinds & 1) - (kinds >> 1 & 1) - (kinds >> 2 & 1);
        let mut runs = 0;
        let mut i = 0;
        while i < n {
            let mut j = i;
            while j < n and codes[j] == codes[i] {
                j += 1;
            }
            runs += (j - i) / 3;
            i = j;
        }
        let short = max(6 - n, 0);
        let long = max(n - 20, 0);
        // P1 on every third case, since the search is slow.
        let best = if case % 3 == 0 { brute(codes) } else { -1 };
        // P5: one letter written k times.
        let k = 1 + step(mut seed) % 40;
        let mut repeated = String.new();
        for _ in 0..k {
            repeated.push('z');
        }
        let expect = if k < 6 { max(2, 6 - k) } else if k <= 20 { max(2, k / 3) } else { k - 14 };
        for arm in 0..4 {
            checks += 5;
            let answer = solve(arm, password);
            report(1, arm, case, best < 0 or answer == best, mut failures);
            report(2, arm, case, answer >= max(missing, max(short, long)), mut failures);
            report(3, arm, case, answer <= short + long + missing + runs, mut failures);
            report(4, arm, case, solve(arm, flipped) == answer and solve(arm, reversed) == answer, mut failures);
            report(5, arm, case, solve(arm, repeated) == expect, mut failures);
        }
    }
    println(f"1500 cases, 4 arms, {checks} checks, {failures[0]} failures");
    if failures[0] > 0 {
        println(f"by property: P1 {failures[1]}, P2 {failures[2]}, P3 {failures[3]}, P4 {failures[4]}, P5 {failures[5]}");
    }
}
