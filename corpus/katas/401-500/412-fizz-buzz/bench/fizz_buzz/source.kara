// Benchmark for #412: the ★ arm, verbatim, called 2,000 times with n
// from 9,000 to 10,000 (the problem's limit). Every entry is a fresh
// String, as LeetCode's List<String> asks.

fn fizz_buzz(n: i64) -> Vec[String] {
    let mut answer: Vec[String] = Vec.new();
    for i in 1..n + 1 {
        if i % 15 == 0 {
            answer.push("FizzBuzz");
        } else if i % 3 == 0 {
            answer.push("Fizz");
        } else if i % 5 == 0 {
            answer.push("Buzz");
        } else {
            answer.push(f"{i}");
        }
    }
    answer
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let calls = 2000;
    let mut seed: i64 = 412;
    let mut bytes: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..calls {
        let n = 9000 + step(mut seed) % 1001;
        let answer = fizz_buzz(n);
        let mut length = 0;
        for i in 0..answer.len() {
            length += answer[i].len();
        }
        bytes += length;
        checksum = (checksum * 31 + length) % 1000000007;
    }
    println(f"{calls} calls: {bytes} bytes, checksum {checksum}");
}
