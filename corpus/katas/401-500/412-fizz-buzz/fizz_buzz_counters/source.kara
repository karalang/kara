// LeetCode #412: Fizz Buzz -- counters instead of division.
//
// Keep two counters that count up to 3 and to 5 and start again: each
// reaching its end marks a multiple, with no `%` at all. O(n) time, O(n)
// space.

fn fizz_buzz(n: i64) -> Vec[String] {
    let mut answer: Vec[String] = Vec.new();
    let mut three = 0;
    let mut five = 0;
    for i in 1..n + 1 {
        three += 1;
        five += 1;
        let fizz = three == 3;
        let buzz = five == 5;
        if fizz {
            three = 0;
        }
        if buzz {
            five = 0;
        }
        if fizz and buzz {
            answer.push("FizzBuzz");
        } else if fizz {
            answer.push("Fizz");
        } else if buzz {
            answer.push("Buzz");
        } else {
            answer.push(f"{i}");
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    let answer = fizz_buzz(n);
    let mut line = String.new();
    for i in 0..answer.len() {
        if i > 0 {
            line.push(' ');
        }
        line.push_str(answer[i]);
    }
    println(f"{n}: {line}");
}

fn main() {
    show(1);
    show(3);
    show(5);
    show(15);
    show(16);
    show(31);
    // 100 random n from 1 to 10,000 (the limit): the words, the numbers
    // and a checksum over every byte.
    let mut seed: i64 = 412;
    let mut words = 0;
    let mut numbers = 0;
    let mut checksum: i64 = 0;
    for _ in 0..100 {
        let n = 1 + (step(mut seed) * 32768 + step(mut seed)) % 10000;
        let answer = fizz_buzz(n);
        for i in 0..answer.len() {
            let b = answer[i].bytes();
            if b[0] >= 65 {
                words += 1;
            } else {
                numbers += 1;
            }
            for j in 0..b.len() {
                checksum = (checksum * 31 + b[j] as i64) % 1000000007;
            }
        }
    }
    println(f"100 random n: {words} words, {numbers} numbers, checksum {checksum}");
}
