// LeetCode #454: 4Sum II -- both lists of pair sums sorted, met by two
// pointers.
//
// Sort the sums of the first two arrays upward and the sums of the last
// two, and walk one list from the bottom and the other from the top.
// When a sum and the other's negation meet, every copy of one pairs
// with every copy of the other, so count both runs and multiply.
// O(n^2 log n) time, O(n^2) space.

fn pair_sums(xs: Vec[i64], ys: Vec[i64]) -> Vec[i64] {
    let mut sums: Vec[i64] = Vec.new();
    for x in xs {
        for y in ys {
            sums.push(x + y);
        }
    }
    sums.sort();
    sums
}

fn four_sum_count(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) -> i64 {
    let left = pair_sums(nums1, nums2);
    let right = pair_sums(nums3, nums4);
    let mut i = 0;
    let mut j = right.len() - 1;
    let mut count = 0;
    while i < left.len() and j >= 0 {
        let total = left[i] + right[j];
        if total < 0 {
            i += 1;
        } else if total > 0 {
            j -= 1;
        } else {
            let value = left[i];
            let mut run_left = 0;
            while i < left.len() and left[i] == value {
                run_left += 1;
                i += 1;
            }
            let other = right[j];
            let mut run_right = 0;
            while j >= 0 and right[j] == other {
                run_right += 1;
                j -= 1;
            }
            count += run_left * run_right;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn listed(nums: Vec[i64]) -> String {
    let mut out = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            out.push(',');
        }
        out.push_str(f"{nums[i]}");
    }
    out
}

fn show(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) {
    let count = four_sum_count(nums1, nums2, nums3, nums4);
    println(f"[{listed(nums1)}] [{listed(nums2)}] [{listed(nums3)}] [{listed(nums4)}]: {count} tuples");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(n: i64, spread: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        let r = next_random(seed) * 65536 + next_random(seed);
        nums.push(r % spread - spread / 2);
    }
    nums
}

fn main() {
    show(vec![1, 2], vec![-2, -1], vec![-1, 2], vec![0, 2]);
    show(vec![0], vec![0], vec![0], vec![0]);
    show(vec![1], vec![1], vec![1], vec![1]);
    show(vec![0, 0, 0], vec![0, 0, 0], vec![0, 0, 0], vec![0, 0, 0]);
    show(vec![268435456, -268435456], vec![268435456, -268435456], vec![-268435456], vec![-268435456, 268435456]);
    show(vec![1, -1, 2], vec![-2, 1, 0], vec![3, -3, 0], vec![0, 1, -1]);
    // 300 random cases of 1 to 40 numbers in each array, spread over 3,
    // 11, 101 or every value from -2^28 to 2^28.
    let count = 300;
    let mut seed: i64 = 454;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = 1 + next_random(mut seed) % 40;
        let spread = [3, 11, 101, 536870913][next_random(mut seed) % 4];
        let nums1 = random_nums(n, spread, mut seed);
        let nums2 = random_nums(n, spread, mut seed);
        let nums3 = random_nums(n, spread, mut seed);
        let nums4 = random_nums(n, spread, mut seed);
        let tuples = four_sum_count(nums1, nums2, nums3, nums4);
        total += tuples;
        checksum = (checksum * 31 + tuples) % 1000000007;
    }
    println(f"{count} random cases: {total} tuples, checksum {checksum}");
}
