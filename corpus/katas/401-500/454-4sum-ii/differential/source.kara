// Differential test for LeetCode #454: 4Sum II.
//
// Copies of the four arms, each run on 1,500 random cases.
// Properties:
//   P1  on 1 to 5 numbers per array within -3 to 3, the count is brute
//       force's over every tuple
//   P2  on 1 to 15 numbers per array over a mixed spread, shuffling
//       each array keeps the count
//   P3  passing the arrays in another order keeps it
//   P4  negating every number keeps it
//   P5  adding a constant to the first array and taking it from the
//       third keeps it

// ---- map: four_sum.kara

fn four_sum_count_map(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) -> i64 {
    let mut sums: Map[i64, i64] = Map.new();
    for a in nums1 {
        for b in nums2 {
            *sums.entry(a + b).or_insert(0) += 1;
        }
    }
    let mut count = 0;
    for c in nums3 {
        for d in nums4 {
            count += sums.get(-(c + d)).unwrap_or(0);
        }
    }
    count
}

// ---- pointers: four_sum_pointers.kara

fn pair_sums_pointers(xs: Vec[i64], ys: Vec[i64]) -> Vec[i64] {
    let mut sums: Vec[i64] = Vec.new();
    for x in xs {
        for y in ys {
            sums.push(x + y);
        }
    }
    sums.sort();
    sums
}

fn four_sum_count_pointers(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) -> i64 {
    let left = pair_sums_pointers(nums1, nums2);
    let right = pair_sums_pointers(nums3, nums4);
    let mut i = 0;
    let mut j = right.len() - 1;
    let mut count = 0;
    while i < left.len() and j >= 0 {
        let total = left[i] + right[j];
        if total < 0 {
            i += 1;
        } else if total > 0 {
            j -= 1;
        } else {
            let value = left[i];
            let mut run_left = 0;
            while i < left.len() and left[i] == value {
                run_left += 1;
                i += 1;
            }
            let other = right[j];
            let mut run_right = 0;
            while j >= 0 and right[j] == other {
                run_right += 1;
                j -= 1;
            }
            count += run_left * run_right;
        }
    }
    count
}

// ---- search: four_sum_search.kara

fn first_not_below_search(sorted: Vec[i64], target: i64) -> i64 {
    let mut low = 0;
    let mut high = sorted.len();
    while low < high {
        let mid = (low + high) / 2;
        if sorted[mid] < target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    low
}

fn four_sum_count_search(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) -> i64 {
    let mut sums: Vec[i64] = Vec.new();
    for a in nums1 {
        for b in nums2 {
            sums.push(a + b);
        }
    }
    sums.sort();
    let mut count = 0;
    for c in nums3 {
        for d in nums4 {
            let target = -(c + d);
            count += first_not_below_search(sums, target + 1) - first_not_below_search(sums, target);
        }
    }
    count
}

// ---- cubic: four_sum_cubic.kara

fn four_sum_count_cubic(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) -> i64 {
    let mut fourth: Map[i64, i64] = Map.new();
    for d in nums4 {
        *fourth.entry(d).or_insert(0) += 1;
    }
    let mut count = 0;
    for a in nums1 {
        for b in nums2 {
            for c in nums3 {
                count += fourth.get(-(a + b + c)).unwrap_or(0);
            }
        }
    }
    count
}

// ---- harness ----------------------------------------------------------

fn tuples(arm: i64, nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) -> i64 {
    if arm == 0 {
        four_sum_count_map(nums1, nums2, nums3, nums4)
    } else if arm == 1 {
        four_sum_count_pointers(nums1, nums2, nums3, nums4)
    } else if arm == 2 {
        four_sum_count_search(nums1, nums2, nums3, nums4)
    } else {
        four_sum_count_cubic(nums1, nums2, nums3, nums4)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Every tuple, tried one by one.
fn brute(nums1: Vec[i64], nums2: Vec[i64], nums3: Vec[i64], nums4: Vec[i64]) -> i64 {
    let mut count = 0;
    for a in nums1 {
        for b in nums2 {
            for c in nums3 {
                for d in nums4 {
                    if a + b + c + d == 0 {
                        count += 1;
                    }
                }
            }
        }
    }
    count
}

fn random_nums(n: i64, spread: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        let r = next_random(mut seed) * 65536 + next_random(mut seed);
        nums.push(r % spread - spread / 2);
    }
    nums
}

fn shuffled(nums: Vec[i64], seed: mut ref i64) -> Vec[i64] {
    let mut out = nums.clone();
    for i in 0..out.len() {
        out.swap(i, i + next_random(mut seed) % (out.len() - i));
    }
    out
}

fn negated(nums: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for x in nums {
        out.push(-x);
    }
    out
}

fn shifted(nums: Vec[i64], by: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for x in nums {
        out.push(x + by);
    }
    out
}

fn report(p: i64, arm: i64, case: i64, ok: bool, failures: mut ref Vec[i64]) {
    if not ok {
        failures[0] += 1;
        failures[p] += 1;
        if failures[0] <= 10 {
            println(f"FAIL P{p} arm {arm} case {case}");
        }
    }
}

fn main() {
    let mut seed: i64 = 4540;
    let mut checks: i64 = 0;
    let mut failures = vec![0; 6];
    for case in 0..1500 {
        // Small arrays for brute force: 1 to 5 numbers within -3 to 3.
        let small_n = 1 + next_random(mut seed) % 5;
        let s1 = random_nums(small_n, 7, mut seed);
        let s2 = random_nums(small_n, 7, mut seed);
        let s3 = random_nums(small_n, 7, mut seed);
        let s4 = random_nums(small_n, 7, mut seed);
        let expected = brute(s1, s2, s3, s4);
        // Larger arrays of 1 to 15 numbers over a mixed spread.
        let n = 1 + next_random(mut seed) % 15;
        let spread = [3, 11, 101, 536870913][next_random(mut seed) % 4];
        let n1 = random_nums(n, spread, mut seed);
        let n2 = random_nums(n, spread, mut seed);
        let n3 = random_nums(n, spread, mut seed);
        let n4 = random_nums(n, spread, mut seed);
        let m1 = shuffled(n1, mut seed);
        let m2 = shuffled(n2, mut seed);
        let m3 = shuffled(n3, mut seed);
        let m4 = shuffled(n4, mut seed);
        // A constant added to one array and taken from another.
        let by = next_random(mut seed) % 2001 - 1000;
        let up = shifted(n1, by);
        let down = shifted(n3, -by);
        for arm in 0..4 {
            checks += 5;
            report(1, arm, case, tuples(arm, s1, s2, s3, s4) == expected, mut failures);
            let base = tuples(arm, n1, n2, n3, n4);
            report(2, arm, case, tuples(arm, m1, m2, m3, m4) == base, mut failures);
            report(3, arm, case, tuples(arm, n3, n1, n4, n2) == base, mut failures);
            report(4, arm, case, tuples(arm, negated(n1), negated(n2), negated(n3), negated(n4)) == base, mut failures);
            report(5, arm, case, tuples(arm, up, n2, down, n4) == base, mut failures);
        }
    }
    println(f"1500 cases, 4 arms, {checks} checks, {failures[0]} failures");
    if failures[0] > 0 {
        println(f"by property: P1 {failures[1]}, P2 {failures[2]}, P3 {failures[3]}, P4 {failures[4]}, P5 {failures[5]}");
    }
}
