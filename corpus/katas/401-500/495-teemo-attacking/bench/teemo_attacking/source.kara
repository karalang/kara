// Benchmark for #495: the ★ arm (each gap, capped); see
// ../teemo_attacking.kara.

fn find_poisoned_duration(time_series: Vec[i64], duration: i64) -> i64 {
    let mut total = 0;
    for i in 0..time_series.len() {
        if i + 1 < time_series.len() {
            total += (time_series[i + 1] - time_series[i]).min(duration);
        } else {
            total += duration;
        }
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 200 series of 10,000 attacks (the problem's most) with gaps of 0
    // to 99, built once, then each solved for every duration from 0 to
    // 49.
    let mut all: Vec[Vec[i64]] = Vec.new();
    let mut seed: i64 = 495;
    for _ in 0..200 {
        let mut series: Vec[i64] = Vec.new();
        let mut t = 0;
        for _ in 0..10000 {
            series.push(t);
            t += next_random(mut seed) % 100;
        }
        all.push(series);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for series in all {
        for duration in 0..50 {
            let poisoned = find_poisoned_duration(series, duration);
            total += poisoned;
            checksum = (checksum * 31 + poisoned) % 1000000007;
        }
    }
    println(f"200 series of 10000, 50 durations each: {total} poisoned in all, checksum {checksum}");
}
