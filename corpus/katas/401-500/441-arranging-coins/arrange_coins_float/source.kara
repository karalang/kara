// LeetCode #441: Arranging Coins -- the closed form in floating point,
// then corrected.
//
// Compute k = (sqrt(8n + 1) - 1) / 2 with an f64 square root, then
// step k up or down while its rows do not match n: the exact test is
// in integers, so a square root that rounds the wrong way costs a step
// rather than a wrong answer. O(1) time.

fn arrange_coins(n: i64) -> i64 {
    let mut k = (((8 * n + 1) as f64).sqrt() as i64 - 1) / 2;
    while (k + 1) * (k + 2) / 2 <= n {
        k += 1;
    }
    while k * (k + 1) / 2 > n {
        k -= 1;
    }
    k
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    println(f"n = {n}: {arrange_coins(n)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(5);
    show(8);
    show(1);
    show(3);
    show(2147483647);
    show(2147450880);
    show(2147450879);
    show(1000000000);
    // 300 random n of at most 1 to 10 digits; a draw is below 2^30.
    let mut seed: i64 = 441;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let digits = 1 + next_random(mut seed) % 10;
        let mut top = 1;
        for _ in 0..digits {
            top *= 10;
        }
        let draw = next_random(mut seed) * 32768 + next_random(mut seed);
        let n = 1 + (draw % top.min(2147483647));
        let rows = arrange_coins(n);
        total += rows;
        checksum = (checksum * 31 + rows) % 1000000007;
    }
    println(f"300 random n: total {total}, checksum {checksum}");
}
