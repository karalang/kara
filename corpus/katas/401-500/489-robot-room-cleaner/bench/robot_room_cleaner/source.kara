// Benchmark for #489: the ★ arm (backtracking) on a large workload.
//
// LeetCode #489: Robot Room Cleaner -- backtracking.
//
// The robot knows nothing but its own moves, so it counts position from
// where it starts, (0, 0) facing up. From each new cell it cleans, then
// looks in the four directions in turn (turning right each time); where
// the cell ahead is new and the robot can step into it, it explores
// from there and then backs out: turn around, step, turn around again,
// so it faces the way it was facing before. Each cell is entered once.

fn step_row(facing: i64) -> i64 {
    match facing {
        0 => -1,
        2 => 1,
        _ => 0,
    }
}

fn step_col(facing: i64) -> i64 {
    match facing {
        1 => 1,
        3 => -1,
        _ => 0,
    }
}

fn explore(robot: mut ref Robot, row: i64, col: i64, facing: i64, visited: mut ref Set[(i64, i64)]) {
    visited.insert((row, col));
    robot.clean();
    let mut d = facing;
    for _ in 0..4 {
        let next = (row + step_row(d), col + step_col(d));
        if not visited.contains(next) and robot.forward() {
            explore(mut robot, next.0, next.1, d, mut visited);
            robot.turn_right();
            robot.turn_right();
            robot.forward();
            robot.turn_right();
            robot.turn_right();
        }
        robot.turn_right();
        d = (d + 1) % 4;
    }
}

fn clean_room(robot: mut ref Robot) {
    let mut visited: Set[(i64, i64)] = Set.new();
    explore(mut robot, 0, 0, 0, mut visited);
}

// ---- benchmark ------------------------------------------------------------

// The room as LeetCode hides it: 1 open, 0 a wall; the robot knows only
// these four calls. A robot that has made more calls than `budget` (far
// more than any of the arms needs) stops moving, so a search that has
// lost its way ends instead of running for ever.
struct Robot {
    room: Vec[Vec[i64]],
    row: i64,
    col: i64,
    facing: i64,
    cleaned: Vec[Vec[i64]],
    calls: i64,
    budget: i64,
}

impl Robot {
    fn forward(mut ref self) -> bool {
        self.calls += 1;
        if self.calls > self.budget {
            return false;
        }
        let (dr, dc) = match self.facing {
            0 => (-1, 0),
            1 => (0, 1),
            2 => (1, 0),
            _ => (0, -1),
        };
        let r = self.row + dr;
        let c = self.col + dc;
        if r < 0 or r >= self.room.len() or c < 0 or c >= self.room[0].len() or self.room[r][c] == 0 {
            return false;
        }
        self.row = r;
        self.col = c;
        true
    }

    fn turn_left(mut ref self) {
        self.calls += 1;
        if self.calls <= self.budget {
            self.facing = (self.facing + 3) % 4;
        }
    }

    fn turn_right(mut ref self) {
        self.calls += 1;
        if self.calls <= self.budget {
            self.facing = (self.facing + 1) % 4;
        }
    }

    fn clean(mut ref self) {
        self.calls += 1;
        if self.calls <= self.budget {
            self.cleaned[self.row][self.col] += 1;
        }
    }
}

fn make_robot(room: Vec[Vec[i64]], row: i64, col: i64, facing: i64) -> Robot {
    let mut cleaned: Vec[Vec[i64]] = Vec.new();
    for r in 0..room.len() {
        let mut line: Vec[i64] = Vec.new();
        for _ in 0..room[r].len() {
            line.push(0);
        }
        cleaned.push(line);
    }
    let cells = room.len() * room[0].len();
    Robot { room: room.clone(), row: row, col: col, facing: facing, cleaned: cleaned, calls: 0, budget: 16 * cells * cells + 1000 }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 300 rooms of 100 by 100 cells, a wall in each cell with odds of 1 in
    // 4, the start on an open cell, built once, then each cleaned once.
    let mut rooms: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut starts: Vec[(i64, i64)] = Vec.new();
    let mut seed: i64 = 489;
    for _ in 0..300 {
        let mut room: Vec[Vec[i64]] = Vec.new();
        for _ in 0..100 {
            let mut line: Vec[i64] = Vec.new();
            for _ in 0..100 {
                line.push(if next_random(mut seed) % 4 == 0 { 0 } else { 1 });
            }
            room.push(line);
        }
        let row = next_random(mut seed) % 100;
        let col = next_random(mut seed) % 100;
        room[row][col] = 1;
        rooms.push(room);
        starts.push((row, col));
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for k in 0..rooms.len() {
        let (row, col) = starts[k];
        let mut robot = make_robot(rooms[k], row, col, 0);
        clean_room(mut robot);
        let mut cleaned = 0;
        for r in 0..100 {
            for c in 0..100 {
                if robot.cleaned[r][c] > 0 {
                    cleaned += 1;
                    checksum = (checksum * 31 + r * 100 + c) % 1000000007;
                }
            }
        }
        total += cleaned;
        checksum = (checksum * 31 + robot.calls) % 1000000007;
    }
    println(f"300 rooms of 100 by 100: {total} cells cleaned, checksum {checksum}");
}
