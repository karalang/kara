// Benchmark for #407: the kata's ★ arm (a min-heap walking in from the
// border). 60 random 200 x 200 grids (the problem's limit) with heights
// from 0 to 19,999; the water and a checksum go into the sink.

fn trap_rain_water(height: Vec[Vec[i64]]) -> i64 {
    let m = height.len();
    if m < 3 or height[0].len() < 3 {
        return 0;
    }
    let n = height[0].len();
    let mut seen = vec![vec![false; n]; m];
    let mut heap: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    for r in 0..m {
        for c in 0..n {
            if r == 0 or c == 0 or r == m - 1 or c == n - 1 {
                heap.push((height[r][c], r, c));
                seen[r][c] = true;
            }
        }
    }
    let dr = [1, -1, 0, 0];
    let dc = [0, 0, 1, -1];
    let mut water = 0;
    while let Some((level, r, c)) = heap.pop() {
        for d in 0..4 {
            let nr = r + dr[d];
            let nc = c + dc[d];
            if nr >= 0 and nr < m and nc >= 0 and nc < n and not seen[nr][nc] {
                seen[nr][nc] = true;
                if height[nr][nc] < level {
                    water += level - height[nr][nc];
                }
                heap.push((level.max(height[nr][nc]), nr, nc));
            }
        }
    }
    water
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let grids = 60;
    let size = 200;
    let mut seed: i64 = 407;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..grids {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..size {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..size {
                row.push((step(mut seed) * 32768 + step(mut seed)) % 20000);
            }
            grid.push(row);
        }
        let w = trap_rain_water(grid);
        total += w;
        checksum = (checksum * 31 + w) % 1000000007;
    }
    println(f"{grids} grids of {size} x {size}: {total} units of water, checksum {checksum}");
}
