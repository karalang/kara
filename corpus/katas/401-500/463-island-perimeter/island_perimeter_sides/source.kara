// LeetCode #463: Island Perimeter -- open sides.
//
// Walk every land cell and count its sides that face water or the edge
// of the grid; each such side is one unit of the perimeter.
// O(rows x cols).

fn is_land(grid: Vec[Vec[i64]], i: i64, j: i64) -> bool {
    i >= 0 and i < grid.len() and j >= 0 and j < grid[i].len() and grid[i][j] == 1
}

fn island_perimeter(grid: Vec[Vec[i64]]) -> i64 {
    let mut perimeter = 0;
    for i in 0..grid.len() {
        for j in 0..grid[i].len() {
            if grid[i][j] == 1 {
                for (di, dj) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
                    if not is_land(grid, i + di, j + dj) {
                        perimeter += 1;
                    }
                }
            }
        }
    }
    perimeter
}

// ---- test harness ---------------------------------------------------------

fn drawn(grid: Vec[Vec[i64]]) -> String {
    let mut out = String.new();
    for i in 0..grid.len() {
        if i > 0 {
            out.push('/');
        }
        for cell in grid[i] {
            out.push_str(f"{cell}");
        }
    }
    out
}

fn show(grid: Vec[Vec[i64]]) {
    println(f"{drawn(grid)} -> {island_perimeter(grid)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random walk of land on a rows x cols sea, then every lake (water
// the outer sea cannot reach) filled in, as the problem promises.
fn random_island(rows: i64, cols: i64, steps: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..rows {
        grid.push(vec![0; cols]);
    }
    let mut i = next_random(seed) % rows;
    let mut j = next_random(seed) % cols;
    grid[i][j] = 1;
    for _ in 0..steps {
        let d = next_random(seed) % 4;
        if d == 0 and i > 0 {
            i -= 1;
        } else if d == 1 and i + 1 < rows {
            i += 1;
        } else if d == 2 and j > 0 {
            j -= 1;
        } else if d == 3 and j + 1 < cols {
            j += 1;
        }
        grid[i][j] = 1;
    }
    // Water reachable from the border, breadth first.
    let mut sea: Vec[Vec[bool]] = Vec.new();
    for _ in 0..rows {
        sea.push(vec![false; cols]);
    }
    let mut queue: Vec[(i64, i64)] = Vec.new();
    for r in 0..rows {
        for c in 0..cols {
            if (r == 0 or c == 0 or r == rows - 1 or c == cols - 1) and grid[r][c] == 0 {
                sea[r][c] = true;
                queue.push((r, c));
            }
        }
    }
    let mut head = 0;
    while head < queue.len() {
        let (r, c) = queue[head];
        head += 1;
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let nr = r + dr;
            let nc = c + dc;
            if nr >= 0 and nr < rows and nc >= 0 and nc < cols and grid[nr][nc] == 0 and not sea[nr][nc] {
                sea[nr][nc] = true;
                queue.push((nr, nc));
            }
        }
    }
    for r in 0..rows {
        for c in 0..cols {
            if not sea[r][c] {
                grid[r][c] = 1;
            }
        }
    }
    grid
}

fn main() {
    show(vec![vec![0, 1, 0, 0], vec![1, 1, 1, 0], vec![0, 1, 0, 0], vec![1, 1, 0, 0]]);
    show(vec![vec![1]]);
    show(vec![vec![1, 0]]);
    show(vec![vec![1, 1, 1], vec![1, 1, 1], vec![1, 1, 1]]);
    show(vec![vec![0, 0, 0], vec![0, 1, 0], vec![0, 0, 0]]);
    show(vec![vec![1, 1, 1, 1, 1]]);
    show(vec![vec![1], vec![1], vec![1]]);
    show(vec![vec![1, 0, 1], vec![1, 0, 1], vec![1, 1, 1]]);
    show(vec![vec![0, 1, 0], vec![1, 1, 1], vec![0, 1, 0]]);
    show(vec![vec![1, 1, 0, 0], vec![0, 1, 1, 0], vec![0, 0, 1, 1]]);
    // 300 random islands on seas of 1 to 40 by 1 to 40, grown by a walk
    // of up to rows x cols steps.
    let count = 300;
    let mut seed: i64 = 463;
    let mut total = 0;
    let mut land = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let rows = 1 + next_random(mut seed) % 40;
        let cols = 1 + next_random(mut seed) % 40;
        let steps = next_random(mut seed) % (rows * cols + 1);
        let grid = random_island(rows, cols, steps, mut seed);
        for row in grid {
            for cell in row {
                land += cell;
            }
        }
        let perimeter = island_perimeter(grid);
        total += perimeter;
        checksum = (checksum * 31 + perimeter) % 1000000007;
    }
    println(f"{count} random islands: {land} land cells, perimeter {total} in all, checksum {checksum}");
}
