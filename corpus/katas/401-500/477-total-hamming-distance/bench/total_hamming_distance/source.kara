// Benchmark for #477: the ★ arm (one bit at a time) on a large
// workload.
//
// LeetCode #477: Total Hamming Distance -- one bit at a time.
//
// Two numbers differ at a bit exactly when one has it and the other
// does not, so if k of the n numbers have bit b set, bit b adds
// k x (n - k) to the total. Every number is below 2^30. O(30 x n).

fn total_hamming_distance(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut total = 0;
    for bit in 0..30 {
        let mut ones = 0;
        for x in nums {
            ones += (x >> bit) & 1;
        }
        total += ones * (n - ones);
    }
    total
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10,000 numbers from 0 to 1,000,000,000 (the problem's most), then
    // 5,000 rounds, each replacing one number and taking the total again.
    let n = 10000;
    let rounds = 5000;
    let mut seed: i64 = 477;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        nums[r % n] = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001;
        let got = total_hamming_distance(nums);
        total += got;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"{rounds} rounds on {n} numbers: distances add up to {total}, checksum {checksum}");
}
