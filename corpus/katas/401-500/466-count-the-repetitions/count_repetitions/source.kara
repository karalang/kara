// LeetCode #466: Count The Repetitions -- find the cycle.
//
// Read copies of s1 one after another, matching s2 greedily as a
// subsequence and counting the copies of s2 completed. After each copy
// of s1, the only state is where in s2 the match stands, so within
// |s2| + 1 copies a position repeats. The copies between the two
// visits are a cycle that completes the same number of s2 copies each
// time: jump over as many whole cycles as fit, read the rest, and
// divide the s2 copies by n2. O(|s1| x |s2|).

fn get_max_repetitions(s1: String, n1: i64, s2: String, n2: i64) -> i64 {
    let a: Vec[char] = s1.chars().collect();
    let b: Vec[char] = s2.chars().collect();
    let mut index = 0;
    let mut count = 0;
    // Where in s2 the match stood after copy k, and the s2 copies by then.
    let mut seen: Map[i64, (i64, i64)] = Map.new();
    let mut k = 0;
    while k < n1 {
        for c in a {
            if c == b[index] {
                index += 1;
                if index == b.len() {
                    index = 0;
                    count += 1;
                }
            }
        }
        k += 1;
        if let Some((k0, count0)) = seen.get(index) {
            let cycle = k - k0;
            let cycles = (n1 - k) / cycle;
            count += cycles * (count - count0);
            k += cycles * cycle;
            // Fewer than a cycle's worth of copies are left; read them.
            while k < n1 {
                for c in a {
                    if c == b[index] {
                        index += 1;
                        if index == b.len() {
                            index = 0;
                            count += 1;
                        }
                    }
                }
                k += 1;
            }
            break;
        }
        seen.insert(index, (k, count));
    }
    count / n2
}

// ---- test harness ---------------------------------------------------------

fn show(s1: String, n1: i64, s2: String, n2: i64) {
    let m = get_max_repetitions(s1, n1, s2, n2);
    println(f"[\"{s1}\", {n1}], [\"{s2}\", {n2}] -> {m}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(len: i64, letters: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..len {
        word.push(char.try_from(97 + next_random(mut seed) % letters).unwrap());
    }
    word
}

fn main() {
    show("acb", 4, "ab", 2);
    show("acb", 1, "acb", 1);
    show("abc", 3, "d", 1);
    show("aaa", 3, "aa", 1);
    show("ab", 1000000, "ba", 1);
    show("bacaba", 3, "abacab", 1);
    show("abcd", 1000000, "dcba", 7);
    show("lovelive", 100000, "lovelive", 100000);
    show("baba", 11, "baab", 1);
    show("aabaa", 1000000, "aba", 3);
    // 300 random cases: s1 of 1 to 8 letters and s2 of 1 to 4, from the
    // first 2, 3 or 4 letters, with n1 up to 1,000 and n2 up to 5.
    let count = 300;
    let mut seed: i64 = 466;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let letters = 2 + next_random(mut seed) % 3;
        let s1 = random_word(1 + next_random(mut seed) % 8, letters, mut seed);
        let n1 = 1 + next_random(mut seed) % 1000;
        let s2 = random_word(1 + next_random(mut seed) % 4, letters, mut seed);
        let n2 = 1 + next_random(mut seed) % 5;
        let m = get_max_repetitions(s1, n1, s2, n2);
        total += m;
        checksum = (checksum * 31 + m) % 1000000007;
    }
    println(f"{count} random cases: {total} repetitions in all, checksum {checksum}");
}
