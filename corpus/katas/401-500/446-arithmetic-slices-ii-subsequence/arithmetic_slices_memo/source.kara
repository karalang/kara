// LeetCode #446: Arithmetic Slices II - Subsequence -- memoized
// recursion from the front.
//
// from(k, j), for k < j, counts the ways to continue an arithmetic
// subsequence that starts nums[k], nums[j]: each later l holding
// 2 * nums[j] - nums[k] adds one slice (k, j, l) and all the ways to
// continue from (j, l). Every slice of three or more is counted once,
// by its first two values. Memoized on the pair, with a map from each
// value to its indexes. O(n^2) pairs, each with as many l's as the
// value repeats; recursion as deep as the longest slice.

fn from(k: i64, j: i64, nums: Vec[i64], positions: Map[i64, Vec[i64]], memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if let Some(known) = memo.get((k, j)) {
        return known;
    }
    let mut ways = 0;
    let wanted = 2 * nums[j] - nums[k];
    if let Some(ls) = positions.get(wanted) {
        for l in ls {
            if l > j {
                ways += 1 + from(j, l, nums, positions, memo);
            }
        }
    }
    memo.insert((k, j), ways);
    ways
}

fn number_of_arithmetic_slices(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut positions: Map[i64, Vec[i64]] = Map.new();
    for i in 0..n {
        positions.entry(nums[i]).or_insert(Vec.new()).push(i);
    }
    let mut memo: Map[(i64, i64), i64] = Map.new();
    let mut total = 0;
    for k in 0..n {
        for j in k + 1..n {
            total += from(k, j, nums, positions, mut memo);
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn show(nums: Vec[i64]) {
    let mut s = String.from("[");
    for i in 0..nums.len() {
        if i > 0 {
            s.push(',');
        }
        s.push_str(f"{nums[i]}");
    }
    s.push(']');
    println(f"{s}: {number_of_arithmetic_slices(nums)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(vec![2, 4, 6, 8, 10]);
    show(vec![7, 7, 7, 7, 7]);
    show(vec![1]);
    show(vec![1, 2]);
    show(vec![1, 2, 3]);
    show(vec![0, 2000000000, -294967296]);
    show(vec![-2147483648, 0, 2147483647, -2147483648, -1, 2147483646]);
    show(vec![3, -1, -5, -9, 1, 5, 9]);
    // 300 random arrays of 1 to 60 values, spread over 3, 10, 100 or
    // 1,000,000 values around 0: the narrow spreads repeat values and
    // differences, so their counts run into the millions.
    let count = 300;
    let mut seed: i64 = 446;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = 1 + next_random(mut seed) % 60;
        let spread = [3, 10, 100, 1000000][next_random(mut seed) % 4];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % spread - spread / 2);
        }
        let answer = number_of_arithmetic_slices(nums);
        total += answer;
        checksum = (checksum * 31 + answer % 1000000007) % 1000000007;
    }
    println(f"{count} random arrays: {total} slices, checksum {checksum}");
}
