// LeetCode #446: Arithmetic Slices II - Subsequence -- a map of
// differences per index.
//
// Count the "weak" arithmetic subsequences of two or more values: for
// each index i, a map from a difference d to how many end at i with
// difference d. Each earlier j extends every one ending at j with
// difference nums[i] - nums[j], and starts a new pair (j, i). Extending
// one of those, which has two or more values already, makes a slice of
// three or more, so those extensions are what the answer counts.
// O(n^2) expected time and space.

fn number_of_arithmetic_slices(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    // ending[i][d]: subsequences of two or more values ending at i with
    // difference d.
    let mut ending: Vec[Map[i64, i64]] = Vec.new();
    let mut total = 0;
    for i in 0..n {
        let mut here: Map[i64, i64] = Map.new();
        for j in 0..i {
            let d = nums[i] - nums[j];
            let before = ending[j].get(d) ?? 0;
            total += before;
            *here.entry(d).or_insert(0) += before + 1;
        }
        ending.push(here);
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn show(nums: Vec[i64]) {
    let mut s = String.from("[");
    for i in 0..nums.len() {
        if i > 0 {
            s.push(',');
        }
        s.push_str(f"{nums[i]}");
    }
    s.push(']');
    println(f"{s}: {number_of_arithmetic_slices(nums)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(vec![2, 4, 6, 8, 10]);
    show(vec![7, 7, 7, 7, 7]);
    show(vec![1]);
    show(vec![1, 2]);
    show(vec![1, 2, 3]);
    show(vec![0, 2000000000, -294967296]);
    show(vec![-2147483648, 0, 2147483647, -2147483648, -1, 2147483646]);
    show(vec![3, -1, -5, -9, 1, 5, 9]);
    // 300 random arrays of 1 to 60 values, spread over 3, 10, 100 or
    // 1,000,000 values around 0: the narrow spreads repeat values and
    // differences, so their counts run into the millions.
    let count = 300;
    let mut seed: i64 = 446;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = 1 + next_random(mut seed) % 60;
        let spread = [3, 10, 100, 1000000][next_random(mut seed) % 4];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % spread - spread / 2);
        }
        let answer = number_of_arithmetic_slices(nums);
        total += answer;
        checksum = (checksum * 31 + answer % 1000000007) % 1000000007;
    }
    println(f"{count} random arrays: {total} slices, checksum {checksum}");
}
