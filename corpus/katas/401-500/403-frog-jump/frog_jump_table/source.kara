// LeetCode #403: Frog Jump -- a table over stones and jump sizes.
//
// reached[i][k] says the frog can stand on stone i having jumped k to get
// there. The jumps start at 1 and grow by at most 1 per stone, so the
// jump that leaves stone j is at most j + 1. Stone i is reached with
// jump k = stones[i] - stones[j] from an earlier stone j if k <= j + 1
// and stone j was reached with k - 1, k or k + 1. O(n^2) time and space.

fn can_cross(stones: Vec[i64]) -> bool {
    let n = stones.len();
    let mut reached = vec![vec![false; n + 1]; n];
    reached[0][0] = true;
    for i in 1..n {
        for j in 0..i {
            let k = stones[i] - stones[j];
            if k <= j + 1 and (reached[j][k - 1] or reached[j][k] or reached[j][k + 1]) {
                reached[i][k] = true;
            }
        }
    }
    for k in 0..n + 1 {
        if reached[n - 1][k] {
            return true;
        }
    }
    false
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(stones: Vec[i64]) {
    let mut text = String.from("[");
    for i in 0..stones.len() {
        if i > 0 {
            text.push_str(", ");
        }
        text.push_str(f"{stones[i]}");
    }
    text.push_str("]: ");
    text.push_str(if can_cross(stones) { "true" } else { "false" });
    println(text);
}

fn main() {
    show(vec![0, 1, 3, 5, 6, 8, 12, 17]);
    show(vec![0, 1, 2, 3, 4, 8, 9, 11]);
    show(vec![0, 1]);
    show(vec![0, 2]);
    show(vec![0, 1, 3, 6, 10, 15, 21]);
    show(vec![0, 1, 3, 6, 10, 13, 14]);
    show(vec![0, 1, 2, 4, 7, 11, 16, 22, 29]);
    show(vec![0, 1, 3, 4, 5, 7, 9, 10, 12]);
    show(vec![0, 1, 1000]);
    let mut row: Vec[i64] = Vec.new();
    for i in 0..20 {
        row.push(i);
    }
    show(row);
    // 2,000 random rivers of 2 to 60 stones, the gaps after the first
    // stone from 1 to 4.
    let mut seed: i64 = 403;
    let mut crossed = 0;
    let mut checksum: i64 = 0;
    for case in 0..2000 {
        let n = 2 + step(mut seed) % 59;
        let mut stones = vec![0, 1];
        while stones.len() < n {
            let last = stones[stones.len() - 1];
            stones.push(last + 1 + step(mut seed) % 4);
        }
        if can_cross(stones) {
            crossed += 1;
            checksum = (checksum * 31 + case + 1) % 1000000007;
        }
    }
    println(f"2000 random rivers: {crossed} crossed, checksum {checksum}");
}
