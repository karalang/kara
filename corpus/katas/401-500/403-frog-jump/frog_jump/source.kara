// LeetCode #403: Frog Jump -- the jump sizes that reach each stone.
//
// Keep, for every stone, the set of jump sizes the frog can land on it
// with. The first stone is reached with a jump of 0, so its next jump is
// 1. Walk the stones in order: from stone s reached by a jump k, the
// jumps k - 1, k and k + 1 (if positive) land on s + k - 1, s + k and
// s + k + 1, and each that is a stone gains that jump. The river is
// crossed if the last stone gains any jump. O(n^2) time and space: a
// stone is reached by at most n jump sizes.

fn can_cross(stones: Vec[i64]) -> bool {
    let mut jumps: Map[i64, Set[i64]] = Map.new();
    for s in stones.iter() {
        jumps.insert(*s, Set.new());
    }
    jumps[stones[0]].insert(0);
    for s in stones.iter() {
        let mut sizes: Vec[i64] = Vec.new();
        for k in jumps[*s].iter() {
            sizes.push(k);
        }
        for k in sizes.iter() {
            for size in *k - 1..*k + 2 {
                if size > 0 and jumps.contains_key(*s + size) {
                    jumps[*s + size].insert(size);
                }
            }
        }
    }
    jumps[stones[stones.len() - 1]].len() > 0
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(stones: Vec[i64]) {
    let mut text = String.from("[");
    for i in 0..stones.len() {
        if i > 0 {
            text.push_str(", ");
        }
        text.push_str(f"{stones[i]}");
    }
    text.push_str("]: ");
    text.push_str(if can_cross(stones) { "true" } else { "false" });
    println(text);
}

fn main() {
    show(vec![0, 1, 3, 5, 6, 8, 12, 17]);
    show(vec![0, 1, 2, 3, 4, 8, 9, 11]);
    show(vec![0, 1]);
    show(vec![0, 2]);
    show(vec![0, 1, 3, 6, 10, 15, 21]);
    show(vec![0, 1, 3, 6, 10, 13, 14]);
    show(vec![0, 1, 2, 4, 7, 11, 16, 22, 29]);
    show(vec![0, 1, 3, 4, 5, 7, 9, 10, 12]);
    show(vec![0, 1, 1000]);
    let mut row: Vec[i64] = Vec.new();
    for i in 0..20 {
        row.push(i);
    }
    show(row);
    // 2,000 random rivers of 2 to 60 stones, the gaps after the first
    // stone from 1 to 4.
    let mut seed: i64 = 403;
    let mut crossed = 0;
    let mut checksum: i64 = 0;
    for case in 0..2000 {
        let n = 2 + step(mut seed) % 59;
        let mut stones = vec![0, 1];
        while stones.len() < n {
            let last = stones[stones.len() - 1];
            stones.push(last + 1 + step(mut seed) % 4);
        }
        if can_cross(stones) {
            crossed += 1;
            checksum = (checksum * 31 + case + 1) % 1000000007;
        }
    }
    println(f"2000 random rivers: {crossed} crossed, checksum {checksum}");
}
