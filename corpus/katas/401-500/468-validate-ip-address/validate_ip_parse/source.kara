// LeetCode #468: Validate IP Address -- a parser for each grammar.
//
// IPv4 is `dec "." dec "." dec "." dec` and IPv6 is eight `hex` joined
// by ':'. Parse the address against each grammar with a cursor: a `dec`
// takes 1 to 3 decimal digits, a `hex` 1 to 4 hex digits, a separator
// must come between them, and the input must end right after the last.
// A `dec` is then checked for its value and a leading zero. O(n).

fn parse_ipv4(cs: ref Vec[char]) -> bool {
    let mut pos = 0;
    for k in 0..4 {
        if k > 0 {
            if pos >= cs.len() or cs[pos] != '.' {
                return false;
            }
            pos += 1;
        }
        let start = pos;
        let mut value = 0;
        while pos < cs.len() and pos - start < 3 and cs[pos].is_ascii_digit() {
            value = value * 10 + (cs[pos] as i64 - 48);
            pos += 1;
        }
        if pos == start or value > 255 or (pos - start > 1 and cs[start] == '0') {
            return false;
        }
    }
    pos == cs.len()
}

fn parse_ipv6(cs: ref Vec[char]) -> bool {
    let mut pos = 0;
    for k in 0..8 {
        if k > 0 {
            if pos >= cs.len() or cs[pos] != ':' {
                return false;
            }
            pos += 1;
        }
        let start = pos;
        while pos < cs.len() and pos - start < 4 and cs[pos].is_ascii_hexdigit() {
            pos += 1;
        }
        if pos == start {
            return false;
        }
    }
    pos == cs.len()
}

fn valid_ip_address(query_ip: String) -> String {
    let cs: Vec[char] = query_ip.chars().collect();
    if parse_ipv4(cs) {
        String.from("IPv4")
    } else if parse_ipv6(cs) {
        String.from("IPv6")
    } else {
        String.from("Neither")
    }
}

// ---- test harness ---------------------------------------------------------

fn show(query_ip: Str) {
    let answer = valid_ip_address(String.from(query_ip));
    println(f"\"{query_ip}\" -> {answer}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn pick(alphabet: Str, seed: mut ref i64) -> char {
    let letters: Vec[char] = alphabet.chars().collect();
    letters[next_random(mut seed) % letters.len()]
}

// An IPv4 or IPv6 address, half the time with one fault: a part too many
// or too few, a leading zero, a number above 255, a group of 5 digits,
// an empty part or a letter out of place. Or now and then a jumble of
// the characters an address uses.
fn random_query(seed: mut ref i64) -> String {
    let kind = next_random(mut seed) % 5;
    let fault = next_random(mut seed) % 8;
    let mut s = String.new();
    if kind < 2 {
        let parts = if fault == 4 { [3, 5][next_random(mut seed) % 2] } else { 4 };
        let at = next_random(mut seed) % parts;
        for p in 0..parts {
            if p > 0 {
                s.push('.');
            }
            let mut value = next_random(mut seed) % 256;
            if p == at and fault == 5 {
                s.push('0');
            }
            if p == at and fault == 6 {
                value = 256 + next_random(mut seed) % 744;
            }
            if p == at and fault == 7 {
                if next_random(mut seed) % 2 == 0 {
                    s.push(pick("aeFx", mut seed));
                }
                continue;
            }
            s.push_str(f"{value}");
        }
    } else if kind < 4 {
        let groups = if fault == 4 { [7, 9][next_random(mut seed) % 2] } else { 8 };
        let at = next_random(mut seed) % groups;
        for g in 0..groups {
            if g > 0 {
                s.push(':');
            }
            if g == at and fault == 6 {
                continue;
            }
            let length = if g == at and fault == 5 { 5 } else { 1 + next_random(mut seed) % 4 };
            let bad = if g == at and fault == 7 { next_random(mut seed) % length } else { -1 };
            for i in 0..length {
                if i == bad {
                    s.push(pick("gGxz", mut seed));
                } else {
                    s.push(pick("0123456789abcdefABCDEF", mut seed));
                }
            }
        }
    } else {
        let length = 1 + next_random(mut seed) % 15;
        for _ in 0..length {
            s.push(pick("0123456789aF.:g", mut seed));
        }
    }
    s
}

fn main() {
    show("172.16.254.1");
    show("2001:0db8:85a3:0:0:8A2E:0370:7334");
    show("256.256.256.256");
    show("0.0.0.0");
    show("255.255.255.255");
    show("01.1.1.1");
    show("00.0.0.0");
    show("1.1.1");
    show("1.1.1.1.");
    show(".1.1.1");
    show("1..1.1");
    show("1e1.4.5.6");
    show("192.168.1.1:80");
    show("1:2:3:4:5:6:7:8");
    show("abcd:ABCD:Ef01:9:0:0:0:0");
    show("2001:db8:85a3:0::8a2E:0370:7334");
    show("02001:0db8:85a3:0000:0000:8a2e:0370:7334");
    show("2001:0db8:85a3:0:0:8A2E:0370:7334:");
    show("G:1:2:3:4:5:6:7");
    show("1.2.3.4.5.6.7.8");
    show("a");
    // 300 random queries: how many of each answer, and a checksum of the
    // answers in order.
    let count = 300;
    let mut seed: i64 = 468;
    let mut ipv4 = 0;
    let mut ipv6 = 0;
    let mut neither = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let query = random_query(mut seed);
        let answer = valid_ip_address(query);
        let code = if answer == "IPv4" {
            ipv4 += 1;
            1
        } else if answer == "IPv6" {
            ipv6 += 1;
            2
        } else {
            neither += 1;
            3
        };
        checksum = (checksum * 7 + code) % 1000000007;
    }
    println(f"{count} random queries: {ipv4} IPv4, {ipv6} IPv6, {neither} Neither, checksum {checksum}");
}
