// Benchmark for #431: the left-child right-sibling arm (encode.kara)
// on 100 random trees of 10,000 nodes.

struct Node {
    val: i64,
    children: Vec[Node],
}

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn encode(root: Option[Node]) -> Option[TreeNode] {
    match root {
        Some(node) => Some(encode_node(node)),
        None => None,
    }
}

fn encode_node(node: Node) -> TreeNode {
    let t = TreeNode { val: node.val, left: None, right: None };
    let mut prev: Option[TreeNode] = None;
    for child in node.children {
        let c = encode_node(child);
        match prev {
            Some(p) => p.right = Some(c),
            None => t.left = Some(c),
        }
        prev = Some(c);
    }
    t
}

fn decode(root: Option[TreeNode]) -> Option[Node] {
    match root {
        Some(t) => Some(decode_node(t)),
        None => None,
    }
}

fn decode_node(t: TreeNode) -> Node {
    let mut children: Vec[Node] = Vec.new();
    let mut child = t.left;
    while let Some(c) = child {
        children.push(decode_node(c));
        child = c.right;
    }
    Node { val: t.val, children: children }
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build_random(i: i64, vals: ref Vec[i64], kids: ref Vec[Vec[i64]]) -> Node {
    let mut children: Vec[Node] = Vec.new();
    for k in kids[i] {
        children.push(build_random(k, vals, kids));
    }
    Node { val: vals[i], children: children }
}

// The decoded tree's values in preorder, folded into the checksum.
fn fold(node: Node, count: mut ref i64, checksum: mut ref i64) {
    *count += 1;
    *checksum = (*checksum * 31 + node.val) % 1000000007;
    for child in node.children {
        fold(child, mut count, mut checksum);
    }
}

fn main() {
    let n = 10000;
    let rounds = 100;
    let mut seed: i64 = 431;
    let mut count = 0;
    let mut checksum: i64 = 0;
    for _ in 0..rounds {
        // Each node after the first hangs under one of the `reach` nodes
        // before it: a small reach makes a deep tree, a large one a
        // wide tree.
        let reach = 10 + step(mut seed) % 1000;
        let mut vals: Vec[i64] = Vec.new();
        let mut kids: Vec[Vec[i64]] = Vec.new();
        for i in 0..n {
            vals.push(step(mut seed) % 10001);
            kids.push(Vec.new());
            if i > 0 {
                let back = 1 + step(mut seed) % min(i, reach);
                kids[i - back].push(i);
            }
        }
        let back = decode(encode(Some(build_random(0, vals, kids))));
        match back {
            Some(root) => fold(root, mut count, mut checksum),
            None => {}
        }
    }
    println(f"{rounds} rounds of {n} nodes: {count} decoded, checksum {checksum}");
}
