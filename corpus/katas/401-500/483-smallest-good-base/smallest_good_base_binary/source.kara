// LeetCode #483: Smallest Good Base -- a binary search for each count.
//
// For a fixed count m of 1s, 1 + k + ... + k^(m-1) grows with k, so the
// base that gives n, if there is one, can be found by binary search over
// k from 2 to n - 1. The sum is taken with `checked_mul` and
// `checked_add`, and an overflow means "larger than n". Counts are tried
// from 62 down, so the first base found is the smallest.

// 1 + k + ... + k^(m-1), or None when it passes i64.MAX.
fn ones_sum(k: i64, m: i64) -> Option[i64] {
    let mut sum: i64 = 1;
    let mut term: i64 = 1;
    for _ in 1..m {
        term = term.checked_mul(k)?;
        sum = sum.checked_add(term)?;
    }
    Some(sum)
}

fn smallest_good_base(n: String) -> String {
    let value = i64.parse(n).unwrap();
    for m in (3..63).rev() {
        let mut low = 2;
        let mut high = value - 1;
        while low <= high {
            let mid = low + (high - low) / 2;
            match ones_sum(mid, m) {
                Some(sum) if sum == value => return f"{mid}",
                Some(sum) if sum < value => low = mid + 1,
                _ => high = mid - 1,
            }
        }
    }
    f"{value - 1}"
}

// ---- test harness ---------------------------------------------------------

fn show(n: String) {
    println(f"n = {n} -> {smallest_good_base(n)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(String.from("13"));
    show(String.from("4681"));
    show(String.from("1000000000000000000"));
    show(String.from("3"));
    show(String.from("15"));
    show(String.from("21"));
    show(String.from("1000000"));
    show(String.from("2251799813685247"));
    show(String.from("999999999999999999"));
    show(String.from("919818571896748567"));
    // 300 random cases. Two in three are m ones in a random base k (k
    // from 2 up, m from 3 up, the value at most 10^18), whose answer is k
    // or smaller; the rest are random from 3 to 10^12, or to 10^18 for
    // one case in ten.
    let count = 300;
    let mut seed: i64 = 483;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for c in 0..count {
        let mut n: i64 = 0;
        if c % 3 != 2 {
            let k = 2 + next_random(mut seed) % 2000;
            let m = 3 + next_random(mut seed) % 6;
            n = 1;
            let mut term = 1;
            for _ in 1..m {
                if term > 1000000000000000000 / k {
                    break;
                }
                term *= k;
                n += term;
            }
        } else {
            let r = (next_random(mut seed) * 32768 + next_random(mut seed)) * 32768 + next_random(mut seed);
            if c % 30 == 29 {
                n = 3 + (r * 32768 + next_random(mut seed)) % 999999999999999998;
            } else {
                n = 3 + r % 999999999998;
            }
        }
        let base = i64.parse(smallest_good_base(f"{n}")).unwrap();
        total += base % 1000000007;
        checksum = (checksum * 31 + base % 1000000007 + n % 1000) % 1000000007;
    }
    println(f"{count} random cases: bases add up to {total} (mod 10^9 + 7 each), checksum {checksum}");
}
