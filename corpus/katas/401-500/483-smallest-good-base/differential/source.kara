// Differential test for LeetCode #483: Smallest Good Base.
//
// Copies of the four arms, on every n from 3 to 1,000 and on 1,000
// random values: one in three from 3 to 5,000, one in three built as 3
// to 12 1s in a random base, and one in three random up to 10^12 (to
// 10^18 one time in forty). Properties:
//   P1  n is all 1s in the base returned, which is from 2 to n - 1
//   P2  for n up to 5,000, it is the smallest such base, found by trying
//       every base from 2 up
//   P3  for n built as three or more 1s in base k, the base returned is
//       at most k

// ---- star: smallest_good_base.kara

fn is_ones_star(n: i64, k: i64, m: i64) -> bool {
    let mut sum = 1;
    let mut term = 1;
    for _ in 1..m {
        if term > (n - sum) / k {
            return false;
        }
        term *= k;
        sum += term;
    }
    sum == n
}

fn smallest_good_base_star(n: String) -> String {
    let value = i64.parse(n).unwrap();
    let mut m = 63;
    while m >= 3 {
        let root = (value as f64).pow(1.0 / (m - 1) as f64) as i64;
        for k in root..root + 2 {
            if k >= 2 and is_ones_star(value, k, m) {
                return f"{k}";
            }
        }
        m -= 1;
    }
    f"{value - 1}"
}

// ---- binary: smallest_good_base_binary.kara

fn ones_sum_binary(k: i64, m: i64) -> Option[i64] {
    let mut sum: i64 = 1;
    let mut term: i64 = 1;
    for _ in 1..m {
        term = term.checked_mul(k)?;
        sum = sum.checked_add(term)?;
    }
    Some(sum)
}

fn smallest_good_base_binary(n: String) -> String {
    let value = i64.parse(n).unwrap();
    for m in (3..63).rev() {
        let mut low = 2;
        let mut high = value - 1;
        while low <= high {
            let mid = low + (high - low) / 2;
            match ones_sum_binary(mid, m) {
                Some(sum) if sum == value => return f"{mid}",
                Some(sum) if sum < value => low = mid + 1,
                _ => high = mid - 1,
            }
        }
    }
    f"{value - 1}"
}

// ---- newton: smallest_good_base_newton.kara

fn integer_root_newton(n: i64, d: i64) -> i64 {
    // 2^(bits / d + 1) is above the root.
    let mut bits = 0;
    let mut rest = n;
    while rest > 0 {
        bits += 1;
        rest /= 2;
    }
    let mut x: i64 = 1;
    for _ in 0..bits / d + 1 {
        x *= 2;
    }
    loop {
        // n / x^(d-1), dividing step by step so no power is formed.
        let mut quotient = n;
        for _ in 1..d {
            quotient /= x;
        }
        let next = ((d - 1) * x + quotient) / d;
        if next >= x {
            return x;
        }
        x = next;
    }
}

fn is_ones_newton(n: i64, k: i64, m: i64) -> bool {
    let mut rest = n;
    let mut digits = 0;
    while rest > 0 {
        if rest % k != 1 {
            return false;
        }
        rest /= k;
        digits += 1;
    }
    digits == m
}

fn smallest_good_base_newton(n: String) -> String {
    let value = i64.parse(n).unwrap();
    let mut m = 62;
    while m >= 3 {
        let k = integer_root_newton(value, m - 1);
        if k >= 2 and is_ones_newton(value, k, m) {
            return f"{k}";
        }
        m -= 1;
    }
    f"{value - 1}"
}

// ---- scan: smallest_good_base_scan.kara

fn all_ones_scan(n: i64, k: i64) -> bool {
    let mut rest = n;
    while rest > 0 {
        if rest % k != 1 {
            return false;
        }
        rest /= k;
    }
    true
}

fn smallest_good_base_scan(n: String) -> String {
    let value = i64.parse(n).unwrap();
    let mut k = 2;
    while k * k * k < value {
        if all_ones_scan(value, k) {
            return f"{k}";
        }
        k += 1;
    }
    // k^2 < k^2 + k + 1 < (k + 1)^2, so three 1s can only be in base
    // isqrt(n): the float square root, fixed up to be exact.
    let mut root = (value as f64).sqrt() as i64;
    while root * root > value {
        root -= 1;
    }
    while (root + 1) * (root + 1) <= value {
        root += 1;
    }
    if root >= 2 and root * root + root + 1 == value {
        return f"{root}";
    }
    f"{value - 1}"
}

// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, n: String) -> String {
    match which {
        0 => smallest_good_base_star(n),
        1 => smallest_good_base_binary(n),
        2 => smallest_good_base_newton(n),
        _ => smallest_good_base_scan(n),
    }
}

// Whether every digit of n in base b is 1.
fn ones_in(n: i64, b: i64) -> bool {
    let mut rest = n;
    while rest > 0 {
        if rest % b != 1 {
            return false;
        }
        rest /= b;
    }
    true
}

fn main() {
    let names = vec!["star", "binary", "newton", "scan"];
    let cases = 1000;
    let mut seed: i64 = 4830;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0];
    // The random cases, then every n from 3 to 1,000.
    for c in 0..cases + 998 {
        // One case in three a small n (3 to 5,000), one in three m 1s in
        // a random base k (m from 3 to 12, k from 2 to 2,000, or to
        // 1,000,000 one time in twenty, the value at most 10^18), and one
        // in three a random n to 10^12 (to 10^18 one time in forty).
        let mut n: i64 = 0;
        let mut built = 0;
        if c >= cases {
            n = c - cases + 3;
        } else if c % 3 == 0 {
            n = 3 + next_random(mut seed) % 4998;
        } else if c % 3 == 1 {
            let mut k = 2 + next_random(mut seed) % 1999;
            if c % 60 == 1 {
                k = 2 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 999999;
            }
            let m = 3 + next_random(mut seed) % 10;
            n = 1;
            let mut term = 1;
            for _ in 1..m {
                if term > (1000000000000000000 - n) / k {
                    break;
                }
                term *= k;
                n += term;
            }
            if n > k + 1 {
                built = k;
            }
        } else {
            let r = (next_random(mut seed) * 32768 + next_random(mut seed)) * 32768 + next_random(mut seed);
            if c % 120 == 119 {
                n = 3 + (r * 32768 + next_random(mut seed)) % 999999999999999998;
            } else {
                n = 3 + r % 999999999998;
            }
        }
        // The smallest base by trying every one, for the small n.
        let mut smallest = 0;
        if n <= 5000 {
            smallest = 2;
            while not ones_in(n, smallest) {
                smallest += 1;
            }
        }
        for which in 0..4 {
            let base = i64.parse(arm(which, f"{n}")).unwrap();
            // P1: n is all 1s in that base, a base from 2 to n - 1.
            checks += 1;
            if base < 2 or base > n - 1 or not ones_in(n, base) {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: n = {n} gave base {base}");
                }
            }
            // P2: for n up to 5,000, no smaller base works.
            if smallest > 0 {
                checks += 1;
                if base != smallest {
                    failures += 1;
                    by_property[1] += 1;
                    if failures <= 5 {
                        println(f"P2 {names[which]}: n = {n} gave base {base}, want {smallest}");
                    }
                }
            }
            // P3: n built as three or more 1s in base k has a base at most k.
            if built > 0 {
                checks += 1;
                if base > built {
                    failures += 1;
                    by_property[2] += 1;
                    if failures <= 5 {
                        println(f"P3 {names[which]}: n = {n}, 1s in base {built}, gave base {base}");
                    }
                }
            }
        }
    }
    println(f"n = 3 to 1000 and {cases} random cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}");
    }
}
