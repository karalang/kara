// LeetCode #476: Number Complement -- through the binary text.
//
// Format the number in base 2, which has no leading zeros, swap every
// `0` and `1`, and read the result back in base 2. O(bits), with two
// strings.

fn find_complement(num: i64) -> i64 {
    let flipped: String = f"{num:b}".chars().map(|c| if c == '0' { '1' } else { '0' }).collect();
    i64.from_str_radix(flipped, 2).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn show(num: i64) {
    println(f"{num} ({num:b}) -> {find_complement(num)}");
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    show(5);
    show(1);
    show(2);
    show(7);
    show(8);
    show(10);
    show(1023);
    show(1024);
    show(2147483647);
    show(1073741824);
    show(1431655765);
    // 1,000 random numbers, of 1 to 31 bits.
    let count = 1000;
    let mut seed: i64 = 476;
    let mut checksum: i64 = 0;
    let mut zeros = 0;
    for _ in 0..count {
        let bits = 1 + next_random(mut seed) % 31;
        let num = (1 << (bits - 1)) | ((next_random(mut seed) * 32768 + next_random(mut seed)) % (1 << (bits - 1)));
        let got = find_complement(num);
        if got == 0 {
            zeros += 1;
        }
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"{count} random numbers: {zeros} complements are 0, checksum {checksum}");
}
