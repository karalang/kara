// LeetCode #414: Third Maximum Number -- three slots.
//
// Keep the three largest distinct values seen so far, largest first.
// A value equal to one already held changes nothing; a larger one goes
// in its place and pushes the smaller ones down a slot. If the third
// slot is filled at the end it is the answer, otherwise the first is.
// O(n) time, O(1) space.

fn third_max(nums: Vec[i64]) -> i64 {
    let mut first: Option[i64] = None;
    let mut second: Option[i64] = None;
    let mut third: Option[i64] = None;
    for x in nums {
        if first == Some(x) or second == Some(x) or third == Some(x) {
            continue;
        }
        match first {
            None => {
                first = Some(x);
                continue;
            }
            Some(a) => {
                if x > a {
                    third = second;
                    second = first;
                    first = Some(x);
                    continue;
                }
            }
        }
        match second {
            None => {
                second = Some(x);
                continue;
            }
            Some(b) => {
                if x > b {
                    third = second;
                    second = Some(x);
                    continue;
                }
            }
        }
        match third {
            None => third = Some(x),
            Some(c) => {
                if x > c {
                    third = Some(x);
                }
            }
        }
    }
    match third {
        Some(c) => c,
        None => first.unwrap(),
    }
}

// ---- bench ----------------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A value across the i32 range, from two steps of the LCG.
fn value(seed: mut ref i64) -> i64 {
    let high = step(mut seed);
    let low = step(mut seed);
    high * 131072 + low * 4 - 2147483648
}

fn main() {
    let n = 10000;
    let rounds = 50000;
    let mut seed: i64 = 414;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(value(mut seed));
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        nums[r * 7919 % n] = value(mut seed);
        let answer = third_max(nums);
        total += answer;
        checksum = (checksum * 31 + answer % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"{rounds} rounds on {n} numbers: total {total}, checksum {checksum}");
}
