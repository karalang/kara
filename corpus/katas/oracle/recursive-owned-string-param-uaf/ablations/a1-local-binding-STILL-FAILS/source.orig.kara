// REPRO — recursive fn + owned `String` param sourced from a map-derived
// `Vec[String]` element ⇒ use-after-free under codegen (`karac build` AND the
// LLJIT `karac run`), while the tree-walk interpreter is CORRECT.
//
// Expected (interpreter, and the algorithm's true answer):
//     route.len=6
//       [0]=SFO  [1]=ATL  [2]=SFO  [3]=JFK  [4]=ATL  [5]=JFK
//
// Observed under `karac build`: indices 1..4 are GARBAGE bytes (freed String
// buffers), e.g. `[1]=Rq\xef\xbf\xbd`. Under `karac run` (LLJIT) the runtime
// aborts inside `karac_string_clone` with a `ptr::copy_nonoverlapping`
// unaligned/null precondition violation.
//
// Shape that triggers it (all four ingredients are required — each was ablated
// and passes on its own): (1) a RECURSIVE function, (2) an OWNED `String`
// parameter, (3) whose argument is an ELEMENT of a `Vec[String]` obtained from
// a `Map[String, Vec[String]]`, and (4) the parameter is USED AFTER the
// recursive descent (`route.push(airport)` sits below the loop).
//
// See kara ledger B-2026-07-25-1.

fn visit(
    adj: mut ref Map[String, Vec[String]],
    cursor: mut ref Map[String, i64],
    airport: String,
    route: mut ref Vec[String],
) {
    while true {
        let dests: Vec[String] = match adj.get(airport) { Some(d) => d, None => Vec.new() };
        let used = match cursor.get(airport) { Some(u) => u, None => 0 };
        if used >= dests.len() { break; }
        let _ = cursor.insert(airport, used + 1);
        let next = dests[used].clone();
        visit(adj, cursor, next, route);
    }
    route.push(airport);
}

fn main() {
    let mut adj: Map[String, Vec[String]] = Map.new();
    let mut a: Vec[String] = Vec.new();
    a.push("ATL"); a.push("SFO");
    let _ = adj.insert("JFK", a);
    let mut b: Vec[String] = Vec.new();
    b.push("JFK"); b.push("SFO");
    let _ = adj.insert("ATL", b);
    let mut c: Vec[String] = Vec.new();
    c.push("ATL");
    let _ = adj.insert("SFO", c);

    let mut cursor: Map[String, i64] = Map.new();
    let mut route: Vec[String] = Vec.new();
    visit(mut adj, mut cursor, "JFK", mut route);
    println(f"route.len={route.len()}");
    let mut i = 0;
    while i < route.len() { println(f"  [{i}]={route[i]}"); i = i + 1; }
}
