// LeetCode #1105: Filling Bookcase Shelves -- a differential over the
// six arms. Each answer is checked against the statement read
// literally and against five properties that do not compute the answer;
// see the README.

// ---- min_height_shelves.kara ----

fn a0_min_height_shelves(books: Vec[Vec[i64]], shelf_width: i64) -> i64 {
    let n = books.len();
    let mut best: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 1..n + 1 {
        let mut width = 0;
        let mut tallest = 0;
        best[i] = i64.MAX;
        let mut j = i;
        while j > 0 and width + books[j - 1][0] <= shelf_width {
            width += books[j - 1][0];
            tallest = tallest.max(books[j - 1][1]);
            best[i] = best[i].min(best[j - 1] + tallest);
            j -= 1;
        }
    }
    best[n]
}

// ---- min_height_shelves_memo.kara ----

fn a1_least(books: Vec[Vec[i64]], width: i64, i: i64, memo: mut ref Vec[Option[i64]]) -> i64 {
    if i == books.len() {
        return 0;
    }
    if let Some(h) = memo[i] {
        return h;
    }
    let mut best = i64.MAX;
    let mut (used, tallest) = (0, 0);
    for j in i..books.len() {
        used += books[j][0];
        if used > width {
            break;
        }
        tallest = tallest.max(books[j][1]);
        best = best.min(tallest + a1_least(books, width, j + 1, mut memo));
    }
    memo[i] = Some(best);
    best
}

fn a1_min_height_shelves(books: Vec[Vec[i64]], shelf_width: i64) -> i64 {
    let mut memo = Vec.filled(books.len(), None);
    a1_least(books, shelf_width, 0, mut memo)
}

// ---- min_height_shelves_heap.kara ----

fn a2_min_height_shelves(books: Vec[Vec[i64]], shelf_width: i64) -> i64 {
    let n = books.len();
    let mut dist = Vec.filled(n + 1, i64.MAX);
    let mut heap = PriorityQueue.new();
    dist[0] = 0;
    heap.push((0, 0));
    while let Some((d, i)) = heap.pop() {
        if d > dist[i] {
            continue;
        }
        if i == n {
            return d;
        }
        let mut (used, tallest) = (0, 0);
        for j in i..n {
            used += books[j][0];
            if used > shelf_width {
                break;
            }
            tallest = tallest.max(books[j][1]);
            if d + tallest < dist[j + 1] {
                dist[j + 1] = d + tallest;
                heap.push((d + tallest, j + 1));
            }
        }
    }
    dist[n]
}

// ---- min_height_shelves_back.kara ----

fn a3_min_height_shelves(books: Vec[Vec[i64]], shelf_width: i64) -> i64 {
    let n = books.len();
    let mut best = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        let mut used = 0;
        best[i] = (i..n)
            .take_while(|j| {
                used += books[j][0];
                used <= shelf_width
            })
            .fold((i64.MAX, 0), |(low, tallest), j| {
                let tallest = tallest.max(books[j][1]);
                (low.min(tallest + best[j + 1]), tallest)
            })
            .0;
    }
    best[0]
}

// ---- min_height_shelves_rows.kara ----

fn a4_min_height_shelves(books: Vec[Vec[i64]], shelf_width: i64) -> i64 {
    let mut states: Map[i64, (i64, i64)] = Map.new();
    states.insert(books[0][0], (0, books[0][1]));
    for b in books.iter().skip(1) {
        let (t, h) = (b[0], b[1]);
        let opened = states.values().map(|(above, top)| above + top).min().unwrap();
        let mut next: Map[i64, (i64, i64)] = Map.new();
        next.insert(t, (opened, h));
        for (w, (above, top)) in states.iter() {
            if w + t <= shelf_width {
                next.insert(w + t, (above, top.max(h)));
            }
        }
        states = next;
    }
    states.values().map(|(above, top)| above + top).min().unwrap()
}

// ---- min_height_shelves_solution.kara ----

struct A5Solution {}

impl A5Solution {
    pub fn a5_min_height_shelves(books: Vec[Vec[i32]], shelf_width: i32) -> i32 {
        let n = books.len();
        let mut dp = Vec.filled(n + 1, i32.MAX);
        dp[0] = 0;
        for i in 1..=n {
            let mut (w, h) = (0, 0i32);
            for j in (1..=i).rev() {
                w += books[j - 1][0];
                if w > shelf_width {
                    break;
                }
                h = h.max(books[j - 1][1]);
                dp[i] = dp[i].min(dp[j - 1] + h);
            }
        }
        dp[n]
    }
}

fn a5_min_height_shelves(books: Vec[Vec[i64]], shelf_width: i64) -> i64 {
    let books: Vec[Vec[i32]] = books.iter().map(|b| b.iter().map(|x| x as i32).collect()).collect();
    A5Solution.a5_min_height_shelves(books, shelf_width as i32) as i64
}

// ---- the differential -----------------------------------------------------

fn arm(which: i64, books: Vec[Vec[i64]], width: i64) -> i64 {
    match which {
        0 => a0_min_height_shelves(books, width),
        1 => a1_min_height_shelves(books, width),
        2 => a2_min_height_shelves(books, width),
        3 => a3_min_height_shelves(books, width),
        4 => a4_min_height_shelves(books, width),
        _ => a5_min_height_shelves(books, width),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The statement read literally: every way to cut the row of books into
// shelves, a cut or none after each book but the last; the ways whose
// every shelf fits, and the least sum of their shelves' tallest books.
fn literal(books: Vec[Vec[i64]], width: i64) -> i64 {
    let n = books.len();
    let mut best = i64.MAX;
    for cuts in 0..(1 << (n - 1)) {
        let mut (used, tallest, height, fits) = (0, 0, 0, true);
        for i in 0..n {
            used += books[i][0];
            tallest = tallest.max(books[i][1]);
            if used > width {
                fits = false;
            }
            if i == n - 1 or (cuts >> i) & 1 == 1 {
                height += tallest;
                used = 0;
                tallest = 0;
            }
        }
        if fits {
            best = best.min(height);
        }
    }
    best
}

// The shelves filled one after another, each as far as the next book
// fits: one way to place the books, so never better than the least.
fn greedy(books: Vec[Vec[i64]], width: i64) -> i64 {
    let mut (used, tallest, height) = (0, 0, 0);
    for b in books.iter() {
        if used + b[0] > width {
            height += tallest;
            used = 0;
            tallest = 0;
        }
        used += b[0];
        tallest = tallest.max(b[1]);
    }
    height + tallest
}

// The least height of some of the books, none for no books.
fn part(w: i64, books: Vec[Vec[i64]], width: i64) -> i64 {
    if books.is_empty() { 0 } else { arm(w, books, width) }
}

struct Problem {
    books: Vec[Vec[i64]],
    width: i64,
    cut: i64,
    wall: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, p: Problem) {
    let books = p.books.clone();
    let width = p.width;
    let n = books.len();
    let want = literal(books.clone(), width);
    let tallest = books.iter().map(|b| b[1]).max().unwrap();
    let thick = books.iter().map(|b| b[0]).sum();
    let reversed: Vec[Vec[i64]] = books.iter().rev().map(|b| b.clone()).collect();
    let taller: Vec[Vec[i64]] = books.iter().map(|b| [b[0], 3 * b[1]].to_vec()).collect();
    let thicker: Vec[Vec[i64]] = books.iter().map(|b| [2 * b[0], b[1]].to_vec()).collect();
    let k = p.cut % n;
    let before: Vec[Vec[i64]] = books[0..k].to_vec();
    let after: Vec[Vec[i64]] = books[k..n].to_vec();
    let mut walled: Vec[Vec[i64]] = before.clone();
    walled.push([width, p.wall].to_vec());
    for b in after.iter() {
        walled.push(b.clone());
    }
    for w in 0..6 {
        let answer = arm(w, books.clone(), width);
        let what = f"arm {w}, {n} books on {width} -> {answer}";
        // P1: every way to cut the row
        expect(mut t, 1, answer == want, f"P1 {what}, the cuts give {want}");
        // P2: at least the tallest book, no more than the shelves filled
        // in turn, and the tallest when all fit one shelf
        let ok = answer >= tallest and answer <= greedy(books.clone(), width) and (thick > width or answer == tallest);
        expect(mut t, 2, ok, f"P2 {what}, greedy {greedy(books.clone(), width)}");
        // P3: the row reversed
        let r = arm(w, reversed.clone(), width);
        expect(mut t, 3, r == answer, f"P3 {what}, reversed -> {r}");
        // P4: heights tripled triple it; thicknesses and the shelf doubled
        // leave it
        let a = arm(w, taller.clone(), width);
        let b = arm(w, thicker.clone(), 2 * width);
        expect(mut t, 4, a == 3 * answer and b == answer, f"P4 {what}, taller -> {a}, thicker -> {b}");
        // P5: a wider shelf never more, one book fewer never more
        let wider = arm(w, books.clone(), width + 1);
        let fewer = part(w, books[0..n - 1].to_vec(), width);
        expect(mut t, 5, wider <= answer and fewer <= answer, f"P5 {what}, wider -> {wider}, fewer -> {fewer}");
        // P6: the row cut in two never better than the whole; a book as
        // wide as the shelf put at the cut is a shelf of its own
        let split = part(w, before.clone(), width) + part(w, after.clone(), width);
        let walls = arm(w, walled.clone(), width);
        expect(mut t, 6, answer <= split and walls == split + p.wall, f"P6 {what}, cut at {k} -> {split}, a wall there -> {walls}");
    }
    t.cases += 1;
    t.check = (t.check * 31 + want) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 problems in four kinds, 500 each: 1 to 10 books on a shelf 1
    // to 10 wide, heights to 10; 1 to 12 books 1 to 3 thick on a shelf 3
    // to 6 wide, heights to 3, so that many ways tie; 1 to 8 books on a
    // shelf that holds them all or nearly; and 2 to 10 books with one as
    // wide as the shelf among them. Every choice is drawn before any arm
    // answers.
    let mut seed = 11051;
    let mut problems: Vec[Problem] = [];
    for i in 0..2000 {
        let (n, width, thick, top) = match i % 4 {
            0 => {
                let width = next_random(mut seed) % 10 + 1;
                (next_random(mut seed) % 10 + 1, width, width, 10)
            }
            1 => (next_random(mut seed) % 12 + 1, next_random(mut seed) % 4 + 3, 3, 3),
            2 => (next_random(mut seed) % 8 + 1, 0, 5, 20),
            _ => (next_random(mut seed) % 9 + 2, next_random(mut seed) % 8 + 3, 4, 9),
        };
        let mut books: Vec[Vec[i64]] = (0..n).map(|_| [next_random(mut seed) % thick + 1, next_random(mut seed) % top + 1].to_vec()).collect();
        let mut width = width;
        if i % 4 == 2 {
            let sum: i64 = books.iter().map(|b| b[0]).sum();
            width = sum - next_random(mut seed) % 3;
            width = width.max(5);
        }
        for b in books.iter_mut() {
            b[0] = b[0].min(width);
        }
        if i % 4 == 3 {
            let at = next_random(mut seed) % n;
            books[at][0] = width;
        }
        let cut = next_random(mut seed);
        let wall = next_random(mut seed) % 10 + 1;
        problems.push(Problem { books, width, cut, wall });
    }
    for p in problems.iter() {
        check_case(mut t, p);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
