// LeetCode #1111: Maximum Nesting Depth of Two Valid Parentheses Strings
// -- the bench: the ★ arm over 16 random strings of 10^4 characters,
// LeetCode's longest, built once; each round answers a valid prefix of
// every string, a different one each time.

fn max_depth_after_split(seq: Str) -> Vec[i32] {
    let mut depth = 0;
    let mut answer: Vec[i32] = Vec.with_capacity(seq.len());
    for c in seq.chars() {
        if c == '(' {
            answer.push(depth % 2);
            depth += 1;
        } else {
            depth -= 1;
            answer.push(depth % 2);
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random valid string of `pairs` pairs, opening one time in two while
// it can, and the lengths of its prefixes that are valid too.
fn random_vps(seed: mut ref i64, pairs: i64) -> (String, Vec[i64]) {
    let mut out = String.new();
    let mut cuts: Vec[i64] = [];
    let mut opens = 0;
    let mut depth = 0;
    while opens < pairs or depth > 0 {
        if opens < pairs and (depth == 0 or next_random(mut seed) % 2 == 0) {
            out.push('(');
            opens += 1;
            depth += 1;
        } else {
            out.push(')');
            depth -= 1;
            if depth == 0 {
                cuts.push(out.len());
            }
        }
    }
    (out, cuts)
}

fn main() {
    let mut seed = 1111;
    let strings: Vec[(String, Vec[i64])] = (0..16).map(|_| random_vps(mut seed, 5000)).collect();
    let mut chars = 0;
    let mut ones = 0;
    let mut check = 0;
    for round in 0..1000 {
        for j in 0..strings.len() {
            let (s, cuts) = ref strings[j];
            let cut = cuts[(round * 7919 + j * 104729) % cuts.len()];
            let answer = max_depth_after_split(s[0..cut]);
            chars += cut;
            ones += answer.iter().sum();
            check = (check * 31 + answer[(round * 31 + j) % cut]) % 1000000007;
        }
    }
    println(f"1000 rounds over 16 strings of 10000 characters: {chars} characters, {ones} in the second group, checksum {check}");
}
