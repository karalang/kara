// LeetCode #1103: Distribute Candies to People -- the bench: the ★ arm
// over 64 problems of up to 10^9 candies among 1 to 1000 people, each
// round moving every problem's candies and handing them out again.

fn distribute_candies(candies: i64, num_people: i64) -> Vec[i64] {
    let mut people: Vec[i64] = Vec.filled(num_people, 0);
    let mut left = candies;
    let mut gift = 1;
    while left > 0 {
        let given = gift.min(left);
        people[(gift - 1) % num_people] += given;
        left -= given;
        gift += 1;
    }
    people
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1103;
    let mut problems: Vec[(i64, i64)] = [];
    for _ in 0..64 {
        let candies = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1;
        let n = next_random(mut seed) % 1000 + 1;
        problems.push((candies, n));
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..200 {
        for j in 0..problems.len() {
            let (candies, n) = problems[j];
            let candies = (candies + round * 7919 + j * 104729) % 1000000000 + 1;
            problems[j] = (candies, n);
            let people = distribute_candies(candies, n);
            total += people[0] + people[n - 1];
            for c in people.iter() {
                check = (check * 31 + c + 1) % 1000000007;
            }
        }
    }
    println(f"200 rounds over 64 problems of up to 10^9 candies: first and last people hold {total}, checksum {check}");
}
