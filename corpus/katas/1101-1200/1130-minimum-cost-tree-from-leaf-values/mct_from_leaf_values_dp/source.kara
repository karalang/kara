// LeetCode #1130: Minimum Cost Tree From Leaf Values -- interval dynamic
// programming: `cost[i][j]` the least cost of a tree over leaves `i..=j`,
// the least over every split `k` of the two sides' costs and the product
// of their largest leaves, the widths taken in increasing order. O(n^3)

fn mct_from_leaf_values(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut largest = Vec.filled(n, Vec.filled(n, 0));
    for i in 0..n {
        largest[i][i] = arr[i];
        for j in i + 1..n {
            largest[i][j] = largest[i][j - 1].max(arr[j]);
        }
    }
    let mut cost = Vec.filled(n, Vec.filled(n, 0));
    for width in 1..n {
        for i in 0..n - width {
            let j = i + width;
            let mut best = i64.MAX;
            for k in i..j {
                best = best.min(cost[i][k] + cost[k + 1][j] + largest[i][k] * largest[k + 1][j]);
            }
            cost[i][j] = best;
        }
    }
    cost[0][n - 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples and seven more: rising, falling, a valley,
    // all alike, peaks between ones, 1 to 15, and 40 of the largest
    let cases: Vec[Vec[i64]] = [
        [6, 2, 4],
        [4, 11],
        [1, 2, 3, 4],
        [4, 3, 2, 1],
        [3, 1, 2],
        [2, 2, 2, 2, 2],
        [1, 15, 1, 15, 1, 15],
        (1..16).collect(),
        Vec.filled(40, 15),
    ];
    for arr in cases.iter() {
        println(f"{arr} -> {mct_from_leaf_values(arr)}");
    }
    // 2000 random arrays of 2 to 40 leaves from 1 to 15: the costs summed
    // and a checksum
    let mut seed = 1130;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 39 + 2;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 15 + 1).collect();
        let c = mct_from_leaf_values(arr);
        total += c;
        check = (check * 31 + c) % 1000000007;
    }
    println(f"2000 random arrays: costs total {total}, checksum {check}");
    // LeetCode's largest: 40 leaves at random, and 40 rising and falling
    let big: Vec[i64] = (0..40).map(|_| next_random(mut seed) % 15 + 1).collect();
    println(f"40 random leaves: {mct_from_leaf_values(big)}");
    let wave: Vec[i64] = (0..40).map(|i| (20 - i).abs() % 15 + 1).collect();
    println(f"40 leaves rising and falling: {mct_from_leaf_values(wave)}");
}
