// LeetCode #1182: Shortest Distance to Target Color -- the ★ arm: for each
// colour, a table of the distance from every index to its nearest index of
// that colour, filled by a sweep from the left and then one from the right;
// each query is one lookup. O(n + q) time, O(n) space.

fn shortest_distance_color(colors: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let n = colors.len();
    let far = n + 1;
    let mut nearest: Vec[Vec[i64]] = Vec.new();
    for c in 1..=3 {
        let mut dist = Vec.filled(n, far);
        let mut last = -1;
        for i in 0..n {
            if colors[i] == c {
                last = i;
            }
            if last >= 0 {
                dist[i] = i - last;
            }
        }
        last = -1;
        for i in (0..n).rev() {
            if colors[i] == c {
                last = i;
            }
            if last >= 0 and last - i < dist[i] {
                dist[i] = last - i;
            }
        }
        nearest.push(dist);
    }
    let mut answer = Vec.new();
    for q in queries.iter() {
        let d = nearest[q[1] - 1][q[0]];
        answer.push(if d == far { -1 } else { d });
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"example 1: {shortest_distance_color([1, 1, 2, 1, 3, 2, 2, 3, 3], [[1, 3], [2, 2], [6, 1]])}");
    println(f"example 2: {shortest_distance_color([1, 2], [[0, 3]])}");
    println(f"small 1: {shortest_distance_color([2], [[0, 1], [0, 2], [0, 3]])}");
    println(f"small 2: {shortest_distance_color([3, 3, 3, 1], [[0, 1], [3, 3], [1, 2]])}");
    println(f"small 3: {shortest_distance_color([1, 2, 2, 2, 2, 2, 3], [[3, 1], [3, 3], [4, 3], [2, 1]])}");
    let mut seed: i64 = 1182;
    let mut checksum: i64 = 0;
    for t in 0..2000 {
        let n = 1 + next_random(mut seed) % 15;
        let palette = 1 + next_random(mut seed) % 3;
        let colors: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % palette).collect();
        let queries: Vec[Vec[i64]] = (0..5).map(|_| [next_random(mut seed) % n, 1 + next_random(mut seed) % 3]).collect();
        for d in shortest_distance_color(colors, queries) {
            checksum = (checksum * 31 + d + 2 + t) % 1000000007;
        }
    }
    println(f"2000 random arrays: checksum {checksum}");
    let colors: Vec[i64] = (0..50000).map(|i| if i % 9973 == 0 { 3 } else { 1 + next_random(mut seed) % 2 }).collect();
    let queries: Vec[Vec[i64]] = (0..50000).map(|_| [next_random(mut seed) % 50000, 1 + next_random(mut seed) % 3]).collect();
    let mut total = 0;
    for d in shortest_distance_color(colors, queries) {
        total += d;
    }
    println(f"50000 colours, 50000 queries: {total}");
}
