// LeetCode #1182: Shortest Distance to Target Color -- another Rust
// solution, in iterator chains: a scan from the left keeping the last index
// of each colour, one from the right keeping the next, and each query a
// match on the two Options; carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn shortest_distance_color(colors: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[i32] {
        let left: Vec[Array[Option[i64], 4]] = colors
            .iter()
            .enumerate()
            .scan([None; 4], |last, (i, c)| { let mut last = last; last[c] = Some(i); Some((last.clone(), last)) })
            .collect();
        let mut right: Vec[Array[Option[i64], 4]] = colors
            .iter()
            .enumerate()
            .rev()
            .scan([None; 4], |next, (i, c)| { let mut next = next; next[c] = Some(i); Some((next.clone(), next)) })
            .collect();
        right.reverse();
        queries
            .iter()
            .map(|q| {
                let (i, c) = (q[0] as i64, q[1] as i64);
                let before = left[i][c].map(|j| i - j);
                let after = right[i][c].map(|j| j - i);
                match (before, after) {
                    (Some(x), Some(y)) => x.min(y) as i32,
                    (Some(x), None) | (None, Some(x)) => x as i32,
                    (None, None) => -1,
                }
            })
            .collect()
    }
}

fn shortest_distance_color(colors: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let colors: Vec[i32] = colors.iter().map(|c| c as i32).collect();
    let queries: Vec[Vec[i32]] = queries.iter().map(|q| q.iter().map(|x| x as i32).collect()).collect();
    Solution.shortest_distance_color(colors, queries).iter().map(|d| d as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"example 1: {shortest_distance_color([1, 1, 2, 1, 3, 2, 2, 3, 3], [[1, 3], [2, 2], [6, 1]])}");
    println(f"example 2: {shortest_distance_color([1, 2], [[0, 3]])}");
    println(f"small 1: {shortest_distance_color([2], [[0, 1], [0, 2], [0, 3]])}");
    println(f"small 2: {shortest_distance_color([3, 3, 3, 1], [[0, 1], [3, 3], [1, 2]])}");
    println(f"small 3: {shortest_distance_color([1, 2, 2, 2, 2, 2, 3], [[3, 1], [3, 3], [4, 3], [2, 1]])}");
    let mut seed: i64 = 1182;
    let mut checksum: i64 = 0;
    for t in 0..2000 {
        let n = 1 + next_random(mut seed) % 15;
        let palette = 1 + next_random(mut seed) % 3;
        let colors: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % palette).collect();
        let queries: Vec[Vec[i64]] = (0..5).map(|_| [next_random(mut seed) % n, 1 + next_random(mut seed) % 3]).collect();
        for d in shortest_distance_color(colors, queries) {
            checksum = (checksum * 31 + d + 2 + t) % 1000000007;
        }
    }
    println(f"2000 random arrays: checksum {checksum}");
    let colors: Vec[i64] = (0..50000).map(|i| if i % 9973 == 0 { 3 } else { 1 + next_random(mut seed) % 2 }).collect();
    let queries: Vec[Vec[i64]] = (0..50000).map(|_| [next_random(mut seed) % 50000, 1 + next_random(mut seed) % 3]).collect();
    let mut total = 0;
    for d in shortest_distance_color(colors, queries) {
        total += d;
    }
    println(f"50000 colours, 50000 queries: {total}");
}
