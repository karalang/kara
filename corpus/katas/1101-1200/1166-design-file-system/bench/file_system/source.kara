// LeetCode #1166: Design File System -- the ★ arm, one map: every path
// made is a key of a `Map[String, i64]`; a path may be made when it is new
// and the text before its last `/` is a path already made, or empty. O(L)
// a call for a path of length L.

struct FileSystem {
    paths: Map[String, i64],
}

impl FileSystem {
    fn new() -> FileSystem {
        FileSystem { paths: Map.new() }
    }

    fn create_path(mut ref self, path: Str, value: i64) -> bool {
        if path.len() == 0 or path == "/" or self.paths.contains_key(path) {
            return false;
        }
        let parent = path[0..path.rfind("/").unwrap()];
        if parent.len() > 0 and not self.paths.contains_key(parent) {
            return false;
        }
        self.paths.insert(path.to_string(), value);
        true
    }

    fn get(self, path: Str) -> i64 {
        match self.paths.get(path) {
            Some(v) => v,
            None => -1,
        }
    }
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 16 lists of 10^4 operations, the constraints' most, over paths of 1 to
    // 5 names from 6, three in four of them creates, built once; each of 100
    // rounds runs every list on a new file system from a random place in
    // its first half.
    let names = ["a", "b", "ab", "le", "leet", "code"];
    let mut seed = 1166;
    let mut paths: Vec[Vec[String]] = [];
    let mut creates: Vec[Vec[bool]] = [];
    for _ in 0..16 {
        let mut ps: Vec[String] = [];
        let mut cs: Vec[bool] = [];
        for _ in 0..10000 {
            let parts = 1 + next_random(mut seed) % 5;
            let mut p = String.new();
            for _ in 0..parts {
                p = p + "/" + names[next_random(mut seed) % 6];
            }
            ps.push(p);
            cs.push(next_random(mut seed) % 4 != 0);
        }
        paths.push(ps);
        creates.push(cs);
    }
    let mut made = 0;
    let mut check = 0;
    for _ in 0..100 {
        for k in 0..16 {
            let from = next_random(mut seed) % 5000;
            let mut fs = FileSystem.new();
            for i in from..10000 {
                let a = if creates[k][i] {
                    if fs.create_path(paths[k][i], i) { 1 } else { 0 }
                } else {
                    fs.get(paths[k][i])
                };
                if creates[k][i] {
                    made += a;
                }
                check = (check * 31 + a + 2) % 1000000007;
            }
        }
    }
    println(f"100 rounds over 16 lists of 10^4 operations: made {made}, checksum {check}");
}
