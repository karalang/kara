// LeetCode #1198: Find Smallest Common Element in All Rows -- another Rust
// solution, in one iterator chain: the first value of the first row that
// every row finds by `binary_search`, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn smallest_common_element(mat: Vec[Vec[i32]]) -> i32 {
        mat[0]
            .iter()
            .find(|v| mat.iter().all(|row| row.binary_search(v).is_some()))
            .cloned()
            .unwrap_or(-1)
    }
}

fn smallest_common_element(mat: Vec[Vec[i64]]) -> i64 {
    Solution.smallest_common_element(mat.iter().map(|row| row.iter().map(|v| v as i32).collect()).collect())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A strictly increasing row of `n` values from 1 to `high`, each kept
// with probability about n / high, then made up to `n` from the top.
fn random_row(seed: mut ref i64, n: i64, high: i64) -> Vec[i64] {
    let mut row = Vec.new();
    let mut v = 0;
    while row.len() < n {
        v += 1 + next_random(mut seed) % (2 * high / n);
        if v > high - (n - row.len()) + 1 {
            v = high - (n - row.len()) + 1;
        }
        row.push(v);
    }
    row
}

fn main() {
    let cases = [
        [[1, 2, 3, 4, 5], [2, 4, 5, 8, 10], [3, 5, 7, 9, 11], [1, 3, 5, 7, 9]],
        [[1, 2, 3], [2, 3, 4], [2, 3, 5]],
        [[1, 2, 3], [4, 5, 6]],
        [[7]],
        [[1, 10000], [10000]],
        [[1, 3, 5], [2, 3, 5], [3, 4, 5]],
    ];
    for c in cases.iter() {
        println(f"{c}: {smallest_common_element(c)}");
    }
    let one_row: Vec[Vec[i64]] = [(1..=500).collect()];
    println(f"one row of 500: {smallest_common_element(one_row)}");
    let mut seed = 1198;
    let mut found = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 12 + 1;
        let high = n + next_random(mut seed) % 30;
        let mat: Vec[Vec[i64]] = (0..m).map(|_| random_row(mut seed, n, high)).collect();
        let v = smallest_common_element(mat);
        if v >= 0 {
            found += 1;
        }
        check = (check * 131 + v + 2) % 1000000007;
    }
    println(f"1000 random matrices: {found} with a common element, checksum {check}");
    let big: Vec[Vec[i64]] = (0..500).map(|_| random_row(mut seed, 500, 10000)).collect();
    println(f"500 rows of 500 from 1 to 10000: {smallest_common_element(big)}");
    let dense: Vec[Vec[i64]] = (0..500).map(|_| random_row(mut seed, 500, 520)).collect();
    println(f"500 rows of 500 from 1 to 520: {smallest_common_element(dense)}");
}
