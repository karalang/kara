// LeetCode #1198 bench: the ★ arm (a count of each value over the whole
// matrix, then the first value of the first row counted in every row) on
// 20 matrices of 500 x 500, the constraints' most, built once, with rows
// of values from 1 to 520, 1000, 5000 and 10000 in turn; then 100 rounds
// over the matrices, each answer folded into a checksum.

fn smallest_common_element(mat: Vec[Vec[i64]]) -> i64 {
    let mut count = [0; 10001];
    for row in mat.iter() {
        for v in row.iter() {
            count[v] += 1;
        }
    }
    for v in mat[0].iter() {
        if count[v] == mat.len() {
            return v;
        }
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_row(seed: mut ref i64, n: i64, high: i64) -> Vec[i64] {
    let mut row = Vec.new();
    let mut v = 0;
    while row.len() < n {
        v += 1 + next_random(mut seed) % (2 * high / n);
        if v > high - (n - row.len()) + 1 {
            v = high - (n - row.len()) + 1;
        }
        row.push(v);
    }
    row
}

fn main() {
    let highs = [520, 1000, 5000, 10000];
    let mut seed = 1198;
    let mut mats: Vec[Vec[Vec[i64]]] = Vec.new();
    for k in 0..20 {
        let mat: Vec[Vec[i64]] = (0..500).map(|_| random_row(mut seed, 500, highs[k % 4])).collect();
        mats.push(mat);
    }
    let mut check = 0;
    for _ in 0..100 {
        for mat in mats.iter() {
            let v = smallest_common_element(mat);
            check = (check * 131 + v + 2) % 1000000007;
        }
    }
    println(f"100 rounds of 20 matrices of 500 x 500: checksum {check}");
}
