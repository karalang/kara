// LeetCode #1165: Single-Row Keyboard -- the ★ arm, a table: each letter's
// place on the keyboard in an array of 26, read once, then the finger's
// moves summed letter by letter from place 0. O(26 + n).

fn calculate_time(keyboard: Str, word: Str) -> i64 {
    let mut place = [0; 26];
    for (i, c) in keyboard.bytes().iter().enumerate() {
        place[(c - b'a')] = i;
    }
    let mut at = 0;
    let mut time = 0;
    for c in word.bytes().iter() {
        let next = place[(c - b'a')];
        time += (next - at).abs();
        at = next;
    }
    time
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 16 random keyboards, each with a word of 10^4 letters, the
    // constraints' most, built once; each of 5000 rounds types every word
    // from a random place in its first half.
    let mut seed = 1165;
    let mut keyboards: Vec[String] = [];
    let mut words: Vec[String] = [];
    for _ in 0..16 {
        let mut b: Vec[u8] = (0..26).map(|i| b'a' + i as u8).collect();
        for i in (1..26).rev() {
            let j = next_random(mut seed) % (i + 1);
            b.swap(i, j);
        }
        keyboards.push(String.from_utf8(b).unwrap());
        let w: Vec[u8] = (0..10000).map(|_| b'a' + (next_random(mut seed) % 26) as u8).collect();
        words.push(String.from_utf8(w).unwrap());
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..5000 {
        for k in 0..16 {
            let from = next_random(mut seed) % 5000;
            let t = calculate_time(keyboards[k], words[k][from..]);
            total += t;
            check = (check * 31 + t) % 1000000007;
        }
    }
    println(f"5000 rounds over 16 words of 10^4 letters: total {total}, checksum {check}");
}
