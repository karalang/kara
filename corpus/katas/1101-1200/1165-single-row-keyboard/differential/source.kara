// LeetCode #1165: Single-Row Keyboard -- a differential
// over the five arms. Each answer is checked against the statement read
// literally and against six properties that do not compute it; see the
// README.

// ---- calculate_time.kara ----

fn a0_calculate_time(keyboard: Str, word: Str) -> i64 {
    let mut place = [0; 26];
    for (i, c) in keyboard.bytes().iter().enumerate() {
        place[(c - b'a')] = i;
    }
    let mut at = 0;
    let mut time = 0;
    for c in word.bytes().iter() {
        let next = place[(c - b'a')];
        time += (next - at).abs();
        at = next;
    }
    time
}

// ---- calculate_time_find.kara ----

fn a1_calculate_time(keyboard: Str, word: Str) -> i64 {
    let mut at = 0;
    let mut time = 0;
    for c in word.chars() {
        let next = keyboard.find(c.to_string()).unwrap();
        time += (next - at).abs();
        at = next;
    }
    time
}

// ---- calculate_time_map.kara ----

fn a2_calculate_time(keyboard: Str, word: Str) -> i64 {
    let place: Map[char, i64] = keyboard.chars().enumerate().map(|(i, c)| (c, i)).collect();
    let (_, time) = word.chars().map(|c| place[c]).fold((0, 0), |(at, time), next| (next, time + (next - at).abs()));
    time
}

// ---- calculate_time_pairs.kara ----

fn a3_calculate_time(keyboard: Str, word: Str) -> i64 {
    let mut place = [0; 26];
    for (i, c) in keyboard.chars().enumerate() {
        place[c as i64 - 'a' as i64] = i;
    }
    let mut path: Vec[i64] = [0];
    for c in word.chars() {
        path.push(place[c as i64 - 'a' as i64]);
    }
    path.windows(2).into_iter().map(|w| (w[1] - w[0]).abs()).sum()
}

// ---- calculate_time_solution.kara ----

struct A4Solution {}

impl A4Solution {
    pub fn a4_calculate_time(keyboard: String, word: String) -> i32 {
        let mut pos = [0; 26];
        for (i, b) in keyboard.bytes().iter().enumerate() {
            pos[(b - b'a')] = i;
        }
        let mut prev = 0;
        let mut ans: i32 = 0;
        for b in word.bytes() {
            let cur = pos[(b - b'a')];
            ans += (cur as i32 - prev as i32).abs();
            prev = cur;
        }
        ans
    }
}

fn a4_calculate_time(keyboard: Str, word: Str) -> i64 {
    A4Solution.a4_calculate_time(keyboard.to_string(), word.to_string())
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(w: i64, keyboard: Str, word: Str) -> i64 {
    match w {
        0 => a0_calculate_time(keyboard, word),
        1 => a1_calculate_time(keyboard, word),
        2 => a2_calculate_time(keyboard, word),
        3 => a3_calculate_time(keyboard, word),
        _ => a4_calculate_time(keyboard, word),
    }
}

// The statement read literally: the finger starts at index 0, and each
// letter is found by walking the keyboard from its left end.
fn literal(keyboard: Str, word: Str) -> i64 {
    let keys: Vec[char] = keyboard.chars().collect();
    let mut at = 0;
    let mut time = 0;
    for c in word.chars() {
        let mut i = 0;
        while keys[i] != c {
            i += 1;
        }
        time += (i - at).abs();
        at = i;
    }
    time
}

fn place(keyboard: Str, c: char) -> i64 {
    keyboard.chars().position(|k| k == c).unwrap()
}

// A permutation of the 26 letters, drawn.
fn shuffled(seed: mut ref i64) -> Vec[u8] {
    let mut b: Vec[u8] = (0..26).map(|i| b'a' + i as u8).collect();
    for i in (1..26).rev() {
        let j = next_random(mut seed) % (i + 1);
        b.swap(i, j);
    }
    b
}

// A word of `len` letters over the first `k`.
fn word(seed: mut ref i64, len: i64, k: i64) -> String {
    String.from_utf8((0..len).map(|_| b'a' + (next_random(mut seed) % k) as u8).collect()).unwrap()
}

// Every letter of `s` renamed through `to`.
fn renamed(s: Str, to: Vec[u8]) -> String {
    String.from_utf8(s.bytes().iter().map(|b| to[b - b'a']).collect()).unwrap()
}

struct Case {
    keyboard: String,
    word: String,
    // P2's second word, P5's renaming
    tail: String,
    rename: Vec[u8],
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    let (k, w) = (ref c.keyboard, ref c.word);
    let want = literal(k, w);
    let first = place(k, w.chars().next().unwrap());
    let last = place(k, w.chars().last().unwrap());
    let tail_first = place(k, c.tail.chars().next().unwrap());
    let joined = w.to_string() + c.tail;
    let backward: String = k.chars().rev().collect();
    let doubled: String = w.chars().flat_map(|ch| [ch, ch].into_iter()).collect();
    let rk = renamed(k, c.rename);
    let rw = renamed(w, c.rename);
    let reversed: String = w.chars().rev().collect();
    for a in 0..5 {
        let got = arm(a, k, w);
        let what = f"arm {a}, case {t.cases} \"{k}\" \"{w}\" -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literally {want}");
        // P2: two words typed one after the other: the second's own start
        // from 0 becomes a move from the first's last letter
        let j = arm(a, k, joined);
        let tail = arm(a, k, c.tail);
        let j_want = got + tail - tail_first + (tail_first - last).abs();
        expect(mut t, 2, j == j_want, f"P2 {what}, then \"{c.tail}\": {j}, not {j_want}");
        // P3: the keyboard backward keeps every move but the first, which
        // goes to 25 less the first letter's place
        let b = arm(a, backward, w);
        let b_want = got - first + 25 - first;
        expect(mut t, 3, b == b_want, f"P3 {what}, backward: {b}, not {b_want}");
        // P4: every letter typed twice costs nothing more
        let d = arm(a, k, doubled);
        expect(mut t, 4, d == got, f"P4 {what}, doubled: {d}");
        // P5: the keyboard and the word renamed alike keep the time
        let r = arm(a, rk, rw);
        expect(mut t, 5, r == got, f"P5 {what}, renamed: {r}");
        // P6: the word backward keeps every move but the first
        let v = arm(a, k, reversed);
        let v_want = got - first + last;
        expect(mut t, 6, v == v_want, f"P6 {what}, reversed: {v}, not {v_want}");
    }
    t.cases += 1;
    t.check = (t.check * 31 + want) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 keyboards and words in four kinds, 500 each: words of 1 to 5
    // letters over 1 to 3, of 1 to 40 over 1 to 26, of 100 to 400 over 26,
    // and of 1 to 40 over 26 on the keyboard in order or backward; every
    // second word 1 to 10 letters over 26. Every choice the properties make
    // is drawn before any arm answers.
    let mut seed = 11651;
    let mut cases: Vec[Case] = [];
    for i in 0..2000 {
        let kind = i % 4;
        let keys = shuffled(mut seed);
        let keyboard = if kind == 3 {
            let az: String = (0..26).map(|i| (b'a' + i as u8) as char).collect();
            if next_random(mut seed) % 2 == 0 { az } else { az.chars().rev().collect() }
        } else {
            String.from_utf8(keys).unwrap()
        };
        let w = if kind == 0 {
            word(mut seed, 1 + next_random(mut seed) % 5, 1 + next_random(mut seed) % 3)
        } else if kind == 2 {
            word(mut seed, 100 + next_random(mut seed) % 301, 26)
        } else {
            word(mut seed, 1 + next_random(mut seed) % 40, if kind == 1 { 1 + next_random(mut seed) % 26 } else { 26 })
        };
        let tail = word(mut seed, 1 + next_random(mut seed) % 10, 26);
        let rename = shuffled(mut seed);
        cases.push(Case { keyboard, word: w, tail, rename });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} words: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
