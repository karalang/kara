// LeetCode #1165: Single-Row Keyboard -- a Rust solution as LeetCode's Rust
// users write it (`impl Solution`, `String` parameters, a `[usize; 26]`
// table filled from `keyboard.bytes().enumerate()`, `(b - b'a') as usize`
// indices, the moves as `i32` through `as i32` casts and `abs()`), carried
// to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn calculate_time(keyboard: String, word: String) -> i32 {
        let mut pos = [0; 26];
        for (i, b) in keyboard.bytes().iter().enumerate() {
            pos[b - b'a'] = i;
        }
        let mut prev = 0;
        let mut ans: i32 = 0;
        for b in word.bytes() {
            let cur = pos[b - b'a'];
            ans += (cur as i32 - prev as i32).abs();
            prev = cur;
        }
        ans
    }
}

fn calculate_time(keyboard: Str, word: Str) -> i64 {
    Solution.calculate_time(keyboard.to_string(), word.to_string())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The 26 letters in a random order.
fn random_keyboard(seed: mut ref i64) -> String {
    let mut b: Vec[u8] = (0..26).map(|i| b'a' + i as u8).collect();
    for i in (1..26).rev() {
        let j = next_random(mut seed) % (i + 1);
        b.swap(i, j);
    }
    String.from_utf8(b).unwrap()
}

// A word of `len` letters over the first `k`.
fn word(seed: mut ref i64, len: i64, k: i64) -> String {
    String.from_utf8((0..len).map(|_| b'a' + (next_random(mut seed) % k) as u8).collect()).unwrap()
}

fn main() {
    // LeetCode's examples and five more: one letter at the start, one at
    // the end; a letter repeated; the alphabet typed forward and back
    let az = "abcdefghijklmnopqrstuvwxyz";
    let cases = [
        (az.clone(), "cba"),
        ("pqrstuvwxyzabcdefghijklmno", "leetcode"),
        (az.clone(), "a"),
        (az.clone(), "z"),
        (az.clone(), "zzzz"),
        (az.clone(), az.clone()),
        ("zyxwvutsrqponmlkjihgfedcba", az.clone()),
    ];
    for (k, w) in cases.iter() {
        println(f"{k} {w} -> {calculate_time(k, w)}");
    }
    // 2000 random keyboards and words of 1 to 40 letters over the first 1
    // to 26
    let mut seed = 1165;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let keyboard = random_keyboard(mut seed);
        let k = 1 + next_random(mut seed) % 26;
        let w = word(mut seed, 1 + next_random(mut seed) % 40, k);
        let t = calculate_time(keyboard, w);
        total += t;
        check = (check * 31 + t) % 1000000007;
    }
    println(f"2000 random words: total {total}, checksum {check}");
    // 10^4 letters, the constraints' most
    let keyboard = random_keyboard(mut seed);
    println(f"10000 letters: {calculate_time(keyboard, word(mut seed, 10000, 26))}");
    println(f"10000 letters a and z: {calculate_time(az, "az".repeat(5000))}");
}
