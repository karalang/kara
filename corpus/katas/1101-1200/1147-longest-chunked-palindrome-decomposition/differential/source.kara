// LeetCode #1147: Longest Chunked Palindrome Decomposition -- a
// differential over the five arms. Each answer is checked against the
// statement read literally and against five properties that do not
// compute the answer; see the README.

// ---- longest_decomposition.kara ----

fn a0_longest_decomposition(text: Str) -> i64 {
    let mut i = 0;
    let mut j = text.len();
    let mut k = 0;
    while i < j {
        let mut size = 1;
        while 2 * size <= j - i and text[i..i + size] != text[j - size..j] {
            size += 1;
        }
        if 2 * size > j - i {
            return k + 1;
        }
        k += 2;
        i += size;
        j -= size;
    }
    k
}

// ---- longest_decomposition_recursive.kara ----

fn a1_longest_decomposition(text: Str) -> i64 {
    let n = text.len();
    for size in 1..n / 2 + 1 {
        if text.ends_with(text[..size]) {
            return 2 + a1_longest_decomposition(text[size..n - size]);
        }
    }
    if n == 0 { 0 } else { 1 }
}

// ---- longest_decomposition_hashed.kara ----

const A2_BASE: i64 = 131;
const A2_MODULUS: i64 = 1000000007;

fn a2_longest_decomposition(text: Str) -> i64 {
    let b: Vec[u8] = text.bytes().iter().collect();
    // the front chunk is b[start..start + size], the back b[end - size..end]
    let mut start = 0;
    let mut end = b.len();
    let mut size = 0;
    let mut front = 0;
    let mut back = 0;
    let mut power = 1;
    let mut k = 0;
    while 2 * (size + 1) <= end - start {
        size += 1;
        front = (front * A2_BASE + b[start + size - 1]) % A2_MODULUS;
        back = (b[end - size] * power + back) % A2_MODULUS;
        power = power * A2_BASE % A2_MODULUS;
        if front == back and b[start..start + size] == b[end - size..end] {
            k += 2;
            start += size;
            end -= size;
            size = 0;
            front = 0;
            back = 0;
            power = 1;
        }
    }
    if start < end { k + 1 } else { k }
}

// ---- longest_decomposition_table.kara ----

fn a3_longest_decomposition(text: Str) -> i64 {
    let b = text.bytes();
    let n = b.len();
    let mut run: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(n + 1, 0));
    for x in (0..n).rev() {
        for y in (0..n).rev() {
            if b[x] == b[y] {
                run[x][y] = run[x + 1][y + 1] + 1;
            }
        }
    }
    let half = n / 2;
    let mut best = Vec.filled(half + 1, 0);
    for i in (0..half + 1).rev() {
        let width = n - 2 * i;
        best[i] = if width == 0 { 0 } else { 1 };
        for size in 1..width / 2 + 1 {
            if run[i][n - i - size] >= size {
                best[i] = best[i].max(2 + best[i + size]);
            }
        }
    }
    best[0]
}

// ---- longest_decomposition_solution.kara ----

struct A4Solution {}

impl A4Solution {
    pub fn a4_longest_decomposition(text: String) -> i32 {
        let bytes = text.bytes();
        let n = bytes.len();
        let mut res = 0;
        let mut l = 0;
        for r in 0..n {
            if bytes[l..=r] == bytes[n - 1 - r..n - l] {
                res += 1;
                l = r + 1;
            }
        }
        res
    }
}

fn a4_longest_decomposition(text: Str) -> i64 {
    A4Solution.a4_longest_decomposition(text.to_string())
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, text: Str) -> i64 {
    match which {
        0 => a0_longest_decomposition(text),
        1 => a1_longest_decomposition(text),
        2 => a2_longest_decomposition(text),
        3 => a3_longest_decomposition(text),
        _ => a4_longest_decomposition(text),
    }
}

// The statement read literally: every way to cut the text into chunks,
// the most chunks of a way whose i-th chunk equals its i-th from the end.
fn literal(text: Str) -> i64 {
    let n = text.len();
    let mut best = 0;
    for cuts in 0..(1 << (n - 1)) {
        let mut chunks: Vec[Str] = [];
        let mut from = 0;
        for at in 1..n + 1 {
            if at == n or (cuts >> (at - 1)) & 1 == 1 {
                chunks.push(text[from..at]);
                from = at;
            }
        }
        let k = chunks.len();
        if (0..k).all(|i| chunks[i] == chunks[k - 1 - i]) {
            best = best.max(k);
        }
    }
    best
}

fn word(seed: mut ref i64, size: i64, letters: i64) -> String {
    let mut s = String.new();
    for _ in 0..size {
        s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    s
}

// A text of 1 to 12 letters in four kinds: over two letters; over three;
// chunks of 1 to 3 letters mirrored around a middle of 0 to 2; and a
// palindrome over two letters.
fn problem(seed: mut ref i64, kind: i64) -> String {
    if kind < 2 {
        let size = 1 + next_random(mut seed) % 12;
        return word(mut seed, size, kind + 2);
    }
    if kind == 2 {
        let mut chunks: Vec[String] = [];
        let mut used = next_random(mut seed) % 3;
        let middle = word(mut seed, used, 2);
        while used < 10 and next_random(mut seed) % 4 != 0 {
            let size = 1 + next_random(mut seed) % 3;
            if used + 2 * size > 12 {
                break;
            }
            chunks.push(word(mut seed, size, 2));
            used += 2 * size;
        }
        let mut s = chunks.concat();
        s.push_str(middle);
        for c in chunks.iter().rev() {
            s.push_str(c);
        }
        if s.is_empty() { word(mut seed, 1, 2) } else { s }
    } else {
        let half = word(mut seed, next_random(mut seed) % 6 + 1, 2);
        let back: String = half.chars().rev().collect();
        if next_random(mut seed) % 2 == 0 { f"{half}{back}" } else { f"{half}{back[1..]}" }
    }
}

fn is_palindrome(text: Str) -> bool {
    let b = text.bytes();
    (0..b.len()).all(|i| b[i] == b[b.len() - 1 - i])
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// The choices a text's properties draw: P3's new names for the letters
// and P6's word.
struct Choice {
    names: Vec[u8],
    wrap: String,
}

fn check_case(t: mut ref Tally, text: Str, c: Choice) {
    let want = literal(text);
    let reversed: String = text.chars().rev().collect();
    let renamed: String = text.bytes().iter().map(|x| c.names[x - b'a'] as char).collect();
    let fenced = f"#{text}#";
    let wrapped = f"{c.wrap}{text}{c.wrap}";
    for w in 0..5 {
        let answer = arm(w, text);
        let what = f"arm {w}, case {t.cases} {text} -> {answer}";
        // P1: the statement read literally
        expect(mut t, 1, answer == want, f"P1 {what}, literally {want}");
        // P2: the text backwards
        let r = arm(w, reversed);
        expect(mut t, 2, r == answer, f"P2 {what}, backwards {r}");
        // P3: the letters renamed
        let m = arm(w, renamed);
        expect(mut t, 3, m == answer, f"P3 {what}, renamed {m}");
        // P4: a mark no text holds at both ends adds two chunks
        let z = arm(w, fenced);
        expect(mut t, 4, z == answer + 2, f"P4 {what}, fenced {z}");
        // P5: every letter its own chunk exactly when the text is a palindrome
        expect(mut t, 5, (answer == text.len()) == is_palindrome(text), f"P5 {what}");
        // P6: any word at both ends adds at least two chunks
        let u = arm(w, wrapped);
        expect(mut t, 6, u >= answer + 2, f"P6 {what}, wrapped in {c.wrap} {u}");
    }
    t.cases += 1;
    t.check = (t.check * 31 + want + text.len()) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 texts in four kinds, 500 each, and ten hash collisions. Every choice, P3's names and
    // P6's word among them, is drawn before any arm answers.
    let mut seed = 11471;
    let mut problems: Vec[(String, Choice)] = [];
    for i in 0..2000 {
        let text = problem(mut seed, i % 4);
        let mut names: Vec[u8] = (0..26).map(|x| b'a' + x as u8).collect();
        for j in (1..26).rev() {
            names.swap(j, next_random(mut seed) % (j + 1));
        }
        let size = 1 + next_random(mut seed) % 3;
        let wrap = word(mut seed, size, 3);
        problems.push((text, Choice { names, wrap }));
    }
    // Ten texts of two different chunks of six letters whose hashes agree
    // under the hashed arm's base and modulus, found by a search outside
    // this file: the hashed arm must still compare the chunks themselves.
    let collisions = [
        ("hzjnwi", "xytyxu"),
        ("oysssb", "kpeoix"),
        ("egaafs", "yoypqi"),
        ("dxcfaj", "zanfvm"),
        ("rygtdk", "xchixb"),
        ("vcmizc", "pyltfl"),
        ("rwnljo", "bxdaic"),
        ("jjglpg", "ziqwqs"),
        ("ygqoqr", "ihgdpf"),
        ("pzzsrd", "lqlohz"),
    ];
    for (u, v) in collisions.iter() {
        let mut names: Vec[u8] = (0..26).map(|x| b'a' + x as u8).collect();
        for j in (1..26).rev() {
            names.swap(j, next_random(mut seed) % (j + 1));
        }
        let size = 1 + next_random(mut seed) % 3;
        let wrap = word(mut seed, size, 3);
        problems.push((f"{u}{v}", Choice { names, wrap }));
    }
    for (text, c) in problems.iter() {
        check_case(mut t, text, Choice { names: c.names.clone(), wrap: c.wrap.clone() });
    }
    println(f"{t.cases} texts: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
