// LeetCode #1147: Longest Chunked Palindrome Decomposition -- the ★ arm,
// greedy from both ends: the shortest chunk at the front that equals the
// chunk of the same size at the back is taken off both, two chunks; when
// no chunk fits in what is left, what is left is one more. Taking the
// shortest is never worse: a longer match at the ends has the shorter one
// at both its ends, so it splits into the shorter pair and a palindromic
// decomposition of its own middle. O(n^2)

fn longest_decomposition(text: Str) -> i64 {
    let mut i = 0;
    let mut j = text.len();
    let mut k = 0;
    while i < j {
        let mut size = 1;
        while 2 * size <= j - i and text[i..i + size] != text[j - size..j] {
            size += 1;
        }
        if 2 * size > j - i {
            return k + 1;
        }
        k += 2;
        i += size;
        j -= size;
    }
    k
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A text of 1000 letters, LeetCode's longest: a word of 1 to 4 letters
// over "ab" repeated, then one of its letters changed at random, so the
// ends agree on long runs and the shortest equal chunks are long.
fn text(seed: mut ref i64) -> String {
    let size = 1 + next_random(mut seed) % 4;
    let mut unit: Vec[u8] = [];
    for _ in 0..size {
        unit.push(b'a' + (next_random(mut seed) % 2) as u8);
    }
    let mut b: Vec[u8] = (0..1000).map(|i| unit[i % size]).collect();
    let at = next_random(mut seed) % 1000;
    b[at] = b'a' + (next_random(mut seed) % 2) as u8;
    String.from_utf8(b).unwrap()
}

fn main() {
    // 20 texts built once. Each of 20000 rounds builds one of them anew, in
    // turn, and answers all 20.
    let mut seed = 1147;
    let mut texts: Vec[String] = [];
    for _ in 0..20 {
        texts.push(text(mut seed));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..20000 {
        texts[r % 20] = text(mut seed);
        for t in texts.iter() {
            let k = longest_decomposition(t);
            total += k;
            check = (check * 31 + k) % 1000000007;
        }
    }
    println(f"20000 rounds over 20 texts of 1000 letters: chunks total {total}, checksum {check}");
}
