// LeetCode #1146: Snapshot Array -- a differential over the five arms.
// Each session's answers are checked against the statement read
// literally and against seven properties that do not compute them; see
// the README.

// ---- snapshot_array.kara ----

struct A0SnapshotArray {
    history: Vec[Vec[(i64, i64)]],
    snaps: i64,
}

impl A0SnapshotArray {
    fn new(length: i64) -> A0SnapshotArray {
        A0SnapshotArray { history: Vec.filled(length, [(0, 0)]), snaps: 0 }
    }

    fn set(mut ref self, index: i64, val: i64) {
        let h = mut ref self.history[index];
        let last = h.len() - 1;
        if h[last].0 == self.snaps {
            h[last].1 = val;
        } else {
            h.push((self.snaps, val));
        }
    }

    fn snap(mut ref self) -> i64 {
        self.snaps += 1;
        self.snaps - 1
    }

    fn get(self, index: i64, snap_id: i64) -> i64 {
        let h = ref self.history[index];
        h[h.partition_point(|(s, _)| s <= snap_id) - 1].1
    }
}

// ---- snapshot_array_sorted.kara ----

struct A1SnapshotArray {
    history: Vec[SortedMap[i64, i64]],
    snaps: i64,
}

impl A1SnapshotArray {
    fn new(length: i64) -> A1SnapshotArray {
        A1SnapshotArray { history: Vec.filled(length, SortedMap.new()), snaps: 0 }
    }

    fn set(mut ref self, index: i64, val: i64) {
        self.history[index].insert(self.snaps, val);
    }

    fn snap(mut ref self) -> i64 {
        self.snaps += 1;
        self.snaps - 1
    }

    fn get(self, index: i64, snap_id: i64) -> i64 {
        match self.history[index].floor(snap_id) {
            Some((_, v)) => v,
            None => 0,
        }
    }
}

// ---- snapshot_array_keyed.kara ----

struct A2SnapshotArray {
    entries: SortedMap[(i64, i64), i64],
    snaps: i64,
}

impl A2SnapshotArray {
    fn new(length: i64) -> A2SnapshotArray {
        A2SnapshotArray { entries: SortedMap.new(), snaps: 0 }
    }

    fn set(mut ref self, index: i64, val: i64) {
        self.entries.insert((index, self.snaps), val);
    }

    fn snap(mut ref self) -> i64 {
        self.snaps += 1;
        self.snaps - 1
    }

    fn get(self, index: i64, snap_id: i64) -> i64 {
        match self.entries.floor((index, snap_id)) {
            Some(((place, _), v)) if place == index => v,
            _ => 0,
        }
    }
}

// ---- snapshot_array_diffs.kara ----

struct A3SnapshotArray {
    changes: Vec[Map[i64, i64]],
    pending: Map[i64, i64],
}

impl A3SnapshotArray {
    fn new(length: i64) -> A3SnapshotArray {
        A3SnapshotArray { changes: Vec.new(), pending: Map.new() }
    }

    fn set(mut ref self, index: i64, val: i64) {
        self.pending.insert(index, val);
    }

    fn snap(mut ref self) -> i64 {
        self.changes.push(mem.take(mut self.pending));
        self.changes.len() - 1
    }

    fn get(self, index: i64, snap_id: i64) -> i64 {
        for s in (0..snap_id + 1).rev() {
            if let Some(v) = self.changes[s].get(index) {
                return *v;
            }
        }
        0
    }
}

// ---- snapshot_array_solution.kara ----

struct A4SnapshotArray {
    snap_id: i32,
    history: Vec[Vec[(i32, i32)]],
}

impl A4SnapshotArray {
    fn new(length: i32) -> Self {
        A4SnapshotArray {
            snap_id: 0,
            history: Vec.filled(length, [(0, 0)]),
        }
    }

    fn set(mut ref self, index: i32, val: i32) {
        let h = mut ref self.history[index];
        if h.len() > 0 {
            if h[h.len() - 1].0 == self.snap_id {
                h[h.len() - 1].1 = val;
                return;
            }
        }
        h.push((self.snap_id, val));
    }

    fn snap(mut ref self) -> i32 {
        self.snap_id += 1;
        self.snap_id - 1
    }

    fn get(self, index: i32, snap_id: i32) -> i32 {
        let h = ref self.history[index];
        {
            let i = h.partition_point(|(s, _)| s < snap_id);
            if i < h.partition_point(|(s, _)| s <= snap_id) {
                h[i].1
            } else {
                h[i - 1].1
            }
        }
    }
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A call: (0, place, value) a set, (1, 0, 0) a snap, (2, place, snap) a get.

fn run0(length: i64, calls: Vec[(i64, i64, i64)]) -> (Vec[i64], Vec[i64]) {
    let mut arr = A0SnapshotArray.new(length as i32);
    let mut out: Vec[i64] = [];
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            arr.set(a as i32, b as i32);
        } else if kind == 1 {
            out.push(arr.snap());
        } else {
            out.push(arr.get(a as i32, b as i32));
        }
    }
    let mut again: Vec[i64] = [];
    for (kind, a, b) in calls.iter() {
        if kind == 2 {
            again.push(arr.get(a as i32, b as i32));
        }
    }
    (out, again)
}

fn run1(length: i64, calls: Vec[(i64, i64, i64)]) -> (Vec[i64], Vec[i64]) {
    let mut arr = A1SnapshotArray.new(length as i32);
    let mut out: Vec[i64] = [];
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            arr.set(a as i32, b as i32);
        } else if kind == 1 {
            out.push(arr.snap());
        } else {
            out.push(arr.get(a as i32, b as i32));
        }
    }
    let mut again: Vec[i64] = [];
    for (kind, a, b) in calls.iter() {
        if kind == 2 {
            again.push(arr.get(a as i32, b as i32));
        }
    }
    (out, again)
}

