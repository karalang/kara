// LeetCode #1195: Fizz Buzz Multithreaded -- a channel to each printer that
// carries the turn as the number to print: `number`'s holds a 1 to start.
// Each printer receives, prints, and sends the next number down the channel
// of whichever printer has it; once the numbers run out, it closes every
// channel by sending 0, the sign to return.

import std.sync.{TaskGroup};
import std.sync.{Mutex, Receiver, Sender};

sync struct FizzBuzz {
    n: i64,
    // fizz, buzz, fizzbuzz and number, in that order
    senders: Vec[Sender[i64]],
    receivers: Vec[Receiver[i64]],
}

impl FizzBuzz {
    fn new(n: i64) -> FizzBuzz {
        let mut senders: Vec[Sender[i64]] = Vec.new();
        let mut receivers: Vec[Receiver[i64]] = Vec.new();
        for _ in 0..4 {
            let (tx, rx) = channel(1);
            senders.push(tx);
            receivers.push(rx);
        }
        let _ = senders[3].send(1);
        FizzBuzz { n, senders, receivers }
    }

    // Whose number `i` is.
    fn owner(i: i64) -> i64 {
        if i % 15 == 0 {
            2
        } else if i % 3 == 0 {
            0
        } else if i % 5 == 0 {
            1
        } else {
            3
        }
    }

    // Prints each number that comes down channel `me`, and hands on the turn.
    fn serve(self, me: i64, print: Fn(i64)) {
        loop {
            let i = self.receivers[me].recv().unwrap_or(0);
            if i == 0 {
                return;
            }
            print(i);
            if i == self.n {
                for tx in self.senders.iter() {
                    let _ = tx.send(0);
                }
            } else {
                let _ = self.senders[FizzBuzz.owner(i + 1)].send(i + 1);
            }
        }
    }

    fn fizz(self, print_fizz: Fn()) {
        self.serve(0, |_| print_fizz());
    }

    fn buzz(self, print_buzz: Fn()) {
        self.serve(1, |_| print_buzz());
    }

    fn fizzbuzz(self, print_fizzbuzz: Fn()) {
        self.serve(2, |_| print_fizzbuzz());
    }

    fn number(self, print_number: Fn(i64)) {
        self.serve(3, |i| print_number(i));
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's run: four tasks share one `FizzBuzz`, each calling one of its
// methods with a printer that appends to the output; `order` is the order
// the four tasks are started in, 0 to 3 for fizz, buzz, fizzbuzz and
// number. Returns what was printed, in the order it was printed.
fn run(n: i64, order: Vec[i64]) -> Vec[String] {
    let fb = FizzBuzz.new(n);
    let out: Mutex[Vec[String]] = Mutex.new([]);
    {
        let group = TaskGroup.new();
        for role in order.iter() {
            match role {
                0 => group.spawn(|| fb.fizz(|| out.lock().value.push("fizz"))),
                1 => group.spawn(|| fb.buzz(|| out.lock().value.push("buzz"))),
                2 => group.spawn(|| fb.fizzbuzz(|| out.lock().value.push("fizzbuzz"))),
                _ => group.spawn(|| fb.number(|i| out.lock().value.push(f"{i}"))),
            }
        }
    }
    out.lock().value.clone()
}

// The sequence the statement asks for.
fn expected(n: i64) -> Vec[String] {
    (1..=n).map(|i| if i % 15 == 0 { "fizzbuzz" } else if i % 3 == 0 { "fizz" } else if i % 5 == 0 { "buzz" } else { f"{i}" }).collect()
}

fn main() {
    // LeetCode's two examples and three more: one number, the first fizz,
    // and LeetCode's largest n
    for n in [15, 5, 1, 3, 50] {
        println(f"n={n}: {run(n, [0, 1, 2, 3]).join(", ")}");
    }
    // 2000 random runs: n from 1 to 50, the four tasks started in a random
    // order
    let mut seed = 1195;
    let mut right = 0;
    let mut printed = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 50 + 1;
        let mut order = [0, 1, 2, 3];
        for i in (1..4).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let got = run(n, order);
        printed += got.len();
        if got == expected(n) {
            right += 1;
        }
    }
    println(f"2000 random runs: {printed} printed, {right} in order");
}
