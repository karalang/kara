// LeetCode #1195 bench: the ★ arm (one semaphore per printer, each handing
// the turn to the printer of the next number) printing n = 200000, past
// LeetCode's 50 so the hand-offs dominate, in 3 runs with the four tasks
// started in different orders. Each printer appends its line to a shared
// list under a lock, and each run's lines are folded into a checksum.

import std.sync.{Mutex, TaskGroup};

sync struct FizzBuzz {
    n: i64,
    fizz_turn: Semaphore,
    buzz_turn: Semaphore,
    fizzbuzz_turn: Semaphore,
    number_turn: Semaphore,
}

impl FizzBuzz {
    fn new(n: i64) -> FizzBuzz {
        FizzBuzz {
            n,
            fizz_turn: Semaphore.new(0),
            buzz_turn: Semaphore.new(0),
            fizzbuzz_turn: Semaphore.new(0),
            number_turn: Semaphore.new(1),
        }
    }

    // Hands the turn to the printer of `i`, if `i` is still to print.
    fn pass(self, i: i64) {
        if i > self.n {
            return;
        }
        if i % 15 == 0 {
            self.fizzbuzz_turn.release();
        } else if i % 3 == 0 {
            self.fizz_turn.release();
        } else if i % 5 == 0 {
            self.buzz_turn.release();
        } else {
            self.number_turn.release();
        }
    }

    fn fizz(self, print_fizz: Fn()) {
        for i in 1..=self.n {
            if i % 3 == 0 and i % 5 != 0 {
                let _ = self.fizz_turn.acquire(60000);
                print_fizz();
                self.pass(i + 1);
            }
        }
    }

    fn buzz(self, print_buzz: Fn()) {
        for i in 1..=self.n {
            if i % 5 == 0 and i % 3 != 0 {
                let _ = self.buzz_turn.acquire(60000);
                print_buzz();
                self.pass(i + 1);
            }
        }
    }

    fn fizzbuzz(self, print_fizzbuzz: Fn()) {
        for i in 1..=self.n {
            if i % 15 == 0 {
                let _ = self.fizzbuzz_turn.acquire(60000);
                print_fizzbuzz();
                self.pass(i + 1);
            }
        }
    }

    fn number(self, print_number: Fn(i64)) {
        for i in 1..=self.n {
            if i % 3 != 0 and i % 5 != 0 {
                let _ = self.number_turn.acquire(60000);
                print_number(i);
                self.pass(i + 1);
            }
        }
    }
}

fn run(n: i64, order: Vec[i64]) -> Vec[String] {
    let fb = FizzBuzz.new(n);
    let out: Mutex[Vec[String]] = Mutex.new([]);
    {
        let group = TaskGroup.new();
        for role in order.iter() {
            match role {
                0 => group.spawn(|| fb.fizz(|| out.lock().value.push("fizz"))),
                1 => group.spawn(|| fb.buzz(|| out.lock().value.push("buzz"))),
                2 => group.spawn(|| fb.fizzbuzz(|| out.lock().value.push("fizzbuzz"))),
                _ => group.spawn(|| fb.number(|i| out.lock().value.push(f"{i}"))),
            }
        }
    }
    out.lock().value.clone()
}

fn main() {
    let mut check = 0;
    for order in [[0, 1, 2, 3], [3, 2, 1, 0], [1, 3, 0, 2]] {
        let lines = run(200000, order);
        for line in lines.iter() {
            for b in line.bytes() {
                check = (check * 131 + b) % 1000000007;
            }
            check = (check * 131 + 10) % 1000000007;
        }
    }
    println(f"3 runs of n = 200000: checksum {check}");
}
