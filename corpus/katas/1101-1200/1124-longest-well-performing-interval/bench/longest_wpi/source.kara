// LeetCode #1124: Longest Well-Performing Interval -- the bench: the ★ arm
// over 16 schedules of 10^4 days, LeetCode's largest, built once, each of
// 300 rounds turning one day in every schedule from tiring to not or back
// and solving it again.

fn longest_wpi(hours: Vec[i32]) -> i64 {
    let mut first: Map[i64, i64] = Map.new();
    let mut score = 0;
    let mut best = 0;
    for (i, h) in hours.iter().enumerate() {
        score += if h > 8 { 1 } else { -1 };
        if score > 0 {
            best = i + 1;
        } else {
            if let Some(j) = first.get(score - 1) {
                best = best.max(i - j);
            }
            if not first.contains_key(score) {
                first[score] = i;
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1124;
    let mut schedules: Vec[Vec[i32]] = [];
    for _ in 0..16 {
        let mut hours: Vec[i32] = [];
        for _ in 0..10000 {
            hours.push((next_random(mut seed) % 17) as i32);
        }
        schedules.push(hours);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..300 {
        for j in 0..schedules.len() {
            let at = (round * 7919 + j * 104729) % 10000;
            let h = schedules[j][at];
            schedules[j][at] = if h > 8 { h - 9 } else { 9 + h % 8 };
            let answer = longest_wpi(schedules[j]);
            total += answer;
            check = (check * 31 + answer) % 1000000007;
        }
    }
    println(f"300 rounds over 16 schedules of 10^4 days: answers total {total}, checksum {check}");
}
