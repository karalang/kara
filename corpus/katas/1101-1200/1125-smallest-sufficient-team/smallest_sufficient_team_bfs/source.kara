// LeetCode #1125: Smallest Sufficient Team -- a breadth-first search over
// masks: from the empty mask, each step adds one person, so the first time
// the full mask is reached is by a smallest team. Each mask is queued at
// most once, with the mask it came from and the person who brought it.
// O(people * 2^skills).

fn smallest_sufficient_team(req_skills: Vec[String], people: Vec[Vec[String]]) -> Vec[i64] {
    let mut bit: Map[String, i64] = Map.new();
    for (i, s) in req_skills.iter().enumerate() {
        bit[s.clone()] = i;
    }
    let masks: Vec[i64] = people.iter().map(|skills| skills.iter().fold(0, |mask, s| mask | 1 << bit[s])).collect();
    let full = (1 << req_skills.len()) - 1;
    let mut seen: Vec[bool] = Vec.filled(full + 1, false);
    let mut from: Vec[(i64, i64)] = Vec.filled(full + 1, (0, 0));
    let mut queue: VecDeque[i64] = VecDeque.new();
    seen[0] = true;
    queue.push_back(0);
    while let Some(m) = queue.pop_front() {
        if m == full {
            break;
        }
        for (p, mask) in masks.iter().enumerate() {
            let grown = m | mask;
            if not seen[grown] {
                seen[grown] = true;
                from[grown] = (m, p);
                queue.push_back(grown);
            }
        }
    }
    let mut team: Vec[i64] = [];
    let mut m = full;
    while m != 0 {
        team.push(from[m].1);
        m = from[m].0;
    }
    team
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Whether `team` names each person once, all of them real, and between
// them has every skill.
fn covers(req_skills: Vec[String], people: Vec[Vec[String]], team: Vec[i64]) -> bool {
    for (i, p) in team.iter().enumerate() {
        if p < 0 or p >= people.len() or team[..i].contains(p) {
            return false;
        }
    }
    req_skills.iter().all(|s| team.iter().any(|p| people[p].contains(s)))
}

// `m` skills named `s0`.. and `n` people, each with every skill at chance
// `percent` in 100, then any skill nobody has given to a random person.
fn random_problem(seed: mut ref i64, m: i64, n: i64, percent: i64) -> (Vec[String], Vec[Vec[String]]) {
    let req: Vec[String] = (0..m).map(|i| f"s{i}").collect();
    let mut people: Vec[Vec[String]] = [];
    for _ in 0..n {
        let mut skills: Vec[String] = [];
        for s in req.iter() {
            if next_random(mut seed) % 100 < percent {
                skills.push(s.clone());
            }
        }
        people.push(skills);
    }
    for s in req.iter() {
        if not people.iter().any(|p| p.contains(s)) {
            let at = next_random(mut seed) % n;
            people[at].push(s.clone());
        }
    }
    (req, people)
}

fn report(req_skills: Vec[String], people: Vec[Vec[String]]) -> String {
    let team = smallest_sufficient_team(req_skills, people);
    let verdict = if covers(req_skills, people, team) { "covering every skill" } else { "MISSING A SKILL" };
    f"a team of {team.len()}, {verdict}"
}

fn main() {
    // LeetCode's two examples and six more: one skill, people with none,
    // one person with every skill, two who overlap, a pair that beats
    // three, and many people alike
    let cases: Vec[(Vec[String], Vec[Vec[String]])] = [
        (["java", "nodejs", "reactjs"], [["java"], ["nodejs"], ["nodejs", "reactjs"]]),
        (
            ["algorithms", "math", "java", "reactjs", "csharp", "aws"],
            [
                ["algorithms", "math", "java"],
                ["algorithms", "math", "reactjs"],
                ["java", "csharp", "aws"],
                ["reactjs", "csharp"],
                ["csharp", "math"],
                ["aws", "java"],
            ],
        ),
        (["a"], [["a"]]),
        (["a", "b", "c"], [[], ["a"], [], ["b"], ["c"], []]),
        (["a", "b", "c", "d"], [["a", "b"], ["c", "d"], ["a", "b", "c", "d"]]),
        (["a", "b", "c", "d"], [["a", "b", "c"], ["b", "c", "d"], ["a"], ["d"]]),
        (
            ["a", "b", "c", "d", "e", "f"],
            [["a", "b", "c", "d"], ["a", "e"], ["b", "f"], ["c", "d", "e", "f"]],
        ),
        (["x", "y"], [["x"], ["x"], ["y"], ["y"], ["x", "y"]]),
    ];
    for (k, (req, people)) in cases.iter().enumerate() {
        println(f"case {k + 1}, skills {req.len()}, people {people.len()}: {report(req, people)}");
    }
    // 500 random problems of up to 10 skills and 20 people, each skill
    // held at chance 10% to 40%: the team sizes summed and a checksum
    let mut seed = 1125;
    let mut total = 0;
    let mut check = 0;
    for t in 0..500 {
        let m = next_random(mut seed) % 10 + 1;
        let n = next_random(mut seed) % 20 + 1;
        let (req, people) = random_problem(mut seed, m, n, 10 + t % 4 * 10);
        let team = smallest_sufficient_team(req, people);
        let ok = if covers(req, people, team) { 1 } else { 0 };
        total += team.len();
        check = (check * 31 + team.len() * 2 + ok) % 1000000007;
    }
    println(f"500 random problems: team sizes total {total}, checksum {check}");
    // two of LeetCode's largest: 16 skills and 60 people
    for percent in [5, 20] {
        let (req, people) = random_problem(mut seed, 16, 60, percent);
        println(f"16 skills, 60 people at {percent}%: {report(req, people)}");
    }
}
