// LeetCode #1167: Minimum Cost to Connect Sticks -- the ★ arm, a heap: the
// sticks in a `PriorityQueue`, smallest first; the two shortest are joined,
// at their sum's cost, and the joined stick goes back. O(n log n).

fn connect_sticks(sticks: own Vec[i64]) -> i64 {
    let mut pq = PriorityQueue.from(sticks);
    let mut cost = 0;
    while pq.len() > 1 {
        let a = pq.pop().unwrap();
        let b = pq.pop().unwrap();
        cost += a + b;
        pq.push(a + b);
    }
    cost
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 16 piles of 10^4 sticks of 1 to 10^4, the constraints' most, built
    // once; each of 40 rounds gives one stick of every pile a new length
    // and joins the pile.
    let mut seed = 1167;
    let mut piles: Vec[Vec[i64]] = [];
    for _ in 0..16 {
        piles.push((0..10000).map(|_| 1 + next_random(mut seed) % 10000).collect());
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..40 {
        for k in 0..16 {
            let at = next_random(mut seed) % 10000;
            piles[k][at] = 1 + next_random(mut seed) % 10000;
            let c = connect_sticks(piles[k].clone());
            total += c;
            check = (check * 31 + c) % 1000000007;
        }
    }
    println(f"40 rounds over 16 piles of 10^4 sticks: total {total}, checksum {check}");
}
