// LeetCode #1167: Minimum Cost to Connect Sticks -- the ★ arm, a heap: the
// sticks in a `PriorityQueue`, smallest first; the two shortest are joined,
// at their sum's cost, and the joined stick goes back. O(n log n).

fn connect_sticks(sticks: own Vec[i64]) -> i64 {
    let mut pq = PriorityQueue.from(sticks);
    let mut cost = 0;
    while pq.len() > 1 {
        let a = pq.pop().unwrap();
        let b = pq.pop().unwrap();
        cost += a + b;
        pq.push(a + b);
    }
    cost
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(sticks: Vec[i64]) {
    println(f"{sticks} -> {connect_sticks(sticks.clone())}");
}

fn main() {
    // LeetCode's examples and four more: two sticks; four equal; the powers
    // of two, each joined stick the next one's equal; a stick far longer
    // than the rest
    show([2, 4, 3]);
    show([1, 8, 3, 5]);
    show([5]);
    show([1, 1]);
    show([3, 3, 3, 3]);
    show([1, 1, 2, 4, 8, 16, 32, 64]);
    show([10000, 1, 2, 3]);
    // 300 random piles of 1 to 50 sticks, half of length 1 to 10 so that
    // lengths tie, half 1 to 10^4
    let mut seed = 1167;
    let mut total = 0;
    let mut check = 0;
    for i in 0..300 {
        let n = 1 + next_random(mut seed) % 50;
        let top = if i % 2 == 0 { 10 } else { 10000 };
        let sticks: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % top).collect();
        let c = connect_sticks(sticks);
        total += c;
        check = (check * 31 + c) % 1000000007;
    }
    println(f"300 random piles: total {total}, checksum {check}");
    // 10^4 sticks, the constraints' most: random, and all of the longest
    let sticks: Vec[i64] = (0..10000).map(|_| 1 + next_random(mut seed) % 10000).collect();
    println(f"10000 random sticks: {connect_sticks(sticks.clone())}");
    println(f"10000 sticks of 10000: {connect_sticks(Vec.filled(10000, 10000))}");
}
