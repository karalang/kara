// LeetCode #1190 bench: the ★ arm (each bracket paired with its match, then
// one walk that jumps to the match at a bracket and turns around) over 200
// strings of about 2000 characters, LeetCode's longest, built once: random
// letters and pairs, and 500 pairs nested with a letter before each `(` and
// after each `)`. Then 200 rounds over the strings, each answer's digest
// folded into a checksum.

fn reverse_parentheses(s: String) -> String {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut pair = Vec.filled(n, 0);
    let mut open: Vec[i64] = Vec.new();
    for i in 0..n {
        if bytes[i] == b'(' {
            open.push(i);
        } else if bytes[i] == b')' {
            let j = open.pop().unwrap();
            pair[i] = j;
            pair[j] = i;
        }
    }
    let mut out = String.with_capacity(n);
    let mut i = 0;
    let mut step = 1;
    while i < n {
        if bytes[i] == b'(' or bytes[i] == b')' {
            i = pair[i];
            step = -step;
        } else {
            out.push(bytes[i] as char);
        }
        i += step;
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random balanced string of about `n` characters: a quarter of them `(`,
// a `)` a quarter of the time while a pair is open, the rest letters, and
// the open pairs closed at the end.
fn random_case(seed: mut ref i64, n: i64, letters: Vec[char]) -> String {
    let mut s = String.new();
    let mut open = 0;
    for _ in 0..n {
        let r = next_random(mut seed) % 4;
        if r == 0 {
            s.push('(');
            open += 1;
        } else if r == 1 and open > 0 {
            s.push(')');
            open -= 1;
        } else {
            s.push(letters[next_random(mut seed) % letters.len()]);
        }
    }
    for _ in 0..open {
        s.push(')');
    }
    s
}

// `depth` pairs nested, a random letter before each `(` and after each `)`.
fn nested(seed: mut ref i64, depth: i64, letters: Vec[char]) -> String {
    let mut s = String.new();
    for _ in 0..depth {
        s.push(letters[next_random(mut seed) % letters.len()]);
        s.push('(');
    }
    for _ in 0..depth {
        s.push(letters[next_random(mut seed) % letters.len()]);
        s.push(')');
    }
    s
}

fn digest(s: String) -> i64 {
    let mut h = 0;
    for b in s.bytes() {
        h = (h * 131 + b) % 1000000007;
    }
    h
}

fn main() {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 1190;
    let mut cases: Vec[String] = Vec.new();
    for i in 0..200 {
        if i % 2 == 0 {
            cases.push(random_case(mut seed, 2000, letters));
        } else {
            cases.push(nested(mut seed, 500, letters));
        }
    }
    let mut check = 0;
    for _ in 0..200 {
        for s in cases.iter() {
            check = (check * 131 + digest(reverse_parentheses(s))) % 1000000007;
        }
    }
    println(f"200 rounds of 200 strings of about 2000 characters: checksum {check}");
}
