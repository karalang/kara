// LeetCode #1190: Reverse Substrings Between Each Pair of Parentheses -- a
// stack of the strings each open pair interrupted: a `(` sets the current
// string aside, a `)` reverses it and appends it to the one set aside.
// O(n * depth) time, O(n) space.

fn reverse_parentheses(s: String) -> String {
    let mut stack: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '(' {
            stack.push(cur);
            cur = String.new();
        } else if c == ')' {
            let inner: String = cur.chars().rev().collect();
            cur = stack.pop().unwrap();
            cur.push_str(inner);
        } else {
            cur.push(c);
        }
    }
    cur
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random balanced string of about `n` characters: a quarter of them `(`,
// a `)` a quarter of the time while a pair is open, the rest letters, and
// the open pairs closed at the end.
fn random_case(seed: mut ref i64, n: i64, letters: Vec[char]) -> String {
    let mut s = String.new();
    let mut open = 0;
    for _ in 0..n {
        let r = next_random(mut seed) % 4;
        if r == 0 {
            s.push('(');
            open += 1;
        } else if r == 1 and open > 0 {
            s.push(')');
            open -= 1;
        } else {
            s.push(letters[next_random(mut seed) % letters.len()]);
        }
    }
    for _ in 0..open {
        s.push(')');
    }
    s
}

fn digest(s: String) -> i64 {
    let mut h = 0;
    for b in s.bytes() {
        h = (h * 131 + b) % 1000000007;
    }
    h
}

fn main() {
    // LeetCode's three examples and six more: one letter, an empty pair,
    // a pair inside a pair, one long group around a short one, empty pairs
    // beside deep ones, and three pairs side by side
    let cases = ["(abcd)", "(u(love)i)", "(ed(et(oc))el)", "a", "()", "((ab))", "a(bcdefghijkl(mno)p)q", "ta()usw((((a))))", "(a)(b)(c)"];
    for c in cases.iter() {
        println(f"\"{c}\" -> \"{reverse_parentheses(c.to_string())}\"");
    }
    // 2000 random strings of up to 40 characters, folded into a checksum
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 1190;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 40 + 1;
        let s = random_case(mut seed, n, letters);
        let out = reverse_parentheses(s);
        total += out.len();
        check = (check * 131 + digest(out)) % 1000000007;
    }
    println(f"2000 random strings: {total} letters, checksum {check}");
    // LeetCode's longest, 2000 characters: 500 pairs nested, a letter
    // before each `(` and after each `)`; and 2000 random characters
    let mut deep = String.new();
    for i in 0..500 {
        deep.push(letters[i % 26]);
        deep.push('(');
    }
    for i in 0..500 {
        deep.push(letters[(i * 7) % 26]);
        deep.push(')');
    }
    let out = reverse_parentheses(deep);
    println(f"500 nested pairs: {out.len()} letters, digest {digest(out)}");
    let out = reverse_parentheses(random_case(mut seed, 2000, letters));
    println(f"2000 random characters: {out.len()} letters, digest {digest(out)}");
}
