// LeetCode #1190: Reverse Substrings Between Each Pair of Parentheses -- the
// six arms against the statement read literally and six more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_reverse_parentheses(s: String) -> String {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut pair = Vec.filled(n, 0);
    let mut open: Vec[i64] = Vec.new();
    for i in 0..n {
        if bytes[i] == b'(' {
            open.push(i);
        } else if bytes[i] == b')' {
            let j = open.pop().unwrap();
            pair[i] = j;
            pair[j] = i;
        }
    }
    let mut out = String.with_capacity(n);
    let mut i = 0;
    let mut step = 1;
    while i < n {
        if bytes[i] == b'(' or bytes[i] == b')' {
            i = pair[i];
            step = -step;
        } else {
            out.push(bytes[i] as char);
        }
        i += step;
    }
    out
}

// ---- arm 1: strings -----------------------------------------------------
fn a1_reverse_parentheses(s: String) -> String {
    let mut stack: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '(' {
            stack.push(cur);
            cur = String.new();
        } else if c == ')' {
            let inner: String = cur.chars().rev().collect();
            cur = stack.pop().unwrap();
            cur.push_str(inner);
        } else {
            cur.push(c);
        }
    }
    cur
}

// ---- arm 2: chars -------------------------------------------------------
fn a2_reverse_parentheses(s: String) -> String {
    let mut stack: Vec[char] = Vec.new();
    for c in s.chars() {
        if c == ')' {
            let mut run: Vec[char] = Vec.new();
            while let Some(t) = stack.pop() {
                if t == '(' {
                    break;
                }
                run.push(t);
            }
            stack.extend(run);
        } else {
            stack.push(c);
        }
    }
    stack.iter().collect()
}

// ---- arm 3: recursive ---------------------------------------------------
fn a3_read_group(bytes: Slice[u8], at: mut ref i64) -> String {
    let mut out = String.new();
    while *at < bytes.len() {
        let b = bytes[*at];
        *at += 1;
        if b == b'(' {
            let inner = a3_read_group(bytes, mut at);
            let reversed: String = inner.chars().rev().collect();
            out.push_str(reversed);
        } else if b == b')' {
            return out;
        } else {
            out.push(b as char);
        }
    }
    out
}

fn a3_reverse_parentheses(s: String) -> String {
    let bytes = s.bytes();
    let mut at = 0;
    a3_read_group(bytes, mut at)
}

// ---- arm 4: solution ----------------------------------------------------
struct A4Solution {}

impl A4Solution {
    pub fn reverse_parentheses(s: String) -> String {
        let mut stack: Vec[Vec[char]] = [Vec.new()];
        for c in s.chars() {
            match c {
                '(' => stack.push(Vec.new()),
                ')' => {
                    let mut top = stack.pop().unwrap();
                    top.reverse();
                    stack[stack.len() - 1].extend(top);
                }
                _ => stack[stack.len() - 1].push(c),
            }
        }
        stack.pop().unwrap().into_iter().collect()
    }
}

fn a4_reverse_parentheses(s: String) -> String {
    A4Solution.reverse_parentheses(s)
}

// ---- arm 5: jump --------------------------------------------------------
struct A5Solution {}

impl A5Solution {
    pub fn reverse_parentheses(s: String) -> String {
        let s = s.bytes();
        let n = s.len();
        let mut pair = Vec.filled(n, 0);
        let mut st = Vec.new();
        for (i, c) in s.iter().enumerate() {
            if c == b'(' {
                st.push(i);
            } else if c == b')' {
                let j = st.pop().unwrap();
                pair[i] = j;
                pair[j] = i;
            }
        }
        let mut res = String.with_capacity(n);
        let mut (i, d) = (0i32, 1i32);
        while i < n {
            let c = s[i];
            if c == b'(' or c == b')' {
                i = pair[i] as i32;
                d = -d;
            } else {
                res.push(c as char);
            }
            i += d;
        }
        res
    }
}

fn a5_reverse_parentheses(s: String) -> String {
    A5Solution.reverse_parentheses(s)
}
// ---- the statement read literally ----------------------------------------

// The innermost pair, the one the first `)` closes, reversed and its
// brackets dropped, until no pair is left.
fn literal(s: String) -> String {
    let mut cs: Vec[char] = s.chars().collect();
    loop {
        let Some(close) = cs.iter().position(|c| c == ')') else {
            break;
        };
        let mut open = close;
        while cs[open] != '(' {
            open -= 1;
        }
        let mut next: Vec[char] = Vec.new();
        for k in 0..open {
            next.push(cs[k]);
        }
        let mut k = close - 1;
        while k > open {
            next.push(cs[k]);
            k -= 1;
        }
        for k in close + 1..cs.len() {
            next.push(cs[k]);
        }
        cs = next;
    }
    cs.iter().collect()
}

// ---- the differential -----------------------------------------------------

fn arms(s: String) -> Vec[String] {
    [
        a0_reverse_parentheses(s),
        a1_reverse_parentheses(s),
        a2_reverse_parentheses(s),
        a3_reverse_parentheses(s),
        a4_reverse_parentheses(s),
        a5_reverse_parentheses(s),
    ]
}

fn reversed(s: String) -> String {
    s.chars().rev().collect()
}

// `s` read right to left, each bracket turned around.
fn mirror(s: String) -> String {
    s.chars().rev().map(|c| if c == '(' { ')' } else if c == ')' { '(' } else { c }).collect()
}

fn letters_sorted(s: String) -> Vec[char] {
    let mut v: Vec[char] = s.chars().filter(|c| c != '(' and c != ')').collect();
    v.sort();
    v
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random balanced string of about `n` characters, as the arms' harness
// draws them.
fn random_case(seed: mut ref i64, n: i64, letters: Vec[char]) -> String {
    let mut s = String.new();
    let mut open = 0;
    for _ in 0..n {
        let r = next_random(mut seed) % 4;
        if r == 0 {
            s.push('(');
            open += 1;
        } else if r == 1 and open > 0 {
            s.push(')');
            open -= 1;
        } else {
            s.push(letters[next_random(mut seed) % letters.len()]);
        }
    }
    for _ in 0..open {
        s.push(')');
    }
    s
}

fn digest(s: String) -> i64 {
    let mut h = 0;
    for b in s.bytes() {
        h = (h * 131 + b) % 1000000007;
    }
    h
}

fn main() {
    let names = ["the statement read literally", "the same letters, every one", "the whole string in a pair reverses the answer", "two pairs around it change nothing", "two strings side by side answer side by side", "the mirror image answers in reverse", "the ★ arm's answer"];
    let mut fails = Vec.filled(7, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1190;
    let mut prev = "";
    for round in 0..2000 {
        // the first 200 strings from two letters, the rest from six
        let letters: Vec[char] = if round < 200 { "ab".chars().collect() } else { "abcdef".chars().collect() };
        let n = next_random(mut seed) % 30 + 1;
        let s = random_case(mut seed, n, letters);
        let got = arms(s);
        let want = literal(s);
        let wrapped = arms(f"({s})");
        let twice = arms(f"(({s}))");
        let joined = arms(f"{prev}{s}");
        let before = arms(prev);
        let mirrored = arms(mirror(s));
        for i in 0..6 {
            let v = ref got[i];
            let held = [
                v == want,
                letters_sorted(v) == letters_sorted(s),
                wrapped[i] == reversed(v),
                twice[i] == v,
                joined[i] == f"{before[i]}{v}",
                mirrored[i] == reversed(v),
                v == got[0],
            ];
            for p in 0..7 {
                checks += 1;
                if not held[p] {
                    fails[p] += 1;
                    if fails[p] <= 2 {
                        println(f"P{p + 1} ({names[p]}) fails on arm {i}: \"{s}\" -> \"{v}\"");
                    }
                }
            }
        }
        check = (check * 131 + digest(got[0])) % 1000000007;
        prev = s;
    }
    for p in 0..7 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    let total = fails.iter().sum();
    println(f"2000 strings: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
