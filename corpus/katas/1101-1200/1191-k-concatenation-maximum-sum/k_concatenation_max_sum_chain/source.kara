// LeetCode #1191: K-Concatenation Maximum Sum -- another Rust solution, in
// iterator chains: `arr.iter().cycle().take(..)` over one or two copies, a
// `scan` carrying the running sum, `.max()`, and the middle copies' sum
// when it is above zero, inside `impl Solution`; carried to Kāra by `karac
// fix`. O(n) time, O(1) space.

struct Solution {}

impl Solution {
    pub fn k_concatenation_max_sum(arr: Vec[i32], k: i32) -> i32 {
        let total: i64 = arr.iter().map(|x| x as i64).sum();
        let times = k.min(2) as i64;
        let best = arr
            .iter()
            .cycle()
            .take(arr.len() * times)
            .scan(0, |cur, x| { let cur = (cur + x as i64).max(0); Some((cur, cur)) })
            .max()
            .unwrap_or(0);
        let extra = if k > 2 { (k as i64 - 2) * total.max(0) } else { 0 };
        ((best + extra) % 1_000_000_007) as i32
    }
}

fn k_concatenation_max_sum(arr: Vec[i64], k: i64) -> i64 {
    let arr: Vec[i32] = arr.iter().map(|x| x as i32).collect();
    Solution.k_concatenation_max_sum(arr, k as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples and five more: one value, a sum of zero
    // around a peak, a small array repeated LeetCode's most times, every
    // value negative but one, and the largest answer
    println(f"[1, 2] k=3: {k_concatenation_max_sum([1, 2], 3)}");
    println(f"[1, -2, 1] k=5: {k_concatenation_max_sum([1, -2, 1], 5)}");
    println(f"[-1, -2] k=7: {k_concatenation_max_sum([-1, -2], 7)}");
    println(f"[5] k=1: {k_concatenation_max_sum([5], 1)}");
    println(f"[-5, 10, -5] k=3: {k_concatenation_max_sum([-5, 10, -5], 3)}");
    println(f"[2, -1, 2] k=100000: {k_concatenation_max_sum([2, -1, 2], 100000)}");
    println(f"[-3, -3, 4, -3] k=4: {k_concatenation_max_sum([-3, -3, 4, -3], 4)}");
    println(f"[10000; 100000] k=100000: {k_concatenation_max_sum(Vec.filled(100000, 10000), 100000)}");
    // 2000 random arrays of 1 to 8 values in -10..=10, each repeated 1 to
    // 6 times, folded into a checksum
    let mut seed = 1191;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 8 + 1;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(next_random(mut seed) % 21 - 10);
        }
        let k = next_random(mut seed) % 6 + 1;
        check = (check * 131 + k_concatenation_max_sum(arr, k)) % 1000000007;
    }
    println(f"2000 random arrays: checksum {check}");
    // LeetCode's longest, 10^5 values in -10^4..=10^4 repeated 10^5 times,
    // once at random and once with the values shifted to sum above zero
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        let high = next_random(mut seed);
        let low = next_random(mut seed);
        arr.push((high * 32768 + low) % 20001 - 10000);
    }
    println(f"100000 random values k=100000: {k_concatenation_max_sum(arr, 100000)}");
    let lifted: Vec[i64] = arr.iter().map(|x| (x + 300).min(10000)).collect();
    println(f"100000 lifted values k=100000: {k_concatenation_max_sum(lifted, 100000)}");
}
