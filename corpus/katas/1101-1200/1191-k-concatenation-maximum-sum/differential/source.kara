// LeetCode #1191: K-Concatenation Maximum Sum -- the five arms against the
// statement read literally and six more properties. Generated from the arms;
// see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_k_concatenation_max_sum(arr: Vec[i64], k: i64) -> i64 {
    let total: i64 = arr.iter().sum();
    let mut best = 0;
    let mut run = 0;
    for _ in 0..k.min(2) {
        for x in arr.iter() {
            run = (run + x).max(0);
            best = best.max(run);
        }
    }
    if k > 2 and total > 0 {
        best += (k - 2) * total;
    }
    best % 1000000007
}

// ---- arm 1: ends --------------------------------------------------------
fn a1_k_concatenation_max_sum(arr: Vec[i64], k: i64) -> i64 {
    let mut total = 0;
    let mut best_prefix = 0;
    for x in arr.iter() {
        total += x;
        best_prefix = best_prefix.max(total);
    }
    let mut suffix = 0;
    let mut best_suffix = 0;
    for x in arr.iter().rev() {
        suffix += x;
        best_suffix = best_suffix.max(suffix);
    }
    let mut best = 0;
    let mut run = 0;
    for x in arr.iter() {
        run = (run + x).max(0);
        best = best.max(run);
    }
    if k >= 2 {
        best = best.max(best_suffix + (k - 2) * total.max(0) + best_prefix);
    }
    best % 1000000007
}

// ---- arm 2: power -------------------------------------------------------
struct A2Segment {
    sum: i64,
    prefix: i64,
    suffix: i64,
    best: i64,
}

fn a2_join(a: A2Segment, b: A2Segment) -> A2Segment {
    A2Segment {
        sum: a.sum + b.sum,
        prefix: a.prefix.max(a.sum + b.prefix),
        suffix: b.suffix.max(b.sum + a.suffix),
        best: a.best.max(b.best).max(a.suffix + b.prefix),
    }
}

fn a2_k_concatenation_max_sum(arr: Vec[i64], k: i64) -> i64 {
    let mut one = A2Segment { sum: 0, prefix: 0, suffix: 0, best: 0 };
    for x in arr.iter() {
        let v = x.max(0);
        one = a2_join(one, A2Segment { sum: x, prefix: v, suffix: v, best: v });
    }
    let mut acc = A2Segment { sum: 0, prefix: 0, suffix: 0, best: 0 };
    let mut base = one;
    let mut left = k;
    while left > 0 {
        if left % 2 == 1 {
            acc = a2_join(acc, base);
        }
        base = a2_join(base, base);
        left /= 2;
    }
    acc.best % 1000000007
}

// ---- arm 3: solution ----------------------------------------------------
struct A3Solution {}

impl A3Solution {
    pub fn k_concatenation_max_sum(arr: Vec[i32], k: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let sum: i64 = arr.iter().map(|x| x as i64).sum();
        let n = arr.len();
        let reps = if k == 1 { 1 } else { 2 };
        let mut best = 0;
        let mut cur = 0;
        for i in 0..n * reps {
            cur = (cur + arr[i % n]).max(0);
            best = best.max(cur);
        }
        if k > 2 and sum > 0 {
            best += (k as i64 - 2) * sum;
        }
        (best % MOD) as i32
    }
}

fn a3_k_concatenation_max_sum(arr: Vec[i64], k: i64) -> i64 {
    let arr: Vec[i32] = arr.iter().map(|x| x as i32).collect();
    A3Solution.k_concatenation_max_sum(arr, k as i32)
}

// ---- arm 4: chain -------------------------------------------------------
struct A4Solution {}

impl A4Solution {
    pub fn k_concatenation_max_sum(arr: Vec[i32], k: i32) -> i32 {
        let total: i64 = arr.iter().map(|x| x as i64).sum();
        let times = k.min(2) as i64;
        let best = arr
            .iter()
            .cycle()
            .take(arr.len() * times)
            .scan(0, |cur, x| { let cur = (cur + x as i64).max(0); Some((cur, cur)) })
            .max()
            .unwrap_or(0);
        let extra = if k > 2 { (k as i64 - 2) * total.max(0) } else { 0 };
        ((best + extra) % 1_000_000_007) as i32
    }
}

fn a4_k_concatenation_max_sum(arr: Vec[i64], k: i64) -> i64 {
    let arr: Vec[i32] = arr.iter().map(|x| x as i32).collect();
    A4Solution.k_concatenation_max_sum(arr, k as i32)
}
// ---- the statement read literally ----------------------------------------

// Every subarray of the k copies laid end to end, the empty one included.
fn literal(arr: Vec[i64], k: i64) -> i64 {
    let mut whole: Vec[i64] = Vec.new();
    for _ in 0..k {
        whole.extend(arr.clone());
    }
    let mut best = 0;
    for i in 0..whole.len() {
        let mut sum = 0;
        for j in i..whole.len() {
            sum += whole[j];
            best = best.max(sum);
        }
    }
    best % 1000000007
}

// ---- the differential -----------------------------------------------------

fn arms(arr: Vec[i64], k: i64) -> Vec[i64] {
    [
        a0_k_concatenation_max_sum(arr, k),
        a1_k_concatenation_max_sum(arr, k),
        a2_k_concatenation_max_sum(arr, k),
        a3_k_concatenation_max_sum(arr, k),
        a4_k_concatenation_max_sum(arr, k),
    ]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "at least zero and at least the largest value", "one more copy never lowers it", "the array reversed", "past two copies, each copy adds the sum when it is above zero", "past two copies, nothing changes when the sum is not above zero", "the ★ arm's answer"];
    let mut fails = Vec.filled(7, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1191;
    for round in 0..2000 {
        // the first 200 arrays from -3..=3, the rest from -10..=10
        let span = if round < 200 { 3 } else { 10 };
        let n = next_random(mut seed) % 8 + 1;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(next_random(mut seed) % (2 * span + 1) - span);
        }
        let k = next_random(mut seed) % 6 + 1;
        let total: i64 = arr.iter().sum();
        let top = arr.iter().max().unwrap();
        let got = arms(arr, k);
        let want = literal(arr, k);
        let more = arms(arr, k + 1);
        let back: Vec[i64] = arr.iter().rev().collect();
        let reversed = arms(back, k);
        for i in 0..5 {
            let v = got[i];
            let held = [
                v == want,
                v >= 0 and v >= top,
                more[i] >= v,
                reversed[i] == v,
                k < 2 or total <= 0 or more[i] == v + total,
                k < 2 or total > 0 or more[i] == v,
                v == got[0],
            ];
            for p in 0..7 {
                checks += 1;
                if not held[p] {
                    fails[p] += 1;
                    if fails[p] <= 2 {
                        println(f"P{p + 1} ({names[p]}) fails on arm {i}: {arr} k={k} -> {v}");
                    }
                }
            }
        }
        check = (check * 131 + got[0]) % 1000000007;
    }
    for p in 0..7 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    let total = fails.iter().sum();
    println(f"2000 arrays: checksum {check}, {checks} checks over 5 arms: {total} failures");
}
