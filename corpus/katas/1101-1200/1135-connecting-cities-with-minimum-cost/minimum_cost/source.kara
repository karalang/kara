// LeetCode #1135: Connecting Cities With Minimum Cost -- the ★ arm:
// Kruskal's algorithm. The roads are taken cheapest first, and a road is
// kept when it joins two parts of the network, the parts kept in a
// union-find with path halving and union by size. O(m log m)

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn minimum_cost(n: i64, connections: Vec[Vec[i64]]) -> i64 {
    let mut roads = connections.clone();
    roads.sort_by_key(|road| road[2]);
    let mut parent: Vec[i64] = (0..n + 1).collect();
    let mut size = Vec.filled(n + 1, 1);
    let mut total = 0;
    let mut joined = 1;
    for road in roads.iter() {
        let mut a = find(mut parent, road[0]);
        let mut b = find(mut parent, road[1]);
        if a != b {
            if size[a] < size[b] {
                let t = a;
                a = b;
                b = t;
            }
            parent[b] = a;
            size[a] += size[b];
            total += road[2];
            joined += 1;
        }
    }
    if joined == n { total } else { -1 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples and six more: three roads between the same
    // two cities, a ring of equal costs, a dear hub beside cheap roads, two
    // parts, a ring of falling costs, and the dearest roads
    let cases: Vec[(i64, Vec[Vec[i64]])] = [
        (3, [[1, 2, 5], [1, 3, 6], [2, 3, 1]]),
        (4, [[1, 2, 3], [3, 4, 4]]),
        (2, [[1, 2, 7], [2, 1, 3], [1, 2, 9]]),
        (4, [[1, 2, 1], [2, 3, 1], [3, 4, 1], [4, 1, 1]]),
        (5, [[1, 2, 10], [1, 3, 10], [1, 4, 10], [1, 5, 10], [2, 3, 1], [3, 4, 1]]),
        (5, [[1, 2, 4], [2, 3, 4], [4, 5, 4]]),
        (6, [[1, 2, 6], [2, 3, 5], [3, 4, 4], [4, 5, 3], [5, 6, 2], [6, 1, 1]]),
        (3, [[2, 3, 100000], [1, 2, 100000]]),
    ];
    for (n, roads) in cases.iter() {
        println(f"{n}, {roads} -> {minimum_cost(n, roads)}");
    }
    // 2000 random networks of 2 to 12 cities and 1 to 20 roads costing 1 to
    // 20: the costs summed, how many are not connected, and a checksum
    let mut seed = 1135;
    let mut total = 0;
    let mut none = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 11 + 2;
        let m = next_random(mut seed) % 20 + 1;
        let mut roads: Vec[Vec[i64]] = [];
        for _ in 0..m {
            let x = next_random(mut seed) % n + 1;
            let mut y = next_random(mut seed) % (n - 1) + 1;
            if y >= x {
                y += 1;
            }
            roads.push([x, y, next_random(mut seed) % 20 + 1]);
        }
        let r = minimum_cost(n, roads);
        if r == -1 {
            none += 1;
        } else {
            total += r;
        }
        check = (check * 31 + r + 1) % 1000000007;
    }
    println(f"2000 random networks: costs total {total}, {none} not connected, checksum {check}");
    // LeetCode's largest: 10000 cities on a random tree and one more road,
    // and 1000 cities with 10000 random roads, costs to 100000
    let mut tree: Vec[Vec[i64]] = [];
    for i in 2..10001 {
        let parent = next_random(mut seed) % (i - 1) + 1;
        let high = next_random(mut seed);
        tree.push([parent, i, (high * 32768 + next_random(mut seed)) % 100000 + 1]);
    }
    tree.push([1, 10000, 1]);
    println(f"10000 cities on a random tree and one more road: {minimum_cost(10000, tree)}");
    let mut dense: Vec[Vec[i64]] = [];
    for _ in 0..10000 {
        let x = next_random(mut seed) % 1000 + 1;
        let mut y = next_random(mut seed) % 999 + 1;
        if y >= x {
            y += 1;
        }
        let high = next_random(mut seed);
        dense.push([x, y, (high * 32768 + next_random(mut seed)) % 100000 + 1]);
    }
    println(f"1000 cities and 10000 random roads: {minimum_cost(1000, dense)}");
}
