// LeetCode #1185: Day of the Week -- a Rust solution as LeetCode's Rust
// users write it: the days counted from 1971 with an `is_leap` closure, the
// months walked over `(month - 1) as usize`, and the name indexed with
// `as usize`, inside `impl Solution` over `i32`; carried to Kāra by
// `karac fix`.

fn is_leap(year: i64) -> bool {
    (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
}

struct Solution {}

impl Solution {
    pub fn day_of_the_week(day: i32, month: i32, year: i32) -> String {
        let days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        let month_days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
        let is_leap = |y: i32| (y % 4 == 0 and y % 100 != 0) or y % 400 == 0;
        let mut total = 0;
        for y in 1971..year {
            total += if is_leap(y) { 366 } else { 365 };
        }
        for m in 0..(month - 1) as usize {
            total += month_days[m];
            if m == 1 and is_leap(year) {
                total += 1;
            }
        }
        total += day;
        days[((total + 4) % 7) as usize].to_string()
    }
}

fn day_of_the_week(day: i64, month: i64, year: i64) -> String {
    Solution.day_of_the_week(day as i32, month as i32, year as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"example 1: {day_of_the_week(31, 8, 2019)}");
    println(f"example 2: {day_of_the_week(18, 7, 1999)}");
    println(f"example 3: {day_of_the_week(15, 8, 1993)}");
    println(f"first day: {day_of_the_week(1, 1, 1971)}");
    println(f"last day: {day_of_the_week(31, 12, 2100)}");
    println(f"leap day 2000: {day_of_the_week(29, 2, 2000)}");
    println(f"after 28 February 2100: {day_of_the_week(1, 3, 2100)}");
    println(f"leap day 1972: {day_of_the_week(29, 2, 1972)}");
    let month_days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut seed: i64 = 1185;
    let mut checksum: i64 = 0;
    for t in 0..3000 {
        let year = 1971 + next_random(mut seed) % 130;
        let month = 1 + next_random(mut seed) % 12;
        let length = if month == 2 and is_leap(year) { 29 } else { month_days[month - 1] };
        let day = 1 + next_random(mut seed) % length;
        let name = day_of_the_week(day, month, year);
        checksum = (checksum * 31 + name.len() * 7 + name.bytes()[0] + t) % 1000000007;
    }
    println(f"3000 random dates: checksum {checksum}");
}
