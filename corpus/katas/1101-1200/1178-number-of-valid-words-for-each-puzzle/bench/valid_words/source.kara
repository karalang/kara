// LeetCode #1178: Number of Valid Words for Each Puzzle -- the ★ arm's
// bench: each word's letter set counted in a `Map`, each puzzle's subsets
// of its other six letters walked with `sub = (sub - 1) & rest`.

fn find_num_of_valid_words(words: Vec[String], puzzles: Vec[String]) -> Vec[i64] {
    let mut count: Map[i64, i64] = Map.new();
    for w in words.iter() {
        let mut mask = 0;
        for c in w.bytes().iter() {
            mask |= 1 << (c - b'a');
        }
        *count.entry(mask).or_insert(0) += 1;
    }
    let mut answer = Vec.new();
    for p in puzzles.iter() {
        let bytes = p.bytes();
        let first = 1 << (bytes[0] - b'a');
        let mut rest = 0;
        for c in bytes.iter().skip(1) {
            rest |= 1 << (c - b'a');
        }
        let mut total = 0;
        let mut sub = rest;
        loop {
            total += count.get_or(sub | first, 0);
            if sub == 0 {
                break;
            }
            sub = (sub - 1) & rest;
        }
        answer.push(total);
    }
    answer
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `k` distinct letters from the first `m`, in a random order.
fn distinct(seed: mut ref i64, m: i64, k: i64) -> Vec[u8] {
    let mut letters: Vec[u8] = (0..m).map(|i| b'a' + i as u8).collect();
    for i in 0..k {
        let j = i + next_random(mut seed) % (m - i);
        letters.swap(i, j);
    }
    letters.truncate(k);
    letters
}

fn main() {
    // 100000 words of 4 to 50 letters drawn from 1 to 7 of the first 14,
    // and 10000 puzzles of 7 distinct letters of the first 14, the
    // constraints' most, built once; then 20 calls, every answer folded
    // into a checksum
    let mut seed = 1178;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..100000 {
        let set = distinct(mut seed, 14, 1 + next_random(mut seed) % 7);
        let len = 4 + next_random(mut seed) % 47;
        words.push(String.from_utf8((0..len).map(|_| set[next_random(mut seed) % set.len()]).collect()).unwrap());
    }
    let puzzles: Vec[String] = (0..10000).map(|_| String.from_utf8(distinct(mut seed, 14, 7)).unwrap()).collect();
    let calls = 20;
    let mut check = 0;
    for _ in 0..calls {
        for a in find_num_of_valid_words(words, puzzles).iter() {
            check = (check * 131 + a + 1) % 1000000007;
        }
    }
    println(f"{calls} calls: checksum {check}");
}
