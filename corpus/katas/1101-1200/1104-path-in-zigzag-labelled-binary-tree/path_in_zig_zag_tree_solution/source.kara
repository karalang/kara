// LeetCode #1104: Path In Zigzag Labelled Binary Tree -- a Rust solution
// as LeetCode's Rust users write it, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn path_in_zig_zag_tree(label: i32) -> Vec[i32] {
        let mut level = 0;
        while (1 << level) <= label {
            level += 1;
        }
        let mut res = Vec.filled(level, 0i32);
        let mut cur = label;
        for i in (0..level).rev() {
            res[i] = cur;
            let lo: i32 = 1 << i;
            let hi: i32 = (1 << (i + 1)) - 1;
            cur = (lo + hi - cur) / 2;
        }
        res
    }
}

fn path_in_zig_zag_tree(label: i64) -> Vec[i64] {
    Solution.path_in_zig_zag_tree(label as i32).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(path: Vec[i64]) -> String {
    let parts: Vec[String] = path.iter().map(|x| x.to_string()).collect();
    f"[{parts.join(",")}]"
}

fn main() {
    for label in [14, 26, 1, 2, 3, 4, 7, 8, 15, 16, 100, 1000000] {
        println(f"{label}: {show(path_in_zig_zag_tree(label))}");
    }
    // every label from 1 to 2^14 - 1, the first fourteen rows
    let mut total = 0;
    let mut check = 0;
    for label in 1..16384 {
        let path = path_in_zig_zag_tree(label);
        for x in path.iter() {
            total += x;
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"labels 1 to 16383: path labels total {total}, checksum {check}");
    // 2000 random labels up to 10^6, LeetCode's most
    let mut seed = 1104;
    let mut steps = 0;
    check = 0;
    for _ in 0..2000 {
        let label = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        let path = path_in_zig_zag_tree(label);
        steps += path.len();
        for x in path.iter() {
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"2000 random labels: {steps} nodes on their paths, checksum {check}");
}
