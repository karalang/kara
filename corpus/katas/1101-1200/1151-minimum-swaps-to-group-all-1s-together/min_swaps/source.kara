// LeetCode #1151: Minimum Swaps to Group All 1's Together -- the ★ arm,
// a sliding window: the ones end up in some window as long as their
// count, and each zero in it costs one swap, so the answer is the count
// less the most ones any such window already holds. The window slides one
// place at a time, gaining a bit on the right and losing one on the left.
// O(n)

fn min_swaps(data: Vec[i64]) -> i64 {
    let k = data.iter().sum();
    if k == 0 {
        return 0;
    }
    let mut inside = 0;
    for i in 0..k {
        inside += data[i];
    }
    let mut most = inside;
    for i in k..data.len() {
        inside += data[i] - data[i - k];
        most = most.max(inside);
    }
    k - most
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` bits, each 1 with chance `ones` in 8.
fn bits(seed: mut ref i64, n: i64, ones: i64) -> Vec[i64] {
    (0..n).map(|_| if next_random(mut seed) % 8 < ones { 1 } else { 0 }).collect()
}

fn show(data: Vec[i64]) {
    println(f"data = {data}  ->  {min_swaps(data)}");
}

fn main() {
    show([1, 0, 1, 0, 1]);
    show([0, 0, 0, 1, 0]);
    show([1, 0, 1, 0, 1, 0, 0, 1, 1, 0, 1]);
    show([0]);
    show([1]);
    show([1, 1, 1]);
    show([1, 0, 0, 0, 1]);
    show([1, 1, 0, 0, 1, 1]);
    show([0, 1, 0, 1, 1, 0, 1, 0]);

    // 2000 random lists of 1 to 60 bits, each bit 1 with chance 0 to 8 in
    // 8, the chance drawn per list.
    let mut seed = 1151;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let ones = next_random(mut seed) % 9;
        let data = bits(mut seed, n, ones);
        let s = min_swaps(data);
        total += s;
        check = (check * 31 + s + n) % 1000000007;
    }
    println(f"2000 random lists: swaps total {total}, checksum {check}");

    let alternating: Vec[i64] = (0..100000).map(|i| (i + 1) % 2).collect();
    println(f"100000 bits 1, 0, 1, 0, ...  ->  {min_swaps(alternating)}");
    let all: Vec[i64] = Vec.filled(100000, 1);
    println(f"100000 ones  ->  {min_swaps(all)}");
    let ends: Vec[i64] = (0..100000).map(|i| if i < 25000 or i >= 75000 { 1 } else { 0 }).collect();
    println(f"25000 ones at each end of 100000 bits  ->  {min_swaps(ends)}");
    let none: Vec[i64] = Vec.filled(100000, 0);
    println(f"100000 zeros  ->  {min_swaps(none)}");
    let random = bits(mut seed, 100000, 3);
    println(f"100000 random bits, 3 in 8 ones  ->  {min_swaps(random)}");
}
