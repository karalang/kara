// LeetCode #1144: Decrease Elements To Make Array Zigzag -- a differential
// over the five arms. Each answer is checked against the statement read
// literally and against five properties that do not compute the answer;
// see the README.

// ---- moves_to_make_zigzag.kara ----

fn a0_moves_to_make_zigzag(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = i64.MAX;
    for low in 0..2 {
        let mut moves = 0;
        for i in (low..n).step_by(2) {
            let mut least = i64.MAX;
            if i > 0 {
                least = least.min(nums[i - 1]);
            }
            if i + 1 < n {
                least = least.min(nums[i + 1]);
            }
            if nums[i] >= least {
                moves += nums[i] - least + 1;
            }
        }
        best = best.min(moves);
    }
    best
}

// ---- moves_to_make_zigzag_windows.kara ----

fn a1_moves_to_make_zigzag(nums: Vec[i64]) -> i64 {
    let mut fenced: Vec[i64] = [i64.MAX];
    fenced.extend(nums.iter());
    fenced.push(i64.MAX);
    let mut moves = [0, 0];
    for (i, w) in fenced.windows(3).iter().enumerate() {
        let least = w[0].min(w[2]);
        if w[1] >= least {
            moves[i % 2] += w[1] - least + 1;
        }
    }
    moves[0].min(moves[1])
}

// ---- moves_to_make_zigzag_iter.kara ----

fn a2_moves_lowering(nums: Vec[i64], low: i64) -> i64 {
    let n = nums.len();
    (0..n)
        .filter(|i| i % 2 == low)
        .map(|i| {
            let left = if i > 0 { nums[i - 1] } else { i64.MAX };
            let right = if i + 1 < n { nums[i + 1] } else { i64.MAX };
            (nums[i] - left.min(right) + 1).max(0)
        })
        .sum()
}

fn a2_moves_to_make_zigzag(nums: Vec[i64]) -> i64 {
    a2_moves_lowering(nums, 0).min(a2_moves_lowering(nums, 1))
}

// ---- moves_to_make_zigzag_lowered.kara ----

fn a3_lowered(nums: Vec[i64], low: i64) -> Vec[i64] {
    let n = nums.len();
    let mut zigzag = nums.clone();
    let mut i = low;
    while i < n {
        if i > 0 and zigzag[i] >= nums[i - 1] {
            zigzag[i] = nums[i - 1] - 1;
        }
        if i + 1 < n and zigzag[i] >= nums[i + 1] {
            zigzag[i] = nums[i + 1] - 1;
        }
        i += 2;
    }
    zigzag
}

fn a3_moves_to_make_zigzag(nums: Vec[i64]) -> i64 {
    let total: i64 = nums.iter().sum();
    let mut best = i64.MAX;
    for low in 0..2 {
        let kept: i64 = a3_lowered(nums, low).iter().sum();
        best = best.min(total - kept);
    }
    best
}

// ---- moves_to_make_zigzag_solution.kara ----

struct A4Solution {}

impl A4Solution {
    pub fn a4_moves_to_make_zigzag(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let mut res = [0i32, 0];
        for i in 0..n {
            let left = if i > 0 { nums[i - 1] } else { 1001 };
            let right = if i + 1 < n { nums[i + 1] } else { 1001 };
            res[i % 2] += max(0, nums[i] - min(left, right) + 1);
        }
        min(res[0], res[1])
    }
}

fn a4_moves_to_make_zigzag(nums: Vec[i64]) -> i64 {
    let p: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    A4Solution.a4_moves_to_make_zigzag(p)
}

// ---- the differential -----------------------------------------------------

fn arm(which: i64, nums: Vec[i64]) -> i64 {
    match which {
        0 => a0_moves_to_make_zigzag(nums),
        1 => a1_moves_to_make_zigzag(nums),
        2 => a2_moves_to_make_zigzag(nums),
        3 => a3_moves_to_make_zigzag(nums),
        _ => a4_moves_to_make_zigzag(nums),
    }
}

// Whether every place of parity `p` is greater than its neighbours.
fn peaks_at(b: Vec[i64], p: i64) -> bool {
    let n = b.len();
    for i in 0..n {
        if i % 2 == p {
            if i > 0 and b[i] <= b[i - 1] {
                return false;
            }
            if i + 1 < n and b[i] <= b[i + 1] {
                return false;
            }
        }
    }
    true
}

// The statement's zigzag: every even-indexed element greater than its
// neighbours, or every odd-indexed one.
fn zigzag(b: Vec[i64]) -> bool {
    peaks_at(b, 0) or peaks_at(b, 1)
}

// Every way to lower each element, from itself down to 0, one place at a
// time: a way stops once its moves reach the best found, or once two
// neighbours stand equal or two rises or falls run together, which no
// zigzag has; each finished way that is a zigzag is a candidate.
fn search(nums: Vec[i64], b: mut ref Vec[i64], i: i64, moves: i64, best: mut ref i64) {
    if moves >= *best {
        return;
    }
    if i >= 2 and b[i - 2] == b[i - 1] {
        return;
    }
    if i >= 3 and (b[i - 3] < b[i - 2]) == (b[i - 2] < b[i - 1]) {
        return;
    }
    if i == nums.len() {
        if zigzag(b) {
            *best = moves;
        }
        return;
    }
    for v in (0..nums[i] + 1).rev() {
        b[i] = v;
        search(nums, mut b, i + 1, moves + nums[i] - v, mut best);
    }
}

// The statement read literally: the fewest moves, each lowering one
// element by 1, that leave a zigzag.
fn literal(nums: Vec[i64]) -> i64 {
    let mut b = nums.clone();
    let mut best: i64 = nums.iter().sum() + 1;
    search(nums, mut b, 0, 0, mut best);
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 1 to 8 values: from 1 to 20; from 1 to 3, so neighbours tie; all one
// value; or from 1 to 20 sorted, rising or falling, which no zigzag is.
fn problem(seed: mut ref i64, kind: i64) -> Vec[i64] {
    let n = next_random(mut seed) % 8 + 1;
    if kind == 2 {
        return Vec.filled(n, next_random(mut seed) % 20 + 1);
    }
    let top = if kind == 1 { 3 } else { 20 };
    let mut nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
    if kind == 3 {
        nums.sort();
        if next_random(mut seed) % 2 == 1 {
            nums.reverse();
        }
    }
    nums
}

struct Choice {
    lift: i64,
    at: i64,
    rise: i64,
    cut: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i64], c: Choice) {
    let want = literal(nums);
    let n = nums.len();
    let back: Vec[i64] = nums.iter().rev().collect();
    let lifted: Vec[i64] = nums.iter().map(|x| x + c.lift).collect();
    let doubled: Vec[i64] = nums.iter().map(|x| x * 2).collect();
    let mut raised = nums.clone();
    raised[c.at] += c.rise;
    for w in 0..5 {
        let answer = arm(w, nums);
        let what = f"arm {w}, case {t.cases} {nums} -> {answer}";
        // P1: the statement read literally
        expect(mut t, 1, answer == want, f"P1 {what}, literally {want}");
        // P2: the array backwards
        let b = arm(w, back);
        expect(mut t, 2, b == answer, f"P2 {what}, backwards {b}");
        // P3: every element raised alike
        let l = arm(w, lifted);
        expect(mut t, 3, l == answer, f"P3 {what}, lifted by {c.lift} {l}");
        // P4: every element doubled, no fewer moves and no more than twice
        let d = arm(w, doubled);
        expect(mut t, 4, d >= answer and d <= 2 * answer, f"P4 {what}, doubled {d}");
        // P5: one element raised costs no more than the rise
        let r = arm(w, raised);
        expect(mut t, 5, r <= answer + c.rise, f"P5 {what}, place {c.at} raised by {c.rise} {r}");
        // P6: cut in two, the parts' moves sum to no more
        if n >= 2 {
            let left = arm(w, nums[0..c.cut].to_vec());
            let right = arm(w, nums[c.cut..n].to_vec());
            expect(mut t, 6, left + right <= answer, f"P6 {what}, cut at {c.cut} {left} + {right}");
        }
    }
    t.cases += 1;
    t.check = (t.check * 131 + want + 1) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 arrays in four kinds, 500 each. Every choice, P3's lift, P5's
    // place and rise and P6's cut among them, is drawn before any arm
    // answers.
    let mut seed = 11441;
    let mut problems: Vec[(Vec[i64], Choice)] = [];
    for i in 0..2000 {
        let nums = problem(mut seed, i % 4);
        let n = nums.len();
        let lift = next_random(mut seed) % 50 + 1;
        let at = next_random(mut seed) % n;
        let rise = next_random(mut seed) % 50 + 1;
        let cut = if n >= 2 { next_random(mut seed) % (n - 1) + 1 } else { 0 };
        problems.push((nums, Choice { lift, at, rise, cut }));
    }
    for (nums, c) in problems.iter() {
        check_case(mut t, nums.clone(), Choice { lift: c.lift, at: c.at, rise: c.rise, cut: c.cut });
    }
    println(f"{t.cases} arrays: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
