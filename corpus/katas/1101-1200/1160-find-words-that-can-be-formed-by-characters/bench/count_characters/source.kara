// LeetCode #1160: Find Words That Can Be Formed by Characters -- the ★
// arm, counts of each letter in fixed arrays of 26: `chars` counted once,
// and a word is good when no letter of it is counted more than `chars`
// holds.
// O(|chars| + total letters + 26 words).

fn count_characters(words: Vec[String], chars: Str) -> i64 {
    let mut have = [0; 26];
    for c in chars.bytes().iter() {
        have[c - b'a'] += 1;
    }
    let mut total = 0;
    for w in words.iter() {
        let mut need = [0; 26];
        let mut good = true;
        for c in w.bytes().iter() {
            need[c - b'a'] += 1;
            if need[c - b'a'] > have[c - b'a'] {
                good = false;
                break;
            }
        }
        if good {
            total += w.len();
        }
    }
    total
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(seed: mut ref i64, len: i64, k: i64) -> String {
    let b: Vec[u8] = (0..len).map(|_| b'a' + (next_random(mut seed) % k) as u8).collect();
    String.from_utf8(b).unwrap()
}

fn main() {
    // 12 problems of 1000 words, the most the constraints allow, built
    // once, each `chars` of 100 letters, three kinds in turn: words of 1
    // to 100 letters over 26, words of 1 to 30 over 4 with `chars` over
    // 4, and words drawn from `chars`, each place kept with odds one in
    // two and every other word given one letter too many. Each of 1500
    // passes answers all 12.
    let passes = 1500;
    let mut seed = 1160;
    let mut problems: Vec[(Vec[String], String)] = [];
    for p in 0..12 {
        let kind = p % 3;
        let chars = word(mut seed, 100, if kind == 1 { 4 } else { 26 });
        let words: Vec[String] = (0..1000).map(|i| {
            if kind == 0 {
                word(mut seed, 1 + next_random(mut seed) % 100, 26)
            } else if kind == 1 {
                word(mut seed, 1 + next_random(mut seed) % 30, 4)
            } else {
                let mut b: Vec[u8] = chars.bytes().iter().filter(|_| next_random(mut seed) % 2 == 0).collect();
                if i % 2 == 1 {
                    b.push(b[next_random(mut seed) % b.len()]);
                }
                String.from_utf8(b).unwrap()
            }
        }).collect();
        problems.push((words, chars));
    }
    let mut check = 0;
    for p in 0..passes {
        for (words, chars) in problems.iter() {
            check = (check * 31 + count_characters(words, chars) + p) % 1000000007;
        }
    }
    println(f"{passes} passes over 12 problems of 1000 words: checksum {check}");
}
