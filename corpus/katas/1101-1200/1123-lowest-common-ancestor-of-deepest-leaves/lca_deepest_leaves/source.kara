// LeetCode #1123: Lowest Common Ancestor of Deepest Leaves -- the ★ arm,
// one walk from the root: each call returns its subtree's depth and the
// ancestor of its deepest leaves, the node itself when its two sides are
// as deep, otherwise the deeper side's. O(n).

fn walk(node: Option[TreeNode]) -> (i64, Option[TreeNode]) {
    let Some(n) = node else {
        return (0, None);
    };
    let (ld, la) = walk(n.left);
    let (rd, ra) = walk(n.right);
    if ld == rd {
        (ld + 1, Some(n))
    } else if ld > rd {
        (ld + 1, la)
    } else {
        (rd + 1, ra)
    }
}

fn lca_deepest_leaves(root: Option[TreeNode]) -> Option[TreeNode] {
    walk(root).1
}

// ---- test harness ---------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i32) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order form, "[1,2,null,4]": each node's two children
// come next, in the order the nodes were met, "null" for none.
fn parse(text: Str) -> Option[TreeNode] {
    let inner = text.strip_prefix("[").unwrap().strip_suffix("]").unwrap();
    if inner.is_empty() {
        return None;
    }
    let items: Vec[Option[i32]] = inner.split(",").map(|s| if s == "null" { None } else { Some(i32.parse(s).unwrap()) }).collect();
    let root = leaf(items[0].unwrap());
    let mut queue: Vec[TreeNode] = [root];
    let mut head = 0;
    let mut i = 1;
    while i < items.len() {
        let node = queue[head];
        head += 1;
        if let Some(v) = items[i] {
            let child = leaf(v);
            node.left = Some(child);
            queue.push(child);
        }
        i += 1;
        if i < items.len() {
            if let Some(v) = items[i] {
                let child = leaf(v);
                node.right = Some(child);
                queue.push(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// The same form back, with the trailing nulls dropped.
fn show(root: Option[TreeNode]) -> String {
    let mut items: Vec[String] = [];
    let mut queue: Vec[Option[TreeNode]] = [root];
    let mut head = 0;
    while head < queue.len() {
        let node = queue[head];
        head += 1;
        match node {
            Some(n) => {
                items.push(f"{n.val}");
                queue.push(n.left);
                queue.push(n.right);
            }
            None => items.push("null"),
        }
    }
    while items.len() > 0 and items[items.len() - 1] == "null" {
        items.pop();
    }
    f"[{items.join(",")}]"
}

fn size(node: Option[TreeNode]) -> i64 {
    match node {
        Some(n) => 1 + size(n.left) + size(n.right),
        None => 0,
    }
}

// A random tree of `count` nodes with distinct values from 0 to 1000,
// each node hung at a random free place below the ones before it; with
// `deep`, the place is always below the newest node half the time, so
// the tree grows long branches.
fn random_tree(seed: mut ref i64, count: i64, deep: bool) -> TreeNode {
    let mut pool: Vec[i32] = (0..1001).map(|v| v as i32).collect();
    for j in (1..pool.len()).rev() {
        pool.swap(j, next_random(mut seed) % (j + 1));
    }
    let root = leaf(pool[0]);
    let mut nodes: Vec[TreeNode] = [root];
    for i in 1..count {
        let c = leaf(pool[i]);
        loop {
            let at = if deep and next_random(mut seed) % 2 == 0 {
                nodes[nodes.len() - 1]
            } else {
                nodes[next_random(mut seed) % nodes.len()]
            };
            if next_random(mut seed) % 2 == 0 {
                if at.left.is_none() {
                    at.left = Some(c);
                    break;
                }
            } else if at.right.is_none() {
                at.right = Some(c);
                break;
            }
        }
        nodes.push(c);
    }
    root
}

fn main() {
    // LeetCode's three examples and five more: two deepest leaves under
    // the root, one deepest leaf on a long branch, a full tree, a chain
    // to the left, and the deepest leaves in one subtree
    let cases = [
        "[3,5,1,6,2,0,8,null,null,7,4]",
        "[1]",
        "[0,1,3,null,2]",
        "[1,2,3]",
        "[1,2,3,4,null,null,null,5]",
        "[1,2,3,4,5,6,7]",
        "[1,2,null,3,null,4]",
        "[1,2,3,null,4,null,null,5,6]",
    ];
    for c in cases.iter() {
        println(f"{c} -> {show(lca_deepest_leaves(parse(c)))}");
    }
    // 2000 random trees of up to 1000 nodes, LeetCode's limit, every
    // other one grown deep: the answers' sizes and a checksum
    let mut seed = 1123;
    let mut nodes = 0;
    let mut check = 0;
    for t in 0..2000 {
        let count = next_random(mut seed) % 1000 + 1;
        let root = random_tree(mut seed, count, t % 2 == 1);
        let answer = lca_deepest_leaves(Some(root));
        let n = size(answer);
        nodes += n;
        check = (check * 31 + answer.unwrap().val + n) % 1000000007;
    }
    println(f"2000 random trees: {nodes} nodes under the answers, checksum {check}");
}
