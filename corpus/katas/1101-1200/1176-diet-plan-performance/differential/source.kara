// LeetCode #1176: Diet Plan Performance -- the differential: the six arms
// against the statement read literally, and five properties of what they
// return.

// ---- diet_plan.kara ----

fn a0_diet_plan_performance(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    let mut points = 0;
    let mut total = 0;
    for (i, c) in calories.iter().enumerate() {
        total += c;
        if i >= k {
            total -= calories[i - k];
        }
        if i >= k - 1 {
            if total < lower {
                points -= 1;
            } else if total > upper {
                points += 1;
            }
        }
    }
    points
}

// ---- diet_plan_prefix.kara ----

fn a1_diet_plan_performance(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    let mut sums = [0];
    for c in calories.iter() {
        sums.push(sums[sums.len() - 1] + c);
    }
    let mut points = 0;
    for i in 0..=calories.len() - k {
        let total = sums[i + k] - sums[i];
        if total < lower {
            points -= 1;
        } else if total > upper {
            points += 1;
        }
    }
    points
}

// ---- diet_plan_windows.kara ----

fn a2_score(total: i64, lower: i64, upper: i64) -> i64 {
    if total < lower {
        -1
    } else if total > upper {
        1
    } else {
        0
    }
}

fn a2_diet_plan_performance(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    calories.windows(k).iter().map(|w| a2_score(w.iter().sum(), lower, upper)).sum()
}

// ---- diet_plan_queue.kara ----

fn a3_diet_plan_performance(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    let mut window: VecDeque[i64] = VecDeque.new();
    let mut total = 0;
    let mut points = 0;
    for c in calories.iter() {
        window.push_back(c);
        total += c;
        if window.len() > k {
            total -= window.pop_front().unwrap();
        }
        if window.len() == k {
            if total < lower {
                points -= 1;
            } else if total > upper {
                points += 1;
            }
        }
    }
    points
}

// ---- diet_plan_solution.kara ----

struct A4Solution {}

impl A4Solution {
    pub fn diet_plan_performance(calories: Vec[i32], k: i32, lower: i32, upper: i32) -> i32 {
        let k = k as i64;
        let mut sum: i32 = calories[..k].iter().sum();
        let a4_score = |s: i32| if s < lower { -1 } else if s > upper { 1 } else { 0 };
        let mut points = a4_score(sum);
        for i in k..calories.len() {
            sum += calories[i] - calories[i - k];
            points += a4_score(sum);
        }
        points
    }
}

fn a4_diet_plan_performance(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    A4Solution.diet_plan_performance(calories.iter().map(|c| c as i32).collect(), k as i32, lower as i32, upper as i32)
}

// ---- diet_plan_chain.kara ----

struct A5Solution {}

impl A5Solution {
    pub fn diet_plan_performance(calories: Vec[i32], k: i32, lower: i32, upper: i32) -> i32 {
        calories
            .windows(k).into_iter()
            .map(|w| w.iter().sum())
            .map(|t| if t < lower { -1 } else if t > upper { 1 } else { 0 })
            .sum()
    }
}

fn a5_diet_plan_performance(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    A5Solution.diet_plan_performance(calories.iter().map(|c| c as i32).collect(), k as i32, lower as i32, upper as i32)
}

// ---- the differential -----------------------------------------------------

fn arm(w: i64, calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    match w {
        0 => a0_diet_plan_performance(calories, k, lower, upper),
        1 => a1_diet_plan_performance(calories, k, lower, upper),
        2 => a2_diet_plan_performance(calories, k, lower, upper),
        3 => a3_diet_plan_performance(calories, k, lower, upper),
        4 => a4_diet_plan_performance(calories, k, lower, upper),
        _ => a5_diet_plan_performance(calories, k, lower, upper),
    }
}

// The statement read literally: for every i from 0 to n - k, the calories
// of days i to i + k - 1 counted afresh, a point lost below `lower`, one
// gained above `upper`.
fn literal(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    let mut points = 0;
    for i in 0..=calories.len() - k {
        let mut t = 0;
        for j in i..i + k {
            t += calories[j];
        }
        if t < lower {
            points -= 1;
        }
        if t > upper {
            points += 1;
        }
    }
    points
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, w: i64, p: i64, plan: i64, got: i64, want: i64) {
    t.checks += 1;
    if got != want {
        t.failures += 1;
        t.by[p] += 1;
        if t.failures <= 5 {
            println(f"arm {w}, P{p}, plan {plan}: got {got}, want {want}");
        }
    }
}

const NONE_ABOVE: i64 = 1000000000;

fn main() {
    let mut t = Tally { checks: 0, failures: 0, check: 0, by: Vec.filled(6, 0) };
    // 400 plans of 1 to 30 days, values to 9, the bounds near the windows'
    // sums; the first ten have one day, or k = n
    let mut seed = 11760;
    for plan in 0..400 {
        let n = if plan < 5 { 1 } else { 1 + next_random(mut seed) % 30 };
        let calories: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10).collect();
        let k = if plan < 10 { n } else { 1 + next_random(mut seed) % n };
        let lower = next_random(mut seed) % (5 * k + 1);
        let upper = lower + next_random(mut seed) % (4 * k + 1);
        let c = next_random(mut seed) % 50;
        let shifted: Vec[i64] = calories.iter().map(|x| x + c).collect();
        let windows = n - k + 1;
        let want = literal(calories, k, lower, upper);
        let star = arm(0, calories, k, lower, upper);
        for w in 0..6 {
            let a = arm(w, calories, k, lower, upper);
            t.check = (t.check * 131 + a + 100000) % 1000000007;
            // P1: the statement read literally
            expect(mut t, w, 1, plan, a, want);
            // P2: the points lost below `lower` and those gained above
            // `upper` counted apart add up to the answer (no day is
            // negative, so no window is below -1)
            let below = arm(w, calories, k, lower, NONE_ABOVE);
            let above = arm(w, calories, k, -1, upper);
            expect(mut t, w, 2, plan, below + above, a);
            // P3: every day c more, and both bounds k * c more, scores
            // every window the same
            expect(mut t, w, 3, plan, arm(w, shifted, k, lower + k * c, upper + k * c), a);
            // P4: bounds no window can meet score every window: all
            // below, or all above
            expect(mut t, w, 4, plan, arm(w, calories, k, NONE_ABOVE, NONE_ABOVE), -windows);
            expect(mut t, w, 4, plan, arm(w, calories, k, -1, -1), windows);
            // P5: the ★ arm's answer
            expect(mut t, w, 5, plan, a, star);
        }
    }
    println(f"400 plans: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..6).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
