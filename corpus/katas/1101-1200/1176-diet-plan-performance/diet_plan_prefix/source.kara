// LeetCode #1176: Diet Plan Performance -- prefix sums: `sums[i]` the
// calories of the first `i` days, so each window's total is one
// subtraction, `sums[i + k] - sums[i]`. O(n) time and O(n) space.

fn diet_plan_performance(calories: Vec[i64], k: i64, lower: i64, upper: i64) -> i64 {
    let mut sums = [0];
    for c in calories.iter() {
        sums.push(sums[sums.len() - 1] + c);
    }
    let mut points = 0;
    for i in 0..=calories.len() - k {
        let total = sums[i + k] - sums[i];
        if total < lower {
            points -= 1;
        } else if total > upper {
            points += 1;
        }
    }
    points
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"example 1: {diet_plan_performance([1, 2, 3, 4, 5], 1, 3, 3)}");
    println(f"example 2: {diet_plan_performance([3, 2], 2, 0, 1)}");
    println(f"example 3: {diet_plan_performance([6, 5, 0, 0], 2, 1, 5)}");
    // one window over every day; sums exactly at each bound, which score
    // nothing; every day 0 under a lower bound of 0
    println(f"one window: {diet_plan_performance([4, 4, 4], 3, 13, 20)} {diet_plan_performance([4, 4, 4], 3, 1, 11)}");
    println(f"at the bounds: {diet_plan_performance([1, 2, 3, 4], 2, 3, 7)}");
    println(f"all zero: {diet_plan_performance([0, 0, 0, 0, 0], 2, 0, 0)} {diet_plan_performance([0, 0, 0, 0, 0], 2, 1, 1)}");
    // 300 random plans of 1 to 40 days, values to 9, bounds near the
    // windows' sums so that every outcome comes up
    let mut seed = 1176;
    let mut check = 0;
    let mut points = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 40;
        let calories: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10).collect();
        let k = 1 + next_random(mut seed) % n;
        let lower = next_random(mut seed) % (5 * k + 1);
        let upper = lower + next_random(mut seed) % (4 * k + 1);
        let p = diet_plan_performance(calories, k, lower, upper);
        points += p;
        check = (check * 131 + p + 100000) % 1000000007;
    }
    println(f"300 random plans: {points} points, checksum {check}");
    // 100000 days, the constraints' most, each up to 20000, at k = 1,
    // 317 and 100000, and the bounds around the mean window's sum
    let calories: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 20001).collect();
    let average = calories.iter().sum() / 100000;
    for k in [1, 317, 100000] {
        let mean = average * k;
        println(f"100000 days, k = {k}: {diet_plan_performance(calories, k, mean - 40 * k, mean + 40 * k)}");
    }
}
