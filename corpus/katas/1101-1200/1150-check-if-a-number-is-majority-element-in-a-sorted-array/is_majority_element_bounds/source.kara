// LeetCode #1150: Check If a Number Is Majority Element in a Sorted Array
// -- both ends of the target's run by binary search, and the run's length
// against half the list. O(log n)

fn is_majority_element(nums: Vec[i64], target: i64) -> bool {
    let first = nums.partition_point(|x| x < target);
    let last = nums.partition_point(|x| x <= target);
    2 * (last - first) > nums.len()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A value from 1 to 10^9.
fn big(seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1
}

// A sorted list and a target in one of four kinds: values 1 to 3 and a
// target 1 to 4; values up to 10^9 and a target drawn from the list;
// about half the list one target, the rest above and below it; values 1
// to 2 and the middle value as the target.
fn problem(seed: mut ref i64, kind: i64) -> (Vec[i64], i64) {
    let n = 1 + next_random(mut seed) % 60;
    let mut nums: Vec[i64] = [];
    let mut target = 0;
    if kind == 0 {
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % 3);
        }
        target = 1 + next_random(mut seed) % 4;
    } else if kind == 1 {
        for _ in 0..n {
            nums.push(big(mut seed));
        }
        target = nums[next_random(mut seed) % n];
    } else if kind == 2 {
        target = 2 + big(mut seed) % 999999998;
        let copies = (n / 2 + next_random(mut seed) % 3 - 1).clamp(0, n);
        for _ in 0..copies {
            nums.push(target);
        }
        for _ in copies..n {
            if next_random(mut seed) % 2 == 0 {
                nums.push(1 + next_random(mut seed) % (target - 1));
            } else {
                nums.push(target + 1 + next_random(mut seed) % (1000000000 - target));
            }
        }
    } else {
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % 2);
        }
    }
    nums.sort();
    if kind == 3 {
        target = nums[n / 2];
    }
    (nums, target)
}

fn show(nums: Vec[i64], target: i64) {
    println(f"nums = {nums}, target = {target}  ->  {is_majority_element(nums, target)}");
}

// `count` copies of `target` from index `at` in a list of 1000 whose other
// values are 1 below it and 1 above.
fn run(target: i64, count: i64, at: i64) -> Vec[i64] {
    (0..1000).map(|i| if i < at { target - 1 } else if i < at + count { target } else { target + 1 }).collect()
}

fn main() {
    show([2, 4, 5, 5, 5, 5, 5, 6, 6], 5);
    show([10, 100, 101, 101], 101);
    show([7], 7);
    show([7], 8);
    show([1, 1, 2, 2], 1);
    show([1, 1, 2, 2], 2);
    show([1, 2, 2], 2);
    show([1, 1, 2], 1);
    show([3, 3, 3], 1);
    show([3, 3, 3], 9);

    let mut seed = 1150;
    let mut yes = 0;
    let mut check = 0;
    for i in 0..2000 {
        let (nums, target) = problem(mut seed, i % 4);
        let m = is_majority_element(nums, target);
        if m {
            yes += 1;
        }
        check = (check * 31 + if m { 2 } else { 1 }) % 1000000007;
    }
    println(f"2000 random lists: majority {yes}, checksum {check}");

    let all: Vec[i64] = Vec.filled(1000, 1000000000);
    println(f"1000 copies of 10^9, target 10^9  ->  {is_majority_element(all, 1000000000)}");
    for (count, at) in [(501, 0), (501, 499), (501, 250), (500, 0), (500, 500), (500, 250)] {
        println(f"{count} copies of 7 from index {at} of 1000  ->  {is_majority_element(run(7, count, at), 7)}");
    }
}
