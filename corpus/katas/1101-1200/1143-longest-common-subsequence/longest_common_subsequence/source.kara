// LeetCode #1143: Longest Common Subsequence -- a table of the longest
// common subsequence of every two prefixes, filled row by row: one more
// than the two prefixes without their last letters when those letters
// match, and otherwise the longer of the two with one letter dropped.
// O(m * n)

fn longest_common_subsequence(text1: String, text2: String) -> i64 {
    let a: Vec[char] = text1.chars().collect();
    let b: Vec[char] = text2.chars().collect();
    let (m, n) = (a.len(), b.len());
    let mut best = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    for i in 1..m + 1 {
        for j in 1..n + 1 {
            best[i][j] = if a[i - 1] == b[j - 1] {
                best[i - 1][j - 1] + 1
            } else {
                best[i - 1][j].max(best[i][j - 1])
            };
        }
    }
    best[m][n]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters drawn from the first `k` of the alphabet.
fn random_text(seed: mut ref i64, n: i64, k: i64) -> String {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    (0..n).map(|_| letters[next_random(mut seed) % k]).collect()
}

fn main() {
    // LeetCode's three examples
    println(f"example 1: {longest_common_subsequence("abcde", "ace")}");
    println(f"example 2: {longest_common_subsequence("abc", "abc")}");
    println(f"example 3: {longest_common_subsequence("abc", "def")}");
    // one letter each, alike and not; one text inside the other; a text
    // and itself backwards; letters that cross
    println(f"one letter, alike: {longest_common_subsequence("a", "a")}");
    println(f"one letter, not: {longest_common_subsequence("a", "b")}");
    println(f"one inside the other: {longest_common_subsequence("xaxbxcx", "abc")}");
    println(f"backwards: {longest_common_subsequence("abcdef", "fedcba")}");
    println(f"crossing: {longest_common_subsequence("abab", "baba")}");
    // 2000 random pairs of 1 to 40 letters from 2, 4 or 26 letters: the
    // answers summed and a checksum
    let mut seed = 1143;
    let mut total = 0;
    let mut check = 0;
    for i in 0..2000 {
        let k = [2, 4, 26][i % 3];
        let n1 = next_random(mut seed) % 40 + 1;
        let n2 = next_random(mut seed) % 40 + 1;
        let t1 = random_text(mut seed, n1, k);
        let t2 = random_text(mut seed, n2, k);
        let answer = longest_common_subsequence(t1, t2);
        total += answer;
        check = (check * 131 + answer + 1) % 1000000007;
    }
    println(f"2000 random pairs: answers total {total}, checksum {check}");
    // the longest the constraints allow, 1000 letters each: from 4
    // letters; from 26; and one text the other with every tenth letter
    // changed
    let a = random_text(mut seed, 1000, 4);
    let b = random_text(mut seed, 1000, 4);
    println(f"1000 and 1000 of 4 letters: {longest_common_subsequence(a, b)}");
    let c = random_text(mut seed, 1000, 26);
    let d = random_text(mut seed, 1000, 26);
    println(f"1000 and 1000 of 26 letters: {longest_common_subsequence(c, d)}");
    let e = random_text(mut seed, 1000, 26);
    let f: String = e.chars().enumerate().map(|(i, ch)| if i % 10 == 0 { 'z' } else { ch }).collect();
    println(f"1000 letters, every tenth changed: {longest_common_subsequence(e, f)}");
}
