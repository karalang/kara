// LeetCode #1129: Shortest Path with Alternating Colors -- the bench: the
// ★ arm over 32 graphs of 100 nodes with 400 red and 400 blue edges,
// LeetCode's largest, built once, each of 1000 rounds moving one edge's
// end in every graph and answering the graph again.

fn shortest_alternating_paths(n: i64, red_edges: Vec[Vec[i64]], blue_edges: Vec[Vec[i64]]) -> Vec[i64] {
    let mut adj: Vec[Vec[Vec[i64]]] = Vec.filled(2, Vec.filled(n, []));
    for e in red_edges.iter() {
        adj[0][e[0]].push(e[1]);
    }
    for e in blue_edges.iter() {
        adj[1][e[0]].push(e[1]);
    }
    let mut dist = Vec.filled(2, Vec.filled(n, -1));
    dist[0][0] = 0;
    dist[1][0] = 0;
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    queue.push_back((0, 0));
    queue.push_back((0, 1));
    while let Some((node, colour)) = queue.pop_front() {
        let next = 1 - colour;
        for m in adj[next][node].iter() {
            if dist[next][m] < 0 {
                dist[next][m] = dist[colour][node] + 1;
                queue.push_back((m, next));
            }
        }
    }
    (0..n).map(|x| {
        let (a, b) = (dist[0][x], dist[1][x]);
        if a < 0 { b } else if b < 0 { a } else { a.min(b) }
    }).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn edges(seed: mut ref i64, n: i64, m: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = [];
    for _ in 0..m {
        let a = next_random(mut seed) % n;
        let b = next_random(mut seed) % n;
        out.push([a, b]);
    }
    out
}

fn main() {
    let mut seed = 1129;
    let mut reds: Vec[Vec[Vec[i64]]] = [];
    let mut blues: Vec[Vec[Vec[i64]]] = [];
    for _ in 0..32 {
        reds.push(edges(mut seed, 100, 400));
        blues.push(edges(mut seed, 100, 400));
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..1000 {
        for j in 0..32 {
            let at = (round * 7919 + j * 104729) % 400;
            if round % 2 == 0 {
                reds[j][at][1] = (reds[j][at][1] + 1 + round % 7) % 100;
            } else {
                blues[j][at][1] = (blues[j][at][1] + 1 + round % 7) % 100;
            }
            let answer = shortest_alternating_paths(100, reds[j], blues[j]);
            for d in answer.iter() {
                total += d;
                check = (check * 31 + d + 2) % 1000000007;
            }
        }
    }
    println(f"1000 rounds over 32 graphs of 100 nodes and 400 edges of each colour: lengths total {total}, checksum {check}");
}
