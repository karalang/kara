// LeetCode #1199: Minimum Time to Build Blocks -- another Rust solution,
// the table as a recursion with a memo: the blocks sorted slowest first,
// and a nested `fn dp(i, w, ..)` over the next block and the workers on
// hand, carried to Kāra by `karac fix`.

struct Solution {}

fn dp(i: i64, w: i64, blocks: Slice[i32], split: i32, memo: mut ref Vec[Vec[i32]]) -> i32 {
    if i == blocks.len() {
        return 0;
    }
    if w == 0 {
        return i32.MAX;
    }
    if w >= blocks.len() - i {
        return blocks[i];
    }
    if memo[i][w] != -1 {
        return memo[i][w];
    }
    let spread = split + dp(i, (2 * w).min(blocks.len()), blocks, split, mut memo);
    let one = blocks[i].max(dp(i + 1, w - 1, blocks, split, mut memo));
    memo[i][w] = spread.min(one);
    memo[i][w]
}

impl Solution {
    pub fn min_build_time(blocks: own Vec[i32], split: i32) -> i32 {
        let mut blocks = blocks;
        blocks.sort_by(|a, b| b.cmp(a));
        let n = blocks.len();
        let mut memo = Vec.filled(n + 1, Vec.filled(n + 1, -1));
        dp(0, 1, blocks, split, mut memo)
    }
}

fn min_build_time(blocks: own Vec[i64], split: i64) -> i64 {
    Solution.min_build_time(blocks.iter().map(|b| b as i32).collect(), split as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = [([1], 1), ([1, 2], 5), ([1, 2, 3], 1), ([5, 5, 5, 5], 2), ([1, 1, 1, 100], 10), ([10, 1, 1, 1, 1], 3)];
    for (blocks, split) in cases.iter() {
        println(f"{blocks}, split {split}: {min_build_time(blocks.clone(), split)}");
    }
    println(f"1000 blocks of 1, split 100: {min_build_time(Vec.filled(1000, 1), 100)}");
    println(f"1000 blocks of 100000, split 100: {min_build_time(Vec.filled(1000, 100000), 100)}");
    println(f"512 blocks of 7, split 1: {min_build_time(Vec.filled(512, 7), 1)}");
    println(f"1000 blocks of 7, split 1: {min_build_time(Vec.filled(1000, 7), 1)}");
    println(f"513 blocks of 7, split 1: {min_build_time(Vec.filled(513, 7), 1)}");
    let mut seed = 1199;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 12 + 1;
        let split = next_random(mut seed) % 20 + 1;
        let blocks: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 50 + 1).collect();
        let t = min_build_time(blocks, split);
        total += t;
        check = (check * 131 + t) % 1000000007;
    }
    println(f"1000 random block sets: total {total}, checksum {check}");
    let big: Vec[i64] = (0..1000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1).collect();
    println(f"1000 random blocks up to 100000, split 100: {min_build_time(big.clone(), 100)}");
    println(f"the same, split 1: {min_build_time(big, 1)}");
}
