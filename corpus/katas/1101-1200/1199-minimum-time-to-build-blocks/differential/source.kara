// LeetCode #1199: Minimum Time to Build Blocks -- the six arms against
// the statement read literally and six more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_min_build_time(blocks: own Vec[i64], split: i64) -> i64 {
    let mut queue = PriorityQueue.from(blocks);
    while queue.len() > 1 {
        let _ = queue.pop();
        let slower = queue.pop().unwrap();
        queue.push(slower + split);
    }
    queue.pop().unwrap()
}

// ---- arm 1: queues ------------------------------------------------------
fn a1_min_build_time(blocks: own Vec[i64], split: i64) -> i64 {
    let mut blocks = blocks;
    blocks.sort();
    let mut merged: VecDeque[i64] = VecDeque.new();
    let mut next = 0;
    let mut left = blocks.len();
    while left > 1 {
        let mut two = [0, 0];
        for k in 0..2 {
            let from_blocks = next < blocks.len() and (merged.is_empty() or blocks[next] <= merged[0]);
            if from_blocks {
                two[k] = blocks[next];
                next += 1;
            } else {
                two[k] = merged.pop_front().unwrap();
            }
        }
        merged.push_back(two[1] + split);
        left -= 1;
    }
    if next < blocks.len() { blocks[next] } else { merged[0] }
}

// ---- arm 2: search ------------------------------------------------------
fn a2_fits(blocks: Vec[i64], split: i64, t: i64) -> bool {
    let n = blocks.len();
    // at[d]: the blocks that may sit at most d splits deep, d capped at n
    let mut at = Vec.filled(n + 1, 0);
    for b in blocks.iter() {
        if b > t {
            return false;
        }
        at[((t - b) / split).min(n)] += 1;
    }
    let mut need = 0;
    for d in (0..=n).rev() {
        need = at[d] + (need + 1) / 2;
    }
    need <= 1
}

fn a2_min_build_time(blocks: Vec[i64], split: i64) -> i64 {
    let mut low = blocks.iter().max().unwrap();
    let mut high = low + 10 * split;
    while low < high {
        let mid = (low + high) / 2;
        if a2_fits(blocks, split, mid) {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    low
}

// ---- arm 3: table -------------------------------------------------------
fn a3_min_build_time(blocks: own Vec[i64], split: i64) -> i64 {
    let mut blocks = blocks;
    blocks.sort();
    blocks.reverse();
    let n = blocks.len();
    // best[i][w], for w from 1 to n; a row past the last block is 0
    let mut best = Vec.filled(n + 1, Vec.filled(n + 1, 0));
    for i in (0..n).rev() {
        for w in (1..=n).rev() {
            best[i][w] = if w >= n - i {
                blocks[i]
            } else {
                let spread = split + best[i][(2 * w).min(n)];
                let one = blocks[i].max(if w > 1 { best[i + 1][w - 1] } else { i64.MAX });
                spread.min(one)
            };
        }
    }
    best[0][1]
}

// ---- arm 4: heap --------------------------------------------------------
import std.cmp.Reverse;

struct A4Solution {}

impl A4Solution {
    pub fn min_build_time(blocks: Vec[i32], split: i32) -> i32 {
        let mut heap: PriorityQueue[Reverse[i32]] = PriorityQueue.max_first_from(blocks.clone().into_iter().map(|x| Reverse { value: x }).collect());
        while heap.len() > 1 {
            heap.pop();
            let Reverse { value: b } = heap.pop().unwrap();
            heap.push(Reverse { value: b + split });
        }
        heap.pop().unwrap().value
    }
}

fn a4_min_build_time(blocks: own Vec[i64], split: i64) -> i64 {
    A4Solution.min_build_time(blocks.iter().map(|b| b as i32).collect(), split as i32)
}

// ---- arm 5: memo --------------------------------------------------------
struct A5Solution {}

fn a5_dp(i: i64, w: i64, blocks: Slice[i32], split: i32, memo: mut ref Vec[Vec[i32]]) -> i32 {
    if i == blocks.len() {
        return 0;
    }
    if w == 0 {
        return i32.MAX;
    }
    if w >= blocks.len() - i {
        return blocks[i];
    }
    if memo[i][w] != -1 {
        return memo[i][w];
    }
    let spread = split + a5_dp(i, (2 * w).min(blocks.len()), blocks, split, mut memo);
    let one = blocks[i].max(a5_dp(i + 1, w - 1, blocks, split, mut memo));
    memo[i][w] = spread.min(one);
    memo[i][w]
}

impl A5Solution {
    pub fn min_build_time(blocks: own Vec[i32], split: i32) -> i32 {
        let mut blocks = blocks;
        blocks.sort_by(|a, b| b.cmp(a));
        let n = blocks.len();
        let mut memo = Vec.filled(n + 1, Vec.filled(n + 1, -1));
        a5_dp(0, 1, blocks, split, mut memo)
    }
}

fn a5_min_build_time(blocks: own Vec[i64], split: i64) -> i64 {
    A5Solution.min_build_time(blocks.iter().map(|b| b as i32).collect(), split as i32)
}

// ---- the statement read literally ----------------------------------------

// The least time for one worker to see the blocks in `set` built: a single
// block is built at once, and two or more need the worker to split, each
// of the two workers taking a part, the split costing `split` and the
// slower part setting the rest; every way to part the set is tried. `best`
// holds each set's time once found, -1 before.
fn literal_set(blocks: Vec[i64], split: i64, set: i64, best: mut ref Vec[i64]) -> i64 {
    if best[set] >= 0 {
        return best[set];
    }
    let t = if set & (set - 1) == 0 {
        let mut i = 0;
        while (set >> i) & 1 == 0 {
            i += 1;
        }
        blocks[i]
    } else {
        // the part holding the set's lowest block, so each parting is
        // tried once
        let low = set & -set;
        let rest = set ^ low;
        let mut least = -1;
        let mut part = rest;
        loop {
            // `part` runs over every subset of `rest` but `rest` itself
            if part != rest {
                let a = low | part;
                let b = set ^ a;
                let t = split + literal_set(blocks, split, a, mut best).max(literal_set(blocks, split, b, mut best));
                if least < 0 or t < least {
                    least = t;
                }
            }
            if part == 0 {
                break;
            }
            part = (part - 1) & rest;
        }
        least
    };
    best[set] = t;
    t
}

fn literal(blocks: Vec[i64], split: i64) -> i64 {
    let n = blocks.len();
    let mut best = Vec.filled(1 << n, -1);
    literal_set(blocks, split, (1 << n) - 1, mut best)
}

// ---- the differential -----------------------------------------------------

fn arms(blocks: Vec[i64], split: i64) -> Vec[i64] {
    [
        a0_min_build_time(blocks.clone(), split),
        a1_min_build_time(blocks.clone(), split),
        a2_min_build_time(blocks, split),
        a3_min_build_time(blocks.clone(), split),
        a4_min_build_time(blocks.clone(), split),
        a5_min_build_time(blocks.clone(), split),
    ]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "from the slowest block to it plus a split per level of a balanced tree", "the blocks reversed", "a split one dearer takes as long or longer", "one more block takes as long or longer", "every block one longer takes one longer", "the ★ arm's answer"];
    let mut fails = Vec.filled(7, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1199;
    for _ in 0..2000 {
        // 1 to 7 blocks of 1 to `high`, a split of 1 to 20
        let n = next_random(mut seed) % 7 + 1;
        let high = [5, 20, 100][next_random(mut seed) % 3];
        let split = next_random(mut seed) % 20 + 1;
        let blocks: Vec[i64] = (0..n).map(|_| next_random(mut seed) % high + 1).collect();
        let extra = next_random(mut seed) % high + 1;
        let got = arms(blocks, split);
        let want = literal(blocks, split);
        let reversed: Vec[i64] = blocks.iter().rev().collect();
        let back = arms(reversed, split);
        let dearer = arms(blocks, split + 1);
        let mut more = blocks.clone();
        more.push(extra);
        let more = arms(more, split);
        let longer: Vec[i64] = blocks.iter().map(|b| b + 1).collect();
        let longer = arms(longer, split);
        let slowest = blocks.iter().max().unwrap();
        let mut levels = 0;
        while (1 << levels) < n {
            levels += 1;
        }
        for i in 0..6 {
            let v = got[i];
            let held = [
                v == want,
                v >= slowest and v <= slowest + levels * split,
                back[i] == v,
                dearer[i] >= v,
                more[i] >= v,
                longer[i] == v + 1,
                v == got[0],
            ];
            for p in 0..7 {
                checks += 1;
                if not held[p] {
                    fails[p] += 1;
                    if fails[p] <= 2 {
                        println(f"P{p + 1} ({names[p]}) fails on arm {i}: {blocks}, split {split} -> {v}");
                    }
                }
            }
        }
        check = (check * 131 + got[0]) % 1000000007;
    }
    for p in 0..7 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    let total = fails.iter().sum();
    println(f"2000 block sets: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
