// LeetCode #1199: Minimum Time to Build Blocks -- a binary search on the
// answer. Within a time t, a block of time b may sit as deep as
// (t - b) / split splits down the tree, and a block may always sit higher
// than it must. So the blocks fit when, counting up from the deepest
// level, each level's own blocks and the parents of the level below, two
// children to a parent, come to a single worker at the top (Kraft's
// inequality). The answer is at most the slowest block and ten splits,
// which make 1024 workers.

fn fits(blocks: Vec[i64], split: i64, t: i64) -> bool {
    let n = blocks.len();
    // at[d]: the blocks that may sit at most d splits deep, d capped at n
    let mut at = Vec.filled(n + 1, 0);
    for b in blocks.iter() {
        if b > t {
            return false;
        }
        at[((t - b) / split).min(n)] += 1;
    }
    let mut need = 0;
    for d in (0..=n).rev() {
        need = at[d] + (need + 1) / 2;
    }
    need <= 1
}

fn min_build_time(blocks: Vec[i64], split: i64) -> i64 {
    let mut low = blocks.iter().max().unwrap();
    let mut high = low + 10 * split;
    while low < high {
        let mid = (low + high) / 2;
        if fits(blocks, split, mid) {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    low
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = [([1], 1), ([1, 2], 5), ([1, 2, 3], 1), ([5, 5, 5, 5], 2), ([1, 1, 1, 100], 10), ([10, 1, 1, 1, 1], 3)];
    for (blocks, split) in cases.iter() {
        println(f"{blocks}, split {split}: {min_build_time(blocks, split)}");
    }
    println(f"1000 blocks of 1, split 100: {min_build_time(Vec.filled(1000, 1), 100)}");
    println(f"1000 blocks of 100000, split 100: {min_build_time(Vec.filled(1000, 100000), 100)}");
    println(f"512 blocks of 7, split 1: {min_build_time(Vec.filled(512, 7), 1)}");
    println(f"1000 blocks of 7, split 1: {min_build_time(Vec.filled(1000, 7), 1)}");
    println(f"513 blocks of 7, split 1: {min_build_time(Vec.filled(513, 7), 1)}");
    let mut seed = 1199;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 12 + 1;
        let split = next_random(mut seed) % 20 + 1;
        let blocks: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 50 + 1).collect();
        let t = min_build_time(blocks, split);
        total += t;
        check = (check * 131 + t) % 1000000007;
    }
    println(f"1000 random block sets: total {total}, checksum {check}");
    let big: Vec[i64] = (0..1000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1).collect();
    println(f"1000 random blocks up to 100000, split 100: {min_build_time(big, 100)}");
    println(f"the same, split 1: {min_build_time(big, 1)}");
}
