// LeetCode #1161: Maximum Level Sum of a Binary Tree -- a Rust solution
// as LeetCode's Rust users write it (`impl Solution`,
// `Rc<RefCell<TreeNode>>`, a `VecDeque` drained a level at a time by its
// length, `node.borrow()` for the children, `i32` sums and levels), carried
// to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn max_level_sum(root: Option[TreeNode]) -> i32 {
        let mut q = VecDeque.new();
        if let Some(r) = root {
            q.push_back(r);
        }
        let mut (ans, best, level) = (1i32, i32.MIN, 0i32);
        while not q.is_empty() {
            level += 1;
            let mut sum: i32 = 0;
            for _ in 0..q.len() {
                let node = q.pop_front().unwrap();
                sum += node.val;
                if let Some(l) = node.left.clone() {
                    q.push_back(l);
                }
                if let Some(r) = node.right.clone() {
                    q.push_back(r);
                }
            }
            if sum > best {
                best = sum;
                ans = level;
            }
        }
        ans
    }
}

fn max_level_sum(root: Option[TreeNode]) -> i64 {
    Solution.max_level_sum(root)
}

// ---- test harness ---------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i32) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order form, "[1,2,null,4]": each node's two children
// come next, in the order the nodes were met, "null" for none.
fn parse(text: Str) -> Option[TreeNode] {
    let inner = text.strip_prefix("[").unwrap().strip_suffix("]").unwrap();
    if inner.is_empty() {
        return None;
    }
    let items: Vec[Option[i32]] = inner.split(",").map(|s| if s == "null" { None } else { Some(i32.parse(s).unwrap()) }).collect();
    let root = leaf(items[0].unwrap());
    let mut queue: Vec[TreeNode] = [root];
    let mut head = 0;
    let mut i = 1;
    while i < items.len() {
        let node = queue[head];
        head += 1;
        if let Some(v) = items[i] {
            let child = leaf(v);
            node.left = Some(child);
            queue.push(child);
        }
        i += 1;
        if i < items.len() {
            if let Some(v) = items[i] {
                let child = leaf(v);
                node.right = Some(child);
                queue.push(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// A value from -10^5 to 10^5, the constraints' range, or with `small`
// from -2 to 2, so that levels tie.
fn value(seed: mut ref i64, small: bool) -> i32 {
    if small {
        (next_random(mut seed) % 5 - 2) as i32
    } else {
        (next_random(mut seed) % 200001 - 100000) as i32
    }
}

// A random tree of `count` nodes, each hung at a random free place below
// the ones before it; with `deep`, the place is below the newest node
// half the time, so the tree grows long branches.
fn random_tree(seed: mut ref i64, count: i64, deep: bool, small: bool) -> TreeNode {
    let root = leaf(value(mut seed, small));
    let mut nodes: Vec[TreeNode] = [root];
    for _ in 1..count {
        let c = leaf(value(mut seed, small));
        loop {
            let at = if deep and next_random(mut seed) % 2 == 0 {
                nodes[nodes.len() - 1]
            } else {
                nodes[next_random(mut seed) % nodes.len()]
            };
            if next_random(mut seed) % 2 == 0 {
                if at.left.is_none() {
                    at.left = Some(c);
                    break;
                }
            } else if at.right.is_none() {
                at.right = Some(c);
                break;
            }
        }
        nodes.push(c);
    }
    root
}

fn main() {
    // LeetCode's two examples and six more: one node; every level
    // negative, the root's the largest; two levels tied; all zero; a
    // deeper level less negative than the root; a long chain whose last
    // level wins
    let cases = [
        "[1,7,0,7,-8,null,null]",
        "[989,null,10250,98693,-89388,null,null,null,-32127]",
        "[5]",
        "[-1,-2,-3]",
        "[1,1,0]",
        "[0,0,0,0]",
        "[-5,-1,-1]",
        "[1,2,null,3,null,4,null,5]",
    ];
    for c in cases.iter() {
        println(f"{c} -> {max_level_sum(parse(c))}");
    }
    // 1000 random trees of up to 1000 nodes, a quarter grown deep and
    // half with values from -2 to 2: the levels summed and a checksum
    let mut seed = 1161;
    let mut levels = 0;
    let mut check = 0;
    for t in 0..1000 {
        let count = next_random(mut seed) % 1000 + 1;
        let root = random_tree(mut seed, count, t % 4 == 1, t % 2 == 0);
        let level = max_level_sum(Some(root));
        levels += level;
        check = (check * 31 + level) % 1000000007;
    }
    println(f"1000 random trees: levels {levels}, checksum {check}");
    // 10^4 nodes, the constraints' most: wide and deep
    for deep in [false, true] {
        let root = random_tree(mut seed, 10000, deep, false);
        println(f"10000 nodes: level {max_level_sum(Some(root))}");
    }
}
