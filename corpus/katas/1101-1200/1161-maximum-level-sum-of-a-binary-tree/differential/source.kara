// LeetCode #1161: Maximum Level Sum of a Binary Tree -- a differential
// over the five arms. Each answer is checked against the statement read
// literally and against six properties that do not compute it; see the
// README.

// ---- max_level_sum.kara ----

fn a0_max_level_sum(root: Option[TreeNode]) -> i64 {
    let mut level: Vec[TreeNode] = [];
    if let Some(r) = root {
        level.push(r);
    }
    let mut best = 0;
    let mut best_sum = 0;
    let mut depth = 0;
    while not level.is_empty() {
        depth += 1;
        let mut sum = 0;
        let mut next: Vec[TreeNode] = [];
        for node in level.iter() {
            sum += node.val;
            if let Some(l) = node.left {
                next.push(l);
            }
            if let Some(r) = node.right {
                next.push(r);
            }
        }
        if best == 0 or sum > best_sum {
            best = depth;
            best_sum = sum;
        }
        level = next;
    }
    best
}

// ---- max_level_sum_dfs.kara ----

fn a1_add(node: Option[TreeNode], depth: i64, sums: mut ref Vec[i64]) {
    let Some(n) = node else {
        return;
    };
    if sums.len() == depth {
        sums.push(0);
    }
    sums[depth] += n.val;
    a1_add(n.left, depth + 1, mut sums);
    a1_add(n.right, depth + 1, mut sums);
}

fn a1_max_level_sum(root: Option[TreeNode]) -> i64 {
    let mut sums: Vec[i64] = [];
    a1_add(root, 0, mut sums);
    let top = sums.iter().max().unwrap();
    sums.iter().position(|s| s == top).unwrap() + 1
}

// ---- max_level_sum_counted.kara ----

fn a2_max_level_sum(root: Option[TreeNode]) -> i64 {
    let mut queue: Vec[TreeNode] = [];
    if let Some(r) = root {
        queue.push(r);
    }
    let mut sums: SortedMap[i64, i64] = SortedMap.new();
    let mut head = 0;
    let mut depth = 1;
    while head < queue.len() {
        let end = queue.len();
        let mut sum = 0;
        while head < end {
            let node = queue[head];
            head += 1;
            sum += node.val;
            if let Some(l) = node.left {
                queue.push(l);
            }
            if let Some(r) = node.right {
                queue.push(r);
            }
        }
        sums.insert(depth, sum);
        depth += 1;
    }
    let top = sums.values().max().unwrap();
    for (d, s) in sums.iter() {
        if s == top {
            return d;
        }
    }
    0
}

// ---- max_level_sum_stack.kara ----

fn a3_max_level_sum(root: Option[TreeNode]) -> i64 {
    let mut sums: Map[i64, i64] = Map.new();
    let mut stack: Vec[(TreeNode, i64)] = [];
    if let Some(r) = root {
        stack.push((r, 1));
    }
    while let Some((node, depth)) = stack.pop() {
        *sums.entry(depth).or_insert(0) += node.val;
        if let Some(r) = node.right {
            stack.push((r, depth + 1));
        }
        if let Some(l) = node.left {
            stack.push((l, depth + 1));
        }
    }
    let mut best = 1;
    for d in 2..sums.len() + 1 {
        if sums[d] > sums[best] {
            best = d;
        }
    }
    best
}

// ---- max_level_sum_solution.kara ----

struct A4Solution {}

impl A4Solution {
    pub fn a4_max_level_sum(root: Option[TreeNode]) -> i32 {
        let mut q = VecDeque.new();
        if let Some(r) = root {
            q.push_back(r);
        }
        let mut (ans, best, level) = (1i32, i32.MIN, 0i32);
        while not q.is_empty() {
            level += 1;
            let mut sum: i32 = 0;
            for _ in 0..q.len() {
                let node = q.pop_front().unwrap();
                sum += node.val;
                if let Some(l) = node.left.clone() {
                    q.push_back(l);
                }
                if let Some(r) = node.right.clone() {
                    q.push_back(r);
                }
            }
            if sum > best {
                best = sum;
                ans = level;
            }
        }
        ans
    }
}

fn a4_max_level_sum(root: Option[TreeNode]) -> i64 {
    A4Solution.a4_max_level_sum(root)
}

// ---- the differential -----------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A tree as plain data: node i's value and its children's indices, -1
// for none; node 0 is the root. Every arm call builds its own tree.
struct Shape {
    val: Vec[i64],
    left: Vec[i64],
    right: Vec[i64],
}

fn build(s: Shape, i: i64) -> Option[TreeNode] {
    if i < 0 {
        return None;
    }
    Some(TreeNode { val: s.val[i] as i32, left: build(s, s.left[i]), right: build(s, s.right[i]) })
}

fn arm(w: i64, s: Shape) -> i64 {
    let root = build(s, 0);
    match w {
        0 => a0_max_level_sum(root),
        1 => a1_max_level_sum(root),
        2 => a2_max_level_sum(root),
        3 => a3_max_level_sum(root),
        _ => a4_max_level_sum(root),
    }
}

// Each node's level, found by walking up its parents to the root.
fn levels(s: Shape) -> Vec[i64] {
    let n = s.val.len();
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    for i in 0..n {
        if s.left[i] >= 0 {
            parent[s.left[i]] = i;
        }
        if s.right[i] >= 0 {
            parent[s.right[i]] = i;
        }
    }
    (0..n).map(|i| {
        let mut level = 1;
        let mut at = i;
        while parent[at] >= 0 {
            at = parent[at];
            level += 1;
        }
        level
    }).collect()
}

// The statement read literally: each level's sum from every node's level,
// and the smallest level whose sum no level beats. Returns it, its sum
// and the deepest level.
fn literal(s: Shape) -> (i64, i64, i64) {
    let lv = levels(s);
    let deepest = lv.iter().max().unwrap();
    let mut sums: Vec[i64] = Vec.filled(deepest + 1, 0);
    for i in 0..lv.len() {
        sums[lv[i]] += s.val[i];
    }
    let mut best = 1;
    for l in 1..deepest + 1 {
        let beaten = (1..deepest + 1).any(|m| sums[m] > sums[l]);
        if not beaten {
            best = l;
            break;
        }
    }
    (best, sums[best], deepest)
}

fn value(seed: mut ref i64, small: bool) -> i64 {
    if small { next_random(mut seed) % 5 - 2 } else { next_random(mut seed) % 200001 - 100000 }
}

// A random shape of `count` nodes, each hung at a random free place below
// the ones before it, below the newest half the time with `deep`.
fn random_shape(seed: mut ref i64, count: i64, deep: bool, small: bool) -> Shape {
    let mut s = Shape { val: [value(mut seed, small)], left: [-1], right: [-1] };
    for i in 1..count {
        s.val.push(value(mut seed, small));
        s.left.push(-1);
        s.right.push(-1);
        loop {
            let at = if deep and next_random(mut seed) % 2 == 0 { i - 1 } else { next_random(mut seed) % i };
            if next_random(mut seed) % 2 == 0 {
                if s.left[at] < 0 {
                    s.left[at] = i;
                    break;
                }
            } else if s.right[at] < 0 {
                s.right[at] = i;
                break;
            }
        }
    }
    s
}

// A full shape of `depth` levels whose level sums are drawn from a few,
// so that levels tie: each level's nodes share one value from -2 to 2.
fn tied_shape(seed: mut ref i64, depth: i64) -> Shape {
    let n = (1 << depth) - 1;
    let mut s = Shape { val: Vec.filled(n, 0), left: Vec.filled(n, -1), right: Vec.filled(n, -1) };
    for d in 0..depth {
        let v = next_random(mut seed) % 5 - 2;
        for i in (1 << d) - 1..(1 << (d + 1)) - 1 {
            s.val[i] = v;
            if 2 * i + 2 < n {
                s.left[i] = 2 * i + 1;
                s.right[i] = 2 * i + 2;
            }
        }
    }
    s
}

// The children swapped at every node.
fn mirrored(s: Shape) -> Shape {
    Shape { val: s.val.clone(), left: s.right.clone(), right: s.left.clone() }
}

// The shape below a new root of value `v`, on its left.
fn below(s: Shape, v: i64) -> Shape {
    let mut out = Shape { val: [v], left: [1], right: [-1] };
    for i in 0..s.val.len() {
        out.val.push(s.val[i]);
        out.left.push(if s.left[i] < 0 { -1 } else { s.left[i] + 1 });
        out.right.push(if s.right[i] < 0 { -1 } else { s.right[i] + 1 });
    }
    out
}

// The shape twice, under a new root of value `v`.
fn twice(s: Shape, v: i64) -> Shape {
    let n = s.val.len();
    let mut out = below(s, v);
    out.right[0] = n + 1;
    for i in 0..n {
        out.val.push(s.val[i]);
        out.left.push(if s.left[i] < 0 { -1 } else { s.left[i] + n + 1 });
        out.right.push(if s.right[i] < 0 { -1 } else { s.right[i] + n + 1 });
    }
    out
}

struct Case {
    shape: Shape,
    // P3's root value, P4's node, P5's leaf value, P6's root value
    root_value: i64,
    raised: i64,
    leaf_value: i64,
    twin_root: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    let s = ref c.shape;
    let n = s.val.len();
    let (want, best_sum, deepest) = literal(s);
    let lv = levels(s);
    let flipped = mirrored(s);
    let lowered = below(s, c.root_value);
    // P4: a node of the winning level raised by one, when it can be
    let winners: Vec[i64] = (0..n).filter(|i| lv[i] == want and s.val[i] < 100000).collect();
    let mut raised = Shape { val: s.val.clone(), left: s.left.clone(), right: s.right.clone() };
    if winners.len() > 0 {
        raised.val[winners[c.raised % winners.len()]] += 1;
    }
    // P5: a leaf of `leaf_value` under a node of the deepest level
    let deep_node = (0..n).filter(|i| lv[i] == deepest).next().unwrap();
    let mut grown = Shape { val: s.val.clone(), left: s.left.clone(), right: s.right.clone() };
    grown.val.push(c.leaf_value);
    grown.left.push(-1);
    grown.right.push(-1);
    grown.left[deep_node] = n;
    let doubled = twice(s, c.twin_root);
    for w in 0..5 {
        let got = arm(w, s);
        let what = f"arm {w}, case {t.cases} of {n} nodes -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literally {want}");
        // P2: the tree mirrored
        let m = arm(w, flipped);
        expect(mut t, 2, m == got, f"P2 {what}, mirrored {m}");
        // P3: a new root above, of a drawn value, which wins exactly when
        // no level sums above it
        let l = arm(w, lowered);
        let l_want = if best_sum > c.root_value { got + 1 } else { 1 };
        expect(mut t, 3, l == l_want, f"P3 {what}, below {c.root_value}: {l}, not {l_want}");
        // P4: the winning level raised keeps winning
        let r = arm(w, raised);
        expect(mut t, 4, r == got, f"P4 {what}, raised {r}");
        // P5: a new deepest level of one leaf wins exactly when its value
        // beats the best sum
        let g = arm(w, grown);
        let g_want = if c.leaf_value > best_sum { deepest + 1 } else { got };
        expect(mut t, 5, g == g_want, f"P5 {what}, leaf {c.leaf_value}: {g}, not {g_want}");
        // P6: the tree twice under a new root doubles every level's sum
        let d = arm(w, doubled);
        let d_want = if 2 * best_sum > c.twin_root { got + 1 } else { 1 };
        expect(mut t, 6, d == d_want, f"P6 {what}, twice under {c.twin_root}: {d}, not {d_want}");
    }
    t.cases += 1;
    t.check = (t.check * 31 + want + n) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 1200 trees in four kinds, 300 each: 1 to 12 nodes with values from
    // -2 to 2; 1 to 300 nodes over the whole range, every other one deep;
    // a chain-like tree of 1 to 200 nodes from -2 to 2; and a full tree of
    // 1 to 7 levels whose levels' values tie. Every choice the properties
    // make is drawn before any arm answers.
    let mut seed = 11611;
    let mut cases: Vec[Case] = [];
    for i in 0..1200 {
        let kind = i % 4;
        let shape = if kind == 0 {
            random_shape(mut seed, 1 + next_random(mut seed) % 12, false, true)
        } else if kind == 1 {
            random_shape(mut seed, 1 + next_random(mut seed) % 300, i % 8 == 1, false)
        } else if kind == 2 {
            random_shape(mut seed, 1 + next_random(mut seed) % 200, true, true)
        } else {
            tied_shape(mut seed, 1 + next_random(mut seed) % 7)
        };
        let small = kind != 1;
        let root_value = if small { next_random(mut seed) % 7 - 3 } else { -100000 };
        let raised = next_random(mut seed);
        let leaf_value = value(mut seed, small);
        let twin_root = value(mut seed, small);
        cases.push(Case { shape, root_value, raised, leaf_value, twin_root });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} trees: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
