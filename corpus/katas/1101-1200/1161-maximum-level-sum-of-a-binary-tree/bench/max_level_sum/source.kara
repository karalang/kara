// LeetCode #1161: Maximum Level Sum of a Binary Tree -- the ★ arm, level
// by level: each level's nodes summed while the next level is gathered,
// and a level taking the lead only with a strictly larger sum, so the
// smallest of tied levels is kept. O(n).

fn max_level_sum(root: Option[TreeNode]) -> i64 {
    let mut level: Vec[TreeNode] = [];
    if let Some(r) = root {
        level.push(r);
    }
    let mut best = 0;
    let mut best_sum = 0;
    let mut depth = 0;
    while not level.is_empty() {
        depth += 1;
        let mut sum = 0;
        let mut next: Vec[TreeNode] = [];
        for node in level.iter() {
            sum += node.val;
            if let Some(l) = node.left {
                next.push(l);
            }
            if let Some(r) = node.right {
                next.push(r);
            }
        }
        if best == 0 or sum > best_sum {
            best = depth;
            best_sum = sum;
        }
        level = next;
    }
    best
}

// ---- bench ----------------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A value from -10^5 to 10^5.
fn random_value(seed: mut ref i64) -> i32 {
    ((next_random(mut seed) * 32768 + next_random(mut seed)) % 200001 - 100000) as i32
}

// Hangs a new node at a random free place below the tree's nodes.
fn grow(nodes: mut ref Vec[TreeNode], seed: mut ref i64) {
    let c = TreeNode { val: random_value(mut seed), left: None, right: None };
    loop {
        let at = nodes[next_random(mut seed) % nodes.len()];
        if next_random(mut seed) % 2 == 0 {
            if at.left.is_none() {
                at.left = Some(c);
                break;
            }
        } else if at.right.is_none() {
            at.right = Some(c);
            break;
        }
    }
    nodes.push(c);
}

fn main() {
    // 16 random trees of 10^4 nodes, the constraints' most, built once;
    // each of 200 rounds hangs one more node on every tree and solves it.
    let mut seed = 1161;
    let mut trees: Vec[Vec[TreeNode]] = [];
    for _ in 0..16 {
        let mut nodes: Vec[TreeNode] = [TreeNode { val: random_value(mut seed), left: None, right: None }];
        for _ in 1..10000 {
            grow(mut nodes, mut seed);
        }
        trees.push(nodes);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..200 {
        for j in 0..trees.len() {
            grow(mut trees[j], mut seed);
            let level = max_level_sum(Some(trees[j][0]));
            total += level;
            check = (check * 31 + level) % 1000000007;
        }
    }
    println(f"200 rounds over 16 trees of 10^4 nodes: levels total {total}, checksum {check}");
}
