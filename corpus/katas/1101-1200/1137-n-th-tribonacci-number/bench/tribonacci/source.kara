// LeetCode #1137: N-th Tribonacci Number -- the bench, the ★ arm's algorithm:
// three running values.

fn tribonacci(n: i64) -> i64 {
    let mut a = 0;
    let mut b = 1;
    let mut c = 1;
    for _ in 0..n {
        let next = a + b + c;
        a = b;
        b = c;
        c = next;
    }
    a
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20,000,000 queries, each n drawn from 0 to 37, the whole range
    // the constraints allow.
    let mut seed = 1137;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..20000000 {
        let n = next_random(mut seed) % 38;
        let t = tribonacci(n);
        total += t;
        check = (check * 31 + t % 1000003) % 1000000007;
    }
    println(f"20000000 queries, n from 0 to 37: answers total {total}, checksum {check}");
}
