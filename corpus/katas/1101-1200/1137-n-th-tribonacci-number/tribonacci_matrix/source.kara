// LeetCode #1137: N-th Tribonacci Number -- the step as a 3 by 3 matrix,
// raised to the `n`th power by squaring: the step matrix's `n`th power
// holds T(n) in its first column's middle row. O(log n)

fn multiply(x: Array[Array[i64, 3], 3], y: Array[Array[i64, 3], 3]) -> Array[Array[i64, 3], 3] {
    let mut z = [[0; 3]; 3];
    for i in 0..3 {
        for j in 0..3 {
            for k in 0..3 {
                z[i][j] += x[i][k] * y[k][j];
            }
        }
    }
    z
}

fn tribonacci(n: i64) -> i64 {
    let mut result: Array[Array[i64, 3], 3] = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
    let mut step: Array[Array[i64, 3], 3] = [[1, 1, 1], [1, 0, 0], [0, 1, 0]];
    let mut e = n;
    while e > 0 {
        if e % 2 == 1 {
            result = multiply(result, step);
        }
        e /= 2;
        if e > 0 {
            step = multiply(step, step);
        }
    }
    result[1][0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"4 -> {tribonacci(4)}");
    println(f"25 -> {tribonacci(25)}");
    // every n the constraints allow, 0 to 37, eight to a line
    let all: Vec[i64] = (0..38).map(|n| tribonacci(n)).collect();
    for start in [0, 8, 16, 24, 32] {
        let row: Vec[String] = all.iter().skip(start).take(8).map(|t| f"{t}").collect();
        println(f"{start}..: {row.join(" ")}");
    }
    // 2000 random n from 0 to 37: the answers summed and a checksum
    let mut seed = 1137;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 38;
        let t = tribonacci(n);
        total += t;
        check = (check * 31 + t % 1000003) % 1000000007;
    }
    println(f"2000 random n: answers total {total}, checksum {check}");
}
