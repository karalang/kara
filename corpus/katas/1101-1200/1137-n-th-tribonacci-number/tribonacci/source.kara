// LeetCode #1137: N-th Tribonacci Number -- the ★ arm: three running
// values, T(i), T(i + 1) and T(i + 2), each step replacing the oldest
// with the sum of all three; after `n` steps the first is T(n). O(n)

fn tribonacci(n: i64) -> i64 {
    let mut a = 0;
    let mut b = 1;
    let mut c = 1;
    for _ in 0..n {
        let next = a + b + c;
        a = b;
        b = c;
        c = next;
    }
    a
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"4 -> {tribonacci(4)}");
    println(f"25 -> {tribonacci(25)}");
    // every n the constraints allow, 0 to 37, eight to a line
    let all: Vec[i64] = (0..38).map(|n| tribonacci(n)).collect();
    for start in [0, 8, 16, 24, 32] {
        let row: Vec[String] = all.iter().skip(start).take(8).map(|t| f"{t}").collect();
        println(f"{start}..: {row.join(" ")}");
    }
    // 2000 random n from 0 to 37: the answers summed and a checksum
    let mut seed = 1137;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 38;
        let t = tribonacci(n);
        total += t;
        check = (check * 31 + t % 1000003) % 1000000007;
    }
    println(f"2000 random n: answers total {total}, checksum {check}");
}
