// LeetCode #1137: N-th Tribonacci Number -- recursion on the definition,
// each value remembered once found, so every T(k) is computed once. O(n)

fn trib(n: i64, memo: mut ref Vec[i64]) -> i64 {
    if memo[n] >= 0 {
        return memo[n];
    }
    let t = trib(n - 1, mut memo) + trib(n - 2, mut memo) + trib(n - 3, mut memo);
    memo[n] = t;
    t
}

fn tribonacci(n: i64) -> i64 {
    let mut memo = Vec.filled(n.max(2) + 1, -1);
    memo[0] = 0;
    memo[1] = 1;
    memo[2] = 1;
    trib(n, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"4 -> {tribonacci(4)}");
    println(f"25 -> {tribonacci(25)}");
    // every n the constraints allow, 0 to 37, eight to a line
    let all: Vec[i64] = (0..38).map(|n| tribonacci(n)).collect();
    for start in [0, 8, 16, 24, 32] {
        let row: Vec[String] = all.iter().skip(start).take(8).map(|t| f"{t}").collect();
        println(f"{start}..: {row.join(" ")}");
    }
    // 2000 random n from 0 to 37: the answers summed and a checksum
    let mut seed = 1137;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 38;
        let t = tribonacci(n);
        total += t;
        check = (check * 31 + t % 1000003) % 1000000007;
    }
    println(f"2000 random n: answers total {total}, checksum {check}");
}
