// LeetCode #1186: Maximum Subarray Sum with One Deletion -- a Rust solution
// as LeetCode's Rust users write it: a `vec![vec![0; 2]; n]` table, row `i`
// holding the best sum ending at `i` with no deletion and with one, filled
// with `std::cmp::max`, inside `impl Solution` over `Vec<i32>`; carried to
// Kāra by `karac fix`. O(n) time, O(n) space.

struct Solution {}

impl Solution {
    pub fn maximum_sum(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        let mut dp = Vec.filled(n, Vec.filled(2, 0));
        dp[0][0] = arr[0];
        let mut res = arr[0];
        for i in 1..n {
            dp[i][0] = max(dp[i - 1][0] + arr[i], arr[i]);
            dp[i][1] = max(dp[i - 1][1] + arr[i], dp[i - 1][0]);
            res = res.max(dp[i][0]).max(dp[i][1]);
        }
        res
    }
}

fn maximum_sum(arr: Vec[i64]) -> i64 {
    Solution.maximum_sum(arr.iter().map(|v| v as i32).collect())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` values in `-span..=span`, each drawn afresh.
fn values(seed: mut ref i64, n: i64, span: i64) -> Vec[i64] {
    (0..n).map(|_| next_random(mut seed) % (2 * span + 1) - span).collect()
}

fn main() {
    println(f"example 1: {maximum_sum([1, -2, 0, 3])}");
    println(f"example 2: {maximum_sum([1, -2, -2, 3])}");
    println(f"example 3: {maximum_sum([-1, -1, -1, -1])}");
    println(f"small 1: {maximum_sum([-7])}");
    println(f"small 2: {maximum_sum([5, -100, 6])}");
    println(f"small 3: {maximum_sum([-3, -9])}");
    println(f"small 4: {maximum_sum([2, -1, -1, 2])}");
    let mut seed: i64 = 1182;
    let mut checksum: i64 = 0;
    for t in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let arr = values(mut seed, n, 10);
        checksum = (checksum * 31 + maximum_sum(arr) + 1000 + t) % 1000000007;
    }
    println(f"2000 random arrays: checksum {checksum}");
    let big = values(mut seed, 100000, 10000);
    println(f"100000 values: {maximum_sum(big)}");
}
