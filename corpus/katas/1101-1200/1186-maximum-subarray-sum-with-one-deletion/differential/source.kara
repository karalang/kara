// LeetCode #1186: Maximum Subarray Sum with One Deletion -- the
// differential: the five arms against the statement read literally, and
// six properties of what they return.

// ---- maximum_sum.kara ----

fn a0_maximum_sum(arr: Vec[i64]) -> i64 {
    let mut kept = arr[0];
    let mut cut = i64.MIN;
    let mut best = arr[0];
    for x in arr[1..].iter() {
        cut = if cut == i64.MIN { kept } else { (cut + x).max(kept) };
        kept = (kept + x).max(x);
        best = best.max(kept).max(cut);
    }
    best
}

// ---- maximum_sum_sides.kara ----

fn a1_maximum_sum(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut ending: Vec[i64] = Vec.filled(n, 0);
    let mut starting: Vec[i64] = Vec.filled(n, 0);
    ending[0] = arr[0];
    for i in 1..n {
        ending[i] = arr[i].max(ending[i - 1] + arr[i]);
    }
    starting[n - 1] = arr[n - 1];
    for i in (0..n - 1).rev() {
        starting[i] = arr[i].max(starting[i + 1] + arr[i]);
    }
    let mut best = ending.iter().max().unwrap();
    for i in 1..n - 1 {
        best = best.max(ending[i - 1] + starting[i + 1]);
    }
    best
}

// ---- maximum_sum_fold.kara ----

fn a2_maximum_sum(arr: Vec[i64]) -> i64 {
    let start: (i64, Option[i64], i64) = (arr[0], None, arr[0]);
    let (_, _, best) = arr[1..].iter().fold(start, |(kept, cut, best), x| {
        let cut = match cut {
            Some(c) => (c + x).max(kept),
            None => kept,
        };
        let kept = (kept + x).max(x);
        (kept, Some(cut), best.max(kept).max(cut))
    });
    best
}

// ---- maximum_sum_solution.kara ----

struct Solution3 {}

impl Solution3 {
    pub fn maximum_sum(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        let mut dp = Vec.filled(n, Vec.filled(2, 0));
        dp[0][0] = arr[0];
        let mut res = arr[0];
        for i in 1..n {
            dp[i][0] = max(dp[i - 1][0] + arr[i], arr[i]);
            dp[i][1] = max(dp[i - 1][1] + arr[i], dp[i - 1][0]);
            res = res.max(dp[i][0]).max(dp[i][1]);
        }
        res
    }
}

fn a3_maximum_sum(arr: Vec[i64]) -> i64 {
    Solution3.maximum_sum(arr.iter().map(|v| v as i32).collect())
}

// ---- maximum_sum_chain.kara ----

struct Solution4 {}

impl Solution4 {
    pub fn maximum_sum(arr: Vec[i32]) -> i32 {
        arr.iter()
            .skip(1)
            .fold((arr[0], 0i32, arr[0]), |(keep, del, best), x| {
                let del = (del + x).max(keep);
                let keep = (keep + x).max(x);
                (keep, del, best.max(keep).max(del))
            })
            .2
    }
}

fn a4_maximum_sum(arr: Vec[i64]) -> i64 {
    Solution4.maximum_sum(arr.iter().map(|v| v as i32).collect())
}

// ---- the statement, read literally ----------------------------------------

// Every non-empty subarray, kept whole or with one element deleted while
// one is left.
fn literal(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut best = arr[0];
    for i in 0..n {
        for j in i..n {
            let sum: i64 = arr[i..j + 1].iter().sum();
            best = best.max(sum);
            if j > i {
                for k in i..j + 1 {
                    best = best.max(sum - arr[k]);
                }
            }
        }
    }
    best
}

fn arm(w: i64, arr: Vec[i64]) -> i64 {
    match w {
        0 => a0_maximum_sum(arr),
        1 => a1_maximum_sum(arr),
        2 => a2_maximum_sum(arr),
        3 => a3_maximum_sum(arr),
        _ => a4_maximum_sum(arr),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, w: i64, p: i64, plan: i64, got: i64, want: i64) {
    t.checks += 1;
    if got != want {
        t.failures += 1;
        t.by[p] += 1;
        if t.failures <= 5 {
            println(f"arm {w}, P{p}, plan {plan}: got {got}, want {want}");
        }
    }
}

fn main() {
    let mut t = Tally { checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 600 arrays of 1 to 12 values in -span..=span, the span 1 to 10; the
    // first ten have one value, the next ten are all negative
    let mut seed = 11820;
    for plan in 0..600 {
        let n = if plan < 10 { 1 } else { 1 + next_random(mut seed) % 12 };
        let span = 1 + next_random(mut seed) % 10;
        let arr: Vec[i64] = (0..n).map(|_| {
            let v = next_random(mut seed) % (2 * span + 1) - span;
            if plan >= 10 and plan < 20 { -1 - v.abs() } else { v }
        }).collect();
        let want = literal(arr);
        let star = a0_maximum_sum(arr);
        t.check = (t.check * 31 + star + 1000) % 1000000007;
        let reversed: Vec[i64] = arr.iter().rev().collect();
        let mut tail = arr.clone();
        tail.push(-10000);
        let doubled: Vec[i64] = arr.iter().map(|v| v * 2).collect();
        let mut kadane = arr[0];
        let mut run = arr[0];
        for v in arr[1..].iter() {
            run = (run + v).max(v);
            kadane = kadane.max(run);
        }
        for w in 0..5 {
            let a = arm(w, arr);
            // P1: the statement read literally
            expect(mut t, w, 1, plan, a, want);
            // P2: the array reversed has the same answer
            expect(mut t, w, 2, plan, arm(w, reversed), a);
            // P3: deleting one element never loses to deleting none
            expect(mut t, w, 3, plan, a.max(kadane), a);
            // P4: a value no subarray wants, appended, changes nothing
            expect(mut t, w, 4, plan, arm(w, tail), a);
            // P5: every value doubled doubles the answer
            expect(mut t, w, 5, plan, arm(w, doubled), 2 * a);
            // P6: the ★ arm's answer
            expect(mut t, w, 6, plan, a, star);
        }
    }
    println(f"600 arrays: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
