// LeetCode #1101: The Earliest Moment When Everyone Become Friends --
// binary search over the moments: with the logs sorted, whether everyone
// is acquainted after the first i logs only ever turns from false to
// true, so a binary search finds the first i, each probe a breadth-first
// search from person 0 over a `VecDeque` on the friendships so far.
// O((n + m) log m).

fn connected(logs: Vec[Vec[i64]], count: i64, n: i64) -> bool {
    let mut friends: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for log in logs.iter().take(count) {
        friends[log[1]].push(log[2]);
        friends[log[2]].push(log[1]);
    }
    let mut seen = Vec.filled(n, false);
    seen[0] = true;
    let mut queue = VecDeque.new();
    queue.push_back(0);
    let mut reached = 1;
    while let Some(p) = queue.pop_front() {
        for q in friends[p].iter() {
            if not seen[*q] {
                seen[*q] = true;
                reached += 1;
                queue.push_back(*q);
            }
        }
    }
    reached == n
}

fn earliest_acq(logs: Vec[Vec[i64]], n: i64) -> i64 {
    let mut logs = logs.clone();
    logs.sort_by_key(|log| log[0]);
    let m = logs.len();
    if not connected(logs.clone(), m, n) {
        return -1;
    }
    let mut (lo, hi) = (1, m);
    while lo < hi {
        let mid = (lo + hi) / 2;
        if connected(logs.clone(), mid, n) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    logs[(lo - 1)][0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// m logs over n people, every pair at most once, the timestamps distinct
// and in no order.
fn random_logs(seed: mut ref i64, n: i64, m: i64) -> Vec[Vec[i64]] {
    let mut used: SortedSet[i64] = SortedSet.new();
    let mut times: SortedSet[i64] = SortedSet.new();
    let mut logs: Vec[Vec[i64]] = [];
    while logs.len() < m and used.len() < n * (n - 1) / 2 {
        let x = next_random(mut seed) % n;
        let y = next_random(mut seed) % n;
        if x == y or used.contains(x.min(y) * n + x.max(y)) {
            continue;
        }
        let mut t = next_random(mut seed) % 1000000;
        while times.contains(t) {
            t = next_random(mut seed) % 1000000;
        }
        used.insert(x.min(y) * n + x.max(y));
        times.insert(t);
        logs.push([t, x, y]);
    }
    logs
}

fn main() {
    let cases: Vec[(Vec[Vec[i64]], i64)] = [
        ([[20190101, 0, 1], [20190104, 3, 4], [20190107, 2, 3], [20190211, 1, 5], [20190224, 2, 4], [20190301, 0, 3], [20190312, 1, 2], [20190322, 4, 5]], 6),
        ([[0, 2, 0], [1, 0, 1], [3, 0, 3], [4, 1, 2], [7, 3, 1]], 4),
        ([[5, 0, 1]], 2),
        ([[5, 0, 1]], 3),
        ([[9, 1, 2], [3, 0, 1]], 3),
        ([[1, 0, 1], [2, 2, 3]], 4),
        ([[1, 0, 1], [2, 0, 2], [3, 1, 2]], 3),
        ([[1000000000, 0, 1], [0, 1, 2]], 3),
        ([[4, 0, 3], [3, 1, 3], [2, 2, 3], [1, 0, 1]], 4),
    ];
    for (logs, n) in cases.iter() {
        println(f"{earliest_acq(logs.clone(), n)}");
    }
    // 2000 random groups of 2 to 30 people with up to 60 logs
    let mut seed = 1101;
    let mut found = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 29 + 2;
        let m = next_random(mut seed) % 60 + 1;
        let logs = random_logs(mut seed, n, m);
        let t = earliest_acq(logs, n);
        if t >= 0 {
            found += 1;
        }
        check = (check * 31 + t + 2) % 1000000007;
    }
    println(f"2000 random groups: {found} come to one, checksum {check}");
    // 100 people, LeetCode's most, every pair of them in a random order
    let logs = random_logs(mut seed, 100, 4950);
    println(f"100 people, {logs.len()} logs: {earliest_acq(logs, 100)}");
    let chain: Vec[Vec[i64]] = (0..99).rev().map(|i| [i, i, i + 1].to_vec()).collect();
    println(f"100 people in a chain: {earliest_acq(chain, 100)}");
}
