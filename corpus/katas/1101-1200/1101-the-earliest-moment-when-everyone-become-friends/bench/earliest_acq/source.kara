// Benchmark: LeetCode #1101 The Earliest Moment When Everyone Become
// Friends -- the ★ arm, union-find over the logs in time order. 64 groups
// of 100 people, LeetCode's most, each with every pair of them at a
// random moment (4950 logs), are built once; each of 20 rounds swaps the
// moments of two logs in every group and finds its earliest moment,
// folding the answers into a checksum. Mirrors earliest_acq.rs, .c, .py
// and go-seq/.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn earliest_acq(logs: Vec[Vec[i64]], n: i64) -> i64 {
    let mut logs = logs.clone();
    logs.sort_by_key(|log| log[0]);
    let mut parent: Vec[i64] = (0..n).collect();
    let mut size: Vec[i64] = Vec.filled(n, 1);
    let mut groups = n;
    for log in logs.iter() {
        let a = find(mut parent, log[1]);
        let b = find(mut parent, log[2]);
        if a == b {
            continue;
        }
        let (big, small) = if size[a] >= size[b] { (a, b) } else { (b, a) };
        parent[small] = big;
        size[big] += size[small];
        groups -= 1;
        if groups == 1 {
            return log[0];
        }
    }
    -1
}

// ---- the workload ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1101;
    let mut groups: Vec[Vec[Vec[i64]]] = [];
    for _ in 0..64 {
        // every pair, at the moments 0 to 4949 shuffled
        let mut times: Vec[i64] = (0..4950).collect();
        for i in (1..4950).rev() {
            times.swap(i, next_random(mut seed) % (i + 1));
        }
        let mut logs: Vec[Vec[i64]] = [];
        for x in 0..100 {
            for y in x + 1..100 {
                logs.push([times[logs.len()] * 1000, x, y]);
            }
        }
        groups.push(logs);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..20 {
        for j in 0..groups.len() {
            let a = (round * 7919 + j * 104729) % 4950;
            let b = (round * 31 + j * 17 + 1) % 4950;
            let t = groups[j][a][0];
            groups[j][a][0] = groups[j][b][0];
            groups[j][b][0] = t;
            let moment = earliest_acq(groups[j], 100);
            total += moment;
            check = (check * 31 + moment + 2) % 1000000007;
        }
    }
    println(f"20 rounds over 64 groups of 100 people: moments sum to {total}, checksum {check}");
}
