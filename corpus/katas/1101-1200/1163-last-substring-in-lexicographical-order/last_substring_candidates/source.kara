// LeetCode #1163: Last Substring in Lexicographical Order -- candidates:
// every place the largest letter stands may start the answer; each round
// compares the survivors' next letter, keeps those holding the largest, and
// drops a survivor that the one before it has run into, since the earlier
// start then holds it as a suffix and wins. O(n log n).

fn last_substring(s: Str) -> String {
    let b: Vec[u8] = s.bytes().iter().collect();
    let n = b.len();
    let top = b.iter().max().unwrap();
    let mut alive: Vec[i64] = (0..n).filter(|i| b[i] == top).collect();
    let mut k = 1;
    while alive.len() > 1 {
        let best = alive.iter().filter(|c| c + k < n).map(|c| b[c + k]).max();
        let mut next: Vec[i64] = [];
        for c in alive.iter() {
            // a start the previous survivor reaches is held inside it
            if let Some(last) = next.last() {
                if last + k >= c {
                    continue;
                }
            }
            let here = if c + k < n { Some(b[c + k]) } else { None };
            if here == best {
                next.push(c);
            }
        }
        alive = next;
        k += 1;
    }
    s[alive[0]..].to_string()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A string of `len` letters over the first `k`.
fn word(seed: mut ref i64, len: i64, k: i64) -> String {
    let b: Vec[u8] = (0..len).map(|_| b'a' + (next_random(mut seed) % k) as u8).collect();
    String.from_utf8(b).unwrap()
}

fn main() {
    // LeetCode's examples and seven more: one letter; one letter repeated;
    // the largest letter last; a period of three; two runs of the largest
    // letter, the longer one later; a prefix tie the longer suffix wins;
    // the largest letter first
    let cases = ["abab", "leetcode", "a", "zzz", "aaab", "abcabcabc", "zazzab", "zyzyzyz", "cbabc"];
    for c in cases.iter() {
        println(f"{c} -> {last_substring(c)}");
    }
    // 2000 random strings of 1 to 30 letters over the first 1 to 4 or all
    // 26: where each answer starts, summed, and a checksum of the answers
    let mut seed = 1163;
    let mut starts = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let k = [1, 2, 3, 4, 26][next_random(mut seed) % 5];
        let s = word(mut seed, 1 + next_random(mut seed) % 30, k);
        let t = last_substring(s);
        starts += s.len() - t.len();
        for b in t.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
    }
    println(f"2000 random strings: starts {starts}, checksum {check}");
    // 4 * 10^5 letters, the constraints' most: one letter repeated; a period
    // of two; random over three letters; every letter `a` but the last
    let n = 400000;
    let big = [
        "z".repeat(n),
        "ab".repeat(n / 2),
        word(mut seed, n, 3),
        "a".repeat(n - 1) + "b",
    ];
    for s in big.iter() {
        let t = last_substring(s);
        println(f"{n} letters: starts at {s.len() - t.len()}, {t.len()} long");
    }
}
