// LeetCode #1138: Alphabet Board Path -- the bench, the ★ arm's algorithm:
// coordinates, up and left first, down and right after.

fn alphabet_board_path(target: String) -> String {
    let mut path = String.new();
    let mut row = 0;
    let mut col = 0;
    for c in target.chars() {
        let k = c as i64 - 'a' as i64;
        let (r, k_col) = (k / 5, k % 5);
        path.push_str("U".repeat((row - r).max(0)));
        path.push_str("L".repeat((col - k_col).max(0)));
        path.push_str("D".repeat((r - row).max(0)));
        path.push_str("R".repeat((k_col - col).max(0)));
        path.push('!');
        row = r;
        col = k_col;
    }
    path
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 1000 targets of 100 letters, LeetCode's longest, built once. Each of
    // 100 rounds draws one letter of every target again and answers it.
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 1138;
    let mut targets: Vec[Vec[char]] = [];
    for _ in 0..1000 {
        let t: Vec[char] = (0..100).map(|_| letters[next_random(mut seed) % 26]).collect();
        targets.push(t);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..100 {
        for j in 0..1000 {
            targets[j][(round * 37 + j) % 100] = letters[next_random(mut seed) % 26];
            let target: String = targets[j].iter().collect();
            let path = alphabet_board_path(target);
            let mid = path.bytes()[path.len() / 2] as i64;
            total += path.len();
            check = (check * 31 + path.len() * 128 + mid) % 1000000007;
        }
    }
    println(f"100 rounds over 1000 targets of 100 letters: lengths total {total}, checksum {check}");
}
