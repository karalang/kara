// LeetCode #1118: Number of Days in a Month -- the days of the year before
// each month, as a running total of the months' lengths taken with
// `scan`, and the month's days the gap between its start and the next
// month's, the year's end standing for a thirteenth month's start. O(1)
// a call over a table of 13.

fn number_of_days(year: i32, month: i32) -> i32 {
    let leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0;
    let lengths = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let starts: Vec[i32] = [0].into_iter()
        .chain(lengths.iter().scan(0, |total, d| {
            let total = total + d;
            Some((total, total))
        }))
        .collect();
    starts[month as i64] - starts[(month - 1) as i64]
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    println(f"1992 7 -> {number_of_days(1992, 7)}");
    println(f"2000 2 -> {number_of_days(2000, 2)}");
    println(f"1900 2 -> {number_of_days(1900, 2)}");
    // every month of a few years: a common year, a leap year, a century
    // that is not a leap year, the first and last years LeetCode allows
    for year in [2023i32, 2024, 2100, 1583, 1600] {
        let days: Vec[String] = (1..13).map(|m| f"{number_of_days(year, m)}").collect();
        println(f"{year}: {days.join(" ")}");
    }
    // every month of every year LeetCode allows, 1583 to 2100: the days
    // summed, the leap Februaries counted, and a checksum in order
    let mut total = 0;
    let mut leap = 0;
    let mut check = 0;
    for year in 1583..2101 {
        for month in 1..13 {
            let d = number_of_days(year, month);
            total += d;
            if month == 2 and d == 29 {
                leap += 1;
            }
            check = (check * 31 + d) % 1000000007;
        }
    }
    println(f"1583 to 2100: {total} days, {leap} leap years, checksum {check}");
}
