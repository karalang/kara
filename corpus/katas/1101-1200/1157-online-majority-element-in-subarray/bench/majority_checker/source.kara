// LeetCode #1157: Online Majority Element In Subarray -- the ★ arm, a
// segment tree of Boyer-Moore votes and the places of each value. A node
// holds the value its range votes for and the votes left to it; two
// ranges merge as one vote over both, where the same value adds and
// different values cancel. Only a value holding more than half a range
// can survive its vote, so a query merges the O(log n) nodes covering its
// range and counts the one survivor there: its places are sorted, and two
// `partition_point`s count those in the range. O(n) to build, O(log n) a
// query.

struct MajorityChecker {
    size: i64,
    tree: Vec[(i64, i64)],
    places: Vec[Vec[i64]],
}

// One vote over two ranges' (value, votes left).
fn vote(a: (i64, i64), b: (i64, i64)) -> (i64, i64) {
    if a.0 == b.0 {
        (a.0, a.1 + b.1)
    } else if a.1 >= b.1 {
        (a.0, a.1 - b.1)
    } else {
        (b.0, b.1 - a.1)
    }
}

impl MajorityChecker {
    fn new(arr: Vec[i32]) -> MajorityChecker {
        let n = arr.len();
        let mut size = 1;
        while size < n {
            size *= 2;
        }
        let mut tree: Vec[(i64, i64)] = Vec.filled(2 * size, (0, 0));
        let mut places: Vec[Vec[i64]] = Vec.filled(20001, []);
        for i in 0..n {
            tree[size + i] = (arr[i] as i64, 1);
            places[arr[i]].push(i);
        }
        for i in (1..size).rev() {
            tree[i] = vote(tree[2 * i], tree[2 * i + 1]);
        }
        MajorityChecker { size, tree, places }
    }

    fn query(self, left: i64, right: i64, threshold: i64) -> i64 {
        let mut lo = left + self.size;
        let mut hi = right + self.size + 1;
        let mut won = (0, 0);
        while lo < hi {
            if lo % 2 == 1 {
                won = vote(won, self.tree[lo]);
                lo += 1;
            }
            if hi % 2 == 1 {
                hi -= 1;
                won = vote(won, self.tree[hi]);
            }
            lo /= 2;
            hi /= 2;
        }
        let p = ref self.places[won.0];
        let count = p.partition_point(|i| i <= right) - p.partition_point(|i| i < left);
        if count >= threshold { won.0 } else { -1 }
    }
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 4 arrays of 20000 values, the most the constraints allow, in four
    // kinds: over 2 values, one value at about two places in three, over
    // all 20000 values, and one value at about half the places. Each gets
    // a checker and 10000 random queries, built once; each of 100 passes
    // answers all of them.
    let passes = 100;
    let mut seed = 1157;
    let mut checkers: Vec[MajorityChecker] = [];
    let mut queries: Vec[Vec[(i64, i64, i64)]] = [];
    for kind in 0..4 {
        let v = 1 + next_random(mut seed) % 20000;
        let arr: Vec[i32] = (0..20000).map(|_| {
            let x = if kind == 0 {
                1 + next_random(mut seed) % 2
            } else if kind == 2 {
                1 + next_random(mut seed) % 20000
            } else if next_random(mut seed) % 100 < (if kind == 1 { 67 } else { 50 }) {
                v
            } else {
                1 + next_random(mut seed) % 20000
            };
            x as i32
        }).collect();
        checkers.push(MajorityChecker.new(arr));
        let qs: Vec[(i64, i64, i64)] = (0..10000).map(|_| {
            let a = next_random(mut seed) % 20000;
            let b = next_random(mut seed) % 20000;
            let (left, right) = (a.min(b), a.max(b));
            let least = (right - left + 1) / 2 + 1;
            (left, right, least + next_random(mut seed) % (right - left + 2 - least))
        }).collect();
        queries.push(qs);
    }
    let mut check = 0;
    for p in 0..passes {
        for k in 0..4 {
            for (left, right, threshold) in queries[k].iter() {
                check = (check * 31 + checkers[k].query(left, right, threshold) + p + 1) % 1000000007;
            }
        }
    }
    println(f"{passes} passes over 4 arrays of 20000 values, 10000 queries each: checksum {check}");
}
