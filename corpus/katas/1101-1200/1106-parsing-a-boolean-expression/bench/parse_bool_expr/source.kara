// LeetCode #1106: Parsing A Boolean Expression -- the bench: the ★ arm
// over 32 expressions of up to about 2 * 10^4 characters, LeetCode's
// longest, each round flipping one value in every expression and parsing
// it again.

fn parse(s: Vec[char], at: mut ref i64) -> bool {
    let c = s[*at];
    *at += 1;
    match c {
        't' => true,
        'f' => false,
        _ => {
            *at += 1;
            let mut values: Vec[bool] = [];
            loop {
                values.push(parse(s, mut at));
                let next = s[*at];
                *at += 1;
                if next == ')' {
                    break;
                }
            }
            match c {
                '!' => not values[0],
                '&' => values.iter().all(|v| v),
                _ => values.iter().any(|v| v),
            }
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random expression of about `budget` operators and values, no deeper
// than `depth`, written onto the end of `out`.
fn random_expr(seed: mut ref i64, out: mut ref Vec[char], budget: i64, depth: i64) {
    if budget <= 1 or depth == 0 {
        out.push(if next_random(mut seed) % 2 == 0 { 't' } else { 'f' });
        return;
    }
    let op = next_random(mut seed) % 3;
    if op == 0 {
        out.push('!');
        out.push('(');
        random_expr(mut seed, mut out, budget - 1, depth - 1);
        out.push(')');
        return;
    }
    let k = next_random(mut seed) % 4 + 1;
    out.push(if op == 1 { '&' } else { '|' });
    out.push('(');
    for i in 0..k {
        if i > 0 {
            out.push(',');
        }
        random_expr(mut seed, mut out, (budget - 1) / k, depth - 1);
    }
    out.push(')');
}

fn main() {
    let mut seed = 1106;
    let mut cases: Vec[Vec[char]] = [];
    let mut values: Vec[Vec[i64]] = [];
    let mut length = 0;
    for _ in 0..32 {
        let mut e: Vec[char] = [];
        random_expr(mut seed, mut e, 6000, 20);
        let at: Vec[i64] = (0..e.len()).filter(|i| e[i] == 't' or e[i] == 'f').collect();
        length += e.len();
        cases.push(e);
        values.push(at);
    }
    let mut trues = 0;
    let mut check = 0;
    for round in 0..200 {
        for j in 0..cases.len() {
            let i = values[j][(round * 7919 + j * 104729) % values[j].len()];
            cases[j][i] = if cases[j][i] == 't' { 'f' } else { 't' };
            let mut at = 0;
            let v = parse(cases[j], mut at);
            if v {
                trues += 1;
            }
            check = (check * 31 + if v { 2 } else { 1 }) % 1000000007;
        }
    }
    println(f"200 rounds over 32 expressions of {length} characters: {trues} true, checksum {check}");
}
