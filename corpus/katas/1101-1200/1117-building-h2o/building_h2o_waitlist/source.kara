// LeetCode #1117: Building H2O -- a condition variable built from a
// `Mutex` and channels, as the C++ and Java solutions use one: the atoms
// let into the molecule being built, and the ones out of it, sit under
// the lock with the atoms waiting to get in. An atom gets in while its
// element has room (two hydrogens, one oxygen); the third atom out
// empties the molecule and wakes every waiter, each of which tries
// again.

import std.sync.{Mutex, TaskGroup};

struct Molecule {
    hydrogens: i64,
    oxygens: i64,
    out: i64,
    waiting: Vec[Sender[()]],
}

sync struct H2o {
    molecule: Mutex[Molecule],
}

impl H2o {
    fn new() -> H2o {
        H2o { molecule: Mutex.new(Molecule { hydrogens: 0, oxygens: 0, out: 0, waiting: [] }) }
    }

    // Waits until the molecule has room for one more of the element.
    fn enter(self, hydrogen: bool) {
        loop {
            let (tx, rx) = channel(1);
            {
                let g = self.molecule.lock();
                if hydrogen and g.value.hydrogens < 2 {
                    g.value.hydrogens += 1;
                    return;
                }
                if not hydrogen and g.value.oxygens < 1 {
                    g.value.oxygens += 1;
                    return;
                }
                g.value.waiting.push(tx);
            }
            let _ = rx.recv();
        }
    }

    // One more atom out; the third empties the molecule.
    fn leave(self) {
        let g = self.molecule.lock();
        g.value.out += 1;
        if g.value.out == 3 {
            g.value.hydrogens = 0;
            g.value.oxygens = 0;
            g.value.out = 0;
            for w in g.value.waiting.drain(0..g.value.waiting.len()) {
                let _ = w.send(());
            }
        }
    }

    fn hydrogen(self, release_hydrogen: Fn()) {
        self.enter(true);
        release_hydrogen();
        self.leave();
    }

    fn oxygen(self, release_oxygen: Fn()) {
        self.enter(false);
        release_oxygen();
        self.leave();
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's run: a task per atom of `water`, started in its order,
// each calling `hydrogen` or `oxygen` with a release function; the atoms
// go to one log, which the run returns.
fn run(water: Str) -> String {
    let log: Mutex[String] = Mutex.new(String.new());
    let h2o = H2o.new();
    {
        let group = TaskGroup.new();
        for c in water.chars() {
            if c == 'H' {
                group.spawn(|| h2o.hydrogen(|| log.lock().value.push_str("H")));
            } else {
                group.spawn(|| h2o.oxygen(|| log.lock().value.push_str("O")));
            }
        }
    }
    let g = log.lock();
    g.value.clone()
}

// How many of `out`'s threes are each two hydrogens and an oxygen, all
// of them for a right answer.
fn molecules(out: Str) -> i64 {
    let b = out.bytes();
    let mut count = 0;
    for i in 0..b.len() / 3 {
        let hs = b[3 * i..3 * i + 3].iter().filter(|c| c == b'H').count();
        if hs == 2 {
            count += 1;
        }
    }
    count
}

// A random water of `n` molecules: n oxygens and 2n hydrogens shuffled.
fn water_of(n: i64, seed: mut ref i64) -> String {
    let mut atoms: Vec[char] = [];
    for _ in 0..n {
        atoms.push('O');
        atoms.push('H');
        atoms.push('H');
    }
    for j in 0..atoms.len() {
        let k = j + next_random(mut seed) % (atoms.len() - j);
        atoms.swap(j, k);
    }
    String.from_iter(atoms.iter().cloned())
}

fn show(water: Str) -> String {
    let out = run(water);
    f"{water}: {out.len()} atoms, {molecules(out)} of {water.len() / 3} molecules whole"
}

fn main() {
    println(show("HOH"));
    println(show("OOHHHH"));
    println(show("HHHHOO"));
    println(show("OHHOHHOHH"));
    // 2000 runs of up to 12 molecules, the atoms in a random order
    let mut seed = 1117;
    let mut right = 0;
    let mut atoms = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let water = water_of(n, mut seed);
        let out = run(water);
        atoms += out.len();
        if molecules(out) == n {
            right += 1;
        }
    }
    println(f"2000 random waters of up to 12 molecules: {atoms} atoms, {right} with every molecule whole");
    // LeetCode's largest, 20 molecules, the oxygens first
    let mut water = "O".repeat(20);
    water.push_str("H".repeat(40));
    println(show(water));
}
