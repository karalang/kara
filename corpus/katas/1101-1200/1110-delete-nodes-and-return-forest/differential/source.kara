// LeetCode #1110: Delete Nodes And Return Forest -- a differential over
// the six arms. Each answer is checked against the statement read
// literally and against five properties that do not compute the answer;
// see the README.

// ---- del_nodes.kara ----

fn a0_prune(node: Option[TreeNode], parent_gone: bool, gone: Set[i32], roots: mut ref Vec[Option[TreeNode]]) -> Option[TreeNode] {
    let n = node?;
    let deleted = gone.contains(n.val);
    if parent_gone and not deleted {
        roots.push(Some(n));
    }
    n.left = a0_prune(n.left, deleted, gone, mut roots);
    n.right = a0_prune(n.right, deleted, gone, mut roots);
    if deleted { None } else { Some(n) }
}

fn a0_del_nodes(root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
    let gone: Set[i32] = to_delete.iter().collect();
    let mut roots: Vec[Option[TreeNode]] = [];
    let _ = a0_prune(root, true, gone, mut roots);
    roots
}

// ---- del_nodes_bfs.kara ----

fn a1_del_nodes(root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
    let gone: Set[i32] = to_delete.iter().collect();
    let mut roots: Vec[Option[TreeNode]] = [];
    let mut queue: VecDeque[(TreeNode, bool)] = VecDeque.new();
    if let Some(r) = root {
        queue.push_back((r, true));
    }
    while let Some((n, parent_gone)) = queue.pop_front() {
        let deleted = gone.contains(n.val);
        if parent_gone and not deleted {
            roots.push(Some(n));
        }
        if let Some(l) = n.left {
            queue.push_back((l, deleted));
            if gone.contains(l.val) {
                n.left = None;
            }
        }
        if let Some(r) = n.right {
            queue.push_back((r, deleted));
            if gone.contains(r.val) {
                n.right = None;
            }
        }
    }
    roots
}

// ---- del_nodes_stack.kara ----

fn a2_del_nodes(root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
    let gone: Set[i32] = to_delete.iter().cloned().collect();
    let mut roots: Vec[Option[TreeNode]] = Vec.new();
    let mut stack: Vec[(TreeNode, bool)] = Vec.new();
    if let Some(r) = root {
        stack.push((r, true));
    }
    while let Some((n, parent_gone)) = stack.pop() {
        let deleted = gone.contains(n.val);
        if parent_gone and not deleted {
            roots.push(Some(n.clone()));
        }
        for left in [true, false] {
            let child = if left { n.left.clone() } else { n.right.clone() };
            if let Some(c) = child {
                if gone.contains(c.val) {
                    if left {
                        n.left = None;
                    } else {
                        n.right = None;
                    }
                }
                stack.push((c, deleted));
            }
        }
    }
    roots
}

// ---- del_nodes_parents.kara ----

fn a3_del_nodes(root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
    let Some(r) = root else {
        return [];
    };
    let mut nodes: Map[i32, TreeNode] = Map.new();
    let mut parent: Map[i32, TreeNode] = Map.new();
    let mut stack: Vec[TreeNode] = [r];
    while let Some(n) = stack.pop() {
        nodes.insert(n.val, n);
        for child in [n.left, n.right] {
            if let Some(c) = child {
                parent.insert(c.val, n);
                stack.push(c);
            }
        }
    }
    let gone: Set[i32] = to_delete.iter().collect();
    let mut roots: Vec[Option[TreeNode]] = [];
    if not gone.contains(r.val) {
        roots.push(Some(r));
    }
    for v in to_delete.iter() {
        let Some(n) = nodes.get(v) else {
            continue;
        };
        if let Some(p) = parent.get(v) {
            if p.left.map(|c| c.val) == Some(v) {
                p.left = None;
            } else {
                p.right = None;
            }
        }
        for child in [n.left, n.right] {
            if let Some(c) = child {
                if not gone.contains(c.val) {
                    roots.push(Some(c));
                }
            }
        }
    }
    roots
}

// ---- del_nodes_pairs.kara ----

fn a4_split(node: Option[TreeNode], gone: Set[i32]) -> (Option[TreeNode], Vec[Option[TreeNode]]) {
    match node {
        None => (None, []),
        Some(n) => {
            let mut (left, below) = a4_split(n.left, gone);
            let (right, more) = a4_split(n.right, gone);
            below.extend(more);
            if gone.contains(n.val) {
                for tree in [left, right] {
                    if tree.is_some() {
                        below.push(tree);
                    }
                }
                (None, below)
            } else {
                (Some(TreeNode { val: n.val, left, right }), below)
            }
        }
    }
}

fn a4_del_nodes(root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
    let gone: Set[i32] = to_delete.iter().collect();
    let mut (tree, roots) = a4_split(root, gone);
    if tree.is_some() {
        roots.push(tree);
    }
    roots
}

// ---- del_nodes_solution.kara ----

fn a5_dfs(node: Option[TreeNode], is_root: bool, set: Set[i32], ans: mut ref Vec[Option[TreeNode]]) -> Option[TreeNode] {
    if let Some(n) = node {
        let deleted = set.contains(n.val);
        if is_root and not deleted {
            ans.push(Some(n.clone()));
        }
        let left = n.left.take();
        let right = n.right.take();
        n.left = a5_dfs(left, deleted, set, mut ans);
        n.right = a5_dfs(right, deleted, set, mut ans);
        if deleted { None } else { Some(n) }
    } else {
        None
    }
}

struct A5Solution {}

impl A5Solution {
    pub fn a5_del_nodes(root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
        let set: Set[i32] = to_delete.clone().into_iter().collect();
        let mut ans = Vec.new();
        let _ = a5_dfs(root, true, set, mut ans);
        ans
    }
}

fn a5_del_nodes(root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
    A5Solution.a5_del_nodes(root, to_delete)
}

// ---- the differential -----------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i32) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn arm(which: i64, root: Option[TreeNode], to_delete: Vec[i32]) -> Vec[Option[TreeNode]] {
    match which {
        0 => a0_del_nodes(root, to_delete),
        1 => a1_del_nodes(root, to_delete),
        2 => a2_del_nodes(root, to_delete),
        3 => a3_del_nodes(root, to_delete),
        4 => a4_del_nodes(root, to_delete),
        _ => a5_del_nodes(root, to_delete),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(text: Str) -> Option[TreeNode] {
    let inner = text.strip_prefix("[").unwrap().strip_suffix("]").unwrap();
    if inner.is_empty() {
        return None;
    }
    let items: Vec[Option[i32]] = inner.split(",").map(|s| if s == "null" { None } else { Some(i32.parse(s).unwrap()) }).collect();
    let root = leaf(items[0].unwrap());
    let mut queue: Vec[TreeNode] = [root];
    let mut head = 0;
    let mut i = 1;
    while i < items.len() {
        let node = queue[head];
        head += 1;
        if let Some(v) = items[i] {
            let child = leaf(v);
            node.left = Some(child);
            queue.push(child);
        }
        i += 1;
        if i < items.len() {
            if let Some(v) = items[i] {
                let child = leaf(v);
                node.right = Some(child);
                queue.push(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// A tree in LeetCode's level-order form, leaving out the nodes `gone`
// holds and everything below them.
fn kept(root: Option[TreeNode], gone: Set[i32]) -> String {
    let mut out: Vec[String] = Vec.new();
    let mut queue: Vec[Option[TreeNode]] = [root];
    let mut head = 0;
    while head < queue.len() {
        match queue[head] {
            Some(n) if not gone.contains(n.val) => {
                out.push(f"{n.val}");
                queue.push(n.left);
                queue.push(n.right);
            }
            _ => out.push("null"),
        }
        head += 1;
    }
    while out.len() > 0 and out[out.len() - 1] == "null" {
        let _ = out.pop();
    }
    f"[{out.join(",")}]"
}

fn written(root: Option[TreeNode]) -> String {
    kept(root, Set.new())
}

fn forest(roots: Vec[Option[TreeNode]]) -> String {
    let mut trees: Vec[(i32, String)] = roots.iter().map(|r| (r.unwrap().val, written(r))).collect();
    trees.sort_by(|a, b| a.0.cmp(b.0));
    let parts: Vec[String] = trees.iter().map(|t| t.1.clone()).collect();
    f"[{parts.join(",")}]"
}

// The statement read literally: a node that stays roots a tree when it
// has no parent or its parent is deleted, and its tree is every node
// below it that stays with no deleted node between.
fn literal(text: Str, to_delete: Vec[i32]) -> String {
    let gone: Set[i32] = to_delete.iter().collect();
    let mut trees: Vec[(i32, String)] = [];
    let mut queue: Vec[(TreeNode, bool)] = [];
    if let Some(r) = parse(text) {
        queue.push((r, true));
    }
    let mut head = 0;
    while head < queue.len() {
        let (n, parent_gone) = queue[head];
        head += 1;
        let deleted = gone.contains(n.val);
        if parent_gone and not deleted {
            trees.push((n.val, kept(Some(n), gone)));
        }
        for child in [n.left, n.right] {
            if let Some(c) = child {
                queue.push((c, deleted));
            }
        }
    }
    trees.sort_by(|a, b| a.0.cmp(b.0));
    let parts: Vec[String] = trees.iter().map(|t| t.1.clone()).collect();
    f"[{parts.join(",")}]"
}

// P2's second reading, by the links: every node of the answer is a node
// of the tree that stays, met once; every link in the answer is a link
// of the tree, on the same side; every root's parent is deleted or there
// is none; and the answer holds as many nodes as stay.
fn by_links(roots: Vec[Option[TreeNode]], text: Str, to_delete: Vec[i32]) -> bool {
    let gone: Set[i32] = to_delete.iter().collect();
    // parent[v]: v's parent and side (0 left, 1 right), -1 for the root
    let mut parent: Vec[(i32, i64)] = Vec.filled(1001, (0, -2));
    let mut stays = 0;
    let mut stack: Vec[TreeNode] = [];
    if let Some(r) = parse(text) {
        parent[r.val] = (0, -1);
        stack.push(r);
    }
    while let Some(n) = stack.pop() {
        if not gone.contains(n.val) {
            stays += 1;
        }
        if let Some(c) = n.left {
            parent[c.val] = (n.val, 0);
            stack.push(c);
        }
        if let Some(c) = n.right {
            parent[c.val] = (n.val, 1);
            stack.push(c);
        }
    }
    let mut seen: Set[i32] = Set.new();
    let mut walk: Vec[TreeNode] = [];
    for r in roots.iter() {
        let Some(n) = r else {
            return false;
        };
        let (p, side) = parent[n.val];
        if side == -2 or (side >= 0 and not gone.contains(p)) {
            return false;
        }
        walk.push(n);
    }
    while let Some(n) = walk.pop() {
        if gone.contains(n.val) or parent[n.val].1 == -2 or seen.contains(n.val) {
            return false;
        }
        seen.insert(n.val);
        if let Some(c) = n.left {
            if parent[c.val] != (n.val, 0) {
                return false;
            }
            walk.push(c);
        }
        if let Some(c) = n.right {
            if parent[c.val] != (n.val, 1) {
                return false;
            }
            walk.push(c);
        }
    }
    seen.len() == stays
}

// Every node's children swapped, all the way down.
fn mirror(node: Option[TreeNode]) {
    if let Some(n) = node {
        let l = n.left;
        n.left = n.right;
        n.right = l;
        mirror(n.left);
        mirror(n.right);
    }
}

// Every node's value v made map[v], all the way down.
fn relabel(node: Option[TreeNode], map: Vec[i32]) {
    if let Some(n) = node {
        n.val = map[n.val];
        relabel(n.left, map);
        relabel(n.right, map);
    }
}

struct Problem {
    text: String,
    to_delete: Vec[i32],
    rotate: i64,
    first: Vec[bool],
    map: Vec[i32],
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn fold(h: i64, text: Str) -> i64 {
    let mut h = h;
    for b in text.bytes() {
        h = (h * 131 + b) % 1000000007;
    }
    h
}

fn check_case(t: mut ref Tally, p: Problem) {
    let text = p.text.clone();
    let del = p.to_delete.clone();
    let m = del.len();
    let want = literal(text, del.clone());
    // P3: the values to delete in another order
    let reordered: Vec[i32] = (0..m).map(|i| del[(p.rotate + m - 1 - i) % m]).collect();
    // P4: deleted in two steps, the first share and then the rest from
    // each tree the first step leaves
    let mut first: Vec[i32] = [];
    let mut rest: Vec[i32] = [];
    for (i, v) in del.iter().enumerate() {
        if p.first[i] {
            first.push(v);
        } else {
            rest.push(v);
        }
    }
    // P5: the tree mirrored
    let flipped = parse(text);
    mirror(flipped);
    let flipped = written(flipped);
    // P6: the values renamed by a permutation of 1 to 1000
    let mut back: Vec[i32] = Vec.filled(1001, 0);
    for v in 1..1001 {
        back[p.map[v]] = v as i32;
    }
    let renamed = parse(text);
    relabel(renamed, p.map.clone());
    let renamed = written(renamed);
    let renamed_del: Vec[i32] = del.iter().map(|v| p.map[v]).collect();
    for w in 0..6 {
        let roots = arm(w, parse(text), del.clone());
        let answer = forest(roots.clone());
        let what = f"arm {w}, {text} without {del} -> {answer}";
        // P1: the statement read literally
        expect(mut t, 1, answer == want, f"P1 {what}, literally {want}");
        // P2: by the links
        expect(mut t, 2, by_links(roots, text, del.clone()), f"P2 {what}");
        // P3: another order
        let r = forest(arm(w, parse(text), reordered.clone()));
        expect(mut t, 3, r == answer, f"P3 {what}, reordered -> {r}");
        // P4: in two steps
        let mut after: Vec[Option[TreeNode]] = [];
        for tree in arm(w, parse(text), first.clone()).iter() {
            after.extend(arm(w, tree, rest.clone()));
        }
        let s = forest(after);
        expect(mut t, 4, s == answer, f"P4 {what}, {first} then {rest} -> {s}");
        // P5: mirrored, the trees mirrored
        let f = arm(w, parse(flipped), del.clone());
        for tree in f.iter() {
            mirror(tree);
        }
        let f = forest(f);
        expect(mut t, 5, f == answer, f"P5 {what}, mirrored -> {f}");
        // P6: renamed, the trees renamed
        let g = arm(w, parse(renamed), renamed_del.clone());
        for tree in g.iter() {
            relabel(tree, back.clone());
        }
        let g = forest(g);
        expect(mut t, 6, g == answer, f"P6 {what}, renamed -> {g}");
    }
    t.cases += 1;
    t.check = fold(t.check, want);
}

// A shuffle of 1 to 1000, the first `size` of it the tree's values.
fn shuffle(seed: mut ref i64) -> Vec[i32] {
    let mut pool: Vec[i32] = (1..1001).collect();
    for i in 0..1000 {
        let j = i + next_random(mut seed) % (1000 - i);
        pool.swap(i, j);
    }
    pool
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 problems in four kinds, 500 each: up to 12 nodes hung at
    // random, each value deleted one time in three, and half the time a
    // value from anywhere in 1 to 1000 put among them; one to three
    // nodes, any of them deleted; a chain of up to 20, each node to a
    // random side, half deleted; and a complete tree of up to 31, a
    // quarter deleted. Every choice is drawn before any arm answers.
    let mut seed = 11101;
    let mut problems: Vec[Problem] = [];
    for i in 0..2000 {
        let pool = shuffle(mut seed);
        let kind = i % 4;
        let size = match kind {
            0 => next_random(mut seed) % 12 + 1,
            1 => next_random(mut seed) % 3 + 1,
            2 => next_random(mut seed) % 20 + 1,
            _ => next_random(mut seed) % 31 + 1,
        };
        let nodes: Vec[TreeNode] = (0..size).map(|k| leaf(pool[k])).collect();
        for k in 1..size {
            if kind == 3 {
                let at = nodes[(k - 1) / 2];
                if k % 2 == 1 {
                    at.left = Some(nodes[k]);
                } else {
                    at.right = Some(nodes[k]);
                }
            } else if kind == 2 {
                if next_random(mut seed) % 2 == 0 {
                    nodes[k - 1].left = Some(nodes[k]);
                } else {
                    nodes[k - 1].right = Some(nodes[k]);
                }
            } else {
                loop {
                    let at = nodes[next_random(mut seed) % k];
                    if next_random(mut seed) % 2 == 0 {
                        if at.left.is_none() {
                            at.left = Some(nodes[k]);
                            break;
                        }
                    } else if at.right.is_none() {
                        at.right = Some(nodes[k]);
                        break;
                    }
                }
            }
        }
        let text = written(Some(nodes[0]));
        let one_in = match kind {
            0 => 3,
            1 => 2,
            2 => 2,
            _ => 4,
        };
        let mut to_delete: Vec[i32] = (0..size).filter(|_| next_random(mut seed) % one_in == 0).map(|k| pool[k]).collect();
        if kind == 0 and next_random(mut seed) % 2 == 0 {
            let v = pool[size + next_random(mut seed) % (1000 - size)];
            let at = next_random(mut seed) % (to_delete.len() + 1);
            to_delete.insert(at, v);
        }
        let rotate = next_random(mut seed);
        let first: Vec[bool] = (0..to_delete.len()).map(|_| next_random(mut seed) % 2 == 0).collect();
        let renamed = shuffle(mut seed);
        let mut map: Vec[i32] = [0];
        map.extend(renamed);
        problems.push(Problem { text, to_delete, rotate, first, map });
    }
    for p in problems.iter() {
        check_case(mut t, p);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
