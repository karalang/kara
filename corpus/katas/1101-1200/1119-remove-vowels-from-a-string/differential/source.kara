// LeetCode #1119: Remove Vowels from a String -- a differential over the
// six arms. Each answer is checked against the statement read literally
// and against five properties that do not compute the answer; see the
// README.

// ---- remove_vowels.kara ----

fn a0_remove_vowels(s: String) -> String {
    s.chars()
        .filter(|c| match c {
            'a' | 'e' | 'i' | 'o' | 'u' => false,
            _ => true,
        })
        .collect()
}

// ---- remove_vowels_push.kara ----

fn a1_remove_vowels(s: String) -> String {
    let mut out = String.with_capacity(s.len());
    for c in s.chars() {
        if not "aeiou".contains(c.to_string()) {
            out.push(c);
        }
    }
    out
}

// ---- remove_vowels_replace.kara ----

fn a2_remove_vowels(s: String) -> String {
    let mut out = s.clone();
    for v in ["a", "e", "i", "o", "u"] {
        out = out.replace(v, "");
    }
    out
}

// ---- remove_vowels_mask.kara ----

const A3VOWELS: u32 = (1 << 0) | (1 << 4) | (1 << 8) | (1 << 14) | (1 << 20);

fn a3_remove_vowels(s: String) -> String {
    let kept: Vec[u8] = s.bytes().iter().filter(|b| (A3VOWELS >> (b - b'a') as u32) & 1 == 0).collect();
    String.from_utf8(kept).unwrap()
}

// ---- remove_vowels_retain.kara ----

fn a4_is_vowel(c: char) -> bool {
    c == 'a' or c == 'e' or c == 'i' or c == 'o' or c == 'u'
}

fn a4_remove_vowels(s: String) -> String {
    let mut out = s.clone();
    out.retain(|c| not a4_is_vowel(c));
    out
}

// ---- remove_vowels_solution.kara ----

struct A5Solution {}

impl A5Solution {
    pub fn a5_remove_vowels(s: String) -> String {
        s.chars().filter(|c| not "aeiou".contains(c.to_string())).collect()
    }
}

fn a5_remove_vowels(s: String) -> String {
    A5Solution.a5_remove_vowels(s)
}

// ---- the differential -----------------------------------------------------

fn arm(which: i64, s: String) -> String {
    match which {
        0 => a0_remove_vowels(s),
        1 => a1_remove_vowels(s),
        2 => a2_remove_vowels(s),
        3 => a3_remove_vowels(s),
        4 => a4_remove_vowels(s),
        _ => a5_remove_vowels(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn vowel(c: char) -> bool {
    "aeiou".chars().any(|v| v == c)
}

// The statement read literally: while a vowel is left, the first one is
// cut out, the text before it and after it kept as they are.
fn literal(s: String) -> String {
    let mut cs: Vec[char] = s.chars().collect();
    loop {
        let mut at = -1;
        for i in 0..cs.len() {
            if vowel(cs[i]) {
                at = i;
                break;
            }
        }
        if at < 0 {
            break;
        }
        let mut next: Vec[char] = cs[0..at].to_vec();
        for c in cs[at + 1..].iter() {
            next.push(c);
        }
        cs = next;
    }
    cs.iter().collect()
}

// P2's second reading: `r` holds no vowel, every letter of `r` is found
// in `s` in order, and `r` is as long as `s` less its vowels.
fn reads_as_kept(r: String, s: String) -> bool {
    let rs: Vec[char] = r.chars().collect();
    let ss: Vec[char] = s.chars().collect();
    let vowels = ss.iter().filter(|c| vowel(c)).count();
    if rs.len() != ss.len() - vowels or rs.iter().any(|c| vowel(c)) {
        return false;
    }
    let mut j = 0;
    for c in ss.iter() {
        if j < rs.len() and rs[j] == c {
            j += 1;
        }
    }
    j == rs.len()
}

fn reversed(s: String) -> String {
    s.chars().rev().collect()
}

// Every consonant of `s` moved to its place in `to`; vowels kept.
fn renamed(s: String, to: Vec[char]) -> String {
    let from: Vec[char] = "bcdfghjklmnpqrstvwxyz".chars().collect();
    s.chars()
        .map(|c| match from.iter().position(|f| f == c) {
            Some(i) => to[i],
            None => c,
        })
        .collect()
}

fn random_text(seed: mut ref i64, n: i64, odds: i64) -> String {
    let vowels: Vec[char] = "aeiou".chars().collect();
    let others: Vec[char] = "bcdfghjklmnpqrstvwxyz".chars().collect();
    let mut s = String.new();
    for _ in 0..n {
        if odds > 0 and next_random(mut seed) % odds == 0 {
            s.push(vowels[next_random(mut seed) % 5]);
        } else {
            s.push(others[next_random(mut seed) % 21]);
        }
    }
    s
}

struct Problem {
    s: String,
    cut: i64,
    to: Vec[char],
    padded: String,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, p: Problem) {
    let s = p.s.clone();
    let want = literal(s.clone());
    let cs: Vec[char] = s.chars().collect();
    let head: String = cs[0..p.cut].iter().collect();
    let tail: String = cs[p.cut..].iter().collect();
    for w in 0..6 {
        let answer = arm(w, s.clone());
        let what = f"arm {w}, \"{s}\" -> \"{answer}\"";
        // P1: the statement read literally
        expect(mut t, 1, answer == want, f"P1 {what}, literally \"{want}\"");
        // P2: by a second reading, what is kept
        expect(mut t, 2, reads_as_kept(answer.clone(), s.clone()), f"P2 {what}");
        // P3: the text cut in two, each part answered, gives the answer
        let joined = arm(w, head.clone()) + arm(w, tail.clone());
        expect(mut t, 3, joined == answer, f"P3 {what}, \"{head}\" + \"{tail}\" -> \"{joined}\"");
        // P4: the text reversed gives the answer reversed
        let r = arm(w, reversed(s.clone()));
        expect(mut t, 4, r == reversed(answer.clone()), f"P4 {what}, reversed -> \"{r}\"");
        // P5: the consonants renamed, before or after, give the same
        let m = arm(w, renamed(s.clone(), p.to.clone()));
        expect(mut t, 5, m == renamed(answer.clone(), p.to.clone()), f"P5 {what}, renamed -> \"{m}\"");
        // P6: vowels put in at random places change nothing, and the
        // answer answered again is itself
        let padded = arm(w, p.padded.clone());
        let again = arm(w, answer.clone());
        expect(mut t, 6, padded == answer and again == answer, f"P6 {what}, \"{p.padded}\" -> \"{padded}\", again \"{again}\"");
    }
    t.cases += 1;
    for c in want.chars() {
        t.check = (t.check * 31 + c as i64) % 1000000007;
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 problems in four kinds, 500 each: up to 30 letters, a vowel one
    // time in two to one time in six; one to three letters, a vowel one
    // time in two; up to 20 letters all vowels or all consonants; and up
    // to 30 letters in runs, each run of one letter repeated. Every choice
    // is drawn before any arm answers.
    let mut seed = 11191;
    let mut problems: Vec[Problem] = [];
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let vowels: Vec[char] = "aeiou".chars().collect();
    for i in 0..2000 {
        let s = match i % 4 {
            0 => random_text(mut seed, next_random(mut seed) % 30 + 1, next_random(mut seed) % 5 + 2),
            1 => random_text(mut seed, next_random(mut seed) % 3 + 1, 2),
            2 => {
                let n = next_random(mut seed) % 20 + 1;
                if next_random(mut seed) % 2 == 0 { random_text(mut seed, n, 1) } else { random_text(mut seed, n, 0) }
            }
            _ => {
                let mut s = String.new();
                while s.len() < 30 {
                    let c = letters[next_random(mut seed) % 26];
                    for _ in 0..next_random(mut seed) % 5 + 1 {
                        s.push(c);
                    }
                }
                s
            }
        };
        let cut = next_random(mut seed) % (s.len() + 1);
        let mut to: Vec[char] = "bcdfghjklmnpqrstvwxyz".chars().collect();
        for j in (1..21).rev() {
            to.swap(j, next_random(mut seed) % (j + 1));
        }
        let mut padded = String.new();
        for c in s.chars() {
            while next_random(mut seed) % 3 == 0 {
                padded.push(vowels[next_random(mut seed) % 5]);
            }
            padded.push(c);
        }
        if next_random(mut seed) % 2 == 0 {
            padded.push(vowels[next_random(mut seed) % 5]);
        }
        problems.push(Problem { s, cut, to, padded });
    }
    for p in problems.iter() {
        check_case(mut t, p);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
