// LeetCode #1177: Can Make Palindrome from Substring -- the parity masks
// of the ★ arm, with each query's odd letters counted by hand: `m &= m -
// 1` clears the lowest set bit, once for each odd letter, and the count
// stops early once it passes `2 * k + 1`, past which the query cannot
// hold. O(n + q).

fn can_make_pali_queries(s: Str, queries: Vec[Vec[i64]]) -> Vec[bool] {
    let mut masks = Vec.filled(s.len() + 1, 0);
    for (i, c) in s.bytes().iter().enumerate() {
        masks[i + 1] = masks[i] ^ (1 << (c - b'a'));
    }
    let mut answer = Vec.new();
    for q in queries.iter() {
        let mut m = masks[q[1] + 1] ^ masks[q[0]];
        let mut odd = 0;
        while m != 0 and odd <= 2 * q[2] + 1 {
            m &= m - 1;
            odd += 1;
        }
        answer.push(odd / 2 <= q[2]);
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` letters drawn from the first `k`.
fn letters(seed: mut ref i64, len: i64, k: i64) -> String {
    let b: Vec[u8] = (0..len).map(|_| b'a' + (next_random(mut seed) % k) as u8).collect();
    String.from_utf8(b).unwrap()
}

// `count` queries over a string of `n` letters, each over at most `span`
// letters, `k` up to `most`.
fn random_queries(seed: mut ref i64, n: i64, count: i64, span: i64, most: i64) -> Vec[Vec[i64]] {
    let mut queries = Vec.new();
    for _ in 0..count {
        let left = next_random(mut seed) % n;
        let right = (left + next_random(mut seed) % span).min(n - 1);
        queries.push([left, right, next_random(mut seed) % (most + 1)]);
    }
    queries
}

// The answers as a count of `true` and a checksum over their order.
fn tally(answers: Vec[bool]) -> (i64, i64) {
    let mut yes = 0;
    let mut check = 0;
    for a in answers.iter() {
        let bit = if a { 1 } else { 0 };
        yes += bit;
        check = (check * 3 + bit + 1) % 1000000007;
    }
    (yes, check)
}

fn main() {
    // LeetCode's two examples
    println(f"example 1: {can_make_pali_queries("abcda", [[3, 3, 0], [1, 2, 0], [0, 3, 1], [0, 3, 2], [0, 4, 1]])}");
    println(f"example 2: {can_make_pali_queries("lyb", [[0, 1, 0], [2, 2, 1]])}");
    // one letter, with k = 0; a palindrome as it stands; two letters
    // differing, with no replacement and with one; k past the substring's
    // length
    println(f"small: {can_make_pali_queries("a", [[0, 0, 0]])} {can_make_pali_queries("racecar", [[0, 6, 0], [1, 5, 0], [0, 5, 0]])} {can_make_pali_queries("ab", [[0, 1, 0], [0, 1, 1], [0, 1, 100000]])}");
    // all 26 letters once: 26 odd letters, so 13 replacements, not 12
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    println(f"alphabet: {can_make_pali_queries(alphabet, [[0, 25, 12], [0, 25, 13], [0, 24, 12], [0, 24, 11]])}");
    // 300 random strings of 1 to 40 letters over the first 1 to 26, 20
    // queries each, k up to 7
    let mut seed = 1177;
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 40;
        let s = letters(mut seed, n, 1 + next_random(mut seed) % 26);
        let queries = random_queries(mut seed, n, 20, n, 7);
        let (y, c) = tally(can_make_pali_queries(s, queries));
        yes += y;
        check = (check * 131 + c) % 1000000007;
    }
    println(f"300 random strings: {yes} of 6000 true, checksum {check}");
    // 100000 letters and 100000 queries, the constraints' most: queries
    // over at most 64 letters with k up to 13, and 100 over any range,
    // which hold for k = 13 or more, about half the time
    let s = letters(mut seed, 100000, 26);
    let mut queries = random_queries(mut seed, 100000, 99900, 64, 13);
    queries.extend(random_queries(mut seed, 100000, 100, 100000, 26));
    let (y, c) = tally(can_make_pali_queries(s, queries));
    println(f"100000 letters, 100000 queries: {y} true, checksum {c}");
}
