// LeetCode #1133: Largest Unique Number -- a differential
// over the five arms. Each answer is checked against the statement read
// literally and against five properties that do not compute the answer;
// see the README.

// ---- largest_unique_number.kara ----

fn a0_largest_unique_number(nums: Vec[i64]) -> i64 {
    let mut count = [0; 1001];
    for x in nums.iter() {
        count[x] += 1;
    }
    for v in (0..1001).rev() {
        if count[v] == 1 {
            return v;
        }
    }
    -1
}

// ---- largest_unique_number_map.kara ----

fn a1_largest_unique_number(nums: Vec[i64]) -> i64 {
    let mut count: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        count[x] = count.get(x).unwrap_or(0) + 1;
    }
    let mut best = -1;
    for (v, c) in count.iter() {
        if c == 1 and v > best {
            best = v;
        }
    }
    best
}

// ---- largest_unique_number_sort.kara ----

fn a2_largest_unique_number(nums: Vec[i64]) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut i = sorted.len() - 1;
    while i >= 0 {
        let mut j = i;
        while j > 0 and sorted[j - 1] == sorted[i] {
            j -= 1;
        }
        if j == i {
            return sorted[i];
        }
        i = j - 1;
    }
    -1
}

// ---- largest_unique_number_sets.kara ----

fn a3_largest_unique_number(nums: Vec[i64]) -> i64 {
    let mut seen: Set[i64] = Set.new();
    let mut repeated: Set[i64] = Set.new();
    for x in nums.iter() {
        if not seen.insert(x) {
            repeated.insert(x);
        }
    }
    seen.iter().filter(|v| not repeated.contains(v)).max().unwrap_or(-1)
}

// ---- largest_unique_number_solution.kara ----

struct A4Solution {}

impl A4Solution {
    pub fn a4_largest_unique_number(nums: Vec[i32]) -> i32 {
        let mut count = Map.new();
        for n in ref nums {
            *count.entry(n).or_insert(0) += 1;
        }
        count
            .into_iter()
            .filter(|(_, c)| c == 1)
            .map(|(n, _)| n)
            .max()
            .unwrap_or(-1)
    }
}

fn a4_largest_unique_number(nums: Vec[i64]) -> i64 {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    A4Solution.a4_largest_unique_number(v)
}

// ---- the differential -----------------------------------------------------

fn arm(which: i64, nums: Vec[i64]) -> i64 {
    match which {
        0 => a0_largest_unique_number(nums),
        1 => a1_largest_unique_number(nums),
        2 => a2_largest_unique_number(nums),
        3 => a3_largest_unique_number(nums),
        _ => a4_largest_unique_number(nums),
    }
}

// The statement read literally: for each value, how often it occurs, by
// counting through the whole array; the largest value that occurs once,
// or -1 when none does.
fn literal(nums: Vec[i64]) -> i64 {
    let mut best = -1;
    for x in nums.iter() {
        let mut times = 0;
        for y in nums.iter() {
            if y == x {
                times += 1;
            }
        }
        if times == 1 and x > best {
            best = x;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn shuffle(seed: mut ref i64, nums: mut ref Vec[i64]) {
    for i in (1..nums.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        nums.swap(i, j);
    }
}

// `n` values: from 0 to 1000; from 0 to 3; 0 and 1000 alone; distinct
// values each twice, and one more alone when `n` is odd; or distinct
// values once each.
fn problem(seed: mut ref i64, kind: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = [];
    match kind {
        0 => {
            for _ in 0..n {
                out.push(next_random(mut seed) % 1001);
            }
        }
        1 => {
            for _ in 0..n {
                out.push(next_random(mut seed) % 4);
            }
        }
        2 => {
            for _ in 0..n {
                out.push(next_random(mut seed) % 2 * 1000);
            }
        }
        _ => {
            let mut pool: Vec[i64] = (0..1001).collect();
            shuffle(mut seed, mut pool);
            let k = if kind == 3 { (n + 1) / 2 } else { n };
            for i in 0..k {
                out.push(pool[i]);
                if kind == 3 and out.len() < n {
                    out.push(pool[i]);
                }
            }
            shuffle(mut seed, mut out);
        }
    }
    out
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i64]) {
    let want = literal(nums);
    // the largest value from 0 to 1000 not in the array
    let mut missing = 1000;
    while nums.contains(missing) {
        missing -= 1;
    }
    for w in 0..5 {
        let answer = arm(w, nums);
        let what = f"arm {w}, case {t.cases} {nums} -> {answer}";
        // P1: the statement read literally
        expect(mut t, 1, answer == want, f"P1 {what}, literally {want}");
        // P2: the values reversed give the same answer
        let rev: Vec[i64] = nums.iter().rev().cloned().collect();
        let r = arm(w, rev);
        expect(mut t, 2, r == answer, f"P2 {what}, reversed {r}");
        // P3: the values sorted give the same answer
        let mut sorted = nums.clone();
        sorted.sort();
        let s = arm(w, sorted);
        expect(mut t, 3, s == answer, f"P3 {what}, sorted {s}");
        // P4: every value appended a second time leaves none alone
        let mut doubled = nums.clone();
        doubled.extend(nums.clone());
        let d = arm(w, doubled);
        expect(mut t, 4, d == -1, f"P4 {what}, doubled {d}");
        // P5: a value not yet in the array, appended once, is the answer
        // when it is above the old one
        let mut more = nums.clone();
        more.push(missing);
        let m = arm(w, more);
        expect(mut t, 5, m == answer.max(missing), f"P5 {what}, with {missing} {m}");
        // P6: the answer appended a second time gives an answer below it;
        // with no answer, the first value appended again leaves none
        let mut again = nums.clone();
        again.push(if answer >= 0 { answer } else { nums[0] });
        let g = arm(w, again);
        let ok = if answer >= 0 { g < answer } else { g == -1 };
        expect(mut t, 6, ok, f"P6 {what}, again {g}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + want + 1) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 problems of 1 to 12 values in five kinds, 400 each: from 0 to
    // 1000; from 0 to 3, so most repeat; 0 and 1000 alone; distinct values
    // each twice, one more alone when the length is odd; and distinct
    // values once each. Every choice is drawn before any arm answers.
    let mut seed = 11331;
    let mut problems: Vec[Vec[i64]] = [];
    for i in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        problems.push(problem(mut seed, i % 5, n));
    }
    for nums in problems.iter() {
        check_case(mut t, nums);
    }
    println(f"{t.cases} problems: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
