// LeetCode #1133: Largest Unique Number -- the bench: the ★ arm over 256
// arrays of 2000 values, LeetCode's largest, built once, each of 1000
// rounds changing one value of every array and answering it again.

fn largest_unique_number(nums: Vec[i64]) -> i64 {
    let mut count = [0; 1001];
    for x in nums.iter() {
        count[x] += 1;
    }
    for v in (0..1001).rev() {
        if count[v] == 1 {
            return v;
        }
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1133;
    let mut arrays: Vec[Vec[i64]] = [];
    for _ in 0..256 {
        let nums: Vec[i64] = (0..2000).map(|_| next_random(mut seed) % 1001).collect();
        arrays.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..1000 {
        for j in 0..256 {
            let at = (round * 7919 + j * 104729) % 2000;
            arrays[j][at] = (arrays[j][at] * 7 + 13) % 1001;
            let r = largest_unique_number(arrays[j]);
            total += r;
            check = (check * 31 + r + 1) % 1000000007;
        }
    }
    println(f"1000 rounds over 256 arrays of 2000 values: answers total {total}, checksum {check}");
}
