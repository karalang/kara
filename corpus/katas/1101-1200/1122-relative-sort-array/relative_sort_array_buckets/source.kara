// LeetCode #1122: Relative Sort Array -- a pass over `arr1` for each
// value of `arr2`, taking every copy of it, then the values `arr2` does
// not hold, sorted. O(n * m + n log n).

fn relative_sort_array(arr1: Vec[i32], arr2: Vec[i32]) -> Vec[i32] {
    let mut out: Vec[i32] = [];
    for x in arr2.iter() {
        for y in arr1.iter() {
            if y == x {
                out.push(y);
            }
        }
    }
    let mut rest: Vec[i32] = arr1.iter().filter(|y| not arr2.contains(y)).collect();
    rest.sort();
    out.extend(rest);
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples and five more: every value named, one value
    // named and the rest left, one value, both ends of the range, and
    // repeats of a value left over
    let cases: Vec[(Vec[i32], Vec[i32])] = [
        ([2, 3, 1, 3, 2, 4, 6, 7, 9, 2, 19], [2, 1, 4, 3, 9, 6]),
        ([28, 6, 22, 8, 44, 17], [22, 28, 8, 6]),
        ([3, 1, 2, 1], [2, 1, 3]),
        ([5, 4, 3, 2, 1, 3], [3]),
        ([7], [7]),
        ([1000, 0, 500, 0, 1000], [1000]),
        ([9, 8, 9, 8, 1], [1]),
    ];
    for (arr1, arr2) in cases.iter() {
        println(f"{arr1}, {arr2} -> {relative_sort_array(arr1, arr2)}");
    }
    // 2000 random problems: up to 1000 values from 0 to a top of 0 to
    // 1000, LeetCode's limits, and arr2 a random choice of their distinct
    // values in a random order: the values placed by arr2, and a checksum
    let mut seed = 1122;
    let mut placed = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 1000 + 1;
        let top = next_random(mut seed) % 1001;
        let mut arr1: Vec[i32] = [];
        for _ in 0..n {
            arr1.push((next_random(mut seed) % (top + 1)) as i32);
        }
        let mut distinct = arr1.clone();
        distinct.sort();
        distinct.dedup();
        for j in (1..distinct.len()).rev() {
            distinct.swap(j, next_random(mut seed) % (j + 1));
        }
        let m = next_random(mut seed) % distinct.len() + 1;
        let arr2: Vec[i32] = distinct[0..m].to_vec();
        let r = relative_sort_array(arr1, arr2);
        placed += r.iter().filter(|x| arr2.contains(x)).count();
        for x in r.iter() {
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"2000 random problems: {placed} values placed by arr2, checksum {check}");
}
