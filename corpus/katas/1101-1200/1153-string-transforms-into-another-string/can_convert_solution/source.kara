// LeetCode #1153: String Transforms Into Another String -- a Rust solution
// as LeetCode's Rust users write it (`impl Solution`, `str1: String`, a
// `HashMap<char, char>` filled by `entry(a).or_insert(b)` and compared at
// every place, and the letters of `str2` counted with a `HashSet` built
// by `collect`), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn can_convert(str1: String, str2: String) -> bool {
        if str1 == str2 {
            return true;
        }
        let mut map: Map[char, char] = Map.new();
        for (a, b) in str1.chars().zip(str2.chars()) {
            if *map.entry(a).or_insert(b) != b {
                return false;
            }
        }
        Set[char].from_iter(str2.chars()).len() < 26
    }
}

fn can_convert(str1: Str, str2: Str) -> bool {
    Solution.can_convert(str1.to_string(), str2.to_string())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(str1: Str, str2: Str) {
    println(f"{str1} {str2}  ->  {can_convert(str1, str2)}");
}

// `n` letters drawn from the first `k`, then a second string: each letter
// of the first sent through a random map onto the first `m` letters, and
// with chance `noise` in 8 one place changed afterwards.
fn pair(seed: mut ref i64, n: i64, k: i64, m: i64, noise: i64) -> (String, String) {
    let mut to: Vec[i64] = [];
    for _ in 0..k {
        to.push(next_random(mut seed) % m);
    }
    let mut a: Vec[u8] = [];
    let mut b: Vec[u8] = [];
    for _ in 0..n {
        let x = next_random(mut seed) % k;
        a.push(b'a' + x as u8);
        b.push(b'a' + to[x] as u8);
    }
    if next_random(mut seed) % 8 < noise {
        let at = next_random(mut seed) % n;
        b[at] = b'a' + (next_random(mut seed) % 26) as u8;
    }
    (String.from_utf8(a).unwrap(), String.from_utf8(b).unwrap())
}

fn main() {
    show("aabcc", "ccdee");
    show("leetcode", "codeleet");
    show("ab", "ba");
    show("aa", "ab");
    show("abc", "abc");
    show("abcdefghijklmnopqrstuvwxyz", "abcdefghijklmnopqrstuvwxyz");
    show("abcdefghijklmnopqrstuvwxyz", "bcdefghijklmnopqrstuvwxyza");
    show("abcdefghijklmnopqrstuvwxy", "bcdefghijklmnopqrstuvwxya");
    show("abcdefghijklmnopqrstuvwxyz", "bbcdefghijklmnopqrstuvwxyz");
    show("abcdefghijklmnopqrstuvwxyza", "bcdefghijklmnopqrstuvwxyzab");

    // 2000 random pairs of 1 to 60 letters, the first from 1 to 26
    // letters, sent onto 1 to 26 letters, with chance 0 to 7 in 8 of one
    // place changed.
    let mut seed = 1153;
    let mut yes = 0;
    let mut check = 0;
    for i in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let k = 1 + next_random(mut seed) % 26;
        let m = 1 + next_random(mut seed) % 26;
        let (a, b) = pair(mut seed, n, k, m, i % 8);
        let ok = can_convert(a, b);
        if ok {
            yes += 1;
        }
        check = (check * 31 + if ok { 2 } else { 1 } + n) % 1000000007;
    }
    println(f"2000 random pairs: {yes} convertible, checksum {check}");

    // 10000 letters, the most the constraints allow: all 26 letters in
    // turn, sent one letter on (false), and sent one letter on with `z`
    // sent to `a` too, so that `z` is free (true); then the first string
    // random over 26 letters, sent through a random map onto 25 (true),
    // and the same with one place broken (false).
    let all: Vec[u8] = (0..10000).map(|i| b'a' + (i % 26) as u8).collect();
    let rot: Vec[u8] = (0..10000).map(|i| b'a' + ((i + 1) % 26) as u8).collect();
    let free: Vec[u8] = (0..10000).map(|i| b'a' + ((i + 1) % 26 % 25) as u8).collect();
    let all = String.from_utf8(all).unwrap();
    println(f"26 letters in turn, sent one on: {can_convert(all, String.from_utf8(rot).unwrap())}");
    println(f"26 letters in turn, sent one on, z and y onto a: {can_convert(all, String.from_utf8(free).unwrap())}");
    let (a, b) = pair(mut seed, 10000, 26, 25, 0);
    println(f"random over 26 sent onto 25: {can_convert(a, b)}");
    let first = a.bytes();
    let at = (1..10000).find(|i| first[i] == first[0]).unwrap();
    let mut broken: Vec[u8] = b.bytes().to_vec();
    broken[at] = if broken[at] == b'a' { b'b' } else { b'a' };
    println(f"the same with one place broken: {can_convert(a, String.from_utf8(broken).unwrap())}");
}
