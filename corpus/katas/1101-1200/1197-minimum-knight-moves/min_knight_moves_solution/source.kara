// LeetCode #1197: Minimum Knight Moves -- a Rust solution as LeetCode's
// Rust users write it: the target folded into the first quadrant, then a
// breadth-first search a level at a time from the origin over a `VecDeque`,
// the squares seen in a `HashSet`, none below -1 in either coordinate,
// carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn min_knight_moves(x: i32, y: i32) -> i32 {
        let (x, y) = (x.abs(), y.abs());
        let dirs = [(1, 2), (2, 1), (-1, 2), (-2, 1), (1, -2), (2, -1), (-1, -2), (-2, -1)];
        let mut seen = Set.new();
        let mut q = VecDeque.new();
        q.push_back((0, 0));
        seen.insert((0, 0));
        let mut steps = 0;
        while not q.is_empty() {
            for _ in 0..q.len() {
                let (cx, cy) = q.pop_front().unwrap();
                if cx == x and cy == y {
                    return steps;
                }
                for (dx, dy) in dirs.iter() {
                    let (nx, ny) = (cx + dx, cy + dy);
                    if nx >= -1 and ny >= -1 and not seen.contains((nx, ny)) {
                        seen.insert((nx, ny));
                        q.push_back((nx, ny));
                    }
                }
            }
            steps += 1;
        }
        -1
    }
}

fn min_knight_moves(x: i64, y: i64) -> i64 {
    Solution.min_knight_moves(x as i32, y as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = [(2, 1), (5, 5), (0, 0), (1, 0), (1, 1), (2, 2), (-1, -2), (0, -1), (3, 0), (300, 0), (0, -300), (150, 150), (-150, 150), (1, 299)];
    for (x, y) in cases {
        println(f"({x}, {y}): {min_knight_moves(x, y)}");
    }
    // 100 random targets with |x| + |y| <= 300
    let mut seed = 1197;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..100 {
        let s = next_random(mut seed) % 301;
        let x = next_random(mut seed) % (s + 1);
        let y = s - x;
        let x = if next_random(mut seed) % 2 == 0 { x } else { -x };
        let y = if next_random(mut seed) % 2 == 0 { y } else { -y };
        let m = min_knight_moves(x, y);
        total += m;
        check = (check * 131 + m + 1) % 1000000007;
    }
    println(f"100 random targets: {total} moves, checksum {check}");
}
