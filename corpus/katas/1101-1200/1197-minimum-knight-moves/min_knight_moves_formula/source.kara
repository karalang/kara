// LeetCode #1197: Minimum Knight Moves -- in closed form. Folded so that
// x >= y >= 0, with d = x - y: when y > d the knight closes both
// coordinates at once and needs d + 2 * ceil((y - d) / 3) moves; otherwise
// it runs along the long side and needs d - 2 * floor((d - y) / 4). Two
// squares next to the origin, (1, 0) and (2, 2), are the exceptions.

fn min_knight_moves(x: i64, y: i64) -> i64 {
    let a = x.abs();
    let b = y.abs();
    let x = a.max(b);
    let y = a.min(b);
    if x == 1 and y == 0 {
        return 3;
    }
    if x == 2 and y == 2 {
        return 4;
    }
    let d = x - y;
    if y > d {
        d + 2 * ((y - d + 2) / 3)
    } else {
        d - 2 * ((d - y) / 4)
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = [(2, 1), (5, 5), (0, 0), (1, 0), (1, 1), (2, 2), (-1, -2), (0, -1), (3, 0), (300, 0), (0, -300), (150, 150), (-150, 150), (1, 299)];
    for (x, y) in cases {
        println(f"({x}, {y}): {min_knight_moves(x, y)}");
    }
    // 100 random targets with |x| + |y| <= 300
    let mut seed = 1197;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..100 {
        let s = next_random(mut seed) % 301;
        let x = next_random(mut seed) % (s + 1);
        let y = s - x;
        let x = if next_random(mut seed) % 2 == 0 { x } else { -x };
        let y = if next_random(mut seed) % 2 == 0 { y } else { -y };
        let m = min_knight_moves(x, y);
        total += m;
        check = (check * 131 + m + 1) % 1000000007;
    }
    println(f"100 random targets: {total} moves, checksum {check}");
}
