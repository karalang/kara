// LeetCode #1183: Maximum Number of Ones -- the counts take at most four
// values: a position's column is on `width / side + 1` columns of the
// matrix when it is among the first `width % side`, on `width / side`
// otherwise, and the same for its row. So the positions fall into four
// classes, and the ones go to the classes with the most cells first.
// O(1) time.

fn maximum_number_of_ones(width: i64, height: i64, side_length: i64, max_ones: i64) -> i64 {
    let (across, extra_across) = (width / side_length, width % side_length);
    let (down, extra_down) = (height / side_length, height % side_length);
    // (cells on each position of the class, positions in the class)
    let mut classes = [
        ((across + 1) * (down + 1), extra_across * extra_down),
        ((across + 1) * down, extra_across * (side_length - extra_down)),
        (across * (down + 1), (side_length - extra_across) * extra_down),
        (across * down, (side_length - extra_across) * (side_length - extra_down)),
    ];
    classes.sort_by(|a, b| b.0.cmp(a.0));
    let mut left = max_ones;
    let mut total = 0;
    for (cells, positions) in classes.iter() {
        let take = left.min(positions);
        total += take * cells;
        left -= take;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"example 1: {maximum_number_of_ones(3, 3, 2, 1)}");
    println(f"example 2: {maximum_number_of_ones(3, 3, 2, 2)}");
    println(f"small 1: {maximum_number_of_ones(1, 1, 1, 0)}");
    println(f"small 2: {maximum_number_of_ones(1, 1, 1, 1)}");
    println(f"small 3: {maximum_number_of_ones(7, 2, 2, 4)}");
    println(f"small 4: {maximum_number_of_ones(5, 8, 3, 2)}");
    println(f"largest 1: {maximum_number_of_ones(100, 100, 1, 1)}");
    println(f"largest 2: {maximum_number_of_ones(100, 100, 100, 10000)}");
    println(f"largest 3: {maximum_number_of_ones(100, 99, 7, 20)}");
    let mut seed: i64 = 1183;
    let mut checksum: i64 = 0;
    for t in 0..3000 {
        let width = 1 + next_random(mut seed) % 100;
        let height = 1 + next_random(mut seed) % 100;
        let side = 1 + next_random(mut seed) % width.min(height);
        let max_ones = next_random(mut seed) % (side * side + 1);
        checksum = (checksum * 31 + maximum_number_of_ones(width, height, side, max_ones) + t) % 1000000007;
    }
    println(f"3000 random matrices: checksum {checksum}");
}
