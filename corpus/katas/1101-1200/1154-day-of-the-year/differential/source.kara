// LeetCode #1154: Day of the Year -- a differential over the five arms.
// Each answer is checked against the statement read literally and against
// six properties that do not compute the answer; see the README.

// ---- day_of_year.kara ----

fn a0_is_leap(year: i64) -> bool {
    year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
}

fn a0_day_of_year(date: Str) -> i64 {
    let year = i64.parse(date[0..4]).unwrap();
    let month = i64.parse(date[5..7]).unwrap();
    let day = i64.parse(date[8..10]).unwrap();
    let before = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let leap_day = if month > 2 and a0_is_leap(year) { 1 } else { 0 };
    before[month - 1] + day + leap_day
}

// ---- day_of_year_split.kara ----

fn a1_day_of_year(date: Str) -> i64 {
    let parts: Vec[i64] = date.split("-").map(|p| i64.parse(p).unwrap()).collect();
    let (year, month, day) = (parts[0], parts[1], parts[2]);
    let mut lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if year % 400 == 0 or (year % 4 == 0 and year % 100 != 0) {
        lengths[1] = 29;
    }
    let mut total = day;
    for m in 0..month - 1 {
        total += lengths[m];
    }
    total
}

// ---- day_of_year_bytes.kara ----

fn a2_number(b: Slice[u8], from: i64, to: i64) -> i64 {
    let mut n = 0;
    for i in from..to {
        n = n * 10 + (b[i] - b'0');
    }
    n
}

fn a2_month_length(year: i64, month: i64) -> i64 {
    if month == 2 {
        if year % 4 != 0 or (year % 100 == 0 and year % 400 != 0) { 28 } else { 29 }
    } else {
        30 + (month + month / 8) % 2
    }
}

fn a2_day_of_year(date: Str) -> i64 {
    let b = date.bytes();
    let year = a2_number(b, 0, 4);
    let month = a2_number(b, 5, 7);
    let mut day = a2_number(b, 8, 10);
    for m in 1..month {
        day += a2_month_length(year, m);
    }
    day
}

// ---- day_of_year_civil.kara ----

fn a3_days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year };
    let era = y / 400;
    let year_of_era = y - era * 400;
    let from_march = (153 * ((month + 9) % 12) + 2) / 5 + day - 1;
    let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + from_march;
    era * 146097 + day_of_era - 719468
}

fn a3_day_of_year(date: Str) -> i64 {
    let fields: Vec[Str] = date.split("-").collect();
    let year = i64.parse(fields[0]).unwrap();
    let month = i64.parse(fields[1]).unwrap();
    let day = i64.parse(fields[2]).unwrap();
    a3_days_from_civil(year, month, day) - a3_days_from_civil(year, 1, 1) + 1
}

// ---- day_of_year_solution.kara ----

struct A4Solution {}

impl A4Solution {
    pub fn a4_day_of_year(date: String) -> i32 {
        let v: Vec[i32] = date.split("-").map(|s| i32.parse(s).unwrap()).collect();
        let (y, m, d) = (v[0], v[1], v[2]);
        let mut days = [31i32, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
        if (y % 4 == 0 and y % 100 != 0) or y % 400 == 0 {
            days[1] = 29;
        }
        days[..(m - 1) as usize].iter().sum() + d
    }
}

fn a4_day_of_year(date: Str) -> i64 {
    A4Solution.a4_day_of_year(date.to_string())
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, date: Str) -> i64 {
    match which {
        0 => a0_day_of_year(date),
        1 => a1_day_of_year(date),
        2 => a2_day_of_year(date),
        3 => a3_day_of_year(date),
        _ => a4_day_of_year(date),
    }
}

fn date(year: i64, month: i64, day: i64) -> String {
    f"{year:04}-{month:02}-{day:02}"
}

// The statement read literally, with the calendar as the rhyme and the
// Gregorian rule give it: thirty days have September, April, June and
// November, February twenty-eight or, in a leap year, twenty-nine, and
// all the rest thirty-one; a year is a leap year when 4 divides it,
// unless 100 does, unless 400 does. The answer is the place of the date
// in the year's days walked from the first of January.
fn literal(year: i64, month: i64, day: i64) -> i64 {
    let leap = if year % 400 == 0 { true } else if year % 100 == 0 { false } else { year % 4 == 0 };
    let mut m = 1;
    let mut d = 1;
    let mut place = 1;
    while m != month or d != day {
        let length = if m == 9 or m == 4 or m == 6 or m == 11 {
            30
        } else if m == 2 {
            if leap { 29 } else { 28 }
        } else {
            31
        };
        if d == length {
            m += 1;
            d = 1;
        } else {
            d += 1;
        }
        place += 1;
    }
    place
}

// The harness's own month lengths: 31 less the parity of `(month - 1) %
// 7`, February apart.
fn days_in(year: i64, month: i64) -> i64 {
    if month == 2 {
        if year % 400 == 0 or (year % 4 == 0 and year % 100 != 0) { 29 } else { 28 }
    } else {
        31 - (month - 1) % 7 % 2
    }
}

// The date after, by the harness's month lengths.
fn next_date(year: i64, month: i64, day: i64) -> (i64, i64, i64) {
    if day < days_in(year, month) {
        (year, month, day + 1)
    } else if month < 12 {
        (year, month + 1, 1)
    } else {
        (year + 1, 1, 1)
    }
}

// A date in four kinds: any date the constraints allow (1900 to 2019);
// any date of a four-digit year (1 to 9999); a first, last or
// second-to-last day of a month in a year that 100 divides, where the
// leap rule's exceptions fall; and the first of January, the last of
// February, the first of March or the last of December in any year.
fn problem(seed: mut ref i64, kind: i64) -> (i64, i64, i64) {
    let year = match kind {
        0 => 1900 + next_random(mut seed) % 120,
        1 => 1 + next_random(mut seed) % 9999,
        2 => 100 * (1 + next_random(mut seed) % 99),
        _ => 1 + next_random(mut seed) % 9999,
    };
    if kind < 2 {
        let month = 1 + next_random(mut seed) % 12;
        return (year, month, 1 + next_random(mut seed) % days_in(year, month));
    }
    if kind == 2 {
        let month = 1 + next_random(mut seed) % 12;
        let length = days_in(year, month);
        let day = match next_random(mut seed) % 3 {
            0 => 1,
            1 => length,
            _ => length - 1,
        };
        return (year, month, day);
    }
    match next_random(mut seed) % 4 {
        0 => (year, 1, 1),
        1 => (year, 2, days_in(year, 2)),
        2 => (year, 3, 1),
        _ => (year, 12, 31),
    }
}

struct Case {
    year: i64,
    month: i64,
    day: i64,
    // P7's other date of the same year
    other_month: i64,
    other_day: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    let (y, m, d) = (c.year, c.month, c.day);
    let s = date(y, m, d);
    let want = literal(y, m, d);
    let (ny, nm, nd) = next_date(y, m, d);
    let after = date(ny, nm, nd);
    let later = if y + 400 <= 9999 { y + 400 } else { y - 400 };
    let shifted = date(later, m, d);
    let first = date(y, m, 1);
    let march = date(y, 3, 1);
    let december = date(y, 12, 31);
    let other = date(y, c.other_month, c.other_day);
    let other_first = c.other_month < m or (c.other_month == m and c.other_day < d);
    for w in 0..5 {
        let got = arm(w, s);
        let what = f"arm {w}, case {t.cases} {s} -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literally {want}");
        // P2: the day after is one more, or the first of a year
        if ny < 10000 {
            let a = arm(w, after);
            let ok = if ny == y { a == got + 1 } else { a == 1 and (got == 365 or got == 366) };
            expect(mut t, 2, ok, f"P2 {what}, {after} {a}");
        }
        // P3: the calendar repeats every 400 years
        let r = arm(w, shifted);
        expect(mut t, 3, r == got, f"P3 {what}, {shifted} {r}");
        // P4: within a month, the answer less the day does not change
        let f = arm(w, first);
        expect(mut t, 4, got - d == f - 1, f"P4 {what}, {first} {f}");
        // P5: from the first of March to the last of December is the same
        // 305 days in every year
        let e = arm(w, december) - arm(w, march);
        expect(mut t, 5, e == 305, f"P5 {what}, March 1 to December 31 {e}");
        // P6: January's days are their own answers, and February's follow
        // January's 31
        if m <= 2 {
            expect(mut t, 6, got == d + 31 * (m - 1), f"P6 {what}");
        }
        // P7: an earlier date of the same year answers less, a later one
        // more
        let o = arm(w, other);
        let ordered = if other_first { o < got } else if o == got { other == s } else { o > got };
        expect(mut t, 7, ordered, f"P7 {what}, {other} {o}");
    }
    t.cases += 1;
    t.check = (t.check * 31 + arm(0, s)) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(8, 0) };
    // 4000 dates in four kinds, 1000 each. Every choice the properties
    // make is drawn before any arm answers.
    let mut seed = 11541;
    let mut cases: Vec[Case] = [];
    for i in 0..4000 {
        let (year, month, day) = problem(mut seed, i % 4);
        let other_month = 1 + next_random(mut seed) % 12;
        let other_day = 1 + next_random(mut seed) % days_in(year, other_month);
        cases.push(Case { year, month, day, other_month, other_day });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} dates: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..8).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
