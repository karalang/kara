// LeetCode #630: Course Schedule III -- deadlines in order, a heap.
//
// Take the courses by last day. Add each; if the total time then runs
// past its last day, drop the longest course taken so far, which may be
// this one. The count never shrinks, and each drop leaves the shortest
// total time for that count, so later courses have the most room.
// A largest-first `PriorityQueue` holds the durations taken.
// O(n log n).

fn schedule_course(courses: Vec[Vec[i64]]) -> i64 {
    let mut order = courses.clone();
    order.sort_by(|a, b| a[1].cmp(b[1]));
    let mut taken: PriorityQueue[i64] = PriorityQueue.max_first();
    let mut time = 0;
    for course in order.iter() {
        time += course[0];
        taken.push(course[0]);
        if time > course[1] {
            time -= taken.pop().unwrap();
        }
    }
    taken.len()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 inputs of 10,000 courses, the problem's most, each lasting 1 to
    // a random longest from 10 to 1,000 days with a last day from 1 to
    // 10,000, made once; then 200 times answers one of them, picked by
    // the round, adding up the answers and putting each into a checksum.
    let inputs = 20;
    let rounds = 200;
    let mut seed: i64 = 630;
    let mut all: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..inputs {
        let longest = 10 + next_random(mut seed) % 991;
        let mut courses: Vec[Vec[i64]] = Vec.new();
        for _ in 0..10000 {
            let duration = 1 + next_random(mut seed) % longest;
            let last = 1 + next_random(mut seed) % 10000;
            courses.push(vec![duration, last]);
        }
        all.push(courses);
    }
    let mut sum = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let c = schedule_course(all[(r * 7) % inputs]);
        sum += c;
        checksum = (checksum * 31 + c) % 1000000007;
    }
    println(f"{inputs} inputs, {rounds} rounds: total {sum}, checksum {checksum}");
}
