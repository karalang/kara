// LeetCode #694: Number of Distinct Islands -- union-find, then sort.
//
// No hashing: union-find joins each land cell to its land neighbours.
// Read in order, an island's cells come first-cell first, so each one's
// offset from the first cell, packed as 200 times the row offset plus
// the column offset, comes out already sorted. The shapes are then
// sorted and equal neighbours counted once. O(m n log(m n)) time,
// O(m n) space.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut at = x;
    while parent[at] != root {
        let next = parent[at];
        parent[at] = root;
        at = next;
    }
    root
}

fn num_distinct_islands(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut parent: Vec[i64] = Vec.new();
    for i in 0..m * n {
        parent.push(i);
    }
    for r in 0..m {
        for c in 0..n {
            if grid[r][c] == 0 {
                continue;
            }
            if r + 1 < m and grid[r + 1][c] == 1 {
                let a = find(mut parent, r * n + c);
                let b = find(mut parent, (r + 1) * n + c);
                parent[a] = b;
            }
            if c + 1 < n and grid[r][c + 1] == 1 {
                let a = find(mut parent, r * n + c);
                let b = find(mut parent, r * n + c + 1);
                parent[a] = b;
            }
        }
    }
    // For each root, the island's first cell and its offsets so far.
    let mut first: Vec[i64] = vec![-1; m * n];
    let mut slot: Vec[i64] = vec![-1; m * n];
    let mut shapes: Vec[Vec[i64]] = Vec.new();
    for r in 0..m {
        for c in 0..n {
            if grid[r][c] == 0 {
                continue;
            }
            let root = find(mut parent, r * n + c);
            if first[root] < 0 {
                first[root] = r * n + c;
                slot[root] = shapes.len();
                shapes.push(Vec.new());
            }
            let r0 = first[root] / n;
            let c0 = first[root] % n;
            shapes[slot[root]].push((r - r0) * 200 + (c - c0));
        }
    }
    shapes.sort();
    let mut distinct = 0;
    for i in 0..shapes.len() {
        if i == 0 or shapes[i] != shapes[i - 1] {
            distinct += 1;
        }
    }
    distinct
}

// ---- harness ---------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn grid_of(rows: ref Vec[Str]) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for row in rows.iter() {
        let mut line: Vec[i64] = Vec.new();
        for b in row.bytes().iter() {
            line.push(*b as i64 - 48);
        }
        grid.push(line);
    }
    grid
}

// An m by n grid, each cell land with probability `percent` in 100.
fn random_grid(m: i64, n: i64, percent: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut line: Vec[i64] = Vec.new();
        for _ in 0..n {
            line.push(if next_random(mut seed) % 100 < percent { 1 } else { 0 });
        }
        grid.push(line);
    }
    grid
}

fn main() {
    // The two LeetCode examples.
    let ex1 = num_distinct_islands(grid_of(vec!["11000", "11000", "00011", "00011"]));
    let ex2 = num_distinct_islands(grid_of(vec!["11011", "10000", "00001", "11011"]));
    println(f"example 1: {ex1}");
    println(f"example 2: {ex2}");
    // One cell of water; a 50 by 50 grid of land; a 50 by 50 checkerboard.
    let water = num_distinct_islands(grid_of(vec!["0"]));
    let mut land: Vec[Vec[i64]] = Vec.new();
    let mut board: Vec[Vec[i64]] = Vec.new();
    for r in 0..50 {
        land.push(vec![1; 50]);
        let mut line: Vec[i64] = Vec.new();
        for c in 0..50 {
            line.push((r + c) % 2);
        }
        board.push(line);
    }
    println(f"water: {water}, all land: {num_distinct_islands(land)}, checkerboard: {num_distinct_islands(board)}");
    // An L and its mirror image are different shapes, and so are an L
    // and the same L turned; two copies of one are not.
    let mirrored = num_distinct_islands(grid_of(vec!["11000", "10000", "00011", "00001"]));
    let turned = num_distinct_islands(grid_of(vec!["11000", "10000", "00001", "00011"]));
    let copies = num_distinct_islands(grid_of(vec!["11011", "10010", "00000", "11000", "10000"]));
    println(f"an L and its mirror: {mirrored}, an L turned: {turned}, three copies: {copies}");
    // 200 random grids of up to 50 by 50, land from 10 to 70 percent.
    let mut seed = 694;
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..200 {
        let m = 1 + next_random(mut seed) % 50;
        let n = 1 + next_random(mut seed) % 50;
        let percent = 10 + next_random(mut seed) % 61;
        let r = num_distinct_islands(random_grid(m, n, percent, mut seed));
        total += r;
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"200 random grids: {total} distinct islands in all, checksum {checksum}");
}
