// LeetCode #695: Max Area of Island -- breadth first with a queue.
//
// The same sweep with a `VecDeque` in place of recursion: each new
// island's cells are marked as they are queued, so none is counted
// twice, and the island's area is the number of cells taken off the
// queue. O(m n) time and space.

fn max_area_of_island(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut seen: Vec[Vec[bool]] = vec![vec![false; n]; m];
    let dr = [1, -1, 0, 0];
    let dc = [0, 0, 1, -1];
    let mut best = 0;
    for r0 in 0..m {
        for c0 in 0..n {
            if grid[r0][c0] == 0 or seen[r0][c0] {
                continue;
            }
            let mut area = 0;
            let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
            queue.push_back((r0, c0));
            seen[r0][c0] = true;
            while queue.len() > 0 {
                let (r, c) = queue.pop_front().unwrap();
                area += 1;
                for d in 0..4 {
                    let nr = r + dr[d];
                    let nc = c + dc[d];
                    if nr >= 0 and nc >= 0 and nr < m and nc < n and grid[nr][nc] == 1 and not seen[nr][nc] {
                        seen[nr][nc] = true;
                        queue.push_back((nr, nc));
                    }
                }
            }
            best = best.max(area);
        }
    }
    best
}

// ---- harness ---------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn grid_of(rows: ref Vec[Str]) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for row in rows.iter() {
        let mut line: Vec[i64] = Vec.new();
        for b in row.bytes().iter() {
            line.push(*b as i64 - 48);
        }
        grid.push(line);
    }
    grid
}

fn main() {
    // The two LeetCode examples.
    let ex1 = grid_of(vec![
        "0010000000000",
        "0000000111000",
        "0110100000000",
        "0100110010100",
        "0100110011100",
        "0000000000100",
        "0000000111000",
        "0000000110000",
    ]);
    println(f"example 1: {max_area_of_island(ex1)}");
    println(f"example 2: {max_area_of_island(grid_of(vec!["00000000"]))}");
    // 50 by 50 grids: all land, a checkerboard, and a snake that runs
    // along every other row and turns at alternate ends.
    let mut land: Vec[Vec[i64]] = Vec.new();
    let mut board: Vec[Vec[i64]] = Vec.new();
    let mut snake: Vec[Vec[i64]] = Vec.new();
    for r in 0..50 {
        land.push(vec![1; 50]);
        let mut line: Vec[i64] = Vec.new();
        let mut path: Vec[i64] = Vec.new();
        for c in 0..50 {
            line.push((r + c) % 2);
            let turn = if r % 4 == 1 { c == 49 } else { c == 0 };
            path.push(if r % 2 == 0 or turn { 1 } else { 0 });
        }
        board.push(line);
        snake.push(path);
    }
    println(f"all land: {max_area_of_island(land)}, checkerboard: {max_area_of_island(board)}, snake: {max_area_of_island(snake)}");
    // One column of land, one row of land, and two islands that touch
    // only at a corner.
    let column = grid_of(vec!["1", "1", "1", "1", "1"]);
    let corner = grid_of(vec!["110", "110", "001"]);
    println(f"a column: {max_area_of_island(column)}, a row: {max_area_of_island(grid_of(vec!["1111111"]))}, corners: {max_area_of_island(corner)}");
    // 200 random grids of up to 50 by 50, land from 10 to 80 percent.
    let mut seed = 695;
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..200 {
        let m = 1 + next_random(mut seed) % 50;
        let n = 1 + next_random(mut seed) % 50;
        let percent = 10 + next_random(mut seed) % 71;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut line: Vec[i64] = Vec.new();
            for _ in 0..n {
                line.push(if next_random(mut seed) % 100 < percent { 1 } else { 0 });
            }
            grid.push(line);
        }
        let r = max_area_of_island(grid);
        total += r;
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"200 random grids: largest areas sum to {total}, checksum {checksum}");
}
