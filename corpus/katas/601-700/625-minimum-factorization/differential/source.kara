// LeetCode #625: differential -- the four arms against the definition.
//
// Copies of the four arms, each held to five properties on random
// numbers.

// ---- star arm ----------------------------------------------------------

fn smallest_factorization_star(num: i64) -> i64 {
    if num < 10 {
        return num;
    }
    let mut rest = num;
    let mut answer = 0;
    let mut place = 1;
    let mut d = 9;
    while d >= 2 {
        while rest % d == 0 {
            rest /= d;
            answer += d * place;
            place *= 10;
            if answer > 2147483647 {
                return 0;
            }
        }
        d -= 1;
    }
    if rest == 1 { answer } else { 0 }
}

// ---- primes arm --------------------------------------------------------

fn smallest_factorization_primes(num: i64) -> i64 {
    if num < 10 {
        return num;
    }
    let mut rest = num;
    let mut counts = vec![0; 10];
    for p in vec![2, 3, 5, 7] {
        while rest % p == 0 {
            rest /= p;
            counts[p] += 1;
        }
    }
    if rest != 1 {
        return 0;
    }
    let mut digits: Vec[i64] = Vec.new();
    for _ in 0..counts[3] / 2 {
        digits.push(9);
    }
    for _ in 0..counts[2] / 3 {
        digits.push(8);
    }
    let mut threes = counts[3] % 2;
    let mut twos = counts[2] % 3;
    if threes == 1 and twos >= 1 {
        digits.push(6);
        threes = 0;
        twos -= 1;
    }
    if twos == 2 {
        digits.push(4);
        twos = 0;
    }
    if twos == 1 {
        digits.push(2);
    }
    if threes == 1 {
        digits.push(3);
    }
    for _ in 0..counts[5] {
        digits.push(5);
    }
    for _ in 0..counts[7] {
        digits.push(7);
    }
    digits.sort();
    let mut answer = 0;
    for d in digits.iter() {
        answer = answer * 10 + *d;
    }
    if answer > 2147483647 { 0 } else { answer }
}

// ---- search arm --------------------------------------------------------

fn smallest_factorization_search(num: i64) -> i64 {
    if num < 10 {
        return num;
    }
    for length in 2..11 {
        if let Some(found) = search_search(num, length, 2, 0) {
            return if found > 2147483647 { 0 } else { found };
        }
    }
    0
}

// The smallest number made by appending `left` digits, none below
// `lowest`, to `prefix`, whose digits multiply to `rest`.
fn search_search(rest: i64, left: i64, lowest: i64, prefix: i64) -> Option[i64] {
    if left == 0 {
        return if rest == 1 { Some(prefix) } else { None };
    }
    for d in lowest..10 {
        if rest % d == 0 {
            if let Some(found) = search_search(rest / d, left - 1, d, prefix * 10 + d) {
                return Some(found);
            }
        }
    }
    None
}

// ---- text arm ----------------------------------------------------------

fn smallest_factorization_text(num: i64) -> i64 {
    if num < 10 {
        return num;
    }
    let mut rest = num;
    let mut largest_first = String.new();
    for d in vec![9, 8, 7, 6, 5, 4, 3, 2] {
        while rest % d == 0 {
            rest /= d;
            largest_first.push_str(f"{d}");
        }
    }
    if rest != 1 {
        return 0;
    }
    let mut digits = String.new();
    for c in largest_first.chars().rev() {
        digits.push(c);
    }
    let limit = "2147483647";
    if digits.len() > limit.len() or (digits.len() == limit.len() and digits > limit) {
        return 0;
    }
    i64.parse(digits).unwrap()
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, num: i64) -> i64 {
    if which == 0 {
        smallest_factorization_star(num)
    } else if which == 1 {
        smallest_factorization_primes(num)
    } else if which == 2 {
        smallest_factorization_search(num)
    } else {
        smallest_factorization_text(num)
    }
}

fn digit_product(x: i64) -> i64 {
    let mut product = 1;
    let mut rest = x;
    while rest > 0 {
        product *= rest % 10;
        rest /= 10;
    }
    product
}

// The definition: counting up from 1, the first number whose digits
// multiply to `num`, or 0. It is a table built once of the first such
// number below 100,000 for every product, so it covers only the numbers
// tested here, whose answers, when they have one, all have five digits
// or fewer.
fn definition_table() -> Map[i64, i64] {
    let mut first: Map[i64, i64] = Map.new();
    for x in 1..100000 {
        let p = digit_product(x);
        if not first.contains_key(p) {
            first.insert(p, x);
        }
    }
    first
}

// The digits of `x`, last first.
fn digits_of(x: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut rest = x;
    while rest > 0 {
        out.push(rest % 10);
        rest /= 10;
    }
    out
}

// Whether a prime above 7 divides `num`.
fn has_large_prime(num: i64) -> bool {
    let mut rest = num;
    for p in vec![2, 3, 5, 7] {
        while rest % p == 0 {
            rest /= p;
        }
    }
    rest != 1
}

// The product of `count` random digits from 2 to 9, a digit skipped
// when it would take the product past `limit`.
fn random_product(count: i64, limit: i64, seed: mut ref i64) -> i64 {
    let mut num = 1;
    for _ in 0..count {
        let d = 2 + next_random(mut seed) % 8;
        if num * d <= limit {
            num *= d;
        }
    }
    num
}

fn main() {
    let table = definition_table();
    let count = 1000;
    let mut seed: i64 = 6250;
    let mut checks = 0;
    let mut answered = 0;
    let mut failures = vec![0; 5];
    for i in 0..count {
        // Half the numbers a product of 1 to 5 digits from 2 to 9, half
        // a random number from 1 to 3,000; and for P5, a product of 6 to
        // 10 digits below 2^31 / 9.
        let num = if i % 2 == 0 {
            random_product(1 + next_random(mut seed) % 5, 59049, mut seed)
        } else {
            1 + next_random(mut seed) % 3000
        };
        let big = random_product(6 + next_random(mut seed) % 5, 2147483647 / 9, mut seed);
        let want = table.get(num) ?? 0;
        if want > 0 {
            answered += 1;
        }
        for which in 0..4 {
            let got = answer(which, num);
            let digits = digits_of(got);
            let mut product = 1;
            let mut sorted = true;
            let mut no_ones = true;
            for k in 0..digits.len() {
                product *= digits[k];
                if k > 0 and digits[k] > digits[k - 1] {
                    sorted = false;
                }
                if digits[k] < 2 {
                    no_ones = false;
                }
            }
            let small = answer(which, big);
            let nine = if small == 0 or small * 10 + 9 > 2147483647 { 0 } else { small * 10 + 9 };
            let ok = vec![
                // P1: the definition's number.
                got == want,
                // P2: a nonzero answer's digits multiply to `num`, and
                // above 9 none of them is a 0 or a 1.
                got == 0 or (product == num and (num < 10 or no_ones)),
                // P3: the answer is 0 exactly when a prime above 7
                // divides `num`, which here is never too large for
                // 31 bits.
                (got == 0) == has_large_prime(num),
                // P4: the digits never go down.
                sorted,
                // P5: nine times a larger product gives that product's
                // answer with a 9 put last, or 0 if it then passes 31
                // bits, since the largest digits are taken out first.
                small == 0 or answer(which, big * 9) == nine,
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                }
            }
        }
    }
    let all = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases ({answered} with an answer), 4 arms, {checks} checks, {all} failures");
    if all > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
