// Benchmark for #606: the ★ arm (write it out); see tree2str.kara.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn write(node: TreeNode, out: mut ref String) {
    out.push_str(f"{node.val}");
    if node.left.is_some() or node.right.is_some() {
        out.push('(');
        if let Some(l) = node.left {
            write(l, out);
        }
        out.push(')');
    }
    if let Some(r) = node.right {
        out.push('(');
        write(r, out);
        out.push(')');
    }
}

fn tree2str(root: Option[TreeNode]) -> String {
    let mut out = String.new();
    if let Some(r) = root {
        write(r, mut out);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 random trees of 10,000 nodes (the problem's most), each new
    // node walking down from the root and going left with chance 50 to
    // 88 in 100, built once, the nodes kept in the order they were
    // added. Then 200 times over every tree the subtree at one of its
    // first 16 nodes, picked by the round and the tree, is written out;
    // the lengths are added up and every 101st character goes into a
    // checksum.
    let trees = 20;
    let rounds = 200;
    let mut seed: i64 = 606;
    let mut all: Vec[Vec[TreeNode]] = Vec.new();
    for g in 0..trees {
        let lean = 50 + 2 * g;
        let root = TreeNode { val: next_random(mut seed) % 2001 - 1000, left: None, right: None };
        let mut nodes: Vec[TreeNode] = vec![root];
        for _ in 1..10000 {
            let c = TreeNode { val: next_random(mut seed) % 2001 - 1000, left: None, right: None };
            let mut node = root;
            loop {
                if next_random(mut seed) % 100 < lean {
                    match node.left {
                        Some(l) => node = l,
                        None => {
                            node.left = Some(c);
                            break;
                        }
                    }
                } else {
                    match node.right {
                        Some(r) => node = r,
                        None => {
                            node.right = Some(c);
                            break;
                        }
                    }
                }
            }
            nodes.push(c);
        }
        all.push(nodes);
    }
    let mut length = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        for t in 0..trees {
            let k = (r * 37 + t * 11) % 16;
            let s = tree2str(Some(all[t][k]));
            length += s.len();
            for (i, c) in s.chars().enumerate() {
                if i % 101 == 0 {
                    checksum = (checksum * 31 + c as i64) % 1000000007;
                }
            }
        }
    }
    println(f"{trees} trees, {rounds} times each: {length} characters, checksum {checksum}");
}
