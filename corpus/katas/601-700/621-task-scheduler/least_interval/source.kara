// LeetCode #621: Task Scheduler -- counting the frame.
//
// The letters that occur most often, say `most` times each, decide the
// shape: their runs need `most - 1` gaps of `n` slots between them, so
// the schedule is at least `(most - 1) * (n + 1)` slots plus one for
// each letter tied at `most`. Every other task fits into the gaps, and
// once the gaps are full no idle slot is needed at all, so the answer is
// that frame or the number of tasks, whichever is larger. O(tasks).

fn least_interval(tasks: Slice[char], n: i64) -> i64 {
    let mut counts = vec![0; 26];
    for t in tasks.iter() {
        counts[(*t as i64) - ('A' as i64)] += 1;
    }
    let mut most = 0;
    for c in counts.iter() {
        if *c > most {
            most = *c;
        }
    }
    let mut tied = 0;
    for c in counts.iter() {
        if *c == most {
            tied += 1;
        }
    }
    let frame = (most - 1) * (n + 1) + tied;
    frame.max(tasks.len())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letters(s: Str) -> Vec[char] {
    let mut tasks: Vec[char] = Vec.new();
    for ch in s.chars() {
        tasks.push(ch);
    }
    tasks
}

fn show(s: Str, n: i64) {
    println(f"{s}, n = {n} -> {least_interval(letters(s), n)}");
}

// `size` random tasks from the first `kinds` letters, letter i drawn
// with weight i + 1 when `skew` is set, so a few letters dominate.
fn random_tasks(size: i64, kinds: i64, skew: bool, seed: mut ref i64) -> Vec[char] {
    let mut tasks: Vec[char] = Vec.new();
    let weight = if skew { kinds * (kinds + 1) / 2 } else { kinds };
    for _ in 0..size {
        let mut r = next_random(mut seed) % weight;
        let mut k = 0;
        if skew {
            while r > k {
                r -= k + 1;
                k += 1;
            }
        } else {
            k = r;
        }
        tasks.push(((65 + k) as u8) as char);
    }
    tasks
}

fn main() {
    // The LeetCode examples.
    show("AAABBB", 2);
    show("ACABDB", 1);
    show("AAABBB", 3);
    // One task; no cooling; one letter only; every letter once with a
    // long cooling; ties at the most; enough other letters to fill every
    // gap, and one more than enough.
    show("A", 100);
    show("AAAABBBCCD", 0);
    show("AAAA", 3);
    show("ABCDEFGHIJKLMNOPQRSTUVWXYZ", 100);
    show("AAABBBCCCDD", 2);
    show("AAABCDE", 2);
    show("AAABCDEFG", 2);
    // 300 random lists of 1 to 60 tasks from the first 1 to 26 letters,
    // cooling 0 to 12, evenly or skewed.
    let mut seed: i64 = 621;
    let mut sum = 0;
    let mut checksum = 0;
    for _ in 0..300 {
        let size = 1 + next_random(mut seed) % 60;
        let kinds = 1 + next_random(mut seed) % 26;
        let skew = next_random(mut seed) % 2 == 0;
        let n = next_random(mut seed) % 13;
        let tasks = random_tasks(size, kinds, skew, mut seed);
        let answer = least_interval(tasks, n);
        sum += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"300 random lists: total {sum}, checksum {checksum}");
    // The problem's largest: 10,000 tasks, cooling 100, from all 26
    // letters skewed and from 3 letters evenly.
    let wide = random_tasks(10000, 26, true, mut seed);
    println(f"10000 tasks of 26 letters, skewed, n = 100 -> {least_interval(wide, 100)}");
    let narrow = random_tasks(10000, 3, false, mut seed);
    println(f"10000 tasks of 3 letters, n = 100 -> {least_interval(narrow, 100)}");
}
