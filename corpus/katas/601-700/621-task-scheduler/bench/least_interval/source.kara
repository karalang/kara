// LeetCode #621: Task Scheduler -- counting the frame.
//
// The letters that occur most often, say `most` times each, decide the
// shape: their runs need `most - 1` gaps of `n` slots between them, so
// the schedule is at least `(most - 1) * (n + 1)` slots plus one for
// each letter tied at `most`. Every other task fits into the gaps, and
// once the gaps are full no idle slot is needed at all, so the answer is
// that frame or the number of tasks, whichever is larger. O(tasks).

fn least_interval(tasks: Slice[char], n: i64) -> i64 {
    let mut counts = vec![0; 26];
    for t in tasks.iter() {
        counts[(*t as i64) - ('A' as i64)] += 1;
    }
    let mut most = 0;
    for c in counts.iter() {
        if *c > most {
            most = *c;
        }
    }
    let mut tied = 0;
    for c in counts.iter() {
        if *c == most {
            tied += 1;
        }
    }
    let frame = (most - 1) * (n + 1) + tied;
    frame.max(tasks.len())
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `size` random tasks from the first `kinds` letters, letter i drawn
// with weight i + 1 when `skew` is set, so a few letters dominate.
fn random_tasks(size: i64, kinds: i64, skew: bool, seed: mut ref i64) -> Vec[char] {
    let mut tasks: Vec[char] = Vec.new();
    let weight = if skew { kinds * (kinds + 1) / 2 } else { kinds };
    for _ in 0..size {
        let mut r = next_random(mut seed) % weight;
        let mut k = 0;
        if skew {
            while r > k {
                r -= k + 1;
                k += 1;
            }
        } else {
            k = r;
        }
        tasks.push(((65 + k) as u8) as char);
    }
    tasks
}

fn main() {
    // 100 lists of 10,000 tasks, the problem's most, from the first 1 to
    // 26 letters, evenly or skewed, made once; then 30,000 times answers
    // one of them, picked by the round, with a cooling of 0 to 100.
    let lists = 100;
    let rounds = 30000;
    let mut seed: i64 = 621;
    let mut all: Vec[Vec[char]] = Vec.new();
    for i in 0..lists {
        let kinds = 1 + next_random(mut seed) % 26;
        all.push(random_tasks(10000, kinds, i % 2 == 0, mut seed));
    }
    let mut sum = 0;
    let mut checksum = 0;
    for r in 0..rounds {
        let answer = least_interval(all[(r * 7) % lists], r % 101);
        sum += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"{lists} lists, {rounds} rounds: total {sum}, checksum {checksum}");
}
