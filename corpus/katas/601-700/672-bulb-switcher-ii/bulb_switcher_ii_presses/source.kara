// LeetCode #672: Bulb Switcher II -- every press, one at a time.
//
// The first 6 bulbs repeat for the rest, so a state is 6 bits, and
// there are at most 64. Start from all on and, m times over, press each
// button on every state so far, keeping the distinct results. The set
// stops changing between presses of the same parity after a few rounds,
// so stop once it repeats the set from two presses before. O(64 * 4)
// per press.

fn mask_of(button: i64, width: i64) -> i64 {
    let mut mask = 0;
    for i in 1..width + 1 {
        let on = if button == 0 {
            true
        } else if button == 1 {
            i % 2 == 0
        } else if button == 2 {
            i % 2 == 1
        } else {
            i % 3 == 1
        };
        if on {
            mask |= 1 << (i - 1);
        }
    }
    mask
}

fn flip_lights(n: i64, m: i64) -> i64 {
    let width = n.min(6);
    let mut masks: Vec[i64] = Vec.new();
    for b in 0..4 {
        masks.push(mask_of(b, width));
    }
    let mut now = vec![false; 64];
    now[(1 << width) - 1] = true;
    let mut before = now.clone();
    for step in 0..m {
        let mut next = vec![false; 64];
        for s in 0..64 {
            if now[s] {
                for mask in masks.iter() {
                    next[s ^ mask] = true;
                }
            }
        }
        if step >= 1 and next == before {
            // From here the sets alternate, so the answer is the set at
            // the parity of the presses left.
            if (m - step - 1) % 2 == 1 {
                next = now.clone();
            }
            now = next;
            break;
        }
        before = now;
        now = next;
    }
    let mut count = 0;
    for s in 0..64 {
        if now[s] {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // The three LeetCode examples.
    println(f"n=1 m=1: {flip_lights(1, 1)}");
    println(f"n=2 m=1: {flip_lights(2, 1)}");
    println(f"n=3 m=1: {flip_lights(3, 1)}");
    // A table for n from 1 to 8 and m from 0 to 6, a row for each n.
    for n in 1..9 {
        let mut parts: Vec[String] = Vec.new();
        for m in 0..7 {
            parts.push(f"{flip_lights(n, m)}");
        }
        println(f"n={n}: {parts.join(" ")}");
    }
    // The problem's largest, 1,000 bulbs and 1,000 presses, and its
    // corners.
    println(f"n=1000 m=1000: {flip_lights(1000, 1000)}");
    println(f"n=1000 m=0: {flip_lights(1000, 0)}");
    println(f"n=1 m=1000: {flip_lights(1, 1000)}");
    println(f"n=2 m=999: {flip_lights(2, 999)}");
    // 1,000 random cases, n up to 1,000 and m up to 1,000, into a
    // checksum.
    let mut seed: i64 = 672;
    let mut sum = 0;
    for _ in 0..1000 {
        let n = 1 + next_random(mut seed) % 1000;
        let m = next_random(mut seed) % 1001;
        sum = (sum * 31 + flip_lights(n, m)) % 1000000007;
    }
    println(f"1000 random cases: checksum {sum}");
}
