// LeetCode #642: Design Search Autocomplete System -- a trie searched
// below the prefix.
//
// Every sentence is a path in a trie of 27 branches, `a` to `z` and the
// space, and the node where a sentence ends keeps how many times it was
// typed. The system follows what has been typed down the trie, one
// character a call; each call then walks everything below that node,
// gathers each sentence with its count, sorts them hottest first and in
// ASCII order among equals, and keeps three. A `#` adds one to the typed
// sentence, inserting it if it is new, and starts again from the root.
// A call costs O(size of the subtree below the prefix).

struct Node {
    children: Vec[i64],
    count: i64,
}

struct AutocompleteSystem {
    nodes: Vec[Node],
    typed: String,
    // The node of what has been typed, or -1 once it leaves the trie.
    at: i64,
}

fn branch(c: char) -> i64 {
    if c == ' ' { 26 } else { c as i64 - 'a' as i64 }
}

fn letter(b: i64) -> char {
    if b == 26 { ' ' } else { ('a' as i64 + b) as u8 as char }
}

fn new_node() -> Node {
    Node { children: vec![-1; 27], count: 0 }
}

// Every sentence at or below `node`, whose path from the root spells
// `path`, with its count.
fn gather(nodes: Vec[Node], node: i64, path: String, found: mut ref Vec[(i64, String)]) {
    if nodes[node].count > 0 {
        found.push((nodes[node].count, path.clone()));
    }
    for b in 0..27 {
        let child = nodes[node].children[b];
        if child != -1 {
            gather(nodes, child, f"{path}{letter(b)}", mut found);
        }
    }
}

impl AutocompleteSystem {
    fn new(sentences: Vec[String], times: Vec[i64]) -> AutocompleteSystem {
        let mut system = AutocompleteSystem { nodes: vec![new_node()], typed: String.new(), at: 0 };
        for i in 0..sentences.len() {
            system.add(sentences[i], times[i]);
        }
        system
    }

    fn add(mut ref self, sentence: String, times: i64) {
        let mut node = 0;
        for c in sentence.chars() {
            let b = branch(c);
            if self.nodes[node].children[b] == -1 {
                self.nodes.push(new_node());
                self.nodes[node].children[b] = self.nodes.len() - 1;
            }
            node = self.nodes[node].children[b];
        }
        self.nodes[node].count += times;
    }

    fn input(mut ref self, c: char) -> Vec[String] {
        if c == '#' {
            let sentence = self.typed.clone();
            self.add(sentence, 1);
            self.typed = String.new();
            self.at = 0;
            return Vec.new();
        }
        self.typed.push(c);
        if self.at != -1 {
            self.at = self.nodes[self.at].children[branch(c)];
        }
        let mut top: Vec[String] = Vec.new();
        if self.at == -1 {
            return top;
        }
        let mut found: Vec[(i64, String)] = Vec.new();
        gather(self.nodes, self.at, self.typed, mut found);
        found.sort_by(|a, b| if a.0 != b.0 { b.0.cmp(a.0) } else { a.1.cmp(b.1) });
        for i in 0..found.len() {
            if i == 3 {
                break;
            }
            top.push(found[i].1.clone());
        }
        top
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A system made from `sentences` and `times`, with `typing` typed into
// it one character a call; the results as LeetCode prints them, `null`
// first for the constructor.
fn run_all(sentences: Vec[String], times: Vec[i64], typing: String) -> String {
    let mut system = AutocompleteSystem.new(sentences, times);
    let mut out = "[null".to_string();
    for c in typing.chars() {
        let got = system.input(c);
        out.push_str(",[");
        for i in 0..got.len() {
            if i > 0 {
                out.push_str(",");
            }
            out.push_str("\"");
            out.push_str(got[i]);
            out.push_str("\"");
        }
        out.push_str("]");
    }
    out.push_str("]");
    out
}

fn show(sentences: Vec[String], times: Vec[i64], typing: String) {
    println(run_all(sentences, times, typing));
}

fn words(text: String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for part in text.split(",") {
        out.push(part.to_string());
    }
    out
}

// A sentence of 1 to `most` characters, each one of the first `letters`
// of `alphabet`.
fn random_sentence(most: i64, alphabet: String, seed: mut ref i64) -> String {
    let length = 1 + next_random(mut seed) % most;
    let mut s = String.new();
    for _ in 0..length {
        let i = next_random(mut seed) % alphabet.len();
        s.push_str(alphabet[i..i + 1]);
    }
    s
}

// `n` different sentences with times of 1 to `hottest`, and `calls`
// characters typed: sentences ended by `#`, each half the time one of
// those and otherwise a new one, the last perhaps cut short.
fn random_case(n: i64, most: i64, alphabet: String, hottest: i64, calls: i64, seed: mut ref i64) -> (Vec[String], Vec[i64], String) {
    let mut sentences: Vec[String] = Vec.new();
    let mut times: Vec[i64] = Vec.new();
    while sentences.len() < n {
        let s = random_sentence(most, alphabet, mut seed);
        if not sentences.contains(s) {
            sentences.push(s);
            times.push(1 + next_random(mut seed) % hottest);
        }
    }
    let mut typing = String.new();
    while typing.len() < calls {
        if n > 0 and next_random(mut seed) % 2 == 0 {
            typing.push_str(sentences[next_random(mut seed) % n]);
        } else {
            typing.push_str(random_sentence(most, alphabet, mut seed));
        }
        typing.push_str("#");
    }
    (sentences, times, typing[0..calls].to_string())
}

fn summary(s: String) -> String {
    let mut h: i64 = 0;
    for c in s.chars() {
        h = (h * 31 + c as i64) % 1000000007;
    }
    f"{s.len()} characters, checksum {h}"
}

fn main() {
    // The LeetCode example.
    show(words("i love you,island,iroman,i love leetcode"), vec![5, 3, 2, 2], "i a#");
    // Equal counts in ASCII order, a space before a letter; a typed
    // sentence overtaking the others; no history at all; a prefix that
    // leaves the trie and is then typed again; more than three matches,
    // the fourth hottest dropped; a sentence that is a prefix of another.
    show(words("ab,a b,a,abc"), vec![1, 1, 1, 1], "a#");
    show(words("hello,help"), vec![2, 2], "hel#hel#hel#he");
    show(Vec.new(), Vec.new(), "ab#a#ab#a");
    show(words("cat,car"), vec![1, 1], "cx#cx#c");
    show(words("go,gone,goal,good,got"), vec![4, 3, 5, 1, 3], "go#go");
    show(words("a,aa,aaa"), vec![3, 2, 1], "aa#aaa#aaa#a");
    // 300 random systems of 0 to 7 sentences of up to 6 letters from
    // `ab `, with 1 to 40 characters typed.
    let mut seed: i64 = 642;
    let mut total = String.new();
    for _ in 0..300 {
        let n = next_random(mut seed) % 8;
        let calls = 1 + next_random(mut seed) % 40;
        let (sentences, times, typing) = random_case(n, 6, "ab ", 5, calls, mut seed);
        total.push_str(run_all(sentences, times, typing));
    }
    println(f"300 random systems: {summary(total)}");
    // The problem's largest: 100 sentences of up to 100 characters from
    // `abc `, typed up to 100 times each, and 5,000 calls.
    let (sentences, times, typing) = random_case(100, 100, "abc ", 100, 5000, mut seed);
    println(f"100 sentences, 5000 calls: {summary(run_all(sentences, times, typing))}");
}
