// LeetCode #664: Strange Printer -- top down, by the first letter.
//
// The fewest turns for `s[i..=j]`: print its first letter alone and the
// rest after it, one turn more than `s[i + 1..=j]`; or stretch that first
// turn to a later copy of the letter at `k`, print `s[i + 1..k]` over it,
// and let `s[k..=j]` reuse the turn, which it counts as its own. A table
// remembers each interval once worked out. O(n^3) time, O(n^2) space.

fn strange_printer(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut memo = vec![vec![-1; n]; n];
    turns(b, 0, n - 1, mut memo)
}

fn turns(b: Slice[u8], i: i64, j: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if i > j {
        return 0;
    }
    if memo[i][j] >= 0 {
        return memo[i][j];
    }
    let mut best = 1 + turns(b, i + 1, j, memo);
    for k in i + 1..j + 1 {
        if b[k] == b[i] {
            best = best.min(turns(b, i + 1, k - 1, memo) + turns(b, k, j, memo));
        }
    }
    memo[i][j] = best;
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters drawn from the first `letters` of the alphabet.
fn random_text(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn show(s: String) {
    if s.len() <= 30 {
        println(f"\"{s}\": {strange_printer(s)}");
    } else {
        println(f"\"{s.substring(0, 12)}...\" ({s.len()} letters): {strange_printer(s)}");
    }
}

fn main() {
    // The two LeetCode examples.
    show("aaabbb".to_string());
    show("aba".to_string());
    // One letter; a palindrome; two letters taking turns; a word repeated.
    show("z".to_string());
    show("abcba".to_string());
    show("abab".to_string());
    show("tbgtgb".to_string());
    show("abcabc".to_string());
    // The problem's longest, 100 letters: one letter; `ab` 50 times; the
    // alphabet nearly four times; and the alphabet up and down twice.
    let mut same = String.new();
    let mut pairs = String.new();
    let mut alphabet = String.new();
    let mut mountain = String.new();
    for i in 0..100 {
        same.push('q');
        pairs.push(if i % 2 == 0 { 'a' } else { 'b' });
        alphabet.push(((97 + i % 26) as u8) as char);
        let up = i % 50;
        let at = if up < 25 { up } else { 49 - up };
        mountain.push(((97 + at) as u8) as char);
    }
    show(same);
    show(pairs);
    show(alphabet);
    show(mountain);
    // 300 random texts of 1 to 20 letters from 2 to 5 letters: a
    // checksum of the turns.
    let mut seed: i64 = 664;
    let mut sum = 0;
    let mut most = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 20;
        let letters = 2 + next_random(mut seed) % 4;
        let t = strange_printer(random_text(n, letters, mut seed));
        most = most.max(t);
        sum = (sum * 31 + t) % 1000000007;
    }
    println(f"300 random texts: most {most} turns, checksum {sum}");
    // Random texts of 100 letters from 3 and from 26.
    show(random_text(100, 3, mut seed));
    show(random_text(100, 26, mut seed));
}
