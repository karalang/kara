// Benchmark for #611: the ★ arm (sort, then two pointers); see
// triangle_number.kara.

fn triangle_number(nums: Vec[i64]) -> i64 {
    let mut a = nums.clone();
    a.sort();
    let mut count = 0;
    for k in 2..a.len() {
        let mut i = 0;
        let mut j = k - 1;
        while i < j {
            if a[i] + a[j] > a[k] {
                count += j - i;
                j -= 1;
            } else {
                i += 1;
            }
        }
    }
    count
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 arrays of 1,000 lengths, the problem's most, each from 0 to a
    // bound of 100 to 1,000, made once; then 600 times counts the
    // triangles in one of them, picked by the round.
    let arrays = 20;
    let rounds = 600;
    let mut seed: i64 = 611;
    let mut all: Vec[Vec[i64]] = Vec.new();
    for _ in 0..arrays {
        let bound = 100 + step(mut seed) % 901;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            nums.push(step(mut seed) % (bound + 1));
        }
        all.push(nums);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let got = triangle_number(all[(r * 7) % arrays]);
        total += got;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"{arrays} arrays, {rounds} rounds: {total} triangles, checksum {checksum}");
}
