// Benchmark for #675: a breadth-first search for each walk, the ★ arm.
//
// The trees must be cut from the shortest up, so the route is fixed:
// from (0, 0) to the shortest tree, from there to the next, and so on.
// Trees stay walkable, so cutting one changes nothing about later walks.
// Each walk is a breadth-first search over the open cells, a layer of
// the queue at a time; one unreachable tree makes the answer -1.
// O(trees * rows * cols).

fn steps(forest: Vec[Vec[i64]], sr: i64, sc: i64, tr: i64, tc: i64) -> i64 {
    if sr == tr and sc == tc {
        return 0;
    }
    let rows = forest.len();
    let cols = forest[0].len();
    let mut seen = vec![false; rows * cols];
    let mut queue: Vec[i64] = Vec.new();
    queue.push(sr * cols + sc);
    seen[sr * cols + sc] = true;
    let moves = [(-1, 0), (1, 0), (0, -1), (0, 1)];
    let mut head = 0;
    let mut dist = 0;
    while head < queue.len() {
        let end = queue.len();
        dist += 1;
        while head < end {
            let cell = queue[head];
            head += 1;
            let r = cell / cols;
            let c = cell % cols;
            for (dr, dc) in moves.iter() {
                let nr = r + dr;
                let nc = c + dc;
                if nr >= 0 and nr < rows and nc >= 0 and nc < cols and forest[nr][nc] != 0 and not seen[nr * cols + nc] {
                    if nr == tr and nc == tc {
                        return dist;
                    }
                    seen[nr * cols + nc] = true;
                    queue.push(nr * cols + nc);
                }
            }
        }
    }
    -1
}

fn cut_off_tree(forest: Vec[Vec[i64]]) -> i64 {
    let mut trees: Vec[(i64, i64, i64)] = Vec.new();
    for r in 0..forest.len() {
        for c in 0..forest[0].len() {
            if forest[r][c] > 1 {
                trees.push((forest[r][c], r, c));
            }
        }
    }
    trees.sort_by(|a, b| a.0.cmp(b.0));
    let mut total = 0;
    let mut r = 0;
    let mut c = 0;
    for (_, tr, tc) in trees.iter() {
        let d = steps(forest, r, c, tr, tc);
        if d < 0 {
            return -1;
        }
        total += d;
        r = tr;
        c = tc;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A `rows` by `cols` forest: each cell other than (0, 0) a wall with a
// chance of `walls` in 100, else open, and an open cell a tree with a
// chance of `trees` in 100. The trees' heights are distinct, in a
// shuffled order.
fn random_forest(seed: mut ref i64, rows: i64, cols: i64, walls: i64, trees: i64) -> Vec[Vec[i64]] {
    let mut forest: Vec[Vec[i64]] = Vec.new();
    let mut spots: Vec[i64] = Vec.new();
    for r in 0..rows {
        let mut row: Vec[i64] = Vec.new();
        for c in 0..cols {
            let k = next_random(seed) % 100;
            if (r > 0 or c > 0) and k < walls {
                row.push(0);
            } else {
                row.push(1);
                if k < walls + trees {
                    spots.push(r * cols + c);
                }
            }
        }
        forest.push(row);
    }
    let mut i = spots.len();
    while i > 1 {
        let j = next_random(seed) % i;
        i -= 1;
        spots.swap(i, j);
    }
    for k in 0..spots.len() {
        forest[spots[k] / cols][spots[k] % cols] = 2 + k * 7;
    }
    forest
}

fn main() {
    // 40 random 50 by 50 forests, the problem's largest, from the same
    // generator as the other languages: walls on 10 in 100 cells, trees
    // on 30. Each answer goes into a checksum.
    let forests = 40;
    let mut seed: i64 = 675;
    let mut sum = 0;
    let mut reached = 0;
    for _ in 0..forests {
        let forest = random_forest(mut seed, 50, 50, 10, 30);
        let got = cut_off_tree(forest);
        if got >= 0 {
            reached += 1;
        }
        sum = (sum * 31 + got + 1) % 1000000007;
    }
    println(f"{forests} forests of 50x50, {reached} reachable: checksum {sum}");
}
