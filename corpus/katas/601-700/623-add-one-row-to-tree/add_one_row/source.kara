// LeetCode #623: Add One Row to Tree -- recursion with the level.
//
// Walk down from the root keeping the level, and at every node one level
// above `depth` hang two new nodes of value `val`: a left one that takes
// over the old left subtree as its left, and a right one that takes over
// the old right subtree as its right. A row at depth 1 is a new root with
// the whole tree as its left subtree. Changes the tree in place;
// O(nodes above the new row).

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn add_one_row(root: Option[TreeNode], val: i64, depth: i64) -> Option[TreeNode] {
    if depth == 1 {
        return Some(TreeNode { val: val, left: root, right: None });
    }
    insert(root, val, depth, 1);
    root
}

fn insert(node: Option[TreeNode], val: i64, depth: i64, level: i64) {
    if let Some(n) = node {
        if level == depth - 1 {
            n.left = Some(TreeNode { val: val, left: n.left, right: None });
            n.right = Some(TreeNode { val: val, left: None, right: n.right });
        } else {
            insert(n.left, val, depth, level + 1);
            insert(n.right, val, depth, level + 1);
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A tree from LeetCode's level order: `None` for a missing child.
fn from_level(values: Vec[Option[i64]]) -> Option[TreeNode] {
    if values.is_empty() or values[0].is_none() {
        return None;
    }
    let root = leaf(values[0].unwrap());
    let mut queue: Vec[TreeNode] = vec![root];
    let mut head = 0;
    let mut i = 1;
    while i < values.len() {
        let n = queue[head];
        head += 1;
        if let Some(v) = values[i] {
            let c = leaf(v);
            n.left = Some(c);
            queue.push(c);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let c = leaf(v);
                n.right = Some(c);
                queue.push(c);
            }
            i += 1;
        }
    }
    Some(root)
}

// LeetCode's level order of a tree, without the trailing `null`s.
fn to_level(root: Option[TreeNode]) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut queue: Vec[Option[TreeNode]] = vec![root];
    let mut head = 0;
    while head < queue.len() {
        let node = queue[head];
        head += 1;
        match node {
            Some(n) => {
                parts.push(f"{n.val}");
                queue.push(n.left);
                queue.push(n.right);
            }
            None => parts.push("null".to_string()),
        }
    }
    while parts.len() > 0 and parts[parts.len() - 1] == "null" {
        parts.pop();
    }
    f"[{parts.join(",")}]"
}

// A tree of `size` nodes with values from -100 to 100: each new
// node walks down from the root, going left with chance lean / 100, and
// takes the first empty place it meets.
fn random_tree(size: i64, lean: i64, seed: mut ref i64) -> Option[TreeNode] {
    if size == 0 {
        return None;
    }
    let root = leaf(next_random(mut seed) % 201 - 100);
    for _ in 1..size {
        let c = leaf(next_random(mut seed) % 201 - 100);
        let mut node = root;
        loop {
            if next_random(mut seed) % 100 < lean {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(c);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(c);
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

// The number of levels.
fn height(node: Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => 1 + height(n.left).max(height(n.right)),
    }
}

fn show(values: Vec[Option[i64]], val: i64, depth: i64) {
    let before = to_level(from_level(values));
    println(f"{before}, val = {val}, depth = {depth} -> {to_level(add_one_row(from_level(values), val, depth))}");
}

// A string's length and a checksum over its characters.
fn summary(s: String) -> String {
    let mut h: i64 = 0;
    for c in s.chars() {
        h = (h * 31 + c as i64) % 1000000007;
    }
    f"{s.len()} characters, checksum {h}"
}

fn main() {
    // The LeetCode examples.
    show(vec![Some(4), Some(2), Some(6), Some(3), Some(1), Some(5)], 1, 2);
    show(vec![Some(4), Some(2), None, Some(3), Some(1)], 1, 3);
    // A single node at depth 1 and 2; a new root over a tree; a row
    // under the deepest level; a row in the middle of a chain down the
    // right; a row where some nodes above it have one child or none.
    show(vec![Some(7)], 5, 1);
    show(vec![Some(7)], 5, 2);
    show(vec![Some(1), Some(2), Some(3)], -9, 1);
    show(vec![Some(1), Some(2), Some(3), Some(4), None, None, Some(5)], 0, 4);
    show(vec![Some(1), None, Some(2), None, Some(3), None, Some(4)], 8, 3);
    show(vec![Some(1), Some(2), Some(3), None, Some(4), Some(5)], 100000, 3);
    // 300 random trees of 1 to 40 nodes, leaning left with chance 20, 50
    // or 80 in 100, each with a row of a random value at a random depth
    // from 1 to one below its deepest level.
    let mut seed: i64 = 623;
    let mut total = String.new();
    for _ in 0..300 {
        let leans = vec![20, 50, 80];
        let size = 1 + next_random(mut seed) % 40;
        let lean = leans[next_random(mut seed) % 3];
        let tree = random_tree(size, lean, mut seed);
        let depth = 1 + next_random(mut seed) % (height(tree) + 1);
        let val = next_random(mut seed) % 200001 - 100000;
        total.push_str(to_level(add_one_row(tree, val, depth)));
    }
    println(f"300 random trees: {summary(total)}");
    // The problem's largest: a tree of 10,000 nodes, with a row at depth
    // 3 and a row one below its deepest level.
    let big = random_tree(10000, 50, mut seed);
    println(f"10000 nodes, depth 3: {summary(to_level(add_one_row(big, 1, 3)))}");
    let again = random_tree(10000, 50, mut seed);
    let below = height(again) + 1;
    println(f"10000 nodes, depth {below}: {summary(to_level(add_one_row(again, -1, below)))}");
}
