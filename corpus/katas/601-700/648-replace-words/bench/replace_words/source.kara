// Benchmark for #648: the ★ arm (a trie of the roots) on a large
// workload.

fn replace_words(dictionary: Vec[String], sentence: String) -> String {
    let mut next: Vec[Vec[i64]] = Vec.new();
    let mut ends: Vec[bool] = Vec.new();
    next.push(vec![0; 26]);
    ends.push(false);
    for root in dictionary.iter() {
        let mut node = 0;
        for b in root.bytes().iter() {
            let c = (*b - b'a') as i64;
            if next[node][c] == 0 {
                next[node][c] = next.len();
                next.push(vec![0; 26]);
                ends.push(false);
            }
            node = next[node][c];
        }
        ends[node] = true;
    }
    let mut out: Vec[String] = Vec.new();
    for word in sentence.split(" ").iter() {
        let bytes = word.bytes();
        let mut node = 0;
        let mut length = 0;
        while length < bytes.len() and not ends[node] {
            node = next[node][(bytes[length] - b'a') as i64];
            if node == 0 {
                break;
            }
            length += 1;
        }
        if node != 0 and ends[node] {
            out.push(word.slice(0, length).to_string());
        } else {
            out.push(word.clone());
        }
    }
    out.join(" ")
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `shortest` to `longest` letters, each one of the first `letters` of
// the alphabet.
fn random_word(shortest: i64, longest: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    let n = shortest + next_random(mut seed) % (longest - shortest + 1);
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn main() {
    // 20 inputs made once, each 1,000 roots of 3 to 6 letters and a
    // sentence of 20,000 words of 1 to 10 letters, all from the first 3
    // to 8 letters of the alphabet, the count picked for each input; then
    // 100 times answers one of them, picked by the round, counting the
    // characters of the answers and putting each into a checksum.
    let inputs = 20;
    let rounds = 100;
    let mut seed: i64 = 648;
    let mut dictionaries: Vec[Vec[String]] = Vec.new();
    let mut sentences: Vec[String] = Vec.new();
    for _ in 0..inputs {
        let letters = 3 + next_random(mut seed) % 6;
        let mut roots: Vec[String] = Vec.new();
        for _ in 0..1000 {
            roots.push(random_word(3, 6, letters, mut seed));
        }
        let mut words: Vec[String] = Vec.new();
        for _ in 0..20000 {
            words.push(random_word(1, 10, letters, mut seed));
        }
        dictionaries.push(roots);
        sentences.push(words.join(" "));
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let i = (r * 7) % inputs;
        let out = replace_words(dictionaries[i], sentences[i]);
        for b in out.bytes().iter() {
            total += 1;
            checksum = (checksum * 31 + *b as i64) % 1000000007;
        }
    }
    println(f"{inputs} inputs, {rounds} rounds: {total} characters, checksum {checksum}");
}
