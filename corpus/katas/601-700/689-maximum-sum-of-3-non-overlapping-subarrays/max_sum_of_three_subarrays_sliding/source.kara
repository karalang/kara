// LeetCode #689: Maximum Sum of 3 Non-Overlapping Subarrays -- three
// windows sliding together.
//
// Slide three adjacent windows of k across the array at once. Keep the
// best first window seen so far, the best first-and-second pair with
// the second where the middle window is now, and the best triple with
// the third where the last window is now; each improves only on a
// strictly larger sum, so ties keep the earlier, smaller answer. One
// pass, O(n) time, O(1) space.

fn max_sum_of_three_subarrays(nums: Vec[i64], k: i64) -> Vec[i64] {
    let n = nums.len();
    let mut sum1 = 0;
    let mut sum2 = 0;
    let mut sum3 = 0;
    let mut best1 = 0;
    let mut best12 = 0;
    let mut best123 = 0;
    let mut at1 = 0;
    let mut at12 = (0, k);
    let mut at123 = (0, k, 2 * k);
    for i in 2 * k..n {
        sum1 += nums[i - 2 * k];
        sum2 += nums[i - k];
        sum3 += nums[i];
        if i >= 3 * k - 1 {
            if sum1 > best1 {
                best1 = sum1;
                at1 = i - 3 * k + 1;
            }
            if best1 + sum2 > best12 {
                best12 = best1 + sum2;
                at12 = (at1, i - 2 * k + 1);
            }
            if best12 + sum3 > best123 {
                best123 = best12 + sum3;
                at123 = (at12.0, at12.1, i - k + 1);
            }
            sum1 -= nums[i - 3 * k + 1];
            sum2 -= nums[i - 2 * k + 1];
            sum3 -= nums[i - k + 1];
        }
    }
    vec![at123.0, at123.1, at123.2]
}

// ---- harness ---------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], k: i64) {
    let mut text = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            text.push_str(",");
        }
        text.push_str(f"{nums[i]}");
    }
    println(f"[{text}], k = {k} -> {max_sum_of_three_subarrays(nums, k)}");
}

fn main() {
    // The two LeetCode examples.
    show(vec![1, 2, 1, 2, 6, 7, 5, 1], 2);
    show(vec![1, 2, 1, 2, 1, 2, 1, 2, 1], 2);
    // Exactly three windows, one value throughout, singles, a tie between
    // two answers where the smaller one must win, a tie between taking the
    // best window and leaving it out, and the largest values.
    show(vec![4, 9, 1], 1);
    show(vec![3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3], 3);
    show(vec![1, 3, 2, 4, 1, 5], 1);
    show(vec![5, 1, 5, 1, 5, 1, 5], 1);
    show(vec![1, 5, 5, 1, 1, 1, 1], 2);
    show(vec![65535, 65535, 65535, 65535, 65535, 65535], 2);

    // Every array of 3 to 8 values from 1 to 3, every k that fits.
    let mut queries = 0;
    let mut checksum = 0;
    for n in 3..9 {
        let mut all = 1;
        for _ in 0..n {
            all *= 3;
        }
        for code in 0..all {
            let mut nums: Vec[i64] = Vec.new();
            let mut c = code;
            for _ in 0..n {
                nums.push(1 + c % 3);
                c = c / 3;
            }
            for k in 1..n / 3 + 1 {
                let got = max_sum_of_three_subarrays(nums, k);
                queries += 1;
                checksum = (checksum * 31 + got[0] * 64 + got[1] * 8 + got[2]) % 1000000007;
            }
        }
    }
    println(f"{queries} small queries: checksum {checksum}");

    // 300 random arrays of up to 300 values from 1 to 65535.
    let mut seed = 689;
    checksum = 0;
    for _ in 0..300 {
        let n = 3 + next_random(mut seed) % 298;
        let k = 1 + next_random(mut seed) % (n / 3);
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % 65535);
        }
        let got = max_sum_of_three_subarrays(nums, k);
        checksum = (checksum * 31 + got[0] * 90000 + got[1] * 300 + got[2]) % 1000000007;
    }
    println(f"300 random arrays: checksum {checksum}");

    // 2,000 random values, from k = 1 to the largest k that fits; then
    // 2,000 equal values.
    let mut big: Vec[i64] = Vec.new();
    for _ in 0..2000 {
        big.push(1 + next_random(mut seed) % 65535);
    }
    let mut line = String.new();
    for k in [1, 10, 100, 500, 666] {
        if k != 1 {
            line.push_str(";");
        }
        line.push_str(f" k = {k}: {max_sum_of_three_subarrays(big, k)}");
    }
    println(f"2000 random values:{line}");
    let ones: Vec[i64] = vec![1; 2000];
    println(f"2000 ones, k = 7: {max_sum_of_three_subarrays(ones, 7)}");
}
