// LeetCode #624: Maximum Distance in Arrays -- one pass.
//
// The largest distance takes the largest value of one array and the
// smallest of another, and in a sorted array those are its last and
// first values. Walk the arrays keeping the smallest first value and the
// largest last value among the arrays before this one; this array's
// last value against that smallest, and that largest against this
// array's first value, are the best pairs with this array in them that
// use two arrays. O(arrays).

fn max_distance(arrays: Vec[Vec[i64]]) -> i64 {
    let mut low = arrays[0][0];
    let mut high = arrays[0][arrays[0].len() - 1];
    let mut best = 0;
    for i in 1..arrays.len() {
        let first = arrays[i][0];
        let last = arrays[i][arrays[i].len() - 1];
        best = best.max(last - low).max(high - first);
        low = low.min(first);
        high = high.max(last);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(arrays: Vec[Vec[i64]]) {
    println(f"{arrays} -> {max_distance(arrays)}");
}

// `count` arrays of 1 to `longest` sorted values from `-spread` to
// `spread`.
fn random_arrays(count: i64, longest: i64, spread: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..1 + next_random(mut seed) % longest {
            values.push(next_random(mut seed) % (2 * spread + 1) - spread);
        }
        values.sort();
        arrays.push(values);
    }
    arrays
}

fn main() {
    // The LeetCode examples.
    show(vec![vec![1, 2, 3], vec![4, 5], vec![1, 2, 3]]);
    show(vec![vec![1], vec![1]]);
    // Two arrays the other way round; the smallest and the largest value
    // in one array, with the runner-up on either side deciding; negative
    // values only; single values; every array the same.
    show(vec![vec![4, 5], vec![1, 2, 3]]);
    show(vec![vec![-10, 10], vec![-5, 0], vec![2, 3]]);
    show(vec![vec![-10, 10], vec![-1, 0], vec![-8, 3]]);
    show(vec![vec![-9, -7], vec![-3, -2, -1], vec![-6]]);
    show(vec![vec![3], vec![-2], vec![7], vec![0]]);
    show(vec![vec![1, 2], vec![1, 2], vec![1, 2]]);
    // 300 random cases of 2 to 20 arrays of 1 to 10 values from -10,000
    // to 10,000.
    let mut seed: i64 = 624;
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..300 {
        let arrays = random_arrays(2 + next_random(mut seed) % 19, 10, 10000, mut seed);
        let d = max_distance(arrays);
        total += d;
        checksum = (checksum * 31 + d) % 1000000007;
    }
    println(f"300 random cases: total {total}, checksum {checksum}");
    // 1,000 arrays of up to 100 values, and 2,000 arrays of up to 50
    // where one array holds both the smallest and the largest value.
    let wide = random_arrays(1000, 100, 10000, mut seed);
    println(f"1000 arrays of up to 100: {max_distance(wide)}");
    let mut shared = random_arrays(2000, 50, 9000, mut seed);
    shared[1234] = vec![-10000, 0, 10000];
    println(f"2000 arrays of up to 50, both ends in one: {max_distance(shared)}");
}
