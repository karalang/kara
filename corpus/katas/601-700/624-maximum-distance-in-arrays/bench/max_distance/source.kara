// LeetCode #624: Maximum Distance in Arrays -- one pass.
//
// The largest distance takes the largest value of one array and the
// smallest of another, and in a sorted array those are its last and
// first values. Walk the arrays keeping the smallest first value and the
// largest last value among the arrays before this one; this array's
// last value against that smallest, and that largest against this
// array's first value, are the best pairs with this array in them that
// use two arrays. O(arrays).

fn max_distance(arrays: Vec[Vec[i64]]) -> i64 {
    let mut low = arrays[0][0];
    let mut high = arrays[0][arrays[0].len() - 1];
    let mut best = 0;
    for i in 1..arrays.len() {
        let first = arrays[i][0];
        let last = arrays[i][arrays[i].len() - 1];
        best = best.max(last - low).max(high - first);
        low = low.min(first);
        high = high.max(last);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of 1 to 9 sorted values from `-spread` to `spread`.
fn random_arrays(count: i64, spread: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..1 + next_random(mut seed) % 9 {
            values.push(next_random(mut seed) % (2 * spread + 1) - spread);
        }
        values.sort();
        arrays.push(values);
    }
    arrays
}

fn main() {
    // 20 inputs of 20,000 arrays, about 100,000 values each, the
    // problem's most, each with values within a random bound from
    // 1,000 to 10,000, made once; then 2,000 times answers one of them,
    // picked by the round, putting each answer into a checksum.
    let inputs = 20;
    let rounds = 2000;
    let mut seed: i64 = 624;
    let mut all: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..inputs {
        let spread = 1000 + next_random(mut seed) % 9001;
        all.push(random_arrays(20000, spread, mut seed));
    }
    let mut sum = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let d = max_distance(all[(r * 7) % inputs]);
        sum += d;
        checksum = (checksum * 31 + d) % 1000000007;
    }
    println(f"{inputs} inputs, {rounds} rounds: total {sum}, checksum {checksum}");
}
