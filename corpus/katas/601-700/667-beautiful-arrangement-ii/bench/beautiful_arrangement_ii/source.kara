// Benchmark for #667: the ★ arm (zigzag from both ends) on a large
// workload.

fn construct_array(n: i64, k: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut lo = 1;
    let mut hi = k + 1;
    while lo <= hi {
        out.push(lo);
        lo += 1;
        if lo <= hi {
            out.push(hi);
            hi -= 1;
        }
    }
    for x in k + 2..n + 1 {
        out.push(x);
    }
    out
}

fn main() {
    // Each round builds the arrangement for the problem's largest n,
    // 10,000, with k stepping through 1 to 9,999 by the round, and puts
    // every number of it into a checksum.
    let n = 10000;
    let rounds = 10000;
    let mut sum = 0;
    for r in 0..rounds {
        let k = 1 + r * 7919 % (n - 1);
        let a = construct_array(n, k);
        for x in a.iter() {
            sum = (sum * 31 + x) % 1000000007;
        }
    }
    println(f"n = {n}, {rounds} rounds: checksum {sum}");
}
