// LeetCode #662: Maximum Width of Binary Tree -- depth first.
//
// A walk down the left side first meets each depth's leftmost node before
// any other at that depth, so it keeps that node's place, one per depth,
// and measures every later node at the depth against it. A node's children
// are numbered from its own place counted from the leftmost at its depth,
// so the places stay as small as the widths. O(nodes) time, O(height)
// space.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn width_of_binary_tree(root: Option[TreeNode]) -> i64 {
    let mut firsts: Vec[i64] = Vec.new();
    walk(root, 0, 0, mut firsts)
}

fn walk(node: Option[TreeNode], depth: i64, place: i64, firsts: mut ref Vec[i64]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            if depth == firsts.len() {
                firsts.push(place);
            }
            let offset = place - firsts[depth];
            let left = walk(n.left, depth + 1, offset * 2, mut firsts);
            let right = walk(n.right, depth + 1, offset * 2 + 1, mut firsts);
            (offset + 1).max(left).max(right)
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A tree from LeetCode's level order: `None` for a missing child.
fn from_level(values: Vec[Option[i64]]) -> Option[TreeNode] {
    if values.is_empty() or values[0].is_none() {
        return None;
    }
    let root = leaf(values[0].unwrap());
    let mut queue: Vec[TreeNode] = vec![root];
    let mut head = 0;
    let mut i = 1;
    while i < values.len() {
        let n = queue[head];
        head += 1;
        if let Some(v) = values[i] {
            let c = leaf(v);
            n.left = Some(c);
            queue.push(c);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let c = leaf(v);
                n.right = Some(c);
                queue.push(c);
            }
            i += 1;
        }
    }
    Some(root)
}

// A chain of `count` nodes below `top`, each the left child of the one
// above when its step is 0 and the right child when it is 1; returns the
// bottom node.
fn chain(top: TreeNode, count: i64, steps: Vec[i64]) -> TreeNode {
    let mut bottom = top;
    for i in 0..count {
        let c = leaf(i % 201 - 100);
        if steps[i % steps.len()] == 0 {
            bottom.left = Some(c);
        } else {
            bottom.right = Some(c);
        }
        bottom = c;
    }
    bottom
}

// A full tree `levels` deep.
fn full(levels: i64) -> Option[TreeNode] {
    if levels == 0 {
        return None;
    }
    let n = leaf(levels);
    n.left = full(levels - 1);
    n.right = full(levels - 1);
    Some(n)
}

// A random tree at most `levels` deep: each child is there with chance
// `chance` in 100; values from -100 to 100.
fn random_tree(levels: i64, chance: i64, seed: mut ref i64) -> Option[TreeNode] {
    if levels == 0 {
        return None;
    }
    let n = leaf(next_random(mut seed) % 201 - 100);
    if next_random(mut seed) % 100 < chance {
        n.left = random_tree(levels - 1, chance, mut seed);
    }
    if next_random(mut seed) % 100 < chance {
        n.right = random_tree(levels - 1, chance, mut seed);
    }
    Some(n)
}

// `count` nodes, each hung where a random walk down from the root first
// finds no child, no deeper than `levels` levels; a walk that would go
// deeper starts again.
fn grown_tree(count: i64, levels: i64, seed: mut ref i64) -> Option[TreeNode] {
    let root = leaf(next_random(mut seed) % 201 - 100);
    let mut made = 1;
    while made < count {
        let mut at = root;
        let mut depth = 1;
        let mut placed = false;
        while not placed and depth < levels {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(l) => at = l,
                    None => {
                        at.left = Some(leaf(next_random(mut seed) % 201 - 100));
                        placed = true;
                    }
                }
            } else {
                match at.right {
                    Some(r) => at = r,
                    None => {
                        at.right = Some(leaf(next_random(mut seed) % 201 - 100));
                        placed = true;
                    }
                }
            }
            depth += 1;
        }
        if placed {
            made += 1;
        }
    }
    Some(root)
}

fn show(label: String, root: Option[TreeNode]) {
    println(f"{label}: {width_of_binary_tree(root)}");
}

fn main() {
    // The three LeetCode examples.
    show("[1,3,2,5,3,null,9]".to_string(), from_level(vec![Some(1), Some(3), Some(2), Some(5), Some(3), None, Some(9)]));
    show("[1,3,2,5,null,null,9,6,null,7]".to_string(), from_level(vec![Some(1), Some(3), Some(2), Some(5), None, None, Some(9), Some(6), None, Some(7)]));
    show("[1,3,2,5]".to_string(), from_level(vec![Some(1), Some(3), Some(2), Some(5)]));
    // One node; a full tree of four levels.
    show("one node".to_string(), from_level(vec![Some(0)]));
    show("full, 4 levels".to_string(), full(4));
    // Two chains spreading out 30 levels below the root, the widest
    // answer a 32-bit integer holds; two chains of 1,499 growing toward
    // each other; and a zigzag chain of 2,985 with a full tree of four
    // levels at its foot, 3,000 nodes in all.
    let root = leaf(0);
    let left = leaf(1);
    let right = leaf(2);
    root.left = Some(left);
    root.right = Some(right);
    chain(left, 29, vec![0]);
    chain(right, 29, vec![1]);
    show("spreading chains, 31 levels".to_string(), Some(root));
    let root = leaf(0);
    let left = leaf(1);
    let right = leaf(2);
    root.left = Some(left);
    root.right = Some(right);
    chain(left, 1498, vec![1]);
    chain(right, 1498, vec![0]);
    show("chains growing together, 2999 nodes".to_string(), Some(root));
    let root = leaf(0);
    let foot = chain(root, 2984, vec![0, 1, 1, 0, 1]);
    foot.left = full(4);
    show("zigzag chain with a full foot, 3000 nodes".to_string(), Some(root));
    // 200 random trees at most 1 to 12 levels deep: a checksum of their
    // widths.
    let mut seed: i64 = 662;
    let mut sum = 0;
    let mut widest = 0;
    for _ in 0..200 {
        let levels = 1 + next_random(mut seed) % 12;
        let chance = 40 + next_random(mut seed) % 61;
        let w = width_of_binary_tree(random_tree(levels, chance, mut seed));
        widest = widest.max(w);
        sum = (sum * 31 + w) % 1000000007;
    }
    println(f"200 random trees: widest {widest}, checksum {sum}");
    // The problem's largest, 3,000 nodes grown at random, at most 31
    // levels deep.
    for _ in 0..2 {
        show("3000 nodes grown at random".to_string(), grown_tree(3000, 31, mut seed));
    }
}
