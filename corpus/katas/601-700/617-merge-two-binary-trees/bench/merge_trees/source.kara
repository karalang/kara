// Benchmark for #617: the ★ arm (recursion, a new tree); see
// merge_trees.kara.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn merge_trees(root1: Option[TreeNode], root2: Option[TreeNode]) -> Option[TreeNode] {
    match (root1, root2) {
        (Some(a), Some(b)) => Some(TreeNode {
            val: a.val + b.val,
            left: merge_trees(a.left, b.left),
            right: merge_trees(a.right, b.right),
        }),
        (Some(a), None) => Some(a),
        (None, other) => other,
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A tree of `size` nodes with values from -10,000 to 10,000: each new
// node walks down from the root, going left with chance lean / 100, and
// takes the first empty place it meets.
fn random_tree(size: i64, lean: i64, seed: mut ref i64) -> Option[TreeNode] {
    let root = leaf(next_random(mut seed) % 20001 - 10000);
    for _ in 1..size {
        let c = leaf(next_random(mut seed) % 20001 - 10000);
        let mut node = root;
        loop {
            if next_random(mut seed) % 100 < lean {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(c);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(c);
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

// The number of nodes, and a checksum over the values in preorder.
fn walk(node: Option[TreeNode], count: mut ref i64, h: mut ref i64) {
    if let Some(n) = node {
        *count += 1;
        *h = (*h * 31 + n.val + 20000) % 1000000007;
        walk(n.left, mut count, mut h);
        walk(n.right, mut count, mut h);
    }
}

fn main() {
    // 20 trees of 2,000 nodes, the problem's most, leaning left with
    // chance 30 to 70 in 100, made once; then 10,000 times merges two of
    // them, picked by the round, and walks the merged tree.
    let trees = 20;
    let rounds = 10000;
    let mut seed: i64 = 617;
    let mut all: Vec[Option[TreeNode]] = Vec.new();
    for _ in 0..trees {
        let lean = 30 + next_random(mut seed) % 41;
        all.push(random_tree(2000, lean, mut seed));
    }
    let mut count = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let merged = merge_trees(all[(r * 7) % trees], all[(r * 3 + 1) % trees]);
        walk(merged, mut count, mut checksum);
    }
    println(f"{trees} trees, {rounds} rounds: {count} nodes, checksum {checksum}");
}
