// LeetCode #647: differential -- the four arms against the definition.
//
// Copies of the four arms, held to five properties on random cases.

// ---- star arm ----------------------------------------------------------

fn count_substrings_star(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut count = 0;
    for center in 0..2 * n - 1 {
        let mut lo = center / 2;
        let mut hi = lo + center % 2;
        while lo >= 0 and hi < n and bytes[lo] == bytes[hi] {
            count += 1;
            lo -= 1;
            hi += 1;
        }
    }
    count
}

// ---- table arm ---------------------------------------------------------

fn count_substrings_table(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut pal: Vec[Vec[bool]] = Vec.new();
    for _ in 0..n {
        pal.push(vec![false; n]);
    }
    let mut count = 0;
    let mut i = n - 1;
    while i >= 0 {
        for j in i..n {
            if bytes[i] == bytes[j] and (j - i < 2 or pal[i + 1][j - 1]) {
                pal[i][j] = true;
                count += 1;
            }
        }
        i -= 1;
    }
    count
}

// ---- manacher arm ------------------------------------------------------

fn count_substrings_manacher(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut odd = vec![0; n];
    let mut lo = 0;
    let mut hi = -1;
    for i in 0..n {
        let mut k = 1;
        if i <= hi {
            k = odd[lo + hi - i].min(hi - i + 1);
        }
        while i - k >= 0 and i + k < n and bytes[i - k] == bytes[i + k] {
            k += 1;
        }
        odd[i] = k;
        if i + k - 1 > hi {
            lo = i - k + 1;
            hi = i + k - 1;
        }
    }
    let mut even = vec![0; n];
    lo = 0;
    hi = -1;
    for i in 0..n {
        let mut k = 0;
        if i <= hi {
            k = even[lo + hi - i + 1].min(hi - i + 1);
        }
        while i - k - 1 >= 0 and i + k < n and bytes[i - k - 1] == bytes[i + k] {
            k += 1;
        }
        even[i] = k;
        if i + k - 1 > hi {
            lo = i - k;
            hi = i + k - 1;
        }
    }
    let mut count = 0;
    for i in 0..n {
        count += odd[i] + even[i];
    }
    count
}

// ---- ends arm ----------------------------------------------------------

fn count_substrings_ends(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut starts: Vec[i64] = Vec.new();
    let mut count = 0;
    for i in 0..n {
        let mut next: Vec[i64] = Vec.new();
        next.push(i);
        if i >= 1 and bytes[i - 1] == bytes[i] {
            next.push(i - 1);
        }
        for start in starts.iter() {
            if *start >= 1 and bytes[*start - 1] == bytes[i] {
                next.push(*start - 1);
            }
        }
        count += next.len();
        starts = next;
    }
    count
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, s: String) -> i64 {
    if which == 0 {
        count_substrings_star(s)
    } else if which == 1 {
        count_substrings_table(s)
    } else if which == 2 {
        count_substrings_manacher(s)
    } else {
        count_substrings_ends(s)
    }
}

// The definition: every substring compared with itself read backwards.
fn definition(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut count = 0;
    for i in 0..n {
        for j in i..n {
            let mut same = true;
            for k in 0..j - i + 1 {
                if bytes[i + k] != bytes[j - k] {
                    same = false;
                }
            }
            if same {
                count += 1;
            }
        }
    }
    count
}

// `n` letters, each one of the first `letters` of the alphabet.
fn random_text(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn main() {
    let count_cases = 1000;
    let mut seed: i64 = 6470;
    let mut checks = 0;
    let mut letters_seen = 0;
    let mut failures = vec![0; 5];
    for _ in 0..count_cases {
        // 1 to 14 letters from the first 1 to 3 of the alphabet.
        let n = 1 + next_random(mut seed) % 14;
        let s = random_text(n, 1 + next_random(mut seed) % 3, mut seed);
        letters_seen += n;
        let bytes = s.bytes();
        let mut reversed = String.new();
        let mut renamed = String.new();
        for i in 0..n {
            reversed.push(bytes[n - 1 - i] as char);
            renamed.push(((97 + (bytes[i] as i64 - 97 + 1) % 3) as u8) as char);
        }
        let mut longer = s.clone();
        longer.push('z');
        let want = definition(s);
        for which in 0..4 {
            let got = answer(which, s);
            let ok = vec![
                // P1: the definition's answer.
                got == want,
                // P2: at least every single letter and at most every
                // substring.
                got >= n and got <= n * (n + 1) / 2,
                // P3: the string reversed gives the same answer.
                answer(which, reversed) == got,
                // P4: the letters renamed, a to b, b to c and c to a,
                // give the same answer.
                answer(which, renamed) == got,
                // P5: a letter the string does not hold, put on the end,
                // adds exactly one.
                answer(which, longer) == got + 1,
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                }
            }
        }
    }
    let all = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count_cases} cases ({letters_seen} letters), 4 arms, {checks} checks, {all} failures");
    if all > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
