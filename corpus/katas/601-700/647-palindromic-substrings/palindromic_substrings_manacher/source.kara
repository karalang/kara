// LeetCode #647: Palindromic Substrings -- Manacher's algorithm.
//
// `odd[i]` is how many odd palindromes are centered on character `i`,
// and `even[i]` how many even ones are centered on the gap before it;
// their sum is the answer. Inside the rightmost palindrome found so far,
// a center starts from what its mirror image across that palindrome's
// center already knows, so the window only ever widens past the right
// edge, which moves right each time. O(n) time and space.

fn count_substrings(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut odd = vec![0; n];
    let mut lo = 0;
    let mut hi = -1;
    for i in 0..n {
        let mut k = 1;
        if i <= hi {
            k = odd[lo + hi - i].min(hi - i + 1);
        }
        while i - k >= 0 and i + k < n and bytes[i - k] == bytes[i + k] {
            k += 1;
        }
        odd[i] = k;
        if i + k - 1 > hi {
            lo = i - k + 1;
            hi = i + k - 1;
        }
    }
    let mut even = vec![0; n];
    lo = 0;
    hi = -1;
    for i in 0..n {
        let mut k = 0;
        if i <= hi {
            k = even[lo + hi - i + 1].min(hi - i + 1);
        }
        while i - k - 1 >= 0 and i + k < n and bytes[i - k - 1] == bytes[i + k] {
            k += 1;
        }
        even[i] = k;
        if i + k - 1 > hi {
            lo = i - k;
            hi = i + k - 1;
        }
    }
    let mut count = 0;
    for i in 0..n {
        count += odd[i] + even[i];
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: String) {
    println(f"\"{s}\" -> {count_substrings(s)}");
}

// `n` letters, each one of the first `letters` of the alphabet.
fn random_text(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(((97 + next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn main() {
    // The two LeetCode examples.
    show("abc");
    show("aaa");
    // One letter; two different and two equal; odd and even palindromes
    // as the whole string; one inside another; a long run with a break;
    // and palindromes that overlap.
    show("z");
    show("ab");
    show("bb");
    show("racecar");
    show("abba");
    show("xabbay");
    show("aaaabaaaa");
    show("abababa");
    show("abacdfgdcaba");
    // 300 random cases of 1 to 40 letters from the first 1 to 4 of the
    // alphabet.
    let mut seed: i64 = 647;
    let mut sum = 0;
    let mut checksum = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 40;
        let letters = 1 + next_random(mut seed) % 4;
        let c = count_substrings(random_text(n, letters, mut seed));
        sum += c;
        checksum = (checksum * 31 + c) % 1000000007;
    }
    println(f"300 random cases: total {sum}, checksum {checksum}");
    // The problem's largest, 1,000 letters: all one letter, from two
    // letters and from all 26.
    println(f"1000 of one letter: {count_substrings(random_text(1000, 1, mut seed))}");
    println(f"1000 of two letters: {count_substrings(random_text(1000, 2, mut seed))}");
    println(f"1000 of 26 letters: {count_substrings(random_text(1000, 26, mut seed))}");
}
