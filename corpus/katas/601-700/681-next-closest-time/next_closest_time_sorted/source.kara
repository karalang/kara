// LeetCode #681: Next Closest Time -- a sorted list of the times.
//
// List every time whose digits come from the given ones, in minutes
// after midnight, sorted and without repeats, then binary search for the
// first one after the given time, wrapping to the first of the list when
// none is later. The list always holds the given time. O(256 log 256).

fn next_closest_time(time: String) -> String {
    let digits: Vec[i64] = time
        .bytes()
        .iter()
        .filter(|c| *c != b':')
        .map(|c| (*c - b'0') as i64)
        .collect();
    let mut times: Vec[i64] = Vec.new();
    for a in digits.iter() {
        for c in digits.iter() {
            if *a * 10 + *c < 24 {
                for d in digits.iter() {
                    for e in digits.iter() {
                        if *d < 6 {
                            times.push((*a * 10 + *c) * 60 + *d * 10 + *e);
                        }
                    }
                }
            }
        }
    }
    times.sort();
    times.dedup();
    let now = (digits[0] * 10 + digits[1]) * 60 + digits[2] * 10 + digits[3];
    let mut lo = 0;
    let mut hi = times.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if times[mid] <= now {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    let at = if lo == times.len() { times[0] } else { times[lo] };
    f"{at / 600}{at / 60 % 10}:{at % 60 / 10}{at % 10}"
}

// ---- test harness ---------------------------------------------------------

fn clock(minutes: i64) -> String {
    let h = minutes / 60;
    let m = minutes % 60;
    f"{h / 10}{h % 10}:{m / 10}{m % 10}"
}

fn minutes_of(time: String) -> i64 {
    let b = time.bytes();
    let h = (b[0] - b'0') as i64 * 10 + (b[1] - b'0') as i64;
    h * 60 + (b[3] - b'0') as i64 * 10 + (b[4] - b'0') as i64
}

fn show(time: String) {
    println(f"\"{time}\" -> \"{next_closest_time(time)}\"");
}

fn main() {
    show("19:34");
    show("23:59");
    show("00:00");
    show("11:11");
    show("13:55");
    show("01:32");
    show("20:48");
    show("22:23");
    show("06:59");
    show("23:32");
    show("12:09");
    show("15:55");

    // Every time of day.
    let mut checksum = 0;
    let mut same = 0;
    let mut wrapped = 0;
    let mut ahead_total = 0;
    let mut farthest = 0;
    let mut farthest_at = String.new();
    for now in 0..1440 {
        let time = clock(now);
        let answer = next_closest_time(time);
        let then = minutes_of(answer);
        let mut ahead = (then - now + 1440) % 1440;
        if ahead == 0 {
            ahead = 1440;
            same += 1;
        }
        if then <= now {
            wrapped += 1;
        }
        ahead_total += ahead;
        if ahead < 1440 and ahead > farthest {
            farthest = ahead;
            farthest_at = time;
        }
        checksum = (checksum * 1441 + then + 1) % 1000000007;
    }
    println(f"1440 times: {same} answer themselves, {wrapped} answer on the next day");
    println(f"{ahead_total} minutes ahead in all; farthest but a whole day {farthest}, from \"{farthest_at}\"");
    println(f"checksum {checksum}");
}
