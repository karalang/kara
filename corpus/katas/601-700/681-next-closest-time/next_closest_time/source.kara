// LeetCode #681: Next Closest Time -- step a minute at a time.
//
// Count forward from the given time one minute at a time, wrapping at
// midnight, and stop at the first time whose four digits all appear in
// the given time. The given time itself is reached after 1,440 steps
// at the latest, so the loop always ends. O(1440) time.

fn digits_of(minutes: i64) -> Array[i64, 4] {
    let h = minutes / 60;
    let m = minutes % 60;
    [h / 10, h % 10, m / 10, m % 10]
}

fn next_closest_time(time: String) -> String {
    let b = time.bytes();
    let h = (b[0] - b'0') as i64 * 10 + (b[1] - b'0') as i64;
    let m = (b[3] - b'0') as i64 * 10 + (b[4] - b'0') as i64;
    let mut allowed = [false; 10];
    for d in digits_of(h * 60 + m) {
        allowed[d] = true;
    }
    let mut now = h * 60 + m;
    loop {
        now = (now + 1) % 1440;
        let mut ok = true;
        for d in digits_of(now) {
            if not allowed[d] {
                ok = false;
            }
        }
        if ok {
            return f"{now / 600}{now / 60 % 10}:{now % 60 / 10}{now % 10}";
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn clock(minutes: i64) -> String {
    let h = minutes / 60;
    let m = minutes % 60;
    f"{h / 10}{h % 10}:{m / 10}{m % 10}"
}

fn minutes_of(time: String) -> i64 {
    let b = time.bytes();
    let h = (b[0] - b'0') as i64 * 10 + (b[1] - b'0') as i64;
    h * 60 + (b[3] - b'0') as i64 * 10 + (b[4] - b'0') as i64
}

fn show(time: String) {
    println(f"\"{time}\" -> \"{next_closest_time(time)}\"");
}

fn main() {
    show("19:34");
    show("23:59");
    show("00:00");
    show("11:11");
    show("13:55");
    show("01:32");
    show("20:48");
    show("22:23");
    show("06:59");
    show("23:32");
    show("12:09");
    show("15:55");

    // Every time of day.
    let mut checksum = 0;
    let mut same = 0;
    let mut wrapped = 0;
    let mut ahead_total = 0;
    let mut farthest = 0;
    let mut farthest_at = String.new();
    for now in 0..1440 {
        let time = clock(now);
        let answer = next_closest_time(time);
        let then = minutes_of(answer);
        let mut ahead = (then - now + 1440) % 1440;
        if ahead == 0 {
            ahead = 1440;
            same += 1;
        }
        if then <= now {
            wrapped += 1;
        }
        ahead_total += ahead;
        if ahead < 1440 and ahead > farthest {
            farthest = ahead;
            farthest_at = time;
        }
        checksum = (checksum * 1441 + then + 1) % 1000000007;
    }
    println(f"1440 times: {same} answer themselves, {wrapped} answer on the next day");
    println(f"{ahead_total} minutes ahead in all; farthest but a whole day {farthest}, from \"{farthest_at}\"");
    println(f"checksum {checksum}");
}
