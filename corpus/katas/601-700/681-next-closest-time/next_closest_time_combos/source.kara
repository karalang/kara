// LeetCode #681: Next Closest Time -- every time from the four digits.
//
// Write out all 4^4 = 256 ways to fill the four places with the given
// digits, keep those that are real times, and take the one the fewest
// minutes ahead, counting a time equal to the given one as a whole day
// ahead. O(256) time.

fn next_closest_time(time: String) -> String {
    let b = time.bytes();
    let digits = [b[0] - b'0', b[1] - b'0', b[3] - b'0', b[4] - b'0'];
    let hour = (digits[0] * 10 + digits[1]) as i64;
    let now = hour * 60 + (digits[2] * 10 + digits[3]) as i64;
    let mut best = now;
    let mut best_ahead = 1440;
    for a in digits {
        for c in digits {
            for d in digits {
                for e in digits {
                    let h = (a * 10 + c) as i64;
                    let m = (d * 10 + e) as i64;
                    if h < 24 and m < 60 {
                        let mut ahead = (h * 60 + m - now + 1440) % 1440;
                        if ahead == 0 {
                            ahead = 1440;
                        }
                        if ahead < best_ahead {
                            best_ahead = ahead;
                            best = h * 60 + m;
                        }
                    }
                }
            }
        }
    }
    f"{best / 600}{best / 60 % 10}:{best % 60 / 10}{best % 10}"
}

// ---- test harness ---------------------------------------------------------

fn clock(minutes: i64) -> String {
    let h = minutes / 60;
    let m = minutes % 60;
    f"{h / 10}{h % 10}:{m / 10}{m % 10}"
}

fn minutes_of(time: String) -> i64 {
    let b = time.bytes();
    let h = (b[0] - b'0') as i64 * 10 + (b[1] - b'0') as i64;
    h * 60 + (b[3] - b'0') as i64 * 10 + (b[4] - b'0') as i64
}

fn show(time: String) {
    println(f"\"{time}\" -> \"{next_closest_time(time)}\"");
}

fn main() {
    show("19:34");
    show("23:59");
    show("00:00");
    show("11:11");
    show("13:55");
    show("01:32");
    show("20:48");
    show("22:23");
    show("06:59");
    show("23:32");
    show("12:09");
    show("15:55");

    // Every time of day.
    let mut checksum = 0;
    let mut same = 0;
    let mut wrapped = 0;
    let mut ahead_total = 0;
    let mut farthest = 0;
    let mut farthest_at = String.new();
    for now in 0..1440 {
        let time = clock(now);
        let answer = next_closest_time(time);
        let then = minutes_of(answer);
        let mut ahead = (then - now + 1440) % 1440;
        if ahead == 0 {
            ahead = 1440;
            same += 1;
        }
        if then <= now {
            wrapped += 1;
        }
        ahead_total += ahead;
        if ahead < 1440 and ahead > farthest {
            farthest = ahead;
            farthest_at = time;
        }
        checksum = (checksum * 1441 + then + 1) % 1000000007;
    }
    println(f"1440 times: {same} answer themselves, {wrapped} answer on the next day");
    println(f"{ahead_total} minutes ahead in all; farthest but a whole day {farthest}, from \"{farthest_at}\"");
    println(f"checksum {checksum}");
}
