// LeetCode #681: Next Closest Time -- step a minute at a time. Bench.
//
// Every time of day, 300 rounds of them in an order that changes each
// round: 432,000 answers, each counted when it falls on the next day
// and put into a checksum.

fn digits_of(minutes: i64) -> Array[i64, 4] {
    let h = minutes / 60;
    let m = minutes % 60;
    [h / 10, h % 10, m / 10, m % 10]
}

fn next_closest_time(time: String) -> String {
    let b = time.bytes();
    let h = (b[0] - b'0') as i64 * 10 + (b[1] - b'0') as i64;
    let m = (b[3] - b'0') as i64 * 10 + (b[4] - b'0') as i64;
    let mut allowed = [false; 10];
    for d in digits_of(h * 60 + m) {
        allowed[d] = true;
    }
    let mut now = h * 60 + m;
    loop {
        now = (now + 1) % 1440;
        let mut ok = true;
        for d in digits_of(now) {
            if not allowed[d] {
                ok = false;
            }
        }
        if ok {
            return f"{now / 600}{now / 60 % 10}:{now % 60 / 10}{now % 10}";
        }
    }
}

fn main() {
    let rounds = 300;
    let mut times: Vec[String] = Vec.new();
    for t in 0..1440 {
        let h = t / 60;
        let m = t % 60;
        times.push(f"{h / 10}{h % 10}:{m / 10}{m % 10}");
    }
    let mut sum = 0;
    let mut wrapped = 0;
    for r in 0..rounds {
        for k in 0..1440 {
            let at = (k * 7 + r) % 1440;
            let answer = next_closest_time(times[at]);
            let b = answer.bytes();
            let hour = (b[0] - b'0') as i64 * 10 + (b[1] - b'0') as i64;
            let then = hour * 60 + (b[3] - b'0') as i64 * 10 + (b[4] - b'0') as i64;
            if then <= at {
                wrapped += 1;
            }
            sum = (sum * 1441 + then + 1) % 1000000007;
        }
    }
    println(f"{1440 * rounds} times: {wrapped} answers on the next day, checksum {sum}");
}
