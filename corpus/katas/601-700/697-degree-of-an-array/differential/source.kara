// LeetCode #697: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random problems.

// ---- star arm ----------------------------------------------------------

fn find_shortest_sub_array_star(nums: Vec[i64]) -> i64 {
    let mut count: Map[i64, i64] = Map.new();
    let mut first: Map[i64, i64] = Map.new();
    let mut last: Map[i64, i64] = Map.new();
    for i in 0..nums.len() {
        let x = nums[i];
        if not first.contains_key(x) {
            first.insert(x, i);
        }
        last.insert(x, i);
        let c = match count.get(x) {
            Some(c) => *c,
            None => 0,
        };
        count.insert(x, c + 1);
    }
    let mut degree = 0;
    let mut best = nums.len();
    for (x, c) in count.iter() {
        let span = *last.get(*x).unwrap() - *first.get(*x).unwrap() + 1;
        if *c > degree or (*c == degree and span < best) {
            degree = *c;
            best = span;
        }
    }
    best
}

// ---- table arm ---------------------------------------------------------

fn find_shortest_sub_array_table(nums: Vec[i64]) -> i64 {
    let size = 50000;
    let mut count: Vec[i64] = vec![0; size];
    let mut first: Vec[i64] = vec![-1; size];
    let mut last: Vec[i64] = vec![0; size];
    for i in 0..nums.len() {
        let x = nums[i];
        if first[x] < 0 {
            first[x] = i;
        }
        last[x] = i;
        count[x] += 1;
    }
    let mut degree = 0;
    let mut best = nums.len();
    for x in 0..size {
        if count[x] == 0 {
            continue;
        }
        let span = last[x] - first[x] + 1;
        if count[x] > degree or (count[x] == degree and span < best) {
            degree = count[x];
            best = span;
        }
    }
    best
}

// ---- running arm -------------------------------------------------------

fn find_shortest_sub_array_running(nums: Vec[i64]) -> i64 {
    let mut count: Map[i64, i64] = Map.new();
    let mut first: Map[i64, i64] = Map.new();
    let mut degree = 0;
    let mut best = 0;
    for i in 0..nums.len() {
        let x = nums[i];
        if not first.contains_key(x) {
            first.insert(x, i);
        }
        let c = match count.get(x) {
            Some(c) => *c + 1,
            None => 1,
        };
        count.insert(x, c);
        let span = i - *first.get(x).unwrap() + 1;
        if c > degree {
            degree = c;
            best = span;
        } else if c == degree and span < best {
            best = span;
        }
    }
    best
}

// ---- sorted arm --------------------------------------------------------

fn find_shortest_sub_array_sorted(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut order: Vec[i64] = Vec.new();
    for i in 0..n {
        order.push(i);
    }
    order.sort_by(|a, b| if nums[a] != nums[b] { nums[a].cmp(nums[b]) } else { a.cmp(b) });
    let mut degree = 0;
    let mut best = n;
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and nums[order[j]] == nums[order[i]] {
            j += 1;
        }
        let c = j - i;
        let span = order[j - 1] - order[i] + 1;
        if c > degree or (c == degree and span < best) {
            degree = c;
            best = span;
        }
        i = j;
    }
    best
}

// ---- the definition and the properties ------------------------------------

fn answer(which: i64, nums: Vec[i64]) -> i64 {
    if which == 0 {
        find_shortest_sub_array_star(nums)
    } else if which == 1 {
        find_shortest_sub_array_table(nums)
    } else if which == 2 {
        find_shortest_sub_array_running(nums)
    } else {
        find_shortest_sub_array_sorted(nums)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The highest count of any one value in nums[from..to].
fn degree_of(nums: Vec[i64], from: i64, to: i64) -> i64 {
    let mut count: Map[i64, i64] = Map.new();
    let mut degree = 0;
    for k in from..to {
        let c = match count.get(nums[k]) {
            Some(c) => *c + 1,
            None => 1,
        };
        count.insert(nums[k], c);
        if c > degree {
            degree = c;
        }
    }
    degree
}

// The definition: the length of the shortest run nums[i..j] whose degree
// is the whole array's degree, found by trying every run. Each start i
// grows its run one value at a time, keeping that run's counts.
fn definition(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let degree = degree_of(nums, 0, n);
    let mut best = n;
    for i in 0..n {
        let mut count: Map[i64, i64] = Map.new();
        let mut run_degree = 0;
        for j in i..n {
            let c = match count.get(nums[j]) {
                Some(c) => *c + 1,
                None => 1,
            };
            count.insert(nums[j], c);
            if c > run_degree {
                run_degree = c;
            }
            if run_degree == degree and j + 1 - i < best {
                best = j + 1 - i;
            }
        }
    }
    best
}

fn main() {
    let mut seed = 6970;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 500;
    for _ in 0..cases {
        // Arrays of 1 to 30 values drawn from k values starting at base,
        // so a small k gives many copies and ties.
        let n = 1 + next_random(mut seed) % 30;
        let k = 1 + next_random(mut seed) % 12;
        let base = 1 + next_random(mut seed) % 49000;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(base + next_random(mut seed) % k);
        }
        // The array reversed; every value x relabelled 49999 - x; a value
        // the array does not hold (base - 1) added at the end.
        let mut reversed: Vec[i64] = Vec.new();
        let mut relabelled: Vec[i64] = Vec.new();
        let mut longer: Vec[i64] = Vec.new();
        for i in 0..n {
            reversed.push(nums[n - 1 - i]);
            relabelled.push(49999 - nums[i]);
            longer.push(nums[i]);
        }
        longer.push(base - 1);
        let want = definition(nums);
        for which in 0..arms {
            let got = answer(which, nums);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: read backwards, the same answer.
            checks += 1;
            if answer(which, reversed) != got {
                fails[1] += 1;
            }
            // P3: the values renamed, the same answer.
            checks += 1;
            if answer(which, relabelled) != got {
                fails[2] += 1;
            }
            // P4: a new value at the end changes nothing, unless every
            // value was already distinct (the answer stays 1 then too).
            checks += 1;
            if answer(which, longer) != got {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut total = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
        }
        total += fails[p];
    }
    println(f"{report}{cases} arrays, {arms} arms, {checks} checks, {total} failures");
}
