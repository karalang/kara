// LeetCode #683: K Empty Slots -- counts of the bulbs that are on.
//
// Turn the bulbs on day by day, counting the bulbs on in each prefix of
// positions with a Fenwick tree. On the day bulb x comes on, a bulb
// k + 1 to its left that is already on, with no bulb on in between, is
// a prefix count that rises by exactly one from x - k - 2 to x - k - 1
// and not at all from there to x - 1; the same on the right. O(n log n)
// time, O(n) space.

fn add(tree: mut ref Vec[i64], at: i64) {
    let mut i = at;
    while i < tree.len() {
        tree[i] += 1;
        i += i & (0 - i);
    }
}

// How many bulbs are on among positions 1 to `at`.
fn count(tree: ref Vec[i64], at: i64) -> i64 {
    let mut i = at;
    let mut total = 0;
    while i > 0 {
        total += tree[i];
        i -= i & (0 - i);
    }
    total
}

// Whether bulbs `a` and `b`, a < b, are both on with none on between.
fn lone_pair(tree: ref Vec[i64], a: i64, b: i64) -> bool {
    count(tree, a) - count(tree, a - 1) == 1
        and count(tree, b) - count(tree, b - 1) == 1
        and count(tree, b - 1) - count(tree, a) == 0
}

fn k_empty_slots(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut tree: Vec[i64] = vec![0; n + 1];
    for d in 0..n {
        let x = bulbs[d];
        add(mut tree, x);
        if x - k - 1 >= 1 and lone_pair(tree, x - k - 1, x) {
            return d + 1;
        }
        if x + k + 1 <= n and lone_pair(tree, x, x + k + 1) {
            return d + 1;
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(bulbs: Vec[i64], k: i64) {
    println(f"{bulbs}, k = {k} -> {k_empty_slots(bulbs.clone(), k)}");
}

// A random order of the bulbs 1 to n.
fn shuffled(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        v.push(x);
    }
    let mut i = n - 1;
    while i > 0 {
        let j = (next_random(seed) * 32768 + next_random(seed)) % (i + 1);
        v.swap(i, j);
        i -= 1;
    }
    v
}

// The next order of `v` in lexicographic order, or false after the last.
fn next_order(v: mut ref Vec[i64]) -> bool {
    let n = v.len();
    let mut i = n - 2;
    while i >= 0 and v[i] >= v[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = n - 1;
    while v[j] <= v[i] {
        j -= 1;
    }
    v.swap(i, j);
    let mut a = i + 1;
    let mut b = n - 1;
    while a < b {
        v.swap(a, b);
        a += 1;
        b -= 1;
    }
    true
}

fn main() {
    show([1, 3, 2], 1);
    show([1, 2, 3], 1);
    show([6, 5, 8, 9, 7, 1, 10, 2, 3, 4], 2);
    show([1], 0);
    show([1, 2], 0);
    show([2, 1], 0);
    show([3, 1, 2], 1);
    show([1, 4, 2, 3], 2);
    show([5, 1, 4, 2, 3], 3);
    show([1, 5, 3, 2, 4], 3);
    show([4, 1, 3, 5, 2], 0);

    // Every order of 1 to 7 bulbs, for every k from 0 to n - 1.
    let mut found = 0;
    let mut never = 0;
    let mut sum = 0;
    for n in 1..8 {
        for k in 0..n {
            let mut v: Vec[i64] = Vec.new();
            for x in 1..n + 1 {
                v.push(x);
            }
            loop {
                let day = k_empty_slots(v.clone(), k);
                if day == -1 {
                    never += 1;
                } else {
                    found += 1;
                }
                sum = (sum * 31 + day + 2) % 1000000007;
                if not next_order(mut v) {
                    break;
                }
            }
        }
    }
    println(f"every order of 1 to 7 bulbs, every k: {found} with a day, {never} without, checksum {sum}");

    // Random orders of up to 1,000 bulbs.
    let mut seed = 683;
    let mut checksum = 0;
    let mut none = 0;
    for c in 0..200 {
        let n = 1 + next_random(mut seed) % 1000;
        let k = if c % 2 == 0 { next_random(mut seed) % 4 } else { next_random(mut seed) % n };
        let day = k_empty_slots(shuffled(mut seed, n), k);
        if day == -1 {
            none += 1;
        }
        checksum = (checksum * 31 + day + 2) % 1000000007;
    }
    println(f"200 random orders: {none} without a day, checksum {checksum}");
}
