// LeetCode #683: K Empty Slots -- a window over the days.
//
// Turn the input around: `days[p]` is the day bulb p comes on. Two bulbs
// k apart with every bulb between them still off are a window
// `left..=left + k + 1` whose inside bulbs all come on later than both
// ends, and the day it happens is the later of the two ends. Slide the
// window right; a bulb inside it that comes on sooner than an end
// cannot be inside any good window that holds that end, so the window
// jumps to start at it. Each bulb is looked at a bounded number of
// times. O(n) time and space.

fn k_empty_slots(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut days: Vec[i64] = vec![0; n];
    for d in 0..n {
        days[bulbs[d] - 1] = d + 1;
    }
    let mut best = -1;
    let mut left = 0;
    let mut right = k + 1;
    let mut i = 1;
    while right < n {
        if i == right {
            let day = if days[left] > days[right] { days[left] } else { days[right] };
            if best == -1 or day < best {
                best = day;
            }
            left = right;
            right = left + k + 1;
            i = left + 1;
        } else if days[i] < days[left] or days[i] < days[right] {
            left = i;
            right = left + k + 1;
            i = left + 1;
        } else {
            i += 1;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(bulbs: Vec[i64], k: i64) {
    println(f"{bulbs}, k = {k} -> {k_empty_slots(bulbs.clone(), k)}");
}

// A random order of the bulbs 1 to n.
fn shuffled(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        v.push(x);
    }
    let mut i = n - 1;
    while i > 0 {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        v.swap(i, j);
        i -= 1;
    }
    v
}

// The next order of `v` in lexicographic order, or false after the last.
fn next_order(v: mut ref Vec[i64]) -> bool {
    let n = v.len();
    let mut i = n - 2;
    while i >= 0 and v[i] >= v[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = n - 1;
    while v[j] <= v[i] {
        j -= 1;
    }
    v.swap(i, j);
    let mut a = i + 1;
    let mut b = n - 1;
    while a < b {
        v.swap(a, b);
        a += 1;
        b -= 1;
    }
    true
}

fn main() {
    show([1, 3, 2], 1);
    show([1, 2, 3], 1);
    show([6, 5, 8, 9, 7, 1, 10, 2, 3, 4], 2);
    show([1], 0);
    show([1, 2], 0);
    show([2, 1], 0);
    show([3, 1, 2], 1);
    show([1, 4, 2, 3], 2);
    show([5, 1, 4, 2, 3], 3);
    show([1, 5, 3, 2, 4], 3);
    show([4, 1, 3, 5, 2], 0);

    // Every order of 1 to 7 bulbs, for every k from 0 to n - 1.
    let mut found = 0;
    let mut never = 0;
    let mut sum = 0;
    for n in 1..8 {
        for k in 0..n {
            let mut v: Vec[i64] = Vec.new();
            for x in 1..n + 1 {
                v.push(x);
            }
            loop {
                let day = k_empty_slots(v.clone(), k);
                if day == -1 {
                    never += 1;
                } else {
                    found += 1;
                }
                sum = (sum * 31 + day + 2) % 1000000007;
                if not next_order(mut v) {
                    break;
                }
            }
        }
    }
    println(f"every order of 1 to 7 bulbs, every k: {found} with a day, {never} without, checksum {sum}");

    // Random orders of up to 1,000 bulbs.
    let mut seed = 683;
    let mut checksum = 0;
    let mut none = 0;
    for c in 0..200 {
        let n = 1 + next_random(mut seed) % 1000;
        let k = if c % 2 == 0 { next_random(mut seed) % 4 } else { next_random(mut seed) % n };
        let day = k_empty_slots(shuffled(mut seed, n), k);
        if day == -1 {
            none += 1;
        }
        checksum = (checksum * 31 + day + 2) % 1000000007;
    }
    println(f"200 random orders: {none} without a day, checksum {checksum}");
}
