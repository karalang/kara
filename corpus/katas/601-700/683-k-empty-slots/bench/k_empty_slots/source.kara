// LeetCode #683: K Empty Slots -- a window over the days. Bench.
//
// 100 random orders of 20,000 bulbs are built once; then 30 rounds
// answer every order, each with a k that changes with the round, from 0
// to 49.

fn k_empty_slots(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut days: Vec[i64] = vec![0; n];
    for d in 0..n {
        days[bulbs[d] - 1] = d + 1;
    }
    let mut best = -1;
    let mut left = 0;
    let mut right = k + 1;
    let mut i = 1;
    while right < n {
        if i == right {
            let day = if days[left] > days[right] { days[left] } else { days[right] };
            if best == -1 or day < best {
                best = day;
            }
            left = right;
            right = left + k + 1;
            i = left + 1;
        } else if days[i] < days[left] or days[i] < days[right] {
            left = i;
            right = left + k + 1;
            i = left + 1;
        } else {
            i += 1;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let n = 20000;
    let rounds = 30;
    let mut seed = 683;
    let mut orders: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut v: Vec[i64] = Vec.new();
        for x in 1..n + 1 {
            v.push(x);
        }
        let mut i = n - 1;
        while i > 0 {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            v.swap(i, j);
            i -= 1;
        }
        orders.push(v);
    }
    let mut sum = 0;
    let mut none = 0;
    for r in 0..rounds {
        for c in 0..count {
            let k = (c * 7 + r) % 50;
            let day = k_empty_slots(orders[c], k);
            if day == -1 {
                none += 1;
            }
            sum = (sum * 31 + day + 2) % 1000000007;
        }
    }
    println(f"{count * rounds} answers: {none} without a day, checksum {sum}");
}
