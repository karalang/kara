// LeetCode #683: K Empty Slots -- the sliding minimum of the days.
//
// With `days[p]` the day bulb p comes on, positions i and i + k + 1 make
// a gap on the later of their two days when every day strictly between
// them is later still. The earliest day among each run of k positions
// is a sliding-window minimum, kept in a deque of positions whose days
// rise from front to back. O(n) time and space.

fn k_empty_slots(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut days: Vec[i64] = vec![0; n];
    for d in 0..n {
        days[bulbs[d] - 1] = d + 1;
    }
    let mut best = -1;
    let mut window: VecDeque[i64] = VecDeque.new();
    // The window holds positions i + 1 to i + k; when k is 0 it is
    // empty and the inside is vacuously later than both ends.
    for i in 0..n - k - 1 {
        if i == 0 {
            for p in 1..k + 1 {
                while not window.is_empty() and days[*window.back().unwrap()] >= days[p] {
                    window.pop_back();
                }
                window.push_back(p);
            }
        } else if k > 0 {
            if *window.front().unwrap() == i {
                window.pop_front();
            }
            let p = i + k;
            while not window.is_empty() and days[*window.back().unwrap()] >= days[p] {
                window.pop_back();
            }
            window.push_back(p);
        }
        let ends = if days[i] > days[i + k + 1] { days[i] } else { days[i + k + 1] };
        let inside = if window.is_empty() { n + 1 } else { days[*window.front().unwrap()] };
        if inside > ends and (best == -1 or ends < best) {
            best = ends;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(bulbs: Vec[i64], k: i64) {
    println(f"{bulbs}, k = {k} -> {k_empty_slots(bulbs.clone(), k)}");
}

// A random order of the bulbs 1 to n.
fn shuffled(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        v.push(x);
    }
    let mut i = n - 1;
    while i > 0 {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        v.swap(i, j);
        i -= 1;
    }
    v
}

// The next order of `v` in lexicographic order, or false after the last.
fn next_order(v: mut ref Vec[i64]) -> bool {
    let n = v.len();
    let mut i = n - 2;
    while i >= 0 and v[i] >= v[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = n - 1;
    while v[j] <= v[i] {
        j -= 1;
    }
    v.swap(i, j);
    let mut a = i + 1;
    let mut b = n - 1;
    while a < b {
        v.swap(a, b);
        a += 1;
        b -= 1;
    }
    true
}

fn main() {
    show([1, 3, 2], 1);
    show([1, 2, 3], 1);
    show([6, 5, 8, 9, 7, 1, 10, 2, 3, 4], 2);
    show([1], 0);
    show([1, 2], 0);
    show([2, 1], 0);
    show([3, 1, 2], 1);
    show([1, 4, 2, 3], 2);
    show([5, 1, 4, 2, 3], 3);
    show([1, 5, 3, 2, 4], 3);
    show([4, 1, 3, 5, 2], 0);

    // Every order of 1 to 7 bulbs, for every k from 0 to n - 1.
    let mut found = 0;
    let mut never = 0;
    let mut sum = 0;
    for n in 1..8 {
        for k in 0..n {
            let mut v: Vec[i64] = Vec.new();
            for x in 1..n + 1 {
                v.push(x);
            }
            loop {
                let day = k_empty_slots(v.clone(), k);
                if day == -1 {
                    never += 1;
                } else {
                    found += 1;
                }
                sum = (sum * 31 + day + 2) % 1000000007;
                if not next_order(mut v) {
                    break;
                }
            }
        }
    }
    println(f"every order of 1 to 7 bulbs, every k: {found} with a day, {never} without, checksum {sum}");

    // Random orders of up to 1,000 bulbs.
    let mut seed = 683;
    let mut checksum = 0;
    let mut none = 0;
    for c in 0..200 {
        let n = 1 + next_random(mut seed) % 1000;
        let k = if c % 2 == 0 { next_random(mut seed) % 4 } else { next_random(mut seed) % n };
        let day = k_empty_slots(shuffled(mut seed, n), k);
        if day == -1 {
            none += 1;
        }
        checksum = (checksum * 31 + day + 2) % 1000000007;
    }
    println(f"200 random orders: {none} without a day, checksum {checksum}");
}
