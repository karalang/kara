// LeetCode #683: K Empty Slots -- the bulbs that are on, in order.
//
// Turn the bulbs on day by day, keeping the positions that are on in a
// `SortedSet`. A new bulb can only make a gap of exactly k with its
// nearest bulb on each side, since any farther bulb has that neighbour
// between them. So on each day, look up the two neighbours and stop at
// the first day either is k + 1 away. O(n log n) time, O(n) space.

fn k_empty_slots(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut on: SortedSet[i64] = SortedSet.new();
    for d in 0..n {
        let x = bulbs[d];
        on.insert(x);
        if let Some(below) = on.range(1, x).last() {
            if x - *below == k + 1 {
                return d + 1;
            }
        }
        if let Some(above) = on.range(x + 1, n + 1).next() {
            if *above - x == k + 1 {
                return d + 1;
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(bulbs: Vec[i64], k: i64) {
    println(f"{bulbs}, k = {k} -> {k_empty_slots(bulbs.clone(), k)}");
}

// A random order of the bulbs 1 to n.
fn shuffled(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        v.push(x);
    }
    let mut i = n - 1;
    while i > 0 {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        v.swap(i, j);
        i -= 1;
    }
    v
}

// The next order of `v` in lexicographic order, or false after the last.
fn next_order(v: mut ref Vec[i64]) -> bool {
    let n = v.len();
    let mut i = n - 2;
    while i >= 0 and v[i] >= v[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = n - 1;
    while v[j] <= v[i] {
        j -= 1;
    }
    v.swap(i, j);
    let mut a = i + 1;
    let mut b = n - 1;
    while a < b {
        v.swap(a, b);
        a += 1;
        b -= 1;
    }
    true
}

fn main() {
    show([1, 3, 2], 1);
    show([1, 2, 3], 1);
    show([6, 5, 8, 9, 7, 1, 10, 2, 3, 4], 2);
    show([1], 0);
    show([1, 2], 0);
    show([2, 1], 0);
    show([3, 1, 2], 1);
    show([1, 4, 2, 3], 2);
    show([5, 1, 4, 2, 3], 3);
    show([1, 5, 3, 2, 4], 3);
    show([4, 1, 3, 5, 2], 0);

    // Every order of 1 to 7 bulbs, for every k from 0 to n - 1.
    let mut found = 0;
    let mut never = 0;
    let mut sum = 0;
    for n in 1..8 {
        for k in 0..n {
            let mut v: Vec[i64] = Vec.new();
            for x in 1..n + 1 {
                v.push(x);
            }
            loop {
                let day = k_empty_slots(v.clone(), k);
                if day == -1 {
                    never += 1;
                } else {
                    found += 1;
                }
                sum = (sum * 31 + day + 2) % 1000000007;
                if not next_order(mut v) {
                    break;
                }
            }
        }
    }
    println(f"every order of 1 to 7 bulbs, every k: {found} with a day, {never} without, checksum {sum}");

    // Random orders of up to 1,000 bulbs.
    let mut seed = 683;
    let mut checksum = 0;
    let mut none = 0;
    for c in 0..200 {
        let n = 1 + next_random(mut seed) % 1000;
        let k = if c % 2 == 0 { next_random(mut seed) % 4 } else { next_random(mut seed) % n };
        let day = k_empty_slots(shuffled(mut seed, n), k);
        if day == -1 {
            none += 1;
        }
        checksum = (checksum * 31 + day + 2) % 1000000007;
    }
    println(f"200 random orders: {none} without a day, checksum {checksum}");
}
