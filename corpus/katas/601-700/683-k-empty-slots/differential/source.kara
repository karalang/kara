// LeetCode #683: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random orders of the bulbs.

// ---- star arm ----------------------------------------------------------

fn k_empty_slots_star(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut days: Vec[i64] = vec![0; n];
    for d in 0..n {
        days[bulbs[d] - 1] = d + 1;
    }
    let mut best = -1;
    let mut left = 0;
    let mut right = k + 1;
    let mut i = 1;
    while right < n {
        if i == right {
            let day = if days[left] > days[right] { days[left] } else { days[right] };
            if best == -1 or day < best {
                best = day;
            }
            left = right;
            right = left + k + 1;
            i = left + 1;
        } else if days[i] < days[left] or days[i] < days[right] {
            left = i;
            right = left + k + 1;
            i = left + 1;
        } else {
            i += 1;
        }
    }
    best
}

// ---- sorted arm --------------------------------------------------------

fn k_empty_slots_sorted(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut on: SortedSet[i64] = SortedSet.new();
    for d in 0..n {
        let x = bulbs[d];
        on.insert(x);
        if let Some(below) = on.range(1, x).last() {
            if x - *below == k + 1 {
                return d + 1;
            }
        }
        if let Some(above) = on.range(x + 1, n + 1).next() {
            if *above - x == k + 1 {
                return d + 1;
            }
        }
    }
    -1
}

// ---- fenwick arm -------------------------------------------------------

fn add_fenwick(tree: mut ref Vec[i64], at: i64) {
    let mut i = at;
    while i < tree.len() {
        tree[i] += 1;
        i += i & (0 - i);
    }
}

// How many bulbs are on among positions 1 to `at`.
fn count_fenwick(tree: ref Vec[i64], at: i64) -> i64 {
    let mut i = at;
    let mut total = 0;
    while i > 0 {
        total += tree[i];
        i -= i & (0 - i);
    }
    total
}

// Whether bulbs `a` and `b`, a < b, are both on with none on between.
fn lone_pair_fenwick(tree: ref Vec[i64], a: i64, b: i64) -> bool {
    count_fenwick(tree, a) - count_fenwick(tree, a - 1) == 1
        and count_fenwick(tree, b) - count_fenwick(tree, b - 1) == 1
        and count_fenwick(tree, b - 1) - count_fenwick(tree, a) == 0
}

fn k_empty_slots_fenwick(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut tree: Vec[i64] = vec![0; n + 1];
    for d in 0..n {
        let x = bulbs[d];
        add_fenwick(mut tree, x);
        if x - k - 1 >= 1 and lone_pair_fenwick(tree, x - k - 1, x) {
            return d + 1;
        }
        if x + k + 1 <= n and lone_pair_fenwick(tree, x, x + k + 1) {
            return d + 1;
        }
    }
    -1
}

// ---- deque arm ---------------------------------------------------------

fn k_empty_slots_deque(bulbs: Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut days: Vec[i64] = vec![0; n];
    for d in 0..n {
        days[bulbs[d] - 1] = d + 1;
    }
    let mut best = -1;
    let mut window: VecDeque[i64] = VecDeque.new();
    // The window holds positions i + 1 to i + k; when k is 0 it is
    // empty and the inside is vacuously later than both ends.
    for i in 0..n - k - 1 {
        if i == 0 {
            for p in 1..k + 1 {
                while not window.is_empty() and days[*window.back().unwrap()] >= days[p] {
                    window.pop_back();
                }
                window.push_back(p);
            }
        } else if k > 0 {
            if *window.front().unwrap() == i {
                window.pop_front();
            }
            let p = i + k;
            while not window.is_empty() and days[*window.back().unwrap()] >= days[p] {
                window.pop_back();
            }
            window.push_back(p);
        }
        let ends = if days[i] > days[i + k + 1] { days[i] } else { days[i + k + 1] };
        let inside = if window.is_empty() { n + 1 } else { days[*window.front().unwrap()] };
        if inside > ends and (best == -1 or ends < best) {
            best = ends;
        }
    }
    best
}

// ---- the definition and the properties ------------------------------------

fn answer(which: i64, bulbs: Vec[i64], k: i64) -> i64 {
    if which == 0 {
        k_empty_slots_star(bulbs, k)
    } else if which == 1 {
        k_empty_slots_sorted(bulbs, k)
    } else if which == 2 {
        k_empty_slots_fenwick(bulbs, k)
    } else {
        k_empty_slots_deque(bulbs, k)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn shuffled(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        v.push(x);
    }
    let mut i = n - 1;
    while i > 0 {
        let j = next_random(mut seed) % (i + 1);
        v.swap(i, j);
        i -= 1;
    }
    v
}

// The definition: turn the bulbs on one day at a time, and after each
// day look at every bulb that is on for one k + 1 to its right that is
// on too, with every bulb between them off.
fn definition(bulbs: ref Vec[i64], k: i64) -> i64 {
    let n = bulbs.len();
    let mut on: Vec[bool] = vec![false; n + 2];
    for d in 0..n {
        on[bulbs[d]] = true;
        for p in 1..n + 1 {
            let q = p + k + 1;
            if on[p] and q <= n and on[q] {
                let mut gap = true;
                for r in p + 1..q {
                    if on[r] {
                        gap = false;
                    }
                }
                if gap {
                    return d + 1;
                }
            }
        }
    }
    -1
}

fn mirrored(bulbs: ref Vec[i64]) -> Vec[i64] {
    let n = bulbs.len();
    bulbs.iter().map(|x| n + 1 - *x).collect()
}

// The same first `d` days, the rest in a new random order.
fn tail_shuffled(seed: mut ref i64, bulbs: ref Vec[i64], d: i64) -> Vec[i64] {
    let mut v = bulbs.clone();
    let n = v.len();
    let mut i = n - 1;
    while i > d {
        let j = d + next_random(mut seed) % (i - d + 1);
        v.swap(i, j);
        i -= 1;
    }
    v
}

// A random order whose first two bulbs are `a` and `a + k + 1`.
fn with_pair_first(seed: mut ref i64, n: i64, k: i64) -> Vec[i64] {
    let a = 1 + next_random(mut seed) % (n - k - 1);
    let mut v = shuffled(mut seed, n);
    let at_a = v.iter().position(|x| *x == a).unwrap();
    v.swap(0, at_a);
    let at_b = v.iter().position(|x| *x == a + k + 1).unwrap();
    v.swap(1, at_b);
    v
}

fn main() {
    let mut seed = 6830;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1500;
    let mut with_day = 0;
    for c in 0..cases {
        let n = if c % 3 == 2 { 2 + next_random(mut seed) % 300 } else { 1 + next_random(mut seed) % 12 };
        let k = if c % 2 == 0 { next_random(mut seed) % n } else { next_random(mut seed) % 3 };
        let bulbs = shuffled(mut seed, n);
        let want = if n <= 12 { definition(bulbs, k) } else { -2 };
        let flipped = mirrored(bulbs);
        let paired = if k + 1 < n { with_pair_first(mut seed, n, k) } else { Vec.new() };
        for which in 0..arms {
            let got = answer(which, bulbs.clone(), k);
            if which == 0 and got != -1 {
                with_day += 1;
            }
            // P1: the definition's answer, on up to 12 bulbs.
            if want != -2 {
                checks += 1;
                if got != want {
                    fails[0] += 1;
                }
            }
            // P2: the bulbs numbered from the other end.
            checks += 1;
            if answer(which, flipped.clone(), k) != got {
                fails[1] += 1;
            }
            // P3: the days after the answer, in any order, change nothing.
            if got != -1 {
                checks += 1;
                let tail = tail_shuffled(mut seed, bulbs, got);
                if answer(which, tail, k) != got {
                    fails[2] += 1;
                }
            }
            // P4: two bulbs k + 1 apart that come on first make day 2.
            if k + 1 < n {
                checks += 1;
                if answer(which, paired.clone(), k) != 2 {
                    fails[3] += 1;
                }
            }
        }
    }
    let mut report = String.new();
    let mut total = 0;
    for k in 0..4 {
        if fails[k] > 0 {
            report.push_str(f"P{k + 1}: {fails[k]} failures | ");
        }
        total += fails[k];
    }
    println(f"{report}{cases} orders ({with_day} with a day), {arms} arms, {checks} checks, {total} failures");
}
