// LeetCode #680: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random strings.

// ---- star arm ----------------------------------------------------------

fn is_palindrome_star(b: Slice[u8], lo: i64, hi: i64) -> bool {
    let mut i = lo;
    let mut j = hi;
    while i < j {
        if b[i] != b[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    true
}

fn valid_palindrome_star(s: String) -> bool {
    let b = s.bytes();
    let mut i = 0;
    let mut j = s.len() - 1;
    while i < j {
        if b[i] != b[j] {
            return is_palindrome_star(b, i + 1, j) or is_palindrome_star(b, i, j - 1);
        }
        i += 1;
        j -= 1;
    }
    true
}

// ---- budget arm --------------------------------------------------------

fn within_budget(b: Slice[u8], lo: i64, hi: i64, budget: i64) -> bool {
    let mut i = lo;
    let mut j = hi;
    while i < j {
        if b[i] != b[j] {
            if budget == 0 {
                return false;
            }
            return within_budget(b, i + 1, j, budget - 1)
                or within_budget(b, i, j - 1, budget - 1);
        }
        i += 1;
        j -= 1;
    }
    true
}

fn valid_palindrome_budget(s: String) -> bool {
    within_budget(s.bytes(), 0, s.len() - 1, 1)
}

// ---- banded arm --------------------------------------------------------

fn valid_palindrome_banded(s: String) -> bool {
    let b = s.bytes();
    let n = s.len();
    let far = 3;
    // prev[k + 2] is the distance from the first i bytes of the string
    // to the first i + k bytes of its reverse.
    let mut prev: Vec[i64] = vec![far; 5];
    for k in 0..3 {
        if k <= n {
            prev[k + 2] = k;
        }
    }
    for i in 1..n + 1 {
        let mut cur: Vec[i64] = vec![far; 5];
        for k in -2..3 {
            let j = i + k;
            if j < 0 or j > n {
                continue;
            }
            let mut d = far;
            if j == 0 {
                d = i;
            } else if b[i - 1] == b[n - j] {
                d = prev[k + 2];
            } else {
                if k < 2 {
                    d = prev[k + 3] + 1;
                }
                if k > -2 and cur[k + 1] + 1 < d {
                    d = cur[k + 1] + 1;
                }
            }
            if d > far {
                d = far;
            }
            cur[k + 2] = d;
        }
        prev = cur;
    }
    prev[2] <= 2
}

// ---- hashes arm --------------------------------------------------------

fn modulus_hashes() -> i64 {
    1000000007
}

// The hash of `h[a..b]`, from `h[k]`, the hash of the first k bytes.
fn part_hashes(h: ref Vec[i64], pw: ref Vec[i64], a: i64, b: i64) -> i64 {
    let p = modulus_hashes();
    ((h[b] - h[a] * pw[b - a] % p) % p + p) % p
}

// Whether the bytes with position `skip` left out read the same both
// ways; `skip` may be `n`, leaving nothing out.
fn palindrome_without_hashes(b: Slice[u8], n: i64, skip: i64) -> bool {
    let mut i = 0;
    let mut j = n - 1;
    loop {
        if i == skip {
            i += 1;
        }
        if j == skip {
            j -= 1;
        }
        if i >= j {
            return true;
        }
        if b[i] != b[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
}

fn valid_palindrome_hashes(s: String) -> bool {
    let p = modulus_hashes();
    let base = 131;
    let b = s.bytes();
    let n = s.len();
    let mut pw: Vec[i64] = vec![1; n + 1];
    let mut fwd: Vec[i64] = vec![0; n + 1];
    let mut bwd: Vec[i64] = vec![0; n + 1];
    for k in 0..n {
        pw[k + 1] = pw[k] * base % p;
        fwd[k + 1] = (fwd[k] * base + b[k] as i64) % p;
        bwd[k + 1] = (bwd[k] * base + b[n - 1 - k] as i64) % p;
    }
    if fwd[n] == bwd[n] and palindrome_without_hashes(b, n, n) {
        return true;
    }
    for k in 0..n {
        // The string without position k, and that string reversed: the
        // reverse's first n - 1 - k bytes, then its last k.
        let there = (part_hashes(fwd, pw, 0, k) * pw[n - 1 - k]
            + part_hashes(fwd, pw, k + 1, n)) % p;
        let back = (part_hashes(bwd, pw, 0, n - 1 - k) * pw[k]
            + part_hashes(bwd, pw, n - k, n)) % p;
        if there == back and palindrome_without_hashes(b, n, k) {
            return true;
        }
    }
    false
}

// ---- the definition and the properties ------------------------------------

fn answer(which: i64, s: String) -> bool {
    if which == 0 {
        valid_palindrome_star(s)
    } else if which == 1 {
        valid_palindrome_budget(s)
    } else if which == 2 {
        valid_palindrome_banded(s)
    } else {
        valid_palindrome_hashes(s)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letter(d: i64) -> char {
    (97 + d) as u8 as char
}

fn reversed(s: String) -> String {
    s.chars().rev().collect()
}

// The definition: the string itself, or the string with one of its
// characters removed, equals its own reverse.
fn definition(s: String) -> bool {
    if reversed(s) == s {
        return true;
    }
    let cs: Vec[char] = s.chars().collect();
    for skip in 0..cs.len() {
        let mut t = String.new();
        for k in 0..cs.len() {
            if k != skip {
                t.push(cs[k]);
            }
        }
        if reversed(t) == t {
            return true;
        }
    }
    false
}

fn random_string(seed: mut ref i64, n: i64, width: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(letter(next_random(seed) % width));
    }
    s
}

// A random palindrome of length n over the first `width` letters.
fn palindrome(seed: mut ref i64, n: i64, width: i64) -> String {
    let half = random_string(seed, n / 2, width);
    let mut s = half.clone();
    if n % 2 == 1 {
        s.push(letter(next_random(seed) % width));
    }
    s.push_str(reversed(half));
    s
}

// `s` with `c` inserted before its `at`-th character.
fn inserted(s: String, at: i64, c: char) -> String {
    let mut t = String.new();
    let mut k = 0;
    for x in s.chars() {
        if k == at {
            t.push(c);
        }
        t.push(x);
        k += 1;
    }
    if at >= k {
        t.push(c);
    }
    t
}

fn main() {
    let mut seed = 6800;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 2000;
    let mut defined_valid = 0;
    for c in 0..cases {
        let n = 1 + next_random(mut seed) % 30;
        let width = 1 + next_random(mut seed) % 3;
        // Half the strings start from a palindrome with up to two letters
        // inserted, since random strings are rarely valid.
        let s = if c % 2 == 0 {
            random_string(mut seed, n, width)
        } else {
            let mut t = palindrome(mut seed, n, width);
            let extra = next_random(mut seed) % 3;
            for _ in 0..extra {
                let at = next_random(mut seed) % (t.len() + 1);
                t = inserted(t, at, letter(next_random(mut seed) % width));
            }
            t
        };
        let want = definition(s);
        if want {
            defined_valid += 1;
        }
        let r = reversed(s);
        let wrap = letter(next_random(mut seed) % 4);
        let mut wrapped = String.new();
        wrapped.push(wrap);
        wrapped.push_str(s);
        wrapped.push(wrap);
        let p = palindrome(mut seed, n, width);
        let at = next_random(mut seed) % (p.len() + 1);
        let one = inserted(p, at, letter(next_random(mut seed) % 4));
        for which in 0..arms {
            let got = answer(which, s);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the reverse answers the same.
            checks += 1;
            if answer(which, r) != got {
                fails[1] += 1;
            }
            // P3: one letter inserted anywhere into a palindrome is valid.
            checks += 1;
            if not answer(which, one) {
                fails[2] += 1;
            }
            // P4: the same letter added at both ends changes nothing.
            checks += 1;
            if answer(which, wrapped) != got {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut total = 0;
    for k in 0..4 {
        if fails[k] > 0 {
            report.push_str(f"P{k + 1}: {fails[k]} failures | ");
        }
        total += fails[k];
    }
    println(f"{report}{cases} strings ({defined_valid} valid by the definition), {arms} arms, {checks} checks, {total} failures");
}
