// LeetCode #670: Maximum Swap -- the last place of each digit.
//
// The best swap raises the leftmost digit that can be raised, and raises
// it as far as it can: to the largest digit anywhere to its right. If
// that digit appears more than once, take its last copy, so the digit
// moved down lands as far right as it can. Note each digit's last place,
// then for each position from the left, look from 9 down for a larger
// digit placed later. O(digits * 10).

fn digits_of(num: i64) -> Vec[i64] {
    let mut d: Vec[i64] = Vec.new();
    let mut x = num;
    while x > 0 {
        d.push(x % 10);
        x /= 10;
    }
    if d.is_empty() {
        d.push(0);
    }
    d.reverse();
    d
}

fn number_of(d: Vec[i64]) -> i64 {
    let mut x = 0;
    for v in d.iter() {
        x = x * 10 + v;
    }
    x
}

fn maximum_swap(num: i64) -> i64 {
    let mut d = digits_of(num);
    let mut last = vec![-1; 10];
    for i in 0..d.len() {
        last[d[i]] = i;
    }
    for i in 0..d.len() {
        let mut v = 9;
        while v > d[i] {
            if last[v] > i {
                let j = last[v];
                d[j] = d[i];
                d[i] = v;
                return number_of(d);
            }
            v -= 1;
        }
    }
    num
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // The two LeetCode examples; zero; one digit; numbers already at
    // their best; a swap with the last copy of a repeated digit; a zero
    // that must not move up front; the problem's largest, 100,000,000.
    let nums = [2736, 9973, 0, 7, 10, 98368, 1993, 109090, 99901, 115, 4321,
                1234, 120, 12345678, 87654321, 98765432, 100000000, 99999999];
    for n in nums.iter() {
        println(f"{n}: {maximum_swap(n)}");
    }
    // Every number below 100,000: how many a swap raises, with a checksum.
    let mut raised = 0;
    let mut sum = 0;
    for n in 0..100000 {
        let m = maximum_swap(n);
        if m != n {
            raised += 1;
        }
        sum = (sum * 31 + m) % 1000000007;
    }
    println(f"0 to 99999: {raised} raised, checksum {sum}");
    // 10,000 random numbers up to 100,000,000, into a checksum.
    let mut seed: i64 = 670;
    sum = 0;
    for _ in 0..10000 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000001;
        sum = (sum * 31 + maximum_swap(n)) % 1000000007;
    }
    println(f"10000 random: checksum {sum}");
}
