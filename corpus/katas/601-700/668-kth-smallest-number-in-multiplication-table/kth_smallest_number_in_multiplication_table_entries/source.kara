// LeetCode #668: Kth Smallest Number in Multiplication Table -- binary
// search that lands on table entries.
//
// Count the entries at most `x` by rows, and note the largest of them,
// `i * min(x / i, n)` over the rows. When the count reaches `k`, the
// answer is at most that entry, so the top of the range drops straight
// to it rather than to `x`; otherwise the bottom rises past `x`. The
// range's top is always a table entry, and the search stops when the
// bottom meets it. O(m log(m n)).

fn find_kth_number(m: i64, n: i64, k: i64) -> i64 {
    let mut lo = 1;
    let mut hi = m * n;
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        let mut count = 0;
        let mut largest = 0;
        for i in 1..m + 1 {
            let c = (mid / i).min(n);
            count += c;
            largest = largest.max(i * c);
        }
        if count >= k {
            hi = largest;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(m: i64, n: i64, k: i64) {
    println(f"m={m} n={n} k={k}: {find_kth_number(m, n, k)}");
}

fn main() {
    // The two LeetCode examples.
    show(3, 3, 5);
    show(2, 3, 6);
    // One cell; the first and the last entry; one row; one column; a
    // tall table and a wide one; the middle of a 12 by 12 table.
    show(1, 1, 1);
    show(4, 5, 1);
    show(4, 5, 20);
    show(1, 9, 7);
    show(9, 1, 7);
    show(20, 3, 31);
    show(3, 20, 31);
    show(12, 12, 72);
    // The problem's largest table, 30,000 by 30,000: the first entry,
    // the middle one, the last, and a few between.
    show(30000, 30000, 1);
    show(30000, 30000, 450000000);
    show(30000, 30000, 900000000);
    show(30000, 30000, 123456789);
    show(30000, 17, 400000);
    show(17, 30000, 400000);
    // Every k of a 6 by 7 table, in order.
    let mut parts: Vec[String] = Vec.new();
    for k in 1..43 {
        parts.push(f"{find_kth_number(6, 7, k)}");
    }
    println(f"6 by 7: {parts.join(",")}");
    // 1,000 random tables of 1 to 40 by 1 to 40, each with a random k,
    // into a checksum.
    let mut seed: i64 = 668;
    let mut sum = 0;
    for _ in 0..1000 {
        let m = 1 + next_random(mut seed) % 40;
        let n = 1 + next_random(mut seed) % 40;
        let k = 1 + next_random(mut seed) % (m * n);
        sum = (sum * 31 + find_kth_number(m, n, k)) % 1000000007;
    }
    println(f"1000 random tables: checksum {sum}");
}
