// Benchmark for #649: the ★ arm (a queue for each party) on a large
// workload.

fn predict_party_victory(senate: String) -> String {
    let bytes = senate.bytes();
    let n = bytes.len();
    let mut radiant: VecDeque[i64] = VecDeque.new();
    let mut dire: VecDeque[i64] = VecDeque.new();
    for i in 0..n {
        if bytes[i] == b'R' {
            radiant.push_back(i);
        } else {
            dire.push_back(i);
        }
    }
    while radiant.len() > 0 and dire.len() > 0 {
        let r = radiant.pop_front().unwrap();
        let d = dire.pop_front().unwrap();
        if r < d {
            radiant.push_back(r + n);
        } else {
            dire.push_back(d + n);
        }
    }
    if radiant.len() > 0 { "Radiant".to_string() } else { "Dire".to_string() }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 senates of 100,000 senators, each Radiant with a chance from 45
    // to 55 percent, the chance picked for each senate, made once; then
    // 500 times predicts one of them, picked by the round, counting the
    // Radiant wins and putting each winner into a checksum.
    let inputs = 20;
    let rounds = 500;
    let mut seed: i64 = 649;
    let mut senates: Vec[String] = Vec.new();
    for _ in 0..inputs {
        let radiant = 45 + next_random(mut seed) % 11;
        let mut s = String.new();
        for _ in 0..100000 {
            s.push(if next_random(mut seed) % 100 < radiant { 'R' } else { 'D' });
        }
        senates.push(s);
    }
    let mut wins = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let won = predict_party_victory(senates[(r * 7) % inputs]) == "Radiant";
        if won {
            wins += 1;
        }
        checksum = (checksum * 2 + if won { 1 } else { 0 }) % 1000000007;
    }
    println(f"{inputs} senates, {rounds} rounds: Radiant wins {wins}, checksum {checksum}");
}
