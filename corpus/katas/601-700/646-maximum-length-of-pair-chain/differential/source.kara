// LeetCode #646: differential -- the four arms against the definition.
//
// Copies of the four arms, held to five properties on random cases.

// ---- star arm ----------------------------------------------------------

fn find_longest_chain_star(pairs: Vec[Vec[i64]]) -> i64 {
    let mut order = pairs.clone();
    order.sort_by(|a, b| a[1].cmp(b[1]));
    let mut count = 0;
    let mut end = 0;
    for p in order.iter() {
        if count == 0 or p[0] > end {
            count += 1;
            end = p[1];
        }
    }
    count
}

// ---- dp arm ------------------------------------------------------------

fn find_longest_chain_dp(pairs: Vec[Vec[i64]]) -> i64 {
    let mut order = pairs.clone();
    order.sort_by(|a, b| a[0].cmp(b[0]));
    let n = order.len();
    let mut longest = vec![1; n];
    let mut best = 0;
    for i in 0..n {
        for j in 0..i {
            if order[j][1] < order[i][0] and longest[j] + 1 > longest[i] {
                longest[i] = longest[j] + 1;
            }
        }
        if longest[i] > best {
            best = longest[i];
        }
    }
    best
}

// ---- tails arm ---------------------------------------------------------

fn find_longest_chain_tails(pairs: Vec[Vec[i64]]) -> i64 {
    let mut order = pairs.clone();
    order.sort_by(|a, b| a[0].cmp(b[0]));
    let mut tails: Vec[i64] = Vec.new();
    for p in order.iter() {
        // The number of chain lengths whose smallest end is below p[0].
        let mut lo = 0;
        let mut hi = tails.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if tails[mid] < p[0] {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo == tails.len() {
            tails.push(p[1]);
        } else if p[1] < tails[lo] {
            tails[lo] = p[1];
        }
    }
    tails.len()
}

// ---- swap arm ----------------------------------------------------------

fn find_longest_chain_swap(pairs: Vec[Vec[i64]]) -> i64 {
    let mut order = pairs.clone();
    order.sort_by(|a, b| a[0].cmp(b[0]));
    let mut count = 0;
    let mut end = 0;
    for p in order.iter() {
        if count == 0 or p[0] > end {
            count += 1;
            end = p[1];
        } else if p[1] < end {
            end = p[1];
        }
    }
    count
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, pairs: Vec[Vec[i64]]) -> i64 {
    if which == 0 {
        find_longest_chain_star(pairs)
    } else if which == 1 {
        find_longest_chain_dp(pairs)
    } else if which == 2 {
        find_longest_chain_tails(pairs)
    } else {
        find_longest_chain_swap(pairs)
    }
}

// The definition: every set of pairs tried, a set being a chain when,
// taken by left end, each pair ends before the next one starts.
fn definition(pairs: Vec[Vec[i64]]) -> i64 {
    let n = pairs.len();
    let mut best = 0;
    for mask in 1..(1 << n) {
        let mut chosen: Vec[Vec[i64]] = Vec.new();
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                chosen.push(pairs[i].clone());
            }
        }
        chosen.sort_by(|a, b| a[0].cmp(b[0]));
        let mut chain = true;
        for i in 1..chosen.len() {
            if chosen[i - 1][1] >= chosen[i][0] {
                chain = false;
            }
        }
        if chain and chosen.len() > best {
            best = chosen.len();
        }
    }
    best
}

// `count` pairs, each starting from -15 to 14 and covering 1 to 8 more
// values.
fn random_pairs(count: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let left = -15 + next_random(mut seed) % 30;
        let right = left + 1 + next_random(mut seed) % 8;
        pairs.push(vec![left, right]);
    }
    pairs
}

fn main() {
    let count_cases = 1000;
    let mut seed: i64 = 6460;
    let mut checks = 0;
    let mut values = 0;
    let mut failures = vec![0; 5];
    for _ in 0..count_cases {
        // 1 to 10 pairs.
        let n = 1 + next_random(mut seed) % 10;
        let pairs = random_pairs(n, mut seed);
        values += n;
        let mut reversed: Vec[Vec[i64]] = Vec.new();
        let mut mirrored: Vec[Vec[i64]] = Vec.new();
        let mut last = pairs[0][1];
        for i in 0..n {
            reversed.push(pairs[n - 1 - i].clone());
            mirrored.push(vec![-pairs[i][1], -pairs[i][0]]);
            if pairs[i][1] > last {
                last = pairs[i][1];
            }
        }
        let mut longer = pairs.clone();
        longer.push(vec![last + 1, last + 2]);
        let want = definition(pairs);
        for which in 0..4 {
            let got = answer(which, pairs);
            let ok = vec![
                // P1: the definition's answer.
                got == want,
                // P2: at least one pair and at most all of them.
                got >= 1 and got <= n,
                // P3: the pairs in reverse give the same answer.
                answer(which, reversed) == got,
                // P4: every pair `[a, b]` turned into `[-b, -a]` gives the
                // same answer.
                answer(which, mirrored) == got,
                // P5: a pair starting after every other one ends adds
                // exactly one.
                answer(which, longer) == got + 1,
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                }
            }
        }
    }
    let all = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count_cases} cases ({values} pairs), 4 arms, {checks} checks, {all} failures");
    if all > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
