// LeetCode #646: Maximum Length of Pair Chain -- longest chain ending at
// each pair.
//
// Take the pairs by left end. The longest chain ending at a pair is one
// more than the longest ending at any earlier pair whose right end is
// below this pair's left end, or 1 if there is none; a pair that can come
// before another starts before it, so it is always earlier. O(n^2).

fn find_longest_chain(pairs: Vec[Vec[i64]]) -> i64 {
    let mut order = pairs.clone();
    order.sort_by(|a, b| a[0].cmp(b[0]));
    let n = order.len();
    let mut longest = vec![1; n];
    let mut best = 0;
    for i in 0..n {
        for j in 0..i {
            if order[j][1] < order[i][0] and longest[j] + 1 > longest[i] {
                longest[i] = longest[j] + 1;
            }
        }
        if longest[i] > best {
            best = longest[i];
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(pairs: Vec[Vec[i64]]) {
    println(f"{pairs} -> {find_longest_chain(pairs)}");
}

// `count` pairs, each starting from `low` to `high - 1` and covering 1 to
// `longest` more values.
fn random_pairs(count: i64, low: i64, high: i64, longest: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let left = low + next_random(mut seed) % (high - low);
        let right = left + 1 + next_random(mut seed) % longest;
        pairs.push(vec![left, right]);
    }
    pairs
}

fn main() {
    // The two LeetCode examples.
    show(vec![vec![1, 2], vec![2, 3], vec![3, 4]]);
    show(vec![vec![1, 2], vec![7, 8], vec![4, 5]]);
    // One pair; the same pair three times; a long pair that starts first
    // but blocks two short ones; a long pair that ends last; negative
    // values out of order; pairs that only touch; the extremes.
    show(vec![vec![-1000, 1000]]);
    show(vec![vec![3, 4], vec![3, 4], vec![3, 4]]);
    show(vec![vec![1, 100], vec![2, 3], vec![4, 5]]);
    show(vec![vec![2, 3], vec![4, 5], vec![1, 100], vec![6, 7]]);
    show(vec![vec![1, 2], vec![-4, 0], vec![-10, -5], vec![-3, -2]]);
    show(vec![vec![5, 6], vec![4, 5], vec![3, 4], vec![2, 3], vec![1, 2]]);
    show(vec![vec![-1000, -999], vec![999, 1000], vec![-999, 999]]);
    // 300 random cases of 1 to 30 pairs starting from -50 to 49 and
    // covering 1 to 20 more values.
    let mut seed: i64 = 646;
    let mut sum = 0;
    let mut checksum = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let c = find_longest_chain(random_pairs(n, -50, 50, 20, mut seed));
        sum += c;
        checksum = (checksum * 31 + c) % 1000000007;
    }
    println(f"300 random cases: total {sum}, checksum {checksum}");
    // The problem's largest: 1,000 pairs over -1,000 to 1,000, long and
    // short.
    println(f"1000 pairs: {find_longest_chain(random_pairs(1000, -1000, 900, 100, mut seed))}");
    println(f"1000 short pairs: {find_longest_chain(random_pairs(1000, -1000, 997, 3, mut seed))}");
}
