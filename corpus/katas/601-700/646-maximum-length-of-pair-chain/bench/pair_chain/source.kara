// Benchmark for #646: the ★ arm (earliest end first) on a large
// workload.

fn find_longest_chain(pairs: Vec[Vec[i64]]) -> i64 {
    let mut order = pairs.clone();
    order.sort_by(|a, b| a[1].cmp(b[1]));
    let mut count = 0;
    let mut end = 0;
    for p in order.iter() {
        if count == 0 or p[0] > end {
            count += 1;
            end = p[1];
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 inputs of 10,000 pairs, each starting from 0 to 29,999 and
    // covering 1 to a random longest from 10 to 1,000 more values, made
    // once; then 200 times answers one of them, picked by the round,
    // adding up the answers and putting each into a checksum.
    let inputs = 20;
    let rounds = 200;
    let mut seed: i64 = 646;
    let mut all: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..inputs {
        let longest = 10 + next_random(mut seed) % 991;
        let mut pairs: Vec[Vec[i64]] = Vec.new();
        for _ in 0..10000 {
            let left = next_random(mut seed) % 30000;
            let right = left + 1 + next_random(mut seed) % longest;
            pairs.push(vec![left, right]);
        }
        all.push(pairs);
    }
    let mut sum = 0;
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let c = find_longest_chain(all[(r * 7) % inputs]);
        sum += c;
        checksum = (checksum * 31 + c) % 1000000007;
    }
    println(f"{inputs} inputs, {rounds} rounds: total {sum}, checksum {checksum}");
}
