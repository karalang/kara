// LeetCode #700: Search in a Binary Search Tree -- bench program for the
// loop arm.
//
// 10 binary search trees of 50,000 nodes are built once, each from 0 to
// 99,998 in steps of two inserted in its own random order; then in each
// of 5 rounds every tree is searched for the same 40,000 random values
// from 0 to 99,999, about half of which are in it, and every value found
// goes into a checksum.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn search_bst(root: Option[TreeNode], val: i64) -> Option[TreeNode] {
    let mut at = root;
    loop {
        match at {
            None => return None,
            Some(n) => {
                if val == n.val {
                    return Some(n);
                }
                at = if val < n.val { n.left } else { n.right };
            }
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn insert(root: TreeNode, v: i64) {
    let mut at = root;
    loop {
        if v < at.val {
            match at.left {
                Some(l) => at = l,
                None => {
                    at.left = Some(leaf(v));
                    return;
                }
            }
        } else {
            match at.right {
                Some(r) => at = r,
                None => {
                    at.right = Some(leaf(v));
                    return;
                }
            }
        }
    }
}

fn main() {
    let mut seed = 700;
    let n = 50000;
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    for _ in 0..10 {
        let mut values: Vec[i64] = Vec.new();
        for i in 0..n {
            values.push(2 * i);
        }
        for i in 1..n {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            let t = values[i];
            values[i] = values[j];
            values[j] = t;
        }
        let root = leaf(values[0]);
        for i in 1..n {
            insert(root, values[i]);
        }
        trees.push(Some(root));
    }
    let mut queries: Vec[i64] = Vec.new();
    let searches = 40000;
    for _ in 0..searches {
        queries.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * n));
    }
    let rounds = 5;
    let mut found = 0;
    let mut checksum = 0;
    for _ in 0..rounds {
        for root in trees.iter() {
            for q in queries.iter() {
                if let Some(hit) = search_bst(root, *q) {
                    found += 1;
                    checksum = (checksum * 31 + hit.val) % 1000000007;
                }
            }
        }
    }
    println(f"{rounds} rounds of 10 trees of {n}, {searches} searches each: {found} found, checksum {checksum}");
}
