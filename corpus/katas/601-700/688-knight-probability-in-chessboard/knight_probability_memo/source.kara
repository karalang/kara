// LeetCode #688: Knight Probability in Chessboard -- recursion with a memo.
//
// The chance of staying on the board for s more moves from a square is
// the average, over the eight moves, of the chance from where each one
// lands: 0 off the board, 1 once no moves are left. Recurse from the
// start square, keeping each (moves left, square) answer the first time
// it is worked out, so only squares the knight can reach are visited.
// O(k x n^2) time and space, O(k) stack.

fn knight_probability(n: i64, k: i64, row: i64, column: i64) -> f64 {
    let mut memo: Vec[f64] = vec![-1.0; (k + 1) * n * n];
    chance(n, k, row, column, mut memo)
}

fn chance(n: i64, left: i64, r: i64, c: i64, memo: mut ref Vec[f64]) -> f64 {
    if r < 0 or r >= n or c < 0 or c >= n {
        return 0.0;
    }
    if left == 0 {
        return 1.0;
    }
    let at = (left * n + r) * n + c;
    if memo[at] >= 0.0 {
        return memo[at];
    }
    let sum = chance(n, left - 1, r + 2, c + 1, mut memo)
        + chance(n, left - 1, r + 1, c + 2, mut memo)
        + chance(n, left - 1, r - 1, c + 2, mut memo)
        + chance(n, left - 1, r - 2, c + 1, mut memo)
        + chance(n, left - 1, r - 2, c - 1, mut memo)
        + chance(n, left - 1, r - 1, c - 2, mut memo)
        + chance(n, left - 1, r + 1, c - 2, mut memo)
        + chance(n, left - 1, r + 2, c - 1, mut memo);
    memo[at] = sum / 8.0;
    sum / 8.0
}

// ---- harness ---------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64, k: i64, row: i64, column: i64) {
    println(f"n = {n}, k = {k}, start ({row}, {column}): {knight_probability(n, k, row, column):.5}");
}

fn main() {
    // The two LeetCode examples.
    show(3, 2, 0, 0);
    show(1, 0, 0, 0);
    // A board too small for any move, the 3 x 3 centre that no move
    // leaves from, no moves at all, a square all eight moves stay on,
    // and long walks on the largest board, from its centre and a corner.
    show(1, 1, 0, 0);
    show(2, 3, 1, 0);
    show(3, 1, 1, 1);
    show(8, 0, 7, 7);
    show(8, 1, 3, 4);
    show(8, 30, 0, 0);
    show(25, 100, 12, 12);
    show(25, 100, 0, 0);
    show(25, 100, 24, 13);

    // From a corner of 3 x 3, every square but the centre has exactly two
    // moves on the board, so k moves stay on with chance 1 / 4^k; times
    // 4^k, that is 1 whatever k is.
    let mut line = String.new();
    for k in [1, 10, 50, 100] {
        let mut scale = 1.0;
        for _ in 0..k {
            scale *= 4.0;
        }
        if k != 1 {
            line.push_str(",");
        }
        line.push_str(f" k = {k}: {knight_probability(3, k, 0, 2) * scale:.5}");
    }
    println(f"3 x 3 from a corner, times 4^k:{line}");

    // Every start on every board of 1 to 8 squares a side, 0 to 6 moves.
    let mut queries = 0;
    let mut zeros = 0;
    let mut ones = 0;
    let mut sum = 0.0;
    for n in 1..9 {
        for k in 0..7 {
            for r in 0..n {
                for c in 0..n {
                    let p = knight_probability(n, k, r, c);
                    queries += 1;
                    if p == 0.0 {
                        zeros += 1;
                    }
                    if p == 1.0 {
                        ones += 1;
                    }
                    sum += p;
                }
            }
        }
    }
    println(f"{queries} small queries: {zeros} certain to fall off, {ones} certain to stay, sum {sum:.5}");

    // Every start on a 12 x 12 board, 20 moves.
    let mut low = 1.0;
    let mut high = 0.0;
    let mut total = 0.0;
    for r in 0..12 {
        for c in 0..12 {
            let p = knight_probability(12, 20, r, c);
            low = low.min(p);
            high = high.max(p);
            total += p;
        }
    }
    println(f"12 x 12, 20 moves, every start: lowest {low:.5}, highest {high:.5}, sum {total:.5}");

    // 200 random queries up to the largest board and 50 moves.
    let mut seed = 688;
    let mut checksum = 0.0;
    for _ in 0..200 {
        let n = 1 + next_random(mut seed) % 25;
        let k = next_random(mut seed) % 51;
        let r = next_random(mut seed) % n;
        let c = next_random(mut seed) % n;
        checksum += knight_probability(n, k, r, c);
    }
    println(f"200 random queries: sum {checksum:.5}");
}
