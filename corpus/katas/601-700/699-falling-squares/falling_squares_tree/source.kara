// LeetCode #699: Falling Squares -- a segment tree over compressed cells.
//
// The cells are the gaps between sorted distinct edges, as in the cells
// arm, held in a segment tree that answers the highest cell in a range
// and sets a range to one height. A setting is left at the highest node
// that covers it whole and pushed down only when a query or a later
// setting needs to look inside. O(n log n) time, O(n) space.

struct Tree {
    best: Vec[i64],
    pending: Vec[i64],
}

impl Tree {
    fn push_down(mut ref self, node: i64) {
        let p = self.pending[node];
        if p >= 0 {
            for child in [2 * node, 2 * node + 1] {
                self.best[child] = p;
                self.pending[child] = p;
            }
            self.pending[node] = -1;
        }
    }

    // The highest cell in [from, to); the node covers [lo, hi).
    fn query(mut ref self, node: i64, lo: i64, hi: i64, from: i64, to: i64) -> i64 {
        if to <= lo or hi <= from {
            return 0;
        }
        if from <= lo and hi <= to {
            return self.best[node];
        }
        self.push_down(node);
        let mid = (lo + hi) / 2;
        self.query(2 * node, lo, mid, from, to).max(self.query(2 * node + 1, mid, hi, from, to))
    }

    // Every cell in [from, to) set to h.
    fn set(mut ref self, node: i64, lo: i64, hi: i64, from: i64, to: i64, h: i64) {
        if to <= lo or hi <= from {
            return;
        }
        if from <= lo and hi <= to {
            self.best[node] = h;
            self.pending[node] = h;
            return;
        }
        self.push_down(node);
        let mid = (lo + hi) / 2;
        self.set(2 * node, lo, mid, from, to, h);
        self.set(2 * node + 1, mid, hi, from, to, h);
        self.best[node] = self.best[2 * node].max(self.best[2 * node + 1]);
    }
}

fn falling_squares(positions: Vec[(i64, i64)]) -> Vec[i64] {
    let mut edges: Vec[i64] = Vec.new();
    for (left, side) in positions.iter() {
        edges.push(left);
        edges.push(left + side);
    }
    edges.sort();
    edges.dedup();
    let cells = edges.len();
    let mut tree = Tree { best: vec![0; 4 * cells], pending: vec![-1; 4 * cells] };
    let mut answer: Vec[i64] = Vec.new();
    for (left, side) in positions.iter() {
        let from = edges.binary_search(left).unwrap();
        let to = edges.binary_search(left + side).unwrap();
        let top = tree.query(1, 0, cells, from, to) + side;
        tree.set(1, 0, cells, from, to, top);
        answer.push(tree.best[1]);
    }
    answer
}

// ---- harness ---------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(heights: Vec[i64]) -> String {
    let mut s = String.from("[");
    for i in 0..heights.len() {
        if i > 0 {
            s.push_str(", ");
        }
        s.push_str(f"{heights[i]}");
    }
    s.push_str("]");
    s
}

fn main() {
    // The two LeetCode examples.
    println(f"example 1: {show(falling_squares(vec![(1, 2), (2, 3), (6, 1)]))}");
    println(f"example 2: {show(falling_squares(vec![(100, 100), (200, 100)]))}");
    // One square; squares that only touch at an edge; four on one spot;
    // a wide square over two towers, then a narrow one in the gap.
    println(f"one: {show(falling_squares(vec![(5, 7)]))}");
    println(f"touching: {show(falling_squares(vec![(1, 2), (3, 2), (5, 2), (0, 1)]))}");
    println(f"stacked: {show(falling_squares(vec![(5, 3), (5, 3), (5, 3), (5, 3)]))}");
    println(f"bridge: {show(falling_squares(vec![(1, 2), (9, 5), (0, 20), (4, 1), (19, 1), (20, 1)]))}");
    // Near the largest coordinates the problem allows: a stair of 1,000
    // squares of 100,000, each overlapping the last by one, and 1,000 of
    // the largest side, 1,000,000, side by side down from 100,000,000.
    let mut stair: Vec[(i64, i64)] = Vec.new();
    let mut row: Vec[(i64, i64)] = Vec.new();
    for i in 0..1000 {
        stair.push((1 + i * 99999, 100000));
        row.push((100000000 - i * 1000000, 1000000));
    }
    let a = falling_squares(stair);
    let b = falling_squares(row);
    println(f"stair of 1000: last {a[999]}, row of 1000: last {b[999]}");
    // 40 random problems of up to 1,000 squares, some packed into a short
    // stretch and some spread out, with a checksum of every answer.
    let mut seed = 699;
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..40 {
        let n = 1 + next_random(mut seed) % 1000;
        let width = 1 + next_random(mut seed) % 2000 * (1 + next_random(mut seed) % 50000);
        let biggest = 1 + next_random(mut seed) % 1000;
        let mut positions: Vec[(i64, i64)] = Vec.new();
        for _ in 0..n {
            let left = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % width;
            let side = 1 + next_random(mut seed) % biggest;
            positions.push((left, side));
        }
        let heights = falling_squares(positions);
        for h in heights.iter() {
            total += *h;
            checksum = (checksum * 31 + *h) % 1000000007;
        }
    }
    println(f"40 random problems: heights sum to {total}, checksum {checksum}");
}
