// LeetCode #655: Print Binary Tree -- level by level from a queue.
//
// The same grid and the same places, found breadth first: a `VecDeque`
// holds each node with its row and column, and taking one off fills its
// cell and puts its children on with theirs. O(rows * columns) for the
// grid, O(nodes) to fill it.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn print_tree(root: Option[TreeNode]) -> Vec[Vec[String]] {
    let mut depth = 0;
    let mut level: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        level.push(r);
    }
    while not level.is_empty() {
        depth += 1;
        let mut next: Vec[TreeNode] = Vec.new();
        for n in level.iter() {
            if let Some(l) = n.left {
                next.push(l);
            }
            if let Some(r) = n.right {
                next.push(r);
            }
        }
        level = next;
    }
    let h = depth - 1;
    let columns = (1 << depth) - 1;
    let mut grid: Vec[Vec[String]] = Vec.new();
    for _ in 0..depth {
        grid.push(vec!["".to_string(); columns]);
    }
    let mut queue: VecDeque[(TreeNode, i64, i64)] = VecDeque.new();
    if let Some(r) = root {
        queue.push_back((r, 0, (columns - 1) / 2));
    }
    while let Some((n, row, column)) = queue.pop_front() {
        grid[row][column] = n.val.to_string();
        if row < h {
            let step = 1 << (h - row - 1);
            if let Some(l) = n.left {
                queue.push_back((l, row + 1, column - step));
            }
            if let Some(r) = n.right {
                queue.push_back((r, row + 1, column + step));
            }
        }
    }
    grid
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A tree from LeetCode's level order: `None` for a missing child.
fn from_level(values: Vec[Option[i64]]) -> Option[TreeNode] {
    if values.is_empty() or values[0].is_none() {
        return None;
    }
    let root = leaf(values[0].unwrap());
    let mut queue: Vec[TreeNode] = vec![root];
    let mut head = 0;
    let mut i = 1;
    while i < values.len() {
        let n = queue[head];
        head += 1;
        if let Some(v) = values[i] {
            let c = leaf(v);
            n.left = Some(c);
            queue.push(c);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let c = leaf(v);
                n.right = Some(c);
                queue.push(c);
            }
            i += 1;
        }
    }
    Some(root)
}

// A random tree at most `levels` deep: each child is there with chance
// `chance` in 100; values from -99 to 99.
fn random_tree(levels: i64, chance: i64, seed: mut ref i64) -> Option[TreeNode] {
    if levels == 0 {
        return None;
    }
    let n = leaf(next_random(mut seed) % 199 - 99);
    if next_random(mut seed) % 100 < chance {
        n.left = random_tree(levels - 1, chance, mut seed);
    }
    if next_random(mut seed) % 100 < chance {
        n.right = random_tree(levels - 1, chance, mut seed);
    }
    Some(n)
}

fn checksum(grid: Vec[Vec[String]]) -> i64 {
    let mut h = 0;
    for row in grid.iter() {
        for cell in row.iter() {
            for b in cell.bytes().iter() {
                h = (h * 131 + *b as i64) % 1000000007;
            }
            h = (h * 131 + 44) % 1000000007;
        }
        h = (h * 131 + 10) % 1000000007;
    }
    h
}

fn show(values: Vec[Option[i64]]) {
    let grid = print_tree(from_level(values));
    println(f"{values.len()} values -> {grid.len()} rows of {grid[0].len()}");
    for row in grid.iter() {
        let mut line = String.from("  [");
        for i in 0..row.len() {
            if i > 0 {
                line.push_str(",");
            }
            line.push_str(f"\"{row[i]}\"");
        }
        line.push_str("]");
        println(line);
    }
}

fn main() {
    // The two LeetCode examples.
    show(vec![Some(1), Some(2)]);
    show(vec![Some(1), Some(2), Some(3), None, Some(4)]);
    // One node; a chain down the right; a full tree of three levels with
    // the smallest and largest values.
    show(vec![Some(5)]);
    show(vec![Some(1), None, Some(2), None, Some(3)]);
    show(vec![Some(0), Some(-99), Some(99), Some(-1), Some(1), Some(-10), Some(10)]);
    // 200 random trees at most 1 to 6 levels deep: cells filled and a
    // checksum of the grids.
    let mut seed: i64 = 655;
    let mut filled = 0;
    let mut sum = 0;
    for _ in 0..200 {
        let levels = 1 + next_random(mut seed) % 6;
        let chance = 40 + next_random(mut seed) % 61;
        let grid = print_tree(random_tree(levels, chance, mut seed));
        for row in grid.iter() {
            for cell in row.iter() {
                if cell.len() > 0 {
                    filled += 1;
                }
            }
        }
        sum = (sum * 7 + checksum(grid)) % 1000000007;
    }
    println(f"200 random trees: {filled} cells filled, checksum {sum}");
    // The problem's deepest, 10 levels: a full tree and a sparse one.
    let grid = print_tree(random_tree(10, 100, mut seed));
    println(f"full, 10 levels: {grid.len()} rows of {grid[0].len()}, checksum {checksum(grid)}");
    let grid = print_tree(random_tree(10, 75, mut seed));
    println(f"sparse, up to 10 levels: {grid.len()} rows of {grid[0].len()}, checksum {checksum(grid)}");
}
