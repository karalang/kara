// LeetCode #693: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random problems.

// ---- star arm ----------------------------------------------------------

fn has_alternating_bits_star(n: i64) -> bool {
    let x = n ^ (n >> 1);
    x & (x + 1) == 0
}

// ---- loop arm ----------------------------------------------------------

fn has_alternating_bits_loop(n: i64) -> bool {
    let mut rest = n >> 1;
    let mut last = n & 1;
    while rest > 0 {
        let bit = rest & 1;
        if bit == last {
            return false;
        }
        last = bit;
        rest = rest >> 1;
    }
    true
}

// ---- count arm ---------------------------------------------------------

fn has_alternating_bits_count(n: i64) -> bool {
    let changes = (n ^ (n >> 1)).count_ones();
    let bits = 64 - n.leading_zeros();
    changes == bits
}

// ---- grow arm ----------------------------------------------------------

fn has_alternating_bits_grow(n: i64) -> bool {
    let mut a = 1;
    while a < n {
        a = 2 * a + (1 - a % 2);
    }
    a == n
}

// ---- the definition and the properties ------------------------------------

fn answer(which: i64, n: i64) -> bool {
    if which == 0 {
        has_alternating_bits_star(n)
    } else if which == 1 {
        has_alternating_bits_loop(n)
    } else if which == 2 {
        has_alternating_bits_count(n)
    } else {
        has_alternating_bits_grow(n)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The definition: write n's binary digits out by halving it, and check
// every two neighbours differ.
fn definition(n: i64) -> bool {
    let mut digits: Vec[i64] = Vec.new();
    let mut m = n;
    while m > 0 {
        digits.push(m % 2);
        m = m / 2;
    }
    for i in 1..digits.len() {
        if digits[i] == digits[i - 1] {
            return false;
        }
    }
    true
}

fn main() {
    let mut seed = 6930;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 20000;
    for i in 0..cases {
        // Random numbers of every length, and alternating numbers with a
        // few bits flipped, and the alternating numbers themselves.
        let bits = 1 + next_random(mut seed) % 31;
        let mut n = (next_random(mut seed) * 65536 + next_random(mut seed)) % (1 << bits);
        if i % 3 != 0 {
            let alt = 1431655765 >> (next_random(mut seed) % 31);
            n = alt;
            if i % 3 == 1 {
                for _ in 0..next_random(mut seed) % 3 {
                    n = n ^ (1 << (next_random(mut seed) % 31));
                }
            }
        }
        if n <= 0 or n > 2147483647 {
            n = 1 + next_random(mut seed);
        }
        let want = definition(n);
        for which in 0..arms {
            let got = answer(which, n);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: a bit added below, opposite to n's lowest, keeps the
            // answer; the same bit added makes it no.
            checks += 1;
            if n < 1073741824 {
                let low = n % 2;
                if answer(which, 2 * n + 1 - low) != got or answer(which, 2 * n + low) {
                    fails[1] += 1;
                }
            }
            // P3: n alternates when n without its lowest bit does and the
            // two lowest bits differ.
            checks += 1;
            if n > 1 {
                if got != (answer(which, n >> 1) and n % 2 != (n >> 1) % 2) {
                    fails[2] += 1;
                }
            } else if not got {
                fails[2] += 1;
            }
            // P4: n of b bits alternates when n with all b bits flipped
            // alternates and has b - 1 bits, a 0 now in n's top place.
            checks += 1;
            if n > 1 {
                let bits = 64 - n.leading_zeros();
                let flipped = ((1 << bits) - 1) ^ n;
                let shorter = flipped > 0 and 64 - flipped.leading_zeros() == bits - 1;
                if got != (shorter and answer(which, flipped)) {
                    fails[3] += 1;
                }
            }
        }
    }
    let mut report = String.new();
    let mut total = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
        }
        total += fails[p];
    }
    println(f"{report}{cases} numbers, {arms} arms, {checks} checks, {total} failures");
}
