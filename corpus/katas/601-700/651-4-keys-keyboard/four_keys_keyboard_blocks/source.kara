// LeetCode #651: 4 Keys Keyboard -- typing first, then blocks of copies.
//
// Once anything has been copied, a Ctrl-V adds at least as much as an
// `A`, so the best plan types its `A`s first and then repeats blocks of
// Ctrl-A, Ctrl-C and some Ctrl-Vs. A block of `s` presses multiplies the
// screen by `s - 1`. `most[r]` is the best factor that `r` presses of
// blocks can give, and the answer is the best of `a * most[n - a]` over
// the `a` typed first. O(n^2) time.

fn max_a(n: i64) -> i64 {
    let mut most = vec![0; n + 1];
    most[0] = 1;
    for r in 3..n + 1 {
        for size in 3..r + 1 {
            most[r] = most[r].max(most[r - size] * (size - 1));
        }
    }
    let mut best = 0;
    for typed in 1..n + 1 {
        best = best.max(typed * most[n - typed]);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    println(f"{n} -> {max_a(n)}");
}

fn main() {
    // The two LeetCode examples.
    show(3);
    show(7);
    // One press; the most that typing alone is best for; the first
    // copies; the largest count allowed, with a few between.
    show(1);
    show(6);
    show(8);
    show(9);
    show(10);
    show(11);
    show(15);
    show(20);
    show(31);
    show(42);
    show(50);
    // Every count from 1 to 50: the total and a checksum of the answers.
    let mut total = 0;
    let mut checksum = 0;
    for n in 1..51 {
        let a = max_a(n);
        total += a;
        checksum = (checksum * 31 + a) % 1000000007;
    }
    println(f"1 to 50: total {total}, checksum {checksum}");
}
