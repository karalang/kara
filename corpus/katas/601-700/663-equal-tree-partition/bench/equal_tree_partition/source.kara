// Benchmark for #663: the ★ arm (the subtree sums, listed) on a large
// workload.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn check_equal_tree(root: Option[TreeNode]) -> bool {
    let mut sums: Vec[i64] = Vec.new();
    let total = subtree_sum(root, mut sums);
    if total % 2 != 0 {
        return false;
    }
    sums.pop();
    for s in sums.iter() {
        if *s == total / 2 {
            return true;
        }
    }
    false
}

fn subtree_sum(node: Option[TreeNode], sums: mut ref Vec[i64]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let s = n.val + subtree_sum(n.left, mut sums) + subtree_sum(n.right, mut sums);
            sums.push(s);
            s
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// `count` nodes with values from -100,000 to 100,000, each hung where a
// random walk down from the root first finds no child.
fn grown_tree(count: i64, seed: mut ref i64) -> TreeNode {
    let root = leaf(next_random(mut seed) % 200001 - 100000);
    for _ in 1..count {
        let mut at = root;
        let mut placed = false;
        while not placed {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(l) => at = l,
                    None => {
                        at.left = Some(leaf(next_random(mut seed) % 200001 - 100000));
                        placed = true;
                    }
                }
            } else {
                match at.right {
                    Some(r) => at = r,
                    None => {
                        at.right = Some(leaf(next_random(mut seed) % 200001 - 100000));
                        placed = true;
                    }
                }
            }
        }
    }
    root
}

fn copy(node: Option[TreeNode]) -> Option[TreeNode] {
    match node {
        None => None,
        Some(n) => Some(TreeNode { val: n.val, left: copy(n.left), right: copy(n.right) }),
    }
}

fn main() {
    // Eight trees made once: four of the problem's largest, 10,000 nodes
    // grown at random, and four of a root of 0 over a tree of 4,999 and
    // its copy, which split. Then each round checks one, picked by the
    // round, and puts the answer into a checksum.
    let mut seed: i64 = 663;
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    for _ in 0..4 {
        trees.push(Some(grown_tree(10000, mut seed)));
        let root = leaf(0);
        root.left = Some(grown_tree(4999, mut seed));
        root.right = copy(root.left);
        trees.push(Some(root));
    }
    let rounds = 4000;
    let mut split = 0;
    let mut sum = 0;
    for r in 0..rounds {
        let ok = check_equal_tree(trees[r % 8]);
        if ok {
            split += 1;
        }
        sum = (sum * 31 + r * 2 + if ok { 1 } else { 0 }) % 1000000007;
    }
    println(f"8 trees of 10000 nodes, {rounds} rounds: {split} split, checksum {sum}");
}
