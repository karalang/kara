// LeetCode #673: differential -- the four arms against the definition.
//
// Copies of the four arms, held to five properties on random arrays.

// ---- star arm ----------------------------------------------------------

fn find_number_of_lis_star(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut length = vec![1; n];
    let mut count = vec![1; n];
    for i in 0..n {
        for j in 0..i {
            if nums[j] < nums[i] {
                if length[j] + 1 > length[i] {
                    length[i] = length[j] + 1;
                    count[i] = count[j];
                } else if length[j] + 1 == length[i] {
                    count[i] += count[j];
                }
            }
        }
    }
    let mut best = 0;
    for v in length.iter() {
        best = best.max(v);
    }
    let mut total = 0;
    for i in 0..n {
        if length[i] == best {
            total += count[i];
        }
    }
    total
}

// ---- fenwick arm -------------------------------------------------------

// The distinct values of `nums`, rising.
fn distinct_sorted_fenwick(nums: Vec[i64]) -> Vec[i64] {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut out: Vec[i64] = Vec.new();
    for v in sorted.iter() {
        if out.is_empty() or out[out.len() - 1] != v {
            out.push(v);
        }
    }
    out
}

// The rank of `x` in `values`, from 1.
fn rank_of_fenwick(values: Vec[i64], x: i64) -> i64 {
    let mut lo = 0;
    let mut hi = values.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if values[mid] < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo + 1
}

// Fold a pair into the best pair so far.
fn combine_fenwick(best_len: mut ref i64, best_count: mut ref i64, len: i64, count: i64) {
    if len > *best_len {
        *best_len = len;
        *best_count = count;
    } else if len == *best_len {
        *best_count += count;
    }
}

fn find_number_of_lis_fenwick(nums: Vec[i64]) -> i64 {
    let values = distinct_sorted_fenwick(nums);
    let size = values.len();
    let mut lens = vec![0; size + 1];
    let mut counts = vec![0; size + 1];
    for x in nums.iter() {
        let r = rank_of_fenwick(values, x);
        // The best pair over the ranks below `r`.
        let mut below_len = 0;
        let mut below_count = 0;
        let mut i = r - 1;
        while i > 0 {
            combine_fenwick(mut below_len, mut below_count, lens[i], counts[i]);
            i -= i & (0 - i);
        }
        let mut len = 1;
        let mut count = 1;
        if below_len > 0 {
            len = below_len + 1;
            count = below_count;
        }
        let mut j = r;
        while j <= size {
            combine_fenwick(mut lens[j], mut counts[j], len, count);
            j += j & (0 - j);
        }
    }
    let mut best_len = 0;
    let mut best_count = 0;
    let mut i = size;
    while i > 0 {
        combine_fenwick(mut best_len, mut best_count, lens[i], counts[i]);
        i -= i & (0 - i);
    }
    best_count
}

// ---- piles arm ---------------------------------------------------------

fn find_number_of_lis_piles(nums: Vec[i64]) -> i64 {
    let mut values: Vec[Vec[i64]] = Vec.new();
    let mut totals: Vec[Vec[i64]] = Vec.new();
    for x in nums.iter() {
        // The leftmost pile whose top is not below `x`.
        let mut lo = 0;
        let mut hi = values.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if values[mid][values[mid].len() - 1] >= x {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        let k = lo;
        // How many subsequences `x` extends: the numbers below it on
        // pile k - 1, a tail of that pile.
        let mut ways = 1;
        if k > 0 {
            let prev = values[k - 1].len();
            let mut a = 0;
            let mut b = prev;
            while a < b {
                let mid = (a + b) / 2;
                if values[k - 1][mid] < x {
                    b = mid;
                } else {
                    a = mid + 1;
                }
            }
            ways = totals[k - 1][prev - 1];
            if a > 0 {
                ways -= totals[k - 1][a - 1];
            }
        }
        if k == values.len() {
            values.push(Vec.new());
            totals.push(Vec.new());
        }
        let mut before = 0;
        if totals[k].len() > 0 {
            before = totals[k][totals[k].len() - 1];
        }
        values[k].push(x);
        totals[k].push(before + ways);
    }
    let last = totals.len() - 1;
    totals[last][totals[last].len() - 1]
}

// ---- memo arm ----------------------------------------------------------

fn starting_at_memo(nums: Vec[i64], i: i64, memo: mut ref Vec[(i64, i64)], known: mut ref Vec[bool]) -> (i64, i64) {
    if known[i] {
        return memo[i];
    }
    let mut len = 1;
    let mut count = 1;
    for j in i + 1..nums.len() {
        if nums[j] > nums[i] {
            let (l, c) = starting_at_memo(nums, j, memo, known);
            if l + 1 > len {
                len = l + 1;
                count = c;
            } else if l + 1 == len {
                count += c;
            }
        }
    }
    memo[i] = (len, count);
    known[i] = true;
    (len, count)
}

fn find_number_of_lis_memo(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut memo = vec![(0, 0); n];
    let mut known = vec![false; n];
    let mut best = 0;
    let mut total = 0;
    for i in 0..n {
        let (len, count) = starting_at_memo(nums, i, mut memo, mut known);
        if len > best {
            best = len;
            total = count;
        } else if len == best {
            total += count;
        }
    }
    total
}

// ---- the definition and the properties ------------------------------------

fn answer(which: i64, nums: Vec[i64]) -> i64 {
    if which == 0 {
        find_number_of_lis_star(nums)
    } else if which == 1 {
        find_number_of_lis_fenwick(nums)
    } else if which == 2 {
        find_number_of_lis_piles(nums)
    } else {
        find_number_of_lis_memo(nums)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The definition: every subset of the places, as a bit mask; count the
// strictly increasing ones of the greatest length.
fn definition(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = 0;
    let mut count = 0;
    for mask in 1..(1 << n) {
        let mut ok = true;
        let mut len = 0;
        let mut last = 0;
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                if len > 0 and nums[i] <= last {
                    ok = false;
                }
                last = nums[i];
                len += 1;
            }
        }
        if ok {
            if len > best {
                best = len;
                count = 1;
            } else if len == best {
                count += 1;
            }
        }
    }
    count
}

// Reversed and negated: increasing subsequences map to increasing ones.
fn mirrored(nums: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = nums.len();
    while i > 0 {
        i -= 1;
        out.push(0 - nums[i]);
    }
    out
}

fn shifted(nums: Vec[i64], by: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for v in nums.iter() {
        out.push(v + by);
    }
    out
}

fn largest(nums: Vec[i64]) -> i64 {
    let mut m = nums[0];
    for v in nums.iter() {
        m = m.max(v);
    }
    m
}

fn smallest(nums: Vec[i64]) -> i64 {
    let mut m = nums[0];
    for v in nums.iter() {
        m = m.min(v);
    }
    m
}

fn main() {
    // 1070 arrays: 70 of up to 12 numbers, held to the definition, and
    // 1000 of up to 60, spread over 3, 10 or 1000 values so that repeats
    // range from common to rare.
    let small = 70;
    let cases = small + 1000;
    let mut seed: i64 = 673;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    let spreads = [3, 10, 1000];
    for c in 0..cases {
        let mut size = 1 + next_random(mut seed) % 60;
        if c < small {
            size = 1 + c % 12;
        }
        let spread = spreads[c % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..size {
            nums.push(next_random(mut seed) % spread - spread / 2);
        }
        let mut want = 0;
        if c < small {
            want = definition(nums);
        }
        let top = largest(nums);
        let span = top - smallest(nums) + 1;
        let mut extended = nums.clone();
        extended.push(top + 1);
        let mut doubled = nums.clone();
        for v in nums.iter() {
            doubled.push(v + span);
        }
        for which in 0..4 {
            let got = answer(which, nums);
            // P1: the definition's answer. P2: the same reversed and
            // negated. P3: the same with every number moved by a
            // constant. P4: the same with a new largest number appended.
            // P5: squared when a copy moved above the whole array is
            // appended.
            let ok = [
                c >= small or got == want,
                answer(which, mirrored(nums)) == got,
                answer(which, shifted(nums, 1000003)) == got,
                answer(which, extended) == got,
                answer(which, doubled) == got * got,
            ];
            for p in 0..5 {
                if p > 0 or c < small {
                    checks += 1;
                    if not ok[p] {
                        failures[p] += 1;
                    }
                }
            }
        }
    }
    let mut total = 0;
    for p in 0..5 {
        total += failures[p];
        if failures[p] > 0 {
            println(f"P{p + 1}: {failures[p]} failures");
        }
    }
    println(f"{cases} arrays ({small} against the definition), 4 arms, {checks} checks, {total} failures");
}
