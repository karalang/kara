// Benchmark for #676: every word of the same length compared, the ★ arm.
//
// Keep the words as given. A search compares the word with every
// dictionary word of its length, a byte at a time, and succeeds when
// some word differs in exactly one place. A search costs O(total length
// of the dictionary).

struct MagicDictionary {
    words: Vec[String],
}

impl MagicDictionary {
    fn new() -> MagicDictionary {
        MagicDictionary { words: Vec.new() }
    }

    fn build_dict(mut ref self, dictionary: Vec[String]) {
        self.words = dictionary.clone();
    }

    fn search(ref self, search_word: String) -> bool {
        let b = search_word.bytes();
        for w in self.words.iter() {
            let a = w.bytes();
            if a.len() == b.len() {
                let mut diff = 0;
                for i in 0..a.len() {
                    if a[i] != b[i] {
                        diff += 1;
                    }
                }
                if diff == 1 {
                    return true;
                }
            }
        }
        false
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, length: i64) -> String {
    let mut s = String.new();
    for _ in 0..length {
        s.push(((97 + next_random(seed) % 2) as u8) as char);
    }
    s
}

fn main() {
    // 1,000 dictionaries of 100 words, the problem's most, each of 50
    // letters over `a` and `b`, from the same generator as the other
    // languages. Each is searched 100 times, the problem's most: every
    // other search a dictionary word with one letter changed, the rest
    // a random word, which is never found. Each answer goes into a
    // checksum.
    let rounds = 1000;
    let mut seed: i64 = 676;
    let mut sum = 0;
    let mut found = 0;
    for _ in 0..rounds {
        let mut dictionary: Vec[String] = Vec.new();
        for _ in 0..100 {
            dictionary.push(random_word(mut seed, 50));
        }
        let mut d = MagicDictionary.new();
        d.build_dict(dictionary);
        for k in 0..100 {
            let mut word = String.new();
            if k % 2 == 0 {
                let w = dictionary[next_random(mut seed) % 100].clone();
                let at = next_random(mut seed) % 50;
                let mut c = "a";
                if w[at..at + 1] == "a" {
                    c = "b";
                }
                word = f"{w[0..at]}{c}{w[at + 1..w.len()]}";
            } else {
                word = random_word(mut seed, 50);
            }
            if d.search(word) {
                found += 1;
                sum = (sum * 3 + 1) % 1000000007;
            } else {
                sum = sum * 3 % 1000000007;
            }
        }
    }
    println(f"{rounds} dictionaries of 100 words, {rounds * 100} searches, {found} found: checksum {sum}");
}
