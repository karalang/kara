// LeetCode #659: differential -- the four arms against the definition.
//
// Copies of the four arms, held to five properties on random arrays.

// ---- star arm ----------------------------------------------------------

fn is_possible_star(nums: Vec[i64]) -> bool {
    let mut left: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        *left.entry(x).or_insert(0) += 1;
    }
    let mut ends: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        if count_star(left, x) == 0 {
            continue;
        }
        *left.entry(x).or_insert(0) -= 1;
        if count_star(ends, x - 1) > 0 {
            *ends.entry(x - 1).or_insert(0) -= 1;
            *ends.entry(x).or_insert(0) += 1;
        } else if count_star(left, x + 1) > 0 and count_star(left, x + 2) > 0 {
            *left.entry(x + 1).or_insert(0) -= 1;
            *left.entry(x + 2).or_insert(0) -= 1;
            *ends.entry(x + 2).or_insert(0) += 1;
        } else {
            return false;
        }
    }
    true
}

fn count_star(m: Map[i64, i64], k: i64) -> i64 {
    match m.get(k) {
        Some(n) => n,
        None => 0,
    }
}

// ---- heaps arm ---------------------------------------------------------

fn is_possible_heaps(nums: Vec[i64]) -> bool {
    let mut ends: Map[i64, PriorityQueue[i64]] = Map.new();
    for x in nums.iter() {
        let mut length = 1;
        if let Some(found) = ends.entry(x - 1).or_insert(PriorityQueue.new()).pop() {
            length = found + 1;
        }
        ends.entry(x).or_insert(PriorityQueue.new()).push(length);
    }
    for (_, lengths) in ends.iter() {
        if let Some(shortest) = lengths.peek() {
            if shortest < 3 {
                return false;
            }
        }
    }
    true
}

// ---- runs arm ----------------------------------------------------------

fn is_possible_runs(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut one = 0;
    let mut two = 0;
    let mut more = 0;
    let mut previous = nums[0] - 2;
    let mut i = 0;
    while i < n {
        let value = nums[i];
        let mut copies = 0;
        while i < n and nums[i] == value {
            copies += 1;
            i += 1;
        }
        if value != previous + 1 {
            if one + two > 0 {
                return false;
            }
            one = copies;
            two = 0;
            more = 0;
        } else {
            if copies < one + two {
                return false;
            }
            let extended = more.min(copies - one - two);
            let started = copies - one - two - extended;
            more = two + extended;
            two = one;
            one = started;
        }
        previous = value;
    }
    one + two == 0
}

// ---- scan arm ----------------------------------------------------------

struct Open {
    end: i64,
    length: i64,
}

fn is_possible_scan(nums: Vec[i64]) -> bool {
    let mut open: Vec[Open] = Vec.new();
    for x in nums.iter() {
        let mut kept: Vec[Open] = Vec.new();
        for s in open.iter() {
            if s.end < x - 1 {
                if s.length < 3 {
                    return false;
                }
            } else {
                kept.push(Open { end: s.end, length: s.length });
            }
        }
        open = kept;
        let mut best = -1;
        for i in 0..open.len() {
            if open[i].end == x - 1 and (best == -1 or open[i].length < open[best].length) {
                best = i;
            }
        }
        if best == -1 {
            open.push(Open { end: x, length: 1 });
        } else {
            open[best].end = x;
            open[best].length += 1;
        }
    }
    for s in open.iter() {
        if s.length < 3 {
            return false;
        }
    }
    true
}

// ---- the definition and the properties -------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, nums: Vec[i64]) -> bool {
    match which {
        0 => is_possible_star(nums),
        1 => is_possible_heaps(nums),
        2 => is_possible_runs(nums),
        _ => is_possible_scan(nums),
    }
}

// The definition, by search: the smallest number left must start a
// sequence, so try every length of 3 or more that the numbers left allow,
// take that sequence out, and split what remains.
fn splits(nums: Vec[i64]) -> bool {
    if nums.is_empty() {
        return true;
    }
    let mut rest = nums.clone();
    let start = rest[0];
    rest.remove(0);
    let mut length = 1;
    loop {
        let at = rest.iter().position(|v| v == start + length);
        match at {
            None => return false,
            Some(i) => {
                rest.remove(i);
                length += 1;
                if length >= 3 and splits(rest) {
                    return true;
                }
            }
        }
    }
}

fn sorted(nums: Vec[i64]) -> Vec[i64] {
    let mut out = nums.clone();
    out.sort();
    out
}

fn main() {
    // 1,000 random sorted arrays of 1 to 15 numbers: half made of runs of
    // 3 to 5, some with a number dropped or repeated, half at random from
    // 0 to 5.
    let cases = 1000;
    let mut seed: i64 = 659;
    let mut numbers = 0;
    let mut yes = 0;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    for k in 0..cases {
        let mut nums: Vec[i64] = Vec.new();
        if k % 2 == 0 {
            while nums.len() < 10 {
                let start = next_random(mut seed) % 8;
                let length = 3 + next_random(mut seed) % 3;
                for v in start..start + length {
                    nums.push(v);
                }
                if next_random(mut seed) % 3 == 0 {
                    break;
                }
            }
            if k % 4 == 0 {
                let at = next_random(mut seed) % nums.len();
                if next_random(mut seed) % 2 == 0 {
                    nums.remove(at);
                } else {
                    nums.push(nums[at]);
                }
            }
        } else {
            for _ in 0..1 + next_random(mut seed) % 14 {
                nums.push(next_random(mut seed) % 6);
            }
        }
        if nums.is_empty() {
            nums.push(0);
        }
        nums.sort();
        numbers += nums.len();
        let want = splits(nums);
        if want {
            yes += 1;
        }
        let shift = next_random(mut seed) % 2001 - 1000;
        let mut moved: Vec[i64] = Vec.new();
        let mut flipped: Vec[i64] = Vec.new();
        let mut twice: Vec[i64] = Vec.new();
        for x in nums.iter() {
            moved.push(x + shift);
            flipped.push(-x);
            twice.push(x);
            twice.push(x);
        }
        let run = next_random(mut seed) % 10;
        let mut added = nums.clone();
        added.push(run);
        added.push(run + 1);
        added.push(run + 2);
        for which in 0..4 {
            let got = answer(which, nums);
            let ok = vec![
                // P1: the definition's answer.
                got == want,
                // P2: moving every number alike changes nothing.
                answer(which, moved) == got,
                // P3: the numbers negated give the same answer.
                answer(which, sorted(flipped)) == got,
                // P4: a split array stays split with a run of three added.
                not got or answer(which, sorted(added)),
                // P5: a split array stays split with every number twice.
                not got or answer(which, sorted(twice)),
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                }
            }
        }
    }
    let all = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{cases} arrays ({numbers} numbers, {yes} can be split), 4 arms, {checks} checks, {all} failures");
    if all > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
