// Benchmark for #640: the ★ arm (each side read once into a count of x
// and a constant) on a fixed workload. See ../README.md § Benchmarks.

// The x count and the constant of the side `text`.
fn side(text: Slice[u8]) -> (i64, i64) {
    let mut xs = 0;
    let mut constant = 0;
    let mut i = 0;
    let n = text.len();
    while i < n {
        let mut sign = 1;
        if text[i] == b'+' or text[i] == b'-' {
            if text[i] == b'-' {
                sign = -1;
            }
            i += 1;
        }
        let mut value = 0;
        let mut digits = 0;
        while i < n and text[i] >= b'0' and text[i] <= b'9' {
            value = value * 10 + (text[i] - b'0') as i64;
            digits += 1;
            i += 1;
        }
        if i < n and text[i] == b'x' {
            xs += sign * (if digits == 0 { 1 } else { value });
            i += 1;
        } else {
            constant += sign * value;
        }
    }
    (xs, constant)
}

fn solve_equation(equation: String) -> String {
    let bytes = equation.bytes();
    let mut eq = 0;
    while bytes[eq] != b'=' {
        eq += 1;
    }
    let (a, b) = side(bytes[0..eq]);
    let (c, d) = side(bytes[eq + 1..bytes.len()]);
    if a == c {
        if b == d {
            String.from("Infinite solutions")
        } else {
            String.from("No solution")
        }
    } else {
        f"x={(d - b) / (a - c)}"
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A side of `terms` terms with numbers from 0 to 99, an x term with
// chance 1 in 2, as text, with its x count and constant.
fn random_side(terms: i64, seed: mut ref i64) -> (String, i64, i64) {
    let mut text = String.new();
    let mut xs = 0;
    let mut constant = 0;
    for t in 0..terms {
        let minus = next_random(mut seed) % 2 == 0;
        if minus {
            text.push('-');
        } else if t > 0 {
            text.push('+');
        }
        let sign = if minus { -1 } else { 1 };
        let value = next_random(mut seed) % 100;
        if next_random(mut seed) % 2 == 0 {
            text.push_str(f"{value}x");
            xs += sign * value;
        } else {
            text.push_str(f"{value}");
            constant += sign * value;
        }
    }
    (text, xs, constant)
}

// 20 equations of about 1,000 characters (125 terms a side) made once,
// with the right side evened so that a solution is whole; then 200000
// rounds each solving one of them.
fn main() {
    let mut seed: i64 = 640;
    let mut equations: Vec[String] = Vec.new();
    for _ in 0..20 {
        let (left, a, b) = random_side(125, mut seed);
        let (right, c, d) = random_side(125, mut seed);
        let mut text = f"{left}={right}";
        if a != c {
            let rem = (d - b) % (a - c);
            if rem > 0 {
                text = f"{text}-{rem}";
            } else if rem < 0 {
                text = f"{text}+{-rem}";
            }
        }
        equations.push(text);
    }
    let rounds = 200000;
    let mut solved = 0;
    let mut sum = 0;
    for round in 0..rounds {
        let answer = solve_equation(equations[round % 20]);
        if answer.starts_with("x=") {
            solved += 1;
            sum += i64.parse(answer[2..answer.len()]).unwrap();
        }
    }
    println(f"20 equations, {rounds} rounds: {solved} solved, x adding to {sum}");
}
