// LeetCode #640: Solve the Equation -- a list of terms, then the sums.
//
// A first pass cuts the equation into terms, each a signed number, a
// flag for whether it holds x, and the side it is on; a bare `x` is 1x.
// A second pass adds the left side's terms and takes away the right
// side's, leaving xs x + constant = 0. O(length).

struct Term {
    value: i64,
    has_x: bool,
    right: bool,
}

fn terms_of(equation: String) -> Vec[Term] {
    let bytes = equation.bytes();
    let mut terms: Vec[Term] = Vec.new();
    let mut right = false;
    let mut i = 0;
    while i < bytes.len() {
        if bytes[i] == b'=' {
            right = true;
            i += 1;
            continue;
        }
        let mut sign = 1;
        if bytes[i] == b'+' or bytes[i] == b'-' {
            sign = if bytes[i] == b'-' { -1 } else { 1 };
            i += 1;
        }
        let start = i;
        let mut value = 0;
        while i < bytes.len() and bytes[i] >= b'0' and bytes[i] <= b'9' {
            value = value * 10 + (bytes[i] - b'0') as i64;
            i += 1;
        }
        let has_x = i < bytes.len() and bytes[i] == b'x';
        if has_x {
            if i == start {
                value = 1;
            }
            i += 1;
        }
        terms.push(Term { value: sign * value, has_x: has_x, right: right });
    }
    terms
}

fn solve_equation(equation: String) -> String {
    let mut xs = 0;
    let mut constant = 0;
    for term in terms_of(equation).iter() {
        let v = if term.right { -term.value } else { term.value };
        if term.has_x {
            xs += v;
        } else {
            constant += v;
        }
    }
    if xs == 0 {
        if constant == 0 {
            String.from("Infinite solutions")
        } else {
            String.from("No solution")
        }
    } else {
        f"x={-constant / xs}"
    }
}


// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// One side of `terms` terms, each an x term with chance 1 in 2, holding
// coefficients and constants from 0 to `most`; the first term has no
// `+`. Returns the text and its x count and constant.
fn random_side(terms: i64, most: i64, seed: mut ref i64) -> (String, i64, i64) {
    let mut text = String.new();
    let mut xs = 0;
    let mut constant = 0;
    for t in 0..terms {
        let minus = next_random(mut seed) % 2 == 0;
        if minus {
            text.push('-');
        } else if t > 0 {
            text.push('+');
        }
        let sign = if minus { -1 } else { 1 };
        let value = next_random(mut seed) % (most + 1);
        if next_random(mut seed) % 2 == 0 {
            // An x term: a coefficient of 1 is usually written as bare x.
            if value == 1 and next_random(mut seed) % 4 != 0 {
                text.push('x');
            } else {
                text.push_str(f"{value}x");
            }
            xs += sign * value;
        } else {
            text.push_str(f"{value}");
            constant += sign * value;
        }
    }
    (text, xs, constant)
}

// The equation with `rem` taken off its right side: a term -rem, or
// +|rem| when rem is negative, and nothing when it is 0.
fn evened(text: String, rem: i64) -> String {
    if rem > 0 {
        f"{text}-{rem}"
    } else if rem < 0 {
        f"{text}+{-rem}"
    } else {
        text.clone()
    }
}

fn ask(equation: Str) {
    println(f"{equation} -> {solve_equation(String.from(equation))}");
}

fn main() {
    // The LeetCode examples.
    ask("x+5-3+x=6+x-2");
    ask("x=x");
    ask("2x=x");
    // No solution; x on the right only; a 0x term; a minus at the start
    // of each side; constants only, equal and not; a negative answer;
    // numbers of several digits; 0x on both sides.
    ask("x=x+2");
    ask("3=x");
    ask("0x=5");
    ask("-x=-1");
    ask("1+2=3");
    ask("1+2=4");
    ask("2x+3=x-4");
    ask("100x-250=50x+250");
    ask("0x=0x");
    ask("-x+3x-2x=0");
    // 300 random equations of 1 to 6 terms a side, built so that a
    // solution, when there is one, is a whole number.
    let mut seed: i64 = 640;
    let mut solved = 0;
    let mut sum = 0;
    let mut none = 0;
    let mut every = 0;
    for _ in 0..300 {
        let (left, a, b) = random_side(1 + next_random(mut seed) % 6, 12, mut seed);
        let (right, c, d) = random_side(1 + next_random(mut seed) % 6, 12, mut seed);
        // Take the remainder off the right side, so that a - c divides
        // the difference of the constants.
        let text = if a != c { evened(f"{left}={right}", (d - b) % (a - c)) } else { f"{left}={right}" };
        let answer = solve_equation(text);
        if answer == "No solution" {
            none += 1;
        } else if answer == "Infinite solutions" {
            every += 1;
        } else {
            solved += 1;
            sum += i64.parse(answer[2..answer.len()]).unwrap();
        }
    }
    println(f"300 random equations: {solved} solved (x adding to {sum}), {none} with no solution, {every} with every x");
    // Close to 1,000 characters, the most: 190 terms a side.
    let (left, a, b) = random_side(190, 9, mut seed);
    let (right, c, d) = random_side(190, 9, mut seed);
    let text = if a != c { evened(f"{left}={right}", (d - b) % (a - c)) } else { f"{left}={right}" };
    println(f"{text.len()} characters -> {solve_equation(text)}");
}
