// LeetCode #679: 24 Game -- the values of every subset of the cards.
//
// For each subset of the cards, as a 4-bit mask, keep the set of exact
// fractions that some expression over exactly those cards evaluates to.
// A single card gives itself; a larger subset joins, for every way to
// split it in two, each value of one part with each value of the other
// by + - * and / both ways. Smaller masks are filled first, since a
// part's mask is below the whole's. The cards solve the game when 24 is
// a value of the full mask.

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = a.abs();
    let mut y = b.abs();
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    x
}

fn fraction(num: i64, den: i64) -> (i64, i64) {
    let g = gcd(num, den);
    if den < 0 {
        (0 - num / g, 0 - den / g)
    } else {
        (num / g, den / g)
    }
}

fn judge_point24(cards: Vec[i64]) -> bool {
    let n = cards.len();
    let full = (1 << n) - 1;
    let mut values: Vec[Set[(i64, i64)]] = Vec.new();
    for _ in 0..full + 1 {
        values.push(Set.new());
    }
    for i in 0..n {
        values[1 << i].insert((cards[i], 1));
    }
    for mask in 1..full + 1 {
        // Each split once: the part holding the mask's lowest card.
        let low = mask & (0 - mask);
        let mut part = (mask - 1) & mask;
        while part > 0 {
            if part & low != 0 {
                let other = mask ^ part;
                let mut found: Vec[(i64, i64)] = Vec.new();
                for (an, ad) in values[part].iter() {
                    for (bn, bd) in values[other].iter() {
                        found.push(fraction(an * bd + bn * ad, ad * bd));
                        found.push(fraction(an * bd - bn * ad, ad * bd));
                        found.push(fraction(bn * ad - an * bd, ad * bd));
                        found.push(fraction(an * bn, ad * bd));
                        if bn != 0 {
                            found.push(fraction(an * bd, ad * bn));
                        }
                        if an != 0 {
                            found.push(fraction(bn * ad, bd * an));
                        }
                    }
                }
                for f in found {
                    values[mask].insert(f);
                }
            }
            part = (part - 1) & mask;
        }
    }
    values[full].contains((24, 1))
}

// ---- test harness ---------------------------------------------------------

fn show(cards: Vec[i64]) {
    let ok = judge_point24(cards.clone());
    println(f"{cards} -> {ok}");
}

fn main() {
    // The LeetCode examples, then corners: hands that need a fraction on
    // the way (8 / (3 - 8 / 3), 5 * (5 - 1 / 5)), a division that must
    // come last, all one card, and hands with no answer.
    show(vec![4, 1, 8, 7]);
    show(vec![1, 2, 1, 2]);
    show(vec![3, 3, 8, 8]);
    show(vec![1, 5, 5, 5]);
    show(vec![1, 3, 4, 6]);
    show(vec![1, 4, 5, 6]);
    show(vec![6, 6, 6, 6]);
    show(vec![1, 1, 1, 1]);
    show(vec![9, 9, 9, 9]);
    show(vec![1, 1, 1, 8]);
    show(vec![1, 1, 2, 6]);
    show(vec![3, 3, 7, 7]);
    // Every hand of four cards from 1 to 9, as a multiset: how many have
    // an answer, the solvable ones by their smallest card, and a checksum
    // over them in order.
    let mut solvable = 0;
    let mut hands = 0;
    let mut by_low = vec![0; 10];
    let mut sum = 0;
    for a in 1..10 {
        for b in a..10 {
            for c in b..10 {
                for d in c..10 {
                    hands += 1;
                    let ok = judge_point24(vec![a, b, c, d]);
                    let code = a * 1000 + b * 100 + c * 10 + d;
                    if ok {
                        solvable += 1;
                        by_low[a] += 1;
                        sum = (sum * 31 + code) % 1000000007;
                    } else {
                        sum = (sum * 31 + 7) % 1000000007;
                    }
                }
            }
        }
    }
    let mut lows: Vec[String] = Vec.new();
    for a in 1..10 {
        lows.push(f"{by_low[a]}");
    }
    println(f"{solvable} of {hands} hands solvable; by smallest card: {lows.join(" ")}");
    println(f"checksum {sum}");
    // The same hands in every order of their cards give the same answer.
    let mut agree = 0;
    let orders = [[0, 1, 2, 3], [3, 2, 1, 0], [1, 3, 0, 2], [2, 0, 3, 1]];
    for a in 1..10 {
        for b in a..10 {
            for c in b..10 {
                for d in c..10 {
                    let hand = [a, b, c, d];
                    let want = judge_point24(vec![a, b, c, d]);
                    let mut all = true;
                    for o in orders {
                        let got = judge_point24(vec![hand[o[0]], hand[o[1]], hand[o[2]], hand[o[3]]]);
                        if got != want {
                            all = false;
                        }
                    }
                    if all {
                        agree += 1;
                    }
                }
            }
        }
    }
    println(f"{agree} of {hands} hands agree in four orders");
}
