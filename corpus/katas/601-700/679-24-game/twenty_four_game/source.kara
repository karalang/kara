// LeetCode #679: 24 Game -- backtracking over pairs, in floating point.
//
// Any expression over the cards ends with one operation joining two
// smaller expressions, so repeatedly take two of the values left,
// replace them with their sum, difference either way, product or
// quotient either way, and recurse on the shorter list. One value left
// is a result; it counts as 24 when within 1e-6, since real division
// leaves fractions such as 8 / 3 inexact. With 4 cards that is at most
// 6 * 6 * 3 * 6 * 6 = 3888 results.

fn reach(values: Vec[f64]) -> bool {
    let n = values.len();
    if n == 1 {
        return (values[0] - 24.0).abs() < 0.000001;
    }
    for i in 0..n {
        for j in i + 1..n {
            let a = values[i];
            let b = values[j];
            let mut rest: Vec[f64] = Vec.new();
            for k in 0..n {
                if k != i and k != j {
                    rest.push(values[k]);
                }
            }
            let mut results = vec![a + b, a - b, b - a, a * b];
            if b != 0.0 {
                results.push(a / b);
            }
            if a != 0.0 {
                results.push(b / a);
            }
            for r in results {
                let mut next = rest.clone();
                next.push(r);
                if reach(next) {
                    return true;
                }
            }
        }
    }
    false
}

fn judge_point24(cards: Vec[i64]) -> bool {
    let mut values: Vec[f64] = Vec.new();
    for c in cards {
        values.push(c as f64);
    }
    reach(values)
}

// ---- test harness ---------------------------------------------------------

fn show(cards: Vec[i64]) {
    let ok = judge_point24(cards.clone());
    println(f"{cards} -> {ok}");
}

fn main() {
    // The LeetCode examples, then corners: hands that need a fraction on
    // the way (8 / (3 - 8 / 3), 5 * (5 - 1 / 5)), a division that must
    // come last, all one card, and hands with no answer.
    show(vec![4, 1, 8, 7]);
    show(vec![1, 2, 1, 2]);
    show(vec![3, 3, 8, 8]);
    show(vec![1, 5, 5, 5]);
    show(vec![1, 3, 4, 6]);
    show(vec![1, 4, 5, 6]);
    show(vec![6, 6, 6, 6]);
    show(vec![1, 1, 1, 1]);
    show(vec![9, 9, 9, 9]);
    show(vec![1, 1, 1, 8]);
    show(vec![1, 1, 2, 6]);
    show(vec![3, 3, 7, 7]);
    // Every hand of four cards from 1 to 9, as a multiset: how many have
    // an answer, the solvable ones by their smallest card, and a checksum
    // over them in order.
    let mut solvable = 0;
    let mut hands = 0;
    let mut by_low = vec![0; 10];
    let mut sum = 0;
    for a in 1..10 {
        for b in a..10 {
            for c in b..10 {
                for d in c..10 {
                    hands += 1;
                    let ok = judge_point24(vec![a, b, c, d]);
                    let code = a * 1000 + b * 100 + c * 10 + d;
                    if ok {
                        solvable += 1;
                        by_low[a] += 1;
                        sum = (sum * 31 + code) % 1000000007;
                    } else {
                        sum = (sum * 31 + 7) % 1000000007;
                    }
                }
            }
        }
    }
    let mut lows: Vec[String] = Vec.new();
    for a in 1..10 {
        lows.push(f"{by_low[a]}");
    }
    println(f"{solvable} of {hands} hands solvable; by smallest card: {lows.join(" ")}");
    println(f"checksum {sum}");
    // The same hands in every order of their cards give the same answer.
    let mut agree = 0;
    let orders = [[0, 1, 2, 3], [3, 2, 1, 0], [1, 3, 0, 2], [2, 0, 3, 1]];
    for a in 1..10 {
        for b in a..10 {
            for c in b..10 {
                for d in c..10 {
                    let hand = [a, b, c, d];
                    let want = judge_point24(vec![a, b, c, d]);
                    let mut all = true;
                    for o in orders {
                        let got = judge_point24(vec![hand[o[0]], hand[o[1]], hand[o[2]], hand[o[3]]]);
                        if got != want {
                            all = false;
                        }
                    }
                    if all {
                        agree += 1;
                    }
                }
            }
        }
    }
    println(f"{agree} of {hands} hands agree in four orders");
}
