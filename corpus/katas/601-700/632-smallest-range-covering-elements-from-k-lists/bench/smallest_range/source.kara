// LeetCode #632: Smallest Range Covering Elements from K Lists -- bench.
//
// The ★ arm on 10 inputs of 3,500 lists of 50 values from -100,000 to
// 100,000, the problem's largest, made once; then 30 rounds each
// answer one of them, adding up the widths and putting each range into
// a checksum.

fn smallest_range(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut queue: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    let mut high = nums[0][0];
    for list in 0..nums.len() {
        queue.push((nums[list][0], list, 0));
        high = high.max(nums[list][0]);
    }
    let mut best_low = 0;
    let mut best_high = 0;
    let mut found = false;
    loop {
        let (low, list, at) = queue.pop().unwrap();
        if not found or high - low < best_high - best_low {
            best_low = low;
            best_high = high;
            found = true;
        }
        if at + 1 == nums[list].len() {
            break;
        }
        let next = nums[list][at + 1];
        high = high.max(next);
        queue.push((next, list, at + 1));
    }
    vec![best_low, best_high]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` sorted lists of `length` values from -100,000 to 100,000.
fn random_lists(count: i64, length: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut nums: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut list: Vec[i64] = Vec.new();
        for _ in 0..length {
            let wide = next_random(mut seed) * 32768 + next_random(mut seed);
            list.push(wide % 200001 - 100000);
        }
        list.sort();
        nums.push(list);
    }
    nums
}

fn main() {
    let mut seed: i64 = 632;
    let mut inputs: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..10 {
        inputs.push(random_lists(3500, 50, mut seed));
    }
    let rounds = 30;
    let mut total = 0;
    let mut checksum = 0;
    for round in 0..rounds {
        let range = smallest_range(inputs[round % 10]);
        total += range[1] - range[0];
        checksum = (checksum * 31 + range[0] * 101 + range[1] + 100000000) % 1000000007;
    }
    println(f"10 inputs of 3500 lists, {rounds} rounds: total width {total}, checksum {checksum}");
}
