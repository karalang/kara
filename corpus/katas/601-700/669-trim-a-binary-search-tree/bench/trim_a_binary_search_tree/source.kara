// Benchmark for #669: the ★ arm (recursion, in place) on a large
// workload.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn trim_bst(root: Option[TreeNode], low: i64, high: i64) -> Option[TreeNode] {
    match root {
        None => None,
        Some(n) => {
            if n.val < low {
                trim_bst(n.right, low, high)
            } else if n.val > high {
                trim_bst(n.left, low, high)
            } else {
                n.left = trim_bst(n.left, low, high);
                n.right = trim_bst(n.right, low, high);
                Some(n)
            }
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn bst(values: Vec[i64]) -> Option[TreeNode] {
    let root = leaf(values[0]);
    for i in 1..values.len() {
        let v = values[i];
        let mut at = root;
        let mut placed = false;
        while not placed {
            if v < at.val {
                match at.left {
                    Some(l) => at = l,
                    None => {
                        at.left = Some(leaf(v));
                        placed = true;
                    }
                }
            } else {
                match at.right {
                    Some(r) => at = r,
                    None => {
                        at.right = Some(leaf(v));
                        placed = true;
                    }
                }
            }
        }
    }
    Some(root)
}

fn checksum(root: Option[TreeNode]) -> i64 {
    let mut sum = 0;
    let mut stack: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        stack.push(r);
    }
    while let Some(n) = stack.pop() {
        sum = (sum * 31 + n.val) % 1000000007;
        if let Some(r) = n.right {
            stack.push(r);
        }
        if let Some(l) = n.left {
            stack.push(l);
        }
    }
    sum
}

fn main() {
    // 0 to 9,999 in a random order, made once. Each round inserts them
    // into a fresh tree of the problem's largest size, 10,000 nodes,
    // trims it to a range picked by the round, and puts what is kept,
    // in preorder, into a checksum.
    let mut seed: i64 = 669;
    let mut order: Vec[i64] = Vec.new();
    for i in 0..10000 {
        order.push(i);
    }
    for i in 1..10000 {
        let j = next_random(mut seed) % (i + 1);
        let t = order[i];
        order[i] = order[j];
        order[j] = t;
    }
    let rounds = 300;
    let mut sum = 0;
    for r in 0..rounds {
        let low = r * 37 % 10000;
        let high = low + r * 53 % 5000;
        let kept = trim_bst(bst(order), low, high);
        sum = (sum * 31 + checksum(kept)) % 1000000007;
    }
    println(f"10000 nodes, {rounds} rounds: checksum {sum}");
}
