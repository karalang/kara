// LeetCode #685: Redundant Connection II -- walk the parent pointers.
//
// Keep each vertex's parent, skipping the later of two incoming edges
// when a vertex has two. With at most one parent each, the pointers form
// a forest unless they hold a cycle, and walking up from every vertex,
// colouring the vertices on the current walk, finds one in O(n). No
// cycle: the skipped edge is the answer. A cycle and a skipped edge: the
// other incoming edge, which the cycle runs through. A cycle and nothing
// skipped: the cycle's edge last in the input. O(n) time and space.

fn find_redundant_directed_connection(edges: Vec[(i64, i64)]) -> (i64, i64) {
    let n = edges.len();
    let mut up: Vec[i64] = vec![0; n + 1];
    let mut into: Vec[i64] = vec![-1; n + 1];
    let mut first = -1;
    let mut second = -1;
    for i in 0..n {
        let (a, b) = edges[i];
        if into[b] == -1 {
            into[b] = i;
            up[b] = a;
        } else {
            first = into[b];
            second = i;
        }
    }
    // 0: not seen, 1: on the current walk, 2: done.
    let mut color: Vec[i64] = vec![0; n + 1];
    let mut on_cycle: Vec[bool] = vec![false; n + 1];
    let mut found = false;
    for start in 1..n + 1 {
        let mut v = start;
        while v != 0 and color[v] == 0 {
            color[v] = 1;
            v = up[v];
        }
        if v != 0 and color[v] == 1 {
            found = true;
            let mut w = v;
            loop {
                on_cycle[w] = true;
                w = up[w];
                if w == v {
                    break;
                }
            }
        }
        let mut u = start;
        while u != 0 and color[u] == 1 {
            color[u] = 2;
            u = up[u];
        }
    }
    if not found {
        return edges[second];
    }
    if second != -1 {
        return edges[first];
    }
    let mut k = n - 1;
    loop {
        let (a, b) = edges[k];
        if on_cycle[a] and on_cycle[b] {
            return (a, b);
        }
        k -= 1;
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(edges: Vec[(i64, i64)]) {
    println(f"{edges} -> {find_redundant_directed_connection(edges.clone())}");
}

// Whether the parent pointers `up` (0 for the root) make a tree: every
// vertex reaches the root within n steps.
fn is_tree(up: ref Vec[i64], n: i64) -> bool {
    for v in 1..n + 1 {
        let mut w = v;
        let mut steps = 0;
        while up[w] != 0 {
            w = up[w];
            steps += 1;
            if steps > n {
                return false;
            }
        }
    }
    true
}

// A random rooted tree on 1 to n with one more edge, the edges in a
// random order.
fn random_graph(seed: mut ref i64, n: i64) -> Vec[(i64, i64)] {
    let mut name: Vec[i64] = Vec.new();
    for v in 1..n + 1 {
        name.push(v);
    }
    let mut i = n - 1;
    while i > 0 {
        let j = next_random(seed) % (i + 1);
        name.swap(i, j);
        i -= 1;
    }
    let mut up: Vec[i64] = vec![0; n + 1];
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for v in 1..n {
        let a = name[next_random(seed) % v];
        up[name[v]] = a;
        edges.push((a, name[v]));
    }
    loop {
        let a = 1 + next_random(seed) % n;
        let b = 1 + next_random(seed) % n;
        if a != b and up[b] != a {
            edges.push((a, b));
            break;
        }
    }
    let mut k = n - 1;
    while k > 0 {
        let j = next_random(seed) % (k + 1);
        edges.swap(k, j);
        k -= 1;
    }
    edges
}

fn main() {
    show([(1, 2), (1, 3), (2, 3)]);
    show([(1, 2), (2, 3), (3, 4), (4, 1), (1, 5)]);
    show([(2, 1), (3, 1), (4, 2), (1, 4)]);
    show([(3, 1), (2, 1), (4, 2), (1, 4)]);
    show([(1, 2), (2, 3), (3, 1)]);
    show([(3, 1), (1, 2), (2, 3)]);
    show([(1, 2), (2, 1), (1, 3)]);
    show([(2, 1), (1, 2), (1, 3)]);
    show([(4, 1), (1, 2), (2, 3), (3, 4), (1, 5)]);
    show([(5, 2), (5, 3), (2, 4), (4, 1), (3, 4)]);
    show([(6, 3), (8, 4), (9, 6), (3, 2), (5, 10), (10, 7), (2, 1), (7, 6), (4, 5), (2, 8)]);

    // Every rooted tree on 3 to 5 vertices with every edge it does not
    // have added, at a place that depends on the edge, the edges listed
    // in order and in reverse.
    let mut graphs = 0;
    let mut sum = 0;
    for n in 3..6 {
        let mut total = 1;
        for _ in 0..n {
            total *= n + 1;
        }
        for code in 0..total {
            let mut up: Vec[i64] = vec![0; n + 1];
            let mut c = code;
            let mut roots = 0;
            let mut fits = true;
            for v in 1..n + 1 {
                up[v] = c % (n + 1);
                c /= n + 1;
                if up[v] == 0 {
                    roots += 1;
                }
                if up[v] == v {
                    fits = false;
                }
            }
            if fits and roots == 1 and is_tree(up, n) {
                for a in 1..n + 1 {
                    for b in 1..n + 1 {
                        if a != b and up[b] != a {
                            let mut edges: Vec[(i64, i64)] = Vec.new();
                            for v in 1..n + 1 {
                                if up[v] != 0 {
                                    edges.push((up[v], v));
                                }
                            }
                            edges.insert((a * 7 + b) % n, (a, b));
                            graphs += 1;
                            let (p, q) = find_redundant_directed_connection(edges.clone());
                            edges.reverse();
                            let (r, s) = find_redundant_directed_connection(edges);
                            sum = (sum * 31 + p * 1000 + q * 100 + r * 10 + s) % 1000000007;
                        }
                    }
                }
            }
        }
    }
    println(f"rooted trees with one more edge on 3 to 5 vertices: {graphs}, checksum {sum}");

    // Random graphs of up to 1,000 vertices.
    let mut seed = 685;
    let mut checksum = 0;
    for _ in 0..200 {
        let n = 3 + next_random(mut seed) % 998;
        let (a, b) = find_redundant_directed_connection(random_graph(mut seed, n));
        checksum = (checksum * 31 + a * 1009 + b) % 1000000007;
    }
    println(f"200 random graphs: checksum {checksum}");
}
