// LeetCode #685: Redundant Connection II -- union-find and two
// candidates. Bench.
//
// 100 random rooted trees of 20,000 vertices, each with one more directed
// edge, are built once; then 30 rounds answer every graph.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut v = x;
    while parent[v] != v {
        parent[v] = parent[parent[v]];
        v = parent[v];
    }
    v
}

fn find_redundant_directed_connection(edges: Vec[(i64, i64)]) -> (i64, i64) {
    let n = edges.len();
    let mut into: Vec[i64] = vec![-1; n + 1];
    let mut first = -1;
    let mut second = -1;
    for i in 0..n {
        let (_, b) = edges[i];
        if into[b] == -1 {
            into[b] = i;
        } else {
            first = into[b];
            second = i;
        }
    }
    let mut parent: Vec[i64] = Vec.new();
    for v in 0..n + 1 {
        parent.push(v);
    }
    for i in 0..n {
        if i != second {
            let (a, b) = edges[i];
            let ra = find(mut parent, a);
            let rb = find(mut parent, b);
            if ra == rb {
                return if first == -1 { edges[i] } else { edges[first] };
            }
            parent[rb] = ra;
        }
    }
    edges[second]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let n = 20000;
    let rounds = 30;
    let mut seed = 685;
    let mut graphs: Vec[Vec[(i64, i64)]] = Vec.new();
    for _ in 0..count {
        let mut name: Vec[i64] = Vec.new();
        for v in 1..n + 1 {
            name.push(v);
        }
        let mut i = n - 1;
        while i > 0 {
            let j = next_random(mut seed) % (i + 1);
            name.swap(i, j);
            i -= 1;
        }
        let mut up: Vec[i64] = vec![0; n + 1];
        let mut edges: Vec[(i64, i64)] = Vec.new();
        for v in 1..n {
            let a = name[next_random(mut seed) % v];
            up[name[v]] = a;
            edges.push((a, name[v]));
        }
        loop {
            let a = 1 + next_random(mut seed) % n;
            let b = 1 + next_random(mut seed) % n;
            if a != b and up[b] != a {
                edges.push((a, b));
                break;
            }
        }
        let mut k = n - 1;
        while k > 0 {
            let j = next_random(mut seed) % (k + 1);
            edges.swap(k, j);
            k -= 1;
        }
        graphs.push(edges);
    }
    let mut sum = 0;
    for r in 0..rounds {
        for c in 0..count {
            let (a, b) = find_redundant_directed_connection(graphs[c]);
            sum = (sum * 31 + a * 20011 + b + r) % 1000000007;
        }
    }
    println(f"{count * rounds} graphs answered, checksum {sum}");
}
