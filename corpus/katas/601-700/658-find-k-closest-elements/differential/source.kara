// LeetCode #658: differential -- the four arms against the definition.
//
// Copies of the four arms, held to five properties on random arrays.

// ---- star arm ----------------------------------------------------------

fn find_closest_elements_star(arr: Vec[i64], k: i64, x: i64) -> Vec[i64] {
    let mut low = 0;
    let mut high = arr.len() - k;
    while low < high {
        let middle = (low + high) / 2;
        if x - arr[middle] > arr[middle + k] - x {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for i in low..low + k {
        out.push(arr[i]);
    }
    out
}

// ---- shrink arm --------------------------------------------------------

fn find_closest_elements_shrink(arr: Vec[i64], k: i64, x: i64) -> Vec[i64] {
    let mut low = 0;
    let mut high = arr.len() - 1;
    while high - low + 1 > k {
        if (arr[low] - x).abs() > (arr[high] - x).abs() {
            low += 1;
        } else {
            high -= 1;
        }
    }
    arr[low..high + 1].to_vec()
}

// ---- sorted arm --------------------------------------------------------

fn find_closest_elements_sorted(arr: Vec[i64], k: i64, x: i64) -> Vec[i64] {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for a in arr.iter() {
        pairs.push(((a - x).abs(), a));
    }
    pairs.sort();
    let mut out: Vec[i64] = Vec.new();
    for i in 0..k {
        out.push(pairs[i].1);
    }
    out.sort();
    out
}

// ---- expand arm --------------------------------------------------------

fn find_closest_elements_expand(arr: Vec[i64], k: i64, x: i64) -> Vec[i64] {
    let n = arr.len();
    let mut low = 0;
    let mut high = n;
    while low < high {
        let middle = (low + high) / 2;
        if arr[middle] < x {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    // The window is `left + 1 .. right`, empty to start.
    let mut left = low - 1;
    let mut right = low;
    for _ in 0..k {
        if left < 0 {
            right += 1;
        } else if right >= n {
            left -= 1;
        } else if x - arr[left] <= arr[right] - x {
            left -= 1;
        } else {
            right += 1;
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for i in left + 1..right {
        out.push(arr[i]);
    }
    out
}

// ---- the definition and the properties -------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, arr: Vec[i64], k: i64, x: i64) -> Vec[i64] {
    match which {
        0 => find_closest_elements_star(arr, k, x),
        1 => find_closest_elements_shrink(arr, k, x),
        2 => find_closest_elements_sorted(arr, k, x),
        _ => find_closest_elements_expand(arr, k, x),
    }
}

// Whether `a` is closer to `x` than `b`, the smaller winning a tie.
fn closer(a: i64, b: i64, x: i64) -> bool {
    (a - x).abs() < (b - x).abs() or ((a - x).abs() == (b - x).abs() and a < b)
}

// The definition: take the closest number left, `k` times, then put them
// in order.
fn definition(arr: Vec[i64], k: i64, x: i64) -> Vec[i64] {
    let mut taken = vec![false; arr.len()];
    let mut out: Vec[i64] = Vec.new();
    for _ in 0..k {
        let mut best = -1;
        for i in 0..arr.len() {
            if not taken[i] and (best == -1 or closer(arr[i], arr[best], x)) {
                best = i;
            }
        }
        taken[best] = true;
        out.push(arr[best]);
    }
    out.sort();
    out
}

fn main() {
    // 1,000 random sorted arrays of 1 to 30 numbers from -10 to 10, so
    // that ties and repeats are common, with `k` from 1 to `n` and `x`
    // from -15 to 15.
    let cases = 1000;
    let mut seed: i64 = 658;
    let mut numbers = 0;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    for _ in 0..cases {
        let n = 1 + next_random(mut seed) % 30;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(next_random(mut seed) % 21 - 10);
        }
        arr.sort();
        numbers += n;
        let k = 1 + next_random(mut seed) % n;
        let x = next_random(mut seed) % 31 - 15;
        let want = definition(arr, k, x);
        let shift = next_random(mut seed) % 201 - 100;
        let mut moved: Vec[i64] = Vec.new();
        for a in arr.iter() {
            moved.push(a + shift);
        }
        for which in 0..4 {
            let got = answer(which, arr, k, x);
            // P2: `k` numbers, side by side in the array.
            let mut window = false;
            if got.len() == k {
                for s in 0..n - k + 1 {
                    if arr[s..s + k].to_vec() == got {
                        window = true;
                    }
                }
            }
            // P3: no number left out is closer than one kept.
            let mut beaten = false;
            if window {
                let mut rest = arr.clone();
                for g in got.iter() {
                    let at = rest.iter().position(|r| r == g).unwrap();
                    rest.remove(at);
                }
                for r in rest.iter() {
                    for g in got.iter() {
                        if closer(r, g, x) {
                            beaten = true;
                        }
                    }
                }
            }
            // P4: moving every number and `x` alike moves the answer.
            let mut shifted = answer(which, moved, k, x + shift);
            for s in shifted.iter_mut() {
                *s -= shift;
            }
            // P5: the answer is inside the answer for one more.
            let mut nested = true;
            if k < n {
                let more = answer(which, arr, k + 1, x);
                let mut j = 0;
                for g in got.iter() {
                    while j < more.len() and more[j] != g {
                        j += 1;
                    }
                    if j == more.len() {
                        nested = false;
                    } else {
                        j += 1;
                    }
                }
            }
            let ok = vec![
                // P1: the definition's numbers.
                got == want,
                window,
                window and not beaten,
                shifted == got,
                nested,
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                }
            }
        }
    }
    let all = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{cases} arrays ({numbers} numbers), 4 arms, {checks} checks, {all} failures");
    if all > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
