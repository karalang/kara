// LeetCode #658: Find K Closest Elements -- binary search for the window.
//
// The answer is always `k` neighbours in the sorted array, so only where
// the window starts is unknown. A window starting at `s` should move
// right exactly when the number just past its end is closer to `x` than
// the number at its start, and that test is false then true as `s`
// grows, so a binary search over `0..=n - k` finds the start.
// O(log(n - k) + k).

fn find_closest_elements(arr: Vec[i64], k: i64, x: i64) -> Vec[i64] {
    let mut low = 0;
    let mut high = arr.len() - k;
    while low < high {
        let middle = (low + high) / 2;
        if x - arr[middle] > arr[middle + k] - x {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for i in low..low + k {
        out.push(arr[i]);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(arr: Vec[i64], k: i64, x: i64) {
    let got = find_closest_elements(arr, k, x);
    let mut cells: Vec[String] = Vec.new();
    for a in arr.iter() {
        cells.push(f"{a}");
    }
    let mut picked: Vec[String] = Vec.new();
    for a in got.iter() {
        picked.push(f"{a}");
    }
    println(f"[{cells.join(",")}], k = {k}, x = {x} -> [{picked.join(",")}]");
}

// `n` sorted numbers from -`spread` to `spread`.
fn random_sorted(n: i64, spread: i64, seed: mut ref i64) -> Vec[i64] {
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push(next_random(mut seed) % (2 * spread + 1) - spread);
    }
    arr.sort();
    arr
}

fn checksum(got: Vec[i64]) -> i64 {
    let mut h = 0;
    for a in got.iter() {
        h = (h * 31 + a + 20000) % 1000000007;
    }
    h
}

fn main() {
    // The two LeetCode examples.
    show(vec![1, 2, 3, 4, 5], 4, 3);
    show(vec![1, 1, 2, 3, 4, 5], 4, -1);
    // One number; all of them; `x` past the right end; a tie between the
    // two sides, the smaller number winning; repeated numbers.
    show(vec![7], 1, 100);
    show(vec![-3, 0, 4], 3, 1);
    show(vec![1, 2, 3, 4, 5], 2, 99);
    show(vec![1, 3, 5, 7], 1, 4);
    show(vec![2, 2, 2, 5, 5, 5], 4, 4);
    // 300 random arrays of 1 to 50 numbers from -20 to 20, so that ties
    // and repeats are common, with `k` from 1 to `n` and `x` from -25 to
    // 25.
    let mut seed: i64 = 658;
    let mut sum = 0;
    let mut total = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 50;
        let arr = random_sorted(n, 20, mut seed);
        let k = 1 + next_random(mut seed) % n;
        let x = next_random(mut seed) % 51 - 25;
        let got = find_closest_elements(arr, k, x);
        for a in got.iter() {
            total += a;
        }
        sum = (sum * 7 + checksum(got)) % 1000000007;
    }
    println(f"300 random arrays: total {total}, checksum {sum}");
    // The problem's largest, 10,000 numbers from -10,000 to 10,000: a
    // window in the middle, all of them, and one from far off the left.
    let arr = random_sorted(10000, 10000, mut seed);
    println(f"10000 numbers, k = 100, x = 17: checksum {checksum(find_closest_elements(arr, 100, 17))}");
    println(f"10000 numbers, k = 10000, x = 0: checksum {checksum(find_closest_elements(arr, 10000, 0))}");
    println(f"10000 numbers, k = 3, x = -10000: checksum {checksum(find_closest_elements(arr, 3, -10000))}");
}
