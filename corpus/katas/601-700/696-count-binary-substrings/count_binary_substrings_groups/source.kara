// LeetCode #696: Count Binary Substrings -- the list of runs.
//
// Split the string into its runs, keeping only their lengths, then add
// min(a, b) for every two neighbouring runs. The same count as one pass,
// with the runs written down first. O(n) time and space.

fn count_binary_substrings(s: String) -> i64 {
    let b = s.bytes();
    let mut runs: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let mut j = i;
        while j < b.len() and b[j] == b[i] {
            j += 1;
        }
        runs.push(j - i);
        i = j;
    }
    let mut count = 0;
    for k in 1..runs.len() {
        count += runs[k - 1].min(runs[k]);
    }
    count
}

// ---- harness ---------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Runs of alternating characters, each 1 to `longest` long, until the
// string has `n` characters.
fn random_runs(n: i64, longest: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    let mut bit = next_random(mut seed) % 2;
    while s.len() < n {
        let run = 1 + next_random(mut seed) % longest;
        for _ in 0..run {
            if s.len() < n {
                s.push(if bit == 0 { '0' } else { '1' });
            }
        }
        bit = 1 - bit;
    }
    s
}

fn main() {
    // The two LeetCode examples.
    println(f"example 1: {count_binary_substrings("00110011".to_string())}");
    println(f"example 2: {count_binary_substrings("10101".to_string())}");
    // The shortest strings, one run, and two runs of unequal length.
    let one = count_binary_substrings("0".to_string());
    let two = count_binary_substrings("01".to_string());
    let same = count_binary_substrings("0000".to_string());
    println(f"0: {one}, 01: {two}, 0000: {same}");
    let three = count_binary_substrings("000111".to_string());
    let uneven = count_binary_substrings("0001111".to_string());
    println(f"000111: {three}, 0001111: {uneven}");
    // 2,000 zeros then 2,000 ones; 100,000 characters alternating.
    let mut blocks = String.new();
    for i in 0..4000 {
        blocks.push(if i < 2000 { '0' } else { '1' });
    }
    let mut alternating = String.new();
    for i in 0..100000 {
        alternating.push(if i % 2 == 0 { '1' } else { '0' });
    }
    println(f"two blocks of 2000: {count_binary_substrings(blocks)}, 100000 alternating: {count_binary_substrings(alternating)}");
    // 100,000 characters in runs of 1 to 20, and 300 random strings of up
    // to 2,000 characters in runs of 1 to 1 up to 1 to 50, with a checksum.
    let mut seed = 696;
    println(f"100000 in runs of up to 20: {count_binary_substrings(random_runs(100000, 20, mut seed))}");
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 2000;
        let longest = 1 + next_random(mut seed) % 50;
        let r = count_binary_substrings(random_runs(n, longest, mut seed));
        total += r;
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"300 random strings: {total} substrings in all, checksum {checksum}");
}
