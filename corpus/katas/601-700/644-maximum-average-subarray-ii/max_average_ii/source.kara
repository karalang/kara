// LeetCode #644: Maximum Average Subarray II -- binary search on the
// average.
//
// Whether some subarray of `k` or more values averages at least `m` is a
// question about sums: it does when its sum less `m` times its length is
// 0 or more. For an end `i` the best start is the `j <= i - k` with the
// smallest `prefix[j] - m * j`, so one pass, keeping that start as the
// end moves, answers it. The answer lies between the smallest and the
// largest value, so 100 halvings of that range pin it down far below the
// gap of at least 1 / n^2 between two different averages, and the
// subarray the last successful check found is a best one: the answer is
// its exact average, its integer sum divided by its length. Each test
// subtracts `m` from an exact integer sum rather than adding up shifted
// values, so its rounding error stays far below that gap.
// O(n log range).

// The start and end of a subarray of `k` or more values averaging at
// least `m`, or (-1, -1) if there is none.
fn reaches(prefix: Vec[i64], k: i64, m: f64) -> (i64, i64) {
    let mut lowest = 0;
    for end in k..prefix.len() {
        let c = end - k;
        // `prefix[c] - m * c` below `prefix[lowest] - m * lowest`.
        if ((prefix[c] - prefix[lowest]) as f64) < m * (c - lowest) as f64 {
            lowest = c;
        }
        if ((prefix[end] - prefix[lowest]) as f64) >= m * (end - lowest) as f64 {
            return (lowest, end);
        }
    }
    (-1, -1)
}

fn find_max_average(nums: Vec[i64], k: i64) -> f64 {
    let mut prefix: Vec[i64] = vec![0];
    for x in nums.iter() {
        prefix.push(prefix[prefix.len() - 1] + *x);
    }
    let mut lo = nums[0] as f64;
    let mut hi = nums[0] as f64;
    for x in nums.iter() {
        lo = lo.min(*x as f64);
        hi = hi.max(*x as f64);
    }
    // The whole array averages at least the smallest value.
    let mut best = (0, nums.len());
    for _ in 0..100 {
        let mid = (lo + hi) / 2.0;
        let (start, end) = reaches(prefix, k, mid);
        if start == -1 {
            hi = mid;
        } else {
            lo = mid;
            best = (start, end);
        }
    }
    let (start, end) = best;
    (prefix[end] - prefix[start]) as f64 / (end - start) as f64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], k: i64) {
    let mut text = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            text.push_str(",");
        }
        text.push_str(f"{nums[i]}");
    }
    println(f"[{text}], k = {k} -> {find_max_average(nums, k):.5}");
}

// `n` values from `-most` to `most`.
fn random_values(n: i64, most: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(next_random(mut seed) % (2 * most + 1) - most);
    }
    nums
}

fn main() {
    // The two LeetCode examples.
    show(vec![1, 12, -5, -6, 50, 3], 4);
    show(vec![5], 1);
    // The best `k` values found in two places; the whole array as the
    // only choice; every value equal; every value negative; one best
    // average reached by 4 values and by 8; a best subarray of 8 values
    // when every one of exactly 7 is worse; and the extremes of the
    // values.
    show(vec![1, 9, 9, 1, 9, 9, 1], 2);
    show(vec![3, -1, 4, -1, 5], 5);
    show(vec![7, 7, 7, 7], 3);
    show(vec![-5, -2, -9, -1, -4], 2);
    show(vec![0, 5, 5, 5, 0, 0, 5, 5, 5, 0], 4);
    show(vec![1, 2, 2, 1, 2, 2, 1, 2, 2, 1, 2, 2, 1], 7);
    show(vec![-10000, 10000, 10000, -10000, 10000], 2);
    // 300 random arrays of 1 to 30 values from -20 to 20, `k` picked from
    // 1 to n.
    let mut seed: i64 = 644;
    let mut total = 0.0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 30;
        let k = 1 + next_random(mut seed) % n;
        let nums = random_values(n, 20, mut seed);
        total += find_max_average(nums, k);
    }
    println(f"300 random arrays: sum of answers {total:.5}");
    // The problem's largest: 10,000 values from -10,000 to 10,000, at four
    // widths.
    let nums = random_values(10000, 10000, mut seed);
    for k in vec![1, 100, 2500, 10000] {
        println(f"10000 values, k = {k}: {find_max_average(nums, k):.5}");
    }
}
