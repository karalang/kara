// Benchmark for #678: the range of open counts, the ★ arm.
//
// Read left to right and keep the least and the most number of `(` that
// could be open so far, a `*` counting as `)` for the least and as `(`
// for the most. The most falling below 0 means too many `)`; the least
// is kept at 0, since no reading may close more than is open. Every
// count between the two is reachable, so the string is valid exactly
// when the least ends at 0. O(n) time, O(1) space.

fn check_valid_string(s: String) -> bool {
    let mut low = 0;
    let mut high = 0;
    for c in s.bytes() {
        if c == b'(' {
            low += 1;
            high += 1;
        } else if c == b')' {
            low -= 1;
            high -= 1;
        } else {
            low -= 1;
            high += 1;
        }
        if high < 0 {
            return false;
        }
        if low < 0 {
            low = 0;
        }
    }
    low == 0
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A string of 1 to 100 characters, as the tests make them: a third
// uniform over the three characters, the rest a balanced string with
// some characters made `*` and a few others changed.
fn random_string(seed: mut ref i64, c: i64) -> String {
    let mut s = String.new();
    if c % 3 == 0 {
        let n = 1 + next_random(seed) % 100;
        for _ in 0..n {
            let d = next_random(seed) % 3;
            if d == 0 {
                s.push('(');
            } else if d == 1 {
                s.push(')');
            } else {
                s.push('*');
            }
        }
        return s;
    }
    let half = 1 + next_random(seed) % 50;
    let mut open = 0;
    let mut left = half;
    let mut b = String.new();
    while left > 0 or open > 0 {
        if left > 0 and (open == 0 or next_random(seed) % 2 == 0) {
            b.push('(');
            open += 1;
            left -= 1;
        } else {
            b.push(')');
            open -= 1;
        }
    }
    let stars = next_random(seed) % 4;
    let changes = next_random(seed) % 3;
    for ch in b.bytes() {
        let r = next_random(seed) % 10;
        if r < stars {
            s.push('*');
        } else if r == 9 and next_random(seed) % 3 < changes {
            if ch == b'(' {
                s.push(')');
            } else {
                s.push('(');
            }
        } else {
            s.push(ch as char);
        }
    }
    s
}

fn main() {
    // 20,000 strings made once, then 100 rounds that check every one of
    // them in an order that changes with the round, each answer and
    // length going into a checksum.
    let count = 20000;
    let rounds = 100;
    let mut seed: i64 = 678;
    let mut strings: Vec[String] = Vec.new();
    for c in 0..count {
        strings.push(random_string(mut seed, c));
    }
    let mut sum = 0;
    let mut valid = 0;
    for r in 0..rounds {
        for i in 0..count {
            let k = (i * 7919 + r * 104729) % count;
            let n = strings[k].len() as i64;
            if check_valid_string(strings[k]) {
                valid += 1;
                sum = (sum * 31 + n) % 1000000007;
            } else {
                sum = (sum * 31 + 1000 + n) % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds of {count} strings: {valid} valid, checksum {sum}");
}
