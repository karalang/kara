// LeetCode #682: differential -- the four arms against the definition.
//
// Copies of the four arms, held to five properties on random lists of operations.

// ---- star arm ----------------------------------------------------------

fn cal_points_star(operations: Vec[String]) -> i64 {
    let mut record: Vec[i64] = Vec.new();
    for op in operations.iter() {
        if op == "+" {
            let n = record.len();
            record.push(record[n - 1] + record[n - 2]);
        } else if op == "D" {
            let n = record.len();
            record.push(record[n - 1] * 2);
        } else if op == "C" {
            record.pop();
        } else {
            record.push(i64.parse(op).unwrap());
        }
    }
    let mut total = 0;
    for x in record.iter() {
        total += *x;
    }
    total
}

// ---- running arm -------------------------------------------------------

fn cal_points_running(operations: Vec[String]) -> i64 {
    let mut record: Vec[i64] = Vec.new();
    let mut total = 0;
    for op in operations.iter() {
        let n = record.len();
        let score = match op {
            "+" => record[n - 1] + record[n - 2],
            "D" => 2 * record[n - 1],
            "C" => {
                total -= record.pop().unwrap();
                continue;
            }
            _ => i64.parse(op).unwrap(),
        };
        record.push(score);
        total += score;
    }
    total
}

// ---- typed arm ---------------------------------------------------------

enum Op {
    Score(i64),
    Sum,
    Double,
    Cancel,
}

fn parse_op_typed(text: String) -> Op {
    if text == "+" {
        Op.Sum
    } else if text == "D" {
        Op.Double
    } else if text == "C" {
        Op.Cancel
    } else {
        Op.Score(i64.parse(text).unwrap())
    }
}

fn cal_points_typed(operations: Vec[String]) -> i64 {
    let ops: Vec[Op] = operations.iter().map(|s| parse_op_typed(s)).collect();
    let mut scores: Vec[i64] = vec![0; ops.len()];
    let mut top = 0;
    for op in ops.iter() {
        match op {
            Op.Score(x) => {
                scores[top] = x;
                top += 1;
            }
            Op.Sum => {
                scores[top] = scores[top - 1] + scores[top - 2];
                top += 1;
            }
            Op.Double => {
                scores[top] = scores[top - 1] * 2;
                top += 1;
            }
            Op.Cancel => {
                top -= 1;
            }
        }
    }
    let mut total = 0;
    for k in 0..top {
        total += scores[k];
    }
    total
}

// ---- recursive arm -----------------------------------------------------

fn record_after_recursive(operations: ref Vec[String], k: i64) -> Vec[i64] {
    if k == 0 {
        return Vec.new();
    }
    let mut record = record_after_recursive(operations, k - 1);
    let op = ref operations[k - 1];
    let n = record.len();
    if op == "C" {
        record.pop();
    } else if op == "D" {
        record.push(record[n - 1] * 2);
    } else if op == "+" {
        record.push(record[n - 1] + record[n - 2]);
    } else {
        record.push(i64.parse(op).unwrap());
    }
    record
}

fn cal_points_recursive(operations: Vec[String]) -> i64 {
    record_after_recursive(operations, operations.len()).iter().sum()
}

// ---- the definition and the properties ------------------------------------

fn answer(which: i64, operations: Vec[String]) -> i64 {
    if which == 0 {
        cal_points_star(operations)
    } else if which == 1 {
        cal_points_running(operations)
    } else if which == 2 {
        cal_points_typed(operations)
    } else {
        cal_points_recursive(operations)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn abs(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

// The index of the last score written and not crossed out, before `end`.
fn last_live(written: ref Vec[i64], crossed: ref Vec[bool], end: i64) -> i64 {
    let mut k = end - 1;
    while crossed[k] {
        k -= 1;
    }
    k
}

// The definition, as a scorekeeper would play it on paper: every score
// is written down and never erased; `C` crosses out the last score not
// yet crossed out, and `+` and `D` read the last one or two of those.
// The answer is the sum of the scores not crossed out.
fn definition(operations: ref Vec[String]) -> i64 {
    let mut written: Vec[i64] = Vec.new();
    let mut crossed: Vec[bool] = Vec.new();
    for op in operations.iter() {
        let n = written.len();
        if op == "C" {
            let k = last_live(written, crossed, n);
            crossed[k] = true;
        } else {
            let mut value = 0;
            if op == "D" {
                value = 2 * written[last_live(written, crossed, n)];
            } else if op == "+" {
                let a = last_live(written, crossed, n);
                let b = last_live(written, crossed, a);
                value = written[a] + written[b];
            } else {
                value = i64.parse(op).unwrap();
            }
            written.push(value);
            crossed.push(false);
        }
    }
    let mut total = 0;
    for k in 0..written.len() {
        if not crossed[k] {
            total += written[k];
        }
    }
    total
}

// A random list of `n` operations that can all be played, with numbers
// from -`span` to `span` and no score past 2^30 in size.
fn random_ops(seed: mut ref i64, n: i64, span: i64) -> Vec[String] {
    let limit = 1073741824;
    let mut record: Vec[i64] = Vec.new();
    let mut out: Vec[String] = Vec.new();
    while out.len() < n {
        let k = record.len();
        let pick = next_random(mut seed) % 8;
        if pick == 0 and k >= 1 {
            record.pop();
            out.push("C".to_string());
        } else if pick == 1 and k >= 1 and abs(record[k - 1]) < limit / 2 {
            record.push(record[k - 1] * 2);
            out.push("D".to_string());
        } else if pick == 2 and k >= 2 and abs(record[k - 1] + record[k - 2]) < limit {
            record.push(record[k - 1] + record[k - 2]);
            out.push("+".to_string());
        } else if pick >= 3 {
            let x = next_random(mut seed) % (2 * span + 1) - span;
            record.push(x);
            out.push(f"{x}");
        }
    }
    out
}

fn with(operations: ref Vec[String], more: ref Vec[String]) -> Vec[String] {
    let mut out = operations.clone();
    for op in more.iter() {
        out.push(op.clone());
    }
    out
}

// Every number written with the other sign.
fn negated(operations: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for op in operations.iter() {
        if op == "+" or op == "D" or op == "C" {
            out.push(op.clone());
        } else {
            out.push(f"{0 - i64.parse(op).unwrap()}");
        }
    }
    out
}

fn main() {
    let mut seed = 6820;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0, 0];
    let cases = 600;
    for c in 0..cases {
        let n = 1 + next_random(mut seed) % 60;
        let span = if c % 2 == 0 { 9 } else { 30000 };
        let ops = random_ops(mut seed, n, span);
        let other = random_ops(mut seed, 1 + next_random(mut seed) % 20, span);
        let x = next_random(mut seed) % (2 * span + 1) - span;
        let want = definition(ops);
        let crossed = with(ops, [f"{x}", "C".to_string()]);
        let doubled = with(ops, [f"{x}", "D".to_string()]);
        let joined = with(ops, other);
        let flipped = negated(ops);
        for which in 0..arms {
            let got = answer(which, ops.clone());
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: a number and then `C` at the end change nothing.
            checks += 1;
            if answer(which, crossed.clone()) != got {
                fails[1] += 1;
            }
            // P3: a number x and then `D` at the end add 3x.
            checks += 1;
            if answer(which, doubled.clone()) != got + 3 * x {
                fails[2] += 1;
            }
            // P4: a list that can be played on its own, played after
            // this one, adds its own answer.
            checks += 1;
            if answer(which, joined.clone()) != got + answer(which, other.clone()) {
                fails[3] += 1;
            }
            // P5: every number negated negates the answer.
            checks += 1;
            if answer(which, flipped.clone()) != 0 - got {
                fails[4] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut total = 0;
    for k in 0..5 {
        if fails[k] > 0 {
            report.push_str(f"P{k + 1}: {fails[k]} failures | ");
        }
        total += fails[k];
    }
    println(f"{report}{cases} lists, {arms} arms, {checks} checks, {total} failures");
}
