// LeetCode #682: Baseball Game -- a stack of the valid scores. Bench.
//
// 200 lists of 5,000 operations that can all be played are built once;
// then 30 rounds score every list, in an order that changes each round.

fn cal_points(operations: Vec[String]) -> i64 {
    let mut record: Vec[i64] = Vec.new();
    for op in operations.iter() {
        if op == "+" {
            let n = record.len();
            record.push(record[n - 1] + record[n - 2]);
        } else if op == "D" {
            let n = record.len();
            record.push(record[n - 1] * 2);
        } else if op == "C" {
            record.pop();
        } else {
            record.push(i64.parse(op).unwrap());
        }
    }
    let mut total = 0;
    for x in record.iter() {
        total += *x;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn abs(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

fn random_ops(seed: mut ref i64, n: i64) -> Vec[String] {
    let limit = 1073741824;
    let mut record: Vec[i64] = Vec.new();
    let mut out: Vec[String] = Vec.new();
    while out.len() < n {
        let k = record.len();
        let pick = next_random(mut seed) % 10;
        if pick == 0 and k >= 1 {
            record.pop();
            out.push("C".to_string());
        } else if pick == 1 and k >= 1 and abs(record[k - 1]) < limit / 2 {
            record.push(record[k - 1] * 2);
            out.push("D".to_string());
        } else if pick == 2 and k >= 2 and abs(record[k - 1] + record[k - 2]) < limit {
            record.push(record[k - 1] + record[k - 2]);
            out.push("+".to_string());
        } else if pick >= 3 {
            let x = next_random(mut seed) % 60001 - 30000;
            record.push(x);
            out.push(f"{x}");
        }
    }
    out
}

fn main() {
    let count = 200;
    let rounds = 30;
    let mut seed = 682;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..count {
        lists.push(random_ops(mut seed, 5000));
    }
    let mut sum = 0;
    for r in 0..rounds {
        for k in 0..count {
            let at = (k * 7 + r) % count;
            let points = cal_points(lists[at]);
            sum = (sum * 31 + points % 1000000007 + 1000000007) % 1000000007;
        }
    }
    println(f"{count * rounds} games scored, checksum {sum}");
}
