// Benchmark for #665: the ★ arm (fix each drop as it comes) on a large
// workload.

fn check_possibility(nums: Vec[i64]) -> bool {
    let mut a = nums.clone();
    let mut fixes = 0;
    for i in 1..a.len() {
        if a[i] < a[i - 1] {
            fixes += 1;
            if fixes > 1 {
                return false;
            }
            if i < 2 or a[i - 2] <= a[i] {
                a[i - 1] = a[i];
            } else {
                a[i] = a[i - 1];
            }
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 16 arrays of the problem's longest, 10,000 numbers, made once:
    // each rises by 0 to 20 at a step, then has 0, 1 or 2 numbers set at
    // random. Then each round checks one, picked by the round, and puts
    // the answer into a checksum.
    let mut seed: i64 = 665;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for t in 0..16 {
        let mut v: Vec[i64] = Vec.new();
        let mut x = -100000;
        for _ in 0..10000 {
            v.push(x);
            x += next_random(mut seed) % 21;
        }
        for _ in 0..t % 3 {
            let at = next_random(mut seed) % 10000;
            v[at] = next_random(mut seed) % 200001 - 100000;
        }
        arrays.push(v);
    }
    let rounds = 40000;
    let mut yes = 0;
    let mut sum = 0;
    for r in 0..rounds {
        let ok = check_possibility(arrays[r % 16]);
        if ok {
            yes += 1;
        }
        sum = (sum * 31 + r * 2 + if ok { 1 } else { 0 }) % 1000000007;
    }
    println(f"16 arrays of 10000, {rounds} rounds: {yes} can be sorted, checksum {sum}");
}
