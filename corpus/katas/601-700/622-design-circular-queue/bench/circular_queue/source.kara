// LeetCode #622: Design Circular Queue -- a ring with a start and a count.
//
// A `Vec` of `k` slots used as a ring: `head` is the slot of the front
// value and `count` how many values follow it, wrapping past the end.
// The rear is `count - 1` slots after the head. Every operation is O(1).

struct MyCircularQueue {
    data: Vec[i64],
    head: i64,
    count: i64,
}

impl MyCircularQueue {
    fn new(k: i64) -> MyCircularQueue {
        MyCircularQueue { data: vec![0; k], head: 0, count: 0 }
    }

    fn en_queue(mut ref self, value: i64) -> bool {
        if self.count == self.data.len() {
            return false;
        }
        let at = (self.head + self.count) % self.data.len();
        self.data[at] = value;
        self.count += 1;
        true
    }

    fn de_queue(mut ref self) -> bool {
        if self.count == 0 {
            return false;
        }
        self.head = (self.head + 1) % self.data.len();
        self.count -= 1;
        true
    }

    fn front(self) -> i64 {
        if self.count == 0 { -1 } else { self.data[self.head] }
    }

    fn rear(self) -> i64 {
        if self.count == 0 { -1 } else { self.data[(self.head + self.count - 1) % self.data.len()] }
    }

    fn is_empty(self) -> bool {
        self.count == 0
    }

    fn is_full(self) -> bool {
        self.count == self.data.len()
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random operations, each one number: 0 to 1,000 is an
// `enQueue` of that value, about two in five; -1 a `deQueue`, about one
// in four; -2 `Front`, -3 `Rear`, -4 `isEmpty` and -5 `isFull`.
fn script(count: i64, seed: mut ref i64) -> Vec[i64] {
    let mut ops: Vec[i64] = Vec.new();
    for _ in 0..count {
        let roll = next_random(mut seed) % 40;
        if roll < 16 {
            ops.push(next_random(mut seed) % 1001);
        } else if roll < 26 {
            ops.push(-1);
        } else if roll < 30 {
            ops.push(-2);
        } else if roll < 34 {
            ops.push(-3);
        } else if roll < 37 {
            ops.push(-4);
        } else {
            ops.push(-5);
        }
    }
    ops
}

fn flag(b: bool) -> i64 {
    if b { 1 } else { 0 }
}

fn main() {
    // A script of 100,000 operations, made once; then 300 times runs it
    // on a new queue of 1 to 1,000 slots, picked by the round, putting
    // every result into a checksum.
    let rounds = 300;
    let mut seed: i64 = 622;
    let ops = script(100000, mut seed);
    let mut checksum: i64 = 0;
    for r in 0..rounds {
        let mut q = MyCircularQueue.new(1 + (r * 37) % 1000);
        for op in ops.iter() {
            let v = if *op >= 0 {
                flag(q.en_queue(*op))
            } else if *op == -1 {
                flag(q.de_queue())
            } else if *op == -2 {
                q.front()
            } else if *op == -3 {
                q.rear()
            } else if *op == -4 {
                flag(q.is_empty())
            } else {
                flag(q.is_full())
            };
            checksum = (checksum * 31 + v + 2) % 1000000007;
        }
    }
    println(f"{rounds} queues, {ops.len()} operations each: checksum {checksum}");
}
