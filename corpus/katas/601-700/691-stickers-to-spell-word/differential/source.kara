// LeetCode #691: differential -- the four arms against the definition.
//
// Copies of the four arms, held to four properties on random problems.

// ---- star arm ----------------------------------------------------------

fn min_stickers_star(stickers: Vec[String], target: String) -> i64 {
    let t = target.bytes();
    let m = t.len();
    let full = (1 << m) - 1;
    let mut counts: Vec[Vec[i64]] = Vec.new();
    for s in stickers.iter() {
        let mut c: Vec[i64] = vec![0; 26];
        for b in s.bytes().iter() {
            c[*b as i64 - 97] += 1;
        }
        counts.push(c);
    }
    let mut dp: Vec[i64] = vec![-1; full + 1];
    dp[0] = 0;
    let mut left: Vec[i64] = vec![0; 26];
    for mask in 0..full + 1 {
        if dp[mask] < 0 {
            continue;
        }
        for c in counts.iter() {
            for k in 0..26 {
                left[k] = c[k];
            }
            let mut next = mask;
            for i in 0..m {
                let k = t[i] as i64 - 97;
                if next & (1 << i) == 0 and left[k] > 0 {
                    left[k] -= 1;
                    next = next | (1 << i);
                }
            }
            if next != mask and (dp[next] < 0 or dp[mask] + 1 < dp[next]) {
                dp[next] = dp[mask] + 1;
            }
        }
    }
    dp[full]
}

// ---- bfs arm -----------------------------------------------------------

fn min_stickers_bfs(stickers: Vec[String], target: String) -> i64 {
    let t = target.bytes();
    let m = t.len();
    let full = (1 << m) - 1;
    let mut counts: Vec[Vec[i64]] = Vec.new();
    for s in stickers.iter() {
        let mut c: Vec[i64] = vec![0; 26];
        for b in s.bytes().iter() {
            c[*b as i64 - 97] += 1;
        }
        counts.push(c);
    }
    let mut seen: Vec[bool] = vec![false; full + 1];
    seen[0] = true;
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(0);
    let mut steps = 0;
    while not queue.is_empty() {
        let mut level = queue.len();
        while level > 0 {
            level -= 1;
            let mask = queue.pop_front().unwrap();
            if mask == full {
                return steps;
            }
            let mut first = 0;
            while mask & (1 << first) != 0 {
                first += 1;
            }
            let want = t[first] as i64 - 97;
            for c in counts.iter() {
                if c[want] == 0 {
                    continue;
                }
                let mut left = c.clone();
                let mut next = mask;
                for i in 0..m {
                    let k = t[i] as i64 - 97;
                    if next & (1 << i) == 0 and left[k] > 0 {
                        left[k] -= 1;
                        next = next | (1 << i);
                    }
                }
                if not seen[next] {
                    seen[next] = true;
                    queue.push_back(next);
                }
            }
        }
        steps += 1;
    }
    -1
}

// ---- memo arm ----------------------------------------------------------

fn min_stickers_memo(stickers: Vec[String], target: String) -> i64 {
    let mut counts: Vec[Vec[i64]] = Vec.new();
    for s in stickers.iter() {
        let mut c: Vec[i64] = vec![0; 26];
        for b in s.bytes().iter() {
            c[*b as i64 - 97] += 1;
        }
        counts.push(c);
    }
    let mut memo: Map[String, i64] = Map.new();
    memo.insert(String.new(), 0);
    solve_memo(counts, spelled_memo(tally_memo(target)), mut memo)
}

fn tally_memo(word: ref String) -> Vec[i64] {
    let mut c: Vec[i64] = vec![0; 26];
    for b in word.bytes().iter() {
        c[*b as i64 - 97] += 1;
    }
    c
}

// The letters of a tally, in order.
fn spelled_memo(c: ref Vec[i64]) -> String {
    let mut w = String.new();
    for k in 0..26 {
        for _ in 0..c[k] {
            w.push((b'a' + k as u8) as char);
        }
    }
    w
}

fn solve_memo(counts: ref Vec[Vec[i64]], rest: own String, memo: mut ref Map[String, i64]) -> i64 {
    match memo.get(rest) {
        Some(v) => return *v,
        None => {}
    }
    let need = tally_memo(rest);
    let first = rest.bytes()[0] as i64 - 97;
    let mut best = -1;
    for c in counts.iter() {
        if c[first] == 0 {
            continue;
        }
        let mut left: Vec[i64] = vec![0; 26];
        for k in 0..26 {
            left[k] = if need[k] > c[k] { need[k] - c[k] } else { 0 };
        }
        let sub = solve_memo(counts, spelled_memo(left), memo);
        if sub >= 0 and (best < 0 or sub + 1 < best) {
            best = sub + 1;
        }
    }
    memo.insert(rest, best);
    best
}

// ---- search arm --------------------------------------------------------

fn min_stickers_search(stickers: Vec[String], target: String) -> i64 {
    let mut need: Vec[i64] = vec![0; 26];
    for b in target.bytes().iter() {
        need[*b as i64 - 97] += 1;
    }
    let mut all: Vec[Vec[i64]] = Vec.new();
    for s in stickers.iter() {
        let mut c: Vec[i64] = vec![0; 26];
        for b in s.bytes().iter() {
            let k = *b as i64 - 97;
            if need[k] > 0 {
                c[k] += 1;
            }
        }
        all.push(c);
    }
    // Keep a sticker unless another one holds at least as many of every
    // letter (of two equal stickers, the first is kept).
    let mut kept: Vec[Vec[i64]] = Vec.new();
    for i in 0..all.len() {
        let mut covered = false;
        for j in 0..all.len() {
            if i != j and contains_search(all[j], all[i]) and (j < i or not contains_search(all[i], all[j])) {
                covered = true;
                break;
            }
        }
        if not covered {
            kept.push(all[i].clone());
        }
    }
    let mut best = -1;
    search_search(kept, mut need, 0, mut best);
    best
}

// Does `big` hold at least as many of every letter as `small`?
fn contains_search(big: ref Vec[i64], small: ref Vec[i64]) -> bool {
    for k in 0..26 {
        if big[k] < small[k] {
            return false;
        }
    }
    true
}

fn search_search(stickers: ref Vec[Vec[i64]], need: mut ref Vec[i64], used: i64, best: mut ref i64) {
    if *best >= 0 and used >= *best {
        return;
    }
    let mut first = -1;
    for k in 0..26 {
        if need[k] > 0 {
            first = k;
            break;
        }
    }
    if first < 0 {
        *best = used;
        return;
    }
    for c in stickers.iter() {
        if c[first] == 0 {
            continue;
        }
        let saved = need.clone();
        for k in 0..26 {
            need[k] = if need[k] > c[k] { need[k] - c[k] } else { 0 };
        }
        search_search(stickers, need, used + 1, best);
        for k in 0..26 {
            need[k] = saved[k];
        }
    }
}

// ---- the definition and the properties ------------------------------------

fn answer(which: i64, stickers: Vec[String], target: String) -> i64 {
    if which == 0 {
        min_stickers_star(stickers, target)
    } else if which == 1 {
        min_stickers_bfs(stickers, target)
    } else if which == 2 {
        min_stickers_memo(stickers, target)
    } else {
        min_stickers_search(stickers, target)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(len: i64, alphabet: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push((b'a' + (next_random(mut seed) % alphabet) as u8) as char);
    }
    w
}

fn letter_counts(word: ref String) -> Vec[i64] {
    let mut c: Vec[i64] = vec![0; 26];
    for b in word.bytes().iter() {
        c[*b as i64 - 97] += 1;
    }
    c
}

// The definition: the smallest k for which some k stickers, repeats
// allowed, hold between them at least as many of every letter as the
// target. Each useful sticker gives at least one letter, so if no k up to
// the target's length works, none does. Every multiset of k stickers is
// tried, as a non-decreasing list of sticker indices.
fn definition(stickers: Vec[String], target: String) -> i64 {
    let need = letter_counts(target);
    let mut have: Vec[Vec[i64]] = Vec.new();
    for s in stickers.iter() {
        have.push(letter_counts(s));
    }
    let n = have.len();
    let len = target.len();
    for k in 1..len + 1 {
        let mut pick: Vec[i64] = vec![0; k];
        loop {
            let mut total: Vec[i64] = vec![0; 26];
            for p in pick.iter() {
                for c in 0..26 {
                    total[c] += have[*p][c];
                }
            }
            let mut covers = true;
            for c in 0..26 {
                if total[c] < need[c] {
                    covers = false;
                }
            }
            if covers {
                return k;
            }
            // The next non-decreasing list: bump the last index that can
            // grow, and set everything after it to the same value.
            let mut i = k - 1;
            while i >= 0 and pick[i] == n - 1 {
                i -= 1;
            }
            if i < 0 {
                break;
            }
            let v = pick[i] + 1;
            for j in i..k {
                pick[j] = v;
            }
        }
    }
    -1
}

fn reversed(word: ref String) -> String {
    let b = word.bytes();
    let mut w = String.new();
    let mut i = b.len() - 1;
    while i >= 0 {
        w.push(b[i] as char);
        i -= 1;
    }
    w
}

fn main() {
    let mut seed = 6910;
    let arms = 4;
    let mut checks = 0;
    let mut fails = [0, 0, 0, 0];
    let cases = 1000;
    for _ in 0..cases {
        let alphabet = 2 + next_random(mut seed) % 5;
        let n = 1 + next_random(mut seed) % 6;
        let mut stickers: Vec[String] = Vec.new();
        for _ in 0..n {
            let len = 1 + next_random(mut seed) % 5;
            stickers.push(random_word(len, alphabet, mut seed));
        }
        let target = random_word(1 + next_random(mut seed) % 7, alphabet, mut seed);
        let mut backwards: Vec[String] = Vec.new();
        for i in 0..n {
            backwards.push(stickers[n - 1 - i].clone());
        }
        let flipped = reversed(target);
        let mut with_target = stickers.clone();
        with_target.push(target.clone());
        let want = definition(stickers, target);
        for which in 0..arms {
            let got = answer(which, stickers, target);
            // P1: the definition's answer.
            checks += 1;
            if got != want {
                fails[0] += 1;
            }
            // P2: the stickers in reverse order answer the same.
            checks += 1;
            if answer(which, backwards, target) != got {
                fails[1] += 1;
            }
            // P3: the target spelled backwards answers the same.
            checks += 1;
            if answer(which, stickers, flipped) != got {
                fails[2] += 1;
            }
            // P4: with the target itself added as a sticker, one is enough.
            checks += 1;
            if answer(which, with_target, target) != 1 {
                fails[3] += 1;
            }
        }
    }
    let mut report = String.new();
    let mut total = 0;
    for p in 0..4 {
        if fails[p] > 0 {
            report.push_str(f"P{p + 1}: {fails[p]} failures | ");
        }
        total += fails[p];
    }
    println(f"{report}{cases} problems, {arms} arms, {checks} checks, {total} failures");
}
