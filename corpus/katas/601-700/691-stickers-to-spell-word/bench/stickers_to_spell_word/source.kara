// LeetCode #691: Stickers to Spell Word -- bench program for the ★ arm.
//
// 160 problems, each 50 stickers of 10 letters and a target of 15, all
// drawn from the first 12 letters; every problem is solved with the
// table over the target's subsets, and the answers are summed.

fn min_stickers(stickers: Vec[String], target: String) -> i64 {
    let t = target.bytes();
    let m = t.len();
    let full = (1 << m) - 1;
    let mut counts: Vec[Vec[i64]] = Vec.new();
    for s in stickers.iter() {
        let mut c: Vec[i64] = vec![0; 26];
        for b in s.bytes().iter() {
            c[*b as i64 - 97] += 1;
        }
        counts.push(c);
    }
    let mut dp: Vec[i64] = vec![-1; full + 1];
    dp[0] = 0;
    let mut left: Vec[i64] = vec![0; 26];
    for mask in 0..full + 1 {
        if dp[mask] < 0 {
            continue;
        }
        for c in counts.iter() {
            for k in 0..26 {
                left[k] = c[k];
            }
            let mut next = mask;
            for i in 0..m {
                let k = t[i] as i64 - 97;
                if next & (1 << i) == 0 and left[k] > 0 {
                    left[k] -= 1;
                    next = next | (1 << i);
                }
            }
            if next != mask and (dp[next] < 0 or dp[mask] + 1 < dp[next]) {
                dp[next] = dp[mask] + 1;
            }
        }
    }
    dp[full]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(len: i64, alphabet: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push((b'a' + (next_random(mut seed) % alphabet) as u8) as char);
    }
    w
}

fn main() {
    let mut seed = 691;
    let problems = 160;
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..problems {
        let mut stickers: Vec[String] = Vec.new();
        for _ in 0..50 {
            stickers.push(random_word(10, 12, mut seed));
        }
        let target = random_word(15, 12, mut seed);
        let r = min_stickers(stickers, target);
        total += r;
        checksum = (checksum * 31 + r + 2) % 1000000007;
    }
    println(f"{problems} problems of 50 stickers and a 15-letter target: {total} stickers in all, checksum {checksum}");
}
