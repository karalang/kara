// LeetCode #135: Candy — two greedy passes.
//
// Each child needs >= 1 candy; a child with a strictly higher rating than a
// neighbour must get more. Minimize the total. Left-to-right pass enforces the
// "greater than left neighbour" rule; right-to-left pass enforces "greater than
// right neighbour" while keeping the left result (take the max). Sum the array.

fn candy(ratings: Vec[i64]) -> i64 {
    let n = ratings.len();
    if n == 0 {
        return 0;
    }
    let mut c: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        c.push(1);
        k = k + 1;
    }
    // Left to right.
    let mut i = 1;
    while i < n {
        if ratings[i] > ratings[i - 1] {
            c[i] = c[i - 1] + 1;
        }
        i = i + 1;
    }
    // Right to left (descending loop).
    i = n - 2;
    while i >= 0 {
        if ratings[i] > ratings[i + 1] and c[i] <= c[i + 1] {
            c[i] = c[i + 1] + 1;
        }
        i = i - 1;
    }
    // Sum.
    let mut total = 0;
    i = 0;
    while i < n {
        total = total + c[i];
        i = i + 1;
    }
    total
}

fn lcg(seed: i64, n: i64, cap: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    let mut k = 0;
    while k < n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x % cap);
        k = k + 1;
    }
    out
}

fn report(ratings: Vec[i64], sink: mut ref i64) {
    let m = 1000000007;
    let n = ratings.len();
    let v = candy(ratings);
    println(f"n={n}: {v}");
    sink = (sink * 1000003 + v) % m;
}

fn main() {
    let mut sink = 0;

    let mut a: Vec[i64] = Vec.new();
    a.push(1); a.push(0); a.push(2);
    report(a, mut sink);

    let mut b: Vec[i64] = Vec.new();
    b.push(1); b.push(2); b.push(2);
    report(b, mut sink);

    let mut c: Vec[i64] = Vec.new();
    c.push(1); c.push(3); c.push(2); c.push(2); c.push(1);
    report(c, mut sink);

    let mut d: Vec[i64] = Vec.new();
    d.push(5); d.push(4); d.push(3); d.push(2); d.push(1);
    report(d, mut sink);

    let mut e: Vec[i64] = Vec.new();
    e.push(1); e.push(2); e.push(3); e.push(4); e.push(5);
    report(e, mut sink);

    let mut t = 0;
    while t < 6 {
        let r = lcg(t + 1, 12 + t * 4, 5);
        report(r, mut sink);
        t = t + 1;
    }

    println(f"sink: {sink}");
}
