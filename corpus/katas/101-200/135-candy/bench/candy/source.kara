// Benchmark harness for LeetCode #135 — Candy.
//
// Build-once + punch (BENCHMARKS.md): eight ratings arrays are built once, then
// each punch runs both greedy passes plus the sum.
//
// The parameter is `ref Vec[i64]` rather than the kata's by-value `Vec[i64]`:
// by value would copy 200 000 elements per call, which no mirror does and which
// would swamp the O(n) passes being measured.
//
// This kata is the corpus's cleanest exercise of a DESCENDING loop — the
// right-to-left pass walks `i = n-2` down to `0` with an index-dependent
// condition — which is a distinct bounds-check-elimination surface from the
// ascending loops everywhere else.
//
// Rating spread is the knob. A narrow range produces long runs of equal
// ratings, where neither greedy rule fires and both passes are pure scans; a
// wide range produces frequent strict inequalities, so the right-to-left pass
// does real max-taking work. The set spans both.

fn candy(ratings: ref Vec[i64]) -> i64 {
    let n = ratings.len();
    if n == 0 {
        return 0;
    }
    let mut c: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        c.push(1);
        k = k + 1;
    }
    let mut i = 1;
    while i < n {
        if ratings[i] > ratings[i - 1] {
            c[i] = c[i - 1] + 1;
        }
        i = i + 1;
    }
    i = n - 2;
    while i >= 0 {
        if ratings[i] > ratings[i + 1] and c[i] <= c[i + 1] {
            c[i] = c[i + 1] + 1;
        }
        i = i - 1;
    }
    let mut total = 0;
    i = 0;
    while i < n {
        total = total + c[i];
        i = i + 1;
    }
    total
}

fn lcg(seed: i64, n: i64, cap: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    let mut k = 0;
    while k < n {
        x = (x * 1103515245 + 12345) % 2147483648;
        let wd0 = x / 65536;
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push((wd0 * 32768 + x / 65536) % cap);
        k = k + 1;
    }
    out
}

fn main() {
    let np = 8;
    let n = 200000;
    let iters = 150;

    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut j = 0;
    while j < np {
        // Alternating narrow (many equal neighbours) and wide (many strict
        // inequalities) rating ranges.
        if j % 2 == 0 {
            arrays.push(lcg(j + 1, n, 4));
        } else {
            arrays.push(lcg(j + 1, n, 100000));
        }
        j = j + 1;
    }

    let mut sink = 0;
    let mut it = 0;
    while it < iters {
        let idx = (it * 3) % np;
        sink = (sink + candy(arrays[idx])) % 1000000007;
        it = it + 1;
    }
    println(f"{sink}");
}
