// LeetCode #598: Range Addition II -- the smallest corner.
//
// Every operation adds 1 to a rectangle in the top-left corner, so the
// cell (0, 0) gets every operation and holds the maximum. The cells that
// tie with it are those every rectangle covers: the rows below the
// smallest a and the columns below the smallest b. With no operations,
// every cell is 0 and all m * n tie. O(k) for k operations.

fn max_count(m: i64, n: i64, ops: Vec[Vec[i64]]) -> i64 {
    let mut rows = m;
    let mut cols = n;
    for op in ops {
        rows = min(rows, op[0]);
        cols = min(cols, op[1]);
    }
    rows * cols
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(m: i64, n: i64, ops: Vec[Vec[i64]]) {
    println(f"m = {m}, n = {n}, ops = {ops} -> {max_count(m, n, ops)}");
}

fn main() {
    // The LeetCode examples.
    show(3, 3, vec![vec![2, 2], vec![3, 3]]);
    let mut many: Vec[Vec[i64]] = Vec.new();
    for k in 0..12 {
        many.push(if k % 4 == 0 { vec![2, 2] } else { vec![3, 3] });
    }
    show(3, 3, many);
    show(3, 3, Vec.new());
    // One cell; one operation over the whole matrix; a single row; the
    // smallest sides coming from different operations; and every cell
    // of the largest matrix, untouched.
    show(1, 1, vec![vec![1, 1]]);
    show(4, 5, vec![vec![4, 5]]);
    show(1, 6, vec![vec![1, 4], vec![1, 6]]);
    show(5, 5, vec![vec![2, 5], vec![5, 3], vec![4, 4]]);
    show(40000, 40000, Vec.new());
    // 10,000 operations, the problem's most, on the largest matrix.
    let mut seed: i64 = 598;
    let mut big: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10000 {
        big.push(vec![30000 + step(mut seed) % 10001, 20000 + step(mut seed) % 20001]);
    }
    println(f"10000 operations on 40000 x 40000 -> {max_count(40000, 40000, big)}");
    // 300 random cases: sides from 1 to 30, up to 12 operations.
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let m = 1 + step(mut seed) % 30;
        let n = 1 + step(mut seed) % 30;
        let k = step(mut seed) % 13;
        let mut ops: Vec[Vec[i64]] = Vec.new();
        for _ in 0..k {
            ops.push(vec![1 + step(mut seed) % m, 1 + step(mut seed) % n]);
        }
        let got = max_count(m, n, ops);
        total += got;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"300 random cases: total {total}, checksum {checksum}");
}
