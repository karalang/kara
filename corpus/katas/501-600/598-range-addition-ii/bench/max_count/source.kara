// Benchmark for #598: the ★ arm (the smallest corner); see
// max_count.kara.

fn max_count(m: i64, n: i64, ops: Vec[Vec[i64]]) -> i64 {
    let mut rows = m;
    let mut cols = n;
    for op in ops {
        rows = min(rows, op[0]);
        cols = min(cols, op[1]);
    }
    rows * cols
}

// ---- benchmark --------------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 lists of 10,000 operations (the problem's most) on matrices of
    // up to 40,000 x 40,000, made once; then 300 times over each is
    // solved.
    let count = 100;
    let rounds = 300;
    let mut seed: i64 = 598;
    let mut sizes: Vec[(i64, i64)] = Vec.new();
    let mut lists: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        let m = 1 + (step(mut seed) * 32768 + step(mut seed)) % 40000;
        let n = 1 + (step(mut seed) * 32768 + step(mut seed)) % 40000;
        let mut ops: Vec[Vec[i64]] = Vec.new();
        for _ in 0..10000 {
            ops.push(vec![m - step(mut seed) % (1 + m / 8), n - step(mut seed) % (1 + n / 8)]);
        }
        sizes.push((m, n));
        lists.push(ops);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        for g in 0..count {
            let c = (round * 7 + g) % count;
            let (m, n) = sizes[c];
            let got = max_count(m, n, lists[c]);
            total += got;
            checksum = (checksum * 31 + got) % 1000000007;
        }
    }
    println(f"{count} lists, {rounds} rounds: total {total}, checksum {checksum}");
}
