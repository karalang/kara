// LeetCode #503: Next Greater Element II -- a stack of indices, twice
// around.
//
// Walk the array twice, index i % n. A stack holds the indices still
// waiting for a greater number, their values never rising from bottom
// to top; each number answers every waiting index below it. Indices are
// pushed only on the first lap, and the second lap lets the numbers at
// the front answer the ones at the back. Whatever is still waiting
// after two laps has no greater number. O(n) time.

fn next_greater_elements(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut answer = vec![-1; n];
    let mut waiting: Vec[i64] = Vec.new();
    for i in 0..2 * n {
        let x = nums[i % n];
        while let Some(top) = waiting.last() {
            if nums[*top] >= x {
                break;
            }
            answer[*top] = x;
            waiting.pop();
        }
        if i < n {
            waiting.push(i);
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(name: Str, nums: Vec[i64]) {
    println(f"{name}: {nums} -> {next_greater_elements(nums)}");
}

fn main() {
    show("example 1", vec![1, 2, 1]);
    show("example 2", vec![1, 2, 3, 4, 3]);
    show("one number", vec![5]);
    show("all equal", vec![3, 3, 3]);
    show("falling", vec![5, 4, 3, 2, 1]);
    show("rising", vec![1, 2, 3, 4, 5]);
    show("the extremes", vec![-1000000000, 1000000000, -1000000000]);
    show("the largest twice", vec![2, 9, 1, 9, 3]);
    // 300 random arrays of 1 to 30 numbers from 0 to 9 or from the
    // whole range -10^9 to 10^9, in turn.
    let count = 300;
    let mut seed: i64 = 503;
    let mut total = 0;
    let mut found = 0;
    let mut checksum: i64 = 0;
    for c in 0..count {
        let size = 1 + next_random(mut seed) % 30;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..size {
            if c % 2 == 0 {
                nums.push(next_random(mut seed) % 10);
            } else {
                nums.push((next_random(mut seed) * 65536 + next_random(mut seed)) % 2000000001 - 1000000000);
            }
        }
        for a in next_greater_elements(nums) {
            total += 1;
            if a != -1 {
                found += 1;
            }
            checksum = (checksum * 31 + a % 1000000007 + 1000000007) % 1000000007;
        }
    }
    println(f"{count} random arrays: {total} numbers, {found} with a greater one, checksum {checksum}");
}
