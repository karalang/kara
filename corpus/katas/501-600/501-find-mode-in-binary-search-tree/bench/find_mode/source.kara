// Benchmark for #501: the ★ arm (in-order with a running count); see
// ../find_mode.kara.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

struct Walk {
    prev: i64,
    run: i64,
    best: i64,
    modes: Vec[i64],
}

fn visit(node: Option[TreeNode], walk: mut ref Walk) {
    let Some(n) = node else {
        return;
    };
    visit(n.left, walk);
    if walk.run > 0 and n.val == walk.prev {
        walk.run += 1;
    } else {
        walk.prev = n.val;
        walk.run = 1;
    }
    if walk.run > walk.best {
        walk.best = walk.run;
        walk.modes.clear();
        walk.modes.push(n.val);
    } else if walk.run == walk.best {
        walk.modes.push(n.val);
    }
    visit(n.right, walk);
}

fn find_mode(root: Option[TreeNode]) -> Vec[i64] {
    let mut walk = Walk { prev: 0, run: 0, best: 0, modes: Vec.new() };
    visit(root, mut walk);
    walk.modes
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A search tree of the values, inserted in the order given: a smaller
// value goes left, a larger one right, and an equal one either way by a
// coin flip from seed, which keeps every value on the left of a node at
// most the node's and every value on its right at least.
fn build(values: Vec[i64], seed: mut ref i64) -> Option[TreeNode] {
    if values.is_empty() {
        return None;
    }
    let root = TreeNode { val: values[0], left: None, right: None };
    for i in 1..values.len() {
        let v = values[i];
        let mut node = root;
        loop {
            if v < node.val or (v == node.val and next_random(seed) % 2 == 0) {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(TreeNode { val: v, left: None, right: None });
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(TreeNode { val: v, left: None, right: None });
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

fn main() {
    // 100 random search trees of 10,000 values (the problem's most),
    // drawn from 1 to 10 values, 1,000 values, or the whole range
    // -100,000 to 100,000 in turn, an equal value going left or right
    // by a coin flip, built once. Then the modes of each tree are
    // found 30 times.
    let trees = 100;
    let mut seed: i64 = 501;
    let mut all: Vec[Option[TreeNode]] = Vec.new();
    for t in 0..trees {
        let range = if t % 3 == 0 { 1 + next_random(mut seed) % 10 } else if t % 3 == 1 { 1000 } else { 200001 };
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..10000 {
            let v = next_random(mut seed) * 7 % range;
            values.push(if range == 200001 { v - 100000 } else { v });
        }
        all.push(build(values, mut seed));
    }
    let mut modes = 0;
    let mut checksum: i64 = 0;
    for _ in 0..30 {
        for t in 0..trees {
            for m in find_mode(all[t]) {
                modes += 1;
                checksum = (checksum * 31 + m + 100000) % 1000000007;
            }
        }
    }
    println(f"{trees} trees of 10000 values, 30 times each: {modes} modes, checksum {checksum}");
}
