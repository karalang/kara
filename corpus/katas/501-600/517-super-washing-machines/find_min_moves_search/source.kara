// LeetCode #517: Super Washing Machines -- binary search on the answer.
//
// k moves are enough exactly when no gap has to carry more than k
// dresses and no machine has to give away more than k, so `fits(k)`
// checks both in one pass and the smallest k that fits is found by
// halving the range from 0 to the total. O(n log total).

fn fits(machines: Vec[i64], average: i64, k: i64) -> bool {
    let mut surplus = 0;
    for m in machines.iter() {
        surplus += *m - average;
        if surplus.abs() > k or *m - average > k {
            return false;
        }
    }
    true
}

fn find_min_moves(machines: Vec[i64]) -> i64 {
    let n = machines.len();
    let mut total = 0;
    for m in machines.iter() {
        total += *m;
    }
    if total % n != 0 {
        return -1;
    }
    let average = total / n;
    let mut low = 0;
    let mut high = total;
    while low < high {
        let mid = (low + high) / 2;
        if fits(machines, average, mid) {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    low
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(machines: Vec[i64]) {
    let mut text = String.from("[");
    for i in 0..machines.len() {
        if i > 0 {
            text.push_str(", ");
        }
        text.push_str(f"{machines[i]}");
    }
    text.push_str("]");
    println(f"{text}: {find_min_moves(machines)}");
}

fn main() {
    show(vec![1, 0, 5]);
    show(vec![0, 3, 0]);
    show(vec![0, 2, 0]);
    show(vec![7]);
    show(vec![0, 0, 11, 5]);
    show(vec![4, 0, 0, 4]);
    show(vec![100000, 0, 0, 0, 0, 0, 0, 0, 0, 0]);
    // 300 random rows of 1 to 40 machines holding up to 3, 100 or
    // 100,000 dresses in turn; every other row has its last machine
    // topped up so the dresses share out evenly.
    let mut seed: i64 = 517;
    let count = 300;
    let mut solvable = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let most = if t % 3 == 0 { 3 } else if t % 3 == 1 { 100 } else { 100000 };
        let n = 1 + next_random(mut seed) % 40;
        let mut machines: Vec[i64] = Vec.new();
        let mut total = 0;
        for _ in 0..n {
            let m = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most + 1);
            machines.push(m);
            total += m;
        }
        if t % 2 == 0 {
            machines[n - 1] += (n - total % n) % n;
        }
        let v = find_min_moves(machines);
        if v >= 0 {
            solvable += 1;
        }
        checksum = (checksum * 31 + v + 1) % 1000000007;
    }
    println(f"{count} random rows: {solvable} can be evened out, checksum {checksum}");
}
