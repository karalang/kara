// LeetCode #592: Fraction Addition and Subtraction -- one common
// denominator.
//
// Every denominator is from 1 to 10, so each divides 2520, their least
// common multiple. Each fraction a/b is 2520/b * a over 2520; add the
// numerators and reduce once at the end. O(n).

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a.abs() } else { gcd(b, a % b) }
}

fn fraction_addition(expression: Str) -> String {
    let all = 2520;
    let mut total = 0;
    let mut sign = 1;
    let mut value = 0;
    let mut numerator = 0;
    for c in expression.chars() {
        if c.is_ascii_digit() {
            value = value * 10 + c.to_digit(10).unwrap() as i64;
        } else if c == '/' {
            numerator = sign * value;
            value = 0;
        } else {
            if numerator != 0 {
                total += numerator * (all / value);
            }
            sign = if c == '-' { -1 } else { 1 };
            value = 0;
            numerator = 0;
        }
    }
    total += numerator * (all / value);
    let g = gcd(total, all);
    f"{total / g}/{all / g}"
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn coprime(a: i64, b: i64) -> bool {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    x == 1
}

// A random expression of `count` irreducible fractions with numerators
// and denominators from 1 to 10, as the problem gives them.
fn expression(count: i64, seed: mut ref i64) -> String {
    let mut out = String.new();
    for k in 0..count {
        let mut a = 1 + step(seed) % 10;
        let mut b = 1 + step(seed) % 10;
        while not coprime(a, b) {
            a = 1 + step(seed) % 10;
            b = 1 + step(seed) % 10;
        }
        if step(seed) % 2 == 0 {
            out.push('-');
        } else if k > 0 {
            out.push('+');
        }
        out.push_str(f"{a}/{b}");
    }
    out
}

fn show(e: Str) {
    println(f"{e} = {fraction_addition(e)}");
}

fn main() {
    // The LeetCode examples.
    show("-1/2+1/2");
    show("-1/2+1/2+1/3");
    show("1/3-1/2");
    // One fraction; whole numbers; ten fractions at the extremes; every
    // denominator from 1 to 10; and a sum whose terms reduce only
    // together.
    show("3/7");
    show("-10/1");
    show("2/1+3/1-1/1");
    show("10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1");
    show("-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1");
    show("1/1+1/2+1/3+1/4+1/5+1/6+1/7+1/8+1/9+1/10");
    show("1/1-1/2+1/3-1/4+1/5-1/6+1/7-1/8+1/9-1/10");
    show("1/6+1/3");
    show("1/10-1/10");
    // 1,000 random expressions of 1 to 10 fractions.
    let mut seed: i64 = 592;
    let mut zero = 0;
    let mut whole = 0;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        let e = expression(1 + step(mut seed) % 10, mut seed);
        let got = fraction_addition(e);
        if got.starts_with("0/") {
            zero += 1;
        }
        if got.ends_with("/1") {
            whole += 1;
        }
        for c in got.chars() {
            checksum = (checksum * 31 + c as i64) % 1000000007;
        }
    }
    println(f"1000 random expressions: {zero} zero, {whole} whole, checksum {checksum}");
}
