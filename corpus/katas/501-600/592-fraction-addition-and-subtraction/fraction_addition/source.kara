// LeetCode #592: Fraction Addition and Subtraction -- a running sum.
//
// Read the expression one fraction at a time: a sign, a numerator, `/`
// and a denominator. Add each to a running fraction over the least
// common multiple of the two denominators, and reduce by the greatest
// common divisor as it goes, so the sum stays small. O(n) characters,
// each gcd O(log) of the denominators.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a.abs() } else { gcd(b, a % b) }
}

// The number made of the digits from `i`, and where they stop.
fn digits(e: Vec[char], i: i64) -> (i64, i64) {
    let mut value = 0;
    let mut j = i;
    while j < e.len() and e[j].is_ascii_digit() {
        value = value * 10 + (e[j] as i64 - '0' as i64);
        j += 1;
    }
    (value, j)
}

fn fraction_addition(expression: Str) -> String {
    let e: Vec[char] = expression.chars().collect();
    let mut num = 0;
    let mut den = 1;
    let mut i = 0;
    while i < e.len() {
        let mut sign = 1;
        if e[i] == '-' or e[i] == '+' {
            if e[i] == '-' {
                sign = -1;
            }
            i += 1;
        }
        let (a, after_a) = digits(e, i);
        let (b, after_b) = digits(e, after_a + 1);
        i = after_b;
        let common = den / gcd(den, b) * b;
        num = num * (common / den) + sign * a * (common / b);
        den = common;
        let g = gcd(num, den);
        num /= g;
        den /= g;
    }
    f"{num}/{den}"
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn coprime(a: i64, b: i64) -> bool {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    x == 1
}

// A random expression of `count` irreducible fractions with numerators
// and denominators from 1 to 10, as the problem gives them.
fn expression(count: i64, seed: mut ref i64) -> String {
    let mut out = String.new();
    for k in 0..count {
        let mut a = 1 + step(mut seed) % 10;
        let mut b = 1 + step(mut seed) % 10;
        while not coprime(a, b) {
            a = 1 + step(mut seed) % 10;
            b = 1 + step(mut seed) % 10;
        }
        if step(mut seed) % 2 == 0 {
            out.push('-');
        } else if k > 0 {
            out.push('+');
        }
        out.push_str(f"{a}/{b}");
    }
    out
}

fn show(e: Str) {
    println(f"{e} = {fraction_addition(e)}");
}

fn main() {
    // The LeetCode examples.
    show("-1/2+1/2");
    show("-1/2+1/2+1/3");
    show("1/3-1/2");
    // One fraction; whole numbers; ten fractions at the extremes; every
    // denominator from 1 to 10; and a sum whose terms reduce only
    // together.
    show("3/7");
    show("-10/1");
    show("2/1+3/1-1/1");
    show("10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1");
    show("-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1");
    show("1/1+1/2+1/3+1/4+1/5+1/6+1/7+1/8+1/9+1/10");
    show("1/1-1/2+1/3-1/4+1/5-1/6+1/7-1/8+1/9-1/10");
    show("1/6+1/3");
    show("1/10-1/10");
    // 1,000 random expressions of 1 to 10 fractions.
    let mut seed: i64 = 592;
    let mut zero = 0;
    let mut whole = 0;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        let e = expression(1 + step(mut seed) % 10, mut seed);
        let got = fraction_addition(e);
        if got.starts_with("0/") {
            zero += 1;
        }
        if got.ends_with("/1") {
            whole += 1;
        }
        for c in got.chars() {
            checksum = (checksum * 31 + c as i64) % 1000000007;
        }
    }
    println(f"1000 random expressions: {zero} zero, {whole} whole, checksum {checksum}");
}
