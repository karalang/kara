// LeetCode #592: Fraction Addition and Subtraction -- cut into
// fractions, then add.
//
// First the expression is cut before every sign but the first, giving
// one piece per fraction (the expression is ASCII, so a character
// index is a byte index); each piece is parsed with `i64.parse` on the
// text either side of its `/`. Then the fractions are added in turn,
// each sum reduced. O(n).

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a.abs() } else { gcd(b, a % b) }
}

fn pieces(expression: Str) -> Vec[Str] {
    let mut out: Vec[Str] = Vec.new();
    let mut start = 0;
    for (i, c) in expression.chars().enumerate() {
        if i > 0 and (c == '+' or c == '-') {
            out.push(expression[start..i]);
            start = i;
        }
    }
    out.push(expression[start..]);
    out
}

fn fraction_addition(expression: Str) -> String {
    let mut num = 0;
    let mut den = 1;
    for piece in pieces(expression) {
        let slash = piece.find("/").unwrap();
        let a = i64.parse(piece[0..slash]).unwrap();
        let b = i64.parse(piece[slash + 1..]).unwrap();
        num = num * b + a * den;
        den *= b;
        let g = gcd(num, den);
        num /= g;
        den /= g;
    }
    f"{num}/{den}"
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn coprime(a: i64, b: i64) -> bool {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    x == 1
}

// A random expression of `count` irreducible fractions with numerators
// and denominators from 1 to 10, as the problem gives them.
fn expression(count: i64, seed: mut ref i64) -> String {
    let mut out = String.new();
    for k in 0..count {
        let mut a = 1 + step(mut seed) % 10;
        let mut b = 1 + step(mut seed) % 10;
        while not coprime(a, b) {
            a = 1 + step(mut seed) % 10;
            b = 1 + step(mut seed) % 10;
        }
        if step(mut seed) % 2 == 0 {
            out.push('-');
        } else if k > 0 {
            out.push('+');
        }
        out.push_str(f"{a}/{b}");
    }
    out
}

fn show(e: Str) {
    println(f"{e} = {fraction_addition(e)}");
}

fn main() {
    // The LeetCode examples.
    show("-1/2+1/2");
    show("-1/2+1/2+1/3");
    show("1/3-1/2");
    // One fraction; whole numbers; ten fractions at the extremes; every
    // denominator from 1 to 10; and a sum whose terms reduce only
    // together.
    show("3/7");
    show("-10/1");
    show("2/1+3/1-1/1");
    show("10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1+10/1");
    show("-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1-10/1");
    show("1/1+1/2+1/3+1/4+1/5+1/6+1/7+1/8+1/9+1/10");
    show("1/1-1/2+1/3-1/4+1/5-1/6+1/7-1/8+1/9-1/10");
    show("1/6+1/3");
    show("1/10-1/10");
    // 1,000 random expressions of 1 to 10 fractions.
    let mut seed: i64 = 592;
    let mut zero = 0;
    let mut whole = 0;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        let e = expression(1 + step(mut seed) % 10, mut seed);
        let got = fraction_addition(e);
        if got.starts_with("0/") {
            zero += 1;
        }
        if got.ends_with("/1") {
            whole += 1;
        }
        for c in got.chars() {
            checksum = (checksum * 31 + c as i64) % 1000000007;
        }
    }
    println(f"1000 random expressions: {zero} zero, {whole} whole, checksum {checksum}");
}
