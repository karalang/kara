// Differential test for LeetCode #526: Beautiful Arrangement.
//
// Copies of the four arms, each held to the properties below for every
// n the problem allows, 1 to 15.
// Properties:
//   P1  the count is the brute force's, every permutation checked in
//       full, for n up to 9
//   P2  the four arms agree
//   P3  the count is at least n (the identity, and 1 swapped with each
//       other number, are all beautiful) and at most n!
//   P4  the count is at least the count for n - 1, since n can always be
//       put last

// ---- star: count_arrangement.kara

fn place_star(n: i64, pos: i64, used: mut ref Vec[bool]) -> i64 {
    if pos > n {
        return 1;
    }
    let mut count = 0;
    for x in 1..=n {
        if not used[x] and (x % pos == 0 or pos % x == 0) {
            used[x] = true;
            count += place_star(n, pos + 1, used);
            used[x] = false;
        }
    }
    count
}

fn count_arrangement_star(n: i64) -> i64 {
    let mut used: Vec[bool] = vec![false; n + 1];
    place_star(n, 1, mut used)
}

// ---- backwards: count_arrangement_backwards.kara

fn place_backwards(pos: i64, used: mut ref Vec[bool]) -> i64 {
    if pos == 0 {
        return 1;
    }
    let mut count = 0;
    for x in 1..used.len() {
        if not used[x] and (x % pos == 0 or pos % x == 0) {
            used[x] = true;
            count += place_backwards(pos - 1, used);
            used[x] = false;
        }
    }
    count
}

fn count_arrangement_backwards(n: i64) -> i64 {
    let mut used: Vec[bool] = vec![false; n + 1];
    place_backwards(n, mut used)
}

// ---- masks: count_arrangement_masks.kara

fn count_arrangement_masks(n: i64) -> i64 {
    let mut ways: Vec[i64] = vec![0; 1 << n];
    ways[0] = 1;
    for mask in 0..(1 << n) {
        if ways[mask] == 0 {
            continue;
        }
        let mut k = 0;
        for b in 0..n {
            if (mask >> b) & 1 == 1 {
                k += 1;
            }
        }
        let pos = k + 1;
        for x in 1..=n {
            let bit = 1 << (x - 1);
            if mask & bit == 0 and (x % pos == 0 or pos % x == 0) {
                ways[mask | bit] += ways[mask];
            }
        }
    }
    ways[(1 << n) - 1]
}

// ---- swaps: count_arrangement_swaps.kara

fn permute_swaps(perm: mut ref Vec[i64], i: i64) -> i64 {
    let n = perm.len();
    if i == n {
        return 1;
    }
    let mut count = 0;
    for j in i..n {
        perm.swap(i, j);
        let pos = i + 1;
        if perm[i] % pos == 0 or pos % perm[i] == 0 {
            count += permute_swaps(perm, i + 1);
        }
        perm.swap(i, j);
    }
    count
}

fn count_arrangement_swaps(n: i64) -> i64 {
    let mut perm: Vec[i64] = (1..=n).collect();
    permute_swaps(mut perm, 0)
}

// ---- differential harness -------------------------------------------------

fn answer(which: i64, n: i64) -> i64 {
    if which == 0 {
        count_arrangement_star(n)
    } else if which == 1 {
        count_arrangement_backwards(n)
    } else if which == 2 {
        count_arrangement_masks(n)
    } else {
        count_arrangement_swaps(n)
    }
}

// Every permutation of 1..=n in lexicographic order, each checked in
// full.
fn brute(n: i64) -> i64 {
    let mut perm: Vec[i64] = (1..=n).collect();
    let mut count = 0;
    loop {
        let mut beautiful = true;
        for i in 0..n {
            let pos = i + 1;
            if perm[i] % pos != 0 and pos % perm[i] != 0 {
                beautiful = false;
                break;
            }
        }
        if beautiful {
            count += 1;
        }
        // The next permutation: the last rise, the smallest larger number
        // after it swapped in, and the tail turned round.
        let mut i = n - 2;
        while i >= 0 and perm[i] >= perm[i + 1] {
            i -= 1;
        }
        if i < 0 {
            break;
        }
        let mut j = n - 1;
        while perm[j] <= perm[i] {
            j -= 1;
        }
        perm.swap(i, j);
        let mut a = i + 1;
        let mut b = n - 1;
        while a < b {
            perm.swap(a, b);
            a += 1;
            b -= 1;
        }
    }
    count
}

fn main() {
    let names = vec!["star", "backwards", "masks", "swaps"];
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0, 0];
    let mut previous: Vec[i64] = vec![0, 0, 0, 0];
    let mut factorial = 1;
    for n in 1..=15 {
        factorial *= n;
        let mut got: Vec[i64] = Vec.new();
        for which in 0..4 {
            got.push(answer(which, n));
        }
        let want = if n <= 9 { brute(n) } else { -1 };
        for which in 0..4 {
            let count = got[which];
            // P1: the count is the brute force's, for n up to 9.
            if n <= 9 {
                checks += 1;
                if count != want {
                    failures += 1;
                    by_property[0] += 1;
                    println(f"P1 {names[which]}: n = {n} gave {count}, want {want}");
                }
            }
            // P2: the four arms agree.
            checks += 1;
            let mut agree = true;
            for other in 0..4 {
                if got[other] != count {
                    agree = false;
                }
            }
            if not agree {
                failures += 1;
                by_property[1] += 1;
                println(f"P2 {names[which]}: n = {n} gave {count}, the arms gave {got}");
            }
            // P3: at least n (the identity, and 1 swapped with each other
            // number) and at most n!.
            checks += 1;
            if count < n or count > factorial {
                failures += 1;
                by_property[2] += 1;
                println(f"P3 {names[which]}: n = {n} gave {count}");
            }
            // P4: at least the count for n - 1, since n can always be put
            // last.
            checks += 1;
            if count < previous[which] {
                failures += 1;
                by_property[3] += 1;
                println(f"P4 {names[which]}: n = {n} gave {count}, below {previous[which]}");
            }
            previous[which] = count;
        }
    }
    println(f"n from 1 to 15, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}");
    }
}
