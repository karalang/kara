// Differential test for LeetCode #518: Coin Change II.
//
// Copies of the four arms, on 1,500 random amounts from 0 to 40 with 1
// to 5 different coins from 2 to 15. Properties:
//   P1  the count is the reference's, every way written out by a
//       depth-first search that never picks an earlier coin than the
//       last
//   P2  the coins in the other order count the same
//   P3  every coin and the amount times d (2 to 4) count the same, and
//       the amount times d plus 1 to d - 1 cannot be made
//   P4  a coin larger than the amount changes nothing
//   P5  with a 1 added, the count is the sum of the counts for every
//       amount from 0 to this one

// ---- star: change.kara

fn change_star(amount: i64, coins: Vec[i64]) -> i64 {
    let mut ways: Vec[i64] = vec![0; amount + 1];
    ways[0] = 1;
    for c in coins.iter() {
        for a in *c..=amount {
            ways[a] += ways[a - *c];
        }
    }
    ways[amount]
}

// ---- table: change_table.kara

fn change_table(amount: i64, coins: Vec[i64]) -> i64 {
    let n = coins.len();
    let mut ways: Vec[Vec[i64]] = vec![vec![0; amount + 1]; n + 1];
    for i in 0..=n {
        ways[i][0] = 1;
    }
    for i in 1..=n {
        let coin = coins[i - 1];
        for a in 1..=amount {
            ways[i][a] = ways[i - 1][a];
            if a >= coin {
                ways[i][a] += ways[i][a - coin];
            }
        }
    }
    ways[n][amount]
}

// ---- memo: change_memo.kara

fn count_memo(coins: Vec[i64], i: i64, a: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if a == 0 {
        return 1;
    }
    if i == coins.len() {
        return 0;
    }
    if let Some(v) = memo.get((i, a)) {
        return *v;
    }
    let mut ways = count_memo(coins, i + 1, a, memo);
    if coins[i] <= a {
        ways += count_memo(coins, i, a - coins[i], memo);
    }
    memo.insert((i, a), ways);
    ways
}

fn change_memo(amount: i64, coins: Vec[i64]) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    count_memo(coins, 0, amount, mut memo)
}

// ---- copies: change_copies.kara

fn change_copies(amount: i64, coins: Vec[i64]) -> i64 {
    let mut ways: Vec[i64] = vec![0; amount + 1];
    ways[0] = 1;
    for coin in coins.iter() {
        let mut next: Vec[i64] = vec![0; amount + 1];
        for a in 0..=amount {
            let mut used = 0;
            while used <= a {
                next[a] += ways[a - used];
                used += *coin;
            }
        }
        ways = next;
    }
    ways[amount]
}
// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, amount: i64, coins: Vec[i64]) -> i64 {
    match which {
        0 => change_star(amount, coins),
        1 => change_table(amount, coins),
        2 => change_memo(amount, coins),
        _ => change_copies(amount, coins),
    }
}

// The reference: every way written out as coins in order of position
// in the list, each pick no earlier than the last, by depth-first
// search; the leaves that land exactly on the amount are counted.
fn spell(coins: Vec[i64], from: i64, left: i64) -> i64 {
    if left == 0 {
        return 1;
    }
    let mut found = 0;
    for i in from..coins.len() {
        if coins[i] <= left {
            found += spell(coins, i, left - coins[i]);
        }
    }
    found
}

fn main() {
    let names = vec!["star", "table", "memo", "copies"];
    let cases = 1500;
    let mut seed: i64 = 5180;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0, 0, 0];
    for c in 0..cases {
        let amount = next_random(mut seed) % 41;
        let k = 1 + next_random(mut seed) % 5;
        let mut coins: Vec[i64] = Vec.new();
        while coins.len() < k {
            let coin = 2 + next_random(mut seed) % 14;
            if not coins.contains(coin) {
                coins.push(coin);
            }
        }
        let want = spell(coins, 0, amount);
        let mut back = coins.clone();
        back.reverse();
        let d = 2 + next_random(mut seed) % 3;
        let r = next_random(mut seed) % d;
        let mut scaled: Vec[i64] = Vec.new();
        for coin in coins.iter() {
            scaled.push(*coin * d);
        }
        let mut bigger = coins.clone();
        bigger.push(amount + 1 + next_random(mut seed) % 10);
        let mut with_one = coins.clone();
        with_one.push(1);
        for which in 0..4 {
            let got = arm(which, amount, coins);
            // P1: the count is the reference's.
            checks += 1;
            if got != want {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: case {c} gave {got}, want {want}");
                }
            }
            // P2: the coins in the other order count the same.
            checks += 1;
            let other = arm(which, amount, back);
            if other != got {
                failures += 1;
                by_property[1] += 1;
                if failures <= 5 {
                    println(f"P2 {names[which]}: case {c} reversed gave {other}, want {got}");
                }
            }
            // P3: every coin and the amount times d count the same, and
            // an amount not a multiple of d cannot be made.
            checks += 1;
            let same = arm(which, amount * d, scaled);
            let off = if r == 0 { 0 } else { arm(which, amount * d + r, scaled) };
            if same != got or off != 0 {
                failures += 1;
                by_property[2] += 1;
                if failures <= 5 {
                    println(f"P3 {names[which]}: case {c} times {d} gave {same} and {off}");
                }
            }
            // P4: a coin larger than the amount changes nothing.
            checks += 1;
            let more = arm(which, amount, bigger);
            if more != got {
                failures += 1;
                by_property[3] += 1;
                if failures <= 5 {
                    println(f"P4 {names[which]}: case {c} with a large coin gave {more}, want {got}");
                }
            }
            // P5: with a 1 added, every amount up to this one can be
            // finished with ones, so the count is the sum of the counts
            // for 0 to the amount without it.
            checks += 1;
            let mut sum = 0;
            for a in 0..=amount {
                sum += arm(which, a, coins);
            }
            let ones = arm(which, amount, with_one);
            if ones != sum {
                failures += 1;
                by_property[4] += 1;
                if failures <= 5 {
                    println(f"P5 {names[which]}: case {c} with a 1 gave {ones}, want {sum}");
                }
            }
        }
    }
    println(f"{cases} cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}, P5 {by_property[4]}");
    }
}
