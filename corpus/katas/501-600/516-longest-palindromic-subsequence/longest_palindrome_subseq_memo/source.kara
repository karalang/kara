// LeetCode #516: Longest Palindromic Subsequence -- top-down,
// remembered.
//
// The same recurrence as a recursion on (i, j), each answer kept in a
// table of Option[i64], None for not yet worked out, that goes down the
// recursion as `mut ref`. O(n^2) time and space.

fn longest(b: Slice[u8], i: i64, j: i64, memo: mut ref Vec[Vec[Option[i64]]]) -> i64 {
    if i > j {
        return 0;
    }
    if i == j {
        return 1;
    }
    if let Some(v) = memo[i][j] {
        return v;
    }
    let v = if b[i] == b[j] {
        longest(b, i + 1, j - 1, memo) + 2
    } else {
        longest(b, i + 1, j, memo).max(longest(b, i, j - 1, memo))
    };
    memo[i][j] = Some(v);
    v
}

fn longest_palindrome_subseq(s: Str) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut memo: Vec[Vec[Option[i64]]] = vec![vec![None; n]; n];
    longest(b, 0, n - 1, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"\"{s}\": {longest_palindrome_subseq(s)}");
}

fn main() {
    show("bbbab");
    show("cbbd");
    show("a");
    show("abcde");
    show("racecar");
    show("character");
    show("abacabadabacabaeabacabadabacaba");
    // 300 random strings of 1 to 80 letters from the first 2, 5 or 26
    // in turn.
    let mut seed: i64 = 516;
    let count = 300;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let letters = if t % 3 == 0 { 2 } else if t % 3 == 1 { 5 } else { 26 };
        let n = 1 + next_random(mut seed) % 80;
        let mut s = String.new();
        for _ in 0..n {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let v = longest_palindrome_subseq(s);
        total += v;
        checksum = (checksum * 31 + v) % 1000000007;
    }
    println(f"{count} random strings: {total} in all, checksum {checksum}");
}
