// LeetCode #516: Longest Palindromic Subsequence -- two rows.
//
// The table's row i reads only row i + 1, so only two rows are kept:
// `next` for i + 1 and `row` for i, swapped after each i with
// `mem.swap`. O(n^2) time, O(n) space.

fn longest_palindrome_subseq(s: Str) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut next: Vec[i64] = vec![0; n];
    let mut row: Vec[i64] = vec![0; n];
    let mut i = n;
    while i > 0 {
        i -= 1;
        row[i] = 1;
        for j in i + 1..n {
            if b[i] == b[j] {
                row[j] = next[j - 1] + 2;
            } else {
                row[j] = next[j].max(row[j - 1]);
            }
        }
        mem.swap(mut row, mut next);
    }
    next[n - 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"\"{s}\": {longest_palindrome_subseq(s)}");
}

fn main() {
    show("bbbab");
    show("cbbd");
    show("a");
    show("abcde");
    show("racecar");
    show("character");
    show("abacabadabacabaeabacabadabacaba");
    // 300 random strings of 1 to 80 letters from the first 2, 5 or 26
    // in turn.
    let mut seed: i64 = 516;
    let count = 300;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let letters = if t % 3 == 0 { 2 } else if t % 3 == 1 { 5 } else { 26 };
        let n = 1 + next_random(mut seed) % 80;
        let mut s = String.new();
        for _ in 0..n {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let v = longest_palindrome_subseq(s);
        total += v;
        checksum = (checksum * 31 + v) % 1000000007;
    }
    println(f"{count} random strings: {total} in all, checksum {checksum}");
}
