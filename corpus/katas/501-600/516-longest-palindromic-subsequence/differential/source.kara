// Differential test for LeetCode #516: Longest Palindromic
// Subsequence.
//
// Copies of the four arms, on 1,500 random strings of 1 to 10 letters
// from the first 2, 3 or 26 in turn. Properties:
//   P1  the answer is the reference's, the longest of every
//       subsequence that reads the same both ways, tried one by one
//   P2  the string backwards has the same answer
//   P3  renaming the letters (a <-> z, b <-> y, ...) changes nothing
//   P4  the string followed by itself backwards gives twice its length
//   P5  the answer is at least the most frequent letter's count and at
//       most the length

// ---- star: longest_palindrome_subseq.kara

fn longest_palindrome_subseq_star(s: Str) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut best: Vec[Vec[i64]] = vec![vec![0; n]; n];
    let mut i = n;
    while i > 0 {
        i -= 1;
        best[i][i] = 1;
        for j in i + 1..n {
            if b[i] == b[j] {
                best[i][j] = best[i + 1][j - 1] + 2;
            } else {
                best[i][j] = best[i + 1][j].max(best[i][j - 1]);
            }
        }
    }
    best[0][n - 1]
}

// ---- memo: longest_palindrome_subseq_memo.kara

fn longest_memo(b: Slice[u8], i: i64, j: i64, memo: mut ref Vec[Vec[Option[i64]]]) -> i64 {
    if i > j {
        return 0;
    }
    if i == j {
        return 1;
    }
    if let Some(v) = memo[i][j] {
        return v;
    }
    let v = if b[i] == b[j] {
        longest_memo(b, i + 1, j - 1, memo) + 2
    } else {
        longest_memo(b, i + 1, j, memo).max(longest_memo(b, i, j - 1, memo))
    };
    memo[i][j] = Some(v);
    v
}

fn longest_palindrome_subseq_memo(s: Str) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut memo: Vec[Vec[Option[i64]]] = vec![vec![None; n]; n];
    longest_memo(b, 0, n - 1, mut memo)
}

// ---- rolling: longest_palindrome_subseq_rolling.kara

fn longest_palindrome_subseq_rolling(s: Str) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut next: Vec[i64] = vec![0; n];
    let mut row: Vec[i64] = vec![0; n];
    let mut i = n;
    while i > 0 {
        i -= 1;
        row[i] = 1;
        for j in i + 1..n {
            if b[i] == b[j] {
                row[j] = next[j - 1] + 2;
            } else {
                row[j] = next[j].max(row[j - 1]);
            }
        }
        mem.swap(mut row, mut next);
    }
    next[n - 1]
}

// ---- lcs: longest_palindrome_subseq_lcs.kara

fn longest_palindrome_subseq_lcs(s: Str) -> i64 {
    let a: Vec[u8] = s.bytes().to_vec();
    let mut r = a.clone();
    r.reverse();
    let n = a.len();
    let mut common: Vec[Vec[i64]] = vec![vec![0; n + 1]; n + 1];
    for i in 1..=n {
        for j in 1..=n {
            common[i][j] = if a[i - 1] == r[j - 1] {
                common[i - 1][j - 1] + 1
            } else {
                common[i - 1][j].max(common[i][j - 1])
            };
        }
    }
    common[n][n]
}
// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, s: Str) -> i64 {
    match which {
        0 => longest_palindrome_subseq_star(s),
        1 => longest_palindrome_subseq_memo(s),
        2 => longest_palindrome_subseq_rolling(s),
        _ => longest_palindrome_subseq_lcs(s),
    }
}

// The reference: every subsequence, one bit of a mask per letter, the
// longest that reads the same both ways.
fn reference(s: Str) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut best = 0;
    for mask in 1..(1 << n) {
        let mut picked: Vec[u8] = Vec.new();
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                picked.push(b[i]);
            }
        }
        let m = picked.len();
        let mut mirror = true;
        for k in 0..m / 2 {
            if picked[k] != picked[m - 1 - k] {
                mirror = false;
            }
        }
        if mirror and m > best {
            best = m;
        }
    }
    best
}

fn reversed(s: Str) -> String {
    let b = s.bytes();
    let mut out = String.new();
    let mut i = b.len();
    while i > 0 {
        i -= 1;
        out.push(b[i] as char);
    }
    out
}

// Every letter swapped for its partner from the other end of the
// alphabet.
fn relabelled(s: Str) -> String {
    let mut out = String.new();
    for b in s.bytes() {
        out.push((b'z' - (*b - b'a')) as char);
    }
    out
}

fn main() {
    let names = vec!["star", "memo", "rolling", "lcs"];
    let cases = 1500;
    let mut seed: i64 = 5160;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0, 0, 0];
    for c in 0..cases {
        let letters = if c % 3 == 0 { 2 } else if c % 3 == 1 { 3 } else { 26 };
        let n = 1 + next_random(mut seed) % 10;
        let mut s = String.new();
        let mut count: Vec[i64] = vec![0; 26];
        for _ in 0..n {
            let l = next_random(mut seed) % letters;
            count[l] += 1;
            s.push((b'a' + l as u8) as char);
        }
        let mut most = 0;
        for k in count.iter() {
            most = most.max(*k);
        }
        let want = reference(s);
        let back = reversed(s);
        let renamed = relabelled(s);
        let mut both = s.clone();
        both.push_str(back.as_str());
        for which in 0..4 {
            let got = arm(which, s);
            // P1: the answer is the reference's.
            checks += 1;
            if got != want {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: \"{s}\" gave {got}, want {want}");
                }
            }
            // P2: the string backwards has the same answer.
            checks += 1;
            let other = arm(which, back);
            if other != got {
                failures += 1;
                by_property[1] += 1;
                if failures <= 5 {
                    println(f"P2 {names[which]}: \"{back}\" gave {other}, \"{s}\" gave {got}");
                }
            }
            // P3: renaming the letters changes nothing.
            checks += 1;
            let r = arm(which, renamed);
            if r != got {
                failures += 1;
                by_property[2] += 1;
                if failures <= 5 {
                    println(f"P3 {names[which]}: \"{renamed}\" gave {r}, want {got}");
                }
            }
            // P4: the string followed by itself backwards is a palindrome
            // of twice its length.
            checks += 1;
            let whole = arm(which, both);
            if whole != 2 * n {
                failures += 1;
                by_property[3] += 1;
                if failures <= 5 {
                    println(f"P4 {names[which]}: \"{both}\" gave {whole}, want {2 * n}");
                }
            }
            // P5: at least the most frequent letter's count, at most the
            // whole length.
            checks += 1;
            if got < most or got > n {
                failures += 1;
                by_property[4] += 1;
                if failures <= 5 {
                    println(f"P5 {names[which]}: \"{s}\" gave {got}, outside {most} to {n}");
                }
            }
        }
    }
    println(f"{cases} cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}, P5 {by_property[4]}");
    }
}
