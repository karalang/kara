// LeetCode #557: Reverse Words in a String III -- one iterator chain.
//
// The words come from `split` (a Vec today, so `.iter()`), each is mapped
// to its chars collected backwards, the results are collected into a
// Vec[String], and that is joined with single spaces.

fn reverse_words(s: String) -> String {
    let words: Vec[String] = s.split(" ").map(|w| w.chars().rev().collect()).collect();
    words.join(" ")
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: String) {
    println(f"\"{s}\" -> \"{reverse_words(s.clone())}\"");
}

// Words of 1 to `longest` printable characters other than a space,
// joined by single spaces, `words` of them.
fn random_text(words: i64, longest: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for k in 0..words {
        if k > 0 {
            s.push(' ');
        }
        let length = 1 + next_random(mut seed) % longest;
        for _ in 0..length {
            s.push((b'!' + (next_random(mut seed) % 94) as u8) as char);
        }
    }
    s
}

fn checksum(s: String) -> i64 {
    let mut h: i64 = 0;
    for b in s.bytes() {
        h = (h * 131 + b as i64) % 1000000007;
    }
    h
}

fn main() {
    show("Let's take LeetCode contest".to_string());
    show("Mr Ding".to_string());
    show("a".to_string());
    show("ab cd".to_string());
    show("racecar level noon".to_string());
    show("12345 !?.,; (x)".to_string());

    // 300 random texts of 1 to 20 words of 1 to 12 characters.
    let mut seed: i64 = 557;
    let mut chars = 0;
    let mut h: i64 = 0;
    for _ in 0..300 {
        let words = 1 + next_random(mut seed) % 20;
        let text = random_text(words, 12, mut seed);
        chars += text.len();
        h = (h * 31 + checksum(reverse_words(text))) % 1000000007;
    }
    println(f"300 random texts: {chars} characters, checksum {h}");

    // The problem's most, 50,000 characters: one word, and words of one
    // character.
    let mut one = String.new();
    for k in 0..50000 {
        one.push((b'a' + (k % 26) as u8) as char);
    }
    let mut singles = String.new();
    for k in 0..25000 {
        if k > 0 {
            singles.push(' ');
        }
        singles.push((b'a' + (k % 26) as u8) as char);
    }
    for text in vec![one, singles] {
        let got = reverse_words(text.clone());
        println(f"{text.len()} characters -> {got.len()}, starting {got[..10]}, checksum {checksum(got)}");
    }
}
