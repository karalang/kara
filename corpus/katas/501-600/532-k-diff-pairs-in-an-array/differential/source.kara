// Differential test for LeetCode #532: K-diff Pairs in an Array.
//
// Copies of the four arms, each held to the properties below on 1,000
// random arrays of 1 to 40 numbers from -5 to 5, -50 to 50, or the whole
// range, in turn; k is 0 to 3 for a third of them and otherwise the
// difference between the first number and a random one, so that pairs
// occur at every range.
// Properties:
//   P1  the answer is the definition's: the different pairs (smaller,
//       larger) taken from every two places whose numbers differ by k
//   P2  the numbers in a shuffled order give the same answer
//   P3  every number negated gives the same answer
//   P4  every number shifted by the same amount gives the same answer
//   P5  the numbers written twice give the same answer, except for
//       k = 0, where every different number then makes a pair

// ---- star: find_pairs.kara

fn find_pairs_star(nums: Vec[i64], k: i64) -> i64 {
    let mut counts: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        *counts.entry(*x).or_insert(0) += 1;
    }
    let mut pairs = 0;
    for (v, c) in counts.iter() {
        if k == 0 {
            if *c >= 2 {
                pairs += 1;
            }
        } else if counts.contains_key(*v + k) {
            pairs += 1;
        }
    }
    pairs
}

// ---- pointers: find_pairs_pointers.kara

fn find_pairs_pointers(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut pairs = 0;
    let mut left = 0;
    for right in 1..n {
        if right + 1 < n and sorted[right + 1] == sorted[right] {
            continue;
        }
        while left < right and sorted[right] - sorted[left] > k {
            left += 1;
        }
        if left < right and sorted[right] - sorted[left] == k {
            pairs += 1;
        }
    }
    pairs
}

// ---- search: find_pairs_search.kara

fn find_pairs_search(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut pairs = 0;
    for i in 0..n {
        if i > 0 and sorted[i] == sorted[i - 1] {
            continue;
        }
        let want = sorted[i] + k;
        let mut low = i + 1;
        let mut high = n;
        while low < high {
            let mid = (low + high) / 2;
            if sorted[mid] < want {
                low = mid + 1;
            } else {
                high = mid;
            }
        }
        if low < n and sorted[low] == want {
            pairs += 1;
        }
    }
    pairs
}

// ---- sets: find_pairs_sets.kara

fn find_pairs_sets(nums: Vec[i64], k: i64) -> i64 {
    let mut seen: Set[i64] = Set.new();
    let mut smaller: Set[i64] = Set.new();
    for x in nums.iter() {
        if seen.contains(*x - k) {
            smaller.insert(*x - k);
        }
        if seen.contains(*x + k) {
            smaller.insert(*x);
        }
        seen.insert(*x);
    }
    smaller.len()
}

// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, nums: Vec[i64], k: i64) -> i64 {
    if which == 0 {
        find_pairs_star(nums, k)
    } else if which == 1 {
        find_pairs_pointers(nums, k)
    } else if which == 2 {
        find_pairs_search(nums, k)
    } else {
        find_pairs_sets(nums, k)
    }
}

// The definition: every two places i < j whose numbers differ by k give
// the pair (smaller, larger); the answer is how many different pairs.
fn definition(nums: Vec[i64], k: i64) -> i64 {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            if (nums[i] - nums[j]).abs() == k {
                pairs.push((nums[i].min(nums[j]), nums[i].max(nums[j])));
            }
        }
    }
    pairs.sort();
    pairs.dedup();
    pairs.len()
}

fn main() {
    let names = vec!["star", "pointers", "search", "sets"];
    let count = 1000;
    let mut seed: i64 = 5320;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    for t in 0..count {
        let half = if t % 3 == 0 { 5 } else if t % 3 == 1 { 50 } else { 10000000 };
        let size = 1 + next_random(mut seed) % 40;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..size {
            nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * half + 1) - half);
        }
        // k from 0 to 3 a third of the time, else a difference that occurs.
        let k = if t % 3 == 0 { next_random(mut seed) % 4 } else { (nums[0] - nums[next_random(mut seed) % size]).abs() };
        let want = definition(nums.clone(), k);
        let mut shuffled = nums.clone();
        for i in (1..size).rev() {
            let j = next_random(mut seed) % (i + 1);
            shuffled.swap(i, j);
        }
        let mut negated: Vec[i64] = Vec.new();
        let mut shifted: Vec[i64] = Vec.new();
        let shift = next_random(mut seed) % 2001 - 1000;
        for x in nums.iter() {
            negated.push(-*x);
            shifted.push(*x + shift);
        }
        let mut doubled = nums.clone();
        doubled.extend(nums.clone());
        let mut distinct = nums.clone();
        distinct.sort();
        distinct.dedup();
        for which in 0..4 {
            let got = answer(which, nums.clone(), k);
            let twice = answer(which, doubled.clone(), k);
            let ok = vec![
                got == want,
                answer(which, shuffled.clone(), k) == got,
                answer(which, negated.clone(), k) == got,
                answer(which, shifted.clone(), k) == got,
                if k == 0 { twice == distinct.len() } else { twice == got },
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                    if failures[p] <= 3 {
                        println(f"FAIL P{p + 1} {names[which]}: {nums}, k = {k} -> {got}, want {want}");
                    }
                }
            }
        }
    }
    let total = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases, 4 arms, {checks} checks, {total} failures");
    if total > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
