// LeetCode #532: K-diff Pairs in an Array -- count each number.
//
// A pair is two values, so count how often each value occurs. For k = 0
// a pair is a value that occurs twice or more; otherwise it is a value v
// whose v + k also occurs, each counted once from its smaller end.
// O(n) time and O(n) space.

fn find_pairs(nums: Vec[i64], k: i64) -> i64 {
    let mut counts: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        *counts.entry(*x).or_insert(0) += 1;
    }
    let mut pairs = 0;
    for (v, c) in counts.iter() {
        if k == 0 {
            if *c >= 2 {
                pairs += 1;
            }
        } else if counts.contains_key(*v + k) {
            pairs += 1;
        }
    }
    pairs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(name: Str, nums: Vec[i64], k: i64) {
    println(f"{name}: {nums}, k = {k} -> {find_pairs(nums, k)}");
}

fn main() {
    show("example 1", vec![3, 1, 4, 1, 5], 2);
    show("example 2", vec![1, 2, 3, 4, 5], 1);
    show("example 3", vec![1, 3, 1, 5, 4], 0);
    show("no repeats, k = 0", vec![4, 2, 9], 0);
    show("all equal, k = 0", vec![7, 7, 7, 7], 0);
    show("all equal, k = 1", vec![7, 7, 7, 7], 1);
    show("one number", vec![5], 0);
    show("negatives", vec![-1, -2, -3, -1], 1);
    show("the extremes", vec![0, 10000000, -10000000], 10000000);
    // 300 random arrays of 1 to 50 numbers from -10 to 10, -100 to 100,
    // or the whole range, in turn, with k from 0 to 4 for the first two
    // and up to 10,000,000 for the last.
    let mut seed: i64 = 532;
    let mut total = 0;
    let mut checksum = 0;
    for t in 0..300 {
        let half = if t % 3 == 0 { 10 } else if t % 3 == 1 { 100 } else { 10000000 };
        let size = 1 + next_random(mut seed) % 50;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..size {
            nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * half + 1) - half);
        }
        let k = if t % 3 == 2 { nums[0].abs() } else { next_random(mut seed) % 5 };
        let answer = find_pairs(nums, k);
        total += answer;
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"300 random arrays: {total} pairs, checksum {checksum}");
    // The largest: 10,000 numbers (the problem's most) from -5,000 to
    // 5,000, for k = 0, 1 and 7.
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..10000 {
        nums.push(next_random(mut seed) % 10001 - 5000);
    }
    println(f"10000 numbers: k = 0 -> {find_pairs(nums, 0)}, k = 1 -> {find_pairs(nums, 1)}, k = 7 -> {find_pairs(nums, 7)}");
}
