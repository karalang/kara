// LeetCode #552: Student Attendance Record II -- six counters, rolled.
//
// A record that can still win is in one of six states: 0 or 1
// absences, and 0, 1 or 2 lates at its end. Each day adds a P, an A or
// an L to every record counted so far: a P keeps the absences and ends
// the lates, an A is allowed only with no absence yet, and an L adds a
// late if there are fewer than two. Six counters, rolled forward n
// times. O(n) time.

fn check_record(n: i64) -> i64 {
    let m = 1000000007;
    // count[a * 3 + l]: records with a absences ending in l lates.
    let mut count = vec![1, 0, 0, 0, 0, 0];
    for _ in 0..n {
        let mut next = vec![0; 6];
        for a in 0..2 {
            for l in 0..3 {
                let c = count[a * 3 + l];
                if c == 0 {
                    continue;
                }
                next[a * 3] = (next[a * 3] + c) % m;
                if a == 0 {
                    next[3] = (next[3] + c) % m;
                }
                if l < 2 {
                    next[a * 3 + l + 1] = (next[a * 3 + l + 1] + c) % m;
                }
            }
        }
        count = next;
    }
    let mut total = 0;
    for c in count.iter() {
        total = (total + *c) % m;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"example 1: n = 2 -> {check_record(2)}");
    println(f"example 2: n = 1 -> {check_record(1)}");
    println(f"example 3: n = 10101 -> {check_record(10101)}");
    let mut small: Vec[i64] = Vec.new();
    for n in 1..13 {
        small.push(check_record(n));
    }
    println(f"n = 1 to 12: {small}");

    // 300 random lengths from 1 to 2000.
    let mut seed: i64 = 552;
    let mut days = 0;
    let mut h: i64 = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 2000;
        days += n;
        h = (h * 31 + check_record(n)) % 1000000007;
    }
    println(f"300 random lengths: {days} days, checksum {h}");

    // Up to 100,000 days (the problem's most).
    for n in vec![1000, 9999, 50000, 99999, 100000] {
        println(f"n = {n} -> {check_record(n)}");
    }
}
