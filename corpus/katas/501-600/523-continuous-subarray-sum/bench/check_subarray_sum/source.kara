// Benchmark for LeetCode #523: Continuous Subarray Sum -- the ★ arm
// (first index of each prefix remainder); see ../check_subarray_sum.kara.

fn check_subarray_sum(nums: Vec[i64], k: i64) -> bool {
    let mut first: Map[i64, i64] = Map.new();
    first.insert(0, -1);
    let mut rem = 0;
    for i in 0..nums.len() {
        rem = (rem + nums[i]) % k;
        match first.get(rem) {
            Some(j) => {
                if i - *j >= 2 {
                    return true;
                }
            }
            None => {
                first.insert(rem, i);
            }
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 20 random arrays of 100,000 numbers from 1 to 20,000 (the problem's
// longest, summing under 2^31) made once; then each checked in 10
// rounds against a fresh k from 10,000 to 1,073,751,823.
fn main() {
    let mut seed: i64 = 523;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(1 + next_random(mut seed) % 20000);
        }
        arrays.push(nums);
    }
    let mut yes = 0;
    let mut checksum = 0;
    for round in 0..10 {
        for a in 0..arrays.len() {
            let high = next_random(mut seed);
            let k = 10000 + high * 32768 + next_random(mut seed);
            if check_subarray_sum(arrays[a], k) {
                yes += 1;
                checksum = (checksum + (round + 1) * (a + 1)) % 1000000007;
            }
        }
    }
    println(f"20 arrays of 100000, 10 rounds: {yes} true, checksum {checksum}");
}
