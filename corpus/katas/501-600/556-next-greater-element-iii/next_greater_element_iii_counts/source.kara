// LeetCode #556: Next Greater Element III -- digit counts, no swapping.
//
// The digits are peeled off from the right with % and /, and a count of
// each digit seen so far is kept. The first digit with a larger one
// already seen is the one to raise: it becomes the smallest larger digit
// counted, and everything after it is the rest of the counted digits
// (the old digit back in, the new one out) in rising order. O(digits).

fn next_greater_element(n: i64) -> i64 {
    let mut count = vec![0; 10];
    let mut rest = n;
    while rest > 0 {
        let d = rest % 10;
        rest /= 10;
        let mut up = d + 1;
        while up < 10 and count[up] == 0 {
            up += 1;
        }
        if up < 10 {
            count[up] -= 1;
            count[d] += 1;
            let mut out = rest * 10 + up;
            for v in 0..10 {
                for _ in 0..count[v] {
                    out = out * 10 + v;
                }
            }
            return if out > 2147483647 { -1 } else { out };
        }
        count[d] += 1;
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n} -> {next_greater_element(n)}");
}

fn main() {
    for n in vec![12, 21, 1, 11, 230241, 12443322, 1999999999, 2147483476, 2147483486, 2147483647, 1234567890, 9876543210 / 10] {
        show(n);
    }

    // 300 random numbers of 1 to 10 digits, up to 2^31 - 1.
    let mut seed: i64 = 556;
    let mut found = 0;
    let mut h: i64 = 0;
    for t in 0..300 {
        let top = if t % 3 == 0 { 1000 } else if t % 3 == 1 { 10000000 } else { 2147483647 };
        let n = 1 + (next_random(mut seed) * 65536 + next_random(mut seed)) % top;
        let got = next_greater_element(n);
        if got > 0 {
            found += 1;
        }
        h = (h * 31 + got + 1) % 1000000007;
    }
    println(f"300 random numbers: {found} have a next, checksum {h}");
}
