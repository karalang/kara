// LeetCode #556: Next Greater Element III -- the next permutation on the
// number's text.
//
// The same steps as the ★ arm on the digits as chars: the number is
// written out with `to_string`, permuted as a Vec[char], collected back
// into a String and read with `i64.parse`, then held to 32 bits.

fn next_greater_element(n: i64) -> i64 {
    let mut c: Vec[char] = n.to_string().chars().collect();
    let len = c.len();
    let mut i = len - 2;
    while i >= 0 and c[i] >= c[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return -1;
    }
    let mut j = len - 1;
    while c[j] <= c[i] {
        j -= 1;
    }
    c.swap(i, j);
    c[i + 1..].reverse();
    let text: String = c.iter().collect();
    let out = i64.parse(text).expect("digits");
    if out > 2147483647 { -1 } else { out }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n} -> {next_greater_element(n)}");
}

fn main() {
    for n in vec![12, 21, 1, 11, 230241, 12443322, 1999999999, 2147483476, 2147483486, 2147483647, 1234567890, 9876543210 / 10] {
        show(n);
    }

    // 300 random numbers of 1 to 10 digits, up to 2^31 - 1.
    let mut seed: i64 = 556;
    let mut found = 0;
    let mut h: i64 = 0;
    for t in 0..300 {
        let top = if t % 3 == 0 { 1000 } else if t % 3 == 1 { 10000000 } else { 2147483647 };
        let n = 1 + (next_random(mut seed) * 65536 + next_random(mut seed)) % top;
        let got = next_greater_element(n);
        if got > 0 {
            found += 1;
        }
        h = (h * 31 + got + 1) % 1000000007;
    }
    println(f"300 random numbers: {found} have a next, checksum {h}");
}
