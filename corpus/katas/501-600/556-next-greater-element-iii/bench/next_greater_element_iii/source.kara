// Benchmark for #556: Next Greater Element III -- the ★ arm (the next
// permutation of the digits).
//
// From the right, find the first digit smaller than the one after it,
// swap it with the last larger digit to its right, and reverse the rest;
// -1 if there is no such digit or the result does not fit in 32 bits.
// O(digits) time, with a fresh Vec of digits for every number.

fn next_greater_element(n: i64) -> i64 {
    let mut d: Vec[i64] = Vec.new();
    let mut x = n;
    while x > 0 {
        d.push(x % 10);
        x /= 10;
    }
    d.reverse();
    let len = d.len();
    let mut i = len - 2;
    while i >= 0 and d[i] >= d[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return -1;
    }
    let mut j = len - 1;
    while d[j] <= d[i] {
        j -= 1;
    }
    d.swap(i, j);
    d[i + 1..].reverse();
    let mut out = 0;
    for v in d.iter() {
        out = out * 10 + *v;
    }
    if out > 2147483647 { -1 } else { out }
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 500,000 random numbers up to 1,000, 10^7 or 2^31 - 1 in turn, built
    // once. Then 20 times over every number is answered.
    let count = 500000;
    let mut seed: i64 = 556;
    let mut numbers: Vec[i64] = Vec.new();
    for t in 0..count {
        let top = if t % 3 == 0 { 1000 } else if t % 3 == 1 { 10000000 } else { 2147483647 };
        numbers.push(1 + (next_random(mut seed) * 65536 + next_random(mut seed)) % top);
    }
    let mut found = 0;
    let mut checksum: i64 = 0;
    for round in 0..20 {
        for g in 0..count {
            let got = next_greater_element(numbers[(round * 7 + g) % count]);
            if got > 0 {
                found += 1;
            }
            checksum = (checksum * 31 + got + 1) % 1000000007;
        }
    }
    println(f"{count} numbers, 20 rounds each: {found} have a next, checksum {checksum}");
}
