// LeetCode #556: Next Greater Element III -- the next permutation of the
// digits.
//
// From the right, find the first digit smaller than the one after it;
// if there is none the digits only fall and nothing larger can be made.
// Swap it with the smallest larger digit to its right, which is the
// last digit to its right that is larger, then reverse everything after
// it, which was falling and so becomes rising. The result is -1 if it
// does not fit in 32 bits. O(digits) time.

fn next_greater_element(n: i64) -> i64 {
    let mut d: Vec[i64] = Vec.new();
    let mut x = n;
    while x > 0 {
        d.push(x % 10);
        x /= 10;
    }
    d.reverse();
    let len = d.len();
    let mut i = len - 2;
    while i >= 0 and d[i] >= d[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return -1;
    }
    let mut j = len - 1;
    while d[j] <= d[i] {
        j -= 1;
    }
    d.swap(i, j);
    d[i + 1..].reverse();
    let mut out = 0;
    for v in d.iter() {
        out = out * 10 + *v;
    }
    if out > 2147483647 { -1 } else { out }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n} -> {next_greater_element(n)}");
}

fn main() {
    for n in vec![12, 21, 1, 11, 230241, 12443322, 1999999999, 2147483476, 2147483486, 2147483647, 1234567890, 9876543210 / 10] {
        show(n);
    }

    // 300 random numbers of 1 to 10 digits, up to 2^31 - 1.
    let mut seed: i64 = 556;
    let mut found = 0;
    let mut h: i64 = 0;
    for t in 0..300 {
        let top = if t % 3 == 0 { 1000 } else if t % 3 == 1 { 10000000 } else { 2147483647 };
        let n = 1 + (next_random(mut seed) * 65536 + next_random(mut seed)) % top;
        let got = next_greater_element(n);
        if got > 0 {
            found += 1;
        }
        h = (h * 31 + got + 1) % 1000000007;
    }
    println(f"300 random numbers: {found} have a next, checksum {h}");
}
