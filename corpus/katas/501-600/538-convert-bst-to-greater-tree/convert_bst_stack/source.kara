// LeetCode #538: Convert BST to Greater Tree -- reverse in order, with
// a stack.
//
// The same walk as the recursive arm, largest value first, with the
// path kept on an explicit stack: go right as far as possible pushing
// each node, then pop one, add its value to the running total, write
// the total back and carry on from its left child. O(n) time, O(h)
// stack.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn convert_bst(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut stack: Vec[TreeNode] = Vec.new();
    let mut cur = root;
    let mut total = 0;
    loop {
        while let Some(n) = cur {
            stack.push(n);
            cur = n.right;
        }
        match stack.pop() {
            Some(n) => {
                total += n.val;
                n.val = total;
                cur = n.left;
            }
            None => {
                break;
            }
        }
    }
    root
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A search tree of distinct values, inserted in the order given.
fn build(values: Vec[i64]) -> Option[TreeNode] {
    if values.is_empty() {
        return None;
    }
    let root = leaf(values[0]);
    for i in 1..values.len() {
        let v = values[i];
        let mut node = root;
        loop {
            if v < node.val {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(leaf(v));
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(leaf(v));
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

// The tree level by level, as LeetCode writes it: `None` for a missing
// child, and the missing children after the last node left off.
fn level_order(root: Option[TreeNode]) -> Vec[Option[i64]] {
    let mut out: Vec[Option[i64]] = Vec.new();
    let mut queue: Vec[Option[TreeNode]] = vec![root];
    let mut head = 0;
    while head < queue.len() {
        match queue[head] {
            Some(n) => {
                out.push(Some(n.val));
                queue.push(n.left);
                queue.push(n.right);
            }
            None => out.push(None),
        }
        head += 1;
    }
    while out.len() > 0 and out[out.len() - 1].is_none() {
        out.pop();
    }
    out
}

fn written(root: Option[TreeNode]) -> String {
    let parts: Vec[String] = level_order(root).iter().map(|v| match v {
        Some(x) => f"{x}",
        None => "null".to_string(),
    }).collect();
    f"[{parts.join(",")}]"
}

fn mix(h: mut ref i64, root: Option[TreeNode]) {
    for v in level_order(root) {
        let x = match v {
            Some(x) => x + 1000000000,
            None => 7,
        };
        *h = (*h * 31 + x) % 1000000007;
    }
}

fn show(name: Str, values: Vec[i64]) {
    let root = build(values);
    let before = written(root);
    println(f"{name}: {before} -> {written(convert_bst(root))}");
}

fn main() {
    let mut seed: i64 = 538;
    show("example 1", vec![4, 1, 6, 0, 2, 5, 7, 3, 8]);
    show("example 2", vec![0, 1]);
    show("one node", vec![5]);
    show("no nodes", Vec.new());
    show("negative values", vec![-3, -5, -1, -4, -2]);
    show("both ends of the range", vec![0, -10000, 10000, -1, 1]);
    show("falling chain", vec![5, 4, 3, 2, 1]);
    show("rising chain", vec![1, 2, 3, 4, 5]);
    // 300 random trees of 0 to 80 distinct values from -10,000 to
    // 10,000: the first places of a shuffle of the whole range.
    let mut pool: Vec[i64] = Vec.new();
    for v in -10000..10001 {
        pool.push(v);
    }
    let count = 300;
    let mut total = 0;
    let mut h: i64 = 0;
    for _ in 0..count {
        let size = next_random(mut seed) % 81;
        let mut values: Vec[i64] = Vec.new();
        for i in 0..size {
            let j = i + (next_random(mut seed) * 32768 + next_random(mut seed)) % (20001 - i);
            pool.swap(i, j);
            values.push(pool[i]);
        }
        total += size;
        mix(mut h, convert_bst(build(values)));
    }
    println(f"{count} random trees: {total} values, checksum {h}");
    // The largest: 10,000 values (the problem's most), -5,000 to 4,999
    // in a random order.
    let mut values: Vec[i64] = Vec.new();
    for v in -5000..5000 {
        values.push(v);
    }
    for i in (1..10000).rev() {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        values.swap(i, j);
    }
    let mut h: i64 = 0;
    let root = convert_bst(build(values));
    mix(mut h, root);
    println(f"10000 values in a random order: root {root.unwrap().val}, checksum {h}");
    // And 10,000 values in a chain, each the right child of the one
    // before: 1 to 10,000 rising, as deep as a tree of that many nodes
    // can be.
    let top = leaf(1);
    let mut last = top;
    for v in 2..10001 {
        let next = leaf(v);
        last.right = Some(next);
        last = next;
    }
    let mut h: i64 = 0;
    let root = convert_bst(Some(top));
    mix(mut h, root);
    println(f"a chain of 10000: top {top.val}, bottom {last.val}, checksum {h}");
}
