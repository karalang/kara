// Differential test for LeetCode #538: Convert BST to Greater Tree.
//
// Copies of the four arms, each held to the properties below on 1,000
// random search trees of 0 to 40 distinct values from -10,000 to
// 10,000, or one time in three from -20 to 20.
// Properties:
//   P1  every node's new value is the definition's: the sum of the
//       original values at least its own
//   P2  the tree keeps its nodes and its shape, and its root is returned
//   P3  the smallest node ends with the sum of every value, and the
//       largest keeps its own
//   P4  with every value positive, the new values fall in order
//   P5  the new values sum to each original value times its rank from
//       the bottom (the smallest counted once, the next twice, ...)

// ---- star: convert_bst.kara

fn visit_star(node: Option[TreeNode], total: mut ref i64) {
    if let Some(n) = node {
        visit_star(n.right, total);
        *total += n.val;
        n.val = *total;
        visit_star(n.left, total);
    }
}

fn convert_bst_star(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut total = 0;
    visit_star(root, mut total);
    root
}

// ---- stack: convert_bst_stack.kara

fn convert_bst_stack(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut stack: Vec[TreeNode] = Vec.new();
    let mut cur = root;
    let mut total = 0;
    loop {
        while let Some(n) = cur {
            stack.push(n);
            cur = n.right;
        }
        match stack.pop() {
            Some(n) => {
                total += n.val;
                n.val = total;
                cur = n.left;
            }
            None => {
                break;
            }
        }
    }
    root
}

// ---- morris: convert_bst_morris.kara

fn convert_bst_morris(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut cur = root;
    let mut total = 0;
    while let Some(n) = cur {
        if let Some(r) = n.right {
            let mut succ = r;
            loop {
                match succ.left {
                    Some(l) => {
                        if l.ref_eq(n) {
                            break;
                        }
                        succ = l;
                    }
                    None => {
                        break;
                    }
                }
            }
            if succ.left.is_none() {
                succ.left = Some(n);
                cur = n.right;
                continue;
            }
            succ.left = None;
        }
        total += n.val;
        n.val = total;
        cur = n.left;
    }
    root
}

// ---- suffix: convert_bst_suffix.kara

fn in_order_suffix(node: Option[TreeNode], out: mut ref Vec[TreeNode]) {
    if let Some(n) = node {
        in_order_suffix(n.left, out);
        out.push(n);
        in_order_suffix(n.right, out);
    }
}

fn convert_bst_suffix(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut nodes: Vec[TreeNode] = Vec.new();
    in_order_suffix(root, mut nodes);
    let mut total = 0;
    for n in nodes.iter().rev() {
        total += n.val;
        n.val = total;
    }
    root
}

// ---- differential harness -------------------------------------------------

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn build(values: Vec[i64]) -> Option[TreeNode] {
    if values.is_empty() {
        return None;
    }
    let root = leaf(values[0]);
    for i in 1..values.len() {
        let v = values[i];
        let mut node = root;
        loop {
            if v < node.val {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(leaf(v));
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(leaf(v));
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

fn convert(which: i64, root: Option[TreeNode]) -> Option[TreeNode] {
    if which == 0 {
        convert_bst_star(root)
    } else if which == 1 {
        convert_bst_stack(root)
    } else if which == 2 {
        convert_bst_morris(root)
    } else {
        convert_bst_suffix(root)
    }
}

// The tree in pre-order: each node's value, and which children it has
// (1 for a left, 2 for a right). A left-over Morris thread would make
// a cycle, so at most `budget` nodes are visited and -1 marks where the
// walk stopped.
fn pre_order(node: Option[TreeNode], vals: mut ref Vec[i64], kids: mut ref Vec[i64], budget: mut ref i64) {
    if let Some(n) = node {
        if *budget == 0 {
            kids.push(-1);
            return;
        }
        *budget -= 1;
        vals.push(n.val);
        let mut k = 0;
        if n.left.is_some() {
            k += 1;
        }
        if n.right.is_some() {
            k += 2;
        }
        kids.push(k);
        pre_order(n.left, vals, kids, budget);
        pre_order(n.right, vals, kids, budget);
    }
}

// The values in order, with the same budget.
fn in_order_values(node: Option[TreeNode], out: mut ref Vec[i64], budget: mut ref i64) {
    if let Some(n) = node {
        if *budget == 0 {
            return;
        }
        *budget -= 1;
        in_order_values(n.left, out, budget);
        out.push(n.val);
        in_order_values(n.right, out, budget);
    }
}

// The definition: the sum of the values at least v.
fn greater_sum(values: Vec[i64], v: i64) -> i64 {
    let mut sum = 0;
    for w in values.iter() {
        if *w >= v {
            sum += *w;
        }
    }
    sum
}

fn main() {
    let names = vec!["star", "stack", "morris", "suffix"];
    let count = 1000;
    let mut seed: i64 = 5380;
    let mut pool: Vec[i64] = Vec.new();
    for v in -10000..10001 {
        pool.push(v);
    }
    let mut checks = 0;
    let mut failures = vec![0; 5];
    for _ in 0..count {
        // 0 to 40 distinct values from -10,000 to 10,000, or one time in
        // three from -20 to 20, where sums cross zero often.
        let size = next_random(mut seed) % 41;
        let narrow = next_random(mut seed) % 3 == 0;
        let mut values: Vec[i64] = Vec.new();
        if narrow {
            let mut small: Vec[i64] = Vec.new();
            for v in -20..21 {
                small.push(v);
            }
            for i in 0..size {
                let j = i + next_random(mut seed) % (41 - i);
                small.swap(i, j);
                values.push(small[i]);
            }
        } else {
            for i in 0..size {
                let j = i + (next_random(mut seed) * 32768 + next_random(mut seed)) % (20001 - i);
                pool.swap(i, j);
                values.push(pool[i]);
            }
        }
        let mut sorted = values.clone();
        sorted.sort();
        let mut total = 0;
        let mut weighted = 0;
        for i in 0..sorted.len() {
            total += sorted[i];
            weighted += sorted[i] * (i as i64 + 1);
        }
        // Every value moved up past 10,000, so all are positive.
        let mut positive: Vec[i64] = Vec.new();
        for v in values.iter() {
            positive.push(*v + 10001);
        }
        for which in 0..4 {
            let root = build(values.clone());
            let mut vals: Vec[i64] = Vec.new();
            let mut kids: Vec[i64] = Vec.new();
            let mut budget = size + 1;
            pre_order(root, mut vals, mut kids, mut budget);
            let back = convert(which, root);
            let mut new_vals: Vec[i64] = Vec.new();
            let mut new_kids: Vec[i64] = Vec.new();
            let mut budget = size + 1;
            pre_order(root, mut new_vals, mut new_kids, mut budget);
            let mut p1 = new_vals.len() == vals.len();
            if p1 {
                for i in 0..vals.len() {
                    if new_vals[i] != greater_sum(values.clone(), vals[i]) {
                        p1 = false;
                    }
                }
            }
            let same_root = match (root, back) {
                (Some(a), Some(b)) => a.ref_eq(b),
                (None, None) => true,
                _ => false,
            };
            let p2 = same_root and new_kids == kids;
            let mut ordered: Vec[i64] = Vec.new();
            let mut budget = size + 1;
            in_order_values(root, mut ordered, mut budget);
            let p3 = size == 0 or (ordered.len() == size and ordered[0] == total and ordered[size - 1] == sorted[size - 1]);
            let mut sum = 0;
            for v in ordered.iter() {
                sum += *v;
            }
            let p5 = ordered.len() == size and sum == weighted;
            let lifted = convert(which, build(positive.clone()));
            let mut falling: Vec[i64] = Vec.new();
            let mut budget = size + 1;
            in_order_values(lifted, mut falling, mut budget);
            let mut p4 = falling.len() == size;
            for i in 1..falling.len() {
                if falling[i] >= falling[i - 1] {
                    p4 = false;
                }
            }
            let ok = vec![p1, p2, p3, p4, p5];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                    if failures[p] <= 3 {
                        println(f"FAIL P{p + 1} {names[which]}: {values} -> {new_vals}");
                    }
                }
            }
        }
    }
    let total = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases, 4 arms, {checks} checks, {total} failures");
    if total > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
