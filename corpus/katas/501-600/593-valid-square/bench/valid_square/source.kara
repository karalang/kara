// Benchmark for #593: the ★ arm (the six distances, sorted); see
// valid_square.kara.

fn dist(a: Vec[i64], b: Vec[i64]) -> i64 {
    let dx = a[0] - b[0];
    let dy = a[1] - b[1];
    dx * dx + dy * dy
}

fn valid_square(p1: Vec[i64], p2: Vec[i64], p3: Vec[i64], p4: Vec[i64]) -> bool {
    let mut d = vec![dist(p1, p2), dist(p1, p3), dist(p1, p4), dist(p2, p3), dist(p2, p4), dist(p3, p4)];
    d.sort();
    d[0] > 0 and d[0] == d[3] and d[4] == d[5] and d[4] == 2 * d[0]
}

// ---- benchmark -----------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Four random points: a square of random size and turn, its corners in
// a random order (one case in three); such a square with one coordinate
// moved by 1 (one in three); or four points from -3 to 3, which often
// repeat (the rest).
fn random_points(seed: mut ref i64) -> Vec[Vec[i64]] {
    let kind = step(mut seed) % 3;
    let mut points: Vec[Vec[i64]] = Vec.new();
    if kind == 2 {
        for _ in 0..4 {
            points.push(vec![step(mut seed) % 7 - 3, step(mut seed) % 7 - 3]);
        }
        return points;
    }
    let x = step(mut seed) % 2001 - 1000;
    let y = step(mut seed) % 2001 - 1000;
    let mut dx = step(mut seed) % 41 - 20;
    let dy = step(mut seed) % 41 - 20;
    if dx == 0 and dy == 0 {
        dx = 1;
    }
    points.push(vec![x, y]);
    points.push(vec![x + dx, y + dy]);
    points.push(vec![x + dx - dy, y + dy + dx]);
    points.push(vec![x - dy, y + dx]);
    if kind == 1 {
        let k = step(mut seed) % 4;
        let c = step(mut seed) % 2;
        points[k][c] += if step(mut seed) % 2 == 0 { 1 } else { -1 };
    }
    // A random order.
    for k in 0..3 {
        let j = k + step(mut seed) % (4 - k);
        points.swap(k, j);
    }
    points
}

fn main() {
    // 1,000 random cases made once, a third of them squares and a third
    // squares with one coordinate moved; then 20,000 times over each is
    // tested.
    let count = 1000;
    let rounds = 20000;
    let mut seed: i64 = 593;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        cases.push(random_points(mut seed));
    }
    let mut squares = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        for g in 0..count {
            let p = ref cases[(round * 7 + g) % count];
            if valid_square(p[0], p[1], p[2], p[3]) {
                squares += 1;
                checksum = (checksum * 31 + g + 1) % 1000000007;
            }
        }
    }
    println(f"{count} cases, {rounds} rounds: {squares} squares, checksum {checksum}");
}
