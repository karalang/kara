// LeetCode #510: Inorder Successor in BST II -- climb to the root, then
// search.
//
// Follow the parent links to the root, then search the tree as a search
// tree for the smallest value above the node's: a larger value is a
// candidate and the search goes left for a smaller one, anything else
// sends it right. O(height).

shared struct Node {
    val: i64,
    mut left: Option[Node],
    mut right: Option[Node],
    mut parent: weak Node,
}

fn inorder_successor(node: Node) -> Option[Node] {
    let mut root = node;
    while let Some(p) = root.parent {
        root = p;
    }
    let mut best: Option[Node] = None;
    let mut cur = Some(root);
    while let Some(c) = cur {
        if c.val > node.val {
            best = Some(c);
            cur = c.left;
        } else {
            cur = c.right;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A search tree of the values, inserted in the order given, each node
// pointing back at its parent.
fn build(values: Vec[i64]) -> Node {
    let root = Node { val: values[0], left: None, right: None, parent: None };
    for i in 1..values.len() {
        let v = values[i];
        let leaf = Node { val: v, left: None, right: None, parent: None };
        let mut node = root;
        loop {
            if v < node.val {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        leaf.parent = node;
                        node.left = Some(leaf);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        leaf.parent = node;
                        node.right = Some(leaf);
                        break;
                    }
                }
            }
        }
    }
    root
}

// The node holding v, found from the root.
fn find(root: Node, v: i64) -> Node {
    let mut node = root;
    while node.val != v {
        let next = if v < node.val { node.left } else { node.right };
        node = next.expect("v is in the tree");
    }
    node
}

fn answer(node: Option[Node]) -> String {
    match node {
        Some(n) => f"{n.val}",
        None => "null",
    }
}

fn show(name: Str, values: Vec[i64], target: i64) {
    let root = build(values);
    println(f"{name}: {values}, node {target} -> {answer(inorder_successor(find(root, target)))}");
}

fn main() {
    show("example 1", vec![2, 1, 3], 1);
    show("example 2", vec![5, 3, 6, 2, 4, 1], 6);
    show("down the right subtree", vec![5, 3, 6, 2, 4, 1], 3);
    show("up two levels", vec![5, 3, 6, 2, 4, 1], 4);
    show("the smallest", vec![5, 3, 6, 2, 4, 1], 1);
    show("one node", vec![7], 7);
    show("a chain to the right", vec![1, 2, 3, 4], 2);
    show("a chain to the left", vec![4, 3, 2, 1], 1);
    show("the extremes", vec![-100000, 100000, 0], 0);
    // 300 random search trees of 1 to 40 different values, spread 1, 7
    // or 5,000 apart in turn and shuffled, and the successor of every
    // node.
    let mut seed: i64 = 510;
    let count = 300;
    let mut nodes = 0;
    let mut nulls = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let spread = if t % 3 == 0 { 1 } else if t % 3 == 1 { 7 } else { 5000 };
        let size = 1 + next_random(mut seed) % 40;
        let mut values: Vec[i64] = Vec.new();
        for j in 0..size {
            values.push(j * spread + next_random(mut seed) % spread - 100000);
        }
        for i in 1..size {
            let k = next_random(mut seed) % (i + 1);
            values.swap(i, k);
        }
        let root = build(values);
        for v in values {
            nodes += 1;
            match inorder_successor(find(root, v)) {
                Some(s) => checksum = (checksum * 31 + s.val + 100000) % 1000000007,
                None => nulls += 1,
            }
        }
    }
    println(f"{count} random trees: {nodes} nodes, {nulls} without a successor, checksum {checksum}");
}
