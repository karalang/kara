// Benchmark for LeetCode #510: Inorder Successor in BST II -- the ★ arm
// (down the right subtree, or up to the first larger ancestor); see
// ../inorder_successor.kara.

shared struct Node {
    val: i64,
    mut left: Option[Node],
    mut right: Option[Node],
    mut parent: weak Node,
}

fn inorder_successor(node: Node) -> Option[Node] {
    if let Some(r) = node.right {
        let mut cur = r;
        while let Some(l) = cur.left {
            cur = l;
        }
        return Some(cur);
    }
    let mut up = node.parent;
    while let Some(p) = up {
        if p.val > node.val {
            return Some(p);
        }
        up = p.parent;
    }
    None
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A search tree of the values, inserted in the order given, each node
// pointing back at its parent. Every node is returned, in that order.
fn build(values: Vec[i64]) -> Vec[Node] {
    let root = Node { val: values[0], left: None, right: None, parent: None };
    let mut nodes: Vec[Node] = vec![root];
    for i in 1..values.len() {
        let v = values[i];
        let leaf = Node { val: v, left: None, right: None, parent: None };
        let mut node = root;
        loop {
            if v < node.val {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        leaf.parent = node;
                        node.left = Some(leaf);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        leaf.parent = node;
                        node.right = Some(leaf);
                        break;
                    }
                }
            }
        }
        nodes.push(leaf);
    }
    nodes
}

fn main() {
    // 100 random search trees of 10,000 different values (the problem's
    // most), the j-th value j * 20 plus less than 20, shuffled, built
    // once. Then the successor of every node, 50 times over.
    let trees = 100;
    let size = 10000;
    let mut seed: i64 = 510;
    let mut all: Vec[Vec[Node]] = Vec.new();
    for _ in 0..trees {
        let mut values: Vec[i64] = Vec.new();
        for j in 0..size {
            values.push(j * 20 + next_random(mut seed) % 20 - 100000);
        }
        for i in 1..size {
            let k = next_random(mut seed) % (i + 1);
            values.swap(i, k);
        }
        all.push(build(values));
    }
    let mut nulls = 0;
    let mut checksum: i64 = 0;
    for _ in 0..50 {
        for t in 0..trees {
            for node in all[t].iter() {
                match inorder_successor(node) {
                    Some(s) => checksum = (checksum + s.val + 100000) % 1000000007,
                    None => nulls += 1,
                }
            }
        }
    }
    println(f"{trees} trees of {size} nodes, 50 times each: {nulls} without a successor, checksum {checksum}");
}
