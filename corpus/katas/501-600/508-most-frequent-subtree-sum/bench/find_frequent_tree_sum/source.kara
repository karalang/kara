// Benchmark for LeetCode #508: Most Frequent Subtree Sum -- the ★ arm
// (post-order with a count table); see ../find_frequent_tree_sum.kara.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn subtree_sum(node: Option[TreeNode], counts: mut ref Map[i64, i64]) -> i64 {
    let Some(n) = node else {
        return 0;
    };
    let sum = n.val + subtree_sum(n.left, mut counts) + subtree_sum(n.right, mut counts);
    *counts.entry(sum).or_insert(0) += 1;
    sum
}

fn find_frequent_tree_sum(root: Option[TreeNode]) -> Vec[i64] {
    let mut counts: Map[i64, i64] = Map.new();
    subtree_sum(root, mut counts);
    let mut best = 0;
    for (_, c) in counts.iter() {
        if *c > best {
            best = *c;
        }
    }
    let mut sums: Vec[i64] = Vec.new();
    for (s, c) in counts.iter() {
        if *c == best {
            sums.push(*s);
        }
    }
    sums
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random tree over values[lo..hi]: the root is a random one of them,
// the ones before it the left subtree and the ones after it the right.
fn build(values: Vec[i64], lo: i64, hi: i64, seed: mut ref i64) -> Option[TreeNode] {
    if lo >= hi {
        return None;
    }
    let mid = lo + next_random(mut seed) % (hi - lo);
    let left = build(values, lo, mid, mut seed);
    let right = build(values, mid + 1, hi, mut seed);
    Some(TreeNode { val: values[mid], left: left, right: right })
}

fn main() {
    // 100 random trees of 10,000 nodes (the problem's most), the values
    // from -2 to 2, from -50 to 50, or from the whole range -100,000 to
    // 100,000 in turn, built once. Then each is solved 30 times.
    let trees = 100;
    let mut seed: i64 = 508;
    let mut all: Vec[Option[TreeNode]] = Vec.new();
    for t in 0..trees {
        let half = if t % 3 == 0 { 2 } else if t % 3 == 1 { 50 } else { 100000 };
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..10000 {
            values.push(next_random(mut seed) % (2 * half + 1) - half);
        }
        all.push(build(values, 0, 10000, mut seed));
    }
    let mut found = 0;
    let mut total = 0;
    for _ in 0..30 {
        for t in 0..trees {
            for s in find_frequent_tree_sum(all[t]) {
                found += 1;
                total += s;
            }
        }
    }
    println(f"{trees} trees of 10000 nodes, 30 times each: {found} most frequent sums, adding up to {total}");
}
