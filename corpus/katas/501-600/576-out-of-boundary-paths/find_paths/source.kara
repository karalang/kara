// LeetCode #576: Out of Boundary Paths -- the ways forward, move by move.
//
// `ways[r][c]` counts the paths of the moves made so far that end at
// (r, c) still in the grid. Each move sends every cell's paths to its
// four neighbours: a neighbour outside the grid is a path out, counted
// in the answer, and one inside carries the paths on to the next move.
// Counts are kept modulo 10^9 + 7. O(maxMove * m * n) time.

fn find_paths(m: i64, n: i64, max_move: i64, start_row: i64, start_column: i64) -> i64 {
    let modulus = 1000000007;
    let moves = vec![(-1, 0), (1, 0), (0, -1), (0, 1)];
    let mut ways = vec![vec![0; n]; m];
    ways[start_row][start_column] = 1;
    let mut out = 0;
    for _ in 0..max_move {
        let mut next = vec![vec![0; n]; m];
        for r in 0..m {
            for c in 0..n {
                let here = ways[r][c];
                if here == 0 {
                    continue;
                }
                for (dr, dc) in moves.iter() {
                    let nr = r + dr;
                    let nc = c + dc;
                    if nr < 0 or nr >= m or nc < 0 or nc >= n {
                        out = (out + here) % modulus;
                    } else {
                        next[nr][nc] = (next[nr][nc] + here) % modulus;
                    }
                }
            }
        }
        ways = next;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(m: i64, n: i64, max_move: i64, start_row: i64, start_column: i64) {
    println(f"{m} by {n}, {max_move} moves from ({start_row}, {start_column}): {find_paths(m, n, max_move, start_row, start_column)}");
}

fn main() {
    // The two LeetCode examples.
    show(2, 2, 2, 0, 0);
    show(1, 3, 3, 0, 1);
    // No moves; one cell, one move and many; a row and a column.
    show(3, 3, 0, 1, 1);
    show(1, 1, 1, 0, 0);
    show(1, 1, 50, 0, 0);
    show(1, 5, 2, 0, 2);
    show(5, 1, 2, 2, 0);
    // The middle of a grid too large to leave in the moves given, and
    // with just enough moves.
    show(5, 5, 2, 2, 2);
    show(5, 5, 3, 2, 2);
    // 300 random cases of 1 to 10 by 1 to 10, 0 to 12 moves.
    let mut seed: i64 = 576;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let m = 1 + step(mut seed) % 10;
        let n = 1 + step(mut seed) % 10;
        let max_move = step(mut seed) % 13;
        let r = step(mut seed) % m;
        let c = step(mut seed) % n;
        let got = find_paths(m, n, max_move, r, c);
        total = (total + got) % 1000000007;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"300 random cases: total {total}, checksum {checksum}");
    // The problem's largest: 50 by 50 and 50 moves, from a corner, the
    // middle, and a cell on an edge, where the counts wrap many times.
    show(50, 50, 50, 0, 0);
    show(50, 50, 50, 25, 25);
    show(50, 50, 50, 0, 24);
}
