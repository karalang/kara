// LeetCode #576: Out of Boundary Paths -- the ways out, from every cell.
//
// Layer k of the table holds, for every cell, the paths out from there
// with at most k moves: layer 0 is all zeros, and each cell of layer k
// adds up its four neighbours, one for a neighbour outside the grid and
// that neighbour's count in layer k - 1 for one inside. The answer is
// the start's count in the last layer. O(maxMove * m * n) time.

fn find_paths(m: i64, n: i64, max_move: i64, start_row: i64, start_column: i64) -> i64 {
    let mut table: Vec[Vec[Vec[i64]]] = Vec.new();
    table.push(vec![vec![0; n]; m]);
    for k in 1..=max_move {
        let mut layer: Vec[Vec[i64]] = Vec.new();
        for r in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for c in 0..n {
                let mut count = 0;
                for (nr, nc) in [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)] {
                    if nr < 0 or nr >= m or nc < 0 or nc >= n {
                        count += 1;
                    } else {
                        count += table[k - 1][nr][nc];
                    }
                }
                row.push(count % 1000000007);
            }
            layer.push(row);
        }
        table.push(layer);
    }
    table[max_move][start_row][start_column]
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(m: i64, n: i64, max_move: i64, start_row: i64, start_column: i64) {
    println(f"{m} by {n}, {max_move} moves from ({start_row}, {start_column}): {find_paths(m, n, max_move, start_row, start_column)}");
}

fn main() {
    // The two LeetCode examples.
    show(2, 2, 2, 0, 0);
    show(1, 3, 3, 0, 1);
    // No moves; one cell, one move and many; a row and a column.
    show(3, 3, 0, 1, 1);
    show(1, 1, 1, 0, 0);
    show(1, 1, 50, 0, 0);
    show(1, 5, 2, 0, 2);
    show(5, 1, 2, 2, 0);
    // The middle of a grid too large to leave in the moves given, and
    // with just enough moves.
    show(5, 5, 2, 2, 2);
    show(5, 5, 3, 2, 2);
    // 300 random cases of 1 to 10 by 1 to 10, 0 to 12 moves.
    let mut seed: i64 = 576;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let m = 1 + step(mut seed) % 10;
        let n = 1 + step(mut seed) % 10;
        let max_move = step(mut seed) % 13;
        let r = step(mut seed) % m;
        let c = step(mut seed) % n;
        let got = find_paths(m, n, max_move, r, c);
        total = (total + got) % 1000000007;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"300 random cases: total {total}, checksum {checksum}");
    // The problem's largest: 50 by 50 and 50 moves, from a corner, the
    // middle, and a cell on an edge, where the counts wrap many times.
    show(50, 50, 50, 0, 0);
    show(50, 50, 50, 25, 25);
    show(50, 50, 50, 0, 24);
}
