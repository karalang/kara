// LeetCode #576: Out of Boundary Paths -- recursion with a memo.
//
// The paths out from (r, c) with `left` moves to spend: one if (r, c)
// is already outside, none if no moves are left, and otherwise the sum
// over the four neighbours with one move fewer. Each (r, c, left) is
// worked out once and kept in a map. O(maxMove * m * n) time.

fn paths_from(m: i64, n: i64, r: i64, c: i64, left: i64, memo: mut ref Map[(i64, i64, i64), i64]) -> i64 {
    if r < 0 or r >= m or c < 0 or c >= n {
        return 1;
    }
    if left == 0 {
        return 0;
    }
    if let Some(known) = memo.get((r, c, left)) {
        return *known;
    }
    let total = (paths_from(m, n, r - 1, c, left - 1, mut memo)
        + paths_from(m, n, r + 1, c, left - 1, mut memo)
        + paths_from(m, n, r, c - 1, left - 1, mut memo)
        + paths_from(m, n, r, c + 1, left - 1, mut memo)) % 1000000007;
    memo.insert((r, c, left), total);
    total
}

fn find_paths(m: i64, n: i64, max_move: i64, start_row: i64, start_column: i64) -> i64 {
    let mut memo: Map[(i64, i64, i64), i64] = Map.new();
    paths_from(m, n, start_row, start_column, max_move, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(m: i64, n: i64, max_move: i64, start_row: i64, start_column: i64) {
    println(f"{m} by {n}, {max_move} moves from ({start_row}, {start_column}): {find_paths(m, n, max_move, start_row, start_column)}");
}

fn main() {
    // The two LeetCode examples.
    show(2, 2, 2, 0, 0);
    show(1, 3, 3, 0, 1);
    // No moves; one cell, one move and many; a row and a column.
    show(3, 3, 0, 1, 1);
    show(1, 1, 1, 0, 0);
    show(1, 1, 50, 0, 0);
    show(1, 5, 2, 0, 2);
    show(5, 1, 2, 2, 0);
    // The middle of a grid too large to leave in the moves given, and
    // with just enough moves.
    show(5, 5, 2, 2, 2);
    show(5, 5, 3, 2, 2);
    // 300 random cases of 1 to 10 by 1 to 10, 0 to 12 moves.
    let mut seed: i64 = 576;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let m = 1 + step(mut seed) % 10;
        let n = 1 + step(mut seed) % 10;
        let max_move = step(mut seed) % 13;
        let r = step(mut seed) % m;
        let c = step(mut seed) % n;
        let got = find_paths(m, n, max_move, r, c);
        total = (total + got) % 1000000007;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"300 random cases: total {total}, checksum {checksum}");
    // The problem's largest: 50 by 50 and 50 moves, from a corner, the
    // middle, and a cell on an edge, where the counts wrap many times.
    show(50, 50, 50, 0, 0);
    show(50, 50, 50, 25, 25);
    show(50, 50, 50, 0, 24);
}
