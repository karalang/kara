// Differential test for LeetCode #536: Construct Binary Tree from
// String.
//
// Copies of the four arms, each held to the properties below on 1,000
// random trees of 0 to 40 nodes, written as the problem writes them,
// with values from -1000 to 1000 three times in four and from -10^7 to
// 10^7 otherwise; a node with one child has it on the left.
// Properties:
//   P1  the written form of a tree reads back as that tree
//   P2  what is read, written as the problem writes it, is the string
//       read
//   P3  v(A)(B), for two more random trees A (1 to 14 nodes) and B (0
//       to 14) and a value v, reads as v over what A and B read as
//   P4  every number's sign turned turns every value's
//   P5  one node per number, and as tall as the parentheses are deep

// ---- star: str2tree.kara

fn parse_star(b: Slice[u8], i: mut ref i64) -> TreeNode {
    let mut sign = 1;
    if b[*i] == b'-' {
        sign = -1;
        *i += 1;
    }
    let mut val = 0;
    while *i < b.len() and b[*i] >= b'0' and b[*i] <= b'9' {
        val = val * 10 + (b[*i] - b'0') as i64;
        *i += 1;
    }
    let node = TreeNode { val: sign * val, left: None, right: None };
    if *i < b.len() and b[*i] == b'(' {
        *i += 1;
        node.left = Some(parse_star(b, mut i));
        *i += 1;
    }
    if *i < b.len() and b[*i] == b'(' {
        *i += 1;
        node.right = Some(parse_star(b, mut i));
        *i += 1;
    }
    node
}

fn str2tree_star(s: Str) -> Option[TreeNode] {
    if s.is_empty() {
        return None;
    }
    let mut i = 0;
    Some(parse_star(s.bytes(), mut i))
}

// ---- stack: str2tree_stack.kara

fn str2tree_stack(s: Str) -> Option[TreeNode] {
    let b = s.bytes();
    let mut stack: Vec[TreeNode] = Vec.new();
    let mut root: Option[TreeNode] = None;
    let mut i = 0;
    while i < b.len() {
        if b[i] == b')' {
            stack.pop();
            i += 1;
        } else if b[i] == b'(' {
            i += 1;
        } else {
            let start = i;
            i += 1;
            while i < b.len() and b[i] >= b'0' and b[i] <= b'9' {
                i += 1;
            }
            let node = TreeNode { val: i64.parse(s[start..i]).unwrap(), left: None, right: None };
            match stack.last() {
                Some(parent) => {
                    if parent.left.is_none() {
                        parent.left = Some(node);
                    } else {
                        parent.right = Some(node);
                    }
                }
                None => root = Some(node),
            }
            stack.push(node);
        }
    }
    root
}

// ---- split: str2tree_split.kara

fn str2tree_split(s: Str) -> Option[TreeNode] {
    if s.is_empty() {
        return None;
    }
    let b = s.bytes();
    let mut i = 0;
    while i < b.len() and b[i] != b'(' {
        i += 1;
    }
    let node = TreeNode { val: i64.parse(s[0..i]).unwrap(), left: None, right: None };
    if i < b.len() {
        let mut open = 0;
        let mut j = i;
        loop {
            if b[j] == b'(' {
                open += 1;
            } else if b[j] == b')' {
                open -= 1;
                if open == 0 {
                    break;
                }
            }
            j += 1;
        }
        node.left = str2tree_split(s[i + 1..j]);
        if j + 1 < b.len() {
            node.right = str2tree_split(s[j + 2..b.len() - 1]);
        }
    }
    Some(node)
}

// ---- depth: str2tree_depth.kara

fn str2tree_depth(s: Str) -> Option[TreeNode] {
    let b = s.bytes();
    let mut last: Vec[TreeNode] = Vec.new();
    let mut root: Option[TreeNode] = None;
    let mut depth = 0;
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'(' {
            depth += 1;
            i += 1;
        } else if b[i] == b')' {
            depth -= 1;
            i += 1;
        } else {
            let negative = b[i] == b'-';
            if negative {
                i += 1;
            }
            let mut val = 0;
            while i < b.len() and b[i] >= b'0' and b[i] <= b'9' {
                val = val * 10 + (b[i] - b'0') as i64;
                i += 1;
            }
            let node = TreeNode { val: if negative { -val } else { val }, left: None, right: None };
            if depth == 0 {
                root = Some(node);
            } else {
                let parent = last[depth - 1];
                if parent.left.is_none() {
                    parent.left = Some(node);
                } else {
                    parent.right = Some(node);
                }
            }
            if depth < last.len() {
                last[depth] = node;
            } else {
                last.push(node);
            }
        }
    }
    root
}

// ---- differential harness -------------------------------------------------

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn answer(which: i64, s: Str) -> Option[TreeNode] {
    match which {
        0 => str2tree_star(s),
        1 => str2tree_stack(s),
        2 => str2tree_split(s),
        _ => str2tree_depth(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A value: three times in four from -1000 to 1000, else from -10^7 to
// 10^7.
fn random_value(seed: mut ref i64) -> i64 {
    if next_random(mut seed) % 4 == 0 {
        let high = next_random(mut seed);
        let low = next_random(mut seed);
        (high * 32768 + low) % 20000001 - 10000000
    } else {
        next_random(mut seed) % 2001 - 1000
    }
}

// A random tree of n nodes; a node with one child has it on the left.
fn random_tree(seed: mut ref i64, n: i64) -> Option[TreeNode] {
    if n == 0 {
        return None;
    }
    let val = random_value(mut seed);
    let rest = n - 1;
    let left = if rest == 0 {
        0
    } else if next_random(mut seed) % 3 == 0 {
        rest
    } else {
        1 + next_random(mut seed) % rest
    };
    let l = random_tree(mut seed, left);
    let r = random_tree(mut seed, rest - left);
    Some(TreeNode { val: val, left: l, right: r })
}

fn render(node: Option[TreeNode], out: mut ref String) {
    let Some(n) = node else {
        return;
    };
    out.push_str(f"{n.val}");
    if n.left.is_some() {
        out.push('(');
        render(n.left, mut out);
        out.push(')');
    }
    if n.right.is_some() {
        out.push('(');
        render(n.right, mut out);
        out.push(')');
    }
}

fn written(root: Option[TreeNode]) -> String {
    let mut out = String.new();
    render(root, mut out);
    out
}

// Whether two trees have the same shape and the same values, each
// value multiplied by `sign` in the second.
fn same(a: Option[TreeNode], b: Option[TreeNode], sign: i64) -> bool {
    match (a, b) {
        (None, None) => true,
        (Some(x), Some(y)) => x.val * sign == y.val and same(x.left, y.left, sign) and same(x.right, y.right, sign),
        _ => false,
    }
}

// Node count and height (a single node has height 1).
fn count(node: Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => 1 + count(n.left) + count(n.right),
    }
}

fn height(node: Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => 1 + height(n.left).max(height(n.right)),
    }
}

// The string with every number's sign turned: a '-' taken off, or put
// in front of a number that has none.
fn negated(s: Str) -> String {
    let b = s.bytes();
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'-' {
            i += 1;
        } else if b[i] >= b'0' and b[i] <= b'9' {
            if i == 0 or (b[i - 1] != b'-' and (b[i - 1] < b'0' or b[i - 1] > b'9')) {
                out.push('-');
            }
            out.push(b[i] as char);
            i += 1;
        } else {
            out.push(b[i] as char);
            i += 1;
        }
    }
    out
}

// The numbers in the string, and the deepest nesting of parentheses
// plus one (0 for the empty string).
fn numbers(s: Str) -> i64 {
    let b = s.bytes();
    let mut n = 0;
    for i in 0..b.len() {
        let digit = b[i] >= b'0' and b[i] <= b'9';
        if digit and (i == 0 or b[i - 1] < b'0' or b[i - 1] > b'9') {
            n += 1;
        }
    }
    n
}

fn nesting(s: Str) -> i64 {
    if s.is_empty() {
        return 0;
    }
    let mut open = 0;
    let mut most = 0;
    for c in s.bytes().iter() {
        if *c == b'(' {
            open += 1;
            most = most.max(open);
        } else if *c == b')' {
            open -= 1;
        }
    }
    most + 1
}

fn main() {
    let mut seed: i64 = 536;
    let mut fails = vec![0; 5];
    let mut checks = 0;
    let cases = 1000;
    for _ in 0..cases {
        let tree = random_tree(mut seed, next_random(mut seed) % 41);
        let s = written(tree);
        let a = random_tree(mut seed, 1 + next_random(mut seed) % 15);
        let b = random_tree(mut seed, next_random(mut seed) % 15);
        let v = random_value(mut seed);
        let sa = written(a);
        let sb = written(b);
        let wrapped = if sb.is_empty() {
            f"{v}({sa})"
        } else {
            f"{v}({sa})({sb})"
        };
        let flipped = negated(s);
        for which in 0..4 {
            checks += 5;
            let read = answer(which, s);
            // P1: the written form of a tree reads back as that tree.
            if not same(tree, read, 1) {
                fails[0] += 1;
            }
            // P2: what is read, written as the problem writes it, is the
            // string read.
            if written(read) != s {
                fails[1] += 1;
            }
            // P3: v(A)(B) reads as v over what A and B read as.
            let p3 = match answer(which, wrapped) {
                Some(root) => root.val == v and same(root.left, answer(which, sa), 1) and same(root.right, answer(which, sb), 1),
                None => false,
            };
            if not p3 {
                fails[2] += 1;
            }
            // P4: every number's sign turned turns every value's.
            if not same(read, answer(which, flipped), -1) {
                fails[3] += 1;
            }
            // P5: one node per number, and as tall as the parentheses
            // are deep.
            if count(read) != numbers(s) or height(read) != nesting(s) {
                fails[4] += 1;
            }
        }
    }
    let total = fails[0] + fails[1] + fails[2] + fails[3] + fails[4];
    if total == 0 {
        println(f"{cases} cases, 4 arms, {checks} checks, 0 failures");
    } else {
        println(f"{cases} cases, 4 arms, {checks} checks, {total} failures");
        println(f"by property: P1 {fails[0]}, P2 {fails[1]}, P3 {fails[2]}, P4 {fails[3]}, P5 {fails[4]}");
    }
}
