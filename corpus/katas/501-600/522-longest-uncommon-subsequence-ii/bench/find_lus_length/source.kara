// Benchmark for LeetCode #522: Longest Uncommon Subsequence II -- the ★
// arm (longest first); see ../find_lus_length.kara.

fn is_subsequence(small: Str, big: Str) -> bool {
    let s: Vec[char] = small.chars().collect();
    let mut i = 0;
    for c in big.chars() {
        if i < s.len() and s[i] == c {
            i += 1;
        }
    }
    i == s.len()
}

fn find_lus_length(strs: Vec[String]) -> i64 {
    let mut order: Vec[i64] = (0..strs.len()).collect();
    order.sort_by(|a, b| strs[b].len().cmp(strs[a].len()));
    for i in order.iter() {
        let mut uncommon = true;
        for j in 0..strs.len() {
            if j != *i and is_subsequence(strs[*i], strs[j]) {
                uncommon = false;
                break;
            }
        }
        if uncommon {
            return strs[*i].len();
        }
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..len {
        word.push((97 + next_random(seed) % letters) as u8 as char);
    }
    word
}

// 2,000 random lists of 50 words of 1 to 10 letters from 1 to 3
// letters, one word in three a copy of an earlier one, made once; then
// every list solved in each of 100 rounds.
fn main() {
    let mut seed: i64 = 522;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..2000 {
        let letters = 1 + next_random(mut seed) % 3;
        let mut strs: Vec[String] = Vec.new();
        for k in 0..50 {
            if k > 0 and next_random(mut seed) % 3 == 0 {
                let from = next_random(mut seed) % k;
                strs.push(strs[from].clone());
            } else {
                strs.push(random_word(mut seed, 1 + next_random(mut seed) % 10, letters));
            }
        }
        lists.push(strs);
    }
    let mut total = 0;
    let mut checksum = 0;
    for round in 0..100 {
        for l in 0..lists.len() {
            let answer = find_lus_length(lists[l]);
            total += answer;
            checksum = (checksum + (round + 1) * (l + 1) * (answer + 2)) % 1000000007;
        }
    }
    println(f"2000 lists of 50 words, 100 rounds: total {total}, checksum {checksum}");
}
