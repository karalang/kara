// LeetCode #563: Binary Tree Tilt -- subtree sums, recursively.
//
// A node's tilt needs the sums of its two subtrees, and a subtree's sum
// is its root's value plus its two subtrees' sums. So one walk that
// returns each subtree's sum adds every node's tilt as it goes. O(n)
// time, O(h) stack.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// The sum of the subtree at `node`, after adding the tilts inside it to
// `total`.
fn subtree_sum(node: Option[TreeNode], total: mut ref i64) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let l = subtree_sum(n.left, mut total);
            let r = subtree_sum(n.right, mut total);
            *total += (l - r).abs();
            n.val + l + r
        }
    }
}

fn find_tilt(root: Option[TreeNode]) -> i64 {
    let mut total = 0;
    subtree_sum(root, mut total);
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A tree from LeetCode's level order: `None` for a missing child.
fn from_level(values: Vec[Option[i64]]) -> Option[TreeNode] {
    if values.is_empty() or values[0].is_none() {
        return None;
    }
    let root = leaf(values[0].unwrap());
    let mut queue: Vec[TreeNode] = vec![root];
    let mut head = 0;
    let mut i = 1;
    while i < values.len() {
        let n = queue[head];
        head += 1;
        if let Some(v) = values[i] {
            let c = leaf(v);
            n.left = Some(c);
            queue.push(c);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let c = leaf(v);
                n.right = Some(c);
                queue.push(c);
            }
            i += 1;
        }
    }
    Some(root)
}

// A tree of `size` nodes with values from -1000 to 1000: each new node
// walks down from the root, going left with chance lean / 100, and takes
// the first empty place it meets.
fn random_tree(size: i64, lean: i64, seed: mut ref i64) -> Option[TreeNode] {
    let root = leaf(next_random(mut seed) % 2001 - 1000);
    for _ in 1..size {
        let c = leaf(next_random(mut seed) % 2001 - 1000);
        let mut node = root;
        loop {
            if next_random(mut seed) % 100 < lean {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(c);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(c);
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

fn written(values: Vec[Option[i64]]) -> String {
    let parts: Vec[String] = values.iter().map(|v| match v {
        Some(x) => f"{x}",
        None => "null".to_string(),
    }).collect();
    f"[{parts.join(",")}]"
}

fn show(name: Str, values: Vec[Option[i64]]) {
    let t = find_tilt(from_level(values));
    println(f"{name}: {written(values)} -> {t}");
}

fn main() {
    let mut seed: i64 = 563;
    show("example 1", vec![Some(1), Some(2), Some(3)]);
    show("example 2", vec![Some(4), Some(2), Some(9), Some(3), Some(5), None, Some(7)]);
    show("example 3", vec![Some(21), Some(7), Some(14), Some(1), Some(1), Some(2), Some(2), Some(3), Some(3)]);
    show("no nodes", vec![]);
    show("one node", vec![Some(7)]);
    show("a left chain", vec![Some(1), Some(2), None, Some(3), None, Some(4)]);
    show("negative values", vec![Some(-1), Some(-2), Some(-3), Some(-4), Some(-5), Some(-6), Some(-7)]);
    show("the problem's extremes", vec![Some(1000), Some(-1000), Some(1000), None, Some(-1000), Some(1000)]);
    // 300 random trees of 1 to 80 nodes, leaning left with chance 50,
    // 80 or 95 in 100 in turn.
    let count = 300;
    let mut nodes = 0;
    let mut total = 0;
    let mut h: i64 = 0;
    for t in 0..count {
        let size = 1 + next_random(mut seed) % 80;
        let lean = if t % 3 == 0 { 50 } else if t % 3 == 1 { 80 } else { 95 };
        let tilt = find_tilt(random_tree(size, lean, mut seed));
        nodes += size;
        total += tilt;
        h = (h * 31 + tilt) % 1000000007;
    }
    println(f"{count} random trees: {nodes} nodes, tilts {total}, checksum {h}");
    // The largest, 10,000 nodes (the problem's most): a random tree, a
    // chain down the left, two chains of about 5,000 from the root, and
    // a complete tree.
    println(f"10000 nodes at random: {find_tilt(random_tree(10000, 50, mut seed))}");
    let top = leaf(0);
    let mut last = top;
    for v in 1..10000 {
        let c = leaf(v % 2001 - 1000);
        last.left = Some(c);
        last = c;
    }
    println(f"10000 nodes down the left: {find_tilt(Some(top))}");
    let root = leaf(0);
    let mut l = root;
    let mut r = root;
    for v in 1..10000 {
        let c = leaf(v % 2001 - 1000);
        if v % 2 == 1 {
            l.left = Some(c);
            l = c;
        } else {
            r.right = Some(c);
            r = c;
        }
    }
    println(f"two chains of 10000 nodes: {find_tilt(Some(root))}");
    let mut values: Vec[Option[i64]] = Vec.new();
    for v in 0..10000 {
        values.push(Some(v % 2001 - 1000));
    }
    println(f"a complete tree of 10000 nodes: {find_tilt(from_level(values))}");
}
