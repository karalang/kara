// Benchmark for #563: Binary Tree Tilt -- the ★ arm (subtree sums,
// recursively).
//
// A node's tilt needs the sums of its two subtrees, and a subtree's sum
// is its root's value plus its two subtrees' sums. So one walk that
// returns each subtree's sum adds every node's tilt as it goes. O(n)
// time, O(h) stack.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// The sum of the subtree at `node`, after adding the tilts inside it to
// `total`.
fn subtree_sum(node: Option[TreeNode], total: mut ref i64) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let l = subtree_sum(n.left, mut total);
            let r = subtree_sum(n.right, mut total);
            *total += (l - r).abs();
            n.val + l + r
        }
    }
}

fn find_tilt(root: Option[TreeNode]) -> i64 {
    let mut total = 0;
    subtree_sum(root, mut total);
    total
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 random trees of 10,000 nodes (the problem's most), each new
    // node walking down from the root and going left with chance 50 to
    // 88 in 100, built once, the nodes kept in the order they were
    // added. Then 1,000 times over every tree the subtree at one of its
    // first 16 nodes, picked by the round and the tree, is answered.
    let trees = 20;
    let mut seed: i64 = 563;
    let mut all: Vec[Vec[TreeNode]] = Vec.new();
    for g in 0..trees {
        let lean = 50 + 2 * g;
        let root = TreeNode { val: next_random(mut seed) % 2001 - 1000, left: None, right: None };
        let mut nodes: Vec[TreeNode] = vec![root];
        for _ in 1..10000 {
            let c = TreeNode { val: next_random(mut seed) % 2001 - 1000, left: None, right: None };
            let mut node = root;
            loop {
                if next_random(mut seed) % 100 < lean {
                    match node.left {
                        Some(l) => node = l,
                        None => {
                            node.left = Some(c);
                            break;
                        }
                    }
                } else {
                    match node.right {
                        Some(r) => node = r,
                        None => {
                            node.right = Some(c);
                            break;
                        }
                    }
                }
            }
            nodes.push(c);
        }
        all.push(nodes);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for r in 0..1000 {
        for t in 0..trees {
            let k = (r * 37 + t * 11) % 16;
            let d = find_tilt(Some(all[t][k]));
            total += d;
            checksum = (checksum * 31 + d) % 1000000007;
        }
    }
    println(f"{trees} trees, 1000 times each: tilts {total}, checksum {checksum}");
}
