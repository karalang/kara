// Benchmark for #549: Binary Tree Longest Consecutive Sequence II -- the
// ★ arm (post-order, two lengths a node).
//
// Each node returns the longest path down from it whose values rise by
// one a step, and the longest whose values fall by one a step. A path
// that bends at a node is a falling run in one subtree and a rising run
// in the other through the node, so the node's two lengths less the one
// node they share is a candidate. O(n) time.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn walk(node: TreeNode, best: mut ref i64) -> (i64, i64) {
    let mut rise = 1;
    let mut fall = 1;
    if let Some(l) = node.left {
        let (r1, f1) = walk(l, best);
        if l.val == node.val + 1 {
            rise = r1 + 1;
        } else if l.val == node.val - 1 {
            fall = f1 + 1;
        }
    }
    if let Some(r) = node.right {
        let (r2, f2) = walk(r, best);
        if r.val == node.val + 1 {
            rise = rise.max(r2 + 1);
        } else if r.val == node.val - 1 {
            fall = fall.max(f2 + 1);
        }
    }
    *best = (*best).max(rise + fall - 1);
    (rise, fall)
}

fn longest_consecutive(root: Option[TreeNode]) -> i64 {
    let mut best = 0;
    if let Some(n) = root {
        walk(n, mut best);
    }
    best
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn main() {
    // 20 random trees of 30,000 nodes (the problem's most), tree g with
    // values from 0 to 2 + g % 4, each new node walking down from the
    // root at even chance; the nodes are kept in the order they were
    // added. Then 60 times over every tree the subtree at one of its
    // first 16 nodes, picked by the round and the tree, is answered.
    let count = 20;
    let mut seed: i64 = 549;
    let mut firsts: Vec[Vec[TreeNode]] = Vec.new();
    for g in 0..count {
        let spread = 3 + g % 4;
        let root = leaf(next_random(mut seed) % spread);
        let mut kept: Vec[TreeNode] = vec![root];
        for _ in 1..30000 {
            let c = leaf(next_random(mut seed) % spread);
            let mut node = root;
            loop {
                if next_random(mut seed) % 2 == 0 {
                    match node.left {
                        Some(l) => node = l,
                        None => {
                            node.left = Some(c);
                            break;
                        }
                    }
                } else {
                    match node.right {
                        Some(r) => node = r,
                        None => {
                            node.right = Some(c);
                            break;
                        }
                    }
                }
            }
            if kept.len() < 16 {
                kept.push(c);
            }
        }
        firsts.push(kept);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for round in 0..60 {
        for g in 0..count {
            let n = firsts[g][(round * 7 + g) % 16];
            let d = longest_consecutive(Some(n));
            total += d;
            checksum = (checksum * 31 + d) % 1000000007;
        }
    }
    println(f"{count} trees, 60 rounds each: lengths {total}, checksum {checksum}");
}
