// Benchmark for LeetCode #520: Detect Capital -- the ★ arm (count the
// capitals); see ../detect_capital_use.kara.

fn detect_capital_use(word: Str) -> bool {
    let capitals = word.chars().filter(|c| c.is_ascii_uppercase()).count();
    capitals == 0 or capitals == word.len() or (capitals == 1 and word.chars().next().unwrap().is_ascii_uppercase())
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random word of 1 to 100 letters: all capitals, all lower case, a
// capital then lower case, any mix, or one of the first three with one
// letter's case turned.
fn random_word(seed: mut ref i64) -> String {
    let len = 1 + next_random(mut seed) % 100;
    let kind = next_random(mut seed) % 5;
    let shape = if kind == 4 { next_random(mut seed) % 3 } else { kind };
    let mut letters: Vec[char] = Vec.new();
    for i in 0..len {
        let c = (97 + next_random(mut seed) % 26) as u8 as char;
        let capital = if shape == 0 {
            true
        } else if shape == 1 {
            false
        } else if shape == 2 {
            i == 0
        } else {
            next_random(mut seed) % 2 == 0
        };
        letters.push(if capital { c.to_ascii_uppercase() } else { c });
    }
    if kind == 4 {
        let at = next_random(mut seed) % len;
        letters[at] = if letters[at].is_ascii_uppercase() { letters[at].to_ascii_lowercase() } else { letters[at].to_ascii_uppercase() };
    }
    let mut word = String.new();
    for c in letters.iter() {
        word.push(*c);
    }
    word
}

// 20,000 random words made once, then every word checked in each of
// 200 rounds.
fn main() {
    let mut seed: i64 = 520;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..20000 {
        words.push(random_word(mut seed));
    }
    let mut right = 0;
    let mut checksum = 0;
    for round in 0..200 {
        for i in 0..words.len() {
            if detect_capital_use(words[i]) {
                right += 1;
                checksum = (checksum + (round + 1) * (i + 1)) % 1000000007;
            }
        }
    }
    println(f"20000 words, 200 rounds: {right} right, checksum {checksum}");
}
