// Benchmark for #575: Distribute Candies -- the ★ arm (a set of the
// types).
//
// Alice eats n / 2 candies, so she can eat at most n / 2 types, and at
// most as many types as there are. Every type can be had once, so the
// answer is the smaller of the two. O(n) time with a hash set.

fn distribute_candies(candy_type: Vec[i64]) -> i64 {
    let mut kinds: Set[i64] = Set.new();
    for c in candy_type.iter() {
        kinds.insert(*c);
    }
    kinds.len().min(candy_type.len() / 2)
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 cases built once, each of 10,000 candies (the problem's most)
    // drawn from a pool of 1 to 10,000 types spread over the whole range.
    // Then 200 times over, every case is answered.
    let count = 100;
    let rounds = 200;
    let mut seed: i64 = 575;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let types = 1 + next_random(mut seed) % 10000;
        let mut pool: Vec[i64] = Vec.new();
        for _ in 0..types {
            pool.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 200001 - 100000);
        }
        let mut candies: Vec[i64] = Vec.new();
        for _ in 0..10000 {
            candies.push(pool[next_random(mut seed) % types]);
        }
        cases.push(candies);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        for g in 0..count {
            let p = (round * 7 + g) % count;
            let got = distribute_candies(cases[p]);
            total += got;
            checksum = (checksum * 31 + got) % 1000000007;
        }
    }
    println(f"{count} cases of 10000 candies, {rounds} rounds: {total} types eaten, checksum {checksum}");
}
