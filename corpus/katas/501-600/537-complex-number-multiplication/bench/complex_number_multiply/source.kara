// Benchmark for #537: the ★ arm (split, then the schoolbook product);
// see ../README.md § Benchmarks.
//
// 2,000 random numbers with parts from -100 to 100, written once; then
// in each of 2,500 rounds every number is multiplied by another, picked
// by the round. Sink: how many products are real, and the total length
// of the products as written.

// The real and imaginary parts of "a+bi".
fn parts(num: Str) -> (i64, i64) {
    // `split` is lazy and yields views by the spec; `karac` still returns
    // an eager `Vec[String]` (kara B-2026-10-12-7).
    let halves: Vec[Str] = num.split("+").collect();
    let re = i64.parse(halves[0]).unwrap();
    let im = i64.parse(halves[1][0..halves[1].len() - 1]).unwrap();
    (re, im)
}

fn complex_number_multiply(num1: Str, num2: Str) -> String {
    let (a, b) = parts(num1);
    let (c, d) = parts(num2);
    f"{a * c - b * d}+{a * d + b * c}i"
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed: i64 = 537;
    let mut nums: Vec[String] = Vec.new();
    for _ in 0..2000 {
        let re = next_random(mut seed) % 201 - 100;
        let im = next_random(mut seed) % 201 - 100;
        nums.push(f"{re}+{im}i");
    }
    let n = nums.len();
    let rounds = 2500;
    let mut real = 0;
    let mut length = 0;
    for r in 0..rounds {
        for i in 0..n {
            let p = complex_number_multiply(nums[i], nums[(i * 7 + r) % n]);
            if p.ends_with("+0i") {
                real += 1;
            }
            length += p.len();
        }
    }
    println(f"{n} numbers, {rounds} rounds: {real} real, length {length}");
}
