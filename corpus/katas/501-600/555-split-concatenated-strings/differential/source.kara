// Differential test for LeetCode #555: Split Concatenated Strings.
//
// Copies of the four arms, each held to the properties below on 1,000
// random lists of 1 to 5 strings of 1 to 4 letters, from the first 2, 3
// or 26 letters in turn.
// Properties:
//   P1  the answer is the definition's: every way to turn the strings,
//       each loop cut at every place, the largest kept
//   P2  the answer has the same letters as the strings
//   P3  the answer is at least the strings joined as given
//   P4  the list started one string later gives the same answer
//   P5  every string read backwards gives the same answer

// ---- star: split_concatenated_strings.kara

fn split_loop_star(strs: Vec[String]) -> String {
    let n = strs.len();
    let mut larger: Vec[String] = Vec.new();
    for s in strs.iter() {
        let r: String = s.chars().rev().collect();
        if r > s {
            larger.push(r);
        } else {
            larger.push(s.clone());
        }
    }
    let mut answer = String.new();
    for i in 0..n {
        let mut middle = String.new();
        for j in 1..n {
            middle.push_str(larger[(i + j) % n]);
        }
        let backward: String = strs[i].chars().rev().collect();
        for t in vec![strs[i].clone(), backward] {
            for k in 0..t.len() {
                let candidate = f"{t[k..]}{middle}{t[..k]}";
                if candidate > answer {
                    answer = candidate;
                }
            }
        }
    }
    answer
}

// ---- bytes: split_concatenated_strings_bytes.kara

fn split_loop_bytes(strs: Vec[String]) -> String {
    let n = strs.len();
    let mut larger: Vec[Vec[u8]] = Vec.new();
    for s in strs.iter() {
        let forward = s.bytes().to_vec();
        let mut backward = forward.clone();
        backward.reverse();
        larger.push(if backward > forward { backward } else { forward });
    }
    let mut answer: Vec[u8] = Vec.new();
    for i in 0..n {
        let mut middle: Vec[u8] = Vec.new();
        for j in 1..n {
            middle.extend_from_slice(larger[(i + j) % n]);
        }
        let forward = strs[i].bytes().to_vec();
        let mut backward = forward.clone();
        backward.reverse();
        for t in vec![forward, backward] {
            for k in 0..t.len() {
                let mut candidate: Vec[u8] = Vec.new();
                candidate.extend_from_slice(t[k..]);
                candidate.extend_from_slice(middle);
                candidate.extend_from_slice(t[..k]);
                if candidate > answer {
                    answer = candidate;
                }
            }
        }
    }
    String.from_utf8(answer).unwrap()
}

// ---- peak: split_concatenated_strings_peak.kara

fn split_loop_peak(strs: Vec[String]) -> String {
    let n = strs.len();
    let mut top = 'a';
    let mut larger: Vec[String] = Vec.new();
    for s in strs.iter() {
        for c in s.chars() {
            if c > top {
                top = c;
            }
        }
        let r: String = s.chars().rev().collect();
        larger.push(if r > s { r } else { s.clone() });
    }
    let mut answer = String.new();
    for i in 0..n {
        let mut middle = String.new();
        for j in 1..n {
            middle.push_str(larger[(i + j) % n]);
        }
        let backward: String = strs[i].chars().rev().collect();
        for t in vec![strs[i].clone(), backward] {
            let letters: Vec[char] = t.chars().collect();
            for k in 0..letters.len() {
                if letters[k] != top {
                    continue;
                }
                let candidate = f"{t[k..]}{middle}{t[..k]}";
                if candidate > answer {
                    answer = candidate;
                }
            }
        }
    }
    answer
}

// ---- chain: split_concatenated_strings_chain.kara

fn split_loop_chain(strs: Vec[String]) -> String {
    let n = strs.len();
    let mut larger: Vec[Vec[char]] = Vec.new();
    for s in strs.iter() {
        let forward: Vec[char] = s.chars().collect();
        let backward: Vec[char] = s.chars().rev().collect();
        larger.push(if backward > forward { backward } else { forward });
    }
    let mut answer = String.new();
    for i in 0..n {
        let mut middle: Vec[char] = Vec.new();
        for j in 1..n {
            for c in larger[(i + j) % n].iter() {
                middle.push(*c);
            }
        }
        let forward: Vec[char] = strs[i].chars().collect();
        let backward: Vec[char] = strs[i].chars().rev().collect();
        for t in vec![forward, backward] {
            for k in 0..t.len() {
                let candidate: String = t[k..].iter().chain(middle.iter()).chain(t[..k].iter()).collect();
                if candidate > answer {
                    answer = candidate;
                }
            }
        }
    }
    answer
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The statement read literally: every way to turn the strings (2^n of
// them), each loop cut at every place, the largest string kept.
fn definition(strs: Vec[String]) -> String {
    let n = strs.len();
    let mut best = String.new();
    for mask in 0..(1 << n) {
        let mut ring = String.new();
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                let r: String = strs[i].chars().rev().collect();
                ring.push_str(r);
            } else {
                ring.push_str(strs[i]);
            }
        }
        for k in 0..ring.len() {
            let cut = f"{ring[k..]}{ring[..k]}";
            if cut > best {
                best = cut;
            }
        }
    }
    best
}

fn answer(which: i64, strs: Vec[String]) -> String {
    if which == 0 {
        split_loop_star(strs)
    } else if which == 1 {
        split_loop_bytes(strs)
    } else if which == 2 {
        split_loop_peak(strs)
    } else {
        split_loop_chain(strs)
    }
}

fn letters_of(text: String) -> Vec[char] {
    let mut v: Vec[char] = text.chars().collect();
    v.sort();
    v
}

fn main() {
    let names = vec!["star", "bytes", "peak", "chain"];
    let count = 1000;
    let mut seed: i64 = 5550;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    for t in 0..count {
        // 1 to 5 strings of 1 to 4 letters from the first 2, 3 or 26.
        let n = 1 + next_random(mut seed) % 5;
        let alphabet = if t % 3 == 0 { 2 } else if t % 3 == 1 { 3 } else { 26 };
        let mut strs: Vec[String] = Vec.new();
        for _ in 0..n {
            let length = 1 + next_random(mut seed) % 4;
            let mut s = String.new();
            for _ in 0..length {
                s.push((b'a' + (next_random(mut seed) % alphabet) as u8) as char);
            }
            strs.push(s);
        }
        let want = definition(strs.clone());
        let mut plain = String.new();
        for s in strs.iter() {
            plain.push_str(s);
        }
        let mut turned = strs[1..].to_vec();
        turned.push(strs[0].clone());
        let mut flipped: Vec[String] = Vec.new();
        for s in strs.iter() {
            flipped.push(s.chars().rev().collect());
        }
        for which in 0..4 {
            let got = answer(which, strs.clone());
            let ok = vec![
                // P1: the definition's answer.
                got == want,
                // P2: the same letters as the strings.
                letters_of(got.clone()) == letters_of(plain.clone()),
                // P3: at least the strings joined as given.
                got >= plain,
                // P4: the list started one string later gives the same.
                answer(which, turned.clone()) == got,
                // P5: every string read backwards gives the same.
                answer(which, flipped.clone()) == got,
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                    if failures[p] <= 3 {
                        println(f"FAIL P{p + 1} {names[which]}: {strs} -> {got}, want {want}");
                    }
                }
            }
        }
    }
    let total = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases, 4 arms, {checks} checks, {total} failures");
    if total > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
