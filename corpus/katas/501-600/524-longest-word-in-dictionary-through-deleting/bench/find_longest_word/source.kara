// Benchmark for LeetCode #524: Longest Word in Dictionary through
// Deleting -- the ★ arm (check every word); see ../find_longest_word.kara.
// Whether `word` can be read off `s` left to right.
fn is_subsequence(word: Str, s: Str) -> bool {
    let w: Vec[char] = word.chars().collect();
    let mut i = 0;
    for c in s.chars() {
        if i < w.len() and w[i] == c {
            i += 1;
        }
    }
    i == w.len()
}

fn find_longest_word(s: Str, dictionary: Vec[String]) -> String {
    let mut best = String.new();
    for word in dictionary.iter() {
        if word.len() > best.len() or (word.len() == best.len() and word < best) {
            if is_subsequence(word, s) {
                best = word.clone();
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..len {
        word.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    word
}

// Each letter of `s` kept with chance one in `keep`, and at least one.
fn random_subsequence(seed: mut ref i64, s: Str, keep: i64) -> String {
    let mut word = String.new();
    for c in s.chars() {
        if next_random(mut seed) % keep == 0 {
            word.push(c);
        }
    }
    if word.len() == 0 {
        word.push(s.bytes()[0] as char);
    }
    word
}

// 20 cases made once: `s` of 1,000 letters (the problem's longest) from
// 2 to 5 letters, and 1,000 words of 1 to 1,000 letters, a third of them
// taken from `s`. Then every case solved in each of 20 rounds.
fn main() {
    let mut seed: i64 = 524;
    let mut texts: Vec[String] = Vec.new();
    let mut dictionaries: Vec[Vec[String]] = Vec.new();
    for _ in 0..20 {
        let letters = 2 + next_random(mut seed) % 4;
        let s = random_word(mut seed, 1000, letters);
        let mut dictionary: Vec[String] = Vec.new();
        for _ in 0..1000 {
            if next_random(mut seed) % 3 == 0 {
                dictionary.push(random_subsequence(mut seed, s, 2 + next_random(mut seed) % 30));
            } else {
                dictionary.push(random_word(mut seed, 1 + next_random(mut seed) % 1000, letters));
            }
        }
        texts.push(s);
        dictionaries.push(dictionary);
    }
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..20 {
        for c in 0..texts.len() {
            let answer = find_longest_word(texts[c], dictionaries[c]);
            total += answer.len();
            for b in answer.bytes().iter() {
                checksum = (checksum * 31 + *b as i64) % 1000000007;
            }
        }
    }
    println(f"20 cases, 20 rounds: total {total}, checksum {checksum}");
}
