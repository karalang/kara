// Differential test for LeetCode #502: IPO.
//
// Copies of the four arms, on 1,500 random cases of 1 to 6 projects of
// profit 0 to 20 needing 0 to 30, k from 1 to 7 and w from 0 to 10.
// Properties:
//   P1  the capital is the reference's, which tries every order of up
//       to k affordable projects
//   P2  d more capital to start with ends with at least d more
//   P3  allowing one more project never ends with less, and allowing
//       more than there are changes nothing once k >= n
//   P4  the projects in the reverse order give the same capital
//   P5  one more project that needs more than all the profits could
//       bring changes nothing

// ---- star: ipo.kara

fn find_maximized_capital_star(k: i64, w: i64, profits: Vec[i64], capital: Vec[i64]) -> i64 {
    let n = profits.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| capital[i]);
    let mut ready: PriorityQueue[i64] = PriorityQueue.max_first();
    let mut money = w;
    let mut next = 0;
    for _ in 0..k {
        while next < n and capital[order[next]] <= money {
            ready.push(profits[order[next]]);
            next += 1;
        }
        match ready.pop() {
            Some(p) => money += p,
            None => break,
        }
    }
    money
}

// ---- heaps: ipo_heaps.kara

fn find_maximized_capital_heaps(k: i64, w: i64, profits: Vec[i64], capital: Vec[i64]) -> i64 {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..profits.len() {
        pairs.push((capital[i], profits[i]));
    }
    let mut waiting: PriorityQueue[(i64, i64)] = PriorityQueue.from(pairs);
    let mut ready: PriorityQueue[i64] = PriorityQueue.max_first();
    let mut money = w;
    for _ in 0..k {
        while let Some((need, _)) = waiting.peek() {
            if *need > money {
                break;
            }
            let (_, profit) = waiting.pop().unwrap();
            ready.push(profit);
        }
        let Some(p) = ready.pop() else {
            break;
        };
        money += p;
    }
    money
}

// ---- scan: ipo_scan.kara

fn find_maximized_capital_scan(k: i64, w: i64, profits: Vec[i64], capital: Vec[i64]) -> i64 {
    let n = profits.len();
    let mut done = vec![false; n];
    let mut money = w;
    for _ in 0..k {
        let mut best = -1;
        for i in 0..n {
            if not done[i] and capital[i] <= money and (best < 0 or profits[i] > profits[best]) {
                best = i;
            }
        }
        if best < 0 {
            break;
        }
        done[best] = true;
        money += profits[best];
    }
    money
}

// ---- sorted: ipo_sorted.kara

fn find_maximized_capital_sorted(k: i64, w: i64, profits: Vec[i64], capital: Vec[i64]) -> i64 {
    let mut projects: Vec[(i64, i64)] = Vec.new();
    for i in 0..profits.len() {
        projects.push((capital[i], profits[i]));
    }
    projects.sort();
    let mut ready: SortedMap[i64, i64] = SortedMap.new();
    let mut money = w;
    let mut next = 0;
    for _ in 0..k {
        while next < projects.len() and projects[next].0 <= money {
            *ready.entry(projects[next].1).or_insert(0) += 1;
            next += 1;
        }
        let Some((p, count)) = ready.iter().rev().next() else {
            break;
        };
        let (p, count) = (*p, *count);
        if count == 1 {
            ready.remove(p);
        } else {
            ready.insert(p, count - 1);
        }
        money += p;
    }
    money
}
// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, k: i64, w: i64, profits: Vec[i64], capital: Vec[i64]) -> i64 {
    match which {
        0 => find_maximized_capital_star(k, w, profits, capital),
        1 => find_maximized_capital_heaps(k, w, profits, capital),
        2 => find_maximized_capital_scan(k, w, profits, capital),
        _ => find_maximized_capital_sorted(k, w, profits, capital),
    }
}

// The reference: try every order of up to k affordable projects, each
// done at most once, and keep the most capital any of them ends with.
fn best_from(k: i64, money: i64, profits: Vec[i64], capital: Vec[i64], done: mut ref Vec[bool]) -> i64 {
    let mut best = money;
    if k == 0 {
        return best;
    }
    for i in 0..profits.len() {
        if not done[i] and capital[i] <= money {
            done[i] = true;
            let got = best_from(k - 1, money + profits[i], profits, capital, done);
            done[i] = false;
            if got > best {
                best = got;
            }
        }
    }
    best
}

fn reference(k: i64, w: i64, profits: Vec[i64], capital: Vec[i64]) -> i64 {
    let mut done = vec![false; profits.len()];
    best_from(k, w, profits, capital, mut done)
}

fn main() {
    let names = vec!["star", "heaps", "scan", "sorted"];
    let cases = 1500;
    let mut seed: i64 = 5020;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0, 0, 0];
    for _ in 0..cases {
        // 1 to 6 projects of profit 0 to 20 needing 0 to 30, k from 1
        // to 7 and w from 0 to 10.
        let n = 1 + next_random(mut seed) % 6;
        let k = 1 + next_random(mut seed) % 7;
        let w = next_random(mut seed) % 11;
        let mut profits: Vec[i64] = Vec.new();
        let mut capital: Vec[i64] = Vec.new();
        for _ in 0..n {
            profits.push(next_random(mut seed) % 21);
            capital.push(next_random(mut seed) % 31);
        }
        let want = reference(k, w, profits, capital);
        let d = 1 + next_random(mut seed) % 10;
        // The projects in the reverse order, and with one more project
        // that needs more than all the profits together could bring.
        let mut rev_profits: Vec[i64] = Vec.new();
        let mut rev_capital: Vec[i64] = Vec.new();
        for i in 0..n {
            rev_profits.push(profits[n - 1 - i]);
            rev_capital.push(capital[n - 1 - i]);
        }
        let mut total = w;
        for i in 0..n {
            total += profits[i];
        }
        let mut more_profits = profits.clone();
        let mut more_capital = capital.clone();
        more_profits.push(1000);
        more_capital.push(total + 1);
        for which in 0..4 {
            let got = arm(which, k, w, profits, capital);
            // P1: the reference's capital.
            checks += 1;
            if got != want {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: k={k} w={w} {profits} {capital} gave {got}, want {want}");
                }
            }
            // P2: d more to start with ends with at least d more.
            checks += 1;
            let richer = arm(which, k, w + d, profits, capital);
            if richer < got + d {
                failures += 1;
                by_property[1] += 1;
                if failures <= 5 {
                    println(f"P2 {names[which]}: k={k} w={w}+{d} {profits} {capital} gave {richer}, without {got}");
                }
            }
            // P3: one more project allowed never ends with less, and
            // allowing more than n changes nothing.
            checks += 1;
            let longer = arm(which, k + 1, w, profits, capital);
            let all = arm(which, n + 3, w, profits, capital);
            if longer < got or (k >= n and got != all) {
                failures += 1;
                by_property[2] += 1;
                if failures <= 5 {
                    println(f"P3 {names[which]}: k={k} w={w} {profits} {capital} gave {got}, k+1 {longer}, all {all}");
                }
            }
            // P4: the order of the projects does not matter.
            checks += 1;
            let other = arm(which, k, w, rev_profits, rev_capital);
            if other != got {
                failures += 1;
                by_property[3] += 1;
                if failures <= 5 {
                    println(f"P4 {names[which]}: k={k} w={w} {rev_profits} {rev_capital} gave {other}, in order {got}");
                }
            }
            // P5: a project out of reach changes nothing.
            checks += 1;
            let other = arm(which, k, w, more_profits, more_capital);
            if other != got {
                failures += 1;
                by_property[4] += 1;
                if failures <= 5 {
                    println(f"P5 {names[which]}: k={k} w={w} {more_profits} {more_capital} gave {other}, without {got}");
                }
            }
        }
    }
    println(f"{cases} cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}, P5 {by_property[4]}");
    }
}
