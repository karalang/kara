// Benchmark for #502: the ★ arm (projects sorted by capital, profits in
// a heap); see ../ipo.kara.

fn find_maximized_capital(k: i64, w: i64, profits: Vec[i64], capital: Vec[i64]) -> i64 {
    let n = profits.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| capital[i]);
    let mut ready: PriorityQueue[i64] = PriorityQueue.max_first();
    let mut money = w;
    let mut next = 0;
    for _ in 0..k {
        while next < n and capital[order[next]] <= money {
            ready.push(profits[order[next]]);
            next += 1;
        }
        match ready.pop() {
            Some(p) => money += p,
            None => break,
        }
    }
    money
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 60 cases of 100,000 projects (the problem's most) with k =
    // 100,000 (the most), profits 0 to 10,000 (the most) and capital
    // needs from 0 to 10^5, 10^7 or 10^9 (the most) in turn, w from 0 to
    // 1,000; built once. Then each case is solved once.
    let cases = 60;
    let n = 100000;
    let mut seed: i64 = 502;
    let mut all_profits: Vec[Vec[i64]] = Vec.new();
    let mut all_capital: Vec[Vec[i64]] = Vec.new();
    let mut starts: Vec[i64] = Vec.new();
    for c in 0..cases {
        let scale = if c % 3 == 0 { 100001 } else if c % 3 == 1 { 10000001 } else { 1000000001 };
        let mut profits: Vec[i64] = Vec.new();
        let mut capital: Vec[i64] = Vec.new();
        for _ in 0..n {
            profits.push(next_random(mut seed) % 10001);
            capital.push((next_random(mut seed) * 32768 + next_random(mut seed)) % scale);
        }
        all_profits.push(profits);
        all_capital.push(capital);
        starts.push(next_random(mut seed) % 1001);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for c in 0..cases {
        let got = find_maximized_capital(n, starts[c], all_profits[c], all_capital[c]);
        total += got;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"{cases} cases of {n} projects: total capital {total}, checksum {checksum}");
}
