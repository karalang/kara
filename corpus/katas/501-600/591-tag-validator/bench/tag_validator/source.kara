// Benchmark for #591: Tag Validator -- the ★ arm (one scan with a
// stack of open tags).
//
// Read left to right. A cdata section is skipped to the first `]]>`
// after it, an end tag must name the tag on top of the stack, a start
// tag must have a valid name and is pushed, and any other character is
// text. Text, cdata and tags are only allowed inside the outer tag, so
// the stack may be empty only at the very start and the very end. Each
// character is read a bounded number of times: O(n).

fn valid_name(name: Str) -> bool {
    name.len() >= 1 and name.len() <= 9 and name.chars().all(|c| c >= 'A' and c <= 'Z')
}

fn is_valid(code: Str) -> bool {
    let n = code.len();
    let mut stack: Vec[String] = Vec.new();
    let mut i = 0;
    while i < n {
        if i > 0 and stack.is_empty() {
            return false;
        }
        if code[i..].starts_with("<![CDATA[") {
            if stack.is_empty() {
                return false;
            }
            match code[i + 9..].find("]]>") {
                Some(k) => i += 9 + k + 3,
                None => return false,
            }
        } else if code[i..].starts_with("</") {
            let start = i + 2;
            let Some(k) = code[start..].find(">") else {
                return false;
            };
            let name = code[start..start + k];
            if stack.is_empty() or stack[stack.len() - 1] != name {
                return false;
            }
            stack.pop();
            i = start + k + 1;
        } else if code[i..].starts_with("<") {
            let start = i + 1;
            let Some(k) = code[start..].find(">") else {
                return false;
            };
            let name = code[start..start + k];
            if not valid_name(name) {
                return false;
            }
            stack.push(name.to_string());
            i = start + k + 1;
        } else {
            if stack.is_empty() {
                return false;
            }
            i += 1;
        }
    }
    stack.is_empty()
}

// ---- benchmark --------------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random snippet, mostly valid: names that are all valid, text with
// no `<` but with cdata, and one end tag in 40 wrong.
fn snippet(depth: i64, seed: mut ref i64) -> String {
    let names: Vec[Str] = vec!["A", "XY", "ABCDEFGHI", "CODE"];
    let texts: Vec[Str] = vec!["x", " ", ">", "]]>", "!", "[", "y", "/", "...", "<![CDATA[<A>]]>"];
    let name = names[step(mut seed) % names.len()];
    let mut out = f"<{name}>";
    let parts = step(mut seed) % 7;
    for _ in 0..parts {
        if step(mut seed) % 10 < 4 and depth > 0 {
            out.push_str(snippet(depth - 1, mut seed));
        } else {
            out.push_str(texts[step(mut seed) % texts.len()]);
        }
    }
    if step(mut seed) % 40 == 0 {
        out.push_str("</B>");
    } else {
        out.push_str(f"</{name}>");
    }
    out
}

fn main() {
    // 1,000 snippets of 200 to 500 characters (the problem's most) made
    // once; then 1,000 times over each is validated.
    let count = 1000;
    let rounds = 1000;
    let mut seed: i64 = 591;
    let mut codes: Vec[String] = Vec.new();
    while codes.len() < count {
        let code = snippet(4, mut seed);
        if code.len() >= 200 and code.len() <= 500 {
            codes.push(code);
        }
    }
    let mut valid = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        for g in 0..count {
            if is_valid(codes[(round * 7 + g) % count]) {
                valid += 1;
                checksum = (checksum * 31 + g + 1) % 1000000007;
            }
        }
    }
    println(f"{count} snippets, {rounds} rounds: {valid} valid, checksum {checksum}");
}
