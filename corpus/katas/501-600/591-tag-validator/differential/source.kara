// LeetCode #591: differential -- the four arms against the definition.
//
// Copies of the four arms, each held to five properties on random
// snippets.

// ---- star arm ----------------------------------------------------------

fn valid_name_star(name: Str) -> bool {
    name.len() >= 1 and name.len() <= 9 and name.chars().all(|c| c >= 'A' and c <= 'Z')
}

fn is_valid_star(code: Str) -> bool {
    let n = code.len();
    let mut stack: Vec[String] = Vec.new();
    let mut i = 0;
    while i < n {
        if i > 0 and stack.is_empty() {
            return false;
        }
        if code[i..].starts_with("<![CDATA[") {
            if stack.is_empty() {
                return false;
            }
            match code[i + 9..].find("]]>") {
                Some(k) => i += 9 + k + 3,
                None => return false,
            }
        } else if code[i..].starts_with("</") {
            let start = i + 2;
            let Some(k) = code[start..].find(">") else {
                return false;
            };
            let name = code[start..start + k];
            if stack.is_empty() or stack[stack.len() - 1] != name {
                return false;
            }
            stack.pop();
            i = start + k + 1;
        } else if code[i..].starts_with("<") {
            let start = i + 1;
            let Some(k) = code[start..].find(">") else {
                return false;
            };
            let name = code[start..start + k];
            if not valid_name_star(name) {
                return false;
            }
            stack.push(name.to_string());
            i = start + k + 1;
        } else {
            if stack.is_empty() {
                return false;
            }
            i += 1;
        }
    }
    stack.is_empty()
}

// ---- slices arm --------------------------------------------------------

fn is_valid_slices(code: Str) -> bool {
    let mut stack: Vec[Str] = Vec.new();
    let mut rest = code;
    let mut started = false;
    while not rest.is_empty() {
        if started and stack.is_empty() {
            return false;
        }
        started = true;
        if rest.starts_with("<![CDATA[") {
            if stack.is_empty() {
                return false;
            }
            let Some(k) = rest.find("]]>") else {
                return false;
            };
            rest = rest[k + 3..];
        } else if rest.starts_with("<") {
            let Some(k) = rest.find(">") else {
                return false;
            };
            let closing = rest.starts_with("</");
            let name = if closing { rest[2..k] } else { rest[1..k] };
            if closing {
                if stack.pop() != Some(name) {
                    return false;
                }
            } else {
                if name.is_empty() or name.len() > 9 or not name.chars().all(|c| c.is_ascii_uppercase()) {
                    return false;
                }
                stack.push(name);
            }
            rest = rest[k + 1..];
        } else {
            if stack.is_empty() {
                return false;
            }
            rest = rest[1..];
        }
    }
    started and stack.is_empty()
}

// ---- descent arm -------------------------------------------------------

// Whether `word` appears in `s` at `at`.
fn at_word_descent(s: Vec[char], at: i64, word: Str) -> bool {
    let w: Vec[char] = word.chars().collect();
    if at + w.len() > s.len() {
        return false;
    }
    for k in 0..w.len() {
        if s[at + k] != w[k] {
            return false;
        }
    }
    true
}

// A tag name read from `at` up to the next `>`: the name and the
// position after the `>`.
fn tag_name_descent(s: Vec[char], at: i64) -> Option[(String, i64)] {
    let mut name = String.new();
    let mut i = at;
    while i < s.len() {
        if s[i] == '>' {
            return Some((name, i + 1));
        }
        name.push(s[i]);
        i += 1;
    }
    None
}

fn closed_tag_descent(s: Vec[char], at: i64) -> Option[i64] {
    if not at_word_descent(s, at, "<") or at_word_descent(s, at, "</") {
        return None;
    }
    let (name, after) = tag_name_descent(s, at + 1)?;
    if name.is_empty() or name.len() > 9 {
        return None;
    }
    for c in name.chars() {
        if c < 'A' or c > 'Z' {
            return None;
        }
    }
    let end = content_descent(s, after)?;
    if not at_word_descent(s, end, "</") {
        return None;
    }
    let (closing, next) = tag_name_descent(s, end + 2)?;
    if closing != name {
        return None;
    }
    Some(next)
}

// Text, cdata and closed tags from `at` until the next end tag (or the
// end of the code); `None` if something there is not allowed.
fn content_descent(s: Vec[char], at: i64) -> Option[i64] {
    let mut i = at;
    while i < s.len() and not at_word_descent(s, i, "</") {
        if at_word_descent(s, i, "<![CDATA[") {
            let mut j = i + 9;
            while j < s.len() and not at_word_descent(s, j, "]]>") {
                j += 1;
            }
            if j == s.len() {
                return None;
            }
            i = j + 3;
        } else if s[i] == '<' {
            i = closed_tag_descent(s, i)?;
        } else {
            i += 1;
        }
    }
    Some(i)
}

fn is_valid_descent(code: Str) -> bool {
    let s: Vec[char] = code.chars().collect();
    match closed_tag_descent(s, 0) {
        Some(end) => end == s.len(),
        None => false,
    }
}

// ---- reduce arm --------------------------------------------------------

fn valid_name_reduce(name: Str) -> bool {
    name.len() >= 1 and name.len() <= 9 and name.chars().all(|c| c >= 'A' and c <= 'Z')
}

fn without_cdata_reduce(code: Str) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < code.len() {
        if code[i..].starts_with("<![CDATA[") {
            match code[i + 9..].find("]]>") {
                Some(k) => {
                    out.push('#');
                    i += 9 + k + 3;
                }
                None => {
                    out.push_str(code[i..]);
                    i = code.len();
                }
            }
        } else {
            out.push_str(code[i..i + 1]);
            i += 1;
        }
    }
    out
}

// The code with its first innermost closed tag replaced by `@`, or
// `None` if it has none.
fn reduce_once_reduce(s: Str) -> Option[String] {
    let mut i = 0;
    while i < s.len() {
        if s[i..].starts_with("<") and not s[i..].starts_with("</") {
            if let Some(k) = s[i + 1..].find(">") {
                let name = s[i + 1..i + 1 + k];
                let body = i + 2 + k;
                let next = match s[body..].find("<") {
                    Some(j) => body + j,
                    None => s.len(),
                };
                let end_tag = f"</{name}>";
                if valid_name_reduce(name) and s[next..].starts_with(end_tag) {
                    return Some(f"{s[0..i]}@{s[next + end_tag.len()..]}");
                }
            }
        }
        i += 1;
    }
    None
}

fn is_valid_reduce(code: Str) -> bool {
    let mut s = without_cdata_reduce(code);
    while let Some(t) = reduce_once_reduce(s) {
        s = t;
    }
    s == "@"
}

// ---- the definition and the properties ------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, code: Str) -> bool {
    if which == 0 {
        is_valid_star(code)
    } else if which == 1 {
        is_valid_slices(code)
    } else if which == 2 {
        is_valid_descent(code)
    } else {
        is_valid_reduce(code)
    }
}

fn starts_at(s: Vec[char], at: i64, word: Str) -> bool {
    let mut k = at;
    for c in word.chars() {
        if k >= s.len() or s[k] != c {
            return false;
        }
        k += 1;
    }
    true
}

// The definition: the rules read as a grammar and decided for every
// stretch of the code. `content[i][j]` says whether the characters from
// i up to j are valid tag content: empty, or a character other than
// `<`, a cdata section (through the first `]]>` after its start) or a
// valid closed tag, followed by more content. A closed tag from i to k
// is `<`, a name up to the next `>` of 1 to 9 upper-case letters,
// content, and `</`, the same name and `>` ending at k. The code is
// valid when the whole of it is one closed tag.
fn definition(code: Str) -> bool {
    let s: Vec[char] = code.chars().collect();
    let n = s.len();
    let mut content: Vec[Vec[bool]] = Vec.new();
    for _ in 0..n + 1 {
        content.push(vec![false; n + 1]);
    }
    let mut whole = false;
    let mut i = n;
    while i >= 0 {
        content[i][i] = true;
        // Where a cdata section starting at i ends, if one does.
        let mut cdata_end = -1;
        if starts_at(s, i, "<![CDATA[") {
            let mut j = i + 9;
            while j + 3 <= n and not starts_at(s, j, "]]>") {
                j += 1;
            }
            if j + 3 <= n {
                cdata_end = j + 3;
            }
        }
        // The name of a start tag at i and where it ends, if one does.
        let mut name = String.new();
        let mut name_end = -1;
        if i < n and s[i] == '<' {
            let mut j = i + 1;
            while j < n and s[j] != '>' {
                name.push(s[j]);
                j += 1;
            }
            if j < n {
                name_end = j + 1;
            }
        }
        let good_name = name_end > 0 and name.len() >= 1 and name.len() <= 9 and name.chars().all(|c| c >= 'A' and c <= 'Z');
        let end_tag = f"</{name}>";
        for j in i + 1..n + 1 {
            let mut ok = false;
            if s[i] != '<' and content[i + 1][j] {
                ok = true;
            }
            if cdata_end > 0 and cdata_end <= j and content[cdata_end][j] {
                ok = true;
            }
            if good_name {
                for k in name_end..j + 1 {
                    let inner_end = k - end_tag.len();
                    if inner_end >= name_end and starts_at(s, inner_end, end_tag) and content[name_end][inner_end] and content[k][j] {
                        ok = true;
                        if i == 0 and k == n {
                            whole = true;
                        }
                    }
                }
            }
            content[i][j] = ok;
        }
        i -= 1;
    }
    whole
}

// A random snippet: tags, cdata and text nested up to `depth`, with
// wrong names, missing or wrong end tags, stray `<` and open cdata
// sections now and then.
fn snippet(depth: i64, seed: mut ref i64) -> String {
    let names: Vec[Str] = vec!["A", "XY", "Y", "ABCDEFGHI", "ABCDEFGHIJ", "x", "", "A1"];
    let texts: Vec[Str] = vec!["x", "Y", ">", "]]>", "<", "!", "/", "<X", "</", "]"];
    let name = names[if step(mut seed) % 3 == 0 { step(mut seed) % names.len() } else { step(mut seed) % 3 }];
    let mut out = f"<{name}>";
    let parts = step(mut seed) % 4;
    for _ in 0..parts {
        let roll = step(mut seed) % 10;
        if roll < 3 and depth > 0 {
            out.push_str(snippet(depth - 1, mut seed));
        } else if roll < 5 {
            let inside = texts[step(mut seed) % texts.len()];
            if step(mut seed) % 8 == 0 {
                out.push_str(f"<![CDATA[{inside}");
            } else {
                out.push_str(f"<![CDATA[{inside}]]>");
            }
        } else {
            out.push_str(texts[step(mut seed) % texts.len()]);
        }
    }
    let end = step(mut seed) % 12;
    if end == 0 {
        out.push_str("</Y>");
    } else if end > 1 {
        out.push_str(f"</{name}>");
    }
    out
}

// The code with X and Y swapped, and x and y.
fn swapped(code: Str) -> String {
    let mut out = String.new();
    for c in code.chars() {
        out.push(match c {
            'X' => 'Y',
            'Y' => 'X',
            'x' => 'y',
            'y' => 'x',
            _ => c,
        });
    }
    out
}

fn main() {
    let count = 1000;
    let mut seed: i64 = 5910;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    let mut valid = 0;
    for t in 0..count {
        let mut code = snippet(2, mut seed);
        // Now and then text before or after the outer tag.
        if t % 10 == 3 {
            code = f"x{code}";
        } else if t % 10 == 7 {
            code.push_str("<A></A>");
        }
        let want = definition(code);
        if want {
            valid += 1;
        }
        // P3: a cdata section put in just after the first `>`.
        let with_cdata = match code.find(">") {
            Some(k) => f"{code[0..k + 1]}<![CDATA[<A>]]>{code[k + 1..]}",
            None => code.clone(),
        };
        for which in 0..4 {
            let got = answer(which, code);
            let ok = vec![
                // P1: the definition's answer.
                got == want,
                // P2: valid code stays valid inside one more tag, and
                // is not valid twice over.
                not got or (answer(which, f"<Q>{code}</Q>") and not answer(which, f"{code}{code}")),
                // P3: the cdata section changes nothing.
                answer(which, with_cdata) == got,
                // P4: neither does swapping X with Y and x with y.
                answer(which, swapped(code)) == got,
                // P5: a space after the code makes it invalid.
                not answer(which, f"{code} "),
            ];
            for k in 0..5 {
                checks += 1;
                if not ok[k] {
                    failures[k] += 1;
                }
            }
        }
    }
    let total = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases ({valid} valid), 4 arms, {checks} checks, {total} failures");
    if total > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
