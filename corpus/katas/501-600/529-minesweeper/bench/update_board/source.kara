// Benchmark for #529: the ★ arm (reveal recursively); see
// update_board.kara.
//
// A mine clicked becomes 'X'. An empty square clicked shows how many
// mines touch it; when none do it becomes 'B' and every unrevealed
// neighbour is revealed the same way, recursively.

// How many of the eight neighbours of (r, c) hold a mine.
fn mines_around(board: Vec[Vec[char]], r: i64, c: i64) -> i64 {
    let mut count = 0;
    for dr in -1..=1 {
        for dc in -1..=1 {
            let (y, x) = (r + dr, c + dc);
            if (dr != 0 or dc != 0) and y >= 0 and y < board.len() and x >= 0 and x < board[0].len() {
                if board[y][x] == 'M' or board[y][x] == 'X' {
                    count += 1;
                }
            }
        }
    }
    count
}

fn reveal(board: mut ref Vec[Vec[char]], r: i64, c: i64) {
    if board[r][c] != 'E' {
        return;
    }
    let count = mines_around(board, r, c);
    if count > 0 {
        board[r][c] = (48 + count) as u8 as char;
        return;
    }
    board[r][c] = 'B';
    for dr in -1..=1 {
        for dc in -1..=1 {
            let (y, x) = (r + dr, c + dc);
            if y >= 0 and y < board.len() and x >= 0 and x < board[0].len() {
                reveal(mut board, y, x);
            }
        }
    }
}

fn update_board(board: own Vec[Vec[char]], click: Vec[i64]) -> Vec[Vec[char]] {
    let mut board = board;
    let (r, c) = (click[0], click[1]);
    if board[r][c] == 'M' {
        board[r][c] = 'X';
    } else {
        reveal(mut board, r, c);
    }
    board
}

// 50 boards of 50 by 50 (the problem's largest) made once, each square a
// mine with chance 0 to 20 in 100; then in each of 400 rounds every board
// gets a fresh copy clicked at a random square.
fn main() {
    let mut seed: i64 = 529;
    let mut boards: Vec[Vec[Vec[char]]] = Vec.new();
    for _ in 0..50 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let percent = seed / 65536 % 21;
        let mut board: Vec[Vec[char]] = Vec.new();
        for _ in 0..50 {
            let mut row: Vec[char] = Vec.new();
            for _ in 0..50 {
                seed = (seed * 1103515245 + 12345) % 2147483648;
                row.push(if seed / 65536 % 100 < percent { 'M' } else { 'E' });
            }
            board.push(row);
        }
        boards.push(board);
    }
    let mut opened = 0;
    let mut exploded = 0;
    let mut checksum = 0;
    for _ in 0..400 {
        for b in 0..boards.len() {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let r = seed / 65536 % 50;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let c = seed / 65536 % 50;
            let after = update_board(boards[b].clone(), vec![r, c]);
            let mut shown = 0;
            for row in after.iter() {
                for ch in row.iter() {
                    if *ch == 'X' {
                        exploded += 1;
                    } else if *ch != 'E' and *ch != 'M' {
                        shown += 1;
                    }
                }
            }
            opened += shown;
            checksum = (checksum * 31 + shown) % 1000000007;
        }
    }
    println(f"50 boards of 50 by 50, 400 rounds of clicks: {opened} opened, {exploded} exploded, checksum {checksum}");
}
