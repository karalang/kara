// LeetCode #529: Minesweeper -- count first, then sweep to a fixed
// point.
//
// Count the mines around every square once, before anything is
// revealed. Reveal the clicked square, then sweep the whole board again
// and again, revealing every unrevealed square that touches a blank,
// until a sweep changes nothing.

fn update_board(board: own Vec[Vec[char]], click: Vec[i64]) -> Vec[Vec[char]] {
    let mut board = board;
    let (r, c) = (click[0], click[1]);
    if board[r][c] == 'M' {
        board[r][c] = 'X';
        return board;
    }
    if board[r][c] != 'E' {
        return board;
    }
    let (m, n) = (board.len(), board[0].len());
    let mut around: Vec[Vec[i64]] = vec![vec![0; n]; m];
    for y in 0..m {
        for x in 0..n {
            if board[y][x] == 'M' or board[y][x] == 'X' {
                for v in (y - 1).max(0)..(y + 2).min(m) {
                    for u in (x - 1).max(0)..(x + 2).min(n) {
                        around[v][u] += 1;
                    }
                }
                // The square itself was counted with its neighbours.
                around[y][x] -= 1;
            }
        }
    }
    let shown = |k: i64| if k == 0 { 'B' } else { (48 + k) as u8 as char };
    board[r][c] = shown(around[r][c]);
    let mut changed = true;
    while changed {
        changed = false;
        for y in 0..m {
            for x in 0..n {
                if board[y][x] != 'E' {
                    continue;
                }
                let mut touches_blank = false;
                for v in (y - 1).max(0)..(y + 2).min(m) {
                    for u in (x - 1).max(0)..(x + 2).min(n) {
                        if board[v][u] == 'B' {
                            touches_blank = true;
                        }
                    }
                }
                if touches_blank {
                    board[y][x] = shown(around[y][x]);
                    changed = true;
                }
            }
        }
    }
    board
}

// ---- test harness ---------------------------------------------------------

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    let mut board: Vec[Vec[char]] = Vec.new();
    for row in rows.iter() {
        board.push(row.chars().collect());
    }
    board
}

fn show(board: Vec[Vec[char]]) -> String {
    let mut out = String.new();
    for i in 0..board.len() {
        if i > 0 {
            out.push('/');
        }
        for ch in board[i].iter() {
            out.push(*ch);
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random m by n board with each square a mine with chance `percent`
// in 100.
fn random_board(seed: mut ref i64, m: i64, n: i64, percent: i64) -> Vec[Vec[char]] {
    let mut board: Vec[Vec[char]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[char] = Vec.new();
        for _ in 0..n {
            row.push(if next_random(seed) % 100 < percent { 'M' } else { 'E' });
        }
        board.push(row);
    }
    board
}

// A random square still 'E' or 'M', or (-1, -1) when there is none.
fn random_unrevealed(seed: mut ref i64, board: Vec[Vec[char]]) -> (i64, i64) {
    let mut open: Vec[(i64, i64)] = Vec.new();
    for r in 0..board.len() {
        for c in 0..board[r].len() {
            if board[r][c] == 'E' or board[r][c] == 'M' {
                open.push((r, c));
            }
        }
    }
    if open.is_empty() {
        return (-1, -1);
    }
    open[next_random(seed) % open.len()]
}

fn main() {
    let first = parse(vec!["EEEEE", "EEMEE", "EEEEE", "EEEEE"]);
    let after = update_board(first, vec![3, 0]);
    println(f"example 1: {show(after)}");
    println(f"example 2: {show(update_board(after, vec![1, 2]))}");
    println(f"one square: {show(update_board(parse(vec!["E"]), vec![0, 0]))} and {show(update_board(parse(vec!["M"]), vec![0, 0]))}");
    println(f"a digit: {show(update_board(parse(vec!["EM", "EE"]), vec![1, 0]))}");
    println(f"walled off: {show(update_board(parse(vec!["EEMEE", "EEMEE", "MMMEE"]), vec![0, 0]))}");
    // 500 random boards of 1 to 12 by 1 to 12, up to 30% mines, three
    // clicks each on squares still unrevealed.
    let mut seed: i64 = 529;
    let mut checksum = 0;
    let mut blanks = 0;
    let mut exploded = 0;
    for _ in 0..500 {
        let m = 1 + next_random(mut seed) % 12;
        let n = 1 + next_random(mut seed) % 12;
        let mut board = random_board(mut seed, m, n, next_random(mut seed) % 31);
        for _ in 0..3 {
            let (r, c) = random_unrevealed(mut seed, board);
            if r < 0 {
                break;
            }
            board = update_board(board, vec![r, c]);
        }
        for row in board.iter() {
            for ch in row.iter() {
                if *ch == 'B' {
                    blanks += 1;
                }
                if *ch == 'X' {
                    exploded += 1;
                }
                checksum = (checksum * 31 + *ch as i64) % 1000000007;
            }
        }
    }
    println(f"500 random boards: {blanks} blank, {exploded} exploded, checksum {checksum}");
    // The largest: 50 by 50 with 2% mines, clicked on the first square
    // of the top row that has no mine.
    let mut board = random_board(mut seed, 50, 50, 2);
    let mut c = 0;
    while board[0][c] == 'M' {
        c += 1;
    }
    board = update_board(board, vec![0, c]);
    let mut counts = vec![0; 3];
    for row in board.iter() {
        for ch in row.iter() {
            if *ch == 'B' {
                counts[0] += 1;
            } else if *ch == 'E' or *ch == 'M' {
                counts[1] += 1;
            } else {
                counts[2] += 1;
            }
        }
    }
    println(f"50 by 50, clicked at (0, {c}): {counts[0]} blank, {counts[1]} unrevealed, {counts[2]} digits; row 0 {show(vec![board[0].clone()])}");
}
