// Benchmark for #582: Kill Process -- the ★ arm (children lists, walked
// breadth first).
//
// Each process's children are gathered once into a map from parent to
// the list of its children. Killing a process kills its children,
// theirs, and so on: a queue starts with `kill`, and every process
// taken from it is killed and its children queued. O(n) time.

fn kill_process(pid: Vec[i64], ppid: Vec[i64], kill: i64) -> Vec[i64] {
    let mut children: Map[i64, Vec[i64]] = Map.new();
    for i in 0..pid.len() {
        children.entry(ppid[i]).or_insert(Vec.new()).push(pid[i]);
    }
    let mut killed: Vec[i64] = Vec.new();
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(kill);
    while let Some(p) = queue.pop_front() {
        killed.push(p);
        if let Some(kids) = children.get(p) {
            for k in kids.iter() {
                queue.push_back(*k);
            }
        }
    }
    killed
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    let high = next_random(seed) * 32768;
    high + next_random(seed)
}

fn main() {
    // 20 random trees built once, each of 50,000 processes (the
    // problem's most) numbered 1 to 50,000 in a shuffled order, each
    // one's parent an earlier one; then 30 times over every tree is
    // asked to kill one of its processes, the root every fourth time.
    let count = 20;
    let rounds = 30;
    let n = 50000;
    let mut seed: i64 = 582;
    let mut pids: Vec[Vec[i64]] = Vec.new();
    let mut ppids: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut names: Vec[i64] = Vec.new();
        for i in 1..=n {
            names.push(i);
        }
        for i in (1..n).rev() {
            let j = wide(mut seed) % (i + 1);
            names.swap(i, j);
        }
        let mut pid: Vec[i64] = Vec.new();
        let mut ppid: Vec[i64] = Vec.new();
        for i in 0..n {
            pid.push(names[i]);
            if i == 0 {
                ppid.push(0);
            } else {
                ppid.push(names[wide(mut seed) % i]);
            }
        }
        pids.push(pid);
        ppids.push(ppid);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        for g in 0..count {
            let p = (round * 7 + g) % count;
            let kill = if (round + g) % 4 == 0 { pids[p][0] } else { pids[p][wide(mut seed) % n] };
            let got = kill_process(pids[p], ppids[p], kill);
            let mut sum = 0;
            for k in got.iter() {
                sum += *k;
            }
            total += got.len();
            checksum = (checksum * 31 + sum) % 1000000007;
        }
    }
    println(f"{count} trees of 50000 processes, {rounds} rounds: {total} killed, checksum {checksum}");
}
