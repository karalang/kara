// Differential test for LeetCode #533: Lonely Pixel II.
//
// Copies of the four arms, each held to the properties below on 1,000
// random pictures 1 to 10 wide, for a target from 1 to 3: 0 to 2 rows
// with `target` black pixels (a quarter of the time one fewer), each
// written `target` times (a quarter of the time once more) with one copy
// in three moved off by a pixel, and up to 6 more rows black with a
// chance of 0 to 40%.
// Properties:
//   P1  the answer is the definition's: a black pixel whose row and
//       column each hold `target` black pixels, and whose column's black
//       rows form a set of one
//   P2  the rows in a shuffled order give the same answer
//   P3  the columns in a shuffled order, the same in every row, give the
//       same answer
//   P4  the answer is a multiple of `target`, and at most the number of
//       black pixels
//   P5  one more white row and one more white column give the same
//       answer

// ---- star: find_black_pixel.kara

fn find_black_pixel_star(picture: Vec[Vec[char]], target: i64) -> i64 {
    let n = picture[0].len();
    let mut cols = vec![0; n];
    let mut rows: Map[String, i64] = Map.new();
    for row in picture.iter() {
        let mut key = String.new();
        let mut blacks = 0;
        for c in 0..n {
            key.push(row[c]);
            if row[c] == 'B' {
                cols[c] += 1;
                blacks += 1;
            }
        }
        if blacks == target {
            *rows.entry(key).or_insert(0) += 1;
        }
    }
    let mut lonely = 0;
    for (key, count) in rows.iter() {
        if *count != target {
            continue;
        }
        let mut c = 0;
        for ch in key.chars() {
            if ch == 'B' and cols[c] == target {
                lonely += target;
            }
            c += 1;
        }
    }
    lonely
}

// ---- brute: find_black_pixel_brute.kara

fn find_black_pixel_brute(picture: Vec[Vec[char]], target: i64) -> i64 {
    let (m, n) = (picture.len(), picture[0].len());
    let mut lonely = 0;
    for r in 0..m {
        for c in 0..n {
            if picture[r][c] != 'B' {
                continue;
            }
            let mut in_row = 0;
            for k in 0..n {
                if picture[r][k] == 'B' {
                    in_row += 1;
                }
            }
            let mut in_col = 0;
            let mut same = true;
            for k in 0..m {
                if picture[k][c] == 'B' {
                    in_col += 1;
                    if picture[k] != picture[r] {
                        same = false;
                    }
                }
            }
            if in_row == target and in_col == target and same {
                lonely += 1;
            }
        }
    }
    lonely
}

// ---- columns: find_black_pixel_columns.kara

fn find_black_pixel_columns(picture: Vec[Vec[char]], target: i64) -> i64 {
    let (m, n) = (picture.len(), picture[0].len());
    let mut in_row = vec![0; m];
    for r in 0..m {
        for c in 0..n {
            if picture[r][c] == 'B' {
                in_row[r] += 1;
            }
        }
    }
    let mut lonely = 0;
    for c in 0..n {
        let mut first: Option[i64] = None;
        let mut blacks = 0;
        let mut same = true;
        for r in 0..m {
            if picture[r][c] != 'B' {
                continue;
            }
            blacks += 1;
            match first {
                None => first = Some(r),
                Some(f) => {
                    if picture[r] != picture[f] {
                        same = false;
                    }
                }
            }
        }
        if let Some(f) = first {
            if blacks == target and in_row[f] == target and same {
                lonely += target;
            }
        }
    }
    lonely
}

// ---- ids: find_black_pixel_ids.kara

fn find_black_pixel_ids(picture: Vec[Vec[char]], target: i64) -> i64 {
    let (m, n) = (picture.len(), picture[0].len());
    let mut order: Vec[i64] = (0..m).collect();
    order.sort_by(|a, b| picture[a].cmp(picture[b]));
    let mut id = vec![0; m];
    for i in 1..m {
        id[order[i]] = if picture[order[i]] == picture[order[i - 1]] { id[order[i - 1]] } else { id[order[i - 1]] + 1 };
    }
    let mut in_row = vec![0; m];
    for r in 0..m {
        for c in 0..n {
            if picture[r][c] == 'B' {
                in_row[r] += 1;
            }
        }
    }
    let mut lonely = 0;
    for c in 0..n {
        let mut blacks = 0;
        let mut kind = -1;
        let mut same = true;
        for r in 0..m {
            if picture[r][c] == 'B' {
                blacks += 1;
                if kind == -1 {
                    kind = id[r];
                } else if id[r] != kind {
                    same = false;
                }
                if in_row[r] != target {
                    same = false;
                }
            }
        }
        if blacks == target and same {
            lonely += target;
        }
    }
    lonely
}

// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, picture: Vec[Vec[char]], target: i64) -> i64 {
    if which == 0 {
        find_black_pixel_star(picture, target)
    } else if which == 1 {
        find_black_pixel_brute(picture, target)
    } else if which == 2 {
        find_black_pixel_columns(picture, target)
    } else {
        find_black_pixel_ids(picture, target)
    }
}

// The definition, with sets: a black pixel at (r, c) is lonely when its
// row and its column each hold `target` black pixels and the rows black
// in column c, written as strings, form a set of one.
fn definition(picture: Vec[Vec[char]], target: i64) -> i64 {
    let (m, n) = (picture.len(), picture[0].len());
    let mut text: Vec[String] = Vec.new();
    for r in 0..m {
        let mut s = String.new();
        for ch in picture[r].iter() {
            s.push(*ch);
        }
        text.push(s);
    }
    let mut lonely = 0;
    for r in 0..m {
        for c in 0..n {
            if picture[r][c] != 'B' {
                continue;
            }
            let in_row = picture[r].iter().filter(|p| *p == 'B').count();
            let mut kinds: SortedSet[String] = SortedSet.new();
            let mut in_col = 0;
            for k in 0..m {
                if picture[k][c] == 'B' {
                    in_col += 1;
                    kinds.insert(text[k].clone());
                }
            }
            if in_row == target and in_col == target and kinds.len() == 1 {
                lonely += 1;
            }
        }
    }
    lonely
}

// A random picture n wide, as in the arms' harness but with two kinds of
// near miss: `planted` rows with `target` black pixels (a quarter of the
// time one fewer) written `target` times (a quarter of the time once
// more), one copy in three with a black pixel moved to another column;
// then `extra` rows black with chance `percent` in 100, the rows
// shuffled.
fn random_picture(seed: mut ref i64, n: i64, target: i64, planted: i64, extra: i64, percent: i64) -> Vec[Vec[char]] {
    let mut picture: Vec[Vec[char]] = Vec.new();
    for _ in 0..planted {
        let blacks = if next_random(mut seed) % 4 == 0 { target - 1 } else { target };
        let mut cols: Vec[i64] = (0..n).collect();
        let mut row = vec!['W'; n];
        for i in 0..blacks {
            let j = i + next_random(mut seed) % (n - i);
            cols.swap(i, j);
            row[cols[i]] = 'B';
        }
        let copies = if next_random(mut seed) % 4 == 0 { target + 1 } else { target };
        for _ in 0..copies {
            let mut copy = row.clone();
            if blacks > 0 and blacks < n and next_random(mut seed) % 3 == 0 {
                // Move the first black pixel to a white column.
                let to = blacks + next_random(mut seed) % (n - blacks);
                copy[cols[0]] = 'W';
                copy[cols[to]] = 'B';
            }
            picture.push(copy);
        }
    }
    for _ in 0..extra {
        let mut row: Vec[char] = Vec.new();
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < percent { 'B' } else { 'W' });
        }
        picture.push(row);
    }
    for i in (1..picture.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        picture.swap(i, j);
    }
    picture
}

fn main() {
    let names = vec!["star", "brute", "columns", "ids"];
    let count = 1000;
    let mut seed: i64 = 5330;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    for _ in 0..count {
        let n = 1 + next_random(mut seed) % 10;
        let target = 1 + next_random(mut seed) % n.min(3);
        let planted = next_random(mut seed) % 3;
        let extra = if planted == 0 { 1 + next_random(mut seed) % 6 } else { next_random(mut seed) % 7 };
        let percent = next_random(mut seed) % 41;
        let picture = random_picture(mut seed, n, target, planted, extra, percent);
        let m = picture.len();
        let want = definition(picture.clone(), target);
        let mut blacks = 0;
        for row in picture.iter() {
            for p in row.iter() {
                if *p == 'B' {
                    blacks += 1;
                }
            }
        }
        let mut shuffled = picture.clone();
        for i in (1..m).rev() {
            let j = next_random(mut seed) % (i + 1);
            shuffled.swap(i, j);
        }
        // The same reordering of the columns in every row.
        let mut perm: Vec[i64] = (0..n).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            perm.swap(i, j);
        }
        let mut permuted: Vec[Vec[char]] = Vec.new();
        for row in picture.iter() {
            let mut out: Vec[char] = Vec.new();
            for c in 0..n {
                out.push(row[perm[c]]);
            }
            permuted.push(out);
        }
        // One more white row and one more white column.
        let mut grown = picture.clone();
        for row in grown.iter_mut() {
            row.push('W');
        }
        grown.push(vec!['W'; n + 1]);
        for which in 0..4 {
            let got = answer(which, picture.clone(), target);
            let ok = vec![
                got == want,
                answer(which, shuffled.clone(), target) == got,
                answer(which, permuted.clone(), target) == got,
                got % target == 0 and got >= 0 and got <= blacks,
                answer(which, grown.clone(), target) == got,
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                    if failures[p] <= 3 {
                        println(f"FAIL P{p + 1} {names[which]}: {m} by {n}, target {target} -> {got}, want {want}");
                    }
                }
            }
        }
    }
    let total = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases, 4 arms, {checks} checks, {total} failures");
    if total > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
