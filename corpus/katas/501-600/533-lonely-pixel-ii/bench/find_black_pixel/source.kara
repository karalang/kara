// Benchmark for #533: the ★ arm (count each kind of row); see
// find_black_pixel.kara.
//
// A black pixel at (r, c) counts when row r and column c each hold
// `target` black pixels and every row with a black pixel in column c is
// the same as row r. So count how often each row occurs, written as a
// string, and the black pixels of each column. A row that holds `target`
// black pixels and occurs exactly `target` times answers for every
// column where it is black and the column holds `target`: those
// `target` copies are then all of the column's black pixels, and each is
// a lonely one. O(mn) time.

fn find_black_pixel(picture: Vec[Vec[char]], target: i64) -> i64 {
    let n = picture[0].len();
    let mut cols = vec![0; n];
    let mut rows: Map[String, i64] = Map.new();
    for row in picture.iter() {
        let mut key = String.new();
        let mut blacks = 0;
        for c in 0..n {
            key.push(row[c]);
            if row[c] == 'B' {
                cols[c] += 1;
                blacks += 1;
            }
        }
        if blacks == target {
            *rows.entry(key).or_insert(0) += 1;
        }
    }
    let mut lonely = 0;
    for (key, count) in rows.iter() {
        if *count != target {
            continue;
        }
        let mut c = 0;
        for ch in key.chars() {
            if ch == 'B' and cols[c] == target {
                lonely += target;
            }
            c += 1;
        }
    }
    lonely
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random picture n wide: `planted` rows with exactly `target` black
// pixels, each written `target` times (a quarter of the time once more),
// and `extra` rows black with chance `percent` in 100, the rows shuffled.
fn random_picture(seed: mut ref i64, n: i64, target: i64, planted: i64, extra: i64, percent: i64) -> Vec[Vec[char]] {
    let mut picture: Vec[Vec[char]] = Vec.new();
    for _ in 0..planted {
        let mut cols: Vec[i64] = (0..n).collect();
        let mut row = vec!['W'; n];
        for i in 0..target {
            let j = i + next_random(mut seed) % (n - i);
            cols.swap(i, j);
            row[cols[i]] = 'B';
        }
        let copies = if next_random(mut seed) % 4 == 0 { target + 1 } else { target };
        for _ in 0..copies {
            picture.push(row.clone());
        }
    }
    for _ in 0..extra {
        let mut row: Vec[char] = Vec.new();
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < percent { 'B' } else { 'W' });
        }
        picture.push(row);
    }
    for i in (1..picture.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        picture.swap(i, j);
    }
    picture
}

// 20 pictures 200 wide (the problem's most) made once, the p-th with 20
// rows planted for a target of 1 + p % 8 and 80 more black with a
// chance of 1%; then each picture is answered for every target from 1
// to 8, in 100 rounds.
fn main() {
    let mut seed: i64 = 533;
    let mut pictures: Vec[Vec[Vec[char]]] = Vec.new();
    for p in 0..20 {
        pictures.push(random_picture(mut seed, 200, 1 + p % 8, 20, 80, 1));
    }
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..100 {
        for p in 0..pictures.len() {
            for target in 1..=8 {
                let answer = find_black_pixel(pictures[p], target);
                total += answer;
                checksum = (checksum * 31 + answer) % 1000000007;
            }
        }
    }
    println(f"20 pictures 200 wide, targets 1 to 8, 100 rounds: total {total}, checksum {checksum}");
}
