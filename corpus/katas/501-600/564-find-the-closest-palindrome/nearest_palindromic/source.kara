// LeetCode #564: Find the Closest Palindrome -- five candidates.
//
// A palindrome is fixed by its first half. The closest one to n keeps
// n's first half, or that half one smaller or one larger, mirrored; or
// it has a different number of digits, and then it is 99...9 (one digit
// shorter) or 10...01 (one digit longer). The answer is the candidate
// nearest n that is not n, the smaller on a tie. O(digits) time.

// `half` followed by its first `length` / 2 digits reversed: the
// palindrome of `length` digits whose first half is `half`. When `half`
// has lost or gained a digit (10 - 1, 99 + 1) the result is one digit
// short or long, and still a palindrome.
fn mirrored(half: i64, length: i64) -> i64 {
    let text = half.to_string();
    let mut s = text.clone();
    let chars: Vec[char] = text.chars().collect();
    let mut i = (length / 2).min(chars.len()) - 1;
    while i >= 0 {
        s.push(chars[i]);
        i -= 1;
    }
    i64.parse(s).unwrap()
}

fn nearest_palindromic(n: String) -> String {
    let value = i64.parse(n).unwrap();
    let length = n.len();
    let half = i64.parse(n[..(length + 1) / 2]).unwrap();
    let mut candidates = vec![
        10.pow((length - 1) as u32) - 1,
        10.pow(length as u32) + 1,
    ];
    for h in [half - 1, half, half + 1] {
        candidates.push(mirrored(h, length));
    }
    let mut best = -1;
    for c in candidates {
        if c == value or c < 0 {
            continue;
        }
        let d = (c - value).abs();
        let bd = (best - value).abs();
        if best == -1 or d < bd or (d == bd and c < best) {
            best = c;
        }
    }
    best.to_string()
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: Str) {
    println(f"{n} -> {nearest_palindromic(n.to_string())}");
}

// A random number of 1 to 18 digits: plain, a palindrome, or a power of
// ten moved by up to 3, in turn.
fn random_number(t: i64, seed: mut ref i64) -> String {
    let length = 1 + step(seed) % 18;
    let mut digits: Vec[i64] = vec![1 + step(seed) % 9];
    for _ in 1..length {
        digits.push(step(seed) % 10);
    }
    if t % 3 == 1 {
        for i in 0..length / 2 {
            digits[length - 1 - i] = digits[i];
        }
    }
    let mut value: i64 = 0;
    for d in digits {
        value = value * 10 + d;
    }
    if t % 3 == 2 {
        value = 10.pow((length - 1) as u32) + step(seed) % 7 - 3;
        if value < 1 {
            value = 1;
        }
    }
    value.to_string()
}

fn main() {
    // The two LeetCode examples.
    show("123");
    show("1");
    // Around powers of ten, where the answer may change length; 10 and
    // 1000 are ties, settled by the smaller.
    show("9");
    show("10");
    show("11");
    show("99");
    show("100");
    show("101");
    show("1000");
    show("1001");
    // A half that carries when raised or borrows when lowered.
    show("1991");
    show("12932");
    show("99800");
    // The problem's largest numbers.
    show("100000000000000000");
    show("807045053224792883");
    show("999999999999999998");
    show("999999999999999999");
    // Every number from 1 to 3000.
    let mut checksum: i64 = 0;
    for v in 1..3001 {
        let got = i64.parse(nearest_palindromic(v.to_string())).unwrap();
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"1 to 3000: checksum {checksum}");
    // 300 random numbers of 1 to 18 digits.
    let mut seed: i64 = 564;
    let mut checksum: i64 = 0;
    let mut longer = 0;
    for t in 0..300 {
        let n = random_number(t, mut seed);
        let got = nearest_palindromic(n.clone());
        if got.len() != n.len() {
            longer += 1;
        }
        checksum = (checksum * 31 + i64.parse(got).unwrap()) % 1000000007;
    }
    println(f"300 random numbers: {longer} answers of another length, checksum {checksum}");
}
