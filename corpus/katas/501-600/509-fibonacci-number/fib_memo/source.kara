// LeetCode #509: Fibonacci Number -- the recurrence, remembered.
//
// F(n) = F(n - 1) + F(n - 2), straight from the definition, with each
// value kept in a table the first time it is worked out, so every n is
// computed once. The table is a Vec of Option[i64], None for not yet
// known. O(n) time and space.

fn fib_from(n: i64, known: mut ref Vec[Option[i64]]) -> i64 {
    if let Some(v) = known[n] {
        return v;
    }
    let v = if n < 2 { n } else { fib_from(n - 1, mut known) + fib_from(n - 2, mut known) };
    known[n] = Some(v);
    v
}

fn fib(n: i64) -> i64 {
    let mut known: Vec[Option[i64]] = vec![None; n + 1];
    fib_from(n, mut known)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"n = 2: {fib(2)}");
    println(f"n = 3: {fib(3)}");
    println(f"n = 4: {fib(4)}");
    let mut all: Vec[i64] = Vec.new();
    for n in 0..=30 {
        all.push(fib(n));
    }
    println(f"0 to 30: {all}");
    // 300 random n from 0 to 30.
    let mut seed: i64 = 509;
    let count = 300;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % 31;
        let f = fib(n);
        total += f;
        checksum = (checksum * 31 + f) % 1000000007;
    }
    println(f"{count} random n: total {total}, checksum {checksum}");
}
