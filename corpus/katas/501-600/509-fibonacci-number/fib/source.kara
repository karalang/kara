// LeetCode #509: Fibonacci Number -- two running values.
//
// Keep F(i) and F(i + 1) and step them n times: the next pair is
// F(i + 1) and their sum. O(n) time, O(1) space.

fn fib(n: i64) -> i64 {
    let mut a = 0;
    let mut b = 1;
    for _ in 0..n {
        let next = a + b;
        a = b;
        b = next;
    }
    a
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"n = 2: {fib(2)}");
    println(f"n = 3: {fib(3)}");
    println(f"n = 4: {fib(4)}");
    let mut all: Vec[i64] = Vec.new();
    for n in 0..=30 {
        all.push(fib(n));
    }
    println(f"0 to 30: {all}");
    // 300 random n from 0 to 30.
    let mut seed: i64 = 509;
    let count = 300;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % 31;
        let f = fib(n);
        total += f;
        checksum = (checksum * 31 + f) % 1000000007;
    }
    println(f"{count} random n: total {total}, checksum {checksum}");
}
