// Differential test for LeetCode #509: Fibonacci Number.
//
// Copies of the four arms, on 1,500 pairs of random n and m from 0 to
// 30. Properties:
//   P1  F(n) is the reference's, a table built by adding up from F(0)
//       and F(1)
//   P2  F(k + 2) = F(k + 1) + F(k)
//   P3  Cassini's identity, F(k - 1) F(k + 1) - F(k)^2 = (-1)^k
//   P4  gcd(F(n), F(m)) = F(gcd(n, m))
//   P5  F(2k) = F(k) (2 F(k + 1) - F(k))

// ---- star: fib.kara

fn fib_star(n: i64) -> i64 {
    let mut a = 0;
    let mut b = 1;
    for _ in 0..n {
        let next = a + b;
        a = b;
        b = next;
    }
    a
}

// ---- memo: fib_memo.kara

fn fib_from_memo(n: i64, known: mut ref Vec[Option[i64]]) -> i64 {
    if let Some(v) = known[n] {
        return v;
    }
    let v = if n < 2 { n } else { fib_from_memo(n - 1, known) + fib_from_memo(n - 2, known) };
    known[n] = Some(v);
    v
}

fn fib_memo(n: i64) -> i64 {
    let mut known: Vec[Option[i64]] = vec![None; n + 1];
    fib_from_memo(n, mut known)
}

// ---- doubling: fib_doubling.kara

fn pair_doubling(n: i64) -> (i64, i64) {
    if n == 0 {
        return (0, 1);
    }
    let (a, b) = pair_doubling(n / 2);
    let c = a * (2 * b - a);
    let d = a * a + b * b;
    if n % 2 == 0 { (c, d) } else { (d, c + d) }
}

fn fib_doubling(n: i64) -> i64 {
    pair_doubling(n).0
}

// ---- binet: fib_binet.kara

fn fib_binet(n: i64) -> i64 {
    let root5 = 5.0.sqrt();
    let phi = (1.0 + root5) / 2.0;
    (phi.powi(n as i32) / root5).round() as i64
}
// ---- differential harness -------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, n: i64) -> i64 {
    match which {
        0 => fib_star(n),
        1 => fib_memo(n),
        2 => fib_doubling(n),
        _ => fib_binet(n),
    }
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn main() {
    let names = vec!["star", "memo", "doubling", "binet"];
    // The reference: F(0) to F(30) by adding up from the start.
    let mut table: Vec[i64] = vec![0, 1];
    for i in 2..=30 {
        table.push(table[i - 1] + table[i - 2]);
    }
    let cases = 1500;
    let mut seed: i64 = 5090;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property: Vec[i64] = vec![0, 0, 0, 0, 0];
    for c in 0..cases {
        let n = next_random(mut seed) % 31;
        let m = next_random(mut seed) % 31;
        for which in 0..4 {
            let got = arm(which, n);
            // P1: F(n) is the reference's.
            checks += 1;
            if got != table[n] {
                failures += 1;
                by_property[0] += 1;
                if failures <= 5 {
                    println(f"P1 {names[which]}: F({n}) gave {got}, want {table[n]}");
                }
            }
            // P2: F(k + 2) = F(k + 1) + F(k), with k + 2 at most 30.
            checks += 1;
            let k = if n <= 28 { n } else { n - 2 };
            if arm(which, k + 2) != arm(which, k + 1) + arm(which, k) {
                failures += 1;
                by_property[1] += 1;
                if failures <= 5 {
                    println(f"P2 {names[which]}: F({k + 2}) is not F({k + 1}) + F({k})");
                }
            }
            // P3: Cassini, F(k - 1) F(k + 1) - F(k)^2 = (-1)^k, for k
            // from 1 to 29.
            checks += 1;
            let k = if n < 1 { 1 } else if n > 29 { 29 } else { n };
            let sign = if k % 2 == 0 { 1 } else { -1 };
            let f = arm(which, k);
            if arm(which, k - 1) * arm(which, k + 1) - f * f != sign {
                failures += 1;
                by_property[2] += 1;
                if failures <= 5 {
                    println(f"P3 {names[which]}: Cassini fails at {k}");
                }
            }
            // P4: gcd(F(n), F(m)) = F(gcd(n, m)).
            checks += 1;
            if gcd(got, arm(which, m)) != arm(which, gcd(n, m)) {
                failures += 1;
                by_property[3] += 1;
                if failures <= 5 {
                    println(f"P4 {names[which]}: gcd(F({n}), F({m})) is not F({gcd(n, m)})");
                }
            }
            // P5: F(2k) = F(k) (2 F(k + 1) - F(k)), for k up to 15.
            checks += 1;
            let k = n % 16;
            let a = arm(which, k);
            if arm(which, 2 * k) != a * (2 * arm(which, k + 1) - a) {
                failures += 1;
                by_property[4] += 1;
                if failures <= 5 {
                    println(f"P5 {names[which]}: F({2 * k}) is not F({k}) (2 F({k + 1}) - F({k}))");
                }
            }
        }
    }
    println(f"{cases} cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}, P5 {by_property[4]}");
    }
}
