// LeetCode #509: Fibonacci Number -- Binet's formula.
//
// F(n) = (phi^n - psi^n) / sqrt(5) with phi = (1 + sqrt 5) / 2 and psi
// = (1 - sqrt 5) / 2. |psi^n / sqrt 5| is below 1/2 for every n, so
// F(n) is phi^n / sqrt 5 rounded to the nearest whole number. An f64
// keeps that exact far past n = 30. O(1) arithmetic.

fn fib(n: i64) -> i64 {
    let root5 = 5.0.sqrt();
    let phi = (1.0 + root5) / 2.0;
    (phi.powi(n as i32) / root5).round() as i64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"n = 2: {fib(2)}");
    println(f"n = 3: {fib(3)}");
    println(f"n = 4: {fib(4)}");
    let mut all: Vec[i64] = Vec.new();
    for n in 0..=30 {
        all.push(fib(n));
    }
    println(f"0 to 30: {all}");
    // 300 random n from 0 to 30.
    let mut seed: i64 = 509;
    let count = 300;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % 31;
        let f = fib(n);
        total += f;
        checksum = (checksum * 31 + f) % 1000000007;
    }
    println(f"{count} random n: total {total}, checksum {checksum}");
}
