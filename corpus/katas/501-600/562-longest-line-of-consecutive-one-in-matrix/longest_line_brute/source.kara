// LeetCode #562: Longest Line of Consecutive One in Matrix -- every
// cell, every direction.
//
// From every one, walk each of the four directions until the matrix
// ends or a zero is met, and keep the longest walk. O(m * n * (m + n))
// time.

fn longest_line(mat: Vec[Vec[i64]]) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let directions = [(0, 1), (1, 0), (1, 1), (1, -1)];
    let mut best = 0;
    for i in 0..m {
        for j in 0..n {
            for (di, dj) in directions {
                let mut r = i;
                let mut c = j;
                let mut length = 0;
                while r >= 0 and r < m and c >= 0 and c < n and mat[r][c] == 1 {
                    length += 1;
                    r += di;
                    c += dj;
                }
                best = best.max(length);
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(mat: Vec[Vec[i64]]) {
    println(f"{mat}: {longest_line(mat)}");
}

// An m by n matrix whose cells are ones `percent` times in a hundred.
fn random_matrix(m: i64, n: i64, percent: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut mat: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(if step(mut seed) % 100 < percent { 1 } else { 0 });
        }
        mat.push(row);
    }
    mat
}

fn main() {
    // The two LeetCode examples.
    show(vec![vec![0, 1, 1, 0], vec![0, 1, 1, 0], vec![0, 0, 0, 1]]);
    show(vec![vec![1, 1, 1, 1], vec![0, 1, 1, 0], vec![0, 0, 0, 1]]);
    // One cell.
    show(vec![vec![0]]);
    show(vec![vec![1]]);
    // One row and one column.
    show(vec![vec![1, 1, 0, 1, 1, 1]]);
    show(vec![vec![1], vec![1], vec![0], vec![1]]);
    // The longest line on a diagonal, and on an anti-diagonal.
    show(vec![vec![1, 0, 0, 1], vec![0, 1, 1, 0], vec![1, 0, 1, 0], vec![0, 0, 0, 1]]);
    show(vec![vec![0, 0, 0, 1], vec![1, 0, 1, 0], vec![0, 1, 0, 0], vec![1, 0, 0, 1]]);
    // 300 random matrices of 1 to 12 by 1 to 12, ones 30 to 90 times in a
    // hundred.
    let mut seed: i64 = 562;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let m = 1 + step(mut seed) % 12;
        let n = 1 + step(mut seed) % 12;
        let percent = 30 + step(mut seed) % 61;
        let got = longest_line(random_matrix(m, n, percent, mut seed));
        total += got;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"300 random matrices: total {total}, checksum {checksum}");
    // The problem's most, 10,000 cells: all ones as 100 by 100, one row
    // and one column, and 100 by 100 ones 70 times in a hundred.
    println(f"100 by 100 ones: {longest_line(random_matrix(100, 100, 100, mut seed))}");
    println(f"1 by 10000 ones: {longest_line(random_matrix(1, 10000, 100, mut seed))}");
    println(f"10000 by 1 ones: {longest_line(random_matrix(10000, 1, 100, mut seed))}");
    println(f"100 by 100 random: {longest_line(random_matrix(100, 100, 70, mut seed))}");
}
