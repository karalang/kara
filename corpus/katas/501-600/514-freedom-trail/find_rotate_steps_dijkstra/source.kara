// LeetCode #514: Freedom Trail -- shortest path over (letters spelled,
// position).
//
// A state is how much of the key is spelled and where the ring rests.
// From (i, p) every position q holding key[i] is an edge of the shorter
// way round plus the press. Dijkstra with a smallest-first
// PriorityQueue of (steps, i, p); the first state to come out with the
// whole key spelled is the answer.

fn find_rotate_steps(ring: Str, key: Str) -> i64 {
    let r = ring.bytes();
    let k = key.bytes();
    let n = r.len();
    let m = k.len();
    let mut done: Vec[Vec[bool]] = vec![vec![false; n]; m + 1];
    let mut queue: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    queue.push((0, 0, 0));
    while let Some((cost, i, p)) = queue.pop() {
        if i == m {
            return cost;
        }
        if done[i][p] {
            continue;
        }
        done[i][p] = true;
        for q in 0..n {
            if r[q] == k[i] and not done[i + 1][q] {
                let d = (p - q).abs();
                queue.push((cost + d.min(n - d) + 1, i + 1, q));
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(ring: Str, key: Str) {
    println(f"\"{ring}\", \"{key}\": {find_rotate_steps(ring, key)}");
}

fn main() {
    show("godding", "gd");
    show("godding", "godding");
    show("a", "a");
    show("ab", "bbbb");
    show("abcde", "eae");
    show("caotmcaataijjxi", "oatjiioicitatajtijciocjcaaxaaatmctxamacaamjjx");
    // 300 random rings of 1 to 60 letters from the first 2, 5 or 26 in
    // turn, and keys of 1 to 60 letters drawn from the ring.
    let mut seed: i64 = 514;
    let count = 300;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let letters = if t % 3 == 0 { 2 } else if t % 3 == 1 { 5 } else { 26 };
        let n = 1 + next_random(mut seed) % 60;
        let m = 1 + next_random(mut seed) % 60;
        let mut ring = String.new();
        for _ in 0..n {
            ring.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let rb = ring.bytes();
        let mut key = String.new();
        for _ in 0..m {
            key.push(rb[next_random(mut seed) % n] as char);
        }
        let steps = find_rotate_steps(ring, key);
        total += steps;
        checksum = (checksum * 31 + steps) % 1000000007;
    }
    println(f"{count} random rings: {total} steps in all, checksum {checksum}");
}
