// LeetCode #514: Freedom Trail -- top-down, remembered.
//
// steps(i, p) is the fewest rotations to spell key[i..] with position p
// at 12:00: try every position holding key[i], add the shorter way
// round to it, and recurse. A table of n by m entries, -1 for not yet
// worked out, makes each state count once. O(m n^2).

fn steps(r: Slice[u8], k: Slice[u8], i: i64, p: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if i == k.len() {
        return 0;
    }
    if memo[i][p] >= 0 {
        return memo[i][p];
    }
    let n = r.len();
    let mut best = i64.MAX;
    for q in 0..n {
        if r[q] == k[i] {
            let d = (p - q).abs();
            best = best.min(d.min(n - d) + steps(r, k, i + 1, q, mut memo));
        }
    }
    memo[i][p] = best;
    best
}

fn find_rotate_steps(ring: Str, key: Str) -> i64 {
    let r = ring.bytes();
    let k = key.bytes();
    let mut memo: Vec[Vec[i64]] = vec![vec![-1; r.len()]; k.len()];
    steps(r, k, 0, 0, mut memo) + k.len()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(ring: Str, key: Str) {
    println(f"\"{ring}\", \"{key}\": {find_rotate_steps(ring, key)}");
}

fn main() {
    show("godding", "gd");
    show("godding", "godding");
    show("a", "a");
    show("ab", "bbbb");
    show("abcde", "eae");
    show("caotmcaataijjxi", "oatjiioicitatajtijciocjcaaxaaatmctxamacaamjjx");
    // 300 random rings of 1 to 60 letters from the first 2, 5 or 26 in
    // turn, and keys of 1 to 60 letters drawn from the ring.
    let mut seed: i64 = 514;
    let count = 300;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let letters = if t % 3 == 0 { 2 } else if t % 3 == 1 { 5 } else { 26 };
        let n = 1 + next_random(mut seed) % 60;
        let m = 1 + next_random(mut seed) % 60;
        let mut ring = String.new();
        for _ in 0..n {
            ring.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let rb = ring.bytes();
        let mut key = String.new();
        for _ in 0..m {
            key.push(rb[next_random(mut seed) % n] as char);
        }
        let steps = find_rotate_steps(ring, key);
        total += steps;
        checksum = (checksum * 31 + steps) % 1000000007;
    }
    println(f"{count} random rings: {total} steps in all, checksum {checksum}");
}
