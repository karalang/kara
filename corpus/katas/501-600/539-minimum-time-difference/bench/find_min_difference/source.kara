// Benchmark for #539: Minimum Time Difference -- the ★ arm (minutes,
// sorted).
//
// Each time becomes its minutes past midnight. Sorted, the closest pair
// is either two neighbours or the last and the first, which are apart
// by the first plus a day less the last, across midnight.
// O(n log n) time.

fn minutes(t: Str) -> i64 {
    i64.parse(t[0..2]).unwrap() * 60 + i64.parse(t[3..5]).unwrap()
}

fn find_min_difference(time_points: Vec[String]) -> i64 {
    let mut mins: Vec[i64] = time_points.iter().map(|t| minutes(t)).collect();
    mins.sort();
    let mut best = mins[0] + 1440 - mins[mins.len() - 1];
    for i in 1..mins.len() {
        best = best.min(mins[i] - mins[i - 1]);
    }
    best
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn clock(minute: i64) -> String {
    f"{minute / 60:02}:{minute % 60:02}"
}

fn main() {
    // 300 lists of 20 to 1,440 distinct times, the first places of a
    // shuffle of the whole day, built once. Then the answer for each
    // list is found 100 times.
    let lists = 300;
    let mut seed: i64 = 539;
    let mut day: Vec[i64] = Vec.new();
    for m in 0..1440 {
        day.push(m);
    }
    let mut all: Vec[Vec[String]] = Vec.new();
    let mut total_times = 0;
    for _ in 0..lists {
        let size = 20 + next_random(mut seed) % 1421;
        let mut times: Vec[String] = Vec.new();
        for i in 0..size {
            let j = i + next_random(mut seed) % (1440 - i);
            day.swap(i, j);
            times.push(clock(day[i]));
        }
        total_times += size;
        all.push(times);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..100 {
        for t in 0..lists {
            let answer = find_min_difference(all[t]);
            total += answer;
            checksum = (checksum * 31 + answer) % 1000000007;
        }
    }
    println(f"{lists} lists, {total_times} times, 100 times each: total {total}, checksum {checksum}");
}
