// LeetCode #539: Minimum Time Difference -- a mark for every minute of
// the day.
//
// There are only 1,440 minutes in a day, so more times than that must
// repeat one (the answer is then 0), and otherwise a mark per minute
// read off the bytes finds a repeat at once, or leaves the times in
// order to be walked once, with the first and last closing the circle.
// O(n + 1440) time.

fn find_min_difference(time_points: Vec[String]) -> i64 {
    if time_points.len() > 1440 {
        return 0;
    }
    let mut seen = vec![false; 1440];
    for t in time_points.iter() {
        let b = t.bytes();
        let hours = (b[0] - b'0') as i64 * 10 + (b[1] - b'0') as i64;
        let m = hours * 60 + (b[3] - b'0') as i64 * 10 + (b[4] - b'0') as i64;
        if seen[m] {
            return 0;
        }
        seen[m] = true;
    }
    let mut first = -1;
    let mut prev = -1;
    let mut best = 1440;
    for m in 0..1440 {
        if seen[m] {
            if prev < 0 {
                first = m;
            } else {
                best = best.min(m - prev);
            }
            prev = m;
        }
    }
    best.min(first + 1440 - prev)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn clock(minute: i64) -> String {
    f"{minute / 60:02}:{minute % 60:02}"
}

fn show(name: Str, times: Vec[String]) {
    let answer = find_min_difference(times);
    if times.len() <= 8 {
        println(f"{name}: {times} -> {answer}");
    } else {
        println(f"{name}: {times.len()} times -> {answer}");
    }
}

// Every `step`th minute of the day, in a random order.
fn spread(name: Str, step: i64, seed: mut ref i64) {
    let mut times: Vec[String] = Vec.new();
    let mut minute = 0;
    while minute < 1440 {
        times.push(clock(minute));
        minute += step;
    }
    for i in (1..times.len()).rev() {
        let j = (next_random(seed) * 32768 + next_random(seed)) % (i + 1);
        times.swap(i, j);
    }
    show(name, times);
}

fn main() {
    let mut seed: i64 = 539;
    show("example 1", vec!["23:59".to_string(), "00:00".to_string()]);
    show("example 2", vec!["00:00".to_string(), "23:59".to_string(), "00:00".to_string()]);
    show("half a day", vec!["12:00".to_string(), "00:00".to_string()]);
    show("the same time twice", vec!["07:30".to_string(), "07:30".to_string()]);
    show("closest across midnight", vec!["23:50".to_string(), "00:05".to_string(), "12:00".to_string()]);
    show("closest inside the day", vec!["01:00".to_string(), "02:00".to_string(), "01:59".to_string(), "23:00".to_string()]);
    show("hours apart", vec!["03:00".to_string(), "09:00".to_string(), "15:00".to_string(), "21:00".to_string()]);
    // 300 random lists of 2 to 60 times, from the whole day, or from
    // the first two hours, where repeats are common.
    let count = 300;
    let mut total = 0;
    let mut zeros = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let size = 2 + next_random(mut seed) % 59;
        let span = if t % 2 == 0 { 1440 } else { 120 };
        let mut times: Vec[String] = Vec.new();
        for _ in 0..size {
            times.push(clock(next_random(mut seed) % span));
        }
        total += size;
        let answer = find_min_difference(times);
        if answer == 0 {
            zeros += 1;
        }
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"{count} random lists: {total} times, {zeros} with a repeat, checksum {checksum}");
    // The largest cases: every third minute of the day, every minute,
    // and 20,000 random times (the problem's most), each in a random
    // order.
    spread("every third minute", 3, mut seed);
    spread("every minute", 1, mut seed);
    let mut times: Vec[String] = Vec.new();
    for _ in 0..20000 {
        times.push(clock(next_random(mut seed) % 1440));
    }
    show("20000 random times", times);
}
