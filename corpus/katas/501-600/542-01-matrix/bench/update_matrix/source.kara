// Benchmark for #542: 01 Matrix -- the ★ arm (breadth-first search from
// every 0 at once).
//
// Every 0 starts in the queue at distance 0. Taking cells off the queue
// in order, each unknown neighbour gets the distance plus one and joins
// the queue. O(m n) time.

fn update_matrix(mat: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let m = mat.len();
    let n = mat[0].len();
    let mut dist = vec![vec![-1; n]; m];
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    for r in 0..m {
        for c in 0..n {
            if mat[r][c] == 0 {
                dist[r][c] = 0;
                queue.push_back((r, c));
            }
        }
    }
    let steps = [(-1, 0), (1, 0), (0, -1), (0, 1)];
    while let Some((r, c)) = queue.pop_front() {
        for (dr, dc) in steps {
            let (nr, nc) = (r + dr, c + dc);
            if nr >= 0 and nr < m and nc >= 0 and nc < n and dist[nr][nc] < 0 {
                dist[nr][nc] = dist[r][c] + 1;
                queue.push_back((nr, nc));
            }
        }
    }
    dist
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 random 100 by 100 grids (the problem's 10,000 cells), from half
    // ones to 88 in a hundred, built once. Then 50 times over every grid
    // is answered; one row of the answer, picked by the round and the
    // grid, is summed, and one cell goes into the checksum.
    let grids = 20;
    let mut seed: i64 = 542;
    let mut all: Vec[Vec[Vec[i64]]] = Vec.new();
    for g in 0..grids {
        let ones = 50 + 2 * g;
        let mut mat: Vec[Vec[i64]] = Vec.new();
        for _ in 0..100 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..100 {
                row.push(if next_random(mut seed) % 100 < ones { 1 } else { 0 });
            }
            mat.push(row);
        }
        all.push(mat);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for r in 0..50 {
        for t in 0..grids {
            let answer = update_matrix(all[t]);
            for d in answer[(r * 7 + t * 13) % 100].iter() {
                total += *d;
            }
            let cell = answer[(r * 11 + t * 3) % 100][(r * 5 + t * 17) % 100];
            checksum = (checksum * 31 + cell) % 1000000007;
        }
    }
    println(f"{grids} grids, 50 times each: row sum {total}, checksum {checksum}");
}
