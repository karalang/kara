// Differential test for LeetCode #548: Split Array with Equal Sum.
//
// Copies of the four arms, each held to the properties below on 1,000
// random arrays of 1 to 14 values, from -1 to 1, -2 to 2 or -4 to 4 in
// turn.
// Properties:
//   P1  the answer is the definition's: every triple of cuts tried, each
//       part summed on its own
//   P2  the array reversed gives the same answer
//   P3  every value negated gives the same answer
//   P4  a yes stays a yes with a 0 added at each end
//   P5  every value doubled gives the same answer, and fewer than 7
//       values is never a yes

// ---- star: split_array_with_equal_sum.kara

fn split_array_star(nums: Vec[i64]) -> bool {
    let n = nums.len();
    if n < 7 {
        return false;
    }
    let mut prefix = vec![0; n + 1];
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    for j in 3..n - 3 {
        let mut sums: Set[i64] = Set.new();
        for i in 1..j - 1 {
            if prefix[i] == prefix[j] - prefix[i + 1] {
                sums.insert(prefix[i]);
            }
        }
        for k in j + 2..n - 1 {
            let third = prefix[k] - prefix[j + 1];
            if third == prefix[n] - prefix[k + 1] and sums.contains(third) {
                return true;
            }
        }
    }
    false
}

// ---- sorted: split_array_with_equal_sum_sorted.kara

fn split_array_sorted(nums: Vec[i64]) -> bool {
    let n = nums.len();
    if n < 7 {
        return false;
    }
    let mut prefix = vec![0; n + 1];
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    for j in 3..n - 3 {
        let mut sums: Vec[i64] = Vec.new();
        for i in 1..j - 1 {
            if prefix[i] == prefix[j] - prefix[i + 1] {
                sums.push(prefix[i]);
            }
        }
        if sums.is_empty() {
            continue;
        }
        sums.sort();
        for k in j + 2..n - 1 {
            let third = prefix[k] - prefix[j + 1];
            if third == prefix[n] - prefix[k + 1] {
                let mut lo = 0;
                let mut hi = sums.len();
                while lo < hi {
                    let mid = (lo + hi) / 2;
                    if sums[mid] < third {
                        lo = mid + 1;
                    } else {
                        hi = mid;
                    }
                }
                if lo < sums.len() and sums[lo] == third {
                    return true;
                }
            }
        }
    }
    false
}

// ---- right: split_array_with_equal_sum_right.kara

fn split_array_right(nums: Vec[i64]) -> bool {
    let n = nums.len();
    if n < 7 {
        return false;
    }
    let mut prefix = vec![0; n + 1];
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    for j in 3..n - 3 {
        let mut sums: SortedSet[i64] = SortedSet.new();
        for k in j + 2..n - 1 {
            let third = prefix[k] - prefix[j + 1];
            if third == prefix[n] - prefix[k + 1] {
                sums.insert(third);
            }
        }
        for i in 1..j - 1 {
            if prefix[i] == prefix[j] - prefix[i + 1] and sums.contains(prefix[i]) {
                return true;
            }
        }
    }
    false
}

// ---- cuts: split_array_with_equal_sum_cuts.kara

fn split_array_cuts(nums: Vec[i64]) -> bool {
    let n = nums.len();
    if n < 7 {
        return false;
    }
    let mut total = 0;
    for x in nums.iter() {
        total += *x;
    }
    let mut first = 0;
    for i in 1..n - 5 {
        first += nums[i - 1];
        let mut second = 0;
        for j in i + 2..n - 3 {
            second += nums[j - 1];
            if second != first {
                continue;
            }
            let mut third = 0;
            for k in j + 2..n - 1 {
                third += nums[k - 1];
                let fourth = total - first - nums[i] - second - nums[j] - third - nums[k];
                if third == first and fourth == first {
                    return true;
                }
            }
        }
    }
    false
}

// ---- the definition and the properties ------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn part(nums: Vec[i64], from: i64, to: i64) -> i64 {
    let mut s = 0;
    for x in from..to + 1 {
        s += nums[x];
    }
    s
}

// The statement read literally: every triple of cuts with
// 0 < i, i + 1 < j, j + 1 < k < n - 1, each of the four parts summed
// on its own.
fn definition(nums: Vec[i64]) -> bool {
    let n = nums.len();
    for i in 1..n {
        for j in i + 2..n {
            for k in j + 2..n - 1 {
                let a = part(nums, 0, i - 1);
                if a == part(nums, i + 1, j - 1) and a == part(nums, j + 1, k - 1) and a == part(nums, k + 1, n - 1) {
                    return true;
                }
            }
        }
    }
    false
}

fn answer(which: i64, nums: Vec[i64]) -> bool {
    if which == 0 {
        split_array_star(nums)
    } else if which == 1 {
        split_array_sorted(nums)
    } else if which == 2 {
        split_array_right(nums)
    } else {
        split_array_cuts(nums)
    }
}

fn main() {
    let names = vec!["star", "sorted", "right", "cuts"];
    let count = 1000;
    let mut seed: i64 = 5480;
    let mut checks = 0;
    let mut failures = vec![0; 5];
    let mut yes = 0;
    for t in 0..count {
        // 1 to 14 values from -1 to 1, -2 to 2 or -4 to 4 in turn.
        let n = 1 + next_random(mut seed) % 14;
        let spread = if t % 3 == 0 { 1 } else if t % 3 == 1 { 2 } else { 4 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % (2 * spread + 1) - spread);
        }
        let want = definition(nums.clone());
        if want {
            yes += 1;
        }
        let mut reversed: Vec[i64] = Vec.new();
        for k in (0..n).rev() {
            reversed.push(nums[k]);
        }
        let mut negated: Vec[i64] = Vec.new();
        let mut doubled: Vec[i64] = Vec.new();
        let mut padded: Vec[i64] = vec![0];
        for x in nums.iter() {
            negated.push(0 - *x);
            doubled.push(2 * *x);
            padded.push(*x);
        }
        padded.push(0);
        for which in 0..4 {
            let got = answer(which, nums.clone());
            let ok = vec![
                got == want,
                answer(which, reversed.clone()) == got,
                answer(which, negated.clone()) == got,
                not got or answer(which, padded.clone()),
                answer(which, doubled.clone()) == got and (n >= 7 or not got),
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                    if failures[p] <= 3 {
                        println(f"FAIL P{p + 1} {names[which]}: {nums} -> {got}, want {want}");
                    }
                }
            }
        }
    }
    let total = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases ({yes} can be split), 4 arms, {checks} checks, {total} failures");
    if total > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
