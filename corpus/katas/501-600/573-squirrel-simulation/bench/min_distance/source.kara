// Benchmark for #573: Squirrel Simulation -- the ★ arm (one pass with
// the best first nut).
//
// Every nut but the first costs a round trip from the tree, twice its
// distance there. The first is reached from the squirrel instead, which
// saves the nut's distance to the tree and costs its distance to the
// squirrel. So the answer is twice the sum of the nuts' distances to the
// tree, less the largest saving, distance to the tree minus distance to
// the squirrel. Distances are Manhattan, since the squirrel moves one
// cell up, down, left or right at a time. O(nuts) time, O(1) space.

fn distance(a: Vec[i64], b: Vec[i64]) -> i64 {
    (a[0] - b[0]).abs() + (a[1] - b[1]).abs()
}

fn min_distance(height: i64, width: i64, tree: Vec[i64], squirrel: Vec[i64], nuts: Vec[Vec[i64]]) -> i64 {
    let mut total = 0;
    let mut best_saving = i64.MIN;
    for nut in nuts.iter() {
        let to_tree = distance(nut, tree);
        total += 2 * to_tree;
        best_saving = best_saving.max(to_tree - distance(nut, squirrel));
    }
    total - best_saving
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 cases built once on a 100 by 100 grid, each with a tree, a
    // squirrel and 5,000 nuts (the problem's most) at random. Then 2,000
    // times over, every case is answered.
    let count = 20;
    let rounds = 2000;
    let mut seed: i64 = 573;
    let mut trees: Vec[Vec[i64]] = Vec.new();
    let mut squirrels: Vec[Vec[i64]] = Vec.new();
    let mut nut_sets: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        trees.push(vec![next_random(mut seed) % 100, next_random(mut seed) % 100]);
        squirrels.push(vec![next_random(mut seed) % 100, next_random(mut seed) % 100]);
        let mut nuts: Vec[Vec[i64]] = Vec.new();
        for _ in 0..5000 {
            nuts.push(vec![next_random(mut seed) % 100, next_random(mut seed) % 100]);
        }
        nut_sets.push(nuts);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        for g in 0..count {
            let p = (round * 7 + g) % count;
            let got = min_distance(100, 100, trees[p], squirrels[p], nut_sets[p]);
            total += got;
            checksum = (checksum * 31 + got) % 1000000007;
        }
    }
    println(f"{count} cases of 5000 nuts, {rounds} rounds: {total} steps, checksum {checksum}");
}
