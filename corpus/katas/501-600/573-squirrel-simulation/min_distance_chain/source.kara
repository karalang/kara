// LeetCode #573: Squirrel Simulation -- iterator chains.
//
// The round trips summed with `map` and `sum`, and the best saving from
// starting at a nut, its distance to the tree minus its distance to the
// squirrel, with `map` and `max`. O(nuts) time, O(1) space.

fn min_distance(height: i64, width: i64, tree: Vec[i64], squirrel: Vec[i64], nuts: Vec[Vec[i64]]) -> i64 {
    let far = |a: ref Vec[i64], b: ref Vec[i64]| (a[0] - b[0]).abs() + (a[1] - b[1]).abs();
    let round_trips: i64 = nuts.iter().map(|n| 2 * far(n, tree)).sum();
    let saving = nuts.iter().map(|n| far(n, tree) - far(n, squirrel)).max().unwrap();
    round_trips - saving
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(name: Str, height: i64, width: i64, tree: Vec[i64], squirrel: Vec[i64], nuts: Vec[Vec[i64]]) {
    println(f"{name}: {min_distance(height, width, tree, squirrel, nuts)}");
}

fn random_cell(height: i64, width: i64, seed: mut ref i64) -> Vec[i64] {
    vec![next_random(mut seed) % height, next_random(mut seed) % width]
}

fn main() {
    // The two LeetCode examples.
    show("example 1", 5, 7, vec![2, 2], vec![4, 4], vec![vec![3, 0], vec![2, 5]]);
    show("example 2", 1, 3, vec![0, 1], vec![0, 0], vec![vec![0, 2]]);
    // The squirrel on a nut; at the tree; a nut at the tree.
    show("squirrel on a nut", 3, 3, vec![0, 0], vec![2, 2], vec![vec![2, 2], vec![0, 2]]);
    show("squirrel at the tree", 3, 3, vec![1, 1], vec![1, 1], vec![vec![0, 0], vec![2, 2]]);
    show("a nut at the tree", 3, 3, vec![1, 1], vec![0, 0], vec![vec![1, 1], vec![2, 2]]);
    // The nearest nut to the squirrel is not the best first one: the
    // nut beyond the squirrel, away from the tree, saves more.
    show("not the nearest", 1, 10, vec![0, 4], vec![0, 2], vec![vec![0, 3], vec![0, 0]]);
    // Every first nut as good as any other: the tree between the
    // squirrel and the nuts.
    show("all alike", 1, 10, vec![0, 5], vec![0, 0], vec![vec![0, 7], vec![0, 9]]);
    // One cell.
    show("one cell", 1, 1, vec![0, 0], vec![0, 0], vec![vec![0, 0]]);
    // 300 random cases: a grid of 1 to 10 by 1 to 10 and 1 to 8 nuts.
    let mut seed: i64 = 573;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let height = 1 + next_random(mut seed) % 10;
        let width = 1 + next_random(mut seed) % 10;
        let tree = random_cell(height, width, mut seed);
        let squirrel = random_cell(height, width, mut seed);
        let mut nuts: Vec[Vec[i64]] = Vec.new();
        for _ in 0..1 + next_random(mut seed) % 8 {
            nuts.push(random_cell(height, width, mut seed));
        }
        let got = min_distance(height, width, tree, squirrel, nuts);
        total += got;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"300 random cases: {total} steps, checksum {checksum}");
    // The problem's largest: a 100 by 100 grid and 5,000 nuts, at random,
    // then all in the corner farthest from the tree with the squirrel in
    // the opposite one.
    let tree = random_cell(100, 100, mut seed);
    let squirrel = random_cell(100, 100, mut seed);
    let mut nuts: Vec[Vec[i64]] = Vec.new();
    for _ in 0..5000 {
        nuts.push(random_cell(100, 100, mut seed));
    }
    println(f"100 by 100, 5000 nuts at random: {min_distance(100, 100, tree, squirrel, nuts)}");
    let mut corner: Vec[Vec[i64]] = Vec.new();
    for i in 0..5000 {
        corner.push(vec![99 - i % 10, 99 - i / 10 % 10]);
    }
    show("100 by 100, 5000 nuts in a corner", 100, 100, vec![0, 0], vec![0, 99], corner);
}
