// Benchmark for #545: Boundary of Binary Tree -- the ★ arm (three
// walks).
//
// The root, the left boundary down from its left child, every leaf from
// left to right, then the right boundary read bottom up, a walk for
// each part. O(n) time.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn is_leaf(n: TreeNode) -> bool {
    n.left.is_none() and n.right.is_none()
}

fn leaves(node: Option[TreeNode], out: mut ref Vec[i64]) {
    if let Some(n) = node {
        if is_leaf(n) {
            out.push(n.val);
        } else {
            leaves(n.left, mut out);
            leaves(n.right, mut out);
        }
    }
}

fn boundary_of_binary_tree(root: Option[TreeNode]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let Some(r) = root else {
        return out;
    };
    out.push(r.val);
    if is_leaf(r) {
        return out;
    }
    let mut node = r.left;
    while let Some(n) = node {
        if is_leaf(n) {
            break;
        }
        out.push(n.val);
        node = if n.left.is_some() { n.left } else { n.right };
    }
    leaves(r.left, mut out);
    leaves(r.right, mut out);
    let mut right: Vec[i64] = Vec.new();
    let mut node = r.right;
    while let Some(n) = node {
        if is_leaf(n) {
            break;
        }
        right.push(n.val);
        node = if n.right.is_some() { n.right } else { n.left };
    }
    for v in right.iter().rev() {
        out.push(*v);
    }
    out
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 random trees of 10,000 nodes (the problem's most) with values
    // from -1,000 to 1,000, each new node walking down from the root and
    // going left with chance 50 to 88 in 100, built once, the nodes kept
    // in the order they were added. Then 200 times over every tree the
    // subtree at one of its first 16 nodes, picked by the round and the
    // tree, is answered; every value on the boundary goes into the
    // checksum.
    let trees = 20;
    let mut seed: i64 = 545;
    let mut all: Vec[Vec[TreeNode]] = Vec.new();
    for g in 0..trees {
        let lean = 50 + 2 * g;
        let root = TreeNode { val: next_random(mut seed) % 2001 - 1000, left: None, right: None };
        let mut nodes: Vec[TreeNode] = vec![root];
        for _ in 1..10000 {
            let c = TreeNode { val: next_random(mut seed) % 2001 - 1000, left: None, right: None };
            let mut node = root;
            loop {
                if next_random(mut seed) % 100 < lean {
                    match node.left {
                        Some(l) => node = l,
                        None => {
                            node.left = Some(c);
                            break;
                        }
                    }
                } else {
                    match node.right {
                        Some(r) => node = r,
                        None => {
                            node.right = Some(c);
                            break;
                        }
                    }
                }
            }
            nodes.push(c);
        }
        all.push(nodes);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for r in 0..200 {
        for t in 0..trees {
            let k = (r * 37 + t * 11) % 16;
            let b = boundary_of_binary_tree(Some(all[t][k]));
            total += b.len();
            for v in b.iter() {
                checksum = (checksum * 31 + *v + 1001) % 1000000007;
            }
        }
    }
    println(f"{trees} trees, 200 times each: {total} on the boundary, checksum {checksum}");
}
