// LeetCode #545: Boundary of Binary Tree -- three walks.
//
// The boundary is the root, then the left boundary down from the root's
// left child (each step to the left child when there is one, else to the
// right, stopping before the leaf it ends at), then every leaf from left
// to right, then the right boundary, the mirror walk from the root's
// right child, read bottom up. A walk for each part. O(n) time.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn is_leaf(n: TreeNode) -> bool {
    n.left.is_none() and n.right.is_none()
}

fn leaves(node: Option[TreeNode], out: mut ref Vec[i64]) {
    if let Some(n) = node {
        if is_leaf(n) {
            out.push(n.val);
        } else {
            leaves(n.left, out);
            leaves(n.right, out);
        }
    }
}

fn boundary_of_binary_tree(root: Option[TreeNode]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let Some(r) = root else {
        return out;
    };
    out.push(r.val);
    if is_leaf(r) {
        return out;
    }
    let mut node = r.left;
    while let Some(n) = node {
        if is_leaf(n) {
            break;
        }
        out.push(n.val);
        node = if n.left.is_some() { n.left } else { n.right };
    }
    leaves(r.left, mut out);
    leaves(r.right, mut out);
    let mut right: Vec[i64] = Vec.new();
    let mut node = r.right;
    while let Some(n) = node {
        if is_leaf(n) {
            break;
        }
        right.push(n.val);
        node = if n.right.is_some() { n.right } else { n.left };
    }
    for v in right.iter().rev() {
        out.push(*v);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// A tree from LeetCode's level order: `None` for a missing child.
fn from_level(values: Vec[Option[i64]]) -> Option[TreeNode] {
    if values.is_empty() or values[0].is_none() {
        return None;
    }
    let root = leaf(values[0].unwrap());
    let mut queue: Vec[TreeNode] = vec![root];
    let mut head = 0;
    let mut i = 1;
    while i < values.len() {
        let n = queue[head];
        head += 1;
        if let Some(v) = values[i] {
            let c = leaf(v);
            n.left = Some(c);
            queue.push(c);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let c = leaf(v);
                n.right = Some(c);
                queue.push(c);
            }
            i += 1;
        }
    }
    Some(root)
}

// A tree of `size` nodes with values from -1000 to 1000: each new node
// walks down from the root, going left with chance lean / 100, and takes
// the first empty place it meets.
fn random_tree(size: i64, lean: i64, seed: mut ref i64) -> Option[TreeNode] {
    let root = leaf(next_random(seed) % 2001 - 1000);
    for _ in 1..size {
        let c = leaf(next_random(seed) % 2001 - 1000);
        let mut node = root;
        loop {
            if next_random(seed) % 100 < lean {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(c);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(c);
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

fn written(values: Vec[Option[i64]]) -> String {
    let parts: Vec[String] = values.iter().map(|v| match v {
        Some(x) => f"{x}",
        None => "null".to_string(),
    }).collect();
    f"[{parts.join(",")}]"
}

fn mix(h: i64, vals: Vec[i64]) -> i64 {
    let mut h = h;
    for v in vals.iter() {
        h = (h * 31 + *v + 1001) % 1000000007;
    }
    h
}

fn show(name: Str, values: Vec[Option[i64]]) {
    let b = boundary_of_binary_tree(from_level(values));
    println(f"{name}: {written(values)} -> {b}");
}

fn summary(name: Str, root: Option[TreeNode]) {
    let b = boundary_of_binary_tree(root);
    println(f"{name}: {b.len()} on the boundary, first {b[0]}, last {b[b.len() - 1]}, checksum {mix(0, b)}");
}

fn main() {
    let mut seed: i64 = 545;
    show("example 1", vec![Some(1), None, Some(2), Some(3), Some(4)]);
    show("example 2", vec![Some(1), Some(2), Some(3), Some(4), Some(5), Some(6), None, None, None, Some(7), Some(8), Some(9), Some(10)]);
    show("one node", vec![Some(7)]);
    show("only a left child", vec![Some(1), Some(2)]);
    show("only a right child", vec![Some(1), None, Some(2)]);
    show("a left chain", vec![Some(1), Some(2), None, Some(3), None, Some(4)]);
    show("a zigzag on the left", vec![Some(1), Some(2), Some(3), None, Some(4), None, None, Some(5), Some(6)]);
    show("a zigzag on the right", vec![Some(1), Some(2), Some(3), None, None, Some(4), None, None, Some(5)]);
    show("a full tree of three levels", vec![Some(-1), Some(-2), Some(-3), Some(-4), Some(-5), Some(-6), Some(-7)]);
    // 300 random trees of 1 to 80 nodes, leaning left with chance 50,
    // 80 or 95 in 100 in turn.
    let count = 300;
    let mut nodes = 0;
    let mut total = 0;
    let mut h: i64 = 0;
    for t in 0..count {
        let size = 1 + next_random(mut seed) % 80;
        let lean = if t % 3 == 0 { 50 } else if t % 3 == 1 { 80 } else { 95 };
        let b = boundary_of_binary_tree(random_tree(size, lean, mut seed));
        nodes += size;
        total += b.len();
        h = mix(h, b);
    }
    println(f"{count} random trees: {nodes} nodes, {total} on the boundary, checksum {h}");
    // The largest, 10,000 nodes (the problem's most): a random tree, a
    // chain down the left, a chain down the right, and a complete tree.
    summary("10000 nodes at random", random_tree(10000, 50, mut seed));
    let top = leaf(0);
    let mut last = top;
    for v in 1..10000 {
        let c = leaf(v % 2001 - 1000);
        last.left = Some(c);
        last = c;
    }
    summary("10000 nodes down the left", Some(top));
    let top = leaf(0);
    let mut last = top;
    for v in 1..10000 {
        let c = leaf(v % 2001 - 1000);
        last.right = Some(c);
        last = c;
    }
    summary("10000 nodes down the right", Some(top));
    let mut values: Vec[Option[i64]] = Vec.new();
    for v in 0..10000 {
        values.push(Some(v % 2001 - 1000));
    }
    summary("a complete tree of 10000 nodes", from_level(values));
}
