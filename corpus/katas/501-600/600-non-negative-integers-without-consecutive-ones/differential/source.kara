// LeetCode #600: differential -- the four arms against the definition.
//
// Copies of the four arms, each held to five properties on random
// numbers.

// ---- star arm ----------------------------------------------------------

fn find_integers_star(n: i64) -> i64 {
    let mut fib: Vec[i64] = vec![1, 2];
    for k in 2..32 {
        fib.push(fib[k - 1] + fib[k - 2]);
    }
    let mut count = 0;
    let mut previous = false;
    let mut k = 31;
    while k >= 0 {
        if (n >> k) & 1 == 1 {
            count += fib[k];
            if previous {
                return count;
            }
            previous = true;
        } else {
            previous = false;
        }
        k -= 1;
    }
    count + 1
}

// ---- grow arm ----------------------------------------------------------

fn find_integers_grow(n: i64) -> i64 {
    let mut count = 1;
    let mut stack: Vec[i64] = vec![1];
    while let Some(x) = stack.pop() {
        if x > n {
            continue;
        }
        count += 1;
        stack.push(x * 2);
        if x % 2 == 0 {
            stack.push(x * 2 + 1);
        }
    }
    count
}

// ---- memo arm ----------------------------------------------------------

fn count_from_memo(bits: Vec[i64], at: i64, last_one: bool, tight: bool, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if at == bits.len() {
        return 1;
    }
    let last = if last_one { 1 } else { 0 };
    if not tight and memo[at][last] >= 0 {
        return memo[at][last];
    }
    let top = if tight { bits[at] } else { 1 };
    let mut total = 0;
    for b in 0..(top + 1) {
        if b == 1 and last_one {
            continue;
        }
        total += count_from_memo(bits, at + 1, b == 1, tight and b == top, mut memo);
    }
    if not tight {
        memo[at][last] = total;
    }
    total
}

fn find_integers_memo(n: i64) -> i64 {
    let mut bits: Vec[i64] = Vec.new();
    let mut m = n;
    while m > 0 {
        bits.push(m % 2);
        m = m / 2;
    }
    bits.reverse();
    let mut memo = vec![vec![-1; 2]; bits.len()];
    count_from_memo(bits, 0, false, true, mut memo)
}

// ---- table arm ---------------------------------------------------------

fn find_integers_table(n: i64) -> i64 {
    let mut ending0: Vec[i64] = vec![1, 1];
    let mut ending1: Vec[i64] = vec![0, 1];
    for k in 2..33 {
        ending0.push(ending0[k - 1] + ending1[k - 1]);
        ending1.push(ending0[k - 1]);
    }
    let mut count = 0;
    let mut prefix_ok = true;
    let mut above = 0;
    for k in (0..32).rev() {
        let bit = (n >> k) & 1;
        if bit == 1 and prefix_ok {
            count += ending0[k] + ending1[k];
        }
        if bit == 1 and above == 1 {
            prefix_ok = false;
        }
        above = bit;
    }
    if prefix_ok {
        count += 1;
    }
    count
}

// ---- the definition and the properties --------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(which: i64, n: i64) -> i64 {
    if which == 0 {
        find_integers_star(n)
    } else if which == 1 {
        find_integers_grow(n)
    } else if which == 2 {
        find_integers_memo(n)
    } else {
        find_integers_table(n)
    }
}

// Whether k's binary digits, read off by halving, hold two ones side by
// side.
fn has_two_ones(k: i64) -> bool {
    let mut m = k;
    let mut last = 0;
    while m > 0 {
        let digit = m % 2;
        if digit == 1 and last == 1 {
            return true;
        }
        last = digit;
        m = m / 2;
    }
    false
}

fn main() {
    let count = 1000;
    let limit = 4096;
    // The definition: every integer from 0 to n tested and counted, kept
    // as running counts up to the limit.
    let mut upto: Vec[i64] = Vec.new();
    let mut running = 0;
    for k in 0..(limit + 1) {
        if not has_two_ones(k) {
            running += 1;
        }
        upto.push(running);
    }
    let mut seed: i64 = 6000;
    let mut checks = 0;
    let mut bad = 0;
    let mut failures = vec![0; 5];
    for _ in 0..count {
        // n from 4 to the limit, so that two halvings stay at least 1.
        let n = 4 + step(mut seed) % (limit - 3);
        if has_two_ones(n) {
            bad += 1;
        }
        let mut top = 1;
        while top * 2 <= n {
            top = top * 2;
        }
        for which in 0..4 {
            let got = answer(which, n);
            let step_up = got - answer(which, n - 1);
            let ok = vec![
                // P1: the definition's answer.
                got == upto[n],
                // P2: the count goes up by one from n - 1 exactly when n
                // has no two ones together.
                step_up == (if has_two_ones(n) { 0 } else { 1 }),
                // P3: the numbers below n's top bit, plus those from the
                // top bit up, which must have a 0 next and are free below.
                got == answer(which, top - 1) + answer(which, min(n - top, top / 2 - 1)),
                // P4: up to 2n + 1, the even numbers are the free ones up
                // to n doubled, and the odd ones the free even ones up to
                // n, doubled with a 1 after.
                answer(which, 2 * n + 1) == got + answer(which, n / 2),
                // P5: up to a run of ones, the counts follow Fibonacci.
                answer(which, 2 * top - 1) == answer(which, top - 1) + answer(which, top / 2 - 1),
            ];
            for p in 0..5 {
                checks += 1;
                if not ok[p] {
                    failures[p] += 1;
                }
            }
        }
    }
    let total = failures[0] + failures[1] + failures[2] + failures[3] + failures[4];
    println(f"{count} cases ({bad} with two ones together), 4 arms, {checks} checks, {total} failures");
    if total > 0 {
        println(f"by property: P1 {failures[0]}, P2 {failures[1]}, P3 {failures[2]}, P4 {failures[3]}, P5 {failures[4]}");
    }
}
