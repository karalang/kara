// Benchmark for #566: Reshape the Matrix -- the ★ arm (index
// arithmetic).
//
// Reading both matrices in row-major order, the k-th value of the
// reshaped matrix is the k-th of the original: row k / c, column k % c
// in the new one, row k / n, column k % n in the old. When the counts
// differ the original is returned. O(m * n) time.

fn matrix_reshape(mat: Vec[Vec[i64]], r: i64, c: i64) -> Vec[Vec[i64]] {
    let m = mat.len();
    let n = mat[0].len();
    if m * n != r * c {
        return mat.clone();
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    for i in 0..r {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..c {
            let k = i * c + j;
            row.push(mat[k / n][k % n]);
        }
        out.push(row);
    }
    out
}

// ---- benchmark --------------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 random matrices of 100 by 100 (the problem's most) built once.
    // Then 800 times over, every matrix is reshaped to the next of ten
    // shapes in turn: nine with 10,000 cells, from 1 by 10000 to 10000
    // by 1, and one that does not fit, which gives back a copy.
    let count = 20;
    let rounds = 800;
    let shapes = vec![(1, 10000), (4, 2500), (25, 400), (50, 200), (100, 100), (200, 50), (400, 25), (2500, 4), (10000, 1), (99, 101)];
    let mut seed: i64 = 566;
    let mut mats: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        let mut mat: Vec[Vec[i64]] = Vec.new();
        for _ in 0..100 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..100 {
                row.push(step(mut seed) % 2001 - 1000);
            }
            mat.push(row);
        }
        mats.push(mat);
    }
    let mut cells = 0;
    let mut checksum: i64 = 0;
    for round in 0..rounds {
        for g in 0..count {
            let (r, c) = shapes[(round + g) % 10];
            let got = matrix_reshape(mats[(round * 7 + g) % count], r, c);
            let rows = got.len();
            let cols = got[0].len();
            cells += rows * cols;
            checksum = (checksum * 31 + got[round % rows][g % cols] + 1000) % 1000000007;
        }
    }
    println(f"{count} matrices of 100 by 100, {rounds} rounds: {cells} cells, checksum {checksum}");
}
