// LeetCode #588: differential -- the four arms against the definition.
//
// Copies of the four arms, each held to five properties on random
// scripts of commands.

// ---- star arm ----------------------------------------------------------

shared struct Node_star {
    mut is_file: bool,
    mut content: String,
    mut children: SortedMap[String, Node_star],
}

fn new_node_star() -> Node_star {
    Node_star { is_file: false, content: String.new(), children: SortedMap.new() }
}

struct FileSystem_star {
    root: Node_star,
}

impl FileSystem_star {
    fn new() -> FileSystem_star {
        FileSystem_star { root: new_node_star() }
    }

    // The node at `path`, made along the way where missing when `make_star`
    // is set.
    fn walk(self, path: Str, make_star: bool) -> Node_star {
        let mut node = self.root;
        for name in path.split("/") {
            if name.is_empty() {
                continue;
            }
            if make_star and not node.children.contains_key(name) {
                node.children.insert(name.to_string(), new_node_star());
            }
            node = node.children[name];
        }
        node
    }

    fn ls(self, path: Str) -> Vec[String] {
        let node = self.walk(path, false);
        if node.is_file {
            return vec![path.split("/").last().unwrap().to_string()];
        }
        let mut names: Vec[String] = Vec.new();
        for name in node.children.keys() {
            names.push(name.clone());
        }
        names
    }

    fn mkdir(mut ref self, path: Str) {
        self.walk(path, true);
    }

    fn add_content_to_file(mut ref self, file_path: Str, content: Str) {
        let node = self.walk(file_path, true);
        node.is_file = true;
        node.content.push_str(content);
    }

    fn read_content_from_file(self, file_path: Str) -> String {
        self.walk(file_path, false).content.clone()
    }
}

fn run_all_star(commands: ref Vec[Op]) -> Vec[String] {
    let mut fs = FileSystem_star.new();
    let mut printed: Vec[String] = Vec.new();
    for command in commands.iter() {
        match command {
            Op.Ls(path) => printed.push(f"[{fs.ls(path).join(" ")}]"),
            Op.Mkdir(path) => fs.mkdir(path),
            Op.Add(path, content) => fs.add_content_to_file(path, content),
            Op.Read(path) => printed.push(fs.read_content_from_file(path)),
        }
    }
    printed
}

// ---- owned arm ---------------------------------------------------------

struct Node_owned {
    is_file: bool,
    content: String,
    children: SortedMap[String, Node_owned],
}

fn new_node_owned() -> Node_owned {
    Node_owned { is_file: false, content: String.new(), children: SortedMap.new() }
}

// Makes every directory along `names` below `node`, and adds `content`
// to the last one when it is given, which makes that one a file.
fn make_owned(node: mut ref Node_owned, names: Slice[Str], content: Option[Str]) {
    if names.is_empty() {
        if let Some(text) = content {
            node.is_file = true;
            node.content.push_str(text);
        }
        return;
    }
    let child = node.children.entry(names[0].to_string()).or_insert(new_node_owned());
    make_owned(mut child, names[1..], content);
}

fn names_of_owned(path: Str) -> Vec[Str] {
    let mut names: Vec[Str] = Vec.new();
    for name in path.split("/") {
        if not name.is_empty() {
            names.push(name);
        }
    }
    names
}

struct FileSystem_owned {
    root: Node_owned,
}

impl FileSystem_owned {
    fn new() -> FileSystem_owned {
        FileSystem_owned { root: new_node_owned() }
    }

    fn find(self, path: Str) -> ref Node_owned {
        let mut node = ref self.root;
        for name in path.split("/") {
            if not name.is_empty() {
                node = ref node.children[name];
            }
        }
        node
    }

    fn ls(self, path: Str) -> Vec[String] {
        let node = self.find(path);
        if node.is_file {
            return vec![path.split("/").last().unwrap().to_string()];
        }
        node.children.keys().cloned().collect()
    }

    fn mkdir(mut ref self, path: Str) {
        make_owned(mut self.root, names_of_owned(path), None);
    }

    fn add_content_to_file(mut ref self, file_path: Str, content: Str) {
        make_owned(mut self.root, names_of_owned(file_path), Some(content));
    }

    fn read_content_from_file(self, file_path: Str) -> String {
        self.find(file_path).content.clone()
    }
}

fn run_all_owned(commands: ref Vec[Op]) -> Vec[String] {
    let mut fs = FileSystem_owned.new();
    let mut printed: Vec[String] = Vec.new();
    for command in commands.iter() {
        match command {
            Op.Ls(path) => printed.push(f"[{fs.ls(path).join(" ")}]"),
            Op.Mkdir(path) => fs.mkdir(path),
            Op.Add(path, content) => fs.add_content_to_file(path, content),
            Op.Read(path) => printed.push(fs.read_content_from_file(path)),
        }
    }
    printed
}

// ---- flat arm ----------------------------------------------------------

struct FileSystem_flat {
    files: Map[String, String],
    dirs: Set[String],
}

// The full path of every directory above `path`, the root left out.
fn parents_flat(path: Str) -> Vec[String] {
    let mut found: Vec[String] = Vec.new();
    for i in 1..path.len() {
        if path[i..i + 1] == "/" {
            found.push(path[0..i].to_string());
        }
    }
    found
}

impl FileSystem_flat {
    fn new() -> FileSystem_flat {
        FileSystem_flat { files: Map.new(), dirs: Set.new() }
    }

    fn ls(self, path: Str) -> Vec[String] {
        if self.files.contains_key(path) {
            return vec![path.split("/").last().unwrap().to_string()];
        }
        let prefix = if path == "/" { "/".to_string() } else { f"{path}/" };
        let mut names: Vec[String] = Vec.new();
        for full in self.files.keys() {
            if full.starts_with(prefix) and not full[prefix.len()..].contains("/") {
                names.push(full[prefix.len()..].to_string());
            }
        }
        for full in self.dirs.iter() {
            if full.starts_with(prefix) and not full[prefix.len()..].contains("/") {
                names.push(full[prefix.len()..].to_string());
            }
        }
        names.sort();
        names
    }

    fn mkdir(mut ref self, path: Str) {
        for dir in parents_flat(path).into_iter() {
            self.dirs.insert(dir);
        }
        self.dirs.insert(path.to_string());
    }

    fn add_content_to_file(mut ref self, file_path: Str, content: Str) {
        for dir in parents_flat(file_path).into_iter() {
            self.dirs.insert(dir);
        }
        if not self.files.contains_key(file_path) {
            self.files.insert(file_path.to_string(), String.new());
        }
        self.files[file_path.to_string()].push_str(content);
    }

    fn read_content_from_file(self, file_path: Str) -> String {
        self.files[file_path.to_string()].clone()
    }
}

fn run_all_flat(commands: ref Vec[Op]) -> Vec[String] {
    let mut fs = FileSystem_flat.new();
    let mut printed: Vec[String] = Vec.new();
    for command in commands.iter() {
        match command {
            Op.Ls(path) => printed.push(f"[{fs.ls(path).join(" ")}]"),
            Op.Mkdir(path) => fs.mkdir(path),
            Op.Add(path, content) => fs.add_content_to_file(path, content),
            Op.Read(path) => printed.push(fs.read_content_from_file(path)),
        }
    }
    printed
}

// ---- arena arm ---------------------------------------------------------

struct Entry_arena {
    is_file: bool,
    content: String,
    children: SortedMap[String, i64],
}

struct FileSystem_arena {
    entries: Vec[Entry_arena],
}

impl FileSystem_arena {
    fn new() -> FileSystem_arena {
        FileSystem_arena { entries: vec![Entry_arena { is_file: false, content: String.new(), children: SortedMap.new() }] }
    }

    // The index of the entry at `path`, made along the way where
    // missing.
    fn make_arena(mut ref self, path: Str) -> i64 {
        let mut at = 0;
        for name in path.split("/") {
            if name.is_empty() {
                continue;
            }
            if not self.entries[at].children.contains_key(name) {
                let next = self.entries.len();
                self.entries.push(Entry_arena { is_file: false, content: String.new(), children: SortedMap.new() });
                self.entries[at].children.insert(name.to_string(), next);
            }
            at = self.entries[at].children[name];
        }
        at
    }

    fn find(self, path: Str) -> i64 {
        let mut at = 0;
        for name in path.split("/") {
            if not name.is_empty() {
                at = self.entries[at].children[name];
            }
        }
        at
    }

    fn ls(self, path: Str) -> Vec[String] {
        let at = self.find(path);
        if self.entries[at].is_file {
            return vec![path.split("/").last().unwrap().to_string()];
        }
        let mut names: Vec[String] = Vec.new();
        for name in self.entries[at].children.keys() {
            names.push(name.clone());
        }
        names
    }

    fn mkdir(mut ref self, path: Str) {
        self.make_arena(path);
    }

    fn add_content_to_file(mut ref self, file_path: Str, content: Str) {
        let at = self.make_arena(file_path);
        self.entries[at].is_file = true;
        self.entries[at].content.push_str(content);
    }

    fn read_content_from_file(self, file_path: Str) -> String {
        self.entries[self.find(file_path)].content.clone()
    }
}

fn run_all_arena(commands: ref Vec[Op]) -> Vec[String] {
    let mut fs = FileSystem_arena.new();
    let mut printed: Vec[String] = Vec.new();
    for command in commands.iter() {
        match command {
            Op.Ls(path) => printed.push(f"[{fs.ls(path).join(" ")}]"),
            Op.Mkdir(path) => fs.mkdir(path),
            Op.Add(path, content) => fs.add_content_to_file(path, content),
            Op.Read(path) => printed.push(fs.read_content_from_file(path)),
        }
    }
    printed
}

// ---- harness --------------------------------------------------------------

enum Op {
    Ls(String),
    Mkdir(String),
    Add(String, String),
    Read(String),
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// ---- definition -----------------------------------------------------------

// The statement read literally, from the history of every `mkdir` and
// `add` so far: a file's content is everything added to it, in order;
// a path names a file when something was added to it; and a
// directory's entries are the names one level below it on any path
// made, in lexicographic order.
fn definition(commands: ref Vec[Op]) -> Vec[String] {
    let mut history: Vec[(String, String, bool)] = Vec.new();
    let mut printed: Vec[String] = Vec.new();
    for command in commands.iter() {
        match command {
            Op.Mkdir(path) => history.push((path.clone(), String.new(), false)),
            Op.Add(path, content) => history.push((path.clone(), content.clone(), true)),
            Op.Read(path) => {
                let mut content = String.new();
                for h in history.iter() {
                    if h.2 and h.0 == *path {
                        content.push_str(h.1);
                    }
                }
                printed.push(content);
            }
            Op.Ls(path) => {
                let mut is_file = false;
                for h in history.iter() {
                    if h.2 and h.0 == *path {
                        is_file = true;
                    }
                }
                let mut names: Vec[String] = Vec.new();
                if is_file {
                    names.push(path.split("/").last().unwrap().to_string());
                } else {
                    let prefix = if *path == "/" { "/".to_string() } else { f"{path}/" };
                    for h in history.iter() {
                        if h.0.starts_with(prefix) {
                            let rest = h.0[prefix.len()..].to_string();
                            let name = match rest.find("/") {
                                Some(i) => rest[0..i].to_string(),
                                None => rest,
                            };
                            if not names.contains(name) {
                                names.push(name);
                            }
                        }
                    }
                    names.sort();
                }
                printed.push(f"[{names.join(" ")}]");
            }
        }
    }
    printed
}

// A random script, as in the arms' harness.
fn script(count: i64, letters: i64, depth: i64, seed: mut ref i64) -> Vec[Op] {
    let alphabet = "abcdefghij";
    let mut files: Set[String] = Set.new();
    let mut dirs: Set[String] = Set.new();
    let mut made: Vec[String] = vec!["/".to_string()];
    let mut commands: Vec[Op] = Vec.new();
    while commands.len() < count {
        let roll = step(mut seed) % 10;
        if roll < 4 {
            let path = made[step(mut seed) % made.len()].clone();
            if roll < 2 or not files.contains(path) {
                commands.push(Op.Ls(path));
            } else {
                commands.push(Op.Read(path));
            }
            continue;
        }
        let is_file = roll >= 7;
        let length = 1 + step(mut seed) % depth;
        let mut steps: Vec[String] = Vec.new();
        let mut path = String.new();
        let mut ok = true;
        for i in 0..length {
            let k = step(mut seed) % letters;
            path.push_str("/");
            path.push_str(alphabet[k..k + 1]);
            let last = i == length - 1;
            if files.contains(path) and not (last and is_file) {
                ok = false;
            }
            if dirs.contains(path) and last and is_file {
                ok = false;
            }
            steps.push(path.clone());
        }
        if not ok {
            continue;
        }
        if is_file {
            let mut content = String.new();
            for _ in 0..1 + step(mut seed) % 3 {
                let k = step(mut seed) % letters;
                content.push_str(alphabet[k..k + 1]);
            }
            commands.push(Op.Add(path.clone(), content));
        } else {
            commands.push(Op.Mkdir(path.clone()));
        }
        for i in 0..steps.len() {
            let is_new = not files.contains(steps[i]) and not dirs.contains(steps[i]);
            if i == steps.len() - 1 and is_file {
                files.insert(steps[i].clone());
            } else {
                dirs.insert(steps[i].clone());
            }
            if is_new {
                made.push(steps[i].clone());
            }
        }
    }
    commands
}

fn copy_op(command: ref Op) -> Op {
    match command {
        Op.Ls(path) => Op.Ls(path.clone()),
        Op.Mkdir(path) => Op.Mkdir(path.clone()),
        Op.Add(path, content) => Op.Add(path.clone(), content.clone()),
        Op.Read(path) => Op.Read(path.clone()),
    }
}

fn run_arm(arm: i64, commands: ref Vec[Op]) -> Vec[String] {
    match arm {
        0 => run_all_star(commands),
        1 => run_all_owned(commands),
        2 => run_all_flat(commands),
        _ => run_all_arena(commands),
    }
}

fn main() {
    let names = vec!["star", "owned", "flat", "arena"];
    let mut seed: i64 = 5880;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = vec![0, 0, 0, 0, 0];
    for _ in 0..1000 {
        // A script of 1 to 30 commands over two or three names, up to
        // three deep.
        let count = 1 + step(mut seed) % 30;
        let letters = 2 + step(mut seed) % 2;
        let commands = script(count, letters, 3, mut seed);
        let want = definition(commands);
        // Every `mkdir` done twice; every parent of an added file made
        // first; and every content of two or more letters added a
        // letter at a time.
        let mut twice: Vec[Op] = Vec.new();
        let mut parents_first: Vec[Op] = Vec.new();
        let mut by_letter: Vec[Op] = Vec.new();
        for command in commands.iter() {
            twice.push(copy_op(command));
            parents_first.push(copy_op(command));
            by_letter.push(copy_op(command));
            match command {
                Op.Mkdir(path) => twice.push(Op.Mkdir(path.clone())),
                Op.Add(path, content) => {
                    let slash = path.len() - path.split("/").last().unwrap().len() - 1;
                    if slash > 0 {
                        let last = parents_first.len() - 1;
                        parents_first.insert(last, Op.Mkdir(path[0..slash].to_string()));
                    }
                    if content.len() > 1 {
                        by_letter.pop();
                        for i in 0..content.len() {
                            by_letter.push(Op.Add(path.clone(), content[i..i + 1].to_string()));
                        }
                    }
                }
                _ => {}
            }
        }
        for arm in 0..4 {
            let got = run_arm(arm, commands);
            // P2: one line for each `ls` and `read`, every listing in
            // order with no name twice.
            let mut well_formed = got.len() == want.len();
            for line in got.iter() {
                if line.starts_with("[") {
                    let mut previous = String.new();
                    for name in line[1..line.len() - 1].split(" ") {
                        if not previous.is_empty() and previous >= name.to_string() {
                            well_formed = false;
                        }
                        previous = name.to_string();
                    }
                }
            }
            let results = vec![
                got == want,
                well_formed,
                run_arm(arm, twice) == got,
                run_arm(arm, parents_first) == got,
                run_arm(arm, by_letter) == got,
            ];
            for p in 0..5 {
                checks += 1;
                if not results[p] {
                    failures += 1;
                    by_property[p] += 1;
                    if failures <= 5 {
                        println(f"{names[arm]} P{p + 1}: got {got}, want {want}");
                    }
                }
            }
        }
    }
    println(f"1000 cases, 4 arms, {checks} checks, {failures} failures");
    if failures > 0 {
        println(f"by property: P1 {by_property[0]}, P2 {by_property[1]}, P3 {by_property[2]}, P4 {by_property[3]}, P5 {by_property[4]}");
    }
}
