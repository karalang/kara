// LeetCode #530: Minimum Absolute Difference in BST -- in-order,
// recursively.
//
// An in-order walk of a search tree meets its values in ascending
// order, so the smallest difference between any two values is the
// smallest difference between two met one after the other. Keep the
// value met last and the best difference so far. O(n) time and
// O(height) stack.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

struct Walk {
    prev: Option[i64],
    best: i64,
}

fn visit(node: Option[TreeNode], walk: mut ref Walk) {
    let Some(n) = node else {
        return;
    };
    visit(n.left, mut walk);
    if let Some(p) = walk.prev {
        walk.best = walk.best.min(n.val - p);
    }
    walk.prev = Some(n.val);
    visit(n.right, mut walk);
}

fn get_minimum_difference(root: Option[TreeNode]) -> i64 {
    let mut walk = Walk { prev: None, best: i64.MAX };
    visit(root, mut walk);
    walk.best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A search tree of the values, inserted in the order given: a smaller
// value goes left, a larger one right, and an equal one either way by a
// coin flip from seed, which keeps every value on the left of a node at
// most the node's and every value on its right at least.
fn build(values: Vec[i64], seed: mut ref i64) -> Option[TreeNode] {
    if values.is_empty() {
        return None;
    }
    let root = TreeNode { val: values[0], left: None, right: None };
    for i in 1..values.len() {
        let v = values[i];
        let mut node = root;
        loop {
            if v < node.val or (v == node.val and next_random(mut seed) % 2 == 0) {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(TreeNode { val: v, left: None, right: None });
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(TreeNode { val: v, left: None, right: None });
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

fn show(name: Str, values: Vec[i64], seed: mut ref i64) {
    let root = build(values, mut seed);
    println(f"{name}: {values} -> {get_minimum_difference(root)}");
}

fn main() {
    let mut seed: i64 = 530;
    show("example 1", vec![4, 2, 6, 1, 3], mut seed);
    show("example 2", vec![1, 0, 48, 12, 49], mut seed);
    show("two nodes", vec![0, 100000], mut seed);
    show("equal values", vec![7, 7, 3], mut seed);
    show("rising chain", vec![1, 3, 6, 10, 15], mut seed);
    show("falling chain", vec![100, 50, 20, 5], mut seed);
    show("closest across the root", vec![50, 20, 80, 45, 56], mut seed);
    // 300 random trees of 2 to 60 values from 0 to 9, 0 to 999, or the
    // whole range 0 to 100,000, in turn.
    let count = 300;
    let mut total = 0;
    let mut zeros = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let range = if t % 3 == 0 { 10 } else if t % 3 == 1 { 1000 } else { 100001 };
        let size = 2 + next_random(mut seed) % 59;
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..size {
            values.push((next_random(mut seed) * 32768 + next_random(mut seed)) % range);
        }
        total += size;
        let answer = get_minimum_difference(build(values, mut seed));
        if answer == 0 {
            zeros += 1;
        }
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"{count} random trees: {total} values, {zeros} with a repeat, checksum {checksum}");
    // The largest: 10,000 values (the problem's most) spread out by 10
    // from 0 to 99,990, except that 50,000 is moved up to 50,007, 3 short
    // of the next; inserted in a random order.
    let mut values: Vec[i64] = Vec.new();
    for i in 0..10000 {
        values.push(i * 10);
    }
    values[5000] = 50007;
    for i in (1..10000).rev() {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        values.swap(i, j);
    }
    println(f"10000 values: {get_minimum_difference(build(values, mut seed))}");
}
