// LeetCode #506: Relative Ranks -- a bucket for every score.
//
// The scores are whole numbers from 0 to 10^6, all different, so a Vec
// indexed by score can hold who scored it. Walk it from the highest
// score down; each athlete found takes the next place. O(n + max score)
// time and space.

fn find_relative_ranks(score: Vec[i64]) -> Vec[String] {
    let n = score.len();
    let top = *score.iter().max().unwrap();
    // who[s] is 1 + the index of the athlete who scored s, or 0.
    let mut who = vec![0; top + 1];
    for i in 0..n {
        who[score[i]] = i + 1;
    }
    let medals = ["Gold Medal", "Silver Medal", "Bronze Medal"];
    let mut answer: Vec[String] = vec![String.new(); n];
    let mut place = 0;
    let mut s = top;
    while s >= 0 {
        if who[s] != 0 {
            answer[who[s] - 1] = if place < 3 { medals[place].to_string() } else { f"{place + 1}" };
            place += 1;
        }
        s -= 1;
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(name: String, score: Vec[i64]) {
    println(f"{name}: {score} -> {find_relative_ranks(score)}");
}

fn main() {
    show("example 1", vec![5, 4, 3, 2, 1]);
    show("example 2", vec![10, 3, 8, 9, 4]);
    show("one athlete", vec![7]);
    show("two", vec![1, 2]);
    show("rising", vec![1, 2, 3, 4, 5, 6]);
    show("the extremes", vec![0, 1000000, 500000, 999999]);
    // 300 random lists of 1 to 30 different scores: the j-th of n is
    // j * spread plus less than spread, shuffled, with spread 3, 1,000
    // or 33,000 in turn.
    let count = 300;
    let mut seed: i64 = 506;
    let mut athletes = 0;
    let mut checksum: i64 = 0;
    for c in 0..count {
        let n = 1 + next_random(mut seed) % 30;
        let spread = if c % 3 == 0 { 3 } else if c % 3 == 1 { 1000 } else { 33000 };
        let mut score: Vec[i64] = Vec.new();
        for j in 0..n {
            score.push(j * spread + next_random(mut seed) % spread);
        }
        let mut k = n - 1;
        while k > 0 {
            score.swap(k, next_random(mut seed) % (k + 1));
            k -= 1;
        }
        for rank in find_relative_ranks(score) {
            athletes += 1;
            for ch in rank.chars() {
                let code: i64 = ch as i32;
                checksum = (checksum * 31 + code) % 1000000007;
            }
        }
    }
    println(f"{count} random lists: {athletes} athletes, checksum {checksum}");
}
