// Benchmark for LeetCode #521: Longest Uncommon Subsequence I -- the ★
// arm (the whole longer word); see ../find_lus_length.kara.

fn find_lus_length(a: Str, b: Str) -> i64 {
    if a == b { -1 } else { a.len().max(b.len()) }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random word of `len` letters from the first `letters` of the
// alphabet.
fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..len {
        word.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    word
}

// 20,000 pairs of 1 to 100 letters from 1 to 3 letters made once (a
// third equal, a third the first word with a letter added, a third
// unrelated), then every pair answered in each of 5,000 rounds.
fn main() {
    let mut seed: i64 = 521;
    let mut firsts: Vec[String] = Vec.new();
    let mut seconds: Vec[String] = Vec.new();
    for i in 0..20000 {
        let letters = 1 + next_random(mut seed) % 3;
        let a = random_word(mut seed, 1 + next_random(mut seed) % 100, letters);
        let b = if i % 3 == 0 {
            a.clone()
        } else if i % 3 == 1 {
            let mut c = a.clone();
            c.push((97 + next_random(mut seed) % letters) as u8 as char);
            c
        } else {
            random_word(mut seed, 1 + next_random(mut seed) % 100, letters)
        };
        firsts.push(a);
        seconds.push(b);
    }
    let mut total = 0;
    let mut checksum = 0;
    for round in 0..5000 {
        for i in 0..firsts.len() {
            let n = find_lus_length(firsts[i], seconds[i]);
            total += n;
            checksum = (checksum + (round + 1) * (n + 2)) % 1000000007;
        }
    }
    println(f"20000 pairs, 5000 rounds: total {total}, checksum {checksum}");
}
