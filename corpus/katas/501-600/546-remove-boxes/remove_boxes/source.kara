// LeetCode #546: Remove Boxes -- memoized, with the boxes carried along.
//
// best(l, r, k) is the most points from boxes l to r when k more boxes
// of the colour of box l sit just before it, waiting to go with it. Box
// l's run (and its k) either goes now, or waits for a later box m of the
// same colour, the boxes between l and m going first on their own. The
// table is n * n * n, filled on demand. O(n^4) time.

fn best(boxes: Vec[i64], l: i64, r: i64, k: i64, memo: mut ref Vec[i64]) -> i64 {
    if l > r {
        return 0;
    }
    let n = boxes.len();
    let key = (l * n + r) * n + k;
    if memo[key] >= 0 {
        return memo[key];
    }
    // Take in the rest of box l's run, so the choices start at its end.
    let mut i = l;
    let mut run = k + 1;
    while i < r and boxes[i + 1] == boxes[l] {
        i += 1;
        run += 1;
    }
    let mut most = run * run + best(boxes, i + 1, r, 0, mut memo);
    for m in i + 2..r + 1 {
        if boxes[m] == boxes[l] and boxes[m - 1] != boxes[l] {
            most = most.max(best(boxes, i + 1, m - 1, 0, mut memo) + best(boxes, m, r, run, mut memo));
        }
    }
    memo[key] = most;
    most
}

fn remove_boxes(boxes: Vec[i64]) -> i64 {
    let n = boxes.len();
    let mut memo = vec![-1; n * n * n];
    best(boxes, 0, n - 1, 0, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(name: Str, boxes: Vec[i64]) {
    println(f"{name}: {boxes} -> {remove_boxes(boxes)}");
}

fn main() {
    let mut seed: i64 = 546;
    show("example 1", vec![1, 3, 2, 2, 2, 3, 4, 3, 1]);
    show("example 2", vec![1, 1, 1]);
    show("example 3", vec![1]);
    show("two colours alternating", vec![1, 2, 1, 2, 1, 2, 1]);
    show("a nest", vec![1, 2, 3, 2, 1]);
    show("worth waiting for", vec![1, 2, 2, 1, 1, 3, 1]);
    // 300 random rows of 1 to 20 boxes, from 3, 5 or 10 colours in turn.
    let count = 300;
    let mut boxes_in = 0;
    let mut total = 0;
    let mut h: i64 = 0;
    for t in 0..count {
        let n = 1 + next_random(mut seed) % 20;
        let colours = if t % 3 == 0 { 3 } else if t % 3 == 1 { 5 } else { 10 };
        let mut b: Vec[i64] = Vec.new();
        for _ in 0..n {
            b.push(1 + next_random(mut seed) % colours);
        }
        let points = remove_boxes(b);
        boxes_in += n;
        total += points;
        h = (h * 31 + points) % 1000000007;
    }
    println(f"{count} random rows: {boxes_in} boxes, {total} points, checksum {h}");
    // The largest, 100 boxes (the problem's most): random from 3 and
    // from 100 colours, one colour, two alternating, and a palindrome of
    // 50 colours.
    let mut b: Vec[i64] = Vec.new();
    for _ in 0..100 {
        b.push(1 + next_random(mut seed) % 3);
    }
    println(f"100 boxes from 3 colours: {remove_boxes(b)}");
    let mut b: Vec[i64] = Vec.new();
    for _ in 0..100 {
        b.push(1 + next_random(mut seed) % 100);
    }
    println(f"100 boxes from 100 colours: {remove_boxes(b)}");
    println(f"100 boxes of one colour: {remove_boxes(vec![7; 100])}");
    let mut b: Vec[i64] = Vec.new();
    for i in 0..100 {
        b.push(1 + i % 2);
    }
    println(f"100 boxes, two colours alternating: {remove_boxes(b)}");
    let mut b: Vec[i64] = Vec.new();
    for i in 0..50 {
        b.push(1 + i);
    }
    for i in 0..50 {
        b.push(50 - i);
    }
    println(f"a palindrome of 50 colours: {remove_boxes(b)}");
}
