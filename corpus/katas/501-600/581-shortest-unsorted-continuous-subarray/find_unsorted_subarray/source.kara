// LeetCode #581: Shortest Unsorted Continuous Subarray -- two sweeps.
//
// Walking left to right with the largest value so far, the last place
// where a value is below that largest must be inside the subarray, and
// everything after it is already in place: that is the end. Walking
// right to left with the smallest so far gives the start the same way.
// O(n) time, O(1) space.

fn find_unsorted_subarray(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut largest = nums[0];
    let mut end = -1;
    for i in 1..n {
        if nums[i] < largest {
            end = i;
        } else {
            largest = nums[i];
        }
    }
    let mut smallest = nums[n - 1];
    let mut start = 0;
    for i in (0..n - 1).rev() {
        if nums[i] > smallest {
            start = i;
        } else {
            smallest = nums[i];
        }
    }
    if end == -1 {
        0
    } else {
        end - start + 1
    }
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums}: {find_unsorted_subarray(nums)}");
}

fn main() {
    // The three LeetCode examples.
    show(vec![2, 6, 4, 8, 10, 9, 15]);
    show(vec![1, 2, 3, 4]);
    show(vec![1]);
    // Two values out of order; all equal; falling; the ends of the range.
    show(vec![2, 1]);
    show(vec![5, 5, 5, 5]);
    show(vec![5, 4, 3, 2, 1]);
    show(vec![100000, -100000]);
    // Equal values at the edge of the subarray, inside it and outside it.
    show(vec![1, 3, 2, 2, 2]);
    show(vec![1, 2, 3, 3, 3, 2]);
    show(vec![2, 2, 1, 2, 2]);
    // A small value late pulls the start to the front; a large one early
    // pushes the end to the back.
    show(vec![1, 2, 3, 4, 5, 0, 6]);
    show(vec![1, 9, 2, 3, 4, 5, 6]);
    // 300 random arrays of 1 to 30: sorted and then 0 to 3 pairs swapped,
    // over a range small enough to give equal values.
    let mut seed: i64 = 581;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let n = 1 + step(mut seed) % 30;
        let span = 1 + step(mut seed) % 40;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(step(mut seed) % span - span / 2);
        }
        nums.sort();
        let swaps = step(mut seed) % 4;
        for _ in 0..swaps {
            let i = step(mut seed) % n;
            let j = step(mut seed) % n;
            nums.swap(i, j);
        }
        let got = find_unsorted_subarray(nums);
        total += got;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"300 random arrays: total {total}, checksum {checksum}");
    // The problem's largest, 10,000 values: in order but for the two
    // ends swapped, in order but for two neighbours in the middle, and
    // falling.
    let mut ends: Vec[i64] = Vec.new();
    for i in 0..10000 {
        ends.push(i * 20 - 100000);
    }
    ends.swap(0, 9999);
    println(f"10000 values, the ends swapped: {find_unsorted_subarray(ends)}");
    let mut middle: Vec[i64] = Vec.new();
    for i in 0..10000 {
        middle.push(i * 20 - 100000);
    }
    middle.swap(4999, 5000);
    println(f"10000 values, two in the middle swapped: {find_unsorted_subarray(middle)}");
    let mut falling: Vec[i64] = Vec.new();
    for i in 0..10000 {
        falling.push(99999 - i * 20);
    }
    println(f"10000 values falling: {find_unsorted_subarray(falling)}");
}
