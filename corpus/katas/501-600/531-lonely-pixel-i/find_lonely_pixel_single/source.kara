// LeetCode #531: Lonely Pixel I -- each row's single column.
//
// A lonely pixel is in a row with one black pixel, so record for each
// row the column of its black pixel when it has exactly one, and count
// the black pixels of each column. The answer is the number of rows
// whose single column holds one black pixel. O(mn) time and O(m + n)
// space.

fn find_lonely_pixel(picture: Vec[Vec[char]]) -> i64 {
    let n = picture[0].len();
    let mut cols = vec![0; n];
    let mut single: Vec[Option[i64]] = Vec.new();
    for row in picture.iter() {
        let mut found: Option[i64] = None;
        let mut blacks = 0;
        for c in 0..n {
            if row[c] == 'B' {
                cols[c] += 1;
                blacks += 1;
                found = Some(c);
            }
        }
        single.push(if blacks == 1 { found } else { None });
    }
    let mut lonely = 0;
    for s in single.iter() {
        if let Some(c) = *s {
            if cols[c] == 1 {
                lonely += 1;
            }
        }
    }
    lonely
}

// ---- test harness ---------------------------------------------------------

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    let mut picture: Vec[Vec[char]] = Vec.new();
    for row in rows.iter() {
        picture.push(row.chars().collect());
    }
    picture
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random m by n picture with each pixel black with chance `per_mille`
// in 1,000.
fn random_picture(seed: mut ref i64, m: i64, n: i64, per_mille: i64) -> Vec[Vec[char]] {
    let mut picture: Vec[Vec[char]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[char] = Vec.new();
        for _ in 0..n {
            row.push(if next_random(mut seed) % 1000 < per_mille { 'B' } else { 'W' });
        }
        picture.push(row);
    }
    picture
}

fn show(name: Str, rows: Vec[Str]) {
    println(f"{name}: {rows} -> {find_lonely_pixel(parse(rows.clone()))}");
}

fn main() {
    show("example 1", vec!["WWB", "WBW", "BWW"]);
    show("example 2", vec!["BBB", "BBW", "BBB"]);
    show("one black", vec!["B"]);
    show("one white", vec!["W"]);
    show("two in a row", vec!["WBWB", "WWWW", "BWWW"]);
    show("two in a column", vec!["BW", "WW", "BW", "WB"]);
    show("all white", vec!["WWWW", "WWWW", "WWWW"]);
    // 300 random pictures of 1 to 20 by 1 to 20, black with a chance of
    // 2% to 30%.
    let mut seed: i64 = 531;
    let mut total = 0;
    let mut none = 0;
    let mut checksum = 0;
    for _ in 0..300 {
        let m = 1 + next_random(mut seed) % 20;
        let n = 1 + next_random(mut seed) % 20;
        let per_mille = 20 + next_random(mut seed) % 281;
        let answer = find_lonely_pixel(random_picture(mut seed, m, n, per_mille));
        total += answer;
        if answer == 0 {
            none += 1;
        }
        checksum = (checksum * 31 + answer) % 1000000007;
    }
    println(f"300 random pictures: {total} lonely, {none} with none, checksum {checksum}");
    // The largest: 500 by 500, black with a chance of 2 in 1,000.
    println(f"500 by 500: {find_lonely_pixel(random_picture(mut seed, 500, 500, 2))}");
}
