// Benchmark for LeetCode #527: Word Abbreviation -- the ★ arm (grow
// clashing prefixes); see ../words_abbreviation.kara.

// The first `k` letters, how many are left out, and the last letter; the
// word itself when that would not be shorter.
fn abbreviate(word: Str, k: i64) -> String {
    let n = word.len();
    if k >= n - 2 {
        return word.to_string();
    }
    f"{word[0..k]}{n - 1 - k}{word[n - 1..n]}"
}

fn words_abbreviation(words: Vec[String]) -> Vec[String] {
    let n = words.len();
    let mut prefix: Vec[i64] = vec![1; n];
    let mut abbr: Vec[String] = Vec.new();
    for word in words.iter() {
        abbr.push(abbreviate(word, 1));
    }
    for i in 0..n {
        loop {
            let mut clash: Vec[i64] = Vec.new();
            for j in i + 1..n {
                if abbr[j] == abbr[i] {
                    clash.push(j);
                }
            }
            if clash.is_empty() {
                break;
            }
            clash.push(i);
            for j in clash.iter() {
                prefix[*j] += 1;
                abbr[*j] = abbreviate(words[*j], prefix[*j]);
            }
        }
    }
    abbr
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..len {
        word.push((97 + next_random(seed) % letters) as u8 as char);
    }
    word
}

// 20 lists of 400 distinct words (the problem's most) of 8 to 16 letters
// from the first 2 letters made once; then every list abbreviated in
// each of 50 rounds.
fn main() {
    let mut seed: i64 = 527;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..20 {
        let mut seen: Set[String] = Set.new();
        let mut words: Vec[String] = Vec.new();
        while words.len() < 400 {
            let word = random_word(mut seed, 8 + next_random(mut seed) % 9, 2);
            if not seen.contains(word) {
                seen.insert(word.clone());
                words.push(word);
            }
        }
        lists.push(words);
    }
    let mut total = 0;
    let mut checksum = 0;
    for _ in 0..50 {
        for l in 0..lists.len() {
            let abbr = words_abbreviation(lists[l]);
            for a in abbr.iter() {
                total += a.len();
                for b in a.bytes().iter() {
                    checksum = (checksum * 31 + *b as i64) % 1000000007;
                }
            }
        }
    }
    println(f"20 lists of 400 words, 50 rounds: {total} letters, checksum {checksum}");
}
