// Benchmark for #551: Student Attendance Record I -- the ★ arm (one
// pass, two counters).
//
// Walk the record once, counting absences and the length of the current
// run of lates. A second absence or a third late in a row ends the walk
// at once. O(n) time.

fn check_record(s: Str) -> bool {
    let mut absences = 0;
    let mut lates = 0;
    for c in s.chars() {
        if c == 'L' {
            lates += 1;
            if lates == 3 {
                return false;
            }
        } else {
            lates = 0;
            if c == 'A' {
                absences += 1;
                if absences == 2 {
                    return false;
                }
            }
        }
    }
    true
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 1,000 random records of 1,000 days (the problem's most), absent
    // with chance 1 in 2,000 and late with chance 100 in 2,000, built
    // once. Then 300 times over, every record is checked; the answers go
    // into the checksum.
    let count = 1000;
    let mut seed: i64 = 551;
    let mut records: Vec[String] = Vec.new();
    for _ in 0..count {
        let mut s = String.new();
        for _ in 0..1000 {
            let r = next_random(mut seed) % 2000;
            s.push(if r < 1 { 'A' } else if r < 101 { 'L' } else { 'P' });
        }
        records.push(s);
    }
    let mut fine = 0;
    let mut checksum: i64 = 0;
    for round in 0..300 {
        for g in 0..count {
            let bit = if check_record(records[(round * 7 + g) % count]) { 1 } else { 0 };
            fine += bit;
            checksum = (checksum * 31 + bit + g) % 1000000007;
        }
    }
    println(f"{count} records, 300 rounds each: {fine} fine, checksum {checksum}");
}
