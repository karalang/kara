// Benchmark for LeetCode #515: Find Largest Value in Each Tree Row --
// the ★ arm (level by level); see ../largest_values.kara.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn largest_values(root: Option[TreeNode]) -> Vec[i64] {
    let mut largest: Vec[i64] = Vec.new();
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    if let Some(r) = root {
        queue.push_back(r);
    }
    while not queue.is_empty() {
        let mut best = i64.MIN;
        for _ in 0..queue.len() {
            let node = queue.pop_front().unwrap();
            best = best.max(node.val);
            if let Some(l) = node.left {
                queue.push_back(l);
            }
            if let Some(r) = node.right {
                queue.push_back(r);
            }
        }
        largest.push(best);
    }
    largest
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random tree over values[lo..hi]: the root is a random one of them,
// the ones before it the left subtree and the ones after it the right.
fn build(values: Vec[i64], lo: i64, hi: i64, seed: mut ref i64) -> Option[TreeNode] {
    if lo >= hi {
        return None;
    }
    let mid = lo + next_random(mut seed) % (hi - lo);
    let left = build(values, lo, mid, mut seed);
    let right = build(values, mid + 1, hi, mut seed);
    Some(TreeNode { val: values[mid], left: left, right: right })
}

fn main() {
    // 100 random trees of 10,000 nodes (the problem's most), the values
    // from the whole range -2^31 to 2^31 - 1, built once. Then each is
    // solved 50 times.
    let trees = 100;
    let mut seed: i64 = 515;
    let mut all: Vec[TreeNode] = Vec.new();
    for _ in 0..trees {
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..10000 {
            values.push(next_random(mut seed) * 65536 + next_random(mut seed) * 2 + next_random(mut seed) % 2 - 2147483648);
        }
        all.push(build(values, 0, 10000, mut seed).expect("10,000 nodes"));
    }
    let mut rows = 0;
    let mut checksum: i64 = 0;
    for _ in 0..50 {
        for t in 0..trees {
            let largest = largest_values(Some(all[t]));
            rows += largest.len();
            for v in largest.iter() {
                checksum = (checksum * 31 + *v + 2147483648) % 1000000007;
            }
        }
    }
    println(f"{trees} trees of 10000 nodes, 50 times each: {rows} rows, checksum {checksum}");
}
