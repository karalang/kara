// LeetCode #515: Find Largest Value in Each Tree Row -- whole rows.
//
// Each row is a Vec of its nodes; its largest value comes from
// `iter().map(...).max()`, and the next row is built from its
// children. No queue: a row is replaced by the next one wholesale.
// O(n) time, O(width) space.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn largest_values(root: Option[TreeNode]) -> Vec[i64] {
    let mut largest: Vec[i64] = Vec.new();
    let mut row: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        row.push(r);
    }
    while not row.is_empty() {
        largest.push(row.iter().map(|n| n.val).max().unwrap());
        let mut next: Vec[TreeNode] = Vec.new();
        for node in row.iter() {
            if let Some(l) = node.left {
                next.push(l);
            }
            if let Some(r) = node.right {
                next.push(r);
            }
        }
        row = next;
    }
    largest
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A tree from LeetCode's level order: the values row by row, None for a
// missing child, and nothing listed under a missing node.
// An empty list is the empty tree.
fn from_level_order(items: Vec[Option[i64]]) -> Option[TreeNode] {
    if items.is_empty() {
        return None;
    }
    let root = TreeNode { val: items[0].expect("the tree has a root"), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < items.len() {
        let node = queue.pop_front().unwrap();
        if let Some(v) = items[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < items.len() {
            if let Some(v) = items[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// A value from -half to half, or from the whole range -2^31 to 2^31 - 1
// when half is 0.
fn draw(half: i64, seed: mut ref i64) -> i64 {
    if half == 0 {
        next_random(mut seed) * 65536 + next_random(mut seed) * 2 + next_random(mut seed) % 2 - 2147483648
    } else {
        next_random(mut seed) % (2 * half + 1) - half
    }
}

// A random tree of size nodes: each new node walks down from the root,
// left or right by a coin flip, to the first empty place.
fn grow(size: i64, half: i64, seed: mut ref i64) -> Option[TreeNode] {
    if size == 0 {
        return None;
    }
    let root = TreeNode { val: draw(half, mut seed), left: None, right: None };
    for _ in 1..size {
        let leaf = TreeNode { val: draw(half, mut seed), left: None, right: None };
        let mut node = root;
        loop {
            if next_random(mut seed) % 2 == 0 {
                match node.left {
                    Some(l) => node = l,
                    None => {
                        node.left = Some(leaf);
                        break;
                    }
                }
            } else {
                match node.right {
                    Some(r) => node = r,
                    None => {
                        node.right = Some(leaf);
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

fn row_text(row: Vec[i64]) -> String {
    let mut out = String.from("[");
    for i in 0..row.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{row[i]}");
    }
    out.push_str("]");
    out
}

fn show(name: Str, items: Vec[Option[i64]]) {
    println(f"{name}: {row_text(largest_values(from_level_order(items)))}");
}

fn main() {
    show("example 1", vec![Some(1), Some(3), Some(2), Some(5), Some(3), None, Some(9)]);
    show("example 2", vec![Some(1), Some(2), Some(3)]);
    show("the empty tree", vec![]);
    show("one node", vec![Some(-7)]);
    show("all negative", vec![Some(-1), Some(-5), Some(-3), Some(-9), None, None, Some(-4)]);
    show("a zigzag", vec![Some(1), Some(2), None, None, Some(3), Some(4), None, None, Some(5)]);
    show("the extremes", vec![Some(-2147483648), Some(-2147483648), Some(2147483647), None, Some(-2147483648)]);
    // 300 random trees of 0 to 60 nodes, the values from -2 to 2, from
    // -1,000 to 1,000, or from the whole range in turn.
    let mut seed: i64 = 515;
    let count = 300;
    let mut rows = 0;
    let mut checksum: i64 = 0;
    for t in 0..count {
        let half = if t % 3 == 0 { 2 } else if t % 3 == 1 { 1000 } else { 0 };
        let size = next_random(mut seed) % 61;
        let row = largest_values(grow(size, half, mut seed));
        rows += row.len();
        for v in row.iter() {
            checksum = (checksum * 31 + *v + 2147483648) % 1000000007;
        }
    }
    println(f"{count} random trees: {rows} rows, checksum {checksum}");
}
