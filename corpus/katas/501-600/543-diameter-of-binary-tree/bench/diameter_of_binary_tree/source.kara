// Benchmark for #543: Diameter of Binary Tree -- the ★ arm (heights,
// recursively).
//
// One walk returns each subtree's height in nodes; at each node the
// path bending there has the two children's heights in edges, and the
// best of those is the answer. O(n) time, O(h) stack.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// The height of the subtree at `node` in nodes, after raising `best` to
// the longest path that bends inside it.
fn height(node: Option[TreeNode], best: mut ref i64) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let l = height(n.left, best);
            let r = height(n.right, best);
            if l + r > *best {
                *best = l + r;
            }
            1 + l.max(r)
        }
    }
}

fn diameter_of_binary_tree(root: Option[TreeNode]) -> i64 {
    let mut best = 0;
    height(root, mut best);
    best
}

// ---- benchmark --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 random trees of 10,000 nodes (the problem's most), each new
    // node walking down from the root and going left with chance 50 to
    // 88 in 100, built once, the nodes kept in the order they were
    // added. Then 200 times over every tree the subtree at one of its
    // first 16 nodes, picked by the round and the tree, is answered.
    let trees = 20;
    let mut seed: i64 = 543;
    let mut all: Vec[Vec[TreeNode]] = Vec.new();
    for g in 0..trees {
        let lean = 50 + 2 * g;
        let root = TreeNode { val: next_random(mut seed) % 201 - 100, left: None, right: None };
        let mut nodes: Vec[TreeNode] = vec![root];
        for _ in 1..10000 {
            let c = TreeNode { val: next_random(mut seed) % 201 - 100, left: None, right: None };
            let mut node = root;
            loop {
                if next_random(mut seed) % 100 < lean {
                    match node.left {
                        Some(l) => node = l,
                        None => {
                            node.left = Some(c);
                            break;
                        }
                    }
                } else {
                    match node.right {
                        Some(r) => node = r,
                        None => {
                            node.right = Some(c);
                            break;
                        }
                    }
                }
            }
            nodes.push(c);
        }
        all.push(nodes);
    }
    let mut total = 0;
    let mut checksum: i64 = 0;
    for r in 0..200 {
        for t in 0..trees {
            let k = (r * 37 + t * 11) % 16;
            let d = diameter_of_binary_tree(Some(all[t][k]));
            total += d;
            checksum = (checksum * 31 + d) % 1000000007;
        }
    }
    println(f"{trees} trees, 200 times each: diameters {total}, checksum {checksum}");
}
