// LeetCode #952: Largest Component Size by Common Factor -- differential
// test of the five arms against the statement read literally, with six
// properties.
//
// The statement: you are given an integer array of unique positive integers
// nums. Consider the graph with nums.length nodes, labeled nums[0] to
// nums[nums.length - 1], and an undirected edge between nums[i] and nums[j]
// if they share a common factor greater than 1. Return the size of the
// largest connected component in the graph.

// ---- the ★ arm: union by prime --------------------------------------------
fn star_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut y = x;
    while parent[y] != root {
        let next = parent[y];
        parent[y] = root;
        y = next;
    }
    root
}

fn star_largest_component_size(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut parent: Vec[i64] = Vec.new();
    let mut size: Vec[i64] = Vec.new();
    for i in 0..n {
        parent.push(i);
        size.push(1);
    }
    // first[p]: the first place whose number has the prime p, -1 for none
    let mut first: Map[i64, i64] = Map.new();
    for i in 0..n {
        let mut x = nums[i];
        let mut p = 2;
        while x > 1 {
            if p * p > x {
                p = x;
            }
            if x % p == 0 {
                while x % p == 0 {
                    x = x / p;
                }
                match first.get(p) {
                    Some(j) => {
                        let a = star_find(mut parent, i);
                        let b = star_find(mut parent, *j);
                        if a != b {
                            if size[a] < size[b] {
                                parent[a] = b;
                                size[b] += size[a];
                            } else {
                                parent[b] = a;
                                size[a] += size[b];
                            }
                        }
                    }
                    None => {
                        first.insert(p, i);
                    }
                }
            }
            p += 1;
        }
    }
    let mut best = 0;
    for i in 0..n {
        if parent[i] == i and size[i] > best {
            best = size[i];
        }
    }
    best
}

// ---- the sieve arm: a sieve of smallest prime factors ---------------------
fn sieve_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut y = x;
    while parent[y] != root {
        let next = parent[y];
        parent[y] = root;
        y = next;
    }
    root
}

fn sieve_largest_component_size(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut top = 1;
    for v in nums.iter() {
        if *v > top {
            top = *v;
        }
    }
    // spf[v]: the smallest prime dividing v, for v from 2
    let mut spf: Vec[i64] = Vec.filled(top + 1, 0);
    for p in 2..(top + 1) {
        if spf[p] == 0 {
            let mut k = p;
            while k <= top {
                if spf[k] == 0 {
                    spf[k] = p;
                }
                k += p;
            }
        }
    }
    let mut parent: Vec[i64] = Vec.new();
    for i in 0..n {
        parent.push(i);
    }
    let mut first: Vec[i64] = Vec.filled(top + 1, -1);
    for i in 0..n {
        let mut x = nums[i];
        while x > 1 {
            let p = spf[x];
            while x % p == 0 {
                x = x / p;
            }
            if first[p] < 0 {
                first[p] = i;
            } else {
                let a = sieve_find(mut parent, i);
                let b = sieve_find(mut parent, first[p]);
                parent[a] = b;
            }
        }
    }
    let mut count: Vec[i64] = Vec.filled(n, 0);
    let mut best = 0;
    for i in 0..n {
        let r = sieve_find(mut parent, i);
        count[r] += 1;
        if count[r] > best {
            best = count[r];
        }
    }
    best
}

// ---- the values arm: joined to every factor -------------------------------
fn values_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut y = x;
    while parent[y] != root {
        let next = parent[y];
        parent[y] = root;
        y = next;
    }
    root
}

fn values_join(parent: mut ref Vec[i64], a: i64, b: i64) {
    let ra = values_find(mut parent, a);
    let rb = values_find(mut parent, b);
    if ra != rb {
        parent[ra] = rb;
    }
}

fn values_largest_component_size(nums: Vec[i64]) -> i64 {
    let mut top = 1;
    for v in nums.iter() {
        if *v > top {
            top = *v;
        }
    }
    let mut parent: Vec[i64] = Vec.new();
    for v in 0..(top + 1) {
        parent.push(v);
    }
    for v in nums.iter() {
        let mut f = 2;
        while f * f <= *v {
            if *v % f == 0 {
                values_join(mut parent, *v, f);
                values_join(mut parent, *v, *v / f);
            }
            f += 1;
        }
    }
    let mut count: Vec[i64] = Vec.filled(top + 1, 0);
    let mut best = 0;
    for v in nums.iter() {
        let r = values_find(mut parent, *v);
        count[r] += 1;
        if count[r] > best {
            best = count[r];
        }
    }
    best
}

// ---- the bfs arm: a search over numbers and primes ------------------------
fn bfs_primes_of(v: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = v;
    let mut p = 2;
    while p * p <= x {
        if x % p == 0 {
            out.push(p);
            while x % p == 0 {
                x = x / p;
            }
        }
        p += 1;
    }
    if x > 1 {
        out.push(x);
    }
    out
}

fn bfs_largest_component_size(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut factors: Vec[Vec[i64]] = Vec.new();
    let mut holders: Map[i64, Vec[i64]] = Map.new();
    for i in 0..n {
        let ps = bfs_primes_of(nums[i]);
        for p in ps.iter() {
            if not holders.contains_key(*p) {
                holders.insert(*p, Vec.new());
            }
            holders.get_mut(*p).unwrap().push(i);
        }
        factors.push(ps);
    }
    let mut seen: Vec[bool] = Vec.filled(n, false);
    let mut expanded: Set[i64] = Set.new();
    let mut best = 0;
    for s in 0..n {
        if seen[s] {
            continue;
        }
        seen[s] = true;
        let mut queue: VecDeque[i64] = VecDeque.new();
        queue.push_back(s);
        let mut size = 0;
        while let Some(i) = queue.pop_front() {
            size += 1;
            for p in factors[i].iter() {
                if expanded.contains(*p) {
                    continue;
                }
                expanded.insert(*p);
                for j in holders.get(*p).unwrap().iter() {
                    if not seen[*j] {
                        seen[*j] = true;
                        queue.push_back(*j);
                    }
                }
            }
        }
        if size > best {
            best = size;
        }
    }
    best
}

// ---- the multiples arm: walking the multiples of each prime ---------------
fn multiples_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut y = x;
    while parent[y] != root {
        let next = parent[y];
        parent[y] = root;
        y = next;
    }
    root
}

fn multiples_largest_component_size(nums: Vec[i64]) -> i64 {
    let mut top = 1;
    for v in nums.iter() {
        if *v > top {
            top = *v;
        }
    }
    let mut present: Vec[bool] = Vec.filled(top + 1, false);
    for v in nums.iter() {
        present[*v] = true;
    }
    let mut parent: Vec[i64] = Vec.new();
    for v in 0..(top + 1) {
        parent.push(v);
    }
    let mut composite: Vec[bool] = Vec.filled(top + 1, false);
    for p in 2..(top + 1) {
        if composite[p] {
            continue;
        }
        let mut anchor = -1;
        let mut k = p;
        while k <= top {
            composite[k] = k != p;
            if present[k] {
                if anchor < 0 {
                    anchor = multiples_find(mut parent, k);
                } else {
                    let r = multiples_find(mut parent, k);
                    if r != anchor {
                        parent[r] = anchor;
                    }
                }
            }
            k += p;
        }
    }
    let mut count: Vec[i64] = Vec.filled(top + 1, 0);
    let mut best = 0;
    for v in nums.iter() {
        let r = multiples_find(mut parent, *v);
        count[r] += 1;
        if count[r] > best {
            best = count[r];
        }
    }
    best
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, nums: Vec[i64]) -> i64 {
    if x == 0 {
        star_largest_component_size(nums)
    } else if x == 1 {
        sieve_largest_component_size(nums)
    } else if x == 2 {
        values_largest_component_size(nums)
    } else if x == 3 {
        bfs_largest_component_size(nums)
    } else {
        multiples_largest_component_size(nums)
    }
}

// The statement read literally: an edge between two numbers when some
// factor from 2 up to the smaller of them divides both, and the largest
// set of nodes reached from one node along the edges.
fn statement(nums: ref Vec[i64]) -> i64 {
    let n = nums.len();
    let mut edge: Vec[Vec[bool]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[bool] = Vec.new();
        for j in 0..n {
            let small = if nums[i] < nums[j] { nums[i] } else { nums[j] };
            let mut shared = false;
            for d in 2..small + 1 {
                if nums[i] % d == 0 and nums[j] % d == 0 {
                    shared = true;
                    break;
                }
            }
            row.push(i != j and shared);
        }
        edge.push(row);
    }
    let mut seen: Vec[bool] = Vec.new();
    for _ in 0..n {
        seen.push(false);
    }
    let mut best = 0;
    for s in 0..n {
        if seen[s] {
            continue;
        }
        seen[s] = true;
        let mut todo: Vec[i64] = vec![s];
        let mut reached = 0;
        while todo.len() > 0 {
            let u = todo.pop().unwrap();
            reached += 1;
            for v in 0..n {
                if edge[u][v] and not seen[v] {
                    seen[v] = true;
                    todo.push(v);
                }
            }
        }
        if reached > best {
            best = reached;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n distinct numbers from 1 to top, in a random order.
fn random_numbers(seed: mut ref i64, n: i64, top: i64) -> Vec[i64] {
    let mut taken: Set[i64] = Set.new();
    let mut out: Vec[i64] = Vec.new();
    while out.len() < n {
        let v = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        if not taken.contains(v) {
            taken.insert(v);
            out.push(v);
        }
    }
    out
}

fn is_prime(v: i64) -> bool {
    if v < 2 {
        return false;
    }
    let mut d = 2;
    while d * d <= v {
        if v % d == 0 {
            return false;
        }
        d += 1;
    }
    true
}

fn smallest_prime(v: i64) -> i64 {
    let mut d = 2;
    while d * d <= v {
        if v % d == 0 {
            return d;
        }
        d += 1;
    }
    v
}

// The primes dividing any of the numbers.
fn primes_used(nums: ref Vec[i64]) -> Set[i64] {
    let mut out: Set[i64] = Set.new();
    for v in nums.iter() {
        let mut x = *v;
        while x > 1 {
            let p = smallest_prime(x);
            out.insert(p);
            while x % p == 0 {
                x = x / p;
            }
        }
    }
    out
}

// Every power of p in v made the same power of q.
fn renamed(v: i64, p: i64, q: i64) -> i64 {
    let mut x = v;
    let mut out = 1;
    while x % p == 0 {
        x = x / p;
        out = out * q;
    }
    out * x
}

// A random order of the same numbers.
fn shuffled(seed: mut ref i64, nums: ref Vec[i64]) -> Vec[i64] {
    let mut out = nums.clone();
    for i in 0..out.len() {
        let j = i + next_random(mut seed) % (out.len() - i);
        out.swap(i, j);
    }
    out
}

// The prime p, among those dividing a number, renamed to the smallest
// prime q dividing none: the largest such p above q makes every number
// smaller, else the largest p at all goes to the first unused prime above
// it, when that keeps every number at the limit or less. Empty when
// neither can.
fn prime_renamed(nums: ref Vec[i64], primes: ref Vec[i64], used: ref Set[i64], limit: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut q = 0;
    let mut p = 0;
    for c in primes.iter() {
        if used.contains(*c) {
            p = *c;
        } else if q == 0 {
            q = *c;
        }
    }
    if p == 0 {
        return out;
    }
    if p < q {
        q = 0;
        for c in primes.iter() {
            if q == 0 and *c > p and not used.contains(*c) {
                q = *c;
            }
        }
    }
    for v in nums.iter() {
        let r = renamed(*v, p, q);
        if r > limit {
            return Vec.new();
        }
        out.push(r);
    }
    out
}

// One to eight numbers at the limit or less made only of primes that
// divide none of nums, each one or two of them, and 1 when nums lacks it.
fn other_case(seed: mut ref i64, nums: ref Vec[i64], primes: ref Vec[i64], used: ref Set[i64], limit: i64) -> Vec[i64] {
    let mut free: Vec[i64] = Vec.new();
    for c in primes.iter() {
        if *c <= limit and not used.contains(*c) {
            free.push(*c);
        }
    }
    let mut has_one = false;
    for v in nums.iter() {
        if *v == 1 {
            has_one = true;
        }
    }
    let m = 1 + next_random(mut seed) % 8;
    let mut taken: Set[i64] = Set.new();
    let mut out: Vec[i64] = Vec.new();
    let mut tries = 0;
    while out.len() < m and tries < 50 {
        tries += 1;
        let mut v = 1;
        let pick = next_random(mut seed) % (free.len() + 1);
        if pick < free.len() {
            v = free[pick];
            if next_random(mut seed) % 2 == 0 {
                let w = free[next_random(mut seed) % free.len()];
                if v * w <= limit {
                    v = v * w;
                }
            }
        } else if has_one {
            continue;
        }
        if not taken.contains(v) {
            taken.insert(v);
            out.push(v);
        }
    }
    out
}

// Each number times its smallest prime, where that stays at the limit or
// less and is not among the numbers yet: the same primes in every number.
fn powers_raised(nums: ref Vec[i64], limit: i64) -> Vec[i64] {
    let mut taken: Set[i64] = Set.new();
    for v in nums.iter() {
        taken.insert(*v);
    }
    let mut out: Vec[i64] = Vec.new();
    for v in nums.iter() {
        let mut r = *v;
        if r > 1 {
            let w = r * smallest_prime(r);
            if w <= limit and not taken.contains(w) {
                taken.remove(r);
                taken.insert(w);
                r = w;
            }
        }
        out.push(r);
    }
    out
}

fn joined(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    for x in b.iter() {
        out.push(*x);
    }
    out
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, nums: Vec[i64], primes: ref Vec[i64], small: bool) -> i64 {
    // every number the properties make is at most twice the largest a
    // case can have
    let limit = if small { 200 } else { 5000 };
    let want = if small { statement(nums) } else { 0 };
    let mut got: Vec[i64] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, nums));
    }
    // the inputs P2 to P5 share: a new order, one prime renamed, a second
    // case over other primes, and higher powers of the same primes
    let order = shuffled(mut seed, nums);
    let used = primes_used(nums);
    let prime = prime_renamed(nums, primes, used, limit);
    let other = other_case(mut seed, nums, primes, used, limit);
    let both = joined(nums, other);
    let raised = powers_raised(nums, limit);
    for x in 0..5 {
        let r = got[x];
        // P1: the statement's answer, on the first 3000 cases
        if small {
            check(mut t, 1, r == want);
        }
        // P2: the numbers in another order, the same answer
        check(mut t, 2, arm(x, order) == r);
        // P3: one prime renamed to a prime no number has, in every number:
        // the same graph, the same answer
        check(mut t, 3, prime.len() == 0 or arm(x, prime) == r);
        // P4: followed by a second case whose primes the first lacks, no
        // edge between the two: the larger of the two answers
        let second = arm(x, other);
        let larger = if second > r { second } else { r };
        check(mut t, 4, arm(x, both) == larger);
        // P5: each number raised to a higher power of a prime it has,
        // where it can be: the same primes, the same answer
        check(mut t, 5, arm(x, raised) == r);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == r {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut t = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 952;
    let mut count = 0;
    let mut total = 0;
    let mut check_sum = 0;
    let mut primes: Vec[i64] = Vec.new();
    for c in 2..5001 {
        if is_prime(c) {
            primes.push(c);
        }
    }
    // 3000 cases of 1 to 12 numbers up to 100, against the statement, then
    // 200 of up to 400 numbers up to 2500
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 12 } else { 1 + next_random(mut seed) % 400 };
        let top = if small { 100 } else { 2500 };
        let nums = random_numbers(mut seed, n, top);
        count += n;
        let r = properties(mut t, mut seed, nums, primes, small);
        total += r;
        check_sum = (check_sum * 31 + r) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"3200 cases of {count} numbers: largest components adding to {total}, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
