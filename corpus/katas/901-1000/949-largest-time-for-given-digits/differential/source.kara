// LeetCode #949: Largest Time for Given Digits -- differential test of
// the five arms against the statement read literally, with six
// properties.
//
// The statement: given an array arr of 4 digits, find the latest 24-hour
// time that can be made using each digit exactly once. 24-hour times are
// formatted as "HH:MM", where HH is between 00 and 23, and MM is between
// 00 and 59. The earliest 24-hour time is 00:00, and the latest is
// 23:59. Return the latest 24-hour time in "HH:MM" format. If no valid
// time can be made, return an empty string.

// ---- the ★ arm: every arrangement -----------------------------------------
fn star_largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut best = -1;
    for i in 0..4 {
        for j in 0..4 {
            if j == i {
                continue;
            }
            for k in 0..4 {
                if k == i or k == j {
                    continue;
                }
                let l = 6 - i - j - k;
                let hours = arr[i] * 10 + arr[j];
                let minutes = arr[k] * 10 + arr[l];
                if hours < 24 and minutes < 60 {
                    best = best.max(hours * 60 + minutes);
                }
            }
        }
    }
    if best < 0 {
        return "".to_string();
    }
    f"{best / 600}{best / 60 % 10}:{best % 60 / 10}{best % 10}"
}

// ---- the countdown arm: every time, latest first --------------------------
fn countdown_largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut weight: Vec[i64] = vec![1];
    for _ in 1..10 {
        weight.push(weight[weight.len() - 1] * 5);
    }
    let mut want = 0;
    for d in arr.iter() {
        want += weight[*d];
    }
    let mut t = 1439;
    while t >= 0 {
        let h = t / 60;
        let m = t % 60;
        if weight[h / 10] + weight[h % 10] + weight[m / 10] + weight[m % 10] == want {
            return f"{h / 10}{h % 10}:{m / 10}{m % 10}";
        }
        t -= 1;
    }
    "".to_string()
}

// ---- the lexi arm: arrangements in dictionary order -----------------------
fn lexi_next_permutation(a: mut ref Vec[i64]) -> bool {
    let mut i = 2;
    while i >= 0 and a[i] >= a[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = 3;
    while a[j] <= a[i] {
        j -= 1;
    }
    a.swap(i, j);
    let mut lo = i + 1;
    let mut hi = 3;
    while lo < hi {
        a.swap(lo, hi);
        lo += 1;
        hi -= 1;
    }
    true
}

fn lexi_largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut a = arr.clone();
    a.sort();
    let mut best = "".to_string();
    let mut more = true;
    while more {
        if a[0] * 10 + a[1] < 24 and a[2] * 10 + a[3] < 60 {
            best = f"{a[0]}{a[1]}:{a[2]}{a[3]}";
        }
        more = lexi_next_permutation(mut a);
    }
    best
}

// ---- the greedy arm: the largest digit that fits --------------------------
fn greedy_fill(arr: ref Vec[i64], used: mut ref Vec[bool], digits: mut ref Vec[i64]) -> bool {
    let p = digits.len();
    if p == 4 {
        return true;
    }
    let limit = if p == 0 {
        2
    } else if p == 1 {
        if digits[0] == 2 { 3 } else { 9 }
    } else if p == 2 {
        5
    } else {
        9
    };
    let mut d = limit;
    while d >= 0 {
        let mut i = 0;
        while i < 4 and (used[i] or arr[i] != d) {
            i += 1;
        }
        if i < 4 {
            used[i] = true;
            digits.push(d);
            if greedy_fill(arr, mut used, mut digits) {
                return true;
            }
            used[i] = false;
            digits.pop();
        }
        d -= 1;
    }
    false
}

fn greedy_largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut used: Vec[bool] = Vec.filled(4, false);
    let mut digits: Vec[i64] = Vec.new();
    if greedy_fill(arr, mut used, mut digits) {
        f"{digits[0]}{digits[1]}:{digits[2]}{digits[3]}"
    } else {
        "".to_string()
    }
}

// ---- the strings arm: every arrangement as a string -----------------------
fn strings_arrange(a: mut ref Vec[i64], k: i64, out: mut ref Vec[String]) {
    if k == 4 {
        out.push(f"{a[0]}{a[1]}:{a[2]}{a[3]}");
        return;
    }
    for i in k..4 {
        a.swap(k, i);
        strings_arrange(mut a, k + 1, mut out);
        a.swap(k, i);
    }
}

fn strings_largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut a = arr.clone();
    let mut all: Vec[String] = Vec.new();
    strings_arrange(mut a, 0, mut all);
    let mut times: Vec[String] = Vec.new();
    for s in all.iter() {
        if s.substring(0, 2) < "24" and s.substring(3, 4) < "6" {
            times.push(s.clone());
        }
    }
    times.sort();
    if times.len() == 0 {
        return "".to_string();
    }
    times[times.len() - 1].clone()
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, arr: Vec[i64]) -> String {
    if x == 0 {
        star_largest_time_from_digits(arr)
    } else if x == 1 {
        countdown_largest_time_from_digits(arr)
    } else if x == 2 {
        lexi_largest_time_from_digits(arr)
    } else if x == 3 {
        greedy_largest_time_from_digits(arr)
    } else {
        strings_largest_time_from_digits(arr)
    }
}

fn clock(t: i64) -> String {
    f"{t / 600}{t / 60 % 10}:{t % 60 / 10}{t % 10}"
}

// The statement read literally: every way of giving each of the four
// places of HH:MM one of the digits, each digit used exactly once, read
// as a 24-hour time when HH is 00 to 23 and MM is 00 to 59; the latest.
fn literal(arr: ref Vec[i64]) -> String {
    let mut best = -1;
    for code in 0..256 {
        let p = vec![code / 64, code / 16 % 4, code / 4 % 4, code % 4];
        let mut once = true;
        for a in 0..4 {
            for b in (a + 1)..4 {
                if p[a] == p[b] {
                    once = false;
                }
            }
        }
        let hh = arr[p[0]] * 10 + arr[p[1]];
        let mm = arr[p[2]] * 10 + arr[p[3]];
        if once and hh <= 23 and mm <= 59 {
            best = best.max(hh * 60 + mm);
        }
    }
    if best < 0 { "".to_string() } else { clock(best) }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a well-formed answer: "", or HH:MM with HH below 24 and MM below 60,
// made of the digits given, each once
fn well_formed(s: ref String, arr: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return true;
    }
    if s.len() != 5 {
        return false;
    }
    let b = s.bytes().to_vec();
    if b[2] != 58 {
        return false;
    }
    let mut digits: Vec[i64] = Vec.new();
    for i in vec![0, 1, 3, 4].iter() {
        let c = b[*i] as i64 - 48;
        if c < 0 or c > 9 {
            return false;
        }
        digits.push(c);
    }
    let mut given = arr.clone();
    given.sort();
    let hh = digits[0] * 10 + digits[1];
    let mm = digits[2] * 10 + digits[3];
    digits.sort();
    hh < 24 and mm < 60 and digits == given
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, arr: Vec[i64], small: bool) -> String {
    let truth = if small { literal(arr) } else { "".to_string() };
    let mut got: Vec[String] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, arr));
    }
    // the inputs P3 to P5 share: the digits shuffled; one digit lowered
    // by one; one raised by one; and the digits read in the order given
    let mut shuffled = arr.clone();
    for i in 0..4 {
        let j = i + next_random(mut seed) % (4 - i);
        shuffled.swap(i, j);
    }
    let mut lower = arr.clone();
    let i = next_random(mut seed) % 4;
    if lower[i] > 0 {
        lower[i] -= 1;
    }
    let mut higher = arr.clone();
    let k = next_random(mut seed) % 4;
    if higher[k] < 9 {
        higher[k] += 1;
    }
    let hh = arr[0] * 10 + arr[1];
    let mm = arr[2] * 10 + arr[3];
    let as_given = if hh < 24 and mm < 60 { clock(hh * 60 + mm) } else { "".to_string() };
    for x in 0..5 {
        let s = got[x].clone();
        // P1: the statement's latest time, on the first 3000 arrays
        if small {
            check(mut t, 1, s == truth);
        }
        // P2: "" or HH:MM, a time, of the digits given
        check(mut t, 2, well_formed(s, arr));
        // P3: the digits shuffled, the same
        check(mut t, 3, arm(x, shuffled) == s);
        // P4: a digit lowered never turns a time into ""
        check(mut t, 4, s.len() == 0 or arm(x, lower).len() == 5);
        // P5: a digit raised never turns "" into a time, and the digits
        // in the order given, when a time, are no later
        check(mut t, 5, (s.len() == 5 or arm(x, higher).len() == 0) and as_given <= s);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == s {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    got[0].clone()
}

fn main() {
    let mut t = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 949;
    let mut times = 0;
    let mut minutes = 0;
    let mut check_sum = 0;
    // 3000 arrays of digits from 0 to as little as 1, against the
    // statement, then 200 of digits from 0 to 9
    for c in 0..3200 {
        let small = c < 3000;
        let top = if small { 2 + next_random(mut seed) % 9 } else { 10 };
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..4 {
            arr.push(next_random(mut seed) % top);
        }
        let s = properties(mut t, mut seed, arr, small);
        let mut m = -1;
        if s.len() == 5 {
            let b = s.bytes().to_vec();
            m = ((b[0] as i64 - 48) * 10 + (b[1] as i64 - 48)) * 60 + (b[3] as i64 - 48) * 10 + (b[4] as i64 - 48);
            times += 1;
            minutes += m;
        }
        check_sum = (check_sum * 1000003 + m + 1) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"3200 arrays, {times} times, minutes adding to {minutes}, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
