// LeetCode #949: Largest Time for Given Digits -- every arrangement.
//
// Four digits can be arranged 24 ways. Try each one, the first two
// digits as the hours and the last two as the minutes, and keep the
// latest that is a time: hours below 24 and minutes below 60. The places
// of the first three digits are chosen in three loops and the fourth is
// the one left, 6 less the other three. O(1): 24 arrangements.

fn largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut best = -1;
    for i in 0..4 {
        for j in 0..4 {
            if j == i {
                continue;
            }
            for k in 0..4 {
                if k == i or k == j {
                    continue;
                }
                let l = 6 - i - j - k;
                let hours = arr[i] * 10 + arr[j];
                let minutes = arr[k] * 10 + arr[l];
                if hours < 24 and minutes < 60 {
                    best = best.max(hours * 60 + minutes);
                }
            }
        }
    }
    if best < 0 {
        return "".to_string();
    }
    f"{best / 600}{best / 60 % 10}:{best % 60 / 10}{best % 10}"
}

// ---- test harness ---------------------------------------------------------

fn show(arr: ref Vec[i64]) -> String {
    f"[{arr[0]},{arr[1]},{arr[2]},{arr[3]}]"
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[Vec[i64]] = vec![
        vec![1, 2, 3, 4],
        vec![5, 5, 5, 5],
        vec![0, 0, 0, 0],
        vec![0, 0, 1, 0],
        vec![2, 0, 6, 6],
        vec![1, 9, 6, 0],
        vec![9, 5, 3, 2],
        vec![2, 4, 5, 9],
    ];
    for arr in examples.iter() {
        println(f"{show(arr)}: \"{largest_time_from_digits(arr)}\"");
    }
    // every array of four digits
    let mut times = 0;
    let mut minutes = 0;
    let mut check = 0;
    let mut seen: Vec[i64] = Vec.filled(1440, 0);
    for code in 0..10000 {
        let arr = vec![code / 1000, code / 100 % 10, code / 10 % 10, code % 10];
        let s = largest_time_from_digits(arr);
        let mut m = -1;
        if s.len() > 0 {
            let b = s.bytes().to_vec();
            let h = (b[0] as i64 - 48) * 10 + (b[1] as i64 - 48);
            m = h * 60 + (b[3] as i64 - 48) * 10 + (b[4] as i64 - 48);
            times += 1;
            minutes += m;
            seen[m] += 1;
        }
        check = (check * 31 + m + 1) % 1000000007;
    }
    println(f"all 10000 arrays of four digits: {times} make a time, minutes adding to {minutes}, checksum {check}");
    let mut distinct = 0;
    let mut common = 0;
    for t in 0..1440 {
        if seen[t] > 0 {
            distinct += 1;
        }
        if seen[t] > seen[common] {
            common = t;
        }
    }
    println(f"{distinct} different times; the most common, {common / 600}{common / 60 % 10}:{common % 60 / 10}{common % 10}, from {seen[common]} arrays");
}
