// LeetCode #949: Largest Time for Given Digits -- every time, latest
// first.
//
// Walk the day backwards from 23:59 to 00:00; the first time made of the
// same four digits as those given is the latest that can be made. Four
// digits are the same as four others when they hold each digit as many
// times, so each set is kept as one number that adds 5^d for each digit
// d, counts of up to 4 being digits of a base-5 number. O(1): at most
// 1440 times.

fn largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut weight: Vec[i64] = vec![1];
    for _ in 1..10 {
        weight.push(weight[weight.len() - 1] * 5);
    }
    let mut want = 0;
    for d in arr.iter() {
        want += weight[*d];
    }
    let mut t = 1439;
    while t >= 0 {
        let h = t / 60;
        let m = t % 60;
        if weight[h / 10] + weight[h % 10] + weight[m / 10] + weight[m % 10] == want {
            return f"{h / 10}{h % 10}:{m / 10}{m % 10}";
        }
        t -= 1;
    }
    "".to_string()
}

// ---- test harness ---------------------------------------------------------

fn show(arr: ref Vec[i64]) -> String {
    f"[{arr[0]},{arr[1]},{arr[2]},{arr[3]}]"
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[Vec[i64]] = vec![
        vec![1, 2, 3, 4],
        vec![5, 5, 5, 5],
        vec![0, 0, 0, 0],
        vec![0, 0, 1, 0],
        vec![2, 0, 6, 6],
        vec![1, 9, 6, 0],
        vec![9, 5, 3, 2],
        vec![2, 4, 5, 9],
    ];
    for arr in examples.iter() {
        println(f"{show(arr)}: \"{largest_time_from_digits(arr)}\"");
    }
    // every array of four digits
    let mut times = 0;
    let mut minutes = 0;
    let mut check = 0;
    let mut seen: Vec[i64] = Vec.filled(1440, 0);
    for code in 0..10000 {
        let arr = vec![code / 1000, code / 100 % 10, code / 10 % 10, code % 10];
        let s = largest_time_from_digits(arr);
        let mut m = -1;
        if s.len() > 0 {
            let b = s.bytes().to_vec();
            let h = (b[0] as i64 - 48) * 10 + (b[1] as i64 - 48);
            m = h * 60 + (b[3] as i64 - 48) * 10 + (b[4] as i64 - 48);
            times += 1;
            minutes += m;
            seen[m] += 1;
        }
        check = (check * 31 + m + 1) % 1000000007;
    }
    println(f"all 10000 arrays of four digits: {times} make a time, minutes adding to {minutes}, checksum {check}");
    let mut distinct = 0;
    let mut common = 0;
    for t in 0..1440 {
        if seen[t] > 0 {
            distinct += 1;
        }
        if seen[t] > seen[common] {
            common = t;
        }
    }
    println(f"{distinct} different times; the most common, {common / 600}{common / 60 % 10}:{common % 60 / 10}{common % 10}, from {seen[common]} arrays");
}
