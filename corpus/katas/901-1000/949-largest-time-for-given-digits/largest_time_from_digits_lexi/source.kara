// LeetCode #949: Largest Time for Given Digits -- arrangements in
// dictionary order.
//
// Sort the digits and step through their arrangements in dictionary
// order with the next-permutation step: find the last place whose digit
// is below the next one, swap it with the last digit larger than it, and
// reverse what follows. Read as HH:MM, dictionary order is time order,
// so the last arrangement that is a time is the latest. O(1): at most 24
// arrangements.

fn next_permutation(a: mut ref Vec[i64]) -> bool {
    let mut i = 2;
    while i >= 0 and a[i] >= a[i + 1] {
        i -= 1;
    }
    if i < 0 {
        return false;
    }
    let mut j = 3;
    while a[j] <= a[i] {
        j -= 1;
    }
    a.swap(i, j);
    let mut lo = i + 1;
    let mut hi = 3;
    while lo < hi {
        a.swap(lo, hi);
        lo += 1;
        hi -= 1;
    }
    true
}

fn largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut a = arr.clone();
    a.sort();
    let mut best = "".to_string();
    let mut more = true;
    while more {
        if a[0] * 10 + a[1] < 24 and a[2] * 10 + a[3] < 60 {
            best = f"{a[0]}{a[1]}:{a[2]}{a[3]}";
        }
        more = next_permutation(mut a);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn show(arr: ref Vec[i64]) -> String {
    f"[{arr[0]},{arr[1]},{arr[2]},{arr[3]}]"
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[Vec[i64]] = vec![
        vec![1, 2, 3, 4],
        vec![5, 5, 5, 5],
        vec![0, 0, 0, 0],
        vec![0, 0, 1, 0],
        vec![2, 0, 6, 6],
        vec![1, 9, 6, 0],
        vec![9, 5, 3, 2],
        vec![2, 4, 5, 9],
    ];
    for arr in examples.iter() {
        println(f"{show(arr)}: \"{largest_time_from_digits(arr)}\"");
    }
    // every array of four digits
    let mut times = 0;
    let mut minutes = 0;
    let mut check = 0;
    let mut seen: Vec[i64] = Vec.filled(1440, 0);
    for code in 0..10000 {
        let arr = vec![code / 1000, code / 100 % 10, code / 10 % 10, code % 10];
        let s = largest_time_from_digits(arr);
        let mut m = -1;
        if s.len() > 0 {
            let b = s.bytes().to_vec();
            let h = (b[0] as i64 - 48) * 10 + (b[1] as i64 - 48);
            m = h * 60 + (b[3] as i64 - 48) * 10 + (b[4] as i64 - 48);
            times += 1;
            minutes += m;
            seen[m] += 1;
        }
        check = (check * 31 + m + 1) % 1000000007;
    }
    println(f"all 10000 arrays of four digits: {times} make a time, minutes adding to {minutes}, checksum {check}");
    let mut distinct = 0;
    let mut common = 0;
    for t in 0..1440 {
        if seen[t] > 0 {
            distinct += 1;
        }
        if seen[t] > seen[common] {
            common = t;
        }
    }
    println(f"{distinct} different times; the most common, {common / 600}{common / 60 % 10}:{common % 60 / 10}{common % 10}, from {seen[common]} arrays");
}
