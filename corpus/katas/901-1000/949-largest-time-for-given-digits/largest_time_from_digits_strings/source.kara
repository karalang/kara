// LeetCode #949: Largest Time for Given Digits -- every arrangement as a
// string, sorted.
//
// Write out every arrangement of the four digits as a string HH:MM, by
// swapping each digit in turn into each place, keep the strings that are
// times (hours below "24" and the tens of minutes below "6", compared as
// strings), sort them, and take the last. Strings of digits of one
// length sort as their numbers do. O(1): 24 strings.

fn arrange(a: mut ref Vec[i64], k: i64, out: mut ref Vec[String]) {
    if k == 4 {
        out.push(f"{a[0]}{a[1]}:{a[2]}{a[3]}");
        return;
    }
    for i in k..4 {
        a.swap(k, i);
        arrange(mut a, k + 1, mut out);
        a.swap(k, i);
    }
}

fn largest_time_from_digits(arr: Vec[i64]) -> String {
    let mut a = arr.clone();
    let mut all: Vec[String] = Vec.new();
    arrange(mut a, 0, mut all);
    let mut times: Vec[String] = Vec.new();
    for s in all.iter() {
        if s.substring(0, 2) < "24" and s.substring(3, 4) < "6" {
            times.push(s.clone());
        }
    }
    times.sort();
    if times.len() == 0 {
        return "".to_string();
    }
    times[times.len() - 1].clone()
}

// ---- test harness ---------------------------------------------------------

fn show(arr: ref Vec[i64]) -> String {
    f"[{arr[0]},{arr[1]},{arr[2]},{arr[3]}]"
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[Vec[i64]] = vec![
        vec![1, 2, 3, 4],
        vec![5, 5, 5, 5],
        vec![0, 0, 0, 0],
        vec![0, 0, 1, 0],
        vec![2, 0, 6, 6],
        vec![1, 9, 6, 0],
        vec![9, 5, 3, 2],
        vec![2, 4, 5, 9],
    ];
    for arr in examples.iter() {
        println(f"{show(arr)}: \"{largest_time_from_digits(arr)}\"");
    }
    // every array of four digits
    let mut times = 0;
    let mut minutes = 0;
    let mut check = 0;
    let mut seen: Vec[i64] = Vec.filled(1440, 0);
    for code in 0..10000 {
        let arr = vec![code / 1000, code / 100 % 10, code / 10 % 10, code % 10];
        let s = largest_time_from_digits(arr);
        let mut m = -1;
        if s.len() > 0 {
            let b = s.bytes().to_vec();
            let h = (b[0] as i64 - 48) * 10 + (b[1] as i64 - 48);
            m = h * 60 + (b[3] as i64 - 48) * 10 + (b[4] as i64 - 48);
            times += 1;
            minutes += m;
            seen[m] += 1;
        }
        check = (check * 31 + m + 1) % 1000000007;
    }
    println(f"all 10000 arrays of four digits: {times} make a time, minutes adding to {minutes}, checksum {check}");
    let mut distinct = 0;
    let mut common = 0;
    for t in 0..1440 {
        if seen[t] > 0 {
            distinct += 1;
        }
        if seen[t] > seen[common] {
            common = t;
        }
    }
    println(f"{distinct} different times; the most common, {common / 600}{common / 60 % 10}:{common % 60 / 10}{common % 10}, from {seen[common]} arrays");
}
