// LeetCode #964: Least Operators to Express Number -- relaxation.
//
// The same moves as Dijkstra (from t, one highest power p = x^k taken
// away or the step over to x^(k + 1)), but settled by relaxing: a queue
// of values whose best known cost just fell, each one's moves re-tried
// until no cost falls. The best cost of every value seen is kept in a
// Map. The first term needs no sign, so one operator comes off.
fn least_ops_express_target(x: i64, target: i64) -> i64 {
    let mut cost: Map[i64, i64] = Map.new();
    let mut queue: VecDeque[i64] = VecDeque.new();
    cost.insert(target, 0);
    queue.push_back(target);
    while let Some(t) = queue.pop_front() {
        if t == 0 {
            continue;
        }
        let d = cost[t];
        let mut p = 1;
        let mut k = 0;
        while p * x <= t {
            p *= x;
            k += 1;
        }
        let c = if k == 0 { 2 } else { k };
        for (next, step) in [(t - p, c), (p * x - t, k + 1)] {
            let better = match cost.get(next) {
                Some(old) => d + step < *old,
                None => true,
            };
            if better {
                cost.insert(next, d + step);
                queue.push_back(next);
            }
        }
    }
    cost[0] - 1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(i64, i64)] = vec![
        (3, 19),
        (5, 501),
        (100, 100000000),
        (2, 1),
        (2, 2),
        (3, 2),
        (100, 1),
        (100, 99),
        (100, 50),
        (2, 3),
        (7, 343),
        (7, 342),
    ];
    for (x, target) in cases.iter() {
        println(f"x = {x}, target = {target}: {least_ops_express_target(x, target)}");
    }
    // every target from 1 to 300 for every x from 2 to 12
    let mut total = 0;
    let mut check = 0;
    for x in 2..13 {
        for target in 1..301 {
            let n = least_ops_express_target(x, target);
            total += n;
            check = (check * 31 + n) % 1000000007;
        }
    }
    println(f"targets 1 to 300 for x from 2 to 12: {total} operators, checksum {check}");
    // 300 random cases, x from 2 to 100, target up to 2 * 10^8
    let mut seed = 964;
    total = 0;
    check = 0;
    for _ in 0..300 {
        let x = 2 + next_random(mut seed) % 99;
        let target = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000000;
        let n = least_ops_express_target(x, target);
        total += n;
        check = (check * 31 + n) % 1000000007;
    }
    println(f"300 random cases up to 2 * 10^8: {total} operators, checksum {check}");
    // LeetCode's largest targets, and exact powers
    for (x, target) in [(2, 200000000), (100, 200000000), (99, 199999999), (2, 134217728), (2, 134217727), (3, 129140163), (10, 100000000), (10, 99999999)] {
        println(f"x = {x}, target = {target}: {least_ops_express_target(x, target)}");
    }
}
