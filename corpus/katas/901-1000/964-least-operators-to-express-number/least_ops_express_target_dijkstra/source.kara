// LeetCode #964: Least Operators to Express Number -- Dijkstra.
//
// A shortest path from target down to 0. From a value t whose highest
// power of x is p = x^k, either take one p away (k operators, 2 when k
// is 0) or step over to x^(k + 1) and keep what is left to subtract,
// x^(k + 1) - t (k + 1 operators). Each value is settled once, cheapest
// first, from a PriorityQueue. The first term needs no sign, so one
// operator comes off.
fn least_ops_express_target(x: i64, target: i64) -> i64 {
    let mut done: Set[i64] = Set.new();
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    queue.push((0, target));
    while let Some((d, t)) = queue.pop() {
        if t == 0 {
            return d - 1;
        }
        if done.contains(t) {
            continue;
        }
        done.insert(t);
        let mut p = 1;
        let mut k = 0;
        while p * x <= t {
            p *= x;
            k += 1;
        }
        let c = if k == 0 { 2 } else { k };
        if not done.contains(t - p) {
            queue.push((d + c, t - p));
        }
        if not done.contains(p * x - t) {
            queue.push((d + k + 1, p * x - t));
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(i64, i64)] = vec![
        (3, 19),
        (5, 501),
        (100, 100000000),
        (2, 1),
        (2, 2),
        (3, 2),
        (100, 1),
        (100, 99),
        (100, 50),
        (2, 3),
        (7, 343),
        (7, 342),
    ];
    for (x, target) in cases.iter() {
        println(f"x = {x}, target = {target}: {least_ops_express_target(*x, *target)}");
    }
    // every target from 1 to 300 for every x from 2 to 12
    let mut total = 0;
    let mut check = 0;
    for x in 2..13 {
        for target in 1..301 {
            let n = least_ops_express_target(x, target);
            total += n;
            check = (check * 31 + n) % 1000000007;
        }
    }
    println(f"targets 1 to 300 for x from 2 to 12: {total} operators, checksum {check}");
    // 300 random cases, x from 2 to 100, target up to 2 * 10^8
    let mut seed = 964;
    total = 0;
    check = 0;
    for _ in 0..300 {
        let x = 2 + next_random(mut seed) % 99;
        let target = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000000;
        let n = least_ops_express_target(x, target);
        total += n;
        check = (check * 31 + n) % 1000000007;
    }
    println(f"300 random cases up to 2 * 10^8: {total} operators, checksum {check}");
    // LeetCode's largest targets, and exact powers
    for (x, target) in [(2, 200000000), (100, 200000000), (99, 199999999), (2, 134217728), (2, 134217727), (3, 129140163), (10, 100000000), (10, 99999999)] {
        println(f"x = {x}, target = {target}: {least_ops_express_target(x, target)}");
    }
}
