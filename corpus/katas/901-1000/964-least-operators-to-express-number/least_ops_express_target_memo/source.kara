// LeetCode #964: Least Operators to Express Number -- memoised places.
//
// best(i, t) is the cheapest way to make t copies of x^i from terms x^i
// and up, each x^i costing i operators (2 when i is 0). The lowest digit
// r of t in base x is made either as r copies of x^i, leaving t / x
// copies of x^(i + 1), or as x - r copies subtracted, leaving one more.
// With r = 0 the second way is never cheaper (x copies of x^i cost more
// than one x^(i + 1)), and skipping it keeps t falling. The answers go
// in a Map keyed by (i, t). O(log target) states.
fn cost(i: i64) -> i64 {
    if i == 0 { 2 } else { i }
}

fn best(x: i64, i: i64, t: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if t == 0 {
        return 0;
    }
    if t == 1 {
        return cost(i);
    }
    if let Some(v) = memo.get((i, t)) {
        return *v;
    }
    let r = t % x;
    let mut b = r * cost(i) + best(x, i + 1, t / x, mut memo);
    if r > 0 {
        b = b.min((x - r) * cost(i) + best(x, i + 1, t / x + 1, mut memo));
    }
    memo.insert((i, t), b);
    b
}

fn least_ops_express_target(x: i64, target: i64) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    best(x, 0, target, mut memo) - 1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(i64, i64)] = vec![
        (3, 19),
        (5, 501),
        (100, 100000000),
        (2, 1),
        (2, 2),
        (3, 2),
        (100, 1),
        (100, 99),
        (100, 50),
        (2, 3),
        (7, 343),
        (7, 342),
    ];
    for (x, target) in cases.iter() {
        println(f"x = {x}, target = {target}: {least_ops_express_target(x, target)}");
    }
    // every target from 1 to 300 for every x from 2 to 12
    let mut total = 0;
    let mut check = 0;
    for x in 2..13 {
        for target in 1..301 {
            let n = least_ops_express_target(x, target);
            total += n;
            check = (check * 31 + n) % 1000000007;
        }
    }
    println(f"targets 1 to 300 for x from 2 to 12: {total} operators, checksum {check}");
    // 300 random cases, x from 2 to 100, target up to 2 * 10^8
    let mut seed = 964;
    total = 0;
    check = 0;
    for _ in 0..300 {
        let x = 2 + next_random(mut seed) % 99;
        let target = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000000;
        let n = least_ops_express_target(x, target);
        total += n;
        check = (check * 31 + n) % 1000000007;
    }
    println(f"300 random cases up to 2 * 10^8: {total} operators, checksum {check}");
    // LeetCode's largest targets, and exact powers
    for (x, target) in [(2, 200000000), (100, 200000000), (99, 199999999), (2, 134217728), (2, 134217727), (3, 129140163), (10, 100000000), (10, 99999999)] {
        println(f"x = {x}, target = {target}: {least_ops_express_target(x, target)}");
    }
}
