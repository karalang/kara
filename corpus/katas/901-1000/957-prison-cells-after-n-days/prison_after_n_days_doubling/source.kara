// LeetCode #957: Prison Cells After N Days -- jumps by powers of two.
//
// A day is a function on the 256 rows. Tabulate it, then the function
// for 2, 4, 8, ... days, each the one before applied twice, and walk the
// binary digits of n, taking the jump for each digit that is set.
// O(2^8 log n).

fn prison_after_n_days(cells: Vec[i64], n: i64) -> Vec[i64] {
    // jump[k][s]: the row 2^k days after row s, rows read as bytes
    let mut jump: Vec[Vec[i64]] = Vec.new();
    let mut one: Vec[i64] = Vec.new();
    for s in 0..256 {
        let mut t = 0;
        for i in 1..7 {
            let left = (s >> (8 - i)) & 1;
            let right = (s >> (6 - i)) & 1;
            if left == right {
                t = t | (1 << (7 - i));
            }
        }
        one.push(t);
    }
    jump.push(one);
    let mut s = 0;
    for v in cells.iter() {
        s = s * 2 + *v;
    }
    let mut k = 0;
    let mut m = n;
    while m > 0 {
        if k == jump.len() {
            let mut twice: Vec[i64] = Vec.new();
            for x in 0..256 {
                twice.push(jump[k - 1][jump[k - 1][x]]);
            }
            jump.push(twice);
        }
        if m % 2 == 1 {
            s = jump[k][s];
        }
        m = m / 2;
        k += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..8 {
        out.push((s >> (7 - i)) & 1);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(cells: ref Vec[i64]) -> String {
    let mut s = String.new();
    for i in 0..cells.len() {
        if i > 0 {
            s = s + ",";
        }
        s = s + f"{cells[i]}";
    }
    f"[{s}]"
}

fn byte_of(cells: ref Vec[i64]) -> i64 {
    let mut c = 0;
    for v in cells.iter() {
        c = c * 2 + *v;
    }
    c
}

fn row_of(b: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..8 {
        out.push((b >> (7 - i)) & 1);
    }
    out
}

fn main() {
    // LeetCode's two examples, then a few more
    let cases: Vec[(Vec[i64], i64)] = vec![
        (vec![0, 1, 0, 1, 1, 0, 0, 1], 7),
        (vec![1, 0, 0, 1, 0, 0, 1, 0], 1000000000),
        (vec![0, 1, 0, 1, 1, 0, 0, 1], 0),
        (vec![0, 1, 0, 1, 1, 0, 0, 1], 1),
        (vec![0, 0, 0, 0, 0, 0, 0, 0], 1),
        (vec![1, 1, 1, 1, 1, 1, 1, 1], 1000000000),
        (vec![1, 0, 1, 0, 1, 0, 1, 0], 14),
        (vec![1, 0, 1, 0, 1, 0, 1, 0], 15),
        (vec![0, 0, 1, 0, 0, 1, 0, 0], 999999999),
    ];
    for (cells, n) in cases.iter() {
        println(f"{show(cells)} after {n}: {show(prison_after_n_days(cells.clone(), n))}");
    }
    // 300 random cases of a random row after 0 to 99 days
    let mut seed = 957;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let cells = row_of(next_random(mut seed) % 256);
        let n = next_random(mut seed) % 100;
        let b = byte_of(prison_after_n_days(cells, n));
        total += b;
        check = (check * 31 + b) % 1000000007;
    }
    println(f"300 random cases after 0 to 99 days: rows adding to {total}, checksum {check}");
    // every row after LeetCode's largest n, and a few around it
    for n in [1000000000, 999999999, 999999986, 536870912] {
        let mut total = 0;
        let mut check = 0;
        for b in 0..256 {
            let r = byte_of(prison_after_n_days(row_of(b), n));
            total += r;
            check = (check * 31 + r) % 1000000007;
        }
        println(f"all 256 rows after {n}: rows adding to {total}, checksum {check}");
    }
}
