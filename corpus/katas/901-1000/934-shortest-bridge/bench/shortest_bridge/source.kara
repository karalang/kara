// LeetCode #934: Shortest Bridge -- bench: mark one island, then search
// outward. Mirrors shortest_bridge.c, .rs, .py and go-seq/.

fn shortest_bridge(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let dr = [-1, 1, 0, 0];
    let dc = [0, 0, -1, 1];
    let mut dist: Vec[i64] = Vec.filled(n * n, -1);
    let mut start = 0;
    while grid[start / n][start % n] == 0 {
        start += 1;
    }
    // the first island, every cell at distance 0
    let mut stack: Vec[i64] = vec![start];
    let mut frontier: Vec[i64] = Vec.new();
    dist[start] = 0;
    while let Some(cell) = stack.pop() {
        frontier.push(cell);
        for d in 0..4 {
            let r = cell / n + dr[d];
            let c = cell % n + dc[d];
            if r >= 0 and r < n and c >= 0 and c < n and grid[r][c] == 1 and dist[r * n + c] < 0 {
                dist[r * n + c] = 0;
                stack.push(r * n + c);
            }
        }
    }
    // outward, one ring of water at a time
    let mut head = 0;
    while head < frontier.len() {
        let cell = frontier[head];
        head += 1;
        for d in 0..4 {
            let r = cell / n + dr[d];
            let c = cell % n + dc[d];
            if r >= 0 and r < n and c >= 0 and c < n and dist[r * n + c] < 0 {
                if grid[r][c] == 1 {
                    return dist[cell];
                }
                dist[r * n + c] = dist[cell] + 1;
                frontier.push(r * n + c);
            }
        }
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// grows `cells` from a random cell of `grid` marked `mark`, one random
// neighbour of a random cell at a time; with `avoid`, never beside a cell
// marked `avoid`
fn grow(seed: mut ref i64, grid: mut ref Vec[Vec[i64]], cells: mut ref Vec[i64], size: i64, mark: i64, avoid: i64) {
    let n = grid.len();
    let dr = [-1, 1, 0, 0];
    let dc = [0, 0, -1, 1];
    let mut tries = 0;
    while cells.len() < size and tries < 4 * size {
        tries += 1;
        let cell = cells[next_random(mut seed) % cells.len()];
        let d = next_random(mut seed) % 4;
        let r = cell / n + dr[d];
        let c = cell % n + dc[d];
        if r >= 0 and r < n and c >= 0 and c < n and grid[r][c] == 0 and not beside(grid, r, c, avoid) {
            grid[r][c] = mark;
            cells.push(r * n + c);
        }
    }
}

fn beside(grid: ref Vec[Vec[i64]], r: i64, c: i64, mark: i64) -> bool {
    let n = grid.len();
    (r > 0 and grid[r - 1][c] == mark) or (r + 1 < n and grid[r + 1][c] == mark) or (c > 0 and grid[r][c - 1] == mark) or (c + 1 < n and grid[r][c + 1] == mark)
}

// an n x n grid with two islands of up to size_a and size_b cells, grown
// at random, the second never touching the first
fn random_islands(seed: mut ref i64, n: i64, size_a: i64, size_b: i64) -> Vec[Vec[i64]] {
    loop {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            grid.push(Vec.filled(n, 0));
        }
        let a = next_random(mut seed) % (n * n);
        grid[a / n][a % n] = 2;
        let mut cells_a: Vec[i64] = vec![a];
        grow(mut seed, mut grid, mut cells_a, size_a, 2, -1);
        let mut b = -1;
        for _ in 0..100 {
            let x = next_random(mut seed) % (n * n);
            if b < 0 and grid[x / n][x % n] == 0 and not beside(grid, x / n, x % n, 2) {
                b = x;
            }
        }
        if b >= 0 {
            grid[b / n][b % n] = 3;
            let mut cells_b: Vec[i64] = vec![b];
            grow(mut seed, mut grid, mut cells_b, size_b, 3, 2);
            for r in 0..n {
                for c in 0..n {
                    if grid[r][c] > 0 {
                        grid[r][c] = 1;
                    }
                }
            }
            return grid;
        }
    }
}

fn main() {
    let rounds = 50;
    let count = 100;
    let n = 100;
    let mut seed = 934;
    // count n x n grids, each with two islands of up to 2500 cells grown at
    // random, built once
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        let size_a = 1 + next_random(mut seed) % 2500;
        let size_b = 1 + next_random(mut seed) % 2500;
        grids.push(random_islands(mut seed, n, size_a, size_b));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        // each round visits every grid, starting from a different one
        for i in 0..count {
            let a = shortest_bridge(grids[(r + i) % count]);
            total += a;
            check = (check * 1000003 + a) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} grids of {n} x {n}: answers summing to {total}, checksum {check}");
}
