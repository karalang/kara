// LeetCode #976: Largest Perimeter Triangle -- every triple of the 32
// longest.
//
// The walk from the top fails at most 28 times, since each failure
// makes the longest length at least the sum of the next two and a run
// of 29 failures would need a length past Fibonacci's 832040 and
// 1346269, above LeetCode's 10^6. So the answer lies among the 31
// longest lengths, and trying every triple of the 32 longest, kept in
// a short sorted list as the lengths stream past, finds it without
// assuming which triple wins. O(32 n + 32^3).

fn largest_perimeter(nums: Vec[i64]) -> i64 {
    let mut top: Vec[i64] = Vec.new();
    for x in nums {
        if top.len() < 32 or x > top[top.len() - 1] {
            let mut at = top.len();
            while at > 0 and top[at - 1] < x {
                at -= 1;
            }
            top.insert(at, x);
            top.truncate(32);
        }
    }
    let mut best = 0;
    let m = top.len();
    for i in 0..m {
        for j in i + 1..m {
            for k in j + 1..m {
                // top is longest first, so top[i] is the longest side
                if top[j] + top[k] > top[i] {
                    best = best.max(top[i] + top[j] + top[k]);
                }
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        // two draws, since one reaches only 32767
        nums.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top);
    }
    nums
}

fn main() {
    // the Fibonacci numbers up to 832040: no three of them make a triangle
    let mut fib: Vec[i64] = vec![1, 1];
    while fib.len() < 30 {
        let n = fib.len();
        fib.push(fib[n - 1] + fib[n - 2]);
    }
    let mut fib_and_three = fib.clone();
    fib_and_three.extend(vec![2, 2, 3]);
    // LeetCode's two examples, then a few more
    let cases: Vec[Vec[i64]] = vec![
        vec![2, 1, 2],
        vec![1, 2, 1, 10],
        vec![3, 2, 3, 4],
        vec![3, 6, 2, 3],
        vec![1, 1, 1],
        vec![1, 2, 3],
        vec![1000000, 1000000, 1000000],
        vec![1000000, 1, 1, 999999, 2],
        fib.clone(),
        fib_and_three,
    ];
    for nums in cases {
        println(f"{nums.len()} lengths from {nums[0]}: {largest_perimeter(nums)}");
    }
    // random lengths: 300 small, 3000 longer, then 4 of 10^4 lengths
    let mut seed = 976;
    for (count, most, top) in vec![(300, 12, 10), (3000, 60, 1000), (4, 10000, 1000000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if most == 10000 { most } else { 3 + next_random(mut seed) % (most - 2) };
            let p = largest_perimeter(random_nums(n, top, mut seed));
            total += p;
            check = (check * 31 + p) % 1000000007;
        }
        println(f"{count} random cases of up to {most} lengths: perimeters total {total}, checksum {check}");
    }
}
