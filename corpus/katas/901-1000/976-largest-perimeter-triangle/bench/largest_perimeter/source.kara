// Benchmark: LeetCode #976 Largest Perimeter Triangle -- the ★ arm, sort
// and scan from the top, on 20 lists of 10000 random lengths. Mirrors
// largest_perimeter.rs, .c, .py and go-seq/.

fn largest_perimeter(nums: Vec[i64]) -> i64 {
    let mut a = nums.clone();
    a.sort();
    let mut i = a.len() - 1;
    while i >= 2 {
        if a[i - 2] + a[i - 1] > a[i] {
            return a[i - 2] + a[i - 1] + a[i];
        }
        i -= 1;
    }
    0
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 50;
    let count = 20;
    let mut seed = 976;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..10000 {
            nums.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000);
        }
        lists.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..count {
            let p = largest_perimeter(lists[(r + i) % count]);
            total += p;
            check = (check * 31 + p) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} lists of 10000 lengths: perimeters total {total}, checksum {check}");
}
