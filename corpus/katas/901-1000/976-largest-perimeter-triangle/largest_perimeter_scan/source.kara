// LeetCode #976: Largest Perimeter Triangle -- the longest three by
// scanning.
//
// No sorting at all: one pass finds the three longest lengths, by
// position, and if they fail the longest is struck out and the pass
// repeated. Each failure means the longest is at least the sum of the
// next two, so the lengths at the top grow like Fibonacci numbers and,
// with no length above 10^6, at most 28 passes fail. O(30 n).

fn largest_perimeter(nums: Vec[i64]) -> i64 {
    let mut gone = Vec.filled(nums.len(), false);
    loop {
        // the positions of the three longest lengths still in play
        let mut top = vec![-1, -1, -1];
        for i in 0..nums.len() {
            if gone[i] {
                continue;
            }
            let mut j = 3;
            while j > 0 and (top[j - 1] < 0 or nums[i] > nums[top[j - 1]]) {
                j -= 1;
            }
            if j < 3 {
                let mut k = 2;
                while k > j {
                    top[k] = top[k - 1];
                    k -= 1;
                }
                top[j] = i;
            }
        }
        if top[2] < 0 {
            return 0;
        }
        let (c, b, a) = (nums[top[0]], nums[top[1]], nums[top[2]]);
        if a + b > c {
            return a + b + c;
        }
        gone[top[0]] = true;
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        // two draws, since one reaches only 32767
        nums.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top);
    }
    nums
}

fn main() {
    // the Fibonacci numbers up to 832040: no three of them make a triangle
    let mut fib: Vec[i64] = vec![1, 1];
    while fib.len() < 30 {
        let n = fib.len();
        fib.push(fib[n - 1] + fib[n - 2]);
    }
    let mut fib_and_three = fib.clone();
    fib_and_three.extend(vec![2, 2, 3]);
    // LeetCode's two examples, then a few more
    let cases: Vec[Vec[i64]] = vec![
        vec![2, 1, 2],
        vec![1, 2, 1, 10],
        vec![3, 2, 3, 4],
        vec![3, 6, 2, 3],
        vec![1, 1, 1],
        vec![1, 2, 3],
        vec![1000000, 1000000, 1000000],
        vec![1000000, 1, 1, 999999, 2],
        fib.clone(),
        fib_and_three,
    ];
    for nums in cases {
        println(f"{nums.len()} lengths from {nums[0]}: {largest_perimeter(nums)}");
    }
    // random lengths: 300 small, 3000 longer, then 4 of 10^4 lengths
    let mut seed = 976;
    for (count, most, top) in vec![(300, 12, 10), (3000, 60, 1000), (4, 10000, 1000000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if most == 10000 { most } else { 3 + next_random(mut seed) % (most - 2) };
            let p = largest_perimeter(random_nums(n, top, mut seed));
            total += p;
            check = (check * 31 + p) % 1000000007;
        }
        println(f"{count} random cases of up to {most} lengths: perimeters total {total}, checksum {check}");
    }
}
