// LeetCode #989: Add to Array-Form of Integer -- k carried in from the
// last digit.
//
// k is added to the last digit as if it were a carry: each digit from
// the right is added to the carry, the last digit of the carry is the
// answer's digit there, and the rest of the carry moves one place left.
// When the digits run out the carry still holds what is left of k and
// the last carry out, and gives the leading digits. The digits come
// out right to left, so the answer is reversed at the end.
// O(n + log k).

fn add_to_array_form(num: Vec[i64], k: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry = k;
    let mut i = num.len() - 1;
    while i >= 0 or carry > 0 {
        if i >= 0 {
            carry += num[i];
            i -= 1;
        }
        out.push(carry % 10);
        carry /= 10;
    }
    out.reverse();
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_num(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut d = next_random(mut seed) % 10;
        if i == 0 and d == 0 {
            d = 1;
        }
        out.push(d);
    }
    out
}

fn main() {
    let rounds = 1000;
    let mut seed = 989;
    let mut nums: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20 {
        nums.push(random_num(10000, mut seed));
    }
    let mut digits = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..20 {
            let k = 1 + next_random(mut seed) % 10000;
            let got = add_to_array_form(nums[(r + i) % 20], k);
            digits += got.len();
            for j in got.len() - 6..got.len() {
                check = (check * 31 + got[j] + 1) % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds over 20 numbers of 10000 digits: {digits} digits out, checksum {check}");
}
