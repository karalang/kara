// LeetCode #955: Delete Columns to Make Sorted II -- pairs settled.
//
// Take the columns left to right, keeping each one unless it puts some
// pair of neighbouring strings out of order. A pair is settled once a
// kept column has the upper string's letter smaller; until then the kept
// columns are equal on it, so the next column decides. A column that
// breaks an unsettled pair must go, since every kept column before it
// is equal there; keeping every column that can stay only settles more
// pairs. O(n m) for n strings of length m.

fn min_deletion_size(strs: Vec[String]) -> i64 {
    let n = strs.len();
    let m = strs[0].len();
    let mut settled: Vec[bool] = Vec.filled(n, false);
    let mut deleted = 0;
    for c in 0..m {
        let mut breaks = false;
        for i in 0..n - 1 {
            if not settled[i] and strs[i].bytes()[c] > strs[i + 1].bytes()[c] {
                breaks = true;
                break;
            }
        }
        if breaks {
            deleted += 1;
            continue;
        }
        for i in 0..n - 1 {
            if strs[i].bytes()[c] < strs[i + 1].bytes()[c] {
                settled[i] = true;
            }
        }
    }
    deleted
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n strings of m letters from the first `letters` of the alphabet.
fn random_strs(seed: mut ref i64, n: i64, m: i64, letters: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for _ in 0..n {
        let mut s = String.new();
        for _ in 0..m {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        out.push(s);
    }
    out
}

fn show(strs: ref Vec[String]) -> String {
    let mut s = String.new();
    for i in 0..strs.len() {
        if i > 0 {
            s = s + ",";
        }
        s = s + strs[i];
    }
    f"[{s}]"
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[Vec[String]] = vec![
        vec!["ca".to_string(), "bb".to_string(), "ac".to_string()],
        vec!["xc".to_string(), "yb".to_string(), "za".to_string()],
        vec!["zyx".to_string(), "wvu".to_string(), "tsr".to_string()],
        vec!["a".to_string()],
        vec!["ab".to_string(), "aa".to_string()],
        vec!["aa".to_string(), "aa".to_string()],
        vec!["xga".to_string(), "xfb".to_string(), "yfa".to_string()],
        vec!["abx".to_string(), "agz".to_string(), "bgc".to_string(), "bfc".to_string()],
        vec!["ba".to_string(), "ab".to_string(), "ab".to_string()],
    ];
    for strs in cases.iter() {
        println(f"{show(strs)}: {min_deletion_size(strs.clone())}");
    }
    // 300 random cases of 1 to 8 strings of 1 to 6 letters from a to c
    let mut seed = 955;
    let mut count = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 8;
        let m = 1 + next_random(mut seed) % 6;
        let strs = random_strs(mut seed, n, m, 3);
        let d = min_deletion_size(strs);
        count += n;
        total += d;
        check = (check * 31 + d) % 1000000007;
    }
    println(f"300 random cases of {count} strings: {total} columns deleted, checksum {check}");
    // LeetCode's largest: 100 strings of 100 letters
    let wide = random_strs(mut seed, 100, 100, 26);
    println(f"100 random strings of 100 letters: {min_deletion_size(wide.clone())}");
    let mut sorted = wide.clone();
    sorted.sort();
    println(f"the same sorted: {min_deletion_size(sorted.clone())}");
    let mut backwards: Vec[String] = Vec.new();
    for i in 0..100 {
        backwards.push(sorted[99 - i].clone());
    }
    println(f"the same sorted backwards: {min_deletion_size(backwards)}");
    let narrow = random_strs(mut seed, 100, 100, 2);
    println(f"100 random strings of 100 letters from a and b: {min_deletion_size(narrow.clone())}");
    let mut by_prefix = narrow.clone();
    by_prefix.sort_by_key(|s| s.substring(0, 9));
    println(f"the same sorted by their first 9 letters only: {min_deletion_size(by_prefix)}");
    let same: Vec[String] = Vec.filled(100, wide[0].clone());
    println(f"100 copies of one string: {min_deletion_size(same)}");
    // the strings agree except in the last column, which falls
    let mut last: Vec[String] = Vec.new();
    for i in 0..100 {
        let mut s = wide[0].clone();
        s.pop();
        s.push((b'z' - (i % 26) as u8) as char);
        last.push(s);
    }
    println(f"one string with a falling last letter: {min_deletion_size(last)}");
}
