// LeetCode #946: Validate Stack Sequences -- differential test of the
// five arms against the statement read literally, with six properties.
//
// The statement: given two integer arrays pushed and popped each with
// distinct values, return true if this could have been the result of a
// sequence of push and pop operations on an initially empty stack, or
// false otherwise. popped is a permutation of pushed.

// ---- the ★ arm: the stack replayed ----------------------------------------
fn star_validate_stack_sequences(pushed: Vec[i64], popped: Vec[i64]) -> bool {
    let mut stack: Vec[i64] = Vec.new();
    let mut j = 0;
    for v in pushed.iter() {
        stack.push(*v);
        while stack.len() > 0 and stack[stack.len() - 1] == popped[j] {
            stack.pop();
            j += 1;
        }
    }
    j == popped.len()
}

// ---- the drive arm: driven by the pops ------------------------------------
fn drive_validate_stack_sequences(pushed: Vec[i64], popped: Vec[i64]) -> bool {
    let mut stack: Vec[i64] = Vec.new();
    let mut i = 0;
    for v in popped.iter() {
        if stack.len() > 0 and stack[stack.len() - 1] == *v {
            stack.pop();
        } else {
            while i < pushed.len() and pushed[i] != *v {
                stack.push(pushed[i]);
                i += 1;
            }
            if i == pushed.len() {
                return false;
            }
            // push it and pop it at once
            i += 1;
        }
    }
    true
}

// ---- the in place arm: the stack kept in place ----------------------------
fn inplace_validate_stack_sequences(pushed: Vec[i64], popped: Vec[i64]) -> bool {
    let mut a = pushed.clone();
    let mut top = 0;
    let mut j = 0;
    for i in 0..a.len() {
        a[top] = a[i];
        top += 1;
        while top > 0 and a[top - 1] == popped[j] {
            top -= 1;
            j += 1;
        }
    }
    top == 0
}

// ---- the links arm: linked places -----------------------------------------
fn links_validate_stack_sequences(pushed: Vec[i64], popped: Vec[i64]) -> bool {
    let n = pushed.len();
    let mut place: Map[i64, i64] = Map.new();
    for i in 0..n {
        place.insert(pushed[i], i);
    }
    // below[p]: the next place under p still on the stack, -1 for none
    let mut below: Vec[i64] = Vec.new();
    for i in 0..n {
        below.push(i - 1);
    }
    let mut high = -1;
    let mut top = -1;
    for v in popped.iter() {
        let p = place.get(*v).unwrap();
        if p > high {
            // places high + 1 to p - 1 go on the stack over the top
            if p > high + 1 {
                below[high + 1] = top;
                top = p - 1;
            }
            high = p;
            // p is pushed and popped at once
        } else if p == top {
            top = below[p];
        } else {
            return false;
        }
    }
    true
}

// ---- the pattern arm: a forbidden pattern ---------------------------------
fn pattern_validate_stack_sequences(pushed: Vec[i64], popped: Vec[i64]) -> bool {
    let n = pushed.len();
    let mut place: Map[i64, i64] = Map.new();
    for i in 0..n {
        place.insert(pushed[i], i);
    }
    let mut p: Vec[i64] = Vec.new();
    for v in popped.iter() {
        p.push(place.get(*v).unwrap());
    }
    for i in 0..n {
        // the later pops below p[i] must fall
        let mut last = p[i];
        for k in (i + 1)..n {
            if p[k] < p[i] {
                if p[k] > last {
                    return false;
                }
                last = p[k];
            }
        }
    }
    true
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, pushed: Vec[i64], popped: Vec[i64]) -> bool {
    if x == 0 {
        star_validate_stack_sequences(pushed, popped)
    } else if x == 1 {
        drive_validate_stack_sequences(pushed, popped)
    } else if x == 2 {
        inplace_validate_stack_sequences(pushed, popped)
    } else if x == 3 {
        links_validate_stack_sequences(pushed, popped)
    } else {
        pattern_validate_stack_sequences(pushed, popped)
    }
}

// The statement read literally: every sequence of push and pop operations
// on an initially empty stack, a push taking the next value of pushed and
// a pop the top of the stack, run until every value has been pushed and
// popped; how many of them pop the values in the order of popped.
fn search(pushed: ref Vec[i64], i: i64, stack: mut ref Vec[i64], pops: mut ref Vec[i64], popped: ref Vec[i64]) -> i64 {
    if pops.len() == pushed.len() {
        return if pops == popped { 1 } else { 0 };
    }
    let mut count = 0;
    if i < pushed.len() {
        stack.push(pushed[i]);
        count += search(pushed, i + 1, mut stack, mut pops, popped);
        let _ = stack.pop();
    }
    if stack.len() > 0 {
        let v = stack.pop().unwrap();
        pops.push(v);
        count += search(pushed, i, mut stack, mut pops, popped);
        let _ = pops.pop();
        stack.push(v);
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n distinct values from 0 to 1000 not in used, in a random order.
fn random_values(seed: mut ref i64, n: i64, used: ref Set[i64]) -> Vec[i64] {
    let mut all: Vec[i64] = Vec.new();
    for v in 0..1001 {
        if not used.contains(v) {
            all.push(v);
        }
    }
    for i in 0..n {
        let j = i + next_random(mut seed) % (all.len() - i);
        all.swap(i, j);
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..n {
        out.push(all[i]);
    }
    out
}

// The pops of a random run of pushes and pops.
fn random_run(seed: mut ref i64, pushed: ref Vec[i64]) -> Vec[i64] {
    let mut stack: Vec[i64] = Vec.new();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while out.len() < pushed.len() {
        if i < pushed.len() and (stack.len() == 0 or next_random(mut seed) % 2 == 0) {
            stack.push(pushed[i]);
            i += 1;
        } else {
            out.push(stack.pop().unwrap());
        }
    }
    out
}

// A random order of the same values.
fn shuffled(seed: mut ref i64, values: ref Vec[i64]) -> Vec[i64] {
    let mut out = values.clone();
    for i in 0..out.len() {
        let j = i + next_random(mut seed) % (out.len() - i);
        out.swap(i, j);
    }
    out
}

// The pops for pushed: a random run, the same with two neighbouring pops
// swapped, or a random order, by kind.
fn random_pops(seed: mut ref i64, pushed: ref Vec[i64], kind: i64) -> Vec[i64] {
    if kind == 0 {
        random_run(mut seed, pushed)
    } else if kind == 1 {
        let mut out = random_run(mut seed, pushed);
        if out.len() > 1 {
            let k = next_random(mut seed) % (out.len() - 1);
            out.swap(k, k + 1);
        }
        out
    } else {
        shuffled(mut seed, pushed)
    }
}

fn reversed(v: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..v.len() {
        out.push(v[v.len() - 1 - i]);
    }
    out
}

fn without(v: ref Vec[i64], value: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for x in v.iter() {
        if *x != value {
            out.push(*x);
        }
    }
    out
}

fn joined(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    for x in b.iter() {
        out.push(*x);
    }
    out
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, pushed: Vec[i64], popped: Vec[i64], small: bool) -> bool {
    let n = pushed.len();
    let mut want = false;
    if small {
        let mut stack: Vec[i64] = Vec.new();
        let mut pops: Vec[i64] = Vec.new();
        want = search(pushed, 0, mut stack, mut pops, popped) > 0;
    }
    let mut got: Vec[bool] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, pushed, popped));
    }
    // the inputs P3 to P5 share: every value renamed, a second case of
    // other values, and a value to take out
    let mut names: Vec[i64] = Vec.new();
    for v in 0..1001 {
        names.push(v);
    }
    for i in 0..1001 {
        let j = i + next_random(mut seed) % (1001 - i);
        names.swap(i, j);
    }
    let mut renamed_pushed: Vec[i64] = Vec.new();
    let mut renamed_popped: Vec[i64] = Vec.new();
    for i in 0..n {
        renamed_pushed.push(names[pushed[i]]);
        renamed_popped.push(names[popped[i]]);
    }
    let mut used: Set[i64] = Set.new();
    for v in pushed.iter() {
        used.insert(*v);
    }
    let m = if 1000 - n < 8 { 1000 - n } else { 1 + next_random(mut seed) % 8 };
    let other_pushed = random_values(mut seed, m, used);
    let other_popped = random_pops(mut seed, other_pushed, next_random(mut seed) % 3);
    let out = pushed[next_random(mut seed) % n];
    for x in 0..5 {
        let r = got[x];
        // P1: the statement's answer, on the first 3000 cases
        if small {
            check(mut t, 1, r == want);
        }
        // P2: the operations run backwards, every push a pop and every
        // pop a push: the pops reversed pushed and the pushes reversed
        // popped, the same answer
        check(mut t, 2, arm(x, reversed(popped), reversed(pushed)) == r);
        // P3: every value renamed, the same answer
        check(mut t, 3, arm(x, renamed_pushed, renamed_popped) == r);
        // P4: followed by a second case of other values, the answer yes
        // exactly when it is yes for both
        let second = arm(x, other_pushed, other_popped);
        check(mut t, 4, arm(x, joined(pushed, other_pushed), joined(popped, other_popped)) == (r and second));
        // P5: when the answer is yes, still yes with one value taken out
        // of both
        check(mut t, 5, not r or n == 1 or arm(x, without(pushed, out), without(popped, out)));
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == r {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut t = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 946;
    let mut values = 0;
    let mut fits = 0;
    let mut check_sum = 0;
    let none: Set[i64] = Set.new();
    // 3000 cases of 1 to 7 values, against the statement, then 200 of up
    // to 999 values
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 7 } else { 1 + next_random(mut seed) % 999 };
        let pushed = random_values(mut seed, n, none);
        let popped = random_pops(mut seed, pushed, c % 3);
        values += n;
        let ok = properties(mut t, mut seed, pushed, popped, small);
        if ok {
            fits += 1;
        }
        check_sum = (check_sum * 31 + if ok { 1 } else { 2 }) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"3200 cases of {values} values, {fits} fit, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
