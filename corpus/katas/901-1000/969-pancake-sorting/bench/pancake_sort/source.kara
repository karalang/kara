// Benchmark: LeetCode #969 Pancake Sorting -- the ★ arm, the largest
// pancake to the bottom one at a time, on 200 random stacks of 100
// pancakes. Mirrors pancake_sort.c, .rs, .py and go-seq/.

fn flip(a: mut ref Vec[i64], k: i64) {
    let mut i = 0;
    let mut j = k - 1;
    while i < j {
        let t = a[i];
        a[i] = a[j];
        a[j] = t;
        i += 1;
        j -= 1;
    }
}

fn pancake_sort(arr: Vec[i64]) -> Vec[i64] {
    let mut a = arr.clone();
    let mut flips: Vec[i64] = Vec.new();
    let mut size = a.len();
    while size > 1 {
        let mut i = 0;
        while a[i] != size {
            i += 1;
        }
        if i != size - 1 {
            if i != 0 {
                flip(mut a, i + 1);
                flips.push(i + 1);
            }
            flip(mut a, size);
            flips.push(size);
        }
        size -= 1;
    }
    flips
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_permutation(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut a: Vec[i64] = Vec.new();
    for v in 1..n + 1 {
        a.push(v);
    }
    let mut i = n - 1;
    while i > 0 {
        let j = next_random(mut seed) % (i + 1);
        let t = a[i];
        a[i] = a[j];
        a[j] = t;
        i -= 1;
    }
    a
}

fn main() {
    let rounds = 100;
    let count = 200;
    let mut seed = 969;
    let mut stacks: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        stacks.push(random_permutation(100, mut seed));
    }
    let mut flips = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in 0..count {
            for k in pancake_sort(stacks[(r + s) % count]) {
                flips += 1;
                check = (check * 131 + k) % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds over {count} stacks of 100 pancakes: {flips} flips, checksum {check}");
}
