// Benchmark: LeetCode #978 Longest Turbulent Subarray -- the ★ arm, two
// running lengths, on 20 arrays of 40000 values. Mirrors
// max_turbulence_size.rs, .c, .py and go-seq/.

fn max_turbulence_size(arr: Vec[i64]) -> i64 {
    let mut best = 1;
    let mut up = 1;
    let mut down = 1;
    for i in 1..arr.len() {
        if arr[i - 1] < arr[i] {
            up = down + 1;
            down = 1;
        } else if arr[i - 1] > arr[i] {
            down = up + 1;
            up = 1;
        } else {
            up = 1;
            down = 1;
        }
        best = best.max(up.max(down));
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 150;
    let count = 20;
    let mut seed = 978;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..40000 {
            arr.push(next_random(mut seed) % 100);
        }
        arrays.push(arr);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..count {
            let k = max_turbulence_size(arrays[(r + i) % count]);
            total += k;
            check = (check * 31 + k) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} arrays of 40000 values: lengths total {total}, checksum {check}");
}
