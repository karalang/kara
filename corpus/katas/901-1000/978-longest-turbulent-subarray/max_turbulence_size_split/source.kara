// LeetCode #978: Longest Turbulent Subarray -- divide and conquer.
//
// The longest turbulent subarray of [lo, hi) lies in the left half, in
// the right half, or across the middle. One that crosses holds the pair
// (mid - 1, mid), which must be strict; from there it reaches left while
// the steps keep alternating and right the same way, and the two reaches
// together give the longest crossing one. O(n log n).

fn crossing(arr: ref Vec[i64], lo: i64, mid: i64, hi: i64) -> i64 {
    if arr[mid - 1] == arr[mid] {
        return 0;
    }
    // reach left: steps (j - 1, j) for j = mid - 1 down to lo + 1
    let mut left = mid - 1;
    while left > lo {
        let a = arr[left] - arr[left - 1];
        let b = arr[left + 1] - arr[left];
        if a == 0 or (a > 0) == (b > 0) {
            break;
        }
        left -= 1;
    }
    let mut right = mid;
    while right + 1 < hi {
        let a = arr[right] - arr[right - 1];
        let b = arr[right + 1] - arr[right];
        if b == 0 or (a > 0) == (b > 0) {
            break;
        }
        right += 1;
    }
    right - left + 1
}

fn longest(arr: ref Vec[i64], lo: i64, hi: i64) -> i64 {
    if hi - lo <= 1 {
        return hi - lo;
    }
    let mid = (lo + hi) / 2;
    let halves = longest(arr, lo, mid).max(longest(arr, mid, hi));
    halves.max(crossing(arr, lo, mid, hi))
}

fn max_turbulence_size(arr: Vec[i64]) -> i64 {
    longest(arr, 0, arr.len())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        // two draws, since one reaches only 32767
        arr.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top);
    }
    arr
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[Vec[i64]] = vec![
        vec![9, 4, 2, 10, 7, 8, 8, 1, 9],
        vec![4, 8, 12, 16],
        vec![100],
        vec![7, 7, 7],
        vec![1, 2],
        vec![2, 1, 2, 1, 2, 1],
        vec![0, 1000000000, 0, 1000000000],
        vec![1, 2, 1, 1, 2, 1, 2],
        vec![3, 3, 1, 2],
        vec![5, 4, 3, 4, 3, 4, 4, 5, 4],
    ];
    for arr in cases {
        println(f"{arr}: {max_turbulence_size(arr)}");
    }
    // random arrays: 300 small, 3000 longer, then 4 of 40000 values
    let mut seed = 978;
    for (count, most, top) in vec![(300, 12, 3), (3000, 60, 10), (4, 40000, 1000000001)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if most == 40000 { most } else { 1 + next_random(mut seed) % most };
            let k = max_turbulence_size(random_values(n, top, mut seed));
            total += k;
            check = (check * 31 + k) % 1000000007;
        }
        println(f"{count} random arrays of up to {most} values: lengths total {total}, checksum {check}");
    }
}
