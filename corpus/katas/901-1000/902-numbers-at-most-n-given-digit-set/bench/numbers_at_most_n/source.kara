// LeetCode #902: Numbers At Most N Given Digit Set -- bench program.
//
// The ★ arm (lengths, then the digits of n from the left) asked about
// every one of the 511 sets of the digits 1 to 9, built once, in turn,
// each time with a random n from 1 to 10^9, and the counts folded into a
// checksum.

fn at_most_n_given_digit_set(digits: Vec[String], n: i64) -> i64 {
    let s = n.to_string().bytes().to_vec();
    let k = s.len();
    let d = digits.len();
    let mut count = 0;
    let mut power = 1;
    for _ in 1..k {
        power *= d;
        count += power;
    }
    for i in 0..k {
        let rest = k - i - 1;
        let mut ways = 1;
        for _ in 0..rest {
            ways *= d;
        }
        let mut smaller = 0;
        let mut equal = false;
        for digit in digits.iter() {
            let c = digit.bytes()[0];
            if c < s[i] {
                smaller += 1;
            } else if c == s[i] {
                equal = true;
            }
        }
        count += smaller * ways;
        if not equal {
            return count;
        }
    }
    count + 1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let queries = 8000000;
    let mut sets: Vec[Vec[String]] = Vec.new();
    for mask in 1..512 {
        let mut digits: Vec[String] = Vec.new();
        for c in 1..10 {
            if (mask >> (c - 1)) & 1 == 1 {
                digits.push(c.to_string());
            }
        }
        sets.push(digits);
    }
    let mut seed = 902;
    let mut check = 0;
    let mut total = 0;
    for q in 0..queries {
        let n = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000;
        let got = at_most_n_given_digit_set(sets[q % 511], n);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"{queries} queries over the 511 digit sets: counts summing to {total}, checksum {check}");
}
