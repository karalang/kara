// LeetCode #902: Numbers At Most N Given Digit Set -- bijective base d.
//
// Give the set's digits the ranks 1 to d in order. The numbers made of
// them, in increasing order, are then exactly the numerals of bijective
// base d (digits 1 to d, no zero): the j-th such number has j's numeral.
// So the count is the value of the largest such number at most n, read
// in that base. Build it from n's digits: keep each digit of n that is in
// the set; at the first that is not, take the largest digit below it and
// the largest digit after, or if there is none, step the last kept digit
// with a smaller one down to it and take the largest after; if no kept
// digit has a smaller one, the number has one place fewer, all largest.
// O(log n * d).

fn at_most_n_given_digit_set(digits: Vec[String], n: i64) -> i64 {
    let s = n.to_string().bytes().to_vec();
    let k = s.len();
    let mut set: Vec[u8] = Vec.new();
    for digit in digits.iter() {
        set.push(digit.bytes()[0]);
    }
    let d = set.len();
    // the rank of the digit in the set, or 0, and of the largest below it
    let mut ranks: Vec[i64] = Vec.filled(k, 0);
    let mut i = 0;
    while i < k {
        let mut rank = 0;
        let mut below = 0;
        for j in 0..d {
            if set[j] == s[i] {
                rank = j + 1;
            } else if set[j] < s[i] {
                below = j + 1;
            }
        }
        if rank > 0 {
            ranks[i] = rank;
            i += 1;
            continue;
        }
        let mut at = i;
        if below > 0 {
            ranks[i] = below;
        } else {
            at = i - 1;
            while at >= 0 and ranks[at] == 1 {
                at -= 1;
            }
            if at < 0 {
                // one place fewer, every digit the largest
                let mut value = 0;
                for _ in 1..k {
                    value = value * d + d;
                }
                return value;
            }
            ranks[at] -= 1;
        }
        for j in at + 1..k {
            ranks[j] = d;
        }
        break;
    }
    let mut value = 0;
    for r in ranks.iter() {
        value = value * d + *r;
    }
    value
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digit_set(s: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for c in s.chars() {
        out.push(c.to_string());
    }
    out
}

fn show(s: Str, n: i64) {
    let digits = digit_set(s);
    let mut listed = String.new();
    for i in 0..digits.len() {
        if i > 0 {
            listed.push_str(", ");
        }
        listed.push_str(f"\"{digits[i]}\"");
    }
    println(f"digits = [{listed}], n = {n} -> {at_most_n_given_digit_set(digits, n)}");
}

// a random set of the digits 1 to 9, each in it with chance `keep` in 9,
// at least one, in increasing order
fn random_set(seed: mut ref i64, keep: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for c in 1..10 {
        if next_random(mut seed) % 9 < keep {
            out.push(c.to_string());
        }
    }
    if out.is_empty() {
        out.push((1 + next_random(mut seed) % 9).to_string());
    }
    out
}

// n from 1 to 10^9: random with 1 to 10 digits, or every digit from the
// set but one, which is random
fn random_n(seed: mut ref i64, digits: Vec[String], from_set: bool) -> i64 {
    let len = 1 + next_random(mut seed) % 10;
    let mut n = 0;
    let odd = next_random(mut seed) % len;
    for i in 0..len {
        let d = if from_set and i != odd {
            i64.parse(digits[next_random(mut seed) % digits.len()]).unwrap()
        } else {
            next_random(mut seed) % 10
        };
        n = n * 10 + d;
    }
    n.max(1).min(1000000000)
}

fn main() {
    show("1357", 100);
    show("149", 1000000000);
    show("7", 8);
    show("5", 5);
    show("5", 4);
    show("123456789", 1000000000);
    show("19", 919);
    show("2468", 2468);
    show("3", 1);
    // random cases: sets of every size, n random or made of the set's
    // digits but one
    let mut seed = 902;
    let mut check = 0;
    let mut sum = 0;
    for c in 0..2000 {
        let digits = random_set(mut seed, 1 + c % 9);
        let n = random_n(mut seed, digits, c % 2 == 0);
        let got = at_most_n_given_digit_set(digits, n);
        sum += got;
        check = (check * 1000003 + got) % 1000000007;
    }
    println(f"2000 cases: counts summing to {sum}, checksum {check}");
}
