// Benchmark: LeetCode #972 Equal Rational Numbers -- the ★ arm, both as
// fractions in lowest terms, on 1000 random pairs of strings. Mirrors
// is_rational_equal.c, .rs, .py and go-seq/.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

// s as numerator and denominator in lowest terms.
fn fraction(s: String) -> (i64, i64) {
    let mut whole = 0;
    let mut shift = 1;
    let mut rep = 0;
    let mut nines = 0;
    // 0 in the integer part, 1 in the non-repeating part, 2 repeating
    let mut part = 0;
    for c in s.bytes() {
        if c == b'.' {
            part = 1;
        } else if c == b'(' {
            part = 2;
        } else if c != b')' {
            let d = c as i64 - b'0' as i64;
            if part == 2 {
                rep = rep * 10 + d;
                nines = nines * 10 + 9;
            } else {
                whole = whole * 10 + d;
                if part == 1 {
                    shift *= 10;
                }
            }
        }
    }
    let (num, den) = if nines == 0 { (whole, shift) } else { (whole * nines + rep, shift * nines) };
    let g = gcd(num, den);
    (num / g, den / g)
}

fn is_rational_equal(s: String, t: String) -> bool {
    fraction(s) == fraction(t)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digits(len: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        s.push_str(f"{next_random(mut seed) % 10}");
    }
    s
}

// A number as LeetCode writes it: its integer part, non-repeating and
// repeating digits ("" when there are none), and whether a bare '.'
// follows an integer with neither.
struct Num {
    int: i64,
    non: String,
    rep: String,
    dot: bool,
}

fn text(x: ref Num) -> String {
    let mut s = f"{x.int}";
    if x.dot or x.non.len() > 0 or x.rep.len() > 0 {
        s.push_str(".");
    }
    s.push_str(x.non);
    if x.rep.len() > 0 {
        s.push_str("(");
        s.push_str(x.rep);
        s.push_str(")");
    }
    s
}

fn random_num(seed: mut ref i64) -> Num {
    let len = 1 + next_random(mut seed) % 4;
    let mut int = next_random(mut seed) % 10;
    for _ in 1..len {
        int = int * 10 + next_random(mut seed) % 10;
    }
    let non = digits(next_random(mut seed) % 5, mut seed);
    let rep = if next_random(mut seed) % 3 == 0 { String.new() } else { digits(1 + next_random(mut seed) % 4, mut seed) };
    Num { int: int, non: non, rep: rep, dot: next_random(mut seed) % 2 == 0 }
}

// The same number written another way, by one to three rewrites that
// keep every part within LeetCode's lengths.
fn variant(x: ref Num, seed: mut ref i64) -> Num {
    let mut int = x.int;
    let mut non = x.non.clone();
    let mut rep = x.rep.clone();
    let mut dot = x.dot;
    let steps = 1 + next_random(mut seed) % 3;
    for _ in 0..steps {
        let kind = next_random(mut seed) % 7;
        let r = rep.len();
        if kind == 0 and r > 0 and non.len() < 4 {
            // 0.(12) is 0.1(21)
            non.push_str(rep.substring(0, 1));
            rep = rep.substring(1) + rep.substring(0, 1);
        } else if kind == 1 and r > 0 and 2 * r <= 4 {
            // 0.(12) is 0.(1212)
            rep = rep.clone() + rep.clone();
        } else if kind == 2 and r == 0 and non.len() < 4 {
            // 0.5 is 0.50
            non.push_str("0");
        } else if kind == 3 and r == 0 {
            // 0.5 is 0.5(0)
            rep = String.from("0");
        } else if kind == 4 and r == 0 {
            // 0.5 is 0.4(9), and 3 is 2.(9)
            if non.len() > 0 and non.bytes()[non.len() - 1] != b'0' {
                let last = non.bytes()[non.len() - 1] as i64 - b'0' as i64;
                non.truncate(non.len() - 1);
                non.push_str(f"{last - 1}");
                rep = String.from("9");
            } else if non.len() == 0 and int > 0 {
                int -= 1;
                rep = String.from("9");
            }
        } else if kind == 5 and (rep == "0" or rep == "00" or rep == "000" or rep == "0000") {
            // 0.5(0) is 0.5
            rep = String.new();
            dot = true;
        } else if kind == 6 and r % 2 == 0 and r > 0 and rep.substring(0, r / 2) == rep.substring(r / 2) {
            // 0.(1212) is 0.(12)
            rep = rep.substring(0, r / 2);
        }
    }
    Num { int: int, non: non, rep: rep, dot: dot }
}

// s with one digit changed.
fn nudge(s: String, seed: mut ref i64) -> String {
    let b = s.bytes();
    let mut places: Vec[i64] = Vec.new();
    for i in 0..b.len() {
        if b[i] >= b'0' and b[i] <= b'9' {
            places.push(i);
        }
    }
    let at = places[next_random(mut seed) % places.len()];
    let old = b[at] as i64 - b'0' as i64;
    let mut new = next_random(mut seed) % 9;
    if new >= old {
        new += 1;
    }
    // keep a multi-digit integer part free of a leading zero
    if at == 0 and new == 0 and b.len() > 1 and b[1] >= b'0' and b[1] <= b'9' {
        new = 1 + old % 9;
        if new == old {
            new = 9;
        }
    }
    s.substring(0, at) + f"{new}" + s.substring(at + 1)
}

// A pair of strings: a third the same number written two ways, a third
// one of those with a digit changed, and a third two random numbers.
fn random_pair(c: i64, seed: mut ref i64) -> (String, String) {
    let x = random_num(mut seed);
    if c % 3 == 0 {
        (text(x), text(variant(x, mut seed)))
    } else if c % 3 == 1 {
        let y = text(variant(x, mut seed));
        (text(x), nudge(y, mut seed))
    } else {
        (text(x), text(random_num(mut seed)))
    }
}

fn main() {
    let rounds = 1000;
    let count = 1000;
    let mut seed = 972;
    let mut pairs: Vec[(String, String)] = Vec.new();
    for c in 0..count {
        pairs.push(random_pair(c, mut seed));
    }
    let mut equal = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..count {
            let k = (r + i) % count;
            if is_rational_equal(pairs[k].0, pairs[k].1) {
                equal += 1;
                check = (check * 2 + 1) % 1000000007;
            } else {
                check = check * 2 % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds over {count} pairs: {equal} equal, checksum {check}");
}
