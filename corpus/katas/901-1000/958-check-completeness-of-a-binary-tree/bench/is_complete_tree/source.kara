// Benchmark: LeetCode #958 Check Completeness of a Binary Tree -- the ★
// arm, the first gap, on trees of 100 nodes, LeetCode's largest. Mirrors
// is_complete_tree.c, .rs, .py and go-seq/.
//
//
// Walk the tree in level order, the missing children included as gaps.
// In a complete tree every node comes before every gap: once a gap has
// been seen, any node after it means the tree is not complete. O(n) time,
// O(width) space.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn is_complete_tree(root: Option[TreeNode]) -> bool {
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    let mut gap = false;
    while let Some(slot) = queue.pop_front() {
        match slot {
            None => gap = true,
            Some(node) => {
                if gap {
                    return false;
                }
                queue.push_back(node.left);
                queue.push_back(node.right);
            }
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn new_node(seed: mut ref i64) -> TreeNode {
    TreeNode { val: 1 + next_random(mut seed) % 1000, left: None, right: None }
}

// The complete tree of n nodes: node i's children are nodes 2i + 1 and
// 2i + 2.
fn complete_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    if n == 0 {
        return None;
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for _ in 0..n {
        nodes.push(new_node(mut seed));
    }
    for i in 1..n {
        let parent = nodes[(i - 1) / 2];
        if i % 2 == 1 {
            parent.left = Some(nodes[i]);
        } else {
            parent.right = Some(nodes[i]);
        }
    }
    Some(nodes[0])
}

// Hang a new node below root, going left or right at random down to the
// first empty place.
fn attach(root: TreeNode, node: TreeNode, seed: mut ref i64) {
    let mut cur = root;
    loop {
        if next_random(mut seed) % 2 == 0 {
            match cur.left {
                Some(l) => cur = l,
                None => {
                    cur.left = Some(node);
                    return;
                }
            }
        } else {
            match cur.right {
                Some(r) => cur = r,
                None => {
                    cur.right = Some(node);
                    return;
                }
            }
        }
    }
}

fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    if n == 0 {
        return None;
    }
    let root = new_node(mut seed);
    for _ in 1..n {
        attach(root, new_node(mut seed), mut seed);
    }
    Some(root)
}

// The nodes in level order.
fn in_order(root: TreeNode) -> Vec[TreeNode] {
    let mut out: Vec[TreeNode] = vec![root];
    let mut i = 0;
    while i < out.len() {
        let node = out[i];
        if let Some(l) = node.left {
            out.push(l);
        }
        if let Some(r) = node.right {
            out.push(r);
        }
        i += 1;
    }
    out
}

// Node i of the complete tree is a left child (side 0) when i is odd.
fn side_of(i: i64) -> i64 {
    (i + 1) % 2
}

fn set_child(parent: TreeNode, side: i64, child: Option[TreeNode]) {
    if side == 0 {
        parent.left = child;
    } else {
        parent.right = child;
    }
}

// The tree of a random case, by kind: 0 the complete tree of n nodes,
// 1 the same with its last node moved to a random empty place, 2 the same
// with a random leaf other than the root taken off, 3 a random tree, 4 the
// complete tree with the children of a random node swapped.
fn make_tree(kind: i64, n: i64, seed: mut ref i64) -> Option[TreeNode] {
    if kind == 3 {
        return random_tree(n, mut seed);
    }
    let t = complete_tree(n, mut seed);
    if n < 2 {
        return t;
    }
    let root = t.unwrap();
    let nodes = in_order(root);
    if kind == 1 {
        // the last node is node n - 1, its parent node (n - 2) / 2
        let last = nodes[n - 1];
        set_child(nodes[(n - 2) / 2], side_of(n - 1), None);
        let mut parents: Vec[TreeNode] = Vec.new();
        let mut sides: Vec[i64] = Vec.new();
        for i in 0..n - 1 {
            if nodes[i].left.is_none() {
                parents.push(nodes[i]);
                sides.push(0);
            }
            if nodes[i].right.is_none() {
                parents.push(nodes[i]);
                sides.push(1);
            }
        }
        let k = next_random(mut seed) % parents.len();
        set_child(parents[k], sides[k], Some(last));
    } else if kind == 2 {
        let mut leaves: Vec[i64] = Vec.new();
        for i in 1..n {
            if nodes[i].left.is_none() and nodes[i].right.is_none() {
                leaves.push(i);
            }
        }
        let i = leaves[next_random(mut seed) % leaves.len()];
        set_child(nodes[(i - 1) / 2], side_of(i), None);
    } else if kind == 4 {
        let node = nodes[next_random(mut seed) % n];
        let l = node.left;
        node.left = node.right;
        node.right = l;
    }
    t
}

fn main() {
    let rounds = 4000;
    // 200 trees of 100 nodes, made once, of the five kinds in turn
    let mut seed = 958;
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    for i in 0..200 {
        trees.push(make_tree(i % 5, 100, mut seed));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..200 {
            let bit = if is_complete_tree(trees[(r + i) % 200]) { 1 } else { 0 };
            total += bit;
            check = (check * 31 + bit + 1 + i) % 1000000007;
        }
    }
    println(f"{rounds} rounds over 200 trees of up to 100 nodes: {total} complete, checksum {check}");
}
