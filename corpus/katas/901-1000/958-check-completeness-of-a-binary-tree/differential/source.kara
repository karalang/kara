// LeetCode #958: Check Completeness of a Binary Tree -- differential.
//
// The five arms against the statement read literally and against each
// other, on random trees: complete trees, complete trees with their last
// node moved, with a leaf taken off or with one node's children swapped,
// and random trees.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// ---- star ----

fn star_is_complete_tree(root: Option[TreeNode]) -> bool {
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    let mut gap = false;
    while let Some(slot) = queue.pop_front() {
        match slot {
            None => gap = true,
            Some(node) => {
                if gap {
                    return false;
                }
                queue.push_back(node.left);
                queue.push_back(node.right);
            }
        }
    }
    true
}

// ---- index ----

fn index_count(t: ref Option[TreeNode]) -> i64 {
    match t {
        None => 0,
        Some(node) => 1 + index_count(node.left) + index_count(node.right),
    }
}

fn index_within(t: ref Option[TreeNode], i: i64, n: i64) -> bool {
    match t {
        None => true,
        Some(node) => i <= n and index_within(node.left, 2 * i, n) and index_within(node.right, 2 * i + 1, n),
    }
}

fn index_is_complete_tree(root: Option[TreeNode]) -> bool {
    index_within(root, 1, index_count(root))
}

// ---- heights ----

struct HeightsShape {
    height: i64,
    perfect: bool,
    complete: bool,
}

fn heights_shape(t: ref Option[TreeNode]) -> HeightsShape {
    match t {
        None => HeightsShape { height: 0, perfect: true, complete: true },
        Some(node) => {
            let l = heights_shape(node.left);
            let r = heights_shape(node.right);
            HeightsShape {
                height: 1 + l.height.max(r.height),
                perfect: l.perfect and r.perfect and l.height == r.height,
                complete: (l.perfect and r.complete and l.height == r.height)
                    or (l.complete and r.perfect and l.height == r.height + 1),
            }
        }
    }
}

fn heights_is_complete_tree(root: Option[TreeNode]) -> bool {
    heights_shape(root).complete
}

// ---- levels ----

fn levels_is_complete_tree(root: Option[TreeNode]) -> bool {
    let mut level: Vec[(TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        level.push((r, 0));
    }
    let mut width = 1;
    while level.len() > 0 {
        let mut next: Vec[(TreeNode, i64)] = Vec.new();
        for (node, p) in level.iter() {
            if let Some(l) = node.left {
                next.push((l, 2 * *p));
            }
            if let Some(r) = node.right {
                next.push((r, 2 * *p + 1));
            }
        }
        if next.len() == 0 {
            // the last level: its nodes as far left as they can be
            for j in 0..level.len() {
                if level[j].1 != j {
                    return false;
                }
            }
            return true;
        }
        if level.len() != width {
            return false;
        }
        level = next;
        width *= 2;
    }
    true
}

// ---- kinds ----

fn kinds_is_complete_tree(root: Option[TreeNode]) -> bool {
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    if let Some(r) = root {
        queue.push_back(r);
    }
    let mut leaves_only = false;
    while let Some(node) = queue.pop_front() {
        match (node.left, node.right) {
            (Some(l), Some(r)) => {
                if leaves_only {
                    return false;
                }
                queue.push_back(l);
                queue.push_back(r);
            }
            (Some(l), None) => {
                if leaves_only {
                    return false;
                }
                leaves_only = true;
                queue.push_back(l);
            }
            (None, Some(_)) => return false,
            (None, None) => leaves_only = true,
        }
    }
    true
}

// ---- harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn new_node(seed: mut ref i64) -> TreeNode {
    TreeNode { val: 1 + next_random(mut seed) % 1000, left: None, right: None }
}

// The complete tree of n nodes: node i's children are nodes 2i + 1 and
// 2i + 2.
fn complete_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    if n == 0 {
        return None;
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for _ in 0..n {
        nodes.push(new_node(mut seed));
    }
    for i in 1..n {
        let parent = nodes[(i - 1) / 2];
        if i % 2 == 1 {
            parent.left = Some(nodes[i]);
        } else {
            parent.right = Some(nodes[i]);
        }
    }
    Some(nodes[0])
}

// Hang a new node below root, going left or right at random down to the
// first empty place.
fn attach(root: TreeNode, node: TreeNode, seed: mut ref i64) {
    let mut cur = root;
    loop {
        if next_random(mut seed) % 2 == 0 {
            match cur.left {
                Some(l) => cur = l,
                None => {
                    cur.left = Some(node);
                    return;
                }
            }
        } else {
            match cur.right {
                Some(r) => cur = r,
                None => {
                    cur.right = Some(node);
                    return;
                }
            }
        }
    }
}

fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    if n == 0 {
        return None;
    }
    let root = new_node(mut seed);
    for _ in 1..n {
        attach(root, new_node(mut seed), mut seed);
    }
    Some(root)
}

// The nodes in level order.
fn in_order(root: TreeNode) -> Vec[TreeNode] {
    let mut out: Vec[TreeNode] = vec![root];
    let mut i = 0;
    while i < out.len() {
        let node = out[i];
        if let Some(l) = node.left {
            out.push(l);
        }
        if let Some(r) = node.right {
            out.push(r);
        }
        i += 1;
    }
    out
}

// Node i of the complete tree is a left child (side 0) when i is odd.
fn side_of(i: i64) -> i64 {
    (i + 1) % 2
}

fn set_child(parent: TreeNode, side: i64, child: Option[TreeNode]) {
    if side == 0 {
        parent.left = child;
    } else {
        parent.right = child;
    }
}

// The tree of a random case, by kind: 0 the complete tree of n nodes,
// 1 the same with its last node moved to a random empty place, 2 the same
// with a random leaf other than the root taken off, 3 a random tree, 4 the
// complete tree with the children of a random node swapped.
fn make_tree(kind: i64, n: i64, seed: mut ref i64) -> Option[TreeNode] {
    if kind == 3 {
        return random_tree(n, mut seed);
    }
    let t = complete_tree(n, mut seed);
    if n < 2 {
        return t;
    }
    let root = t.unwrap();
    let nodes = in_order(root);
    if kind == 1 {
        // the last node is node n - 1, its parent node (n - 2) / 2
        let last = nodes[n - 1];
        set_child(nodes[(n - 2) / 2], side_of(n - 1), None);
        let mut parents: Vec[TreeNode] = Vec.new();
        let mut sides: Vec[i64] = Vec.new();
        for i in 0..n - 1 {
            if nodes[i].left.is_none() {
                parents.push(nodes[i]);
                sides.push(0);
            }
            if nodes[i].right.is_none() {
                parents.push(nodes[i]);
                sides.push(1);
            }
        }
        let k = next_random(mut seed) % parents.len();
        set_child(parents[k], sides[k], Some(last));
    } else if kind == 2 {
        let mut leaves: Vec[i64] = Vec.new();
        for i in 1..n {
            if nodes[i].left.is_none() and nodes[i].right.is_none() {
                leaves.push(i);
            }
        }
        let i = leaves[next_random(mut seed) % leaves.len()];
        set_child(nodes[(i - 1) / 2], side_of(i), None);
    } else if kind == 4 {
        let node = nodes[next_random(mut seed) % n];
        let l = node.left;
        node.left = node.right;
        node.right = l;
    }
    t
}

fn size(t: ref Option[TreeNode]) -> i64 {
    match t {
        None => 0,
        Some(node) => 1 + size(node.left) + size(node.right),
    }
}

// The statement read literally: every level but the last completely
// filled, and the last level's nodes as far left as possible. Each node's
// depth and its place in its level, the children of the node at place p
// at places 2p and 2p + 1; used on trees of up to 8 nodes, so the places
// stay small.
fn spread(t: ref Option[TreeNode], d: i64, p: i64, count: mut ref Vec[i64], top: mut ref Vec[i64]) {
    match t {
        None => {}
        Some(node) => {
            count[d] += 1;
            top[d] = top[d].max(p);
            spread(node.left, d + 1, 2 * p, mut count, mut top);
            spread(node.right, d + 1, 2 * p + 1, mut count, mut top);
        }
    }
}

fn literal(t: ref Option[TreeNode]) -> bool {
    let mut count: Vec[i64] = Vec.filled(10, 0);
    let mut top: Vec[i64] = Vec.filled(10, 0);
    spread(t, 0, 0, mut count, mut top);
    let mut last = 0;
    while last + 1 < 10 and count[last + 1] > 0 {
        last += 1;
    }
    let mut full = 1;
    for d in 0..last {
        if count[d] != full {
            return false;
        }
        full *= 2;
    }
    // the last level's places, all different, are 0 to count - 1
    top[last] == count[last] - 1
}

fn height(t: ref Option[TreeNode]) -> i64 {
    match t {
        None => 0,
        Some(node) => 1 + height(node.left).max(height(node.right)),
    }
}

// Perfect: 2^h - 1 nodes for height h, which for at most 100 nodes needs
// h <= 6.
fn perfect(t: ref Option[TreeNode]) -> bool {
    let h = height(t);
    h <= 7 and size(t) == (1 << h) - 1
}

// The complete tree of n nodes, every value 0.
fn complete_shape(n: i64) -> Option[TreeNode] {
    if n == 0 {
        return None;
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for _ in 0..n {
        nodes.push(TreeNode { val: 0, left: None, right: None });
    }
    for i in 1..n {
        set_child(nodes[(i - 1) / 2], side_of(i), Some(nodes[i]));
    }
    Some(nodes[0])
}

fn same_shape(a: ref Option[TreeNode], b: ref Option[TreeNode]) -> bool {
    match (a, b) {
        (None, None) => true,
        (Some(x), Some(y)) => same_shape(x.left, y.left) and same_shape(x.right, y.right),
        _ => false,
    }
}

fn mirror(t: ref Option[TreeNode]) -> Option[TreeNode] {
    match t {
        None => None,
        Some(node) => Some(TreeNode { val: node.val, left: mirror(node.right), right: mirror(node.left) }),
    }
}

fn copy(t: ref Option[TreeNode]) -> Option[TreeNode] {
    match t {
        None => None,
        Some(node) => Some(TreeNode { val: node.val, left: copy(node.left), right: copy(node.right) }),
    }
}

// A copy with one node more, at heap number n + 1 for a tree of n nodes
// (the root 1, the children of i 2i and 2i + 1): the binary digits of
// n + 1 after the first say left (0) or right (1) on the way down. None
// when a node on the way is missing or the place is taken.
fn grafted(t: ref Option[TreeNode]) -> Option[TreeNode] {
    let u = copy(t);
    let target = size(t) + 1;
    let mut bit = 1;
    while bit * 2 <= target {
        bit *= 2;
    }
    bit /= 2;
    let mut cur = u.unwrap();
    while bit > 1 {
        let next = if target & bit == 0 { cur.left } else { cur.right };
        match next {
            None => return None,
            Some(c) => cur = c,
        }
        bit /= 2;
    }
    let side = if target & 1 == 0 { 0 } else { 1 };
    let place = if side == 0 { cur.left } else { cur.right };
    if place.is_some() {
        return None;
    }
    set_child(cur, side, Some(TreeNode { val: 0, left: None, right: None }));
    u
}

fn arm(x: i64, t: Option[TreeNode]) -> bool {
    if x == 0 {
        star_is_complete_tree(t)
    } else if x == 1 {
        index_is_complete_tree(t)
    } else if x == 2 {
        heights_is_complete_tree(t)
    } else if x == 3 {
        levels_is_complete_tree(t)
    } else {
        kinds_is_complete_tree(t)
    }
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, tree: Option[TreeNode], small: bool) -> bool {
    let truth = if small { literal(tree) } else { false };
    let mut got: Vec[bool] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, tree));
    }
    let shape_ok = same_shape(tree, complete_shape(size(tree)));
    let flipped = mirror(tree);
    let is_perfect = perfect(tree);
    let root = tree.unwrap();
    let (l, r) = (root.left, root.right);
    let (hl, hr) = (height(l), height(r));
    let (pl, pr) = (perfect(l), perfect(r));
    let more = grafted(tree);
    for x in 0..5 {
        let a = got[x];
        // P1: the statement's answer, on the first 3000 trees
        if small {
            check(mut t, 1, a == truth);
        }
        // P2: complete exactly when the tree has the shape of the complete
        // tree of as many nodes
        check(mut t, 2, a == shape_ok);
        // P3: the tree and its mirror both complete exactly when perfect
        check(mut t, 3, (a and arm(x, flipped)) == is_perfect);
        // P4: complete exactly when the left subtree is perfect and the
        // right complete with the same height, or the left complete and
        // the right perfect and one shorter
        let parts = (pl and arm(x, r) and hl == hr) or (arm(x, l) and pr and hl == hr + 1);
        check(mut t, 4, a == parts);
        // P5: complete exactly when a node can be put at the next heap
        // place and the tree is complete with it
        let with_more = match more {
            None => false,
            Some(_) => arm(x, more),
        };
        check(mut t, 5, a == with_more);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == a {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut t = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 958;
    let mut nodes = 0;
    let mut yes = 0;
    let mut check_sum = 0;
    // 3000 trees of up to 8 nodes, against the statement, then 200 of up
    // to 100 nodes; complete trees, complete trees with the last node
    // moved, a leaf taken off or one node's children swapped, and random
    // trees
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 8 } else { 1 + next_random(mut seed) % 100 };
        let kind = next_random(mut seed) % 5;
        let tree = make_tree(kind, n, mut seed);
        nodes += size(tree);
        let r = properties(mut t, tree, small);
        let bit = if r { 1 } else { 0 };
        yes += bit;
        check_sum = (check_sum * 31 + bit + 1) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"3200 trees of {nodes} nodes, {yes} complete, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
