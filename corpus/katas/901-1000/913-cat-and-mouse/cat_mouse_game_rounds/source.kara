// LeetCode #913: Cat and Mouse -- the positions swept until nothing
// changes.
//
// Start with only the game's ends known: the mouse in the hole is the
// mouse's win, the cat on the mouse the cat's. Then sweep every position
// still unknown: it is the mover's win if some move reaches the mover's
// win, and the other player's if every move reaches the other player's.
// Repeat until a sweep settles nothing. What is left unknown is a draw.
// Each sweep settles at least one position, so O(n^4) at worst.

fn cat_mouse_game(graph: Vec[Vec[i64]]) -> i64 {
    let n = graph.len();
    // mouse[m][c] for the mouse to move, cat[m][c] for the cat: 1 a mouse
    // win, 2 a cat win, 0 not yet known
    let mut mouse: Vec[Vec[i64]] = Vec.new();
    let mut cat: Vec[Vec[i64]] = Vec.new();
    for m in 0..n {
        let mut row: Vec[i64] = Vec.filled(n, 0);
        for c in 1..n {
            if m == 0 {
                row[c] = 1;
            } else if m == c {
                row[c] = 2;
            }
        }
        mouse.push(row.clone());
        cat.push(row);
    }
    let mut changed = true;
    while changed {
        changed = false;
        for m in 1..n {
            for c in 1..n {
                if mouse[m][c] == 0 {
                    let mut all_lost = true;
                    let mut won = false;
                    for next in graph[m].iter() {
                        let r = cat[*next][c];
                        if r == 1 {
                            won = true;
                        }
                        if r != 2 {
                            all_lost = false;
                        }
                    }
                    if won {
                        mouse[m][c] = 1;
                        changed = true;
                    } else if all_lost {
                        mouse[m][c] = 2;
                        changed = true;
                    }
                }
                if cat[m][c] == 0 {
                    let mut all_lost = true;
                    let mut won = false;
                    for next in graph[c].iter() {
                        if *next != 0 {
                            let r = mouse[m][*next];
                            if r == 2 {
                                won = true;
                            }
                            if r != 1 {
                                all_lost = false;
                            }
                        }
                    }
                    if won {
                        cat[m][c] = 2;
                        changed = true;
                    } else if all_lost {
                        cat[m][c] = 1;
                        changed = true;
                    }
                }
            }
        }
    }
    mouse[1][2]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(graph: Vec[Vec[i64]]) {
    let mut s = String.new();
    for i in 0..graph.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str("[");
        for j in 0..graph[i].len() {
            if j > 0 {
                s.push_str(",");
            }
            s.push_str(f"{graph[i][j]}");
        }
        s.push_str("]");
    }
    println(f"graph = [{s}]: {cat_mouse_game(graph)}");
}

// A random graph on n nodes, each edge present with chance `per` in 1000
// (a quarter of that for edges at the hole), then mended so that every
// node has a neighbour and every node but the hole a neighbour other than
// the hole: the mouse and the cat can always move.
fn random_graph(seed: mut ref i64, n: i64, per: i64) -> Vec[Vec[i64]] {
    let mut adj: Vec[bool] = Vec.filled(n * n, false);
    for u in 0..n {
        for v in u + 1..n {
            let chance = if u == 0 { per / 4 } else { per };
            if next_random(mut seed) % 1000 < chance {
                adj[u * n + v] = true;
                adj[v * n + u] = true;
            }
        }
    }
    for v in 1..n {
        let mut alone = true;
        for u in 1..n {
            if adj[v * n + u] {
                alone = false;
            }
        }
        if alone {
            let mut u = 1 + next_random(mut seed) % (n - 2);
            if u >= v {
                u += 1;
            }
            adj[u * n + v] = true;
            adj[v * n + u] = true;
        }
    }
    let mut hole_alone = true;
    for u in 1..n {
        if adj[u] {
            hole_alone = false;
        }
    }
    if hole_alone {
        let u = 1 + next_random(mut seed) % (n - 1);
        adj[u] = true;
        adj[u * n] = true;
    }
    let mut graph: Vec[Vec[i64]] = Vec.new();
    for v in 0..n {
        let mut near: Vec[i64] = Vec.new();
        for u in 0..n {
            if adj[v * n + u] {
                near.push(u);
            }
        }
        graph.push(near);
    }
    graph
}

fn main() {
    show(vec![vec![2, 5], vec![3], vec![0, 4, 5], vec![1, 4, 5], vec![2, 3], vec![0, 2, 3]]);
    show(vec![vec![1, 3], vec![0], vec![3], vec![0, 2]]);
    show(vec![vec![2], vec![2], vec![0, 1]]);
    show(vec![vec![1, 2], vec![0, 2], vec![0, 1]]);
    show(vec![vec![3], vec![2, 4], vec![1, 3, 4], vec![0, 2], vec![1, 2]]);
    // random graphs of 3 to 50 nodes, sparse to dense
    let mut seed = 913;
    let mut wins: Vec[i64] = vec![0, 0, 0];
    let mut check = 0;
    for c in 0..300 {
        let n = 3 + next_random(mut seed) % 48;
        let per = if c % 4 == 0 { 20 } else if c % 4 == 1 { 60 } else if c % 4 == 2 { 150 } else { 400 };
        let r = cat_mouse_game(random_graph(mut seed, n, per));
        wins[r] += 1;
        check = (check * 7 + r) % 1000000007;
    }
    println(f"300 graphs: {wins[0]} draws, {wins[1]} mouse wins, {wins[2]} cat wins, checksum {check}");
    // LeetCode's largest: 50 nodes
    for per in vec![30, 100, 1000] {
        println(f"50 nodes, edges at {per} in 1000: {cat_mouse_game(random_graph(mut seed, 50, per))}");
    }
}
