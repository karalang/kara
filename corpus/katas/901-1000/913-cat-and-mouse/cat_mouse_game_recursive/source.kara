// LeetCode #913: Cat and Mouse -- retrograde analysis by recursion: each
// position settled passes the news to the positions one move before it.
//
// Mark the game's ends first: the mouse in the hole is the mouse's win,
// the cat on the mouse the cat's. Then spread from each. A position one
// move before a settled one is settled when the player to move there can
// move into its own win, or when its last move not known to lose has
// just been found to lose; either way it spreads in turn, at once. What
// is never settled is a draw. O(n^3), with recursion as deep as the
// longest chain of forced positions.

fn spread(graph: Vec[Vec[i64]], result: mut ref Vec[i64], left: mut ref Vec[i64], s: i64) {
    let n = graph.len();
    let t = s % 2;
    let c = s / 2 % n;
    let m = s / 2 / n;
    let won = result[s];
    if t == 1 {
        // the mouse moved here, from a neighbour of m
        for pm in graph[m].iter() {
            let p = (*pm * n + c) * 2;
            if result[p] == 0 {
                if won == 1 {
                    result[p] = 1;
                    spread(graph, mut result, mut left, p);
                } else {
                    left[p] -= 1;
                    if left[p] == 0 {
                        result[p] = 2;
                        spread(graph, mut result, mut left, p);
                    }
                }
            }
        }
    } else {
        // the cat moved here, from a neighbour of c other than the hole
        for pc in graph[c].iter() {
            if *pc != 0 {
                let p = (m * n + *pc) * 2 + 1;
                if result[p] == 0 {
                    if won == 2 {
                        result[p] = 2;
                        spread(graph, mut result, mut left, p);
                    } else {
                        left[p] -= 1;
                        if left[p] == 0 {
                            result[p] = 1;
                            spread(graph, mut result, mut left, p);
                        }
                    }
                }
            }
        }
    }
}

fn cat_mouse_game(graph: Vec[Vec[i64]]) -> i64 {
    let n = graph.len();
    let mut result: Vec[i64] = Vec.filled(n * n * 2, 0);
    let mut left: Vec[i64] = Vec.filled(n * n * 2, 0);
    for m in 0..n {
        for c in 1..n {
            left[(m * n + c) * 2] = graph[m].len();
            for d in graph[c].iter() {
                if *d != 0 {
                    left[(m * n + c) * 2 + 1] += 1;
                }
            }
        }
    }
    for c in 1..n {
        for t in 0..2 {
            result[c * 2 + t] = 1;
            result[(c * n + c) * 2 + t] = 2;
        }
    }
    for c in 1..n {
        for t in 0..2 {
            spread(graph, mut result, mut left, c * 2 + t);
            spread(graph, mut result, mut left, (c * n + c) * 2 + t);
        }
    }
    result[(n + 2) * 2]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(graph: Vec[Vec[i64]]) {
    let mut s = String.new();
    for i in 0..graph.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str("[");
        for j in 0..graph[i].len() {
            if j > 0 {
                s.push_str(",");
            }
            s.push_str(f"{graph[i][j]}");
        }
        s.push_str("]");
    }
    println(f"graph = [{s}]: {cat_mouse_game(graph)}");
}

// A random graph on n nodes, each edge present with chance `per` in 1000
// (a quarter of that for edges at the hole), then mended so that every
// node has a neighbour and every node but the hole a neighbour other than
// the hole: the mouse and the cat can always move.
fn random_graph(seed: mut ref i64, n: i64, per: i64) -> Vec[Vec[i64]] {
    let mut adj: Vec[bool] = Vec.filled(n * n, false);
    for u in 0..n {
        for v in u + 1..n {
            let chance = if u == 0 { per / 4 } else { per };
            if next_random(mut seed) % 1000 < chance {
                adj[u * n + v] = true;
                adj[v * n + u] = true;
            }
        }
    }
    for v in 1..n {
        let mut alone = true;
        for u in 1..n {
            if adj[v * n + u] {
                alone = false;
            }
        }
        if alone {
            let mut u = 1 + next_random(mut seed) % (n - 2);
            if u >= v {
                u += 1;
            }
            adj[u * n + v] = true;
            adj[v * n + u] = true;
        }
    }
    let mut hole_alone = true;
    for u in 1..n {
        if adj[u] {
            hole_alone = false;
        }
    }
    if hole_alone {
        let u = 1 + next_random(mut seed) % (n - 1);
        adj[u] = true;
        adj[u * n] = true;
    }
    let mut graph: Vec[Vec[i64]] = Vec.new();
    for v in 0..n {
        let mut near: Vec[i64] = Vec.new();
        for u in 0..n {
            if adj[v * n + u] {
                near.push(u);
            }
        }
        graph.push(near);
    }
    graph
}

fn main() {
    show(vec![vec![2, 5], vec![3], vec![0, 4, 5], vec![1, 4, 5], vec![2, 3], vec![0, 2, 3]]);
    show(vec![vec![1, 3], vec![0], vec![3], vec![0, 2]]);
    show(vec![vec![2], vec![2], vec![0, 1]]);
    show(vec![vec![1, 2], vec![0, 2], vec![0, 1]]);
    show(vec![vec![3], vec![2, 4], vec![1, 3, 4], vec![0, 2], vec![1, 2]]);
    // random graphs of 3 to 50 nodes, sparse to dense
    let mut seed = 913;
    let mut wins: Vec[i64] = vec![0, 0, 0];
    let mut check = 0;
    for c in 0..300 {
        let n = 3 + next_random(mut seed) % 48;
        let per = if c % 4 == 0 { 20 } else if c % 4 == 1 { 60 } else if c % 4 == 2 { 150 } else { 400 };
        let r = cat_mouse_game(random_graph(mut seed, n, per));
        wins[r] += 1;
        check = (check * 7 + r) % 1000000007;
    }
    println(f"300 graphs: {wins[0]} draws, {wins[1]} mouse wins, {wins[2]} cat wins, checksum {check}");
    // LeetCode's largest: 50 nodes
    for per in vec![30, 100, 1000] {
        println(f"50 nodes, edges at {per} in 1000: {cat_mouse_game(random_graph(mut seed, 50, per))}");
    }
}
