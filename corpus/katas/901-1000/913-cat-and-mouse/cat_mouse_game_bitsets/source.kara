// LeetCode #913: Cat and Mouse -- the outcomes kept as bitsets of mouse
// positions, swept until nothing changes.
//
// For each cat position c keep four sets of mouse positions: those won by
// the mouse and those won by the cat, with the mouse to move and with the
// cat to move. A graph has at most 50 nodes, so each set is one i64. The
// mouse to move at m wins if a neighbour of m is in the mouse's set for
// the cat to move, and loses if every neighbour is in the cat's. The cat
// to move at c sweeps every mouse position at once: the cat wins where
// any of c's neighbours (but the hole) is in the cat's set for the mouse
// to move, an OR, and loses where all of them are in the mouse's, an
// AND. Sweep until no set grows; a start in neither set is a draw.

fn cat_mouse_game(graph: Vec[Vec[i64]]) -> i64 {
    let n = graph.len();
    let mut near: Vec[i64] = Vec.filled(n, 0);
    for v in 0..n {
        for u in graph[v].iter() {
            near[v] = near[v] | (1 << *u);
        }
    }
    let every = (1 << n) - 1;
    // [c]: the mouse positions won by the mouse (or the cat), with the
    // mouse (or the cat) to move
    let mut mouse_won_mouse: Vec[i64] = Vec.filled(n, 1);
    let mut mouse_won_cat: Vec[i64] = Vec.filled(n, 1);
    let mut cat_won_mouse: Vec[i64] = Vec.filled(n, 0);
    let mut cat_won_cat: Vec[i64] = Vec.filled(n, 0);
    for c in 1..n {
        cat_won_mouse[c] = 1 << c;
        cat_won_cat[c] = 1 << c;
    }
    let mut changed = true;
    while changed {
        changed = false;
        for c in 1..n {
            for m in 1..n {
                let bit = 1 << m;
                if m != c and (mouse_won_mouse[c] & bit) == 0 and (cat_won_mouse[c] & bit) == 0 {
                    if (near[m] & mouse_won_cat[c]) != 0 {
                        mouse_won_mouse[c] = mouse_won_mouse[c] | bit;
                        changed = true;
                    } else if (near[m] & cat_won_cat[c]) == near[m] {
                        cat_won_mouse[c] = cat_won_mouse[c] | bit;
                        changed = true;
                    }
                }
            }
            let mut some = 0;
            let mut all = every;
            for d in graph[c].iter() {
                if *d != 0 {
                    some = some | cat_won_mouse[*d];
                    all = all & mouse_won_mouse[*d];
                }
            }
            // the cat on the mouse stays the cat's win
            let cat_won = cat_won_cat[c] | some;
            let mouse_won = mouse_won_cat[c] | (all & ~(1 << c));
            if cat_won != cat_won_cat[c] or mouse_won != mouse_won_cat[c] {
                cat_won_cat[c] = cat_won;
                mouse_won_cat[c] = mouse_won;
                changed = true;
            }
        }
    }
    if (mouse_won_mouse[2] & 2) != 0 {
        1
    } else if (cat_won_mouse[2] & 2) != 0 {
        2
    } else {
        0
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(graph: Vec[Vec[i64]]) {
    let mut s = String.new();
    for i in 0..graph.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str("[");
        for j in 0..graph[i].len() {
            if j > 0 {
                s.push_str(",");
            }
            s.push_str(f"{graph[i][j]}");
        }
        s.push_str("]");
    }
    println(f"graph = [{s}]: {cat_mouse_game(graph)}");
}

// A random graph on n nodes, each edge present with chance `per` in 1000
// (a quarter of that for edges at the hole), then mended so that every
// node has a neighbour and every node but the hole a neighbour other than
// the hole: the mouse and the cat can always move.
fn random_graph(seed: mut ref i64, n: i64, per: i64) -> Vec[Vec[i64]] {
    let mut adj: Vec[bool] = Vec.filled(n * n, false);
    for u in 0..n {
        for v in u + 1..n {
            let chance = if u == 0 { per / 4 } else { per };
            if next_random(mut seed) % 1000 < chance {
                adj[u * n + v] = true;
                adj[v * n + u] = true;
            }
        }
    }
    for v in 1..n {
        let mut alone = true;
        for u in 1..n {
            if adj[v * n + u] {
                alone = false;
            }
        }
        if alone {
            let mut u = 1 + next_random(mut seed) % (n - 2);
            if u >= v {
                u += 1;
            }
            adj[u * n + v] = true;
            adj[v * n + u] = true;
        }
    }
    let mut hole_alone = true;
    for u in 1..n {
        if adj[u] {
            hole_alone = false;
        }
    }
    if hole_alone {
        let u = 1 + next_random(mut seed) % (n - 1);
        adj[u] = true;
        adj[u * n] = true;
    }
    let mut graph: Vec[Vec[i64]] = Vec.new();
    for v in 0..n {
        let mut near: Vec[i64] = Vec.new();
        for u in 0..n {
            if adj[v * n + u] {
                near.push(u);
            }
        }
        graph.push(near);
    }
    graph
}

fn main() {
    show(vec![vec![2, 5], vec![3], vec![0, 4, 5], vec![1, 4, 5], vec![2, 3], vec![0, 2, 3]]);
    show(vec![vec![1, 3], vec![0], vec![3], vec![0, 2]]);
    show(vec![vec![2], vec![2], vec![0, 1]]);
    show(vec![vec![1, 2], vec![0, 2], vec![0, 1]]);
    show(vec![vec![3], vec![2, 4], vec![1, 3, 4], vec![0, 2], vec![1, 2]]);
    // random graphs of 3 to 50 nodes, sparse to dense
    let mut seed = 913;
    let mut wins: Vec[i64] = vec![0, 0, 0];
    let mut check = 0;
    for c in 0..300 {
        let n = 3 + next_random(mut seed) % 48;
        let per = if c % 4 == 0 { 20 } else if c % 4 == 1 { 60 } else if c % 4 == 2 { 150 } else { 400 };
        let r = cat_mouse_game(random_graph(mut seed, n, per));
        wins[r] += 1;
        check = (check * 7 + r) % 1000000007;
    }
    println(f"300 graphs: {wins[0]} draws, {wins[1]} mouse wins, {wins[2]} cat wins, checksum {check}");
    // LeetCode's largest: 50 nodes
    for per in vec![30, 100, 1000] {
        println(f"50 nodes, edges at {per} in 1000: {cat_mouse_game(random_graph(mut seed, 50, per))}");
    }
}
