// LeetCode #916: Word Subsets -- bench: every word of words2 folded into one
// need, the largest count of each letter.
//
// A word a is universal when, for each letter, it holds at least as many
// as each word of words2 does: at least the largest count of that letter
// over words2. So fold words2 into those 26 largest counts once, then
// keep each word of words1 whose own counts reach all 26. O(total length
// + 26 * (|words1| + |words2|)).

fn counts(word: String) -> Array[i64, 26] {
    let mut count: Array[i64, 26] = [0; 26];
    for b in word.bytes() {
        count[(b - b'a') as i64] += 1;
    }
    count
}

fn word_subsets(words1: Vec[String], words2: Vec[String]) -> Vec[String] {
    let mut need: Array[i64, 26] = [0; 26];
    for b in words2.iter() {
        let count = counts(*b);
        for c in 0..26 {
            need[c] = need[c].max(count[c]);
        }
    }
    let mut universal: Vec[String] = Vec.new();
    for a in words1.iter() {
        let count = counts(*a);
        let mut all = true;
        for c in 0..26 {
            if count[c] < need[c] {
                all = false;
            }
        }
        if all {
            universal.push(a.clone());
        }
    }
    universal
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A word of `len` letters from the first `letters` of the alphabet.
fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    w
}

fn main() {
    let rounds = 200;
    let n = 50000;
    let mut seed = 916;
    // 50000 words of 10 letters from a..h
    let mut words1: Vec[String] = Vec.new();
    for _ in 0..n {
        words1.push(random_word(mut seed, 10, 8));
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..rounds {
        // three words of 1 to 3 letters from a..h
        let mut words2: Vec[String] = Vec.new();
        for _ in 0..3 {
            let len = 1 + next_random(mut seed) % 3;
            words2.push(random_word(mut seed, len, 8));
        }
        let universal = word_subsets(words1, words2);
        total += universal.len();
        for w in universal.iter() {
            for b in w.bytes() {
                check = (check * 31 + b as i64) % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds over {n} words: {total} universal, checksum {check}");
}
