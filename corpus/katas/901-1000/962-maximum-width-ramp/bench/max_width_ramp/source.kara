// Benchmark: LeetCode #962 Maximum Width Ramp -- the ★ arm, decreasing
// stack, on 50000 numbers, LeetCode's largest, falling overall with
// noise, so the stack of prefix minima is long and most of it is popped.
// Each call first sets one number to a new random value, so no two calls
// see the same array. Mirrors max_width_ramp.c, .rs, .py and go-seq/.
fn max_width_ramp(nums: ref Vec[i64]) -> i64 {
    let n = nums.len();
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        if stack.is_empty() or nums[i] < nums[stack[stack.len() - 1]] {
            stack.push(i);
        }
    }
    let mut best = 0;
    let mut j = n - 1;
    while j >= 0 and not stack.is_empty() {
        while not stack.is_empty() and nums[stack[stack.len() - 1]] <= nums[j] {
            best = best.max(j - stack[stack.len() - 1]);
            stack.pop();
        }
        j -= 1;
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n numbers falling by one every `step` places from 50000 - noise, each
// with up to `noise` added.
fn falling(seed: mut ref i64, n: i64, step: i64, noise: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for p in 0..n {
        out.push(50000 - noise - p / step + next_random(mut seed) % (noise + 1));
    }
    out
}

fn main() {
    let rounds = 40;
    // 50 cases of 50000 numbers, made once
    let mut seed = 962;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for i in 0..50 {
        cases.push(falling(mut seed, 50000, 1 + i % 5, 10 * (i / 5)));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..50 {
            let c = (r + i) % 50;
            let p = next_random(mut seed) % 50000;
            cases[c][p] = next_random(mut seed) % 50001;
            let w = max_width_ramp(cases[c]);
            total += w;
            check = (check * 31 + w + i) % 1000000007;
        }
    }
    println(f"{rounds} rounds over 50 cases of 50000 numbers: the ramps sum to {total}, checksum {check}");
}
