// Benchmark: LeetCode #973 K Closest Points to Origin -- the ★ arm, sort
// by squared distance, on 100 sets of 1000 random points. Mirrors
// k_closest.rs, .c, .py and go-seq/.

fn k_closest(points: Vec[(i64, i64)], k: i64) -> Vec[(i64, i64)] {
    let mut sorted = points.clone();
    sorted.sort_by_key(|p| p.0 * p.0 + p.1 * p.1);
    sorted.truncate(k);
    sorted
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n points over LeetCode's whole range, and a k whose k closest points
// are unique: the first at or after a random place whose distance is
// below the next one, or n.
fn random_case(n: i64, seed: mut ref i64) -> (Vec[(i64, i64)], i64) {
    let mut points: Vec[(i64, i64)] = Vec.new();
    for _ in 0..n {
        let x = next_random(mut seed) % 20001 - 10000;
        let y = next_random(mut seed) % 20001 - 10000;
        points.push((x, y));
    }
    let mut ds: Vec[i64] = Vec.new();
    for p in points {
        ds.push(p.0 * p.0 + p.1 * p.1);
    }
    ds.sort();
    let mut k = 1 + next_random(mut seed) % n;
    while k < n and ds[k - 1] == ds[k] {
        k += 1;
    }
    (points, k)
}

fn main() {
    let rounds = 100;
    let count = 100;
    let mut seed = 973;
    let mut cases: Vec[(Vec[(i64, i64)], i64)] = Vec.new();
    for _ in 0..count {
        cases.push(random_case(1000, mut seed));
    }
    let mut kept = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..count {
            let c = (r + i) % count;
            let answer = k_closest(cases[c].0, cases[c].1);
            kept += answer.len();
            // the answer's order is free, so fold it order-independently
            for (x, y) in answer {
                let v = ((x + 10001) * 20003 + y + 10001) % 1000000007;
                check = (check + v * v) % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds over {count} sets of 1000 points: {kept} points kept, checksum {check}");
}
