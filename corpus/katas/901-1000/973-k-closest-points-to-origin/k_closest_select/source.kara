// LeetCode #973: K Closest Points to Origin -- quickselect.
//
// Partition a copy in place around the middle point's squared distance,
// the closer points to the left, and keep partitioning only the side
// that holds position k until the first k places are the k closest. O(n)
// on average.

fn dist(p: (i64, i64)) -> i64 {
    p.0 * p.0 + p.1 * p.1
}

fn k_closest(points: Vec[(i64, i64)], k: i64) -> Vec[(i64, i64)] {
    let mut a = points.clone();
    let mut lo = 0;
    let mut hi = a.len() - 1;
    while lo < hi {
        let pivot = dist(a[(lo + hi) / 2]);
        let mut i = lo;
        let mut j = hi;
        // Hoare's scheme: afterwards a[lo..j] <= pivot <= a[i..hi]
        while i <= j {
            while dist(a[i]) < pivot {
                i += 1;
            }
            while dist(a[j]) > pivot {
                j -= 1;
            }
            if i <= j {
                a.swap(i, j);
                i += 1;
                j -= 1;
            }
        }
        if k - 1 <= j {
            hi = j;
        } else if k - 1 >= i {
            lo = i;
        } else {
            break;
        }
    }
    a.truncate(k);
    a
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n points with coordinates in [-span, span], and a k whose k closest
// points are unique: the k-th smallest squared distance is below the
// next one, or k is n.
fn random_case(n: i64, span: i64, seed: mut ref i64) -> (Vec[(i64, i64)], i64) {
    let mut points: Vec[(i64, i64)] = Vec.new();
    for _ in 0..n {
        let x = next_random(mut seed) % (2 * span + 1) - span;
        let y = next_random(mut seed) % (2 * span + 1) - span;
        points.push((x, y));
    }
    let mut ds: Vec[i64] = Vec.new();
    for p in points {
        ds.push(p.0 * p.0 + p.1 * p.1);
    }
    ds.sort();
    let mut ks: Vec[i64] = Vec.new();
    for k in 1..n {
        if ds[k - 1] < ds[k] {
            ks.push(k);
        }
    }
    ks.push(n);
    let k = ks[next_random(mut seed) % ks.len()];
    (points, k)
}

// The answer in a fixed order, since any order is accepted.
fn show(answer: Vec[(i64, i64)]) -> String {
    let mut sorted = answer.clone();
    sorted.sort();
    let mut s = String.from("[");
    for i in 0..sorted.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str(f"[{sorted[i].0},{sorted[i].1}]");
    }
    s.push_str("]");
    s
}

fn fold(check: i64, answer: Vec[(i64, i64)]) -> i64 {
    let mut sorted = answer.clone();
    sorted.sort();
    let mut c = check;
    for (x, y) in sorted {
        c = (c * 31 + (x + 10001) * 20003 + y + 10001) % 1000000007;
    }
    c
}

fn main() {
    // LeetCode's two examples, then a few more
    let cases: Vec[(Vec[(i64, i64)], i64)] = vec![
        (vec![(1, 3), (-2, 2)], 1),
        (vec![(3, 3), (5, -1), (-2, 4)], 2),
        (vec![(0, 0)], 1),
        (vec![(1, 0), (0, 1), (-1, 0), (0, -1), (2, 2)], 4),
        (vec![(1, 0), (0, 1), (-1, 0), (0, -1), (2, 2)], 5),
        (vec![(10000, 10000), (-10000, -10000), (1, -1)], 1),
        (vec![(10000, -10000), (-10000, 10000), (0, 0)], 3),
        (vec![(3, 4), (5, 0), (0, -5), (1, 1), (6, 0)], 1),
        (vec![(3, 4), (5, 0), (0, -5), (1, 1), (6, 0)], 4),
        (vec![(2, 2), (2, 2), (1, 1), (3, 3)], 3),
    ];
    for (points, k) in cases {
        println(f"k = {k}: {show(k_closest(points, k))}");
    }
    // random cases: 300 small, 3000 wider, then 4 of 10^4 points
    let mut seed = 973;
    for (count, most, span) in vec![(300, 12, 5), (3000, 40, 100), (4, 10000, 10000)] {
        let mut total = 0;
        let mut check = 0;
        for c in 0..count {
            let n = if most == 10000 { most } else { 1 + next_random(mut seed) % most };
            let (points, k) = random_case(n, span, mut seed);
            let answer = k_closest(points, k);
            total += answer.len();
            check = fold(check, answer);
        }
        println(f"{count} random cases of up to {most} points: {total} points kept, checksum {check}");
    }
}
