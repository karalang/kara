// LeetCode #927: Three Equal Parts -- differential test of the five arms
// against the statement read literally, with six properties.
//
// The statement: you are given an array arr which consists of only zeros
// and ones, divide the array into three non-empty parts such that all of
// these parts represent the same binary value. If it is possible, return
// any [i, j] with i + 1 < j, such that: arr[0], arr[1], ..., arr[i] is the
// first part, arr[i + 1], arr[i + 2], ..., arr[j - 1] is the second part,
// and arr[j], arr[j + 1], ..., arr[arr.length - 1] is the third part. All
// three parts have equal binary values. If it is not possible, return
// [-1, -1]. Note that the entire part is used when considering what
// binary value it represents. For example, [1,1,0] represents 6 in
// decimal, not 3. Also, leading zeros are allowed, so [0,1,1] and [1,1]
// represent the same value.

// ---- the ★ arm: three pointers --------------------------------------------
fn star_three_equal_parts(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut ones = 0;
    for v in arr.iter() {
        ones += *v;
    }
    if ones == 0 {
        return vec![0, n - 1];
    }
    if ones % 3 != 0 {
        return vec![-1, -1];
    }
    let third = ones / 3;
    // the first 1 of each third of the 1s
    let mut starts: Vec[i64] = Vec.new();
    let mut seen = 0;
    for k in 0..n {
        if arr[k] == 1 {
            if seen % third == 0 {
                starts.push(k);
            }
            seen += 1;
        }
    }
    let mut a = starts[0];
    let mut b = starts[1];
    let mut c = starts[2];
    while c < n and arr[a] == arr[b] and arr[b] == arr[c] {
        a += 1;
        b += 1;
        c += 1;
    }
    if c == n {
        vec![a - 1, b]
    } else {
        vec![-1, -1]
    }
}

// ---- the backward arm: three pointers from the right ----------------------
fn backward_three_equal_parts(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut ones = 0;
    for v in arr.iter() {
        ones += *v;
    }
    if ones == 0 {
        return vec![0, n - 1];
    }
    if ones % 3 != 0 {
        return vec![-1, -1];
    }
    let third = ones / 3;
    let mut trailing = 0;
    while arr[n - 1 - trailing] == 0 {
        trailing += 1;
    }
    // the last 1 of each third of the 1s
    let mut lasts: Vec[i64] = Vec.new();
    let mut seen = 0;
    for k in 0..n {
        if arr[k] == 1 {
            seen += 1;
            if seen % third == 0 {
                lasts.push(k);
            }
        }
    }
    let end1 = lasts[0] + trailing;
    let end2 = lasts[1] + trailing;
    let mut x = end1;
    let mut y = end2;
    let mut z = n - 1;
    let mut counted = 0;
    while counted < third {
        if x < 0 or y <= end1 or z <= end2 {
            return vec![-1, -1];
        }
        if arr[x] != arr[y] or arr[y] != arr[z] {
            return vec![-1, -1];
        }
        counted += arr[z];
        x -= 1;
        y -= 1;
        z -= 1;
    }
    vec![end1, end2 + 1]
}

// ---- the groups arm: the gaps between the 1s ------------------------------
fn groups_three_equal_parts(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut pos: Vec[i64] = Vec.new();
    for k in 0..n {
        if arr[k] == 1 {
            pos.push(k);
        }
    }
    let ones = pos.len();
    if ones == 0 {
        return vec![0, n - 1];
    }
    if ones % 3 != 0 {
        return vec![-1, -1];
    }
    let t = ones / 3;
    for k in 1..t {
        let gap = pos[k] - pos[k - 1];
        if pos[t + k] - pos[t + k - 1] != gap or pos[2 * t + k] - pos[2 * t + k - 1] != gap {
            return vec![-1, -1];
        }
    }
    let trailing = n - 1 - pos[ones - 1];
    if pos[t] - pos[t - 1] <= trailing or pos[2 * t] - pos[2 * t - 1] <= trailing {
        return vec![-1, -1];
    }
    vec![pos[t - 1] + trailing, pos[2 * t - 1] + trailing + 1]
}

// ---- the slices arm: the parts compared as slices -------------------------
fn slices_three_equal_parts(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut ones = 0;
    for v in arr.iter() {
        ones += *v;
    }
    if ones == 0 {
        return vec![0, n - 1];
    }
    if ones % 3 != 0 {
        return vec![-1, -1];
    }
    let third = ones / 3;
    let mut starts: Vec[i64] = Vec.new();
    let mut seen = 0;
    for k in 0..n {
        if arr[k] == 1 {
            if seen % third == 0 {
                starts.push(k);
            }
            seen += 1;
        }
    }
    let length = n - starts[2];
    if starts[0] + length > starts[1] or starts[1] + length > starts[2] {
        return vec![-1, -1];
    }
    let first = arr[starts[0]..starts[0] + length].to_vec();
    let second = arr[starts[1]..starts[1] + length].to_vec();
    let last = arr[starts[2]..n].to_vec();
    if first == last and second == last {
        vec![starts[0] + length - 1, starts[1] + length]
    } else {
        vec![-1, -1]
    }
}

// ---- the hash arm: values modulo a prime ----------------------------------
fn hash_three_equal_parts(arr: Vec[i64]) -> Vec[i64] {
    let modulus = 1000000007;
    let n = arr.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    let mut power: Vec[i64] = Vec.filled(n + 1, 1);
    for k in 0..n {
        prefix[k + 1] = (prefix[k] * 2 + arr[k]) % modulus;
        power[k + 1] = power[k] * 2 % modulus;
    }
    let mut ones = 0;
    for v in arr.iter() {
        ones += *v;
    }
    if ones == 0 {
        return vec![0, n - 1];
    }
    if ones % 3 != 0 {
        return vec![-1, -1];
    }
    let third = ones / 3;
    // the first and last 1 of each third of the 1s
    let mut first: Vec[i64] = Vec.new();
    let mut last: Vec[i64] = Vec.new();
    let mut seen = 0;
    for k in 0..n {
        if arr[k] == 1 {
            if seen % third == 0 {
                first.push(k);
            }
            seen += 1;
            if seen % third == 0 {
                last.push(k);
            }
        }
    }
    let third_value = (prefix[n] - prefix[first[2]] * power[n - first[2]] % modulus + modulus) % modulus;
    for i in last[0]..first[1] {
        if prefix[i + 1] != third_value {
            continue;
        }
        for j in last[1] + 1..first[2] + 1 {
            let middle = (prefix[j] - prefix[i + 1] * power[j - i - 1] % modulus + modulus) % modulus;
            if middle == third_value {
                return vec![i, j];
            }
        }
    }
    vec![-1, -1]
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, arr: Vec[i64]) -> Vec[i64] {
    if x == 0 {
        star_three_equal_parts(arr)
    } else if x == 1 {
        backward_three_equal_parts(arr)
    } else if x == 2 {
        groups_three_equal_parts(arr)
    } else if x == 3 {
        slices_three_equal_parts(arr)
    } else {
        hash_three_equal_parts(arr)
    }
}

// the digits of arr[lo..hi] without their leading 0s, a binary value
// written out
fn digits(arr: Vec[i64], lo: i64, hi: i64) -> Vec[i64] {
    let mut k = lo;
    while k < hi and arr[k] == 0 {
        k += 1;
    }
    arr[k..hi].to_vec()
}

// whether [i, j] splits arr into three non-empty parts arr[0..i],
// arr[i + 1..j - 1] and arr[j..] of equal binary value
fn splits(arr: Vec[i64], i: i64, j: i64) -> bool {
    let n = arr.len();
    if i < 0 or i + 1 >= j or j >= n {
        return false;
    }
    let a = digits(arr, 0, i + 1);
    a == digits(arr, i + 1, j) and a == digits(arr, j, n)
}

// The statement read literally: every split into three non-empty parts,
// with each part's value worked out as a number.
fn literal_splits(arr: Vec[i64]) -> Vec[Vec[i64]] {
    let n = arr.len();
    let mut found: Vec[Vec[i64]] = Vec.new();
    for i in 0..n {
        for j in i + 2..n {
            let mut first = 0;
            for k in 0..i + 1 {
                first = first * 2 + arr[k];
            }
            let mut second = 0;
            for k in i + 1..j {
                second = second * 2 + arr[k];
            }
            let mut third = 0;
            for k in j..n {
                third = third * 2 + arr[k];
            }
            if first == second and second == third {
                found.push(vec![i, j]);
            }
        }
    }
    found
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a value of up to `width` digits written three times, each copy with up
// to `pad` leading 0s, then perhaps one digit flipped
fn random_case(seed: mut ref i64, width: i64, pad: i64) -> Vec[i64] {
    let w = 1 + next_random(mut seed) % width;
    let mut value: Vec[i64] = Vec.new();
    for _ in 0..w {
        value.push(next_random(mut seed) % 2);
    }
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..3 {
        let zeros = next_random(mut seed) % (pad + 1);
        for _ in 0..zeros {
            arr.push(0);
        }
        for v in value.iter() {
            arr.push(*v);
        }
    }
    if next_random(mut seed) % 2 == 0 {
        let at = next_random(mut seed) % arr.len();
        arr[at] = 1 - arr[at];
    }
    arr
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, arr: Vec[i64], small: bool) {
    let n = arr.len();
    let mut ones = 0;
    for v in arr.iter() {
        ones += *v;
    }
    // k 0s in front
    let k = 1 + next_random(mut seed) % 5;
    let mut padded: Vec[i64] = Vec.filled(k, 0);
    for v in arr.iter() {
        padded.push(*v);
    }
    // the array written three times
    let mut thrice: Vec[i64] = Vec.new();
    for _ in 0..3 {
        for v in arr.iter() {
            thrice.push(*v);
        }
    }
    let truth = if small { literal_splits(arr) } else { Vec.new() };
    let mut got: Vec[Vec[i64]] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, arr));
    }
    for x in 0..5 {
        let a = got[x].clone();
        let none = a[0] == -1 and a[1] == -1;
        // P1: one of the statement's splits, or [-1, -1] when it has none
        if small {
            let mut listed = false;
            for s in truth.iter() {
                if *s == a {
                    listed = true;
                }
            }
            check(mut t, 1, if truth.len() == 0 { none } else { listed });
        }
        // P2: a split returned is three non-empty parts of equal value
        check(mut t, 2, none or splits(arr, a[0], a[1]));
        // P3: k 0s in front move a split k to the right and leave none as
        // none; with no 1 at all the answer is [0, n + k - 1]
        let b = arm(x, padded);
        let moved = if ones == 0 { b == vec![0, n + k - 1] } else if none { b == a } else { b == vec![a[0] + k, a[1] + k] };
        check(mut t, 3, moved);
        // P4: the array written three times splits into its three copies,
        // or [0, 3n - 1] with no 1 at all
        let want = if ones == 0 { vec![0, 3 * n - 1] } else { vec![n - 1, 2 * n] };
        check(mut t, 4, arm(x, thrice) == want);
        // P5: with a split found and some 1, the array turned to start
        // with the second part splits into that part, the third and the
        // first, in that order
        if none or ones == 0 {
            check(mut t, 5, true);
        } else {
            let mut turned: Vec[i64] = arr[a[0] + 1..n].to_vec();
            for v in arr[0..a[0] + 1].iter() {
                turned.push(*v);
            }
            let second = a[1] - a[0] - 1;
            check(mut t, 5, arm(x, turned) == vec![second - 1, second + n - a[1]]);
        }
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == a {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut seed = 927;
    let mut cases = 0;
    let mut digits_in = 0;
    let mut found = 0;
    // 3 to 15 digits against the statement, half of them built as three
    // copies of one value and half at random; then up to 3 * 400 digits
    for c in 0..3200 {
        let small = c < 3000;
        let arr = if small and c % 2 == 0 {
            let n = 3 + next_random(mut seed) % 10;
            let mut r: Vec[i64] = Vec.new();
            for _ in 0..n {
                r.push(next_random(mut seed) % 2);
            }
            r
        } else if small {
            random_case(mut seed, 3, 2)
        } else {
            random_case(mut seed, 300, 100)
        };
        cases += 1;
        digits_in += arr.len();
        if arm(0, arr)[0] >= 0 {
            found += 1;
        }
        properties(mut t, mut seed, arr, small);
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{cases} arrays, {digits_in} digits, {found} split, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
