// LeetCode #927: Three Equal Parts -- bench: three pointers.
//
// Equal values hold equally many 1s, so each part holds a third of them.
// The third part ends the array, so its digits from its first 1 on are
// the value every part must spell. Start a pointer at the first 1 of
// each third of the 1s and walk all three forward together while the
// digits agree: if the last pointer reaches the end, the first part ends
// just before the second pointer's start and the third part starts at
// the third pointer's start. With no 1 at all, any split works. O(n).

fn three_equal_parts(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut ones = 0;
    for v in arr.iter() {
        ones += *v;
    }
    if ones == 0 {
        return vec![0, n - 1];
    }
    if ones % 3 != 0 {
        return vec![-1, -1];
    }
    let third = ones / 3;
    // the first 1 of each third of the 1s
    let mut starts: Vec[i64] = Vec.new();
    let mut seen = 0;
    for k in 0..n {
        if arr[k] == 1 {
            if seen % third == 0 {
                starts.push(k);
            }
            seen += 1;
        }
    }
    let mut a = starts[0];
    let mut b = starts[1];
    let mut c = starts[2];
    while c < n and arr[a] == arr[b] and arr[b] == arr[c] {
        a += 1;
        b += 1;
        c += 1;
    }
    if c == n {
        vec![a - 1, b]
    } else {
        vec![-1, -1]
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 30;
    let count = 100;
    let mut seed = 927;
    // count arrays of 30000 digits, built once: a value of 9000 digits
    // written three times, each copy after up to 1000 leading 0s and the
    // array filled up with 0s in front, and every other array with one
    // digit flipped
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..count {
        let mut value: Vec[i64] = Vec.new();
        for _ in 0..9000 {
            value.push(next_random(mut seed) % 2);
        }
        let mut parts: Vec[i64] = Vec.new();
        for _ in 0..3 {
            for _ in 0..next_random(mut seed) % 1001 {
                parts.push(0);
            }
            for v in value.iter() {
                parts.push(*v);
            }
        }
        let mut arr: Vec[i64] = Vec.filled(30000 - parts.len(), 0);
        for v in parts.iter() {
            arr.push(*v);
        }
        if a % 2 == 1 {
            let at = next_random(mut seed) % 30000;
            arr[at] = 1 - arr[at];
        }
        arrays.push(arr);
    }
    let mut found = 0;
    let mut check = 0;
    for r in 0..rounds {
        // each round visits every array, starting from a different one
        for i in 0..count {
            let got = three_equal_parts(arrays[(r + i) % count]);
            if got[0] >= 0 {
                found += 1;
            }
            check = (check * 1000003 + got[0] + 1) % 1000000007;
            check = (check * 1000003 + got[1] + 1) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} arrays of 30000: {found} split, checksum {check}");
}
