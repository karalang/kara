// Benchmark: LeetCode #987 Vertical Order Traversal of a Binary Tree --
// the ★ arm, every node's place sorted, on random trees of 1000 nodes,
// LeetCode's largest. Mirrors vertical_traversal.rs, .c, .py and go-seq/.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn walk(t: ref Option[TreeNode], row: i64, col: i64, out: mut ref Vec[(i64, i64, i64)]) {
    if let Some(node) = t {
        out.push((col, row, node.val));
        walk(node.left, row + 1, col - 1, mut out);
        walk(node.right, row + 1, col + 1, mut out);
    }
}

fn vertical_traversal(root: Option[TreeNode]) -> Vec[Vec[i64]] {
    let mut places: Vec[(i64, i64, i64)] = Vec.new();
    walk(root, 0, 0, mut places);
    places.sort();
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut last = 0;
    for (col, _, val) in places {
        if out.len() == 0 or col != last {
            out.push(Vec.new());
            last = col;
        }
        let k = out.len() - 1;
        out[k].push(val);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn attach(root: TreeNode, node: TreeNode, seed: mut ref i64) {
    let mut cur = root;
    loop {
        if next_random(mut seed) % 2 == 0 {
            match cur.left {
                Some(l) => cur = l,
                None => {
                    cur.left = Some(node);
                    return;
                }
            }
        } else {
            match cur.right {
                Some(r) => cur = r,
                None => {
                    cur.right = Some(node);
                    return;
                }
            }
        }
    }
}

fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    let root = TreeNode { val: next_random(mut seed) % 1001, left: None, right: None };
    for _ in 1..n {
        let node = TreeNode { val: next_random(mut seed) % 1001, left: None, right: None };
        attach(root, node, mut seed);
    }
    Some(root)
}

fn main() {
    let rounds = 500;
    let mut seed = 987;
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    for _ in 0..20 {
        trees.push(random_tree(1000, mut seed));
    }
    let mut columns = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..20 {
            let cols = vertical_traversal(trees[(r + i) % 20]);
            columns += cols.len();
            let mid = ref cols[cols.len() / 2];
            check = (check * 31 + mid.len() + mid[0]) % 1000000007;
        }
    }
    println(f"{rounds} rounds over 20 trees of 1000 nodes: {columns} columns, checksum {check}");
}
