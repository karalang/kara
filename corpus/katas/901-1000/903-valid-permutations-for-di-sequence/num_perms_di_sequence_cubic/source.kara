// LeetCode #903: Valid Permutations for DI Sequence -- ranks of the last
// number, every sum taken afresh.
//
// The same table of ways[i][j], the orders of the first i + 1 numbers
// that fit the first i letters and end on the j-th smallest, with each
// entry summed over the old row directly: after an 'I' the old last
// ranked below j, after a 'D' at j or above. O(n^3).

fn num_perms_di_sequence(s: String) -> i64 {
    let m = 1000000007;
    let letters = s.bytes().to_vec();
    let n = letters.len();
    let mut table: Vec[Vec[i64]] = Vec.new();
    table.push(vec![1]);
    for i in 1..n + 1 {
        let mut row: Vec[i64] = Vec.filled(i + 1, 0);
        for j in 0..i + 1 {
            let mut sum = 0;
            for k in 0..i {
                let fits = if letters[i - 1] == b'I' { k < j } else { k >= j };
                if fits {
                    sum = (sum + table[i - 1][k]) % m;
                }
            }
            row[j] = sum;
        }
        table.push(row);
    }
    let mut total = 0;
    for w in table[n].iter() {
        total = (total + *w) % m;
    }
    total
}

// ---- test harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"s = \"{s}\" -> {num_perms_di_sequence(s.to_string())}");
}

// `len` letters: random, each 'D' with chance `d` in 10
fn random_letters(seed: mut ref i64, len: i64, d: i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        s.push(if next_random(mut seed) % 10 < d { 'D' } else { 'I' });
    }
    s
}

fn main() {
    show("DID");
    show("D");
    show("I");
    show("III");
    show("DDD");
    show("ID");
    show("DI");
    show("IDID");
    show("DDIDI");
    show("IIDDII");
    // random cases of up to 200 letters, 'D' from 0 to 10 in 10
    let mut seed = 903;
    let mut check = 0;
    let mut letters = 0;
    for c in 0..120 {
        let len = 1 + next_random(mut seed) % 200;
        let got = num_perms_di_sequence(random_letters(mut seed, len, c % 11));
        check = (check * 1000003 + got) % 1000000007;
        letters += len;
    }
    println(f"120 cases ({letters} letters): checksum {check}");
    // LeetCode's largest: 200 random letters, and 200 alternating
    println(f"200 random letters -> {num_perms_di_sequence(random_letters(mut seed, 200, 5))}");
    let mut zigzag = String.new();
    for i in 0..200 {
        zigzag.push(if i % 2 == 0 { 'D' } else { 'I' });
    }
    println(f"200 letters DIDI... -> {num_perms_di_sequence(zigzag)}");
}
