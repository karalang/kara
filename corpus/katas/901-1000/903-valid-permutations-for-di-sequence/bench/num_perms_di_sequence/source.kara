// LeetCode #903: Valid Permutations for DI Sequence -- bench program.
//
// The ★ arm (ranks of the last number, with running sums) over one string
// of 4,000 random letters built once. Each round counts its valid
// permutations, folds the count into a checksum and flips one letter.

fn num_perms_di_sequence(s: String) -> i64 {
    let m = 1000000007;
    let letters = s.bytes().to_vec();
    let n = letters.len();
    let mut ways: Vec[i64] = vec![1];
    for i in 1..n + 1 {
        let mut below: Vec[i64] = Vec.filled(i + 1, 0);
        for k in 0..i {
            below[k + 1] = (below[k] + ways[k]) % m;
        }
        let mut next: Vec[i64] = Vec.filled(i + 1, 0);
        for j in 0..i + 1 {
            next[j] = if letters[i - 1] == b'I' {
                below[j]
            } else {
                (below[i] - below[j] + m) % m
            };
        }
        ways = next;
    }
    let mut total = 0;
    for w in ways.iter() {
        total = (total + *w) % m;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let length = 4000;
    let rounds = 12;
    let mut seed = 903;
    let mut letters: Vec[char] = Vec.new();
    for _ in 0..length {
        letters.push(if next_random(mut seed) % 2 == 0 { 'D' } else { 'I' });
    }
    let mut check = 0;
    for r in 0..rounds {
        let mut s = String.new();
        for c in letters.iter() {
            s.push(*c);
        }
        let got = num_perms_di_sequence(s);
        check = (check * 31 + got) % 1000000007;
        let at = r * 7919 % length;
        letters[at] = if letters[at] == 'D' { 'I' } else { 'D' };
    }
    println(f"{rounds} rounds over {length} letters: checksum {check}");
}
