// Benchmark: LeetCode #998 Maximum Binary Tree II -- the ★ arm, down the
// right spine by recursion, on maximum trees of 99 values, LeetCode's
// largest. Mirrors insert_into_max_tree.c, .rs, .py and go-seq/.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn insert_into_max_tree(root: Option[TreeNode], val: i64) -> Option[TreeNode] {
    match root {
        Some(node) => {
            if val > node.val {
                Some(TreeNode { val: val, left: Some(node), right: None })
            } else {
                node.right = insert_into_max_tree(node.right, val);
                Some(node)
            }
        }
        None => Some(TreeNode { val: val, left: None, right: None }),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build(a: ref Vec[i64], lo: i64, hi: i64) -> Option[TreeNode] {
    if lo >= hi {
        return None;
    }
    let mut m = lo;
    for i in lo + 1..hi {
        if a[i] > a[m] {
            m = i;
        }
    }
    Some(TreeNode { val: a[m], left: build(a, lo, m), right: build(a, m + 1, hi) })
}

// Take val out again, from where the insert put it on the right spine,
// and return the tree as it was with how deep val sat.
fn take_out(root: TreeNode, val: i64) -> (TreeNode, i64) {
    if root.val == val {
        return (root.left.unwrap(), 0);
    }
    let mut above = root;
    let mut depth = 1;
    loop {
        let next = above.right.unwrap();
        if next.val == val {
            above.right = next.left;
            return (root, depth);
        }
        above = next;
        depth += 1;
    }
}

fn main() {
    let rounds = 100000;
    let mut seed = 998;
    // 20 trees of the 99 values from 1 to 100 but one: the even ones in a
    // random order, the odd ones falling, which makes a chain of 99
    let mut trees: Vec[TreeNode] = Vec.new();
    let mut vals: Vec[i64] = Vec.new();
    for t in 0..20 {
        let val = 1 + next_random(mut seed) % 100;
        let mut a: Vec[i64] = Vec.new();
        for v in 0..100 {
            if 100 - v != val {
                a.push(100 - v);
            }
        }
        if t % 2 == 0 {
            let mut i = 98;
            while i > 0 {
                let j = next_random(mut seed) % (i + 1);
                let x = a[i];
                a[i] = a[j];
                a[j] = x;
                i -= 1;
            }
        }
        trees.push(build(a, 0, 99).unwrap());
        vals.push(val);
    }
    let mut depths = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..20 {
            let k = (r + i) % 20;
            let got = insert_into_max_tree(Some(trees[k]), vals[k]).unwrap();
            let (tree, depth) = take_out(got, vals[k]);
            trees[k] = tree;
            depths += depth;
            check = (check * 31 + depth + 1) % 1000000007;
        }
    }
    println(f"{rounds} rounds over 20 trees of 99 values: depth total {depths}, checksum {check}");
}
