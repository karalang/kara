// LeetCode #998: Maximum Binary Tree II -- down the right spine
//
// A value appended to the list lands after every value already there,
// so it can only go down the right: if it beats the root it becomes the
// new root with the whole tree on its left, and otherwise it goes into
// the root's right subtree, which was built from the values after the
// root. O(h) for the right spine's length h.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn insert_into_max_tree(root: Option[TreeNode], val: i64) -> Option[TreeNode] {
    match root {
        Some(node) => {
            if val > node.val {
                Some(TreeNode { val: val, left: Some(node), right: None })
            } else {
                node.right = insert_into_max_tree(node.right, val);
                Some(node)
            }
        }
        None => Some(TreeNode { val: val, left: None, right: None }),
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The maximum tree of a[lo..hi]: its largest value at the root, the
// values before it on the left and those after it on the right.
fn build(a: ref Vec[i64], lo: i64, hi: i64) -> Option[TreeNode] {
    if lo >= hi {
        return None;
    }
    let mut m = lo;
    for i in lo + 1..hi {
        if a[i] > a[m] {
            m = i;
        }
    }
    Some(TreeNode { val: a[m], left: build(a, lo, m), right: build(a, m + 1, hi) })
}

fn construct(a: ref Vec[i64]) -> Option[TreeNode] {
    build(a, 0, a.len())
}

// LeetCode's level order: every node's two children, null for a missing
// one, with the nulls at the end left off; 0 stands for null.
fn level_order(root: Option[TreeNode]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    while let Some(slot) = queue.pop_front() {
        match slot {
            Some(node) => {
                out.push(node.val);
                queue.push_back(node.left);
                queue.push_back(node.right);
            }
            None => out.push(0),
        }
    }
    while out.len() > 0 and out[out.len() - 1] == 0 {
        out.pop();
    }
    out
}

fn text(vals: ref Vec[i64]) -> String {
    let parts: Vec[String] = vals.iter().map(|v| if *v == 0 { "null".to_string() } else { f"{v}" }).collect();
    "[" + parts.join(",") + "]"
}

fn height(node: Option[TreeNode]) -> i64 {
    match node {
        Some(t) => 1 + height(t.left).max(height(t.right)),
        None => 0,
    }
}

fn fold(check: i64, vals: ref Vec[i64]) -> i64 {
    let mut c = check;
    for v in vals.iter() {
        c = (c * 31 + *v + 1) % 1000000007;
    }
    c
}

// n different values from 1 to 100, and one more different from them
fn random_case(n: i64, seed: mut ref i64) -> (Vec[i64], i64) {
    let mut pool: Vec[i64] = (1..101).collect();
    for i in 0..n + 1 {
        let j = i + next_random(mut seed) % (100 - i);
        let t = pool[i];
        pool[i] = pool[j];
        pool[j] = t;
    }
    let a: Vec[i64] = (0..n).map(|i| pool[i]).collect();
    (a, pool[n])
}

fn main() {
    // LeetCode's three examples, as the lists the trees were built from,
    // then a few more
    let cases: Vec[(Vec[i64], i64)] = vec![
        (vec![1, 4, 2, 3], 5),
        (vec![2, 1, 5, 4], 3),
        (vec![2, 1, 5, 3], 4),
        (vec![1], 2),
        (vec![2], 1),
        (vec![1, 2, 3], 4),
        (vec![2, 3, 4], 1),
        (vec![4, 3, 1], 2),
        (vec![7, 1, 6, 2, 5, 3], 4),
        (vec![5, 4, 3, 2], 1),
    ];
    for (a, val) in cases.iter() {
        let root = construct(a);
        let before = text(level_order(root));
        let after = text(level_order(insert_into_max_tree(root, *val)));
        println(f"root = {before}, val = {val} -> {after}");
    }
    let mut but_50: Vec[i64] = Vec.new();
    for v in 0..100 {
        if 100 - v != 50 {
            but_50.push(100 - v);
        }
    }
    let big: Vec[(String, Vec[i64], i64)] = vec![
        ("99 values rising from 1".to_string(), (1..100).collect(), 100),
        ("99 values rising from 2".to_string(), (2..101).collect(), 1),
        ("99 values falling from 100".to_string(), (0..99).map(|i| 100 - i).collect(), 1),
        ("99 values falling from 99".to_string(), (0..99).map(|i| 99 - i).collect(), 100),
        ("99 values falling from 100 but 50".to_string(), but_50, 50),
    ];
    for (name, a, val) in big.iter() {
        let got = insert_into_max_tree(construct(a), *val);
        let vals = level_order(got);
        println(f"{name}, val = {val}: height {height(got)}, root {vals[0]}, checksum {fold(0, vals)}");
    }
    let mut seed = 998;
    for (count, most) in vec![(300, 5), (3000, 30), (300, 99)] {
        let mut nodes = 0;
        let mut heights = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = 1 + next_random(mut seed) % most;
            let (a, val) = random_case(n, mut seed);
            let got = insert_into_max_tree(construct(a), val);
            nodes += n + 1;
            heights += height(got);
            check = fold(check, level_order(got));
        }
        println(f"{count} random trees of {nodes} nodes: heights {heights}, checksum {check}");
    }
}
