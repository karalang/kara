// LeetCode #991: Broken Calculator -- forwards, by the number of
// doublings
//
// With d presses of Double, start becomes start * 2^d less the
// decrements, and a decrement made before the last j doublings takes
// away 2^j. So the overshoot D = start * 2^d - target, which must not
// be negative, is paid with D / 2^d decrements before any doubling and
// one for each binary 1 of D % 2^d, made between doublings. The
// answer is the cheapest d, tried from 0 up to 32. O(log^2 target).

fn ones(x: i64) -> i64 {
    let mut n = 0;
    let mut rest = x;
    while rest > 0 {
        n += rest % 2;
        rest /= 2;
    }
    n
}

fn broken_calc(start_value: i64, target: i64) -> i64 {
    let mut best = -1;
    let mut reach = start_value;
    let mut power = 1;
    for d in 0..33 {
        if reach >= target {
            let over = reach - target;
            let cost = d + over / power + ones(over % power);
            if best < 0 or cost < best {
                best = cost;
            }
        }
        reach *= 2;
        power *= 2;
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(i64, i64)] = vec![
        (2, 3), (5, 8), (3, 10),
        (1, 1), (10, 1), (1, 1000000000), (1000000000, 1),
        (1000000000, 1000000000), (7, 1000000000), (999999999, 1000000000),
        (3, 1024), (1, 536870913),
    ];
    for (s, t) in cases {
        println(f"startValue = {s}, target = {t} -> {broken_calc(s, t)}");
    }
    // random pairs: 300 up to 20, 3000 up to 1000, 3000 up to 10^9, and
    // 300 with the start up to 1000 and the target up to 10^9
    let mut seed = 991;
    for (count, most_s, most_t) in vec![(300, 20, 20), (3000, 1000, 1000), (3000, 1000000000, 1000000000), (300, 1000, 1000000000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let s = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % most_s;
            let t = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % most_t;
            let got = broken_calc(s, t);
            total += got;
            check = (check * 31 + got + 1) % 1000000007;
        }
        println(f"{count} random pairs, start up to {most_s}, target up to {most_t}: {total} operations, checksum {check}");
    }
}
