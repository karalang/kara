// LeetCode #991: Broken Calculator -- in closed form, from the bits
//
// The greedy run backwards halves h times, h the fewest with target /
// 2^h, rounded up, no more than the start; it rounds up each time an
// odd value turns up, at the cost of an extra press. Rounding up h
// times lands on c = ceil(target / 2^h), and the presses spent rounding
// are the binary 1s of c * 2^h - target. So the answer is h, plus
// those 1s, plus start - c to come down to c. O(log target).

fn broken_calc(start_value: i64, target: i64) -> i64 {
    if target <= start_value {
        return start_value - target;
    }
    let mut h = 0;
    let mut power = 1;
    while (target + power - 1) / power > start_value {
        h += 1;
        power *= 2;
    }
    let c = (target + power - 1) / power;
    let mut rounding = c * power - target;
    let mut ones = 0;
    while rounding > 0 {
        ones += rounding % 2;
        rounding /= 2;
    }
    h + ones + start_value - c
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(i64, i64)] = vec![
        (2, 3), (5, 8), (3, 10),
        (1, 1), (10, 1), (1, 1000000000), (1000000000, 1),
        (1000000000, 1000000000), (7, 1000000000), (999999999, 1000000000),
        (3, 1024), (1, 536870913),
    ];
    for (s, t) in cases {
        println(f"startValue = {s}, target = {t} -> {broken_calc(s, t)}");
    }
    // random pairs: 300 up to 20, 3000 up to 1000, 3000 up to 10^9, and
    // 300 with the start up to 1000 and the target up to 10^9
    let mut seed = 991;
    for (count, most_s, most_t) in vec![(300, 20, 20), (3000, 1000, 1000), (3000, 1000000000, 1000000000), (300, 1000, 1000000000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let s = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % most_s;
            let t = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % most_t;
            let got = broken_calc(s, t);
            total += got;
            check = (check * 31 + got + 1) % 1000000007;
        }
        println(f"{count} random pairs, start up to {most_s}, target up to {most_t}: {total} operations, checksum {check}");
    }
}
