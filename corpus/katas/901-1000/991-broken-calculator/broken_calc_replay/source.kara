// LeetCode #991: Broken Calculator -- pressing the keys forwards
//
// With d the fewest doublings that reach the target, the overshoot
// D = start * 2^d - target is read as a plan: press Decrement D / 2^d
// times, then for each of the d doublings press Double, followed by
// Decrement when the matching bit of D, from the top, is 1. The arm
// carries the plan out on a running value, counting presses, and ends
// on the target. O(log target).

fn broken_calc(start_value: i64, target: i64) -> i64 {
    let mut d = 0;
    let mut power = 1;
    while start_value * power < target {
        d += 1;
        power *= 2;
    }
    let over = start_value * power - target;
    let mut x = start_value - over / power;
    let mut presses = over / power;
    let mut bit = power / 2;
    for _ in 0..d {
        x *= 2;
        presses += 1;
        if over % (2 * bit) >= bit {
            x -= 1;
            presses += 1;
        }
        bit /= 2;
    }
    if x != target {
        panic("the plan missed the target");
    }
    presses
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(i64, i64)] = vec![
        (2, 3), (5, 8), (3, 10),
        (1, 1), (10, 1), (1, 1000000000), (1000000000, 1),
        (1000000000, 1000000000), (7, 1000000000), (999999999, 1000000000),
        (3, 1024), (1, 536870913),
    ];
    for (s, t) in cases {
        println(f"startValue = {s}, target = {t} -> {broken_calc(s, t)}");
    }
    // random pairs: 300 up to 20, 3000 up to 1000, 3000 up to 10^9, and
    // 300 with the start up to 1000 and the target up to 10^9
    let mut seed = 991;
    for (count, most_s, most_t) in vec![(300, 20, 20), (3000, 1000, 1000), (3000, 1000000000, 1000000000), (300, 1000, 1000000000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let s = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % most_s;
            let t = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % most_t;
            let got = broken_calc(s, t);
            total += got;
            check = (check * 31 + got + 1) % 1000000007;
        }
        println(f"{count} random pairs, start up to {most_s}, target up to {most_t}: {total} operations, checksum {check}");
    }
}
