// LeetCode #991: Broken Calculator -- greedy from the target back
//
// Run backwards, the two keys become "add 1" and "halve an even
// number". While the target is above the start, halving an even target
// is always right, and an odd one has to be made even first; once it
// is at or below the start, the rest is adding 1 until it meets the
// start, which forwards is pressing Decrement first. O(log target).

fn broken_calc(start_value: i64, target: i64) -> i64 {
    let mut ops = 0;
    let mut t = target;
    while t > start_value {
        if t % 2 == 1 {
            t += 1;
        } else {
            t /= 2;
        }
        ops += 1;
    }
    ops + start_value - t
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 5000;
    let mut seed = 991;
    let mut starts: Vec[i64] = Vec.new();
    let mut targets: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        starts.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000);
        targets.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..1000 {
            let j = (r + i) % 1000;
            let got = broken_calc(starts[j], targets[i]);
            total += got;
            check = (check * 31 + got + 1) % 1000000007;
        }
    }
    println(f"{rounds} rounds over 1000 pairs: {total} operations, checksum {check}");
}
