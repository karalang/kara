// LeetCode #909: Snakes and Ladders -- the reachable squares, one move at
// a time.
//
// Keep the set of squares first reached after d moves as a row of flags.
// The next set is every square a roll from this set lands on that no
// earlier set held. Count the sets until one holds n^2, or one comes out
// empty and n^2 can never be reached. O(n^2) sets of O(n^2) work each at
// worst.

fn snakes_and_ladders(board: Vec[Vec[i64]]) -> i64 {
    let n = board.len();
    let last = n * n;
    let mut goes: Vec[i64] = Vec.filled(last + 1, 0);
    for s in 1..last + 1 {
        let row = (s - 1) / n;
        let col = if row % 2 == 0 { (s - 1) % n } else { n - 1 - (s - 1) % n };
        let v = board[n - 1 - row][col];
        goes[s] = if v == -1 { s } else { v };
    }
    let mut ever: Vec[bool] = Vec.filled(last + 1, false);
    let mut now: Vec[bool] = Vec.filled(last + 1, false);
    now[1] = true;
    ever[1] = true;
    let mut d = 0;
    loop {
        if now[last] {
            return d;
        }
        let mut next: Vec[bool] = Vec.filled(last + 1, false);
        let mut any = false;
        for s in 1..last {
            if now[s] {
                for t in s + 1..(s + 6).min(last) + 1 {
                    let g = goes[t];
                    if not ever[g] {
                        ever[g] = true;
                        next[g] = true;
                        any = true;
                    }
                }
            }
        }
        if not any {
            return -1;
        }
        now = next;
        d += 1;
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The board holding goes[s] at square s, rows alternating from the bottom.
fn place(n: i64, goes: Vec[i64]) -> Vec[Vec[i64]] {
    let mut board: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        board.push(Vec.filled(n, -1));
    }
    for s in 1..n * n + 1 {
        let row = (s - 1) / n;
        let col = if row % 2 == 0 { (s - 1) % n } else { n - 1 - (s - 1) % n };
        board[n - 1 - row][col] = goes[s];
    }
    board
}

// A random n x n board: each square but the first and last holds a snake
// or ladder with chance 1 in `rare`, to any square, or only snakes to a
// lower square when `down`.
fn random_board(seed: mut ref i64, n: i64, rare: i64, down: bool) -> Vec[Vec[i64]] {
    let last = n * n;
    let mut goes: Vec[i64] = Vec.filled(last + 1, -1);
    for s in 2..last {
        if next_random(mut seed) % rare == 0 {
            goes[s] = if down { 1 + next_random(mut seed) % (s - 1) } else { 1 + next_random(mut seed) % last };
        }
    }
    place(n, goes)
}

fn show(board: Vec[Vec[i64]]) {
    let mut listed = String.new();
    for i in 0..board.len() {
        if i > 0 {
            listed.push_str(",");
        }
        listed.push_str("[");
        for j in 0..board[i].len() {
            if j > 0 {
                listed.push_str(",");
            }
            listed.push_str(f"{board[i][j]}");
        }
        listed.push_str("]");
    }
    println(f"board = [{listed}] -> {snakes_and_ladders(board)}");
}

fn main() {
    show(vec![
        vec![-1, -1, -1, -1, -1, -1],
        vec![-1, -1, -1, -1, -1, -1],
        vec![-1, -1, -1, -1, -1, -1],
        vec![-1, 35, -1, -1, 13, -1],
        vec![-1, -1, -1, -1, -1, -1],
        vec![-1, 15, -1, -1, -1, -1],
    ]);
    show(vec![vec![-1, -1], vec![-1, 3]]);
    show(vec![vec![-1, -1], vec![-1, -1]]);
    show(vec![vec![-1, -1, -1], vec![-1, -1, -1], vec![-1, -1, -1]]);
    // squares 2 to 7 all snakes back to 1: square 9 is never reached
    show(vec![vec![1, -1, -1], vec![1, 1, 1], vec![-1, 1, 1]]);
    // a ladder from 2 lands on 10, which holds a ladder to 16 that is not taken
    show(vec![vec![-1, -1, -1, -1], vec![-1, 16, -1, -1], vec![-1, -1, -1, -1], vec![-1, 10, -1, -1]]);
    // the ladder at 2 to the last square
    show(vec![vec![-1, -1, -1], vec![-1, -1, -1], vec![-1, 9, -1]]);
    // random boards of side 2 to 20, snakes and ladders on every square, on
    // 1 in 4 or on 1 in 30, or snakes alone on 1 in 2
    let mut seed = 909;
    let mut sum = 0;
    let mut stuck = 0;
    let mut check = 0;
    for c in 0..300 {
        let n = 2 + next_random(mut seed) % 19;
        let rare = if c % 4 == 0 { 1 } else if c % 4 == 1 { 4 } else if c % 4 == 2 { 30 } else { 2 };
        let got = snakes_and_ladders(random_board(mut seed, n, rare, c % 4 == 3));
        if got == -1 {
            stuck += 1;
        } else {
            sum += got;
        }
        check = (check * 1000003 + got + 2) % 1000000007;
    }
    println(f"300 boards: {stuck} unreachable, the rest summing to {sum}, checksum {check}");
    // LeetCode's largest, 20 x 20: empty, and two random
    let empty: Vec[i64] = Vec.filled(401, -1);
    println(f"20 x 20 empty -> {snakes_and_ladders(place(20, empty))}");
    println(f"20 x 20 random, 1 in 4 -> {snakes_and_ladders(random_board(mut seed, 20, 4, false))}");
    println(f"20 x 20 random, 1 in 20 -> {snakes_and_ladders(random_board(mut seed, 20, 20, false))}");
}
