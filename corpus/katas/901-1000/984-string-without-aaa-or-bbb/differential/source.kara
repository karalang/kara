// LeetCode #984: String Without AAA or BBB -- differential.
//
// The five arms against the statement read literally and against each
// other, on random pairs of counts.

// ---- star ----

fn star_str_without_3a3b(a: i64, b: i64) -> String {
    let mut s = String.new();
    let mut left_a = a;
    let mut left_b = b;
    while left_a > 0 or left_b > 0 {
        let write_a = if s.ends_with("aa") {
            false
        } else if s.ends_with("bb") {
            true
        } else {
            left_a >= left_b
        };
        if write_a {
            s.push('a');
            left_a -= 1;
        } else {
            s.push('b');
            left_b -= 1;
        }
    }
    s
}

// ---- blocks ----

fn blocks_str_without_3a3b(a: i64, b: i64) -> String {
    let mut s = String.new();
    if a >= b {
        let blocks = (a - b).min(b);
        for _ in 0..blocks {
            s.push_str("aab");
        }
        if a - b >= b {
            for _ in 0..a - 2 * b {
                s.push('a');
            }
        } else {
            for _ in 0..2 * b - a {
                s.push_str("ab");
            }
        }
    } else {
        let blocks = (b - a - 1).min(a);
        for _ in 0..blocks {
            s.push_str("bba");
        }
        if b - a - 1 >= a {
            for _ in 0..b - 2 * a {
                s.push('b');
            }
        } else {
            s.push('b');
            for _ in 0..2 * a - b + 1 {
                s.push_str("ab");
            }
        }
    }
    s
}

// ---- index ----

fn index_letter(a: i64, b: i64, i: i64) -> char {
    if a >= b {
        let blocks = (a - b).min(b);
        if i < 3 * blocks {
            return if i % 3 < 2 { 'a' } else { 'b' };
        }
        if a - b >= b or (i - 3 * blocks) % 2 == 0 { 'a' } else { 'b' }
    } else {
        let blocks = (b - a - 1).min(a);
        if i < 3 * blocks {
            return if i % 3 < 2 { 'b' } else { 'a' };
        }
        let t = i - 3 * blocks;
        if b - a - 1 >= a or t % 2 == 0 { 'b' } else { 'a' }
    }
}

fn index_str_without_3a3b(a: i64, b: i64) -> String {
    (0..a + b).map(|i| index_letter(a, b, i)).collect()
}

// ---- recursive ----

fn recursive_str_without_3a3b(a: i64, b: i64) -> String {
    if a == 0 or b == 0 {
        let mut s = String.new();
        for _ in 0..a {
            s.push('a');
        }
        for _ in 0..b {
            s.push('b');
        }
        return s;
    }
    if a > b {
        "aab".to_string() + recursive_str_without_3a3b(a - 2, b - 1)
    } else if a == b {
        "ab".to_string() + recursive_str_without_3a3b(a - 1, b - 1)
    } else if b == a + 1 {
        "ba".to_string() + recursive_str_without_3a3b(a - 1, b - 1)
    } else {
        "bba".to_string() + recursive_str_without_3a3b(a - 1, b - 2)
    }
}

// ---- runs ----

enum Run {
    Nothing,
    A(i64),
    B(i64),
}

fn runs_str_without_3a3b(a: i64, b: i64) -> String {
    let mut letters: Vec[char] = Vec.new();
    let mut run = Run.Nothing;
    let mut left_a = a;
    let mut left_b = b;
    while left_a > 0 or left_b > 0 {
        run = match run {
            Run.A(2) => Run.B(1),
            Run.B(2) => Run.A(1),
            Run.A(n) => if left_a >= left_b { Run.A(n + 1) } else { Run.B(1) },
            Run.B(n) => if left_a >= left_b { Run.A(1) } else { Run.B(n + 1) },
            Run.Nothing => if left_a >= left_b { Run.A(1) } else { Run.B(1) },
        };
        match run {
            Run.A(_) => {
                letters.push('a');
                left_a -= 1;
            }
            _ => {
                letters.push('b');
                left_b -= 1;
            }
        }
    }
    let mut s = String.new();
    for c in letters {
        s.push(c);
    }
    s
}

// ---- checks ----

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(k: i64, a: i64, b: i64) -> String {
    if k == 0 {
        star_str_without_3a3b(a, b)
    } else if k == 1 {
        blocks_str_without_3a3b(a, b)
    } else if k == 2 {
        index_str_without_3a3b(a, b)
    } else if k == 3 {
        recursive_str_without_3a3b(a, b)
    } else {
        runs_str_without_3a3b(a, b)
    }
}

// The statement read literally: a + b letters, exactly a of them `a`
// and b of them `b`, and no three in a row the same.
fn literal(s: String, a: i64, b: i64) -> bool {
    let cs: Vec[char] = s.chars().collect();
    let mut count_a = 0;
    let mut count_b = 0;
    for c in cs.clone() {
        if c == 'a' {
            count_a += 1;
        } else if c == 'b' {
            count_b += 1;
        } else {
            return false;
        }
    }
    if cs.len() != a + b or count_a != a or count_b != b {
        return false;
    }
    for i in 2..cs.len() {
        if cs[i] == cs[i - 1] and cs[i - 1] == cs[i - 2] {
            return false;
        }
    }
    true
}

// The runs of `c` in `s`, in order.
fn runs_of(s: String, c: char) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut n = 0;
    for x in s.chars() {
        if x == c {
            n += 1;
        } else {
            if n > 0 {
                out.push(n);
            }
            n = 0;
        }
    }
    if n > 0 {
        out.push(n);
    }
    out
}

// Every letter is the one the greedy rule picks from the letters left
// and the two before it.
fn greedy_all_the_way(s: String, a: i64, b: i64) -> bool {
    let cs: Vec[char] = s.chars().collect();
    let mut left_a = a;
    let mut left_b = b;
    for i in 0..cs.len() {
        let two_a = i >= 2 and cs[i - 1] == 'a' and cs[i - 2] == 'a';
        let two_b = i >= 2 and cs[i - 1] == 'b' and cs[i - 2] == 'b';
        let want = if two_a { 'b' } else if two_b { 'a' } else if left_a >= left_b { 'a' } else { 'b' };
        if cs[i] != want {
            return false;
        }
        if want == 'a' {
            left_a -= 1;
        } else {
            left_b -= 1;
        }
    }
    true
}

fn possible(a: i64, b: i64) -> bool {
    a + b > 0 and a <= 2 * b + 2 and b <= 2 * a + 2
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(tally: mut ref Tally, a: i64, b: i64, small: bool, seed: mut ref i64) -> String {
    let mut got: Vec[String] = Vec.new();
    for k in 0..5 {
        got.push(arm(k, a, b));
    }
    let n = a + b;
    // a random place to cut, moved back to one where a run starts and
    // the two letters before differ, so the greedy rule has nothing to
    // remember there
    let wanted = next_random(mut seed) % (n + 1);
    let one_more = a <= 2 * b and b <= 2 * a + 1;
    let fewer = if a >= b { 'b' } else { 'a' };
    let more = if a >= b { 'a' } else { 'b' };
    for k in 0..5 {
        let s = got[k].clone();
        let cs: Vec[char] = s.chars().collect();
        // P1: the statement, on the first 3000 pairs
        if small {
            check(mut tally, 1, literal(s.clone(), a, b));
        }
        // P2: the rest after a free place is the answer for what is left
        let mut cut = if wanted <= cs.len() { wanted } else { cs.len() };
        while cut > 0 and cut < cs.len() and (cs[cut] == cs[cut - 1] or cut >= 2 and cs[cut - 1] == cs[cut - 2]) {
            cut -= 1;
        }
        let mut used_a = 0;
        for i in 0..cut {
            if cs[i] == 'a' {
                used_a += 1;
            }
        }
        let rest = s.substring(cut);
        check(mut tally, 2, cut == n or rest == arm(k, a - used_a, b - (cut - used_a)));
        // P3: the fewer letter never doubles, and the runs of the other
        // never grow
        let shorter = runs_of(s.clone(), fewer);
        let longer = runs_of(s.clone(), more);
        let mut shape = true;
        for r in shorter {
            if r != 1 {
                shape = false;
            }
        }
        for i in 1..longer.len() {
            if longer[i] > longer[i - 1] {
                shape = false;
            }
        }
        check(mut tally, 3, shape);
        // P4: one more of each letter, when neither is far ahead, adds
        // `ab` at the end
        check(mut tally, 4, not one_more or arm(k, a + 1, b + 1) == s.clone() + "ab".to_string());
        // P5: the greedy rule picks every letter
        check(mut tally, 5, greedy_all_the_way(s.clone(), a, b));
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for j in 0..5 {
            if j != k and got[j] == s {
                agree += 1;
            }
        }
        check(mut tally, 6, agree >= 2);
    }
    got[0].clone()
}

fn main() {
    let mut tally = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 984;
    let mut letters = 0;
    let mut doubled = 0;
    let mut check_sum = 0;
    // 3000 pairs of up to 8 of each letter against the statement, then
    // 200 of up to LeetCode's 100, each with an answer
    for c in 0..3200 {
        let small = c < 3000;
        let top = if small { 8 } else { 100 };
        let mut a = next_random(mut seed) % (top + 1);
        let mut b = next_random(mut seed) % (top + 1);
        while not possible(a, b) {
            a = next_random(mut seed) % (top + 1);
            b = next_random(mut seed) % (top + 1);
        }
        let s = properties(mut tally, a, b, small, mut seed);
        let mut prev = ' ';
        for x in s.chars() {
            if x == prev {
                doubled += 1;
            }
            prev = x;
            check_sum = (check_sum * 31 + (if x == 'a' { 1 } else { 2 })) % 1000000007;
        }
        check_sum = (check_sum * 31 + 3) % 1000000007;
        letters += s.len();
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += tally.failures[p];
        if tally.failures[p] > 0 {
            by = by + f" P{p + 1} {tally.failures[p]}";
        }
    }
    println(f"3200 pairs of {letters} letters: {doubled} doubled, checksum {check_sum}, {tally.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
