// LeetCode #935: Knight Dialer -- four groups of digits.
//
// The keypad's symmetry splits the digits into groups whose counts stay
// equal: the corners 1, 3, 7, 9; the 2 and the 8; the 4 and the 6; and
// the 0 (the 5 has no jumps, so it counts only for numbers one digit
// long). A corner is reached from one of 2 and 8 and one of 4 and 6; the
// 2 and the 8 from two corners; the 4 and the 6 from two corners and the
// 0; the 0 from the 4 and the 6. Track one count per group. O(n).

fn knight_dialer(n: i64) -> i64 {
    let modulus = 1000000007;
    if n == 1 {
        return 10;
    }
    let mut corner = 1;
    let mut top = 1;
    let mut side = 1;
    let mut zero = 1;
    for _ in 1..n {
        let c = (top + side) % modulus;
        let t = 2 * corner % modulus;
        let s = (2 * corner + zero) % modulus;
        let z = 2 * side % modulus;
        corner = c;
        top = t;
        side = s;
        zero = z;
    }
    (4 * corner + 2 * top + 2 * side + zero) % modulus
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples, then the first ten lengths
    println(f"n = 1: {knight_dialer(1)}");
    println(f"n = 2: {knight_dialer(2)}");
    println(f"n = 3131: {knight_dialer(3131)}");
    let mut first = String.new();
    for n in 1..11 {
        if n > 1 {
            first = first + ", ";
        }
        first = first + f"{knight_dialer(n)}";
    }
    println(f"n from 1 to 10: {first}");
    // the first length past 10^9 + 7, and every length up to 300 folded
    // into a checksum
    println(f"n = 23: {knight_dialer(23)}, n = 24: {knight_dialer(24)}");
    let mut sum = 0;
    let mut check = 0;
    for n in 1..301 {
        let a = knight_dialer(n);
        sum += a;
        check = (check * 1000003 + a) % 1000000007;
    }
    println(f"n from 1 to 300: answers summing to {sum}, checksum {check}");
    // LeetCode's largest and a few beside it
    println(f"n = 4999: {knight_dialer(4999)}, n = 5000: {knight_dialer(5000)}, n = 2048: {knight_dialer(2048)}");
}
