// LeetCode #935: Knight Dialer -- a power of the jump matrix.
//
// Entry (i, j) of the 10 x 10 jump matrix is 1 when a knight jumps from
// digit i to digit j, and entry (i, j) of its (n - 1)th power counts the
// numbers of length n from i to j. Raise it by repeated squaring and add
// up every entry, modulo 10^9 + 7. O(10^3 log n).

fn multiply(a: Vec[Vec[i64]], b: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let modulus = 1000000007;
    let mut out: Vec[Vec[i64]] = Vec.new();
    for i in 0..10 {
        let mut row: Vec[i64] = Vec.filled(10, 0);
        for k in 0..10 {
            if a[i][k] != 0 {
                for j in 0..10 {
                    row[j] = (row[j] + a[i][k] * b[k][j]) % modulus;
                }
            }
        }
        out.push(row);
    }
    out
}

fn knight_dialer(n: i64) -> i64 {
    let modulus = 1000000007;
    let jumps: Vec[Vec[i64]] = vec![vec![4, 6], vec![6, 8], vec![7, 9], vec![4, 8], vec![0, 3, 9], Vec.new(), vec![0, 1, 7], vec![2, 6], vec![1, 3], vec![2, 4]];
    let mut base: Vec[Vec[i64]] = Vec.new();
    let mut power: Vec[Vec[i64]] = Vec.new();
    for i in 0..10 {
        let mut row: Vec[i64] = Vec.filled(10, 0);
        for j in jumps[i].iter() {
            row[*j] = 1;
        }
        base.push(row);
        let mut unit: Vec[i64] = Vec.filled(10, 0);
        unit[i] = 1;
        power.push(unit);
    }
    let mut e = n - 1;
    while e > 0 {
        if e % 2 == 1 {
            power = multiply(power, base.clone());
        }
        base = multiply(base.clone(), base.clone());
        e = e / 2;
    }
    let mut total = 0;
    for row in power.iter() {
        for v in row.iter() {
            total = (total + *v) % modulus;
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples, then the first ten lengths
    println(f"n = 1: {knight_dialer(1)}");
    println(f"n = 2: {knight_dialer(2)}");
    println(f"n = 3131: {knight_dialer(3131)}");
    let mut first = String.new();
    for n in 1..11 {
        if n > 1 {
            first = first + ", ";
        }
        first = first + f"{knight_dialer(n)}";
    }
    println(f"n from 1 to 10: {first}");
    // the first length past 10^9 + 7, and every length up to 300 folded
    // into a checksum
    println(f"n = 23: {knight_dialer(23)}, n = 24: {knight_dialer(24)}");
    let mut sum = 0;
    let mut check = 0;
    for n in 1..301 {
        let a = knight_dialer(n);
        sum += a;
        check = (check * 1000003 + a) % 1000000007;
    }
    println(f"n from 1 to 300: answers summing to {sum}, checksum {check}");
    // LeetCode's largest and a few beside it
    println(f"n = 4999: {knight_dialer(4999)}, n = 5000: {knight_dialer(5000)}, n = 2048: {knight_dialer(2048)}");
}
