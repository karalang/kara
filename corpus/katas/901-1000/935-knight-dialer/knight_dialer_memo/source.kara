// LeetCode #935: Knight Dialer -- recursion with a memo.
//
// count(d, left), the numbers that start on digit d and make `left` more
// jumps, is 1 with none left and otherwise the sum of count(j, left - 1)
// over d's jumps j. Work it out recursively, keeping every result in a
// table so each is computed once, and add count(d, n - 1) over the ten
// digits. O(n), recursion n deep.

fn count(d: i64, left: i64, jumps: ref Vec[Vec[i64]], memo: mut ref Vec[Vec[i64]]) -> i64 {
    if left == 0 {
        return 1;
    }
    if memo[d][left] >= 0 {
        return memo[d][left];
    }
    let mut total = 0;
    for j in jumps[d].iter() {
        total = (total + count(*j, left - 1, jumps, mut memo)) % 1000000007;
    }
    memo[d][left] = total;
    total
}

fn knight_dialer(n: i64) -> i64 {
    let jumps: Vec[Vec[i64]] = vec![vec![4, 6], vec![6, 8], vec![7, 9], vec![4, 8], vec![0, 3, 9], Vec.new(), vec![0, 1, 7], vec![2, 6], vec![1, 3], vec![2, 4]];
    let mut memo: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        memo.push(Vec.filled(n, -1));
    }
    let mut total = 0;
    for d in 0..10 {
        total = (total + count(d, n - 1, jumps, mut memo)) % 1000000007;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples, then the first ten lengths
    println(f"n = 1: {knight_dialer(1)}");
    println(f"n = 2: {knight_dialer(2)}");
    println(f"n = 3131: {knight_dialer(3131)}");
    let mut first = String.new();
    for n in 1..11 {
        if n > 1 {
            first = first + ", ";
        }
        first = first + f"{knight_dialer(n)}";
    }
    println(f"n from 1 to 10: {first}");
    // the first length past 10^9 + 7, and every length up to 300 folded
    // into a checksum
    println(f"n = 23: {knight_dialer(23)}, n = 24: {knight_dialer(24)}");
    let mut sum = 0;
    let mut check = 0;
    for n in 1..301 {
        let a = knight_dialer(n);
        sum += a;
        check = (check * 1000003 + a) % 1000000007;
    }
    println(f"n from 1 to 300: answers summing to {sum}, checksum {check}");
    // LeetCode's largest and a few beside it
    println(f"n = 4999: {knight_dialer(4999)}, n = 5000: {knight_dialer(5000)}, n = 2048: {knight_dialer(2048)}");
}
