// LeetCode #935: Knight Dialer -- differential test of the five arms
// against the statement read literally, with six properties.
//
// The statement: a chess knight can move two squares vertically and one
// square horizontally, or two squares horizontally and one square
// vertically. We have a chess knight and a phone pad, and the knight can
// only stand on a numeric cell. Given an integer n, return how many
// distinct phone numbers of length n we can dial. You are allowed to
// place the knight on any numeric cell initially and then you should
// perform n - 1 jumps to dial a number of length n. All jumps should be
// valid knight jumps. As the answer may be very large, return the answer
// modulo 10^9 + 7.

// ---- the ★ arm: counts by last digit, one jump at a time ------------------
fn star_knight_dialer(n: i64) -> i64 {
    let modulus = 1000000007;
    let jumps: Vec[Vec[i64]] = vec![vec![4, 6], vec![6, 8], vec![7, 9], vec![4, 8], vec![0, 3, 9], Vec.new(), vec![0, 1, 7], vec![2, 6], vec![1, 3], vec![2, 4]];
    let mut counts: Vec[i64] = Vec.filled(10, 1);
    for _ in 1..n {
        let mut next: Vec[i64] = Vec.filled(10, 0);
        for d in 0..10 {
            for from in jumps[d].iter() {
                next[d] = (next[d] + counts[*from]) % modulus;
            }
        }
        counts = next;
    }
    let mut total = 0;
    for c in counts.iter() {
        total = (total + *c) % modulus;
    }
    total
}

// ---- the groups arm: four groups of digits --------------------------------
fn groups_knight_dialer(n: i64) -> i64 {
    let modulus = 1000000007;
    if n == 1 {
        return 10;
    }
    let mut corner = 1;
    let mut top = 1;
    let mut side = 1;
    let mut zero = 1;
    for _ in 1..n {
        let c = (top + side) % modulus;
        let t = 2 * corner % modulus;
        let s = (2 * corner + zero) % modulus;
        let z = 2 * side % modulus;
        corner = c;
        top = t;
        side = s;
        zero = z;
    }
    (4 * corner + 2 * top + 2 * side + zero) % modulus
}

// ---- the matrix arm: a power of the jump matrix ---------------------------
fn matrix_multiply(a: Vec[Vec[i64]], b: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let modulus = 1000000007;
    let mut out: Vec[Vec[i64]] = Vec.new();
    for i in 0..10 {
        let mut row: Vec[i64] = Vec.filled(10, 0);
        for k in 0..10 {
            if a[i][k] != 0 {
                for j in 0..10 {
                    row[j] = (row[j] + a[i][k] * b[k][j]) % modulus;
                }
            }
        }
        out.push(row);
    }
    out
}

fn matrix_knight_dialer(n: i64) -> i64 {
    let modulus = 1000000007;
    let jumps: Vec[Vec[i64]] = vec![vec![4, 6], vec![6, 8], vec![7, 9], vec![4, 8], vec![0, 3, 9], Vec.new(), vec![0, 1, 7], vec![2, 6], vec![1, 3], vec![2, 4]];
    let mut base: Vec[Vec[i64]] = Vec.new();
    let mut power: Vec[Vec[i64]] = Vec.new();
    for i in 0..10 {
        let mut row: Vec[i64] = Vec.filled(10, 0);
        for j in jumps[i].iter() {
            row[*j] = 1;
        }
        base.push(row);
        let mut unit: Vec[i64] = Vec.filled(10, 0);
        unit[i] = 1;
        power.push(unit);
    }
    let mut e = n - 1;
    while e > 0 {
        if e % 2 == 1 {
            power = matrix_multiply(power, base.clone());
        }
        base = matrix_multiply(base.clone(), base.clone());
        e = e / 2;
    }
    let mut total = 0;
    for row in power.iter() {
        for v in row.iter() {
            total = (total + *v) % modulus;
        }
    }
    total
}

// ---- the memo arm: recursion with a memo ----------------------------------
fn memo_count(d: i64, left: i64, jumps: ref Vec[Vec[i64]], memo: mut ref Vec[Vec[i64]]) -> i64 {
    if left == 0 {
        return 1;
    }
    if memo[d][left] >= 0 {
        return memo[d][left];
    }
    let mut total = 0;
    for j in jumps[d].iter() {
        total = (total + memo_count(*j, left - 1, jumps, mut memo)) % 1000000007;
    }
    memo[d][left] = total;
    total
}

fn memo_knight_dialer(n: i64) -> i64 {
    let jumps: Vec[Vec[i64]] = vec![vec![4, 6], vec![6, 8], vec![7, 9], vec![4, 8], vec![0, 3, 9], Vec.new(), vec![0, 1, 7], vec![2, 6], vec![1, 3], vec![2, 4]];
    let mut memo: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        memo.push(Vec.filled(n, -1));
    }
    let mut total = 0;
    for d in 0..10 {
        total = (total + memo_count(d, n - 1, jumps, mut memo)) % 1000000007;
    }
    total
}

// ---- the board arm: the keypad as a board ---------------------------------
fn board_knight_dialer(n: i64) -> i64 {
    let modulus = 1000000007;
    let dr = [-2, -2, -1, -1, 1, 1, 2, 2];
    let dc = [-1, 1, -2, 2, -2, 2, -1, 1];
    // a key at every cell but the two beside the 0
    let mut key: Vec[Vec[bool]] = Vec.new();
    for r in 0..4 {
        let mut row: Vec[bool] = Vec.new();
        for c in 0..3 {
            row.push(r < 3 or c == 1);
        }
        key.push(row);
    }
    let mut counts: Vec[Vec[i64]] = Vec.new();
    for r in 0..4 {
        let mut row: Vec[i64] = Vec.new();
        for c in 0..3 {
            row.push(if key[r][c] { 1 } else { 0 });
        }
        counts.push(row);
    }
    for _ in 1..n {
        let mut next: Vec[Vec[i64]] = Vec.new();
        for r in 0..4 {
            let mut row: Vec[i64] = Vec.filled(3, 0);
            for c in 0..3 {
                if key[r][c] {
                    for k in 0..8 {
                        let rr = r + dr[k];
                        let cc = c + dc[k];
                        if rr >= 0 and rr < 4 and cc >= 0 and cc < 3 and key[rr][cc] {
                            row[c] = (row[c] + counts[rr][cc]) % modulus;
                        }
                    }
                }
            }
            next.push(row);
        }
        counts = next;
    }
    let mut total = 0;
    for row in counts.iter() {
        for v in row.iter() {
            total = (total + *v) % modulus;
        }
    }
    total
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, n: i64) -> i64 {
    if x == 0 {
        star_knight_dialer(n)
    } else if x == 1 {
        groups_knight_dialer(n)
    } else if x == 2 {
        matrix_knight_dialer(n)
    } else if x == 3 {
        memo_knight_dialer(n)
    } else {
        board_knight_dialer(n)
    }
}

// The statement read literally: the knight starts on any numeric cell
// and makes n - 1 jumps, each two squares one way and one the other,
// onto a numeric cell; every such walk dials a distinct number. The
// digits' rows and columns on the pad, and every walk counted one by one.
fn walks(d: i64, left: i64, row: ref Vec[i64], col: ref Vec[i64]) -> i64 {
    if left == 0 {
        return 1;
    }
    let mut total = 0;
    for e in 0..10 {
        let a = (row[d] - row[e]).abs();
        let b = (col[d] - col[e]).abs();
        if (a == 1 and b == 2) or (a == 2 and b == 1) {
            total += walks(e, left - 1, row, col);
        }
    }
    total
}

fn literal(n: i64) -> i64 {
    // 1 2 3 / 4 5 6 / 7 8 9 / * 0 #
    let row: Vec[i64] = vec![3, 0, 0, 0, 1, 1, 1, 2, 2, 2];
    let col: Vec[i64] = vec![1, 0, 1, 2, 0, 1, 2, 0, 1, 2];
    let mut total = 0;
    for d in 0..10 {
        total += walks(d, n - 1, row, col);
    }
    total % 1000000007
}

// x^k reduced modulo x^4 - 6x^2 + 4, the coefficients modulo 10^9 + 7
fn jump(k: i64) -> Vec[i64] {
    let p = 1000000007;
    let mut c: Vec[i64] = vec![1, 0, 0, 0];
    for _ in 0..k {
        // times x, with x^4 = 6x^2 - 4
        let top = c[3];
        c[3] = c[2];
        c[2] = (c[1] + 6 * top) % p;
        c[1] = c[0];
        c[0] = (p - 4 * top % p) % p;
    }
    c
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, n: i64, small: bool) {
    let p = 1000000007;
    // the first nine answers, for the properties that start later
    let first: Vec[i64] = vec![0, 10, 20, 46, 104, 240, 544, 1256, 2848, 6576];
    let k = if n >= 6 { 4 + next_random(mut seed) % (n - 5) } else { 0 };
    let c = jump(k);
    let truth = if small { literal(n) } else { 0 };
    let mut got: Vec[i64] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, n));
    }
    for x in 0..5 {
        let a = got[x];
        // this arm's answers two and four shorter and two longer, kept
        // for the properties that use them
        let two_back = if n >= 3 { arm(x, n - 2) } else { 0 };
        let four_back = if n >= 5 { arm(x, n - 4) } else { 0 };
        let two_on = if n >= 6 { arm(x, n + 2) } else { 0 };
        // P1: the statement's answer, on the small n
        if small {
            check(mut t, 1, a == truth);
        }
        // P2: from 0 to 10^9 + 6; while nothing wraps, from n = 2 to 23,
        // two to three times the answer one shorter, since after the first
        // digit every number stands on a key with two or three jumps
        let mut ranged = a >= 0 and a < p;
        if n >= 2 and n <= 23 {
            let before = arm(x, n - 1);
            ranged = ranged and a >= 2 * before and a <= 3 * before;
        }
        check(mut t, 2, ranged);
        // P3: a(n) = 6 a(n - 2) - 4 a(n - 4) from n = 6
        if n >= 6 {
            let want = (6 * two_back % p + p - 4 * four_back % p) % p;
            check(mut t, 3, a == want);
        } else {
            check(mut t, 3, a == first[n]);
        }
        // P4: from n = 6, every other answer keeps
        // a(n)^2 - a(n - 2) a(n + 2) = 4 (a(n - 2)^2 - a(n - 4) a(n))
        if n >= 6 {
            let left = (a * a % p + p - two_back * two_on % p) % p;
            let right = 4 * ((two_back * two_back % p + p - four_back * a % p) % p) % p;
            check(mut t, 4, left == right);
        } else {
            check(mut t, 4, a == first[n]);
        }
        // P5: from n = 6, a(n) from the four answers k back, with x^k
        // reduced by the recurrence's polynomial, k random
        if n >= 6 {
            let m = n - k;
            let mut want = 0;
            for i in 0..4 {
                want = (want + c[i] * arm(x, m + i)) % p;
            }
            check(mut t, 5, a == want);
        } else {
            check(mut t, 5, a == first[n]);
        }
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == a {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut seed = 935;
    let mut cases = 0;
    let mut lengths = 0;
    let mut check_sum = 0;
    // n from 1 to 7 against the statement, then from 1 to 100
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 7 } else { 1 + next_random(mut seed) % 100 };
        cases += 1;
        lengths += n;
        check_sum = (check_sum * 1000003 + arm(0, n)) % 1000000007;
        properties(mut t, mut seed, n, small);
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{cases} lengths summing to {lengths}, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
