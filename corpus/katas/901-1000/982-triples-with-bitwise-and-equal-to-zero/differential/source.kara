// LeetCode #982: Triples with Bitwise AND Equal To Zero -- differential.
//
// The five arms against the statement read literally and against each
// other, on random lists.

// ---- star ----

fn star_count_triplets(nums: Vec[i64]) -> i64 {
    let mut all = 0;
    for x in nums {
        all = all | x;
    }
    let mut size = 1;
    while size <= all {
        size *= 2;
    }
    let full = size - 1;
    let mut pairs: Vec[i64] = Vec.filled(size, 0);
    for a in nums {
        for b in nums {
            pairs[a & b] += 1;
        }
    }
    let mut triples = 0;
    for x in nums {
        let free = full ^ x;
        let mut s = free;
        loop {
            triples += pairs[s];
            if s == 0 {
                break;
            }
            s = (s - 1) & free;
        }
    }
    triples
}

// ---- map ----

fn map_count_triplets(nums: Vec[i64]) -> i64 {
    let mut pairs: Map[i64, i64] = Map.new();
    for a in nums {
        for b in nums {
            let had = pairs.get(a & b) ?? 0;
            pairs.insert(a & b, had + 1);
        }
    }
    let mut triples = 0;
    for x in nums {
        for (mask, count) in pairs {
            if mask & x == 0 {
                triples += count;
            }
        }
    }
    triples
}

// ---- sos ----

fn sos_count_triplets(nums: Vec[i64]) -> i64 {
    let mut all = 0;
    for x in nums {
        all = all | x;
    }
    let mut size = 1;
    while size <= all {
        size *= 2;
    }
    let mut sup: Vec[i64] = Vec.filled(size, 0);
    for x in nums {
        sup[x] += 1;
    }
    let mut bit = 1;
    while bit < size {
        for m in 0..size {
            if m & bit == 0 {
                sup[m] += sup[m | bit];
            }
        }
        bit *= 2;
    }
    let mut triples = 0;
    for m in 0..size {
        let c = sup[m] * sup[m] * sup[m];
        if m.count_ones() % 2 == 0 {
            triples += c;
        } else {
            triples -= c;
        }
    }
    triples
}

// ---- complement ----

fn complement_count_triplets(nums: Vec[i64]) -> i64 {
    let mut all = 0;
    for x in nums {
        all = all | x;
    }
    let mut size = 1;
    while size <= all {
        size *= 2;
    }
    let full = size - 1;
    let mut pairs: Vec[i64] = Vec.filled(size, 0);
    let mut sub: Vec[i64] = Vec.filled(size, 0);
    for a in nums {
        sub[a] += 1;
        for b in nums {
            pairs[a & b] += 1;
        }
    }
    let mut bit = 1;
    while bit < size {
        for m in 0..size {
            if m & bit != 0 {
                sub[m] += sub[m ^ bit];
            }
        }
        bit *= 2;
    }
    let mut triples = 0;
    for a in 0..size {
        triples += pairs[a] * sub[full ^ a];
    }
    triples
}

// ---- mobius ----

fn mobius_count_triplets(nums: Vec[i64]) -> i64 {
    let mut all = 0;
    for x in nums {
        all = all | x;
    }
    let mut size = 1;
    while size <= all {
        size *= 2;
    }
    let full = size - 1;
    let mut exact: Vec[i64] = Vec.filled(size, 0);
    for x in nums {
        exact[x] += 1;
    }
    let mut bit = 1;
    while bit < size {
        for m in 0..size {
            if m & bit == 0 {
                exact[m] += exact[m | bit];
            }
        }
        bit *= 2;
    }
    for m in 0..size {
        exact[m] = exact[m] * exact[m];
    }
    bit = 1;
    while bit < size {
        for m in 0..size {
            if m & bit == 0 {
                exact[m] -= exact[m | bit];
            }
        }
        bit *= 2;
    }
    let mut triples = 0;
    for x in nums {
        let free = full ^ x;
        let mut s = free;
        loop {
            triples += exact[s];
            if s == 0 {
                break;
            }
            s = (s - 1) & free;
        }
    }
    triples
}

// ---- differential ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The statement read literally: every triple of indices (i, j, k), each
// from 0 to n - 1, counted when the AND of its three values is 0.
fn literal(nums: ref Vec[i64]) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for i in 0..n {
        for j in 0..n {
            for k in 0..n {
                if nums[i] & nums[j] & nums[k] == 0 {
                    count += 1;
                }
            }
        }
    }
    count
}

fn arm(a: i64, nums: ref Vec[i64]) -> i64 {
    if a == 0 {
        star_count_triplets(nums)
    } else if a == 1 {
        map_count_triplets(nums)
    } else if a == 2 {
        sos_count_triplets(nums)
    } else if a == 3 {
        complement_count_triplets(nums)
    } else {
        mobius_count_triplets(nums)
    }
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(tally: mut ref Tally, nums: ref Vec[i64], small: bool, seed: mut ref i64) -> i64 {
    let n = nums.len();
    let truth = if small { literal(nums) } else { 0 };
    let mut got: Vec[i64] = Vec.new();
    for a in 0..5 {
        got.push(arm(a, nums));
    }
    // the bits the values use: 0 .. width - 1
    let mut all = 0;
    for x in nums {
        all = all | x;
    }
    let mut width = 0;
    while (1 << width) <= all {
        width += 1;
    }
    // the list reversed and then rotated by a random amount
    let turn = next_random(mut seed) % n;
    let mut moved: Vec[i64] = Vec.new();
    for i in 0..n {
        moved.push(nums[(2 * n - 1 - i - turn) % n]);
    }
    // every value's bits rotated by the same random amount within the
    // width, which keeps every AND of a triple zero or not
    let r = if width > 1 { 1 + next_random(mut seed) % (width - 1) } else { 0 };
    let mut rotated: Vec[i64] = Vec.new();
    for x in nums {
        rotated.push(if r == 0 { x } else { ((x << r) | (x >> (width - r))) & ((1 << width) - 1) });
    }
    // a 0 appended
    let mut zeroed = nums.clone();
    zeroed.push(0);
    // a value with every bit in use appended: a triple holding it once
    // has the AND of the other two, twice the other value, three times
    // the value itself, which is not 0
    let full = if width == 0 { 1 } else { (1 << width) - 1 };
    let mut filled = nums.clone();
    filled.push(full);
    let mut pairs = 0;
    let mut zeros = 0;
    for a in nums {
        if a & full == 0 {
            zeros += 1;
        }
        for b in nums {
            if a & b == 0 {
                pairs += 1;
            }
        }
    }
    for a in 0..5 {
        let p = got[a];
        // P1: the statement's answer, on the first 3000 lists
        if small {
            check(mut tally, 1, p == truth);
        }
        // P2: the order of the values does not matter
        check(mut tally, 2, arm(a, moved) == p);
        // P3: the same rotation of every value's bits keeps the count
        check(mut tally, 3, arm(a, rotated) == p);
        // P4: a 0 appended joins every triple that holds it: (n + 1)^3 -
        // n^3 more
        check(mut tally, 4, arm(a, zeroed) == p + 3 * n * n + 3 * n + 1);
        // P5: a value with every bit appended adds three times the pairs
        // whose AND is 0 and three times the values that are 0
        check(mut tally, 5, arm(a, filled) == p + 3 * pairs + 3 * zeros);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for b in 0..5 {
            if b != a and got[b] == p {
                agree += 1;
            }
        }
        check(mut tally, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut tally = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 982;
    let mut values = 0;
    let mut triples = 0;
    let mut check_sum = 0;
    // 3000 lists of 1 to 20 values against the statement, then 200 of 60;
    // the values use 1, 2, 3, 4, 6 or 8 bits by turns in the short lists
    // and 8 to 11 in the long ones
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 20 } else { 60 };
        let bits = if small { vec![1, 2, 3, 4, 6, 8][c % 6] } else { 8 + c % 4 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % (1 << bits));
        }
        let got = properties(mut tally, nums, small, mut seed);
        values += n;
        triples += got;
        check_sum = (check_sum * 31 + got) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += tally.failures[p];
        if tally.failures[p] > 0 {
            by = by + f" P{p + 1} {tally.failures[p]}";
        }
    }
    println(f"3200 lists of {values} values: triples {triples}, checksum {check_sum}, {tally.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
