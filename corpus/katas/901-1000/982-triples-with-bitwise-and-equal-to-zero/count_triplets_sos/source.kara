// LeetCode #982: Triples with Bitwise AND Equal To Zero -- inclusion and
// exclusion over superset counts.
//
// For each mask m, sup[m] counts the values that have every bit of m,
// found for all masks at once by adding each mask's count into the
// masks one bit below it, a bit at a time. A triple whose AND has every
// bit of m is any three of those values, sup[m]^3 of them, so inclusion
// and exclusion over the masks leaves the triples whose AND has no bit
// at all: the sum over m of (-1)^|m| sup[m]^3. O(w * 2^w) for w bits.

fn count_triplets(nums: Vec[i64]) -> i64 {
    let mut all = 0;
    for x in nums {
        all = all | x;
    }
    let mut size = 1;
    while size <= all {
        size *= 2;
    }
    let mut sup: Vec[i64] = Vec.filled(size, 0);
    for x in nums {
        sup[x] += 1;
    }
    let mut bit = 1;
    while bit < size {
        for m in 0..size {
            if m & bit == 0 {
                sup[m] += sup[m | bit];
            }
        }
        bit *= 2;
    }
    let mut triples = 0;
    for m in 0..size {
        let c = sup[m] * sup[m] * sup[m];
        if m.count_ones() % 2 == 0 {
            triples += c;
        } else {
            triples -= c;
        }
    }
    triples
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    let mut text = String.new();
    for x in nums {
        if text.len() > 0 {
            text = text + ", ";
        }
        text = text + f"{x}";
    }
    println(f"[{text}] -> {count_triplets(nums)}");
}

fn main() {
    // LeetCode's examples
    show(vec![2, 1, 3]);
    show(vec![0, 0, 0]);
    // a few more: one value, no zero AND at all, distinct bits, three
    // values whose AND needs all three, LeetCode's largest value
    show(vec![0]);
    show(vec![1]);
    show(vec![1, 2]);
    show(vec![1, 2, 4]);
    show(vec![3, 5, 6]);
    show(vec![65535, 0]);
    show(vec![65535, 65535, 65535]);
    show(vec![32768, 32767]);
    // random lists: 300 of up to 12 values below 8, 3000 of up to 30
    // values below 256, then 2 of 1000 values below 65536
    let mut seed = 982;
    for (count, longest, below) in vec![(300, 12, 8), (3000, 30, 256), (2, 1000, 65536)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if count == 2 { longest } else { 1 + next_random(mut seed) % longest };
            let mut nums: Vec[i64] = Vec.new();
            for _ in 0..n {
                nums.push(next_random(mut seed) % below);
            }
            let t = count_triplets(nums);
            total += t;
            check = (check * 31 + t) % 1000000007;
        }
        let size = if count == 2 { f"{longest}" } else { f"up to {longest}" };
        println(f"{count} random lists of {size} values below {below}: triples {total}, checksum {check}");
    }
}
