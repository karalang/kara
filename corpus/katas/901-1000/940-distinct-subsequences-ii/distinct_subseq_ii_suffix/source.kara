// LeetCode #940: Distinct Subsequences II -- the subsequence automaton.
//
// Every distinct subsequence has one way to be found taking each letter
// as early as possible. So build, for each place and letter, where that
// letter next comes; then from the right, the subsequences that start at
// or after a place are, for each letter that comes again, that letter
// alone or followed by one that starts just after it. O(26 n) time and
// space.

fn distinct_subseq_ii(s: String) -> i64 {
    let m = 1000000007;
    let b = s.bytes().to_vec();
    let n = b.len();
    // next[i * 26 + c]: the first place at or after i holding letter c,
    // n if none
    let mut next: Vec[i64] = Vec.new();
    for _ in 0..((n + 1) * 26) {
        next.push(n);
    }
    let mut i = n;
    while i > 0 {
        i -= 1;
        for c in 0..26 {
            next[i * 26 + c] = next[(i + 1) * 26 + c];
        }
        next[i * 26 + (b[i] - b'a') as i64] = i;
    }
    // from[i]: distinct non-empty subsequences of the letters from i on
    let mut from: Vec[i64] = Vec.new();
    for _ in 0..(n + 1) {
        from.push(0);
    }
    let mut i = n;
    while i > 0 {
        i -= 1;
        let mut total = 0;
        for c in 0..26 {
            let p = next[i * 26 + c];
            if p < n {
                total = (total + 1 + from[p + 1]) % m;
            }
        }
        from[i] = total;
    }
    from[0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n random letters from the first k of the alphabet.
fn random_word(seed: mut ref i64, n: i64, k: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((next_random(mut seed) % k + 97) as u8 as char);
    }
    s
}

fn main() {
    // LeetCode's three examples, then a few more
    for s in ["abc", "aba", "aaa", "a", "ab", "abab", "zyxz", "abcdefghijklmnopqrstuvwxyz"] {
        println(f"\"{s}\": {distinct_subseq_ii(s.to_string())}");
    }
    // 300 random words of 1 to 100 letters from the first 1 to 26
    let mut seed = 940;
    let mut letters = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 100;
        let k = 1 + next_random(mut seed) % 26;
        let a = distinct_subseq_ii(random_word(mut seed, n, k));
        letters += n;
        total += a;
        check = (check * 1000003 + a) % 1000000007;
    }
    println(f"300 random words of {letters} letters: counts adding to {total}, checksum {check}");
    // LeetCode's longest: 2000 letters
    println(f"2000 times a: {distinct_subseq_ii("a".repeat(2000))}");
    println(f"ab 1000 times: {distinct_subseq_ii("ab".repeat(1000))}");
    println(f"the alphabet 76 times and abcd: {distinct_subseq_ii("abcdefghijklmnopqrstuvwxyz".repeat(76) + "abcd")}");
    println(f"2000 random letters: {distinct_subseq_ii(random_word(mut seed, 2000, 26))}");
    println(f"2000 random letters from abc: {distinct_subseq_ii(random_word(mut seed, 2000, 3))}");
}
