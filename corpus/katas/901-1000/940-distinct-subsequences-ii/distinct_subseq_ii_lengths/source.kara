// LeetCode #940: Distinct Subsequences II -- counts by length.
//
// Keep, for each length and each letter, how many distinct subsequences
// of that length end with that letter, and for each length the total.
// When a letter comes, those of length L ending with it become every
// subsequence of length L - 1 with the letter put after, the empty one
// for L = 1; the lengths are done from the longest down, so that each
// uses the totals from before the letter. The answer adds up every
// length. O(n^2) time, O(26 n) space.

fn distinct_subseq_ii(s: String) -> i64 {
    let m = 1000000007;
    let b = s.bytes().to_vec();
    let n = b.len();
    // ends[c * (n + 1) + l] and total[l], for lengths l from 0 to n
    let mut ends: Vec[i64] = Vec.new();
    for _ in 0..(26 * (n + 1)) {
        ends.push(0);
    }
    let mut total: Vec[i64] = vec![1];
    for _ in 0..n {
        total.push(0);
    }
    for i in 0..n {
        let c = (b[i] - b'a') as i64;
        let mut l = i + 1;
        while l >= 1 {
            let was = ends[c * (n + 1) + l];
            let now = total[l - 1];
            ends[c * (n + 1) + l] = now;
            total[l] = (total[l] - was + now + m) % m;
            l -= 1;
        }
    }
    let mut answer = 0;
    for l in 1..(n + 1) {
        answer = (answer + total[l]) % m;
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n random letters from the first k of the alphabet.
fn random_word(seed: mut ref i64, n: i64, k: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((next_random(mut seed) % k + 97) as u8 as char);
    }
    s
}

fn main() {
    // LeetCode's three examples, then a few more
    for s in ["abc", "aba", "aaa", "a", "ab", "abab", "zyxz", "abcdefghijklmnopqrstuvwxyz"] {
        println(f"\"{s}\": {distinct_subseq_ii(s.to_string())}");
    }
    // 300 random words of 1 to 100 letters from the first 1 to 26
    let mut seed = 940;
    let mut letters = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 100;
        let k = 1 + next_random(mut seed) % 26;
        let a = distinct_subseq_ii(random_word(mut seed, n, k));
        letters += n;
        total += a;
        check = (check * 1000003 + a) % 1000000007;
    }
    println(f"300 random words of {letters} letters: counts adding to {total}, checksum {check}");
    // LeetCode's longest: 2000 letters
    println(f"2000 times a: {distinct_subseq_ii("a".repeat(2000))}");
    println(f"ab 1000 times: {distinct_subseq_ii("ab".repeat(1000))}");
    println(f"the alphabet 76 times and abcd: {distinct_subseq_ii("abcdefghijklmnopqrstuvwxyz".repeat(76) + "abcd")}");
    println(f"2000 random letters: {distinct_subseq_ii(random_word(mut seed, 2000, 26))}");
    println(f"2000 random letters from abc: {distinct_subseq_ii(random_word(mut seed, 2000, 3))}");
}
