// LeetCode #917: Reverse Only Letters -- swapping by recursion.
//
// The two-pointer walk written as a recursion on the window [i, j): an
// empty or one-wide window is done; otherwise drop a non-letter at either
// end, or swap the two letters at the ends and recurse on the window one
// narrower each side. The depth is at most n. O(n) time.

fn is_letter(b: u8) -> bool {
    (b >= b'a' and b <= b'z') or (b >= b'A' and b <= b'Z')
}

fn swap_letters(bytes: mut ref Vec[u8], i: i64, j: i64) {
    if j - i < 2 {
        return;
    }
    if not is_letter(bytes[i]) {
        swap_letters(mut bytes, i + 1, j);
    } else if not is_letter(bytes[j - 1]) {
        swap_letters(mut bytes, i, j - 1);
    } else {
        bytes.swap(i, j - 1);
        swap_letters(mut bytes, i + 1, j - 1);
    }
}

fn reverse_only_letters(s: String) -> String {
    let mut bytes: Vec[u8] = s.bytes().to_vec();
    let n = bytes.len();
    swap_letters(mut bytes, 0, n);
    String.from_utf8(bytes).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: String) {
    println(f"\"{s}\": \"{reverse_only_letters(s)}\"");
}

// A string of `len` characters from ASCII 33 to 122, leaving out '"'
// and '\', as the constraints allow; `letters` in 100 of them are
// letters, half each case.
fn random_string(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        if next_random(mut seed) % 100 < letters {
            let c = next_random(mut seed) % 26;
            if next_random(mut seed) % 2 == 0 {
                s.push((97 + c) as u8 as char);
            } else {
                s.push((65 + c) as u8 as char);
            }
        } else {
            let mut b = 34;
            while b == 34 or b == 92 {
                b = 33 + next_random(mut seed) % 90;
            }
            s.push(b as u8 as char);
        }
    }
    s
}

fn fold(check: i64, s: String) -> i64 {
    let mut h = check;
    for b in s.bytes() {
        h = (h * 31 + b as i64) % 1000000007;
    }
    (h * 31 + 7) % 1000000007
}

fn main() {
    show("ab-cd");
    show("a-bC-dEf-ghIj");
    show("Test1ng-Leet=code-Q!");
    show("7_28]");
    show("a");
    show("?");
    show("z<*zj");
    show("Ab");
    show("[a]");
    show("aZ09^_`{zA");
    // random strings of 1 to 100 characters, some letters to all letters
    let mut seed = 917;
    let mut letters = 0;
    let mut check = 0;
    for c in 0..500 {
        let len = 1 + next_random(mut seed) % 100;
        let s = random_string(mut seed, len, c % 101);
        let r = reverse_only_letters(s);
        for b in r.bytes() {
            if is_letter(b) {
                letters += 1;
            }
        }
        check = fold(check, r);
    }
    println(f"500 strings: {letters} letters, checksum {check}");
    // the longest: 100 characters, 10000 times over
    let mut check = 0;
    for c in 0..10000 {
        let s = random_string(mut seed, 100, c % 101);
        check = fold(check, reverse_only_letters(s));
    }
    println(f"10000 strings of 100: checksum {check}");
}
