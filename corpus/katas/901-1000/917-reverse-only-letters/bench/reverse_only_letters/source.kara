// LeetCode #917: Reverse Only Letters -- bench: two pointers swapping
// letters.
//
// Walk one pointer from the front and one from the back of the string's
// bytes. Each skips anything that is not an English letter; when both
// rest on letters, swap them and step both inward. Everything else never
// moves. O(n) time, the bytes copied once.

fn is_letter(b: u8) -> bool {
    (b >= b'a' and b <= b'z') or (b >= b'A' and b <= b'Z')
}

fn reverse_only_letters(s: String) -> String {
    let mut bytes: Vec[u8] = s.bytes().to_vec();
    let mut i = 0;
    let mut j = bytes.len();
    while i < j {
        if not is_letter(bytes[i]) {
            i += 1;
        } else if not is_letter(bytes[j - 1]) {
            j -= 1;
        } else {
            let keep = bytes[i];
            bytes[i] = bytes[j - 1];
            bytes[j - 1] = keep;
            i += 1;
            j -= 1;
        }
    }
    let mut out = String.new();
    for b in bytes.iter() {
        out.push(*b as char);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 100 characters from ASCII 33 to 122 other than '"' and '\', `letters`
// in 100 of them letters
fn random_string(seed: mut ref i64, letters: i64) -> String {
    let mut s = String.new();
    for _ in 0..100 {
        if next_random(mut seed) % 100 < letters {
            let k = next_random(mut seed) % 52;
            s.push(if k < 26 { (97 + k) as u8 as char } else { (65 + k - 26) as u8 as char });
        } else {
            let mut b = 34;
            while b == 34 or b == 92 {
                b = 33 + next_random(mut seed) % 90;
            }
            s.push(b as u8 as char);
        }
    }
    s
}

fn main() {
    let rounds = 1000;
    let n = 1000;
    let mut seed = 917;
    // 1000 strings of 100 characters, from no letters to all letters
    let mut pool: Vec[String] = Vec.new();
    for c in 0..n {
        pool.push(random_string(mut seed, c % 101));
    }
    let mut check = 0;
    for _ in 0..rounds {
        for s in pool.iter() {
            let r = reverse_only_letters(*s);
            let bytes = r.bytes();
            check = (check * 1000003 + bytes[0] as i64 * 256 + bytes[bytes.len() - 1] as i64) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {n} strings of 100: checksum {check}");
}
