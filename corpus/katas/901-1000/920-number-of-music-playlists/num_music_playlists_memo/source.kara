// LeetCode #920: Number of Music Playlists -- the same recurrence from the
// top, memoised.
//
// count(i, j), the playlists of i songs that use exactly j distinct songs,
// asks for count(i - 1, j - 1), the last song new, and count(i - 1, j),
// the last song a repeat of one of the j - k not just played. Recurse from
// count(goal, n) and remember each answer in a table. O(goal * n) states,
// recursion goal deep.

fn count(i: i64, j: i64, n: i64, k: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if i == 0 {
        return if j == 0 { 1 } else { 0 };
    }
    if j == 0 or j > i {
        return 0;
    }
    if memo[i][j] >= 0 {
        return memo[i][j];
    }
    let modulus = 1000000007;
    let mut ways = count(i - 1, j - 1, n, k, mut memo) * (n - j + 1) % modulus;
    if j > k {
        ways = (ways + count(i - 1, j, n, k, mut memo) * (j - k)) % modulus;
    }
    memo[i][j] = ways;
    ways
}

fn num_music_playlists(n: i64, goal: i64, k: i64) -> i64 {
    let mut memo: Vec[Vec[i64]] = Vec.new();
    for _ in 0..goal + 1 {
        memo.push(Vec.filled(n + 1, -1));
    }
    count(goal, n, n, k, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64, goal: i64, k: i64) {
    println(f"n = {n}, goal = {goal}, k = {k}: {num_music_playlists(n, goal, k)}");
}

fn main() {
    // LeetCode's three examples
    show(3, 3, 1);
    show(2, 3, 0);
    show(2, 3, 1);
    // one song; every song once; the gap as long as it can be; no gap
    show(1, 1, 0);
    show(1, 5, 0);
    show(5, 5, 4);
    show(4, 9, 3);
    show(3, 6, 0);
    show(10, 20, 3);
    // the largest
    show(100, 100, 0);
    show(100, 100, 99);
    show(50, 100, 10);
    show(99, 100, 0);
    show(1, 100, 0);
    // every n, goal and k with goal up to 30
    let mut count = 0;
    let mut sum = 0;
    let mut check = 0;
    for goal in 1..31 {
        for n in 1..goal + 1 {
            for k in 0..n {
                let r = num_music_playlists(n, goal, k);
                count += 1;
                sum += r;
                check = (check * 1000003 + r) % 1000000007;
            }
        }
    }
    println(f"every case with goal up to 30: {count} cases, answers summing to {sum}, checksum {check}");
    // 300 random cases up to LeetCode's limit of 100
    let mut seed = 920;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..300 {
        let goal = 1 + next_random(mut seed) % 100;
        let n = 1 + next_random(mut seed) % goal;
        let k = next_random(mut seed) % n;
        let r = num_music_playlists(n, goal, k);
        sum += r;
        check = (check * 1000003 + r) % 1000000007;
    }
    println(f"300 random cases: answers summing to {sum}, checksum {check}");
}
