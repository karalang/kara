// LeetCode #959: Regions Cut By Slashes -- triangles flooded.
//
// The four triangles of each cell, top, right, bottom and left, as the
// nodes of a graph walked with an explicit stack. Inside a cell, a blank
// joins all four, a slash `/` the top with the left and the right with the
// bottom, and a backslash the top with the right and the bottom with the
// left; across cells, a top touches the bottom above it, a left the right
// beside it, and so on. Each walk from an unseen triangle is one region.
// O(n^2).

fn regions_by_slashes(grid: Vec[String]) -> i64 {
    let n = grid.len();
    let mut chars: Vec[u8] = Vec.new();
    for r in 0..n {
        let row = grid[r].bytes();
        for c in 0..n {
            chars.push(row[c]);
        }
    }
    let mut seen: Vec[bool] = Vec.filled(4 * n * n, false);
    let mut regions = 0;
    let mut stack: Vec[i64] = Vec.new();
    for start in 0..4 * n * n {
        if seen[start] {
            continue;
        }
        regions += 1;
        seen[start] = true;
        stack.push(start);
        while let Some(t) = stack.pop() {
            let cell = t / 4;
            let k = t % 4;
            let (r, c) = (cell / n, cell % n);
            let mut next: Vec[i64] = Vec.new();
            // inside the cell
            let ch = chars[cell];
            if ch == b' ' {
                for j in 0..4 {
                    next.push(4 * cell + j);
                }
            } else if ch == b'/' {
                next.push(4 * cell + 3 - k);
            } else {
                next.push(4 * cell + (5 - k) % 4);
            }
            // across to the neighbouring cell
            if k == 0 and r > 0 {
                next.push(4 * (cell - n) + 2);
            } else if k == 1 and c + 1 < n {
                next.push(4 * (cell + 1) + 3);
            } else if k == 2 and r + 1 < n {
                next.push(4 * (cell + n));
            } else if k == 3 and c > 0 {
                next.push(4 * (cell - 1) + 1);
            }
            for u in next.iter() {
                if not seen[*u] {
                    seen[*u] = true;
                    stack.push(*u);
                }
            }
        }
    }
    regions
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// An n by n grid, each cell blank with chance blank in 10, otherwise a
// slash or a backslash with even chances.
fn random_grid(n: i64, blank: i64, seed: mut ref i64) -> Vec[String] {
    let mut grid: Vec[String] = Vec.new();
    for _ in 0..n {
        let mut row = String.new();
        for _ in 0..n {
            if next_random(mut seed) % 10 < blank {
                row.push_str(" ");
            } else if next_random(mut seed) % 2 == 0 {
                row.push_str("/");
            } else {
                row.push_str("\\");
            }
        }
        grid.push(row);
    }
    grid
}

// An n by n grid from a pattern of k by k cells repeated.
fn tiled(n: i64, pattern: ref Vec[String]) -> Vec[String] {
    let k = pattern.len();
    let mut grid: Vec[String] = Vec.new();
    for r in 0..n {
        let mut row = String.new();
        for c in 0..n {
            row.push_str(pattern[r % k].substring(c % k, c % k + 1));
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[Vec[String]] = vec![
        vec![" /", "/ "],
        vec![" /", "  "],
        vec!["/\\", "\\/"],
        vec![" "],
        vec!["/"],
        vec!["\\"],
        vec!["\\/", "/\\"],
        vec!["//", "//"],
        vec![" /\\ ", "/  \\", "\\  /", " \\/ "],
        vec!["/\\/", "\\/\\", "/\\/"],
    ];
    for i in 0..cases.len() {
        println(f"case {i + 1}: {regions_by_slashes(cases[i])}");
    }
    // 300 random grids of 1 to 10 cells a side
    let mut seed = 959;
    let mut cells = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 10;
        let blank = next_random(mut seed) % 10;
        let r = regions_by_slashes(random_grid(n, blank, mut seed));
        cells += n * n;
        total += r;
        check = (check * 31 + r) % 1000000007;
    }
    println(f"300 random grids of {cells} cells, regions: {total}, checksum {check}");
    // LeetCode's largest grids, 30 by 30
    for blank in [0, 3, 6, 9] {
        let r = regions_by_slashes(random_grid(30, blank, mut seed));
        println(f"30 by 30, blank {blank} in 10, regions: {r}");
    }
    let patterns: Vec[Vec[String]] = vec![vec!["/"], vec!["\\"], vec!["/\\", "\\/"], vec!["\\/", "/\\"], vec![" "]];
    for p in patterns.iter() {
        println(f"30 by 30 of {p}, regions: {regions_by_slashes(tiled(30, p))}");
    }
}
