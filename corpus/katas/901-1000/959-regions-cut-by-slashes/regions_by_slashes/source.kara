// LeetCode #959: Regions Cut By Slashes -- four triangles per cell.
//
// Cut every cell along both diagonals into four triangles, top, right,
// bottom and left, and join them with a union-find: a blank cell joins
// all four, a slash `/` the top with the left and the right with the
// bottom, a backslash the top with the right and the bottom with the
// left. Each cell's right triangle also joins the left one of the cell to
// its right, and its bottom the top of the cell below. The regions are
// the sets left. O(n^2 a(n^2)).

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut r = x;
    while parent[r] != r {
        r = parent[r];
    }
    let mut c = x;
    while parent[c] != r {
        let next = parent[c];
        parent[c] = r;
        c = next;
    }
    r
}

fn union(parent: mut ref Vec[i64], sets: mut ref i64, a: i64, b: i64) {
    let ra = find(mut parent, a);
    let rb = find(mut parent, b);
    if ra != rb {
        parent[ra] = rb;
        *sets -= 1;
    }
}

fn regions_by_slashes(grid: Vec[String]) -> i64 {
    let n = grid.len();
    let mut parent: Vec[i64] = Vec.new();
    for i in 0..4 * n * n {
        parent.push(i);
    }
    let mut sets = 4 * n * n;
    for r in 0..n {
        let row = grid[r].bytes();
        for c in 0..n {
            // triangles 0 top, 1 right, 2 bottom, 3 left
            let t = 4 * (r * n + c);
            let ch = row[c];
            if ch == b' ' {
                union(mut parent, mut sets, t, t + 1);
                union(mut parent, mut sets, t + 1, t + 2);
                union(mut parent, mut sets, t + 2, t + 3);
            } else if ch == b'/' {
                union(mut parent, mut sets, t, t + 3);
                union(mut parent, mut sets, t + 1, t + 2);
            } else {
                union(mut parent, mut sets, t, t + 1);
                union(mut parent, mut sets, t + 2, t + 3);
            }
            if c + 1 < n {
                union(mut parent, mut sets, t + 1, t + 4 + 3);
            }
            if r + 1 < n {
                union(mut parent, mut sets, t + 2, t + 4 * n);
            }
        }
    }
    sets
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// An n by n grid, each cell blank with chance blank in 10, otherwise a
// slash or a backslash with even chances.
fn random_grid(n: i64, blank: i64, seed: mut ref i64) -> Vec[String] {
    let mut grid: Vec[String] = Vec.new();
    for _ in 0..n {
        let mut row = String.new();
        for _ in 0..n {
            if next_random(mut seed) % 10 < blank {
                row.push_str(" ");
            } else if next_random(mut seed) % 2 == 0 {
                row.push_str("/");
            } else {
                row.push_str("\\");
            }
        }
        grid.push(row);
    }
    grid
}

// An n by n grid from a pattern of k by k cells repeated.
fn tiled(n: i64, pattern: ref Vec[String]) -> Vec[String] {
    let k = pattern.len();
    let mut grid: Vec[String] = Vec.new();
    for r in 0..n {
        let mut row = String.new();
        for c in 0..n {
            row.push_str(pattern[r % k].substring(c % k, c % k + 1));
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[Vec[String]] = vec![
        vec![" /", "/ "],
        vec![" /", "  "],
        vec!["/\\", "\\/"],
        vec![" "],
        vec!["/"],
        vec!["\\"],
        vec!["\\/", "/\\"],
        vec!["//", "//"],
        vec![" /\\ ", "/  \\", "\\  /", " \\/ "],
        vec!["/\\/", "\\/\\", "/\\/"],
    ];
    for i in 0..cases.len() {
        println(f"case {i + 1}: {regions_by_slashes(cases[i])}");
    }
    // 300 random grids of 1 to 10 cells a side
    let mut seed = 959;
    let mut cells = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 10;
        let blank = next_random(mut seed) % 10;
        let r = regions_by_slashes(random_grid(n, blank, mut seed));
        cells += n * n;
        total += r;
        check = (check * 31 + r) % 1000000007;
    }
    println(f"300 random grids of {cells} cells, regions: {total}, checksum {check}");
    // LeetCode's largest grids, 30 by 30
    for blank in [0, 3, 6, 9] {
        let r = regions_by_slashes(random_grid(30, blank, mut seed));
        println(f"30 by 30, blank {blank} in 10, regions: {r}");
    }
    let patterns: Vec[Vec[String]] = vec![vec!["/"], vec!["\\"], vec!["/\\", "\\/"], vec!["\\/", "/\\"], vec![" "]];
    for p in patterns.iter() {
        println(f"30 by 30 of {p}, regions: {regions_by_slashes(tiled(30, p))}");
    }
}
