// LeetCode #942: DI String Match -- differential test of the five arms
// against the statement read literally, with six properties.
//
// The statement: a permutation perm of n + 1 integers of all the integers
// in the range [0, n] can be represented as a string s of length n where
// s[i] == 'I' if perm[i] < perm[i + 1], and s[i] == 'D' if
// perm[i] > perm[i + 1]. Given a string s, reconstruct the permutation
// perm and return it. If there are multiple valid permutations perm,
// return any of them.

// ---- the ★ arm: the smallest and largest left -----------------------------
fn star_di_string_match(s: String) -> Vec[i64] {
    let b = s.bytes().to_vec();
    let n = b.len();
    let mut lo = 0;
    let mut hi = n;
    let mut perm: Vec[i64] = Vec.new();
    for c in b.iter() {
        if *c == b'I' {
            perm.push(lo);
            lo += 1;
        } else {
            perm.push(hi);
            hi -= 1;
        }
    }
    perm.push(lo);
    perm
}

// ---- the runs arm: runs of D reversed -------------------------------------
fn runs_di_string_match(s: String) -> Vec[i64] {
    let b = s.bytes().to_vec();
    let n = b.len();
    let mut perm: Vec[i64] = Vec.new();
    for v in 0..(n + 1) {
        perm.push(v);
    }
    let mut i = 0;
    while i < n {
        if b[i] == b'D' {
            let mut j = i;
            while j < n and b[j] == b'D' {
                j += 1;
            }
            // reverse perm[i..=j]
            let mut a = i;
            let mut z = j;
            while a < z {
                perm.swap(a, z);
                a += 1;
                z -= 1;
            }
            i = j;
        } else {
            i += 1;
        }
    }
    perm
}

// ---- the stack arm: a stack of places -------------------------------------
fn stack_di_string_match(s: String) -> Vec[i64] {
    let b = s.bytes().to_vec();
    let n = b.len();
    let mut perm: Vec[i64] = Vec.new();
    for _ in 0..(n + 1) {
        perm.push(0);
    }
    let mut stack: Vec[i64] = Vec.new();
    let mut next = 0;
    for i in 0..(n + 1) {
        stack.push(i);
        if i == n or b[i] == b'I' {
            while let Some(p) = stack.pop() {
                perm[p] = next;
                next += 1;
            }
        }
    }
    perm
}

// ---- the spread arm: out from the first number ----------------------------
fn spread_di_string_match(s: String) -> Vec[i64] {
    let b = s.bytes().to_vec();
    let mut downs = 0;
    for c in b.iter() {
        if *c == b'D' {
            downs += 1;
        }
    }
    let mut perm: Vec[i64] = vec![downs];
    let mut top = downs;
    let mut bottom = downs;
    for c in b.iter() {
        if *c == b'I' {
            top += 1;
            perm.push(top);
        } else {
            bottom -= 1;
            perm.push(bottom);
        }
    }
    perm
}

// ---- the topo arm: an order of the places ---------------------------------
fn topo_di_string_match(s: String) -> Vec[i64] {
    let b = s.bytes().to_vec();
    let n = b.len();
    // into[p]: edges into place p not yet taken away
    let mut into: Vec[i64] = Vec.new();
    for _ in 0..(n + 1) {
        into.push(0);
    }
    for i in 0..n {
        if b[i] == b'I' {
            into[i + 1] += 1;
        } else {
            into[i] += 1;
        }
    }
    let mut queue: VecDeque[i64] = VecDeque.new();
    for p in 0..(n + 1) {
        if into[p] == 0 {
            queue.push_back(p);
        }
    }
    let mut perm: Vec[i64] = Vec.new();
    for _ in 0..(n + 1) {
        perm.push(0);
    }
    let mut next = 0;
    while let Some(p) = queue.pop_front() {
        perm[p] = next;
        next += 1;
        // the edges out of p go to a neighbour that must be larger
        if p > 0 and b[p - 1] == b'D' {
            into[p - 1] -= 1;
            if into[p - 1] == 0 {
                queue.push_back(p - 1);
            }
        }
        if p < n and b[p] == b'I' {
            into[p + 1] -= 1;
            if into[p + 1] == 0 {
                queue.push_back(p + 1);
            }
        }
    }
    perm
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, s: String) -> Vec[i64] {
    if x == 0 {
        star_di_string_match(s)
    } else if x == 1 {
        runs_di_string_match(s)
    } else if x == 2 {
        stack_di_string_match(s)
    } else if x == 3 {
        spread_di_string_match(s)
    } else {
        topo_di_string_match(s)
    }
}

// Whether perm holds each of 0 to n once.
fn is_permutation(perm: ref Vec[i64], n: i64) -> bool {
    if perm.len() != n + 1 {
        return false;
    }
    let mut seen: Vec[bool] = Vec.new();
    for _ in 0..(n + 1) {
        seen.push(false);
    }
    for v in perm.iter() {
        if *v < 0 or *v > n or seen[*v] {
            return false;
        }
        seen[*v] = true;
    }
    true
}

// Whether perm rises at each I and falls at each D.
fn follows(s: ref String, perm: ref Vec[i64]) -> bool {
    let b = s.bytes().to_vec();
    if perm.len() != b.len() + 1 {
        return false;
    }
    for i in 0..b.len() {
        if b[i] == b'I' and not (perm[i] < perm[i + 1]) {
            return false;
        }
        if b[i] == b'D' and not (perm[i] > perm[i + 1]) {
            return false;
        }
    }
    true
}

fn fits(s: ref String, perm: ref Vec[i64]) -> bool {
    is_permutation(perm, s.len()) and follows(s, perm)
}

// The statement read literally: every permutation of 0 to n, kept when
// s[i] == 'I' exactly where perm[i] < perm[i + 1].
fn all_perms(b: ref Vec[u8], perm: mut ref Vec[i64], used: mut ref Vec[bool], out: mut ref Vec[Vec[i64]]) {
    let n = b.len();
    if perm.len() == n + 1 {
        let mut ok = true;
        for i in 0..n {
            if (b[i] == b'I') != (perm[i] < perm[i + 1]) {
                ok = false;
            }
        }
        if ok {
            out.push(perm.clone());
        }
        return;
    }
    for v in 0..(n + 1) {
        if not used[v] {
            used[v] = true;
            perm.push(v);
            all_perms(b, mut perm, mut used, mut out);
            perm.pop();
            used[v] = false;
        }
    }
}

fn literal(s: ref String) -> Vec[Vec[i64]] {
    let b = s.bytes().to_vec();
    let mut perm: Vec[i64] = Vec.new();
    let mut used: Vec[bool] = Vec.new();
    for _ in 0..(b.len() + 1) {
        used.push(false);
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    all_perms(b, mut perm, mut used, mut out);
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_letters(seed: mut ref i64, n: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 2 == 0 { 'I' } else { 'D' });
    }
    s
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, s: String, small: bool) -> i64 {
    let truth = if small { literal(s) } else { Vec.new() };
    let mut got: Vec[Vec[i64]] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, s));
    }
    // the inputs P4 and P5 share
    let b = s.bytes().to_vec();
    let n = b.len();
    let mut swapped = String.new();
    let mut reversed = String.new();
    for i in 0..n {
        swapped.push(if b[i] == b'I' { 'D' } else { 'I' });
        reversed.push(b[n - 1 - i] as char);
    }
    let longer = s + random_letters(mut seed, 1);
    for x in 0..5 {
        let a = got[x].clone();
        // P1: one of the statement's permutations, on the small strings
        if small {
            let mut found = false;
            for p in truth.iter() {
                if *p == a {
                    found = true;
                }
            }
            check(mut t, 1, found);
        }
        // P2: each of 0 to n once
        check(mut t, 2, is_permutation(a, n));
        // P3: a rise at each I and a fall at each D
        check(mut t, 3, follows(s, a));
        // P4: the letters swapped, an answer that fits them
        check(mut t, 4, fits(swapped, arm(x, swapped)));
        // P5: the letters reversed, and one more letter at the end,
        // answers that fit
        check(mut t, 5, fits(reversed, arm(x, reversed)) and fits(longer, arm(x, longer)));
        // P6: agreement with at least two of the other four that it fits
        let mut agree = 0;
        let mine = fits(s, a);
        for y in 0..5 {
            if y != x and fits(s, got[y]) == mine {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    got[0][0]
}

fn main() {
    let mut t = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 942;
    let mut strings = 0;
    let mut letters = 0;
    let mut check_sum = 0;
    // strings of up to 5 letters against the statement, then up to 2000
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 5 } else { 1 + next_random(mut seed) % 2000 };
        let s = random_letters(mut seed, n);
        strings += 1;
        letters += n;
        let first = properties(mut t, mut seed, s, small);
        check_sum = (check_sum * 1000003 + first) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{strings} strings of {letters} letters, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
