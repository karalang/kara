// LeetCode #942: DI String Match -- runs of D reversed.
//
// Start from 0, 1, ..., n, which fits a string of all I. Each run of D's
// from place i to place j - 1 asks the numbers from place i to place j to
// fall instead, so reverse that stretch; the stretches of different runs
// do not overlap, and the steps into and out of each still rise. This
// gives the smallest answer in dictionary order. O(n) time.

fn di_string_match(s: String) -> Vec[i64] {
    let b = s.bytes().to_vec();
    let n = b.len();
    let mut perm: Vec[i64] = Vec.new();
    for v in 0..(n + 1) {
        perm.push(v);
    }
    let mut i = 0;
    while i < n {
        if b[i] == b'D' {
            let mut j = i;
            while j < n and b[j] == b'D' {
                j += 1;
            }
            // reverse perm[i..=j]
            let mut a = i;
            let mut z = j;
            while a < z {
                perm.swap(a, z);
                a += 1;
                z -= 1;
            }
            i = j;
        } else {
            i += 1;
        }
    }
    perm
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_letters(seed: mut ref i64, n: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 2 == 0 { 'I' } else { 'D' });
    }
    s
}

// Whether perm holds each of 0 to n once and rises at each I and falls
// at each D.
fn fits(s: ref String, perm: ref Vec[i64]) -> bool {
    let b = s.bytes().to_vec();
    let n = b.len();
    if perm.len() != n + 1 {
        return false;
    }
    let mut seen: Vec[bool] = Vec.new();
    for _ in 0..(n + 1) {
        seen.push(false);
    }
    for v in perm.iter() {
        if *v < 0 or *v > n or seen[*v] {
            return false;
        }
        seen[*v] = true;
    }
    for i in 0..n {
        if (b[i] == b'I') != (perm[i] < perm[i + 1]) {
            return false;
        }
    }
    true
}

fn verdict(s: ref String) -> String {
    let n = s.len();
    if fits(s, di_string_match(s)) { f"a permutation of 0 to {n} that fits" } else { "WRONG" }
}

fn main() {
    // LeetCode's three examples, then a few more
    for s in ["IDID", "III", "DDI", "I", "D", "DIDI", "IIDD", "DDDIII"] {
        println(f"\"{s}\": {verdict(s.to_string())}");
    }
    // 300 random strings of 1 to 100 letters
    let mut seed = 942;
    let mut letters = 0;
    let mut good = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 100;
        let s = random_letters(mut seed, n);
        if fits(s, di_string_match(s)) {
            good += 1;
        }
        letters += n;
    }
    println(f"300 random strings of {letters} letters: {good} answers fit");
    // LeetCode's longest: 10^5 letters
    println(f"100000 I: {verdict("I".repeat(100000))}");
    println(f"100000 D: {verdict("D".repeat(100000))}");
    println(f"ID 50000 times: {verdict("ID".repeat(50000))}");
    println(f"100000 random letters: {verdict(random_letters(mut seed, 100000))}");
}
