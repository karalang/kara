// LeetCode #994: Rotting Oranges -- differential.
//
// The five arms against the statement read literally and against each
// other, on random grids.

// ---- star ----

fn star_oranges_rotting(grid: ref Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut g = grid.clone();
    let mut queue: VecDeque[(i64, i64, i64)] = VecDeque.new();
    let mut fresh = 0;
    for r in 0..m {
        for c in 0..n {
            if g[r][c] == 2 {
                queue.push_back((r, c, 0));
            } else if g[r][c] == 1 {
                fresh += 1;
            }
        }
    }
    let steps = [(1, 0), (-1, 0), (0, 1), (0, -1)];
    let mut minutes = 0;
    while let Some((r, c, t)) = queue.pop_front() {
        minutes = t;
        for (dr, dc) in steps.iter() {
            let nr = r + dr;
            let nc = c + dc;
            if nr >= 0 and nr < m and nc >= 0 and nc < n and g[nr][nc] == 1 {
                g[nr][nc] = 2;
                fresh -= 1;
                queue.push_back((nr, nc, t + 1));
            }
        }
    }
    if fresh > 0 { -1 } else { minutes }
}

// ---- levels ----

fn levels_oranges_rotting(grid: ref Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut g = grid.clone();
    let mut frontier: Vec[(i64, i64)] = Vec.new();
    let mut fresh = 0;
    for r in 0..m {
        for c in 0..n {
            if g[r][c] == 2 {
                frontier.push((r, c));
            } else if g[r][c] == 1 {
                fresh += 1;
            }
        }
    }
    let mut minutes = 0;
    while fresh > 0 {
        let mut next: Vec[(i64, i64)] = Vec.new();
        for (r, c) in frontier.iter() {
            for (nr, nc) in vec![(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)] {
                if nr >= 0 and nr < m and nc >= 0 and nc < n and g[nr][nc] == 1 {
                    g[nr][nc] = 2;
                    fresh -= 1;
                    next.push((nr, nc));
                }
            }
        }
        if next.len() == 0 {
            return -1;
        }
        minutes += 1;
        frontier = next;
    }
    minutes
}

// ---- scan ----

// Whether the cell at (r, c) has a neighbour that had rotted by the
// given minute: a cell that rots at minute k holds k + 2.
fn scan_rotted_next_to(g: ref Vec[Vec[i64]], r: i64, c: i64, minute: i64) -> bool {
    let m = g.len();
    let n = g[0].len();
    for (nr, nc) in vec![(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)] {
        if nr >= 0 and nr < m and nc >= 0 and nc < n and g[nr][nc] >= 2 and g[nr][nc] <= minute + 2 {
            return true;
        }
    }
    false
}

fn scan_oranges_rotting(grid: ref Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut g = grid.clone();
    let mut minute = 0;
    loop {
        let mut changed = false;
        for r in 0..m {
            for c in 0..n {
                if g[r][c] == 1 and scan_rotted_next_to(g, r, c, minute) {
                    g[r][c] = minute + 3;
                    changed = true;
                }
            }
        }
        if not changed {
            break;
        }
        minute += 1;
    }
    for r in 0..m {
        for c in 0..n {
            if g[r][c] == 1 {
                return -1;
            }
        }
    }
    minute
}

// ---- relax ----

fn relax_oranges_rotting(grid: ref Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    // minutes until each cell rots, as far as known; never for an empty cell
    let never = 1000000;
    let mut dist: Vec[Vec[i64]] = Vec.new();
    for r in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for c in 0..n {
            row.push(if grid[r][c] == 2 { 0 } else { never });
        }
        dist.push(row);
    }
    let mut changed = true;
    while changed {
        changed = false;
        for r in 0..m {
            for c in 0..n {
                if grid[r][c] == 1 {
                    for (nr, nc) in vec![(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)] {
                        if nr >= 0 and nr < m and nc >= 0 and nc < n and dist[nr][nc] + 1 < dist[r][c] {
                            dist[r][c] = dist[nr][nc] + 1;
                            changed = true;
                        }
                    }
                }
            }
        }
    }
    let mut most = 0;
    for r in 0..m {
        for c in 0..n {
            if grid[r][c] == 1 {
                if dist[r][c] == never {
                    return -1;
                }
                if dist[r][c] > most {
                    most = dist[r][c];
                }
            }
        }
    }
    most
}

// ---- dfs ----

// Rot the cell at (r, c) at the stamp t, a cell rotting at minute k
// holding k + 2, unless it is empty or already rots by then; then carry
// the rot on to its neighbours a minute later.
fn dfs_spread(g: mut ref Vec[Vec[i64]], r: i64, c: i64, t: i64) {
    if r < 0 or r >= g.len() or c < 0 or c >= g[0].len() {
        return;
    }
    let v = g[r][c];
    if v == 0 or (v > 1 and v <= t) {
        return;
    }
    g[r][c] = t;
    dfs_spread(mut g, r + 1, c, t + 1);
    dfs_spread(mut g, r - 1, c, t + 1);
    dfs_spread(mut g, r, c + 1, t + 1);
    dfs_spread(mut g, r, c - 1, t + 1);
}

fn dfs_oranges_rotting(grid: ref Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut g = grid.clone();
    for r in 0..m {
        for c in 0..n {
            if grid[r][c] == 2 {
                dfs_spread(mut g, r + 1, c, 3);
                dfs_spread(mut g, r - 1, c, 3);
                dfs_spread(mut g, r, c + 1, 3);
                dfs_spread(mut g, r, c - 1, 3);
            }
        }
    }
    let mut most = 2;
    for r in 0..m {
        for c in 0..n {
            if g[r][c] == 1 {
                return -1;
            }
            if g[r][c] > most {
                most = g[r][c];
            }
        }
    }
    most - 2
}

// ---- checks ----

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// m by n cells, each up to most: empty `empty` in 16, rotten `rotten`
// in 16, fresh the rest.
fn random_grid(most: i64, empty: i64, rotten: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let m = 1 + next_random(mut seed) % most;
    let n = 1 + next_random(mut seed) % most;
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            let k = next_random(mut seed) % 16;
            row.push(if k < empty { 0 } else if k < empty + rotten { 2 } else { 1 });
        }
        grid.push(row);
    }
    grid
}

fn arm(k: i64, grid: ref Vec[Vec[i64]]) -> i64 {
    if k == 0 {
        star_oranges_rotting(grid)
    } else if k == 1 {
        levels_oranges_rotting(grid)
    } else if k == 2 {
        scan_oranges_rotting(grid)
    } else if k == 3 {
        relax_oranges_rotting(grid)
    } else {
        dfs_oranges_rotting(grid)
    }
}

fn inside(g: ref Vec[Vec[i64]], r: i64, c: i64) -> bool {
    r >= 0 and r < g.len() and c >= 0 and c < g[0].len()
}

// The statement read literally: minute after minute, every fresh orange
// next to an orange that was rotten when the minute began turns rotten;
// when a minute changes nothing, the answer is the minutes gone by, or
// -1 if a fresh orange is left.
fn literal(grid: ref Vec[Vec[i64]]) -> i64 {
    let mut g = grid.clone();
    let mut minutes = 0;
    loop {
        let mut after = g.clone();
        let mut changed = false;
        for r in 0..g.len() {
            for c in 0..g[0].len() {
                if g[r][c] == 1 {
                    let near = (inside(g, r - 1, c) and g[r - 1][c] == 2) or (inside(g, r + 1, c) and g[r + 1][c] == 2)
                        or (inside(g, r, c - 1) and g[r][c - 1] == 2) or (inside(g, r, c + 1) and g[r][c + 1] == 2);
                    if near {
                        after[r][c] = 2;
                        changed = true;
                    }
                }
            }
        }
        if not changed {
            break;
        }
        g = after;
        minutes += 1;
    }
    for row in g.iter() {
        for v in row.iter() {
            if *v == 1 {
                return -1;
            }
        }
    }
    minutes
}

fn transposed(g: ref Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    for c in 0..g[0].len() {
        let mut row: Vec[i64] = Vec.new();
        for r in 0..g.len() {
            row.push(g[r][c]);
        }
        out.push(row);
    }
    out
}

fn upside_down(g: ref Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut r = g.len() - 1;
    while r >= 0 {
        out.push(g[r].clone());
        r -= 1;
    }
    out
}

// Whether every fresh orange is joined to a rotten one by a path of
// oranges, by a flood fill from the rotten ones.
fn all_reached(g: ref Vec[Vec[i64]]) -> bool {
    let m = g.len();
    let n = g[0].len();
    let mut seen: Vec[Vec[bool]] = Vec.new();
    let mut stack: Vec[(i64, i64)] = Vec.new();
    for r in 0..m {
        let mut row: Vec[bool] = Vec.new();
        for c in 0..n {
            row.push(g[r][c] == 2);
            if g[r][c] == 2 {
                stack.push((r, c));
            }
        }
        seen.push(row);
    }
    while let Some((r, c)) = stack.pop() {
        for (nr, nc) in vec![(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)] {
            if inside(g, nr, nc) and g[nr][nc] != 0 and not seen[nr][nc] {
                seen[nr][nc] = true;
                stack.push((nr, nc));
            }
        }
    }
    for r in 0..m {
        for c in 0..n {
            if g[r][c] == 1 and not seen[r][c] {
                return false;
            }
        }
    }
    true
}

// -1, never, as the highest
fn rank(minutes: i64) -> i64 {
    if minutes < 0 { 1000000 } else { minutes }
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(tally: mut ref Tally, grid: ref Vec[Vec[i64]], small: bool, seed: mut ref i64) -> i64 {
    let truth = if small { literal(grid) } else { 0 };
    let mut got: Vec[i64] = Vec.new();
    for k in 0..5 {
        got.push(arm(k, grid));
    }
    let across = transposed(grid);
    let flipped = upside_down(grid);
    // one cell that is not rotten made rotten, if there is one
    let mut rotted = grid.clone();
    let r = next_random(mut seed) % grid.len();
    let c = next_random(mut seed) % grid[0].len();
    rotted[r][c] = 2;
    let mut fresh = 0;
    for row in grid.iter() {
        for v in row.iter() {
            if *v == 1 {
                fresh += 1;
            }
        }
    }
    let reached = all_reached(grid);
    for k in 0..5 {
        let g = got[k];
        // P1: the statement's answer, on the first 3000 grids
        if small {
            check(mut tally, 1, g == truth);
        }
        // P2: the grid transposed gives the same answer
        check(mut tally, 2, arm(k, across) == g);
        // P3: the grid upside down gives the same answer
        check(mut tally, 3, arm(k, flipped) == g);
        // P4: one more rotten orange cannot make it take longer
        check(mut tally, 4, rank(arm(k, rotted)) <= rank(g));
        // P5: -1 exactly when a fresh orange has no path of oranges to a
        // rotten one; otherwise at most the fresh oranges, and 0 exactly
        // when there are none
        let bounds = if reached { g >= 0 and g <= fresh and (g == 0) == (fresh == 0) } else { g == -1 };
        check(mut tally, 5, bounds);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for j in 0..5 {
            if j != k and got[j] == g {
                agree += 1;
            }
        }
        check(mut tally, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut tally = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 994;
    let mut cells = 0;
    let mut stuck = 0;
    let mut total = 0;
    let mut check_sum = 0;
    // 3000 grids of up to 5 by 5, 2 cells in 16 rotten, against the
    // statement, then 200 of up to 10 by 10, 1 in 16 rotten and 2 and 5
    // in 16 empty in turn
    for i in 0..3200 {
        let small = i < 3000;
        let grid = if small { random_grid(5, 2, 2, mut seed) } else { random_grid(10, if i % 2 == 0 { 2 } else { 5 }, 1, mut seed) };
        cells += grid.len() * grid[0].len();
        let got = properties(mut tally, grid, small, mut seed);
        if got < 0 {
            stuck += 1;
        } else {
            total += got;
        }
        check_sum = (check_sum * 31 + got + 2) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += tally.failures[p];
        if tally.failures[p] > 0 {
            by = by + f" P{p + 1} {tally.failures[p]}";
        }
    }
    println(f"3200 grids of {cells} cells: {stuck} never rot, {total} minutes, checksum {check_sum}, {tally.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
