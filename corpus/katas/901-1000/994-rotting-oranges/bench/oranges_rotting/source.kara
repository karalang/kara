// Benchmark: LeetCode #994 Rotting Oranges -- the ★ arm, a
// breadth-first search from every rotten orange at once, on random grids
// of 10 by 10, LeetCode's largest. Mirrors oranges_rotting.c, .rs, .py
// and go-seq/.

fn oranges_rotting(grid: ref Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut g = grid.clone();
    let mut queue: VecDeque[(i64, i64, i64)] = VecDeque.new();
    let mut fresh = 0;
    for r in 0..m {
        for c in 0..n {
            if g[r][c] == 2 {
                queue.push_back((r, c, 0));
            } else if g[r][c] == 1 {
                fresh += 1;
            }
        }
    }
    let steps = [(1, 0), (-1, 0), (0, 1), (0, -1)];
    let mut minutes = 0;
    while let Some((r, c, t)) = queue.pop_front() {
        minutes = t;
        for (dr, dc) in steps.iter() {
            let nr = r + *dr;
            let nc = c + *dc;
            if nr >= 0 and nr < m and nc >= 0 and nc < n and g[nr][nc] == 1 {
                g[nr][nc] = 2;
                fresh -= 1;
                queue.push_back((nr, nc, t + 1));
            }
        }
    }
    if fresh > 0 { -1 } else { minutes }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..10 {
            let k = next_random(mut seed) % 32;
            row.push(if k < 3 { 0 } else if k == 3 { 2 } else { 1 });
        }
        grid.push(row);
    }
    grid
}

fn main() {
    let rounds = 20000;
    let mut seed = 994;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..20 {
        grids.push(random_grid(mut seed));
    }
    let mut stuck = 0;
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..20 {
            let got = oranges_rotting(grids[(r + i) % 20]);
            if got < 0 {
                stuck += 1;
            } else {
                total += got;
            }
            check = (check * 31 + got + 2) % 1000000007;
        }
    }
    println(f"{rounds} rounds over 20 grids of 10 by 10: {stuck} never rot, {total} minutes, checksum {check}");
}
