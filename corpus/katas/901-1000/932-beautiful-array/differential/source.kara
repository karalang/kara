// LeetCode #932: Beautiful Array -- differential test of the five arms
// against the statement read literally, with six properties.
//
// The statement: an array nums of length n is beautiful if it is a
// permutation of the integers in the range [1, n] and for every
// 0 <= i < j < n, there is no index k with i < k < j where
// 2 * nums[k] == nums[i] + nums[j]. Given the integer n, return any
// beautiful array nums of length n.

// ---- the ★ arm: divide and conquer with a memo ----------------------------
fn star_build(n: i64, memo: mut ref Map[i64, Vec[i64]]) -> Vec[i64] {
    if let Some(done) = memo.get(n) {
        return done.clone();
    }
    let mut out: Vec[i64] = Vec.new();
    if n == 1 {
        out.push(1);
    } else {
        for x in star_build((n + 1) / 2, mut memo).iter() {
            out.push(2 * *x - 1);
        }
        for x in star_build(n / 2, mut memo).iter() {
            out.push(2 * *x);
        }
    }
    memo.insert(n, out.clone());
    out
}

fn star_beautiful_array(n: i64) -> Vec[i64] {
    let mut memo: Map[i64, Vec[i64]] = Map.new();
    star_build(n, mut memo)
}

// ---- the doubling arm: doubling from [1] ----------------------------------
fn doubling_beautiful_array(n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = vec![1];
    while nums.len() < n {
        let mut next: Vec[i64] = Vec.new();
        for x in nums.iter() {
            if 2 * *x - 1 <= n {
                next.push(2 * *x - 1);
            }
        }
        for x in nums.iter() {
            if 2 * *x <= n {
                next.push(2 * *x);
            }
        }
        nums = next;
    }
    nums
}

// ---- the lowbit arm: sorted by the lowest differing bit -------------------
fn lowbit_beautiful_array(n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        nums.push(x);
    }
    nums.sort_by(|a, b| {
        let d = (a - 1) ^ (b - 1);
        if d == 0 {
            Ordering.Equal
        } else if (a - 1) & (d & -d) == 0 {
            Ordering.Less
        } else {
            Ordering.Greater
        }
    });
    nums
}

// ---- the partition arm: split on one bit at a time ------------------------
fn partition_arrange(items: Vec[i64], bit: i64) -> Vec[i64] {
    if items.len() <= 1 {
        return items.clone();
    }
    let mut zeros: Vec[i64] = Vec.new();
    let mut ones: Vec[i64] = Vec.new();
    for x in items.iter() {
        if ((*x - 1) >> bit) & 1 == 0 {
            zeros.push(*x);
        } else {
            ones.push(*x);
        }
    }
    let mut out = partition_arrange(zeros, bit + 1);
    for x in partition_arrange(ones, bit + 1).iter() {
        out.push(*x);
    }
    out
}

fn partition_beautiful_array(n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for x in 1..n + 1 {
        nums.push(x);
    }
    partition_arrange(nums, 0)
}

// ---- the reverse arm: counting in bit-reversed order ----------------------
fn reverse_reversed(i: i64, bits: i64) -> i64 {
    let mut r = 0;
    let mut v = i;
    for _ in 0..bits {
        r = (r << 1) | (v & 1);
        v = v >> 1;
    }
    r
}

fn reverse_beautiful_array(n: i64) -> Vec[i64] {
    let mut bits = 0;
    while (1 << bits) < n {
        bits += 1;
    }
    let mut nums: Vec[i64] = Vec.new();
    for i in 0..(1 << bits) {
        let y = reverse_reversed(i, bits);
        if y < n {
            nums.push(y + 1);
        }
    }
    nums
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, n: i64) -> Vec[i64] {
    if x == 0 {
        star_beautiful_array(n)
    } else if x == 1 {
        doubling_beautiful_array(n)
    } else if x == 2 {
        lowbit_beautiful_array(n)
    } else if x == 3 {
        partition_beautiful_array(n)
    } else {
        reverse_beautiful_array(n)
    }
}

// The statement read literally: a permutation of 1 to n, every value of
// 1 to n found in it exactly once, and for every i < j no k between them
// with 2 * nums[k] == nums[i] + nums[j].
fn literal(nums: Vec[i64], n: i64) -> bool {
    if nums.len() != n {
        return false;
    }
    for v in 1..n + 1 {
        let mut count = 0;
        for x in nums.iter() {
            if *x == v {
                count += 1;
            }
        }
        if count != 1 {
            return false;
        }
    }
    for i in 0..n {
        for j in i + 1..n {
            for k in i + 1..j {
                if 2 * nums[k] == nums[i] + nums[j] {
                    return false;
                }
            }
        }
    }
    true
}

// a permutation of 1 to n
fn permutation(nums: Vec[i64], n: i64) -> bool {
    if nums.len() != n {
        return false;
    }
    let mut seen: Vec[bool] = Vec.filled(n + 1, false);
    for x in nums.iter() {
        if *x < 1 or *x > n or seen[*x] {
            return false;
        }
        seen[*x] = true;
    }
    true
}

// no progression of three: for each pair i < k, the value that would
// complete nums[i], nums[k] as a progression is not after k (assumes a
// permutation)
fn no_progression(nums: Vec[i64], n: i64) -> bool {
    let mut pos: Vec[i64] = Vec.filled(n + 1, -1);
    for i in 0..nums.len() {
        let v = nums[i];
        if v >= 1 and v <= n {
            pos[v] = i;
        }
    }
    for k in 0..nums.len() {
        for i in 0..k {
            let v = 2 * nums[k] - nums[i];
            if v >= 1 and v <= n and pos[v] > k {
                return false;
            }
        }
    }
    true
}

fn same(a: Vec[i64], b: Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, n: i64, small: bool) {
    let mut got: Vec[Vec[i64]] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, n));
    }
    for x in 0..5 {
        let a = got[x].clone();
        // P1: the statement, on the small n
        if small {
            check(mut t, 1, literal(a.clone(), n));
        }
        // P2: a permutation of 1 to n
        check(mut t, 2, permutation(a.clone(), n));
        // P3: no progression of three, by position
        check(mut t, 3, no_progression(a.clone(), n));
        // P4: the odd values first, and (x + 1) / 2 over them and x / 2
        // over the even ones are this arm's arrays for (n + 1) / 2 and
        // n / 2
        let mut odd: Vec[i64] = Vec.new();
        let mut even: Vec[i64] = Vec.new();
        let mut ordered = true;
        for v in a.iter() {
            if *v % 2 == 1 {
                if even.len() > 0 {
                    ordered = false;
                }
                odd.push((*v + 1) / 2);
            } else {
                even.push(*v / 2);
            }
        }
        let halves = ordered and same(odd, arm(x, (n + 1) / 2)) and (n < 2 or same(even, arm(x, n / 2)));
        check(mut t, 4, halves);
        // P5: this arm's array for n + 1 with n + 1 taken out
        let mut shorter: Vec[i64] = Vec.new();
        for v in arm(x, n + 1).iter() {
            if *v != n + 1 {
                shorter.push(*v);
            }
        }
        check(mut t, 5, same(shorter, a.clone()));
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and same(got[y].clone(), a.clone()) {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut seed = 932;
    let mut cases = 0;
    let mut elements = 0;
    let mut check = 0;
    // n from 1 to 16 against the statement, then from 1 to 500
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 16 } else { 1 + next_random(mut seed) % 500 };
        cases += 1;
        elements += n;
        for v in arm(0, n).iter() {
            check = (check * 1000003 + *v) % 1000000007;
        }
        properties(mut t, n, small);
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{cases} arrays, {elements} elements, checksum {check}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
