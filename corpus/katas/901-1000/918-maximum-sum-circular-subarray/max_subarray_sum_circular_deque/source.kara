// LeetCode #918: Maximum Sum Circular Subarray -- prefix sums over the
// array twice, with a deque of smallest starts.
//
// Lay the array out twice. A circular subarray is a run of at most n
// values of that doubled array, and its sum is p[j] - p[i] for prefix
// sums with j - n <= i < j. Walk j forward keeping a deque of start
// indices whose prefix sums increase: drop starts that fall out of the
// window from the front, read the best start there, then push j after
// dropping every start at least as large from the back. O(n).

fn max_subarray_sum_circular(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut p: Vec[i64] = Vec.filled(2 * n + 1, 0);
    for k in 0..2 * n {
        p[k + 1] = p[k] + nums[k % n];
    }
    let mut starts: VecDeque[i64] = VecDeque.new();
    starts.push_back(0);
    let mut best = nums[0];
    for j in 1..2 * n + 1 {
        while j - *starts.front().unwrap() > n {
            starts.pop_front();
        }
        best = best.max(p[j] - p[*starts.front().unwrap()]);
        while not starts.is_empty() and p[*starts.back().unwrap()] >= p[j] {
            starts.pop_back();
        }
        starts.push_back(j);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    let mut s = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str(f"{nums[i]}");
    }
    println(f"[{s}]: {max_subarray_sum_circular(nums)}");
}

// `n` values from -30000 to 30000, leaning by `lean` (0 even, negative
// to more negative values, positive to more positive)
fn random_values(seed: mut ref i64, n: i64, lean: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        let v = (next_random(mut seed) * 2 + next_random(mut seed) % 2) % 60001 - 30000 + lean;
        nums.push(v.max(-30000).min(30000));
    }
    nums
}

fn main() {
    show(vec![1, -2, 3, -2]);
    show(vec![5, -3, 5]);
    show(vec![-3, -2, -3]);
    show(vec![3, -1, 2, -1]);
    show(vec![3, -2, 2, -3]);
    show(vec![-2, -3, -1]);
    show(vec![1]);
    show(vec![-5]);
    show(vec![0, 0, 0]);
    show(vec![2, -1, 2]);
    show(vec![-1, 5, -1, -1, 5, -1]);
    // random arrays of 1 to 1000 values
    let mut seed = 918;
    let mut total = 0;
    let mut check = 0;
    for c in 0..500 {
        let n = 1 + next_random(mut seed) % 1000;
        let lean = (c % 7 - 3) * 5000;
        let r = max_subarray_sum_circular(random_values(mut seed, n, lean));
        total += r;
        check = (check * 1000003 + r + 1000000000) % 1000000007;
    }
    println(f"500 arrays: answers summing to {total}, checksum {check}");
    // LeetCode's largest: 30000 values
    let low: Vec[i64] = Vec.filled(30000, -30000);
    println(f"30000 values of -30000: {max_subarray_sum_circular(low)}");
    let high: Vec[i64] = Vec.filled(30000, 30000);
    println(f"30000 values of 30000: {max_subarray_sum_circular(high)}");
    println(f"30000 random values: {max_subarray_sum_circular(random_values(mut seed, 30000, 0))}");
    // a valley in the middle, so the best wraps around
    let mut valley: Vec[i64] = Vec.new();
    for i in 0..30000 {
        valley.push(if i >= 10000 and i < 20000 { -30000 + i % 7 } else { 30000 - i % 11 });
    }
    println(f"30000 values with a valley: {max_subarray_sum_circular(valley)}");
}
