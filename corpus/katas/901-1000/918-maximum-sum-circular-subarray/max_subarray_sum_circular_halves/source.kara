// LeetCode #918: Maximum Sum Circular Subarray -- divide and conquer.
//
// Summarise a stretch of the array by its total and its largest and
// smallest sums over prefixes, suffixes and subarrays. Two neighbouring
// stretches combine in O(1): a subarray of the pair lies in one of them
// or is a suffix of the left joined to a prefix of the right. Split the
// array in halves down to single values. The answer is then the largest
// subarray, or the total less the smallest subarray when that leaves
// something. O(n) summaries, O(log n) deep.

struct Stretch {
    total: i64,
    max_prefix: i64,
    max_suffix: i64,
    max_sub: i64,
    min_prefix: i64,
    min_suffix: i64,
    min_sub: i64,
}

fn single(v: i64) -> Stretch {
    Stretch {
        total: v,
        max_prefix: v,
        max_suffix: v,
        max_sub: v,
        min_prefix: v,
        min_suffix: v,
        min_sub: v,
    }
}

fn join(a: Stretch, b: Stretch) -> Stretch {
    Stretch {
        total: a.total + b.total,
        max_prefix: a.max_prefix.max(a.total + b.max_prefix),
        max_suffix: b.max_suffix.max(b.total + a.max_suffix),
        max_sub: a.max_sub.max(b.max_sub).max(a.max_suffix + b.max_prefix),
        min_prefix: a.min_prefix.min(a.total + b.min_prefix),
        min_suffix: b.min_suffix.min(b.total + a.min_suffix),
        min_sub: a.min_sub.min(b.min_sub).min(a.min_suffix + b.min_prefix),
    }
}

fn summary(nums: Vec[i64], lo: i64, hi: i64) -> Stretch {
    if hi - lo == 1 {
        return single(nums[lo]);
    }
    let mid = lo + (hi - lo) / 2;
    join(summary(nums, lo, mid), summary(nums, mid, hi))
}

fn max_subarray_sum_circular(nums: Vec[i64]) -> i64 {
    let s = summary(nums, 0, nums.len());
    if s.min_sub == s.total {
        // leaving out the smallest subarray leaves at best 0, and if
        // anything is left at all it holds a value of at least 0, which
        // max_sub has already counted
        s.max_sub
    } else {
        s.max_sub.max(s.total - s.min_sub)
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    let mut s = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str(f"{nums[i]}");
    }
    println(f"[{s}]: {max_subarray_sum_circular(nums)}");
}

// `n` values from -30000 to 30000, leaning by `lean` (0 even, negative
// to more negative values, positive to more positive)
fn random_values(seed: mut ref i64, n: i64, lean: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        let v = (next_random(mut seed) * 2 + next_random(mut seed) % 2) % 60001 - 30000 + lean;
        nums.push(v.max(-30000).min(30000));
    }
    nums
}

fn main() {
    show(vec![1, -2, 3, -2]);
    show(vec![5, -3, 5]);
    show(vec![-3, -2, -3]);
    show(vec![3, -1, 2, -1]);
    show(vec![3, -2, 2, -3]);
    show(vec![-2, -3, -1]);
    show(vec![1]);
    show(vec![-5]);
    show(vec![0, 0, 0]);
    show(vec![2, -1, 2]);
    show(vec![-1, 5, -1, -1, 5, -1]);
    // random arrays of 1 to 1000 values
    let mut seed = 918;
    let mut total = 0;
    let mut check = 0;
    for c in 0..500 {
        let n = 1 + next_random(mut seed) % 1000;
        let lean = (c % 7 - 3) * 5000;
        let r = max_subarray_sum_circular(random_values(mut seed, n, lean));
        total += r;
        check = (check * 1000003 + r + 1000000000) % 1000000007;
    }
    println(f"500 arrays: answers summing to {total}, checksum {check}");
    // LeetCode's largest: 30000 values
    let low: Vec[i64] = Vec.filled(30000, -30000);
    println(f"30000 values of -30000: {max_subarray_sum_circular(low)}");
    let high: Vec[i64] = Vec.filled(30000, 30000);
    println(f"30000 values of 30000: {max_subarray_sum_circular(high)}");
    println(f"30000 random values: {max_subarray_sum_circular(random_values(mut seed, 30000, 0))}");
    // a valley in the middle, so the best wraps around
    let mut valley: Vec[i64] = Vec.new();
    for i in 0..30000 {
        valley.push(if i >= 10000 and i < 20000 { -30000 + i % 7 } else { 30000 - i % 11 });
    }
    println(f"30000 values with a valley: {max_subarray_sum_circular(valley)}");
}
