// LeetCode #1000: Minimum Cost to Merge Stones -- by number of piles
//
// cost(i, j, p) is the least cost of turning piles i to j into exactly p
// piles. For p of 2 or more the first of the p comes from piles i to m
// as one pile and the rest from m + 1 to j as p - 1; one pile is k piles
// and a last move that costs every stone in the stretch. The table
// fills by length, three numbers to a cell. O(n^3 k).

fn merge_stones(stones: ref Vec[i64], k: i64) -> i64 {
    let n = stones.len();
    let none = 1 << 60;
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + stones[i];
    }
    // cost[(i * n + j) * (k + 1) + p]
    let mut cost: Vec[i64] = Vec.filled(n * n * (k + 1), none);
    for i in 0..n {
        cost[(i * n + i) * (k + 1) + 1] = 0;
    }
    for length in 2..n + 1 {
        for i in 0..n - length + 1 {
            let j = i + length - 1;
            let cell = (i * n + j) * (k + 1);
            for p in 2..k + 1 {
                if p > length {
                    break;
                }
                let mut best = none;
                for m in i..j {
                    let first = cost[(i * n + m) * (k + 1) + 1];
                    let rest = cost[((m + 1) * n + j) * (k + 1) + p - 1];
                    if first < none and rest < none {
                        best = best.min(first + rest);
                    }
                }
                cost[cell + p] = best;
            }
            if cost[cell + k] < none {
                cost[cell + 1] = cost[cell + k] + prefix[j + 1] - prefix[i];
            }
        }
    }
    let answer = cost[(n - 1) * (k + 1) + 1];
    if answer < none { answer } else { -1 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// up to `most` piles of 1 to 100 stones and a k from 2 up: half the time
// a pile count that k can merge down to one pile, half the time any
fn random_case(most: i64, seed: mut ref i64) -> (Vec[i64], i64) {
    let k = 2 + next_random(mut seed) % 4;
    let mut n = 0;
    if next_random(mut seed) % 2 == 0 {
        let merges = next_random(mut seed) % ((most - 1) / (k - 1) + 1);
        n = 1 + merges * (k - 1);
    } else {
        n = 1 + next_random(mut seed) % most;
    }
    let stones: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 100).collect();
    (stones, k)
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(Vec[i64], i64)] = vec![
        (vec![3, 2, 4, 1], 2),
        (vec![3, 2, 4, 1], 3),
        (vec![3, 5, 1, 2, 6], 3),
        (vec![7], 2),
        (vec![7], 5),
        (vec![4, 6], 2),
        (vec![4, 6], 3),
        (vec![1, 2, 3], 3),
        (vec![6, 4, 4, 6], 2),
        (vec![1, 100, 1, 100, 1], 3),
    ];
    for (stones, k) in cases.iter() {
        let text: Vec[String] = stones.iter().map(|x| f"{x}").collect();
        println(f"stones = [{text.join(",")}], k = {k} -> {merge_stones(stones, *k)}");
    }
    let big: Vec[(String, Vec[i64], i64)] = vec![
        ("30 piles of 100, k = 2".to_string(), Vec.filled(30, 100), 2),
        ("30 piles of 100, k = 30".to_string(), Vec.filled(30, 100), 30),
        ("30 piles of 100, k = 3".to_string(), Vec.filled(30, 100), 3),
        ("29 piles of 1 to 29, k = 3".to_string(), (1..30).collect(), 3),
        ("29 piles of 1 to 29, k = 15".to_string(), (1..30).collect(), 15),
        ("29 piles, 100 and 1 in turn, k = 5".to_string(), (0..29).map(|i| if i % 2 == 0 { 100 } else { 1 }).collect(), 5),
    ];
    for (name, stones, k) in big.iter() {
        println(f"{name}: {merge_stones(stones, *k)}");
    }
    let mut seed = 1000;
    for (count, most) in vec![(300, 6), (3000, 15), (300, 30)] {
        let mut piles = 0;
        let mut impossible = 0;
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let (stones, k) = random_case(most, mut seed);
            let got = merge_stones(stones, k);
            piles += stones.len();
            if got < 0 {
                impossible += 1;
            } else {
                total += got;
            }
            check = (check * 31 + got + 2) % 1000000007;
        }
        println(f"{count} random rows of {piles} piles: {impossible} impossible, cost {total}, checksum {check}");
    }
}
