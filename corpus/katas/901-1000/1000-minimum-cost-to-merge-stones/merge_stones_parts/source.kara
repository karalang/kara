// LeetCode #1000: Minimum Cost to Merge Stones -- k parts of one pile
//
// one[i][j] is the least cost of merging piles i to j into one pile. Its
// last move merges k piles, each made from a part of the stretch, so
// one[i][j] is every stone in it plus the cheapest way to cut it into k
// parts that each end as one pile, found by a small table of its own:
// the cheapest way to cover piles i to t with q such parts. O(n^4).

fn merge_stones(stones: ref Vec[i64], k: i64) -> i64 {
    let n = stones.len();
    let none = 1 << 60;
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + stones[i];
    }
    let mut one: Vec[Vec[i64]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[i64] = Vec.filled(n, none);
        row[i] = 0;
        one.push(row);
    }
    for length in k..n + 1 {
        if (length - 1) % (k - 1) != 0 {
            continue;
        }
        for i in 0..n - length + 1 {
            let j = i + length - 1;
            // cover[q][t]: piles i to t as q parts of one pile each
            let mut cover: Vec[Vec[i64]] = Vec.new();
            for _ in 0..k + 1 {
                cover.push(Vec.filled(n, none));
            }
            for t in i..j + 1 {
                cover[1][t] = one[i][t];
            }
            for q in 2..k + 1 {
                for t in i..j + 1 {
                    for s in i..t {
                        if cover[q - 1][s] < none and one[s + 1][t] < none {
                            cover[q][t] = cover[q][t].min(cover[q - 1][s] + one[s + 1][t]);
                        }
                    }
                }
            }
            if cover[k][j] < none {
                one[i][j] = cover[k][j] + prefix[j + 1] - prefix[i];
            }
        }
    }
    if one[0][n - 1] < none { one[0][n - 1] } else { -1 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// up to `most` piles of 1 to 100 stones and a k from 2 up: half the time
// a pile count that k can merge down to one pile, half the time any
fn random_case(most: i64, seed: mut ref i64) -> (Vec[i64], i64) {
    let k = 2 + next_random(mut seed) % 4;
    let mut n = 0;
    if next_random(mut seed) % 2 == 0 {
        let merges = next_random(mut seed) % ((most - 1) / (k - 1) + 1);
        n = 1 + merges * (k - 1);
    } else {
        n = 1 + next_random(mut seed) % most;
    }
    let stones: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 100).collect();
    (stones, k)
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(Vec[i64], i64)] = vec![
        (vec![3, 2, 4, 1], 2),
        (vec![3, 2, 4, 1], 3),
        (vec![3, 5, 1, 2, 6], 3),
        (vec![7], 2),
        (vec![7], 5),
        (vec![4, 6], 2),
        (vec![4, 6], 3),
        (vec![1, 2, 3], 3),
        (vec![6, 4, 4, 6], 2),
        (vec![1, 100, 1, 100, 1], 3),
    ];
    for (stones, k) in cases.iter() {
        let text: Vec[String] = stones.iter().map(|x| f"{x}").collect();
        println(f"stones = [{text.join(",")}], k = {k} -> {merge_stones(stones, *k)}");
    }
    let big: Vec[(String, Vec[i64], i64)] = vec![
        ("30 piles of 100, k = 2".to_string(), Vec.filled(30, 100), 2),
        ("30 piles of 100, k = 30".to_string(), Vec.filled(30, 100), 30),
        ("30 piles of 100, k = 3".to_string(), Vec.filled(30, 100), 3),
        ("29 piles of 1 to 29, k = 3".to_string(), (1..30).collect(), 3),
        ("29 piles of 1 to 29, k = 15".to_string(), (1..30).collect(), 15),
        ("29 piles, 100 and 1 in turn, k = 5".to_string(), (0..29).map(|i| if i % 2 == 0 { 100 } else { 1 }).collect(), 5),
    ];
    for (name, stones, k) in big.iter() {
        println(f"{name}: {merge_stones(stones, *k)}");
    }
    let mut seed = 1000;
    for (count, most) in vec![(300, 6), (3000, 15), (300, 30)] {
        let mut piles = 0;
        let mut impossible = 0;
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let (stones, k) = random_case(most, mut seed);
            let got = merge_stones(stones, k);
            piles += stones.len();
            if got < 0 {
                impossible += 1;
            } else {
                total += got;
            }
            check = (check * 31 + got + 2) % 1000000007;
        }
        println(f"{count} random rows of {piles} piles: {impossible} impossible, cost {total}, checksum {check}");
    }
}
