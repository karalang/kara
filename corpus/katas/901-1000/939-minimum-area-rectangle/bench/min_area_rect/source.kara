// Benchmark: LeetCode #939 Minimum Area Rectangle -- the ★ arm, pairs as
// diagonals, on 20 sets of 500 points, LeetCode's most, in 10 rounds.
// Mirrors min_area_rect.c, .rs, .py and go-seq/.

fn min_area_rect(points: Vec[Vec[i64]]) -> i64 {
    let mut seen: Set[i64] = Set.new();
    for p in points.iter() {
        seen.insert(p[0] * 40001 + p[1]);
    }
    let mut best = 0;
    let n = points.len();
    for i in 0..n {
        let x1 = points[i][0];
        let y1 = points[i][1];
        for j in (i + 1)..n {
            let x2 = points[j][0];
            let y2 = points[j][1];
            if x1 != x2 and y1 != y2 and seen.contains(x1 * 40001 + y2) and seen.contains(x2 * 40001 + y1) {
                let area = (x1 - x2).abs() * (y1 - y2).abs();
                if best == 0 or area < best {
                    best = area;
                }
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 10;
    let count = 20;
    let mut seed = 939;
    // each set holds 500 distinct points at random cells of a 40 by 40
    // grid, its cells 1 to 100 apart
    let mut sets: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        let step = 1 + next_random(mut seed) % 100;
        let ox = next_random(mut seed) % 1000;
        let oy = next_random(mut seed) % 1000;
        let mut taken: Vec[bool] = Vec.new();
        for _ in 0..1600 {
            taken.push(false);
        }
        let mut points: Vec[Vec[i64]] = Vec.new();
        while points.len() < 500 {
            let c = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1600;
            if not taken[c] {
                taken[c] = true;
                points.push(vec![ox + (c % 40) * step, oy + (c / 40) * step]);
            }
        }
        sets.push(points);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        // each round answers every set, starting from a different one
        for i in 0..count {
            let a = min_area_rect(sets[(r + i) % count]);
            total += a;
            check = (check * 1000003 + a) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} sets of 500 points: areas adding to {total}, checksum {check}");
}
