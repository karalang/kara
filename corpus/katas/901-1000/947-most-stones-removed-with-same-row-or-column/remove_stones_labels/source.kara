// LeetCode #947: Most Stones Removed with Same Row or Column -- the least
// label spread along the lines.
//
// Every stone starts labelled with its own index. In each pass every row
// and every column takes the least label among its stones, and every
// stone the least of its row's and its column's; when a pass changes
// nothing, each group carries the least index in it, and the groups are
// the stones still holding their own index. Each pass carries a label one
// line further, so the passes are as many as the longest path of lines
// in a group. The rows' and columns' least labels are kept in two lists
// as long as the largest row and column used. O(n d) time for that
// length d, O(n + largest line) space.

fn remove_stones(stones: Vec[Vec[i64]]) -> i64 {
    let n = stones.len();
    let mut label: Vec[i64] = Vec.new();
    for i in 0..n {
        label.push(i);
    }
    let mut top_row = 0;
    let mut top_col = 0;
    for s in stones.iter() {
        top_row = top_row.max(s[0]);
        top_col = top_col.max(s[1]);
    }
    let mut row_low: Vec[i64] = Vec.filled(top_row + 1, n);
    let mut col_low: Vec[i64] = Vec.filled(top_col + 1, n);
    let mut changed = true;
    while changed {
        changed = false;
        for i in 0..n {
            let r = stones[i][0];
            let c = stones[i][1];
            row_low[r] = row_low[r].min(label[i]);
            col_low[c] = col_low[c].min(label[i]);
        }
        for i in 0..n {
            let low = row_low[stones[i][0]].min(col_low[stones[i][1]]);
            if low < label[i] {
                label[i] = low;
                changed = true;
            }
        }
        for i in 0..n {
            row_low[stones[i][0]] = n;
            col_low[stones[i][1]] = n;
        }
    }
    let mut groups = 0;
    for i in 0..n {
        if label[i] == i {
            groups += 1;
        }
    }
    n - groups
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(stones: ref Vec[Vec[i64]]) -> String {
    let mut s = String.new();
    for i in 0..stones.len() {
        if i > 0 {
            s = s + ",";
        }
        s = s + f"[{stones[i][0]},{stones[i][1]}]";
    }
    f"[{s}]"
}

fn removed_text(r: i64) -> String {
    if r == 1 { "1 stone removed".to_string() } else { f"{r} stones removed" }
}

// n stones at distinct random points with x from 0 to w - 1 and y from 0
// to h - 1, or one at every point when there are fewer than n.
fn random_stones(n: i64, w: i64, h: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut taken: Set[i64] = Set.new();
    let mut stones: Vec[Vec[i64]] = Vec.new();
    let want = n.min(w * h);
    while stones.len() < want {
        let x = (next_random(mut seed) * 32768 + next_random(mut seed)) % w;
        let y = (next_random(mut seed) * 32768 + next_random(mut seed)) % h;
        if not taken.contains(x * 10001 + y) {
            taken.insert(x * 10001 + y);
            stones.push(vec![x, y]);
        }
    }
    stones
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[Vec[i64]]] = vec![
        vec![vec![0, 0], vec![0, 1], vec![1, 0], vec![1, 2], vec![2, 1], vec![2, 2]],
        vec![vec![0, 0], vec![0, 2], vec![1, 1], vec![2, 0], vec![2, 2]],
        vec![vec![0, 0]],
        vec![vec![0, 0], vec![0, 5]],
        vec![vec![0, 0], vec![1, 1], vec![2, 2], vec![3, 3]],
        vec![vec![0, 0], vec![0, 1], vec![1, 1], vec![1, 2], vec![2, 2]],
        vec![vec![10000, 10000], vec![10000, 0], vec![0, 10000]],
        vec![vec![0, 0], vec![0, 1], vec![5, 5], vec![5, 6], vec![9, 0]],
    ];
    for stones in examples.iter() {
        println(f"{show(stones)}: {removed_text(remove_stones(stones))}");
    }
    // 300 random sets of 1 to 40 stones on grids of 1 to 25 by 1 to 25
    let mut seed = 947;
    let mut count = 0;
    let mut removed = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = 1 + next_random(mut seed) % 40;
        let w = 1 + next_random(mut seed) % 25;
        let h = 1 + next_random(mut seed) % 25;
        let stones = random_stones(n, w, h, mut seed);
        let r = remove_stones(stones);
        count += stones.len();
        removed += r;
        check = (check * 31 + r) % 1000000007;
    }
    println(f"300 random sets of {count} stones: {removed} removed, checksum {check}");
    // LeetCode's largest, 1000 stones
    let wide = random_stones(1000, 10001, 10001, mut seed);
    println(f"1000 stones at random points up to 10000: {removed_text(remove_stones(wide))}");
    let sparse = random_stones(1000, 1000, 1000, mut seed);
    println(f"1000 stones at random points up to 999: {removed_text(remove_stones(sparse))}");
    let mut stairs: Vec[Vec[i64]] = Vec.new();
    for i in 0..1000 {
        stairs.push(vec![i / 2, (i + 1) / 2]);
    }
    println(f"1000 stones in a staircase: {removed_text(remove_stones(stairs))}");
    let mut diagonal: Vec[Vec[i64]] = Vec.new();
    for i in 0..1000 {
        diagonal.push(vec![i * 10, 9990 - i * 10]);
    }
    println(f"1000 stones on a diagonal: {removed_text(remove_stones(diagonal))}");
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for i in 0..1000 {
        grid.push(vec![i / 40 * 400, i % 40 * 250]);
    }
    println(f"25 rows of 40 stones: {removed_text(remove_stones(grid))}");
}
