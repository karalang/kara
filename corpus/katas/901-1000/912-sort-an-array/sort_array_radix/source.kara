// LeetCode #912: Sort an Array -- radix sort on the digits base 256.
//
// Shift every value up by 5 * 10^4 so that none is negative, then sort
// stably by its lowest byte, then by its next, and so on while any value
// has a byte left (three passes for values up to 10^5): each pass counts
// the byte's 256 values, turns the counts into starting places and copies
// every value to its place. Shift back at the end. O(n) a pass.

fn sort_array(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let offset = 50000;
    let mut from: Vec[i64] = Vec.new();
    let mut largest = 0;
    for i in 0..n {
        from.push(nums[i] + offset);
        largest = largest.max(nums[i] + offset);
    }
    let mut to: Vec[i64] = Vec.filled(n, 0);
    let mut shift = 0;
    while (largest >> shift) > 0 {
        let mut start: Vec[i64] = Vec.filled(257, 0);
        for i in 0..n {
            start[((from[i] >> shift) & 255) + 1] += 1;
        }
        for d in 1..257 {
            start[d] += start[d - 1];
        }
        for i in 0..n {
            let d = (from[i] >> shift) & 255;
            to[start[d]] = from[i];
            start[d] += 1;
        }
        let swap = from;
        from = to;
        to = swap;
        shift += 8;
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..n {
        out.push(from[i] - offset);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn join(v: Vec[i64]) -> String {
    let mut s = String.new();
    for i in 0..v.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str(f"{v[i]}");
    }
    s
}

fn show(nums: Vec[i64]) {
    println(f"[{join(nums)}] -> [{join(sort_array(nums))}]");
}

// The sorted values folded into a checksum, place by place.
fn fold(nums: Vec[i64]) -> i64 {
    let sorted = sort_array(nums);
    let mut check = sorted.len();
    for i in 0..sorted.len() {
        check = (check * 1000003 + sorted[i] + 50000) % 1000000007;
    }
    check
}

fn main() {
    show(vec![5, 2, 3, 1]);
    show(vec![5, 1, 1, 2, 0, 0]);
    show(vec![1]);
    show(vec![50000, -50000]);
    show(vec![-3, -1, -2, 0, 2, 1, 3]);
    show(vec![1, 2, 3, 4, 5, 6, 7, 8]);
    show(vec![8, 7, 6, 5, 4, 3, 2, 1]);
    show(vec![4, 4, 4, 4, 4]);
    show(vec![255, 256, 0, -1, 257, -256, 50000, -50000, 65535 - 50000]);
    // random arrays of up to 2000 numbers in ranges of 10, 1000 or the
    // whole span
    let mut seed = 912;
    let mut check = 0;
    for c in 0..300 {
        let n = 1 + next_random(mut seed) % 2000;
        let span = if c % 3 == 0 { 10 } else if c % 3 == 1 { 1000 } else { 100001 };
        let low = -50000 + next_random(mut seed) % (100002 - span);
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(low + next_random(mut seed) % span);
        }
        check = (check * 31 + fold(nums)) % 1000000007;
    }
    println(f"300 arrays: checksum {check}");
    // LeetCode's largest: 5 * 10^4 numbers, random, falling and nearly all equal
    let mut random: Vec[i64] = Vec.new();
    let mut falling: Vec[i64] = Vec.new();
    let mut equal: Vec[i64] = Vec.new();
    for i in 0..50000 {
        random.push(next_random(mut seed) % 100001 - 50000);
        falling.push(50000 - 2 * i);
        equal.push(if i % 1000 == 0 { i / 1000 } else { 7 });
    }
    println(f"50000 random: checksum {fold(random)}");
    println(f"50000 falling: checksum {fold(falling)}");
    println(f"50000 nearly equal: checksum {fold(equal)}");
}
