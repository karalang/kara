// LeetCode #912: Sort an Array -- bench program.
//
// The ★ arm (heap sort) on 500,000 numbers from -5 * 10^4 to 5 * 10^4,
// built once. Each round sorts a copy, folds a sample of the sorted
// values into a checksum and changes one number; 6 rounds.

fn sift_down(a: mut ref Vec[i64], start: i64, end: i64) {
    let mut root = start;
    loop {
        let mut child = 2 * root + 1;
        if child >= end {
            return;
        }
        if child + 1 < end and a[child + 1] > a[child] {
            child += 1;
        }
        if a[root] >= a[child] {
            return;
        }
        let held = a[root];
        a[root] = a[child];
        a[child] = held;
        root = child;
    }
}

fn sort_array(nums: Vec[i64]) -> Vec[i64] {
    let mut a = nums.clone();
    let n = a.len();
    let mut parent = n / 2 - 1;
    while parent >= 0 {
        sift_down(mut a, parent, n);
        parent -= 1;
    }
    let mut end = n - 1;
    while end > 0 {
        let top = a[0];
        a[0] = a[end];
        a[end] = top;
        sift_down(mut a, 0, end);
        end -= 1;
    }
    a
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 500000;
    let rounds = 6;
    let mut seed = 912;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(next_random(mut seed) % 100001 - 50000);
    }
    let mut check = 0;
    for round in 0..rounds {
        let sorted = sort_array(nums);
        let mut i = round;
        while i < n {
            check = (check * 31 + sorted[i] + 50000) % 1000000007;
            i += 997;
        }
        nums[round * 7919 % n] = next_random(mut seed) % 100001 - 50000;
    }
    println(f"{rounds} rounds over {n} numbers: checksum {check}");
}
