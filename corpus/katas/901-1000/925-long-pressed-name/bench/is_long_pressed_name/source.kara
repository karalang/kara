// LeetCode #925: Long Pressed Name -- bench: two pointers.
//
// Walk typed once with a pointer into name. A typed character that is
// name's next character moves both pointers; one that repeats the typed
// character before it is a long press and is skipped; anything else
// cannot come from name. At the end every character of name must have
// been typed. O(n + m), O(1) extra space.

fn is_long_pressed_name(name: String, typed: String) -> bool {
    let a = name.bytes().to_vec();
    let b = typed.bytes().to_vec();
    let mut i = 0;
    for j in 0..b.len() {
        if i < a.len() and a[i] == b[j] {
            i += 1;
        } else if j > 0 and b[j] == b[j - 1] {
            continue;
        } else {
            return false;
        }
    }
    i == a.len()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 150;
    let count = 1000;
    let mut seed = 925;
    // count names of 400 letters from "abc", each typed with about one key
    // in four held down for up to three more presses, and every third one
    // mistyped once
    let mut names: Vec[String] = Vec.new();
    let mut typings: Vec[String] = Vec.new();
    for p in 0..count {
        let mut name: Vec[u8] = Vec.new();
        let mut typed: Vec[u8] = Vec.new();
        for _ in 0..400 {
            let c = b'a' + (next_random(mut seed) % 3) as u8;
            name.push(c);
            let extra = if next_random(mut seed) % 4 == 0 { 1 + next_random(mut seed) % 3 } else { 0 };
            for _ in 0..1 + extra {
                typed.push(c);
            }
        }
        if p % 3 == 0 {
            let at = next_random(mut seed) % typed.len();
            typed[at] = b'a' + (next_random(mut seed) % 3) as u8;
        }
        names.push(String.from_utf8(name).unwrap());
        typings.push(String.from_utf8(typed).unwrap());
    }
    let mut yes = 0;
    let mut check = 0;
    for r in 0..rounds {
        // each round visits every pair, starting from a different one
        for i in 0..count {
            let p = (r + i) % count;
            if is_long_pressed_name(names[p], typings[p]) {
                yes += 1;
                check = (check * 1000003 + p + 1) % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds over {count} names of 400 letters: {yes} long pressed, checksum {check}");
}
