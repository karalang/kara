// LeetCode #925: Long Pressed Name -- two pointers from the right.
//
// Reversing both strings keeps a long press a long press, so the two
// pointers can as well start at the ends: a typed character that is
// name's character before the pointer moves both; one that repeats the
// typed character after it is a long press and is skipped; anything else
// fails. O(n + m), O(1) extra space.

fn is_long_pressed_name(name: String, typed: String) -> bool {
    let a = name.bytes().to_vec();
    let b = typed.bytes().to_vec();
    let mut i = a.len();
    let mut j = b.len();
    while j > 0 {
        if i > 0 and a[i - 1] == b[j - 1] {
            i -= 1;
            j -= 1;
        } else if j < b.len() and b[j - 1] == b[j] {
            j -= 1;
        } else {
            return false;
        }
    }
    i == 0
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(name: String, typed: String) {
    println(f"\"{name}\", \"{typed}\": {is_long_pressed_name(name, typed)}");
}

// a name of n letters from the first `letters` of the alphabet, typed
// with some keys held down, then perhaps mistyped once
fn random_case(seed: mut ref i64, n: i64, letters: i64) -> (String, String) {
    let mut name: Vec[u8] = Vec.new();
    for _ in 0..n {
        name.push(b'a' + (next_random(mut seed) % letters) as u8);
    }
    let mut typed: Vec[u8] = Vec.new();
    for c in name.iter() {
        let extra = if next_random(mut seed) % 4 == 0 { 1 + next_random(mut seed) % 3 } else { 0 };
        for _ in 0..1 + extra {
            typed.push(*c);
        }
    }
    let how = next_random(mut seed) % 6;
    let at = next_random(mut seed) % typed.len();
    let letter = b'a' + (next_random(mut seed) % letters) as u8;
    if how == 0 {
        typed.remove(at);
    } else if how == 1 {
        typed.insert(at, letter);
    } else if how == 2 {
        typed[at] = letter;
    }
    if typed.len() == 0 {
        typed.push(letter);
    }
    (String.from_utf8(name).unwrap(), String.from_utf8(typed).unwrap())
}

fn main() {
    // LeetCode's two examples
    show("alex", "aaleex");
    show("saeed", "ssaaedd");
    // equal; one letter held; a letter missing; a letter added at the end;
    // a different letter; repeated groups; typed shorter
    show("laiden", "laiden");
    show("a", "aaaa");
    show("aab", "ab");
    show("abc", "abcd");
    show("a", "b");
    show("leelee", "lleeelee");
    show("alex", "alexxr");
    show("vtkgn", "vttkgnn");
    show("abc", "ab");
    // 300 random names of 1 to 200 letters
    let mut seed = 925;
    let mut yes = 0;
    let mut check = 0;
    for r in 0..300 {
        let n = 1 + next_random(mut seed) % 200;
        let letters = if r % 3 == 0 { 2 } else if r % 3 == 1 { 3 } else { 26 };
        let (name, typed) = random_case(mut seed, n, letters);
        let a = is_long_pressed_name(name, typed);
        let bit = if a { 1 } else { 0 };
        yes += bit;
        check = (check * 1000003 + bit * (r + 1)) % 1000000007;
    }
    println(f"300 random names: {yes} long pressed, checksum {check}");
    // LeetCode's largest, 1000 letters: all one letter; "ab" 500 times
    // against itself; and 500 letters each typed twice
    let mut ones: Vec[u8] = Vec.new();
    let mut ab: Vec[u8] = Vec.new();
    let mut half: Vec[u8] = Vec.new();
    let mut twice: Vec[u8] = Vec.new();
    for i in 0..1000 {
        ones.push(b'z');
        ab.push(if i % 2 == 0 { b'a' } else { b'b' });
    }
    for i in 0..500 {
        let c = b'a' + (i % 26) as u8;
        half.push(c);
        twice.push(c);
        twice.push(c);
    }
    let z = String.from_utf8(ones).unwrap();
    let abab = String.from_utf8(ab).unwrap();
    let h = String.from_utf8(half).unwrap();
    let t = String.from_utf8(twice).unwrap();
    println(f"1000 letters: z against z {is_long_pressed_name(z, z)}, ab against ab {is_long_pressed_name(abab, abab)}, each typed twice {is_long_pressed_name(h, t)}, twice against once {is_long_pressed_name(t, h)}");
}
