// LeetCode #925: Long Pressed Name -- differential test of the five
// arms against the statement read literally, with six properties.
//
// The statement: your friend is typing his name into a keyboard.
// Sometimes, when typing a character c, the key might get long pressed,
// and the character will be typed 1 or more times. You examine the typed
// characters of the keyboard. Return True if it is possible that it was
// your friend's name, with some characters (possibly none) being long
// pressed.

// ---- the ★ arm: two pointers ----------------------------------------------
fn star_is_long_pressed_name(name: String, typed: String) -> bool {
    let a = name.bytes().to_vec();
    let b = typed.bytes().to_vec();
    let mut i = 0;
    for j in 0..b.len() {
        if i < a.len() and a[i] == b[j] {
            i += 1;
        } else if j > 0 and b[j] == b[j - 1] {
            continue;
        } else {
            return false;
        }
    }
    i == a.len()
}

// ---- the runs arm: run-length encodings -----------------------------------
struct RunsRun {
    letter: u8,
    length: i64,
}

fn runs_runs_of(s: String) -> Vec[RunsRun] {
    let mut out: Vec[RunsRun] = Vec.new();
    for c in s.bytes() {
        let last = out.len();
        if last > 0 and out[last - 1].letter == c {
            out[last - 1].length += 1;
        } else {
            out.push(RunsRun { letter: c, length: 1 });
        }
    }
    out
}

fn runs_is_long_pressed_name(name: String, typed: String) -> bool {
    let x = runs_runs_of(name);
    let y = runs_runs_of(typed);
    if x.len() != y.len() {
        return false;
    }
    for k in 0..x.len() {
        if x[k].letter != y[k].letter or y[k].length < x[k].length {
            return false;
        }
    }
    true
}

// ---- the groups arm: the groups walked side by side -----------------------
fn groups_is_long_pressed_name(name: String, typed: String) -> bool {
    let a = name.bytes().to_vec();
    let b = typed.bytes().to_vec();
    let mut i = 0;
    let mut j = 0;
    while i < a.len() and j < b.len() {
        if a[i] != b[j] {
            return false;
        }
        let letter = a[i];
        let mut p = 0;
        while i < a.len() and a[i] == letter {
            i += 1;
            p += 1;
        }
        let mut q = 0;
        while j < b.len() and b[j] == letter {
            j += 1;
            q += 1;
        }
        if q < p {
            return false;
        }
    }
    i == a.len() and j == b.len()
}

// ---- the dp arm: dynamic programming over prefixes ------------------------
fn dp_is_long_pressed_name(name: String, typed: String) -> bool {
    let a = name.bytes().to_vec();
    let b = typed.bytes().to_vec();
    let m = b.len();
    // the row for no character of name: only the empty prefix of typed
    let mut prev: Vec[bool] = Vec.filled(m + 1, false);
    prev[0] = true;
    for i in 1..a.len() + 1 {
        let mut row: Vec[bool] = Vec.filled(m + 1, false);
        for j in 1..m + 1 {
            if a[i - 1] == b[j - 1] {
                row[j] = prev[j - 1] or row[j - 1];
            }
        }
        prev = row;
    }
    prev[m]
}

// ---- the backward arm: two pointers from the right ------------------------
fn backward_is_long_pressed_name(name: String, typed: String) -> bool {
    let a = name.bytes().to_vec();
    let b = typed.bytes().to_vec();
    let mut i = a.len();
    let mut j = b.len();
    while j > 0 {
        if i > 0 and a[i - 1] == b[j - 1] {
            i -= 1;
            j -= 1;
        } else if j < b.len() and b[j - 1] == b[j] {
            j -= 1;
        } else {
            return false;
        }
    }
    i == 0
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, name: String, typed: String) -> bool {
    if x == 0 {
        star_is_long_pressed_name(name, typed)
    } else if x == 1 {
        runs_is_long_pressed_name(name, typed)
    } else if x == 2 {
        groups_is_long_pressed_name(name, typed)
    } else if x == 3 {
        dp_is_long_pressed_name(name, typed)
    } else {
        backward_is_long_pressed_name(name, typed)
    }
}

// The statement read literally: try every way of typing name, each
// character typed one or more times, and say whether one of them is
// typed.
fn lit_typing(a: Vec[u8], b: Vec[u8], i: i64, j: i64) -> bool {
    if i == a.len() {
        return j == b.len();
    }
    let mut end = j;
    while end < b.len() and b[end] == a[i] {
        end += 1;
        if lit_typing(a, b, i + 1, end) {
            return true;
        }
    }
    false
}

fn literal(name: String, typed: String) -> bool {
    lit_typing(name.bytes().to_vec(), typed.bytes().to_vec(), 0, 0)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn text(bytes: Vec[u8]) -> String {
    String.from_utf8(bytes).unwrap()
}

fn reversed(s: String) -> String {
    let mut b = s.bytes().to_vec();
    b.reverse();
    text(b)
}

fn doubled(s: String) -> String {
    let mut b: Vec[u8] = Vec.new();
    for c in s.bytes() {
        b.push(c);
        b.push(c);
    }
    text(b)
}

// a name of n letters from the first `letters` of the alphabet, typed
// with some keys held down, then perhaps mistyped once
fn random_case(seed: mut ref i64, n: i64, letters: i64) -> (String, String) {
    let mut name: Vec[u8] = Vec.new();
    for _ in 0..n {
        name.push(b'a' + (next_random(mut seed) % letters) as u8);
    }
    let mut typed: Vec[u8] = Vec.new();
    for c in name.iter() {
        let extra = if next_random(mut seed) % 4 == 0 { 1 + next_random(mut seed) % 3 } else { 0 };
        for _ in 0..1 + extra {
            typed.push(*c);
        }
    }
    let how = next_random(mut seed) % 4;
    let at = next_random(mut seed) % typed.len();
    let letter = b'a' + (next_random(mut seed) % letters) as u8;
    if how == 0 {
        typed.remove(at);
    } else if how == 1 {
        typed.insert(at, letter);
    } else if how == 2 {
        typed[at] = letter;
    }
    if typed.len() == 0 {
        typed.push(letter);
    }
    (text(name), text(typed))
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, name: String, typed: String, small: bool) {
    let name_back = reversed(name);
    let typed_back = reversed(typed);
    let name_twice = doubled(name);
    let typed_twice = doubled(typed);
    // one typed character pressed once more
    let mut longer = typed.bytes().to_vec();
    let at = next_random(mut seed) % longer.len();
    let c = longer[at];
    longer.insert(at, c);
    let typed_longer = text(longer);
    let truth = if small { literal(name, typed) } else { false };
    let mut got: Vec[bool] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, name, typed));
    }
    for x in 0..5 {
        let a = got[x];
        // P1: the statement's answer, on the small cases
        if small {
            check(mut t, 1, a == truth);
        }
        // P2: a name typed exactly is long pressed
        check(mut t, 2, arm(x, name, name));
        // P3: the same answer with both strings reversed
        check(mut t, 3, arm(x, name_back, typed_back) == a);
        // P4: the same answer with every character of both doubled
        check(mut t, 4, arm(x, name_twice, typed_twice) == a);
        // P5: a long pressed name stays long pressed with one typed
        // character pressed once more
        check(mut t, 5, not a or arm(x, name, typed_longer));
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == a {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
}

fn main() {
    let mut t = Tally { checks: 0, failures: [0, 0, 0, 0, 0, 0] };
    let mut seed = 925;
    let mut cases = 0;
    let mut letters_typed = 0;
    let mut yes = 0;
    // 1 to 5 letters against the statement, then 1 to 150; from 2, 3 or
    // 26 letters by turns
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { 1 + next_random(mut seed) % 5 } else { 1 + next_random(mut seed) % 150 };
        let letters = if c % 3 == 0 { 2 } else if c % 3 == 1 { 3 } else { 26 };
        let (name, typed) = random_case(mut seed, n, letters);
        cases += 1;
        letters_typed += typed.len();
        if arm(0, name, typed) {
            yes += 1;
        }
        properties(mut t, mut seed, name, typed, small);
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{cases} cases, {letters_typed} letters typed, {yes} long pressed, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
