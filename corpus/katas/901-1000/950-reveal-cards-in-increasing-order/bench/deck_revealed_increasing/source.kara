// Benchmark: LeetCode #950 Reveal Cards In Increasing Order -- the ★ arm,
// the reveals played on the places, on decks of 1000 cards, LeetCode's
// largest. Mirrors deck_revealed_increasing.c, .rs, .py and go-seq/.

fn deck_revealed_increasing(deck: Vec[i64]) -> Vec[i64] {
    let mut sorted = deck.clone();
    sorted.sort();
    let n = deck.len();
    let mut places: VecDeque[i64] = VecDeque.new();
    for i in 0..n {
        places.push_back(i);
    }
    let mut out: Vec[i64] = Vec.filled(n, 0);
    for card in sorted.iter() {
        let place = places.pop_front().unwrap();
        out[place] = *card;
        if let Some(next) = places.pop_front() {
            places.push_back(next);
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 1000;
    let count = 20;
    let n = 1000;
    let mut seed = 950;
    // distinct cards from 1 to 1000000
    let mut decks: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut taken: Set[i64] = Set.new();
        let mut deck: Vec[i64] = Vec.new();
        while deck.len() < n {
            let v = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000;
            if not taken.contains(v) {
                taken.insert(v);
                deck.push(v);
            }
        }
        decks.push(deck);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for i in 0..count {
            let out = deck_revealed_increasing(decks[(r + i) % count]);
            total += out[n - 1];
            check = (check * 1000003 + out[(r * 7 + i) % n]) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} decks of {n} cards: last cards adding to {total}, checksum {check}");
}
