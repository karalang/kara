// LeetCode #933: Number of Recent Calls -- bench: a queue of the recent
// pings. Mirrors recent_counter.c, .rs, .py and go-seq/.

struct RecentCounter {
    pings: VecDeque[i64],
}

impl RecentCounter {
    fn new() -> RecentCounter {
        RecentCounter { pings: VecDeque.new() }
    }

    fn ping(mut ref self, t: i64) -> i64 {
        self.pings.push_back(t);
        while *self.pings.front().unwrap() < t - 3000 {
            self.pings.pop_front();
        }
        self.pings.len()
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 50;
    let count = 100;
    let len = 10000;
    let mut seed = 933;
    // count streams of len pings, each from 1 to gap after the one before,
    // gap from 1 to 600 a stream, built once
    let mut streams: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let gap = 1 + next_random(mut seed) % 600;
        let mut times: Vec[i64] = Vec.new();
        let mut t = 0;
        for _ in 0..len {
            t += 1 + next_random(mut seed) % gap;
            times.push(t);
        }
        streams.push(times);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        // each round plays every stream into a new counter, starting from
        // a different one
        for i in 0..count {
            let mut counter = RecentCounter.new();
            let mut last = 0;
            for t in streams[(r + i) % count].iter() {
                last = counter.ping(*t);
                total += last;
            }
            check = (check * 1000003 + last) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} streams of {len} pings: answers summing to {total}, checksum {check}");
}
