// LeetCode #967: Numbers With Same Consecutive Differences -- sign
// patterns.
//
// Every such number is a first digit and a choice, at each of the n - 1
// steps, of going up or down by k: n - 1 bits. Try every first digit
// with every pattern of bits, keep the walks that stay within 0 to 9, and
// when k is 0, where up and down are the same step, only the pattern of
// all ups. O(9 * 2^(n-1) * n).

fn nums_same_consec_diff(n: i64, k: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let patterns = if k == 0 { 1 } else { 1 << (n - 1) };
    for first in 1..10 {
        for bits in 0..patterns {
            let mut x = first;
            let mut d = first;
            let mut ok = true;
            for step in 0..n - 1 {
                d = if (bits >> step) & 1 == 0 { d + k } else { d - k };
                if d < 0 or d > 9 {
                    ok = false;
                    break;
                }
                x = x * 10 + d;
            }
            if ok {
                out.push(x);
            }
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn show(v: Vec[i64]) -> String {
    let mut s = String.from("[");
    for i in 0..v.len() {
        if i > 0 {
            s.push_str(",");
        }
        s.push_str(f"{v[i]}");
    }
    s.push_str("]");
    s
}

fn main() {
    // LeetCode's two examples, then a few more, each sorted
    let examples: Vec[(i64, i64)] = vec![(3, 7), (2, 1), (2, 0), (2, 9), (3, 0), (3, 5), (4, 8), (2, 5)];
    for (n, k) in examples {
        let mut got = nums_same_consec_diff(n, k);
        got.sort();
        println(f"n = {n}, k = {k}: {show(got)}");
    }
    // every n from 2 to 9 with every k from 0 to 9: how many, their sum and
    // a checksum of the sorted list
    let mut total = 0;
    let mut all_sum = 0;
    for n in 2..10 {
        let mut line = String.new();
        let mut check = 0;
        for k in 0..10 {
            let mut got = nums_same_consec_diff(n, k);
            got.sort();
            line.push_str(f" {got.len()}");
            total += got.len();
            for x in got {
                all_sum += x;
                check = (check * 31 + x % 1000000007) % 1000000007;
            }
        }
        println(f"n = {n}, k = 0 to 9:{line}, checksum {check}");
    }
    println(f"{total} numbers in all, summing to {all_sum}");
}
