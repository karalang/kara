// LeetCode #951: Flip Equivalent Binary Trees -- differential test of
// the five arms against the statement read literally, with six
// properties.
//
// The statement: for a binary tree T, we can define a flip operation as
// follows: choose any node, and swap the left and right child subtrees.
// A binary tree X is flip equivalent to a binary tree Y if and only if
// we can make X equal to Y after some number of flip operations. Given
// the roots of two binary trees root1 and root2, return true if the two
// trees are flip equivalent or false otherwise.

// ---- the ★ arm: both pairings tried ---------------------------------------
fn star_flip_equiv(root1: Option[TreeNode], root2: Option[TreeNode]) -> bool {
    match (root1, root2) {
        (None, None) => true,
        (Some(a), Some(b)) => {
            a.val == b.val
                and ((star_flip_equiv(a.left, b.left) and star_flip_equiv(a.right, b.right))
                    or (star_flip_equiv(a.left, b.right) and star_flip_equiv(a.right, b.left)))
        }
        _ => false,
    }
}

// ---- the strings arm: the canonical form ----------------------------------
fn strings_key(t: ref Option[TreeNode]) -> i64 {
    match t {
        None => -1,
        Some(node) => node.val,
    }
}

fn strings_canonical(t: Option[TreeNode]) -> String {
    match t {
        None => "#".to_string(),
        Some(node) => {
            let (first, second) = if strings_key(node.left) <= strings_key(node.right) {
                (node.left, node.right)
            } else {
                (node.right, node.left)
            };
            f"({node.val} {strings_canonical(first)} {strings_canonical(second)})"
        }
    }
}

fn strings_flip_equiv(root1: Option[TreeNode], root2: Option[TreeNode]) -> bool {
    strings_canonical(root1) == strings_canonical(root2)
}

// ---- the parents arm: the same parents ------------------------------------
// parent[v]: -2 when v is not in the tree, -1 for the root
fn parents_record(t: Option[TreeNode], parent_val: i64, parent: mut ref Vec[i64]) {
    if let Some(node) = t {
        parent[node.val] = parent_val;
        parents_record(node.left, node.val, mut parent);
        parents_record(node.right, node.val, mut parent);
    }
}

fn parents_flip_equiv(root1: Option[TreeNode], root2: Option[TreeNode]) -> bool {
    let mut p1: Vec[i64] = Vec.filled(100, -2);
    let mut p2: Vec[i64] = Vec.filled(100, -2);
    parents_record(root1, -1, mut p1);
    parents_record(root2, -1, mut p2);
    p1 == p2
}

// ---- the choose arm: the pairing chosen by value --------------------------
fn choose_value_of(t: ref Option[TreeNode]) -> i64 {
    match t {
        None => -1,
        Some(node) => node.val,
    }
}

fn choose_flip_equiv(root1: Option[TreeNode], root2: Option[TreeNode]) -> bool {
    match (root1, root2) {
        (None, None) => true,
        (Some(a), Some(b)) => {
            if a.val != b.val {
                return false;
            }
            if choose_value_of(a.left) == choose_value_of(b.left) {
                choose_flip_equiv(a.left, b.left) and choose_flip_equiv(a.right, b.right)
            } else {
                choose_flip_equiv(a.left, b.right) and choose_flip_equiv(a.right, b.left)
            }
        }
        _ => false,
    }
}

// ---- the queue arm: pairs of nodes in a queue -----------------------------
fn queue_val_or_none(t: ref Option[TreeNode]) -> i64 {
    match t {
        None => -1,
        Some(node) => node.val,
    }
}

fn queue_flip_equiv(root1: Option[TreeNode], root2: Option[TreeNode]) -> bool {
    let mut pairs: VecDeque[(Option[TreeNode], Option[TreeNode])] = VecDeque.new();
    pairs.push_back((root1, root2));
    while let Some((x, y)) = pairs.pop_front() {
        match (x, y) {
            (None, None) => {}
            (Some(a), Some(b)) => {
                if a.val != b.val {
                    return false;
                }
                let (al, ar) = (queue_val_or_none(a.left), queue_val_or_none(a.right));
                let (bl, br) = (queue_val_or_none(b.left), queue_val_or_none(b.right));
                if al == bl and ar == br {
                    pairs.push_back((a.left, b.left));
                    pairs.push_back((a.right, b.right));
                } else if al == br and ar == bl {
                    pairs.push_back((a.left, b.right));
                    pairs.push_back((a.right, b.left));
                } else {
                    return false;
                }
            }
            _ => {
                return false;
            }
        }
    }
    true
}

// ---- the differential -----------------------------------------------------

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn arm(x: i64, a: Option[TreeNode], b: Option[TreeNode]) -> bool {
    if x == 0 {
        star_flip_equiv(a, b)
    } else if x == 1 {
        strings_flip_equiv(a, b)
    } else if x == 2 {
        parents_flip_equiv(a, b)
    } else if x == 3 {
        choose_flip_equiv(a, b)
    } else {
        queue_flip_equiv(a, b)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Hang a new node below root, going left or right at random down to the
// first empty place.
fn attach(root: TreeNode, node: TreeNode, seed: mut ref i64) {
    let mut cur = root;
    loop {
        if next_random(mut seed) % 2 == 0 {
            match cur.left {
                Some(l) => cur = l,
                None => {
                    cur.left = Some(node);
                    return;
                }
            }
        } else {
            match cur.right {
                Some(r) => cur = r,
                None => {
                    cur.right = Some(node);
                    return;
                }
            }
        }
    }
}

// A random tree holding the values in turn.
fn random_tree(values: ref Vec[i64], seed: mut ref i64) -> Option[TreeNode] {
    if values.len() == 0 {
        return None;
    }
    let root = TreeNode { val: values[0], left: None, right: None };
    for i in 1..values.len() {
        attach(root, TreeNode { val: values[i], left: None, right: None }, mut seed);
    }
    Some(root)
}

// A copy with each value v renamed to rename[v], and each node's children
// swapped with chance one in two.
fn flipped_copy(t: ref Option[TreeNode], rename: ref Vec[i64], seed: mut ref i64) -> Option[TreeNode] {
    match t {
        None => None,
        Some(node) => {
            let l = flipped_copy(node.left, rename, mut seed);
            let r = flipped_copy(node.right, rename, mut seed);
            if next_random(mut seed) % 2 == 0 {
                Some(TreeNode { val: rename[node.val], left: l, right: r })
            } else {
                Some(TreeNode { val: rename[node.val], left: r, right: l })
            }
        }
    }
}

// Take one leaf off at random, other than the root; the leaf taken, or
// None when the root is alone.
fn detach_leaf(root: TreeNode, seed: mut ref i64) -> Option[TreeNode] {
    let mut parents: Vec[TreeNode] = Vec.new();
    let mut sides: Vec[i64] = Vec.new();
    let mut stack: Vec[TreeNode] = vec![root];
    while let Some(node) = stack.pop() {
        if let Some(l) = node.left {
            if l.left.is_none() and l.right.is_none() {
                parents.push(node);
                sides.push(0);
            } else {
                stack.push(l);
            }
        }
        if let Some(r) = node.right {
            if r.left.is_none() and r.right.is_none() {
                parents.push(node);
                sides.push(1);
            } else {
                stack.push(r);
            }
        }
    }
    if parents.len() == 0 {
        return None;
    }
    let k = next_random(mut seed) % parents.len();
    let p = parents[k];
    let leaf = if sides[k] == 0 { p.left } else { p.right };
    if sides[k] == 0 {
        p.left = None;
    } else {
        p.right = None;
    }
    leaf
}

fn identity() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for i in 0..100 {
        v.push(i);
    }
    v
}

// The first n of the values 0 to 99 shuffled.
fn some_values(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut v = identity();
    for i in 0..n {
        let j = i + next_random(mut seed) % (100 - i);
        v.swap(i, j);
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..n {
        out.push(v[i]);
    }
    out
}

// The second tree of a pair, by kind: 0 a flipped copy, 1 a flipped copy
// with two values swapped, 2 a flipped copy with a leaf moved, 3 another
// random tree of the same values, 4 a flipped copy with a leaf taken off
// (none left when the tree is one node).
fn partner(t: ref Option[TreeNode], values: ref Vec[i64], kind: i64, seed: mut ref i64) -> Option[TreeNode] {
    let mut rename = identity();
    if kind == 1 and values.len() >= 2 {
        let a = values[next_random(mut seed) % values.len()];
        let b = values[next_random(mut seed) % values.len()];
        rename[a] = b;
        rename[b] = a;
    }
    if kind == 3 {
        let mut shuffled = values.clone();
        for i in 0..shuffled.len() {
            let j = i + next_random(mut seed) % (shuffled.len() - i);
            shuffled.swap(i, j);
        }
        if shuffled.len() > 0 {
            // keep the root's value, as a different root is an easy no
            for i in 0..shuffled.len() {
                if shuffled[i] == values[0] {
                    shuffled.swap(0, i);
                }
            }
        }
        return random_tree(shuffled, mut seed);
    }
    let copy = flipped_copy(t, rename, mut seed);
    if let Some(root) = copy {
        if kind == 2 {
            if let Some(leaf) = detach_leaf(root, mut seed) {
                attach(root, leaf, mut seed);
            }
        } else if kind == 4 {
            if root.left.is_none() and root.right.is_none() {
                return None;
            }
            let _ = detach_leaf(root, mut seed);
        }
    }
    copy
}

fn size(t: ref Option[TreeNode]) -> i64 {
    match t {
        None => 0,
        Some(node) => 1 + size(node.left) + size(node.right),
    }
}

// The same tree: both empty, or the same value with the same left and
// the same right.
fn same(a: ref Option[TreeNode], b: ref Option[TreeNode]) -> bool {
    match (a, b) {
        (None, None) => true,
        (Some(x), Some(y)) => x.val == y.val and same(x.left, y.left) and same(x.right, y.right),
        _ => false,
    }
}

// A copy of the tree with the node numbered i in preorder flipped when
// bit i of mask is set; next numbers the nodes.
fn flip_by_mask(t: ref Option[TreeNode], mask: i64, next: mut ref i64) -> Option[TreeNode] {
    match t {
        None => None,
        Some(node) => {
            let i = *next;
            *next += 1;
            let l = flip_by_mask(node.left, mask, mut next);
            let r = flip_by_mask(node.right, mask, mut next);
            if mask / (1 << i) % 2 == 1 {
                Some(TreeNode { val: node.val, left: r, right: l })
            } else {
                Some(TreeNode { val: node.val, left: l, right: r })
            }
        }
    }
}

// The statement read literally: a flip swaps the two children of a node,
// and the first tree is flip equivalent to the second when some flips
// make it equal to the second. Flips at different nodes can be made in
// any order and a flip made twice undoes itself, so every set of nodes
// to flip is tried.
fn literal(a: ref Option[TreeNode], b: ref Option[TreeNode]) -> bool {
    let n = size(a);
    for mask in 0..(1 << n) {
        let mut next = 0;
        if same(flip_by_mask(a, mask, mut next), b) {
            return true;
        }
    }
    false
}

// depth[v]: the depth of value v, -1 when it is not in the tree
fn depths(t: ref Option[TreeNode], d: i64, depth: mut ref Vec[i64]) {
    if let Some(node) = t {
        depth[node.val] = d;
        depths(node.left, d + 1, mut depth);
        depths(node.right, d + 1, mut depth);
    }
}

fn same_depths(a: ref Option[TreeNode], b: ref Option[TreeNode]) -> bool {
    let mut da: Vec[i64] = Vec.filled(100, -1);
    let mut db: Vec[i64] = Vec.filled(100, -1);
    depths(a, 0, mut da);
    depths(b, 0, mut db);
    da == db
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, a: Option[TreeNode], b: Option[TreeNode], small: bool) -> bool {
    let truth = if small { literal(a, b) } else { false };
    let mut got: Vec[bool] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, a, b));
    }
    // the inputs P3 and P4 share: both trees flipped at random nodes, and
    // both with their values renamed the same way
    let keep = identity();
    let fa = flipped_copy(a, keep, mut seed);
    let fb = flipped_copy(b, keep, mut seed);
    let mut rename = identity();
    for i in 0..100 {
        let j = i + next_random(mut seed) % (100 - i);
        rename.swap(i, j);
    }
    let ra = flipped_copy(a, rename, mut seed);
    let rb = flipped_copy(b, rename, mut seed);
    let depths_match = same_depths(a, b);
    for x in 0..5 {
        let r = got[x];
        // P1: the statement's answer, on the first 3000 pairs
        if small {
            check(mut t, 1, r == truth);
        }
        // P2: each tree flip equivalent to itself, and the answer the same
        // with the trees the other way round
        check(mut t, 2, arm(x, a, a) and arm(x, b, b) and arm(x, b, a) == r);
        // P3: both trees flipped at random nodes, the same
        check(mut t, 3, arm(x, fa, fb) == r);
        // P4: both trees' values renamed the same way, the same
        check(mut t, 4, arm(x, ra, rb) == r);
        // P5: when equivalent, every value at the same depth in both
        check(mut t, 5, not r or depths_match);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == r {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut t = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 951;
    let mut nodes = 0;
    let mut yes = 0;
    let mut check_sum = 0;
    // 3000 pairs of trees of up to 8 nodes, against the statement, then
    // 200 of up to 100 nodes; the second tree of each pair a flipped
    // copy, a flipped copy with two values swapped, a leaf moved or a leaf
    // taken off, or another tree of the same values
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 9 } else { next_random(mut seed) % 101 };
        let values = some_values(n, mut seed);
        let a = random_tree(values, mut seed);
        let kind = next_random(mut seed) % 5;
        let b = partner(a, values, kind, mut seed);
        nodes += n;
        let r = properties(mut t, mut seed, a, b, small);
        let bit = if r { 1 } else { 0 };
        yes += bit;
        check_sum = (check_sum * 31 + bit + 1) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"3200 pairs of trees of {nodes} nodes, {yes} flip equivalent, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
