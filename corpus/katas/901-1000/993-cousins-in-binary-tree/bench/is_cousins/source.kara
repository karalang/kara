// Benchmark: LeetCode #993 Cousins in Binary Tree -- the ★ arm, a
// breadth-first search a level at a time, on random trees of 100 nodes,
// LeetCode's largest. Mirrors is_cousins.c, .rs, .py and go-seq/.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn is_cousins(root: TreeNode, x: i64, y: i64) -> bool {
    let mut level: Vec[(TreeNode, i64)] = vec![(root, -1)];
    while level.len() > 0 {
        let mut px = -1;
        let mut py = -1;
        let mut next: Vec[(TreeNode, i64)] = Vec.new();
        for (node, parent) in level.iter() {
            if node.val == x {
                px = parent;
            }
            if node.val == y {
                py = parent;
            }
            if let Some(l) = node.left {
                next.push((l, node.val));
            }
            if let Some(r) = node.right {
                next.push((r, node.val));
            }
        }
        if px >= 0 and py >= 0 {
            return px != py;
        }
        if px >= 0 or py >= 0 {
            return false;
        }
        level = next;
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn attach(root: TreeNode, node: TreeNode, seed: mut ref i64) {
    let mut cur = root;
    loop {
        if next_random(mut seed) % 2 == 0 {
            match cur.left {
                Some(l) => cur = l,
                None => {
                    cur.left = Some(node);
                    return;
                }
            }
        } else {
            match cur.right {
                Some(r) => cur = r,
                None => {
                    cur.right = Some(node);
                    return;
                }
            }
        }
    }
}

fn random_tree(n: i64, seed: mut ref i64) -> TreeNode {
    let mut vals: Vec[i64] = (1..n + 1).collect();
    let mut i = n - 1;
    while i > 0 {
        let j = next_random(mut seed) % (i + 1);
        let t = vals[i];
        vals[i] = vals[j];
        vals[j] = t;
        i -= 1;
    }
    let root = TreeNode { val: vals[0], left: None, right: None };
    for k in 1..n {
        attach(root, TreeNode { val: vals[k], left: None, right: None }, mut seed);
    }
    root
}

fn main() {
    let rounds = 500;
    let mut seed = 993;
    let mut trees: Vec[TreeNode] = Vec.new();
    for _ in 0..20 {
        trees.push(random_tree(100, mut seed));
    }
    let mut found = 0;
    let mut check = 0;
    for r in 0..rounds {
        for t in 0..20 {
            let d = 1 + (r * 7 + t) % 99;
            for x in 1..101 {
                let y = 1 + (x - 1 + d) % 100;
                let got = is_cousins(trees[(r + t) % 20], x, y);
                if got {
                    found += 1;
                }
                check = (check * 31 + if got { 2 } else { 1 }) % 1000000007;
            }
        }
    }
    println(f"{rounds} rounds over 20 trees of 100 nodes: {found} cousin pairs, checksum {check}");
}
