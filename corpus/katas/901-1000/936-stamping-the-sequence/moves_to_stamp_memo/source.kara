// LeetCode #936: Stamping The Sequence -- the visible layers, by search.
//
// The same reading of the finished string as stamps each showing one
// unbroken run: letter i shows offset j of the stamp on top, and from
// one letter to the next either a new stamp starts at offset 0, on top
// of the one before, the offset steps on, or, once the stamp has shown
// its last letter, a new one is shown from any offset, under it. Search
// from the first letter at offset 0 to the last at offset m - 1, trying
// a new stamp first, and remember each (letter, offset) that fails. Each
// stamp is then placed after every neighbour it lies on: a stamp shown
// from offset 0 lies on the one to its left, any other lies under it.
// O(n m).

fn reach(i: i64, j: i64, s: ref Vec[u8], t: ref Vec[u8], memo: mut ref Vec[Vec[i64]], path: mut ref Vec[i64]) -> bool {
    let m = s.len();
    let n = t.len();
    if t[i] != s[j] {
        return false;
    }
    if i == n - 1 {
        if j == m - 1 {
            path.push(j);
            return true;
        }
        return false;
    }
    if memo[i][j] == 0 {
        return false;
    }
    let mut found = reach(i + 1, 0, s, t, mut memo, mut path);
    if not found and j + 1 < m {
        found = reach(i + 1, j + 1, s, t, mut memo, mut path);
    }
    if not found and j == m - 1 {
        let mut next = 1;
        while not found and next < m {
            found = reach(i + 1, next, s, t, mut memo, mut path);
            next += 1;
        }
    }
    if found {
        path.push(j);
    } else {
        memo[i][j] = 0;
    }
    found
}

fn moves_to_stamp(stamp: String, target: String) -> Vec[i64] {
    let s = stamp.bytes().to_vec();
    let t = target.bytes().to_vec();
    let m = s.len();
    let n = t.len();
    let mut memo: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        memo.push(Vec.filled(m, -1));
    }
    // the offsets shown, last letter first
    let mut path: Vec[i64] = Vec.new();
    if not reach(0, 0, s, t, mut memo, mut path) {
        return Vec.new();
    }
    path.reverse();
    // split the letters into stamps
    let mut starts: Vec[i64] = vec![0];
    let mut shown_from: Vec[i64] = vec![0];
    for i in 1..n {
        if path[i] != path[i - 1] + 1 {
            starts.push(i - path[i]);
            shown_from.push(path[i]);
        }
    }
    // stamp k must come after the neighbours it lies on; take each stamp
    // once nothing it lies on is left to place
    let count = starts.len();
    let mut waiting: Vec[i64] = Vec.filled(count, 0);
    for k in 1..count {
        if shown_from[k] == 0 {
            waiting[k] += 1;
        } else {
            waiting[k - 1] += 1;
        }
    }
    let mut ready: Vec[i64] = Vec.new();
    for k in 0..count {
        if waiting[k] == 0 {
            ready.push(k);
        }
    }
    let mut order: Vec[i64] = Vec.new();
    while ready.len() > 0 {
        let k = ready.pop().unwrap();
        order.push(starts[k]);
        // the right neighbour lies on k when shown from offset 0
        if k + 1 < count and shown_from[k + 1] == 0 {
            waiting[k + 1] -= 1;
            if waiting[k + 1] == 0 {
                ready.push(k + 1);
            }
        }
        // the left neighbour lies on k when k is not shown from offset 0
        if k > 0 and shown_from[k] != 0 {
            waiting[k - 1] -= 1;
            if waiting[k - 1] == 0 {
                ready.push(k - 1);
            }
        }
    }
    order
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// whether stamping `moves` in turn onto n '?'s gives the target, within
// 10 n turns
fn valid(stamp: String, target: String, moves: ref Vec[i64]) -> bool {
    let s = stamp.bytes().to_vec();
    let t = target.bytes().to_vec();
    let m = s.len();
    let n = t.len();
    if moves.len() > 10 * n {
        return false;
    }
    let mut out: Vec[u8] = Vec.filled(n, b'?');
    for p in moves.iter() {
        if *p < 0 or *p > n - m {
            return false;
        }
        for k in 0..m {
            out[*p + k] = s[k];
        }
    }
    out == t
}

fn verdict(stamp: String, target: String) -> String {
    let moves = moves_to_stamp(stamp, target);
    if moves.len() == 0 {
        "cannot be stamped".to_string()
    } else if valid(stamp, target, moves) {
        "stamped".to_string()
    } else {
        "INVALID STAMPS".to_string()
    }
}

fn random_word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    w
}

// a target of n letters made by stamping at random places until no '?'
// is left
fn stamped(seed: mut ref i64, stamp: String, n: i64) -> String {
    let s = stamp.bytes().to_vec();
    let m = s.len();
    let mut out: Vec[u8] = Vec.filled(n, b'?');
    let mut left = n;
    while left > 0 {
        let p = next_random(mut seed) % (n - m + 1);
        for k in 0..m {
            if out[p + k] == b'?' {
                left -= 1;
            }
            out[p + k] = s[k];
        }
    }
    let mut w = String.new();
    for b in out.iter() {
        w.push(*b as char);
    }
    w
}

fn main() {
    // LeetCode's two examples, then a few more
    let cases: Vec[Vec[String]] = vec![
        vec!["abc".to_string(), "ababc".to_string()],
        vec!["abca".to_string(), "aabcaca".to_string()],
        vec!["abc".to_string(), "abc".to_string()],
        vec!["a".to_string(), "aaaa".to_string()],
        vec!["ab".to_string(), "ba".to_string()],
        vec!["abc".to_string(), "abcx".to_string()],
        vec!["aab".to_string(), "aaaab".to_string()],
        vec!["abc".to_string(), "aabcc".to_string()],
        vec!["xyz".to_string(), "xyxyzyz".to_string()],
    ];
    for c in cases.iter() {
        println(f"stamp = {c[0]}, target = {c[1]}: {verdict(c[0], c[1])}");
    }
    // 300 random cases: a stamp of 1 to 5 letters from a, b and c, and a
    // target of up to 60 letters, stamped, stamped with one letter
    // changed, or random
    let mut seed = 936;
    let mut count = 0;
    let mut lengths = 0;
    let mut check = 0;
    for c in 0..300 {
        let m = 1 + next_random(mut seed) % 5;
        let stamp = random_word(mut seed, m, 3);
        let n = m + next_random(mut seed) % (61 - m);
        let mut target = stamped(mut seed, stamp, n);
        if c % 3 == 1 {
            let at = next_random(mut seed) % n;
            let letter = (97 + next_random(mut seed) % 3) as u8;
            let mut b = target.bytes().to_vec();
            b[at] = letter;
            let mut w = String.new();
            for x in b.iter() {
                w.push(*x as char);
            }
            target = w;
        } else if c % 3 == 2 {
            target = random_word(mut seed, n, 3);
        }
        let v = verdict(stamp, target);
        let bit = if v == "stamped" { 1 } else if v == "cannot be stamped" { 0 } else { 2 };
        if bit == 1 {
            count += 1;
        }
        lengths += n;
        check = (check * 31 + n * 3 + bit) % 1000000007;
    }
    println(f"300 random cases: {count} stamped, targets of {lengths} letters, checksum {check}");
    // LeetCode's largest: targets of 1000 letters
    let ones = "a".repeat(1000);
    println(f"stamp a, target of 1000 a's: {verdict("a", ones)}");
    let ten = random_word(mut seed, 10, 3);
    let big = stamped(mut seed, ten, 1000);
    println(f"stamp of 10 letters, target of 1000 stamped at random: {verdict(ten, big)}");
    let half = random_word(mut seed, 500, 2);
    let wide = stamped(mut seed, half, 1000);
    println(f"stamp of 500 letters, target of 1000 stamped at random: {verdict(half, wide)}");
    let spoiled = big.substring(0, 999) + "z";
    println(f"the same target of 1000 ending in z: {verdict(ten, spoiled)}");
}
