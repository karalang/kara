// LeetCode #948: Bag of Tokens -- two priority queues.
//
// The same play as sorting, smallest face up and largest face down, with
// the tokens left unsorted and drawn from two `PriorityQueue`s, one
// giving the smallest first and the other, holding each token negated,
// the largest. A token played from one queue stays in the other and is
// passed over when it comes out; the smallest drawn but not paid for goes
// back. Each token is kept with its index as one number,
// value * 2048 + index, so that the queues order the tokens and tell
// which is which. O(n log n) time.

fn next_unplayed(queue: mut ref PriorityQueue[i64], played: ref Vec[bool], sign: i64) -> i64 {
    while let Some(e) = queue.pop() {
        let key = sign * e;
        if not played[key % 2048] {
            return key;
        }
    }
    -1
}

fn bag_of_tokens_score(tokens: Vec[i64], power: i64) -> i64 {
    let n = tokens.len();
    let mut low: PriorityQueue[i64] = PriorityQueue.new();
    let mut high: PriorityQueue[i64] = PriorityQueue.new();
    for i in 0..n {
        low.push(tokens[i] * 2048 + i);
        high.push(-(tokens[i] * 2048 + i));
    }
    let mut played: Vec[bool] = Vec.filled(n, false);
    let mut left = n;
    let mut p = power;
    let mut score = 0;
    let mut best = 0;
    while left > 0 {
        let cheap = next_unplayed(mut low, played, 1);
        if p >= cheap / 2048 {
            p -= cheap / 2048;
            played[cheap % 2048] = true;
            left -= 1;
            score += 1;
            best = best.max(score);
        } else if score > 0 and left > 1 {
            low.push(cheap);
            let dear = next_unplayed(mut high, played, -1);
            p += dear / 2048;
            played[dear % 2048] = true;
            left -= 1;
            score -= 1;
        } else {
            break;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(tokens: ref Vec[i64]) -> String {
    let mut s = String.new();
    for i in 0..tokens.len() {
        if i > 0 {
            s = s + ",";
        }
        s = s + f"{tokens[i]}";
    }
    f"[{s}]"
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[i64]] = vec![
        vec![100],
        vec![200, 100],
        vec![100, 200, 300, 400],
        Vec.new(),
        vec![0, 0, 0],
        vec![5, 5, 5],
        vec![1, 10, 10, 10, 100],
        vec![100, 200, 300, 400],
    ];
    let powers: Vec[i64] = vec![50, 150, 200, 9999, 0, 5, 1, 1000];
    for i in 0..examples.len() {
        let score = bag_of_tokens_score(examples[i], powers[i]);
        println(f"{show(examples[i])} with power {powers[i]}: score {score}");
    }
    // 300 random bags of 0 to 40 tokens from 0 to 99, power 0 to 199
    let mut seed = 948;
    let mut count = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 41;
        let mut tokens: Vec[i64] = Vec.new();
        for _ in 0..n {
            tokens.push(next_random(mut seed) % 100);
        }
        let power = next_random(mut seed) % 200;
        let score = bag_of_tokens_score(tokens, power);
        count += n;
        total += score;
        check = (check * 31 + score) % 1000000007;
    }
    println(f"300 random bags of {count} tokens: scores adding to {total}, checksum {check}");
    // LeetCode's largest, 1000 tokens
    let mut random: Vec[i64] = Vec.new();
    let mut sum = 0;
    for _ in 0..1000 {
        let v = next_random(mut seed) % 10000;
        random.push(v);
        sum += v;
    }
    println(f"1000 random tokens, power 5000: score {bag_of_tokens_score(random, 5000)}");
    println(f"1000 random tokens, power 0: score {bag_of_tokens_score(random, 0)}");
    println(f"1000 random tokens, power their sum {sum}: score {bag_of_tokens_score(random, sum)}");
    let mut rising: Vec[i64] = Vec.new();
    for i in 0..1000 {
        rising.push(i + 1);
    }
    println(f"tokens 1 to 1000, power 1: score {bag_of_tokens_score(rising, 1)}");
    let mut same: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        same.push(9999);
    }
    println(f"1000 tokens of 9999, power 9999: score {bag_of_tokens_score(same, 9999)}");
}
