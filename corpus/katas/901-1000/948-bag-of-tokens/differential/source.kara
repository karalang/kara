// LeetCode #948: Bag of Tokens -- differential test of the five arms
// against the statement read literally, with six properties.
//
// The statement: you start with an initial power of power, an initial
// score of 0, and a bag of tokens given as an integer array tokens, where
// each tokens[i] denotes the value of token i. In one move, you can play
// an unplayed token in one of the two ways (but not both for the same
// token): face-up, if your current power is at least tokens[i], losing
// tokens[i] power and gaining 1 score; face-down, if your current score is
// at least 1, gaining tokens[i] power and losing 1 score. Return the
// maximum possible score you can achieve after playing any number of
// tokens.

// ---- the ★ arm: sorted, played from both ends -----------------------------
fn star_bag_of_tokens_score(tokens: Vec[i64], power: i64) -> i64 {
    let mut t = tokens.clone();
    t.sort();
    let mut lo = 0;
    let mut hi = t.len() - 1;
    let mut p = power;
    let mut score = 0;
    let mut best = 0;
    while lo <= hi {
        if p >= t[lo] {
            p -= t[lo];
            lo += 1;
            score += 1;
            best = best.max(score);
        } else if score > 0 and lo < hi {
            p += t[hi];
            hi -= 1;
            score -= 1;
        } else {
            break;
        }
    }
    best
}

// ---- the prefix arm: a count for each number face down --------------------
fn prefix_bag_of_tokens_score(tokens: Vec[i64], power: i64) -> i64 {
    let mut t = tokens.clone();
    t.sort();
    let n = t.len();
    if n == 0 or power < t[0] {
        return 0;
    }
    let mut sums: Vec[i64] = vec![0];
    for v in t.iter() {
        sums.push(sums[sums.len() - 1] + *v);
    }
    let mut best = 0;
    let mut limit = power;
    let mut k = 0;
    for j in 0..n {
        k = k.min(n - j);
        while k < n - j and sums[k + 1] <= limit {
            k += 1;
        }
        best = best.max(k - j);
        limit += t[n - 1 - j];
    }
    best
}

// ---- the heaps arm: two priority queues -----------------------------------
fn heaps_next_unplayed(queue: mut ref PriorityQueue[i64], played: ref Vec[bool], sign: i64) -> i64 {
    while let Some(e) = queue.pop() {
        let key = sign * e;
        if not played[key % 2048] {
            return key;
        }
    }
    -1
}

fn heaps_bag_of_tokens_score(tokens: Vec[i64], power: i64) -> i64 {
    let n = tokens.len();
    let mut low: PriorityQueue[i64] = PriorityQueue.new();
    let mut high: PriorityQueue[i64] = PriorityQueue.new();
    for i in 0..n {
        low.push(tokens[i] * 2048 + i);
        high.push(-(tokens[i] * 2048 + i));
    }
    let mut played: Vec[bool] = Vec.filled(n, false);
    let mut left = n;
    let mut p = power;
    let mut score = 0;
    let mut best = 0;
    while left > 0 {
        let cheap = heaps_next_unplayed(mut low, played, 1);
        if p >= cheap / 2048 {
            p -= cheap / 2048;
            played[cheap % 2048] = true;
            left -= 1;
            score += 1;
            best = best.max(score);
        } else if score > 0 and left > 1 {
            low.push(cheap);
            let dear = heaps_next_unplayed(mut high, played, -1);
            p += dear / 2048;
            played[dear % 2048] = true;
            left -= 1;
            score -= 1;
        } else {
            break;
        }
    }
    best
}

// ---- the counts arm: tokens counted by value ------------------------------
fn counts_bag_of_tokens_score(tokens: Vec[i64], power: i64) -> i64 {
    let mut top = 0;
    for v in tokens.iter() {
        top = top.max(*v);
    }
    let mut count: Vec[i64] = Vec.filled(top + 1, 0);
    for v in tokens.iter() {
        count[*v] += 1;
    }
    let mut lo = 0;
    let mut hi = top;
    let mut left = tokens.len();
    let mut p = power;
    let mut score = 0;
    let mut best = 0;
    while left > 0 {
        while count[lo] == 0 {
            lo += 1;
        }
        while count[hi] == 0 {
            hi -= 1;
        }
        if p >= lo {
            p -= lo;
            count[lo] -= 1;
            left -= 1;
            score += 1;
            best = best.max(score);
        } else if score > 0 and left > 1 {
            p += hi;
            count[hi] -= 1;
            left -= 1;
            score -= 1;
        } else {
            break;
        }
    }
    best
}

// ---- the grid arm: every count of plays each way --------------------------
fn grid_bag_of_tokens_score(tokens: Vec[i64], power: i64) -> i64 {
    let mut t = tokens.clone();
    t.sort();
    let n = t.len();
    let mut row: Vec[i64] = Vec.filled(n + 1, -1);
    row[0] = power;
    let mut best = 0;
    for k in 0..(n + 1) {
        for j in 0..n {
            if row[j] >= 0 and k - j >= 1 and k + j + 1 <= n {
                row[j + 1] = row[j + 1].max(row[j] + t[n - 1 - j]);
            }
        }
        for j in 0..(n + 1) {
            if row[j] >= 0 {
                best = best.max(k - j);
            }
        }
        if k < n {
            let mut next: Vec[i64] = Vec.filled(n + 1, -1);
            for j in 0..(n - k) {
                if row[j] >= t[k] {
                    next[j] = row[j] - t[k];
                }
            }
            row = next;
        }
    }
    best
}

// ---- the differential -----------------------------------------------------

fn arm(x: i64, tokens: Vec[i64], power: i64) -> i64 {
    if x == 0 {
        star_bag_of_tokens_score(tokens, power)
    } else if x == 1 {
        prefix_bag_of_tokens_score(tokens, power)
    } else if x == 2 {
        heaps_bag_of_tokens_score(tokens, power)
    } else if x == 3 {
        counts_bag_of_tokens_score(tokens, power)
    } else {
        grid_bag_of_tokens_score(tokens, power)
    }
}

// The statement read literally: every sequence of moves, each playing an
// unplayed token face up when the power is at least its value, or face
// down when the score is at least 1, and the highest score any of them
// reaches. A position is which tokens were played which way, one base-3
// digit each, and every position reached is searched from once.
fn literal(tokens: ref Vec[i64], power: i64) -> i64 {
    let n = tokens.len();
    let mut states = 1;
    for _ in 0..n {
        states *= 3;
    }
    let mut seen: Vec[bool] = Vec.filled(states, false);
    let mut stack: Vec[i64] = vec![0];
    seen[0] = true;
    let mut best = 0;
    while let Some(s) = stack.pop() {
        let mut p = power;
        let mut score = 0;
        let mut rest = s;
        for i in 0..n {
            let d = rest % 3;
            rest /= 3;
            if d == 1 {
                p -= tokens[i];
                score += 1;
            } else if d == 2 {
                p += tokens[i];
                score -= 1;
            }
        }
        best = best.max(score);
        let mut place = 1;
        for i in 0..n {
            if s / place % 3 == 0 {
                if p >= tokens[i] and not seen[s + place] {
                    seen[s + place] = true;
                    stack.push(s + place);
                }
                if score >= 1 and not seen[s + 2 * place] {
                    seen[s + 2 * place] = true;
                    stack.push(s + 2 * place);
                }
            }
            place *= 3;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(t: mut ref Tally, seed: mut ref i64, tokens: Vec[i64], power: i64, small: bool) -> i64 {
    let n = tokens.len();
    let truth = if small { literal(tokens, power) } else { 0 };
    let mut got: Vec[i64] = Vec.new();
    for x in 0..5 {
        got.push(arm(x, tokens, power));
    }
    // the most of the smallest tokens the power pays for, all face up
    let mut sorted = tokens.clone();
    sorted.sort();
    let mut up = 0;
    let mut spent = 0;
    while up < n and spent + sorted[up] <= power {
        spent += sorted[up];
        up += 1;
    }
    let mut sum = 0;
    let mut top = 0;
    for v in tokens.iter() {
        sum += *v;
        top = top.max(*v);
    }
    // the inputs P3 to P5 share: the tokens shuffled, each and the power
    // times 3; more power; one more token of 0, and one more at random
    let mut tripled: Vec[i64] = Vec.new();
    for v in tokens.iter() {
        tripled.push(*v * 3);
    }
    for i in 0..n {
        let j = i + next_random(mut seed) % (n - i);
        tripled.swap(i, j);
    }
    let extra = next_random(mut seed) % (top + 1);
    let mut zero = tokens.clone();
    zero.push(0);
    let mut more = tokens.clone();
    more.push(next_random(mut seed) % (top + 2));
    for x in 0..5 {
        let m = got[x];
        // P1: the statement's highest score, on the small bags
        if small {
            check(mut t, 1, m == truth);
        }
        // P2: from the smallest tokens the power pays for to every token,
        // and at least 1 exactly when the smallest token can be played
        check(mut t, 2, m >= up and m <= n and ((m >= 1) == (n >= 1 and power >= sorted[0])));
        // P3: shuffled, every value times 3, the same
        check(mut t, 3, arm(x, tripled, power * 3) == m);
        // P4: more power never less, and power for every token gives n
        check(mut t, 4, arm(x, tokens, power + extra) >= m and arm(x, tokens, sum) == n);
        // P5: a token of 0 gives exactly one more when the smallest token
        // could already be played, and at least one more when it could
        // not; a random one never fewer
        let z = arm(x, zero, power);
        let playable = n >= 1 and power >= sorted[0];
        check(mut t, 5, (z == m + 1 or (not playable and z > m)) and arm(x, more, power) >= m);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for y in 0..5 {
            if y != x and got[y] == m {
                agree += 1;
            }
        }
        check(mut t, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut t = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 948;
    let mut bags = 0;
    let mut count = 0;
    let mut total = 0;
    let mut check_sum = 0;
    // up to 6 tokens from 0 to 9 and power up to 15 against the statement,
    // then up to 300 tokens from 0 to as much as 9999, power up to twice
    // that
    for c in 0..3200 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 7 } else { next_random(mut seed) % 301 };
        let range = if small { 10 } else { 1 + next_random(mut seed) % 10000 };
        let mut tokens: Vec[i64] = Vec.new();
        for _ in 0..n {
            tokens.push(next_random(mut seed) % range);
        }
        let power = if small { next_random(mut seed) % 16 } else { next_random(mut seed) % (2 * range) };
        bags += 1;
        count += n;
        let m = properties(mut t, mut seed, tokens, power, small);
        total += m;
        check_sum = (check_sum * 1000003 + m) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += t.failures[p];
        if t.failures[p] > 0 {
            by = by + f" P{p + 1} {t.failures[p]}";
        }
    }
    println(f"{bags} bags of {count} tokens, scores adding to {total}, checksum {check_sum}, {t.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
