// LeetCode #975: Odd Even Jump -- a segment tree over values.
//
// The values are replaced by their ranks among the distinct values, and
// a tree over the ranks, its leaves a power of two, each node counting
// the ranks present below it, finds the first present rank at or above
// r and the last at or below it by walking down. Walking from the
// right, each index marks its rank present and records itself as that
// rank's leftmost index. O(n log n).

fn first_at_or_above(tree: ref Vec[i64], v: i64, node: i64, lo: i64, hi: i64) -> i64 {
    if tree[node] == 0 or hi <= v {
        return -1;
    }
    if hi - lo == 1 {
        return lo;
    }
    let mid = (lo + hi) / 2;
    let left = first_at_or_above(tree, v, 2 * node, lo, mid);
    if left >= 0 { left } else { first_at_or_above(tree, v, 2 * node + 1, mid, hi) }
}

fn last_at_or_below(tree: ref Vec[i64], v: i64, node: i64, lo: i64, hi: i64) -> i64 {
    if tree[node] == 0 or lo > v {
        return -1;
    }
    if hi - lo == 1 {
        return lo;
    }
    let mid = (lo + hi) / 2;
    let right = last_at_or_below(tree, v, 2 * node + 1, mid, hi);
    if right >= 0 { right } else { last_at_or_below(tree, v, 2 * node, lo, mid) }
}

fn mark(tree: mut ref Vec[i64], size: i64, v: i64) {
    let mut node = size + v;
    if tree[node] == 0 {
        while node >= 1 {
            tree[node] += 1;
            node /= 2;
        }
    }
}

fn odd_even_jumps(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut values = arr.clone();
    values.sort();
    values.dedup();
    let mut rank: Vec[i64] = Vec.new();
    for v in arr {
        rank.push(values.binary_search(v).unwrap());
    }
    let mut size = 1;
    while size < values.len() {
        size *= 2;
    }
    let mut tree = Vec.filled(2 * size, 0);
    let mut at = Vec.filled(size, -1);
    let mut higher = Vec.filled(n, false);
    let mut lower = Vec.filled(n, false);
    higher[n - 1] = true;
    lower[n - 1] = true;
    mark(mut tree, size, rank[n - 1]);
    at[rank[n - 1]] = n - 1;
    let mut good = 1;
    for i in (0..n - 1).rev() {
        let up = first_at_or_above(tree, rank[i], 1, 0, size);
        if up >= 0 {
            higher[i] = lower[at[up]];
        }
        let down = last_at_or_below(tree, rank[i], 1, 0, size);
        if down >= 0 {
            lower[i] = higher[at[down]];
        }
        mark(mut tree, size, rank[i]);
        at[rank[i]] = i;
        if higher[i] {
            good += 1;
        }
    }
    good
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_arr(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push(next_random(mut seed) % top);
    }
    arr
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[Vec[i64]] = vec![
        vec![10, 13, 12, 14, 15],
        vec![2, 3, 1, 1, 4],
        vec![5, 1, 3, 4, 2],
        vec![7],
        vec![1, 1, 1, 1],
        vec![1, 2, 3, 4, 5],
        vec![5, 4, 3, 2, 1],
        vec![0, 99999, 0, 99999],
        vec![3, 1, 2, 3, 1, 2],
        vec![1, 3, 2, 3, 1],
    ];
    for arr in cases {
        println(f"{arr}: {odd_even_jumps(arr)}");
    }
    // random arrays: 300 small, 3000 longer, then 20 of 2000 values
    let mut seed = 975;
    for (count, most, top) in vec![(300, 12, 5), (3000, 60, 1000), (20, 2000, 100000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if most == 2000 { most } else { 1 + next_random(mut seed) % most };
            let arr = random_arr(n, top, mut seed);
            let good = odd_even_jumps(arr);
            total += good;
            check = (check * 31 + good) % 1000000007;
        }
        println(f"{count} random arrays of up to {most} values: {total} good starts, checksum {check}");
    }
}
