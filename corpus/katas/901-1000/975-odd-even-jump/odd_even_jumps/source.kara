// LeetCode #975: Odd Even Jump -- a sorted map, right to left.
//
// From index i an odd-numbered jump lands on the nearest value at or
// above arr[i] to its right, an even-numbered one on the nearest at or
// below, the leftmost on a tie. Walking from the right, a `SortedMap`
// from value to the leftmost index seen so far answers both with
// `ceiling` and `floor`, since a later insert of the same value comes
// from further left and replaces the index. Then higher[i], whether
// the end is reachable starting with an odd jump at i, is lower[] at
// the odd jump's landing place, and lower[i] is higher[] at the even
// jump's. The good starting indices are those with higher[i], since
// the first jump is odd. O(n log n).

fn odd_even_jumps(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut higher = Vec.filled(n, false);
    let mut lower = Vec.filled(n, false);
    higher[n - 1] = true;
    lower[n - 1] = true;
    let mut seen: SortedMap[i64, i64] = SortedMap.new();
    seen.insert(arr[n - 1], n - 1);
    let mut good = 1;
    for i in (0..n - 1).rev() {
        if let Some((_, j)) = seen.ceiling(arr[i]) {
            higher[i] = lower[j];
        }
        if let Some((_, j)) = seen.floor(arr[i]) {
            lower[i] = higher[j];
        }
        seen.insert(arr[i], i);
        if higher[i] {
            good += 1;
        }
    }
    good
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_arr(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push(next_random(mut seed) % top);
    }
    arr
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[Vec[i64]] = vec![
        vec![10, 13, 12, 14, 15],
        vec![2, 3, 1, 1, 4],
        vec![5, 1, 3, 4, 2],
        vec![7],
        vec![1, 1, 1, 1],
        vec![1, 2, 3, 4, 5],
        vec![5, 4, 3, 2, 1],
        vec![0, 99999, 0, 99999],
        vec![3, 1, 2, 3, 1, 2],
        vec![1, 3, 2, 3, 1],
    ];
    for arr in cases {
        println(f"{arr}: {odd_even_jumps(arr)}");
    }
    // random arrays: 300 small, 3000 longer, then 20 of 2000 values
    let mut seed = 975;
    for (count, most, top) in vec![(300, 12, 5), (3000, 60, 1000), (20, 2000, 100000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if most == 2000 { most } else { 1 + next_random(mut seed) % most };
            let arr = random_arr(n, top, mut seed);
            let good = odd_even_jumps(arr);
            total += good;
            check = (check * 31 + good) % 1000000007;
        }
        println(f"{count} random arrays of up to {most} values: {total} good starts, checksum {check}");
    }
}
