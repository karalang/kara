// LeetCode #975: Odd Even Jump -- sorted order and a monotonic stack.
//
// The odd jump from i goes to the first index after i in the order of
// (value, index); sorting the indices that way and pushing them onto a
// stack, each index popped by a later, larger one in that order
// learns its jump target. The even jump is the same over the order of
// (-value, index). Then the same reachability as the sorted-map arm,
// from the right. O(n log n).

fn next_in(order: ref Vec[i64], n: i64) -> Vec[i64] {
    let mut next = Vec.filled(n, -1);
    let mut stack: Vec[i64] = Vec.new();
    for i in order {
        while stack.len() > 0 and *stack.last().unwrap() < *i {
            next[stack.pop().unwrap()] = *i;
        }
        stack.push(*i);
    }
    next
}

fn odd_even_jumps(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut up: Vec[i64] = (0..n).collect();
    up.sort_by_key(|i| (arr[i], i));
    let mut down: Vec[i64] = (0..n).collect();
    down.sort_by_key(|i| (-arr[i], i));
    let odd = next_in(up, n);
    let even = next_in(down, n);
    let mut higher = Vec.filled(n, false);
    let mut lower = Vec.filled(n, false);
    higher[n - 1] = true;
    lower[n - 1] = true;
    for i in (0..n - 1).rev() {
        if odd[i] >= 0 {
            higher[i] = lower[odd[i]];
        }
        if even[i] >= 0 {
            lower[i] = higher[even[i]];
        }
    }
    higher.iter().filter(|h| *h).count()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_arr(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push(next_random(mut seed) % top);
    }
    arr
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[Vec[i64]] = vec![
        vec![10, 13, 12, 14, 15],
        vec![2, 3, 1, 1, 4],
        vec![5, 1, 3, 4, 2],
        vec![7],
        vec![1, 1, 1, 1],
        vec![1, 2, 3, 4, 5],
        vec![5, 4, 3, 2, 1],
        vec![0, 99999, 0, 99999],
        vec![3, 1, 2, 3, 1, 2],
        vec![1, 3, 2, 3, 1],
    ];
    for arr in cases {
        println(f"{arr}: {odd_even_jumps(arr)}");
    }
    // random arrays: 300 small, 3000 longer, then 20 of 2000 values
    let mut seed = 975;
    for (count, most, top) in vec![(300, 12, 5), (3000, 60, 1000), (20, 2000, 100000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if most == 2000 { most } else { 1 + next_random(mut seed) % most };
            let arr = random_arr(n, top, mut seed);
            let good = odd_even_jumps(arr);
            total += good;
            check = (check * 31 + good) % 1000000007;
        }
        println(f"{count} random arrays of up to {most} values: {total} good starts, checksum {check}");
    }
}
