// LeetCode #974: Subarray Sums Divisible by K -- divide and conquer.
//
// The subarrays of nums[lo..hi] lie in its left half, in its right
// half, or cross the middle. A crossing one is a suffix of the left
// half, of remainder a, joined to a prefix of the right half, of
// remainder b, and its sum is divisible by k when a + b is: count the
// suffix remainders in a table, match each prefix remainder b with the
// suffixes of remainder (k - b) % k, then walk the suffixes again to
// empty the table for the next call. One table serves every call, so
// O(n log n + k).

fn count(nums: ref Vec[i64], lo: i64, hi: i64, k: i64, table: mut ref Vec[i64]) -> i64 {
    if hi - lo == 1 {
        return if nums[lo] % k == 0 { 1 } else { 0 };
    }
    let mid = (lo + hi) / 2;
    let mut sum = 0;
    for i in (lo..mid).rev() {
        sum += nums[i];
        table[(sum % k + k) % k] += 1;
    }
    let mut crossing = 0;
    sum = 0;
    for j in mid..hi {
        sum += nums[j];
        let b = (sum % k + k) % k;
        crossing += table[(k - b) % k];
    }
    sum = 0;
    for i in (lo..mid).rev() {
        sum += nums[i];
        table[(sum % k + k) % k] -= 1;
    }
    count(nums, lo, mid, k, mut table) + count(nums, mid, hi, k, mut table) + crossing
}

fn subarrays_div_by_k(nums: Vec[i64], k: i64) -> i64 {
    let mut table = Vec.filled(k, 0);
    count(nums, 0, nums.len(), k, mut table)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(n: i64, span: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(next_random(mut seed) % (2 * span + 1) - span);
    }
    nums
}

fn main() {
    // LeetCode's two examples, then a few more
    let cases: Vec[(Vec[i64], i64)] = vec![
        (vec![4, 5, 0, -2, -3, 1], 5),
        (vec![5], 9),
        (vec![0, 0, 0], 2),
        (vec![-1, 2, 9], 2),
        (vec![7, -7], 7),
        (vec![-5, -5, -5], 5),
        (vec![-3, 1, -1, 3], 4),
        (vec![10000, -10000, 10000], 10000),
        (vec![1, 2, 3], 10000),
        (vec![2, -2, 2, -2], 3),
    ];
    for (nums, k) in cases {
        println(f"{nums} with k = {k}: {subarrays_div_by_k(nums, k)}");
    }
    // random cases: 300 small, 3000 longer, then 4 of 30000 numbers
    let mut seed = 974;
    for (count, most, span, top) in vec![(300, 12, 10, 6), (3000, 60, 10000, 50), (4, 30000, 10000, 10000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = if most == 30000 { most } else { 1 + next_random(mut seed) % most };
            let nums = random_nums(n, span, mut seed);
            let k = 2 + next_random(mut seed) % (top - 1);
            let got = subarrays_div_by_k(nums, k);
            total += got;
            check = (check * 31 + got) % 1000000007;
        }
        println(f"{count} random cases of up to {most} numbers: {total} subarrays, checksum {check}");
    }
}
