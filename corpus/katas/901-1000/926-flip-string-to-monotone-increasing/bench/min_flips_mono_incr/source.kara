// LeetCode #926: Flip String to Monotone Increasing -- bench: one pass.
//
// Read left to right, keeping the fewest flips that make the prefix
// monotone and the number of 1s in it. A 1 can always stay. A 0 either
// flips to 1, one more flip than before, or stays, and then every 1
// before it must flip to 0. O(n), O(1) space.

fn min_flips_mono_incr(s: String) -> i64 {
    let mut flips = 0;
    let mut ones = 0;
    for c in s.bytes() {
        if c == b'1' {
            ones += 1;
        } else {
            flips = (flips + 1).min(ones);
        }
    }
    flips
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let rounds = 20;
    let count = 100;
    let n = 100000;
    let mut seed = 926;
    // count strings of n characters, built once, leaning from 0 to 1
    let mut strings: Vec[String] = Vec.new();
    for i in 0..count {
        let lean = i % 101;
        let mut b: Vec[u8] = Vec.new();
        for _ in 0..n {
            b.push(if next_random(mut seed) % 100 < lean { b'1' } else { b'0' });
        }
        strings.push(String.from_utf8(b).unwrap());
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        // each round visits every string, starting from a different one
        for i in 0..count {
            let a = min_flips_mono_incr(strings[(r + i) % count]);
            total += a;
            check = (check * 1000003 + a) % 1000000007;
        }
    }
    println(f"{rounds} rounds over {count} strings of {n}: answers summing to {total}, checksum {check}");
}
