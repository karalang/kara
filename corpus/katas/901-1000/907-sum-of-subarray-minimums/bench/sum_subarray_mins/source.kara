// LeetCode #907: Sum of Subarray Minimums -- bench program.
//
// The ★ arm (how far each element reaches) over 1,000,000 numbers from 1
// to 30000 built once. Each round sums the subarray minimums, folds the
// sum into a checksum and changes one number.

fn sum_subarray_mins(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut right: Vec[i64] = Vec.filled(n, 0);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while stack.len() > 0 and arr[stack[stack.len() - 1]] >= arr[i] {
            stack.pop();
        }
        left[i] = if stack.len() > 0 { i - stack[stack.len() - 1] } else { i + 1 };
        stack.push(i);
    }
    stack.clear();
    for k in 0..n {
        let i = n - 1 - k;
        while stack.len() > 0 and arr[stack[stack.len() - 1]] > arr[i] {
            stack.pop();
        }
        right[i] = if stack.len() > 0 { stack[stack.len() - 1] - i } else { n - i };
        stack.push(i);
    }
    let mut total = 0;
    for i in 0..n {
        total = (total + arr[i] * left[i] % 1000000007 * right[i]) % 1000000007;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 1000000;
    let rounds = 40;
    let mut seed = 907;
    let mut arr: Vec[i64] = Vec.new();
    for _ in 0..n {
        arr.push(1 + next_random(mut seed) % 30000);
    }
    let mut check = 0;
    for round in 0..rounds {
        let got = sum_subarray_mins(arr);
        check = (check * 31 + got) % 1000000007;
        arr[round * 7919 % n] = 1 + next_random(mut seed) % 30000;
    }
    println(f"{rounds} rounds over {n} numbers: checksum {check}");
}
