// LeetCode #907: Sum of Subarray Minimums -- the largest elements first.
//
// Switch the elements on from the largest down, ties from the right, and
// keep the runs of switched-on elements joined. When element i comes on,
// every element in the runs touching it is larger, or equal and to its
// right, so i is the leftmost smallest element of exactly the subarrays
// made of part of the left run, i and part of the right run: arr[i] times
// (left length + 1) times (right length + 1). Each run keeps its length
// at both of its ends. O(n log n) for the sort.

fn sum_subarray_mins(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut order: Vec[i64] = Vec.new();
    for i in 0..n {
        order.push(i);
    }
    // largest first, and of equal values the rightmost first
    order.sort_by_key(|i| -(arr[i] * (n + 1) + i));
    // reach[i]: for an end of a run, the run's length; 0 for an element
    // still off
    let mut reach: Vec[i64] = Vec.filled(n, 0);
    let mut total = 0;
    for i in order.iter() {
        let at = *i;
        let left = if at > 0 { reach[at - 1] } else { 0 };
        let right = if at + 1 < n { reach[at + 1] } else { 0 };
        total = (total + arr[at] * (left + 1) % 1000000007 * (right + 1)) % 1000000007;
        let length = left + right + 1;
        reach[at - left] = length;
        reach[at + right] = length;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(arr: Vec[i64]) {
    let mut listed = String.new();
    for i in 0..arr.len() {
        if i > 0 {
            listed.push_str(",");
        }
        listed.push_str(f"{arr[i]}");
    }
    println(f"arr = [{listed}] -> {sum_subarray_mins(arr)}");
}

fn main() {
    show(vec![3, 1, 2, 4]);
    show(vec![11, 81, 94, 43, 3]);
    show(vec![1]);
    show(vec![2, 2, 2]);
    show(vec![1, 2, 3, 4, 5]);
    show(vec![5, 4, 3, 2, 1]);
    show(vec![3, 1, 3, 1, 3]);
    show(vec![30000, 1, 30000]);
    // random cases of up to 1000 numbers up to 3, 100 or 30000
    let mut seed = 907;
    let mut check = 0;
    for c in 0..300 {
        let len = 1 + next_random(mut seed) % 1000;
        let top = if c % 3 == 0 { 3 } else if c % 3 == 1 { 100 } else { 30000 };
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..len {
            arr.push(1 + next_random(mut seed) % top);
        }
        check = (check * 1000003 + sum_subarray_mins(arr)) % 1000000007;
    }
    println(f"300 cases: checksum {check}");
    // LeetCode's largest: 30000 random numbers, 1 to 30000 rising, and
    // 30000 copies of 30000
    let mut random: Vec[i64] = Vec.new();
    let mut rising: Vec[i64] = Vec.new();
    let mut flat: Vec[i64] = Vec.new();
    for i in 0..30000 {
        random.push(1 + next_random(mut seed) % 30000);
        rising.push(i + 1);
        flat.push(30000);
    }
    println(f"30000 random numbers -> {sum_subarray_mins(random)}");
    println(f"1 to 30000 rising -> {sum_subarray_mins(rising)}");
    println(f"30000 copies of 30000 -> {sum_subarray_mins(flat)}");
}
