// LeetCode #910: Smallest Range II -- raising the lowest value, with a
// heap.
//
// Start with every value moved down and keep them in a min-first heap,
// with the largest known. The range is the largest less the heap's top.
// To do better the top must rise, and the only way is to move that value
// up instead: pop it, push its raised value and update the largest. A
// value that was already moved up cannot rise again, and then no later
// range can be narrower, so stop. O(n log n).

fn smallest_range_ii(nums: Vec[i64], k: i64) -> i64 {
    let mut heap: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut largest = nums[0] - k;
    for i in 0..nums.len() {
        heap.push((nums[i] - k, i));
        largest = largest.max(nums[i] - k);
    }
    let mut best = -1;
    loop {
        let (low, i) = heap.pop().unwrap();
        if best == -1 or largest - low < best {
            best = largest - low;
        }
        if low != nums[i] - k or k == 0 {
            return best;
        }
        heap.push((nums[i] + k, i));
        largest = largest.max(nums[i] + k);
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], k: i64) {
    let mut listed = String.new();
    for i in 0..nums.len() {
        if i > 0 {
            listed.push_str(",");
        }
        listed.push_str(f"{nums[i]}");
    }
    println(f"nums = [{listed}], k = {k} -> {smallest_range_ii(nums, k)}");
}

fn main() {
    show(vec![1], 0);
    show(vec![0, 10], 2);
    show(vec![1, 3, 6], 3);
    show(vec![7, 7, 7], 0);
    show(vec![0, 10000], 0);
    show(vec![0, 10000], 10000);
    show(vec![2, 9, 4, 13, 5], 2);
    show(vec![2, 9, 4, 13, 5], 5);
    // random cases of up to 2000 numbers below 10, 1000 or 10001, with k
    // up to 10000
    let mut seed = 910;
    let mut sum = 0;
    let mut check = 0;
    for c in 0..300 {
        let len = 1 + next_random(mut seed) % 2000;
        let top = if c % 3 == 0 { 10 } else if c % 3 == 1 { 1000 } else { 10001 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..len {
            nums.push(next_random(mut seed) % top);
        }
        let k = next_random(mut seed) % (top / 2 + 1);
        let got = smallest_range_ii(nums, k);
        sum += got;
        check = (check * 1000003 + got) % 1000000007;
    }
    println(f"300 cases: scores summing to {sum}, checksum {check}");
    // LeetCode's largest: 10^4 numbers up to 10^4, with k = 0 and k = 2500
    let mut big: Vec[i64] = Vec.new();
    for _ in 0..10000 {
        big.push(next_random(mut seed) % 10001);
    }
    println(f"10000 numbers, k = 0 -> {smallest_range_ii(big, 0)}");
    println(f"10000 numbers, k = 2500 -> {smallest_range_ii(big, 2500)}");
}
