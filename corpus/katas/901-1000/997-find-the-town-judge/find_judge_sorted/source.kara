// LeetCode #997: Find the Town Judge -- runs in sorted lists
//
// The trusted people sorted, each person's trusters form a run; a run
// of n - 1 names the only possible judge, who must then not appear in
// the sorted list of the trusting, found by binary search. O(m log m).

fn find_judge(n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    // the trusted, sorted, so that each person's trusters form a run
    let mut trusted: Vec[i64] = trust.iter().map(|t| t[1]).collect();
    trusted.sort();
    let mut trusting: Vec[i64] = trust.iter().map(|t| t[0]).collect();
    trusting.sort();
    let mut found = -1;
    if n == 1 {
        found = 1;
    }
    let mut i = 0;
    while i < trusted.len() {
        let mut j = i;
        while j < trusted.len() and trusted[j] == trusted[i] {
            j += 1;
        }
        if j - i == n - 1 {
            found = trusted[i];
        }
        i = j;
    }
    if found < 0 {
        return -1;
    }
    // the judge must not be among the trusting, found by binary search
    let mut lo = 0;
    let mut hi = trusting.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if trusting[mid] < found {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < trusting.len() and trusting[lo] == found {
        return -1;
    }
    found
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn add(pairs: mut ref Vec[Vec[i64]], seen: mut ref Set[i64], a: i64, b: i64) {
    if a != b and not seen.contains(a * 2000 + b) {
        seen.insert(a * 2000 + b);
        pairs.push(vec![a, b]);
    }
}

// n people and a list of trusts: half the time a judge everyone else
// trusts, with a third of those spoiled by one trust taken away or one
// trust from the judge, and other trusts at random, in random order
fn random_town(n: i64, extra: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    let mut seen: Set[i64] = Set.new();
    let mut judge = 0;
    if next_random(mut seed) % 2 == 0 {
        judge = 1 + next_random(mut seed) % n;
        for p in 1..n + 1 {
            add(mut pairs, mut seen, p, judge);
        }
    }
    for _ in 0..extra {
        let a = 1 + next_random(mut seed) % n;
        let b = 1 + next_random(mut seed) % n;
        if a != judge {
            add(mut pairs, mut seen, a, b);
        }
    }
    if judge > 0 and n > 1 {
        let spoil = next_random(mut seed) % 6;
        if spoil == 0 {
            pairs.remove(next_random(mut seed) % (n - 1));
        } else if spoil == 1 {
            let other = 1 + next_random(mut seed) % n;
            if other != judge {
                pairs.push(vec![judge, other]);
            }
        }
    }
    let mut i = pairs.len() - 1;
    while i > 0 {
        let j = next_random(mut seed) % (i + 1);
        let t = pairs[i].clone();
        pairs[i] = pairs[j].clone();
        pairs[j] = t;
        i -= 1;
    }
    pairs
}

fn trust_text(trust: ref Vec[Vec[i64]]) -> String {
    let parts: Vec[String] = trust.iter().map(|t| f"[{t[0]},{t[1]}]").collect();
    "[" + parts.join(",") + "]"
}

fn main() {
    // LeetCode's three examples, then a few more
    let cases: Vec[(i64, Vec[Vec[i64]])] = vec![
        (2, vec![vec![1, 2]]),
        (3, vec![vec![1, 3], vec![2, 3]]),
        (3, vec![vec![1, 3], vec![2, 3], vec![3, 1]]),
        (1, Vec.new()),
        (2, Vec.new()),
        (2, vec![vec![1, 2], vec![2, 1]]),
        (4, vec![vec![1, 3], vec![1, 4], vec![2, 3], vec![2, 4], vec![4, 3]]),
        (3, vec![vec![1, 2], vec![2, 3]]),
        (4, vec![vec![1, 4], vec![2, 4]]),
        (3, vec![vec![1, 2], vec![3, 2], vec![1, 3]]),
    ];
    for (n, trust) in cases.iter() {
        println(f"n = {n}, trust = {trust_text(trust)} -> {find_judge(n, trust)}");
    }
    let mut everyone: Vec[Vec[i64]] = Vec.new();
    for p in 1..1001 {
        if p != 500 {
            everyone.push(vec![p, 500]);
        }
    }
    println(f"1000 people, all trusting 500: {find_judge(1000, everyone)}");
    let mut back = everyone.clone();
    back.push(vec![500, 1]);
    println(f"1000 people, all trusting 500, and 500 trusting 1: {find_judge(1000, back)}");
    println(f"1000 people, no trust: {find_judge(1000, Vec.new())}");
    let mut short = everyone.clone();
    short.pop();
    println(f"1000 people, all but person 1000 trusting 500: {find_judge(1000, short)}");
    let ring: Vec[Vec[i64]] = (1..1001).map(|p| vec![p, p % 1000 + 1]).collect();
    println(f"1000 people in a ring of trust: {find_judge(1000, ring)}");
    let mut seed = 997;
    for (count, most, extra) in vec![(300, 4, 3), (3000, 30, 40), (300, 1000, 9000)] {
        let mut people = 0;
        let mut judges = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = 1 + next_random(mut seed) % most;
            let m = next_random(mut seed) % (extra + 1);
            let trust = random_town(n, m, mut seed);
            people += n;
            let got = find_judge(n, trust);
            if got > 0 {
                judges += 1;
            }
            check = (check * 31 + got + 2) % 1000000007;
        }
        println(f"{count} random towns of {people} people: {judges} judges, checksum {check}");
    }
}
