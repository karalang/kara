// LeetCode #997: Find the Town Judge -- differential.
//
// The five arms against the statement read literally and against each
// other, on random towns.

// ---- star ----

fn star_find_judge(n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    // trusted by, less trusting
    let mut score: Vec[i64] = Vec.filled(n + 1, 0);
    for t in trust.iter() {
        score[t[0]] -= 1;
        score[t[1]] += 1;
    }
    for person in 1..n + 1 {
        if score[person] == n - 1 {
            return person;
        }
    }
    -1
}

// ---- degrees ----

fn degrees_find_judge(n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    let mut trusts: Vec[i64] = Vec.filled(n + 1, 0);
    let mut trusted: Vec[i64] = Vec.filled(n + 1, 0);
    for t in trust.iter() {
        trusts[t[0]] += 1;
        trusted[t[1]] += 1;
    }
    for person in 1..n + 1 {
        if trusts[person] == 0 and trusted[person] == n - 1 {
            return person;
        }
    }
    -1
}

// ---- matrix ----

fn matrix_find_judge(n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    // knows[a][b]: a trusts b
    let mut knows: Vec[Vec[bool]] = Vec.new();
    for _ in 0..n + 1 {
        knows.push(Vec.filled(n + 1, false));
    }
    for t in trust.iter() {
        knows[t[0]][t[1]] = true;
    }
    for person in 1..n + 1 {
        let mut judge = true;
        for other in 1..n + 1 {
            if other != person and (knows[person][other] or not knows[other][person]) {
                judge = false;
                break;
            }
        }
        if judge {
            return person;
        }
    }
    -1
}

// ---- celebrity ----

fn celebrity_find_judge(n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    let mut pairs: Set[i64] = Set.new();
    for t in trust.iter() {
        pairs.insert(t[0] * (n + 1) + t[1]);
    }
    // whoever the candidate trusts can be the judge and the candidate
    // cannot, and whoever does not trust the candidate cannot be it
    let mut candidate = 1;
    for person in 2..n + 1 {
        if pairs.contains(candidate * (n + 1) + person) {
            candidate = person;
        }
    }
    for other in 1..n + 1 {
        if other != candidate {
            if pairs.contains(candidate * (n + 1) + other) or not pairs.contains(other * (n + 1) + candidate) {
                return -1;
            }
        }
    }
    candidate
}

// ---- sorted ----

fn sorted_find_judge(n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    // the trusted, sorted, so that each person's trusters form a run
    let mut trusted: Vec[i64] = trust.iter().map(|t| t[1]).collect();
    trusted.sort();
    let mut trusting: Vec[i64] = trust.iter().map(|t| t[0]).collect();
    trusting.sort();
    let mut found = -1;
    if n == 1 {
        found = 1;
    }
    let mut i = 0;
    while i < trusted.len() {
        let mut j = i;
        while j < trusted.len() and trusted[j] == trusted[i] {
            j += 1;
        }
        if j - i == n - 1 {
            found = trusted[i];
        }
        i = j;
    }
    if found < 0 {
        return -1;
    }
    // the judge must not be among the trusting, found by binary search
    let mut lo = 0;
    let mut hi = trusting.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if trusting[mid] < found {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < trusting.len() and trusting[lo] == found {
        return -1;
    }
    found
}

// ---- checks ----

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn add(pairs: mut ref Vec[Vec[i64]], seen: mut ref Set[i64], a: i64, b: i64) {
    if a != b and not seen.contains(a * 2000 + b) {
        seen.insert(a * 2000 + b);
        pairs.push(vec![a, b]);
    }
}

// n people and a list of trusts: half the time a judge everyone else
// trusts, with a third of those spoiled by one trust taken away or one
// trust from the judge, and other trusts at random, in random order
fn random_town(n: i64, extra: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    let mut seen: Set[i64] = Set.new();
    let mut judge = 0;
    if next_random(mut seed) % 2 == 0 {
        judge = 1 + next_random(mut seed) % n;
        for p in 1..n + 1 {
            add(mut pairs, mut seen, p, judge);
        }
    }
    for _ in 0..extra {
        let a = 1 + next_random(mut seed) % n;
        let b = 1 + next_random(mut seed) % n;
        if a != judge {
            add(mut pairs, mut seen, a, b);
        }
    }
    if judge > 0 and n > 1 {
        let spoil = next_random(mut seed) % 6;
        if spoil == 0 {
            pairs.remove(next_random(mut seed) % (n - 1));
        } else if spoil == 1 {
            let other = 1 + next_random(mut seed) % n;
            if other != judge {
                pairs.push(vec![judge, other]);
            }
        }
    }
    shuffled(pairs, mut seed)
}

fn shuffled(pairs: ref Vec[Vec[i64]], seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut out = pairs.clone();
    let mut i = out.len() - 1;
    while i > 0 {
        let j = next_random(mut seed) % (i + 1);
        let t = out[i].clone();
        out[i] = out[j].clone();
        out[j] = t;
        i -= 1;
    }
    out
}

fn arm(k: i64, n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    if k == 0 {
        star_find_judge(n, trust)
    } else if k == 1 {
        degrees_find_judge(n, trust)
    } else if k == 2 {
        matrix_find_judge(n, trust)
    } else if k == 3 {
        celebrity_find_judge(n, trust)
    } else {
        sorted_find_judge(n, trust)
    }
}

fn has(trust: ref Vec[Vec[i64]], a: i64, b: i64) -> bool {
    for t in trust.iter() {
        if t[0] == a and t[1] == b {
            return true;
        }
    }
    false
}

// The statement read literally: a person is the judge when they trust
// nobody and everybody else trusts them; the answer is that person's
// label when exactly one person is, and -1 otherwise.
fn literal(n: i64, trust: ref Vec[Vec[i64]]) -> i64 {
    let mut judges: Vec[i64] = Vec.new();
    for j in 1..n + 1 {
        let mut trusts_nobody = true;
        for i in 1..n + 1 {
            if has(trust, j, i) {
                trusts_nobody = false;
            }
        }
        let mut all_trust = true;
        for i in 1..n + 1 {
            if i != j and not has(trust, i, j) {
                all_trust = false;
            }
        }
        if trusts_nobody and all_trust {
            judges.push(j);
        }
    }
    if judges.len() == 1 { judges[0] } else { -1 }
}

struct Tally {
    checks: i64,
    failures: Vec[i64],
}

fn check(t: mut ref Tally, p: i64, ok: bool) {
    t.checks += 1;
    if not ok {
        t.failures[p - 1] += 1;
    }
}

fn properties(tally: mut ref Tally, n: i64, trust: ref Vec[Vec[i64]], small: bool, seed: mut ref i64) -> i64 {
    let truth = if small { literal(n, trust) } else { 0 };
    let mut got: Vec[i64] = Vec.new();
    for k in 0..5 {
        got.push(arm(k, n, trust));
    }
    let reordered = shuffled(trust, mut seed);
    // everyone relabelled by a random permutation of 1 to n
    let mut label: Vec[i64] = (0..n + 1).collect();
    let mut i = n;
    while i > 1 {
        let j = 1 + next_random(mut seed) % i;
        let t = label[i];
        label[i] = label[j];
        label[j] = t;
        i -= 1;
    }
    let renamed: Vec[Vec[i64]] = trust.iter().map(|t| vec![label[t[0]], label[t[1]]]).collect();
    for k in 0..5 {
        let g = got[k];
        // P1: the statement's answer, on the first 3000 towns
        if small {
            check(mut tally, 1, g == truth);
        }
        // P2: the trusts in another order give the same answer
        check(mut tally, 2, arm(k, n, reordered) == g);
        // P3: everyone relabelled gives the judge's new label
        let r = arm(k, n, renamed);
        check(mut tally, 3, if g > 0 { r == label[g] } else { r == -1 });
        // P4: a judge who trusts someone is no judge
        let mut p4 = true;
        if g > 0 and n > 1 {
            let mut other = 1 + next_random(mut seed) % n;
            if other == g {
                other = other % n + 1;
            }
            let mut more = trust.clone();
            more.push(vec![g, other]);
            p4 = arm(k, n, more) == -1;
        }
        check(mut tally, 4, p4);
        // P5: a trust between two others taken away changes nothing
        let mut p5 = true;
        if g > 0 {
            let mut fewer: Vec[Vec[i64]] = Vec.new();
            let mut dropped = false;
            let skip = next_random(mut seed) % (trust.len() + 1);
            for idx in 0..trust.len() {
                if not dropped and idx >= skip and trust[idx][1] != g {
                    dropped = true;
                } else {
                    fewer.push(trust[idx].clone());
                }
            }
            p5 = arm(k, n, fewer) == g;
        }
        check(mut tally, 5, p5);
        // P6: agreement with at least two of the other four
        let mut agree = 0;
        for j in 0..5 {
            if j != k and got[j] == g {
                agree += 1;
            }
        }
        check(mut tally, 6, agree >= 2);
    }
    got[0]
}

fn main() {
    let mut tally = Tally { checks: 0, failures: vec![0, 0, 0, 0, 0, 0] };
    let mut seed = 997;
    let mut people = 0;
    let mut judges = 0;
    let mut check_sum = 0;
    // 3000 towns of up to 8 people against the statement, then 200 of up
    // to 100
    for c in 0..3200 {
        let small = c < 3000;
        let n = 1 + next_random(mut seed) % (if small { 8 } else { 100 });
        let m = next_random(mut seed) % (if small { 12 } else { 400 });
        let trust = random_town(n, m, mut seed);
        people += n;
        let got = properties(mut tally, n, trust, small, mut seed);
        if got > 0 {
            judges += 1;
        }
        check_sum = (check_sum * 31 + got + 2) % 1000000007;
    }
    let mut failures = 0;
    let mut by = String.new();
    for p in 0..6 {
        failures += tally.failures[p];
        if tally.failures[p] > 0 {
            by = by + f" P{p + 1} {tally.failures[p]}";
        }
    }
    println(f"3200 towns of {people} people: {judges} judges, checksum {check_sum}, {tally.checks} checks over 5 arms: {failures} failures");
    if failures > 0 {
        println(f"failures by property:{by}");
    }
}
