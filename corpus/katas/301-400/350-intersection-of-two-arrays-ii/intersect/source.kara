// LeetCode #350 -- Intersection of Two Arrays II.
//
// Return the values both arrays hold, each as many times as it appears in
// BOTH: a value the first array holds twice and the second three times is
// kept twice. LeetCode accepts any order; every arm here returns the values
// in ascending order so the answer is one exact string.
//
// Count the first array in a Map, then walk the second and keep each value
// whose count is still positive, spending one count each time. O(n + m)
// expected, then a sort of the answer.

fn intersect(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut counts: Map[i64, i64] = Map.new();
    for x in a {
        *counts.entry(x).or_insert(0) += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    for y in b {
        let left = counts.get_or(y, 0);
        if left > 0 {
            counts.insert(y, left - 1);
            out.push(y);
        }
    }
    out.sort();
    return out;
}

fn fill(n: i64, hi: i64, seed: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    for _ in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x / 16 % (hi + 1));
    }
    return out;
}

fn main() {
    println(f"{intersect([1, 2, 2, 1], [2, 2])}");
    println(f"{intersect([4, 9, 5], [9, 4, 9, 8, 4])}");
    println(f"{intersect([1, 2, 3], [4, 5, 6])}");
    println(f"{intersect([7], [7, 7, 7])}");
    println(f"{intersect([7, 7, 3, 7], [7, 3, 3, 7])}");
    println(f"{intersect([0, 1000, 1000, 500], [1000, 0, 1000, 1000])}");

    // The problem's bounds: 1,000 values each in 0..=1000, over many seeds.
    let mut total = 0;
    let mut count = 0;
    for s in 0..200 {
        let r = intersect(fill(1000, 1000, s), fill(1000, 1000, s + 7919));
        count += r.len();
        for v in r {
            total += v;
        }
    }
    println(f"200 pairs at the bounds: {count} values, sum {total}");
}
