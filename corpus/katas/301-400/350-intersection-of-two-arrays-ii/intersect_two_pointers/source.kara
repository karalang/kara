// LeetCode #350 -- Intersection of Two Arrays II, by merging sorted copies.
//
// Sort copies of both arrays and walk them together: the smaller side
// advances, and a match is kept and advances both, so a value is kept
// exactly as often as the rarer side holds it. O(n log n + m log m), no
// hashing. This is the answer to LeetCode's follow-up "what if the arrays
// are already sorted?" -- then it is O(n + m).

fn intersect_merge(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut x = a.clone();
    let mut y = b.clone();
    x.sort();
    y.sort();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    let mut j = 0;
    while i < x.len() and j < y.len() {
        if x[i] < y[j] {
            i += 1;
        } else if x[i] > y[j] {
            j += 1;
        } else {
            out.push(x[i]);
            i += 1;
            j += 1;
        }
    }
    return out;
}

fn fill(n: i64, hi: i64, seed: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    for _ in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x / 16 % (hi + 1));
    }
    return out;
}

fn main() {
    println(f"{intersect_merge([1, 2, 2, 1], [2, 2])}");
    println(f"{intersect_merge([4, 9, 5], [9, 4, 9, 8, 4])}");
    println(f"{intersect_merge([1, 2, 3], [4, 5, 6])}");
    println(f"{intersect_merge([7], [7, 7, 7])}");
    println(f"{intersect_merge([7, 7, 3, 7], [7, 3, 3, 7])}");
    println(f"{intersect_merge([0, 1000, 1000, 500], [1000, 0, 1000, 1000])}");

    // The problem's bounds: 1,000 values each in 0..=1000, over many seeds.
    let mut total = 0;
    let mut count = 0;
    for s in 0..200 {
        let r = intersect_merge(fill(1000, 1000, s), fill(1000, 1000, s + 7919));
        count += r.len();
        for v in r {
            total += v;
        }
    }
    println(f"200 pairs at the bounds: {count} values, sum {total}");
}
