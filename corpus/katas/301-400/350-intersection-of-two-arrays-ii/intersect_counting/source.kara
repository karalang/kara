// LeetCode #350 -- Intersection of Two Arrays II, with count tables.
//
// The values are bounded by 1,000, so two tables of 1,001 counts replace
// the map. Sweep the values in order and emit each one as many times as the
// smaller of its two counts. O(n + m + 1001), no hashing, no sort.

const MAX_VALUE: i64 = 1000;

fn intersect_counts(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut ca = [0; MAX_VALUE + 1];
    let mut cb = [0; MAX_VALUE + 1];
    for x in a {
        ca[x] += 1;
    }
    for y in b {
        cb[y] += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    for v in 0..=MAX_VALUE {
        let k = if ca[v] < cb[v] { ca[v] } else { cb[v] };
        for _ in 0..k {
            out.push(v);
        }
    }
    return out;
}

fn fill(n: i64, hi: i64, seed: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    for _ in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x / 16 % (hi + 1));
    }
    return out;
}

fn main() {
    println(f"{intersect_counts([1, 2, 2, 1], [2, 2])}");
    println(f"{intersect_counts([4, 9, 5], [9, 4, 9, 8, 4])}");
    println(f"{intersect_counts([1, 2, 3], [4, 5, 6])}");
    println(f"{intersect_counts([7], [7, 7, 7])}");
    println(f"{intersect_counts([7, 7, 3, 7], [7, 3, 3, 7])}");
    println(f"{intersect_counts([0, 1000, 1000, 500], [1000, 0, 1000, 1000])}");

    // The problem's bounds: 1,000 values each in 0..=1000, over many seeds.
    let mut total = 0;
    let mut count = 0;
    for s in 0..200 {
        let r = intersect_counts(fill(1000, 1000, s), fill(1000, 1000, s + 7919));
        count += r.len();
        for v in r {
            total += v;
        }
    }
    println(f"200 pairs at the bounds: {count} values, sum {total}");
}
