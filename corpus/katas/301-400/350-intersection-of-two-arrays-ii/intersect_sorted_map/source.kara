// LeetCode #350 -- Intersection of Two Arrays II, with a SortedMap.
//
// Count both arrays in SortedMaps, then walk the first map's keys, which
// come out in ascending order, and emit each value as many times as the
// smaller of its two counts. O((n + m) log(n + m)); no sort of the answer.

fn intersect_sorted(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut ca: SortedMap[i64, i64] = SortedMap.new();
    for x in a {
        *ca.entry(x).or_insert(0) += 1;
    }
    let mut cb: SortedMap[i64, i64] = SortedMap.new();
    for y in b {
        *cb.entry(y).or_insert(0) += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    for (v, n) in ca {
        if let Some(m) = cb.get(v) {
            for _ in 0..n.min(m) {
                out.push(v);
            }
        }
    }
    return out;
}

fn fill(n: i64, hi: i64, seed: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    for _ in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x / 16 % (hi + 1));
    }
    return out;
}

fn main() {
    println(f"{intersect_sorted([1, 2, 2, 1], [2, 2])}");
    println(f"{intersect_sorted([4, 9, 5], [9, 4, 9, 8, 4])}");
    println(f"{intersect_sorted([1, 2, 3], [4, 5, 6])}");
    println(f"{intersect_sorted([7], [7, 7, 7])}");
    println(f"{intersect_sorted([7, 7, 3, 7], [7, 3, 3, 7])}");
    println(f"{intersect_sorted([0, 1000, 1000, 500], [1000, 0, 1000, 1000])}");

    // The problem's bounds: 1,000 values each in 0..=1000, over many seeds.
    let mut total = 0;
    let mut count = 0;
    for s in 0..200 {
        let r = intersect_sorted(fill(1000, 1000, s), fill(1000, 1000, s + 7919));
        count += r.len();
        for v in r {
            total += v;
        }
    }
    println(f"200 pairs at the bounds: {count} values, sum {total}");
}
