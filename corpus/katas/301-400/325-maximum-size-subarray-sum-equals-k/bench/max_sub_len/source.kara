// Benchmark workload for LeetCode #325 — the prefix-sum map arm
// (max_sub_len.kara), timed as written: a fresh `Map` per call, `get` for the
// lookup, `entry(p).or_insert(i)` for the first-occurrence insert.
//
// Build once, then punch (BENCHMARKS.md). Three arrays of LEN values are
// built once, with values within +-1, +-100 and +-10000. The range sets how
// many distinct prefix sums a scan meets, and so how big the map grows: a few
// hundred keys for +-1, tens of thousands for +-100, nearly one per element
// for +-10000. Each of PUNCHES punches picks the next array in turn, changes
// one value at a random position, draws a k near zero (scaled to the range,
// so that most scans find something), and re-runs the whole scan.
//
// Every length is folded into a rolling hash, which is the sink.

const LEN: i64 = 200000;
const PUNCHES: i64 = 60;
const MODULUS: i64 = 1073741789;

fn max_sub_len(nums: ref Vec[i64], k: i64) -> i64 {
    let mut first: Map[i64, i64] = Map.new();
    first.insert(0, -1);
    let mut p = 0;
    let mut best = 0;
    for i in 0..nums.len() {
        p += nums[i];
        match first.get(p - k) {
            Some(j) => {
                if i - j > best {
                    best = i - j;
                }
            }
            None => {}
        }
        first.entry(p).or_insert(i);
    }
    return best;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn main() {
    let mut seed = 325;
    let ranges: Vec[i64] = [1, 100, 10000];
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for t in 0..3 {
        let r = ranges[t];
        let mut a: Vec[i64] = Vec.new();
        for _ in 0..LEN {
            a.push(next(mut seed) % (2 * r + 1) - r);
        }
        arrays.push(a);
    }

    let mut sink = 0;
    for punch in 0..PUNCHES {
        let t = punch % 3;
        let r = ranges[t];
        let pos = (next(mut seed) * 32768 + next(mut seed)) % LEN;
        arrays[t][pos] = next(mut seed) % (2 * r + 1) - r;
        let k = (next(mut seed) % 41 - 20) * r / 4;
        let len = max_sub_len(arrays[t], k);
        sink = (sink * 31 + len + 1) % MODULUS;
    }
    println(f"sink {sink}");
}
