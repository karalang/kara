// LeetCode 301 — Remove Invalid Parentheses, breadth-first by removal count.
//
// The statement has two halves — "minimum removals" and "all results at that
// minimum" — and this arm gets both from the shape of the search rather than
// from any reasoning about parentheses:
//
//     level 0 = { s }
//     level k+1 = { every string obtained by deleting one paren from level k }
//
// Every string in level k is exactly k deletions from the input, so the FIRST
// level containing a valid string is the minimum, and the valid strings in that
// level are all of the answers. Stop there. No counting argument, no budget, no
// claim about which characters are unmatchable — just "search shallowest first,
// and stop the moment you find anything."
//
// That is why it belongs next to the bounded DFS. The DFS's correctness rests
// on a proof that the one-pass counters really are the minimum; if that proof
// is wrong the DFS confidently returns a wrong-sized answer and nothing inside
// it notices. This arm cannot make that mistake — minimality is the search
// order — so agreement between the two is evidence about the counting argument
// itself, which is the part of #301 most likely to be subtly wrong.
//
// It pays for that with cost. Level k has up to C(p, k) members for p parens,
// each an O(n) string build and an O(n) validity check, so this is the arm that
// falls over first on long inputs. Fine for a differential over short strings,
// which is the job it is here to do.
//
// The frontier is a Vec (deterministic order) alongside a Set (membership).
// Deduplicating between levels is not a nicety: without it the frontier is
// factorial rather than binomial, since every ordering of the same k deletions
// arrives separately.

fn str_less(a: ref String, b: ref String) -> bool {
    let ab = a.bytes();
    let bb = b.bytes();
    let n = if ab.len() < bb.len() { ab.len() } else { bb.len() };
    let mut i = 0;
    while i < n {
        if ab[i] != bb[i] { return ab[i] < bb[i]; }
        i = i + 1;
    }
    return ab.len() < bb.len();
}

fn sort_strings(items: mut ref Vec[String]) {
    let mut i = 1;
    while i < items.len() {
        let mut j = i;
        while j > 0 and str_less(items[j], items[j - 1]) {
            items.swap(j, j - 1);
            j = j - 1;
        }
        i = i + 1;
    }
}

fn is_valid(s: ref String) -> bool {
    let bytes = s.bytes();
    let mut open = 0;
    let mut i = 0;
    while i < bytes.len() {
        let c = bytes[i];
        if c == b'(' {
            open = open + 1;
        } else if c == b')' {
            open = open - 1;
            if open < 0 { return false; }
        }
        i = i + 1;
    }
    return open == 0;
}

// `s` with the byte at `skip` deleted.
fn drop_at(s: ref String, skip: i64) -> String {
    let bytes = s.bytes();
    let mut out = String.new();
    let mut i = 0;
    while i < bytes.len() {
        if i != skip { out.push(bytes[i] as char); }
        i = i + 1;
    }
    return out;
}

fn remove_invalid_parentheses(s: ref String) -> Vec[String] {
    let mut frontier: Vec[String] = Vec.new();
    frontier.push(s.to_string());

    // The loop always terminates: deleting every paren yields a valid string,
    // so some level at or before "one per paren" is non-empty and valid.
    loop {
        let mut found: Vec[String] = Vec.new();
        let mut k = 0;
        while k < frontier.len() {
            if is_valid(frontier[k]) { found.push(frontier[k].to_string()); }
            k = k + 1;
        }
        if found.len() > 0 {
            sort_strings(mut found);
            return found;
        }

        let mut next: Vec[String] = Vec.new();
        let mut seen: Set[String] = Set.new();
        let mut f = 0;
        while f < frontier.len() {
            let cur = frontier[f].to_string();
            let bytes = cur.bytes();
            let mut i = 0;
            while i < bytes.len() {
                let c = bytes[i];
                if c == b'(' or c == b')' {
                    let cand = drop_at(cur, i);
                    if not seen.contains(cand) {
                        seen.insert(cand.to_string());
                        next.push(cand);
                    }
                }
                i = i + 1;
            }
            f = f + 1;
        }
        frontier = next;
    }
}

fn render(items: ref Vec[String]) -> String {
    let mut line = String.new();
    line.push_str("[");
    let mut i = 0;
    while i < items.len() {
        if i > 0 { line.push_str(", "); }
        line.push_str("\"");
        line.push_str(items[i]);
        line.push_str("\"");
        i = i + 1;
    }
    line.push_str("]");
    return line;
}

fn report(s: String) {
    let got = remove_invalid_parentheses(s);
    println(f"\"{s}\" -> {render(got)}");
}

fn main() {
    report("()())()");
    report("(a)())()");
    report(")(");
    report("");
    report("(((");
    report("n");
    report("()");
    report("()())()(");
    report("()(()");
    report("(a(b(c)d)");
}
