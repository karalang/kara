// LeetCode 307 — arm C: sqrt decomposition.
//
// Cut the array into blocks of about sqrt(n) and keep one running total per
// block. A write touches exactly one block total; a read walks the partial
// block at each end element by element and takes the whole blocks between them
// as single numbers. Both are O(sqrt n) — asymptotically worse than the trees,
// which is why it is not the ★ arm, and structurally simple enough that it is
// hard to get wrong, which is why it is useful here.
//
// #303 carries the immutable version of this decomposition. The mutable one is
// a genuinely different exercise: there the block sums were built once and read
// forever, here every write has to find its block and adjust the total by a
// delta, and the block boundary is now a place where a write can land as well
// as a place where a read can stop.
//
// ITS CHARACTERISTIC BUG IS THE PARTIAL EDGE — a query that starts and ends
// inside the SAME block must not take that block's total, and one whose range
// happens to align exactly with block boundaries must not walk any elements.
// Neither tree arm has a notion of a partial anything, so neither can commit
// it; this arm in turn has no bit trick and no child arithmetic to get wrong.

struct Blocks {
    data: Vec[i64],
    sums: Vec[i64],
    size: i64,
    n: i64,
}

impl Blocks {
    fn new(nums: ref Vec[i64]) -> Blocks {
        let n = nums.len();
        // Block size ~ sqrt(n), never zero.
        let mut size = 1;
        while size * size < n {
            size = size + 1;
        }
        let count = (n + size - 1) / size;

        let mut data: Vec[i64] = Vec.new();
        for i in 0..n {
            data.push(nums[i]);
        }
        let mut sums: Vec[i64] = Vec.new();
        for b in 0..count {
            sums.push(0);
        }
        for i in 0..n {
            sums[i / size] += nums[i];
        }
        return Blocks { data: data, sums: sums, size: size, n: n };
    }

    fn update(mut ref self, i: i64, val: i64) {
        let delta = val - self.data[i];
        self.data[i] = val;
        self.sums[i / self.size] += delta;
    }

    fn sum_range(ref self, l: i64, r: i64) -> i64 {
        let mut total = 0;
        let mut i = l;
        while i <= r {
            // Take a whole block only when the entire block fits in the range.
            if i % self.size == 0 and i + self.size - 1 <= r {
                total += self.sums[i / self.size];
                i += self.size;
            } else {
                total += self.data[i];
                i += 1;
            }
        }
        return total;
    }
}

fn new_structure(nums: ref Vec[i64]) -> Blocks {
    return Blocks.new(nums);
}

fn render(nums: Slice[i64]) -> String {
    let mut s = String.new();
    s.push_str("[");
    let mut i = 0;
    while i < nums.len() {
        if i > 0 { s.push_str(", "); }
        s.push_str(f"{nums[i]}");
        i = i + 1;
    }
    s.push_str("]");
    return s;
}

// `ops` is a flat list of (kind, a, b) triples: kind 0 = update(a, b),
// kind 1 = sum_range(a, b).
fn report(nums: Slice[i64], ops: Slice[i64]) {
    let mut arr: Vec[i64] = Vec.new();
    for i in 0..nums.len() {
        arr.push(nums[i]);
    }
    let mut st = new_structure(arr);
    let mut line = String.new();
    line.push_str(render(nums));
    line.push_str(" ->");
    let mut k = 0;
    while k + 2 < ops.len() {
        let kind = ops[k];
        let a = ops[k + 1];
        let b = ops[k + 2];
        if kind == 0 {
            st.update(a, b);
            line.push_str(f" u({a},{b})");
        } else {
            line.push_str(f" {st.sum_range(a, b)}");
        }
        k = k + 3;
    }
    println(line);
}

fn main() {
    // The example from the LeetCode statement.
    report([1, 3, 5], [1, 0, 2,  0, 1, 2,  1, 0, 2]);
    // Every single-element read, before and after a write.
    report([2, 7, 4], [1, 0, 0,  1, 1, 1,  1, 2, 2,  0, 1, 9,  1, 1, 1,  1, 0, 2]);
    // One element.
    report([42], [1, 0, 0,  0, 0, -5,  1, 0, 0]);
    // Writing the value that is already there must change nothing.
    report([4, 4, 4, 4], [1, 0, 3,  0, 2, 4,  1, 0, 3,  1, 2, 2]);
    // Negatives, and a write that flips a sign.
    report([-1, -2, -3, -4], [1, 0, 3,  1, 1, 2,  0, 0, 10,  1, 0, 3,  1, 0, 0]);
    // Every prefix of a longer array, then a write in the middle.
    report([5, 1, 8, 2, 9, 3], [1, 0, 0,  1, 0, 1,  1, 0, 2,  1, 0, 3,  1, 0, 4,  1, 0, 5,
                               0, 3, 100,  1, 0, 5,  1, 3, 3,  1, 4, 5]);
    // Large magnitudes that cancel.
    report([100000, -100000, 100000], [1, 0, 2,  0, 1, 100000,  1, 0, 2,  1, 1, 1]);
    // A power-of-two length, where the Fenwick and segment trees are widest.
    report([1, 2, 3, 4, 5, 6, 7, 8], [1, 0, 7,  0, 7, 0,  1, 0, 7,  1, 7, 7,  1, 4, 6]);
}
