// LeetCode 302 — Smallest Rectangle Enclosing Black Pixels, BY FLOOD FILL.
//
// A third mechanism that shares nothing with the other two. It never asks "is
// this row entirely white" and never looks at a pixel outside the black region:
// it starts at the seed and walks the connected component, widening a bounding
// box as it goes.
//
//     push seed; while the stack is not empty:
//         pop (r,c); if already seen or white, skip
//         widen the box to include (r,c)
//         push the four neighbours
//
// COST IS O(k), where k is the number of BLACK pixels — independent of the
// frame. That is the interesting corner of this problem's cost space: the scan
// is O(m*n) regardless of how little ink there is, the binary search is
// O(m log n + n log m) regardless too, and this one is the only arm that gets
// CHEAPER as the image gets sparser. A single black pixel in a million-pixel
// frame costs this arm one iteration.
//
// The flip side is that it is the only arm whose cost is unbounded by the frame
// in the other direction: a fully black image walks every pixel AND pays a
// visited-set write and four neighbour pushes for each, so it is the slowest of
// the three when the ink is dense.
//
// WHY IT EARNS ITS PLACE IN THE DIFFERENTIAL: it uses the connectivity
// precondition too, but for a COMPLETELY DIFFERENT REASON than the ★ arm does.
// Binary search needs the row/column projections to be hole-free. Flood fill
// needs every black pixel to be REACHABLE from the seed. Those are different
// consequences of the same hypothesis, so a disconnected image breaks the two
// arms in different ways and by different amounts — which is what makes P5's
// three-way disagreement informative rather than just "two things broke".
//
// The visited set is a plain `Vec[bool]` over the frame rather than a `Set`:
// the frame is already allocated, indexing is O(1) with no hashing, and it
// keeps this arm's inner loop free of the hash machinery the other arms do not
// use either. It does mean the visited buffer is O(m*n) even when k is tiny —
// the one place this arm pays for the frame.

struct Image {
    data: Vec[u8],
    w: i64,
    h: i64,
}

fn at(img: ref Image, r: i64, c: i64) -> u8 {
    return img.data[r * img.w + c];
}

fn min_area(img: ref Image, x: i64, y: i64) -> i64 {
    if img.h == 0 or img.w == 0 {
        return 0;
    }
    if at(img, x, y) != 1u8 {
        return 0;
    }

    let mut seen: Vec[bool] = Vec.filled(img.w * img.h, false);
    let mut stack: Vec[i64] = Vec.new();
    stack.push(x * img.w + y);

    let mut top = x;
    let mut bottom = x;
    let mut left = y;
    let mut right = y;

    while stack.len() > 0 {
        let idx = match stack.pop() {
            Some(v) => v,
            None => 0,
        };
        if seen[idx] {
            continue;
        }
        seen[idx] = true;

        let r = idx / img.w;
        let c = idx % img.w;
        if r < top { top = r; }
        if r > bottom { bottom = r; }
        if c < left { left = c; }
        if c > right { right = c; }

        if r > 0 and at(img, r - 1, c) == 1u8 and not seen[(r - 1) * img.w + c] {
            stack.push((r - 1) * img.w + c);
        }
        if r + 1 < img.h and at(img, r + 1, c) == 1u8 and not seen[(r + 1) * img.w + c] {
            stack.push((r + 1) * img.w + c);
        }
        if c > 0 and at(img, r, c - 1) == 1u8 and not seen[r * img.w + c - 1] {
            stack.push(r * img.w + c - 1);
        }
        if c + 1 < img.w and at(img, r, c + 1) == 1u8 and not seen[r * img.w + c + 1] {
            stack.push(r * img.w + c + 1);
        }
    }

    return (bottom - top + 1) * (right - left + 1);
}

fn image_of(rows: Vec[String]) -> Image {
    let h = rows.len();
    let w = if h > 0 { rows[0].len() } else { 0 };
    let mut data: Vec[u8] = Vec.new();
    let mut r = 0;
    while r < h {
        let bytes = rows[r].bytes();
        let mut c = 0;
        while c < w {
            if bytes[c] == 49u8 {
                data.push(1u8);
            } else {
                data.push(0u8);
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return Image { data: data, w: w, h: h };
}

fn report(rows: Vec[String], x: i64, y: i64) {
    let img = image_of(rows);
    println(f"seed ({x},{y}) -> area {min_area(img, x, y)}");
}

fn main() {
    report(["0010", "0110", "0100"], 0, 2);
    report(["1"], 0, 0);
    report(["11", "11"], 1, 1);
    report(["0000", "0100", "0000"], 1, 1);
    report(["111"], 0, 1);
}
