// LeetCode #323: Number of Connected Components in an Undirected Graph —
// breadth-first search over a compressed adjacency array.
//
// Same sweep as the DFS arm, different machinery. The adjacency lists are
// packed into one flat array in CSR form: `start[v]..start[v + 1]` is the
// slice of `nbr` holding v's neighbours. A counting pass sizes each node's
// slice and a prefix sum places it, so the graph is two flat Vecs instead of
// n small ones. The flood is breadth-first, with a queue, so the order nodes
// are reached in differs from the DFS arm's on every graph with a branch.
// The count does not depend on that order, and that is the point of running
// both.

fn count_components(n: i64, edges: ref Vec[(i64, i64)]) -> i64 {
    // Degrees, then prefix sums: start[v] is where v's neighbours begin.
    let mut start: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..edges.len() {
        let (a, b) = edges[i];
        start[a + 1] += 1;
        start[b + 1] += 1;
    }
    for v in 0..n {
        start[v + 1] += start[v];
    }
    let mut fill = start.clone();
    let mut nbr: Vec[i64] = Vec.filled(2 * edges.len(), 0);
    for i in 0..edges.len() {
        let (a, b) = edges[i];
        nbr[fill[a]] = b;
        fill[a] += 1;
        nbr[fill[b]] = a;
        fill[b] += 1;
    }

    let mut seen: Vec[bool] = Vec.filled(n, false);
    let mut queue: VecDeque[i64] = VecDeque.new();
    let mut count = 0;
    for s in 0..n {
        if seen[s] {
            continue;
        }
        count += 1;
        seen[s] = true;
        queue.push_back(s);
        while let Some(v) = queue.pop_front() {
            for k in start[v]..start[v + 1] {
                let w = nbr[k];
                if not seen[w] {
                    seen[w] = true;
                    queue.push_back(w);
                }
            }
        }
    }
    return count;
}

fn show(edges: ref Vec[(i64, i64)]) -> String {
    let mut s = String.new();
    s.push('[');
    for i in 0..edges.len() {
        if i > 0 { s.push_str(", "); }
        let (a, b) = edges[i];
        s.push_str(f"({a}, {b})");
    }
    s.push(']');
    return s;
}

fn report(n: i64, edges: Vec[(i64, i64)]) {
    println(f"n={n} edges={show(edges)} -> {count_components(n, edges)}");
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

// `m` random edges over nodes 0..n-1. Self-loops and repeats are allowed: the
// statement does not promise a simple graph, and both must change nothing.
fn random_edges(n: i64, m: i64, seed: mut ref i64) -> Vec[(i64, i64)] {
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for i in 0..m {
        let a = next(seed) % n;
        let b = next(seed) % n;
        edges.push((a, b));
    }
    return edges;
}

fn main() {
    // The two examples from the problem statement.
    report(5, [(0, 1), (1, 2), (3, 4)]);
    report(5, [(0, 1), (1, 2), (2, 3), (3, 4)]);

    // No edges: every node is alone.
    report(1, []);
    report(4, []);

    // Edges that change nothing: a self-loop, a repeat, a reversed repeat,
    // and a cycle's closing edge.
    report(3, [(2, 2)]);
    report(3, [(0, 1), (0, 1), (1, 0)]);
    report(4, [(0, 1), (1, 2), (2, 0)]);

    // Two components that only meet through the last edge, listed so that
    // union by size has to hang the bigger tree correctly.
    report(6, [(0, 1), (1, 2), (3, 4), (4, 5), (5, 3), (2, 3)]);

    // A star, a path listed backwards, and isolated nodes at both ends.
    report(7, [(3, 0), (3, 1), (3, 2), (3, 4), (3, 5)]);
    report(6, [(4, 5), (3, 4), (2, 3), (1, 2)]);
    report(8, [(2, 3), (4, 5)]);

    // Small random graphs: every arm prints these.
    let mut seed = 323;
    let mut sizes: Vec[i64] = [6, 9, 12];
    for t in 0..sizes.len() {
        let n = sizes[t];
        let edges = random_edges(n, n / 2 + t, mut seed);
        report(n, edges);
    }
}
