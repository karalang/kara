// LeetCode #383: Ransom Note -- sort both, then merge.
//
// Sort the bytes of the note and of the magazine and walk them together:
// each note byte must be matched by an equal magazine byte, skipping the
// magazine bytes that are smaller. O((m + n) log(m + n)) time, O(m + n)
// space.

fn can_construct(ransom_note: Str, magazine: Str) -> bool {
    let mut note: Vec[u8] = ransom_note.bytes().to_vec();
    let mut mag: Vec[u8] = magazine.bytes().to_vec();
    note.sort();
    mag.sort();
    let mut j = 0;
    for b in note.iter() {
        while j < mag.len() and mag[j] < *b {
            j += 1;
        }
        if j == mag.len() or mag[j] != *b {
            return false;
        }
        j += 1;
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn show(note: Str, magazine: Str) {
    let answer = if can_construct(note, magazine) { "true" } else { "false" };
    println(f"\"{note}\" from \"{magazine}\": {answer}");
}

fn main() {
    show("a", "b");
    show("aa", "ab");
    show("aa", "aab");
    show("", "abc");
    show("", "");
    show("a", "");
    show("abc", "cba");
    show("zzz", "zzzz");
    show("zzzz", "zzz");
    show("thequickbrownfox", "xofnworbkciuqeht");
    // Random notes and magazines over a small alphabet, so that both
    // answers come up: count the true answers and fold them into a
    // checksum in order.
    let mut seed: i64 = 383;
    let mut yes = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let m = (seed / 65536) % 40;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = (seed / 65536) % 15;
        let mut magazine = String.new();
        for _ in 0..m {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            magazine.push(((seed / 65536) % 6 + 97) as u8 as char);
        }
        let mut note = String.new();
        for _ in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            note.push(((seed / 65536) % 6 + 97) as u8 as char);
        }
        let ok = can_construct(note, magazine);
        if ok {
            yes += 1;
        }
        checksum = (checksum * 3 + if ok { 1 } else { 2 }) % 1000000007;
    }
    println(f"2000 random pairs: {yes} can be built, checksum {checksum}");
}
