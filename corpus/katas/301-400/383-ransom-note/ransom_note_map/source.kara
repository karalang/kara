// LeetCode #383: Ransom Note -- a Map of letter counts.
//
// The ★ arm's counting with a Map[char, i64] in place of 26 slots, so it
// works for any characters, not just lowercase letters. O(m + n) average
// time, O(k) space for k distinct characters.

fn can_construct(ransom_note: Str, magazine: Str) -> bool {
    let mut count: Map[char, i64] = Map.new();
    for c in magazine.chars() {
        *count.entry(c).or_insert(0) += 1;
    }
    for c in ransom_note.chars() {
        let left = count.get(c) ?? 0;
        if left == 0 {
            return false;
        }
        count[c] = left - 1;
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn show(note: Str, magazine: Str) {
    let answer = if can_construct(note, magazine) { "true" } else { "false" };
    println(f"\"{note}\" from \"{magazine}\": {answer}");
}

fn main() {
    show("a", "b");
    show("aa", "ab");
    show("aa", "aab");
    show("", "abc");
    show("", "");
    show("a", "");
    show("abc", "cba");
    show("zzz", "zzzz");
    show("zzzz", "zzz");
    show("thequickbrownfox", "xofnworbkciuqeht");
    // Random notes and magazines over a small alphabet, so that both
    // answers come up: count the true answers and fold them into a
    // checksum in order.
    let mut seed: i64 = 383;
    let mut yes = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let m = (seed / 65536) % 40;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = (seed / 65536) % 15;
        let mut magazine = String.new();
        for _ in 0..m {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            magazine.push(((seed / 65536) % 6 + 97) as u8 as char);
        }
        let mut note = String.new();
        for _ in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            note.push(((seed / 65536) % 6 + 97) as u8 as char);
        }
        let ok = can_construct(note, magazine);
        if ok {
            yes += 1;
        }
        checksum = (checksum * 3 + if ok { 1 } else { 2 }) % 1000000007;
    }
    println(f"2000 random pairs: {yes} can be built, checksum {checksum}");
}
