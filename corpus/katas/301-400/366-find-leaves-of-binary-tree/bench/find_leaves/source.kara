// Benchmark for #366: five random level-order lists of 400,000 slots, a
// quarter of them empty, each turned into a tree and grouped by height
// with the kata's ★ arm.

shared enum Tree {
    Empty,
    Node(i64, Tree, Tree),
}

fn build(l: ref Links, id: i64) -> Tree {
    if id < 0 {
        Tree.Empty
    } else {
        Tree.Node(l.vals[id], build(l, l.left[id]), build(l, l.right[id]))
    }
}

// Files each node's value under its height and returns the height; an
// empty tree has height -1.
fn file_by_height(t: ref Tree, out: mut ref Vec[Vec[i64]]) -> i64 {
    match t {
        Empty => -1,
        Node(v, left, right) => {
            let h = 1 + file_by_height(left, mut out).max(file_by_height(right, mut out));
            if h == out.len() {
                out.push(Vec.new());
            }
            out[h].push(v);
            h
        }
    }
}

fn find_leaves(items: ref Vec[Option[i64]]) -> Vec[Vec[i64]] {
    let l = links(items);
    let mut out: Vec[Vec[i64]] = Vec.new();
    if not l.vals.is_empty() {
        file_by_height(build(l, 0), mut out);
    }
    out
}

// Node ids are positions among the non-null slots, in level order; a child
// link is an id, or -1 for no child.
struct Links {
    vals: Vec[i64],
    left: Vec[i64],
    right: Vec[i64],
}

fn links(items: ref Vec[Option[i64]]) -> Links {
    let mut l = Links { vals: Vec.new(), left: Vec.new(), right: Vec.new() };
    if items.is_empty() {
        return l;
    }
    match items[0] {
        None => { return l; }
        Some(v) => {
            l.vals.push(v);
            l.left.push(-1);
            l.right.push(-1);
        }
    }
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(0);
    let mut i = 1;
    while i < items.len() {
        let parent = match queue.pop_front() {
            Some(p) => p,
            None => { break; }
        };
        for side in 0..2 {
            if i < items.len() {
                match items[i] {
                    Some(v) => {
                        let id = l.vals.len();
                        l.vals.push(v);
                        l.left.push(-1);
                        l.right.push(-1);
                        if side == 0 {
                            l.left[parent] = id;
                        } else {
                            l.right[parent] = id;
                        }
                        queue.push_back(id);
                    }
                    None => {}
                }
                i = i + 1;
            }
        }
    }
    l
}

fn main() {
    let mut seed: i64 = 366;
    let mut checksum: i64 = 0;
    let mut groups = 0;
    for _ in 0..5 {
        let mut items: Vec[Option[i64]] = Vec.new();
        for k in 0..400000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let r = seed / 65536;
            if k > 0 and r % 4 == 0 {
                items.push(None);
            } else {
                items.push(Some(r % 201 - 100));
            }
        }
        for group in find_leaves(items).iter() {
            groups += 1;
            for v in group.iter() {
                checksum = (checksum * 31 + v + 101) % 1000000007;
            }
            checksum = (checksum * 31 + 7) % 1000000007;
        }
    }
    println(f"{groups} groups, checksum {checksum}");
}
