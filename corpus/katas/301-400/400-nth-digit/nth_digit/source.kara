// LeetCode #400: Nth Digit -- skip whole blocks of equal length.
//
// The sequence 123456789101112... is made of blocks: 9 numbers of one
// digit, 90 of two, 900 of three, and so on, the block of d-digit numbers
// holding d * 9 * 10^(d-1) digits. Skip whole blocks while n is beyond
// them; then n falls in the block of d-digit numbers starting at 10^(d-1),
// in the number (n - 1) / d past its start, at digit (n - 1) % d from the
// left. O(log n) time, O(1) space.

fn find_nth_digit(n: i64) -> i64 {
    let mut rest = n;
    let mut digits = 1;
    let mut count = 9;
    let mut start = 1;
    while rest > digits * count {
        rest -= digits * count;
        digits += 1;
        count *= 10;
        start *= 10;
    }
    let number = start + (rest - 1) / digits;
    let mut shift = digits - 1 - (rest - 1) % digits;
    let mut x = number;
    while shift > 0 {
        x = x / 10;
        shift -= 1;
    }
    x % 10
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n}: {find_nth_digit(n)}");
}

fn main() {
    for n in [3, 11, 1, 9, 10, 12, 189, 190, 191, 192, 2889, 2890, 1000000000, 2147483647] {
        show(n);
    }
    let mut prefix = String.new();
    for n in 1..61 {
        prefix.push_str(f"{find_nth_digit(n)}");
    }
    println(f"digits 1 to 60: {prefix}");
    let mut seed: i64 = 400;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + (step(mut seed) * 32768 + step(mut seed)) % 2147483647;
        let d = find_nth_digit(n);
        total += d;
        checksum = (checksum * 31 + d) % 1000000007;
    }
    println(f"3000 random positions: total {total}, checksum {checksum}");
}
