// LeetCode #346: Moving Average from Data Stream — sum the window every time.
//
// Keep every value and, on each call, add up the last `size` of them. This is
// the definition read literally, and the baseline the other arms improve on.
//
// O(size) per call, O(n) space.

struct MovingAverage {
    size: i64,
    seen: Vec[i64],
}

impl MovingAverage {
    fn new(size: i64) -> MovingAverage {
        return MovingAverage { size: size, seen: Vec.new() };
    }

    fn next(mut ref self, val: i64) -> f64 {
        self.seen.push(val);
        let n = self.seen.len();
        let start = if n > self.size { n - self.size } else { 0 };
        let mut sum = 0;
        for k in start..n {
            sum += self.seen[k];
        }
        return sum as f64 / (n - start) as f64;
    }
}

fn run(size: i64, vals: Vec[i64]) {
    let mut m = MovingAverage.new(size);
    let mut out = String.new();
    for v in vals {
        if out.len() > 0 {
            out.push_str(", ");
        }
        let a = m.next(v);
        out.push_str(f"{a:.5}");
    }
    println(f"size {size}: [{out}]");
}

fn main() {
    // The example from the problem statement.
    run(3, [1, 10, 3, 5]);

    // A window of one is the stream itself; a window wider than the stream
    // never drops anything.
    run(1, [4, -2, 7]);
    run(10, [1, 2, 3, 4]);

    // Negative values, and a mean that is not a terminating decimal.
    run(2, [-5, 5, -5, 5, 0]);
    run(3, [1, 1, 2]);

    // Large values near the problem's bound (|val| <= 100000) over a long run.
    let mut m = MovingAverage.new(1000);
    let mut last = 0.0;
    let mut total = 0.0;
    for k in 0..100000 {
        last = m.next((k * 7919) % 200001 - 100000);
        total += last;
    }
    println(f"100000 values, window 1000: last {last:.5}, sum of averages {total:.3}");
}
