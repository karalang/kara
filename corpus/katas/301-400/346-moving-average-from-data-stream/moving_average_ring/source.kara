// LeetCode #346: Moving Average from Data Stream — a ring buffer.
//
// The window lives in a Vec of exactly `size` slots, allocated once. `head`
// is the slot the next value overwrites; once the ring is full, the value
// found there is the one leaving the window, so it comes off the sum.
//
// O(1) per call, O(size) space, and no allocation after construction.

struct MovingAverage {
    ring: Vec[i64],
    head: i64,
    count: i64,
    sum: i64,
}

impl MovingAverage {
    fn new(size: i64) -> MovingAverage {
        let mut ring: Vec[i64] = Vec.new();
        for _ in 0..size {
            ring.push(0);
        }
        return MovingAverage { ring: ring, head: 0, count: 0, sum: 0 };
    }

    fn next(mut ref self, val: i64) -> f64 {
        if self.count == self.ring.len() {
            self.sum -= self.ring[self.head];
        } else {
            self.count += 1;
        }
        self.ring[self.head] = val;
        self.sum += val;
        self.head = (self.head + 1) % self.ring.len();
        return self.sum as f64 / self.count as f64;
    }
}

fn run(size: i64, vals: Vec[i64]) {
    let mut m = MovingAverage.new(size);
    let mut out = String.new();
    for v in vals {
        if out.len() > 0 {
            out.push_str(", ");
        }
        let a = m.next(v);
        out.push_str(f"{a:.5}");
    }
    println(f"size {size}: [{out}]");
}

fn main() {
    // The example from the problem statement.
    run(3, [1, 10, 3, 5]);

    // A window of one is the stream itself; a window wider than the stream
    // never drops anything.
    run(1, [4, -2, 7]);
    run(10, [1, 2, 3, 4]);

    // Negative values, and a mean that is not a terminating decimal.
    run(2, [-5, 5, -5, 5, 0]);
    run(3, [1, 1, 2]);

    // Large values near the problem's bound (|val| <= 100000) over a long run.
    let mut m = MovingAverage.new(1000);
    let mut last = 0.0;
    let mut total = 0.0;
    for k in 0..100000 {
        last = m.next((k * 7919) % 200001 - 100000);
        total += last;
    }
    println(f"100000 values, window 1000: last {last:.5}, sum of averages {total:.3}");
}
