// LeetCode #346: Moving Average from Data Stream — a queue and a running sum.
//
// Given a stream of integers and a window size, report the average of the
// last `size` values after each new one arrives. Before the window fills,
// the average is over every value seen so far.
//
//   MovingAverage(3): next(1) -> 1.0, next(10) -> 5.5, next(3) -> 4.66667,
//                     next(5) -> 6.0
//
// The queue holds the window; the running sum gains each new value and loses
// the one that falls out the front, so every call is O(1).

struct MovingAverage {
    size: i64,
    window: VecDeque[i64],
    sum: i64,
}

impl MovingAverage {
    fn new(size: i64) -> MovingAverage {
        return MovingAverage { size: size, window: VecDeque.new(), sum: 0 };
    }

    fn next(mut ref self, val: i64) -> f64 {
        self.window.push_back(val);
        self.sum += val;
        if self.window.len() > self.size {
            self.sum -= self.window.pop_front().unwrap();
        }
        return self.sum as f64 / self.window.len() as f64;
    }
}

fn run(size: i64, vals: Vec[i64]) {
    let mut m = MovingAverage.new(size);
    let mut out = String.new();
    for v in vals {
        if out.len() > 0 {
            out.push_str(", ");
        }
        let a = m.next(v);
        out.push_str(f"{a:.5}");
    }
    println(f"size {size}: [{out}]");
}

fn main() {
    // The example from the problem statement.
    run(3, [1, 10, 3, 5]);

    // A window of one is the stream itself; a window wider than the stream
    // never drops anything.
    run(1, [4, -2, 7]);
    run(10, [1, 2, 3, 4]);

    // Negative values, and a mean that is not a terminating decimal.
    run(2, [-5, 5, -5, 5, 0]);
    run(3, [1, 1, 2]);

    // Large values near the problem's bound (|val| <= 100000) over a long run.
    let mut m = MovingAverage.new(1000);
    let mut last = 0.0;
    let mut total = 0.0;
    for k in 0..100000 {
        last = m.next((k * 7919) % 200001 - 100000);
        total += last;
    }
    println(f"100000 values, window 1000: last {last:.5}, sum of averages {total:.3}");
}
