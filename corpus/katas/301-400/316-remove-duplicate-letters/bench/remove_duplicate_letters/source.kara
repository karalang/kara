// Benchmark lane for LeetCode 316 — Remove Duplicate Letters.
//
// build-once + punch (see ../../../../BENCHMARKS.md): generate the LEN-letter
// text ONCE, then punch PASSES complete answers through it. Each pass first
// overwrites one position (drawn from the running checksum) with a letter
// (also drawn from it), so no pass repeats the last and none can be hoisted;
// the letter is restored after the pass so the text does not drift.
//
// The arm mirrored is the monotone stack (★): one pass to record each
// letter's last occurrence, then one pass that skips letters already placed
// and pops every larger top that still has a later copy. The text is
// generated with a downward drift (3/4 of steps go to the next-smaller letter,
// 1/4 jump anywhere) so it carries long descending runs — the shape that
// makes the stack actually push and pop instead of skipping.
//
// Mirrors work on the byte buffer directly (bytes in, bytes out), which is
// the same footing for all five languages. The sink is the masked fold of
// each pass's answer bytes, carried ACROSS passes so they are serialised.

const LEN: i64 = 4000000;
const PASSES: i64 = 100;
const MASK: i64 = 1073741823;

fn lcg(state: i64) -> i64 {
    return (state * 1103515245 + 12345) & 0x7fffffff;
}

fn remove_duplicate_letters(bs: ref Vec[u8]) -> Vec[u8] {
    let n = bs.len();
    let mut last: Vec[i64] = Vec.new();
    for k in 0..26 { last.push(-1); }
    for i in 0..n { last[(bs[i] - b'a') as i64] = i; }
    let mut on_stack: Vec[bool] = Vec.new();
    for k in 0..26 { on_stack.push(false); }
    let mut stack: Vec[u8] = Vec.new();
    for i in 0..n {
        let c = bs[i];
        let ci = (c - b'a') as i64;
        if on_stack[ci] { continue; }
        while stack.len() > 0 {
            let top = stack[stack.len() - 1];
            if top > c and last[(top - b'a') as i64] > i {
                stack.pop();
                on_stack[(top - b'a') as i64] = false;
            } else {
                break;
            }
        }
        stack.push(c);
        on_stack[ci] = true;
    }
    return stack;
}

fn main() {
    let mut seed = 316;
    let mut text: Vec[u8] = Vec.new();
    let mut cur = 25;
    for i in 0..LEN {
        seed = lcg(seed);
        let r = seed / 65536;
        if r % 4 != 0 {
            cur = cur - 1;
            if cur < 0 { cur = 25; }
        } else {
            cur = r % 26;
        }
        text.push((cur as u8) + b'a');
    }

    let mut checksum = 0;
    for pass in 0..PASSES {
        let i = checksum % LEN;
        let letter = ((checksum * 7 + 13) % 26) as u8;
        let saved = text[i];
        text[i] = letter + b'a';
        let out = remove_duplicate_letters(text);
        let mut fold = 0;
        for k in 0..out.len() { fold = (fold * 131 + (out[k] as i64)) & MASK; }
        checksum = (checksum * 31 + fold + out.len()) & MASK;
        text[i] = saved;
    }
    println("checksum " + checksum.to_string());
}
