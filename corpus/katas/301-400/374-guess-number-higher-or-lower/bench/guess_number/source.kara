// Benchmark for #374: 2,000,000 random games with n up to 2^31 - 1, each
// answered by the kata's binary search against a judge that counts the
// guesses.

struct Game {
    pick: i64,
    calls: i64,
}

impl Game {
    fn guess(mut ref self, num: i64) -> i64 {
        self.calls += 1;
        if self.pick < num {
            -1
        } else if self.pick > num {
            1
        } else {
            0
        }
    }
}

fn guess_number(n: i64, game: mut ref Game) -> i64 {
    let mut lo = 1;
    let mut hi = n;
    while lo <= hi {
        let mid = lo + (hi - lo) / 2;
        let answer = game.guess(mid);
        if answer == 0 {
            return mid;
        } else if answer < 0 {
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }
    -1
}

fn main() {
    let mut seed: i64 = 374;
    let mut checksum: i64 = 0;
    let mut guesses: i64 = 0;
    for _ in 0..2000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (high * 65536 + seed / 32768) % 2147483647;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high2 = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let pick = 1 + (high2 * 65536 + seed / 32768) % n;
        let mut game = Game { pick: pick, calls: 0 };
        let got = guess_number(n, mut game);
        guesses += game.calls;
        checksum = (checksum * 31 + got) % 1000000007;
    }
    println(f"{guesses} guesses, checksum {checksum}");
}
