// LeetCode #374: Guess Number Higher or Lower -- one bit at a time.
//
// Build the pick from its highest bit down. With the bits found so far in
// known, try known plus the next bit: if the pick is at least that
// (the answer is 0 or 1), the bit is set. A candidate above n cannot be
// the pick or below it, so it is skipped without a guess. 31 bits, at
// most 31 guesses, and a 0 ends the search early.

// The judge's side of the game: it knows the pick and answers each guess
// with -1 when the pick is lower, 1 when it is higher, and 0 when it is
// the guess. It counts the guesses.
struct Game {
    pick: i64,
    calls: i64,
}

impl Game {
    fn guess(mut ref self, num: i64) -> i64 {
        self.calls += 1;
        if self.pick < num {
            -1
        } else if self.pick > num {
            1
        } else {
            0
        }
    }
}

fn guess_number(n: i64, game: mut ref Game) -> i64 {
    let mut known = 0;
    let mut bit: i64 = 1 << 30;
    while bit > 0 {
        let candidate = known | bit;
        if candidate <= n {
            let answer = game.guess(candidate);
            if answer == 0 {
                return candidate;
            }
            if answer > 0 {
                known = candidate;
            }
        }
        bit >>= 1;
    }
    known
}

fn play(n: i64, pick: i64) -> i64 {
    let mut game = Game { pick: pick, calls: 0 };
    guess_number(n, mut game)
}

fn show(label: String, n: i64, pick: i64) {
    println(f"{label}: {play(n, pick)}");
}

fn main() {
    show("example 1", 10, 6);
    show("example 2", 1, 1);
    show("example 3", 2, 1);
    show("the top of two", 2, 2);
    show("1 of 2^31 - 1", 2147483647, 1);
    show("2^31 - 1 of 2^31 - 1", 2147483647, 2147483647);
    show("2^30 of 2^31 - 1", 2147483647, 1073741824);
    show("the middle of three", 3, 2);
    show("a power of two minus one", 1000000, 65535);
    // Random games with n up to 2^31 - 1: fold every answer into a
    // checksum.
    let mut seed: i64 = 374;
    let mut checksum: i64 = 0;
    for _ in 0..1000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (high * 65536 + seed / 32768) % 2147483647;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high2 = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let pick = 1 + (high2 * 65536 + seed / 32768) % n;
        checksum = (checksum * 31 + play(n, pick)) % 1000000007;
    }
    println(f"1000 random games: checksum {checksum}");
}
