// LeetCode #374: differential test. The binary, ternary, bit-at-a-time and
// galloping arms against the pick itself, over 5,000 random games. The
// judge here also tracks what its answers have ruled out. Properties: P1
// each arm returns the pick; P2 it stays within its guess bound; P3 every
// guess is in [1, n]; P4 no guess is a number earlier answers ruled out,
// so none repeats; P5 the answer does not change when n grows to 2^31 - 1.

// The judge. lo and hi bound what the answers so far leave possible.
struct Game {
    pick: i64,
    n: i64,
    calls: i64,
    lo: i64,
    hi: i64,
    out_of_range: i64,
    ruled_out: i64,
}

impl Game {
    fn guess(mut ref self, num: i64) -> i64 {
        self.calls += 1;
        if num < 1 or num > self.n {
            self.out_of_range += 1;
        }
        if num < self.lo or num > self.hi {
            self.ruled_out += 1;
        }
        if self.pick < num {
            self.hi = self.hi.min(num - 1);
            -1
        } else if self.pick > num {
            self.lo = self.lo.max(num + 1);
            1
        } else {
            0
        }
    }
}

fn new_game(n: i64, pick: i64) -> Game {
    Game { pick: pick, n: n, calls: 0, lo: 1, hi: n, out_of_range: 0, ruled_out: 0 }
}

fn binary_arm(n: i64, game: mut ref Game) -> i64 {
    let mut lo = 1;
    let mut hi = n;
    while lo <= hi {
        let mid = lo + (hi - lo) / 2;
        let answer = game.guess(mid);
        if answer == 0 {
            return mid;
        } else if answer < 0 {
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }
    -1
}

fn ternary_arm(n: i64, game: mut ref Game) -> i64 {
    let mut lo = 1;
    let mut hi = n;
    while lo <= hi {
        let third = (hi - lo) / 3;
        let m1 = lo + third;
        let m2 = hi - third;
        let first = game.guess(m1);
        if first == 0 {
            return m1;
        }
        if first < 0 {
            hi = m1 - 1;
            continue;
        }
        let second = game.guess(m2);
        if second == 0 {
            return m2;
        }
        if second > 0 {
            lo = m2 + 1;
        } else {
            lo = m1 + 1;
            hi = m2 - 1;
        }
    }
    -1
}

fn bits_arm(n: i64, game: mut ref Game) -> i64 {
    let mut known = 0;
    let mut bit: i64 = 1 << 30;
    while bit > 0 {
        let candidate = known | bit;
        if candidate <= n {
            let answer = game.guess(candidate);
            if answer == 0 {
                return candidate;
            }
            if answer > 0 {
                known = candidate;
            }
        }
        bit >>= 1;
    }
    known
}

fn gallop_arm(n: i64, game: mut ref Game) -> i64 {
    let mut below = 0;
    let mut probe = 1;
    loop {
        let answer = game.guess(probe);
        if answer == 0 {
            return probe;
        }
        if answer < 0 {
            break;
        }
        below = probe;
        if probe == n {
            return -1;
        }
        probe = (probe * 2).min(n);
    }
    let mut lo = below + 1;
    let mut hi = probe - 1;
    while lo <= hi {
        let mid = lo + (hi - lo) / 2;
        let answer = game.guess(mid);
        if answer == 0 {
            return mid;
        } else if answer < 0 {
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }
    -1
}

fn answer(arm: i64, n: i64, game: mut ref Game) -> i64 {
    match arm {
        0 => binary_arm(n, game),
        1 => ternary_arm(n, game),
        2 => bits_arm(n, game),
        _ => gallop_arm(n, game),
    }
}

fn name(arm: i64) -> String {
    match arm {
        0 => "binary",
        1 => "ternary",
        2 => "bits",
        _ => "gallop",
    }
}

// The number of binary digits of x, for x >= 1.
fn bit_length(x: i64) -> i64 {
    let mut count = 0;
    let mut v = x;
    while v > 0 {
        count += 1;
        v /= 2;
    }
    count
}

// The number of base-3 digits of x, for x >= 1.
fn trit_length(x: i64) -> i64 {
    let mut count = 0;
    let mut v = x;
    while v > 0 {
        count += 1;
        v /= 3;
    }
    count
}

// Binary search and the bit arm need at most one guess per bit of n,
// ternary search two per base-3 digit of n, and galloping two per bit of
// the pick.
fn bound(arm: i64, n: i64, pick: i64) -> i64 {
    match arm {
        0 => bit_length(n),
        1 => 2 * trit_length(n),
        2 => bit_length(n),
        _ => 2 * bit_length(pick),
    }
}

fn main() {
    let mut seed: i64 = 374;
    let mut checks = 0;
    let mut failures = 0;
    let mut fails = vec![0; 5];
    for case in 0..5000 {
        // A third of the games have n up to 20, where every pick and both
        // ends are common; a third n up to 2^20; a third n up to 2^31 - 1.
        // One pick in eight is 1 and one in eight is n.
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let wide = high * 65536 + seed / 32768;
        let n = if case % 3 == 0 {
            1 + wide % 20
        } else if case % 3 == 1 {
            1 + wide % 1048576
        } else {
            1 + wide % 2147483647
        };
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high2 = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let pick = if case % 8 == 1 {
            1
        } else if case % 8 == 5 {
            n
        } else {
            1 + (high2 * 65536 + seed / 32768) % n
        };
        for arm in 0..4 {
            let mut game = new_game(n, pick);
            let got = answer(arm, n, mut game);
            let mut bad = vec![false; 5];
            checks += 1;
            if got != pick {
                bad[0] = true;
            }
            checks += 1;
            if game.calls > bound(arm, n, pick) {
                bad[1] = true;
            }
            checks += 1;
            if game.out_of_range > 0 {
                bad[2] = true;
            }
            checks += 1;
            if game.ruled_out > 0 {
                bad[3] = true;
            }
            checks += 1;
            let mut wide_game = new_game(2147483647, pick);
            if answer(arm, 2147483647, mut wide_game) != got {
                bad[4] = true;
            }
            for p in 0..5 {
                if bad[p] {
                    fails[p] += 1;
                    failures += 1;
                    if failures <= 5 {
                        println(f"FAIL P{p + 1} {name(arm)} n={n} pick={pick} calls={game.calls}");
                    }
                }
            }
        }
    }
    for p in 0..5 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    println(f"5000 cases, {checks} checks, {failures} failures");
}
