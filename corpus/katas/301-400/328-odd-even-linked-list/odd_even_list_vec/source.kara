// LeetCode #328: Odd Even Linked List — on a vector of the values.
//
// No nodes at all: the list is a `Vec` of its values, and the answer is the
// values at even indices (positions 1, 3, 5, ...) followed by those at odd
// indices, each group in order. This is the baseline the other arms are
// checked against; it spends O(n) extra space where the problem asks for O(1).
//
// O(n) time, O(n) extra space.

fn odd_even_list(values: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < values.len() {
        out.push(values[i]);
        i += 2;
    }
    i = 1;
    while i < values.len() {
        out.push(values[i]);
        i += 2;
    }
    return out;
}

// ---- test harness ----------------------------------------------------------

fn run(values: ref Vec[i64]) -> Vec[i64] {
    return odd_even_list(values);
}

fn report(values: Vec[i64]) {
    let got = run(values);
    println(f"{values} -> {got}");
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn main() {
    // The examples from the problem statement.
    report([1, 2, 3, 4, 5]);
    report([2, 1, 3, 5, 6, 4, 7]);

    // Edge cases: empty, one, two and three nodes, repeated values.
    report([]);
    report([1]);
    report([1, 2]);
    report([1, 2, 3]);
    report([7, 7, 7, 7]);
    report([-1, 0, -1, 0, -1, 0]);

    // Larger lists, reported by a checksum of the positions: each value is
    // its 1-based position, so the result must read 1, 3, 5, ..., 2, 4, ...
    for n in [10, 11, 1000, 1001, 10000] {
        let mut values: Vec[i64] = Vec.new();
        for i in 1..n + 1 {
            values.push(i);
        }
        let got = run(values);
        let mut sum = 0;
        let mut k = 1;
        for v in got {
            sum = (sum * 31 + v * k) % 1000000007;
            k += 1;
        }
        println(f"n={n}: first {got[0]}, first even {got[(n + 1) / 2]}, last {got[n - 1]}, hash {sum}");
    }

    // Random values.
    let mut seed = 328;
    for _ in 0..3 {
        let n = next(mut seed) % 9 + 1;
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..n {
            values.push(next(mut seed) % 100);
        }
        report(values);
    }
}
