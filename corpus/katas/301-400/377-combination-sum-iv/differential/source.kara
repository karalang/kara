// LeetCode #377: differential test. The capped count-up, wrapping push,
// memo and sorted arms against an oracle that lists every sequence, over
// 1,500 random cases with targets up to 14. Properties: P1 each arm gives
// the oracle's count; P2 adding a value larger than the target changes
// nothing; P3 reversing the values changes nothing; P4 doubling every
// value and the target changes nothing; P5 adding the target itself as a
// value adds exactly one sequence; P6 each arm against closed forms
// far past the reach of the oracle: with [1, 2] the count to t is the
// Fibonacci number F(t + 1), and with [2, 4] it is F(m + 1) to 2m and 0
// to every odd total, where the even counts overflow.

const CAP: i64 = 2147483648;

fn capped_arm(nums: Vec[i64], target: i64) -> i64 {
    let mut ways = vec![0; target + 1];
    ways[0] = 1;
    for t in 1..=target {
        for x in nums.iter() {
            if x <= t {
                ways[t] = (ways[t] + ways[t - x]).min(CAP);
            }
        }
    }
    ways[target]
}

fn push_arm(nums: Vec[i64], target: i64) -> i64 {
    let mut ways = vec![0; target + 1];
    ways[0] = 1;
    for t in 0..target {
        if ways[t] == 0 {
            continue;
        }
        for x in nums.iter() {
            if t + x <= target {
                ways[t + x] = ways[t + x].wrapping_add(ways[t]);
            }
        }
    }
    ways[target]
}

fn memo_count(nums: ref Vec[i64], t: i64, memo: mut ref Vec[Option[i64]]) -> i64 {
    if t == 0 {
        return 1;
    }
    if let Some(known) = memo[t] {
        return known;
    }
    let mut total = 0;
    for x in nums.iter() {
        if x <= t {
            total += memo_count(nums, t - x, memo);
        }
    }
    memo[t] = Some(total);
    total
}

fn memo_arm(nums: Vec[i64], target: i64) -> i64 {
    let mut memo: Vec[Option[i64]] = vec![None; target + 1];
    memo_count(nums, target, mut memo)
}

fn sorted_arm(nums: Vec[i64], target: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut ways = vec![0; target + 1];
    ways[0] = 1;
    for t in sorted[0]..=target {
        for x in sorted.iter() {
            if x > t {
                break;
            }
            ways[t] = (ways[t] + ways[t - x]).min(CAP);
        }
    }
    ways[target]
}

// Lists every sequence one value at a time and counts the ones that land
// exactly on the target.
fn oracle_walk(nums: ref Vec[i64], left: i64) -> i64 {
    if left == 0 {
        return 1;
    }
    let mut found = 0;
    for x in nums.iter() {
        if x <= left {
            found += oracle_walk(nums, left - x);
        }
    }
    found
}

fn answer(arm: i64, nums: Vec[i64], target: i64) -> i64 {
    match arm {
        0 => capped_arm(nums, target),
        1 => push_arm(nums, target),
        2 => memo_arm(nums, target),
        _ => sorted_arm(nums, target),
    }
}

fn fib(n: i64) -> i64 {
    let mut a = 0;
    let mut b = 1;
    for _ in 0..n {
        let next = a + b;
        a = b;
        b = next;
    }
    a
}

fn main() {
    let mut seed: i64 = 377;
    let mut checks = 0;
    let mut fails = vec![0; 6];
    for _ in 0..1500 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = 1 + (seed / 65536) % 4;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let target = 1 + (seed / 65536) % 14;
        let mut nums: Vec[i64] = Vec.new();
        while nums.len() < k {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let v = 1 + (seed / 65536) % 12;
            if not nums.contains(v) {
                nums.push(v);
            }
        }
        let mut wider = nums.clone();
        wider.push(target + 1 + (seed / 65536) % 50);
        let mut reversed = nums.clone();
        reversed.reverse();
        let mut doubled: Vec[i64] = Vec.new();
        for x in nums.iter() {
            doubled.push(2 * x);
        }
        let mut with_target = nums.clone();
        if not with_target.contains(target) {
            with_target.push(target);
        }
        let expected = oracle_walk(nums, target);
        let bonus = if nums.contains(target) { 0 } else { 1 };
        for arm in 0..4 {
            let got = answer(arm, nums.clone(), target);
            checks += 5;
            if got != expected {
                fails[0] += 1;
            }
            if answer(arm, wider.clone(), target) != got {
                fails[1] += 1;
            }
            if answer(arm, reversed.clone(), target) != got {
                fails[2] += 1;
            }
            if answer(arm, doubled.clone(), 2 * target) != got {
                fails[3] += 1;
            }
            if answer(arm, with_target.clone(), target) != got + bonus {
                fails[4] += 1;
            }
        }
    }
    // Closed forms: [1, 2] to every t up to 44 (F(45) is the last below
    // 2^31), [2, 4] to every even total up to 88 and every odd one up to
    // 999.
    for arm in 0..4 {
        for t in 1..=44 {
            checks += 1;
            if answer(arm, vec![1, 2], t) != fib(t + 1) {
                fails[5] += 1;
            }
        }
        for t in 1..=999 {
            let want = if t % 2 == 1 { 0 } else if t <= 88 { fib(t / 2 + 1) } else { -1 };
            if want >= 0 {
                checks += 1;
                if answer(arm, vec![2, 4], t) != want {
                    fails[5] += 1;
                }
            }
        }
    }
    let mut failures = 0;
    for i in 0..6 {
        failures += fails[i];
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
    }
    println(f"1500 cases, {checks} checks, {failures} failures");
}
