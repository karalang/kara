// LeetCode #358: Rearrange String k Distance Apart -- keep the letters in a
// list sorted by the greedy rule and take the first one that may go.
//
// Each entry is (copies left, letter, position of its last copy). At every
// position the list is re-sorted, most copies first and the smallest letter
// on a tie, and the first entry written at least k positions ago is taken.
// Exhausted letters leave the list. It is the greedy rule of rearrange.kara
// stated as a sort instead of a heap and a queue.

fn rearrange(s: ref String, k: i64) -> String {
    let mut counts: Vec[i64] = vec![0; 26];
    for b in s.bytes() {
        counts[(b as i64) - (b'a' as i64)] += 1;
    }
    let mut letters: Vec[(i64, i64, i64)] = Vec.new();
    for c in 0..26 {
        if counts[c] > 0 {
            letters.push((counts[c], c, 0 - k - 1));
        }
    }
    let mut out = String.new();
    for pos in 0..s.len() {
        letters.sort_by(|a, b| (b.0, a.1).cmp((a.0, b.1)));
        let mut pick = 0 - 1;
        for i in 0..letters.len() {
            if pos - letters[i].2 >= k {
                pick = i;
                break;
            }
        }
        if pick < 0 {
            return String.new();
        }
        let (left, c, _) = letters[pick];
        out.push(((c + (b'a' as i64)) as u8) as char);
        if left == 1 {
            letters.remove(pick);
        } else {
            letters[pick] = (left - 1, c, pos);
        }
    }
    out
}

fn show(label: String, s: String, k: i64) {
    println(f"{label}: \"{rearrange(s, k)}\"");
}

fn main() {
    show("example 1", "aabbcc", 3);
    show("example 2", "aaabc", 3);
    show("example 3", "aaadbbcc", 2);

    show("k = 0", "aabbbc", 0);
    show("k = 1", "aaabbc", 1);
    show("one letter", "z", 5);
    show("one letter repeated, k = 1", "aaaa", 1);
    show("one letter repeated, k = 2", "aaaa", 2);
    show("k equals the length", "abcd", 4);
    show("k beyond the length", "abc", 9);
    show("ties go to the smaller letter", "ddccbbaa", 2);
    show("tight: the most frequent letter just fits", "aaabbbccd", 3);
    show("every letter fills its slots", "aaabbbcccdd", 4);
    show("one copy too many", "aaab", 2);

    // A long run: 2,000 random strings of 0 to 24 letters drawn from the first
    // two to six letters, with k from 0 to 4.
    let mut seed: i64 = 358;
    let mut possible = 0;
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = (seed / 65536) % 25;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let width = (seed / 65536) % 5 + 2;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = (seed / 65536) % 5;
        let mut s = String.new();
        for _ in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let c = (seed / 65536) % width;
            s.push(((c + (b'a' as i64)) as u8) as char);
        }
        let r = rearrange(s, k);
        if r.len() == s.len() {
            possible += 1;
        }
        for b in r.bytes() {
            checksum = (checksum * 31 + (b as i64)) % 1000000007;
        }
        checksum = (checksum * 31 + 7) % 1000000007;
    }
    println(f"2000 random strings: {possible} can be arranged, checksum {checksum}");
}
