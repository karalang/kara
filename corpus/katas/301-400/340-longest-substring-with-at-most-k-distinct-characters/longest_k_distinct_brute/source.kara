// LeetCode #340: Longest Substring with At Most K Distinct Characters —
// every start.
//
// Given a string s and an integer k, return the length of the longest
// substring of s that contains at most k distinct characters.
//
//   "eceba", k = 2  ->  3    "ece"
//   "aa",    k = 1  ->  2    "aa"
//
// From every start, extend the substring one character at a time, keeping
// the set of characters it holds, until a (k + 1)-th would join.
//
// O(n w) time for the longest valid length w, O(k) extra space.

fn longest_k_distinct(s: ref String, k: i64) -> i64 {
    let cs: Vec[char] = s.chars().collect();
    let mut best = 0;
    for i in 0..cs.len() {
        let mut seen: Set[char] = Set.new();
        let mut j = i;
        while j < cs.len() {
            seen.insert(cs[j]);
            if seen.len() > k {
                break;
            }
            j += 1;
        }
        best = best.max(j - i);
    }
    return best;
}

// ---- input --------------------------------------------------------------

// A pseudo-random string of n letters drawn from the first `alpha` of
// "a".."z" then "A".."Z".
fn next(state: mut ref i64) -> i64 {
    state = (state * 1103515245 + 12345) % 2147483648;
    return state >> 8;
}

fn gen_text(seed: i64, n: i64, alpha: i64) -> String {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".chars().collect();
    let mut state = seed;
    let mut out = String.new();
    for _ in 0..n {
        out.push(letters[next(mut state) % alpha]);
    }
    return out;
}

fn show(s: String, k: i64) {
    println(f"\"{s}\" k={k} -> {longest_k_distinct(s, k)}");
}

fn summary(seed: i64, n: i64, alpha: i64, k: i64) {
    let s = gen_text(seed, n, alpha);
    println(f"seed {seed}, {n} letters from {alpha}, k={k}: {longest_k_distinct(s, k)}");
}

fn main() {
    show("eceba", 2);
    show("aa", 1);
    show("", 3);
    show("abc", 0);
    show("a", 5);
    show("abaccc", 2);
    show("aabbcc", 1);
    show("abcadcacacaca", 3);
    summary(1, 20, 3, 2);
    summary(7, 1000, 5, 3);
    summary(42, 50000, 26, 10);
    summary(2026, 50000, 4, 3);
    summary(99, 50000, 52, 40);
}
