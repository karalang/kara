// LeetCode #360: Sort Transformed Array -- split at the vertex and merge.
//
// f is monotone on each side of its vertex -b / (2a): the values left of it
// run one way and the values right of it the other. Find the split (the
// last x up to which f keeps decreasing, for a > 0), reverse the run that
// goes the wrong way, and merge the two sorted runs. For a = 0 the whole
// input is a single run, and the same code handles it.

fn f(x: i64, a: i64, b: i64, c: i64) -> i64 {
    a * x * x + b * x + c
}

fn sort_transformed_array(nums: ref Vec[i64], a: i64, b: i64, c: i64) -> Vec[i64] {
    let values: Vec[i64] = nums.iter().map(|x| f(x, a, b, c)).collect();
    let n = values.len();
    if n == 0 {
        return values;
    }
    // Normalise to an upward parabola: g = -f when a < 0. Then g first falls
    // and then rises; a line (a = 0) is the case where one of the two runs is
    // empty, so it needs no case of its own.
    let flip = a < 0;
    let mut g: Vec[i64] = Vec.new();
    for v in values.iter() {
        g.push(if flip { 0 - v } else { v });
    }
    let mut split = 0;
    while split + 1 < n and g[split + 1] <= g[split] {
        split += 1;
    }
    // g[0..=split] falls, g[split + 1..] rises. Merge them in ascending order.
    let mut out: Vec[i64] = Vec.new();
    let mut i = split + 1;
    let mut j = split + 1;
    while i > 0 or j < n {
        if j >= n or (i > 0 and g[i - 1] <= g[j]) {
            out.push(g[i - 1]);
            i -= 1;
        } else {
            out.push(g[j]);
            j += 1;
        }
    }
    if flip {
        let mut back: Vec[i64] = Vec.new();
        let mut k = n;
        while k > 0 {
            k -= 1;
            back.push(0 - out[k]);
        }
        return back;
    }
    out
}

fn show(label: String, nums: Vec[i64], a: i64, b: i64, c: i64) {
    println(f"{label}: {sort_transformed_array(nums, a, b, c)}");
}

fn main() {
    show("example 1", vec![-4, -2, 2, 4], 1, 3, 5);
    show("example 2", vec![-4, -2, 2, 4], -1, 3, 5);

    show("empty", Vec.new(), 1, 2, 3);
    show("one element", vec![7], -2, 0, 1);
    show("a = 0, rising line", vec![-3, 0, 5], 0, 2, 1);
    show("a = 0, falling line", vec![-3, 0, 5], 0, -2, 1);
    show("a = b = 0, constant", vec![1, 2, 3], 0, 0, 9);
    show("vertex inside the input", vec![-5, -1, 0, 1, 2, 6], 1, -2, 0);
    show("vertex left of the input", vec![2, 3, 9], 1, 4, 0);
    show("vertex right of the input", vec![-9, -3, -2], -1, 0, 0);
    show("duplicates", vec![-2, -2, 0, 2, 2], 3, 0, -1);
    show("large values", vec![-100, -50, 0, 50, 100], 100, -100, 100);

    // A long run: 2,000 random sorted inputs of 0 to 30 values in -100..=100
    // and coefficients in -10..=10.
    let mut seed: i64 = 360;
    let mut checksum: i64 = 0;
    let mut total = 0;
    for _ in 0..2000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = (seed / 65536) % 31;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            nums.push((seed / 65536) % 201 - 100);
        }
        nums.sort();
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let a = (seed / 65536) % 21 - 10;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let b = (seed / 65536) % 21 - 10;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let c = (seed / 65536) % 21 - 10;
        let out = sort_transformed_array(nums, a, b, c);
        total += out.len();
        for v in out.iter() {
            checksum = (checksum * 31 + v + 1000000) % 1000000007;
        }
    }
    println(f"2000 random inputs: {total} values, checksum {checksum}");
}
