// Benchmark workload for LeetCode #345 — the two-index loop of
// reverse_vowels.kara, run in place on the character array.
//
// Build once, then punch (BENCHMARKS.md). LEN characters are drawn once from
// a 32-letter alphabet, a to z and A to F, so seven of the 32 are vowels. Each
// of PUNCHES punches replaces one character at a random position, reverses the
// vowels of the whole array in place, and reads one character back at another
// random position.
//
// The kata's reverse_vowels unpacks a String into this array and packs it back;
// the bench keeps the array and times only the loop between, which is the
// algorithm. Every mirror does the same.
//
// The characters read back are folded into a rolling hash, which is the sink.

const LEN: i64 = 200000;
const PUNCHES: i64 = 1000;
const MODULUS: i64 = 1073741789;

fn is_vowel(c: char) -> bool {
    return match c {
        'a' | 'e' | 'i' | 'o' | 'u' | 'A' | 'E' | 'I' | 'O' | 'U' => true,
        _ => false,
    };
}

fn reverse_vowels(cs: mut Slice[char]) {
    let mut i = 0;
    let mut j = cs.len() - 1;
    while i < j {
        if not is_vowel(cs[i]) {
            i += 1;
        } else if not is_vowel(cs[j]) {
            j -= 1;
        } else {
            cs.swap(i, j);
            i += 1;
            j -= 1;
        }
    }
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn letter(k: i64) -> char {
    if k < 26 {
        return (97 + k) as u8 as char;
    }
    return (65 + k - 26) as u8 as char;
}

fn main() {
    let mut seed = 345;
    let mut s: Vec[char] = Vec.new();
    for _ in 0..LEN {
        s.push(letter(next(mut seed) % 32));
    }
    let mut sink = 0;
    for _ in 0..PUNCHES {
        let pos = (next(mut seed) * 32768 + next(mut seed)) % LEN;
        s[pos] = letter(next(mut seed) % 32);
        reverse_vowels(mut s);
        let at = (next(mut seed) * 32768 + next(mut seed)) % LEN;
        sink = (sink * 31 + (s[at] as u32) as i64) % MODULUS;
    }
    println(f"sink {sink}");
}
