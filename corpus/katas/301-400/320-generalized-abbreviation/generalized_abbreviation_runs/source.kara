// LeetCode #320 — enumerate the RUN STRUCTURES, never the letters' choices.
//
// The other three arms all decide, per letter, keep-or-count. This one never
// asks that question. It reads the statement literally — "replace any set of
// disjoint, non-adjacent substrings with their lengths" — and enumerates
// exactly those sets: it picks where the next replaced substring starts, how
// long it is, and then jumps past the letter that has to survive after it.
//
// The "non-adjacent" clause is enforced structurally rather than checked.
// After a run covering `[a, a + len)` the arm does not recurse at `a + len`;
// it emits the letter AT `a + len` as kept and recurses at `a + len + 1`. So
// the next run cannot begin where this one ended, which is the only way two
// runs could have merged. That is why each abbreviation is produced exactly
// once: every abbreviation has a unique decomposition into maximal runs, and
// this enumeration walks decompositions, not choices.
//
// Getting 2^n out of a recursion that never mentions 2 is the interesting
// part. The count obeys `f(m) = 1 + sum over a, len of f(m - a - len - 1)`,
// the 1 being "no further run" — it comes out as 2^m, but nothing in the code
// says so, and no step of the reasoning the ★ arm depends on appears here.
// That independence is what makes this the arm worth disagreeing with.
//
// It looks like it should be the slowest of the four, and it is not — it is
// the FASTEST, by a flat 1.6x over the ★ arm at n = 16, 18 and 20 alike. The
// re-copying of the kept prefix `word[p..a]` for every (start, length) pair
// reads like wasted work, but it is work done ONCE per node and then inherited
// by that node's whole subtree, whereas the ★ arm rebuilds every entry from
// the empty string. Sharing prefix work down a recursion tree beats not doing
// it, and the sharing is worth more than the copying costs. All four arms
// measure in the same 2^n * n class; what separates them is the per-entry
// constant. (Measured AOT, KARAC_AUTO_PAR=0, 10 runs: at n = 20 this arm is
// 251.5 ms +/- 7.4 against the ★ arm's 399.0 ms +/- 8.5.)
//
// Two boundary cases fall out without special handling: `n == 0` takes only
// the "no further run" branch and emits the empty abbreviation, and a run that
// reaches the end of the word (`a + len == n`) emits its number and stops,
// because there is no surviving letter to place after it.

fn walk(bs: ref Vec[u8], n: i64, p: i64, path: String, out: mut ref Vec[String]) {
    // No further run: every remaining letter is kept verbatim.
    let mut tail = path.clone();
    for i in p..n {
        tail.push(bs[i] as char);
    }
    out.push(tail);

    // Otherwise the next run starts at some `a >= p` and covers `len >= 1`.
    for a in p..n {
        let mut head = path.clone();
        for i in p..a {
            head.push(bs[i] as char);
        }
        let mut len = 1;
        while a + len <= n {
            let mut with_run = head.clone();
            with_run.push_str(len.to_string());
            if a + len == n {
                // The run ends the word; nothing can follow it.
                out.push(with_run);
            } else {
                // The letter after the run MUST be kept, or the two runs
                // would merge and this abbreviation would be produced twice.
                with_run.push(bs[a + len] as char);
                walk(bs, n, a + len + 1, with_run, out);
            }
            len = len + 1;
        }
    }
}

fn to_bytes(word: ref String) -> Vec[u8] {
    let b = word.bytes();
    let mut v: Vec[u8] = Vec.new();
    for i in 0..b.len() { v.push(b[i]); }
    return v;
}

fn abbreviations(word: ref String) -> Vec[String] {
    let bs = to_bytes(word);
    let n = bs.len();
    let mut out: Vec[String] = Vec.new();
    walk(bs, n, 0, String.new(), mut out);
    return out;
}

fn report(word: String) {
    let all = abbreviations(word);
    println(f"\"{word}\" -> {all.len()}");
    let mut line = String.new();
    for i in 0..all.len() {
        if i > 0 { line.push_str(" "); }
        line.push_str(all[i]);
    }
    println(line);
}

fn main() {
    report("word");
    report("");
    report("a");
    report("ab");
    report("abc");
    report("aaaa");
    report("leet");

    // The recursion emits 2^n entries without ever counting to two: check it.
    let w = "abcdefghij";
    let mut expect = 1;
    for i in 0..w.bytes().len() { expect = expect * 2; }
    let all = abbreviations(w);
    println(f"\"{w}\" -> {all.len()} abbreviations (2^n = {expect})");
}
