// LeetCode #330: Patching Array — walk the array once and list the patches.
//
// For each number `x` in order: while `x` is out of reach (x > miss), patch
// `miss` and double the reachable range; then take `x`. Numbers left over
// once [1, n] is covered are skipped, and if the array runs out first the
// tail is finished with patches alone. The answer is the length of the
// returned list, which is also a witness: adding exactly these numbers
// covers [1, n].
//
// O(len + log n) time, O(log n) extra space for the list.

fn patches_for(nums: ref Vec[i64], n: i64) -> Vec[i64] {
    let mut added: Vec[i64] = Vec.new();
    let mut miss = 1;
    for x in nums {
        if miss > n {
            break;
        }
        while x > miss and miss <= n {
            added.push(miss);
            miss += miss;
        }
        miss += x;
    }
    while miss <= n {
        added.push(miss);
        miss += miss;
    }
    return added;
}

fn min_patches(nums: ref Vec[i64], n: i64) -> i64 {
    return patches_for(nums, n).len();
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

// A sorted array of `len` values in [1, max].
fn random_sorted(seed: mut ref i64, len: i64, max: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..len {
        v.push(next(seed) % max + 1);
    }
    v.sort();
    return v;
}

fn show(nums: ref Vec[i64], n: i64) {
    println(f"{nums} n={n} -> {min_patches(nums, n)}");
}

fn main() {
    show([1, 3], 6);
    show([1, 5, 10], 20);
    show([1, 2, 2], 5);
    let empty: Vec[i64] = Vec.new();
    show(empty, 1);
    show(empty, 8);
    show(empty, 2147483647);
    show([1], 1);
    show([2], 1);
    show([1, 2, 31, 33], 2147483647);
    show([1, 1, 1, 1, 1, 1, 1, 1], 8);
    show([5, 6, 7], 100);
    show([1000000], 999999);
    let mut seed = 330;
    for round in 0..4 {
        let len = 5 + round * 5;
        let v = random_sorted(mut seed, len, 50 * (round + 1));
        let n = next(mut seed) % 5000 + 1;
        println(f"random {round}: len {len} n={n} -> {min_patches(v, n)}");
    }
    let big = random_sorted(mut seed, 1000, 1000000);
    println(f"big: len 1000 n=2147483647 -> {min_patches(big, 2147483647)}");
}
