// Differential for #330 Patching Array: the three arms, a brute-force
// minimality check for small n, and properties of the answer.
//
//   P1  the three arms agree
//   P2  the list arm's patches, added to nums, cover every sum in [1, n]
//   P3  no multiset of answer - 1 patches covers [1, n]   (small n only)
//   P4  the answer never exceeds the answer for an empty array
//   P5  the answer is non-decreasing in n
//   P6  adding a number to nums never raises the answer
//   P7  nums plus its own patches needs no further patch
//   P8  the patches are strictly increasing and each is at most n

fn greedy(nums: ref Vec[i64], n: i64) -> i64 {
    let mut miss = 1;
    let mut i = 0;
    let mut patches = 0;
    while miss <= n {
        if i < nums.len() and nums[i] <= miss {
            miss += nums[i];
            i += 1;
        } else {
            miss += miss;
            patches += 1;
        }
    }
    return patches;
}

fn cover(nums: ref Vec[i64], n: i64, i: i64, miss: i64) -> i64 {
    if miss > n {
        return 0;
    }
    if i < nums.len() and nums[i] <= miss {
        return cover(nums, n, i + 1, miss + nums[i]);
    }
    return 1 + cover(nums, n, i, miss + miss);
}

fn recursive(nums: ref Vec[i64], n: i64) -> i64 {
    return cover(nums, n, 0, 1);
}

fn patches_for(nums: ref Vec[i64], n: i64) -> Vec[i64] {
    let mut added: Vec[i64] = Vec.new();
    let mut miss = 1;
    for x in nums {
        if miss > n {
            break;
        }
        while x > miss and miss <= n {
            added.push(miss);
            miss += miss;
        }
        miss += x;
    }
    while miss <= n {
        added.push(miss);
        miss += miss;
    }
    return added;
}

// Does nums plus extra reach every sum in [1, n]? Subset sums by a
// reachability table, each number used at most once.
fn covers(nums: ref Vec[i64], extra: ref Vec[i64], n: i64) -> bool {
    let mut reach: Vec[bool] = Vec.new();
    for _ in 0..n + 1 {
        reach.push(false);
    }
    reach[0] = true;
    let mut all: Vec[i64] = Vec.new();
    for x in nums {
        all.push(x);
    }
    for x in extra {
        all.push(x);
    }
    for x in all {
        let mut s = n;
        while s >= x {
            if reach[s - x] {
                reach[s] = true;
            }
            s -= 1;
        }
    }
    for s in 1..n + 1 {
        if not reach[s] {
            return false;
        }
    }
    return true;
}

// Is there a multiset of `left` more patches, each in [lo, n], that covers?
fn some_cover(nums: ref Vec[i64], n: i64, left: i64, lo: i64, chosen: mut ref Vec[i64]) -> bool {
    if left == 0 {
        return covers(nums, chosen, n);
    }
    for p in lo..n + 1 {
        chosen.push(p);
        let found = some_cover(nums, n, left - 1, p, chosen);
        chosen.pop();
        if found {
            return true;
        }
    }
    return false;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn random_sorted(seed: mut ref i64, len: i64, max: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..len {
        v.push(next(seed) % max + 1);
    }
    v.sort();
    return v;
}

fn with_value(nums: ref Vec[i64], x: i64) -> Vec[i64] {
    let mut v = nums.clone();
    v.push(x);
    v.sort();
    return v;
}

fn joined(nums: ref Vec[i64], extra: ref Vec[i64]) -> Vec[i64] {
    let mut v = nums.clone();
    for x in extra {
        v.push(x);
    }
    v.sort();
    return v;
}

// Checks one case; returns the number of failed properties.
fn check(nums: ref Vec[i64], n: i64, x: i64, brute: bool) -> i64 {
    let mut bad = 0;
    let a = greedy(nums, n);
    let list = patches_for(nums, n);
    if recursive(nums, n) != a or list.len() != a {
        println(f"P1 {nums} n={n}: {a} {recursive(nums, n)} {list.len()}");
        bad += 1;
    }
    if brute {
        if not covers(nums, list, n) {
            println(f"P2 {nums} n={n}: {list}");
            bad += 1;
        }
        if a > 0 {
            let mut chosen: Vec[i64] = Vec.new();
            if some_cover(nums, n, a - 1, 1, mut chosen) {
                println(f"P3 {nums} n={n}: {a - 1} patches suffice");
                bad += 1;
            }
        }
    }
    let empty: Vec[i64] = Vec.new();
    if a > greedy(empty, n) {
        println(f"P4 {nums} n={n}");
        bad += 1;
    }
    if greedy(nums, n + 1) < a {
        println(f"P5 {nums} n={n}");
        bad += 1;
    }
    if greedy(with_value(nums, x), n) > a {
        println(f"P6 {nums} n={n} x={x}");
        bad += 1;
    }
    if greedy(joined(nums, list), n) != 0 {
        println(f"P7 {nums} n={n}");
        bad += 1;
    }
    let mut prev = 0;
    for p in list {
        if p <= prev or p > n {
            println(f"P8 {nums} n={n}: {list}");
            bad += 1;
            break;
        }
        prev = p;
    }
    return bad;
}

fn main() {
    let mut cases = 0;
    let mut bad = 0;
    let mut nonzero = 0;
    let fixed: Vec[Vec[i64]] = [[1, 3], [1, 5, 10], [1, 2, 2], [], [1], [2], [1, 1, 1, 1], [5, 6, 7], [3, 3, 3]];
    for nums in fixed {
        for n in 1..13 {
            bad += check(nums, n, n % 7 + 1, true);
            cases += 1;
        }
    }
    let mut seed = 330;
    // Small cases, brute-forced: n up to 14, values up to 16.
    for _ in 0..600 {
        let len = next(mut seed) % 7;
        let v = random_sorted(mut seed, len, 16);
        let n = next(mut seed) % 14 + 1;
        let x = next(mut seed) % 20 + 1;
        if greedy(v, n) > 0 {
            nonzero += 1;
        }
        bad += check(v, n, x, true);
        cases += 1;
    }
    // Large cases, properties only.
    for _ in 0..200 {
        let len = next(mut seed) % 40;
        let v = random_sorted(mut seed, len, 100000);
        let n = next(mut seed) * 64 + next(mut seed) % 64 + 1;
        let x = next(mut seed) % 1000 + 1;
        bad += check(v, n, x, false);
        cases += 1;
    }
    println(f"{cases} cases ({nonzero} of 600 small random ones need a patch), {bad} failures");
}
