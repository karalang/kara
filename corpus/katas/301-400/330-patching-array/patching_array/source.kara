// LeetCode #330: Patching Array — greedy on the smallest unreachable sum.
//
// Given a sorted array of positive integers `nums` and an integer `n`, add
// as few numbers ("patches") as possible so that every integer in `[1, n]`
// is the sum of some elements of the array. Return how many patches.
//
//   nums = [1, 3],      n = 6   ->  1     (patch 2)
//   nums = [1, 5, 10],  n = 20  ->  2     (patch 2 and 4)
//   nums = [1, 2, 2],   n = 5   ->  0
//
// Keep `miss`, the smallest sum not yet reachable; every sum in [1, miss) is.
// If the next number is at most `miss`, using it extends the reachable range
// to [1, miss + x). Otherwise nothing left can make `miss`, and patching
// `miss` itself doubles the range, which no other patch does better.
//
// O(len + log n) time, O(1) space.

fn min_patches(nums: ref Vec[i64], n: i64) -> i64 {
    let mut miss = 1;
    let mut i = 0;
    let mut patches = 0;
    while miss <= n {
        if i < nums.len() and nums[i] <= miss {
            miss += nums[i];
            i += 1;
        } else {
            miss += miss;
            patches += 1;
        }
    }
    return patches;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

// A sorted array of `len` values in [1, max].
fn random_sorted(seed: mut ref i64, len: i64, max: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..len {
        v.push(next(seed) % max + 1);
    }
    v.sort();
    return v;
}

fn show(nums: ref Vec[i64], n: i64) {
    println(f"{nums} n={n} -> {min_patches(nums, n)}");
}

fn main() {
    show([1, 3], 6);
    show([1, 5, 10], 20);
    show([1, 2, 2], 5);
    let empty: Vec[i64] = Vec.new();
    show(empty, 1);
    show(empty, 8);
    show(empty, 2147483647);
    show([1], 1);
    show([2], 1);
    show([1, 2, 31, 33], 2147483647);
    show([1, 1, 1, 1, 1, 1, 1, 1], 8);
    show([5, 6, 7], 100);
    show([1000000], 999999);
    let mut seed = 330;
    for round in 0..4 {
        let len = 5 + round * 5;
        let v = random_sorted(mut seed, len, 50 * (round + 1));
        let n = next(mut seed) % 5000 + 1;
        println(f"random {round}: len {len} n={n} -> {min_patches(v, n)}");
    }
    let big = random_sorted(mut seed, 1000, 1000000);
    println(f"big: len 1000 n=2147483647 -> {min_patches(big, 2147483647)}");
}
