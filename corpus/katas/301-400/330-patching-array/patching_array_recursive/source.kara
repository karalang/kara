// LeetCode #330: Patching Array — the same greedy, written as recursion.
//
// `cover(i, miss)` answers "how many patches still needed, given every sum
// in [1, miss) is reachable and nums[i..] is unused". Each call makes one
// greedy step and recurses on the rest, so the recursion is as deep as the
// loop in the star arm is long: at most len + 63 steps.
//
// O(len + log n) time, O(len + log n) stack.

fn cover(nums: ref Vec[i64], n: i64, i: i64, miss: i64) -> i64 {
    if miss > n {
        return 0;
    }
    if i < nums.len() and nums[i] <= miss {
        return cover(nums, n, i + 1, miss + nums[i]);
    }
    return 1 + cover(nums, n, i, miss + miss);
}

fn min_patches(nums: ref Vec[i64], n: i64) -> i64 {
    return cover(nums, n, 0, 1);
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

// A sorted array of `len` values in [1, max].
fn random_sorted(seed: mut ref i64, len: i64, max: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..len {
        v.push(next(seed) % max + 1);
    }
    v.sort();
    return v;
}

fn show(nums: ref Vec[i64], n: i64) {
    println(f"{nums} n={n} -> {min_patches(nums, n)}");
}

fn main() {
    show([1, 3], 6);
    show([1, 5, 10], 20);
    show([1, 2, 2], 5);
    let empty: Vec[i64] = Vec.new();
    show(empty, 1);
    show(empty, 8);
    show(empty, 2147483647);
    show([1], 1);
    show([2], 1);
    show([1, 2, 31, 33], 2147483647);
    show([1, 1, 1, 1, 1, 1, 1, 1], 8);
    show([5, 6, 7], 100);
    show([1000000], 999999);
    let mut seed = 330;
    for round in 0..4 {
        let len = 5 + round * 5;
        let v = random_sorted(mut seed, len, 50 * (round + 1));
        let n = next(mut seed) % 5000 + 1;
        println(f"random {round}: len {len} n={n} -> {min_patches(v, n)}");
    }
    let big = random_sorted(mut seed, 1000, 1000000);
    println(f"big: len 1000 n=2147483647 -> {min_patches(big, 2147483647)}");
}
