// LeetCode #379: Design Phone Directory -- a bitset of numbers in use.
//
// Bit n % 64 of word n / 64 is set while n is handed out. get() skips
// full words, takes the lowest clear bit of the first word that is not
// full, and sets it; the numbers past the end are set from the start, so
// the last word is full exactly when every real number is in use. check()
// and release() touch one bit. get() is O(n / 64); the rest are O(1).

struct PhoneDirectory {
    words: Vec[i64],
}

impl PhoneDirectory {
    fn new(max_numbers: i64) -> PhoneDirectory {
        let count = (max_numbers + 63) / 64;
        let mut words = vec![0; count];
        for n in max_numbers..count * 64 {
            words[n / 64] = words[n / 64] | (1 << (n % 64));
        }
        PhoneDirectory { words }
    }

    fn get(mut ref self) -> i64 {
        for w in 0..self.words.len() {
            if self.words[w] != -1 {
                let bit = (~self.words[w]).trailing_zeros();
                self.words[w] = self.words[w] | (1 << bit);
                return w * 64 + bit as i64;
            }
        }
        -1
    }

    fn check(ref self, number: i64) -> bool {
        (self.words[number / 64] >> (number % 64)) & 1 == 0
    }

    fn release(mut ref self, number: i64) {
        self.words[number / 64] = self.words[number / 64] & ~(1 << (number % 64));
    }
}

fn b(x: bool) -> String {
    if x { "true" } else { "false" }
}

fn main() {
    let mut d = PhoneDirectory.new(3);
    println(f"example: get {d.get()}, get {d.get()}, check 2 {b(d.check(2))}, get {d.get()}, check 2 {b(d.check(2))}");
    d.release(2);
    println(f"after release 2: check 2 {b(d.check(2))}, get {d.get()}");
    let mut one = PhoneDirectory.new(1);
    println(f"one number: get {one.get()}, get {one.get()}, check 0 {b(one.check(0))}");
    one.release(0);
    one.release(0);
    println(f"released twice: get {one.get()}, get {one.get()}");
    let mut e = PhoneDirectory.new(5);
    e.release(3);
    println(f"releasing a free number: get {e.get()}, get {e.get()}, get {e.get()}, get {e.get()}, get {e.get()}, get {e.get()}");
    let mut f = PhoneDirectory.new(6);
    for _ in 0..6 {
        f.get();
    }
    f.release(4);
    f.release(1);
    println(f"smallest free first: get {f.get()}, get {f.get()}, get {f.get()}");
    // Random directories of up to 1,000 numbers, each driven by 1,000
    // operations: half gets, a quarter checks, a quarter releases.
    let mut seed: i64 = 379;
    let mut checksum: i64 = 0;
    for _ in 0..100 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let m = 1 + (seed / 65536) % 1000;
        let mut dir = PhoneDirectory.new(m);
        for _ in 0..1000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let op = (seed / 65536) % 4;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let x = (seed / 65536) % m;
            let v = if op <= 1 {
                dir.get() + 1
            } else if op == 2 {
                if dir.check(x) { 1 } else { 0 }
            } else {
                dir.release(x);
                0
            };
            checksum = (checksum * 31 + v) % 1000000007;
        }
    }
    println(f"100 random directories: checksum {checksum}");
}
