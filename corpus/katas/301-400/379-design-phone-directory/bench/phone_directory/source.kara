// Benchmark for #379: one directory of 10,000 numbers, the problem's
// largest, driven by 20,000,000 random operations on the kata's segment
// tree of free counts: a quarter get, a quarter check and half release,
// so that about half the numbers are in use and most gets walk the tree.
// The tree is the arm that every mirror language can write the same way;
// the ★ arm's SortedSet has no counterpart in C or in Python's standard
// library.

struct PhoneDirectory {
    size: i64,
    free: Vec[i64],
}

impl PhoneDirectory {
    fn new(max_numbers: i64) -> PhoneDirectory {
        let mut size = 1;
        while size < max_numbers {
            size *= 2;
        }
        let mut free = vec![0; 2 * size];
        for n in 0..max_numbers {
            free[size + n] = 1;
        }
        let mut i = size - 1;
        while i >= 1 {
            free[i] = free[2 * i] + free[2 * i + 1];
            i -= 1;
        }
        PhoneDirectory { size, free }
    }

    fn set(mut ref self, number: i64, value: i64) {
        let mut i = self.size + number;
        self.free[i] = value;
        i /= 2;
        while i >= 1 {
            self.free[i] = self.free[2 * i] + self.free[2 * i + 1];
            i /= 2;
        }
    }

    fn get(mut ref self) -> i64 {
        if self.free[1] == 0 {
            return -1;
        }
        let mut i = 1;
        while i < self.size {
            i = if self.free[2 * i] > 0 { 2 * i } else { 2 * i + 1 };
        }
        let number = i - self.size;
        self.set(number, 0);
        number
    }

    fn check(ref self, number: i64) -> bool {
        self.free[self.size + number] == 1
    }

    fn release(mut ref self, number: i64) {
        self.set(number, 1);
    }
}

fn main() {
    let m = 10000;
    let mut dir = PhoneDirectory.new(m);
    let mut seed: i64 = 379;
    let mut checksum: i64 = 0;
    for _ in 0..20000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let op = (seed / 65536) % 4;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let x = (seed / 65536) % m;
        let v = if op == 0 {
            dir.get() + 1
        } else if op == 1 {
            if dir.check(x) { 1 } else { 0 }
        } else {
            dir.release(x);
            0
        };
        checksum = (checksum * 31 + v) % 1000000007;
    }
    println(f"checksum {checksum}");
}
