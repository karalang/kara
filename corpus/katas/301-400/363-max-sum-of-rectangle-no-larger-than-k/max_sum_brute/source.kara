// LeetCode #363: Max Sum of Rectangle No Larger Than K -- every rectangle
// from a table of 2D prefix sums.
//
// at[r][c] holds the sum of the cells above and left of (r, c), so any
// rectangle's sum is four lookups. Try all O(m^2 n^2) rectangles and keep
// the largest sum at most k. The reference the other arms are checked
// against.

fn max_sum_submatrix(matrix: ref Vec[Vec[i64]], k: i64) -> i64 {
    let rows = matrix.len();
    let cols = matrix[0].len();
    let mut at = vec![vec![0; cols + 1]; rows + 1];
    for r in 0..rows {
        for c in 0..cols {
            at[r + 1][c + 1] = matrix[r][c] + at[r][c + 1] + at[r + 1][c] - at[r][c];
        }
    }
    let mut best = i64.MIN;
    for r1 in 0..rows {
        for r2 in r1 + 1..rows + 1 {
            for c1 in 0..cols {
                for c2 in c1 + 1..cols + 1 {
                    let sum = at[r2][c2] - at[r1][c2] - at[r2][c1] + at[r1][c1];
                    if sum <= k and sum > best {
                        best = sum;
                    }
                }
            }
        }
    }
    best
}

fn show(label: String, matrix: Vec[Vec[i64]], k: i64) {
    println(f"{label}: {max_sum_submatrix(matrix, k)}");
}

fn main() {
    show("example 1", vec![vec![1, 0, 1], vec![0, -2, 3]], 2);
    show("example 2", vec![vec![2, 2, -1]], 3);
    show("one cell equal to k", vec![vec![5]], 5);
    show("one cell below k", vec![vec![-7]], 0);
    show("only a negative run fits", vec![vec![3, -4, 3]], -1);
    show("negative k", vec![vec![-2, -3], vec![-1, -4]], -5);
    show("k above the total", vec![vec![1, 2], vec![3, 4]], 100);
    show("the best fit is not the largest", vec![vec![5, -4, -3, 4], vec![-3, -4, 4, 5], vec![5, 1, 5, -4]], 10);
    show("one column", vec![vec![2], vec![-1], vec![3], vec![-5], vec![4]], 3);
    show("values at the bounds", vec![vec![100, -100], vec![-100, 100]], 0);
    let mut wide: Vec[i64] = Vec.new();
    for i in 0..60 {
        wide.push(if i % 2 == 0 { 3 } else { -2 });
    }
    show("a wide row", vec![wide], 7);

    // Random matrices up to 12 x 12 with k no smaller than the least cell,
    // so some rectangle always fits.
    let mut seed: i64 = 363;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let rows = 1 + (seed / 65536) % 12;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let cols = 1 + (seed / 65536) % 12;
        let mut matrix: Vec[Vec[i64]] = Vec.new();
        let mut least = 100;
        for _ in 0..rows {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..cols {
                seed = (seed * 1103515245 + 12345) % 2147483648;
                let v = (seed / 65536) % 201 - 100;
                least = least.min(v);
                row.push(v);
            }
            matrix.push(row);
        }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = least.max((seed / 65536) % 601 - 300);
        checksum = (checksum * 31 + max_sum_submatrix(matrix, k) + 1000000) % 1000000007;
    }
    println(f"300 random matrices: checksum {checksum}");
}
