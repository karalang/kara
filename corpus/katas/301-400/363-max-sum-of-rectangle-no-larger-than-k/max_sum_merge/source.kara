// LeetCode #363: Max Sum of Rectangle No Larger Than K -- column sums per
// row pair and a merge sort of the prefix sums.
//
// As in the ordered-set arm, each row pair reduces the problem to the best
// prefix[j] - prefix[i] <= k with i < j. Merge sort the prefixes: before
// merging two sorted halves, every pair with i in the left half and j in
// the right is examined by one pointer walk, because as prefix[i] grows the
// largest right-half prefix at most prefix[i] + k only moves right.
// O(m^2 n log n), with no tree.

fn best_pair(p: mut ref Vec[i64], lo: i64, hi: i64, k: i64, scratch: mut ref Vec[i64]) -> i64 {
    // The best p[j] - p[i] <= k with lo <= i < j < hi; sorts p[lo..hi].
    if hi - lo < 2 {
        return i64.MIN;
    }
    let mid = (lo + hi) / 2;
    let mut best = best_pair(mut p, lo, mid, k, mut scratch).max(best_pair(mut p, mid, hi, k, mut scratch));
    let mut j = mid;
    for i in lo..mid {
        while j < hi and p[j] <= p[i] + k {
            j += 1;
        }
        if j > mid {
            best = best.max(p[j - 1] - p[i]);
        }
    }
    let mut a = lo;
    let mut b = mid;
    let mut out = lo;
    while a < mid or b < hi {
        if b == hi or (a < mid and p[a] <= p[b]) {
            scratch[out] = p[a];
            a += 1;
        } else {
            scratch[out] = p[b];
            b += 1;
        }
        out += 1;
    }
    for i in lo..hi {
        p[i] = scratch[i];
    }
    best
}

fn max_sum_submatrix(matrix: ref Vec[Vec[i64]], k: i64) -> i64 {
    let rows = matrix.len();
    let cols = matrix[0].len();
    let mut best = i64.MIN;
    let mut scratch = vec![0; cols + 1];
    for top in 0..rows {
        let mut sums = vec![0; cols];
        for bottom in top..rows {
            for c in 0..cols {
                sums[c] += matrix[bottom][c];
            }
            let mut prefix = vec![0; cols + 1];
            for c in 0..cols {
                prefix[c + 1] = prefix[c] + sums[c];
            }
            best = best.max(best_pair(mut prefix, 0, cols + 1, k, mut scratch));
        }
    }
    best
}

fn show(label: String, matrix: Vec[Vec[i64]], k: i64) {
    println(f"{label}: {max_sum_submatrix(matrix, k)}");
}

fn main() {
    show("example 1", vec![vec![1, 0, 1], vec![0, -2, 3]], 2);
    show("example 2", vec![vec![2, 2, -1]], 3);
    show("one cell equal to k", vec![vec![5]], 5);
    show("one cell below k", vec![vec![-7]], 0);
    show("only a negative run fits", vec![vec![3, -4, 3]], -1);
    show("negative k", vec![vec![-2, -3], vec![-1, -4]], -5);
    show("k above the total", vec![vec![1, 2], vec![3, 4]], 100);
    show("the best fit is not the largest", vec![vec![5, -4, -3, 4], vec![-3, -4, 4, 5], vec![5, 1, 5, -4]], 10);
    show("one column", vec![vec![2], vec![-1], vec![3], vec![-5], vec![4]], 3);
    show("values at the bounds", vec![vec![100, -100], vec![-100, 100]], 0);
    let mut wide: Vec[i64] = Vec.new();
    for i in 0..60 {
        wide.push(if i % 2 == 0 { 3 } else { -2 });
    }
    show("a wide row", vec![wide], 7);

    // Random matrices up to 12 x 12 with k no smaller than the least cell,
    // so some rectangle always fits.
    let mut seed: i64 = 363;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let rows = 1 + (seed / 65536) % 12;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let cols = 1 + (seed / 65536) % 12;
        let mut matrix: Vec[Vec[i64]] = Vec.new();
        let mut least = 100;
        for _ in 0..rows {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..cols {
                seed = (seed * 1103515245 + 12345) % 2147483648;
                let v = (seed / 65536) % 201 - 100;
                least = least.min(v);
                row.push(v);
            }
            matrix.push(row);
        }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = least.max((seed / 65536) % 601 - 300);
        checksum = (checksum * 31 + max_sum_submatrix(matrix, k) + 1000000) % 1000000007;
    }
    println(f"300 random matrices: checksum {checksum}");
}
