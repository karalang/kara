// LeetCode #327: Count of Range Sum — a Fenwick tree over ranked prefix sums.
//
// Walk the prefix sums p[0], p[1], ... in order. When p[b] arrives, the pairs
// it closes are the earlier p[a] with p[b] - upper <= p[a] <= p[b] - lower,
// so count the earlier values in that interval, then add p[b]. A Fenwick tree
// answers "how many inserted values are at most x" in O(log n), once the
// values are replaced by their rank among all prefix sums: sort them, drop
// duplicates, and find a value's rank by binary search.
//
// O(n log n) time, O(n) space.

// The number of values in `sorted` that are <= x.
fn rank_at_most(sorted: ref Vec[i64], x: i64) -> i64 {
    let mut lo = 0;
    let mut hi = sorted.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if sorted[mid] <= x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// Add one at 1-based position i.
fn bit_add(tree: mut ref Vec[i64], i: i64) {
    let mut k = i;
    while k < tree.len() {
        tree[k] += 1;
        k += k & -k;
    }
}

// The total over positions 1..=i.
fn bit_sum(tree: ref Vec[i64], i: i64) -> i64 {
    let mut k = i;
    let mut s = 0;
    while k > 0 {
        s += tree[k];
        k -= k & -k;
    }
    return s;
}

fn count_range_sum(nums: ref Vec[i64], lower: i64, upper: i64) -> i64 {
    let mut p: Vec[i64] = Vec.new();
    p.push(0);
    let mut s = 0;
    for x in nums {
        s += x;
        p.push(s);
    }
    let mut sorted = p.clone();
    sorted.sort();
    sorted.dedup();

    let mut tree: Vec[i64] = Vec.new();
    for _ in 0..sorted.len() + 1 {
        tree.push(0);
    }
    let mut count = 0;
    for v in p {
        // Earlier values in [v - upper, v - lower]: at most (v - lower),
        // minus those below (v - upper).
        count += bit_sum(tree, rank_at_most(sorted, v - lower)) - bit_sum(tree, rank_at_most(sorted, v - upper - 1));
        bit_add(mut tree, rank_at_most(sorted, v));
    }
    return count;
}

fn report(nums: ref Vec[i64], lower: i64, upper: i64) {
    println(f"{nums} [{lower}, {upper}] -> {count_range_sum(nums, lower, upper)}");
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn random_input(n: i64, r: i64, seed: mut ref i64) -> Vec[i64] {
    let mut a: Vec[i64] = Vec.new();
    for _ in 0..n {
        a.push(next(seed) % (2 * r + 1) - r);
    }
    return a;
}

const I32_MIN: i64 = -2147483648;
const I32_MAX: i64 = 2147483647;

fn main() {
    // The examples from the problem statement.
    report([-2, 5, -1], -2, 2);
    report([0], 0, 0);

    // Edge cases.
    report([1], 0, 0);
    report([5], 5, 5);
    report([0, 0, 0], 0, 0);
    report([1, -1, 1, -1], 0, 0);
    report([3, 3, 3], 4, 5);
    report([1, 2, 3], -100, 100);
    report([-1, -2, -3], 1, 100);
    report([2, -2, 2, -2, 2], -1, 1);

    // Values at the 32-bit limits, so the sums need 64 bits.
    report([I32_MAX, I32_MAX, I32_MAX], 4294967294, 6442450941);
    report([I32_MIN, I32_MAX, I32_MIN], I32_MIN, -1);

    // Random inputs, small enough to print.
    let mut seed = 327;
    for t in 0..4 {
        let nums = random_input(8, 5, mut seed);
        report(nums, t - 2, t + 2);
    }

    // Larger random inputs, reported by count only.
    for n in [500, 2000, 3000] {
        let nums = random_input(n, 100, mut seed);
        for w in [0, 10, 100, 1000] {
            println(f"n={n} w={w} -> {count_range_sum(nums, -w, w)}");
        }
    }
}
