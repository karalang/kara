// LeetCode #381: differential test. The Map, SortedMap, scanning and
// linked-list arms against a counting oracle, over 1,000 random
// workloads of 300 operations on values from -5 to 4, so that most
// values have several copies. Properties: P1 insert and remove answer as
// the oracle does; P2 get_random returns a value with a copy present; P3
// all four arms draw the same value, since they lay the elements out the
// same way; P4 len() is the oracle's total; P5 after each workload, every
// arm holds exactly the oracle's number of copies of each value.

struct MapArm {
    vals: Vec[i64],
    slot: Vec[i64],
    positions: Map[i64, Vec[i64]],
    seed: i64,
}

impl MapArm {
    fn new() -> MapArm {
        MapArm { vals: Vec.new(), slot: Vec.new(), positions: Map.new(), seed: 381 }
    }

    // True when val was not present before.
    fn insert(mut ref self, val: i64) -> bool {
        let p = self.vals.len();
        self.vals.push(val);
        let list = self.positions.entry(val).or_insert(Vec.new());
        self.slot.push(list.len());
        list.push(p);
        list.len() == 1
    }

    // Removes one copy of val; true when there was one.
    fn remove(mut ref self, val: i64) -> bool {
        if not self.positions.contains_key(val) {
            return false;
        }
        let p = self.positions[val].pop().unwrap();
        if self.positions[val].is_empty() {
            self.positions.remove(val);
        }
        let last = self.vals.len() - 1;
        if p < last {
            let moved = self.vals[last];
            let k = self.slot[last];
            self.vals[p] = moved;
            self.slot[p] = k;
            self.positions[moved][k] = p;
        }
        self.vals.pop();
        self.slot.pop();
        true
    }

    // Each element is equally likely, so a value is drawn in proportion
    // to its count. A seeded LCG picks the position, so that every arm,
    // and every run, draws the same values.
    fn get_random(mut ref self) -> i64 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        self.vals[(self.seed / 65536) % self.vals.len()]
    }

    fn len(self) -> i64 {
        self.vals.len()
    }

    // Test helper: the number of copies of v.
    fn count(self, v: i64) -> i64 {
        let mut n = 0;
        for x in self.vals.iter() {
            if *x == v {
                n += 1;
            }
        }
        n
    }
}

struct SortedArm {
    vals: Vec[i64],
    slot: Vec[i64],
    positions: SortedMap[i64, Vec[i64]],
    seed: i64,
}

impl SortedArm {
    fn new() -> SortedArm {
        SortedArm { vals: Vec.new(), slot: Vec.new(), positions: SortedMap.new(), seed: 381 }
    }

    // True when val was not present before.
    fn insert(mut ref self, val: i64) -> bool {
        let p = self.vals.len();
        self.vals.push(val);
        let list = self.positions.entry(val).or_insert(Vec.new());
        self.slot.push(list.len());
        list.push(p);
        list.len() == 1
    }

    // Removes one copy of val; true when there was one.
    fn remove(mut ref self, val: i64) -> bool {
        if not self.positions.contains_key(val) {
            return false;
        }
        let p = self.positions[val].pop().unwrap();
        if self.positions[val].is_empty() {
            self.positions.remove(val);
        }
        let last = self.vals.len() - 1;
        if p < last {
            let moved = self.vals[last];
            let k = self.slot[last];
            self.vals[p] = moved;
            self.slot[p] = k;
            self.positions[moved][k] = p;
        }
        self.vals.pop();
        self.slot.pop();
        true
    }

    // Each element is equally likely, so a value is drawn in proportion
    // to its count. A seeded LCG picks the position, so that every arm,
    // and every run, draws the same values.
    fn get_random(mut ref self) -> i64 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
