// LeetCode #381: Insert Delete GetRandom O(1) - Duplicates allowed -- a
// Vec, and a Map from each value to the positions holding it.
//
// As in #380 the values live in a Vec, so a random element is a random
// position, and each copy of a value is equally likely. A value now has
// several positions, kept in a list per value; `slot[p]` says where in
// its value's list position p sits. Removing a value takes the last
// position off its list, moves the Vec's last element into that position
// and fixes that one list entry through `slot`. Every operation is O(1)
// on average.
//
// The list is in insertion order and moving an element keeps its list
// entry, so remove always takes the most recently inserted copy that is
// still present. Every arm removes that copy, so all of them lay the Vec
// out the same way and the same draws give the same values.

struct RandomizedCollection {
    vals: Vec[i64],
    slot: Vec[i64],
    positions: Map[i64, Vec[i64]],
    seed: i64,
}

impl RandomizedCollection {
    fn new() -> RandomizedCollection {
        RandomizedCollection { vals: Vec.new(), slot: Vec.new(), positions: Map.new(), seed: 381 }
    }

    // True when val was not present before.
    fn insert(mut ref self, val: i64) -> bool {
        let p = self.vals.len();
        self.vals.push(val);
        let list = self.positions.entry(val).or_insert(Vec.new());
        self.slot.push(list.len());
        list.push(p);
        list.len() == 1
    }

    // Removes one copy of val; true when there was one.
    fn remove(mut ref self, val: i64) -> bool {
        if not self.positions.contains_key(val) {
            return false;
        }
        let p = self.positions[val].pop().unwrap();
        if self.positions[val].is_empty() {
            self.positions.remove(val);
        }
        let last = self.vals.len() - 1;
        if p < last {
            let moved = self.vals[last];
            let k = self.slot[last];
            self.vals[p] = moved;
            self.slot[p] = k;
            self.positions[moved][k] = p;
        }
        self.vals.pop();
        self.slot.pop();
        true
    }

    // Each element is equally likely, so a value is drawn in proportion
    // to its count. A seeded LCG picks the position, so that every arm,
    // and every run, draws the same values.
    fn get_random(mut ref self) -> i64 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        self.vals[(self.seed / 65536) % self.vals.len()]
    }

    fn len(self) -> i64 {
        self.vals.len()
    }
}

fn b(x: bool) -> String {
    if x { "true" } else { "false" }
}

fn main() {
    let mut c = RandomizedCollection.new();
    println(f"example: insert 1 {b(c.insert(1))}, insert 1 {b(c.insert(1))}, insert 2 {b(c.insert(2))}");
    let r = c.get_random();
    println(f"get_random is 1 or 2: {b(r == 1 or r == 2)}");
    println(f"remove 1 {b(c.remove(1))}, get_random {c.get_random()}");
    let mut e = RandomizedCollection.new();
    println(f"remove from empty: {b(e.remove(5))}");
    let a1 = e.insert(-4);
    let a2 = e.insert(-4);
    let a3 = e.insert(-4);
    println(f"three copies: insert {b(a1)} {b(a2)} {b(a3)}, len {e.len()}");
    let r1 = e.remove(-4);
    let r2 = e.remove(-4);
    let r3 = e.remove(-4);
    let r4 = e.remove(-4);
    println(f"remove them: {b(r1)} {b(r2)} {b(r3)} {b(r4)}, len {e.len()}, insert again {b(e.insert(-4))}");
    // One 1 and three 2s: about three draws in four are a 2.
    let mut w = RandomizedCollection.new();
    w.insert(1);
    for _ in 0..3 {
        w.insert(2);
    }
    let mut twos = 0;
    for _ in 0..400 {
        if w.get_random() == 2 {
            twos += 1;
        }
    }
    println(f"one 1 and three 2s: {twos} of 400 draws are 2");
    // Removing copies from the front, the middle and the end of the Vec.
    let mut m = RandomizedCollection.new();
    for v in 0..12 {
        m.insert(v % 4);
    }
    m.remove(0);
    m.remove(3);
    m.remove(1);
    m.remove(0);
    let mut total = 0;
    for _ in 0..100 {
        total += m.get_random();
    }
    println(f"after four removals: len {m.len()}, sum of 100 draws {total}");
    // Random workloads: 100 collections driven by 1,000 operations each
    // over values from -10 to 9, so that most values have several copies:
    // 2 in 5 insert, 3 in 10 remove, 3 in 10 get_random (only when the
    // collection is not empty).
    let mut seed: i64 = 381;
    let mut checksum: i64 = 0;
    let mut most = 0;
    for _ in 0..100 {
        let mut rc = RandomizedCollection.new();
        for _ in 0..1000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let op = (seed / 65536) % 10;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let x = (seed / 65536) % 20 - 10;
            let v = if op < 4 {
                if rc.insert(x) { 1 } else { 0 }
            } else if op < 7 {
                if rc.remove(x) { 1 } else { 0 }
            } else if rc.len() > 0 {
                rc.get_random() + 100
            } else {
                7
            };
            checksum = (checksum * 31 + v) % 1000000007;
            most = most.max(rc.len());
        }
    }
    println(f"100 random workloads: checksum {checksum}, largest size {most}");
}
