// LeetCode #324: Wiggle Sort II — sort, then interleave both halves from the
// top.
//
// Reorder `nums` in place so that nums[0] < nums[1] > nums[2] < nums[3] ...
// The input is promised to have such an order.
//
//   [1, 5, 1, 1, 6, 4]  ->  [1, 6, 1, 5, 1, 4]
//   [1, 3, 2, 2, 3, 1]  ->  [2, 3, 1, 3, 1, 2]
//
// Sort a copy. The smaller half (the first (n + 1) / 2 values) goes into the
// even slots, the larger half into the odd slots, so every odd slot holds a
// value from the top half and its neighbours come from the bottom half.
//
// Both halves are laid down DESCENDING, and that is the whole trick. Equal
// values are what make this problem hard: a value can straddle the two halves,
// and then a copy of it sits in an even slot and another in an odd slot. Laying
// the small half down in descending order puts its copies of the median at the
// FRONT of the even slots, and laying the large half down descending puts its
// copies of the median at the BACK of the odd slots, so the two runs of the
// median end up at opposite ends and never touch. Ascending order puts them
// side by side: [4, 5, 5, 6] comes out [4, 5, 5, 6], which is not a wiggle,
// where descending gives [5, 6, 4, 5].
//
// O(n log n) time for the sort, O(n) extra space for the copy.

fn wiggle_sort(nums: mut ref Vec[i64]) {
    let n = nums.len();
    let mut s = nums.clone();
    s.sort();
    let half = (n + 1) / 2;
    let mut lo = half - 1;
    let mut hi = n - 1;
    let mut i = 0;
    while i < n {
        if i % 2 == 0 {
            nums[i] = s[lo];
            lo -= 1;
        } else {
            nums[i] = s[hi];
            hi -= 1;
        }
        i += 1;
    }
}

fn is_wiggle(a: ref Vec[i64]) -> bool {
    for i in 1..a.len() {
        if i % 2 == 1 and a[i] <= a[i - 1] {
            return false;
        }
        if i % 2 == 0 and a[i] >= a[i - 1] {
            return false;
        }
    }
    return true;
}

// Same values with the same counts, compared by sorting both.
fn same_values(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut x = a.clone();
    let mut y = b.clone();
    x.sort();
    y.sort();
    for i in 0..x.len() {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}

fn show(a: ref Vec[i64]) -> String {
    let mut s = String.new();
    s.push('[');
    for i in 0..a.len() {
        if i > 0 { s.push_str(", "); }
        s.push_str(f"{a[i]}");
    }
    s.push(']');
    return s;
}

fn verdict(out: ref Vec[i64], input: ref Vec[i64]) -> String {
    if not same_values(out, input) {
        return "NOT A PERMUTATION";
    }
    if not is_wiggle(out) {
        return "NOT A WIGGLE";
    }
    return "ok";
}

fn report(input: Vec[i64]) {
    let mut nums = input.clone();
    wiggle_sort(mut nums);
    println(f"{show(input)} -> {show(nums)} {verdict(nums, input)}");
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

// An input that is known to have an answer: build a wiggle directly (even
// slots from [0, k), odd slots from [k, 2k)), then shuffle it. Small `k` means
// many repeats, which is the hard case.
fn wiggle_input(n: i64, k: i64, seed: mut ref i64) -> Vec[i64] {
    let mut a: Vec[i64] = Vec.new();
    for i in 0..n {
        if i % 2 == 0 {
            a.push(next(seed) % k);
        } else {
            a.push(k + next(seed) % k);
        }
    }
    // Fisher-Yates.
    let mut i = n - 1;
    while i > 0 {
        let j = next(seed) % (i + 1);
        a.swap(i, j);
        i -= 1;
    }
    return a;
}

// Order-sensitive, so two arms that agree on it agree on the arrangement.
fn checksum(a: ref Vec[i64]) -> i64 {
    let mut h = 0;
    for i in 0..a.len() {
        h = (h * 31 + a[i] + 1) % 1000000007;
    }
    return h;
}

fn main() {
    // The two examples from the problem statement.
    report([1, 5, 1, 1, 6, 4]);
    report([1, 3, 2, 2, 3, 1]);

    // The smallest inputs.
    report([7]);
    report([2, 1]);
    report([1, 1, 2]);

    // The median straddles the halves: ascending interleave fails all three.
    report([4, 5, 5, 6]);
    report([5, 6, 5, 6, 5, 6]);
    report([1, 1, 2, 2, 2, 3]);

    // The largest value the problem allows, 5000, on both sides of a slot.
    report([0, 5000, 0, 5000, 4999]);

    // Already a wiggle, and sorted descending.
    report([1, 3, 2, 4, 3, 5]);
    report([9, 8, 7, 6, 5, 4, 3]);

    // Small random inputs: every arm prints these.
    let mut seed = 324;
    let mut sizes: Vec[i64] = [5, 8, 11];
    for t in 0..sizes.len() {
        report(wiggle_input(sizes[t], 2 + t, mut seed));
    }

    // Large random inputs. Values stay within the problem's 0..5000.
    let mut big: Vec[i64] = [1000, 20001, 50000];
    let mut ks: Vec[i64] = [3, 50, 2500];
    for t in 0..big.len() {
        let input = wiggle_input(big[t], ks[t], mut seed);
        let mut nums = input.clone();
        wiggle_sort(mut nums);
        println(f"n={big[t]} k={ks[t]} -> {checksum(nums)} {verdict(nums, input)}");
    }
}
