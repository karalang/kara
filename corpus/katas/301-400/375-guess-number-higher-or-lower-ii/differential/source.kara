// LeetCode #375: differential test. The by-length, memoized, by-column and
// deque arms against a minimax oracle, for every n from 1 to 70.
// Properties: P1 each arm gives the oracle's cost; P2 the cost never falls
// as n grows; P3 cost(n + 1) <= n + cost(n - 1), from guessing n first;
// P4 and P5 the cost is at most what binary search pays in the worst case,
// guessing the lower and the upper middle.

fn length_arm(n: i64) -> i64 {
    let mut cost: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 2 {
        cost.push(vec![0; n + 2]);
    }
    for len in 2..n + 1 {
        for i in 1..n - len + 2 {
            let j = i + len - 1;
            let mut best = i64.MAX;
            for k in i..j + 1 {
                let worse = cost[i][k - 1].max(cost[k + 1][j]);
                best = best.min(k + worse);
            }
            cost[i][j] = best;
        }
    }
    cost[1][n]
}

fn memo_solve(memo: mut ref Vec[Vec[i64]], i: i64, j: i64) -> i64 {
    if i >= j {
        return 0;
    }
    if memo[i][j] >= 0 {
        return memo[i][j];
    }
    let mut best = i64.MAX;
    for k in i..j + 1 {
        let left = memo_solve(mut memo, i, k - 1);
        let right = memo_solve(mut memo, k + 1, j);
        best = best.min(k + left.max(right));
    }
    memo[i][j] = best;
    best
}

fn memo_arm(n: i64) -> i64 {
    let mut memo: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 2 {
        memo.push(vec![-1; n + 2]);
    }
    memo_solve(mut memo, 1, n)
}

fn columns_arm(n: i64) -> i64 {
    let mut cost: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 2 {
        cost.push(vec![0; n + 2]);
    }
    for j in 2..n + 1 {
        let mut i = j - 1;
        while i >= 1 {
            let mut best = i64.MAX;
            for k in i..j + 1 {
                best = best.min(k + cost[i][k - 1].max(cost[k + 1][j]));
            }
            cost[i][j] = best;
            i -= 1;
        }
    }
    cost[1][n]
}

fn deque_arm(n: i64) -> i64 {
    let mut cost: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 2 {
        cost.push(vec![0; n + 2]);
    }
    for j in 2..n + 1 {
        let mut k0 = j;
        let mut window: VecDeque[i64] = VecDeque.new();
        window.push_back(j);
        let mut i = j - 1;
        while i >= 1 {
            while cost[i][k0 - 1] > cost[k0 + 1][j] {
                k0 -= 1;
            }
            let value = i + cost[i + 1][j];
            while not window.is_empty() and window.back().unwrap() + cost[window.back().unwrap() + 1][j] >= value {
                let _gone = window.pop_back();
            }
            window.push_back(i);
            while window.front().unwrap() > k0 {
                let _gone = window.pop_front();
            }
            let front = window.front().unwrap();
            let mut best = front + cost[front + 1][j];
            if k0 + 1 <= j {
                best = best.min(k0 + 1 + cost[i][k0]);
            }
            cost[i][j] = best;
            i -= 1;
        }
    }
    cost[1][n]
}

// The definition, with no table: try every guess and recurse. Exponential,
// so only for short ranges.
fn brute(lo: i64, hi: i64) -> i64 {
    if lo >= hi {
        return 0;
    }
    let mut best = i64.MAX;
    for k in lo..hi + 1 {
        best = best.min(k + brute(lo, k - 1).max(brute(k + 1, hi)));
    }
    best
}

// The same definition with each range remembered in a map, for the rest.
fn minimax(lo: i64, hi: i64, seen: mut ref Map[i64, i64]) -> i64 {
    if lo >= hi {
        return 0;
    }
    let key = lo * 1000 + hi;
    match seen.get(key) {
        Some(v) => return v,
        None => {}
    }
    let mut best = i64.MAX;
    for k in lo..hi + 1 {
        best = best.min(k + minimax(lo, k - 1, mut seen).max(minimax(k + 1, hi, mut seen)));
    }
    seen.insert(key, best);
    best
}

fn oracle(n: i64, seen: mut ref Map[i64, i64]) -> i64 {
    if n <= 10 {
        brute(1, n)
    } else {
        minimax(1, n, mut seen)
    }
}

// What a fixed strategy pays in the worst case: guess the middle of the
// range, rounding up or down, and take the dearer side.
fn binary_worst(lo: i64, hi: i64, round_up: bool) -> i64 {
    if lo >= hi {
        return 0;
    }
    let mid = if round_up { (lo + hi + 1) / 2 } else { (lo + hi) / 2 };
    mid + binary_worst(lo, mid - 1, round_up).max(binary_worst(mid + 1, hi, round_up))
}

fn answer(arm: i64, n: i64) -> i64 {
    match arm {
        0 => length_arm(n),
        1 => memo_arm(n),
        2 => columns_arm(n),
        _ => deque_arm(n),
    }
}

fn name(arm: i64) -> String {
    match arm {
        0 => "length",
        1 => "memo",
        2 => "columns",
        _ => "deque",
    }
}

fn main() {
    let top = 70;
    let mut checks = 0;
    let mut failures = 0;
    let mut fails = vec![0; 5];
    let mut seen: Map[i64, i64] = Map.new();
    let mut expected: Vec[i64] = vec![0];
    for n in 1..top + 1 {
        expected.push(oracle(n, mut seen));
    }
    for arm in 0..4 {
        // cost[n] for n from 0 to top + 1; n = 0 is never read.
        let mut cost: Vec[i64] = vec![0];
        for n in 1..top + 2 {
            cost.push(answer(arm, n));
        }
        for n in 1..top + 1 {
            let got = cost[n];
            let mut bad = vec![false; 5];
            checks += 1;
            if got != expected[n] {
                bad[0] = true;
            }
            checks += 1;
            if cost[n + 1] < got {
                bad[1] = true;
            }
            checks += 1;
            if n >= 2 and cost[n + 1] > n + cost[n - 1] {
                bad[2] = true;
            }
            checks += 1;
            if got > binary_worst(1, n, false) {
                bad[3] = true;
            }
            checks += 1;
            if got > binary_worst(1, n, true) {
                bad[4] = true;
            }
            for p in 0..5 {
                if bad[p] {
                    fails[p] += 1;
                    failures += 1;
                    if failures <= 5 {
                        println(f"FAIL P{p + 1} {name(arm)} n={n} got={got} expected={expected[n]}");
                    }
                }
            }
        }
    }
    for p in 0..5 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    println(f"n = 1 to {top}, {checks} checks, {failures} failures");
}
