// LeetCode #375: Guess Number Higher or Lower II -- fill by column.
//
// The star arm's recurrence in a different order: j rises from 2 to n and,
// for each j, i falls from j - 1 to 1. cost[i][j] reads cost[i][k - 1],
// the same row with a smaller j, filled in an earlier column, and
// cost[k + 1][j], the same column with a larger i, filled earlier in this
// one. This is the order the deque arm needs, without the deque. O(n^3).

fn get_money_amount(n: i64) -> i64 {
    let mut cost: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 2 {
        cost.push(vec![0; n + 2]);
    }
    for j in 2..n + 1 {
        let mut i = j - 1;
        while i >= 1 {
            let mut best = i64.MAX;
            for k in i..j + 1 {
                best = best.min(k + cost[i][k - 1].max(cost[k + 1][j]));
            }
            cost[i][j] = best;
            i -= 1;
        }
    }
    cost[1][n]
}

fn main() {
    println(f"example 1: {get_money_amount(10)}");
    println(f"example 2: {get_money_amount(1)}");
    println(f"example 3: {get_money_amount(2)}");
    let mut first: Vec[i64] = Vec.new();
    for n in 1..21 {
        first.push(get_money_amount(n));
    }
    println(f"n = 1 to 20: {first}");
    println(f"n = 100: {get_money_amount(100)}");
    println(f"n = 200, the largest: {get_money_amount(200)}");
    // Every n from 1 to 60, folded into a checksum.
    let mut checksum: i64 = 0;
    for n in 1..61 {
        checksum = (checksum * 1009 + get_money_amount(n)) % 1000000007;
    }
    println(f"n = 1 to 60: checksum {checksum}");
}
