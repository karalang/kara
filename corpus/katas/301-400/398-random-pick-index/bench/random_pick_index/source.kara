// Benchmark for #398: the kata's ★ arm (reservoir sampling). One array of
// 20,000 values (the problem's limit) from 0 to 9, from an LCG, then
// 10,000 picks (the problem's limit), each for a target from 0 to 9. The
// picked indices go into a sum and a checksum.

struct Solution {
    nums: Vec[i64],
    seed: i64,
}

impl Solution {
    fn new(nums: own Vec[i64]) -> Solution {
        Solution { nums, seed: 398 }
    }

    // A number from 0 to n - 1.
    fn below(mut ref self, n: i64) -> i64 {
        self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
        (self.seed / 65536) % n
    }

    fn pick(mut ref self, target: i64) -> i64 {
        let mut kept = -1;
        let mut seen = 0;
        for i in 0..self.nums.len() {
            if self.nums[i] == target {
                seen += 1;
                if self.below(seen) == 0 {
                    kept = i;
                }
            }
        }
        kept
    }
}

fn main() {
    let picks = 10000;
    let mut seed: i64 = 3980;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..20000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        nums.push((seed / 65536) % 10);
    }
    let mut s = Solution.new(nums);
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for p in 0..picks {
        let r = s.pick(p % 10);
        total += r;
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"{picks} picks: total {total}, checksum {checksum}");
}
