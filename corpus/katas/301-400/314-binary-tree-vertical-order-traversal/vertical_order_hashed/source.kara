// LeetCode #314: Binary Tree Vertical Order Traversal — hash map, then sort the keys.
//
// The textbook LeetCode answer: a breadth-first walk appending into a hash
// map from column to values, then the keys sorted for the read-out. The map
// is what most submissions reach for; the sort is the price of it, since a
// hash map's iteration order is meaningless (and, in Kāra, different on every
// run). The ★ arm pays for an ordered map instead; the `_offset` arm pays for
// a second pass. Same walk, three ways of getting the columns into order.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn node(v: i64, l: Option[TreeNode], r: Option[TreeNode]) -> Option[TreeNode] {
    return Some(TreeNode { val: v, left: l, right: r });
}

fn leaf(v: i64) -> Option[TreeNode] {
    return node(v, None, None);
}

fn vertical_order(root: Option[TreeNode]) -> Vec[Vec[i64]] {
    let mut cols: Map[i64, Vec[i64]] = Map.new();
    let mut q: VecDeque[(TreeNode, i64)] = VecDeque.new();
    match root {
        None => {}
        Some(n) => { q.push_back((n, 0)); }
    }
    while q.len() > 0 {
        match q.pop_front() {
            None => {}
            Some(item) => {
                let (n, c) = item;
                cols.entry(c).or_insert(Vec.new()).push(n.val);
                match n.left {
                    None => {}
                    Some(l) => { q.push_back((l, c - 1)); }
                }
                match n.right {
                    None => {}
                    Some(r) => { q.push_back((r, c + 1)); }
                }
            }
        }
    }
    let mut keys: Vec[i64] = cols.keys();
    keys.sort();
    let mut out: Vec[Vec[i64]] = Vec.new();
    for i in 0..keys.len() {
        out.push(cols[keys[i]].clone());
    }
    return out;
}

// ------------------------------------------------------------- demo ---

fn fmt(cols: ref Vec[Vec[i64]]) -> String {
    let mut s = "[".to_string();
    for i in 0..cols.len() {
        if i > 0 { s = s + ","; }
        s = s + "[";
        for j in 0..cols[i].len() {
            if j > 0 { s = s + ","; }
            let v = cols[i][j];
            s = s + v.to_string();
        }
        s = s + "]";
    }
    return s + "]";
}

fn left_spine(n: i64) -> Option[TreeNode] {
    if n <= 0 { return None; }
    return node(-n, left_spine(n - 1), None);
}

fn main() {
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    // LeetCode's three examples.
    trees.push(node(3, leaf(9), node(20, leaf(15), leaf(7))));
    trees.push(node(3, node(9, leaf(4), leaf(0)), node(8, leaf(1), leaf(7))));
    trees.push(node(3, node(9, leaf(4), node(0, None, leaf(2))),
                       node(8, node(1, leaf(5), None), leaf(7))));
    // The DFS trap: 6 is three deep in the LEFT subtree and 3 is one deep in
    // the right, both in column 1. Preorder reaches 6 first; the answer is
    // [3, 6].
    trees.push(node(1, node(2, None, node(4, None, leaf(6))), node(3, leaf(5), None)));
    trees.push(None);
    trees.push(leaf(7));
    trees.push(left_spine(5));
    // Duplicate values: structure, not value, decides placement.
    trees.push(node(1, node(1, leaf(1), leaf(1)), node(1, leaf(1), leaf(1))));

    let mut acc = 0;
    for t in 0..trees.len() {
        let cols = vertical_order(trees[t].clone());
        for i in 0..cols.len() {
            acc = (acc * 131 + cols[i].len()) % 1000000007;
            for j in 0..cols[i].len() {
                acc = (acc * 131 + cols[i][j] + 1000) % 1000000007;
            }
        }
        println(f"tree {t}: {fmt(cols)}");
    }
    println(f"sink: {acc}");
}
