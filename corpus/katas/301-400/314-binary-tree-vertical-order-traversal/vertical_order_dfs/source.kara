// LeetCode #314: Binary Tree Vertical Order Traversal — DFS, then a sort.
//
// A depth-first walk is the natural way to tag every node with its column,
// and it is WRONG on its own: within a column the values must run top to
// bottom, and preorder reaches a deep node in the left subtree before a
// shallow one in the right subtree that shares its column. (Tree 3 in the demo
// is the smallest counterexample: preorder lists 6 before 3 in column 1.)
//
// So the walk records three things per node — column, row, and its position
// in the walk — and a single sort by (column, row, position) puts everything
// right. The third key is what makes "same row and column: left to right"
// hold: for two nodes at the same depth, the one in the left subtree is
// visited first by preorder, so preorder position IS left-to-right order
// within a row. The sort must be stable or carry that key explicitly; this
// one carries it.

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn node(v: i64, l: Option[TreeNode], r: Option[TreeNode]) -> Option[TreeNode] {
    return Some(TreeNode { val: v, left: l, right: r });
}

fn leaf(v: i64) -> Option[TreeNode] {
    return node(v, None, None);
}

fn walk(t: Option[TreeNode], col: i64, row: i64, tagged: mut ref Vec[(i64, i64, i64, i64)]) {
    match t {
        None => {}
        Some(n) => {
            tagged.push((col, row, tagged.len(), n.val));
            walk(n.left, col - 1, row + 1, tagged);
            walk(n.right, col + 1, row + 1, tagged);
        }
    }
}

fn vertical_order(root: Option[TreeNode]) -> Vec[Vec[i64]] {
    let mut tagged: Vec[(i64, i64, i64, i64)] = Vec.new();
    walk(root, 0, 0, mut tagged);
    tagged.sort_by(|a, b| if a.0 != b.0 { a.0.cmp(b.0) }
                          else if a.1 != b.1 { a.1.cmp(b.1) }
                          else { a.2.cmp(b.2) });
    let mut out: Vec[Vec[i64]] = Vec.new();
    for i in 0..tagged.len() {
        let (c, r, p, v) = tagged[i];
        if i == 0 or c != tagged[i - 1].0 {
            out.push(Vec.new());
        }
        let last = out.len() - 1;
        out[last].push(v);
    }
    return out;
}

// ------------------------------------------------------------- demo ---

fn fmt(cols: ref Vec[Vec[i64]]) -> String {
    let mut s = "[".to_string();
    for i in 0..cols.len() {
        if i > 0 { s = s + ","; }
        s = s + "[";
        for j in 0..cols[i].len() {
            if j > 0 { s = s + ","; }
            let v = cols[i][j];
            s = s + v.to_string();
        }
        s = s + "]";
    }
    return s + "]";
}

fn left_spine(n: i64) -> Option[TreeNode] {
    if n <= 0 { return None; }
    return node(-n, left_spine(n - 1), None);
}

fn main() {
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    // LeetCode's three examples.
    trees.push(node(3, leaf(9), node(20, leaf(15), leaf(7))));
    trees.push(node(3, node(9, leaf(4), leaf(0)), node(8, leaf(1), leaf(7))));
    trees.push(node(3, node(9, leaf(4), node(0, None, leaf(2))),
                       node(8, node(1, leaf(5), None), leaf(7))));
    // The DFS trap: 6 is three deep in the LEFT subtree and 3 is one deep in
    // the right, both in column 1. Preorder reaches 6 first; the answer is
    // [3, 6].
    trees.push(node(1, node(2, None, node(4, None, leaf(6))), node(3, leaf(5), None)));
    trees.push(None);
    trees.push(leaf(7));
    trees.push(left_spine(5));
    // Duplicate values: structure, not value, decides placement.
    trees.push(node(1, node(1, leaf(1), leaf(1)), node(1, leaf(1), leaf(1))));

    let mut acc = 0;
    for t in 0..trees.len() {
        let cols = vertical_order(trees[t].clone());
        for i in 0..cols.len() {
            acc = (acc * 131 + cols[i].len()) % 1000000007;
            for j in 0..cols[i].len() {
                acc = (acc * 131 + cols[i][j] + 1000) % 1000000007;
            }
        }
        println(f"tree {t}: {fmt(cols)}");
    }
    println(f"sink: {acc}");
}
