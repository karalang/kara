// LeetCode #378: Kth Smallest Element in a Sorted Matrix -- binary search
// on the value.
//
// The answer is the least value x with at least k entries <= x. That
// count only grows with x, so binary search between the two corners finds
// it. Counting takes one walk up the staircase: start at the bottom-left;
// when the entry is <= x, so is everything above it in that column, so
// add the column's height and step right; otherwise step up. The search
// only ever settles on a value that is in the matrix, because the count
// changes only at such values. O(n log(range)), O(1) space.

fn count_at_most(matrix: Vec[Vec[i64]], x: i64) -> i64 {
    let n = matrix.len();
    let mut count = 0;
    let mut row = n - 1;
    let mut col = 0;
    while row >= 0 and col < n {
        if matrix[row][col] <= x {
            count += row + 1;
            col += 1;
        } else {
            row -= 1;
        }
    }
    count
}

fn kth_smallest(matrix: Vec[Vec[i64]], k: i64) -> i64 {
    let n = matrix.len();
    let mut lo = matrix[0][0];
    let mut hi = matrix[n - 1][n - 1];
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if count_at_most(matrix, mid) >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn show(label: String, matrix: Vec[Vec[i64]], k: i64) {
    println(f"{label}: {kth_smallest(matrix, k)}");
}

fn main() {
    show("example 1", vec![vec![1, 5, 9], vec![10, 11, 13], vec![12, 13, 15]], 8);
    show("example 2", vec![vec![-5]], 1);
    show("k = 1 is the corner", vec![vec![1, 2], vec![3, 4]], 1);
    show("k = n * n is the far corner", vec![vec![1, 2], vec![3, 4]], 4);
    show("rows overlap", vec![vec![1, 3, 5], vec![2, 4, 6], vec![3, 5, 7]], 5);
    show("all equal", vec![vec![7, 7, 7], vec![7, 7, 7], vec![7, 7, 7]], 6);
    show("duplicates across rows", vec![vec![1, 1, 3], vec![1, 2, 3], vec![3, 3, 3]], 4);
    show("negative and extreme values", vec![vec![-1000000000, -5], vec![0, 1000000000]], 3);
    // Random matrices up to 40 by 40: each value is the larger of its upper
    // and left neighbours plus a small step, which keeps rows and columns
    // sorted and makes repeats common.
    let mut seed: i64 = 378;
    let mut checksum: i64 = 0;
    for case in 0..100 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (seed / 65536) % 40;
        let step = if case % 2 == 0 { 3 } else { 1000 };
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let base = (seed / 65536) % 2001 - 1000;
        let mut matrix: Vec[Vec[i64]] = Vec.new();
        for i in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for j in 0..n {
                seed = (seed * 1103515245 + 12345) % 2147483648;
                let d = (seed / 65536) % step;
                let v = if i == 0 and j == 0 {
                    base
                } else if i == 0 {
                    row[j - 1] + d
                } else if j == 0 {
                    matrix[i - 1][0] + d
                } else {
                    matrix[i - 1][j].max(row[j - 1]) + d
                };
                row.push(v);
            }
            matrix.push(row);
        }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = 1 + (seed / 65536) % (n * n);
        checksum = (checksum * 1009 + kth_smallest(matrix, k) + 1000000) % 1000000007;
    }
    println(f"100 random matrices: checksum {checksum}");
}
