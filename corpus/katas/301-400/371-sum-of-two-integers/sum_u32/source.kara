// LeetCode #371: Sum of Two Integers -- the carry loop in 32 unsigned bits.
//
// The form LeetCode's own inputs suggest: the answer fits an i32, so do the
// carry loop on u32, where a carry out of bit 31 simply disappears, and
// read the 32 bits back as a signed number at the end. The casts do the
// two's-complement work: `as u32` keeps the low 32 bits of the i64, and
// `as i32` reads them back with bit 31 as the sign. At most 32 rounds.

fn get_sum(a: i64, b: i64) -> i64 {
    let mut x = a as u32;
    let mut carry = b as u32;
    while carry != 0 {
        let both = x & carry;
        x = x ^ carry;
        carry = both << 1;
    }
    (x as i32) as i64
}

fn show(label: String, a: i64, b: i64) {
    println(f"{label}: {get_sum(a, b)}");
}

fn main() {
    show("example 1", 1, 2);
    show("example 2", 2, 3);
    show("zeros", 0, 0);
    show("minus one plus one", -1, 1);
    show("both at the lower bound", -1000, -1000);
    show("both at the upper bound", 1000, 1000);
    show("opposite bounds", 1000, -1000);
    show("a negative result", -7, 3);
    show("a carry through every bit", -1, -1);
    show("zero and a negative", 0, -1000);
    // Random pairs in [-1000, 1000]: fold every sum into a checksum.
    let mut seed: i64 = 371;
    let mut checksum: i64 = 0;
    for _ in 0..5000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let a = (seed / 65536) % 2001 - 1000;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let b = (seed / 65536) % 2001 - 1000;
        checksum = (checksum * 31 + get_sum(a, b) + 5000) % 1000000007;
    }
    println(f"5000 random pairs: checksum {checksum}");
}
