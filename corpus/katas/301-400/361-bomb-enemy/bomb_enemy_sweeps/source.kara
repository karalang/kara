// LeetCode #361: Bomb Enemy -- four sweeps, one per direction.
//
// hits[i][j] accumulates, for each of the four directions, the number of
// enemies seen walking towards cell (i, j) from that side since the last
// wall. Each sweep is one pass over the grid with a running count that a
// wall resets, so the total is O(rows * cols) with no recounting.

fn max_killed_enemies(grid: ref Vec[String]) -> i64 {
    let rows = grid.len();
    if rows == 0 {
        return 0;
    }
    let mut cells: Vec[Vec[u8]] = Vec.new();
    for line in grid.iter() {
        let mut row: Vec[u8] = Vec.new();
        for b in line.bytes() {
            row.push(b);
        }
        cells.push(row);
    }
    let cols = cells[0].len();
    let mut hits: Vec[Vec[i64]] = Vec.new();
    for _ in 0..rows {
        hits.push(vec![0; cols]);
    }
    // left to right and right to left
    for i in 0..rows {
        let mut run = 0;
        for j in 0..cols {
            if cells[i][j] == b'W' { run = 0; } else if cells[i][j] == b'E' { run += 1; } else { hits[i][j] += run; }
        }
        run = 0;
        let mut j = cols;
        while j > 0 {
            j -= 1;
            if cells[i][j] == b'W' { run = 0; } else if cells[i][j] == b'E' { run += 1; } else { hits[i][j] += run; }
        }
    }
    // top to bottom and bottom to top
    for j in 0..cols {
        let mut run = 0;
        for i in 0..rows {
            if cells[i][j] == b'W' { run = 0; } else if cells[i][j] == b'E' { run += 1; } else { hits[i][j] += run; }
        }
        run = 0;
        let mut i = rows;
        while i > 0 {
            i -= 1;
            if cells[i][j] == b'W' { run = 0; } else if cells[i][j] == b'E' { run += 1; } else { hits[i][j] += run; }
        }
    }
    let mut best = 0;
    for i in 0..rows {
        for j in 0..cols {
            if cells[i][j] == b'0' {
                best = best.max(hits[i][j]);
            }
        }
    }
    best
}

fn show(label: String, grid: Vec[String]) {
    println(f"{label}: {max_killed_enemies(grid)}");
}

fn main() {
    show("example 1", vec!["0E00", "E0WE", "0E00"]);
    show("example 2", vec!["WWW", "000", "EEE"]);

    show("empty grid", Vec.new());
    show("one empty cell", vec!["0"]);
    show("one enemy, nowhere to stand", vec!["E"]);
    show("walls only", vec!["WW", "WW"]);
    show("a wall shields", vec!["E0WE"]);
    show("a column", vec!["E", "0", "E", "W", "E"]);
    show("enemies everywhere but one cell", vec!["EEE", "E0E", "EEE"]);
    show("the best cell is in a corner", vec!["0EE", "EWW", "EWE"]);
    show("enemies do not block", vec!["0EEEE"]);
    show("two segments in one row", vec!["0EWEE0"]);

    // A long run: 1,000 random grids of up to 8 by 8 cells, each cell a wall,
    // an enemy or empty with weights 1, 2, 3.
    let mut seed: i64 = 361;
    let mut checksum: i64 = 0;
    let mut total = 0;
    for _ in 0..1000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let rows = (seed / 65536) % 8 + 1;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let cols = (seed / 65536) % 8 + 1;
        let mut grid: Vec[String] = Vec.new();
        for _ in 0..rows {
            let mut row = String.new();
            for _ in 0..cols {
                seed = (seed * 1103515245 + 12345) % 2147483648;
                let r = (seed / 65536) % 6;
                row.push(if r == 0 { 'W' } else if r < 3 { 'E' } else { '0' });
            }
            grid.push(row);
        }
        let best = max_killed_enemies(grid);
        total += best;
        checksum = (checksum * 31 + best) % 1000000007;
    }
    println(f"1000 random grids: {total} enemies in total, checksum {checksum}");
}
