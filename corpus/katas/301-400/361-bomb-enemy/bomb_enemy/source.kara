// LeetCode #361: Bomb Enemy -- one pass with a row count and per-column
// counts, recomputed only after a wall.
//
// A bomb on an empty cell kills every enemy in its row and column up to the
// nearest wall in each direction. Scan the grid in row-major order. At the
// start of a row, or just after a wall, count the enemies from here to the
// next wall in the row; at the top of a column, or just below a wall, count
// the enemies from here to the next wall down the column. Every cell of a
// wall-to-wall segment shares its segment's count, so each count is
// computed once per segment and the whole pass is O(rows * cols).

fn max_killed_enemies(grid: ref Vec[String]) -> i64 {
    let rows = grid.len();
    if rows == 0 {
        return 0;
    }
    let cells: Vec[Vec[u8]] = grid.iter().map(|r| r.bytes().iter().collect()).collect();
    let cols = cells[0].len();
    let mut best = 0;
    let mut row_hits = 0;
    let mut col_hits: Vec[i64] = vec![0; cols];
    for i in 0..rows {
        for j in 0..cols {
            if j == 0 or cells[i][j - 1] == b'W' {
                row_hits = 0;
                let mut k = j;
                while k < cols and cells[i][k] != b'W' {
                    if cells[i][k] == b'E' {
                        row_hits += 1;
                    }
                    k += 1;
                }
            }
            if i == 0 or cells[i - 1][j] == b'W' {
                col_hits[j] = 0;
                let mut k = i;
                while k < rows and cells[k][j] != b'W' {
                    if cells[k][j] == b'E' {
                        col_hits[j] += 1;
                    }
                    k += 1;
                }
            }
            if cells[i][j] == b'0' {
                best = best.max(row_hits + col_hits[j]);
            }
        }
    }
    best
}

fn show(label: String, grid: Vec[String]) {
    println(f"{label}: {max_killed_enemies(grid)}");
}

fn main() {
    show("example 1", vec!["0E00", "E0WE", "0E00"]);
    show("example 2", vec!["WWW", "000", "EEE"]);

    show("empty grid", Vec.new());
    show("one empty cell", vec!["0"]);
    show("one enemy, nowhere to stand", vec!["E"]);
    show("walls only", vec!["WW", "WW"]);
    show("a wall shields", vec!["E0WE"]);
    show("a column", vec!["E", "0", "E", "W", "E"]);
    show("enemies everywhere but one cell", vec!["EEE", "E0E", "EEE"]);
    show("the best cell is in a corner", vec!["0EE", "EWW", "EWE"]);
    show("enemies do not block", vec!["0EEEE"]);
    show("two segments in one row", vec!["0EWEE0"]);

    // A long run: 1,000 random grids of up to 8 by 8 cells, each cell a wall,
    // an enemy or empty with weights 1, 2, 3.
    let mut seed: i64 = 361;
    let mut checksum: i64 = 0;
    let mut total = 0;
    for _ in 0..1000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let rows = (seed / 65536) % 8 + 1;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let cols = (seed / 65536) % 8 + 1;
        let mut grid: Vec[String] = Vec.new();
        for _ in 0..rows {
            let mut row = String.new();
            for _ in 0..cols {
                seed = (seed * 1103515245 + 12345) % 2147483648;
                let r = (seed / 65536) % 6;
                row.push(if r == 0 { 'W' } else if r < 3 { 'E' } else { '0' });
            }
            grid.push(row);
        }
        let best = max_killed_enemies(grid);
        total += best;
        checksum = (checksum * 31 + best) % 1000000007;
    }
    println(f"1000 random grids: {total} enemies in total, checksum {checksum}");
}
