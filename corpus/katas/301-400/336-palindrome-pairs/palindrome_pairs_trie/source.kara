// LeetCode #336: Palindrome Pairs — a trie of reversed words.
//
// Insert every word reversed into a trie kept as a pool of nodes. Each node
// remembers the word that ends there, if any, and every word whose
// remaining (not yet inserted) part is a palindrome at that point. Then walk
// each word w forwards down the trie.
//
//   Passing a node where a word ends while the rest of w is a palindrome:
//   that word goes after w.
//   Using up all of w at a node: every word listed there as "palindrome
//   below" goes after w, and so does the word ending exactly there.
//
// O(n · L^2) time, O(n · L) nodes.

struct Node {
    next: Vec[i64],
    word: i64,
    below: Vec[i64],
}

fn new_node() -> Node {
    let mut next: Vec[i64] = Vec.new();
    for _ in 0..26 {
        next.push(-1);
    }
    return Node { next: next, word: -1, below: Vec.new() };
}

fn is_palindrome(b: Slice[u8], lo: i64, hi: i64) -> bool {
    let mut i = lo;
    let mut j = hi - 1;
    while i < j {
        if b[i] != b[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    return true;
}

fn palindrome_pairs(words: ref Vec[String]) -> Vec[(i64, i64)] {
    let mut nodes: Vec[Node] = Vec.new();
    nodes.push(new_node());
    for i in 0..words.len() {
        let b = words[i].bytes();
        let mut at = 0;
        let mut k = b.len();
        // Walk the word from its last byte; the part not inserted yet is
        // b[0..k].
        while k > 0 {
            if is_palindrome(b, 0, k) {
                nodes[at].below.push(i);
            }
            let c = (b[k - 1] - 97) as i64;
            if nodes[at].next[c] < 0 {
                nodes.push(new_node());
                let fresh = nodes.len() - 1;
                nodes[at].next[c] = fresh;
            }
            at = nodes[at].next[c];
            k -= 1;
        }
        nodes[at].word = i;
        nodes[at].below.push(i);
    }
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..words.len() {
        let b = words[i].bytes();
        let mut at = 0;
        let mut k = 0;
        while k < b.len() and at >= 0 {
            let ends = nodes[at].word;
            if ends >= 0 and ends != i and is_palindrome(b, k, b.len()) {
                pairs.push((i, ends));
            }
            at = nodes[at].next[(b[k] - 97) as i64];
            k += 1;
        }
        if at >= 0 {
            for j in nodes[at].below.iter() {
                if j != i {
                    pairs.push((i, j));
                }
            }
        }
    }
    pairs.sort();
    return pairs;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn show(words: Vec[String]) {
    let pairs = palindrome_pairs(words);
    let mut quoted: Vec[String] = Vec.new();
    for w in words.iter() {
        quoted.push(f"\"{w}\"");
    }
    let mut parts: Vec[String] = Vec.new();
    for p in pairs.iter() {
        let (i, j) = p;
        parts.push(f"({i}, {j})");
    }
    let shown = quoted.join(", ");
    let found = parts.join(" ");
    println(f"[{shown}] -> {found}");
}

// `count` distinct random words over the first `letters` letters, of length
// `lo` to `hi`. The order is the order of first appearance.
fn random_words(seed: mut ref i64, count: i64, letters: i64, lo: i64, hi: i64) -> Vec[String] {
    let alphabet = "abcdefghijklmnopqrstuvwxyz".bytes();
    let mut seen: Set[String] = Set.new();
    let mut out: Vec[String] = Vec.new();
    while out.len() < count {
        let len = lo + next(seed) % (hi - lo + 1);
        let mut w = String.new();
        for _ in 0..len {
            w.push(alphabet[next(seed) % letters] as char);
        }
        if not seen.contains(w) {
            seen.insert(w.clone());
            out.push(w);
        }
    }
    return out;
}

fn main() {
    show(vec!["abcd", "dcba", "lls", "s", "sssll"]);
    show(vec!["bat", "tab", "cat"]);
    show(vec!["a", ""]);
    show(vec![]);
    show(vec![""]);
    show(vec!["a", "b", "c"]);
    show(vec!["", "a", "aa", "aba"]);
    show(vec!["abc", "cba", "ab", "ba"]);
    show(vec!["race", "car", "ecar"]);
    show(vec!["ab", "a", "ba", "b"]);
    show(vec!["aab", "baa", "aaa", "b"]);
    show(vec!["xyzzyx", "xyz", "zyx", "zzyx"]);
    let mut seed = 336;
    for round in 0..6 {
        show(random_words(mut seed, 4 + round, 2 + round % 2, 0, 4));
    }
    // 1,000 words over {a, b} of 1 to 12 letters: too many pairs to print,
    // so print the count and a hash of the sorted pairs.
    let big = random_words(mut seed, 1000, 2, 1, 12);
    let pairs = palindrome_pairs(big);
    let mut hash = 0;
    for p in pairs.iter() {
        let (i, j) = p;
        hash = (hash * 1000003 + i * 4099 + j) % 1073741789;
    }
    println(f"big: {big.len()} words -> {pairs.len()} pairs, hash {hash}");
}
