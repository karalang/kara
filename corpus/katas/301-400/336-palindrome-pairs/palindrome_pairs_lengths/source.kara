// LeetCode #336: Palindrome Pairs — only the lengths that exist.
//
// The same two rules as the main arm, but a word can only pair with a piece
// whose length is the length of some word, so the splits worth trying are
// the ones that leave a piece of an existing length. The words go in a
// `SortedMap` from the word itself to its index, the lengths in a `Set`, and
// each candidate is built as an owned reversed copy of the piece.
//
// O(n · L · m) time, where m is the number of distinct lengths.

fn is_palindrome(b: Slice[u8], lo: i64, hi: i64) -> bool {
    let mut i = lo;
    let mut j = hi - 1;
    while i < j {
        if b[i] != b[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    return true;
}

// The reverse of b[lo..hi] as a new String (the words are ASCII).
fn reverse_piece(b: Slice[u8], lo: i64, hi: i64) -> String {
    let mut r = String.new();
    let mut k = hi;
    while k > lo {
        k -= 1;
        r.push(b[k] as char);
    }
    return r;
}

fn palindrome_pairs(words: ref Vec[String]) -> Vec[(i64, i64)] {
    let mut index: SortedMap[String, i64] = SortedMap.new();
    let mut lengths: Set[i64] = Set.new();
    for i in 0..words.len() {
        index.insert(words[i].clone(), i);
        lengths.insert(words[i].len());
    }
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..words.len() {
        let b = words[i].bytes();
        let len = b.len();
        for k in 0..len + 1 {
            // The partner after w is the reverse of the prefix b[0..k].
            if lengths.contains(k) and is_palindrome(b, k, len) {
                match index.get(reverse_piece(b, 0, k)) {
                    Some(j) if j != i => pairs.push((i, j)),
                    _ => {}
                }
            }
            // The partner before w is the reverse of the suffix b[k..len].
            if k > 0 and lengths.contains(len - k) and is_palindrome(b, 0, k) {
                match index.get(reverse_piece(b, k, len)) {
                    Some(j) if j != i => pairs.push((j, i)),
                    _ => {}
                }
            }
        }
    }
    pairs.sort();
    return pairs;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn show(words: Vec[String]) {
    let pairs = palindrome_pairs(words);
    let mut quoted: Vec[String] = Vec.new();
    for w in words.iter() {
        quoted.push(f"\"{w}\"");
    }
    let mut parts: Vec[String] = Vec.new();
    for p in pairs.iter() {
        let (i, j) = p;
        parts.push(f"({i}, {j})");
    }
    let shown = quoted.join(", ");
    let found = parts.join(" ");
    println(f"[{shown}] -> {found}");
}

// `count` distinct random words over the first `letters` letters, of length
// `lo` to `hi`. The order is the order of first appearance.
fn random_words(seed: mut ref i64, count: i64, letters: i64, lo: i64, hi: i64) -> Vec[String] {
    let alphabet = "abcdefghijklmnopqrstuvwxyz".bytes();
    let mut seen: Set[String] = Set.new();
    let mut out: Vec[String] = Vec.new();
    while out.len() < count {
        let len = lo + next(seed) % (hi - lo + 1);
        let mut w = String.new();
        for _ in 0..len {
            w.push(alphabet[next(seed) % letters] as char);
        }
        if not seen.contains(w) {
            seen.insert(w.clone());
            out.push(w);
        }
    }
    return out;
}

fn main() {
    show(vec!["abcd", "dcba", "lls", "s", "sssll"]);
    show(vec!["bat", "tab", "cat"]);
    show(vec!["a", ""]);
    show(vec![]);
    show(vec![""]);
    show(vec!["a", "b", "c"]);
    show(vec!["", "a", "aa", "aba"]);
    show(vec!["abc", "cba", "ab", "ba"]);
    show(vec!["race", "car", "ecar"]);
    show(vec!["ab", "a", "ba", "b"]);
    show(vec!["aab", "baa", "aaa", "b"]);
    show(vec!["xyzzyx", "xyz", "zyx", "zzyx"]);
    let mut seed = 336;
    for round in 0..6 {
        show(random_words(mut seed, 4 + round, 2 + round % 2, 0, 4));
    }
    // 1,000 words over {a, b} of 1 to 12 letters: too many pairs to print,
    // so print the count and a hash of the sorted pairs.
    let big = random_words(mut seed, 1000, 2, 1, 12);
    let pairs = palindrome_pairs(big);
    let mut hash = 0;
    for p in pairs.iter() {
        let (i, j) = p;
        hash = (hash * 1000003 + i * 4099 + j) % 1073741789;
    }
    println(f"big: {big.len()} words -> {pairs.len()} pairs, hash {hash}");
}
