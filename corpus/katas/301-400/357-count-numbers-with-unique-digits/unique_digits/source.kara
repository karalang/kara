// LeetCode #357: Count Numbers with Unique Digits -- count them by position.
//
// A number below 10^n with distinct digits has some length k <= n. Length 0
// is the number 0 itself. A length-k number has 9 choices for its leading
// digit (anything but 0), then 9, 8, 7, ... for the rest, since each later
// digit may be 0 but not a digit already used. So the count of length k is
// 9 * 9 * 8 * ... * (11 - k), and the answer is 1 plus the sum over k. In
// base b the same argument gives (b - 1) * (b - 1) * (b - 2) * ...

fn count_unique(n: i64, base: i64) -> i64 {
    let mut total = 1;
    let mut run = base - 1;
    let mut next = base - 1;
    let mut k = 1;
    while k <= n and k <= base {
        total += run;
        run *= next;
        next -= 1;
        k += 1;
    }
    total
}

fn main() {
    for n in 0..=8 {
        println(f"n = {n}: {count_unique(n, 10)}");
    }
    for base in 2..=7 {
        let mut row: Vec[String] = Vec.new();
        // One length past the base: no number has more distinct digits than
        // the base has digits, so the last two entries agree.
        for n in 0..=(base + 1) {
            row.push(f"{count_unique(n, base)}");
        }
        println(f"base {base}: {row.join(" ")}");
    }
}
