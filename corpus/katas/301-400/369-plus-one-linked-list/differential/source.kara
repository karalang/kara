// LeetCode #369: differential test. The last-non-9, recursive, reverse and
// stack arms against an oracle that adds to a Vec of digits by schoolbook
// addition, over 3,000 random numbers. Properties: P1 each arm gives the
// oracle's digits; P2 the result has one more digit exactly when every
// digit was a 9; P3 the result is one more than the input modulo
// 1,000,000,007; P4 applying the arm k times adds k; P5 every result digit
// is in 0..=9 and the first is not 0.

shared struct ListNode {
    mut val: i64,
    mut next: Option[ListNode],
}

fn last_arm(head: Option[ListNode]) -> Option[ListNode] {
    let front = ListNode { val: 0, next: head };
    let mut last = front;
    let mut at = front.next;
    while let Some(node) = at {
        if node.val != 9 {
            last = node;
        }
        at = node.next;
    }
    last.val += 1;
    let mut rest = last.next;
    while let Some(node) = rest {
        node.val = 0;
        rest = node.next;
    }
    if front.val == 1 { Some(front) } else { front.next }
}

fn add_carry(node: Option[ListNode]) -> i64 {
    match node {
        None => 1,
        Some(n) => {
            let sum = n.val + add_carry(n.next);
            n.val = sum % 10;
            sum / 10
        }
    }
}

fn recursive_arm(head: Option[ListNode]) -> Option[ListNode] {
    if add_carry(head) == 1 {
        Some(ListNode { val: 1, next: head })
    } else {
        head
    }
}

fn reverse(head: Option[ListNode]) -> Option[ListNode] {
    let mut done: Option[ListNode] = None;
    let mut at = head;
    while let Some(node) = at {
        at = node.next;
        node.next = done;
        done = Some(node);
    }
    done
}

fn reverse_arm(head: Option[ListNode]) -> Option[ListNode] {
    let low_first = reverse(head);
    let mut carry = 1;
    let mut at = low_first;
    let mut tail: Option[ListNode] = None;
    while let Some(node) = at {
        if carry == 0 {
            break;
        }
        let sum = node.val + carry;
        node.val = sum % 10;
        carry = sum / 10;
        tail = Some(node);
        at = node.next;
    }
    if carry == 1 {
        if let Some(t) = tail {
            t.next = Some(ListNode { val: 1, next: None });
        }
    }
    reverse(low_first)
}

fn stack_arm(head: Option[ListNode]) -> Option[ListNode] {
    let mut stack: Vec[ListNode] = Vec.new();
    let mut at = head;
    while let Some(node) = at {
        stack.push(node);
        at = node.next;
    }
    let mut carry = 1;
    while carry == 1 {
        match stack.pop() {
            None => { return Some(ListNode { val: 1, next: head }); }
            Some(node) => {
                let sum = node.val + carry;
                node.val = sum % 10;
                carry = sum / 10;
            }
        }
    }
    head
}

// The number in `digits` plus k, most significant digit first.
fn oracle(digits: ref Vec[i64], k: i64) -> Vec[i64] {
    let mut low_first: Vec[i64] = Vec.new();
    let mut carry = k;
    let mut i = digits.len();
    while i > 0 {
        i -= 1;
        let sum = digits[i] + carry;
        low_first.push(sum % 10);
        carry = sum / 10;
    }
    while carry > 0 {
        low_first.push(carry % 10);
        carry /= 10;
    }
    let mut out: Vec[i64] = Vec.new();
    let mut j = low_first.len();
    while j > 0 {
        j -= 1;
        out.push(low_first[j]);
    }
    out
}

fn from_digits(digits: ref Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for i in (0..digits.len()).rev() {
        head = Some(ListNode { val: digits[i], next: head });
    }
    head
}

fn to_digits(list: Option[ListNode]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut at = list;
    while let Some(node) = at {
        out.push(node.val);
        at = node.next;
    }
    out
}

fn answer(arm: i64, head: Option[ListNode]) -> Option[ListNode] {
    match arm {
        0 => last_arm(head),
        1 => recursive_arm(head),
        2 => reverse_arm(head),
        _ => stack_arm(head),
    }
}

fn name(arm: i64) -> String {
    match arm {
        0 => "last",
        1 => "recursive",
        2 => "reverse",
        _ => "stack",
    }
}

fn modulo(digits: ref Vec[i64]) -> i64 {
    let mut m = 0;
    for d in digits.iter() {
        m = (m * 10 + d) % 1000000007;
    }
    m
}

fn main() {
    let mut seed: i64 = 369;
    let mut checks = 0;
    let mut failures = 0;
    let mut fails = vec![0; 5];
    for case in 0..3000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (seed / 65536) % 25;
        // A sixth of the numbers are all 9s; a third end in a run of 9s.
        let kind = case % 6;
        let mut digits: Vec[i64] = Vec.new();
        for k in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let d = (seed / 65536) % 10;
            if kind == 0 or (kind <= 2 and k >= n / 2) {
                digits.push(9);
            } else if k == 0 and n > 1 and d == 0 {
                digits.push(1 + case % 9);
            } else {
                digits.push(d);
            }
        }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let times = 1 + (seed / 65536) % 12;
        let expected = oracle(digits, 1);
        let mut all_nines = true;
        for d in digits.iter() {
            if d != 9 {
                all_nines = false;
            }
        }
        for arm in 0..4 {
            let got = to_digits(answer(arm, from_digits(digits)));
            let mut bad = vec![false; 5];
            checks += 1;
            if got != expected {
                bad[0] = true;
            }
            checks += 1;
            if got.len() != (if all_nines { n + 1 } else { n }) {
                bad[1] = true;
            }
            checks += 1;
            if modulo(got) != (modulo(digits) + 1) % 1000000007 {
                bad[2] = true;
            }
            checks += 1;
            let mut list = from_digits(digits);
            for _ in 0..times {
                list = answer(arm, list);
            }
            if to_digits(list) != oracle(digits, times) {
                bad[3] = true;
            }
            checks += 1;
            if got.is_empty() or got[0] == 0 {
                bad[4] = true;
            }
            for d in got.iter() {
                if d < 0 or d > 9 {
                    bad[4] = true;
                }
            }
            for p in 0..5 {
                if bad[p] {
                    fails[p] += 1;
                    failures += 1;
                    if failures <= 5 {
                        println(f"FAIL P{p + 1} {name(arm)} digits={digits}");
                    }
                }
            }
        }
    }
    for p in 0..5 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    println(f"3000 cases, {checks} checks, {failures} failures");
}
