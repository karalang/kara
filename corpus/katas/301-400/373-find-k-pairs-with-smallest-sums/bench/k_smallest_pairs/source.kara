// Benchmark for #373: 20 random pairs of sorted arrays of 100,000 values
// each, with k = 10,000, the problem's largest, answered with the kata's
// row-front heap.

fn k_smallest_pairs(nums1: ref Vec[i64], nums2: ref Vec[i64], k: i64) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    if nums1.is_empty() or nums2.is_empty() {
        return out;
    }
    let mut fronts: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    for i in 0..nums1.len().min(k) {
        fronts.push((nums1[i] + nums2[0], i, 0));
    }
    while out.len() < k {
        match fronts.pop() {
            Some((_, i, j)) => {
                out.push((nums1[i], nums2[j]));
                if j + 1 < nums2.len() {
                    fronts.push((nums1[i] + nums2[j + 1], i, j + 1));
                }
            }
            None => break,
        }
    }
    out
}

fn main() {
    let mut seed: i64 = 373;
    let mut checksum: i64 = 0;
    let mut nums1: Vec[i64] = vec![0; 100000];
    let mut nums2: Vec[i64] = vec![0; 100000];
    for _ in 0..20 {
        let mut v = -1000000000;
        for i in 0..100000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            v += (seed / 65536) % 20000;
            nums1[i] = v;
        }
        v = -1000000000;
        for i in 0..100000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            v += (seed / 65536) % 20000;
            nums2[i] = v;
        }
        let out = k_smallest_pairs(nums1, nums2, 10000);
        for (u, w) in out.iter() {
            checksum = (checksum * 31 + (u + w) % 1000000007 + 2000000000) % 1000000007;
        }
    }
    println(f"checksum {checksum}");
}
