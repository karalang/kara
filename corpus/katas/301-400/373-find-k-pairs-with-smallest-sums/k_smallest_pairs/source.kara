// LeetCode #373: Find K Pairs with Smallest Sums -- a heap over the rows.
//
// Row i of the pair grid is nums1[i] with every nums2[j], and since nums2
// is sorted the row's sums rise left to right. So the next smallest pair is
// always the front of some row: keep each row's front in a min-heap of
// (sum, i, j), pop the least, and put that row's next pair in its place.
// Only the first k rows can ever contribute, so only they are seeded.
// Popping in (sum, i, j) order makes ties come out by row, then column.
// O(k log min(k, n1)).

fn k_smallest_pairs(nums1: ref Vec[i64], nums2: ref Vec[i64], k: i64) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    if nums1.is_empty() or nums2.is_empty() {
        return out;
    }
    let mut fronts: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    for i in 0..nums1.len().min(k) {
        fronts.push((nums1[i] + nums2[0], i, 0));
    }
    while out.len() < k {
        match fronts.pop() {
            Some((_, i, j)) => {
                out.push((nums1[i], nums2[j]));
                if j + 1 < nums2.len() {
                    fronts.push((nums1[i] + nums2[j + 1], i, j + 1));
                }
            }
            None => break,
        }
    }
    out
}

fn show(label: String, nums1: Vec[i64], nums2: Vec[i64], k: i64) {
    println(f"{label}: {k_smallest_pairs(nums1, nums2, k)}");
}

fn main() {
    show("example 1", vec![1, 7, 11], vec![2, 4, 6], 3);
    show("example 2", vec![1, 1, 2], vec![1, 2, 3], 2);
    show("k above the pair count", vec![1, 2], vec![3], 3);
    show("k = 1", vec![-5, 0, 5], vec![-3, 3], 1);
    show("every pair", vec![1, 2], vec![10, 20], 4);
    show("negative values", vec![-10, -4, 0], vec![-7, -2, 8], 5);
    show("all equal", vec![3, 3, 3], vec![4, 4], 4);
    show("one row", vec![2], vec![1, 3, 5, 7], 3);
    show("one column", vec![1, 3, 5, 7], vec![2], 3);
    show("values at the bounds", vec![-1000000000, 1000000000], vec![-1000000000, 1000000000], 3);
    // Random sorted arrays of up to 300 values with k up to 2,000: fold
    // every pair into a checksum.
    let mut seed: i64 = 373;
    let mut checksum: i64 = 0;
    let mut pairs = 0;
    for _ in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n1 = 1 + (seed / 65536) % 300;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n2 = 1 + (seed / 65536) % 300;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = 1 + (seed / 65536) % 2000;
        let mut nums1: Vec[i64] = Vec.new();
        let mut nums2: Vec[i64] = Vec.new();
        let mut v = -5000;
        for _ in 0..n1 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            v += (seed / 65536) % 40;
            nums1.push(v);
        }
        v = -5000;
        for _ in 0..n2 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            v += (seed / 65536) % 40;
            nums2.push(v);
        }
        let out = k_smallest_pairs(nums1, nums2, k);
        pairs += out.len();
        for (u, w) in out.iter() {
            checksum = (checksum * 31 + u + 20000) % 1000000007;
            checksum = (checksum * 31 + w + 20000) % 1000000007;
        }
    }
    println(f"300 random cases: {pairs} pairs, checksum {checksum}");
}
