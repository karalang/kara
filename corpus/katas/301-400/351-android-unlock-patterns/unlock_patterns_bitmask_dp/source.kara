// LeetCode #351: Android Unlock Patterns — dynamic programming over the set
// of keys used and the last key.
//
// A pattern is a set of keys, held as a 9-bit mask (key k is bit k - 1), and
// the key it ends on. Whether it can go on to a key depends on nothing else:
// the new key must be outside the set, and the key the line passes over, if
// any, inside it. So ways[mask * 9 + last] counts the patterns that use
// exactly `mask` and end on `last`, and each one feeds the masks one key
// larger. Masks only grow, so visiting them in increasing order finishes
// every mask before it is read. A pattern's length is its mask's population
// count.
//
// O(2^9 * 9 * 9) time and O(2^9 * 9) space, whatever m and n are.

fn passed_over_table() -> Vec[i64] {
    let mut over: Vec[i64] = Vec.filled(100, 0);
    let lines = [(1, 3, 2), (4, 6, 5), (7, 9, 8), (1, 7, 4), (2, 8, 5), (3, 9, 6), (1, 9, 5), (3, 7, 5)];
    for (a, b, mid) in lines {
        over[a * 10 + b] = mid;
        over[b * 10 + a] = mid;
    }
    return over;
}

// by_length[k] is the number of patterns of k keys, for k in 0..=9.
fn patterns_by_length() -> Vec[i64] {
    let over = passed_over_table();
    let mut ways: Vec[i64] = Vec.filled(512 * 9, 0);
    for key in 1..10 {
        ways[(1 << (key - 1)) * 9 + key - 1] = 1;
    }
    let mut by_length: Vec[i64] = Vec.filled(10, 0);
    for mask in 1..512 {
        for last in 1..10 {
            let w = ways[mask * 9 + last - 1];
            if w == 0 {
                continue;
            }
            by_length[mask.count_ones()] += w;
            for next in 1..10 {
                let bit = 1 << (next - 1);
                if mask & bit != 0 {
                    continue;
                }
                let mid = over[last * 10 + next];
                if mid == 0 or mask & (1 << (mid - 1)) != 0 {
                    ways[(mask | bit) * 9 + next - 1] += w;
                }
            }
        }
    }
    return by_length;
}

fn number_of_patterns(m: i64, n: i64) -> i64 {
    let by_length = patterns_by_length();
    let mut total = 0;
    for k in m..n + 1 {
        total += by_length[k];
    }
    return total;
}

fn main() {
    // The examples from the problem statement.
    println(f"m=1 n=1 -> {number_of_patterns(1, 1)}");
    println(f"m=1 n=2 -> {number_of_patterns(1, 2)}");

    // The patterns of each length on its own, and their sum.
    let mut all = 0;
    for k in 1..10 {
        let c = number_of_patterns(k, k);
        println(f"length {k}: {c}");
        all += c;
    }
    println(f"lengths 1..9 one at a time: {all}");

    // Ranges: every pattern, the classic lock screen's at least four keys, a
    // range in the middle, and m > n, which has no patterns.
    println(f"m=1 n=9 -> {number_of_patterns(1, 9)}");
    println(f"m=4 n=9 -> {number_of_patterns(4, 9)}");
    println(f"m=3 n=5 -> {number_of_patterns(3, 5)}");
    println(f"m=9 n=1 -> {number_of_patterns(9, 1)}");
}
