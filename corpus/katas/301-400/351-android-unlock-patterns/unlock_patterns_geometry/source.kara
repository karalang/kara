// LeetCode #351: Android Unlock Patterns — the key passed over, worked out
// from the keys' positions, with every key tried as a start.
//
// Key k sits at row (k - 1) / 3 and column (k - 1) % 3. The line from a to b
// passes over a key exactly when the two rows sum to an even number and so do
// the two columns: the point halfway between them is then a grid point, and
// a different key from both ends. Neighbours, and knight's moves like 1 -> 6,
// have an odd sum and pass over nothing.
//
// No table and no symmetry: the search runs from each of the nine keys.
//
// O(9!) time in the worst case, O(9) space.

fn passed_over(a: i64, b: i64) -> i64 {
    let rows = (a - 1) / 3 + (b - 1) / 3;
    let cols = (a - 1) % 3 + (b - 1) % 3;
    if rows % 2 != 0 or cols % 2 != 0 {
        return 0;
    }
    return rows / 2 * 3 + cols / 2 + 1;
}

fn extend(key: i64, len: i64, m: i64, n: i64, visited: mut ref Vec[bool]) -> i64 {
    let mut total = 0;
    if len >= m {
        total += 1;
    }
    if len == n {
        return total;
    }
    visited[key] = true;
    for next in 1..10 {
        if visited[next] {
            continue;
        }
        let mid = passed_over(key, next);
        if mid == 0 or visited[mid] {
            total += extend(next, len + 1, m, n, visited);
        }
    }
    visited[key] = false;
    return total;
}

fn number_of_patterns(m: i64, n: i64) -> i64 {
    if m > n {
        return 0;
    }
    let mut visited: Vec[bool] = Vec.filled(10, false);
    let mut total = 0;
    for start in 1..10 {
        total += extend(start, 1, m, n, mut visited);
    }
    return total;
}

fn main() {
    // The examples from the problem statement.
    println(f"m=1 n=1 -> {number_of_patterns(1, 1)}");
    println(f"m=1 n=2 -> {number_of_patterns(1, 2)}");

    // The patterns of each length on its own, and their sum.
    let mut all = 0;
    for k in 1..10 {
        let c = number_of_patterns(k, k);
        println(f"length {k}: {c}");
        all += c;
    }
    println(f"lengths 1..9 one at a time: {all}");

    // Ranges: every pattern, the classic lock screen's at least four keys, a
    // range in the middle, and m > n, which has no patterns.
    println(f"m=1 n=9 -> {number_of_patterns(1, 9)}");
    println(f"m=4 n=9 -> {number_of_patterns(4, 9)}");
    println(f"m=3 n=5 -> {number_of_patterns(3, 5)}");
    println(f"m=9 n=1 -> {number_of_patterns(9, 1)}");
}
