// LeetCode #339: Nested List Weight Sum — recursive descent over the tree.
//
// A nested list holds integers and further nested lists. An integer's depth
// is the number of lists around it, so the outer list's own integers have
// depth 1. Return the sum of every integer times its depth.
//
//   [[1,1],2,[1,1]]  ->  10    four 1s at depth 2, one 2 at depth 1
//   [1,[4,[6]]]      ->  27    1*1 + 4*2 + 6*3
//
// Walk the tree, passing each list's depth down to its members.
//
// O(n) time for n integers and lists, O(d) stack for depth d.

enum Nested {
    Int(i64),
    List(Vec[Nested]),
}

fn depth_sum(items: ref Vec[Nested], depth: i64) -> i64 {
    let mut total = 0;
    for item in items.iter() {
        match item {
            Int(v) => { total += v * depth; }
            List(inner) => { total += depth_sum(inner, depth + 1); }
        }
    }
    return total;
}

fn weight_sum(items: ref Vec[Nested]) -> i64 {
    return depth_sum(items, 1);
}

// ---- input --------------------------------------------------------------

// Parses the list that starts at text[pos], which must be '['. Leaves pos
// just past the matching ']'.
fn parse_list(text: ref Vec[char], pos: mut ref i64) -> Vec[Nested] {
    let mut items: Vec[Nested] = Vec.new();
    pos += 1;
    while text[pos] != ']' {
        if text[pos] == ',' {
            pos += 1;
        } else if text[pos] == '[' {
            items.push(List(parse_list(text, pos)));
        } else {
            let mut sign = 1;
            if text[pos] == '-' {
                sign = -1;
                pos += 1;
            }
            let mut v = 0;
            while text[pos].is_ascii_digit() {
                v = v * 10 + (text[pos] as i64 - '0' as i64);
                pos += 1;
            }
            items.push(Int(sign * v));
        }
    }
    pos += 1;
    return items;
}

fn parse(text: ref String) -> Vec[Nested] {
    let cs: Vec[char] = text.chars().collect();
    let mut pos = 0;
    return parse_list(cs, mut pos);
}

// A pseudo-random nested list: each list holds 0 to 4 members, and a member
// is a further list one time in three while the depth is below max_depth,
// otherwise an integer from -100 to 100. The outer list holds `top` members.
fn next(state: mut ref i64) -> i64 {
    state = (state * 1103515245 + 12345) % 2147483648;
    return state >> 8;
}

fn gen_member(state: mut ref i64, depth: i64, max_depth: i64, out: mut ref String) {
    if depth < max_depth and next(state) % 3 == 0 {
        out.push('[');
        let count = next(state) % 5;
        for k in 0..count {
            if k > 0 {
                out.push(',');
            }
            gen_member(state, depth + 1, max_depth, out);
        }
        out.push(']');
    } else {
        let v = next(state) % 201 - 100;
        out.push_str(v.to_string());
    }
}

fn gen_text(seed: i64, top: i64, max_depth: i64) -> String {
    let mut state = seed;
    let mut out = String.new();
    out.push('[');
    for k in 0..top {
        if k > 0 {
            out.push(',');
        }
        gen_member(mut state, 1, max_depth, mut out);
    }
    out.push(']');
    return out;
}

fn show(text: String) {
    let items = parse(text);
    println(f"{text} -> {weight_sum(items)}");
}

fn summary(seed: i64, top: i64, max_depth: i64) {
    let text = gen_text(seed, top, max_depth);
    let items = parse(text);
    println(f"seed {seed}, {top} members, depth up to {max_depth}: {text.len()} chars, weight sum {weight_sum(items)}");
}

fn main() {
    show("[[1,1],2,[1,1]]");
    show("[1,[4,[6]]]");
    show("[]");
    show("[[]]");
    show("[[],[[]],7]");
    show("[-3,[-4,[5,[-6]]]]");
    show("[[[[[[[[[[9]]]]]]]]]]");
    show("[0,[0,[0]],1000000]");
    summary(1, 10, 4);
    summary(7, 1000, 8);
    summary(42, 20000, 12);
    summary(2026, 50000, 30);
}
