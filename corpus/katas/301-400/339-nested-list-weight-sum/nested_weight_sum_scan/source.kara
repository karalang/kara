// LeetCode #339: Nested List Weight Sum — one pass over the text, no tree.
//
// A nested list holds integers and further nested lists. An integer's depth
// is the number of lists around it, so the outer list's own integers have
// depth 1. Return the sum of every integer times its depth.
//
//   [[1,1],2,[1,1]]  ->  10    four 1s at depth 2, one 2 at depth 1
//   [1,[4,[6]]]      ->  27    1*1 + 4*2 + 6*3
//
// An integer's depth is the number of '[' before it minus the number of ']',
// so scan the text once, keeping that count, and never build the tree.
//
// O(n) time in the length of the text, O(1) extra space.

fn weight_sum(text: ref String) -> i64 {
    let cs: Vec[char] = text.chars().collect();
    let mut total = 0;
    let mut depth = 0;
    let mut pos = 0;
    while pos < cs.len() {
        let c = cs[pos];
        if c == '[' {
            depth += 1;
            pos += 1;
        } else if c == ']' {
            depth -= 1;
            pos += 1;
        } else if c == ',' {
            pos += 1;
        } else {
            let mut sign = 1;
            if c == '-' {
                sign = -1;
                pos += 1;
            }
            let mut v = 0;
            while cs[pos].is_ascii_digit() {
                v = v * 10 + (cs[pos] as i64 - '0' as i64);
                pos += 1;
            }
            total += sign * v * depth;
        }
    }
    return total;
}

// ---- input --------------------------------------------------------------

// A pseudo-random nested list: each list holds 0 to 4 members, and a member
// is a further list one time in three while the depth is below max_depth,
// otherwise an integer from -100 to 100. The outer list holds `top` members.
fn next(state: mut ref i64) -> i64 {
    state = (state * 1103515245 + 12345) % 2147483648;
    return state >> 8;
}

fn gen_member(state: mut ref i64, depth: i64, max_depth: i64, out: mut ref String) {
    if depth < max_depth and next(state) % 3 == 0 {
        out.push('[');
        let count = next(state) % 5;
        for k in 0..count {
            if k > 0 {
                out.push(',');
            }
            gen_member(state, depth + 1, max_depth, out);
        }
        out.push(']');
    } else {
        let v = next(state) % 201 - 100;
        out.push_str(v.to_string());
    }
}

fn gen_text(seed: i64, top: i64, max_depth: i64) -> String {
    let mut state = seed;
    let mut out = String.new();
    out.push('[');
    for k in 0..top {
        if k > 0 {
            out.push(',');
        }
        gen_member(mut state, 1, max_depth, mut out);
    }
    out.push(']');
    return out;
}

fn show(text: String) {
    println(f"{text} -> {weight_sum(text)}");
}

fn summary(seed: i64, top: i64, max_depth: i64) {
    let text = gen_text(seed, top, max_depth);
    println(f"seed {seed}, {top} members, depth up to {max_depth}: {text.len()} chars, weight sum {weight_sum(text)}");
}

fn main() {
    show("[[1,1],2,[1,1]]");
    show("[1,[4,[6]]]");
    show("[]");
    show("[[]]");
    show("[[],[[]],7]");
    show("[-3,[-4,[5,[-6]]]]");
    show("[[[[[[[[[[9]]]]]]]]]]");
    show("[0,[0,[0]],1000000]");
    summary(1, 10, 4);
    summary(7, 1000, 8);
    summary(42, 20000, 12);
    summary(2026, 50000, 30);
}
