// LeetCode #385: differential test. The recursive-descent, stack, tokens
// and splitting parsers against values whose shape is known by
// construction, over 2,000 random values nested up to 6 deep with
// integers from -10^6 to 10^6. Properties: P1 every parser gives back the
// string it was given when the value is serialized again; P2 every parser
// finds the depth, number of integers and sum the generator built; P3 all
// four parsers agree; P4 wrapping a value in brackets gives a list of one
// item, that value; P5 joining two values in a list gives a list of two
// items, those values.

enum NestedInteger {
    Int(i64),
    List(Vec[NestedInteger]),
}

fn deserialize_descent(s: Str) -> NestedInteger {
    let b = s.bytes();
    let mut pos = 0;
    parse_value_descent(b, mut pos)
}

fn parse_value_descent(b: Slice[u8], pos: mut ref i64) -> NestedInteger {
    if b[*pos] == b'[' {
        *pos += 1;
        let mut items: Vec[NestedInteger] = Vec.new();
        if b[*pos] == b']' {
            *pos += 1;
            return NestedInteger.List(items);
        }
        loop {
            items.push(parse_value_descent(b, pos));
            if b[*pos] == b',' {
                *pos += 1;
            } else {
                *pos += 1;
                return NestedInteger.List(items);
            }
        }
    }
    let mut negative = false;
    if b[*pos] == b'-' {
        negative = true;
        *pos += 1;
    }
    let mut n: i64 = 0;
    while *pos < b.len() and b[*pos] >= b'0' and b[*pos] <= b'9' {
        n = n * 10 + (b[*pos] - b'0') as i64;
        *pos += 1;
    }
    NestedInteger.Int(if negative { -n } else { n })
}

fn deserialize_stack(s: Str) -> NestedInteger {
    let b = s.bytes();
    if b[0] != b'[' {
        return NestedInteger.Int(i64.parse(s).unwrap());
    }
    let mut open: Vec[Vec[NestedInteger]] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'[' {
            open.push(Vec.new());
            i += 1;
        } else if c == b']' {
            let done = open.pop().unwrap();
            if open.len() == 0 {
                return NestedInteger.List(done);
            }
            let top = open.len() - 1;
            open[top].push(NestedInteger.List(done));
            i += 1;
        } else if c == b',' {
            i += 1;
        } else {
            let start = i;
            i += 1;
            while i < b.len() and b[i] >= b'0' and b[i] <= b'9' {
                i += 1;
            }
            let n = i64.parse(s[start..i]).unwrap();
            let top = open.len() - 1;
            open[top].push(NestedInteger.Int(n));
        }
    }
    NestedInteger.List(Vec.new())
}

enum Token {
    Open,
    Close,
    Number(i64),
}

fn tokenize(s: Str) -> Vec[Token] {
    let b = s.bytes();
    let mut tokens: Vec[Token] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'[' {
            tokens.push(Token.Open);
            i += 1;
        } else if b[i] == b']' {
            tokens.push(Token.Close);
            i += 1;
        } else if b[i] == b',' {
            i += 1;
        } else {
            let mut sign = 1;
            if b[i] == b'-' {
                sign = -1;
                i += 1;
            }
            let mut n: i64 = 0;
            while i < b.len() and b[i] >= b'0' and b[i] <= b'9' {
                n = n * 10 + (b[i] - b'0') as i64;
                i += 1;
            }
            tokens.push(Token.Number(sign * n));
        }
    }
    tokens
}

// The value starting at token `at`, and the index of the token after it.
fn build(tokens: ref Vec[Token], at: i64) -> (NestedInteger, i64) {
    match tokens[at] {
        Token.Number(n) => (NestedInteger.Int(n), at + 1),
        Token.Close => (NestedInteger.List(Vec.new()), at + 1),
        Token.Open => {
            let mut items: Vec[NestedInteger] = Vec.new();
            let mut next = at + 1;
            loop {
                match tokens[next] {
                    Token.Close => return (NestedInteger.List(items), next + 1),
                    _ => {
                        let (item, after) = build(tokens, next);
                        items.push(item);
                        next = after;
                    }
                }
            }
        }
    }
}

fn deserialize_tokens(s: Str) -> NestedInteger {
    let tokens = tokenize(s);
    let (x, _) = build(tokens, 0);
    x
}

fn deserialize_split(s: Str) -> NestedInteger {
    let b = s.bytes();
    if b[0] != b'[' {
        return NestedInteger.Int(i64.parse(s).unwrap());
    }
    let mut items: Vec[NestedInteger] = Vec.new();
    let end = b.len() - 1;
    if end == 1 {
        return NestedInteger.List(items);
    }
    let mut open = 0;
    let mut start = 1;
    for i in 1..end {
        if b[i] == b'[' {
            open += 1;
        } else if b[i] == b']' {
            open -= 1;
        } else if b[i] == b',' and open == 0 {
            items.push(deserialize_split(s[start..i]));
            start = i + 1;
        }
    }
    items.push(deserialize_split(s[start..end]));
    NestedInteger.List(items)
}

fn deserialize(arm: i64, s: Str) -> NestedInteger {
    if arm == 0 {
        deserialize_descent(s)
    } else if arm == 1 {
        deserialize_stack(s)
    } else if arm == 2 {
        deserialize_tokens(s)
    } else {
        deserialize_split(s)
    }
}

fn serialize(x: ref NestedInteger) -> String {
    match x {
        NestedInteger.Int(n) => f"{n}",
        NestedInteger.List(items) => {
            let mut out = String.from("[");
            for i in 0..items.len() {
                if i > 0 {
                    out.push(',');
                }
                out.push_str(serialize(items[i]));
            }
            out.push(']');
            out
        }
    }
}

fn shape(x: ref NestedInteger) -> (i64, i64, i64) {
    match x {
        NestedInteger.Int(n) => (0, 1, *n),
        NestedInteger.List(items) => {
            let mut depth = 0;
            let mut count = 0;
            let mut sum = 0;
            for item in items.iter() {
                let (d, c, s) = shape(item);
                if d > depth {
                    depth = d;
                }
                count += c;
                sum += s;
            }
            (depth + 1, count, sum)
        }
    }
}

// The serializations of a list's items, or None for an integer.
fn items_of(x: ref NestedInteger) -> Option[Vec[String]] {
    match x {
        NestedInteger.Int(_) => None,
        NestedInteger.List(items) => {
            let mut out: Vec[String] = Vec.new();
            for item in items.iter() {
                out.push(serialize(item));
            }
            Some(out)
        }
    }
}

// A random value's text with its depth, number of integers and sum. The
// integers lean to the edges: 0, one digit, and the extremes +-10^6.
struct Built {
    text: String,
    depth: i64,
    count: i64,
    sum: i64,
}

fn next(seed: mut ref i64, n: i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    (*seed / 65536) % n
}

fn random_value(seed: mut ref i64, depth: i64) -> Built {
    if depth == 0 or next(seed, 10) < 4 {
        let kind = next(seed, 5);
        let v = if kind == 0 {
            0
        } else if kind == 1 {
            next(seed, 19) - 9
        } else if kind == 2 {
            if next(seed, 2) == 0 { 1000000 } else { -1000000 }
        } else {
            next(seed, 2000001) - 1000000
        };
        return Built { text: f"{v}", depth: 0, count: 1, sum: v };
    }
    let n = next(seed, 5);
    let mut text = String.from("[");
    let mut d = 0;
    let mut count = 0;
    let mut sum = 0;
    for i in 0..n {
        if i > 0 {
            text.push(',');
        }
        let item = random_value(seed, depth - 1);
        text.push_str(item.text);
        if item.depth > d {
            d = item.depth;
        }
        count += item.count;
        sum += item.sum;
    }
    text.push(']');
    Built { text: text, depth: d + 1, count: count, sum: sum }
}

fn main() {
    let mut seed: i64 = 385;
    let mut checks = 0;
    let mut fails = vec![0; 5];
    for _ in 0..2000 {
        let a = random_value(mut seed, 6);
        let b = random_value(mut seed, 3);
        let wrapped = f"[{a.text}]";
        let joined = f"[{a.text},{b.text}]";
        let first = serialize(deserialize(0, a.text));
        for arm in 0..4 {
            checks += 5;
            let x = deserialize(arm, a.text);
            let text = serialize(x);
            if text != a.text {
                fails[0] += 1;
            }
            let (depth, count, sum) = shape(x);
            if depth != a.depth or count != a.count or sum != a.sum {
                fails[1] += 1;
            }
            if text != first {
                fails[2] += 1;
            }
            match items_of(deserialize(arm, wrapped)) {
                Some(items) => {
                    if items.len() != 1 or items[0] != a.text {
                        fails[3] += 1;
                    }
                }
                None => fails[3] += 1,
            }
            match items_of(deserialize(arm, joined)) {
                Some(items) => {
                    if items.len() != 2 or items[0] != a.text or items[1] != b.text {
                        fails[4] += 1;
                    }
                }
                None => fails[4] += 1,
            }
        }
    }
    let mut failures = 0;
    for i in 0..5 {
        failures += fails[i];
        if fails[i] > 0 {
            println(f"P{i + 1}: {fails[i]} failures");
        }
    }
    println(f"2000 values, {checks} checks, {failures} failures");
}
