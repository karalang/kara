// Benchmark for #385: one serialized value of about 50,000 bytes (the
// problem's limit) built once, then parsed 2,000 times by the kata's ★
// arm (recursive descent). Each parse is walked for its depth, number of
// integers and sum, and folded into a checksum.

enum NestedInteger {
    Int(i64),
    List(Vec[NestedInteger]),
}

fn deserialize(s: Str) -> NestedInteger {
    let b = s.bytes();
    let mut pos = 0;
    parse_value(b, mut pos)
}

fn parse_value(b: Slice[u8], pos: mut ref i64) -> NestedInteger {
    if b[*pos] == b'[' {
        *pos += 1;
        let mut items: Vec[NestedInteger] = Vec.new();
        if b[*pos] == b']' {
            *pos += 1;
            return NestedInteger.List(items);
        }
        loop {
            items.push(parse_value(b, mut pos));
            if b[*pos] == b',' {
                *pos += 1;
            } else {
                *pos += 1;
                return NestedInteger.List(items);
            }
        }
    }
    let mut negative = false;
    if b[*pos] == b'-' {
        negative = true;
        *pos += 1;
    }
    let mut n: i64 = 0;
    while *pos < b.len() and b[*pos] >= b'0' and b[*pos] <= b'9' {
        n = n * 10 + (b[*pos] - b'0') as i64;
        *pos += 1;
    }
    NestedInteger.Int(if negative { -n } else { n })
}

// The deepest nesting of lists, the number of integers and their sum.
fn shape(x: ref NestedInteger) -> (i64, i64, i64) {
    match x {
        NestedInteger.Int(n) => (0, 1, *n),
        NestedInteger.List(items) => {
            let mut depth = 0;
            let mut count = 0;
            let mut sum = 0;
            for item in items.iter() {
                let (d, c, s) = shape(item);
                if d > depth {
                    depth = d;
                }
                count += c;
                sum += s;
            }
            (depth + 1, count, sum)
        }
    }
}

// A random value: an integer, or a list of up to 4 values, never deeper
// than `depth` more levels.
fn random_value(seed: mut ref i64, depth: i64) -> String {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    let r = (*seed / 65536) % 10;
    if depth == 0 or r < 4 {
        *seed = (*seed * 1103515245 + 12345) % 2147483648;
        let v = (*seed / 65536) % 2000001 - 1000000;
        return f"{v}";
    }
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    let n = (*seed / 65536) % 5;
    let mut out = String.from("[");
    for i in 0..n {
        if i > 0 {
            out.push(',');
        }
        out.push_str(random_value(mut seed, depth - 1));
    }
    out.push(']');
    out
}

fn main() {
    let mut seed: i64 = 385;
    let mut s = String.from("[");
    while s.len() < 49000 {
        if s.len() > 1 {
            s.push(',');
        }
        s.push_str(random_value(mut seed, 5));
    }
    s.push(']');
    let mut checksum: i64 = 0;
    for _ in 0..2000 {
        let x = deserialize(s);
        let (depth, count, sum) = shape(x);
        checksum = ((checksum * 31 + depth * 7 + count) % 1000000007 + sum % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"{s.len()} bytes parsed 2000 times, checksum {checksum}");
}
