// LeetCode #355: Design Twitter -- per-user tweet lists merged newest-first
// through a priority queue.
//
// Every tweet gets a global timestamp. Each user keeps their own tweets in
// posting order, so the newest is last. A news feed holds the ten most recent
// tweets by the user and by everyone they follow: start a max-first queue with
// each author's newest tweet, and every time one is popped push that author's
// next older tweet. At most ten pops, each O(log f) for f authors.

// One candidate in the merge: an author's tweet at `index` in their list.
// Derived `Ord` compares fields in order, so the newest timestamp ranks
// first in a max-first queue.
//
// A struct rather than the tuple `(time, tweet, author, index)`: a
// `PriorityQueue` of tuples does not build yet (kara B-2026-10-06-87, `.cmp()`
// on an indexed tuple element has no codegen dispatch). Revert to the tuple
// once that is fixed.
#[derive(PartialEq, Eq, PartialOrd, Ord)]
struct Candidate {
    time: i64,
    tweet: i64,
    author: i64,
    index: i64,
}

struct Twitter {
    clock: i64,
    tweets: Map[i64, Vec[(i64, i64)]],
    follows: Map[i64, Set[i64]],
}

impl Twitter {
    fn new() -> Twitter {
        Twitter { clock: 0, tweets: Map.new(), follows: Map.new() }
    }

    fn post_tweet(mut ref self, user: i64, tweet: i64) {
        self.clock += 1;
        // design.md writes this `or_insert_with(Vec.new)`; a builtin
        // constructor is not accepted as a function value yet (kara
        // B-2026-10-06-118). Revert once that is fixed.
        self.tweets.entry(user).or_insert(Vec.new()).push((self.clock, tweet));
    }

    fn news_feed(ref self, user: i64) -> Vec[i64] {
        let mut authors: Vec[i64] = vec![user];
        if let Some(followed) = self.follows.get(user) {
            for f in followed.iter() {
                if f != user {
                    authors.push(f);
                }
            }
        }
        let mut queue: PriorityQueue[Candidate] = PriorityQueue.max_first();
        for a in authors {
            if let Some(list) = self.tweets.get(a) {
                if list.len() > 0 {
                    let last = list.len() - 1;
                    let (time, tweet) = list[last];
                    queue.push(Candidate { time, tweet, author: a, index: last });
                }
            }
        }
        let mut feed: Vec[i64] = Vec.new();
        while feed.len() < 10 {
            match queue.pop() {
                Some(c) => {
                    feed.push(c.tweet);
                    if c.index > 0 {
                        let (time, tweet) = self.tweets.get(c.author).unwrap()[c.index - 1];
                        queue.push(Candidate { time, tweet, author: c.author, index: c.index - 1 });
                    }
                }
                None => break,
            }
        }
        feed
    }

    fn follow(mut ref self, follower: i64, followee: i64) {
        self.follows.entry(follower).or_insert(Set.new()).insert(followee);
    }

    fn unfollow(mut ref self, follower: i64, followee: i64) {
        // `self.follows.entry(follower).and_modify(|set| { set.remove(followee); })`
        // is the entry-API spelling; a method on a collection-valued
        // `and_modify` parameter does not build yet (kara B-2026-10-06-119).
        // Revert once that is fixed.
        if self.follows.contains_key(follower) {
            self.follows[follower].remove(followee);
        }
    }
}

fn show(label: String, feed: Vec[i64]) {
    println(f"{label}: {feed}");
}

fn main() {
    // The LeetCode example.
    let mut t = Twitter.new();
    t.post_tweet(1, 5);
    show("example feed 1", t.news_feed(1));
    t.follow(1, 2);
    t.post_tweet(2, 6);
    show("example feed 2", t.news_feed(1));
    t.unfollow(1, 2);
    show("example feed 3", t.news_feed(1));

    // Edge cases.
    let mut e = Twitter.new();
    show("nobody has posted", e.news_feed(7));
    e.follow(7, 7);
    e.post_tweet(7, 70);
    show("following yourself shows each tweet once", e.news_feed(7));
    e.unfollow(7, 7);
    show("unfollowing yourself keeps your own tweets", e.news_feed(7));
    e.unfollow(7, 99);
    show("unfollowing a stranger is a no-op", e.news_feed(7));
    for i in 0..15 {
        e.post_tweet(8, 800 + i);
    }
    e.follow(7, 8);
    show("only the ten newest", e.news_feed(7));
    e.post_tweet(7, 71);
    e.post_tweet(9, 90);
    e.follow(7, 9);
    show("interleaved authors", e.news_feed(7));
    e.follow(7, 9);
    show("following twice changes nothing", e.news_feed(7));
    show("a follower's view is not shared", e.news_feed(8));

    // A long run: 40 users, 20,000 random operations from a linear
    // congruential generator (its high bits; the low bits have short
    // periods); every feed is folded into a checksum.
    let mut g = Twitter.new();
    let mut seed: i64 = 355;
    let mut checksum: i64 = 0;
    let mut feeds = 0;
    let mut next_tweet = 1000;
    for step in 0..20000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let op = (seed / 65536) % 10;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let a = (seed / 65536) % 40;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let b = (seed / 65536) % 40;
        if op < 4 {
            g.post_tweet(a, next_tweet);
            next_tweet += 1;
        } else if op < 6 {
            g.follow(a, b);
        } else if op < 7 {
            g.unfollow(a, b);
        } else {
            let feed = g.news_feed(a);
            feeds += 1;
            for id in feed {
                checksum = (checksum * 31 + id) % 1000000007;
            }
            checksum = (checksum * 31 + step) % 1000000007;
        }
    }
    println(f"20000 random operations: {feeds} feeds, {next_tweet - 1000} tweets, checksum {checksum}");
}
