// LeetCode #355: Design Twitter -- per-user linked lists, merged by picking
// the newest head each round.
//
// Each user's tweets form a singly linked list of shared nodes, newest at the
// head, so posting is a constant-time push to the front. A news feed keeps
// one cursor per author (the user plus everyone they follow) and, ten times
// at most, takes the cursor whose node is newest and advances it. That is
// O(10 * f) for f authors with no heap at all.

shared struct Node {
    time: i64,
    tweet: i64,
    next: Option[Node],
}

struct Twitter {
    clock: i64,
    heads: Map[i64, Node],
    follows: Map[i64, Set[i64]],
}

impl Twitter {
    fn new() -> Twitter {
        Twitter { clock: 0, heads: Map.new(), follows: Map.new() }
    }

    fn post_tweet(mut ref self, user: i64, tweet: i64) {
        self.clock += 1;
        let next = self.heads.get(user);
        self.heads.insert(user, Node { time: self.clock, tweet, next });
    }

    fn news_feed(ref self, user: i64) -> Vec[i64] {
        // One cursor per author with tweets left; an exhausted author drops
        // out of the list.
        //
        // `Vec[Option[Node]]` cursors advanced with `cursors[i] = node.next` is
        // the first spelling to reach for, and it frees nodes that are still
        // linked under `karac build` (kara B-2026-10-06-121). Revert
        // once that is fixed.
        let mut cursors: Vec[Node] = Vec.new();
        if let Some(head) = self.heads.get(user) {
            cursors.push(head);
        }
        if let Some(followed) = self.follows.get(user) {
            for f in followed.iter() {
                if f != user {
                    if let Some(head) = self.heads.get(f) {
                        cursors.push(head);
                    }
                }
            }
        }
        let mut feed: Vec[i64] = Vec.new();
        while feed.len() < 10 and cursors.len() > 0 {
            let mut best = 0;
            for i in 1..cursors.len() {
                if cursors[i].time > cursors[best].time {
                    best = i;
                }
            }
            feed.push(cursors[best].tweet);
            match cursors[best].next {
                Some(older) => { cursors[best] = older; }
                None => {
                    cursors.remove(best);
                }
            }
        }
        feed
    }

    fn follow(mut ref self, follower: i64, followee: i64) {
        self.follows.entry(follower).or_insert(Set.new()).insert(followee);
    }

    fn unfollow(mut ref self, follower: i64, followee: i64) {
        if self.follows.contains_key(follower) {
            self.follows[follower].remove(followee);
        }
    }
}

fn show(label: String, feed: Vec[i64]) {
    println(f"{label}: {feed}");
}

fn main() {
    // The LeetCode example.
    let mut t = Twitter.new();
    t.post_tweet(1, 5);
    show("example feed 1", t.news_feed(1));
    t.follow(1, 2);
    t.post_tweet(2, 6);
    show("example feed 2", t.news_feed(1));
    t.unfollow(1, 2);
    show("example feed 3", t.news_feed(1));

    // Edge cases.
    let mut e = Twitter.new();
    show("nobody has posted", e.news_feed(7));
    e.follow(7, 7);
    e.post_tweet(7, 70);
    show("following yourself shows each tweet once", e.news_feed(7));
    e.unfollow(7, 7);
    show("unfollowing yourself keeps your own tweets", e.news_feed(7));
    e.unfollow(7, 99);
    show("unfollowing a stranger is a no-op", e.news_feed(7));
    for i in 0..15 {
        e.post_tweet(8, 800 + i);
    }
    e.follow(7, 8);
    show("only the ten newest", e.news_feed(7));
    e.post_tweet(7, 71);
    e.post_tweet(9, 90);
    e.follow(7, 9);
    show("interleaved authors", e.news_feed(7));
    e.follow(7, 9);
    show("following twice changes nothing", e.news_feed(7));
    show("a follower's view is not shared", e.news_feed(8));

    // A long run: 40 users, 20,000 random operations from a linear
    // congruential generator (its high bits; the low bits have short
    // periods); every feed is folded into a checksum.
    let mut g = Twitter.new();
    let mut seed: i64 = 355;
    let mut checksum: i64 = 0;
    let mut feeds = 0;
    let mut next_tweet = 1000;
    for step in 0..20000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let op = (seed / 65536) % 10;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let a = (seed / 65536) % 40;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let b = (seed / 65536) % 40;
        if op < 4 {
            g.post_tweet(a, next_tweet);
            next_tweet += 1;
        } else if op < 6 {
            g.follow(a, b);
        } else if op < 7 {
            g.unfollow(a, b);
        } else {
            let feed = g.news_feed(a);
            feeds += 1;
            for id in feed {
                checksum = (checksum * 31 + id) % 1000000007;
            }
            checksum = (checksum * 31 + step) % 1000000007;
        }
    }
    println(f"20000 random operations: {feeds} feeds, {next_tweet - 1000} tweets, checksum {checksum}");
}
