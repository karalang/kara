// LeetCode #395: Longest Substring with At Least K Repeating Characters
// -- divide and conquer.
//
// Count the letters of the range. A letter that appears fewer than k
// times in it can be in no answer inside the range, so the answer lies
// wholly between two such letters: split there and solve each piece. A
// range with no such letter is itself an answer. Each level of splitting
// removes at least one distinct letter from every piece, so the depth is
// at most 26 and the time O(26 n).

fn longest(b: Slice[u8], lo: i64, hi: i64, k: i64) -> i64 {
    if hi - lo < k {
        return 0;
    }
    let mut count = vec![0; 26];
    for i in lo..hi {
        count[(b[i] - 97) as i64] += 1;
    }
    let mut best = 0;
    let mut start = lo;
    let mut split = false;
    for i in lo..hi {
        if count[(b[i] - 97) as i64] < k {
            split = true;
            best = best.max(longest(b, start, i, k));
            start = i + 1;
        }
    }
    if not split {
        return hi - lo;
    }
    best.max(longest(b, start, hi, k))
}

fn longest_substring(s: Str, k: i64) -> i64 {
    let b = s.bytes();
    longest(b, 0, b.len(), k)
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str, k: i64) {
    println(f"s = \"{s}\", k = {k}: {longest_substring(s, k)}");
}

fn main() {
    show("aaabb", 3);
    show("ababbc", 2);
    show("a", 1);
    show("a", 2);
    show("abcde", 1);
    show("abcde", 2);
    show("aaabbbcdd", 3);
    show("bbaaacbd", 3);
    show("weitong", 2);
    show("aabbccddeeffgghhiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz", 2);
    show("aaaaaaaaaab", 2);

    // 3000 random strings of 1 to 40 letters from "abcd", k from 1 to 5.
    let mut seed: i64 = 395;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + step(mut seed) % 40;
        let mut s = String.new();
        for _ in 0..n {
            s.push((step(mut seed) % 4 + 97) as u8 as char);
        }
        let k = 1 + step(mut seed) % 5;
        let r = longest_substring(s, k);
        total += r;
        checksum = (checksum * 41 + r) % 1000000007;
    }
    println(f"3000 random strings: total {total}, checksum {checksum}");
}
