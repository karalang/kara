// LeetCode #395: Longest Substring with At Least K Repeating Characters
// -- one sliding window per number of distinct letters.
//
// A plain sliding window does not work: adding a letter can make a window
// valid again, so there is no rule for when to shrink. Fixing the number
// of distinct letters u gives one. For each u from 1 to 26, keep the
// longest window with at most u distinct letters ending at each position;
// when it has exactly u distinct letters and all u appear at least k
// times, it is a candidate. O(26 n) time, O(26) space.

fn longest_substring(s: Str, k: i64) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut best = 0;
    for u in 1..27 {
        let mut count = vec![0; 26];
        let mut kinds = 0;
        let mut enough = 0;
        let mut lo = 0;
        for hi in 0..n {
            let c = (b[hi] - 97) as i64;
            if count[c] == 0 {
                kinds += 1;
            }
            count[c] += 1;
            if count[c] == k {
                enough += 1;
            }
            while kinds > u {
                let d = (b[lo] - 97) as i64;
                if count[d] == k {
                    enough -= 1;
                }
                count[d] -= 1;
                if count[d] == 0 {
                    kinds -= 1;
                }
                lo += 1;
            }
            if kinds == u and enough == u {
                best = best.max(hi - lo + 1);
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str, k: i64) {
    println(f"s = \"{s}\", k = {k}: {longest_substring(s, k)}");
}

fn main() {
    show("aaabb", 3);
    show("ababbc", 2);
    show("a", 1);
    show("a", 2);
    show("abcde", 1);
    show("abcde", 2);
    show("aaabbbcdd", 3);
    show("bbaaacbd", 3);
    show("weitong", 2);
    show("aabbccddeeffgghhiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz", 2);
    show("aaaaaaaaaab", 2);

    // 3000 random strings of 1 to 40 letters from "abcd", k from 1 to 5.
    let mut seed: i64 = 395;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + step(mut seed) % 40;
        let mut s = String.new();
        for _ in 0..n {
            s.push((step(mut seed) % 4 + 97) as u8 as char);
        }
        let k = 1 + step(mut seed) % 5;
        let r = longest_substring(s, k);
        total += r;
        checksum = (checksum * 41 + r) % 1000000007;
    }
    println(f"3000 random strings: total {total}, checksum {checksum}");
}
