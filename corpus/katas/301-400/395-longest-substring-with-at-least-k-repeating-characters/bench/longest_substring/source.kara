// Benchmark for #395: the kata's ★ arm (divide and conquer). Builds a pool
// of 1,000,000 letters once, skewed toward the start of the alphabet (the
// smaller of two random letters), so that some letters are common and
// others rare. Then 10,000 calls, each on a window of 10,000 letters (the
// problem's limit) at a random place, with k from 1 to 30. The answers go
// into a sum and a checksum.

fn longest(b: Slice[u8], lo: i64, hi: i64, k: i64) -> i64 {
    if hi - lo < k {
        return 0;
    }
    let mut count = vec![0; 26];
    for i in lo..hi {
        count[(b[i] - 97) as i64] += 1;
    }
    let mut best = 0;
    let mut start = lo;
    let mut split = false;
    for i in lo..hi {
        if count[(b[i] - 97) as i64] < k {
            split = true;
            best = best.max(longest(b, start, i, k));
            start = i + 1;
        }
    }
    if not split {
        return hi - lo;
    }
    best.max(longest(b, start, hi, k))
}

fn longest_substring(s: Str, k: i64) -> i64 {
    let b = s.bytes();
    longest(b, 0, b.len(), k)
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed: i64 = 395;
    let mut pool = String.new();
    for _ in 0..1000000 {
        let x = step(mut seed) % 26;
        let y = step(mut seed) % 26;
        pool.push((x.min(y) + 97) as u8 as char);
    }
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..10000 {
        let a = (step(mut seed) * 32768 + step(mut seed)) % (1000000 - 10000);
        let k = 1 + step(mut seed) % 30;
        let r = longest_substring(pool[a..a + 10000], k);
        total += r;
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"10000 windows: total {total}, checksum {checksum}");
}
