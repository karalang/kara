// LeetCode #333: Largest BST Subtree — top-down, checking each subtree.
//
// Same spec as `largest_bst.kara`. Walk down from the root. If the subtree
// here is a BST, it is the largest one inside itself, so its size is the
// answer for it; otherwise the answer is the larger of the two children's.
// Checking a subtree passes the open interval its values must lie in down the
// recursion, with an absent bound as `None`, so no sentinel value can collide
// with a real one.
//
// O(n * height) time: a node is re-checked once for each ancestor that is not
// the root of a BST.

struct Node {
    val: i64,
    mut left: i64,
    mut right: i64,
}

fn within(nodes: ref Vec[Node], node: i64, lo: Option[i64], hi: Option[i64]) -> bool {
    if node == -1 {
        return true;
    }
    let val = nodes[node].val;
    if let Some(l) = lo {
        if val <= l {
            return false;
        }
    }
    if let Some(h) = hi {
        if val >= h {
            return false;
        }
    }
    return within(nodes, nodes[node].left, lo, Some(val)) and within(nodes, nodes[node].right, Some(val), hi);
}

fn count(nodes: ref Vec[Node], node: i64) -> i64 {
    if node == -1 {
        return 0;
    }
    return 1 + count(nodes, nodes[node].left) + count(nodes, nodes[node].right);
}

fn largest_from(nodes: ref Vec[Node], node: i64) -> i64 {
    if node == -1 {
        return 0;
    }
    if within(nodes, node, None, None) {
        return count(nodes, node);
    }
    let l = largest_from(nodes, nodes[node].left);
    let r = largest_from(nodes, nodes[node].right);
    return if l > r { l } else { r };
}

fn largest_bst_subtree(nodes: ref Vec[Node]) -> i64 {
    if nodes.len() == 0 {
        return 0;
    }
    return largest_from(nodes, 0);
}

const NULL: i64 = -1000000007;

// The index pool from a level-order array; the root is index 0.
fn build(vals: Slice[i64]) -> Vec[Node] {
    let mut nodes: Vec[Node] = Vec.new();
    if vals.len() == 0 or vals[0] == NULL {
        return nodes;
    }
    nodes.push(Node { val: vals[0], left: -1, right: -1 });
    let mut queue: Vec[i64] = Vec.new();
    queue.push(0);
    let mut head = 0;
    let mut i = 1;
    while head < queue.len() and i < vals.len() {
        let cur = queue[head];
        head += 1;
        if vals[i] != NULL {
            nodes.push(Node { val: vals[i], left: -1, right: -1 });
            let id = nodes.len() - 1;
            nodes[cur].left = id;
            queue.push(id);
        }
        i += 1;
        if i < vals.len() and vals[i] != NULL {
            nodes.push(Node { val: vals[i], left: -1, right: -1 });
            let id = nodes.len() - 1;
            nodes[cur].right = id;
            queue.push(id);
        }
        i += 1;
    }
    return nodes;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

// Plain BST insertion into the pool. An equal value goes right, which a strict
// BST does not allow, so duplicates break the subtrees they land in.
fn insert(nodes: mut ref Vec[Node], v: i64) {
    nodes.push(Node { val: v, left: -1, right: -1 });
    let id = nodes.len() - 1;
    let mut cur = 0;
    while cur != id {
        if v < nodes[cur].val {
            if nodes[cur].left == -1 {
                nodes[cur].left = id;
            }
            cur = nodes[cur].left;
        } else {
            if nodes[cur].right == -1 {
                nodes[cur].right = id;
            }
            cur = nodes[cur].right;
        }
    }
}

// A random BST of `n` values below `range`, then `damage` nodes given a random
// value, which breaks the BST around them.
fn random_tree(seed: mut ref i64, n: i64, range: i64, damage: i64) -> Vec[Node] {
    let mut nodes: Vec[Node] = Vec.new();
    for _ in 0..n {
        let v = (next(seed) * 32768 + next(seed)) % range;
        insert(mut nodes, v);
    }
    for _ in 0..damage {
        let at = next(seed) % n;
        nodes[at].val = (next(seed) * 32768 + next(seed)) % range;
    }
    return nodes;
}

fn show(vals: Vec[i64]) {
    let nodes = build(vals.as_slice());
    let mut parts: Vec[String] = Vec.new();
    for v in vals {
        if v == NULL {
            parts.push("null");
        } else {
            parts.push(v.to_string());
        }
    }
    let shown = parts.join(",");
    println(f"[{shown}] -> {largest_bst_subtree(nodes)}");
}

fn main() {
    show(vec![10, 5, 15, 1, 8, NULL, 7]);
    show(vec![4, 2, 7, 2, 3, 5, NULL, 2, NULL, NULL, NULL, NULL, NULL, 1]);
    show(vec![]);
    show(vec![1]);
    show(vec![2, 2, 2]);
    show(vec![2, 1, 3]);
    show(vec![1, 2, 3]);
    show(vec![3, 2, NULL, 1]);
    show(vec![1, NULL, 2, NULL, 3]);
    show(vec![10, 5, 15, 1, 12, NULL, 20]);
    show(vec![5, 3, 8, 1, 4, 7, 9, NULL, NULL, NULL, NULL, 6]);
    show(vec![-9223372036854775808, NULL, 9223372036854775807]);
    let mut seed = 333;
    for round in 0..6 {
        let n = 5 + round * 7;
        let nodes = random_tree(mut seed, n, 4 * n, round % 3);
        println(f"random {round}: {n} nodes -> {largest_bst_subtree(nodes)}");
    }
    let big = random_tree(mut seed, 20000, 1000000000, 0);
    let damaged = random_tree(mut seed, 20000, 1000000000, 40);
    println(f"big: {big.len()} nodes -> {largest_bst_subtree(big)}, 40 damaged -> {largest_bst_subtree(damaged)}");
}
