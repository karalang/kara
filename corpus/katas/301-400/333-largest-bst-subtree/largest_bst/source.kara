// LeetCode #333: Largest BST Subtree — one post-order pass.
//
// Given the root of a binary tree, return the number of nodes in its largest
// subtree that is a binary search tree: every value in a node's left subtree
// is smaller than the node's, and every value in its right subtree is larger.
// A subtree is a node and ALL of its descendants.
//
//   [10,5,15,1,8,null,7]                             ->  3   (5, 1 and 8)
//   [4,2,7,2,3,5,null,2,null,null,null,null,null,1]  ->  2
//
// Post-order: a node's subtree is a BST when both children's subtrees are, the
// left one's largest value is below the node's and the right one's smallest is
// above it. Each answer carries its size and value range up to the parent, so
// every node is decided once.
//
// The tree is the corpus index pool (`Vec[Node]`, child indices, -1 = none),
// built from LeetCode's level-order array with a NULL sentinel.
//
// O(n) time, O(height) stack.

struct Node {
    val: i64,
    mut left: i64,
    mut right: i64,
}

struct Info {
    bst: bool,
    size: i64,
    lo: i64,
    hi: i64,
}

fn visit(nodes: ref Vec[Node], node: i64, best: mut ref i64) -> Info {
    let val = nodes[node].val;
    let left = nodes[node].left;
    let right = nodes[node].right;
    let mut bst = true;
    let mut size = 1;
    let mut lo = val;
    let mut hi = val;
    if left != -1 {
        let l = visit(nodes, left, best);
        if l.bst and l.hi < val {
            size += l.size;
            lo = l.lo;
        } else {
            bst = false;
        }
    }
    if right != -1 {
        let r = visit(nodes, right, best);
        if r.bst and r.lo > val {
            size += r.size;
            hi = r.hi;
        } else {
            bst = false;
        }
    }
    if bst and size > best {
        best = size;
    }
    return Info { bst: bst, size: size, lo: lo, hi: hi };
}

fn largest_bst_subtree(nodes: ref Vec[Node]) -> i64 {
    if nodes.len() == 0 {
        return 0;
    }
    let mut best = 0;
    let _ = visit(nodes, 0, mut best);
    return best;
}

const NULL: i64 = -1000000007;

// The index pool from a level-order array; the root is index 0.
fn build(vals: Slice[i64]) -> Vec[Node] {
    let mut nodes: Vec[Node] = Vec.new();
    if vals.len() == 0 or vals[0] == NULL {
        return nodes;
    }
    nodes.push(Node { val: vals[0], left: -1, right: -1 });
    let mut queue: Vec[i64] = Vec.new();
    queue.push(0);
    let mut head = 0;
    let mut i = 1;
    while head < queue.len() and i < vals.len() {
        let cur = queue[head];
        head += 1;
        if vals[i] != NULL {
            nodes.push(Node { val: vals[i], left: -1, right: -1 });
            let id = nodes.len() - 1;
            nodes[cur].left = id;
            queue.push(id);
        }
        i += 1;
        if i < vals.len() and vals[i] != NULL {
            nodes.push(Node { val: vals[i], left: -1, right: -1 });
            let id = nodes.len() - 1;
            nodes[cur].right = id;
            queue.push(id);
        }
        i += 1;
    }
    return nodes;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

// Plain BST insertion into the pool. An equal value goes right, which a strict
// BST does not allow, so duplicates break the subtrees they land in.
fn insert(nodes: mut ref Vec[Node], v: i64) {
    nodes.push(Node { val: v, left: -1, right: -1 });
    let id = nodes.len() - 1;
    let mut cur = 0;
    while cur != id {
        if v < nodes[cur].val {
            if nodes[cur].left == -1 {
                nodes[cur].left = id;
            }
            cur = nodes[cur].left;
        } else {
            if nodes[cur].right == -1 {
                nodes[cur].right = id;
            }
            cur = nodes[cur].right;
        }
    }
}

// A random BST of `n` values below `range`, then `damage` nodes given a random
// value, which breaks the BST around them.
fn random_tree(seed: mut ref i64, n: i64, range: i64, damage: i64) -> Vec[Node] {
    let mut nodes: Vec[Node] = Vec.new();
    for _ in 0..n {
        let v = (next(seed) * 32768 + next(seed)) % range;
        insert(mut nodes, v);
    }
    for _ in 0..damage {
        let at = next(seed) % n;
        nodes[at].val = (next(seed) * 32768 + next(seed)) % range;
    }
    return nodes;
}

fn show(vals: Vec[i64]) {
    let nodes = build(vals.as_slice());
    let mut parts: Vec[String] = Vec.new();
    for v in vals {
        if v == NULL {
            parts.push("null");
        } else {
            parts.push(v.to_string());
        }
    }
    let shown = parts.join(",");
    println(f"[{shown}] -> {largest_bst_subtree(nodes)}");
}

fn main() {
    show(vec![10, 5, 15, 1, 8, NULL, 7]);
    show(vec![4, 2, 7, 2, 3, 5, NULL, 2, NULL, NULL, NULL, NULL, NULL, 1]);
    show(vec![]);
    show(vec![1]);
    show(vec![2, 2, 2]);
    show(vec![2, 1, 3]);
    show(vec![1, 2, 3]);
    show(vec![3, 2, NULL, 1]);
    show(vec![1, NULL, 2, NULL, 3]);
    show(vec![10, 5, 15, 1, 12, NULL, 20]);
    show(vec![5, 3, 8, 1, 4, 7, 9, NULL, NULL, NULL, NULL, 6]);
    show(vec![-9223372036854775808, NULL, 9223372036854775807]);
    let mut seed = 333;
    for round in 0..6 {
        let n = 5 + round * 7;
        let nodes = random_tree(mut seed, n, 4 * n, round % 3);
        println(f"random {round}: {n} nodes -> {largest_bst_subtree(nodes)}");
    }
    let big = random_tree(mut seed, 20000, 1000000000, 0);
    let damaged = random_tree(mut seed, 20000, 1000000000, 40);
    println(f"big: {big.len()} nodes -> {largest_bst_subtree(big)}, 40 damaged -> {largest_bst_subtree(damaged)}");
}
