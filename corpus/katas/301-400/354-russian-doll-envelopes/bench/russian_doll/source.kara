// Bench for LeetCode #354 -- the starred arm: sort by width ascending and
// height descending, then a patience-sorting longest increasing subsequence
// over the heights. The same algorithm in every language.
//
// Each of ROUNDS rounds draws COUNT envelopes from a linear congruential
// generator seeded by the round, with sides in 1..=100000, and folds the answer
// into the sink, so no round can be skipped or hoisted.

const ROUNDS: i64 = 20;
const COUNT: i64 = 200000;

fn max_envelopes(envelopes: ref Vec[(i64, i64)]) -> i64 {
    let mut order = envelopes.clone();
    order.sort_by(|a, b| if a.0 != b.0 { a.0.cmp(b.0) } else { b.1.cmp(a.1) });
    let mut tails: Vec[i64] = Vec.new();
    for (_, h) in order.iter() {
        let mut lo = 0;
        let mut hi = tails.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if tails[mid] < h {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo == tails.len() {
            tails.push(h);
        } else {
            tails[lo] = h;
        }
    }
    tails.len()
}

fn main() {
    let mut sink: i64 = 0;
    for round in 0..ROUNDS {
        let mut seed = 354 + round;
        let mut envelopes: Vec[(i64, i64)] = Vec.new();
        for _ in 0..COUNT {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let w = seed % 100000 + 1;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let h = seed % 100000 + 1;
            envelopes.push((w, h));
        }
        sink = (sink * 31 + max_envelopes(envelopes) + round) % 1000000007;
    }
    println(f"{sink}");
}
