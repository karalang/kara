// LeetCode #388: Longest Absolute File Path -- build the tree, then walk it.
//
// Turn the listing into a tree first: one node per line with its name
// length, whether it is a file, and its children, found by keeping the
// most recent node at each depth as the parent of the next deeper line.
// Then a recursive walk carries the path length down and returns the
// longest file path below each node. O(n) time and O(n) space.

struct Node {
    name_len: i64,
    is_file: bool,
    children: Vec[i64],
}

fn longest_below(nodes: ref Vec[Node], at: i64, prefix: i64) -> i64 {
    let path = prefix + nodes[at].name_len;
    if nodes[at].is_file {
        return path;
    }
    let mut best = 0;
    for c in nodes[at].children.iter() {
        let got = longest_below(nodes, *c, path + 1);
        if got > best {
            best = got;
        }
    }
    best
}

fn length_longest_path(input: Str) -> i64 {
    let b = input.bytes();
    // Node 0 is an invisible root above depth 0, with no name and no `/`.
    let mut nodes: Vec[Node] = vec![Node { name_len: 0, is_file: false, children: Vec.new() }];
    let mut parent_at: Vec[i64] = vec![0];
    let mut i = 0;
    while i < b.len() {
        let mut depth = 0;
        while b[i] == b'\t' {
            depth += 1;
            i += 1;
        }
        let start = i;
        let mut is_file = false;
        while i < b.len() and b[i] != b'\n' {
            if b[i] == b'.' {
                is_file = true;
            }
            i += 1;
        }
        let id = nodes.len();
        nodes.push(Node { name_len: i - start, is_file: is_file, children: Vec.new() });
        let parent = parent_at[depth];
        nodes[parent].children.push(id);
        parent_at.truncate(depth + 1);
        parent_at.push(id);
        i += 1;
    }
    let mut best = 0;
    for c in nodes[0].children.iter() {
        let got = longest_below(nodes, *c, 0);
        if got > best {
            best = got;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn show(label: Str, input: Str) {
    println(f"{label}: {length_longest_path(input)}");
}

// A random listing of `entries` entries in a tree at most 7 deep, with
// names of 1 to 12 letters, a third of them files (ending in `.ext`).
// `open` is how many directories enclose the next entry at most: an entry
// can sit at any depth up to `open`, a directory then opens one more level,
// and a file opens none, since files have no children.
fn listing(seed: mut ref i64, entries: i64) -> String {
    let mut out = String.new();
    let mut open = 0;
    let mut depth = 0;
    for k in 0..entries {
        *seed = (*seed * 1103515245 + 12345) % 2147483648;
        let r = (*seed / 65536) % 100;
        // A child of the deepest open directory, a sibling of the last
        // entry, or one to three levels shallower than it.
        if r < 35 {
            depth = open;
        } else if r >= 70 {
            let up = (r - 70) / 10 + 1;
            depth = if up > depth { 0 } else { depth - up };
        }
        if depth > open {
            depth = open;
        }
        *seed = (*seed * 1103515245 + 12345) % 2147483648;
        let name_len = (*seed / 65536) % 12 + 1;
        *seed = (*seed * 1103515245 + 12345) % 2147483648;
        let file = (*seed / 65536) % 3 == 0;
        if k > 0 {
            out.push('\n');
        }
        for _ in 0..depth {
            out.push('\t');
        }
        for _ in 0..name_len {
            *seed = (*seed * 1103515245 + 12345) % 2147483648;
            out.push(((*seed / 65536) % 26 + 97) as u8 as char);
        }
        if file {
            out.push_str(".ext");
            open = depth;
        } else {
            open = if depth < 6 { depth + 1 } else { depth };
        }
    }
    out
}

fn main() {
    show("example 1", "dir\n\tsubdir1\n\tsubdir2\n\t\tfile.ext");
    show("example 2", "dir\n\tsubdir1\n\t\tfile1.ext\n\t\tsubsubdir1\n\tsubdir2\n\t\tsubsubdir2\n\t\t\tfile2.ext");
    show("no files", "a");
    show("one file at the root", "file.txt");
    show("three files at the root", "file1.txt\nfile2.txt\nlongfile.txt");
    show("a name with a dot is a file", "dir\n\ta.b\n\tsub\n\t\tc");
    show("deep file loses to a long shallow one", "d\n\te\n\t\tf\n\t\t\tg.h\nverylongname.txt");
    show("empty directories", "a\n\tb\n\t\tc\nd");
    show("file after a deep dir", "a\n\tb\n\t\tc\n\t\t\td\nx.y");
    show("names with spaces", "dir\n\t a b.txt\n\tsub dir \n\t\t c");
    let mut seed: i64 = 388;
    let mut checksum: i64 = 0;
    let mut longest = 0;
    let mut none = 0;
    for _ in 0..2000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let entries = (seed / 65536) % 30 + 1;
        let s = listing(mut seed, entries);
        let r = length_longest_path(s);
        if r == 0 {
            none += 1;
        }
        if r > longest {
            longest = r;
        }
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"2000 random listings: longest {longest}, {none} without files, checksum {checksum}");
}
