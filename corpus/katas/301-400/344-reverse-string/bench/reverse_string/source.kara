// Benchmark workload for LeetCode #344 — the two-index arm
// (reverse_string.kara), timed as written.
//
// Build once, then punch (BENCHMARKS.md). LEN characters are drawn once from
// a 32-letter alphabet that is half ASCII and half Greek, so the array holds
// one-byte and two-byte code points alike. Each of PUNCHES punches replaces
// one character at a random position, reverses the whole array in place, and
// reads one character back at another random position.
//
// The characters read back are folded into a rolling hash, which is the sink.

const LEN: i64 = 200000;
const PUNCHES: i64 = 4000;
const MODULUS: i64 = 1073741789;

fn reverse_string(s: mut Slice[char]) {
    if s.len() < 2 {
        return;
    }
    let mut i = 0;
    let mut j = s.len() - 1;
    while i < j {
        let t = s[i];
        s[i] = s[j];
        s[j] = t;
        i += 1;
        j -= 1;
    }
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn letter(k: i64) -> char {
    if k < 16 {
        return (97 + k) as u8 as char;
    }
    return char.try_from((945 + k - 16) as u32).unwrap();
}

fn main() {
    let mut seed = 344;
    let mut s: Vec[char] = Vec.new();
    for _ in 0..LEN {
        s.push(letter(next(mut seed) % 32));
    }
    let mut sink = 0;
    for _ in 0..PUNCHES {
        let pos = (next(mut seed) * 32768 + next(mut seed)) % LEN;
        s[pos] = letter(next(mut seed) % 32);
        reverse_string(mut s);
        let at = (next(mut seed) * 32768 + next(mut seed)) % LEN;
        sink = (sink * 31 + (s[at] as u32) as i64) % MODULUS;
    }
    println(f"sink {sink}");
}
