// LeetCode #344: Reverse String — two indices walking toward each other.
//
// Write a function that reverses a string given as an array of characters,
// in place, with O(1) extra memory.
//
//   ['h','e','l','l','o']        ->  ['o','l','l','e','h']
//   ['H','a','n','n','a','h']    ->  ['h','a','n','n','a','H']
//
// Swap the first and last characters, then the second and second-to-last,
// and so on until the two indices meet. An odd length leaves the middle
// character where it is.
//
// O(n) time, O(1) extra space.

fn reverse_string(s: mut Slice[char]) {
    if s.len() < 2 {
        return;
    }
    let mut i = 0;
    let mut j = s.len() - 1;
    while i < j {
        let t = s[i];
        s[i] = s[j];
        s[j] = t;
        i += 1;
        j -= 1;
    }
}

fn show(s: ref Vec[char]) -> String {
    let mut out = String.new();
    for c in s {
        out.push(c);
    }
    return out;
}

fn report(text: String) {
    let mut s: Vec[char] = text.chars().collect();
    reverse_string(mut s);
    println(f"\"{text}\" -> \"{show(s)}\"");
}

fn main() {
    // The examples from the problem statement.
    report("hello");
    report("Hannah");

    // Edge lengths, and characters outside ASCII: each `char` is one code
    // point, so these reverse code point by code point.
    report("");
    report("a");
    report("ab");
    report("racecar");
    report("Kāra");
    report("añb€c🦀d");
    report("tab\there");

    // Reversing twice is the identity, on a long string.
    let mut long: Vec[char] = Vec.new();
    for k in 0..100000 {
        long.push(((k * 7919) % 26 + 97) as u8 as char);
    }
    let original = show(long);
    reverse_string(mut long);
    let first = long[0];
    reverse_string(mut long);
    println(f"100000 letters: first after one reverse '{first}', twice restores: {show(long) == original}");
}
