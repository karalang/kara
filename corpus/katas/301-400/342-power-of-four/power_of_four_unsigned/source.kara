// LeetCode #342: Power of Four — reinterpret as unsigned, no sign test.
//
// Given a 32-bit integer n, return true if n == 4^x for some integer x >= 0.
//
//   16 -> true    5 -> false    1 -> true
//
// Read the 32 bits of n as a `u32`. A negative n then has its top bit set,
// so it is either not a power of two at all or exactly 2^31, which is not a
// power of four. A power of four 2^(2x) has 31 - 2x zeros above its bit, an
// odd count, while 2^31 has none. So the unsigned tests need no separate
// check for n > 0, and 0 fails `is_power_of_two` on its own.
//
// O(1) time and space.

fn is_power_of_four(n: i32) -> bool {
    let u = n as u32;
    return u.is_power_of_two() and u.leading_zeros() % 2 == 1;
}

fn report(n: i32) {
    println(f"{n} -> {is_power_of_four(n)}");
}

const I32_MIN: i32 = -2147483648;
const I32_MAX: i32 = 2147483647;

fn main() {
    // The examples from the problem statement.
    report(16);
    report(5);
    report(1);

    // More single values: small powers, powers of two that are not powers of
    // four, and negatives.
    report(0);
    report(4);
    report(64);
    report(2);
    report(8);
    report(32);
    report(-4);
    report(-16);

    // The largest power of four that fits in 32 bits, its neighbours, the
    // largest power of two, and both ends of the range.
    report(1073741824);
    report(1073741823);
    report(1073741825);
    report(536870912);
    report(I32_MAX);
    report(I32_MIN);

    // Every power of two from 2^0 to 2^30: the even exponents are powers of
    // four, the odd ones are not, and no neighbour above 4 is either.
    let mut p: i32 = 1;
    let mut fours = 0;
    let mut neighbours = 0;
    for k in 0..31 {
        if is_power_of_four(p) {
            fours += 1;
            if k % 2 == 1 {
                println(f"wrong: 2^{k} accepted");
            }
        } else if k % 2 == 0 {
            println(f"wrong: 2^{k} rejected");
        }
        if p > 4 and (is_power_of_four(p - 1) or is_power_of_four(p + 1)) {
            neighbours += 1;
        }
        if k < 30 {
            p *= 2;
        }
    }
    println(f"powers 2^0..2^30: {fours} powers of four, {neighbours} neighbours above 4 accepted");

    // A sweep: every n in [-1000, 1000000].
    let mut count = 0;
    let mut sum: i64 = 0;
    for n in -1000i32..1000001 {
        if is_power_of_four(n) {
            count += 1;
            sum += n as i64;
        }
    }
    println(f"[-1000, 1000000]: {count} powers, sum {sum}");
}
