// LeetCode #372: Super Pow -- the Chinese remainder theorem.
//
// 1337 = 7 * 191 with both prime, so work mod 7 and mod 191 apart. Mod a
// prime p, a^b is 0 when p divides a, and otherwise depends on b only mod
// p - 1 (Fermat), with a remainder of 0 read as p - 1, since b >= 1. Then
// the one number mod 1337 with those two residues is r7 * 191 * x +
// r191 * 7 * y, where 191 x = 1 mod 7 and 7 y = 1 mod 191: x = 4, y = 82.
// O(len(b)).

fn pow_mod(base: i64, exp: i64, m: i64) -> i64 {
    let mut out = 1;
    let mut b = base % m;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            out = out * b % m;
        }
        b = b * b % m;
        e /= 2;
    }
    out
}

fn pow_mod_prime(a: i64, b: ref Vec[i64], p: i64) -> i64 {
    if a % p == 0 {
        return 0;
    }
    let mut e = 0;
    for d in b.iter() {
        e = (e * 10 + d) % (p - 1);
    }
    if e == 0 {
        e = p - 1;
    }
    pow_mod(a, e, p)
}

fn super_pow(a: i64, b: ref Vec[i64]) -> i64 {
    let r7 = pow_mod_prime(a, b, 7);
    let r191 = pow_mod_prime(a, b, 191);
    (r7 * 191 * 4 + r191 * 7 * 82) % 1337
}

fn show(label: String, a: i64, b: Vec[i64]) {
    println(f"{label}: {super_pow(a, b)}");
}

fn main() {
    show("example 1", 2, vec![3]);
    show("example 2", 2, vec![1, 0]);
    show("example 3", 1, vec![4, 3, 3, 8, 5, 2]);
    show("example 4", 2147483647, vec![2, 0, 0]);
    show("a multiple of 1337", 2674, vec![5]);
    show("one more than 1337", 1338, vec![9, 9, 9]);
    show("a = 7, a factor of 1337", 7, vec![1, 2, 3, 4]);
    show("a = 191, the other factor", 191, vec![1, 2, 3, 4]);
    show("exponent 1", 12345, vec![1]);
    let mut nines: Vec[i64] = Vec.new();
    for _ in 0..2000 {
        nines.push(9);
    }
    show("2000 nines", 3, nines);
    // Random bases up to 2^31 - 1 with exponents of up to 200 digits: fold
    // every answer into a checksum.
    let mut seed: i64 = 372;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let a = 1 + (high * 65536 + seed / 32768) % 2147483647;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (seed / 65536) % 200;
        let mut b: Vec[i64] = Vec.new();
        for k in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let d = (seed / 65536) % 10;
            b.push(if k == 0 and d == 0 { 1 } else { d });
        }
        checksum = (checksum * 1337 + super_pow(a, b)) % 1000000007;
    }
    println(f"300 random cases: checksum {checksum}");
}
