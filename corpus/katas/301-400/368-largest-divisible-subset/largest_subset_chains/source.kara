// LeetCode #368: Largest Divisible Subset -- carry the chains forward.
//
// The textbook DP runs the other way: best[i] is the best chain ending at
// a[i] in sorted order, which is a[i] appended to the best chain ending at
// one of its divisors. This arm keeps each best chain itself rather than a
// length and a pointer, and "best" means longest, then lexicographically
// first, so the answer is the first best chain of all. O(n^2) comparisons,
// each up to the chain length.

// Whether chain a should replace chain b: longer, or as long and first in
// lexicographic order.
fn better(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return a.len() > b.len();
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return a[i] < b[i];
        }
    }
    false
}

fn largest_divisible_subset(nums: ref Vec[i64]) -> Vec[i64] {
    let mut a = nums.clone();
    a.sort();
    let mut best: Vec[Vec[i64]] = Vec.new();
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..a.len() {
        let mut chain: Vec[i64] = Vec.new();
        for j in 0..i {
            if a[i] % a[j] == 0 and better(best[j], chain) {
                chain = best[j].clone();
            }
        }
        chain.push(a[i]);
        if better(chain, answer) {
            answer = chain.clone();
        }
        best.push(chain);
    }
    answer
}

fn show(label: String, nums: Vec[i64]) {
    println(f"{label}: {largest_divisible_subset(nums)}");
}

fn main() {
    show("example 1", vec![1, 2, 3]);
    show("example 2", vec![1, 2, 4, 8]);
    show("one number", vec![7]);
    show("primes only", vec![7, 3, 5, 2]);
    show("unsorted input", vec![8, 4, 1, 2, 16, 3]);
    show("two chains of equal length", vec![2, 3, 4, 9]);
    show("the longer chain starts higher", vec![4, 8, 16, 1, 3, 9, 27, 81]);
    show("no 1, shared factors", vec![6, 12, 24, 36, 18, 9]);
    show("large values", vec![1000000000, 2000000000, 500000000, 3, 7]);
    let mut all: Vec[i64] = Vec.new();
    for v in 1..=1000 {
        all.push(v);
    }
    show("1 to 1000", all);
    // Random sets of 1 to 40 distinct numbers up to 500: total the answer
    // sizes and fold every answer into a checksum.
    let mut seed: i64 = 368;
    let mut total = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (seed / 65536) % 40;
        let mut taken = vec![false; 501];
        let mut nums: Vec[i64] = Vec.new();
        while nums.len() < n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let v = 1 + (seed / 65536) % 500;
            if not taken[v] {
                taken[v] = true;
                nums.push(v);
            }
        }
        let out = largest_divisible_subset(nums);
        total += out.len();
        for v in out.iter() {
            checksum = (checksum * 31 + v) % 1000000007;
        }
    }
    println(f"300 random sets: {total} numbers in the answers, checksum {checksum}");
}
