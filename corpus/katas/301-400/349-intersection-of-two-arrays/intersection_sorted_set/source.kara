// LeetCode #349 -- Intersection of Two Arrays, by the library.
//
// Both arrays go into a SortedSet and `intersection` does the work. A
// SortedSet iterates in ascending order, so the answer needs no sort.

fn intersection(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut sa: SortedSet[i64] = SortedSet.new();
    for x in a {
        sa.insert(x);
    }
    let mut sb: SortedSet[i64] = SortedSet.new();
    for y in b {
        sb.insert(y);
    }
    let mut out: Vec[i64] = Vec.new();
    for v in sa.intersection(sb) {
        out.push(v);
    }
    return out;
}

fn fill(n: i64, hi: i64, seed: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    for _ in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x / 16 % (hi + 1));
    }
    return out;
}

fn main() {
    println(f"{intersection([1, 2, 2, 1], [2, 2])}");
    println(f"{intersection([4, 9, 5], [9, 4, 9, 8, 4])}");
    println(f"{intersection([1, 2, 3], [4, 5, 6])}");
    println(f"{intersection([7], [7, 7, 7])}");
    println(f"{intersection([0, 1000, 500], [1000, 0])}");

    // The problem's bounds: 1,000 values each in 0..=1000, over many seeds.
    let mut total = 0;
    let mut count = 0;
    for s in 0..200 {
        let r = intersection(fill(1000, 1000, s), fill(1000, 1000, s + 7919));
        count += r.len();
        for v in r {
            total += v;
        }
    }
    println(f"200 pairs at the bounds: {count} values, sum {total}");
}
