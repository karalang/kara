// LeetCode #349 -- Intersection of Two Arrays, by binary search.
//
// Sort a copy of the second array once, then for each distinct value of the
// sorted first array ask a binary search whether the second holds it.
// O((n + m) log m), and it is the arm to pick when one array is much
// shorter than the other.

fn holds(sorted: ref Vec[i64], v: i64) -> bool {
    let mut lo = 0;
    let mut hi = sorted.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if sorted[mid] < v {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo < sorted.len() and sorted[lo] == v;
}

fn intersection(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut x = a.clone();
    let mut y = b.clone();
    x.sort();
    y.sort();
    let mut out: Vec[i64] = Vec.new();
    for k in 0..x.len() {
        if k > 0 and x[k] == x[k - 1] {
            continue;
        }
        if holds(y, x[k]) {
            out.push(x[k]);
        }
    }
    return out;
}

fn fill(n: i64, hi: i64, seed: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    for _ in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x / 16 % (hi + 1));
    }
    return out;
}

fn main() {
    println(f"{intersection([1, 2, 2, 1], [2, 2])}");
    println(f"{intersection([4, 9, 5], [9, 4, 9, 8, 4])}");
    println(f"{intersection([1, 2, 3], [4, 5, 6])}");
    println(f"{intersection([7], [7, 7, 7])}");
    println(f"{intersection([0, 1000, 500], [1000, 0])}");

    // The problem's bounds: 1,000 values each in 0..=1000, over many seeds.
    let mut total = 0;
    let mut count = 0;
    for s in 0..200 {
        let r = intersection(fill(1000, 1000, s), fill(1000, 1000, s + 7919));
        count += r.len();
        for v in r {
            total += v;
        }
    }
    println(f"200 pairs at the bounds: {count} values, sum {total}");
}
