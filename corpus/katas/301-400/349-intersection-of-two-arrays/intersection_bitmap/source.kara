// LeetCode #349 -- Intersection of Two Arrays, by a presence table.
//
// The problem bounds every value to 0..=1000, so a table of 1,001 flags
// replaces the set. Mark the first array's values, then sweep the table in
// order for values the second array also marks. O(n + m + 1001), and the
// answer comes out ascending.

const MAX_VALUE: i64 = 1000;

fn intersection(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut in_a: Vec[bool] = Vec.new();
    let mut in_b: Vec[bool] = Vec.new();
    for _ in 0..MAX_VALUE + 1 {
        in_a.push(false);
        in_b.push(false);
    }
    for x in a {
        in_a[x] = true;
    }
    for y in b {
        in_b[y] = true;
    }
    let mut out: Vec[i64] = Vec.new();
    for v in 0..MAX_VALUE + 1 {
        if in_a[v] and in_b[v] {
            out.push(v);
        }
    }
    return out;
}

fn fill(n: i64, hi: i64, seed: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    for _ in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push(x / 16 % (hi + 1));
    }
    return out;
}

fn main() {
    println(f"{intersection([1, 2, 2, 1], [2, 2])}");
    println(f"{intersection([4, 9, 5], [9, 4, 9, 8, 4])}");
    println(f"{intersection([1, 2, 3], [4, 5, 6])}");
    println(f"{intersection([7], [7, 7, 7])}");
    println(f"{intersection([0, 1000, 500], [1000, 0])}");

    // The problem's bounds: 1,000 values each in 0..=1000, over many seeds.
    let mut total = 0;
    let mut count = 0;
    for s in 0..200 {
        let r = intersection(fill(1000, 1000, s), fill(1000, 1000, s + 7919));
        count += r.len();
        for v in r {
            total += v;
        }
    }
    println(f"200 pairs at the bounds: {count} values, sum {total}");
}
