// LeetCode #386: Lexicographical Numbers -- depth-first over a digit tree.
//
// The numbers form a tree: 1 to 9 are the roots and the children of x are
// x * 10 to x * 10 + 9. Dictionary order is a preorder walk of it, so
// visit each number, then its children from 0 to 9, stopping as soon as a
// child passes n. O(n) time; the recursion is at most as deep as n has
// digits.

fn visit(x: i64, n: i64, out: mut ref Vec[i64]) {
    out.push(x);
    for d in 0..10 {
        let child = x * 10 + d;
        if child > n {
            return;
        }
        visit(child, n, mut out);
    }
}

fn lexical_order(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for x in 1..10 {
        if x > n {
            break;
        }
        visit(x, n, mut out);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    let v = lexical_order(n);
    let mut s = String.from("[");
    for i in 0..v.len() {
        if i > 0 {
            s.push_str(", ");
        }
        s.push_str(f"{v[i]}");
    }
    s.push(']');
    println(f"n = {n}: {s}");
}

// True when a comes before b in dictionary order of their decimal text.
fn before(a: i64, b: i64) -> bool {
    f"{a}" < f"{b}"
}

// The length, a checksum over positions, and whether every neighbouring
// pair is in dictionary order with every number from 1 to n present.
fn summary(n: i64) -> String {
    let v = lexical_order(n);
    let mut seen = vec![false; n + 1];
    let mut ok = v.len() == n;
    let mut checksum: i64 = 0;
    for i in 0..v.len() {
        let x = v[i];
        if x < 1 or x > n or seen[x] {
            ok = false;
        } else {
            seen[x] = true;
        }
        if i > 0 and not before(v[i - 1], x) {
            ok = false;
        }
        checksum = (checksum * 31 + x) % 1000000007;
    }
    let last = if v.len() > 0 { v[v.len() - 1] } else { 0 };
    f"n = {n}: {v.len()} numbers, last {last}, in order {ok}, checksum {checksum}"
}

fn main() {
    show(13);
    show(2);
    show(1);
    show(9);
    show(10);
    show(21);
    show(100);
    for n in [99, 101, 199, 999, 1000, 4321, 9999, 10000, 50000] {
        println(summary(n));
    }
}
