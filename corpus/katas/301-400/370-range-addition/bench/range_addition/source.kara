// Benchmark for #370: 50 arrays of 100,000 cells, the problem's largest,
// each with 10,000 random range updates, answered with the kata's
// difference array.

fn get_modified_array(length: i64, updates: ref Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut diff = vec![0; length + 1];
    for (start, end, inc) in updates.iter() {
        diff[start] += inc;
        diff[end + 1] -= inc;
    }
    let mut out = vec![0; length];
    let mut running = 0;
    for i in 0..length {
        running += diff[i];
        out[i] = running;
    }
    out
}

fn main() {
    let mut seed: i64 = 370;
    let mut checksum: i64 = 0;
    for _ in 0..50 {
        let mut updates: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..10000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let high = seed / 65536;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let a = (high * 32768 + seed / 65536) % 100000;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let high2 = seed / 65536;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let b = (high2 * 32768 + seed / 65536) % 100000;
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let inc = (seed / 65536) % 2001 - 1000;
            updates.push((a.min(b), a.max(b), inc));
        }
        let out = get_modified_array(100000, updates);
        for v in out.iter() {
            checksum = (checksum * 31 + v + 100000000) % 1000000007;
        }
    }
    println(f"checksum {checksum}");
}
