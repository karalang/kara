// LeetCode #341: Flatten Nested List Iterator — an index path into the tree.
//
// The iterator keeps the whole list and a path of indices from its root to
// the next member: path [2, 0] is the first member of the outer list's third
// member. `has_next` follows the path down: past the end of its list it pops
// a level and moves the parent on, at a list it descends to that list's
// first member, and at an integer it stops.
//
// O(n * d) over the whole iteration for depth d, since each step re-walks
// the path from the root; O(d) space beyond the list itself.

enum Nested {
    Int(i64),
    List(Vec[Nested]),
}

// The length of the list that path[0..depth] leads to, from `items` at
// level k.
fn len_at(items: ref Vec[Nested], path: ref Vec[i64], depth: i64, k: i64) -> i64 {
    if k == depth {
        return items.len();
    }
    match items[path[k]] {
        List(inner) => { return len_at(inner, path, depth, k + 1); }
        Int(_) => { return 0; }
    }
}

// The member the whole path leads to: Some(v) for an integer, None for a
// list.
fn member_at(items: ref Vec[Nested], path: ref Vec[i64], k: i64) -> Option[i64] {
    match items[path[k]] {
        Int(v) => {
            if k == path.len() - 1 {
                return Some(v);
            }
            return None;
        }
        List(inner) => {
            if k == path.len() - 1 {
                return None;
            }
            return member_at(inner, path, k + 1);
        }
    }
}

struct NestedIterator {
    root: Vec[Nested],
    path: Vec[i64],
}

impl NestedIterator {
    fn new(items: Vec[Nested]) -> NestedIterator {
        return NestedIterator { root: items, path: [0] };
    }

    fn has_next(mut ref self) -> bool {
        while not self.path.is_empty() {
            let depth = self.path.len() - 1;
            if self.path[depth] == len_at(self.root, self.path, depth, 0) {
                self.path.pop();
                if not self.path.is_empty() {
                    let up = self.path.len() - 1;
                    self.path[up] += 1;
                }
            } else if member_at(self.root, self.path, 0).is_some() {
                return true;
            } else {
                self.path.push(0);
            }
        }
        return false;
    }

    fn next(mut ref self) -> i64 {
        self.has_next();
        let v = member_at(self.root, self.path, 0).unwrap();
        let last = self.path.len() - 1;
        self.path[last] += 1;
        return v;
    }
}

fn flatten(items: Vec[Nested]) -> Vec[i64] {
    let mut it = NestedIterator.new(items);
    let mut out: Vec[i64] = Vec.new();
    while it.has_next() {
        out.push(it.next());
    }
    return out;
}

// ---- input --------------------------------------------------------------

// Parses the list that starts at text[pos], which must be '['. Leaves pos
// just past the matching ']'.
fn parse_list(text: ref Vec[char], pos: mut ref i64) -> Vec[Nested] {
    let mut items: Vec[Nested] = Vec.new();
    pos += 1;
    while text[pos] != ']' {
        if text[pos] == ',' {
            pos += 1;
        } else if text[pos] == '[' {
            items.push(List(parse_list(text, pos)));
        } else {
            let mut sign = 1;
            if text[pos] == '-' {
                sign = -1;
                pos += 1;
            }
            let mut v = 0;
            while text[pos].is_ascii_digit() {
                v = v * 10 + (text[pos] as i64 - '0' as i64);
                pos += 1;
            }
            items.push(Int(sign * v));
        }
    }
    pos += 1;
    return items;
}

fn parse(text: ref String) -> Vec[Nested] {
    let cs: Vec[char] = text.chars().collect();
    let mut pos = 0;
    return parse_list(cs, mut pos);
}

// A pseudo-random nested list: each list holds 0 to 4 members, and a member
// is a further list one time in three while the depth is below max_depth,
// otherwise an integer from -100 to 100. The outer list holds `top` members.
fn next(state: mut ref i64) -> i64 {
    state = (state * 1103515245 + 12345) % 2147483648;
    return state >> 8;
}

fn gen_member(state: mut ref i64, depth: i64, max_depth: i64, out: mut ref String) {
    if depth < max_depth and next(state) % 3 == 0 {
        out.push('[');
        let count = next(state) % 5;
        for k in 0..count {
            if k > 0 {
                out.push(',');
            }
            gen_member(state, depth + 1, max_depth, out);
        }
        out.push(']');
    } else {
        let v = next(state) % 201 - 100;
        out.push_str(v.to_string());
    }
}

fn gen_text(seed: i64, top: i64, max_depth: i64) -> String {
    let mut state = seed;
    let mut out = String.new();
    out.push('[');
    for k in 0..top {
        if k > 0 {
            out.push(',');
        }
        gen_member(mut state, 1, max_depth, mut out);
    }
    out.push(']');
    return out;
}

// The flattened integers in LeetCode's text form.
fn render(vals: ref Vec[i64]) -> String {
    let mut out = String.new();
    out.push('[');
    for k in 0..vals.len() {
        if k > 0 {
            out.push(',');
        }
        out.push_str(vals[k].to_string());
    }
    out.push(']');
    return out;
}

// Count, sum and an order-sensitive rolling hash of the flattened integers.
fn digest(vals: ref Vec[i64]) -> String {
    let mut sum = 0;
    let mut h = 7;
    for v in vals.iter() {
        sum += v;
        h = (h * 31 + v + 101) % 1000000007;
    }
    return f"{vals.len()} integers, sum {sum}, hash {h}";
}

fn show(text: String) {
    let vals = flatten(parse(text));
    println(f"{text} -> {render(vals)}");
}

fn summary(seed: i64, top: i64, max_depth: i64) {
    let text = gen_text(seed, top, max_depth);
    let vals = flatten(parse(text));
    println(f"seed {seed}, {top} members, depth up to {max_depth}: {text.len()} chars, {digest(vals)}");
}

fn main() {
    show("[[1,1],2,[1,1]]");
    show("[1,[4,[6]]]");
    show("[]");
    show("[[]]");
    show("[[],[[]],7]");
    show("[-3,[-4,[5,[-6]]]]");
    show("[[[[[[[[[[9]]]]]]]]]]");
    show("[0,[0,[0]],1000000]");
    summary(1, 10, 4);
    summary(7, 1000, 8);
    summary(42, 20000, 12);
    summary(2026, 50000, 30);
}
