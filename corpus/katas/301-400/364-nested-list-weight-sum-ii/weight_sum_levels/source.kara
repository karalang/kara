// LeetCode #364: Nested List Weight Sum II -- level by level, with a
// running total.
//
// Walk the list one depth at a time, summing the integers on each level.
// Adding the running sum of all levels so far once per level counts an
// integer at depth d once for every level from d down to the deepest, which
// is its weight. Levels past the deepest integer hold only empty lists and
// must not be counted, or every weight grows by one per such level.

#[derive(Clone)]
enum Nested {
    Int(i64),
    List(Vec[Nested]),
}

fn depth_sum_inverse(list: ref Vec[Nested]) -> i64 {
    let mut sums: Vec[i64] = Vec.new();
    // The number of levels up to and including the deepest integer.
    let mut deepest = 0;
    let mut level: Vec[Nested] = list.clone();
    while not level.is_empty() {
        let mut next_level: Vec[Nested] = Vec.new();
        let mut sum = 0;
        let mut any = false;
        for item in level.iter() {
            match item {
                Int(v) => {
                    sum += v;
                    any = true;
                }
                List(inner) => {
                    for x in inner.iter() {
                        next_level.push(x.clone());
                    }
                }
            }
        }
        sums.push(sum);
        if any {
            deepest = sums.len();
        }
        level = next_level;
    }
    let mut running = 0;
    let mut total = 0;
    for d in 0..deepest {
        running += sums[d];
        total += running;
    }
    total
}

// Parses one element starting at bytes[at] and moves `at` past it.
fn parse_item(bytes: Slice[u8], at: mut ref i64) -> Nested {
    if bytes[at] == b'[' {
        at = at + 1;
        let mut items: Vec[Nested] = Vec.new();
        while bytes[at] != b']' {
            items.push(parse_item(bytes, at));
            if bytes[at] == b',' {
                at = at + 1;
            }
        }
        at = at + 1;
        Nested.List(items)
    } else {
        let mut sign = 1;
        if bytes[at] == b'-' {
            sign = -1;
            at = at + 1;
        }
        let mut v = 0;
        while bytes[at] >= b'0' and bytes[at] <= b'9' {
            v = v * 10 + ((bytes[at] - b'0') as i64);
            at = at + 1;
        }
        Nested.Int(sign * v)
    }
}

// The input is the whole list, written as in LeetCode: "[[1,1],2,[1,1]]".
fn parse(s: ref String) -> Vec[Nested] {
    let bytes = s.bytes();
    let mut at = 0;
    match parse_item(bytes, mut at) {
        List(items) => items,
        Int(_) => Vec.new(),
    }
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    seed / 65536
}

// A random nested list, up to six levels deep, written out as text.
fn random_list(seed: mut ref i64, depth: i64, out: mut ref String) {
    out.push_str("[");
    let n = next(seed) % 5;
    for i in 0..n {
        if i > 0 {
            out.push_str(",");
        }
        if depth < 6 and next(seed) % 3 == 0 {
            random_list(seed, depth + 1, out);
        } else {
            out.push_str(f"{next(seed) % 201 - 100}");
        }
    }
    out.push_str("]");
}

fn show(label: String, text: String) {
    println(f"{label}: {depth_sum_inverse(parse(text))}");
}

fn main() {
    show("example 1", "[[1,1],2,[1,1]]");
    show("example 2", "[1,[4,[6]]]");
    show("an empty list", "[]");
    show("only empty lists", "[[],[[]]]");
    show("one integer", "[5]");
    show("empty lists below the deepest integer", "[1,[[]]]");
    show("a level with no integers", "[1,[[2]]]");
    show("the deep integer first", "[[[7]],1]");
    show("negative integers", "[-3,[2,[-1]]]");
    show("one integer five lists down", "[[[[[1]]]]]");
    show("a staircase", "[1,[2],[[3]],[[[4]]]]");
    let mut seed: i64 = 364;
    let mut checksum: i64 = 0;
    for _ in 0..500 {
        let mut text = String.new();
        random_list(mut seed, 1, mut text);
        checksum = (checksum * 31 + depth_sum_inverse(parse(text)) + 1000000) % 1000000007;
    }
    println(f"500 random lists: checksum {checksum}");
}
