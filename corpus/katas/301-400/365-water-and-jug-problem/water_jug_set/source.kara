// LeetCode #365: Water and Jug Problem -- depth-first search with a set of
// states.
//
// The same six moves as the breadth-first arm, explored from a stack, with
// the visited states in a Set of pairs rather than a table. The order of
// exploration differs; the reachable states, and so the answer, do not.

fn can_measure_water(x: i64, y: i64, target: i64) -> bool {
    if target > x + y {
        return false;
    }
    let mut seen: Set[(i64, i64)] = Set.new();
    let mut stack: Vec[(i64, i64)] = vec![(0, 0)];
    seen.insert((0, 0));
    while not stack.is_empty() {
        let (a, b) = stack.pop().unwrap();
        if a + b == target {
            return true;
        }
        let to_b = a.min(y - b);
        let to_a = b.min(x - a);
        for state in [(x, b), (a, y), (0, b), (a, 0), (a - to_b, b + to_b), (a + to_a, b - to_a)] {
            if seen.insert(state) {
                stack.push(state);
            }
        }
    }
    false
}

fn show(label: String, x: i64, y: i64, target: i64) {
    println(f"{label}: {can_measure_water(x, y, target)}");
}

fn main() {
    show("example 1", 3, 5, 4);
    show("example 2", 2, 6, 5);
    show("example 3", 1, 2, 3);
    show("both jugs full", 4, 9, 13);
    show("more than both jugs hold", 4, 9, 14);
    show("one jug's capacity", 6, 10, 6);
    show("equal jugs, their capacity", 7, 7, 7);
    show("equal jugs, something else", 7, 7, 3);
    show("coprime jugs reach every amount", 8, 13, 1);
    show("not a multiple of the gcd", 6, 15, 10);
    show("a multiple of the gcd", 6, 15, 12);
    show("a one-litre jug", 1, 1000, 999);
    // Random triples: count the measurable ones and fold the answers into a
    // checksum, one bit per triple.
    let mut seed: i64 = 365;
    let mut yes = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let x = 1 + (seed / 65536) % 60;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let y = 1 + (seed / 65536) % 60;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let target = 1 + (seed / 65536) % 130;
        let ok = can_measure_water(x, y, target);
        if ok {
            yes += 1;
        }
        checksum = (checksum * 2 + if ok { 1 } else { 0 }) % 1000000007;
    }
    println(f"3000 random triples: {yes} measurable, checksum {checksum}");
}
