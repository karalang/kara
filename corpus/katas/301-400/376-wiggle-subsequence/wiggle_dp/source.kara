// LeetCode #376: Wiggle Subsequence -- quadratic DP.
//
// up[i] is the longest wiggle subsequence that ends at i with a rise into
// it, down[i] the longest that ends at i with a fall. Every earlier j below
// nums[i] can hand its down[j] a rise, and every earlier j above it can
// hand its up[j] a fall. The textbook form before the O(n) observation
// that only the best of each kind matters. O(n^2).

fn wiggle_max_length(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    if n == 0 {
        return 0;
    }
    let mut up = vec![1; n];
    let mut down = vec![1; n];
    let mut best = 1;
    for i in 1..n {
        for j in 0..i {
            if nums[j] < nums[i] {
                up[i] = up[i].max(down[j] + 1);
            } else if nums[j] > nums[i] {
                down[i] = down[i].max(up[j] + 1);
            }
        }
        best = best.max(up[i]).max(down[i]);
    }
    best
}

fn show(label: String, nums: Vec[i64]) {
    println(f"{label}: {wiggle_max_length(nums)}");
}

fn main() {
    show("example 1", vec![1, 7, 4, 9, 2, 5]);
    show("example 2", vec![1, 17, 5, 10, 13, 15, 10, 5, 16, 8]);
    show("example 3", vec![1, 2, 3, 4, 5, 6, 7, 8, 9]);
    show("one element", vec![42]);
    show("two equal", vec![3, 3]);
    show("two different", vec![3, 8]);
    show("all equal", vec![5, 5, 5, 5, 5]);
    show("plateaus between turns", vec![1, 4, 4, 4, 2, 2, 7, 7, 3]);
    show("strictly falling", vec![9, 7, 5, 3, 1]);
    show("bounds", vec![0, 1000, 0, 1000, 0]);
    // Random arrays of up to 1,000 values in [0, 1000]: fold every answer
    // into a checksum.
    let mut seed: i64 = 376;
    let mut checksum: i64 = 0;
    for case in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (seed / 65536) % 1000;
        // A third of the arrays use only 0 to 5, so runs of equal values
        // are common.
        let top = if case % 3 == 0 { 6 } else { 1001 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            nums.push((seed / 65536) % top);
        }
        checksum = (checksum * 1009 + wiggle_max_length(nums)) % 1000000007;
    }
    println(f"300 random arrays: checksum {checksum}");
}
