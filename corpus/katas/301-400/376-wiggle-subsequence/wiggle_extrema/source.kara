// LeetCode #376: Wiggle Subsequence -- keep the local extremes.
//
// Collapse every run of equal values to one value, then keep the two ends
// and every value that is a strict peak or valley between its neighbours.
// What is kept alternates by construction, and no wiggle can be longer:
// between two kept extremes the values only rise or only fall, so a wiggle
// can use at most one of them. O(n), with an O(n) copy.

fn wiggle_max_length(nums: Vec[i64]) -> i64 {
    let mut flat: Vec[i64] = Vec.new();
    for v in nums.iter() {
        if flat.is_empty() or flat[flat.len() - 1] != v {
            flat.push(v);
        }
    }
    let n = flat.len();
    if n <= 2 {
        return n;
    }
    let mut count = 2;
    for i in 1..n - 1 {
        let peak = flat[i] > flat[i - 1] and flat[i] > flat[i + 1];
        let valley = flat[i] < flat[i - 1] and flat[i] < flat[i + 1];
        if peak or valley {
            count += 1;
        }
    }
    count
}

fn show(label: String, nums: Vec[i64]) {
    println(f"{label}: {wiggle_max_length(nums)}");
}

fn main() {
    show("example 1", vec![1, 7, 4, 9, 2, 5]);
    show("example 2", vec![1, 17, 5, 10, 13, 15, 10, 5, 16, 8]);
    show("example 3", vec![1, 2, 3, 4, 5, 6, 7, 8, 9]);
    show("one element", vec![42]);
    show("two equal", vec![3, 3]);
    show("two different", vec![3, 8]);
    show("all equal", vec![5, 5, 5, 5, 5]);
    show("plateaus between turns", vec![1, 4, 4, 4, 2, 2, 7, 7, 3]);
    show("strictly falling", vec![9, 7, 5, 3, 1]);
    show("bounds", vec![0, 1000, 0, 1000, 0]);
    // Random arrays of up to 1,000 values in [0, 1000]: fold every answer
    // into a checksum.
    let mut seed: i64 = 376;
    let mut checksum: i64 = 0;
    for case in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let n = 1 + (seed / 65536) % 1000;
        // A third of the arrays use only 0 to 5, so runs of equal values
        // are common.
        let top = if case % 3 == 0 { 6 } else { 1001 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            nums.push((seed / 65536) % top);
        }
        checksum = (checksum * 1009 + wiggle_max_length(nums)) % 1000000007;
    }
    println(f"300 random arrays: checksum {checksum}");
}
