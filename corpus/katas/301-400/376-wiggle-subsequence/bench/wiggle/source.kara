// Benchmark for #376: 20,000 random arrays of 1,000 values in [0, 1000],
// the problem's largest, answered with the kata's two running lengths.

fn wiggle_max_length(nums: ref Vec[i64]) -> i64 {
    if nums.is_empty() {
        return 0;
    }
    let mut up = 1;
    let mut down = 1;
    for i in 1..nums.len() {
        if nums[i] > nums[i - 1] {
            up = down + 1;
        } else if nums[i] < nums[i - 1] {
            down = up + 1;
        }
    }
    up.max(down)
}

fn main() {
    let mut seed: i64 = 376;
    let mut checksum: i64 = 0;
    let mut nums: Vec[i64] = vec![0; 1000];
    for case in 0..20000 {
        let top = if case % 3 == 0 { 6 } else { 1001 };
        for i in 0..1000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            nums[i] = (seed / 65536) % top;
        }
        checksum = (checksum * 1009 + wiggle_max_length(nums)) % 1000000007;
    }
    println(f"checksum {checksum}");
}
