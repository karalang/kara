// LeetCode #326: Power of Three — divide out every factor of 3.
//
// Given an integer n (any 32-bit value), return true if n == 3^x for some
// integer x >= 0.
//
//   27 -> true    0 -> false    -1 -> false
//
// A power of three is 3 multiplied by itself, so dividing by 3 for as long as
// the remainder is zero must end at exactly 1. Anything that is not positive
// fails at once: 3^x is never 0 or negative, and the loop would never end on
// 0 anyway, since 0 % 3 == 0 forever.
//
// O(log n) time, O(1) space.

fn is_power_of_three(n: i64) -> bool {
    if n <= 0 {
        return false;
    }
    let mut m = n;
    while m % 3 == 0 {
        m /= 3;
    }
    return m == 1;
}

fn report(n: i64) {
    println(f"{n} -> {is_power_of_three(n)}");
}

const I32_MIN: i64 = -2147483648;
const I32_MAX: i64 = 2147483647;

fn main() {
    // The examples from the problem statement.
    report(27);
    report(0);
    report(-1);

    // More single values: the smallest powers, and near misses.
    report(1);
    report(3);
    report(9);
    report(45);
    report(-3);
    report(-27);
    report(2);

    // 243 = 3^5: the value that sinks the natural-log shortcut, which
    // computes ln(243) / ln(3) = 4.999999999999999.
    report(243);

    // The largest power of three that fits in 32 bits, its neighbours, and
    // both ends of the range.
    report(1162261467);
    report(1162261466);
    report(1162261468);
    report(I32_MAX);
    report(I32_MIN);

    // Every power of three up to 3^19, and the values one either side.
    let mut p = 1;
    let mut hits = 0;
    let mut misses = 0;
    for _ in 0..20 {
        if is_power_of_three(p) {
            hits += 1;
        }
        if is_power_of_three(p - 1) or is_power_of_three(p + 1) {
            if p > 3 {
                misses += 1;
            }
        }
        p *= 3;
    }
    println(f"powers 3^0..3^19: {hits} of 20 accepted, {misses} neighbours above 3 accepted");

    // A sweep: every n in [-1000, 1000000].
    let mut count = 0;
    let mut sum = 0;
    for n in -1000..1000001 {
        if is_power_of_three(n) {
            count += 1;
            sum += n;
        }
    }
    println(f"[-1000, 1000000]: {count} powers, sum {sum}");
}
