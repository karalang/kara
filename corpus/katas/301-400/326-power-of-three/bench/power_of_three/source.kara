// Benchmark workload for LeetCode #326 — the divide-out arm
// (power_of_three.kara), timed as written.
//
// Build once, then punch (BENCHMARKS.md). LEN values are built once, a third
// each of: a power of three 3^0..3^19, a power of three plus or minus one,
// and a random 32-bit value. Powers run the divide loop to the end (up to 19
// rounds). A neighbour is never divisible by 3, so it stops at the first
// remainder, as do two thirds of the random values. Each of PUNCHES punches
// replaces one value at a random position and classifies the whole array
// again.
//
// The count and sum of accepted values are folded into a rolling hash, which
// is the sink.

const LEN: i64 = 300000;
const PUNCHES: i64 = 40;
const MODULUS: i64 = 1073741789;
const I32_MIN: i64 = -2147483648;

fn is_power_of_three(n: i64) -> bool {
    if n <= 0 {
        return false;
    }
    let mut m = n;
    while m % 3 == 0 {
        m /= 3;
    }
    return m == 1;
}

fn next(seed: mut ref i64) -> i64 {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 65536;
}

fn power(k: i64) -> i64 {
    let mut p = 1;
    for _ in 0..k {
        p *= 3;
    }
    return p;
}

fn value(seed: mut ref i64) -> i64 {
    let kind = next(seed) % 3;
    if kind == 0 {
        return power(next(seed) % 20);
    }
    if kind == 1 {
        let p = power(next(seed) % 20);
        if next(seed) % 2 == 0 {
            return p + 1;
        }
        return p - 1;
    }
    let hi = next(seed) * 32768 + next(seed);
    return hi * 4 + next(seed) % 4 + I32_MIN;
}

fn main() {
    let mut seed = 326;
    let mut a: Vec[i64] = Vec.new();
    for _ in 0..LEN {
        a.push(value(mut seed));
    }
    let mut sink = 0;
    for _ in 0..PUNCHES {
        let pos = (next(mut seed) * 32768 + next(mut seed)) % LEN;
        a[pos] = value(mut seed);
        let mut count = 0;
        let mut sum = 0;
        for x in a {
            if is_power_of_three(x) {
                count += 1;
                sum += x;
            }
        }
        sink = (sink * 31 + count + sum % MODULUS) % MODULUS;
    }
    println(f"sink {sink}");
}
