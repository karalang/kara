// LeetCode #392: Is Subsequence -- positions and binary search.
//
// The other answer to the follow-up: for each letter keep the sorted
// positions where it appears in t. Matching s, each letter needs its
// first position after the previous match, which a binary search over
// that letter's list finds. O(|t|) to build, O(|s| log |t|) per query.

fn first_after(positions: Vec[i64], after: i64) -> i64 {
    let mut lo = 0;
    let mut hi = positions.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if positions[mid] <= after {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < positions.len() { positions[lo] } else { -1 }
}

fn is_subsequence(s: Str, t: Str) -> bool {
    let mut positions: Map[char, Vec[i64]] = Map.new();
    let mut i = 0;
    for c in t.chars() {
        positions.entry(c).or_insert(Vec.new()).push(i);
        i += 1;
    }
    let mut last = -1;
    for c in s.chars() {
        match positions.get(c) {
            Some(list) => {
                let at = first_after(list, last);
                if at < 0 {
                    return false;
                }
                last = at;
            },
            None => {
                return false;
            }
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str, t: Str) {
    println(f"s = \"{s}\", t = \"{t}\": {is_subsequence(s, t)}");
}

fn main() {
    show("abc", "ahbgdc");
    show("axc", "ahbgdc");
    show("", "");
    show("", "abc");
    show("a", "");
    show("abc", "abc");
    show("aaa", "aa");
    show("aa", "baba");
    show("cba", "abc");
    show("ace", "abcde");

    // 3000 random pairs over a three-letter alphabet, so that both answers
    // are common: t of 0 to 40 letters, s of 0 to 15.
    let mut seed: i64 = 392;
    let mut yes = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let mut t = String.new();
        let tn = step(mut seed) % 41;
        for _ in 0..tn {
            t.push((step(mut seed) % 3 + 97) as u8 as char);
        }
        let mut s = String.new();
        let sn = step(mut seed) % 16;
        for _ in 0..sn {
            s.push((step(mut seed) % 3 + 97) as u8 as char);
        }
        let r = is_subsequence(s, t);
        if r {
            yes += 1;
        }
        checksum = (checksum * 3 + if r { 1 } else { 2 }) % 1000000007;
    }
    println(f"3000 random pairs: {yes} subsequences, checksum {checksum}");
}
