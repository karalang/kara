// LeetCode #392: Is Subsequence -- a next-occurrence table.
//
// The follow-up asks for many s against one t. Build, once, next[i][c]:
// the first position at or after i where byte c appears in t, or |t| if
// none does. Then each s is matched by jumping: from position p, letter c
// lands at next[p][c], and the next letter searches from one past it.
// O(|t| * 256) to build, then O(|s|) per query.

fn is_subsequence(s: Str, t: Str) -> bool {
    let b = t.bytes();
    let n = b.len();
    let mut next: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n + 1 {
        next.push(vec![n; 256]);
    }
    let mut i = n - 1;
    while i >= 0 {
        next[i] = next[i + 1].clone();
        next[i][b[i] as i64] = i;
        i -= 1;
    }
    let mut p = 0;
    for c in s.bytes() {
        let at = next[p][c as i64];
        if at == n {
            return false;
        }
        p = at + 1;
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str, t: Str) {
    println(f"s = \"{s}\", t = \"{t}\": {is_subsequence(s, t)}");
}

fn main() {
    show("abc", "ahbgdc");
    show("axc", "ahbgdc");
    show("", "");
    show("", "abc");
    show("a", "");
    show("abc", "abc");
    show("aaa", "aa");
    show("aa", "baba");
    show("cba", "abc");
    show("ace", "abcde");

    // 3000 random pairs over a three-letter alphabet, so that both answers
    // are common: t of 0 to 40 letters, s of 0 to 15.
    let mut seed: i64 = 392;
    let mut yes = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let mut t = String.new();
        let tn = step(mut seed) % 41;
        for _ in 0..tn {
            t.push((step(mut seed) % 3 + 97) as u8 as char);
        }
        let mut s = String.new();
        let sn = step(mut seed) % 16;
        for _ in 0..sn {
            s.push((step(mut seed) % 3 + 97) as u8 as char);
        }
        let r = is_subsequence(s, t);
        if r {
            yes += 1;
        }
        checksum = (checksum * 3 + if r { 1 } else { 2 }) % 1000000007;
    }
    println(f"3000 random pairs: {yes} subsequences, checksum {checksum}");
}
