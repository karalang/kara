// Benchmark for #392: the kata's ★ arm (two pointers). Builds a pool of
// 1,000,000 random letters once, then checks 20,000 pairs read out of it
// without copying: s is a window of 100 letters (the problem's limit) and
// t a window of 0 to 10,000 letters (the limit), each at a random place.
// A random t of a few thousand letters holds a random s of 100 about as
// often as not, so both answers are common. The answers go into a count
// and a checksum.

fn is_subsequence(s: Str, t: Str) -> bool {
    let a = s.bytes();
    let mut i = 0;
    for b in t.bytes() {
        if i < a.len() and a[i] == b {
            i += 1;
        }
    }
    i == a.len()
}

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed: i64 = 392;
    let mut pool = String.new();
    for _ in 0..1000000 {
        pool.push((step(mut seed) % 26 + 97) as u8 as char);
    }
    let mut yes = 0;
    let mut checksum: i64 = 0;
    for _ in 0..20000 {
        let a = step(mut seed) * 32768 + step(mut seed);
        let a = a % (1000000 - 100);
        let len = step(mut seed) % 10001;
        let b = (step(mut seed) * 32768 + step(mut seed)) % (1000000 - len);
        let r = is_subsequence(pool[a..a + 100], pool[b..b + len]);
        if r {
            yes += 1;
        }
        checksum = (checksum * 3 + if r { 1 } else { 2 }) % 1000000007;
    }
    println(f"20000 pairs: {yes} subsequences, checksum {checksum}");
}
