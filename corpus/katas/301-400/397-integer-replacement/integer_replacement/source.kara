// LeetCode #397: Integer Replacement -- greedy on the last two bits.
//
// An even n is halved: there is no choice. An odd n ends in 01 or 11.
// Ending in 01, subtracting 1 leaves ...00, which halves twice; ending in
// 11, adding 1 carries into ...00 and clears a run of ones at once, which
// is never worse. The one exception is 3, where 3 -> 2 -> 1 beats
// 3 -> 4 -> 2 -> 1. O(log n) time, O(1) space.

fn integer_replacement(n: i64) -> i64 {
    let mut v = n;
    let mut ops = 0;
    while v != 1 {
        if v % 2 == 0 {
            v = v / 2;
        } else if v == 3 or v % 4 == 1 {
            v -= 1;
        } else {
            v += 1;
        }
        ops += 1;
    }
    ops
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n}: {integer_replacement(n)}");
}

fn main() {
    show(8);
    show(7);
    show(4);
    show(1);
    show(2);
    show(3);
    show(15);
    show(65535);
    show(1073741824);
    show(2147483647);
    let mut seed: i64 = 397;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + (step(mut seed) * 32768 + step(mut seed)) % 2147483647;
        let r = integer_replacement(n);
        total += r;
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"3000 random values: total {total}, checksum {checksum}");
}
