// LeetCode #397: Integer Replacement -- both choices, memoized.
//
// f(1) = 0; an even n costs 1 + f(n / 2); an odd n is followed by its even
// neighbour and a halving whichever way it goes, so it costs
// 2 + min(f((n - 1) / 2), f((n + 1) / 2)). Every value the recursion
// reaches is n >> k or (n >> k) + 1, so the memo holds O(log n) entries.
// O(log n) time, O(log n) space.

fn replace(v: i64, memo: mut ref Map[i64, i64]) -> i64 {
    if v == 1 {
        return 0;
    }
    if let Some(known) = memo.get(v) {
        return *known;
    }
    let r = if v % 2 == 0 {
        1 + replace(v / 2, mut memo)
    } else {
        2 + replace((v - 1) / 2, mut memo).min(replace((v + 1) / 2, mut memo))
    };
    memo.insert(v, r);
    r
}

fn integer_replacement(n: i64) -> i64 {
    let mut memo: Map[i64, i64] = Map.new();
    replace(n, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64) {
    println(f"{n}: {integer_replacement(n)}");
}

fn main() {
    show(8);
    show(7);
    show(4);
    show(1);
    show(2);
    show(3);
    show(15);
    show(65535);
    show(1073741824);
    show(2147483647);
    let mut seed: i64 = 397;
    let mut total: i64 = 0;
    let mut checksum: i64 = 0;
    for _ in 0..3000 {
        let n = 1 + (step(mut seed) * 32768 + step(mut seed)) % 2147483647;
        let r = integer_replacement(n);
        total += r;
        checksum = (checksum * 31 + r) % 1000000007;
    }
    println(f"3000 random values: total {total}, checksum {checksum}");
}
