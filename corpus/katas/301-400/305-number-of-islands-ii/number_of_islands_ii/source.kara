// LeetCode 305 — Number of Islands II
//
// A grid that starts as all water. Each operation turns one cell into land;
// after each one, report how many islands exist. Land connects 4-directionally.
//
// THE ARM: union-find (disjoint set) with union by RANK and PATH COMPRESSION,
// carrying the island count INCREMENTALLY.
//
// The whole idea is that the answer only ever moves in small, local steps. A
// new land cell is its own island, so the count goes UP by one; then it is
// merged with each already-land neighbour it touches, and every merge that
// actually joins two distinct islands brings the count DOWN by one. A cell has
// at most four neighbours, so each operation moves the answer by at most +1 and
// at least -3. Nothing ever rescans the grid.
//
// The subtlety that makes this worth writing carefully: `count -= 1` belongs
// inside the "the two roots really were different" branch, not next to the
// union call. Two neighbours of the new cell can already be part of the SAME
// island — think of adding the fourth cell of a 2x2 block — and merging them
// again must not decrement anything. That single misplaced line is this arm's
// characteristic bug, and it is why the differential carries an arm that
// recomputes the count from scratch and cannot commit it.
//
// `parent[x] == -1` means "still water", which lets one array carry both the
// land/water question and the forest, with no second grid to keep in step.
//
// WHY THE METHOD IS SPELLED `r#union`. `union` is a Kāra keyword — the FFI
// untagged-union type (design.md § FFI Unions) — so it cannot be a bare
// identifier. It is also the name this operation has in every textbook and
// every other language's disjoint-set implementation, so renaming it to
// `merge` would be routing around the collision rather than meeting it. The
// `r#` raw-identifier escape (design.md § Raw Identifiers) is the sanctioned
// spelling for exactly this, and it works at both the definition and the call
// site. The sibling `..._recount.kara` arm spells it `merge` instead, so the
// kata carries one of each.

struct DisjointSet {
    parent: Vec[i64],
    rank: Vec[i64],
    count: i64,
}

impl DisjointSet {
    fn new(n: i64) -> DisjointSet {
        let mut parent: Vec[i64] = Vec.new();
        let mut rank: Vec[i64] = Vec.new();
        for i in 0..n {
            parent.push(-1);
            rank.push(0);
        }
        return DisjointSet { parent: parent, rank: rank, count: 0 };
    }

    fn is_land(ref self, x: i64) -> bool {
        return self.parent[x] >= 0;
    }

    fn add(mut ref self, x: i64) {
        self.parent[x] = x;
        self.count += 1;
    }

    // Two-pass iterative find: walk to the root, then re-walk flattening every
    // node on the path onto it. Iterative rather than recursive so a long chain
    // cannot overflow the stack.
    fn find(mut ref self, x: i64) -> i64 {
        let mut root = x;
        while self.parent[root] != root {
            root = self.parent[root];
        }
        let mut cur = x;
        while self.parent[cur] != root {
            let next = self.parent[cur];
            self.parent[cur] = root;
            cur = next;
        }
        return root;
    }

    fn r#union(mut ref self, a: i64, b: i64) {
        let ra = self.find(a);
        let rb = self.find(b);
        // Already the same island — merging again must NOT change the count.
        if ra == rb {
            return;
        }
        if self.rank[ra] < self.rank[rb] {
            self.parent[ra] = rb;
        } else if self.rank[ra] > self.rank[rb] {
            self.parent[rb] = ra;
        } else {
            self.parent[rb] = ra;
            self.rank[ra] += 1;
        }
        self.count -= 1;
    }
}

fn num_islands2(m: i64, n: i64, positions: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut ds = DisjointSet.new(m * n);
    let mut out: Vec[i64] = Vec.new();
    for k in 0..positions.len() {
        let r = positions[k][0];
        let c = positions[k][1];
        let idx = r * n + c;
        // A repeated position is a no-op: the cell is already land.
        if not ds.is_land(idx) {
            ds.add(idx);
            if r > 0 and ds.is_land(idx - n) { ds.r#union(idx, idx - n); }
            if r < m - 1 and ds.is_land(idx + n) { ds.r#union(idx, idx + n); }
            if c > 0 and ds.is_land(idx - 1) { ds.r#union(idx, idx - 1); }
            if c < n - 1 and ds.is_land(idx + 1) { ds.r#union(idx, idx + 1); }
        }
        out.push(ds.count);
    }
    return out;
}

fn pairs_of(flat: Slice[i64]) -> Vec[Vec[i64]] {
    let mut ps: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    while i + 1 < flat.len() {
        let mut p: Vec[i64] = Vec.new();
        p.push(flat[i]);
        p.push(flat[i + 1]);
        ps.push(p);
        i = i + 2;
    }
    return ps;
}

fn report(m: i64, n: i64, flat: Slice[i64]) {
    let positions = pairs_of(flat);
    let counts = num_islands2(m, n, positions);
    let mut line = String.new();
    line.push_str(f"{m}x{n} ->");
    for k in 0..counts.len() {
        line.push_str(f" {counts[k]}");
    }
    println(line);
}

fn main() {
    // The example from the LeetCode statement.
    report(3, 3, [0, 0,  0, 1,  1, 2,  2, 1]);
    // A repeated position must not change the answer.
    report(3, 3, [0, 0,  0, 0,  0, 1,  0, 1]);
    // One cell.
    report(1, 1, [0, 0]);
    // A row filled left to right, then the gap that joins two runs.
    report(1, 5, [0, 0,  0, 2,  0, 4,  0, 1,  0, 3]);
    // A column, same shape rotated.
    report(5, 1, [0, 0,  2, 0,  4, 0,  1, 0,  3, 0]);
    // The centre of a plus closes four islands at once.
    report(3, 3, [0, 1,  1, 0,  1, 2,  2, 1,  1, 1]);
    // Fill a 2x3 grid completely — must end at exactly one island.
    report(2, 3, [0, 0,  1, 1,  0, 2,  1, 0,  0, 1,  1, 2]);
    // A ring around a hole never closes into one until the last cell.
    report(3, 3, [0, 0,  0, 1,  0, 2,  1, 2,  2, 2,  2, 1,  2, 0,  1, 0]);
}
