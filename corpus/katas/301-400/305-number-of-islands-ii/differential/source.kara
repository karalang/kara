// LeetCode 305 — four arms against each other and against seven properties
// that follow from the STATEMENT rather than from any implementation.
//
//   A  union-find, rank + path compression, count kept INCREMENTALLY
//   B  the same forest, count RECOMPUTED by counting roots every step
//   C  union-find over a sparse Map[i64, i64], union by SIZE
//   D  full flood fill of the whole grid after every operation
//
// WHAT THE ARMS CANNOT SHARE. A's characteristic bug is a misplaced
// `count -= 1` — decrementing on a union whose roots were already equal, or
// failing to decrement on one that genuinely merged. B cannot commit it: it
// keeps no counter, so its count is a pure function of its forest. C shares A's
// incremental counter but not its representation (a Map keyed by land cell, no
// `-1` sentinel) nor its balancing rule (size, not rank), so a fault in the
// dense array indexing or in the rank tie-break has no counterpart there. D
// keeps no structure at all and answers the question the statement asks.
// Between them, a fault localises: if A and C disagree with B while their
// forests agree, the counter is wrong; if D disagrees with all three, the
// merging is wrong.
//
// P7 IS THE ONE NO ARM COMPUTES. The final island count depends only on the SET
// of land cells, never on the order they arrived in. Every arm is inherently
// order-sensitive — each processes operations one at a time and carries state
// forward — so an order dependence is exactly the kind of fault four-way
// agreement is blind to, since all four would carry it. Feeding the same land
// set in several different permutations and requiring one answer tests a
// property of the PROBLEM that no line of any arm is trying to satisfy.
//
// A NOTE ON WHAT P3 CANNOT DO. Per-operation the count moves by at most +1 and
// at least -3 (a new cell is its own island, then merges with at most four
// neighbours). That bound is real but WEAK, and the mutation table in the
// README shows why: the misplaced-decrement bug above turns a legitimate delta
// of 0 into -3, which is still inside the bound. P3 is kept because it pins the
// shape of the answer sequence cheaply, not because it is discriminating.

// ------------------------------------------------------------------- arm A

struct DisjointSet {
    parent: Vec[i64],
    rank: Vec[i64],
    count: i64,
}

impl DisjointSet {
    fn new(n: i64) -> DisjointSet {
        let mut parent: Vec[i64] = Vec.new();
        let mut rank: Vec[i64] = Vec.new();
        for i in 0..n {
            parent.push(-1);
            rank.push(0);
        }
        return DisjointSet { parent: parent, rank: rank, count: 0 };
    }

    fn is_land(ref self, x: i64) -> bool {
        return self.parent[x] >= 0;
    }

    fn add(mut ref self, x: i64) {
        self.parent[x] = x;
        self.count += 1;
    }

    // Two-pass iterative find: walk to the root, then re-walk flattening every
    // node on the path onto it. Iterative rather than recursive so a long chain
    // cannot overflow the stack.
    fn find(mut ref self, x: i64) -> i64 {
        let mut root = x;
        while self.parent[root] != root {
            root = self.parent[root];
        }
        let mut cur = x;
        while self.parent[cur] != root {
            let next = self.parent[cur];
            self.parent[cur] = root;
            cur = next;
        }
        return root;
    }

    fn r#union(mut ref self, a: i64, b: i64) {
        let ra = self.find(a);
        let rb = self.find(b);
        // Already the same island — merging again must NOT change the count.
        if ra == rb {
            return;
        }
        if self.rank[ra] < self.rank[rb] {
            self.parent[ra] = rb;
        } else if self.rank[ra] > self.rank[rb] {
            self.parent[rb] = ra;
        } else {
            self.parent[rb] = ra;
            self.rank[ra] += 1;
        }
        self.count -= 1;
    }
}

fn solve_a(m: i64, n: i64, positions: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut ds = DisjointSet.new(m * n);
    let mut out: Vec[i64] = Vec.new();
    for k in 0..positions.len() {
        let r = positions[k][0];
        let c = positions[k][1];
        let idx = r * n + c;
        // A repeated position is a no-op: the cell is already land.
        if not ds.is_land(idx) {
            ds.add(idx);
            if r > 0 and ds.is_land(idx - n) { ds.r#union(idx, idx - n); }
            if r < m - 1 and ds.is_land(idx + n) { ds.r#union(idx, idx + n); }
            if c > 0 and ds.is_land(idx - 1) { ds.r#union(idx, idx - 1); }
            if c < n - 1 and ds.is_land(idx + 1) { ds.r#union(idx, idx + 1); }
        }
        out.push(ds.count);
    }
    return out;
}

// ------------------------------------------------------------------- arm B

struct Forest {
    parent: Vec[i64],
    rank: Vec[i64],
}

impl Forest {
    fn new(n: i64) -> Forest {
        let mut parent: Vec[i64] = Vec.new();
        let mut rank: Vec[i64] = Vec.new();
        for i in 0..n {
            parent.push(-1);
            rank.push(0);
        }
        return Forest { parent: parent, rank: rank };
    }

    fn is_land(ref self, x: i64) -> bool {
        return self.parent[x] >= 0;
    }

    fn add(mut ref self, x: i64) {
        self.parent[x] = x;
    }

    fn find(mut ref self, x: i64) -> i64 {
        let mut root = x;
        while self.parent[root] != root {
            root = self.parent[root];
        }
        let mut cur = x;
        while self.parent[cur] != root {
            let next = self.parent[cur];
            self.parent[cur] = root;
            cur = next;
        }
        return root;
    }

    fn merge(mut ref self, a: i64, b: i64) {
        let ra = self.find(a);
        let rb = self.find(b);
        if ra == rb {
            return;
        }
        if self.rank[ra] < self.rank[rb] {
            self.parent[ra] = rb;
        } else if self.rank[ra] > self.rank[rb] {
            self.parent[rb] = ra;
        } else {
            self.parent[rb] = ra;
            self.rank[ra] += 1;
        }
    }

    // Every land cell that is its own parent is one island.
    fn island_count(ref self) -> i64 {
        let mut total = 0;
        for i in 0..self.parent.len() {
            if self.parent[i] == i {
                total += 1;
            }
        }
        return total;
    }
}

fn solve_b(m: i64, n: i64, positions: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut f = Forest.new(m * n);
    let mut out: Vec[i64] = Vec.new();
    for k in 0..positions.len() {
        let r = positions[k][0];
        let c = positions[k][1];
        let idx = r * n + c;
        if not f.is_land(idx) {
            f.add(idx);
            if r > 0 and f.is_land(idx - n) { f.merge(idx, idx - n); }
            if r < m - 1 and f.is_land(idx + n) { f.merge(idx, idx + n); }
            if c > 0 and f.is_land(idx - 1) { f.merge(idx, idx - 1); }
            if c < n - 1 and f.is_land(idx + 1) { f.merge(idx, idx + 1); }
        }
        out.push(f.island_count());
    }
    return out;
}

// ------------------------------------------------------------------- arm C

struct SparseSet {
    parent: Map[i64, i64],
    size: Map[i64, i64],
    count: i64,
}

impl SparseSet {
    fn new() -> SparseSet {
        return SparseSet { parent: Map.new(), size: Map.new(), count: 0 };
    }

    fn is_land(ref self, x: i64) -> bool {
        return self.parent.contains_key(x);
    }

    fn add(mut ref self, x: i64) {
        self.parent.insert(x, x);
        self.size.insert(x, 1);
        self.count += 1;
    }

    fn find(mut ref self, x: i64) -> i64 {
        let mut root = x;
        while self.parent[root] != root {
            root = self.parent[root];
        }
        let mut cur = x;
        while self.parent[cur] != root {
            let next = self.parent[cur];
            self.parent.insert(cur, root);
            cur = next;
        }
        return root;
    }

    fn merge(mut ref self, a: i64, b: i64) {
        let ra = self.find(a);
        let rb = self.find(b);
        if ra == rb {
            return;
        }
        // Hang the smaller tree under the larger one.
        let sa = self.size[ra];
        let sb = self.size[rb];
        if sa < sb {
            self.parent.insert(ra, rb);
            self.size.insert(rb, sa + sb);
        } else {
            self.parent.insert(rb, ra);
            self.size.insert(ra, sa + sb);
        }
        self.count -= 1;
    }
}

fn solve_c(m: i64, n: i64, positions: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut ss = SparseSet.new();
    let mut out: Vec[i64] = Vec.new();
    for k in 0..positions.len() {
        let r = positions[k][0];
        let c = positions[k][1];
        let idx = r * n + c;
        if not ss.is_land(idx) {
            ss.add(idx);
            if r > 0 and ss.is_land(idx - n) { ss.merge(idx, idx - n); }
            if r < m - 1 and ss.is_land(idx + n) { ss.merge(idx, idx + n); }
            if c > 0 and ss.is_land(idx - 1) { ss.merge(idx, idx - 1); }
            if c < n - 1 and ss.is_land(idx + 1) { ss.merge(idx, idx + 1); }
        }
        out.push(ss.count);
    }
    return out;
}

// ------------------------------------------------------------------- arm D

fn count_islands_d(grid: ref Vec[i64], m: i64, n: i64) -> i64 {
    let mut work: Vec[i64] = Vec.new();
    for i in 0..grid.len() {
        work.push(grid[i]);
    }
    let mut islands = 0;
    for start in 0..(m * n) {
        if work[start] == 1 {
            islands += 1;
            let mut stack: Vec[i64] = Vec.new();
            stack.push(start);
            work[start] = 0;
            while stack.len() > 0 {
                let cur = stack[stack.len() - 1];
                let _ = stack.pop();
                let r = cur / n;
                let c = cur % n;
                if r > 0 and work[cur - n] == 1 { work[cur - n] = 0; stack.push(cur - n); }
                if r < m - 1 and work[cur + n] == 1 { work[cur + n] = 0; stack.push(cur + n); }
                if c > 0 and work[cur - 1] == 1 { work[cur - 1] = 0; stack.push(cur - 1); }
                if c < n - 1 and work[cur + 1] == 1 { work[cur + 1] = 0; stack.push(cur + 1); }
            }
        }
    }
    return islands;
}

fn solve_d(m: i64, n: i64, positions: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut grid: Vec[i64] = Vec.new();
    for i in 0..(m * n) {
        grid.push(0);
    }
    let mut out: Vec[i64] = Vec.new();
    for k in 0..positions.len() {
        let r = positions[k][0];
        let c = positions[k][1];
        grid[r * n + c] = 1;
        out.push(count_islands_d(grid, m, n));
    }
    return out;
}

// ------------------------------------------------------------------ harness

fn make_permutation(n: i64, seed: i64) -> Vec[i64] {
    let mut xs: Vec[i64] = Vec.new();
    for i in 0..n {
        xs.push(i);
    }
    // Fisher-Yates over the LCG.
    let mut state = seed;
    let mut i = n - 1;
    while i > 0 {
        state = (state * 1103515245 + 12345) % 2147483648;
        let j = state % (i + 1);
        let t = xs[i];
        xs[i] = xs[j];
        xs[j] = t;
        i = i - 1;
    }
    return xs;
}

// Turn a list of encoded cells into the (row, col) pair list the arms take.
fn positions_of(cells: ref Vec[i64], n: i64) -> Vec[Vec[i64]] {
    let mut ps: Vec[Vec[i64]] = Vec.new();
    for k in 0..cells.len() {
        let mut p: Vec[i64] = Vec.new();
        p.push(cells[k] / n);
        p.push(cells[k] % n);
        ps.push(p);
    }
    return ps;
}

// An independent island count over a land SET, sharing no code with any arm.
fn oracle_count(cells: ref Vec[i64], m: i64, n: i64) -> i64 {
    let mut grid: Vec[i64] = Vec.new();
    for i in 0..(m * n) {
        grid.push(0);
    }
    for k in 0..cells.len() {
        grid[cells[k]] = 1;
    }
    return count_islands_d(grid, m, n);
}

fn main() {
    let mut sequences = 0;
    let mut steps = 0;
    let mut p1 = 0;
    let mut p2 = 0;
    let mut p3 = 0;
    let mut p4 = 0;
    let mut p5 = 0;
    let mut p6 = 0;
    let mut p7 = 0;

    let mut m = 1;
    while m <= 6 {
        let mut n = 1;
        while n <= 6 {
            let cells = m * n;
            let mut round = 0;
            while round < 60 {
                let seed = 7919 * (m * 61 + n) + round * 104729 + 1;

                // A random permutation of every cell: the grid fills completely.
                let order = make_permutation(cells, seed);
                let ps = positions_of(order, n);

                let ra = solve_a(m, n, ps);
                let rb = solve_b(m, n, ps);
                let rc = solve_c(m, n, ps);
                let rd = solve_d(m, n, ps);

                let mut prev = 0;
                let mut k = 0;
                while k < ra.len() {
                    steps += 1;

                    // P1 — four arms, one answer, at every step.
                    if rb[k] != ra[k] { p1 += 1; }
                    if rc[k] != ra[k] { p1 += 1; }
                    if rd[k] != ra[k] { p1 += 1; }

                    // P2 — never negative, never more islands than land cells.
                    if ra[k] < 0 or ra[k] > k + 1 { p2 += 1; }

                    // P3 — one operation moves the count by at most +1, at least -3.
                    let delta = ra[k] - prev;
                    if delta > 1 or delta < 0 - 3 { p3 += 1; }
                    prev = ra[k];

                    // P5 — the running answer matches an independent recount of
                    // the land set added so far.
                    let mut sofar: Vec[i64] = Vec.new();
                    let mut j = 0;
                    while j <= k {
                        sofar.push(order[j]);
                        j = j + 1;
                    }
                    if oracle_count(sofar, m, n) != ra[k] { p5 += 1; }

                    k = k + 1;
                }

                // P6 — a completely filled grid is exactly one island.
                if ra[ra.len() - 1] != 1 { p6 += 1; }

                // P7 — the FINAL count depends on the land SET, not the order.
                // Take a prefix of this permutation as the land set, then feed
                // it in three more independent orders.
                let take = 1 + (cells * 2) / 3;
                let mut subset: Vec[i64] = Vec.new();
                let mut t = 0;
                while t < take {
                    subset.push(order[t]);
                    t = t + 1;
                }
                let base = solve_a(m, n, positions_of(subset, n));
                let want = base[base.len() - 1];
                let mut variant = 1;
                while variant <= 3 {
                    let perm = make_permutation(take, seed + variant * 7717);
                    let mut shuffled: Vec[i64] = Vec.new();
                    let mut q = 0;
                    while q < take {
                        shuffled.push(subset[perm[q]]);
                        q = q + 1;
                    }
                    let got = solve_a(m, n, positions_of(shuffled, n));
                    if got[got.len() - 1] != want { p7 += 1; }
                    variant = variant + 1;
                }

                // P4 — repeating every position is a no-op: doubling each
                // operation must produce each answer twice and nothing else.
                let mut doubled: Vec[i64] = Vec.new();
                let mut z = 0;
                while z < order.len() {
                    doubled.push(order[z]);
                    doubled.push(order[z]);
                    z = z + 1;
                }
                let rdup = solve_a(m, n, positions_of(doubled, n));
                let mut w = 0;
                while w < ra.len() {
                    if rdup[2 * w] != ra[w] or rdup[2 * w + 1] != ra[w] { p4 += 1; }
                    w = w + 1;
                }

                sequences += 1;
                round = round + 1;
            }
            n = n + 1;
        }
        m = m + 1;
    }

    println(f"sequences {sequences}");
    println(f"steps {steps}");
    println(f"P1 arm disagreements {p1}");
    println(f"P2 range failures {p2}");
    println(f"P3 delta-bound failures {p3}");
    println(f"P4 duplicate-op failures {p4}");
    println(f"P5 independent-recount failures {p5}");
    println(f"P6 filled-grid failures {p6}");
    println(f"P7 order-dependence failures {p7}");

    if p1 == 0 and p2 == 0 and p3 == 0 and p4 == 0 and p5 == 0 and p6 == 0 and p7 == 0 {
        println("DIFFERENTIAL OK");
    } else {
        println("DIFFERENTIAL FAILED");
    }
}
