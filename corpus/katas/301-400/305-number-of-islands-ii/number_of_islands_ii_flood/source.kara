// LeetCode 305 — arm D: no incremental structure at all.
//
// Keep the grid. After each operation, sink every island by flood fill and
// count how many fills it took. O(mn) per operation with a fresh scan every
// time — the definition of "how many islands are there", transcribed, with the
// dynamic part of the problem thrown away.
//
// This is the arm with no cleverness to be wrong about, and it is deliberately
// the mechanism of kata #200 (Number of Islands), which is the static version
// of this problem: an iterative stack of encoded `r * n + c` positions rather
// than recursion, so a single large island cannot overflow the call stack.
// Reusing a known-good mechanism from a different kata is the point — arms A,
// B and C all answer a question the statement never asks ("which set does this
// cell belong to?") and derive the answer from it; this arm answers the
// question that was asked, using code whose shape has already been verified
// somewhere else.
//
// The fill works on a COPY of the grid, because sinking is destructive and the
// next operation needs the real one back.

fn count_islands(grid: ref Vec[i64], m: i64, n: i64) -> i64 {
    let mut work: Vec[i64] = Vec.new();
    for i in 0..grid.len() {
        work.push(grid[i]);
    }
    let mut islands = 0;
    for start in 0..(m * n) {
        if work[start] == 1 {
            islands += 1;
            let mut stack: Vec[i64] = Vec.new();
            stack.push(start);
            work[start] = 0;
            while stack.len() > 0 {
                let cur = stack[stack.len() - 1];
                let _ = stack.pop();
                let r = cur / n;
                let c = cur % n;
                if r > 0 and work[cur - n] == 1 { work[cur - n] = 0; stack.push(cur - n); }
                if r < m - 1 and work[cur + n] == 1 { work[cur + n] = 0; stack.push(cur + n); }
                if c > 0 and work[cur - 1] == 1 { work[cur - 1] = 0; stack.push(cur - 1); }
                if c < n - 1 and work[cur + 1] == 1 { work[cur + 1] = 0; stack.push(cur + 1); }
            }
        }
    }
    return islands;
}

fn num_islands2(m: i64, n: i64, positions: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut grid: Vec[i64] = Vec.new();
    for i in 0..(m * n) {
        grid.push(0);
    }
    let mut out: Vec[i64] = Vec.new();
    for k in 0..positions.len() {
        let r = positions[k][0];
        let c = positions[k][1];
        grid[r * n + c] = 1;
        out.push(count_islands(grid, m, n));
    }
    return out;
}

fn pairs_of(flat: Slice[i64]) -> Vec[Vec[i64]] {
    let mut ps: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    while i + 1 < flat.len() {
        let mut p: Vec[i64] = Vec.new();
        p.push(flat[i]);
        p.push(flat[i + 1]);
        ps.push(p);
        i = i + 2;
    }
    return ps;
}

fn report(m: i64, n: i64, flat: Slice[i64]) {
    let positions = pairs_of(flat);
    let counts = num_islands2(m, n, positions);
    let mut line = String.new();
    line.push_str(f"{m}x{n} ->");
    for k in 0..counts.len() {
        line.push_str(f" {counts[k]}");
    }
    println(line);
}

fn main() {
    // The example from the LeetCode statement.
    report(3, 3, [0, 0,  0, 1,  1, 2,  2, 1]);
    // A repeated position must not change the answer.
    report(3, 3, [0, 0,  0, 0,  0, 1,  0, 1]);
    // One cell.
    report(1, 1, [0, 0]);
    // A row filled left to right, then the gap that joins two runs.
    report(1, 5, [0, 0,  0, 2,  0, 4,  0, 1,  0, 3]);
    // A column, same shape rotated.
    report(5, 1, [0, 0,  2, 0,  4, 0,  1, 0,  3, 0]);
    // The centre of a plus closes four islands at once.
    report(3, 3, [0, 1,  1, 0,  1, 2,  2, 1,  1, 1]);
    // Fill a 2x3 grid completely — must end at exactly one island.
    report(2, 3, [0, 0,  1, 1,  0, 2,  1, 0,  0, 1,  1, 2]);
    // A ring around a hole never closes into one until the last cell.
    report(3, 3, [0, 0,  0, 1,  0, 2,  1, 2,  2, 2,  2, 1,  2, 0,  1, 0]);
}
