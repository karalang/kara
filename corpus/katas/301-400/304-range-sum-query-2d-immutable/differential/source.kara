// LeetCode 304 — four arms against each other and against seven properties
// that follow from the STATEMENT rather than from any implementation.
//
//   A  2D prefix, nested Vec[Vec[i64]]  — O(1) query by inclusion-exclusion
//   B  2D prefix, flat Vec[i64]+stride  — same arithmetic, different memory
//   C  per-row 1D prefixes              — O(h) query, adds disjoint pieces
//   D  brute force                      — the definition transcribed
//
// THE QUERY SPACE IS EXHAUSTED, NOT SAMPLED. An h x w matrix admits exactly
// (h(h+1)/2) * (w(w+1)/2) rectangles, and every one of them is asked of every
// arm. For the 8x8 matrices here that is 1,296 rectangles apiece. Boundary
// rectangles — those touching row 0 or column 0, where the prefix table's zero
// border does the work, and the 1x1 rectangles where every term collapses —
// are exactly where a random generator under-samples and where the off-by-ones
// live.
//
// WHAT THE ARMS CANNOT SHARE. A and B share their mathematics and differ only
// in layout, so a disagreement between THEM is a fault in a memory access
// path, not in the algorithm. C shares nothing with either: it adds disjoint
// row-slices where they subtract overlapping origin-rectangles, so the
// four-term sign juggling that A and B could get wrong IN AGREEMENT has no
// counterpart in C at all. D answers the question the statement actually asks.
// Between them, no single mistake can hide in three-way agreement.
//
// P5 IS THE ONE NO ARM COMPUTES. Adding a constant k to every cell must raise
// every answer by exactly k * area — a statement about how the structure
// responds to a perturbation of its input rather than about any single answer.
// It catches a whole-matrix fault that is symmetric across the arms, which is
// the failure mode arm agreement is blind to.
//
// A PROPERTY THAT IS DELIBERATELY ABSENT. The obvious eighth property is
// split additivity: cutting a rectangle along a row or column and summing the
// halves should reproduce the whole. It is NOT here, because for every
// prefix-based arm it is unfalsifiable. Splitting arm A at row mid gives
//
//   top = P[mid+1][c2+1] - P[r1  ][c2+1] - P[mid+1][c1] + P[r1  ][c1]
//   bot = P[r2 +1][c2+1] - P[mid+1][c2+1] - P[r2 +1][c1] + P[mid+1][c1]
//
// and every P[mid+1][*] term cancels against its twin, leaving exactly the
// unsplit query REGARDLESS OF WHAT P CONTAINS. The same cancellation holds for
// B (identical algebra) and for C (splitting a loop range). A property that
// holds for an arbitrarily corrupt table is not a test of that table; it is a
// test that subtraction is associative. Measured, not assumed — see the
// README's mutation table, where a build deliberately broken to drop its
// overlap term leaves split additivity at zero violations while P2, P3, P4,
// P6 and P7 all fire. This is the same trap #303 found one dimension down,
// and it does not weaken with the extra dimension: it gets worse, because in
// 2D the property LOOKS like it is testing the inclusion-exclusion structure.

// -------------------------------------------------------------------- arm A

struct NumMatrix { pre: Vec[Vec[i64]] }

fn new_num_matrix(m: ref Vec[Vec[i64]]) -> NumMatrix {
    let h = m.len();
    let mut w = 0;
    if h > 0 { w = m[0].len(); }
    let mut pre: Vec[Vec[i64]] = Vec.new();
    let mut r = 0;
    while r <= h {
        let mut row: Vec[i64] = Vec.new();
        let mut c = 0;
        while c <= w { row.push(0); c = c + 1; }
        pre.push(row);
        r = r + 1;
    }
    r = 0;
    while r < h {
        let mut c = 0;
        while c < w {
            pre[r + 1][c + 1] = pre[r][c + 1] + pre[r + 1][c] - pre[r][c] + m[r][c];
            c = c + 1;
        }
        r = r + 1;
    }
    return NumMatrix { pre: pre };
}

impl NumMatrix {
    fn sum_region(ref self, r1: i64, c1: i64, r2: i64, c2: i64) -> i64 {
        return self.pre[r2 + 1][c2 + 1]
             - self.pre[r1][c2 + 1]
             - self.pre[r2 + 1][c1]
             + self.pre[r1][c1];
    }
}

// -------------------------------------------------------------------- arm B

struct FlatMatrix { pre: Vec[i64], stride: i64 }

fn new_flat_matrix(m: ref Vec[Vec[i64]]) -> FlatMatrix {
    let h = m.len();
    let mut w = 0;
    if h > 0 { w = m[0].len(); }
    let stride = w + 1;
    let mut pre: Vec[i64] = Vec.new();
    let cells = (h + 1) * stride;
    let mut i = 0;
    while i < cells { pre.push(0); i = i + 1; }
    let mut r = 0;
    while r < h {
        let mut c = 0;
        while c < w {
            pre[(r + 1) * stride + (c + 1)] = pre[r * stride + (c + 1)]
                                            + pre[(r + 1) * stride + c]
                                            - pre[r * stride + c]
                                            + m[r][c];
            c = c + 1;
        }
        r = r + 1;
    }
    return FlatMatrix { pre: pre, stride: stride };
}

impl FlatMatrix {
    fn sum_region(ref self, r1: i64, c1: i64, r2: i64, c2: i64) -> i64 {
        let s = self.stride;
        return self.pre[(r2 + 1) * s + (c2 + 1)]
             - self.pre[r1 * s + (c2 + 1)]
             - self.pre[(r2 + 1) * s + c1]
             + self.pre[r1 * s + c1];
    }
}

// -------------------------------------------------------------------- arm C

struct RowMatrix { rowpre: Vec[Vec[i64]] }

fn new_row_matrix(m: ref Vec[Vec[i64]]) -> RowMatrix {
    let mut rowpre: Vec[Vec[i64]] = Vec.new();
    let mut r = 0;
    while r < m.len() {
        let mut p: Vec[i64] = Vec.new();
        p.push(0);
        let mut c = 0;
        while c < m[r].len() { p.push(p[c] + m[r][c]); c = c + 1; }
        rowpre.push(p);
        r = r + 1;
    }
    return RowMatrix { rowpre: rowpre };
}

impl RowMatrix {
    fn sum_region(ref self, r1: i64, c1: i64, r2: i64, c2: i64) -> i64 {
        let mut total = 0;
        let mut r = r1;
        while r <= r2 {
            total = total + self.rowpre[r][c2 + 1] - self.rowpre[r][c1];
            r = r + 1;
        }
        return total;
    }
}

// -------------------------------------------------------------------- arm D

struct BruteMatrix { m: Vec[Vec[i64]] }

fn new_brute_matrix(src: ref Vec[Vec[i64]]) -> BruteMatrix {
    let mut m: Vec[Vec[i64]] = Vec.new();
    let mut r = 0;
    while r < src.len() {
        let mut row: Vec[i64] = Vec.new();
        let mut c = 0;
        while c < src[r].len() { row.push(src[r][c]); c = c + 1; }
        m.push(row);
        r = r + 1;
    }
    return BruteMatrix { m: m };
}

impl BruteMatrix {
    fn sum_region(ref self, r1: i64, c1: i64, r2: i64, c2: i64) -> i64 {
        let mut total = 0;
        let mut r = r1;
        while r <= r2 {
            let mut c = c1;
            while c <= c2 { total = total + self.m[r][c]; c = c + 1; }
            r = r + 1;
        }
        return total;
    }
}

// ------------------------------------------------------------------ helpers

fn make_matrix(h: i64, w: i64, seed: i64, lo: i64, span: i64) -> Vec[Vec[i64]] {
    let mut state = seed;
    let mut m: Vec[Vec[i64]] = Vec.new();
    let mut r = 0;
    while r < h {
        let mut row: Vec[i64] = Vec.new();
        let mut c = 0;
        while c < w {
            state = (state * 1103515245 + 12345) % 2147483648;
            row.push(lo + state % span);
            c = c + 1;
        }
        m.push(row);
        r = r + 1;
    }
    return m;
}

fn shift_matrix(m: ref Vec[Vec[i64]], k: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut r = 0;
    while r < m.len() {
        let mut row: Vec[i64] = Vec.new();
        let mut c = 0;
        while c < m[r].len() { row.push(m[r][c] + k); c = c + 1; }
        out.push(row);
        r = r + 1;
    }
    return out;
}

// Sum of every cell OUTSIDE the given rectangle, walked directly.
fn sum_outside(m: ref Vec[Vec[i64]], r1: i64, c1: i64, r2: i64, c2: i64) -> i64 {
    let mut total = 0;
    let mut r = 0;
    while r < m.len() {
        let mut c = 0;
        while c < m[r].len() {
            if r < r1 or r > r2 or c < c1 or c > c2 { total = total + m[r][c]; }
            c = c + 1;
        }
        r = r + 1;
    }
    return total;
}

fn total_of(m: ref Vec[Vec[i64]]) -> i64 {
    let mut total = 0;
    let mut r = 0;
    while r < m.len() {
        let mut c = 0;
        while c < m[r].len() { total = total + m[r][c]; c = c + 1; }
        r = r + 1;
    }
    return total;
}

fn main() {
    let mut matrices = 0;
    let mut queries = 0;
    let mut p1 = 0;
    let mut p2 = 0;
    let mut p3 = 0;
    let mut p4 = 0;
    let mut p5 = 0;
    let mut p6 = 0;
    let mut p7 = 0;

    // ---- P1..P6 over every shape up to 7x7, every value-seed, EVERY rectangle.
    let mut h = 1;
    while h <= 8 {
        let mut w = 1;
        while w <= 8 {
            let mut round = 0;
            while round < 30 {
                let seed = 7919 * (h * 61 + w) + round * 104729 + 1;
                // Values straddle zero: sign errors are invisible on all-positive data.
                let m = make_matrix(h, w, seed, 0 - 10, 21);

                let a = new_num_matrix(m);
                let b = new_flat_matrix(m);
                let c = new_row_matrix(m);
                let d = new_brute_matrix(m);

                let k = 1 + round % 5;
                let shifted = shift_matrix(m, k);
                let a2 = new_num_matrix(shifted);

                let grand = total_of(m);

                let mut r1 = 0;
                while r1 < h {
                    let mut r2 = r1;
                    while r2 < h {
                        let mut c1 = 0;
                        while c1 < w {
                            let mut c2 = c1;
                            while c2 < w {
                                queries = queries + 1;
                                let va = a.sum_region(r1, c1, r2, c2);

                                // P1 — four arms, one answer.
                                if b.sum_region(r1, c1, r2, c2) != va { p1 = p1 + 1; }
                                if c.sum_region(r1, c1, r2, c2) != va { p1 = p1 + 1; }
                                if d.sum_region(r1, c1, r2, c2) != va { p1 = p1 + 1; }

                                // P2 — a 1x1 rectangle is the cell itself.
                                if r1 == r2 and c1 == c2 {
                                    if va != m[r1][c1] { p2 = p2 + 1; }
                                }

                                // P3 — the whole matrix is the grand total.
                                if r1 == 0 and c1 == 0 and r2 == h - 1 and c2 == w - 1 {
                                    if va != grand { p3 = p3 + 1; }
                                }

                                // P4 — a one-row rectangle is that row's slice.
                                if r1 == r2 {
                                    let mut slice = 0;
                                    let mut cc = c1;
                                    while cc <= c2 { slice = slice + m[r1][cc]; cc = cc + 1; }
                                    if va != slice { p4 = p4 + 1; }
                                }

                                // P5 — shifting every cell by k lifts every answer by k*area.
                                let area = (r2 - r1 + 1) * (c2 - c1 + 1);
                                if a2.sum_region(r1, c1, r2, c2) - va != k * area { p5 = p5 + 1; }

                                // P6 — inside and outside partition the matrix.
                                if va + sum_outside(m, r1, c1, r2, c2) != grand { p6 = p6 + 1; }

                                c2 = c2 + 1;
                            }
                            c1 = c1 + 1;
                        }
                        r2 = r2 + 1;
                    }
                    r1 = r1 + 1;
                }

                matrices = matrices + 1;
                round = round + 1;
            }
            w = w + 1;
        }
        h = h + 1;
    }

    // ---- P7 — shapes whose every answer the statement fixes outright.
    let mut hh = 1;
    while hh <= 8 {
        let mut ww = 1;
        while ww <= 8 {
            let mut zeros: Vec[Vec[i64]] = Vec.new();
            let mut ones: Vec[Vec[i64]] = Vec.new();
            let mut colidx: Vec[Vec[i64]] = Vec.new();
            let mut r = 0;
            while r < hh {
                let mut z: Vec[i64] = Vec.new();
                let mut o: Vec[i64] = Vec.new();
                let mut ci: Vec[i64] = Vec.new();
                let mut c = 0;
                while c < ww { z.push(0); o.push(1); ci.push(c); c = c + 1; }
                zeros.push(z);
                ones.push(o);
                colidx.push(ci);
                r = r + 1;
            }
            let az = new_num_matrix(zeros);
            let ao = new_num_matrix(ones);
            let ac = new_num_matrix(colidx);
            let bo = new_flat_matrix(ones);
            let co = new_row_matrix(ones);

            let mut r1 = 0;
            while r1 < hh {
                let mut r2 = r1;
                while r2 < hh {
                    let mut c1 = 0;
                    while c1 < ww {
                        let mut c2 = c1;
                        while c2 < ww {
                            let rows = r2 - r1 + 1;
                            let cols = c2 - c1 + 1;
                            // all zeros -> 0
                            if az.sum_region(r1, c1, r2, c2) != 0 { p7 = p7 + 1; }
                            // all ones -> the area, on every arm
                            if ao.sum_region(r1, c1, r2, c2) != rows * cols { p7 = p7 + 1; }
                            if bo.sum_region(r1, c1, r2, c2) != rows * cols { p7 = p7 + 1; }
                            if co.sum_region(r1, c1, r2, c2) != rows * cols { p7 = p7 + 1; }
                            // cell = column index -> rows * sum(c1..c2), closed form
                            let colsum = (c1 + c2) * cols / 2;
                            if ac.sum_region(r1, c1, r2, c2) != rows * colsum { p7 = p7 + 1; }
                            c2 = c2 + 1;
                        }
                        c1 = c1 + 1;
                    }
                    r2 = r2 + 1;
                }
                r1 = r1 + 1;
            }
            ww = ww + 1;
        }
        hh = hh + 1;
    }

    println(f"matrices {matrices}");
    println(f"queries {queries}");
    println(f"P1 arm disagreements {p1}");
    println(f"P2 single-cell failures {p2}");
    println(f"P3 whole-matrix failures {p3}");
    println(f"P4 row-strip failures {p4}");
    println(f"P5 shift-response failures {p5}");
    println(f"P6 complement failures {p6}");
    println(f"P7 fixed-shape failures {p7}");

    if p1 == 0 and p2 == 0 and p3 == 0 and p4 == 0 and p5 == 0 and p6 == 0 and p7 == 0 {
        println("DIFFERENTIAL OK");
    } else {
        println("DIFFERENTIAL FAILED");
    }
}
