// Benchmark lane for LeetCode #303 — the O(1) prefix-sum query.
//
// SHAPE. Build a 65,536-element array, its prefix table, and 100,000 query
// pairs once; then punch 60 passes over the query list (BENCHMARKS.md
// § build-once + punch). 360,000,000 queries in total, and the build is amortised
// to nothing — which is the honest way to bench this problem, because the
// immutable variant exists precisely so that the build stops mattering.
//
// WHAT THIS MEASURES. One query is two indexed loads from a `Vec[i64]` field
// reached through `ref self`, one subtraction, and one accumulate. That is a
// deliberately tiny body: the point is to time the BORROW-AND-INDEX path rather
// than any arithmetic. Every call re-borrows the same immutable field and
// returns a scalar, which is exactly the read-only non-escaping borrow karac's
// RC-elision hint targets, so this lane is the corpus's most direct measurement
// of that path.
//
// THE SINK IS AN `AND`, AND THAT IS A CORRECTION. The first version of this
// lane folded each answer into a running total mod 1e9+7, which is what the
// other katas here do. It made every compiled language tie: clang 728.6 ms,
// karac 728.9 ms, rustc 748.2 ms, all inside noise. That tie was an artefact of
// the SINK, not a fact about the query. Two 64-bit integer divisions per query
// are a fixed hardware cost no backend can optimise, and they were roughly 75%
// of the runtime — so the lane was mostly timing `idiv` and reporting it as a
// range-sum benchmark. Swapping the modulo for a mask, changing nothing else,
// drops clang to 177.0 ms and karac to 274.5 ms and reveals the real 1.55x
// spread the modulo had been hiding.
//
// This is BENCHMARKS.md's "the optimizer erases the work you meant to measure"
// hazard wearing a different coat: nothing was erased, the sink simply cost
// more than the subject. The mask keeps a genuine loop-carried dependency (so
// nothing is hoisted or vectorised away) at one cycle instead of forty.
//
// WHY THE ARRAY IS 65,536 AND NOT LARGER. At 8 bytes per entry the prefix table
// is 512 KiB, which sits in L2 on the container this was measured on. Growing it
// past L3 would turn all five mirrors into a memory-latency benchmark and stop
// measuring the query at all — the mistake #296's lane documents having ruled
// out by experiment rather than assumption. The queries are precomputed for the
// same reason: generating (l, r) inside the timed loop would measure an LCG.

struct NumArray {
    prefix: Vec[i64],
}

fn new_num_array(nums: ref Vec[i64]) -> NumArray {
    let mut prefix: Vec[i64] = Vec.new();
    prefix.push(0);
    let mut i = 0;
    while i < nums.len() {
        prefix.push(prefix[i] + nums[i]);
        i = i + 1;
    }
    return NumArray { prefix: prefix };
}

impl NumArray {
    fn sum_range(ref self, left: i64, right: i64) -> i64 {
        return self.prefix[right + 1] - self.prefix[left];
    }
}

fn main() {
    let n = 65536;
    let nqueries = 200000;
    let passes = 1800;

    // Build once — the array.
    let mut state = 20303;
    let mut nums: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        state = (state * 1103515245 + 12345) & 0x7fffffff;
        nums.push((state / 65536) % 2001 - 1000);
        i = i + 1;
    }
    let na = new_num_array(nums);

    // Build once — the query list, as a flat [l0, r0, l1, r1, ...].
    let mut qs: Vec[i64] = Vec.new();
    let mut q = 0;
    while q < nqueries {
        state = (state * 1103515245 + 12345) & 0x7fffffff;
        let x = (state / 65536) % n;
        state = (state * 1103515245 + 12345) & 0x7fffffff;
        let y = (state / 65536) % n;
        if x <= y { qs.push(x); qs.push(y); } else { qs.push(y); qs.push(x); }
        q = q + 1;
    }

    // Punch.
    let mut checksum = 0;
    let mut p = 0;
    while p < passes {
        let mut k = 0;
        while k < nqueries {
            let v = na.sum_range(qs[k * 2], qs[k * 2 + 1]);
            checksum = (checksum + v) & 0x3FFFFFFF;
            k = k + 1;
        }
        p = p + 1;
    }

    println(f"checksum {checksum}");
}
