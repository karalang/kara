// LeetCode #348 -- Design Tic-Tac-Toe.
//
// An n x n board; `make_move(row, col, player)` places player 1's or player
// 2's mark on an empty cell and returns the player who has just won, or 0.
// A win is n marks of one player in a row, a column, or either diagonal.
//
// One counter per row, per column and per diagonal. Player 1 adds 1 and
// player 2 subtracts 1, so a line is won exactly when its counter reaches
// n or -n: a line holding both players' marks can never get there. Each
// move touches at most four counters, O(1), and the board itself is never
// stored.

struct TicTacToe {
    n: i64,
    rows: Vec[i64],
    cols: Vec[i64],
    diag: i64,
    anti: i64,
}

impl TicTacToe {
    fn new(n: i64) -> TicTacToe {
        let mut rows: Vec[i64] = Vec.new();
        let mut cols: Vec[i64] = Vec.new();
        for _ in 0..n {
            rows.push(0);
            cols.push(0);
        }
        return TicTacToe { n: n, rows: rows, cols: cols, diag: 0, anti: 0 };
    }

    fn make_move(mut ref self, row: i64, col: i64, player: i64) -> i64 {
        let d = if player == 1 { 1 } else { -1 };
        self.rows[row] += d;
        self.cols[col] += d;
        if row == col {
            self.diag += d;
        }
        if row + col == self.n - 1 {
            self.anti += d;
        }
        let goal = d * self.n;
        if self.rows[row] == goal or self.cols[col] == goal or self.diag == goal or self.anti == goal {
            return player;
        }
        return 0;
    }
}

// Plays `moves` in order, alternating players from player 1, and returns
// what every move returned, stopping after the first win.
fn play(n: i64, moves: ref Vec[(i64, i64)]) -> Vec[i64] {
    let mut game = TicTacToe.new(n);
    let mut out: Vec[i64] = Vec.new();
    let mut player = 1;
    for (r, c) in moves {
        let w = game.make_move(r, c, player);
        out.push(w);
        if w != 0 {
            break;
        }
        player = 3 - player;
    }
    return out;
}

// Every cell of an n x n board in a pseudo-random order.
fn shuffled_cells(n: i64, seed: i64) -> Vec[(i64, i64)] {
    let mut cells: Vec[(i64, i64)] = Vec.new();
    for r in 0..n {
        for c in 0..n {
            cells.push((r, c));
        }
    }
    let mut x = seed;
    let mut k = cells.len() - 1;
    while k > 0 {
        x = (x * 1103515245 + 12345) % 2147483648;
        let j = x / 16 % (k + 1);
        let t = cells[k];
        cells[k] = cells[j];
        cells[j] = t;
        k -= 1;
    }
    return cells;
}

fn show(label: String, results: ref Vec[i64]) {
    println(f"{label}: {results}");
}

fn main() {
    // The problem's example: player 1 completes the bottom row on move 7.
    show("example", play(3, [(0, 0), (0, 2), (2, 2), (1, 1), (2, 0), (1, 0), (2, 1)]));
    // A 1 x 1 board is won by the first mark.
    show("one cell", play(1, [(0, 0)]));
    // Player 2 takes the middle column.
    show("column", play(3, [(0, 0), (0, 1), (2, 2), (1, 1), (1, 0), (2, 1)]));
    // Player 1 takes the anti-diagonal on a 4 x 4 board.
    show("anti-diagonal", play(4, [(0, 3), (0, 0), (1, 2), (0, 1), (2, 1), (1, 1), (3, 0)]));
    // A full 3 x 3 board with nobody winning.
    show("draw", play(3, [(0, 0), (1, 1), (2, 2), (0, 1), (2, 1), (2, 0), (0, 2), (1, 2), (1, 0)]));

    // Random games: every cell of an n x n board in a shuffled order, until
    // somebody wins or the board is full.
    let mut games = 0;
    let mut wins1 = 0;
    let mut wins2 = 0;
    let mut total_moves = 0;
    for n in 1..41 {
        for g in 0..25 {
            let result = play(n, shuffled_cells(n, n * 1000 + g));
            games += 1;
            total_moves += result.len();
            let last = result[result.len() - 1];
            if last == 1 {
                wins1 += 1;
            } else if last == 2 {
                wins2 += 1;
            }
        }
    }
    println(f"{games} random games: player 1 won {wins1}, player 2 won {wins2}, {total_moves} moves");
}
