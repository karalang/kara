// LeetCode #399: Evaluate Division -- union-find with weights.
//
// Give every variable an index. Each one keeps a parent and the ratio
// weight[i] = i / parent[i], so following parents to the root multiplies
// out to i / root. An equation a / b = v joins the two roots: with
// a = wa * ra and b = wb * rb, ra / rb = v * wb / wa. A query a / b has an
// answer when both share a root, and it is wa / wb. Path compression
// keeps the walks short. O((E + Q) α(n)) time, O(n) space.

fn find(parent: mut ref Vec[i64], weight: mut ref Vec[f64], i: i64) -> i64 {
    let p = parent[i];
    if p == i {
        return i;
    }
    let root = find(mut parent, mut weight, p);
    weight[i] = weight[i] * weight[p];
    parent[i] = root;
    root
}

// The index of `name`, given a new one (its own root, ratio 1) when unseen.
fn intern(index: mut ref Map[String, i64], parent: mut ref Vec[i64], weight: mut ref Vec[f64], name: String) -> i64 {
    if let Some(i) = index.get(name) {
        return *i;
    }
    let i = parent.len();
    index.insert(name.clone(), i);
    parent.push(i);
    weight.push(1.0);
    i
}

fn calc_equation(equations: Vec[(String, String)], values: Vec[f64], queries: Vec[(String, String)]) -> Vec[f64] {
    let mut index: Map[String, i64] = Map.new();
    let mut parent: Vec[i64] = Vec.new();
    let mut weight: Vec[f64] = Vec.new();
    for k in 0..equations.len() {
        let a = intern(mut index, mut parent, mut weight, equations[k].0);
        let b = intern(mut index, mut parent, mut weight, equations[k].1);
        let ra = find(mut parent, mut weight, a);
        let rb = find(mut parent, mut weight, b);
        if ra != rb {
            weight[ra] = values[k] * weight[b] / weight[a];
            parent[ra] = rb;
        }
    }
    let mut answers: Vec[f64] = Vec.new();
    for (a, b) in queries.iter() {
        let mut answer = -1.0;
        if let Some(i) = index.get(a) {
            if let Some(j) = index.get(b) {
                let (i, j) = (*i, *j);
                if find(mut parent, mut weight, i) == find(mut parent, mut weight, j) {
                    answer = weight[i] / weight[j];
                }
            }
        }
        answers.push(answer);
    }
    answers
}

// ---- test harness ---------------------------------------------------------

fn step(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn pairs(names: Vec[String]) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    let mut i = 0;
    while i + 1 < names.len() {
        out.push((names[i].clone(), names[i + 1].clone()));
        i += 2;
    }
    out
}

fn show(equations: Vec[String], values: Vec[f64], queries: Vec[String]) {
    let answers = calc_equation(pairs(equations), values, pairs(queries));
    let mut text = String.from("[");
    for i in 0..answers.len() {
        if i > 0 {
            text.push_str(", ");
        }
        text.push_str(f"{answers[i]:.5}");
    }
    text.push(']');
    println(text);
}

fn pow2(k: i64) -> f64 {
    let mut x = 1.0;
    for _ in 0..k.abs() {
        x = x * 2.0;
    }
    if k < 0 { 1.0 / x } else { x }
}

// The exponent k of an answer that is exactly 2^k.
fn exponent(x: f64) -> i64 {
    let mut v = x;
    let mut k = 0;
    while v >= 2.0 {
        v = v / 2.0;
        k += 1;
    }
    while v < 1.0 {
        v = v * 2.0;
        k -= 1;
    }
    k
}

fn main() {
    show(vec!["a", "b", "b", "c"], vec![2.0, 3.0], vec!["a", "c", "b", "a", "a", "e", "a", "a", "x", "x"]);
    show(vec!["a", "b", "b", "c", "bc", "cd"], vec![1.5, 2.5, 5.0], vec!["a", "c", "c", "b", "bc", "cd", "cd", "bc"]);
    show(vec!["a", "b"], vec![0.5], vec!["a", "b", "b", "a", "a", "c", "x", "y"]);
    show(vec!["a", "b", "c", "d"], vec![2.0, 4.0], vec!["a", "d", "d", "c", "b", "a", "c", "c"]);
    show(vec!["a", "b", "b", "c", "a", "c"], vec![2.0, 2.0, 4.0], vec!["a", "c", "c", "a", "b", "b"]);
    let mut chain: Vec[String] = Vec.new();
    for i in 0..9 {
        chain.push(f"x{i}");
        chain.push(f"x{i + 1}");
    }
    show(chain, vec![2.0; 9], vec!["x0", "x9", "x9", "x0", "x3", "x7", "x5", "x5"]);
    // 300 random systems over 2 to 12 variables, each holding a hidden
    // power of two, so that every answer is exactly 2^k on every backend.
    let mut seed: i64 = 399;
    let mut answered = 0;
    let mut unknown = 0;
    let mut checksum: i64 = 0;
    for _ in 0..300 {
        let m = 2 + step(mut seed) % 11;
        let mut hidden: Vec[i64] = Vec.new();
        for _ in 0..m {
            hidden.push(step(mut seed) % 9 - 4);
        }
        let count = 1 + step(mut seed) % 15;
        let mut equations: Vec[(String, String)] = Vec.new();
        let mut values: Vec[f64] = Vec.new();
        for _ in 0..count {
            let a = step(mut seed) % m;
            let b = step(mut seed) % m;
            equations.push((f"v{a}", f"v{b}"));
            values.push(pow2(hidden[a] - hidden[b]));
        }
        let mut queries: Vec[(String, String)] = Vec.new();
        for _ in 0..10 {
            let a = step(mut seed) % (m + 2);
            let b = step(mut seed) % (m + 2);
            queries.push((f"v{a}", f"v{b}"));
        }
        for x in calc_equation(equations, values, queries) {
            if x < 0.0 {
                unknown += 1;
                checksum = (checksum * 31 + 1) % 1000000007;
            } else {
                answered += 1;
                checksum = (checksum * 31 + exponent(x) + 50) % 1000000007;
            }
        }
    }
    println(f"300 random systems: {answered} answered, {unknown} unknown, checksum {checksum}");
}
