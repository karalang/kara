// LeetCode #353: Design Snake Game -- a VecDeque of body cells plus a Set of
// the cells it covers.
//
// The snake starts at the top-left cell with length 1. Each move puts a new
// head one cell over. If the head lands on the current food, the snake eats it
// and grows (the tail stays); otherwise the tail moves first, so the head may
// enter the cell the tail is leaving. A head off the board or on the body ends
// the game, and the move returns -1; otherwise it returns the score so far.
//
// Cells are encoded as `row * width + col`. The deque holds them head-last; the
// set answers "is this cell body?" in O(1).

struct SnakeGame {
    width: i64,
    height: i64,
    food: Vec[(i64, i64)],
    next_food: i64,
    body: VecDeque[i64],
    covered: Set[i64],
}

impl SnakeGame {
    fn new(width: i64, height: i64, food: Vec[(i64, i64)]) -> SnakeGame {
        let mut body: VecDeque[i64] = VecDeque.new();
        body.push_back(0);
        let mut covered: Set[i64] = Set.new();
        covered.insert(0);
        SnakeGame { width, height, food, next_food: 0, body, covered }
    }

    fn step(mut ref self, dir: char) -> i64 {
        let head = self.body[self.body.len() - 1];
        let (r, c) = (head / self.width, head % self.width);
        let (nr, nc) = match dir {
            'U' => (r - 1, c),
            'D' => (r + 1, c),
            'L' => (r, c - 1),
            _ => (r, c + 1),
        };
        if nr < 0 or nr >= self.height or nc < 0 or nc >= self.width {
            return -1;
        }
        let cell = nr * self.width + nc;
        let eats = self.next_food < self.food.len() and self.food[self.next_food] == (nr, nc);
        if eats {
            self.next_food += 1;
        } else {
            let tail = self.body.pop_front().unwrap();
            self.covered.remove(tail);
        }
        if self.covered.contains(cell) {
            return -1;
        }
        self.body.push_back(cell);
        self.covered.insert(cell);
        self.next_food
    }
}

// The moves of a Hamiltonian cycle on a board with an even number of rows:
// along the top row, snake down through columns 1.., then back up column 0.
fn cycle_moves(width: i64, height: i64) -> String {
    let mut m = String.new();
    for _ in 0..width - 1 {
        m.push('R');
    }
    for row in 1..height {
        m.push('D');
        let d = if row % 2 == 1 { 'L' } else { 'R' };
        for _ in 0..width - 2 {
            m.push(d);
        }
    }
    m.push('L');
    for _ in 0..height - 1 {
        m.push('U');
    }
    m
}

fn play(label: ref String, width: i64, height: i64, food: Vec[(i64, i64)], moves: ref String) {
    let mut g = SnakeGame.new(width, height, food);
    let mut out = String.new();
    for d in moves.chars() {
        let s = g.step(d);
        out.push_str(f" {s}");
        if s < 0 {
            break;
        }
    }
    println(f"{label}:{out}");
}

fn main() {
    // The LeetCode example.
    play("example", 3, 2, vec![(1, 2), (0, 1)], "RDRULU");
    // Edge cases.
    play("wall", 2, 2, Vec.new(), "U");
    play("tail chase", 2, 2, vec![(0, 1), (1, 1)], "RDLURDLURD");
    play("self bite", 3, 3, vec![(0, 1), (0, 2), (1, 2), (1, 1)], "RRDLU");
    play("no food left", 4, 1, vec![(0, 1)], "RRRLL");
    play("turn back at length 2", 3, 1, vec![(0, 1)], "RL");
    play("turn back at length 3", 3, 1, vec![(0, 1), (0, 2)], "RRL");

    // A long game: a 60 x 40 board, the snake follows a Hamiltonian cycle, and
    // food sits three cells ahead of it until 1000 pieces have been eaten.
    let (w, h) = (60, 40);
    let cycle = cycle_moves(w, h);
    let cells: Vec[char] = cycle.chars().collect();
    let n = cells.len();
    let mut pos: Vec[(i64, i64)] = Vec.new();
    let mut (r, c) = (0, 0);
    for d in cells.iter() {
        match d {
            'U' => { r -= 1; }
            'D' => { r += 1; }
            'L' => { c -= 1; }
            _ => { c += 1; }
        }
        pos.push((r, c));
    }
    let mut food: Vec[(i64, i64)] = Vec.new();
    for i in 0..1000 {
        food.push(pos[(3 * i + 2) % n]);
    }
    let mut g = SnakeGame.new(w, h, food);
    let mut checksum: i64 = 0;
    let total = 3 * n;
    for t in 0..total {
        let s = g.step(cells[t % n]);
        checksum = (checksum * 31 + s + t) % 1000000007;
        if (t + 1) % 1200 == 0 {
            println(f"after {t + 1} moves: score {s}, length {g.body.len()}");
        }
    }
    println(f"bite: {g.step('D')}");
    println(f"long game: {total} moves, checksum {checksum}");
}
