// Benchmark workload for LeetCode #338 — the shift arm (counting_bits.kara),
// timed as written.
//
// ROUNDS solves, round r for n = TOP_N - r, so no two solves are the same. Each
// answer is a fresh Vec. Three of its entries and its length are folded into
// a rolling hash, which is the sink.

const TOP_N: i64 = 1000000;
const ROUNDS: i64 = 300;
const MODULUS: i64 = 1073741789;

fn count_bits(n: i64) -> Vec[i64] {
    let mut ans: Vec[i64] = vec![0; n + 1];
    for i in 1..=n {
        ans[i] = ans[i >> 1] + (i & 1);
    }
    return ans;
}

fn main() {
    let mut sink = 0;
    for r in 0..ROUNDS {
        let n = TOP_N - r;
        let ans = count_bits(n);
        let picked = ans[n] * 10000 + ans[n / 3] * 100 + ans[(n * 7) / 11];
        sink = (sink * 1000003 + picked + ans.len()) % MODULUS;
    }
    println(f"{sink}");
}
