// LeetCode #338: Counting Bits — drop the lowest set bit.
//
// Same spec as `counting_bits.kara`. `i & (i - 1)` is i with its lowest 1 bit
// cleared, which is smaller than i and so already counted; i has one more 1
// bit than it.
//
// O(n) time.

fn count_bits(n: i64) -> Vec[i64] {
    let mut ans: Vec[i64] = vec![0; n + 1];
    for i in 1..=n {
        ans[i] = ans[i & (i - 1)] + 1;
    }
    return ans;
}

fn show(n: i64) {
    let ans = count_bits(n);
    let parts: Vec[String] = ans.iter().map(|c| c.to_string()).collect();
    let shown = parts.join(", ");
    println(f"{n} -> [{shown}]");
}

// Summary of a long answer: its length, its total, its largest entry, and a
// rolling hash of every entry.
fn summary(n: i64) {
    let ans = count_bits(n);
    let mut total = 0;
    let mut most = 0;
    let mut hash = 0;
    for c in ans.iter() {
        total += c;
        most = most.max(c);
        hash = (hash * 31 + c) % 1000000007;
    }
    println(f"{n} -> {ans.len()} counts, total {total}, largest {most}, hash {hash}");
}

fn main() {
    show(2);
    show(5);
    show(0);
    show(1);
    show(16);
    show(31);
    show(33);
    summary(1000);
    summary(65535);
    summary(65536);
    summary(100000);
    summary(1048575);
}
