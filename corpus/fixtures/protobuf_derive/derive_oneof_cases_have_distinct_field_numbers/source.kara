
enum P { NotSet, Num(i64), Text(String) }

#[derive(Message)]
struct E { id: i64, body: P }

fn main() {
    let mut r = ProtoReader.new(E { id: 9, body: P.Text("x") }.encode());
    let mut d = "";
    while not r.at_end() {
        let (f, w) = r.read_tag();
        d = d + f"({f},{w})";
        let _ = r.skip_field(w);
    }
    println(d);
}
