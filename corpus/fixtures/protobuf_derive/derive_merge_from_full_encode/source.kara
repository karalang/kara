
#[derive(Message)]
struct Person { name: String, age: i64, active: bool }

fn main() {
    let mut p = Person { name: "old", age: 1, active: false };
    let fresh = Person { name: "new", age: 2, active: true };
    p.merge(fresh.encode());
    println(p.name);
    println(p.age);
    println(p.active);
}
