fn main() {
    let v: Vec[i32] = [1 as i32, 2 as i32, 3 as i32, 4 as i32, 5 as i32];
    let p = gpu.prefix_sum(v);
    println(f"{p[0]} {p[1]} {p[2]} {p[3]} {p[4]}");
    let n: Vec[i32] = [5 as i32, -3 as i32, 2 as i32];
    let q = gpu.prefix_sum(n);
    println(f"{q[0]} {q[1]} {q[2]}");
    let u: Vec[u32] = [10u32, 20u32, 30u32];
    let r = gpu.prefix_sum(u);
    println(f"{r[0]} {r[1]} {r[2]}");
    let e: Vec[i32] = [];
    println(f"{gpu.prefix_sum(e).len()}");
}
