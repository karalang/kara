fn main() {
    let a: Vec[i32] = [1 as i32, 2 as i32, 3 as i32, 4 as i32];
    let b: Vec[i32] = [5 as i32, 6 as i32, 7 as i32, 8 as i32];
    println(f"{gpu.dot(a, b)}");
    let n: Vec[i32] = [-1 as i32, 2 as i32];
    let m: Vec[i32] = [3 as i32, -4 as i32];
    println(f"{gpu.dot(n, m)}");
    let u: Vec[u32] = [2u32, 3u32];
    let w: Vec[u32] = [10u32, 100u32];
    println(f"{gpu.dot(u, w)}");
    let e: Vec[i32] = [];
    let f: Vec[i32] = [];
    println(f"{gpu.dot(e, f)}");
}
