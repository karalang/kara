    let b: Tensor[i32, [?, ?]] = Tensor.from([[-6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0], [-1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5], [4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3], [-4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2], [1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6], [6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1], [-2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4], [3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4], [-5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1], [0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6], [5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2], [-3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3], [2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5], [-6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0], [-1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5], [4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2, 4, 6, -5, -3], [-4, -2, 0, 2, 4, 6, -5, -3, -1, 1, 3, 5, -6, -4, -2, 0, 2]]);
