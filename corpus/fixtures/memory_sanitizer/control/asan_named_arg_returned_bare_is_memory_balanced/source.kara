
struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"drop {self.name}"); } }
struct T3 { n: i64 }
struct Hx { r: R }
impl T3 {
    fn take(ref self, ra: own R) -> R { return ra; }
    fn keep(ref self, rb: own R) -> R { rb }
    fn wrap(ref self, rc: own R) -> Hx { return Hx { r: rc }; }
    fn eat(ref self, rd: R) -> i64 { println(f"saw {rd.name}"); return 0; }
}
fn takef(re: own R) -> R { return re; }
fn keepf(rf: own R) -> R { rf }
fn main() {
    let base: i64 = env.args().len();
    let t = T3 { n: 1 };
    let a1 = R { id: base, name: f"a{base}" };
    let a = t.take(a1);
    println(f"{a.id}");
    let b1 = R { id: base, name: f"b{base}" };
    let b = t.keep(b1);
    println(f"{b.id}");
    let c1 = R { id: base, name: f"c{base}" };
    let c = t.wrap(c1);
    println(f"{c.r.id}");
    let d1 = R { id: base, name: f"d{base}" };
    let d = t.eat(d1);
    println(f"{d}");
    let e1 = R { id: base, name: f"e{base}" };
    let e = takef(e1);
    println(f"{e.id}");
    let g1 = R { id: base, name: f"g{base}" };
    let g = keepf(g1);
    println(f"{g.id}");
    println("end");
}
