
fn main() {
    let mut round: i64 = 0;
    while round < 30 {
        let mut v: Vec[String] = Vec[
            "b05-multi-alpha-aaaaaaaaaaaaaaaaaaaaaaaaaa".to_string(),
            "b05-multi-bravo-bbbbbbbbbbbbbbbbbbbbbbbbbb".to_string(),
            "b05-multi-charlie-cccccccccccccccccccccccc".to_string()
        ];
        let r: Vec[(i64, String)] = v.iter().cloned().enumerate().filter(|p| p.0 >= 0).filter(|q| q.0 < 5).collect();
        println(f"{r.len()} {r[2].0} {v.len()}");
        round = round + 1;
    }
}
