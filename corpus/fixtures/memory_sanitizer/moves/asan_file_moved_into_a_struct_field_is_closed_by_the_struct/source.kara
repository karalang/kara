
struct Holder {{ f: File }}
fn main() with reads(FileSystem) {{
    let mut i: i64 = 0i64;
    let mut n: i64 = 0i64;
    while i < 40i64 {{
        match File.open("{path}") {{
            Ok(fh) => {{ let _h = Holder {{ f: fh }}; n = n + 1i64; }}
            Err(_) => {{ n = n - 1i64; }}
        }}
        i = i + 1;
    }}
    println(n.to_string());
}}
