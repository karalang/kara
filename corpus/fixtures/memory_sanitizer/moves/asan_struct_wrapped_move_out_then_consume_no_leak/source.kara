
shared enum Expr { Num(i64), Add(BinOp), Neg(Unary) }
struct BinOp { left: Expr, right: Expr }
struct Unary { operand: Expr }
fn eval(e: Expr) -> i64 {
    match e {
        Num(n) => n,
        Add(b) => eval(b.left) + eval(b.right),
        Neg(u) => 0 - eval(u.operand),
    }
}
fn main() {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < 40 {
        // move-out then consume
        let t1 = Expr.Add(BinOp { left: Expr.Num(3), right: Expr.Num(4) });
        let t2 = t1;
        total = total + eval(t2);
        // move-out then drop WHOLE (no consume)
        let u1 = Expr.Neg(Unary { operand: Expr.Num(5) });
        let u2 = u1;
        match u2 { Num(n) => { total = total + n; } Add(b) => { total = total + 0; } Neg(x) => { total = total + 0; } }
        // subtree moved into a parent literal, then consumed
        let sub = Expr.Add(BinOp { left: Expr.Num(2), right: Expr.Num(3) });
        let p1 = Expr.Add(BinOp { left: sub, right: Expr.Num(10) });
        total = total + eval(p1);
        i = i + 1;
    }
    println(total);
}
