
struct A { s: String }
fn build() -> Vec[A] {
    let mut v: Vec[A] = Vec.new();
    let mut i = 0;
    while i < 6 { v.push(A { s: "forloop_element_whole_move_payload_theta_xx".to_string() }); i = i + 1; }
    v
}
fn main() {
    let items = build();
    let mut n: i64 = 0;
    for a in items {
        let x = a;
        n = n + x.s.len();
    }
    println(n);
}
