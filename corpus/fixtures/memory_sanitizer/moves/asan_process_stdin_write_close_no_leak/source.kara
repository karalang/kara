
fn main() {
    let mut i: i64 = 0i64;
    let mut total: i64 = 0i64;
    while i < 8i64 {
        let cat = Command.new("cat").stdin(Stdio.piped()).stdout(Stdio.piped());
        match cat.spawn() {
            Ok(child) => {
                match child.stdin() {
                    Some(sin) => {
                        match sin.write_all("pipe-payload\n".bytes()) { Ok(u) => {}, Err(e) => {} }
                        match sin.close() { Ok(u) => {}, Err(e) => {} }
                    }
                    None => {}
                }
                match child.stdout() {
                    Some(o) => {
                        let mut text = String.new();
                        match o.read_to_string(text) {
                            Ok(_) => { total = total + text.len(); }
                            Err(e) => {}
                        }
                    }
                    None => {}
                }
                match child.wait() { Ok(st) => {}, Err(e) => {} }
            }
            Err(e) => {}
        }
        i = i + 1;
    }
    println(total.to_string());
}
