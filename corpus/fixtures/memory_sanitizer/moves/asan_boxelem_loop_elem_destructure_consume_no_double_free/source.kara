
struct Holder { name: String, id: i64 }
fn main() {
    let mut v: Vec[Option[Holder]] = Vec.new();
    let mut i = 0;
    while i < 3 {
        v.push(Some(Holder { name: f"holder payload padded beyond thirty-six bytes {i}", id: i }));
        i = i + 1;
    };
    let mut total = 0;
    for o in v {
        match o {
            Some(Holder { name, id }) => { total = total + (name.len() as i64) + id; },
            None => {},
        }
    }
    println(total);
}
