
struct P { a: String, b: i64 }
fn seed() -> i64 { env.args().len() }
fn payload() -> String { f"payload-{seed()}-aaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
fn go() -> i64 {
    let n = payload();
    if seed() > 99 { P { a: n, b: 1 } } else { P { a: payload(), b: 2 } };
    let b1 = payload();
    let b2 = payload();
    if seed() > 0 { P { a: b1, b: 1 } } else { P { a: b2, b: 2 } };
    let mut r = payload();
    if seed() > 0 { P { a: r, b: 1 } } else { P { a: payload(), b: 2 } };
    r = payload();
    let outer = payload();
    let mut i = 0;
    while i < 5 {
        if seed() > 0 { P { a: outer.clone(), b: 1 } } else { P { a: payload(), b: 2 } };
        i = i + 1;
    }
    return r.len() - r.len() + 1;
}
fn main() { println(go()); }
