
fn main() {
    let mut i: i64 = 0i64;
    let mut hits: i64 = 0i64;
    while i < 40i64 {
        let mut tab: Interner = Interner.new();
        let a = tab.intern("alpha");
        let p = "al";
        let b = tab.intern(p + "pha");
        if a == b {
            hits = hits + 1i64;
        }
        i = i + 1;
    }
    println(hits.to_string());
}
