
fn take(t: (String, i64)) -> i64 {
    t.1
}
fn main() {
    let mut i = 0;
    while i < 3 {
        let mut m: Map[i64, (String, i64)] = Map.new();
        m.insert(i, (f"tuple payload padded beyond thirty-six bytes {i}", i));
        match m.get(i) {
            Some(x) => { println(take(x.clone())); },
            None => { println(0 - 1); },
        }
        i = i + 1;
    };
}
