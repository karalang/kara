
#[derive(Clone)]
struct It { id: i64, name: String }
fn take(x: It) -> i64 { return x.name.len(); }
fn main() {
    let a = It { id: 1, name: f"payload_aaaaaaaaaaaaaaaaaaaaaaaa{1}" };
    let mut t = 0i64;
    let mut i = 0i64;
    while i < 20i64 { t = t + take(a.clone()); i = i + 1i64; }
    println(f"{t}");
}
