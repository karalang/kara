fn mkVec() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(f"aaaaaaaaaaaaaaaaaaaaaaaa-0");
    v.push(f"bbbbbbbbbbbbbbbbbbbbbbbb-1");
    return v;
}
fn ident[T](t: own T) -> T { return t; }
fn stmtD[T](v: Vec[String], c: bool, t: own T) -> T { if c { v[0].clone() } else { v[1].clone() }; return t; }
fn loopD[T](v: Vec[String], t: own T) -> T { for i in 0..2 { if i == 0 { v[0].clone() } else { v[1].clone() } } return t; }
fn blockD[T](v: Vec[String], c: bool, t: own T) -> T { { if c { v[0].clone() } else { v[1].clone() } }; return t; }
fn matchD[T](v: Vec[String], c: i64, t: own T) -> T { match c { 0 => { v[0].clone() } _ => { v[1].clone() } }; return t; }
fn main() {
    println(f"n{stmtD(mkVec(), true, 1)}");
    println(f"n{loopD(mkVec(), 2)}");
    println(f"n{blockD(mkVec(), true, 3)}");
    println(f"n{matchD(mkVec(), 0, 4)}");
    println("end");
}
