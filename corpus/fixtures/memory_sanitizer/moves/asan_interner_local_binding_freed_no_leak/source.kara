
fn main() {
    let mut i: i64 = 0i64;
    let mut total: i64 = 0i64;
    while i < 40i64 {
        let mut tab: Interner = Interner.new();
        let a = tab.intern("alpha");
        let _b = tab.intern("beta");
        let a2 = tab.intern("alpha");
        if a == a2 {
            total = total + tab.resolve(a).len();
        }
        total = total + tab.len();
        i = i + 1;
    }
    println(total.to_string());
}
