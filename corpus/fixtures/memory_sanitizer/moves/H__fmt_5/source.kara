struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"drop {self.id} {self.name}") } }
struct W { r: R, n: i64 }
fn take(r: R) -> i64 { r.id }
             fn main() { let w = W { r: R { id: 41, name: f"n{41}" }, n: 1 };
             let W { r, n } = w; println(f"{take(r) + n}") }
