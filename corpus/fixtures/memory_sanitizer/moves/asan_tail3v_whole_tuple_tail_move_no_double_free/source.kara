
fn take(t: (String, i64)) -> i64 { t.1 }
fn main() {
    let mut i = 0;
    while i < 3 {
        let mut m: Map[i64, (String, i64)] = Map.new();
        m.insert(i, (f"tuple payload padded beyond thirty-six bytes {i}", i));
        let t = match m.get(i) {
            Some(x) => x.clone(),
            None => (f"none-{i}", 0 - 1),
        };
        println(take(t));
        i = i + 1;
    };
}
