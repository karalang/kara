
fn main() {
    let mut round: i64 = 0;
    while round < 30 {
        let mut v: Vec[String] = Vec[
            "b05-diff-alpha-aaaaaaaaaaaaaaaaaaaaaaaaaaaa".to_string(),
            "b05-diff-bravo-bbbbbbbbbbbbbbbbbbbbbbbbbbbb".to_string()
        ];
        let r: Vec[(i64, String)] = v.iter().cloned().enumerate().filter(|p| p.0 >= 0).inspect(|q| print(q.0)).collect();
        println(f"{r.len()} {r[1].0} {v.len()}");
        round = round + 1;
    }
}
