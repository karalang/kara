
struct Box[T] { v: T }

fn sink(b: own Box[String]) -> i64 { b.v.len() }

fn main() {
    let n = env.args().len() as i64;
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 40 {
        let mut s: String = String.new();
        s.push_str("payload-");
        s.push_str(n.to_string());
        s.push_str("-padded-out-to-force-heap");
        let b = Box { v: s };
        acc = acc + sink(b);
        i = i + 1;
    }
    println(acc);
}
