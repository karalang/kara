
struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id} {self.name}") } }
fn mk(i: i64) -> R { return R { id: i, name: f"heap-{i}" }; }
fn main() {
    let n = 1;
    let _ = { match n { 1 => { mk(5) } _ => { mk(0) } } };
    { match n { 1 => { mk(6) } _ => { mk(0) } } };
    let _ = { mk(8) };
    println("dropped");
}
