
fn take_s(s: String) { if s.len() > 99999 { println(s); } }
fn take_v(v: Vec[i64]) { if v.len() > 99999 { println(v.len()); } }
fn two(a: String, b: String) { if a.len() > 99999 { println(a); println(b); } }
fn main() {
    let mut i: i64 = 0;
    while i < 5 {
        take_s({ f"arg{i}-{i}" });
        take_s({ let p = "x" + "y"; p });
        take_v({ Vec[i, i, i] });
        two({ f"p{i}" }, { f"q{i}" });
        take_s(f"direct{i}");
        i = i + 1;
    }
    println("done");
}
