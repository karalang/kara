struct S { s: String }
impl Drop for S { fn drop(mut ref self) { println("drop S"); } }
fn seed() -> i64 { env.args().len() }
fn payload() -> String { f"payload-{seed()}-aaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
fn mkt() -> (S, i64) { return (S { s: payload() }, 7); }
fn take(t: (S, i64)) -> i64 { return 1; }
fn main() { println(go()); }
