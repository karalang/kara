struct P { s: String, n: i64 }
impl Drop for P { fn drop(mut ref self) { println(f"drop P {self.s.len()}"); } }
struct Q { s: String, n: i64 }
impl Drop for Q { fn drop(mut ref self) { println(f"drop Q {self.s.len()}"); } }
fn seed() -> i64 { env.args().len() }
fn payload() -> String { f"payload-{seed()}-aaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
fn mkp() -> P { return P { s: payload(), n: 1i64 }; }
fn mkq() -> Q { return Q { s: payload(), n: 2i64 }; }
fn takep(p: P) -> i64 { return p.n; }
fn takeq(q: Q) -> i64 { return q.n; }
fn go() -> i64 { let t = mkp(); let mut i = 0i64;
  while i < 0i64 { takep(t); i = i + 1; }
  return 1; }
fn main() { println(go()); }
