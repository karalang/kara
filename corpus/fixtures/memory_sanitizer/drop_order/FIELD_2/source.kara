struct S { v: String }
struct P { a: S, b: i64 }
fn seed() -> i64 { env.args().len() }
fn payload() -> String { f"payload-{seed()}-aaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
fn mkp(n: i64) -> P { return P { a: S { v: payload() }, b: n }; }
fn takep(p: P) -> i64 { return p.b; }
fn go() -> i64 { let t = mkp(9); let mut i = 0i64;
  while i < 0i64 { takep(t); i = i + 1; }
  return 1; }
fn main() { println(go()); }
