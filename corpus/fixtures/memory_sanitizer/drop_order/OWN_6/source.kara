fn seed() -> i64 { env.args().len() }
fn payload() -> String { f"payload-{seed()}-aaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
fn mkt() -> (Option[String], i64) { return (Option.Some(payload()), 7); }
fn take(t: (Option[String], i64)) -> i64 { return 1; }
fn go() -> i64 { let t = mkt(); let mut i = 0i64;
  while i < 0i64 { take(t); i = i + 1; }
  return 1; }
fn main() { println(go()); }
