shared struct Inner { v: i64 }
struct R { id: i64, name: String, inner: Option[Inner] }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, name: f"h{i}", inner: Option.Some(Inner { v: i }) }; }
fn f(r: R) -> (R, i64) { return (r, 9); }
fn main() { let z = f(mk(20)); println("ok"); }
