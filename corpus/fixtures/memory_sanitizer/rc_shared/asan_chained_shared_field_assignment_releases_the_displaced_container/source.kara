
shared struct Inner { mut n: i64, mut v: Vec[String] }
shared struct Outer { mut inner: Inner }

fn main() {
    let o = Outer { inner: Inner { n: 0, v: Vec.new() } };
    let mut i = 0i64;
    while i < 12i64 {
        let a = o.inner;
        a.v.push("one");
        a.v.push("two");
        let fresh: Vec[String] = Vec.new();
        o.inner.v = fresh;
        o.inner.n = i;
        i = i + 1;
    }
    let b = o.inner;
    println(f"{b.v.len()} {b.n}");
    println("end");
}
