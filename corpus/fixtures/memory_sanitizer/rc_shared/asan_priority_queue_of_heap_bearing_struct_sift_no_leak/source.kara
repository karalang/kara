
#[derive(PartialEq, Eq, PartialOrd, Ord)]
struct Item { id: i64, name: String }
fn main() {
    let mut q: PriorityQueue[Item] = PriorityQueue.new();
    q.push(Item { id: 3, name: f"ccc{3}" });
    q.push(Item { id: 1, name: f"a{1}" });
    q.push(Item { id: 2, name: f"bb{2}" });
    println(f"{q.len()}");
}
