
fn main() {
    let mut round: i64 = 0;
    while round < 40 {
        let v: Vec[String] = Vec[
            "cycle-take-alpha-aaaaaaaaaaaaaaaaaaaaaaaaaa",
            "cycle-take-bravo-bbbbbbbbbbbbbbbbbbbbbbbbbb"
        ];
        let r: Vec[String] = v.iter().cycle().take(5).cloned().collect();
        println(f"{r.len()} {r[0]} {r[4]} {v.len()}");
        round += 1;
    }
}
