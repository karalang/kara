
struct N { name: String, id: i64 }
impl N {
    fn relabel(self) -> N {
        N { name: "a sufficiently long heap payload for lsan", id: self.id + 1 }
    }
}
fn main() {
    let mut i = 0i64;
    let mut acc = 0i64;
    while i < 50i64 {
        let n = N { name: "seed string that is also quite long", id: i };
        acc = acc + n.relabel().name.len() + n.relabel().id;
        i = i + 1;
    }
    println(f"{acc}");
}
