
fn main() {
    let mut round: i64 = 0i64;
    while round < 40i64 {
        let v: Vec[i64] = Vec[1i64, 2i64, 3i64];
        let r: Vec[String] = v.iter().scan(0i64, |acc, x| Some((acc + x, f"running-sum-payload-{acc}-plus-{x}"))).collect();
        println(f"{r.len()} {r[0i64]} {r[2i64]} {v.len()}");
        round = round + 1i64;
    }
}
