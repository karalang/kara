
shared struct Box { mut name: String }
fn free_app(s: mut ref String) { s = s + "!"; }
fn main() {
    let mut i = 0;
    let mut last: String = "";
    while i < 50 {
        let mut b = Box { name: "n" };
        free_app(mut b.name);
        last = b.name.clone();
        i = i + 1;
    }
    println(last);
}
