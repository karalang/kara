
fn make(n: i64) -> Vec[f64] {
    let mut v: Vec[f64] = Vec.new();
    let mut i = 0;
    while i < n {
        v.push(1.5);
        i = i + 1;
    };
    v
}
fn main() {
    let mut v: Vec[f64] = Vec.new();
    v.push(1.0);
    v.push(2.0);
    v.push(3.0);
    println(Stats.sum(v));
    println(Stats.mean(v));
    let sorted = Stats.sort(v);
    println(sorted.len());
    println(Stats.sum(make(4)));
    println(v.len());
}
