
#[derive(Clone)]
struct R { id: i64, name: String }
struct Holder { r: R }
struct Box2 { w: String }

fn takes(s: String) -> i64 { return s.len(); }
fn ret_s(v: Vec[(String, i64)]) -> String { return v[0].0.clone(); }
fn ret_r(v: Vec[(R, i64)]) -> R { return v[0].0.clone(); }

fn mks() -> Vec[(String, i64)] { return [(f"a{1}", 1), (f"b{2}", 2)]; }
fn mkr() -> Vec[(R, i64)] {
    return [(R { id: 1, name: f"a{1}" }, 1), (R { id: 2, name: f"b{2}" }, 2)];
}

fn main() {
    let v = mks();
    // consuming positions
    let a = v[0].0.clone();
    println(a);
    let b = Box2 { w: v[0].0.clone() };
    println(b.w);
    let mut o: Vec[String] = Vec.new();
    o.push(v[0].0.clone());
    println(o[0]);
    println(takes(v[1].0.clone()));
    let mut b2 = Box2 { w: f"z{0}" };
    b2.w = v[1].0.clone();
    println(b2.w);
    let mut o2: Vec[String] = [f"q{0}"];
    o2[0] = v[0].0.clone();
    println(o2[0]);
    let c = true;
    let d = if c { v[0].0.clone() } else { v[1].0.clone() };
    println(d);
    let e = match c { true => v[1].0.clone(), false => v[0].0.clone() };
    println(e);
    let g = { let t = (f"t{1}", 2); t.0 };
    println(g);
    // non-consuming reads: the clone must free itself
    println(v[0].0 + "!");
    println(v[0].0.len());
    // a Copy member must not be cloned at all
    println(v[0].1);
    // the container is still intact
    println(v[0].0);
    println(v[1].0);
    println(ret_s(mks()));

    // the same matrix over a STRUCT member
    let w = mkr();
    let r = w[0].0.clone();
    println(r.name);
    let h = Holder { r: w[0].0.clone() };
    println(h.r.name);
    let mut po: Vec[R] = Vec.new();
    po.push(w[0].0.clone());
    println(po[0].name);
    println(ret_r(mkr()).name);
}
