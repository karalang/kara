
struct Person { n: String, tags: Vec[i64] }
impl Person {
    fn name(ref self) -> String { self.n.clone() }
    fn steal_tags(mut ref self) -> Vec[i64] { self.tags.clone() }
}
fn main() {
    let mut i: i64 = 0;
    while i < 3 {
        let mut p = Person { n: f"name-{i}-padded-padded", tags: [i, i + 1, i + 2] };
        let nm = p.name();
        println(nm);
        println(p.n);
        let tg = p.steal_tags();
        println(f"{tg.len()}");
        println(f"{p.tags.len()}");
        i = i + 1;
    }
}
