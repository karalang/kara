
fn mk_rows(n: i64) -> Vec[Vec[i64]] {
    let mut v: Vec[Vec[i64]] = Vec.new();
    let mut i = 0i64;
    while i < n {
        v.push(Vec[i, i + 1i64, i + 2i64]);
        i = i + 1;
    }
    v
}
fn main() {
    let mut total = 0i64;
    let mut it = 0i64;
    while it < 200i64 {
        total = total + mk_rows(2i64).first().unwrap().len();
        total = total + mk_rows(3i64).get(1i64).unwrap().len();
        it = it + 1i64;
    }
    println(f"{total}");
}
