fn plainNN(x: Option[Array[Array[String, 2], 2]]) {
    match x { Some(t) => { let u: Array[Array[String, 2], 2] = t; println(f"s:{u[1][1]}") } None => { println("n") } }
}
fn main() {
    let a: Array[Array[String, 2], 2] =
        [[f"aaaaaaaa0", f"bbbbbbbb0"], [f"cccccccc0", f"dddddddd0"]];
    plainNN(Some(a));
}
