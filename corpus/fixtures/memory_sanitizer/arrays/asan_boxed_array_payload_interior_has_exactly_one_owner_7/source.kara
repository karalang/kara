struct R9 { id: i64 }
impl Drop for R9 { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn plainD(x: Option[Array[R9, 2]]) {
    match x { Some(t) => { println(f"s:{t[0].id}") } None => { println("n") } }
}
fn main() {
    let a: Array[R9, 2] = [R9 { id: 1 }, R9 { id: 2 }];
    plainD(Some(a));
}
