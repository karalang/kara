fn mk(n: i64) -> Option[Array[i64, 2]] {
    if n < 0 { return None; }
    return Some(Array[n, n + 1]);
}
fn main() {
    let mut m: Map[i64, Array[i64, 2]] = Map.new();
    m.insert(1, Array[11, 22]);
    m.remove(1);
    let o = mk(5);
    match o { Some(a) => { println(f"s:{a[0]}"); } None => { println("s:none"); } }
}
