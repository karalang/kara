struct D { id: i64, s: String }
impl Drop for D { fn drop(mut ref self) { println(f"dD{self.id}") } }
fn mkd(i: i64) -> D { return D { id: i, s: f"ssssssssssssssss{i}" } }
fn thru(p: (Array[D, 2], i64)) -> (Array[D, 2], i64) { return p; }
fn main() {
    let u = thru(([mkd(1), mkd(2)], 7));
    println(f"n:{u.1}");
}
