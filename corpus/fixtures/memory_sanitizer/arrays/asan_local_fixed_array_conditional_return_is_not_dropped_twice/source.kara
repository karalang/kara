fn mk(i: i64) -> Array[String, 2] {
    let x = f"a{i}";
    let y = f"b{i}";
    let a: Array[String, 2] = [x, y];
    if i >= 0i64 {
        return a;
    }
    let p = f"p{i}";
    let q = f"q{i}";
    let b: Array[String, 2] = [p, q];
    b
}
fn main() {
    let mut i = 0i64; let mut n = 0i64;
    while i < 50i64 { let r = mk(i); n = n + r[0].len(); i = i + 1i64; }
    println(n);
}
