trait Tag { fn take_first(self) -> String; }
impl Tag for Array[String, 2] { fn take_first(self) -> String { return self[0].clone(); } }
fn mk(i: i64) -> Array[String, 2] { return [f"a{i}", f"b{i}"]; }

fn main() {
    let mut i = 0;
    let mut n = 0;
    let mut last: String = "";
    while i < 50 {
        last = mk(i).take_first();
        n = n + last.len();
        i = i + 1;
    }
    println(last);
    println(n);
}
