fn inner(a: Array[String, 2]) -> String { return a[1]; }
fn outer(a: Array[String, 2]) -> String { return inner(a); }
fn mk(i: i64) -> Array[String, 2] { return [f"a{i}", f"b{i}"]; }

fn main() {
    let mut i = 0i64;
    let mut n = 0i64;
    let mut last: String = "";
    while i < 50i64 {
        last = outer(mk(i));
        n = n + last.len();
        i = i + 1;
    }
    println(last);
    println(n);
}
