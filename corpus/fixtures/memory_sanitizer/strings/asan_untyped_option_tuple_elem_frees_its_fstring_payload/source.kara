struct D { id: i64, xs: Vec[i64], name: String }
impl Drop for D { fn drop(mut ref self) { println(f"  dD{self.id}:{self.xs.len()}:{self.name}") } }
fn mkD(id: i64) -> D {
    let mut v: Vec[i64] = Vec.new();
    v.push(id);
    return D { id: id, xs: v, name: f"n{id}" }
}
struct Q { id: i64, xs: Vec[i64], name: String }
fn mkQ(id: i64) -> Q {
    let mut v: Vec[i64] = Vec.new();
    v.push(id);
    return Q { id: id, xs: v, name: f"q{id}" }
}
fn takes(t: (D, Option[String])) { println("  tk") }
fn optHeap()   { let t = (mkD(1), Option.Some(mkD(2))); let t2 = t; println("  oh") }
fn noDrop()    { let t = (mkQ(3), Option.Some(mkQ(4))); let t2 = t; println("  nd") }
fn strElem0()  { let t = (f"s{5}", Option.Some(mkD(5))); let t2 = t; println("  se") }
fn ctlPlain()  { let t = (mkD(6), mkD(7)); let t2 = t; println("  cp") }
fn ctlScalar() { let t = (0, Option.Some(mkD(8))); let t2 = t; println("  cs") }
fn ctlOptStr() { let t = (mkD(9), Option.Some(f"p{9}")); let t2 = t; println("  co") }
fn ctlNoReb()  { let t = (mkD(10), Option.Some(f"p{10}")); println("  cn") }
fn argOptStr() { takes((mkD(11), Option.Some(f"p{11}"))); println("  ao") }
fn ctlNone()   { let t: (D, Option[D]) = (mkD(12), Option.None); let t2 = t; println("  cz") }
fn main() {
    optHeap(); noDrop(); strElem0(); ctlPlain();
    ctlScalar(); ctlOptStr(); ctlNoReb(); argOptStr(); ctlNone();
    println("end")
}
