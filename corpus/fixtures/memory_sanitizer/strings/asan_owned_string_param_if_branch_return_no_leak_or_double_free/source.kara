
fn pick(a: own String, b: own String) -> String {
    if a > b { a } else { b }
}

fn main() {
    let mut i: i64 = 0i64;
    let mut total: i64 = 0i64;
    while i < 200i64 {
        let r = pick(f"apple{i}", f"banana{i}");
        total = total + r.len();
        i = i + 1;
    }
    println(total.to_string());
}
