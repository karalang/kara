
struct A { path: Vec[String] }
fn main() {
    let mut v: Vec[A] = Vec.new();
    let mut i = 0;
    while i < 6 {
        let mut p: Vec[String] = Vec.new();
        p.push("struct_vec_string_plaindrop_element_payload".to_string());
        p.push("struct_vec_string_plaindrop_element_second_".to_string());
        v.push(A { path: p });
        i = i + 1;
    }
    println(v.len());
}
