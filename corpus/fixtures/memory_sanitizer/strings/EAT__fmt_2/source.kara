fn eat(a: Array[String, 2]) -> i64 { return a[0].len() as i64; }
fn mk(i: i64) -> Option[Array[String, 2]] {
    return Option.Some([f"row-aaaaaaaaaaaaaaaa-{i}", f"col-bbbbbbbbbbbbbbbb-{i}"]);
}
fn main() {
    let mut j: i64 = 0i64;
    while j < 2i64 {
        match mk(j) { Option.Some(a) => { println(f"e:{eat(a)}") } Option.None => { println("n") } }
        j = j + 1i64;
    }
    println("end");
}
