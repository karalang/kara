
fn count(s: ref String) -> i64 {
    let mut n = 0;
    let mut i = 0;
    while i < 6 {
        n = n + s[0..5].len();
        if s[0..5].starts_with("he") { n = n + 1; }
        if s[6..11].contains("or") { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn main() {
    let src: String = "hello world";
    println(count(src));
    println(src.len());
}
