
fn main() {
    let mut i = 0i64;
    let mut total = 0i64;
    while i < 40i64 {
        let mut p = String.from("[0-9]");
        p.push_str("+");
        let re = Regex.compile(p).unwrap();
        let ms = re.find_all("a1b22c333");
        for m in ms {
            total = total + m.text.len();
        }
        i = i + 1;
    }
    println(f"{total}");
}
