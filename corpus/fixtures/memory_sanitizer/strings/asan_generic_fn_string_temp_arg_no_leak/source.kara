
fn mk() -> String { let mut s = String.from(""); s.push_str("abcdefghijklmno"); s }
fn wrap[T](x: own T) -> Vec[T] { let mut v: Vec[T] = Vec.new(); v.push(x); v }
fn passthru[T](x: own T) -> T { x }
fn main() {
    let a = wrap(mk());
    let b = passthru(mk());
    println(a.len());
    println(b.len());
}
