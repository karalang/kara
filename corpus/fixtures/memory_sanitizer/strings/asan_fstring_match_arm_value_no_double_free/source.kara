
enum E { A(String), B(i64) }
fn describe(e: E) -> String {
    match e {
        E.A(name) => f"A[{name}]",
        E.B(k) => f"B[{k}]",
    }
}
fn main() {
    let mut i: i64 = 0;
    while i < 3 {
        let e = E.A("dyn" + "amic");
        let s = describe(e);
        println(s);
        // discarded arm-f-string result — must single-free, no double-free
        let d = E.A("tmp" + "val");
        match d {
            E.A(n) => f"[{n}]",
            E.B(_) => "x",
        };
        i = i + 1;
    }
}
