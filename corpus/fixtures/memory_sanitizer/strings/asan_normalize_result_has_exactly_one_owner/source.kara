fn main() {
    let mut i = 0i64;
    let mut total = 0i64;
    let mut last: String = "";
    while i < 50i64 {
        let src = "e\u{0301}fg";
        total = total + src.normalize(NormalizationForm.Nfc).len();
        let held = src.normalize(NormalizationForm.Nfd);
        total = total + held.len();
        last = src.normalize(NormalizationForm.Nfc).to_uppercase();
        i = i + 1;
    }
    println(last);
    println(total);
}
