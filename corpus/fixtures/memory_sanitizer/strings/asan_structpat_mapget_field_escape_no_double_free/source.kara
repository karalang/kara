
struct Holder { name: String, id: i64 }
fn main() {
    let mut i = 0;
    while i < 3 {
        let mut m: Map[i64, Holder] = Map.new();
        m.insert(i, Holder { name: f"holder payload padded beyond thirty-six bytes {i}", id: i });
        let s = match m.get(i) {
            Some(Holder { name, .. }) => name.clone(),
            None => f"none-{i}",
        };
        println(s.len());
        i = i + 1;
    };
}
