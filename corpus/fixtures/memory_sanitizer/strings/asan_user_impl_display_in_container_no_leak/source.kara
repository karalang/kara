
enum Ue { A { n: i64 }, B }
impl Display for Ue {
    fn to_string(ref self) -> String {
        match self { A { n } => f"aye-{n}-padding-padding-padding", B => "bee" }
    }
}
fn main() {
    let mut v: Vec[Ue] = Vec.new();
    let mut i = 0;
    while i < 60 {
        if i % 2 == 0 { v.push(Ue.A { n: i }); } else { v.push(Ue.B); }
        i = i + 1;
    }
    let s = f"{v}";
    println(s.len() > 0);
    println(v.len());
}
