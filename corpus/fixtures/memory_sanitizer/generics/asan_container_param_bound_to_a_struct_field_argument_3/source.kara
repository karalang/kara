
struct Bag[=T] { xs: Vec[T] }
fn first[T: Clone](v: ref Vec[T]) -> T { return v[0].clone(); }
impl[T: Clone] Bag[T] {
    fn head(ref self) -> T { return first(self.xs); }
}
fn main() {
    let mut a: Bag[String] = Bag { xs: Vec.new() };
    a.xs.push("aa"); a.xs.push("bb");
    println(f"[{a.head()}]");
}
