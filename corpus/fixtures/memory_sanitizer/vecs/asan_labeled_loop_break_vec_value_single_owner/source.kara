fn pick() -> Vec[i64] {
    let mut i: i64 = env.args().len() - 1;
    'outer: loop {
        i = i + 1;
        let mut j = 0;
        while j < 2 {
            j = j + 1;
            if i == 2 { break 'outer [i, j, i + j] }
        }
    }
}
fn main() { let v = pick(); println(v[0]); println(v[1]); println(v[2]); }
