
fn nums() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(7_i64);
    v.push(8_i64);
    v.push(9_i64);
    return v;
}

fn main() {
    match nums().first() {
        Some(x) => println(x),
        None => println(0_i64),
    };
    match nums().last() {
        Some(x) => println(x),
        None => println(0_i64),
    };
    println(nums().contains(8_i64));
    println(nums().contains(42_i64));
}
