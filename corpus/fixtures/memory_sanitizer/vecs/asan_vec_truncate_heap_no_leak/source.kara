
fn main() {
    let mut i: i64 = 0i64;
    while i < 3i64 {
        let mut s: Vec[String] = Vec.new();
        s.push(f"a-{i}-padding-padding");
        s.push(f"b-{i}-padding-padding");
        s.push(f"c-{i}-padding-padding");
        s.truncate(1);
        println(s.len());
        println(s[0]);
        s.push(f"d-{i}-padding-padding");
        println(s[1]);
        let mut t: Vec[String] = Vec.new();
        t.push(f"t-{i}-padding-padding");
        println(t.len());
        i = i + 1;
    }
}
