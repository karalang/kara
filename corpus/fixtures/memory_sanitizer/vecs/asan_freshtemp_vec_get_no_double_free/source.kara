
fn ids() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(100_i64);
    v.push(200_i64);
    v.push(300_i64);
    return v;
}

fn main() {
    let mut i = 0;
    while i < 3 {
        match ids().get(i) {
            Some(x) => println(x),
            None => println(0_i64),
        };
        i = i + 1;
    };
}
