
shared struct Node { data: Vec[i64] }
fn mk(n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n { v.push(i); i = i + 1; }
    return v;
}
fn main() {
    let mut ns: Vec[Node] = Vec.new();
    ns.push(Node { data: mk(3) });
    ns.push(Node { data: mk(300) });
    ns.push(Node { data: mk(3000) });
    println(ns.clone().len());
}
