
fn main() {
    let g: Vec[Vec[i64]] = [[1, 2, 3], [4, 5, 6], [7, 8]];
    let row = g.get(1).unwrap();
    println(row.len());
    let f = g.first().unwrap();
    println(f.len());
    let l = g.last().unwrap();
    println(l.len());

    let words: Vec[String] = ["hello", "world", "kara"];
    let w = words.get(2).unwrap();
    println(w.len());
    let fw = words.first().unwrap();
    println(fw.len());
}
