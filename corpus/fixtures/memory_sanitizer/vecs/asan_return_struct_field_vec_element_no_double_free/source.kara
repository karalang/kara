
struct S { xs: Vec[String] }
struct G { g: Vec[Vec[String]] }
struct N { ns: Vec[i64] }

impl S {
    fn get(ref self, i: i64) -> String { return self.xs[i].clone(); }
    fn tail(ref self, i: i64) -> String { self.xs[i].clone() }
    fn via_let(ref self, i: i64) -> String { let t = self.xs[i].clone(); return t; }
    fn concat(ref self, i: i64) -> String { return self.xs[i] + "!"; }
}
impl G { fn get(ref self, i: i64) -> Vec[String] { return self.g[i].clone(); } }
impl N { fn get(ref self, i: i64) -> i64 { return self.ns[i]; } }

fn free_get(s: ref S, i: i64) -> String { return s.xs[i].clone(); }

fn main() {
    let mut s = S { xs: Vec.new() };
    let mut i = 0;
    while i < 50 {
        s.xs.push(f"e{i}");
        i = i + 1;
    }

    let mut n = 0;
    let mut j = 0;
    while j < 50 {
        n = n + s.get(j).len();
        n = n + free_get(s, j).len();
        n = n + s.tail(j).len();
        n = n + s.via_let(j).len();
        n = n + s.concat(j).len();
        j = j + 1;
    }
    println(f"str={n}");

    // The source container must be intact after all those reads.
    println(f"live={s.xs[7]} len={s.xs.len()}");

    // Copy element: must NOT be cloned, and must stay correct.
    let mut nn = N { ns: Vec.new() };
    let mut k = 0;
    while k < 20 {
        nn.ns.push(k * 3);
        k = k + 1;
    }
    let mut sum = 0;
    let mut p = 0;
    while p < 20 {
        sum = sum + nn.get(p);
        p = p + 1;
    }
    println(f"scalar={sum}");

    // Heap element that is itself a Vec.
    let mut gg = G { g: Vec.new() };
    let mut q = 0;
    while q < 10 {
        let mut inner: Vec[String] = Vec.new();
        inner.push(f"i{q}");
        inner.push(f"j{q}");
        gg.g.push(inner);
        q = q + 1;
    }
    let mut gl = 0;
    let mut r = 0;
    while r < 10 {
        let got = gg.get(r);
        gl = gl + got.len();
        r = r + 1;
    }
    println(f"nested={gl}");
}
