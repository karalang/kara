
fn build(n: i64) -> Vec[Result[String, i64]] {
    let mut v: Vec[Result[String, i64]] = Vec.new();
    v.push(Ok(f"alpha ok payload padded out beyond thirty-six bytes {n}"));
    v.push(Err(7_i64));
    return v;
}
fn main() {
    let mut total = 0;
    let mut i = 0;
    while i < 4 {
        let v = build(i);
        for r in v {
            match r {
                Ok(s) => { total = total + s.len(); },
                Err(e) => { total = total + e; },
            };
        }
        i = i + 1;
    };
    println(total);
}
