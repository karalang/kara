struct R { s: String }
impl Drop for R { fn drop(mut ref self) { println(f"drop R {self.s.len()}"); } }
enum E { A(R), B }
impl Drop for E { fn drop(mut ref self) { println("drop E"); } }
fn seed() -> i64 { env.args().len() }
fn payload() -> String { f"payload-{seed()}-aaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
fn mke() -> E { return E.A(R { s: payload() }); }
fn take(e: E) -> i64 { return 1; }
fn go() -> i64 { let t = mke(); let mut i = 0i64;
  while i < 0i64 { take(t); i = i + 1; }
  return 1; }
fn main() { println(go()); }
