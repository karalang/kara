
shared enum E { Leaf(i64), Node(E) }
fn chk(e: E) -> i64 {
    match e {
        Leaf(n) => n,
        Node(x) => chk(x)
    }
}
fn main() {
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < 200 {
        t = t + chk(Node(Node(Node(Leaf(1)))));
        i = i + 1;
    }
    println(f"{t}");
}
