struct D { id: i64 }
impl Drop for D { fn drop(mut ref self) { println(f"dD{self.id}") } }
struct W { id: i64, s: String }
impl Drop for W { fn drop(mut ref self) { println(f"dW{self.id}") } }
fn idOpt[T](g: Option[T]) -> Option[T] { return g }
fn idRes[T](g: Result[T, i64]) -> Result[T, i64] { return g }
fn main() {
    { let a: Option[D] = Option.Some(D { id: 6 }); let b = idOpt(a); match b { Option.Some(v) => { println(f"g{v.id}") } Option.None => { println("none") } } }
    { let a: Option[W] = Option.Some(W { id: 7, s: "ssssssss" }); let b = idOpt(a); match b { Option.Some(v) => { println(f"g{v.id}") } Option.None => { println("none") } } }
    { let a: Option[W] = Option.Some(W { id: 8, s: "tttttttt" }); let b = idOpt(a); }
    println("end");
}
