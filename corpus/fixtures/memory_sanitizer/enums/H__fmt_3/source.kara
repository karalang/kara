enum E { A(R), B }
impl Drop for E { fn drop(mut ref self) { println("drop E") } }
struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"drop R{self.name}") } }
struct W { p: (E, i64) }
fn main() { let w = W { p: (E.A(R { id: 7, name: f"n{7}" }), 1) };
             println("hi"); }
