struct R2 { s: String, t: String, u: String }
enum K { A(R2), B }
fn mkr(i: i64) -> R2 { return R2 { s: f"ssssssss{i}", t: f"tttttttt{i}", u: f"uuuuuuuu{i}" }; }
fn show(x: Option[K]) { match x { Option.Some(k) => { match k { K.A(r) => { println(f"a:{r.s}"); }, K.B => {} } }, Option.None => {} } }
fn main() { let mut i = 0; while i < 3 { show(Option.Some(K.A(mkr(i)))); i = i + 1; } println("end") }
