fn seed() -> i64 { env.args().len() }
struct Rt { id: i64, name: String }
impl Drop for Rt { fn drop(mut ref self) { println(f"d{self.id}") } }
fn innerT(x: Option[(Rt, Rt)]) {
   match x { Some((a, b)) => { println(f"a{a.id}") } None => { println("n") } } }
fn outerT(x: Option[(Rt, Rt)]) -> Option[(Rt, Rt)] { return x; }
fn main() { let mut i = 0; while i < 2 {
   innerT(outerT(Some((Rt { id: 70 + i + seed(), name: f"aaaaaaaa{i}" },
                        Rt { id: 80 + i, name: f"bbbbbbbb{i}" })))); i = i + 1; } }
