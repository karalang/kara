{PRE}struct Wt {{ a: Rt, b: Rt }}
fn takeW(x: Option[Wt]) {{
   match x {{ Some(t) => {{ println("ok") }} None => {{ println("n") }} }} }}
fn main() {{ let mut i = 0; while i < 2 {{
   takeW(Some(Wt {{ a: Rt {{ id: 70 + i + seed(), name: f"aaaaaaaa{{i}}" }},
                    b: Rt {{ id: 80 + i, name: f"bbbbbbbb{{i}}" }} }})); i = i + 1; }} }}
