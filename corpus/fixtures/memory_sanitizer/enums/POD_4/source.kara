{POD}enum Jp {{ C(P4), D }}
fn show(x: Result[Kp, Jp]) {{ match x {{ Result.Ok(Kp.A(p)) => {{ println(f"a:{{p.a}}"); }}, Result.Ok(Kp.B) => {{}}, Result.Err(Jp.C(p)) => {{ println(f"c:{{p.a}}"); }}, Result.Err(Jp.D) => {{}} }} }}
fn main() {{ let mut i = 0; while i < 3 {{ show(Result.Ok(Kp.A(mkp(i)))); show(Result.Err(Jp.C(mkp(i)))); i = i + 1; }} println("end") }}
