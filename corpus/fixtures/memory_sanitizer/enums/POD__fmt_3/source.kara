struct P4 { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64 }
enum Kp { A(P4), B }
fn mkp(i: i64) -> P4 { return P4 { a: i, b: 0, c: 0, d: 0, e: 0, f: 0 }; }
fn show(x: Result[i64, Kp]) { match x { Result.Ok(n) => { println(f"n{n}"); }, Result.Err(Kp.A(p)) => { println(f"e:{p.a}"); }, Result.Err(Kp.B) => {} } }
fn main() { let mut i = 0; while i < 3 { show(Result.Err(Kp.A(mkp(i)))); i = i + 1; } println("end") }
