struct R2z { s: String }
enum Kz { A(R2z), B }
impl Drop for Kz { fn drop(mut ref self) { println("dKz") } }
#[allow(partial_move_of_drop_enum)]
fn show(x: Option[Kz], acc: mut ref Vec[R2z]) { match x { Option.Some(Kz.A(r)) => { acc.push(r) } Option.Some(Kz.B) => {} Option.None => {} } }
fn main() { let mut acc: Vec[R2z] = []; for i in 0..3 { show(Option.Some(Kz.A(R2z { s: f"aaaaaaaaaaaaaaaaaaaa-{i}" })), mut acc); } println(f"len:{acc.len()}") }
