
enum E { V(String) }
impl E { fn extract(self) -> String { match self { E.V(s) => s } } }
impl E { fn length(self) -> i64 { match self { E.V(s) => s.len() } } }
fn main() {
    let e = E.V("hi".to_string());
    println(e.extract());
    let e2 = E.V("abcd".to_string());
    println(e2.length());
}
