shared struct Inner { v: i64 }
struct Wrap { i: Inner }
enum M { P((Wrap, i64)), Q }
fn main() {
    let n = env.args().len() as i64;
    let mut i: i64 = 0i64;
    while i < 3i64 {
        let g: M = P((Wrap { i: Inner { v: n } }, 1i64));
        println("t");
        i = i + 1i64;
    }
    println("end");
}