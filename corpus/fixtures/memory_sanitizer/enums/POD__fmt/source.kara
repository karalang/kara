struct P4 { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64 }
enum Kp { A(P4), B }
fn mkp(i: i64) -> P4 { return P4 { a: i, b: 0, c: 0, d: 0, e: 0, f: 0 }; }
fn show(x: Option[Kp]) { match x { Option.Some(Kp.A(p)) => { println(f"a:{p.a}"); }, Option.Some(Kp.B) => {}, Option.None => {} } }
fn main() { let mut i = 0; while i < 3 { show(Option.Some(Kp.A(mkp(i)))); i = i + 1; } println("end") }
