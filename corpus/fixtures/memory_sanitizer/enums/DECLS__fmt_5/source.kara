#[derive(Clone)]
struct R { name: String, id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}/{self.name}") } }
struct Wide { r: R, a: i64, b: i64, c: i64, d: i64, e: i64 }
fn eat(o: Result[Wide, i64]) {
    match o { Result.Ok(t) => { let x = t.r.clone(); println("mid"); } Result.Err(v) => { println("n"); } }
}
fn main() { eat(Result.Ok(Wide { r: R { name: f"a", id: 5 }, a: 1, b: 2, c: 3, d: 4, e: 5 })); println("end"); }
