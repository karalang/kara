{PRE}fn takeR(x: Result[(Rt, Rt), i64]) {{
   match x {{ Ok(t) => {{ println("ok") }} Err(e) => {{ println("n") }} }} }}
fn main() {{ let mut i = 0; while i < 2 {{
   takeR(Result.Ok((Rt {{ id: 70 + i + seed(), name: f"aaaaaaaa{{i}}" }},
                     Rt {{ id: 80 + i, name: f"bbbbbbbb{{i}}" }}))); i = i + 1; }} }}
