struct Wrap2 { t: (bool, String) }
enum M { P((Wrap2, i64)), Q }
fn main() {
    let n = env.args().len() as i64;
    let mut i: i64 = 0i64;
    while i < 3i64 {
        let g: M = P((Wrap2 { t: (true, f"row-aaaaaaaaaaaaaaaa-{i}-{n}") }, 1i64));
        println("t");
        i = i + 1i64;
    }
    println("end");
}