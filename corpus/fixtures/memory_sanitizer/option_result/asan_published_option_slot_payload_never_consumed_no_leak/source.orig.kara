
fn first_word(s: String) -> Option[String] {
    let words = s.split(" ");
    if words.len() > 0 { Some(words[0]) } else { None }
}
fn main() {
    let a = first_word("aaaaaaaaaaaaaaaaaaaaaaaaaaaaa bb");
    let b = first_word("ccccccccccccccccccccccccccccc dd");
    println(a.is_some());
    println(b.is_some());
}
