
fn mk(i: i64) -> String {
    let mut s = String.new();
    s.push_str("v");
    s.push_str(i.to_string());
    s
}
fn sink(s: String) { if s.len() > 99999 { println(s); } }
fn main() {
    let mut i = 0i64;
    while i < 5i64 {
        sink(mk(i));
        i = i + 1;
    }
    let t = mk(7i64);
    sink(t);
    println("ok");
}
