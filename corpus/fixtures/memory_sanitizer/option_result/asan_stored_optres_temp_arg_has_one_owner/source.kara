
fn mks(n: i64) -> String { return f"payloadpayload{n}"; }
fn sink(acc: mut ref Vec[Option[String]], x: Option[String]) { acc.push(x); }
fn main() {
    let mut acc: Vec[Option[String]] = Vec.new();
    let mut i = 0;
    while i < 3 {
        sink(mut acc, Some(mks(i)));
        println(f"{acc.len()}");
        i = i + 1;
    }
    println("done");
}
