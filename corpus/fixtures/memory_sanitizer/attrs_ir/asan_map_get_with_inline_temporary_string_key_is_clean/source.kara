
fn main() {
    let mut m: Map[String, i64] = Map.new();
    m.insert(f"a-padding-padding-padding", 7i64);
    let mut j = 0i64;
    let mut hits = 0i64;
    while j < 5i64 {
        match m.get(f"b-{j}-padding-padding-padding") {
            Some(v) => { hits = hits + v; }
            None => {}
        }
        j = j + 1i64;
    }
    println(f"{hits}{m.len()}");
}
