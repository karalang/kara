
#[derive(Clone)]
struct Item { id: i64, name: String }
struct Bag { xs: Vec[Item] }
impl Bag {
    fn go(mut ref self) { self.xs.swap(0, 1); }
}
fn main() {
    let mut b = Bag { xs: Vec.new() };
    b.xs.push(Item { id: 1, name: f"a{1}" });
    b.xs.push(Item { id: 2, name: f"bb{2}" });
    b.go();
    println(f"{b.xs[0].id}");
}
