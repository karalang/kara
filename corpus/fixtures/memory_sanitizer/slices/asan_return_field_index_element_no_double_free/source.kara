
struct H { xs: Vec[String] }
impl H {
    fn get(ref self, i: i64) -> String { self.xs[i] }
}
fn getf(h: ref H, i: i64) -> String { h.xs[i] }
fn main() {
    let mut r: i64 = 0;
    while r < 3 {
        let h = H { xs: [f"alpha-{r}-pad", f"bravo-{r}-pad", f"charlie-{r}"] };
        println(h.get(0));
        let bound: String = getf(h, 1);
        println(bound);
        println(h.xs[2]);
        r = r + 1;
    }
}
