
fn main() {
    let mut r: Vec[String] = Vec.new();
    r.push(f"a-padding-padding-padding");
    r.push(f"b-padding-padding-padding");
    let mut d: Vec[Vec[String]] = Vec.new();
    d.push(r);
    let mut j = 0;
    while j < 5 {
        let x: String = f"x-{j}-padding-padding-padding";
        d[0][1] = x;
        j = j + 1;
    }
    println(f"{d[0][1]}{d.len()}");
}
