struct D { s: String, id: i64 }
impl Drop for D { fn drop(mut ref self) { println(f"dD{self.id}") } }
fn main() {
    let mut a: Array[(D, i64), 2] = [(D { s: f"aaaaaaaaaaaa1", id: 1 }, 1), (D { s: f"bbbbbbbbbbbb2", id: 2 }, 2)];
    a[0] = (D { s: f"MUTATEDMUTATED3", id: 3 }, 3);
    println("mid");
}
