
fn main() {
    let a: Tensor[i64, [3]] = Tensor.from([1, 2, 3]);
    let b: Tensor[i64, [3]] = Tensor.from([10, 20, 30]);
    let c: Tensor[i64, [3]] = Tensor.from([100, 200, 300]);
    let r = a + b + c;
    println(r[0]);
    let r2 = (a + b) * (b + c);
    println(r2[1]);
    let n = -a + b;
    println(n[0]);
    let s = a + 5;
    println(s[2]);
    let m = a * 3 - b;
    println(m[1]);
    println(a[0]);
    println(b[2]);
}
