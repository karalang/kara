
fn inner() -> i64 {
    let c: Column[i64] = Column.from_vec([1, 2, 3, 4]);
    let d = c.map(|x| x * 2);
    let t: Tensor[i64, [4]] = Tensor.from([1, 2, 3, 4]);
    let e = t.map(|x| x + 1);
    d.sum() + e.sum()
}
fn main() {
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 20 {
        acc = acc + inner();
        i = i + 1;
    }
    println(f"{acc}");
}
