
fn main() {
    let a = Tensor.from([[1, 2, 3], [4, 5, 6]]);
    let r = a.reshape([3, 2]);
    println(r[2, 1]);
    let p = a.permute([1, 0]);
    println(p[2, 1]);
    let sl = a.slice(1, 1, 3);
    println(sl[1, 1]);
    let b = Tensor.from([[[7], [8], [9]]]);
    let sq = b.squeeze();
    println(sq[2]);
    let chained = a.permute([1, 0]).reshape([6]);
    println(chained[5]);
}
