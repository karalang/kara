
import std.autograd.{TensorTape, TensorVar};
fn main() {
    let t = TensorTape.new();
    let x0: Tensor[f32, [?]] = Tensor.from([-1.0, 2.0, 0.5]);
    let x = TensorVar.leaf(t, x0);
    let a = x.relu();
    let b = a.tanh();
    let c = b.sigmoid();
    c.backward();
    println(x.grad_at(0));
}
