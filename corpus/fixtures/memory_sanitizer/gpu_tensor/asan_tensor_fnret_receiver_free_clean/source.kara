
fn make() -> Tensor[i64, [2, 3]] {
    Tensor.from([[1, 2, 3], [4, 5, 6]])
}
struct Factory {}
impl Factory {
    fn build(ref self) -> Tensor[i64, [2, 3]] {
        Tensor.from([[10, 20, 30], [40, 50, 60]])
    }
}
fn main() {
    let r = make().reshape([3, 2]);
    println(r[2, 1]);
    let f = Factory {};
    let m = f.build().slice(0, 1, 2);
    println(m[0, 2]);
    let p = make().permute([1, 0]);
    println(p[2, 1]);
    let sq = make().squeeze();
    println(sq[1, 2]);
}
