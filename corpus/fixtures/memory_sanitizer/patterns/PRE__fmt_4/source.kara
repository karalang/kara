struct R3 { s: String, t: String, u: String }
enum Ke { A(R3), B }
fn seed() -> i64 { env.args().len() }
fn mk(i: i64) -> R3 { return R3 { s: f"ssssssss{i}{seed()}", t: f"tttttttt{i}", u: f"uuuuuuuu{i}" }; }
struct Holder { held: R3 }
fn f(x: Option[Ke], acc: mut ref Holder) { match x { Option.Some(Ke.A(r)) => { acc.held = r; } _ => {} } }
fn main() { let mut h = Holder { held: mk(9) }; let mut i = 0;
   while i < 2 { f(Option.Some(Ke.A(mk(i))), mut h); i = i + 1; }
   println(f"rb:{h.held.s}"); }
