enum G { A(String), B }
impl Drop for G { fn drop(mut ref self) {
    match self { G.A(s) => { println(f"dG{s}") } G.B => { println("dGB") } } } }
fn sink(g: G) -> i64 { println("sink"); return 1; }
fn main() { let o: Option[G] = Some(G.A(f"z{9}"));
             if let Some(g) = o { let n = sink(g); println(f"n{n}") } }
