struct R3 { s: String, t: String, u: String }
enum Ke { A(R3), B }
fn seed() -> i64 { env.args().len() }
fn mk(i: i64) -> R3 { return R3 { s: f"ssssssss{i}{seed()}", t: f"tttttttt{i}", u: f"uuuuuuuu{i}" }; }
fn f(x: Option[Ke]) -> R3 { match x { Option.Some(Ke.A(r)) => { return r; } _ => { return mk(9); } } }
fn main() { let mut i = 0; while i < 2 { let g = f(Option.Some(Ke.A(mk(i)))); println(f"rb:{g.s}"); i = i + 1; } }
