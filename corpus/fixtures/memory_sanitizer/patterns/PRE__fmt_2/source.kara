struct R3 { s: String, t: String, u: String }
enum Ke { A(R3), B }
fn seed() -> i64 { env.args().len() }
fn mk(i: i64) -> R3 { return R3 { s: f"ssssssss{i}{seed()}", t: f"tttttttt{i}", u: f"uuuuuuuu{i}" }; }
fn f(x: Option[Ke], acc: mut ref Vec[R3]) { match x { Option.Some(Ke.A(r)) => { acc.push(r); } _ => {} } }
fn main() { let mut acc: Vec[R3] = Vec.new(); let mut i = 0;
   while i < 2 { f(Option.Some(Ke.A(mk(i))), mut acc); i = i + 1; }
   println(f"rb:{acc[0].s}"); }
