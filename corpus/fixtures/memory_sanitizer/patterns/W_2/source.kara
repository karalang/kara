struct W { id: i64, xs: Vec[i64] }
impl Drop for W { fn drop(mut ref self) { println(f"dW{self.id}/{self.xs.len()}") } }
fn take(o: Option[(W, i64)]) -> i64 { match o { Some(t) => { return t.1; } None => { return 0; } } }
fn main() { let mut v: Vec[i64] = Vec.new(); v.push(7); v.push(8);
            println(f"g{take(Some((W { id: 3, xs: v }, 9)))}") }
