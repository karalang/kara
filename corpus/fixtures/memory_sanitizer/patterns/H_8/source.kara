enum H2 { A(R2), B }
struct R2 { id: i64, name: String }
impl Drop for R2 { fn drop(mut ref self) { println(f"drop R{self.name}") } }
fn main() { let r: Result[H2, i64] = Ok(H2.A(R2 { id: 5, name: f"n{5}" }));
             match r { Ok(h) => { println("got") }
                       Err(n) => { println("err") } } }
