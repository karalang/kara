struct H { id: i64, xs: Vec[i64], name: String }
fn mk(id: i64) -> H {
    let mut v: Vec[i64] = Vec.new();
    v.push(id);
    return H { id: id, xs: v, name: f"n{id}" }
}
struct W { t: (H, i64) }
fn p_read(t: (H, i64)) -> i64 { if let (r, k) = t { k } else { 0 } }
fn p_noread(t: (H, i64)) { if let (r, k) = t { println("  noread") } else { println("  miss") } }
fn p_rebind(t: (H, i64)) -> i64 { if let (r, k) = t { let m = r; m.id } else { 0 } }
fn p_out(t: (H, i64)) -> H { if let (r, k) = t { r } else { mk(0) } }
fn p_field(w: W) -> i64 { if let (r, k) = w.t { r.xs.len() + k } else { 0 } }
fn p_letelse(t: (H, i64)) -> i64 { let (r, k) = t else { return 0 }; r.id + k }
fn p_while(t: (H, i64)) -> i64 { while let (r, k) = t { return r.id } 0 }
fn l_read() -> i64 { let t = (mk(21), 0); if let (r, k) = t { r.id } else { 0 } }
fn l_rebind() -> i64 { let t = (mk(22), 0); if let (r, k) = t { let m = r; m.id } else { 0 } }
fn m_read(t: (H, i64)) -> i64 { match t { (r, k) => { r.id } } }
fn letd(t: (H, i64)) -> i64 { let (r, k) = t; r.id }
fn main() {
    println(f"  a{p_read((mk(1), 0))}");
    p_noread((mk(2), 0));
    println(f"  c{p_rebind((mk(3), 0))}");
    let d = p_out((mk(4), 0));
    println(f"  d{d.name}");
    println(f"  e{p_field(W { t: (mk(5), 0) })}");
    println(f"  f{p_letelse((mk(6), 0))}");
    println(f"  g{p_while((mk(7), 0))}");
    println(f"  h{l_read()}");
    println(f"  i{l_rebind()}");
    println(f"  m{m_read((mk(8), 0))}");
    println(f"  l{letd((mk(9), 0))}");
    println("end")
}
