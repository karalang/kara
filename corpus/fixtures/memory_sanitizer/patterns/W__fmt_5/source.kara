struct W { id: i64, name: String }
impl Drop for W { fn drop(mut ref self) { println(f"dW{self.id}/{self.name}") } }
fn take(o: ref Option[(W, i64)]) -> i64 { match o { Some(t) => { return t.1; } None => { return 0; } } }
fn main() { let o: Option[(W, i64)] = Some((W { id: 3, name: f"n3" }, 9)); println(f"g{take(o)}") }
