
struct Holder { name: String, id: i64 }
fn main() {
    let mut v: Vec[Holder] = Vec.new();
    let mut i = 0;
    while i < 3 {
        v.push(Holder { name: f"holder payload padded beyond thirty-six bytes {i}", id: i });
        i = i + 1;
    };
    let mut total = 0;
    while let Some(Holder { name, id }) = v.pop() {
        total = total + (name.len() as i64) + id;
    }
    println(total);
}
