
shared enum Expr { Num(i64), Add(Expr, Expr) }
fn eval(e: Expr) -> i64 {
    match e {
        Num(n) => n,
        Add(l, r) => eval(l) + eval(r),
    }
}
fn fold(e: Expr) -> Expr {
    match e {
        Num(n) => Expr.Num(n),
        Add(l, r) => Expr.Add(Expr.Num(99), Expr.Num(99)),
    }
}
fn build(n: i64) -> Expr {
    if n <= 0 { Expr.Num(n) }
    else { Expr.Add(Expr.Num(n), build(n - 1)) }
}
fn main() {
    let mut i: i64 = 0;
    let mut total: i64 = 0;
    while i < 60 {
        let t: Expr = build(3);
        let t2: Expr = fold(t);
        total = total + eval(t2);
        i = i + 1;
    }
    println(total);
}
