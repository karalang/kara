
struct H { f: Fn(i64) -> i64 }
struct G { f: Fn(i64) -> i64, n: i64 }
fn make(k: i64) -> Fn(i64) -> i64 { |x| x + k }
fn relay(k: i64) -> Fn(i64) -> i64 { let f = make(k); let h = H { f: f }; f }
fn main() {
    let f = make(10i64);
    let h = H { f: f };
    let a = f(1i64);
    let b = (h.f)(2i64);
    let g = make(5i64);
    let g2 = g;
    let gg = G { f: g2, n: 3i64 };
    let c = g(4i64);
    let d = (gg.f)(6i64);
    let e = gg.n;
    let r = relay(30i64);
    let k = r(7i64);
    println(f"{a + b + c + d + e + k}");
}
