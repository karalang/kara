
fn make(k: i64) -> Fn(i64) -> i64 { |x| x + k }
fn main() {
    let a: Array[Fn(i64) -> i64, 1] = [make(10i64)];
    let b: Array[Fn(i64) -> i64, 2] = [make(5i64), make(7i64)];
    let f = make(20i64);
    let c: Array[Fn(i64) -> i64, 1] = [f];
    println(f"{(a[0])(1i64) + (b[0])(1i64) + (b[1])(2i64) + f(0i64) + (c[0])(1i64)}");
}
