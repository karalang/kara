
fn check(addr: String) {
    if addr == "relay-upstream-127.0.0.1-9000" {
    } else {
        println("CORRUPT");
    }
}
fn main() {
    let base = "relay-upstream-127.0.0.1-9000";
    let mut tg: TaskGroup = TaskGroup.new();
    let mut i: i64 = 0;
    loop {
        let addr = base.clone();
        i = i + 1;
        tg.spawn(|| check(addr));
        if i >= 6 { break; }
    }
    println("ok");
}
