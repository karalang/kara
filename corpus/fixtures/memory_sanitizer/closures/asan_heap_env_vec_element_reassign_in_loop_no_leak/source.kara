
fn make(k: i64) -> Fn(i64) -> i64 { |x| x + k }
fn main() {
    let mut v: Vec[Fn(i64) -> i64] = Vec.new();
    v.push(make(0i64));
    v.push(make(0i64));
    v.push(make(0i64));
    v.push(make(0i64));
    v.push(make(0i64));
    let mut i = 0i64;
    while i < 50i64 {
        let mut k = 0i64;
        while k < 5i64 {
            v[k] = make(k * 10i64);
            k = k + 1i64;
        }
        i = i + 1;
    }
    println(f"{(v[0i64])(0i64) + (v[1i64])(0i64) + (v[2i64])(0i64) + (v[3i64])(0i64) + (v[4i64])(0i64)}");
}
