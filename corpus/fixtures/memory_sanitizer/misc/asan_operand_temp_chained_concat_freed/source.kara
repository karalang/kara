
fn make_s() -> String {
    let s: String = "a freshly allocated heap operand string over thirty-six bytes";
    return s;
}

fn main() {
    let mut i = 0;
    while i < 3 {
        let r = make_s() + " mid " + "tail padded out beyond thirty-six bytes here";
        println(r);
        i = i + 1;
    };
}
