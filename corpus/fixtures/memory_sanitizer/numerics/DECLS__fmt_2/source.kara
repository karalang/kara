struct P { id: i64 }
impl Drop for P { fn drop(mut ref self) { println(f"dP{self.id}") } }
struct Q { id: i64 }
impl Drop for Q { fn drop(mut ref self) { println(f"dQ{self.id}") } }
struct W { a: P, b: Q, n: i64, p: i64 }
fn eat() {
    let o: Option[W] = Option.Some(W { a: P { id: 6 }, b: Q { id: 7 }, n: 2, p: 3 });
    match o { Option.Some(t) => { let y = t.a; println("mid"); } Option.None => { println("n"); } }
}
fn main() { eat(); println("end"); }
