
fn build(n: i64) -> Result[i64, AllocError] {
    let src: Vec[String] = ["alpha", "beta", "gamma", "delta"];
    let mut total = 0i64;
    let mut k = 0i64;
    while k < n {
        let up: Vec[String] = Vec.try_from_iter(src.iter().map(|s| s.to_uppercase()))?;
        total = total + up.len() + up[0].len();
        k = k + 1i64;
    }
    return Ok(total);
}
fn main() {
    match build(64i64) {
        Ok(n) => { println(f"ok {n}"); }
        Err(e) => { println("oom"); }
    }
}
