
fn main() {
    let mut out: Vec[String] = Vec.new();
    let mut m: Map[i64, String] = Map.new();
    let mut i = 0;
    while i < 3 {
        m.insert(i, f"map string payload padded beyond thirty-six bytes {i}");
        i = i + 1;
    };
    for (k, v) in m {
        out.push(v);
    }
    println(out.len());
}
