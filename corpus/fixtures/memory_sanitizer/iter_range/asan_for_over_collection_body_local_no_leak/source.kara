
fn build(n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n { v.push(i); i = i + 1; }
    v
}
fn main() {
    let mut keys: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 200 { keys.push(k); k = k + 1; }
    let mut total: i64 = 0;
    for key in keys {
        let row: Vec[i64] = build(64);
        total = total + (row.len() as i64) + key;
    }
    println(total);
}
