
fn main() {
    let words: Vec[String] = ["alpha", "bb", "gamma", "dd", "epsilon"];
    for w in words.iter().filter(|w| w.len() > 2).map(|w| w.clone()) {
        println(w);
    }
    let nums: Vec[i64] = [1, 2, 3, 4, 5, 6];
    for s in nums.iter().filter(|n| n % 2 == 0).map(|n| f"n={n}") {
        println(s);
    }
}
