
struct Mk { p: String }
impl Mk { fn mkstr(ref self, n: i64) -> String {
    return f"aaaaaaaaaaaaaaaa-{n}";
} }
fn main() {
    let mut m: Map[String, i64] = Map.new();
    let g: Mk = Mk { p: f"x" };
    m.insert(g.mkstr(0i64), 0i64);
    match m.get(g.mkstr(0i64)) {
        Some(v) => { println(f"g:{v}"); } None => { println("missing"); }
    }
    println(f"len:{m.len()}");
}
