fn mk20(n: i64) -> (String, String) { return (f"aaaaaaaaaaaa{n}", f"bbbbbbbbbbbb{n}"); }
fn main() {
    let mut s: Set[(String, String)] = Set.new();
    let mut i: i64 = 0;
    while i < 3 { s.insert(mk20(i)); i = i + 1; }
    let mut j: i64 = 0;
    while j < 2 { if s.contains(mk20(j)) { println("yes"); } else { println("no"); } j = j + 1; }
    println(f"len:{s.len()}");
}