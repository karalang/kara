
struct A { rows: Vec[Map[i64, String]] }
fn main() {
    let mut v: Vec[A] = Vec.new();
    let mut i = 0;
    while i < 6 {
        let mut rows: Vec[Map[i64, String]] = Vec.new();
        let mut m: Map[i64, String] = Map.new();
        m.insert(1, "struct_vec_map_field_string_value_payload_x".to_string());
        rows.push(m);
        v.push(A { rows: rows });
        i = i + 1;
    }
    println(v.len());
}
