
shared struct N { v: i64 }

fn stash(xs: own Vec[weak N]) -> i64 {
    let mut m: Map[i64, Vec[weak N]] = Map.new();
    m.insert(1, xs);
    match m.get(1) { Some(inner) => { match inner[0] { Some(x) => { x.v } None => { 0 - 1 } } } None => { 0 - 2 } }
}

fn main() {
    let a: N = N { v: 7 };
    let mut w: Vec[weak N] = Vec.new();
    w.push(a);
    println(stash(w));
    println(a.v);
}
