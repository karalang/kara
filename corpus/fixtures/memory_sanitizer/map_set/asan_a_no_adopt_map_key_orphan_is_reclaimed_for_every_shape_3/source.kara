fn mk() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(f"aaaaaaaaaaaa0");
    v.push(f"bbbbbbbbbbbb0");
    return v;
}
fn main() {
    let mut m: Map[Vec[String], i64] = Map.new();
    let k1 = mk();
    let k2 = mk();
    m.insert(k1, 1);
    m.insert(k2, 2);
    println(f"s:{m.len()}");
}
