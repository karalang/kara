fn mk() -> Array[String, 2] { return Array[f"aaaaaaaa0", f"bbbbbbbb0"]; }
fn main() {
    let mut m: Map[Array[String, 2], i64] = Map.new();
    let k1 = mk();
    let k2 = mk();
    match m.try_insert(k1, 1) {
        Ok(o) => { println("s:ok"); }
        Err(e) => { println("s:err"); }
    }
    match m.try_insert(k2, 2) {
        Ok(o) => { println("t:ok"); }
        Err(e) => { println("t:err"); }
    }
    println(f"u:{m.len()}");
}
