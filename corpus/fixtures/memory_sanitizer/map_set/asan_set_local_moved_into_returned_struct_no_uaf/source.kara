
struct Bag { tags: Set[i64], count: i64 }
fn make(x: i64) -> Bag {
    let mut s: Set[i64] = Set.new();
    s.insert(x);
    return Bag { tags: s, count: x };
}
fn main() {
    let mut i: i64 = 0;
    while i < 5 {
        let b = make(i);
        if b.tags.contains(i) { println(b.count); } else { println(-1); }
        i = i + 1;
    }
    println(99);
}
