
struct Holder { name: String, id: i64 }
fn main() {
    let mut m: Map[i64, Holder] = Map.new();
    let h = Holder { name: f"holder payload padded out beyond thirty-six bytes {7}", id: 7 };
    m.insert(7, h);
    let mut total = 0;
    for (k, v) in m {
        total = total + k + v.id + (v.name.len() as i64);
    }
    println(total);
}
