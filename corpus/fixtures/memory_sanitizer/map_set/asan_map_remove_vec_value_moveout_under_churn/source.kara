
fn inner() -> i64 {
    let mut bucket: Map[i64, Vec[i64]] = Map.new();
    let mut i = 0i64;
    while i < 200 {
        let mut j = 0i64;
        while j < 20 {
            bucket.entry(i).or_insert(Vec.new()).push(i + j);
            j = j + 1;
        }
        i = i + 1;
    }
    let mut acc = 0i64;
    let mut k = 0i64;
    while k < 200 {
        match bucket.remove(k) {
            Some(indices) => {
                acc = acc + indices.len();
            },
            None => {},
        }
        k = k + 1;
    }
    acc
}
fn main() {
    let mut s = 0i64;
    let mut iter = 0i64;
    while iter < 20 {
        s = s + inner();
        iter = iter + 1;
    }
    println(s);
}
