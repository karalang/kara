#[derive(Hash, Eq)]
struct K20 { a: String, b: String }
fn mks20(n: i64) -> K20 { return K20 { a: f"aaaaaaaaaaaa{n}", b: f"bbbbbbbbbbbb{n}" }; }
fn main() {
    let mut m: Map[K20, i64] = Map.new();
    let mut i: i64 = 0;
    while i < 3 { m.insert(mks20(i), i); i = i + 1; }
    let mut j: i64 = 0;
    while j < 2 {
        match m.get(mks20(j)) { Some(v) => { println(f"g:{v}"); } None => { println("miss"); } }
        j = j + 1;
    }
    println(f"len:{m.len()}");
}