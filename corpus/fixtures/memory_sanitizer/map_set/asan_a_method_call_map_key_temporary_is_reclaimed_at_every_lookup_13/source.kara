
struct Mk { p: String }
impl Mk { fn make(ref self, n: i64) -> Array[i64, 2] {
    return [n, n + 1i64];
} }
fn main() {
    let mut m: Map[Array[i64, 2], i64] = Map.new();
    let g: Mk = Mk { p: f"x" };
    m.insert(g.make(0i64), 0i64);
    match m.get(g.make(0i64)) {
        Some(v) => { println(f"g:{v}"); } None => { println("missing"); }
    }
    println(f"len:{m.len()}");
}
