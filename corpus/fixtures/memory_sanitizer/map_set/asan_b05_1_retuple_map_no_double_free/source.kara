
fn main() {
    let mut round: i64 = 0;
    while round < 30 {
        let mut v: Vec[String] = Vec[
            "b05-retup-alpha-aaaaaaaaaaaaaaaaaaaaaaaaaa".to_string(),
            "b05-retup-bravo-bbbbbbbbbbbbbbbbbbbbbbbbbb".to_string()
        ];
        let r: Vec[(i64, String)] = v.iter().enumerate().map(|p| (p.0, p.1.clone())).filter(|q| q.0 >= 0).collect();
        println(f"{r.len()} {r[0].0} {r[1].0} {v.len()}");
        round = round + 1;
    }
}
