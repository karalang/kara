struct D { id: i64, name: String }
impl Drop for D { fn drop(mut ref self) { println(f"d{self.id}{self.name}") } }
fn mkd(n: i64) -> D { D { id: n, name: f"n{n}" } }
struct W { r: D, s: D, b: i64 }
struct X { w: W, t: D }
fn mkw(n: i64) -> W { W { r: mkd(n), s: mkd(n + 1), b: n } }
fn keep(d: own D) -> D { d }
fn retr(w: own W) -> D { w.r }
struct H { k: i64 }
impl H { fn f(ref self, w: own W) -> i64 { let k = keep(w.r); k.id } }
fn gk[T](w: own W, t: T) -> i64 { let k = keep(w.r); k.id }
fn keepf(w: own W) -> i64 { let k = keep(w.r); k.id }
fn keeps(w: own W) -> i64 { keep(w.s); w.b }
fn tup(w: own W) -> i64 { let t = (keep(w.r), 5); t.1 }
fn pushf(w: own W) -> i64 { let mut xs: Vec[D] = Vec.new(); xs.push(w.r); xs.len() }
fn aliasp(w: own W) -> i64 { let r = w.r; let mut xs: Vec[D] = Vec.new(); xs.push(r); xs.len() }
fn ins(w: own W) -> i64 { let mut m: Map[i64, D] = Map.new(); m.insert(w.b, w.r); m.len() }
fn hop2(x: own X) -> i64 { let k = keep(x.w.r); k.id }
fn main() {
    println(f"a{keepf(mkw(10))}");
    println(f"b{keeps(mkw(20))}");
    println(f"c{tup(mkw(30))}");
    println(f"e{pushf(mkw(40))}");
    println(f"f{aliasp(mkw(50))}");
    println(f"g{ins(mkw(60))}");
    println(f"h{hop2(X { w: mkw(70), t: mkd(79) })}");
    let w = mkw(80);
    println(f"i{keepf(w)}");
    let v = mkw(90);
    println(f"j{pushf(v)}");
    let d = retr(mkw(100));
    println(f"k{d.id}");
    let h = H { k: 0 };
    println(f"l{h.f(mkw(110))}");
    println(f"m{gk(mkw(120), 1)}");
    println("end")
}
