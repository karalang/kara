fn mk() -> Fn(i64) -> i64 { |x: i64| x + 1 }
fn mks() -> Fn(String) -> i64 { |s: String| s.len() }
fn mkc(k: i64) -> Fn(i64) -> i64 { |x: i64| x + k }
fn pick(b: bool) -> Fn(i64) -> i64 { if b { |x: i64| x * 2 } else { |x: i64| x * 3 } }
fn main() {
    let g = mk();
    println(f"a {g(4)} {g(5)}");
    let h = mks();
    println(f"b {h("ab".to_string() + "-heap-string-long-enough")}");
    let c = mkc(10);
    println(f"c {c(1)}");
    let p = pick(true);
    let q = pick(false);
    println(f"d {p(5)} {q(5)}");
    println("end")
}