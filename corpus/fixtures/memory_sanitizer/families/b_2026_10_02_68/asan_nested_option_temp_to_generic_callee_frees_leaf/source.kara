struct R { id: i64, s: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, s: f"heap-string-longer-than-sso-{i}" } }
fn cls[T](x: own Option[Option[T]]) -> i64 {
    match x {
        Some(inner) => 7,
        None => 0,
    }
}
fn clsw[T](x: own Option[Option[T]]) -> i64 {
    match x {
        Some(_) => 6,
        None => 0,
    }
}
fn bare[T](x: own Option[T]) -> i64 {
    match x {
        Some(inner) => 5,
        None => 0,
    }
}
fn cnt[T](x: own Option[(T, i64)]) -> i64 {
    match x {
        Some(t) => t.1,
        None => 0,
    }
}
fn main() {
    println(cls(Some(Some(mk(1)))));
    println(clsw(Some(Some(mk(2)))));
    println(bare(Some(Some(mk(3)))));
    println(cnt(Some((mk(4), 4))));
    println("end");
}
