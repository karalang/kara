enum G[T] { Y(T), N }
fn mka(s: String) -> Array[String, 2] { return [s, f"{s}{s}"] }
fn wrap(g: G[Array[String, 2]]) -> Option[Array[String, 2]] { match g { G.Y(x) => { return Some(x) } G.N => { return None } } }
fn wrapy(g: G[Array[String, 2]]) -> Option[Array[String, 2]] { match g { G.Y(x) => { let y = x; return Some(y) } G.N => { return None } } }
fn main() {
    match wrap(G.Y(mka(f"ab"))) { Some(a) => println(f"wrap {a[1]}"), None => println("none") }
    match wrapy(G.Y(mka(f"cd"))) { Some(a) => println(f"wrapy {a[1]}"), None => println("none") }
    println("end")
}