enum G[T] { Y(T), N }
struct D { s: String }
impl Drop for D { fn drop(mut ref self) { println(f"  d{self.s}") } }
fn mka(s: String) -> Array[String, 2] { return [s, f"{s}{s}"] }
fn eats(a: Array[String, 2]) -> i64 { return a[1].len() }
fn rebind(g: G[Array[String, 2]]) -> i64 { match g { G.Y(x) => { let y = x; return y[0].len() } G.N => { return 0 } } }
fn typed(g: G[Array[String, 2]]) -> i64 { match g { G.Y(x) => { let y: Array[String, 2] = x; return y[0].len() } G.N => { return 0 } } }
fn chain(g: G[Array[String, 2]]) -> i64 { match g { G.Y(x) => { let y = x; let z = y; return z[1].len() } G.N => { return 0 } } }
fn noret(g: G[Array[String, 2]]) -> i64 { match g { G.Y(x) => { let y = x; println(f"  {y[0].len()}") } G.N => {} }; return 9 }
fn iflet(g: G[Array[String, 2]]) -> i64 { if let G.Y(x) = g { let y = x; return y[0].len() } return 0 }
fn whilelet(g: G[Array[String, 2]]) -> i64 { let mut k = 0; let mut h = g; while let G.Y(x) = h { let y = x; k = y[0].len(); h = G.N; } return k }
fn local() -> i64 { let g = G.Y(mka(f"ab")); match g { G.Y(x) => { let y = x; return y[0].len() } G.N => { return 0 } } }
fn vecs(g: G[Array[Vec[i64], 2]]) -> i64 { match g { G.Y(x) => { let y = x; return y[0].len() } G.N => { return 0 } } }
fn drops(g: G[Array[D, 2]]) -> i64 { match g { G.Y(x) => { let y = x; return y[0].s.len() } G.N => { return 0 } } }
fn eat(g: G[Array[String, 2]]) -> i64 { match g { G.Y(x) => { let y = x; return eats(y) } G.N => { return 0 } } }
fn ret(g: G[Array[String, 2]]) -> Array[String, 2] { match g { G.Y(x) => { let y = x; return y } G.N => { return mka(f"q") } } }
fn push(g: G[Array[String, 2]]) -> i64 { let mut v: Vec[Array[String, 2]] = []; match g { G.Y(x) => { let y = x; v.push(y) } G.N => {} }; return v.len() }
fn main() {
    println(f"rebind {rebind(G.Y(mka(f"ab")))}")
    println(f"typed {typed(G.Y(mka(f"ab")))}")
    println(f"chain {chain(G.Y(mka(f"ab")))}")
    println(f"noret {noret(G.Y(mka(f"ab")))}")
    println(f"iflet {iflet(G.Y(mka(f"ab")))}")
    println(f"whilelet {whilelet(G.Y(mka(f"ab")))}")
    println(f"local {local()}")
    println(f"vecs {vecs(G.Y([[1, 2], [3]]))}")
    println("drops")
    let n = drops(G.Y([D { s: f"1" }, D { s: f"22" }]));
    println(f"  {n}")
    println(f"eat {eat(G.Y(mka(f"ab")))}")
    let a = ret(G.Y(mka(f"cd")));
    println(f"ret {a[1]}")
    println(f"push {push(G.Y(mka(f"ab")))}")
    println("end")
}