
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}") } }
struct S { r: R, s: String }
fn mk(i: i64) -> S { S { r: R { id: i }, s: f"heap-string-longer-than-sso-{i}" } }
enum E { A(R), B }
struct H { k: i64 }
impl H { fn rb(ref self, a: own S) -> i64 { let mut c = a; c = mk(90); println("im"); self.k } }
fn ro(a: Option[S]) -> i64 { let mut c = a; c = Some(mk(91)); println("io"); 1 }
fn rr(a: own R) -> i64 { let mut c = a; c = R { id: 92 }; println("ir"); 2 }
fn rs(a: own S) -> i64 { let mut c = a; println("mid"); c = mk(93); println("is"); 3 }
fn re(a: own E) -> i64 { let mut c = a; c = E.A(R { id: 94 }); println("ie"); 4 }
fn rq(a: Result[S, i64]) -> i64 { let mut c = a; c = Ok(mk(95)); println("iq"); 6 }
fn rv(a: own Vec[R]) -> i64 { let mut c = a; c = vec![R { id: 96 }]; println("iv"); c.len() }
fn rg[T](a: own T, b: own T) -> i64 { let mut c = a; c = b; println("ig"); 7 }
fn rp(a: own S) -> i64 { let mut v: Vec[S] = Vec.new(); v.push(a); 8 }
fn main() {
    let a: Option[S] = Some(mk(1));
    println(f"k{ro(a)}");
    println(f"k{ro(Some(mk(2)))}");
    let b = R { id: 3 };
    println(f"k{rr(b)}");
    println(f"k{rr(R { id: 4 })}");
    let c = mk(5);
    println(f"k{rs(c)}");
    println(f"k{rs(mk(6))}");
    let d = E.A(R { id: 7 });
    println(f"k{re(d)}");
    println(f"k{re(E.A(R { id: 8 }))}");
    let e: Result[S, i64] = Ok(mk(9));
    println(f"k{rq(e)}");
    println(f"k{rq(Ok(mk(10)))}");
    let f: Vec[R] = vec![R { id: 11 }];
    println(f"k{rv(f)}");
    println(f"k{rv(vec![R { id: 12 }])}");
    let g = mk(13);
    println(f"k{rg(g, mk(14))}");
    println(f"k{rg(mk(15), mk(16))}");
    let h = H { k: 5 };
    let m = mk(17);
    println(f"k{h.rb(m)}");
    println(f"k{h.rb(mk(18))}");
    println(f"k{rp(mk(19))}");
    println("end")
}
