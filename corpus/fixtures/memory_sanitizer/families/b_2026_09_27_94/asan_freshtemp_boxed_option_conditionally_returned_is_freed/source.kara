
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}") } }
struct S { r: R, s: String }
fn mk(i: i64) -> S { S { r: R { id: i }, s: f"heap-string-longer-than-sso-{i}" } }
struct H { n: i64 }
impl H {
    fn mf(ref self, a: own Option[S], c: bool) -> Option[S] { if c { a } else { None } }
    fn sf(a: own Option[S], c: bool) -> Option[S] { if c { a } else { None } }
}
struct W { o: Option[S], n: i64 }
fn mf(a: own Option[S], c: bool) -> Option[S] { if c { a } else { None } }
fn me(a: own Option[S], c: bool) -> Option[S] { if c { return a } println("in"); None }
fn mw(a: own Option[S], c: bool) -> W { if c { W { o: a, n: 1 } } else { W { o: None, n: 2 } } }
fn show(o: own Option[S]) { match o { Some(v) => println(f"got{v.r.id}"), None => println("none") } }
fn main() {
    let h = H { n: 0 };
    show(mf(Some(mk(1)), true));
    show(mf(Some(mk(2)), false));
    let b: Option[S] = Some(mk(3));
    show(mf(b, false));
    show(h.mf(Some(mk(4)), true));
    show(h.mf(Some(mk(5)), false));
    show(H.sf(Some(mk(6)), false));
    show(me(Some(mk(7)), false));
    show(mf(mf(Some(mk(8)), true), false));
    let w = mw(Some(mk(9)), false);
    println(f"w{w.n}");
    let mut i = 10;
    while i < 12 { show(mf(Some(mk(i)), i == 11)); i += 1; }
    println("end")
}
