struct R { id: i64, s: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, s: f"heap-string-longer-than-sso-{i}" } }
fn leaf[T](x: own Result[Option[T], i64]) -> i64 { match x { Ok(Some(w)) => 1, Ok(None) => 2, Err(e) => e } }
fn env[T](x: own Result[Option[T], i64]) -> i64 { match x { Ok(o) => 3, Err(e) => e } }
fn any[T](x: own Result[Option[T], i64]) -> i64 { match x { Ok(_) => 4, Err(e) => e } }
fn main() {
    println(leaf(Ok(Some(mk(1)))));
    println(env(Ok(Some(mk(2)))));
    println(any(Ok(Some(mk(3)))));
    let a: Result[Option[R], i64] = Ok(Some(mk(4)));
    println(leaf(a));
    let b: Result[Option[R], i64] = Ok(None);
    println(leaf(b));
    println(env(Err(6)));
    println("end");
}
