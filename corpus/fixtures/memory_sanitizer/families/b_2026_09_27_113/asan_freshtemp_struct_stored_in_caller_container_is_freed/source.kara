
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}") } }
struct S { r: R, s: String }
fn mk(i: i64) -> S { S { r: R { id: i }, s: f"heap-string-longer-than-sso-{i}" } }
struct B { v: Vec[S] }
impl B { fn put(mut ref self, a: own S) { self.v.push(a) } }
fn rb(b: mut ref B, a: own S) -> i64 { b.v.push(a); 5 }
fn rw[T](b: mut ref Vec[T], a: own T) -> i64 { b.push(a); 6 }
fn main() {
    let mut b = B { v: Vec.new() };
    println(f"k{rb(mut b, mk(1))}");
    let x = mk(2);
    println(f"k{rb(mut b, x)}");
    b.put(mk(3));
    let y = mk(4);
    b.put(y);
    let mut w: Vec[S] = Vec.new();
    println(f"k{rw(mut w, mk(5))}");
    println(f"n{b.v.len()} {w.len()}");
    println("end")
}
