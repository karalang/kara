struct R { id: i64, s: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, s: f"heap-string-longer-than-sso-{i}" } }
fn ret(x: own Result[Option[R], i64]) -> Option[R] { match x { Ok(o) => o, Err(e) => None } }
fn mo(x: own Result[Option[R], i64], vo: mut ref Vec[Option[R]]) -> i64 { match x { Ok(o) => { vo.push(o); 1 } Err(e) => e } }
fn io(x: own Result[Option[R], i64], vo: mut ref Vec[Option[R]]) -> i64 { if let Ok(o) = x { vo.push(o); return 1 } return 0 }
fn lo(x: own Result[Option[R], i64], vo: mut ref Vec[Option[R]]) -> i64 { let Ok(o) = x else { return 0 }; vo.push(o); return 1 }
fn main() {
    let r = ret(Ok(Some(mk(1))));
    println(r.is_some());
    let mut vo: Vec[Option[R]] = Vec.new();
    println(mo(Ok(Some(mk(2))), mut vo));
    println(io(Ok(Some(mk(3))), mut vo));
    println(lo(Ok(Some(mk(4))), mut vo));
    let a: Result[Option[R], i64] = Ok(Some(mk(5)));
    match a { Ok(o) => vo.push(o), Err(e) => println(e) }
    println(vo.len());
    println("end");
}
