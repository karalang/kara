fn pick[T](a: own Option[T], d: own T) -> T { match a { Some(x) => x, None => d } }
fn main() {
    let s = f"heap-string-longer-than-sso-{1}";
    let a: Option[Array[i64, 2]] = None;
    let r = pick(a, [3, 4]);
    let e: Option[Array[Array[i64, 2], 2]] = Some([[7, 8], [9, 10]]);
    let g = pick(e, [[0, 0], [0, 0]]);
    println(f"{s} {r[0]}{r[1]} {g[0][1]}{g[1][0]}");
}
