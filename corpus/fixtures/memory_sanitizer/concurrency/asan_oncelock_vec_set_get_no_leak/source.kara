
fn main() {
    let mut i: i64 = 0i64;
    let mut total: i64 = 0i64;
    while i < 40i64 {
        let cell: OnceLock[Vec[i64]] = OnceLock.new();
        let mut v: Vec[i64] = Vec.new();
        v.push(1i64);
        v.push(2i64);
        match cell.set(v) { Ok(_) => {}, Err(_) => {}, }
        match cell.get() { Some(g) => { total = total + g.len(); }, None => {}, }
        i = i + 1;
    }
    println(total.to_string());
}
