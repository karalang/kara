
fn main() {
    let (tx, rx): (Sender[String], Receiver[String]) = Channel.new();
    tx.send("first");
    let tx2 = tx.clone();
    tx2.send("second");
    println(rx.recv().unwrap());
    println(rx.recv().unwrap());
    match rx.try_recv() {
        Some(v) => println(v),
        None => println("drained"),
    }
}
