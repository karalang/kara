
import std.sync.{Receiver, Sender, TaskGroup, TaskHandle};

fn worker(tx: own Sender[i64]) -> i64 {
    let _ = tx.send(42);
    0
}
fn main() {
    let (tx, rx): (Sender[i64], Receiver[i64]) = channel(1);
    let g = TaskGroup.new();
    let h: TaskHandle[i64] = g.spawn(|| worker(tx));
    h.join();
    println(rx.recv().unwrap());
}
