struct Q { b: i64, c: i64 }
fn seed() -> i64 { env.args().len() }
fn mkq(n: i64) -> Q { return Q { b: n, c: seed() }; }
impl Q { fn take(self) -> i64 { return self.b; } }
fn go() -> i64 {
  let (k, t) = par { let k = seed() * 0i64; let t = mkq(9); (k, t) };
  let mut i = 0i64;
  while i < 3i64 { t.take(); i = i + 1; }
  return t.b + k; }
fn main() { println(go()); }
