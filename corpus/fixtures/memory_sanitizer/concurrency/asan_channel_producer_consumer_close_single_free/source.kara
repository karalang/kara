
import std.sync.{Receiver, Sender, TaskGroup, TaskHandle};

fn producer(tx: own Sender[i64]) -> i64 {
    let _ = tx.send(10);
    let _ = tx.send(20);
    0
}
fn consume(rx: Receiver[i64]) -> i64 {
    let mut sum = 0;
    while let Some(v) = rx.recv() {
        sum = sum + v;
    }
    sum
}
fn main() {
    let (tx, rx): (Sender[i64], Receiver[i64]) = channel(2);
    let g = TaskGroup.new();
    let h: TaskHandle[i64] = g.spawn(|| producer(tx));
    println(consume(rx));
    h.join();
}
