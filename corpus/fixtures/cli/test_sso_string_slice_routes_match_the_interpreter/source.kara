fn main() {
    let s = "the quick brown fox jumps over the lazy dog, twice over";
    let a = s[0..23];
    let b = s[0..24];
    println(f"1 {a.len()} [{a}]");
    println(f"2 {b.len()} [{b}]");
    let e = s[7..7];
    let full = s[0..s.len()];
    println(f"3 {e.len()} {full == s}");
    let d = full.clone();
    println(f"4 {d == full} {d.len() == full.len()}");
    let mut g = s[10..40];
    g.push_str("-grown");
    println(f"5 {g.len()} [{g}]");
    let mut v: Vec[String] = Vec.new();
    let mut i = 0;
    while i < 8 { v.push(s[i..(i + 30)]); i = i + 1; }
    println(f"6 {v.len()} {v[0].len()} [{v[7]}]");
    let m = "h\u{e9}llo w\u{f6}rld, a string long enough to need the heap";
    println(f"7 [{m[0..1]}] [{m[1..3]}] {m[0..m.len()].len()}");
    println("end");
}
