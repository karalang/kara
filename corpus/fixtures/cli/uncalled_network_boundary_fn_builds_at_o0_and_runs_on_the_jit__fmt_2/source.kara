fn handle_ws(ws: WebSocket) {
    let mut buf: Array[u8, 64] = [0u8; 64];
    loop {
        let r = ws.recv_text(mut buf);
        match r {
            Result.Ok(n) => { if n == 0 { break; } let _s = ws.send_text(buf); }
            Result.Err(_) => { break; }
        }
    }
}
fn simple(ws: WebSocket) { println("h"); }
#[allow(unstable_api)]
fn mk(fd: i64) -> Result[WebSocket, i64] { return Result.Ok(WebSocket.from_fd(fd)); }
fn main() { match mk(-1) { Result.Ok(ws) => { simple(ws); } Result.Err(_) => {} } println("end"); }
