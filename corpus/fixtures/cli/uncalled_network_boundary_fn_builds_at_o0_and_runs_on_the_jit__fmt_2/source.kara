fn handle_ws(ws: own WebSocket) {
    let mut ws = ws;
    loop {
        match ws.recv() {
            Ok(WsMessage.Text(t)) => { let _s = ws.send_text(t); }
            Ok(WsMessage.Close(_)) => { break; }
            Ok(_) => {}
            Err(_) => { break; }
        }
    }
}
fn simple(ws: WebSocket) { println("h"); }
fn mk() -> Result[WebSocket, NetError] { let l = TcpListener.bind("256.0.0.1:0")?; WebSocket.accept(l) }
fn main() { match mk() { Result.Ok(ws) => { simple(ws); } Result.Err(_) => {} } println("end"); }
