struct Conn { id: i64 }
impl Drop for Conn { fn drop(mut ref self) { println(7); } }
fn serve_one(ws: WebSocket, c: Conn, go: bool) {
    let mut buf: Array[u8, 16] = [0u8; 16];
    if go { let _x = ws.recv_text(mut buf); }
    println(1);
}
#[allow(unstable_api)]
fn main() {
    let c = Conn { id: 0 };
    let ws = WebSocket.from_fd(-1);
    serve_one(ws, c, false);
    println(2);
}
