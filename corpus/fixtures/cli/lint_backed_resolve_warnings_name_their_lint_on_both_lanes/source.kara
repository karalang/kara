struct Entity { x: i64, y: i64, z: i64 }
         layout entities: Vec[Entity] {
             group pos { x, y }
         }
         fn main() {
             let mut entities: Vec[Entity] = Vec.new();
             entities.push(Entity { x: 1, y: 2, z: 3 });
             println(entities[0].x);
         }
