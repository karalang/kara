fn slow_left() -> i64 {
    for i in 0..20000 {  }
    eprintln("E-left-1");
    println("O-left-1");
    eprintln("E-left-2");
    1
}
fn fast_right() -> i64 {
    eprintln("E-right-1");
    println("O-right-1");
    eprintln("E-right-2");
    2
}
fn main() {
    let (a, b) = par { slow_left(), fast_right(), };
    println(f"O-sum-{a + b}");
    eprintln(f"E-sum-{a + b}");
}
