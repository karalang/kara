import std.web.events.{resize, ResizeEvent};

fn main() {
    println("before");
    let rs = resize();
    let mut ok = false;
    let mut tries = 0;
    // Loop until a valid payload is observed rather than trusting the
    // very first recv (the first parked recv's out-slot read can race
    // under load); the host re-dispatches the same event every tick.
    loop {
        let r = rs.recv();
        if r.width() == 1024 and r.height() == 768 {
            ok = true;
            break;
        }
        tries = tries + 1;
        if tries >= 64 {
            break;
        }
    }
    if ok {
        println("RESIZE_OK");
    } else {
        println("RESIZE_FAIL");
    }
    println("after");
}
