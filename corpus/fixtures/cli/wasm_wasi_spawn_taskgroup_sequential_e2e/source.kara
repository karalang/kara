
fn worker(id: i64) {
    println(id);
}

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn main() {
    let h: TaskHandle[i64] = spawn(|| add(40, 2));
    let r: i64 = h.join();
    println(r);

    let mut tg = TaskGroup.new();
    tg.spawn(|| worker(1));
    tg.spawn(|| worker(2));
    tg.spawn(|| worker(3));
    tg.spawn(|| worker(4));
    tg.spawn(|| worker(5));
    println(0);
}
