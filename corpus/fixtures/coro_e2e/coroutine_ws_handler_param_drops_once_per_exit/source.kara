
            fn main() {
                let listener: TlsListener = TlsListener.bind_tls("127.0.0.1:0", "c", "k").unwrap();
                let mut tg: TaskGroup = TaskGroup.new();
                loop {
                    match WebSocket.accept_tls(listener) {
                        Result.Ok(ws) => { tg.spawn(|| handle_ws(ws)); }
                        Result.Err(_) => {}
                    }
                }
            }
        