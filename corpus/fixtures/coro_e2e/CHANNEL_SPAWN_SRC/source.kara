
        fn serve_one(listener: own TcpListener, tx: own Sender[i64]) {
            let _stream = listener.accept().unwrap();
            let _ = tx.send(7);
        }
        fn main() {
            let listener = TcpListener.bind("127.0.0.1:0").unwrap();
            let (tx, rx): (Sender[i64], Receiver[i64]) = channel(1);
            let g = TaskGroup.new();
            g.spawn(|| serve_one(listener, tx));
            let v: i64 = rx.recv().unwrap();
            println(v);
        }
    
