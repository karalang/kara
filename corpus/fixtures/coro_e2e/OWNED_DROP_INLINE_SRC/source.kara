
        struct Conn { id: i64 }
        impl Drop for Conn {
            fn drop(mut ref self) { println(self.id); }
        }
        fn serve_one(listener: own TcpListener, c: own Conn) {
            let _stream = listener.accept().unwrap();
            println(1);
        }
        fn main() {
            let listener = TcpListener.bind("127.0.0.1:0").unwrap();
            let c = Conn { id: 7 };
            serve_one(listener, c);
            println(2);
        }
    