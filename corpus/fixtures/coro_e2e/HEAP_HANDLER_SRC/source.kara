
        fn serve_buf(listener: own TcpListener) {
            let mut buf: Vec[i64] = Vec.new();
            buf.push(1);
            buf.push(2);
            buf.push(3);
            let _stream = listener.accept().unwrap();
            println(buf.len());
        }
        fn main() {
            let listener = TcpListener.bind("127.0.0.1:0").unwrap();
            serve_buf(listener);
            println(2);
        }
    