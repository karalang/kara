
fn main() with sends(Network) receives(Network) {{
    let url: String = "{url}";
    let c = Client.new();
    match c.get(url) {{
        Ok(resp) => {{
            let b: Vec[u8] = resp.bytes();
            println(b.len());
        }}
        Err(e) => {{
            println("ERR");
            println(e.message());
        }}
    }}
}}
