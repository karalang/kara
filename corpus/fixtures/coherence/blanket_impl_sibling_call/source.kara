trait Shout {
    fn tag(self) -> String;
    fn shout(self, n: i64) -> String { let mut s = self.tag(); let mut i = 1; while i < n { s = s + "!"; i += 1; } s }
}
impl[T: Display] Shout for T { fn tag(self) -> String { f"<{self}>" } }
struct P { x: i64 }
impl Display for P { fn to_string(self) -> String { f"P{self.x}" } }
impl P { fn tag(self) -> String { "inherent".to_string() } }
fn go[U: Shout](u: U) -> String { u.shout(3) }
fn main() { println(go(3)); println("hi".to_string().shout(2)); println(P { x: 1 }.shout(2)); println(go(P { x: 2 })); }
