
import std.tracing.{Log};

effect resource Log;
fn helper(n: i64) -> i64 writes(Log) { n + 1 }
struct Pair { a: i64, b: i64 }
fn main() {
    par {
        {
            let p = Pair { a: 1, b: 2 };
            let r1 = p.a;
            let r2 = p.b;
            let r3 = helper(p.a);
            let r4 = p.a;
            r4
        },
        {
            let q = Pair { a: 3, b: 4 };
            let s1 = q.b;
            let s2 = q.a;
            let s3 = helper(q.b);
            s3
        },
    };
}
