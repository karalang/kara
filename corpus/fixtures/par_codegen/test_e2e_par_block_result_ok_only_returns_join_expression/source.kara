
fn maybe_ok(v: i64) -> Result[i64, i64] { Ok(v) }
fn main() {
    let r: Result[i64, i64] = {
        let (r1, r2): (Result[i64, i64], Result[i64, i64]) = par {
        maybe_ok(10_i64),
        maybe_ok(20_i64),
    };
        Ok(7_i64)
    };
    match r {
        Ok(v) => println(v),
        Err(e) => println(e),
    }
}
