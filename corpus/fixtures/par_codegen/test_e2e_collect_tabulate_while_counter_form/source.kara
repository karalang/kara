
fn main() {
    let n: i64 = 500i64;
    let mut out: Vec[i64] = Vec.new();
    let mut c: i64 = 0i64;
    #[par_order_free]
    while c < n {
        out.push(c * 3i64);
        c = c + 1i64;
    }
    let mut ok: i64 = 1i64;
    let mut i: i64 = 0i64;
    while i < out.len() {
        if out[i] != i * 3i64 { ok = 0i64; }
        i = i + 1i64;
    }
    println(out.len());
    println(ok);
}
