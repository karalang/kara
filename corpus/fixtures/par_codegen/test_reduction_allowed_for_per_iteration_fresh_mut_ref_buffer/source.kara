
fn fill(out: mut ref Vec[i64], i: i64) -> i64 {
    let mut s = 0i64;
    let mut k = 0i64;
    while k < 40i64 { out[k] = (i + k) % 13i64; s = s + out[k]; k = k + 1i64; }
    return s;
}
fn main() {
    let mut sum = 0i64;
    let mut i = 0i64;
    while i < 100000i64 {
        let mut buf: Vec[i64] = Vec.new();
        let mut t = 0i64;
        while t < 40i64 { buf.push(0i64); t = t + 1i64; }
        sum = sum + fill(mut buf, i);
        i = i + 1i64;
    }
    println(sum);
}
