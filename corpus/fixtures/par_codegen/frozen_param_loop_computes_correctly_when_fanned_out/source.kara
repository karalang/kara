
shared struct S { val: i64 }
fn heavy(s: frozen S, k: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut t: i64 = 0;
    while t < 2000 { acc = acc + s.val * k + t; t = t + 1; }
    acc
}
fn run(s: frozen S) -> i64 {
    let mut out: Vec[i64] = Vec.filled(2048, 0);
    for i in 0..2048 {
        out[i] = heavy(s, i);
    }
    out[10]
}
fn main() {
    let s = S { val: 3 };
    println(run(s));
}
