
shared struct Node { val: i64, kids: Vec[Node] }
fn sum(n: frozen Node) -> i64 {
    let mut s: i64 = n.val;
    for k in n.kids { s = s + sum(k); }
    return s;
}
fn main() {
    let l1 = Node { val: 3, kids: [] };
    let l2 = Node { val: 4, kids: [] };
    let mid = Node { val: 2, kids: [l1, l2] };
    let root = Node { val: 1, kids: [mid] };
    let g = freeze root;
    let (a, b) = par {
        let a = sum(g);
        let b = sum(g);
        (a, b)
    };
    println(a + b);
}
