
fn compute_a(n: i64) -> i64 {
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        sum = sum + i;
        i = i + 1;
    }
    sum
}
fn compute_b(n: i64) -> i64 {
    let mut prod: i64 = 1;
    let mut i: i64 = 1;
    while i <= n {
        prod = prod + i * i;
        i = i + 1;
    }
    prod
}
fn main() {
    let n: i64 = 10;
    let m: i64 = 5;
    let total = par {
        let a = compute_a(n);
        let b = compute_b(n);
        let c = compute_a(m);
        let d = compute_b(m);
        a + b + c + d
    };
    println(total);
}
