
fn main() {
    let mut hits: Vec[i64] = Vec.new();
    #[par_order_free]
    for k in 0i64..1000i64 {
        if (k % 3i64) == 0i64 {
            hits.push(k);
        }
    }
    let mut s: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < hits.len() {
        s = s + hits[i];
        i = i + 1i64;
    }
    println(hits.len());
    println(s);
}
