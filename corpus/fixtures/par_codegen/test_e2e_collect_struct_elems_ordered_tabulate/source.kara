
struct P { a: f64, b: i64 }
fn main() {
    let mut out: Vec[P] = Vec.new();
    #[par_order_free]
    for k in 0i64..1000i64 {
        out.push(P { a: (k as f64) * 0.5, b: k * 2i64 });
    }
    let mut order_ok: i64 = 1i64;
    let mut i: i64 = 0i64;
    while i < out.len() {
        if out[i].b != i * 2i64 {
            order_ok = 0i64;
        }
        i = i + 1i64;
    }
    println(out.len());
    println(order_ok);
    println((out[501].a * 2.0) as i64);
}
