
#[derive(Copy)]
struct W { f0: i64, f1: i64, f2: i64, f3: i64 }
fn get(v: ref Vec[W], k: i64) -> Option[W] {
    let mut i = 0;
    while i < v.len() { if v[i].f0 == k { return Some(v[i]); } i = i + 1; }
    return None;
}
fn first(o: Option[W]) -> i64 { match o { Some(p) => p.f1, None => -1 } }
fn main() {
    let mut ns: Vec[W] = Vec.new();
    ns.push(W { f0: 5, f1: 1111, f2: 2222, f3: 3333 });
    let a = get(ns, 5);
    let b = get(ns, 9);
    println(f"{first(a)} {first(b)}");
}
