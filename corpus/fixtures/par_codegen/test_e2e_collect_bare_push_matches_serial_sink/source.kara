
fn main() {
    let mut results: Vec[i64] = Vec.new();
    #[par_order_free]
    for k in 0i64..1000i64 {
        results.push(k);
    }
    let mut s: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < results.len() {
        s = s + results[i];
        i = i + 1i64;
    }
    println(results.len());
    println(s);
}
