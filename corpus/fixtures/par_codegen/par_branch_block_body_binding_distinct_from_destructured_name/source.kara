
fn main() {
    let (outer_left, outer_right) = {
        let (branch_a, branch_b) = par {
        { let mut va: Map[i64, i64] = Map.new(); let _ = va.insert(1, 2); va.len() },
        { let s: String = "abcd".to_string(); s.len() },
    };
        (branch_a, branch_b)
    };
    println(outer_left + outer_right);
}
