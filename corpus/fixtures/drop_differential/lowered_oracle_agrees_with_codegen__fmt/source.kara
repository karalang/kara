struct P { tag: i64, name: String, items: Vec[String] }
fn main() { let p: P = P { tag: 1i64, name: "payload_bytes_kept_comfortably_long_enough_x".to_string(), items: Vec["payload_bytes_kept_comfortably_long_enough_x".to_string()] }; let P { tag, name, items } = p; println(tag + name.len() + items.len()); }