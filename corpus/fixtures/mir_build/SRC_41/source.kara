fn f(c: bool, y: u128) -> u128 {
    let x = if c { 0 } else { y };
    x
}

fn g(k: i64, y: u8) -> u8 {
    let z = match k { 0 => 255, 1 => y, _ => { 7 } };
    z
}

fn main() {
    let y: u8 = 7;
    let z: u8 = if true { 1 } else { y };
    println(f"{f(true, 5)} {f(false, 5)} {z} {g(0, 3)} {g(1, 3)} {g(2, 3)}");
}
