
fn third() -> f32 {
    1.0 / 3.0
}

fn half(x: f32) -> f32 {
    x * 0.5
}

fn main() {
    let c: f32 = 0.1;
    let d: f32 = 1.0 / 3.0;
    let e: f32 = 2.0 * 3.0 - 0.25;
    let n: f32 = -(1.0 / 8.0);
    let h: f64 = 1.0 / 4.0;
    println(c);
    println(d);
    println(e);
    println(n);
    println(h);
    println(third());
    println(half(1.0 / 3.0));
    let v: Vec[f32] = [1.0 / 3.0, 0.5];
    println(v[0] + v[1]);
    let o: Option[f32] = Some(1.0 / 4.0);
    println(o.unwrap());
}
