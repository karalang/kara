fn main() {
    let days: Vec[char] = vec!['a', 'b', ','];
    let mut s = String.new();
    for c in days.iter() {
        s.push(c);
    }
    println(s);
    let t = "x,y,ab";
    let owned = String.from("ba,c");
    for c in days.iter() {
        let sep = c.to_string();
        println(f"{t.find(c.to_string())} {t.split(sep.as_str()).count()} {owned.find(c.to_string())} {owned.split(sep.as_str()).count()}");
    }
}
