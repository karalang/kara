fn pick(v: Vec[String], i: i64) -> Option[Str] {
    if i < v.len() { Some(v[i].as_str()) } else { None }
}

fn main() {
    let v = ["x".to_string()];
    let a = pick(v, 0) ?? "none";
    let b = pick(v, 5) ?? "none";
    let o: Option[String] = None;
    let c = o ?? "owned";
    println(f"{a} {b} {c} {c.len()}");
}
