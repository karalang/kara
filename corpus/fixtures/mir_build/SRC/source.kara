
fn morse(word: String) -> String {
    let codes = [".-", "-...", "-.-.", "-.."];
    let mut out = String.new();
    for b in word.bytes() { out.push_str(codes[(b - 97) as i64]); }
    out
}
fn step(k: i64) -> i64 {
    let d = [1, 0, -1, 0];
    d[k] + d.len() as i64
}
fn grown() -> Vec[String] {
    let mut t = ["x", "y"];
    t.push("z".to_string());
    t
}
fn main() {
    let mut n = 0;
    for i in 0..1000 { n = n + morse("abcd".to_string()).len() + step(i % 4); }
    println(f"{n} {morse("dcba".to_string())} {grown().len()}");
}
