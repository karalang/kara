
fn main() {
    let b: Vec[i64] = vec![104, 105, 55296];
    let mut s = String.new();
    for x in b.iter() {
        match char.try_from(x) {
            Ok(c) => s.push(c),
            Err(n) => s.push_str(f"<{n}>"),
        }
    }
    let u: Vec[u32] = vec![79, 75];
    for y in u.iter() {
        s.push(char.try_from(y).unwrap());
    }
    let w: Vec[u8] = vec![33];
    for z in w.iter() {
        s.push(char.try_from(z).unwrap());
    }
    println(s);
}
