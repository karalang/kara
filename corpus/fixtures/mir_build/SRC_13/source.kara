fn main() {
    let mut nums: Vec[i64] = vec![1, 4, 3, 2];
    nums.sort();
    let s: i64 = nums.chunks(2).iter().map(|pair| pair[0]).sum();
    let v = vec![1, 2, 3, 4, 5];
    let c = v.chunks(2);
    for w in v.windows(2) {
        println(f"{w[0]} {w[1]}");
    }
    println(f"{s} {c.len()} {c[2].len()} {v.windows(6).len()}");
}
