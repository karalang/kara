
fn main() with sends(Network) receives(Network) {
    let c = Client.new();
    let url = "http://127.0.0.1:65535/";
    match c.get(url) {
        Ok(resp) => {
            let hs: Vec[(String, String)] = resp.headers();
            println(hs.len());
        }
        Err(e) => {
            println(e.message());
        }
    }
}
