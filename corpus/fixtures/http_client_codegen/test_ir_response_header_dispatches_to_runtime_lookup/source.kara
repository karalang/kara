
fn main() with sends(Network) receives(Network) {
    let c = Client.new();
    let url = "http://127.0.0.1:65535/";
    match c.get(url) {
        Ok(resp) => {
            match resp.header("x-custom") {
                Some(v) => println(v),
                None => println("none"),
            }
        }
        Err(e) => {
            println(e.message());
        }
    }
}
