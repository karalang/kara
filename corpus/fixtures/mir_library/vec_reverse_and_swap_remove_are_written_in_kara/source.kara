
fn main() {
    let mut v: Vec[String] = Vec.new();
    v.push("a"); v.push("b"); v.push("c"); v.push("d");
    v.reverse();
    println(v.join(","));
    let x = v.swap_remove(0);
    println(f"{x} {v.join(",")} {v.is_empty()}");
    let mut e: Vec[i64] = Vec.new();
    e.reverse();
    println(e.is_empty());
}
