{IDX}fn main() {{
    let mut w: Vec[Vec[i64]] = [[1, 2], [3, 4]];
    w[idx(1)][idx(0)] += val(2);
    println("--");
    let mut u: Vec[Vec[P]] = [[P {{ n: 1, s: "a" }}, P {{ n: 1, s: "a" }}]];
    u[idx(0)][idx(1)].n += val(3);
    println("--");
    let mut v: Vec[i64] = [1, 2];
    v[idx(1)] += val(4);
    println(f"{{w[1][0]}} {{u[0][1].n}} {{v[1]}}");
}}
