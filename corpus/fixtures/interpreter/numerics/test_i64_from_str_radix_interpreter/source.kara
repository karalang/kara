fn pr(o: Option[i64]) { match o { Some(n) => println(n), None => println(-1), } }
        fn main() {
            pr(i64.from_str_radix("ff", 16));
            pr(i64.from_str_radix("1010", 2));
            pr(i64.from_str_radix("17", 8));
            pr(i64.from_str_radix("zz", 16));
            pr(i64.from_str_radix("7f", 16));
        }