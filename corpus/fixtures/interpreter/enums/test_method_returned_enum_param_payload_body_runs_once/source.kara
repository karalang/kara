struct T { n: i64 }
impl T { fn take(ref self, b: Option[Res]) -> Res { match b { Option.Some(r) => { return r; } Option.None => { return Res { id: 0, name: f"z" }; } } } }
fn main() { let t = T { n: 1 }; let b: Option[Res] = Option.Some(Res { id: 7, name: f"e7" }); let r: Res = t.take(b); println(f"got {r.id}") }
