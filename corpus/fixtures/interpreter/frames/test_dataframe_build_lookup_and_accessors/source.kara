fn main() {
let mut df: DataFrame = DataFrame.new();
df.insert("age", Column.from_vec([30i64, 25i64, 40i64]));
df.insert("name", Column.from_vec(["a", "b", "c"]));
println(df.width());
println(df.height());
let ages: Column[i64] = df.column("age");
println(ages.len());
match ages[0] { Some(v) => { println(v); } None => { println(-1i64); } }
for n in df.column_names() { println(n); }
}