fn main() {
            let a = "one\ntwo\nthree";
            let v: Vec[Str] = a.lines().collect();
            println(f"{v.len()}");
            println(v[0]);
            println(v[2]);
            // Trailing newline → no final empty line.
            println(f"{"trailing\n".lines().count()}");
            // CRLF endings → `\r` stripped, no trailing empty.
            let c = "crlf\r\nhandling\r\n";
            let w: Vec[Str] = c.lines().collect();
            println(f"{w.len()}");
            println(w[1]);
            // Empty middle line is preserved.
            let d = "a\n\nb";
            let x: Vec[Str] = d.lines().collect();
            println(f"{x.len()} {x[1].len()}");
            // Empty string → zero lines.
            println(f"{"".lines().count()}");
        }