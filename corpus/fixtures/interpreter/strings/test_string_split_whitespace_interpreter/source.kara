fn main() {
            let a = "  the  quick   brown fox  ";
            let v: Vec[Str] = a.split_whitespace().collect();
            println(f"{v.len()}");
            println(v[0]);
            println(v[3]);
            // Tab and newline are whitespace too.
            let e = "tab\tand\nnewline";
            let w: Vec[Str] = e.split_whitespace().collect();
            println(f"{w.len()}");
            println(w[1]);
            // Single token, all-whitespace, and empty → 1 / 0 / 0.
            let one: Vec[Str] = "single".split_whitespace().collect();
            println(f"{one.len()}");
            let ws: Vec[Str] = "   ".split_whitespace().collect();
            println(f"{ws.len()}");
            let empty: Vec[Str] = "".split_whitespace().collect();
            println(f"{empty.len()}");
        }