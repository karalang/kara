
fn middle_sum(v: own Vec[i64]) -> i64 {
    match v {
        [_, ..mid, _] => {
            let mut acc = 0;
            for x in mid { acc = acc + x; }
            acc
        },
        _ => 0,
    }
}
fn main() {
    let mut v: Vec[i64] = Vec.new();
    v.push(100);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(200);
    println(middle_sum(v));
}
