struct Res { data: Vec[i64] }
impl Drop for Res {
fn drop(mut ref self) {
println(f"D{self.data.len()}")
}
}
fn mk(n: i64) -> Res {
let mut v: Vec[i64] = Vec.new();
let mut i = 0;
while i < n {
v.push(i);
i = i + 1;
}
Res { data: v }
}
fn main() {
let mut a = mk(3);
let b = mk(7);
a = b;
println("x");
}
