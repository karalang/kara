import std.pool.{Pool};
import std.time.{Duration};
fn make_int() -> Result[i64, String] { Ok(99) }
         fn main() {
             let pool: Pool[i64, String] = Pool.new(make_int, 1, 4);
             match pool.acquire(Duration.ms(0)) {
                 Ok(c1) => {
                     pool.release(c1);
                     match pool.acquire(Duration.ms(0)) {
                         Ok(c2) => println(c2.val),
                         Err(_) => println("acq2_err"),
                     }
                 }
                 Err(_) => println("acq1_err"),
             }
         }