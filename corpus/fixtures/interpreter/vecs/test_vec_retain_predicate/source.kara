fn main() {
            let mut xs: Vec[i64] = Vec.new();
            xs.push(1i64); xs.push(2i64); xs.push(3i64); xs.push(4i64); xs.push(5i64);
            xs.retain(|x| x != 3i64);
            println(xs.len());
            for x in xs.iter() { println(x); }
            xs.retain(|x| x % 2i64 == 0i64);
            println(xs.len());
            for x in xs.iter() { println(x); }
        }