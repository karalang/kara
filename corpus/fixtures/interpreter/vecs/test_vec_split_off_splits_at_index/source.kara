fn main() {
            let mut v: Vec[i64] = [1, 2, 3, 4, 5];
            let t: Vec[i64] = v.split_off(2);
            println(v.len());
            println(t.len());
            for x in v.iter() { println(x); }
            for y in t.iter() { println(y); }
            let mut s: Vec[String] = ["a", "b", "c"];
            let st: Vec[String] = s.split_off(1);
            println(s.get(0));
            println(st.get(1));
        }