
        fn main() {
            let mut q: VecDeque[i64] = VecDeque.new();
            q.push_back(2);
            q.push_back(3);
            q.push_front(1);
            let f = q.pop_front();
            let b = q.pop_back();
            let m = q.pop_front();
            println(f);
            println(b);
            println(m);
        }
    