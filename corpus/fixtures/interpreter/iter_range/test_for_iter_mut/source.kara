
fn main() {
    let mut v: Vec[i64] = [1i64, 2i64, 3i64, 4i64];
    for x in v.iter_mut() { *x = *x * 2i64; }
    for x in v.iter_mut() { *x += 1i64; }
    let mut s: i64 = 0i64;
    for y in v { s = s + y; }
    println(f"{s}");
    let mut words: Vec[String] = [f"a", f"bb"];
    for w in words.iter_mut() { *w = f"x"; }
    for w in words { println(f"{w}"); }
}
