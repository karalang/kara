
fn main() {
    let v = [10, 20, 30];
    let mut it = v.iter().scan(0, |state, item| {
        let new = state + item;
        Some((new, new))
    });
    println(it.next().unwrap());
    println(it.next().unwrap());
    println(it.next().unwrap());
    match it.next() {
        Some(_) => println("more"),
        None => println("done"),
    }
}
