fn sum(xs: Slice[i64]) -> i64 {
             let mut acc = 0;
             for x in xs { acc = acc + x; }
             acc
         }
         fn main() {
             let a: Array[i64, 5] = [1, 2, 3, 4, 5];
             let outer = a[0..5];
             let inner = outer[1..4];
             println(sum(inner));
         }