trait Two { fn two() -> Self; }
impl Two for u8 { fn two() -> u8 { return 44; } }
impl Two for bool { fn two() -> bool { return true; } }
impl Two for f64 { fn two() -> f64 { return 45.5; } }
fn main() {
println(u8.two().to_string());
println(bool.two().to_string());
println(f64.two().to_string());
}