import std.sync.{Atomic};

sync struct Counter { count: Atomic[i64] }
impl Counter {
fn inc(ref self) { let _ = self.count.fetch_add(1); }
fn get(ref self) -> i64 { self.count.load() }
}
fn bump_many(c: Counter, n: i64) {
for i in 0..n { c.inc();  }
}
fn main() {
let c = Counter { count: Atomic.new(0) };
par { bump_many(c, 5000), bump_many(c, 5000), };
println(c.get());
}