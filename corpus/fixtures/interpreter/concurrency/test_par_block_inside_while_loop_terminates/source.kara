fn main() {
                     let mut total: i64 = 0;
                     let mut i: i64 = 0;
                     while i < 2 {
                         let (a, b) = par {
                             i + 1,
                             i + 2,
                         };
                         total = total + a + b;
                         i += 1;
                     }
                     println(total);
                 }