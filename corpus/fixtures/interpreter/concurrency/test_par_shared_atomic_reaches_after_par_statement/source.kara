sync struct Counter { count: Atomic[i64] }
impl Counter {
fn inc(ref self) { let _ = self.count.fetch_add(1, MemoryOrdering.SeqCst); }
fn get(ref self) -> i64 { self.count.load(MemoryOrdering.SeqCst) }
}
fn main() {
let c = Counter { count: Atomic.new(0) };
par { c.inc(); c.inc(); }
println(c.get());
println("after");
}