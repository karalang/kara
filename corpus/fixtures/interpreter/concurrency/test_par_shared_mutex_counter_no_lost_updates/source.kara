sync struct Counter { total: Mutex[i64] }
impl Counter {
fn inc(ref self) { lock self.total t { t += 1; } }
fn get(ref self) -> i64 { lock self.total t { t } }
}
fn bump(c: Counter, n: i64) {
for i in 0..n { c.inc();  }
}
fn main() {
let c = Counter { total: Mutex.new(0) };
par { bump(c, 5000), bump(c, 5000), };
println(c.get());
}