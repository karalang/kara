fn main() {
             let cell: OnceCell[i64] = OnceCell.new();
             println(cell.is_set());
             match cell.set(5) {
                 Ok(_) => println(1),
                 Err(_) => println(0),
             }
             println(cell.is_set());
             match cell.get() {
                 Some(v) => println(v),
                 None => println(-1),
             }
         }