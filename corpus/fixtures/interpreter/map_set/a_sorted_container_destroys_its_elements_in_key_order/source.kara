struct V { id: i64 }
        impl Drop for V { fn drop(mut ref self) { println(f"drop {self.id}"); } }
        fn main() {
            let mut a: SortedMap[i64, V] = SortedMap.new();
            let mut i = 1;
            while i <= 8 { a.insert(9 - i, V { id: i }); i = i + 1; }
            println("--");
        }