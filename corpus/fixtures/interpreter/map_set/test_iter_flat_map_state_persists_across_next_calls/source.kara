
fn main() {
    let v = [1, 2];
    let mut it = v.iter().flat_map(|n| { let inner = [n * 10, n * 100]; inner.iter() });
    println(it.next().unwrap());
    println(it.next().unwrap());
    println(it.next().unwrap());
    println(it.next().unwrap());
    match it.next() {
        Some(_) => println("more"),
        None => println("done"),
    }
}
