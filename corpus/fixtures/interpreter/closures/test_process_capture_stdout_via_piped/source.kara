fn main() {
         let cmd = Command.new("/bin/echo").arg("hello-pipe").stdout(Stdio.piped());
         match cmd.spawn() {
             Ok(child) => {
                 match child.stdout() {
                     Some(out) => {
                         let mut s = String.new();
                         match out.read_to_string(s) {
                             Ok(_) => print(s),
                             Err(_) => println("read_err"),
                         }
                     }
                     None => println("no_stdout"),
                 }
                 match child.wait() {
                     Ok(_) => {}
                     Err(_) => println("wait_err"),
                 }
             }
             Err(_) => println("spawn_err"),
         }
     }