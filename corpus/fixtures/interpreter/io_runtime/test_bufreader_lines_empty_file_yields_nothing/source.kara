fn main() {{
             match File.open("{path}") {{
                 Ok(f) => {{
                     let br = BufReader.new(f);
                     let mut count = 0;
                     for line in br.lines() {{
                         match line {{
                             Ok(_) => {{ count = count + 1; }}
                             Err(_) => {{}}
                         }}
                     }}
                     println("count=" + count.to_string());
                 }}
                 Err(_) => println("open err"),
             }}
         }}