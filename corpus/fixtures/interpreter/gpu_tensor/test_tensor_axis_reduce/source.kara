fn main() {
let a: Tensor[i64, [2, 3]] = Tensor.from([[1, 2, 3], [4, 5, 6]]);
let s0 = a.sum_axis(0);
println(s0[0]); println(s0[1]); println(s0[2]);
let s1 = a.sum_axis(1);
println(s1[0]); println(s1[1]);
let m0 = a.mean_axis(0);
println(m0[0]); println(m0[2]);
let v: Tensor[i64, [4]] = Tensor.from([1, 2, 3, 4]);
println(v.sum_axis(0));
}