
fn main() {
    let a: Tensor[f32, [1]] = Tensor.from([0.1]);
    let b: Tensor[f32, [1]] = a * 3.0;
    println(b.sum());
    let neg: Tensor[f32, [1]] = -b;
    println(neg.sum());
    let d: Tensor[f64, [1]] = Tensor.from([0.1]);
    let e: Tensor[f64, [1]] = d * 3.0;
    println(e.sum());
    let s: f32 = 0.1;
    println(s * 3.0);
}
