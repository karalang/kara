fn main() {
let m: Tensor[f64, [2, 2]] = Tensor.from([[2.0, 4.0], [6.0, 8.0]]);
let col: Tensor[f64, [2, 1]] = Tensor.from([[2.0], [4.0]]);
let q = m.broadcast_div(col);
println(q[0, 0]); println(q[1, 0]);
// [1,3] broadcast with [2,1] -> [2,3], both singletons expand.
let row: Tensor[i64, [1, 3]] = Tensor.from([[1, 2, 3]]);
let coli: Tensor[i64, [2, 1]] = Tensor.from([[10], [20]]);
let g = row.broadcast_add(coli);
println(g[0, 2]); println(g[1, 0]);
}