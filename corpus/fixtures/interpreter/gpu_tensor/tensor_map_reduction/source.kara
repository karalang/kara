
fn main() {
    let t: Tensor[i64, [4]] = Tensor.from([1, 2, 3, 4]);
    let d = t.map(|x| x * 2);
    println(f"{d.sum()}");

    let k: i64 = 100;
    let e = t.map(|x| x + k);
    println(f"{e.sum()}");

    let m: Tensor[i64, [2, 3]] = Tensor.from([[1, 2, 3], [4, 5, 6]]);
    let g = m.map(|x| x + 10);
    println(f"{g.sum()}");
}
