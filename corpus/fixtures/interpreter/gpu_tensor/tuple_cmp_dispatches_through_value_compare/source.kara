
fn tag(o: Ordering) -> i64 {
    if o.is_lt() { return 0; }
    if o.is_eq() { return 1; }
    return 2;
}

fn main() {
    println(f"{tag((1, 2).cmp((1, 3)))}");
    println(f"{tag((1, 2).cmp((1, 2)))}");
    println(f"{tag((1, 2).cmp((0, 9)))}");
    println(f"{tag(("b", 1).cmp(("b", 2)))}");
    println(f"{tag((1, 2, 3).cmp((1, 2, 4)))}");
    println(f"{tag((1, (2, 3)).cmp((1, (2, 4))))}");
    println(f"{tag((true, 'z').cmp((true, 'a')))}");
}
