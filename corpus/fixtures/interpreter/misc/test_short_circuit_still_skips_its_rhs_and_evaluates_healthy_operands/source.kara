fn main() {
let mut v: Vec[i64] = Vec.new();
if false and v[3] > 0i64 { println("unreachable-and"); }
if true or v[3] > 0i64 { println("or-short-circuited"); }
v.push(5i64);
if v[0] > 0i64 and v.len() == 1 { println("healthy-and"); }
let n: i64 = 1i64;
match n { x if v[0] > 0i64 => { println("healthy-guard"); } _ => { println("no"); } }
}