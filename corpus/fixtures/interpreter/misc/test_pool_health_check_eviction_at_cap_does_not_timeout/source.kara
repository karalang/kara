import std.pool.{Pool, PoolError};
import std.time.{Duration};
fn make_conn() -> Result[i64, String] { println("mint"); Ok(7) }
         fn main() {
             let pool: Pool[i64, String] = Pool.new(make_conn, 1, 1).with_health_check(|c| { false });
             match pool.acquire(Duration.ms(0)) {
                 Ok(c1) => { pool.release(c1); }
                 Err(_) => println("acq1_err"),
             }
             match pool.acquire(Duration.ms(0)) {
                 Ok(_) => println("ok2"),
                 Err(PoolError.Timeout) => println("timeout2"),
                 Err(_) => println("err2"),
             }
         }