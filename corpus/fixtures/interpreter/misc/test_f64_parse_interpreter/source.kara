fn pr(o: Option[f64]) { match o { Some(x) => println(x), None => println(-1.0), } }
        fn main() {
            pr(f64.parse("3.14").ok());
            pr(f64.parse("1e10").ok());
            pr(f64.parse("-2.5").ok());
            pr(f64.parse("notnum").ok());
            pr(f64.parse("42").ok());
        }