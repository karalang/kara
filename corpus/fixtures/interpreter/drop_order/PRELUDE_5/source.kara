{PRELUDE}struct Sq {{ n: i64 }}
impl Sq {{
    fn keep(x: Option[Rq], acc: mut ref Vec[Rq]) {{
        match x {{ Some(r) => {{ acc.push(r) }} None => {{ println("n") }} }}
    }}
