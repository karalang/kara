shared struct S { id: i64 }
impl Drop for S { fn drop(mut ref self) { println(f"dS{self.id}"); } }
fn build(k: i64) -> (S, i64) { let s: S = S { id: k }; return (s, 3) }
fn main() {
{ let a: (S, i64) = (S { id: 1 }, 3); let s: S = a.0; println(f"v{s.id}"); println("one"); }
{ let a: (S, i64) = (S { id: 2 }, 3); let (s, n) = a; println(f"v{s.id}{n}"); println("two"); }
{ let a: (S, i64) = build(4); println(f"v{a.0.id}"); println("three"); }
println("end");
}