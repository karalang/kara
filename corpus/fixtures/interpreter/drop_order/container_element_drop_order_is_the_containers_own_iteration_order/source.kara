struct V { id: i64 }
        impl Drop for V { fn drop(mut ref self) { println(f"drop {self.id}"); } }
        fn main() {
            let mut a: Map[i64, V] = Map.new();
            let mut i = 1;
            while i <= 8 { a.insert(i, V { id: i }); i = i + 1; }
            for (k, v) in a { println(f"iter {k}"); }
        }