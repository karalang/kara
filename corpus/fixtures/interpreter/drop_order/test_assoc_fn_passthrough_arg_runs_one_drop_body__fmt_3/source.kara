struct R { id: i64, s: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> String { return f"pay-{i}" }
struct H { n: i64 }
impl H { fn idm(ref self, a: R) -> R { return a } }
fn main() { let h = H { n: 0 }; let x = h.idm(R { id: 1, s: mk(1) }); println(f"x={x.id}") }