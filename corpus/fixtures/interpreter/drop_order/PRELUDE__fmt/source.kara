struct Rq { id: i64 }
impl Drop for Rq { fn drop(mut ref self) { println(f"dRq{self.id}"); } }
struct Sq { n: i64 }
impl Sq {
    fn eat(x: Option[Rq]) {
        match x { Some(r) => { println(f"a:{r.id}") } None => { println("n") } }
    }
}
fn main() {
    Sq.eat(Some(Rq { id: 1 }));
    println("end");
}
