import std.pool.{Pool, PoolError};
import std.time.{Duration};
fn make_int() -> Result[i64, String] { Ok(7) }
         fn main() {
             let pool: Pool[i64, String] = Pool.new(make_int, 1, 4);
             {
                 let c1 = pool.acquire(Duration.ms(0)).unwrap();
                 pool.release(c1);
             }
             match pool.acquire(Duration.ms(0)) {
                 Ok(_) => {
                     match pool.acquire(Duration.ms(0)) {
                         Ok(_) => println("DOUBLE"),
                         Err(PoolError.Timeout) => println("single"),
                         Err(_) => println("other"),
                     }
                 }
                 Err(_) => println("acq_err"),
             }
         }