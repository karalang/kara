struct Rq { id: i64 }
impl Drop for Rq { fn drop(mut ref self) { println(f"dRq{self.id}"); } }
struct Sq { n: i64 }
impl Sq {
    fn take(mut ref self, x: Option[Rq]) {
        match x { Some(r) => { println(f"m:{r.id}") } None => { println("n") } }
    }
}
fn main() {
    let mut s = Sq { n: 0 };
    s.take(Some(Rq { id: 1 }));
    println("end");
}
