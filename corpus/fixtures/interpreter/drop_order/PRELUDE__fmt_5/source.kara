struct Rq { id: i64 }
impl Drop for Rq { fn drop(mut ref self) { println(f"dRq{self.id}"); } }
struct Sq { n: i64 }
impl Sq {
    fn keep(x: Option[Rq], acc: mut ref Vec[Rq]) {
        match x { Some(r) => { acc.push(r) } None => { println("n") } }
    }
}
fn main() {
    let mut acc: Vec[Rq] = [];
    Sq.keep(Some(Rq { id: 1 }), mut acc);
    println(f"len:{acc.len()}");
}
