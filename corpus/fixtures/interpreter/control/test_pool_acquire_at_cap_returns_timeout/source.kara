fn make_int() -> i64 { 7 }
         fn main() {
             let pool: Pool[i64] = Pool.new(make_int, 2, 8);
             match pool.acquire(0) {
                 Ok(_) => {
                     match pool.acquire(0) {
                         Ok(_) => {
                             match pool.acquire(0) {
                                 Ok(_) => println("ok??"),
                                 Err(PoolError.Timeout) => println("timeout"),
                                 Err(_) => println("other_err"),
                             }
                         }
                         Err(_) => println("acq2_err"),
                     }
                 }
                 Err(_) => println("acq1_err"),
             }
         }