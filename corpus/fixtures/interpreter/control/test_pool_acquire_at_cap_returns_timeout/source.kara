import std.pool.{Pool, PoolError};
import std.time.{Duration};
fn make_int() -> Result[i64, String] { Ok(7) }
         fn main() {
             let pool: Pool[i64, String] = Pool.new(make_int, 2, 8);
             match pool.acquire(Duration.ms(0)) {
                 Ok(_) => {
                     match pool.acquire(Duration.ms(0)) {
                         Ok(_) => {
                             match pool.acquire(Duration.ms(0)) {
                                 Ok(_) => println("ok??"),
                                 Err(PoolError.Timeout) => println("timeout"),
                                 Err(_) => println("other_err"),
                             }
                         }
                         Err(_) => println("acq2_err"),
                     }
                 }
                 Err(_) => println("acq1_err"),
             }
         }