import std.pool.{Pool, PoolError};
import std.time.{Duration};
fn main() {
         let pool: Pool[i64, String] = Pool { handle_id: 0 };
         match pool.acquire(Duration.ms(0)) {
             Ok(_) => println("ok??"),
             Err(PoolError.Timeout) => println("timeout"),
             Err(PoolError.Busy) => println("busy"),
             Err(PoolError.PoolClosed) => println("closed"),
             Err(PoolError.CreateFailed(_)) => println("create_failed"),
         }
     }