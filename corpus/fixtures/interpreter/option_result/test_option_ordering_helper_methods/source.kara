fn main() {
let lt: Option[Ordering] = Some(Ordering.Less);
let eq: Option[Ordering] = Some(Ordering.Equal);
let gt: Option[Ordering] = Some(Ordering.Greater);
let none: Option[Ordering] = None;
println(lt.is_lt());
println(lt.is_le());
println(lt.is_gt());
println(lt.is_ge());
println(lt.is_eq());
println(eq.is_lt());
println(eq.is_le());
println(eq.is_gt());
println(eq.is_ge());
println(eq.is_eq());
println(gt.is_lt());
println(gt.is_le());
println(gt.is_gt());
println(gt.is_ge());
println(gt.is_eq());
println(none.is_lt());
println(none.is_le());
println(none.is_gt());
println(none.is_ge());
println(none.is_eq());
}