struct D { id: i64, s: String }
impl Drop for D { fn drop(mut ref self) { println(f"dD{self.id}") } }
fn mkd(n: i64) -> D { return D { id: n, s: f"ss{n}" }; }
struct G[T] { a: Array[T, 2] }
             fn main() {
                 let g: G[D] = G { a: [mkd(1), mkd(2)] };
                 println("end");
             }
