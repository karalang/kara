fn main() {
let a: i64 = 0i64 - 5i64;
match a { -5 => println("neg5"), _ => println("no") }
match a { -10..=-1 => println("band"), _ => println("no") }
let b: i64 = 7i64;
match b { -5 => println("neg5"), _ => println("no") }
let m: i64 = 0i64 - 9223372036854775807i64 - 1i64;
match m { -9223372036854775808 => println("min"), _ => println("no") }
let w: i128 = 0i128 - 170141183460469231731687303715884105727i128 - 1i128;
match w { -170141183460469231731687303715884105728i128 => println("i128min"), _ => println("no") }
let f: f64 = 0.0 - 1.5;
match f { -1.5 => println("float"), _ => println("no") }
let t = (0i64 - 1i64, 2i64);
match t { (-1, 2) => println("tuple"), _ => println("no") }
}