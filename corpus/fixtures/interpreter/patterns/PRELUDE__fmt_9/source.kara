struct R { s: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.s}"); } }
struct H { r: R, n: i64 }
fn main() {
let mut k: i64 = 0;
let mut z: Option[R] = Some(R { s: "c" });
while let Some(r) = z {
println(f"{r.s}");
k = k + 1;
if k < 2 { z = Some(R { s: "d" }); } else { z = None; }
}
println("end");
}
