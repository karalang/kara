import std.pool.{PoolError};
fn classify(e: own PoolError[String]) -> String {
             match e {
                 PoolError.Timeout => "timeout",
                 PoolError.PoolClosed => "closed",
                 PoolError.CreateFailed(_) => "create_failed",
                 PoolError.Busy => "busy",
             }
         }
         fn main() {
             println(classify(PoolError.Timeout));
             println(classify(PoolError.PoolClosed));
             println(classify(PoolError.CreateFailed("refused".to_string())));
         }