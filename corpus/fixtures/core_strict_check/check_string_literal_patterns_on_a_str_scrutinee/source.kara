
fn size(name: String) -> i64 {
    match name.as_str() {
        "Year" => 4,
        _ => 19,
    }
}
fn oid_name(oid: Str) -> String {
    match oid {
        "2.5.4.6" => "C".to_string(),
        _ => "?".to_string(),
    }
}
fn main() {
    println(f"{size(String.from("Year"))} {oid_name("2.5.4.6")}");
}
