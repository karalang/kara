struct Cnt { words: i64, syms: i64 }
fn tally(c: mut ref Cnt, b: u8) { if (b >= 97 and b <= 122) { c.words = c.words + 1; } else { if b != 32 { c.syms = c.syms + 1; } } }
fn main() { let src = "ab + cd"; let mut c = Cnt { words: 0, syms: 0 }; for b in src.bytes() { tally(mut c, b); } println(c.words.to_string() + "/" + c.syms.to_string()) }