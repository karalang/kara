fn find(v: ref Vec[i64], t: i64) -> Option[i64] {
    let mut i = 0;
    while i < v.len() {
        if v[i] == t {
            return Some(i);
        }
        i = i + 1;
    }
    return None;
}
fn pick(flag: bool) -> Option[String] {
    if flag {
        return Some("payload".to_string());
    }
    return None;
}
fn parse_num(s: String) -> Result[i64, String] {
    if s == "9" {
        return Ok(9);
    }
    return Err("nope".to_string());
}
fn main() {
    let mut v: Vec[i64] = Vec.new();
    v.push(4);
    v.push(9);
    let hit = find(v, 9);
    println(hit.is_some().to_string());
    println(hit.is_none().to_string());
    if hit.is_some() {
        println(hit.unwrap().to_string());
    }
    let miss = find(v, 5);
    println(miss.is_none().to_string());
    let s = pick(true);
    if s.is_some() {
        println(s.unwrap());
    }
    let r = parse_num("9".to_string());
    println(r.is_ok().to_string());
    if r.is_ok() {
        println(r.unwrap().to_string());
    }
    let e = parse_num("x".to_string());
    println(e.is_err().to_string());
}