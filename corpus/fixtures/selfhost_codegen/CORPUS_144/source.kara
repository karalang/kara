enum Tok { Plus, Num(i64), Ident(String) }
impl Tok {
    fn describe(ref self) -> String {
        match self {
            Ident(name) => {
                return "ident:".to_string() + name;
            }
            Num(n) => {
                return "num:".to_string() + n.to_string();
            }
            Plus => {}
        }
        return "plus".to_string();
    }
    fn weight(ref self) -> i64 {
        match self {
            Ident(name) => {
                return name.len();
            }
            Num(n) => {
                return n;
            }
            Plus => {}
        }
        return 0;
    }
    fn into_code(self) -> i64 {
        match self {
            Ident(name) => {
                return 100 + name.len();
            }
            Num(n) => {
                return n;
            }
            Plus => {}
        }
        return 0 - 1;
    }
}
fn main() {
    let a = Tok.Ident("foo".to_string());
    let b = Tok.Num(42);
    let c = Tok.Plus;
    println(a.describe());
    println(b.describe());
    println(c.describe());
    println(a.weight().to_string());
    println(b.weight().to_string());
    println(a.into_code().to_string());
    println(c.into_code().to_string());
}