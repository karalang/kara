#[derive(Clone)]
struct Token { kind: i64, text: String }
fn main() { let mut toks: Vec[Token] = Vec.new(); toks.push(Token { kind: 1, text: "let" }); toks.push(Token { kind: 2, text: "x" + "1" }); let mut i = 0; while i < toks.len() { let t = toks[i].clone(); println(t.kind.to_string() + ":" + t.text); i = i + 1; } }