fn main() {
    let mut v: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < 5 {
        v.push(0);
        i = i + 1;
    }
    let mut j = 0;
    while j < 5 {
        v[j] = j * j;
        j = j + 1;
    }
    println((v[0] + v[2] + v[4]).to_string());
    v[0] = 99;
    println(v[0].to_string());
    let mut s: Vec[String] = Vec.new();
    s.push("old".to_string());
    s.push("keep".to_string());
    let mut k = 0;
    while k < 3 {
        s[0] = "new".to_string();
        k = k + 1;
    }
    println(s[0]);
    println(s[1]);
}