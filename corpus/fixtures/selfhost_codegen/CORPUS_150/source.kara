enum Tok { Eof, CharTok(char), ByteTok(u8) }
fn code(t: ref Tok) -> i64 {
    match t {
        CharTok(c) => {
            if c == 'z' {
                return 1000;
            }
            return 1;
        }
        ByteTok(b) => {
            if b == 43 {
                return 2000;
            }
            return 2;
        }
        Eof => {}
    }
    return 0;
}
fn is_lower(c: char) -> bool {
    return c >= 'a' and c <= 'z';
}
fn main() {
    println(code(Tok.CharTok('z')).to_string());
    println(code(Tok.CharTok('A')).to_string());
    println(code(Tok.ByteTok(43)).to_string());
    println(code(Tok.Eof).to_string());
    println(is_lower('m').to_string());
    println(is_lower('M').to_string());
    let c = 'q';
    if c == 'q' {
        println("q!");
    }
}