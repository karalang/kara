fn main() {
    let mut v: Vec[(String, i64)] = Vec.new();
    let mut i = 0;
    while i < 6000 {
        v.push((f"key-{(i * 7 + 2) % 5}-with-padding-to-live-on-the-heap", i));
        i += 1;
    }
    v.sort_by(|a, b| a.0.cmp(b.0));
    let mut h = 0;
    for (s, x) in v.iter() {
        h = (h * 31 + x + s.len()) % 1000000007;
    }
    println(f"{v[0].0} {v[0].1} {v[5999].0} {v[5999].1} {h}");
}
