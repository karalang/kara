
struct Inner { v: i64 }
enum Tint { Red, Green }
enum E { None, Msg(Inner), Hue(Tint), Num(i64) }
fn main() {
    let r = comptime {
        let mut s = "";
        for v in E.variants() {
            if v.payload != "" {
                s = s + v.name + ":" + v.payload_ty.name();
                if v.payload_ty.is_struct() { s = s + "(struct)"; }
                if v.payload_ty.is_enum() { s = s + "(enum," + f"{v.payload_ty.variants().len()}" + ")"; }
                s = s + ";";
            }
        }
        s
    };
    println(r);
}