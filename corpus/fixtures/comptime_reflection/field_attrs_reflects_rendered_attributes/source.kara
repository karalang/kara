
struct S {
    #[karac::proto(sint64)] x: i64,
    y: i64,
}
fn main() {
    let r = comptime {
        let mut s = "";
        for f in S.fields() {
            s = s + f.name + ":" + f"{f.attrs.len()}";
            for a in f.attrs { s = s + "=" + a; }
            s = s + ";";
        }
        s
    };
    println(r);
}