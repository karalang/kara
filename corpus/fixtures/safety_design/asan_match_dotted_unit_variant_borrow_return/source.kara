enum Side { Left, Right }
fn pick(s: ref Side, a: ref String, b: ref String) -> ref String {
match s {
Side.Left => a,
Side.Right => b,
}
}
fn main() {
let sd: Side = Side.Right;
let x = String.from("left payload here");
let y = String.from("right payload here");
let r = pick(sd, x, y);
println(r.len());
}