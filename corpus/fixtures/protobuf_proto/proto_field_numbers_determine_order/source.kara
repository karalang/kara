
#[proto_schema]
const SCHEMA: String = "
    message M {
        int64 second = 2;
        string first = 1;
    }
";

fn main() {
    let m = M { first: "a", second: 9 };
    let mut reader = ProtoReader.new(m.encode());
    let (f1, w1) = reader.read_tag();
    println(f1);
    println(w1);
    let v = reader.read_string();
    println(v);
    let r = M.decode(m.encode());
    println(r.first);
    println(r.second);
}
