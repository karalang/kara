
#[proto_schema]
const SCHEMA: String = "message M { string name = 3; int64 id = 17; bool on = 1; }";

fn main() {
    let m = M { name: "Ada", id: 99, on: true };
    let mut r = ProtoReader.new(m.encode());
    let mut desc = "";
    while not r.at_end() {
        let (f, w) = r.read_tag();
        desc = desc + f"({f})";
        let _ = r.skip_field(w);
    }
    println(desc);
    let back = M.decode(m.encode());
    println(back.name);
    println(back.id);
    println(back.on);
}
