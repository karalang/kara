
        shared struct Node {
            val: i64,
            next: Option[Node],
        }

        fn main() {
            let mut keep: Option[Node] = None;
            let mut sum = 0;
            let mut k = 0;
            while k < 100000 {
                let fresh = Node { val: k, next: keep };
                keep = Some(fresh);
                sum = sum + k;
                k = k + 1;
            }
            println(sum);
        }
        