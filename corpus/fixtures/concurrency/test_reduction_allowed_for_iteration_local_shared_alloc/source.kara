
        shared struct Node {
            val: i64,
            next: Option[Node],
        }

        fn main() {
            let mut sum = 0;
            let mut k = 0;
            while k < 100000 {
                let mut head: Option[Node] = None;
                let mut j = 0;
                while j < 8 {
                    head = Some(Node { val: k + j, next: head });
                    j = j + 1;
                }
                let mut acc = 0;
                let mut cur = head;
                while cur.is_some() {
                    let n = cur.unwrap();
                    acc = acc + n.val;
                    cur = n.next;
                }
                sum = sum + acc;
                k = k + 1;
            }
            println(sum);
        }
        