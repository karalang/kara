
        struct Stream { fd: i64 }
        impl Stream {
            fn read(mut ref self) -> i64 with sends(Network) receives(Network) {
                self.fd = self.fd + 1;
                return self.fd;
            }
        }
        fn main() {
            let mut s1 = Stream { fd: 0 };
            let mut s2 = Stream { fd: 10 };
            let a = s1.read();
            let b = s2.read();
            println(a);
            println(b);
        }
        