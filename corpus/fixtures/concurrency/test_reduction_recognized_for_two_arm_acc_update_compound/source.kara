
        fn main() {
            let mut tally: i64 = 0i64;
            let mut k: i64 = 0i64;
            while k < 100i64 {
                let hit: bool = (k % 3i64) == 0i64;
                if hit { tally += 3i64; } else { tally += 1i64; }
                k = k + 1i64;
            }
        }
        