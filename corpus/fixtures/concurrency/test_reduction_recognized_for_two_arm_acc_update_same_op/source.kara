
        fn main() {
            let mut sum: i64 = 0i64;
            let mut k: i64 = 0i64;
            while k < 100i64 {
                let cond: bool = k > 5i64;
                if cond { sum = sum + 1i64; } else { sum = sum + 2i64; }
                k = k + 1i64;
            }
        }
        