
        fn main() {
            let mut acc: i64 = 1i64;
            let mut k: i64 = 0i64;
            while k < 100i64 {
                let cond: bool = k > 5i64;
                if cond { acc = acc + 1i64; } else { acc = acc * 2i64; }
                k = k + 1i64;
            }
        }
        