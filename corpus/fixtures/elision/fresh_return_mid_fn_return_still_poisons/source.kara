{NODE}fn build(n: i64) -> Option[ListNode] {{
let head = ListNode {{ val: 1, next: None }};
let mut tail = head;
let mut i = 2;
while i <= n {{
let node = ListNode {{ val: i, next: None }};
tail.next = Some(node);
tail = node;
i = i + 1;
}}
if n > 3 {{
return Some(head);
}}
None
}}
fn main() {{
let out = build(5);
if out.is_some() {{ println(out.unwrap().val); }}
}}