{NODE}fn run() -> i64 {{
let dummy = ListNode {{ val: 0, next: None }};
let a = ListNode {{ val: 1, next: None }};
let b = ListNode {{ val: 2, next: None }};
dummy.next = Some(a);
dummy.next = Some(b);
let mut sum = 0;
let mut cur = dummy.next;
while cur.is_some() {{
let x = cur.unwrap();
sum = sum + x.val;
cur = x.next;
}}
sum
}}
fn main() {{ println(run()); }}