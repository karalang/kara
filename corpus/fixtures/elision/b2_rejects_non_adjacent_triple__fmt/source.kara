shared struct ListNode { val: i64, mut next: Option[ListNode] }
fn run(n: i64) -> i64 {
let dummy = ListNode { val: 0, next: None };
let mut tail = dummy;
let mut i = 0;
while i < n {
let node = ListNode { val: i, next: None };
if i > 0 {
tail.next = Some(node);
tail = node;
}
i = i + 1;
}
dummy.val
}
fn main() { println(run(3)); }