shared struct ListNode { val: i64, mut next: Option[ListNode] }
fn run() -> i64 {
let dummy = ListNode { val: 0, next: None };
let node = ListNode { val: 1, next: None };
dummy.next = Some(node);
let c = dummy.next;
let n2 = c.unwrap();
dummy.next = Some(n2);
dummy.val
}
fn main() { println(run()); }