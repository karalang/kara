{NODE}fn build_and_sum(n: i64) -> i64 {{
let dummy = ListNode {{ val: 0, next: None }};
let mut tail = dummy;
let mut i = 1;
while i <= n {{
let node = ListNode {{ val: i, next: None }};
tail.next = Some(node);
tail = node;
i = i + 1;
}}
let z: Option[ListNode] = None;
let mut sum = 0;
if z.is_some() {{ sum = 1; }}
let mut cur = dummy.next;
while cur.is_some() {{
let x = cur.unwrap();
sum = sum + x.val;
cur = x.next;
}}
sum
}}
fn main() {{ println(build_and_sum(5)); }}