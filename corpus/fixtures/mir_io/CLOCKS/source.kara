
fn main() {
    let a = Clock.monotonic_ns();
    let mut spin = 0;
    while spin < 100000 {
        spin = spin + 1;
    }
    let b = clock.monotonic_ns();
    let w = Clock.wall_ns();
    let s = clock.now();
    println(f"monotonic: {b >= a}, {a >= 0}");
    println(f"wall after 2026: {w > 1767225600000000000}");
