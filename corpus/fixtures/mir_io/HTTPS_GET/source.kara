
fn main() {
    let c = Client.new();
    match c.get("URL") {
        Ok(r) => {
            println(r.status());
            println(r.body());
            match r.header("X-Origin") {
                Some(v) => println(v),
                None => println("no header"),
            }
        }
        Err(e) => println(f"error: {e.message()}"),
    }
}
