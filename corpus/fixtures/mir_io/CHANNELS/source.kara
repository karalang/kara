
fn start(group: ref TaskGroup, n: i64) -> TaskHandle[i64] {
    group.spawn(|| n * 2)
}

fn main() {
    let (tx, rx): (Sender[i64], Receiver[i64]) = channel(2);
    {
        let t = tx;
        match t.send(1) {
            Ok(()) => println("sent 1"),
            Err(_) => println("err"),
        }
        t.send(2).unwrap();
        match t.try_send(3) {
            Err(SendError.Full(v)) => println(f"full {v}"),
            _ => println("?"),
        }
        match rx.recv() {
            Some(v) => println(f"got {v}"),
            None => println("none"),
        }
        println(rx.recv().unwrap());
    }
    match rx.recv() {
        Some(v) => println(f"got {v}"),
        None => println("closed"),
    }
    let (t2, r2) = channel(4);
    {
        let t = t2;
        t.send("a").unwrap();
        t.send("b").unwrap();
    }
    for s in r2.into_iter() {
        println(s);
    }
    let (t3, r3): (Sender[String], Receiver[String]) = channel(1);
    {
        let r = r3;
    }
    match t3.send("x") {
        Err(SendError.Closed(v)) => println(f"closed {v}"),
        _ => println("?"),
    }
    let g = TaskGroup.new(limit: 2);
    let h = start(g, 21);
    println(h.join());
}
