
fn main() {
    let s = "héllo→x";
    let r: String = s.chars().rev().collect();
    println(r);
    let mut it = s.chars();
    let a = it.next_back();
    let b = it.next();
    println(f"{a} {b} {it.count()}");
    let mut v: Vec[i64] = Vec.new();
    v.push(1);
    v.push(2);
    v.push(3);
    let w: Vec[i64] = v[1..].iter().rev().cloned().collect();
    println(f"{w[0]} {w.len()}");
}
