
fn main() {
    let s = "héllo".to_string();
    let n = s.chars().filter(|c| c != 'l').count();
    println(f"{n}");
    let kept: String = s.chars().filter(|c| c != 'é').collect();
    println(kept);
    let mut w = 0;
    for c in s.chars() {
        w = w + c.len_utf8();
    }
    println(f"{w}");
}
