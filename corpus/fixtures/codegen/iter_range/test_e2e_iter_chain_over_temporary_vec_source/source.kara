fn main() {
println(vec![1, 2, 3].iter().sum());
println(vec![1, 2, 3, 4].iter().product());
println(vec![1, 2, 3].iter().fold(0, |a, x| a + x));
println(vec![1, 2, 3, 4].iter().count());
match vec![1, 5, 3].iter().max() { Some(m) => println(m), None => println(-1) }
match vec![4, 1, 3].iter().min() { Some(m) => println(m), None => println(-1) }
println(vec![1, 2, 3].iter().map(|x| x * 2).sum());
println(vec![1, 2, 3, 4].iter().filter(|x| x % 2 == 0).sum());
println(vec![1, 2, 3].into_iter().sum());
let mut n = 0;
for x in vec![10, 20, 30].iter() { n = n + x; }
println(n);
}