
fn main() {
    let v: Vec[String] = Vec["alpha".to_string(), "bravo".to_string()];
    // non-terminal identity map, then filter with a DIFFERENT param name
    let a: Vec[(i64, String)] = v.iter().enumerate().map(|p| (p.0, p.1.clone())).filter(|q| q.0 >= 0).collect();
    println(f"{a.len()} {a[0].0} {a[1].0}");
    // filter then inspect (differing param), terminal collect
    let b: Vec[(i64, String)] = v.iter().cloned().enumerate().filter(|p| p.0 >= 0).collect();
    println(f"{b.len()} {b[1].0}");
    // re-tuple map body
    let c: Vec[(i64, String)] = v.iter().enumerate().map(|p| (p.0, p.1.clone())).filter(|q| q.0 < 9).collect();
    println(f"{c.len()} {c[0].0} {c[1].0}");
}
