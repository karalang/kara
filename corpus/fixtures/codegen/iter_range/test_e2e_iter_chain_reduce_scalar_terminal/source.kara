fn main() {
let v: Vec[i64] = [1, 2, 3, 4];
match v.iter().reduce(|a, x| a + x) { Some(s) => println(s), None => println(-1) }
match v.iter().reduce(|a, x| if a > x { a } else { x }) { Some(s) => println(s), None => println(-1) }
let e: Vec[i64] = [];
match e.iter().reduce(|a, x| a + x) { Some(s) => println(s), None => println(-1) }
match v.iter().map(|x| x * 2).reduce(|a, x| a + x) { Some(s) => println(s), None => println(-1) }
match v.iter().filter(|x| x > 1).reduce(|a, x| a + x) { Some(s) => println(s), None => println(-1) }
}