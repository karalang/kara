fn main() {
let v: Vec[i64] = [1, 2, 3, 4];
let e: Vec[i64] = [];
println(f"{v.iter().any(|x| x > 3)}");
println(f"{v.iter().any(|x| x > 9)}");
println(f"{v.iter().all(|x| x > 0)}");
println(f"{v.iter().all(|x| x > 2)}");
println(f"{e.iter().any(|x| x > 0)}");
println(f"{e.iter().all(|x| x > 0)}");
println(f"{v.iter().filter(|x| x % 2 == 0).any(|x| x > 4)}");
println(f"{v.iter().map(|x| x * x).all(|x| x < 20)}");
}