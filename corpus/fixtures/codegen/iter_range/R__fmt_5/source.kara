#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn eat(o: Option[(R, i64)]) { match o { Some(t) => { let x = t.0.clone(); println("mid"); println(f"v:{x.id}"); } None => { println("n"); } } }
fn main() { eat(Some((R { id: 5 }, 9))); println("end") }
