struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn eat(o: Option[(R, i64)]) -> R { match o { Some(t) => { let x = t.0; println("mid"); return x; } None => { return R { id: 0 }; } } }
fn main() { let g = eat(Some((R { id: 5 }, 9i64))); println(f"got:{g.id}"); println("end") }
