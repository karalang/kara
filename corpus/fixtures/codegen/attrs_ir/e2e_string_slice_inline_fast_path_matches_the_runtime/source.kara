fn main() {
    let s = "let mut fn if else while return for in match struct enum impl";
    let mut i = 0;
    let mut n = 0;
    while i < 20 { let t = s[i..(i + 3)]; n = n + t.len(); i = i + 1; }
    println(f"1 {n}");
    let e = s[5..5];
    println(f"2 {e.len()}");
    let e2 = String.new();
    println(f"3 {e == e2}");
    let a = s[0..23];
    let b = s[0..24];
    println(f"4 {a.len()} {b.len()} [{a}] [{b}]");
    let full = s[0..s.len()];
    println(f"5 {full.len()} {full == s}");
    let m = "h\u{e9}llo w\u{f6}rld";
    println(f"6 [{m[0..1]}] [{m[1..3]}]");
    let mut src = String.new();
    src.push_str("abcdefghij");
    let keep = src[2..6];
    src.push_str("XXXXXXXXXX");
    println(f"7 [{keep}]");
    println("end")
}
