struct Bag { items: Vec[i64] }
impl Bag {
pub fn copy_items(ref self) -> Vec[i64] { return self.items.clone(); }
}
fn pick[T: Clone](v: Vec[T], i: i64) -> T { return v.clone()[i].clone(); }
fn main() {
let v: Vec[i64] = [1, 2, 3];
println(f"{v.clone()[1]}");
let nums: Vec[i64] = [10, 20, 30, 40];
println(f"{nums[1..3].to_vec()[0]}");
let b = Bag { items: [7, 8] };
println(f"{b.copy_items()[1]}");
let names: Vec[String] = ["ann", "bo", "cy"];
println(names.clone()[2]);
println(f"{pick(v, 0)}");
println(pick(names, 1));
}
