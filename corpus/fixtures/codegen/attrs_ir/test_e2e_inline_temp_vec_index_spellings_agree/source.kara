struct B { xs: Vec[i64] }
fn names() -> Vec[String] { let v: Vec[String] = ["alpha", "beta", "gamma"]; return v; }
fn mkrows() -> Vec[Vec[i64]] { let v: Vec[Vec[i64]] = [[1, 2, 3], [4, 5, 6]]; return v; }
fn main() {
let b = B { xs: [7, 8, 9] };
let grid: Vec[Vec[i64]] = [[1, 2], [3, 4]];
let held: Vec[String] = ["one", "two"];
println(f"{names()[1]}");
println(names()[1]);
println(f"{names()[0]}-{names()[2]}");
println(f"{mkrows()[1]}");
println(mkrows()[1]);
println(f"{b.xs}");
println(b.xs);
println(f"{grid[1]}");
println(grid[1]);
println(f"{held[1]}");
println(held[1]);
let r = names();
println(f"{r[2]}");
println(f"{b.xs}");
println(f"{held[0]}");
}
