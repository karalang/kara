
fn pick[T](a: own T, b: own T) -> T { return a; }
fn outer[U](a: own U, b: own U) -> U { return pick(a, b); }

fn main() {
    let x = outer((1, 2), (3, 4));
    println(f"{x.0}:{x.1}");
    let y = outer((1.5, 2.5), (3.5, 4.5));
    println(f"{y.0}:{y.1}");
    let t = outer((1, 2, 3), (4, 5, 6));
    println(f"{t.0},{t.1},{t.2}");
    let s = outer("aa", "bb");
    println(f"{s}");
}
