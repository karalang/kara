fn sink(v: Vec[i64]) -> i64 { v.len() }
fn main() {
let mut out: Vec[Vec[i64]] = Vec.new();
let mut b: Vec[i64] = Vec.new(); b.push(1i64);
let mut k = 0i64; while k < 4i64 { out.push(b.clone()); k = k + 1i64; }
let mut acc = 0i64; let mut j = 0i64;
while j < out.len() { let r = out[j]; acc = acc + sink(r); j = j + 1i64; }
println(f"{acc}");
}