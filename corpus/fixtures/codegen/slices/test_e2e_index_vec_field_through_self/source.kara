struct Buf { bytes: Vec[u8], pos: i64 }
impl Buf {
fn peek(ref self) -> u8 { self.bytes[self.pos] }
fn advance(mut ref self) -> u8 {
let c = self.bytes[self.pos];
self.pos = self.pos + 1;
c
}
}
fn main() {
let mut b: Vec[u8] = Vec.new();
b.push(65u8); b.push(66u8); b.push(67u8);
let mut buf = Buf { bytes: b, pos: 0 };
println(buf.peek().to_string());
let a = buf.advance();
println(a.to_string());
println(buf.peek().to_string());
}