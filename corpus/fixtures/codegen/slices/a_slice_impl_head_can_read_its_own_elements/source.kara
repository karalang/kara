trait Head {{ fn first_or({self_mode}, d: i64) -> i64; }}
impl Head for Slice[i64] {{
fn first_or({self_mode}, d: i64) -> i64 {{
if self.len() == 0 {{ return d; }}
return self[0];
}}
}}
fn main() {{
let v: Vec[i64] = [10, 20, 30];
let s: Slice[i64] = v[1..3];
println(s.first_or(-1).to_string());
}}
