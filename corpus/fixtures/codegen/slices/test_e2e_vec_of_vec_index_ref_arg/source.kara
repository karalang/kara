
fn make() -> Vec[char] {
    let mut v: Vec[char] = Vec.with_capacity(4);
    v.push('a');
    v.push('b');
    v
}
fn sumlen(r: ref Vec[char]) -> i64 {
    r.len()
}
fn main() {
    let mut stake: Vec[Vec[char]] = Vec.with_capacity(2);
    stake.push(make());
    stake.push(make());
    let mut sum: i64 = 0;
    let mut k: i64 = 0;
    while k < 200 {
        let idx: i64 = k % 2;
        sum = sum + sumlen(stake[idx]);
        k = k + 1;
    }
    println(sum);
}
