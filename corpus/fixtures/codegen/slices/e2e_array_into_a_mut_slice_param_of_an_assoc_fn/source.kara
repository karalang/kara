struct H { acc: i64 }
impl H {
fn f(b: mut Slice[u8]) -> i64 { b[0] = 9u8; b.len() }
}
fn free_f(b: mut Slice[u8]) -> i64 { b[0] = 8u8; b.len() }
fn main() {
let mut bm: Array[u8, 3] = [10u8, 20u8, 30u8];
println(H.f(mut bm));
println(bm[0]);
let mut cm: Array[u8, 3] = [10u8, 20u8, 30u8];
println(free_f(mut cm));
println(cm[0]);
}