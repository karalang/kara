#[derive(Clone)]
struct Pair { word: String, n: i64 }
fn passthru(p: Pair) -> Pair { p }
fn takes(s: String) -> Pair { Pair { word: s + "!", n: 1 } }
fn join(a: String, b: String) -> Pair { Pair { word: a + b, n: 2 } }
fn peek(p: ref Pair) -> String { p.word }
fn main() {
let k = 1;
let mut ps: Vec[Pair] = Vec.new();
ps.push(Pair { word: f"a{k}", n: 7 });
ps.push(Pair { word: f"b{k}", n: 8 });
ps[0] = passthru(ps[0].clone());
println(f"{ps[0].word} {ps[0].n}");
ps[0] = takes(ps[0].word);
println(f"{ps[0].word} {ps[0].n}");
ps[0] = join(ps[0].word, ps[1].word);
println(f"{ps[0].word} {ps[1].word}");
ps[0] = Pair { word: peek(ps[0]), n: 9 };
println(f"{ps[0].word} {ps[0].n}");
}