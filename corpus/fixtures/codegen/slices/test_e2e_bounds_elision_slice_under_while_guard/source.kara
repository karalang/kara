
fn sum_first(xs: Slice[i64], k: i64) -> i64 {
    let mut i = 0i64;
    let mut acc = 0i64;
    let n = xs.len();
    while i >= 0 and i < n and i < k {
        acc = acc + xs[i];
        i = i + 1;
    }
    acc
}
fn main() {
    let arr: Array[i64, 5] = [10, 20, 30, 40, 50];
    println(sum_first(arr, 3));
}
