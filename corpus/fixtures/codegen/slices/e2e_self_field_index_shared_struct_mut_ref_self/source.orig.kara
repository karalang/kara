shared struct Bag { mut items: Vec[i64] }
impl Bag {
fn push(mut ref self, v: i64) { self.items.push(v); }
fn get(mut ref self, i: u64) -> i64 { self.items[i] }
fn set(mut ref self, i: u64, v: i64) { self.items[i] = v; }
}
fn main() {
let b = Bag { items: Vec.new() };
b.push(10); b.push(20); b.push(30);
b.set(1, 99);
println(b.get(0));
println(b.get(1));
println(b.get(2));
}