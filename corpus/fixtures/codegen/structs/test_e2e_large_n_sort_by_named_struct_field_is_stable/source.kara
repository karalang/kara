
struct Rec { k: i64, tag: i64 }
fn main() {
    let mut v: Vec[Rec] = Vec.new();
    let mut i: i64 = 0;
    while i < 90 {
        v.push(Rec { k: i % 9, tag: i });
        i = i + 1;
    }
    v.sort_by(|a, b| a.k.cmp(b.k));
    let mut bad: i64 = 0;
    let mut pk: i64 = -1;
    let mut pt: i64 = -1;
    let mut j: i64 = 0;
    while j < 90 {
        let r = v.get(j).unwrap();
        if r.k < pk { bad = bad + 1; }
        if r.k == pk {
            if r.tag < pt { bad = bad + 1; }
        }
        pk = r.k;
        pt = r.tag;
        j = j + 1;
    }
    println(bad);
}
