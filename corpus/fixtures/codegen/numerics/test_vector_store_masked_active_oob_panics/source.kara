
fn fill(xs: mut Slice[i64]) {
    let v = Vector[i64, 4](10, 20, 30, 40);
    let idx = Vector[i64, 4](0, 1, 2, 3);
    let lim = Vector[i64, 4](9, 9, 9, 9);
    let m = idx < lim;
    v.store_masked(xs, m);
}
fn main() {
    let mut a: Array[i64, 2] = [0, 0];
    fill(mut a);
    println(a[0]);
}
