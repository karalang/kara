
fn make_map(n: i64) -> Map[String, i64] {
    let mut m: Map[String, i64] = Map.new();
    m.insert("a", n);
    m
}

fn pick() -> Map[String, i64] {
    let mut i = 0;
    loop {
        i = i + 1;
        if i == 2 { break make_map(i * 7) }
    }
}

fn main() { println(pick().get("a").unwrap()); }
