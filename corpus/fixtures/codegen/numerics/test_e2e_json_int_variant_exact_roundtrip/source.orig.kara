fn describe(j: Json) -> String {
match j {
Json.Null => "null",
Json.Bool(b) => "bool",
Json.Number(f) => "num",
Json.Int(i) => "int:" + i.to_string(),
Json.String(s) => "str",
Json.Array(xs) => "arr",
Json.Object(kv) => "obj",
}
}
fn main() {
let o: Json = Json.Object(Vec[("id", Json.Int(1))]);
println(o.stringify());
match Json.parse("{\"n\":9007199254740993}") {
Ok(j) => println(j.stringify()),
Err(_) => println("err"),
}
match Json.parse("[7, 2.5, 1.0]") {
Ok(j) => println(j.stringify()),
Err(_) => println("err"),
}
println(Json.Int(-42).stringify());
match Json.parse("41") {
Ok(j) => println(describe(j)),
Err(_) => println("err"),
}
match Json.parse("4.5") {
Ok(j) => println(describe(j)),
Err(_) => println("err"),
}
}
