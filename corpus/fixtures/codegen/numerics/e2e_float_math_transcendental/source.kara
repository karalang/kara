fn main() {
println(f"{(0.0f64).sin()}");
println(f"{(0.0f64).cos()}");
println(f"{(0.0f64).tan()}");
println(f"{(0.0f64).exp()}");
println(f"{(1.0f64).ln()}");
println(f"{(1024.0f64).log2()}");
println(f"{(2.0f64).pow(10.0f64)}");
println(f"{(0.0f64).atan2(1.0f64)}");
println(f"{(2.7f64).floor()}");
println(f"{(2.2f64).ceil()}");
println(f"{(2.5f64).round()}");
println(f"{(-2.5f64).round()}");
}