
#[derive(PartialEq, Eq, PartialOrd, Ord)]
struct Pt { x: i64, y: i64 }

fn main() {
    let mut v: Vec[Pt] = Vec.new();
    v.push(Pt { x: 3i64, y: 1i64 });
    v.push(Pt { x: 1i64, y: 9i64 });
    v.push(Pt { x: 3i64, y: 0i64 });
    v.push(Pt { x: 1i64, y: 2i64 });
    v.sort_by_key(|p| p);
    for p in v.iter() {
        println(p.x);
        println(p.y);
    }
}
