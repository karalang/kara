fn main() {
println((2.1_f64).to_bits());
println((0.0_f64).to_bits());
println((-0.0_f64).to_bits());
let b: i64 = (2.1_f64).to_bits() as i64;
println(b.bits_as_f64());
println((1.5_f64).to_bits32());
let b32: i64 = (1.5_f64).to_bits32();
println(b32.bits_as_f32());
let mut acc: i64 = 0i64;
acc = acc ^ ((2.0_f64).to_bits() as i64);
acc = acc ^ ((3.0_f64).to_bits() as i64);
println(acc);
}