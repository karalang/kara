
fn main() {
    let x = Vector[f32, 4].from_array([1.0f32, 2.0f32, 10.0f32, 0.5f32]);
    let l = x.ln();
    println(l[0]); println(l[1]); println(l[2]); println(l[3]);
    let d = Vector[f32, 4].from_array([0.0f32, -1.0f32, 1.0f32, 1.0f32]);
    let ld = d.ln();
    println(ld[0]); println(ld[1]);
}
