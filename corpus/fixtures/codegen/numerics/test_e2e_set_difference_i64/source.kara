
fn main() {
    let mut a: Set[i64] = Set.new();
    a.insert(1_i64);
    a.insert(2_i64);
    a.insert(3_i64);
    let mut b: Set[i64] = Set.new();
    b.insert(2_i64);
    b.insert(3_i64);
    b.insert(4_i64);
    let d: Set[i64] = a.difference(b);
    println(d.len());
    println(d.contains(1_i64));
    println(d.contains(2_i64));
    println(d.contains(3_i64));
    println(d.contains(4_i64));
}
