fn main() {
let a: F32 = F32 { value: 2.5 };
let b: F32 = F32 { value: 1.5 };
println(a > b);
println(a < b);
println(a == a);
println(a == b);
println(a.value + b.value);
let mut m: Map[F32, i64] = Map.new();
let _ = m.insert(F32 { value: 2.0 }, 20);
let _ = m.insert(F32 { value: 3.0 }, 30);
match m.get(F32 { value: 2.0 }) { Some(v) => println(v), None => println(0 - 1) }
let mut v: Vec[F32] = Vec.new();
v.push(F32 { value: 3.0 });
v.push(F32 { value: 1.0 });
v.push(F32 { value: 2.0 });
v.sort();
println(v[0].value);
println(v[2].value);
let neg0: F64 = F64 { value: 0.0 * (0.0 - 1.0) };
let pos0: F64 = F64 { value: 0.0 };
println(neg0 < pos0);
println(neg0 == pos0);
}