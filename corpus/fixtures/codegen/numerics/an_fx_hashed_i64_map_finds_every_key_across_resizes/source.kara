fn probe(n: i64) -> i64 {
    let mut m: Map[i64, i64, FxBuildHasher] = Map.new();
    let mut i = 0;
    while i < n { m.insert(i, i * 3); i = i + 1; }
    let mut bad = 0;
    let mut j = 0;
    while j < n {
        if not m.contains_key(j) { bad = bad + 1; }
        if m.get(j).unwrap_or(-1) != j * 3 { bad = bad + 1; }
        j = j + 1;
    }
    if m.len() != n { bad = bad + 1; }
    return bad;
}
fn main() {
    println(probe(16) + probe(64) + probe(100) + probe(1000));
}
