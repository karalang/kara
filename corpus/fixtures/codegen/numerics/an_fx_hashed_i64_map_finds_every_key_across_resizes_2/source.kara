fn main() {
    let mut m: Map[char, i64, FxBuildHasher] = Map.new();
    let src = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    let mut i = 0;
    for c in src.chars() { m.insert(c, i); i = i + 1; }
    let mut bad = 0;
    for c in src.chars() { if not m.contains_key(c) { bad = bad + 1; } }
    println(bad);
}
