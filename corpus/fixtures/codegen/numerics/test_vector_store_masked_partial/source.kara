
fn fill(xs: mut Slice[i64]) {
    let v = Vector[i64, 4](10, 20, 30, 40);
    let idx = Vector[i64, 4](0, 1, 2, 3);
    let lim = Vector[i64, 4](2, 2, 2, 2);
    let m = idx < lim;
    v.store_masked(xs, m);
}
fn main() {
    let mut a: Array[i64, 4] = [1, 2, 3, 4];
    fill(mut a);
    println(a[0]); println(a[1]); println(a[2]); println(a[3]);
}
