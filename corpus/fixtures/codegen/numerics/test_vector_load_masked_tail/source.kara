
fn main() {
    let a: Array[i64, 6] = [10, 20, 30, 40, 50, 60];
    let tail = a[0..2];
    let idx = Vector[i64, 4](0, 1, 2, 3);
    let lim = Vector[i64, 4](2, 2, 2, 2);
    let m = idx < lim;
    let v = Vector[i64, 4].load_masked(tail, m);
    println(v[0]); println(v[1]); println(v[2]); println(v[3]);
}
