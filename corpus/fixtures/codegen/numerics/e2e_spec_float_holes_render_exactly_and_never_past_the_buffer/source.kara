
fn main() {
    let x: f64 = 1.5;
    let y: f64 = 3.0;
    let z: f64 = 1.23456;
    let n: f64 = -2.5;
    let b: f64 = 1234567.891;
    let huge: f64 = 1.7976931348623157e308;
    println(f"[{z:.2}][{z:.0}][{z:.5}]");
    println(f"[{z:10.2}][{z:<10.2}][{z:010.2}]");
    println(f"[{n:.2}][{n:08.2}][{n:<8.2}]");
    println(f"[{y:.1}][{y:.3}][{b:.2}]");
    println(f"[{x}][{y}][{z}][{n}]");
    println(f"[{z:^10.2}][{z:*>10.2}]");
    println(f"H[{huge:.2}]");
}
