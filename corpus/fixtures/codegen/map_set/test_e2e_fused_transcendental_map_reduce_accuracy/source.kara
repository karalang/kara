fn main() {
let mut t: Tensor[f32, [20]] = Tensor.zeros(vec![20]);
for i in 0..20 { t[i] = (i) as f32 * 0.1f32 - 1.0f32; }
let got: f32 = t.map(|x| x.exp()).sum();
let mut want: f32 = 0.0f32;
for i in 0..20 { want = want + ((i) as f32 * 0.1f32 - 1.0f32).exp(); }
let d: f32 = got - want;
let ad: f32 = if d < 0.0f32 { 0.0f32 - d } else { d };
println(ad < 0.01f32);
}
