struct Acct { name: String, txns: i64 }
fn main() {
let mut m: Map[String, Acct] = Map.new();
m.insert("a".to_string(), Acct { name: "alice".to_string(), txns: 2 });
m.insert("b".to_string(), Acct { name: "bob".to_string(), txns: 1 });
let a = m.get("a").unwrap();
let b = m.get("b").unwrap();
println(f"{a.name}:{a.txns},{b.name}:{b.txns}");
let mut mi: Map[i64, Acct] = Map.new();
mi.insert(7, Acct { name: "carol".to_string(), txns: 9 });
let c = mi.get(7).unwrap();
println(f"{c.name}:{c.txns}");
}