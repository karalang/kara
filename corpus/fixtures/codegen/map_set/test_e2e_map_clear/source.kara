
fn main() {
    let mut m: Map[i64, i64] = Map.new();
    m.insert(1_i64, 10_i64);
    m.insert(2_i64, 20_i64);
    m.insert(3_i64, 30_i64);
    println(m.len());
    m.clear();
    println(m.len());
    println(m.is_empty());
    m.insert(7_i64, 70_i64);
    println(m[7_i64]);
    println(m.contains_key(1_i64));
}
