fn mk_set(n: i64) -> Set[i64] {
println("B");
let mut s: Set[i64] = Set.new();
let mut i = 0;
while i < n { s.insert(i); i = i + 1; }
return s;
}
fn mk_map(n: i64) -> Map[String, i64] {
let mut m: Map[String, i64] = Map.new();
let mut i = 0;
while i < n { m.insert(f"k{i}", i); i = i + 1; }
return m;
}
fn main() {
println(mk_set(3).len().to_string());
println(mk_set(3).is_empty().to_string());
println(mk_set(3).contains(2).to_string());
println(mk_map(2).len().to_string());
println(mk_map(2).contains_key("k0").to_string());
}
