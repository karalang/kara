
fn main() {
    let mut m: Map[i64, i64] = Map.new();
    m.entry(5_i64).and_modify(|v| { v += 1; }).or_insert(1_i64);
    m.entry(5_i64).and_modify(|v| { v += 1; }).or_insert(1_i64);
    m.entry(5_i64).and_modify(|v| { v += 1; }).or_insert(1_i64);
    let v = m.get(5_i64);
    match v {
        Some(x) => println(x),
        None => println(0_i64),
    }
}
