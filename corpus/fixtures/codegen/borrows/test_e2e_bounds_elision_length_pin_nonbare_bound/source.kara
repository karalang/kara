
fn build(rows: i64, cols: i64) -> i64 {
    let mut dp: Vec[i64] = Vec.new();
    let mut j = 0i64;
    while j < cols + 1i64 { dp.push(1i64); j = j + 1i64; }
    let mut r = 1i64;
    while r < rows {
        let mut c = 1i64;
        while c < cols + 1i64 { dp[c] = dp[c] + dp[c - 1i64]; c = c + 1i64; }
        r = r + 1i64;
    }
    dp[cols]
}
fn main() { println(build(7i64, 2i64)); }
