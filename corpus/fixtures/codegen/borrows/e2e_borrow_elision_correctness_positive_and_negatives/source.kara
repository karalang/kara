fn main() {
let mut out: Vec[Vec[i64]] = Vec.new();
let mut b: Vec[i64] = Vec.new(); b.push(1i64);
let mut k = 0i64; while k < 4i64 { out.push(b.clone()); k = k + 1i64; }
let mut acc = 0i64; let m = out.len(); let mut j = 0i64;
while j < m { let r = ref out[j]; let mut i = 0i64; let rl = r.len();
while i < rl { acc = acc + r[i]; i = i + 1i64; } j = j + 1i64; }
println(f"{acc}");
}