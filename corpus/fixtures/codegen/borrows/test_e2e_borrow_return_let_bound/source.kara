struct User { name: String, age: i64 }
fn name_of(u: ref User) -> ref String { ref u.name }
fn age_of(p: ref User) -> ref i64 { p.age }
fn fwd(s: ref String) -> ref String { s }
fn main() {
    let u = User { name: "ada", age: 36 };
    let n = name_of(u); println(n);
    let a = age_of(u); println(a);
    let s = "hello"; let f = fwd(s); println(f);
}
