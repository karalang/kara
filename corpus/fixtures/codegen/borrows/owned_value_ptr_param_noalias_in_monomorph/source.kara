
fn tsum[T](t: Tensor[T, [2, 2]]) -> i64 { return t.rank(); }
fn keep[T](x: T) -> T { return x; }
fn main() {
    let a: Tensor[f64, [2, 2]] = Tensor.zeros([2, 2]);
    print(tsum(a));
    let b: Tensor[f64, [2, 2]] = Tensor.zeros([2, 2]);
    let c: Tensor[f64, [2, 2]] = keep(b);
    print(c.rank());
}
