
fn check_within(v: ref Vec[i64]) -> i64 {
    let n = v.len();
    let mut i = 0i64;
    let mut acc = 0i64;
    while i >= 0 and i < n + 1 {
        acc = acc + v[i];
        i = i + 1;
    }
    acc
}
fn main() {
    let mut v: Vec[i64] = Vec.new();
    v.push(10);
    v.push(20);
    println(check_within(v));
}
