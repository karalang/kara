fn main() {
let mut out: Vec[Vec[i64]] = Vec.new();
let mut b: Vec[i64] = Vec.new(); b.push(7i64);
let mut k = 0i64; while k < 4i64 { out.push(b.clone()); k = k + 1i64; }
let mut keep: Vec[Vec[i64]] = Vec.new();
let mut j = 0i64; while j < out.len() { let r = out[j].clone(); keep.push(r); j = j + 1i64; }
let mut acc = 0i64; let mut i = 0i64;
while i < keep.len() { let z = ref keep[i]; acc = acc + z[0i64]; i = i + 1i64; }
println(f"{acc}");
}