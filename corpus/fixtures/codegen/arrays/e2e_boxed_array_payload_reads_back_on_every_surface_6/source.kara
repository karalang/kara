struct R8 { id: i64 }
impl Drop for R8 { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn plainD(x: Option[Array[R8, 2]]) {
    match x { Some(t) => { println(f"s:{t[0].id}") } None => { println("n") } }
}
fn main() {
    let a: Array[R8, 2] = [R8 { id: 1 }, R8 { id: 2 }];
    plainD(Some(a));
    println("end");
}
