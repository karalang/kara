fn first[T: Clone](s: ref Slice[T]) -> T { s[0].clone() }
fn main() {
    let a1: Array[i64, 2] = [100, 7];
    let a2: Array[String, 2] = ["own-" + "alpha", "own-" + "beta"];
    println(f"[{first(a1)}]");
    println(f"[{first(a2)}]");
    let b1: Array[String, 2] = ["own-" + "gamma", "own-" + "delta"];
    let b2: Array[i64, 2] = [42, 9];
    println(f"[{first(b1)}]");
    println(f"[{first(b2)}]");
}