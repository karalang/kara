struct R { id: i64, s: String }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}") } }
fn mkr(i: i64) -> R { return R { id: i, s: f"aaa" } }
fn loc(a: own Array[R, 2]) -> i64 { let mut v: Vec[Array[R, 2]] = []; v.push(a); println(f"loc{v.len()}"); return 1 }
fn outv(a: own Array[R, 2], out: mut ref Vec[Array[R, 2]]) -> i64 { out.push(a); println("out"); return 1 }
fn retv(a: own Array[R, 2]) -> Vec[Array[R, 2]] { let mut v: Vec[Array[R, 2]] = []; v.push(a); println("ret"); return v }
fn st(a: own R) -> i64 { let mut v: Vec[R] = []; v.push(a); println(f"st{v.len()}"); return 1 }
fn ins(a: own Array[R, 2]) -> i64 { let mut v: Vec[Array[R, 2]] = []; v.insert(0, a); println(f"ins{v.len()}"); return 1 }
fn vnew(a: own Array[R, 2]) -> i64 { let mut v: Vec[Array[R, 2]] = Vec.new(); v.push(a); println(f"new{v.len()}"); return 1 }
fn two(a: own Array[R, 2], b: own Array[R, 2]) -> i64 { let mut v: Vec[Array[R, 2]] = []; v.push(a); v.push(b); println(f"two{v.len()}"); return 1 }
struct H { k: i64 }
impl H { fn meth(self, a: own Array[R, 2]) -> i64 { let mut v: Vec[Array[R, 2]] = []; v.push(a); println(f"meth{v.len()}"); return 1 } }
fn main() {
    { let a: Array[R, 2] = [mkr(1), mkr(2)]; let z = loc(a); println("k1") }
    { let mut o: Vec[Array[R, 2]] = []; { let a: Array[R, 2] = [mkr(3), mkr(4)]; let z = outv(a, mut o); println("k2") } println(f"n{o.len()}") }
    { let a: Array[R, 2] = [mkr(5), mkr(6)]; let v = retv(a); println(f"k3 {v.len()}") }
    { let a = mkr(7); let z = st(a); println("k4") }
    { let a: Array[R, 2] = [mkr(8), mkr(9)]; let z = ins(a); println("k5") }
    { let a: Array[R, 2] = [mkr(10), mkr(11)]; let z = vnew(a); println("k6") }
    { let z = loc([mkr(12), mkr(13)]); println("k7") }
    { let a: Array[R, 2] = [mkr(14), mkr(15)]; let b: Array[R, 2] = [mkr(16), mkr(17)]; let z = two(a, b); println("k8") }
    { let h = H { k: 1 }; let a: Array[R, 2] = [mkr(18), mkr(19)]; let z = h.meth(a); println("k9") }
    println("end")
}
