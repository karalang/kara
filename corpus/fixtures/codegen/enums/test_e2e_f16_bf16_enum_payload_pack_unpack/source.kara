fn mk(x: f16, y: f16) -> Option[(f16, f16)] {
Some((x, y))
}
fn mk1(x: f16) -> Option[f16] {
if x > 0.0f16 { Some(x) } else { None }
}
fn mkb(x: bf16) -> Option[bf16] {
Some(x)
}
fn main() {
let o: Option[(f16, f16)] = Some((1.5f16, 2.5f16));
match o { Some(p) => println(p.0 + p.1), None => println(0.0f16) }
match mk(0.25f16, 0.75f16) { Some((a, b)) => println(a + b), None => println(0.0f16) }
match mk1(3.5f16) { Some(v) => println(v), None => println(0.0f16) }
match mkb(1.25bf16) { Some(v) => println(v + 0.5bf16), None => println(0.0bf16) }
let r: Result[f16, String] = Ok(2.0f16);
match r { Ok(v) => println(v * 3.0f16), Err(e) => println(e) }
}