             struct P { a: String, b: i64 }
enum G1[T] { Y(T), N }
enum G2[T] { Y(T) }

fn glen[T](g: G1[T]) -> i64 {
match g { G1.Y(v) => { return 1; } G1.N => { return 0; } }
}
fn gplain[T](g: G1[T]) -> i64 { return 7; }
fn g2len[T](g: G2[T]) -> i64 { return 7; }

fn main() {
let a: Array[String, 2] = [f"b1610-arr-aaaaaaaaaaaa", f"b1610-arr-bbbbbbbbbbbb"];
let ga: G1[Array[String, 2]] = G1.Y(a);
println(f"arr {glen(ga)}");

let a1: Array[String, 1] = [f"b1610-one-cccccccccccc"];
let g1: G1[Array[String, 1]] = G1.Y(a1);
println(f"one {glen(g1)}");

let gi: G1[Array[i64, 2]] = G1.Y([3, 4]);
println(f"ints {glen(gi)}");

let gs: G1[String] = G1.Y(f"b1610-str-dddddddddddd");
println(f"str {glen(gs)}");

let gv: G1[Vec[String]] = G1.Y([f"b1610-vec-eeeeeeeeeeee"]);
println(f"vec {gplain(gv)}");

let gn: G1[String] = G1.Y(f"b1610-nomatch-ffffffffffff");
println(f"nomatch {gplain(gn)}");

let gu: G2[String] = G2.Y(f"b1610-unit-gggggggggggg");
println(f"unit {g2len(gu)}");

let gp: G1[P] = G1.Y(P { a: f"b1610-struct-hhhhhhhhhhhh", b: 2 });
println(f"struct {glen(gp)}");

let gt: G1[(String, i64)] = G1.Y((f"b1610-tuple-iiiiiiiiiiii", 3));
println(f"tuple {glen(gt)}");

let gvi: G1[Vec[i64]] = G1.Y([1, 2]);
println(f"veci {glen(gvi)}");
}