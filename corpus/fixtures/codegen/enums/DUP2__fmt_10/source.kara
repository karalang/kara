#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
struct A {}
struct B {}
impl A { fn dup(o: Option[Q]) -> R { match o { Some(t) => { return t.r.clone(); } None => { return R { id: 0 }; } } } }
impl B { fn dup(o: Option[Q]) -> R { match o { Some(t) => { return t.r.clone(); } None => { return R { id: 0 }; } } } }
fn main() { let mut i = 0; while i < 2 { let g = A.dup(Some(Q { r: R { id: 5 }, s: R { id: 6 } })); println(f"it:{g.id}"); i = i + 1; } println("end") }
