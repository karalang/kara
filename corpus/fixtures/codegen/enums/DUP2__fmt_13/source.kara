#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
struct Z {}
impl Z { fn zdup(o: Option[Q]) -> R { match o { Some(t) => { return t.r.clone(); } None => { return R { id: 0 }; } } } }
fn main() { let g = Z.zdup(Some(Q { r: R { id: 5 }, s: R { id: 6 } })); println(f"got:{g.id}"); println("end") }
