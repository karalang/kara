{R}struct H {{ n: i64 }}
impl H {{ fn eat(ref self, o: Option[(R, R)]) -> R {{ match o {{ Some(t) => {{ return t.0; }} None => {{ return R {{ id: 0 }}; }} }} }} }}
fn main() {{ let h = H {{ n: 1 }}; let mut i = 0i64; while i < 2 {{ let g = h.eat({ARG}); println(f"it:{{g.id}}"); i = i + 1; }} println("end") }}
