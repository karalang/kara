struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
struct A {}
struct B {}
impl A { fn dup(o: Option[Q]) { match o { Some(t) => { println("mid"); } None => { println("n"); } } } }
impl B { fn dup(o: Option[Q]) { match o { Some(t) => { println("mid"); } None => { println("n"); } } } }
fn main() { A.dup(Some(Q { r: R { id: 5 }, s: R { id: 6 } })); println("end") }
