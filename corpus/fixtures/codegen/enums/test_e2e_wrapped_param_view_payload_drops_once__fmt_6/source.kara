struct R { id: i64 }
impl Drop for R {
    fn drop(mut ref self) { println(f"dR{self.id}") }
}
enum Box2 { Full(R), Empty }
enum W { One(R), None2 }
fn take() -> i64 {
    let m = R { id: 1 };
    let w = W.One(m);
    match w { W.One(z) => { z.id } W.None2 => { 0 } }
}
fn main() { let v = take(); println(f"v={v}"); }