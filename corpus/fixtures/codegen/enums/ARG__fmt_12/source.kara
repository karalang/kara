#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct H { n: i64 }
impl H { fn eat(ref self, o: Option[(R, R)]) -> R { match o { Some(t) => { return t.0.clone(); } None => { return R { id: 0 }; } } } }
fn main() { let h = H { n: 1 }; let mut i = 0; while i < 2 { let g = h.eat(Some((R { id: 5 }, R { id: 6 }))); println(f"it:{g.id}"); i = i + 1; } println("end") }
