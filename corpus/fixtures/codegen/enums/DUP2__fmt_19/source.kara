struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
struct Z {}
impl Z { fn zdup(o: Option[Q]) { match o { Some(t) => { println("mid"); } None => { println("n"); } } } }
fn main() { Z.zdup(Some(Q { r: R { id: 5 }, s: R { id: 6 } })); println("end") }
