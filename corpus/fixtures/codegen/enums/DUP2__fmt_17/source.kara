struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct A {}
struct B {}
impl A { fn dup(o: Option[(R, R)]) { match o { Some(t) => { println("mid"); } None => { println("n"); } } } }
impl B { fn dup(o: Option[(R, R)]) { match o { Some(t) => { println("mid"); } None => { println("n"); } } } }
fn main() { A.dup(Some((R { id: 5 }, R { id: 6 }))); println("end") }
