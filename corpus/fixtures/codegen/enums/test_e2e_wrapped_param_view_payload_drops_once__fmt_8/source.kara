struct R { id: i64 }
impl Drop for R {
    fn drop(mut ref self) { println(f"dR{self.id}") }
}
enum Box2 { Full(R), Empty }
enum W { One(R), None2 }
fn take(o: Box2) -> W {
    match o { Box2.Full(r) => { W.One(r) } Box2.Empty => { W.None2 } }
}
fn main() {
    let o: Box2 = Box2.Full(R { id: 1 });
    let w = take(o);
    println("mid");
}