struct Sp4n {{ a: i64, b: i64, c: i64, d: i64 }}
shared struct Sh {{ v: i64 }}
shared enum E {{ Lit(i64), Iff(IfNode), Blk(Block) }}
struct Block {{ stmts: Vec[i64], {extra} pad: Option[String], sp: Sp4n }}
struct IfNode {{ cond: E, then_block: Block, sp: Sp4n }}
fn mk_block(first: i64, s: i64) -> Block {{
    let mut v: Vec[i64] = Vec.new(); v.push(first); v.push(first + 1);
    let mut w: Vec[String] = Vec.new(); w.push(f"t{{first}}");
    return Block {{ stmts: v, {init} pad: Option.Some(f"p{{first}}"), sp: Sp4n {{ a: s, b: 0, c: 0, d: 0 }} }};
}}
fn mk() -> E {{ return E.Iff(IfNode {{ cond: E.Lit(7), then_block: mk_block(20, 2), sp: Sp4n {{ a: 5, b: 0, c: 0, d: 0 }} }}); }}
fn main() {{
    let ife = mk();
    match ife {{ E.Lit(n) => println(f"{{n}}"), E.Iff(nd) => {{ {use_expr} }}, E.Blk(_) => println("-9") }}
    println("end");
}}
