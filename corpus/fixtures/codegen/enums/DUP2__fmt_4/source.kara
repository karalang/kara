#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct A {}
struct B {}
impl A { fn dup(o: Option[(R, R)]) -> R { match o { Some(t) => { return t.0.clone(); } None => { return R { id: 0 }; } } } }
impl B { fn dup(o: Option[(R, R)]) -> R { match o { Some(t) => { return t.0.clone(); } None => { return R { id: 0 }; } } } }
fn main() { let g = A.dup(Some((R { id: 5 }, R { id: 6 }))); println(f"got:{g.id}"); println("end") }
