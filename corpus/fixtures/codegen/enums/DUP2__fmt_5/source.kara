#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
struct A {}
struct B {}
impl A { fn dup(o: Result[Q, i64]) -> R { match o { Ok(t) => { return t.r.clone(); } Err(e) => { return R { id: 0 }; } } } }
impl B { fn dup(o: Result[Q, i64]) -> R { match o { Ok(t) => { return t.r.clone(); } Err(e) => { return R { id: 0 }; } } } }
fn main() { let g = A.dup(Result.Ok(Q { r: R { id: 5 }, s: R { id: 6 } })); println(f"got:{g.id}"); println("end") }
