struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mkr(i: i64) -> R { return R { id: i } }
enum EVec { V(Vec[R]), N }
fn main() {
  let a: Vec[R] = [mkr(1), mkr(2)];
  let e: EVec = EVec.V(a);
  match e { EVec.V(v) => { println(f"x{v[0].id}") } EVec.N => { println("no") } }
  println("end")
}
