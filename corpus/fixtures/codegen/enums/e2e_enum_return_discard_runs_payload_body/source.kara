struct Res { id: i64, name: String }
impl Drop for Res {
    fn drop(mut ref self) {
        println(f"drop {self.id} {self.name}")
    }
}
enum Box2 { Full(Res), Empty }
enum MyBox[T] { Wrap(T), Nil }
enum Loud { Hold(Res), Quiet }
impl Drop for Loud {
    fn drop(mut ref self) {
        println("loud drop")
    }
}
struct Fac { tag: i64 }
impl Fac {
    fn make(ref self, n: i64) -> Box2 {
        return Box2.Full(Res { id: n, name: f"m{n}" });
    }
}
fn mk_enum(n: i64) -> Box2 {
    return Box2.Full(Res { id: n, name: f"h{n}" });
}
fn mk_gen(n: i64) -> MyBox[Res] {
    return MyBox.Wrap(Res { id: n, name: f"g{n}" });
}
fn mk_loud(n: i64) -> Loud {
    return Loud.Hold(Res { id: n, name: f"l{n}" });
}
fn mk_empty() -> Box2 {
    return Box2.Empty;
}
fn main() {
    println("a");
    let _ = mk_enum(1);
    println("b");
    mk_enum(2);
    println("c");
    let f = Fac { tag: 0 };
    let _ = f.make(3);
    f.make(4);
    println("d");
    let _ = mk_loud(5);
    mk_loud(6);
    println("e");
    let _ = mk_gen(7);
    mk_gen(8);
    println("f");
    let _ = mk_empty();
    mk_empty();
    println("end");
}
