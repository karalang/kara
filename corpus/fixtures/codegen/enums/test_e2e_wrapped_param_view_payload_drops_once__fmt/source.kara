struct R { id: i64 }
impl Drop for R {
    fn drop(mut ref self) { println(f"dR{self.id}") }
}
enum Box2 { Full(R), Empty }
enum W { One(R), None2 }
fn take(o: Box2) -> i64 {
    match o {
        Box2.Full(r) => {
            let m = r;
            let w = W.One(m);
            match w { W.One(z) => { z.id } W.None2 => { 0 } }
        }
        Box2.Empty => { 0 }
    }
}
fn main() {
    let o: Box2 = Box2.Full(R { id: 1 });
    let v = take(o);
    println(f"v={v}");
}