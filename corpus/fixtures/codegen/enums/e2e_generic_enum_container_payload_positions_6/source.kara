
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mkr(i: i64) -> R { return R { id: i }; }
struct P { id: i64 }
enum Ew { Z(R), N }
impl Drop for Ew { fn drop(mut ref self) { println("dER") } }
enum Slot[T] { S(T), N }
enum EVecG[T] { V(Vec[T]), N }
enum Mix[T] { A(T), B(Vec[T]), N }
enum G2[T] { X(T, i64), Y }
fn seenv(x: own Slot[Vec[R]]) { match x { Slot.S(v) => { println(f"x{v[0].id}") } Slot.N => { println("no") } } }

fn main() {
let i1: Vec[R] = [mkr(1)];
let i2: Vec[R] = [mkr(2)];
let a: Vec[Vec[R]] = [i1, i2];
let s: Slot[Vec[Vec[R]]] = Slot.S(a);
println("mid");
println("end");
}
