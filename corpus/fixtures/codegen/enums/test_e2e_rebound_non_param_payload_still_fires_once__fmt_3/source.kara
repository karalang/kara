struct R { id: i64 }
impl Drop for R {
    fn drop(mut ref self) { println(f"dR{self.id}") }
}
enum Box2 { Full(R), Empty }
fn take(o: Box2, p: R) -> i64 {
    let s = match o { Box2.Full(r) => { let m = r; m.id } Box2.Empty => { 0 } };
    s + p.id
}
fn main() {
    let o: Box2 = Box2.Full(R { id: 1 });
    let v = take(o, R { id: 2 });
    println(f"v={v}");
}