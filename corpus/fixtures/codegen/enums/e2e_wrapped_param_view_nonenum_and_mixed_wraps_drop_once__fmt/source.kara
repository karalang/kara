struct R { id: i64 }
impl Drop for R {
    fn drop(mut ref self) { println(f"dR{self.id}") }
}
enum W2 { Two(R, R), None3 }
struct S { r: R }
struct S2 { r: R, k: i64 }
struct S3 { a: R, b: R }
struct Sd { r: R }
impl Drop for Sd {
    fn drop(mut ref self) { println("dSd") }
}
fn take(r: R) -> S { S { r: r } }
fn main() { let s = take(R { id: 5 }); println("mid"); }