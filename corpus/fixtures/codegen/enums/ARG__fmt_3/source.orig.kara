struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct H { n: i64 }
impl H { fn eat(ref self, o: Result[(R, R), i64]) -> R { match o { Ok(t) => { return t.0; } Err(e) => { return R { id: 0 }; } } } }
fn main() { let h = H { n: 1 }; let g = h.eat(Result.Ok((R { id: 5 }, R { id: 6 }))); println(f"got:{g.id}"); println("end") }
