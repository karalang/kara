struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
struct H { n: i64 }
impl H { fn eat(ref self, o: Option[Q]) -> R { match o { Some(t) => { return t.r; } None => { return R { id: 0 }; } } } }
fn main() { let h = H { n: 1 }; let g = h.eat(Some(Q { r: R { id: 5 }, s: R { id: 6 } })); println(f"got:{g.id}"); println("end") }
