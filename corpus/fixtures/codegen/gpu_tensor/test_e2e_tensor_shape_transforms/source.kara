fn main() {
let a = Tensor.from([[1, 2, 3], [4, 5, 6]]);
let r = a.reshape([3, 2]);
println(r.rank());
let rs = r.shape();
println(rs[0]); println(rs[1]);
println(r[0,0]); println(r[0,1]); println(r[2,1]);
let p = a.permute([1, 0]);
let ps = p.shape();
println(ps[0]); println(ps[1]);
println(p[0,0]); println(p[0,1]); println(p[2,1]);
let sl = a.slice(1, 1, 3);
let sls = sl.shape();
println(sls[0]); println(sls[1]);
println(sl[0,0]); println(sl[1,1]);
let b = Tensor.from([[[7], [8], [9]]]);
let sq = b.squeeze();
println(sq.rank()); println(sq[0]); println(sq[2]);
let c = Tensor.from([[[1, 2]], [[3, 4]]]);
let sq1 = c.squeeze(1);
println(sq1.rank()); println(sq1[0,0]); println(sq1[1,1]);
}
