fn main() {
let t: Tensor[f32, [8]] = Tensor.from([-2.0, -1.0, -0.5, 0.0, 0.5, 1.0, 2.0, 3.0]);
let m = t.map(|x| 1.0f32 / (1.0f32 + (0.0f32 - x).exp()));
let xs: Tensor[f32, [8]] = Tensor.from([-2.0, -1.0, -0.5, 0.0, 0.5, 1.0, 2.0, 3.0]);
let mut ok: bool = true;
for i in 0..8 {
let want: f32 = 1.0f32 / (1.0f32 + (0.0f32 - xs[i]).exp());
let d: f32 = m[i] - want;
let ad: f32 = if d < 0.0f32 { 0.0f32 - d } else { d };
if ad > 0.001f32 { ok = false; }
}
println(ok);
}
