trait Zero { fn describe(ref self) -> String; }
impl Zero for Slice[i64] { fn describe(ref self) -> String { return f"S{self.len()}"; } }
impl Zero for Vec[i64] { fn describe(ref self) -> String { return f"V{self.len()}"; } }
fn via_param(s: ref Slice[i64]) -> String { return s.describe(); }
fn take_mut(s: mut Slice[i64]) -> String { return s.describe(); }
fn main() {
let mut v: Vec[i64] = Vec.new();
v.push(10);
v.push(20);
v.push(30);
let s: Slice[i64] = v[..];
println(s.describe());
println(s.len());
let sub: Slice[i64] = v[1..3];
println(sub.describe());
println(via_param(sub));
println(v.describe());
let mut w: Vec[i64] = Vec.new();
w.push(1);
w.push(2);
println(take_mut(w.as_slice_mut()));
}