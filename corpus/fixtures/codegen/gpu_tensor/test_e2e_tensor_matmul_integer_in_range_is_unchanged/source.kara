fn main() {
    let a: Tensor[i32, [?, ?]] = Tensor.from([[1, 2], [3, 4]]);
    let b: Tensor[i32, [?, ?]] = Tensor.from([[5, 6], [7, 8]]);
    let c = a.matmul(b);
    println(c[0, 0]); println(c[1, 1]);
    let u: Tensor[u32, [?, ?]] = Tensor.from([[1u32, 2u32]]);
    let v: Tensor[u32, [?, ?]] = Tensor.from([[3u32], [4u32]]);
    println(u.matmul(v)[0, 0]);
}