trait Zero { fn describe(ref self) -> String; }
impl[T] Zero for Vec[T] { fn describe(ref self) -> String { return f"VEC"; } }
impl[K: Hash + Eq, V] Zero for Map[K, V] { fn describe(ref self) -> String { return f"MAP"; } }
impl[T: Hash + Eq] Zero for Set[T] { fn describe(ref self) -> String { return f"SET"; } }
fn main() {
let mut v: Vec[i64] = Vec.new();
v.push(1);
let mut w: Vec[String] = Vec.new();
w.push("x");
let mut m: Map[String, i64] = Map.new();
m.insert("k", 1);
let mut s: Set[i64] = Set.new();
s.insert(7);
println(v.describe());
println(w.describe());
println(m.describe());
println(s.describe());
println(v.len());
}