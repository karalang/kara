
#[gpu]
fn poly(x: f32) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: i32 = 0;
    while i < 4 {
        acc = acc + x;
        i = i.wrapping_add(1);
    }
    acc * 2.0
}

fn main() {
    let mut v: Vec[f32] = Vec.new();
    v.push(1.0);
    let out = gpu.dispatch(poly, v);
    println(out[0] as i64);
}
