fn main() {
let m: Tensor[i64, [2, 3]] = Tensor.from([[1, 2, 3], [4, 5, 6]]);
let row: Tensor[i64, [1, 3]] = Tensor.from([[10, 20, 30]]);
let r = m.broadcast_add(row);
println(r[0, 0]); println(r[1, 2]);
let col: Tensor[i64, [2, 1]] = Tensor.from([[100], [200]]);
let c = m.broadcast_mul(col);
println(c[0, 1]); println(c[1, 0]);
let v: Tensor[i64, [3]] = Tensor.from([1, 2, 3]);
let d = m.broadcast_sub(v);
println(d[0, 0]); println(d[1, 1]);
// two singletons broadcast UP to [2, 3].
let g = row.broadcast_add(col);
println(g[1, 0]);
// fresh-temp argument (the `b + b` intermediate is freed).
let b: Tensor[i64, [1, 3]] = Tensor.from([[1, 1, 1]]);
let h = m.broadcast_add(b + b);
println(h[0, 0]);
// float division.
let fm: Tensor[f64, [2, 2]] = Tensor.from([[2.0, 4.0], [6.0, 8.0]]);
let fc: Tensor[f64, [2, 1]] = Tensor.from([[2.0], [4.0]]);
let fq = fm.broadcast_div(fc);
println(fq[1, 0]);
println(m[1, 2]);
}
