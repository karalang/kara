
import std.autograd.{TensorTape, TensorVar};
fn main() {
    let t = TensorTape.new();
    let x0: Tensor[f32, [?]] = Tensor.from([1.0, 2.0, 3.0]);
    let x = TensorVar.leaf(t, x0);
    let sq = x.mul(x);
    let loss = sq.sum();
    let lv = loss.value();
    println(f"{lv[0]}");
    loss.backward();
    println(x.grad_at(0));
    println(x.grad_at(1));
    println(x.grad_at(2));
}
