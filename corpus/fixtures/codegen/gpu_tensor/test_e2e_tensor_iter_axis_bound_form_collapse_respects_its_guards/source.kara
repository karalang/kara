fn main() {
let mut t: Tensor[f32, [4, 3]] = Tensor.zeros([4, 3]);
let mut i = 0;
while i < 4 {
let mut j = 0;
while j < 3 { t[i, j] = (i * 3 + j) as f32; j = j + 1; }
i = i + 1;
}
let ra = t.iter_axis(0);
let mut a: f32 = 0.0;
for row in ra { a = a + row.sum(); }
println(a.to_string());
let rb = t.iter_axis(0);
let mut b1: f32 = 0.0;
for row in rb { b1 = b1 + row.sum(); }
let mut b2: f32 = 0.0;
for row in rb { b2 = b2 + row.sum(); }
println((b1 + b2).to_string());
let rc = t.iter_axis(0);
println("mid");
let mut c: f32 = 0.0;
for row in rc { c = c + row.sum(); }
println(c.to_string());
let rd = t.iter_axis(0);
let n = rd.len();
let mut d: f32 = 0.0;
for row in rd { d = d + row.sum(); }
println((n as f32 + d).to_string());
}