fn row_sum(m: ref Vec[Vec[i64]], i: i64) -> i64 {
    let row = ref m[i];
    let mut s = 0i64;
    let mut j = 0i64;
    let n = row.len();
    while j < n { s = s + row[j]; j = j + 1i64; }
    s
}
fn main() {
    let mut m: Vec[Vec[i64]] = Vec.new();
    let mut a: Vec[i64] = Vec.new(); a.push(1i64); a.push(2i64); a.push(3i64);
    let mut b: Vec[i64] = Vec.new(); b.push(4i64); b.push(5i64); b.push(6i64);
    m.push(a); m.push(b);
    println(f"{row_sum(m, 0i64) + row_sum(m, 1i64)}");
}
