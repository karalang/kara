trait Head { fn first_or(ref self, d: i64) -> i64; }
impl Head for Slice[i64] {
fn first_or(ref self, d: i64) -> i64 {
if self.len() == 0 { return d; }
return self[0];
}
}
fn main() {
let v: Vec[i64] = [10, 20, 30];
println(v[0..3].first_or(-1).to_string());
let r = v[1..3].first_or(-1);
println(r.to_string());
let empty: Vec[i64] = [];
println(empty[0..0].first_or(-1).to_string());
}
