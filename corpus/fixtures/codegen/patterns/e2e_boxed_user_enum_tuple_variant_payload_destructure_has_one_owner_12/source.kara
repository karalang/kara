struct R25 { s: String }
enum K5 { A(R25), B }
impl Drop for K5 { fn drop(mut ref self) { println("dK5") } }
#[allow(partial_move_of_drop_enum)]
fn give(x: Option[K5]) -> R25 { match x { Option.Some(K5.A(r)) => { r } Option.Some(K5.B) => { R25 { s: f"b" } } Option.None => { R25 { s: f"n" } } } }
#[allow(partial_move_of_drop_enum)]
fn main() { let g = give(Option.Some(K5.A(R25 { s: f"z" }))); println(f"g:{g.s}"); println("end") }
