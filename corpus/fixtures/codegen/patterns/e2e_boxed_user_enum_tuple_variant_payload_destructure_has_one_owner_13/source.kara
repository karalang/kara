struct R25 { s: String }
enum K5 { A(R25), B }
impl Drop for K5 { fn drop(mut ref self) { println("dK5") } }
#[allow(partial_move_of_drop_enum)]
fn show(x: Result[K5, i64], acc: mut ref Vec[R25]) { match x { Result.Ok(K5.A(r)) => { acc.push(r) } Result.Ok(K5.B) => {} Result.Err(e) => { println(f"e:{e}") } } }
#[allow(partial_move_of_drop_enum)]
fn main() { let mut acc: Vec[R25] = []; show(Result.Ok(K5.A(R25 { s: f"z" })), mut acc); println(f"len:{acc.len()}"); println("end") }
