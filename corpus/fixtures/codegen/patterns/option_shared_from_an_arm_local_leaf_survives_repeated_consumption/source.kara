shared struct Node { val: i64 }
fn make(n: i64) -> Option[Node] { return Some(Node { val: n }); }
fn show(t: Option[Node]) -> i64 {
match t { None => { return 0; } Some(n) => { return n.val; } }
}
fn main() {
let b = make(2);
let t1 = if true { let u = make(1); u } else { b };
println(f"{show(t1)} {show(t1)} {show(t1)}");
let c = make(3);
let t2 = if false { c } else { let u = make(4); u };
println(f"{show(t2)} {show(t2)} {show(t2)}");
let t3 = if true { let u = make(5); u } else { let v = make(6); v };
println(f"{show(t3)} {show(t3)} {show(t3)}");
let d = make(7);
let t4 = if true { let u = d; u } else { b };
println(f"{show(t4)} {show(t4)} {show(t4)} {show(d)}");
let t5 = if true { let u = make(8); u } else { b };
println(f"{show(t5)} {show(t5)} {show(t5)} {show(t5)} {show(t5)}");
let k = 1;
let t6 = match k { 1 => { let u = make(9); u } _ => { b } };
println(f"{show(t6)} {show(t6)} {show(t6)}");
let t7 = if true { { let u = make(10); u } } else { b };
println(f"{show(t7)} {show(t7)} {show(t7)}");
let t8 = if false { b } else if true { let u = make(11); u } else { b };
println(f"{show(t8)} {show(t8)} {show(t8)}");
let t9 = if true { let u = make(12); u } else { None };
println(f"{show(t9)} {show(t9)} {show(t9)}");
let src2 = make(13);
let t10 = if let Some(n) = src2 { let u = make(n.val); u } else { b };
println(f"{show(t10)} {show(t10)} {show(t10)}");
let mut i = 0;
while i < 3 {
let t11 = if true { let u = make(20 + i); u } else { b };
println(f"{show(t11)} {show(t11)} {show(t11)}");
i = i + 1;
}
let t12 = if true { b } else { b };
println(f"{show(t12)} {show(t12)} {show(t12)}");
}