
fn main() {
    let mut q: VecDeque[(i64, i64)] = VecDeque.new();
    q.push_back((3, 30));
    q.push_back((7, 70));
    loop {
        match q.pop_front() {
            None => { break; },
            Some(node) => {
                let (a, b) = node;
                println(a);
                println(b);
            },
        }
    }
}
