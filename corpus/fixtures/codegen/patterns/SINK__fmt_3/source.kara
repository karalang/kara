#[derive(Clone)]
struct P { name: String }
impl Drop for P { fn drop(mut ref self) { println(f"dP[{self.name}]") } }
fn fp(o: Option[(P, P)]) -> P { match o { Some(t) => { return t.0.clone(); } None => { return P { name: "z" }; } } }
fn main() { let g = fp(Some((P { name: "a" }, P { name: "b" }))); println(f"got[{g.name}]"); println("end") }
