struct R5w { s: String, a: i64, b: i64 }
enum K5w { A(R5w), B }
fn nested(x: Result[K5w, i64]) { match x { Result.Ok(K5w.A(r)) => { println(f"n:{r.s}:{r.a}") } Result.Ok(K5w.B) => {} Result.Err(e) => { println("er") } } }
#[allow(partial_move_of_drop_enum)]
fn main() { nested(Result.Ok(K5w.A(R5w { s: f"ssssssss1", a: 7, b: 8 }))); println("end") }
