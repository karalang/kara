struct Res { id: i64, name: String }
impl Drop for Res {
    fn drop(mut ref self) { println(f"drop {self.id}") }
}
enum Box2 { Full(Res), Empty }
fn eat() -> i64 {
    let b: Box2 = Box2.Full(Res { id: 7, name: f"e7" });
    match b {
        Box2.Full(r) => { return r.id; }
        Box2.Empty => { return 0; }
    }
}
fn main() { let v: i64 = eat(); println(f"v={v}"); }