fn sign(n: i64) -> String {
match n {
-9223372036854775808 => return "min",
-10..=-1 => return "small-neg",
0 => return "zero",
1 | 2 => return "one-or-two",
_ => return "other",
}
}
fn main() {
println(sign(0i64 - 9223372036854775807i64 - 1i64));
println(sign(0i64 - 5i64));
println(sign(0i64));
println(sign(2i64));
println(sign(0i64 - 99i64));
let o: Option[i64] = Some(0i64 - 5i64);
match o { Some(-5) => println("payload"), _ => println("no") }
let q: Option[i64] = Some(5i64);
match q { Some(-5) => println("payload"), _ => println("no") }
let t = (0i64 - 1i64, 2i64);
match t { (-1, 2) => println("tuple"), _ => println("no") }
let f: f64 = 0.0 - 1.5;
match f { -1.5 => println("float"), _ => println("no") }
let g: f64 = 1.5;
match g { -1.5 => println("float"), _ => println("no") }
let w: i128 = 0i128 - 170141183460469231731687303715884105727i128 - 1i128;
match w { -170141183460469231731687303715884105728i128 => println("i128min"), _ => println("no") }
let s: i8 = 0i8 - 5i8;
match s { -128i8..=-1i8 => println("neg"), 0i8..=127i8 => println("nonneg") }
}