struct R2 { s: String }
enum K { A(R2), B }
impl Drop for K { fn drop(mut ref self) { println("dK") } }
fn show(x: Option[K], acc: mut ref Vec[R2]) {
match x { Option.Some(K.A(r)) => { println(f"a:{r.s}") } Option.Some(K.B) => {} Option.None => {} }
}
fn main() { let mut acc: Vec[R2] = []; show(Option.Some(K.A(R2 { s: f"z" })), mut acc); println(f"len:{acc.len()}"); println("end") }
