fn classify(n: i128) -> String {
match n {
0i128 => return "zero",
1267650600228229401496703205376i128 => return "2^100",
170141183460469231731687303715884105727i128 => return "i128max",
1000000000000000000000000000000i128..=2000000000000000000000000000000i128 => return "band",
_ => return "other",
}
}
fn uclassify(n: u128) -> String {
match n {
340282366920938463463374607431768211455u128 => return "umax",
170141183460469231731687303715884105728u128 => return "just-past-imax",
5u128 => return "five",
_ => return "other",
}
}
fn main() {
println(classify(0i128));
println(classify(1267650600228229401496703205376i128));
println(classify(170141183460469231731687303715884105727i128));
println(classify(1500000000000000000000000000000i128));
println(classify(7i128));
println(uclassify(340282366920938463463374607431768211455u128));
println(uclassify(170141183460469231731687303715884105728u128));
println(uclassify(5u128));
println(uclassify(9u128));
let b: u64 = 18446744073709551615u64;
match b { 18446744073709551615u64 => println("u64max"), _ => println("no") }
}