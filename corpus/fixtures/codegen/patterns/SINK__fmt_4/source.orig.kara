struct P { name: String }
impl Drop for P { fn drop(mut ref self) { println(f"dP[{self.name}]") } }
struct H { n: i64 }
impl H { fn ep(ref self, o: Option[(P, P)]) -> P { match o { Some(t) => { return t.0; } None => { return P { name: "z" }; } } } }
fn sink(r: P) { println(f"sank[{r.name}]") }
fn main() { let h = H { n: 1 }; sink(h.ep(Some((P { name: "a" }, P { name: "b" })))); }
