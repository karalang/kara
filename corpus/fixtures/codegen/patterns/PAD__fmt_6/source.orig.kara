enum E { A { s: String }, B }
fn pad(tag: i64) -> String {
let mut s: String = String.new();
s.push_str("payload-padded-out-well-past-thirty-six-bytes-");
s.push_str(f"{tag}");
return s;
}
                     fn main() {
                         let a: Option[E] = Some(E.A { s: pad(1) });
                         match a { Some(p) => { match p { E.A { s } => println(s.len()), E.B => {} } } None => {} }
                         match a { Some(p) => { match p { E.A { s } => println(s.len()), E.B => {} } } None => {} }
                     }
