
fn unwrap_or(o: Option[i64], d: i64) -> i64 {
    match o {
        Some(v) => v,
        None => d,
    }
}
fn describe(o: Option[i64]) -> i64 {
    match o {
        whole @ Some(x) => x + unwrap_or(whole, 0),
        None => -1,
    }
}
fn main() {
    println(describe(Some(7)));  // x=7, whole=Some(7) → 7 + 7 = 14
    println(describe(None));     // None arm → -1
}
