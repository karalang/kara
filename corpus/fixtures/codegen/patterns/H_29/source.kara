struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.name}") } }
fn main() { let o: Option[R] = Some(R { id: 1, name: f"z{9}" });
             let k = match o { Some(r) => { r }
                               None => { R { id: 0, name: f"e{0}" } } };
             println("kept"); }
