struct R25 { s: String }
struct Acc5 { held: R25 }
enum K5 { A(R25), B }
impl Drop for K5 { fn drop(mut ref self) { println("dK5") } }
#[allow(partial_move_of_drop_enum)]
fn show(x: Option[K5], acc: mut ref Acc5) { match x { Option.Some(K5.A(r)) => { acc.held = r; } Option.Some(K5.B) => {} Option.None => {} } }
#[allow(partial_move_of_drop_enum)]
fn main() { let mut acc = Acc5 { held: R25 { s: f"i" } }; show(Option.Some(K5.A(R25 { s: f"z" })), mut acc); println(f"h:{acc.held.s}"); println("end") }
