struct R25 { s: String }
enum Ks5 { A { r: R25 }, B }
impl Drop for Ks5 { fn drop(mut ref self) { println("dKs5") } }
#[allow(partial_move_of_drop_enum)]
fn show(x: Option[Ks5]) { match x { Option.Some(Ks5.A { r }) => { println(f"a:{r.s}") } Option.Some(Ks5.B) => {} Option.None => {} } }
#[allow(partial_move_of_drop_enum)]
fn main() { show(Option.Some(Ks5.A { r: R25 { s: f"z" } })); println("end") }
