struct W { s: String }
struct W2 { a: String, b: String }
struct Wv { v: Vec[i64] }
enum E { A(String) }
fn f(w: W) -> W { let g = || w; g() }
fn f2(w: W2) -> W2 { let g = || w; g() }
fn fv(w: Wv) -> Wv { let g = || w; g() }
fn fe(e: E) -> E { let g = || e; g() }
fn main() {
println(f(W { s: "one".to_string() }).s);
let r = f2(W2 { a: "two".to_string(), b: "three".to_string() });
println(r.a);
println(r.b);
println(fv(Wv { v: [1, 2, 3] }).v.len());
match fe(E.A("four".to_string())) { E.A(s) => println(s) }
}