
fn main() {
    let v: Vec[i64] = Vec[10, 20, 30];
    let a: Vec[i64] = v.iter().enumerate().map(|(i, x)| i + x).collect();
    println(f"{a.len()} {a[0]} {a[1]} {a[2]}");
    let words: Vec[String] = Vec["aa".to_string(), "bb".to_string(), "cc".to_string()];
    let b: Vec[String] = words.iter().enumerate().map(|(i, s)| s.clone()).collect();
    println(f"{b.len()} {b[0]}{b[2]} {words.len()}");
    let c: Vec[i64] = v.iter().enumerate().filter(|(i, x)| i % 2 == 0).map(|(i, x)| x).collect();
    println(f"{c.len()} {c[0]} {c[1]}");
    let d: Vec[i64] = v.iter().enumerate().map(|(_, x)| x * 2).collect();
    println(f"{d[0]} {d[2]}");
    let pairs: Vec[(i64, i64)] = Vec[(1, 10), (2, 20)];
    let e: Vec[i64] = pairs.iter().map(|(k, val)| k + val).collect();
    println(f"{e[0]} {e[1]}");
}
