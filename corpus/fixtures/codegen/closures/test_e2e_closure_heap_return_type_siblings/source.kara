enum Dir { N, S }
fn main() {
let m = |d: Dir| { match d { Dir.N => String.from("north"), Dir.S => String.from("south") } };
println(m(Dir.N));
let opt = |n: i64| { if n > 0 { Some(f"pos-{n}") } else { None } };
match opt(3) { Some(s) => println(s), None => println("none") }
let pair = || { let mut v = Vec.new(); v.push(9); (v, 100) };
let (vv, k) = pair();
println((vv[0] + k).to_string());
}