{WP_PREAMBLE}fn might_fail(x: i64) -> Result[i64, String] {{
if x > 5 {{ return Err("too big"); }}
Ok(x)
}}
fn probe(n: i64) -> Result[i64, String] with reads(Ctr) {{
let r = with_provider[Ctr](InMem {{ n: n }}, || {{
let v = might_fail(read())?;
Ok(v * 10)
}});
match r {{
Ok(v) => Ok(v),
Err(_) => Ok(-1),
}}
}}
fn main() with reads(Ctr) {{
println(f"{{probe(3).unwrap()}}");
println(f"{{probe(9).unwrap_or(-99)}}");
}}