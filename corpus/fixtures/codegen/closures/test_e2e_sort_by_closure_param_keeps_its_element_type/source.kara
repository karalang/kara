fn main() {
let mut v: Vec[Vec[i64]] = Vec.new();
let mut a: Vec[i64] = Vec.new(); a.push(1i64); a.push(2i64); a.push(3i64);
let mut b: Vec[i64] = Vec.new(); b.push(9i64);
let mut c: Vec[i64] = Vec.new(); c.push(4i64); c.push(5i64);
v.push(a); v.push(b); v.push(c);
v.sort_by(|x, y| x.len().cmp(y.len()));
println(f"{v[0].len()} {v[1].len()} {v[2].len()}");
}