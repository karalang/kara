fn make(k: i64) -> Fn(i64) -> i64 { |x| x + k }
fn build(n: i64) -> Vec[Fn(i64) -> i64] { let mut v: Vec[Fn(i64) -> i64] = Vec.new(); let mut i = 0i64; while i < n { v.push(make(i)); i = i + 1i64; } v }
fn main() { let r = build(4i64); let mut acc = 0i64; let mut j = 0i64; while j < r.len() { acc = acc + (r[j])(10i64); j = j + 1i64; } println(f"{acc}"); }
