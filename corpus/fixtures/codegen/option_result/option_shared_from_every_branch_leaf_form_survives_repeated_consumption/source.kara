shared struct Node { val: i64 }
fn make(n: i64) -> Option[Node] { return Some(Node { val: n }); }
fn show(t: Option[Node]) -> i64 {
match t { None => { return 0; } Some(n) => { return n.val; } }
}
fn main() {
let a1 = make(1); let b1 = make(2);
let t1 = if true { a1 } else { b1 };
println(f"{show(t1)} {show(t1)} {show(t1)}");
let a2 = make(3); let b2 = make(4);
let t2 = if false { a2 } else { b2 };
println(f"{show(t2)} {show(t2)} {show(t2)}");
let a3 = make(5); let b3 = make(6); let o3 = Some(1);
let t3 = if let Some(x) = o3 { a3 } else { b3 };
println(f"{show(t3)} {show(t3)} {show(t3)}");
let a4 = make(7); let b4 = make(8); let o4: Option[i64] = None;
let t4 = if let Some(y) = o4 { a4 } else { b4 };
println(f"{show(t4)} {show(t4)} {show(t4)}");
let a5 = make(9); let b5 = make(10); let k5 = 0;
let t5 = match k5 { 0 => a5, _ => b5 };
println(f"{show(t5)} {show(t5)} {show(t5)}");
let a6 = make(11);
let t6 = { a6 };
println(f"{show(t6)} {show(t6)} {show(t6)}");
let a7 = make(12); let b7 = make(13); let c7 = make(14); let k7 = 1;
let t7 = if k7 == 0 { a7 } else if k7 == 1 { b7 } else { c7 };
println(f"{show(t7)} {show(t7)} {show(t7)}");
let a8 = make(15); let b8 = make(16);
let t8 = if true { if true { a8 } else { b8 } } else { make(99) };
println(f"{show(t8)} {show(t8)} {show(t8)}");
let a9 = make(17);
let t9 = if true { a9 } else { make(99) };
println(f"{show(t9)} {show(t9)} {show(t9)}");
let a10 = make(18);
let t10 = if false { a10 } else { make(19) };
println(f"{show(t10)} {show(t10)} {show(t10)}");
let a11 = make(20); let b11 = make(21);
let t11 = if true { a11 } else { b11 };
println(f"{show(t11)} {show(t11)} {show(t11)} {show(t11)} {show(t11)}");
let a12 = make(22);
let t12 = if false { a12 } else { None };
println(f"{show(t12)} {show(t12)} {show(t12)}");
}