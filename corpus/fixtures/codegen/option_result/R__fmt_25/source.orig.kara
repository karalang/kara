struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct H { id: i64, s: String }
impl Drop for H { fn drop(mut ref self) { println(f"dH{self.id}") } }
fn eat(o: Option[(H, (H, H))]) -> (H, H) { match o { Some(t) => { return t.1; } None => { return (H { id: 0, s: "zzzzzzzzzzzz" }, H { id: 1, s: "zzzzzzzzzzzz" }); } } }
fn main() { let got = eat(Some((H { id: 5, s: "aaaaaaaaaaaa" }, (H { id: 6, s: "bbbbbbbbbbbb" }, H { id: 7, s: "cccccccccccc" })))); println(f"got:{got.0.id}"); println("end") }
