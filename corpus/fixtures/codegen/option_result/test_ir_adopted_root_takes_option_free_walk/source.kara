
shared struct ListNode { val: i64, mut next: Option[ListNode] }
fn build(n: i64) -> Option[ListNode] {
    let head = ListNode { val: 1, next: None };
    let mut tail = head;
    let mut i = 2;
    while i <= n {
        let node = ListNode { val: i, next: None };
        tail.next = Some(node);
        tail = node;
        i = i + 1;
    }
    Some(head)
}
fn main() {
    let mut total = 0;
    let mut iter = 0;
    while iter < 4 {
        let out = build(5);
        match out {
            Some(node) => { total = total + node.val; }
            None => {}
        }
        iter = iter + 1;
    }
    println(total);
}
