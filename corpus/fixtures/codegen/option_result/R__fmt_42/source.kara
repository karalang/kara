#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct P { r: R, q: R }
fn eat(o: Option[P]) { match o { Some(t) => { let x = t.r.clone(); println("mid"); } None => { println("n"); } } }
fn main() { eat(Some(P { r: R { id: 5 }, q: R { id: 6 } })); println("end") }
