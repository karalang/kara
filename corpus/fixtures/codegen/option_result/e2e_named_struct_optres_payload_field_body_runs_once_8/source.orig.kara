struct R { id: i64, tag: String, xs: Vec[i64] }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mkr(k: i64) -> R { return R { id: k, tag: f"tag-number-{k}-padded-out-well-past-any-inline-capacity", xs: [k, k, k] } }
struct Q { r: R, s: R }
fn take(o: Option[Q]) { match o { Some(t) => { let x = t.r; println("mid"); } None => { println("n"); } } }
fn main() { take(Option.Some(Q { r: mkr(5), s: mkr(6) })); println("end") }
