struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn eat(o: Option[(R, i64)]) -> R { match o { Some((x, y)) => { return x; } None => { return R { id: 0 }; } } }
fn main() { let a = Option.Some((R { id: 5 }, 9)); let got: R = eat(a); println(f"got:{got.id}"); println("end"); }
