struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
#[derive(Clone)]
struct H { id: i64, s: String }
impl Drop for H { fn drop(mut ref self) { println(f"dH{self.id}") } }
struct G { a: H, b: H }
fn eat(o: Option[(H, G)]) -> H { match o { Some(t) => { return t.1.a.clone(); } None => { return H { id: 0, s: "zzzzzzzzzzzz" }; } } }
fn main() { let got = eat(Some((H { id: 5, s: "aaaaaaaaaaaa" }, G { a: H { id: 6, s: "bbbbbbbbbbbb" }, b: H { id: 7, s: "cccccccccccc" } }))); println(f"got:{got.id}"); println("end") }
