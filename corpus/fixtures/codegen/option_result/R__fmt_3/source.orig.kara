struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn eat(o: Option[(R, R)]) -> R { match o { Some(t) => { return t.1; } None => { return R { id: 0 }; } } }
fn main() { let got = eat(Some((R { id: 5 }, R { id: 6 }))); println(f"got:{got.id}"); println("end") }
