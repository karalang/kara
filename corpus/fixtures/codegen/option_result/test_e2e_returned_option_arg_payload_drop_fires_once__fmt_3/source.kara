struct Res { id: i64, name: String }
impl Drop for Res {
    fn drop(mut ref self) { println(f"drop {self.id} {self.name}") }
}
fn take(b: Result[Res, i64]) -> Res {
    match b {
        Ok(r) => { return r; }
        Err(_) => { return Res { id: 0, name: f"z" }; }
    }
}
fn main() {
    let b: Result[Res, i64] = Result.Ok(Res { id: 7, name: f"e7" });
    let r: Res = take(b);
    println(f"got {r.id}");
}