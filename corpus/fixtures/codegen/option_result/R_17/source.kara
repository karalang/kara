{R}struct Hd3 {{ r: R, n: i64 }}
fn eat(o: Option[Hd3], k: bool) -> R {{ match o {{ Some(t) => {{ if k {{ return t.r; }} return R {{ id: 1 }}; }} None => {{ return R {{ id: 0 }}; }} }} }}
fn main() {{ let got = eat(Some(Hd3 {{ r: R {{ id: 5 }}, n: 9i64 }}), false); println(f"got:{{got.id}}"); println("end") }}
