#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
fn both(o: Option[Q]) { match o { Some(t) => { let x = t.r.clone(); let y = t.s.clone(); println("mid"); } None => { println("n"); } } }
fn main() { let a = Option.Some(Q { r: R { id: 5 }, s: R { id: 6 } }); both(a); println("end") }
