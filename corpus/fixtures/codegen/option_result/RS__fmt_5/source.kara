#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn eat(o: Option[(R, R)]) -> R { match o { Some(t) => { return t.1.clone(); } None => { return R { id: 0 }; } } }
fn main() { let a = Option.Some((R { id: 5 }, R { id: 6 })); let got: R = eat(a); println(f"got:{got.id}"); println("end"); }
