
fn main() {
    let sleeper = Command.new("sleep").arg("30");
    match sleeper.spawn() {
        Ok(child) => {
            match child.try_wait() {
                Ok(maybe) => {
                    match maybe {
                        Some(st) => println("exited early?!"),
                        None => println("running"),
                    }
                }
                Err(e) => println("try_wait failed"),
            }
            match child.kill() {
                Ok(u) => println("killed"),
                Err(e) => println("kill failed"),
            }
            match child.wait() {
                Ok(st) => println(f"success={st.success()} code={st.code().unwrap_or(-1)}"),
                Err(e) => println("wait failed"),
            }
            // Waiting again returns the same status (B-2026-10-15-6).
            match child.wait() {
                Ok(st) => println(f"waited again success={st.success()}"),
                Err(e) => println("second wait failed"),
            }
        }
        Err(e) => println("spawn failed"),
    }
}
