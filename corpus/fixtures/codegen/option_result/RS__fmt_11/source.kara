struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn eat(o: Option[(R, R)]) -> (R, R) { match o { Some(t) => { return t; } None => { return (R { id: 0 }, R { id: 1 }); } } }
fn main() { let a = Option.Some((R { id: 5 }, R { id: 6 })); let got = eat(a); println(f"got:{got.0.id}"); println("end"); }
