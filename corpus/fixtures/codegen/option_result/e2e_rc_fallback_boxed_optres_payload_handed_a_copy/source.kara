struct P { pos: i64 }
impl P {
    fn take(mut ref self, doc: own Option[(String, i64)]) -> i64 { self.pos = self.pos + 1; match doc { Some((s, k)) => s.len() + k, None => 0 } }
    fn item(mut ref self, t: i64) -> i64 { let doc = Some((f"heap-string-longer-than-sso-{t}", t)); let a = match t { 0 => self.take(doc.clone()), _ => 5 }; let b = match doc { Some((s, k)) => s.len() + k, None => 0 }; a + b }
}
fn take(doc: own Option[(String, i64)]) -> i64 { match doc { Some((s, k)) => s.len() + k, None => 0 } }
fn take3(doc: own Option[(String, String, i64)]) -> i64 { match doc { Some((s, u, k)) => s.len() + u.len() + k, None => 0 } }
fn takeo(doc: own Option[Option[String]]) -> i64 { match doc { Some(Some(s)) => s.len(), _ => 0 } }
fn back(doc: own Option[(String, i64)]) -> Option[(String, i64)] { doc }
fn tuple(t: i64) -> i64 { let doc = Some((f"heap-string-longer-than-sso-{t}", t)); let a = match t { 0 => take(doc.clone()), _ => 5 }; let b = match doc { Some((s, k)) => s.len() + k, None => 0 }; a + b }
fn tuple3(t: i64) -> i64 { let doc = Some((f"heap-string-longer-than-sso-{t}", f"second-heap-string-longer-than-sso", t)); let a = match t { 0 => take3(doc.clone()), _ => 5 }; let b = match doc { Some((s, u, k)) => s.len() + u.len() + k, None => 0 }; a + b }
fn nested(t: i64) -> i64 { let doc = Some(Some(f"heap-string-longer-than-sso-{t}")); let a = match t { 0 => takeo(doc.clone()), _ => 5 }; let b = match doc { Some(Some(s)) => s.len(), _ => 0 }; a + b }
fn handback(t: i64) -> i64 { let doc = Some((f"heap-string-longer-than-sso-{t}", t)); let a = match t { 0 => match back(doc.clone()) { Some((s, k)) => s.len() + k, None => 0 }, _ => 5 }; let b = match doc { Some((s, k)) => s.len() + k, None => 0 }; a + b }
fn armmove(t: i64) -> String { let doc = Some((f"heap-string-longer-than-sso-{t}", t)); let a = match t { 0 => take(doc.clone()), _ => 5 }; let b = match doc { Some((s, k)) => s, None => f"none" }; f"{a} {b}" }
fn iflet(t: i64) -> i64 { let doc = Some((f"heap-string-longer-than-sso-{t}", t)); let a = match t { 0 => take(doc.clone()), _ => 5 }; let b = if let Some((s, k)) = doc { s.len() + k } else { 0 }; a + b }
fn main() {
    let mut p = P { pos: 0 };
    println(f"{p.item(0)} {p.item(1)}");
    println(f"{tuple(0)} {tuple(1)}");
    println(f"{tuple3(0)} {tuple3(1)}");
    println(f"{nested(0)} {nested(1)}");
    println(f"{handback(0)} {handback(1)}");
    println(f"{armmove(0)} / {armmove(1)}");
    println(f"{iflet(0)} {iflet(1)}");
    let doc = Some((f"heap-string-longer-than-sso-1", 1));
    let mut n = 0;
    for i in 0..3 { if i == 2 { n = n + take(doc.clone()); } else { n = n + match doc { Some((ref s, k)) => s.len(), None => 0 }; } }
    println(n);
    println("end")
}
