{hdr}fn take(b: Option[Res]) -> Res {{
    match b {{
        Some(r) => {{ let k: Res = r; let m: Res = k; return m; }}
        None => {{ return Res {{ id: 0, name: f"z" }}; }}
    }}
}}
fn main() {{
    let b: Option[Res] = Some(Res {{ id: 7, name: f"e7" }});
    let r: Res = take(b);
    println(f"got {{r.id}}");
}}