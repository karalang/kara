#[derive(Clone)]
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn eat(o: Option[(R, i64)]) -> R { if let Some(t) = o { return t.0.clone(); } return R { id: 0 }; }
fn main() { let got = eat(Some((R { id: 5 }, 9))); println(f"got:{got.id}"); println("end") }
