struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, s: R }
fn peek(o: Option[Q]) { match o { Some(t) => { println("mid"); } None => { println("n"); } } }
fn main() { let a = Option.Some(Q { r: R { id: 5 }, s: R { id: 6 } }); peek(a); println("end") }
