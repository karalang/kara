struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Hd2 { r: R, q: R }
fn eat(o: Option[Hd2]) -> R { match o { Some(t) => { return t.r; } None => { return R { id: 0 }; } } }
fn main() { let a = Option.Some(Hd2 { r: R { id: 5 }, q: R { id: 6 } }); let got: R = eat(a); println(f"got:{got.id}"); println("end"); }
