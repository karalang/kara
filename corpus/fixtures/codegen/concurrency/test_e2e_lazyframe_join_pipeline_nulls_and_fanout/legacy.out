== logical plan ==
SELECT [name, pop]
  FILTER (pop > 50)
    JOIN on=[city] right=(SELECT [city, pop] <- SCAN [city, pop, name])
      SCAN [id, name, city]
== optimized ==
SELECT [name, pop]
  FILTER (pop > 50)
    JOIN on=[city] right=(SCAN cols=[city, pop])
      SCAN cols=[*]
