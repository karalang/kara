fn band(n: i64) -> Vec[i64] {
let mut v: Vec[i64] = Vec.new();
let mut i = 0;
while i < n { v.push(i); i = i + 1; }
v
}
fn main() {
let mut pool: TaskGroup = TaskGroup.new();
let mut handles: Vec[TaskHandle[Vec[i64]]] = Vec.new();
let mut k = 0;
while k < 3 {
let n = k + 2;
let t: TaskHandle[Vec[i64]] = pool.spawn(|| band(n));
handles.push(t);
k = k + 1;
}
let mut total = 0;
for h in handles.into_iter() { let c: Vec[i64] = h.join(); total = total + c.len(); }
println(f"{total}");
}