trait Counter { fn get(ref self) -> i64; }
effect resource Ctr: Counter;
effect resource Audit: Counter;
struct InMem { n: i64 }
impl Counter for InMem { fn get(ref self) -> i64 { self.n } }
fn a() -> i64 with reads(Ctr) { Ctr.get() }
fn b() -> i64 with reads(Audit) { Audit.get() }
fn main() {
with_provider[Ctr](InMem { n: 40 }, || {
with_provider[Audit](InMem { n: 2 }, || {
println(f"{a() + b()}");
});
});
}