struct W[T] { v: T }
impl[T] W[T] { fn make(x: T) -> W[T] { W { v: x } } fn get(ref self) -> T { self.v } }
struct S[T] { items: Vec[T] }
impl[T] S[T] {
    fn new() -> S[T] { S { items: Vec.new() } }
    fn push(mut ref self, x: T) { self.items.push(x); }
    fn len(ref self) -> i64 { self.items.len() }
}
struct P[A, B] { a: A, b: B }
impl[A, B] P[A, B] { fn of(x: A, y: B) -> P[A, B] { P { a: x, b: y } } }
fn main() {
    let w: W[i64] = W.make(7);
    println(f"{w.get()}");
    let ws: W[String] = W.make("hi");
    println(ws.v);
    let mut s: S[i64] = S.new();
    s.push(10); s.push(20); s.push(30);
    println(f"{s.len()}");
    let p: P[i64, String] = P.of(5, "z");
    println(f"{p.a}"); println(p.b);
    let a: W[i64] = W.make(1); let b: W[i64] = W.make(2);
    println(f"{a.v + b.v}");
}