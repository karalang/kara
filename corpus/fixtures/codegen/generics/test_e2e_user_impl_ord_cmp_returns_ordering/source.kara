
struct Score { v: i64 }
impl PartialEq for Score { fn eq(ref self, other: ref Score) -> bool { self.v == other.v } }
impl Eq for Score {}
impl PartialOrd for Score { fn partial_cmp(ref self, other: ref Score) -> Option[Ordering] { Some(self.v.cmp(other.v)) } }
impl Ord for Score { fn cmp(ref self, other: ref Score) -> Ordering { self.v.cmp(other.v) } }
fn main() {
    let s1 = Score { v: 1 };
    let s2 = Score { v: 2 };
    let _ = s1.cmp(s2);
    println(10);
}
