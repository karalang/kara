struct P { tag: String }
fn mk(k: i64) -> Option[Vec[P]] {
let mut c: Vec[P] = Vec.new();
c.push(P { tag: f"alpha{k}" });
Some(c)
}
fn mkr(k: i64) -> Result[Vec[P], Vec[P]] {
let mut c: Vec[P] = Vec.new();
c.push(P { tag: f"beta{k}" });
if k > 100 { return Err(c); }
Ok(c)
}
fn main() {
let k = 1;
let mut vms: Vec[Map[String, i64]] = Vec.new();
let mut inner: Map[String, i64] = Map.new();
let _ = inner.insert("n", k);
vms.push(inner);
let cur = vms[0].clone();
match cur.get("n") { Some(x) => println(x), None => println(-1) }
println(cur.contains_key("n"));
println(cur.len());
match vms[0].get("n") { Some(x) => println(x), None => println(-1) }
let held = mk(k);
match held { Some(v) => println(v[0].tag), None => println("none") }
match mk(k) { Some(v) => println(v[0].tag), None => println("none") }
let okr = mkr(k);
match okr { Ok(v) => println(v[0].tag), Err(e) => println(e[0].tag) }
let err = mkr(200);
match err { Ok(v) => println(v[0].tag), Err(e) => println(e[0].tag) }
}
