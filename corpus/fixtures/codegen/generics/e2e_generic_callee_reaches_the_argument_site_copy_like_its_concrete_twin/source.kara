#[derive(Clone)]
enum G1[T] { Y(T), N }
enum N1 { Y(String), N }
fn shg[T](g: own G1[T]) { match g { G1.Y(v) => { println(f"  mx {v}") } G1.N => { println("  mx NONE") } } }
fn shc(g: own G1[String]) { match g { G1.Y(v) => { println(f"  cx {v}") } G1.N => { println("  cx NONE") } } }
fn shn[T](g: own G1[T]) -> i64 { match g { G1.Y(v) => { return 1 } G1.N => { return 0 } } }
fn shnn(g: own N1) { match g { N1.Y(v) => { println(f"  nx {v}") } N1.N => { println("  nx NONE") } } }
fn two[T](a: own G1[T], b: own G1[T]) { match a { G1.Y(v) => { println(f"  ax {v}") } G1.N => { println("  ax NONE") } } match b { G1.Y(v) => { println(f"  bx {v}") } G1.N => { println("  bx NONE") } } }
fn main() {
    println("gen");    { let g: G1[String] = G1.Y(f"pa"); shg(g.clone()); shg(g) }
    println("con");    { let g: G1[String] = G1.Y(f"pa"); shc(g.clone()); shc(g) }
    println("one");    { let g: G1[String] = G1.Y(f"pa"); shg(g) }
    println("thrice"); { let g: G1[String] = G1.Y(f"pa"); shg(g.clone()); shg(g.clone()); shg(g) }
    println("i32");    { let g: G1[i32] = G1.Y(24); shg(g.clone()); shg(g) }
    println("none");   { let g: G1[String] = G1.N; shg(g.clone()); shg(g) }
    println("nongen"); { let g: N1 = N1.Y(f"pa"); shnn(g) }
    println("twodist");{ let x: G1[String] = G1.Y(f"xa"); let y: G1[String] = G1.Y(f"yb"); two(x.clone(), y.clone()); shg(x); shg(y) }
    println("scalar"); { let g: G1[String] = G1.Y(f"pa"); let n: i64 = shn(g.clone()); shg(g); println(f"  n{n}") }
    println("long");   { let g: G1[String] = G1.Y(f"abcdefghijklmnopqrstuvwx"); shg(g.clone()); shg(g) }
    println("end")
}
