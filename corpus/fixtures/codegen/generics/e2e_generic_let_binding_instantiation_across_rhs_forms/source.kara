#[derive(Clone)]
struct Bag[=T] {{ xs: Vec[T] }}
impl[T: Ord] Bag[T] {{
    fn swap2(mut ref self, i: i64, j: i64) {{ self.xs.swap(i, j); }}
    fn arrange(mut ref self) {{ let n = self.xs.len(); if n > 1 {{ self.swap2(0, n - 1); }} }}
    {impl_extra}
}}
{free_extra}
fn main() {{
    let a = Bag.mk(["x", "y", "z"]); println(a[0]);
    let b = Bag.mk([1, 2, 3]); println(b[0]);
}}
