
effect resource Console;

unsafe extern "C" {
    fn puts(s: *const u8) -> i32 with writes(Console);
}

fn main() with writes(Console) writes(Stdout) blocks {
    let s = "hello, " + "world";
    match s.to_cstring() {
        Ok(cs) => { puts(cs.as_ptr()); }
        Err(_) => { println("ERR"); }
    }
}
