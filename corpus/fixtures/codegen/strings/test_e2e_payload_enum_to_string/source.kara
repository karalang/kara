
#[derive(Display)]
enum IoErr { NotFound, Other(String) }
struct Wrap { e: IoErr }
fn main() {
    let a: IoErr = IoErr.NotFound;
    let b: IoErr = IoErr.Other(String.from("disk full"));
    println(a.to_string());
    println(b.to_string());
    let w: Wrap = Wrap { e: IoErr.Other(String.from("boom")) };
    println(w.e.to_string());
}
