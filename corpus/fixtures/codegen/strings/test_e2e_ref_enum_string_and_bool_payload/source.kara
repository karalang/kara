enum E { S(String), B(bool), N(i64) }
fn render(e: ref E, out: mut ref String) {
match e {
S(s) => { out.push_str(s); }
B(b) => { if b { out.push_str("T"); } else { out.push_str("F"); } }
N(n) => { out.push_str(f"{n}"); }
}
}
fn main() {
let mut o: String = "";
render(E.S("hi"), mut o); o.push(':');
render(E.B(true), mut o); o.push(':');
render(E.N(42), mut o);
println(o);
}