
fn first_word(s: ref String) -> StringSlice {
    let sp = s.find(' ');
    let end = sp.unwrap_or(s.len());
    s.slice(0, end)
}
fn main() {
    let s = "hello world".to_string();
    let w = s.slice(0, 5);
    println(w.to_string());
    println(w.len().to_string());
    match s.find('o') {
        Some(i) => println(i.to_string()),
        None => println("none"),
    }
    match s.find("zz") {
        Some(_) => println("found"),
        None => println("nf"),
    }
    let fw = first_word(s);
    println(fw.to_string());
}
