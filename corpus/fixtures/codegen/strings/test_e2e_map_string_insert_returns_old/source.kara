
fn main() {
    let mut m: Map[String, i64] = Map.new();
    let first = m.insert("key", 10_i64);
    match first {
        Some(x) => println(x),
        None => println(0_i64),
    }
    let second = m.insert("key", 20_i64);
    match second {
        Some(x) => println(x),
        None => println(0_i64),
    }
}
