
shared struct Stats { mut count: i64, mut total: i64 }
fn main() {
    let mut grand = 0;
    let mut iter = 0;
    while iter < 8 {
        if iter > 3 {
            let s = Stats { count: iter, total: iter * 2 };
            grand = grand + s.total;
        }
        iter = iter + 1;
    }
    println(grand);
}
