struct Node { id: i64, next: Option[Node], tag: String }
impl Drop for Node {
    fn drop(mut ref self) { println(f"dN{self.id}") }
}
fn mkn(i: i64) -> Node { return Node { id: i, next: Option.None, tag: f"t{i}" }; }
fn read(n: Node) -> i64 { return n.id; }
fn peek(n: ref Node) -> i64 { return n.id; }
fn pass(n: Node) -> Node { return n; }
fn stash(n: Node, v: mut ref Vec[Node]) { v.push(n); }
fn cs(n: Node, k: bool, v: mut ref Vec[Node]) { if k { v.push(n); } }
struct H { z: i64 }
impl H {
    fn eat(ref self, n: Node) -> i64 { return n.id + self.z; }
    fn eatA(n: Node) -> i64 { return n.id; }
}
fn main() {
    println("c1");
    let c = mkn(10);
    println(f"v{read(c)}");
    println("c2");
    println(f"v{read(mkn(20))}");
    println("c3");
    let e = mkn(30);
    println(f"v{e.id}");
    println("c4");
    let g = mkn(40);
    println(f"v{peek(g)}");
    println("c5");
    let h = H { z: 1 };
    let i2 = mkn(50);
    println(f"v{h.eat(i2)}");
    println("c6");
    let j = mkn(60);
    println(f"v{H.eatA(j)}");
    println("c7");
    let k = mkn(70);
    let l = pass(k);
    println(f"v{l.id}");
    println("c8");
    let mut v1: Vec[Node] = Vec.new();
    let m = mkn(80);
    stash(m, mut v1);
    println(f"n{v1.len()}");
    println("c9");
    let mut v2: Vec[Node] = Vec.new();
    let p = mkn(90);
    cs(p, false, mut v2);
    println(f"n{v2.len()}");
    println("end");
}
