
struct Item { id: i64 }
impl Drop for Item {
    fn drop(mut ref self) { println(f"drop {self.id}") }
}
struct Bag { xs: Vec[Item] }
impl Bag {
    fn add(mut ref self, x: own Item) { self.xs.push(x); }
}
fn main() {
    let mut b = Bag { xs: Vec.new() };
    b.add(Item { id: 7 });
    println("stored");
    while b.xs.len() > 0 {
        match b.xs.pop() { Some(e) => { println(f"pop {e.id}"); } None => {} }
    }
    println("end");
}
