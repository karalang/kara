#[derive(Clone)]
struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, name: f"h{i}" }; }
fn f(r: own R) -> (R, i64) { return (r, 9); }
struct S { r: R }
impl S { fn m(self) -> (R, i64) { return (self.r.clone(), 3); } }
fn main() { let s: S = S { r: mk(32) }; s.m(); println("ok"); }
