struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct H { n: i64 }
impl H { fn take(ref self, r: R, q: R) -> i64 { println("in-m"); 7 } }
fn main() {
    let h = H { n: 0 };
    let v = h.take(R { id: 1 }, R { id: 2 }) + h.take(R { id: 3 }, R { id: 4 });
    println(f"v={v}");
}