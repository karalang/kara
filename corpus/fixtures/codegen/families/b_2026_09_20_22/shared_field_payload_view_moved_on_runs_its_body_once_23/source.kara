shared struct Sh { s: String }
struct Wsh { h: Sh }
impl Drop for Wsh { fn drop(mut ref self) { println(f"  dWsh-{self.h.s}") } }
struct Wpl { a: String }
impl Drop for Wpl { fn drop(mut ref self) { println(f"  dWpl-{self.a}") } }
enum Esh { A(Wsh), B }
enum Epl { A(Wpl), B }
struct Wsx { h: Sh, s: String }
impl Drop for Wsx { fn drop(mut ref self) { println(f"  dWsx-{self.h.s}-{self.s}") } }
enum Esx { A(Wsx), B }
enum E2 { A(Wsh, i64), B }
fn mk(s: own String) -> Wsh { return Wsh { h: Sh { s: s } } }
fn eat(w: own Wsh) { println(f"  ate:{w.h.s}") }
fn f(b: own Esh) -> Wsh { match b { Esh.A(w) => { return w; } Esh.B => { return mk(f"NB"); } } }
fn main() { let g = f(Esh.A(mk(f"PAY"))); println(f"  g:{g.h.s}"); }
