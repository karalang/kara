struct G[T] { v: T, n: i64 }
struct P[A, B] { a: A, b: B }
fn f1(g: own G[String]) -> i64 { let G { v, n } = g; v.len() + n }
fn f2(g: own G[Vec[i64]]) -> i64 { let G { v, .. } = g; v.len() }
fn f3(p: own P[String, Vec[String]]) -> i64 { let P { a, b } = p; a.len() + b.len() }
fn f4[T](g: own G[T]) -> i64 { let G { v, n } = g; n }
fn f5(g: own G[String]) -> String { let G { n, v } = g; v }
fn main() {
    let mut w = Vec.new(); w.push(1); w.push(2);
    let mut ws = Vec.new(); ws.push("heap-string-longer-than-sso-xxxxxx");
    println(f"{f1(G { v: "heap-string-longer-than-sso-abcdef", n: 1 })} {f2(G { v: w, n: 0 })} {f3(P { a: "heap-string-longer-than-sso-aaaaaa", b: ws })} {f4(G { v: "x", n: 7 })}");
    let g = G { v: "heap-string-longer-than-sso-abcdef", n: 1 };
    println(f"{f5(g).len()}");
    let G { v, n } = G { v: 5, n: 6 };
    println(f"{v + n}");
}
