struct R { id: i64, s: String }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}") } }
enum G[T] { Y(T), N }
fn mk(i: i64) -> R { return R { id: i, s: f"heap-string-longer-than-sso-{i}" } }
fn glen[T](g: G[T]) -> i64 { return 1 }
fn gid[T](g: own G[T]) -> G[T] { return g }
fn gvia[T](g: own G[T]) -> i64 { let h = gid(g); return glen(h) }
fn gviam[T](g: own G[T]) -> i64 { let h = gid(g); match h { G.Y(x) => { return 5 }, G.N => { return 0 } } }
fn gviac[T](g: own G[T], c: bool) -> i64 { let h = gid(g); if c { return glen(h) } println("keep"); return 0 }
fn gviar[T](g: own G[T]) -> G[T] { let h = gid(g); return h }
fn gvia2[T](g: own G[T]) -> i64 { let h = gid(g); let k = gid(h); return glen(k) }
fn gviaf[T](g: own G[T]) -> i64 { let h = gid(g); return gvia(h) }
fn gkeep[T](g: own G[T]) -> i64 { let h = gid(g); println("keep"); return 0 }
fn main() {
    let a1: G[R] = G.Y(mk(1));
    println(f"q1 {gvia(a1)}");
    let a2: G[R] = G.Y(mk(2));
    println(f"q2 {gviam(a2)}");
    let a3: G[R] = G.Y(mk(3));
    println(f"q3 {gviac(a3, true)}");
    let a4: G[R] = G.Y(mk(4));
    println(f"q4 {gviac(a4, false)}");
    let a5: G[R] = G.Y(mk(5));
    let b5 = gviar(a5);
    println(f"q5 {glen(b5)}");
    let a6: G[R] = G.Y(mk(6));
    println(f"q6 {gvia2(a6)}");
    let a7: G[R] = G.Y(mk(7));
    println(f"q7 {gviaf(a7)}");
    let a8: G[R] = G.Y(mk(8));
    println(f"q8 {gkeep(a8)}");
    println("end")
}
