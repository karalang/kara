#[derive(Clone)]
struct P { id: i64, s: String }
#[derive(Clone)]
enum Ho[T] { Full(T), Empty }
fn mkp(i: i64) -> P { return P { id: i, s: "ab".to_string() + "cd" } }
fn shows(h: own Ho[P]) { match h { Ho.Full(r) => println(f"s{r.id}{r.s}"), Ho.Empty => println("e") } }
fn keep(h: own Ho[P]) -> Ho[P] { h }
fn pick(a: own Ho[P], b: own Ho[P]) -> Ho[P] { shows(b); a }
fn keept(h: own Ho[String]) -> Ho[String] { h }
fn showt(h: own Ho[String]) { match h { Ho.Full(r) => println(f"t{r}"), Ho.Empty => println("e") } }
fn mkv(a: i64, b: i64) -> Vec[Ho[P]] {
    let mut v: Vec[Ho[P]] = Vec.new();
    v.push(Ho.Full(mkp(a)));
    v.push(Ho.Empty);
    v.push(Ho.Full(mkp(b)));
    return v
}
fn main() {
    println("escape");
    {
        let v = mkv(1, 2);
        let mut w: Vec[Ho[P]] = Vec.new();
        for h in v.clone().into_iter() { w.push(keep(h)) }
        println(f"n{v.len()}{w.len()}");
        for x in w.into_iter() { shows(x) }
    }
    println("twice");
    {
        let v = mkv(3, 4);
        for h in v.into_iter() { shows(h.clone()); shows(h) }
    }
    println("bound");
    {
        let v = mkv(5, 6);
        for h in v.into_iter() { let k = keep(h); println("got") }
    }
    println("chain");
    {
        let v = mkv(7, 8);
        for h in v.into_iter() { let k = keep(h); let j = keep(k); shows(j) }
    }
    println("mixed");
    {
        let v = mkv(9, 10);
        let mut w: Vec[Ho[P]] = Vec.new();
        for h in v.into_iter() { w.push(keep(h.clone())); shows(h) }
        println(f"n{w.len()}")
    }
    println("pick");
    {
        let v = mkv(11, 12);
        for h in v.into_iter() { let k = pick(h, Ho.Full(mkp(99))); shows(k) }
    }
    println("string");
    {
        let mut v: Vec[Ho[String]] = Vec.new();
        v.push(Ho.Full("x".to_string() + "y"));
        v.push(Ho.Empty);
        let mut w: Vec[Ho[String]] = Vec.new();
        for h in v.into_iter() { w.push(keept(h.clone())); showt(h) }
        for x in w.into_iter() { showt(x) }
    }
    println("end")
}
