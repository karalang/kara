struct S { s: String, k: i64 }
struct T { s: String }
struct U { t: T, k: i64 }
struct D { s: String, k: i64 }
impl Drop for D { fn drop(mut ref self) { println(f"dD{self.k}") } }
fn main() { let n = 7; let a: Array[(String, i64), 2] = [(f"one-{n}", 1), (f"two-{n}", 5)]; let x = a[1].0.clone(); println(f"x:{x}:{a[1].0}") }
