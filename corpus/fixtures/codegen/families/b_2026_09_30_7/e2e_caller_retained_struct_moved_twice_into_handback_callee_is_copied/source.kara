shared struct Sh { k: i64 }
#[derive(Clone)]
struct S2 { h: Sh, id: i64 }
impl Drop for S2 { fn drop(mut ref self) { println(f"dS{self.id}") } }
fn mk(i: i64) -> S2 { return S2 { h: Sh { k: i }, id: i } }
struct W3 { u: S2, n: i64 }
#[derive(Clone)]
struct S4 { h: Sh, id: i64 }
fn m4(i: i64) -> S4 { return S4 { h: Sh { k: i }, id: i } }
#[derive(Clone)]
struct S5 { h: Sh, t: String, id: i64 }
impl Drop for S5 { fn drop(mut ref self) { println(f"dT{self.id}") } }
struct Kp { z: i64 }
impl Kp {
  fn k4(ref self, s: own S4) -> S4 { return s }
  fn kc(ref self, s: own S4, b: bool) -> S4 { if b { return s } m4(0) }
}
fn keep(s: own S2) -> S2 { return s }
fn keep5(s: own S5) -> S5 { return s }
fn keep2[T](x: own T) -> T { return x }
fn maybe(s: own S2, b: bool) -> S2 { if b { return s } mk(0) }
fn c1() { let s = mk(1); let a = keep(s.clone()); let d = keep(s); println(f"{a.id}{a.h.k} {d.id}{d.h.k}") }
fn c2(q: own W3) -> i64 { let a = keep(q.u.clone()); let d = keep(q.u); return a.id * 100 + d.h.k }
fn c3() { let s = mk(3); let a = maybe(s.clone(), true); let d = maybe(s, false); println(f"{a.id}{a.h.k} {d.id}{d.h.k}") }
fn c4(q: own W3) -> i64 { let a = maybe(q.u.clone(), true); let c = maybe(q.u.clone(), false); let d = maybe(q.u, true); return a.id * 100 + c.id * 10 + d.h.k }
fn c5() { let kp = Kp { z: 1 }; let s = m4(5); let a = kp.k4(s.clone()); let d = kp.k4(s); let t = m4(6); let b = kp.kc(t.clone(), false); let c = kp.kc(t, true); println(f"{a.h.k}{d.h.k} {b.h.k}{c.h.k}") }
fn c6() { let s = mk(6); let a = keep2(s.clone()); let d = keep2(s); println(f"{a.h.k}{d.h.k}") }
fn c7() { let s = mk(7); let a = keep(s.clone()); println(f"{s.h.k} {a.h.k}") }
fn c8() { let s = S5 { h: Sh { k: 8 }, t: f"aaaaaaaaaaaaaaaaaaaaaaaaaaaaa{4}", id: 8 }; let a = keep5(s.clone()); let d = keep5(s); println(f"{a.t.len()}{a.h.k} {d.t.len()}{d.h.k}") }
fn c9(q: own W3) -> i64 { let x = q.u; let a = keep(x.clone()); let d = keep(x); return a.h.k * 10 + d.h.k }
fn main() {
  println("-c1"); c1();
  println("-c2"); println(f"s{c2(W3 { u: mk(2), n: 2 })}");
  println("-c3"); c3();
  println("-c4"); println(f"s{c4(W3 { u: mk(4), n: 2 })}");
  println("-c5"); c5();
  println("-c6"); c6();
  println("-c7"); c7();
  println("-c8"); c8();
  println("-c9"); println(f"s{c9(W3 { u: mk(9), n: 2 })}");
  println("end")
}
