struct Lit {
    value: i128,
    k: i64,
}

enum E {
    Int(Lit),
    Other,
}

fn main() {
    println("start")
    let e = E.Int(Lit { value: 100000000000000000000i128, k: 3 });
    match e {
        Int(l) => println(l.value.to_string() + " " + l.k.to_string()),
        Other => println("o"),
    }
}
