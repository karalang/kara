enum G1[T] { Y(T), N }
impl[T] G1[T] {
    fn shm(own self) { match self { G1.Y(v) => { println(f"mx {v}") } G1.N => { println("mx NONE") } } }
    fn iflet(own self) { if let G1.Y(v) = self { println(f"il {v}") } else { println("il none") } }
}
fn mks(s: own String) -> G1[String] { return G1.Y(s); }
fn main() {
    G1.Y(f"temp-payload-aaaaaaaaaaa").shm();
    mks(f"call-payload-bbbbbbbbbbb").shm();
    G1.Y(f"temp-iflet-ccccccccccccc").iflet();
    let n: G1[String] = G1.N;
    n.shm();
    println("end");
}
