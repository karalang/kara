struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, name: f"h{i}" }; }
struct H { r: R, s: String }
shared struct Q { mut id: i64 }
impl Drop for Q { fn drop(mut ref self) { println(f"dQ{self.id}") } }
struct Hs { q: Q, r: R }
struct K { k: i64 }
impl K {
    fn eat(ref self, a: own R) -> i64 { let mut c = a; c.id = c.id + 10; println("in"); 5 }
}
fn held(a: own R) -> i64 { let mut c = a; c.id = c.id + 10; println("in"); 5 }
fn rename(a: own R) -> i64 { let mut c = a; c.name = "z"; c.id = 7; println(f"in {c.name}"); 5 }
fn grow(a: own Vec[R]) -> i64 { let mut c = a; c.push(mk(99)); c.len() }
fn shrink(a: own Vec[R]) -> i64 { let mut c = a; let r = c.pop(); println(f"in {r.is_some()}"); c.len() }
fn part(a: own H) -> i64 { let mut c = a; c.r.id = 21; let x = c.r; println("in"); 5 }
fn swap(a: own R) -> i64 { let mut c = a; c.id = 11; c = mk(9); println("in"); 5 }
fn fwd(a: own R) -> i64 { held(a) }
fn keep(a: own R) -> i64 { let mut v: Vec[R] = Vec.new(); v.push(a); 5 }
fn fwdk(a: own R) -> i64 { keep(a) }
fn shared_field(a: own Hs) -> i64 { let mut c = a; c.r.id = 11; c.q.id = 7; println("in"); 5 }
fn main() {
    let a = mk(1);
    println(f"k{held(a)}");
    println(f"k{held(mk(2))}");
    println(f"k{rename(mk(3))}");
    let v: Vec[R] = vec![mk(11)];
    println(f"k{grow(v)}");
    println(f"k{shrink(vec![mk(11), mk(12)])}");
    println(f"k{part(H { r: mk(4), s: "q" })}");
    println(f"k{swap(mk(5))}");
    println(f"k{fwd(mk(6))}");
    println(f"k{fwdk(mk(7))}");
    let k = K { k: 0 };
    println(f"k{k.eat(mk(8))}");
    let h = Hs { q: Q { id: 1 }, r: mk(2) };
    let n = shared_field(h);
    println(f"k{n}");
    println("end");
}
