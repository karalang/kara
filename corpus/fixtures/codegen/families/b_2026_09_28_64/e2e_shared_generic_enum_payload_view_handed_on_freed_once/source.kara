shared enum G[T] { Y(T), N }
#[derive(Clone)]
enum E { A(String), B }
struct W { t: (String, i64) }
fn tt(g: G[(String, i64)]) -> (String, i64) { match g { G.Y(x) => { return x.clone() } G.N => { return (f"n", 0) } } }
fn tt2(g: G[(String, i64)]) -> (String, i64) { match g { G.Y(x) => x.clone(), G.N => (f"n", 0) } }
fn te(g: G[E]) -> E { match g { G.Y(x) => x.clone(), G.N => E.B } }
fn to(g: G[Option[String]]) -> Option[String] { match g { G.Y(x) => { return x.clone() } G.N => { return None } } }
fn ta(g: G[Array[String, 2]]) -> Array[String, 2] { match g { G.Y(x) => x.clone(), G.N => [f"n", f"n"] } }
fn tw(g: G[(String, i64)]) -> W { match g { G.Y(x) => W { t: x.clone() }, G.N => W { t: (f"n", 0) } } }
fn tp(g: G[(String, i64)]) -> Vec[(String, i64)] { let mut v: Vec[(String, i64)] = Vec.new(); if let G.Y(x) = g { v.push(x.clone()) } return v }
fn main() {
    let mut i = 0;
    while i < 2 {
        let a = tt(G.Y((f"a{i}", 1)));
        let b = tt2(G.Y((f"bb{i}", 2)));
        let c = te(G.Y(E.A(f"ccc{i}")));
        let d = to(G.Y(Some(f"dd{i}")));
        let e = ta(G.Y([f"e{i}", f"ee{i}"]));
        let w = tw(G.Y((f"w{i}", 3)));
        let v = tp(G.Y((f"v{i}", 4)));
        let cl = match c { E.A(s) => s.len(), E.B => 0 };
        let dl = match d { Some(s) => s.len(), None => 0 };
        println(f"{a.0}{a.1} {b.0}{b.1} {cl} {dl} {e[1]} {w.t.0}{w.t.1} {v[0].0}{v[0].1}");
        i = i + 1;
    }
    { let g: G[String] = G.Y(f"ab"); println("s"); }
    println("end")
}
