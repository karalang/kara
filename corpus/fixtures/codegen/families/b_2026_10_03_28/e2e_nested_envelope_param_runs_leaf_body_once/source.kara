struct R { id: i64, s: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, s: f"heap-string-longer-than-sso-{i}" } }
fn rr(x: own Result[Option[R], i64]) -> i64 {
    match x {
        Ok(Some(w)) => w.id,
        Ok(None) => 2,
        Err(e) => e,
    }
}
fn keep(x: own Result[Option[R], i64], v: mut ref Vec[R]) -> i64 {
    match x {
        Ok(Some(w)) => { v.push(w); return 1 }
        _ => 0,
    }
}
fn eat(r: own R) { println(f"e{r.id}") }
fn re(x: own Result[Option[R], i64]) -> i64 {
    match x {
        Ok(Some(w)) => { eat(w); return 1 }
        _ => 0,
    }
}
fn okeep(x: own Option[Option[R]], v: mut ref Vec[R]) -> i64 {
    match x {
        Some(Some(w)) => { v.push(w); return 1 }
        _ => 0,
    }
}
fn take(x: own Option[Option[R]]) -> Option[R] {
    match x {
        Some(Some(r)) => Some(r),
        _ => None,
    }
}
fn main() {
    println(rr(Ok(Some(mk(1)))));
    let mut v: Vec[R] = Vec.new();
    println(keep(Ok(Some(mk(2))), mut v));
    println(okeep(Some(Some(mk(3))), mut v));
    println(re(Ok(Some(mk(5)))));
    let a = take(Some(Some(mk(4))));
    match a { Some(r) => println(r.id), None => println("none") }
    println(v.len());
    println("end");
}
