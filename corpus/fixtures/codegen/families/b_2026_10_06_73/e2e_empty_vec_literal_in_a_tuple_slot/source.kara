struct P {
    t: (Vec[i64], i64),
}

fn mk() -> (Vec[String], i64) {
    return (vec![], 3);
}

fn main() {
    let t: (Vec[i64], i64) = (vec![], 5);
    println(f"{t.0.len()} {t.1}");
    let v: Vec[(Vec[i64], i64)] = vec![(vec![1], 5), (vec![], 6)];
    let mut total = 0;
    for (xs, k) in v {
        total += xs.len() + k;
    }
    println(f"{total}");
    let p = P { t: (Vec[], 9) };
    println(f"{p.t.0.len()} {p.t.1}");
    let (a, b) = mk();
    println(f"{a.len()} {b}");
    let mut w: (Vec[String], i64) = (vec![], 1);
    w.0.push(f"grown-to-a-heap-string-{w.1}");
    println(f"{w.0[0]}");
}
