struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}") } }
struct S { r: R, s: String }
fn mk(i: i64) -> S { S { r: R { id: i }, s: f"heap-string-longer-than-sso-{i}" } }
fn mk2o(x: own S) -> Option[S] { Some(x) }
fn s1(x: own S) -> bool { if let None = mk2o(x) { false } else { true } }
fn s2(x: own S) { while let Some(_) = mk2o(x) { break; } println("in2") }
fn s3(x: own S) -> bool { let Some(_) = mk2o(x) else { return false }; true }
fn s4(x: own S) { match mk2o(x) { Some(_) => println("m"), None => println("n") } println("in4") }
fn main() {
    let a = s1(mk(1));
    println(f"a{a}");
    s2(mk(2));
    println("o2");
    let c = s3(mk(3));
    println(f"c{c}");
    s4(mk(4));
    println("o4");
    println("end")
}