
struct G[T] { v: T, n: i64 }
enum E[T] { A { x: T, k: i64 }, B }
fn mk(p: String, k: i64) -> String { f"{p}-heap-string-longer-than-sso-{k}" }
fn mv(k: i64) -> Vec[String] { let mut v = Vec.new(); v.push(mk("e", k)); v.push(mk("f", k)); v }
fn h1[T](g: own G[T]) -> T { match g { G { v, .. } => v } }
fn h2[T](g: own G[T]) -> T { match g { G { v, n } => { let w = v; w } } }
fn h3[T](g: own G[T]) -> Vec[T] { let mut o = Vec.new(); match g { G { v, .. } => o.push(v) } o }
fn h4[T](g: own G[T]) -> T { if let G { v, .. } = g { v } else { panic("no") } }
fn h5[T](g: own G[G[T]]) -> T { match g { G { v: G { v, .. }, .. } => v } }
fn h6[T](e: own E[T]) -> Option[T] { match e { E.A { x, .. } => Some(x), E.B => None } }
fn k1[T](g: own G[T]) -> i64 { match g { G { v, n } => { let w = v; n } } }
fn k2[T](x: own T) -> i64 { let w = x; 3 }
fn k3[T](x: own T, c: bool) -> i64 { if c { let w = x; 1 } else { 0 } }
fn k4[T](xs: own Vec[T]) -> i64 { let mut n = 0; for x in xs { let w = x; n = n + 1; } n }
fn k5[T](e: own E[T]) -> i64 { match e { E.A { x, k } => { let w = x; k } E.B => 0 } }
fn main() {
    println(h1(G { v: mk("a", 1), n: 2 }));
    let g = G { v: mk("b", 2), n: 1 };
    println(h1(g));
    println(h2(G { v: mk("c", 3), n: 2 }));
    let o = h3(G { v: mk("d", 4), n: 2 });
    println(o[0]);
    println(h4(G { v: mk("e", 5), n: 2 }));
    println(h5(G { v: G { v: mk("f", 6), n: 1 }, n: 2 }));
    match h6(E.A { x: mk("g", 7), k: 2 }) { Some(s) => println(s), None => println("none") }
    let w = h1(G { v: mv(8), n: 1 });
    println(f"{w.len()} {w[1]}");
    println(f"{k1(G { v: mk("h", 9), n: 2 })} {k2(mk("i", 10))} {k2(mv(11))} {k3(mk("j", 12), true)} {k3(mk("j", 13), false)} {k4(mv(14))} {k5(E.A { x: mk("k", 15), k: 4 })}");
}
