fn main() {
    let a: G[Vec[i64]] = G.Y([1, 2, 3]);
    let b: G[Vec[String]] = G.Y([f"x-{1}"]);
    let c: G[Array[i64, 3]] = G.Y([4, 5, 6]);
    let d: G[Array[String, 2]] = G.Y([f"p-{1}", f"q-{2}"]);
    let e: G[Array[i64, 2]] = G.Y([7, 8]);
    println(f"{a.show()} {b.show()} {c.show()} {d.show()} {e.show()}");
}
