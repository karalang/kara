struct S { id: i64, s: String }
impl Drop for S { fn drop(mut ref self) { println(f"dS{self.id}") } }
fn mks(i: i64) -> S { return S { id: i, s: "ab".to_string() + "cd" } }
struct Q { z: i64 }
impl Q {
  fn eat(ref self, s: own S) { println("qx") }
  fn meat(mut ref self, s: own S) { println("mx") }
  fn eat2(ref self, n: i64, s: own S) { println(f"q2x{n}") }
  fn back(ref self, s: own S) -> S { return s }
  fn only(ref self, s: own S) { self.eat(s); println("o") }
  fn monly(mut ref self, s: own S) { self.meat(s); println("mo") }
  fn two(ref self, s: own S) { self.eat2(3, s); println("t") }
  fn viab(ref self, s: own S) { let t = self.back(s); println(f"vb{t.id}") }
  fn cond(ref self, s: own S, k: bool) { if k { self.eat(s); } println("c") }
  fn pq(ref self, s: own S, k: bool) -> S { if k { return s } self.eat(s); return mks(0) }
}
struct B { xs: Vec[S] }
impl B {
  fn add(mut ref self, s: own S) { self.xs.push(s) }
  fn fwd(mut ref self, s: own S) { self.add(s); println("fw") }
  fn cfwd(mut ref self, s: own S, k: bool) { if k { self.add(s); } println("cf") }
}
fn feat(q: ref Q, s: own S) { q.eat(s); println("f") }
fn pv(v: mut ref Vec[S], s: own S) { v.push(s); println("pv") }
fn bf(b: mut ref B, s: own S) { b.add(s); println("bf") }
fn main() {
  let mut q = Q { z: 0 };
  q.only(mks(1)); println("a");
  let n = mks(2); q.only(n); println("b");
  q.monly(mks(3)); println("c");
  feat(q, mks(4)); println("d");
  q.two(mks(5)); println("e");
  q.viab(mks(6)); println("g");
  q.cond(mks(7), true); println("h");
  q.cond(mks(8), false); println("i");
  let r = q.pq(mks(9), false); println(f"j{r.id}");
  let t = q.pq(mks(10), true); println(f"k{t.id}");
  let mut b = B { xs: Vec.new() };
  b.fwd(mks(11)); println("l");
  b.cfwd(mks(12), true); println("m");
  b.cfwd(mks(13), false); println("n");
  bf(mut b, mks(14)); println("p");
  let mut v: Vec[S] = Vec.new();
  pv(mut v, mks(15)); println(f"r{v.len()}");
  println("end")
}
