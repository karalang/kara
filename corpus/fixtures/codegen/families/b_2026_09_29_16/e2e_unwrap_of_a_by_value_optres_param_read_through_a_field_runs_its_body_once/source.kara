struct S { id: i64, s: String }
impl Drop for S { fn drop(mut ref self) { println(f"dS{self.id}") } }
fn mks(i: i64) -> S { return S { id: i, s: f"heap-string-longer-than-sso-{i}" } }
struct P { id: i64 }
impl Drop for P { fn drop(mut ref self) { println(f"dP{self.id}") } }
struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Q { r: R, n: i64 }
fn mkq(i: i64) -> Q { return Q { r: R { id: i }, n: i } }
struct W { id: i64, s: String }
fn mkw(i: i64) -> W { return W { id: i, s: f"heap-string-longer-than-sso-{i}" } }
fn eatr(r: own R) -> i64 { return r.id }
fn cu(t: own Option[S]) { println(f"u{t.unwrap().id}") }
fn ce(t: own Option[S]) -> i64 { return t.expect("boom").id }
fn cx(t: own Result[S, i64]) -> i64 { return t.expect("boom").id }
fn cr(t: own Result[i64, S]) { println(f"r{t.unwrap_err().id}") }
fn cg(t: own Option[S]) -> i64 { let k = -t.unwrap().id; return k }
fn cl(t: own Option[S]) { println(f"l{t.unwrap().s.len()}") }
fn cq(t: own Option[Q]) { println(f"q{eatr(t.unwrap().r)}") }
fn cp(t: own Option[P]) { println(f"p{t.unwrap().id}") }
fn cw(t: own Option[W]) { println(f"w{t.unwrap().id}") }
fn ge[T](t: own Option[T]) -> T { return t.unwrap() }
fn main() {
    cu(Option.Some(mks(1)));
    let a = Option.Some(mks(2));
    cu(a);
    println("-");
    println(f"e{ce(Option.Some(mks(3)))}");
    println(f"x{cx(Result.Ok(mks(4)))}");
    cr(Result.Err(mks(5)));
    println(f"g{cg(Option.Some(mks(6)))}");
    cl(Option.Some(mks(7)));
    cq(Option.Some(mkq(8)));
    cp(Option.Some(P { id: 9 }));
    cw(Option.Some(mkw(10)));
    let w = Option.Some(mkw(11));
    cw(w);
    let g = ge(Option.Some(mks(12)));
    println(f"g{g.id}");
    println("end")
}
