{USER_HASHERS}fn main() {{
    let mut m: Map[i64, i64, FnvBuild] = Map.new();
    let mut i = 0;
    while i < 5000 {{
        let k = i % 700;
        m.insert(k, m.get(k).unwrap_or(0) + 1);
        i += 1;
    }}
    let mut missing = 0;
    let mut sum = 0;
    let mut j = 0;
    while j < 700 {{
        match m.get(j) {{
            Some(n) => {{ sum += n; }}
            None => {{ missing += 1; }}
        }}
        j += 1;
    }}
    println(f"{{m.len()}} missing={{missing}} sum={{sum}}");
}}
