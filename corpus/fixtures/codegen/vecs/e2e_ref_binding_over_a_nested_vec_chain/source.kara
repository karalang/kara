fn main() {
let d: Vec[Vec[i64]] = [[1, 2], [3, 4]];
let g2 = ref d[0][1];
println(f"double {g2}");
let t: Vec[Vec[Vec[i64]]] = [[[5, 6]]];
let g3 = ref t[0][0][1];
println(f"triple {g3}");
let q: Vec[Vec[Vec[Vec[i64]]]] = [[[[7, 8]]]];
let g4 = ref q[0][0][0][1];
println(f"quad {g4}");
let s: Vec[Vec[String]] = [["a", "b"]];
let gs = ref s[0][1];
println(f"str {gs}");
let mut m: Vec[Vec[i64]] = [[1, 2]];
let ga = ref m[0][1];
m[0][1] = 99;
println(f"alias {ga}");
let f: Vec[i64] = [10, 20];
let gf = ref f[1];
println(f"flat {gf}");
}