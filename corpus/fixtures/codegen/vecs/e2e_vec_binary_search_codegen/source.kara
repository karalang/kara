fn print_opt(o: Option[i64]) {
match o { Some(i) => println(i), None => println(-1i64) }
}
fn main() {
let v: Vec[i64] = vec![1, 3, 5, 7, 9, 11];
print_opt(v.binary_search(7));
print_opt(v.binary_search(1));
print_opt(v.binary_search(11));
print_opt(v.binary_search(4));
print_opt(v.binary_search(12));
let e: Vec[i64] = Vec.new();
print_opt(e.binary_search(5));
let u: Vec[u8] = vec![10u8, 50u8, 200u8, 250u8];
print_opt(u.binary_search(200u8));
print_opt(u.binary_search(99u8));
let s: Vec[String] = vec!["apple", "banana", "cherry"];
print_opt(s.binary_search("cherry"));
print_opt(s.binary_search("fig"));
let dup: Vec[i64] = vec![1, 2, 2, 2, 2, 3, 4];
print_opt(dup.binary_search(2));
let sl: Slice[i64] = v.as_slice();
print_opt(sl.binary_search(9));
}