struct R { key: i64, ord: i64 }
fn main() {
let mut v: Vec[R] = Vec.new();
let mut seed: i64 = 12345;
let mut i: i64 = 0;
while i < 6000 {
seed = (seed * 1103515245 + 12345) % 2147483648;
v.push(R { key: seed % 5, ord: i });
i = i + 1;
}
v.sort_by(|a, b| a.key.cmp(b.key));
let mut inv: i64 = 0;
let mut unstable: i64 = 0;
let mut j: i64 = 1;
while j < 6000 {
if v[j].key < v[j - 1].key { inv = inv + 1; }
if v[j].key == v[j - 1].key {
if v[j].ord < v[j - 1].ord { unstable = unstable + 1; }
}
j = j + 1;
}
let mut w: Vec[R] = Vec.new();
let mut m: i64 = 0;
while m < 6000 { w.push(R { key: 3, ord: m }); m = m + 1; }
w.sort_by(|a, b| a.key.cmp(b.key));
let mut moved: i64 = 0;
let mut q: i64 = 0;
while q < 6000 { if w[q].ord != q { moved = moved + 1; } q = q + 1; }
println(f"{inv} {unstable} {moved}");
}
