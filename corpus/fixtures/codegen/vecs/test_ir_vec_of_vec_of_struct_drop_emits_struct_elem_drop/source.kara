
struct Rec { name: String, n: i64 }
fn build() -> Vec[Vec[Rec]] {
    let mut outer: Vec[Vec[Rec]] = Vec.new();
    let mut a: Vec[Rec] = Vec.new();
    a.push(Rec { name: "a field string padded out beyond thirty-six bytes ok", n: 1_i64 });
    outer.push(a);
    return outer;
}

fn main() {
    let vv = build();
    println(vv.len());
}
