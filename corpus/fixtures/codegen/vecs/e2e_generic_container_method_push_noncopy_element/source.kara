struct Box[T] { xs: Vec[T] }
impl[T: Clone] Box[T] {
    fn new() -> Box[T] { Box { xs: Vec.new() } }
    fn add(mut ref self, x: T) { self.xs.push(x.clone()); }
    fn at(ref self, i: i64) -> T { self.xs[i].clone() }
    fn size(ref self) -> i64 { self.xs.len() }
}
fn main() {
    let mut s: Box[String] = Box.new();
    s.add(f"alpha"); s.add(f"beta"); s.add(f"gamma");
    let mut n: Box[i64] = Box.new();
    n.add(100); n.add(200);
    println(s.at(0)); println(s.at(1)); println(s.at(2));
    println(f"{n.at(0)}"); println(f"{n.at(1)}");
    println(f"{s.size()} {n.size()}");
}