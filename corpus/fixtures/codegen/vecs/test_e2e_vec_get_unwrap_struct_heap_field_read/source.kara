struct Acct { name: String, txns: i64 }
fn main() {
let mut v: Vec[Acct] = Vec.new();
v.push(Acct { name: "alice".to_string(), txns: 2 });
v.push(Acct { name: "bob".to_string(), txns: 5 });
let a = v.get(0).unwrap();
println(f"{a.name}:{a.txns}");
let b = v.get(1).unwrap();
println(f"{b.name}:{b.txns}");
let f = v.first().unwrap();
println(f.name);
let l = v.last().unwrap();
println(l.name);
}