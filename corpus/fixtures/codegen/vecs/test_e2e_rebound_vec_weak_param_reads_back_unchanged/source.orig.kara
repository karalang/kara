
shared struct N { v: i64 }

fn probe(xs: own Vec[weak N]) -> i64 {
    let work = xs;
    match work[0] { Some(x) => { x.v } None => { 0 - 1 } }
}

fn main() {
    let a: N = N { v: 7 };
    let mut w: Vec[weak N] = Vec.new();
    w.push(a);
    println(probe(w));
    println(probe(w));
    match w[0] { Some(x) => { println(x.v) } None => { println(0 - 1) } }
    println(a.v);
}
