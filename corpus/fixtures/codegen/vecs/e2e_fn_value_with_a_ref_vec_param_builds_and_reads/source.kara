fn head(v: ref Vec[u8], i: i64) -> i64 {
return v[i] as i64;
}
fn main() {
let mut v: Vec[u8] = Vec.new();
let mut k = 0i64;
while k < 6i64 { v.push((k * 3i64) as u8); k = k + 1i64; }
let f = head;
let mut acc = 0i64;
let mut i = 0i64;
while i < 6i64 { acc = acc + f(v, i); i = i + 1i64; }
println(acc);
}