
struct Rec { name: String, n: i64 }

fn make_recs() -> Vec[Rec] {
    let mut v: Vec[Rec] = Vec.new();
    v.push(Rec { name: "a record name field padded beyond thirty-six bytes", n: 1_i64 });
    return v;
}

fn main() {
    match make_recs().get(0) {
        Some(r) => println(r.n),
        None => println(0_i64),
    };
}
