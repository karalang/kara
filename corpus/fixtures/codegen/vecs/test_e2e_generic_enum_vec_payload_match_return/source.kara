enum Opt[T] { Yes(T), No }
fn get[T](o: Opt[T], d: T) -> T { match o { Opt.Yes(v) => v, Opt.No => d } }
fn main() {
    let mut v: Vec[i64] = Vec.new(); v.push(7); v.push(8);
    let e: Vec[i64] = Vec.new();
    let w: Vec[i64] = get(Opt.Yes(v), e);
    println(w.len().to_string());
    println(w[1].to_string());
}