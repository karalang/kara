
fn main() {
    let mut v: Vec[(i64, i64)] = Vec.new();
    v.push((2, 10));   // diff = 8
    v.push((5, 6));    // diff = 1
    v.push((1, 20));   // diff = 19
    v.push((3, 8));    // diff = 5
    // Sort by (b.1 - b.0) descending: largest gap first.
    v.sort_by(|a, b| (b.1 - b.0).cmp(a.1 - a.0));
    for t in v.iter() {
        println(t.0);
        println(t.1);
    }
}
