
struct G { o: Option[String], r: Result[String, i64], n: i64 }
fn mk(i: i64) -> String { f"alpha-{i}-long-enough-to-heap" }
fn mg(i: i64) -> G { G { o: Some(mk(i)), r: Ok(mk(i + 10)), n: i } }
fn cons(o: own Option[String]) -> i64 { match o { Some(s) => s.len(), None => 0 } }
fn main() {
    let g: Vec[G] = [mg(1), mg(2)];
    let mut out: Vec[String] = [];
    match g[0].o { Some(s) => println(s), None => {} }
    match g[0].o.clone() { Some(s) => out.push(s.clone()), None => {} }
    if let Some(s) = g[0].o { out.push(s.clone()); }
    match g[1].r.clone() { Ok(s) => out.push(s.clone()), Err(_) => {} }
    let x = g[1].o.clone();
    let y = g[1].o.clone();
    let mut z: Option[String] = None;
    z = g[0].o.clone();
    println(f"{out.len()} {cons(x)} {cons(y)} {cons(z)} {g[0].o.is_some()}");
    let h: Vec[(i64, G)] = [(1, mg(3))];
    match h[0].1.o.clone() { Some(s) => out.push(s.clone()), None => {} }
    match h[0].1.o.clone() { Some(s) => out.push(s.clone()), None => {} }
    let mut q: Option[String] = None;
    q = h[0].1.o.clone();
    q = h[0].1.o.clone();
    println(f"{out.len()} {cons(q)} {out[4]}");
    let t = (7, mg(4));
    println(f"{t.0} {t.1.n}");
}
