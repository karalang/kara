shared struct H { mut v: Vec[i64] }
shared struct M { tag: i64, mut v: Vec[i64], mut w: Vec[i64] }
shared struct R { v: Vec[i64] }
impl H {
    fn go(ref self) { zap(mut self.v); }
}
fn zap(s: mut Slice[i64]) { s[0] = 99i64; }
fn total(s: Slice[i64]) -> i64 {
    let mut t = 0i64;
    let mut i = 0i64;
    while i < s.len() { t = t + s[i]; i = i + 1i64; }
    return t;
}
fn main() {
    let n: i64 = env.args().len();
    // (a) bare shared local receiver, written through a slice
    let a = H { v: [n, n + 1i64, n + 2i64] };
    zap(mut a.v);
    println(f"a:{a.v[0]}:{a.v[1]}");
    // (b) field at a NON-ZERO index, behind a scalar and a Vec
    let b = M { tag: n + 6i64, v: [n, n], w: [n, n + 1i64, n + 2i64] };
    zap(mut b.w);
    println(f"b:{b.tag}:{b.v[0]}:{b.w[0]}:{b.w[2]}");
    // (c) `self` inside a shared method
    let c = H { v: [n, n + 1i64, n + 2i64] };
    c.go();
    println(f"c:{c.v[0]}");
    // (d) READ-ONLY slice of a NON-`mut` field — legal, and
    //     equally unbuildable before this fix
    let d = R { v: [n, n + 1i64, n + 2i64] };
    println(f"d:{total(d.v)}");
}
