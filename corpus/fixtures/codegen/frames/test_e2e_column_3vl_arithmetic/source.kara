fn fst(c: ref Column[i64], i: i64) -> i64 { match c[i] { Some(v) => v, None => -999 } }
fn fstb(c: ref Column[bool], i: i64) -> i64 { match c[i] { Some(v) => { if v { 1 } else { 0 } }, None => -9 } }
fn main() {
let mut a: Column[i64] = Column.new();
a.push(10); a.push_null(); a.push(30);
let mut b: Column[i64] = Column.new();
b.push(1); b.push(2); b.push_null();
let s = a + b;
println(fst(s, 0)); println(fst(s, 1)); println(s.null_count());
let m = a * 10;
println(fst(m, 0)); println(fst(m, 2));
let eq = a == b;
println(fstb(eq, 0)); println(eq.null_count());
let ng = -a;
println(fst(ng, 0)); println(fst(ng, 2));
}
