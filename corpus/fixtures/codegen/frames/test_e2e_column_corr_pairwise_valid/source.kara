fn main() {
let a: Column[f64] = Column.from_vec([1.0, 2.0, 3.0, 4.0]);
let b: Column[f64] = Column.from_vec([2.0, 4.0, 6.0, 8.0]);
println(a.corr(b));
let p: Column[f64] = Column.from_iter_nullable([Some(1.0), Some(2.0), None, Some(4.0)]);
let q: Column[f64] = Column.from_iter_nullable([Some(2.0), Some(4.0), Some(99.0), Some(8.0)]);
println(p.corr(q));
}
