fn to_lower(b: u8) -> u8 {
if b >= b'A' and b <= b'Z' { b + (b'a' - b'A') } else { b }
}
fn to_upper(b: u8) -> u8 {
if b >= b'a' and b <= b'z' { b } else { b - 0u8 }
}
// match: mixed arith / plain / arith arms
fn fold_match(b: u8) -> u8 {
match b {
b'A' => b + 32u8,
b'B' => b,
_ => b + 1u8,
}
}
// if let: arith Some-arm, literal None-arm
fn opt_fold(o: Option[u8]) -> u8 {
if let Some(x) = o { x + 10u8 } else { 0u8 }
}
fn main() {
println(to_lower(b'A').to_string()); // 97  (was 0)
println(to_lower(b'e').to_string()); // 101 (was 0, else branch)
println(to_upper(b'b').to_string()); // 98
println(fold_match(b'A').to_string()); // 97 (was 0)
println(fold_match(b'B').to_string()); // 66 (plain arm)
println(fold_match(b'z').to_string()); // 123 (wildcard arm)
println(opt_fold(Some(5u8)).to_string()); // 15 (was 0)
println(opt_fold(None).to_string());      // 0
}