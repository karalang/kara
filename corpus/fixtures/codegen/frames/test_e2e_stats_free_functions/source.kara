fn main() {
let v: Vec[f64] = vec![3.0, 1.0, 4.0, 1.0, 5.0, 9.0, 2.0];
println(Stats.sum(v));
println(Stats.prod(v));
println(Stats.mean(v));
println(Stats.variance(v));
println(Stats.stddev(v));
println(Stats.median(v));
match Stats.min(v) { Some(m) => println(m), None => println(-1.0), };
match Stats.max(v) { Some(m) => println(m), None => println(-1.0), };
}
