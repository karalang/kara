fn main() {
let mut v: Vec[u8] = Vec.new();
let mut a = 0i64;
while a < 240i64 { v.push(b'a' + ((a % 3i64) as u8)); a = a + 1i64; }
let mut sum = 0i64;
let mut k = 0i64;
while k < v.len() { sum = sum + (v[k] as i64); k = k + 1i64; }
println(f"{v.len()} {sum}");
// index-store path: overwrite a computed u8 then re-sum.
v[100] = 200u8 - ((0i64 % 3i64) as u8);
println(f"{v[100] as i64}");
}