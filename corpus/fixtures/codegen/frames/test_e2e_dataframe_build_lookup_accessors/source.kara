fn main() {
let mut df: DataFrame = DataFrame.new();
df.insert("age", Column.from_vec([30, 25, 40]));
df.insert("score", Column.from_vec([1.5, 2.5, 3.5]));
println(df.width());
println(df.height());
println(df.has_column("age"));
println(df.has_column("nope"));
let ages: Column[i64] = df.column("age");
match ages[2] { Some(v) => println(v), None => println(-1) }
let scores: Column[f64] = df.column("score");
match scores[0] { Some(v) => println(v), None => println(0.0) }
}
