#[derive(Default)]
struct S { x: i64, name: String }
fn steal(slot: mut ref String) -> String { take(slot) }
fn main() {
let mut n = 7i64;
let prev = take(mut n);
println(f"{prev} {n}");
let mut a = S { x: 42i64, name: "hello".to_string() };
let old = take(mut a);
println(f"{old.x} {old.name}");
println(f"{a.x} [{a.name}]");
let mut s = "owned".to_string();
let got = steal(mut s);
println(f"{got} [{s}]");
}