struct Res { id: i64 }
impl Drop for Res {
    fn drop(mut ref self) { println(f"drop {self.id}"); }
}
fn take(sink: mut ref Vec[Res], r: Res) { sink.push(r); }
fn main() {
    let mut sink: Vec[Res] = Vec.new();
    take(mut sink, Res { id: 1 });
    println("--after temp arg--");
    let carg: Res = Res { id: 2 };
    take(mut sink, carg);
    println("--after named arg--");
    println(f"pushed {sink.len()}");
}
