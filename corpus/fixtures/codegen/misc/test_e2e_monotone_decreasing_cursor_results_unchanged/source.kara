
fn merge(nums1: mut Slice[i64], m: i64, nums2: Slice[i64], n: i64) {
    let mut i = m - 1;
    let mut j = n - 1;
    let mut k = m + n - 1;
    while j >= 0 {
        if i >= 0 and nums1[i] > nums2[j] {
            nums1[k] = nums1[i];
            i = i - 1;
        } else {
            nums1[k] = nums2[j];
            j = j - 1;
        }
        k = k - 1;
    }
}
fn main() {
    let mut a: Array[i64, 6] = [1, 2, 3, 0, 0, 0];
    let b: Array[i64, 3] = [2, 5, 6];
    merge(mut a, 3, b, 3);
    for i in 0..6 {
        println(a[i]);
    }
}
