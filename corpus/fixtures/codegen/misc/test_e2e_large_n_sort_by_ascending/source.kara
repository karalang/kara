
fn main() {
    let mut v: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < 100 {
        v.push((i * 37 + 11) % 100);
        i = i + 1;
    }
    v.sort_by(|a, b| a.cmp(b));
    let mut bad: i64 = 0;
    let mut prev: i64 = -1;
    for x in v.iter() {
        if x < prev { bad = bad + 1; }
        prev = x;
    }
    println(bad);
}
