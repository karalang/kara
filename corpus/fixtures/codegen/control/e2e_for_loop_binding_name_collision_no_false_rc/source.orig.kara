fn band(n: i64) -> Vec[i64] {
let mut v: Vec[i64] = Vec.new();
let mut i = 0;
while i < n { v.push(i); i = i + 1; }
v
}
fn main() {
let mut pool: TaskGroup = TaskGroup.new();
let mut handles: Vec[TaskHandle[Vec[i64]]] = Vec.new();
let mut k = 0;
while k < 3 {
let handle: TaskHandle[Vec[i64]] = pool.spawn(|| band(k + 2));
handles.push(handle);
k = k + 1;
}
let mut total = 0;
for handle in handles { let c: Vec[i64] = handle.join(); total = total + c.len(); }
println(f"{total}");
}