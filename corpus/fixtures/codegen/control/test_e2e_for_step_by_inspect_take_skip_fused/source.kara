fn main() {
let v: Vec[i64] = [1, 2, 3, 10, 4, 5, 11, 6];
let mut a: i64 = 0;
for x in v.iter().step_by(2) { a = a + x; }
println(a);
let mut b: i64 = 0;
for x in v.iter().filter(|w| w % 2 == 0).step_by(2) { b = b + x; }
println(b);
let mut c: i64 = 0;
for x in v.iter().step_by(0) { c = c + x; }
println(c);
let mut seen: i64 = 0;
let mut d: i64 = 0;
for x in v.iter().inspect(|w| { seen = seen + 1; }).filter(|w| w > 5) { d = d + x; }
println(seen);
println(d);
let mut e: i64 = 0;
for x in v.iter().skip(1).step_by(2).take(3) { e = e + x; }
println(e);
let mut f: i64 = 0;
for y in v.iter().map(|w| w).take(0 - 1) { f = f + y; }
println(f);
let mut g: i64 = 0;
for y in v.iter().map(|w| w).skip(0 - 2) { g = g + y; }
println(g);
let mut h: i64 = 0;
for x in v.iter().take(0 - 1) { h = h + x; }
println(h);
let mut i2: i64 = 0;
for x in v.iter().skip(0 - 1) { i2 = i2 + x; }
println(i2);
let mut r: i64 = 0;
for x in (0..100).take(4) { r = r + x; }
println(r);
println(v.iter().skip(5).sum());
println(v.iter().take(3).fold(1, |p, q| p * q));
println(v.iter().step_by(3).count());
println(v.iter().skip(6).all(|w| w > 5));
let sv: Vec[i64] = v.iter().step_by(0).collect();
println(sv.len());
let names: Vec[String] = [f"ant", f"bee", f"cat", f"dog", f"elk"];
let mut s: String = f"";
for n in names.iter().step_by(2) { s = s + n + f","; }
println(s);
let mut r2: i64 = 0;
for y in (0..10).step_by(4).map(|w| w + 1) { r2 = r2 + y; }
println(r2);
}