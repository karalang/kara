struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
struct Sk { n: i64 }
impl Sk { fn pick(mut ref self, r: R, flag: bool) -> R { if flag { return r } return R { id: 90 + r.id } } }
fn main() { let mut s = Sk { n: 0 }; let k = s.pick(R { id: 1 }, false); println(f"k:{k.id}"); println("end") }
