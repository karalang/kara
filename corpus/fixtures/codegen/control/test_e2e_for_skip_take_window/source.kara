fn main() {
let v: Vec[i64] = [1, 2, 3, 4, 5, 6];
let mut s: i64 = 0;
for x in v.iter().skip(2).take(3) { s = s + x; }
println(s);
let mut t: i64 = 0;
for x in v.iter().take(4) { t = t + x; }
println(t);
let mut u: i64 = 0;
for x in v.iter().skip(4) { u = u + x; }
println(u);
let mut w: i64 = 0;
for x in v.iter().skip(10) { w = w + x; }
println(w);
let mut z: i64 = 0;
for x in v.iter().take(100) { z = z + x; }
println(z);
let mut n: i64 = 0;
for x in v.iter().take(4).skip(1) { n = n + x; }
println(n);
}