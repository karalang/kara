struct Rs { id: i64, name: String }
impl Drop for Rs {
    fn drop(mut ref self) {
        println(f"dS{self.id}")
    }
}
fn mks(i: i64) -> Rs {
    return Rs { id: i, name: f"h{i}" };
}
struct Bs { mut one: Rs, mut two: Rs }
fn main() {
    let mut g = Bs { one: mks(1), two: mks(2) };
    let taken = g.one;
    { g.one = mks(7); }
    println(f"t{taken.id}");
}
