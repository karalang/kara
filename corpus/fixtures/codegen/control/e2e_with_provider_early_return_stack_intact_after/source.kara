trait Counter { fn get(ref self) -> i64; }
effect resource Ctr: Counter;
struct InMem { n: i64 }
impl Counter for InMem { fn get(ref self) -> i64 { self.n } }
fn read() -> i64 with reads(Ctr) { Ctr.get() }
fn inner_early() -> i64 with reads(Ctr) {
with_provider[Ctr](InMem { n: 7 }, || { return read(); })
}
fn nested() -> i64 with reads(Ctr) {
with_provider[Ctr](InMem { n: 100 }, || {
let inner = inner_early();
inner + read()
})
}
fn main() with reads(Ctr) { println(f"{nested()}"); }