trait Counter { fn get(ref self) -> i64; }
effect resource Ctr: Counter;
struct InMem { n: i64 }
impl Counter for InMem { fn get(ref self) -> i64 { self.n } }
fn read() -> i64 with reads(Ctr) { Ctr.get() }
fn brk2() -> i64 with reads(Ctr) {
let mut acc = 0;
for i in 0..5 {
providers { Ctr => InMem { n: i } } in {
if read() == 3 { break; }
acc = acc + read();
}
}
acc
}
fn main() with reads(Ctr) { println(f"{brk2()}"); }