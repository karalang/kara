struct R { id: i64, name: String }
impl Drop for R { fn drop(mut ref self) { println(f"dR{self.id}") } }
fn mk(i: i64) -> R { return R { id: i, name: f"heap-{i}" }; }
struct S1 { r: R }
struct S3 { a: R, b: R }
struct D1 { r: R }
impl Drop for D1 { fn drop(mut ref self) { println("dD") } }
struct W1 { s: S1 }
struct O { r: R }
struct O3 { o: O }
struct H { n: i64 }
fn take(r: R) -> i64 { let t = (r, 5); let x = t.0; return 7; }
fn main() { let v = take(mk(1)); println(f"v={v}"); }
