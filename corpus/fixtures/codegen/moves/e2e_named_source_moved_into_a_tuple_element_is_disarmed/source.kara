struct H { items: Vec[i64], n: i64 }
fn mkvec(k: i64) -> Vec[i64] { let mut v: Vec[i64] = Vec.new(); v.push(k); v.push(k + 1i64); return v; }
fn mkstr(k: i64) -> String { let mut s: String = String.new(); s.push_str(f"payload-{k}"); return s; }
fn digits(i: i64) -> String { let mut d: String = String.new(); d.push_str(f"{i}"); return d; }
fn mkvs(k: i64) -> Vec[String] { let mut v: Vec[String] = Vec.new(); v.push(mkstr(k)); v.push(mkstr(k + 1i64)); return v; }
fn main() {
    let n: i64 = env.args().len();
    // (b) the minimal shape the report missed: NAMED source, no move-out
    let mut t2: (Vec[i64], i64) = (mkvec(n), 3i64);
    let f: Vec[i64] = mkvec(n + 10i64);
    t2.0 = f;
    println(f"b:{t2.0.len()}:{t2.0[0i64]}");
    // (c) SECOND element position
    let mut t3: (i64, Vec[i64]) = (3i64, mkvec(n));
    let g: Vec[i64] = mkvec(n + 20i64);
    t3.1 = g;
    println(f"c:{t3.1[0i64]}");
    // (d) String element
    let mut t4: (String, i64) = (mkstr(n), 3i64);
    let s: String = mkstr(n + 30i64);
    t4.0 = s;
    if t4.0.contains(digits(n + 30i64)) { println(f"d:{t4.0.len()}"); } else { println("d:BAD"); }
    // (e) Vec[String] element — the TRIPLE-free shape
    let mut t5: (Vec[String], i64) = (mkvs(n), 3i64);
    let w: Vec[String] = mkvs(n + 40i64);
    t5.0 = w;
    println(f"e:{t5.0.len()}:{t5.0[0i64].len()}:{t5.0[1i64].len()}");
    // CONTROL: a fresh-temp RHS has no source binding and was always correct
    let mut t6: (Vec[i64], i64) = (mkvec(n), 3i64);
    t6.0 = mkvec(n + 50i64);
    println(f"f:{t6.0[0i64]}");
    // CONTROL: the struct-FIELD spelling, correct since B-2026-07-15-25
    let mut h: H = H { items: mkvec(n), n: 3i64 };
    let hv: Vec[i64] = mkvec(n + 60i64);
    h.items = hv;
    println(f"g:{h.items[0i64]}");
    println("end");
}
