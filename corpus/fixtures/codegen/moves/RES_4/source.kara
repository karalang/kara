enum Box2 { Full(Res), Empty }
struct T { n: i64 }
impl T { fn take(ref self, b: Box2) -> i64 { match b { Box2.Full(r) => { return r.id; } Box2.Empty => { return 0; } } } }
fn main() { let t = T { n: 1 }; let b: Box2 = Box2.Full(Res { id: 7, name: f"e7" }); let v: i64 = t.take(b); println(f"v={v}") }
