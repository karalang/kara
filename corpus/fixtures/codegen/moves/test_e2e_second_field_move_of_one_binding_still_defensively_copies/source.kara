
enum Cmd { Clear(Vec[String]) }
#[derive(Clone)]
struct Doc { lines: Vec[String] }
struct Ed { doc: Doc }
fn apply(d: mut ref Doc, c: own Cmd) -> Cmd {
    match c {
        Clear(old) => {
            let mut snap: Vec[String] = Vec.new();
            for i in 0..d.lines.len() { snap.push(d.lines[i].clone()); }
            d.lines.clear();
            for i in 0..old.len() { d.lines.push(old[i].clone()); }
            Cmd.Clear(snap)
        }
    }
}
fn render(d: ref Doc) -> String {
    let mut s = String.new();
    for i in 0..d.lines.len() { s.push_str(d.lines[i]); }
    s
}
fn main() {
    let mut l: Vec[String] = Vec.new();
    let mut a = String.new(); a.push_str("ALPHA");
    l.push(a);
    let mut e = Ed { doc: Doc { lines: l } };
    let mut snapshot: Vec[String] = Vec.new();
    let cur = e.doc.clone();
    for i in 0..cur.lines.len() { snapshot.push(cur.lines[i].clone()); }
    let _inv = apply(mut e.doc, Cmd.Clear(snapshot));
    let after = e.doc.clone();
    println(f"[{render(e.doc)}] lines={after.lines.len()}")
}
