struct D { id: i64 }
impl Drop for D { fn drop(mut ref self) { println(f"dD{self.id}") } }
fn mkd(n: i64) -> D { return D { id: n }; }
struct W { r: D, s: D, b: i64 }
fn mkw(n: i64) -> W { return W { r: mkd(n), s: mkd(n + 100), b: n }; }
struct V { r: D, b: i64 }
fn main() { let w = V { r: mkw(7).r, b: 1i64 }; println(f"idx{w.b}"); println("end") }
