
fn a() -> i64 {
    let s = Span.root("a", 7);
    with_span(s, || { sleep_ms(50); Log.info("a-after"); 1 })
}
fn b() -> i64 {
    sleep_ms(10);
    Log.info("b-during");
    2
}
fn child() -> i64 {
    sleep_ms(1);
    Log.info("child");
    3
}
fn main() {
    let g = TaskGroup.new();
    let x = g.spawn(|| a());
    let y = g.spawn(|| b());
    println(x.join() + y.join());
    let p = Span.root("p", 5);
    let z = with_span(p, || { let h = g.spawn(|| child()); h.join() });
    Log.info("after");
    println(z);
}
